    let p1 = Point { x: 10, y: 20 };
    let p2 = Point { x: 10, y: 20 };
    
    // Testing direct trait function call
    let b = p1.eq(view(p2)); if b { print_int(1 as i64); } else { print_int(0 as i64); }
}
