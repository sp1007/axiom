// Axiom Compiler — Post-RA x86-64 Machine Peephole Optimizer (compiler/backend/peephole/peephole.ax)
// Implements E15.8 / SPEC-78 §4 (AXS-MCOPT-020..026, REQ-OPT-034..036):
//   1. Explicit EFLAGS liveness and clobber modeling (`FLAGS_*`, `x64_mi_flags_effect`, `x64_flags_are_dead_after`)
//   2. Redundant move, identity, and no-op elimination (`mov r, r`, reverse moves, dead overwrites, `lea`, `+ 0`)
//   3. Flag-safe target idioms (`mov r, 0` -> `xor r, r` when EFLAGS dead; `cmp r, 0` -> `test r, r`)
//   4. Stack-slot redundant store elimination and store-to-load forwarding across `[rbp - disp]` & `[frame#s + off]`
//   5. Control-flow peepholes (jump-to-jump threading, branch condition inversion, fall-through `jmp` removal)
module compiler.backend.peephole.peephole

pub use compiler.target.x64.frame.FLAGS_NONE
pub use compiler.target.x64.frame.FLAGS_DEF
pub use compiler.target.x64.frame.FLAGS_USE
pub use compiler.target.x64.frame.FLAGS_PRESERVE
pub use compiler.target.x64.frame.FLAGS_KILL
pub use compiler.target.x64.frame.FLAGS_DEF_USE
pub use compiler.target.x64.frame.x64_mi_flags_effect
pub use compiler.target.x64.frame.x64_flags_are_dead_after
pub use compiler.target.x64.frame.x64_peephole_opt_in_arena
pub use compiler.target.x64.frame.x64_peephole_opt
