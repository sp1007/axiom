// Axiom Compiler — Backend Integration Session (compiler/backend/session.ax)
// Integrates MIR -> LIR lowering (`compiler.lir`), Windows x64 ABI classification &
// LIR ABI lowering (`compiler.abi`), x86-64 instruction selection, stack frame layout,
// Machine IR verification, and machine code / ObjModel section emission (`compiler.target.x64`
// & `compiler.obj`).
// Port of bootstrap/axiom0/src/driver/{emit_lir.c,emit_mi.c,emit_mc.c,emit_obj.c}
// and backend pipeline stages from bootstrap/axiom0/src/driver/build_native/build.c.
module compiler.backend.session

