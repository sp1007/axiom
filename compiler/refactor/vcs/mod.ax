// Unified Semantic VCS Engine Coordinator (`AXDIFF`, `AXMERGE`, `AXPATCH`) (T810 / E19.3).
// Implements SPEC-102 §§4..6 (`REQ-TOOL-301`, `REQ-TOOL-302`, `REQ-TOOL-303`).
module compiler.refactor.vcs

use compiler.refactor.vcs.diff.AXDIFF_ABI_1
use compiler.refactor.vcs.diff.AXDIFF_SCHEMA_1
use compiler.refactor.vcs.merge.AXMERGE_ABI_1
use compiler.refactor.vcs.merge.AXMERGE_SCHEMA_1
use compiler.refactor.vcs.patch.AXPATCH_ABI_1
use compiler.refactor.vcs.patch.AXPATCH_SCHEMA_1

@derive(Copy)
pub struct SemanticVcsCapabilities {
    pub axdiff_abi: u32,
    pub axdiff_schema: u32,
    pub axmerge_abi: u32,
    pub axmerge_schema: u32,
    pub axpatch_abi: u32,
    pub axpatch_schema: u32,
    pub compiler_db_verified: bool,
    pub zero_codegen_firewall: bool,
}

pub fn semantic_vcs_capabilities_query() -> SemanticVcsCapabilities {
    SemanticVcsCapabilities {
        axdiff_abi: AXDIFF_ABI_1,
        axdiff_schema: AXDIFF_SCHEMA_1,
        axmerge_abi: AXMERGE_ABI_1,
        axmerge_schema: AXMERGE_SCHEMA_1,
        axpatch_abi: AXPATCH_ABI_1,
        axpatch_schema: AXPATCH_SCHEMA_1,
        compiler_db_verified: true,
        zero_codegen_firewall: true,
    }
}
