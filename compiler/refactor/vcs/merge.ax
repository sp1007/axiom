// AXMERGE — AST-Aware Three-Way (`BASE`, `LEFT`, `RIGHT`) Semantic Merge & Conflict Engine (T810 / E19.3).
// Implements SPEC-102 §5 (AXS-REF-040..042; REQ-TOOL-302, REQ-TOOL-186, MERGE-INV-01..40):
// - Normative three-way merge model: idempotent convergence, disjoint preservation, zero silent guessing (`MERGE-PRINCIPLE-01..07`)
// - Six-level identity matching priority (`SymbolId`/`SemanticKey` -> `MemberId` -> `Rename/Move` -> `AST Path` -> `Tokens` -> `Text`)
// - Formatting & doc-comment immunity, `use` import set algebra, `Rename + Body` auto-merge, `Move + Body` auto-merge,
//   composite struct/enum/trait member merges, and disjoint statement block merges (`AXS-REF-041`)
// - Explicit 11-kind `MergeConflictKind` taxonomy, deterministic `ConflictId`, canonical 3-way conflict markers,
//   and mandatory post-merge `CompilerDB` semantic verification gate (`AXS-REF-042`)
module compiler.refactor.vcs.merge

use compiler.lsp.protocol.LspStrView
use compiler.lsp.protocol.lsp_str_view
use compiler.lsp.handlers.LspSemanticEngine
use compiler.refactor.transforms.refactor_sv_contains_lit
use compiler.refactor.vcs.diff.DIFF_ITEM_FUNCTION
use compiler.refactor.vcs.diff.DIFF_ITEM_STRUCT
use compiler.refactor.vcs.diff.DIFF_ITEM_ENUM
use compiler.refactor.vcs.diff.DIFF_ITEM_TRAIT
use compiler.refactor.vcs.diff.DIFF_ITEM_IMPL
use compiler.refactor.vcs.diff.DIFF_ITEM_USE
use compiler.refactor.vcs.diff.axdiff_mix_hash

// ============================================================================
// 1. AXMERGE Constants, Identity Hierarchy & Conflict Taxonomy (`AXS-REF-040..042`)
// ============================================================================

pub const AXMERGE_ABI_1: u32 = 1u32;
pub const AXMERGE_SCHEMA_1: u32 = 1u32;

// MergeStatus
pub const MERGE_STATUS_CLEAN: u8 = 0u8;
pub const MERGE_STATUS_CONFLICTED: u8 = 1u8;
pub const MERGE_STATUS_SEMANTIC_CONFLICT: u8 = 2u8;
pub const MERGE_STATUS_INVALID_INPUT: u8 = 3u8;

// Six-level identity matching priority (`AXS-REF-040 §2`, `MERGE-INV-06..07`)
pub const MERGE_ID_LEVEL_SYMBOL_KEY: u8 = 0u8;
pub const MERGE_ID_LEVEL_MEMBER_ID: u8 = 1u8;
pub const MERGE_ID_LEVEL_RENAME_MOVE_FINGERPRINT: u8 = 2u8;
pub const MERGE_ID_LEVEL_AST_PATH: u8 = 3u8;
pub const MERGE_ID_LEVEL_TOKEN_STREAM: u8 = 4u8;
pub const MERGE_ID_LEVEL_TEXT_FALLBACK: u8 = 5u8;

// MergeFallback
pub const MERGE_FALLBACK_NONE: u8 = 0u8;
pub const MERGE_FALLBACK_TEXT: u8 = 1u8;

// MergeResolutionPolicy (`AXS-REF-040 §1`: `STRICT` never guesses!)
pub const MERGE_POLICY_STRICT: u8 = 0u8;
pub const MERGE_POLICY_FAVOR_LEFT: u8 = 1u8;
pub const MERGE_POLICY_FAVOR_RIGHT: u8 = 2u8;

// Eleven-kind `MergeConflictKind` taxonomy (`AXS-REF-042 §1`)
pub const CONFLICT_NONE: u8 = 0u8;
pub const CONFLICT_DUPLICATE_SYMBOL_ADD: u8 = 1u8;
pub const CONFLICT_MODIFY_DELETE: u8 = 2u8;
pub const CONFLICT_RENAME_IDENTITY: u8 = 3u8;
pub const CONFLICT_MOVE_DESTINATION: u8 = 4u8;
pub const CONFLICT_SIGNATURE: u8 = 5u8;
pub const CONFLICT_STRUCT_FIELD: u8 = 6u8;
pub const CONFLICT_ENUM_DISCRIMINANT: u8 = 7u8;
pub const CONFLICT_TRAIT_IMPL_COHERENCE: u8 = 8u8;
pub const CONFLICT_STATEMENT_BODY: u8 = 9u8;
pub const CONFLICT_IMPORT_ALIAS_COLLISION: u8 = 10u8;
pub const CONFLICT_SEMANTIC_VERIFICATION: u8 = 11u8;

// ============================================================================
// 2. Three-Way Merge Input Entities, Conflict Records & Output Structures
// ============================================================================

@derive(Copy)
pub struct MergeEntityState {
    pub present: bool,
    pub item_kind: u8,
    pub semantic_key: u64,
    pub name_hash: u64,
    pub module_hash: u64,
    pub sig_hash: u64,
    pub body_ast_hash: u64,
    pub doc_comment_hash: u64,
    pub formatting_hash: u64,
    pub field_or_variant_mask: u32,
    pub discriminant_value: u32,
    pub import_alias_hash: u64,
    pub import_target_sym: u64,
    pub span_lo: u32,
    pub span_hi: u32,
}

@derive(Copy)
pub struct MergeThreeWayItem {
    pub identity_level: u8,
    pub left_stmt_span_disjoint_from_right: bool,
    pub base: MergeEntityState,
    pub left: MergeEntityState,
    pub right: MergeEntityState,
}

@derive(Copy)
pub struct MergeConflictRecord {
    pub conflict_id: u64,
    pub conflict_kind: u8,
    pub identity_level: u8,
    pub has_conflict_markers: bool,
    pub target_semantic_key: u64,
    pub base_span_lo: u32,
    pub left_span_lo: u32,
    pub right_span_lo: u32,
    pub compiler_diag_code: u32,
}

@derive(Copy)
pub struct MergedEntityResult {
    pub present: bool,
    pub item_kind: u8,
    pub semantic_key: u64,
    pub final_name_hash: u64,
    pub final_module_hash: u64,
    pub final_sig_hash: u64,
    pub final_body_ast_hash: u64,
    pub final_doc_comment_hash: u64,
    pub final_field_or_variant_mask: u32,
    pub converged_idempotent: bool,
    pub auto_merged_rename_and_body: bool,
    pub auto_merged_move_and_body: bool,
    pub auto_merged_formatting: bool,
    pub rewrote_call_sites: bool,
}

@derive(Copy)
pub struct MergeInputBundle {
    pub policy: u8,
    pub item_count: u32,
    pub items: [12]MergeThreeWayItem,
    pub base_import_mask: u32,
    pub left_added_import_mask: u32,
    pub left_removed_import_mask: u32,
    pub right_added_import_mask: u32,
    pub right_removed_import_mask: u32,
    pub post_merge_compiler_diag: u32,
    pub post_merge_target_key: u64,
}

@derive(Copy)
pub struct MergeResult {
    pub abi_version: u32,
    pub schema_version: u32,
    pub status: u8,
    pub fallback: u8,
    pub verified_by_compiler_db: bool,
    pub abi_layout_changed: bool,
    pub merged_import_mask: u32,
    pub merged_count: u32,
    pub conflict_count: u32,
    pub merge_hash: u64,
    pub conflict_marker_sample: LspStrView,
    pub merged_items: [12]MergedEntityResult,
    pub conflicts: [8]MergeConflictRecord,
}

pub fn axmerge_entity_empty() -> MergeEntityState {
    MergeEntityState {
        present: false,
        item_kind: 0u8,
        semantic_key: 0u64,
        name_hash: 0u64,
        module_hash: 0u64,
        sig_hash: 0u64,
        body_ast_hash: 0u64,
        doc_comment_hash: 0u64,
        formatting_hash: 0u64,
        field_or_variant_mask: 0u32,
        discriminant_value: 0u32,
        import_alias_hash: 0u64,
        import_target_sym: 0u64,
        span_lo: 0u32,
        span_hi: 0u32,
    }
}

pub fn axmerge_entity_new(
    present: bool,
    item_kind: u8,
    semantic_key: u64,
    name_hash: u64,
    module_hash: u64,
    sig_hash: u64,
    body_ast_hash: u64,
    doc_comment_hash: u64,
    formatting_hash: u64,
    field_or_variant_mask: u32,
    discriminant_value: u32,
    span_lo: u32
) -> MergeEntityState {
    MergeEntityState {
        present: present,
        item_kind: item_kind,
        semantic_key: semantic_key,
        name_hash: name_hash,
        module_hash: module_hash,
        sig_hash: sig_hash,
        body_ast_hash: body_ast_hash,
        doc_comment_hash: doc_comment_hash,
        formatting_hash: formatting_hash,
        field_or_variant_mask: field_or_variant_mask,
        discriminant_value: discriminant_value,
        import_alias_hash: 0u64,
        import_target_sym: 0u64,
        span_lo: span_lo,
        span_hi: span_lo + 16u32,
    }
}

pub fn axmerge_bundle_new(policy: u8) -> MergeInputBundle {
    let empty_ent = axmerge_entity_empty();
    let empty_item = MergeThreeWayItem {
        identity_level: MERGE_ID_LEVEL_SYMBOL_KEY,
        left_stmt_span_disjoint_from_right: false,
        base: empty_ent,
        left: empty_ent,
        right: empty_ent,
    };
    MergeInputBundle {
        policy: policy,
        item_count: 0u32,
        items: [empty_item; 12],
        base_import_mask: 0u32,
        left_added_import_mask: 0u32,
        left_removed_import_mask: 0u32,
        right_added_import_mask: 0u32,
        right_removed_import_mask: 0u32,
        post_merge_compiler_diag: 0u32,
        post_merge_target_key: 0u64,
    }
}

pub fn axmerge_bundle_add_item(
    bundle: mut_view<MergeInputBundle>,
    identity_level: u8,
    base: MergeEntityState,
    left: MergeEntityState,
    right: MergeEntityState,
    disjoint_stmt_spans: bool
) -> bool {
    if bundle.item_count >= 12u32 {
        return false;
    }
    bundle.items[bundle.item_count as usize] = MergeThreeWayItem {
        identity_level: identity_level,
        left_stmt_span_disjoint_from_right: disjoint_stmt_spans,
        base: base,
        left: left,
        right: right,
    };
    bundle.item_count = bundle.item_count + 1u32;
    true
}

// Deterministic `ConflictId = BLAKE3("axiom-merge-conflict-v1" || target_semantic_key || conflict_kind || base_hash || left_hash || right_hash)`
// (`SPEC-102 §5.3 AXS-REF-042 §2`, `MERGE-INV-25`).
pub fn axmerge_compute_conflict_id(
    target_semantic_key: u64,
    conflict_kind: u8,
    base_hash: u64,
    left_hash: u64,
    right_hash: u64
) -> u64 {
    let mut h: u64 = 0x61786d6572676531u64;
    h = axdiff_mix_hash(h, target_semantic_key);
    h = axdiff_mix_hash(h, conflict_kind as u64);
    h = axdiff_mix_hash(h, base_hash);
    h = axdiff_mix_hash(h, left_hash);
    h = axdiff_mix_hash(h, right_hash);
    if h == 0u64 { 1u64 } else { h }
}

pub fn axmerge_has_canonical_conflict_markers(sv: LspStrView) -> bool {
    refactor_sv_contains_lit(sv, "<<<<<<< LEFT") &&
        refactor_sv_contains_lit(sv, "||||||| BASE") &&
        refactor_sv_contains_lit(sv, "=======") &&
        refactor_sv_contains_lit(sv, ">>>>>>> RIGHT")
}

fn axmerge_record_conflict(
    res: mut_view<MergeResult>,
    conflict_kind: u8,
    identity_level: u8,
    target_key: u64,
    base_hash: u64,
    left_hash: u64,
    right_hash: u64,
    base_lo: u32,
    left_lo: u32,
    right_lo: u32,
    diag_code: u32
) {
    if res.conflict_count >= 8u32 {
        return;
    }
    let cid = axmerge_compute_conflict_id(target_key, conflict_kind, base_hash, left_hash, right_hash);
    res.conflicts[res.conflict_count as usize] = MergeConflictRecord {
        conflict_id: cid,
        conflict_kind: conflict_kind,
        identity_level: identity_level,
        has_conflict_markers: true,
        target_semantic_key: target_key,
        base_span_lo: base_lo,
        left_span_lo: left_lo,
        right_span_lo: right_lo,
        compiler_diag_code: diag_code,
    };
    res.conflict_count = res.conflict_count + 1u32;
    res.conflict_marker_sample = lsp_str_view(
        "<<<<<<< LEFT\n    // left branch edit\n||||||| BASE\n    // common ancestor\n=======\n    // right branch edit\n>>>>>>> RIGHT\n"
    );
}

// ============================================================================
// 3. Three-Way Semantic Merge & Post-Merge Verification Engine (`AXS-REF-040..042`)
// ============================================================================

pub fn axmerge_three_way(
    eng: mut_view<LspSemanticEngine>,
    bundle: view<MergeInputBundle>
) -> MergeResult {
    eng.total_semantic_queries = eng.total_semantic_queries + 1u32;
    let empty_merged = MergedEntityResult {
        present: false,
        item_kind: 0u8,
        semantic_key: 0u64,
        final_name_hash: 0u64,
        final_module_hash: 0u64,
        final_sig_hash: 0u64,
        final_body_ast_hash: 0u64,
        final_doc_comment_hash: 0u64,
        final_field_or_variant_mask: 0u32,
        converged_idempotent: false,
        auto_merged_rename_and_body: false,
        auto_merged_move_and_body: false,
        auto_merged_formatting: false,
        rewrote_call_sites: false,
    };
    let empty_conf = MergeConflictRecord {
        conflict_id: 0u64,
        conflict_kind: CONFLICT_NONE,
        identity_level: 0u8,
        has_conflict_markers: false,
        target_semantic_key: 0u64,
        base_span_lo: 0u32,
        left_span_lo: 0u32,
        right_span_lo: 0u32,
        compiler_diag_code: 0u32,
    };

    // Compute `use` import set algebra (`AXS-REF-041 §2`):
    // `Imports_merged = (Imports_B \ (Removed_L | Removed_R)) | Added_L | Added_R`
    let removed_union = bundle.left_removed_import_mask | bundle.right_removed_import_mask;
    let added_union = bundle.left_added_import_mask | bundle.right_added_import_mask;
    let merged_imports = (bundle.base_import_mask & (removed_union ^ 0xFFFFFFFFu32)) | added_union;

    let mut res = MergeResult {
        abi_version: AXMERGE_ABI_1,
        schema_version: AXMERGE_SCHEMA_1,
        status: MERGE_STATUS_CLEAN,
        fallback: MERGE_FALLBACK_NONE,
        verified_by_compiler_db: false,
        abi_layout_changed: false,
        merged_import_mask: merged_imports,
        merged_count: 0u32,
        conflict_count: 0u32,
        merge_hash: 0u64,
        conflict_marker_sample: lsp_str_view(""),
        merged_items: [empty_merged; 12],
        conflicts: [empty_conf; 8],
    };

    let mut i: u32 = 0u32;
    while i < bundle.item_count && i < 12u32 {
        let it = bundle.items[i as usize];
        let b = it.base;
        let l = it.left;
        let r = it.right;
        if it.identity_level == MERGE_ID_LEVEL_TEXT_FALLBACK {
            res.fallback = MERGE_FALLBACK_TEXT;
        }
        let target_key = if b.semantic_key != 0u64 {
            b.semantic_key
        } else if l.semantic_key != 0u64 {
            l.semantic_key
        } else {
            r.semantic_key
        };

        // Case A: Added on one or both sides (`!b.present`)
        if !b.present {
            if l.present && !r.present {
                let mut m = empty_merged;
                m.present = true;
                m.item_kind = l.item_kind;
                m.semantic_key = l.semantic_key;
                m.final_name_hash = l.name_hash;
                m.final_module_hash = l.module_hash;
                m.final_sig_hash = l.sig_hash;
                m.final_body_ast_hash = l.body_ast_hash;
                m.final_doc_comment_hash = l.doc_comment_hash;
                m.final_field_or_variant_mask = l.field_or_variant_mask;
                res.merged_items[res.merged_count as usize] = m;
                res.merged_count = res.merged_count + 1u32;
            } else if !l.present && r.present {
                let mut m = empty_merged;
                m.present = true;
                m.item_kind = r.item_kind;
                m.semantic_key = r.semantic_key;
                m.final_name_hash = r.name_hash;
                m.final_module_hash = r.module_hash;
                m.final_sig_hash = r.sig_hash;
                m.final_body_ast_hash = r.body_ast_hash;
                m.final_doc_comment_hash = r.doc_comment_hash;
                m.final_field_or_variant_mask = r.field_or_variant_mask;
                res.merged_items[res.merged_count as usize] = m;
                res.merged_count = res.merged_count + 1u32;
            } else if l.present && r.present {
                if l.item_kind == DIFF_ITEM_USE && l.import_alias_hash != 0u64 &&
                    l.import_alias_hash == r.import_alias_hash && l.import_target_sym != r.import_target_sym {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_IMPORT_ALIAS_COLLISION, it.identity_level, target_key,
                        0u64, l.import_target_sym, r.import_target_sym, 0u32, l.span_lo, r.span_lo, 0u32
                    );
                } else if l.sig_hash == r.sig_hash && l.body_ast_hash == r.body_ast_hash &&
                    l.name_hash == r.name_hash && l.module_hash == r.module_hash {
                    // Idempotent convergence (`AXS-REF-040 §1`, `MERGE-INV-02`)
                    let mut m = empty_merged;
                    m.present = true;
                    m.item_kind = l.item_kind;
                    m.semantic_key = target_key;
                    m.final_name_hash = l.name_hash;
                    m.final_module_hash = l.module_hash;
                    m.final_sig_hash = l.sig_hash;
                    m.final_body_ast_hash = l.body_ast_hash;
                    m.final_doc_comment_hash = l.doc_comment_hash;
                    m.final_field_or_variant_mask = l.field_or_variant_mask;
                    m.converged_idempotent = true;
                    res.merged_items[res.merged_count as usize] = m;
                    res.merged_count = res.merged_count + 1u32;
                } else {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_DUPLICATE_SYMBOL_ADD, it.identity_level, target_key,
                        0u64, l.body_ast_hash ^ l.sig_hash, r.body_ast_hash ^ r.sig_hash, 0u32, l.span_lo, r.span_lo, 0u32
                    );
                }
            }
        } else {
            // Case B: `b.present == true`
            let l_Modified = l.present && (
                l.name_hash != b.name_hash || l.module_hash != b.module_hash ||
                l.sig_hash != b.sig_hash || l.body_ast_hash != b.body_ast_hash ||
                l.field_or_variant_mask != b.field_or_variant_mask || l.discriminant_value != b.discriminant_value
            );
            let r_Modified = r.present && (
                r.name_hash != b.name_hash || r.module_hash != b.module_hash ||
                r.sig_hash != b.sig_hash || r.body_ast_hash != b.body_ast_hash ||
                r.field_or_variant_mask != b.field_or_variant_mask || r.discriminant_value != b.discriminant_value
            );

            if !l.present && !r.present {
                // Both sides deleted the declaration -> idempotent deletion (`present = false`)
            } else if !l.present && r.present {
                if r_Modified {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_MODIFY_DELETE, it.identity_level, target_key,
                        b.body_ast_hash, 0u64, r.body_ast_hash, b.span_lo, 0u32, r.span_lo, 0u32
                    );
                }
            } else if l.present && !r.present {
                if l_Modified {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_MODIFY_DELETE, it.identity_level, target_key,
                        b.body_ast_hash, l.body_ast_hash, 0u64, b.span_lo, l.span_lo, 0u32, 0u32
                    );
                }
            } else {
                // Both `l.present && r.present`
                let l_renamed = l.name_hash != b.name_hash;
                let r_renamed = r.name_hash != b.name_hash;
                let l_moved = l.module_hash != b.module_hash;
                let r_moved = r.module_hash != b.module_hash;
                let l_sig_chg = l.sig_hash != b.sig_hash;
                let r_sig_chg = r.sig_hash != b.sig_hash;
                let l_body_chg = l.body_ast_hash != b.body_ast_hash;
                let r_body_chg = r.body_ast_hash != b.body_ast_hash;

                if l_renamed && r_renamed && l.name_hash != r.name_hash {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_RENAME_IDENTITY, it.identity_level, target_key,
                        b.name_hash, l.name_hash, r.name_hash, b.span_lo, l.span_lo, r.span_lo, 0u32
                    );
                } else if l_moved && r_moved && l.module_hash != r.module_hash {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_MOVE_DESTINATION, it.identity_level, target_key,
                        b.module_hash, l.module_hash, r.module_hash, b.span_lo, l.span_lo, r.span_lo, 0u32
                    );
                } else if l_sig_chg && r_sig_chg && l.sig_hash != r.sig_hash {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_SIGNATURE, it.identity_level, target_key,
                        b.sig_hash, l.sig_hash, r.sig_hash, b.span_lo, l.span_lo, r.span_lo, 0u32
                    );
                } else if b.item_kind == DIFF_ITEM_ENUM &&
                    l.discriminant_value != b.discriminant_value &&
                    r.discriminant_value != b.discriminant_value &&
                    (l.discriminant_value == r.discriminant_value || l.field_or_variant_mask == r.field_or_variant_mask) {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_ENUM_DISCRIMINANT, it.identity_level, target_key,
                        b.discriminant_value as u64, l.discriminant_value as u64, r.discriminant_value as u64,
                        b.span_lo, l.span_lo, r.span_lo, 0u32
                    );
                } else if b.item_kind == DIFF_ITEM_STRUCT &&
                    ((l.field_or_variant_mask ^ b.field_or_variant_mask) & (r.field_or_variant_mask ^ b.field_or_variant_mask)) != 0u32 &&
                    l.body_ast_hash != r.body_ast_hash {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_STRUCT_FIELD, it.identity_level, target_key,
                        b.field_or_variant_mask as u64, l.field_or_variant_mask as u64, r.field_or_variant_mask as u64,
                        b.span_lo, l.span_lo, r.span_lo, 0u32
                    );
                } else if (b.item_kind == DIFF_ITEM_TRAIT || b.item_kind == DIFF_ITEM_IMPL) &&
                    l_body_chg && r_body_chg && l.body_ast_hash != r.body_ast_hash && !it.left_stmt_span_disjoint_from_right {
                    axmerge_record_conflict(
                        mut_view(res), CONFLICT_TRAIT_IMPL_COHERENCE, it.identity_level, target_key,
                        b.body_ast_hash, l.body_ast_hash, r.body_ast_hash, b.span_lo, l.span_lo, r.span_lo, 0u32
                    );
                } else if l_body_chg && r_body_chg && l.body_ast_hash != r.body_ast_hash && !it.left_stmt_span_disjoint_from_right {
                    if bundle.policy == MERGE_POLICY_STRICT {
                        axmerge_record_conflict(
                            mut_view(res), CONFLICT_STATEMENT_BODY, it.identity_level, target_key,
                            b.body_ast_hash, l.body_ast_hash, r.body_ast_hash, b.span_lo, l.span_lo, r.span_lo, 0u32
                        );
                    } else {
                        let pick_l = bundle.policy == MERGE_POLICY_FAVOR_LEFT;
                        let mut m = empty_merged;
                        m.present = true;
                        m.item_kind = b.item_kind;
                        m.semantic_key = target_key;
                        m.final_name_hash = if pick_l { l.name_hash } else { r.name_hash };
                        m.final_module_hash = if pick_l { l.module_hash } else { r.module_hash };
                        m.final_sig_hash = if pick_l { l.sig_hash } else { r.sig_hash };
                        m.final_body_ast_hash = if pick_l { l.body_ast_hash } else { r.body_ast_hash };
                        m.final_doc_comment_hash = if pick_l { l.doc_comment_hash } else { r.doc_comment_hash };
                        m.final_field_or_variant_mask = l.field_or_variant_mask | r.field_or_variant_mask;
                        res.merged_items[res.merged_count as usize] = m;
                        res.merged_count = res.merged_count + 1u32;
                    }
                } else {
                    // Clean AST / semantic auto-merge!
                    let final_name = if l_renamed { l.name_hash } else if r_renamed { r.name_hash } else { b.name_hash };
                    let final_mod = if l_moved { l.module_hash } else if r_moved { r.module_hash } else { b.module_hash };
                    let final_sig = if l_sig_chg { l.sig_hash } else if r_sig_chg { r.sig_hash } else { b.sig_hash };
                    let final_body = if l_body_chg && r_body_chg && l.body_ast_hash != r.body_ast_hash {
                        axdiff_mix_hash(l.body_ast_hash, r.body_ast_hash)
                    } else if l_body_chg {
                        l.body_ast_hash
                    } else if r_body_chg {
                        r.body_ast_hash
                    } else {
                        b.body_ast_hash
                    };
                    let final_doc = if l.doc_comment_hash != b.doc_comment_hash {
                        l.doc_comment_hash
                    } else if r.doc_comment_hash != b.doc_comment_hash {
                        r.doc_comment_hash
                    } else {
                        b.doc_comment_hash
                    };
                    let l_added_fields = l.field_or_variant_mask & (b.field_or_variant_mask ^ 0xFFFFFFFFu32);
                    let r_added_fields = r.field_or_variant_mask & (b.field_or_variant_mask ^ 0xFFFFFFFFu32);
                    let final_mask = b.field_or_variant_mask | l_added_fields | r_added_fields;
                    if b.item_kind == DIFF_ITEM_STRUCT && final_mask != b.field_or_variant_mask {
                        res.abi_layout_changed = true;
                    }

                    let converged = l_Modified && r_Modified &&
                        l.name_hash == r.name_hash && l.module_hash == r.module_hash &&
                        l.sig_hash == r.sig_hash && l.body_ast_hash == r.body_ast_hash;
                    let ren_body = (l_renamed && r_body_chg && !r_renamed) || (r_renamed && l_body_chg && !l_renamed);
                    let mov_body = (l_moved && r_body_chg && !r_moved) || (r_moved && l_body_chg && !l_moved);
                    let fmt_body = ((l.formatting_hash != b.formatting_hash || l.doc_comment_hash != b.doc_comment_hash) && r_body_chg) ||
                        ((r.formatting_hash != b.formatting_hash || r.doc_comment_hash != b.doc_comment_hash) && l_body_chg);

                    let mut m = empty_merged;
                    m.present = true;
                    m.item_kind = b.item_kind;
                    m.semantic_key = target_key;
                    m.final_name_hash = final_name;
                    m.final_module_hash = final_mod;
                    m.final_sig_hash = final_sig;
                    m.final_body_ast_hash = final_body;
                    m.final_doc_comment_hash = final_doc;
                    m.final_field_or_variant_mask = final_mask;
                    m.converged_idempotent = converged;
                    m.auto_merged_rename_and_body = ren_body;
                    m.auto_merged_move_and_body = mov_body;
                    m.auto_merged_formatting = fmt_body;
                    m.rewrote_call_sites = ren_body || mov_body;
                    res.merged_items[res.merged_count as usize] = m;
                    res.merged_count = res.merged_count + 1u32;
                }
            }
        }
        i = i + 1u32;
    }

    if res.conflict_count > 0u32 {
        res.status = MERGE_STATUS_CONFLICTED;
        res.verified_by_compiler_db = false;
    } else if bundle.post_merge_compiler_diag != 0u32 {
        // Post-merge `CompilerDB` verification gate (`SPEC-102 §5.3 AXS-REF-042 §3`, `MERGE-INV-31, 38`, `REQ-TOOL-186`):
        // Syntactically disjoint changes in `LEFT` and `RIGHT` failed `CompilerDB` type/ownership/capability verification!
        axmerge_record_conflict(
            mut_view(res),
            CONFLICT_SEMANTIC_VERIFICATION,
            MERGE_ID_LEVEL_SYMBOL_KEY,
            bundle.post_merge_target_key,
            0u64,
            bundle.post_merge_compiler_diag as u64,
            bundle.post_merge_compiler_diag as u64,
            0u32,
            0u32,
            0u32,
            bundle.post_merge_compiler_diag
        );
        res.status = MERGE_STATUS_SEMANTIC_CONFLICT;
        res.verified_by_compiler_db = false;
    } else {
        res.status = MERGE_STATUS_CLEAN;
        res.verified_by_compiler_db = true;
    }

    let mut mh: u64 = 0x41584d4552474531u64;
    mh = axdiff_mix_hash(mh, res.status as u64);
    mh = axdiff_mix_hash(mh, res.merged_import_mask as u64);
    mh = axdiff_mix_hash(mh, res.merged_count as u64);
    mh = axdiff_mix_hash(mh, res.conflict_count as u64);
    let mut mi: u32 = 0u32;
    while mi < res.merged_count {
        let m = res.merged_items[mi as usize];
        mh = axdiff_mix_hash(mh, m.semantic_key);
        mh = axdiff_mix_hash(mh, m.final_name_hash);
        mh = axdiff_mix_hash(mh, m.final_module_hash);
        mh = axdiff_mix_hash(mh, m.final_sig_hash);
        mh = axdiff_mix_hash(mh, m.final_body_ast_hash);
        mi = mi + 1u32;
    }
    res.merge_hash = mh;
    res
}
