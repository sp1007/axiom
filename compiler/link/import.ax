// Emits `axiom_start`, `axiom_panic`, `__ax_host_print`, and `__ax_host_print_int` into `.text`
// and registers their relocations and global symbols. Returns `axiom_start_offset`.
pub fn linker_emit_runtime_stubs(ctx: mut_view<LinkerContext>) -> u32 {
    let text_chars = IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ;
    let text_sec = linker_get_or_create_section_str(mut_view(*ctx), { ".text" }, text_chars);

    // 1. axiom_start (86 bytes, align 16)
    let start_code = AXIOM_START_CODE;
    let axiom_start_offset = linker_append_section_slice(text_sec, view(start_code), 16u32);
    linker_add_reloc_str(mut_view(*ctx), text_sec, axiom_start_offset + 17u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetStdHandle" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, axiom_start_offset + 31u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetConsoleMode" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, axiom_start_offset + 41u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetConsoleOutputCP" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, axiom_start_offset + 54u32, IMAGE_REL_AMD64_REL32, { "__IAT_SetConsoleOutputCP" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, axiom_start_offset + 59u32, IMAGE_REL_AMD64_REL32, { "main" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, axiom_start_offset + 73u32, IMAGE_REL_AMD64_REL32, { "__IAT_SetConsoleOutputCP" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, axiom_start_offset + 81u32, IMAGE_REL_AMD64_REL32, { "__IAT_ExitProcess" }, 0i64);

    // 2. axiom_panic (64 bytes, align 16)
    let panic_code = AXIOM_PANIC_CODE;
    let panic_offset = linker_append_section_slice(text_sec, view(panic_code), 16u32);
    linker_add_reloc_str(mut_view(*ctx), text_sec, panic_offset + 19u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetStdHandle" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, panic_offset + 48u32, IMAGE_REL_AMD64_REL32, { "__IAT_WriteFile" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, panic_offset + 59u32, IMAGE_REL_AMD64_REL32, { "__IAT_ExitProcess" }, 0i64);

    let panic_sym = linker_add_global_str(mut_view(*ctx), { "axiom_panic" });
    unsafe {
        (*panic_sym).defined = true;
        (*panic_sym).sec = text_sec;
        (*panic_sym).offset = panic_offset;
    }

    // 3. __ax_host_print (59 bytes, align 16)
    let print_code = AXIOM_PRINT_CODE;
    let print_offset = linker_append_section_slice(text_sec, view(print_code), 16u32);
    linker_add_reloc_str(mut_view(*ctx), text_sec, print_offset + 17u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetStdHandle" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, print_offset + 49u32, IMAGE_REL_AMD64_REL32, { "__IAT_WriteFile" }, 0i64);

    let print_sym = linker_add_global_str(mut_view(*ctx), { "__ax_host_print" });
    unsafe {
        (*print_sym).defined = true;
        (*print_sym).sec = text_sec;
        (*print_sym).offset = print_offset;
    }

    // 4. __ax_host_print_int (119 bytes, align 16)
    let print_int_code = AXIOM_PRINT_INT_CODE;
    let print_int_offset = linker_append_section_slice(text_sec, view(print_int_code), 16u32);
    linker_add_reloc_str(mut_view(*ctx), text_sec, print_int_offset + 75u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetStdHandle" }, 0i64);
    linker_add_reloc_str(mut_view(*ctx), text_sec, print_int_offset + 107u32, IMAGE_REL_AMD64_REL32, { "__IAT_WriteFile" }, 0i64);

    let print_int_sym = linker_add_global_str(mut_view(*ctx), { "__ax_host_print_int" });
    unsafe {
        (*print_int_sym).defined = true;
        (*print_int_sym).sec = text_sec;
        (*print_int_sym).offset = print_int_offset;
    }

    axiom_start_offset
}

fn cstr_eq_str(s: *const u8, lit: Str) -> bool {
    if (s as usize) == 0 {
        return false;
    }
    let bytes: view<[u8]> = unsafe { *(address_of(lit) as *const view<[u8]>) };
    let n = len(bytes);
    let slen = cstr_len(s);
    if slen != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        if (unsafe { *(s + i) }) != bytes[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn linker_has_defined_global_str(ctx: view<LinkerContext>, name: Str) -> bool {
    let mut tmp = pe_str_to_cstr_buf(name);
    let g = linker_find_global(ctx, tmp.ptr as *const u8);
    coff_buf_free(mut_view(tmp));
    if (g as usize) == 0 {
        return false;
    }
    unsafe { (*g).defined }
}

// Emits DLL runtime support stubs (`axiom_panic`, `__ax_host_print`, `__ax_host_print_int`) and
// synthesizes `_DllMainCRTStartup(hinstDLL, fdwReason, lpvReserved) -> BOOL` in `.text`
// (SPEC-26 AXS-WLIB-022, ADR-0001 section 5-6, SPEC-56 AXS-MOD-012).
// Returns the `.text` section offset of `_DllMainCRTStartup`.
pub fn linker_emit_dll_runtime_stubs(ctx: mut_view<LinkerContext>) -> u32 {
    let text_chars = IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ;
    let text_sec = linker_get_or_create_section_str(mut_view(*ctx), { ".text" }, text_chars);

    // 1. axiom_panic (if not already provided by an input object)
    if !linker_has_defined_global_str(view(*ctx), { "axiom_panic" }) {
        let panic_code = AXIOM_PANIC_CODE;
        let panic_offset = linker_append_section_slice(text_sec, view(panic_code), 16u32);
        linker_add_reloc_str(mut_view(*ctx), text_sec, panic_offset + 19u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetStdHandle" }, 0i64);
        linker_add_reloc_str(mut_view(*ctx), text_sec, panic_offset + 48u32, IMAGE_REL_AMD64_REL32, { "__IAT_WriteFile" }, 0i64);
        linker_add_reloc_str(mut_view(*ctx), text_sec, panic_offset + 59u32, IMAGE_REL_AMD64_REL32, { "__IAT_ExitProcess" }, 0i64);
        let panic_sym = linker_add_global_str(mut_view(*ctx), { "axiom_panic" });
        unsafe {
            (*panic_sym).defined = true;
            (*panic_sym).sec = text_sec;
            (*panic_sym).offset = panic_offset;
        }
    }

    // 2. __ax_host_print
    if !linker_has_defined_global_str(view(*ctx), { "__ax_host_print" }) {
        let print_code = AXIOM_PRINT_CODE;
        let print_offset = linker_append_section_slice(text_sec, view(print_code), 16u32);
        linker_add_reloc_str(mut_view(*ctx), text_sec, print_offset + 17u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetStdHandle" }, 0i64);
        linker_add_reloc_str(mut_view(*ctx), text_sec, print_offset + 49u32, IMAGE_REL_AMD64_REL32, { "__IAT_WriteFile" }, 0i64);
        let print_sym = linker_add_global_str(mut_view(*ctx), { "__ax_host_print" });
        unsafe {
            (*print_sym).defined = true;
            (*print_sym).sec = text_sec;
            (*print_sym).offset = print_offset;
        }
    }

    // 3. __ax_host_print_int
    if !linker_has_defined_global_str(view(*ctx), { "__ax_host_print_int" }) {
        let print_int_code = AXIOM_PRINT_INT_CODE;
        let print_int_offset = linker_append_section_slice(text_sec, view(print_int_code), 16u32);
        linker_add_reloc_str(mut_view(*ctx), text_sec, print_int_offset + 75u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetStdHandle" }, 0i64);
        linker_add_reloc_str(mut_view(*ctx), text_sec, print_int_offset + 107u32, IMAGE_REL_AMD64_REL32, { "__IAT_WriteFile" }, 0i64);
        let print_int_sym = linker_add_global_str(mut_view(*ctx), { "__ax_host_print_int" });
        unsafe {
            (*print_int_sym).defined = true;
            (*print_int_sym).sec = text_sec;
            (*print_int_sym).offset = print_int_offset;
        }
    }

    // If an input object already defined `_DllMainCRTStartup`, honour it directly.
    if linker_has_defined_global_str(view(*ctx), { "_DllMainCRTStartup" }) {
        let mut tmp_dm = pe_str_to_cstr_buf({ "_DllMainCRTStartup" });
        let g_dm = linker_find_global(view(*ctx), tmp_dm.ptr as *const u8);
        coff_buf_free(mut_view(tmp_dm));
        if (g_dm as usize) != 0 {
            return unsafe { (*g_dm).offset };
        }
    }

    // Inspect optional hooks defined in input objects:
    // - `__ax_resolve_module_bindings() -> bool` (SPEC-56 AXS-MOD-012)
    // - `__ax_dll_entry_{0,3}_{unit,bool,i32}` user `@entry` hook
    let has_mod_bind = linker_has_defined_global_str(view(*ctx), { "__ax_resolve_module_bindings" });
    let mut entry_kind: u32 = 0u32;
    let mut entry_sym_str: Str = { "" };
    if linker_has_defined_global_str(view(*ctx), { "__ax_dll_entry_0_unit" }) {
        entry_kind = 1u32;
        entry_sym_str = { "__ax_dll_entry_0_unit" };
    } else if linker_has_defined_global_str(view(*ctx), { "__ax_dll_entry_0_bool" }) {
        entry_kind = 2u32;
        entry_sym_str = { "__ax_dll_entry_0_bool" };
    } else if linker_has_defined_global_str(view(*ctx), { "__ax_dll_entry_0_i32" }) {
        entry_kind = 3u32;
        entry_sym_str = { "__ax_dll_entry_0_i32" };
    } else if linker_has_defined_global_str(view(*ctx), { "__ax_dll_entry_3_unit" }) {
        entry_kind = 4u32;
        entry_sym_str = { "__ax_dll_entry_3_unit" };
    } else if linker_has_defined_global_str(view(*ctx), { "__ax_dll_entry_3_bool" }) {
        entry_kind = 5u32;
        entry_sym_str = { "__ax_dll_entry_3_bool" };
    } else if linker_has_defined_global_str(view(*ctx), { "__ax_dll_entry_3_i32" }) {
        entry_kind = 6u32;
        entry_sym_str = { "__ax_dll_entry_3_i32" };
    }

    let mut code = coff_buf_with_capacity(128);
    // Prologue: push rbx; push rsi; push rdi; sub rsp, 0x20 (aligns RSP to 16 bytes + 32B shadow)
    coff_buf_put_u8(mut_view(code), 0x53u8);
    coff_buf_put_u8(mut_view(code), 0x56u8);
    coff_buf_put_u8(mut_view(code), 0x57u8);
    coff_buf_put_u8(mut_view(code), 0x48u8);
    coff_buf_put_u8(mut_view(code), 0x83u8);
    coff_buf_put_u8(mut_view(code), 0xECu8);
    coff_buf_put_u8(mut_view(code), 0x20u8);
    // Save Win64 params: mov rbx, rcx; mov esi, edx; mov rdi, r8
    coff_buf_put_u8(mut_view(code), 0x48u8);
    coff_buf_put_u8(mut_view(code), 0x89u8);
    coff_buf_put_u8(mut_view(code), 0xCBu8);
    coff_buf_put_u8(mut_view(code), 0x89u8);
    coff_buf_put_u8(mut_view(code), 0xD6u8);
    coff_buf_put_u8(mut_view(code), 0x4Cu8);
    coff_buf_put_u8(mut_view(code), 0x89u8);
    coff_buf_put_u8(mut_view(code), 0xC7u8);

    // cmp esi, 1 (DLL_PROCESS_ATTACH); jne non_attach
    coff_buf_put_u8(mut_view(code), 0x83u8);
    coff_buf_put_u8(mut_view(code), 0xFEu8);
    coff_buf_put_u8(mut_view(code), 0x01u8);
    coff_buf_put_u8(mut_view(code), 0x0Fu8);
    coff_buf_put_u8(mut_view(code), 0x85u8);
    let jne_non_attach_disp_off: usize = code.len;
    coff_buf_put_u32(mut_view(code), 0u32);

    let mut mod_bind_reloc_off: u32 = 0u32;
    let mut has_mod_bind_jz: bool = false;
    let mut jz_mod_bind_disp_off: usize = 0;
    if has_mod_bind {
        // call __ax_resolve_module_bindings
        coff_buf_put_u8(mut_view(code), 0xE8u8);
        mod_bind_reloc_off = code.len as u32;
        coff_buf_put_u32(mut_view(code), 0u32);
        // test al, al; jz ret_false
        coff_buf_put_u8(mut_view(code), 0x84u8);
        coff_buf_put_u8(mut_view(code), 0xC0u8);
        coff_buf_put_u8(mut_view(code), 0x0Fu8);
        coff_buf_put_u8(mut_view(code), 0x84u8);
        jz_mod_bind_disp_off = code.len;
        has_mod_bind_jz = true;
        coff_buf_put_u32(mut_view(code), 0u32);
    }

    let mut attach_entry_reloc_off: u32 = 0u32;
    let mut has_attach_entry_call: bool = false;
    let mut has_attach_entry_jz: bool = false;
    let mut jz_attach_entry_disp_off: usize = 0;
    if entry_kind != 0u32 {
        if entry_kind >= 4u32 {
            // mov rcx, rbx; mov edx, esi; mov r8, rdi
            coff_buf_put_u8(mut_view(code), 0x48u8);
            coff_buf_put_u8(mut_view(code), 0x89u8);
            coff_buf_put_u8(mut_view(code), 0xD9u8);
            coff_buf_put_u8(mut_view(code), 0x89u8);
            coff_buf_put_u8(mut_view(code), 0xF2u8);
            coff_buf_put_u8(mut_view(code), 0x49u8);
            coff_buf_put_u8(mut_view(code), 0x89u8);
            coff_buf_put_u8(mut_view(code), 0xF8u8);
        }
        coff_buf_put_u8(mut_view(code), 0xE8u8);
        attach_entry_reloc_off = code.len as u32;
        has_attach_entry_call = true;
        coff_buf_put_u32(mut_view(code), 0u32);
        if entry_kind == 2u32 || entry_kind == 5u32 {
            // test al, al; jz ret_false
            coff_buf_put_u8(mut_view(code), 0x84u8);
            coff_buf_put_u8(mut_view(code), 0xC0u8);
            coff_buf_put_u8(mut_view(code), 0x0Fu8);
            coff_buf_put_u8(mut_view(code), 0x84u8);
            jz_attach_entry_disp_off = code.len;
            has_attach_entry_jz = true;
            coff_buf_put_u32(mut_view(code), 0u32);
        } else if entry_kind == 3u32 || entry_kind == 6u32 {
            // test eax, eax; jz ret_false
            coff_buf_put_u8(mut_view(code), 0x85u8);
            coff_buf_put_u8(mut_view(code), 0xC0u8);
            coff_buf_put_u8(mut_view(code), 0x0Fu8);
            coff_buf_put_u8(mut_view(code), 0x84u8);
            jz_attach_entry_disp_off = code.len;
            has_attach_entry_jz = true;
            coff_buf_put_u32(mut_view(code), 0u32);
        }
    }

    // jmp ret_true
    coff_buf_put_u8(mut_view(code), 0xE9u8);
    let jmp_attach_true_disp_off: usize = code.len;
    coff_buf_put_u32(mut_view(code), 0u32);

    // non_attach: (DLL_PROCESS_DETACH = 0, DLL_THREAD_ATTACH = 2, DLL_THREAD_DETACH = 3)
    let non_attach_label: usize = code.len;
    let mut detach_entry_reloc_off: u32 = 0u32;
    let mut has_detach_entry_call: bool = false;
    let mut has_detach_jmp_epilogue: bool = false;
    let mut jmp_detach_epilogue_disp_off: usize = 0;
    if entry_kind >= 4u32 {
        // mov rcx, rbx; mov edx, esi; mov r8, rdi
        coff_buf_put_u8(mut_view(code), 0x48u8);
        coff_buf_put_u8(mut_view(code), 0x89u8);
        coff_buf_put_u8(mut_view(code), 0xD9u8);
        coff_buf_put_u8(mut_view(code), 0x89u8);
        coff_buf_put_u8(mut_view(code), 0xF2u8);
        coff_buf_put_u8(mut_view(code), 0x49u8);
        coff_buf_put_u8(mut_view(code), 0x89u8);
        coff_buf_put_u8(mut_view(code), 0xF8u8);
        coff_buf_put_u8(mut_view(code), 0xE8u8);
        detach_entry_reloc_off = code.len as u32;
        has_detach_entry_call = true;
        coff_buf_put_u32(mut_view(code), 0u32);
        if entry_kind == 5u32 {
            // movzx eax, al; jmp epilogue
            coff_buf_put_u8(mut_view(code), 0x0Fu8);
            coff_buf_put_u8(mut_view(code), 0xB6u8);
            coff_buf_put_u8(mut_view(code), 0xC0u8);
            coff_buf_put_u8(mut_view(code), 0xE9u8);
            jmp_detach_epilogue_disp_off = code.len;
            has_detach_jmp_epilogue = true;
            coff_buf_put_u32(mut_view(code), 0u32);
        } else if entry_kind == 6u32 {
            // jmp epilogue (keep eax)
            coff_buf_put_u8(mut_view(code), 0xE9u8);
            jmp_detach_epilogue_disp_off = code.len;
            has_detach_jmp_epilogue = true;
            coff_buf_put_u32(mut_view(code), 0u32);
        }
    }

    // ret_true: mov eax, 1; jmp +2 (over `xor eax, eax`)
    let ret_true_label: usize = code.len;
    coff_buf_put_u8(mut_view(code), 0xB8u8);
    coff_buf_put_u32(mut_view(code), 1u32);
    coff_buf_put_u8(mut_view(code), 0xEBu8);
    coff_buf_put_u8(mut_view(code), 0x02u8);

    // ret_false: xor eax, eax
    let ret_false_label: usize = code.len;
    coff_buf_put_u8(mut_view(code), 0x31u8);
    coff_buf_put_u8(mut_view(code), 0xC0u8);

    // epilogue: add rsp, 0x20; pop rdi; pop rsi; pop rbx; ret
    let epilogue_label: usize = code.len;
    coff_buf_put_u8(mut_view(code), 0x48u8);
    coff_buf_put_u8(mut_view(code), 0x83u8);
    coff_buf_put_u8(mut_view(code), 0xC4u8);
    coff_buf_put_u8(mut_view(code), 0x20u8);
    coff_buf_put_u8(mut_view(code), 0x5Fu8);
    coff_buf_put_u8(mut_view(code), 0x5Eu8);
    coff_buf_put_u8(mut_view(code), 0x5Bu8);
    coff_buf_put_u8(mut_view(code), 0xC3u8);

    // Patch intra-stub relative branches
    coff_write_u32_le(code.ptr, jne_non_attach_disp_off, ((non_attach_label as i32) - ((jne_non_attach_disp_off + 4) as i32)) as u32);
    coff_write_u32_le(code.ptr, jmp_attach_true_disp_off, ((ret_true_label as i32) - ((jmp_attach_true_disp_off + 4) as i32)) as u32);
    if has_mod_bind_jz {
        coff_write_u32_le(code.ptr, jz_mod_bind_disp_off, ((ret_false_label as i32) - ((jz_mod_bind_disp_off + 4) as i32)) as u32);
    }
    if has_attach_entry_jz {
        coff_write_u32_le(code.ptr, jz_attach_entry_disp_off, ((ret_false_label as i32) - ((jz_attach_entry_disp_off + 4) as i32)) as u32);
    }
    if has_detach_jmp_epilogue {
        coff_write_u32_le(code.ptr, jmp_detach_epilogue_disp_off, ((epilogue_label as i32) - ((jmp_detach_epilogue_disp_off + 4) as i32)) as u32);
    }

    let mut dllmain_off_out: [1]u32 = [0u32];
    let pdllmain_off = unsafe { address_of(dllmain_off_out[0]) as *mut u32 };
    linker_append_section_data(text_sec, code.ptr as *const u8, code.len as u32, 16u32, pdllmain_off);
    let dllmain_offset = dllmain_off_out[0];
    coff_buf_free(mut_view(code));

    if has_mod_bind {
        linker_add_reloc_str(mut_view(*ctx), text_sec, dllmain_offset + mod_bind_reloc_off, IMAGE_REL_AMD64_REL32, { "__ax_resolve_module_bindings" }, 0i64);
    }
    if has_attach_entry_call {
        linker_add_reloc_str(mut_view(*ctx), text_sec, dllmain_offset + attach_entry_reloc_off, IMAGE_REL_AMD64_REL32, entry_sym_str, 0i64);
    }
    if has_detach_entry_call {
        let detach_sym_str: Str = if entry_kind == 4u32 {
            { "__ax_dll_entry_3_unit" }
        } else if entry_kind == 5u32 {
            { "__ax_dll_entry_3_bool" }
        } else {
            { "__ax_dll_entry_3_i32" }
        };
        linker_add_reloc_str(mut_view(*ctx), text_sec, dllmain_offset + detach_entry_reloc_off, IMAGE_REL_AMD64_REL32, detach_sym_str, 0i64);
    }

    let dm_sym = linker_add_global_str(mut_view(*ctx), { "_DllMainCRTStartup" });
    unsafe {
        (*dm_sym).defined = true;
        (*dm_sym).sec = text_sec;
        (*dm_sym).offset = dllmain_offset;
    }

    dllmain_offset
}

// Emits a standalone COFF relocatable object (`axiom_rt.obj`) containing `axiom_start`,
// `axiom_panic`, `__ax_host_print`, and `__ax_host_print_int` with standard `__imp_*`
// imports so `--emit=obj` outputs link cleanly under GNU `ld` / `gcc` (ADR-0034 section 4 OI-07b).
pub fn pe_build_runtime_coff_obj(out: mut_view<CoffBuf>) -> bool {
    let mut model = objmodel_new();
    let text_id_v = objmodel_add_section_str(
        mut_view(model),
        { ".text" },
        SEC_CODE,
        SEC_FLAG_EXEC | SEC_FLAG_READ,
        16u32
    ).v;
    let sym_main_v = objmodel_add_symbol_str(mut_view(model), { "main" }, SectionId.none(), 0u64, 0u64, SYM_EXTERNAL).v;
    let sym_get_std_handle_v = objmodel_add_symbol_str(mut_view(model), { "__imp_GetStdHandle" }, SectionId.none(), 0u64, 0u64, SYM_EXTERNAL).v;
    let sym_get_console_mode_v = objmodel_add_symbol_str(mut_view(model), { "__imp_GetConsoleMode" }, SectionId.none(), 0u64, 0u64, SYM_EXTERNAL).v;
    let sym_get_console_cp_v = objmodel_add_symbol_str(mut_view(model), { "__imp_GetConsoleOutputCP" }, SectionId.none(), 0u64, 0u64, SYM_EXTERNAL).v;
    let sym_set_console_cp_v = objmodel_add_symbol_str(mut_view(model), { "__imp_SetConsoleOutputCP" }, SectionId.none(), 0u64, 0u64, SYM_EXTERNAL).v;
    let sym_write_file_v = objmodel_add_symbol_str(mut_view(model), { "__imp_WriteFile" }, SectionId.none(), 0u64, 0u64, SYM_EXTERNAL).v;
    let sym_exit_process_v = objmodel_add_symbol_str(mut_view(model), { "__imp_ExitProcess" }, SectionId.none(), 0u64, 0u64, SYM_EXTERNAL).v;

    let sec = objmodel_get_section_mut(mut_view(model), SectionId { v: text_id_v });
    if (sec as usize) == 0 {
        objmodel_free(mut_view(model));
        return false;
    }

    // 1. axiom_start (86 bytes at offset 0)
    let start_off: u32 = 0u32;
    let start_code = AXIOM_START_CODE;
    section_append_slice(unsafe { mut_view(*sec) }, view(start_code));
    let _ = objmodel_add_symbol_str(mut_view(model), { "axiom_start" }, SectionId { v: text_id_v }, start_off as u64, 86u64, SYM_GLOBAL);

    let sec1 = objmodel_get_section_mut(mut_view(model), SectionId { v: text_id_v });
    section_add_reloc(unsafe { mut_view(*sec1) }, start_off + 17u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_get_std_handle_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec1) }, start_off + 31u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_get_console_mode_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec1) }, start_off + 41u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_get_console_cp_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec1) }, start_off + 54u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_set_console_cp_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec1) }, start_off + 59u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_main_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec1) }, start_off + 73u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_set_console_cp_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec1) }, start_off + 81u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_exit_process_v }, -4i64);
    section_append_zeroes(unsafe { mut_view(*sec1) }, 10); // pad 86 -> 96

    // 2. axiom_panic (64 bytes at offset 96)
    let panic_off: u32 = 96u32;
    let panic_code = AXIOM_PANIC_CODE;
    section_append_slice(unsafe { mut_view(*sec1) }, view(panic_code));
    let _ = objmodel_add_symbol_str(mut_view(model), { "axiom_panic" }, SectionId { v: text_id_v }, panic_off as u64, 64u64, SYM_GLOBAL);

    let sec2 = objmodel_get_section_mut(mut_view(model), SectionId { v: text_id_v });
    section_add_reloc(unsafe { mut_view(*sec2) }, panic_off + 19u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_get_std_handle_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec2) }, panic_off + 48u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_write_file_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec2) }, panic_off + 59u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_exit_process_v }, -4i64);

    // 3. __ax_host_print (59 bytes at offset 160)
    let print_off: u32 = 160u32;
    let print_code = AXIOM_PRINT_CODE;
    section_append_slice(unsafe { mut_view(*sec2) }, view(print_code));
    let _ = objmodel_add_symbol_str(mut_view(model), { "__ax_host_print" }, SectionId { v: text_id_v }, print_off as u64, 59u64, SYM_GLOBAL);

    let sec3 = objmodel_get_section_mut(mut_view(model), SectionId { v: text_id_v });
    section_add_reloc(unsafe { mut_view(*sec3) }, print_off + 17u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_get_std_handle_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec3) }, print_off + 49u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_write_file_v }, -4i64);
    section_append_zeroes(unsafe { mut_view(*sec3) }, 5); // pad 219 -> 224

    // 4. __ax_host_print_int (119 bytes at offset 224)
    let print_int_off: u32 = 224u32;
    let print_int_code = AXIOM_PRINT_INT_CODE;
    section_append_slice(unsafe { mut_view(*sec3) }, view(print_int_code));
    let _ = objmodel_add_symbol_str(mut_view(model), { "__ax_host_print_int" }, SectionId { v: text_id_v }, print_int_off as u64, 119u64, SYM_GLOBAL);

    let sec4 = objmodel_get_section_mut(mut_view(model), SectionId { v: text_id_v });
    section_add_reloc(unsafe { mut_view(*sec4) }, print_int_off + 75u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_get_std_handle_v }, -4i64);
    section_add_reloc(unsafe { mut_view(*sec4) }, print_int_off + 107u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_write_file_v }, -4i64);

    let ok = coff_write_to_buf(view(model), out);
    objmodel_free(mut_view(model));
    ok
}

// --- Import Table Data Structures (ImportFunc, ImportDll, ImportTable) ---

pub struct ImportFunc {
    pub name: *const u8,
    pub full_sym: *const u8,
    pub hint: u16,
    pub emit_thunk: bool,
    pub hint_offset: u32,
    pub iat_offset: u32,
    pub thunk_offset: u32,
}

pub struct ImportDll {
    pub dll_name: *const u8,
    pub funcs: *mut ImportFunc,
    pub num_funcs: usize,
    pub cap_funcs: usize,
    pub desc_offset: u32,
    pub ilt_offset: u32,
    pub iat_offset: u32,
    pub dll_name_offset: u32,
}

pub struct ImportTable {
    pub dlls: *mut ImportDll,
    pub num_dlls: usize,
    pub cap_dlls: usize,
    pub desc_offset: u32,
    pub all_iats_start: u32,
    pub all_iats_size: u32,
    pub idata_base: u32,
}

pub fn import_table_new() -> ImportTable {
    ImportTable {
        dlls: 0 as *mut ImportDll,
        num_dlls: 0,
        cap_dlls: 0,
        desc_offset: 0u32,
        all_iats_start: 0u32,
        all_iats_size: 0u32,
        idata_base: 0u32,
    }
}

pub fn import_table_init(tbl: mut_view<ImportTable>) {
    tbl.dlls = 0 as *mut ImportDll;
    tbl.num_dlls = 0;
    tbl.cap_dlls = 0;
    tbl.desc_offset = 0u32;
    tbl.all_iats_start = 0u32;
    tbl.all_iats_size = 0u32;
    tbl.idata_base = 0u32;
}

pub unsafe fn import_dll_slot_ptr(base: *mut ImportDll, idx: usize) -> *mut ImportDll {
    ((base as usize) + coff_mul_usize(idx, size_of<ImportDll>())) as *mut ImportDll
}

pub unsafe fn import_func_slot_ptr(base: *mut ImportFunc, idx: usize) -> *mut ImportFunc {
    ((base as usize) + coff_mul_usize(idx, size_of<ImportFunc>())) as *mut ImportFunc
}

pub fn import_dll_at(tbl: view<ImportTable>, idx: usize) -> *mut ImportDll {
    if idx >= tbl.num_dlls || (tbl.dlls as usize) == 0 {
        return 0 as *mut ImportDll;
    }
    unsafe { import_dll_slot_ptr(tbl.dlls, idx) }
}

pub fn import_func_at(dll: *const ImportDll, idx: usize) -> *mut ImportFunc {
    if (dll as usize) == 0 {
        return 0 as *mut ImportFunc;
    }
    let n = unsafe { (*dll).num_funcs };
    let funcs = unsafe { (*dll).funcs };
    if idx >= n || (funcs as usize) == 0 {
        return 0 as *mut ImportFunc;
    }
    unsafe { import_func_slot_ptr(funcs, idx) }
}

pub fn import_table_free(tbl: mut_view<ImportTable>) {
    let mut d: usize = 0;
    while d < tbl.num_dlls {
        let dll = unsafe { import_dll_slot_ptr(tbl.dlls, d) };
        unsafe {
            if (*dll).cap_funcs > 0 && ((*dll).funcs as usize) != 0 {
                heap_free(
                    (*dll).funcs as *mut u8,
                    coff_mul_usize((*dll).cap_funcs, size_of<ImportFunc>()),
                    align_of<ImportFunc>()
                );
            }
            (*dll).funcs = 0 as *mut ImportFunc;
            (*dll).num_funcs = 0;
            (*dll).cap_funcs = 0;
        }
        d = d + 1;
    }
    if tbl.cap_dlls > 0 && (tbl.dlls as usize) != 0 {
        unsafe {
            heap_free(
                tbl.dlls as *mut u8,
                coff_mul_usize(tbl.cap_dlls, size_of<ImportDll>()),
                align_of<ImportDll>()
            );
        }
    }
    tbl.dlls = 0 as *mut ImportDll;
    tbl.num_dlls = 0;
    tbl.cap_dlls = 0;
}

// Normalizes a DLL name (appends `.dll` if missing, canonicalizes `kernel32.dll` -> `KERNEL32.dll`).
pub fn import_normalize_dll_name(ctx: mut_view<LinkerContext>, raw_name: *const u8, raw_len: usize) -> *const u8 {
    let dll_ext: [4]u8 = [46u8, 100u8, 108u8, 108u8]; // ".dll"
    let pdll_ext = unsafe { address_of(dll_ext[0]) };

    let has_ext = if raw_len >= 4 {
        pe_bytes_ieq(unsafe { raw_name + (raw_len - 4) }, 4, pdll_ext, 4)
    } else {
        false
    };

    let norm_len = if has_ext { raw_len } else { raw_len + 4 };
    let mut tmp = coff_buf_with_capacity(norm_len + 1);
    coff_buf_put_bytes(mut_view(tmp), raw_name, raw_len);
    if !has_ext {
        coff_buf_put_bytes(mut_view(tmp), pdll_ext, 4);
    }
    coff_buf_put_u8(mut_view(tmp), 0u8);

    // Check if it matches "kernel32.dll" case-insensitively -> "KERNEL32.dll"
    let k32_canon: [13]u8 = [
        75u8, 69u8, 82u8, 78u8, 69u8, 76u8, 51u8, 50u8,
        46u8, 100u8, 108u8, 108u8, 0u8,
    ];
    let pk32 = unsafe { address_of(k32_canon[0]) };
    let res = if pe_bytes_ieq(tmp.ptr as *const u8, norm_len, pk32, 12) {
        linker_dup_bytes(ctx, pk32, 12)
    } else {
        linker_dup_bytes(ctx, tmp.ptr as *const u8, norm_len)
    };
    coff_buf_free(mut_view(tmp));
    res
}

pub fn import_find_or_add_dll_bytes(tbl: mut_view<ImportTable>, ctx: mut_view<LinkerContext>, name: *const u8, name_len: usize) -> *mut ImportDll {
    let norm = import_normalize_dll_name(mut_view(*ctx), name, name_len);

    let mut i: usize = 0;
    while i < tbl.num_dlls {
        let existing = import_dll_at(view(*tbl), i);
        let edll = unsafe { (*existing).dll_name };
        if pe_cstr_ieq(edll, norm) {
            return existing;
        }
        i = i + 1;
    }

    if tbl.num_dlls == tbl.cap_dlls {
        let new_cap = if tbl.cap_dlls == 0 { 8 } else { tbl.cap_dlls + tbl.cap_dlls };
        let new_bytes = coff_mul_usize(new_cap, size_of<ImportDll>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<ImportDll>()) as *mut ImportDll };
        if tbl.num_dlls > 0 && (tbl.dlls as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    tbl.dlls as *const u8,
                    new_arr as *mut u8,
                    coff_mul_usize(tbl.num_dlls, size_of<ImportDll>())
                );
                heap_free(
                    tbl.dlls as *mut u8,
                    coff_mul_usize(tbl.cap_dlls, size_of<ImportDll>()),
                    align_of<ImportDll>()
                );
            }
        }
        tbl.dlls = new_arr;
        tbl.cap_dlls = new_cap;
    }

    let slot = unsafe { import_dll_slot_ptr(tbl.dlls, tbl.num_dlls) };
    unsafe {
        *slot = ImportDll {
            dll_name: norm,
            funcs: 0 as *mut ImportFunc,
            num_funcs: 0,
            cap_funcs: 0,
            desc_offset: 0u32,
            ilt_offset: 0u32,
            iat_offset: 0u32,
            dll_name_offset: 0u32,
        };
    }
    tbl.num_dlls = tbl.num_dlls + 1;
    slot
}

pub fn import_find_or_add_dll(tbl: mut_view<ImportTable>, ctx: mut_view<LinkerContext>, name: *const u8) -> *mut ImportDll {
    import_find_or_add_dll_bytes(tbl, ctx, name, cstr_len(name))
}

pub fn import_find_or_add_dll_str(tbl: mut_view<ImportTable>, ctx: mut_view<LinkerContext>, name: Str) -> *mut ImportDll {
    let mut tmp = pe_str_to_cstr_buf(name);
    let n = tmp.len - 1;
    let res = import_find_or_add_dll_bytes(tbl, ctx, tmp.ptr as *const u8, n);
    coff_buf_free(mut_view(tmp));
    res
}

pub fn import_add_func_ex(
    ctx: mut_view<LinkerContext>,
    dll: *mut ImportDll,
    func_name: *const u8,
    full_sym: *const u8,
    hint: u16,
    emit_thunk: bool
) -> *mut ImportFunc {
    if (dll as usize) == 0 {
        return 0 as *mut ImportFunc;
    }
    let num_funcs = unsafe { (*dll).num_funcs };
    let f0 = unsafe { *func_name };
    let mut i: usize = 0;
    while i < num_funcs {
        let fn_ptr = import_func_at(dll as *const ImportDll, i);
        let existing_name = unsafe { (*fn_ptr).name };
        if (unsafe { *existing_name }) == f0 && cstr_eq(existing_name, func_name) {
            let existing_full = unsafe { (*fn_ptr).full_sym };
            if (existing_full as usize) == 0 && (full_sym as usize) != 0 {
                let dup_full = linker_dup_cstr(mut_view(*ctx), full_sym);
                unsafe {
                    (*fn_ptr).full_sym = dup_full;
                }
            }
            if (unsafe { (*fn_ptr).hint }) == 0u16 && hint != 0u16 {
                unsafe {
                    (*fn_ptr).hint = hint;
                }
            }
            if emit_thunk {
                unsafe {
                    (*fn_ptr).emit_thunk = true;
                }
            }
            return fn_ptr;
        }
        i = i + 1;
    }

    let cap_funcs = unsafe { (*dll).cap_funcs };
    if num_funcs == cap_funcs {
        let new_cap = if cap_funcs == 0 { 16 } else { cap_funcs + cap_funcs };
        let new_bytes = coff_mul_usize(new_cap, size_of<ImportFunc>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<ImportFunc>()) as *mut ImportFunc };
        let old_funcs = unsafe { (*dll).funcs };
        if num_funcs > 0 && (old_funcs as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    old_funcs as *const u8,
                    new_arr as *mut u8,
                    coff_mul_usize(num_funcs, size_of<ImportFunc>())
                );
                heap_free(
                    old_funcs as *mut u8,
                    coff_mul_usize(cap_funcs, size_of<ImportFunc>()),
                    align_of<ImportFunc>()
                );
            }
        }
        unsafe {
            (*dll).funcs = new_arr;
            (*dll).cap_funcs = new_cap;
        }
    }

    let dup_name = linker_dup_cstr(mut_view(*ctx), func_name);
    let dup_full = if (full_sym as usize) != 0 {
        linker_dup_cstr(mut_view(*ctx), full_sym)
    } else {
        0 as *const u8
    };

    let slot = unsafe { import_func_slot_ptr((*dll).funcs, num_funcs) };
    unsafe {
        *slot = ImportFunc {
            name: dup_name,
            full_sym: dup_full,
            hint: hint,
            emit_thunk: emit_thunk,
            hint_offset: 0u32,
            iat_offset: 0u32,
            thunk_offset: 0u32,
        };
        (*dll).num_funcs = num_funcs + 1;
    }
    slot
}

pub fn import_add_func(ctx: mut_view<LinkerContext>, dll: *mut ImportDll, func_name: *const u8, full_sym: *const u8) -> *mut ImportFunc {
    import_add_func_ex(ctx, dll, func_name, full_sym, 0u16, true)
}

pub fn import_has_func(tbl: view<ImportTable>, func_name: *const u8) -> bool {
    if func_name as usize == 0 {
        return false;
    }
    let f0 = unsafe { *func_name };
    let mut d: usize = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(tbl, d);
        let n = unsafe { (*dll).num_funcs };
        let mut i: usize = 0;
        while i < n {
            let fn_ptr = import_func_at(dll as *const ImportDll, i);
            let existing = unsafe { (*fn_ptr).name };
            if (unsafe { *existing }) == f0 && cstr_eq(existing, func_name) {
                return true;
            }
            i = i + 1;
        }
        d = d + 1;
    }
    false
}

pub fn import_add_func_str(ctx: mut_view<LinkerContext>, dll: *mut ImportDll, func_name: Str) -> *mut ImportFunc {
    let mut tmp = pe_str_to_cstr_buf(func_name);
    let res = import_add_func(ctx, dll, tmp.ptr as *const u8, 0 as *const u8);
    coff_buf_free(mut_view(tmp));
    res
}

// 1. Adds the 6 base KERNEL32.dll imports required by the runtime startup/print/panic stubs.
pub fn import_add_base_kernel32(tbl: mut_view<ImportTable>, ctx: mut_view<LinkerContext>) {
    let k32 = import_find_or_add_dll_str(mut_view(*tbl), mut_view(*ctx), { "KERNEL32.dll" });
    let _ = import_add_func_str(mut_view(*ctx), k32, { "ExitProcess" });
    let _ = import_add_func_str(mut_view(*ctx), k32, { "GetStdHandle" });
    let _ = import_add_func_str(mut_view(*ctx), k32, { "WriteFile" });
    let _ = import_add_func_str(mut_view(*ctx), k32, { "SetConsoleOutputCP" });
    let _ = import_add_func_str(mut_view(*ctx), k32, { "GetConsoleMode" });
    let _ = import_add_func_str(mut_view(*ctx), k32, { "GetConsoleOutputCP" });
}

pub fn has_iat_prefix_cstr(s: *const u8) -> bool {
    let slen = cstr_len(s);
    if slen < 6 {
        return false;
    }
    let b0 = unsafe { *s };
    let b1 = unsafe { *(s + 1) };
    let b2 = unsafe { *(s + 2) };
    let b3 = unsafe { *(s + 3) };
    let b4 = unsafe { *(s + 4) };
    let b5 = unsafe { *(s + 5) };
    b0 == 95u8 && b1 == 95u8 && b2 == 73u8 && b3 == 65u8 && b4 == 84u8 && b5 == 95u8
}

pub fn has_imp_prefix_cstr(s: *const u8) -> bool {
    let slen = cstr_len(s);
    if slen < 6 {
        return false;
    }
    let b0 = unsafe { *s };
    let b1 = unsafe { *(s + 1) };
    let b2 = unsafe { *(s + 2) };
    let b3 = unsafe { *(s + 3) };
    let b4 = unsafe { *(s + 4) };
    let b5 = unsafe { *(s + 5) };
    b0 == 95u8 && b1 == 95u8 && b2 == 105u8 && b3 == 109u8 && b4 == 112u8 && b5 == 95u8
}

fn is_known_kernel32_sym(s: *const u8) -> bool {
    cstr_eq_str(s, { "CloseHandle" }) ||
    cstr_eq_str(s, { "CreateDirectoryW" }) ||
    cstr_eq_str(s, { "CreateFileW" }) ||
    cstr_eq_str(s, { "DeleteFileA" }) ||
    cstr_eq_str(s, { "DeleteFileW" }) ||
    cstr_eq_str(s, { "ExitProcess" }) ||
    cstr_eq_str(s, { "FindClose" }) ||
    cstr_eq_str(s, { "FindFirstFileW" }) ||
    cstr_eq_str(s, { "FindNextFileW" }) ||
    cstr_eq_str(s, { "FlushFileBuffers" }) ||
    cstr_eq_str(s, { "FreeLibrary" }) ||
    cstr_eq_str(s, { "GetCommandLineW" }) ||
    cstr_eq_str(s, { "GetConsoleMode" }) ||
    cstr_eq_str(s, { "GetConsoleOutputCP" }) ||
    cstr_eq_str(s, { "GetCurrentProcessId" }) ||
    cstr_eq_str(s, { "GetEnvironmentVariableW" }) ||
    cstr_eq_str(s, { "GetFileAttributesExW" }) ||
    cstr_eq_str(s, { "GetFileSizeEx" }) ||
    cstr_eq_str(s, { "GetLastError" }) ||
    cstr_eq_str(s, { "GetModuleFileNameW" }) ||
    cstr_eq_str(s, { "GetProcAddress" }) ||
    cstr_eq_str(s, { "GetProcessHeap" }) ||
    cstr_eq_str(s, { "GetStdHandle" }) ||
    cstr_eq_str(s, { "GetSystemTime" }) ||
    cstr_eq_str(s, { "GetTickCount64" }) ||
    cstr_eq_str(s, { "HeapAlloc" }) ||
    cstr_eq_str(s, { "HeapFree" }) ||
    cstr_eq_str(s, { "HeapReAlloc" }) ||
    cstr_eq_str(s, { "LoadLibraryA" }) ||
    cstr_eq_str(s, { "LoadLibraryW" }) ||
    cstr_eq_str(s, { "LocalFree" }) ||
    cstr_eq_str(s, { "QueryPerformanceCounter" }) ||
    cstr_eq_str(s, { "QueryPerformanceFrequency" }) ||
    cstr_eq_str(s, { "ReadFile" }) ||
    cstr_eq_str(s, { "RemoveDirectoryW" }) ||
    cstr_eq_str(s, { "SetConsoleOutputCP" }) ||
    cstr_eq_str(s, { "SetEnvironmentVariableW" }) ||
    cstr_eq_str(s, { "SetFilePointer" }) ||
    cstr_eq_str(s, { "SetFilePointerEx" }) ||
    cstr_eq_str(s, { "Sleep" }) ||
    cstr_eq_str(s, { "VirtualAlloc" }) ||
    cstr_eq_str(s, { "VirtualFree" }) ||
    cstr_eq_str(s, { "WriteConsoleW" }) ||
    cstr_eq_str(s, { "WriteFile" })
}

fn is_known_shell32_sym(s: *const u8) -> bool {
    cstr_eq_str(s, { "CommandLineToArgvW" })
}

// 2. Discovers DLL imports (`DLL$func`, `__IAT_func`, or `__imp_DLL$func`) from unresolved relocations.
pub fn import_discover_from_relocs(tbl: mut_view<ImportTable>, ctx: mut_view<LinkerContext>) {
    let num_relocs = ctx.num_relocs;
    let mut i: usize = 0;
    while i < num_relocs {
        let rel = linker_reloc_at(view(*ctx), i);
        let sname = unsafe { (*rel).sym_name };
        if (sname as usize) != 0 && (unsafe { *sname }) != 0u8 {
            let existing = linker_find_global(view(*ctx), sname);
            let is_defined = if (existing as usize) != 0 {
                unsafe { (*existing).defined }
            } else {
                false
            };

            if !is_defined {
                let starts_iat = has_iat_prefix_cstr(sname);
                let starts_imp = has_imp_prefix_cstr(sname);
                let target = if starts_iat || starts_imp {
                    unsafe { sname + 6 }
                } else {
                    sname
                };

                let dollar_idx = pe_cstr_find_char(target, 36u8); // '$'
                if dollar_idx >= 0 {
                    let dlen = dollar_idx as usize;
                    let fname = unsafe { target + dlen + 1 };
                    let dll = import_find_or_add_dll_bytes(mut_view(*tbl), mut_view(*ctx), target, dlen);
                    let _ = import_add_func(mut_view(*ctx), dll, fname, target);
                } else if starts_iat {
                    if !import_has_func(view(*tbl), target) {
                        let dll = import_find_or_add_dll_str(mut_view(*tbl), mut_view(*ctx), { "KERNEL32.dll" });
                        let _ = import_add_func(mut_view(*ctx), dll, target, 0 as *const u8);
                    }
                } else if starts_imp {
                    if !import_has_func(view(*tbl), target) {
                        if is_known_kernel32_sym(target) {
                            let dll = import_find_or_add_dll_str(mut_view(*tbl), mut_view(*ctx), { "KERNEL32.dll" });
                            let _ = import_add_func_ex(mut_view(*ctx), dll, target, 0 as *const u8, 0u16, false);
                        } else if is_known_shell32_sym(target) {
                            let dll = import_find_or_add_dll_str(mut_view(*tbl), mut_view(*ctx), { "SHELL32.dll" });
                            let _ = import_add_func_ex(mut_view(*ctx), dll, target, 0 as *const u8, 0u16, false);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

pub fn make_iat_sym_cstr(ctx: mut_view<LinkerContext>, suffix: *const u8) -> *const u8 {
    let slen = cstr_len(suffix);
    let prefix: [6]u8 = [95u8, 95u8, 73u8, 65u8, 84u8, 95u8]; // "__IAT_"
    let p_prefix = unsafe { address_of(prefix[0]) };
    let mut tmp = coff_buf_with_capacity(6 + slen + 1);
    coff_buf_put_bytes(mut_view(tmp), p_prefix, 6);
    coff_buf_put_bytes(mut_view(tmp), suffix, slen);
    coff_buf_put_u8(mut_view(tmp), 0u8);
    let res = linker_dup_bytes(ctx, tmp.ptr as *const u8, 6 + slen);
    coff_buf_free(mut_view(tmp));
    res
}

pub fn make_imp_sym_cstr(ctx: mut_view<LinkerContext>, suffix: *const u8) -> *const u8 {
    let slen = cstr_len(suffix);
    let prefix: [6]u8 = [95u8, 95u8, 105u8, 109u8, 112u8, 95u8]; // "__imp_"
    let p_prefix = unsafe { address_of(prefix[0]) };
    let mut tmp = coff_buf_with_capacity(6 + slen + 1);
    coff_buf_put_bytes(mut_view(tmp), p_prefix, 6);
    coff_buf_put_bytes(mut_view(tmp), suffix, slen);
    coff_buf_put_u8(mut_view(tmp), 0u8);
    let res = linker_dup_bytes(ctx, tmp.ptr as *const u8, 6 + slen);
    coff_buf_free(mut_view(tmp));
    res
}

// 3. Emits 6-byte `jmp [rip + disp32]` thunks (`FF 25 00 00 00 00`) into `.text` for each imported function.
pub fn import_emit_thunks(tbl: view<ImportTable>, ctx: mut_view<LinkerContext>, text_sec: *mut MergedSection) {
    let thunk_bytes: [6]u8 = [0xFFu8, 0x25u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8];
    let mut d: usize = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(tbl, d);
        let num_funcs = unsafe { (*dll).num_funcs };
        let mut f: usize = 0;
        while f < num_funcs {
            let fn_ptr = import_func_at(dll as *const ImportDll, f);
            if unsafe { (*fn_ptr).emit_thunk } {
                let fn_name = unsafe { (*fn_ptr).name };
                let fn_full = unsafe { (*fn_ptr).full_sym };

                let iat_sym_name = make_iat_sym_cstr(mut_view(*ctx), fn_name);
                let thunk_off = linker_append_section_slice(text_sec, view(thunk_bytes), 8u32);
                unsafe {
                    (*fn_ptr).thunk_offset = thunk_off;
                }

                linker_add_reloc(mut_view(*ctx), text_sec, thunk_off + 2u32, IMAGE_REL_AMD64_REL32, iat_sym_name, 0i64);

                let g_fn = linker_add_global(mut_view(*ctx), fn_name);
                if !(unsafe { (*g_fn).defined }) {
                    unsafe {
                        (*g_fn).defined = true;
                        (*g_fn).sec = text_sec;
                        (*g_fn).offset = thunk_off;
                    }
                }

                if (fn_full as usize) != 0 {
                    let g_full = linker_add_global(mut_view(*ctx), fn_full);
                    if !(unsafe { (*g_full).defined }) {
                        unsafe {
                            (*g_full).defined = true;
                            (*g_full).sec = text_sec;
                            (*g_full).offset = thunk_off;
                        }
                    }
                }
            }
            f = f + 1;
        }
        d = d + 1;
    }
}

// 4 & 5. Builds the `.idata` section buffer (Descriptors, ILTs, IATs, Hint/Names, DLL Names)
// and defines `__IAT_*` global symbols. Returns `idata_sec`.
pub fn import_build_idata_section(tbl: mut_view<ImportTable>, ctx: mut_view<LinkerContext>) -> *mut MergedSection {
    let idata_chars = IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    let idata_sec = linker_get_or_create_section_str(mut_view(*ctx), { ".idata" }, idata_chars);

    let mut i_off: u32 = 0u32;

    // 4a. Descriptors
    tbl.desc_offset = i_off;
    let mut d: usize = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(view(*tbl), d);
        unsafe {
            (*dll).desc_offset = i_off;
        }
        i_off = i_off + (PE_IMPORT_DESCRIPTOR_SIZE as u32);
        d = d + 1;
    }
    // Null-terminating descriptor
    i_off = i_off + (PE_IMPORT_DESCRIPTOR_SIZE as u32);

    // 4b. ILTs (Import Lookup Tables)
    d = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(view(*tbl), d);
        let num_funcs = unsafe { (*dll).num_funcs };
        unsafe {
            (*dll).ilt_offset = i_off;
        }
        i_off = i_off + coff_mul_u32((num_funcs + 1) as u32, 8u32);
        d = d + 1;
    }

    // 4c. IATs (Import Address Tables, contiguous)
    tbl.all_iats_start = i_off;
    d = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(view(*tbl), d);
        let num_funcs = unsafe { (*dll).num_funcs };
        unsafe {
            (*dll).iat_offset = i_off;
        }
        let mut f: usize = 0;
        while f < num_funcs {
            let fn_ptr = import_func_at(dll as *const ImportDll, f);
            unsafe {
                (*fn_ptr).iat_offset = i_off + coff_mul_u32(f as u32, 8u32);
            }
            f = f + 1;
        }
        i_off = i_off + coff_mul_u32((num_funcs + 1) as u32, 8u32);
        d = d + 1;
    }
    tbl.all_iats_size = i_off - tbl.all_iats_start;

    // Allocate a growable buffer initialized with zeroes up to `i_off`
    let mut idata_buf = coff_buf_with_capacity((i_off as usize) + 512);
    pe_buf_put_zeroes(mut_view(idata_buf), i_off as usize);

    // 4d. Hint/Names (2-byte Hint = 0 + NUL-terminated ASCII function name + even-byte pad)
    d = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(view(*tbl), d);
        let num_funcs = unsafe { (*dll).num_funcs };
        let mut f: usize = 0;
        while f < num_funcs {
            let fn_ptr = import_func_at(dll as *const ImportDll, f);
            unsafe {
                (*fn_ptr).hint_offset = idata_buf.len as u32;
            }
            let fn_hint = unsafe { (*fn_ptr).hint };
            coff_buf_put_u8(mut_view(idata_buf), (fn_hint & 0xFFu16) as u8);
            coff_buf_put_u8(mut_view(idata_buf), ((fn_hint >> 8) & 0xFFu16) as u8);
            let fn_name = unsafe { (*fn_ptr).name };
            let nlen = cstr_len(fn_name);
            coff_buf_put_bytes(mut_view(idata_buf), fn_name, nlen);
            coff_buf_put_u8(mut_view(idata_buf), 0u8);
            if (idata_buf.len & 1) != 0 {
                coff_buf_put_u8(mut_view(idata_buf), 0u8);
            }
            f = f + 1;
        }
        d = d + 1;
    }

    // 4e. DLL Names (NUL-terminated ASCII DLL name + even-byte pad)
    d = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(view(*tbl), d);
        unsafe {
            (*dll).dll_name_offset = idata_buf.len as u32;
        }
        let dname = unsafe { (*dll).dll_name };
        let nlen = cstr_len(dname);
        coff_buf_put_bytes(mut_view(idata_buf), dname, nlen);
        coff_buf_put_u8(mut_view(idata_buf), 0u8);
        if (idata_buf.len & 1) != 0 {
            coff_buf_put_u8(mut_view(idata_buf), 0u8);
        }
        d = d + 1;
    }

    let aligned_len = pe_align_up_u32(idata_buf.len as u32, 8u32);
    if (idata_buf.len as u32) < aligned_len {
        pe_buf_put_zeroes(mut_view(idata_buf), (aligned_len - (idata_buf.len as u32)) as usize);
    }

    let mut idata_base_out: [1]u32 = [0u32];
    let pidata_base = unsafe { address_of(idata_base_out[0]) as *mut u32 };
    linker_append_section_data(idata_sec, idata_buf.ptr as *const u8, aligned_len, 8u32, pidata_base);
    tbl.idata_base = idata_base_out[0];
    coff_buf_free(mut_view(idata_buf));

    // 5. Define `__IAT_*` global symbols
    d = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(view(*tbl), d);
        let num_funcs = unsafe { (*dll).num_funcs };
        let mut f: usize = 0;
        while f < num_funcs {
            let fn_ptr = import_func_at(dll as *const ImportDll, f);
            let fn_name = unsafe { (*fn_ptr).name };
            let fn_full = unsafe { (*fn_ptr).full_sym };
            let fn_iat_off = unsafe { (*fn_ptr).iat_offset };

            let iat_sym = make_iat_sym_cstr(mut_view(*ctx), fn_name);
            let g = linker_add_global(mut_view(*ctx), iat_sym);
            unsafe {
                (*g).defined = true;
                (*g).sec = idata_sec;
                (*g).offset = tbl.idata_base + fn_iat_off;
            }

            let imp_sym = make_imp_sym_cstr(mut_view(*ctx), fn_name);
            let g_imp = linker_add_global(mut_view(*ctx), imp_sym);
            unsafe {
                (*g_imp).defined = true;
                (*g_imp).sec = idata_sec;
                (*g_imp).offset = tbl.idata_base + fn_iat_off;
            }

            if (fn_full as usize) != 0 {
                let iat_full = make_iat_sym_cstr(mut_view(*ctx), fn_full);
                let g2 = linker_add_global(mut_view(*ctx), iat_full);
                unsafe {
                    (*g2).defined = true;
                    (*g2).sec = idata_sec;
                    (*g2).offset = tbl.idata_base + fn_iat_off;
                }

                let imp_full = make_imp_sym_cstr(mut_view(*ctx), fn_full);
                let g2_imp = linker_add_global(mut_view(*ctx), imp_full);
                unsafe {
                    (*g2_imp).defined = true;
                    (*g2_imp).sec = idata_sec;
                    (*g2_imp).offset = tbl.idata_base + fn_iat_off;
                }
            }
            f = f + 1;
        }
        d = d + 1;
    }

    idata_sec
}

// 7. Patches `.idata` descriptors, ILTs, and IATs with computed section RVAs.
pub fn import_patch_idata_rvas(tbl: view<ImportTable>, idata_sec: *mut MergedSection) {
    if (idata_sec as usize) == 0 {
        return;
    }
    let sec_rva = unsafe { (*idata_sec).rva };
    let sec_data = unsafe { (*idata_sec).data };
    let idata_rva: u32 = sec_rva + tbl.idata_base;
    let base_off: usize = tbl.idata_base as usize;

    let mut d: usize = 0;
    while d < tbl.num_dlls {
        let dll = import_dll_at(tbl, d);
        let desc_off = (unsafe { (*dll).desc_offset }) as usize;
        let ilt_off = unsafe { (*dll).ilt_offset };
        let iat_off = unsafe { (*dll).iat_offset };
        let dll_name_off = unsafe { (*dll).dll_name_offset };
        let num_funcs = unsafe { (*dll).num_funcs };

        // Patch IMAGE_IMPORT_DESCRIPTOR (OriginalFirstThunk at +0, Name at +12, FirstThunk at +16)
        coff_write_u32_le(sec_data, base_off + desc_off + 0, idata_rva + ilt_off);
        coff_write_u32_le(sec_data, base_off + desc_off + 12, idata_rva + dll_name_off);
        coff_write_u32_le(sec_data, base_off + desc_off + 16, idata_rva + iat_off);

        let mut f: usize = 0;
        while f < num_funcs {
            let fn_ptr = import_func_at(dll as *const ImportDll, f);
            let hint_off = unsafe { (*fn_ptr).hint_offset };
            let hint_rva: u64 = (idata_rva + hint_off) as u64;
            let entry_disp: usize = coff_mul_usize(f, 8);
            coff_write_u64_le(sec_data, base_off + (ilt_off as usize) + entry_disp, hint_rva);
            coff_write_u64_le(sec_data, base_off + (iat_off as usize) + entry_disp, hint_rva);
            f = f + 1;
        }
        d = d + 1;
    }
}
