    0xCBu8, 0xB9u8, 0xF4u8, 0xFFu8, 0xFFu8, 0xFFu8, 0x48u8, 0x89u8,
    0xD6u8, 0xFFu8, 0x15u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x4Cu8,
    0x8Du8, 0x4Cu8, 0x24u8, 0x38u8, 0x49u8, 0x89u8, 0xF0u8, 0x48u8,
    0x89u8, 0xDAu8, 0x48u8, 0xC7u8, 0x44u8, 0x24u8, 0x20u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x48u8, 0x89u8, 0xC1u8, 0xFFu8, 0x15u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0xB9u8, 0x65u8, 0x00u8, 0x00u8,
    0x00u8, 0xFFu8, 0x15u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0xCCu8,
];

