@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// --- Runtime Startup & Host Stub Machine Code Tables (.rdata consts) ---

// 86-byte entry point stub (`axiom_start`): configures console UTF-8 codepage if stdout is a console,
// invokes `main`, restores console codepage, and calls `ExitProcess(exit_code)`.
pub const AXIOM_START_CODE: [86]u8 = [
    0x53u8, 0x55u8, 0x48u8, 0x83u8, 0xECu8, 0x38u8, 0x31u8, 0xEDu8,
    0x48u8, 0xC7u8, 0xC1u8, 0xF5u8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0x15u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x48u8, 0x89u8, 0xC1u8,
    0x48u8, 0x8Du8, 0x54u8, 0x24u8, 0x30u8, 0xFFu8, 0x15u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x85u8, 0xC0u8, 0x74u8, 0x0Du8, 0xFFu8,
    0x15u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x89u8, 0xC5u8, 0xB9u8,
    0xE9u8, 0xFDu8, 0x00u8, 0x00u8, 0xFFu8, 0x15u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0xE8u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x89u8,
    0xC3u8, 0x85u8, 0xEDu8, 0x74u8, 0x08u8, 0x89u8, 0xE9u8, 0xFFu8,
    0x15u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x89u8, 0xD9u8, 0xFFu8,
    0x15u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0xCCu8,
];

// 64-byte panic handler stub (`axiom_panic`): writes panic message to STD_ERROR_HANDLE (-12)
