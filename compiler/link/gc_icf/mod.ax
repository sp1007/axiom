// Linker Section Garbage Collection (COMDAT/Dead-Stripping), Safe Identical Code Folding (ICF),
// Read-Only Constant/String Pooling, `.bss` Zero-Data Placement, and 3D Binary Size Accounting (T622 / E15.6).
// Implements SPEC-04 AXS-EXT-071 and SPEC-75 §§3, 5, 6, 7 (AXS-LTO-020..025, AXS-LTO-030, AXS-PGO-015;
// REQ-OPT-259..260, REQ-OPT-262..264, REQ-OPT-267, REQ-OPT-269, REQ-OPT-283..291, REQ-OPT-381..382):
//   - Per-symbol function/data sections (`.text$sym`, `.rdata$sym`, `.data$sym`, `.bss$sym`, `.pdata$sym`, `.xdata$sym`)
//     with COMDAT selection (`NODUPLICATES`, `ANY`, `EXACT_MATCH`, `ASSOC`) (`SPEC-04 AXS-EXT-071`, `AXS-LTO-020`)
//   - Deterministic COMDAT group resolution independent of input/thread order (`link_resolve_comdats`) (`AXS-LTO-020.2..3`)
//   - Deterministic FIFO worklist mark-sweep section GC from formal linker roots (`Entry`, `Export`, `DynamicLookup`,
//     `FfiCallback`, `Reflection`, `PinnedAt`, `ModuleInit`) with `COMDAT_ASSOC` reverse-dependency retention
//     and dead code/data/unwind/import/runtime component stripping (`link_mark_sweep_gc`) (`AXS-LTO-021`, `AXS-LTO-024`)
//   - Safe Identical Code Folding (`link_run_safe_icf`) via coinductive partition-refinement equivalence with
//     function-pointer identity preservation (`fp1 != fp2`) and optional 5-byte `jmp rel32` thunks (`AXS-LTO-022`)
//   - Read-only `.rdata` constant/string merging and `.bss` zero-initialized data promotion (`link_optimize_readonly_and_bss`)
//     while never merging mutable `static mut`, `@at(addr)` MMIO, or `volatile`/`atomic` globals (`AXS-LTO-023`)
//   - Deterministic section layout ordering, 3D binary size model (`file_size_bytes`, `mapped_size_bytes`,
//     `working_set_bytes`), 128-bit optimization cache identity, and `--emit=section-gc` (`section_gc_print`) (`AXS-LTO-025`, `AXS-PGO-015`)
module compiler.link.gc_icf

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.StrId
use compiler.kernel.id.SymbolId
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_u32
use compiler.obj.coff.SectionId

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

// =============================================================================
// 1. Section Kinds, COMDAT Selection, Root Kinds, and ICF Decisions
// =============================================================================

