// Linker v2 Per-Item Section Subdivision, `IMAGE_SCN_LNK_COMDAT` Monomorphized Generic & Vtable
// Deduplication, Root-Set Reachability Section Garbage Collection (`--gc-sections`), Forward
// `.pdata`/`.xdata` Unwind Association, and Deterministic `inspect --emit=link-map` &
// `--emit=gc-sections` Reporting (T775 / E18.6).
// Implements `spec/SPEC-27-separate-compilation-linker-v2.md` §§2-4 (`AXS-LNK-010..025`,
// `AXS-LNK-050..053`, `INV-LNK-002`; `0099`, `0164`, `0217`, `tasks/0369`, `tasks/0409`,
// `tasks/0410`, `tasks/0526`, `tasks/0786`, `tasks/0802`, `tasks/0804`).
module compiler.link.gc

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_sv
use compiler.diag.format.diag_buf_push_u32

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

// =============================================================================
// 1. Per-Item Section Kinds, COFF Flags, COMDAT Selection, Roots & GC States
// =============================================================================

pub const LGC_SEC_TEXT: u8 = 0u8;
pub const LGC_SEC_RDATA: u8 = 1u8;
pub const LGC_SEC_DATA: u8 = 2u8;
pub const LGC_SEC_BSS: u8 = 3u8;
pub const LGC_SEC_PDATA: u8 = 4u8;
pub const LGC_SEC_XDATA: u8 = 5u8;
pub const LGC_SEC_TLS: u8 = 6u8;
pub const LGC_SEC_CUSTOM: u8 = 7u8;

pub const IMAGE_SCN_CNT_CODE: u32 = 0x00000020u32;
pub const IMAGE_SCN_CNT_INITIALIZED_DATA: u32 = 0x00000040u32;
pub const IMAGE_SCN_CNT_UNINITIALIZED_DATA: u32 = 0x00000080u32;
pub const IMAGE_SCN_LNK_COMDAT: u32 = 0x00001000u32;
pub const IMAGE_SCN_MEM_EXECUTE: u32 = 0x20000000u32;
pub const IMAGE_SCN_MEM_READ: u32 = 0x40000000u32;
pub const IMAGE_SCN_MEM_WRITE: u32 = 0x80000000u32;

// SPEC-27 AXS-LNK-010 & AXS-LNK-013: COFF COMDAT Selection Modes
pub const COMDAT_SELECT_NONE: u8 = 0u8;
pub const COMDAT_SELECT_NODUPLICATES: u8 = 1u8;
pub const COMDAT_SELECT_ANY: u8 = 2u8;
pub const COMDAT_SELECT_SAME_SIZE: u8 = 3u8;
pub const COMDAT_SELECT_EXACT_MATCH: u8 = 4u8;
pub const COMDAT_SELECT_ASSOCIATIVE: u8 = 5u8;
pub const COMDAT_SELECT_LARGEST: u8 = 6u8;

// SPEC-27 AXS-LNK-010 & AXS-LNK-012: Symbol Bindings
pub const LGC_BIND_LOCAL: u8 = 0u8;
pub const LGC_BIND_GLOBAL: u8 = 1u8;
pub const LGC_BIND_WEAK: u8 = 2u8;
pub const LGC_BIND_COMDAT: u8 = 3u8;
pub const LGC_BIND_COMMON: u8 = 4u8;
pub const LGC_BIND_ABSOLUTE: u8 = 5u8;
pub const LGC_BIND_IMPORT: u8 = 6u8;

// SPEC-27 AXS-LNK-021: Reachability Root Kinds (`R_root`)
pub const LGC_ROOT_NONE: u8 = 0u8;
pub const LGC_ROOT_ENTRY: u8 = 1u8;
pub const LGC_ROOT_EXPORT: u8 = 2u8;
pub const LGC_ROOT_USED: u8 = 3u8;
pub const LGC_ROOT_AT_PINNED: u8 = 4u8;
pub const LGC_ROOT_MODULE_INIT: u8 = 5u8;
pub const LGC_ROOT_REFLECTION: u8 = 6u8;

// SPEC-27 AXS-LNK-022 & AXS-LNK-050: Section Retention States
pub const LGC_STATE_DEAD_STRIPPED: u8 = 0u8;
pub const LGC_STATE_RETAINED_ROOT: u8 = 1u8;
pub const LGC_STATE_RETAINED_REF: u8 = 2u8;
pub const LGC_STATE_RETAINED_UNWIND: u8 = 3u8;
pub const LGC_STATE_FOLDED_COMDAT: u8 = 4u8;

// Relocation Kinds (COFF AMD64)
pub const LGC_RELOC_ADDR64: u16 = 1u16;
pub const LGC_RELOC_ADDR32NB: u16 = 3u16;
pub const LGC_RELOC_REL32: u16 = 4u16;
pub const LGC_RELOC_SECTION: u16 = 10u16;
pub const LGC_RELOC_SECREL: u16 = 11u16;

