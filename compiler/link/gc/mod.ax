pub const LGC_FILE_ALIGN: u32 = 0x200u32;

// =============================================================================
// 2. LinkGcGraph Data Model (`AXS-LNK-010`, `AXS-LNK-013`, `AXS-LNK-020..024`)
// =============================================================================

@derive(Copy)
pub struct LgcObjectInput {
    pub obj_id: u32,
    pub obj_name: StrView,
    pub archive_name: StrView,
    pub is_archive_member: bool,
    pub extracted: bool,
    pub content_hash: u64,
}

@derive(Copy)
pub struct LgcRelocEdge {
    pub from_sec_id: u32,
    pub offset: u32,
    pub reloc_kind: u16,
    pub target_sym: StrView,
    pub target_sym_hash: u64,
    pub target_sec_id: u32,
    pub addend: i64,
}

@derive(Copy)
pub struct LgcSection {
    pub sec_id: u32,
    pub obj_id: u32,
    pub sec_index_in_obj: u32,
    pub sec_name: StrView,
    pub sym_mangled: StrView,
    pub sym_demangled: StrView,
    pub sym_hash: u64,
    pub kind: u8,
    pub characteristics: u32,
    pub align: u32,
    pub binding: u8,
    pub comdat_selection: u8,
    pub assoc_leader_sec: u32,
    pub bytes_hash: u64,
    pub size_bytes: u32,
    pub root_kind: u8,
    pub is_export: bool,
    pub is_used: bool,
    pub has_pinned_vma: bool,
    pub pinned_vma: u64,
    pub state: u8,
    pub is_live: bool,
    pub is_folded_comdat: bool,
    pub selected_rep_sec: u32,
    pub retained_by_sec: u32,
    pub retained_by_sym: StrView,
    pub output_sec_idx: u32,
    pub output_rva: u32,
    pub output_file_off: u32,
    pub output_order: u32,
}

@derive(Copy)
pub struct LgcComdatGroup {
    pub key_sym: StrView,
    pub key_demangled: StrView,
    pub key_hash: u64,
    pub selection: u8,
    pub winner_sec_id: u32,
    pub winner_obj_id: u32,
    pub folded_copies: u32,
    pub folded_assoc_copies: u32,
}

@derive(Copy)
pub struct LgcOutputSection {
    pub kind: u8,
    pub name: StrView,
    pub characteristics: u32,
    pub align: u32,
    pub rva: u32,
    pub virtual_size: u32,
    pub file_offset: u32,
    pub raw_size: u32,
