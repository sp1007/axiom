pub const LGC_NONE_ID: u32 = 0xFFFFFFFFu32;
pub const LGC_PE_HEADERS_RVA: u32 = 0x1000u32;
pub const LGC_PE_HEADERS_FILE_OFF: u32 = 0x200u32;
