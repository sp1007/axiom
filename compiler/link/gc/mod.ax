fn lgc_push_tbl(out: mut_view<DiagBuffer>, off: usize, len: usize) {
    let mut i: usize = 0;
    while i < len {
        diag_buf_push_byte(mut_view(*out), LGC_STR_TABLE[off + i]);
        i = i + 1;
    }
}

pub fn lgc_push_output_sec_name(out: mut_view<DiagBuffer>, kind: u8) {
    if kind == LGC_SEC_TEXT { lgc_push_tbl(mut_view(*out), 0, 5); return; }
    if kind == LGC_SEC_RDATA { lgc_push_tbl(mut_view(*out), 5, 6); return; }
    if kind == LGC_SEC_DATA { lgc_push_tbl(mut_view(*out), 11, 5); return; }
    if kind == LGC_SEC_BSS { lgc_push_tbl(mut_view(*out), 16, 4); return; }
    if kind == LGC_SEC_PDATA { lgc_push_tbl(mut_view(*out), 20, 6); return; }
    if kind == LGC_SEC_XDATA { lgc_push_tbl(mut_view(*out), 26, 6); return; }
    if kind == LGC_SEC_TLS { lgc_push_tbl(mut_view(*out), 32, 4); return; }
    lgc_push_tbl(mut_view(*out), 36, 7);
}

pub fn lgc_push_root_kind(out: mut_view<DiagBuffer>, rk: u8) {
    if rk == LGC_ROOT_ENTRY { lgc_push_tbl(mut_view(*out), 199, 5); return; }
    if rk == LGC_ROOT_EXPORT { lgc_push_tbl(mut_view(*out), 204, 6); return; }
    if rk == LGC_ROOT_USED { lgc_push_tbl(mut_view(*out), 210, 4); return; }
    if rk == LGC_ROOT_AT_PINNED { lgc_push_tbl(mut_view(*out), 214, 9); return; }
    if rk == LGC_ROOT_MODULE_INIT { lgc_push_tbl(mut_view(*out), 223, 11); return; }
    if rk == LGC_ROOT_REFLECTION { lgc_push_tbl(mut_view(*out), 234, 10); return; }
    lgc_push_tbl(mut_view(*out), 199, 5);
}

pub fn lgc_push_comdat_sel(out: mut_view<DiagBuffer>, sel: u8) {
    if sel == COMDAT_SELECT_ANY { lgc_push_tbl(mut_view(*out), 524, 3); return; }
    if sel == COMDAT_SELECT_EXACT_MATCH { lgc_push_tbl(mut_view(*out), 527, 11); return; }
    if sel == COMDAT_SELECT_SAME_SIZE { lgc_push_tbl(mut_view(*out), 538, 9); return; }
    if sel == COMDAT_SELECT_LARGEST { lgc_push_tbl(mut_view(*out), 547, 7); return; }
    if sel == COMDAT_SELECT_ASSOCIATIVE { lgc_push_tbl(mut_view(*out), 554, 11); return; }
    if sel == COMDAT_SELECT_NODUPLICATES { lgc_push_tbl(mut_view(*out), 565, 12); return; }
    lgc_push_tbl(mut_view(*out), 524, 3);
}

// SPEC-27 AXS-LNK-024: Deterministic output section merging & RVA/FileOffset layout.
// Canonical PE/COFF section order: `.text`, `.rdata`, `.data`, `.bss`, `.pdata`, `.xdata`, `.tls`, `.custom`.
pub fn lgc_layout_output_sections(g: mut_view<LinkGcGraph>) -> bool {
    g.out_sec_count = 0;
    let mut cur_rva: u32 = LGC_PE_HEADERS_RVA;
    let mut cur_foff: u32 = LGC_PE_HEADERS_FILE_OFF;

    let mut kind: u8 = 0u8;
    while kind <= LGC_SEC_CUSTOM {
        let mut count_in_kind: u32 = 0u32;
        let mut max_align: u32 = 4u32;
        let mut cur_off_in_sec: u32 = 0u32;
        let out_idx: u32 = g.out_sec_count as u32;

        let mut i: usize = 0;
        while i < g.sec_count {
            let s = unsafe { lgc_sec_at(g.secs, i) };
            let s_live = unsafe { (*s).is_live };
            let s_kind = unsafe { (*s).kind };
            if s_live && s_kind == kind {
                let s_align = unsafe { (*s).align };
                let s_sz = unsafe { (*s).size_bytes };
                if s_align > max_align {
                    max_align = s_align;
                }
                cur_off_in_sec = lgc_align_up_u32(cur_off_in_sec, s_align);
                unsafe {
                    (*s).output_sec_idx = out_idx;
                    (*s).output_rva = cur_rva + cur_off_in_sec;
                    (*s).output_file_off = if kind == LGC_SEC_BSS { 0u32 } else { cur_foff + cur_off_in_sec };
                    (*s).output_order = count_in_kind;
                }
                cur_off_in_sec = cur_off_in_sec + s_sz;
                count_in_kind = count_in_kind + 1u32;
            }
            i = i + 1;
        }

        if count_in_kind > 0u32 {
            let vsize: u32 = cur_off_in_sec;
            let rsize: u32 = if kind == LGC_SEC_BSS {
                0u32
            } else {
                lgc_align_up_u32(vsize, LGC_FILE_ALIGN)
            };
            let osec_foff: u32 = if kind == LGC_SEC_BSS { 0u32 } else { cur_foff };
            let pad_b: u8 = if kind == LGC_SEC_TEXT { 0xCCu8 } else { 0x00u8 };
            let chars: u32 = lgc_section_characteristics(kind, false);
            unsafe {
                let os = lgc_out_sec_at(g.out_secs, g.out_sec_count);
                (*os).kind = kind;
                (*os).name = lgc_sv_empty();
                (*os).characteristics = chars;
                (*os).align = max_align;
                (*os).rva = cur_rva;
                (*os).virtual_size = vsize;
                (*os).file_offset = osec_foff;
                (*os).raw_size = rsize;
                (*os).input_sec_count = count_in_kind;
                (*os).pad_byte = pad_b;
            }
            g.out_sec_count = g.out_sec_count + 1;
            cur_rva = cur_rva + lgc_align_up_u32(vsize, LGC_SECTION_ALIGN);
            cur_foff = cur_foff + rsize;
        }
        kind = kind + 1u8;
    }

    g.stats.output_section_count = g.out_sec_count as u32;
    g.stats.image_size_bytes = cur_rva;
    g.stats.file_size_bytes = cur_foff;
    true
}

// Runs the complete Linker v2 COMDAT folding + root-set mark-sweep GC + output layout pipeline.
pub fn lgc_run_pipeline(
    g: mut_view<LinkGcGraph>,
    arena: mut_view<Arena>
) -> bool {
    if !lgc_resolve_symbols_and_comdats(mut_view(*g), mut_view(*arena)) {
        return false;
    }
    if !lgc_mark_sweep_sections(mut_view(*g), mut_view(*arena)) {
        return false;
    }
    lgc_layout_output_sections(mut_view(*g))
}

// =============================================================================
// 8. Deterministic `inspect --emit=gc-sections` & `--emit=link-map` Formatting
// =============================================================================

fn lgc_push_hex_u32(out: mut_view<DiagBuffer>, val: u32) {
    let mut shift: u32 = 16u32;
    while shift > 0u32 {
        shift = shift - 4u32;
        let nib: u8 = ((val >> shift) & 0xFu32) as u8;
        let ch: u8 = if nib < 10u8 { 48u8 + nib } else { 87u8 + nib };
        diag_buf_push_byte(mut_view(*out), ch);
    }
}

// SPEC-27 AXS-LNK-050.2: Deterministic `inspect --emit=gc-sections` report.
pub fn lgc_emit_gc_sections_report(g: view<LinkGcGraph>, out: mut_view<DiagBuffer>) {
    lgc_push_tbl(mut_view(*out), 43, 14); // "gc_sections {\n"

    let mut i: usize = 0;
    while i < g.sec_count {
        let s = unsafe { lgc_sec_at(g.secs, i) };
        let s_obj = unsafe { (*s).obj_id };
        if lgc_is_obj_active(g, s_obj) {
            let st = unsafe { (*s).state };
            let s_name = unsafe { (*s).sec_name };
            let s_dem = unsafe { (*s).sym_demangled };
            let s_sz = unsafe { (*s).size_bytes };
            let obj_name = lgc_obj_name_of(g, s_obj);

            if st == LGC_STATE_RETAINED_ROOT || st == LGC_STATE_RETAINED_REF || st == LGC_STATE_RETAINED_UNWIND {
                lgc_push_tbl(mut_view(*out), 57, 11); // "  retained "
                diag_buf_push_sv(mut_view(*out), s_name);
                lgc_push_tbl(mut_view(*out), 100, 5); // " obj="
                diag_buf_push_sv(mut_view(*out), obj_name);
                lgc_push_tbl(mut_view(*out), 105, 5); // " sym="
                diag_buf_push_sv(mut_view(*out), s_dem);
                lgc_push_tbl(mut_view(*out), 110, 6); // " size="
                diag_buf_push_u32(mut_view(*out), s_sz);
                if st == LGC_STATE_RETAINED_ROOT {
                    lgc_push_tbl(mut_view(*out), 116, 13); // " reason=Root("
                    let rk = unsafe { (*s).root_kind };
                    lgc_push_root_kind(mut_view(*out), rk);
                    diag_buf_push_byte(mut_view(*out), 41u8); // ')'
                } else if st == LGC_STATE_RETAINED_REF {
                    lgc_push_tbl(mut_view(*out), 129, 21); // " reason=ReferencedBy("
                    let p_id = unsafe { (*s).retained_by_sec };
                    if (p_id as usize) < g.sec_count {
                        let p_sec = unsafe { lgc_sec_at(g.secs, p_id as usize) };
                        diag_buf_push_sv(mut_view(*out), unsafe { (*p_sec).sec_name });
                    }
                    diag_buf_push_byte(mut_view(*out), 41u8); // ')'
                } else {
                    lgc_push_tbl(mut_view(*out), 150, 26); // " reason=AssociativeUnwind("
                    let p_id = unsafe { (*s).retained_by_sec };
                    if (p_id as usize) < g.sec_count {
                        let p_sec = unsafe { lgc_sec_at(g.secs, p_id as usize) };
                        diag_buf_push_sv(mut_view(*out), unsafe { (*p_sec).sec_name });
                    }
                    diag_buf_push_byte(mut_view(*out), 41u8); // ')'
                }
                diag_buf_push_byte(mut_view(*out), 10u8);
            } else if st == LGC_STATE_FOLDED_COMDAT {
                lgc_push_tbl(mut_view(*out), 68, 16); // "  folded_comdat "
                diag_buf_push_sv(mut_view(*out), s_name);
                lgc_push_tbl(mut_view(*out), 100, 5); // " obj="
                diag_buf_push_sv(mut_view(*out), obj_name);
                lgc_push_tbl(mut_view(*out), 110, 6); // " size="
                diag_buf_push_u32(mut_view(*out), s_sz);
                let rep_id = unsafe { (*s).selected_rep_sec };
                if (rep_id as usize) < g.sec_count {
                    let rep_sec = unsafe { lgc_sec_at(g.secs, rep_id as usize) };
                    lgc_push_tbl(mut_view(*out), 176, 9); // " rep_sec="
                    diag_buf_push_sv(mut_view(*out), unsafe { (*rep_sec).sec_name });
                    lgc_push_tbl(mut_view(*out), 185, 9); // " rep_obj="
                    diag_buf_push_sv(mut_view(*out), lgc_obj_name_of(g, unsafe { (*rep_sec).obj_id }));
                }
                lgc_push_tbl(mut_view(*out), 194, 5); // " sel="
                lgc_push_comdat_sel(mut_view(*out), unsafe { (*s).comdat_selection });
                diag_buf_push_byte(mut_view(*out), 10u8);
            } else {
                lgc_push_tbl(mut_view(*out), 84, 16); // "  dead_stripped "
                diag_buf_push_sv(mut_view(*out), s_name);
                lgc_push_tbl(mut_view(*out), 100, 5); // " obj="
                diag_buf_push_sv(mut_view(*out), obj_name);
                lgc_push_tbl(mut_view(*out), 105, 5); // " sym="
                diag_buf_push_sv(mut_view(*out), s_dem);
                lgc_push_tbl(mut_view(*out), 110, 6); // " size="
                diag_buf_push_u32(mut_view(*out), s_sz);
                diag_buf_push_byte(mut_view(*out), 10u8);
            }
        }
        i = i + 1;
    }

    let total_folded: u32 = g.stats.comdat_sections_folded + g.stats.comdat_assoc_folded;
    let total_active: u32 = g.stats.retained_sections + total_folded + g.stats.dead_stripped_sections;
    lgc_push_tbl(mut_view(*out), 244, 16); // "  summary total="
    diag_buf_push_u32(mut_view(*out), total_active);
    lgc_push_tbl(mut_view(*out), 260, 10); // " retained="
    diag_buf_push_u32(mut_view(*out), g.stats.retained_sections);
    lgc_push_tbl(mut_view(*out), 270, 15); // " folded_comdat="
    diag_buf_push_u32(mut_view(*out), total_folded);
    lgc_push_tbl(mut_view(*out), 285, 15); // " dead_stripped="
    diag_buf_push_u32(mut_view(*out), g.stats.dead_stripped_sections);
    lgc_push_tbl(mut_view(*out), 300, 16); // " retained_bytes="
    diag_buf_push_u32(mut_view(*out), g.stats.retained_bytes as u32);
    lgc_push_tbl(mut_view(*out), 316, 16); // " stripped_bytes="
    diag_buf_push_u32(mut_view(*out), g.stats.stripped_bytes as u32);
    diag_buf_push_byte(mut_view(*out), 10u8);
    lgc_push_tbl(mut_view(*out), 332, 2); // "}\n"
}

// SPEC-27 AXS-LNK-050.1: Deterministic `inspect --emit=link-map` report.
pub fn lgc_emit_link_map_report(g: view<LinkGcGraph>, out: mut_view<DiagBuffer>) {
    lgc_push_tbl(mut_view(*out), 334, 11); // "link_map {\n"

    // 1. Archive members and their demand-driven extraction status
    let mut o_idx: usize = 0;
    while o_idx < g.obj_count {
        let obj = unsafe { lgc_obj_at(g.objs, o_idx) };
        if unsafe { (*obj).is_archive_member } {
            lgc_push_tbl(mut_view(*out), 345, 17); // "  archive_member "
            diag_buf_push_sv(mut_view(*out), unsafe { (*obj).obj_name });
            lgc_push_tbl(mut_view(*out), 362, 9); // " archive="
            diag_buf_push_sv(mut_view(*out), unsafe { (*obj).archive_name });
            lgc_push_tbl(mut_view(*out), 371, 11); // " extracted="
            if unsafe { (*obj).extracted } {
                lgc_push_tbl(mut_view(*out), 515, 4); // "true"
            } else {
                lgc_push_tbl(mut_view(*out), 519, 5); // "false"
            }
            diag_buf_push_byte(mut_view(*out), 10u8);
        }
        o_idx = o_idx + 1;
    }

    // 2. COMDAT groups and selected winning representatives
    let mut c_idx: usize = 0;
    while c_idx < g.comdat_count {
        let cg = unsafe { lgc_comdat_at(g.comdat_groups, c_idx) };
        lgc_push_tbl(mut_view(*out), 382, 19); // "  comdat_group key="
        diag_buf_push_sv(mut_view(*out), unsafe { (*cg).key_sym });
        lgc_push_tbl(mut_view(*out), 194, 5); // " sel="
        lgc_push_comdat_sel(mut_view(*out), unsafe { (*cg).selection });
        lgc_push_tbl(mut_view(*out), 401, 12); // " winner_obj="
        diag_buf_push_sv(mut_view(*out), lgc_obj_name_of(g, unsafe { (*cg).winner_obj_id }));
        let w_sec_id = unsafe { (*cg).winner_sec_id };
        if (w_sec_id as usize) < g.sec_count {
            let w_sec = unsafe { lgc_sec_at(g.secs, w_sec_id as usize) };
            lgc_push_tbl(mut_view(*out), 413, 12); // " winner_sec="
            diag_buf_push_sv(mut_view(*out), unsafe { (*w_sec).sec_name });
        }
        lgc_push_tbl(mut_view(*out), 425, 15); // " folded_copies="
        diag_buf_push_u32(mut_view(*out), unsafe { (*cg).folded_copies });
        diag_buf_push_byte(mut_view(*out), 10u8);
        c_idx = c_idx + 1;
    }

    // 3. Output sections with RVA, VirtualSize, FileOffset, RawSize, and input count
    let mut os_idx: usize = 0;
    while os_idx < g.out_sec_count {
        let os = unsafe { lgc_out_sec_at(g.out_secs, os_idx) };
        lgc_push_tbl(mut_view(*out), 440, 17); // "  output_section "
        lgc_push_output_sec_name(mut_view(*out), unsafe { (*os).kind });
        lgc_push_tbl(mut_view(*out), 457, 7); // " rva=0x"
        lgc_push_hex_u32(mut_view(*out), unsafe { (*os).rva });
        lgc_push_tbl(mut_view(*out), 464, 7); // " vsize="
        diag_buf_push_u32(mut_view(*out), unsafe { (*os).virtual_size });
        lgc_push_tbl(mut_view(*out), 471, 12); // " file_off=0x"
        lgc_push_hex_u32(mut_view(*out), unsafe { (*os).file_offset });
        lgc_push_tbl(mut_view(*out), 483, 10); // " raw_size="
        diag_buf_push_u32(mut_view(*out), unsafe { (*os).raw_size });
        lgc_push_tbl(mut_view(*out), 493, 8); // " inputs="
        diag_buf_push_u32(mut_view(*out), unsafe { (*os).input_sec_count });
        diag_buf_push_byte(mut_view(*out), 10u8);
        os_idx = os_idx + 1;
    }

    // 4. Surviving global/COMDAT/entry symbols in output RVA order
    let mut s_idx: usize = 0;
    while s_idx < g.sec_count {
        let s = unsafe { lgc_sec_at(g.secs, s_idx) };
        let s_live = unsafe { (*s).is_live };
        let s_sym = unsafe { (*s).sym_mangled };
        if s_live && s_sym.len > 0 {
            lgc_push_tbl(mut_view(*out), 501, 9); // "  symbol "
            diag_buf_push_sv(mut_view(*out), unsafe { (*s).sym_demangled });
            lgc_push_tbl(mut_view(*out), 457, 7); // " rva=0x"
            lgc_push_hex_u32(mut_view(*out), unsafe { (*s).output_rva });
            lgc_push_tbl(mut_view(*out), 110, 6); // " size="
            diag_buf_push_u32(mut_view(*out), unsafe { (*s).size_bytes });
            lgc_push_tbl(mut_view(*out), 510, 5); // " sec="
            diag_buf_push_sv(mut_view(*out), unsafe { (*s).sec_name });
            lgc_push_tbl(mut_view(*out), 100, 5); // " obj="
            diag_buf_push_sv(mut_view(*out), lgc_obj_name_of(g, unsafe { (*s).obj_id }));
            diag_buf_push_byte(mut_view(*out), 10u8);
        }
        s_idx = s_idx + 1;
    }

    lgc_push_tbl(mut_view(*out), 332, 2); // "}\n"
}
