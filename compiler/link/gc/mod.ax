}

@derive(Copy)
pub struct LgcStats {
    pub total_objects: u32,
    pub extracted_archive_members: u32,
    pub skipped_archive_members: u32,
    pub total_input_sections: u32,
    pub comdat_groups_total: u32,
    pub comdat_sections_folded: u32,
    pub comdat_assoc_folded: u32,
    pub roots_seeded: u32,
    pub retained_sections: u32,
    pub retained_code_sections: u32,
    pub retained_data_sections: u32,
    pub retained_unwind_sections: u32,
    pub dead_stripped_sections: u32,
    pub dead_code_stripped: u32,
    pub dead_data_stripped: u32,
    pub dead_unwind_stripped: u32,
    pub retained_bytes: u64,
    pub stripped_bytes: u64,
    pub folded_comdat_bytes: u64,
    pub output_section_count: u32,
    pub image_size_bytes: u32,
    pub file_size_bytes: u32,
    pub diag_code: u32,
    pub diag_sym: StrView,
    pub diag_demangled: StrView,
    pub diag_first_obj: StrView,
    pub diag_second_obj: StrView,
}

pub struct LinkGcGraph {
    pub objs: *mut LgcObjectInput,
    pub obj_count: usize,
    pub obj_cap: usize,
    pub secs: *mut LgcSection,
    pub sec_count: usize,
    pub sec_cap: usize,
    pub relocs: *mut LgcRelocEdge,
    pub reloc_count: usize,
    pub reloc_cap: usize,
