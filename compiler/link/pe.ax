@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

// --- PE32+ Format Sizes & Constants ---

pub const PE_DOS_HEADER_SIZE: usize = 64;
pub const PE_DOS_LFANEW_OFFSET: usize = 0x3C;
pub const PE_SIGNATURE_SIZE: usize = 4;
pub const PE_OPTIONAL_HEADER64_BASE_SIZE: usize = 112;
pub const PE_DATA_DIRECTORY_SIZE: usize = 8;
pub const PE_DATA_DIRECTORY_COUNT: usize = 16;
pub const PE_OPTIONAL_HEADER64_TOTAL_SIZE: usize = 240;
pub const PE_IMPORT_DESCRIPTOR_SIZE: usize = 20;
pub const PE_EXPORT_DIRECTORY_SIZE: usize = 40;

pub const PE_MAGIC_PE32_PLUS: u16 = 0x020Bu16;

pub const PE_DEFAULT_IMAGE_BASE: u64 = 0x140000000u64;
pub const PE_DEFAULT_DLL_IMAGE_BASE: u64 = 0x180000000u64;
pub const PE_DEFAULT_SECTION_ALIGN: u32 = 0x1000u32;
pub const PE_DEFAULT_FILE_ALIGN: u32 = 0x200u32;
pub const PE_DEFAULT_STACK_RESERVE: u32 = 0x100000u32;
pub const PE_DEFAULT_STACK_COMMIT: u64 = 0x1000u64;
pub const PE_DEFAULT_HEAP_RESERVE: u64 = 0x100000u64;
pub const PE_DEFAULT_HEAP_COMMIT: u64 = 0x1000u64;

pub const IMAGE_FILE_EXECUTABLE_IMAGE: u16 = 0x0002u16;
pub const IMAGE_FILE_LARGE_ADDRESS_AWARE: u16 = 0x0020u16;
pub const IMAGE_FILE_DEBUG_STRIPPED: u16 = 0x0200u16;
pub const IMAGE_FILE_DLL: u16 = 0x2000u16;

pub const IMAGE_SUBSYSTEM_WINDOWS_CUI: u16 = 3u16;

pub const IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA: u16 = 0x0020u16;
pub const IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE: u16 = 0x0040u16;
pub const IMAGE_DLLCHARACTERISTICS_NX_COMPAT: u16 = 0x0100u16;
pub const IMAGE_DLLCHARACTERISTICS_TERMINAL_SERVER_AWARE: u16 = 0x8000u16;
pub const PE_DLL_DEFAULT_DLL_CHARS: u16 = 0x0160u16;

pub const IMAGE_REL_BASED_ABSOLUTE: u16 = 0u16;
pub const IMAGE_REL_BASED_DIR64: u16 = 10u16;

pub const IMAGE_REL_AMD64_REL32_1: u16 = 5u16;
pub const IMAGE_REL_AMD64_REL32_2: u16 = 6u16;
pub const IMAGE_REL_AMD64_REL32_3: u16 = 7u16;
pub const IMAGE_REL_AMD64_REL32_4: u16 = 8u16;
pub const IMAGE_REL_AMD64_REL32_5: u16 = 9u16;

pub const PE_DIR_EXPORT: usize = 0;
pub const PE_DIR_IMPORT: usize = 1;
pub const PE_DIR_RESOURCE: usize = 2;
pub const PE_DIR_EXCEPTION: usize = 3;
pub const PE_DIR_SECURITY: usize = 4;
pub const PE_DIR_BASERELOC: usize = 5;
pub const PE_DIR_DEBUG: usize = 6;
pub const PE_DIR_ARCHITECTURE: usize = 7;
pub const PE_DIR_GLOBALPTR: usize = 8;
pub const PE_DIR_TLS: usize = 9;
pub const PE_DIR_LOAD_CONFIG: usize = 10;
pub const PE_DIR_BOUND_IMPORT: usize = 11;
pub const PE_DIR_IAT: usize = 12;
pub const PE_DIR_DELAY_IMPORT: usize = 13;
pub const PE_DIR_COM_DESCRIPTOR: usize = 14;

pub const AX_LINK_BAD_ARCHIVE: u32 = 138u32;
pub const AX_LINK_LIBRARY_NOT_FOUND: u32 = 139u32;
pub const AX_LINK_DUPLICATE_EXPORT: u32 = 140u32;

// --- Alignment & Layout Helpers ---

pub fn pe_align_up_u32(val: u32, align: u32) -> u32 {
    if align <= 1u32 {
        return val;
    }
    let mask: u32 = align - 1u32;
    (val + mask) & (~mask)
}

pub fn pe_align_up_usize(val: usize, align: usize) -> usize {
    if align <= 1 {
        return val;
    }
    let mask: usize = align - 1;
    (val + mask) & (~mask)
}

pub fn pe_compute_headers_size(num_sections: usize, file_align: u32) -> u32 {
    let raw: u32 = 64u32 + 4u32 + 20u32 + 240u32 + coff_mul_u32(num_sections as u32, 40u32);
    pe_align_up_u32(raw, file_align)
}

pub fn pe_section_align_from_chars(chars: u32) -> u32 {
    let align_flag: u32 = (chars & IMAGE_SCN_ALIGN_MASK) >> 20u32;
    if align_flag > 0u32 && align_flag <= 16u32 {
        1u32 << (align_flag - 1u32)
    } else {
        1u32
    }
}

// --- ASCII & C-String Helpers ---

pub fn pe_ascii_tolower(ch: u8) -> u8 {
    if ch >= 65u8 && ch <= 90u8 {
        ch + 32u8
    } else {
        ch
    }
}

pub fn pe_bytes_ieq(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    if a_len == 0 {
        return true;
    }
    if a as usize == 0 || b as usize == 0 {
        return (a as usize) == (b as usize);
    }
    let mut i: usize = 0;
    while i < a_len {
        let ca = pe_ascii_tolower(unsafe { *(a + i) });
        let cb = pe_ascii_tolower(unsafe { *(b + i) });
        if ca != cb {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn pe_cstr_ieq(a: *const u8, b: *const u8) -> bool {
    pe_bytes_ieq(a, cstr_len(a), b, cstr_len(b))
}

pub fn pe_cstr_cmp(a: *const u8, b: *const u8) -> i32 {
    if a as usize == 0 && b as usize == 0 {
        return 0i32;
    }
    if a as usize == 0 {
        return -1i32;
    }
    if b as usize == 0 {
        return 1i32;
    }
    let mut i: usize = 0;
    loop {
        let ca = unsafe { *(a + i) };
        let cb = unsafe { *(b + i) };
        if ca != cb {
            return if ca < cb { -1i32 } else { 1i32 };
        }
        if ca == 0u8 {
            return 0i32;
        }
        i = i + 1;
    }
    0i32
}

pub fn pe_cstr_starts_with(s: *const u8, prefix: *const u8) -> bool {
    let slen = cstr_len(s);
    let plen = cstr_len(prefix);
    if plen > slen {
        return false;
    }
    bytes_eq(s, plen, prefix, plen)
}

pub fn pe_cstr_find_char(s: *const u8, ch: u8) -> isize {
    if s as usize == 0 {
        return -1;
    }
    let mut i: usize = 0;
    loop {
        let b = unsafe { *(s + i) };
        if b == 0u8 {
            break;
        }
        if b == ch {
            return i as isize;
        }
        i = i + 1;
    }
    -1
}

pub fn pe_parse_u32_decimal(s: *const u8, max_len: usize) -> u32 {
    if s as usize == 0 || max_len == 0 {
        return 0u32;
    }
    let mut val: u32 = 0u32;
    let mut i: usize = 0;
    while i < max_len {
        let b = unsafe { *(s + i) };
        if b < 48u8 || b > 57u8 {
            break;
        }
        val = coff_mul_u32(val, 10u32) + ((b - 48u8) as u32);
        i = i + 1;
    }
    val
}

pub fn pe_read_i64_le(buf: *const u8, off: usize) -> i64 {
    coff_read_u64_le(buf, off) as i64
}

pub fn pe_write_i32_le(buf: *mut u8, off: usize, val: i32) {
    coff_write_u32_le(buf, off, val as u32);
}

// --- PE32+ Header & Descriptor Structures ---

pub struct PeDataDirectory {
    pub virtual_address: u32,
    pub size: u32,
}

pub struct PeImportDescriptor {
    pub original_first_thunk: u32,
    pub time_date_stamp: u32,
    pub forwarder_chain: u32,
    pub name: u32,
    pub first_thunk: u32,
}

pub struct PeOptionalHeader64 {
    pub magic: u16,
    pub major_linker_version: u8,
    pub minor_linker_version: u8,
    pub size_of_code: u32,
    pub size_of_initialized_data: u32,
    pub size_of_uninitialized_data: u32,
    pub address_of_entry_point: u32,
    pub base_of_code: u32,
    pub image_base: u64,
    pub section_alignment: u32,
    pub file_alignment: u32,
    pub major_operating_system_version: u16,
    pub minor_operating_system_version: u16,
    pub major_image_version: u16,
    pub minor_image_version: u16,
    pub major_subsystem_version: u16,
    pub minor_subsystem_version: u16,
    pub win32_version_value: u32,
    pub size_of_image: u32,
    pub size_of_headers: u32,
    pub check_sum: u32,
    pub subsystem: u16,
    pub dll_characteristics: u16,
    pub size_of_stack_reserve: u64,
    pub size_of_stack_commit: u64,
    pub size_of_heap_reserve: u64,
    pub size_of_heap_commit: u64,
    pub loader_flags: u32,
    pub number_of_rva_and_sizes: u32,
}

pub fn pe_default_image_base() -> u64 {
    (1u64 << 32) | 0x40000000u64
}

pub fn pe_default_dll_image_base() -> u64 {
    (1u64 << 32) | 0x80000000u64
}

pub fn pe_optional_header64_init(ohdr: mut_view<PeOptionalHeader64>) {
    ohdr.magic = PE_MAGIC_PE32_PLUS;
    ohdr.major_linker_version = 0u8;
    ohdr.minor_linker_version = 0u8;
    ohdr.size_of_code = 0u32;
    ohdr.size_of_initialized_data = 0u32;
    ohdr.size_of_uninitialized_data = 0u32;
    ohdr.address_of_entry_point = 0u32;
    ohdr.base_of_code = 0u32;
    ohdr.image_base = pe_default_image_base();
    ohdr.section_alignment = PE_DEFAULT_SECTION_ALIGN;
    ohdr.file_alignment = PE_DEFAULT_FILE_ALIGN;
    ohdr.major_operating_system_version = 6u16;
    ohdr.minor_operating_system_version = 0u16;
    ohdr.major_image_version = 0u16;
    ohdr.minor_image_version = 0u16;
    ohdr.major_subsystem_version = 6u16;
    ohdr.minor_subsystem_version = 0u16;
    ohdr.win32_version_value = 0u32;
    ohdr.size_of_image = 0u32;
    ohdr.size_of_headers = 0u32;
    ohdr.check_sum = 0u32;
    ohdr.subsystem = IMAGE_SUBSYSTEM_WINDOWS_CUI;
    ohdr.dll_characteristics = IMAGE_DLLCHARACTERISTICS_NX_COMPAT |
        IMAGE_DLLCHARACTERISTICS_TERMINAL_SERVER_AWARE;
    ohdr.size_of_stack_reserve = PE_DEFAULT_STACK_RESERVE as u64;
    ohdr.size_of_stack_commit = PE_DEFAULT_STACK_COMMIT;
    ohdr.size_of_heap_reserve = PE_DEFAULT_HEAP_RESERVE;
    ohdr.size_of_heap_commit = PE_DEFAULT_HEAP_COMMIT;
    ohdr.loader_flags = 0u32;
    ohdr.number_of_rva_and_sizes = PE_DATA_DIRECTORY_COUNT as u32;
}

// --- PE32+ Header Binary Emitters & Decoders ---

pub fn pe_buf_put_zeroes(b: mut_view<CoffBuf>, count: usize) {
    if count == 0 {
        return;
    }
    coff_buf_reserve(mut_view(*b), count);
    unsafe {
        ptr_write_bytes<u8>(b.ptr + b.len, 0u8, count);
    }
    b.len = b.len + count;
}

pub fn pe_str_to_cstr_buf(s: Str) -> CoffBuf {
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = len(bytes);
    let mut b = coff_buf_with_capacity(n + 1);
    let dst = b.ptr;
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    b.len = n + 1;
    b
}

pub fn pe_emit_dos_header(out: mut_view<CoffBuf>) {
    coff_buf_put_u8(mut_view(*out), 0x4Du8); // 'M'
    coff_buf_put_u8(mut_view(*out), 0x5Au8); // 'Z'
    pe_buf_put_zeroes(mut_view(*out), PE_DOS_LFANEW_OFFSET - 2);
    coff_buf_put_u32(mut_view(*out), PE_DOS_HEADER_SIZE as u32); // e_lfanew = 64
}

pub fn pe_emit_pe_signature(out: mut_view<CoffBuf>) {
    coff_buf_put_u8(mut_view(*out), 0x50u8); // 'P'
    coff_buf_put_u8(mut_view(*out), 0x45u8); // 'E'
    coff_buf_put_u8(mut_view(*out), 0u8);
    coff_buf_put_u8(mut_view(*out), 0u8);
}

pub fn pe_emit_file_header(out: mut_view<CoffBuf>, fhdr: view<CoffFileHeader>) {
    coff_buf_put_u16(mut_view(*out), fhdr.machine);
    coff_buf_put_u16(mut_view(*out), fhdr.number_of_sections);
    coff_buf_put_u32(mut_view(*out), fhdr.time_date_stamp);
    coff_buf_put_u32(mut_view(*out), fhdr.pointer_to_symbol_table);
    coff_buf_put_u32(mut_view(*out), fhdr.number_of_symbols);
    coff_buf_put_u16(mut_view(*out), fhdr.size_of_optional_header);
    coff_buf_put_u16(mut_view(*out), fhdr.characteristics);
}

pub fn pe_emit_optional_header64(out: mut_view<CoffBuf>, ohdr: view<PeOptionalHeader64>) {
    coff_buf_put_u16(mut_view(*out), ohdr.magic);
    coff_buf_put_u8(mut_view(*out), ohdr.major_linker_version);
    coff_buf_put_u8(mut_view(*out), ohdr.minor_linker_version);
    coff_buf_put_u32(mut_view(*out), ohdr.size_of_code);
    coff_buf_put_u32(mut_view(*out), ohdr.size_of_initialized_data);
    coff_buf_put_u32(mut_view(*out), ohdr.size_of_uninitialized_data);
    coff_buf_put_u32(mut_view(*out), ohdr.address_of_entry_point);
    coff_buf_put_u32(mut_view(*out), ohdr.base_of_code);
    coff_buf_put_u64(mut_view(*out), ohdr.image_base);
    coff_buf_put_u32(mut_view(*out), ohdr.section_alignment);
    coff_buf_put_u32(mut_view(*out), ohdr.file_alignment);
    coff_buf_put_u16(mut_view(*out), ohdr.major_operating_system_version);
    coff_buf_put_u16(mut_view(*out), ohdr.minor_operating_system_version);
    coff_buf_put_u16(mut_view(*out), ohdr.major_image_version);
    coff_buf_put_u16(mut_view(*out), ohdr.minor_image_version);
    coff_buf_put_u16(mut_view(*out), ohdr.major_subsystem_version);
    coff_buf_put_u16(mut_view(*out), ohdr.minor_subsystem_version);
    coff_buf_put_u32(mut_view(*out), ohdr.win32_version_value);
    coff_buf_put_u32(mut_view(*out), ohdr.size_of_image);
    coff_buf_put_u32(mut_view(*out), ohdr.size_of_headers);
    coff_buf_put_u32(mut_view(*out), ohdr.check_sum);
    coff_buf_put_u16(mut_view(*out), ohdr.subsystem);
    coff_buf_put_u16(mut_view(*out), ohdr.dll_characteristics);
    coff_buf_put_u64(mut_view(*out), ohdr.size_of_stack_reserve);
    coff_buf_put_u64(mut_view(*out), ohdr.size_of_stack_commit);
    coff_buf_put_u64(mut_view(*out), ohdr.size_of_heap_reserve);
    coff_buf_put_u64(mut_view(*out), ohdr.size_of_heap_commit);
    coff_buf_put_u32(mut_view(*out), ohdr.loader_flags);
    coff_buf_put_u32(mut_view(*out), ohdr.number_of_rva_and_sizes);
}

pub fn pe_emit_data_directory(out: mut_view<CoffBuf>, dir: view<PeDataDirectory>) {
    coff_buf_put_u32(mut_view(*out), dir.virtual_address);
    coff_buf_put_u32(mut_view(*out), dir.size);
}

pub fn pe_emit_section_header(out: mut_view<CoffBuf>, shdr: view<CoffSectionHeader>) {
    let mut k: usize = 0;
    while k < 8 {
        coff_buf_put_u8(mut_view(*out), shdr.name[k]);
        k = k + 1;
    }
    coff_buf_put_u32(mut_view(*out), shdr.virtual_size);
    coff_buf_put_u32(mut_view(*out), shdr.virtual_address);
    coff_buf_put_u32(mut_view(*out), shdr.size_of_raw_data);
    coff_buf_put_u32(mut_view(*out), shdr.pointer_to_raw_data);
    coff_buf_put_u32(mut_view(*out), shdr.pointer_to_relocations);
    coff_buf_put_u32(mut_view(*out), shdr.pointer_to_linenumbers);
    coff_buf_put_u16(mut_view(*out), shdr.number_of_relocations);
    coff_buf_put_u16(mut_view(*out), shdr.number_of_linenumbers);
    coff_buf_put_u32(mut_view(*out), shdr.characteristics);
}

pub fn pe_decode_dos_header(buf: *const u8, buf_len: usize, out_lfanew: mut_view<u32>) -> bool {
    if buf as usize == 0 || buf_len < PE_DOS_HEADER_SIZE {
        return false;
    }
    let b0 = unsafe { *buf };
    let b1 = unsafe { *(buf + 1) };
    if b0 != 0x4Du8 || b1 != 0x5Au8 {
        return false;
    }
    let lfanew = coff_read_u32_le(buf, PE_DOS_LFANEW_OFFSET);
    *out_lfanew = lfanew;
    true
}

pub fn pe_check_signature(buf: *const u8, off: usize, buf_len: usize) -> bool {
    if buf as usize == 0 || off + PE_SIGNATURE_SIZE > buf_len {
        return false;
    }
    let p0 = unsafe { *(buf + off) };
    let p1 = unsafe { *(buf + off + 1) };
    let p2 = unsafe { *(buf + off + 2) };
    let p3 = unsafe { *(buf + off + 3) };
    p0 == 0x50u8 && p1 == 0x45u8 && p2 == 0u8 && p3 == 0u8
}

pub fn pe_decode_optional_header64(buf: *const u8, off: usize, out: mut_view<PeOptionalHeader64>) {
    let magic = coff_read_u16_le(buf, off);
    let maj_lv = unsafe { *(buf + off + 2) };
    let min_lv = unsafe { *(buf + off + 3) };
    let sz_code = coff_read_u32_le(buf, off + 4);
    let sz_init = coff_read_u32_le(buf, off + 8);
    let sz_uninit = coff_read_u32_le(buf, off + 12);
    let entry_pt = coff_read_u32_le(buf, off + 16);
    let base_code = coff_read_u32_le(buf, off + 20);
    let img_base = coff_read_u64_le(buf, off + 24);
    let sec_align = coff_read_u32_le(buf, off + 32);
    let file_align = coff_read_u32_le(buf, off + 36);
    let maj_os = coff_read_u16_le(buf, off + 40);
    let min_os = coff_read_u16_le(buf, off + 42);
    let maj_img = coff_read_u16_le(buf, off + 44);
    let min_img = coff_read_u16_le(buf, off + 46);
    let maj_sub = coff_read_u16_le(buf, off + 48);
    let min_sub = coff_read_u16_le(buf, off + 50);
    let win32_ver = coff_read_u32_le(buf, off + 52);
    let sz_img = coff_read_u32_le(buf, off + 56);
    let sz_hdrs = coff_read_u32_le(buf, off + 60);
    let csum = coff_read_u32_le(buf, off + 64);
    let subsys = coff_read_u16_le(buf, off + 68);
    let dll_chars = coff_read_u16_le(buf, off + 70);
    let stk_res = coff_read_u64_le(buf, off + 72);
    let stk_com = coff_read_u64_le(buf, off + 80);
    let hp_res = coff_read_u64_le(buf, off + 88);
    let hp_com = coff_read_u64_le(buf, off + 96);
    let ldr_flags = coff_read_u32_le(buf, off + 104);
    let num_rva = coff_read_u32_le(buf, off + 108);

    out.magic = magic;
    out.major_linker_version = maj_lv;
    out.minor_linker_version = min_lv;
    out.size_of_code = sz_code;
    out.size_of_initialized_data = sz_init;
    out.size_of_uninitialized_data = sz_uninit;
    out.address_of_entry_point = entry_pt;
    out.base_of_code = base_code;
    out.image_base = img_base;
    out.section_alignment = sec_align;
    out.file_alignment = file_align;
    out.major_operating_system_version = maj_os;
    out.minor_operating_system_version = min_os;
    out.major_image_version = maj_img;
    out.minor_image_version = min_img;
    out.major_subsystem_version = maj_sub;
    out.minor_subsystem_version = min_sub;
    out.win32_version_value = win32_ver;
    out.size_of_image = sz_img;
    out.size_of_headers = sz_hdrs;
    out.check_sum = csum;
    out.subsystem = subsys;
    out.dll_characteristics = dll_chars;
    out.size_of_stack_reserve = stk_res;
    out.size_of_stack_commit = stk_com;
    out.size_of_heap_reserve = hp_res;
    out.size_of_heap_commit = hp_com;
    out.loader_flags = ldr_flags;
    out.number_of_rva_and_sizes = num_rva;
}

pub fn pe_decode_data_directory(buf: *const u8, off: usize) -> PeDataDirectory {
    PeDataDirectory {
        virtual_address: coff_read_u32_le(buf, off),
        size: coff_read_u32_le(buf, off + 4),
    }
}

pub fn pe_decode_import_descriptor(buf: *const u8, off: usize) -> PeImportDescriptor {
    PeImportDescriptor {
        original_first_thunk: coff_read_u32_le(buf, off),
        time_date_stamp: coff_read_u32_le(buf, off + 4),
        forwarder_chain: coff_read_u32_le(buf, off + 8),
        name: coff_read_u32_le(buf, off + 12),
        first_thunk: coff_read_u32_le(buf, off + 16),
    }
}

pub fn pe_write_import_descriptor(buf: *mut u8, off: usize, desc: view<PeImportDescriptor>) {
    coff_write_u32_le(buf, off, desc.original_first_thunk);
    coff_write_u32_le(buf, off + 4, desc.time_date_stamp);
    coff_write_u32_le(buf, off + 8, desc.forwarder_chain);
    coff_write_u32_le(buf, off + 12, desc.name);
    coff_write_u32_le(buf, off + 16, desc.first_thunk);
}

// --- Linker Core Data Structures (MergedSection, GlobalSymbol, PeReloc, LinkerContext) ---

pub struct MergedSection {
    pub name: [9]u8,
    pub characteristics: u32,
    pub data: *mut u8,
    pub size: u32,
    pub cap: u32,
    pub rva: u32,
    pub raw_ptr: u32,
}

pub struct GlobalSymbol {
    pub name: *const u8,
    pub sec: *mut MergedSection,
    pub offset: u32,
    pub defined: bool,
}

pub struct PeReloc {
    pub sec: *mut MergedSection,
    pub offset: u32,
    pub reloc_type: u16,
    pub sym_name: *const u8,
    // Same-object target (ADR-0035 section 2): when `dsec` is non-null the relocation is bound to
    // `dsec` + `doffset` by symbol index at load time and `sym_name` is unused (null).
    pub dsec: *mut MergedSection,
    pub doffset: u32,
    pub addend: i64,
}

pub struct LinkerContext {
    pub sections: *mut *mut MergedSection,
    pub num_sections: usize,
    pub cap_sections: usize,
    pub globals: *mut GlobalSymbol,
    pub num_globals: usize,
    pub cap_globals: usize,
    pub relocs: *mut PeReloc,
    pub num_relocs: usize,
    pub cap_relocs: usize,
    pub str_arena: *mut Arena,
}

fn alloc_linker_arena() -> *mut Arena {
    let a = unsafe { heap_alloc(size_of<Arena>(), align_of<Arena>()) as *mut Arena };
    unsafe {
        *a = arena_new();
    }
    a
}

pub fn linker_context_init(ctx: mut_view<LinkerContext>) {
    ctx.sections = 0 as *mut *mut MergedSection;
    ctx.num_sections = 0;
    ctx.cap_sections = 0;
    ctx.globals = 0 as *mut GlobalSymbol;
    ctx.num_globals = 0;
    ctx.cap_globals = 0;
    ctx.relocs = 0 as *mut PeReloc;
    ctx.num_relocs = 0;
    ctx.cap_relocs = 0;
    ctx.str_arena = alloc_linker_arena();
}

pub unsafe fn merged_sec_slot_ptr(base: *mut *mut MergedSection, idx: usize) -> *mut *mut MergedSection {
    ((base as usize) + coff_mul_usize(idx, size_of<*mut MergedSection>())) as *mut *mut MergedSection
}

pub unsafe fn global_sym_slot_ptr(base: *mut GlobalSymbol, idx: usize) -> *mut GlobalSymbol {
    ((base as usize) + coff_mul_usize(idx, size_of<GlobalSymbol>())) as *mut GlobalSymbol
}

pub unsafe fn pe_reloc_slot_ptr(base: *mut PeReloc, idx: usize) -> *mut PeReloc {
    ((base as usize) + coff_mul_usize(idx, size_of<PeReloc>())) as *mut PeReloc
}

pub fn linker_context_free(ctx: mut_view<LinkerContext>) {
    let mut i: usize = 0;
    while i < ctx.num_sections {
        let sec = unsafe { *(merged_sec_slot_ptr(ctx.sections, i)) };
        if (sec as usize) != 0 {
            unsafe {
                if (*sec).cap > 0u32 && ((*sec).data as usize) != 0 {
                    heap_free((*sec).data, (*sec).cap as usize, 8);
                }
                (*sec).data = 0 as *mut u8;
                (*sec).size = 0u32;
                (*sec).cap = 0u32;
                heap_free(sec as *mut u8, size_of<MergedSection>(), align_of<MergedSection>());
            }
        }
        i = i + 1;
    }
    if ctx.cap_sections > 0 && (ctx.sections as usize) != 0 {
        unsafe {
            heap_free(
                ctx.sections as *mut u8,
                coff_mul_usize(ctx.cap_sections, size_of<*mut MergedSection>()),
                align_of<*mut MergedSection>()
            );
        }
    }
    ctx.sections = 0 as *mut *mut MergedSection;
    ctx.num_sections = 0;
    ctx.cap_sections = 0;

    if ctx.cap_globals > 0 && (ctx.globals as usize) != 0 {
        unsafe {
            heap_free(
                ctx.globals as *mut u8,
                coff_mul_usize(ctx.cap_globals, size_of<GlobalSymbol>()),
                align_of<GlobalSymbol>()
            );
        }
    }
    ctx.globals = 0 as *mut GlobalSymbol;
    ctx.num_globals = 0;
    ctx.cap_globals = 0;

    if ctx.cap_relocs > 0 && (ctx.relocs as usize) != 0 {
        unsafe {
            heap_free(
                ctx.relocs as *mut u8,
                coff_mul_usize(ctx.cap_relocs, size_of<PeReloc>()),
                align_of<PeReloc>()
            );
        }
    }
    ctx.relocs = 0 as *mut PeReloc;
    ctx.num_relocs = 0;
    ctx.cap_relocs = 0;

    if (ctx.str_arena as usize) != 0 {
        unsafe {
            arena_destroy(mut_view(*ctx.str_arena));
            heap_free(ctx.str_arena as *mut u8, size_of<Arena>(), align_of<Arena>());
        }
        ctx.str_arena = 0 as *mut Arena;
    }
}

pub fn linker_dup_bytes(ctx: mut_view<LinkerContext>, src: *const u8, n: usize) -> *const u8 {
    if (ctx.str_arena as usize) == 0 {
        ctx.str_arena = alloc_linker_arena();
    }
    let dst = arena_alloc_raw(unsafe { mut_view(*ctx.str_arena) }, n + 1, 1);
    if n > 0 && (src as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, n);
        }
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    dst as *const u8
}

pub fn linker_dup_cstr(ctx: mut_view<LinkerContext>, src: *const u8) -> *const u8 {
    linker_dup_bytes(ctx, src, cstr_len(src))
}

pub fn linker_section_at(ctx: view<LinkerContext>, idx: usize) -> *mut MergedSection {
    if idx >= ctx.num_sections || (ctx.sections as usize) == 0 {
        return 0 as *mut MergedSection;
    }
    unsafe { *(merged_sec_slot_ptr(ctx.sections, idx)) }
}

pub fn merged_section_name_ptr(sec: *const MergedSection) -> *const u8 {
    if (sec as usize) == 0 {
        return 0 as *const u8;
    }
    unsafe { address_of((*sec).name[0]) }
}

pub fn linker_find_section(ctx: view<LinkerContext>, name: *const u8) -> *mut MergedSection {
    let target_len = if cstr_len(name) > 8 { 8 } else { cstr_len(name) };
    let mut i: usize = 0;
    while i < ctx.num_sections {
        let sec = linker_section_at(ctx, i);
        let sname_ptr = merged_section_name_ptr(sec as *const MergedSection);
        let slen = cstr_len(sname_ptr);
        if bytes_eq(sname_ptr, slen, name, target_len) {
            return sec;
        }
        i = i + 1;
    }
    0 as *mut MergedSection
}

pub fn linker_find_section_str(ctx: view<LinkerContext>, name: Str) -> *mut MergedSection {
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let n = len(bytes);
    let target_len = if n > 8 { 8 } else { n };
    let mut tmp: [9]u8 = [0u8; 9];
    let mut k: usize = 0;
    while k < target_len {
        tmp[k] = bytes[k];
        k = k + 1;
    }
    let p = unsafe { address_of(tmp[0]) };
    linker_find_section(ctx, p)
}

pub fn linker_get_or_create_section(ctx: mut_view<LinkerContext>, name: *const u8, chars: u32) -> *mut MergedSection {
    let existing = linker_find_section(view(*ctx), name);
    if (existing as usize) != 0 {
        unsafe {
            (*existing).characteristics = (*existing).characteristics | chars;
        }
        return existing;
    }

    if ctx.num_sections == ctx.cap_sections {
        let new_cap = if ctx.cap_sections == 0 { 16 } else { ctx.cap_sections + ctx.cap_sections };
        let new_bytes = coff_mul_usize(new_cap, size_of<*mut MergedSection>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<*mut MergedSection>()) as *mut *mut MergedSection };
        if ctx.num_sections > 0 && (ctx.sections as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ctx.sections as *const u8,
                    new_arr as *mut u8,
                    coff_mul_usize(ctx.num_sections, size_of<*mut MergedSection>())
                );
                heap_free(
                    ctx.sections as *mut u8,
                    coff_mul_usize(ctx.cap_sections, size_of<*mut MergedSection>()),
                    align_of<*mut MergedSection>()
                );
            }
        }
        ctx.sections = new_arr;
        ctx.cap_sections = new_cap;
    }

    let sec = unsafe { heap_alloc(size_of<MergedSection>(), align_of<MergedSection>()) as *mut MergedSection };
    let mut name_arr: [9]u8 = [0u8; 9];
    let nlen = cstr_len(name);
    let copy_len = if nlen > 8 { 8 } else { nlen };
    let mut k: usize = 0;
    while k < copy_len {
        name_arr[k] = unsafe { *(name + k) };
        k = k + 1;
    }
    unsafe {
        *sec = MergedSection {
            name: name_arr,
            characteristics: chars,
            data: 0 as *mut u8,
            size: 0u32,
            cap: 0u32,
            rva: 0u32,
            raw_ptr: 0u32,
        };
        *(merged_sec_slot_ptr(ctx.sections, ctx.num_sections)) = sec;
    }
    ctx.num_sections = ctx.num_sections + 1;
    sec
}

pub fn linker_get_or_create_section_str(ctx: mut_view<LinkerContext>, name: Str, chars: u32) -> *mut MergedSection {
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let n = len(bytes);
    let copy_len = if n > 8 { 8 } else { n };
    let mut tmp: [9]u8 = [0u8; 9];
    let mut k: usize = 0;
    while k < copy_len {
        tmp[k] = bytes[k];
        k = k + 1;
    }
    let p = unsafe { address_of(tmp[0]) };
    linker_get_or_create_section(ctx, p, chars)
}

pub fn linker_append_section_data(sec: *mut MergedSection, data: *const u8, size: u32, align: u32, out_offset: *mut u32) {
    if (sec as usize) == 0 {
        return;
    }
    let old_size = unsafe { (*sec).size };
    let offset = pe_align_up_u32(old_size, align);
    let new_size = offset + size;
    let old_cap = unsafe { (*sec).cap };

    if new_size > old_cap {
        let mut new_cap: u32 = if old_cap == 0u32 { 1024u32 } else { old_cap };
        while new_cap < new_size {
            new_cap = new_cap + new_cap;
        }
        let new_data = unsafe { heap_alloc(new_cap as usize, 8) };
        let old_data = unsafe { (*sec).data };
        if old_size > 0u32 && (old_data as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(old_data as *const u8, new_data, old_size as usize);
                heap_free(old_data, old_cap as usize, 8);
            }
        } else if old_cap > 0u32 && (old_data as usize) != 0 {
            unsafe {
                heap_free(old_data, old_cap as usize, 8);
            }
        }
        unsafe {
            (*sec).data = new_data;
            (*sec).cap = new_cap;
        }
    }

    let dst_base = unsafe { (*sec).data };
    if offset > old_size {
        unsafe {
            ptr_write_bytes<u8>(dst_base + (old_size as usize), 0u8, (offset - old_size) as usize);
        }
    }

    if size > 0u32 {
        if (data as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(data, dst_base + (offset as usize), size as usize);
            }
        } else {
            unsafe {
                ptr_write_bytes<u8>(dst_base + (offset as usize), 0u8, size as usize);
            }
        }
    }

    unsafe {
        (*sec).size = new_size;
        if (out_offset as usize) != 0 {
            *out_offset = offset;
        }
    }
}

pub fn linker_append_section_slice(sec: *mut MergedSection, data: view<[u8]>, align: u32) -> u32 {
    let n = len(data);
    let mut off: [1]u32 = [0u32];
    let poff = unsafe { address_of(off[0]) as *mut u32 };
    linker_append_section_data(sec, 0 as *const u8, n as u32, align, poff);
    let base_off = off[0] as usize;
    let dst = unsafe { (*sec).data };
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + base_off + i) = data[i];
        }
        i = i + 1;
    }
    off[0]
}

pub fn linker_global_at(ctx: view<LinkerContext>, idx: usize) -> *mut GlobalSymbol {
    if idx >= ctx.num_globals || (ctx.globals as usize) == 0 {
        return 0 as *mut GlobalSymbol;
    }
    unsafe { global_sym_slot_ptr(ctx.globals, idx) }
}

pub fn linker_find_global(ctx: view<LinkerContext>, name: *const u8) -> *mut GlobalSymbol {
    if (name as usize) == 0 || (ctx.globals as usize) == 0 {
        return 0 as *mut GlobalSymbol;
    }
    let stride = size_of<GlobalSymbol>();
    let base = ctx.globals as usize;
    let b0 = unsafe { *name };
    let mut i: usize = 0;
    while i < ctx.num_globals {
        let g = (base + (((i as isize) * (stride as isize)) as usize)) as *mut GlobalSymbol;
        let gname = unsafe { (*g).name };
        if (gname as usize) != 0 && (unsafe { *gname }) == b0 {
            let mut k: usize = 0;
            let mut eq = true;
            while true {
                let c1 = unsafe { *(gname + k) };
                let c2 = unsafe { *(name + k) };
                if c1 != c2 {
                    eq = false;
                    break;
                }
                if c1 == 0u8 {
                    break;
                }
                k = k + 1;
            }
            if eq {
                return g;
            }
        }
        i = i + 1;
    }
    0 as *mut GlobalSymbol
}

pub fn linker_find_global_str(ctx: view<LinkerContext>, name: Str) -> *mut GlobalSymbol {
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let n = len(bytes);
    let mut i: usize = 0;
    while i < ctx.num_globals {
        let g = linker_global_at(ctx, i);
        let gname = unsafe { (*g).name };
        let glen = cstr_len(gname);
        if glen == n {
            let mut matched = true;
            let mut k: usize = 0;
            while k < n {
                if unsafe { *(gname + k) } != bytes[k] {
                    matched = false;
                    break;
                }
                k = k + 1;
            }
            if matched {
                return g;
            }
        }
        i = i + 1;
    }
    0 as *mut GlobalSymbol
}

pub fn linker_add_global(ctx: mut_view<LinkerContext>, name: *const u8) -> *mut GlobalSymbol {
    let existing = linker_find_global(view(*ctx), name);
    if (existing as usize) != 0 {
        return existing;
    }

    if ctx.num_globals == ctx.cap_globals {
        let new_cap = if ctx.cap_globals == 0 { 64 } else { ctx.cap_globals + ctx.cap_globals };
        let new_bytes = coff_mul_usize(new_cap, size_of<GlobalSymbol>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<GlobalSymbol>()) as *mut GlobalSymbol };
        if ctx.num_globals > 0 && (ctx.globals as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ctx.globals as *const u8,
                    new_arr as *mut u8,
                    coff_mul_usize(ctx.num_globals, size_of<GlobalSymbol>())
                );
                heap_free(
                    ctx.globals as *mut u8,
                    coff_mul_usize(ctx.cap_globals, size_of<GlobalSymbol>()),
                    align_of<GlobalSymbol>()
                );
            }
        }
        ctx.globals = new_arr;
        ctx.cap_globals = new_cap;
    }

    let dup_name = linker_dup_cstr(mut_view(*ctx), name);
    let slot = unsafe { global_sym_slot_ptr(ctx.globals, ctx.num_globals) };
    unsafe {
        *slot = GlobalSymbol {
            name: dup_name,
            sec: 0 as *mut MergedSection,
            offset: 0u32,
            defined: false,
        };
    }
    ctx.num_globals = ctx.num_globals + 1;
    slot
}

pub fn linker_add_global_str(ctx: mut_view<LinkerContext>, name: Str) -> *mut GlobalSymbol {
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let n = len(bytes);
    let buf_ptr = unsafe { heap_alloc(n + 1, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(buf_ptr + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf_ptr + n) = 0u8;
    }
    let res = linker_add_global(ctx, buf_ptr as *const u8);
    unsafe {
        heap_free(buf_ptr, n + 1, 1);
    }
    res
}

pub fn linker_reloc_at(ctx: view<LinkerContext>, idx: usize) -> *mut PeReloc {
    if idx >= ctx.num_relocs || (ctx.relocs as usize) == 0 {
        return 0 as *mut PeReloc;
    }
    unsafe { pe_reloc_slot_ptr(ctx.relocs, idx) }
}

// Grows `ctx.relocs` when full and returns the slot for a new relocation (count already bumped).
fn linker_reloc_push_slot(ctx: mut_view<LinkerContext>) -> *mut PeReloc {
    if ctx.num_relocs == ctx.cap_relocs {
        let new_cap = if ctx.cap_relocs == 0 { 64 } else { ctx.cap_relocs + ctx.cap_relocs };
        let new_bytes = coff_mul_usize(new_cap, size_of<PeReloc>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<PeReloc>()) as *mut PeReloc };
        if ctx.num_relocs > 0 && (ctx.relocs as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ctx.relocs as *const u8,
                    new_arr as *mut u8,
                    coff_mul_usize(ctx.num_relocs, size_of<PeReloc>())
                );
                heap_free(
                    ctx.relocs as *mut u8,
                    coff_mul_usize(ctx.cap_relocs, size_of<PeReloc>()),
                    align_of<PeReloc>()
                );
            }
        }
        ctx.relocs = new_arr;
        ctx.cap_relocs = new_cap;
    }
    let slot = unsafe { pe_reloc_slot_ptr(ctx.relocs, ctx.num_relocs) };
    ctx.num_relocs = ctx.num_relocs + 1;
    slot
}

pub fn linker_add_reloc(ctx: mut_view<LinkerContext>, sec: *mut MergedSection, offset: u32, reloc_type: u16, sym_name: *const u8, addend: i64) {
    let dup_sym = linker_dup_cstr(mut_view(*ctx), sym_name);
    let slot = linker_reloc_push_slot(mut_view(*ctx));
    unsafe {
        *slot = PeReloc {
            sec: sec,
            offset: offset,
            reloc_type: reloc_type,
            sym_name: dup_sym,
            dsec: 0 as *mut MergedSection,
            doffset: 0u32,
            addend: addend,
        };
    }
}

// Relocation whose target symbol is defined in the same object (SectionNumber > 0): bound by the
// symbol-table index at load time, whatever its name or storage class (ADR-0035 section 2).
pub fn linker_add_reloc_direct(ctx: mut_view<LinkerContext>, sec: *mut MergedSection, offset: u32, reloc_type: u16, dsec: *mut MergedSection, doffset: u32, addend: i64) {
    let slot = linker_reloc_push_slot(mut_view(*ctx));
    unsafe {
        *slot = PeReloc {
            sec: sec,
            offset: offset,
            reloc_type: reloc_type,
            sym_name: 0 as *const u8,
            dsec: dsec,
            doffset: doffset,
            addend: addend,
        };
    }
}

pub fn linker_add_reloc_str(ctx: mut_view<LinkerContext>, sec: *mut MergedSection, offset: u32, reloc_type: u16, sym_name: Str, addend: i64) {
    let bytes: view<[u8]> = unsafe { *(address_of(sym_name) as *const view<[u8]>) };
    let n = len(bytes);
    let buf_ptr = unsafe { heap_alloc(n + 1, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(buf_ptr + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf_ptr + n) = 0u8;
    }
    linker_add_reloc(ctx, sec, offset, reloc_type, buf_ptr as *const u8, addend);
    unsafe {
        heap_free(buf_ptr, n + 1, 1);
    }
}

// --- DLL Export State (`.edata` & Companion Short-Import `.lib`) ---

pub struct DllExportSpec {
    pub ext_name: *const u8,
    pub internal_name: *const u8,
    pub is_data: bool,
    pub rva: u32,
}

pub struct DllLinkState {
    pub exports: *mut DllExportSpec,
    pub num_exports: usize,
    pub cap_exports: usize,
}

pub fn dll_state_new() -> DllLinkState {
    DllLinkState {
        exports: 0 as *mut DllExportSpec,
        num_exports: 0,
        cap_exports: 0,
    }
}

pub unsafe fn dll_export_slot_ptr(base: *mut DllExportSpec, idx: usize) -> *mut DllExportSpec {
    ((base as usize) + coff_mul_usize(idx, size_of<DllExportSpec>())) as *mut DllExportSpec
}

pub fn dll_export_at(st: view<DllLinkState>, idx: usize) -> *mut DllExportSpec {
    if idx >= st.num_exports || (st.exports as usize) == 0 {
        return 0 as *mut DllExportSpec;
    }
    unsafe { dll_export_slot_ptr(st.exports, idx) }
}

pub fn dll_state_free(st: mut_view<DllLinkState>) {
    if st.cap_exports > 0 && (st.exports as usize) != 0 {
        unsafe {
            heap_free(
                st.exports as *mut u8,
                coff_mul_usize(st.cap_exports, size_of<DllExportSpec>()),
                align_of<DllExportSpec>()
            );
        }
    }
    st.exports = 0 as *mut DllExportSpec;
    st.num_exports = 0;
    st.cap_exports = 0;
}

pub fn dll_state_add_export(
    st: mut_view<DllLinkState>,
    ctx: mut_view<LinkerContext>,
    ext_ptr: *const u8,
    ext_len: usize,
    int_ptr: *const u8,
    int_len: usize,
    is_data: bool
) {
    if ext_len == 0 || (ext_ptr as usize) == 0 {
        return;
    }
    let eff_int_ptr = if int_len > 0 && (int_ptr as usize) != 0 { int_ptr } else { ext_ptr };
    let eff_int_len = if int_len > 0 && (int_ptr as usize) != 0 { int_len } else { ext_len };

    if st.num_exports == st.cap_exports {
        let new_cap = if st.cap_exports == 0 { 16 } else { st.cap_exports + st.cap_exports };
        let new_bytes = coff_mul_usize(new_cap, size_of<DllExportSpec>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<DllExportSpec>()) as *mut DllExportSpec };
        if st.num_exports > 0 && (st.exports as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    st.exports as *const u8,
                    new_arr as *mut u8,
                    coff_mul_usize(st.num_exports, size_of<DllExportSpec>())
                );
                heap_free(
                    st.exports as *mut u8,
                    coff_mul_usize(st.cap_exports, size_of<DllExportSpec>()),
                    align_of<DllExportSpec>()
                );
            }
        }
        st.exports = new_arr;
        st.cap_exports = new_cap;
    }

    let dup_ext = linker_dup_bytes(mut_view(*ctx), ext_ptr, ext_len);
    let dup_int = linker_dup_bytes(mut_view(*ctx), eff_int_ptr, eff_int_len);
    let slot = unsafe { dll_export_slot_ptr(st.exports, st.num_exports) };
    unsafe {
        *slot = DllExportSpec {
            ext_name: dup_ext,
            internal_name: dup_int,
            is_data: is_data,
            rva: 0u32,
        };
    }
    st.num_exports = st.num_exports + 1;
}

// --- Linker v2 Constants, Symbol Mangling/Demangling, and .axmeta Metadata (SPEC-27) ---

pub const IMAGE_REL_AMD64_SECTION: u16 = 10u16;
pub const IMAGE_REL_AMD64_SECREL: u16 = 11u16;
pub const IMAGE_SYM_CLASS_WEAK_EXTERNAL: u8 = 105u8;
pub const IMAGE_SCN_LNK_INFO: u32 = 0x00000200u32;
pub const IMAGE_SCN_LNK_REMOVE: u32 = 0x00000800u32;

// SPEC-27 §7 Diagnostic Code Constants
pub const AX_LINK_ABI_MISMATCH: u32 = 153u32;
pub const AX_LINK_ARTIFACT_TARGET_MISMATCH: u32 = 154u32;

pub const SYM_BIND_STRONG: u8 = 0u8;
pub const SYM_BIND_WEAK: u8 = 1u8;
pub const SYM_BIND_LOCAL: u8 = 2u8;

pub const SYM_ABI_KIND_UNKNOWN: u8 = 0u8;
pub const SYM_ABI_KIND_FUNC: u8 = 1u8;
pub const SYM_ABI_KIND_DATA: u8 = 2u8;
pub const SYM_ABI_KIND_TLS: u8 = 3u8;

pub const SYM_CC_WIN64: u8 = 0u8;
pub const SYM_CC_FASTCALL: u8 = 1u8;
pub const SYM_CC_VECTORCALL: u8 = 2u8;
pub const SYM_CC_SYSV64: u8 = 3u8;

pub const AXMETA_ENTRY_DEF: u8 = 0u8;
pub const AXMETA_ENTRY_REF: u8 = 1u8;
pub const AXMETA_VERSION: u32 = 1u32;

pub fn linker_append_section_data_pad(
    sec: *mut MergedSection,
    data: *const u8,
    size: u32,
    align: u32,
    pad_byte: u8,
    out_offset: *mut u32
) {
    if (sec as usize) == 0 {
        return;
    }
    let old_size = unsafe { (*sec).size };
    let offset = pe_align_up_u32(old_size, align);
    let new_size = offset + size;
    let old_cap = unsafe { (*sec).cap };

    if new_size > old_cap {
        let mut new_cap: u32 = if old_cap == 0u32 { 1024u32 } else { old_cap };
        while new_cap < new_size {
            new_cap = new_cap + new_cap;
        }
        let new_data = unsafe { heap_alloc(new_cap as usize, 8) };
        let old_data = unsafe { (*sec).data };
        if old_size > 0u32 && (old_data as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(old_data as *const u8, new_data, old_size as usize);
                heap_free(old_data, old_cap as usize, 8);
            }
        } else if old_cap > 0u32 && (old_data as usize) != 0 {
            unsafe {
                heap_free(old_data, old_cap as usize, 8);
            }
        }
        unsafe {
            (*sec).data = new_data;
            (*sec).cap = new_cap;
        }
    }

    let dst_base = unsafe { (*sec).data };
    if offset > old_size {
        unsafe {
            ptr_write_bytes<u8>(dst_base + (old_size as usize), pad_byte, (offset - old_size) as usize);
        }
    }

    if size > 0u32 {
        if (data as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(data, dst_base + (offset as usize), size as usize);
            }
        } else {
            unsafe {
                ptr_write_bytes<u8>(dst_base + (offset as usize), 0u8, size as usize);
            }
        }
    }

    unsafe {
        (*sec).size = new_size;
        if (out_offset as usize) != 0 {
            *out_offset = offset;
        }
    }
}

pub struct LinkV2SymMeta {
    pub sym_name: *const u8,
    pub demangled: *const u8,
    pub obj_name: *const u8,
    pub abi_sig: *const u8,
    pub ref_fn: *const u8,
    pub entry_kind: u8,
    pub binding: u8,
    pub abi_kind: u8,
    pub calling_conv: u8,
    pub param_count: u32,
    pub ret_size: u32,
    pub file_id: u32,
    pub span_start: u32,
    pub span_end: u32,
}

pub struct LinkV2RelocMeta {
    pub reloc_idx: usize,
    pub obj_name: *const u8,
    pub sec_name: *const u8,
    pub ref_fn: *const u8,
    pub file_id: u32,
    pub span_start: u32,
    pub span_end: u32,
}

pub struct LinkV2Context {
    pub syms: *mut LinkV2SymMeta,
    pub num_syms: usize,
    pub cap_syms: usize,
    pub reloc_metas: *mut LinkV2RelocMeta,
    pub num_reloc_metas: usize,
    pub cap_reloc_metas: usize,
    pub searched_libs: *const u8,
    pub current_obj_name: *const u8,
    pub active: bool,
}

pub fn link_v2_context_new() -> LinkV2Context {
    LinkV2Context {
        syms: 0 as *mut LinkV2SymMeta,
        num_syms: 0,
        cap_syms: 0,
        reloc_metas: 0 as *mut LinkV2RelocMeta,
        num_reloc_metas: 0,
        cap_reloc_metas: 0,
        searched_libs: 0 as *const u8,
        current_obj_name: 0 as *const u8,
        active: true,
    }
}

pub fn link_v2_context_free(v2: mut_view<LinkV2Context>) {
    if v2.cap_syms > 0 && (v2.syms as usize) != 0 {
        unsafe {
            heap_free(
                v2.syms as *mut u8,
                coff_mul_usize(v2.cap_syms, size_of<LinkV2SymMeta>()),
                align_of<LinkV2SymMeta>()
            );
        }
    }
    if v2.cap_reloc_metas > 0 && (v2.reloc_metas as usize) != 0 {
        unsafe {
            heap_free(
                v2.reloc_metas as *mut u8,
                coff_mul_usize(v2.cap_reloc_metas, size_of<LinkV2RelocMeta>()),
                align_of<LinkV2RelocMeta>()
            );
        }
    }
    v2.syms = 0 as *mut LinkV2SymMeta;
    v2.num_syms = 0;
    v2.cap_syms = 0;
    v2.reloc_metas = 0 as *mut LinkV2RelocMeta;
    v2.num_reloc_metas = 0;
    v2.cap_reloc_metas = 0;
}

unsafe fn v2_sym_slot_ptr(base: *mut LinkV2SymMeta, idx: usize) -> *mut LinkV2SymMeta {
    ((base as usize) + coff_mul_usize(idx, size_of<LinkV2SymMeta>())) as *mut LinkV2SymMeta
}

unsafe fn v2_reloc_slot_ptr(base: *mut LinkV2RelocMeta, idx: usize) -> *mut LinkV2RelocMeta {
    ((base as usize) + coff_mul_usize(idx, size_of<LinkV2RelocMeta>())) as *mut LinkV2RelocMeta
}

pub fn link_v2_sym_at(v2: view<LinkV2Context>, idx: usize) -> *mut LinkV2SymMeta {
    if idx >= v2.num_syms || (v2.syms as usize) == 0 {
        return 0 as *mut LinkV2SymMeta;
    }
    unsafe { v2_sym_slot_ptr(v2.syms, idx) }
}

pub fn link_v2_add_sym_meta(
    v2: mut_view<LinkV2Context>,
    sym_name: *const u8,
    demangled: *const u8,
    obj_name: *const u8,
    abi_sig: *const u8,
    ref_fn: *const u8,
    entry_kind: u8,
    binding: u8,
    abi_kind: u8,
    calling_conv: u8,
    param_count: u32,
    ret_size: u32,
    file_id: u32,
    span_start: u32,
    span_end: u32
) -> *mut LinkV2SymMeta {
    if v2.num_syms == v2.cap_syms {
        let new_cap = if v2.cap_syms == 0 { 32 } else { v2.cap_syms + v2.cap_syms };
        let new_bytes = coff_mul_usize(new_cap, size_of<LinkV2SymMeta>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<LinkV2SymMeta>()) as *mut LinkV2SymMeta };
        if v2.num_syms > 0 && (v2.syms as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    v2.syms as *const u8,
                    new_arr as *mut u8,
                    coff_mul_usize(v2.num_syms, size_of<LinkV2SymMeta>())
                );
                heap_free(
                    v2.syms as *mut u8,
                    coff_mul_usize(v2.cap_syms, size_of<LinkV2SymMeta>()),
                    align_of<LinkV2SymMeta>()
                );
            }
        }
        v2.syms = new_arr;
        v2.cap_syms = new_cap;
    }
    let slot = unsafe { v2_sym_slot_ptr(v2.syms, v2.num_syms) };
    unsafe {
        *slot = LinkV2SymMeta {
            sym_name: sym_name,
            demangled: demangled,
            obj_name: obj_name,
            abi_sig: abi_sig,
            ref_fn: ref_fn,
            entry_kind: entry_kind,
            binding: binding,
            abi_kind: abi_kind,
            calling_conv: calling_conv,
            param_count: param_count,
            ret_size: ret_size,
            file_id: file_id,
            span_start: span_start,
            span_end: span_end,
        };
    }
    v2.num_syms = v2.num_syms + 1;
    slot
}

pub fn link_v2_find_def_meta(v2: view<LinkV2Context>, sym_name: *const u8) -> *mut LinkV2SymMeta {
    if (sym_name as usize) == 0 || (v2.syms as usize) == 0 {
        return 0 as *mut LinkV2SymMeta;
    }
    let mut i: usize = 0;
    while i < v2.num_syms {
        let m = unsafe { v2_sym_slot_ptr(v2.syms, i) };
        if (unsafe { (*m).entry_kind }) == AXMETA_ENTRY_DEF &&
           (unsafe { (*m).sym_name as usize }) != 0 &&
           cstr_eq(unsafe { (*m).sym_name }, sym_name) {
            return m;
        }
        i = i + 1;
    }
    0 as *mut LinkV2SymMeta
}

pub fn link_v2_find_def_meta_in_obj(
    v2: view<LinkV2Context>,
    sym_name: *const u8,
    obj_name: *const u8
) -> *mut LinkV2SymMeta {
    if (sym_name as usize) == 0 || (v2.syms as usize) == 0 {
        return 0 as *mut LinkV2SymMeta;
    }
    let mut i: usize = 0;
    while i < v2.num_syms {
        let m = unsafe { v2_sym_slot_ptr(v2.syms, i) };
        if (unsafe { (*m).entry_kind }) == AXMETA_ENTRY_DEF &&
           (unsafe { (*m).sym_name as usize }) != 0 &&
           cstr_eq(unsafe { (*m).sym_name }, sym_name) {
            if (obj_name as usize) == 0 ||
               ((unsafe { (*m).obj_name as usize }) != 0 && cstr_eq(unsafe { (*m).obj_name }, obj_name)) {
                return m;
            }
        }
        i = i + 1;
    }
    0 as *mut LinkV2SymMeta
}

pub fn link_v2_find_ref_meta(
    v2: view<LinkV2Context>,
    sym_name: *const u8,
    obj_name: *const u8
) -> *mut LinkV2SymMeta {
    if (sym_name as usize) == 0 || (v2.syms as usize) == 0 {
        return 0 as *mut LinkV2SymMeta;
    }
    let mut fallback: *mut LinkV2SymMeta = 0 as *mut LinkV2SymMeta;
    let mut i: usize = 0;
    while i < v2.num_syms {
        let m = unsafe { v2_sym_slot_ptr(v2.syms, i) };
        if (unsafe { (*m).entry_kind }) == AXMETA_ENTRY_REF &&
           (unsafe { (*m).sym_name as usize }) != 0 &&
           cstr_eq(unsafe { (*m).sym_name }, sym_name) {
            if (obj_name as usize) != 0 &&
               (unsafe { (*m).obj_name as usize }) != 0 &&
               cstr_eq(unsafe { (*m).obj_name }, obj_name) {
                return m;
            }
            if (fallback as usize) == 0 {
                fallback = m;
            }
        }
        i = i + 1;
    }
    fallback
}

pub fn link_v2_add_reloc_meta(
    v2: mut_view<LinkV2Context>,
    reloc_idx: usize,
    obj_name: *const u8,
    sec_name: *const u8,
    ref_fn: *const u8,
    file_id: u32,
    span_start: u32,
    span_end: u32
) {
    if v2.num_reloc_metas == v2.cap_reloc_metas {
        let new_cap = if v2.cap_reloc_metas == 0 { 32 } else { v2.cap_reloc_metas + v2.cap_reloc_metas };
        let new_bytes = coff_mul_usize(new_cap, size_of<LinkV2RelocMeta>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<LinkV2RelocMeta>()) as *mut LinkV2RelocMeta };
        if v2.num_reloc_metas > 0 && (v2.reloc_metas as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    v2.reloc_metas as *const u8,
                    new_arr as *mut u8,
                    coff_mul_usize(v2.num_reloc_metas, size_of<LinkV2RelocMeta>())
                );
                heap_free(
                    v2.reloc_metas as *mut u8,
                    coff_mul_usize(v2.cap_reloc_metas, size_of<LinkV2RelocMeta>()),
                    align_of<LinkV2RelocMeta>()
                );
            }
        }
        v2.reloc_metas = new_arr;
        v2.cap_reloc_metas = new_cap;
    }
    let slot = unsafe { v2_reloc_slot_ptr(v2.reloc_metas, v2.num_reloc_metas) };
    unsafe {
        *slot = LinkV2RelocMeta {
            reloc_idx: reloc_idx,
            obj_name: obj_name,
            sec_name: sec_name,
            ref_fn: ref_fn,
            file_id: file_id,
            span_start: span_start,
            span_end: span_end,
        };
    }
    v2.num_reloc_metas = v2.num_reloc_metas + 1;
}

pub fn link_v2_find_reloc_meta(v2: view<LinkV2Context>, reloc_idx: usize) -> *mut LinkV2RelocMeta {
    if (v2.reloc_metas as usize) == 0 {
        return 0 as *mut LinkV2RelocMeta;
    }
    let mut i: usize = 0;
    while i < v2.num_reloc_metas {
        let m = unsafe { v2_reloc_slot_ptr(v2.reloc_metas, i) };
        if (unsafe { (*m).reloc_idx }) == reloc_idx {
            return m;
        }
        i = i + 1;
    }
    0 as *mut LinkV2RelocMeta
}

fn pe_put_u32_decimal_to_buf(out: mut_view<CoffBuf>, val: u32) {
    if val == 0u32 {
        coff_buf_put_u8(mut_view(*out), 48u8);
        return;
    }
    let mut digits: [12]u8 = [0u8; 12];
    let mut n: usize = 0;
    let mut v: u32 = val;
    while v > 0u32 {
        digits[n] = (48u32 + (v % 10u32)) as u8;
        v = v / 10u32;
        n = n + 1;
    }
    while n > 0 {
        n = n - 1;
        coff_buf_put_u8(mut_view(*out), digits[n]);
    }
}

fn pe_is_prim_type_code(ptr: *const u8, len: usize) -> bool {
    if len == 2 {
        let b0 = unsafe { *ptr };
        let b1 = unsafe { *(ptr + 1) };
        if (b0 == 105u8 || b0 == 117u8) && b1 == 56u8 { // "i8", "u8"
            return true;
        }
    } else if len == 3 {
        let b0 = unsafe { *ptr };
        let b1 = unsafe { *(ptr + 1) };
        let b2 = unsafe { *(ptr + 2) };
        if (b0 == 105u8 || b0 == 117u8) &&
           ((b1 == 49u8 && b2 == 54u8) || (b1 == 51u8 && b2 == 50u8) || (b1 == 54u8 && b2 == 52u8)) {
            return true; // i16, u16, i32, u32, i64, u64
        }
        if b0 == 102u8 && ((b1 == 51u8 && b2 == 50u8) || (b1 == 54u8 && b2 == 52u8)) {
            return true; // f32, f64
        }
        if b0 == 115u8 && b1 == 116u8 && b2 == 114u8 {
            return true; // str
        }
    } else if len == 4 {
        let b0 = unsafe { *ptr };
        let b1 = unsafe { *(ptr + 1) };
        let b2 = unsafe { *(ptr + 2) };
        let b3 = unsafe { *(ptr + 3) };
        if b0 == 98u8 && b1 == 111u8 && b2 == 111u8 && b3 == 108u8 {
            return true; // bool
        }
        if b0 == 117u8 && b1 == 110u8 && b2 == 105u8 && b3 == 116u8 {
            return true; // unit
        }
    } else if len == 5 {
        let b0 = unsafe { *ptr };
        let b1 = unsafe { *(ptr + 1) };
        let b2 = unsafe { *(ptr + 2) };
        let b3 = unsafe { *(ptr + 3) };
        let b4 = unsafe { *(ptr + 4) };
        if (b0 == 117u8 || b0 == 105u8) && b1 == 115u8 && b2 == 105u8 && b3 == 122u8 && b4 == 101u8 {
            return true; // usize, isize
        }
    }
    false
}

// SPEC-27 §5.2 (AXS-LNK-011): Deterministic `_AX1_` symbol mangler.
// Converts canonical Axiom path `pkg.mod.item` or `pkg.mod.item<T1, T2>` into `_AX1_<len><seg>...[_G<n>_<t1>...]`.
pub fn pe_mangle_ax1_symbol(path_ptr: *const u8, path_len: usize, out: mut_view<CoffBuf>) {
    coff_buf_clear(mut_view(*out));
    if (path_ptr as usize) == 0 || path_len == 0 {
        return;
    }
    // "_AX1"
    coff_buf_put_u8(mut_view(*out), 95u8);
    coff_buf_put_u8(mut_view(*out), 65u8);
    coff_buf_put_u8(mut_view(*out), 88u8);
    coff_buf_put_u8(mut_view(*out), 49u8);

    let mut lt_pos: usize = path_len;
    let mut i: usize = 0;
    while i < path_len {
        if (unsafe { *(path_ptr + i) }) == 60u8 { // '<'
            lt_pos = i;
            break;
        }
        i = i + 1;
    }

    let mut seg_start: usize = 0;
    let mut pos: usize = 0;
    while pos <= lt_pos {
        let is_end = pos == lt_pos;
        let ch = if is_end { 46u8 } else { unsafe { *(path_ptr + pos) } };
        if ch == 46u8 || ch == 36u8 { // '.' or '$'
            let seg_len = pos - seg_start;
            if seg_len > 0 {
                coff_buf_put_u8(mut_view(*out), 95u8); // '_'
                pe_put_u32_decimal_to_buf(mut_view(*out), seg_len as u32);
                coff_buf_put_bytes(mut_view(*out), unsafe { path_ptr + seg_start }, seg_len);
            }
            seg_start = pos + 1;
        }
        pos = pos + 1;
    }

    if lt_pos < path_len && (unsafe { *(path_ptr + path_len - 1) }) == 62u8 { // '>'
        let gen_start = lt_pos + 1;
        let gen_end = path_len - 1;
        if gen_end > gen_start {
            let mut arg_count: u32 = 1u32;
            let mut k: usize = gen_start;
            while k < gen_end {
                if (unsafe { *(path_ptr + k) }) == 44u8 { // ','
                    arg_count = arg_count + 1u32;
                }
                k = k + 1;
            }
            coff_buf_put_u8(mut_view(*out), 95u8); // '_'
            coff_buf_put_u8(mut_view(*out), 71u8); // 'G'
            pe_put_u32_decimal_to_buf(mut_view(*out), arg_count);

            let mut a_start: usize = gen_start;
            let mut a_pos: usize = gen_start;
            while a_pos <= gen_end {
                let is_a_end = a_pos == gen_end;
                let ach = if is_a_end { 44u8 } else { unsafe { *(path_ptr + a_pos) } };
                if ach == 44u8 {
                    let mut ts = a_start;
                    let mut te = a_pos;
                    while ts < te && (unsafe { *(path_ptr + ts) }) == 32u8 {
                        ts = ts + 1;
                    }
                    while te > ts && (unsafe { *(path_ptr + te - 1) }) == 32u8 {
                        te = te - 1;
                    }
                    let tlen = te - ts;
                    if tlen > 0 {
                        let tptr = unsafe { path_ptr + ts };
                        coff_buf_put_u8(mut_view(*out), 95u8); // '_'
                        if !pe_is_prim_type_code(tptr, tlen) {
                            pe_put_u32_decimal_to_buf(mut_view(*out), tlen as u32);
                        }
                        coff_buf_put_bytes(mut_view(*out), tptr, tlen);
                    }
                    a_start = a_pos + 1;
                }
                a_pos = a_pos + 1;
            }
        }
    }
}

// SPEC-27 §5.2 (AXS-LNK-011): Lossless `_AX1_` and internal `$` symbol demangler.
// Always formats Axiom paths using canonical `.` and `<T>` syntax (never `::`).
pub fn pe_demangle_symbol(mangled_ptr: *const u8, mangled_len: usize, out: mut_view<CoffBuf>) {
    coff_buf_clear(mut_view(*out));
    if (mangled_ptr as usize) == 0 || mangled_len == 0 {
        return;
    }

    // Check `_AX1_` prefix
    if mangled_len > 5 &&
       (unsafe { *mangled_ptr }) == 95u8 &&
       (unsafe { *(mangled_ptr + 1) }) == 65u8 &&
       (unsafe { *(mangled_ptr + 2) }) == 88u8 &&
       (unsafe { *(mangled_ptr + 3) }) == 49u8 &&
       (unsafe { *(mangled_ptr + 4) }) == 95u8 {
        let mut pos: usize = 5;
        let mut first_seg: bool = true;
        while pos < mangled_len {
            let ch = unsafe { *(mangled_ptr + pos) };
            if ch == 95u8 { // '_'
                pos = pos + 1;
                continue;
            }
            if ch == 71u8 && pos + 1 < mangled_len { // 'G' generic instantiation
                let next_ch = unsafe { *(mangled_ptr + pos + 1) };
                if next_ch >= 48u8 && next_ch <= 57u8 {
                    pos = pos + 1;
                    let mut gcount: usize = 0;
                    while pos < mangled_len {
                        let d = unsafe { *(mangled_ptr + pos) };
                        if d < 48u8 || d > 57u8 {
                            break;
                        }
                        gcount = coff_mul_usize(gcount, 10) + ((d - 48u8) as usize);
                        pos = pos + 1;
                    }
                    coff_buf_put_u8(mut_view(*out), 60u8); // '<'
                    let mut g: usize = 0;
                    while g < gcount && pos < mangled_len {
                        if (unsafe { *(mangled_ptr + pos) }) == 95u8 {
                            pos = pos + 1;
                        }
                        if g > 0 {
                            coff_buf_put_u8(mut_view(*out), 44u8); // ','
                            coff_buf_put_u8(mut_view(*out), 32u8); // ' '
                        }
                        let c0 = unsafe { *(mangled_ptr + pos) };
                        if c0 >= 49u8 && c0 <= 57u8 {
                            let mut tlen: usize = 0;
                            while pos < mangled_len {
                                let d = unsafe { *(mangled_ptr + pos) };
                                if d < 48u8 || d > 57u8 {
                                    break;
                                }
                                tlen = coff_mul_usize(tlen, 10) + ((d - 48u8) as usize);
                                pos = pos + 1;
                            }
                            if pos + tlen <= mangled_len {
                                coff_buf_put_bytes(mut_view(*out), unsafe { mangled_ptr + pos }, tlen);
                                pos = pos + tlen;
                            } else {
                                break;
                            }
                        } else {
                            let tstart = pos;
                            while pos < mangled_len && (unsafe { *(mangled_ptr + pos) }) != 95u8 {
                                pos = pos + 1;
                            }
                            if pos > tstart {
                                coff_buf_put_bytes(mut_view(*out), unsafe { mangled_ptr + tstart }, pos - tstart);
                            }
                        }
                        g = g + 1;
                    }
                    coff_buf_put_u8(mut_view(*out), 62u8); // '>'
                    return;
                }
            }
            if ch >= 49u8 && ch <= 57u8 {
                let mut slen: usize = 0;
                while pos < mangled_len {
                    let d = unsafe { *(mangled_ptr + pos) };
                    if d < 48u8 || d > 57u8 {
                        break;
                    }
                    slen = coff_mul_usize(slen, 10) + ((d - 48u8) as usize);
                    pos = pos + 1;
                }
                if slen > 0 && pos + slen <= mangled_len {
                    if !first_seg {
                        coff_buf_put_u8(mut_view(*out), 46u8); // '.'
                    }
                    coff_buf_put_bytes(mut_view(*out), unsafe { mangled_ptr + pos }, slen);
                    pos = pos + slen;
                    first_seg = false;
                } else {
                    break;
                }
            } else {
                break;
            }
        }
        if out.len > 0 {
            return;
        }
    }

    // Internal compiler `$` separator (e.g. `math$add` -> `math.add`, excluding DLL import `KERNEL32.dll$...`)
    let mut has_dollar: bool = false;
    let mut has_dot_dll: bool = false;
    let mut k: usize = 0;
    while k < mangled_len {
        let b = unsafe { *(mangled_ptr + k) };
        if b == 36u8 { // '$'
            has_dollar = true;
            if k >= 4 {
                let d0 = unsafe { *(mangled_ptr + k - 4) };
                let d1 = (unsafe { *(mangled_ptr + k - 3) }) | 32u8;
                let d2 = (unsafe { *(mangled_ptr + k - 2) }) | 32u8;
                let d3 = (unsafe { *(mangled_ptr + k - 1) }) | 32u8;
                if d0 == 46u8 && d1 == 100u8 && d2 == 108u8 && d3 == 108u8 {
                    has_dot_dll = true;
                }
            }
        }
        k = k + 1;
    }

    if has_dollar && !has_dot_dll {
        let mut idx: usize = 0;
        while idx < mangled_len {
            let b = unsafe { *(mangled_ptr + idx) };
            if b == 36u8 {
                coff_buf_put_u8(mut_view(*out), 46u8); // '.'
            } else {
                coff_buf_put_u8(mut_view(*out), b);
            }
            idx = idx + 1;
        }
        return;
    }

    coff_buf_put_bytes(mut_view(*out), mangled_ptr, mangled_len);
}

pub fn pe_demangle_cstr_in_ctx(ctx: mut_view<LinkerContext>, sym_name: *const u8) -> *const u8 {
    if (sym_name as usize) == 0 {
        return sym_name;
    }
    let slen = cstr_len(sym_name);
    let mut buf = coff_buf_with_capacity(slen + 16);
    pe_demangle_symbol(sym_name, slen, mut_view(buf));
    let res = linker_dup_bytes(mut_view(*ctx), buf.ptr as *const u8, buf.len);
    coff_buf_free(mut_view(buf));
    res
}

// `.axmeta` Binary Section Writer Helpers (SPEC-27 §4)
pub fn axmeta_put_header(
    buf: mut_view<CoffBuf>,
    machine: u16,
    abi_id: u16,
    obj_name_ptr: *const u8,
    obj_name_len: usize,
    triple_ptr: *const u8,
    triple_len: usize,
    num_entries: u32
) {
    // Magic "AXM1"
    coff_buf_put_u8(mut_view(*buf), 65u8);
    coff_buf_put_u8(mut_view(*buf), 88u8);
    coff_buf_put_u8(mut_view(*buf), 77u8);
    coff_buf_put_u8(mut_view(*buf), 49u8);
    coff_buf_put_u32(mut_view(*buf), AXMETA_VERSION);
    coff_buf_put_u16(mut_view(*buf), machine);
    coff_buf_put_u16(mut_view(*buf), abi_id);
    coff_buf_put_u32(mut_view(*buf), obj_name_len as u32);
    coff_buf_put_u32(mut_view(*buf), triple_len as u32);
    coff_buf_put_u32(mut_view(*buf), num_entries);
    if obj_name_len > 0 && (obj_name_ptr as usize) != 0 {
        coff_buf_put_bytes(mut_view(*buf), obj_name_ptr, obj_name_len);
    }
    if triple_len > 0 && (triple_ptr as usize) != 0 {
        coff_buf_put_bytes(mut_view(*buf), triple_ptr, triple_len);
    }
}

pub fn axmeta_put_entry(
    buf: mut_view<CoffBuf>,
    sym_ptr: *const u8,
    sym_len: usize,
    dem_ptr: *const u8,
    dem_len: usize,
    sig_ptr: *const u8,
    sig_len: usize,
    ref_fn_ptr: *const u8,
    ref_fn_len: usize,
    entry_kind: u8,
    binding: u8,
    abi_kind: u8,
    calling_conv: u8,
    param_count: u32,
    ret_size: u32,
    file_id: u32,
    span_start: u32,
    span_end: u32
) {
    coff_buf_put_u32(mut_view(*buf), sym_len as u32);
    coff_buf_put_u32(mut_view(*buf), dem_len as u32);
    coff_buf_put_u32(mut_view(*buf), sig_len as u32);
    coff_buf_put_u32(mut_view(*buf), ref_fn_len as u32);
    coff_buf_put_u8(mut_view(*buf), entry_kind);
    coff_buf_put_u8(mut_view(*buf), binding);
    coff_buf_put_u8(mut_view(*buf), abi_kind);
    coff_buf_put_u8(mut_view(*buf), calling_conv);
    coff_buf_put_u32(mut_view(*buf), param_count);
    coff_buf_put_u32(mut_view(*buf), ret_size);
    coff_buf_put_u32(mut_view(*buf), file_id);
    coff_buf_put_u32(mut_view(*buf), span_start);
    coff_buf_put_u32(mut_view(*buf), span_end);
    if sym_len > 0 && (sym_ptr as usize) != 0 {
        coff_buf_put_bytes(mut_view(*buf), sym_ptr, sym_len);
    }
    if dem_len > 0 && (dem_ptr as usize) != 0 {
        coff_buf_put_bytes(mut_view(*buf), dem_ptr, dem_len);
    }
    if sig_len > 0 && (sig_ptr as usize) != 0 {
        coff_buf_put_bytes(mut_view(*buf), sig_ptr, sig_len);
    }
    if ref_fn_len > 0 && (ref_fn_ptr as usize) != 0 {
        coff_buf_put_bytes(mut_view(*buf), ref_fn_ptr, ref_fn_len);
    }
}

