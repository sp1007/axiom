@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

unsafe fn lnk_ptr_from_mut<T>(v: mut_view<T>) -> *mut T {
    address_of_mut(*v)
}

// --- Linker Diagnostic Reporting Helpers ---

pub fn linker_report_diag(diag: *mut DiagSink, code_v: u32, msg_ptr: *const u8, msg_len: usize) {
    if (diag as usize) == 0 {
        return;
    }
    let d = Diagnostic {
        code: diag_code(code_v),
        severity: DiagSeverity.Error,
        message: StrView { ptr: msg_ptr, len: msg_len },
        primary: span_none(),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(unsafe { mut_view(*diag) }, view(d));
}

pub fn linker_report_bad_object(diag: *mut DiagSink) {
    let msg: [11]u8 = [98u8, 97u8, 100u8, 32u8, 111u8, 98u8, 106u8, 101u8, 99u8, 116u8, 0u8]; // "bad object"
    let pmsg = unsafe { address_of(msg[0]) };
    linker_report_diag(diag, AX_LINK_BAD_OBJECT, pmsg, 10);
}

pub fn linker_report_bad_archive(diag: *mut DiagSink) {
    let msg: [12]u8 = [98u8, 97u8, 100u8, 32u8, 97u8, 114u8, 99u8, 104u8, 105u8, 118u8, 101u8, 0u8]; // "bad archive"
    let pmsg = unsafe { address_of(msg[0]) };
    linker_report_diag(diag, AX_LINK_BAD_ARCHIVE, pmsg, 11);
}

pub fn linker_report_library_not_found(diag: *mut DiagSink, lib_name: *const u8) {
    if (diag as usize) == 0 {
        return;
    }
    let prefix: [19]u8 = [
        108u8, 105u8, 98u8, 114u8, 97u8, 114u8, 121u8, 32u8, 110u8, 111u8,
        116u8, 32u8, 102u8, 111u8, 117u8, 110u8, 100u8, 58u8, 32u8,
    ]; // "library not found: "
    let key_bytes: [8]u8 = [108u8, 105u8, 98u8, 114u8, 97u8, 114u8, 121u8, 0u8]; // "library"
    let p_prefix = unsafe { address_of(prefix[0]) };
    let p_key = unsafe { address_of(key_bytes[0]) };
    let slen = cstr_len(lib_name);
    let mut buf = coff_buf_with_capacity(19 + slen + 1);
    coff_buf_put_bytes(mut_view(buf), p_prefix, 19);
    coff_buf_put_bytes(mut_view(buf), lib_name, slen);
    let msg_len = buf.len;
    coff_buf_put_u8(mut_view(buf), 0u8);
    let mut entry: [1]DiagDataEntry = [DiagDataEntry {
        key: StrView { ptr: p_key, len: 7 },
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: StrView { ptr: lib_name, len: slen },
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0,
        },
    }];
    let p_entry = unsafe { address_of(entry[0]) as *mut DiagDataEntry };
    let d = Diagnostic {
        code: diag_code(AX_LINK_LIBRARY_NOT_FOUND),
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf.ptr as *const u8, len: msg_len },
        primary: span_none(),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: p_entry,
        data_count: 1,
    };
    diag_sink_report(unsafe { mut_view(*diag) }, view(d));
    coff_buf_free(mut_view(buf));
}

pub fn linker_report_duplicate_symbol(diag: *mut DiagSink, sym_name: *const u8) {
    if (diag as usize) == 0 {
        return;
    }
    let prefix: [18]u8 = [
        100u8, 117u8, 112u8, 108u8, 105u8, 99u8, 97u8, 116u8, 101u8, 32u8,
        115u8, 121u8, 109u8, 98u8, 111u8, 108u8, 58u8, 32u8,
    ]; // "duplicate symbol: "
    let p_prefix = unsafe { address_of(prefix[0]) };
    let slen = cstr_len(sym_name);
    let mut buf = coff_buf_with_capacity(18 + slen + 1);
    coff_buf_put_bytes(mut_view(buf), p_prefix, 18);
    coff_buf_put_bytes(mut_view(buf), sym_name, slen);
    let msg_len = buf.len;
    coff_buf_put_u8(mut_view(buf), 0u8);
    linker_report_diag(diag, AX_LINK_DUPLICATE_SYMBOL, buf.ptr as *const u8, msg_len);
    coff_buf_free(mut_view(buf));
}

pub fn linker_report_undefined_symbol(diag: *mut DiagSink, sym_name: *const u8) {
    linker_report_diag(diag, AX_LINK_UNDEFINED_SYMBOL, sym_name, cstr_len(sym_name));
}

pub fn linker_report_duplicate_export(diag: *mut DiagSink, sym_name: *const u8) {
    if (diag as usize) == 0 {
        return;
    }
    let prefix: [18]u8 = [
        100u8, 117u8, 112u8, 108u8, 105u8, 99u8, 97u8, 116u8, 101u8, 32u8,
        101u8, 120u8, 112u8, 111u8, 114u8, 116u8, 58u8, 32u8,
    ]; // "duplicate export: "
    let key_bytes: [7]u8 = [115u8, 121u8, 109u8, 98u8, 111u8, 108u8, 0u8]; // "symbol"
    let p_prefix = unsafe { address_of(prefix[0]) };
    let p_key = unsafe { address_of(key_bytes[0]) };
    let slen = cstr_len(sym_name);
    let mut buf = coff_buf_with_capacity(18 + slen + 1);
    coff_buf_put_bytes(mut_view(buf), p_prefix, 18);
    coff_buf_put_bytes(mut_view(buf), sym_name, slen);
    let msg_len = buf.len;
    coff_buf_put_u8(mut_view(buf), 0u8);
    let mut entry: [1]DiagDataEntry = [DiagDataEntry {
        key: StrView { ptr: p_key, len: 6 },
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: StrView { ptr: sym_name, len: slen },
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0,
        },
    }];
    let p_entry = unsafe { address_of(entry[0]) as *mut DiagDataEntry };
    let d = Diagnostic {
        code: diag_code(AX_LINK_DUPLICATE_EXPORT),
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf.ptr as *const u8, len: msg_len },
        primary: span_none(),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: p_entry,
        data_count: 1,
    };
    diag_sink_report(unsafe { mut_view(*diag) }, view(d));
    coff_buf_free(mut_view(buf));
}

pub fn linker_diag_code_at(sink: view<DiagSink>, idx: usize) -> u32 {
    if idx >= sink.len || (sink.diags as usize) == 0 {
        return 0u32;
    }
    let d_ptr = ((sink.diags as usize) + coff_mul_usize(idx, size_of<Diagnostic>())) as *const Diagnostic;
    unsafe { (*d_ptr).code.v }
}

pub fn linker_diag_message_at(sink: view<DiagSink>, idx: usize) -> StrView {
    if idx >= sink.len || (sink.diags as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let d_ptr = ((sink.diags as usize) + coff_mul_usize(idx, size_of<Diagnostic>())) as *const Diagnostic;
    unsafe { (*d_ptr).message }
}

// --- COFF Object File Loader & Section/Symbol/Relocation Merger ---

unsafe fn u32_slot_ptr(base: *mut u32, idx: usize) -> *mut u32 {
    ((base as usize) + coff_mul_usize(idx, size_of<u32>())) as *mut u32
}

unsafe fn cstr_slot_ptr(base: *mut *const u8, idx: usize) -> *mut *const u8 {
    ((base as usize) + coff_mul_usize(idx, size_of<*const u8>())) as *mut *const u8
}

unsafe fn msec_slot_ptr(base: *mut *mut MergedSection, idx: usize) -> *mut *mut MergedSection {
    ((base as usize) + coff_mul_usize(idx, size_of<*mut MergedSection>())) as *mut *mut MergedSection
}

unsafe fn free_sym_target_arrays(sym_secs: *mut *mut MergedSection, sym_offs: *mut u32, cap: usize) {
    heap_free(sym_secs as *mut u8, coff_mul_usize(cap, size_of<*mut MergedSection>()), align_of<*mut MergedSection>());
    heap_free(sym_offs as *mut u8, coff_mul_usize(cap, size_of<u32>()), align_of<u32>());
}

fn read_cstr_at_offset(buf: *const u8, buf_len: usize, off: usize, out_len: mut_view<usize>) -> *const u8 {
    if off >= buf_len {
        *out_len = 0;
        return 0 as *const u8;
    }
    let mut n: usize = 0;
    while off + n < buf_len {
        if (unsafe { *(buf + off + n) }) == 0u8 {
            break;
        }
        n = n + 1;
    }
    *out_len = n;
    unsafe { buf + off }
}

fn strip_opt_quotes(ptr: *const u8, len: usize, out_len: mut_view<usize>) -> *const u8 {
    if len >= 2 && (unsafe { *ptr }) == 34u8 && (unsafe { *(ptr + len - 1) }) == 34u8 {
        *out_len = len - 2;
        return unsafe { ptr + 1 };
    }
    *out_len = len;
    ptr
}

fn linker_parse_drectve_token(
    dll_state: mut_view<DllLinkState>,
    ctx: mut_view<LinkerContext>,
    tok_ptr: *const u8,
    tok_len: usize
) {
    if tok_len <= 8 {
        return;
    }
    let c0 = unsafe { *tok_ptr };
    if c0 != 45u8 && c0 != 47u8 { // '-' or '/'
        return;
    }
    let exp_prefix: [7]u8 = [101u8, 120u8, 112u8, 111u8, 114u8, 116u8, 58u8]; // "export:"
    if !pe_bytes_ieq(unsafe { tok_ptr + 1 }, 7, unsafe { address_of(exp_prefix[0]) }, 7) {
        return;
    }
    let spec_ptr = unsafe { tok_ptr + 8 };
    let spec_len = tok_len - 8;
    if spec_len == 0 {
        return;
    }

    // Split at first ',' to separate `<name>[=<internal>]` from optional `,DATA`
    let mut comma_idx: usize = spec_len;
    let mut i: usize = 0;
    while i < spec_len {
        if (unsafe { *(spec_ptr + i) }) == 44u8 { // ','
            comma_idx = i;
            break;
        }
        i = i + 1;
    }

    let mut is_data: bool = false;
    if comma_idx + 1 < spec_len {
        let attr_ptr = unsafe { spec_ptr + comma_idx + 1 };
        let attr_rem = spec_len - (comma_idx + 1);
        let mut attr_len: usize = 0;
        while attr_len < attr_rem && (unsafe { *(attr_ptr + attr_len) }) != 44u8 {
            attr_len = attr_len + 1;
        }
        let data_kw: [4]u8 = [100u8, 97u8, 116u8, 97u8]; // "data"
        if attr_len == 4 && pe_bytes_ieq(attr_ptr, 4, unsafe { address_of(data_kw[0]) }, 4) {
            is_data = true;
        }
    }

    let names_len = comma_idx;
    if names_len == 0 {
        return;
    }

    let mut eq_idx: usize = names_len;
    i = 0;
    while i < names_len {
        if (unsafe { *(spec_ptr + i) }) == 61u8 { // '='
            eq_idx = i;
            break;
        }
        i = i + 1;
    }

    let mut ext_len: usize = 0;
    let ext_ptr = strip_opt_quotes(spec_ptr, eq_idx, mut_view(ext_len));
    let mut int_len: usize = 0;
    let int_ptr = if eq_idx < names_len {
        strip_opt_quotes(unsafe { spec_ptr + eq_idx + 1 }, names_len - (eq_idx + 1), mut_view(int_len))
    } else {
        int_len = ext_len;
        ext_ptr
    };

    if ext_len > 0 {
        dll_state_add_export(dll_state, ctx, ext_ptr, ext_len, int_ptr, int_len, is_data);
    }
}

pub fn linker_parse_drectve_exports(
    dll_state: mut_view<DllLinkState>,
    ctx: mut_view<LinkerContext>,
    buf: *const u8,
    len: usize
) {
    if (buf as usize) == 0 || len == 0 {
        return;
    }
    let mut i: usize = 0;
    // Skip UTF-8 BOM if present (`EF BB BF`)
    if len >= 3 && (unsafe { *buf }) == 0xEFu8 && (unsafe { *(buf + 1) }) == 0xBBu8 && (unsafe { *(buf + 2) }) == 0xBFu8 {
        i = 3;
    }
    while i < len {
        let ch = unsafe { *(buf + i) };
        if ch == 0u8 || ch <= 32u8 {
            i = i + 1;
            continue;
        }
        let start = i;
        let mut in_quotes: bool = false;
        while i < len {
            let b = unsafe { *(buf + i) };
            if b == 0u8 {
                break;
            }
            if b == 34u8 { // '"'
                in_quotes = !in_quotes;
                i = i + 1;
                continue;
            }
            if !in_quotes && b <= 32u8 {
                break;
            }
            i = i + 1;
        }
        if i > start {
            linker_parse_drectve_token(mut_view(*dll_state), mut_view(*ctx), unsafe { buf + start }, i - start);
        }
    }
}

// Parses a single COFF `.obj` image in memory (`obj_ptr`, `obj_len`) and merges its sections,
// symbols, and relocations into `ctx`.
pub fn linker_load_coff_object(ctx: mut_view<LinkerContext>, obj_ptr: *const u8, obj_len: usize, diag: *mut DiagSink) -> bool {
    linker_load_coff_object_ex(ctx, obj_ptr, obj_len, 0 as *mut DllLinkState, diag)
}

pub fn linker_load_coff_object_ex(
    ctx: mut_view<LinkerContext>,
    obj_ptr: *const u8,
    obj_len: usize,
    dll_state: *mut DllLinkState,
    diag: *mut DiagSink
) -> bool {
    if (obj_ptr as usize) == 0 || obj_len < COFF_FILE_HEADER_SIZE {
        linker_report_bad_object(diag);
        return false;
    }

    let hdr = coff_decode_file_header(obj_ptr, 0);
    if hdr.machine != IMAGE_FILE_MACHINE_AMD64 {
        linker_report_bad_object(diag);
        return false;
    }

    let num_secs: usize = hdr.number_of_sections as usize;
    let shdr_table_end: usize = COFF_FILE_HEADER_SIZE + coff_mul_usize(num_secs, COFF_SECTION_HEADER_SIZE);
    if shdr_table_end > obj_len {
        linker_report_bad_object(diag);
        return false;
    }

    let num_syms: usize = hdr.number_of_symbols as usize;
    let sym_table_off: usize = hdr.pointer_to_symbol_table as usize;
    let str_table_offset: usize = sym_table_off + coff_mul_usize(num_syms, COFF_SYMBOL_SIZE);
    if num_syms > 0 && str_table_offset > obj_len {
        linker_report_bad_object(diag);
        return false;
    }

    let sec_slots_count: usize = num_secs + 1;
    let obj_merged_secs = unsafe {
        heap_alloc(coff_mul_usize(sec_slots_count, size_of<*mut MergedSection>()), align_of<*mut MergedSection>()) as *mut *mut MergedSection
    };
    let obj_sec_offsets = unsafe {
        heap_alloc(coff_mul_usize(sec_slots_count, size_of<u32>()), align_of<u32>()) as *mut u32
    };
    unsafe {
        *(merged_sec_slot_ptr(obj_merged_secs, 0)) = 0 as *mut MergedSection;
        *(u32_slot_ptr(obj_sec_offsets, 0)) = 0u32;
    }

    // 1. Merge Sections
    let mut s: usize = 0;
    while s < num_secs {
        let shdr = coff_decode_section_header(obj_ptr, COFF_FILE_HEADER_SIZE + coff_mul_usize(s, COFF_SECTION_HEADER_SIZE));
        let mut sec_name: [9]u8 = [0u8; 9];

        if shdr.name[0] == 47u8 { // '/'
            let p_digits = unsafe { address_of(shdr.name[1]) };
            let str_off = pe_parse_u32_decimal(p_digits, 7) as usize;
            let mut slen: usize = 0;
            let sptr = read_cstr_at_offset(obj_ptr, obj_len, str_table_offset + str_off, mut_view(slen));
            let copy_len = if slen > 8 { 8 } else { slen };
            let mut k: usize = 0;
            while k < copy_len {
                sec_name[k] = unsafe { *(sptr + k) };
                k = k + 1;
            }
        } else {
            let mut k: usize = 0;
            while k < 8 {
                let ch = shdr.name[k];
                if ch == 0u8 {
                    break;
                }
                sec_name[k] = ch;
                k = k + 1;
            }
        }

        let raw_size: u32 = shdr.size_of_raw_data;
        let raw_ptr_off: u32 = shdr.pointer_to_raw_data;
        if (dll_state as usize) != 0 && raw_size > 0u32 && raw_ptr_off > 0u32 {
            let is_drectve = sec_name[0] == 46u8 && sec_name[1] == 100u8 && sec_name[2] == 114u8 &&
                sec_name[3] == 101u8 && sec_name[4] == 99u8 && sec_name[5] == 116u8 &&
                sec_name[6] == 118u8 && sec_name[7] == 101u8 && sec_name[8] == 0u8;
            if is_drectve && (raw_ptr_off as usize) + (raw_size as usize) <= obj_len {
                linker_parse_drectve_exports(
                    unsafe { mut_view(*dll_state) },
                    mut_view(*ctx),
                    unsafe { obj_ptr + (raw_ptr_off as usize) },
                    raw_size as usize
                );
            }
        }
        let non_loadable: bool = (shdr.characteristics & 0x02000A00u32) != 0u32;
        if non_loadable || (raw_size == 0u32 && shdr.virtual_size == 0u32) {
            unsafe {
                *(merged_sec_slot_ptr(obj_merged_secs, s + 1)) = 0 as *mut MergedSection;
                *(u32_slot_ptr(obj_sec_offsets, s + 1)) = 0u32;
            }
            s = s + 1;
            continue;
        }

        let p_sec_name = unsafe { address_of(sec_name[0]) };
        let msec = linker_get_or_create_section(mut_view(*ctx), p_sec_name, shdr.characteristics);
        unsafe {
            *(merged_sec_slot_ptr(obj_merged_secs, s + 1)) = msec;
        }

        let mut data_ptr: *const u8 = 0 as *const u8;
        if raw_size > 0u32 && raw_ptr_off > 0u32 {
            let end_off: usize = (raw_ptr_off as usize) + (raw_size as usize);
            if end_off > obj_len {
                unsafe {
                    heap_free(obj_merged_secs as *mut u8, coff_mul_usize(sec_slots_count, size_of<*mut MergedSection>()), align_of<*mut MergedSection>());
                    heap_free(obj_sec_offsets as *mut u8, coff_mul_usize(sec_slots_count, size_of<u32>()), align_of<u32>());
                }
                linker_report_bad_object(diag);
                return false;
            }
            data_ptr = unsafe { obj_ptr + (raw_ptr_off as usize) };
        }

        let align: u32 = pe_section_align_from_chars(shdr.characteristics);
        let mut out_off: [1]u32 = [0u32];
        let p_out_off = unsafe { address_of(out_off[0]) as *mut u32 };
        linker_append_section_data(msec, data_ptr, raw_size, align, p_out_off);
        unsafe {
            *(u32_slot_ptr(obj_sec_offsets, s + 1)) = out_off[0];
        }

        s = s + 1;
    }

    // 2. Parse Symbol Table
    let sym_names_cap: usize = if num_syms == 0 { 1 } else { num_syms };
    let sym_names = unsafe {
        heap_alloc(coff_mul_usize(sym_names_cap, size_of<*const u8>()), align_of<*const u8>()) as *mut *const u8
    };
    // Per-symbol definition (section + offset within the merged section), indexed by symbol-table index,
    // so same-object relocations bind by index and not by name (ADR-0035 section 2).
    let sym_secs = unsafe {
        heap_alloc(coff_mul_usize(sym_names_cap, size_of<*mut MergedSection>()), align_of<*mut MergedSection>()) as *mut *mut MergedSection
    };
    let sym_offs = unsafe {
        heap_alloc(coff_mul_usize(sym_names_cap, size_of<u32>()), align_of<u32>()) as *mut u32
    };
    let mut sym_idx: usize = 0;
    while sym_idx < sym_names_cap {
        unsafe {
            *(cstr_slot_ptr(sym_names, sym_idx)) = 0 as *const u8;
            *(msec_slot_ptr(sym_secs, sym_idx)) = 0 as *mut MergedSection;
            *(u32_slot_ptr(sym_offs, sym_idx)) = 0u32;
        }
        sym_idx = sym_idx + 1;
    }

    sym_idx = 0;
    while sym_idx < num_syms {
        let sym_off: usize = sym_table_off + coff_mul_usize(sym_idx, COFF_SYMBOL_SIZE);
        let sym = coff_decode_symbol_record(obj_ptr, sym_off);

        let name_ptr: *const u8 = if sym.zeroes == 0u32 {
            let mut slen: usize = 0;
            let raw_s = read_cstr_at_offset(obj_ptr, obj_len, str_table_offset + (sym.offset as usize), mut_view(slen));
            linker_dup_bytes(mut_view(*ctx), raw_s, slen)
        } else {
            let mut short_len: usize = 0;
            while short_len < 8 {
                if sym.name_bytes[short_len] == 0u8 {
                    break;
                }
                short_len = short_len + 1;
            }
            let p_short = unsafe { address_of(sym.name_bytes[0]) };
            linker_dup_bytes(mut_view(*ctx), p_short, short_len)
        };

        unsafe {
            *(cstr_slot_ptr(sym_names, sym_idx)) = name_ptr;
        }

        if sym.section_number > 0i16 {
            let sec_num: usize = sym.section_number as usize;
            if sec_num <= num_secs {
                let s_msec = unsafe { *(merged_sec_slot_ptr(obj_merged_secs, sec_num)) };
                if (s_msec as usize) != 0 {
                    let s_base = unsafe { *(u32_slot_ptr(obj_sec_offsets, sec_num)) };
                    let s_offset: u32 = s_base + sym.value;
                    unsafe {
                        *(msec_slot_ptr(sym_secs, sym_idx)) = s_msec;
                        *(u32_slot_ptr(sym_offs, sym_idx)) = s_offset;
                    }

                    // Only EXTERNAL definitions enter the global name table; STATIC symbols never do.
                    if sym.storage_class == IMAGE_SYM_CLASS_EXTERNAL {
                        let g = linker_add_global(mut_view(*ctx), name_ptr);
                        if unsafe { (*g).defined } {
                            let nlen_g = cstr_len(name_ptr);
                            let is_prel = nlen_g == 14 && unsafe {
                                *(name_ptr + 0) == 112u8 && *(name_ptr + 1) == 114u8 && *(name_ptr + 2) == 101u8 &&
                                *(name_ptr + 3) == 108u8 && *(name_ptr + 4) == 117u8 && *(name_ptr + 5) == 100u8 &&
                                *(name_ptr + 6) == 101u8 && *(name_ptr + 7) == 95u8 && *(name_ptr + 8) == 108u8 &&
                                *(name_ptr + 9) == 111u8 && *(name_ptr + 10) == 97u8 && *(name_ptr + 11) == 100u8 &&
                                *(name_ptr + 12) == 101u8 && *(name_ptr + 13) == 100u8
                            };
                            let has_dollar = pe_cstr_find_char(name_ptr, 36u8) >= 0isize;
                            if !is_prel && !has_dollar {
                                linker_report_duplicate_symbol(diag, name_ptr);
                                unsafe {
                                    free_sym_target_arrays(sym_secs, sym_offs, sym_names_cap);
                                    heap_free(sym_names as *mut u8, coff_mul_usize(sym_names_cap, size_of<*const u8>()), align_of<*const u8>());
                                    heap_free(obj_merged_secs as *mut u8, coff_mul_usize(sec_slots_count, size_of<*mut MergedSection>()), align_of<*mut MergedSection>());
                                    heap_free(obj_sec_offsets as *mut u8, coff_mul_usize(sec_slots_count, size_of<u32>()), align_of<u32>());
                                }
                                return false;
                            }
                        } else {
                            unsafe {
                                (*g).defined = true;
                                (*g).sec = s_msec;
                                (*g).offset = s_offset;
                            }
                        }
                    }
                }
            }
        }

        let aux_count: usize = sym.number_of_aux_symbols as usize;
        sym_idx = sym_idx + 1 + aux_count;
    }

    // 2b. Resolve intra-object references to defined STATIC/EXTERNAL symbols of the same name
    let mut u_idx: usize = 0;
    while u_idx < num_syms {
        let u_sec = unsafe { *(msec_slot_ptr(sym_secs, u_idx)) };
        let u_name = unsafe { *(cstr_slot_ptr(sym_names, u_idx)) };
        if (u_sec as usize) == 0 && (u_name as usize) != 0 {
            let mut d_idx: usize = 0;
            while d_idx < num_syms {
                let d_sec = unsafe { *(msec_slot_ptr(sym_secs, d_idx)) };
                let d_name = unsafe { *(cstr_slot_ptr(sym_names, d_idx)) };
                if (d_sec as usize) != 0 && (d_name as usize) != 0 && cstr_eq(u_name, d_name) {
                    let d_off = unsafe { *(u32_slot_ptr(sym_offs, d_idx)) };
                    unsafe {
                        *(msec_slot_ptr(sym_secs, u_idx)) = d_sec;
                        *(u32_slot_ptr(sym_offs, u_idx)) = d_off;
                    }
                    break;
                }
                d_idx = d_idx + 1;
            }
        }
        u_idx = u_idx + 1;
    }

    // 3. Parse Relocations
    s = 0;
    while s < num_secs {
        let shdr = coff_decode_section_header(obj_ptr, COFF_FILE_HEADER_SIZE + coff_mul_usize(s, COFF_SECTION_HEADER_SIZE));
        let num_rels: usize = shdr.number_of_relocations as usize;
        if num_rels > 0 {
            let rel_table_off: usize = shdr.pointer_to_relocations as usize;
            let rel_table_end: usize = rel_table_off + coff_mul_usize(num_rels, COFF_RELOC_SIZE);
            if rel_table_end > obj_len {
                unsafe {
                    free_sym_target_arrays(sym_secs, sym_offs, sym_names_cap);
                    heap_free(sym_names as *mut u8, coff_mul_usize(sym_names_cap, size_of<*const u8>()), align_of<*const u8>());
                    heap_free(obj_merged_secs as *mut u8, coff_mul_usize(sec_slots_count, size_of<*mut MergedSection>()), align_of<*mut MergedSection>());
                    heap_free(obj_sec_offsets as *mut u8, coff_mul_usize(sec_slots_count, size_of<u32>()), align_of<u32>());
                }
                linker_report_bad_object(diag);
                return false;
            }

            let msec = unsafe { *(merged_sec_slot_ptr(obj_merged_secs, s + 1)) };
            if (msec as usize) == 0 {
                s = s + 1;
                continue;
            }
            let msec_base = unsafe { *(u32_slot_ptr(obj_sec_offsets, s + 1)) };
            let msec_data = unsafe { (*msec).data as *const u8 };
            let msec_size = unsafe { (*msec).size };

            let mut r: usize = 0;
            while r < num_rels {
                let rel = coff_decode_relocation(obj_ptr, rel_table_off + coff_mul_usize(r, COFF_RELOC_SIZE));
                let off: u32 = msec_base + rel.virtual_address;
                let mut addend: i64 = 0i64;
                if rel.reloc_type == IMAGE_REL_AMD64_ADDR64 {
                    if off + 8u32 <= msec_size {
                        addend = pe_read_i64_le(msec_data, off as usize);
                    }
                } else {
                    if off + 4u32 <= msec_size {
                        addend = (coff_read_i32_le(msec_data, off as usize)) as i64;
                    }
                }

                let sym_tab_idx: usize = rel.symbol_table_index as usize;
                let tgt_sec: *mut MergedSection = if sym_tab_idx < num_syms {
                    unsafe { *(msec_slot_ptr(sym_secs, sym_tab_idx)) }
                } else {
                    0 as *mut MergedSection
                };
                if (tgt_sec as usize) != 0 {
                    // Defined in this object (SectionNumber > 0): bind by symbol index (ADR-0035 section 2).
                    let tgt_off: u32 = unsafe { *(u32_slot_ptr(sym_offs, sym_tab_idx)) };
                    linker_add_reloc_direct(mut_view(*ctx), msec, off, rel.reloc_type, tgt_sec, tgt_off, addend);
                } else {
                    let target_sym_name: *const u8 = if sym_tab_idx < num_syms {
                        unsafe { *(cstr_slot_ptr(sym_names, sym_tab_idx)) }
                    } else {
                        0 as *const u8
                    };
                    linker_add_reloc(mut_view(*ctx), msec, off, rel.reloc_type, target_sym_name, addend);
                }
                r = r + 1;
            }
        }
        s = s + 1;
    }

    unsafe {
        free_sym_target_arrays(sym_secs, sym_offs, sym_names_cap);
        heap_free(sym_names as *mut u8, coff_mul_usize(sym_names_cap, size_of<*const u8>()), align_of<*const u8>());
        heap_free(obj_merged_secs as *mut u8, coff_mul_usize(sec_slots_count, size_of<*mut MergedSection>()), align_of<*mut MergedSection>());
        heap_free(obj_sec_offsets as *mut u8, coff_mul_usize(sec_slots_count, size_of<u32>()), align_of<u32>());
    }
    true
}

pub fn linker_read_file_bytes(path_ptr: *const u8, path_len: usize, out_buf: mut_view<CoffBuf>) -> bool {
    coff_buf_clear(mut_view(*out_buf));
    if (path_ptr as usize) == 0 || path_len == 0 {
        return false;
    }
    let h = unsafe { open(path_ptr, path_len, 0u32) };
    if h < 0 {
        return false;
    }
    let sz = file_size(h);
    if sz <= 0 {
        let _ = close(h);
        return false;
    }
    let usize_sz = sz as usize;
    coff_buf_reserve(mut_view(*out_buf), usize_sz);
    let mut total_read: usize = 0;
    while total_read < usize_sz {
        let dst = unsafe { out_buf.ptr + total_read };
        let rem = usize_sz - total_read;
        let rd = unsafe { read(h, dst, rem) };
        if rd <= 0 {
            let _ = close(h);
            return false;
        }
        total_read = total_read + (rd as usize);
    }
    out_buf.len = total_read;
    let _ = close(h);
    true
}

pub fn linker_load_coff_file(ctx: mut_view<LinkerContext>, path_ptr: *const u8, path_len: usize, diag: *mut DiagSink) -> bool {
    let mut file_buf = coff_buf_with_capacity(256);
    if !linker_read_file_bytes(path_ptr, path_len, mut_view(file_buf)) {
        coff_buf_free(mut_view(file_buf));
        linker_report_bad_object(diag);
        return false;
    }
    let ok = linker_load_coff_object(ctx, file_buf.ptr as *const u8, file_buf.len, diag);
    coff_buf_free(mut_view(file_buf));
    ok
}

// --- RVA Assignment, Relocation Application & PE32+ Image Emission ---

// 6. Assigns RVAs (`SectionAlignment = 0x1000`) and raw file offsets (`FileAlignment = 0x200`)
// to all merged sections in `ctx`. Returns `SizeOfImage` (final `current_rva`).
pub fn linker_assign_rvas(ctx: mut_view<LinkerContext>, file_align: u32, sec_align: u32) -> u32 {
    let mut current_rva: u32 = sec_align;
    let mut current_raw: u32 = pe_compute_headers_size(ctx.num_sections, file_align);

    let mut i: usize = 0;
    while i < ctx.num_sections {
        let sec = linker_section_at(view(*ctx), i);
        let sec_size = unsafe { (*sec).size };
        unsafe {
            (*sec).rva = current_rva;
            (*sec).raw_ptr = current_raw;
        }
        current_rva = pe_align_up_u32(current_rva + sec_size, sec_align);
        current_raw = pe_align_up_u32(current_raw + sec_size, file_align);
        i = i + 1;
    }
    current_rva
}

// 8. Resolves and patches all relocations in `ctx`. Reports `AX_LINK_UNDEFINED_SYMBOL` on failure.
pub fn linker_apply_relocations(ctx: mut_view<LinkerContext>, image_base: u64, diag: *mut DiagSink) -> bool {
    let mut i: usize = 0;
    while i < ctx.num_relocs {
        let r = linker_reloc_at(view(*ctx), i);
        let direct_sec = unsafe { (*r).dsec };
        let mut sym_rva: u32 = 0u32;
        if (direct_sec as usize) != 0 {
            // Same-object target resolved by symbol index at load time.
            sym_rva = (unsafe { (*direct_sec).rva }) + (unsafe { (*r).doffset });
        } else {
            let sym_name = unsafe { (*r).sym_name };
            let sym = linker_add_global(mut_view(*ctx), sym_name);
            if !(unsafe { (*sym).defined }) {
                linker_report_undefined_symbol(diag, sym_name);
                return false;
            }
            let sym_sec = unsafe { (*sym).sec };
            let sym_off = unsafe { (*sym).offset };
            sym_rva = (unsafe { (*sym_sec).rva }) + sym_off;
        }

        let r_sec = unsafe { (*r).sec };
        let r_off = unsafe { (*r).offset };
        let reloc_rva: u32 = (unsafe { (*r_sec).rva }) + r_off;
        let r_data = unsafe { (*r_sec).data };
        let r_type = unsafe { (*r).reloc_type };
        let r_addend = unsafe { (*r).addend };

        if r_type == IMAGE_REL_AMD64_REL32 || (r_type >= IMAGE_REL_AMD64_REL32_1 && r_type <= IMAGE_REL_AMD64_REL32_5) {
            let val: i64 = (sym_rva as i64) - (reloc_rva as i64) - 4i64 + r_addend;
            pe_write_i32_le(r_data, r_off as usize, val as i32);
        } else if r_type == IMAGE_REL_AMD64_ADDR64 {
            let val: u64 = image_base + (sym_rva as u64) + (r_addend as u64);
            coff_write_u64_le(r_data, r_off as usize, val);
        } else if r_type == IMAGE_REL_AMD64_ADDR32NB {
            let val32: i32 = ((sym_rva as i64) + r_addend) as i32;
            pe_write_i32_le(r_data, r_off as usize, val32);
        } else if r_type == IMAGE_REL_AMD64_ADDR32 {
            let val32: i32 = ((image_base as i64) + (sym_rva as i64) + r_addend) as i32;
            pe_write_i32_le(r_data, r_off as usize, val32);
        }

        i = i + 1;
    }
    true
}

// 9. Serializes the complete PE32+ executable image into `out`.
pub fn linker_emit_pe_image(
    ctx: view<LinkerContext>,
    imports: view<ImportTable>,
    axiom_start_offset: u32,
    size_of_image: u32,
    stack_reserve: u32,
    out: mut_view<CoffBuf>
) -> bool {
    let file_align: u32 = PE_DEFAULT_FILE_ALIGN;
    let sec_align: u32 = PE_DEFAULT_SECTION_ALIGN;
    let eff_stack_reserve: u32 = if stack_reserve == 0u32 { PE_DEFAULT_STACK_RESERVE } else { stack_reserve };

    let text_sec = linker_find_section_str(ctx, { ".text" });
    let idata_sec = linker_find_section_str(ctx, { ".idata" });
    if (text_sec as usize) == 0 || (idata_sec as usize) == 0 {
        return false;
    }

    let size_of_headers: u32 = pe_compute_headers_size(ctx.num_sections, file_align);

    // 1. DOS Header (64 bytes)
    pe_emit_dos_header(mut_view(*out));

    // 2. PE Signature ("PE\0\0", 4 bytes)
    pe_emit_pe_signature(mut_view(*out));

    // 3. COFF File Header (20 bytes)
    let fhdr = CoffFileHeader {
        machine: IMAGE_FILE_MACHINE_AMD64,
        number_of_sections: ctx.num_sections as u16,
        time_date_stamp: 0u32,
        pointer_to_symbol_table: 0u32,
        number_of_symbols: 0u32,
        size_of_optional_header: PE_OPTIONAL_HEADER64_TOTAL_SIZE as u16,
        characteristics: IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE | IMAGE_FILE_DEBUG_STRIPPED,
    };
    pe_emit_file_header(mut_view(*out), view(fhdr));

    // 4. Optional Header (112 bytes)
    let mut size_of_init_data: u32 = 0u32;
    let mut i: usize = 0;
    while i < ctx.num_sections {
        let sec = linker_section_at(ctx, i);
        let chars = unsafe { (*sec).characteristics };
        let sz = unsafe { (*sec).size };
        if (chars & IMAGE_SCN_CNT_INITIALIZED_DATA) != 0u32 {
            size_of_init_data = size_of_init_data + sz;
        }
        i = i + 1;
    }

    let text_rva = unsafe { (*text_sec).rva };
    let text_size = unsafe { (*text_sec).size };
    let mut ohdr = PeOptionalHeader64 {
        magic: 0u16,
        major_linker_version: 0u8,
        minor_linker_version: 0u8,
        size_of_code: 0u32,
        size_of_initialized_data: 0u32,
        size_of_uninitialized_data: 0u32,
        address_of_entry_point: 0u32,
        base_of_code: 0u32,
        image_base: 0u64,
        section_alignment: 0u32,
        file_alignment: 0u32,
        major_operating_system_version: 0u16,
        minor_operating_system_version: 0u16,
        major_image_version: 0u16,
        minor_image_version: 0u16,
        major_subsystem_version: 0u16,
        minor_subsystem_version: 0u16,
        win32_version_value: 0u32,
        size_of_image: 0u32,
        size_of_headers: 0u32,
        check_sum: 0u32,
        subsystem: 0u16,
        dll_characteristics: 0u16,
        size_of_stack_reserve: 0u64,
        size_of_stack_commit: 0u64,
        size_of_heap_reserve: 0u64,
        size_of_heap_commit: 0u64,
        loader_flags: 0u32,
        number_of_rva_and_sizes: 0u32,
    };
    pe_optional_header64_init(mut_view(ohdr));
    ohdr.size_of_code = text_size;
    ohdr.size_of_initialized_data = size_of_init_data;
    ohdr.address_of_entry_point = text_rva + axiom_start_offset;
    ohdr.base_of_code = text_rva;
    ohdr.section_alignment = sec_align;
    ohdr.file_alignment = file_align;
    ohdr.size_of_image = size_of_image;
    ohdr.size_of_headers = size_of_headers;
    ohdr.size_of_stack_reserve = eff_stack_reserve as u64;
    pe_emit_optional_header64(mut_view(*out), view(ohdr));

    // 5. Data Directories (16 * 8 = 128 bytes)
    let idata_rva = unsafe { (*idata_sec).rva };
    let import_dir_rva: u32 = idata_rva + imports.idata_base + imports.desc_offset;
    let import_dir_size: u32 = coff_mul_u32((imports.num_dlls + 1) as u32, PE_IMPORT_DESCRIPTOR_SIZE as u32);
    let iat_dir_rva: u32 = idata_rva + imports.idata_base + imports.all_iats_start;
    let iat_dir_size: u32 = imports.all_iats_size;

    let mut d_idx: usize = 0;
    while d_idx < PE_DATA_DIRECTORY_COUNT {
        let dir = if d_idx == PE_DIR_IMPORT {
            PeDataDirectory { virtual_address: import_dir_rva, size: import_dir_size }
        } else if d_idx == PE_DIR_IAT {
            PeDataDirectory { virtual_address: iat_dir_rva, size: iat_dir_size }
        } else {
            PeDataDirectory { virtual_address: 0u32, size: 0u32 }
        };
        pe_emit_data_directory(mut_view(*out), view(dir));
        d_idx = d_idx + 1;
    }

    // 6. Section Headers (40 bytes each)
    i = 0;
    while i < ctx.num_sections {
        let sec = linker_section_at(ctx, i);
        let mut sname: [8]u8 = [0u8; 8];
        let mut k: usize = 0;
        while k < 8 {
            let ch = unsafe { (*sec).name[k] };
            if ch == 0u8 {
                break;
            }
            sname[k] = ch;
            k = k + 1;
        }
        let sec_size = unsafe { (*sec).size };
        let sec_rva = unsafe { (*sec).rva };
        let sec_raw_ptr = unsafe { (*sec).raw_ptr };
        let sec_chars = unsafe { (*sec).characteristics };
        let raw_data_sz = pe_align_up_u32(sec_size, file_align);
        let ptr_to_raw = if raw_data_sz > 0u32 { sec_raw_ptr } else { 0u32 };

        let shdr = CoffSectionHeader {
            name: sname,
            virtual_size: sec_size,
            virtual_address: sec_rva,
            size_of_raw_data: raw_data_sz,
            pointer_to_raw_data: ptr_to_raw,
            pointer_to_relocations: 0u32,
            pointer_to_linenumbers: 0u32,
            number_of_relocations: 0u16,
            number_of_linenumbers: 0u16,
            characteristics: sec_chars,
        };
        pe_emit_section_header(mut_view(*out), view(shdr));
        i = i + 1;
    }

    // 7. Section Raw Data (padded to raw_ptr and FileAlignment)
    i = 0;
    while i < ctx.num_sections {
        let sec = linker_section_at(ctx, i);
        let sec_size = unsafe { (*sec).size };
        if sec_size > 0u32 {
            let sec_raw_ptr = (unsafe { (*sec).raw_ptr }) as usize;
            if (out.len) < sec_raw_ptr {
                pe_buf_put_zeroes(mut_view(*out), sec_raw_ptr - out.len);
            }
            let sec_data = unsafe { (*sec).data as *const u8 };
            coff_buf_put_bytes(mut_view(*out), sec_data, sec_size as usize);

            let aligned_sz = pe_align_up_u32(sec_size, file_align);
            let padding: u32 = aligned_sz - sec_size;
            if padding > 0u32 {
                pe_buf_put_zeroes(mut_view(*out), padding as usize);
            }
        }
        i = i + 1;
    }

    true
}

// --- COFF Archive (.lib) Reader, Short Import Loader & Demand-Driven Extraction (SPEC-26) ---

pub fn coff_is_archive_bytes(buf: *const u8, len: usize) -> bool {
    if buf as usize == 0 || len < COFF_ARCHIVE_MAGIC_SIZE {
        return false;
    }
    let b0 = unsafe { *buf };
    let b1 = unsafe { *(buf + 1) };
    let b2 = unsafe { *(buf + 2) };
    let b3 = unsafe { *(buf + 3) };
    let b4 = unsafe { *(buf + 4) };
    let b5 = unsafe { *(buf + 5) };
    let b6 = unsafe { *(buf + 6) };
    let b7 = unsafe { *(buf + 7) };
    b0 == 0x21u8 && b1 == 0x3Cu8 && b2 == 0x61u8 && b3 == 0x72u8 &&
    b4 == 0x63u8 && b5 == 0x68u8 && b6 == 0x3Eu8 && b7 == 0x0Au8
}

pub fn linker_path_is_archive_ext(path_ptr: *const u8, path_len: usize) -> bool {
    if path_ptr as usize == 0 || path_len < 2 {
        return false;
    }
    let a_ext: [2]u8 = [46u8, 97u8]; // ".a"
    if pe_bytes_ieq(unsafe { path_ptr + (path_len - 2) }, 2, unsafe { address_of(a_ext[0]) }, 2) {
        return true;
    }
    if path_len >= 4 {
        let lib_ext: [4]u8 = [46u8, 108u8, 105u8, 98u8]; // ".lib"
        if pe_bytes_ieq(unsafe { path_ptr + (path_len - 4) }, 4, unsafe { address_of(lib_ext[0]) }, 4) {
            return true;
        }
    }
    false
}

struct ArchiveMemberCandidate {
    data: *const u8,
    data_len: usize,
    archive_id: usize,
    extracted: bool,
}

struct ArchiveCandidateList {
    ptr: *mut ArchiveMemberCandidate,
    len: usize,
    cap: usize,
    next_archive_id: usize,
}

fn archive_cand_list_new() -> ArchiveCandidateList {
    ArchiveCandidateList {
        ptr: 0 as *mut ArchiveMemberCandidate,
        len: 0,
        cap: 0,
        next_archive_id: 1,
    }
}

fn archive_cand_list_free(list: mut_view<ArchiveCandidateList>) {
    if list.cap > 0 && list.ptr as usize != 0 {
        unsafe {
            heap_free(
                list.ptr as *mut u8,
                coff_mul_usize(list.cap, size_of<ArchiveMemberCandidate>()),
                align_of<ArchiveMemberCandidate>()
            );
        }
    }
    list.ptr = 0 as *mut ArchiveMemberCandidate;
    list.len = 0;
    list.cap = 0;
}

unsafe fn archive_cand_slot(base: *mut ArchiveMemberCandidate, idx: usize) -> *mut ArchiveMemberCandidate {
    ((base as usize) + coff_mul_usize(idx, size_of<ArchiveMemberCandidate>())) as *mut ArchiveMemberCandidate
}

fn archive_cand_list_push(list: mut_view<ArchiveCandidateList>, data: *const u8, data_len: usize, archive_id: usize) {
    if list.len == list.cap {
        let new_cap = if list.cap == 0 { 16 } else { list.cap + list.cap };
        let esz = size_of<ArchiveMemberCandidate>();
        let eal = align_of<ArchiveMemberCandidate>();
        let new_ptr = unsafe { heap_alloc(coff_mul_usize(new_cap, esz), eal) as *mut ArchiveMemberCandidate };
        if list.len > 0 && list.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    list.ptr as *const u8,
                    new_ptr as *mut u8,
                    coff_mul_usize(list.len, esz)
                );
                heap_free(list.ptr as *mut u8, coff_mul_usize(list.cap, esz), eal);
            }
        }
        list.ptr = new_ptr;
        list.cap = new_cap;
    }
    let slot = unsafe { archive_cand_slot(list.ptr, list.len) };
    unsafe {
        (*slot).data = data;
        (*slot).data_len = data_len;
        (*slot).archive_id = archive_id;
        (*slot).extracted = false;
    }
    list.len = list.len + 1;
}

fn archive_parse_header_size(hdr_ptr: *const u8, out_size: mut_view<usize>) -> bool {
    let s_ptr = unsafe { hdr_ptr + 48 };
    let mut val: usize = 0;
    let mut i: usize = 0;
    let mut has_digit: bool = false;
    let mut seen_space: bool = false;
    while i < 10 {
        let ch = unsafe { *(s_ptr + i) };
        if ch >= 48u8 && ch <= 57u8 {
            if seen_space {
                return false;
            }
            has_digit = true;
            val = coff_mul_usize(val, 10) + ((ch - 48u8) as usize);
        } else if ch == 32u8 {
            seen_space = true;
        } else {
            return false;
        }
        i = i + 1;
    }
    if !has_digit {
        return false;
    }
    *out_size = val;
    true
}

fn archive_validate_object_or_short_import(data: *const u8, data_len: usize) -> bool {
    if data as usize == 0 || data_len < COFF_FILE_HEADER_SIZE {
        return false;
    }
    let sig1 = coff_read_u16_le(data, 0);
    let sig2 = coff_read_u16_le(data, 2);
    if sig1 == IMPORT_OBJECT_HDR_SIG1 && sig2 == IMPORT_OBJECT_HDR_SIG2 {
        let shdr = coff_decode_short_import_header(data, 0);
        if shdr.machine != IMAGE_FILE_MACHINE_AMD64 {
            return false;
        }
        let payload_len = shdr.size_of_data as usize;
        if payload_len < 4 || COFF_SHORT_IMPORT_HEADER_SIZE + payload_len > data_len {
            return false;
        }
        let payload_ptr = unsafe { data + COFF_SHORT_IMPORT_HEADER_SIZE };
        let mut sym_len: usize = 0;
        while sym_len < payload_len && (unsafe { *(payload_ptr + sym_len) }) != 0u8 {
            sym_len = sym_len + 1;
        }
        if sym_len == 0 || sym_len + 1 >= payload_len {
            return false;
        }
        let dll_start = sym_len + 1;
        let mut dll_len: usize = 0;
        while dll_start + dll_len < payload_len && (unsafe { *(payload_ptr + dll_start + dll_len) }) != 0u8 {
            dll_len = dll_len + 1;
        }
        if dll_len == 0 || dll_start + dll_len >= payload_len {
            return false;
        }
        return true;
    }

    let hdr = coff_decode_file_header(data, 0);
    if hdr.machine != IMAGE_FILE_MACHINE_AMD64 {
        return false;
    }
    let num_secs = hdr.number_of_sections as usize;
    let shdr_end = COFF_FILE_HEADER_SIZE + coff_mul_usize(num_secs, COFF_SECTION_HEADER_SIZE);
    if shdr_end > data_len {
        return false;
    }
    let num_syms = hdr.number_of_symbols as usize;
    let sym_off = hdr.pointer_to_symbol_table as usize;
    if num_syms > 0 && sym_off + coff_mul_usize(num_syms, COFF_SYMBOL_SIZE) > data_len {
        return false;
    }
    true
}

fn linker_collect_archive_candidates(
    list: mut_view<ArchiveCandidateList>,
    buf: *const u8,
    len: usize,
    diag: *mut DiagSink
) -> bool {
    if !coff_is_archive_bytes(buf, len) {
        linker_report_bad_archive(diag);
        return false;
    }
    let cur_archive_id = list.next_archive_id;
    list.next_archive_id = cur_archive_id + 1;
    let mut off: usize = COFF_ARCHIVE_MAGIC_SIZE;
    let mut seen_first_linker: bool = false;
    let mut seen_second_linker: bool = false;
    let mut longnames_len: usize = 0;
    let mut has_longnames: bool = false;

    while off < len {
        if off + COFF_ARCHIVE_MEMBER_HEADER_SIZE > len {
            linker_report_bad_archive(diag);
            return false;
        }
        let hdr_ptr = unsafe { buf + off };
        let end0 = unsafe { *(hdr_ptr + 58) };
        let end1 = unsafe { *(hdr_ptr + 59) };
        if end0 != 0x60u8 || end1 != 0x0Au8 {
            linker_report_bad_archive(diag);
            return false;
        }
        let mut member_size: usize = 0;
        if !archive_parse_header_size(hdr_ptr, mut_view(member_size)) {
            linker_report_bad_archive(diag);
            return false;
        }
        let payload_off = off + COFF_ARCHIVE_MEMBER_HEADER_SIZE;
        if payload_off + member_size > len {
            linker_report_bad_archive(diag);
            return false;
        }
        let payload_ptr = unsafe { buf + payload_off };
        let n0 = unsafe { *hdr_ptr };
        let n1 = unsafe { *(hdr_ptr + 1) };
        let n2 = unsafe { *(hdr_ptr + 2) };

        if n0 == 47u8 && n1 == 32u8 {
            // Linker member "/"
            if !seen_first_linker {
                seen_first_linker = true;
                if member_size < 4 {
                    linker_report_bad_archive(diag);
                    return false;
                }
                let nsyms = coff_read_u32_be(payload_ptr, 0) as usize;
                let offs_bytes = coff_mul_usize(nsyms, 4);
                if 4 + offs_bytes > member_size {
                    linker_report_bad_archive(diag);
                    return false;
                }
                let mut s: usize = 0;
                while s < nsyms {
                    let m_off = coff_read_u32_be(payload_ptr, 4 + coff_mul_usize(s, 4)) as usize;
                    if m_off < COFF_ARCHIVE_MAGIC_SIZE + COFF_ARCHIVE_MEMBER_HEADER_SIZE || m_off + COFF_ARCHIVE_MEMBER_HEADER_SIZE > len {
                        linker_report_bad_archive(diag);
                        return false;
                    }
                    s = s + 1;
                }
            } else if !seen_second_linker {
                seen_second_linker = true;
                if member_size < 8 {
                    linker_report_bad_archive(diag);
                    return false;
                }
                let nmems = coff_read_u32_le(payload_ptr, 0) as usize;
                let mem_offs_bytes = coff_mul_usize(nmems, 4);
                if 4 + mem_offs_bytes + 4 > member_size {
                    linker_report_bad_archive(diag);
                    return false;
                }
                let nsyms2 = coff_read_u32_le(payload_ptr, 4 + mem_offs_bytes) as usize;
                let idx_bytes = coff_mul_usize(nsyms2, 2);
                if 4 + mem_offs_bytes + 4 + idx_bytes > member_size {
                    linker_report_bad_archive(diag);
                    return false;
                }
            }
        } else if n0 == 47u8 && n1 == 47u8 && n2 == 32u8 {
            // Longnames member "//"
            has_longnames = true;
            longnames_len = member_size;
        } else {
            if n0 == 47u8 && n1 >= 48u8 && n1 <= 57u8 {
                let ln_off = pe_parse_u32_decimal(unsafe { hdr_ptr + 1 }, 15) as usize;
                if !has_longnames || ln_off >= longnames_len {
                    linker_report_bad_archive(diag);
                    return false;
                }
            }
            if !archive_validate_object_or_short_import(payload_ptr, member_size) {
                linker_report_bad_archive(diag);
                return false;
            }
            archive_cand_list_push(mut_view(*list), payload_ptr, member_size, cur_archive_id);
        }

        off = payload_off + member_size;
        if (off & 1) != 0 && off < len {
            off = off + 1;
        }
    }
    true
}

fn short_import_effective_name(
    raw_sym: *const u8,
    raw_len: usize,
    name_type: u16,
    out_len: mut_view<usize>
) -> *const u8 {
    let mut start: usize = 0;
    let mut end: usize = raw_len;
    if (name_type == IMPORT_OBJECT_NAME_NO_PREFIX || name_type == IMPORT_OBJECT_NAME_UNDECORATE) && raw_len > 0 {
        let c0 = unsafe { *raw_sym };
        if c0 == 63u8 || c0 == 64u8 || c0 == 95u8 { // '?', '@', '_'
            start = 1;
        }
        if name_type == IMPORT_OBJECT_NAME_UNDECORATE {
            let mut k: usize = start;
            while k < raw_len {
                if (unsafe { *(raw_sym + k) }) == 64u8 { // '@'
                    end = k;
                    break;
                }
                k = k + 1;
            }
        }
    }
    if end > start {
        *out_len = end - start;
        unsafe { raw_sym + start }
    } else {
        *out_len = raw_len;
        raw_sym
    }
}

pub fn linker_load_short_import_object(
    ctx: mut_view<LinkerContext>,
    imports: mut_view<ImportTable>,
    data: *const u8,
    data_len: usize,
    diag: *mut DiagSink
) -> bool {
    if !archive_validate_object_or_short_import(data, data_len) {
        linker_report_bad_archive(diag);
        return false;
    }
    let shdr = coff_decode_short_import_header(data, 0);
    let payload_ptr = unsafe { data + COFF_SHORT_IMPORT_HEADER_SIZE };
    let payload_len = shdr.size_of_data as usize;
    let mut raw_sym_len: usize = 0;
    while raw_sym_len < payload_len && (unsafe { *(payload_ptr + raw_sym_len) }) != 0u8 {
        raw_sym_len = raw_sym_len + 1;
    }
    let dll_start = raw_sym_len + 1;
    let mut dll_len: usize = 0;
    while dll_start + dll_len < payload_len && (unsafe { *(payload_ptr + dll_start + dll_len) }) != 0u8 {
        dll_len = dll_len + 1;
    }

    let name_type: u16 = (shdr.type_info >> 2) & 7u16;
    let mut eff_len: usize = 0;
    let eff_ptr = short_import_effective_name(payload_ptr, raw_sym_len, name_type, mut_view(eff_len));
    let sym_cstr = linker_dup_bytes(mut_view(*ctx), eff_ptr, eff_len);

    let dll = import_find_or_add_dll_bytes(mut_view(*imports), mut_view(*ctx), unsafe { payload_ptr + dll_start }, dll_len);
    let is_code: bool = (shdr.type_info & 3u16) == IMPORT_OBJECT_CODE;
    let _ = import_add_func_ex(mut_view(*ctx), dll, sym_cstr, 0 as *const u8, shdr.ordinal_or_hint, is_code);
    true
}

fn linker_is_symbol_needed_cstr_ex(
    ctx: view<LinkerContext>,
    imports: view<ImportTable>,
    dll_state: *const DllLinkState,
    sym_cstr: *const u8
) -> bool {
    let existing = linker_find_global(ctx, sym_cstr);
    if existing as usize != 0 && (unsafe { (*existing).defined }) {
        return false;
    }
    if import_has_func(imports, sym_cstr) {
        return false;
    }
    let starts_imp_sym = has_imp_prefix_cstr(sym_cstr);
    let bare_sym = if starts_imp_sym { unsafe { sym_cstr + 6 } } else { sym_cstr };
    if starts_imp_sym && import_has_func(imports, bare_sym) {
        return false;
    }

    if (dll_state as usize) != 0 {
        let num_exp = unsafe { (*dll_state).num_exports };
        let mut e_idx: usize = 0;
        while e_idx < num_exp {
            let exp = dll_export_at(unsafe { view(*dll_state) }, e_idx);
            let int_name = unsafe { (*exp).internal_name };
            if (int_name as usize) != 0 && cstr_eq(int_name, sym_cstr) {
                return true;
            }
            e_idx = e_idx + 1;
        }
    }

    let mut r: usize = 0;
    while r < ctx.num_relocs {
        let rel = linker_reloc_at(ctx, r);
        let dsec = unsafe { (*rel).dsec };
        let rname = unsafe { (*rel).sym_name };
        if (dsec as usize) == 0 && (rname as usize) != 0 && (unsafe { *rname }) != 0u8 {
            let g_rel = linker_find_global(ctx, rname);
            let rel_defined = if (g_rel as usize) != 0 { unsafe { (*g_rel).defined } } else { false };
            if !rel_defined {
                if cstr_eq(rname, sym_cstr) {
                    return true;
                }
                let r_starts_iat = has_iat_prefix_cstr(rname);
                let r_starts_imp = has_imp_prefix_cstr(rname);
                if r_starts_iat || r_starts_imp {
                    let after_prefix = unsafe { rname + 6 };
                    if cstr_eq(after_prefix, bare_sym) {
                        return true;
                    }
                    let d_idx = pe_cstr_find_char(after_prefix, 36u8); // '$'
                    if d_idx >= 0 {
                        let r_bare = unsafe { after_prefix + (d_idx as usize) + 1 };
                        if cstr_eq(r_bare, bare_sym) {
                            return true;
                        }
                    }
                } else {
                    let d_idx = pe_cstr_find_char(rname, 36u8); // '$'
                    if d_idx >= 0 {
                        let r_bare = unsafe { rname + (d_idx as usize) + 1 };
                        if !starts_imp_sym && cstr_eq(r_bare, sym_cstr) {
                            return true;
                        }
                    }
                }
            }
        }
        r = r + 1;
    }
    false
}

fn linker_is_symbol_needed_bytes_ex(
    ctx: view<LinkerContext>,
    imports: view<ImportTable>,
    dll_state: *const DllLinkState,
    sym_ptr: *const u8,
    sym_len: usize
) -> bool {
    if sym_ptr as usize == 0 || sym_len == 0 {
        return false;
    }
    let mut tmp = coff_buf_with_capacity(sym_len + 1);
    coff_buf_put_bytes(mut_view(tmp), sym_ptr, sym_len);
    coff_buf_put_u8(mut_view(tmp), 0u8);
    let needed = linker_is_symbol_needed_cstr_ex(ctx, imports, dll_state, tmp.ptr as *const u8);
    coff_buf_free(mut_view(tmp));
    needed
}

fn shdr_name_is_idata_subsec(shdr: view<CoffSectionHeader>, digit: u8) -> bool {
    shdr.name[0] == 46u8 && shdr.name[1] == 105u8 && shdr.name[2] == 100u8 &&
    shdr.name[3] == 97u8 && shdr.name[4] == 116u8 && shdr.name[5] == 97u8 &&
    shdr.name[6] == 36u8 && shdr.name[7] == digit
}

fn shdr_name_is_any_idata_subsec(shdr: view<CoffSectionHeader>) -> bool {
    shdr.name[0] == 46u8 && shdr.name[1] == 105u8 && shdr.name[2] == 100u8 &&
    shdr.name[3] == 97u8 && shdr.name[4] == 116u8 && shdr.name[5] == 97u8 &&
    shdr.name[6] == 36u8
}

fn shdr_name_is_text(shdr: view<CoffSectionHeader>) -> bool {
    shdr.name[0] == 46u8 && shdr.name[1] == 116u8 && shdr.name[2] == 101u8 &&
    shdr.name[3] == 120u8 && shdr.name[4] == 116u8 && shdr.name[5] == 0u8
}

// Classifies traditional GNU `ld` / `dlltool` COFF `.idata$*` import members:
// - 0: regular COFF object
// - 1: `.idata$2/.idata$4/.idata$5/.idata$7` header or trailer member (skip direct extraction)
// - 2: `.idata$5 + .idata$6` symbol import member
fn classify_long_import_coff_member(data: *const u8, data_len: usize) -> u32 {
    if (data as usize) == 0 || data_len < COFF_FILE_HEADER_SIZE {
        return 0u32;
    }
    let hdr = coff_decode_file_header(data, 0);
    let num_secs = hdr.number_of_sections as usize;
    if COFF_FILE_HEADER_SIZE + coff_mul_usize(num_secs, COFF_SECTION_HEADER_SIZE) > data_len {
        return 0u32;
    }
    let mut has_any_idata: bool = false;
    let mut has_idata5: bool = false;
    let mut has_idata6: bool = false;
    let mut s: usize = 0;
    while s < num_secs {
        let shdr = coff_decode_section_header(data, COFF_FILE_HEADER_SIZE + coff_mul_usize(s, COFF_SECTION_HEADER_SIZE));
        if shdr_name_is_any_idata_subsec(view(shdr)) {
            has_any_idata = true;
            if shdr_name_is_idata_subsec(view(shdr), 53u8) { // '5'
                has_idata5 = true;
            } else if shdr_name_is_idata_subsec(view(shdr), 54u8) && shdr.size_of_raw_data >= 3u32 { // '6'
                has_idata6 = true;
            }
        }
        s = s + 1;
    }
    if !has_any_idata {
        return 0u32;
    }
    if has_idata5 && has_idata6 {
        2u32
    } else {
        1u32
    }
}

fn find_dll_name_in_long_import_archive(
    list: view<ArchiveCandidateList>,
    archive_id: usize,
    out_len: mut_view<usize>
) -> *const u8 {
    let mut i: usize = 0;
    while i < list.len {
        let cand = unsafe { archive_cand_slot(list.ptr, i) };
        if (unsafe { (*cand).archive_id }) == archive_id {
            let c_data = unsafe { (*cand).data };
            let c_len = unsafe { (*cand).data_len };
            let sig1 = coff_read_u16_le(c_data, 0);
            let sig2 = coff_read_u16_le(c_data, 2);
            if !(sig1 == IMPORT_OBJECT_HDR_SIG1 && sig2 == IMPORT_OBJECT_HDR_SIG2) && c_len >= COFF_FILE_HEADER_SIZE {
                let hdr = coff_decode_file_header(c_data, 0);
                let num_secs = hdr.number_of_sections as usize;
                if COFF_FILE_HEADER_SIZE + coff_mul_usize(num_secs, COFF_SECTION_HEADER_SIZE) <= c_len {
                    let mut s: usize = 0;
                    while s < num_secs {
                        let shdr = coff_decode_section_header(c_data, COFF_FILE_HEADER_SIZE + coff_mul_usize(s, COFF_SECTION_HEADER_SIZE));
                        if shdr_name_is_idata_subsec(view(shdr), 55u8) && shdr.number_of_relocations == 0u16 && shdr.size_of_raw_data > 0u32 {
                            let raw_off = shdr.pointer_to_raw_data as usize;
                            let raw_sz = shdr.size_of_raw_data as usize;
                            if raw_off > 0 && raw_off + raw_sz <= c_len {
                                let raw_ptr = unsafe { c_data + raw_off };
                                if (unsafe { *raw_ptr }) > 32u8 {
                                    let mut nlen: usize = 0;
                                    while nlen < raw_sz && (unsafe { *(raw_ptr + nlen) }) != 0u8 {
                                        nlen = nlen + 1;
                                    }
                                    if nlen > 0 {
                                        *out_len = nlen;
                                        return raw_ptr;
                                    }
                                }
                            }
                        }
                        s = s + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    *out_len = 0;
    0 as *const u8
}

fn linker_load_long_import_object(
    ctx: mut_view<LinkerContext>,
    imports: mut_view<ImportTable>,
    list: view<ArchiveCandidateList>,
    archive_id: usize,
    data: *const u8,
    data_len: usize,
    diag: *mut DiagSink
) -> bool {
    let mut dll_len: usize = 0;
    let dll_ptr = find_dll_name_in_long_import_archive(list, archive_id, mut_view(dll_len));
    if dll_len == 0 || (dll_ptr as usize) == 0 {
        linker_report_bad_archive(diag);
        return false;
    }

    let hdr = coff_decode_file_header(data, 0);
    let num_secs = hdr.number_of_sections as usize;
    let mut is_code: bool = false;
    let mut idata6_ptr: *const u8 = 0 as *const u8;
    let mut idata6_len: usize = 0;

    let mut s: usize = 0;
    while s < num_secs {
        let shdr = coff_decode_section_header(data, COFF_FILE_HEADER_SIZE + coff_mul_usize(s, COFF_SECTION_HEADER_SIZE));
        if shdr_name_is_text(view(shdr)) && shdr.size_of_raw_data > 0u32 {
            is_code = true;
        } else if shdr_name_is_idata_subsec(view(shdr), 54u8) && shdr.size_of_raw_data >= 3u32 {
            let roff = shdr.pointer_to_raw_data as usize;
            let rsz = shdr.size_of_raw_data as usize;
            if roff > 0 && roff + rsz <= data_len {
                idata6_ptr = unsafe { data + roff };
                idata6_len = rsz;
            }
        }
        s = s + 1;
    }

    if (idata6_ptr as usize) == 0 || idata6_len < 3 {
        linker_report_bad_archive(diag);
        return false;
    }

    let hint = coff_read_u16_le(idata6_ptr, 0);
    let name_ptr = unsafe { idata6_ptr + 2 };
    let max_name = idata6_len - 2;
    let mut sym_len: usize = 0;
    while sym_len < max_name && (unsafe { *(name_ptr + sym_len) }) != 0u8 {
        sym_len = sym_len + 1;
    }
    if sym_len == 0 {
        linker_report_bad_archive(diag);
        return false;
    }

    let sym_cstr = linker_dup_bytes(mut_view(*ctx), name_ptr, sym_len);
    let dll = import_find_or_add_dll_bytes(mut_view(*imports), mut_view(*ctx), dll_ptr, dll_len);
    let _ = import_add_func_ex(mut_view(*ctx), dll, sym_cstr, 0 as *const u8, hint, is_code);
    true
}

fn archive_candidate_is_needed_ex(
    ctx: view<LinkerContext>,
    imports: view<ImportTable>,
    dll_state: *const DllLinkState,
    data: *const u8,
    data_len: usize
) -> bool {
    if data as usize == 0 || data_len < COFF_FILE_HEADER_SIZE {
        return false;
    }
    let sig1 = coff_read_u16_le(data, 0);
    let sig2 = coff_read_u16_le(data, 2);
    if sig1 == IMPORT_OBJECT_HDR_SIG1 && sig2 == IMPORT_OBJECT_HDR_SIG2 {
        let shdr = coff_decode_short_import_header(data, 0);
        let payload_ptr = unsafe { data + COFF_SHORT_IMPORT_HEADER_SIZE };
        let payload_len = shdr.size_of_data as usize;
        let mut raw_sym_len: usize = 0;
        while raw_sym_len < payload_len && (unsafe { *(payload_ptr + raw_sym_len) }) != 0u8 {
            raw_sym_len = raw_sym_len + 1;
        }
        let name_type: u16 = (shdr.type_info >> 2) & 7u16;
        let mut eff_len: usize = 0;
        let eff_ptr = short_import_effective_name(payload_ptr, raw_sym_len, name_type, mut_view(eff_len));
        if (shdr.type_info & 3u16) == IMPORT_OBJECT_CODE {
            if linker_is_symbol_needed_bytes_ex(ctx, imports, dll_state, eff_ptr, eff_len) {
                return true;
            }
        }
        let mut imp_buf = coff_buf_with_capacity(6 + eff_len + 1);
        coff_buf_put_u8(mut_view(imp_buf), 95u8);
        coff_buf_put_u8(mut_view(imp_buf), 95u8);
        coff_buf_put_u8(mut_view(imp_buf), 105u8);
        coff_buf_put_u8(mut_view(imp_buf), 109u8);
        coff_buf_put_u8(mut_view(imp_buf), 112u8);
        coff_buf_put_u8(mut_view(imp_buf), 95u8);
        coff_buf_put_bytes(mut_view(imp_buf), eff_ptr, eff_len);
        coff_buf_put_u8(mut_view(imp_buf), 0u8);
        let imp_needed = linker_is_symbol_needed_cstr_ex(ctx, imports, dll_state, imp_buf.ptr as *const u8);
        coff_buf_free(mut_view(imp_buf));
        return imp_needed;
    }

    let long_imp_kind = classify_long_import_coff_member(data, data_len);
    if long_imp_kind == 1u32 {
        return false;
    }

    let hdr = coff_decode_file_header(data, 0);
    let symtab_off = hdr.pointer_to_symbol_table as usize;
    let num_syms = hdr.number_of_symbols as usize;
    if num_syms == 0 || symtab_off == 0 {
        return false;
    }
    let symtab_bytes = coff_mul_usize(num_syms, COFF_SYMBOL_SIZE);
    if symtab_off + symtab_bytes > data_len {
        return false;
    }
    let strtab_off = symtab_off + symtab_bytes;
    let mut s: usize = 0;
    while s < num_syms {
        let rec_off = symtab_off + coff_mul_usize(s, COFF_SYMBOL_SIZE);
        let rec = coff_decode_symbol_record(data, rec_off);
        if rec.storage_class == IMAGE_SYM_CLASS_EXTERNAL && rec.section_number > 0i16 {
            if rec.zeroes == 0u32 {
                let abs_off = strtab_off + (rec.offset as usize);
                if abs_off < data_len {
                    let mut nlen: usize = 0;
                    while abs_off + nlen < data_len && (unsafe { *(data + abs_off + nlen) }) != 0u8 {
                        nlen = nlen + 1;
                    }
                    if nlen > 0 && linker_is_symbol_needed_bytes_ex(ctx, imports, dll_state, unsafe { data + abs_off }, nlen) {
                        return true;
                    }
                }
            } else {
                let mut nlen: usize = 0;
                while nlen < 8 && (unsafe { *(data + rec_off + nlen) }) != 0u8 {
                    nlen = nlen + 1;
                }
                if nlen > 0 && linker_is_symbol_needed_bytes_ex(ctx, imports, dll_state, unsafe { data + rec_off }, nlen) {
                    return true;
                }
            }
        }
        s = s + 1 + (rec.number_of_aux_symbols as usize);
    }
    false
}

fn linker_extract_needed_archive_members_ex(
    ctx: mut_view<LinkerContext>,
    imports: mut_view<ImportTable>,
    dll_state: *mut DllLinkState,
    list: mut_view<ArchiveCandidateList>,
    diag: *mut DiagSink
) -> bool {
    let mut changed: bool = true;
    while changed {
        changed = false;
        let mut i: usize = 0;
        while i < list.len {
            let cand = unsafe { archive_cand_slot(list.ptr, i) };
            if !(unsafe { (*cand).extracted }) {
                let c_data = unsafe { (*cand).data };
                let c_len = unsafe { (*cand).data_len };
                let c_arch = unsafe { (*cand).archive_id };
                if archive_candidate_is_needed_ex(view(*ctx), view(*imports), dll_state as *const DllLinkState, c_data, c_len) {
                    unsafe {
                        (*cand).extracted = true;
                    }
                    changed = true;
                    let sig1 = coff_read_u16_le(c_data, 0);
                    let sig2 = coff_read_u16_le(c_data, 2);
                    if sig1 == IMPORT_OBJECT_HDR_SIG1 && sig2 == IMPORT_OBJECT_HDR_SIG2 {
                        if !linker_load_short_import_object(mut_view(*ctx), mut_view(*imports), c_data, c_len, diag) {
                            return false;
                        }
                    } else if classify_long_import_coff_member(c_data, c_len) == 2u32 {
                        if !linker_load_long_import_object(mut_view(*ctx), mut_view(*imports), view(*list), c_arch, c_data, c_len, diag) {
                            return false;
                        }
                    } else {
                        if !linker_load_coff_object_ex(mut_view(*ctx), c_data, c_len, dll_state, diag) {
                            return false;
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
    true
}

fn linker_extract_needed_archive_members(
    ctx: mut_view<LinkerContext>,
    imports: mut_view<ImportTable>,
    list: mut_view<ArchiveCandidateList>,
    diag: *mut DiagSink
) -> bool {
    linker_extract_needed_archive_members_ex(ctx, imports, 0 as *mut DllLinkState, list, diag)
}

// Rewrites `<prefix>$<bare>` or `__imp_<prefix>$<bare>` relocation targets when `<bare>` is
// statically defined in `ctx.globals` or imported via a Short Import Object in `imports`.
fn linker_rewrite_resolved_dollar_relocs(ctx: mut_view<LinkerContext>, imports: view<ImportTable>) {
    let mut i: usize = 0;
    while i < ctx.num_relocs {
        let rel = linker_reloc_at(view(*ctx), i);
        let dsec = unsafe { (*rel).dsec };
        let sname = unsafe { (*rel).sym_name };
        if (dsec as usize) == 0 && (sname as usize) != 0 && (unsafe { *sname }) != 0u8 {
            let existing = linker_find_global(view(*ctx), sname);
            let is_defined = if (existing as usize) != 0 { unsafe { (*existing).defined } } else { false };
            if !is_defined {
                if has_imp_prefix_cstr(sname) {
                    let target = unsafe { sname + 6 };
                    let d_idx = pe_cstr_find_char(target, 36u8); // '$'
                    if d_idx >= 0 {
                        let bare = unsafe { target + (d_idx as usize) + 1 };
                        let imp_bare = make_imp_sym_cstr(mut_view(*ctx), bare);
                        let g_imp = linker_find_global(view(*ctx), imp_bare);
                        let g_imp_def = if (g_imp as usize) != 0 { unsafe { (*g_imp).defined } } else { false };
                        if g_imp_def || import_has_func(imports, bare) {
                            unsafe {
                                (*rel).sym_name = imp_bare;
                            }
                        }
                    }
                } else if !has_iat_prefix_cstr(sname) {
                    let d_idx = pe_cstr_find_char(sname, 36u8); // '$'
                    if d_idx >= 0 {
                        let bare = unsafe { sname + (d_idx as usize) + 1 };
                        let g_bare = linker_find_global(view(*ctx), bare);
                        let g_bare_def = if (g_bare as usize) != 0 { unsafe { (*g_bare).defined } } else { false };
                        if g_bare_def || import_has_func(imports, bare) {
                            let dup_bare = linker_dup_cstr(mut_view(*ctx), bare);
                            unsafe {
                                (*rel).sym_name = dup_bare;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

fn linker_finalize_with_archives_to_buf(
    ctx: mut_view<LinkerContext>,
    candidates: mut_view<ArchiveCandidateList>,
    stack_reserve: u32,
    out: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    coff_buf_clear(mut_view(*out));

    let axiom_start_offset = linker_emit_runtime_stubs(mut_view(*ctx));
    let mut imports = import_table_new();
    import_add_base_kernel32(mut_view(imports), mut_view(*ctx));

    if candidates.len > 0 {
        if !linker_extract_needed_archive_members(mut_view(*ctx), mut_view(imports), mut_view(*candidates), diag) {
            import_table_free(mut_view(imports));
            return false;
        }
    }

    linker_rewrite_resolved_dollar_relocs(mut_view(*ctx), view(imports));
    import_discover_from_relocs(mut_view(imports), mut_view(*ctx));

    let text_sec = linker_get_or_create_section_str(mut_view(*ctx), { ".text" }, 0u32);
    import_emit_thunks(view(imports), mut_view(*ctx), text_sec);

    let idata_sec = import_build_idata_section(mut_view(imports), mut_view(*ctx));
    let size_of_image = linker_assign_rvas(mut_view(*ctx), PE_DEFAULT_FILE_ALIGN, PE_DEFAULT_SECTION_ALIGN);
    import_patch_idata_rvas(view(imports), idata_sec);

    if !linker_apply_relocations(mut_view(*ctx), pe_default_image_base(), diag) {
        import_table_free(mut_view(imports));
        return false;
    }

    let ok = linker_emit_pe_image(view(*ctx), view(imports), axiom_start_offset, size_of_image, stack_reserve, out);
    import_table_free(mut_view(imports));
    ok
}

// Complete pipeline on an already-loaded `LinkerContext`: emits runtime stubs, synthesizes imports
// and `.idata`, computes RVAs, patches `.idata` and relocations, and emits the PE32+ executable into `out`.
pub fn linker_finalize_to_buf(ctx: mut_view<LinkerContext>, stack_reserve: u32, out: mut_view<CoffBuf>, diag: *mut DiagSink) -> bool {
    let mut empty_cands = archive_cand_list_new();
    let ok = linker_finalize_with_archives_to_buf(ctx, mut_view(empty_cands), stack_reserve, out, diag);
    archive_cand_list_free(mut_view(empty_cands));
    ok
}

// --- High-Level In-Memory & File-Based PE32+ Linker Entry Points ---

unsafe fn const_ptr_slot(base: *const *const u8, idx: usize) -> *const u8 {
    let slot = ((base as usize) + coff_mul_usize(idx, size_of<*const u8>())) as *const *const u8;
    *slot
}

unsafe fn usize_slot(base: *const usize, idx: usize) -> usize {
    let slot = ((base as usize) + coff_mul_usize(idx, size_of<usize>())) as *const usize;
    *slot
}

pub fn pe_link_coff_buffers_to_buf(
    obj_ptrs: *const *const u8,
    obj_lens: *const usize,
    input_count: usize,
    stack_reserve: u32,
    out: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    let mut ctx = LinkerContext {
        sections: 0 as *mut *mut MergedSection,
        num_sections: 0,
        cap_sections: 0,
        globals: 0 as *mut compiler.link.pe.GlobalSymbol,
        num_globals: 0,
        cap_globals: 0,
        relocs: 0 as *mut compiler.link.pe.PeReloc,
        num_relocs: 0,
        cap_relocs: 0,
        str_arena: 0 as *mut compiler.kernel.arena.Arena,
    };
    linker_context_init(mut_view(ctx));
    let mut candidates = archive_cand_list_new();

    let mut i: usize = 0;
    while i < input_count {
        let p = unsafe { const_ptr_slot(obj_ptrs, i) };
        let l = unsafe { usize_slot(obj_lens, i) };
        if coff_is_archive_bytes(p, l) {
            if !linker_collect_archive_candidates(mut_view(candidates), p, l, diag) {
                archive_cand_list_free(mut_view(candidates));
                linker_context_free(mut_view(ctx));
                return false;
            }
        } else {
            if !linker_load_coff_object(mut_view(ctx), p, l, diag) {
                archive_cand_list_free(mut_view(candidates));
                linker_context_free(mut_view(ctx));
                return false;
            }
        }
        i = i + 1;
    }

    let ok = linker_finalize_with_archives_to_buf(mut_view(ctx), mut_view(candidates), stack_reserve, out, diag);
    archive_cand_list_free(mut_view(candidates));
    linker_context_free(mut_view(ctx));
    ok
}

pub fn pe_link_single_coff_to_buf(
    obj_ptr: *const u8,
    obj_len: usize,
    stack_reserve: u32,
    out: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    let mut ptrs: [1]*const u8 = [obj_ptr];
    let mut lens: [1]usize = [obj_len];
    let pptrs = unsafe { address_of(ptrs[0]) };
    let plens = unsafe { address_of(lens[0]) };
    pe_link_coff_buffers_to_buf(pptrs, plens, 1, stack_reserve, out, diag)
}

pub fn pe_link_objmodel_to_buf(
    model: view<ObjModel>,
    stack_reserve: u32,
    out: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    let mut obj_buf = coff_encode_bytes(model);
    let ok = pe_link_single_coff_to_buf(obj_buf.ptr as *const u8, obj_buf.len, stack_reserve, out, diag);
    coff_buf_free(mut_view(obj_buf));
    ok
}

pub fn pe_write_buf_to_path_bytes(buf: view<CoffBuf>, path_ptr: *const u8, path_len: usize) -> bool {
    if (path_ptr as usize) == 0 || path_len == 0 {
        return false;
    }
    let h = unsafe { open(path_ptr, path_len, 1u32) };
    if h < 0 {
        return false;
    }
    let n = buf.len;
    if n > 0 && (buf.ptr as usize) != 0 {
        let mut total_written: usize = 0;
        while total_written < n {
            let src = unsafe { (buf.ptr as *const u8) + total_written };
            let rem = n - total_written;
            let wr = unsafe { write(h, src, rem) };
            if wr <= 0 {
                let _ = close(h);
                return false;
            }
            total_written = total_written + (wr as usize);
        }
    }
    let cl = close(h);
    cl >= 0
}

pub fn pe_write_buf_to_file(buf: view<CoffBuf>, output_path: *const u8) -> bool {
    if (output_path as usize) == 0 {
        return false;
    }
    pe_write_buf_to_path_bytes(buf, output_path, cstr_len(output_path))
}

pub fn pe_write_buf_to_file_str(buf: view<CoffBuf>, output_path: Str) -> bool {
    let mut path_buf = pe_str_to_cstr_buf(output_path);
    let plen = path_buf.len - 1;
    if plen == 0 {
        coff_buf_free(mut_view(path_buf));
        return false;
    }
    let ok = pe_write_buf_to_path_bytes(buf, path_buf.ptr as *const u8, plen);
    coff_buf_free(mut_view(path_buf));
    ok
}

struct LoadedFileBufList {
    ptr: *mut CoffBuf,
    len: usize,
    cap: usize,
}

fn loaded_file_buf_list_new() -> LoadedFileBufList {
    LoadedFileBufList {
        ptr: 0 as *mut CoffBuf,
        len: 0,
        cap: 0,
    }
}

unsafe fn loaded_file_buf_slot(base: *mut CoffBuf, idx: usize) -> *mut CoffBuf {
    ((base as usize) + coff_mul_usize(idx, size_of<CoffBuf>())) as *mut CoffBuf
}

fn loaded_file_buf_list_free(list: mut_view<LoadedFileBufList>) {
    let mut i: usize = 0;
    while i < list.len {
        let slot = unsafe { loaded_file_buf_slot(list.ptr, i) };
        coff_buf_free(unsafe { mut_view(*slot) });
        i = i + 1;
    }
    if list.cap > 0 && list.ptr as usize != 0 {
        unsafe {
            heap_free(
                list.ptr as *mut u8,
                coff_mul_usize(list.cap, size_of<CoffBuf>()),
                align_of<CoffBuf>()
            );
        }
    }
    list.ptr = 0 as *mut CoffBuf;
    list.len = 0;
    list.cap = 0;
}

fn loaded_file_buf_list_push(list: mut_view<LoadedFileBufList>, b: CoffBuf) -> *mut CoffBuf {
    if list.len == list.cap {
        let new_cap = if list.cap == 0 { 8 } else { list.cap + list.cap };
        let esz = size_of<CoffBuf>();
        let eal = align_of<CoffBuf>();
        let new_ptr = unsafe { heap_alloc(coff_mul_usize(new_cap, esz), eal) as *mut CoffBuf };
        if list.len > 0 && list.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    list.ptr as *const u8,
                    new_ptr as *mut u8,
                    coff_mul_usize(list.len, esz)
                );
                heap_free(list.ptr as *mut u8, coff_mul_usize(list.cap, esz), eal);
            }
        }
        list.ptr = new_ptr;
        list.cap = new_cap;
    }
    let slot = unsafe { loaded_file_buf_slot(list.ptr, list.len) };
    unsafe {
        (*slot).ptr = b.ptr;
        (*slot).len = b.len;
        (*slot).cap = b.cap;
    }
    // Disarm local `b` so Drop does not free `b.ptr`
    let mut b_mut = b;
    b_mut.ptr = 0 as *mut u8;
    b_mut.len = 0;
    b_mut.cap = 0;
    list.len = list.len + 1;
    slot
}

fn linker_file_exists_bytes(path_ptr: *const u8, path_len: usize) -> bool {
    if path_ptr as usize == 0 || path_len == 0 {
        return false;
    }
    let h = unsafe { open(path_ptr, path_len, 0u32) };
    if h >= 0 {
        let _ = close(h);
        return true;
    }
    false
}

fn linker_try_lib_candidate(
    dir_ptr: *const u8,
    dir_len: usize,
    prefix_ptr: *const u8,
    prefix_len: usize,
    name_ptr: *const u8,
    name_len: usize,
    ext_ptr: *const u8,
    ext_len: usize,
    out_path: mut_view<CoffBuf>
) -> bool {
    coff_buf_clear(mut_view(*out_path));
    if dir_len > 0 && dir_ptr as usize != 0 {
        coff_buf_put_bytes(mut_view(*out_path), dir_ptr, dir_len);
        let last_ch = unsafe { *(dir_ptr + (dir_len - 1)) };
        if last_ch != 47u8 && last_ch != 92u8 {
            coff_buf_put_u8(mut_view(*out_path), 92u8); // '\\'
        }
    }
    if prefix_len > 0 && prefix_ptr as usize != 0 {
        coff_buf_put_bytes(mut_view(*out_path), prefix_ptr, prefix_len);
    }
    coff_buf_put_bytes(mut_view(*out_path), name_ptr, name_len);
    if ext_len > 0 && ext_ptr as usize != 0 {
        coff_buf_put_bytes(mut_view(*out_path), ext_ptr, ext_len);
    }
    let plen = out_path.len;
    coff_buf_put_u8(mut_view(*out_path), 0u8);
    if linker_file_exists_bytes(out_path.ptr as *const u8, plen) {
        out_path.len = plen;
        return true;
    }
    false
}

// Searches `-L` directories in order for `<name>` (when `<name>` already carries `.lib`/`.a`) or
// `<name>.lib` -> `lib<name>.lib` -> `lib<name>.a` -> `<name>.a` (SPEC-26 AXS-WLIB-003 item 2).
pub fn linker_resolve_library_in_dirs(
    lib_name: *const u8,
    lib_dirs: *const *const u8,
    num_lib_dirs: usize,
    out_path: mut_view<CoffBuf>
) -> bool {
    let nlen = cstr_len(lib_name);
    if nlen == 0 {
        return false;
    }
    let ext_lib: [4]u8 = [46u8, 108u8, 105u8, 98u8]; // ".lib"
    let ext_a: [2]u8 = [46u8, 97u8]; // ".a"
    let pfx_lib: [3]u8 = [108u8, 105u8, 98u8]; // "lib"
    let p_ext_lib = unsafe { address_of(ext_lib[0]) };
    let p_ext_a = unsafe { address_of(ext_a[0]) };
    let p_pfx_lib = unsafe { address_of(pfx_lib[0]) };
    let has_arch_ext = linker_path_is_archive_ext(lib_name, nlen);

    let mut d: usize = 0;
    while d < num_lib_dirs {
        let dir_ptr = unsafe { const_ptr_slot(lib_dirs, d) };
        let dir_len = cstr_len(dir_ptr);
        if dir_len > 0 {
            if has_arch_ext {
                if linker_try_lib_candidate(dir_ptr, dir_len, 0 as *const u8, 0, lib_name, nlen, 0 as *const u8, 0, mut_view(*out_path)) {
                    return true;
                }
            } else {
                if linker_try_lib_candidate(dir_ptr, dir_len, 0 as *const u8, 0, lib_name, nlen, p_ext_lib, 4, mut_view(*out_path)) {
                    return true;
                }
                if linker_try_lib_candidate(dir_ptr, dir_len, p_pfx_lib, 3, lib_name, nlen, p_ext_lib, 4, mut_view(*out_path)) {
                    return true;
                }
                if linker_try_lib_candidate(dir_ptr, dir_len, p_pfx_lib, 3, lib_name, nlen, p_ext_a, 2, mut_view(*out_path)) {
                    return true;
                }
                if linker_try_lib_candidate(dir_ptr, dir_len, 0 as *const u8, 0, lib_name, nlen, p_ext_a, 2, mut_view(*out_path)) {
                    return true;
                }
            }
        }
        d = d + 1;
    }

    if has_arch_ext && linker_try_lib_candidate(0 as *const u8, 0, 0 as *const u8, 0, lib_name, nlen, 0 as *const u8, 0, mut_view(*out_path)) {
        return true;
    }
    false
}

fn match_sys_dll_str(stem_ptr: *const u8, stem_len: usize, target: Str) -> bool {
    let bytes: view<[u8]> = unsafe { *(address_of(target) as *const view<[u8]>) };
    let tlen = len(bytes);
    if stem_len != tlen {
        return false;
    }
    let mut tmp = coff_buf_with_capacity(tlen + 1);
    let mut i: usize = 0;
    while i < tlen {
        coff_buf_put_u8(mut_view(tmp), bytes[i]);
        i = i + 1;
    }
    let eq = pe_bytes_ieq(stem_ptr, stem_len, tmp.ptr as *const u8, tlen);
    coff_buf_free(mut_view(tmp));
    eq
}

pub fn linker_is_known_system_dll(lib_name: *const u8) -> bool {
    let mut nlen = cstr_len(lib_name);
    if nlen == 0 {
        return false;
    }
    let dll_ext: [4]u8 = [46u8, 100u8, 108u8, 108u8]; // ".dll"
    let lib_ext: [4]u8 = [46u8, 108u8, 105u8, 98u8]; // ".lib"
    if nlen > 4 {
        let tail = unsafe { lib_name + (nlen - 4) };
        if pe_bytes_ieq(tail, 4, unsafe { address_of(dll_ext[0]) }, 4) ||
           pe_bytes_ieq(tail, 4, unsafe { address_of(lib_ext[0]) }, 4) {
            nlen = nlen - 4;
        }
    }
    match_sys_dll_str(lib_name, nlen, { "kernel32" }) ||
    match_sys_dll_str(lib_name, nlen, { "user32" }) ||
    match_sys_dll_str(lib_name, nlen, { "gdi32" }) ||
    match_sys_dll_str(lib_name, nlen, { "ws2_32" }) ||
    match_sys_dll_str(lib_name, nlen, { "advapi32" }) ||
    match_sys_dll_str(lib_name, nlen, { "shell32" }) ||
    match_sys_dll_str(lib_name, nlen, { "ole32" }) ||
    match_sys_dll_str(lib_name, nlen, { "oleaut32" }) ||
    match_sys_dll_str(lib_name, nlen, { "uuid" }) ||
    match_sys_dll_str(lib_name, nlen, { "comdlg32" }) ||
    match_sys_dll_str(lib_name, nlen, { "comctl32" }) ||
    match_sys_dll_str(lib_name, nlen, { "shlwapi" }) ||
    match_sys_dll_str(lib_name, nlen, { "version" }) ||
    match_sys_dll_str(lib_name, nlen, { "winmm" }) ||
    match_sys_dll_str(lib_name, nlen, { "imm32" }) ||
    match_sys_dll_str(lib_name, nlen, { "crypt32" }) ||
    match_sys_dll_str(lib_name, nlen, { "secur32" }) ||
    match_sys_dll_str(lib_name, nlen, { "bcrypt" }) ||
    match_sys_dll_str(lib_name, nlen, { "ncrypt" }) ||
    match_sys_dll_str(lib_name, nlen, { "iphlpapi" }) ||
    match_sys_dll_str(lib_name, nlen, { "psapi" }) ||
    match_sys_dll_str(lib_name, nlen, { "dbghelp" }) ||
    match_sys_dll_str(lib_name, nlen, { "msvcrt" }) ||
    match_sys_dll_str(lib_name, nlen, { "ucrt" }) ||
    match_sys_dll_str(lib_name, nlen, { "ucrtbase" }) ||
    match_sys_dll_str(lib_name, nlen, { "vcruntime140" }) ||
    match_sys_dll_str(lib_name, nlen, { "ntdll" })
}

pub fn pe_link_obj_and_libs_to_buf(
    mem_obj_ptr: *const u8,
    mem_obj_len: usize,
    input_paths: *const *const u8,
    input_count: usize,
    lib_dirs: *const *const u8,
    num_lib_dirs: usize,
    lib_names: *const *const u8,
    num_lib_names: usize,
    attr_libs: *const *const u8,
    num_attr_libs: usize,
    stack_reserve: u32,
    out: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    let mut ctx = LinkerContext {
        sections: 0 as *mut *mut MergedSection,
        num_sections: 0,
        cap_sections: 0,
        globals: 0 as *mut compiler.link.pe.GlobalSymbol,
        num_globals: 0,
        cap_globals: 0,
        relocs: 0 as *mut compiler.link.pe.PeReloc,
        num_relocs: 0,
        cap_relocs: 0,
        str_arena: 0 as *mut compiler.kernel.arena.Arena,
    };
    linker_context_init(mut_view(ctx));
    let mut file_bufs = loaded_file_buf_list_new();
    let mut candidates = archive_cand_list_new();

    if mem_obj_len > 0 && (mem_obj_ptr as usize) != 0 {
        if !linker_load_coff_object(mut_view(ctx), mem_obj_ptr, mem_obj_len, diag) {
            archive_cand_list_free(mut_view(candidates));
            loaded_file_buf_list_free(mut_view(file_bufs));
            linker_context_free(mut_view(ctx));
            return false;
        }
    }

    // 1. Load positional `.obj` and `.lib`/`.a` inputs
    let mut i: usize = 0;
    while i < input_count {
        let p = unsafe { const_ptr_slot(input_paths, i) };
        let plen = cstr_len(p);
        let is_arch_ext = linker_path_is_archive_ext(p, plen);
        let mut fbuf = coff_buf_with_capacity(256);
        if !linker_read_file_bytes(p, plen, mut_view(fbuf)) {
            coff_buf_free(mut_view(fbuf));
            if is_arch_ext {
                linker_report_bad_archive(diag);
            } else {
                linker_report_bad_object(diag);
            }
            archive_cand_list_free(mut_view(candidates));
            loaded_file_buf_list_free(mut_view(file_bufs));
            linker_context_free(mut_view(ctx));
            return false;
        }
        let slot = loaded_file_buf_list_push(mut_view(file_bufs), fbuf);
        let b_ptr = unsafe { (*slot).ptr as *const u8 };
        let b_len = unsafe { (*slot).len };
        if is_arch_ext || coff_is_archive_bytes(b_ptr, b_len) {
            if !linker_collect_archive_candidates(mut_view(candidates), b_ptr, b_len, diag) {
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
        } else {
            if !linker_load_coff_object(mut_view(ctx), b_ptr, b_len, diag) {
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
        }
        i = i + 1;
    }

    // 2. Resolve explicit `-l<name>` libraries via `-L<dir>` (AXS-WLIB-003)
    let mut resolved_path = coff_buf_with_capacity(256);
    i = 0;
    while i < num_lib_names {
        let lname = unsafe { const_ptr_slot(lib_names, i) };
        if linker_resolve_library_in_dirs(lname, lib_dirs, num_lib_dirs, mut_view(resolved_path)) {
            let mut lbuf = coff_buf_with_capacity(256);
            if !linker_read_file_bytes(resolved_path.ptr as *const u8, resolved_path.len, mut_view(lbuf)) {
                coff_buf_free(mut_view(lbuf));
                coff_buf_free(mut_view(resolved_path));
                linker_report_bad_archive(diag);
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
            let slot = loaded_file_buf_list_push(mut_view(file_bufs), lbuf);
            if !linker_collect_archive_candidates(
                mut_view(candidates),
                unsafe { (*slot).ptr as *const u8 },
                unsafe { (*slot).len },
                diag
            ) {
                coff_buf_free(mut_view(resolved_path));
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
        } else if !linker_is_known_system_dll(lname) {
            coff_buf_free(mut_view(resolved_path));
            linker_report_library_not_found(diag, lname);
            archive_cand_list_free(mut_view(candidates));
            loaded_file_buf_list_free(mut_view(file_bufs));
            linker_context_free(mut_view(ctx));
            return false;
        }
        i = i + 1;
    }

    // 3. Resolve `@link("<name>")` attributes against `-L<dir>` when a matching `.lib`/`.a` exists;
    //    if not found in `-L`, fall back to synthetic PE import table generation (AXS-WLIB-003).
    i = 0;
    while i < num_attr_libs {
        let alname = unsafe { const_ptr_slot(attr_libs, i) };
        if linker_resolve_library_in_dirs(alname, lib_dirs, num_lib_dirs, mut_view(resolved_path)) {
            let mut abuf = coff_buf_with_capacity(256);
            if !linker_read_file_bytes(resolved_path.ptr as *const u8, resolved_path.len, mut_view(abuf)) {
                coff_buf_free(mut_view(abuf));
                coff_buf_free(mut_view(resolved_path));
                linker_report_bad_archive(diag);
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
            let slot = loaded_file_buf_list_push(mut_view(file_bufs), abuf);
            if !linker_collect_archive_candidates(
                mut_view(candidates),
                unsafe { (*slot).ptr as *const u8 },
                unsafe { (*slot).len },
                diag
            ) {
                coff_buf_free(mut_view(resolved_path));
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
        }
        i = i + 1;
    }
    coff_buf_free(mut_view(resolved_path));

    let ok = linker_finalize_with_archives_to_buf(mut_view(ctx), mut_view(candidates), stack_reserve, out, diag);
    archive_cand_list_free(mut_view(candidates));
    loaded_file_buf_list_free(mut_view(file_bufs));
    linker_context_free(mut_view(ctx));
    ok
}

pub fn pe_link_with_libs_to_buf(
    input_paths: *const *const u8,
    input_count: usize,
    lib_dirs: *const *const u8,
    num_lib_dirs: usize,
    lib_names: *const *const u8,
    num_lib_names: usize,
    attr_libs: *const *const u8,
    num_attr_libs: usize,
    stack_reserve: u32,
    out: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    pe_link_obj_and_libs_to_buf(
        0 as *const u8,
        0,
        input_paths,
        input_count,
        lib_dirs,
        num_lib_dirs,
        lib_names,
        num_lib_names,
        attr_libs,
        num_attr_libs,
        stack_reserve,
        out,
        diag
    )
}

pub fn pe_link_with_libs(
    input_paths: *const *const u8,
    input_count: usize,
    lib_dirs: *const *const u8,
    num_lib_dirs: usize,
    lib_names: *const *const u8,
    num_lib_names: usize,
    attr_libs: *const *const u8,
    num_attr_libs: usize,
    output_path: *const u8,
    stack_reserve: u32,
    diag: *mut DiagSink
) -> bool {
    if (output_path as usize) == 0 || cstr_len(output_path) == 0 {
        return false;
    }
    let mut pe_buf = coff_buf_with_capacity(4096);
    if !pe_link_with_libs_to_buf(
        input_paths,
        input_count,
        lib_dirs,
        num_lib_dirs,
        lib_names,
        num_lib_names,
        attr_libs,
        num_attr_libs,
        stack_reserve,
        mut_view(pe_buf),
        diag
    ) {
        coff_buf_free(mut_view(pe_buf));
        return false;
    }
    let ok = pe_write_buf_to_file(view(pe_buf), output_path);
    coff_buf_free(mut_view(pe_buf));
    ok
}

pub fn pe_link_files_to_buf(
    input_paths: *const *const u8,
    input_count: usize,
    stack_reserve: u32,
    out: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    pe_link_with_libs_to_buf(
        input_paths,
        input_count,
        0 as *const *const u8,
        0,
        0 as *const *const u8,
        0,
        0 as *const *const u8,
        0,
        stack_reserve,
        out,
        diag
    )
}

pub fn pe_link(
    input_paths: *const *const u8,
    input_count: usize,
    output_path: *const u8,
    stack_reserve: u32,
    diag: *mut DiagSink
) -> bool {
    if (output_path as usize) == 0 || cstr_len(output_path) == 0 {
        return false;
    }
    let mut pe_buf = coff_buf_with_capacity(4096);
    if !pe_link_files_to_buf(input_paths, input_count, stack_reserve, mut_view(pe_buf), diag) {
        coff_buf_free(mut_view(pe_buf));
        return false;
    }
    let ok = pe_write_buf_to_file(view(pe_buf), output_path);
    coff_buf_free(mut_view(pe_buf));
    ok
}

pub fn ax_pe_link(
    input_paths: *const *const u8,
    input_count: usize,
    output_path: *const u8,
    stack_reserve: u32,
    diag: *mut DiagSink
) -> bool {
    pe_link(input_paths, input_count, output_path, stack_reserve, diag)
}

pub fn pe_link_one_file(
    input_path: *const u8,
    output_path: *const u8,
    stack_reserve: u32,
    diag: *mut DiagSink
) -> bool {
    let mut inputs: [1]*const u8 = [input_path];
    let p_inputs = unsafe { address_of(inputs[0]) };
    pe_link(p_inputs, 1, output_path, stack_reserve, diag)
}

pub fn pe_link_one_file_str(
    input_path: Str,
    output_path: Str,
    stack_reserve: u32,
    diag: *mut DiagSink
) -> bool {
    let mut in_buf = pe_str_to_cstr_buf(input_path);
    let mut out_buf = pe_str_to_cstr_buf(output_path);
    if in_buf.len <= 1 || out_buf.len <= 1 {
        coff_buf_free(mut_view(in_buf));
        coff_buf_free(mut_view(out_buf));
        return false;
    }

    let ok = pe_link_one_file(in_buf.ptr as *const u8, out_buf.ptr as *const u8, stack_reserve, diag);
    coff_buf_free(mut_view(in_buf));
    coff_buf_free(mut_view(out_buf));
    ok
}

pub fn pe_link_objmodel_to_file_str(
    model: view<ObjModel>,
    output_path: Str,
    stack_reserve: u32,
    diag: *mut DiagSink
) -> bool {
    let mut pe_buf = coff_buf_with_capacity(4096);
    if !pe_link_objmodel_to_buf(model, stack_reserve, mut_view(pe_buf), diag) {
        coff_buf_free(mut_view(pe_buf));
        return false;
    }
    let ok = pe_write_buf_to_file_str(view(pe_buf), output_path);
    coff_buf_free(mut_view(pe_buf));
    ok
}

// --- PE32+ DLL Output: `.edata`, `.reloc`, Image & Companion Short-Import `.lib` (SPEC-26) ---

fn sort_dll_exports_by_name(st: mut_view<DllLinkState>) {
    let n = st.num_exports;
    if n < 2 {
        return;
    }
    let mut i: usize = 1;
    while i < n {
        let cur_ptr = dll_export_at(view(*st), i);
        let key_spec = unsafe { *cur_ptr };
        let mut j: usize = i;
        while j > 0 {
            let prev_ptr = dll_export_at(view(*st), j - 1);
            let prev_name = unsafe { (*prev_ptr).ext_name };
            if pe_cstr_cmp(prev_name, key_spec.ext_name) > 0i32 {
                let dst_ptr = dll_export_at(view(*st), j);
                unsafe {
                    *dst_ptr = *prev_ptr;
                }
                j = j - 1;
            } else {
                break;
            }
        }
        let ins_ptr = dll_export_at(view(*st), j);
        unsafe {
            *ins_ptr = key_spec;
        }
        i = i + 1;
    }
}

// Validates exports (rejects duplicates with `AX_LINK_DUPLICATE_EXPORT` and missing internal
// symbols with `AX_LINK_UNDEFINED_SYMBOL`), sorts exports lexicographically by ASCII name, and
// constructs the `.edata` section when `num_exports > 0` (`AXS-WLIB-021`).
pub fn pe_build_edata_section(
    dll_state: mut_view<DllLinkState>,
    ctx: mut_view<LinkerContext>,
    dll_basename: *const u8,
    out_dll_name_off: mut_view<u32>,
    diag: *mut DiagSink
) -> *mut MergedSection {
    *out_dll_name_off = 0u32;
    let num_exp = dll_state.num_exports;
    if num_exp == 0 {
        return 0 as *mut MergedSection;
    }

    sort_dll_exports_by_name(mut_view(*dll_state));

    let mut i: usize = 0;
    while i + 1 < num_exp {
        let e0 = dll_export_at(view(*dll_state), i);
        let e1 = dll_export_at(view(*dll_state), i + 1);
        let n0 = unsafe { (*e0).ext_name };
        let n1 = unsafe { (*e1).ext_name };
        if cstr_eq(n0, n1) {
            linker_report_duplicate_export(diag, n0);
            return 0 as *mut MergedSection;
        }
        i = i + 1;
    }

    i = 0;
    while i < num_exp {
        let e = dll_export_at(view(*dll_state), i);
        let int_name = unsafe { (*e).internal_name };
        let g = linker_find_global(view(*ctx), int_name);
        if (g as usize) == 0 || !(unsafe { (*g).defined }) {
            linker_report_undefined_symbol(diag, int_name);
            return 0 as *mut MergedSection;
        }
        i = i + 1;
    }

    let edata_chars = IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    let edata_sec = linker_get_or_create_section_str(mut_view(*ctx), { ".edata" }, edata_chars);

    let tables_bytes: usize = PE_EXPORT_DIRECTORY_SIZE + coff_mul_usize(num_exp, 10);
    let mut edata_buf = coff_buf_with_capacity(tables_bytes + 256);
    pe_buf_put_zeroes(mut_view(edata_buf), tables_bytes);

    let dll_name_off: u32 = edata_buf.len as u32;
    *out_dll_name_off = dll_name_off;
    let dlen = cstr_len(dll_basename);
    if dlen > 0 {
        coff_buf_put_bytes(mut_view(edata_buf), dll_basename, dlen);
    }
    coff_buf_put_u8(mut_view(edata_buf), 0u8);

    i = 0;
    while i < num_exp {
        let e = dll_export_at(view(*dll_state), i);
        let name_off: u32 = edata_buf.len as u32;
        unsafe {
            (*e).rva = name_off; // Temporarily stash string offset until section RVAs are assigned
        }
        let ename = unsafe { (*e).ext_name };
        let elen = cstr_len(ename);
        coff_buf_put_bytes(mut_view(edata_buf), ename, elen);
        coff_buf_put_u8(mut_view(edata_buf), 0u8);
        i = i + 1;
    }

    let mut base_out: [1]u32 = [0u32];
    let pbase = unsafe { address_of(base_out[0]) as *mut u32 };
    linker_append_section_data(edata_sec, edata_buf.ptr as *const u8, edata_buf.len as u32, 4u32, pbase);
    coff_buf_free(mut_view(edata_buf));
    edata_sec
}

pub fn pe_patch_edata_rvas(
    dll_state: mut_view<DllLinkState>,
    ctx: view<LinkerContext>,
    edata_sec: *mut MergedSection,
    dll_name_off: u32
) {
    if (edata_sec as usize) == 0 || dll_state.num_exports == 0 {
        return;
    }
    let num_exp = dll_state.num_exports;
    let edata_rva = unsafe { (*edata_sec).rva };
    let sec_data = unsafe { (*edata_sec).data };

    let eat_off: u32 = PE_EXPORT_DIRECTORY_SIZE as u32;
    let enpt_off: u32 = eat_off + coff_mul_u32(num_exp as u32, 4u32);
    let eot_off: u32 = enpt_off + coff_mul_u32(num_exp as u32, 4u32);

    // IMAGE_EXPORT_DIRECTORY (40 bytes):
    // +0 Characteristics=0, +4 TimeDateStamp=0, +8 Major=0, +10 Minor=0
    coff_write_u32_le(sec_data, 12, edata_rva + dll_name_off); // Name RVA
    coff_write_u32_le(sec_data, 16, 1u32);                     // Base = 1
    coff_write_u32_le(sec_data, 20, num_exp as u32);           // NumberOfFunctions
    coff_write_u32_le(sec_data, 24, num_exp as u32);           // NumberOfNames
    coff_write_u32_le(sec_data, 28, edata_rva + eat_off);      // AddressOfFunctions
    coff_write_u32_le(sec_data, 32, edata_rva + enpt_off);     // AddressOfNames
    coff_write_u32_le(sec_data, 36, edata_rva + eot_off);      // AddressOfNameOrdinals

    let mut i: usize = 0;
    while i < num_exp {
        let e = dll_export_at(view(*dll_state), i);
        let str_off = unsafe { (*e).rva };
        let int_name = unsafe { (*e).internal_name };
        let g = linker_find_global(ctx, int_name);
        let g_sec = unsafe { (*g).sec };
        let g_off = unsafe { (*g).offset };
        let target_rva: u32 = (unsafe { (*g_sec).rva }) + g_off;
        unsafe {
            (*e).rva = target_rva;
        }
        coff_write_u32_le(sec_data, (eat_off as usize) + coff_mul_usize(i, 4), target_rva);
        coff_write_u32_le(sec_data, (enpt_off as usize) + coff_mul_usize(i, 4), edata_rva + str_off);
        coff_write_u16_le(sec_data, (eot_off as usize) + coff_mul_usize(i, 2), i as u16);
        i = i + 1;
    }
}

fn sort_u32_slice_asc(arr: *mut u32, count: usize) {
    if count < 2 {
        return;
    }
    let mut gap: usize = count / 2;
    while gap > 0 {
        let mut i: usize = gap;
        while i < count {
            let temp = unsafe { *(u32_slot_ptr(arr, i)) };
            let mut j: usize = i;
            while j >= gap {
                let prev = unsafe { *(u32_slot_ptr(arr, j - gap)) };
                if prev > temp {
                    unsafe {
                        *(u32_slot_ptr(arr, j)) = prev;
                    }
                    j = j - gap;
                } else {
                    break;
                }
            }
            unsafe {
                *(u32_slot_ptr(arr, j)) = temp;
            }
            i = i + 1;
        }
        gap = gap / 2;
    }
}

// Populates `.reloc` (`IMAGE_BASE_RELOCATION` 4 KiB page blocks of `IMAGE_REL_BASED_DIR64` entries)
// after section RVAs have been assigned to all preceding sections (`AXS-WLIB-023`).
// Returns updated `SizeOfImage`.
pub fn pe_populate_reloc_section(ctx: mut_view<LinkerContext>, reloc_sec: *mut MergedSection) -> u32 {
    let mut addr64_count: usize = 0;
    let mut i: usize = 0;
    while i < ctx.num_relocs {
        let r = linker_reloc_at(view(*ctx), i);
        if (unsafe { (*r).reloc_type }) == IMAGE_REL_AMD64_ADDR64 {
            addr64_count = addr64_count + 1;
        }
        i = i + 1;
    }

    let mut reloc_buf = coff_buf_with_capacity(64 + coff_mul_usize(addr64_count, 4));
    if addr64_count == 0 {
        // Emit a minimal 12-byte dummy block (PageRVA = 0x1000, BlockSize = 12, two ABSOLUTE pads)
        // so the Windows loader honours `IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE` when rebasing.
        coff_buf_put_u32(mut_view(reloc_buf), PE_DEFAULT_SECTION_ALIGN);
        coff_buf_put_u32(mut_view(reloc_buf), 12u32);
        coff_buf_put_u16(mut_view(reloc_buf), 0u16);
        coff_buf_put_u16(mut_view(reloc_buf), 0u16);
    } else {
        let rva_arr = unsafe {
            heap_alloc(coff_mul_usize(addr64_count, size_of<u32>()), align_of<u32>()) as *mut u32
        };
        let mut wr: usize = 0;
        i = 0;
        while i < ctx.num_relocs {
            let r = linker_reloc_at(view(*ctx), i);
            if (unsafe { (*r).reloc_type }) == IMAGE_REL_AMD64_ADDR64 {
                let r_sec = unsafe { (*r).sec };
                let fixup_rva = (unsafe { (*r_sec).rva }) + (unsafe { (*r).offset });
                unsafe {
                    *(u32_slot_ptr(rva_arr, wr)) = fixup_rva;
                }
                wr = wr + 1;
            }
            i = i + 1;
        }
        sort_u32_slice_asc(rva_arr, addr64_count);

        let mut idx: usize = 0;
        while idx < addr64_count {
            let first_rva = unsafe { *(u32_slot_ptr(rva_arr, idx)) };
            let page_rva: u32 = first_rva & 0xFFFFF000u32;
            let mut end_idx: usize = idx + 1;
            while end_idx < addr64_count {
                let next_rva = unsafe { *(u32_slot_ptr(rva_arr, end_idx)) };
                if (next_rva & 0xFFFFF000u32) != page_rva {
                    break;
                }
                end_idx = end_idx + 1;
            }
            let entry_count: usize = end_idx - idx;
            let padded_count: usize = if (entry_count & 1) != 0 { entry_count + 1 } else { entry_count };
            let block_size: u32 = 8u32 + coff_mul_u32(padded_count as u32, 2u32);

            coff_buf_put_u32(mut_view(reloc_buf), page_rva);
            coff_buf_put_u32(mut_view(reloc_buf), block_size);
            let mut k: usize = idx;
            while k < end_idx {
                let cur_rva = unsafe { *(u32_slot_ptr(rva_arr, k)) };
                let off12: u16 = (cur_rva & 0x0FFFu32) as u16;
                let entry: u16 = (IMAGE_REL_BASED_DIR64 << 12u16) | off12;
                coff_buf_put_u16(mut_view(reloc_buf), entry);
                k = k + 1;
            }
            if (entry_count & 1) != 0 {
                coff_buf_put_u16(mut_view(reloc_buf), 0u16);
            }
            idx = end_idx;
        }

        unsafe {
            heap_free(rva_arr as *mut u8, coff_mul_usize(addr64_count, size_of<u32>()), align_of<u32>());
        }
    }

    let mut base_out: [1]u32 = [0u32];
    let pbase = unsafe { address_of(base_out[0]) as *mut u32 };
    linker_append_section_data(reloc_sec, reloc_buf.ptr as *const u8, reloc_buf.len as u32, 4u32, pbase);
    coff_buf_free(mut_view(reloc_buf));

    let reloc_rva = unsafe { (*reloc_sec).rva };
    let reloc_sz = unsafe { (*reloc_sec).size };
    pe_align_up_u32(reloc_rva + reloc_sz, PE_DEFAULT_SECTION_ALIGN)
}

pub fn linker_emit_dll_pe_image(
    ctx: view<LinkerContext>,
    imports: view<ImportTable>,
    edata_sec: *mut MergedSection,
    reloc_sec: *mut MergedSection,
    dllmain_offset: u32,
    size_of_image: u32,
    stack_reserve: u32,
    out: mut_view<CoffBuf>
) -> bool {
    let file_align: u32 = PE_DEFAULT_FILE_ALIGN;
    let sec_align: u32 = PE_DEFAULT_SECTION_ALIGN;
    let eff_stack_reserve: u32 = if stack_reserve == 0u32 { PE_DEFAULT_STACK_RESERVE } else { stack_reserve };

    let text_sec = linker_find_section_str(ctx, { ".text" });
    let idata_sec = linker_find_section_str(ctx, { ".idata" });
    if (text_sec as usize) == 0 || (idata_sec as usize) == 0 || (reloc_sec as usize) == 0 {
        return false;
    }

    let size_of_headers: u32 = pe_compute_headers_size(ctx.num_sections, file_align);

    pe_emit_dos_header(mut_view(*out));
    pe_emit_pe_signature(mut_view(*out));

    let fhdr = CoffFileHeader {
        machine: IMAGE_FILE_MACHINE_AMD64,
        number_of_sections: ctx.num_sections as u16,
        time_date_stamp: 0u32,
        pointer_to_symbol_table: 0u32,
        number_of_symbols: 0u32,
        size_of_optional_header: PE_OPTIONAL_HEADER64_TOTAL_SIZE as u16,
        characteristics: IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE | IMAGE_FILE_DEBUG_STRIPPED | IMAGE_FILE_DLL,
    };
    pe_emit_file_header(mut_view(*out), view(fhdr));

    let mut size_of_init_data: u32 = 0u32;
    let mut i: usize = 0;
    while i < ctx.num_sections {
        let sec = linker_section_at(ctx, i);
        let chars = unsafe { (*sec).characteristics };
        let sz = unsafe { (*sec).size };
        if (chars & IMAGE_SCN_CNT_INITIALIZED_DATA) != 0u32 {
            size_of_init_data = size_of_init_data + sz;
        }
        i = i + 1;
    }

    let text_rva = unsafe { (*text_sec).rva };
    let text_size = unsafe { (*text_sec).size };
    let mut ohdr = PeOptionalHeader64 {
        magic: 0u16,
        major_linker_version: 0u8,
        minor_linker_version: 0u8,
        size_of_code: 0u32,
        size_of_initialized_data: 0u32,
        size_of_uninitialized_data: 0u32,
        address_of_entry_point: 0u32,
        base_of_code: 0u32,
        image_base: 0u64,
        section_alignment: 0u32,
        file_alignment: 0u32,
        major_operating_system_version: 0u16,
        minor_operating_system_version: 0u16,
        major_image_version: 0u16,
        minor_image_version: 0u16,
        major_subsystem_version: 0u16,
        minor_subsystem_version: 0u16,
        win32_version_value: 0u32,
        size_of_image: 0u32,
        size_of_headers: 0u32,
        check_sum: 0u32,
        subsystem: 0u16,
        dll_characteristics: 0u16,
        size_of_stack_reserve: 0u64,
        size_of_stack_commit: 0u64,
        size_of_heap_reserve: 0u64,
        size_of_heap_commit: 0u64,
        loader_flags: 0u32,
        number_of_rva_and_sizes: 0u32,
    };
    pe_optional_header64_init(mut_view(ohdr));
    ohdr.image_base = pe_default_dll_image_base();
    ohdr.size_of_code = text_size;
    ohdr.size_of_initialized_data = size_of_init_data;
    ohdr.address_of_entry_point = text_rva + dllmain_offset;
    ohdr.base_of_code = text_rva;
    ohdr.section_alignment = sec_align;
    ohdr.file_alignment = file_align;
    ohdr.size_of_image = size_of_image;
    ohdr.size_of_headers = size_of_headers;
    ohdr.dll_characteristics = PE_DLL_DEFAULT_DLL_CHARS;
    ohdr.size_of_stack_reserve = eff_stack_reserve as u64;
    pe_emit_optional_header64(mut_view(*out), view(ohdr));

    let idata_rva = unsafe { (*idata_sec).rva };
    let import_dir_rva: u32 = idata_rva + imports.idata_base + imports.desc_offset;
    let import_dir_size: u32 = coff_mul_u32((imports.num_dlls + 1) as u32, PE_IMPORT_DESCRIPTOR_SIZE as u32);
    let iat_dir_rva: u32 = idata_rva + imports.idata_base + imports.all_iats_start;
    let iat_dir_size: u32 = imports.all_iats_size;

    let export_dir_rva: u32 = if (edata_sec as usize) != 0 { unsafe { (*edata_sec).rva } } else { 0u32 };
    let export_dir_size: u32 = if (edata_sec as usize) != 0 { unsafe { (*edata_sec).size } } else { 0u32 };
    let reloc_dir_rva: u32 = unsafe { (*reloc_sec).rva };
    let reloc_dir_size: u32 = unsafe { (*reloc_sec).size };

    let mut d_idx: usize = 0;
    while d_idx < PE_DATA_DIRECTORY_COUNT {
        let dir = if d_idx == PE_DIR_EXPORT {
            PeDataDirectory { virtual_address: export_dir_rva, size: export_dir_size }
        } else if d_idx == PE_DIR_IMPORT {
            PeDataDirectory { virtual_address: import_dir_rva, size: import_dir_size }
        } else if d_idx == PE_DIR_BASERELOC {
            PeDataDirectory { virtual_address: reloc_dir_rva, size: reloc_dir_size }
        } else if d_idx == PE_DIR_IAT {
            PeDataDirectory { virtual_address: iat_dir_rva, size: iat_dir_size }
        } else {
            PeDataDirectory { virtual_address: 0u32, size: 0u32 }
        };
        pe_emit_data_directory(mut_view(*out), view(dir));
        d_idx = d_idx + 1;
    }

    i = 0;
    while i < ctx.num_sections {
        let sec = linker_section_at(ctx, i);
        let mut sname: [8]u8 = [0u8; 8];
        let mut k: usize = 0;
        while k < 8 {
            let ch = unsafe { (*sec).name[k] };
            if ch == 0u8 {
                break;
            }
            sname[k] = ch;
            k = k + 1;
        }
        let sec_size = unsafe { (*sec).size };
        let sec_rva = unsafe { (*sec).rva };
        let sec_raw_ptr = unsafe { (*sec).raw_ptr };
        let sec_chars = unsafe { (*sec).characteristics };
        let raw_data_sz = pe_align_up_u32(sec_size, file_align);
        let ptr_to_raw = if raw_data_sz > 0u32 { sec_raw_ptr } else { 0u32 };

        let shdr = CoffSectionHeader {
            name: sname,
            virtual_size: sec_size,
            virtual_address: sec_rva,
            size_of_raw_data: raw_data_sz,
            pointer_to_raw_data: ptr_to_raw,
            pointer_to_relocations: 0u32,
            pointer_to_linenumbers: 0u32,
            number_of_relocations: 0u16,
            number_of_linenumbers: 0u16,
            characteristics: sec_chars,
        };
        pe_emit_section_header(mut_view(*out), view(shdr));
        i = i + 1;
    }

    i = 0;
    while i < ctx.num_sections {
        let sec = linker_section_at(ctx, i);
        let sec_size = unsafe { (*sec).size };
        if sec_size > 0u32 {
            let sec_raw_ptr = (unsafe { (*sec).raw_ptr }) as usize;
            if (out.len) < sec_raw_ptr {
                pe_buf_put_zeroes(mut_view(*out), sec_raw_ptr - out.len);
            }
            let sec_data = unsafe { (*sec).data as *const u8 };
            coff_buf_put_bytes(mut_view(*out), sec_data, sec_size as usize);

            let aligned_sz = pe_align_up_u32(sec_size, file_align);
            let padding: u32 = aligned_sz - sec_size;
            if padding > 0u32 {
                pe_buf_put_zeroes(mut_view(*out), padding as usize);
            }
        }
        i = i + 1;
    }

    true
}

unsafe fn archive_member_mut_slot(base: *mut CoffArchiveMember, idx: usize) -> *mut CoffArchiveMember {
    ((base as usize) + coff_mul_usize(idx, size_of<CoffArchiveMember>())) as *mut CoffArchiveMember
}

// Emits a deterministic COFF Short-Import Library (`.lib`) matching the sorted exports in `dll_state`
// (`AXS-WLIB-030` / `AXS-WLIB-031`).
pub fn pe_build_companion_implib_to_buf(
    dll_state: view<DllLinkState>,
    dll_basename: *const u8,
    out_implib: mut_view<CoffBuf>
) -> bool {
    coff_buf_clear(mut_view(*out_implib));
    let num_exp = dll_state.num_exports;
    if num_exp == 0 {
        return coff_write_archive_to_buf(0 as *const CoffArchiveMember, 0, out_implib);
    }
    let dll_len = cstr_len(dll_basename);
    if dll_len == 0 {
        return false;
    }

    let mut short_bufs = loaded_file_buf_list_new();
    let mut i: usize = 0;
    while i < num_exp {
        let exp = dll_export_at(dll_state, i);
        let ext_name = unsafe { (*exp).ext_name };
        let ext_len = cstr_len(ext_name);
        let is_data = unsafe { (*exp).is_data };
        let mut sbuf = coff_buf_with_capacity(COFF_SHORT_IMPORT_HEADER_SIZE + ext_len + dll_len + 4);
        if !coff_write_short_import_to_buf(
            mut_view(sbuf),
            ext_name,
            ext_len,
            dll_basename,
            dll_len,
            i as u16,
            is_data
        ) {
            coff_buf_free(mut_view(sbuf));
            loaded_file_buf_list_free(mut_view(short_bufs));
            return false;
        }
        let _ = loaded_file_buf_list_push(mut_view(short_bufs), sbuf);
        i = i + 1;
    }

    let members_arr = unsafe {
        heap_alloc(coff_mul_usize(num_exp, size_of<CoffArchiveMember>()), align_of<CoffArchiveMember>()) as *mut CoffArchiveMember
    };
    i = 0;
    while i < num_exp {
        let b_slot = unsafe { loaded_file_buf_slot(short_bufs.ptr, i) };
        let m_slot = unsafe { archive_member_mut_slot(members_arr, i) };
        unsafe {
            *m_slot = CoffArchiveMember {
                name: dll_basename,
                name_len: dll_len,
                data: (*b_slot).ptr as *const u8,
                data_len: (*b_slot).len,
            };
        }
        i = i + 1;
    }

    let ok = coff_write_archive_to_buf(members_arr as *const CoffArchiveMember, num_exp, out_implib);
    unsafe {
        heap_free(
            members_arr as *mut u8,
            coff_mul_usize(num_exp, size_of<CoffArchiveMember>()),
            align_of<CoffArchiveMember>()
        );
    }
    loaded_file_buf_list_free(mut_view(short_bufs));
    ok
}

fn linker_finalize_dll_with_archives_to_buf(
    ctx: mut_view<LinkerContext>,
    dll_state: mut_view<DllLinkState>,
    candidates: mut_view<ArchiveCandidateList>,
    dll_basename: *const u8,
    stack_reserve: u32,
    out_dll: mut_view<CoffBuf>,
    out_implib: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    coff_buf_clear(mut_view(*out_dll));
    coff_buf_clear(mut_view(*out_implib));

    let mut imports = import_table_new();
    import_add_base_kernel32(mut_view(imports), mut_view(*ctx));

    if candidates.len > 0 {
        let pdll = unsafe { lnk_ptr_from_mut(mut_view(*dll_state)) };
        if !linker_extract_needed_archive_members_ex(
            mut_view(*ctx),
            mut_view(imports),
            pdll,
            mut_view(*candidates),
            diag
        ) {
            import_table_free(mut_view(imports));
            return false;
        }
    }

    let dllmain_offset = linker_emit_dll_runtime_stubs(mut_view(*ctx));

    linker_rewrite_resolved_dollar_relocs(mut_view(*ctx), view(imports));
    import_discover_from_relocs(mut_view(imports), mut_view(*ctx));

    let text_sec = linker_get_or_create_section_str(mut_view(*ctx), { ".text" }, 0u32);
    import_emit_thunks(view(imports), mut_view(*ctx), text_sec);

    let mut dll_name_off: u32 = 0u32;
    let edata_sec = if dll_state.num_exports > 0 {
        let esec = pe_build_edata_section(mut_view(*dll_state), mut_view(*ctx), dll_basename, mut_view(dll_name_off), diag);
        if (esec as usize) == 0 {
            import_table_free(mut_view(imports));
            return false;
        }
        esec
    } else {
        0 as *mut MergedSection
    };

    let idata_sec = import_build_idata_section(mut_view(imports), mut_view(*ctx));

    // Create `.reloc` as the final section before assigning RVAs so `SizeOfHeaders` and all
    // preceding section RVAs/file-offsets are final prior to gathering `ADDR64` fixup RVAs.
    let reloc_chars = IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_DISCARDABLE;
    let reloc_sec = linker_get_or_create_section_str(mut_view(*ctx), { ".reloc" }, reloc_chars);

    let _ = linker_assign_rvas(mut_view(*ctx), PE_DEFAULT_FILE_ALIGN, PE_DEFAULT_SECTION_ALIGN);
    pe_patch_edata_rvas(mut_view(*dll_state), view(*ctx), edata_sec, dll_name_off);
    import_patch_idata_rvas(view(imports), idata_sec);

    if !linker_apply_relocations(mut_view(*ctx), pe_default_dll_image_base(), diag) {
        import_table_free(mut_view(imports));
        return false;
    }

    let size_of_image = pe_populate_reloc_section(mut_view(*ctx), reloc_sec);

    if !linker_emit_dll_pe_image(
        view(*ctx),
        view(imports),
        edata_sec,
        reloc_sec,
        dllmain_offset,
        size_of_image,
        stack_reserve,
        out_dll
    ) {
        import_table_free(mut_view(imports));
        return false;
    }

    import_table_free(mut_view(imports));
    pe_build_companion_implib_to_buf(view(*dll_state), dll_basename, out_implib)
}

pub fn pe_link_dll_obj_and_libs_to_buf(
    mem_obj_ptr: *const u8,
    mem_obj_len: usize,
    input_paths: *const *const u8,
    input_count: usize,
    lib_dirs: *const *const u8,
    num_lib_dirs: usize,
    lib_names: *const *const u8,
    num_lib_names: usize,
    attr_libs: *const *const u8,
    num_attr_libs: usize,
    dll_basename: *const u8,
    stack_reserve: u32,
    out_dll: mut_view<CoffBuf>,
    out_implib: mut_view<CoffBuf>,
    diag: *mut DiagSink
) -> bool {
    let mut ctx = LinkerContext {
        sections: 0 as *mut *mut MergedSection,
        num_sections: 0,
        cap_sections: 0,
        globals: 0 as *mut compiler.link.pe.GlobalSymbol,
        num_globals: 0,
        cap_globals: 0,
        relocs: 0 as *mut compiler.link.pe.PeReloc,
        num_relocs: 0,
        cap_relocs: 0,
        str_arena: 0 as *mut compiler.kernel.arena.Arena,
    };
    linker_context_init(mut_view(ctx));
    let mut dll_state = dll_state_new();
    let pdll_state = unsafe { lnk_ptr_from_mut(mut_view(dll_state)) };
    let mut file_bufs = loaded_file_buf_list_new();
    let mut candidates = archive_cand_list_new();

    if mem_obj_len > 0 && (mem_obj_ptr as usize) != 0 {
        if !linker_load_coff_object_ex(mut_view(ctx), mem_obj_ptr, mem_obj_len, pdll_state, diag) {
            dll_state_free(mut_view(dll_state));
            archive_cand_list_free(mut_view(candidates));
            loaded_file_buf_list_free(mut_view(file_bufs));
            linker_context_free(mut_view(ctx));
            return false;
        }
    }

    let mut i: usize = 0;
    while i < input_count {
        let p = unsafe { const_ptr_slot(input_paths, i) };
        let plen = cstr_len(p);
        let is_arch_ext = linker_path_is_archive_ext(p, plen);
        let mut fbuf = coff_buf_with_capacity(256);
        if !linker_read_file_bytes(p, plen, mut_view(fbuf)) {
            coff_buf_free(mut_view(fbuf));
            if is_arch_ext {
                linker_report_bad_archive(diag);
            } else {
                linker_report_bad_object(diag);
            }
            dll_state_free(mut_view(dll_state));
            archive_cand_list_free(mut_view(candidates));
            loaded_file_buf_list_free(mut_view(file_bufs));
            linker_context_free(mut_view(ctx));
            return false;
        }
        let slot = loaded_file_buf_list_push(mut_view(file_bufs), fbuf);
        let b_ptr = unsafe { (*slot).ptr as *const u8 };
        let b_len = unsafe { (*slot).len };
        if is_arch_ext || coff_is_archive_bytes(b_ptr, b_len) {
            if !linker_collect_archive_candidates(mut_view(candidates), b_ptr, b_len, diag) {
                dll_state_free(mut_view(dll_state));
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
        } else {
            if !linker_load_coff_object_ex(mut_view(ctx), b_ptr, b_len, pdll_state, diag) {
                dll_state_free(mut_view(dll_state));
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
        }
        i = i + 1;
    }

    let mut resolved_path = coff_buf_with_capacity(256);
    i = 0;
    while i < num_lib_names {
        let lname = unsafe { const_ptr_slot(lib_names, i) };
        if linker_resolve_library_in_dirs(lname, lib_dirs, num_lib_dirs, mut_view(resolved_path)) {
            let mut lbuf = coff_buf_with_capacity(256);
            if !linker_read_file_bytes(resolved_path.ptr as *const u8, resolved_path.len, mut_view(lbuf)) {
                coff_buf_free(mut_view(lbuf));
                coff_buf_free(mut_view(resolved_path));
                linker_report_bad_archive(diag);
                dll_state_free(mut_view(dll_state));
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
            let slot = loaded_file_buf_list_push(mut_view(file_bufs), lbuf);
            if !linker_collect_archive_candidates(
                mut_view(candidates),
                unsafe { (*slot).ptr as *const u8 },
                unsafe { (*slot).len },
                diag
            ) {
                coff_buf_free(mut_view(resolved_path));
                dll_state_free(mut_view(dll_state));
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
        } else if !linker_is_known_system_dll(lname) {
            coff_buf_free(mut_view(resolved_path));
            linker_report_library_not_found(diag, lname);
            dll_state_free(mut_view(dll_state));
            archive_cand_list_free(mut_view(candidates));
            loaded_file_buf_list_free(mut_view(file_bufs));
            linker_context_free(mut_view(ctx));
            return false;
        }
        i = i + 1;
    }

    i = 0;
    while i < num_attr_libs {
        let alname = unsafe { const_ptr_slot(attr_libs, i) };
        if linker_resolve_library_in_dirs(alname, lib_dirs, num_lib_dirs, mut_view(resolved_path)) {
            let mut abuf = coff_buf_with_capacity(256);
            if !linker_read_file_bytes(resolved_path.ptr as *const u8, resolved_path.len, mut_view(abuf)) {
                coff_buf_free(mut_view(abuf));
                coff_buf_free(mut_view(resolved_path));
                linker_report_bad_archive(diag);
                dll_state_free(mut_view(dll_state));
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
            let slot = loaded_file_buf_list_push(mut_view(file_bufs), abuf);
            if !linker_collect_archive_candidates(
                mut_view(candidates),
                unsafe { (*slot).ptr as *const u8 },
                unsafe { (*slot).len },
                diag
            ) {
                coff_buf_free(mut_view(resolved_path));
                dll_state_free(mut_view(dll_state));
                archive_cand_list_free(mut_view(candidates));
                loaded_file_buf_list_free(mut_view(file_bufs));
                linker_context_free(mut_view(ctx));
                return false;
            }
        }
        i = i + 1;
    }
    coff_buf_free(mut_view(resolved_path));

    let ok = linker_finalize_dll_with_archives_to_buf(
        mut_view(ctx),
        mut_view(dll_state),
        mut_view(candidates),
        dll_basename,
        stack_reserve,
        out_dll,
        out_implib,
        diag
    );
    dll_state_free(mut_view(dll_state));
    archive_cand_list_free(mut_view(candidates));
    loaded_file_buf_list_free(mut_view(file_bufs));
    linker_context_free(mut_view(ctx));
    ok
}
