// Hermetic Build Sandbox, Filesystem/Environment/Network/Clock Isolation
// (`compiler/build/sandbox/mod.ax`, T863 / E20.4).
//
// Implements SPEC-113 §2 (`AXS-HERM-010`..`AXS-HERM-015`, `AXS-HERM-050`..`AXS-HERM-053`,
// `INV-HERM-001`, `REQ-PKG-022`, `REQ-PKG-024`).

module compiler.build.sandbox

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

