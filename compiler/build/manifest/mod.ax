    pub inputs: [4]StrView,
    pub input_count: usize,
    pub outputs: [4]StrView,
    pub output_count: usize,
}

@derive(Copy)
pub struct FeatureDecl {
    pub name: StrView,
    pub implies: [8]StrView,
    pub implies_count: usize,
    pub conflicts_with: [4]StrView,
    pub conflicts_count: usize,
    pub is_implicit_optional_dep: bool,
}

@derive(Copy)
pub struct DependencyDecl {
    pub name: StrView,
    pub package_alias: StrView,
    pub scope: u8,
    pub version_req: StrView,
    pub path: StrView,
    pub git: StrView,
    pub rev: StrView,
    pub registry: StrView,
    pub optional: bool,
    pub default_features: bool,
    pub features: [8]StrView,
    pub feature_count: usize,
