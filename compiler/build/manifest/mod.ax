// Declarative `axiom.toml` Package & Workspace Manifest Parser, SemVer Validator,
// Profile Schema, and Deterministic `@cfg(...)` Predicate Evaluator
// (`compiler/build/manifest/mod.ax`, T851 / E20.1).
//
// Implements SPEC-110 §§1..2 & §5 (`AXS-BLD-001`..`AXS-BLD-005`, `AXS-BLD-010`..`AXS-BLD-016`,
// `AXS-BLD-050`..`AXS-BLD-053`; `REQ-PKG-022`, `REQ-PKG-024`, `REQ-PKG-025`).

module compiler.build.manifest

use compiler.kernel.interner.StrView
use compiler.source.span.span_none
use compiler.diag.code.DiagDataKind
use compiler.diag.code.diag_code
use compiler.diag.code.AX_DRIVER_BAD_MANIFEST
use compiler.diag.emitter.Diagnostic
use compiler.diag.emitter.DiagDataEntry
use compiler.diag.emitter.DiagDataValue
use compiler.diag.emitter.DiagSink
use compiler.diag.emitter.diag_new
use compiler.diag.emitter.diag_sink_report
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_empty
use compiler.diag.ux2.ux2_sv_eq

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// =============================================================================
// 1. Canonical Diagnostic Codes & Structured `data` Helpers (`AXS-BLD-050`)
// =============================================================================

pub const AX_NAME_INVALID_CFG_PREDICATE: u32 = 216u32
pub const AX_DRIVER_INVALID_PROFILE: u32 = 217u32
pub const AX_DRIVER_INVALID_SAFETY_PROFILE: u32 = 218u32
pub const AX_DRIVER_INVALID_PANIC_STRATEGY: u32 = 219u32

// Five canonical dependency scopes (`AXS-BLD-005`)
pub const DEP_SCOPE_NORMAL: u8 = 0u8
pub const DEP_SCOPE_DEV: u8 = 1u8
pub const DEP_SCOPE_BUILD: u8 = 2u8
pub const DEP_SCOPE_COMPTIME: u8 = 3u8
pub const DEP_SCOPE_SYSTEM: u8 = 4u8

// Package compilation unit target kinds (`AXS-BLD-004`)
pub const TARGET_UNIT_LIB: u8 = 0u8
pub const TARGET_UNIT_BIN: u8 = 1u8
pub const TARGET_UNIT_TEST: u8 = 2u8
pub const TARGET_UNIT_BENCH: u8 = 3u8
pub const TARGET_UNIT_EXAMPLE: u8 = 4u8
pub const TARGET_UNIT_BUILD_TOOL: u8 = 5u8

// Built-in and custom build profile kinds (`AXS-BLD-016`)
pub const PROFILE_DEV: u8 = 0u8
pub const PROFILE_RELEASE: u8 = 1u8
pub const PROFILE_TEST: u8 = 2u8
pub const PROFILE_BENCH: u8 = 3u8
pub const PROFILE_CUSTOM: u8 = 4u8

pub fn dep_scope_name(scope: u8) -> StrView {
    if scope == DEP_SCOPE_NORMAL {
        return ux2_sv("normal")
    }
    if scope == DEP_SCOPE_DEV {
        return ux2_sv("dev")
    }
    if scope == DEP_SCOPE_BUILD {
        return ux2_sv("build")
    }
    if scope == DEP_SCOPE_COMPTIME {
        return ux2_sv("comptime")
    }
    if scope == DEP_SCOPE_SYSTEM {
        return ux2_sv("system")
    }
    ux2_sv("unknown")
}

pub fn target_unit_kind_name(kind: u8) -> StrView {
    if kind == TARGET_UNIT_LIB {
        return ux2_sv("lib")
    }
    if kind == TARGET_UNIT_BIN {
        return ux2_sv("bin")
    }
    if kind == TARGET_UNIT_TEST {
        return ux2_sv("test")
    }
    if kind == TARGET_UNIT_BENCH {
        return ux2_sv("bench")
    }
    if kind == TARGET_UNIT_EXAMPLE {
        return ux2_sv("example")
    }
    if kind == TARGET_UNIT_BUILD_TOOL {
        return ux2_sv("build-tool")
    }
    ux2_sv("unknown")
}

fn make_str_data_entry(key: StrView, val: StrView) -> DiagDataEntry {
    DiagDataEntry {
        key: key,
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: val,
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0usize,
        },
    }
}

pub fn report_manifest_diag_1(
    sink: mut_view<DiagSink>,
    code_raw: u32,
    msg: str,
    k1: str,
    v1: StrView
) {
    let mut d = diag_new(diag_code(code_raw), span_none(), ux2_sv(msg))
    let mut entries: [1]DiagDataEntry = [make_str_data_entry(ux2_sv(k1), v1)]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 1usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_manifest_diag_2(
    sink: mut_view<DiagSink>,
    code_raw: u32,
    msg: str,
    k1: str,
    v1: StrView,
    k2: str,
    v2: StrView
) {
    let mut d = diag_new(diag_code(code_raw), span_none(), ux2_sv(msg))
    let mut entries: [2]DiagDataEntry = [
        make_str_data_entry(ux2_sv(k1), v1),
        make_str_data_entry(ux2_sv(k2), v2),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 2usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_manifest_diag_3(
    sink: mut_view<DiagSink>,
    code_raw: u32,
    msg: str,
    k1: str,
    v1: StrView,
    k2: str,
    v2: StrView,
    k3: str,
    v3: StrView
) {
    let mut d = diag_new(diag_code(code_raw), span_none(), ux2_sv(msg))
    let mut entries: [3]DiagDataEntry = [
        make_str_data_entry(ux2_sv(k1), v1),
        make_str_data_entry(ux2_sv(k2), v2),
        make_str_data_entry(ux2_sv(k3), v3),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn manifest_diag_get_data(diag: view<Diagnostic>, key: StrView) -> StrView {
    if diag.data_count == 0usize || (diag.data as usize) == 0usize {
        return ux2_sv_empty()
    }
    let mut i: usize = 0usize
    while i < diag.data_count {
        let ep = unsafe { ((diag.data as usize) + i * size_of<DiagDataEntry>()) as *const DiagDataEntry }
        let k = unsafe { (*ep).key }
        if ux2_sv_eq(k, key) {
            return unsafe { (*ep).value.str_val }
        }
        i = i + 1usize
    }
    ux2_sv_empty()
}

// =============================================================================
// 2. Low-Level String View & Lexing Helpers
// =============================================================================

pub fn bld_sv_byte(s: StrView, idx: usize) -> u8 {
    if idx >= s.len || (s.ptr as usize) == 0usize {
        return 0u8
    }
    unsafe { *(s.ptr + idx) }
}

pub fn bld_sv_slice(s: StrView, start: usize, end: usize) -> StrView {
    if (s.ptr as usize) == 0usize || start >= end || start >= s.len {
        return ux2_sv_empty()
    }
    let clamped_end = if end > s.len { s.len } else { end }
    StrView {
        ptr: unsafe { s.ptr + start },
        len: clamped_end - start,
    }
}

pub fn bld_is_ws(b: u8) -> bool {
    b == 32u8 || b == 9u8 || b == 13u8 || b == 10u8
}

pub fn bld_sv_trim(s: StrView) -> StrView {
    if s.len == 0usize || (s.ptr as usize) == 0usize {
        return ux2_sv_empty()
    }
    let mut start: usize = 0usize
    let mut end: usize = s.len
    while start < end && bld_is_ws(bld_sv_byte(s, start)) {
        start = start + 1usize
    }
    while end > start && bld_is_ws(bld_sv_byte(s, end - 1usize)) {
        end = end - 1usize
    }
    bld_sv_slice(s, start, end)
}

pub fn bld_sv_starts_with(s: StrView, prefix: StrView) -> bool {
    if (s.len) < (prefix.len) {
        return false
    }
    ux2_sv_eq(bld_sv_slice(s, 0usize, prefix.len), prefix)
}

pub fn bld_sv_ends_with(s: StrView, suffix: StrView) -> bool {
    if (s.len) < (suffix.len) {
        return false
    }
    ux2_sv_eq(bld_sv_slice(s, s.len - suffix.len, s.len), suffix)
}

pub fn bld_sv_cmp(a: StrView, b: StrView) -> i32 {
    let min_len = if (a.len) < (b.len) { a.len } else { b.len }
    let mut i: usize = 0usize
    while i < min_len {
        let ba = bld_sv_byte(a, i)
        let bb = bld_sv_byte(b, i)
        if ba < bb {
            return -1i32
        }
        if ba > bb {
            return 1i32
        }
        i = i + 1usize
    }
    if (a.len) < (b.len) {
        return -1i32
    }
    if (a.len) > (b.len) {
        return 1i32
    }
    0i32
}

pub fn bld_strip_toml_comment(s: StrView, out_unclosed_quote: mut_view<bool>) -> StrView {
    *out_unclosed_quote = false
    let mut in_double: bool = false
    let mut in_single: bool = false
    let mut i: usize = 0usize
    while i < s.len {
        let b = bld_sv_byte(s, i)
        if b == 92u8 && in_double && (i + 1usize) < s.len {
            i = i + 2usize
            continue
        }
        if b == 34u8 && !in_single {
            in_double = !in_double
        } else if b == 39u8 && !in_double {
            in_single = !in_single
        } else if b == 35u8 && !in_double && !in_single {
            return bld_sv_trim(bld_sv_slice(s, 0usize, i))
        }
        i = i + 1usize
    }
    if in_double || in_single {
        *out_unclosed_quote = true
    }
    bld_sv_trim(s)
}

// =============================================================================
// 3. Semantic Version (`SemVer`) Parser, Requirement Validator & Ordering (`REQ-PKG-022`)
// =============================================================================

@derive(Copy)
pub struct SemVer {
    pub major: u32,
    pub minor: u32,
    pub patch: u32,
    pub prerelease: StrView,
    pub build_meta: StrView,
    pub raw: StrView,
}

pub fn semver_zero() -> SemVer {
    let e = ux2_sv_empty()
    SemVer {
        major: 0u32,
        minor: 0u32,
        patch: 0u32,
        prerelease: e,
        build_meta: e,
        raw: e,
    }
}

fn parse_semver_num(part: StrView, out_val: mut_view<u32>) -> bool {
    if part.len == 0usize || part.len > 9usize {
        return false
    }
    if part.len > 1usize && bld_sv_byte(part, 0usize) == 48u8 {
        return false
    }
    let mut acc: u32 = 0u32
    let mut i: usize = 0usize
    while i < part.len {
        let ch = bld_sv_byte(part, i)
        if ch < 48u8 || ch > 57u8 {
            return false
        }
        acc = acc * 10u32 + ((ch - 48u8) as u32)
        i = i + 1usize
    }
    *out_val = acc
    true
}

fn is_valid_semver_tag(tag: StrView) -> bool {
    if tag.len == 0usize {
        return false
    }
    if bld_sv_byte(tag, 0usize) == 46u8 || bld_sv_byte(tag, tag.len - 1usize) == 46u8 {
        return false
    }
    let mut i: usize = 0usize
    let mut prev_dot: bool = false
    while i < tag.len {
        let b = bld_sv_byte(tag, i)
        if b == 46u8 {
            if prev_dot {
                return false
            }
            prev_dot = true
        } else {
            prev_dot = false
            let is_num = b >= 48u8 && b <= 57u8
            let is_lo = b >= 97u8 && b <= 122u8
            let is_hi = b >= 65u8 && b <= 90u8
            let is_hyph = b == 45u8
            if !is_num && !is_lo && !is_hi && !is_hyph {
                return false
            }
        }
        i = i + 1usize
    }
    true
}

pub fn semver_parse(s: StrView, out: mut_view<SemVer>) -> bool {
    *out = semver_zero()
    if (s.len) < 5usize {
        return false
    }
    let mut plus_pos: usize = s.len
    let mut i: usize = 0usize
    while i < s.len {
        if bld_sv_byte(s, i) == 43u8 {
            plus_pos = i
            break
        }
        i = i + 1usize
    }
    let mut build_sv = ux2_sv_empty()
    if plus_pos < s.len {
        build_sv = bld_sv_slice(s, plus_pos + 1usize, s.len)
        if !is_valid_semver_tag(build_sv) {
            return false
        }
    }
    let core_and_pre = bld_sv_slice(s, 0usize, plus_pos)
    let mut dash_pos: usize = core_and_pre.len
    i = 0usize
    while i < core_and_pre.len {
        if bld_sv_byte(core_and_pre, i) == 45u8 {
            dash_pos = i
            break
        }
        i = i + 1usize
    }
    let mut pre_sv = ux2_sv_empty()
    if dash_pos < core_and_pre.len {
        pre_sv = bld_sv_slice(core_and_pre, dash_pos + 1usize, core_and_pre.len)
        if !is_valid_semver_tag(pre_sv) {
            return false
        }
    }
    let core_sv = bld_sv_slice(core_and_pre, 0usize, dash_pos)
    let mut dot1: usize = core_sv.len
    let mut dot2: usize = core_sv.len
    let mut dot_count: usize = 0usize
    i = 0usize
    while i < core_sv.len {
        if bld_sv_byte(core_sv, i) == 46u8 {
            if dot_count == 0usize {
                dot1 = i
            } else if dot_count == 1usize {
                dot2 = i
            }
            dot_count = dot_count + 1usize
        }
        i = i + 1usize
    }
    if dot_count != 2usize {
        return false
    }
    let maj_sv = bld_sv_slice(core_sv, 0usize, dot1)
    let min_sv = bld_sv_slice(core_sv, dot1 + 1usize, dot2)
    let pat_sv = bld_sv_slice(core_sv, dot2 + 1usize, core_sv.len)
    let mut maj: u32 = 0u32
    let mut min: u32 = 0u32
    let mut pat: u32 = 0u32
    if !parse_semver_num(maj_sv, mut_view(maj)) {
        return false
    }
    if !parse_semver_num(min_sv, mut_view(min)) {
        return false
    }
    if !parse_semver_num(pat_sv, mut_view(pat)) {
        return false
    }
    *out = SemVer {
        major: maj,
        minor: min,
        patch: pat,
        prerelease: pre_sv,
        build_meta: build_sv,
        raw: s,
    }
    true
}

pub fn semver_req_valid(req: StrView) -> bool {
    let trimmed = bld_sv_trim(req)
    if trimmed.len == 0usize {
        return false
    }
    let mut start: usize = 0usize
    let b0 = bld_sv_byte(trimmed, 0usize)
    if b0 == 94u8 || b0 == 126u8 || b0 == 61u8 {
        start = 1usize
    } else if b0 == 62u8 || b0 == 60u8 {
        start = 1usize
        if trimmed.len > 1usize && bld_sv_byte(trimmed, 1usize) == 61u8 {
            start = 2usize
        }
    }
    let ver_part = bld_sv_trim(bld_sv_slice(trimmed, start, trimmed.len))
    let mut parsed = semver_zero()
    semver_parse(ver_part, mut_view(parsed))
}

pub fn semver_cmp(a: view<SemVer>, b: view<SemVer>) -> i32 {
    if (a.major) < (b.major) {
        return -1i32
    }
    if (a.major) > (b.major) {
        return 1i32
    }
    if (a.minor) < (b.minor) {
        return -1i32
    }
    if (a.minor) > (b.minor) {
        return 1i32
    }
    if (a.patch) < (b.patch) {
        return -1i32
    }
    if (a.patch) > (b.patch) {
        return 1i32
    }
    if a.prerelease.len == 0usize && b.prerelease.len > 0usize {
        return 1i32
    }
    if a.prerelease.len > 0usize && b.prerelease.len == 0usize {
        return -1i32
    }
    bld_sv_cmp(a.prerelease, b.prerelease)
}

// =============================================================================
// 4. Package Identifier & Imperative Build-Script Guard (`AXS-BLD-011`, `AXS-BLD-012`)
// =============================================================================

pub fn is_reserved_package_name(name: StrView, bootstrap_internal: bool) -> bool {
    if ux2_sv_eq(name, ux2_sv("fn")) || ux2_sv_eq(name, ux2_sv("let")) ||
        ux2_sv_eq(name, ux2_sv("mut")) || ux2_sv_eq(name, ux2_sv("pub")) ||
        ux2_sv_eq(name, ux2_sv("module")) || ux2_sv_eq(name, ux2_sv("use")) ||
        ux2_sv_eq(name, ux2_sv("struct")) || ux2_sv_eq(name, ux2_sv("enum")) ||
        ux2_sv_eq(name, ux2_sv("trait")) || ux2_sv_eq(name, ux2_sv("impl")) ||
        ux2_sv_eq(name, ux2_sv("if")) || ux2_sv_eq(name, ux2_sv("else")) ||
        ux2_sv_eq(name, ux2_sv("while")) || ux2_sv_eq(name, ux2_sv("loop")) ||
        ux2_sv_eq(name, ux2_sv("for")) || ux2_sv_eq(name, ux2_sv("match")) ||
        ux2_sv_eq(name, ux2_sv("return")) || ux2_sv_eq(name, ux2_sv("unsafe")) ||
        ux2_sv_eq(name, ux2_sv("async")) || ux2_sv_eq(name, ux2_sv("await")) ||
        ux2_sv_eq(name, ux2_sv("true")) || ux2_sv_eq(name, ux2_sv("false")) ||
        ux2_sv_eq(name, ux2_sv("type")) || ux2_sv_eq(name, ux2_sv("const")) ||
        ux2_sv_eq(name, ux2_sv("where")) || ux2_sv_eq(name, ux2_sv("view")) ||
        ux2_sv_eq(name, ux2_sv("mut_view")) || ux2_sv_eq(name, ux2_sv("move")) {
        return true
    }
    if !bootstrap_internal {
        if ux2_sv_eq(name, ux2_sv("std")) || ux2_sv_eq(name, ux2_sv("core")) ||
            ux2_sv_eq(name, ux2_sv("alloc")) || ux2_sv_eq(name, ux2_sv("compiler")) {
            return true
        }
    }
    false
}

pub fn validate_package_name(name: StrView, bootstrap_internal: bool) -> bool {
    if name.len == 0usize || name.len > 64usize {
        return false
    }
    let b0 = bld_sv_byte(name, 0usize)
    if b0 < 97u8 || b0 > 122u8 {
        return false
    }
    let mut i: usize = 1usize
    while i < name.len {
        let b = bld_sv_byte(name, i)
        let is_lo = b >= 97u8 && b <= 122u8
        let is_num = b >= 48u8 && b <= 57u8
        let is_sep = b == 95u8 || b == 45u8
        if !is_lo && !is_num && !is_sep {
            return false
        }
        i = i + 1usize
    }
    if is_reserved_package_name(name, bootstrap_internal) {
        return false
    }
    true
}

pub fn is_forbidden_script_key(key: StrView) -> bool {
    ux2_sv_eq(key, ux2_sv("script")) ||
        ux2_sv_eq(key, ux2_sv("command")) ||
        ux2_sv_eq(key, ux2_sv("shell")) ||
        ux2_sv_eq(key, ux2_sv("eval")) ||
        ux2_sv_eq(key, ux2_sv("pre_build")) ||
        ux2_sv_eq(key, ux2_sv("post_build")) ||
        ux2_sv_eq(key, ux2_sv("build_script_cmd"))
}

// =============================================================================
// 5. Deterministic `@cfg(...)` Predicate Parser & Evaluator (`AXS-BLD-014 §4`, `SPEC-88`)
// =============================================================================

@derive(Copy)
pub struct CfgContext {
    pub target_os: StrView,
    pub target_arch: StrView,
    pub target_env: StrView,
    pub target_vendor: StrView,
    pub target_abi: StrView,
    pub target_pointer_width: StrView,
    pub target_endian: StrView,
    pub profile: StrView,
    pub is_test: bool,
    pub is_bench: bool,
    pub sanitize: StrView,
    pub active_features: [16]StrView,
    pub active_feature_count: usize,
}

pub fn cfg_context_for_triple(triple: StrView, profile: StrView, is_test: bool, is_bench: bool) -> CfgContext {
    let e = ux2_sv_empty()
    let mut os_sv = ux2_sv("windows")
    let mut arch_sv = ux2_sv("x86_64")
    let mut env_sv = ux2_sv("msvc")
    let mut vendor_sv = ux2_sv("pc")
    let mut abi_sv = ux2_sv("win64")
    let mut ptr_w = ux2_sv("64")
    let mut endian_sv = ux2_sv("little")

    if bld_sv_starts_with(triple, ux2_sv("aarch64")) {
        arch_sv = ux2_sv("aarch64")
        abi_sv = ux2_sv("aapcs64")
    } else if bld_sv_starts_with(triple, ux2_sv("wasm32")) {
        arch_sv = ux2_sv("wasm32")
        os_sv = ux2_sv("wasi")
        env_sv = ux2_sv("musl")
        vendor_sv = ux2_sv("unknown")
        abi_sv = ux2_sv("wasm32")
        ptr_w = ux2_sv("32")
    } else if bld_sv_starts_with(triple, ux2_sv("riscv64")) {
        arch_sv = ux2_sv("riscv64")
        abi_sv = ux2_sv("lp64d")
    }

    if bld_sv_ends_with(triple, ux2_sv("linux")) || bld_sv_ends_with(triple, ux2_sv("linux-gnu")) || bld_sv_ends_with(triple, ux2_sv("linux-musl")) {
        os_sv = ux2_sv("linux")
        vendor_sv = ux2_sv("unknown")
        if bld_sv_ends_with(triple, ux2_sv("musl")) {
            env_sv = ux2_sv("musl")
        } else {
            env_sv = ux2_sv("gnu")
        }
        if ux2_sv_eq(arch_sv, ux2_sv("x86_64")) {
            abi_sv = ux2_sv("sysv64")
        }
    } else if bld_sv_ends_with(triple, ux2_sv("macos")) || bld_sv_ends_with(triple, ux2_sv("darwin")) {
        os_sv = ux2_sv("macos")
        vendor_sv = ux2_sv("apple")
        env_sv = ux2_sv("none")
        if ux2_sv_eq(arch_sv, ux2_sv("x86_64")) {
            abi_sv = ux2_sv("sysv64")
        }
    }

    CfgContext {
        target_os: os_sv,
        target_arch: arch_sv,
        target_env: env_sv,
        target_vendor: vendor_sv,
        target_abi: abi_sv,
        target_pointer_width: ptr_w,
        target_endian: endian_sv,
        profile: profile,
        is_test: is_test,
        is_bench: is_bench,
        sanitize: ux2_sv("none"),
        active_features: [e; 16],
        active_feature_count: 0usize,
    }
}

pub fn cfg_context_default_windows_x64() -> CfgContext {
    cfg_context_for_triple(ux2_sv("x86_64-windows"), ux2_sv("dev"), false, false)
}

pub fn cfg_context_default_linux_x64() -> CfgContext {
    cfg_context_for_triple(ux2_sv("x86_64-linux"), ux2_sv("dev"), false, false)
}

pub fn cfg_context_add_feature(ctx: mut_view<CfgContext>, feat: StrView) {
    let mut i: usize = 0usize
    while i < ctx.active_feature_count {
        if ux2_sv_eq(ctx.active_features[i], feat) {
            return
        }
        i = i + 1usize
    }
    if (ctx.active_feature_count) < 16usize {
        ctx.active_features[ctx.active_feature_count] = feat
        ctx.active_feature_count = ctx.active_feature_count + 1usize
    }
}

fn cfg_has_feature(ctx: view<CfgContext>, feat: StrView) -> bool {
    let mut i: usize = 0usize
    while i < ctx.active_feature_count {
        if ux2_sv_eq(ctx.active_features[i], feat) {
            return true
        }
        i = i + 1usize
    }
    false
}

pub fn is_valid_cfg_key(key: StrView) -> bool {
    ux2_sv_eq(key, ux2_sv("target_os")) ||
        ux2_sv_eq(key, ux2_sv("target_arch")) ||
        ux2_sv_eq(key, ux2_sv("target_env")) ||
        ux2_sv_eq(key, ux2_sv("target_vendor")) ||
        ux2_sv_eq(key, ux2_sv("target_abi")) ||
        ux2_sv_eq(key, ux2_sv("target_pointer_width")) ||
        ux2_sv_eq(key, ux2_sv("target_endian")) ||
        ux2_sv_eq(key, ux2_sv("feature")) ||
        ux2_sv_eq(key, ux2_sv("profile")) ||
        ux2_sv_eq(key, ux2_sv("test")) ||
        ux2_sv_eq(key, ux2_sv("bench")) ||
        ux2_sv_eq(key, ux2_sv("sanitize"))
}

fn cfg_eval_atom(
    atom: StrView,
    ctx: view<CfgContext>,
    out_val: mut_view<bool>,
    sink: mut_view<DiagSink>
) -> bool {
    let t = bld_sv_trim(atom)
    if t.len == 0usize {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_NAME_INVALID_CFG_PREDICATE,
            "empty `@cfg` predicate in `axiom.toml`",
            "key",
            ux2_sv_empty(),
            "value",
            ux2_sv_empty()
        )
        return false
    }
    if ux2_sv_eq(t, ux2_sv("test")) {
        *out_val = ctx.is_test
        return true
    }
    if ux2_sv_eq(t, ux2_sv("bench")) {
        *out_val = ctx.is_bench
        return true
    }
    // Look for `=` outside quotes
    let mut eq_pos: usize = t.len
    let mut i: usize = 0usize
    while i < t.len {
        let b = bld_sv_byte(t, i)
        if b == 61u8 {
            eq_pos = i
            break
        }
        i = i + 1usize
    }
    if eq_pos == t.len {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_NAME_INVALID_CFG_PREDICATE,
            "unknown or malformed `@cfg` predicate in `axiom.toml`",
            "key",
            t,
            "value",
            ux2_sv_empty()
        )
        return false
    }
    let key = bld_sv_trim(bld_sv_slice(t, 0usize, eq_pos))
    let rhs = bld_sv_trim(bld_sv_slice(t, eq_pos + 1usize, t.len))
    if !is_valid_cfg_key(key) || ux2_sv_eq(key, ux2_sv("test")) || ux2_sv_eq(key, ux2_sv("bench")) {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_NAME_INVALID_CFG_PREDICATE,
            "unknown `@cfg` predicate key in `axiom.toml`",
            "key",
            key,
            "value",
            rhs
        )
        return false
    }
    if (rhs.len) < 2usize || bld_sv_byte(rhs, 0usize) != 34u8 || bld_sv_byte(rhs, rhs.len - 1usize) != 34u8 {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_NAME_INVALID_CFG_PREDICATE,
            "`@cfg` predicate value must be a quoted string literal",
            "key",
            key,
            "value",
            rhs
        )
        return false
    }
    let val = bld_sv_slice(rhs, 1usize, rhs.len - 1usize)
    if ux2_sv_eq(key, ux2_sv("target_os")) {
        *out_val = ux2_sv_eq(ctx.target_os, val)
    } else if ux2_sv_eq(key, ux2_sv("target_arch")) {
        *out_val = ux2_sv_eq(ctx.target_arch, val)
    } else if ux2_sv_eq(key, ux2_sv("target_env")) {
        *out_val = ux2_sv_eq(ctx.target_env, val)
    } else if ux2_sv_eq(key, ux2_sv("target_vendor")) {
        *out_val = ux2_sv_eq(ctx.target_vendor, val)
    } else if ux2_sv_eq(key, ux2_sv("target_abi")) {
        *out_val = ux2_sv_eq(ctx.target_abi, val)
    } else if ux2_sv_eq(key, ux2_sv("target_pointer_width")) {
        *out_val = ux2_sv_eq(ctx.target_pointer_width, val)
    } else if ux2_sv_eq(key, ux2_sv("target_endian")) {
        *out_val = ux2_sv_eq(ctx.target_endian, val)
    } else if ux2_sv_eq(key, ux2_sv("profile")) {
        *out_val = ux2_sv_eq(ctx.profile, val)
    } else if ux2_sv_eq(key, ux2_sv("sanitize")) {
        *out_val = ux2_sv_eq(ctx.sanitize, val)
    } else if ux2_sv_eq(key, ux2_sv("feature")) {
        *out_val = cfg_has_feature(ctx, val)
    } else {
        *out_val = false
    }
    true
}

fn cfg_eval_inner(
    expr: StrView,
    ctx: view<CfgContext>,
    depth: u32,
    out_val: mut_view<bool>,
    sink: mut_view<DiagSink>
) -> bool {
    if depth > 16u32 {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_NAME_INVALID_CFG_PREDICATE,
            "`@cfg` predicate nesting depth exceeded",
            "key",
            expr,
            "value",
            ux2_sv_empty()
        )
        return false
    }
    let t = bld_sv_trim(expr)
    if t.len == 0usize {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_NAME_INVALID_CFG_PREDICATE,
            "empty `@cfg` predicate",
            "key",
            ux2_sv_empty(),
            "value",
            ux2_sv_empty()
        )
        return false
    }
    // Combinators: `not(...)`, `all(...)`, `any(...)`
    let is_not = bld_sv_starts_with(t, ux2_sv("not("))
    let is_all = bld_sv_starts_with(t, ux2_sv("all("))
    let is_any = bld_sv_starts_with(t, ux2_sv("any("))
    if is_not || is_all || is_any {
        if bld_sv_byte(t, t.len - 1usize) != 41u8 {
            report_manifest_diag_2(
                mut_view(*sink),
                AX_NAME_INVALID_CFG_PREDICATE,
                "unclosed parenthesis in `@cfg` combinator",
                "key",
                t,
                "value",
                ux2_sv_empty()
            )
            return false
        }
        let body = bld_sv_trim(bld_sv_slice(t, 4usize, t.len - 1usize))
        if body.len == 0usize {
            report_manifest_diag_2(
                mut_view(*sink),
                AX_NAME_INVALID_CFG_PREDICATE,
                "empty combinator argument list in `@cfg`",
                "key",
                t,
                "value",
                ux2_sv_empty()
            )
            return false
        }
        if is_not {
            let mut sub_v: bool = false
            if !cfg_eval_inner(body, ctx, depth + 1u32, mut_view(sub_v), mut_view(*sink)) {
                return false
            }
            *out_val = !sub_v
            return true
        }
        // Split top-level comma-separated arguments inside `all(...)` or `any(...)`
        let mut acc: bool = if is_all { true } else { false }
        let mut paren_depth: i32 = 0i32
        let mut in_quotes: bool = false
        let mut seg_start: usize = 0usize
        let mut i: usize = 0usize
        while i <= body.len {
            let at_end = i == body.len
            let b = if at_end { 44u8 } else { bld_sv_byte(body, i) }
            if !at_end {
                if b == 34u8 {
                    in_quotes = !in_quotes
                } else if !in_quotes {
                    if b == 40u8 {
                        paren_depth = paren_depth + 1i32
                    } else if b == 41u8 {
                        paren_depth = paren_depth - 1i32
                        if paren_depth < 0i32 {
                            report_manifest_diag_2(
                                mut_view(*sink),
                                AX_NAME_INVALID_CFG_PREDICATE,
                                "unbalanced parentheses in `@cfg` predicate",
                                "key",
                                t,
                                "value",
                                ux2_sv_empty()
                            )
                            return false
                        }
                    }
                }
            }
            if at_end || (b == 44u8 && !in_quotes && paren_depth == 0i32) {
                let seg = bld_sv_trim(bld_sv_slice(body, seg_start, i))
                if seg.len == 0usize {
                    report_manifest_diag_2(
                        mut_view(*sink),
                        AX_NAME_INVALID_CFG_PREDICATE,
                        "empty argument in `@cfg` combinator",
                        "key",
                        t,
                        "value",
                        ux2_sv_empty()
                    )
                    return false
                }
                let mut item_v: bool = false
                if !cfg_eval_inner(seg, ctx, depth + 1u32, mut_view(item_v), mut_view(*sink)) {
                    return false
                }
                if is_all {
                    acc = acc && item_v
                } else {
                    acc = acc || item_v
                }
                seg_start = i + 1usize
            }
            i = i + 1usize
        }
        if in_quotes || paren_depth != 0i32 {
            report_manifest_diag_2(
                mut_view(*sink),
                AX_NAME_INVALID_CFG_PREDICATE,
                "unbalanced quotes or parentheses in `@cfg` combinator",
                "key",
                t,
                "value",
                ux2_sv_empty()
            )
            return false
        }
        *out_val = acc
        return true
    }
    cfg_eval_atom(t, ctx, out_val, sink)
}

pub fn cfg_validate_and_eval(
    raw_expr: StrView,
    ctx: view<CfgContext>,
    out_matched: mut_view<bool>,
    sink: mut_view<DiagSink>
) -> bool {
    *out_matched = false
    let t = bld_sv_trim(raw_expr)
    if t.len == 0usize {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_NAME_INVALID_CFG_PREDICATE,
            "empty `@cfg(...)` expression in `axiom.toml`",
            "key",
            ux2_sv_empty(),
            "value",
            ux2_sv_empty()
        )
        return false
    }
    let mut inner = t
    if bld_sv_starts_with(t, ux2_sv("cfg(")) {
        if bld_sv_byte(t, t.len - 1usize) != 41u8 {
            report_manifest_diag_2(
                mut_view(*sink),
                AX_NAME_INVALID_CFG_PREDICATE,
                "missing closing `)` in `cfg(...)` target predicate",
                "key",
                t,
                "value",
                ux2_sv_empty()
            )
            return false
        }
        inner = bld_sv_trim(bld_sv_slice(t, 4usize, t.len - 1usize))
    }
    cfg_eval_inner(inner, ctx, 0u32, out_matched, sink)
}

// =============================================================================
// 6. Canonical Build Profiles & Declarative Manifest Schema (`AXS-BLD-011`, `AXS-BLD-016`)
// =============================================================================

@derive(Copy)
pub struct ProfileConfig {
    pub name: StrView,
    pub kind: u8,
    pub inherits: StrView,
    pub opt_level: u8,
    pub debug_info: StrView,
    pub overflow_checks: bool,
    pub lto: StrView,
    pub panic_strategy: StrView,
    pub safety_profile: StrView,
    pub incremental: bool,
    pub deterministic: bool,
    pub codegen_units: u32,
}

pub fn profile_builtin_dev() -> ProfileConfig {
    ProfileConfig {
        name: ux2_sv("dev"),
        kind: PROFILE_DEV,
        inherits: ux2_sv("dev"),
        opt_level: 0u8,
        debug_info: ux2_sv("full"),
        overflow_checks: true,
        lto: ux2_sv("off"),
        panic_strategy: ux2_sv("unwind"),
        safety_profile: ux2_sv("safe"),
        incremental: true,
        deterministic: true,
        codegen_units: 16u32,
    }
}

pub fn profile_builtin_release() -> ProfileConfig {
    ProfileConfig {
        name: ux2_sv("release"),
        kind: PROFILE_RELEASE,
        inherits: ux2_sv("release"),
        opt_level: 3u8,
        debug_info: ux2_sv("none"),
        overflow_checks: true,
        lto: ux2_sv("thin"),
        panic_strategy: ux2_sv("unwind"),
        safety_profile: ux2_sv("safe"),
        incremental: false,
        deterministic: true,
        codegen_units: 1u32,
    }
}

pub fn profile_builtin_test() -> ProfileConfig {
    let mut p = profile_builtin_dev()
    p.name = ux2_sv("test")
    p.kind = PROFILE_TEST
    p.inherits = ux2_sv("dev")
    p
}

pub fn profile_builtin_bench() -> ProfileConfig {
    let mut p = profile_builtin_release()
    p.name = ux2_sv("bench")
    p.kind = PROFILE_BENCH
    p.inherits = ux2_sv("release")
    p
}

@derive(Copy)
pub struct LibTargetDecl {
    pub present: bool,
    pub name: StrView,
    pub path: StrView,
    pub crate_types: [4]StrView,
    pub crate_type_count: usize,
}

@derive(Copy)
pub struct BinTargetDecl {
    pub name: StrView,
    pub path: StrView,
}

@derive(Copy)
