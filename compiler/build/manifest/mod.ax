    pub author_count: usize,
    pub workspace_root: StrView,
    pub bootstrap_internal: bool,
}

@derive(Copy)
pub struct DeclarativeManifest {
    pub has_package: bool,
    pub has_workspace: bool,
    pub package: PackageTableDecl,
    pub workspace: WorkspaceTableDecl,
    pub lib_target: LibTargetDecl,
    pub bin_targets: [8]BinTargetDecl,
    pub bin_count: usize,
    pub build_tools: [4]BuildToolTargetDecl,
    pub build_tool_count: usize,
    pub features: [16]FeatureDecl,
    pub feature_count: usize,
    pub dependencies: [24]DependencyDecl,
    pub dependency_count: usize,
    pub profiles: [8]ProfileConfig,
    pub profile_count: usize,
    pub valid: bool,
}

pub fn feature_decl_empty() -> FeatureDecl {
    let e = ux2_sv_empty()
    FeatureDecl {
        name: e,
        implies: [e; 8],
        implies_count: 0usize,
        conflicts_with: [e; 4],
        conflicts_count: 0usize,
        is_implicit_optional_dep: false,
    }
}

pub fn dependency_decl_empty() -> DependencyDecl {
    let e = ux2_sv_empty()
    DependencyDecl {
        name: e,
        package_alias: e,
        scope: DEP_SCOPE_NORMAL,
        version_req: e,
        path: e,
        git: e,
        rev: e,
        registry: e,
        optional: false,
        default_features: true,
        features: [e; 8],
        feature_count: 0usize,
        has_target_cfg: false,
        target_cfg: e,
    }
}

pub fn declarative_manifest_empty() -> DeclarativeManifest {
    let e = ux2_sv_empty()
    let bin_e = BinTargetDecl { name: e, path: e }
    let bt_e = BuildToolTargetDecl {
        name: e,
        path: e,
        inputs: [e; 4],
        input_count: 0usize,
        outputs: [e; 4],
        output_count: 0usize,
    }
    let feat_e = feature_decl_empty()
    let dep_e = dependency_decl_empty()
    let prof_dev = profile_builtin_dev()
    let mut profs: [8]ProfileConfig = [prof_dev; 8]
    profs[0] = profile_builtin_dev()
    profs[1] = profile_builtin_release()
    profs[2] = profile_builtin_test()
    profs[3] = profile_builtin_bench()
    DeclarativeManifest {
        has_package: false,
        has_workspace: false,
        package: PackageTableDecl {
            present: false,
            name: e,
            version: semver_zero(),
            has_version: false,
            edition: ux2_sv("2026"),
            has_edition: false,
            axiom_req: e,
            license: e,
            description: e,
            authors: [e; 4],
            author_count: 0usize,
            workspace_root: e,
            bootstrap_internal: false,
        },
        workspace: WorkspaceTableDecl {
            present: false,
            members: [e; 16],
            member_count: 0usize,
            exclude: [e; 8],
            exclude_count: 0usize,
            default_members: [e; 16],
            default_member_count: 0usize,
            resolver: ux2_sv("1"),
        },
        lib_target: LibTargetDecl {
            present: false,
            name: e,
            path: ux2_sv("src/lib.ax"),
            crate_types: [ux2_sv("axlib"), e, e, e],
            crate_type_count: 1usize,
        },
        bin_targets: [bin_e; 8],
        bin_count: 0usize,
        build_tools: [bt_e; 4],
        build_tool_count: 0usize,
        features: [feat_e; 16],
        feature_count: 0usize,
        dependencies: [dep_e; 24],
        dependency_count: 0usize,
        profiles: profs,
        profile_count: 4usize,
        valid: false,
    }
}

// =============================================================================
// 7. TOML Value & Inline Table Parsing Helpers
// =============================================================================

fn parse_toml_string(raw: StrView, out_sv: mut_view<StrView>) -> bool {
    let t = bld_sv_trim(raw)
    if (t.len) < 2usize {
        return false
    }
    let q0 = bld_sv_byte(t, 0usize)
    let q1 = bld_sv_byte(t, t.len - 1usize)
    if (q0 != 34u8 && q0 != 39u8) || q0 != q1 {
        return false
    }
    let mut i: usize = 1usize
    while (i + 1usize) < t.len {
        let b = bld_sv_byte(t, i)
        if b == 92u8 && q0 == 34u8 {
            i = i + 2usize
            continue
        }
        if b == q0 {
            return false
        }
        i = i + 1usize
    }
    *out_sv = bld_sv_slice(t, 1usize, t.len - 1usize)
    true
}

fn parse_toml_bool(raw: StrView, out_b: mut_view<bool>) -> bool {
    let t = bld_sv_trim(raw)
    if ux2_sv_eq(t, ux2_sv("true")) {
        *out_b = true
        return true
    }
    if ux2_sv_eq(t, ux2_sv("false")) {
        *out_b = false
        return true
    }
    false
}

fn parse_toml_u32(raw: StrView, out_n: mut_view<u32>) -> bool {
    let t = bld_sv_trim(raw)
    if t.len == 0usize || t.len > 9usize {
        return false
    }
    let mut acc: u32 = 0u32
    let mut i: usize = 0usize
    while i < t.len {
        let b = bld_sv_byte(t, i)
        if b < 48u8 || b > 57u8 {
            return false
        }
        acc = acc * 10u32 + ((b - 48u8) as u32)
        i = i + 1usize
    }
    *out_n = acc
    true
}

fn parse_toml_string_array_16(
    raw: StrView,
    out_items: mut_view<[16]StrView>,
    max_cap: usize,
    out_count: mut_view<usize>
) -> bool {
    *out_count = 0usize
    let t = bld_sv_trim(raw)
    if (t.len) < 2usize || bld_sv_byte(t, 0usize) != 91u8 || bld_sv_byte(t, t.len - 1usize) != 93u8 {
        return false
    }
    let inner = bld_sv_trim(bld_sv_slice(t, 1usize, t.len - 1usize))
    if inner.len == 0usize {
        return true
    }
    let mut in_quotes: bool = false
    let mut quote_ch: u8 = 0u8
    let mut seg_start: usize = 0usize
    let mut i: usize = 0usize
    while i <= inner.len {
        let at_end = i == inner.len
        let b = if at_end { 44u8 } else { bld_sv_byte(inner, i) }
        if !at_end {
            if !in_quotes && (b == 34u8 || b == 39u8) {
                in_quotes = true
                quote_ch = b
            } else if in_quotes && b == quote_ch {
                in_quotes = false
            }
        }
        if at_end || (b == 44u8 && !in_quotes) {
            let item_raw = bld_sv_trim(bld_sv_slice(inner, seg_start, i))
            if item_raw.len == 0usize {
                if at_end {
                    break
                }
                return false
            }
            let mut parsed_item = ux2_sv_empty()
            if !parse_toml_string(item_raw, mut_view(parsed_item)) {
                return false
            }
            if *out_count < max_cap && *out_count < 16usize {
                (*out_items)[*out_count] = parsed_item
                *out_count = *out_count + 1usize
            }
            seg_start = i + 1usize
        }
        i = i + 1usize
    }
    !in_quotes
}

// =============================================================================
// 8. Section-Specific Key-Value Parsers (`[package]`, `[workspace]`, `[lib]`,
//    `[[bin]]`, `[[build_tool]]`, `[features]`, `[dependencies]`, `[profile.*]`)
// =============================================================================

fn parse_package_kv(
    m: mut_view<DeclarativeManifest>,
    key: StrView,
    val: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if ux2_sv_eq(key, ux2_sv("name")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[package].name` must be a string", "kind", ux2_sv("schema"))
            return false
        }
        m.package.name = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("version")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[package].version` must be a string", "kind", ux2_sv("semver"))
            return false
        }
        let mut sv = semver_zero()
        if !semver_parse(s, mut_view(sv)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid Semantic Version in `[package].version`", "kind", ux2_sv("semver"))
            return false
        }
        m.package.version = sv
        m.package.has_version = true
        return true
    }
    if ux2_sv_eq(key, ux2_sv("edition")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || !ux2_sv_eq(s, ux2_sv("2026")) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unsupported or invalid `[package].edition` (expected `\"2026\"`)", "kind", ux2_sv("schema"))
            return false
        }
        m.package.edition = s
        m.package.has_edition = true
        return true
    }
    if ux2_sv_eq(key, ux2_sv("axiom")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || !semver_req_valid(s) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[package].axiom` toolchain version requirement", "kind", ux2_sv("semver"))
            return false
        }
        m.package.axiom_req = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("license")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[package].license` must be a string", "kind", ux2_sv("schema"))
            return false
        }
        m.package.license = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("description")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[package].description` must be a string", "kind", ux2_sv("schema"))
            return false
        }
        m.package.description = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("workspace")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[package].workspace` must be a string path", "kind", ux2_sv("schema"))
            return false
        }
        m.package.workspace_root = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("bootstrap_internal")) {
        let mut b: bool = false
        if !parse_toml_bool(val, mut_view(b)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[package].bootstrap_internal` must be a boolean", "kind", ux2_sv("schema"))
            return false
        }
        m.package.bootstrap_internal = b
        return true
    }
    if ux2_sv_eq(key, ux2_sv("authors")) {
        let mut tmp: [16]StrView = [ux2_sv_empty(); 16]
        let mut cnt: usize = 0usize
        if !parse_toml_string_array_16(val, mut_view(tmp), 4usize, mut_view(cnt)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[package].authors` must be an array of strings", "kind", ux2_sv("schema"))
            return false
        }
        let mut i: usize = 0usize
        while i < cnt && i < 4usize {
            m.package.authors[i] = tmp[i]
            i = i + 1usize
        }
        m.package.author_count = cnt
        return true
    }
    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown key in `[package]` table", "kind", ux2_sv("schema"))
    false
}

fn parse_workspace_kv(
    m: mut_view<DeclarativeManifest>,
    key: StrView,
    val: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if ux2_sv_eq(key, ux2_sv("members")) {
        let mut tmp: [16]StrView = [ux2_sv_empty(); 16]
        let mut cnt: usize = 0usize
        if !parse_toml_string_array_16(val, mut_view(tmp), 16usize, mut_view(cnt)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[workspace].members` must be an array of string paths", "kind", ux2_sv("schema"))
            return false
        }
        m.workspace.members = tmp
        m.workspace.member_count = cnt
        return true
    }
    if ux2_sv_eq(key, ux2_sv("exclude")) {
        let mut tmp: [16]StrView = [ux2_sv_empty(); 16]
        let mut cnt: usize = 0usize
        if !parse_toml_string_array_16(val, mut_view(tmp), 8usize, mut_view(cnt)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[workspace].exclude` must be an array of string paths", "kind", ux2_sv("schema"))
            return false
        }
        let mut i: usize = 0usize
        while i < cnt && i < 8usize {
            m.workspace.exclude[i] = tmp[i]
            i = i + 1usize
        }
        m.workspace.exclude_count = cnt
        return true
    }
    if ux2_sv_eq(key, ux2_sv("default_members")) {
        let mut tmp: [16]StrView = [ux2_sv_empty(); 16]
        let mut cnt: usize = 0usize
        if !parse_toml_string_array_16(val, mut_view(tmp), 16usize, mut_view(cnt)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[workspace].default_members` must be an array of string paths", "kind", ux2_sv("schema"))
            return false
        }
        m.workspace.default_members = tmp
        m.workspace.default_member_count = cnt
        return true
    }
    if ux2_sv_eq(key, ux2_sv("resolver")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || (!ux2_sv_eq(s, ux2_sv("1")) && !ux2_sv_eq(s, ux2_sv("2"))) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[workspace].resolver` version", "kind", ux2_sv("schema"))
            return false
        }
        m.workspace.resolver = s
        return true
    }
    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown key in `[workspace]` table", "kind", ux2_sv("schema"))
    false
}

fn parse_lib_kv(
    m: mut_view<DeclarativeManifest>,
    key: StrView,
    val: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if ux2_sv_eq(key, ux2_sv("name")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || !validate_package_name(s, m.package.bootstrap_internal) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[lib].name` identifier", "kind", ux2_sv("schema"))
            return false
        }
        m.lib_target.name = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("path")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || s.len == 0usize {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[lib].path`", "kind", ux2_sv("schema"))
            return false
        }
        m.lib_target.path = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("crate_type")) {
        let mut tmp: [16]StrView = [ux2_sv_empty(); 16]
        let mut cnt: usize = 0usize
        if !parse_toml_string_array_16(val, mut_view(tmp), 4usize, mut_view(cnt)) || cnt == 0usize {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[lib].crate_type` must be a non-empty string array", "kind", ux2_sv("schema"))
            return false
        }
        let mut i: usize = 0usize
        while i < cnt && i < 4usize {
            let ct = tmp[i]
            if !ux2_sv_eq(ct, ux2_sv("lib")) && !ux2_sv_eq(ct, ux2_sv("axlib")) &&
                !ux2_sv_eq(ct, ux2_sv("rlib")) && !ux2_sv_eq(ct, ux2_sv("staticlib")) &&
                !ux2_sv_eq(ct, ux2_sv("cdylib")) {
                report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unsupported `[lib].crate_type` entry", "kind", ux2_sv("schema"))
                return false
            }
            m.lib_target.crate_types[i] = ct
            i = i + 1usize
        }
        m.lib_target.crate_type_count = cnt
        return true
    }
    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown key in `[lib]` table", "kind", ux2_sv("schema"))
    false
}

fn parse_bin_kv(
    m: mut_view<DeclarativeManifest>,
    key: StrView,
    val: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if m.bin_count == 0usize {
        return false
    }
    let idx = m.bin_count - 1usize
    if ux2_sv_eq(key, ux2_sv("name")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || !validate_package_name(s, m.package.bootstrap_internal) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[[bin]].name` identifier", "kind", ux2_sv("schema"))
            return false
        }
        m.bin_targets[idx].name = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("path")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || s.len == 0usize {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[[bin]].path`", "kind", ux2_sv("schema"))
            return false
        }
        m.bin_targets[idx].path = s
        return true
    }
    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown key in `[[bin]]` table", "kind", ux2_sv("schema"))
    false
}

fn parse_build_tool_kv(
    m: mut_view<DeclarativeManifest>,
    key: StrView,
    val: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if m.build_tool_count == 0usize {
        return false
    }
    let idx = m.build_tool_count - 1usize
    if ux2_sv_eq(key, ux2_sv("name")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || !validate_package_name(s, true) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[[build_tool]].name`", "kind", ux2_sv("schema"))
            return false
        }
        m.build_tools[idx].name = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("path")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || s.len == 0usize {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[[build_tool]].path`", "kind", ux2_sv("schema"))
            return false
        }
        m.build_tools[idx].path = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("inputs")) {
        let mut tmp: [16]StrView = [ux2_sv_empty(); 16]
        let mut cnt: usize = 0usize
        if !parse_toml_string_array_16(val, mut_view(tmp), 4usize, mut_view(cnt)) || cnt == 0usize {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[[build_tool]].inputs` must be a non-empty string array", "kind", ux2_sv("schema"))
            return false
        }
        let mut i: usize = 0usize
        while i < cnt && i < 4usize {
            m.build_tools[idx].inputs[i] = tmp[i]
            i = i + 1usize
        }
        m.build_tools[idx].input_count = cnt
        return true
    }
    if ux2_sv_eq(key, ux2_sv("outputs")) {
        let mut tmp: [16]StrView = [ux2_sv_empty(); 16]
        let mut cnt: usize = 0usize
        if !parse_toml_string_array_16(val, mut_view(tmp), 4usize, mut_view(cnt)) || cnt == 0usize {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[[build_tool]].outputs` must be a non-empty string array", "kind", ux2_sv("schema"))
            return false
        }
        let mut i: usize = 0usize
        while i < cnt && i < 4usize {
            m.build_tools[idx].outputs[i] = tmp[i]
            i = i + 1usize
        }
        m.build_tools[idx].output_count = cnt
        return true
    }
    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown key in `[[build_tool]]` table", "kind", ux2_sv("schema"))
    false
}

fn parse_feature_kv(
    m: mut_view<DeclarativeManifest>,
    key: StrView,
    val: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if !ux2_sv_eq(key, ux2_sv("default")) && !validate_package_name(key, true) {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid feature identifier in `[features]`", "kind", ux2_sv("schema"))
        return false
    }
    if m.feature_count >= 16usize {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "too many features in `[features]`", "kind", ux2_sv("schema"))
        return false
    }
    let mut fd = feature_decl_empty()
    fd.name = key
    let tv = bld_sv_trim(val)
    if tv.len >= 2usize && bld_sv_byte(tv, 0usize) == 123u8 && bld_sv_byte(tv, tv.len - 1usize) == 125u8 {
        // Inline feature table: `{ implies = [...], conflicts_with = [...] }`
        let inner = bld_sv_trim(bld_sv_slice(tv, 1usize, tv.len - 1usize))
        let mut in_quotes: bool = false
        let mut bracket_depth: i32 = 0i32
        let mut seg_start: usize = 0usize
        let mut i: usize = 0usize
        while i <= inner.len {
            let at_end = i == inner.len
            let b = if at_end { 44u8 } else { bld_sv_byte(inner, i) }
            if !at_end {
                if b == 34u8 {
                    in_quotes = !in_quotes
                } else if !in_quotes {
                    if b == 91u8 {
                        bracket_depth = bracket_depth + 1i32
                    } else if b == 93u8 {
                        bracket_depth = bracket_depth - 1i32
                    }
                }
            }
            if at_end || (b == 44u8 && !in_quotes && bracket_depth == 0i32) {
                let seg = bld_sv_trim(bld_sv_slice(inner, seg_start, i))
                if seg.len > 0usize {
                    let mut eq_idx: usize = seg.len
                    let mut k: usize = 0usize
                    while k < seg.len {
                        if bld_sv_byte(seg, k) == 61u8 {
                            eq_idx = k
                            break
                        }
                        k = k + 1usize
                    }
                    if eq_idx == seg.len {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "malformed inline `[features]` entry", "kind", ux2_sv("syntax"))
                        return false
                    }
                    let sub_k = bld_sv_trim(bld_sv_slice(seg, 0usize, eq_idx))
                    let sub_v = bld_sv_trim(bld_sv_slice(seg, eq_idx + 1usize, seg.len))
                    if is_forbidden_script_key(sub_k) {
                        report_manifest_diag_2(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "imperative build script directive is forbidden in `axiom.toml`", "kind", ux2_sv("forbidden_script"), "key", sub_k)
                        return false
                    }
                    let mut arr: [16]StrView = [ux2_sv_empty(); 16]
                    let mut cnt: usize = 0usize
                    if ux2_sv_eq(sub_k, ux2_sv("implies")) {
                        if !parse_toml_string_array_16(sub_v, mut_view(arr), 8usize, mut_view(cnt)) {
                            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "feature `implies` must be a string array", "kind", ux2_sv("schema"))
                            return false
                        }
                        let mut j: usize = 0usize
                        while j < cnt && j < 8usize {
                            fd.implies[j] = arr[j]
                            j = j + 1usize
                        }
                        fd.implies_count = cnt
                    } else if ux2_sv_eq(sub_k, ux2_sv("conflicts_with")) {
                        if !parse_toml_string_array_16(sub_v, mut_view(arr), 4usize, mut_view(cnt)) {
                            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "feature `conflicts_with` must be a string array", "kind", ux2_sv("schema"))
                            return false
                        }
                        let mut j: usize = 0usize
                        while j < cnt && j < 4usize {
                            fd.conflicts_with[j] = arr[j]
                            j = j + 1usize
                        }
                        fd.conflicts_count = cnt
                    } else {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown key in inline `[features]` specification", "kind", ux2_sv("schema"))
                        return false
                    }
                }
                seg_start = i + 1usize
            }
            i = i + 1usize
        }
    } else {
        let mut arr: [16]StrView = [ux2_sv_empty(); 16]
        let mut cnt: usize = 0usize
        if !parse_toml_string_array_16(tv, mut_view(arr), 12usize, mut_view(cnt)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "feature value in `[features]` must be a string array or inline table", "kind", ux2_sv("schema"))
            return false
        }
        let mut j: usize = 0usize
        while j < cnt {
            let item = arr[j]
            if item.len > 1usize && bld_sv_byte(item, 0usize) == 33u8 {
                let c_name = bld_sv_slice(item, 1usize, item.len)
                if (fd.conflicts_count) < 4usize {
                    fd.conflicts_with[fd.conflicts_count] = c_name
                    fd.conflicts_count = fd.conflicts_count + 1usize
                }
            } else if bld_sv_starts_with(item, ux2_sv("conflicts_with:")) {
                let c_name = bld_sv_slice(item, 15usize, item.len)
                if (fd.conflicts_count) < 4usize {
                    fd.conflicts_with[fd.conflicts_count] = c_name
                    fd.conflicts_count = fd.conflicts_count + 1usize
                }
            } else {
                if (fd.implies_count) < 8usize {
                    fd.implies[fd.implies_count] = item
                    fd.implies_count = fd.implies_count + 1usize
                }
            }
            j = j + 1usize
        }
    }
    m.features[m.feature_count] = fd
    m.feature_count = m.feature_count + 1usize
    true
}

fn parse_dep_kv(
    m: mut_view<DeclarativeManifest>,
    scope: u8,
    has_cfg: bool,
    cfg_expr: StrView,
    key: StrView,
    val: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if !validate_package_name(key, true) {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid dependency package name in `axiom.toml`", "kind", ux2_sv("schema"))
        return false
    }
    if m.dependency_count >= 24usize {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "too many dependencies in `axiom.toml`", "kind", ux2_sv("schema"))
        return false
    }
    let mut dep = dependency_decl_empty()
    dep.name = key
    dep.package_alias = key
    dep.scope = scope
    dep.has_target_cfg = has_cfg
    dep.target_cfg = cfg_expr

    let tv = bld_sv_trim(val)
    if tv.len >= 2usize && (bld_sv_byte(tv, 0usize) == 34u8 || bld_sv_byte(tv, 0usize) == 39u8) {
        let mut ver_sv = ux2_sv_empty()
        if !parse_toml_string(tv, mut_view(ver_sv)) || !semver_req_valid(ver_sv) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid Semantic Version requirement in dependency string", "kind", ux2_sv("semver"))
            return false
        }
        dep.version_req = ver_sv
        m.dependencies[m.dependency_count] = dep
        m.dependency_count = m.dependency_count + 1usize
        return true
    }

    if (tv.len) < 2usize || bld_sv_byte(tv, 0usize) != 123u8 || bld_sv_byte(tv, tv.len - 1usize) != 125u8 {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "dependency specification must be a version string or inline table `{ ... }`", "kind", ux2_sv("schema"))
        return false
    }

    let inner = bld_sv_trim(bld_sv_slice(tv, 1usize, tv.len - 1usize))
    if inner.len == 0usize {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "empty dependency inline table `{}`", "kind", ux2_sv("schema"))
        return false
    }

    let mut in_quotes: bool = false
    let mut bracket_depth: i32 = 0i32
    let mut seg_start: usize = 0usize
    let mut has_source: bool = scope == DEP_SCOPE_SYSTEM
    let mut i: usize = 0usize
    while i <= inner.len {
        let at_end = i == inner.len
        let b = if at_end { 44u8 } else { bld_sv_byte(inner, i) }
        if !at_end {
            if b == 34u8 {
                in_quotes = !in_quotes
            } else if !in_quotes {
                if b == 91u8 {
                    bracket_depth = bracket_depth + 1i32
                } else if b == 93u8 {
                    bracket_depth = bracket_depth - 1i32
                }
            }
        }
        if at_end || (b == 44u8 && !in_quotes && bracket_depth == 0i32) {
            let seg = bld_sv_trim(bld_sv_slice(inner, seg_start, i))
            if seg.len > 0usize {
                let mut eq_idx: usize = seg.len
                let mut k: usize = 0usize
                while k < seg.len {
                    if bld_sv_byte(seg, k) == 61u8 {
                        eq_idx = k
                        break
                    }
                    k = k + 1usize
                }
                if eq_idx == seg.len {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "missing `=` in inline dependency table", "kind", ux2_sv("syntax"))
                    return false
                }
                let dk = bld_sv_trim(bld_sv_slice(seg, 0usize, eq_idx))
                let dv = bld_sv_trim(bld_sv_slice(seg, eq_idx + 1usize, seg.len))
                if is_forbidden_script_key(dk) {
                    report_manifest_diag_2(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "imperative build script directive is forbidden in dependency table", "kind", ux2_sv("forbidden_script"), "key", dk)
                    return false
                }
                if ux2_sv_eq(dk, ux2_sv("version")) {
                    let mut vs = ux2_sv_empty()
                    if !parse_toml_string(dv, mut_view(vs)) || !semver_req_valid(vs) {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid Semantic Version requirement in dependency `version`", "kind", ux2_sv("semver"))
                        return false
                    }
                    dep.version_req = vs
                    has_source = true
                } else if ux2_sv_eq(dk, ux2_sv("path")) {
                    let mut ps = ux2_sv_empty()
                    if !parse_toml_string(dv, mut_view(ps)) || ps.len == 0usize {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid dependency `path` string", "kind", ux2_sv("schema"))
                        return false
                    }
                    dep.path = ps
                    has_source = true
                } else if ux2_sv_eq(dk, ux2_sv("git")) {
                    let mut gs = ux2_sv_empty()
                    if !parse_toml_string(dv, mut_view(gs)) || gs.len == 0usize {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid dependency `git` URL", "kind", ux2_sv("schema"))
                        return false
                    }
                    dep.git = gs
                    has_source = true
                } else if ux2_sv_eq(dk, ux2_sv("rev")) {
                    let mut rs = ux2_sv_empty()
                    if !parse_toml_string(dv, mut_view(rs)) || rs.len == 0usize {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid dependency `rev` digest", "kind", ux2_sv("schema"))
                        return false
                    }
                    dep.rev = rs
                } else if ux2_sv_eq(dk, ux2_sv("registry")) {
                    let mut rgs = ux2_sv_empty()
                    if !parse_toml_string(dv, mut_view(rgs)) || rgs.len == 0usize {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid dependency `registry` name", "kind", ux2_sv("schema"))
                        return false
                    }
                    dep.registry = rgs
                } else if ux2_sv_eq(dk, ux2_sv("package")) || ux2_sv_eq(dk, ux2_sv("lib_name")) {
                    let mut pks = ux2_sv_empty()
                    if !parse_toml_string(dv, mut_view(pks)) || !validate_package_name(pks, true) {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid dependency `package` alias", "kind", ux2_sv("schema"))
                        return false
                    }
                    dep.package_alias = pks
                    if scope == DEP_SCOPE_SYSTEM {
                        has_source = true
                    }
                } else if ux2_sv_eq(dk, ux2_sv("optional")) {
                    let mut ob: bool = false
                    if !parse_toml_bool(dv, mut_view(ob)) {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "dependency `optional` must be a boolean", "kind", ux2_sv("schema"))
                        return false
                    }
                    dep.optional = ob
                } else if ux2_sv_eq(dk, ux2_sv("default_features")) || ux2_sv_eq(dk, ux2_sv("default-features")) {
                    let mut dfb: bool = true
                    if !parse_toml_bool(dv, mut_view(dfb)) {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "dependency `default_features` must be a boolean", "kind", ux2_sv("schema"))
                        return false
                    }
                    dep.default_features = dfb
                } else if ux2_sv_eq(dk, ux2_sv("features")) {
                    let mut farr: [16]StrView = [ux2_sv_empty(); 16]
                    let mut fcnt: usize = 0usize
                    if !parse_toml_string_array_16(dv, mut_view(farr), 8usize, mut_view(fcnt)) {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "dependency `features` must be an array of strings", "kind", ux2_sv("schema"))
                        return false
                    }
                    let mut fi: usize = 0usize
                    while fi < fcnt && fi < 8usize {
                        dep.features[fi] = farr[fi]
                        fi = fi + 1usize
                    }
                    dep.feature_count = fcnt
                } else {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown key in inline dependency table", "kind", ux2_sv("schema"))
                    return false
                }
            }
            seg_start = i + 1usize
        }
        i = i + 1usize
    }

    if !has_source {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "dependency must declare `version`, `path`, or `git`", "kind", ux2_sv("schema"))
        return false
    }
    m.dependencies[m.dependency_count] = dep
    m.dependency_count = m.dependency_count + 1usize
    true
}

fn find_or_create_profile(
    m: mut_view<DeclarativeManifest>,
    prof_name: StrView,
    out_idx: mut_view<usize>,
    sink: mut_view<DiagSink>
) -> bool {
    if !validate_package_name(prof_name, true) {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "invalid profile name in `[profile.<name>]`", "profile", prof_name)
        return false
    }
    let mut i: usize = 0usize
    while i < m.profile_count {
        if ux2_sv_eq(m.profiles[i].name, prof_name) {
            *out_idx = i
            return true
        }
        i = i + 1usize
    }
    if m.profile_count >= 8usize {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "too many custom profiles in `axiom.toml`", "profile", prof_name)
        return false
    }
    let mut custom = profile_builtin_dev()
    custom.name = prof_name
    custom.kind = PROFILE_CUSTOM
    custom.inherits = ux2_sv_empty()
    let idx = m.profile_count
    m.profiles[idx] = custom
    m.profile_count = idx + 1usize
    *out_idx = idx
    true
}

fn parse_profile_kv(
    m: mut_view<DeclarativeManifest>,
    prof_idx: usize,
    key: StrView,
    val: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if prof_idx >= m.profile_count {
        return false
    }
    let pname = m.profiles[prof_idx].name
    if ux2_sv_eq(key, ux2_sv("inherits")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || (!ux2_sv_eq(s, ux2_sv("dev")) && !ux2_sv_eq(s, ux2_sv("release"))) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "`[profile.<name>].inherits` must be `\"dev\"` or `\"release\"`", "profile", pname)
            return false
        }
        if ux2_sv_eq(s, ux2_sv("release")) && m.profiles[prof_idx].kind == PROFILE_CUSTOM {
            let base = profile_builtin_release()
            m.profiles[prof_idx].opt_level = base.opt_level
            m.profiles[prof_idx].debug_info = base.debug_info
            m.profiles[prof_idx].lto = base.lto
            m.profiles[prof_idx].incremental = base.incremental
            m.profiles[prof_idx].codegen_units = base.codegen_units
        }
        m.profiles[prof_idx].inherits = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("opt_level")) {
        let mut n: u32 = 0u32
        if !parse_toml_u32(val, mut_view(n)) || n > 3u32 {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "`opt_level` in `[profile]` must be an integer in 0..=3", "profile", pname)
            return false
        }
        m.profiles[prof_idx].opt_level = n as u8
        return true
    }
    if ux2_sv_eq(key, ux2_sv("lto")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || (!ux2_sv_eq(s, ux2_sv("off")) && !ux2_sv_eq(s, ux2_sv("thin")) && !ux2_sv_eq(s, ux2_sv("fat"))) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "`lto` in `[profile]` must be `\"off\"`, `\"thin\"`, or `\"fat\"`", "profile", pname)
            return false
        }
        m.profiles[prof_idx].lto = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("panic")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || (!ux2_sv_eq(s, ux2_sv("unwind")) && !ux2_sv_eq(s, ux2_sv("abort"))) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PANIC_STRATEGY, "`panic` in `[profile]` must be `\"unwind\"` or `\"abort\"`", "profile", pname)
            return false
        }
        m.profiles[prof_idx].panic_strategy = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("safety_profile")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || (!ux2_sv_eq(s, ux2_sv("safe")) && !ux2_sv_eq(s, ux2_sv("strict")) && !ux2_sv_eq(s, ux2_sv("hardened")) && !ux2_sv_eq(s, ux2_sv("balanced"))) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_SAFETY_PROFILE, "invalid `safety_profile` in `[profile]`", "profile", pname)
            return false
        }
        m.profiles[prof_idx].safety_profile = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("debug_info")) {
        let mut s = ux2_sv_empty()
        if !parse_toml_string(val, mut_view(s)) || (!ux2_sv_eq(s, ux2_sv("none")) && !ux2_sv_eq(s, ux2_sv("line-tables-only")) && !ux2_sv_eq(s, ux2_sv("full"))) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "`debug_info` in `[profile]` must be `\"none\"`, `\"line-tables-only\"`, or `\"full\"`", "profile", pname)
            return false
        }
        m.profiles[prof_idx].debug_info = s
        return true
    }
    if ux2_sv_eq(key, ux2_sv("overflow_checks")) {
        let mut b: bool = true
        if !parse_toml_bool(val, mut_view(b)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "`overflow_checks` in `[profile]` must be a boolean", "profile", pname)
            return false
        }
        m.profiles[prof_idx].overflow_checks = b
        return true
    }
    if ux2_sv_eq(key, ux2_sv("incremental")) {
        let mut b: bool = true
        if !parse_toml_bool(val, mut_view(b)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "`incremental` in `[profile]` must be a boolean", "profile", pname)
            return false
        }
        m.profiles[prof_idx].incremental = b
        return true
    }
    if ux2_sv_eq(key, ux2_sv("deterministic")) {
        let mut b: bool = true
        if !parse_toml_bool(val, mut_view(b)) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "`deterministic` in `[profile]` must be a boolean", "profile", pname)
            return false
        }
        m.profiles[prof_idx].deterministic = b
        return true
    }
    if ux2_sv_eq(key, ux2_sv("codegen_units")) {
        let mut n: u32 = 1u32
        if !parse_toml_u32(val, mut_view(n)) || n == 0u32 || n > 256u32 {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "`codegen_units` in `[profile]` must be in 1..=256", "profile", pname)
            return false
        }
        m.profiles[prof_idx].codegen_units = n
        return true
    }
    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_INVALID_PROFILE, "unknown key in `[profile]` table", "profile", pname)
    false
}

pub fn manifest_find_feature(m: view<DeclarativeManifest>, feat_name: StrView, out_idx: mut_view<usize>) -> bool {
    let mut i: usize = 0usize
    while i < m.feature_count {
        if ux2_sv_eq(m.features[i].name, feat_name) {
            *out_idx = i
            return true
        }
        i = i + 1usize
    }
    false
}

pub fn manifest_find_profile(m: view<DeclarativeManifest>, prof_name: StrView, out_prof: mut_view<ProfileConfig>) -> bool {
    let mut i: usize = 0usize
    while i < m.profile_count {
        if ux2_sv_eq(m.profiles[i].name, prof_name) {
            *out_prof = m.profiles[i]
            return true
        }
        i = i + 1usize
    }
    false
}

fn check_bracket_balance(s: StrView) -> i32 {
    let mut depth: i32 = 0i32
    let mut in_double: bool = false
    let mut in_single: bool = false
    let mut i: usize = 0usize
    while i < s.len {
        let b = bld_sv_byte(s, i)
        if b == 92u8 && in_double && (i + 1usize) < s.len {
            i = i + 2usize
            continue
        }
        if b == 34u8 && !in_single {
            in_double = !in_double
        } else if b == 39u8 && !in_double {
            in_single = !in_single
        } else if !in_double && !in_single {
            if b == 91u8 || b == 123u8 {
                depth = depth + 1i32
            } else if b == 93u8 || b == 125u8 {
                depth = depth - 1i32
            }
        }
        i = i + 1usize
    }
    depth
}

pub fn parse_axiom_toml(
    text: StrView,
    out: mut_view<DeclarativeManifest>,
    sink: mut_view<DiagSink>
) -> bool {
    *out = declarative_manifest_empty()
    // Reject UTF-8 BOM (`AXS-BLD-011`)
    if text.len >= 3usize && bld_sv_byte(text, 0usize) == 0xEFu8 &&
        bld_sv_byte(text, 1usize) == 0xBBu8 && bld_sv_byte(text, 2usize) == 0xBFu8 {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`axiom.toml` must be UTF-8 encoded without BOM", "kind", ux2_sv("syntax"))
        return false
    }

    let mut cur_sec: u8 = 0u8
    // 1=package, 2=workspace, 3=lib, 4=bin, 5=build_tool, 6=features, 7=deps, 8=profile
    let mut active_dep_scope: u8 = DEP_SCOPE_NORMAL
    let mut active_has_cfg: bool = false
    let mut active_cfg_expr = ux2_sv_empty()
    let mut active_prof_idx: usize = 0usize

    let mut seen_keys: [32]StrView = [ux2_sv_empty(); 32]
    let mut seen_key_count: usize = 0usize

    let mut pos: usize = 0usize
    while pos < text.len {
        let stmt_start = pos
        let mut stmt_end = pos
        let mut bracket_depth: i32 = 0i32
        while pos <= text.len {
            let is_end = pos == text.len
            let is_nl = if is_end { true } else { bld_sv_byte(text, pos) == 10u8 }
            if is_nl {
                stmt_end = pos
                let raw_chunk = bld_sv_slice(text, stmt_start, stmt_end)
                let mut unclosed_q: bool = false
                let cleaned = bld_strip_toml_comment(raw_chunk, mut_view(unclosed_q))
                if unclosed_q {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unterminated string literal in `axiom.toml`", "kind", ux2_sv("syntax"))
                    return false
                }
                if cleaned.len == 0usize {
                    pos = pos + 1usize
                    break
                }
                let is_header = bld_sv_byte(cleaned, 0usize) == 91u8
                if !is_header {
                    bracket_depth = check_bracket_balance(cleaned)
                    if bracket_depth > 0i32 && !is_end {
                        pos = pos + 1usize
                        continue
                    }
                }
                pos = pos + 1usize
                break
            }
            pos = pos + 1usize
        }

        let raw_stmt = bld_sv_slice(text, stmt_start, stmt_end)
        let mut unclosed_quote: bool = false
        let line = bld_strip_toml_comment(raw_stmt, mut_view(unclosed_quote))
        if unclosed_quote {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unterminated string literal in `axiom.toml`", "kind", ux2_sv("syntax"))
            return false
        }
        if line.len == 0usize {
            continue
        }

        if bld_sv_byte(line, 0usize) == 91u8 {
            seen_key_count = 0usize
            if line.len >= 4usize && bld_sv_byte(line, 1usize) == 91u8 {
                if bld_sv_byte(line, line.len - 1usize) != 93u8 || bld_sv_byte(line, line.len - 2usize) != 93u8 {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unclosed array-of-tables header `[[...]]` in `axiom.toml`", "kind", ux2_sv("syntax"))
                    return false
                }
                let arr_hdr = bld_sv_trim(bld_sv_slice(line, 2usize, line.len - 2usize))
                if ux2_sv_eq(arr_hdr, ux2_sv("bin")) {
                    if out.bin_count >= 8usize {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "too many `[[bin]]` targets in `axiom.toml`", "kind", ux2_sv("schema"))
                        return false
                    }
                    out.bin_targets[out.bin_count] = BinTargetDecl {
                        name: ux2_sv_empty(),
                        path: ux2_sv("src/main.ax"),
                    }
                    out.bin_count = out.bin_count + 1usize
                    cur_sec = 4u8
                } else if ux2_sv_eq(arr_hdr, ux2_sv("build_tool")) {
                    if out.build_tool_count >= 4usize {
                        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "too many `[[build_tool]]` targets in `axiom.toml`", "kind", ux2_sv("schema"))
                        return false
                    }
                    let e = ux2_sv_empty()
                    out.build_tools[out.build_tool_count] = BuildToolTargetDecl {
                        name: e,
                        path: e,
                        inputs: [e; 4],
                        input_count: 0usize,
                        outputs: [e; 4],
                        output_count: 0usize,
                    }
                    out.build_tool_count = out.build_tool_count + 1usize
                    cur_sec = 5u8
                } else {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown array-of-tables section in `axiom.toml`", "kind", ux2_sv("schema"))
                    return false
                }
                continue
            }

            if bld_sv_byte(line, line.len - 1usize) != 93u8 {
                report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unclosed table header `[...]` in `axiom.toml`", "kind", ux2_sv("syntax"))
                return false
            }
            let hdr = bld_sv_trim(bld_sv_slice(line, 1usize, line.len - 1usize))
            if ux2_sv_eq(hdr, ux2_sv("package")) {
                if out.has_package {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "duplicate `[package]` table in `axiom.toml`", "kind", ux2_sv("schema"))
                    return false
                }
                out.has_package = true
                out.package.present = true
                cur_sec = 1u8
            } else if ux2_sv_eq(hdr, ux2_sv("workspace")) {
                if out.has_workspace {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "duplicate `[workspace]` table in `axiom.toml`", "kind", ux2_sv("schema"))
                    return false
                }
                out.has_workspace = true
                out.workspace.present = true
                cur_sec = 2u8
            } else if ux2_sv_eq(hdr, ux2_sv("lib")) {
                if out.lib_target.present {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "at most one `[lib]` target may be declared in `axiom.toml`", "kind", ux2_sv("schema"))
                    return false
                }
                out.lib_target.present = true
                cur_sec = 3u8
            } else if ux2_sv_eq(hdr, ux2_sv("features")) {
                cur_sec = 6u8
            } else if ux2_sv_eq(hdr, ux2_sv("dependencies")) {
                cur_sec = 7u8
                active_dep_scope = DEP_SCOPE_NORMAL
                active_has_cfg = false
                active_cfg_expr = ux2_sv_empty()
            } else if ux2_sv_eq(hdr, ux2_sv("dev-dependencies")) {
                cur_sec = 7u8
                active_dep_scope = DEP_SCOPE_DEV
                active_has_cfg = false
                active_cfg_expr = ux2_sv_empty()
            } else if ux2_sv_eq(hdr, ux2_sv("build-dependencies")) {
                cur_sec = 7u8
                active_dep_scope = DEP_SCOPE_BUILD
                active_has_cfg = false
                active_cfg_expr = ux2_sv_empty()
            } else if ux2_sv_eq(hdr, ux2_sv("comptime-dependencies")) {
                cur_sec = 7u8
                active_dep_scope = DEP_SCOPE_COMPTIME
                active_has_cfg = false
                active_cfg_expr = ux2_sv_empty()
            } else if ux2_sv_eq(hdr, ux2_sv("system-dependencies")) {
                cur_sec = 7u8
                active_dep_scope = DEP_SCOPE_SYSTEM
                active_has_cfg = false
                active_cfg_expr = ux2_sv_empty()
            } else if bld_sv_starts_with(hdr, ux2_sv("profile.")) {
                let pname = bld_sv_trim(bld_sv_slice(hdr, 8usize, hdr.len))
                if !find_or_create_profile(mut_view(*out), pname, mut_view(active_prof_idx), mut_view(*sink)) {
                    return false
                }
                cur_sec = 8u8
            } else if bld_sv_starts_with(hdr, ux2_sv("target.")) {
                let rest = bld_sv_trim(bld_sv_slice(hdr, 7usize, hdr.len))
                let q0 = bld_sv_byte(rest, 0usize)
                if (rest.len) < 6usize || (q0 != 39u8 && q0 != 34u8) {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "invalid `[target.'cfg(...)'.dependencies]` header syntax", "kind", ux2_sv("schema"))
                    return false
                }
                let mut close_q: usize = rest.len
                let mut qi: usize = 1usize
                while qi < rest.len {
                    if bld_sv_byte(rest, qi) == q0 {
                        close_q = qi
                        break
                    }
                    qi = qi + 1usize
                }
                if close_q >= rest.len || (close_q + 2usize) >= rest.len || bld_sv_byte(rest, close_q + 1usize) != 46u8 {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "malformed `[target.'cfg(...)'.dependencies]` header", "kind", ux2_sv("schema"))
                    return false
                }
                let cfg_str = bld_sv_slice(rest, 1usize, close_q)
                let tail_scope = bld_sv_trim(bld_sv_slice(rest, close_q + 2usize, rest.len))
                let dummy_ctx = cfg_context_default_linux_x64()
                let mut dummy_match: bool = false
                if !cfg_validate_and_eval(cfg_str, view(dummy_ctx), mut_view(dummy_match), mut_view(*sink)) {
                    return false
                }
                if ux2_sv_eq(tail_scope, ux2_sv("dependencies")) {
                    active_dep_scope = DEP_SCOPE_NORMAL
                } else if ux2_sv_eq(tail_scope, ux2_sv("dev-dependencies")) {
                    active_dep_scope = DEP_SCOPE_DEV
                } else if ux2_sv_eq(tail_scope, ux2_sv("build-dependencies")) {
                    active_dep_scope = DEP_SCOPE_BUILD
                } else if ux2_sv_eq(tail_scope, ux2_sv("comptime-dependencies")) {
                    active_dep_scope = DEP_SCOPE_COMPTIME
                } else if ux2_sv_eq(tail_scope, ux2_sv("system-dependencies")) {
                    active_dep_scope = DEP_SCOPE_SYSTEM
                } else {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown target-conditional dependency scope in `axiom.toml`", "kind", ux2_sv("schema"))
                    return false
                }
                cur_sec = 7u8
                active_has_cfg = true
                active_cfg_expr = cfg_str
            } else {
                report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "unknown top-level table in `axiom.toml`", "kind", ux2_sv("schema"))
                return false
            }
            continue
        }

        if cur_sec == 0u8 {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "top-level key-value outside any `[table]` in `axiom.toml`", "kind", ux2_sv("schema"))
            return false
        }

        // Find top-level `=` in `line`
        let mut eq_pos: usize = line.len
        let mut ki: usize = 0usize
        while ki < line.len {
            if bld_sv_byte(line, ki) == 61u8 {
                eq_pos = ki
                break
            }
            ki = ki + 1usize
        }
        if eq_pos == line.len {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "expected `key = value` assignment in `axiom.toml`", "kind", ux2_sv("syntax"))
            return false
        }
        let key = bld_sv_trim(bld_sv_slice(line, 0usize, eq_pos))
        let val = bld_sv_trim(bld_sv_slice(line, eq_pos + 1usize, line.len))
        if key.len == 0usize || val.len == 0usize {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "empty key or value in `axiom.toml`", "kind", ux2_sv("syntax"))
            return false
        }

        // Prohibition of arbitrary imperative build scripts (`AXS-BLD-012`)
        if is_forbidden_script_key(key) {
            report_manifest_diag_2(
                mut_view(*sink),
                AX_DRIVER_BAD_MANIFEST,
                "imperative build script directive is forbidden in declarative `axiom.toml`",
                "kind",
                ux2_sv("forbidden_script"),
                "key",
                key
            )
            return false
        }

        // Check duplicate key in current table (`AXS-BLD-011 §4`)
        let mut si: usize = 0usize
        while si < seen_key_count {
            if ux2_sv_eq(seen_keys[si], key) {
                report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "duplicate key in `axiom.toml` table", "kind", ux2_sv("syntax"))
                return false
            }
            si = si + 1usize
        }
        if seen_key_count < 32usize {
            seen_keys[seen_key_count] = key
            seen_key_count = seen_key_count + 1usize
        }

        let mut kv_ok: bool = false
        if cur_sec == 1u8 {
            kv_ok = parse_package_kv(mut_view(*out), key, val, mut_view(*sink))
        } else if cur_sec == 2u8 {
            kv_ok = parse_workspace_kv(mut_view(*out), key, val, mut_view(*sink))
        } else if cur_sec == 3u8 {
            kv_ok = parse_lib_kv(mut_view(*out), key, val, mut_view(*sink))
        } else if cur_sec == 4u8 {
            kv_ok = parse_bin_kv(mut_view(*out), key, val, mut_view(*sink))
        } else if cur_sec == 5u8 {
            kv_ok = parse_build_tool_kv(mut_view(*out), key, val, mut_view(*sink))
        } else if cur_sec == 6u8 {
            kv_ok = parse_feature_kv(mut_view(*out), key, val, mut_view(*sink))
        } else if cur_sec == 7u8 {
            kv_ok = parse_dep_kv(mut_view(*out), active_dep_scope, active_has_cfg, active_cfg_expr, key, val, mut_view(*sink))
        } else if cur_sec == 8u8 {
            kv_ok = parse_profile_kv(mut_view(*out), active_prof_idx, key, val, mut_view(*sink))
        }
        if !kv_ok {
            return false
        }
    }

    if !out.has_package && !out.has_workspace {
        report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`axiom.toml` must declare `[package]`, `[workspace]`, or both", "kind", ux2_sv("schema"))
        return false
    }

    if out.has_package {
        if out.package.name.len == 0usize || !validate_package_name(out.package.name, out.package.bootstrap_internal) {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "missing or invalid `[package].name` in `axiom.toml`", "kind", ux2_sv("schema"))
            return false
        }
        if !out.package.has_version {
            report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "missing required `[package].version` in `axiom.toml`", "kind", ux2_sv("semver"))
            return false
        }
        if out.lib_target.present && out.lib_target.name.len == 0usize {
            out.lib_target.name = out.package.name
        }
        let mut bi: usize = 0usize
        while bi < out.bin_count {
            if out.bin_targets[bi].name.len == 0usize {
                if out.bin_count == 1usize {
                    out.bin_targets[bi].name = out.package.name
                } else {
                    report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "multiple `[[bin]]` targets require explicit `name` fields", "kind", ux2_sv("schema"))
                    return false
                }
            }
            bi = bi + 1usize
        }
        let mut bti: usize = 0usize
        while bti < out.build_tool_count {
            if out.build_tools[bti].name.len == 0usize || out.build_tools[bti].path.len == 0usize ||
                out.build_tools[bti].input_count == 0usize || out.build_tools[bti].output_count == 0usize {
                report_manifest_diag_1(mut_view(*sink), AX_DRIVER_BAD_MANIFEST, "`[[build_tool]]` must declare `name`, `path`, `inputs`, and `outputs`", "kind", ux2_sv("schema"))
                return false
            }
            bti = bti + 1usize
        }
        // Generate implicit features for `optional = true` dependencies (`AXS-BLD-014 §1`)
        let mut di: usize = 0usize
        while di < out.dependency_count {
            if out.dependencies[di].optional {
                let dname = out.dependencies[di].name
                let mut existing_idx: usize = 0usize
                if !manifest_find_feature(view(*out), dname, mut_view(existing_idx)) && (out.feature_count) < 16usize {
                    let mut imp_feat = feature_decl_empty()
                    imp_feat.name = dname
                    imp_feat.is_implicit_optional_dep = true
                    out.features[out.feature_count] = imp_feat
                    out.feature_count = out.feature_count + 1usize
                }
            }
            di = di + 1usize
        }
    }

    out.valid = true
    true
}
