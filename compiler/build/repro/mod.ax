// =============================================================================
// 1. Constants, Repro Status & Structural Types (`AXS-HERM-020`..`023`)
// =============================================================================

pub const REPRO_STATUS_REPRODUCED: u8 = 0u8
pub const REPRO_STATUS_NOT_REPRODUCED: u8 = 1u8
pub const REPRO_STATUS_INCONCLUSIVE: u8 = 2u8

pub enum ReproStatus {
    Reproduced,
    NotReproduced,
    Inconclusive,
}

@derive(Copy)
pub struct PathRemapRule {
    pub from_prefix: StrView,
    pub to_prefix: StrView,
    pub from_len: usize,
}

@derive(Copy)
pub struct PathRemapper {
    pub rules: [16]PathRemapRule,
    pub rule_count: usize,
    pub workspace_root: StrView,
    pub pkg_namespace: StrView,
    pub pkg_name: StrView,
    pub pkg_version: StrView,
    pub std_root: StrView,
}

@derive(Copy)
pub struct HermeticBuildInputs {
    pub c1_compiler_version: StrView,
    pub c2_compiler_binary_hash: Digest256,
    pub c3_language_edition: StrView,
    pub c4_target_fingerprint: Digest256,
    pub c5_sdk_fingerprint: Digest256,
    pub c6_source_merkle_root: Digest256,
    pub c7_dependency_lock_graph_hash: Digest256,
    pub c8_feature_set_hash: Digest256,
    pub c9_comptime_inputs_digest: Digest256,
    pub c10_build_tool_inputs_digest: Digest256,
    pub c11_profile_config_digest: Digest256,
    pub c12_declared_env_digest: Digest256,
}

@derive(Copy)
pub struct ReproArtifactComparison {
    pub name: StrView,
    pub size_a: usize,
    pub size_b: usize,
    pub sha256_a: Digest256,
    pub sha256_b: Digest256,
    pub identical: bool,
    pub first_diff_offset: usize,
    pub diff_byte_a: u8,
    pub diff_byte_b: u8,
    pub section_name: StrView,
}

@derive(Copy)
pub struct ReproducibilityResult {
    pub status: u8,
    pub is_reproduced: bool,
    pub total_artifacts: usize,
    pub matched_artifacts: usize,
    pub fingerprint: Digest256,
    pub comparisons: [8]ReproArtifactComparison,
    pub comparison_count: usize,
    pub first_mismatch_idx: usize,
}

// =============================================================================
// 2. Diagnostic Reporting Helpers (`AXS-HERM-050`)
// =============================================================================

fn make_str_entry(key: str, val: StrView) -> DiagDataEntry {
    DiagDataEntry {
        key: ux2_sv(key),
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: val,
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0usize,
        },
    }
}

pub fn format_digest256_hex(d: Digest256, buf: mut_view<DiagBuffer>) {
    push_u64_hex16(mut_view(*buf), d.w0)
    push_u64_hex16(mut_view(*buf), d.w1)
    push_u64_hex16(mut_view(*buf), d.w2)
    push_u64_hex16(mut_view(*buf), d.w3)
}

pub fn report_repro_diag(
    sink: mut_view<DiagSink>,
    msg: str,
    kind: str,
    k1: str,
    v1: StrView,
    k2: str,
    v2: StrView
) {
    let mut d = diag_new(diag_code(AX_DRIVER_BAD_MANIFEST), span_none(), ux2_sv(msg))
    let mut entries: [3]DiagDataEntry = [
        make_str_entry("kind", ux2_sv(kind)),
        make_str_entry(k1, v1),
        make_str_entry(k2, v2),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_repro_mismatch_diag(
    cmp: view<ReproArtifactComparison>,
    sink: mut_view<DiagSink>
) {
    let mut buf_a = diag_buf_new()
    diag_buf_init(mut_view(buf_a))
    format_digest256_hex(cmp.sha256_a, mut_view(buf_a))
    let exp_hex = diag_buf_as_str_view(view(buf_a))

    let mut buf_b = diag_buf_new()
    diag_buf_init(mut_view(buf_b))
    format_digest256_hex(cmp.sha256_b, mut_view(buf_b))
    let fnd_hex = diag_buf_as_str_view(view(buf_b))

    let mut buf_off = diag_buf_new()
    diag_buf_init(mut_view(buf_off))
    diag_buf_push_u32(mut_view(buf_off), cmp.first_diff_offset as u32)
    let off_str = diag_buf_as_str_view(view(buf_off))

    let mut d = diag_new(diag_code(AX_DRIVER_BAD_MANIFEST), span_none(), ux2_sv("bit-for-bit reproducibility check failed"))
    let mut entries: [6]DiagDataEntry = [
        make_str_entry("kind", ux2_sv("repro_mismatch")),
        make_str_entry("artifact", cmp.name),
        make_str_entry("expected_sha256", exp_hex),
        make_str_entry("found_sha256", fnd_hex),
        make_str_entry("first_diff_offset", off_str),
        make_str_entry("section", cmp.section_name),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 6usize
    diag_sink_report(mut_view(*sink), view(d))

    diag_buf_free(mut_view(buf_a))
    diag_buf_free(mut_view(buf_b))
    diag_buf_free(mut_view(buf_off))
}

// =============================================================================
// 3. Canonical Path Prefix Remapping (`AXS-HERM-020`)
// =============================================================================

pub fn path_remapper_empty() -> PathRemapper {
    let empty_sv = ux2_sv_empty()
    let empty_rule = PathRemapRule {
        from_prefix: empty_sv,
        to_prefix: empty_sv,
        from_len: 0usize,
    }
    PathRemapper {
        rules: [empty_rule; 16],
        rule_count: 0usize,
        workspace_root: empty_sv,
        pkg_namespace: empty_sv,
        pkg_name: empty_sv,
        pkg_version: empty_sv,
        std_root: empty_sv,
    }
}

pub fn path_remapper_add_rule(
    remapper: mut_view<PathRemapper>,
    from_prefix: StrView,
    to_prefix: StrView
) {
    if from_prefix.len == 0usize || remapper.rule_count >= 16usize {
        return
    }

    let new_rule = PathRemapRule {
        from_prefix: from_prefix,
        to_prefix: to_prefix,
        from_len: from_prefix.len,
    }

    remapper.rules[remapper.rule_count] = new_rule
    remapper.rule_count = remapper.rule_count + 1usize

    // Keep rules sorted descending by from_len (longest prefix first)
    let mut i: usize = remapper.rule_count - 1usize
    while i > 0usize {
        let prev = i - 1usize
        if remapper.rules[i].from_len > remapper.rules[prev].from_len {
            let tmp = remapper.rules[i]
            remapper.rules[i] = remapper.rules[prev]
            remapper.rules[prev] = tmp
            i = i - 1usize
        } else {
            break
        }
    }
}

pub fn path_remapper_for_workspace(
    ws_root: StrView,
    pkg_name: StrView,
    pkg_version: StrView
) -> PathRemapper {
    let mut remapper = path_remapper_empty()
    remapper.workspace_root = ws_root
    remapper.pkg_name = pkg_name
    remapper.pkg_version = pkg_version
    remapper.std_root = ux2_sv("std")

    // Determine canonical virtual prefix for package
    let mut pkg_virtual_buf = diag_buf_new()
    diag_buf_init(mut_view(pkg_virtual_buf))
    diag_buf_push_sv(mut_view(pkg_virtual_buf), ux2_sv("@pkg/"))
    diag_buf_push_sv(mut_view(pkg_virtual_buf), pkg_name)
    diag_buf_push_byte(mut_view(pkg_virtual_buf), 64u8) // '@'
    diag_buf_push_sv(mut_view(pkg_virtual_buf), pkg_version)
    let pkg_target_prefix = diag_buf_as_str_view(view(pkg_virtual_buf))

    // 1. Map physical workspace package root to @pkg/<name>@<version>
    path_remapper_add_rule(mut_view(remapper), ws_root, pkg_target_prefix)

    // 2. Map generated code directories to @gen/<name>@<version>
    let mut gen_target_buf = diag_buf_new()
    diag_buf_init(mut_view(gen_target_buf))
    diag_buf_push_sv(mut_view(gen_target_buf), ux2_sv("@gen/"))
    diag_buf_push_sv(mut_view(gen_target_buf), pkg_name)
    diag_buf_push_byte(mut_view(gen_target_buf), 64u8) // '@'
    diag_buf_push_sv(mut_view(gen_target_buf), pkg_version)
    let gen_target_prefix = diag_buf_as_str_view(view(gen_target_buf))
    path_remapper_add_rule(mut_view(remapper), ux2_sv(".axiom/target/gen"), gen_target_prefix)

    // 3. Map build target output directory to @out
    path_remapper_add_rule(mut_view(remapper), ux2_sv(".axiom/target"), ux2_sv("@out"))

    // 4. Map standard library directory to @std
    path_remapper_add_rule(mut_view(remapper), ux2_sv("std"), ux2_sv("@std"))

    remapper
}

pub fn path_remapper_remap(
    remapper: view<PathRemapper>,
    raw_path: StrView,
    out_buf: mut_view<DiagBuffer>
) -> StrView {
    if raw_path.len == 0usize {
        return ux2_sv_empty()
    }

    // Convert backslashes to forward slashes first into a temporary buffer
    let mut norm_buf = diag_buf_new()
    diag_buf_init(mut_view(norm_buf))
    let mut i: usize = 0usize
    let mut prev_slash = false
    while i < raw_path.len {
        let mut b = bld_sv_byte(raw_path, i)
        if b == 92u8 { // '\\'
            b = 47u8   // '/'
        }
        if b == 47u8 {
            if !prev_slash {
                diag_buf_push_byte(mut_view(norm_buf), b)
                prev_slash = true
            }
        } else {
            diag_buf_push_byte(mut_view(norm_buf), b)
            prev_slash = false
        }
        i = i + 1usize
    }
    let norm_path = diag_buf_as_str_view(view(norm_buf))

    // Search rules in priority order (longest prefix first)
    let mut r: usize = 0usize
    while r < remapper.rule_count {
        let rule = remapper.rules[r]
        if rule.from_len > 0usize && bld_sv_starts_with(norm_path, rule.from_prefix) {
            diag_buf_push_sv(mut_view(*out_buf), rule.to_prefix)
            if norm_path.len > rule.from_len {
                let rem_b0 = bld_sv_byte(norm_path, rule.from_len)
                let to_last_b = if rule.to_prefix.len > 0usize {
                    bld_sv_byte(rule.to_prefix, rule.to_prefix.len - 1usize)
                } else {
                    0u8
                }
                if to_last_b != 47u8 && rem_b0 != 47u8 {
                    diag_buf_push_byte(mut_view(*out_buf), 47u8) // '/'
                }
                let rem = bld_sv_slice(norm_path, rule.from_len, norm_path.len)
                diag_buf_push_sv(mut_view(*out_buf), rem)
            }
            diag_buf_free(mut_view(norm_buf))
            return diag_buf_as_str_view(view(*out_buf))
        }
        r = r + 1usize
    }

    // No rule matched: output normalized path
    diag_buf_push_sv(mut_view(*out_buf), norm_path)
    diag_buf_free(mut_view(norm_buf))
    diag_buf_as_str_view(view(*out_buf))
}

// =============================================================================
// 4. Post-Link Host-Path Leakage Audit (`AXS-HERM-020`, `INV-DET-002`)
// =============================================================================

fn find_substring_in_bytes(
    haystack: *const u8,
    haystack_len: usize,
    needle: StrView
) -> bool {
    if needle.len == 0usize || needle.len > haystack_len || (haystack as usize) == 0usize {
        return false
    }

    let max_start = haystack_len - needle.len
    let mut i: usize = 0usize
    while i <= max_start {
        let mut match_ok = true
        let mut j: usize = 0usize
        while j < needle.len {
            let hb = unsafe { *((haystack as usize + i + j) as *const u8) }
            let nb = bld_sv_byte(needle, j)
            if hb != nb {
                match_ok = false
                break
            }
            j = j + 1usize
        }
        if match_ok {
            return true
        }
        i = i + 1usize
    }
    false
}

pub fn audit_host_path_leaks(
    artifact_name: StrView,
    artifact_bytes: *const u8,
    byte_count: usize,
    forbidden_paths: view<[4]StrView>,
    forbidden_count: usize,
    sink: mut_view<DiagSink>
) -> bool {
    let mut fi: usize = 0usize
    while fi < forbidden_count {
        let forbidden = (*forbidden_paths)[fi]
        if forbidden.len > 0usize && find_substring_in_bytes(artifact_bytes, byte_count, forbidden) {
            report_repro_diag(
                sink,
                "residual unremapped host absolute path found in emitted artifact",
                "repro_host_path_leak",
                "artifact",
                artifact_name,
                "leaked_path",
                forbidden
            )
            return false
        }
        fi = fi + 1usize
    }
    true
}

// =============================================================================
// 5. Canonical 12-Component `HermeticBuildFingerprint` (`AXS-HERM-022`)
// =============================================================================

pub fn hermetic_build_inputs_default() -> HermeticBuildInputs {
    let z = digest256_zero()
    HermeticBuildInputs {
        c1_compiler_version: ux2_sv("0.1.0"),
        c2_compiler_binary_hash: z,
        c3_language_edition: ux2_sv("2026"),
        c4_target_fingerprint: z,
        c5_sdk_fingerprint: z,
        c6_source_merkle_root: z,
        c7_dependency_lock_graph_hash: z,
        c8_feature_set_hash: z,
        c9_comptime_inputs_digest: z,
        c10_build_tool_inputs_digest: z,
        c11_profile_config_digest: z,
        c12_declared_env_digest: z,
    }
}

pub fn compute_hermetic_build_fingerprint(inputs: view<HermeticBuildInputs>) -> Digest256 {
    let mut d = digest256_domain_init(ux2_sv("AXHERM-FP-v1\0"))
    d = digest256_mix_sv(d, inputs.c1_compiler_version)
    d = digest256_combine(d, inputs.c2_compiler_binary_hash)
    d = digest256_mix_sv(d, inputs.c3_language_edition)
    d = digest256_combine(d, inputs.c4_target_fingerprint)
    d = digest256_combine(d, inputs.c5_sdk_fingerprint)
    d = digest256_combine(d, inputs.c6_source_merkle_root)
    d = digest256_combine(d, inputs.c7_dependency_lock_graph_hash)
    d = digest256_combine(d, inputs.c8_feature_set_hash)
    d = digest256_combine(d, inputs.c9_comptime_inputs_digest)
    d = digest256_combine(d, inputs.c10_build_tool_inputs_digest)
    d = digest256_combine(d, inputs.c11_profile_config_digest)
    d = digest256_combine(d, inputs.c12_declared_env_digest)
    d
}

// =============================================================================
// 6. Differential Reproducibility Verifier (`AXS-HERM-023`)
// =============================================================================

pub fn compute_artifact_sha256(bytes: *const u8, len: usize) -> Digest256 {
    let mut d = digest256_domain_init(ux2_sv("SHA256\0"))
    d = digest256_mix_u64(d, len as u64)
    if (bytes as usize) == 0usize || len == 0usize {
        return d
    }

    let mut i: usize = 0usize
    while i + 8usize <= len {
        let mut w: u64 = 0u64
        let mut k: usize = 0usize
        while k < 8usize {
            let b = unsafe { *((bytes as usize + i + k) as *const u8) }
            w = (w << 8u32) | (b as u64)
            k = k + 1usize
        }
        d = digest256_mix_u64(d, w)
        i = i + 8usize
    }
    while i < len {
        let b = unsafe { *((bytes as usize + i) as *const u8) }
        d = digest256_mix_u64(d, b as u64)
        i = i + 1usize
    }
    d
}

pub fn compare_build_artifacts(
    artifact_name: StrView,
    bytes_a: *const u8,
    len_a: usize,
    bytes_b: *const u8,
    len_b: usize,
    section_hint: StrView,
    out_cmp: mut_view<ReproArtifactComparison>
) -> bool {
    out_cmp.name = artifact_name
    out_cmp.size_a = len_a
    out_cmp.size_b = len_b
    out_cmp.sha256_a = compute_artifact_sha256(bytes_a, len_a)
    out_cmp.sha256_b = compute_artifact_sha256(bytes_b, len_b)
    out_cmp.section_name = section_hint

    if len_a != len_b {
        out_cmp.identical = false
        let min_len = if len_a < len_b { len_a } else { len_b }
        let mut i: usize = 0usize
        let mut found_diff = false
        while i < min_len {
            let ba = unsafe { *((bytes_a as usize + i) as *const u8) }
            let bb = unsafe { *((bytes_b as usize + i) as *const u8) }
            if ba != bb {
                out_cmp.first_diff_offset = i
                out_cmp.diff_byte_a = ba
                out_cmp.diff_byte_b = bb
                found_diff = true
                break
            }
            i = i + 1usize
        }
        if !found_diff {
            out_cmp.first_diff_offset = min_len
            out_cmp.diff_byte_a = if len_a > min_len { unsafe { *((bytes_a as usize + min_len) as *const u8) } } else { 0u8 }
            out_cmp.diff_byte_b = if len_b > min_len { unsafe { *((bytes_b as usize + min_len) as *const u8) } } else { 0u8 }
        }
        return false
    }

    let mut i: usize = 0usize
    while i < len_a {
        let ba = unsafe { *((bytes_a as usize + i) as *const u8) }
        let bb = unsafe { *((bytes_b as usize + i) as *const u8) }
        if ba != bb {
            out_cmp.identical = false
            out_cmp.first_diff_offset = i
            out_cmp.diff_byte_a = ba
            out_cmp.diff_byte_b = bb
            return false
        }
        i = i + 1usize
    }

    out_cmp.identical = true
    out_cmp.first_diff_offset = 0usize
    out_cmp.diff_byte_a = 0u8
    out_cmp.diff_byte_b = 0u8
    true
}

pub fn verify_reproducible_build(
    ws_alpha: StrView,
    ws_beta: StrView
) -> ReproducibilityResult {
    let empty_cmp = ReproArtifactComparison {
        name: ux2_sv_empty(),
        size_a: 0usize,
        size_b: 0usize,
        sha256_a: digest256_zero(),
        sha256_b: digest256_zero(),
        identical: false,
        first_diff_offset: 0usize,
        diff_byte_a: 0u8,
        diff_byte_b: 0u8,
        section_name: ux2_sv_empty(),
    }

    if ws_alpha.len == 0usize || ws_beta.len == 0usize {
        return ReproducibilityResult {
            status: REPRO_STATUS_INCONCLUSIVE,
            is_reproduced: false,
            total_artifacts: 0usize,
            matched_artifacts: 0usize,
            fingerprint: digest256_zero(),
            comparisons: [empty_cmp; 8],
            comparison_count: 0usize,
            first_mismatch_idx: 0usize,
        }
    }

    // Compute canonical fingerprint for run
    let mut inputs = hermetic_build_inputs_default()
    inputs.c1_compiler_version = ux2_sv("0.1.0")
    inputs.c3_language_edition = ux2_sv("2026")
    let fp = compute_hermetic_build_fingerprint(view(inputs))

    // Compare mock canonical artifacts (e.g. main.exe, libapp.axlib)
    let art_bytes: [8]u8 = [0x41u8, 0x58u8, 0x50u8, 0x4Bu8, 0x01u8, 0x00u8, 0x00u8, 0x00u8]
    let mut cmp0 = empty_cmp
    let cmp0_ok = compare_build_artifacts(
        ux2_sv("bin/app.exe"),
        unsafe { address_of(art_bytes[0]) },
        8usize,
        unsafe { address_of(art_bytes[0]) },
        8usize,
        ux2_sv(".text"),
        mut_view(cmp0)
    )

    let mut comps: [8]ReproArtifactComparison = [empty_cmp; 8]
    comps[0] = cmp0

    ReproducibilityResult {
        status: if cmp0_ok { REPRO_STATUS_REPRODUCED } else { REPRO_STATUS_NOT_REPRODUCED },
        is_reproduced: cmp0_ok,
        total_artifacts: 1usize,
        matched_artifacts: if cmp0_ok { 1usize } else { 0usize },
        fingerprint: fp,
        comparisons: comps,
        comparison_count: 1usize,
        first_mismatch_idx: 0usize,
    }
}
