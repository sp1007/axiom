// Bit-for-Bit Reproducibility, Canonical Path Prefix Remapping (`--remap-path-prefix`),
// Post-Link Host-Path Leakage Audit & Double-Build Differential Verifier
// (`compiler/build/repro/mod.ax`, T863 / E20.4).
//
// Implements SPEC-113 §3 (`AXS-HERM-020`..`AXS-HERM-023`, `AXS-HERM-050`..`AXS-HERM-053`,
// `INV-HERM-001`, `REQ-PKG-022`, `REQ-PKG-024`).

module compiler.build.repro

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

