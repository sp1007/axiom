// =============================================================================
// 1. Environment Classes, Source Kinds & 256-Bit Domain-Separated Digests
// =============================================================================

pub const ENV_CLASS_TARGET: u8 = 0u8
pub const ENV_CLASS_HOST: u8 = 1u8

pub const SOURCE_WORKSPACE_LOCAL: u8 = 0u8
pub const SOURCE_PATH_RELATIVE: u8 = 1u8
pub const SOURCE_GIT_COMMIT: u8 = 2u8
pub const SOURCE_REGISTRY_DIGEST: u8 = 3u8
pub const SOURCE_VENDOR_TREE: u8 = 4u8

pub fn env_class_name(env_class: u8) -> StrView {
    if env_class == ENV_CLASS_HOST {
        return ux2_sv("host")
    }
    ux2_sv("target")
}

@derive(Copy)
pub struct Digest256 {
    pub w0: u64,
    pub w1: u64,
    pub w2: u64,
    pub w3: u64,
}

pub fn digest256_zero() -> Digest256 {
    Digest256 {
        w0: 0u64,
        w1: 0u64,
        w2: 0u64,
        w3: 0u64,
    }
}

pub fn digest256_eq(a: Digest256, b: Digest256) -> bool {
    a.w0 == b.w0 && a.w1 == b.w1 && a.w2 == b.w2 && a.w3 == b.w3
}

pub fn digest256_domain_init(domain_tag: StrView) -> Digest256 {
    let base = ax_hash_bytes(domain_tag.ptr, domain_tag.len)
    Digest256 {
        w0: ax_hash_combine(base, 0x243F6A8885A308D3u64),
        w1: ax_hash_combine(base, 0x13198A2E03707344u64),
        w2: ax_hash_combine(base, 0xA4093822299F31D0u64),
        w3: ax_hash_combine(base, 0x082EFA98EC4E6C89u64),
    }
}

pub fn digest256_mix_u64(d: Digest256, v: u64) -> Digest256 {
    let h = ax_hash_u64(v)
    Digest256 {
        w0: ax_hash_combine(d.w0, h ^ 0x9E3779B97F4A7C15u64),
        w1: ax_hash_combine(d.w1, h ^ 0xBF58476D1CE4E5B9u64),
        w2: ax_hash_combine(d.w2, h ^ 0x94D049BB133111EBu64),
        w3: ax_hash_combine(d.w3, h ^ 0xD6E8FEB86659FD93u64),
    }
}

pub fn digest256_mix_sv(d: Digest256, sv: StrView) -> Digest256 {
    let h = ax_hash_bytes(sv.ptr, sv.len)
    let d1 = digest256_mix_u64(d, sv.len as u64)
    digest256_mix_u64(d1, h)
}

pub fn digest256_combine(a: Digest256, b: Digest256) -> Digest256 {
    Digest256 {
        w0: ax_hash_combine(a.w0, b.w0),
        w1: ax_hash_combine(a.w1, b.w1),
        w2: ax_hash_combine(a.w2, b.w2),
        w3: ax_hash_combine(a.w3, b.w3),
    }
}

fn push_hex_nibble(buf: mut_view<DiagBuffer>, nib: u8) {
    let ch = if nib < 10u8 { 48u8 + nib } else { 87u8 + nib }
    diag_buf_push_byte(mut_view(*buf), ch)
}

pub fn push_u64_hex16(buf: mut_view<DiagBuffer>, v: u64) {
    let mut shift: u32 = 60u32
    let mut i: usize = 0usize
    while i < 16usize {
        let nib = ((v >> (shift as u64)) & 0xFu64) as u8
        push_hex_nibble(mut_view(*buf), nib)
        if shift >= 4u32 {
            shift = shift - 4u32
        }
        i = i + 1usize
    }
}

pub fn digest256_push_hex(d: view<Digest256>, buf: mut_view<DiagBuffer>) {
    push_u64_hex16(mut_view(*buf), d.w0)
    push_u64_hex16(mut_view(*buf), d.w1)
    push_u64_hex16(mut_view(*buf), d.w2)
    push_u64_hex16(mut_view(*buf), d.w3)
}

// =============================================================================
// 2. Canonical `PackageIdentity` & Path Independence (`AXS-BLD-002`, `REQ-PKG-005`)
// =============================================================================

@derive(Copy)
pub struct PackageIdentity {
    pub name: StrView,
    pub version: SemVer,
    pub source_kind: u8,
    pub logical_source_id: StrView,
    pub feature_set_hash: Digest256,
    pub target_env_class: u8,
    pub target_triple: StrView,
    pub abi_salt: Digest256,
    pub identity_digest: Digest256,
}

pub fn package_identity_empty() -> PackageIdentity {
    let e = ux2_sv_empty()
    let z = digest256_zero()
    PackageIdentity {
        name: e,
        version: semver_zero(),
        source_kind: SOURCE_WORKSPACE_LOCAL,
        logical_source_id: e,
        feature_set_hash: z,
        target_env_class: ENV_CLASS_TARGET,
        target_triple: e,
        abi_salt: z,
        identity_digest: z,
    }
}

pub fn sort_str_views_lex(items: mut_view<[16]StrView>, count: usize) {
    let mut i: usize = 0usize
    while i < count {
        let mut j: usize = i + 1usize
        while j < count {
            if bld_sv_cmp((*items)[i], (*items)[j]) > 0i32 {
                let tmp = (*items)[i]
                (*items)[i] = (*items)[j]
                (*items)[j] = tmp
            }
            j = j + 1usize
        }
        i = i + 1usize
    }
}

pub fn compute_feature_set_hash(features: view<[16]StrView>, count: usize) -> Digest256 {
    let mut sorted: [16]StrView = *features
    sort_str_views_lex(mut_view(sorted), count)
    let mut d = digest256_domain_init(ux2_sv("AXIOM_FEATURE_SET_V1"))
    d = digest256_mix_u64(d, count as u64)
    let mut i: usize = 0usize
    while i < count && i < 16usize {
        d = digest256_mix_sv(d, sorted[i])
        i = i + 1usize
    }
    d
}

// Strips any host absolute prefix (`C:/work/repo/` or `/home/ci/repo/`) so only
// the workspace-relative logical path participates in `PackageIdentity` (`AXS-BLD-002 §1`).
pub fn canonicalize_logical_source_path(
    host_workspace_root: StrView,
    raw_member_path: StrView
) -> StrView {
    let t = bld_sv_trim(raw_member_path)
    if t.len == 0usize || ux2_sv_eq(t, ux2_sv(".")) {
        return ux2_sv(".")
    }
    if host_workspace_root.len > 0usize && bld_sv_starts_with(t, host_workspace_root) {
        let mut cut = host_workspace_root.len
        while cut < t.len && (bld_sv_byte(t, cut) == 47u8 || bld_sv_byte(t, cut) == 92u8) {
            cut = cut + 1usize
        }
        let rel = bld_sv_slice(t, cut, t.len)
        if rel.len == 0usize {
            return ux2_sv(".")
        }
        return rel
    }
    t
}

pub fn compute_abi_salt(target_triple: StrView, profile: view<ProfileConfig>) -> Digest256 {
    let mut d = digest256_domain_init(ux2_sv("AXIOM_ABI_SALT_V1"))
    d = digest256_mix_sv(d, target_triple)
    d = digest256_mix_sv(d, profile.panic_strategy)
    d = digest256_mix_sv(d, profile.safety_profile)
    d
}

pub fn compute_package_identity(
    name: StrView,
    version: SemVer,
    source_kind: u8,
    host_workspace_root: StrView,
    member_rel_path: StrView,
    active_features: view<[16]StrView>,
    active_feature_count: usize,
    target_env_class: u8,
    target_triple: StrView,
    profile: view<ProfileConfig>
) -> PackageIdentity {
    let logical_src = canonicalize_logical_source_path(host_workspace_root, member_rel_path)
    let feat_hash = compute_feature_set_hash(active_features, active_feature_count)
    let salt = compute_abi_salt(target_triple, profile)

    let mut id_hash = digest256_domain_init(ux2_sv("AXIOM_PKG_ID_V1"))
    id_hash = digest256_mix_sv(id_hash, name)
    id_hash = digest256_mix_u64(id_hash, version.major as u64)
    id_hash = digest256_mix_u64(id_hash, version.minor as u64)
    id_hash = digest256_mix_u64(id_hash, version.patch as u64)
    id_hash = digest256_mix_sv(id_hash, version.prerelease)
    id_hash = digest256_mix_u64(id_hash, source_kind as u64)
    id_hash = digest256_mix_sv(id_hash, logical_src)
    id_hash = digest256_combine(id_hash, feat_hash)
    id_hash = digest256_mix_u64(id_hash, target_env_class as u64)
    id_hash = digest256_mix_sv(id_hash, target_triple)
    id_hash = digest256_combine(id_hash, salt)

    PackageIdentity {
        name: name,
        version: version,
        source_kind: source_kind,
        logical_source_id: logical_src,
        feature_set_hash: feat_hash,
        target_env_class: target_env_class,
        target_triple: target_triple,
        abi_salt: salt,
        identity_digest: id_hash,
    }
}

pub fn format_package_symbol_prefix(id: view<PackageIdentity>, buf: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*buf), ux2_sv("_AXP_"))
    diag_buf_push_sv(mut_view(*buf), id.name)
    diag_buf_push_sv(mut_view(*buf), ux2_sv("_v"))
    diag_buf_push_u32(mut_view(*buf), id.version.major)
    diag_buf_push_byte(mut_view(*buf), 95u8)
    diag_buf_push_u32(mut_view(*buf), id.version.minor)
    diag_buf_push_byte(mut_view(*buf), 95u8)
    diag_buf_push_u32(mut_view(*buf), id.version.patch)
    diag_buf_push_byte(mut_view(*buf), 95u8)
    push_u64_hex16(mut_view(*buf), id.identity_digest.w0)
}

// =============================================================================
// 3. Workspace Member Containment & Graph Data Structures (`AXS-BLD-001`..`006`, `013`)
// =============================================================================

// Validates that a `[workspace].members` or `default_members` path is a clean
// normalized relative path using `/` separators that resolves strictly inside
// the workspace root without escaping via `..`, drive letters, or leading `/` (`AXS-BLD-013 §2`).
pub fn validate_workspace_member_path(rel_path: StrView) -> bool {
    let t = bld_sv_trim(rel_path)
    if t.len == 0usize || t.len != rel_path.len {
        return false
    }
    let b0 = bld_sv_byte(t, 0usize)
    if b0 == 47u8 || b0 == 92u8 {
        return false
    }
    if t.len >= 2usize && bld_sv_byte(t, 1usize) == 58u8 {
        return false
    }
    if bld_sv_byte(t, t.len - 1usize) == 47u8 {
        return false
    }
    let mut seg_start: usize = 0usize
    let mut depth: i32 = 0i32
    let mut i: usize = 0usize
    while i <= t.len {
        let at_end = i == t.len
        let b = if at_end { 47u8 } else { bld_sv_byte(t, i) }
        if !at_end && b == 92u8 {
            return false
        }
        if at_end || b == 47u8 {
            let seg = bld_sv_slice(t, seg_start, i)
            if seg.len == 0usize {
                return false
            }
            if ux2_sv_eq(seg, ux2_sv(".")) {
                return false
            }
            if ux2_sv_eq(seg, ux2_sv("..")) {
                depth = depth - 1i32
                if depth < 0i32 {
                    return false
                }
            } else {
                depth = depth + 1i32
            }
            seg_start = i + 1usize
        }
        i = i + 1usize
    }
    depth >= 0i32
}

@derive(Copy)
pub struct WorkspaceMemberInput {
    pub rel_path: StrView,
    pub manifest_text: StrView,
    pub public_api_source_hash: u64,
    pub private_body_source_hash: u64,
    pub has_intra_pkg_module_scc: bool,
    pub module_scc_has_import_cycle: bool,
}

pub fn workspace_member_input_new(rel_path: StrView, manifest_text: StrView) -> WorkspaceMemberInput {
    WorkspaceMemberInput {
        rel_path: rel_path,
        manifest_text: manifest_text,
        public_api_source_hash: 0x1122334455667788u64,
        private_body_source_hash: 0x99AABBCCDDEEFF00u64,
        has_intra_pkg_module_scc: false,
        module_scc_has_import_cycle: false,
    }
}

