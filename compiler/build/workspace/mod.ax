    pub member_rel_path: StrView,
    pub manifest: DeclarativeManifest,
    pub active_features: [16]StrView,
    pub active_feature_count: usize,
    pub enabled_optional_deps: [16]StrView,
    pub enabled_optional_dep_count: usize,
    pub has_intra_pkg_module_scc: bool,
    pub topo_order_index: u32,
    pub semantic_fingerprint: Digest256,
}

@derive(Copy)
pub struct DependencyEdge {
