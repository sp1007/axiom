// =============================================================================
// 1. Diagnostic Codes & Build Event Kinds (`AXS-BLD-021`, `AXS-BLD-042`, `AXS-BLD-050`)
// =============================================================================

pub const AX_LINK_ARTIFACT_TARGET_MISMATCH: u32 = 220u32

pub const EVENT_WORKSPACE_RESOLVED: u8 = 0u8
pub const EVENT_ACTION_STARTED: u8 = 1u8
pub const EVENT_ACTION_CACHED: u8 = 2u8
pub const EVENT_ACTION_COMPLETED: u8 = 3u8
pub const EVENT_ARTIFACT_EMITTED: u8 = 4u8
pub const EVENT_BUILD_FINISHED: u8 = 5u8

pub fn build_event_kind_name(kind: u8) -> StrView {
    if kind == EVENT_WORKSPACE_RESOLVED {
        return ux2_sv("workspace_resolved")
    }
    if kind == EVENT_ACTION_STARTED {
        return ux2_sv("action_started")
    }
    if kind == EVENT_ACTION_CACHED {
        return ux2_sv("action_cached")
    }
    if kind == EVENT_ACTION_COMPLETED {
        return ux2_sv("action_completed")
    }
    if kind == EVENT_ARTIFACT_EMITTED {
        return ux2_sv("artifact_emitted")
    }
    ux2_sv("build_finished")
}

// =============================================================================
// 2. Target-Specific Artifact Extensions & Layout (`AXS-BLD-023`, `AXS-BLD-024`)
// =============================================================================

pub fn triple_is_windows(triple: StrView) -> bool {
    ux2_sv_contains(triple, ux2_sv("windows")) || ux2_sv_contains(triple, ux2_sv("msvc"))
}

pub fn triple_is_wasm(triple: StrView) -> bool {
    ux2_sv_contains(triple, ux2_sv("wasm"))
}

pub fn triple_is_macos(triple: StrView) -> bool {
    ux2_sv_contains(triple, ux2_sv("apple")) || ux2_sv_contains(triple, ux2_sv("darwin")) || ux2_sv_contains(triple, ux2_sv("macos"))
}

pub fn artifact_interface_ext() -> StrView {
    ux2_sv(".axmi")
}

pub fn artifact_obj_ext(triple: StrView) -> StrView {
    if triple_is_windows(triple) {
        return ux2_sv(".obj")
    }
    ux2_sv(".o")
}

pub fn artifact_archive_ext(triple: StrView) -> StrView {
    if triple_is_windows(triple) {
        return ux2_sv(".lib")
    }
    ux2_sv(".a")
}

pub fn artifact_shared_lib_ext(triple: StrView) -> StrView {
    if triple_is_windows(triple) {
        return ux2_sv(".dll")
    }
    if triple_is_macos(triple) {
        return ux2_sv(".dylib")
    }
    ux2_sv(".so")
}

pub fn artifact_exe_ext(triple: StrView) -> StrView {
    if triple_is_windows(triple) {
        return ux2_sv(".exe")
    }
    if triple_is_wasm(triple) {
        return ux2_sv(".wasm")
    }
    ux2_sv_empty()
}

pub fn format_target_env_root(
    env_class: u8,
    target_triple: StrView,
    profile_name: StrView,
    buf: mut_view<DiagBuffer>
) {
    diag_buf_push_sv(mut_view(*buf), ux2_sv(".axiom/target/"))
    if env_class == ENV_CLASS_HOST {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("host/"))
    } else {
        diag_buf_push_sv(mut_view(*buf), target_triple)
        diag_buf_push_byte(mut_view(*buf), 47u8)
    }
    diag_buf_push_sv(mut_view(*buf), profile_name)
}

pub fn format_build_gen_output_path(
    env_class: u8,
    target_triple: StrView,
    profile_name: StrView,
    pkg_name: StrView,
    out_rel: StrView,
    buf: mut_view<DiagBuffer>
) {
    format_target_env_root(env_class, target_triple, profile_name, mut_view(*buf))
    diag_buf_push_sv(mut_view(*buf), ux2_sv("/gen/"))
    diag_buf_push_sv(mut_view(*buf), pkg_name)
    diag_buf_push_byte(mut_view(*buf), 47u8)
    diag_buf_push_sv(mut_view(*buf), out_rel)
}

pub fn format_build_artifact_path(
    action_kind: u8,
    unit_kind: u8,
    env_class: u8,
    target_triple: StrView,
    profile_name: StrView,
    pkg_name: StrView,
    target_name: StrView,
    build_fingerprint: view<Digest256>,
    buf: mut_view<DiagBuffer>
) {
    format_target_env_root(env_class, target_triple, profile_name, mut_view(*buf))
    if action_kind == ACTION_RUN_BUILD_TOOL {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("/gen/"))
        diag_buf_push_sv(mut_view(*buf), pkg_name)
        diag_buf_push_byte(mut_view(*buf), 47u8)
        diag_buf_push_sv(mut_view(*buf), target_name)
        diag_buf_push_sv(mut_view(*buf), ux2_sv(".gen.ax"))
        return
    }
    if action_kind == ACTION_EMIT_INTERFACE {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("/deps/"))
        diag_buf_push_sv(mut_view(*buf), pkg_name)
        diag_buf_push_byte(mut_view(*buf), 45u8)
        push_cache_key_short_hex(build_fingerprint, mut_view(*buf))
        diag_buf_push_sv(mut_view(*buf), artifact_interface_ext())
        return
    }
    if action_kind == ACTION_COMPILE_CGU {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("/deps/"))
        diag_buf_push_sv(mut_view(*buf), pkg_name)
        diag_buf_push_byte(mut_view(*buf), 45u8)
        diag_buf_push_sv(mut_view(*buf), target_name)
        diag_buf_push_byte(mut_view(*buf), 45u8)
        push_cache_key_short_hex(build_fingerprint, mut_view(*buf))
        diag_buf_push_sv(mut_view(*buf), artifact_obj_ext(target_triple))
        return
    }
    if action_kind == ACTION_ASSEMBLE_ARCHIVE {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("/deps/lib"))
        diag_buf_push_sv(mut_view(*buf), pkg_name)
        diag_buf_push_byte(mut_view(*buf), 45u8)
        push_cache_key_short_hex(build_fingerprint, mut_view(*buf))
        diag_buf_push_sv(mut_view(*buf), artifact_archive_ext(target_triple))
        return
    }
    if action_kind == ACTION_LINK_ARTIFACT {
        if unit_kind == TARGET_UNIT_BUILD_TOOL {
            diag_buf_push_sv(mut_view(*buf), ux2_sv("/tools/"))
        } else {
            diag_buf_push_byte(mut_view(*buf), 47u8)
        }
        diag_buf_push_sv(mut_view(*buf), target_name)
        diag_buf_push_sv(mut_view(*buf), artifact_exe_ext(target_triple))
        return
    }
    diag_buf_push_sv(mut_view(*buf), ux2_sv("/test-logs/"))
    diag_buf_push_sv(mut_view(*buf), pkg_name)
    diag_buf_push_byte(mut_view(*buf), 45u8)
    diag_buf_push_sv(mut_view(*buf), target_name)
    diag_buf_push_sv(mut_view(*buf), ux2_sv(".log"))
}

// =============================================================================
// 3. `[[build_tool]]` Hermetic Sandbox & Provenance (`AXS-BLD-022`)
// =============================================================================

@derive(Copy)
pub struct BuildToolSandboxPolicy {
    pub pkg_name: StrView,
    pub tool_name: StrView,
    pub entry_path: StrView,
    pub declared_inputs: [4]StrView,
    pub declared_input_count: usize,
    pub declared_outputs: [4]StrView,
    pub declared_output_count: usize,
    pub net_cap_denied: bool,
    pub process_cap_denied: bool,
    pub clock_cap_denied: bool,
    pub env_var_count: u32,
    pub ambient_host_env_passed: bool,
}

pub fn build_tool_sandbox_policy_from_spec(
    pkg_name: StrView,
    spec: view<BuildToolTargetDecl>
) -> BuildToolSandboxPolicy {
    BuildToolSandboxPolicy {
        pkg_name: pkg_name,
        tool_name: spec.name,
        entry_path: spec.path,
        declared_inputs: spec.inputs,
        declared_input_count: spec.input_count,
        declared_outputs: spec.outputs,
        declared_output_count: spec.output_count,
        net_cap_denied: true,
        process_cap_denied: true,
        clock_cap_denied: true,
        env_var_count: 5u32,
        ambient_host_env_passed: false,
    }
}

pub fn verify_build_tool_sandbox_access(
    policy: view<BuildToolSandboxPolicy>,
    is_write: bool,
    candidate_path: StrView
) -> bool {
    if candidate_path.len == 0usize {
        return false
    }
    if ux2_sv_contains(candidate_path, ux2_sv("..")) {
        return false
    }
    if !is_write {
        if ux2_sv_eq(candidate_path, policy.entry_path) {
            return true
        }
        let mut i: usize = 0usize
        while i < policy.declared_input_count {
            if ux2_sv_eq(candidate_path, policy.declared_inputs[i]) {
                return true
            }
            i = i + 1usize
        }
        return false
    }

    if bld_sv_starts_with(candidate_path, ux2_sv("src/")) ||
        ux2_sv_eq(candidate_path, ux2_sv("axiom.toml")) ||
        ux2_sv_eq(candidate_path, ux2_sv("Axiom.toml")) {
        return false
    }
    if bld_sv_starts_with(candidate_path, ux2_sv(".axiom/target/")) &&
        ux2_sv_contains(candidate_path, ux2_sv("/gen/")) {
        return true
    }
    false
}

pub fn format_build_tool_env_var(
    pkg_id: view<PackageIdentity>,
    manifest_dir: StrView,
    target_triple: StrView,
    profile_name: StrView,
    var_idx: u32,
    buf: mut_view<DiagBuffer>
) {
    if var_idx == 0u32 {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("AXIOM_PACKAGE_NAME="))
        diag_buf_push_sv(mut_view(*buf), pkg_id.name)
        return
    }
    if var_idx == 1u32 {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("AXIOM_PACKAGE_VERSION="))
        diag_buf_push_u32(mut_view(*buf), pkg_id.version.major)
        diag_buf_push_byte(mut_view(*buf), 46u8)
        diag_buf_push_u32(mut_view(*buf), pkg_id.version.minor)
        diag_buf_push_byte(mut_view(*buf), 46u8)
        diag_buf_push_u32(mut_view(*buf), pkg_id.version.patch)
        return
    }
    if var_idx == 2u32 {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("AXIOM_MANIFEST_DIR="))
        diag_buf_push_sv(mut_view(*buf), manifest_dir)
        return
    }
    if var_idx == 3u32 {
        diag_buf_push_sv(mut_view(*buf), ux2_sv("AXIOM_OUT_DIR="))
        format_target_env_root(ENV_CLASS_TARGET, target_triple, profile_name, mut_view(*buf))
        diag_buf_push_sv(mut_view(*buf), ux2_sv("/gen/"))
        diag_buf_push_sv(mut_view(*buf), pkg_id.name)
        return
    }
    diag_buf_push_sv(mut_view(*buf), ux2_sv("AXIOM_TARGET_TRIPLE="))
    diag_buf_push_sv(mut_view(*buf), target_triple)
}

@derive(Copy)
pub struct GeneratedSourceProvenance {
