module compiler.diag.code

@derive(Copy)
pub enum DiagSeverity {
    Error,
    Warning,
    Info,
    Hint,
}

@derive(Copy)
pub enum FixApplicability {
    MachineApplicable,
    MaybeApplicable,
    ManualReview,
}

@derive(Copy)
pub enum DiagDataKind {
    String,
    Integer,
    Boolean,
    StringList,
}

@derive(Copy)
pub struct DiagCode {
    pub v: u32,
}

pub fn diag_code(v: u32) -> DiagCode {
    DiagCode { v: v }
}

pub fn diag_code_eq(a: DiagCode, b: DiagCode) -> bool {
    a.v == b.v
}

