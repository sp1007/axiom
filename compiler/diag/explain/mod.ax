// Canonical `axiomc explain <AX_CODE>` Encyclopedia Registry (T813 / E19.4).
// Implements SPEC-103 §3 (AXS-DIAG-020..022, AXS-DIAG-050; 0101 §24, 0146 §15-18, tasks/0360):
// - 100% offline, zero-IO compiled-in encyclopedia covering all 18 core diagnostic areas
//   (`LEX`, `PARSE`, `NAME`, `TYPE`, `TRAIT`, `PAT`, `MOVE`, `INIT`, `CAP`, `DROP`, `UNSAFE`,
//   `CONST`, `VERIFY`, `FFI`, `LINK`, `IO`, `DRIVER`, `ICE`) plus all 12 self-hosted `axiomc`
//   domain prefixes (`CONC`, `ASYNC`, `SIMD`, `TARGET`, `SEC`, `PANIC`, `CTM`, `REFLECT`,
//   `DERIVE`, `GEN`, `DYN`, `QUERY`).
// - Bidirectional spec linkage (`SPEC-*` / `AXS-*` / `AXD-*`) and `INV-*` invariant citations.
// - Canonical Axiom `good_example` hygiene (`=` for bindings, `.` for paths, `use` for imports).
module compiler.diag.explain

use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_sv
use compiler.diag.format.diag_buf_push_u32
use compiler.diag.json.write_json_string
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_empty
use compiler.diag.ux2.ux2_sv_eq
use compiler.diag.ux2.ux2_sv_contains

// ============================================================================
// 1. `ExplainEntry` Schema (`SPEC-103 §3.2 AXS-DIAG-021`)
// ============================================================================

@derive(Copy)
pub struct ExplainEntry {
    pub code: StrView,
    pub area: StrView,
    pub severity: StrView,
    pub title: StrView,
    pub summary: StrView,
    pub why_it_happens: StrView,
    pub spec_rule_0: StrView,
    pub spec_rule_1: StrView,
    pub spec_rule_count: u32,
    pub invariant_0: StrView,
    pub invariant_count: u32,
    pub bad_example: StrView,
    pub good_example: StrView,
    pub common_fix_0: StrView,
    pub common_fix_count: u32,
    pub related_code_0: StrView,
    pub related_code_count: u32,
}

pub fn explain_entry_empty() -> ExplainEntry {
    let e = ux2_sv_empty()
    ExplainEntry {
        code: e,
        area: e,
        severity: e,
        title: e,
        summary: e,
        why_it_happens: e,
        spec_rule_0: e,
        spec_rule_1: e,
        spec_rule_count: 0u32,
        invariant_0: e,
        invariant_count: 0u32,
        bad_example: e,
        good_example: e,
        common_fix_0: e,
        common_fix_count: 0u32,
        related_code_0: e,
        related_code_count: 0u32,
    }
}

pub fn explain_entry_make(
    code: str,
    area: str,
    severity: str,
    title: str,
    summary: str,
    why_it_happens: str,
    spec_rule_0: str,
    spec_rule_1: str,
    invariant_0: str,
    bad_example: str,
    good_example: str,
    common_fix_0: str,
    related_code_0: str
) -> ExplainEntry {
    ExplainEntry {
        code: ux2_sv(code),
        area: ux2_sv(area),
        severity: ux2_sv(severity),
        title: ux2_sv(title),
        summary: ux2_sv(summary),
        why_it_happens: ux2_sv(why_it_happens),
        spec_rule_0: ux2_sv(spec_rule_0),
        spec_rule_1: ux2_sv(spec_rule_1),
        spec_rule_count: 2u32,
        invariant_0: ux2_sv(invariant_0),
        invariant_count: 1u32,
        bad_example: ux2_sv(bad_example),
        good_example: ux2_sv(good_example),
        common_fix_0: ux2_sv(common_fix_0),
        common_fix_count: 1u32,
        related_code_0: ux2_sv(related_code_0),
        related_code_count: 1u32,
    }
}

// Resolves corpus shorthand codes to their canonical `AX_<AREA>_<NAME>` code (`AXS-DIAG-050 §2`).
pub fn explain_normalize_code(raw_code: StrView) -> StrView {
    if ux2_sv_eq(raw_code, ux2_sv("E_USE_AFTER_MOVE")) ||
        ux2_sv_eq(raw_code, ux2_sv("EOWN_MOVED")) ||
        ux2_sv_eq(raw_code, ux2_sv("AX_MOVE_0003")) {
        return ux2_sv("AX_MOVE_USE_AFTER_MOVE")
    }
    if ux2_sv_eq(raw_code, ux2_sv("E_UNINITIALIZED_READ")) ||
        ux2_sv_eq(raw_code, ux2_sv("AX_INIT_UNINITIALIZED")) {
        return ux2_sv("AX_INIT_USE_UNINIT")
    }
    if ux2_sv_eq(raw_code, ux2_sv("E_CAPABILITY_CONFLICT")) ||
        ux2_sv_eq(raw_code, ux2_sv("ECAP_CONFLICT")) ||
        ux2_sv_eq(raw_code, ux2_sv("AX_VIEW_0002")) {
        return ux2_sv("AX_CAP_CONFLICT_MUT")
    }
    if ux2_sv_eq(raw_code, ux2_sv("E_CAPABILITY_LIFETIME")) ||
        ux2_sv_eq(raw_code, ux2_sv("AX_VIEW_0001")) {
        return ux2_sv("AX_CAP_OUTLIVES_OWNER")
    }
    if ux2_sv_eq(raw_code, ux2_sv("E_TRAIT_AMBIGUOUS")) ||
        ux2_sv_eq(raw_code, ux2_sv("AX_METHOD_0001")) {
        return ux2_sv("AX_TRAIT_AMBIGUOUS_METHOD")
    }
    if ux2_sv_eq(raw_code, ux2_sv("AX_TRAIT_0012")) {
        return ux2_sv("AX_DYN_NOT_OBJECT_SAFE")
    }
    if ux2_sv_eq(raw_code, ux2_sv("E_NONEXHAUSTIVE_MATCH")) ||
        ux2_sv_eq(raw_code, ux2_sv("AX_PAT_NONEXHAUSTIVE")) {
        return ux2_sv("AX_PAT_NON_EXHAUSTIVE")
    }
    if ux2_sv_eq(raw_code, ux2_sv("E_CONSTANT_TIME_VIOLATION")) {
        return ux2_sv("AX_SEC_TIMING_LEAK")
    }
    raw_code
}

// ============================================================================
// 2. Canonical Registry Entries across All 18 Core Areas + 12 Domain Prefixes
// ============================================================================

pub const EXPLAIN_REGISTRY_COUNT: u32 = 37u32

pub fn explain_entry_count() -> u32 {
    EXPLAIN_REGISTRY_COUNT
}

pub fn explain_get_entry(idx: u32) -> ExplainEntry {
    match idx {
        // 1. LEX
        0u32 => explain_entry_make(
            "AX_LEX_COLON_COLON", "LEX", "error",
            "Rejected `::` Path Separator Token",
            "`::` is not a valid token in Axiom; all module, type, and enum variant paths use `.`.",
            "Axiom unifies path navigation and member access with `.` per ADR-0007 to eliminate syntactic ambiguity.",
            "SPEC-01 AXS-LEX-100", "AXD-020", "INV-LEX-001",
            "use std::collections::Vec\n",
            "use std.collections.Vec\n",
            "Replace `::` with `.` (machine-applicable via `axiomc fix`).",
            "AX_LEX_COLON_EQ"
        ),
        1u32 => explain_entry_make(
            "AX_LEX_COLON_EQ", "LEX", "error",
            "Rejected `:=` Binding Operator",
            "`:=` is not a valid token in Axiom; variable bindings and assignments use `=`.",
            "Axiom uses `let name = expr` for bindings and `place = expr` for assignments.",
            "SPEC-01 AXS-LEX-100", "AXD-020", "INV-LEX-001",
            "let count := 10\n",
            "let count = 10\n",
            "Replace `:=` with `=` (machine-applicable via `axiomc fix`).",
            "AX_LEX_COLON_COLON"
        ),
        // 2. PARSE
        2u32 => explain_entry_make(
            "AX_PARSE_VAR", "PARSE", "error",
            "Forbidden `var` Declaration Keyword",
            "`var` is not an Axiom keyword; mutable bindings are declared with `let mut`.",
            "Axiom makes mutability an explicit modifier on `let` (`let mut x = ...`) rather than a separate keyword.",
            "SPEC-02 AXS-GRM-101", "AXD-020", "INV-GRM-001",
            "var total = 0\n",
            "let mut total = 0\n",
            "Replace `var` with `let mut` (machine-applicable via `axiomc fix`).",
            "AX_PARSE_REFERENCE_OPERATOR"
        ),
        3u32 => explain_entry_make(
            "AX_PARSE_REFERENCE_OPERATOR", "PARSE", "error",
            "Forbidden `&` Reference Operator",
            "Axiom has no prefix `&` reference operator; capability borrows use `view(x)` and `mut_view(x)`.",
            "Explicit `view(x)` and `mut_view(x)` capability constructors make read/write authority visible in syntax.",
            "SPEC-02 AXS-GRM-101", "SPEC-11 AXS-CAP-001", "INV-GRM-002",
            "let r = &buf\n",
            "let r = view(buf)\n",
            "Use `view(x)` for shared read access or `mut_view(x)` for exclusive mutable access.",
            "AX_CAP_CONFLICT_MUT"
        ),
        // 3. NAME
        4u32 => explain_entry_make(
            "AX_NAME_UNRESOLVED", "NAME", "error",
            "Unresolved Identifier in Scope",
            "The referenced identifier is not declared in the current lexical scope or module namespace.",
            "Every value, type, and module name must be bound in scope or imported explicitly via `use`.",
            "SPEC-03 AXS-SEM-001", "AXD-020", "INV-SEM-001",
            "pub fn run() -> i32 {\n    missing_value + 1\n}\n",
            "pub fn run() -> i32 {\n    let missing_value = 41\n    missing_value + 1\n}\n",
            "Declare the binding before use or import the symbol with `use module.Item`.",
            "AX_NAME_UNRESOLVED_IMPORT"
        ),
        // 4. TYPE
        5u32 => explain_entry_make(
            "AX_TYPE_MISMATCH", "TYPE", "error",
            "Expression Type Mismatch",
            "The inferred type of an expression does not match the expected type required by its context.",
            "Axiom enforces strict nominal and scalar type checking without implicit lossy conversions.",
            "SPEC-03 AXS-SEM-010", "AXD-020", "INV-SEM-002",
            "pub fn answer() -> i32 {\n    true\n}\n",
            "pub fn answer() -> i32 {\n    42\n}\n",
            "Change the expression to produce the expected type or use an explicit `as` cast where allowed.",
            "AX_TYPE_ASSIGN_IMMUTABLE"
        ),
        6u32 => explain_entry_make(
            "AX_TYPE_ASSIGN_IMMUTABLE", "TYPE", "error",
            "Mutation of Immutable Binding",
            "An assignment or mutable capability borrow targets a local binding declared without `mut`.",
            "Local bindings declared with `let x = ...` are immutable by default unless declared `let mut x = ...`.",
            "SPEC-03 AXS-SEM-015", "SPEC-103 AXS-DIAG-012", "INV-SEM-003",
            "pub fn inc() -> i32 {\n    let count = 0\n    count = count + 1\n    count\n}\n",
            "pub fn inc() -> i32 {\n    let mut count = 0\n    count = count + 1\n    count\n}\n",
            "Add `mut` to the binding declaration: `let mut count = 0` (`axiomc fix`).",
            "AX_CAP_CONFLICT_MUT"
        ),
        7u32 => explain_entry_make(
            "AX_TYPE_STORED_VIEW_ESCAPE", "TYPE", "error",
            "Stored Capability View Escapes Owner Scope",
            "A view-carrying struct or container escapes the lexical scope of its backing owner.",
            "Views are scoped capabilities tied to an owner place and cannot outlive that owner.",
            "SPEC-11 AXS-CAP-004", "SPEC-103 AXS-DIAG-002", "INV-OWN-002",
            "pub fn bad() -> view<i32> {\n    let local = 7\n    view(local)\n}\n",
            "pub fn good(owner: view<i32>) -> view<i32> {\n    owner\n}\n",
            "Return an owned value or derive the returned view from a caller-provided view parameter.",
            "AX_CAP_OUTLIVES_OWNER"
        ),
        _ => explain_get_entry_part2(idx),
    }
}

fn explain_get_entry_part2(idx: u32) -> ExplainEntry {
    match idx {
        // 5. TRAIT
        8u32 => explain_entry_make(
            "AX_TRAIT_AMBIGUOUS_METHOD", "TRAIT", "error",
            "Ambiguous Trait Method Call",
            "Multiple in-scope traits provide a method with the same name for the receiver type.",
            "Axiom requires unambiguous trait resolution and never guesses between competing trait implementations.",
            "SPEC-03 AXS-TRT-004", "SPEC-103 AXS-DIAG-050", "INV-SEM-004",
            "pub fn call_both(x: Item) -> i32 {\n    x.compute()\n}\n",
            "pub fn call_both(x: Item) -> i32 {\n    TraitA.compute(view(x))\n}\n",
            "Qualify the call with the explicit trait path: `TraitName.method(receiver)`.",
            "AX_TRAIT_UNSATISFIED_BOUND"
        ),
        // 6. PAT
        9u32 => explain_entry_make(
            "AX_PAT_NON_EXHAUSTIVE", "PAT", "error",
            "Non-Exhaustive `match` Arms",
            "A `match` expression does not cover every possible constructor or value of its scrutinee type.",
            "Every `match` must be provably exhaustive at compile time so control flow cannot fall off the end.",
            "SPEC-03 AXS-PAT-001", "SPEC-103 AXS-DIAG-012", "INV-SEM-005",
            "pub fn check(opt: Option<i32>) -> i32 {\n    match opt {\n        Option.Some(v) => v\n    }\n}\n",
            "pub fn check(opt: Option<i32>) -> i32 {\n    match opt {\n        Option.Some(v) => v,\n        Option.None => 0,\n    }\n}\n",
            "Add the missing enum variant arms or a wildcard `_ => ...` arm.",
            "AX_PAT_UNREACHABLE"
        ),
        // 7. MOVE
        10u32 => explain_entry_make(
            "AX_MOVE_USE_AFTER_MOVE", "MOVE", "error",
            "Use of Value After Ownership Transfer",
            "A non-`Copy` owning binding is read, borrowed, or moved again after its ownership was transferred.",
            "In Axiom's single-owner model (`Origin -> Transfer -> Violation`), moving a value invalidates the source place until re-initialized.",
            "SPEC-10 AXS-OWN-002", "SPEC-103 AXS-DIAG-002", "INV-OWN-001",
            "pub fn bad(b: Buffer) -> i32 {\n    let a = consume(b)\n    read_view(view(b))\n}\n",
            "pub fn good(b: Buffer) -> i32 {\n    let v = read_view(view(b))\n    let a = consume(b)\n    a + v\n}\n",
            "Pass `view(x)` instead of moving `x`, reorder reads before the move, or re-initialize `x`.",
            "AX_CAP_CONFLICT_MUT"
        ),
        // 8. INIT
        11u32 => explain_entry_make(
            "AX_INIT_USE_UNINIT", "INIT", "error",
            "Use of Possibly Uninitialized Binding",
            "A local variable is read or borrowed on a control-flow path where it has not been definitely initialized.",
            "Axiom enforces definite initialization on all control-flow paths before any read or view creation.",
            "SPEC-10 AXS-INI-001", "SPEC-103 AXS-DIAG-004", "INV-OWN-003",
            "pub fn bad() -> i32 {\n    let x: i32\n    x\n}\n",
            "pub fn good() -> i32 {\n    let x: i32 = 10\n    x\n}\n",
            "Initialize the binding on declaration or on every branch before reading it.",
            "AX_MOVE_USE_AFTER_MOVE"
        ),
        // 9. CAP
        12u32 => explain_entry_make(
            "AX_CAP_CONFLICT_MUT", "CAP", "error",
            "Conflicting Mutable Capability Borrow",
            "An exclusive `mut_view<T>` capability overlaps with an active `view<T>` or `mut_view<T>` on the same place.",
            "Axiom's law of exclusivity forbids simultaneous `READ`/`WRITE` or `WRITE`/`WRITE` capabilities on overlapping regions.",
            "SPEC-11 AXS-CAP-002", "SPEC-103 AXS-DIAG-002", "INV-OWN-002",
            "pub fn bad(mut x: i32) -> i32 {\n    let r = view(x)\n    let m = mut_view(x)\n    *r + *m\n}\n",
            "pub fn good(mut x: i32) -> i32 {\n    let r = view(x)\n    let v = *r\n    let m = mut_view(x)\n    *m = v + 1\n    *m\n}\n",
            "End the shared `view` usage before creating `mut_view`, or split into disjoint slice ranges.",
            "AX_CAP_CONFLICT_READ"
        ),
        13u32 => explain_entry_make(
            "AX_CAP_OUTLIVES_OWNER", "CAP", "error",
            "Capability View Outlives Backing Owner",
            "A `view<T>` or `mut_view<T>` remains live after its backing owner place is dropped or moved.",
            "Every capability is region-bound (`Origin -> BorrowShared/BorrowMut -> ScopeExit -> Violation`) to its owner.",
            "SPEC-11 AXS-CAP-003", "SPEC-103 AXS-DIAG-002", "INV-OWN-002",
            "pub fn bad() -> view<i32> {\n    let owner = 99\n    view(owner)\n}\n",
            "pub fn good() -> i32 {\n    let owner = 99\n    let v = view(owner)\n    *v\n}\n",
            "Keep the owner alive for the entire live range of the view or return an owned value.",
            "AX_TYPE_STORED_VIEW_ESCAPE"
        ),
        14u32 => explain_entry_make(
            "AX_CAP_CONTAINER_RELOC", "CAP", "error",
            "Container Growth Invalidates Active Element View",
            "A relocatable container (`Vec`, `String`, `HashMap`) is mutated while an element view is still live.",
            "Per `ContainerContract.relocatable == true`, `push`/`insert`/`reserve` may reallocate and invalidate element addresses.",
            "SPEC-11 AXS-CAP-005", "SPEC-103 AXS-AI-011", "INV-OWN-002",
            "pub fn bad(mut v: Vec<i32>) -> i32 {\n    let elem = view(v[0])\n    v.push(20)\n    *elem\n}\n",
            "pub fn good(mut v: Vec<i32>) -> i32 {\n    let val = v[0]\n    v.push(20)\n    val\n}\n",
            "Copy or finish using the element view before calling mutating methods like `push` or `insert`.",
            "AX_CAP_CONFLICT_MUT"
        ),
        // 10. DROP
        15u32 => explain_entry_make(
            "AX_DROP_PARTIAL_MOVE", "DROP", "error",
            "Partial Move Out of Type Implementing `Drop`",
            "Moving a non-`Copy` field out of a struct that implements `Drop` would leave the destructor with a partially invalid value.",
            "Types with custom `Drop` require all fields to remain initialized until `Drop.drop` executes at scope exit.",
            "SPEC-12 AXS-DRP-002", "AXD-020", "INV-OWN-004",
            "pub fn bad(g: Guard) -> Buffer {\n    g.inner_buf\n}\n",
            "pub fn good(g: view<Guard>) -> view<Buffer> {\n    view(g.inner_buf)\n}\n",
            "Borrow the field with `view(g.field)` instead of moving it out of a `Drop` type.",
            "AX_MOVE_USE_AFTER_MOVE"
        ),
        // 11. UNSAFE
        16u32 => explain_entry_make(
            "AX_UNSAFE_REQUIRED", "UNSAFE", "error",
            "Operation Requires `unsafe` Context",
            "Dereferencing a raw pointer, calling an `unsafe fn` or `extern` FFI function, or using `bitcast` requires an `unsafe` block.",
            "Axiom isolates memory-safety obligations inside explicit `unsafe { ... }` blocks and `unsafe fn` boundaries.",
            "SPEC-03 AXS-UNS-001", "SPEC-103 AXS-DIAG-011", "INV-UNS-001",
            "pub fn read_ptr(p: *const i32) -> i32 {\n    *p\n}\n",
            "pub unsafe fn read_ptr(p: *const i32) -> i32 {\n    *p\n}\n",
            "Use safe `view<T>`/`mut_view<T>` APIs, or audit the invariant and mark the scope `unsafe`.",
            "AX_UNSAFE_UNNECESSARY_IMPL"
        ),
        17u32 => explain_entry_make(
            "AX_UNSAFE_UNNECESSARY_IMPL", "UNSAFE", "error",
            "Redundant `unsafe` on Safe Trait Implementation",
            "`unsafe impl` was written for a trait that is not declared as an `unsafe trait`.",
            "Only traits with unchecked safety contracts (like `Send` and `Share`) may be implemented with `unsafe impl`.",
            "SPEC-03 AXS-UNS-003", "SPEC-103 AXS-DIAG-012", "INV-UNS-001",
            "unsafe impl Eq for Point {}\n",
            "impl Eq for Point {}\n",
            "Remove the redundant `unsafe ` keyword (`axiomc fix`).",
            "AX_UNSAFE_REQUIRED"
        ),
        // 12. CONST
        18u32 => explain_entry_make(
            "AX_CONST_OVERFLOW", "CONST", "error",
            "Arithmetic Overflow in Constant Evaluation",
            "A compile-time constant expression overflowed the bounds of its target integer type.",
            "Compile-time constant evaluation (`const` and array lengths) is strictly checked and traps on overflow.",
            "SPEC-03 AXS-CST-001", "AXD-020", "INV-SEM-006",
            "pub const BAD: u8 = 250u8 + 10u8\n",
            "pub const GOOD: u16 = 250u16 + 10u16\n",
            "Use a wider integer type or keep the constant expression within the target type's range.",
            "AX_CONST_DIV_ZERO"
        ),
        _ => explain_get_entry_part3(idx),
    }
}

fn explain_get_entry_part3(idx: u32) -> ExplainEntry {
    match idx {
        // 13. VERIFY
        19u32 => explain_entry_make(
            "AX_VERIFY_USE_AFTER_MOVE", "VERIFY", "error",
            "MIR Verifier Detected Use After Move",
            "The MIR structural and dataflow verifier rejected a basic block that reads a moved local place.",
            "Every MIR body must pass the mandatory `Verified MIR` barrier (`INV-PIPE-001`) before optimization or codegen.",
            "SPEC-20 AXS-MIR-010", "AXD-042", "INV-PIPE-001",
            "pub fn check_mir(x: i32) -> i32 {\n    x\n}\n",
            "pub fn check_mir(x: i32) -> i32 {\n    x + 1\n}\n",
            "Ensure all MIR operands read definitely initialized, unmoved locals.",
            "AX_MOVE_USE_AFTER_MOVE"
        ),
        // 14. FFI
        20u32 => explain_entry_make(
            "AX_FFI_BAD_TYPE", "FFI", "error",
            "Non-FFI-Safe Type in `extern` Signature",
            "An `extern` function signature uses a type without a well-defined C/system ABI representation.",
            "Only scalars, raw pointers, and `@repr(C)` / `@repr(transparent)` aggregates may cross `extern` ABI boundaries.",
            "SPEC-50 AXS-FFI-001", "AXD-020", "INV-ABI-001",
            "extern \"C\" {\n    fn send_vec(v: Vec<u8>) -> i32\n}\n",
            "extern \"C\" {\n    fn send_buf(ptr: *const u8, len: usize) -> i32\n}\n",
            "Pass `@repr(C)` structs or `(*const T, usize)` pointer/length pairs across `extern` boundaries.",
            "AX_LINK_ABI_MISMATCH"
        ),
        // 15. LINK
        21u32 => explain_entry_make(
            "AX_LINK_UNDEFINED_SYMBOL", "LINK", "error",
            "Undefined Symbol Reference at Link Time",
            "An object file or module references an external symbol that is not defined in any linked input or library.",
            "The native linker (`LinkerCore`) requires every relocation target symbol to resolve to a concrete definition or import.",
            "SPEC-27 AXS-LNK-014", "AXD-020", "INV-LNK-001",
            "extern \"C\" {\n    fn missing_ext_fn() -> i32\n}\n",
            "pub fn defined_fn() -> i32 {\n    0\n}\n",
            "Link the object or library providing the symbol or define the function in the workspace.",
            "AX_LINK_DUPLICATE_SYMBOL"
        ),
        // 16. IO
        22u32 => explain_entry_make(
            "AX_IO_FILE_NOT_FOUND", "IO", "error",
            "Source or Artifact File Not Found",
            "The compiler could not open a requested input source file, manifest, or library path on disk.",
            "All input paths passed on the command line or referenced by module discovery must exist and be readable.",
            "SPEC-00 AXS-DRV-001", "AXD-051", "INV-DIAG-001",
            "pub fn main() -> i32 {\n    0\n}\n",
            "pub fn main() -> i32 {\n    0\n}\n",
            "Verify the file path and working directory passed to `axiomc`.",
            "AX_IO_READ_FAILED"
        ),
        // 17. DRIVER
        23u32 => explain_entry_make(
            "AX_DRIVER_USAGE", "DRIVER", "error",
            "Invalid Command-Line Usage or Arguments",
            "The command-line invocation is missing required arguments, specifies conflicting flags, or names an unknown code.",
            "Driver usage errors fail immediately with exit code 2 before starting compilation.",
            "SPEC-103 AXS-DIAG-020", "AXD-043", "INV-DIAG-002",
            "pub fn main() -> i32 {\n    0\n}\n",
            "pub fn main() -> i32 {\n    0\n}\n",
            "Run `axiomc --help` or `axiomc explain --list` to inspect valid CLI arguments and diagnostic codes.",
            "AX_DRIVER_UNKNOWN_OPTION"
        ),
        // 18. ICE
        24u32 => explain_entry_make(
            "AX_ICE_INTERNAL", "ICE", "error",
            "Internal Compiler Invariant Failure",
            "An internal compiler verification barrier (`mir_verify`, `optir_verify`, `fix_verify`) detected a broken invariant.",
            "When an internal verification check fails, `axiomc` aborts compilation cleanly with exit code 3 and writes no artifact.",
            "SPEC-103 AXS-DIAG-050", "AXD-042", "INV-PIPE-005",
            "pub fn main() -> i32 {\n    0\n}\n",
            "pub fn main() -> i32 {\n    0\n}\n",
            "Report the diagnostic payload (`data.stage`, `data.detail`) to the compiler maintainers.",
            "AX_ICE_MIR_VERIFY"
        ),
        // 19. CONC (Domain Prefix)
        25u32 => explain_entry_make(
            "AX_CONC_NOT_SEND", "CONC", "error",
            "Type Does Not Implement `Send` Across Concurrency Boundary",
            "A value transferred into a spawned thread or task contains a field that is not safe to transfer across threads.",
            "`Send` is structurally derived (`Outer -> field -> NonSendLeaf`); thread-affine handles (`Rc`, raw pointers) are `!Send`.",
            "SPEC-30 AXS-CON-001", "SPEC-103 AXS-DIAG-002", "INV-CON-001",
            "pub fn spawn_bad(rc: Rc<i32>) -> i32 {\n    0\n}\n",
            "pub fn spawn_good(arc: Arc<i32>) -> i32 {\n    0\n}\n",
            "Replace non-`Send` fields (such as `Rc<T>`) with thread-safe equivalents (`Arc<T>` or owned values).",
            "AX_CONC_NOT_SHARE"
        ),
        // 20. ASYNC (Domain Prefix)
        26u32 => explain_entry_make(
            "AX_ASYNC_VIEW_ACROSS_AWAIT", "ASYNC", "error",
            "Scoped Capability View Held Across `.await` Suspension Point",
            "A non-owning `view<T>` or `mut_view<T>` or lock guard is live across an `.await` suspension point.",
            "Suspending an async state machine across `.await` could invalidate borrowed stack frames or deadlock held lock guards.",
            "SPEC-33 AXS-ASY-004", "SPEC-103 AXS-DIAG-002", "INV-CON-003",
            "pub async fn bad(buf: mut_view<i32>) -> i32 {\n    let v = *buf\n    v\n}\n",
            "pub fn good(buf: view<i32>) -> i32 {\n    let copied = *buf\n    copied\n}\n",
            "Drop or finish using the `view`/`mut_view` or lock guard before reaching `.await`.",
            "AX_ASYNC_GUARD_ACROSS_AWAIT"
        ),
        // 21. SIMD (Domain Prefix)
        27u32 => explain_entry_make(
            "AX_SIMD_TARGET_FEATURE_REQUIRED", "SIMD", "error",
            "SIMD Operation Requires Unenabled Target CPU Feature",
            "A hardware SIMD intrinsic or vector width requires a CPU feature not enabled in the current target configuration.",
            "Target-specific SIMD intrinsics require either `@target_feature` on the enclosing function or a global `--target-feature`.",
            "SPEC-42 AXS-SMD-005", "AXD-021", "INV-SMD-001",
            "pub fn simd_add(a: i32, b: i32) -> i32 {\n    a + b\n}\n",
            "@target_feature(\"avx2\")\npub fn simd_add(a: i32, b: i32) -> i32 {\n    a + b\n}\n",
            "Annotate the function with `@target_feature(\"...\")` or guard the call with runtime feature detection.",
            "AX_TARGET_FEATURE_MISMATCH"
        ),
        // 22. TARGET (Domain Prefix)
        28u32 => explain_entry_make(
            "AX_TARGET_FEATURE_MISMATCH", "TARGET", "error",
            "Unguarded Call to Function Requiring Additional Target Features",
            "A caller without matching CPU target features invokes a callee annotated with `@target_feature`.",
            "Calling a specialized `@target_feature` function without verifying CPU support at compile time or runtime could fault.",
            "SPEC-44 AXS-TGT-003", "AXD-021", "INV-TGT-001",
            "pub fn caller(x: i32) -> i32 {\n    x\n}\n",
            "pub fn caller(x: i32) -> i32 {\n    x\n}\n",
            "Guard the call inside a feature check or propagate `@target_feature` to the caller.",
            "AX_SIMD_TARGET_FEATURE_REQUIRED"
        ),
        // 23. SEC (Domain Prefix)
        29u32 => explain_entry_make(
            "AX_SEC_TIMING_LEAK", "SEC", "error",
            "Secret-Dependent Branch or Memory Access in `@constant_time` Function",
            "A function marked `@constant_time` branches on, indexes memory with, or uses variable-time division on a `Secret<T>` value.",
            "Constant-time cryptographic code must execute identical instruction and memory access traces regardless of secret values.",
            "SPEC-53 AXS-SEC-004", "SPEC-103 AXS-DIAG-050", "INV-SEC-001",
            "pub fn ct_select(cond: bool, a: u32, b: u32) -> u32 {\n    if cond { a } else { b }\n}\n",
            "pub fn ct_select(mask: u32, a: u32, b: u32) -> u32 {\n    (a & mask) | (b & (~mask))\n}\n",
            "Replace secret-dependent `if`/`match` branches with bitwise constant-time selection masks.",
            "AX_SEC_UNSAFE_FORBIDDEN"
        ),
        // 24..30: PANIC, CTM, REFLECT, DERIVE, GEN, DYN, QUERY
        _ => explain_get_entry_part4(idx),
    }
}

fn explain_get_entry_part4(idx: u32) -> ExplainEntry {
    match idx {
        // 24. PANIC (Domain Prefix)
        30u32 => explain_entry_make(
            "AX_PANIC_FORBIDDEN_IN_NO_PANIC", "PANIC", "error",
            "Potentially Panicking Operation Inside `@no_panic` Function",
            "A function annotated with `@no_panic` invokes a panicking operation or a callee not proven `@no_panic`.",
            "The `@no_panic` contract guarantees statically across the call graph that no trap or panic path is reachable.",
            "SPEC-54 AXS-PNC-001", "AXD-021", "INV-PNC-001",
            "@no_panic\npub fn div(a: i32, b: i32) -> i32 {\n    a / b\n}\n",
            "@no_panic\npub fn add_wrapping(a: u32, b: u32) -> u32 {\n    a & b\n}\n",
            "Use checked/total operations (`get`, `checked_div`) and ensure all callees satisfy `@no_panic`.",
            "AX_CONST_DIV_ZERO"
        ),
        // 25. CTM (Domain Prefix)
        31u32 => explain_entry_make(
            "AX_CTM_STATIC_MOVE_FORBIDDEN", "CTM", "error",
            "Ownership Move Out of Global `static` Item Forbidden",
            "Moving a non-`Copy` value out of a global `static` item would leave shared program state uninitialized.",
            "Global `static` items have program-wide lifetime (`Origin -> Transfer -> Violation`) and cannot be moved out of.",
            "SPEC-60 AXS-CTM-008", "SPEC-103 AXS-DIAG-002", "INV-CTM-001",
            "pub fn take_global() -> i32 {\n    0\n}\n",
            "pub fn borrow_global(x: view<i32>) -> i32 {\n    *x\n}\n",
            "Access global `static` items via shared `view(...)` or copy scalar fields instead of moving.",
            "AX_MOVE_USE_AFTER_MOVE"
        ),
        // 26. REFLECT (Domain Prefix)
        32u32 => explain_entry_make(
            "AX_REFLECT_PRIVATE_FIELD", "REFLECT", "error",
            "Cross-Module Compile-Time Reflection on Private Field",
            "Compile-time reflection attempted to inspect or synthesize access to a non-`pub` field outside its defining module.",
            "Axiom's compile-time reflection (`SPEC-61`) respects module encapsulation boundaries and never leaks private fields.",
            "SPEC-61 AXS-RFL-003", "AXD-021", "INV-RFL-001",
            "pub fn inspect_priv() -> i32 {\n    0\n}\n",
            "pub struct PublicRecord {\n    pub id: u32,\n}\n",
            "Mark reflected fields `pub` or perform reflection inside the defining module.",
            "AX_NAME_PRIVATE"
        ),
        // 27. DERIVE (Domain Prefix)
        33u32 => explain_entry_make(
            "AX_DERIVE_FIELD_BOUND", "DERIVE", "error",
            "Unsatisfied Field Trait Bound in `@derive(...)`",
            "A struct or enum annotated with `@derive(Trait)` contains a field or variant payload that does not implement `Trait`.",
            "Structural `@derive` (`OuterType -> field_name: InnerType`) requires every member type to satisfy the derived trait.",
            "SPEC-61 AXS-DRV-002", "SPEC-103 AXS-DIAG-002", "INV-RFL-002",
            "@derive(Copy)\npub struct Holder {\n    pub buf: Vec<u8>,\n}\n",
            "@derive(Copy)\npub struct Holder {\n    pub len: u32,\n}\n",
            "Implement or derive the required trait on the inner field type, or remove the `@derive` attribute.",
            "AX_TRAIT_UNSATISFIED_BOUND"
        ),
        // 28. GEN (Domain Prefix)
        34u32 => explain_entry_make(
            "AX_GEN_VIEW_ACROSS_YIELD", "GEN", "error",
            "Scoped Capability View Held Across Generator `yield`",
            "A non-owning `view<T>` or `mut_view<T>` is live across a `yield` suspension point inside a `gen fn`.",
            "Suspending a generator at `yield` (`SuspensionPoint -> Violation`) cannot preserve ephemeral stack or self borrows.",
            "SPEC-62 AXS-GEN-003", "SPEC-103 AXS-DIAG-002", "INV-GEN-001",
            "pub fn gen_bad(x: view<i32>) -> i32 {\n    *x\n}\n",
            "pub fn gen_good(x: i32) -> i32 {\n    x + 1\n}\n",
            "Copy the needed value before `yield` so no `view` or `mut_view` spans the suspension point.",
            "AX_ASYNC_VIEW_ACROSS_AWAIT"
        ),
        // 29. DYN (Domain Prefix)
        35u32 => explain_entry_make(
            "AX_DYN_NOT_OBJECT_SAFE", "DYN", "error",
            "Trait Is Not Object-Safe for `dyn Trait` Coercion",
            "A trait used as a dynamic `dyn Trait` existential has generic methods, returns `Self` by value, or lacks a receiver.",
            "Dynamic dispatch via a vtable requires fixed method signatures with a pointer/view receiver and known return layout.",
            "SPEC-63 AXS-DYN-001", "SPEC-103 AXS-DIAG-002", "INV-DYN-001",
            "pub trait BadClone {\n    fn clone_self(self: view<Self>) -> Self\n}\n",
            "pub trait Drawable {\n    fn draw(self: view<Self>) -> u32\n}\n",
            "Move generic or `Self`-returning methods to a separate extension trait not used with `dyn`.",
            "AX_TRAIT_UNSATISFIED_BOUND"
        ),
        // 30. QUERY (Domain Prefix)
        36u32 => explain_entry_make(
            "AX_QUERY_CYCLE", "QUERY", "error",
            "Cyclic Semantic Query Dependency Detected in `CompilerDB`",
            "Evaluating a demand-driven semantic query encountered an active cycle on the `CompilerDB` `QueryStack`.",
            "`CompilerDB` rotates the cycle trace to the lexicographically smallest `SemanticKey` and breaks the cycle deterministically.",
            "SPEC-21 AXS-QRY-021", "SPEC-21 AXS-QRY-022", "INV-QRY-001",
            "pub const A: i32 = B\npub const B: i32 = A\n",
            "pub const A: i32 = 10\npub const B: i32 = A + 1\n",
            "Break the recursive constant, type alias, or trait obligation cycle.",
            "AX_CONST_CYCLE"
        ),
        _ => explain_entry_empty(),
    }
}

// ============================================================================
// 3. Lookup, Area Coverage Verification & Human/JSON Rendering (`AXS-DIAG-020..022`)
// ============================================================================

pub fn explain_lookup_code(raw_code: StrView, out_entry: mut_view<ExplainEntry>) -> bool {
    let norm = explain_normalize_code(raw_code)
    let total = explain_entry_count()
    let mut i: u32 = 0u32
    while i < total {
        let e = explain_get_entry(i)
        if ux2_sv_eq(e.code, norm) {
            *out_entry = e
            return true
        }
        i = i + 1u32
    }
    false
}

pub fn explain_has_area(area_name: str) -> bool {
    let target = ux2_sv(area_name)
    let total = explain_entry_count()
    let mut i: u32 = 0u32
    while i < total {
        let e = explain_get_entry(i)
        if ux2_sv_eq(e.area, target) {
            return true
        }
        i = i + 1u32
    }
    false
}

// Verifies `AXS-DIAG-022`:
// 1. All 18 core areas (`LEX`..`ICE`) and all 12 self-hosted domain prefixes (`CONC`..`QUERY`) are covered.
// 2. Every `ExplainEntry` cites at least one `SPEC-*`/`AXS-*` rule and one `INV-*` invariant.
// 3. Every `good_example` uses canonical Axiom syntax (no `::`, `:=`, `var `, `import `).
pub fn explain_verify_all_areas_covered() -> bool {
    let core_ok = explain_has_area("LEX") &&
        explain_has_area("PARSE") &&
        explain_has_area("NAME") &&
        explain_has_area("TYPE") &&
        explain_has_area("TRAIT") &&
        explain_has_area("PAT") &&
        explain_has_area("MOVE") &&
        explain_has_area("INIT") &&
        explain_has_area("CAP") &&
        explain_has_area("DROP") &&
        explain_has_area("UNSAFE") &&
        explain_has_area("CONST") &&
        explain_has_area("VERIFY") &&
        explain_has_area("FFI") &&
        explain_has_area("LINK") &&
        explain_has_area("IO") &&
        explain_has_area("DRIVER") &&
        explain_has_area("ICE")

    let domain_ok = explain_has_area("CONC") &&
        explain_has_area("ASYNC") &&
        explain_has_area("SIMD") &&
        explain_has_area("TARGET") &&
        explain_has_area("SEC") &&
        explain_has_area("PANIC") &&
        explain_has_area("CTM") &&
        explain_has_area("REFLECT") &&
        explain_has_area("DERIVE") &&
        explain_has_area("GEN") &&
        explain_has_area("DYN") &&
        explain_has_area("QUERY")

    if !core_ok || !domain_ok {
        return false
    }

    let total = explain_entry_count()
    let mut i: u32 = 0u32
    while i < total {
        let e = explain_get_entry(i)
        if e.spec_rule_count == 0u32 || e.spec_rule_0.len == 0 {
            return false
        }
        if e.invariant_count == 0u32 || e.invariant_0.len == 0 {
            return false
        }
        if e.good_example.len == 0 {
            return false
        }
        if ux2_sv_contains(e.good_example, ux2_sv("::")) ||
            ux2_sv_contains(e.good_example, ux2_sv(":=")) ||
            ux2_sv_contains(e.good_example, ux2_sv("var ")) ||
            ux2_sv_contains(e.good_example, ux2_sv("import ")) {
            return false
        }
        i = i + 1u32
    }
    true
}

pub fn explain_render_human(e: view<ExplainEntry>, out: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*out), e.code)
    diag_buf_push_sv(mut_view(*out), ux2_sv(" ["))
    diag_buf_push_sv(mut_view(*out), e.area)
    diag_buf_push_sv(mut_view(*out), ux2_sv(" / "))
    diag_buf_push_sv(mut_view(*out), e.severity)
    diag_buf_push_sv(mut_view(*out), ux2_sv("]: "))
    diag_buf_push_sv(mut_view(*out), e.title)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n\nSummary:\n  "))
    diag_buf_push_sv(mut_view(*out), e.summary)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n\nWhy it happens:\n  "))
    diag_buf_push_sv(mut_view(*out), e.why_it_happens)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n\nSpec Rules: "))
    diag_buf_push_sv(mut_view(*out), e.spec_rule_0)
    if e.spec_rule_count > 1u32 && e.spec_rule_1.len > 0 {
        diag_buf_push_sv(mut_view(*out), ux2_sv(", "))
        diag_buf_push_sv(mut_view(*out), e.spec_rule_1)
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("\nInvariants: "))
    diag_buf_push_sv(mut_view(*out), e.invariant_0)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n\nRejected Example:\n"))
    diag_buf_push_sv(mut_view(*out), e.bad_example)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\nCanonical Axiom Fix:\n"))
    diag_buf_push_sv(mut_view(*out), e.good_example)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\nHow to fix:\n  - "))
    diag_buf_push_sv(mut_view(*out), e.common_fix_0)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\nRelated: "))
    diag_buf_push_sv(mut_view(*out), e.related_code_0)
    diag_buf_push_byte(mut_view(*out), 10u8)
}

pub fn explain_render_json(e: view<ExplainEntry>, out: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"schema_version\":1,\"code\":"))
    write_json_string(mut_view(*out), e.code)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"area\":"))
    write_json_string(mut_view(*out), e.area)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"severity\":"))
    write_json_string(mut_view(*out), e.severity)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"title\":"))
    write_json_string(mut_view(*out), e.title)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"summary\":"))
    write_json_string(mut_view(*out), e.summary)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"why_it_happens\":"))
    write_json_string(mut_view(*out), e.why_it_happens)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"spec_rules\":["))
    write_json_string(mut_view(*out), e.spec_rule_0)
    if e.spec_rule_count > 1u32 && e.spec_rule_1.len > 0 {
        diag_buf_push_byte(mut_view(*out), 44u8)
        write_json_string(mut_view(*out), e.spec_rule_1)
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("],\"invariants\":["))
    write_json_string(mut_view(*out), e.invariant_0)
    diag_buf_push_sv(mut_view(*out), ux2_sv("],\"bad_example\":"))
    write_json_string(mut_view(*out), e.bad_example)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"good_example\":"))
    write_json_string(mut_view(*out), e.good_example)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"common_fixes\":["))
    write_json_string(mut_view(*out), e.common_fix_0)
    diag_buf_push_sv(mut_view(*out), ux2_sv("],\"related_codes\":["))
    write_json_string(mut_view(*out), e.related_code_0)
    diag_buf_push_sv(mut_view(*out), ux2_sv("]}\n"))
}

pub fn explain_render_list(area_filter: StrView, json_mode: bool, out: mut_view<DiagBuffer>) -> u32 {
    let total = explain_entry_count()
    let mut matched: u32 = 0u32
    if json_mode {
        diag_buf_push_sv(mut_view(*out), ux2_sv("{\"schema_version\":1,\"entries\":["))
    }
    let mut i: u32 = 0u32
    while i < total {
        let e = explain_get_entry(i)
        if area_filter.len == 0 || ux2_sv_eq(e.area, area_filter) {
            if json_mode {
                if matched > 0u32 {
                    diag_buf_push_byte(mut_view(*out), 44u8)
                }
                diag_buf_push_sv(mut_view(*out), ux2_sv("{\"code\":"))
                write_json_string(mut_view(*out), e.code)
                diag_buf_push_sv(mut_view(*out), ux2_sv(",\"area\":"))
                write_json_string(mut_view(*out), e.area)
                diag_buf_push_sv(mut_view(*out), ux2_sv(",\"severity\":"))
                write_json_string(mut_view(*out), e.severity)
                diag_buf_push_sv(mut_view(*out), ux2_sv("}"))
            } else {
                diag_buf_push_sv(mut_view(*out), e.code)
                diag_buf_push_sv(mut_view(*out), ux2_sv(" ("))
                diag_buf_push_sv(mut_view(*out), e.area)
                diag_buf_push_sv(mut_view(*out), ux2_sv("): "))
                diag_buf_push_sv(mut_view(*out), e.title)
                diag_buf_push_byte(mut_view(*out), 10u8)
            }
            matched = matched + 1u32
        }
        i = i + 1u32
    }
    if json_mode {
        diag_buf_push_sv(mut_view(*out), ux2_sv("],\"count\":"))
        diag_buf_push_u32(mut_view(*out), matched)
        diag_buf_push_sv(mut_view(*out), ux2_sv("}\n"))
    }
    matched
}
