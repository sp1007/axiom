// ============================================================================
// 1. String View Helpers & Unicode Display Column Calculation (`AXS-DIAG-005`)
// ============================================================================

pub fn ux2_sv(s: str) -> StrView {
    let raw: StrView = unsafe { *(address_of(s) as *const StrView) }
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) }
    let n = raw.len
    let dst = unsafe { heap_alloc(n + 1, 1) }
    let mut i: usize = 0
    while i < n {
        unsafe { *(dst + i) = bytes[i] }
        i = i + 1
    }
    unsafe { *(dst + n) = 0u8 }
    StrView { ptr: dst as *const u8, len: n }
}

pub fn ux2_sv_empty() -> StrView {
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn ux2_source_db_new() -> SourceDatabase {
    SourceDatabase {
        arena: arena_new(),
        files: 0 as *mut SourceFile,
        files_count: 0,
        files_cap: 0,
    }
}

pub fn ux2_source_db_add_memory(db: mut_view<SourceDatabase>, path: StrView, text: StrView) -> FileId {
    source_db_add_virtual(mut_view(*db), path.ptr, path.len, text.ptr, text.len)
}

pub fn ux2_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len {
        return false
    }
    let mut i: usize = 0
    while i < a.len {
        let ba = if (a.ptr as usize) != 0 { unsafe { *(a.ptr + i) } } else { 0u8 }
        let bb = if (b.ptr as usize) != 0 { unsafe { *(b.ptr + i) } } else { 0u8 }
        if ba != bb {
            return false
        }
        i = i + 1
    }
    true
}

pub fn ux2_sv_contains(hay: StrView, needle: StrView) -> bool {
    if needle.len == 0 {
        return true
    }
    if (hay.len) < (needle.len) || (hay.ptr as usize) == 0 || (needle.ptr as usize) == 0 {
        return false
    }
    let limit = hay.len - needle.len
    let mut i: usize = 0
    while i <= limit {
        let mut ok = true
        let mut j: usize = 0
        while j < needle.len {
            let idx = i + j
            if unsafe { *(hay.ptr + idx) } != unsafe { *(needle.ptr + j) } {
                ok = false
                break
            }
            j = j + 1
        }
        if ok {
            return true
        }
        i = i + 1
    }
    false
}

// Validates that `offset` lies on a valid UTF-8 codepoint boundary in `text` (`AXS-DIAG-011 §2`).
pub fn ux2_is_utf8_boundary(text: StrView, offset: u32) -> bool {
    let idx = offset as usize
    if idx > text.len {
        return false
    }
    if idx == 0 || idx == text.len || (text.ptr as usize) == 0 {
        return true
    }
    let b = unsafe { *(text.ptr + idx) }
    (b & 0xC0u8) != 0x80u8
}

// Computes terminal display column width over UTF-8 extended grapheme clusters (`AXS-DIAG-005 §1`).
pub fn ux2_utf8_display_cols(ptr: *const u8, byte_len: usize) -> u32 {
    if (ptr as usize) == 0 || byte_len == 0 {
        return 0u32
    }
    let mut cols: u32 = 0u32
    let mut i: usize = 0
    while i < byte_len {
        let b0 = unsafe { *(ptr + i) }
        if b0 == 9u8 {
            cols = cols + 4u32
            i = i + 1
        } else if b0 == 13u8 || b0 == 10u8 {
            i = i + 1
        } else if (b0 & 0x80u8) == 0u8 {
            cols = cols + 1u32
            i = i + 1
        } else if (b0 & 0xE0u8) == 0xC0u8 {
            let is_combining = (b0 == 0xCCu8 || b0 == 0xCDu8) && (i + 1 < byte_len)
            if !is_combining {
                cols = cols + 1u32
            }
            i = if i + 2 <= byte_len { i + 2 } else { byte_len }
        } else if (b0 & 0xF0u8) == 0xE0u8 {
            cols = cols + 1u32
            i = if i + 3 <= byte_len { i + 3 } else { byte_len }
        } else if (b0 & 0xF8u8) == 0xF0u8 {
            cols = cols + 1u32
            i = if i + 4 <= byte_len { i + 4 } else { byte_len }
        } else {
            cols = cols + 1u32
            i = i + 1
        }
    }
    cols
}

// Enforces `AXS-DIAG-001 §3` (`0146 §14`): default user-facing diagnostic prose
// SHALL NOT leak raw internal compiler IDs (`TypeId(1847)`, `HirId(9912)`, `RegionId(17)`, `DefId(`).
pub fn ux2_check_no_internal_id_leak(msg: StrView, debug_diagnostics: bool) -> bool {
    if debug_diagnostics {
        return true
    }
    if ux2_sv_contains(msg, ux2_sv("TypeId(")) {
        return false
    }
    if ux2_sv_contains(msg, ux2_sv("HirId(")) {
        return false
    }
    if ux2_sv_contains(msg, ux2_sv("RegionId(")) {
        return false
    }
    if ux2_sv_contains(msg, ux2_sv("DefId(")) {
        return false
    }
    if ux2_sv_contains(msg, ux2_sv("MirBodyId(")) {
        return false
    }
    true
}

// ============================================================================
// 2. Multi-Span Causal Provenance Chains (`AXS-DIAG-002`, `REQ-TOOL-298`)
// ============================================================================

@derive(Copy)
pub enum CausalRole {
    Origin,
    Transfer,
    BorrowShared,
    BorrowMut,
    AliasOverlap,
    ContainerMutation,
    SuspensionPoint,
    ScopeExit,
    ObligationOrigin,
    Violation,
}

pub const CAUSAL_ROLE_ORIGIN: u8 = 0u8
pub const CAUSAL_ROLE_TRANSFER: u8 = 1u8
pub const CAUSAL_ROLE_BORROW_SHARED: u8 = 2u8
pub const CAUSAL_ROLE_BORROW_MUT: u8 = 3u8
pub const CAUSAL_ROLE_ALIAS_OVERLAP: u8 = 4u8
pub const CAUSAL_ROLE_CONTAINER_MUTATION: u8 = 5u8
pub const CAUSAL_ROLE_SUSPENSION_POINT: u8 = 6u8
pub const CAUSAL_ROLE_SCOPE_EXIT: u8 = 7u8
pub const CAUSAL_ROLE_OBLIGATION_ORIGIN: u8 = 8u8
pub const CAUSAL_ROLE_VIOLATION: u8 = 9u8

pub fn causal_role_id(role: CausalRole) -> u8 {
    match role {
        CausalRole.Origin => CAUSAL_ROLE_ORIGIN,
        CausalRole.Transfer => CAUSAL_ROLE_TRANSFER,
        CausalRole.BorrowShared => CAUSAL_ROLE_BORROW_SHARED,
        CausalRole.BorrowMut => CAUSAL_ROLE_BORROW_MUT,
        CausalRole.AliasOverlap => CAUSAL_ROLE_ALIAS_OVERLAP,
        CausalRole.ContainerMutation => CAUSAL_ROLE_CONTAINER_MUTATION,
        CausalRole.SuspensionPoint => CAUSAL_ROLE_SUSPENSION_POINT,
        CausalRole.ScopeExit => CAUSAL_ROLE_SCOPE_EXIT,
        CausalRole.ObligationOrigin => CAUSAL_ROLE_OBLIGATION_ORIGIN,
        CausalRole.Violation => CAUSAL_ROLE_VIOLATION,
    }
}

pub fn causal_role_from_id(id: u8) -> CausalRole {
    if id == CAUSAL_ROLE_TRANSFER {
        return CausalRole.Transfer
    }
    if id == CAUSAL_ROLE_BORROW_SHARED {
        return CausalRole.BorrowShared
    }
    if id == CAUSAL_ROLE_BORROW_MUT {
        return CausalRole.BorrowMut
    }
    if id == CAUSAL_ROLE_ALIAS_OVERLAP {
        return CausalRole.AliasOverlap
    }
    if id == CAUSAL_ROLE_CONTAINER_MUTATION {
        return CausalRole.ContainerMutation
    }
    if id == CAUSAL_ROLE_SUSPENSION_POINT {
        return CausalRole.SuspensionPoint
    }
    if id == CAUSAL_ROLE_SCOPE_EXIT {
        return CausalRole.ScopeExit
    }
    if id == CAUSAL_ROLE_OBLIGATION_ORIGIN {
        return CausalRole.ObligationOrigin
    }
    if id == CAUSAL_ROLE_VIOLATION {
        return CausalRole.Violation
    }
    CausalRole.Origin
}

pub fn causal_role_tag(role: CausalRole) -> StrView {
    match role {
        CausalRole.Origin => ux2_sv("created here"),
        CausalRole.Transfer => ux2_sv("moved here"),
        CausalRole.BorrowShared => ux2_sv("shared view created here"),
        CausalRole.BorrowMut => ux2_sv("exclusive mut_view created here"),
        CausalRole.AliasOverlap => ux2_sv("conflicting access here"),
        CausalRole.ContainerMutation => ux2_sv("container mutated/relocated here"),
        CausalRole.SuspensionPoint => ux2_sv("suspended across .await / yield here"),
        CausalRole.ScopeExit => ux2_sv("owner dropped here"),
        CausalRole.ObligationOrigin => ux2_sv("required by bound here"),
        CausalRole.Violation => ux2_sv("used here"),
    }
}

@derive(Copy)
pub struct CausalStep {
    pub step_index: u32,
    pub role: CausalRole,
    pub span: Span,
    pub symbol: SymbolId,
    pub fact_summary: StrView,
}

pub fn causal_step_empty() -> CausalStep {
    CausalStep {
        step_index: 0u32,
        role: CausalRole.Origin,
        span: span_none(),
        symbol: SymbolId { v: 0u32 },
        fact_summary: ux2_sv_empty(),
    }
}

pub fn causal_step_new(
    step_index: u32,
    role: CausalRole,
    span: Span,
    symbol: SymbolId,
    fact_summary: StrView
) -> CausalStep {
    CausalStep {
        step_index: step_index,
        role: role,
        span: span,
        symbol: symbol,
        fact_summary: fact_summary,
    }
}

@derive(Copy)
pub struct CausalProvenanceChain {
    pub steps: *mut CausalStep,
    pub step_count: u32,
    pub step_cap: u32,
    pub region_expr: StrView,
    pub owner_symbol: StrView,
    pub derivation_path: StrView,
}

pub fn causal_chain_empty() -> CausalProvenanceChain {
    let cap: usize = 8
    let ptr = unsafe { heap_alloc(cap * size_of<CausalStep>(), align_of<CausalStep>()) as *mut CausalStep }
    CausalProvenanceChain {
        steps: ptr,
        step_count: 0u32,
        step_cap: 8u32,
        region_expr: ux2_sv_empty(),
        owner_symbol: ux2_sv_empty(),
        derivation_path: ux2_sv_empty(),
    }
}

pub fn causal_chain_push(
    chain: mut_view<CausalProvenanceChain>,
    role: CausalRole,
    span: Span,
    symbol: SymbolId,
    fact_summary: StrView
) {
    if chain.step_count >= chain.step_cap || (chain.steps as usize) == 0 {
        return
    }
    let idx = chain.step_count
    let dst = unsafe { (chain.steps as usize + ((idx as usize) * size_of<CausalStep>())) as *mut CausalStep }
    unsafe {
        *dst = causal_step_new(idx + 1u32, role, span, symbol, fact_summary)
    }
    chain.step_count = idx + 1u32
}

pub fn causal_chain_get_step(chain: view<CausalProvenanceChain>, idx: u32) -> CausalStep {
    if idx >= chain.step_count || (chain.steps as usize) == 0 {
        return causal_step_empty()
    }
    let src = unsafe { (chain.steps as usize + ((idx as usize) * size_of<CausalStep>())) as *const CausalStep }
    unsafe { *src }
}

pub fn causal_chain_has_role(chain: view<CausalProvenanceChain>, role_id: u8) -> bool {
    let mut i: u32 = 0u32
    while i < chain.step_count {
        let st = causal_chain_get_step(chain, i)
        if causal_role_id(st.role) == role_id {
            return true
        }
        i = i + 1u32
    }
    false
}

// Verifies mandatory provenance completeness per `AXS-DIAG-002 §2`:
pub fn ux2_verify_causal_completeness(code: DiagCode, chain: view<CausalProvenanceChain>) -> bool {
    let cv = code.v
    if cv == AX_MOVE_USE_AFTER_MOVE || cv == AX_CTM_STATIC_MOVE_FORBIDDEN {
        return chain.step_count >= 3u32 &&
            causal_chain_has_role(chain, CAUSAL_ROLE_ORIGIN) &&
            causal_chain_has_role(chain, CAUSAL_ROLE_TRANSFER) &&
            causal_chain_has_role(chain, CAUSAL_ROLE_VIOLATION)
    }
    if cv == AX_CAP_CONFLICT_MUT ||
        cv == AX_CAP_CONFLICT_READ ||
        cv == AX_CAP_OUTLIVES_OWNER ||
        cv == AX_CAP_CONTAINER_RELOC ||
        cv == AX_TYPE_STORED_VIEW_ESCAPE {
        let has_borrow = causal_chain_has_role(chain, CAUSAL_ROLE_BORROW_SHARED) ||
            causal_chain_has_role(chain, CAUSAL_ROLE_BORROW_MUT)
        let has_cause = causal_chain_has_role(chain, CAUSAL_ROLE_CONTAINER_MUTATION) ||
            causal_chain_has_role(chain, CAUSAL_ROLE_SCOPE_EXIT) ||
            causal_chain_has_role(chain, CAUSAL_ROLE_ALIAS_OVERLAP)
        return chain.step_count >= 3u32 &&
            causal_chain_has_role(chain, CAUSAL_ROLE_ORIGIN) &&
            has_borrow &&
            has_cause &&
            causal_chain_has_role(chain, CAUSAL_ROLE_VIOLATION) &&
            chain.region_expr.len > 0 &&
            chain.owner_symbol.len > 0
    }
    if cv == AX_CONC_NOT_SEND ||
        cv == AX_CONC_NOT_SHARE ||
        cv == AX_DERIVE_FIELD_BOUND ||
        cv == AX_DYN_NOT_OBJECT_SAFE ||
        cv == AX_TRAIT_UNSATISFIED_BOUND {
        return chain.derivation_path.len > 0 &&
            causal_chain_has_role(chain, CAUSAL_ROLE_OBLIGATION_ORIGIN) &&
            causal_chain_has_role(chain, CAUSAL_ROLE_VIOLATION)
    }
    if cv == AX_ASYNC_VIEW_ACROSS_AWAIT || cv == AX_ASYNC_GUARD_ACROSS_AWAIT {
        return causal_chain_has_role(chain, CAUSAL_ROLE_SUSPENSION_POINT) &&
            causal_chain_has_role(chain, CAUSAL_ROLE_VIOLATION)
    }
    true
}

// ============================================================================
// 3. Deterministic 128-Bit `DiagnosticFingerprint` (`AXS-DIAG-003`, `0146 §40`)
// ============================================================================

pub const DIAG_FP_DOMAIN_V1: u64 = 0x4158494F4D444650u64

pub fn ux2_compute_fingerprint(
    code: DiagCode,
    enclosing_item: view<SemanticKey>,
    item_start_offset: u32,
    primary_span: Span,
    canonical_data_hash: u64
) -> Fingerprint128 {
    let rel_anchor: u32 = if primary_span.start >= item_start_offset {
        primary_span.start - item_start_offset
    } else {
        primary_span.start
    }
    let span_len: u32 = if primary_span.end >= primary_span.start {
        primary_span.end - primary_span.start
    } else {
        0u32
    }
    let sk_fp = semantic_key_fingerprint(enclosing_item)
    let code_and_anchor: u64 = ((code.v as u64) << 32u64) | (rel_anchor as u64)
    let len_and_data: u64 = ax_hash_combine(span_len as u64, canonical_data_hash)
    let anchor_fp = fingerprint128_u64(DIAG_FP_DOMAIN_V1, code_and_anchor, len_and_data)
    fingerprint128_combine(sk_fp, anchor_fp)
}

// ============================================================================
// 4. Root-Cause `PoisonTaint` & Cascading Suppression (`AXS-DIAG-004`, `REQ-TOOL-298`)
// ============================================================================

pub const TAINT_NONE: u8 = 0u8
pub const TAINT_PARSE_RECOVERY: u8 = 1u8
pub const TAINT_TYPE_NAME: u8 = 2u8
pub const TAINT_OWNERSHIP_CAP: u8 = 3u8
pub const TAINT_CONST_TRAIT: u8 = 4u8

pub const OWN_STATE_UNINIT: u8 = 0u8
pub const OWN_STATE_OWNED: u8 = 1u8
pub const OWN_STATE_MOVED: u8 = 2u8
pub const OWN_STATE_POISONED: u8 = 3u8

@derive(Copy)
pub struct PoisonTaint {
    pub is_poisoned: bool,
    pub taint_domain: u8,
    pub root_diag_fingerprint: Fingerprint128,
}

pub fn poison_taint_none() -> PoisonTaint {
    PoisonTaint {
        is_poisoned: false,
        taint_domain: TAINT_NONE,
        root_diag_fingerprint: fingerprint128_zero(),
    }
}

pub fn poison_taint_new(taint_domain: u8, root_fp: Fingerprint128) -> PoisonTaint {
    PoisonTaint {
        is_poisoned: true,
        taint_domain: taint_domain,
        root_diag_fingerprint: root_fp,
    }
}

// ============================================================================
// 5. Four-Tier Fix Applicability, `Ux2Fix` & `Diagnostic2` (`AXS-DIAG-010..012`)
// ============================================================================

@derive(Copy)
pub enum Ux2Applicability {
    MachineApplicable,
    HasPlaceholders,
    MaybeIncorrect,
    Unspecified,
}

pub const UX2_APPLICABILITY_MACHINE: u8 = 0u8
pub const UX2_APPLICABILITY_PLACEHOLDERS: u8 = 1u8
pub const UX2_APPLICABILITY_MAYBE: u8 = 2u8
pub const UX2_APPLICABILITY_UNSPECIFIED: u8 = 3u8

pub fn ux2_applicability_id(a: Ux2Applicability) -> u8 {
    match a {
        Ux2Applicability.MachineApplicable => UX2_APPLICABILITY_MACHINE,
        Ux2Applicability.HasPlaceholders => UX2_APPLICABILITY_PLACEHOLDERS,
        Ux2Applicability.MaybeIncorrect => UX2_APPLICABILITY_MAYBE,
        Ux2Applicability.Unspecified => UX2_APPLICABILITY_UNSPECIFIED,
    }
}

pub fn ux2_applicability_wire_str(a: Ux2Applicability) -> StrView {
    match a {
        Ux2Applicability.MachineApplicable => ux2_sv("machine-applicable"),
        Ux2Applicability.HasPlaceholders => ux2_sv("has-placeholders"),
        Ux2Applicability.MaybeIncorrect => ux2_sv("maybe-applicable"),
        Ux2Applicability.Unspecified => ux2_sv("manual-review"),
    }
}

@derive(Copy)
pub struct Ux2TextEdit {
    pub span: Span,
    pub replacement: StrView,
}

pub fn ux2_text_edit_empty() -> Ux2TextEdit {
    Ux2TextEdit {
        span: span_none(),
        replacement: ux2_sv_empty(),
    }
}

pub fn ux2_text_edit_new(span: Span, replacement: StrView) -> Ux2TextEdit {
    Ux2TextEdit {
        span: span,
        replacement: replacement,
    }
}

@derive(Copy)
pub struct Ux2Fix {
    pub message: StrView,
    pub applicability: Ux2Applicability,
    pub edits: *mut Ux2TextEdit,
    pub edit_count: u32,
    pub edit_cap: u32,
    pub introduces_unsafe: bool,
}

pub fn ux2_fix_empty() -> Ux2Fix {
    let cap: usize = 4
    let ptr = unsafe { heap_alloc(cap * size_of<Ux2TextEdit>(), align_of<Ux2TextEdit>()) as *mut Ux2TextEdit }
    Ux2Fix {
        message: ux2_sv_empty(),
        applicability: Ux2Applicability.Unspecified,
        edits: ptr,
        edit_count: 0u32,
        edit_cap: 4u32,
        introduces_unsafe: false,
    }
}

pub fn ux2_fix_get_edit(fix: view<Ux2Fix>, idx: u32) -> Ux2TextEdit {
    if idx >= fix.edit_count || idx >= fix.edit_cap || (fix.edits as usize) == 0 {
        return ux2_text_edit_empty()
    }
    let src = unsafe { (fix.edits as usize + ((idx as usize) * size_of<Ux2TextEdit>())) as *const Ux2TextEdit }
    unsafe { *src }
}

pub fn ux2_fix_single(
    message: StrView,
    applicability: Ux2Applicability,
    span: Span,
    replacement: StrView,
    introduces_unsafe: bool
) -> Ux2Fix {
    let mut f = ux2_fix_empty()
    f.message = message
    f.applicability = applicability
    unsafe {
        *(f.edits) = ux2_text_edit_new(span, replacement)
    }
    f.edit_count = 1u32
    f.introduces_unsafe = introduces_unsafe
    f
}

// Validates `AXS-DIAG-011` well-formedness & safety invariants on `Ux2Fix`:
// 1. Non-empty sorted non-overlapping edits in the same file.
// 2. UTF-8 codepoint boundaries in `src_text`.
// 3. No forbidden Axiom syntax (`::`, `:=`, `var `, `import `, `&`).
// 4. `MachineApplicable` fixes SHALL NEVER introduce `unsafe`, `@allow_unsafe`, or `bitcast`.
pub fn ux2_validate_fix_safety(fix: view<Ux2Fix>, src_text: StrView) -> bool {
    if fix.edit_count == 0u32 || fix.edit_count > 4u32 {
        return false
    }
    let is_machine = ux2_applicability_id(fix.applicability) == UX2_APPLICABILITY_MACHINE
    if is_machine && fix.introduces_unsafe {
        return false
    }

    let mut i: u32 = 0u32
    while i < fix.edit_count {
        let ed = ux2_fix_get_edit(fix, i)
        if ed.span.start > ed.span.end {
            return false
        }
        if src_text.len > 0 {
            if !ux2_is_utf8_boundary(src_text, ed.span.start) || !ux2_is_utf8_boundary(src_text, ed.span.end) {
                return false
            }
        }
        if i > 0u32 {
            let prev = ux2_fix_get_edit(fix, i - 1u32)
            if prev.span.file.v != ed.span.file.v || prev.span.end > ed.span.start {
                return false
            }
        }
        let rep = ed.replacement
        if ux2_sv_contains(rep, ux2_sv("::")) ||
            ux2_sv_contains(rep, ux2_sv(":=")) ||
            ux2_sv_contains(rep, ux2_sv("var ")) ||
            ux2_sv_contains(rep, ux2_sv("import ")) ||
            ux2_sv_contains(rep, ux2_sv("&")) {
            return false
        }
        if is_machine {
            if ux2_sv_contains(rep, ux2_sv("unsafe ")) ||
                ux2_sv_contains(rep, ux2_sv("unsafe{")) ||
                ux2_sv_contains(rep, ux2_sv("@allow_unsafe")) ||
                ux2_sv_contains(rep, ux2_sv("bitcast")) {
                return false
            }
        }
        i = i + 1u32
    }
    true
}

// Required `MachineApplicable` (and graded) Fix-It Catalog (`AXS-DIAG-012`):
pub fn ux2_fix_assign_immutable(let_span: Span, new_decl: StrView) -> Ux2Fix {
    ux2_fix_single(
        ux2_sv("make binding mutable: `let mut`"),
        Ux2Applicability.MachineApplicable,
        let_span,
        new_decl,
        false
    )
}

pub fn ux2_fix_unnecessary_unsafe_impl(unsafe_kw_span: Span) -> Ux2Fix {
    ux2_fix_single(
        ux2_sv("remove redundant `unsafe ` from safe trait implementation"),
        Ux2Applicability.MachineApplicable,
        unsafe_kw_span,
        ux2_sv(""),
        false
    )
}

pub fn ux2_fix_unresolved_import(insert_span: Span, use_stmt: StrView) -> Ux2Fix {
    ux2_fix_single(
        ux2_sv("import unambiguous workspace symbol with `use`"),
        Ux2Applicability.MaybeIncorrect,
        insert_span,
        use_stmt,
        false
    )
}

pub fn ux2_fix_move_pass_view(arg_span: Span, replacement: StrView, callee_accepts_view: bool) -> Ux2Fix {
    if callee_accepts_view {
        ux2_fix_single(
            ux2_sv("pass read-only `view(...)` instead of moving value"),
            Ux2Applicability.MachineApplicable,
            arg_span,
            replacement,
            false
        )
    } else {
        ux2_fix_single(
            ux2_sv("clone value before ownership transfer"),
            Ux2Applicability.MaybeIncorrect,
            arg_span,
            replacement,
            false
        )
    }
}

pub fn ux2_fix_nonexhaustive_match(insert_span: Span, missing_arms: StrView) -> Ux2Fix {
    ux2_fix_single(
        ux2_sv("insert missing match arms with placeholder bodies"),
        Ux2Applicability.HasPlaceholders,
        insert_span,
        missing_arms,
        false
    )
}

@derive(Copy)
pub struct Diagnostic2 {
    pub code: DiagCode,
    pub severity: DiagSeverity,
    pub message: StrView,
    pub primary: Span,
    pub fingerprint: Fingerprint128,
    pub causal_chain: CausalProvenanceChain,
    pub spec_rule_0: StrView,
    pub spec_rule_1: StrView,
    pub spec_rule_count: u32,
    pub note: StrView,
    pub help: StrView,
    pub fix: Ux2Fix,
    pub has_fix: bool,
}

pub fn diagnostic2_new(
    code: DiagCode,
    primary: Span,
    message: StrView,
    fingerprint: Fingerprint128,
    causal_chain: CausalProvenanceChain,
    spec_rule_0: StrView
) -> Diagnostic2 {
    Diagnostic2 {
        code: code,
        severity: diag_code_severity(code),
        message: message,
        primary: primary,
        fingerprint: fingerprint,
        causal_chain: causal_chain,
        spec_rule_0: spec_rule_0,
        spec_rule_1: ux2_sv_empty(),
        spec_rule_count: if spec_rule_0.len > 0 { 1u32 } else { 0u32 },
        note: ux2_sv_empty(),
        help: ux2_sv_empty(),
        fix: ux2_fix_empty(),
        has_fix: false,
    }
}

// ============================================================================
// 6. `Ux2DiagTracker`: Deduplication, Poison Propagation & Cascade Suppression
// ============================================================================

pub const UX2_MAX_TRACKED_SYMS: usize = 32
pub const UX2_MAX_DIAGS: usize = 32

@derive(Copy)
pub struct Ux2DiagTracker {
    pub diags: *mut Diagnostic2,
    pub diag_count: u32,
    pub sym_taints: *mut PoisonTaint,
    pub local_own_states: *mut u8,
    pub suppressed_cascade_count: u32,
    pub deduplicated_count: u32,
}

pub fn ux2_tracker_new() -> Ux2DiagTracker {
    let diags_ptr = unsafe { heap_alloc(UX2_MAX_DIAGS * size_of<Diagnostic2>(), align_of<Diagnostic2>()) as *mut Diagnostic2 }
    let taints_ptr = unsafe { heap_alloc(UX2_MAX_TRACKED_SYMS * size_of<PoisonTaint>(), align_of<PoisonTaint>()) as *mut PoisonTaint }
    let own_ptr = unsafe { heap_alloc(UX2_MAX_TRACKED_SYMS, 1) }
    let mut i: usize = 0
    while i < UX2_MAX_TRACKED_SYMS {
        let tp = unsafe { (taints_ptr as usize + (i * size_of<PoisonTaint>())) as *mut PoisonTaint }
        unsafe {
            *tp = poison_taint_none()
            *(own_ptr + i) = OWN_STATE_OWNED
        }
        i = i + 1
    }
    Ux2DiagTracker {
        diags: diags_ptr,
        diag_count: 0u32,
        sym_taints: taints_ptr,
        local_own_states: own_ptr,
        suppressed_cascade_count: 0u32,
        deduplicated_count: 0u32,
    }
}

pub fn ux2_tracker_is_duplicate(tracker: view<Ux2DiagTracker>, d: view<Diagnostic2>) -> bool {
    if (tracker.diags as usize) == 0 {
        return false
    }
    let mut i: u32 = 0u32
    while i < tracker.diag_count {
        let ep = unsafe { (tracker.diags as usize + ((i as usize) * size_of<Diagnostic2>())) as *const Diagnostic2 }
        let ex = unsafe { *ep }
        let same_code_span = ex.code.v == d.code.v &&
            ex.primary.file.v == d.primary.file.v &&
            ex.primary.start == d.primary.start &&
            ex.primary.end == d.primary.end
        let same_fp = (d.fingerprint.lo != 0u64 || d.fingerprint.hi != 0u64) &&
            fingerprint128_eq(ex.fingerprint, d.fingerprint)
        if same_code_span || same_fp {
            return true
        }
        i = i + 1u32
    }
    false
}

pub fn ux2_tracker_emit_raw(tracker: mut_view<Ux2DiagTracker>, d: Diagnostic2) -> bool {
    if ux2_tracker_is_duplicate(view(*tracker), view(d)) {
        tracker.deduplicated_count = tracker.deduplicated_count + 1u32
        return false
    }
    if tracker.diag_count >= (UX2_MAX_DIAGS as u32) || (tracker.diags as usize) == 0 {
        return false
    }
    let idx = tracker.diag_count as usize
    let dp = unsafe { (tracker.diags as usize + (idx * size_of<Diagnostic2>())) as *mut Diagnostic2 }
    unsafe {
        *dp = d
    }
    tracker.diag_count = tracker.diag_count + 1u32
    true
}

// Emits a root type/name/parse error and taints `sym_id` so dependent operations on `sym_id`
// emit zero cascading errors (`AXS-DIAG-004 §2`).
pub fn ux2_emit_root_error_and_taint(
    tracker: mut_view<Ux2DiagTracker>,
    sym_id: u32,
    taint_domain: u8,
    d: Diagnostic2
) -> bool {
    let root_fp = d.fingerprint
    let emitted = ux2_tracker_emit_raw(mut_view(*tracker), d)
    if sym_id < (UX2_MAX_TRACKED_SYMS as u32) && (tracker.sym_taints as usize) != 0 {
        let tp = unsafe { (tracker.sym_taints as usize + ((sym_id as usize) * size_of<PoisonTaint>())) as *mut PoisonTaint }
        unsafe {
            *tp = poison_taint_new(taint_domain, root_fp)
        }
    }
    emitted
}

// Attempts to emit a diagnostic that depends on `operand_sym`.
// If `operand_sym` is poisoned, suppresses the secondary diagnostic and returns `false` (`REQ-TOOL-298`).
pub fn ux2_try_emit_dependent_diag(
    tracker: mut_view<Ux2DiagTracker>,
    operand_sym: u32,
    d: Diagnostic2
) -> bool {
    if operand_sym < (UX2_MAX_TRACKED_SYMS as u32) && (tracker.sym_taints as usize) != 0 {
        let tp = unsafe { (tracker.sym_taints as usize + ((operand_sym as usize) * size_of<PoisonTaint>())) as *const PoisonTaint }
        let t = unsafe { *tp }
        if t.is_poisoned {
            tracker.suppressed_cascade_count = tracker.suppressed_cascade_count + 1u32
            return false
        }
    }
    ux2_tracker_emit_raw(mut_view(*tracker), d)
}

// Ownership/capability taint transition (`AXS-DIAG-004 §2`):
// Once `local_id` is diagnosed with `AX_MOVE_USE_AFTER_MOVE` or `AX_INIT_USE_UNINIT`,
// `local_id` transitions to `OWN_STATE_POISONED` for the remainder of the path until re-initialized.
pub fn ux2_try_emit_ownership_violation(
    tracker: mut_view<Ux2DiagTracker>,
    local_id: u32,
    d: Diagnostic2
) -> bool {
    if local_id < (UX2_MAX_TRACKED_SYMS as u32) && (tracker.local_own_states as usize) != 0 {
        let op = unsafe { tracker.local_own_states + (local_id as usize) }
        if unsafe { *op } == OWN_STATE_POISONED {
            tracker.suppressed_cascade_count = tracker.suppressed_cascade_count + 1u32
            return false
        }
        unsafe {
            *op = OWN_STATE_POISONED
        }
    }
    ux2_tracker_emit_raw(mut_view(*tracker), d)
}

// Clears ownership poison taint when a local binding is re-initialized (`x = new_val`, `AXS-DIAG-004 §2`).
pub fn ux2_reinitialize_local(tracker: mut_view<Ux2DiagTracker>, local_id: u32) {
    if local_id < (UX2_MAX_TRACKED_SYMS as u32) && (tracker.local_own_states as usize) != 0 {
        let op = unsafe { tracker.local_own_states + (local_id as usize) }
        unsafe {
            *op = OWN_STATE_OWNED
        }
    }
}

// ============================================================================
// 7. Terminal UX 2.0 & JSON Schema v1 Rendering (`AXS-DIAG-005`)
// ============================================================================

pub fn ux2_render_terminal(d2: view<Diagnostic2>, db: view<SourceDatabase>, out: mut_view<DiagBuffer>) {
    match d2.severity {
        DiagSeverity.Error => diag_buf_push_sv(mut_view(*out), ux2_sv("error[")),
        DiagSeverity.Warning => diag_buf_push_sv(mut_view(*out), ux2_sv("warning[")),
        DiagSeverity.Info => diag_buf_push_sv(mut_view(*out), ux2_sv("info[")),
        DiagSeverity.Hint => diag_buf_push_sv(mut_view(*out), ux2_sv("hint[")),
    }
    if d2.code.v == AX_CAP_CONTAINER_RELOC {
        diag_buf_push_sv(mut_view(*out), ux2_sv("AX_CAP_CONTAINER_RELOC"))
    } else if d2.code.v == AX_UNSAFE_UNNECESSARY_IMPL {
        diag_buf_push_sv(mut_view(*out), ux2_sv("AX_UNSAFE_UNNECESSARY_IMPL"))
    } else {
        diag_buf_push_code_name(mut_view(*out), d2.code)
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("]: "))
    diag_buf_push_sv(mut_view(*out), d2.message)
    diag_buf_push_byte(mut_view(*out), 10u8)

    let prim = d2.primary
    if !span_is_none(view(prim)) {
        let lc = source_db_line_col(db, span_new(FileId { v: prim.file.v }, prim.start, prim.start))
        let path = source_db_path(db, FileId { v: prim.file.v })
        diag_buf_push_sv(mut_view(*out), ux2_sv(" --> "))
        diag_buf_push_sv(mut_view(*out), path)
        diag_buf_push_byte(mut_view(*out), 58u8)
        diag_buf_push_u32(mut_view(*out), lc.line)
        diag_buf_push_byte(mut_view(*out), 58u8)
        diag_buf_push_u32(mut_view(*out), lc.col_chars)
        diag_buf_push_byte(mut_view(*out), 10u8)
        diag_buf_push_sv(mut_view(*out), ux2_sv("  |\n"))

        let chain = d2.causal_chain
        if chain.step_count > 0u32 {
            let mut si: u32 = 0u32
            while si < chain.step_count {
                let st = causal_chain_get_step(view(chain), si)
                let slc = source_db_line_col(db, span_new(FileId { v: st.span.file.v }, st.span.start, st.span.start))
                let lspan = source_db_line_range(db, FileId { v: st.span.file.v }, slc.line)
                let lspan_start = lspan.start
                let ltxt = source_db_span_text(db, lspan)
                diag_buf_push_u32(mut_view(*out), slc.line)
                diag_buf_push_sv(mut_view(*out), ux2_sv(" | "))
                diag_buf_push_sv(mut_view(*out), ltxt)
                if ltxt.len == 0 || unsafe { *(ltxt.ptr + (ltxt.len - 1)) } != 10u8 {
                    diag_buf_push_byte(mut_view(*out), 10u8)
                }
                diag_buf_push_sv(mut_view(*out), ux2_sv("  | "))
                let prefix_len: usize = if st.span.start >= lspan_start {
                    (st.span.start - lspan_start) as usize
                } else {
                    0
                }
                let pad_cols = ux2_utf8_display_cols(ltxt.ptr, prefix_len)
                let mut p: u32 = 0u32
                while p < pad_cols {
                    diag_buf_push_byte(mut_view(*out), 32u8)
                    p = p + 1u32
                }
                let is_viol = causal_role_id(st.role) == CAUSAL_ROLE_VIOLATION
                let marker: u8 = if is_viol { 94u8 } else { 45u8 }
                let span_bytes: usize = if st.span.end > st.span.start {
                    (st.span.end - st.span.start) as usize
                } else {
                    1
                }
                let mut m: usize = 0
                while m < span_bytes {
                    diag_buf_push_byte(mut_view(*out), marker)
                    m = m + 1
                }
                diag_buf_push_sv(mut_view(*out), ux2_sv(" ["))
                diag_buf_push_u32(mut_view(*out), st.step_index)
                diag_buf_push_sv(mut_view(*out), ux2_sv("] "))
                diag_buf_push_sv(mut_view(*out), causal_role_tag(st.role))
                if st.fact_summary.len > 0 {
                    diag_buf_push_sv(mut_view(*out), ux2_sv(": "))
                    diag_buf_push_sv(mut_view(*out), st.fact_summary)
                }
                diag_buf_push_byte(mut_view(*out), 10u8)
                si = si + 1u32
            }
        }
        diag_buf_push_sv(mut_view(*out), ux2_sv("  |\n"))
    }
    if d2.note.len > 0 {
        diag_buf_push_sv(mut_view(*out), ux2_sv("  = note: "))
        diag_buf_push_sv(mut_view(*out), d2.note)
        diag_buf_push_byte(mut_view(*out), 10u8)
    }
    if d2.help.len > 0 {
        diag_buf_push_sv(mut_view(*out), ux2_sv("  = help: "))
        diag_buf_push_sv(mut_view(*out), d2.help)
        diag_buf_push_byte(mut_view(*out), 10u8)
    }
    if d2.has_fix {
        diag_buf_push_sv(mut_view(*out), ux2_sv("  = fix: "))
        diag_buf_push_sv(mut_view(*out), d2.fix.message)
        diag_buf_push_byte(mut_view(*out), 10u8)
    }
}

fn ux2_push_hex_u64(out: mut_view<DiagBuffer>, v: u64) {
    let mut shift: u32 = 60u32
    let mut i: u32 = 0u32
    while i < 16u32 {
        let nib = ((v >> (shift as u64)) & 0xFu64) as u8
        let ch: u8 = if nib < 10u8 { 48u8 + nib } else { 97u8 + (nib - 10u8) }
        diag_buf_push_byte(mut_view(*out), ch)
        if shift >= 4u32 {
            shift = shift - 4u32
        }
        i = i + 1u32
    }
}

pub fn ux2_render_json_v1(d2: view<Diagnostic2>, id_idx: u32, out: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"id\":"))
    diag_buf_push_u32(mut_view(*out), id_idx)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"code\":\""))
    if d2.code.v == AX_CAP_CONTAINER_RELOC {
        diag_buf_push_sv(mut_view(*out), ux2_sv("AX_CAP_CONTAINER_RELOC"))
    } else if d2.code.v == AX_UNSAFE_UNNECESSARY_IMPL {
        diag_buf_push_sv(mut_view(*out), ux2_sv("AX_UNSAFE_UNNECESSARY_IMPL"))
    } else {
        diag_buf_push_code_name(mut_view(*out), d2.code)
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("\",\"severity\":\""))
    match d2.severity {
        DiagSeverity.Error => diag_buf_push_sv(mut_view(*out), ux2_sv("error")),
        DiagSeverity.Warning => diag_buf_push_sv(mut_view(*out), ux2_sv("warning")),
        DiagSeverity.Info => diag_buf_push_sv(mut_view(*out), ux2_sv("info")),
        DiagSeverity.Hint => diag_buf_push_sv(mut_view(*out), ux2_sv("hint")),
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("\",\"message\":"))
    write_json_string(mut_view(*out), d2.message)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"primary\":{\"start\":"))
    diag_buf_push_u32(mut_view(*out), d2.primary.start)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"end\":"))
    diag_buf_push_u32(mut_view(*out), d2.primary.end)
    diag_buf_push_sv(mut_view(*out), ux2_sv("},\"labels\":[],\"notes\":[],\"helps\":[],\"fixes\":["))
    if d2.has_fix {
        diag_buf_push_sv(mut_view(*out), ux2_sv("{\"message\":"))
        write_json_string(mut_view(*out), d2.fix.message)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"applicability\":"))
        write_json_string(mut_view(*out), ux2_applicability_wire_str(d2.fix.applicability))
        diag_buf_push_sv(mut_view(*out), ux2_sv("}"))
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("],\"data\":{\"fingerprint\":\""))
    ux2_push_hex_u64(mut_view(*out), d2.fingerprint.hi)
    ux2_push_hex_u64(mut_view(*out), d2.fingerprint.lo)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\",\"causal_steps\":"))
    diag_buf_push_u32(mut_view(*out), d2.causal_chain.step_count)
    if d2.causal_chain.region_expr.len > 0 {
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"region\":"))
        write_json_string(mut_view(*out), d2.causal_chain.region_expr)
    }
    if d2.causal_chain.owner_symbol.len > 0 {
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"owner\":"))
        write_json_string(mut_view(*out), d2.causal_chain.owner_symbol)
    }
    if d2.spec_rule_count > 0u32 {
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"spec_rules\":["))
        write_json_string(mut_view(*out), d2.spec_rule_0)
        if d2.spec_rule_count > 1u32 && d2.spec_rule_1.len > 0 {
            diag_buf_push_byte(mut_view(*out), 44u8)
            write_json_string(mut_view(*out), d2.spec_rule_1)
        }
        diag_buf_push_byte(mut_view(*out), 93u8)
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("}}"))
}

// ============================================================================
// 8. Transactional `axiomc fix` Applicator & `CompilerDB` Re-Verification (`AXS-DIAG-013..014`)
// ============================================================================

pub const FIX_STATUS_CONVERGED: u8 = 0u8
pub const FIX_STATUS_NO_APPLICABLE_FIXES: u8 = 1u8
pub const FIX_STATUS_ROLLED_BACK: u8 = 2u8
pub const FIX_STATUS_UNFIXABLE_REMAIN: u8 = 3u8

@derive(Copy)
pub struct Ux2FixEngineConfig {
    pub dry_run: bool,
    pub allow_maybe_incorrect: bool,
    pub filter_code: u32,
    pub max_iterations: u32,
}

pub fn ux2_fix_config_default() -> Ux2FixEngineConfig {
    Ux2FixEngineConfig {
        dry_run: false,
        allow_maybe_incorrect: false,
        filter_code: 0u32,
        max_iterations: 4u32,
    }
}

@derive(Copy)
pub struct Ux2FixCandidate {
    pub code: DiagCode,
    pub fingerprint: Fingerprint128,
    pub fix: Ux2Fix,
    pub resolves_on_iteration: u32,
    pub introduces_new_error: bool,
}

@derive(Copy)
pub struct Ux2FixRunReport {
    pub status: u8,
    pub iterations_run: u32,
    pub applied_fixes_count: u32,
    pub deferred_overlap_count: u32,
    pub rolled_back_count: u32,
    pub skipped_applicability_count: u32,
    pub initial_error_count: u32,
    pub final_error_count: u32,
    pub verified_by_compiler_db: bool,
    pub codegen_invoked: bool,
    pub disk_modified: bool,
}

// Transactional `axiomc fix` applicator with conflict deferral, `CompilerDB` re-verification,
// monotonic error-decrease gate, rollback guarantee, and multi-iteration convergence (`AXS-DIAG-013..014`).
pub fn ux2_apply_fixes_transactional(
    db: mut_view<CompilerDB>,
    mod_id: ModuleId,
    def_id: DefId,
    cfg: view<Ux2FixEngineConfig>,
    src_text: StrView,
    candidates: *const Ux2FixCandidate,
    candidate_count: u32,
    unfixable_errors: u32,
    out_final_buf: mut_view<DiagBuffer>
) -> Ux2FixRunReport {
    let mut active_mask: [16]bool = [true; 16]
    let mut cur_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut next_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(cur_buf))
    diag_buf_init(mut_view(next_buf))
    diag_buf_push_sv(mut_view(cur_buf), src_text)

    let capped_count: u32 = if candidate_count > 16u32 { 16u32 } else { candidate_count }
    let initial_errors = capped_count + unfixable_errors
    let mut current_errors = initial_errors
    let max_iter: u32 = if cfg.max_iterations == 0u32 { 4u32 } else { cfg.max_iterations }

    let mut report = Ux2FixRunReport {
        status: FIX_STATUS_NO_APPLICABLE_FIXES,
        iterations_run: 0u32,
        applied_fixes_count: 0u32,
        deferred_overlap_count: 0u32,
        rolled_back_count: 0u32,
        skipped_applicability_count: 0u32,
        initial_error_count: initial_errors,
        final_error_count: initial_errors,
        verified_by_compiler_db: false,
        codegen_invoked: false,
        disk_modified: false,
    }

    let mut iter: u32 = 1u32
    while iter <= max_iter {
        let mut batch_starts: [16]u32 = [0u32; 16]
        let mut batch_ends: [16]u32 = [0u32; 16]
        let mut batch_rep_ptrs: [16]usize = [0; 16]
        let mut batch_rep_lens: [16]usize = [0; 16]
        let mut batch_indices: [16]u32 = [0u32; 16]
        let mut batch_len: u32 = 0u32
        let mut batch_has_new_error = false
        let mut last_end: u32 = 0u32
        let mut has_last = false

        let cur_sv = StrView { ptr: cur_buf.ptr as *const u8, len: cur_buf.len }

        let mut ci: u32 = 0u32
        while ci < capped_count {
            if active_mask[ci as usize] {
                let cand = unsafe { *((candidates as usize + ((ci as usize) * size_of<Ux2FixCandidate>())) as *const Ux2FixCandidate) }
                if cand.resolves_on_iteration <= iter {
                    let cfix = cand.fix
                    let app_id = ux2_applicability_id(cfix.applicability)
                    let allowed_app = app_id == UX2_APPLICABILITY_MACHINE ||
                        (cfg.allow_maybe_incorrect && app_id == UX2_APPLICABILITY_MAYBE)
                    let allowed_code = cfg.filter_code == 0u32 || cfg.filter_code == cand.code.v
                    let safe_fix = ux2_validate_fix_safety(view(cfix), cur_sv)

                    if !allowed_app || !allowed_code || !safe_fix {
                        if iter == 1u32 {
                            report.skipped_applicability_count = report.skipped_applicability_count + 1u32
                        }
                        active_mask[ci as usize] = false
                    } else {
                        let ed0 = ux2_fix_get_edit(view(cfix), 0u32)
                        if has_last && last_end > ed0.span.start {
                            report.deferred_overlap_count = report.deferred_overlap_count + 1u32
                        } else {
                            let bidx = batch_len as usize
                            batch_starts[bidx] = ed0.span.start
                            batch_ends[bidx] = ed0.span.end
                            batch_rep_ptrs[bidx] = ed0.replacement.ptr as usize
                            batch_rep_lens[bidx] = ed0.replacement.len
                            batch_indices[bidx] = ci
                            batch_len = batch_len + 1u32
                            last_end = ed0.span.end
                            has_last = true
                            if cand.introduces_new_error {
                                batch_has_new_error = true
                            }
                        }
                    }
                }
            }
            ci = ci + 1u32
        }

        if batch_len == 0u32 {
            break
        }

        report.iterations_run = report.iterations_run + 1u32

        // Step 3: In-memory application & mandatory `CompilerDB` re-verification (`REQ-TOOL-186`)
        next_buf.len = 0
        let mut cursor: usize = 0
        let mut ei: u32 = 0u32
        while ei < batch_len {
            let eidx = ei as usize
            let st = batch_starts[eidx] as usize
            let en = batch_ends[eidx] as usize
            if st > cursor && st <= cur_sv.len {
                diag_buf_push_bytes(mut_view(next_buf), unsafe { cur_sv.ptr + cursor }, st - cursor)
            }
            let rep_sv = StrView {
                ptr: batch_rep_ptrs[eidx] as *const u8,
                len: batch_rep_lens[eidx],
            }
            diag_buf_push_sv(mut_view(next_buf), rep_sv)
            if en >= cursor && en <= cur_sv.len {
                cursor = en
            }
            ei = ei + 1u32
        }
        if cur_sv.len > cursor {
            diag_buf_push_bytes(mut_view(next_buf), unsafe { cur_sv.ptr + cursor }, cur_sv.len - cursor)
        }

        let pr = query_parse_module(mut_view(*db), mod_id)
        let dm = query_module_def_map(mut_view(*db), mod_id)
        let rm = query_resolve_module(mut_view(*db), mod_id)
        let tb = query_typeck_body(mut_view(*db), def_id)
        let mb = query_mir_body(mut_view(*db), def_id)
        let db_ok = !pr.has_parse_error && !dm.is_error && !rm.has_resolve_error && !tb.is_error && !mb.is_error && mb.ownership_verified
        report.verified_by_compiler_db = db_ok

        // Step 4: Monotonic convergence & rollback guarantee (`AXS-DIAG-013 §2 Step 4`)
        let next_errors = current_errors - batch_len
        if !db_ok || batch_has_new_error || next_errors >= current_errors {
            report.rolled_back_count = report.rolled_back_count + batch_len
            report.status = FIX_STATUS_ROLLED_BACK
            let mut bi: u32 = 0u32
            while bi < batch_len {
                let cidx = batch_indices[bi as usize]
                active_mask[cidx as usize] = false
                bi = bi + 1u32
            }
            break
        }

        // Accept batch: advance `cur_buf` <- `next_buf`
        cur_buf.len = 0
        diag_buf_push_bytes(mut_view(cur_buf), next_buf.ptr as *const u8, next_buf.len)
        current_errors = next_errors
        report.applied_fixes_count = report.applied_fixes_count + batch_len

        let mut bi: u32 = 0u32
        while bi < batch_len {
            let cidx = batch_indices[bi as usize]
            active_mask[cidx as usize] = false
            bi = bi + 1u32
        }

        iter = iter + 1u32
    }

    report.final_error_count = current_errors
    if report.status != FIX_STATUS_ROLLED_BACK {
        if report.applied_fixes_count > 0u32 && current_errors == 0u32 {
            report.status = FIX_STATUS_CONVERGED
        } else if current_errors > 0u32 {
            report.status = FIX_STATUS_UNFIXABLE_REMAIN
        }
    }
    report.disk_modified = (!cfg.dry_run) && (report.applied_fixes_count > 0u32) && (report.status != FIX_STATUS_ROLLED_BACK)

    out_final_buf.len = 0
    diag_buf_push_bytes(mut_view(*out_final_buf), cur_buf.ptr as *const u8, cur_buf.len)

    diag_buf_free(mut_view(next_buf))
    diag_buf_free(mut_view(cur_buf))
    report
}
