@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// Extended self-hosted diagnostic code constants (`AXD-021`, `SPEC-103`)
pub const AX_ASYNC_VIEW_ACROSS_AWAIT: u32 = 158u32
pub const AX_ASYNC_GUARD_ACROSS_AWAIT: u32 = 159u32
pub const AX_CAP_CONTAINER_RELOC: u32 = 210u32
