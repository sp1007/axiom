@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

fn copy_fid(fid: view<FileId>) -> FileId { FileId { v: fid.v } }
fn copy_span(s: view<Span>) -> Span { Span { file: copy_fid(view(s.file)), start: s.start, end: s.end } }
fn copy_sv(sv: view<StrView>) -> StrView { StrView { ptr: sv.ptr, len: sv.len } }

pub struct DiagBuffer {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub fn diag_buf_new() -> DiagBuffer {
    DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

pub fn diag_buf_init(b: mut_view<DiagBuffer>) {
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

pub fn diag_buf_free(b: mut_view<DiagBuffer>) {
    if b.cap > 0 && b.ptr as usize != 0 {
        unsafe {
            heap_free(b.ptr, b.cap, 1);
        }
    }
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

pub fn diag_buf_push_byte(b: mut_view<DiagBuffer>, byte: u8) {
    if b.len == b.cap {
        let new_cap = if b.cap == 0 { 128 } else { b.cap + b.cap };
        let new_ptr = unsafe { heap_alloc(new_cap, 1) };
        if b.len > 0 && b.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, new_ptr, b.len);
                heap_free(b.ptr, b.cap, 1);
            }
        }
        b.ptr = new_ptr;
        b.cap = new_cap;
    }
    unsafe {
        *(b.ptr + b.len) = byte;
    }
    b.len = b.len + 1;
}

pub fn diag_buf_push_bytes(b: mut_view<DiagBuffer>, p: *const u8, count: usize) {
    if count == 0 || p as usize == 0 {
        return;
    }
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*b), unsafe { *(p + i) });
        i = i + 1;
    }
}

pub fn diag_buf_push_sv(b: mut_view<DiagBuffer>, sv: StrView) {
    diag_buf_push_bytes(b, sv.ptr, sv.len);
}

pub fn diag_buf_push_u32(b: mut_view<DiagBuffer>, mut n: u32) {
    if n == 0u32 {
        diag_buf_push_byte(b, 48u8);
        return;
    }
    let mut digits: [10]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut count: usize = 0;
    while n > 0u32 {
        digits[count] = ((n % 10u32) as u8) + 48u8;
        n = n / 10u32;
        count = count + 1;
    }
    while count > 0 {
        count = count - 1;
        diag_buf_push_byte(mut_view(*b), digits[count]);
    }
}

pub fn diag_buf_as_str_view(b: view<DiagBuffer>) -> StrView {
    StrView { ptr: b.ptr as *const u8, len: b.len }
}

const FMT_STRS: [97]u8 = [
    60u8, 117u8, 110u8, 107u8, 110u8, 111u8, 119u8, 110u8, 62u8, 32u8, 124u8, 32u8, 101u8, 114u8, 114u8, 111u8,
    114u8, 91u8, 119u8, 97u8, 114u8, 110u8, 105u8, 110u8, 103u8, 91u8, 105u8, 110u8, 102u8, 111u8, 91u8, 104u8,
    105u8, 110u8, 116u8, 91u8, 93u8, 58u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 45u8, 45u8, 62u8, 32u8,
    46u8, 46u8, 46u8, 10u8, 32u8, 32u8, 61u8, 32u8, 110u8, 111u8, 116u8, 101u8, 58u8, 32u8, 32u8, 32u8,
    61u8, 32u8, 104u8, 101u8, 108u8, 112u8, 58u8, 32u8, 32u8, 32u8, 61u8, 32u8, 102u8, 105u8, 120u8, 58u8,
    32u8, 32u8, 101u8, 114u8, 114u8, 111u8, 114u8, 44u8, 32u8, 32u8, 119u8, 97u8, 114u8, 110u8, 105u8, 110u8,
    103u8,
];

pub fn diag_buf_push_fmt_str(b: mut_view<DiagBuffer>, start: usize, byte_count: usize) {
    let mut i: usize = 0;
    while i < byte_count {
        diag_buf_push_byte(mut_view(*b), FMT_STRS[start + i]);
        i = i + 1;
    }
}

