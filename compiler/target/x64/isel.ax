    }
    inst
}

fn isel_mi_rm_sz(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    sz: u8,
    r0: i32,
    base: i32,
    index: i32,
    scale: u8,
    disp: i32
) -> *mut X64MI {
    let mut inst: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        let arena = mi.arena;
        let mi_sz: usize = size_of<X64MI>();
        let cur = (*arena).current;
        if (cur as usize) != 0 {
            let mask: usize = align_of<X64MI>() - 1;
            let c_addr: usize = (*cur).data as usize;
            let a_off: usize = (((c_addr + (*cur).used) + mask) & ~mask) - c_addr;
            let cap: usize = (*cur).cap;
            if cap >= a_off && (cap - a_off) >= mi_sz {
                (*arena).bytes_requested = (*arena).bytes_requested + mi_sz;
                (*cur).used = a_off + mi_sz;
                inst = (c_addr + a_off) as *mut X64MI;
            }
        }
        if (inst as usize) == 0 {
            inst = arena_alloc_raw(mut_view(*arena), mi_sz, align_of<X64MI>()) as *mut X64MI;
        }
        (*inst).opcode = opc;
        (*inst).op_count = 2u8;
        (*inst).size = sz;
        (*inst).sz = sz;
        (*inst).origin_vreg = LIR_VREG_NONE;
        (*inst).msg = 0 as *const u8;
        (*inst).msg_len = 0;
        (*inst).next = 0 as *mut X64MI;
        (*inst).ops[0usize].kind = X64_OP_REG;
        (*inst).ops[0usize].reg = r0;
        (*inst).ops[1usize].kind = X64_OP_MEM;
        (*inst).ops[1usize].mem.base = base;
        (*inst).ops[1usize].mem.index = index;
        (*inst).ops[1usize].mem.scale = scale;
        (*inst).ops[1usize].mem.disp = disp;
        (*inst).ops[1usize].mem.is_rip = false;
        (*inst).ops[2usize].kind = X64_OP_NONE;
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

fn isel_mi_mr_sz(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    sz: u8,
    base: i32,
    index: i32,
    scale: u8,
    disp: i32,
    r1: i32
) -> *mut X64MI {
    let mut inst: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        let arena = mi.arena;
        let mi_sz: usize = size_of<X64MI>();
        let cur = (*arena).current;
        if (cur as usize) != 0 {
            let mask: usize = align_of<X64MI>() - 1;
            let c_addr: usize = (*cur).data as usize;
            let a_off: usize = (((c_addr + (*cur).used) + mask) & ~mask) - c_addr;
            let cap: usize = (*cur).cap;
            if cap >= a_off && (cap - a_off) >= mi_sz {
                (*arena).bytes_requested = (*arena).bytes_requested + mi_sz;
                (*cur).used = a_off + mi_sz;
                inst = (c_addr + a_off) as *mut X64MI;
            }
        }
        if (inst as usize) == 0 {
            inst = arena_alloc_raw(mut_view(*arena), mi_sz, align_of<X64MI>()) as *mut X64MI;
        }
        (*inst).opcode = opc;
        (*inst).op_count = 2u8;
        (*inst).size = sz;
        (*inst).sz = sz;
        (*inst).origin_vreg = LIR_VREG_NONE;
        (*inst).msg = 0 as *const u8;
        (*inst).msg_len = 0;
        (*inst).next = 0 as *mut X64MI;
        (*inst).ops[0usize].kind = X64_OP_MEM;
        (*inst).ops[0usize].mem.base = base;
        (*inst).ops[0usize].mem.index = index;
        (*inst).ops[0usize].mem.scale = scale;
        (*inst).ops[0usize].mem.disp = disp;
        (*inst).ops[0usize].mem.is_rip = false;
        (*inst).ops[1usize].kind = X64_OP_REG;
        (*inst).ops[1usize].reg = r1;
        (*inst).ops[2usize].kind = X64_OP_NONE;
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

fn isel_mi_rsym(mi: mut_view<X64MIBody>, mbb: mut_view<X64MIBb>, opc: u32, r0: i32, sym: u32) -> *mut X64MI {
    let inst = isel_alloc_mi(mut_view(*mi), mut_view(*mbb), opc, 8u8, 2u8);
    unsafe {
        (*inst).ops[0usize].kind = X64_OP_REG;
        (*inst).ops[0usize].reg = r0;
        (*inst).ops[1usize].kind = X64_OP_SYM;
        (*inst).ops[1usize].sym = sym;
        (*inst).ops[2usize].kind = X64_OP_NONE;
    }
    inst
}

fn isel_mi_cmovcc_rr(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cc: u8,
    r_dst: i32,
    r_src: i32
) -> *mut X64MI {
    let inst = isel_alloc_mi(mut_view(*mi), mut_view(*mbb), X64_MI_CMOVCC, 8u8, 3u8);
    unsafe {
        (*inst).ops[0usize].kind = X64_OP_IMM;
        (*inst).ops[0usize].imm = cc as i64;
        (*inst).ops[1usize].kind = X64_OP_REG;
        (*inst).ops[1usize].reg = r_dst;
        (*inst).ops[2usize].kind = X64_OP_REG;
        (*inst).ops[2usize].reg = r_src;
    }
    inst
}

pub fn x64_mi_add_string(body: mut_view<X64MIBody>, bytes: *const u8, str_len: usize) -> u32 {
    let sym_id = (100000 + body.string_count) as u32;
    if body.string_count >= body.string_cap {
        let new_cap = if body.string_cap == 0 { 16 } else { lir_mul_usize(body.string_cap, 2) };
        let new_bytes = lir_mul_usize(new_cap, size_of<X64MIStr>());
        let new_strings = unsafe {
            arena_alloc_raw(mut_view(*body.arena), new_bytes, align_of<X64MIStr>()) as *mut X64MIStr
        };
        if (body.strings as usize) != 0 && body.string_count > 0 {
            let copy_bytes = lir_mul_usize(body.string_count, size_of<X64MIStr>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(body.strings as *const u8, new_strings as *mut u8, copy_bytes);
            }
        }
        body.strings = new_strings;
        body.string_cap = new_cap;
    }
    let entry = unsafe { x64_mi_str_at(body.strings, body.string_count) };
    unsafe {
        (*entry).bytes = bytes;
        (*entry).len = str_len;
        (*entry).sym_id = sym_id;
    }
    body.string_count = body.string_count + 1;
    sym_id
}

// =============================================================================
// 2. Machine IR Text Printer (target/x64/mir/mi.c)
// =============================================================================

// Constant byte table for `x64_mi_print` (following `compiler/lir/lir.ax` pattern):
//   0..2   (3):  "rax"
//   3..5   (3):  "rcx"
//   6..8   (3):  "rdx"
//   9..11  (3):  "rbx"
//  12..14  (3):  "rsp"
//  15..17  (3):  "rbp"
//  18..20  (3):  "rsi"
//  21..23  (3):  "rdi"
//  24..25  (2):  "r8"
//  26..27  (2):  "r9"
//  28..30  (3):  "r10"
//  31..33  (3):  "r11"
//  34..36  (3):  "r12"
//  37..39  (3):  "r13"
//  40..42  (3):  "r14"
//  43..45  (3):  "r15"
//  46..47  (2):  "r?"
//  48..50  (3):  "rip"
//  51..53  (3):  " + "
//  54..56  (3):  " - "
//  57..63  (7):  "[frame#"
//  64..67  (4):  "sym#"
//  68..69  (2):  "  "
//  70..71  (2):  ", "
//  72..89  (18): "frame_req: shadow="
//  90..100 (11): " args_size="
// 101..102 (2):  "bb"
// 103..104 (2):  ":\n"
// 105..107 (3):  "mov"
// 108..110 (3):  "add"
// 111..113 (3):  "sub"
// 114..117 (4):  "imul"
// 118..121 (4):  "idiv"
// 122..124 (3):  "and"
// 125..126 (2):  "or"
// 127..129 (3):  "xor"
// 130..132 (3):  "shl"
// 133..135 (3):  "sar"
// 136..138 (3):  "shr"
// 139..141 (3):  "lea"
// 142..144 (3):  "cmp"
// 145..147 (3):  "jmp"
// 148..150 (3):  "jcc"
// 151..154 (4):  "call"
// 155..158 (4):  "push"
// 159..161 (3):  "pop"
// 162..166 (5):  "setcc"
// 167..169 (3):  "ret"
// 170..175 (6):  "(null)"
// 176..178 (3):  "mul"
// 179..182 (4):  "test"
// 183..188 (6):  "cmovcc"
const MI_STR_TABLE: [189]u8 = [
    114u8, 97u8, 120u8,
    114u8, 99u8, 120u8,
    114u8, 100u8, 120u8,
    114u8, 98u8, 120u8,
    114u8, 115u8, 112u8,
    114u8, 98u8, 112u8,
    114u8, 115u8, 105u8,
    114u8, 100u8, 105u8,
    114u8, 56u8,
    114u8, 57u8,
    114u8, 49u8, 48u8,
    114u8, 49u8, 49u8,
    114u8, 49u8, 50u8,
    114u8, 49u8, 51u8,
    114u8, 49u8, 52u8,
    114u8, 49u8, 53u8,
    114u8, 63u8,
    114u8, 105u8, 112u8,
    32u8, 43u8, 32u8,
    32u8, 45u8, 32u8,
    91u8, 102u8, 114u8, 97u8, 109u8, 101u8, 35u8,
    115u8, 121u8, 109u8, 35u8,
    32u8, 32u8,
    44u8, 32u8,
    102u8, 114u8, 97u8, 109u8, 101u8, 95u8, 114u8, 101u8, 113u8, 58u8, 32u8, 115u8, 104u8, 97u8, 100u8, 111u8, 119u8, 61u8,
    32u8, 97u8, 114u8, 103u8, 115u8, 95u8, 115u8, 105u8, 122u8, 101u8, 61u8,
    98u8, 98u8,
    58u8, 10u8,
    109u8, 111u8, 118u8,
    97u8, 100u8, 100u8,
    115u8, 117u8, 98u8,
    105u8, 109u8, 117u8, 108u8,
    105u8, 100u8, 105u8, 118u8,
    97u8, 110u8, 100u8,
    111u8, 114u8,
    120u8, 111u8, 114u8,
    115u8, 104u8, 108u8,
    115u8, 97u8, 114u8,
    115u8, 104u8, 114u8,
    108u8, 101u8, 97u8,
    99u8, 109u8, 112u8,
    106u8, 109u8, 112u8,
    106u8, 99u8, 99u8,
    99u8, 97u8, 108u8, 108u8,
    112u8, 117u8, 115u8, 104u8,
    112u8, 111u8, 112u8,
    115u8, 101u8, 116u8, 99u8, 99u8,
    114u8, 101u8, 116u8,
    40u8, 110u8, 117u8, 108u8, 108u8, 41u8,
    109u8, 117u8, 108u8,
    116u8, 101u8, 115u8, 116u8,
    99u8, 109u8, 111u8, 118u8, 99u8, 99u8,
];

fn mi_push_str(out: mut_view<DiagBuffer>, off: usize, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), MI_STR_TABLE[off + i]);
        i = i + 1;
    }
}

fn mi_push_reg_name(out: mut_view<DiagBuffer>, reg: i32) {
    if reg == 0 {
        mi_push_str(mut_view(*out), 0, 3);
    } else if reg == 1 {
        mi_push_str(mut_view(*out), 3, 3);
    } else if reg == 2 {
        mi_push_str(mut_view(*out), 6, 3);
    } else if reg == 3 {
        mi_push_str(mut_view(*out), 9, 3);
    } else if reg == 4 {
        mi_push_str(mut_view(*out), 12, 3);
    } else if reg == 5 {
        mi_push_str(mut_view(*out), 15, 3);
    } else if reg == 6 {
        mi_push_str(mut_view(*out), 18, 3);
    } else if reg == 7 {
        mi_push_str(mut_view(*out), 21, 3);
    } else if reg == 8 {
        mi_push_str(mut_view(*out), 24, 2);
    } else if reg == 9 {
        mi_push_str(mut_view(*out), 26, 2);
    } else if reg == 10 {
        mi_push_str(mut_view(*out), 28, 3);
    } else if reg == 11 {
        mi_push_str(mut_view(*out), 31, 3);
    } else if reg == 12 {
        mi_push_str(mut_view(*out), 34, 3);
    } else if reg == 13 {
        mi_push_str(mut_view(*out), 37, 3);
    } else if reg == 14 {
        mi_push_str(mut_view(*out), 40, 3);
    } else if reg == 15 {
        mi_push_str(mut_view(*out), 43, 3);
    } else if reg >= 16 && reg <= 31 {
        diag_buf_push_byte(mut_view(*out), 120u8);
        diag_buf_push_byte(mut_view(*out), 109u8);
        diag_buf_push_byte(mut_view(*out), 109u8);
        diag_buf_push_u32(mut_view(*out), (reg - 16) as u32);
    } else {
        mi_push_str(mut_view(*out), 46, 2);
    }
}

fn push_u64_dec(out: mut_view<DiagBuffer>, val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(mut_view(*out), 48u8);
    } else {
        let mut digits: [20]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
        let mut v = val;
        let mut n: usize = 0;
        while v > 0u64 {
            let half = v >> 1u64;
            let r5 = (half % 5u64) as u8;
            let odd = (v & 1u64) as u8;
            let rem = r5 + r5 + odd;
            digits[n] = 48u8 + rem;
            v = half / 5u64;
            n = n + 1;
        }
        while n > 0 {
            n = n - 1;
            diag_buf_push_byte(mut_view(*out), digits[n]);
        }
    }
}

fn push_i64_dec(out: mut_view<DiagBuffer>, val: i64) {
    if val < 0i64 {
        diag_buf_push_byte(mut_view(*out), 45u8); // '-'
        // Compute magnitude of negative i64 (including INT64_MIN) without signed or unsigned overflow
        let plus1 = val + 1i64;
        let neg_plus1 = (0i64 - plus1) as u64;
        let mag = neg_plus1 + 1u64;
        push_u64_dec(mut_view(*out), mag);
    } else {
        push_u64_dec(mut_view(*out), val as u64);
    }
}

fn push_i32_abs(out: mut_view<DiagBuffer>, val: i32) {
    if val < 0 {
        let mag = (0i64 - (val as i64)) as u32;
        diag_buf_push_u32(mut_view(*out), mag);
    } else {
        diag_buf_push_u32(mut_view(*out), val as u32);
    }
}

// Match `opc_names` table in `bootstrap/axiom0/src/target/x64/mir/mi.c` byte-for-byte.
// Note: `mi.c` leaves `AX_X64_MI_MUL`, `AX_X64_MI_TEST`, and `AX_X64_MI_ASSERT` uninitialized (NULL)
// in `opc_names[]`, which `fprintf(out, "  %s", opc_names[mi->opcode])` formats as `"  (null)"`.
fn mi_push_opcode_name(out: mut_view<DiagBuffer>, opc: u32) {
    if opc == X64_MI_MOV {
        mi_push_str(mut_view(*out), 105, 3);
    } else if opc == X64_MI_ADD {
        mi_push_str(mut_view(*out), 108, 3);
    } else if opc == X64_MI_SUB {
        mi_push_str(mut_view(*out), 111, 3);
    } else if opc == X64_MI_IMUL {
        mi_push_str(mut_view(*out), 114, 4);
    } else if opc == X64_MI_IDIV {
        mi_push_str(mut_view(*out), 118, 4);
    } else if opc == X64_MI_AND {
        mi_push_str(mut_view(*out), 122, 3);
    } else if opc == X64_MI_OR {
        mi_push_str(mut_view(*out), 125, 2);
    } else if opc == X64_MI_XOR {
        mi_push_str(mut_view(*out), 127, 3);
    } else if opc == X64_MI_SHL {
        mi_push_str(mut_view(*out), 130, 3);
    } else if opc == X64_MI_SAR {
        mi_push_str(mut_view(*out), 133, 3);
    } else if opc == X64_MI_SHR {
        mi_push_str(mut_view(*out), 136, 3);
    } else if opc == X64_MI_LEA {
        mi_push_str(mut_view(*out), 139, 3);
    } else if opc == X64_MI_CMP {
        mi_push_str(mut_view(*out), 142, 3);
    } else if opc == X64_MI_JMP {
        mi_push_str(mut_view(*out), 145, 3);
    } else if opc == X64_MI_JCC {
        mi_push_str(mut_view(*out), 148, 3);
    } else if opc == X64_MI_CALL {
        mi_push_str(mut_view(*out), 151, 4);
    } else if opc == X64_MI_PUSH {
        mi_push_str(mut_view(*out), 155, 4);
    } else if opc == X64_MI_POP {
        mi_push_str(mut_view(*out), 159, 3);
    } else if opc == X64_MI_SETCC {
        mi_push_str(mut_view(*out), 162, 5);
    } else if opc == X64_MI_RET {
        mi_push_str(mut_view(*out), 167, 3);
    } else {
        mi_push_str(mut_view(*out), 170, 6);
    }
}

pub fn x64_mi_print_op(op: X64Op, out: mut_view<DiagBuffer>) {
    if op.kind == X64_OP_NONE {
    } else if op.kind == X64_OP_REG {
        let r: i32 = op.reg;
        mi_push_reg_name(mut_view(*out), r);
    } else if op.kind == X64_OP_IMM {
        let imm_v: i64 = op.imm;
        push_i64_dec(mut_view(*out), imm_v);
    } else if op.kind == X64_OP_MEM {
        let base_r: i32 = op.mem.base;
        let index_r: i32 = op.mem.index;
        let scale_u: u8 = op.mem.scale;
        let disp_i32: i32 = op.mem.disp;
        let is_rip: bool = op.mem.is_rip;
        diag_buf_push_byte(mut_view(*out), 91u8); // '['
        let mut first = true;
        if is_rip {
            mi_push_str(mut_view(*out), 48, 3); // "rip"
            first = false;
        } else if base_r != REG_NONE && base_r >= 0 && base_r <= 15 {
            mi_push_reg_name(mut_view(*out), base_r);
            first = false;
        }
        if index_r != REG_NONE && index_r >= 0 && index_r <= 15 {
            if !first {
                mi_push_str(mut_view(*out), 51, 3); // " + "
            }
            mi_push_reg_name(mut_view(*out), index_r);
            if scale_u > 1u8 {
                diag_buf_push_byte(mut_view(*out), 42u8); // '*'
                let factor = if scale_u == 3u8 { 8u32 } else { scale_u as u32 };
                diag_buf_push_u32(mut_view(*out), factor);
            }
            first = false;
        }
        if disp_i32 != 0 || first {
            if !first {
                if disp_i32 > 0 {
                    mi_push_str(mut_view(*out), 51, 3); // " + "
                    push_i32_abs(mut_view(*out), disp_i32);
                } else {
                    mi_push_str(mut_view(*out), 54, 3); // " - "
                    push_i32_abs(mut_view(*out), disp_i32);
                }
            } else {
                push_i64_dec(mut_view(*out), disp_i32 as i64);
            }
        }
        diag_buf_push_byte(mut_view(*out), 93u8); // ']'
    } else if op.kind == X64_OP_FRAME {
        let sid: u32 = op.frame.slot_id;
        let off: i32 = op.frame.offset;
        mi_push_str(mut_view(*out), 57, 7); // "[frame#"
        diag_buf_push_u32(mut_view(*out), sid);
        if off >= 0 {
            mi_push_str(mut_view(*out), 51, 3); // " + "
            push_i32_abs(mut_view(*out), off);
        } else {
            mi_push_str(mut_view(*out), 54, 3); // " - "
            push_i32_abs(mut_view(*out), off);
        }
        diag_buf_push_byte(mut_view(*out), 93u8); // ']'
    } else if op.kind == X64_OP_SYM {
        let sym_v: u32 = op.sym;
        mi_push_str(mut_view(*out), 64, 4); // "sym#"
        diag_buf_push_u32(mut_view(*out), sym_v);
    }
}

pub fn x64_mi_print_inst(mi: view<X64MI>, out: mut_view<DiagBuffer>) {
    mi_push_str(mut_view(*out), 68, 2); // "  "
    if mi.opcode == X64_MI_CMOVCC {
        mi_push_str(mut_view(*out), 183, 6);
    } else if mi.opcode == X64_MI_MUL && mi.msg_len != 0 {
        mi_push_str(mut_view(*out), 176, 3);
    } else if mi.opcode == X64_MI_TEST && mi.msg_len != 0 {
        mi_push_str(mut_view(*out), 179, 4);
    } else {
        mi_push_opcode_name(mut_view(*out), mi.opcode);
    }
    let mut i: u8 = 0u8;
    while i < mi.op_count {
        if i == 0u8 {
            diag_buf_push_byte(mut_view(*out), 32u8); // ' '
        } else {
            mi_push_str(mut_view(*out), 70, 2); // ", "
        }
        x64_mi_print_op(mi.ops[i as usize], mut_view(*out));
        i = i + 1u8;
    }
    diag_buf_push_byte(mut_view(*out), 10u8); // '\n'
}

pub fn x64_mi_print(body: view<X64MIBody>, out: mut_view<DiagBuffer>) {
    mi_push_str(mut_view(*out), 72, 18); // "frame_req: shadow="
    diag_buf_push_u32(mut_view(*out), body.shadow_space);
    mi_push_str(mut_view(*out), 90, 11); // " args_size="
    diag_buf_push_u32(mut_view(*out), body.stack_args_size);
    diag_buf_push_byte(mut_view(*out), 10u8);

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let bb_id = unsafe { (*bb).id };
        mi_push_str(mut_view(*out), 101, 2); // "bb"
        diag_buf_push_u32(mut_view(*out), bb_id);
        mi_push_str(mut_view(*out), 103, 2); // ":\n"
        let mut curr = unsafe { (*bb).first_inst };
        while (curr as usize) != 0 {
            unsafe {
                x64_mi_print_inst(view(*curr), mut_view(*out));
                curr = (*curr).next;
            }
        }
        b = b + 1;
    }
}

pub fn ax_x64_mi_print(body: view<X64MIBody>, out: mut_view<DiagBuffer>) {
    x64_mi_print(body, mut_view(*out));
}

// =============================================================================
// 3. Instruction Selection (target/x64/isel/isel.c)
// =============================================================================

fn isel_type_is_ret_in_mem(ret_size: u32) -> bool {
    ret_size > 8u32 || (ret_size != 1u32 && ret_size != 2u32 && ret_size != 4u32 && ret_size != 8u32 && ret_size != 0u32)
}

fn isel_chunk_size(rem: u32) -> u32 {
    if rem >= 8u32 {
        8u32
    } else if rem >= 4u32 {
        4u32
    } else if rem >= 2u32 {
        2u32
    } else {
        1u32
    }
}

pub fn x64_reg_class_for_kind(ty_kind: u8, byte_size: u32) -> u8 {
    if ty_kind == 100u8 {
        REG_CLASS_XMM
    } else if ty_kind == 101u8 || (ty_kind == 102u8 && byte_size == 16u32) {
        REG_CLASS_VEC128
    } else if ty_kind == 103u8 || (ty_kind == 102u8 && byte_size == 32u32) {
        REG_CLASS_VEC256
    } else {
        REG_CLASS_GPR
    }
}

// Per-compile cached type size / align / classification flags stored in `interner.scratch[2].args`
// (same arena-backed slot pattern as `LirSymCache` / `BackendSymCache`).
// Flag bits:
//   bit 0 (0x01): entry populated
//   bit 1 (0x02): is_signed_int
//   bit 2 (0x04): can_prop_const
//   bit 3 (0x08): is_bool
//   bits 4..5:    reg_class (0=GPR, 1=XMM, 2=VEC128, 3=VEC256)
const X64_TF_CACHED: u8 = 1u8;
const X64_TF_SIGNED: u8 = 2u8;
const X64_TF_PROP_CONST: u8 = 4u8;
const X64_TF_BOOL: u8 = 8u8;

struct X64TypeLayoutCache {
    cap: usize,
    sizes: *mut u32,
    aligns: *mut u32,
    flags: *mut u8,
}

fn x64_get_layout_cache(interner: view<TypeInterner>) -> *mut X64TypeLayoutCache {
    if interner.t_u128.v != 0x3FFF0129u32 || (interner.scratch as usize) == 0 {
        return 0 as *mut X64TypeLayoutCache;
    }
    let slot_ty = ((interner.scratch as usize) + lir_mul_usize(2, size_of<AxType>())) as *mut AxType;
    let mut c = (unsafe { (*slot_ty).args }) as *mut X64TypeLayoutCache;
    if (c as usize) == 0 {
        let arena = unsafe { address_of(interner.arena.head) as *mut Arena };
        c = unsafe {
            arena_alloc_raw(mut_view(*arena), size_of<X64TypeLayoutCache>(), align_of<X64TypeLayoutCache>()) as *mut X64TypeLayoutCache
        };
        unsafe {
            (*c).cap = 0;
            (*c).sizes = 0 as *mut u32;
            (*c).aligns = 0 as *mut u32;
            (*c).flags = 0 as *mut u8;
            (*slot_ty).args = c as *mut TypeId;
        }
    }
    c
}

fn x64_layout_cache_populate(
    c: *mut X64TypeLayoutCache,
    ty_v: u32,
    interner: view<TypeInterner>
) -> usize {
    let idx = ty_v as usize;
    let cur_cap = unsafe { (*c).cap };
    if idx >= cur_cap {
        let mut new_cap = if cur_cap == 0 { 256 } else { cur_cap };
        while new_cap <= idx {
            new_cap = new_cap + new_cap;
        }
        let arena = unsafe { address_of(interner.arena.head) as *mut Arena };
        let new_sizes = unsafe { arena_alloc_raw(mut_view(*arena), new_cap << 2, 4) as *mut u32 };
        let new_aligns = unsafe { arena_alloc_raw(mut_view(*arena), new_cap << 2, 4) as *mut u32 };
        let new_flags = unsafe { arena_alloc_raw(mut_view(*arena), new_cap, 1) };
        if cur_cap > 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>((*c).sizes as *const u8, new_sizes as *mut u8, cur_cap << 2);
                ptr_copy_nonoverlapping<u8>((*c).aligns as *const u8, new_aligns as *mut u8, cur_cap << 2);
                ptr_copy_nonoverlapping<u8>((*c).flags as *const u8, new_flags, cur_cap);
            }
        }
        let mut z = cur_cap;
        while z < new_cap {
            unsafe { *(((new_flags as usize) + z) as *mut u8) = 0u8; }
            z = z + 1;
        }
        unsafe {
            (*c).sizes = new_sizes;
            (*c).aligns = new_aligns;
            (*c).flags = new_flags;
            (*c).cap = new_cap;
        }
    }
    let fp = ((unsafe { (*c).flags as usize }) + idx) as *mut u8;
    if (unsafe { *fp }) == 0u8 {
        let sz = type_size(TypeId { v: ty_v }, interner);
        let al = type_align(TypeId { v: ty_v }, interner);
        let t = type_get(interner, TypeId { v: ty_v });
        let mut tk: u8 = 0u8;
        if (t as usize) != 0 {
            tk = unsafe { (*t).kind };
        }
        let rc = x64_reg_class_for_kind(tk, sz);
        let mut fl: u8 = X64_TF_CACHED | ((rc & 3u8) << 4u8);
        if tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE || tk == TY_INT_VAR {
            fl = fl | X64_TF_SIGNED;
        }
        if tk == TY_BOOL {
            fl = fl | X64_TF_BOOL;
        }
        if (tk == TY_BOOL || tk == TY_CHAR ||
            (tk >= TY_I8 && tk <= TY_ISIZE) ||
            (tk >= TY_U8 && tk <= TY_USIZE) ||
            tk == TY_INT_VAR || tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW) &&
           (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) &&
           rc == REG_CLASS_GPR {
            fl = fl | X64_TF_PROP_CONST;
        }
        unsafe {
            *(((((*c).sizes) as usize) + (idx << 2)) as *mut u32) = sz;
            *(((((*c).aligns) as usize) + (idx << 2)) as *mut u32) = al;
            *fp = fl;
        }
    }
    idx
}

pub fn x64_cached_type_size(ty: TypeId, interner: view<TypeInterner>) -> u32 {
    let ty_v = ty.v;
    if ty_v == 0u32 {
        return 0u32;
    }
    if ty_v == 0x3FFF0128u32 || ty_v == 0x3FFF0129u32 {
        return 16u32;
    }
    if (ty_v as usize) <= interner.len {
        let c = x64_get_layout_cache(interner);
        if (c as usize) != 0 {
            let idx = ty_v as usize;
            if idx < (unsafe { (*c).cap }) && (unsafe { *(((((*c).flags) as usize) + idx) as *mut u8) }) != 0u8 {
                return unsafe { *(((((*c).sizes) as usize) + (idx << 2)) as *mut u32) };
            }
            let _ = x64_layout_cache_populate(c, ty_v, interner);
            return unsafe { *(((((*c).sizes) as usize) + (idx << 2)) as *mut u32) };
        }
    }
    type_size(TypeId { v: ty_v }, interner)
}

pub fn x64_cached_type_align(ty: TypeId, interner: view<TypeInterner>) -> u32 {
    let ty_v = ty.v;
    if ty_v == 0u32 {
        return 1u32;
    }
    if ty_v == 0x3FFF0128u32 || ty_v == 0x3FFF0129u32 {
        return 16u32;
    }
    if (ty_v as usize) <= interner.len {
        let c = x64_get_layout_cache(interner);
        if (c as usize) != 0 {
            let idx = ty_v as usize;
            if idx < (unsafe { (*c).cap }) && (unsafe { *(((((*c).flags) as usize) + idx) as *mut u8) }) != 0u8 {
                return unsafe { *(((((*c).aligns) as usize) + (idx << 2)) as *mut u32) };
            }
            let _ = x64_layout_cache_populate(c, ty_v, interner);
            return unsafe { *(((((*c).aligns) as usize) + (idx << 2)) as *mut u32) };
        }
    }
    type_align(TypeId { v: ty_v }, interner)
}

pub fn x64_cached_type_size_and_rc(ty: TypeId, interner: view<TypeInterner>, out_rc: mut_view<u8>) -> u32 {
    let ty_v = ty.v;
    if ty_v == 0u32 {
        *out_rc = REG_CLASS_GPR;
        return 0u32;
    }
    if ty_v == 0x3FFF0128u32 || ty_v == 0x3FFF0129u32 {
        *out_rc = REG_CLASS_GPR;
        return 16u32;
    }
    if (ty_v as usize) <= interner.len {
        let c = x64_get_layout_cache(interner);
        if (c as usize) != 0 {
            let idx = ty_v as usize;
            if idx >= (unsafe { (*c).cap }) || (unsafe { *(((((*c).flags) as usize) + idx) as *mut u8) }) == 0u8 {
                let _ = x64_layout_cache_populate(c, ty_v, interner);
            }
            let fl = unsafe { *(((((*c).flags) as usize) + idx) as *mut u8) };
            *out_rc = (fl >> 4u8) & 3u8;
            return unsafe { *(((((*c).sizes) as usize) + (idx << 2)) as *mut u32) };
        }
    }
    let t = type_get(interner, TypeId { v: ty_v });
    let k: u8 = if (t as usize) != 0 { unsafe { (*t).kind } } else { 0u8 };
    let sz = type_size(TypeId { v: ty_v }, interner);
    *out_rc = x64_reg_class_for_kind(k, sz);
    sz
}

fn x64_cached_type_flags(ty_v: u32, interner: view<TypeInterner>) -> u8 {
    if ty_v == 0u32 || ty_v == 0x3FFF0128u32 || ty_v == 0x3FFF0129u32 {
        return 0u8;
    }
    if (ty_v as usize) <= interner.len {
        let c = x64_get_layout_cache(interner);
        if (c as usize) != 0 {
            let idx = ty_v as usize;
            if idx >= (unsafe { (*c).cap }) || (unsafe { *(((((*c).flags) as usize) + idx) as *mut u8) }) == 0u8 {
                let _ = x64_layout_cache_populate(c, ty_v, interner);
            }
            return unsafe { *(((((*c).flags) as usize) + idx) as *mut u8) };
        }
    }
    let t = type_get(interner, TypeId { v: ty_v });
    if (t as usize) == 0 {
        return 0u8;
    }
    let tk = unsafe { (*t).kind };
    let sz = type_size(TypeId { v: ty_v }, interner);
    let rc = x64_reg_class_for_kind(tk, sz);
    let mut fl: u8 = X64_TF_CACHED | ((rc & 3u8) << 4u8);
    if tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE || tk == TY_INT_VAR {
        fl = fl | X64_TF_SIGNED;
    }
    if tk == TY_BOOL {
        fl = fl | X64_TF_BOOL;
    }
    if (tk == TY_BOOL || tk == TY_CHAR ||
        (tk >= TY_I8 && tk <= TY_ISIZE) ||
        (tk >= TY_U8 && tk <= TY_USIZE) ||
        tk == TY_INT_VAR || tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW) &&
       (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) &&
       rc == REG_CLASS_GPR {
        fl = fl | X64_TF_PROP_CONST;
    }
    fl
}

pub fn x64_reg_class_for_type(ty: TypeId, interner: view<TypeInterner>) -> u8 {
    let mut rc: u8 = REG_CLASS_GPR;
    let _ = x64_cached_type_size_and_rc(TypeId { v: ty.v }, interner, mut_view(rc));
    rc
}

fn isel_type_is_signed_int(ty_id: TypeId, interner: view<TypeInterner>) -> bool {
    (x64_cached_type_flags(ty_id.v, interner) & X64_TF_SIGNED) != 0u8
}

fn isel_emit_trunc(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    ty: TypeId,
    interner: view<TypeInterner>,
    scratch_reg: i32
) {
    let ty_v = ty.v;
    let size = x64_cached_type_size(TypeId { v: ty_v }, interner);
    if size >= 8u32 || size == 0u32 {
        return;
    }
    let is_signed = (x64_cached_type_flags(ty_v, interner) & X64_TF_SIGNED) != 0u8;

    if size == 1u32 {
        if is_signed {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, scratch_reg, 56i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, scratch_reg, 56i64);
        } else {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, scratch_reg, 0xFFi64);
        }
    } else if size == 2u32 {
        if is_signed {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, scratch_reg, 48i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, scratch_reg, 48i64);
        } else {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, scratch_reg, 0xFFFFi64);
        }
    } else if size == 4u32 {
        if is_signed {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, scratch_reg, 32i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, scratch_reg, 32i64);
        } else {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, scratch_reg, 32i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, scratch_reg, 32i64);
        }
    }
}

fn isel_vreg_ty(lir: view<LirBody>, vreg_idx: u32) -> TypeId {
    if (vreg_idx as usize) < lir.vreg_count && (lir.vregs as usize) != 0 {
        let v = unsafe { (*(((lir.vregs as usize) + ((vreg_idx as usize) * size_of<LirVReg>())) as *const LirVReg)).ty.v };
        return TypeId { v: v };
    }
    TypeId { v: 0u32 }
}

fn isel_slot0_ty(lir: view<LirBody>) -> TypeId {
    let mut res = TypeId { v: 0u32 };
    if lir.slot_count > 0 && (lir.slots as usize) != 0 {
        let sp = unsafe { lir_slot_at(lir.slots, 0) };
        let v = unsafe { (*sp).ty.v };
        res = TypeId { v: v };
    }
    res
}

fn isel_icmp_cc(kind: u8) -> u8 {
    if kind == LIR_INST_ICMP_NE {
        CC_NE
    } else if kind == LIR_INST_ICMP_SLT {
        CC_L
    } else if kind == LIR_INST_ICMP_SLE {
        CC_LE
    } else if kind == LIR_INST_ICMP_SGT {
        CC_G
    } else if kind == LIR_INST_ICMP_SGE {
        CC_GE
    } else if kind == LIR_INST_ICMP_ULT {
        CC_B
    } else if kind == LIR_INST_ICMP_ULE {
        CC_BE
    } else if kind == LIR_INST_ICMP_UGT {
        CC_A
    } else if kind == LIR_INST_ICMP_UGE {
        CC_AE
    } else {
        CC_E
    }
}

fn isel_emit_uoverflow(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    bw: u32,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let is_64 = bw == 64u32;
    // Matches isel.c lines 213-290 (using reg 0, reg 2, reg 3, and R8..R11 for 64-bit umul)
    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 0, slot_offset + lhs_v, 0);
    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 2, slot_offset + rhs_v, 0);
    if !is_64 {
        let mut mask: i64 = 0i64;
        let mut uint_max: i64 = 0i64;
        if bw == 8u32 {
            mask = 0xFFi64;
            uint_max = 0xFFi64;
        } else if bw == 16u32 {
            mask = 0xFFFFi64;
            uint_max = 0xFFFFi64;
        } else if bw == 32u32 {
            mask = 0xFFFFFFFFi64;
            uint_max = 0xFFFFFFFFi64;
        }
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 3, mask);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_AND, 0, 3);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_AND, 2, 3);
        if kind == LIR_INST_UADD_OVERFLOW {
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, 0, 2);
        } else if kind == LIR_INST_USUB_OVERFLOW {
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, 0, 2);
        } else {
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, 0, 2);
        }
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 3, uint_max);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, 0, 3);
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_A as i64, 0);
    } else {
        if kind == LIR_INST_UADD_OVERFLOW {
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, 0, 2);
            isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_B as i64, 0);
        } else if kind == LIR_INST_USUB_OVERFLOW {
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, 0, 2);
            isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_B as i64, 0);
        } else {
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R8, 0);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_R8, 32i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_R8, 32i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R9, 0);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_R9, 32i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R10, 2);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_R10, 32i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_R10, 32i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R11, 2);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_R11, 32i64);

            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 0, REG_R9);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, 0, REG_R11);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 1, REG_R9);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, 1, REG_R10);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 2, REG_R8);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, 2, REG_R11);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, REG_R8, REG_R10);

            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R9, 1);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_R9, 32i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_OR, 0, REG_R9);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R9, 2);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_R9, 32i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_OR, 0, REG_R9);

            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, 1, 32i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, 1, 32i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, 2, 32i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, 2, 32i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_R8, 32i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, 1, 2);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, 1, REG_R8);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, 1, 32i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_OR, 0, 1);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, 0, 0i64);
            isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_NE as i64, 0);
        }
    }
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, 0, 1i64);
    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, 0);
}

fn isel_emit_soverflow(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    bw: u32,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let is_64 = bw == 64u32;
    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + lhs_v, 0);
    if kind == LIR_INST_SADD_OVERFLOW {
        isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, REG_RAX, slot_offset + rhs_v, 0);
    } else if kind == LIR_INST_SSUB_OVERFLOW {
        isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, slot_offset + rhs_v, 0);
    } else {
        isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, REG_RAX, slot_offset + rhs_v, 0);
    }
    if is_64 {
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_O as i64, REG_RAX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, 1i64);
    } else {
        let mut int_min: i64 = -2147483648i64;
        let mut int_max: i64 = 2147483647i64;
        if bw == 8u32 {
            int_min = -128i64;
            int_max = 127i64;
        } else if bw == 16u32 {
            int_min = -32768i64;
            int_max = 32767i64;
        }
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, int_min);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, REG_RDX);
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_L as i64, REG_RCX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RCX, 1i64);

        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, int_max);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, REG_RDX);
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_G as i64, REG_RAX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, 1i64);

        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_OR, REG_RAX, REG_RCX);
    }
    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
}

fn isel_emit_udiv_urem(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R8, slot_offset + lhs_v, 0);
    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R9, slot_offset + rhs_v, 0);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R10, REG_R9);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_R10, 63i64);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R11, REG_R10);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_R11, 1i64);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, REG_R8);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_RAX, 1i64);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, REG_R11);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, 0i64);
    isel_mi_r(mut_view(*mi), mut_view(*mbb), X64_MI_IDIV, REG_R9);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_RAX, 1i64);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_RDX, 1i64);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R11, 0i64);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_R11, REG_R10);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_OR, REG_R11, 1i64);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_R8, REG_R11);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_OR, REG_RDX, REG_R8);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RDX, REG_R9);
    isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_AE as i64, REG_RCX);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RCX, 1i64);
    if kind == LIR_INST_UDIV {
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, REG_RAX, REG_RCX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    } else {
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R11, 0i64);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_R11, REG_RCX);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_R9, REG_R11);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RDX, REG_R9);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RDX);
    }
}

fn isel_atomic_sz(inst: *const LirInst, interner: view<TypeInterner>) -> u8 {
    let bw = unsafe { (*inst).bit_width };
    if bw == 8u32 { return 1u8; }
    if bw == 16u32 { return 2u8; }
    if bw == 32u32 { return 4u8; }
    if bw == 64u32 { return 8u8; }
    let ty_v = unsafe { (*inst).ty.v };
    let s = x64_cached_type_size(TypeId { v: ty_v }, interner);
    if s == 1u32 || s == 2u32 || s == 4u32 || s == 8u32 { return s as u8; }
    8u8
}

struct RawIselCtx {
    mi: *mut X64MIBody,
    mbb: *mut X64MIBb,
    vregs: *mut LirVReg,
    vreg_count: usize,
    slot_offset: u32,
}

fn isel_cx_vreg_ty(cx: *const RawIselCtx, vreg_idx: u32) -> TypeId {
    let mut res = TypeId { v: 0u32 };
    if (vreg_idx as usize) < (unsafe { (*cx).vreg_count }) && (unsafe { (*cx).vregs as usize }) != 0 {
        let vp = unsafe { lir_vreg_at((*cx).vregs, vreg_idx as usize) };
        let v = unsafe { (*vp).ty.v };
        res = TypeId { v: v };
    }
    res
}

fn isel_emit_sym_addr(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    dest_slot: u32,
    inst: *const LirInst
) {
    let sym_name = unsafe { (*inst).sym_name };
    let sym_len = unsafe { (*inst).sym_len };
    let opc = if (unsafe { (*inst).kind }) == LIR_INST_TLS_ADDR { X64_MI_TLS_ADDR } else { X64_MI_LEA };
    let mi_inst = isel_mi_rsym(mut_view(*mi), mut_view(*mbb), opc, REG_RAX, 0u32);
    unsafe {
        (*mi_inst).msg = sym_name;
        (*mi_inst).msg_len = sym_len;
    }
    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, dest_slot, 0, REG_RAX);
}

fn isel_raw_lower_arith(cx: *mut RawIselCtx, inst: *const LirInst, interner: view<TypeInterner>) -> bool {
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let lhs_v = unsafe { (*inst).lhs.v };
    let rhs_v = unsafe { (*inst).rhs.v };
    let operand_v = unsafe { (*inst).operand.v };
    let mi = unsafe { (*cx).mi };
    let mbb = unsafe { (*cx).mbb };
    let slot_offset = unsafe { (*cx).slot_offset };

    if kind == LIR_INST_ADD || kind == LIR_INST_SUB || kind == LIR_INST_BIT_AND || kind == LIR_INST_BIT_OR || kind == LIR_INST_BIT_XOR || kind == LIR_INST_MUL {
        let opc = if kind == LIR_INST_ADD {
            X64_MI_ADD
        } else if kind == LIR_INST_SUB {
            X64_MI_SUB
        } else if kind == LIR_INST_BIT_AND {
            X64_MI_AND
        } else if kind == LIR_INST_BIT_OR {
            X64_MI_OR
        } else if kind == LIR_INST_BIT_XOR {
            X64_MI_XOR
        } else {
            X64_MI_IMUL
        };
        let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
        unsafe {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + lhs_v, 0);
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), opc, REG_RAX, slot_offset + rhs_v, 0);
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        }
        return true;
    } else if kind == LIR_INST_SHL || kind == LIR_INST_SHR || kind == LIR_INST_SAR {
        let opc = if kind == LIR_INST_SHL {
            X64_MI_SHL
        } else if kind == LIR_INST_SAR {
            X64_MI_SAR
        } else {
            X64_MI_SHR
        };
        let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
        unsafe {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + lhs_v, 0);
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, slot_offset + rhs_v, 0);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), opc, REG_RAX, REG_RCX);
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        }
        return true;
    } else if kind >= LIR_INST_ICMP_EQ && kind <= LIR_INST_ICMP_UGE {
        let cond = isel_icmp_cc(kind);
        let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
        unsafe {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + lhs_v, 0);
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, slot_offset + rhs_v, 0);
            isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, cond as i64, REG_RAX);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, 0xFFi64);
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        }
        return true;
    } else if kind == LIR_INST_UADD_OVERFLOW || kind == LIR_INST_USUB_OVERFLOW || kind == LIR_INST_UMUL_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        unsafe {
            isel_emit_uoverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
        }
        return true;
    } else if kind == LIR_INST_SADD_OVERFLOW || kind == LIR_INST_SSUB_OVERFLOW || kind == LIR_INST_SMUL_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        unsafe {
            isel_emit_soverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
        }
        return true;
    } else if kind == LIR_INST_UDIV_OVERFLOW || kind == LIR_INST_UREM_OVERFLOW {
        unsafe {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        }
        return true;
    } else if kind == LIR_INST_SDIV_OVERFLOW || kind == LIR_INST_SREM_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        let mut int_min: i64 = (0x8000000000000000u64) as i64;
        if bw == 8u32 {
            int_min = -128i64;
        } else if bw == 16u32 {
            int_min = -32768i64;
        } else if bw == 32u32 {
            int_min = -2147483648i64;
        }
        unsafe {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + lhs_v, 0);
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, slot_offset + rhs_v, 0);

            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RDX, -1i64);
            isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_E as i64, REG_RCX);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RCX, 1i64);

            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, int_min);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, REG_RDX);
            isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_E as i64, REG_RAX);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, 1i64);

            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, REG_RCX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        }
        return true;
    } else if kind == LIR_INST_DIV || kind == LIR_INST_REM {
        let res_reg = if kind == LIR_INST_DIV { REG_RAX } else { REG_RDX };
        unsafe {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + lhs_v, 0);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, REG_RAX);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, REG_RDX, 63i64);
            isel_mi_f(mut_view(*mi), mut_view(*mbb), X64_MI_IDIV, slot_offset + rhs_v, 0);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, res_reg);
        }
        return true;
    } else if kind == LIR_INST_UDIV || kind == LIR_INST_UREM {
        unsafe {
            isel_emit_udiv_urem(mut_view(*mi), mut_view(*mbb), kind, slot_offset, dest_v, lhs_v, rhs_v);
        }
        return true;
    } else if kind == LIR_INST_NEG {
        unsafe {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + operand_v, 0);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, 0i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RCX, REG_RAX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RCX);
        }
        return true;
    } else if kind == LIR_INST_NOT {
        unsafe {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + operand_v, 0);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, REG_RAX, 1i64);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        }
        return true;
    } else if kind == LIR_INST_BITNOT {
        let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
        unsafe {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R10, -1i64);
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_R10, slot_offset + operand_v, 0);
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_R10);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_R10);
        }
        return true;
    }
    false
}

fn isel_raw_lower_abi(cx: *mut RawIselCtx, inst: *const LirInst, interner: view<TypeInterner>) -> bool {
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let mi = unsafe { (*cx).mi };
    let mbb = unsafe { (*cx).mbb };
    let slot_offset = unsafe { (*cx).slot_offset };

    if kind == LIR_INST_ABI_ARG {
        let loc_kind = unsafe { (*inst).loc_kind };
        let loc_ro = unsafe { (*inst).loc_reg_or_offset };
        let val_v = unsafe { (*inst).val.v };
        if dest_v != LIR_VREG_NONE {
            if loc_kind == ABI_LOC_REG {
                unsafe {
                    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, loc_ro as i32);
                }
            } else if loc_kind == ABI_LOC_STACK {
                unsafe {
                    isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 8u8, REG_RAX, REG_RBP, REG_NONE, 1u8, (16u32 + loc_ro) as i32);
                    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
                }
            } else if loc_kind == ABI_LOC_INDIRECT {
                let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
                let size = x64_cached_type_size(dty, interner);
                unsafe {
                    if loc_ro < 16u32 {
                        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, loc_ro as i32);
                    } else {
                        isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 8u8, REG_RAX, REG_RBP, REG_NONE, 1u8, (16u32 + loc_ro) as i32);
                    }
                    let mut off: u32 = 0u32;
                    while off < size {
                        let chunk = isel_chunk_size(size - off);
                        isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, off as i32);
                        isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, slot_offset + dest_v, off as i32, REG_RCX);
                        off = off + chunk;
                    }
                }
            }
        } else {
            if loc_kind == ABI_LOC_REG {
                unsafe {
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, loc_ro as i32, slot_offset + val_v, 0);
                }
            } else if loc_kind == ABI_LOC_STACK {
                unsafe {
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + val_v, 0);
                    isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 8u8, REG_RSP, REG_NONE, 1u8, loc_ro as i32, REG_RAX);
                }
            } else if loc_kind == ABI_LOC_INDIRECT {
                unsafe {
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, REG_RAX, slot_offset + val_v, 0);
                    if loc_ro < 16u32 {
                        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, loc_ro as i32, REG_RAX);
                    } else {
                        isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 8u8, REG_RSP, REG_NONE, 1u8, loc_ro as i32, REG_RAX);
                    }
                }
            }
        }
        return true;
    } else if kind == LIR_INST_CALL {
        let callee_ty_id = unsafe { TypeId { v: (*inst).callee_ty.v } };
        let dst_addr_v = unsafe { (*inst).dst_addr.v };
        let callee_vreg_v = unsafe { (*inst).callee_vreg.v };
        let sym_name = unsafe { (*inst).sym_name };
        let sym_len = unsafe { (*inst).sym_len };

        let callee_ty = type_get(interner, callee_ty_id);
        let mut ret_ty = TypeId { v: 0u32 };
        if (callee_ty as usize) != 0 {
            let ck = unsafe { (*callee_ty).kind };
            if ck == TY_FN {
                ret_ty = unsafe { TypeId { v: (*callee_ty).ret_type.v } };
            } else if ck == TY_CLOSURE {
                let r_v = unsafe { (*callee_ty).ret_type.v };
                if r_v != 0u32 {
                    ret_ty = TypeId { v: r_v };
                } else {
                    let fn_v = unsafe { (*callee_ty).fn_type.v };
                    if fn_v != 0u32 {
                        let fn_t = type_get(interner, TypeId { v: fn_v });
                        if (fn_t as usize) != 0 {
                            ret_ty = unsafe { TypeId { v: (*fn_t).ret_type.v } };
                        }
                    }
                }
            }
        }
        if ret_ty.v != 0u32 {
            let ret_size = x64_cached_type_size(ret_ty, interner);
            if isel_type_is_ret_in_mem(ret_size) {
                unsafe {
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, slot_offset + dst_addr_v, 0);
                }
            }
        }
        unsafe {
            if (sym_name as usize) != 0 {
                let call_mi = isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_CALL);
                (*call_mi).msg = sym_name;
                (*call_mi).msg_len = sym_len;
            } else {
                isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R10, slot_offset + callee_vreg_v, 0);
                isel_mi_r(mut_view(*mi), mut_view(*mbb), X64_MI_CALL, REG_R10);
            }
        }
        return true;
    } else if kind == LIR_INST_ABI_RESULT {
        let loc_kind = unsafe { (*inst).loc_kind };
        let loc_ro = unsafe { (*inst).loc_reg_or_offset };
        if loc_kind == ABI_LOC_REG {
            unsafe {
                isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, loc_ro as i32);
            }
        } else if loc_kind == ABI_LOC_INDIRECT {
            let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
            let mut load_sz = x64_cached_type_size(dty, interner);
            unsafe {
                if load_sz <= 8u32 {
                    if load_sz != 1u32 && load_sz != 2u32 && load_sz != 4u32 && load_sz != 8u32 {
                        load_sz = 8u32;
                    }
                    isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, 0);
                    isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, slot_offset + dest_v, 0, REG_RCX);
                } else {
                    let mut off: u32 = 0u32;
                    while off < load_sz {
                        let chunk = isel_chunk_size(load_sz - off);
                        isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, off as i32);
                        isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, slot_offset + dest_v, off as i32, REG_RCX);
                        off = off + chunk;
                    }
                }
            }
        }
        return true;
    }
    false
}

pub fn x64_isel_raw_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> *mut X64MIBody {
    let mi = x64_mi_body_new(mut_view(*arena), lir.bb_count);
    unsafe {
        (*mi).shadow_space = lir.frame_req.max_outgoing_args_bytes;
        (*mi).stack_args_size = 0u32;
    }

    let slot_offset = lir.slot_count as u32;
    let mut callee_ret_in_mem = false;
    if lir.slot_count > 0 {
        let s0_ty = isel_slot0_ty(lir);
        let ret_size = x64_cached_type_size(s0_ty, interner);
        callee_ret_in_mem = isel_type_is_ret_in_mem(ret_size);
    }

    let mut raw_cx = RawIselCtx {
        mi: mi,
        mbb: 0 as *mut X64MIBb,
        vregs: lir.vregs,
        vreg_count: lir.vreg_count,
        slot_offset: slot_offset,
    };
    let pcx = unsafe { address_of_mut(raw_cx) as *mut RawIselCtx };

    let mut b: usize = 0;
    while b < lir.bb_count {
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let mbb = unsafe { x64_mi_bb_at((*mi).bbs, b) };
        unsafe {
            x64_mi_bb_reset(mut_view(*mbb), b as u32);
            (*pcx).mbb = mbb;
        }

        if b == 0 && callee_ret_in_mem {
            unsafe {
                isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 0u32, 0, REG_RCX);
            }
        }

        let inst_count = unsafe { (*lbb).inst_count };
        let insts_base = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < inst_count {
            let inst = unsafe { lir_inst_at(insts_base, i) };
            let kind = unsafe { (*inst).kind };
            let dest_v = unsafe { (*inst).dest.v };
            let lhs_v = unsafe { (*inst).lhs.v };
            let rhs_v = unsafe { (*inst).rhs.v };

            if kind == LIR_INST_CONST {
                let cval = unsafe { (*inst).const_val as i64 };
                unsafe {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, cval);
                    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
                }
            } else if kind == LIR_INST_CONST_STR {
                let s_bytes = unsafe { (*inst).str_bytes };
                let s_len = unsafe { (*inst).str_len };
                unsafe {
                    let sym_id = x64_mi_add_string(mut_view(*mi), s_bytes, s_len);
                    isel_mi_rsym(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, REG_RAX, sym_id);
                    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, s_len as i64);
                    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 8, REG_RAX);
                }
            } else if kind == LIR_INST_FN_ADDR || kind == LIR_INST_TLS_ADDR {
                unsafe {
                    isel_emit_sym_addr(mut_view(*mi), mut_view(*mbb), slot_offset + dest_v, inst as *const LirInst);
                }
            } else if isel_raw_lower_arith(pcx, inst as *const LirInst, interner) {
                // Lowered by isel_raw_lower_arith
            } else if isel_raw_lower_abi(pcx, inst as *const LirInst, interner) {
                // Lowered by isel_raw_lower_abi
            } else if kind == LIR_INST_STACK_ADDR {
                let slot_v = unsafe { (*inst).slot.v };
                let mut ret_in_mem = false;
                if slot_v == 0u32 && lir.slot_count > 0 {
                    ret_in_mem = callee_ret_in_mem;
                }
                unsafe {
                    if ret_in_mem {
                        isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0u32, 0);
                        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
                    } else {
                        isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, REG_RAX, slot_v, 0);
                        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
                    }
                }
            } else if kind == LIR_INST_LOAD {
                let ptr_v = unsafe { (*inst).ptr.v };
                let load_ty_v = unsafe { (*inst).ty.v };
                let raw_size = x64_cached_type_size(TypeId { v: load_ty_v }, interner);
                unsafe {
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + ptr_v, 0);
                    if raw_size <= 8u32 {
                        let mut load_sz = raw_size;
                        if load_sz != 1u32 && load_sz != 2u32 && load_sz != 4u32 && load_sz != 8u32 {
                            load_sz = 8u32;
                        }
                        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, 0i64);
                        isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, 0);

                        let is_signed = isel_type_is_signed_int(TypeId { v: load_ty_v }, interner);
                        let shr_opc = if is_signed { X64_MI_SAR } else { X64_MI_SHR };
                        if raw_size == 1u32 {
                            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_RCX, 56i64);
                            isel_mi_ri(mut_view(*mi), mut_view(*mbb), shr_opc, REG_RCX, 56i64);
                        } else if raw_size == 2u32 {
                            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_RCX, 48i64);
                            isel_mi_ri(mut_view(*mi), mut_view(*mbb), shr_opc, REG_RCX, 48i64);
                        } else if raw_size == 4u32 {
                            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_RCX, 32i64);
                            isel_mi_ri(mut_view(*mi), mut_view(*mbb), shr_opc, REG_RCX, 32i64);
                        }
                        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RCX);
                    } else {
                        let mut off: u32 = 0u32;
                        while off < raw_size {
                            let chunk = isel_chunk_size(raw_size - off);
                            isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, off as i32);
                            isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, slot_offset + dest_v, off as i32, REG_RCX);
                            off = off + chunk;
                        }
                    }
                }
            } else if kind == LIR_INST_STORE {
                let ptr_v = unsafe { (*inst).ptr.v };
                let val_v = unsafe { (*inst).val.v };
                let val_ty = isel_vreg_ty(lir, val_v);
                let mut size = x64_cached_type_size(val_ty, interner);
                unsafe {
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + ptr_v, 0);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, slot_offset + val_v, 0);
                    if size <= 8u32 {
                        if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                            size = 8u32;
                        }
                        isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, REG_RAX, REG_NONE, 1u8, 0, REG_RCX);
                    } else {
                        let mut off: u32 = 0u32;
                        while off < size {
                            let chunk = isel_chunk_size(size - off);
                            isel_mi_rf_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, slot_offset + val_v, off as i32);
                            isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RAX, REG_NONE, 1u8, off as i32, REG_RCX);
                            off = off + chunk;
                        }
                    }
                }
            } else if kind == LIR_INST_ATOMIC_LOAD {
                let ptr_v = unsafe { (*inst).ptr.v };
                let elem_ty_v = unsafe { (*inst).ty.v };
                let sz = isel_atomic_sz(inst as *const LirInst, interner);
                unsafe {
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + ptr_v, 0);
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, 0i64);
                    isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, sz, REG_RCX, REG_RAX, REG_NONE, 1u8, 0);
                    isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RCX);
                    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RCX);
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                }
            } else if kind == LIR_INST_ATOMIC_STORE {
                let ptr_v = unsafe { (*inst).ptr.v };
                let val_v = unsafe { (*inst).val.v };
                let ord = unsafe { (*inst).ordering };
                let sz = isel_atomic_sz(inst as *const LirInst, interner);
                unsafe {
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + ptr_v, 0);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, slot_offset + val_v, 0);
                    if ord == LIR_ORDER_SEQ_CST {
                        isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_XCHG, sz, REG_RAX, REG_NONE, 1u8, 0, REG_RCX);
                    } else {
                        isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, sz, REG_RAX, REG_NONE, 1u8, 0, REG_RCX);
                    }
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                }
            } else if kind == LIR_INST_ATOMIC_RMW {
                let ptr_v = unsafe { (*inst).ptr.v };
                let val_v = unsafe { (*inst).val.v };
                let elem_ty_v = unsafe { (*inst).ty.v };
                let rmw_op = unsafe { (*inst).rmw_op };
                let sz = isel_atomic_sz(inst as *const LirInst, interner);
                unsafe {
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, slot_offset + ptr_v, 0);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, slot_offset + val_v, 0);
                    if rmw_op == LIR_ATOMIC_RMW_XCHG {
                        isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_XCHG, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RDX);
                        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RDX);
                        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RDX);
                    } else if rmw_op == LIR_ATOMIC_RMW_ADD {
                        isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_XADD, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RDX);
                        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RDX);
                        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RDX);
                    } else if rmw_op == LIR_ATOMIC_RMW_SUB {
                        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
                        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RDX);
                        isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_XADD, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RAX);
                        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
                        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
                    } else {
                        let loop_mi = isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_ATOMIC_RMW_LOOP, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RDX);
                        (*loop_mi).msg_len = rmw_op as usize;
                        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
                        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
                    }
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                }
            } else if kind == LIR_INST_ATOMIC_CAS {
                let ptr_v = unsafe { (*inst).ptr.v };
                let ok_v = unsafe { (*inst).cas_ok.v };
                let elem_ty_v = unsafe { (*inst).ty.v };
                let sz = isel_atomic_sz(inst as *const LirInst, interner);
                unsafe {
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, slot_offset + ptr_v, 0);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + lhs_v, 0);
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, slot_offset + rhs_v, 0);
                    isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_CMPXCHG, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RDX);
                    isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_E as i64, REG_R8);
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_R8, 1i64);
                    isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
                    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
                    isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + ok_v, 0, REG_R8);
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                }
            } else if kind == LIR_INST_FENCE {
                let is_comp = unsafe { (*inst).is_compiler_only };
                let ord = unsafe { (*inst).ordering };
                unsafe {
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
                    if !is_comp && ord == LIR_ORDER_SEQ_CST {
                        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_MFENCE);
                    }
                }
            } else if kind == LIR_INST_PAUSE {
                unsafe {
                    isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_PAUSE);
                }
            }

            i = i + 1;
        }

        // Terminators
        let term_kind = unsafe { (*lbb).term.kind };
        if term_kind == LIR_TERM_SWITCH {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let t_count = unsafe { (*lbb).term.count };
            let targets_base = unsafe { (*lbb).term.targets };
            let otherwise_v = unsafe { (*lbb).term.otherwise.v };
            unsafe {
                isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R10, slot_offset + cond_v, 0);
                let mut k: usize = 0;
                while k < t_count {
                    let tp = lir_switch_target_at(targets_base, k);
                    let t_val = (*tp).val as i64;
                    let t_bb = (*tp).target.v as i64;
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_R10, t_val);
                    isel_mi_ii(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, CC_E as i64, t_bb);
                    k = k + 1;
                }
                isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, otherwise_v as i64);
            }
        } else if term_kind == LIR_TERM_JCC {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let then_v = unsafe { (*lbb).term.then_target.v };
            let else_v = unsafe { (*lbb).term.else_target.v };
            unsafe {
                isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + cond_v, 0);
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, 0i64);
                isel_mi_ii(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, CC_NE as i64, then_v as i64);
                isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, else_v as i64);
            }
        } else if term_kind == LIR_TERM_ASSERT {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let target_v = unsafe { (*lbb).term.assert_target.v };
            let msg_ptr = unsafe { (*lbb).term.msg_ptr };
            let msg_len = unsafe { (*lbb).term.msg_len };
            unsafe {
                isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + cond_v, 0);
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, 1i64);
                let assert_mi = isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_ASSERT, target_v as i64);
                (*assert_mi).msg = msg_ptr;
                (*assert_mi).msg_len = msg_len;
            }
        } else if term_kind == LIR_TERM_JMP {
            let jmp_v = unsafe { (*lbb).term.jmp_target.v };
            unsafe {
                isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, jmp_v as i64);
            }
        } else if term_kind == LIR_TERM_RETURN {
            let s0_ty = isel_slot0_ty(lir);
            let ret_ty = type_get(interner, s0_ty);
            let mut is_unit = false;
            if (ret_ty as usize) != 0 {
                let rk = unsafe { (*ret_ty).kind };
                if rk == TY_UNIT {
                    is_unit = true;
                }
            }
            unsafe {
                if is_unit {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
                } else {
                    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0u32, 0);
                }
                isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_RET);
            }
        }

        b = b + 1;
    }

    mi
}

// =============================================================================
// 4. Optimized Instruction Selection & Branchless If-Conversion (AXS-MCOPT-010..014)
// =============================================================================

@derive(Copy)
struct IselMagicU64 {
    magic_m: u64,
    shift_s: u32,
    add_flag: bool,
}

@derive(Copy)
struct IselAddrMode {
    base_v: u32,
    index_v: u32,
    scale: u8,
    disp: i32,
}

struct IselOptCtx {
    slot_offset: u32,
    ret_in_mem: bool,
    vreg_count: usize,
    slot_count: usize,
    bb_count: usize,
    def_bb: *mut u32,
    def_idx: *mut usize,
    def_cnt: *mut u32,
    def_inst: *mut *mut LirInst,
    use_cnt: *mut u32,
    cross_bb: *mut u8,
    vreg_alias: *mut u32,
    slot_escaped: *mut u8,
    slot_is_param: *mut u8,
    slot_store_cnt: *mut u32,
    slot_load_cnt: *mut u32,
    slot_const_ok: *mut u8,
    slot_const_val: *mut i64,
    slot_single_bb: *mut u8,
    slot_single_ld_v: *mut u32,
    pred_cnt: *mut u32,
    bb_skip: *mut u8,
    vreg_const_state: *mut u8,
    vreg_const_val: *mut i64,
}

unsafe fn isel_u8_at(base: *mut u8, idx: usize) -> *mut u8 {
    ((base as usize) + idx) as *mut u8
}

unsafe fn isel_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    ((base as usize) + (idx << 2)) as *mut u32
}

unsafe fn isel_usize_at(base: *mut usize, idx: usize) -> *mut usize {
    ((base as usize) + (idx << 3)) as *mut usize
}

unsafe fn isel_i64_at(base: *mut i64, idx: usize) -> *mut i64 {
    ((base as usize) + (idx << 3)) as *mut i64
}

unsafe fn isel_inst_ptr_at(base: *mut *mut LirInst, idx: usize) -> *mut *mut LirInst {
    ((base as usize) + (idx << 3)) as *mut *mut LirInst
}

fn isel_fits_i32(val: i64) -> bool {
    val >= -2147483648i64 && val <= 2147483647i64
}

fn isel_is_pow2_u64(v: u64) -> bool {
    v > 0u64 && (v & (v - 1u64)) == 0u64
}

fn isel_ctz_u64(v: u64) -> u32 {
    let mut x = v;
    let mut n: u32 = 0u32;
    while n < 64u32 && (x & 1u64) == 0u64 {
        x = x >> 1u64;
        n = n + 1u32;
    }
    n
}

fn isel_udiv64(n: u64, d: u64) -> u64 {
    if d == 0u64 {
        return 0u64;
    }
    let mut q: u64 = 0u64;
    let mut r: u64 = 0u64;
    let mut i: u32 = 64u32;
    while i > 0u32 {
        i = i - 1u32;
        let bit = (n >> (i as u64)) & 1u64;
        let r_hi = r >> 63u64;
        r = (r << 1u64) | bit;
        if r_hi != 0u64 || r >= d {
            r = r - d;
            q = q | (1u64 << (i as u64));
        }
    }
    q
}

fn isel_urem64(n: u64, d: u64) -> u64 {
    if d == 0u64 {
        return 0u64;
    }
    let mut r: u64 = 0u64;
    let mut i: u32 = 64u32;
    while i > 0u32 {
        i = i - 1u32;
        let bit = (n >> (i as u64)) & 1u64;
        let r_hi = r >> 63u64;
        r = (r << 1u64) | bit;
        if r_hi != 0u64 || r >= d {
            r = r - d;
        }
    }
    r
}

fn isel_umagic64(d: u64) -> IselMagicU64 {
    let two63: u64 = 0x8000000000000000u64;
    let all_ones: u64 = 0xFFFFFFFFFFFFFFFFu64;
    let neg_d: u64 = (all_ones - d) + 1u64;
    let rem_neg_d = isel_urem64(neg_d, d);
    let nc: u64 = all_ones - rem_neg_d;
    let mut p: u32 = 63u32;
    let mut q1: u64 = isel_udiv64(two63, nc);
    let mut r1: u64 = isel_urem64(two63, nc);
    let mut q2: u64 = isel_udiv64(two63 - 1u64, d);
    let mut r2: u64 = isel_urem64(two63 - 1u64, d);
    let mut add_flag = false;

    while true {
        p = p + 1u32;
        if r1 >= nc - r1 {
            q1 = (q1 << 1u64) | 1u64;
            r1 = r1 - (nc - r1);
        } else {
            q1 = q1 << 1u64;
            r1 = r1 << 1u64;
        }
        if r2 >= (d - 1u64) - r2 {
            if q2 >= 0x7FFFFFFFFFFFFFFFu64 {
                add_flag = true;
            }
            q2 = (q2 << 1u64) | 1u64;
            r2 = r2 - ((d - 1u64) - r2);
        } else {
            if q2 >= two63 {
                add_flag = true;
            }
            q2 = q2 << 1u64;
            r2 = (r2 << 1u64) | 1u64;
        }
        let delta: u64 = d - 1u64 - r2;
        if p >= 128u32 {
            break;
        }
        if q1 > delta || (q1 == delta && r1 != 0u64) {
            break;
        }
    }

    let mag_m: u64 = if q2 == all_ones { 0u64 } else { q2 + 1u64 };
    IselMagicU64 {
        magic_m: mag_m,
        shift_s: p - 64u32,
        add_flag: add_flag,
    }
}

fn isel_tag_range(first_before: *mut X64MI, last_before: *mut X64MI, mbb: view<X64MIBb>, vreg: u32) {
    if vreg == LIR_VREG_NONE {
        return;
    }
    let mut cur: *mut X64MI = 0 as *mut X64MI;
    if (last_before as usize) != 0 {
        cur = unsafe { (*last_before).next };
    } else if (first_before as usize) == 0 {
        cur = mbb.first_inst;
    }
    while (cur as usize) != 0 {
        unsafe {
            (*cur).origin_vreg = vreg;
            cur = (*cur).next;
        }
    }
}

fn isel_resolve_vreg(ctx: view<IselOptCtx>, v: u32) -> u32 {
    let mut cur = v;
    let mut steps: u32 = 0u32;
    let alias_base = ctx.vreg_alias as usize;
    let vcnt = ctx.vreg_count;
    while (cur as usize) < vcnt && steps < 8u32 {
        let next_v = unsafe { *((alias_base + ((cur as usize) << 2)) as *mut u32) };
        if next_v == LIR_VREG_NONE || next_v == cur {
            break;
        }
        cur = next_v;
        steps = steps + 1u32;
    }
    cur
}

fn isel_type_can_prop_const(ty_id: TypeId, interner: view<TypeInterner>) -> bool {
    (x64_cached_type_flags(ty_id.v, interner) & X64_TF_PROP_CONST) != 0u8
}

fn isel_vreg_is_bool(lir: view<LirBody>, interner: view<TypeInterner>, v: u32) -> bool {
    let ty_v = isel_vreg_ty(lir, v).v;
    (x64_cached_type_flags(ty_v, interner) & X64_TF_BOOL) != 0u8
}

fn isel_vreg_is_scalar_gpr(lir: view<LirBody>, interner: view<TypeInterner>, v: u32) -> bool {
    let ty_v = isel_vreg_ty(lir, v).v;
    let mut rc: u8 = REG_CLASS_GPR;
    let sz = x64_cached_type_size_and_rc(TypeId { v: ty_v }, interner, mut_view(rc));
    (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) && rc == REG_CLASS_GPR
}

fn isel_norm_const_to_ty(ty_id: TypeId, interner: view<TypeInterner>, raw_u: u64) -> i64 {
    let ty_v = ty_id.v;
    if ty_v == 0u32 {
        return raw_u as i64;
    }
    let sz = x64_cached_type_size(TypeId { v: ty_v }, interner);
    if sz >= 8u32 {
        return raw_u as i64;
    }
    let is_signed = (x64_cached_type_flags(ty_v, interner) & X64_TF_SIGNED) != 0u8;
    if sz == 1u32 {
        let b = (raw_u & 0xFFu64) as i64;
        if is_signed && (b & 0x80i64) != 0i64 {
            return b - 256i64;
        }
        return b;
    } else if sz == 2u32 {
        let w = (raw_u & 0xFFFFu64) as i64;
        if is_signed && (w & 0x8000i64) != 0i64 {
            return w - 65536i64;
        }
        return w;
    } else if sz == 4u32 {
        let d = (raw_u & 0xFFFFFFFFu64) as i64;
        if is_signed && (d & 0x80000000i64) != 0i64 {
            return d - 4294967296i64;
        }
        return d;
    }
    raw_u as i64
}

fn isel_const_inst_val(
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    inst: *const LirInst,
    dest_v: u32
) -> i64 {
    let raw_u = unsafe { (*inst).const_val };
    let inst_ty_v = unsafe { (*inst).ty.v };
    let dst_ty_v = isel_vreg_ty(lir, dest_v).v;
    if inst_ty_v != dst_ty_v && dst_ty_v != 0u32 {
        return isel_norm_const_to_ty(TypeId { v: dst_ty_v }, interner, raw_u);
    }
    raw_u as i64
}

fn isel_vreg_const(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    v: u32,
    out_val: mut_view<i64>
) -> bool {
    let vu = v as usize;
    let use_cache = (ctx.vreg_const_state as usize) != 0 && vu < ctx.vreg_count;
    if use_cache {
        let st = unsafe { *(((ctx.vreg_const_state as usize) + vu) as *mut u8) };
        if st == 1u8 {
            return false;
        }
        if st == 2u8 {
            *out_val = unsafe { *(((ctx.vreg_const_val as usize) + (vu << 3)) as *mut i64) };
            return true;
        }
    }
    let rv = isel_resolve_vreg(ctx, v);
    let rvu = rv as usize;
    if rvu >= ctx.vreg_count {
        if use_cache { unsafe { *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 1u8; } }
        return false;
    }
    if (unsafe { *(((ctx.def_cnt as usize) + (rvu << 2)) as *mut u32) }) != 1u32 {
        if use_cache { unsafe { *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 1u8; } }
        return false;
    }
    let inst = unsafe { *(((ctx.def_inst as usize) + (rvu << 3)) as *mut *mut LirInst) };
    if (inst as usize) == 0 {
        if use_cache { unsafe { *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 1u8; } }
        return false;
    }
    let k = unsafe { (*inst).kind };
    if k != LIR_INST_CONST && k != LIR_INST_NEG && k != LIR_INST_LOAD {
        if use_cache { unsafe { *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 1u8; } }
        return false;
    }
    let v_ty_v = isel_vreg_ty(lir, v).v;
    let rv_ty_v = isel_vreg_ty(lir, rv).v;
    if k == LIR_INST_CONST {
        let c0 = isel_const_inst_val(lir, interner, inst as *const LirInst, rv);
        let res = if v_ty_v != rv_ty_v && v_ty_v != 0u32 {
            isel_norm_const_to_ty(TypeId { v: v_ty_v }, interner, c0 as u64)
        } else {
            c0
        };
        *out_val = res;
        if use_cache {
            unsafe {
                *(((ctx.vreg_const_val as usize) + (vu << 3)) as *mut i64) = res;
                *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 2u8;
            }
        }
        return true;
    }
    if k == LIR_INST_NEG {
        let op_v = unsafe { (*inst).operand.v };
        let mut inner: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, op_v, mut_view(inner)) {
            let iu: u64 = inner as u64;
            let neg_u: u64 = if iu == 0u64 { 0u64 } else { (0xFFFFFFFFFFFFFFFFu64 - iu) + 1u64 };
            let c1 = isel_norm_const_to_ty(TypeId { v: rv_ty_v }, interner, neg_u);
            let res = if v_ty_v != rv_ty_v && v_ty_v != 0u32 {
                isel_norm_const_to_ty(TypeId { v: v_ty_v }, interner, c1 as u64)
            } else {
                c1
            };
            *out_val = res;
            if use_cache {
                unsafe {
                    *(((ctx.vreg_const_val as usize) + (vu << 3)) as *mut i64) = res;
                    *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 2u8;
                }
            }
            return true;
        }
        if use_cache { unsafe { *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 1u8; } }
        return false;
    }
    let ptr_v = unsafe { (*inst).ptr.v };
    let pvu = ptr_v as usize;
    if pvu < ctx.vreg_count && (unsafe { *(((ctx.def_cnt as usize) + (pvu << 2)) as *mut u32) }) == 1u32 {
        let pinst = unsafe { *(((ctx.def_inst as usize) + (pvu << 3)) as *mut *mut LirInst) };
        if (pinst as usize) != 0 && (unsafe { (*pinst).kind }) == LIR_INST_STACK_ADDR {
            let s = unsafe { (*pinst).slot.v as usize };
            if s > 0 && s < ctx.slot_count && (unsafe { *(((ctx.slot_const_ok as usize) + s) as *mut u8) }) != 0u8 {
                let raw_slot = (unsafe { *(((ctx.slot_const_val as usize) + (s << 3)) as *mut i64) }) as u64;
                let slot_ty = unsafe { (*lir_slot_at(lir.slots, s)).ty };
                let ld_ty = unsafe { (*inst).ty };
                let c0 = isel_norm_const_to_ty(slot_ty, interner, raw_slot);
                let c1 = isel_norm_const_to_ty(ld_ty, interner, c0 as u64);
                let c2 = isel_norm_const_to_ty(TypeId { v: rv_ty_v }, interner, c1 as u64);
                let res = isel_norm_const_to_ty(TypeId { v: v_ty_v }, interner, c2 as u64);
                *out_val = res;
                if use_cache {
                    unsafe {
                        *(((ctx.vreg_const_val as usize) + (vu << 3)) as *mut i64) = res;
                        *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 2u8;
                    }
                }
                return true;
            }
        }
    }
    if use_cache { unsafe { *(((ctx.vreg_const_state as usize) + vu) as *mut u8) = 1u8; } }
    false
}

fn isel_vreg_is_stack_addr(ctx: view<IselOptCtx>, ptr_v: u32, out_slot: mut_view<u32>) -> bool {
    let pvu = ptr_v as usize;
    if pvu >= ctx.vreg_count {
        return false;
    }
    if (unsafe { *(((ctx.def_cnt as usize) + (pvu << 2)) as *mut u32) }) != 1u32 {
        return false;
    }
    let pinst = unsafe { *(((ctx.def_inst as usize) + (pvu << 3)) as *mut *mut LirInst) };
    if (pinst as usize) == 0 || (unsafe { (*pinst).kind }) != LIR_INST_STACK_ADDR {
        return false;
    }
    let sv = unsafe { (*pinst).slot.v };
    if (sv as usize) >= ctx.slot_count {
        return false;
    }
    if sv == 0u32 && ctx.ret_in_mem {
        return false;
    }
    *out_slot = sv;
    true
}

fn isel_match_scaled_index(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    v: u32,
    cur_bb: u32,
    out_idx: mut_view<u32>,
    out_scale: mut_view<u8>
) -> bool {
    let rv = isel_resolve_vreg(ctx, v);
    let rvu = rv as usize;
    if rvu >= ctx.vreg_count {
        return false;
    }
    if (unsafe { *(((ctx.def_cnt as usize) + (rvu << 2)) as *mut u32) }) != 1u32 {
        return false;
    }
    if (unsafe { *(((ctx.def_bb as usize) + (rvu << 2)) as *mut u32) }) != cur_bb {
        return false;
    }
    let ty_id = isel_vreg_ty(lir, rv);
    if x64_cached_type_size(ty_id, interner) != 8u32 {
        return false;
    }
    let inst = unsafe { *(((ctx.def_inst as usize) + (rvu << 3)) as *mut *mut LirInst) };
    if (inst as usize) == 0 {
        return false;
    }
    let k = unsafe { (*inst).kind };
    if k == LIR_INST_MUL {
        let lhs_v = unsafe { (*inst).lhs.v };
        let rhs_v = unsafe { (*inst).rhs.v };
        let mut c: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(c)) {
            if c == 1i64 || c == 2i64 || c == 4i64 || c == 8i64 {
                *out_idx = isel_resolve_vreg(ctx, lhs_v);
                *out_scale = c as u8;
                return true;
            }
        }
        if isel_vreg_const(ctx, lir, interner, lhs_v, mut_view(c)) {
            if c == 1i64 || c == 2i64 || c == 4i64 || c == 8i64 {
                *out_idx = isel_resolve_vreg(ctx, rhs_v);
                *out_scale = c as u8;
                return true;
            }
        }
    } else if k == LIR_INST_SHL {
        let lhs_v = unsafe { (*inst).lhs.v };
        let rhs_v = unsafe { (*inst).rhs.v };
        let mut c: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(c)) {
            if c >= 0i64 && c <= 3i64 {
                *out_idx = isel_resolve_vreg(ctx, lhs_v);
                *out_scale = (1u8 << (c as u8));
                return true;
            }
        }
    }
    false
}

fn isel_match_addr(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    v: u32,
    cur_bb: u32
) -> IselAddrMode {
    let mut cur = isel_resolve_vreg(ctx, v);
    let mut disp: i64 = 0i64;

    let mut depth: u32 = 0u32;
    while depth < 4u32 && (cur as usize) < ctx.vreg_count {
        let cu = cur as usize;
        if (unsafe { *(((ctx.def_cnt as usize) + (cu << 2)) as *mut u32) }) != 1u32 ||
           (unsafe { *(((ctx.def_bb as usize) + (cu << 2)) as *mut u32) }) != cur_bb {
            break;
        }
        let ty_id = isel_vreg_ty(lir, cur);
        if x64_cached_type_size(ty_id, interner) != 8u32 {
            break;
        }
        let inst = unsafe { *(((ctx.def_inst as usize) + (cu << 3)) as *mut *mut LirInst) };
        if (inst as usize) == 0 {
            break;
        }
        let k = unsafe { (*inst).kind };
        if k == LIR_INST_ADD || k == LIR_INST_OFFSET {
            let lv = unsafe { (*inst).lhs.v };
            let rv = unsafe { (*inst).rhs.v };
            let mut c: i64 = 0i64;
            if isel_vreg_const(ctx, lir, interner, rv, mut_view(c)) && isel_fits_i32(c) && isel_fits_i32(disp + c) {
                disp = disp + c;
                cur = isel_resolve_vreg(ctx, lv);
                depth = depth + 1u32;
                continue;
            }
            if isel_vreg_const(ctx, lir, interner, lv, mut_view(c)) && isel_fits_i32(c) && isel_fits_i32(disp + c) {
                disp = disp + c;
                cur = isel_resolve_vreg(ctx, rv);
                depth = depth + 1u32;
                continue;
            }
        } else if k == LIR_INST_SUB {
            let lv = unsafe { (*inst).lhs.v };
            let rv = unsafe { (*inst).rhs.v };
            let mut c: i64 = 0i64;
            if isel_vreg_const(ctx, lir, interner, rv, mut_view(c)) && isel_fits_i32(c) && isel_fits_i32(disp - c) {
                disp = disp - c;
                cur = isel_resolve_vreg(ctx, lv);
                depth = depth + 1u32;
                continue;
            }
        }
        break;
    }

    let mut base_v: u32 = cur;
    let mut index_v: u32 = LIR_VREG_NONE;
    let mut scale: u8 = 1u8;

    let cur_u = cur as usize;
    if cur_u < ctx.vreg_count &&
       (unsafe { *(((ctx.def_cnt as usize) + (cur_u << 2)) as *mut u32) }) == 1u32 &&
       (unsafe { *(((ctx.def_bb as usize) + (cur_u << 2)) as *mut u32) }) == cur_bb {
        let ty_id = isel_vreg_ty(lir, cur);
        if x64_cached_type_size(ty_id, interner) == 8u32 {
            let inst = unsafe { *(((ctx.def_inst as usize) + (cur_u << 3)) as *mut *mut LirInst) };
            if (inst as usize) != 0 {
                let k = unsafe { (*inst).kind };
                if k == LIR_INST_ADD || k == LIR_INST_OFFSET {
                    let lv = isel_resolve_vreg(ctx, unsafe { (*inst).lhs.v });
                    let rv = isel_resolve_vreg(ctx, unsafe { (*inst).rhs.v });
                    let mut idx_cand: u32 = LIR_VREG_NONE;
                    let mut sc_cand: u8 = 1u8;
                    if isel_match_scaled_index(ctx, lir, interner, rv, cur_bb, mut_view(idx_cand), mut_view(sc_cand)) {
                        base_v = lv;
                        index_v = idx_cand;
                        scale = sc_cand;
                    } else if isel_match_scaled_index(ctx, lir, interner, lv, cur_bb, mut_view(idx_cand), mut_view(sc_cand)) {
                        base_v = rv;
                        index_v = idx_cand;
                        scale = sc_cand;
                    } else {
                        base_v = lv;
                        index_v = rv;
                        scale = 1u8;
                    }
                    let bu = base_v as usize;
                    if bu < ctx.vreg_count &&
                       (unsafe { *(((ctx.def_cnt as usize) + (bu << 2)) as *mut u32) }) == 1u32 &&
                       (unsafe { *(((ctx.def_bb as usize) + (bu << 2)) as *mut u32) }) == cur_bb {
                        let binst = unsafe { *(((ctx.def_inst as usize) + (bu << 3)) as *mut *mut LirInst) };
                        if (binst as usize) != 0 {
                            let bk = unsafe { (*binst).kind };
                            if bk == LIR_INST_ADD || bk == LIR_INST_OFFSET {
                                let blv = unsafe { (*binst).lhs.v };
                                let brv = unsafe { (*binst).rhs.v };
                                let mut bc: i64 = 0i64;
                                if isel_vreg_const(ctx, lir, interner, brv, mut_view(bc)) && isel_fits_i32(bc) && isel_fits_i32(disp + bc) {
                                    disp = disp + bc;
                                    base_v = isel_resolve_vreg(ctx, blv);
                                } else if isel_vreg_const(ctx, lir, interner, blv, mut_view(bc)) && isel_fits_i32(bc) && isel_fits_i32(disp + bc) {
                                    disp = disp + bc;
                                    base_v = isel_resolve_vreg(ctx, brv);
                                }
                            }
                        }
                    }
                } else if k == LIR_INST_MUL {
                    let lv = isel_resolve_vreg(ctx, unsafe { (*inst).lhs.v });
                    let rv = isel_resolve_vreg(ctx, unsafe { (*inst).rhs.v });
                    let mut c: i64 = 0i64;
                    if isel_vreg_const(ctx, lir, interner, rv, mut_view(c)) && (c == 3i64 || c == 5i64 || c == 9i64) {
                        base_v = lv;
                        index_v = lv;
                        scale = (c - 1i64) as u8;
                    } else if isel_vreg_const(ctx, lir, interner, lv, mut_view(c)) && (c == 3i64 || c == 5i64 || c == 9i64) {
                        base_v = rv;
                        index_v = rv;
                        scale = (c - 1i64) as u8;
                    }
                }
            }
        }
    }

    IselAddrMode {
        base_v: base_v,
        index_v: index_v,
        scale: scale,
        disp: disp as i32,
    }
}

fn isel_emit_load_vreg(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    reg: i32,
    v: u32
) {
    let vu = v as usize;
    if (ctx.vreg_const_state as usize) != 0 && vu < ctx.vreg_count {
        let st = unsafe { *(((ctx.vreg_const_state as usize) + vu) as *mut u8) };
        if st == 2u8 {
            let cv = unsafe { *(((ctx.vreg_const_val as usize) + (vu << 3)) as *mut i64) };
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, reg, cv);
            return;
        }
        if st == 0u8 {
            let mut cval: i64 = 0i64;
            if isel_vreg_const(ctx, lir, interner, v, mut_view(cval)) {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, reg, cval);
                return;
            }
        }
    } else {
        let mut cval: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, v, mut_view(cval)) {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, reg, cval);
            return;
        }
    }
    let rv = if vu < ctx.vreg_count {
        let al = unsafe { *(((ctx.vreg_alias as usize) + (vu << 2)) as *mut u32) };
        if al == LIR_VREG_NONE { v } else { isel_resolve_vreg(ctx, al) }
    } else {
        v
    };
    isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, reg, ctx.slot_offset + rv, 0);
}

fn isel_emit_addr_load(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    addr: view<IselAddrMode>,
    base_reg: i32,
    idx_reg: i32
) -> i32 {
    isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), base_reg, addr.base_v);
    if addr.index_v != LIR_VREG_NONE {
        if addr.index_v == addr.base_v {
            return base_reg;
        }
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), idx_reg, addr.index_v);
        return idx_reg;
    }
    REG_NONE
}

fn isel_emit_umagic_div(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    d_u: u64
) {
    // Assumes dividend is in REG_RAX (and saved in REG_R8 if add_flag is true).
    // Produces unsigned quotient in REG_RAX. Clobbers REG_RCX, REG_RDX, REG_R8.
    let mag = isel_umagic64(d_u);
    if mag.add_flag {
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R8, REG_RAX);
    }
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, mag.magic_m as i64);
    let mul_mi = isel_mi_r(mut_view(*mi), mut_view(*mbb), X64_MI_MUL, REG_RCX);
    unsafe { (*mul_mi).msg_len = 1; }
    if !mag.add_flag {
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, REG_RDX);
        if mag.shift_s > 0u32 {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_RAX, mag.shift_s as i64);
        }
    } else {
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, REG_R8);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RDX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_RAX, 1i64);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, REG_RAX, REG_RDX);
        if mag.shift_s > 1u32 {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_RAX, (mag.shift_s - 1u32) as i64);
        }
    }
}

fn isel_emit_icmp_flags(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    lhs_v: u32,
    rhs_v: u32
) {
    let mut rc: i64 = 0i64;
    if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(rc)) && isel_fits_i32(rc) {
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, rc);
    } else {
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, REG_RCX);
    }
}

fn isel_opt_lower_alu_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cur_bb: u32,
    kind: u8,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let slot_offset = ctx.slot_offset;
    let dest_ty = isel_vreg_ty(lir, dest_v);
    let dest_sz = x64_cached_type_size(TypeId { v: dest_ty.v }, interner);

    let mut handled = false;
    if (kind == LIR_INST_ADD || kind == LIR_INST_OFFSET) && dest_sz == 8u32 {
        let addr = isel_match_addr(ctx, lir, interner, dest_v, cur_bb);
        if addr.index_v != LIR_VREG_NONE && (addr.scale > 1u8 || addr.disp != 0) {
            let act_idx = isel_emit_addr_load(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), view(addr), REG_RAX, REG_RCX);
            let act_sc = if act_idx == REG_NONE { 1u8 } else { addr.scale };
            isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, 8u8, REG_RAX, REG_RAX, act_idx, act_sc, addr.disp);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
            handled = true;
        }
    }

    if !handled {
        let opc: u32 = if kind == LIR_INST_ADD || kind == LIR_INST_OFFSET {
            X64_MI_ADD
        } else if kind == LIR_INST_SUB {
            X64_MI_SUB
        } else if kind == LIR_INST_BIT_AND {
            X64_MI_AND
        } else if kind == LIR_INST_BIT_OR {
            X64_MI_OR
        } else {
            X64_MI_XOR
        };
        let is_comm = kind != LIR_INST_SUB;
        let mut rc: i64 = 0i64;
        let mut lc: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(rc)) && isel_fits_i32(rc) {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            if !(rc == 0i64 && (opc == X64_MI_ADD || opc == X64_MI_SUB || opc == X64_MI_OR || opc == X64_MI_XOR)) {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), opc, REG_RAX, rc);
            }
        } else if is_comm && isel_vreg_const(ctx, lir, interner, lhs_v, mut_view(lc)) && isel_fits_i32(lc) {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, rhs_v);
            if !(lc == 0i64 && (opc == X64_MI_ADD || opc == X64_MI_OR || opc == X64_MI_XOR)) {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), opc, REG_RAX, lc);
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), opc, REG_RAX, REG_RCX);
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    }
}

fn isel_opt_lower_mul_shift_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let slot_offset = ctx.slot_offset;
    let dest_ty = isel_vreg_ty(lir, dest_v);
    if kind == LIR_INST_MUL {
        let mut cval: i64 = 0i64;
        let mut x_v: u32 = lhs_v;
        let mut has_const = false;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(cval)) {
            x_v = lhs_v;
            has_const = true;
        } else if isel_vreg_const(ctx, lir, interner, lhs_v, mut_view(cval)) {
            x_v = rhs_v;
            has_const = true;
        }

        if has_const {
            if cval == 0i64 {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
            } else if cval == 1i64 {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, x_v);
            } else if cval == -1i64 {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, x_v);
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RCX);
            } else if cval == 3i64 || cval == 5i64 || cval == 9i64 {
                let sc: u8 = (cval - 1i64) as u8;
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, x_v);
                isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, 8u8, REG_RAX, REG_RAX, REG_RAX, sc, 0);
            } else if cval > 0i64 && isel_is_pow2_u64(cval as u64) {
                let sh = isel_ctz_u64(cval as u64);
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, x_v);
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_RAX, sh as i64);
            } else {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, x_v);
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, cval);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, REG_RAX, REG_RCX);
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, REG_RAX, REG_RCX);
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    } else {
        let opc: u32 = if kind == LIR_INST_SHL {
            X64_MI_SHL
        } else if kind == LIR_INST_SHR {
            X64_MI_SHR
        } else {
            X64_MI_SAR
        };
        let mut sc: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(sc)) {
            let cnt = sc & 63i64;
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            if cnt != 0i64 {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), opc, REG_RAX, cnt);
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), opc, REG_RAX, REG_RCX);
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    }
}

fn isel_opt_lower_udiv_urem_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) -> u32 {
    let slot_offset = ctx.slot_offset;
    let dest_ty = isel_vreg_ty(lir, dest_v);
    let mut dc: i64 = 0i64;
    if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(dc)) && (dc as u64) > 0u64 {
        let d_u = dc as u64;
        if d_u == 1u64 {
            if kind == LIR_INST_UDIV {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            } else {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
            }
        } else if isel_is_pow2_u64(d_u) {
            let sh = isel_ctz_u64(d_u);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            if kind == LIR_INST_UDIV {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_RAX, sh as i64);
            } else {
                let mask: i64 = (d_u - 1u64) as i64;
                if isel_fits_i32(mask) {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, mask);
                } else {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, mask);
                    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, REG_RCX);
                }
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_emit_umagic_div(mut_view(*mi), mut_view(*mbb), d_u);
            if kind == LIR_INST_UREM {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, d_u as i64);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, REG_RAX, REG_RCX);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, REG_RAX);
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RCX);
            }
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        return dest_v;
    }
    unsafe {
        isel_emit_udiv_urem(mut_view(*mi), mut_view(*mbb), kind, slot_offset, dest_v, lhs_v, rhs_v);
    }
    LIR_VREG_NONE
}

fn isel_opt_lower_sdiv_srem_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) -> u32 {
    let slot_offset = ctx.slot_offset;
    let dest_ty = isel_vreg_ty(lir, dest_v);
    let mut dc: i64 = 0i64;
    if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(dc)) && dc != 0i64 && dc != -1i64 && dc != (-9223372036854775807i64 - 1i64) {
        let ad_u: u64 = if dc < 0i64 { (0i64 - dc) as u64 } else { dc as u64 };
        if dc == 1i64 {
            if kind == LIR_INST_DIV {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            } else {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
            }
        } else if isel_is_pow2_u64(ad_u) {
            let k = isel_ctz_u64(ad_u);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, REG_RAX);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, REG_RCX, 63i64);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_RCX, (64u32 - k) as i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, REG_RAX, REG_RCX);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, REG_RAX, k as i64);
            if kind == LIR_INST_DIV {
                if dc < 0i64 {
                    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, REG_RAX);
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
                    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RCX);
                }
            } else {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_RAX, k as i64);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, REG_RAX);
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RCX);
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R10, REG_RAX);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, REG_R10, 63i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, REG_RAX, REG_R10);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_R10);
            isel_emit_umagic_div(mut_view(*mi), mut_view(*mbb), ad_u);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, REG_RAX, REG_R10);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_R10);
            if dc < 0i64 {
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, REG_RAX);
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RCX);
            }
            if kind == LIR_INST_REM {
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, dc);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, REG_RAX, REG_RCX);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, REG_RAX);
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
                isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RCX);
            }
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        return dest_v;
    }
    isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
    isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, REG_RAX);
    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, REG_RDX, 63i64);
    isel_mi_r(mut_view(*mi), mut_view(*mbb), X64_MI_IDIV, REG_RCX);
    if kind == LIR_INST_DIV {
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    } else {
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RDX);
    }
    LIR_VREG_NONE
}

fn isel_opt_lower_abi_call_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    inst: *mut LirInst
) {
    let slot_offset = ctx.slot_offset;
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    if kind == LIR_INST_ABI_ARG {
        let loc_kind = unsafe { (*inst).loc_kind };
        let loc_ro = unsafe { (*inst).loc_reg_or_offset };
        if dest_v != LIR_VREG_NONE {
            if loc_kind == ABI_LOC_REG {
                isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, loc_ro as i32);
            } else if loc_kind == ABI_LOC_STACK {
                let disp = (16u32 + loc_ro) as i32;
                isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 8u8, REG_RAX, REG_RBP, REG_NONE, 1u8, disp);
                isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
            } else if loc_kind == ABI_LOC_INDIRECT {
                let d_ty = isel_vreg_ty(lir, dest_v);
                let size = x64_cached_type_size(d_ty, interner);
                if loc_ro < 16u32 {
                    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, loc_ro as i32);
                } else {
                    let disp = (16u32 + loc_ro) as i32;
                    isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 8u8, REG_RAX, REG_RBP, REG_NONE, 1u8, disp);
                }
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, off as i32);
                    isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, slot_offset + dest_v, off as i32, REG_RCX);
                    off = off + chunk;
                }
            }
        } else {
            let val_v = unsafe { (*inst).val.v };
            if loc_kind == ABI_LOC_REG {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), loc_ro as i32, val_v);
            } else if loc_kind == ABI_LOC_STACK {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, val_v);
                isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 8u8, REG_RSP, REG_NONE, 1u8, loc_ro as i32, REG_RAX);
            } else if loc_kind == ABI_LOC_INDIRECT {
                isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, REG_RAX, slot_offset + val_v, 0);
                if loc_ro < 16u32 {
                    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, loc_ro as i32, REG_RAX);
                } else {
                    isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 8u8, REG_RSP, REG_NONE, 1u8, loc_ro as i32, REG_RAX);
                }
            }
        }
    } else if kind == LIR_INST_CALL {
        let mut call_ret_in_mem = false;
        let callee_ty_id = unsafe { (*inst).callee_ty };
        let c_ty = type_get(interner, callee_ty_id);
        if (c_ty as usize) != 0 {
            let mut r_ty_id = unsafe { (*c_ty).ret_type };
            let c_kind = unsafe { (*c_ty).kind };
            if r_ty_id.v == 0u32 && c_kind == TY_CLOSURE {
                let fn_ty_id = unsafe { (*c_ty).fn_type };
                if fn_ty_id.v != 0u32 {
                    let f_ty = type_get(interner, fn_ty_id);
                    if (f_ty as usize) != 0 {
                        r_ty_id = unsafe { (*f_ty).ret_type };
                    }
                }
            }
            if r_ty_id.v != 0u32 {
                let r_sz = x64_cached_type_size(r_ty_id, interner);
                call_ret_in_mem = isel_type_is_ret_in_mem(r_sz);
            }
        }
        let dst_addr_v = unsafe { (*inst).dst_addr.v };
        if call_ret_in_mem && dst_addr_v != LIR_VREG_NONE {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, slot_offset + dst_addr_v, 0);
        }
        let sym_name = unsafe { (*inst).sym_name };
        let sym_len = unsafe { (*inst).sym_len };
        let callee_v = unsafe { (*inst).callee_vreg.v };
        if (sym_name as usize) != 0 {
            let call_mi = isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_CALL);
            unsafe {
                (*call_mi).msg = sym_name;
                (*call_mi).msg_len = sym_len;
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_R10, callee_v);
            isel_mi_r(mut_view(*mi), mut_view(*mbb), X64_MI_CALL, REG_R10);
        }
    } else if kind == LIR_INST_ABI_RESULT {
        let loc_kind = unsafe { (*inst).loc_kind };
        let loc_ro = unsafe { (*inst).loc_reg_or_offset };
        if loc_kind == ABI_LOC_REG {
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, loc_ro as i32);
        } else if loc_kind == ABI_LOC_INDIRECT {
            let d_ty = isel_vreg_ty(lir, dest_v);
            let mut size = x64_cached_type_size(d_ty, interner);
            if size <= 8u32 {
                if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                    size = 8u32;
                }
                isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, 0);
                isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, slot_offset + dest_v, 0, REG_RCX);
            } else {
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, off as i32);
                    isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, slot_offset + dest_v, off as i32, REG_RCX);
                    off = off + chunk;
                }
            }
        }
    }
}

fn isel_opt_lower_load_store_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cur_bb: u32,
    inst: *mut LirInst
) -> u32 {
    let slot_offset = ctx.slot_offset;
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let mut tag_vreg: u32 = LIR_VREG_NONE;

    if kind == LIR_INST_LOAD {
        let ptr_v = unsafe { (*inst).ptr.v };
        let load_ty = unsafe { (*inst).ty };
        let mut size = x64_cached_type_size(TypeId { v: load_ty.v }, interner);
        let is_signed = isel_type_is_signed_int(load_ty, interner);
        let mut direct_slot: u32 = 0u32;
        let is_slot_ld = isel_vreg_is_stack_addr(ctx, ptr_v, mut_view(direct_slot));
        if size <= 8u32 {
            if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                size = 8u32;
            }
            if is_slot_ld {
                tag_vreg = dest_v;
                if size < 8u32 {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, 0i64);
                }
                isel_mi_rf_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, REG_RCX, direct_slot, 0);
            } else {
                let addr = isel_match_addr(ctx, lir, interner, ptr_v, cur_bb);
                let act_idx = isel_emit_addr_load(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), view(addr), REG_RAX, REG_R10);
                let act_sc = if act_idx == REG_NONE { 1u8 } else { addr.scale };
                if size < 8u32 {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, 0i64);
                }
                isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, REG_RCX, REG_RAX, act_idx, act_sc, addr.disp);
            }
            if size < 8u32 {
                let shift = ((8u32 - size) * 8u32) as i64;
                isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, REG_RCX, shift);
                if is_signed {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, REG_RCX, shift);
                } else {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, REG_RCX, shift);
                }
            }
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RCX);
        } else {
            if is_slot_ld {
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    isel_mi_rf_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, direct_slot, off as i32);
                    isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, slot_offset + dest_v, off as i32, REG_RCX);
                    off = off + chunk;
                }
            } else {
                isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + ptr_v, 0);
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, REG_RAX, REG_NONE, 1u8, off as i32);
                    isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, slot_offset + dest_v, off as i32, REG_RCX);
                    off = off + chunk;
                }
            }
        }
    } else if kind == LIR_INST_STORE {
        let ptr_v = unsafe { (*inst).ptr.v };
        let val_v = unsafe { (*inst).val.v };
        let val_ty = isel_vreg_ty(lir, val_v);
        let mut size = x64_cached_type_size(val_ty, interner);
        let mut direct_slot: u32 = 0u32;
        let is_slot_st = isel_vreg_is_stack_addr(ctx, ptr_v, mut_view(direct_slot));
        if size <= 8u32 {
            if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                size = 8u32;
            }
            if is_slot_st {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, val_v);
                isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, direct_slot, 0, REG_RCX);
                if (direct_slot as usize) < ctx.slot_count && (unsafe { *(((ctx.slot_single_bb as usize) + (direct_slot as usize)) as *mut u8) }) != 0u8 {
                    tag_vreg = unsafe { *(((ctx.slot_single_ld_v as usize) + ((direct_slot as usize) << 2)) as *mut u32) };
                }
            } else {
                let addr = isel_match_addr(ctx, lir, interner, ptr_v, cur_bb);
                let act_idx = isel_emit_addr_load(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), view(addr), REG_RAX, REG_R10);
                let act_sc = if act_idx == REG_NONE { 1u8 } else { addr.scale };
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, val_v);
                isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, REG_RAX, act_idx, act_sc, addr.disp, REG_RCX);
            }
        } else {
            if is_slot_st {
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    isel_mi_rf_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, slot_offset + val_v, off as i32);
                    isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, direct_slot, off as i32, REG_RCX);
                    off = off + chunk;
                }
            } else {
                isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + ptr_v, 0);
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    isel_mi_rf_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RCX, slot_offset + val_v, off as i32);
                    isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, REG_RAX, REG_NONE, 1u8, off as i32, REG_RCX);
                    off = off + chunk;
                }
            }
        }
    }
    tag_vreg
}

fn isel_opt_lower_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cur_bb: u32,
    inst_idx: usize,
    inst: *mut LirInst
) {
    let slot_offset = ctx.slot_offset;
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let lhs_v = unsafe { (*inst).lhs.v };
    let rhs_v = unsafe { (*inst).rhs.v };
    let operand_v = unsafe { (*inst).operand.v };

    let first_before = mbb.first_inst;
    let last_before = mbb.last_inst;
    let mut tag_vreg: u32 = LIR_VREG_NONE;

    if kind == LIR_INST_CONST {
        let cval = isel_const_inst_val(lir, interner, inst as *const LirInst, dest_v);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, cval);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        tag_vreg = dest_v;
    } else if kind == LIR_INST_CONST_STR {
        let s_bytes = unsafe { (*inst).str_bytes };
        let s_len = unsafe { (*inst).str_len };
        let sym_id = x64_mi_add_string(mut_view(*mi), s_bytes, s_len);
        isel_mi_rsym(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, REG_RAX, sym_id);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, s_len as i64);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 8, REG_RAX);
    } else if kind == LIR_INST_FN_ADDR || kind == LIR_INST_TLS_ADDR {
        isel_emit_sym_addr(mut_view(*mi), mut_view(*mbb), slot_offset + dest_v, inst as *const LirInst);
    } else if kind == LIR_INST_ADD || kind == LIR_INST_OFFSET || kind == LIR_INST_SUB ||
              kind == LIR_INST_BIT_AND || kind == LIR_INST_BIT_OR || kind == LIR_INST_BIT_XOR {
        tag_vreg = dest_v;
        isel_opt_lower_alu_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), cur_bb, kind, dest_v, lhs_v, rhs_v);
    } else if kind == LIR_INST_MUL || kind == LIR_INST_SHL || kind == LIR_INST_SHR || kind == LIR_INST_SAR {
        tag_vreg = dest_v;
        isel_opt_lower_mul_shift_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), kind, dest_v, lhs_v, rhs_v);
    } else if kind == LIR_INST_UDIV || kind == LIR_INST_UREM {
        tag_vreg = isel_opt_lower_udiv_urem_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), kind, dest_v, lhs_v, rhs_v);
    } else if kind == LIR_INST_DIV || kind == LIR_INST_REM {
        tag_vreg = isel_opt_lower_sdiv_srem_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), kind, dest_v, lhs_v, rhs_v);
    } else if kind >= LIR_INST_ICMP_EQ && kind <= LIR_INST_ICMP_UGE {
        let cc = isel_icmp_cc(kind);
        tag_vreg = dest_v;
        isel_emit_icmp_flags(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), lhs_v, rhs_v);
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, cc as i64, REG_RAX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, 1i64);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    } else if kind == LIR_INST_NEG {
        let dest_ty = isel_vreg_ty(lir, dest_v);
        tag_vreg = dest_v;
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, operand_v);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, 0i64);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RCX, REG_RAX);
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RCX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RCX);
    } else if kind == LIR_INST_NOT {
        tag_vreg = dest_v;
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, operand_v);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, REG_RAX, 1i64);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    } else if kind == LIR_INST_BITNOT {
        let dest_ty = isel_vreg_ty(lir, dest_v);
        tag_vreg = dest_v;
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, operand_v);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R10, -1i64);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_R10, REG_RCX);
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_R10);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_R10);
    } else if kind == LIR_INST_UADD_OVERFLOW || kind == LIR_INST_USUB_OVERFLOW || kind == LIR_INST_UMUL_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        unsafe {
            isel_emit_uoverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
        }
    } else if kind == LIR_INST_SADD_OVERFLOW || kind == LIR_INST_SSUB_OVERFLOW || kind == LIR_INST_SMUL_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        unsafe {
            isel_emit_soverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
        }
    } else if kind == LIR_INST_UDIV_OVERFLOW || kind == LIR_INST_UREM_OVERFLOW {
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    } else if kind == LIR_INST_SDIV_OVERFLOW || kind == LIR_INST_SREM_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        let mut int_min: i64 = (0x8000000000000000u64) as i64;
        if bw == 8u32 {
            int_min = -128i64;
        } else if bw == 16u32 {
            int_min = -32768i64;
        } else if bw == 32u32 {
            int_min = -2147483648i64;
        }
        isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, slot_offset + lhs_v, 0);
        isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, slot_offset + rhs_v, 0);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RDX, -1i64);
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_E as i64, REG_RCX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RCX, 1i64);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RDX, int_min);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, REG_RDX);
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_E as i64, REG_RAX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, 1i64);
        isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, REG_RCX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
    } else if kind == LIR_INST_ABI_ARG || kind == LIR_INST_CALL || kind == LIR_INST_ABI_RESULT {
        isel_opt_lower_abi_call_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), inst);
    } else if kind == LIR_INST_STACK_ADDR {
        let slot_v = unsafe { (*inst).slot.v };
        if slot_v == 0u32 && ctx.ret_in_mem {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0u32, 0);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        } else {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, REG_RAX, slot_v, 0);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
            tag_vreg = dest_v;
        }
    } else if kind == LIR_INST_LOAD || kind == LIR_INST_STORE {
        tag_vreg = isel_opt_lower_load_store_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), cur_bb, inst);
    } else if kind == LIR_INST_ATOMIC_LOAD {
        let ptr_v = unsafe { (*inst).ptr.v };
        let elem_ty_v = unsafe { (*inst).ty.v };
        let sz = isel_atomic_sz(inst as *const LirInst, interner);
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, ptr_v);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RCX, 0i64);
        isel_mi_rm_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, sz, REG_RCX, REG_RAX, REG_NONE, 1u8, 0);
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RCX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RCX);
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
    } else if kind == LIR_INST_ATOMIC_STORE {
        let ptr_v = unsafe { (*inst).ptr.v };
        let val_v = unsafe { (*inst).val.v };
        let ord = unsafe { (*inst).ordering };
        let sz = isel_atomic_sz(inst as *const LirInst, interner);
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, ptr_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, val_v);
        if ord == LIR_ORDER_SEQ_CST {
            isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_XCHG, sz, REG_RAX, REG_NONE, 1u8, 0, REG_RCX);
        } else {
            isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, sz, REG_RAX, REG_NONE, 1u8, 0, REG_RCX);
        }
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
    } else if kind == LIR_INST_ATOMIC_RMW {
        let ptr_v = unsafe { (*inst).ptr.v };
        let val_v = unsafe { (*inst).val.v };
        let elem_ty_v = unsafe { (*inst).ty.v };
        let rmw_op = unsafe { (*inst).rmw_op };
        let sz = isel_atomic_sz(inst as *const LirInst, interner);
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, ptr_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RDX, val_v);
        if rmw_op == LIR_ATOMIC_RMW_XCHG {
            isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_XCHG, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RDX);
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RDX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RDX);
        } else if rmw_op == LIR_ATOMIC_RMW_ADD {
            isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_XADD, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RDX);
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RDX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RDX);
        } else if rmw_op == LIR_ATOMIC_RMW_SUB {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
            isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, REG_RAX, REG_RDX);
            isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_XADD, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RAX);
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        } else {
            let loop_mi = isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_ATOMIC_RMW_LOOP, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RDX);
            unsafe { (*loop_mi).msg_len = rmw_op as usize; }
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
            isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        }
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
    } else if kind == LIR_INST_ATOMIC_CAS {
        let ptr_v = unsafe { (*inst).ptr.v };
        let ok_v = unsafe { (*inst).cas_ok.v };
        let elem_ty_v = unsafe { (*inst).ty.v };
        let sz = isel_atomic_sz(inst as *const LirInst, interner);
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, ptr_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RDX, rhs_v);
        isel_mi_mr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_CMPXCHG, sz, REG_RCX, REG_NONE, 1u8, 0, REG_RDX);
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, CC_E as i64, REG_R8);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_R8, 1i64);
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + dest_v, 0, REG_RAX);
        isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, slot_offset + ok_v, 0, REG_R8);
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
    } else if kind == LIR_INST_FENCE {
        let is_comp = unsafe { (*inst).is_compiler_only };
        let ord = unsafe { (*inst).ordering };
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER);
        if !is_comp && ord == LIR_ORDER_SEQ_CST {
            isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_MFENCE);
        }
    } else if kind == LIR_INST_PAUSE {
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_PAUSE);
    }

    let _ = inst_idx;
    if tag_vreg != LIR_VREG_NONE {
        let mut cur: *mut X64MI = if (last_before as usize) != 0 {
            unsafe { (*last_before).next }
        } else if (first_before as usize) == 0 {
            mbb.first_inst
        } else {
            0 as *mut X64MI
        };
        while (cur as usize) != 0 {
            unsafe {
                (*cur).origin_vreg = tag_vreg;
                cur = (*cur).next;
            }
        }
    }
}

struct DiamondArm {
    pub slot: u32,
    pub val: u32,
    pub cost: u32,
}

fn isel_check_diamond_arm(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    arm_bb: usize,
    out_arm: *mut DiamondArm
) -> bool {
    let lbb = unsafe { lir_bb_at(lir.bbs, arm_bb) };
    let cnt = unsafe { (*lbb).inst_count };
    if cnt == 0 {
        return false;
    }
    let insts = unsafe { (*lbb).insts };
    let last_inst = unsafe { lir_inst_at(insts, cnt - 1) };
    if (unsafe { (*last_inst).kind }) != LIR_INST_STORE {
        return false;
    }
    let st_ptr_v = unsafe { (*last_inst).ptr.v };
    let st_val_v = unsafe { (*last_inst).val.v };
    let mut dst_slot: u32 = 0u32;
    if !isel_vreg_is_stack_addr(ctx, st_ptr_v, mut_view(dst_slot)) {
        return false;
    }
    let val_ty_v = isel_vreg_ty(lir, st_val_v).v;
    let mut val_rc: u8 = REG_CLASS_GPR;
    let val_sz = x64_cached_type_size_and_rc(TypeId { v: val_ty_v }, interner, mut_view(val_rc));
    if val_rc != REG_CLASS_GPR {
        return false;
    }
    if val_sz == 0u32 || val_sz > 8u32 || (val_sz != 1u32 && val_sz != 2u32 && val_sz != 4u32 && val_sz != 8u32) {
        return false;
    }

    let mut cost: u32 = 0u32;
    let mut i: usize = 0;
    while i + 1 < cnt {
        let inst = unsafe { lir_inst_at(insts, i) };
        let k = unsafe { (*inst).kind };
        let dv = unsafe { (*inst).dest.v };
        if dv != LIR_VREG_NONE && (dv as usize) < ctx.vreg_count {
            if (unsafe { *(((ctx.cross_bb as usize) + (dv as usize)) as *mut u8) }) != 0u8 {
                return false;
            }
            let dty_v = isel_vreg_ty(lir, dv).v;
            let mut dty_rc: u8 = REG_CLASS_GPR;
            let dty_sz = x64_cached_type_size_and_rc(TypeId { v: dty_v }, interner, mut_view(dty_rc));
            if dty_sz > 8u32 || dty_rc != REG_CLASS_GPR {
                return false;
            }
        }
        if k == LIR_INST_CONST || k == LIR_INST_STACK_ADDR {
            // zero cost
        } else if k == LIR_INST_LOAD {
            let pv = unsafe { (*inst).ptr.v };
            let mut s_ld: u32 = 0u32;
            if !isel_vreg_is_stack_addr(ctx, pv, mut_view(s_ld)) {
                return false;
            }
            let ld_ty_v = unsafe { (*inst).ty.v };
            let mut ld_rc: u8 = REG_CLASS_GPR;
            let ld_sz = x64_cached_type_size_and_rc(TypeId { v: ld_ty_v }, interner, mut_view(ld_rc));
            if ld_sz > 8u32 || ld_rc != REG_CLASS_GPR {
                return false;
            }
        } else if k == LIR_INST_ADD || k == LIR_INST_OFFSET || k == LIR_INST_SUB ||
                  k == LIR_INST_MUL || k == LIR_INST_BIT_AND || k == LIR_INST_BIT_OR ||
                  k == LIR_INST_BIT_XOR || k == LIR_INST_SHL || k == LIR_INST_SHR ||
                  k == LIR_INST_SAR || k == LIR_INST_NEG || k == LIR_INST_NOT ||
                  k == LIR_INST_BITNOT || (k >= LIR_INST_ICMP_EQ && k <= LIR_INST_ICMP_UGE) {
            cost = cost + 1u32;
        } else {
            return false;
        }
        i = i + 1;
    }
    if cost > 4u32 {
        return false;
    }
    unsafe {
        (*out_arm).slot = dst_slot;
        (*out_arm).val = st_val_v;
        (*out_arm).cost = cost;
    }
    true
}

fn isel_emit_cond_flags_for_branch(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cur_bb: u32,
    cond_v: u32
) -> u8 {
    let mut rc = isel_resolve_vreg(ctx, cond_v);
    let mut inv = false;
    let mut steps: u32 = 0u32;
    while steps < 4u32 && (rc as usize) < ctx.vreg_count {
        let rcu = rc as usize;
        if (unsafe { *(((ctx.def_cnt as usize) + (rcu << 2)) as *mut u32) }) != 1u32 ||
           (unsafe { *(((ctx.def_bb as usize) + (rcu << 2)) as *mut u32) }) != cur_bb {
            break;
        }
        let inst = unsafe { *(((ctx.def_inst as usize) + (rcu << 3)) as *mut *mut LirInst) };
        if (inst as usize) == 0 {
            break;
        }
        let k = unsafe { (*inst).kind };
        if k == LIR_INST_NOT {
            let op_v = isel_resolve_vreg(ctx, unsafe { (*inst).operand.v });
            if isel_vreg_is_bool(lir, interner, rc) && isel_vreg_is_bool(lir, interner, op_v) {
                inv = !inv;
                rc = op_v;
                steps = steps + 1u32;
                continue;
            }
            break;
        }
        if k == LIR_INST_BIT_XOR {
            if isel_vreg_is_bool(lir, interner, rc) {
                let lhs_v = unsafe { (*inst).lhs.v };
                let rhs_v = unsafe { (*inst).rhs.v };
                let mut xc: i64 = 0i64;
                if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(xc)) && xc == 1i64 {
                    let inner_v = isel_resolve_vreg(ctx, lhs_v);
                    if isel_vreg_is_bool(lir, interner, inner_v) {
                        inv = !inv;
                        rc = inner_v;
                        steps = steps + 1u32;
                        continue;
                    }
                } else if isel_vreg_const(ctx, lir, interner, lhs_v, mut_view(xc)) && xc == 1i64 {
                    let inner_v = isel_resolve_vreg(ctx, rhs_v);
                    if isel_vreg_is_bool(lir, interner, inner_v) {
                        inv = !inv;
                        rc = inner_v;
                        steps = steps + 1u32;
                        continue;
                    }
                }
            }
            break;
        }
        if k >= LIR_INST_ICMP_EQ && k <= LIR_INST_ICMP_UGE {
            let lv = unsafe { (*inst).lhs.v };
            let rv = unsafe { (*inst).rhs.v };
            isel_emit_icmp_flags(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), lv, rv);
            let mut cc = isel_icmp_cc(k);
            if inv {
                cc = x64_cc_invert(cc);
            }
            return cc;
        }
        break;
    }

    isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, rc);
    let t_mi = isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_TEST, REG_RAX, REG_RAX);
    unsafe { (*t_mi).msg_len = 1; }
    let mut cc = CC_NE;
    if inv {
        cc = x64_cc_invert(cc);
    }
    cc
}

fn isel_try_if_convert_diamond(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    b: usize
) -> bool {
    let lbb = unsafe { lir_bb_at(lir.bbs, b) };
    let tk = unsafe { (*lbb).term.kind };
    let mut cond_v: u32 = LIR_VREG_NONE;
    let mut then_bb: usize = 0;
    let mut else_bb: usize = 0;
    let invert_cond = false;

    if tk == LIR_TERM_JCC {
        cond_v = unsafe { (*lbb).term.cond.v };
        if !isel_vreg_is_scalar_gpr(lir, interner, cond_v) {
            return false;
        }
        then_bb = unsafe { (*lbb).term.then_target.v as usize };
        else_bb = unsafe { (*lbb).term.else_target.v as usize };
    } else if tk == LIR_TERM_SWITCH {
        if (unsafe { (*lbb).term.count }) != 1 {
            return false;
        }
        cond_v = unsafe { (*lbb).term.cond.v };
        if !isel_vreg_is_scalar_gpr(lir, interner, cond_v) {
            return false;
        }
        let tp = unsafe { lir_switch_target_at((*lbb).term.targets, 0) };
        let t_val = unsafe { (*tp).val };
        let t_bb = unsafe { (*tp).target.v as usize };
        let oth_bb = unsafe { (*lbb).term.otherwise.v as usize };
        if t_val == 0u64 {
            then_bb = oth_bb;
            else_bb = t_bb;
        } else if t_val == 1u64 {
            if !isel_vreg_is_bool(lir, interner, cond_v) {
                return false;
            }
            then_bb = t_bb;
            else_bb = oth_bb;
        } else {
            return false;
        }
    } else {
        return false;
    }

    if then_bb >= ctx.bb_count || else_bb >= ctx.bb_count || then_bb == else_bb || then_bb == b || else_bb == b {
        return false;
    }
    if (unsafe { *(((ctx.pred_cnt as usize) + (then_bb << 2)) as *mut u32) }) != 1u32 ||
       (unsafe { *(((ctx.pred_cnt as usize) + (else_bb << 2)) as *mut u32) }) != 1u32 {
        return false;
    }
    if (unsafe { *(((ctx.bb_skip as usize) + then_bb) as *mut u8) }) != 0u8 ||
       (unsafe { *(((ctx.bb_skip as usize) + else_bb) as *mut u8) }) != 0u8 {
        return false;
    }

    let lbb_then = unsafe { lir_bb_at(lir.bbs, then_bb) };
    let lbb_else = unsafe { lir_bb_at(lir.bbs, else_bb) };
    if (unsafe { (*lbb_then).term.kind }) != LIR_TERM_JMP ||
       (unsafe { (*lbb_else).term.kind }) != LIR_TERM_JMP {
        return false;
    }
    let join_bb = unsafe { (*lbb_then).term.jmp_target.v as usize };
    if (unsafe { (*lbb_else).term.jmp_target.v as usize }) != join_bb {
        return false;
    }
    if join_bb >= ctx.bb_count || join_bb == b || join_bb == then_bb || join_bb == else_bb {
        return false;
    }

    let mut arm_then = DiamondArm { slot: 0u32, val: 0u32, cost: 0u32 };
    let mut arm_else = DiamondArm { slot: 0u32, val: 0u32, cost: 0u32 };
    let p_then: *mut DiamondArm = unsafe { address_of_mut(arm_then) };
    let p_else: *mut DiamondArm = unsafe { address_of_mut(arm_else) };

    if !isel_check_diamond_arm(ctx, lir, interner, then_bb, p_then) {
        return false;
    }
    if !isel_check_diamond_arm(ctx, lir, interner, else_bb, p_else) {
        return false;
    }
    let slot_then = arm_then.slot;
    let val_then = arm_then.val;
    let cost_then = arm_then.cost;
    let slot_else = arm_else.slot;
    let val_else = arm_else.val;
    let cost_else = arm_else.cost;
    if slot_then != slot_else || (cost_then + cost_else + 1u32) > 6u32 {
        return false;
    }

    // Lower non-store instructions of `then_bb` and `else_bb` into `mbb`
    let then_cnt = unsafe { (*lbb_then).inst_count };
    let mut ti: usize = 0;
    while ti + 1 < then_cnt {
        let tinst = unsafe { lir_inst_at((*lbb_then).insts, ti) };
        isel_opt_lower_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), then_bb as u32, ti, tinst);
        ti = ti + 1;
    }
    let else_cnt = unsafe { (*lbb_else).inst_count };
    let mut ei: usize = 0;
    while ei + 1 < else_cnt {
        let einst = unsafe { lir_inst_at((*lbb_else).insts, ei) };
        isel_opt_lower_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), else_bb as u32, ei, einst);
        ei = ei + 1;
    }

    let mut cc: u8 = isel_emit_cond_flags_for_branch(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), b as u32, cond_v);
    if invert_cond {
        cc = x64_cc_invert(cc);
    }

    let val_ty = isel_vreg_ty(lir, val_then);
    let mut dst_sz = x64_cached_type_size(val_ty, interner) as u8;
    if dst_sz != 1u8 && dst_sz != 2u8 && dst_sz != 4u8 && dst_sz != 8u8 {
        dst_sz = 8u8;
    }

    let mut c_then: i64 = 0i64;
    let mut c_else: i64 = 0i64;
    let is_c_then = isel_vreg_const(ctx, lir, interner, val_then, mut_view(c_then));
    let is_c_else = isel_vreg_const(ctx, lir, interner, val_else, mut_view(c_else));

    if is_c_then && is_c_else && ((c_then == 1i64 && c_else == 0i64) || (c_then == 0i64 && c_else == 1i64)) {
        let set_cc = if c_then == 1i64 { cc } else { x64_cc_invert(cc) };
        isel_mi_ir(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, set_cc as i64, REG_RAX);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_AND, REG_RAX, 1i64);
        isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, dst_sz, slot_then, 0, REG_RAX);
    } else {
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, val_else);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, val_then);
        isel_mi_cmovcc_rr(mut_view(*mi), mut_view(*mbb), cc, REG_RAX, REG_RCX);
        isel_mi_fr_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, dst_sz, slot_then, 0, REG_RAX);
    }

    isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, join_bb as i64);
    unsafe {
        *(((ctx.bb_skip as usize) + then_bb) as *mut u8) = 1u8;
        *(((ctx.bb_skip as usize) + else_bb) as *mut u8) = 1u8;
    }
    true
}

fn isel_note_use(ctx: view<IselOptCtx>, v: u32, use_bb: u32) {
    let vu = v as usize;
    if v == LIR_VREG_NONE || vu >= ctx.vreg_count {
        return;
    }
    unsafe {
        let up = ((ctx.use_cnt as usize) + (vu << 2)) as *mut u32;
        *up = *up + 1u32;
        let db = *(((ctx.def_bb as usize) + (vu << 2)) as *mut u32);
        if db != 0xFFFFFFFFu32 && db != use_bb {
            *(((ctx.cross_bb as usize) + vu) as *mut u8) = 1u8;
        }
    }
}

fn isel_note_pred(ctx: view<IselOptCtx>, target_bb: u32) {
    let tu = target_bb as usize;
    if tu < ctx.bb_count {
        unsafe {
            let pp = ((ctx.pred_cnt as usize) + (tu << 2)) as *mut u32;
            *pp = *pp + 1u32;
        }
    }
}

fn isel_sweep_dead_vregs(arena: mut_view<Arena>, ctx: view<IselOptCtx>, mi: mut_view<X64MIBody>) {
    let vcnt = ctx.vreg_count;
    let bcnt = mi.bb_count;
    if vcnt == 0 || bcnt == 0 {
        return;
    }
    let mi_uses = arena_alloc_raw(mut_view(*arena), vcnt << 2, 4) as *mut u32;
    let bb_tagged = arena_alloc_raw(mut_view(*arena), bcnt, 1);
    let uses_base = mi_uses as usize;
    let slot_offset = ctx.slot_offset;

    let mut v: usize = 0;
    while v < vcnt {
        unsafe { *((uses_base + (v << 2)) as *mut u32) = 0u32; }
        v = v + 1;
    }

    // Single counting pass over all MI instructions (no 56-byte `X64Op` copies).
    let bb_sz = size_of<X64MIBb>();
    let mut mbb_addr = mi.bbs as usize;
    let mut any_tagged = false;
    let mut b: usize = 0;
    while b < bcnt {
        let mbb = mbb_addr as *mut X64MIBb;
        let mut cur = unsafe { (*mbb).first_inst };
        let mut has_tag: u8 = 0u8;
        while (cur as usize) != 0 {
            let opc = unsafe { (*cur).opcode };
            let orig = unsafe { (*cur).origin_vreg };
            if orig != LIR_VREG_NONE && (orig as usize) < vcnt {
                has_tag = 1u8;
                any_tagged = true;
            }
            if opc == X64_MI_MOV {
                if (unsafe { (*cur).ops[1usize].kind }) == X64_OP_FRAME {
                    let sid1 = unsafe { (*cur).ops[1usize].frame.slot_id };
                    if sid1 >= slot_offset {
                        let uv1 = sid1 - slot_offset;
                        if (uv1 as usize) < vcnt && uv1 != orig {
                            let up = (uses_base + ((uv1 as usize) << 2)) as *mut u32;
                            unsafe { *up = *up + 1u32; }
                        }
                    }
                }
            } else {
                let op_cnt = unsafe { (*cur).op_count };
                if op_cnt > 0u8 {
                    let k0_wo = opc == X64_MI_LEA || opc == X64_MI_SETCC || opc == X64_MI_POP;
                    if !k0_wo && (unsafe { (*cur).ops[0usize].kind }) == X64_OP_FRAME {
                        let sid0 = unsafe { (*cur).ops[0usize].frame.slot_id };
                        if sid0 >= slot_offset {
                            let uv0 = sid0 - slot_offset;
                            if (uv0 as usize) < vcnt && uv0 != orig {
                                let up = (uses_base + ((uv0 as usize) << 2)) as *mut u32;
                                unsafe { *up = *up + 1u32; }
                            }
                        }
                    }
                    if op_cnt > 1u8 && (unsafe { (*cur).ops[1usize].kind }) == X64_OP_FRAME {
                        let sid1 = unsafe { (*cur).ops[1usize].frame.slot_id };
                        if sid1 >= slot_offset {
                            let uv1 = sid1 - slot_offset;
                            if (uv1 as usize) < vcnt && uv1 != orig {
                                let up = (uses_base + ((uv1 as usize) << 2)) as *mut u32;
                                unsafe { *up = *up + 1u32; }
                            }
                        }
                    }
                    if op_cnt > 2u8 && (unsafe { (*cur).ops[2usize].kind }) == X64_OP_FRAME {
                        let sid2 = unsafe { (*cur).ops[2usize].frame.slot_id };
                        if sid2 >= slot_offset {
                            let uv2 = sid2 - slot_offset;
                            if (uv2 as usize) < vcnt && uv2 != orig {
                                let up = (uses_base + ((uv2 as usize) << 2)) as *mut u32;
                                unsafe { *up = *up + 1u32; }
                            }
                        }
                    }
                }
            }
            cur = unsafe { (*cur).next };
        }
        unsafe { *(((bb_tagged as usize) + b) as *mut u8) = has_tag; }
        mbb_addr = mbb_addr + bb_sz;
        b = b + 1;
    }

    if !any_tagged {
        return;
    }

    // Up to 8 unlink passes (identical to original `pass < 8`), decrementing `mi_uses`
    // incrementally from only the instructions unlinked in the current pass.
    let mut pass: u32 = 0u32;
    while pass < 8u32 {
        let mut del_head: *mut X64MI = 0 as *mut X64MI;
        mbb_addr = mi.bbs as usize;
        b = 0;
        while b < bcnt {
            if (unsafe { *(((bb_tagged as usize) + b) as *mut u8) }) != 0u8 {
                let mbb = mbb_addr as *mut X64MIBb;
                let mut prev: *mut X64MI = 0 as *mut X64MI;
                let mut cur = unsafe { (*mbb).first_inst };
                let mut rem_tag: u8 = 0u8;
                while (cur as usize) != 0 {
                    let next_i = unsafe { (*cur).next };
                    let orig = unsafe { (*cur).origin_vreg };
                    if orig != LIR_VREG_NONE && (orig as usize) < vcnt {
                        if (unsafe { *((uses_base + ((orig as usize) << 2)) as *mut u32) }) == 0u32 {
                            unsafe {
                                if (prev as usize) != 0 {
                                    (*prev).next = next_i;
                                } else {
                                    (*mbb).first_inst = next_i;
                                }
                                if (next_i as usize) == 0 {
                                    (*mbb).last_inst = prev;
                                }
                                (*cur).next = del_head;
                            }
                            del_head = cur;
                            cur = next_i;
                            continue;
                        }
                        rem_tag = 1u8;
                    }
                    prev = cur;
                    cur = next_i;
                }
                unsafe { *(((bb_tagged as usize) + b) as *mut u8) = rem_tag; }
            }
            mbb_addr = mbb_addr + bb_sz;
            b = b + 1;
        }

        if (del_head as usize) == 0 {
            break;
        }

        let mut newly_zero = false;
        let mut d = del_head;
        while (d as usize) != 0 {
            let opc = unsafe { (*d).opcode };
            let op_cnt = unsafe { (*d).op_count };
            let orig = unsafe { (*d).origin_vreg };
            if op_cnt > 0u8 {
                let k0_wo = opc == X64_MI_MOV || opc == X64_MI_LEA || opc == X64_MI_SETCC || opc == X64_MI_POP;
                if !k0_wo && (unsafe { (*d).ops[0usize].kind }) == X64_OP_FRAME {
                    let sid0 = unsafe { (*d).ops[0usize].frame.slot_id };
                    if sid0 >= slot_offset {
                        let uv0 = sid0 - slot_offset;
                        if (uv0 as usize) < vcnt && uv0 != orig {
                            let up = (uses_base + ((uv0 as usize) << 2)) as *mut u32;
                            let nv = (unsafe { *up }) - 1u32;
                            unsafe { *up = nv; }
                            if nv == 0u32 {
                                newly_zero = true;
                            }
                        }
                    }
                }
                if op_cnt > 1u8 && (unsafe { (*d).ops[1usize].kind }) == X64_OP_FRAME {
                    let sid1 = unsafe { (*d).ops[1usize].frame.slot_id };
                    if sid1 >= slot_offset {
                        let uv1 = sid1 - slot_offset;
                        if (uv1 as usize) < vcnt && uv1 != orig {
                            let up = (uses_base + ((uv1 as usize) << 2)) as *mut u32;
                            let nv = (unsafe { *up }) - 1u32;
                            unsafe { *up = nv; }
                            if nv == 0u32 {
                                newly_zero = true;
                            }
                        }
                    }
                }
                if op_cnt > 2u8 && (unsafe { (*d).ops[2usize].kind }) == X64_OP_FRAME {
                    let sid2 = unsafe { (*d).ops[2usize].frame.slot_id };
                    if sid2 >= slot_offset {
                        let uv2 = sid2 - slot_offset;
                        if (uv2 as usize) < vcnt && uv2 != orig {
                            let up = (uses_base + ((uv2 as usize) << 2)) as *mut u32;
                            let nv = (unsafe { *up }) - 1u32;
                            unsafe { *up = nv; }
                            if nv == 0u32 {
                                newly_zero = true;
                            }
                        }
                    }
                }
            }
            d = unsafe { (*d).next };
        }
        if !newly_zero {
            break;
        }
        pass = pass + 1u32;
    }
}

fn isel_opt_pass1_defs_and_uses(ctx: view<IselOptCtx>, lir: view<LirBody>) {
    let bcnt = ctx.bb_count;
    let vcnt = ctx.vreg_count;
    let bb_sz = size_of<LirBb>();
    let inst_sz = size_of<LirInst>();
    let def_bb_base = ctx.def_bb as usize;
    let def_idx_base = ctx.def_idx as usize;
    let def_cnt_base = ctx.def_cnt as usize;
    let def_inst_base = ctx.def_inst as usize;

    let mut lbb_addr = lir.bbs as usize;
    let mut b: usize = 0;
    while b < bcnt {
        let lbb = lbb_addr as *mut LirBb;
        let icnt = unsafe { (*lbb).inst_count };
        let mut inst_addr = unsafe { (*lbb).insts as usize };
        let mut i: usize = 0;
        while i < icnt {
            let inst = inst_addr as *mut LirInst;
            let dv = unsafe { (*inst).dest.v };
            if dv != LIR_VREG_NONE && (dv as usize) < vcnt {
                let dvu = dv as usize;
                unsafe {
                    *((def_bb_base + (dvu << 2)) as *mut u32) = b as u32;
                    *((def_idx_base + (dvu << 3)) as *mut usize) = i;
                    let dc = (def_cnt_base + (dvu << 2)) as *mut u32;
                    *dc = *dc + 1u32;
                    *((def_inst_base + (dvu << 3)) as *mut *mut LirInst) = inst;
                }
            }
            if (unsafe { (*inst).kind }) == LIR_INST_ATOMIC_CAS {
                let okv = unsafe { (*inst).cas_ok.v };
                if okv != LIR_VREG_NONE && (okv as usize) < vcnt {
                    let okvu = okv as usize;
                    unsafe {
                        *((def_bb_base + (okvu << 2)) as *mut u32) = b as u32;
                        *((def_idx_base + (okvu << 3)) as *mut usize) = i;
                        let dc2 = (def_cnt_base + (okvu << 2)) as *mut u32;
                        *dc2 = *dc2 + 1u32;
                        *((def_inst_base + (okvu << 3)) as *mut *mut LirInst) = inst;
                    }
                }
            }
            inst_addr = inst_addr + inst_sz;
            i = i + 1;
        }
        lbb_addr = lbb_addr + bb_sz;
        b = b + 1;
    }

    lbb_addr = lir.bbs as usize;
    b = 0;
    while b < bcnt {
        let lbb = lbb_addr as *mut LirBb;
        let icnt = unsafe { (*lbb).inst_count };
        let mut inst_addr = unsafe { (*lbb).insts as usize };
        let mut i: usize = 0;
        while i < icnt {
            let inst = inst_addr as *mut LirInst;
            let k = unsafe { (*inst).kind };
            let dv = unsafe { (*inst).dest.v };
            if (k >= LIR_INST_ADD && k <= LIR_INST_SAR) ||
               (k >= LIR_INST_ICMP_EQ && k <= LIR_INST_ICMP_UGE) ||
               (k >= LIR_INST_SADD_OVERFLOW && k <= LIR_INST_UREM_OVERFLOW) ||
               k == LIR_INST_UDIV || k == LIR_INST_UREM || k == LIR_INST_OFFSET {
                isel_note_use(ctx, unsafe { (*inst).lhs.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).rhs.v }, b as u32);
            } else if k == LIR_INST_NEG || k == LIR_INST_NOT || k == LIR_INST_BITNOT {
                isel_note_use(ctx, unsafe { (*inst).operand.v }, b as u32);
            } else if k == LIR_INST_LOAD {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
            } else if k == LIR_INST_STORE {
                let pv = unsafe { (*inst).ptr.v };
                let vv = unsafe { (*inst).val.v };
                isel_note_use(ctx, pv, b as u32);
                isel_note_use(ctx, vv, b as u32);
                if b == 0 {
                    let mut sv: u32 = 0u32;
                    if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) && (vv as usize) < vcnt {
                        let vinst = unsafe { *((def_inst_base + ((vv as usize) << 3)) as *mut *mut LirInst) };
                        if (vinst as usize) != 0 && (unsafe { (*vinst).kind }) == LIR_INST_ABI_ARG {
                            unsafe { *(((ctx.slot_is_param as usize) + (sv as usize)) as *mut u8) = 1u8; }
                        }
                    }
                }
            } else if k == LIR_INST_ABI_ARG && dv == LIR_VREG_NONE {
                isel_note_use(ctx, unsafe { (*inst).val.v }, b as u32);
            } else if k == LIR_INST_CALL {
                if (unsafe { (*inst).dst_addr.v }) != LIR_VREG_NONE {
                    isel_note_use(ctx, unsafe { (*inst).dst_addr.v }, b as u32);
                }
                if (unsafe { (*inst).callee_vreg.v }) != LIR_VREG_NONE {
                    isel_note_use(ctx, unsafe { (*inst).callee_vreg.v }, b as u32);
                }
            } else if k == LIR_INST_ATOMIC_LOAD {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
            } else if k == LIR_INST_ATOMIC_STORE || k == LIR_INST_ATOMIC_RMW {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).val.v }, b as u32);
            } else if k == LIR_INST_ATOMIC_CAS {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).lhs.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).rhs.v }, b as u32);
            }
            inst_addr = inst_addr + inst_sz;
            i = i + 1;
        }

        let tk = unsafe { (*lbb).term.kind };
        if tk == LIR_TERM_JMP {
            isel_note_pred(ctx, unsafe { (*lbb).term.jmp_target.v });
        } else if tk == LIR_TERM_JCC {
            isel_note_use(ctx, unsafe { (*lbb).term.cond.v }, b as u32);
            isel_note_pred(ctx, unsafe { (*lbb).term.then_target.v });
            isel_note_pred(ctx, unsafe { (*lbb).term.else_target.v });
        } else if tk == LIR_TERM_SWITCH {
            isel_note_use(ctx, unsafe { (*lbb).term.cond.v }, b as u32);
            let sc = unsafe { (*lbb).term.count };
            let mut k: usize = 0;
            while k < sc {
                let tp = unsafe { lir_switch_target_at((*lbb).term.targets, k) };
                isel_note_pred(ctx, unsafe { (*tp).target.v });
                k = k + 1;
            }
            isel_note_pred(ctx, unsafe { (*lbb).term.otherwise.v });
        } else if tk == LIR_TERM_ASSERT {
            isel_note_use(ctx, unsafe { (*lbb).term.cond.v }, b as u32);
            isel_note_pred(ctx, unsafe { (*lbb).term.assert_target.v });
        }
        lbb_addr = lbb_addr + bb_sz;
        b = b + 1;
    }
}

fn isel_opt_pass2_slots(ctx: view<IselOptCtx>, lir: view<LirBody>, interner: view<TypeInterner>) {
    let bcnt = ctx.bb_count;
    let vcnt = ctx.vreg_count;
    let scnt = ctx.slot_count;
    let bb_sz = size_of<LirBb>();
    let inst_sz = size_of<LirInst>();
    let use_cnt_base = ctx.use_cnt as usize;
    let cross_bb_base = ctx.cross_bb as usize;
    let slot_esc_base = ctx.slot_escaped as usize;
    let slot_ld_base = ctx.slot_load_cnt as usize;
    let slot_st_base = ctx.slot_store_cnt as usize;
    let mut lbb_addr = lir.bbs as usize;
    let mut b: usize = 0;
    while b < bcnt {
        let lbb = lbb_addr as *mut LirBb;
        let icnt = unsafe { (*lbb).inst_count };
        let mut inst_addr = unsafe { (*lbb).insts as usize };
        let mut i: usize = 0;
        while i < icnt {
            let inst = inst_addr as *mut LirInst;
            let k = unsafe { (*inst).kind };
            let dv = unsafe { (*inst).dest.v };
            if k == LIR_INST_STACK_ADDR {
                let sv = unsafe { (*inst).slot.v as usize };
                if sv < scnt {
                    let dvu = dv as usize;
                    if dvu >= vcnt ||
                       (unsafe { *((use_cnt_base + (dvu << 2)) as *mut u32) }) != 1u32 ||
                       (unsafe { *((cross_bb_base + dvu) as *mut u8) }) != 0u8 {
                        unsafe { *((slot_esc_base + sv) as *mut u8) = 1u8; }
                    }
                }
            } else if k == LIR_INST_LOAD {
                let pv = unsafe { (*inst).ptr.v };
                let mut sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) && (sv as usize) < scnt {
                    let slot_ty = unsafe { (*lir_slot_at(lir.slots, sv as usize)).ty };
                    let ld_ty = unsafe { (*inst).ty };
                    let sz = x64_cached_type_size(TypeId { v: ld_ty.v }, interner);
                    if ld_ty.v == slot_ty.v && (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) {
                        unsafe {
                            let lp = (slot_ld_base + ((sv as usize) << 2)) as *mut u32;
                            *lp = *lp + 1u32;
                        }
                    } else {
                        unsafe { *((slot_esc_base + (sv as usize)) as *mut u8) = 1u8; }
                    }
                }
            } else if k == LIR_INST_STORE {
                let pv = unsafe { (*inst).ptr.v };
                let vv = unsafe { (*inst).val.v };
                let mut v_sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, vv, mut_view(v_sv)) && (v_sv as usize) < scnt {
                    unsafe { *((slot_esc_base + (v_sv as usize)) as *mut u8) = 1u8; }
                }
                let mut sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) && (sv as usize) < scnt {
                    let slot_ty = unsafe { (*lir_slot_at(lir.slots, sv as usize)).ty };
                    let val_ty = isel_vreg_ty(lir, vv);
                    let sz = x64_cached_type_size(TypeId { v: val_ty.v }, interner);
                    if val_ty.v == slot_ty.v && (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) {
                        unsafe {
                            let sp = (slot_st_base + ((sv as usize) << 2)) as *mut u32;
                            *sp = *sp + 1u32;
                        }
                    } else {
                        unsafe { *((slot_esc_base + (sv as usize)) as *mut u8) = 1u8; }
                    }
                }
            } else {
                let mut s0: u32 = 0u32;
                if (k >= LIR_INST_ADD && k <= LIR_INST_SAR) ||
                   (k >= LIR_INST_ICMP_EQ && k <= LIR_INST_ICMP_UGE) ||
                   (k >= LIR_INST_SADD_OVERFLOW && k <= LIR_INST_UREM_OVERFLOW) ||
                   k == LIR_INST_UDIV || k == LIR_INST_UREM || k == LIR_INST_OFFSET {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).lhs.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).rhs.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                } else if k == LIR_INST_NEG || k == LIR_INST_NOT || k == LIR_INST_BITNOT {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).operand.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                } else if k == LIR_INST_ABI_ARG && dv == LIR_VREG_NONE {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).val.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                } else if k == LIR_INST_CALL {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).dst_addr.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).callee_vreg.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                } else if k == LIR_INST_ATOMIC_LOAD {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).ptr.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                } else if k == LIR_INST_ATOMIC_STORE || k == LIR_INST_ATOMIC_RMW {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).ptr.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).val.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                } else if k == LIR_INST_ATOMIC_CAS {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).ptr.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).lhs.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).rhs.v }, mut_view(s0)) {
                        unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
                    }
                }
            }
            inst_addr = inst_addr + inst_sz;
            i = i + 1;
        }
        let tk = unsafe { (*lbb).term.kind };
        if tk == LIR_TERM_JCC || tk == LIR_TERM_SWITCH || tk == LIR_TERM_ASSERT {
            let mut s0: u32 = 0u32;
            if isel_vreg_is_stack_addr(ctx, unsafe { (*lbb).term.cond.v }, mut_view(s0)) {
                unsafe { *((slot_esc_base + (s0 as usize)) as *mut u8) = 1u8; }
            }
        }
        lbb_addr = lbb_addr + bb_sz;
        b = b + 1;
    }
}

fn isel_opt_pass3_aliases(
    arena: mut_view<Arena>,
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) {
    let bcnt = ctx.bb_count;
    let vcnt = ctx.vreg_count;
    let scnt = ctx.slot_count;
    let s_alloc = if scnt > 0 { scnt } else { 1 };
    let st_epoch = arena_alloc_raw(mut_view(*arena), s_alloc << 2, 4) as *mut u32;
    let st_val = arena_alloc_raw(mut_view(*arena), s_alloc << 2, 4) as *mut u32;
    let st_epoch_base = st_epoch as usize;
    let st_val_base = st_val as usize;
    let mut z: usize = 0;
    while z < s_alloc {
        unsafe { *((st_epoch_base + (z << 2)) as *mut u32) = 0u32; }
        z = z + 1;
    }

    let bb_sz = size_of<LirBb>();
    let inst_sz = size_of<LirInst>();
    let slot_esc_base = ctx.slot_escaped as usize;
    let slot_param_base = ctx.slot_is_param as usize;
    let slot_st_base = ctx.slot_store_cnt as usize;
    let slot_ld_base = ctx.slot_load_cnt as usize;
    let def_cnt_base = ctx.def_cnt as usize;
    let def_bb_base = ctx.def_bb as usize;
    let cross_bb_base = ctx.cross_bb as usize;
    let alias_base = ctx.vreg_alias as usize;

    let mut cur_epoch: u32 = 0u32;
    let mut lbb_addr = lir.bbs as usize;
    let mut b: usize = 0;
    while b < bcnt {
        cur_epoch = cur_epoch + 1u32;
        let lbb = lbb_addr as *mut LirBb;
        let icnt = unsafe { (*lbb).inst_count };
        let mut inst_addr = unsafe { (*lbb).insts as usize };
        let mut i: usize = 0;
        while i < icnt {
            let inst = inst_addr as *mut LirInst;
            let k = unsafe { (*inst).kind };
            if (k >= LIR_INST_ATOMIC_LOAD && k <= LIR_INST_FENCE) || k == LIR_INST_CALL {
                cur_epoch = cur_epoch + 1u32;
            } else if k == LIR_INST_STORE {
                let pv = unsafe { (*inst).ptr.v };
                let vv = unsafe { (*inst).val.v };
                let mut sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) {
                    let s = sv as usize;
                    if s > 0 && s < scnt &&
                       (unsafe { *((slot_esc_base + s) as *mut u8) }) == 0u8 &&
                       (unsafe { *((slot_st_base + (s << 2)) as *mut u32) }) == 1u32 {
                        unsafe {
                            *((st_epoch_base + (s << 2)) as *mut u32) = cur_epoch;
                            *((st_val_base + (s << 2)) as *mut u32) = vv;
                        }
                        if (unsafe { *((slot_param_base + s) as *mut u8) }) == 0u8 {
                            let slot_ty_v = unsafe { (*lir_slot_at(lir.slots, s)).ty.v };
                            let sty = TypeId { v: slot_ty_v };
                            if isel_type_can_prop_const(sty, interner) {
                                let mut cval: i64 = 0i64;
                                if isel_vreg_const(ctx, lir, interner, vv, mut_view(cval)) {
                                    let v_ty = isel_vreg_ty(lir, vv);
                                    let c0 = isel_norm_const_to_ty(v_ty, interner, cval as u64);
                                    let c_slot = isel_norm_const_to_ty(TypeId { v: slot_ty_v }, interner, c0 as u64);
                                    unsafe {
                                        *(((ctx.slot_const_ok as usize) + s) as *mut u8) = 1u8;
                                        *(((ctx.slot_const_val as usize) + (s << 3)) as *mut i64) = c_slot;
                                    }
                                }
                            }
                        }
                    }
                }
            } else if k == LIR_INST_LOAD {
                let pv = unsafe { (*inst).ptr.v };
                let dv = unsafe { (*inst).dest.v };
                let mut sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) {
                    let s = sv as usize;
                    if s > 0 && s < scnt &&
                       (unsafe { *((slot_esc_base + s) as *mut u8) }) == 0u8 &&
                       (unsafe { *((slot_st_base + (s << 2)) as *mut u32) }) == 1u32 &&
                       (unsafe { *((st_epoch_base + (s << 2)) as *mut u32) }) == cur_epoch {
                        let d_ty = isel_vreg_ty(lir, dv);
                        let ld_ty = unsafe { (*inst).ty };
                        let slot_ty = unsafe { (*lir_slot_at(lir.slots, s)).ty };
                        let d_sz = x64_cached_type_size(TypeId { v: d_ty.v }, interner);
                        if d_sz == 8u32 && ld_ty.v == d_ty.v && slot_ty.v == d_ty.v &&
                           i > 0 && (dv as usize) < vcnt &&
                           (unsafe { *((cross_bb_base + (dv as usize)) as *mut u8) }) == 0u8 {
                            let st_vv = unsafe { *((st_val_base + (s << 2)) as *mut u32) };
                            let v_ty = isel_vreg_ty(lir, st_vv);
                            if v_ty.v == d_ty.v && (st_vv as usize) < vcnt &&
                               (unsafe { *((def_cnt_base + ((st_vv as usize) << 2)) as *mut u32) }) == 1u32 &&
                               (unsafe { *((def_bb_base + ((st_vv as usize) << 2)) as *mut u32) }) == (b as u32) {
                                unsafe {
                                    *((alias_base + ((dv as usize) << 2)) as *mut u32) = st_vv;
                                    if (*((slot_ld_base + (s << 2)) as *mut u32)) == 1u32 &&
                                       (*((slot_param_base + s) as *mut u8)) == 0u8 {
                                        *(((ctx.slot_single_bb as usize) + s) as *mut u8) = 1u8;
                                        *(((ctx.slot_single_ld_v as usize) + (s << 2)) as *mut u32) = dv;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            inst_addr = inst_addr + inst_sz;
            i = i + 1;
        }
        lbb_addr = lbb_addr + bb_sz;
        b = b + 1;
    }
}

fn isel_opt_lower_terminator(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    b: usize,
    lbb: *mut LirBb
) {
    let term_kind = unsafe { (*lbb).term.kind };
    if term_kind == LIR_TERM_SWITCH {
        let cond_v = unsafe { (*lbb).term.cond.v };
        let t_count = unsafe { (*lbb).term.count };
        let targets_base = unsafe { (*lbb).term.targets };
        let otherwise_v = unsafe { (*lbb).term.otherwise.v };
        if t_count == 1 &&
           (unsafe { (*lir_switch_target_at(targets_base, 0)).val }) == 0u64 &&
           isel_vreg_is_scalar_gpr(lir, interner, cond_v) {
            let t0_bb = unsafe { (*lir_switch_target_at(targets_base, 0)).target.v as i64 };
            let cc: u8 = isel_emit_cond_flags_for_branch(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), b as u32, cond_v);
            let inv_cc = x64_cc_invert(cc);
            isel_mi_ii(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, inv_cc as i64, t0_bb);
            isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, otherwise_v as i64);
        } else {
            let cond_ty_v = isel_vreg_ty(lir, cond_v).v;
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_R10, cond_v);
            let mut k: usize = 0;
            while k < t_count {
                let tp = unsafe { lir_switch_target_at(targets_base, k) };
                let t_val = isel_norm_const_to_ty(TypeId { v: cond_ty_v }, interner, unsafe { (*tp).val });
                let t_bb = unsafe { (*tp).target.v as i64 };
                if isel_fits_i32(t_val) {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_R10, t_val);
                } else {
                    isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_R11, t_val);
                    isel_mi_rr(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_R10, REG_R11);
                }
                isel_mi_ii(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, CC_E as i64, t_bb);
                k = k + 1;
            }
            isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, otherwise_v as i64);
        }
    } else if term_kind == LIR_TERM_JCC {
        let cond_v = unsafe { (*lbb).term.cond.v };
        let then_v = unsafe { (*lbb).term.then_target.v };
        let else_v = unsafe { (*lbb).term.else_target.v };
        if isel_vreg_is_scalar_gpr(lir, interner, cond_v) {
            let cc: u8 = isel_emit_cond_flags_for_branch(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), b as u32, cond_v);
            isel_mi_ii(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, cc as i64, then_v as i64);
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, cond_v);
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, 0i64);
            isel_mi_ii(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, CC_NE as i64, then_v as i64);
        }
        isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, else_v as i64);
    } else if term_kind == LIR_TERM_ASSERT {
        let cond_v = unsafe { (*lbb).term.cond.v };
        let target_v = unsafe { (*lbb).term.assert_target.v };
        let msg_ptr = unsafe { (*lbb).term.msg_ptr };
        let msg_len = unsafe { (*lbb).term.msg_len };
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, cond_v);
        isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, REG_RAX, 1i64);
        let assert_mi = isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_ASSERT, target_v as i64);
        unsafe {
            (*assert_mi).msg = msg_ptr;
            (*assert_mi).msg_len = msg_len;
        }
    } else if term_kind == LIR_TERM_JMP {
        let jmp_v = unsafe { (*lbb).term.jmp_target.v };
        isel_mi_i(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, jmp_v as i64);
    } else if term_kind == LIR_TERM_RETURN {
        let s0_ty = isel_slot0_ty(lir);
        let ret_ty = type_get(interner, s0_ty);
        let mut is_unit = false;
        if (ret_ty as usize) != 0 {
            let rk = unsafe { (*ret_ty).kind };
            if rk == TY_UNIT {
                is_unit = true;
            }
        }
        if is_unit {
            isel_mi_ri(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0i64);
        } else {
            isel_mi_rf(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, REG_RAX, 0u32, 0);
        }
        isel_mi_0(mut_view(*mi), mut_view(*mbb), X64_MI_RET);
    }
}

pub fn x64_isel_opt_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    opt_enabled: bool
) -> *mut X64MIBody {
    if !opt_enabled {
        return x64_isel_raw_in_arena(mut_view(*arena), lir, interner);
    }

    let mi = x64_mi_body_new(mut_view(*arena), lir.bb_count);
    unsafe {
        (*mi).shadow_space = lir.frame_req.max_outgoing_args_bytes;
        (*mi).stack_args_size = 0u32;
        (*mi).is_opt = true;
    }

    let slot_offset = lir.slot_count as u32;
    let mut callee_ret_in_mem = false;
    if lir.slot_count > 0 {
        let s0_ty = isel_slot0_ty(lir);
        let ret_size = x64_cached_type_size(s0_ty, interner);
        callee_ret_in_mem = isel_type_is_ret_in_mem(ret_size);
    }

    let vcnt = lir.vreg_count;
    let scnt = lir.slot_count;
    let bcnt = lir.bb_count;
    let v_alloc = if vcnt > 0 { vcnt } else { 1 };
    let s_alloc = if scnt > 0 { scnt } else { 1 };
    let b_alloc = if bcnt > 0 { bcnt } else { 1 };

    let def_bb = arena_alloc_raw(mut_view(*arena), v_alloc << 2, 4) as *mut u32;
    let def_idx = arena_alloc_raw(mut_view(*arena), v_alloc << 3, 8) as *mut usize;
    let def_cnt = arena_alloc_raw(mut_view(*arena), v_alloc << 2, 4) as *mut u32;
    let def_inst = arena_alloc_raw(mut_view(*arena), v_alloc << 3, 8) as *mut *mut LirInst;
    let use_cnt = arena_alloc_raw(mut_view(*arena), v_alloc << 2, 4) as *mut u32;
    let cross_bb = arena_alloc_raw(mut_view(*arena), v_alloc, 1) as *mut u8;
    let vreg_alias = arena_alloc_raw(mut_view(*arena), v_alloc << 2, 4) as *mut u32;

    let slot_escaped = arena_alloc_raw(mut_view(*arena), s_alloc, 1) as *mut u8;
    let slot_is_param = arena_alloc_raw(mut_view(*arena), s_alloc, 1) as *mut u8;
    let slot_store_cnt = arena_alloc_raw(mut_view(*arena), s_alloc << 2, 4) as *mut u32;
    let slot_load_cnt = arena_alloc_raw(mut_view(*arena), s_alloc << 2, 4) as *mut u32;
    let slot_const_ok = arena_alloc_raw(mut_view(*arena), s_alloc, 1) as *mut u8;
    let slot_const_val = arena_alloc_raw(mut_view(*arena), s_alloc << 3, 8) as *mut i64;
    let slot_single_bb = arena_alloc_raw(mut_view(*arena), s_alloc, 1) as *mut u8;
    let slot_single_ld_v = arena_alloc_raw(mut_view(*arena), s_alloc << 2, 4) as *mut u32;

    let pred_cnt = arena_alloc_raw(mut_view(*arena), b_alloc << 2, 4) as *mut u32;
    let bb_skip = arena_alloc_raw(mut_view(*arena), b_alloc, 1) as *mut u8;

    let mut vi: usize = 0;
    while vi < v_alloc {
        let off4 = vi << 2;
        let off8 = vi << 3;
        unsafe {
            *(((def_bb as usize) + off4) as *mut u32) = 0xFFFFFFFFu32;
            *(((def_idx as usize) + off8) as *mut usize) = 0;
            *(((def_cnt as usize) + off4) as *mut u32) = 0u32;
            *(((def_inst as usize) + off8) as *mut *mut LirInst) = 0 as *mut LirInst;
            *(((use_cnt as usize) + off4) as *mut u32) = 0u32;
            *(((cross_bb as usize) + vi) as *mut u8) = 0u8;
            *(((vreg_alias as usize) + off4) as *mut u32) = LIR_VREG_NONE;
        }
        vi = vi + 1;
    }

    let mut si: usize = 0;
    while si < s_alloc {
        let off4 = si << 2;
        let off8 = si << 3;
        unsafe {
            *(((slot_escaped as usize) + si) as *mut u8) = 0u8;
            *(((slot_is_param as usize) + si) as *mut u8) = 0u8;
            *(((slot_store_cnt as usize) + off4) as *mut u32) = 0u32;
            *(((slot_load_cnt as usize) + off4) as *mut u32) = 0u32;
            *(((slot_const_ok as usize) + si) as *mut u8) = 0u8;
            *(((slot_const_val as usize) + off8) as *mut i64) = 0i64;
            *(((slot_single_bb as usize) + si) as *mut u8) = 0u8;
            *(((slot_single_ld_v as usize) + off4) as *mut u32) = LIR_VREG_NONE;
        }
        si = si + 1;
    }
    unsafe {
        *slot_escaped = 1u8;
    }

    let mut bi: usize = 0;
    while bi < b_alloc {
        unsafe {
            *(((pred_cnt as usize) + (bi << 2)) as *mut u32) = 0u32;
            *(((bb_skip as usize) + bi) as *mut u8) = 0u8;
        }
        bi = bi + 1;
    }

    let mut ctx = IselOptCtx {
        slot_offset: slot_offset,
        ret_in_mem: callee_ret_in_mem,
        vreg_count: vcnt,
        slot_count: scnt,
        bb_count: bcnt,
        def_bb: def_bb,
        def_idx: def_idx,
        def_cnt: def_cnt,
        def_inst: def_inst,
        use_cnt: use_cnt,
        cross_bb: cross_bb,
        vreg_alias: vreg_alias,
        slot_escaped: slot_escaped,
        slot_is_param: slot_is_param,
        slot_store_cnt: slot_store_cnt,
        slot_load_cnt: slot_load_cnt,
        slot_const_ok: slot_const_ok,
        slot_const_val: slot_const_val,
        slot_single_bb: slot_single_bb,
        slot_single_ld_v: slot_single_ld_v,
        pred_cnt: pred_cnt,
        bb_skip: bb_skip,
        vreg_const_state: 0 as *mut u8,
        vreg_const_val: 0 as *mut i64,
    };

    isel_opt_pass1_defs_and_uses(view(ctx), lir);
    isel_opt_pass2_slots(view(ctx), lir, interner);
    isel_opt_pass3_aliases(mut_view(*arena), view(ctx), lir, interner);

    let vreg_const_state = arena_alloc_raw(mut_view(*arena), v_alloc, 1) as *mut u8;
    let vreg_const_val = arena_alloc_raw(mut_view(*arena), v_alloc << 3, 8) as *mut i64;
    let mut vc_i: usize = 0;
    while vc_i < v_alloc {
        unsafe { *(((vreg_const_state as usize) + vc_i) as *mut u8) = 0u8; }
        vc_i = vc_i + 1;
    }
    ctx.vreg_const_state = vreg_const_state;
    ctx.vreg_const_val = vreg_const_val;

    let lbb_sz = size_of<LirBb>();
    let mbb_sz = size_of<X64MIBb>();
    let linst_sz = size_of<LirInst>();
    let mut lbb_addr = lir.bbs as usize;
    let mut mbb_addr = unsafe { (*mi).bbs as usize };
    let mut b: usize = 0;
    while b < bcnt {
        let lbb = lbb_addr as *mut LirBb;
        let mbb = mbb_addr as *mut X64MIBb;
        unsafe {
            (*mbb).id = b as u32;
            (*mbb).first_inst = 0 as *mut X64MI;
            (*mbb).last_inst = 0 as *mut X64MI;
        }

        if (unsafe { *(((bb_skip as usize) + b) as *mut u8) }) != 0u8 {
            lbb_addr = lbb_addr + lbb_sz;
            mbb_addr = mbb_addr + mbb_sz;
            b = b + 1;
            continue;
        }

        if b == 0 && callee_ret_in_mem {
            unsafe {
                isel_mi_fr(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, 0u32, 0, REG_RCX);
            }
        }

        let icnt = unsafe { (*lbb).inst_count };
        let mut inst_addr = unsafe { (*lbb).insts as usize };
        let mut i: usize = 0;
        while i < icnt {
            let inst = inst_addr as *mut LirInst;
            unsafe {
                isel_opt_lower_inst(view(ctx), lir, interner, mut_view(*mi), mut_view(*mbb), b as u32, i, inst);
            }
            inst_addr = inst_addr + linst_sz;
            i = i + 1;
        }

        let converted = unsafe { isel_try_if_convert_diamond(view(ctx), lir, interner, mut_view(*mi), mut_view(*mbb), b) };
        if !converted {
            unsafe {
                isel_opt_lower_terminator(view(ctx), lir, interner, mut_view(*mi), mut_view(*mbb), b, lbb);
            }
        }

        lbb_addr = lbb_addr + lbb_sz;
        mbb_addr = mbb_addr + mbb_sz;
        b = b + 1;
    }

    unsafe {
        isel_sweep_dead_vregs(mut_view(*arena), view(ctx), mut_view(*mi));
    }

    mi
}

pub fn x64_isel_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> *mut X64MIBody {
    x64_isel_opt_in_arena(mut_view(*arena), lir, interner, lir.is_opt)
}

pub fn x64_isel(lir: view<LirBody>, interner: view<TypeInterner>) -> *mut X64MIBody {
    unsafe {
        x64_isel_in_arena(mut_view(*lir.arena), lir, interner)
    }
}

pub fn ax_x64_isel(lir: view<LirBody>, interner: view<TypeInterner>) -> *mut X64MIBody {
    x64_isel(lir, interner)
}
