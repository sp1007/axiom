fn isel_mi_fr(mi: mut_view<X64MIBody>, mbb: mut_view<X64MIBb>, opc: u32, slot: u32, off: i32, r1: i32) -> *mut X64MI {
    let mut inst: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        let arena = mi.arena;
        let mi_sz: usize = size_of<X64MI>();
        let cur = (*arena).current;
