@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// =============================================================================
// 1. x86-64 Machine IR Data Model (target/x64/mir/mi.h)
// =============================================================================

@derive(Copy)
pub struct X64FrameOp {
    pub slot_id: u32,
    pub offset: i32,
}

// Machine operand (56 bytes <= 64-byte interp limit).
// Both `op.frame.{slot_id, offset}` and flat `op.{slot_id, offset}` are kept in sync.
@derive(Copy)
pub struct X64Op {
    pub kind: u32,
    pub reg: i32,
    pub imm: i64,
    pub mem: X64Mem,
    pub frame: X64FrameOp,
    pub slot_id: u32,
    pub offset: i32,
    pub sym: u32,
}

pub fn x64_op_none() -> X64Op {
    X64Op {
        kind: X64_OP_NONE,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_none() -> X64Op {
    x64_op_none()
}

pub fn x64_op_reg(reg: i32) -> X64Op {
    X64Op {
        kind: X64_OP_REG,
        reg: reg,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_reg(reg: i32) -> X64Op {
    x64_op_reg(reg)
}

pub fn x64_op_imm(imm: i64) -> X64Op {
    X64Op {
        kind: X64_OP_IMM,
        reg: REG_NONE,
        imm: imm,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_imm(imm: i64) -> X64Op {
    x64_op_imm(imm)
}

pub fn x64_op_mem(base: i32, index: i32, scale: u8, disp: i32, is_rip: bool) -> X64Op {
    X64Op {
        kind: X64_OP_MEM,
        reg: REG_NONE,
        imm: 0i64,
        mem: X64Mem {
            base: base,
            index: index,
            scale: scale,
            disp: disp,
            is_rip: is_rip,
        },
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_mem(base: i32, index: i32, scale: u8, disp: i32, is_rip: bool) -> X64Op {
    x64_op_mem(base, index, scale, disp, is_rip)
}

pub fn x64_op_mem_struct(mem: X64Mem) -> X64Op {
    X64Op {
        kind: X64_OP_MEM,
        reg: REG_NONE,
        imm: 0i64,
        mem: mem,
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn x64_op_frame(slot_id: u32, offset: i32) -> X64Op {
    X64Op {
        kind: X64_OP_FRAME,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: slot_id, offset: offset },
        slot_id: slot_id,
        offset: offset,
        sym: 0u32,
    }
}

pub fn ax_x64_op_frame(slot_id: u32, offset: i32) -> X64Op {
    x64_op_frame(slot_id, offset)
}

pub fn x64_op_sym(sym: u32) -> X64Op {
    X64Op {
        kind: X64_OP_SYM,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: sym,
    }
}

pub fn ax_x64_op_sym(sym: u32) -> X64Op {
    x64_op_sym(sym)
}

// Machine instruction node (intrusively linked per basic block).
// Note: X64MI is > 64 bytes; always allocate via `x64_mi_new` in an Arena and access via pointer/view.
pub struct X64MI {
    pub opcode: u32,
    pub ops: [3]X64Op,
    pub op_count: u8,
    pub size: u8,
    pub sz: u8,
    pub msg: *const u8,
    pub msg_len: usize,
    pub next: *mut X64MI,
}

pub struct X64MIBb {
    pub id: u32,
    pub first_inst: *mut X64MI,
    pub last_inst: *mut X64MI,
}

pub struct X64MIStr {
    pub bytes: *const u8,
    pub len: usize,
    pub sym_id: u32,
}

pub struct X64MIBody {
    pub arena: *mut Arena,
    pub bbs: *mut X64MIBb,
    pub bb_count: usize,
    pub shadow_space: u32,
    pub stack_args_size: u32,
    pub strings: *mut X64MIStr,
    pub string_count: usize,
    pub string_cap: usize,
}

pub unsafe fn x64_mi_bb_at(base: *mut X64MIBb, idx: usize) -> *mut X64MIBb {
    let off = lir_mul_usize(idx, size_of<X64MIBb>());
    ((base as usize) + off) as *mut X64MIBb
}

pub unsafe fn x64_mi_str_at(base: *mut X64MIStr, idx: usize) -> *mut X64MIStr {
    let off = lir_mul_usize(idx, size_of<X64MIStr>());
    ((base as usize) + off) as *mut X64MIStr
}

pub fn x64_mi_reset(mi: mut_view<X64MI>, opcode: u32) {
    mi.opcode = opcode;
    let none = x64_op_none();
    mi.ops[0usize] = none;
    mi.ops[1usize] = none;
    mi.ops[2usize] = none;
    mi.op_count = 0u8;
    mi.size = 8u8;
    mi.sz = 8u8;
    mi.msg = 0 as *const u8;
    mi.msg_len = 0;
    mi.next = 0 as *mut X64MI;
}

pub fn x64_mi_set_size(mi: mut_view<X64MI>, sz: u8) {
    mi.size = sz;
    mi.sz = sz;
}

pub fn x64_mi_new(arena: mut_view<Arena>, opcode: u32) -> *mut X64MI {
    let raw = arena_alloc_raw(arena, size_of<X64MI>(), align_of<X64MI>()) as *mut X64MI;
    unsafe {
        x64_mi_reset(mut_view(*raw), opcode);
    }
    raw
}

pub fn ax_x64_mi_new(arena: mut_view<Arena>, opcode: u32) -> *mut X64MI {
    x64_mi_new(arena, opcode)
}

pub fn x64_mi_add_op(mi: mut_view<X64MI>, op: X64Op) {
    let cnt = mi.op_count;
    if cnt < 3u8 {
        let idx = cnt as usize;
        mi.ops[idx] = op;
        mi.op_count = cnt + 1u8;
    }
}

pub fn ax_x64_mi_add_op(mi: mut_view<X64MI>, op: X64Op) {
    x64_mi_add_op(mut_view(*mi), op);
}

pub fn x64_mi_bb_reset(bb: mut_view<X64MIBb>, id: u32) {
    bb.id = id;
    bb.first_inst = 0 as *mut X64MI;
    bb.last_inst = 0 as *mut X64MI;
}

pub fn x64_mi_body_reset(body: mut_view<X64MIBody>, arena_ptr: *mut Arena) {
    body.arena = arena_ptr;
    body.bbs = 0 as *mut X64MIBb;
    body.bb_count = 0;
    body.shadow_space = 0u32;
    body.stack_args_size = 0u32;
    body.strings = 0 as *mut X64MIStr;
    body.string_count = 0;
    body.string_cap = 0;
}

pub fn x64_mi_body_new(arena: mut_view<Arena>, bb_count: usize) -> *mut X64MIBody {
    let body = arena_alloc_raw(mut_view(*arena), size_of<X64MIBody>(), align_of<X64MIBody>()) as *mut X64MIBody;
    let mut bbs: *mut X64MIBb = 0 as *mut X64MIBb;
    if bb_count > 0 {
        let bbs_bytes = lir_mul_usize(bb_count, size_of<X64MIBb>());
        bbs = arena_alloc_raw(mut_view(*arena), bbs_bytes, align_of<X64MIBb>()) as *mut X64MIBb;
    }
    let arena_ptr = unsafe { address_of_mut(arena.head) as *mut Arena };
    unsafe {
        x64_mi_body_reset(mut_view(*body), arena_ptr);
        (*body).bb_count = bb_count;
        if bb_count > 0 {
            let mut b: usize = 0;
            while b < bb_count {
                let mbb = x64_mi_bb_at(bbs, b);
                x64_mi_bb_reset(mut_view(*mbb), b as u32);
                b = b + 1;
            }
            (*body).bbs = bbs;
        }
    }
    body
}

pub fn ax_x64_mi_body_new(arena: mut_view<Arena>, bb_count: usize) -> *mut X64MIBody {
    x64_mi_body_new(mut_view(*arena), bb_count)
}

pub fn x64_mi_emit_sz(
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    sz: u8,
    op1: X64Op,
    op2: X64Op
) -> *mut X64MI {
    let inst = unsafe { x64_mi_new(mut_view(*body.arena), opc) };
    unsafe {
        x64_mi_set_size(mut_view(*inst), sz);
        if op1.kind != X64_OP_NONE {
            x64_mi_add_op(mut_view(*inst), op1);
        }
        if op2.kind != X64_OP_NONE {
            x64_mi_add_op(mut_view(*inst), op2);
        }
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

pub fn x64_mi_emit(
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    op1: X64Op,
    op2: X64Op
) -> *mut X64MI {
    x64_mi_emit_sz(mut_view(*body), mut_view(*mbb), opc, 8u8, op1, op2)
}

pub fn x64_mi_add_string(body: mut_view<X64MIBody>, bytes: *const u8, str_len: usize) -> u32 {
    let sym_id = (100000 + body.string_count) as u32;
    if body.string_count >= body.string_cap {
        let new_cap = if body.string_cap == 0 { 16 } else { lir_mul_usize(body.string_cap, 2) };
        let new_bytes = lir_mul_usize(new_cap, size_of<X64MIStr>());
        let new_strings = unsafe {
            arena_alloc_raw(mut_view(*body.arena), new_bytes, align_of<X64MIStr>()) as *mut X64MIStr
        };
        if (body.strings as usize) != 0 && body.string_count > 0 {
            let copy_bytes = lir_mul_usize(body.string_count, size_of<X64MIStr>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(body.strings as *const u8, new_strings as *mut u8, copy_bytes);
            }
        }
        body.strings = new_strings;
        body.string_cap = new_cap;
    }
    let entry = unsafe { x64_mi_str_at(body.strings, body.string_count) };
    unsafe {
        (*entry).bytes = bytes;
        (*entry).len = str_len;
        (*entry).sym_id = sym_id;
    }
    body.string_count = body.string_count + 1;
    sym_id
}

// =============================================================================
// 2. Machine IR Text Printer (target/x64/mir/mi.c)
// =============================================================================

// Constant byte table for `x64_mi_print` (following `compiler/lir/lir.ax` pattern):
//   0..2   (3):  "rax"
//   3..5   (3):  "rcx"
//   6..8   (3):  "rdx"
//   9..11  (3):  "rbx"
//  12..14  (3):  "rsp"
//  15..17  (3):  "rbp"
//  18..20  (3):  "rsi"
//  21..23  (3):  "rdi"
//  24..25  (2):  "r8"
//  26..27  (2):  "r9"
//  28..30  (3):  "r10"
//  31..33  (3):  "r11"
//  34..36  (3):  "r12"
//  37..39  (3):  "r13"
//  40..42  (3):  "r14"
//  43..45  (3):  "r15"
//  46..47  (2):  "r?"
//  48..50  (3):  "rip"
//  51..53  (3):  " + "
//  54..56  (3):  " - "
//  57..63  (7):  "[frame#"
//  64..67  (4):  "sym#"
//  68..69  (2):  "  "
//  70..71  (2):  ", "
//  72..89  (18): "frame_req: shadow="
//  90..100 (11): " args_size="
// 101..102 (2):  "bb"
// 103..104 (2):  ":\n"
// 105..107 (3):  "mov"
// 108..110 (3):  "add"
// 111..113 (3):  "sub"
// 114..117 (4):  "imul"
// 118..121 (4):  "idiv"
// 122..124 (3):  "and"
// 125..126 (2):  "or"
// 127..129 (3):  "xor"
// 130..132 (3):  "shl"
// 133..135 (3):  "sar"
// 136..138 (3):  "shr"
// 139..141 (3):  "lea"
// 142..144 (3):  "cmp"
// 145..147 (3):  "jmp"
// 148..150 (3):  "jcc"
// 151..154 (4):  "call"
// 155..158 (4):  "push"
// 159..161 (3):  "pop"
// 162..166 (5):  "setcc"
// 167..169 (3):  "ret"
// 170..175 (6):  "(null)"
const MI_STR_TABLE: [176]u8 = [
    114u8, 97u8, 120u8,
    114u8, 99u8, 120u8,
    114u8, 100u8, 120u8,
    114u8, 98u8, 120u8,
    114u8, 115u8, 112u8,
    114u8, 98u8, 112u8,
    114u8, 115u8, 105u8,
    114u8, 100u8, 105u8,
    114u8, 56u8,
    114u8, 57u8,
    114u8, 49u8, 48u8,
    114u8, 49u8, 49u8,
    114u8, 49u8, 50u8,
    114u8, 49u8, 51u8,
    114u8, 49u8, 52u8,
    114u8, 49u8, 53u8,
    114u8, 63u8,
    114u8, 105u8, 112u8,
    32u8, 43u8, 32u8,
    32u8, 45u8, 32u8,
    91u8, 102u8, 114u8, 97u8, 109u8, 101u8, 35u8,
    115u8, 121u8, 109u8, 35u8,
    32u8, 32u8,
    44u8, 32u8,
    102u8, 114u8, 97u8, 109u8, 101u8, 95u8, 114u8, 101u8, 113u8, 58u8, 32u8, 115u8, 104u8, 97u8, 100u8, 111u8, 119u8, 61u8,
    32u8, 97u8, 114u8, 103u8, 115u8, 95u8, 115u8, 105u8, 122u8, 101u8, 61u8,
    98u8, 98u8,
    58u8, 10u8,
    109u8, 111u8, 118u8,
    97u8, 100u8, 100u8,
    115u8, 117u8, 98u8,
    105u8, 109u8, 117u8, 108u8,
    105u8, 100u8, 105u8, 118u8,
    97u8, 110u8, 100u8,
    111u8, 114u8,
    120u8, 111u8, 114u8,
    115u8, 104u8, 108u8,
    115u8, 97u8, 114u8,
    115u8, 104u8, 114u8,
    108u8, 101u8, 97u8,
    99u8, 109u8, 112u8,
    106u8, 109u8, 112u8,
    106u8, 99u8, 99u8,
    99u8, 97u8, 108u8, 108u8,
    112u8, 117u8, 115u8, 104u8,
    112u8, 111u8, 112u8,
    115u8, 101u8, 116u8, 99u8, 99u8,
    114u8, 101u8, 116u8,
    40u8, 110u8, 117u8, 108u8, 108u8, 41u8,
];

fn mi_push_str(out: mut_view<DiagBuffer>, off: usize, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), MI_STR_TABLE[off + i]);
        i = i + 1;
    }
}

fn mi_push_reg_name(out: mut_view<DiagBuffer>, reg: i32) {
    if reg == 0 {
        mi_push_str(mut_view(*out), 0, 3);
    } else if reg == 1 {
        mi_push_str(mut_view(*out), 3, 3);
    } else if reg == 2 {
        mi_push_str(mut_view(*out), 6, 3);
    } else if reg == 3 {
        mi_push_str(mut_view(*out), 9, 3);
    } else if reg == 4 {
        mi_push_str(mut_view(*out), 12, 3);
    } else if reg == 5 {
        mi_push_str(mut_view(*out), 15, 3);
    } else if reg == 6 {
        mi_push_str(mut_view(*out), 18, 3);
    } else if reg == 7 {
        mi_push_str(mut_view(*out), 21, 3);
    } else if reg == 8 {
        mi_push_str(mut_view(*out), 24, 2);
    } else if reg == 9 {
        mi_push_str(mut_view(*out), 26, 2);
    } else if reg == 10 {
        mi_push_str(mut_view(*out), 28, 3);
    } else if reg == 11 {
        mi_push_str(mut_view(*out), 31, 3);
    } else if reg == 12 {
        mi_push_str(mut_view(*out), 34, 3);
    } else if reg == 13 {
        mi_push_str(mut_view(*out), 37, 3);
    } else if reg == 14 {
        mi_push_str(mut_view(*out), 40, 3);
    } else if reg == 15 {
        mi_push_str(mut_view(*out), 43, 3);
    } else {
        mi_push_str(mut_view(*out), 46, 2);
    }
}

fn push_u64_dec(out: mut_view<DiagBuffer>, val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(mut_view(*out), 48u8);
    } else {
        let mut digits: [20]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
        let mut v = val;
        let mut n: usize = 0;
        while v > 0u64 {
            let half = v >> 1u64;
            let r5 = (half % 5u64) as u8;
            let odd = (v & 1u64) as u8;
            let rem = r5 + r5 + odd;
            digits[n] = 48u8 + rem;
            v = half / 5u64;
            n = n + 1;
        }
        while n > 0 {
            n = n - 1;
            diag_buf_push_byte(mut_view(*out), digits[n]);
        }
    }
}

fn push_i64_dec(out: mut_view<DiagBuffer>, val: i64) {
    if val < 0i64 {
        diag_buf_push_byte(mut_view(*out), 45u8); // '-'
        // Compute magnitude of negative i64 (including INT64_MIN) without signed or unsigned overflow
        let plus1 = val + 1i64;
        let neg_plus1 = (0i64 - plus1) as u64;
        let mag = neg_plus1 + 1u64;
        push_u64_dec(mut_view(*out), mag);
    } else {
        push_u64_dec(mut_view(*out), val as u64);
    }
}

fn push_i32_abs(out: mut_view<DiagBuffer>, val: i32) {
    if val < 0 {
        let mag = (0i64 - (val as i64)) as u32;
        diag_buf_push_u32(mut_view(*out), mag);
    } else {
        diag_buf_push_u32(mut_view(*out), val as u32);
    }
}

// Match `opc_names` table in `bootstrap/axiom0/src/target/x64/mir/mi.c` byte-for-byte.
// Note: `mi.c` leaves `AX_X64_MI_MUL`, `AX_X64_MI_TEST`, and `AX_X64_MI_ASSERT` uninitialized (NULL)
// in `opc_names[]`, which `fprintf(out, "  %s", opc_names[mi->opcode])` formats as `"  (null)"`.
fn mi_push_opcode_name(out: mut_view<DiagBuffer>, opc: u32) {
    if opc == X64_MI_MOV {
        mi_push_str(mut_view(*out), 105, 3);
    } else if opc == X64_MI_ADD {
        mi_push_str(mut_view(*out), 108, 3);
    } else if opc == X64_MI_SUB {
        mi_push_str(mut_view(*out), 111, 3);
    } else if opc == X64_MI_IMUL {
        mi_push_str(mut_view(*out), 114, 4);
    } else if opc == X64_MI_IDIV {
        mi_push_str(mut_view(*out), 118, 4);
    } else if opc == X64_MI_AND {
        mi_push_str(mut_view(*out), 122, 3);
    } else if opc == X64_MI_OR {
        mi_push_str(mut_view(*out), 125, 2);
    } else if opc == X64_MI_XOR {
        mi_push_str(mut_view(*out), 127, 3);
    } else if opc == X64_MI_SHL {
        mi_push_str(mut_view(*out), 130, 3);
    } else if opc == X64_MI_SAR {
        mi_push_str(mut_view(*out), 133, 3);
    } else if opc == X64_MI_SHR {
        mi_push_str(mut_view(*out), 136, 3);
    } else if opc == X64_MI_LEA {
        mi_push_str(mut_view(*out), 139, 3);
    } else if opc == X64_MI_CMP {
        mi_push_str(mut_view(*out), 142, 3);
    } else if opc == X64_MI_JMP {
        mi_push_str(mut_view(*out), 145, 3);
    } else if opc == X64_MI_JCC {
        mi_push_str(mut_view(*out), 148, 3);
    } else if opc == X64_MI_CALL {
        mi_push_str(mut_view(*out), 151, 4);
    } else if opc == X64_MI_PUSH {
        mi_push_str(mut_view(*out), 155, 4);
    } else if opc == X64_MI_POP {
        mi_push_str(mut_view(*out), 159, 3);
    } else if opc == X64_MI_SETCC {
        mi_push_str(mut_view(*out), 162, 5);
    } else if opc == X64_MI_RET {
        mi_push_str(mut_view(*out), 167, 3);
    } else {
        mi_push_str(mut_view(*out), 170, 6);
    }
}

pub fn x64_mi_print_op(op: X64Op, out: mut_view<DiagBuffer>) {
    if op.kind == X64_OP_NONE {
    } else if op.kind == X64_OP_REG {
        let r: i32 = op.reg;
        mi_push_reg_name(mut_view(*out), r);
    } else if op.kind == X64_OP_IMM {
        let imm_v: i64 = op.imm;
        push_i64_dec(mut_view(*out), imm_v);
    } else if op.kind == X64_OP_MEM {
        let base_r: i32 = op.mem.base;
        let index_r: i32 = op.mem.index;
        let scale_u: u8 = op.mem.scale;
        let disp_i32: i32 = op.mem.disp;
        let is_rip: bool = op.mem.is_rip;
        diag_buf_push_byte(mut_view(*out), 91u8); // '['
        let mut first = true;
        if is_rip {
            mi_push_str(mut_view(*out), 48, 3); // "rip"
            first = false;
        } else if base_r != REG_NONE && base_r >= 0 && base_r <= 15 {
            mi_push_reg_name(mut_view(*out), base_r);
            first = false;
        }
        if index_r != REG_NONE && index_r >= 0 && index_r <= 15 {
            if !first {
                mi_push_str(mut_view(*out), 51, 3); // " + "
            }
            mi_push_reg_name(mut_view(*out), index_r);
            if scale_u > 0u8 {
                diag_buf_push_byte(mut_view(*out), 42u8); // '*'
                let factor = (1u32 << (scale_u as u32));
                diag_buf_push_u32(mut_view(*out), factor);
            }
            first = false;
        }
        if disp_i32 != 0 || first {
            if !first {
                if disp_i32 > 0 {
                    mi_push_str(mut_view(*out), 51, 3); // " + "
                    push_i32_abs(mut_view(*out), disp_i32);
                } else {
                    mi_push_str(mut_view(*out), 54, 3); // " - "
                    push_i32_abs(mut_view(*out), disp_i32);
                }
            } else {
                push_i64_dec(mut_view(*out), disp_i32 as i64);
            }
        }
        diag_buf_push_byte(mut_view(*out), 93u8); // ']'
    } else if op.kind == X64_OP_FRAME {
        let sid: u32 = op.frame.slot_id;
        let off: i32 = op.frame.offset;
        mi_push_str(mut_view(*out), 57, 7); // "[frame#"
        diag_buf_push_u32(mut_view(*out), sid);
        if off >= 0 {
            mi_push_str(mut_view(*out), 51, 3); // " + "
            push_i32_abs(mut_view(*out), off);
        } else {
            mi_push_str(mut_view(*out), 54, 3); // " - "
            push_i32_abs(mut_view(*out), off);
        }
        diag_buf_push_byte(mut_view(*out), 93u8); // ']'
    } else if op.kind == X64_OP_SYM {
        let sym_v: u32 = op.sym;
        mi_push_str(mut_view(*out), 64, 4); // "sym#"
        diag_buf_push_u32(mut_view(*out), sym_v);
    }
}

pub fn x64_mi_print_inst(mi: view<X64MI>, out: mut_view<DiagBuffer>) {
    mi_push_str(mut_view(*out), 68, 2); // "  "
    mi_push_opcode_name(mut_view(*out), mi.opcode);
    let mut i: u8 = 0u8;
    while i < mi.op_count {
        if i == 0u8 {
            diag_buf_push_byte(mut_view(*out), 32u8); // ' '
        } else {
            mi_push_str(mut_view(*out), 70, 2); // ", "
        }
        x64_mi_print_op(mi.ops[i as usize], mut_view(*out));
        i = i + 1u8;
    }
    diag_buf_push_byte(mut_view(*out), 10u8); // '\n'
}

pub fn x64_mi_print(body: view<X64MIBody>, out: mut_view<DiagBuffer>) {
    mi_push_str(mut_view(*out), 72, 18); // "frame_req: shadow="
    diag_buf_push_u32(mut_view(*out), body.shadow_space);
    mi_push_str(mut_view(*out), 90, 11); // " args_size="
    diag_buf_push_u32(mut_view(*out), body.stack_args_size);
    diag_buf_push_byte(mut_view(*out), 10u8);

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let bb_id = unsafe { (*bb).id };
        mi_push_str(mut_view(*out), 101, 2); // "bb"
        diag_buf_push_u32(mut_view(*out), bb_id);
        mi_push_str(mut_view(*out), 103, 2); // ":\n"
        let mut curr = unsafe { (*bb).first_inst };
        while (curr as usize) != 0 {
            unsafe {
                x64_mi_print_inst(view(*curr), mut_view(*out));
                curr = (*curr).next;
            }
        }
        b = b + 1;
    }
}

pub fn ax_x64_mi_print(body: view<X64MIBody>, out: mut_view<DiagBuffer>) {
    x64_mi_print(body, mut_view(*out));
}

// =============================================================================
// 3. Instruction Selection (target/x64/isel/isel.c)
// =============================================================================

fn isel_type_is_ret_in_mem(ret_size: u32) -> bool {
    ret_size > 8u32 || (ret_size != 1u32 && ret_size != 2u32 && ret_size != 4u32 && ret_size != 8u32 && ret_size != 0u32)
}

fn isel_chunk_size(rem: u32) -> u32 {
    if rem >= 8u32 {
        8u32
    } else if rem >= 4u32 {
        4u32
    } else if rem >= 2u32 {
        2u32
    } else {
        1u32
    }
}

fn isel_emit_trunc(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    ty: TypeId,
    interner: view<TypeInterner>,
    scratch_reg: i32
) {
    let ty_v = ty.v;
    let size = type_size(TypeId { v: ty_v }, interner);
    let t = type_get(interner, TypeId { v: ty_v });
    let mut is_signed = true;
    if (t as usize) != 0 {
        let k = unsafe { (*t).kind };
        if k == TY_U8 || k == TY_U16 || k == TY_U32 || k == TY_U64 || k == TY_USIZE || k == TY_BOOL {
            is_signed = false;
        }
    }

    if size == 1u32 {
        if is_signed {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(scratch_reg), x64_op_imm(56i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(scratch_reg), x64_op_imm(56i64));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(scratch_reg), x64_op_imm(0xFFi64));
        }
    } else if size == 2u32 {
        if is_signed {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(scratch_reg), x64_op_imm(48i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(scratch_reg), x64_op_imm(48i64));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(scratch_reg), x64_op_imm(0xFFFFi64));
        }
    } else if size == 4u32 {
        if is_signed {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(scratch_reg), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(scratch_reg), x64_op_imm(32i64));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(scratch_reg), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(scratch_reg), x64_op_imm(32i64));
        }
    }
}

fn isel_vreg_ty(lir: view<LirBody>, vreg_idx: u32) -> TypeId {
    let mut res = TypeId { v: 0u32 };
    if (vreg_idx as usize) < lir.vreg_count && (lir.vregs as usize) != 0 {
        let vp = unsafe { lir_vreg_at(lir.vregs, vreg_idx as usize) };
        let v = unsafe { (*vp).ty.v };
        res = TypeId { v: v };
    }
    res
}

fn isel_slot0_ty(lir: view<LirBody>) -> TypeId {
    let mut res = TypeId { v: 0u32 };
    if lir.slot_count > 0 && (lir.slots as usize) != 0 {
        let sp = unsafe { lir_slot_at(lir.slots, 0) };
        let v = unsafe { (*sp).ty.v };
        res = TypeId { v: v };
    }
    res
}

fn isel_icmp_cc(kind: u8) -> u8 {
    if kind == LIR_INST_ICMP_NE {
        CC_NE
    } else if kind == LIR_INST_ICMP_SLT {
        CC_L
    } else if kind == LIR_INST_ICMP_SLE {
        CC_LE
    } else if kind == LIR_INST_ICMP_SGT {
        CC_G
    } else if kind == LIR_INST_ICMP_SGE {
        CC_GE
    } else if kind == LIR_INST_ICMP_ULT {
        CC_B
    } else if kind == LIR_INST_ICMP_ULE {
        CC_BE
    } else if kind == LIR_INST_ICMP_UGT {
        CC_A
    } else if kind == LIR_INST_ICMP_UGE {
        CC_AE
    } else {
        CC_E
    }
}

fn isel_emit_uoverflow(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    bw: u32,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let is_64 = bw == 64u32;
    // Matches isel.c lines 213-290 (using reg 0, reg 2, reg 3, and R8..R11 for 64-bit umul)
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(0), x64_op_frame(slot_offset + lhs_v, 0));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(2), x64_op_frame(slot_offset + rhs_v, 0));
    if !is_64 {
        let mut mask: i64 = 0i64;
        let mut uint_max: i64 = 0i64;
        if bw == 8u32 {
            mask = 0xFFi64;
            uint_max = 0xFFi64;
        } else if bw == 16u32 {
            mask = 0xFFFFi64;
            uint_max = 0xFFFFi64;
        } else if bw == 32u32 {
            mask = 0xFFFFFFFFi64;
            uint_max = 0xFFFFFFFFi64;
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(3), x64_op_imm(mask));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(0), x64_op_reg(3));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(2), x64_op_reg(3));
        if kind == LIR_INST_UADD_OVERFLOW {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(0), x64_op_reg(2));
        } else if kind == LIR_INST_USUB_OVERFLOW {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(0), x64_op_reg(2));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(0), x64_op_reg(2));
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(3), x64_op_imm(uint_max));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(0), x64_op_reg(3));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_A as i64), x64_op_reg(0));
    } else {
        if kind == LIR_INST_UADD_OVERFLOW {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(0), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_B as i64), x64_op_reg(0));
        } else if kind == LIR_INST_USUB_OVERFLOW {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(0), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_B as i64), x64_op_reg(0));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R8), x64_op_reg(0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_R8), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R8), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_reg(0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R9), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_R10), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R10), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R11), x64_op_imm(32i64));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(0), x64_op_reg(REG_R9));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(0), x64_op_reg(REG_R11));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(1), x64_op_reg(REG_R9));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(1), x64_op_reg(REG_R10));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(2), x64_op_reg(REG_R8));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(2), x64_op_reg(REG_R11));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(REG_R8), x64_op_reg(REG_R10));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_reg(1));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R9), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(0), x64_op_reg(REG_R9));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R9), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(0), x64_op_reg(REG_R9));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(1), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(1), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(2), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(2), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R8), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(1), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(1), x64_op_reg(REG_R8));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(1), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(0), x64_op_reg(1));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(0), x64_op_imm(0i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_NE as i64), x64_op_reg(0));
        }
    }
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(0), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(0));
}

fn isel_emit_soverflow(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    bw: u32,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let is_64 = bw == 64u32;
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
    if kind == LIR_INST_SADD_OVERFLOW {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
    } else if kind == LIR_INST_SSUB_OVERFLOW {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
    } else {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
    }
    if is_64 {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_O as i64), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));
    } else {
        let mut int_min: i64 = -2147483648i64;
        let mut int_max: i64 = 2147483647i64;
        if bw == 8u32 {
            int_min = -128i64;
            int_max = 127i64;
        } else if bw == 16u32 {
            int_min = -32768i64;
            int_max = 32767i64;
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(int_min));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_L as i64), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RCX), x64_op_imm(1i64));

        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(int_max));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_G as i64), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));

        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
    }
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
}

fn isel_emit_udiv_urem(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R8), x64_op_frame(slot_offset + lhs_v, 0));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_frame(slot_offset + rhs_v, 0));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_reg(REG_R9));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R10), x64_op_imm(63i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_reg(REG_R10));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R11), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_reg(REG_R8));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_RAX), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_reg(REG_R11));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(0i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IDIV, x64_op_reg(REG_R9), x64_op_none());
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RAX), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RDX), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_imm(0i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R11), x64_op_reg(REG_R10));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(REG_R11), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_R8), x64_op_reg(REG_R11));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(REG_RDX), x64_op_reg(REG_R8));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RDX), x64_op_reg(REG_R9));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_AE as i64), x64_op_reg(REG_RCX));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RCX), x64_op_imm(1i64));
    if kind == LIR_INST_UDIV {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    } else {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R11), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_R9), x64_op_reg(REG_R11));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RDX), x64_op_reg(REG_R9));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RDX));
    }
}

pub fn x64_isel_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> *mut X64MIBody {
    let mi = x64_mi_body_new(mut_view(*arena), lir.bb_count);
    unsafe {
        (*mi).shadow_space = lir.frame_req.max_outgoing_args_bytes;
        (*mi).stack_args_size = 0u32;
    }

    let slot_offset = lir.slot_count as u32;
    let mut callee_ret_in_mem = false;
    if lir.slot_count > 0 {
        let s0_ty = isel_slot0_ty(lir);
        let ret_size = type_size(s0_ty, interner);
        callee_ret_in_mem = isel_type_is_ret_in_mem(ret_size);
    }

    let mut b: usize = 0;
    while b < lir.bb_count {
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let mbb = unsafe { x64_mi_bb_at((*mi).bbs, b) };
        unsafe {
            x64_mi_bb_reset(mut_view(*mbb), b as u32);
        }

        if b == 0 && callee_ret_in_mem {
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(0u32, 0), x64_op_reg(REG_RCX));
            }
        }

        let inst_count = unsafe { (*lbb).inst_count };
        let insts_base = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < inst_count {
            let inst = unsafe { lir_inst_at(insts_base, i) };
            let kind = unsafe { (*inst).kind };
            let dest_v = unsafe { (*inst).dest.v };
            let lhs_v = unsafe { (*inst).lhs.v };
            let rhs_v = unsafe { (*inst).rhs.v };
            let operand_v = unsafe { (*inst).operand.v };

            if kind == LIR_INST_CONST {
                let cval = unsafe { (*inst).const_val as i64 };
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(cval));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_CONST_STR {
                let s_bytes = unsafe { (*inst).str_bytes };
                let s_len = unsafe { (*inst).str_len };
                unsafe {
                    let sym_id = x64_mi_add_string(mut_view(*mi), s_bytes, s_len);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_sym(sym_id));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(s_len as i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 8), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_FN_ADDR {
                let sym_name = unsafe { (*inst).sym_name };
                let sym_len = unsafe { (*inst).sym_len };
                unsafe {
                    let lea_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_sym(0u32));
                    (*lea_mi).msg = sym_name;
                    (*lea_mi).msg_len = sym_len;
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_ADD || kind == LIR_INST_SUB || kind == LIR_INST_BIT_AND || kind == LIR_INST_BIT_OR || kind == LIR_INST_BIT_XOR || kind == LIR_INST_MUL {
                let opc = if kind == LIR_INST_ADD {
                    X64_MI_ADD
                } else if kind == LIR_INST_SUB {
                    X64_MI_SUB
                } else if kind == LIR_INST_BIT_AND {
                    X64_MI_AND
                } else if kind == LIR_INST_BIT_OR {
                    X64_MI_OR
                } else if kind == LIR_INST_BIT_XOR {
                    X64_MI_XOR
                } else {
                    X64_MI_IMUL
                };
                let dty = isel_vreg_ty(lir, dest_v);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
                    isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_SHL || kind == LIR_INST_SHR || kind == LIR_INST_SAR {
                let opc = if kind == LIR_INST_SHL {
                    X64_MI_SHL
                } else if kind == LIR_INST_SAR {
                    X64_MI_SAR
                } else {
                    X64_MI_SHR
                };
                let dty = isel_vreg_ty(lir, dest_v);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + rhs_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
                    isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind >= LIR_INST_ICMP_EQ && kind <= LIR_INST_ICMP_UGE {
                let cond = isel_icmp_cc(kind);
                let dty = isel_vreg_ty(lir, dest_v);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(cond as i64), x64_op_reg(REG_RAX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(0xFFi64));
                    isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_UADD_OVERFLOW || kind == LIR_INST_USUB_OVERFLOW || kind == LIR_INST_UMUL_OVERFLOW {
                let bw = unsafe { (*inst).bit_width };
                unsafe {
                    isel_emit_uoverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
                }
            } else if kind == LIR_INST_SADD_OVERFLOW || kind == LIR_INST_SSUB_OVERFLOW || kind == LIR_INST_SMUL_OVERFLOW {
                let bw = unsafe { (*inst).bit_width };
                unsafe {
                    isel_emit_soverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
                }
            } else if kind == LIR_INST_UDIV_OVERFLOW || kind == LIR_INST_UREM_OVERFLOW {
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_SDIV_OVERFLOW || kind == LIR_INST_SREM_OVERFLOW {
                let bw = unsafe { (*inst).bit_width };
                let mut int_min: i64 = (0x8000000000000000u64) as i64;
                if bw == 8u32 {
                    int_min = -128i64;
                } else if bw == 16u32 {
                    int_min = -32768i64;
                } else if bw == 32u32 {
                    int_min = -2147483648i64;
                }
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_frame(slot_offset + rhs_v, 0));

                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RDX), x64_op_imm(-1i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_E as i64), x64_op_reg(REG_RCX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RCX), x64_op_imm(1i64));

                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(int_min));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_E as i64), x64_op_reg(REG_RAX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));

                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_DIV || kind == LIR_INST_REM {
                let res_reg = if kind == LIR_INST_DIV { REG_RAX } else { REG_RDX };
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_reg(REG_RAX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(REG_RDX), x64_op_imm(63i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IDIV, x64_op_frame(slot_offset + rhs_v, 0), x64_op_none());
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(res_reg));
                }
            } else if kind == LIR_INST_UDIV || kind == LIR_INST_UREM {
                unsafe {
                    isel_emit_udiv_urem(mut_view(*mi), mut_view(*mbb), kind, slot_offset, dest_v, lhs_v, rhs_v);
                }
            } else if kind == LIR_INST_NEG {
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + operand_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
                }
            } else if kind == LIR_INST_NOT {
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + operand_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, x64_op_reg(REG_RAX), x64_op_imm(1i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_BITNOT {
                let dty = isel_vreg_ty(lir, dest_v);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_imm(-1i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R10), x64_op_frame(slot_offset + operand_v, 0));
                    isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_R10);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_R10));
                }
            } else if kind == LIR_INST_ABI_ARG {
                let loc_kind = unsafe { (*inst).loc_kind };
                let loc_ro = unsafe { (*inst).loc_reg_or_offset };
                let val_v = unsafe { (*inst).val.v };
                if dest_v != LIR_VREG_NONE {
                    if loc_kind == ABI_LOC_REG {
                        unsafe {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(loc_ro as i32));
                        }
                    } else if loc_kind == ABI_LOC_STACK {
                        let mem = x64_op_mem(REG_RBP, REG_NONE, 1u8, (16u32 + loc_ro) as i32, false);
                        unsafe {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), mem);
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                        }
                    } else if loc_kind == ABI_LOC_INDIRECT {
                        let dty = isel_vreg_ty(lir, dest_v);
                        let size = type_size(dty, interner);
                        unsafe {
                            if loc_ro < 16u32 {
                                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_reg(loc_ro as i32));
                            } else {
                                let mem = x64_op_mem(REG_RBP, REG_NONE, 1u8, (16u32 + loc_ro) as i32, false);
                                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), mem);
                            }
                            let mut off: u32 = 0u32;
                            while off < size {
                                let chunk = isel_chunk_size(size - off);
                                let src_mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), src_mem);
                                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                                off = off + chunk;
                            }
                        }
                    }
                } else {
                    if loc_kind == ABI_LOC_REG {
                        unsafe {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(loc_ro as i32), x64_op_frame(slot_offset + val_v, 0));
                        }
                    } else if loc_kind == ABI_LOC_STACK {
                        let mem = x64_op_mem(REG_RSP, REG_NONE, 1u8, loc_ro as i32, false);
                        unsafe {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + val_v, 0));
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, mem, x64_op_reg(REG_RAX));
                        }
                    } else if loc_kind == ABI_LOC_INDIRECT {
                        unsafe {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + val_v, 0));
                            if loc_ro < 16u32 {
                                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(loc_ro as i32), x64_op_reg(REG_RAX));
                            } else {
                                let mem = x64_op_mem(REG_RSP, REG_NONE, 1u8, loc_ro as i32, false);
                                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, mem, x64_op_reg(REG_RAX));
                            }
                        }
                    }
                }
            } else if kind == LIR_INST_CALL {
                let callee_ty_id = unsafe { TypeId { v: (*inst).callee_ty.v } };
                let dst_addr_v = unsafe { (*inst).dst_addr.v };
                let callee_vreg_v = unsafe { (*inst).callee_vreg.v };
                let sym_name = unsafe { (*inst).sym_name };
                let sym_len = unsafe { (*inst).sym_len };

                let callee_ty = type_get(interner, callee_ty_id);
                let mut ret_ty = TypeId { v: 0u32 };
                if (callee_ty as usize) != 0 {
                    let ck = unsafe { (*callee_ty).kind };
                    if ck == TY_FN {
                        ret_ty = unsafe { TypeId { v: (*callee_ty).ret_type.v } };
                    } else if ck == TY_CLOSURE {
                        let r_v = unsafe { (*callee_ty).ret_type.v };
                        if r_v != 0u32 {
                            ret_ty = TypeId { v: r_v };
                        } else {
                            let fn_v = unsafe { (*callee_ty).fn_type.v };
                            if fn_v != 0u32 {
                                let fn_t = type_get(interner, TypeId { v: fn_v });
                                if (fn_t as usize) != 0 {
                                    ret_ty = unsafe { TypeId { v: (*fn_t).ret_type.v } };
                                }
                            }
                        }
                    }
                }
                if ret_ty.v != 0u32 {
                    let ret_size = type_size(ret_ty, interner);
                    if isel_type_is_ret_in_mem(ret_size) {
                        unsafe {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + dst_addr_v, 0));
                        }
                    }
                }
                unsafe {
                    if (sym_name as usize) != 0 {
                        let call_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CALL, x64_op_none(), x64_op_none());
                        (*call_mi).msg = sym_name;
                        (*call_mi).msg_len = sym_len;
                    } else {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_frame(slot_offset + callee_vreg_v, 0));
                        let call_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CALL, x64_op_reg(REG_R10), x64_op_none());
                        (*call_mi).op_count = 1u8;
                    }
                }
            } else if kind == LIR_INST_ABI_RESULT {
                let loc_kind = unsafe { (*inst).loc_kind };
                let loc_ro = unsafe { (*inst).loc_reg_or_offset };
                if loc_kind == ABI_LOC_REG {
                    unsafe {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(loc_ro as i32));
                    }
                } else if loc_kind == ABI_LOC_INDIRECT {
                    let dty = isel_vreg_ty(lir, dest_v);
                    let mut load_sz = type_size(dty, interner);
                    unsafe {
                        if load_sz <= 8u32 {
                            if load_sz != 1u32 && load_sz != 2u32 && load_sz != 4u32 && load_sz != 8u32 {
                                load_sz = 8u32;
                            }
                            let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, x64_op_reg(REG_RCX), mem);
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
                        } else {
                            let mut off: u32 = 0u32;
                            while off < load_sz {
                                let chunk = isel_chunk_size(load_sz - off);
                                let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), mem);
                                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                                off = off + chunk;
                            }
                        }
                    }
                }
            } else if kind == LIR_INST_STACK_ADDR {
                let slot_v = unsafe { (*inst).slot.v };
                let mut ret_in_mem = false;
                if slot_v == 0u32 && lir.slot_count > 0 {
                    let s0_ty = isel_slot0_ty(lir);
                    let ret_size = type_size(s0_ty, interner);
                    ret_in_mem = isel_type_is_ret_in_mem(ret_size);
                }
                unsafe {
                    if ret_in_mem {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    } else {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_frame(slot_v, 0));
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    }
                }
            } else if kind == LIR_INST_LOAD {
                let ptr_v = unsafe { (*inst).ptr.v };
                let load_ty_v = unsafe { (*inst).ty.v };
                let raw_size = type_size(TypeId { v: load_ty_v }, interner);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + ptr_v, 0));
                    if raw_size <= 8u32 {
                        let mut load_sz = raw_size;
                        if load_sz != 1u32 && load_sz != 2u32 && load_sz != 4u32 && load_sz != 8u32 {
                            load_sz = 8u32;
                        }
                        let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, x64_op_reg(REG_RCX), mem);

                        let mut is_signed = false;
                        let t = type_get(interner, TypeId { v: load_ty_v });
                        if (t as usize) != 0 {
                            let tk = (*t).kind;
                            if tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE {
                                is_signed = true;
                            }
                        }
                        let shr_opc = if is_signed { X64_MI_SAR } else { X64_MI_SHR };
                        if raw_size == 1u32 {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RCX), x64_op_imm(56i64));
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), shr_opc, x64_op_reg(REG_RCX), x64_op_imm(56i64));
                        } else if raw_size == 2u32 {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RCX), x64_op_imm(48i64));
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), shr_opc, x64_op_reg(REG_RCX), x64_op_imm(48i64));
                        } else if raw_size == 4u32 {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RCX), x64_op_imm(32i64));
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), shr_opc, x64_op_reg(REG_RCX), x64_op_imm(32i64));
                        }
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
                    } else {
                        let mut off: u32 = 0u32;
                        while off < raw_size {
                            let chunk = isel_chunk_size(raw_size - off);
                            let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), mem);
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                            off = off + chunk;
                        }
                    }
                }
            } else if kind == LIR_INST_STORE {
                let ptr_v = unsafe { (*inst).ptr.v };
                let val_v = unsafe { (*inst).val.v };
                let val_ty = isel_vreg_ty(lir, val_v);
                let mut size = type_size(val_ty, interner);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + ptr_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + val_v, 0));
                    if size <= 8u32 {
                        if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                            size = 8u32;
                        }
                        let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, mem, x64_op_reg(REG_RCX));
                    } else {
                        let mut off: u32 = 0u32;
                        while off < size {
                            let chunk = isel_chunk_size(size - off);
                            let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + val_v, off as i32));
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, mem, x64_op_reg(REG_RCX));
                            off = off + chunk;
                        }
                    }
                }
            }

            i = i + 1;
        }

        // Terminators
        let term_kind = unsafe { (*lbb).term.kind };
        if term_kind == LIR_TERM_SWITCH {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let t_count = unsafe { (*lbb).term.count };
            let targets_base = unsafe { (*lbb).term.targets };
            let otherwise_v = unsafe { (*lbb).term.otherwise.v };
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_frame(slot_offset + cond_v, 0));
                let mut k: usize = 0;
                while k < t_count {
                    let tp = lir_switch_target_at(targets_base, k);
                    let t_val = (*tp).val as i64;
                    let t_bb = (*tp).target.v as i64;
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_R10), x64_op_imm(t_val));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, x64_op_imm(CC_E as i64), x64_op_imm(t_bb));
                    k = k + 1;
                }
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(otherwise_v as i64), x64_op_none());
            }
        } else if term_kind == LIR_TERM_JCC {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let then_v = unsafe { (*lbb).term.then_target.v };
            let else_v = unsafe { (*lbb).term.else_target.v };
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + cond_v, 0));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, x64_op_imm(CC_NE as i64), x64_op_imm(then_v as i64));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(else_v as i64), x64_op_none());
            }
        } else if term_kind == LIR_TERM_ASSERT {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let target_v = unsafe { (*lbb).term.assert_target.v };
            let msg_ptr = unsafe { (*lbb).term.msg_ptr };
            let msg_len = unsafe { (*lbb).term.msg_len };
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + cond_v, 0));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(1i64));
                let assert_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ASSERT, x64_op_imm(target_v as i64), x64_op_none());
                (*assert_mi).msg = msg_ptr;
                (*assert_mi).msg_len = msg_len;
            }
        } else if term_kind == LIR_TERM_JMP {
            let jmp_v = unsafe { (*lbb).term.jmp_target.v };
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(jmp_v as i64), x64_op_none());
            }
        } else if term_kind == LIR_TERM_RETURN {
            let s0_ty = isel_slot0_ty(lir);
            let ret_ty = type_get(interner, s0_ty);
            let mut is_unit = false;
            if (ret_ty as usize) != 0 {
                let rk = unsafe { (*ret_ty).kind };
                if rk == TY_UNIT {
                    is_unit = true;
                }
            }
            unsafe {
                if is_unit {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                } else {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
                }
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_RET, x64_op_none(), x64_op_none());
            }
        }

        b = b + 1;
    }

    mi
}

pub fn x64_isel(lir: view<LirBody>, interner: view<TypeInterner>) -> *mut X64MIBody {
    unsafe {
        x64_isel_in_arena(mut_view(*lir.arena), lir, interner)
    }
}

pub fn ax_x64_isel(lir: view<LirBody>, interner: view<TypeInterner>) -> *mut X64MIBody {
    x64_isel(lir, interner)
}
