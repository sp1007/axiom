@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// =============================================================================
// 1. x86-64 Machine IR Data Model (target/x64/mir/mi.h)
// =============================================================================

@derive(Copy)
pub struct X64FrameOp {
    pub slot_id: u32,
    pub offset: i32,
}

// Machine operand (56 bytes <= 64-byte interp limit).
// Both `op.frame.{slot_id, offset}` and flat `op.{slot_id, offset}` are kept in sync.
@derive(Copy)
pub struct X64Op {
    pub kind: u32,
    pub reg: i32,
    pub imm: i64,
    pub mem: X64Mem,
    pub frame: X64FrameOp,
    pub slot_id: u32,
    pub offset: i32,
    pub sym: u32,
}

pub fn x64_op_none() -> X64Op {
    X64Op {
        kind: X64_OP_NONE,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_none() -> X64Op {
    x64_op_none()
}

pub fn x64_op_reg(reg: i32) -> X64Op {
    X64Op {
        kind: X64_OP_REG,
        reg: reg,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_reg(reg: i32) -> X64Op {
    x64_op_reg(reg)
}

pub fn x64_op_imm(imm: i64) -> X64Op {
    X64Op {
        kind: X64_OP_IMM,
        reg: REG_NONE,
        imm: imm,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_imm(imm: i64) -> X64Op {
    x64_op_imm(imm)
}

pub fn x64_op_mem(base: i32, index: i32, scale: u8, disp: i32, is_rip: bool) -> X64Op {
    X64Op {
        kind: X64_OP_MEM,
        reg: REG_NONE,
        imm: 0i64,
        mem: X64Mem {
            base: base,
            index: index,
            scale: scale,
            disp: disp,
            is_rip: is_rip,
        },
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_mem(base: i32, index: i32, scale: u8, disp: i32, is_rip: bool) -> X64Op {
    x64_op_mem(base, index, scale, disp, is_rip)
}

pub fn x64_op_mem_struct(mem: X64Mem) -> X64Op {
    X64Op {
        kind: X64_OP_MEM,
        reg: REG_NONE,
        imm: 0i64,
        mem: mem,
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn x64_op_frame(slot_id: u32, offset: i32) -> X64Op {
    X64Op {
        kind: X64_OP_FRAME,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: slot_id, offset: offset },
        slot_id: slot_id,
        offset: offset,
        sym: 0u32,
    }
}

pub fn ax_x64_op_frame(slot_id: u32, offset: i32) -> X64Op {
    x64_op_frame(slot_id, offset)
}

pub fn x64_op_sym(sym: u32) -> X64Op {
    X64Op {
        kind: X64_OP_SYM,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: sym,
    }
}

pub fn ax_x64_op_sym(sym: u32) -> X64Op {
    x64_op_sym(sym)
}

// Machine instruction node (intrusively linked per basic block).
// Note: X64MI is > 64 bytes; always allocate via `x64_mi_new` in an Arena and access via pointer/view.
pub struct X64MI {
    pub opcode: u32,
    pub ops: [3]X64Op,
    pub op_count: u8,
    pub size: u8,
    pub sz: u8,
    pub origin_vreg: u32,
    pub msg: *const u8,
    pub msg_len: usize,
    pub next: *mut X64MI,
}

pub struct X64MIBb {
    pub id: u32,
    pub first_inst: *mut X64MI,
    pub last_inst: *mut X64MI,
}

pub struct X64MIStr {
    pub bytes: *const u8,
    pub len: usize,
    pub sym_id: u32,
}

pub struct X64MIBody {
    pub arena: *mut Arena,
    pub bbs: *mut X64MIBb,
    pub bb_count: usize,
    pub shadow_space: u32,
    pub stack_args_size: u32,
    pub strings: *mut X64MIStr,
    pub string_count: usize,
    pub string_cap: usize,
    pub is_opt: bool,
}

pub unsafe fn x64_mi_bb_at(base: *mut X64MIBb, idx: usize) -> *mut X64MIBb {
    let off = lir_mul_usize(idx, size_of<X64MIBb>());
    ((base as usize) + off) as *mut X64MIBb
}

pub unsafe fn x64_mi_str_at(base: *mut X64MIStr, idx: usize) -> *mut X64MIStr {
    let off = lir_mul_usize(idx, size_of<X64MIStr>());
    ((base as usize) + off) as *mut X64MIStr
}

pub fn x64_mi_reset(mi: mut_view<X64MI>, opcode: u32) {
    mi.opcode = opcode;
    let none = x64_op_none();
    mi.ops[0usize] = none;
    mi.ops[1usize] = none;
    mi.ops[2usize] = none;
    mi.op_count = 0u8;
    mi.size = 8u8;
    mi.sz = 8u8;
    mi.origin_vreg = LIR_VREG_NONE;
    mi.msg = 0 as *const u8;
    mi.msg_len = 0;
    mi.next = 0 as *mut X64MI;
}

pub fn x64_mi_set_size(mi: mut_view<X64MI>, sz: u8) {
    mi.size = sz;
    mi.sz = sz;
}

pub fn x64_mi_new(arena: mut_view<Arena>, opcode: u32) -> *mut X64MI {
    let raw = arena_alloc_raw(arena, size_of<X64MI>(), align_of<X64MI>()) as *mut X64MI;
    unsafe {
        x64_mi_reset(mut_view(*raw), opcode);
    }
    raw
}

pub fn ax_x64_mi_new(arena: mut_view<Arena>, opcode: u32) -> *mut X64MI {
    x64_mi_new(arena, opcode)
}

pub fn x64_mi_add_op(mi: mut_view<X64MI>, op: X64Op) {
    let cnt = mi.op_count;
    if cnt < 3u8 {
        let idx = cnt as usize;
        mi.ops[idx] = op;
        mi.op_count = cnt + 1u8;
    }
}

pub fn ax_x64_mi_add_op(mi: mut_view<X64MI>, op: X64Op) {
    x64_mi_add_op(mut_view(*mi), op);
}

pub fn x64_mi_bb_reset(bb: mut_view<X64MIBb>, id: u32) {
    bb.id = id;
    bb.first_inst = 0 as *mut X64MI;
    bb.last_inst = 0 as *mut X64MI;
}

pub fn x64_mi_body_reset(body: mut_view<X64MIBody>, arena_ptr: *mut Arena) {
    body.arena = arena_ptr;
    body.bbs = 0 as *mut X64MIBb;
    body.bb_count = 0;
    body.shadow_space = 0u32;
    body.stack_args_size = 0u32;
    body.strings = 0 as *mut X64MIStr;
    body.string_count = 0;
    body.string_cap = 0;
    body.is_opt = false;
}

pub fn x64_mi_body_new(arena: mut_view<Arena>, bb_count: usize) -> *mut X64MIBody {
    let body = arena_alloc_raw(mut_view(*arena), size_of<X64MIBody>(), align_of<X64MIBody>()) as *mut X64MIBody;
    let mut bbs: *mut X64MIBb = 0 as *mut X64MIBb;
    if bb_count > 0 {
        let bbs_bytes = lir_mul_usize(bb_count, size_of<X64MIBb>());
        bbs = arena_alloc_raw(mut_view(*arena), bbs_bytes, align_of<X64MIBb>()) as *mut X64MIBb;
    }
    let arena_ptr = unsafe { address_of_mut(arena.head) as *mut Arena };
    unsafe {
        x64_mi_body_reset(mut_view(*body), arena_ptr);
        (*body).bb_count = bb_count;
        if bb_count > 0 {
            let mut b: usize = 0;
            while b < bb_count {
                let mbb = x64_mi_bb_at(bbs, b);
                x64_mi_bb_reset(mut_view(*mbb), b as u32);
                b = b + 1;
            }
            (*body).bbs = bbs;
        }
    }
    body
}

pub fn ax_x64_mi_body_new(arena: mut_view<Arena>, bb_count: usize) -> *mut X64MIBody {
    x64_mi_body_new(mut_view(*arena), bb_count)
}

pub fn x64_mi_emit_sz(
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    sz: u8,
    op1: X64Op,
    op2: X64Op
) -> *mut X64MI {
    let inst = unsafe { x64_mi_new(mut_view(*body.arena), opc) };
    unsafe {
        x64_mi_set_size(mut_view(*inst), sz);
        if op1.kind != X64_OP_NONE {
            x64_mi_add_op(mut_view(*inst), op1);
        }
        if op2.kind != X64_OP_NONE {
            x64_mi_add_op(mut_view(*inst), op2);
        }
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

pub fn x64_mi_emit(
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    op1: X64Op,
    op2: X64Op
) -> *mut X64MI {
    x64_mi_emit_sz(mut_view(*body), mut_view(*mbb), opc, 8u8, op1, op2)
}

pub fn x64_mi_emit_cmovcc(
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cc: u8,
    dst: X64Op,
    src: X64Op
) -> *mut X64MI {
    let inst = unsafe { x64_mi_new(mut_view(*body.arena), X64_MI_CMOVCC) };
    unsafe {
        x64_mi_set_size(mut_view(*inst), 8u8);
        x64_mi_add_op(mut_view(*inst), x64_op_imm(cc as i64));
        x64_mi_add_op(mut_view(*inst), dst);
        x64_mi_add_op(mut_view(*inst), src);
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

pub fn x64_mi_add_string(body: mut_view<X64MIBody>, bytes: *const u8, str_len: usize) -> u32 {
    let sym_id = (100000 + body.string_count) as u32;
    if body.string_count >= body.string_cap {
        let new_cap = if body.string_cap == 0 { 16 } else { lir_mul_usize(body.string_cap, 2) };
        let new_bytes = lir_mul_usize(new_cap, size_of<X64MIStr>());
        let new_strings = unsafe {
            arena_alloc_raw(mut_view(*body.arena), new_bytes, align_of<X64MIStr>()) as *mut X64MIStr
        };
        if (body.strings as usize) != 0 && body.string_count > 0 {
            let copy_bytes = lir_mul_usize(body.string_count, size_of<X64MIStr>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(body.strings as *const u8, new_strings as *mut u8, copy_bytes);
            }
        }
        body.strings = new_strings;
        body.string_cap = new_cap;
    }
    let entry = unsafe { x64_mi_str_at(body.strings, body.string_count) };
    unsafe {
        (*entry).bytes = bytes;
        (*entry).len = str_len;
        (*entry).sym_id = sym_id;
    }
    body.string_count = body.string_count + 1;
    sym_id
}

// =============================================================================
// 2. Machine IR Text Printer (target/x64/mir/mi.c)
// =============================================================================

// Constant byte table for `x64_mi_print` (following `compiler/lir/lir.ax` pattern):
//   0..2   (3):  "rax"
//   3..5   (3):  "rcx"
//   6..8   (3):  "rdx"
//   9..11  (3):  "rbx"
//  12..14  (3):  "rsp"
//  15..17  (3):  "rbp"
//  18..20  (3):  "rsi"
//  21..23  (3):  "rdi"
//  24..25  (2):  "r8"
//  26..27  (2):  "r9"
//  28..30  (3):  "r10"
//  31..33  (3):  "r11"
//  34..36  (3):  "r12"
//  37..39  (3):  "r13"
//  40..42  (3):  "r14"
//  43..45  (3):  "r15"
//  46..47  (2):  "r?"
//  48..50  (3):  "rip"
//  51..53  (3):  " + "
//  54..56  (3):  " - "
//  57..63  (7):  "[frame#"
//  64..67  (4):  "sym#"
//  68..69  (2):  "  "
//  70..71  (2):  ", "
//  72..89  (18): "frame_req: shadow="
//  90..100 (11): " args_size="
// 101..102 (2):  "bb"
// 103..104 (2):  ":\n"
// 105..107 (3):  "mov"
// 108..110 (3):  "add"
// 111..113 (3):  "sub"
// 114..117 (4):  "imul"
// 118..121 (4):  "idiv"
// 122..124 (3):  "and"
// 125..126 (2):  "or"
// 127..129 (3):  "xor"
// 130..132 (3):  "shl"
// 133..135 (3):  "sar"
// 136..138 (3):  "shr"
// 139..141 (3):  "lea"
// 142..144 (3):  "cmp"
// 145..147 (3):  "jmp"
// 148..150 (3):  "jcc"
// 151..154 (4):  "call"
// 155..158 (4):  "push"
// 159..161 (3):  "pop"
// 162..166 (5):  "setcc"
// 167..169 (3):  "ret"
// 170..175 (6):  "(null)"
// 176..178 (3):  "mul"
// 179..182 (4):  "test"
// 183..188 (6):  "cmovcc"
const MI_STR_TABLE: [189]u8 = [
    114u8, 97u8, 120u8,
    114u8, 99u8, 120u8,
    114u8, 100u8, 120u8,
    114u8, 98u8, 120u8,
    114u8, 115u8, 112u8,
    114u8, 98u8, 112u8,
    114u8, 115u8, 105u8,
    114u8, 100u8, 105u8,
    114u8, 56u8,
    114u8, 57u8,
    114u8, 49u8, 48u8,
    114u8, 49u8, 49u8,
    114u8, 49u8, 50u8,
    114u8, 49u8, 51u8,
    114u8, 49u8, 52u8,
    114u8, 49u8, 53u8,
    114u8, 63u8,
    114u8, 105u8, 112u8,
    32u8, 43u8, 32u8,
    32u8, 45u8, 32u8,
    91u8, 102u8, 114u8, 97u8, 109u8, 101u8, 35u8,
    115u8, 121u8, 109u8, 35u8,
    32u8, 32u8,
    44u8, 32u8,
    102u8, 114u8, 97u8, 109u8, 101u8, 95u8, 114u8, 101u8, 113u8, 58u8, 32u8, 115u8, 104u8, 97u8, 100u8, 111u8, 119u8, 61u8,
    32u8, 97u8, 114u8, 103u8, 115u8, 95u8, 115u8, 105u8, 122u8, 101u8, 61u8,
    98u8, 98u8,
    58u8, 10u8,
    109u8, 111u8, 118u8,
    97u8, 100u8, 100u8,
    115u8, 117u8, 98u8,
    105u8, 109u8, 117u8, 108u8,
    105u8, 100u8, 105u8, 118u8,
    97u8, 110u8, 100u8,
    111u8, 114u8,
    120u8, 111u8, 114u8,
    115u8, 104u8, 108u8,
    115u8, 97u8, 114u8,
    115u8, 104u8, 114u8,
    108u8, 101u8, 97u8,
    99u8, 109u8, 112u8,
    106u8, 109u8, 112u8,
    106u8, 99u8, 99u8,
    99u8, 97u8, 108u8, 108u8,
    112u8, 117u8, 115u8, 104u8,
    112u8, 111u8, 112u8,
    115u8, 101u8, 116u8, 99u8, 99u8,
    114u8, 101u8, 116u8,
    40u8, 110u8, 117u8, 108u8, 108u8, 41u8,
    109u8, 117u8, 108u8,
    116u8, 101u8, 115u8, 116u8,
    99u8, 109u8, 111u8, 118u8, 99u8, 99u8,
];

fn mi_push_str(out: mut_view<DiagBuffer>, off: usize, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), MI_STR_TABLE[off + i]);
        i = i + 1;
    }
}

fn mi_push_reg_name(out: mut_view<DiagBuffer>, reg: i32) {
    if reg == 0 {
        mi_push_str(mut_view(*out), 0, 3);
    } else if reg == 1 {
        mi_push_str(mut_view(*out), 3, 3);
    } else if reg == 2 {
        mi_push_str(mut_view(*out), 6, 3);
    } else if reg == 3 {
        mi_push_str(mut_view(*out), 9, 3);
    } else if reg == 4 {
        mi_push_str(mut_view(*out), 12, 3);
    } else if reg == 5 {
        mi_push_str(mut_view(*out), 15, 3);
    } else if reg == 6 {
        mi_push_str(mut_view(*out), 18, 3);
    } else if reg == 7 {
        mi_push_str(mut_view(*out), 21, 3);
    } else if reg == 8 {
        mi_push_str(mut_view(*out), 24, 2);
    } else if reg == 9 {
        mi_push_str(mut_view(*out), 26, 2);
    } else if reg == 10 {
        mi_push_str(mut_view(*out), 28, 3);
    } else if reg == 11 {
        mi_push_str(mut_view(*out), 31, 3);
    } else if reg == 12 {
        mi_push_str(mut_view(*out), 34, 3);
    } else if reg == 13 {
        mi_push_str(mut_view(*out), 37, 3);
    } else if reg == 14 {
        mi_push_str(mut_view(*out), 40, 3);
    } else if reg == 15 {
        mi_push_str(mut_view(*out), 43, 3);
    } else if reg >= 16 && reg <= 31 {
        diag_buf_push_byte(mut_view(*out), 120u8);
        diag_buf_push_byte(mut_view(*out), 109u8);
        diag_buf_push_byte(mut_view(*out), 109u8);
        diag_buf_push_u32(mut_view(*out), (reg - 16) as u32);
    } else {
        mi_push_str(mut_view(*out), 46, 2);
    }
}

fn push_u64_dec(out: mut_view<DiagBuffer>, val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(mut_view(*out), 48u8);
    } else {
        let mut digits: [20]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
        let mut v = val;
        let mut n: usize = 0;
        while v > 0u64 {
            let half = v >> 1u64;
            let r5 = (half % 5u64) as u8;
            let odd = (v & 1u64) as u8;
            let rem = r5 + r5 + odd;
            digits[n] = 48u8 + rem;
            v = half / 5u64;
            n = n + 1;
        }
        while n > 0 {
            n = n - 1;
            diag_buf_push_byte(mut_view(*out), digits[n]);
        }
    }
}

fn push_i64_dec(out: mut_view<DiagBuffer>, val: i64) {
    if val < 0i64 {
        diag_buf_push_byte(mut_view(*out), 45u8); // '-'
        // Compute magnitude of negative i64 (including INT64_MIN) without signed or unsigned overflow
        let plus1 = val + 1i64;
        let neg_plus1 = (0i64 - plus1) as u64;
        let mag = neg_plus1 + 1u64;
        push_u64_dec(mut_view(*out), mag);
    } else {
        push_u64_dec(mut_view(*out), val as u64);
    }
}

fn push_i32_abs(out: mut_view<DiagBuffer>, val: i32) {
    if val < 0 {
        let mag = (0i64 - (val as i64)) as u32;
        diag_buf_push_u32(mut_view(*out), mag);
    } else {
        diag_buf_push_u32(mut_view(*out), val as u32);
    }
}

// Match `opc_names` table in `bootstrap/axiom0/src/target/x64/mir/mi.c` byte-for-byte.
// Note: `mi.c` leaves `AX_X64_MI_MUL`, `AX_X64_MI_TEST`, and `AX_X64_MI_ASSERT` uninitialized (NULL)
// in `opc_names[]`, which `fprintf(out, "  %s", opc_names[mi->opcode])` formats as `"  (null)"`.
fn mi_push_opcode_name(out: mut_view<DiagBuffer>, opc: u32) {
    if opc == X64_MI_MOV {
        mi_push_str(mut_view(*out), 105, 3);
    } else if opc == X64_MI_ADD {
        mi_push_str(mut_view(*out), 108, 3);
    } else if opc == X64_MI_SUB {
        mi_push_str(mut_view(*out), 111, 3);
    } else if opc == X64_MI_IMUL {
        mi_push_str(mut_view(*out), 114, 4);
    } else if opc == X64_MI_IDIV {
        mi_push_str(mut_view(*out), 118, 4);
    } else if opc == X64_MI_AND {
        mi_push_str(mut_view(*out), 122, 3);
    } else if opc == X64_MI_OR {
        mi_push_str(mut_view(*out), 125, 2);
    } else if opc == X64_MI_XOR {
        mi_push_str(mut_view(*out), 127, 3);
    } else if opc == X64_MI_SHL {
        mi_push_str(mut_view(*out), 130, 3);
    } else if opc == X64_MI_SAR {
        mi_push_str(mut_view(*out), 133, 3);
    } else if opc == X64_MI_SHR {
        mi_push_str(mut_view(*out), 136, 3);
    } else if opc == X64_MI_LEA {
        mi_push_str(mut_view(*out), 139, 3);
    } else if opc == X64_MI_CMP {
        mi_push_str(mut_view(*out), 142, 3);
    } else if opc == X64_MI_JMP {
        mi_push_str(mut_view(*out), 145, 3);
    } else if opc == X64_MI_JCC {
        mi_push_str(mut_view(*out), 148, 3);
    } else if opc == X64_MI_CALL {
        mi_push_str(mut_view(*out), 151, 4);
    } else if opc == X64_MI_PUSH {
        mi_push_str(mut_view(*out), 155, 4);
    } else if opc == X64_MI_POP {
        mi_push_str(mut_view(*out), 159, 3);
    } else if opc == X64_MI_SETCC {
        mi_push_str(mut_view(*out), 162, 5);
    } else if opc == X64_MI_RET {
        mi_push_str(mut_view(*out), 167, 3);
    } else {
        mi_push_str(mut_view(*out), 170, 6);
    }
}

pub fn x64_mi_print_op(op: X64Op, out: mut_view<DiagBuffer>) {
    if op.kind == X64_OP_NONE {
    } else if op.kind == X64_OP_REG {
        let r: i32 = op.reg;
        mi_push_reg_name(mut_view(*out), r);
    } else if op.kind == X64_OP_IMM {
        let imm_v: i64 = op.imm;
        push_i64_dec(mut_view(*out), imm_v);
    } else if op.kind == X64_OP_MEM {
        let base_r: i32 = op.mem.base;
        let index_r: i32 = op.mem.index;
        let scale_u: u8 = op.mem.scale;
        let disp_i32: i32 = op.mem.disp;
        let is_rip: bool = op.mem.is_rip;
        diag_buf_push_byte(mut_view(*out), 91u8); // '['
        let mut first = true;
        if is_rip {
            mi_push_str(mut_view(*out), 48, 3); // "rip"
            first = false;
        } else if base_r != REG_NONE && base_r >= 0 && base_r <= 15 {
            mi_push_reg_name(mut_view(*out), base_r);
            first = false;
        }
        if index_r != REG_NONE && index_r >= 0 && index_r <= 15 {
            if !first {
                mi_push_str(mut_view(*out), 51, 3); // " + "
            }
            mi_push_reg_name(mut_view(*out), index_r);
            if scale_u > 1u8 {
                diag_buf_push_byte(mut_view(*out), 42u8); // '*'
                let factor = if scale_u == 3u8 { 8u32 } else { scale_u as u32 };
                diag_buf_push_u32(mut_view(*out), factor);
            }
            first = false;
        }
        if disp_i32 != 0 || first {
            if !first {
                if disp_i32 > 0 {
                    mi_push_str(mut_view(*out), 51, 3); // " + "
                    push_i32_abs(mut_view(*out), disp_i32);
                } else {
                    mi_push_str(mut_view(*out), 54, 3); // " - "
                    push_i32_abs(mut_view(*out), disp_i32);
                }
            } else {
                push_i64_dec(mut_view(*out), disp_i32 as i64);
            }
        }
        diag_buf_push_byte(mut_view(*out), 93u8); // ']'
    } else if op.kind == X64_OP_FRAME {
        let sid: u32 = op.frame.slot_id;
        let off: i32 = op.frame.offset;
        mi_push_str(mut_view(*out), 57, 7); // "[frame#"
        diag_buf_push_u32(mut_view(*out), sid);
        if off >= 0 {
            mi_push_str(mut_view(*out), 51, 3); // " + "
            push_i32_abs(mut_view(*out), off);
        } else {
            mi_push_str(mut_view(*out), 54, 3); // " - "
            push_i32_abs(mut_view(*out), off);
        }
        diag_buf_push_byte(mut_view(*out), 93u8); // ']'
    } else if op.kind == X64_OP_SYM {
        let sym_v: u32 = op.sym;
        mi_push_str(mut_view(*out), 64, 4); // "sym#"
        diag_buf_push_u32(mut_view(*out), sym_v);
    }
}

pub fn x64_mi_print_inst(mi: view<X64MI>, out: mut_view<DiagBuffer>) {
    mi_push_str(mut_view(*out), 68, 2); // "  "
    if mi.opcode == X64_MI_CMOVCC {
        mi_push_str(mut_view(*out), 183, 6);
    } else if mi.opcode == X64_MI_MUL && mi.msg_len != 0 {
        mi_push_str(mut_view(*out), 176, 3);
    } else if mi.opcode == X64_MI_TEST && mi.msg_len != 0 {
        mi_push_str(mut_view(*out), 179, 4);
    } else {
        mi_push_opcode_name(mut_view(*out), mi.opcode);
    }
    let mut i: u8 = 0u8;
    while i < mi.op_count {
        if i == 0u8 {
            diag_buf_push_byte(mut_view(*out), 32u8); // ' '
        } else {
            mi_push_str(mut_view(*out), 70, 2); // ", "
        }
        x64_mi_print_op(mi.ops[i as usize], mut_view(*out));
        i = i + 1u8;
    }
    diag_buf_push_byte(mut_view(*out), 10u8); // '\n'
}

pub fn x64_mi_print(body: view<X64MIBody>, out: mut_view<DiagBuffer>) {
    mi_push_str(mut_view(*out), 72, 18); // "frame_req: shadow="
    diag_buf_push_u32(mut_view(*out), body.shadow_space);
    mi_push_str(mut_view(*out), 90, 11); // " args_size="
    diag_buf_push_u32(mut_view(*out), body.stack_args_size);
    diag_buf_push_byte(mut_view(*out), 10u8);

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let bb_id = unsafe { (*bb).id };
        mi_push_str(mut_view(*out), 101, 2); // "bb"
        diag_buf_push_u32(mut_view(*out), bb_id);
        mi_push_str(mut_view(*out), 103, 2); // ":\n"
        let mut curr = unsafe { (*bb).first_inst };
        while (curr as usize) != 0 {
            unsafe {
                x64_mi_print_inst(view(*curr), mut_view(*out));
                curr = (*curr).next;
            }
        }
        b = b + 1;
    }
}

pub fn ax_x64_mi_print(body: view<X64MIBody>, out: mut_view<DiagBuffer>) {
    x64_mi_print(body, mut_view(*out));
}

// =============================================================================
// 3. Instruction Selection (target/x64/isel/isel.c)
// =============================================================================

fn isel_type_is_ret_in_mem(ret_size: u32) -> bool {
    ret_size > 8u32 || (ret_size != 1u32 && ret_size != 2u32 && ret_size != 4u32 && ret_size != 8u32 && ret_size != 0u32)
}

fn isel_chunk_size(rem: u32) -> u32 {
    if rem >= 8u32 {
        8u32
    } else if rem >= 4u32 {
        4u32
    } else if rem >= 2u32 {
        2u32
    } else {
        1u32
    }
}

pub fn x64_reg_class_for_kind(ty_kind: u8, byte_size: u32) -> u8 {
    if ty_kind == 100u8 {
        REG_CLASS_XMM
    } else if ty_kind == 101u8 || (ty_kind == 102u8 && byte_size == 16u32) {
        REG_CLASS_VEC128
    } else if ty_kind == 103u8 || (ty_kind == 102u8 && byte_size == 32u32) {
        REG_CLASS_VEC256
    } else {
        REG_CLASS_GPR
    }
}

pub fn x64_reg_class_for_type(ty: TypeId, interner: view<TypeInterner>) -> u8 {
    let ty_v = ty.v;
    let t = type_get(interner, TypeId { v: ty_v });
    let mut k: u8 = 0u8;
    if (t as usize) != 0 {
        k = unsafe { (*t).kind };
    }
    let sz = type_size(TypeId { v: ty_v }, interner);
    x64_reg_class_for_kind(k, sz)
}

fn isel_type_is_signed_int(ty_id: TypeId, interner: view<TypeInterner>) -> bool {
    let t = type_get(interner, TypeId { v: ty_id.v });
    if (t as usize) == 0 {
        return false;
    }
    let tk = unsafe { (*t).kind };
    tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 ||
    tk == TY_ISIZE || tk == TY_INT_VAR
}

fn isel_emit_trunc(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    ty: TypeId,
    interner: view<TypeInterner>,
    scratch_reg: i32
) {
    let ty_v = ty.v;
    let size = type_size(TypeId { v: ty_v }, interner);
    let is_signed = isel_type_is_signed_int(TypeId { v: ty_v }, interner);

    if size == 1u32 {
        if is_signed {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(scratch_reg), x64_op_imm(56i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(scratch_reg), x64_op_imm(56i64));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(scratch_reg), x64_op_imm(0xFFi64));
        }
    } else if size == 2u32 {
        if is_signed {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(scratch_reg), x64_op_imm(48i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(scratch_reg), x64_op_imm(48i64));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(scratch_reg), x64_op_imm(0xFFFFi64));
        }
    } else if size == 4u32 {
        if is_signed {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(scratch_reg), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(scratch_reg), x64_op_imm(32i64));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(scratch_reg), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(scratch_reg), x64_op_imm(32i64));
        }
    }
}

fn isel_vreg_ty(lir: view<LirBody>, vreg_idx: u32) -> TypeId {
    let mut res = TypeId { v: 0u32 };
    if (vreg_idx as usize) < lir.vreg_count && (lir.vregs as usize) != 0 {
        let vp = unsafe { lir_vreg_at(lir.vregs, vreg_idx as usize) };
        let v = unsafe { (*vp).ty.v };
        res = TypeId { v: v };
    }
    res
}

fn isel_slot0_ty(lir: view<LirBody>) -> TypeId {
    let mut res = TypeId { v: 0u32 };
    if lir.slot_count > 0 && (lir.slots as usize) != 0 {
        let sp = unsafe { lir_slot_at(lir.slots, 0) };
        let v = unsafe { (*sp).ty.v };
        res = TypeId { v: v };
    }
    res
}

fn isel_icmp_cc(kind: u8) -> u8 {
    if kind == LIR_INST_ICMP_NE {
        CC_NE
    } else if kind == LIR_INST_ICMP_SLT {
        CC_L
    } else if kind == LIR_INST_ICMP_SLE {
        CC_LE
    } else if kind == LIR_INST_ICMP_SGT {
        CC_G
    } else if kind == LIR_INST_ICMP_SGE {
        CC_GE
    } else if kind == LIR_INST_ICMP_ULT {
        CC_B
    } else if kind == LIR_INST_ICMP_ULE {
        CC_BE
    } else if kind == LIR_INST_ICMP_UGT {
        CC_A
    } else if kind == LIR_INST_ICMP_UGE {
        CC_AE
    } else {
        CC_E
    }
}

fn isel_emit_uoverflow(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    bw: u32,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let is_64 = bw == 64u32;
    // Matches isel.c lines 213-290 (using reg 0, reg 2, reg 3, and R8..R11 for 64-bit umul)
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(0), x64_op_frame(slot_offset + lhs_v, 0));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(2), x64_op_frame(slot_offset + rhs_v, 0));
    if !is_64 {
        let mut mask: i64 = 0i64;
        let mut uint_max: i64 = 0i64;
        if bw == 8u32 {
            mask = 0xFFi64;
            uint_max = 0xFFi64;
        } else if bw == 16u32 {
            mask = 0xFFFFi64;
            uint_max = 0xFFFFi64;
        } else if bw == 32u32 {
            mask = 0xFFFFFFFFi64;
            uint_max = 0xFFFFFFFFi64;
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(3), x64_op_imm(mask));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(0), x64_op_reg(3));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(2), x64_op_reg(3));
        if kind == LIR_INST_UADD_OVERFLOW {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(0), x64_op_reg(2));
        } else if kind == LIR_INST_USUB_OVERFLOW {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(0), x64_op_reg(2));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(0), x64_op_reg(2));
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(3), x64_op_imm(uint_max));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(0), x64_op_reg(3));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_A as i64), x64_op_reg(0));
    } else {
        if kind == LIR_INST_UADD_OVERFLOW {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(0), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_B as i64), x64_op_reg(0));
        } else if kind == LIR_INST_USUB_OVERFLOW {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(0), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_B as i64), x64_op_reg(0));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R8), x64_op_reg(0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_R8), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R8), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_reg(0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R9), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_R10), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R10), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R11), x64_op_imm(32i64));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(0), x64_op_reg(REG_R9));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(0), x64_op_reg(REG_R11));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(1), x64_op_reg(REG_R9));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(1), x64_op_reg(REG_R10));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(2), x64_op_reg(REG_R8));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(2), x64_op_reg(REG_R11));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(REG_R8), x64_op_reg(REG_R10));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_reg(1));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R9), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(0), x64_op_reg(REG_R9));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R9), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(0), x64_op_reg(REG_R9));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(1), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(1), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(2), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(2), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R8), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(1), x64_op_reg(2));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(1), x64_op_reg(REG_R8));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(1), x64_op_imm(32i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(0), x64_op_reg(1));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(0), x64_op_imm(0i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_NE as i64), x64_op_reg(0));
        }
    }
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(0), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(0));
}

fn isel_emit_soverflow(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    bw: u32,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let is_64 = bw == 64u32;
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
    if kind == LIR_INST_SADD_OVERFLOW {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
    } else if kind == LIR_INST_SSUB_OVERFLOW {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
    } else {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
    }
    if is_64 {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_O as i64), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));
    } else {
        let mut int_min: i64 = -2147483648i64;
        let mut int_max: i64 = 2147483647i64;
        if bw == 8u32 {
            int_min = -128i64;
            int_max = 127i64;
        } else if bw == 16u32 {
            int_min = -32768i64;
            int_max = 32767i64;
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(int_min));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_L as i64), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RCX), x64_op_imm(1i64));

        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(int_max));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_G as i64), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));

        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
    }
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
}

fn isel_emit_udiv_urem(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    slot_offset: u32,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R8), x64_op_frame(slot_offset + lhs_v, 0));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_frame(slot_offset + rhs_v, 0));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_reg(REG_R9));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_R10), x64_op_imm(63i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_reg(REG_R10));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R11), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_reg(REG_R8));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_RAX), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_reg(REG_R11));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(0i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IDIV, x64_op_reg(REG_R9), x64_op_none());
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RAX), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RDX), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_imm(0i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R11), x64_op_reg(REG_R10));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(REG_R11), x64_op_imm(1i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_R8), x64_op_reg(REG_R11));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_OR, x64_op_reg(REG_RDX), x64_op_reg(REG_R8));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RDX), x64_op_reg(REG_R9));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_AE as i64), x64_op_reg(REG_RCX));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RCX), x64_op_imm(1i64));
    if kind == LIR_INST_UDIV {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    } else {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R11), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_R9), x64_op_reg(REG_R11));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RDX), x64_op_reg(REG_R9));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RDX));
    }
}

fn isel_atomic_sz(inst: *const LirInst, interner: view<TypeInterner>) -> u8 {
    let bw = unsafe { (*inst).bit_width };
    if bw == 8u32 { return 1u8; }
    if bw == 16u32 { return 2u8; }
    if bw == 32u32 { return 4u8; }
    if bw == 64u32 { return 8u8; }
    let ty_v = unsafe { (*inst).ty.v };
    let s = type_size(TypeId { v: ty_v }, interner);
    if s == 1u32 || s == 2u32 || s == 4u32 || s == 8u32 { return s as u8; }
    8u8
}

struct RawIselCtx {
    mi: *mut X64MIBody,
    mbb: *mut X64MIBb,
    vregs: *mut LirVReg,
    vreg_count: usize,
    slot_offset: u32,
}

fn isel_cx_vreg_ty(cx: *const RawIselCtx, vreg_idx: u32) -> TypeId {
    let mut res = TypeId { v: 0u32 };
    if (vreg_idx as usize) < (unsafe { (*cx).vreg_count }) && (unsafe { (*cx).vregs as usize }) != 0 {
        let vp = unsafe { lir_vreg_at((*cx).vregs, vreg_idx as usize) };
        let v = unsafe { (*vp).ty.v };
        res = TypeId { v: v };
    }
    res
}

fn isel_emit_sym_addr(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    dest_slot: u32,
    inst: *const LirInst
) {
    let sym_name = unsafe { (*inst).sym_name };
    let sym_len = unsafe { (*inst).sym_len };
    let opc = if (unsafe { (*inst).kind }) == LIR_INST_TLS_ADDR { X64_MI_TLS_ADDR } else { X64_MI_LEA };
    let mi_inst = x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_sym(0u32));
    unsafe {
        (*mi_inst).msg = sym_name;
        (*mi_inst).msg_len = sym_len;
    }
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(dest_slot, 0), x64_op_reg(REG_RAX));
}

fn isel_raw_lower_arith(cx: *mut RawIselCtx, inst: *const LirInst, interner: view<TypeInterner>) -> bool {
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let lhs_v = unsafe { (*inst).lhs.v };
    let rhs_v = unsafe { (*inst).rhs.v };
    let operand_v = unsafe { (*inst).operand.v };
    let mi = unsafe { (*cx).mi };
    let mbb = unsafe { (*cx).mbb };
    let slot_offset = unsafe { (*cx).slot_offset };

    if kind == LIR_INST_ADD || kind == LIR_INST_SUB || kind == LIR_INST_BIT_AND || kind == LIR_INST_BIT_OR || kind == LIR_INST_BIT_XOR || kind == LIR_INST_MUL {
        let opc = if kind == LIR_INST_ADD {
            X64_MI_ADD
        } else if kind == LIR_INST_SUB {
            X64_MI_SUB
        } else if kind == LIR_INST_BIT_AND {
            X64_MI_AND
        } else if kind == LIR_INST_BIT_OR {
            X64_MI_OR
        } else if kind == LIR_INST_BIT_XOR {
            X64_MI_XOR
        } else {
            X64_MI_IMUL
        };
        let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        }
        return true;
    } else if kind == LIR_INST_SHL || kind == LIR_INST_SHR || kind == LIR_INST_SAR {
        let opc = if kind == LIR_INST_SHL {
            X64_MI_SHL
        } else if kind == LIR_INST_SAR {
            X64_MI_SAR
        } else {
            X64_MI_SHR
        };
        let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + rhs_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        }
        return true;
    } else if kind >= LIR_INST_ICMP_EQ && kind <= LIR_INST_ICMP_UGE {
        let cond = isel_icmp_cc(kind);
        let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + rhs_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(cond as i64), x64_op_reg(REG_RAX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(0xFFi64));
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_RAX);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        }
        return true;
    } else if kind == LIR_INST_UADD_OVERFLOW || kind == LIR_INST_USUB_OVERFLOW || kind == LIR_INST_UMUL_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        unsafe {
            isel_emit_uoverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
        }
        return true;
    } else if kind == LIR_INST_SADD_OVERFLOW || kind == LIR_INST_SSUB_OVERFLOW || kind == LIR_INST_SMUL_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        unsafe {
            isel_emit_soverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
        }
        return true;
    } else if kind == LIR_INST_UDIV_OVERFLOW || kind == LIR_INST_UREM_OVERFLOW {
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        }
        return true;
    } else if kind == LIR_INST_SDIV_OVERFLOW || kind == LIR_INST_SREM_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        let mut int_min: i64 = (0x8000000000000000u64) as i64;
        if bw == 8u32 {
            int_min = -128i64;
        } else if bw == 16u32 {
            int_min = -32768i64;
        } else if bw == 32u32 {
            int_min = -2147483648i64;
        }
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_frame(slot_offset + rhs_v, 0));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RDX), x64_op_imm(-1i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_E as i64), x64_op_reg(REG_RCX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RCX), x64_op_imm(1i64));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(int_min));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_E as i64), x64_op_reg(REG_RAX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));

            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        }
        return true;
    } else if kind == LIR_INST_DIV || kind == LIR_INST_REM {
        let res_reg = if kind == LIR_INST_DIV { REG_RAX } else { REG_RDX };
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_reg(REG_RAX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(REG_RDX), x64_op_imm(63i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IDIV, x64_op_frame(slot_offset + rhs_v, 0), x64_op_none());
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(res_reg));
        }
        return true;
    } else if kind == LIR_INST_UDIV || kind == LIR_INST_UREM {
        unsafe {
            isel_emit_udiv_urem(mut_view(*mi), mut_view(*mbb), kind, slot_offset, dest_v, lhs_v, rhs_v);
        }
        return true;
    } else if kind == LIR_INST_NEG {
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + operand_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
        }
        return true;
    } else if kind == LIR_INST_NOT {
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + operand_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, x64_op_reg(REG_RAX), x64_op_imm(1i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        }
        return true;
    } else if kind == LIR_INST_BITNOT {
        let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
        unsafe {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_imm(-1i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R10), x64_op_frame(slot_offset + operand_v, 0));
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dty, interner, REG_R10);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_R10));
        }
        return true;
    }
    false
}

fn isel_raw_lower_abi(cx: *mut RawIselCtx, inst: *const LirInst, interner: view<TypeInterner>) -> bool {
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let mi = unsafe { (*cx).mi };
    let mbb = unsafe { (*cx).mbb };
    let slot_offset = unsafe { (*cx).slot_offset };

    if kind == LIR_INST_ABI_ARG {
        let loc_kind = unsafe { (*inst).loc_kind };
        let loc_ro = unsafe { (*inst).loc_reg_or_offset };
        let val_v = unsafe { (*inst).val.v };
        if dest_v != LIR_VREG_NONE {
            if loc_kind == ABI_LOC_REG {
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(loc_ro as i32));
                }
            } else if loc_kind == ABI_LOC_STACK {
                let mem = x64_op_mem(REG_RBP, REG_NONE, 1u8, (16u32 + loc_ro) as i32, false);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), mem);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if loc_kind == ABI_LOC_INDIRECT {
                let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
                let size = type_size(dty, interner);
                unsafe {
                    if loc_ro < 16u32 {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_reg(loc_ro as i32));
                    } else {
                        let mem = x64_op_mem(REG_RBP, REG_NONE, 1u8, (16u32 + loc_ro) as i32, false);
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), mem);
                    }
                    let mut off: u32 = 0u32;
                    while off < size {
                        let chunk = isel_chunk_size(size - off);
                        let src_mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), src_mem);
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                        off = off + chunk;
                    }
                }
            }
        } else {
            if loc_kind == ABI_LOC_REG {
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(loc_ro as i32), x64_op_frame(slot_offset + val_v, 0));
                }
            } else if loc_kind == ABI_LOC_STACK {
                let mem = x64_op_mem(REG_RSP, REG_NONE, 1u8, loc_ro as i32, false);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + val_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, mem, x64_op_reg(REG_RAX));
                }
            } else if loc_kind == ABI_LOC_INDIRECT {
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + val_v, 0));
                    if loc_ro < 16u32 {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(loc_ro as i32), x64_op_reg(REG_RAX));
                    } else {
                        let mem = x64_op_mem(REG_RSP, REG_NONE, 1u8, loc_ro as i32, false);
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, mem, x64_op_reg(REG_RAX));
                    }
                }
            }
        }
        return true;
    } else if kind == LIR_INST_CALL {
        let callee_ty_id = unsafe { TypeId { v: (*inst).callee_ty.v } };
        let dst_addr_v = unsafe { (*inst).dst_addr.v };
        let callee_vreg_v = unsafe { (*inst).callee_vreg.v };
        let sym_name = unsafe { (*inst).sym_name };
        let sym_len = unsafe { (*inst).sym_len };

        let callee_ty = type_get(interner, callee_ty_id);
        let mut ret_ty = TypeId { v: 0u32 };
        if (callee_ty as usize) != 0 {
            let ck = unsafe { (*callee_ty).kind };
            if ck == TY_FN {
                ret_ty = unsafe { TypeId { v: (*callee_ty).ret_type.v } };
            } else if ck == TY_CLOSURE {
                let r_v = unsafe { (*callee_ty).ret_type.v };
                if r_v != 0u32 {
                    ret_ty = TypeId { v: r_v };
                } else {
                    let fn_v = unsafe { (*callee_ty).fn_type.v };
                    if fn_v != 0u32 {
                        let fn_t = type_get(interner, TypeId { v: fn_v });
                        if (fn_t as usize) != 0 {
                            ret_ty = unsafe { TypeId { v: (*fn_t).ret_type.v } };
                        }
                    }
                }
            }
        }
        if ret_ty.v != 0u32 {
            let ret_size = type_size(ret_ty, interner);
            if isel_type_is_ret_in_mem(ret_size) {
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + dst_addr_v, 0));
                }
            }
        }
        unsafe {
            if (sym_name as usize) != 0 {
                let call_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CALL, x64_op_none(), x64_op_none());
                (*call_mi).msg = sym_name;
                (*call_mi).msg_len = sym_len;
            } else {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_frame(slot_offset + callee_vreg_v, 0));
                let call_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CALL, x64_op_reg(REG_R10), x64_op_none());
                (*call_mi).op_count = 1u8;
            }
        }
        return true;
    } else if kind == LIR_INST_ABI_RESULT {
        let loc_kind = unsafe { (*inst).loc_kind };
        let loc_ro = unsafe { (*inst).loc_reg_or_offset };
        if loc_kind == ABI_LOC_REG {
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(loc_ro as i32));
            }
        } else if loc_kind == ABI_LOC_INDIRECT {
            let dty = isel_cx_vreg_ty(cx as *const RawIselCtx, dest_v);
            let mut load_sz = type_size(dty, interner);
            unsafe {
                if load_sz <= 8u32 {
                    if load_sz != 1u32 && load_sz != 2u32 && load_sz != 4u32 && load_sz != 8u32 {
                        load_sz = 8u32;
                    }
                    let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, x64_op_reg(REG_RCX), mem);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
                } else {
                    let mut off: u32 = 0u32;
                    while off < load_sz {
                        let chunk = isel_chunk_size(load_sz - off);
                        let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), mem);
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                        off = off + chunk;
                    }
                }
            }
        }
        return true;
    }
    false
}

pub fn x64_isel_raw_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> *mut X64MIBody {
    let mi = x64_mi_body_new(mut_view(*arena), lir.bb_count);
    unsafe {
        (*mi).shadow_space = lir.frame_req.max_outgoing_args_bytes;
        (*mi).stack_args_size = 0u32;
    }

    let slot_offset = lir.slot_count as u32;
    let mut callee_ret_in_mem = false;
    if lir.slot_count > 0 {
        let s0_ty = isel_slot0_ty(lir);
        let ret_size = type_size(s0_ty, interner);
        callee_ret_in_mem = isel_type_is_ret_in_mem(ret_size);
    }

    let mut raw_cx = RawIselCtx {
        mi: mi,
        mbb: 0 as *mut X64MIBb,
        vregs: lir.vregs,
        vreg_count: lir.vreg_count,
        slot_offset: slot_offset,
    };
    let pcx = unsafe { address_of_mut(raw_cx) as *mut RawIselCtx };

    let mut b: usize = 0;
    while b < lir.bb_count {
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let mbb = unsafe { x64_mi_bb_at((*mi).bbs, b) };
        unsafe {
            x64_mi_bb_reset(mut_view(*mbb), b as u32);
            (*pcx).mbb = mbb;
        }

        if b == 0 && callee_ret_in_mem {
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(0u32, 0), x64_op_reg(REG_RCX));
            }
        }

        let inst_count = unsafe { (*lbb).inst_count };
        let insts_base = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < inst_count {
            let inst = unsafe { lir_inst_at(insts_base, i) };
            let kind = unsafe { (*inst).kind };
            let dest_v = unsafe { (*inst).dest.v };
            let lhs_v = unsafe { (*inst).lhs.v };
            let rhs_v = unsafe { (*inst).rhs.v };
            let operand_v = unsafe { (*inst).operand.v };

            if kind == LIR_INST_CONST {
                let cval = unsafe { (*inst).const_val as i64 };
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(cval));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_CONST_STR {
                let s_bytes = unsafe { (*inst).str_bytes };
                let s_len = unsafe { (*inst).str_len };
                unsafe {
                    let sym_id = x64_mi_add_string(mut_view(*mi), s_bytes, s_len);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_sym(sym_id));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(s_len as i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 8), x64_op_reg(REG_RAX));
                }
            } else if kind == LIR_INST_FN_ADDR || kind == LIR_INST_TLS_ADDR {
                unsafe {
                    isel_emit_sym_addr(mut_view(*mi), mut_view(*mbb), slot_offset + dest_v, inst as *const LirInst);
                }
            } else if isel_raw_lower_arith(pcx, inst as *const LirInst, interner) {
                // Lowered by isel_raw_lower_arith
            } else if isel_raw_lower_abi(pcx, inst as *const LirInst, interner) {
                // Lowered by isel_raw_lower_abi
            } else if kind == LIR_INST_STACK_ADDR {
                let slot_v = unsafe { (*inst).slot.v };
                let mut ret_in_mem = false;
                if slot_v == 0u32 && lir.slot_count > 0 {
                    let s0_ty = isel_slot0_ty(lir);
                    let ret_size = type_size(s0_ty, interner);
                    ret_in_mem = isel_type_is_ret_in_mem(ret_size);
                }
                unsafe {
                    if ret_in_mem {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    } else {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_frame(slot_v, 0));
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    }
                }
            } else if kind == LIR_INST_LOAD {
                let ptr_v = unsafe { (*inst).ptr.v };
                let load_ty_v = unsafe { (*inst).ty.v };
                let raw_size = type_size(TypeId { v: load_ty_v }, interner);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + ptr_v, 0));
                    if raw_size <= 8u32 {
                        let mut load_sz = raw_size;
                        if load_sz != 1u32 && load_sz != 2u32 && load_sz != 4u32 && load_sz != 8u32 {
                            load_sz = 8u32;
                        }
                        let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, load_sz as u8, x64_op_reg(REG_RCX), mem);

                        let mut is_signed = false;
                        let t = type_get(interner, TypeId { v: load_ty_v });
                        if (t as usize) != 0 {
                            let tk = (*t).kind;
                            if tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE || tk == TY_INT_VAR {
                                is_signed = true;
                            }
                        }
                        let shr_opc = if is_signed { X64_MI_SAR } else { X64_MI_SHR };
                        if raw_size == 1u32 {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RCX), x64_op_imm(56i64));
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), shr_opc, x64_op_reg(REG_RCX), x64_op_imm(56i64));
                        } else if raw_size == 2u32 {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RCX), x64_op_imm(48i64));
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), shr_opc, x64_op_reg(REG_RCX), x64_op_imm(48i64));
                        } else if raw_size == 4u32 {
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RCX), x64_op_imm(32i64));
                            x64_mi_emit(mut_view(*mi), mut_view(*mbb), shr_opc, x64_op_reg(REG_RCX), x64_op_imm(32i64));
                        }
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
                    } else {
                        let mut off: u32 = 0u32;
                        while off < raw_size {
                            let chunk = isel_chunk_size(raw_size - off);
                            let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), mem);
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                            off = off + chunk;
                        }
                    }
                }
            } else if kind == LIR_INST_STORE {
                let ptr_v = unsafe { (*inst).ptr.v };
                let val_v = unsafe { (*inst).val.v };
                let val_ty = isel_vreg_ty(lir, val_v);
                let mut size = type_size(val_ty, interner);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + ptr_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + val_v, 0));
                    if size <= 8u32 {
                        if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                            size = 8u32;
                        }
                        let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, mem, x64_op_reg(REG_RCX));
                    } else {
                        let mut off: u32 = 0u32;
                        while off < size {
                            let chunk = isel_chunk_size(size - off);
                            let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + val_v, off as i32));
                            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, mem, x64_op_reg(REG_RCX));
                            off = off + chunk;
                        }
                    }
                }
            } else if kind == LIR_INST_ATOMIC_LOAD {
                let ptr_v = unsafe { (*inst).ptr.v };
                let elem_ty_v = unsafe { (*inst).ty.v };
                let sz = isel_atomic_sz(inst as *const LirInst, interner);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + ptr_v, 0));
                    let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, sz, x64_op_reg(REG_RCX), mem);
                    isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RCX);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                }
            } else if kind == LIR_INST_ATOMIC_STORE {
                let ptr_v = unsafe { (*inst).ptr.v };
                let val_v = unsafe { (*inst).val.v };
                let ord = unsafe { (*inst).ordering };
                let sz = isel_atomic_sz(inst as *const LirInst, interner);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + ptr_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + val_v, 0));
                    let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                    if ord == LIR_ORDER_SEQ_CST {
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_XCHG, sz, mem, x64_op_reg(REG_RCX));
                    } else {
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, sz, mem, x64_op_reg(REG_RCX));
                    }
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                }
            } else if kind == LIR_INST_ATOMIC_RMW {
                let ptr_v = unsafe { (*inst).ptr.v };
                let val_v = unsafe { (*inst).val.v };
                let elem_ty_v = unsafe { (*inst).ty.v };
                let rmw_op = unsafe { (*inst).rmw_op };
                let sz = isel_atomic_sz(inst as *const LirInst, interner);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + ptr_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_frame(slot_offset + val_v, 0));
                    let mem = x64_op_mem(REG_RCX, REG_NONE, 1u8, 0, false);
                    if rmw_op == LIR_ATOMIC_RMW_XCHG {
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_XCHG, sz, mem, x64_op_reg(REG_RDX));
                        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RDX);
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RDX));
                    } else if rmw_op == LIR_ATOMIC_RMW_ADD {
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_XADD, sz, mem, x64_op_reg(REG_RDX));
                        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RDX);
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RDX));
                    } else if rmw_op == LIR_ATOMIC_RMW_SUB {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
                        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_XADD, sz, mem, x64_op_reg(REG_RAX));
                        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    } else {
                        let loop_mi = x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_ATOMIC_RMW_LOOP, sz, mem, x64_op_reg(REG_RDX));
                        (*loop_mi).msg_len = rmw_op as usize;
                        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    }
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                }
            } else if kind == LIR_INST_ATOMIC_CAS {
                let ptr_v = unsafe { (*inst).ptr.v };
                let ok_v = unsafe { (*inst).cas_ok.v };
                let elem_ty_v = unsafe { (*inst).ty.v };
                let sz = isel_atomic_sz(inst as *const LirInst, interner);
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + ptr_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_frame(slot_offset + rhs_v, 0));
                    let mem = x64_op_mem(REG_RCX, REG_NONE, 1u8, 0, false);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_CMPXCHG, sz, mem, x64_op_reg(REG_RDX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_E as i64), x64_op_reg(REG_R8));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_R8), x64_op_imm(1i64));
                    isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + ok_v, 0), x64_op_reg(REG_R8));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                }
            } else if kind == LIR_INST_FENCE {
                let is_comp = unsafe { (*inst).is_compiler_only };
                let ord = unsafe { (*inst).ordering };
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
                    if !is_comp && ord == LIR_ORDER_SEQ_CST {
                        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MFENCE, x64_op_none(), x64_op_none());
                    }
                }
            } else if kind == LIR_INST_PAUSE {
                unsafe {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_PAUSE, x64_op_none(), x64_op_none());
                }
            }

            i = i + 1;
        }

        // Terminators
        let term_kind = unsafe { (*lbb).term.kind };
        if term_kind == LIR_TERM_SWITCH {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let t_count = unsafe { (*lbb).term.count };
            let targets_base = unsafe { (*lbb).term.targets };
            let otherwise_v = unsafe { (*lbb).term.otherwise.v };
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_frame(slot_offset + cond_v, 0));
                let mut k: usize = 0;
                while k < t_count {
                    let tp = lir_switch_target_at(targets_base, k);
                    let t_val = (*tp).val as i64;
                    let t_bb = (*tp).target.v as i64;
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_R10), x64_op_imm(t_val));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, x64_op_imm(CC_E as i64), x64_op_imm(t_bb));
                    k = k + 1;
                }
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(otherwise_v as i64), x64_op_none());
            }
        } else if term_kind == LIR_TERM_JCC {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let then_v = unsafe { (*lbb).term.then_target.v };
            let else_v = unsafe { (*lbb).term.else_target.v };
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + cond_v, 0));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, x64_op_imm(CC_NE as i64), x64_op_imm(then_v as i64));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(else_v as i64), x64_op_none());
            }
        } else if term_kind == LIR_TERM_ASSERT {
            let cond_v = unsafe { (*lbb).term.cond.v };
            let target_v = unsafe { (*lbb).term.assert_target.v };
            let msg_ptr = unsafe { (*lbb).term.msg_ptr };
            let msg_len = unsafe { (*lbb).term.msg_len };
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + cond_v, 0));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(1i64));
                let assert_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ASSERT, x64_op_imm(target_v as i64), x64_op_none());
                (*assert_mi).msg = msg_ptr;
                (*assert_mi).msg_len = msg_len;
            }
        } else if term_kind == LIR_TERM_JMP {
            let jmp_v = unsafe { (*lbb).term.jmp_target.v };
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(jmp_v as i64), x64_op_none());
            }
        } else if term_kind == LIR_TERM_RETURN {
            let s0_ty = isel_slot0_ty(lir);
            let ret_ty = type_get(interner, s0_ty);
            let mut is_unit = false;
            if (ret_ty as usize) != 0 {
                let rk = unsafe { (*ret_ty).kind };
                if rk == TY_UNIT {
                    is_unit = true;
                }
            }
            unsafe {
                if is_unit {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                } else {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
                }
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_RET, x64_op_none(), x64_op_none());
            }
        }

        b = b + 1;
    }

    mi
}

// =============================================================================
// 4. Optimized Instruction Selection & Branchless If-Conversion (AXS-MCOPT-010..014)
// =============================================================================

@derive(Copy)
struct IselMagicU64 {
    magic_m: u64,
    shift_s: u32,
    add_flag: bool,
}

@derive(Copy)
struct IselAddrMode {
    base_v: u32,
    index_v: u32,
    scale: u8,
    disp: i32,
}

struct IselOptCtx {
    slot_offset: u32,
    ret_in_mem: bool,
    vreg_count: usize,
    slot_count: usize,
    bb_count: usize,
    def_bb: *mut u32,
    def_idx: *mut usize,
    def_cnt: *mut u32,
    def_inst: *mut *mut LirInst,
    use_cnt: *mut u32,
    cross_bb: *mut u8,
    vreg_alias: *mut u32,
    slot_escaped: *mut u8,
    slot_is_param: *mut u8,
    slot_store_cnt: *mut u32,
    slot_load_cnt: *mut u32,
    slot_const_ok: *mut u8,
    slot_const_val: *mut i64,
    slot_single_bb: *mut u8,
    slot_single_ld_v: *mut u32,
    pred_cnt: *mut u32,
    bb_skip: *mut u8,
}

unsafe fn isel_u8_at(base: *mut u8, idx: usize) -> *mut u8 {
    ((base as usize) + idx) as *mut u8
}

unsafe fn isel_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = lir_mul_usize(idx, size_of<u32>());
    ((base as usize) + off) as *mut u32
}

unsafe fn isel_usize_at(base: *mut usize, idx: usize) -> *mut usize {
    let off = lir_mul_usize(idx, size_of<usize>());
    ((base as usize) + off) as *mut usize
}

unsafe fn isel_i64_at(base: *mut i64, idx: usize) -> *mut i64 {
    let off = lir_mul_usize(idx, size_of<i64>());
    ((base as usize) + off) as *mut i64
}

unsafe fn isel_inst_ptr_at(base: *mut *mut LirInst, idx: usize) -> *mut *mut LirInst {
    let off = lir_mul_usize(idx, size_of<*mut LirInst>());
    ((base as usize) + off) as *mut *mut LirInst
}

fn isel_fits_i32(val: i64) -> bool {
    val >= -2147483648i64 && val <= 2147483647i64
}

fn isel_is_pow2_u64(v: u64) -> bool {
    v > 0u64 && (v & (v - 1u64)) == 0u64
}

fn isel_ctz_u64(v: u64) -> u32 {
    let mut x = v;
    let mut n: u32 = 0u32;
    while n < 64u32 && (x & 1u64) == 0u64 {
        x = x >> 1u64;
        n = n + 1u32;
    }
    n
}

fn isel_udiv64(n: u64, d: u64) -> u64 {
    if d == 0u64 {
        return 0u64;
    }
    let mut q: u64 = 0u64;
    let mut r: u64 = 0u64;
    let mut i: u32 = 64u32;
    while i > 0u32 {
        i = i - 1u32;
        let bit = (n >> (i as u64)) & 1u64;
        let r_hi = r >> 63u64;
        r = (r << 1u64) | bit;
        if r_hi != 0u64 || r >= d {
            r = r - d;
            q = q | (1u64 << (i as u64));
        }
    }
    q
}

fn isel_urem64(n: u64, d: u64) -> u64 {
    if d == 0u64 {
        return 0u64;
    }
    let mut r: u64 = 0u64;
    let mut i: u32 = 64u32;
    while i > 0u32 {
        i = i - 1u32;
        let bit = (n >> (i as u64)) & 1u64;
        let r_hi = r >> 63u64;
        r = (r << 1u64) | bit;
        if r_hi != 0u64 || r >= d {
            r = r - d;
        }
    }
    r
}

fn isel_umagic64(d: u64) -> IselMagicU64 {
    let two63: u64 = 0x8000000000000000u64;
    let all_ones: u64 = 0xFFFFFFFFFFFFFFFFu64;
    let neg_d: u64 = (all_ones - d) + 1u64;
    let rem_neg_d = isel_urem64(neg_d, d);
    let nc: u64 = all_ones - rem_neg_d;
    let mut p: u32 = 63u32;
    let mut q1: u64 = isel_udiv64(two63, nc);
    let mut r1: u64 = isel_urem64(two63, nc);
    let mut q2: u64 = isel_udiv64(two63 - 1u64, d);
    let mut r2: u64 = isel_urem64(two63 - 1u64, d);
    let mut add_flag = false;

    while true {
        p = p + 1u32;
        if r1 >= nc - r1 {
            q1 = (q1 << 1u64) | 1u64;
            r1 = r1 - (nc - r1);
        } else {
            q1 = q1 << 1u64;
            r1 = r1 << 1u64;
        }
        if r2 >= (d - 1u64) - r2 {
            if q2 >= 0x7FFFFFFFFFFFFFFFu64 {
                add_flag = true;
            }
            q2 = (q2 << 1u64) | 1u64;
            r2 = r2 - ((d - 1u64) - r2);
        } else {
            if q2 >= two63 {
                add_flag = true;
            }
            q2 = q2 << 1u64;
            r2 = (r2 << 1u64) | 1u64;
        }
        let delta: u64 = d - 1u64 - r2;
        if p >= 128u32 {
            break;
        }
        if q1 > delta || (q1 == delta && r1 != 0u64) {
            break;
        }
    }

    let mag_m: u64 = if q2 == all_ones { 0u64 } else { q2 + 1u64 };
    IselMagicU64 {
        magic_m: mag_m,
        shift_s: p - 64u32,
        add_flag: add_flag,
    }
}

fn isel_tag_range(first_before: *mut X64MI, last_before: *mut X64MI, mbb: view<X64MIBb>, vreg: u32) {
    if vreg == LIR_VREG_NONE {
        return;
    }
    let mut cur: *mut X64MI = 0 as *mut X64MI;
    if (last_before as usize) != 0 {
        cur = unsafe { (*last_before).next };
    } else if (first_before as usize) == 0 {
        cur = mbb.first_inst;
    }
    while (cur as usize) != 0 {
        unsafe {
            (*cur).origin_vreg = vreg;
            cur = (*cur).next;
        }
    }
}

fn isel_resolve_vreg(ctx: view<IselOptCtx>, v: u32) -> u32 {
    let mut cur = v;
    let mut steps: u32 = 0u32;
    while (cur as usize) < ctx.vreg_count && steps < 8u32 {
        let next_v = unsafe { *isel_u32_at(ctx.vreg_alias, cur as usize) };
        if next_v == LIR_VREG_NONE || next_v == cur {
            break;
        }
        cur = next_v;
        steps = steps + 1u32;
    }
    cur
}

fn isel_type_can_prop_const(ty_id: TypeId, interner: view<TypeInterner>) -> bool {
    if ty_id.v == 0u32 {
        return false;
    }
    let t = type_get(interner, TypeId { v: ty_id.v });
    if (t as usize) == 0 {
        return false;
    }
    let tk = unsafe { (*t).kind };
    let ok_kind = tk == TY_BOOL || tk == TY_CHAR ||
        (tk >= TY_I8 && tk <= TY_ISIZE) ||
        (tk >= TY_U8 && tk <= TY_USIZE) ||
        tk == TY_INT_VAR || tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW;
    if !ok_kind {
        return false;
    }
    let sz = type_size(TypeId { v: ty_id.v }, interner);
    (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) &&
    x64_reg_class_for_kind(tk, sz) == REG_CLASS_GPR
}

fn isel_vreg_is_bool(lir: view<LirBody>, interner: view<TypeInterner>, v: u32) -> bool {
    let ty_id = isel_vreg_ty(lir, v);
    let t = type_get(interner, ty_id);
    (t as usize) != 0 && (unsafe { (*t).kind }) == TY_BOOL
}

fn isel_vreg_is_scalar_gpr(lir: view<LirBody>, interner: view<TypeInterner>, v: u32) -> bool {
    let ty_v = isel_vreg_ty(lir, v).v;
    let sz = type_size(TypeId { v: ty_v }, interner);
    (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) &&
    x64_reg_class_for_type(TypeId { v: ty_v }, interner) == REG_CLASS_GPR
}

fn isel_norm_const_to_ty(ty_id: TypeId, interner: view<TypeInterner>, raw_u: u64) -> i64 {
    let ty_v = ty_id.v;
    if ty_v == 0u32 {
        return raw_u as i64;
    }
    let sz = type_size(TypeId { v: ty_v }, interner);
    let is_signed = isel_type_is_signed_int(TypeId { v: ty_v }, interner);
    if sz == 1u32 {
        let b = (raw_u & 0xFFu64) as i64;
        if is_signed && (b & 0x80i64) != 0i64 {
            return b - 256i64;
        }
        return b;
    } else if sz == 2u32 {
        let w = (raw_u & 0xFFFFu64) as i64;
        if is_signed && (w & 0x8000i64) != 0i64 {
            return w - 65536i64;
        }
        return w;
    } else if sz == 4u32 {
        let d = (raw_u & 0xFFFFFFFFu64) as i64;
        if is_signed && (d & 0x80000000i64) != 0i64 {
            return d - 4294967296i64;
        }
        return d;
    }
    raw_u as i64
}

fn isel_const_inst_val(
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    inst: *const LirInst,
    dest_v: u32
) -> i64 {
    let raw_u = unsafe { (*inst).const_val };
    let inst_ty_v = unsafe { (*inst).ty.v };
    let dst_ty_v = isel_vreg_ty(lir, dest_v).v;
    if inst_ty_v != dst_ty_v && dst_ty_v != 0u32 {
        return isel_norm_const_to_ty(TypeId { v: dst_ty_v }, interner, raw_u);
    }
    raw_u as i64
}

fn isel_vreg_const(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    v: u32,
    out_val: mut_view<i64>
) -> bool {
    let rv = isel_resolve_vreg(ctx, v);
    if (rv as usize) >= ctx.vreg_count {
        return false;
    }
    if (unsafe { *isel_u32_at(ctx.def_cnt, rv as usize) }) != 1u32 {
        return false;
    }
    let inst = unsafe { *isel_inst_ptr_at(ctx.def_inst, rv as usize) };
    if (inst as usize) == 0 {
        return false;
    }
    let v_ty_v = isel_vreg_ty(lir, v).v;
    let rv_ty_v = isel_vreg_ty(lir, rv).v;
    let k = unsafe { (*inst).kind };
    if k == LIR_INST_CONST {
        let c0 = isel_const_inst_val(lir, interner, inst as *const LirInst, rv);
        if v_ty_v != rv_ty_v && v_ty_v != 0u32 {
            *out_val = isel_norm_const_to_ty(TypeId { v: v_ty_v }, interner, c0 as u64);
        } else {
            *out_val = c0;
        }
        return true;
    }
    if k == LIR_INST_NEG {
        let op_v = unsafe { (*inst).operand.v };
        let mut inner: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, op_v, mut_view(inner)) {
            let iu: u64 = inner as u64;
            let neg_u: u64 = if iu == 0u64 { 0u64 } else { (0xFFFFFFFFFFFFFFFFu64 - iu) + 1u64 };
            let c1 = isel_norm_const_to_ty(TypeId { v: rv_ty_v }, interner, neg_u);
            if v_ty_v != rv_ty_v && v_ty_v != 0u32 {
                *out_val = isel_norm_const_to_ty(TypeId { v: v_ty_v }, interner, c1 as u64);
            } else {
                *out_val = c1;
            }
            return true;
        }
        return false;
    }
    if k == LIR_INST_LOAD {
        let ptr_v = unsafe { (*inst).ptr.v };
        if (ptr_v as usize) < ctx.vreg_count && (unsafe { *isel_u32_at(ctx.def_cnt, ptr_v as usize) }) == 1u32 {
            let pinst = unsafe { *isel_inst_ptr_at(ctx.def_inst, ptr_v as usize) };
            if (pinst as usize) != 0 && (unsafe { (*pinst).kind }) == LIR_INST_STACK_ADDR {
                let s = unsafe { (*pinst).slot.v as usize };
                if s > 0 && s < ctx.slot_count && (unsafe { *isel_u8_at(ctx.slot_const_ok, s) }) != 0u8 {
                    let raw_slot = (unsafe { *isel_i64_at(ctx.slot_const_val, s) }) as u64;
                    let slot_ty = unsafe { (*lir_slot_at(lir.slots, s)).ty };
                    let ld_ty = unsafe { (*inst).ty };
                    let c0 = isel_norm_const_to_ty(slot_ty, interner, raw_slot);
                    let c1 = isel_norm_const_to_ty(ld_ty, interner, c0 as u64);
                    let c2 = isel_norm_const_to_ty(TypeId { v: rv_ty_v }, interner, c1 as u64);
                    *out_val = isel_norm_const_to_ty(TypeId { v: v_ty_v }, interner, c2 as u64);
                    return true;
                }
            }
        }
    }
    false
}

fn isel_vreg_is_stack_addr(ctx: view<IselOptCtx>, ptr_v: u32, out_slot: mut_view<u32>) -> bool {
    if (ptr_v as usize) >= ctx.vreg_count {
        return false;
    }
    if (unsafe { *isel_u32_at(ctx.def_cnt, ptr_v as usize) }) != 1u32 {
        return false;
    }
    let pinst = unsafe { *isel_inst_ptr_at(ctx.def_inst, ptr_v as usize) };
    if (pinst as usize) == 0 || (unsafe { (*pinst).kind }) != LIR_INST_STACK_ADDR {
        return false;
    }
    let sv = unsafe { (*pinst).slot.v };
    if (sv as usize) >= ctx.slot_count {
        return false;
    }
    if sv == 0u32 && ctx.ret_in_mem {
        return false;
    }
    *out_slot = sv;
    true
}

fn isel_match_scaled_index(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    v: u32,
    cur_bb: u32,
    out_idx: mut_view<u32>,
    out_scale: mut_view<u8>
) -> bool {
    let rv = isel_resolve_vreg(ctx, v);
    if (rv as usize) >= ctx.vreg_count {
        return false;
    }
    if (unsafe { *isel_u32_at(ctx.def_cnt, rv as usize) }) != 1u32 {
        return false;
    }
    if (unsafe { *isel_u32_at(ctx.def_bb, rv as usize) }) != cur_bb {
        return false;
    }
    let ty_id = isel_vreg_ty(lir, rv);
    if type_size(ty_id, interner) != 8u32 {
        return false;
    }
    let inst = unsafe { *isel_inst_ptr_at(ctx.def_inst, rv as usize) };
    if (inst as usize) == 0 {
        return false;
    }
    let k = unsafe { (*inst).kind };
    if k == LIR_INST_MUL {
        let lhs_v = unsafe { (*inst).lhs.v };
        let rhs_v = unsafe { (*inst).rhs.v };
        let mut c: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(c)) {
            if c == 1i64 || c == 2i64 || c == 4i64 || c == 8i64 {
                *out_idx = isel_resolve_vreg(ctx, lhs_v);
                *out_scale = c as u8;
                return true;
            }
        }
        if isel_vreg_const(ctx, lir, interner, lhs_v, mut_view(c)) {
            if c == 1i64 || c == 2i64 || c == 4i64 || c == 8i64 {
                *out_idx = isel_resolve_vreg(ctx, rhs_v);
                *out_scale = c as u8;
                return true;
            }
        }
    } else if k == LIR_INST_SHL {
        let lhs_v = unsafe { (*inst).lhs.v };
        let rhs_v = unsafe { (*inst).rhs.v };
        let mut c: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(c)) {
            if c >= 0i64 && c <= 3i64 {
                *out_idx = isel_resolve_vreg(ctx, lhs_v);
                *out_scale = (1u8 << (c as u8));
                return true;
            }
        }
    }
    false
}

fn isel_match_addr(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    v: u32,
    cur_bb: u32
) -> IselAddrMode {
    let mut cur = isel_resolve_vreg(ctx, v);
    let mut disp: i64 = 0i64;

    let mut depth: u32 = 0u32;
    while depth < 4u32 && (cur as usize) < ctx.vreg_count {
        if (unsafe { *isel_u32_at(ctx.def_cnt, cur as usize) }) != 1u32 ||
           (unsafe { *isel_u32_at(ctx.def_bb, cur as usize) }) != cur_bb {
            break;
        }
        let ty_id = isel_vreg_ty(lir, cur);
        if type_size(ty_id, interner) != 8u32 {
            break;
        }
        let inst = unsafe { *isel_inst_ptr_at(ctx.def_inst, cur as usize) };
        if (inst as usize) == 0 {
            break;
        }
        let k = unsafe { (*inst).kind };
        if k == LIR_INST_ADD || k == LIR_INST_OFFSET {
            let lv = unsafe { (*inst).lhs.v };
            let rv = unsafe { (*inst).rhs.v };
            let mut c: i64 = 0i64;
            if isel_vreg_const(ctx, lir, interner, rv, mut_view(c)) && isel_fits_i32(c) && isel_fits_i32(disp + c) {
                disp = disp + c;
                cur = isel_resolve_vreg(ctx, lv);
                depth = depth + 1u32;
                continue;
            }
            if isel_vreg_const(ctx, lir, interner, lv, mut_view(c)) && isel_fits_i32(c) && isel_fits_i32(disp + c) {
                disp = disp + c;
                cur = isel_resolve_vreg(ctx, rv);
                depth = depth + 1u32;
                continue;
            }
        } else if k == LIR_INST_SUB {
            let lv = unsafe { (*inst).lhs.v };
            let rv = unsafe { (*inst).rhs.v };
            let mut c: i64 = 0i64;
            if isel_vreg_const(ctx, lir, interner, rv, mut_view(c)) && isel_fits_i32(c) && isel_fits_i32(disp - c) {
                disp = disp - c;
                cur = isel_resolve_vreg(ctx, lv);
                depth = depth + 1u32;
                continue;
            }
        }
        break;
    }

    let mut base_v: u32 = cur;
    let mut index_v: u32 = LIR_VREG_NONE;
    let mut scale: u8 = 1u8;

    if (cur as usize) < ctx.vreg_count &&
       (unsafe { *isel_u32_at(ctx.def_cnt, cur as usize) }) == 1u32 &&
       (unsafe { *isel_u32_at(ctx.def_bb, cur as usize) }) == cur_bb {
        let ty_id = isel_vreg_ty(lir, cur);
        if type_size(ty_id, interner) == 8u32 {
            let inst = unsafe { *isel_inst_ptr_at(ctx.def_inst, cur as usize) };
            if (inst as usize) != 0 {
                let k = unsafe { (*inst).kind };
                if k == LIR_INST_ADD || k == LIR_INST_OFFSET {
                    let lv = isel_resolve_vreg(ctx, unsafe { (*inst).lhs.v });
                    let rv = isel_resolve_vreg(ctx, unsafe { (*inst).rhs.v });
                    let mut idx_cand: u32 = LIR_VREG_NONE;
                    let mut sc_cand: u8 = 1u8;
                    if isel_match_scaled_index(ctx, lir, interner, rv, cur_bb, mut_view(idx_cand), mut_view(sc_cand)) {
                        base_v = lv;
                        index_v = idx_cand;
                        scale = sc_cand;
                    } else if isel_match_scaled_index(ctx, lir, interner, lv, cur_bb, mut_view(idx_cand), mut_view(sc_cand)) {
                        base_v = rv;
                        index_v = idx_cand;
                        scale = sc_cand;
                    } else {
                        base_v = lv;
                        index_v = rv;
                        scale = 1u8;
                    }
                    if (base_v as usize) < ctx.vreg_count &&
                       (unsafe { *isel_u32_at(ctx.def_cnt, base_v as usize) }) == 1u32 &&
                       (unsafe { *isel_u32_at(ctx.def_bb, base_v as usize) }) == cur_bb {
                        let binst = unsafe { *isel_inst_ptr_at(ctx.def_inst, base_v as usize) };
                        if (binst as usize) != 0 {
                            let bk = unsafe { (*binst).kind };
                            if bk == LIR_INST_ADD || bk == LIR_INST_OFFSET {
                                let blv = unsafe { (*binst).lhs.v };
                                let brv = unsafe { (*binst).rhs.v };
                                let mut bc: i64 = 0i64;
                                if isel_vreg_const(ctx, lir, interner, brv, mut_view(bc)) && isel_fits_i32(bc) && isel_fits_i32(disp + bc) {
                                    disp = disp + bc;
                                    base_v = isel_resolve_vreg(ctx, blv);
                                } else if isel_vreg_const(ctx, lir, interner, blv, mut_view(bc)) && isel_fits_i32(bc) && isel_fits_i32(disp + bc) {
                                    disp = disp + bc;
                                    base_v = isel_resolve_vreg(ctx, brv);
                                }
                            }
                        }
                    }
                } else if k == LIR_INST_MUL {
                    let lv = isel_resolve_vreg(ctx, unsafe { (*inst).lhs.v });
                    let rv = isel_resolve_vreg(ctx, unsafe { (*inst).rhs.v });
                    let mut c: i64 = 0i64;
                    if isel_vreg_const(ctx, lir, interner, rv, mut_view(c)) && (c == 3i64 || c == 5i64 || c == 9i64) {
                        base_v = lv;
                        index_v = lv;
                        scale = (c - 1i64) as u8;
                    } else if isel_vreg_const(ctx, lir, interner, lv, mut_view(c)) && (c == 3i64 || c == 5i64 || c == 9i64) {
                        base_v = rv;
                        index_v = rv;
                        scale = (c - 1i64) as u8;
                    }
                }
            }
        }
    }

    IselAddrMode {
        base_v: base_v,
        index_v: index_v,
        scale: scale,
        disp: disp as i32,
    }
}

fn isel_emit_load_vreg(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    reg: i32,
    v: u32
) {
    let mut cval: i64 = 0i64;
    if isel_vreg_const(ctx, lir, interner, v, mut_view(cval)) {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(reg), x64_op_imm(cval));
        return;
    }
    let rv = isel_resolve_vreg(ctx, v);
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(reg), x64_op_frame(ctx.slot_offset + rv, 0));
}

fn isel_emit_addr_mem_op(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    addr: IselAddrMode,
    base_reg: i32,
    idx_reg: i32
) -> X64Op {
    isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), base_reg, addr.base_v);
    if addr.index_v != LIR_VREG_NONE {
        if addr.index_v == addr.base_v {
            return x64_op_mem(base_reg, base_reg, addr.scale, addr.disp, false);
        }
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), idx_reg, addr.index_v);
        return x64_op_mem(base_reg, idx_reg, addr.scale, addr.disp, false);
    }
    x64_op_mem(base_reg, REG_NONE, 1u8, addr.disp, false)
}

fn isel_emit_umagic_div(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    d_u: u64
) {
    // Assumes dividend is in REG_RAX (and saved in REG_R8 if add_flag is true).
    // Produces unsigned quotient in REG_RAX. Clobbers REG_RCX, REG_RDX, REG_R8.
    let mag = isel_umagic64(d_u);
    if mag.add_flag {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R8), x64_op_reg(REG_RAX));
    }
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(mag.magic_m as i64));
    let mul_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MUL, x64_op_reg(REG_RCX), x64_op_none());
    unsafe { (*mul_mi).msg_len = 1; }
    if !mag.add_flag {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
        if mag.shift_s > 0u32 {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_RAX), x64_op_imm(mag.shift_s as i64));
        }
    } else {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_reg(REG_R8));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_RAX), x64_op_imm(1i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
        if mag.shift_s > 1u32 {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_RAX), x64_op_imm((mag.shift_s - 1u32) as i64));
        }
    }
}

fn isel_emit_icmp_flags(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    lhs_v: u32,
    rhs_v: u32
) {
    let mut rc: i64 = 0i64;
    if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(rc)) && isel_fits_i32(rc) {
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(rc));
    } else {
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
    }
}

fn isel_opt_lower_alu_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cur_bb: u32,
    kind: u8,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let slot_offset = ctx.slot_offset;
    let dest_ty = isel_vreg_ty(lir, dest_v);
    let dest_sz = type_size(TypeId { v: dest_ty.v }, interner);

    let mut handled = false;
    if (kind == LIR_INST_ADD || kind == LIR_INST_OFFSET) && dest_sz == 8u32 {
        let addr = isel_match_addr(ctx, lir, interner, dest_v, cur_bb);
        if addr.index_v != LIR_VREG_NONE && (addr.scale > 1u8 || addr.disp != 0) {
            let mem_op = isel_emit_addr_mem_op(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), addr, REG_RAX, REG_RCX);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), mem_op);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
            handled = true;
        }
    }

    if !handled {
        let opc: u32 = if kind == LIR_INST_ADD || kind == LIR_INST_OFFSET {
            X64_MI_ADD
        } else if kind == LIR_INST_SUB {
            X64_MI_SUB
        } else if kind == LIR_INST_BIT_AND {
            X64_MI_AND
        } else if kind == LIR_INST_BIT_OR {
            X64_MI_OR
        } else {
            X64_MI_XOR
        };
        let is_comm = kind != LIR_INST_SUB;
        let mut rc: i64 = 0i64;
        let mut lc: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(rc)) && isel_fits_i32(rc) {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            if !(rc == 0i64 && (opc == X64_MI_ADD || opc == X64_MI_SUB || opc == X64_MI_OR || opc == X64_MI_XOR)) {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_imm(rc));
            }
        } else if is_comm && isel_vreg_const(ctx, lir, interner, lhs_v, mut_view(lc)) && isel_fits_i32(lc) {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, rhs_v);
            if !(lc == 0i64 && (opc == X64_MI_ADD || opc == X64_MI_OR || opc == X64_MI_XOR)) {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_imm(lc));
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    }
}

fn isel_opt_lower_mul_shift_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) {
    let slot_offset = ctx.slot_offset;
    let dest_ty = isel_vreg_ty(lir, dest_v);
    if kind == LIR_INST_MUL {
        let mut cval: i64 = 0i64;
        let mut x_v: u32 = lhs_v;
        let mut has_const = false;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(cval)) {
            x_v = lhs_v;
            has_const = true;
        } else if isel_vreg_const(ctx, lir, interner, lhs_v, mut_view(cval)) {
            x_v = rhs_v;
            has_const = true;
        }

        if has_const {
            if cval == 0i64 {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
            } else if cval == 1i64 {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, x_v);
            } else if cval == -1i64 {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, x_v);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            } else if cval == 3i64 || cval == 5i64 || cval == 9i64 {
                let sc: u8 = (cval - 1i64) as u8;
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, x_v);
                let mem = x64_op_mem(REG_RAX, REG_RAX, sc, 0, false);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), mem);
            } else if cval > 0i64 && isel_is_pow2_u64(cval as u64) {
                let sh = isel_ctz_u64(cval as u64);
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, x_v);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RAX), x64_op_imm(sh as i64));
            } else {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, x_v);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(cval));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    } else {
        let opc: u32 = if kind == LIR_INST_SHL {
            X64_MI_SHL
        } else if kind == LIR_INST_SHR {
            X64_MI_SHR
        } else {
            X64_MI_SAR
        };
        let mut sc: i64 = 0i64;
        if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(sc)) {
            let cnt = sc & 63i64;
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            if cnt != 0i64 {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_imm(cnt));
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), opc, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    }
}

fn isel_opt_lower_udiv_urem_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) -> u32 {
    let slot_offset = ctx.slot_offset;
    let dest_ty = isel_vreg_ty(lir, dest_v);
    let mut dc: i64 = 0i64;
    if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(dc)) && (dc as u64) > 0u64 {
        let d_u = dc as u64;
        if d_u == 1u64 {
            if kind == LIR_INST_UDIV {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            } else {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
            }
        } else if isel_is_pow2_u64(d_u) {
            let sh = isel_ctz_u64(d_u);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            if kind == LIR_INST_UDIV {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_RAX), x64_op_imm(sh as i64));
            } else {
                let mask: i64 = (d_u - 1u64) as i64;
                if isel_fits_i32(mask) {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(mask));
                } else {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(mask));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
                }
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            isel_emit_umagic_div(mut_view(*mi), mut_view(*mbb), d_u);
            if kind == LIR_INST_UREM {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(d_u as i64));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            }
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        return dest_v;
    }
    unsafe {
        isel_emit_udiv_urem(mut_view(*mi), mut_view(*mbb), kind, slot_offset, dest_v, lhs_v, rhs_v);
    }
    LIR_VREG_NONE
}

fn isel_opt_lower_sdiv_srem_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    kind: u8,
    dest_v: u32,
    lhs_v: u32,
    rhs_v: u32
) -> u32 {
    let slot_offset = ctx.slot_offset;
    let dest_ty = isel_vreg_ty(lir, dest_v);
    let mut dc: i64 = 0i64;
    if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(dc)) && dc != 0i64 && dc != -1i64 && dc != (-9223372036854775807i64 - 1i64) {
        let ad_u: u64 = if dc < 0i64 { (0i64 - dc) as u64 } else { dc as u64 };
        if dc == 1i64 {
            if kind == LIR_INST_DIV {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            } else {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
            }
        } else if isel_is_pow2_u64(ad_u) {
            let k = isel_ctz_u64(ad_u);
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(REG_RCX), x64_op_imm(63i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_RCX), x64_op_imm((64u32 - k) as i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ADD, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(REG_RAX), x64_op_imm(k as i64));
            if kind == LIR_INST_DIV {
                if dc < 0i64 {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
                }
            } else {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RAX), x64_op_imm(k as i64));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_reg(REG_RAX));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(REG_R10), x64_op_imm(63i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, x64_op_reg(REG_RAX), x64_op_reg(REG_R10));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_R10));
            isel_emit_umagic_div(mut_view(*mi), mut_view(*mbb), ad_u);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, x64_op_reg(REG_RAX), x64_op_reg(REG_R10));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_R10));
            if dc < 0i64 {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            }
            if kind == LIR_INST_REM {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(dc));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
            }
        }
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RAX);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        return dest_v;
    }
    isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
    isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, rhs_v);
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_reg(REG_RAX));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(REG_RDX), x64_op_imm(63i64));
    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_IDIV, x64_op_reg(REG_RCX), x64_op_none());
    if kind == LIR_INST_DIV {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    } else {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RDX));
    }
    LIR_VREG_NONE
}

fn isel_opt_lower_abi_call_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    inst: *mut LirInst
) {
    let slot_offset = ctx.slot_offset;
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    if kind == LIR_INST_ABI_ARG {
        let loc_kind = unsafe { (*inst).loc_kind };
        let loc_ro = unsafe { (*inst).loc_reg_or_offset };
        if dest_v != LIR_VREG_NONE {
            if loc_kind == ABI_LOC_REG {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(loc_ro as i32));
            } else if loc_kind == ABI_LOC_STACK {
                let disp = (16u32 + loc_ro) as i32;
                let mem = x64_op_mem(REG_RBP, REG_NONE, 1u8, disp, false);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), mem);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
            } else if loc_kind == ABI_LOC_INDIRECT {
                let d_ty = isel_vreg_ty(lir, dest_v);
                let size = type_size(d_ty, interner);
                if loc_ro < 16u32 {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_reg(loc_ro as i32));
                } else {
                    let disp = (16u32 + loc_ro) as i32;
                    let mem = x64_op_mem(REG_RBP, REG_NONE, 1u8, disp, false);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), mem);
                }
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), mem);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                    off = off + chunk;
                }
            }
        } else {
            let val_v = unsafe { (*inst).val.v };
            if loc_kind == ABI_LOC_REG {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), loc_ro as i32, val_v);
            } else if loc_kind == ABI_LOC_STACK {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, val_v);
                let mem = x64_op_mem(REG_RSP, REG_NONE, 1u8, loc_ro as i32, false);
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, mem, x64_op_reg(REG_RAX));
            } else if loc_kind == ABI_LOC_INDIRECT {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + val_v, 0));
                if loc_ro < 16u32 {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(loc_ro as i32), x64_op_reg(REG_RAX));
                } else {
                    let mem = x64_op_mem(REG_RSP, REG_NONE, 1u8, loc_ro as i32, false);
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, mem, x64_op_reg(REG_RAX));
                }
            }
        }
    } else if kind == LIR_INST_CALL {
        let mut call_ret_in_mem = false;
        let callee_ty_id = unsafe { (*inst).callee_ty };
        let c_ty = type_get(interner, callee_ty_id);
        if (c_ty as usize) != 0 {
            let mut r_ty_id = unsafe { (*c_ty).ret_type };
            let c_kind = unsafe { (*c_ty).kind };
            if r_ty_id.v == 0u32 && c_kind == TY_CLOSURE {
                let fn_ty_id = unsafe { (*c_ty).fn_type };
                if fn_ty_id.v != 0u32 {
                    let f_ty = type_get(interner, fn_ty_id);
                    if (f_ty as usize) != 0 {
                        r_ty_id = unsafe { (*f_ty).ret_type };
                    }
                }
            }
            if r_ty_id.v != 0u32 {
                let r_sz = type_size(r_ty_id, interner);
                call_ret_in_mem = isel_type_is_ret_in_mem(r_sz);
            }
        }
        let dst_addr_v = unsafe { (*inst).dst_addr.v };
        if call_ret_in_mem && dst_addr_v != LIR_VREG_NONE {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + dst_addr_v, 0));
        }
        let sym_name = unsafe { (*inst).sym_name };
        let sym_len = unsafe { (*inst).sym_len };
        let callee_v = unsafe { (*inst).callee_vreg.v };
        if (sym_name as usize) != 0 {
            let call_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CALL, x64_op_none(), x64_op_none());
            unsafe {
                (*call_mi).msg = sym_name;
                (*call_mi).msg_len = sym_len;
            }
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_R10, callee_v);
            let call_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CALL, x64_op_reg(REG_R10), x64_op_none());
            unsafe {
                (*call_mi).op_count = 1u8;
            }
        }
    } else if kind == LIR_INST_ABI_RESULT {
        let loc_kind = unsafe { (*inst).loc_kind };
        let loc_ro = unsafe { (*inst).loc_reg_or_offset };
        if loc_kind == ABI_LOC_REG {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(loc_ro as i32));
        } else if loc_kind == ABI_LOC_INDIRECT {
            let d_ty = isel_vreg_ty(lir, dest_v);
            let mut size = type_size(d_ty, interner);
            if size <= 8u32 {
                if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                    size = 8u32;
                }
                let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, x64_op_reg(REG_RCX), mem);
                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
            } else {
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), mem);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                    off = off + chunk;
                }
            }
        }
    }
}

fn isel_opt_lower_load_store_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cur_bb: u32,
    inst: *mut LirInst
) -> u32 {
    let slot_offset = ctx.slot_offset;
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let mut tag_vreg: u32 = LIR_VREG_NONE;

    if kind == LIR_INST_LOAD {
        let ptr_v = unsafe { (*inst).ptr.v };
        let load_ty = unsafe { (*inst).ty };
        let mut size = type_size(TypeId { v: load_ty.v }, interner);
        let is_signed = isel_type_is_signed_int(load_ty, interner);
        let mut direct_slot: u32 = 0u32;
        let is_slot_ld = isel_vreg_is_stack_addr(ctx, ptr_v, mut_view(direct_slot));
        if size <= 8u32 {
            if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                size = 8u32;
            }
            if is_slot_ld {
                tag_vreg = dest_v;
                if size < 8u32 {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
                }
                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, x64_op_reg(REG_RCX), x64_op_frame(direct_slot, 0));
            } else {
                let addr = isel_match_addr(ctx, lir, interner, ptr_v, cur_bb);
                let mem = isel_emit_addr_mem_op(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), addr, REG_RAX, REG_R10);
                if size < 8u32 {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
                }
                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, x64_op_reg(REG_RCX), mem);
            }
            if size < 8u32 {
                let shift = ((8u32 - size) * 8u32) as i64;
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHL, x64_op_reg(REG_RCX), x64_op_imm(shift));
                if is_signed {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SAR, x64_op_reg(REG_RCX), x64_op_imm(shift));
                } else {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SHR, x64_op_reg(REG_RCX), x64_op_imm(shift));
                }
            }
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
        } else {
            if is_slot_ld {
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), x64_op_frame(direct_slot, off as i32));
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                    off = off + chunk;
                }
            } else {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + ptr_v, 0));
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), mem);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(slot_offset + dest_v, off as i32), x64_op_reg(REG_RCX));
                    off = off + chunk;
                }
            }
        }
    } else if kind == LIR_INST_STORE {
        let ptr_v = unsafe { (*inst).ptr.v };
        let val_v = unsafe { (*inst).val.v };
        let val_ty = isel_vreg_ty(lir, val_v);
        let mut size = type_size(val_ty, interner);
        let mut direct_slot: u32 = 0u32;
        let is_slot_st = isel_vreg_is_stack_addr(ctx, ptr_v, mut_view(direct_slot));
        if size <= 8u32 {
            if size != 1u32 && size != 2u32 && size != 4u32 && size != 8u32 {
                size = 8u32;
            }
            if is_slot_st {
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, val_v);
                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, x64_op_frame(direct_slot, 0), x64_op_reg(REG_RCX));
                if (direct_slot as usize) < ctx.slot_count && (unsafe { *isel_u8_at(ctx.slot_single_bb, direct_slot as usize) }) != 0u8 {
                    tag_vreg = unsafe { *isel_u32_at(ctx.slot_single_ld_v, direct_slot as usize) };
                }
            } else {
                let addr = isel_match_addr(ctx, lir, interner, ptr_v, cur_bb);
                let mem = isel_emit_addr_mem_op(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), addr, REG_RAX, REG_R10);
                isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, val_v);
                x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, size as u8, mem, x64_op_reg(REG_RCX));
            }
        } else {
            if is_slot_st {
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + val_v, off as i32));
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_frame(direct_slot, off as i32), x64_op_reg(REG_RCX));
                    off = off + chunk;
                }
            } else {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + ptr_v, 0));
                let mut off: u32 = 0u32;
                while off < size {
                    let chunk = isel_chunk_size(size - off);
                    let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, off as i32, false);
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, x64_op_reg(REG_RCX), x64_op_frame(slot_offset + val_v, off as i32));
                    x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, chunk as u8, mem, x64_op_reg(REG_RCX));
                    off = off + chunk;
                }
            }
        }
    }
    tag_vreg
}

fn isel_opt_lower_inst(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cur_bb: u32,
    inst_idx: usize,
    inst: *mut LirInst
) {
    let slot_offset = ctx.slot_offset;
    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let lhs_v = unsafe { (*inst).lhs.v };
    let rhs_v = unsafe { (*inst).rhs.v };
    let operand_v = unsafe { (*inst).operand.v };

    let first_before = mbb.first_inst;
    let last_before = mbb.last_inst;
    let mut tag_vreg: u32 = LIR_VREG_NONE;

    if kind == LIR_INST_CONST {
        let cval = isel_const_inst_val(lir, interner, inst as *const LirInst, dest_v);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(cval));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        tag_vreg = dest_v;
    } else if kind == LIR_INST_CONST_STR {
        let s_bytes = unsafe { (*inst).str_bytes };
        let s_len = unsafe { (*inst).str_len };
        let sym_id = x64_mi_add_string(mut_view(*mi), s_bytes, s_len);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_sym(sym_id));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(s_len as i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 8), x64_op_reg(REG_RAX));
    } else if kind == LIR_INST_FN_ADDR || kind == LIR_INST_TLS_ADDR {
        isel_emit_sym_addr(mut_view(*mi), mut_view(*mbb), slot_offset + dest_v, inst as *const LirInst);
    } else if kind == LIR_INST_ADD || kind == LIR_INST_OFFSET || kind == LIR_INST_SUB ||
              kind == LIR_INST_BIT_AND || kind == LIR_INST_BIT_OR || kind == LIR_INST_BIT_XOR {
        tag_vreg = dest_v;
        isel_opt_lower_alu_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), cur_bb, kind, dest_v, lhs_v, rhs_v);
    } else if kind == LIR_INST_MUL || kind == LIR_INST_SHL || kind == LIR_INST_SHR || kind == LIR_INST_SAR {
        tag_vreg = dest_v;
        isel_opt_lower_mul_shift_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), kind, dest_v, lhs_v, rhs_v);
    } else if kind == LIR_INST_UDIV || kind == LIR_INST_UREM {
        tag_vreg = isel_opt_lower_udiv_urem_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), kind, dest_v, lhs_v, rhs_v);
    } else if kind == LIR_INST_DIV || kind == LIR_INST_REM {
        tag_vreg = isel_opt_lower_sdiv_srem_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), kind, dest_v, lhs_v, rhs_v);
    } else if kind >= LIR_INST_ICMP_EQ && kind <= LIR_INST_ICMP_UGE {
        let cc = isel_icmp_cc(kind);
        tag_vreg = dest_v;
        isel_emit_icmp_flags(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), lhs_v, rhs_v);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(cc as i64), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    } else if kind == LIR_INST_NEG {
        let dest_ty = isel_vreg_ty(lir, dest_v);
        tag_vreg = dest_v;
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, operand_v);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RCX), x64_op_reg(REG_RAX));
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_RCX);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
    } else if kind == LIR_INST_NOT {
        tag_vreg = dest_v;
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, operand_v);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_XOR, x64_op_reg(REG_RAX), x64_op_imm(1i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    } else if kind == LIR_INST_BITNOT {
        let dest_ty = isel_vreg_ty(lir, dest_v);
        tag_vreg = dest_v;
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, operand_v);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R10), x64_op_imm(-1i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_R10), x64_op_reg(REG_RCX));
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), dest_ty, interner, REG_R10);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_R10));
    } else if kind == LIR_INST_UADD_OVERFLOW || kind == LIR_INST_USUB_OVERFLOW || kind == LIR_INST_UMUL_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        unsafe {
            isel_emit_uoverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
        }
    } else if kind == LIR_INST_SADD_OVERFLOW || kind == LIR_INST_SSUB_OVERFLOW || kind == LIR_INST_SMUL_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        unsafe {
            isel_emit_soverflow(mut_view(*mi), mut_view(*mbb), kind, bw, slot_offset, dest_v, lhs_v, rhs_v);
        }
    } else if kind == LIR_INST_UDIV_OVERFLOW || kind == LIR_INST_UREM_OVERFLOW {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    } else if kind == LIR_INST_SDIV_OVERFLOW || kind == LIR_INST_SREM_OVERFLOW {
        let bw = unsafe { (*inst).bit_width };
        let mut int_min: i64 = (0x8000000000000000u64) as i64;
        if bw == 8u32 {
            int_min = -128i64;
        } else if bw == 16u32 {
            int_min = -32768i64;
        } else if bw == 32u32 {
            int_min = -2147483648i64;
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(slot_offset + lhs_v, 0));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_frame(slot_offset + rhs_v, 0));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RDX), x64_op_imm(-1i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_E as i64), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RCX), x64_op_imm(1i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RDX), x64_op_imm(int_min));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_E as i64), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
    } else if kind == LIR_INST_ABI_ARG || kind == LIR_INST_CALL || kind == LIR_INST_ABI_RESULT {
        isel_opt_lower_abi_call_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), inst);
    } else if kind == LIR_INST_STACK_ADDR {
        let slot_v = unsafe { (*inst).slot.v };
        if slot_v == 0u32 && ctx.ret_in_mem {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_frame(slot_v, 0));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
            tag_vreg = dest_v;
        }
    } else if kind == LIR_INST_LOAD || kind == LIR_INST_STORE {
        tag_vreg = isel_opt_lower_load_store_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), cur_bb, inst);
    } else if kind == LIR_INST_ATOMIC_LOAD {
        let ptr_v = unsafe { (*inst).ptr.v };
        let elem_ty_v = unsafe { (*inst).ty.v };
        let sz = isel_atomic_sz(inst as *const LirInst, interner);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, ptr_v);
        let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RCX), x64_op_imm(0i64));
        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, sz, x64_op_reg(REG_RCX), mem);
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RCX);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
    } else if kind == LIR_INST_ATOMIC_STORE {
        let ptr_v = unsafe { (*inst).ptr.v };
        let val_v = unsafe { (*inst).val.v };
        let ord = unsafe { (*inst).ordering };
        let sz = isel_atomic_sz(inst as *const LirInst, interner);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, ptr_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, val_v);
        let mem = x64_op_mem(REG_RAX, REG_NONE, 1u8, 0, false);
        if ord == LIR_ORDER_SEQ_CST {
            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_XCHG, sz, mem, x64_op_reg(REG_RCX));
        } else {
            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, sz, mem, x64_op_reg(REG_RCX));
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
    } else if kind == LIR_INST_ATOMIC_RMW {
        let ptr_v = unsafe { (*inst).ptr.v };
        let val_v = unsafe { (*inst).val.v };
        let elem_ty_v = unsafe { (*inst).ty.v };
        let rmw_op = unsafe { (*inst).rmw_op };
        let sz = isel_atomic_sz(inst as *const LirInst, interner);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, ptr_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RDX, val_v);
        let mem = x64_op_mem(REG_RCX, REG_NONE, 1u8, 0, false);
        if rmw_op == LIR_ATOMIC_RMW_XCHG {
            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_XCHG, sz, mem, x64_op_reg(REG_RDX));
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RDX);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RDX));
        } else if rmw_op == LIR_ATOMIC_RMW_ADD {
            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_XADD, sz, mem, x64_op_reg(REG_RDX));
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RDX);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RDX));
        } else if rmw_op == LIR_ATOMIC_RMW_SUB {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SUB, x64_op_reg(REG_RAX), x64_op_reg(REG_RDX));
            x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_XADD, sz, mem, x64_op_reg(REG_RAX));
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        } else {
            let loop_mi = x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_ATOMIC_RMW_LOOP, sz, mem, x64_op_reg(REG_RDX));
            unsafe { (*loop_mi).msg_len = rmw_op as usize; }
            isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
    } else if kind == LIR_INST_ATOMIC_CAS {
        let ptr_v = unsafe { (*inst).ptr.v };
        let ok_v = unsafe { (*inst).cas_ok.v };
        let elem_ty_v = unsafe { (*inst).ty.v };
        let sz = isel_atomic_sz(inst as *const LirInst, interner);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, ptr_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, lhs_v);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RDX, rhs_v);
        let mem = x64_op_mem(REG_RCX, REG_NONE, 1u8, 0, false);
        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_LOCK_CMPXCHG, sz, mem, x64_op_reg(REG_RDX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(CC_E as i64), x64_op_reg(REG_R8));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_R8), x64_op_imm(1i64));
        isel_emit_trunc(mut_view(*mi), mut_view(*mbb), TypeId { v: elem_ty_v }, interner, REG_RAX);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + dest_v, 0), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(slot_offset + ok_v, 0), x64_op_reg(REG_R8));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
    } else if kind == LIR_INST_FENCE {
        let is_comp = unsafe { (*inst).is_compiler_only };
        let ord = unsafe { (*inst).ordering };
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_COMPILER_BARRIER, x64_op_none(), x64_op_none());
        if !is_comp && ord == LIR_ORDER_SEQ_CST {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MFENCE, x64_op_none(), x64_op_none());
        }
    } else if kind == LIR_INST_PAUSE {
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_PAUSE, x64_op_none(), x64_op_none());
    }

    let _ = inst_idx;
    if tag_vreg != LIR_VREG_NONE {
        isel_tag_range(first_before, last_before, view(*mbb), tag_vreg);
    }
}

struct DiamondArm {
    pub slot: u32,
    pub val: u32,
    pub cost: u32,
}

fn isel_check_diamond_arm(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    arm_bb: usize,
    out_arm: *mut DiamondArm
) -> bool {
    let lbb = unsafe { lir_bb_at(lir.bbs, arm_bb) };
    let cnt = unsafe { (*lbb).inst_count };
    if cnt == 0 {
        return false;
    }
    let insts = unsafe { (*lbb).insts };
    let last_inst = unsafe { lir_inst_at(insts, cnt - 1) };
    if (unsafe { (*last_inst).kind }) != LIR_INST_STORE {
        return false;
    }
    let st_ptr_v = unsafe { (*last_inst).ptr.v };
    let st_val_v = unsafe { (*last_inst).val.v };
    let mut dst_slot: u32 = 0u32;
    if !isel_vreg_is_stack_addr(ctx, st_ptr_v, mut_view(dst_slot)) {
        return false;
    }
    let val_ty_v = isel_vreg_ty(lir, st_val_v).v;
    let val_rc = x64_reg_class_for_type(TypeId { v: val_ty_v }, interner);
    if val_rc != REG_CLASS_GPR {
        return false;
    }
    let val_sz = type_size(TypeId { v: val_ty_v }, interner);
    if val_sz == 0u32 || val_sz > 8u32 || (val_sz != 1u32 && val_sz != 2u32 && val_sz != 4u32 && val_sz != 8u32) {
        return false;
    }

    let mut cost: u32 = 0u32;
    let mut i: usize = 0;
    while i + 1 < cnt {
        let inst = unsafe { lir_inst_at(insts, i) };
        let k = unsafe { (*inst).kind };
        let dv = unsafe { (*inst).dest.v };
        if dv != LIR_VREG_NONE && (dv as usize) < ctx.vreg_count {
            if (unsafe { *isel_u8_at(ctx.cross_bb, dv as usize) }) != 0u8 {
                return false;
            }
            let dty_v = isel_vreg_ty(lir, dv).v;
            let dty_sz = type_size(TypeId { v: dty_v }, interner);
            let dty_rc = x64_reg_class_for_type(TypeId { v: dty_v }, interner);
            if dty_sz > 8u32 || dty_rc != REG_CLASS_GPR {
                return false;
            }
        }
        if k == LIR_INST_CONST || k == LIR_INST_STACK_ADDR {
            // zero cost
        } else if k == LIR_INST_LOAD {
            let pv = unsafe { (*inst).ptr.v };
            let mut s_ld: u32 = 0u32;
            if !isel_vreg_is_stack_addr(ctx, pv, mut_view(s_ld)) {
                return false;
            }
            let ld_ty_v = unsafe { (*inst).ty.v };
            let ld_sz = type_size(TypeId { v: ld_ty_v }, interner);
            let ld_rc = x64_reg_class_for_type(TypeId { v: ld_ty_v }, interner);
            if ld_sz > 8u32 || ld_rc != REG_CLASS_GPR {
                return false;
            }
        } else if k == LIR_INST_ADD || k == LIR_INST_OFFSET || k == LIR_INST_SUB ||
                  k == LIR_INST_MUL || k == LIR_INST_BIT_AND || k == LIR_INST_BIT_OR ||
                  k == LIR_INST_BIT_XOR || k == LIR_INST_SHL || k == LIR_INST_SHR ||
                  k == LIR_INST_SAR || k == LIR_INST_NEG || k == LIR_INST_NOT ||
                  k == LIR_INST_BITNOT || (k >= LIR_INST_ICMP_EQ && k <= LIR_INST_ICMP_UGE) {
            cost = cost + 1u32;
        } else {
            return false;
        }
        i = i + 1;
    }
    if cost > 4u32 {
        return false;
    }
    unsafe {
        (*out_arm).slot = dst_slot;
        (*out_arm).val = st_val_v;
        (*out_arm).cost = cost;
    }
    true
}

fn isel_emit_cond_flags_for_branch(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cur_bb: u32,
    cond_v: u32
) -> u8 {
    let mut rc = isel_resolve_vreg(ctx, cond_v);
    let mut inv = false;
    let mut steps: u32 = 0u32;
    while steps < 4u32 && (rc as usize) < ctx.vreg_count &&
          (unsafe { *isel_u32_at(ctx.def_cnt, rc as usize) }) == 1u32 &&
          (unsafe { *isel_u32_at(ctx.def_bb, rc as usize) }) == cur_bb {
        let inst = unsafe { *isel_inst_ptr_at(ctx.def_inst, rc as usize) };
        if (inst as usize) == 0 {
            break;
        }
        let k = unsafe { (*inst).kind };
        if k == LIR_INST_NOT {
            let op_v = isel_resolve_vreg(ctx, unsafe { (*inst).operand.v });
            if isel_vreg_is_bool(lir, interner, rc) && isel_vreg_is_bool(lir, interner, op_v) {
                inv = !inv;
                rc = op_v;
                steps = steps + 1u32;
                continue;
            }
            break;
        }
        if k == LIR_INST_BIT_XOR {
            if isel_vreg_is_bool(lir, interner, rc) {
                let lhs_v = unsafe { (*inst).lhs.v };
                let rhs_v = unsafe { (*inst).rhs.v };
                let mut xc: i64 = 0i64;
                if isel_vreg_const(ctx, lir, interner, rhs_v, mut_view(xc)) && xc == 1i64 {
                    let inner_v = isel_resolve_vreg(ctx, lhs_v);
                    if isel_vreg_is_bool(lir, interner, inner_v) {
                        inv = !inv;
                        rc = inner_v;
                        steps = steps + 1u32;
                        continue;
                    }
                } else if isel_vreg_const(ctx, lir, interner, lhs_v, mut_view(xc)) && xc == 1i64 {
                    let inner_v = isel_resolve_vreg(ctx, rhs_v);
                    if isel_vreg_is_bool(lir, interner, inner_v) {
                        inv = !inv;
                        rc = inner_v;
                        steps = steps + 1u32;
                        continue;
                    }
                }
            }
            break;
        }
        if k >= LIR_INST_ICMP_EQ && k <= LIR_INST_ICMP_UGE {
            let lv = unsafe { (*inst).lhs.v };
            let rv = unsafe { (*inst).rhs.v };
            isel_emit_icmp_flags(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), lv, rv);
            let mut cc = isel_icmp_cc(k);
            if inv {
                cc = x64_cc_invert(cc);
            }
            return cc;
        }
        break;
    }

    isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, rc);
    let t_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_TEST, x64_op_reg(REG_RAX), x64_op_reg(REG_RAX));
    unsafe { (*t_mi).msg_len = 1; }
    let mut cc = CC_NE;
    if inv {
        cc = x64_cc_invert(cc);
    }
    cc
}

fn isel_try_if_convert_diamond(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    b: usize
) -> bool {
    let lbb = unsafe { lir_bb_at(lir.bbs, b) };
    let tk = unsafe { (*lbb).term.kind };
    let mut cond_v: u32 = LIR_VREG_NONE;
    let mut then_bb: usize = 0;
    let mut else_bb: usize = 0;
    let invert_cond = false;

    if tk == LIR_TERM_JCC {
        cond_v = unsafe { (*lbb).term.cond.v };
        if !isel_vreg_is_scalar_gpr(lir, interner, cond_v) {
            return false;
        }
        then_bb = unsafe { (*lbb).term.then_target.v as usize };
        else_bb = unsafe { (*lbb).term.else_target.v as usize };
    } else if tk == LIR_TERM_SWITCH {
        if (unsafe { (*lbb).term.count }) != 1 {
            return false;
        }
        cond_v = unsafe { (*lbb).term.cond.v };
        if !isel_vreg_is_scalar_gpr(lir, interner, cond_v) {
            return false;
        }
        let tp = unsafe { lir_switch_target_at((*lbb).term.targets, 0) };
        let t_val = unsafe { (*tp).val };
        let t_bb = unsafe { (*tp).target.v as usize };
        let oth_bb = unsafe { (*lbb).term.otherwise.v as usize };
        if t_val == 0u64 {
            then_bb = oth_bb;
            else_bb = t_bb;
        } else if t_val == 1u64 {
            if !isel_vreg_is_bool(lir, interner, cond_v) {
                return false;
            }
            then_bb = t_bb;
            else_bb = oth_bb;
        } else {
            return false;
        }
    } else {
        return false;
    }

    if then_bb >= ctx.bb_count || else_bb >= ctx.bb_count || then_bb == else_bb || then_bb == b || else_bb == b {
        return false;
    }
    if (unsafe { *isel_u32_at(ctx.pred_cnt, then_bb) }) != 1u32 ||
       (unsafe { *isel_u32_at(ctx.pred_cnt, else_bb) }) != 1u32 {
        return false;
    }
    if (unsafe { *isel_u8_at(ctx.bb_skip, then_bb) }) != 0u8 ||
       (unsafe { *isel_u8_at(ctx.bb_skip, else_bb) }) != 0u8 {
        return false;
    }

    let lbb_then = unsafe { lir_bb_at(lir.bbs, then_bb) };
    let lbb_else = unsafe { lir_bb_at(lir.bbs, else_bb) };
    if (unsafe { (*lbb_then).term.kind }) != LIR_TERM_JMP ||
       (unsafe { (*lbb_else).term.kind }) != LIR_TERM_JMP {
        return false;
    }
    let join_bb = unsafe { (*lbb_then).term.jmp_target.v as usize };
    if (unsafe { (*lbb_else).term.jmp_target.v as usize }) != join_bb {
        return false;
    }
    if join_bb >= ctx.bb_count || join_bb == b || join_bb == then_bb || join_bb == else_bb {
        return false;
    }

    let mut arm_then = DiamondArm { slot: 0u32, val: 0u32, cost: 0u32 };
    let mut arm_else = DiamondArm { slot: 0u32, val: 0u32, cost: 0u32 };
    let p_then: *mut DiamondArm = unsafe { address_of_mut(arm_then) };
    let p_else: *mut DiamondArm = unsafe { address_of_mut(arm_else) };

    if !isel_check_diamond_arm(ctx, lir, interner, then_bb, p_then) {
        return false;
    }
    if !isel_check_diamond_arm(ctx, lir, interner, else_bb, p_else) {
        return false;
    }
    let slot_then = arm_then.slot;
    let val_then = arm_then.val;
    let cost_then = arm_then.cost;
    let slot_else = arm_else.slot;
    let val_else = arm_else.val;
    let cost_else = arm_else.cost;
    if slot_then != slot_else || (cost_then + cost_else + 1u32) > 6u32 {
        return false;
    }

    // Lower non-store instructions of `then_bb` and `else_bb` into `mbb`
    let then_cnt = unsafe { (*lbb_then).inst_count };
    let mut ti: usize = 0;
    while ti + 1 < then_cnt {
        let tinst = unsafe { lir_inst_at((*lbb_then).insts, ti) };
        isel_opt_lower_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), then_bb as u32, ti, tinst);
        ti = ti + 1;
    }
    let else_cnt = unsafe { (*lbb_else).inst_count };
    let mut ei: usize = 0;
    while ei + 1 < else_cnt {
        let einst = unsafe { lir_inst_at((*lbb_else).insts, ei) };
        isel_opt_lower_inst(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), else_bb as u32, ei, einst);
        ei = ei + 1;
    }

    let mut cc: u8 = isel_emit_cond_flags_for_branch(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), b as u32, cond_v);
    if invert_cond {
        cc = x64_cc_invert(cc);
    }

    let val_ty = isel_vreg_ty(lir, val_then);
    let mut dst_sz = type_size(val_ty, interner) as u8;
    if dst_sz != 1u8 && dst_sz != 2u8 && dst_sz != 4u8 && dst_sz != 8u8 {
        dst_sz = 8u8;
    }

    let mut c_then: i64 = 0i64;
    let mut c_else: i64 = 0i64;
    let is_c_then = isel_vreg_const(ctx, lir, interner, val_then, mut_view(c_then));
    let is_c_else = isel_vreg_const(ctx, lir, interner, val_else, mut_view(c_else));

    if is_c_then && is_c_else && ((c_then == 1i64 && c_else == 0i64) || (c_then == 0i64 && c_else == 1i64)) {
        let set_cc = if c_then == 1i64 { cc } else { x64_cc_invert(cc) };
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_SETCC, x64_op_imm(set_cc as i64), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_AND, x64_op_reg(REG_RAX), x64_op_imm(1i64));
        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, dst_sz, x64_op_frame(slot_then, 0), x64_op_reg(REG_RAX));
    } else {
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, val_else);
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RCX, val_then);
        x64_mi_emit_cmovcc(mut_view(*mi), mut_view(*mbb), cc, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        x64_mi_emit_sz(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, dst_sz, x64_op_frame(slot_then, 0), x64_op_reg(REG_RAX));
    }

    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(join_bb as i64), x64_op_none());
    unsafe {
        *isel_u8_at(ctx.bb_skip, then_bb) = 1u8;
        *isel_u8_at(ctx.bb_skip, else_bb) = 1u8;
    }
    true
}

fn isel_note_use(ctx: view<IselOptCtx>, v: u32, use_bb: u32) {
    if v == LIR_VREG_NONE || (v as usize) >= ctx.vreg_count {
        return;
    }
    unsafe {
        let up = isel_u32_at(ctx.use_cnt, v as usize);
        *up = *up + 1u32;
        let db = *isel_u32_at(ctx.def_bb, v as usize);
        if db != 0xFFFFFFFFu32 && db != use_bb {
            *isel_u8_at(ctx.cross_bb, v as usize) = 1u8;
        }
    }
}

fn isel_note_pred(ctx: view<IselOptCtx>, target_bb: u32) {
    if (target_bb as usize) < ctx.bb_count {
        unsafe {
            let pp = isel_u32_at(ctx.pred_cnt, target_bb as usize);
            *pp = *pp + 1u32;
        }
    }
}

fn isel_sweep_dead_vregs(arena: mut_view<Arena>, ctx: view<IselOptCtx>, mi: mut_view<X64MIBody>) {
    if ctx.vreg_count == 0 {
        return;
    }
    let cnt_bytes = lir_mul_usize(ctx.vreg_count, size_of<u32>());
    let mi_uses = arena_alloc_raw(mut_view(*arena), cnt_bytes, align_of<u32>()) as *mut u32;
    let slot_offset = ctx.slot_offset;

    let mut pass: u32 = 0u32;
    while pass < 8u32 {
        let mut v: usize = 0;
        while v < ctx.vreg_count {
            unsafe { *isel_u32_at(mi_uses, v) = 0u32; }
            v = v + 1;
        }

        let mut b: usize = 0;
        while b < mi.bb_count {
            let mbb = unsafe { x64_mi_bb_at(mi.bbs, b) };
            let mut cur = unsafe { (*mbb).first_inst };
            while (cur as usize) != 0 {
                let opc = unsafe { (*cur).opcode };
                let op_cnt = unsafe { (*cur).op_count };
                let orig = unsafe { (*cur).origin_vreg };
                let mut k: u8 = 0u8;
                while k < op_cnt {
                    let is_write_only = k == 0u8 && (opc == X64_MI_MOV || opc == X64_MI_LEA || opc == X64_MI_SETCC || opc == X64_MI_POP);
                    if !is_write_only {
                        let op = unsafe { (*cur).ops[k as usize] };
                        if op.kind == X64_OP_FRAME && op.frame.slot_id >= slot_offset {
                            let uv = op.frame.slot_id - slot_offset;
                            if (uv as usize) < ctx.vreg_count && uv != orig {
                                unsafe {
                                    let up = isel_u32_at(mi_uses, uv as usize);
                                    *up = *up + 1u32;
                                }
                            }
                        }
                    }
                    k = k + 1u8;
                }
                cur = unsafe { (*cur).next };
            }
            b = b + 1;
        }

        let mut removed = false;
        b = 0;
        while b < mi.bb_count {
            let mbb = unsafe { x64_mi_bb_at(mi.bbs, b) };
            let mut prev: *mut X64MI = 0 as *mut X64MI;
            let mut cur = unsafe { (*mbb).first_inst };
            while (cur as usize) != 0 {
                let next_i = unsafe { (*cur).next };
                let orig = unsafe { (*cur).origin_vreg };
                if orig != LIR_VREG_NONE && (orig as usize) < ctx.vreg_count &&
                   (unsafe { *isel_u32_at(mi_uses, orig as usize) }) == 0u32 {
                    unsafe {
                        if (prev as usize) != 0 {
                            (*prev).next = next_i;
                        } else {
                            (*mbb).first_inst = next_i;
                        }
                        if (next_i as usize) == 0 {
                            (*mbb).last_inst = prev;
                        }
                    }
                    removed = true;
                } else {
                    prev = cur;
                }
                cur = next_i;
            }
            b = b + 1;
        }

        if !removed {
            break;
        }
        pass = pass + 1u32;
    }
}

fn isel_opt_pass1_defs_and_uses(ctx: view<IselOptCtx>, lir: view<LirBody>) {
    let bcnt = ctx.bb_count;
    let vcnt = ctx.vreg_count;
    let mut b: usize = 0;
    while b < bcnt {
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let icnt = unsafe { (*lbb).inst_count };
        let insts = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { lir_inst_at(insts, i) };
            let dv = unsafe { (*inst).dest.v };
            if dv != LIR_VREG_NONE && (dv as usize) < vcnt {
                unsafe {
                    *isel_u32_at(ctx.def_bb, dv as usize) = b as u32;
                    *isel_usize_at(ctx.def_idx, dv as usize) = i;
                    let dc = isel_u32_at(ctx.def_cnt, dv as usize);
                    *dc = *dc + 1u32;
                    *isel_inst_ptr_at(ctx.def_inst, dv as usize) = inst;
                }
            }
            if (unsafe { (*inst).kind }) == LIR_INST_ATOMIC_CAS {
                let okv = unsafe { (*inst).cas_ok.v };
                if okv != LIR_VREG_NONE && (okv as usize) < vcnt {
                    unsafe {
                        *isel_u32_at(ctx.def_bb, okv as usize) = b as u32;
                        *isel_usize_at(ctx.def_idx, okv as usize) = i;
                        let dc2 = isel_u32_at(ctx.def_cnt, okv as usize);
                        *dc2 = *dc2 + 1u32;
                        *isel_inst_ptr_at(ctx.def_inst, okv as usize) = inst;
                    }
                }
            }
            i = i + 1;
        }
        b = b + 1;
    }

    b = 0;
    while b < bcnt {
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let icnt = unsafe { (*lbb).inst_count };
        let insts = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { lir_inst_at(insts, i) };
            let k = unsafe { (*inst).kind };
            let dv = unsafe { (*inst).dest.v };
            if (k >= LIR_INST_ADD && k <= LIR_INST_SAR) ||
               (k >= LIR_INST_ICMP_EQ && k <= LIR_INST_ICMP_UGE) ||
               (k >= LIR_INST_SADD_OVERFLOW && k <= LIR_INST_UREM_OVERFLOW) ||
               k == LIR_INST_UDIV || k == LIR_INST_UREM || k == LIR_INST_OFFSET {
                isel_note_use(ctx, unsafe { (*inst).lhs.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).rhs.v }, b as u32);
            } else if k == LIR_INST_NEG || k == LIR_INST_NOT || k == LIR_INST_BITNOT {
                isel_note_use(ctx, unsafe { (*inst).operand.v }, b as u32);
            } else if k == LIR_INST_LOAD {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
            } else if k == LIR_INST_STORE {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).val.v }, b as u32);
                if b == 0 {
                    let pv = unsafe { (*inst).ptr.v };
                    let vv = unsafe { (*inst).val.v };
                    let mut sv: u32 = 0u32;
                    if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) && (vv as usize) < vcnt {
                        let vinst = unsafe { *isel_inst_ptr_at(ctx.def_inst, vv as usize) };
                        if (vinst as usize) != 0 && (unsafe { (*vinst).kind }) == LIR_INST_ABI_ARG {
                            unsafe { *isel_u8_at(ctx.slot_is_param, sv as usize) = 1u8; }
                        }
                    }
                }
            } else if k == LIR_INST_ABI_ARG && dv == LIR_VREG_NONE {
                isel_note_use(ctx, unsafe { (*inst).val.v }, b as u32);
            } else if k == LIR_INST_CALL {
                if (unsafe { (*inst).dst_addr.v }) != LIR_VREG_NONE {
                    isel_note_use(ctx, unsafe { (*inst).dst_addr.v }, b as u32);
                }
                if (unsafe { (*inst).callee_vreg.v }) != LIR_VREG_NONE {
                    isel_note_use(ctx, unsafe { (*inst).callee_vreg.v }, b as u32);
                }
            } else if k == LIR_INST_ATOMIC_LOAD {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
            } else if k == LIR_INST_ATOMIC_STORE || k == LIR_INST_ATOMIC_RMW {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).val.v }, b as u32);
            } else if k == LIR_INST_ATOMIC_CAS {
                isel_note_use(ctx, unsafe { (*inst).ptr.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).lhs.v }, b as u32);
                isel_note_use(ctx, unsafe { (*inst).rhs.v }, b as u32);
            }
            i = i + 1;
        }

        let tk = unsafe { (*lbb).term.kind };
        if tk == LIR_TERM_JMP {
            isel_note_pred(ctx, unsafe { (*lbb).term.jmp_target.v });
        } else if tk == LIR_TERM_JCC {
            isel_note_use(ctx, unsafe { (*lbb).term.cond.v }, b as u32);
            isel_note_pred(ctx, unsafe { (*lbb).term.then_target.v });
            isel_note_pred(ctx, unsafe { (*lbb).term.else_target.v });
        } else if tk == LIR_TERM_SWITCH {
            isel_note_use(ctx, unsafe { (*lbb).term.cond.v }, b as u32);
            let sc = unsafe { (*lbb).term.count };
            let mut k: usize = 0;
            while k < sc {
                let tp = unsafe { lir_switch_target_at((*lbb).term.targets, k) };
                isel_note_pred(ctx, unsafe { (*tp).target.v });
                k = k + 1;
            }
            isel_note_pred(ctx, unsafe { (*lbb).term.otherwise.v });
        } else if tk == LIR_TERM_ASSERT {
            isel_note_use(ctx, unsafe { (*lbb).term.cond.v }, b as u32);
            isel_note_pred(ctx, unsafe { (*lbb).term.assert_target.v });
        }
        b = b + 1;
    }
}

fn isel_opt_pass2_slots(ctx: view<IselOptCtx>, lir: view<LirBody>, interner: view<TypeInterner>) {
    let bcnt = ctx.bb_count;
    let vcnt = ctx.vreg_count;
    let scnt = ctx.slot_count;
    let mut b: usize = 0;
    while b < bcnt {
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let icnt = unsafe { (*lbb).inst_count };
        let insts = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { lir_inst_at(insts, i) };
            let k = unsafe { (*inst).kind };
            let dv = unsafe { (*inst).dest.v };
            if k == LIR_INST_STACK_ADDR {
                let sv = unsafe { (*inst).slot.v as usize };
                if sv < scnt {
                    if (dv as usize) >= vcnt ||
                       (unsafe { *isel_u32_at(ctx.use_cnt, dv as usize) }) != 1u32 ||
                       (unsafe { *isel_u8_at(ctx.cross_bb, dv as usize) }) != 0u8 {
                        unsafe { *isel_u8_at(ctx.slot_escaped, sv) = 1u8; }
                    }
                }
            } else if k == LIR_INST_LOAD {
                let pv = unsafe { (*inst).ptr.v };
                let mut sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) && (sv as usize) < scnt {
                    let slot_ty = unsafe { (*lir_slot_at(lir.slots, sv as usize)).ty };
                    let ld_ty = unsafe { (*inst).ty };
                    let sz = type_size(TypeId { v: ld_ty.v }, interner);
                    if ld_ty.v == slot_ty.v && (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) {
                        unsafe {
                            let lp = isel_u32_at(ctx.slot_load_cnt, sv as usize);
                            *lp = *lp + 1u32;
                        }
                    } else {
                        unsafe { *isel_u8_at(ctx.slot_escaped, sv as usize) = 1u8; }
                    }
                }
            } else if k == LIR_INST_STORE {
                let pv = unsafe { (*inst).ptr.v };
                let vv = unsafe { (*inst).val.v };
                let mut v_sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, vv, mut_view(v_sv)) && (v_sv as usize) < scnt {
                    unsafe { *isel_u8_at(ctx.slot_escaped, v_sv as usize) = 1u8; }
                }
                let mut sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) && (sv as usize) < scnt {
                    let slot_ty = unsafe { (*lir_slot_at(lir.slots, sv as usize)).ty };
                    let val_ty = isel_vreg_ty(lir, vv);
                    let sz = type_size(TypeId { v: val_ty.v }, interner);
                    if val_ty.v == slot_ty.v && (sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32) {
                        unsafe {
                            let sp = isel_u32_at(ctx.slot_store_cnt, sv as usize);
                            *sp = *sp + 1u32;
                        }
                    } else {
                        unsafe { *isel_u8_at(ctx.slot_escaped, sv as usize) = 1u8; }
                    }
                }
            } else {
                let mut s0: u32 = 0u32;
                if (k >= LIR_INST_ADD && k <= LIR_INST_SAR) ||
                   (k >= LIR_INST_ICMP_EQ && k <= LIR_INST_ICMP_UGE) ||
                   (k >= LIR_INST_SADD_OVERFLOW && k <= LIR_INST_UREM_OVERFLOW) ||
                   k == LIR_INST_UDIV || k == LIR_INST_UREM || k == LIR_INST_OFFSET {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).lhs.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).rhs.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                } else if k == LIR_INST_NEG || k == LIR_INST_NOT || k == LIR_INST_BITNOT {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).operand.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                } else if k == LIR_INST_ABI_ARG && dv == LIR_VREG_NONE {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).val.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                } else if k == LIR_INST_CALL {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).dst_addr.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).callee_vreg.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                } else if k == LIR_INST_ATOMIC_LOAD {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).ptr.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                } else if k == LIR_INST_ATOMIC_STORE || k == LIR_INST_ATOMIC_RMW {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).ptr.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).val.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                } else if k == LIR_INST_ATOMIC_CAS {
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).ptr.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).lhs.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                    if isel_vreg_is_stack_addr(ctx, unsafe { (*inst).rhs.v }, mut_view(s0)) {
                        unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
                    }
                }
            }
            i = i + 1;
        }
        let tk = unsafe { (*lbb).term.kind };
        if tk == LIR_TERM_JCC || tk == LIR_TERM_SWITCH || tk == LIR_TERM_ASSERT {
            let mut s0: u32 = 0u32;
            if isel_vreg_is_stack_addr(ctx, unsafe { (*lbb).term.cond.v }, mut_view(s0)) {
                unsafe { *isel_u8_at(ctx.slot_escaped, s0 as usize) = 1u8; }
            }
        }
        b = b + 1;
    }
}

fn isel_opt_pass3_aliases(ctx: view<IselOptCtx>, lir: view<LirBody>, interner: view<TypeInterner>) {
    let bcnt = ctx.bb_count;
    let vcnt = ctx.vreg_count;
    let scnt = ctx.slot_count;
    let mut b: usize = 0;
    while b < bcnt {
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let icnt = unsafe { (*lbb).inst_count };
        let insts = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { lir_inst_at(insts, i) };
            let k = unsafe { (*inst).kind };
            if k == LIR_INST_STORE {
                let pv = unsafe { (*inst).ptr.v };
                let vv = unsafe { (*inst).val.v };
                let mut sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) {
                    let s = sv as usize;
                    if s > 0 && s < scnt &&
                       (unsafe { *isel_u8_at(ctx.slot_escaped, s) }) == 0u8 &&
                       (unsafe { *isel_u8_at(ctx.slot_is_param, s) }) == 0u8 &&
                       (unsafe { *isel_u32_at(ctx.slot_store_cnt, s) }) == 1u32 {
                        let slot_ty_v = unsafe { (*lir_slot_at(lir.slots, s)).ty.v };
                        let slot_can_prop = isel_type_can_prop_const(TypeId { v: slot_ty_v }, interner);
                        if slot_can_prop {
                            let mut cval: i64 = 0i64;
                            if isel_vreg_const(ctx, lir, interner, vv, mut_view(cval)) {
                                let v_ty = isel_vreg_ty(lir, vv);
                                let c0 = isel_norm_const_to_ty(v_ty, interner, cval as u64);
                                let c_slot = isel_norm_const_to_ty(TypeId { v: slot_ty_v }, interner, c0 as u64);
                                unsafe {
                                    *isel_u8_at(ctx.slot_const_ok, s) = 1u8;
                                    *isel_i64_at(ctx.slot_const_val, s) = c_slot;
                                }
                            }
                        }
                    }
                }
            } else if k == LIR_INST_LOAD {
                let pv = unsafe { (*inst).ptr.v };
                let dv = unsafe { (*inst).dest.v };
                let mut sv: u32 = 0u32;
                if isel_vreg_is_stack_addr(ctx, pv, mut_view(sv)) {
                    let s = sv as usize;
                    if s > 0 && s < scnt &&
                       (unsafe { *isel_u8_at(ctx.slot_escaped, s) }) == 0u8 &&
                       (unsafe { *isel_u32_at(ctx.slot_store_cnt, s) }) == 1u32 {
                        let d_ty = isel_vreg_ty(lir, dv);
                        let ld_ty = unsafe { (*inst).ty };
                        let slot_ty = unsafe { (*lir_slot_at(lir.slots, s)).ty };
                        let d_sz = type_size(TypeId { v: d_ty.v }, interner);
                        if d_sz == 8u32 && ld_ty.v == d_ty.v && slot_ty.v == d_ty.v &&
                           i > 0 && (dv as usize) < vcnt &&
                           (unsafe { *isel_u8_at(ctx.cross_bb, dv as usize) }) == 0u8 {
                            let mut j: usize = i;
                            while j > 0 {
                                j = j - 1;
                                let pinst = unsafe { lir_inst_at(insts, j) };
                                let pk = unsafe { (*pinst).kind };
                                if (pk >= LIR_INST_ATOMIC_LOAD && pk <= LIR_INST_FENCE) || pk == LIR_INST_CALL {
                                    break;
                                }
                                if pk == LIR_INST_STORE {
                                    let st_pv = unsafe { (*pinst).ptr.v };
                                    let st_vv = unsafe { (*pinst).val.v };
                                    let mut st_sv: u32 = 0u32;
                                    if isel_vreg_is_stack_addr(ctx, st_pv, mut_view(st_sv)) && st_sv == sv {
                                        let v_ty = isel_vreg_ty(lir, st_vv);
                                        if v_ty.v == d_ty.v && (st_vv as usize) < vcnt &&
                                           (unsafe { *isel_u32_at(ctx.def_cnt, st_vv as usize) }) == 1u32 &&
                                           (unsafe { *isel_u32_at(ctx.def_bb, st_vv as usize) }) == (b as u32) {
                                            unsafe {
                                                *isel_u32_at(ctx.vreg_alias, dv as usize) = st_vv;
                                                if (*isel_u32_at(ctx.slot_load_cnt, s)) == 1u32 &&
                                                   (*isel_u8_at(ctx.slot_is_param, s)) == 0u8 {
                                                    *isel_u8_at(ctx.slot_single_bb, s) = 1u8;
                                                    *isel_u32_at(ctx.slot_single_ld_v, s) = dv;
                                                }
                                            }
                                        }
                                        break;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        b = b + 1;
    }
}

fn isel_opt_lower_terminator(
    ctx: view<IselOptCtx>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    b: usize,
    lbb: *mut LirBb
) {
    let term_kind = unsafe { (*lbb).term.kind };
    if term_kind == LIR_TERM_SWITCH {
        let cond_v = unsafe { (*lbb).term.cond.v };
        let t_count = unsafe { (*lbb).term.count };
        let targets_base = unsafe { (*lbb).term.targets };
        let otherwise_v = unsafe { (*lbb).term.otherwise.v };
        if t_count == 1 &&
           (unsafe { (*lir_switch_target_at(targets_base, 0)).val }) == 0u64 &&
           isel_vreg_is_scalar_gpr(lir, interner, cond_v) {
            let t0_bb = unsafe { (*lir_switch_target_at(targets_base, 0)).target.v as i64 };
            let cc: u8 = isel_emit_cond_flags_for_branch(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), b as u32, cond_v);
            let inv_cc = x64_cc_invert(cc);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, x64_op_imm(inv_cc as i64), x64_op_imm(t0_bb));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(otherwise_v as i64), x64_op_none());
        } else {
            let cond_ty_v = isel_vreg_ty(lir, cond_v).v;
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_R10, cond_v);
            let mut k: usize = 0;
            while k < t_count {
                let tp = unsafe { lir_switch_target_at(targets_base, k) };
                let t_val = isel_norm_const_to_ty(TypeId { v: cond_ty_v }, interner, unsafe { (*tp).val });
                let t_bb = unsafe { (*tp).target.v as i64 };
                if isel_fits_i32(t_val) {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_R10), x64_op_imm(t_val));
                } else {
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_R11), x64_op_imm(t_val));
                    x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_R10), x64_op_reg(REG_R11));
                }
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, x64_op_imm(CC_E as i64), x64_op_imm(t_bb));
                k = k + 1;
            }
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(otherwise_v as i64), x64_op_none());
        }
    } else if term_kind == LIR_TERM_JCC {
        let cond_v = unsafe { (*lbb).term.cond.v };
        let then_v = unsafe { (*lbb).term.then_target.v };
        let else_v = unsafe { (*lbb).term.else_target.v };
        if isel_vreg_is_scalar_gpr(lir, interner, cond_v) {
            let cc: u8 = isel_emit_cond_flags_for_branch(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), b as u32, cond_v);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, x64_op_imm(cc as i64), x64_op_imm(then_v as i64));
        } else {
            isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, cond_v);
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(0i64));
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JCC, x64_op_imm(CC_NE as i64), x64_op_imm(then_v as i64));
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(else_v as i64), x64_op_none());
    } else if term_kind == LIR_TERM_ASSERT {
        let cond_v = unsafe { (*lbb).term.cond.v };
        let target_v = unsafe { (*lbb).term.assert_target.v };
        let msg_ptr = unsafe { (*lbb).term.msg_ptr };
        let msg_len = unsafe { (*lbb).term.msg_len };
        isel_emit_load_vreg(ctx, lir, interner, mut_view(*mi), mut_view(*mbb), REG_RAX, cond_v);
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(1i64));
        let assert_mi = x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_ASSERT, x64_op_imm(target_v as i64), x64_op_none());
        unsafe {
            (*assert_mi).msg = msg_ptr;
            (*assert_mi).msg_len = msg_len;
        }
    } else if term_kind == LIR_TERM_JMP {
        let jmp_v = unsafe { (*lbb).term.jmp_target.v };
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_JMP, x64_op_imm(jmp_v as i64), x64_op_none());
    } else if term_kind == LIR_TERM_RETURN {
        let s0_ty = isel_slot0_ty(lir);
        let ret_ty = type_get(interner, s0_ty);
        let mut is_unit = false;
        if (ret_ty as usize) != 0 {
            let rk = unsafe { (*ret_ty).kind };
            if rk == TY_UNIT {
                is_unit = true;
            }
        }
        if is_unit {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
        } else {
            x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
        }
        x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_RET, x64_op_none(), x64_op_none());
    }
}

pub fn x64_isel_opt_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    opt_enabled: bool
) -> *mut X64MIBody {
    if !opt_enabled {
        return x64_isel_raw_in_arena(mut_view(*arena), lir, interner);
    }

    let mi = x64_mi_body_new(mut_view(*arena), lir.bb_count);
    unsafe {
        (*mi).shadow_space = lir.frame_req.max_outgoing_args_bytes;
        (*mi).stack_args_size = 0u32;
        (*mi).is_opt = true;
    }

    let slot_offset = lir.slot_count as u32;
    let mut callee_ret_in_mem = false;
    if lir.slot_count > 0 {
        let s0_ty = isel_slot0_ty(lir);
        let ret_size = type_size(s0_ty, interner);
        callee_ret_in_mem = isel_type_is_ret_in_mem(ret_size);
    }

    let vcnt = lir.vreg_count;
    let scnt = lir.slot_count;
    let bcnt = lir.bb_count;
    let v_alloc = if vcnt > 0 { vcnt } else { 1 };
    let s_alloc = if scnt > 0 { scnt } else { 1 };
    let b_alloc = if bcnt > 0 { bcnt } else { 1 };

    let def_bb = arena_alloc_raw(mut_view(*arena), lir_mul_usize(v_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let def_idx = arena_alloc_raw(mut_view(*arena), lir_mul_usize(v_alloc, size_of<usize>()), align_of<usize>()) as *mut usize;
    let def_cnt = arena_alloc_raw(mut_view(*arena), lir_mul_usize(v_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let def_inst = arena_alloc_raw(mut_view(*arena), lir_mul_usize(v_alloc, size_of<*mut LirInst>()), align_of<*mut LirInst>()) as *mut *mut LirInst;
    let use_cnt = arena_alloc_raw(mut_view(*arena), lir_mul_usize(v_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let cross_bb = arena_alloc_raw(mut_view(*arena), v_alloc, 1) as *mut u8;
    let vreg_alias = arena_alloc_raw(mut_view(*arena), lir_mul_usize(v_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;

    let slot_escaped = arena_alloc_raw(mut_view(*arena), s_alloc, 1) as *mut u8;
    let slot_is_param = arena_alloc_raw(mut_view(*arena), s_alloc, 1) as *mut u8;
    let slot_store_cnt = arena_alloc_raw(mut_view(*arena), lir_mul_usize(s_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let slot_load_cnt = arena_alloc_raw(mut_view(*arena), lir_mul_usize(s_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let slot_const_ok = arena_alloc_raw(mut_view(*arena), s_alloc, 1) as *mut u8;
    let slot_const_val = arena_alloc_raw(mut_view(*arena), lir_mul_usize(s_alloc, size_of<i64>()), align_of<i64>()) as *mut i64;
    let slot_single_bb = arena_alloc_raw(mut_view(*arena), s_alloc, 1) as *mut u8;
    let slot_single_ld_v = arena_alloc_raw(mut_view(*arena), lir_mul_usize(s_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;

    let pred_cnt = arena_alloc_raw(mut_view(*arena), lir_mul_usize(b_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let bb_skip = arena_alloc_raw(mut_view(*arena), b_alloc, 1) as *mut u8;

    let mut vi: usize = 0;
    while vi < v_alloc {
        unsafe {
            *isel_u32_at(def_bb, vi) = 0xFFFFFFFFu32;
            *isel_usize_at(def_idx, vi) = 0;
            *isel_u32_at(def_cnt, vi) = 0u32;
            *isel_inst_ptr_at(def_inst, vi) = 0 as *mut LirInst;
            *isel_u32_at(use_cnt, vi) = 0u32;
            *isel_u8_at(cross_bb, vi) = 0u8;
            *isel_u32_at(vreg_alias, vi) = LIR_VREG_NONE;
        }
        vi = vi + 1;
    }

    let mut si: usize = 0;
    while si < s_alloc {
        unsafe {
            *isel_u8_at(slot_escaped, si) = if si == 0 { 1u8 } else { 0u8 };
            *isel_u8_at(slot_is_param, si) = 0u8;
            *isel_u32_at(slot_store_cnt, si) = 0u32;
            *isel_u32_at(slot_load_cnt, si) = 0u32;
            *isel_u8_at(slot_const_ok, si) = 0u8;
            *isel_i64_at(slot_const_val, si) = 0i64;
            *isel_u8_at(slot_single_bb, si) = 0u8;
            *isel_u32_at(slot_single_ld_v, si) = LIR_VREG_NONE;
        }
        si = si + 1;
    }

    let mut bi: usize = 0;
    while bi < b_alloc {
        unsafe {
            *isel_u32_at(pred_cnt, bi) = 0u32;
            *isel_u8_at(bb_skip, bi) = 0u8;
        }
        bi = bi + 1;
    }

    let ctx = IselOptCtx {
        slot_offset: slot_offset,
        ret_in_mem: callee_ret_in_mem,
        vreg_count: vcnt,
        slot_count: scnt,
        bb_count: bcnt,
        def_bb: def_bb,
        def_idx: def_idx,
        def_cnt: def_cnt,
        def_inst: def_inst,
        use_cnt: use_cnt,
        cross_bb: cross_bb,
        vreg_alias: vreg_alias,
        slot_escaped: slot_escaped,
        slot_is_param: slot_is_param,
        slot_store_cnt: slot_store_cnt,
        slot_load_cnt: slot_load_cnt,
        slot_const_ok: slot_const_ok,
        slot_const_val: slot_const_val,
        slot_single_bb: slot_single_bb,
        slot_single_ld_v: slot_single_ld_v,
        pred_cnt: pred_cnt,
        bb_skip: bb_skip,
    };

    isel_opt_pass1_defs_and_uses(view(ctx), lir);
    isel_opt_pass2_slots(view(ctx), lir, interner);
    isel_opt_pass3_aliases(view(ctx), lir, interner);

    let mut b: usize = 0;
    while b < bcnt {
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let mbb = unsafe { x64_mi_bb_at((*mi).bbs, b) };
        unsafe {
            x64_mi_bb_reset(mut_view(*mbb), b as u32);
        }

        if (unsafe { *isel_u8_at(bb_skip, b) }) != 0u8 {
            b = b + 1;
            continue;
        }

        if b == 0 && callee_ret_in_mem {
            unsafe {
                x64_mi_emit(mut_view(*mi), mut_view(*mbb), X64_MI_MOV, x64_op_frame(0u32, 0), x64_op_reg(REG_RCX));
            }
        }

        let icnt = unsafe { (*lbb).inst_count };
        let insts = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { lir_inst_at(insts, i) };
            unsafe {
                isel_opt_lower_inst(view(ctx), lir, interner, mut_view(*mi), mut_view(*mbb), b as u32, i, inst);
            }
            i = i + 1;
        }

        let converted = unsafe { isel_try_if_convert_diamond(view(ctx), lir, interner, mut_view(*mi), mut_view(*mbb), b) };
        if !converted {
            unsafe {
                isel_opt_lower_terminator(view(ctx), lir, interner, mut_view(*mi), mut_view(*mbb), b, lbb);
            }
        }

        b = b + 1;
    }

    unsafe {
        isel_sweep_dead_vregs(mut_view(*arena), view(ctx), mut_view(*mi));
    }

    mi
}

pub fn x64_isel_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> *mut X64MIBody {
    x64_isel_opt_in_arena(mut_view(*arena), lir, interner, lir.is_opt)
}

pub fn x64_isel(lir: view<LirBody>, interner: view<TypeInterner>) -> *mut X64MIBody {
    unsafe {
        x64_isel_in_arena(mut_view(*lir.arena), lir, interner)
    }
}

pub fn ax_x64_isel(lir: view<LirBody>, interner: view<TypeInterner>) -> *mut X64MIBody {
    x64_isel(lir, interner)
}
