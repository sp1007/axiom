@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// =============================================================================
// 1. x86-64 Machine IR Data Model (target/x64/mir/mi.h)
// =============================================================================

@derive(Copy)
pub struct X64FrameOp {
    pub slot_id: u32,
    pub offset: i32,
}

// Machine operand (56 bytes <= 64-byte interp limit).
// Both `op.frame.{slot_id, offset}` and flat `op.{slot_id, offset}` are kept in sync.
@derive(Copy)
pub struct X64Op {
    pub kind: u32,
    pub reg: i32,
    pub imm: i64,
    pub mem: X64Mem,
    pub frame: X64FrameOp,
    pub slot_id: u32,
    pub offset: i32,
    pub sym: u32,
}

pub fn x64_op_none() -> X64Op {
    X64Op {
        kind: X64_OP_NONE,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_none() -> X64Op {
    x64_op_none()
}

pub fn x64_op_reg(reg: i32) -> X64Op {
    X64Op {
        kind: X64_OP_REG,
        reg: reg,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_reg(reg: i32) -> X64Op {
    x64_op_reg(reg)
}

pub fn x64_op_imm(imm: i64) -> X64Op {
    X64Op {
        kind: X64_OP_IMM,
        reg: REG_NONE,
        imm: imm,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_imm(imm: i64) -> X64Op {
    x64_op_imm(imm)
}

pub fn x64_op_mem(base: i32, index: i32, scale: u8, disp: i32, is_rip: bool) -> X64Op {
    X64Op {
        kind: X64_OP_MEM,
        reg: REG_NONE,
        imm: 0i64,
        mem: X64Mem {
            base: base,
            index: index,
            scale: scale,
            disp: disp,
            is_rip: is_rip,
        },
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn ax_x64_op_mem(base: i32, index: i32, scale: u8, disp: i32, is_rip: bool) -> X64Op {
    x64_op_mem(base, index, scale, disp, is_rip)
}

pub fn x64_op_mem_struct(mem: X64Mem) -> X64Op {
    X64Op {
        kind: X64_OP_MEM,
        reg: REG_NONE,
        imm: 0i64,
        mem: mem,
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: 0u32,
    }
}

pub fn x64_op_frame(slot_id: u32, offset: i32) -> X64Op {
    X64Op {
        kind: X64_OP_FRAME,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: slot_id, offset: offset },
        slot_id: slot_id,
        offset: offset,
        sym: 0u32,
    }
}

pub fn ax_x64_op_frame(slot_id: u32, offset: i32) -> X64Op {
    x64_op_frame(slot_id, offset)
}

pub fn x64_op_sym(sym: u32) -> X64Op {
    X64Op {
        kind: X64_OP_SYM,
        reg: REG_NONE,
        imm: 0i64,
        mem: x64_mem_base(REG_NONE),
        frame: X64FrameOp { slot_id: 0u32, offset: 0 },
        slot_id: 0u32,
        offset: 0,
        sym: sym,
    }
}

pub fn ax_x64_op_sym(sym: u32) -> X64Op {
    x64_op_sym(sym)
}

// Machine instruction node (intrusively linked per basic block).
// Note: X64MI is > 64 bytes; always allocate via `x64_mi_new` in an Arena and access via pointer/view.
pub struct X64MI {
    pub opcode: u32,
    pub ops: [3]X64Op,
    pub op_count: u8,
    pub size: u8,
    pub sz: u8,
    pub origin_vreg: u32,
    pub msg: *const u8,
    pub msg_len: usize,
    pub next: *mut X64MI,
}

pub struct X64MIBb {
    pub id: u32,
    pub first_inst: *mut X64MI,
    pub last_inst: *mut X64MI,
}

pub struct X64MIStr {
    pub bytes: *const u8,
    pub len: usize,
    pub sym_id: u32,
}

pub struct X64MIBody {
    pub arena: *mut Arena,
    pub bbs: *mut X64MIBb,
    pub bb_count: usize,
    pub shadow_space: u32,
    pub stack_args_size: u32,
    pub strings: *mut X64MIStr,
    pub string_count: usize,
    pub string_cap: usize,
    pub is_opt: bool,
}

pub unsafe fn x64_mi_bb_at(base: *mut X64MIBb, idx: usize) -> *mut X64MIBb {
    let off = lir_mul_usize(idx, size_of<X64MIBb>());
    ((base as usize) + off) as *mut X64MIBb
}

pub unsafe fn x64_mi_str_at(base: *mut X64MIStr, idx: usize) -> *mut X64MIStr {
    let off = lir_mul_usize(idx, size_of<X64MIStr>());
    ((base as usize) + off) as *mut X64MIStr
}

pub fn x64_mi_reset(mi: mut_view<X64MI>, opcode: u32) {
    mi.opcode = opcode;
    let none = x64_op_none();
    mi.ops[0usize] = none;
    mi.ops[1usize] = none;
    mi.ops[2usize] = none;
    mi.op_count = 0u8;
    mi.size = 8u8;
    mi.sz = 8u8;
    mi.origin_vreg = LIR_VREG_NONE;
    mi.msg = 0 as *const u8;
    mi.msg_len = 0;
    mi.next = 0 as *mut X64MI;
}

pub fn x64_mi_set_size(mi: mut_view<X64MI>, sz: u8) {
    mi.size = sz;
    mi.sz = sz;
}

pub fn x64_mi_new(arena: mut_view<Arena>, opcode: u32) -> *mut X64MI {
    let raw = arena_alloc_raw(arena, size_of<X64MI>(), align_of<X64MI>()) as *mut X64MI;
    unsafe {
        x64_mi_reset(mut_view(*raw), opcode);
    }
    raw
}

pub fn ax_x64_mi_new(arena: mut_view<Arena>, opcode: u32) -> *mut X64MI {
    x64_mi_new(arena, opcode)
}

pub fn x64_mi_add_op(mi: mut_view<X64MI>, op: X64Op) {
    let cnt = mi.op_count;
    if cnt < 3u8 {
        let idx = cnt as usize;
        mi.ops[idx] = op;
        mi.op_count = cnt + 1u8;
    }
}

pub fn ax_x64_mi_add_op(mi: mut_view<X64MI>, op: X64Op) {
    x64_mi_add_op(mut_view(*mi), op);
}

pub fn x64_mi_bb_reset(bb: mut_view<X64MIBb>, id: u32) {
    bb.id = id;
    bb.first_inst = 0 as *mut X64MI;
    bb.last_inst = 0 as *mut X64MI;
}

pub fn x64_mi_body_reset(body: mut_view<X64MIBody>, arena_ptr: *mut Arena) {
    body.arena = arena_ptr;
    body.bbs = 0 as *mut X64MIBb;
    body.bb_count = 0;
    body.shadow_space = 0u32;
    body.stack_args_size = 0u32;
    body.strings = 0 as *mut X64MIStr;
    body.string_count = 0;
    body.string_cap = 0;
    body.is_opt = false;
}

pub fn x64_mi_body_new(arena: mut_view<Arena>, bb_count: usize) -> *mut X64MIBody {
    let body = arena_alloc_raw(mut_view(*arena), size_of<X64MIBody>(), align_of<X64MIBody>()) as *mut X64MIBody;
    let mut bbs: *mut X64MIBb = 0 as *mut X64MIBb;
    if bb_count > 0 {
        let bbs_bytes = lir_mul_usize(bb_count, size_of<X64MIBb>());
        bbs = arena_alloc_raw(mut_view(*arena), bbs_bytes, align_of<X64MIBb>()) as *mut X64MIBb;
    }
    let arena_ptr = unsafe { address_of_mut(arena.head) as *mut Arena };
    unsafe {
        x64_mi_body_reset(mut_view(*body), arena_ptr);
        (*body).bb_count = bb_count;
        if bb_count > 0 {
            let mut b: usize = 0;
            while b < bb_count {
                let mbb = x64_mi_bb_at(bbs, b);
                x64_mi_bb_reset(mut_view(*mbb), b as u32);
                b = b + 1;
            }
            (*body).bbs = bbs;
        }
    }
    body
}

pub fn ax_x64_mi_body_new(arena: mut_view<Arena>, bb_count: usize) -> *mut X64MIBody {
    x64_mi_body_new(mut_view(*arena), bb_count)
}

pub fn x64_mi_emit_sz(
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    sz: u8,
    op1: X64Op,
    op2: X64Op
) -> *mut X64MI {
    let inst = unsafe { x64_mi_new(mut_view(*body.arena), opc) };
    unsafe {
        x64_mi_set_size(mut_view(*inst), sz);
        if op1.kind != X64_OP_NONE {
            x64_mi_add_op(mut_view(*inst), op1);
        }
        if op2.kind != X64_OP_NONE {
            x64_mi_add_op(mut_view(*inst), op2);
        }
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

pub fn x64_mi_emit(
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    op1: X64Op,
    op2: X64Op
) -> *mut X64MI {
    x64_mi_emit_sz(mut_view(*body), mut_view(*mbb), opc, 8u8, op1, op2)
}

pub fn x64_mi_emit_cmovcc(
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    cc: u8,
    dst: X64Op,
    src: X64Op
) -> *mut X64MI {
    let inst = unsafe { x64_mi_new(mut_view(*body.arena), X64_MI_CMOVCC) };
    unsafe {
        x64_mi_set_size(mut_view(*inst), 8u8);
        x64_mi_add_op(mut_view(*inst), x64_op_imm(cc as i64));
        x64_mi_add_op(mut_view(*inst), dst);
        x64_mi_add_op(mut_view(*inst), src);
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

// Fast internal X64MI allocator + basic-block linker (T494): inline bump from `arena.current`
// and direct field writes into `inst.ops[0..2]` without constructing/copying 56-byte `X64Op`s.
fn isel_alloc_mi(
    mi: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    opc: u32,
    sz: u8,
    op_count: u8
) -> *mut X64MI {
    let arena = mi.arena;
    let mi_sz = size_of<X64MI>();
    let mi_al = align_of<X64MI>();
    let mut inst: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        let cur: *mut ArenaChunk = (*arena).current;
        if (cur as usize) != 0 {
            let mask: usize = mi_al - 1;
            let c_addr: usize = (*cur).data as usize;
            let u: usize = (*cur).used;
            let cur_addr: usize = c_addr + u;
            let al_addr: usize = (cur_addr + mask) & ~mask;
            let off: usize = al_addr - c_addr;
            let cap: usize = (*cur).cap;
            if cap >= off && (cap - off) >= mi_sz {
                (*arena).bytes_requested = (*arena).bytes_requested + mi_sz;
                (*cur).used = off + mi_sz;
                inst = (((*cur).data as usize) + off) as *mut X64MI;
            }
        }
        if (inst as usize) == 0 {
            inst = arena_alloc_raw(mut_view(*arena), mi_sz, mi_al) as *mut X64MI;
        }
        (*inst).opcode = opc;
        (*inst).op_count = op_count;
        (*inst).size = sz;
        (*inst).sz = sz;
        (*inst).origin_vreg = LIR_VREG_NONE;
        (*inst).msg = 0 as *const u8;
        (*inst).msg_len = 0;
        (*inst).next = 0 as *mut X64MI;
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

fn isel_mi_0(mi: mut_view<X64MIBody>, mbb: mut_view<X64MIBb>, opc: u32) -> *mut X64MI {
    let inst = isel_alloc_mi(mut_view(*mi), mut_view(*mbb), opc, 8u8, 0u8);
    unsafe {
        (*inst).ops[0usize].kind = X64_OP_NONE;
        (*inst).ops[1usize].kind = X64_OP_NONE;
        (*inst).ops[2usize].kind = X64_OP_NONE;
    }
    inst
}

fn isel_mi_r(mi: mut_view<X64MIBody>, mbb: mut_view<X64MIBb>, opc: u32, r0: i32) -> *mut X64MI {
    let inst = isel_alloc_mi(mut_view(*mi), mut_view(*mbb), opc, 8u8, 1u8);
    unsafe {
        (*inst).ops[0usize].kind = X64_OP_REG;
        (*inst).ops[0usize].reg = r0;
        (*inst).ops[1usize].kind = X64_OP_NONE;
        (*inst).ops[2usize].kind = X64_OP_NONE;
    }
    inst
}

fn isel_mi_i(mi: mut_view<X64MIBody>, mbb: mut_view<X64MIBb>, opc: u32, imm0: i64) -> *mut X64MI {
    let inst = isel_alloc_mi(mut_view(*mi), mut_view(*mbb), opc, 8u8, 1u8);
    unsafe {
        (*inst).ops[0usize].kind = X64_OP_IMM;
        (*inst).ops[0usize].imm = imm0;
        (*inst).ops[1usize].kind = X64_OP_NONE;
        (*inst).ops[2usize].kind = X64_OP_NONE;
    }
    inst
}

fn isel_mi_f(mi: mut_view<X64MIBody>, mbb: mut_view<X64MIBb>, opc: u32, slot: u32, off: i32) -> *mut X64MI {
    let inst = isel_alloc_mi(mut_view(*mi), mut_view(*mbb), opc, 8u8, 1u8);
    unsafe {
        (*inst).ops[0usize].kind = X64_OP_FRAME;
        (*inst).ops[0usize].frame.slot_id = slot;
        (*inst).ops[0usize].frame.offset = off;
        (*inst).ops[0usize].slot_id = slot;
        (*inst).ops[0usize].offset = off;
        (*inst).ops[1usize].kind = X64_OP_NONE;
        (*inst).ops[2usize].kind = X64_OP_NONE;
    }
    inst
}

fn isel_mi_rr(mi: mut_view<X64MIBody>, mbb: mut_view<X64MIBb>, opc: u32, r0: i32, r1: i32) -> *mut X64MI {
    let mut inst: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        let arena = mi.arena;
        let mi_sz: usize = size_of<X64MI>();
        let cur = (*arena).current;
        if (cur as usize) != 0 {
            let mask: usize = align_of<X64MI>() - 1;
            let c_addr: usize = (*cur).data as usize;
            let off: usize = (((c_addr + (*cur).used) + mask) & ~mask) - c_addr;
            let cap: usize = (*cur).cap;
            if cap >= off && (cap - off) >= mi_sz {
                (*arena).bytes_requested = (*arena).bytes_requested + mi_sz;
                (*cur).used = off + mi_sz;
                inst = (c_addr + off) as *mut X64MI;
            }
        }
        if (inst as usize) == 0 {
            inst = arena_alloc_raw(mut_view(*arena), mi_sz, align_of<X64MI>()) as *mut X64MI;
        }
        (*inst).opcode = opc;
        (*inst).op_count = 2u8;
        (*inst).size = 8u8;
        (*inst).sz = 8u8;
        (*inst).origin_vreg = LIR_VREG_NONE;
        (*inst).msg = 0 as *const u8;
        (*inst).msg_len = 0;
        (*inst).next = 0 as *mut X64MI;
        (*inst).ops[0usize].kind = X64_OP_REG;
        (*inst).ops[0usize].reg = r0;
        (*inst).ops[1usize].kind = X64_OP_REG;
        (*inst).ops[1usize].reg = r1;
        (*inst).ops[2usize].kind = X64_OP_NONE;
        if (mbb.last_inst as usize) != 0 {
            (*mbb.last_inst).next = inst;
            mbb.last_inst = inst;
        } else {
            mbb.first_inst = inst;
            mbb.last_inst = inst;
        }
    }
    inst
}

