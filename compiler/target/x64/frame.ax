// =============================================================================
// 1. Target Register Description & ABI Register Masks (SPEC-77 §2, AXS-RA-010..014)
// =============================================================================

// Number of bytes pushed on stack by the 7 callee-saved GPRs (RBX, RSI, RDI, R12..R15).
pub const X64_CALLEE_SAVED_BYTES: u32 = 56u32;

// Minimum shadow space (home space) required by Windows x64 ABI.
pub const X64_MIN_SHADOW_SPACE: u32 = 32u32;

// Page size threshold above which `x64_frame_emit_prologue` emits an inline 4096-byte page probe loop.
pub const X64_PAGE_PROBE_THRESHOLD: u32 = 4096u32;

// Physical register bitmasks: bits 0..15 = RAX..R15, bits 16..31 = XMM0..XMM15.
pub const X64_GPR_ALL_MASK: u32 = 0x0000FFFFu32;
pub const X64_GPR_RESERVED_MASK: u32 = 0x00000030u32; // RSP (4), RBP (5)
pub const X64_GPR_ALLOCATABLE_MASK: u32 = 0x0000FFCFu32; // 14 allocatable GPRs
pub const X64_GPR_CALLER_SAVED_MASK: u32 = 0x00000F07u32; // RAX, RCX, RDX, R8..R11 (7 GPRs)
pub const X64_GPR_CALLEE_SAVED_MASK: u32 = 0x0000F0C8u32; // RBX, RSI, RDI, R12..R15 (7 GPRs)

pub const X64_XMM_ALL_MASK: u32 = 0xFFFF0000u32; // XMM0..XMM15 (16 XMMs)
pub const X64_XMM_CALLER_SAVED_MASK: u32 = 0x003F0000u32; // XMM0..XMM5 (6 XMMs)
pub const X64_XMM_CALLEE_SAVED_MASK: u32 = 0xFFC00000u32; // XMM6..XMM15 (10 XMMs)

pub const X64_ALL_CALLER_SAVED_MASK: u32 = 0x003F0F07u32;
pub const X64_ALL_CALLEE_SAVED_MASK: u32 = 0xFFC0F0C8u32;

// Frame layout metadata trailer magic tag stored at `slot_offsets[slot_count]`.
pub const X64_FRAME_META_MAGIC: i32 = 0x58363446;

// Rematerialization kinds (SPEC-77 §3.5, AXS-RA-022).
pub const X64_REMAT_NONE: u8 = 0u8;
pub const X64_REMAT_CONST: u8 = 1u8;
pub const X64_REMAT_STACK_ADDR: u8 = 2u8;
pub const X64_REMAT_FN_ADDR: u8 = 3u8;

@derive(Copy)
pub struct X64TargetDesc {
    pub gpr_allocatable_mask: u32,
    pub gpr_caller_saved_mask: u32,
    pub gpr_callee_saved_mask: u32,
    pub xmm_allocatable_mask: u32,
    pub xmm_caller_saved_mask: u32,
    pub xmm_callee_saved_mask: u32,
    pub gpr_count: u8,
    pub xmm_count: u8,
}

pub fn x64_target_desc_win64() -> X64TargetDesc {
    X64TargetDesc {
        gpr_allocatable_mask: X64_GPR_ALLOCATABLE_MASK,
        gpr_caller_saved_mask: X64_GPR_CALLER_SAVED_MASK,
        gpr_callee_saved_mask: X64_GPR_CALLEE_SAVED_MASK,
        xmm_allocatable_mask: X64_XMM_ALL_MASK,
        xmm_caller_saved_mask: X64_XMM_CALLER_SAVED_MASK,
        xmm_callee_saved_mask: X64_XMM_CALLEE_SAVED_MASK,
        gpr_count: 14u8,
        xmm_count: 16u8,
    }
}

pub fn x64_reg_bit(reg: i32) -> u32 {
    if reg >= 0 && reg < 32 {
        1u32 << (reg as u32)
    } else {
        0u32
    }
}

pub fn x64_popcount_u32(mask: u32) -> u32 {
    let mut m = mask;
    let mut cnt: u32 = 0u32;
    while m != 0u32 {
        cnt = cnt + (m & 1u32);
        m = m >> 1u32;
    }
    cnt
}

// =============================================================================
// 2. Liveness Analysis & Loop Nesting Depth (SPEC-77 §3.1, AXS-RA-015..016)
// =============================================================================

@derive(Copy)
pub struct X64LivenessInfo {
    pub bb_count: u32,
    pub vreg_count: u32,
    pub words_per_bb: u32,
    pub pad: u32,
    pub use_bits: *mut u64,
    pub def_bits: *mut u64,
    pub live_in: *mut u64,
    pub live_out: *mut u64,
    pub loop_depth: *mut u32,
    pub bb_bounds: *mut u32,
}

pub unsafe fn u64_at(base: *mut u64, idx: usize) -> *mut u64 {
    ((base as usize) + (idx << 3)) as *mut u64
}

pub unsafe fn u8_at_mut(base: *mut u8, idx: usize) -> *mut u8 {
    ((base as usize) + idx) as *mut u8
}

fn bitset_alloc_zeroed(arena: mut_view<Arena>, word_count: usize) -> *mut u64 {
    let mut ptr: *mut u64 = 0 as *mut u64;
    if word_count > 0 {
        let bytes = word_count << 3;
        ptr = arena_alloc_raw(mut_view(*arena), bytes, 8) as *mut u64;
        let mut p: usize = ptr as usize;
        let end: usize = p + bytes;
        while p < end {
            unsafe {
                *(p as *mut u64) = 0u64;
            }
            p = p + 8;
        }
    }
    ptr
}

fn bitset_test(base: *mut u64, words_per_bb: usize, bb: usize, vreg: u32) -> bool {
    let w = (vreg as usize) >> 6;
    if w >= words_per_bb || (base as usize) == 0 {
        false
    } else {
        let idx = (bb * words_per_bb) + w;
        let word = unsafe { *(((base as usize) + (idx << 3)) as *mut u64) };
        ((word >> ((vreg & 63u32) as u64)) & 1u64) != 0u64
    }
}

fn bitset_set(base: *mut u64, words_per_bb: usize, bb: usize, vreg: u32) {
    let w = (vreg as usize) >> 6;
    if w < words_per_bb && (base as usize) != 0 {
        let idx = (bb * words_per_bb) + w;
        let p = ((base as usize) + (idx << 3)) as *mut u64;
        unsafe {
            *p = (*p) | (1u64 << ((vreg & 63u32) as u64));
        }
    }
}

fn bitset_clear(base: *mut u64, words_per_bb: usize, bb: usize, vreg: u32) {
    let w = (vreg as usize) >> 6;
    if w < words_per_bb && (base as usize) != 0 {
        let idx = (bb * words_per_bb) + w;
        let p = ((base as usize) + (idx << 3)) as *mut u64;
        unsafe {
            *p = (*p) & (0xFFFFFFFFFFFFFFFFu64 ^ (1u64 << ((vreg & 63u32) as u64)));
        }
    }
}

pub fn x64_liveness_is_live_in(info: view<X64LivenessInfo>, bb: usize, vreg: u32) -> bool {
    if bb >= (info.bb_count as usize) || vreg >= info.vreg_count {
        false
    } else {
        bitset_test(info.live_in, info.words_per_bb as usize, bb, vreg)
    }
}

pub fn x64_liveness_is_live_out(info: view<X64LivenessInfo>, bb: usize, vreg: u32) -> bool {
    if bb >= (info.bb_count as usize) || vreg >= info.vreg_count {
        false
    } else {
        bitset_test(info.live_out, info.words_per_bb as usize, bb, vreg)
    }
}

pub fn x64_liveness_loop_depth(info: view<X64LivenessInfo>, bb: usize) -> u32 {
    if bb >= (info.bb_count as usize) || (info.loop_depth as usize) == 0 {
        0u32
    } else {
        unsafe { *(((info.loop_depth as usize) + (bb << 2)) as *mut u32) }
    }
}

pub fn x64_liveness_bb_start(info: view<X64LivenessInfo>, bb: usize) -> u32 {
    if bb >= (info.bb_count as usize) || (info.bb_bounds as usize) == 0 {
        0u32
    } else {
        unsafe { *(((info.bb_bounds as usize) + (bb << 3)) as *mut u32) }
    }
}

pub fn x64_liveness_bb_end(info: view<X64LivenessInfo>, bb: usize) -> u32 {
    if bb >= (info.bb_count as usize) || (info.bb_bounds as usize) == 0 {
        0u32
    } else {
        unsafe { *(((info.bb_bounds as usize) + (bb << 3) + 4) as *mut u32) }
    }
}

fn liveness_record_use(
    use_bits: *mut u64,
    def_bits: *mut u64,
    words_per_bb: usize,
    bb: usize,
    vreg: u32,
    vreg_count: usize
) {
    if vreg != LIR_VREG_NONE && (vreg as usize) < vreg_count {
        let idx = (bb * words_per_bb) + ((vreg as usize) >> 6);
        let bit = 1u64 << ((vreg & 63u32) as u64);
        let off = idx << 3;
        unsafe {
            if (*(((def_bits as usize) + off) as *mut u64) & bit) == 0u64 {
                let up = ((use_bits as usize) + off) as *mut u64;
                *up = (*up) | bit;
            }
        }
    }
}

fn liveness_record_def(
    def_bits: *mut u64,
    words_per_bb: usize,
    bb: usize,
    vreg: u32,
    vreg_count: usize
) {
    if vreg != LIR_VREG_NONE && (vreg as usize) < vreg_count {
        let idx = (bb * words_per_bb) + ((vreg as usize) >> 6);
        let bit = 1u64 << ((vreg & 63u32) as u64);
        let dp = ((def_bits as usize) + (idx << 3)) as *mut u64;
        unsafe {
            *dp = (*dp) | bit;
        }
    }
}

fn frame_ctz_u64(x: u64) -> u32 {
    if x == 0u64 {
        return 64u32;
    }
    let mut v = x;
    let mut n: u32 = 0u32;
    if (v & 0xFFFFFFFFu64) == 0u64 { n = n + 32u32; v = v >> 32u64; }
    if (v & 0xFFFFu64) == 0u64 { n = n + 16u32; v = v >> 16u64; }
    if (v & 0xFFu64) == 0u64 { n = n + 8u32; v = v >> 8u64; }
    if (v & 0xFu64) == 0u64 { n = n + 4u32; v = v >> 4u64; }
    if (v & 0x3u64) == 0u64 { n = n + 2u32; v = v >> 2u64; }
    if (v & 0x1u64) == 0u64 { n = n + 1u32; }
    n
}

fn frame_ctz_u32(x: u32) -> u32 {
    if x == 0u32 {
        return 32u32;
    }
    let mut v = x;
    let mut n: u32 = 0u32;
    if (v & 0xFFFFu32) == 0u32 { n = n + 16u32; v = v >> 16u32; }
    if (v & 0xFFu32) == 0u32 { n = n + 8u32; v = v >> 8u32; }
    if (v & 0xFu32) == 0u32 { n = n + 4u32; v = v >> 4u32; }
    if (v & 0x3u32) == 0u32 { n = n + 2u32; v = v >> 2u32; }
    if (v & 0x1u32) == 0u32 { n = n + 1u32; }
    n
}

struct LivenessEdgeBuf {
    from_arr: *mut u32,
    to_arr: *mut u32,
    count: usize,
    cap: usize,
}

fn liveness_push_edge_unique(
    arena: mut_view<Arena>,
    ebuf: mut_view<LivenessEdgeBuf>,
    seen_stamp: *mut u32,
    succ_deg: *mut u32,
    pred_deg: *mut u32,
    bb_count: usize,
    from_bb: usize,
    to_bb: u32,
    stamp: u32
) {
    let t = to_bb as usize;
    if t < bb_count {
        let sp = ((seen_stamp as usize) + (t << 2)) as *mut u32;
        if (unsafe { *sp }) != stamp {
            unsafe {
                *sp = stamp;
                let sdp = ((succ_deg as usize) + (from_bb << 2)) as *mut u32;
                *sdp = (*sdp) + 1u32;
                let pdp = ((pred_deg as usize) + (t << 2)) as *mut u32;
                *pdp = (*pdp) + 1u32;
            }
            if ebuf.count >= ebuf.cap {
                let new_cap = if ebuf.cap == 0 { 64 } else { ebuf.cap << 1 };
                let new_from = arena_alloc_raw(mut_view(*arena), new_cap << 2, 4) as *mut u32;
                let new_to = arena_alloc_raw(mut_view(*arena), new_cap << 2, 4) as *mut u32;
                if ebuf.count > 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(ebuf.from_arr as *const u8, new_from as *mut u8, ebuf.count << 2);
                        ptr_copy_nonoverlapping<u8>(ebuf.to_arr as *const u8, new_to as *mut u8, ebuf.count << 2);
                    }
                }
                ebuf.from_arr = new_from;
                ebuf.to_arr = new_to;
                ebuf.cap = new_cap;
            }
            let idx = ebuf.count;
            unsafe {
                *(((ebuf.from_arr as usize) + (idx << 2)) as *mut u32) = from_bb as u32;
                *(((ebuf.to_arr as usize) + (idx << 2)) as *mut u32) = to_bb;
            }
            ebuf.count = idx + 1;
        }
    }
}

fn liveness_mark_natural_loop_csr(
    in_loop_stamp: *mut u32,
    worklist: *mut u32,
    pred_offs: *mut u32,
    pred_list: *mut u32,
    stamp: u32,
    header: usize,
    latch: usize,
    loop_depth: *mut u32
) {
    unsafe {
        *(((in_loop_stamp as usize) + (header << 2)) as *mut u32) = stamp;
        *worklist = header as u32;
    }
    let mut wl_tail: usize = 1;
    if latch != header {
        unsafe {
            *(((in_loop_stamp as usize) + (latch << 2)) as *mut u32) = stamp;
            *(((worklist as usize) + 4) as *mut u32) = latch as u32;
        }
        wl_tail = 2;
    }
    let mut wl_cur: usize = 1;
    while wl_cur < wl_tail {
        let cur = unsafe { *(((worklist as usize) + (wl_cur << 2)) as *mut u32) as usize };
        wl_cur = wl_cur + 1;
        let p_lo = unsafe { *(((pred_offs as usize) + (cur << 2)) as *mut u32) as usize };
        let p_hi = unsafe { *(((pred_offs as usize) + ((cur + 1) << 2)) as *mut u32) as usize };
        let mut pe: usize = p_lo;
        while pe < p_hi {
            let pred = unsafe { *(((pred_list as usize) + (pe << 2)) as *mut u32) as usize };
            if pred >= header {
                let st_p = ((in_loop_stamp as usize) + (pred << 2)) as *mut u32;
                if (unsafe { *st_p }) != stamp {
                    unsafe {
                        *st_p = stamp;
                        *(((worklist as usize) + (wl_tail << 2)) as *mut u32) = pred as u32;
                    }
                    wl_tail = wl_tail + 1;
                }
            }
            pe = pe + 1;
        }
    }
    let mut k: usize = 0;
    while k < wl_tail {
        let node = unsafe { *(((worklist as usize) + (k << 2)) as *mut u32) as usize };
        let dp = ((loop_depth as usize) + (node << 2)) as *mut u32;
        unsafe {
            *dp = (*dp) + 1u32;
        }
        k = k + 1;
    }
}

struct LivenessBitsets {
    words_per_bb: usize,
    vreg_count: usize,
    use_bits: *mut u64,
    def_bits: *mut u64,
    live_in: *mut u64,
    live_out: *mut u64,
}

fn liveness_record_lir_inst(
    bs: *mut LivenessBitsets,
    b: usize,
    inst: *const LirInst
) {
    let use_bits = unsafe { (*bs).use_bits };
    let def_bits = unsafe { (*bs).def_bits };
    let words_per_bb = unsafe { (*bs).words_per_bb };
    let vreg_count = unsafe { (*bs).vreg_count };

    let kind = unsafe { (*inst).kind };
    let dest_v = unsafe { (*inst).dest.v };
    let lhs_v = unsafe { (*inst).lhs.v };
    let rhs_v = unsafe { (*inst).rhs.v };
    let op_v = unsafe { (*inst).operand.v };
    let ptr_v = unsafe { (*inst).ptr.v };
    let val_v = unsafe { (*inst).val.v };
    let off_v = unsafe { (*inst).offset.v };
    let dst_addr_v = unsafe { (*inst).dst_addr.v };
    let callee_v = unsafe { (*inst).callee_vreg.v };
    let cas_ok_v = unsafe { (*inst).cas_ok.v };

    if (kind >= LIR_INST_ADD && kind <= LIR_INST_SAR) ||
       (kind >= LIR_INST_ICMP_EQ && kind <= LIR_INST_ICMP_UGE) ||
       (kind >= LIR_INST_SADD_OVERFLOW && kind <= LIR_INST_UREM_OVERFLOW) ||
       kind == LIR_INST_UDIV || kind == LIR_INST_UREM {
        liveness_record_use(use_bits, def_bits, words_per_bb, b, lhs_v, vreg_count);
        liveness_record_use(use_bits, def_bits, words_per_bb, b, rhs_v, vreg_count);
        liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
    } else if kind == LIR_INST_NEG || kind == LIR_INST_NOT || kind == LIR_INST_BITNOT {
        liveness_record_use(use_bits, def_bits, words_per_bb, b, op_v, vreg_count);
        liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
    } else if kind == LIR_INST_LOAD || kind == LIR_INST_ATOMIC_LOAD {
        liveness_record_use(use_bits, def_bits, words_per_bb, b, ptr_v, vreg_count);
        liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
    } else if kind == LIR_INST_STORE || kind == LIR_INST_ATOMIC_STORE {
        liveness_record_use(use_bits, def_bits, words_per_bb, b, ptr_v, vreg_count);
        liveness_record_use(use_bits, def_bits, words_per_bb, b, val_v, vreg_count);
    } else if kind == LIR_INST_ATOMIC_RMW {
        liveness_record_use(use_bits, def_bits, words_per_bb, b, ptr_v, vreg_count);
        liveness_record_use(use_bits, def_bits, words_per_bb, b, val_v, vreg_count);
        liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
    } else if kind == LIR_INST_ATOMIC_CAS {
        liveness_record_use(use_bits, def_bits, words_per_bb, b, ptr_v, vreg_count);
        liveness_record_use(use_bits, def_bits, words_per_bb, b, lhs_v, vreg_count);
        liveness_record_use(use_bits, def_bits, words_per_bb, b, rhs_v, vreg_count);
        liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
        liveness_record_def(def_bits, words_per_bb, b, cas_ok_v, vreg_count);
    } else if kind == LIR_INST_OFFSET {
        liveness_record_use(use_bits, def_bits, words_per_bb, b, ptr_v, vreg_count);
        liveness_record_use(use_bits, def_bits, words_per_bb, b, off_v, vreg_count);
        liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
    } else if kind == LIR_INST_STACK_ADDR || kind == LIR_INST_CONST ||
              kind == LIR_INST_CONST_STR || kind == LIR_INST_FN_ADDR ||
              kind == LIR_INST_TLS_ADDR ||
              kind == LIR_INST_ABI_RESULT {
        liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
    } else if kind == LIR_INST_ABI_ARG {
        if dest_v != LIR_VREG_NONE {
            liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
        } else {
            liveness_record_use(use_bits, def_bits, words_per_bb, b, val_v, vreg_count);
        }
    } else if kind == LIR_INST_CALL {
        liveness_record_use(use_bits, def_bits, words_per_bb, b, dst_addr_v, vreg_count);
        liveness_record_use(use_bits, def_bits, words_per_bb, b, callee_v, vreg_count);
    }
}

fn liveness_solve_dataflow_csr(
    arena: mut_view<Arena>,
    bs: *mut LivenessBitsets,
    bb_count: usize,
    succ_offs: *mut u32,
    succ_list: *mut u32,
    pred_offs: *mut u32,
    pred_list: *mut u32
) {
    let use_bits = unsafe { (*bs).use_bits as usize };
    let def_bits = unsafe { (*bs).def_bits as usize };
    let live_in = unsafe { (*bs).live_in as usize };
    let live_out = unsafe { (*bs).live_out as usize };
    let words_per_bb = unsafe { (*bs).words_per_bb };
    let row_bytes = words_per_bb << 3;

    let dirty = arena_alloc_raw(mut_view(*arena), bb_count, 1) as *mut u8;
    let mut di: usize = 0;
    while di < bb_count {
        unsafe { *(((dirty as usize) + di) as *mut u8) = 1u8; }
        di = di + 1;
    }

    let mut changed = true;
    while changed {
        changed = false;
        let mut bi: usize = bb_count;
        while bi > 0 {
            bi = bi - 1;
            let dp_b = ((dirty as usize) + bi) as *mut u8;
            if (unsafe { *dp_b }) == 0u8 {
                continue;
            }
            unsafe { *dp_b = 0u8; }

            let row_off = bi * row_bytes;
            let s_lo = unsafe { *(((succ_offs as usize) + (bi << 2)) as *mut u32) as usize };
            let s_hi = unsafe { *(((succ_offs as usize) + ((bi + 1) << 2)) as *mut u32) as usize };

            if words_per_bb == 1 {
                let mut lo: u64 = unsafe { *((live_out + row_off) as *mut u64) };
                let mut se: usize = s_lo;
                while se < s_hi {
                    let succ = unsafe { *(((succ_list as usize) + (se << 2)) as *mut u32) as usize };
                    lo = lo | (unsafe { *((live_in + (succ << 3)) as *mut u64) });
                    se = se + 1;
                }
                unsafe {
                    *((live_out + row_off) as *mut u64) = lo;
                    let u = *((use_bits + row_off) as *mut u64);
                    let d = *((def_bits + row_off) as *mut u64);
                    let li_p = (live_in + row_off) as *mut u64;
                    let new_li = u | (lo & (0xFFFFFFFFFFFFFFFFu64 ^ d));
                    if new_li != *li_p {
                        *li_p = new_li;
                        let p_lo = *(((pred_offs as usize) + (bi << 2)) as *mut u32) as usize;
                        let p_hi = *(((pred_offs as usize) + ((bi + 1) << 2)) as *mut u32) as usize;
                        let mut pe: usize = p_lo;
                        while pe < p_hi {
                            let pred = *(((pred_list as usize) + (pe << 2)) as *mut u32) as usize;
                            *(((dirty as usize) + pred) as *mut u8) = 1u8;
                            if pred >= bi {
                                changed = true;
                            }
                            pe = pe + 1;
                        }
                    }
                }
            } else {
                let lo_base = live_out + row_off;
                let mut se: usize = s_lo;
                while se < s_hi {
                    let succ = unsafe { *(((succ_list as usize) + (se << 2)) as *mut u32) as usize };
                    let si_base = live_in + (succ * row_bytes);
                    let mut off: usize = 0;
                    while off < row_bytes {
                        unsafe {
                            let op = (lo_base + off) as *mut u64;
                            *op = (*op) | *((si_base + off) as *mut u64);
                        }
                        off = off + 8;
                    }
                    se = se + 1;
                }

                let u_base = use_bits + row_off;
                let d_base = def_bits + row_off;
                let li_base = live_in + row_off;
                let mut block_changed = false;
                let mut off: usize = 0;
                while off < row_bytes {
                    unsafe {
                        let u = *((u_base + off) as *mut u64);
                        let d = *((d_base + off) as *mut u64);
                        let lo = *((lo_base + off) as *mut u64);
                        let li_p = (li_base + off) as *mut u64;
                        let new_li = u | (lo & (0xFFFFFFFFFFFFFFFFu64 ^ d));
                        if new_li != *li_p {
                            *li_p = new_li;
                            block_changed = true;
                        }
                    }
                    off = off + 8;
                }
                if block_changed {
                    let p_lo = unsafe { *(((pred_offs as usize) + (bi << 2)) as *mut u32) as usize };
                    let p_hi = unsafe { *(((pred_offs as usize) + ((bi + 1) << 2)) as *mut u32) as usize };
                    let mut pe: usize = p_lo;
                    while pe < p_hi {
                        let pred = unsafe { *(((pred_list as usize) + (pe << 2)) as *mut u32) as usize };
                        unsafe { *(((dirty as usize) + pred) as *mut u8) = 1u8; }
                        if pred >= bi {
                            changed = true;
                        }
                        pe = pe + 1;
                    }
                }
            }
        }
    }
}

pub fn x64_compute_liveness_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    body: view<X64MIBody>
) -> X64LivenessInfo {
    let bb_count = lir.bb_count;
    let vreg_count = lir.vreg_count;
    let slot_offset = lir.slot_count as u32;
    let words_per_bb = if vreg_count == 0 { 1 } else { (vreg_count + 63) >> 6 };
    let total_words = bb_count * words_per_bb;

    let use_bits = bitset_alloc_zeroed(mut_view(*arena), total_words);
    let def_bits = bitset_alloc_zeroed(mut_view(*arena), total_words);
    let live_in = bitset_alloc_zeroed(mut_view(*arena), total_words);
    let live_out = bitset_alloc_zeroed(mut_view(*arena), total_words);

    let mut loop_depth: *mut u32 = 0 as *mut u32;
    let mut bb_bounds: *mut u32 = 0 as *mut u32;
    let mut succ_deg: *mut u32 = 0 as *mut u32;
    let mut pred_deg: *mut u32 = 0 as *mut u32;
    let mut seen_stamp: *mut u32 = 0 as *mut u32;
    let mut succ_offs: *mut u32 = 0 as *mut u32;
    let mut pred_offs: *mut u32 = 0 as *mut u32;
    if bb_count > 0 {
        let depth_bytes = bb_count << 2;
        loop_depth = arena_alloc_raw(mut_view(*arena), depth_bytes, 4) as *mut u32;
        succ_deg = arena_alloc_raw(mut_view(*arena), depth_bytes, 4) as *mut u32;
        pred_deg = arena_alloc_raw(mut_view(*arena), depth_bytes, 4) as *mut u32;
        seen_stamp = arena_alloc_raw(mut_view(*arena), depth_bytes, 4) as *mut u32;
        let offs_bytes = (bb_count + 1) << 2;
        succ_offs = arena_alloc_raw(mut_view(*arena), offs_bytes, 4) as *mut u32;
        pred_offs = arena_alloc_raw(mut_view(*arena), offs_bytes, 4) as *mut u32;
        bb_bounds = arena_alloc_raw(mut_view(*arena), bb_count << 3, 4) as *mut u32;
        let mut z: usize = 0;
        while z < bb_count {
            let off4 = z << 2;
            let off8 = z << 3;
            unsafe {
                *(((loop_depth as usize) + off4) as *mut u32) = 0u32;
                *(((succ_deg as usize) + off4) as *mut u32) = 0u32;
                *(((pred_deg as usize) + off4) as *mut u32) = 0u32;
                *(((seen_stamp as usize) + off4) as *mut u32) = 0u32;
                *(((bb_bounds as usize) + off8) as *mut u32) = 0u32;
                *(((bb_bounds as usize) + off8 + 4) as *mut u32) = 0u32;
            }
            z = z + 1;
        }
    }

    let p_bs = arena_alloc_raw(mut_view(*arena), size_of<LivenessBitsets>(), align_of<LivenessBitsets>()) as *mut LivenessBitsets;
    unsafe {
        (*p_bs).words_per_bb = words_per_bb;
        (*p_bs).vreg_count = vreg_count;
        (*p_bs).use_bits = use_bits;
        (*p_bs).def_bits = def_bits;
        (*p_bs).live_in = live_in;
        (*p_bs).live_out = live_out;
    }

    let init_ecap = if bb_count > 16 { bb_count << 2 } else { 64 };
    let mut ebuf = LivenessEdgeBuf {
        from_arr: if bb_count > 0 { arena_alloc_raw(mut_view(*arena), init_ecap << 2, 4) as *mut u32 } else { 0 as *mut u32 },
        to_arr: if bb_count > 0 { arena_alloc_raw(mut_view(*arena), init_ecap << 2, 4) as *mut u32 } else { 0 as *mut u32 },
        count: 0,
        cap: if bb_count > 0 { init_ecap } else { 0 },
    };

    // Single fused pass: number program points, record per-block def/use bitsets, and collect distinct CFG edges.
    let mut cur_mi_idx: u32 = 0u32;
    let row_bytes = words_per_bb << 3;
    let mut b: usize = 0;
    while b < bb_count {
        let stamp1 = (b + 1) as u32;
        let start_pos = cur_mi_idx << 1;
        let use_row = (use_bits as usize) + (b * row_bytes);
        let def_row = (def_bits as usize) + (b * row_bytes);

        if body.is_opt && b < body.bb_count && (body.bbs as usize) != 0 {
            let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
            let mut inst = unsafe { (*mbb).first_inst };
            let mut cnt: u32 = 0u32;
            while (inst as usize) != 0 {
                cnt = cnt + 1u32;
                let opc = unsafe { (*inst).opcode };
                let oc = unsafe { (*inst).op_count };
                if (opc == X64_MI_JMP || opc == X64_MI_ASSERT) && oc >= 1u8 {
                    if (unsafe { (*inst).ops[0usize].kind }) == X64_OP_IMM {
                        let imm0 = unsafe { (*inst).ops[0usize].imm };
                        if imm0 >= 0 {
                            liveness_push_edge_unique(
                                mut_view(*arena), mut_view(ebuf), seen_stamp, succ_deg, pred_deg, bb_count, b, imm0 as u32, stamp1
                            );
                        }
                    }
                } else if opc == X64_MI_JCC && oc >= 2u8 {
                    if (unsafe { (*inst).ops[1usize].kind }) == X64_OP_IMM {
                        let imm1 = unsafe { (*inst).ops[1usize].imm };
                        if imm1 >= 0 {
                            liveness_push_edge_unique(
                                mut_view(*arena), mut_view(ebuf), seen_stamp, succ_deg, pred_deg, bb_count, b, imm1 as u32, stamp1
                            );
                        }
                    }
                } else {
                    if oc >= 2u8 {
                        if (unsafe { (*inst).ops[1usize].kind }) == X64_OP_FRAME {
                            let sid1 = unsafe { (*inst).ops[1usize].frame.slot_id };
                            if sid1 >= slot_offset {
                                let v_id = sid1 - slot_offset;
                                if (v_id as usize) < vreg_count {
                                    let w_off = ((v_id as usize) >> 6) << 3;
                                    let bit = 1u64 << ((v_id & 63u32) as u64);
                                    unsafe {
                                        if (*((def_row + w_off) as *mut u64) & bit) == 0u64 {
                                            let up = (use_row + w_off) as *mut u64;
                                            *up = (*up) | bit;
                                        }
                                    }
                                }
                            }
                        }
                        if oc >= 3u8 && (unsafe { (*inst).ops[2usize].kind }) == X64_OP_FRAME {
                            let sid2 = unsafe { (*inst).ops[2usize].frame.slot_id };
                            if sid2 >= slot_offset {
                                let v_id = sid2 - slot_offset;
                                if (v_id as usize) < vreg_count {
                                    let w_off = ((v_id as usize) >> 6) << 3;
                                    let bit = 1u64 << ((v_id & 63u32) as u64);
                                    unsafe {
                                        if (*((def_row + w_off) as *mut u64) & bit) == 0u64 {
                                            let up = (use_row + w_off) as *mut u64;
                                            *up = (*up) | bit;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if oc >= 1u8 && (unsafe { (*inst).ops[0usize].kind }) == X64_OP_FRAME {
                        let sid0 = unsafe { (*inst).ops[0usize].frame.slot_id };
                        if sid0 >= slot_offset {
                            let v_id0 = sid0 - slot_offset;
                            if (v_id0 as usize) < vreg_count {
                                let w_off = ((v_id0 as usize) >> 6) << 3;
                                let bit = 1u64 << ((v_id0 & 63u32) as u64);
                                let sz = unsafe { (*inst).size };
                                if opc == X64_MI_MOV && (unsafe { (*inst).ops[0usize].frame.offset }) == 0 && (sz == 8u8 || sz == 0u8) {
                                    unsafe {
                                        let dp = (def_row + w_off) as *mut u64;
                                        *dp = (*dp) | bit;
                                    }
                                } else {
                                    unsafe {
                                        if (*((def_row + w_off) as *mut u64) & bit) == 0u64 {
                                            let up = (use_row + w_off) as *mut u64;
                                            *up = (*up) | bit;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                inst = unsafe { (*inst).next };
            }
            if cnt == 0u32 {
                cnt = 1u32;
            }
            cur_mi_idx = cur_mi_idx + cnt;
            let end_pos = cur_mi_idx << 1;
            unsafe {
                *(((bb_bounds as usize) + (b << 3)) as *mut u32) = start_pos;
                *(((bb_bounds as usize) + (b << 3) + 4) as *mut u32) = end_pos;
            }
        } else {
            if b < body.bb_count && (body.bbs as usize) != 0 {
                let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
                let mut inst = unsafe { (*mbb).first_inst };
                let mut cnt: u32 = 0u32;
                while (inst as usize) != 0 {
                    cnt = cnt + 1u32;
                    inst = unsafe { (*inst).next };
                }
                if cnt == 0u32 {
                    cnt = 1u32;
                }
                cur_mi_idx = cur_mi_idx + cnt;
            } else {
                let lbb0 = unsafe { lir_bb_at(lir.bbs, b) };
                let ic = unsafe { (*lbb0).inst_count as u32 };
                cur_mi_idx = cur_mi_idx + ic + 1u32;
            }
            let end_pos = cur_mi_idx << 1;
            unsafe {
                *(((bb_bounds as usize) + (b << 3)) as *mut u32) = start_pos;
                *(((bb_bounds as usize) + (b << 3) + 4) as *mut u32) = end_pos;
            }

            let lbb = unsafe { lir_bb_at(lir.bbs, b) };
            let inst_count = unsafe { (*lbb).inst_count };
            let insts_base = unsafe { (*lbb).insts };
            let mut i: usize = 0;
            while i < inst_count {
                let inst = unsafe { lir_inst_at(insts_base, i) };
                liveness_record_lir_inst(p_bs, b, inst as *const LirInst);
                i = i + 1;
            }

            let tk = unsafe { (*lbb).term.kind };
            if tk == LIR_TERM_JCC || tk == LIR_TERM_SWITCH || tk == LIR_TERM_ASSERT {
                let cond_v = unsafe { (*lbb).term.cond.v };
                liveness_record_use(use_bits, def_bits, words_per_bb, b, cond_v, vreg_count);
            }
            if tk == LIR_TERM_JMP {
                liveness_push_edge_unique(
                    mut_view(*arena), mut_view(ebuf), seen_stamp, succ_deg, pred_deg, bb_count, b, unsafe { (*lbb).term.jmp_target.v }, stamp1
                );
            } else if tk == LIR_TERM_JCC {
                liveness_push_edge_unique(
                    mut_view(*arena), mut_view(ebuf), seen_stamp, succ_deg, pred_deg, bb_count, b, unsafe { (*lbb).term.then_target.v }, stamp1
                );
                liveness_push_edge_unique(
                    mut_view(*arena), mut_view(ebuf), seen_stamp, succ_deg, pred_deg, bb_count, b, unsafe { (*lbb).term.else_target.v }, stamp1
                );
            } else if tk == LIR_TERM_ASSERT {
                liveness_push_edge_unique(
                    mut_view(*arena), mut_view(ebuf), seen_stamp, succ_deg, pred_deg, bb_count, b, unsafe { (*lbb).term.assert_target.v }, stamp1
                );
            } else if tk == LIR_TERM_SWITCH {
                liveness_push_edge_unique(
                    mut_view(*arena), mut_view(ebuf), seen_stamp, succ_deg, pred_deg, bb_count, b, unsafe { (*lbb).term.otherwise.v }, stamp1
                );
                let scnt = unsafe { (*lbb).term.count };
                let stbase = unsafe { (*lbb).term.targets };
                let mut sk: usize = 0;
                while sk < scnt {
                    let stp = unsafe { lir_switch_target_at(stbase, sk) };
                    liveness_push_edge_unique(
                        mut_view(*arena), mut_view(ebuf), seen_stamp, succ_deg, pred_deg, bb_count, b, unsafe { (*stp).target.v }, stamp1
                    );
                    sk = sk + 1;
                }
            }
        }
        b = b + 1;
    }

    if bb_count > 0 {
        let mut s_acc: u32 = 0u32;
        let mut p_acc: u32 = 0u32;
        let mut bi0: usize = 0;
        while bi0 < bb_count {
            let off4 = bi0 << 2;
            unsafe {
                *(((succ_offs as usize) + off4) as *mut u32) = s_acc;
                *(((pred_offs as usize) + off4) as *mut u32) = p_acc;
                let sd = *(((succ_deg as usize) + off4) as *mut u32);
                let pd = *(((pred_deg as usize) + off4) as *mut u32);
                *(((succ_deg as usize) + off4) as *mut u32) = s_acc;
                *(((pred_deg as usize) + off4) as *mut u32) = p_acc;
                s_acc = s_acc + sd;
                p_acc = p_acc + pd;
            }
            bi0 = bi0 + 1;
        }
        unsafe {
            *(((succ_offs as usize) + (bb_count << 2)) as *mut u32) = s_acc;
            *(((pred_offs as usize) + (bb_count << 2)) as *mut u32) = p_acc;
        }

        let total_edges = ebuf.count;
        let edge_alloc = if total_edges == 0 { 1 } else { total_edges };
        let succ_list = arena_alloc_raw(mut_view(*arena), edge_alloc << 2, 4) as *mut u32;
        let pred_list = arena_alloc_raw(mut_view(*arena), edge_alloc << 2, 4) as *mut u32;

        let mut ei: usize = 0;
        while ei < total_edges {
            let off4 = ei << 2;
            unsafe {
                let fb = *(((ebuf.from_arr as usize) + off4) as *mut u32);
                let tb = *(((ebuf.to_arr as usize) + off4) as *mut u32);
                let s_cur_p = ((succ_deg as usize) + ((fb as usize) << 2)) as *mut u32;
                let si = (*s_cur_p) as usize;
                *(((succ_list as usize) + (si << 2)) as *mut u32) = tb;
                *s_cur_p = (si + 1) as u32;
                let p_cur_p = ((pred_deg as usize) + ((tb as usize) << 2)) as *mut u32;
                let pi = (*p_cur_p) as usize;
                *(((pred_list as usize) + (pi << 2)) as *mut u32) = fb;
                *p_cur_p = (pi + 1) as u32;
            }
            ei = ei + 1;
        }

        // Detect back-edges out of `b` to identify natural loops and increment `loop_depth`.
        let worklist = succ_deg;
        let mut loop_stamp: u32 = (bb_count + 2) as u32;
        let mut lb: usize = 0;
        while lb < bb_count {
            let s_lo = unsafe { *(((succ_offs as usize) + (lb << 2)) as *mut u32) as usize };
            let s_hi = unsafe { *(((succ_offs as usize) + ((lb + 1) << 2)) as *mut u32) as usize };
            let mut se: usize = s_lo;
            while se < s_hi {
                let target_b = unsafe { *(((succ_list as usize) + (se << 2)) as *mut u32) as usize };
                if target_b <= lb {
                    loop_stamp = loop_stamp + 1u32;
                    liveness_mark_natural_loop_csr(
                        seen_stamp, worklist, pred_offs, pred_list, loop_stamp, target_b, lb, loop_depth
                    );
                }
                se = se + 1;
            }
            lb = lb + 1;
        }

        liveness_solve_dataflow_csr(mut_view(*arena), p_bs, bb_count, succ_offs, succ_list, pred_offs, pred_list);
    }

    X64LivenessInfo {
        bb_count: bb_count as u32,
        vreg_count: vreg_count as u32,
        words_per_bb: words_per_bb as u32,
        pad: 0u32,
        use_bits: use_bits,
        def_bits: def_bits,
        live_in: live_in,
        live_out: live_out,
        loop_depth: loop_depth,
        bb_bounds: bb_bounds,
    }
}

// =============================================================================
// 3. Live Intervals, Spill Heuristics & Stack-Slot Coloring (SPEC-77 §3.2..3.6)
// =============================================================================

@derive(Copy)
pub struct X64LiveRange {
    pub start: u32,
    pub end: u32,
}

@derive(Copy)
pub struct X64UsePos {
    pub pos: u32,
    pub fixed_reg: i32,
    pub is_def: bool,
    pub loop_depth: u8,
}

// Live interval for a virtual register (allocated in Arena; accessed via pointer/view).
pub struct X64LiveInterval {
    pub vreg: u32,
    pub reg_class: u8,
    pub remat_kind: u8,
    pub crosses_call: bool,
    pub is_spilled: bool,
    pub must_stack: bool,
    pub assigned_reg: i32,
    pub spill_slot: i32,
    pub start: u32,
    pub end: u32,
    pub ranges: *mut X64LiveRange,
    pub range_count: u32,
    pub range_cap: u32,
    pub uses: *mut X64UsePos,
    pub use_count: u32,
    pub use_cap: u32,
    pub spill_weight: u64,
    pub remat_imm: i64,
    pub remat_slot: u32,
    pub copy_hint_vreg: u32,
    pub fixed_reg_hint: i32,
    pub forbidden_reg_mask: u32,
}

pub unsafe fn x64_live_range_at(base: *mut X64LiveRange, idx: usize) -> *mut X64LiveRange {
    ((base as usize) + (idx << 3)) as *mut X64LiveRange
}

pub unsafe fn x64_use_pos_at(base: *mut X64UsePos, idx: usize) -> *mut X64UsePos {
    ((base as usize) + (idx * size_of<X64UsePos>())) as *mut X64UsePos
}

pub unsafe fn x64_interval_at(base: *mut X64LiveInterval, idx: usize) -> *mut X64LiveInterval {
    ((base as usize) + (idx * size_of<X64LiveInterval>())) as *mut X64LiveInterval
}

pub fn x64_interval_reset(iv: mut_view<X64LiveInterval>, vreg: u32, reg_class: u8) {
    iv.vreg = vreg;
    iv.reg_class = reg_class;
    iv.remat_kind = X64_REMAT_NONE;
    iv.crosses_call = false;
    iv.is_spilled = false;
    iv.must_stack = false;
    iv.assigned_reg = REG_NONE;
    iv.spill_slot = -1;
    iv.start = 0xFFFFFFFFu32;
    iv.end = 0u32;
    iv.ranges = 0 as *mut X64LiveRange;
    iv.range_count = 0u32;
    iv.range_cap = 0u32;
    iv.uses = 0 as *mut X64UsePos;
    iv.use_count = 0u32;
    iv.use_cap = 0u32;
    iv.spill_weight = 0u64;
    iv.remat_imm = 0i64;
    iv.remat_slot = LIR_VREG_NONE;
    iv.copy_hint_vreg = LIR_VREG_NONE;
    iv.fixed_reg_hint = REG_NONE;
    iv.forbidden_reg_mask = 0u32;
}

pub fn x64_interval_add_range(
    arena: mut_view<Arena>,
    iv: mut_view<X64LiveInterval>,
    start: u32,
    end: u32
) {
    let s = start;
    let e = if end <= s { s + 1u32 } else { end };
    if s < iv.start {
        iv.start = s;
    }
    if e > iv.end {
        iv.end = e;
    }
    // Coalesce with last range if adjacent or overlapping.
    let rc = iv.range_count;
    if rc > 0u32 && (iv.ranges as usize) != 0 {
        let last_p = (((iv.ranges as usize) + (((rc - 1u32) as usize) << 3)) as *mut X64LiveRange);
        let ls = unsafe { (*last_p).start };
        let le = unsafe { (*last_p).end };
        if s <= le && e >= ls {
            unsafe {
                if s < ls { (*last_p).start = s; }
                if e > le { (*last_p).end = e; }
            }
            return;
        }
    }
    if rc >= iv.range_cap {
        let new_cap = if iv.range_cap == 0u32 { 4u32 } else { iv.range_cap << 1 };
        let new_buf = arena_alloc_raw(mut_view(*arena), (new_cap as usize) << 3, 4) as *mut X64LiveRange;
        if (iv.ranges as usize) != 0 && rc > 0u32 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(iv.ranges as *const u8, new_buf as *mut u8, (rc as usize) << 3);
            }
        }
        iv.ranges = new_buf;
        iv.range_cap = new_cap;
    }
    let rp = (((iv.ranges as usize) + ((rc as usize) << 3)) as *mut X64LiveRange);
    unsafe {
        (*rp).start = s;
        (*rp).end = e;
    }
    iv.range_count = rc + 1u32;
}

pub fn x64_interval_add_use(
    arena: mut_view<Arena>,
    iv: mut_view<X64LiveInterval>,
    pos: u32,
    fixed_reg: i32,
    is_def: bool,
    loop_depth: u32
) {
    let uc = iv.use_count;
    let up_sz = size_of<X64UsePos>();
    if uc >= iv.use_cap {
        let new_cap = if iv.use_cap == 0u32 { 4u32 } else { iv.use_cap << 1 };
        let new_buf = arena_alloc_raw(mut_view(*arena), (new_cap as usize) * up_sz, align_of<X64UsePos>()) as *mut X64UsePos;
        if (iv.uses as usize) != 0 && uc > 0u32 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(iv.uses as *const u8, new_buf as *mut u8, (uc as usize) * up_sz);
            }
        }
        iv.uses = new_buf;
        iv.use_cap = new_cap;
    }
    let d8 = if loop_depth > 9u32 { 9u8 } else { loop_depth as u8 };
    let up = (((iv.uses as usize) + ((uc as usize) * up_sz)) as *mut X64UsePos);
    unsafe {
        (*up).pos = pos;
        (*up).fixed_reg = fixed_reg;
        (*up).is_def = is_def;
        (*up).loop_depth = d8;
    }
    iv.use_count = uc + 1u32;
}

const FRAME_POW10: [10]u64 = [
    1u64, 10u64, 100u64, 1000u64, 10000u64,
    100000u64, 1000000u64, 10000000u64, 100000000u64, 1000000000u64
];
const FRAME_POW10_X1000: [10]u64 = [
    1000u64, 10000u64, 100000u64, 1000000u64, 10000000u64,
    100000000u64, 1000000000u64, 10000000000u64, 100000000000u64, 1000000000000u64
];

// Loop-depth multiplier `10^d` (SPEC-77 §3.5, AXS-RA-022, REQ-OPT-218).
pub fn x64_loop_weight_multiplier(depth: u32) -> u64 {
    let cap_d = if depth > 9u32 { 9usize } else { depth as usize };
    FRAME_POW10[cap_d]
}

// Compute spill weight: `sum_{u in uses(v)} 10^d(u) * 1000 / max(1, length(v))`
// with optional PGO `block_exec_counts` override (`AXS-RA-022`, `REQ-OPT-218`).
pub fn x64_compute_spill_weight(
    iv: view<X64LiveInterval>,
    block_exec_counts: *const u64,
    bb_count: usize
) -> u64 {
    let ucnt = iv.use_count;
    if ucnt == 0u32 || iv.end <= iv.start {
        return 0u64;
    }
    let up_sz = size_of<X64UsePos>();
    let mut weighted_uses: u64 = 0u64;
    let mut cur_p: usize = iv.uses as usize;
    if (block_exec_counts as usize) == 0 || bb_count == 0 {
        let end_p: usize = cur_p + ((ucnt as usize) * up_sz);
        while cur_p < end_p {
            let up = cur_p as *const X64UsePos;
            let d_raw = unsafe { (*up).loop_depth as usize };
            let d = if d_raw > 9 { 9 } else { d_raw };
            let mut add_w = FRAME_POW10_X1000[d];
            if (unsafe { (*up).fixed_reg }) != REG_NONE {
                add_w = add_w << 2;
            }
            weighted_uses = weighted_uses + add_w;
            cur_p = cur_p + up_sz;
        }
    } else {
        let mut i: usize = 0;
        let ucnt_u = ucnt as usize;
        while i < ucnt_u {
            let up = cur_p as *const X64UsePos;
            let d_raw = unsafe { (*up).loop_depth as usize };
            let d = if d_raw > 9 { 9 } else { d_raw };
            let mut mult = FRAME_POW10[d];
            let pgo_idx = i % bb_count;
            let pgo_cnt = unsafe { *(((block_exec_counts as usize) + (pgo_idx << 3)) as *const u64) };
            if pgo_cnt > 0u64 {
                mult = pgo_cnt;
            }
            if (unsafe { (*up).fixed_reg }) != REG_NONE {
                mult = mult << 2;
            }
            weighted_uses = weighted_uses + (mult * 1000u64);
            cur_p = cur_p + up_sz;
            i = i + 1;
        }
    }
    let span = (iv.end - iv.start) as u64;
    let mut weight = weighted_uses / (if span == 0u64 { 1u64 } else { span });
    if iv.remat_kind != X64_REMAT_NONE {
        weight = weight >> 1;
    }
    if weight == 0u64 {
        weight = 1u64;
    }
    weight
}

pub fn x64_intervals_overlap(a: view<X64LiveInterval>, b: view<X64LiveInterval>) -> bool {
    if a.end <= b.start || b.end <= a.start {
        return false;
    }
    let ac = a.range_count;
    let bc = b.range_count;
    if ac == 0u32 || bc == 0u32 {
        return true;
    }
    let a_base = a.ranges as usize;
    let b_base = b.ranges as usize;
    let a_end = a_base + ((ac as usize) << 3);
    let b_end = b_base + ((bc as usize) << 3);
    let mut ap = a_base;
    while ap < a_end {
        let ra = ap as *const X64LiveRange;
        let as0 = unsafe { (*ra).start };
        let ae0 = unsafe { (*ra).end };
        let mut bp = b_base;
        while bp < b_end {
            let rb = bp as *const X64LiveRange;
            let bs0 = unsafe { (*rb).start };
            let be0 = unsafe { (*rb).end };
            if as0 < be0 && bs0 < ae0 {
                return true;
            }
            bp = bp + 8;
        }
        ap = ap + 8;
    }
    false
}

// =============================================================================
// 4. Stack-Slot Lifetime Coloring (SPEC-77 §3.6, AXS-RA-023, REQ-OPT-204)
// =============================================================================

@derive(Copy)
pub struct X64ColoredSpillSlot {
    pub size: u32,
    pub align: u32,
    pub rbp_offset: i32,
    pub range_count: u32,
    pub range_cap: u32,
    pub last_end: u32,
    pub ranges: *mut X64LiveRange,
}

@derive(Copy)
pub struct X64StackSlotAllocator {
    pub slots: *mut X64ColoredSpillSlot,
    pub slot_count: u32,
    pub slot_cap: u32,
}

pub unsafe fn x64_colored_slot_at(base: *mut X64ColoredSpillSlot, idx: usize) -> *mut X64ColoredSpillSlot {
    ((base as usize) + (idx * size_of<X64ColoredSpillSlot>())) as *mut X64ColoredSpillSlot
}

fn colored_slot_overlaps_interval(slot: view<X64ColoredSpillSlot>, iv: view<X64LiveInterval>) -> bool {
    let sc = slot.range_count;
    if sc == 0u32 || iv.end <= iv.start || slot.last_end <= iv.start {
        return false;
    }
    let s_base = slot.ranges as usize;
    let s_end = s_base + ((sc as usize) << 3);
    let ic = iv.range_count;
    let i_base = iv.ranges as usize;
    let i_end = i_base + ((ic as usize) << 3);
    let mut sp = s_base;
    while sp < s_end {
        let sr = sp as *const X64LiveRange;
        let ss = unsafe { (*sr).start };
        let se = unsafe { (*sr).end };
        if se > iv.start && ss < iv.end {
            if ic == 0u32 {
                return true;
            }
            let mut ip = i_base;
            while ip < i_end {
                let ir = ip as *const X64LiveRange;
                let is0 = unsafe { (*ir).start };
                let ie0 = unsafe { (*ir).end };
                if is0 < se && ss < ie0 {
                    return true;
                }
                ip = ip + 8;
            }
        }
        sp = sp + 8;
    }
    false
}

fn colored_slot_add_range(
    arena: mut_view<Arena>,
    slot: mut_view<X64ColoredSpillSlot>,
    start: u32,
    end: u32
) {
    let rc = slot.range_count;
    if rc > 0u32 && (slot.ranges as usize) != 0 {
        let last_p = (((slot.ranges as usize) + (((rc - 1u32) as usize) << 3)) as *mut X64LiveRange);
        let ls = unsafe { (*last_p).start };
        let le = unsafe { (*last_p).end };
        if start <= le && end >= ls {
            unsafe {
                if start < ls { (*last_p).start = start; }
                if end > le { (*last_p).end = end; }
            }
            if end > slot.last_end {
                slot.last_end = end;
            }
            return;
        }
    }
    if rc >= slot.range_cap {
        let new_cap = if slot.range_cap == 0u32 { 4u32 } else { slot.range_cap << 1 };
        let new_buf = arena_alloc_raw(mut_view(*arena), (new_cap as usize) << 3, 4) as *mut X64LiveRange;
        if (slot.ranges as usize) != 0 && rc > 0u32 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(slot.ranges as *const u8, new_buf as *mut u8, (rc as usize) << 3);
            }
        }
        slot.ranges = new_buf;
        slot.range_cap = new_cap;
    }
    let rp = (((slot.ranges as usize) + ((rc as usize) << 3)) as *mut X64LiveRange);
    unsafe {
        (*rp).start = start;
        (*rp).end = end;
    }
    slot.range_count = rc + 1u32;
    if end > slot.last_end {
        slot.last_end = end;
    }
}

pub fn x64_stack_slot_alloc_for_interval(
    arena: mut_view<Arena>,
    alloc: mut_view<X64StackSlotAllocator>,
    iv: view<X64LiveInterval>,
    size: u32,
    align: u32
) -> u32 {
    let norm_size = if size < 8u32 { 8u32 } else { size };
    let norm_align = if align < 8u32 { 8u32 } else { align };

    // Reuse an existing colored spill slot if sizes/alignments match and live intervals are disjoint.
    let slot_stride = size_of<X64ColoredSpillSlot>();
    let mut s: u32 = 0u32;
    let mut sp_addr: usize = alloc.slots as usize;
    while s < alloc.slot_count {
        let sp = sp_addr as *mut X64ColoredSpillSlot;
        if (unsafe { (*sp).size }) == norm_size && (unsafe { (*sp).align }) == norm_align {
            if !(unsafe { colored_slot_overlaps_interval(view(*sp), iv) }) {
                if iv.range_count == 0u32 {
                    unsafe {
                        colored_slot_add_range(mut_view(*arena), mut_view(*sp), iv.start, iv.end);
                    }
                } else {
                    let mut r: u32 = 0u32;
                    let mut ir_addr: usize = iv.ranges as usize;
                    while r < iv.range_count {
                        let ir = ir_addr as *const X64LiveRange;
                        unsafe {
                            colored_slot_add_range(mut_view(*arena), mut_view(*sp), (*ir).start, (*ir).end);
                        }
                        ir_addr = ir_addr + 8;
                        r = r + 1u32;
                    }
                }
                return s;
            }
        }
        sp_addr = sp_addr + slot_stride;
        s = s + 1u32;
    }

    // Otherwise allocate a new colored spill slot.
    if alloc.slot_count >= alloc.slot_cap {
        let new_cap = if alloc.slot_cap == 0u32 { 8u32 } else { alloc.slot_cap << 1 };
        let new_bytes = (new_cap as usize) * slot_stride;
        let new_align = align_of<X64ColoredSpillSlot>();
        let new_buf = arena_alloc_raw(mut_view(*arena), new_bytes, new_align) as *mut X64ColoredSpillSlot;
        if (alloc.slots as usize) != 0 && alloc.slot_count > 0u32 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(alloc.slots as *const u8, new_buf as *mut u8, (alloc.slot_count as usize) * slot_stride);
            }
        }
        alloc.slots = new_buf;
        alloc.slot_cap = new_cap;
    }

    let new_idx = alloc.slot_count;
    let np = ((alloc.slots as usize) + ((new_idx as usize) * slot_stride)) as *mut X64ColoredSpillSlot;
    unsafe {
        (*np).size = norm_size;
        (*np).align = norm_align;
        (*np).rbp_offset = 0;
        (*np).range_count = 0u32;
        (*np).range_cap = 0u32;
        (*np).last_end = 0u32;
        (*np).ranges = 0 as *mut X64LiveRange;
        if iv.range_count == 0u32 {
            colored_slot_add_range(mut_view(*arena), mut_view(*np), iv.start, iv.end);
        } else {
            let mut r: u32 = 0u32;
            let mut ir_addr: usize = iv.ranges as usize;
            while r < iv.range_count {
                let ir = ir_addr as *const X64LiveRange;
                colored_slot_add_range(mut_view(*arena), mut_view(*np), (*ir).start, (*ir).end);
                ir_addr = ir_addr + 8;
                r = r + 1u32;
            }
        }
    }
    alloc.slot_count = new_idx + 1u32;
    new_idx
}

// =============================================================================
// 5. Parallel-Copy Cycle Breaking (SPEC-77 §3.3, AXS-RA-020, REQ-OPT-203)
// =============================================================================

@derive(Copy)
pub struct X64ParallelCopy {
    pub dst_reg: i32,
    pub src_reg: i32,
    pub size: u8,
}

pub unsafe fn x64_parallel_copy_at(base: *mut X64ParallelCopy, idx: usize) -> *mut X64ParallelCopy {
    ((base as usize) + (idx * size_of<X64ParallelCopy>())) as *mut X64ParallelCopy
}

// Resolve a set of parallel register-to-register copies (`dst_reg <- src_reg`),
// breaking cycles with `scratch_reg` (`AXS-RA-020`). Returns number of `MOV`s emitted.
pub fn x64_emit_parallel_copies_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    copies: *mut X64ParallelCopy,
    count: usize,
    scratch_reg: i32
) -> u32 {
    if count == 0 || (copies as usize) == 0 {
        return 0u32;
    }
    let work_bytes = lir_mul_usize(count, size_of<X64ParallelCopy>());
    let work = arena_alloc_raw(mut_view(*arena), work_bytes, align_of<X64ParallelCopy>()) as *mut X64ParallelCopy;
    let done = arena_alloc_raw(mut_view(*arena), count, 1) as *mut u8;

    let mut remaining: usize = 0;
    let mut i: usize = 0;
    while i < count {
        let cp = unsafe { x64_parallel_copy_at(copies, i) };
        let wp = unsafe { x64_parallel_copy_at(work, i) };
        let dst = unsafe { (*cp).dst_reg };
        let src = unsafe { (*cp).src_reg };
        let sz = unsafe { (*cp).size };
        unsafe {
            (*wp).dst_reg = dst;
            (*wp).src_reg = src;
            (*wp).size = if sz == 0u8 { 8u8 } else { sz };
            if dst == src || dst == REG_NONE || src == REG_NONE {
                *u8_at_mut(done, i) = 1u8;
            } else {
                *u8_at_mut(done, i) = 0u8;
                remaining = remaining + 1;
            }
        }
        i = i + 1;
    }

    let mut emitted: u32 = 0u32;
    while remaining > 0 {
        let mut progressed = false;
        let mut k: usize = 0;
        while k < count {
            let is_done = unsafe { *u8_at_mut(done, k) };
            if is_done == 0u8 {
                let kp = unsafe { x64_parallel_copy_at(work, k) };
                let dst_k = unsafe { (*kp).dst_reg };
                let src_k = unsafe { (*kp).src_reg };
                let sz_k = unsafe { (*kp).size };

                // Check if `dst_k` is still needed as `src_reg` by any other pending copy.
                let mut dst_busy = false;
                let mut j: usize = 0;
                while j < count && !dst_busy {
                    let j_done = unsafe { *u8_at_mut(done, j) };
                    if j != k && j_done == 0u8 {
                        let jp = unsafe { x64_parallel_copy_at(work, j) };
                        let src_j = unsafe { (*jp).src_reg };
                        if src_j == dst_k {
                            dst_busy = true;
                        }
                    }
                    j = j + 1;
                }

                if !dst_busy {
                    let mi = x64_mi_new(mut_view(*arena), X64_MI_MOV);
                    unsafe {
                        x64_mi_set_size(mut_view(*mi), sz_k);
                        x64_mi_add_op(mut_view(*mi), x64_op_reg(dst_k));
                        x64_mi_add_op(mut_view(*mi), x64_op_reg(src_k));
                        if (mbb.last_inst as usize) != 0 {
                            (*mbb.last_inst).next = mi;
                            mbb.last_inst = mi;
                        } else {
                            mbb.first_inst = mi;
                            mbb.last_inst = mi;
                        }
                        *u8_at_mut(done, k) = 1u8;
                    }
                    remaining = remaining - 1;
                    emitted = emitted + 1u32;
                    progressed = true;
                }
            }
            k = k + 1;
        }

        // All remaining copies form one or more cycles: break a cycle using `scratch_reg`.
        if !progressed && remaining > 0 {
            let mut cyc_idx: usize = 0;
            let mut found_cyc = false;
            while cyc_idx < count && !found_cyc {
                let c_done = unsafe { *u8_at_mut(done, cyc_idx) };
                if c_done == 0u8 {
                    found_cyc = true;
                } else {
                    cyc_idx = cyc_idx + 1;
                }
            }
            if found_cyc {
                let cp = unsafe { x64_parallel_copy_at(work, cyc_idx) };
                let src_c = unsafe { (*cp).src_reg };
                let sz_c = unsafe { (*cp).size };
                let save_mi = x64_mi_new(mut_view(*arena), X64_MI_MOV);
                unsafe {
                    x64_mi_set_size(mut_view(*save_mi), sz_c);
                    x64_mi_add_op(mut_view(*save_mi), x64_op_reg(scratch_reg));
                    x64_mi_add_op(mut_view(*save_mi), x64_op_reg(src_c));
                    if (mbb.last_inst as usize) != 0 {
                        (*mbb.last_inst).next = save_mi;
                        mbb.last_inst = save_mi;
                    } else {
                        mbb.first_inst = save_mi;
                        mbb.last_inst = save_mi;
                    }
                    (*cp).src_reg = scratch_reg;
                }
                emitted = emitted + 1u32;
            }
        }
    }
    emitted
}

// =============================================================================
// 6. Linear-Scan Register Allocation (SPEC-77 §3.2..3.5, AXS-RA-018..022)
// =============================================================================

@derive(Copy)
pub struct X64RegAllocResult {
    pub intervals: *mut X64LiveInterval,
    pub liveness: *mut X64LivenessInfo,
    pub spill_slots: X64StackSlotAllocator,
    pub interval_count: u32,
    pub used_phys_reg_mask: u32,
    pub used_callee_saved_mask: u32,
    pub allocated_vreg_count: u32,
    pub spilled_vreg_count: u32,
    pub remat_vreg_count: u32,
    pub coalesced_copy_count: u32,
    pub pad: u32,
}

fn mi_inst_phys_def_mask(inst: view<X64MI>) -> u32 {
    let opc = inst.opcode;
    if opc == X64_MI_MOV || opc == X64_MI_ADD || opc == X64_MI_SUB ||
       opc == X64_MI_IMUL || opc == X64_MI_AND || opc == X64_MI_OR ||
       opc == X64_MI_XOR || opc == X64_MI_SHL || opc == X64_MI_SAR ||
       opc == X64_MI_SHR || opc == X64_MI_LEA || opc == X64_MI_POP {
        if inst.op_count >= 1u8 && inst.ops[0usize].kind == X64_OP_REG {
            let r = inst.ops[0usize].reg;
            if r >= 0 && r < 32 { return 1u32 << (r as u32); }
        }
        return 0u32;
    }
    if opc == X64_MI_CALL {
        return X64_ALL_CALLER_SAVED_MASK;
    }
    if opc == X64_MI_SETCC || opc == X64_MI_CMOVCC {
        if inst.op_count >= 2u8 && inst.ops[1usize].kind == X64_OP_REG {
            let r = inst.ops[1usize].reg;
            if r >= 0 && r < 32 { return 1u32 << (r as u32); }
        }
        return 0u32;
    }
    if opc == X64_MI_IDIV || opc == X64_MI_MUL {
        return 0x00000005u32; // RAX | RDX
    }
    if opc == X64_MI_XCHG || opc == X64_MI_LOCK_XADD {
        let mut mask: u32 = 0u32;
        if inst.op_count >= 1u8 && inst.ops[0usize].kind == X64_OP_REG {
            let r0 = inst.ops[0usize].reg;
            if r0 >= 0 && r0 < 32 { mask = mask | (1u32 << (r0 as u32)); }
        }
        if inst.op_count >= 2u8 && inst.ops[1usize].kind == X64_OP_REG {
            let r1 = inst.ops[1usize].reg;
            if r1 >= 0 && r1 < 32 { mask = mask | (1u32 << (r1 as u32)); }
        }
        return mask;
    }
    if opc == X64_MI_LOCK_CMPXCHG {
        return 1u32; // RAX
    }
    if opc == X64_MI_ATOMIC_RMW_LOOP {
        return 0x00000101u32; // RAX | R8
    }
    0u32
}

fn mi_op_phys_read_mask_v(op: view<X64Op>) -> u32 {
    if op.kind == X64_OP_REG {
        let r = op.reg;
        if r >= 0 && r < 32 { 1u32 << (r as u32) } else { 0u32 }
    } else if op.kind == X64_OP_MEM {
        let mut m: u32 = 0u32;
        let b = op.mem.base;
        if b != REG_NONE && b != REG_RBP && b != REG_RSP && b >= 0 && b < 32 {
            m = m | (1u32 << (b as u32));
        }
        let ix = op.mem.index;
        if ix != REG_NONE && ix != REG_RBP && ix != REG_RSP && ix >= 0 && ix < 32 {
            m = m | (1u32 << (ix as u32));
        }
        m
    } else {
        0u32
    }
}

fn mi_inst_phys_use_mask(inst: view<X64MI>) -> u32 {
    let opc = inst.opcode;
    let oc = inst.op_count;
    if opc == X64_MI_MOV || opc == X64_MI_LEA {
        let mut mask: u32 = 0u32;
        if oc >= 1u8 && inst.ops[0usize].kind == X64_OP_MEM {
            mask = mi_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        if oc >= 2u8 {
            let k1 = inst.ops[1usize].kind;
            if k1 == X64_OP_REG {
                let r1 = inst.ops[1usize].reg;
                if r1 >= 0 && r1 < 32 { mask = mask | (1u32 << (r1 as u32)); }
            } else if k1 == X64_OP_MEM {
                mask = mask | mi_op_phys_read_mask_v(view(inst.ops[1usize]));
            }
        }
        return mask;
    }
    if opc == X64_MI_CMP || opc == X64_MI_TEST || opc == X64_MI_ADD || opc == X64_MI_SUB ||
       opc == X64_MI_IMUL || opc == X64_MI_AND || opc == X64_MI_OR || opc == X64_MI_XOR ||
       opc == X64_MI_SHL || opc == X64_MI_SAR || opc == X64_MI_SHR || opc == X64_MI_XCHG ||
       opc == X64_MI_LOCK_XADD || opc == X64_MI_LOCK_ADD || opc == X64_MI_LOCK_SUB ||
       opc == X64_MI_LOCK_AND || opc == X64_MI_LOCK_OR || opc == X64_MI_LOCK_XOR ||
       opc == X64_MI_ATOMIC_RMW_LOOP {
        if opc == X64_MI_XOR && oc >= 2u8 &&
           inst.ops[0usize].kind == X64_OP_REG && inst.ops[1usize].kind == X64_OP_REG &&
           inst.ops[0usize].reg == inst.ops[1usize].reg {
            return 0u32;
        }
        let mut mask: u32 = 0u32;
        if oc >= 1u8 {
            mask = mi_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        if oc >= 2u8 {
            mask = mask | mi_op_phys_read_mask_v(view(inst.ops[1usize]));
        }
        return mask;
    }
    if opc == X64_MI_JMP || opc == X64_MI_JCC || opc == X64_MI_SETCC || opc == X64_MI_ASSERT || opc == X64_MI_POP {
        return 0u32;
    }
    if opc == X64_MI_CALL || opc == X64_MI_PUSH {
        if oc >= 1u8 {
            return mi_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        return 0u32;
    }
    if opc == X64_MI_RET {
        return 1u32; // RAX
    }
    if opc == X64_MI_CMOVCC {
        let mut mask: u32 = 0u32;
        if oc >= 2u8 {
            mask = mi_op_phys_read_mask_v(view(inst.ops[1usize]));
        }
        if oc >= 3u8 {
            mask = mask | mi_op_phys_read_mask_v(view(inst.ops[2usize]));
        }
        return mask;
    }
    if opc == X64_MI_IDIV || opc == X64_MI_MUL {
        let mut mask: u32 = 0x00000005u32; // RAX | RDX
        if oc >= 1u8 {
            mask = mask | mi_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        return mask;
    }
    if opc == X64_MI_LOCK_CMPXCHG {
        let mut mask: u32 = 1u32; // RAX
        if oc >= 1u8 {
            mask = mask | mi_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        if oc >= 2u8 {
            mask = mask | mi_op_phys_read_mask_v(view(inst.ops[1usize]));
        }
        return mask;
    }
    0u32
}

// Check if `REG_RAX` is dead immediately after `inst` within the same basic block.
fn mi_rax_dead_after(inst: *mut X64MI) -> bool {
    let mut curr: *mut X64MI = unsafe { (*inst).next };
    while (curr as usize) != 0 {
        let u_mask: u32 = unsafe { mi_inst_phys_use_mask(view(*curr)) };
        if (u_mask & 1u32) != 0u32 {
            return false;
        }
        let d_mask: u32 = unsafe { mi_inst_phys_def_mask(view(*curr)) };
        let opc: u32 = unsafe { (*curr).opcode };
        if (d_mask & 1u32) != 0u32 && opc != X64_MI_SETCC {
            return true;
        }
        if opc == X64_MI_JMP {
            return true;
        }
        curr = unsafe { (*curr).next };
    }
    true
}

// Preferred allocation order:
//   1. Non-RAX caller-saved GPRs (`R11, R10, R9, R8, RDX, RCX`) when `!crosses_call`
//   2. Callee-saved GPRs (`RBX, RSI, RDI, R12, R13, R14, R15`)
//   3. `RAX` (last resort among GPRs since isel uses RAX heavily as primary scratch)
const GPR_PREF_CALLER_ORDER: [7]i32 = [11, 10, 9, 8, 2, 1, 0];
const GPR_PREF_CALLEE_ORDER: [7]i32 = [3, 6, 7, 12, 13, 14, 15];

fn pick_best_reg(
    avail_mask: u32,
    reg_class: u8,
    crosses_call: bool,
    hint_reg: i32,
    used_callee_saved_mask: u32
) -> i32 {
    if avail_mask == 0u32 {
        return REG_NONE;
    }
    if hint_reg >= 0 && hint_reg < 32 && (avail_mask & (1u32 << (hint_reg as u32))) != 0u32 {
        return hint_reg;
    }
    if reg_class == REG_CLASS_GPR {
        if !crosses_call {
            let mut i: usize = 0;
            while i < 6 {
                let r = GPR_PREF_CALLER_ORDER[i];
                if (avail_mask & (1u32 << (r as u32))) != 0u32 {
                    return r;
                }
                i = i + 1;
            }
        }
        // Prefer an already-saved callee-saved GPR before touching a new callee-saved GPR.
        let reused_callee = avail_mask & used_callee_saved_mask;
        if reused_callee != 0u32 {
            let mut j: usize = 0;
            while j < 7 {
                let r = GPR_PREF_CALLEE_ORDER[j];
                if (reused_callee & (1u32 << (r as u32))) != 0u32 {
                    return r;
                }
                j = j + 1;
            }
        }
        let mut k: usize = 0;
        while k < 7 {
            let r = GPR_PREF_CALLEE_ORDER[k];
            if (avail_mask & (1u32 << (r as u32))) != 0u32 {
                return r;
            }
            k = k + 1;
        }
    } else {
        // XMM / Vector register selection (`REG_XMM0`..`REG_XMM15`).
        if !crosses_call {
            let mut x: i32 = REG_XMM0;
            while x <= REG_XMM5 {
                if (avail_mask & (1u32 << (x as u32))) != 0u32 {
                    return x;
                }
                x = x + 1;
            }
        }
        let reused_xmm = avail_mask & used_callee_saved_mask;
        if reused_xmm != 0u32 {
            let mut y: i32 = REG_XMM6;
            while y <= REG_XMM15 {
                if (reused_xmm & (1u32 << (y as u32))) != 0u32 {
                    return y;
                }
                y = y + 1;
            }
        }
        let mut z: i32 = REG_XMM6;
        while z <= REG_XMM15 {
            if (avail_mask & (1u32 << (z as u32))) != 0u32 {
                return z;
            }
            z = z + 1;
        }
    }
    REG_NONE
}

fn rewrite_allocated_and_remat_ops(
    body: mut_view<X64MIBody>,
    intervals: *mut X64LiveInterval,
    vreg_count: usize,
    slot_offset: u32,
    remat_in_place: *mut u8
) {
    let iv_stride = size_of<X64LiveInterval>();
    let iv_base = intervals as usize;
    let remat_base = remat_in_place as usize;
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut prev: *mut X64MI = 0 as *mut X64MI;
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let next_inst = unsafe { (*inst).next };
            let opc = unsafe { (*inst).opcode };
            let op_cnt = unsafe { (*inst).op_count };
            let mut unlink_this = false;

            // Rewrite any operand referencing an allocated or in-place rematerialized vreg.
            let mut i: u8 = 0u8;
            while i < op_cnt {
                let iu = i as usize;
                if (unsafe { (*inst).ops[iu].kind }) == X64_OP_FRAME {
                    let sid = unsafe { (*inst).ops[iu].frame.slot_id };
                    if sid >= slot_offset && (unsafe { (*inst).ops[iu].frame.offset }) == 0 {
                        let v = (sid - slot_offset) as usize;
                        if v < vreg_count {
                            let iv = (iv_base + (v * iv_stride)) as *mut X64LiveInterval;
                            let reg = unsafe { (*iv).assigned_reg };
                            if reg != REG_NONE {
                                unsafe {
                                    (*inst).ops[iu].kind = X64_OP_REG;
                                    (*inst).ops[iu].reg = reg;
                                }
                            } else if (unsafe { *((remat_base + v) as *mut u8) }) != 0u8 {
                                if i == 0u8 && opc == X64_MI_MOV {
                                    // Store to an in-place rematerialized vreg is dead: unlink it.
                                    unlink_this = true;
                                } else if i == 1u8 && opc == X64_MI_MOV {
                                    let rk = unsafe { (*iv).remat_kind };
                                    if rk == X64_REMAT_CONST {
                                        unsafe {
                                            (*inst).ops[1usize].kind = X64_OP_IMM;
                                            (*inst).ops[1usize].imm = (*iv).remat_imm;
                                        }
                                    } else if rk == X64_REMAT_STACK_ADDR {
                                        let rslot = unsafe { (*iv).remat_slot };
                                        unsafe {
                                            (*inst).opcode = X64_MI_LEA;
                                            (*inst).ops[1usize].kind = X64_OP_FRAME;
                                            (*inst).ops[1usize].frame.slot_id = rslot;
                                            (*inst).ops[1usize].frame.offset = 0;
                                            (*inst).ops[1usize].slot_id = rslot;
                                            (*inst).ops[1usize].offset = 0;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                i = i + 1u8;
            }

            // Also unlink 64-bit self-moves `mov r, r`.
            if !unlink_this && opc == X64_MI_MOV {
                let sz = unsafe { (*inst).size };
                if (sz == 8u8 || sz == 0u8) &&
                   (unsafe { (*inst).ops[0usize].kind }) == X64_OP_REG &&
                   (unsafe { (*inst).ops[1usize].kind }) == X64_OP_REG &&
                   (unsafe { (*inst).ops[0usize].reg }) == (unsafe { (*inst).ops[1usize].reg }) {
                    unlink_this = true;
                }
            }

            if unlink_this {
                unsafe {
                    if (prev as usize) != 0 {
                        (*prev).next = next_inst;
                    } else {
                        (*mbb).first_inst = next_inst;
                    }
                    if ((*mbb).last_inst as usize) == (inst as usize) {
                        (*mbb).last_inst = prev;
                    }
                }
            } else {
                prev = inst;
            }
            inst = next_inst;
        }
        b = b + 1;
    }
}

// Local peephole pass after register allocation to fold redundant scratch `RAX` moves (`SPEC-77 §3.3`).
fn peephole_fold_allocated_moves(body: mut_view<X64MIBody>) {
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut m0: *mut X64MI = unsafe { (*mbb).first_inst };
        while (m0 as usize) != 0 {
            let m1: *mut X64MI = unsafe { (*m0).next };
            if (m1 as usize) != 0 {
                let opc0: u32 = unsafe { (*m0).opcode };
                if (opc0 == X64_MI_MOV || opc0 == X64_MI_LEA || opc0 == X64_MI_XOR) &&
                   (unsafe { (*m0).ops[0usize].kind }) == X64_OP_REG &&
                   (unsafe { (*m0).ops[0usize].reg }) == REG_RAX {
                    let sz0: u8 = unsafe { (*m0).size };
                    if sz0 == 8u8 || sz0 == 0u8 {
                        let opc1: u32 = unsafe { (*m1).opcode };
                        let sz1: u8 = unsafe { (*m1).size };
                        let mut folded = false;

                        if sz1 == 8u8 || sz1 == 0u8 {
                            // Pattern A: `mov/lea rax, src; mov r_dst, rax` -> `mov/lea r_dst, src` (when RAX is dead after m1).
                            if (opc0 == X64_MI_MOV || opc0 == X64_MI_LEA) && opc1 == X64_MI_MOV &&
                               (unsafe { (*m1).ops[0usize].kind }) == X64_OP_REG &&
                               x64_reg_is_gpr(unsafe { (*m1).ops[0usize].reg }) &&
                               (unsafe { (*m1).ops[1usize].kind }) == X64_OP_REG &&
                               (unsafe { (*m1).ops[1usize].reg }) == REG_RAX &&
                               mi_rax_dead_after(m1) {
                                let dst_r = unsafe { (*m1).ops[0usize].reg };
                                let next_after_m1 = unsafe { (*m1).next };
                                unsafe {
                                    (*m0).ops[0usize].kind = X64_OP_REG;
                                    (*m0).ops[0usize].reg = dst_r;
                                    (*m0).next = next_after_m1;
                                    if ((*mbb).last_inst as usize) == (m1 as usize) {
                                        (*mbb).last_inst = m0;
                                    }
                                }
                                folded = true;
                            }

                            // Pattern A2: `xor rax, rax; mov r_dst, rax` -> `xor r_dst, r_dst` (when RAX is dead after m1).
                            if !folded && opc0 == X64_MI_XOR && opc1 == X64_MI_MOV &&
                               (unsafe { (*m0).ops[1usize].kind }) == X64_OP_REG &&
                               (unsafe { (*m0).ops[1usize].reg }) == REG_RAX &&
                               (unsafe { (*m1).ops[0usize].kind }) == X64_OP_REG &&
                               x64_reg_is_gpr(unsafe { (*m1).ops[0usize].reg }) &&
                               (unsafe { (*m1).ops[1usize].kind }) == X64_OP_REG &&
                               (unsafe { (*m1).ops[1usize].reg }) == REG_RAX &&
                               mi_rax_dead_after(m1) {
                                let dst_r = unsafe { (*m1).ops[0usize].reg };
                                let next_after_m1 = unsafe { (*m1).next };
                                unsafe {
                                    (*m0).ops[0usize].kind = X64_OP_REG;
                                    (*m0).ops[0usize].reg = dst_r;
                                    (*m0).ops[1usize].kind = X64_OP_REG;
                                    (*m0).ops[1usize].reg = dst_r;
                                    (*m0).next = next_after_m1;
                                    if ((*mbb).last_inst as usize) == (m1 as usize) {
                                        (*mbb).last_inst = m0;
                                    }
                                }
                                folded = true;
                            }

                            // Pattern B: `mov rax, r_lhs; cmp rax, op2` -> `cmp r_lhs, op2` (when RAX is dead after m1).
                            if !folded && opc0 == X64_MI_MOV && opc1 == X64_MI_CMP &&
                               (unsafe { (*m0).ops[1usize].kind }) == X64_OP_REG &&
                               x64_reg_is_gpr(unsafe { (*m0).ops[1usize].reg }) &&
                               (unsafe { (*m1).ops[0usize].kind }) == X64_OP_REG &&
                               (unsafe { (*m1).ops[0usize].reg }) == REG_RAX &&
                               (mi_op_phys_read_mask_v(unsafe { view((*m1).ops[1usize]) }) & 1u32) == 0u32 &&
                               mi_rax_dead_after(m1) {
                                let lhs_r = unsafe { (*m0).ops[1usize].reg };
                                let next_after_m1 = unsafe { (*m1).next };
                                unsafe {
                                    (*m0).opcode = X64_MI_CMP;
                                    (*m0).ops[0usize].kind = X64_OP_REG;
                                    (*m0).ops[0usize].reg = lhs_r;
                                    (*m0).ops[1usize] = (*m1).ops[1usize];
                                    (*m0).next = next_after_m1;
                                    if ((*mbb).last_inst as usize) == (m1 as usize) {
                                        (*mbb).last_inst = m0;
                                    }
                                }
                                folded = true;
                            }

                            // Pattern C: `mov rax, r_lhs; <alu> rax, op2; mov r_dst, rax` (when RAX is dead after m2).
                            if !folded && opc0 == X64_MI_MOV &&
                               (opc1 == X64_MI_ADD || opc1 == X64_MI_SUB || opc1 == X64_MI_AND ||
                                opc1 == X64_MI_OR || opc1 == X64_MI_XOR || opc1 == X64_MI_IMUL) &&
                               (unsafe { (*m0).ops[1usize].kind }) == X64_OP_REG &&
                               x64_reg_is_gpr(unsafe { (*m0).ops[1usize].reg }) &&
                               (unsafe { (*m1).ops[0usize].kind }) == X64_OP_REG &&
                               (unsafe { (*m1).ops[0usize].reg }) == REG_RAX {
                                let m2: *mut X64MI = unsafe { (*m1).next };
                                if (m2 as usize) != 0 &&
                                   (unsafe { (*m2).opcode }) == X64_MI_MOV &&
                                   (mi_op_phys_read_mask_v(unsafe { view((*m1).ops[1usize]) }) & 1u32) == 0u32 {
                                    let sz2: u8 = unsafe { (*m2).size };
                                    if (sz2 == 8u8 || sz2 == 0u8) &&
                                       (unsafe { (*m2).ops[0usize].kind }) == X64_OP_REG &&
                                       (unsafe { (*m2).ops[0usize].reg }) == (unsafe { (*m0).ops[1usize].reg }) &&
                                       (unsafe { (*m2).ops[1usize].kind }) == X64_OP_REG &&
                                       (unsafe { (*m2).ops[1usize].reg }) == REG_RAX &&
                                       mi_rax_dead_after(m2) {
                                        let r_dst = unsafe { (*m2).ops[0usize].reg };
                                        let next_after_m2 = unsafe { (*m2).next };
                                        unsafe {
                                            (*m0).opcode = opc1;
                                            (*m0).ops[0usize].kind = X64_OP_REG;
                                            (*m0).ops[0usize].reg = r_dst;
                                            (*m0).ops[1usize] = (*m1).ops[1usize];
                                            (*m0).next = next_after_m2;
                                            if ((*mbb).last_inst as usize) == (m2 as usize) {
                                                (*mbb).last_inst = m0;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            m0 = unsafe { (*m0).next };
        }
        b = b + 1;
    }
}

pub fn x64_regalloc_with_pgo_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    block_exec_counts: *const u64
) -> X64RegAllocResult {
    let liveness_val = x64_compute_liveness_in_arena(mut_view(*arena), lir, view(*body));
    let liv_sz = size_of<X64LivenessInfo>();
    let liv_al = align_of<X64LivenessInfo>();
    let liveness_ptr = arena_alloc_raw(mut_view(*arena), liv_sz, liv_al) as *mut X64LivenessInfo;
    unsafe {
        *liveness_ptr = liveness_val;
    }

    let vreg_count = lir.vreg_count;
    let slot_offset = lir.slot_count as u32;
    let iv_stride = size_of<X64LiveInterval>();
    let mut intervals: *mut X64LiveInterval = 0 as *mut X64LiveInterval;
    if vreg_count > 0 {
        let iv_bytes = vreg_count * iv_stride;
        intervals = arena_alloc_raw(mut_view(*arena), iv_bytes, align_of<X64LiveInterval>()) as *mut X64LiveInterval;
        let vr_stride = size_of<LirVReg>();
        let mut vr_addr: usize = lir.vregs as usize;
        let mut iv_addr: usize = intervals as usize;
        let mut prev_ty_v: u32 = 0xFFFFFFFFu32;
        let mut prev_rclass: u8 = REG_CLASS_GPR;
        let mut prev_vsize: u32 = 0u32;
        let mut v: usize = 0;
        while v < vreg_count {
            let vty_v: u32 = unsafe { (*(vr_addr as *const LirVReg)).ty.v };
            let rclass: u8 = if vty_v == prev_ty_v {
                prev_rclass
            } else {
                let mut rc_tmp: u8 = REG_CLASS_GPR;
                prev_vsize = x64_cached_type_size_and_rc(TypeId { v: vty_v }, interner, mut_view(rc_tmp));
                prev_rclass = rc_tmp;
                prev_ty_v = vty_v;
                rc_tmp
            };
            let vsize: u32 = prev_vsize;
            let iv = iv_addr as *mut X64LiveInterval;
            unsafe {
                (*iv).vreg = v as u32;
                (*iv).reg_class = rclass;
                (*iv).remat_kind = X64_REMAT_NONE;
                (*iv).crosses_call = false;
                (*iv).is_spilled = false;
                (*iv).must_stack = vsize > 8u32 && rclass == REG_CLASS_GPR;
                (*iv).assigned_reg = REG_NONE;
                (*iv).spill_slot = -1;
                (*iv).start = 0xFFFFFFFFu32;
                (*iv).end = 0u32;
                (*iv).ranges = 0 as *mut X64LiveRange;
                (*iv).range_count = 0u32;
                (*iv).range_cap = 0u32;
                (*iv).uses = 0 as *mut X64UsePos;
                (*iv).use_count = 0u32;
                (*iv).use_cap = 0u32;
                (*iv).spill_weight = 0u64;
                (*iv).remat_imm = 0i64;
                (*iv).remat_slot = LIR_VREG_NONE;
                (*iv).copy_hint_vreg = LIR_VREG_NONE;
                (*iv).fixed_reg_hint = REG_NONE;
                (*iv).forbidden_reg_mask = 0u32;
            }
            vr_addr = vr_addr + vr_stride;
            iv_addr = iv_addr + iv_stride;
            v = v + 1;
        }
    }

    let mut spill_alloc = X64StackSlotAllocator {
        slots: 0 as *mut X64ColoredSpillSlot,
        slot_count: 0u32,
        slot_cap: 0u32,
    };

    if vreg_count == 0 || body.bb_count == 0 {
        return X64RegAllocResult {
            intervals: intervals,
            liveness: liveness_ptr,
            spill_slots: spill_alloc,
            interval_count: vreg_count as u32,
            used_phys_reg_mask: 0u32,
            used_callee_saved_mask: 0u32,
            allocated_vreg_count: 0u32,
            spilled_vreg_count: 0u32,
            remat_vreg_count: 0u32,
            coalesced_copy_count: 0u32,
            pad: 0u32,
        };
    }

    let iv_base = intervals as usize;

    // Scan LIR instructions to record rematerialization candidates and copy/fixed-reg hints.
    let vreg_u32_bytes = vreg_count << 2;
    let def_counts = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, 4) as *mut u32;
    let non_mov_use = arena_alloc_raw(mut_view(*arena), vreg_count, 1) as *mut u8;
    let first_def_pos = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, 4) as *mut u32;
    let last_use_pos = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, 4) as *mut u32;
    let live_list = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, 4) as *mut u32;
    let live_pos = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, 4) as *mut u32;
    let enter_step = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, 4) as *mut u32;
    let mut vc: usize = 0;
    while vc < vreg_count {
        let off4 = vc << 2;
        unsafe {
            *(((def_counts as usize) + off4) as *mut u32) = 0u32;
            *(((non_mov_use as usize) + vc) as *mut u8) = 0u8;
            *(((first_def_pos as usize) + off4) as *mut u32) = 0xFFFFFFFFu32;
            *(((last_use_pos as usize) + off4) as *mut u32) = 0u32;
            *(((live_pos as usize) + off4) as *mut u32) = 0xFFFFFFFFu32;
        }
        vc = vc + 1;
    }

    let mut s0_ret_in_mem = false;
    if lir.slot_count > 0 && (lir.slots as usize) != 0 {
        let sp0 = unsafe { lir_slot_at(lir.slots, 0) };
        let s0_sz = x64_cached_type_size(unsafe { TypeId { v: (*sp0).ty.v } }, interner);
        if s0_sz > 8u32 || (s0_sz != 1u32 && s0_sz != 2u32 && s0_sz != 4u32 && s0_sz != 8u32 && s0_sz != 0u32) {
            s0_ret_in_mem = true;
        }
    }

    let linst_stride = size_of<LirInst>();
    let mut lb: usize = 0;
    while lb < lir.bb_count {
        let lbb = unsafe { lir_bb_at(lir.bbs, lb) };
        let ic = unsafe { (*lbb).inst_count };
        let mut linst_addr = unsafe { (*lbb).insts as usize };
        let linst_end = linst_addr + (ic * linst_stride);
        while linst_addr < linst_end {
            let linst = linst_addr as *const LirInst;
            let lkind = unsafe { (*linst).kind };
            let d_v = unsafe { (*linst).dest.v };

            if lkind == LIR_INST_ATOMIC_CAS {
                let cas_ok_v = unsafe { (*linst).cas_ok.v };
                if cas_ok_v != LIR_VREG_NONE && (cas_ok_v as usize) < vreg_count {
                    let ck_idx = cas_ok_v as usize;
                    let dp = ((def_counts as usize) + (ck_idx << 2)) as *mut u32;
                    let prev_ck = unsafe { *dp };
                    unsafe { *dp = prev_ck + 1u32; }
                    if prev_ck > 0u32 {
                        let ck_iv = (iv_base + (ck_idx * iv_stride)) as *mut X64LiveInterval;
                        unsafe {
                            (*ck_iv).remat_kind = X64_REMAT_NONE;
                            (*ck_iv).must_stack = true;
                        }
                    }
                }
            }

            if d_v != LIR_VREG_NONE && (d_v as usize) < vreg_count {
                let dv_idx = d_v as usize;
                let dp = ((def_counts as usize) + (dv_idx << 2)) as *mut u32;
                let prev_defs = unsafe { *dp };
                unsafe { *dp = prev_defs + 1u32; }
                let iv = (iv_base + (dv_idx * iv_stride)) as *mut X64LiveInterval;
                if prev_defs == 0u32 {
                    if lkind == LIR_INST_CONST {
                        unsafe {
                            (*iv).remat_kind = X64_REMAT_CONST;
                            (*iv).remat_imm = (*linst).const_val as i64;
                        }
                    } else if lkind == LIR_INST_STACK_ADDR {
                        let sl = unsafe { (*linst).slot.v };
                        if !(sl == 0u32 && s0_ret_in_mem) {
                            unsafe {
                                (*iv).remat_kind = X64_REMAT_STACK_ADDR;
                                (*iv).remat_slot = sl;
                            }
                        }
                    } else if lkind == LIR_INST_ADD || lkind == LIR_INST_SUB ||
                              lkind == LIR_INST_BIT_AND || lkind == LIR_INST_BIT_OR ||
                              lkind == LIR_INST_BIT_XOR || lkind == LIR_INST_MUL {
                        let lhs_v = unsafe { (*linst).lhs.v };
                        if lhs_v != LIR_VREG_NONE && (lhs_v as usize) < vreg_count {
                            unsafe { (*iv).copy_hint_vreg = lhs_v; }
                        }
                    } else if lkind == LIR_INST_ABI_ARG || lkind == LIR_INST_ABI_RESULT {
                        let lk = unsafe { (*linst).loc_kind };
                        let lro = unsafe { (*linst).loc_reg_or_offset };
                        if lk == ABI_LOC_REG && lro < 16u32 {
                            unsafe { (*iv).fixed_reg_hint = lro as i32; }
                        } else if lk == ABI_LOC_INDIRECT {
                            unsafe { (*iv).must_stack = true; }
                        }
                    }
                } else {
                    unsafe {
                        (*iv).remat_kind = X64_REMAT_NONE;
                        (*iv).must_stack = true;
                    }
                }
            }
            if lkind == LIR_INST_SHL || lkind == LIR_INST_SHR || lkind == LIR_INST_SAR {
                let rhs_v = unsafe { (*linst).rhs.v };
                if rhs_v != LIR_VREG_NONE && (rhs_v as usize) < vreg_count {
                    let riv = (iv_base + ((rhs_v as usize) * iv_stride)) as *mut X64LiveInterval;
                    unsafe { (*riv).fixed_reg_hint = REG_RCX; }
                }
            } else if lkind == LIR_INST_ABI_ARG && d_v == LIR_VREG_NONE {
                let val_v = unsafe { (*linst).val.v };
                if val_v != LIR_VREG_NONE && (val_v as usize) < vreg_count {
                    let lk = unsafe { (*linst).loc_kind };
                    let lro = unsafe { (*linst).loc_reg_or_offset };
                    let viv = (iv_base + ((val_v as usize) * iv_stride)) as *mut X64LiveInterval;
                    if lk == ABI_LOC_REG && lro < 16u32 {
                        unsafe { (*viv).fixed_reg_hint = lro as i32; }
                    } else if lk == ABI_LOC_INDIRECT {
                        unsafe { (*viv).must_stack = true; }
                    }
                }
            }
            linst_addr = linst_addr + linst_stride;
        }
        lb = lb + 1;
    }

    let words_per_bb = liveness_val.words_per_bb as usize;
    let row_bytes = words_per_bb << 3;
    let touched_bits = bitset_alloc_zeroed(mut_view(*arena), words_per_bb);
    let up_stride = size_of<X64UsePos>();

    let mut mi_buf_cap: usize = 0;
    let mut mi_ptrs: *mut *mut X64MI = 0 as *mut *mut X64MI;
    let mut p_def: *mut u32 = 0 as *mut u32;
    let mut p_use: *mut u32 = 0 as *mut u32;
    let mut v_def: *mut u32 = 0 as *mut u32;
    let mut v_use: *mut u32 = 0 as *mut u32;

    let mut bit_last_step: [32]u32 = [0u32; 32];

    // Per-block analysis: walk MI instructions to record def/use positions, live ranges,
    // `must_stack` constraints, and exact physical-register interference masks.
    let mut global_mi_base: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let first_inst = unsafe { (*mbb).first_inst };
        let bb_start = if b < (liveness_val.bb_count as usize) {
            unsafe { *(((liveness_val.bb_bounds as usize) + (b << 3)) as *mut u32) }
        } else { 0u32 };
        let bb_end = if b < (liveness_val.bb_count as usize) {
            unsafe { *(((liveness_val.bb_bounds as usize) + (b << 3) + 4) as *mut u32) }
        } else { 0u32 };
        let depth = if b < (liveness_val.bb_count as usize) {
            unsafe { *(((liveness_val.loop_depth as usize) + (b << 2)) as *mut u32) }
        } else { 0u32 };
        let depth_u8 = if depth > 9u32 { 9u8 } else { depth as u8 };

        let mut block_mi_cnt: usize = 0;
        if (first_inst as usize) != 0 {
            if b < (liveness_val.bb_count as usize) {
                block_mi_cnt = ((bb_end - bb_start) >> 1) as usize;
            } else {
                let mut scan_inst = first_inst;
                while (scan_inst as usize) != 0 {
                    block_mi_cnt = block_mi_cnt + 1;
                    scan_inst = unsafe { (*scan_inst).next };
                }
            }
        }

        if block_mi_cnt > 0 {
            if block_mi_cnt > mi_buf_cap {
                let mut new_cap: usize = if mi_buf_cap == 0 { 64 } else { mi_buf_cap };
                while new_cap < block_mi_cnt {
                    new_cap = new_cap << 1;
                }
                mi_ptrs = arena_alloc_raw(mut_view(*arena), new_cap << 3, 8) as *mut *mut X64MI;
                p_def = arena_alloc_raw(mut_view(*arena), new_cap << 2, 4) as *mut u32;
                p_use = arena_alloc_raw(mut_view(*arena), new_cap << 2, 4) as *mut u32;
                v_def = arena_alloc_raw(mut_view(*arena), new_cap << 2, 4) as *mut u32;
                v_use = arena_alloc_raw(mut_view(*arena), new_cap << 2, 4) as *mut u32;
                mi_buf_cap = new_cap;
            }

            let abi_arg_reg_mask: u32 = 0x00000306u32; // RCX | RDX | R8 | R9
            let mut pending_call_args: u32 = 0u32;
            let mut m: usize = 0;
            let mut cur = first_inst;
            while m < block_mi_cnt {
                unsafe {
                    *(((mi_ptrs as usize) + (m << 3)) as *mut *mut X64MI) = cur;
                }
                let opc = unsafe { (*cur).opcode };
                let sz = unsafe { (*cur).size };
                let oc = unsafe { (*cur).op_count };
                let mut dm: u32 = 0u32;
                let mut um: u32 = 0u32;
                if opc == X64_MI_MOV || opc == X64_MI_LEA {
                    if oc >= 1u8 {
                        let k0 = unsafe { (*cur).ops[0usize].kind };
                        if k0 == X64_OP_REG {
                            let r0 = unsafe { (*cur).ops[0usize].reg };
                            if r0 >= 0 && r0 < 32 { dm = 1u32 << (r0 as u32); }
                        } else if k0 == X64_OP_MEM {
                            let b0 = unsafe { (*cur).ops[0usize].mem.base };
                            if b0 >= 0 && b0 < 32 && b0 != REG_RBP && b0 != REG_RSP { um = um | (1u32 << (b0 as u32)); }
                            let x0 = unsafe { (*cur).ops[0usize].mem.index };
                            if x0 >= 0 && x0 < 32 && x0 != REG_RBP && x0 != REG_RSP { um = um | (1u32 << (x0 as u32)); }
                        }
                    }
                    if oc >= 2u8 {
                        let k1 = unsafe { (*cur).ops[1usize].kind };
                        if k1 == X64_OP_REG {
                            let r1 = unsafe { (*cur).ops[1usize].reg };
                            if r1 >= 0 && r1 < 32 { um = um | (1u32 << (r1 as u32)); }
                        } else if k1 == X64_OP_MEM {
                            let b1 = unsafe { (*cur).ops[1usize].mem.base };
                            if b1 >= 0 && b1 < 32 && b1 != REG_RBP && b1 != REG_RSP { um = um | (1u32 << (b1 as u32)); }
                            let x1 = unsafe { (*cur).ops[1usize].mem.index };
                            if x1 >= 0 && x1 < 32 && x1 != REG_RBP && x1 != REG_RSP { um = um | (1u32 << (x1 as u32)); }
                        }
                    }
                } else if opc == X64_MI_JMP || opc == X64_MI_JCC || opc == X64_MI_ASSERT {
                    dm = 0u32;
                    um = 0u32;
                } else if opc == X64_MI_CALL {
                    dm = X64_ALL_CALLER_SAVED_MASK;
                    if oc >= 1u8 {
                        um = unsafe { mi_op_phys_read_mask_v(view((*cur).ops[0usize])) };
                    }
                } else if opc == X64_MI_RET {
                    dm = 0u32;
                    um = 1u32;
                } else if opc == X64_MI_CMP || opc == X64_MI_TEST || opc == X64_MI_ADD || opc == X64_MI_SUB ||
                          opc == X64_MI_IMUL || opc == X64_MI_AND || opc == X64_MI_OR || opc == X64_MI_XOR ||
                          opc == X64_MI_SHL || opc == X64_MI_SAR || opc == X64_MI_SHR {
                    let k0 = if oc >= 1u8 { unsafe { (*cur).ops[0usize].kind } } else { X64_OP_NONE };
                    let k1 = if oc >= 2u8 { unsafe { (*cur).ops[1usize].kind } } else { X64_OP_NONE };
                    if opc != X64_MI_CMP && opc != X64_MI_TEST && k0 == X64_OP_REG {
                        let r0 = unsafe { (*cur).ops[0usize].reg };
                        if r0 >= 0 && r0 < 32 { dm = 1u32 << (r0 as u32); }
                    }
                    if !(opc == X64_MI_XOR && k0 == X64_OP_REG && k1 == X64_OP_REG &&
                         (unsafe { (*cur).ops[0usize].reg }) == (unsafe { (*cur).ops[1usize].reg })) {
                        if k0 == X64_OP_REG {
                            let r0 = unsafe { (*cur).ops[0usize].reg };
                            if r0 >= 0 && r0 < 32 { um = 1u32 << (r0 as u32); }
                        } else if k0 == X64_OP_MEM {
                            let b0 = unsafe { (*cur).ops[0usize].mem.base };
                            if b0 >= 0 && b0 < 32 && b0 != REG_RBP && b0 != REG_RSP { um = um | (1u32 << (b0 as u32)); }
                            let x0 = unsafe { (*cur).ops[0usize].mem.index };
                            if x0 >= 0 && x0 < 32 && x0 != REG_RBP && x0 != REG_RSP { um = um | (1u32 << (x0 as u32)); }
                        }
                        if k1 == X64_OP_REG {
                            let r1 = unsafe { (*cur).ops[1usize].reg };
                            if r1 >= 0 && r1 < 32 { um = um | (1u32 << (r1 as u32)); }
                        } else if k1 == X64_OP_MEM {
                            let b1 = unsafe { (*cur).ops[1usize].mem.base };
                            if b1 >= 0 && b1 < 32 && b1 != REG_RBP && b1 != REG_RSP { um = um | (1u32 << (b1 as u32)); }
                            let x1 = unsafe { (*cur).ops[1usize].mem.index };
                            if x1 >= 0 && x1 < 32 && x1 != REG_RBP && x1 != REG_RSP { um = um | (1u32 << (x1 as u32)); }
                        }
                    }
                } else {
                    dm = unsafe { mi_inst_phys_def_mask(view(*cur)) };
                    um = unsafe { mi_inst_phys_use_mask(view(*cur)) };
                }

                if opc == X64_MI_CALL {
                    um = um | pending_call_args;
                    pending_call_args = 0u32;
                } else {
                    if (um & abi_arg_reg_mask) != 0u32 {
                        pending_call_args = pending_call_args & (0xFFFFFFFFu32 ^ (um & abi_arg_reg_mask));
                    }
                    if (dm & abi_arg_reg_mask) != 0u32 && opc != X64_MI_ATOMIC_RMW_LOOP &&
                       opc != X64_MI_XCHG && opc != X64_MI_LOCK_XADD {
                        pending_call_args = pending_call_args | (dm & abi_arg_reg_mask);
                    }
                }

                let mut vd: u32 = LIR_VREG_NONE;
                let mut vu: u32 = LIR_VREG_NONE;
                let pos_use = (global_mi_base + (m as u32)) << 1;
                let pos_def = pos_use + 1u32;

                let mut op_idx: u8 = 0u8;
                while op_idx < oc {
                    let oiu = op_idx as usize;
                    if (unsafe { (*cur).ops[oiu].kind }) == X64_OP_FRAME {
                        let sid = unsafe { (*cur).ops[oiu].frame.slot_id };
                        if sid >= slot_offset {
                            let v_id = sid - slot_offset;
                            let v_u = v_id as usize;
                            if v_u < vreg_count {
                                let iv = (iv_base + (v_u * iv_stride)) as *mut X64LiveInterval;
                                if (unsafe { (*cur).ops[oiu].frame.offset }) != 0 || opc == X64_MI_LEA || (sz != 8u8 && sz != 0u8) {
                                    unsafe { (*iv).must_stack = true; }
                                }
                                let tw_p = ((touched_bits as usize) + ((v_u >> 6) << 3)) as *mut u64;
                                unsafe { *tw_p = (*tw_p) | (1u64 << ((v_id & 63u32) as u64)); }

                                if op_idx == 0u8 && opc == X64_MI_MOV {
                                    vd = v_id;
                                    let fixed_d = if oc >= 2u8 && (unsafe { (*cur).ops[1usize].kind }) == X64_OP_REG {
                                        unsafe { (*cur).ops[1usize].reg }
                                    } else {
                                        REG_NONE
                                    };
                                    unsafe {
                                        let uc = (*iv).use_count;
                                        if uc < (*iv).use_cap {
                                            let up = (((*iv).uses as usize) + ((uc as usize) * up_stride)) as *mut X64UsePos;
                                            (*up).pos = pos_def;
                                            (*up).fixed_reg = fixed_d;
                                            (*up).is_def = true;
                                            (*up).loop_depth = depth_u8;
                                            (*iv).use_count = uc + 1u32;
                                        } else {
                                            x64_interval_add_use(mut_view(*arena), mut_view(*iv), pos_def, fixed_d, true, depth);
                                        }
                                        let fd_p = ((first_def_pos as usize) + (v_u << 2)) as *mut u32;
                                        if pos_def < *fd_p {
                                            *fd_p = pos_def;
                                        }
                                        let lu_p = ((last_use_pos as usize) + (v_u << 2)) as *mut u32;
                                        if pos_def + 1u32 > *lu_p {
                                            *lu_p = pos_def + 1u32;
                                        }
                                    }
                                } else {
                                    vu = v_id;
                                    if opc != X64_MI_MOV {
                                        unsafe { *(((non_mov_use as usize) + v_u) as *mut u8) = 1u8; }
                                    }
                                    let fixed_u = if opc == X64_MI_MOV && (unsafe { (*cur).ops[0usize].kind }) == X64_OP_REG {
                                        unsafe { (*cur).ops[0usize].reg }
                                    } else {
                                        REG_NONE
                                    };
                                    unsafe {
                                        let uc = (*iv).use_count;
                                        if uc < (*iv).use_cap {
                                            let up = (((*iv).uses as usize) + ((uc as usize) * up_stride)) as *mut X64UsePos;
                                            (*up).pos = pos_use;
                                            (*up).fixed_reg = fixed_u;
                                            (*up).is_def = false;
                                            (*up).loop_depth = depth_u8;
                                            (*iv).use_count = uc + 1u32;
                                        } else {
                                            x64_interval_add_use(mut_view(*arena), mut_view(*iv), pos_use, fixed_u, false, depth);
                                        }
                                        let lu_p = ((last_use_pos as usize) + (v_u << 2)) as *mut u32;
                                        if pos_use + 1u32 > *lu_p {
                                            *lu_p = pos_use + 1u32;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    op_idx = op_idx + 1u8;
                }

                let m4 = m << 2;
                unsafe {
                    *(((p_def as usize) + m4) as *mut u32) = dm;
                    *(((p_use as usize) + m4) as *mut u32) = um;
                    *(((v_def as usize) + m4) as *mut u32) = vd;
                    *(((v_use as usize) + m4) as *mut u32) = vu;
                }
                cur = unsafe { (*cur).next };
                m = m + 1;
            }

            // Record per-block live range `[r_start, r_end)` for each vreg active in block `b`,
            // and initialize `live_list` from `live_out[b]`.
            let mut live_cnt: usize = 0;
            let li_row = (liveness_val.live_in as usize) + (b * row_bytes);
            let lo_row = (liveness_val.live_out as usize) + (b * row_bytes);
            let mut w_vr: usize = 0;
            while w_vr < words_per_bb {
                let w8 = w_vr << 3;
                let li_w = unsafe { *((li_row + w8) as *mut u64) };
                let lo_w = unsafe { *((lo_row + w8) as *mut u64) };
                let tc_p = ((touched_bits as usize) + w8) as *mut u64;
                let tc_w = unsafe { *tc_p };
                let mut act_w = li_w | lo_w | tc_w;
                if tc_w != 0u64 {
                    unsafe { *tc_p = 0u64; }
                }
                while act_w != 0u64 {
                    let bit = frame_ctz_u64(act_w);
                    let vr = (w_vr << 6) + (bit as usize);
                    if vr < vreg_count {
                        let mask_bit = 1u64 << (bit as u64);
                        let is_in = (li_w & mask_bit) != 0u64;
                        let is_out = (lo_w & mask_bit) != 0u64;
                        let vr4 = vr << 2;
                        let fd_p = ((first_def_pos as usize) + vr4) as *mut u32;
                        let lu_p = ((last_use_pos as usize) + vr4) as *mut u32;
                        let fd = unsafe { *fd_p };
                        let lu = unsafe { *lu_p };
                        unsafe {
                            *fd_p = 0xFFFFFFFFu32;
                            *lu_p = 0u32;
                        }
                        if is_in || is_out || fd != 0xFFFFFFFFu32 || lu != 0u32 {
                            let r_start = if is_in {
                                bb_start
                            } else if fd != 0xFFFFFFFFu32 {
                                fd
                            } else {
                                bb_start
                            };
                            let mut r_end = if is_out {
                                bb_end
                            } else if lu != 0u32 {
                                lu
                            } else {
                                r_start + 1u32
                            };
                            if r_end <= r_start {
                                r_end = r_start + 1u32;
                            }
                            let iv = (iv_base + (vr * iv_stride)) as *mut X64LiveInterval;
                            unsafe {
                                if r_start < (*iv).start { (*iv).start = r_start; }
                                if r_end > (*iv).end { (*iv).end = r_end; }
                                let rc = (*iv).range_count;
                                let mut coalesced = false;
                                if rc > 0u32 {
                                    let last_p = (((*iv).ranges as usize) + (((rc - 1u32) as usize) << 3)) as *mut X64LiveRange;
                                    let ls = (*last_p).start;
                                    let le = (*last_p).end;
                                    if r_start <= le && r_end >= ls {
                                        if r_start < ls { (*last_p).start = r_start; }
                                        if r_end > le { (*last_p).end = r_end; }
                                        coalesced = true;
                                    }
                                }
                                if !coalesced {
                                    if rc < (*iv).range_cap {
                                        let rp = (((*iv).ranges as usize) + ((rc as usize) << 3)) as *mut X64LiveRange;
                                        (*rp).start = r_start;
                                        (*rp).end = r_end;
                                        (*iv).range_count = rc + 1u32;
                                    } else {
                                        x64_interval_add_range(mut_view(*arena), mut_view(*iv), r_start, r_end);
                                    }
                                }
                            }
                        }
                        if is_out {
                            unsafe {
                                *(((live_pos as usize) + vr4) as *mut u32) = live_cnt as u32;
                                *(((enter_step as usize) + vr4) as *mut u32) = 0u32;
                                *(((live_list as usize) + (live_cnt << 2)) as *mut u32) = vr as u32;
                            }
                            live_cnt = live_cnt + 1;
                        }
                    }
                    act_w = act_w & (act_w - 1u64);
                }
                w_vr = w_vr + 1;
            }

            // O(1)-amortized backward scan using per-bit last-seen step timestamps.
            let mut seen_forbid_mask: u32 = 0u32;
            let mut call_last_step: u32 = 0u32;
            let mut step: u32 = 0u32;
            let mut live_phys_after: u32 = 0u32;
            let mut rev_m: usize = block_mi_cnt;
            while rev_m > 0 {
                rev_m = rev_m - 1;
                step = step + 1u32;
                let rm4 = rev_m << 2;
                let inst_p = unsafe { *(((mi_ptrs as usize) + (rev_m << 3)) as *mut *mut X64MI) };
                let opc = unsafe { (*inst_p).opcode };
                let dm = unsafe { *(((p_def as usize) + rm4) as *mut u32) };
                let um = unsafe { *(((p_use as usize) + rm4) as *mut u32) };
                let vd = unsafe { *(((v_def as usize) + rm4) as *mut u32) };
                let vu = unsafe { *(((v_use as usize) + rm4) as *mut u32) };
                let live_phys_before = (live_phys_after & (0xFFFFFFFFu32 ^ dm)) | um;

                if vd != LIR_VREG_NONE && (vd as usize) < vreg_count {
                    let vd_u = vd as usize;
                    let iv_d = (iv_base + (vd_u * iv_stride)) as *mut X64LiveInterval;
                    unsafe {
                        (*iv_d).forbidden_reg_mask = (*iv_d).forbidden_reg_mask | live_phys_after;
                    }
                    let is_li = (unsafe { *((li_row + ((vd_u >> 6) << 3)) as *mut u64) } & (1u64 << ((vd & 63u32) as u64))) != 0u64;
                    if !is_li {
                        let d_pos_p = ((live_pos as usize) + (vd_u << 2)) as *mut u32;
                        let d_pos = unsafe { *d_pos_p };
                        if d_pos != 0xFFFFFFFFu32 {
                            let ent = unsafe { *(((enter_step as usize) + (vd_u << 2)) as *mut u32) };
                            if seen_forbid_mask != 0u32 {
                                if ent == 0u32 {
                                    unsafe { (*iv_d).forbidden_reg_mask = (*iv_d).forbidden_reg_mask | seen_forbid_mask; }
                                } else {
                                    let mut sm = seen_forbid_mask;
                                    let mut acc: u32 = 0u32;
                                    while sm != 0u32 {
                                        let bit = frame_ctz_u32(sm);
                                        if bit_last_step[bit as usize] > ent {
                                            acc = acc | (1u32 << bit);
                                        }
                                        sm = sm & (sm - 1u32);
                                    }
                                    unsafe { (*iv_d).forbidden_reg_mask = (*iv_d).forbidden_reg_mask | acc; }
                                }
                            }
                            if call_last_step > ent {
                                unsafe { (*iv_d).crosses_call = true; }
                            }
                            live_cnt = live_cnt - 1;
                            let last_v = unsafe { *(((live_list as usize) + (live_cnt << 2)) as *mut u32) };
                            unsafe {
                                *(((live_list as usize) + ((d_pos as usize) << 2)) as *mut u32) = last_v;
                                *(((live_pos as usize) + ((last_v as usize) << 2)) as *mut u32) = d_pos;
                                *d_pos_p = 0xFFFFFFFFu32;
                            }
                        }
                    }
                }

                // Every vreg still in `live_list[0..live_cnt]` is live across instruction `rev_m`.
                if live_cnt > 0 {
                    let across_forbid = dm | live_phys_after | live_phys_before;
                    if across_forbid != 0u32 {
                        seen_forbid_mask = seen_forbid_mask | across_forbid;
                        let mut am = across_forbid;
                        while am != 0u32 {
                            let bit = frame_ctz_u32(am);
                            bit_last_step[bit as usize] = step;
                            am = am & (am - 1u32);
                        }
                    }
                    if opc == X64_MI_CALL {
                        call_last_step = step;
                    }
                }

                if vu != LIR_VREG_NONE && (vu as usize) < vreg_count {
                    let vu_u = vu as usize;
                    let iv_u = (iv_base + (vu_u * iv_stride)) as *mut X64LiveInterval;
                    unsafe {
                        (*iv_u).forbidden_reg_mask = (*iv_u).forbidden_reg_mask | live_phys_before;
                    }
                    let u_pos_p = ((live_pos as usize) + (vu_u << 2)) as *mut u32;
                    if (unsafe { *u_pos_p }) == 0xFFFFFFFFu32 {
                        unsafe {
                            *u_pos_p = live_cnt as u32;
                            *(((enter_step as usize) + (vu_u << 2)) as *mut u32) = step;
                            *(((live_list as usize) + (live_cnt << 2)) as *mut u32) = vu;
                        }
                        live_cnt = live_cnt + 1;
                    }
                }

                live_phys_after = live_phys_before;
            }

            let mut fl_end: usize = 0;
            while fl_end < live_cnt {
                let v_act_end = unsafe { *(((live_list as usize) + (fl_end << 2)) as *mut u32) as usize };
                let ve4 = v_act_end << 2;
                let ent = unsafe { *(((enter_step as usize) + ve4) as *mut u32) };
                if seen_forbid_mask != 0u32 || call_last_step > ent {
                    let iv_end = (iv_base + (v_act_end * iv_stride)) as *mut X64LiveInterval;
                    if seen_forbid_mask != 0u32 {
                        if ent == 0u32 {
                            unsafe { (*iv_end).forbidden_reg_mask = (*iv_end).forbidden_reg_mask | seen_forbid_mask; }
                        } else {
                            let mut sm = seen_forbid_mask;
                            let mut acc: u32 = 0u32;
                            while sm != 0u32 {
                                let bit = frame_ctz_u32(sm);
                                if bit_last_step[bit as usize] > ent {
                                    acc = acc | (1u32 << bit);
                                }
                                sm = sm & (sm - 1u32);
                            }
                            unsafe { (*iv_end).forbidden_reg_mask = (*iv_end).forbidden_reg_mask | acc; }
                        }
                    }
                    if call_last_step > ent {
                        unsafe { (*iv_end).crosses_call = true; }
                    }
                }
                unsafe {
                    *(((live_pos as usize) + ve4) as *mut u32) = 0xFFFFFFFFu32;
                }
                fl_end = fl_end + 1;
            }
        }

        let adv = if block_mi_cnt == 0 { 1u32 } else { block_mi_cnt as u32 };
        global_mi_base = global_mi_base + adv;
        b = b + 1;
    }

    // Compute spill weights and sort intervals by ascending `(iv.start, iv.vreg)` (`AXS-RA-018`).
    let sorted = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, 4) as *mut u32;
    let starts = def_counts; // Reuse `def_counts` buffer for cached `iv.start` keys!
    let mut max_start: u32 = 0u32;
    let mut s_idx: usize = 0;
    let mut s_iv_addr: usize = iv_base;
    while s_idx < vreg_count {
        let iv = s_iv_addr as *mut X64LiveInterval;
        let w = unsafe { x64_compute_spill_weight(view(*iv), block_exec_counts, lir.bb_count) };
        let st = unsafe { (*iv).start };
        unsafe {
            (*iv).spill_weight = w;
            *(((starts as usize) + (s_idx << 2)) as *mut u32) = st;
            *(((sorted as usize) + (s_idx << 2)) as *mut u32) = s_idx as u32;
        }
        if st != 0xFFFFFFFFu32 && st > max_start {
            max_start = st;
        }
        s_iv_addr = s_iv_addr + iv_stride;
        s_idx = s_idx + 1;
    }

    if vreg_count > 1 {
        if vreg_count <= 32 {
            // Stable insertion sort preserves ascending `vreg` order for equal `start`.
            let mut ii: usize = 1;
            while ii < vreg_count {
                let kv = unsafe { *(((sorted as usize) + (ii << 2)) as *mut u32) };
                let ks = unsafe { *(((starts as usize) + ((kv as usize) << 2)) as *mut u32) };
                let mut jj: usize = ii;
                while jj > 0 {
                    let pv = unsafe { *(((sorted as usize) + ((jj - 1) << 2)) as *mut u32) };
                    let ps = unsafe { *(((starts as usize) + ((pv as usize) << 2)) as *mut u32) };
                    if ps > ks {
                        unsafe { *(((sorted as usize) + (jj << 2)) as *mut u32) = pv; }
                        jj = jj - 1;
                    } else {
                        break;
                    }
                }
                unsafe { *(((sorted as usize) + (jj << 2)) as *mut u32) = kv; }
                ii = ii + 1;
            }
        } else if max_start < 131072u32 {
            // Linear-time stable counting sort by `iv.start` -> exact `(iv.start, iv.vreg)` order!
            let undef_bk: usize = (max_start as usize) + 1;
            let bucket_cnt: usize = undef_bk + 1;
            let counts = arena_alloc_raw(mut_view(*arena), bucket_cnt << 2, 4) as *mut u32;
            let mut cz: usize = counts as usize;
            let cz_end: usize = cz + (bucket_cnt << 2);
            while cz < cz_end {
                unsafe { *(cz as *mut u32) = 0u32; }
                cz = cz + 4;
            }
            let mut ci: usize = 0;
            while ci < vreg_count {
                let st = unsafe { *(((starts as usize) + (ci << 2)) as *mut u32) };
                let bk = if st == 0xFFFFFFFFu32 { undef_bk } else { st as usize };
                let cp = ((counts as usize) + (bk << 2)) as *mut u32;
                unsafe { *cp = (*cp) + 1u32; }
                ci = ci + 1;
            }
            let mut acc: u32 = 0u32;
            let mut bk_i: usize = 0;
            while bk_i < bucket_cnt {
                let cp = ((counts as usize) + (bk_i << 2)) as *mut u32;
                let c = unsafe { *cp };
                unsafe { *cp = acc; }
                acc = acc + c;
                bk_i = bk_i + 1;
            }
            let mut pi: usize = 0;
            while pi < vreg_count {
                let st = unsafe { *(((starts as usize) + (pi << 2)) as *mut u32) };
                let bk = if st == 0xFFFFFFFFu32 { undef_bk } else { st as usize };
                let cp = ((counts as usize) + (bk << 2)) as *mut u32;
                let pos = unsafe { *cp };
                unsafe {
                    *cp = pos + 1u32;
                    *(((sorted as usize) + ((pos as usize) << 2)) as *mut u32) = pi as u32;
                }
                pi = pi + 1;
            }
        } else {
            // Fallback bottom-up merge sort on `sorted` using cached `starts`.
            let sort_tmp = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, 4) as *mut u32;
            let mut src_arr = sorted;
            let mut dst_arr = sort_tmp;
            let mut width: usize = 1;
            while width < vreg_count {
                let mut lo: usize = 0;
                while lo < vreg_count {
                    let mid = if lo + width < vreg_count { lo + width } else { vreg_count };
                    let hi = if lo + (width << 1) < vreg_count { lo + (width << 1) } else { vreg_count };
                    let mut i_l = lo;
                    let mut i_r = mid;
                    let mut out_k = lo;
                    while out_k < hi {
                        let take_left = if i_l < mid && i_r < hi {
                            let lv = unsafe { *(((src_arr as usize) + (i_l << 2)) as *mut u32) };
                            let rv = unsafe { *(((src_arr as usize) + (i_r << 2)) as *mut u32) };
                            let l_start = unsafe { *(((starts as usize) + ((lv as usize) << 2)) as *mut u32) };
                            let r_start = unsafe { *(((starts as usize) + ((rv as usize) << 2)) as *mut u32) };
                            l_start < r_start || (l_start == r_start && lv <= rv)
                        } else {
                            i_l < mid
                        };
                        if take_left {
                            unsafe { *(((dst_arr as usize) + (out_k << 2)) as *mut u32) = *(((src_arr as usize) + (i_l << 2)) as *mut u32); }
                            i_l = i_l + 1;
                        } else {
                            unsafe { *(((dst_arr as usize) + (out_k << 2)) as *mut u32) = *(((src_arr as usize) + (i_r << 2)) as *mut u32); }
                            i_r = i_r + 1;
                        }
                        out_k = out_k + 1;
                    }
                    lo = hi;
                }
                let swap_p = src_arr;
                src_arr = dst_arr;
                dst_arr = swap_p;
                width = width << 1;
            }
            if (src_arr as usize) != (sorted as usize) {
                unsafe {
                    ptr_copy_nonoverlapping<u8>(src_arr as *const u8, sorted as *mut u8, vreg_u32_bytes);
                }
            }
        }
    }

    // Linear-scan register allocation walk (`AXS-RA-018..022`).
    let active = live_list; // Reuse `live_list` buffer!
    let mut active_len: usize = 0;
    let mut used_phys_mask: u32 = 0u32;
    let mut used_callee_mask: u32 = 0u32;
    let mut coalesced_cnt: u32 = 0u32;

    let mut idx: usize = 0;
    while idx < vreg_count {
        let cur_v = unsafe { *(((sorted as usize) + (idx << 2)) as *mut u32) };
        let cur_iv = (iv_base + ((cur_v as usize) * iv_stride)) as *mut X64LiveInterval;
        let cur_uses = unsafe { (*cur_iv).use_count };
        let cur_must_stack = unsafe { (*cur_iv).must_stack };
        let cur_start = unsafe { (*cur_iv).start };

        // 1. Expire old intervals in `active` whose `end <= cur_start`.
        let mut write_a: usize = 0;
        let mut read_a: usize = 0;
        while read_a < active_len {
            let act_v = unsafe { *(((active as usize) + (read_a << 2)) as *mut u32) };
            let act_iv = (iv_base + ((act_v as usize) * iv_stride)) as *mut X64LiveInterval;
            if (unsafe { (*act_iv).end }) > cur_start {
                if write_a != read_a {
                    unsafe { *(((active as usize) + (write_a << 2)) as *mut u32) = act_v; }
                }
                write_a = write_a + 1;
            }
            read_a = read_a + 1;
        }
        active_len = write_a;

        if cur_uses > 0u32 && !cur_must_stack {
            let rclass = unsafe { (*cur_iv).reg_class };
            let crosses = unsafe { (*cur_iv).crosses_call };
            let forbid = unsafe { (*cur_iv).forbidden_reg_mask };
            let copy_hint_v = unsafe { (*cur_iv).copy_hint_vreg };
            let mut hint_reg = unsafe { (*cur_iv).fixed_reg_hint };
            if hint_reg == REG_NONE && copy_hint_v != LIR_VREG_NONE && (copy_hint_v as usize) < vreg_count {
                let hint_iv = (iv_base + ((copy_hint_v as usize) * iv_stride)) as *mut X64LiveInterval;
                hint_reg = unsafe { (*hint_iv).assigned_reg };
            }

            let class_mask = if rclass == REG_CLASS_GPR {
                if crosses {
                    X64_GPR_CALLEE_SAVED_MASK
                } else {
                    X64_GPR_ALLOCATABLE_MASK & 0xFFFFFFFEu32
                }
            } else {
                if crosses {
                    X64_XMM_CALLEE_SAVED_MASK
                } else {
                    X64_XMM_ALL_MASK
                }
            };
            let allowed_for_cur = class_mask & (0xFFFFFFFFu32 ^ forbid);

            // Exclude registers held by overlapping active intervals.
            let mut busy_active: u32 = 0u32;
            let mut a_i: usize = 0;
            while a_i < active_len {
                let act_v = unsafe { *(((active as usize) + (a_i << 2)) as *mut u32) };
                let act_iv = (iv_base + ((act_v as usize) * iv_stride)) as *mut X64LiveInterval;
                if unsafe { x64_intervals_overlap(view(*act_iv), view(*cur_iv)) } {
                    let ar = unsafe { (*act_iv).assigned_reg };
                    if ar >= 0 && ar < 32 {
                        busy_active = busy_active | (1u32 << (ar as u32));
                    }
                }
                a_i = a_i + 1;
            }

            let avail_mask = allowed_for_cur & (0xFFFFFFFFu32 ^ busy_active);
            let chosen = pick_best_reg(avail_mask, rclass, crosses, hint_reg, used_callee_mask);
            if chosen != REG_NONE {
                unsafe {
                    (*cur_iv).assigned_reg = chosen;
                    *(((active as usize) + (active_len << 2)) as *mut u32) = cur_v;
                }
                active_len = active_len + 1;
                if chosen >= 0 && chosen < 32 {
                    let cbit = 1u32 << (chosen as u32);
                    if (cbit & X64_ALL_CALLEE_SAVED_MASK) != 0u32 {
                        used_callee_mask = used_callee_mask | cbit;
                    }
                }
                if chosen == hint_reg && hint_reg != REG_NONE {
                    coalesced_cnt = coalesced_cnt + 1u32;
                }
            } else {
                // Spill / eviction heuristic: compare `cur_iv.spill_weight` against the lowest-weight
                // conflicting active interval whose register is legal for `cur_iv` (`AXS-RA-018`, `AXS-RA-022`).
                let cur_weight = unsafe { (*cur_iv).spill_weight };
                let mut min_weight: u64 = 0xFFFFFFFFFFFFFFFFu64;
                let mut victim_pos: usize = active_len;
                let mut v_i: usize = 0;
                while v_i < active_len {
                    let act_v = unsafe { *(((active as usize) + (v_i << 2)) as *mut u32) };
                    let act_iv = (iv_base + ((act_v as usize) * iv_stride)) as *mut X64LiveInterval;
                    let act_reg = unsafe { (*act_iv).assigned_reg };
                    let act_w = unsafe { (*act_iv).spill_weight };
                    if act_reg >= 0 && act_reg < 32 &&
                       (allowed_for_cur & (1u32 << (act_reg as u32))) != 0u32 &&
                       act_w < min_weight {
                        min_weight = act_w;
                        victim_pos = v_i;
                    }
                    v_i = v_i + 1;
                }

                if victim_pos < active_len && min_weight < cur_weight {
                    let vic_v = unsafe { *(((active as usize) + (victim_pos << 2)) as *mut u32) };
                    let vic_iv = (iv_base + ((vic_v as usize) * iv_stride)) as *mut X64LiveInterval;
                    let stolen_reg = unsafe { (*vic_iv).assigned_reg };
                    unsafe {
                        (*vic_iv).assigned_reg = REG_NONE;
                        (*vic_iv).is_spilled = true;
                        (*cur_iv).assigned_reg = stolen_reg;
                        *(((active as usize) + (victim_pos << 2)) as *mut u32) = cur_v;
                    }
                } else {
                    unsafe {
                        (*cur_iv).assigned_reg = REG_NONE;
                        (*cur_iv).is_spilled = true;
                    }
                }
            }
        }
        idx = idx + 1;
    }

    // Finalize allocated vs. spilled/rematerialized intervals and assign colored spill slots.
    let remat_in_place = arena_alloc_raw(mut_view(*arena), vreg_count, 1) as *mut u8;
    let mut allocated_cnt: u32 = 0u32;
    let mut spilled_cnt: u32 = 0u32;
    let mut remat_cnt: u32 = 0u32;
    used_phys_mask = 0u32;
    used_callee_mask = 0u32;

    let vr_stride2 = size_of<LirVReg>();
    let mut fv: usize = 0;
    let mut fv_iv_addr: usize = iv_base;
    let mut fv_vr_addr: usize = lir.vregs as usize;
    while fv < vreg_count {
        unsafe {
            *(((remat_in_place as usize) + fv) as *mut u8) = 0u8;
        }
        let iv = fv_iv_addr as *mut X64LiveInterval;
        let u_cnt = unsafe { (*iv).use_count };
        if u_cnt > 0u32 {
            let reg = unsafe { (*iv).assigned_reg };
            let must_s = unsafe { (*iv).must_stack };
            if reg != REG_NONE && !must_s {
                allocated_cnt = allocated_cnt + 1u32;
                if reg >= 0 && reg < 32 {
                    let bit = 1u32 << (reg as u32);
                    used_phys_mask = used_phys_mask | bit;
                    if (bit & X64_ALL_CALLEE_SAVED_MASK) != 0u32 {
                        used_callee_mask = used_callee_mask | bit;
                    }
                }
            } else {
                let rk = unsafe { (*iv).remat_kind };
                let has_non_mov = unsafe { *(((non_mov_use as usize) + fv) as *mut u8) };
                unsafe {
                    (*iv).assigned_reg = REG_NONE;
                    (*iv).is_spilled = true;
                }
                if !must_s && (rk == X64_REMAT_CONST || rk == X64_REMAT_STACK_ADDR) && has_non_mov == 0u8 {
                    unsafe {
                        *(((remat_in_place as usize) + fv) as *mut u8) = 1u8;
                    }
                    remat_cnt = remat_cnt + 1u32;
                } else {
                    spilled_cnt = spilled_cnt + 1u32;
                    let vty_v: u32 = unsafe { (*(fv_vr_addr as *const LirVReg)).ty.v };
                    let sz = x64_cached_type_size(TypeId { v: vty_v }, interner);
                    let al = x64_cached_type_align(TypeId { v: vty_v }, interner);
                    let cslot = unsafe {
                        x64_stack_slot_alloc_for_interval(mut_view(*arena), mut_view(spill_alloc), view(*iv), sz, al)
                    };
                    unsafe {
                        (*iv).spill_slot = cslot as i32;
                    }
                }
            }
        }
        fv_iv_addr = fv_iv_addr + iv_stride;
        fv_vr_addr = fv_vr_addr + vr_stride2;
        fv = fv + 1;
    }

    rewrite_allocated_and_remat_ops(mut_view(*body), intervals, vreg_count, slot_offset, remat_in_place);
    peephole_fold_allocated_moves(mut_view(*body));

    X64RegAllocResult {
        intervals: intervals,
        liveness: liveness_ptr,
        spill_slots: spill_alloc,
        interval_count: vreg_count as u32,
        used_phys_reg_mask: used_phys_mask,
        used_callee_saved_mask: used_callee_mask,
        allocated_vreg_count: allocated_cnt,
        spilled_vreg_count: spilled_cnt,
        remat_vreg_count: remat_cnt,
        coalesced_copy_count: coalesced_cnt,
        pad: 0u32,
    }
}

pub fn x64_regalloc_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64RegAllocResult {
    x64_regalloc_with_pgo_in_arena(mut_view(*arena), mut_view(*body), lir, interner, 0 as *const u64)
}

pub fn x64_regalloc(
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64RegAllocResult {
    let arena_ptr = body.arena;
    unsafe {
        x64_regalloc_in_arena(mut_view(*arena_ptr), mut_view(*body), lir, interner)
    }
}

// =============================================================================
// 7. x86-64 Frame Layout & Lowering (SPEC-77 §3.4 & §3.6, AXS-RA-021, AXS-RA-023)
// =============================================================================

@derive(Copy)
pub struct X64FrameLayout {
    pub slot_offsets: *mut i32,
    pub slot_count: u32,
    pub frame_size: u32,
}

pub unsafe fn i32_at(base: *mut i32, idx: usize) -> *mut i32 {
    ((base as usize) + (idx << 2)) as *mut i32
}

pub fn x64_frame_slot_offset(layout: view<X64FrameLayout>, slot_id: u32) -> i32 {
    if slot_id < layout.slot_count && (layout.slot_offsets as usize) != 0 {
        unsafe { *(((layout.slot_offsets as usize) + ((slot_id as usize) << 2)) as *mut i32) }
    } else {
        0
    }
}

pub fn x64_frame_has_meta(layout: view<X64FrameLayout>) -> bool {
    if (layout.slot_offsets as usize) == 0 {
        return false;
    }
    let sc = layout.slot_count as usize;
    let m0 = unsafe { *(((layout.slot_offsets as usize) + (sc << 2)) as *mut i32) };
    let m4 = unsafe { *(((layout.slot_offsets as usize) + ((sc + 4) << 2)) as *mut i32) };
    let expected = X64_FRAME_META_MAGIC ^ (layout.frame_size as i32) ^ (layout.slot_count as i32);
    m0 == X64_FRAME_META_MAGIC && m4 == expected
}

pub fn x64_frame_callee_saved_mask(layout: view<X64FrameLayout>) -> u32 {
    if x64_frame_has_meta(layout) {
        let sc = layout.slot_count as usize;
        unsafe { (*(((layout.slot_offsets as usize) + ((sc + 1) << 2)) as *mut i32)) as u32 }
    } else {
        X64_GPR_CALLEE_SAVED_MASK
    }
}

pub fn x64_frame_callee_saved_bytes(layout: view<X64FrameLayout>) -> u32 {
    if x64_frame_has_meta(layout) {
        let sc = layout.slot_count as usize;
        unsafe { (*(((layout.slot_offsets as usize) + ((sc + 2) << 2)) as *mut i32)) as u32 }
    } else {
        X64_CALLEE_SAVED_BYTES
    }
}

pub fn x64_frame_xmm_save_offset(layout: view<X64FrameLayout>) -> i32 {
    if x64_frame_has_meta(layout) {
        let sc = layout.slot_count as usize;
        unsafe { *(((layout.slot_offsets as usize) + ((sc + 3) << 2)) as *mut i32) }
    } else {
        0
    }
}

fn frame_write_meta(
    offsets_ptr: *mut i32,
    slot_count: u32,
    frame_size: u32,
    callee_mask: u32,
    callee_bytes: u32,
    xmm_offset: i32
) {
    if (offsets_ptr as usize) != 0 {
        let sc = slot_count as usize;
        let base = (offsets_ptr as usize) + (sc << 2);
        let chk = X64_FRAME_META_MAGIC ^ (frame_size as i32) ^ (slot_count as i32);
        unsafe {
            *(base as *mut i32) = X64_FRAME_META_MAGIC;
            *((base + 4) as *mut i32) = callee_mask as i32;
            *((base + 8) as *mut i32) = callee_bytes as i32;
            *((base + 12) as *mut i32) = xmm_offset;
            *((base + 16) as *mut i32) = chk;
        }
    }
}

fn frame_align_up_i32(val: i32, align: i32) -> i32 {
    let mask = align - 1;
    (val + mask) & (0 - align)
}

pub fn x64_frame_rewrite_ops(body: mut_view<X64MIBody>, layout: view<X64FrameLayout>) {
    let slot_cnt = layout.slot_count;
    let offsets_base = layout.slot_offsets as usize;
    let has_offsets = offsets_base != 0;
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let op_count = unsafe { (*inst).op_count };
            let mut i: u8 = 0u8;
            while i < op_count {
                let iu = i as usize;
                if (unsafe { (*inst).ops[iu].kind }) == X64_OP_FRAME {
                    let sid = unsafe { (*inst).ops[iu].frame.slot_id };
                    let off = unsafe { (*inst).ops[iu].frame.offset };
                    let base_off = if sid < slot_cnt && has_offsets {
                        unsafe { *((offsets_base + ((sid as usize) << 2)) as *mut i32) }
                    } else {
                        0
                    };
                    unsafe {
                        (*inst).ops[iu].kind = X64_OP_MEM;
                        (*inst).ops[iu].mem.base = REG_RBP;
                        (*inst).ops[iu].mem.index = REG_NONE;
                        (*inst).ops[iu].mem.scale = 1u8;
                        (*inst).ops[iu].mem.disp = base_off + off;
                        (*inst).ops[iu].mem.is_rip = false;
                    }
                }
                i = i + 1u8;
            }
            inst = unsafe { (*inst).next };
        }
        b = b + 1;
    }
}

// Baseline (`-O0`) stack-slot-per-vreg frame lowering with all 7 callee-saved GPRs saved.
pub fn x64_frame_lower_baseline_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64FrameLayout {
    let total_slots = (lir.slot_count + lir.vreg_count) as u32;
    let mut offsets_ptr: *mut i32 = 0 as *mut i32;
    if total_slots > 0u32 {
        offsets_ptr = arena_alloc_raw(mut_view(*arena), (total_slots as usize) << 2, 4) as *mut i32;
    }

    // 7 callee-saved registers pushed after RBP: RBX, RSI, RDI, R12, R13, R14, R15 = 56 bytes
    let mut current_offset: i32 = 56;

    // Minimum shadow space on Windows x64 is 32 bytes
    let sh0 = body.shadow_space;
    if sh0 < 32u32 {
        body.shadow_space = 32u32;
    }

    let mut i: usize = 0;
    while i < lir.slot_count {
        let slot = unsafe { lir_slot_at(lir.slots, i) };
        if unsafe { (*slot).is_const } {
            unsafe {
                *(((offsets_ptr as usize) + (i << 2)) as *mut i32) = 0;
            }
        } else {
            let sty_v = unsafe { (*slot).ty.v };
            let mut size = x64_cached_type_size(TypeId { v: sty_v }, interner);
            let mut align = x64_cached_type_align(TypeId { v: sty_v }, interner);
            if size < 8u32 { size = 8u32; }
            if align < 8u32 { align = 8u32; }
            current_offset = frame_align_up_i32(current_offset + (size as i32), align as i32);
            unsafe {
                *(((offsets_ptr as usize) + (i << 2)) as *mut i32) = 0 - current_offset;
            }
        }
        i = i + 1;
    }

    let mut v: usize = 0;
    while v < lir.vreg_count {
        let vreg = unsafe { lir_vreg_at(lir.vregs, v) };
        let vty_v = unsafe { (*vreg).ty.v };
        let mut size = x64_cached_type_size(TypeId { v: vty_v }, interner);
        let mut align = x64_cached_type_align(TypeId { v: vty_v }, interner);
        if size < 8u32 { size = 8u32; }
        if align < 8u32 { align = 8u32; }
        current_offset = frame_align_up_i32(current_offset + (size as i32), align as i32);
        unsafe {
            *(((offsets_ptr as usize) + ((lir.slot_count + v) << 2)) as *mut i32) = 0 - current_offset;
        }
        v = v + 1;
    }

    current_offset = current_offset + (body.shadow_space as i32);
    // Align total RBP-relative offset (56 + frame_size) to a multiple of 16 bytes
    current_offset = frame_align_up_i32(current_offset, 16);

    let layout = X64FrameLayout {
        slot_offsets: offsets_ptr,
        slot_count: total_slots,
        frame_size: (current_offset - 56) as u32,
    };

    x64_frame_rewrite_ops(mut_view(*body), view(layout));
    layout
}

// =============================================================================
// 7b. Post-RA Machine Peephole Optimizer (SPEC-78 §4, AXS-MCOPT-020..026)
// =============================================================================

pub const FLAGS_NONE: u8 = 0u8;
pub const FLAGS_DEF: u8 = 1u8;      // Overwrites EFLAGS (`add`, `sub`, `imul`, `mul`, `and`, `or`, `xor`, `shl`, `shr`, `sar`, `cmp`, `test`)
pub const FLAGS_USE: u8 = 2u8;      // Reads EFLAGS (`jcc`, `setcc`, `cmovcc`, `assert`)
pub const FLAGS_PRESERVE: u8 = 3u8; // Does not read or write EFLAGS (`mov`, `lea`, `push`, `pop`, `jmp`)
pub const FLAGS_KILL: u8 = 4u8;     // Clobbers or exits without reading EFLAGS (`call`, `idiv`, `ret`)
pub const FLAGS_DEF_USE: u8 = 5u8;  // Both reads and writes EFLAGS

pub fn x64_mi_flags_effect(inst: view<X64MI>) -> u8 {
    let opc = inst.opcode;
    if opc == X64_MI_MOV || opc == X64_MI_LEA || opc == X64_MI_PUSH ||
       opc == X64_MI_POP || opc == X64_MI_JMP || opc == X64_MI_XCHG ||
       opc == X64_MI_MFENCE || opc == X64_MI_PAUSE {
        FLAGS_PRESERVE
    } else if opc == X64_MI_ADD || opc == X64_MI_SUB || opc == X64_MI_IMUL ||
              opc == X64_MI_MUL || opc == X64_MI_AND || opc == X64_MI_OR ||
              opc == X64_MI_XOR || opc == X64_MI_SHL || opc == X64_MI_SAR ||
              opc == X64_MI_SHR || opc == X64_MI_CMP || opc == X64_MI_TEST ||
              opc == X64_MI_LOCK_XADD || opc == X64_MI_LOCK_CMPXCHG ||
              opc == X64_MI_LOCK_ADD || opc == X64_MI_LOCK_SUB ||
              opc == X64_MI_LOCK_AND || opc == X64_MI_LOCK_OR ||
              opc == X64_MI_LOCK_XOR || opc == X64_MI_ATOMIC_RMW_LOOP {
        FLAGS_DEF
    } else if opc == X64_MI_JCC || opc == X64_MI_SETCC || opc == X64_MI_CMOVCC || opc == X64_MI_ASSERT {
        FLAGS_USE
    } else if opc == X64_MI_CALL || opc == X64_MI_IDIV || opc == X64_MI_RET {
        FLAGS_KILL
    } else {
        FLAGS_NONE
    }
}

pub fn x64_flags_are_dead_after(inst: *mut X64MI) -> bool {
    if (inst as usize) == 0 {
        return false;
    }
    let mut curr: *mut X64MI = unsafe { (*inst).next };
    while (curr as usize) != 0 {
        let opc: u32 = unsafe { (*curr).opcode };
        if opc == X64_MI_MOV || opc == X64_MI_LEA || opc == X64_MI_PUSH ||
           opc == X64_MI_POP || opc == X64_MI_XCHG || opc == X64_MI_MFENCE ||
           opc == X64_MI_PAUSE || opc == X64_MI_COMPILER_BARRIER || opc == X64_MI_TLS_ADDR {
            curr = unsafe { (*curr).next };
            continue;
        }
        if opc == X64_MI_JCC || opc == X64_MI_SETCC || opc == X64_MI_CMOVCC ||
           opc == X64_MI_ASSERT || opc == X64_MI_JMP {
            return false;
        }
        if opc == X64_MI_SHL || opc == X64_MI_SHR || opc == X64_MI_SAR {
            if (unsafe { (*curr).ops[1usize].kind }) == X64_OP_IMM &&
               ((unsafe { (*curr).ops[1usize].imm }) & 63i64) != 0i64 {
                return true;
            }
            curr = unsafe { (*curr).next };
            continue;
        }
        if opc == X64_MI_ADD || opc == X64_MI_SUB || opc == X64_MI_IMUL ||
           opc == X64_MI_MUL || opc == X64_MI_AND || opc == X64_MI_OR ||
           opc == X64_MI_XOR || opc == X64_MI_CMP || opc == X64_MI_TEST ||
           opc == X64_MI_CALL || opc == X64_MI_IDIV || opc == X64_MI_RET ||
           opc == X64_MI_LOCK_XADD || opc == X64_MI_LOCK_CMPXCHG ||
           opc == X64_MI_LOCK_ADD || opc == X64_MI_LOCK_SUB ||
           opc == X64_MI_LOCK_AND || opc == X64_MI_LOCK_OR ||
           opc == X64_MI_LOCK_XOR || opc == X64_MI_ATOMIC_RMW_LOOP {
            return true;
        }
        curr = unsafe { (*curr).next };
    }
    false
}

fn peep_op_phys_read_mask_v(op: view<X64Op>) -> u32 {
    if op.kind == X64_OP_REG {
        let r = op.reg;
        if r >= 0 && r < 32 { 1u32 << (r as u32) } else { 0u32 }
    } else if op.kind == X64_OP_MEM {
        let mut m: u32 = 0u32;
        let b = op.mem.base;
        if b >= 0 && b < 32 {
            m = m | (1u32 << (b as u32));
        }
        let ix = op.mem.index;
        if ix >= 0 && ix < 32 {
            m = m | (1u32 << (ix as u32));
        }
        m
    } else {
        0u32
    }
}

fn peep_inst_phys_def_mask(inst: view<X64MI>) -> u32 {
    let opc = inst.opcode;
    if opc == X64_MI_MOV || opc == X64_MI_ADD || opc == X64_MI_SUB ||
       opc == X64_MI_IMUL || opc == X64_MI_AND || opc == X64_MI_OR ||
       opc == X64_MI_XOR || opc == X64_MI_SHL || opc == X64_MI_SAR ||
       opc == X64_MI_SHR || opc == X64_MI_LEA || opc == X64_MI_POP {
        if inst.op_count >= 1u8 && inst.ops[0usize].kind == X64_OP_REG {
            let r = inst.ops[0usize].reg;
            if r >= 0 && r < 32 { return 1u32 << (r as u32); }
        }
        return 0u32;
    }
    if opc == X64_MI_CALL {
        return 0x003F0F07u32;
    }
    if opc == X64_MI_SETCC || opc == X64_MI_CMOVCC {
        if inst.op_count >= 2u8 && inst.ops[1usize].kind == X64_OP_REG {
            let r = inst.ops[1usize].reg;
            if r >= 0 && r < 32 { return 1u32 << (r as u32); }
        }
        return 0u32;
    }
    if opc == X64_MI_IDIV || opc == X64_MI_MUL {
        return 0x00000005u32; // RAX | RDX
    }
    if opc == X64_MI_XCHG || opc == X64_MI_LOCK_XADD {
        let mut mask: u32 = 0u32;
        if inst.op_count >= 1u8 && inst.ops[0usize].kind == X64_OP_REG {
            let r0 = inst.ops[0usize].reg;
            if r0 >= 0 && r0 < 32 { mask = mask | (1u32 << (r0 as u32)); }
        }
        if inst.op_count >= 2u8 && inst.ops[1usize].kind == X64_OP_REG {
            let r1 = inst.ops[1usize].reg;
            if r1 >= 0 && r1 < 32 { mask = mask | (1u32 << (r1 as u32)); }
        }
        return mask;
    }
    if opc == X64_MI_LOCK_CMPXCHG {
        return 1u32;
    }
    if opc == X64_MI_ATOMIC_RMW_LOOP {
        return 0x00000101u32;
    }
    0u32
}

fn peep_inst_phys_use_mask(inst: view<X64MI>) -> u32 {
    let opc = inst.opcode;
    let oc = inst.op_count;
    if opc == X64_MI_MOV || opc == X64_MI_LEA {
        let mut mask: u32 = 0u32;
        if oc >= 1u8 && inst.ops[0usize].kind == X64_OP_MEM {
            mask = peep_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        if oc >= 2u8 {
            let k1 = inst.ops[1usize].kind;
            if k1 == X64_OP_REG {
                let r1 = inst.ops[1usize].reg;
                if r1 >= 0 && r1 < 32 { mask = mask | (1u32 << (r1 as u32)); }
            } else if k1 == X64_OP_MEM {
                mask = mask | peep_op_phys_read_mask_v(view(inst.ops[1usize]));
            }
        }
        return mask;
    }
    if opc == X64_MI_CMP || opc == X64_MI_TEST || opc == X64_MI_ADD || opc == X64_MI_SUB ||
       opc == X64_MI_IMUL || opc == X64_MI_AND || opc == X64_MI_OR || opc == X64_MI_XOR ||
       opc == X64_MI_SHL || opc == X64_MI_SAR || opc == X64_MI_SHR || opc == X64_MI_XCHG ||
       opc == X64_MI_LOCK_XADD || opc == X64_MI_LOCK_ADD || opc == X64_MI_LOCK_SUB ||
       opc == X64_MI_LOCK_AND || opc == X64_MI_LOCK_OR || opc == X64_MI_LOCK_XOR ||
       opc == X64_MI_ATOMIC_RMW_LOOP {
        if opc == X64_MI_XOR && oc >= 2u8 &&
           inst.ops[0usize].kind == X64_OP_REG && inst.ops[1usize].kind == X64_OP_REG &&
           inst.ops[0usize].reg == inst.ops[1usize].reg {
            return 0u32;
        }
        let mut mask: u32 = 0u32;
        if oc >= 1u8 {
            mask = peep_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        if oc >= 2u8 {
            mask = mask | peep_op_phys_read_mask_v(view(inst.ops[1usize]));
        }
        return mask;
    }
    if opc == X64_MI_JMP || opc == X64_MI_JCC || opc == X64_MI_SETCC || opc == X64_MI_ASSERT || opc == X64_MI_POP {
        return 0u32;
    }
    if opc == X64_MI_CALL {
        let mut mask: u32 = 0x00000306u32; // RCX | RDX | R8 | R9
        if oc >= 1u8 {
            mask = mask | peep_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        return mask;
    }
    if opc == X64_MI_PUSH {
        if oc >= 1u8 {
            return peep_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        return 0u32;
    }
    if opc == X64_MI_RET {
        return 1u32;
    }
    if opc == X64_MI_CMOVCC {
        let mut mask: u32 = 0u32;
        if oc >= 2u8 {
            mask = peep_op_phys_read_mask_v(view(inst.ops[1usize]));
        }
        if oc >= 3u8 {
            mask = mask | peep_op_phys_read_mask_v(view(inst.ops[2usize]));
        }
        return mask;
    }
    if opc == X64_MI_IDIV || opc == X64_MI_MUL {
        let mut mask: u32 = 0x00000005u32;
        if oc >= 1u8 {
            mask = mask | peep_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        return mask;
    }
    if opc == X64_MI_LOCK_CMPXCHG {
        let mut mask: u32 = 1u32;
        if oc >= 1u8 {
            mask = mask | peep_op_phys_read_mask_v(view(inst.ops[0usize]));
        }
        if oc >= 2u8 {
            mask = mask | peep_op_phys_read_mask_v(view(inst.ops[1usize]));
        }
        return mask;
    }
    0u32
}

fn peep_reg_dead_after(inst: *mut X64MI, reg: i32) -> bool {
    let rbit = if reg >= 0 && reg < 32 { 1u32 << (reg as u32) } else { 0u32 };
    let mut curr: *mut X64MI = unsafe { (*inst).next };
    while (curr as usize) != 0 {
        let opc: u32 = unsafe { (*curr).opcode };
        if opc == X64_MI_MOV || opc == X64_MI_LEA {
            let oc = unsafe { (*curr).op_count };
            let mut u_mask: u32 = 0u32;
            let k0 = if oc >= 1u8 { unsafe { (*curr).ops[0usize].kind } } else { X64_OP_NONE };
            if k0 == X64_OP_MEM {
                let b0 = unsafe { (*curr).ops[0usize].mem.base };
                if b0 >= 0 && b0 < 32 { u_mask = u_mask | (1u32 << (b0 as u32)); }
                let x0 = unsafe { (*curr).ops[0usize].mem.index };
                if x0 >= 0 && x0 < 32 { u_mask = u_mask | (1u32 << (x0 as u32)); }
            }
            if oc >= 2u8 {
                let k1 = unsafe { (*curr).ops[1usize].kind };
                if k1 == X64_OP_REG {
                    let r1 = unsafe { (*curr).ops[1usize].reg };
                    if r1 >= 0 && r1 < 32 { u_mask = u_mask | (1u32 << (r1 as u32)); }
                } else if k1 == X64_OP_MEM {
                    let b1 = unsafe { (*curr).ops[1usize].mem.base };
                    if b1 >= 0 && b1 < 32 { u_mask = u_mask | (1u32 << (b1 as u32)); }
                    let x1 = unsafe { (*curr).ops[1usize].mem.index };
                    if x1 >= 0 && x1 < 32 { u_mask = u_mask | (1u32 << (x1 as u32)); }
                }
            }
            if (u_mask & rbit) != 0u32 {
                return false;
            }
            if k0 == X64_OP_REG {
                let r0 = unsafe { (*curr).ops[0usize].reg };
                if r0 >= 0 && r0 < 32 && ((1u32 << (r0 as u32)) & rbit) != 0u32 {
                    return true;
                }
            }
            curr = unsafe { (*curr).next };
            continue;
        }
        if opc == X64_MI_JMP || opc == X64_MI_JCC || opc == X64_MI_ASSERT {
            return false;
        }
        if opc == X64_MI_RET {
            return reg != REG_RAX;
        }
        let u_mask: u32 = unsafe { peep_inst_phys_use_mask(view(*curr)) };
        if (u_mask & rbit) != 0u32 {
            return false;
        }
        let d_mask: u32 = unsafe { peep_inst_phys_def_mask(view(*curr)) };
        if (d_mask & rbit) != 0u32 && opc != X64_MI_SETCC && opc != X64_MI_CMOVCC {
            return true;
        }
        curr = unsafe { (*curr).next };
    }
    false
}

fn peep_is_stack_slot_op_v(op: view<X64Op>) -> bool {
    if op.kind == X64_OP_MEM {
        let disp = op.mem.disp;
        op.mem.base == REG_RBP && op.mem.index == REG_NONE && !op.mem.is_rip && disp < 0
    } else {
        op.kind == X64_OP_FRAME
    }
}

fn peep_same_stack_slot_v(a: view<X64Op>, b: view<X64Op>) -> bool {
    let ka = a.kind;
    if ka != b.kind {
        return false;
    }
    if ka == X64_OP_MEM {
        let disp_a = a.mem.disp;
        disp_a < 0 && disp_a == b.mem.disp &&
        a.mem.base == REG_RBP && b.mem.base == REG_RBP &&
        a.mem.index == REG_NONE && b.mem.index == REG_NONE &&
        !a.mem.is_rip && !b.mem.is_rip
    } else if ka == X64_OP_FRAME {
        a.frame.slot_id == b.frame.slot_id && a.frame.offset == b.frame.offset
    } else {
        false
    }
}

fn peep_stack_slot_overlaps_v(slot_op: view<X64Op>, slot_sz: u8, write_op: view<X64Op>, write_sz: u8) -> bool {
    let wk = write_op.kind;
    if wk == X64_OP_MEM {
        if write_op.mem.base != REG_RBP || write_op.mem.index != REG_NONE || write_op.mem.is_rip || write_op.mem.disp >= 0 {
            return true;
        }
        if slot_op.kind != X64_OP_MEM {
            return true;
        }
        let s_lo = slot_op.mem.disp as i64;
        let s_hi = s_lo + (slot_sz as i64);
        let w_lo = write_op.mem.disp as i64;
        let w_hi = w_lo + (write_sz as i64);
        s_lo < w_hi && w_lo < s_hi
    } else if wk == X64_OP_FRAME {
        if slot_op.kind != X64_OP_FRAME {
            return true;
        }
        if slot_op.frame.slot_id != write_op.frame.slot_id {
            return false;
        }
        let s_lo = slot_op.frame.offset as i64;
        let s_hi = s_lo + (slot_sz as i64);
        let w_lo = write_op.frame.offset as i64;
        let w_hi = w_lo + (write_sz as i64);
        s_lo < w_hi && w_lo < s_hi
    } else {
        false
    }
}

fn peep_cmp_zero_can_use_test(inst: *mut X64MI) -> bool {
    if (inst as usize) == 0 {
        return false;
    }
    let mut curr: *mut X64MI = unsafe { (*inst).next };
    while (curr as usize) != 0 {
        let opc: u32 = unsafe { (*curr).opcode };
        if opc == X64_MI_MOV || opc == X64_MI_LEA || opc == X64_MI_PUSH ||
           opc == X64_MI_POP || opc == X64_MI_XCHG || opc == X64_MI_MFENCE ||
           opc == X64_MI_PAUSE || opc == X64_MI_COMPILER_BARRIER || opc == X64_MI_TLS_ADDR {
            curr = unsafe { (*curr).next };
            continue;
        }
        if opc == X64_MI_JCC || opc == X64_MI_SETCC || opc == X64_MI_CMOVCC {
            let cc = unsafe { (*curr).ops[0usize].imm as u8 };
            let ok_cc = cc == CC_E || cc == CC_NE || cc == CC_S || cc == CC_NS ||
                        cc == CC_L || cc == CC_GE || cc == CC_LE || cc == CC_G ||
                        cc == CC_B || cc == CC_AE || cc == CC_BE || cc == CC_A;
            if !ok_cc {
                return false;
            }
            curr = unsafe { (*curr).next };
            continue;
        }
        if opc == X64_MI_ASSERT || opc == X64_MI_JMP {
            return false;
        }
        if opc == X64_MI_SHL || opc == X64_MI_SHR || opc == X64_MI_SAR {
            if (unsafe { (*curr).ops[1usize].kind }) == X64_OP_IMM &&
               ((unsafe { (*curr).ops[1usize].imm }) & 63i64) != 0i64 {
                return true;
            }
            curr = unsafe { (*curr).next };
            continue;
        }
        if opc == X64_MI_ADD || opc == X64_MI_SUB || opc == X64_MI_IMUL ||
           opc == X64_MI_MUL || opc == X64_MI_AND || opc == X64_MI_OR ||
           opc == X64_MI_XOR || opc == X64_MI_CMP || opc == X64_MI_TEST ||
           opc == X64_MI_CALL || opc == X64_MI_IDIV || opc == X64_MI_RET ||
           opc == X64_MI_LOCK_XADD || opc == X64_MI_LOCK_CMPXCHG ||
           opc == X64_MI_LOCK_ADD || opc == X64_MI_LOCK_SUB ||
           opc == X64_MI_LOCK_AND || opc == X64_MI_LOCK_OR ||
           opc == X64_MI_LOCK_XOR || opc == X64_MI_ATOMIC_RMW_LOOP {
            return true;
        }
        curr = unsafe { (*curr).next };
    }
    false
}

fn peep_opt_bb_stack(mbb: mut_view<X64MIBb>) -> u32 {
    let mut changes: u32 = 0u32;
    let mut s_prev: *mut X64MI = 0 as *mut X64MI;
    let mut s_cur: *mut X64MI = mbb.first_inst;
    while (s_cur as usize) != 0 {
        let s_next: *mut X64MI = unsafe { (*s_cur).next };
        if (unsafe { (*s_cur).opcode }) != X64_MI_MOV {
            s_prev = s_cur;
            s_cur = s_next;
            continue;
        }
        let raw_sz: u8 = unsafe { (*s_cur).size };
        let sz: u8 = if raw_sz == 0u8 { 8u8 } else { raw_sz };
        let mut unlinked_s = false;
        let s0_kind: u32 = unsafe { (*s_cur).ops[0usize].kind };
        let s0_disp: i32 = unsafe { (*s_cur).ops[0usize].mem.disp };
        let s0_is_slot = if s0_kind == X64_OP_MEM {
            s0_disp < 0 &&
            (unsafe { (*s_cur).ops[0usize].mem.base }) == REG_RBP &&
            (unsafe { (*s_cur).ops[0usize].mem.index }) == REG_NONE &&
            !(unsafe { (*s_cur).ops[0usize].mem.is_rip })
        } else {
            s0_kind == X64_OP_FRAME
        };

        if s0_is_slot {
            let s0_sid = unsafe { (*s_cur).ops[0usize].frame.slot_id };
            let s0_off = unsafe { (*s_cur).ops[0usize].frame.offset };
            if (s_next as usize) != 0 && (unsafe { (*s_next).opcode }) == X64_MI_MOV {
                let n_raw_sz: u8 = unsafe { (*s_next).size };
                let n_sz: u8 = if n_raw_sz == 0u8 { 8u8 } else { n_raw_sz };
                if n_sz >= sz && (unsafe { (*s_next).ops[0usize].kind }) == s0_kind {
                    let same0 = if s0_kind == X64_OP_MEM {
                        (unsafe { (*s_next).ops[0usize].mem.disp }) == s0_disp &&
                        (unsafe { (*s_next).ops[0usize].mem.base }) == REG_RBP &&
                        (unsafe { (*s_next).ops[0usize].mem.index }) == REG_NONE &&
                        !(unsafe { (*s_next).ops[0usize].mem.is_rip })
                    } else {
                        (unsafe { (*s_next).ops[0usize].frame.slot_id }) == s0_sid &&
                        (unsafe { (*s_next).ops[0usize].frame.offset }) == s0_off
                    };
                    if same0 {
                        unsafe {
                            if (s_prev as usize) != 0 {
                                (*s_prev).next = s_next;
                            } else {
                                mbb.first_inst = s_next;
                            }
                            if (mbb.last_inst as usize) == (s_cur as usize) {
                                mbb.last_inst = s_prev;
                            }
                        }
                        unlinked_s = true;
                        changes = changes + 1u32;
                    }
                }
            }

            if !unlinked_s && sz == 8u8 && (unsafe { (*s_cur).ops[1usize].kind }) == X64_OP_REG {
                let src_reg = unsafe { (*s_cur).ops[1usize].reg };
                if src_reg >= 0 && src_reg < 16 {
                    let stop_def_mask: u32 = (1u32 << (src_reg as u32)) | 0x00000030u32; // src_reg | RBP | RSP
                    let s0_lo: i64 = s0_disp as i64;
                    let s0_hi: i64 = s0_lo + 8i64;
                    let mut scan: *mut X64MI = s_next;
                    while (scan as usize) != 0 {
                        let sc_opc: u32 = unsafe { (*scan).opcode };
                        if sc_opc == X64_MI_MOV {
                            let sc_raw_sz: u8 = unsafe { (*scan).size };
                            let sc_sz: u8 = if sc_raw_sz == 0u8 { 8u8 } else { sc_raw_sz };
                            if sc_sz == 8u8 &&
                               (unsafe { (*scan).ops[0usize].kind }) == X64_OP_REG &&
                               (unsafe { (*scan).ops[1usize].kind }) == s0_kind {
                                let sc_r0 = unsafe { (*scan).ops[0usize].reg };
                                if sc_r0 >= 0 && sc_r0 < 16 {
                                    let same_sc = if s0_kind == X64_OP_MEM {
                                        (unsafe { (*scan).ops[1usize].mem.disp }) == s0_disp &&
                                        (unsafe { (*scan).ops[1usize].mem.base }) == REG_RBP &&
                                        (unsafe { (*scan).ops[1usize].mem.index }) == REG_NONE &&
                                        !(unsafe { (*scan).ops[1usize].mem.is_rip })
                                    } else {
                                        (unsafe { (*scan).ops[1usize].frame.slot_id }) == s0_sid &&
                                        (unsafe { (*scan).ops[1usize].frame.offset }) == s0_off
                                    };
                                    if same_sc {
                                        unsafe {
                                            (*scan).ops[1usize].kind = X64_OP_REG;
                                            (*scan).ops[1usize].reg = src_reg;
                                        }
                                        changes = changes + 1u32;
                                        if sc_r0 == src_reg {
                                            scan = unsafe { (*scan).next };
                                            continue;
                                        }
                                    }
                                }
                            }
                        }

                        if sc_opc == X64_MI_CALL || sc_opc == X64_MI_JMP || sc_opc == X64_MI_JCC ||
                           sc_opc == X64_MI_RET || sc_opc == X64_MI_ASSERT || sc_opc == X64_MI_PUSH ||
                           sc_opc == X64_MI_POP || sc_opc == X64_MI_IDIV || sc_opc == X64_MI_MUL ||
                           (sc_opc >= X64_MI_XCHG && sc_opc <= X64_MI_ATOMIC_RMW_LOOP) {
                            break;
                        }

                        let sc_oc: u8 = unsafe { (*scan).op_count };
                        let sc_k0: u32 = if sc_oc >= 1u8 { unsafe { (*scan).ops[0usize].kind } } else { X64_OP_NONE };
                        let mut d_mask: u32 = 0u32;
                        if sc_opc == X64_MI_MOV || sc_opc == X64_MI_ADD || sc_opc == X64_MI_SUB ||
                           sc_opc == X64_MI_IMUL || sc_opc == X64_MI_AND || sc_opc == X64_MI_OR ||
                           sc_opc == X64_MI_XOR || sc_opc == X64_MI_SHL || sc_opc == X64_MI_SAR ||
                           sc_opc == X64_MI_SHR || sc_opc == X64_MI_LEA {
                            if sc_k0 == X64_OP_REG {
                                let dr = unsafe { (*scan).ops[0usize].reg };
                                if dr >= 0 && dr < 32 { d_mask = 1u32 << (dr as u32); }
                            }
                        } else if sc_opc == X64_MI_SETCC || sc_opc == X64_MI_CMOVCC {
                            if sc_oc >= 2u8 && (unsafe { (*scan).ops[1usize].kind }) == X64_OP_REG {
                                let dr = unsafe { (*scan).ops[1usize].reg };
                                if dr >= 0 && dr < 32 { d_mask = 1u32 << (dr as u32); }
                            }
                        }
                        if (d_mask & stop_def_mask) != 0u32 {
                            break;
                        }

                        if sc_oc >= 1u8 && sc_opc != X64_MI_CMP && sc_opc != X64_MI_TEST {
                            if sc_k0 == X64_OP_MEM {
                                let w_disp = unsafe { (*scan).ops[0usize].mem.disp };
                                if s0_kind != X64_OP_MEM ||
                                   (unsafe { (*scan).ops[0usize].mem.base }) != REG_RBP ||
                                   (unsafe { (*scan).ops[0usize].mem.index }) != REG_NONE ||
                                   (unsafe { (*scan).ops[0usize].mem.is_rip }) ||
                                   w_disp >= 0 {
                                    break;
                                }
                                let sc_raw_sz2: u8 = unsafe { (*scan).size };
                                let sc_sz2: u8 = if sc_raw_sz2 == 0u8 { 8u8 } else { sc_raw_sz2 };
                                let w_lo = w_disp as i64;
                                let w_hi = w_lo + (sc_sz2 as i64);
                                if s0_lo < w_hi && w_lo < s0_hi {
                                    break;
                                }
                            } else if sc_k0 == X64_OP_FRAME {
                                let sc_raw_sz2: u8 = unsafe { (*scan).size };
                                let sc_sz2: u8 = if sc_raw_sz2 == 0u8 { 8u8 } else { sc_raw_sz2 };
                                if unsafe { peep_stack_slot_overlaps_v(view((*s_cur).ops[0usize]), sz, view((*scan).ops[0usize]), sc_sz2) } {
                                    break;
                                }
                            } else if sc_opc == X64_MI_LEA &&
                                      (unsafe { (*scan).ops[1usize].kind }) == X64_OP_MEM &&
                                      (unsafe { (*scan).ops[1usize].mem.base }) == REG_RBP &&
                                      (unsafe { (*scan).ops[1usize].mem.index }) == REG_NONE &&
                                      !(unsafe { (*scan).ops[1usize].mem.is_rip }) {
                                if s0_kind == X64_OP_MEM && (unsafe { (*scan).ops[1usize].mem.disp }) == s0_disp {
                                    break;
                                }
                            }
                        }
                        scan = unsafe { (*scan).next };
                    }
                }
            }
        } else if sz == 8u8 && s0_kind == X64_OP_REG && (s_next as usize) != 0 {
            let r0 = unsafe { (*s_cur).ops[0usize].reg };
            if r0 >= 0 && r0 < 16 {
                let s1_kind = unsafe { (*s_cur).ops[1usize].kind };
                let s1_disp = unsafe { (*s_cur).ops[1usize].mem.disp };
                let s1_is_slot = if s1_kind == X64_OP_MEM {
                    s1_disp < 0 &&
                    (unsafe { (*s_cur).ops[1usize].mem.base }) == REG_RBP &&
                    (unsafe { (*s_cur).ops[1usize].mem.index }) == REG_NONE &&
                    !(unsafe { (*s_cur).ops[1usize].mem.is_rip })
                } else {
                    s1_kind == X64_OP_FRAME
                };
                if s1_is_slot && (unsafe { (*s_next).opcode }) == X64_MI_MOV {
                    let n_raw_sz: u8 = unsafe { (*s_next).size };
                    let n_sz: u8 = if n_raw_sz == 0u8 { 8u8 } else { n_raw_sz };
                    if n_sz == 8u8 &&
                       (unsafe { (*s_next).ops[1usize].kind }) == X64_OP_REG &&
                       (unsafe { (*s_next).ops[1usize].reg }) == r0 &&
                       (unsafe { (*s_next).ops[0usize].kind }) == s1_kind {
                        let same1 = if s1_kind == X64_OP_MEM {
                            (unsafe { (*s_next).ops[0usize].mem.disp }) == s1_disp &&
                            (unsafe { (*s_next).ops[0usize].mem.base }) == REG_RBP &&
                            (unsafe { (*s_next).ops[0usize].mem.index }) == REG_NONE &&
                            !(unsafe { (*s_next).ops[0usize].mem.is_rip })
                        } else {
                            (unsafe { (*s_next).ops[0usize].frame.slot_id }) == (unsafe { (*s_cur).ops[1usize].frame.slot_id }) &&
                            (unsafe { (*s_next).ops[0usize].frame.offset }) == (unsafe { (*s_cur).ops[1usize].frame.offset })
                        };
                        if same1 {
                            let after_next: *mut X64MI = unsafe { (*s_next).next };
                            unsafe {
                                (*s_cur).next = after_next;
                                if (mbb.last_inst as usize) == (s_next as usize) {
                                    mbb.last_inst = s_cur;
                                }
                            }
                            changes = changes + 1u32;
                        }
                    }
                }
            }
        }

        if !unlinked_s {
            s_prev = s_cur;
        }
        s_cur = unsafe { (*s_cur).next };
    }
    changes
}

fn peep_opt_bb_inst(mbb: mut_view<X64MIBb>) -> u32 {
    let mut changes: u32 = 0u32;
    let mut prev: *mut X64MI = 0 as *mut X64MI;
    let mut m0: *mut X64MI = mbb.first_inst;
    while (m0 as usize) != 0 {
        let m1: *mut X64MI = unsafe { (*m0).next };
        let opc0: u32 = unsafe { (*m0).opcode };
        let raw_sz0: u8 = unsafe { (*m0).size };
        let sz0: u8 = if raw_sz0 == 0u8 { 8u8 } else { raw_sz0 };
        let k0_0: u32 = unsafe { (*m0).ops[0usize].kind };
        let k0_1: u32 = unsafe { (*m0).ops[1usize].kind };
        let mut unlink_m0 = false;

        if opc0 == X64_MI_MOV {
            if sz0 == 8u8 && k0_0 == X64_OP_REG && k0_1 == X64_OP_REG &&
               (unsafe { (*m0).ops[0usize].reg }) == (unsafe { (*m0).ops[1usize].reg }) {
                unlink_m0 = true;
            }
        } else if opc0 == X64_MI_LEA {
            if k0_0 == X64_OP_REG && k0_1 == X64_OP_MEM &&
               !(unsafe { (*m0).ops[1usize].mem.is_rip }) &&
               (unsafe { (*m0).ops[1usize].mem.index }) == REG_NONE &&
               (unsafe { (*m0).ops[1usize].mem.disp }) == 0 &&
               (unsafe { (*m0).ops[1usize].mem.base }) != REG_NONE {
                let base_r = unsafe { (*m0).ops[1usize].mem.base };
                if base_r == (unsafe { (*m0).ops[0usize].reg }) {
                    unlink_m0 = true;
                } else {
                    unsafe {
                        (*m0).opcode = X64_MI_MOV;
                        (*m0).size = 8u8;
                        (*m0).ops[1usize].kind = X64_OP_REG;
                        (*m0).ops[1usize].reg = base_r;
                    }
                    changes = changes + 1u32;
                }
            }
        } else if opc0 == X64_MI_ADD || opc0 == X64_MI_SUB || opc0 == X64_MI_OR ||
                  opc0 == X64_MI_XOR || opc0 == X64_MI_SHL || opc0 == X64_MI_SHR || opc0 == X64_MI_SAR {
            if sz0 == 8u8 && k0_0 == X64_OP_REG && k0_1 == X64_OP_IMM &&
               (unsafe { (*m0).ops[1usize].imm }) == 0i64 {
                let r_alu = unsafe { (*m0).ops[0usize].reg };
                if r_alu >= 0 && r_alu < 16 && x64_flags_are_dead_after(m0) {
                    unlink_m0 = true;
                }
            }
        }

        if !unlink_m0 && (m1 as usize) != 0 && (opc0 == X64_MI_MOV || opc0 == X64_MI_LEA) && k0_0 == X64_OP_REG {
            let opc1: u32 = unsafe { (*m1).opcode };
            if opc1 == X64_MI_MOV || opc1 == X64_MI_LEA {
                let raw_sz1: u8 = unsafe { (*m1).size };
                let sz1: u8 = if raw_sz1 == 0u8 { 8u8 } else { raw_sz1 };
                if sz1 == 8u8 && (unsafe { (*m1).ops[0usize].kind }) == X64_OP_REG {
                    let r0_0 = unsafe { (*m0).ops[0usize].reg };
                    let r1_0 = unsafe { (*m1).ops[0usize].reg };
                    let k1_1 = unsafe { (*m1).ops[1usize].kind };
                    if opc0 == X64_MI_MOV && sz0 == 8u8 && k0_1 == X64_OP_REG &&
                       opc1 == X64_MI_MOV && k1_1 == X64_OP_REG &&
                       r0_0 == (unsafe { (*m1).ops[1usize].reg }) &&
                       (unsafe { (*m0).ops[1usize].reg }) == r1_0 {
                        let after_m1: *mut X64MI = unsafe { (*m1).next };
                        unsafe {
                            (*m0).next = after_m1;
                            if (mbb.last_inst as usize) == (m1 as usize) {
                                mbb.last_inst = m0;
                            }
                        }
                        changes = changes + 1u32;
                    } else if r1_0 == r0_0 && (
                        r0_0 < 0 || r0_0 >= 32 ||
                        (k1_1 != X64_OP_REG && k1_1 != X64_OP_MEM) ||
                        (k1_1 == X64_OP_REG && (unsafe { (*m1).ops[1usize].reg }) != r0_0) ||
                        (k1_1 == X64_OP_MEM && (unsafe { (*m1).ops[1usize].mem.base }) != r0_0 && (unsafe { (*m1).ops[1usize].mem.index }) != r0_0)
                    ) {
                        unlink_m0 = true;
                    } else if sz0 == 8u8 && r0_0 >= 0 && r0_0 < 16 &&
                              opc1 == X64_MI_MOV && r1_0 >= 0 && r1_0 < 16 &&
                              k1_1 == X64_OP_REG && (unsafe { (*m1).ops[1usize].reg }) == r0_0 &&
                              (k0_1 == X64_OP_REG || k0_1 == X64_OP_IMM || k0_1 == X64_OP_MEM || k0_1 == X64_OP_FRAME) &&
                              peep_reg_dead_after(m1, r0_0) {
                        let after_m1: *mut X64MI = unsafe { (*m1).next };
                        unsafe {
                            (*m0).ops[0usize].kind = X64_OP_REG;
                            (*m0).ops[0usize].reg = r1_0;
                            (*m0).next = after_m1;
                            if (mbb.last_inst as usize) == (m1 as usize) {
                                mbb.last_inst = m0;
                            }
                        }
                        changes = changes + 1u32;
                    }
                }
            }
        }

        if !unlink_m0 {
            let cur_opc: u32 = unsafe { (*m0).opcode };
            if cur_opc == X64_MI_MOV {
                if (unsafe { (*m0).ops[0usize].kind }) == X64_OP_REG &&
                   (unsafe { (*m0).ops[1usize].kind }) == X64_OP_IMM &&
                   (unsafe { (*m0).ops[1usize].imm }) == 0i64 {
                    let r0 = unsafe { (*m0).ops[0usize].reg };
                    if r0 >= 0 && r0 < 16 && x64_flags_are_dead_after(m0) {
                        unsafe {
                            (*m0).opcode = X64_MI_XOR;
                            (*m0).size = 8u8;
                            (*m0).ops[1usize].kind = X64_OP_REG;
                            (*m0).ops[1usize].reg = r0;
                        }
                        changes = changes + 1u32;
                    }
                }
            } else if cur_opc == X64_MI_CMP {
                let raw_csz: u8 = unsafe { (*m0).size };
                if (raw_csz == 8u8 || raw_csz == 0u8) &&
                   (unsafe { (*m0).ops[0usize].kind }) == X64_OP_REG &&
                   (unsafe { (*m0).ops[1usize].kind }) == X64_OP_IMM &&
                   (unsafe { (*m0).ops[1usize].imm }) == 0i64 {
                    let r0 = unsafe { (*m0).ops[0usize].reg };
                    if r0 >= 0 && r0 < 16 && peep_cmp_zero_can_use_test(m0) {
                        unsafe {
                            (*m0).opcode = X64_MI_TEST;
                            (*m0).size = 8u8;
                            (*m0).ops[1usize].kind = X64_OP_REG;
                            (*m0).ops[1usize].reg = r0;
                            if (*m0).msg_len == 0 {
                                (*m0).msg_len = 1;
                            }
                        }
                        changes = changes + 1u32;
                    }
                }
            }
        }

        if unlink_m0 {
            let next_after_m0: *mut X64MI = unsafe { (*m0).next };
            unsafe {
                if (prev as usize) != 0 {
                    (*prev).next = next_after_m0;
                } else {
                    mbb.first_inst = next_after_m0;
                }
                if (mbb.last_inst as usize) == (m0 as usize) {
                    mbb.last_inst = prev;
                }
            }
            changes = changes + 1u32;
            m0 = next_after_m0;
        } else {
            prev = m0;
            m0 = unsafe { (*m0).next };
        }
    }
    changes
}

fn peep_opt_basic_block_ex(mbb: mut_view<X64MIBb>, out_hit_cap: mut_view<bool>) -> u32 {
    let mut total_changes: u32 = 0u32;
    let mut iter: u32 = 0u32;
    let mut changed = true;
    let mut prev_c2: u32 = 1u32;

    while changed && iter < 6u32 {
        iter = iter + 1u32;
        let c1 = peep_opt_bb_stack(mut_view(*mbb));
        if c1 == 0u32 && prev_c2 == 0u32 {
            changed = false;
            break;
        }
        let c2 = peep_opt_bb_inst(mut_view(*mbb));
        prev_c2 = c2;
        let step_c = c1 + c2;
        total_changes = total_changes + step_c;
        changed = step_c > 0u32;
    }

    *out_hit_cap = changed;
    total_changes
}

fn peep_opt_basic_block(mbb: mut_view<X64MIBb>) -> u32 {
    let mut dummy: bool = false;
    peep_opt_basic_block_ex(mut_view(*mbb), mut_view(dummy))
}

fn peep_is_fallthrough_target(body: view<X64MIBody>, from_bb: usize, target: usize) -> bool {
    if target <= from_bb || target >= body.bb_count {
        return false;
    }
    if target == from_bb + 1 {
        return true;
    }
    let mut k: usize = from_bb + 1;
    while k < target {
        let mbb_k = unsafe { x64_mi_bb_at(body.bbs, k) };
        if (unsafe { (*mbb_k).first_inst as usize }) != 0 {
            return false;
        }
        k = k + 1;
    }
    true
}

fn peep_resolve_branch_target(body: view<X64MIBody>, start_target: u32) -> u32 {
    let mut cur = start_target;
    let mut hops: u32 = 0u32;
    while (cur as usize) < body.bb_count && hops < 8u32 {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, cur as usize) };
        let first = unsafe { (*mbb).first_inst };
        if (first as usize) == 0 {
            let next_bb = cur + 1u32;
            if (next_bb as usize) < body.bb_count {
                cur = next_bb;
                hops = hops + 1u32;
            } else {
                break;
            }
        } else {
            let opc = unsafe { (*first).opcode };
            let next_inst = unsafe { (*first).next };
            if opc == X64_MI_JMP && (next_inst as usize) == 0 {
                let jmp_tgt = unsafe { (*first).ops[0usize].imm as u32 };
                if jmp_tgt != cur && (jmp_tgt as usize) < body.bb_count {
                    cur = jmp_tgt;
                    hops = hops + 1u32;
                } else {
                    break;
                }
            } else {
                break;
            }
        }
    }
    cur
}

fn peep_opt_cfg_tracked(body: mut_view<X64MIBody>, bb_dirty: *mut u8) -> u32 {
    if body.bb_count == 0 || (body.bbs as usize) == 0 {
        return 0u32;
    }
    let mut changes: u32 = 0u32;

    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let opc = unsafe { (*inst).opcode };
            if opc == X64_MI_JMP {
                let t0 = unsafe { (*inst).ops[0usize].imm as u32 };
                let t1 = peep_resolve_branch_target(view(*body), t0);
                if t1 != t0 && (t1 as usize) < body.bb_count {
                    unsafe {
                        (*inst).ops[0usize].kind = X64_OP_IMM;
                        (*inst).ops[0usize].imm = t1 as i64;
                        if (bb_dirty as usize) != 0 { *(((bb_dirty as usize) + b) as *mut u8) = 1u8; }
                    }
                    changes = changes + 1u32;
                }
            } else if opc == X64_MI_JCC {
                let t0 = unsafe { (*inst).ops[1usize].imm as u32 };
                let t1 = peep_resolve_branch_target(view(*body), t0);
                if t1 != t0 && (t1 as usize) < body.bb_count {
                    unsafe {
                        (*inst).ops[1usize].kind = X64_OP_IMM;
                        (*inst).ops[1usize].imm = t1 as i64;
                        if (bb_dirty as usize) != 0 { *(((bb_dirty as usize) + b) as *mut u8) = 1u8; }
                    }
                    changes = changes + 1u32;
                }
            }
            inst = unsafe { (*inst).next };
        }
        b = b + 1;
    }

    let mut b2: usize = 0;
    while b2 < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b2) };
        let last_inst = unsafe { (*mbb).last_inst };
        if (last_inst as usize) != 0 && (unsafe { (*last_inst).opcode }) == X64_MI_JMP {
            let mut prev2: *mut X64MI = 0 as *mut X64MI;
            let mut prev1: *mut X64MI = 0 as *mut X64MI;
            let mut cur: *mut X64MI = unsafe { (*mbb).first_inst };
            while (cur as usize) != 0 {
                let nxt = unsafe { (*cur).next };
                if (nxt as usize) != 0 {
                    prev2 = prev1;
                    prev1 = cur;
                    cur = nxt;
                } else {
                    break;
                }
            }

            if (cur as usize) != 0 && (unsafe { (*cur).opcode }) == X64_MI_JMP {
                let jmp_tgt = (unsafe { (*cur).ops[0usize].imm }) as usize;

                let mut inverted = false;
                if (prev1 as usize) != 0 && (unsafe { (*prev1).opcode }) == X64_MI_JCC {
                    let cc = (unsafe { (*prev1).ops[0usize].imm }) as u8;
                    let jcc_tgt = (unsafe { (*prev1).ops[1usize].imm }) as usize;
                    if peep_is_fallthrough_target(view(*body), b2, jcc_tgt) {
                        let inv_cc = x64_cc_invert(cc);
                        unsafe {
                            (*prev1).ops[0usize].kind = X64_OP_IMM;
                            (*prev1).ops[0usize].imm = inv_cc as i64;
                            (*prev1).ops[1usize].kind = X64_OP_IMM;
                            (*prev1).ops[1usize].imm = jmp_tgt as i64;
                            (*prev1).next = 0 as *mut X64MI;
                            (*mbb).last_inst = prev1;
                            if (bb_dirty as usize) != 0 { *(((bb_dirty as usize) + b2) as *mut u8) = 1u8; }
                        }
                        inverted = true;
                        changes = changes + 1u32;
                        cur = prev1;
                        prev1 = prev2;
                    }
                }

                if !inverted && peep_is_fallthrough_target(view(*body), b2, jmp_tgt) {
                    unsafe {
                        if (prev1 as usize) != 0 {
                            (*prev1).next = 0 as *mut X64MI;
                            (*mbb).last_inst = prev1;
                        } else {
                            (*mbb).first_inst = 0 as *mut X64MI;
                            (*mbb).last_inst = 0 as *mut X64MI;
                        }
                        if (bb_dirty as usize) != 0 { *(((bb_dirty as usize) + b2) as *mut u8) = 1u8; }
                    }
                    changes = changes + 1u32;
                }
            }
        }
        b2 = b2 + 1;
    }

    changes
}

pub fn x64_peephole_opt_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>
) -> u32 {
    if body.bb_count == 0 || (body.bbs as usize) == 0 {
        return 0u32;
    }
    let bb_retry = arena_alloc_raw(mut_view(*arena), body.bb_count, 1) as *mut u8;
    let mut total: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut hit_cap: bool = false;
        let c = unsafe { peep_opt_basic_block_ex(mut_view(*mbb), mut_view(hit_cap)) };
        unsafe { *(((bb_retry as usize) + b) as *mut u8) = if hit_cap { 1u8 } else { 0u8 }; }
        total = total + c;
        b = b + 1;
    }
    let cfg_c = peep_opt_cfg_tracked(mut_view(*body), bb_retry);
    total = total + cfg_c;
    if cfg_c > 0u32 {
        let mut b2: usize = 0;
        while b2 < body.bb_count {
            if (unsafe { *(((bb_retry as usize) + b2) as *mut u8) }) != 0u8 {
                let mbb2 = unsafe { x64_mi_bb_at(body.bbs, b2) };
                let c2 = unsafe { peep_opt_basic_block(mut_view(*mbb2)) };
                total = total + c2;
            }
            b2 = b2 + 1;
        }
    }
    total
}

pub fn x64_peephole_opt(body: mut_view<X64MIBody>) -> u32 {
    let arena_ptr = body.arena;
    unsafe {
        x64_peephole_opt_in_arena(mut_view(*arena_ptr), mut_view(*body))
    }
}

// Optimizing (`-O1` / `-O2`) frame lowering with linear-scan register allocation,
// colored spill slots, and dynamic callee-saved register save/restore (`SPEC-77`).
pub fn x64_frame_lower_opt_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    opt_level: u8
) -> X64FrameLayout {
    if opt_level == 0u8 || lir.bb_count == 0 {
        return x64_frame_lower_baseline_in_arena(mut_view(*arena), mut_view(*body), lir, interner);
    }

    let ra = x64_regalloc_in_arena(mut_view(*arena), mut_view(*body), lir, interner);

    // Check if any instruction in `body` explicitly clobbers a callee-saved GPR (e.g. `REG_RBX` in `uoverflow`).
    let mut extra_callee_mask: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let opc = unsafe { (*inst).opcode };
            if opc == X64_MI_MOV || opc == X64_MI_ADD || opc == X64_MI_SUB ||
               opc == X64_MI_IMUL || opc == X64_MI_AND || opc == X64_MI_OR ||
               opc == X64_MI_XOR || opc == X64_MI_SHL || opc == X64_MI_SAR ||
               opc == X64_MI_SHR || opc == X64_MI_LEA || opc == X64_MI_POP {
                if (unsafe { (*inst).op_count }) >= 1u8 && (unsafe { (*inst).ops[0usize].kind }) == X64_OP_REG {
                    let r = unsafe { (*inst).ops[0usize].reg };
                    if r >= 0 && r < 32 {
                        extra_callee_mask = extra_callee_mask | ((1u32 << (r as u32)) & X64_ALL_CALLEE_SAVED_MASK);
                    }
                }
            } else if opc == X64_MI_SETCC || opc == X64_MI_CMOVCC {
                if (unsafe { (*inst).op_count }) >= 2u8 && (unsafe { (*inst).ops[1usize].kind }) == X64_OP_REG {
                    let r = unsafe { (*inst).ops[1usize].reg };
                    if r >= 0 && r < 32 {
                        extra_callee_mask = extra_callee_mask | ((1u32 << (r as u32)) & X64_ALL_CALLEE_SAVED_MASK);
                    }
                }
            } else if opc == X64_MI_XCHG || opc == X64_MI_LOCK_XADD {
                let dm = unsafe { mi_inst_phys_def_mask(view(*inst)) };
                extra_callee_mask = extra_callee_mask | (dm & X64_ALL_CALLEE_SAVED_MASK);
            }
            inst = unsafe { (*inst).next };
        }
        b = b + 1;
    }

    let used_callee_mask = ra.used_callee_saved_mask | extra_callee_mask;
    let gpr_callee_cnt = x64_popcount_u32(used_callee_mask & X64_GPR_CALLEE_SAVED_MASK);
    let pushed_callee_bytes = gpr_callee_cnt * 8u32;
    let xmm_callee_cnt = x64_popcount_u32(used_callee_mask & X64_XMM_CALLEE_SAVED_MASK);

    let total_slots = (lir.slot_count + lir.vreg_count) as u32;
    let alloc_words = (total_slots + 5u32) as usize;
    let offsets_ptr = arena_alloc_raw(mut_view(*arena), alloc_words << 2, 4) as *mut i32;

    let mut current_offset: i32 = pushed_callee_bytes as i32;

    // Reserve 16-byte-aligned slots for any used callee-saved XMM registers (XMM6..XMM15).
    let mut xmm_save_offset: i32 = 0;
    if xmm_callee_cnt > 0u32 {
        current_offset = frame_align_up_i32(current_offset + 16, 16);
        xmm_save_offset = 0 - current_offset;
        current_offset = current_offset + (((xmm_callee_cnt - 1u32) * 16u32) as i32);
    }

    let sh0 = body.shadow_space;
    if sh0 < 32u32 {
        body.shadow_space = 32u32;
    }

    let mut i: usize = 0;
    while i < lir.slot_count {
        let slot = unsafe { lir_slot_at(lir.slots, i) };
        if unsafe { (*slot).is_const } {
            unsafe {
                *(((offsets_ptr as usize) + (i << 2)) as *mut i32) = 0;
            }
        } else {
            let sty_v = unsafe { (*slot).ty.v };
            let mut size = x64_cached_type_size(TypeId { v: sty_v }, interner);
            let mut align = x64_cached_type_align(TypeId { v: sty_v }, interner);
            if size < 8u32 { size = 8u32; }
            size = size + 8u32;
            if align < 8u32 { align = 8u32; }
            current_offset = frame_align_up_i32(current_offset + (size as i32), align as i32);
            unsafe {
                *(((offsets_ptr as usize) + (i << 2)) as *mut i32) = 0 - current_offset;
            }
        }
        i = i + 1;
    }

    // Assign RBP-relative offsets to colored spill slots (`AXS-RA-023`).
    let cslot_stride = size_of<X64ColoredSpillSlot>();
    let mut cs: u32 = 0u32;
    let mut csp_addr: usize = ra.spill_slots.slots as usize;
    while cs < ra.spill_slots.slot_count {
        let csp = csp_addr as *mut X64ColoredSpillSlot;
        let sz = unsafe { (*csp).size };
        let al = unsafe { (*csp).align };
        current_offset = frame_align_up_i32(current_offset + (sz as i32), al as i32);
        unsafe {
            (*csp).rbp_offset = 0 - current_offset;
        }
        csp_addr = csp_addr + cslot_stride;
        cs = cs + 1u32;
    }

    let iv_stride = size_of<X64LiveInterval>();
    let mut v: usize = 0;
    let mut iv_addr: usize = ra.intervals as usize;
    let v_off_base: usize = (offsets_ptr as usize) + (lir.slot_count << 2);
    while v < lir.vreg_count {
        let sslot = unsafe { (*(iv_addr as *const X64LiveInterval)).spill_slot };
        if sslot >= 0 && (sslot as u32) < ra.spill_slots.slot_count {
            let csp = ((ra.spill_slots.slots as usize) + ((sslot as usize) * cslot_stride)) as *const X64ColoredSpillSlot;
            unsafe {
                *((v_off_base + (v << 2)) as *mut i32) = (*csp).rbp_offset;
            }
        } else {
            unsafe {
                *((v_off_base + (v << 2)) as *mut i32) = 0;
            }
        }
        iv_addr = iv_addr + iv_stride;
        v = v + 1;
    }

    current_offset = current_offset + (body.shadow_space as i32);
    // Align total RBP-relative offset (`pushed_callee_bytes + frame_size`) to a multiple of 16 bytes.
    current_offset = frame_align_up_i32(current_offset, 16);
    let frame_size = (current_offset - (pushed_callee_bytes as i32)) as u32;

    frame_write_meta(offsets_ptr, total_slots, frame_size, used_callee_mask, pushed_callee_bytes, xmm_save_offset);

    let layout = X64FrameLayout {
        slot_offsets: offsets_ptr,
        slot_count: total_slots,
        frame_size: frame_size,
    };

    x64_frame_rewrite_ops(mut_view(*body), view(layout));
    if body.is_opt {
        x64_peephole_opt_in_arena(mut_view(*arena), mut_view(*body));
    }
    x64_verify(view(*body), view(layout));
    layout
}

pub fn x64_frame_lower_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64FrameLayout {
    if lir.bb_count > 0 && (lir.vreg_count > 2 || body.is_opt) {
        x64_frame_lower_opt_in_arena(mut_view(*arena), mut_view(*body), lir, interner, 1u8)
    } else {
        x64_frame_lower_baseline_in_arena(mut_view(*arena), mut_view(*body), lir, interner)
    }
}

pub fn x64_frame_lower(
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64FrameLayout {
    let arena_ptr = body.arena;
    unsafe {
        x64_frame_lower_in_arena(mut_view(*arena_ptr), mut_view(*body), lir, interner)
    }
}

pub fn ax_x64_frame_lower(
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    arena: mut_view<Arena>
) -> X64FrameLayout {
    x64_frame_lower_in_arena(mut_view(*arena), mut_view(*body), lir, interner)
}

// Helper for lowering a standalone `X64MIBody` with `slot_count` 8-byte slots without a `LirBody`.
pub fn x64_frame_lower_raw(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    slot_count: u32
) -> X64FrameLayout {
    let mut offsets_ptr: *mut i32 = 0 as *mut i32;
    if slot_count > 0u32 {
        offsets_ptr = arena_alloc_raw(mut_view(*arena), (slot_count as usize) << 2, 4) as *mut i32;
    }

    let mut current_offset: i32 = 56;
    let sh1 = body.shadow_space;
    if sh1 < 32u32 {
        body.shadow_space = 32u32;
    }

    let mut i: u32 = 0u32;
    while i < slot_count {
        current_offset = frame_align_up_i32(current_offset + 8, 8);
        unsafe {
            *(((offsets_ptr as usize) + ((i as usize) << 2)) as *mut i32) = 0 - current_offset;
        }
        i = i + 1u32;
    }

    current_offset = current_offset + (body.shadow_space as i32);
    current_offset = frame_align_up_i32(current_offset, 16);

    let layout = X64FrameLayout {
        slot_offsets: offsets_ptr,
        slot_count: slot_count,
        frame_size: (current_offset - 56) as u32,
    };

    x64_frame_rewrite_ops(mut_view(*body), view(layout));
    layout
}

// =============================================================================
// 8. Prologue & Epilogue Synthesis (SPEC-77 §3.4, AXS-RA-021, REQ-OPT-212)
// =============================================================================

pub fn x64_frame_emit_prologue(sec: mut_view<Section>, layout: view<X64FrameLayout>) {
    if x64_frame_has_meta(layout) {
        let mask = x64_frame_callee_saved_mask(layout);
        let xmm_off = x64_frame_xmm_save_offset(layout);
        x64_emit_prologue_masked(mut_view(*sec), layout.frame_size, mask, xmm_off);
    } else {
        x64_emit_prologue_size(mut_view(*sec), layout.frame_size);
    }
}

pub fn ax_x64_frame_emit_prologue(sec: mut_view<Section>, layout: view<X64FrameLayout>) {
    x64_frame_emit_prologue(mut_view(*sec), layout);
}

pub fn x64_frame_emit_epilogue(sec: mut_view<Section>, layout: view<X64FrameLayout>) {
    if x64_frame_has_meta(layout) {
        let mask = x64_frame_callee_saved_mask(layout);
        let xmm_off = x64_frame_xmm_save_offset(layout);
        x64_emit_epilogue_masked(mut_view(*sec), layout.frame_size, mask, xmm_off);
    } else {
        x64_emit_epilogue_size(mut_view(*sec), layout.frame_size);
    }
}

pub fn ax_x64_frame_emit_epilogue(sec: mut_view<Section>, layout: view<X64FrameLayout>) {
    x64_frame_emit_epilogue(mut_view(*sec), layout);
}

// =============================================================================
// 9. Machine IR Verifier (target/x64/verify/{verify.h,verify.c})
// =============================================================================

pub const X64_VERIFY_OK: u32 = 0u32;
pub const X64_VERIFY_ERR_SHADOW_SPACE: u32 = 1u32;
pub const X64_VERIFY_ERR_ALIGNMENT: u32 = 2u32;
pub const X64_VERIFY_ERR_FRAME_SIZE: u32 = 3u32;
pub const X64_VERIFY_ERR_MEM_MEM: u32 = 4u32;
pub const X64_VERIFY_ERR_OPERAND_FORM: u32 = 5u32;
pub const X64_VERIFY_ERR_IMUL_FORM: u32 = 6u32;
pub const X64_VERIFY_ERR_LEA_FORM: u32 = 7u32;
pub const X64_VERIFY_ERR_SHIFT_REG_CLASS: u32 = 8u32;
pub const X64_VERIFY_ERR_SHIFT_FORM: u32 = 9u32;
pub const X64_VERIFY_ERR_IDIV_FORM: u32 = 10u32;

pub fn x64_verify_error_msg(code: u32) -> Str {
    if code == X64_VERIFY_OK {
        "ok"
    } else if code == X64_VERIFY_ERR_SHADOW_SPACE {
        "Machine IR verifier: shadow space is present but < 32 bytes"
    } else if code == X64_VERIFY_ERR_ALIGNMENT {
        "Machine IR verifier: 16-byte alignment violated at call site"
    } else if code == X64_VERIFY_ERR_FRAME_SIZE {
        "Machine IR verifier: frame size consistency violated"
    } else if code == X64_VERIFY_ERR_MEM_MEM {
        "Machine IR verifier: illegal instruction form (mem, mem)"
    } else if code == X64_VERIFY_ERR_OPERAND_FORM {
        "Machine IR verifier: illegal operand form for opcode"
    } else if code == X64_VERIFY_ERR_IMUL_FORM {
        "Machine IR verifier: illegal operand form for imul"
    } else if code == X64_VERIFY_ERR_LEA_FORM {
        "Machine IR verifier: illegal operand form for lea"
    } else if code == X64_VERIFY_ERR_SHIFT_REG_CLASS {
        "Machine IR verifier: wrong register class"
    } else if code == X64_VERIFY_ERR_SHIFT_FORM {
        "Machine IR verifier: illegal operand form for shift"
    } else if code == X64_VERIFY_ERR_IDIV_FORM {
        "Machine IR verifier: illegal operand form for idiv"
    } else {
        "Machine IR verifier: unknown error"
    }
}

pub fn x64_verify_checked(body: view<X64MIBody>, layout: view<X64FrameLayout>) -> u32 {
    let sh = body.shadow_space;
    let fs = layout.frame_size;
    let callee_bytes = x64_frame_callee_saved_bytes(layout);
    if sh > 0u32 && sh < 32u32 {
        return X64_VERIFY_ERR_SHADOW_SPACE;
    }
    if sh > 0u32 && (((fs + callee_bytes) & 15u32) != 0u32) {
        return X64_VERIFY_ERR_ALIGNMENT;
    }
    if fs < sh {
        return X64_VERIFY_ERR_FRAME_SIZE;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let oc = unsafe { (*inst).op_count };
            if oc == 2u8 {
                let k0 = unsafe { (*inst).ops[0usize].kind };
                let k1 = unsafe { (*inst).ops[1usize].kind };
                if k0 == X64_OP_MEM && k1 == X64_OP_MEM {
                    return X64_VERIFY_ERR_MEM_MEM;
                }
                let opc = unsafe { (*inst).opcode };
                if opc == X64_MI_MOV || opc == X64_MI_ADD || opc == X64_MI_SUB ||
                   opc == X64_MI_AND || opc == X64_MI_OR || opc == X64_MI_XOR {
                    if !((k0 == X64_OP_REG || k0 == X64_OP_MEM) &&
                         (k1 == X64_OP_REG || k1 == X64_OP_MEM || k1 == X64_OP_IMM)) {
                        return X64_VERIFY_ERR_OPERAND_FORM;
                    }
                } else if opc == X64_MI_LEA {
                    if !(k0 == X64_OP_REG && (k1 == X64_OP_MEM || k1 == X64_OP_SYM)) {
                        return X64_VERIFY_ERR_LEA_FORM;
                    }
                } else if opc == X64_MI_IMUL {
                    if !(k0 == X64_OP_REG && (k1 == X64_OP_REG || k1 == X64_OP_MEM)) {
                        return X64_VERIFY_ERR_IMUL_FORM;
                    }
                } else if opc == X64_MI_SHL || opc == X64_MI_SAR || opc == X64_MI_SHR {
                    if (k0 == X64_OP_REG || k0 == X64_OP_MEM) && k1 == X64_OP_IMM {
                        // ok
                    } else if (k0 == X64_OP_REG || k0 == X64_OP_MEM) && k1 == X64_OP_REG {
                        if (unsafe { (*inst).ops[1usize].reg }) != REG_RCX {
                            return X64_VERIFY_ERR_SHIFT_REG_CLASS;
                        }
                    } else {
                        return X64_VERIFY_ERR_SHIFT_FORM;
                    }
                } else if opc == X64_MI_XCHG {
                    if !((k0 == X64_OP_MEM || k0 == X64_OP_REG) && k1 == X64_OP_REG) {
                        return X64_VERIFY_ERR_OPERAND_FORM;
                    }
                } else if (opc >= X64_MI_LOCK_XADD && opc <= X64_MI_LOCK_XOR) || opc == X64_MI_ATOMIC_RMW_LOOP {
                    if !(k0 == X64_OP_MEM && k1 == X64_OP_REG) {
                        return X64_VERIFY_ERR_OPERAND_FORM;
                    }
                }
            } else if oc == 3u8 {
                let opc = unsafe { (*inst).opcode };
                if opc == X64_MI_CMOVCC {
                    let k0 = unsafe { (*inst).ops[0usize].kind };
                    let k1 = unsafe { (*inst).ops[1usize].kind };
                    let k2 = unsafe { (*inst).ops[2usize].kind };
                    if !(k0 == X64_OP_IMM && k1 == X64_OP_REG && (k2 == X64_OP_REG || k2 == X64_OP_MEM)) {
                        return X64_VERIFY_ERR_OPERAND_FORM;
                    }
                } else if opc == X64_MI_ATOMIC_RMW_LOOP {
                    let k0 = unsafe { (*inst).ops[0usize].kind };
                    let k1 = unsafe { (*inst).ops[1usize].kind };
                    let k2 = unsafe { (*inst).ops[2usize].kind };
                    if !(k0 == X64_OP_MEM && k1 == X64_OP_REG && k2 == X64_OP_IMM) {
                        return X64_VERIFY_ERR_OPERAND_FORM;
                    }
                }
            } else if oc == 1u8 {
                if (unsafe { (*inst).opcode }) == X64_MI_IDIV && (unsafe { (*inst).ops[0usize].kind }) == X64_OP_IMM {
                    return X64_VERIFY_ERR_IDIV_FORM;
                }
            }
            inst = unsafe { (*inst).next };
        }
        b = b + 1;
    }
    X64_VERIFY_OK
}

pub fn x64_verify(body: view<X64MIBody>, layout: view<X64FrameLayout>) {
    let err = x64_verify_checked(body, layout);
    assert(err == X64_VERIFY_OK);
}

pub fn ax_x64_verify(body: view<X64MIBody>, layout: view<X64FrameLayout>) {
    x64_verify(body, layout);
}

// =============================================================================
// 10. Machine IR-to-Section Encoding & Hex Formatting (driver/{emit_mc.c,emit_obj.c,build.c})
// =============================================================================

pub fn x64_encode_mi_inst(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>
) {
    let opc = inst.opcode;
    let sz = if inst.size != 0u8 { inst.size } else { 8u8 };
    let k0 = inst.ops[0usize].kind;
    let k1 = inst.ops[1usize].kind;

    if opc == X64_MI_MOV {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            let r0 = inst.ops[0usize].reg;
            let r1 = inst.ops[1usize].reg;
            if x64_reg_is_xmm(r0) && x64_reg_is_xmm(r1) {
                x64_movaps_rr(mut_view(*sec), r0, r1);
            } else {
                x64_mov_rr(mut_view(*sec), sz, r0, r1);
            }
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            let r0 = inst.ops[0usize].reg;
            if x64_reg_is_xmm(r0) {
                x64_movups_rm(mut_view(*sec), r0, inst.ops[1usize].mem);
            } else {
                x64_mov_rm(mut_view(*sec), sz, r0, inst.ops[1usize].mem);
            }
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            let r1 = inst.ops[1usize].reg;
            if x64_reg_is_xmm(r1) {
                x64_movups_mr(mut_view(*sec), inst.ops[0usize].mem, r1);
            } else {
                x64_mov_mr(mut_view(*sec), sz, inst.ops[0usize].mem, r1);
            }
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_mov_ri(mut_view(*sec), sz, inst.ops[0usize].reg, inst.ops[1usize].imm);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_IMM {
            x64_mov_mi(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_ADD {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_add_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_add_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_add_mr(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_add_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_SUB {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_sub_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_sub_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_sub_mr(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_sub_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_LEA {
        if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_lea(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_REG && k1 == X64_OP_SYM {
            x64_lea_sym(mut_view(*sec), inst.ops[0usize].reg, SymbolId { v: inst.ops[1usize].sym });
        }
    } else if opc == X64_MI_CMP {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_cmp_rr(mut_view(*sec), sz, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_cmp_rm(mut_view(*sec), sz, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_cmp_ri(mut_view(*sec), sz, inst.ops[0usize].reg, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_TEST {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_test_rr(mut_view(*sec), sz, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_test_rm(mut_view(*sec), sz, inst.ops[0usize].reg, inst.ops[1usize].mem);
        }
    } else if opc == X64_MI_XOR {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_xor_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_xor_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_xor_mr(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_xor_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_AND {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_and_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_and_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_and_mr(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_and_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_OR {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_or_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_or_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_or_mr(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_or_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_SHL {
        if k1 == X64_OP_IMM {
            x64_shl_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as u8);
        } else if k1 == X64_OP_REG && inst.ops[1usize].reg == REG_RCX {
            x64_shl_rcl(mut_view(*sec), 8u8, inst.ops[0usize].reg);
        }
    } else if opc == X64_MI_SAR {
        if k1 == X64_OP_IMM {
            x64_sar_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as u8);
        } else if k1 == X64_OP_REG && inst.ops[1usize].reg == REG_RCX {
            x64_sar_rcl(mut_view(*sec), 8u8, inst.ops[0usize].reg);
        }
    } else if opc == X64_MI_SHR {
        if k1 == X64_OP_IMM {
            x64_shr_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as u8);
        } else if k1 == X64_OP_REG && inst.ops[1usize].reg == REG_RCX {
            x64_shr_rcl(mut_view(*sec), 8u8, inst.ops[0usize].reg);
        }
    } else if opc == X64_MI_IMUL {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_imul_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_imul_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        }
    } else if opc == X64_MI_SETCC {
        if k0 == X64_OP_IMM && k1 == X64_OP_REG {
            x64_setcc_r(mut_view(*sec), inst.ops[0usize].imm as u8, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_CMOVCC {
        let k2 = inst.ops[2usize].kind;
        if k0 == X64_OP_IMM && k1 == X64_OP_REG && k2 == X64_OP_REG {
            x64_cmovcc_rr(mut_view(*sec), sz, inst.ops[0usize].imm as u8, inst.ops[1usize].reg, inst.ops[2usize].reg);
        } else if k0 == X64_OP_IMM && k1 == X64_OP_REG && k2 == X64_OP_MEM {
            x64_cmovcc_rm(mut_view(*sec), sz, inst.ops[0usize].imm as u8, inst.ops[1usize].reg, inst.ops[2usize].mem);
        }
    } else if opc == X64_MI_RET {
        x64_frame_emit_epilogue(mut_view(*sec), layout);
        x64_ret(mut_view(*sec));
    } else if opc == X64_MI_JMP {
        if k0 == X64_OP_IMM {
            x64_jmp(mut_view(*sec), inst.ops[0usize].imm as i32);
        }
    } else if opc == X64_MI_JCC {
        if k0 == X64_OP_IMM && k1 == X64_OP_IMM {
            x64_jcc(mut_view(*sec), inst.ops[0usize].imm as u8, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_CALL {
        if inst.op_count > 0u8 && k0 == X64_OP_REG {
            x64_call_r(mut_view(*sec), inst.ops[0usize].reg);
        }
    } else if opc == X64_MI_MUL {
        if k0 == X64_OP_REG {
            x64_mul_r(mut_view(*sec), 8u8, inst.ops[0usize].reg);
        } else if k0 == X64_OP_MEM {
            x64_mul_m(mut_view(*sec), 8u8, inst.ops[0usize].mem);
        }
    } else if opc == X64_MI_IDIV {
        if k0 == X64_OP_REG {
            x64_idiv_r(mut_view(*sec), 8u8, inst.ops[0usize].reg);
        } else if k0 == X64_OP_MEM {
            x64_idiv_m(mut_view(*sec), 8u8, inst.ops[0usize].mem);
        }
    } else if opc == X64_MI_PUSH {
        if k0 == X64_OP_REG {
            x64_push_r(mut_view(*sec), inst.ops[0usize].reg);
        }
    } else if opc == X64_MI_POP {
        if k0 == X64_OP_REG {
            x64_pop_r(mut_view(*sec), inst.ops[0usize].reg);
        }
    } else if opc == X64_MI_XCHG {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_xchg_rr(mut_view(*sec), sz, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_xchg_mr(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_LOCK_XADD {
        if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_lock_xadd_mr(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_LOCK_CMPXCHG {
        if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_lock_cmpxchg_mr(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_LOCK_ADD {
        if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_lock_add_mr(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_LOCK_SUB {
        if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_lock_sub_mr(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_LOCK_AND {
        if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_lock_and_mr(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_LOCK_OR {
        if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_lock_or_mr(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_LOCK_XOR {
        if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_lock_xor_mr(mut_view(*sec), sz, inst.ops[0usize].mem, inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_MFENCE {
        x64_mfence(mut_view(*sec));
    } else if opc == X64_MI_PAUSE {
        x64_pause(mut_view(*sec));
    } else if opc == X64_MI_COMPILER_BARRIER {
        // Compiler-only barrier emits zero machine instructions (AXS-ATM-045).
    } else if opc == X64_MI_ATOMIC_RMW_LOOP {
        if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            let rmw_op = if inst.op_count >= 3u8 { inst.ops[2usize].imm as u8 } else { inst.msg_len as u8 };
            let r1 = inst.ops[1usize].reg;
            x64_mov_rm(mut_view(*sec), sz, REG_RAX, inst.ops[0usize].mem);
            let retry_off = sec.bytes_len as u32;
            x64_mov_rr(mut_view(*sec), sz, REG_R8, REG_RAX);
            if rmw_op == LIR_ATOMIC_RMW_AND {
                x64_and_rr(mut_view(*sec), sz, REG_R8, r1);
            } else if rmw_op == LIR_ATOMIC_RMW_OR {
                x64_or_rr(mut_view(*sec), sz, REG_R8, r1);
            } else {
                x64_xor_rr(mut_view(*sec), sz, REG_R8, r1);
            }
            x64_lock_cmpxchg_mr(mut_view(*sec), sz, inst.ops[0usize].mem, REG_R8);
            let rel8 = x64_compute_rel8(sec.bytes_len as u32, 2u32, retry_off);
            x64_jcc8(mut_view(*sec), CC_NE, rel8);
        }
    }
}

pub fn x64_encode_mi_inst_obj(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>,
    obj: mut_view<ObjModel>
) {
    let opc = inst.opcode;
    if opc == X64_MI_CALL {
        if (inst.msg as usize) != 0 {
            x64_call_extern(mut_view(*sec), mut_view(*obj), inst.msg);
        } else if inst.op_count > 0u8 && inst.ops[0usize].kind == X64_OP_REG {
            x64_call_r(mut_view(*sec), inst.ops[0usize].reg);
        }
    } else if opc == X64_MI_LEA && inst.ops[0usize].kind == X64_OP_REG && inst.ops[1usize].kind == X64_OP_SYM {
        if (inst.msg as usize) != 0 {
            x64_lea_extern(mut_view(*sec), mut_view(*obj), inst.ops[0usize].reg, inst.msg);
        } else {
            x64_lea_sym(mut_view(*sec), inst.ops[0usize].reg, SymbolId { v: inst.ops[1usize].sym });
        }
    } else if opc == X64_MI_TLS_ADDR {
        x64_emit_tls_addr_obj(mut_view(*sec), mut_view(*obj), inst.ops[0usize].reg, inst.msg);
    } else {
        x64_encode_mi_inst(mut_view(*sec), inst, layout);
    }
}

fn x64_encode_mi_inst_mc(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>
) {
    let opc = inst.opcode;
    let k0 = inst.ops[0usize].kind;
    let k1 = inst.ops[1usize].kind;

    if opc == X64_MI_MOV {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_mov_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_mov_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_mov_mr(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_mov_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_IMM {
            x64_mov_mi(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_ADD {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_add_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_add_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_add_mr(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_add_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_SUB {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_sub_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_sub_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
            x64_sub_mr(mut_view(*sec), 8u8, inst.ops[0usize].mem, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_IMM {
            x64_sub_ri(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].imm as i32);
        }
    } else if opc == X64_MI_IMUL {
        if k0 == X64_OP_REG && k1 == X64_OP_REG {
            x64_imul_rr(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].reg);
        } else if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_imul_rm(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        }
    } else if opc == X64_MI_LEA {
        if k0 == X64_OP_REG && k1 == X64_OP_MEM {
            x64_lea(mut_view(*sec), 8u8, inst.ops[0usize].reg, inst.ops[1usize].mem);
        } else if k0 == X64_OP_REG && k1 == X64_OP_SYM {
            x64_lea_sym(mut_view(*sec), inst.ops[0usize].reg, SymbolId { v: 0u32 });
        }
    } else if opc >= X64_MI_XCHG && opc <= X64_MI_ATOMIC_RMW_LOOP {
        x64_encode_mi_inst(mut_view(*sec), inst, layout);
    } else if opc == X64_MI_RET {
        x64_frame_emit_epilogue(mut_view(*sec), layout);
        x64_ret(mut_view(*sec));
    }
}

// Emit prologue + all instructions of `body` into `sec` (matching `emit_mc.c`).
pub fn x64_emit_mi_body_mc(
    sec: mut_view<Section>,
    body: view<X64MIBody>,
    layout: view<X64FrameLayout>
) {
    x64_frame_emit_prologue(mut_view(*sec), layout);
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            unsafe {
                x64_encode_mi_inst_mc(mut_view(*sec), view(*inst), layout);
                inst = (*inst).next;
            }
        }
        b = b + 1;
    }
}

@derive(Copy)
struct BranchFixupEntry {
    fixup: u32,
    target: u32,
}

unsafe fn frame_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    ((base as usize) + (idx << 2)) as *mut u32
}

unsafe fn frame_fixup_at(base: *mut BranchFixupEntry, idx: usize) -> *mut BranchFixupEntry {
    ((base as usize) + (idx << 3)) as *mut BranchFixupEntry
}

// Emit prologue + all basic blocks with branch fixup resolution into `sec` (matching `emit_obj.c` / `build.c`).
pub fn x64_emit_mi_body_obj(
    sec: mut_view<Section>,
    body: view<X64MIBody>,
    layout: view<X64FrameLayout>,
    obj: mut_view<ObjModel>
) {
    x64_frame_emit_prologue(mut_view(*sec), layout);
    if body.bb_count > 0 {
        let bb_offsets = unsafe {
            arena_alloc_raw(mut_view(*body.arena), body.bb_count << 2, 4) as *mut u32
        };

        // Count branch instructions to allocate fixup table in the arena
        let mut fixup_cap: usize = 16;
        let mut b0: usize = 0;
        while b0 < body.bb_count {
            let mbb0 = unsafe { x64_mi_bb_at(body.bbs, b0) };
            let mut inst0 = unsafe { (*mbb0).first_inst };
            while (inst0 as usize) != 0 {
                let opc0 = unsafe { (*inst0).opcode };
                if opc0 == X64_MI_JMP || opc0 == X64_MI_JCC || opc0 == X64_MI_ASSERT {
                    fixup_cap = fixup_cap + 1;
                }
                inst0 = unsafe { (*inst0).next };
            }
            b0 = b0 + 1;
        }

        let fixups = unsafe {
            arena_alloc_raw(mut_view(*body.arena), fixup_cap << 3, 4) as *mut BranchFixupEntry
        };
        let mut num_fixups: usize = 0;

        let mut b: usize = 0;
        while b < body.bb_count {
            unsafe {
                *(((bb_offsets as usize) + (b << 2)) as *mut u32) = sec.bytes_len as u32;
            }
            let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
            let mut inst = unsafe { (*mbb).first_inst };
            while (inst as usize) != 0 {
                let opc = unsafe { (*inst).opcode };
                if opc == X64_MI_JMP {
                    let tgt = unsafe { (*inst).ops[0usize].imm as u32 };
                    let fx_off = (sec.bytes_len + 1) as u32;
                    x64_jmp(mut_view(*sec), 0);
                    if num_fixups < fixup_cap {
                        let fp = ((fixups as usize) + (num_fixups << 3)) as *mut BranchFixupEntry;
                        unsafe {
                            (*fp).fixup = fx_off;
                            (*fp).target = tgt;
                        }
                        num_fixups = num_fixups + 1;
                    }
                } else if opc == X64_MI_JCC {
                    let cc = unsafe { (*inst).ops[0usize].imm as u8 };
                    let tgt = unsafe { (*inst).ops[1usize].imm as u32 };
                    let fx_off = (sec.bytes_len + 2) as u32;
                    x64_jcc(mut_view(*sec), cc, 0);
                    if num_fixups < fixup_cap {
                        let fp = ((fixups as usize) + (num_fixups << 3)) as *mut BranchFixupEntry;
                        unsafe {
                            (*fp).fixup = fx_off;
                            (*fp).target = tgt;
                        }
                        num_fixups = num_fixups + 1;
                    }
                } else {
                    unsafe {
                        x64_encode_mi_inst_obj(mut_view(*sec), view(*inst), layout, mut_view(*obj));
                    }
                }
                inst = unsafe { (*inst).next };
            }
            b = b + 1;
        }

        let mut f: usize = 0;
        while f < num_fixups {
            let fp = ((fixups as usize) + (f << 3)) as *const BranchFixupEntry;
            let fx_off = unsafe { (*fp).fixup };
            let tgt_bb = unsafe { (*fp).target as usize };
            if tgt_bb < body.bb_count {
                let tgt_byte_off = unsafe { *(((bb_offsets as usize) + (tgt_bb << 2)) as *mut u32) };
                x64_patch_rel32(mut_view(*sec), fx_off, tgt_byte_off);
            }
            f = f + 1;
        }
    }
}

fn hex_nibble_lower(n: u8) -> u8 {
    let v = n & 0xFu8;
    if v < 10u8 {
        48u8 + v
    } else {
        97u8 + (v - 10u8)
    }
}

// Format section bytes as lowercase hex `"%02x "` per byte followed by `"\n"`,
// matching `dump_hex` in `bootstrap/axiom0/src/driver/emit_mc.c` byte-for-byte.
pub fn x64_dump_mc_hex(sec: view<Section>, out: mut_view<DiagBuffer>) {
    let mut i: usize = 0;
    while i < sec.bytes_len {
        let b = unsafe { *(((sec.bytes as usize) + i) as *const u8) };
        diag_buf_push_byte(mut_view(*out), hex_nibble_lower(b >> 4u8));
        diag_buf_push_byte(mut_view(*out), hex_nibble_lower(b));
        diag_buf_push_byte(mut_view(*out), 32u8); // ' '
        i = i + 1;
    }
    diag_buf_push_byte(mut_view(*out), 10u8); // '\n'
}
