// =============================================================================
// 1. Target Register Description & ABI Register Masks (SPEC-77 §2, AXS-RA-010..014)
// =============================================================================

// Number of bytes pushed on stack by the 7 callee-saved GPRs (RBX, RSI, RDI, R12..R15).
pub const X64_CALLEE_SAVED_BYTES: u32 = 56u32;

// Minimum shadow space (home space) required by Windows x64 ABI.
pub const X64_MIN_SHADOW_SPACE: u32 = 32u32;

// Page size threshold above which `x64_frame_emit_prologue` emits an inline 4096-byte page probe loop.
pub const X64_PAGE_PROBE_THRESHOLD: u32 = 4096u32;

// Physical register bitmasks: bits 0..15 = RAX..R15, bits 16..31 = XMM0..XMM15.
pub const X64_GPR_ALL_MASK: u32 = 0x0000FFFFu32;
pub const X64_GPR_RESERVED_MASK: u32 = 0x00000030u32; // RSP (4), RBP (5)
pub const X64_GPR_ALLOCATABLE_MASK: u32 = 0x0000FFCFu32; // 14 allocatable GPRs
pub const X64_GPR_CALLER_SAVED_MASK: u32 = 0x00000F07u32; // RAX, RCX, RDX, R8..R11 (7 GPRs)
pub const X64_GPR_CALLEE_SAVED_MASK: u32 = 0x0000F0C8u32; // RBX, RSI, RDI, R12..R15 (7 GPRs)

pub const X64_XMM_ALL_MASK: u32 = 0xFFFF0000u32; // XMM0..XMM15 (16 XMMs)
pub const X64_XMM_CALLER_SAVED_MASK: u32 = 0x003F0000u32; // XMM0..XMM5 (6 XMMs)
pub const X64_XMM_CALLEE_SAVED_MASK: u32 = 0xFFC00000u32; // XMM6..XMM15 (10 XMMs)

pub const X64_ALL_CALLER_SAVED_MASK: u32 = 0x003F0F07u32;
pub const X64_ALL_CALLEE_SAVED_MASK: u32 = 0xFFC0F0C8u32;

// Frame layout metadata trailer magic tag stored at `slot_offsets[slot_count]`.
pub const X64_FRAME_META_MAGIC: i32 = 0x58363446;

// Rematerialization kinds (SPEC-77 §3.5, AXS-RA-022).
pub const X64_REMAT_NONE: u8 = 0u8;
pub const X64_REMAT_CONST: u8 = 1u8;
pub const X64_REMAT_STACK_ADDR: u8 = 2u8;
pub const X64_REMAT_FN_ADDR: u8 = 3u8;

@derive(Copy)
pub struct X64TargetDesc {
    pub gpr_allocatable_mask: u32,
    pub gpr_caller_saved_mask: u32,
    pub gpr_callee_saved_mask: u32,
    pub xmm_allocatable_mask: u32,
    pub xmm_caller_saved_mask: u32,
    pub xmm_callee_saved_mask: u32,
    pub gpr_count: u8,
    pub xmm_count: u8,
}

pub fn x64_target_desc_win64() -> X64TargetDesc {
    X64TargetDesc {
        gpr_allocatable_mask: X64_GPR_ALLOCATABLE_MASK,
        gpr_caller_saved_mask: X64_GPR_CALLER_SAVED_MASK,
        gpr_callee_saved_mask: X64_GPR_CALLEE_SAVED_MASK,
        xmm_allocatable_mask: X64_XMM_ALL_MASK,
        xmm_caller_saved_mask: X64_XMM_CALLER_SAVED_MASK,
        xmm_callee_saved_mask: X64_XMM_CALLEE_SAVED_MASK,
        gpr_count: 14u8,
        xmm_count: 16u8,
    }
}

pub fn x64_reg_class_for_kind(ty_kind: u8, byte_size: u32) -> u8 {
    if ty_kind == 100u8 {
        REG_CLASS_XMM
    } else if ty_kind == 101u8 || (ty_kind == 102u8 && byte_size == 16u32) {
        REG_CLASS_VEC128
    } else if ty_kind == 103u8 || (ty_kind == 102u8 && byte_size == 32u32) {
        REG_CLASS_VEC256
    } else {
        REG_CLASS_GPR
    }
}

pub fn x64_reg_class_for_type(ty: TypeId, interner: view<TypeInterner>) -> u8 {
    let ty_v = ty.v;
    let t = type_get(interner, TypeId { v: ty_v });
    let mut k: u8 = 0u8;
    if (t as usize) != 0 {
        k = unsafe { (*t).kind };
    }
    let sz = type_size(TypeId { v: ty_v }, interner);
    x64_reg_class_for_kind(k, sz)
}

pub fn x64_reg_bit(reg: i32) -> u32 {
    if reg >= 0 && reg < 32 {
        1u32 << (reg as u32)
    } else {
        0u32
    }
}

pub fn x64_popcount_u32(mask: u32) -> u32 {
    let mut m = mask;
    let mut cnt: u32 = 0u32;
    while m != 0u32 {
        cnt = cnt + (m & 1u32);
        m = m >> 1u32;
    }
    cnt
}

// =============================================================================
// 2. Liveness Analysis & Loop Nesting Depth (SPEC-77 §3.1, AXS-RA-015..016)
// =============================================================================

@derive(Copy)
pub struct X64LivenessInfo {
    pub bb_count: u32,
    pub vreg_count: u32,
    pub words_per_bb: u32,
    pub pad: u32,
    pub use_bits: *mut u64,
    pub def_bits: *mut u64,
    pub live_in: *mut u64,
    pub live_out: *mut u64,
    pub loop_depth: *mut u32,
    pub bb_bounds: *mut u32,
}

pub unsafe fn u64_at(base: *mut u64, idx: usize) -> *mut u64 {
    let off = lir_mul_usize(idx, size_of<u64>());
    ((base as usize) + off) as *mut u64
}

pub unsafe fn u8_at_mut(base: *mut u8, idx: usize) -> *mut u8 {
    ((base as usize) + idx) as *mut u8
}

fn bitset_alloc_zeroed(arena: mut_view<Arena>, word_count: usize) -> *mut u64 {
    let mut ptr: *mut u64 = 0 as *mut u64;
    if word_count > 0 {
        let bytes = lir_mul_usize(word_count, size_of<u64>());
        ptr = arena_alloc_raw(mut_view(*arena), bytes, align_of<u64>()) as *mut u64;
        let mut i: usize = 0;
        while i < word_count {
            unsafe {
                *u64_at(ptr, i) = 0u64;
            }
            i = i + 1;
        }
    }
    ptr
}

fn bitset_test(base: *mut u64, words_per_bb: usize, bb: usize, vreg: u32) -> bool {
    let w = (vreg as usize) / 64;
    let b = (vreg & 63u32) as u64;
    if w >= words_per_bb || (base as usize) == 0 {
        false
    } else {
        let idx = lir_mul_usize(bb, words_per_bb) + w;
        let word = unsafe { *u64_at(base, idx) };
        ((word >> b) & 1u64) != 0u64
    }
}

fn bitset_set(base: *mut u64, words_per_bb: usize, bb: usize, vreg: u32) {
    let w = (vreg as usize) / 64;
    let b = (vreg & 63u32) as u64;
    if w < words_per_bb && (base as usize) != 0 {
        let idx = lir_mul_usize(bb, words_per_bb) + w;
        unsafe {
            let cur = *u64_at(base, idx);
            *u64_at(base, idx) = cur | (1u64 << b);
        }
    }
}

fn bitset_clear(base: *mut u64, words_per_bb: usize, bb: usize, vreg: u32) {
    let w = (vreg as usize) / 64;
    let b = (vreg & 63u32) as u64;
    if w < words_per_bb && (base as usize) != 0 {
        let idx = lir_mul_usize(bb, words_per_bb) + w;
        unsafe {
            let cur = *u64_at(base, idx);
            *u64_at(base, idx) = cur & (0xFFFFFFFFFFFFFFFFu64 ^ (1u64 << b));
        }
    }
}

pub fn x64_liveness_is_live_in(info: view<X64LivenessInfo>, bb: usize, vreg: u32) -> bool {
    if bb >= (info.bb_count as usize) || vreg >= info.vreg_count {
        false
    } else {
        bitset_test(info.live_in, info.words_per_bb as usize, bb, vreg)
    }
}

pub fn x64_liveness_is_live_out(info: view<X64LivenessInfo>, bb: usize, vreg: u32) -> bool {
    if bb >= (info.bb_count as usize) || vreg >= info.vreg_count {
        false
    } else {
        bitset_test(info.live_out, info.words_per_bb as usize, bb, vreg)
    }
}

pub fn x64_liveness_loop_depth(info: view<X64LivenessInfo>, bb: usize) -> u32 {
    if bb >= (info.bb_count as usize) || (info.loop_depth as usize) == 0 {
        0u32
    } else {
        unsafe { *frame_u32_at(info.loop_depth, bb) }
    }
}

pub fn x64_liveness_bb_start(info: view<X64LivenessInfo>, bb: usize) -> u32 {
    if bb >= (info.bb_count as usize) || (info.bb_bounds as usize) == 0 {
        0u32
    } else {
        unsafe { *frame_u32_at(info.bb_bounds, lir_mul_usize(bb, 2)) }
    }
}

pub fn x64_liveness_bb_end(info: view<X64LivenessInfo>, bb: usize) -> u32 {
    if bb >= (info.bb_count as usize) || (info.bb_bounds as usize) == 0 {
        0u32
    } else {
        unsafe { *frame_u32_at(info.bb_bounds, lir_mul_usize(bb, 2) + 1) }
    }
}

fn liveness_record_use(
    use_bits: *mut u64,
    def_bits: *mut u64,
    words_per_bb: usize,
    bb: usize,
    vreg: u32,
    vreg_count: usize
) {
    if vreg != LIR_VREG_NONE && (vreg as usize) < vreg_count {
        if !bitset_test(def_bits, words_per_bb, bb, vreg) {
            bitset_set(use_bits, words_per_bb, bb, vreg);
        }
    }
}

fn liveness_record_def(
    def_bits: *mut u64,
    words_per_bb: usize,
    bb: usize,
    vreg: u32,
    vreg_count: usize
) {
    if vreg != LIR_VREG_NONE && (vreg as usize) < vreg_count {
        bitset_set(def_bits, words_per_bb, bb, vreg);
    }
}

fn liveness_union_succ_in(
    live_out: *mut u64,
    live_in: *mut u64,
    words_per_bb: usize,
    bb: usize,
    succ: u32,
    bb_count: usize
) {
    let s = succ as usize;
    if s < bb_count {
        let base_out = lir_mul_usize(bb, words_per_bb);
        let base_in = lir_mul_usize(s, words_per_bb);
        let mut w: usize = 0;
        while w < words_per_bb {
            unsafe {
                let o = *u64_at(live_out, base_out + w);
                let i = *u64_at(live_in, base_in + w);
                *u64_at(live_out, base_out + w) = o | i;
            }
            w = w + 1;
        }
    }
}

fn liveness_bb_has_edge(lir: view<LirBody>, from_bb: usize, to_bb: usize) -> bool {
    let mut found = false;
    if from_bb < lir.bb_count {
        let lbb = unsafe { lir_bb_at(lir.bbs, from_bb) };
        let tk = unsafe { (*lbb).term.kind };
        let tgt = to_bb as u32;
        if tk == LIR_TERM_JMP {
            let j = unsafe { (*lbb).term.jmp_target.v };
            found = j == tgt;
        } else if tk == LIR_TERM_JCC {
            let t = unsafe { (*lbb).term.then_target.v };
            let e = unsafe { (*lbb).term.else_target.v };
            found = t == tgt || e == tgt;
        } else if tk == LIR_TERM_ASSERT {
            let a = unsafe { (*lbb).term.assert_target.v };
            found = a == tgt;
        } else if tk == LIR_TERM_SWITCH {
            let ow = unsafe { (*lbb).term.otherwise.v };
            if ow == tgt {
                found = true;
            } else {
                let cnt = unsafe { (*lbb).term.count };
                let tbase = unsafe { (*lbb).term.targets };
                let mut k: usize = 0;
                while k < cnt && !found {
                    let tp = unsafe { lir_switch_target_at(tbase, k) };
                    let tv = unsafe { (*tp).target.v };
                    if tv == tgt {
                        found = true;
                    }
                    k = k + 1;
                }
            }
        }
    }
    found
}

fn liveness_mark_natural_loop(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    header: usize,
    latch: usize,
    loop_depth: *mut u32
) {
    let n = lir.bb_count;
    let in_loop = arena_alloc_raw(mut_view(*arena), n, 1) as *mut u8;
    let worklist = arena_alloc_raw(mut_view(*arena), lir_mul_usize(n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut b: usize = 0;
    while b < n {
        unsafe {
            *u8_at_mut(in_loop, b) = 0u8;
        }
        b = b + 1;
    }
    unsafe {
        *u8_at_mut(in_loop, header) = 1u8;
    }
    let mut wl_len: usize = 0;
    if latch != header {
        unsafe {
            *u8_at_mut(in_loop, latch) = 1u8;
            *frame_u32_at(worklist, 0) = latch as u32;
        }
        wl_len = 1;
    }
    while wl_len > 0 {
        wl_len = wl_len - 1;
        let cur = unsafe { *frame_u32_at(worklist, wl_len) as usize };
        let mut pred: usize = 0;
        while pred < n {
            let already = unsafe { *u8_at_mut(in_loop, pred) };
            if already == 0u8 && pred >= header && liveness_bb_has_edge(lir, pred, cur) {
                unsafe {
                    *u8_at_mut(in_loop, pred) = 1u8;
                    *frame_u32_at(worklist, wl_len) = pred as u32;
                }
                wl_len = wl_len + 1;
            }
            pred = pred + 1;
        }
    }
    let mut k: usize = 0;
    while k < n {
        let flag = unsafe { *u8_at_mut(in_loop, k) };
        if flag != 0u8 {
            unsafe {
                let d = *frame_u32_at(loop_depth, k);
                *frame_u32_at(loop_depth, k) = d + 1u32;
            }
        }
        k = k + 1;
    }
}

pub fn x64_compute_liveness_in_arena(
    arena: mut_view<Arena>,
    lir: view<LirBody>,
    body: view<X64MIBody>
) -> X64LivenessInfo {
    let bb_count = lir.bb_count;
    let vreg_count = lir.vreg_count;
    let words_per_bb = if vreg_count == 0 { 1 } else { (vreg_count + 63) / 64 };
    let total_words = lir_mul_usize(bb_count, words_per_bb);

    let use_bits = bitset_alloc_zeroed(mut_view(*arena), total_words);
    let def_bits = bitset_alloc_zeroed(mut_view(*arena), total_words);
    let live_in = bitset_alloc_zeroed(mut_view(*arena), total_words);
    let live_out = bitset_alloc_zeroed(mut_view(*arena), total_words);

    let mut loop_depth: *mut u32 = 0 as *mut u32;
    let mut bb_bounds: *mut u32 = 0 as *mut u32;
    if bb_count > 0 {
        let depth_bytes = lir_mul_usize(bb_count, size_of<u32>());
        loop_depth = arena_alloc_raw(mut_view(*arena), depth_bytes, align_of<u32>()) as *mut u32;
        let bounds_bytes = lir_mul_usize(lir_mul_usize(bb_count, 2), size_of<u32>());
        bb_bounds = arena_alloc_raw(mut_view(*arena), bounds_bytes, align_of<u32>()) as *mut u32;
        let mut z: usize = 0;
        while z < bb_count {
            unsafe {
                *frame_u32_at(loop_depth, z) = 0u32;
                *frame_u32_at(bb_bounds, lir_mul_usize(z, 2)) = 0u32;
                *frame_u32_at(bb_bounds, lir_mul_usize(z, 2) + 1) = 0u32;
            }
            z = z + 1;
        }
    }

    // Number program points: each MI instruction `m` occupies `[2*m, 2*m + 2)`.
    let mut cur_mi_idx: u32 = 0u32;
    let mut b: usize = 0;
    while b < bb_count {
        let start_pos = cur_mi_idx * 2u32;
        if b < body.bb_count && (body.bbs as usize) != 0 {
            let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
            let mut inst = unsafe { (*mbb).first_inst };
            let mut cnt: u32 = 0u32;
            while (inst as usize) != 0 {
                cnt = cnt + 1u32;
                inst = unsafe { (*inst).next };
            }
            if cnt == 0u32 {
                cnt = 1u32;
            }
            cur_mi_idx = cur_mi_idx + cnt;
        } else {
            let lbb0 = unsafe { lir_bb_at(lir.bbs, b) };
            let ic = unsafe { (*lbb0).inst_count as u32 };
            cur_mi_idx = cur_mi_idx + ic + 1u32;
        }
        let end_pos = cur_mi_idx * 2u32;
        unsafe {
            *frame_u32_at(bb_bounds, lir_mul_usize(b, 2)) = start_pos;
            *frame_u32_at(bb_bounds, lir_mul_usize(b, 2) + 1) = end_pos;
        }

        // Compute upward-exposed `use_bits[b]` and `def_bits[b]` from LIR instructions + terminator.
        let lbb = unsafe { lir_bb_at(lir.bbs, b) };
        let inst_count = unsafe { (*lbb).inst_count };
        let insts_base = unsafe { (*lbb).insts };
        let mut i: usize = 0;
        while i < inst_count {
            let inst = unsafe { lir_inst_at(insts_base, i) };
            let kind = unsafe { (*inst).kind };
            let dest_v = unsafe { (*inst).dest.v };
            let lhs_v = unsafe { (*inst).lhs.v };
            let rhs_v = unsafe { (*inst).rhs.v };
            let op_v = unsafe { (*inst).operand.v };
            let ptr_v = unsafe { (*inst).ptr.v };
            let val_v = unsafe { (*inst).val.v };
            let off_v = unsafe { (*inst).offset.v };
            let dst_addr_v = unsafe { (*inst).dst_addr.v };
            let callee_v = unsafe { (*inst).callee_vreg.v };

            if (kind >= LIR_INST_ADD && kind <= LIR_INST_SAR) ||
               (kind >= LIR_INST_ICMP_EQ && kind <= LIR_INST_ICMP_UGE) ||
               (kind >= LIR_INST_SADD_OVERFLOW && kind <= LIR_INST_UREM_OVERFLOW) ||
               kind == LIR_INST_UDIV || kind == LIR_INST_UREM {
                liveness_record_use(use_bits, def_bits, words_per_bb, b, lhs_v, vreg_count);
                liveness_record_use(use_bits, def_bits, words_per_bb, b, rhs_v, vreg_count);
                liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
            } else if kind == LIR_INST_NEG || kind == LIR_INST_NOT || kind == LIR_INST_BITNOT {
                liveness_record_use(use_bits, def_bits, words_per_bb, b, op_v, vreg_count);
                liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
            } else if kind == LIR_INST_LOAD {
                liveness_record_use(use_bits, def_bits, words_per_bb, b, ptr_v, vreg_count);
                liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
            } else if kind == LIR_INST_STORE {
                liveness_record_use(use_bits, def_bits, words_per_bb, b, ptr_v, vreg_count);
                liveness_record_use(use_bits, def_bits, words_per_bb, b, val_v, vreg_count);
            } else if kind == LIR_INST_OFFSET {
                liveness_record_use(use_bits, def_bits, words_per_bb, b, ptr_v, vreg_count);
                liveness_record_use(use_bits, def_bits, words_per_bb, b, off_v, vreg_count);
                liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
            } else if kind == LIR_INST_STACK_ADDR || kind == LIR_INST_CONST ||
                      kind == LIR_INST_CONST_STR || kind == LIR_INST_FN_ADDR ||
                      kind == LIR_INST_ABI_RESULT {
                liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
            } else if kind == LIR_INST_ABI_ARG {
                if dest_v != LIR_VREG_NONE {
                    liveness_record_def(def_bits, words_per_bb, b, dest_v, vreg_count);
                } else {
                    liveness_record_use(use_bits, def_bits, words_per_bb, b, val_v, vreg_count);
                }
            } else if kind == LIR_INST_CALL {
                liveness_record_use(use_bits, def_bits, words_per_bb, b, dst_addr_v, vreg_count);
                liveness_record_use(use_bits, def_bits, words_per_bb, b, callee_v, vreg_count);
            }
            i = i + 1;
        }

        let tk = unsafe { (*lbb).term.kind };
        if tk == LIR_TERM_JCC || tk == LIR_TERM_SWITCH || tk == LIR_TERM_ASSERT {
            let cond_v = unsafe { (*lbb).term.cond.v };
            liveness_record_use(use_bits, def_bits, words_per_bb, b, cond_v, vreg_count);
        }

        // Detect back-edges out of `b` to identify natural loops and increment `loop_depth`.
        let mut target_b: usize = 0;
        while target_b <= b {
            if liveness_bb_has_edge(lir, b, target_b) {
                liveness_mark_natural_loop(mut_view(*arena), lir, target_b, b, loop_depth);
            }
            target_b = target_b + 1;
        }

        b = b + 1;
    }

    // Solve backward dataflow equations until fixed point (SPEC-77 §3.1, AXS-RA-015):
    //   live_out[b] = U_{s in succ(b)} live_in[s]
    //   live_in[b]  = use[b] U (live_out[b] \ def[b])
    let mut changed = true;
    while changed {
        changed = false;
        let mut bi: usize = bb_count;
        while bi > 0 {
            bi = bi - 1;
            let lbb = unsafe { lir_bb_at(lir.bbs, bi) };
            let tk = unsafe { (*lbb).term.kind };
            if tk == LIR_TERM_JMP {
                let j = unsafe { (*lbb).term.jmp_target.v };
                liveness_union_succ_in(live_out, live_in, words_per_bb, bi, j, bb_count);
            } else if tk == LIR_TERM_JCC {
                let t = unsafe { (*lbb).term.then_target.v };
                let e = unsafe { (*lbb).term.else_target.v };
                liveness_union_succ_in(live_out, live_in, words_per_bb, bi, t, bb_count);
                liveness_union_succ_in(live_out, live_in, words_per_bb, bi, e, bb_count);
            } else if tk == LIR_TERM_ASSERT {
                let a = unsafe { (*lbb).term.assert_target.v };
                liveness_union_succ_in(live_out, live_in, words_per_bb, bi, a, bb_count);
            } else if tk == LIR_TERM_SWITCH {
                let ow = unsafe { (*lbb).term.otherwise.v };
                liveness_union_succ_in(live_out, live_in, words_per_bb, bi, ow, bb_count);
                let cnt = unsafe { (*lbb).term.count };
                let tbase = unsafe { (*lbb).term.targets };
                let mut k: usize = 0;
                while k < cnt {
                    let tp = unsafe { lir_switch_target_at(tbase, k) };
                    let tv = unsafe { (*tp).target.v };
                    liveness_union_succ_in(live_out, live_in, words_per_bb, bi, tv, bb_count);
                    k = k + 1;
                }
            }

            let base_w = lir_mul_usize(bi, words_per_bb);
            let mut w: usize = 0;
            while w < words_per_bb {
                unsafe {
                    let u = *u64_at(use_bits, base_w + w);
                    let d = *u64_at(def_bits, base_w + w);
                    let lo = *u64_at(live_out, base_w + w);
                    let old_li = *u64_at(live_in, base_w + w);
                    let new_li = u | (lo & (0xFFFFFFFFFFFFFFFFu64 ^ d));
                    if new_li != old_li {
                        *u64_at(live_in, base_w + w) = new_li;
                        changed = true;
                    }
                }
                w = w + 1;
            }
        }
    }

    X64LivenessInfo {
        bb_count: bb_count as u32,
        vreg_count: vreg_count as u32,
        words_per_bb: words_per_bb as u32,
        pad: 0u32,
        use_bits: use_bits,
        def_bits: def_bits,
        live_in: live_in,
        live_out: live_out,
        loop_depth: loop_depth,
        bb_bounds: bb_bounds,
    }
}

// =============================================================================
// 3. Live Intervals, Spill Heuristics & Stack-Slot Coloring (SPEC-77 §3.2..3.6)
// =============================================================================

@derive(Copy)
pub struct X64LiveRange {
    pub start: u32,
    pub end: u32,
}

@derive(Copy)
pub struct X64UsePos {
    pub pos: u32,
    pub fixed_reg: i32,
    pub is_def: bool,
    pub loop_depth: u8,
}

// Live interval for a virtual register (allocated in Arena; accessed via pointer/view).
pub struct X64LiveInterval {
    pub vreg: u32,
    pub reg_class: u8,
    pub remat_kind: u8,
    pub crosses_call: bool,
    pub is_spilled: bool,
    pub must_stack: bool,
    pub assigned_reg: i32,
    pub spill_slot: i32,
    pub start: u32,
    pub end: u32,
    pub ranges: *mut X64LiveRange,
    pub range_count: u32,
    pub range_cap: u32,
    pub uses: *mut X64UsePos,
    pub use_count: u32,
    pub use_cap: u32,
    pub spill_weight: u64,
    pub remat_imm: i64,
    pub remat_slot: u32,
    pub copy_hint_vreg: u32,
    pub fixed_reg_hint: i32,
    pub forbidden_reg_mask: u32,
}

pub unsafe fn x64_live_range_at(base: *mut X64LiveRange, idx: usize) -> *mut X64LiveRange {
    let off = lir_mul_usize(idx, size_of<X64LiveRange>());
    ((base as usize) + off) as *mut X64LiveRange
}

pub unsafe fn x64_use_pos_at(base: *mut X64UsePos, idx: usize) -> *mut X64UsePos {
    let off = lir_mul_usize(idx, size_of<X64UsePos>());
    ((base as usize) + off) as *mut X64UsePos
}

pub unsafe fn x64_interval_at(base: *mut X64LiveInterval, idx: usize) -> *mut X64LiveInterval {
    let off = lir_mul_usize(idx, size_of<X64LiveInterval>());
    ((base as usize) + off) as *mut X64LiveInterval
}

pub fn x64_interval_reset(iv: mut_view<X64LiveInterval>, vreg: u32, reg_class: u8) {
    iv.vreg = vreg;
    iv.reg_class = reg_class;
    iv.remat_kind = X64_REMAT_NONE;
    iv.crosses_call = false;
    iv.is_spilled = false;
    iv.must_stack = false;
    iv.assigned_reg = REG_NONE;
    iv.spill_slot = -1;
    iv.start = 0xFFFFFFFFu32;
    iv.end = 0u32;
    iv.ranges = 0 as *mut X64LiveRange;
    iv.range_count = 0u32;
    iv.range_cap = 0u32;
    iv.uses = 0 as *mut X64UsePos;
    iv.use_count = 0u32;
    iv.use_cap = 0u32;
    iv.spill_weight = 0u64;
    iv.remat_imm = 0i64;
    iv.remat_slot = LIR_VREG_NONE;
    iv.copy_hint_vreg = LIR_VREG_NONE;
    iv.fixed_reg_hint = REG_NONE;
    iv.forbidden_reg_mask = 0u32;
}

pub fn x64_interval_add_range(
    arena: mut_view<Arena>,
    iv: mut_view<X64LiveInterval>,
    start: u32,
    end: u32
) {
    let mut s = start;
    let mut e = end;
    if e <= s {
        e = s + 1u32;
    }
    if s < iv.start {
        iv.start = s;
    }
    if e > iv.end {
        iv.end = e;
    }
    // Coalesce with last range if adjacent or overlapping.
    if iv.range_count > 0u32 && (iv.ranges as usize) != 0 {
        let last_idx = (iv.range_count - 1u32) as usize;
        let last_p = unsafe { x64_live_range_at(iv.ranges, last_idx) };
        let ls = unsafe { (*last_p).start };
        let le = unsafe { (*last_p).end };
        if s <= le && e >= ls {
            unsafe {
                if s < ls { (*last_p).start = s; }
                if e > le { (*last_p).end = e; }
            }
            return;
        }
    }
    if iv.range_count >= iv.range_cap {
        let new_cap = if iv.range_cap == 0u32 { 4u32 } else { iv.range_cap * 2u32 };
        let new_bytes = lir_mul_usize(new_cap as usize, size_of<X64LiveRange>());
        let new_buf = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<X64LiveRange>()) as *mut X64LiveRange;
        if (iv.ranges as usize) != 0 && iv.range_count > 0u32 {
            let copy_bytes = lir_mul_usize(iv.range_count as usize, size_of<X64LiveRange>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(iv.ranges as *const u8, new_buf as *mut u8, copy_bytes);
            }
        }
        iv.ranges = new_buf;
        iv.range_cap = new_cap;
    }
    let rp = unsafe { x64_live_range_at(iv.ranges, iv.range_count as usize) };
    unsafe {
        (*rp).start = s;
        (*rp).end = e;
    }
    iv.range_count = iv.range_count + 1u32;
}

pub fn x64_interval_add_use(
    arena: mut_view<Arena>,
    iv: mut_view<X64LiveInterval>,
    pos: u32,
    fixed_reg: i32,
    is_def: bool,
    loop_depth: u32
) {
    if iv.use_count >= iv.use_cap {
        let new_cap = if iv.use_cap == 0u32 { 4u32 } else { iv.use_cap * 2u32 };
        let new_bytes = lir_mul_usize(new_cap as usize, size_of<X64UsePos>());
        let new_buf = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<X64UsePos>()) as *mut X64UsePos;
        if (iv.uses as usize) != 0 && iv.use_count > 0u32 {
            let copy_bytes = lir_mul_usize(iv.use_count as usize, size_of<X64UsePos>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(iv.uses as *const u8, new_buf as *mut u8, copy_bytes);
            }
        }
        iv.uses = new_buf;
        iv.use_cap = new_cap;
    }
    let d8 = if loop_depth > 9u32 { 9u8 } else { loop_depth as u8 };
    let up = unsafe { x64_use_pos_at(iv.uses, iv.use_count as usize) };
    unsafe {
        (*up).pos = pos;
        (*up).fixed_reg = fixed_reg;
        (*up).is_def = is_def;
        (*up).loop_depth = d8;
    }
    iv.use_count = iv.use_count + 1u32;
}

// Loop-depth multiplier `10^d` (SPEC-77 §3.5, AXS-RA-022, REQ-OPT-218).
pub fn x64_loop_weight_multiplier(depth: u32) -> u64 {
    let cap_d = if depth > 9u32 { 9u32 } else { depth };
    let mut w: u64 = 1u64;
    let mut i: u32 = 0u32;
    while i < cap_d {
        w = w * 10u64;
        i = i + 1u32;
    }
    w
}

// Compute spill weight: `sum_{u in uses(v)} 10^d(u) * 1000 / max(1, length(v))`
// with optional PGO `block_exec_counts` override (`AXS-RA-022`, `REQ-OPT-218`).
pub fn x64_compute_spill_weight(
    iv: view<X64LiveInterval>,
    block_exec_counts: *const u64,
    bb_count: usize
) -> u64 {
    if iv.use_count == 0u32 || iv.end <= iv.start {
        return 0u64;
    }
    let mut weighted_uses: u64 = 0u64;
    let mut i: u32 = 0u32;
    while i < iv.use_count {
        let up = unsafe { x64_use_pos_at(iv.uses, i as usize) };
        let depth = unsafe { (*up).loop_depth as u32 };
        let fixed_r = unsafe { (*up).fixed_reg };
        let mut mult = x64_loop_weight_multiplier(depth);
        if (block_exec_counts as usize) != 0 && bb_count > 0 {
            let pgo_idx = (i as usize) % bb_count;
            let pgo_off = lir_mul_usize(pgo_idx, size_of<u64>());
            let pgo_cnt = unsafe { *(((block_exec_counts as usize) + pgo_off) as *const u64) };
            if pgo_cnt > 0u64 {
                mult = pgo_cnt;
            }
        }
        if fixed_r != REG_NONE {
            mult = mult * 4u64;
        }
        weighted_uses = weighted_uses + (mult * 1000u64);
        i = i + 1u32;
    }
    let span = (iv.end - iv.start) as u64;
    let mut weight = weighted_uses / (if span == 0u64 { 1u64 } else { span });
    if iv.remat_kind != X64_REMAT_NONE {
        weight = weight / 2u64;
    }
    if weight == 0u64 {
        weight = 1u64;
    }
    weight
}

pub fn x64_intervals_overlap(a: view<X64LiveInterval>, b: view<X64LiveInterval>) -> bool {
    if a.end <= b.start || b.end <= a.start {
        return false;
    }
    if a.range_count == 0u32 || b.range_count == 0u32 {
        return true;
    }
    let mut i: u32 = 0u32;
    while i < a.range_count {
        let ra = unsafe { x64_live_range_at(a.ranges, i as usize) };
        let as0 = unsafe { (*ra).start };
        let ae0 = unsafe { (*ra).end };
        let mut j: u32 = 0u32;
        while j < b.range_count {
            let rb = unsafe { x64_live_range_at(b.ranges, j as usize) };
            let bs0 = unsafe { (*rb).start };
            let be0 = unsafe { (*rb).end };
            if as0 < be0 && bs0 < ae0 {
                return true;
            }
            j = j + 1u32;
        }
        i = i + 1u32;
    }
    false
}

// =============================================================================
// 4. Stack-Slot Lifetime Coloring (SPEC-77 §3.6, AXS-RA-023, REQ-OPT-204)
// =============================================================================

@derive(Copy)
pub struct X64ColoredSpillSlot {
    pub size: u32,
    pub align: u32,
    pub rbp_offset: i32,
    pub range_count: u32,
    pub range_cap: u32,
    pub last_end: u32,
    pub ranges: *mut X64LiveRange,
}

@derive(Copy)
pub struct X64StackSlotAllocator {
    pub slots: *mut X64ColoredSpillSlot,
    pub slot_count: u32,
    pub slot_cap: u32,
}

pub unsafe fn x64_colored_slot_at(base: *mut X64ColoredSpillSlot, idx: usize) -> *mut X64ColoredSpillSlot {
    let off = lir_mul_usize(idx, size_of<X64ColoredSpillSlot>());
    ((base as usize) + off) as *mut X64ColoredSpillSlot
}

fn colored_slot_overlaps_interval(slot: view<X64ColoredSpillSlot>, iv: view<X64LiveInterval>) -> bool {
    let mut i: u32 = 0u32;
    while i < slot.range_count {
        let sr = unsafe { x64_live_range_at(slot.ranges, i as usize) };
        let ss = unsafe { (*sr).start };
        let se = unsafe { (*sr).end };
        if iv.range_count == 0u32 {
            let iv_s = iv.start;
            let iv_e = iv.end;
            if iv_s < se && ss < iv_e {
                return true;
            }
        } else {
            let mut j: u32 = 0u32;
            while j < iv.range_count {
                let ir = unsafe { x64_live_range_at(iv.ranges, j as usize) };
                let is0 = unsafe { (*ir).start };
                let ie0 = unsafe { (*ir).end };
                if is0 < se && ss < ie0 {
                    return true;
                }
                j = j + 1u32;
            }
        }
        i = i + 1u32;
    }
    false
}

fn colored_slot_add_range(
    arena: mut_view<Arena>,
    slot: mut_view<X64ColoredSpillSlot>,
    start: u32,
    end: u32
) {
    if slot.range_count >= slot.range_cap {
        let new_cap = if slot.range_cap == 0u32 { 4u32 } else { slot.range_cap * 2u32 };
        let new_bytes = lir_mul_usize(new_cap as usize, size_of<X64LiveRange>());
        let new_buf = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<X64LiveRange>()) as *mut X64LiveRange;
        if (slot.ranges as usize) != 0 && slot.range_count > 0u32 {
            let copy_bytes = lir_mul_usize(slot.range_count as usize, size_of<X64LiveRange>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(slot.ranges as *const u8, new_buf as *mut u8, copy_bytes);
            }
        }
        slot.ranges = new_buf;
        slot.range_cap = new_cap;
    }
    let rp = unsafe { x64_live_range_at(slot.ranges, slot.range_count as usize) };
    unsafe {
        (*rp).start = start;
        (*rp).end = end;
    }
    slot.range_count = slot.range_count + 1u32;
    if end > slot.last_end {
        slot.last_end = end;
    }
}

pub fn x64_stack_slot_alloc_for_interval(
    arena: mut_view<Arena>,
    alloc: mut_view<X64StackSlotAllocator>,
    iv: view<X64LiveInterval>,
    size: u32,
    align: u32
) -> u32 {
    let norm_size = if size < 8u32 { 8u32 } else { size };
    let norm_align = if align < 8u32 { 8u32 } else { align };

    // Reuse an existing colored spill slot if sizes/alignments match and live intervals are disjoint.
    let mut s: u32 = 0u32;
    while s < alloc.slot_count {
        let sp = unsafe { x64_colored_slot_at(alloc.slots, s as usize) };
        let s_size = unsafe { (*sp).size };
        let s_align = unsafe { (*sp).align };
        let overlaps = unsafe { colored_slot_overlaps_interval(view(*sp), iv) };
        if s_size == norm_size && s_align == norm_align && !overlaps {
            if iv.range_count == 0u32 {
                unsafe {
                    colored_slot_add_range(mut_view(*arena), mut_view(*sp), iv.start, iv.end);
                }
            } else {
                let mut r: u32 = 0u32;
                while r < iv.range_count {
                    let ir = unsafe { x64_live_range_at(iv.ranges, r as usize) };
                    let is0 = unsafe { (*ir).start };
                    let ie0 = unsafe { (*ir).end };
                    unsafe {
                        colored_slot_add_range(mut_view(*arena), mut_view(*sp), is0, ie0);
                    }
                    r = r + 1u32;
                }
            }
            return s;
        }
        s = s + 1u32;
    }

    // Otherwise allocate a new colored spill slot.
    if alloc.slot_count >= alloc.slot_cap {
        let new_cap = if alloc.slot_cap == 0u32 { 8u32 } else { alloc.slot_cap * 2u32 };
        let new_bytes = lir_mul_usize(new_cap as usize, size_of<X64ColoredSpillSlot>());
        let new_align = align_of<X64ColoredSpillSlot>();
        let new_buf = arena_alloc_raw(mut_view(*arena), new_bytes, new_align) as *mut X64ColoredSpillSlot;
        if (alloc.slots as usize) != 0 && alloc.slot_count > 0u32 {
            let copy_bytes = lir_mul_usize(alloc.slot_count as usize, size_of<X64ColoredSpillSlot>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(alloc.slots as *const u8, new_buf as *mut u8, copy_bytes);
            }
        }
        alloc.slots = new_buf;
        alloc.slot_cap = new_cap;
    }

    let new_idx = alloc.slot_count;
    let np = unsafe { x64_colored_slot_at(alloc.slots, new_idx as usize) };
    unsafe {
        (*np).size = norm_size;
        (*np).align = norm_align;
        (*np).rbp_offset = 0;
        (*np).range_count = 0u32;
        (*np).range_cap = 0u32;
        (*np).last_end = 0u32;
        (*np).ranges = 0 as *mut X64LiveRange;
        if iv.range_count == 0u32 {
            colored_slot_add_range(mut_view(*arena), mut_view(*np), iv.start, iv.end);
        } else {
            let mut r: u32 = 0u32;
            while r < iv.range_count {
                let ir = x64_live_range_at(iv.ranges, r as usize);
                colored_slot_add_range(mut_view(*arena), mut_view(*np), (*ir).start, (*ir).end);
                r = r + 1u32;
            }
        }
    }
    alloc.slot_count = new_idx + 1u32;
    new_idx
}

// =============================================================================
// 5. Parallel-Copy Cycle Breaking (SPEC-77 §3.3, AXS-RA-020, REQ-OPT-203)
// =============================================================================

@derive(Copy)
pub struct X64ParallelCopy {
    pub dst_reg: i32,
    pub src_reg: i32,
    pub size: u8,
}

pub unsafe fn x64_parallel_copy_at(base: *mut X64ParallelCopy, idx: usize) -> *mut X64ParallelCopy {
    let off = lir_mul_usize(idx, size_of<X64ParallelCopy>());
    ((base as usize) + off) as *mut X64ParallelCopy
}

// Resolve a set of parallel register-to-register copies (`dst_reg <- src_reg`),
// breaking cycles with `scratch_reg` (`AXS-RA-020`). Returns number of `MOV`s emitted.
pub fn x64_emit_parallel_copies_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    mbb: mut_view<X64MIBb>,
    copies: *mut X64ParallelCopy,
    count: usize,
    scratch_reg: i32
) -> u32 {
    if count == 0 || (copies as usize) == 0 {
        return 0u32;
    }
    let work_bytes = lir_mul_usize(count, size_of<X64ParallelCopy>());
    let work = arena_alloc_raw(mut_view(*arena), work_bytes, align_of<X64ParallelCopy>()) as *mut X64ParallelCopy;
    let done = arena_alloc_raw(mut_view(*arena), count, 1) as *mut u8;

    let mut remaining: usize = 0;
    let mut i: usize = 0;
    while i < count {
        let cp = unsafe { x64_parallel_copy_at(copies, i) };
        let wp = unsafe { x64_parallel_copy_at(work, i) };
        let dst = unsafe { (*cp).dst_reg };
        let src = unsafe { (*cp).src_reg };
        let sz = unsafe { (*cp).size };
        unsafe {
            (*wp).dst_reg = dst;
            (*wp).src_reg = src;
            (*wp).size = if sz == 0u8 { 8u8 } else { sz };
            if dst == src || dst == REG_NONE || src == REG_NONE {
                *u8_at_mut(done, i) = 1u8;
            } else {
                *u8_at_mut(done, i) = 0u8;
                remaining = remaining + 1;
            }
        }
        i = i + 1;
    }

    let mut emitted: u32 = 0u32;
    while remaining > 0 {
        let mut progressed = false;
        let mut k: usize = 0;
        while k < count {
            let is_done = unsafe { *u8_at_mut(done, k) };
            if is_done == 0u8 {
                let kp = unsafe { x64_parallel_copy_at(work, k) };
                let dst_k = unsafe { (*kp).dst_reg };
                let src_k = unsafe { (*kp).src_reg };
                let sz_k = unsafe { (*kp).size };

                // Check if `dst_k` is still needed as `src_reg` by any other pending copy.
                let mut dst_busy = false;
                let mut j: usize = 0;
                while j < count && !dst_busy {
                    let j_done = unsafe { *u8_at_mut(done, j) };
                    if j != k && j_done == 0u8 {
                        let jp = unsafe { x64_parallel_copy_at(work, j) };
                        let src_j = unsafe { (*jp).src_reg };
                        if src_j == dst_k {
                            dst_busy = true;
                        }
                    }
                    j = j + 1;
                }

                if !dst_busy {
                    let mi = x64_mi_new(mut_view(*arena), X64_MI_MOV);
                    unsafe {
                        x64_mi_set_size(mut_view(*mi), sz_k);
                        x64_mi_add_op(mut_view(*mi), x64_op_reg(dst_k));
                        x64_mi_add_op(mut_view(*mi), x64_op_reg(src_k));
                        if (mbb.last_inst as usize) != 0 {
                            (*mbb.last_inst).next = mi;
                            mbb.last_inst = mi;
                        } else {
                            mbb.first_inst = mi;
                            mbb.last_inst = mi;
                        }
                        *u8_at_mut(done, k) = 1u8;
                    }
                    remaining = remaining - 1;
                    emitted = emitted + 1u32;
                    progressed = true;
                }
            }
            k = k + 1;
        }

        // All remaining copies form one or more cycles: break a cycle using `scratch_reg`.
        if !progressed && remaining > 0 {
            let mut cyc_idx: usize = 0;
            let mut found_cyc = false;
            while cyc_idx < count && !found_cyc {
                let c_done = unsafe { *u8_at_mut(done, cyc_idx) };
                if c_done == 0u8 {
                    found_cyc = true;
                } else {
                    cyc_idx = cyc_idx + 1;
                }
            }
            if found_cyc {
                let cp = unsafe { x64_parallel_copy_at(work, cyc_idx) };
                let src_c = unsafe { (*cp).src_reg };
                let sz_c = unsafe { (*cp).size };
                let save_mi = x64_mi_new(mut_view(*arena), X64_MI_MOV);
                unsafe {
                    x64_mi_set_size(mut_view(*save_mi), sz_c);
                    x64_mi_add_op(mut_view(*save_mi), x64_op_reg(scratch_reg));
                    x64_mi_add_op(mut_view(*save_mi), x64_op_reg(src_c));
                    if (mbb.last_inst as usize) != 0 {
                        (*mbb.last_inst).next = save_mi;
                        mbb.last_inst = save_mi;
                    } else {
                        mbb.first_inst = save_mi;
                        mbb.last_inst = save_mi;
                    }
                    (*cp).src_reg = scratch_reg;
                }
                emitted = emitted + 1u32;
            }
        }
    }
    emitted
}

// =============================================================================
// 6. Linear-Scan Register Allocation (SPEC-77 §3.2..3.5, AXS-RA-018..022)
// =============================================================================

@derive(Copy)
pub struct X64RegAllocResult {
    pub intervals: *mut X64LiveInterval,
    pub liveness: *mut X64LivenessInfo,
    pub spill_slots: X64StackSlotAllocator,
    pub interval_count: u32,
    pub used_phys_reg_mask: u32,
    pub used_callee_saved_mask: u32,
    pub allocated_vreg_count: u32,
    pub spilled_vreg_count: u32,
    pub remat_vreg_count: u32,
    pub coalesced_copy_count: u32,
    pub pad: u32,
}

fn mi_inst_phys_def_mask(inst: view<X64MI>) -> u32 {
    let opc = inst.opcode;
    let mut mask: u32 = 0u32;
    if opc == X64_MI_CALL {
        mask = X64_ALL_CALLER_SAVED_MASK;
    } else if opc == X64_MI_IDIV || opc == X64_MI_MUL {
        mask = x64_reg_bit(REG_RAX) | x64_reg_bit(REG_RDX);
    } else if opc == X64_MI_SETCC {
        if inst.op_count >= 2u8 && inst.ops[1usize].kind == X64_OP_REG {
            mask = x64_reg_bit(inst.ops[1usize].reg);
        }
    } else if opc == X64_MI_MOV || opc == X64_MI_ADD || opc == X64_MI_SUB ||
              opc == X64_MI_IMUL || opc == X64_MI_AND || opc == X64_MI_OR ||
              opc == X64_MI_XOR || opc == X64_MI_SHL || opc == X64_MI_SAR ||
              opc == X64_MI_SHR || opc == X64_MI_LEA || opc == X64_MI_POP {
        if inst.op_count >= 1u8 && inst.ops[0usize].kind == X64_OP_REG {
            mask = x64_reg_bit(inst.ops[0usize].reg);
        }
    }
    mask
}

fn mi_op_phys_read_mask(op: X64Op) -> u32 {
    if op.kind == X64_OP_REG {
        x64_reg_bit(op.reg)
    } else if op.kind == X64_OP_MEM {
        let mut m: u32 = 0u32;
        if op.mem.base != REG_NONE && op.mem.base != REG_RBP && op.mem.base != REG_RSP {
            m = m | x64_reg_bit(op.mem.base);
        }
        if op.mem.index != REG_NONE && op.mem.index != REG_RBP && op.mem.index != REG_RSP {
            m = m | x64_reg_bit(op.mem.index);
        }
        m
    } else {
        0u32
    }
}

fn mi_inst_phys_use_mask(inst: view<X64MI>) -> u32 {
    let opc = inst.opcode;
    let mut mask: u32 = 0u32;
    if opc == X64_MI_RET {
        mask = x64_reg_bit(REG_RAX);
    } else if opc == X64_MI_IDIV || opc == X64_MI_MUL {
        mask = x64_reg_bit(REG_RAX) | x64_reg_bit(REG_RDX);
        if inst.op_count >= 1u8 {
            mask = mask | mi_op_phys_read_mask(inst.ops[0usize]);
        }
    } else if opc == X64_MI_MOV || opc == X64_MI_LEA {
        if inst.op_count >= 1u8 && inst.ops[0usize].kind == X64_OP_MEM {
            mask = mask | mi_op_phys_read_mask(inst.ops[0usize]);
        }
        if inst.op_count >= 2u8 {
            mask = mask | mi_op_phys_read_mask(inst.ops[1usize]);
        }
    } else if opc == X64_MI_ADD || opc == X64_MI_SUB || opc == X64_MI_IMUL ||
              opc == X64_MI_AND || opc == X64_MI_OR || opc == X64_MI_XOR ||
              opc == X64_MI_SHL || opc == X64_MI_SAR || opc == X64_MI_SHR ||
              opc == X64_MI_CMP || opc == X64_MI_TEST {
        if inst.op_count >= 1u8 {
            mask = mask | mi_op_phys_read_mask(inst.ops[0usize]);
        }
        if inst.op_count >= 2u8 {
            mask = mask | mi_op_phys_read_mask(inst.ops[1usize]);
        }
    } else if opc == X64_MI_CALL || opc == X64_MI_PUSH {
        if inst.op_count >= 1u8 {
            mask = mask | mi_op_phys_read_mask(inst.ops[0usize]);
        }
    }
    mask
}

// Check if `REG_RAX` is dead immediately after `inst` within the same basic block.
fn mi_rax_dead_after(inst: *mut X64MI) -> bool {
    let rax_bit = x64_reg_bit(REG_RAX);
    let mut curr: *mut X64MI = unsafe { (*inst).next };
    while (curr as usize) != 0 {
        let u_mask: u32 = unsafe { mi_inst_phys_use_mask(view(*curr)) };
        if (u_mask & rax_bit) != 0u32 {
            return false;
        }
        let d_mask: u32 = unsafe { mi_inst_phys_def_mask(view(*curr)) };
        let opc: u32 = unsafe { (*curr).opcode };
        if (d_mask & rax_bit) != 0u32 && opc != X64_MI_SETCC {
            return true;
        }
        if opc == X64_MI_JMP {
            return true;
        }
        curr = unsafe { (*curr).next };
    }
    true
}

// Preferred allocation order:
//   1. Non-RAX caller-saved GPRs (`R11, R10, R9, R8, RDX, RCX`) when `!crosses_call`
//   2. Callee-saved GPRs (`RBX, RSI, RDI, R12, R13, R14, R15`)
//   3. `RAX` (last resort among GPRs since isel uses RAX heavily as primary scratch)
const GPR_PREF_CALLER_ORDER: [7]i32 = [11, 10, 9, 8, 2, 1, 0];
const GPR_PREF_CALLEE_ORDER: [7]i32 = [3, 6, 7, 12, 13, 14, 15];

fn pick_best_reg(
    avail_mask: u32,
    reg_class: u8,
    crosses_call: bool,
    hint_reg: i32,
    used_callee_saved_mask: u32
) -> i32 {
    if avail_mask == 0u32 {
        return REG_NONE;
    }
    if hint_reg != REG_NONE && (avail_mask & x64_reg_bit(hint_reg)) != 0u32 {
        return hint_reg;
    }
    if reg_class == REG_CLASS_GPR {
        if !crosses_call {
            let mut i: usize = 0;
            while i < 6 {
                let r = GPR_PREF_CALLER_ORDER[i];
                if (avail_mask & x64_reg_bit(r)) != 0u32 {
                    return r;
                }
                i = i + 1;
            }
        }
        // Prefer an already-saved callee-saved GPR before touching a new callee-saved GPR.
        let mut j: usize = 0;
        while j < 7 {
            let r = GPR_PREF_CALLEE_ORDER[j];
            let bit = x64_reg_bit(r);
            if (avail_mask & bit) != 0u32 && (used_callee_saved_mask & bit) != 0u32 {
                return r;
            }
            j = j + 1;
        }
        let mut k: usize = 0;
        while k < 7 {
            let r = GPR_PREF_CALLEE_ORDER[k];
            if (avail_mask & x64_reg_bit(r)) != 0u32 {
                return r;
            }
            k = k + 1;
        }
    } else {
        // XMM / Vector register selection (`REG_XMM0`..`REG_XMM15`).
        if !crosses_call {
            let mut x: i32 = REG_XMM0;
            while x <= REG_XMM5 {
                if (avail_mask & x64_reg_bit(x)) != 0u32 {
                    return x;
                }
                x = x + 1;
            }
        }
        let mut y: i32 = REG_XMM6;
        while y <= REG_XMM15 {
            let bit = x64_reg_bit(y);
            if (avail_mask & bit) != 0u32 && (used_callee_saved_mask & bit) != 0u32 {
                return y;
            }
            y = y + 1;
        }
        let mut z: i32 = REG_XMM6;
        while z <= REG_XMM15 {
            if (avail_mask & x64_reg_bit(z)) != 0u32 {
                return z;
            }
            z = z + 1;
        }
    }
    REG_NONE
}

fn rewrite_allocated_and_remat_ops(
    body: mut_view<X64MIBody>,
    intervals: *mut X64LiveInterval,
    vreg_count: usize,
    slot_offset: u32,
    remat_in_place: *mut u8
) {
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut prev: *mut X64MI = 0 as *mut X64MI;
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let next_inst = unsafe { (*inst).next };
            let opc = unsafe { (*inst).opcode };
            let op_cnt = unsafe { (*inst).op_count };
            let mut unlink_this = false;

            // Rewrite any operand referencing an allocated or in-place rematerialized vreg.
            let mut i: u8 = 0u8;
            while i < op_cnt {
                let op = unsafe { (*inst).ops[i as usize] };
                if op.kind == X64_OP_FRAME && op.frame.slot_id >= slot_offset && op.frame.offset == 0 {
                    let v = (op.frame.slot_id - slot_offset) as usize;
                    if v < vreg_count {
                        let iv = unsafe { x64_interval_at(intervals, v) };
                        let reg = unsafe { (*iv).assigned_reg };
                        let is_remat = unsafe { *u8_at_mut(remat_in_place, v) };
                        if reg != REG_NONE {
                            unsafe {
                                (*inst).ops[i as usize] = x64_op_reg(reg);
                            }
                        } else if is_remat != 0u8 {
                            let rk = unsafe { (*iv).remat_kind };
                            let rimm = unsafe { (*iv).remat_imm };
                            let rslot = unsafe { (*iv).remat_slot };
                            if i == 0u8 && opc == X64_MI_MOV {
                                // Store to an in-place rematerialized vreg is dead: unlink it.
                                unlink_this = true;
                            } else if i == 1u8 && opc == X64_MI_MOV {
                                if rk == X64_REMAT_CONST {
                                    unsafe {
                                        (*inst).ops[1usize] = x64_op_imm(rimm);
                                    }
                                } else if rk == X64_REMAT_STACK_ADDR {
                                    unsafe {
                                        (*inst).opcode = X64_MI_LEA;
                                        (*inst).ops[1usize] = x64_op_frame(rslot, 0);
                                    }
                                }
                            }
                        }
                    }
                }
                i = i + 1u8;
            }

            // Also unlink 64-bit self-moves `mov r, r`.
            if !unlink_this && opc == X64_MI_MOV {
                let sz = unsafe { (*inst).size };
                let op0 = unsafe { (*inst).ops[0usize] };
                let op1 = unsafe { (*inst).ops[1usize] };
                if (sz == 8u8 || sz == 0u8) && op0.kind == X64_OP_REG && op1.kind == X64_OP_REG && op0.reg == op1.reg {
                    unlink_this = true;
                }
            }

            if unlink_this {
                unsafe {
                    if (prev as usize) != 0 {
                        (*prev).next = next_inst;
                    } else {
                        (*mbb).first_inst = next_inst;
                    }
                    if ((*mbb).last_inst as usize) == (inst as usize) {
                        (*mbb).last_inst = prev;
                    }
                }
            } else {
                prev = inst;
            }
            inst = next_inst;
        }
        b = b + 1;
    }
}

// Local peephole pass after register allocation to fold redundant scratch `RAX` moves (`SPEC-77 §3.3`).
fn peephole_fold_allocated_moves(body: mut_view<X64MIBody>) {
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut prev: *mut X64MI = 0 as *mut X64MI;
        let mut m0: *mut X64MI = unsafe { (*mbb).first_inst };
        while (m0 as usize) != 0 {
            let m1: *mut X64MI = unsafe { (*m0).next };
            let mut folded = false;

            if (m1 as usize) != 0 {
                let opc0: u32 = unsafe { (*m0).opcode };
                let sz0: u8 = unsafe { (*m0).size };
                let op0_0: X64Op = unsafe { (*m0).ops[0usize] };
                let op0_1: X64Op = unsafe { (*m0).ops[1usize] };

                let opc1: u32 = unsafe { (*m1).opcode };
                let sz1: u8 = unsafe { (*m1).size };
                let op1_0: X64Op = unsafe { (*m1).ops[0usize] };
                let op1_1: X64Op = unsafe { (*m1).ops[1usize] };

                // Pattern A: `mov/lea rax, src; mov r_dst, rax` -> `mov/lea r_dst, src` (when RAX is dead after m1).
                if (opc0 == X64_MI_MOV || opc0 == X64_MI_LEA) && (sz0 == 8u8 || sz0 == 0u8) &&
                   op0_0.kind == X64_OP_REG && op0_0.reg == REG_RAX &&
                   opc1 == X64_MI_MOV && (sz1 == 8u8 || sz1 == 0u8) &&
                   op1_0.kind == X64_OP_REG && x64_reg_is_gpr(op1_0.reg) &&
                   op1_1.kind == X64_OP_REG && op1_1.reg == REG_RAX &&
                   mi_rax_dead_after(m1) {
                    let next_after_m1 = unsafe { (*m1).next };
                    unsafe {
                        (*m0).ops[0usize] = op1_0;
                        (*m0).next = next_after_m1;
                        if ((*mbb).last_inst as usize) == (m1 as usize) {
                            (*mbb).last_inst = m0;
                        }
                    }
                    folded = true;
                }

                // Pattern B: `mov rax, r_lhs; cmp rax, op2` -> `cmp r_lhs, op2` (when RAX is dead after m1).
                if !folded && opc0 == X64_MI_MOV && (sz0 == 8u8 || sz0 == 0u8) &&
                   op0_0.kind == X64_OP_REG && op0_0.reg == REG_RAX &&
                   op0_1.kind == X64_OP_REG && x64_reg_is_gpr(op0_1.reg) &&
                   opc1 == X64_MI_CMP && (sz1 == 8u8 || sz1 == 0u8) &&
                   op1_0.kind == X64_OP_REG && op1_0.reg == REG_RAX &&
                   (mi_op_phys_read_mask(op1_1) & x64_reg_bit(REG_RAX)) == 0u32 &&
                   mi_rax_dead_after(m1) {
                    let next_after_m1 = unsafe { (*m1).next };
                    unsafe {
                        (*m0).opcode = X64_MI_CMP;
                        (*m0).ops[0usize] = op0_1;
                        (*m0).ops[1usize] = op1_1;
                        (*m0).next = next_after_m1;
                        if ((*mbb).last_inst as usize) == (m1 as usize) {
                            (*mbb).last_inst = m0;
                        }
                    }
                    folded = true;
                }

                // Pattern C: `mov rax, r_lhs; <alu> rax, op2; mov r_dst, rax` (when RAX is dead after m2).
                let m2: *mut X64MI = unsafe { (*m1).next };
                if !folded && (m2 as usize) != 0 &&
                   opc0 == X64_MI_MOV && (sz0 == 8u8 || sz0 == 0u8) &&
                   op0_0.kind == X64_OP_REG && op0_0.reg == REG_RAX &&
                   op0_1.kind == X64_OP_REG && x64_reg_is_gpr(op0_1.reg) &&
                   (opc1 == X64_MI_ADD || opc1 == X64_MI_SUB || opc1 == X64_MI_AND ||
                    opc1 == X64_MI_OR || opc1 == X64_MI_XOR || opc1 == X64_MI_IMUL) &&
                   (sz1 == 8u8 || sz1 == 0u8) &&
                   op1_0.kind == X64_OP_REG && op1_0.reg == REG_RAX &&
                   (mi_op_phys_read_mask(op1_1) & x64_reg_bit(REG_RAX)) == 0u32 {
                    let opc2: u32 = unsafe { (*m2).opcode };
                    let sz2: u8 = unsafe { (*m2).size };
                    let op2_0: X64Op = unsafe { (*m2).ops[0usize] };
                    let op2_1: X64Op = unsafe { (*m2).ops[1usize] };
                    if opc2 == X64_MI_MOV && (sz2 == 8u8 || sz2 == 0u8) &&
                       op2_0.kind == X64_OP_REG && x64_reg_is_gpr(op2_0.reg) &&
                       op2_1.kind == X64_OP_REG && op2_1.reg == REG_RAX &&
                       mi_rax_dead_after(m2) {
                        let r_lhs = op0_1.reg;
                        let r_dst = op2_0.reg;
                        let next_after_m2 = unsafe { (*m2).next };
                        if r_dst == r_lhs {
                            // 2-address coalesced: `<alu> r_dst, op2` in-place!
                            unsafe {
                                (*m0).opcode = opc1;
                                (*m0).ops[0usize] = op2_0;
                                (*m0).ops[1usize] = op1_1;
                                (*m0).next = next_after_m2;
                                if ((*mbb).last_inst as usize) == (m2 as usize) {
                                    (*mbb).last_inst = m0;
                                }
                            }
                            folded = true;
                        }
                    }
                }
            }

            prev = m0;
            m0 = unsafe { (*m0).next };
        }
        b = b + 1;
    }
}

pub fn x64_regalloc_with_pgo_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    block_exec_counts: *const u64
) -> X64RegAllocResult {
    let liveness_val = x64_compute_liveness_in_arena(mut_view(*arena), lir, view(*body));
    let liv_sz = size_of<X64LivenessInfo>();
    let liv_al = align_of<X64LivenessInfo>();
    let liveness_ptr = arena_alloc_raw(mut_view(*arena), liv_sz, liv_al) as *mut X64LivenessInfo;
    unsafe {
        *liveness_ptr = liveness_val;
    }

    let vreg_count = lir.vreg_count;
    let slot_offset = lir.slot_count as u32;
    let mut intervals: *mut X64LiveInterval = 0 as *mut X64LiveInterval;
    if vreg_count > 0 {
        let iv_bytes = lir_mul_usize(vreg_count, size_of<X64LiveInterval>());
        intervals = arena_alloc_raw(mut_view(*arena), iv_bytes, align_of<X64LiveInterval>()) as *mut X64LiveInterval;
        let mut v: usize = 0;
        while v < vreg_count {
            let vp = unsafe { lir_vreg_at(lir.vregs, v) };
            let vty_v: u32 = unsafe { (*vp).ty.v };
            let rclass = x64_reg_class_for_type(TypeId { v: vty_v }, interner);
            let vsize = type_size(TypeId { v: vty_v }, interner);
            let iv = unsafe { x64_interval_at(intervals, v) };
            unsafe {
                x64_interval_reset(mut_view(*iv), v as u32, rclass);
                if vsize > 8u32 && rclass == REG_CLASS_GPR {
                    (*iv).must_stack = true;
                }
            }
            v = v + 1;
        }
    }

    let mut spill_alloc = X64StackSlotAllocator {
        slots: 0 as *mut X64ColoredSpillSlot,
        slot_count: 0u32,
        slot_cap: 0u32,
    };

    if vreg_count == 0 || body.bb_count == 0 {
        return X64RegAllocResult {
            intervals: intervals,
            liveness: liveness_ptr,
            spill_slots: spill_alloc,
            interval_count: vreg_count as u32,
            used_phys_reg_mask: 0u32,
            used_callee_saved_mask: 0u32,
            allocated_vreg_count: 0u32,
            spilled_vreg_count: 0u32,
            remat_vreg_count: 0u32,
            coalesced_copy_count: 0u32,
            pad: 0u32,
        };
    }

    // Scan LIR instructions to record rematerialization candidates and copy/fixed-reg hints.
    let vreg_u32_bytes = lir_mul_usize(vreg_count, size_of<u32>());
    let def_counts = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, align_of<u32>()) as *mut u32;
    let mut vc: usize = 0;
    while vc < vreg_count {
        unsafe {
            *frame_u32_at(def_counts, vc) = 0u32;
        }
        vc = vc + 1;
    }

    let mut s0_ret_in_mem = false;
    if lir.slot_count > 0 && (lir.slots as usize) != 0 {
        let sp0 = unsafe { lir_slot_at(lir.slots, 0) };
        let s0_sz = type_size(unsafe { TypeId { v: (*sp0).ty.v } }, interner);
        if s0_sz > 8u32 || (s0_sz != 1u32 && s0_sz != 2u32 && s0_sz != 4u32 && s0_sz != 8u32 && s0_sz != 0u32) {
            s0_ret_in_mem = true;
        }
    }

    let mut lb: usize = 0;
    while lb < lir.bb_count {
        let lbb = unsafe { lir_bb_at(lir.bbs, lb) };
        let ic = unsafe { (*lbb).inst_count };
        let ibase = unsafe { (*lbb).insts };
        let mut li: usize = 0;
        while li < ic {
            let linst = unsafe { lir_inst_at(ibase, li) };
            let lkind = unsafe { (*linst).kind };
            let d_v = unsafe { (*linst).dest.v };
            let lhs_v = unsafe { (*linst).lhs.v };
            let rhs_v = unsafe { (*linst).rhs.v };
            let val_v = unsafe { (*linst).val.v };

            if d_v != LIR_VREG_NONE && (d_v as usize) < vreg_count {
                let dv_idx = d_v as usize;
                let prev_defs = unsafe { *frame_u32_at(def_counts, dv_idx) };
                unsafe {
                    *frame_u32_at(def_counts, dv_idx) = prev_defs + 1u32;
                }
                let iv = unsafe { x64_interval_at(intervals, dv_idx) };
                if prev_defs == 0u32 {
                    if lkind == LIR_INST_CONST {
                        unsafe {
                            (*iv).remat_kind = X64_REMAT_CONST;
                            (*iv).remat_imm = (*linst).const_val as i64;
                        }
                    } else if lkind == LIR_INST_STACK_ADDR {
                        let sl = unsafe { (*linst).slot.v };
                        if !(sl == 0u32 && s0_ret_in_mem) {
                            unsafe {
                                (*iv).remat_kind = X64_REMAT_STACK_ADDR;
                                (*iv).remat_slot = sl;
                            }
                        }
                    } else if lkind == LIR_INST_ADD || lkind == LIR_INST_SUB ||
                              lkind == LIR_INST_BIT_AND || lkind == LIR_INST_BIT_OR ||
                              lkind == LIR_INST_BIT_XOR || lkind == LIR_INST_MUL {
                        if lhs_v != LIR_VREG_NONE && (lhs_v as usize) < vreg_count {
                            unsafe {
                                (*iv).copy_hint_vreg = lhs_v;
                            }
                        }
                    } else if lkind == LIR_INST_ABI_ARG {
                        let lk = unsafe { (*linst).loc_kind };
                        let lro = unsafe { (*linst).loc_reg_or_offset };
                        if lk == ABI_LOC_REG && lro < 16u32 {
                            unsafe {
                                (*iv).fixed_reg_hint = lro as i32;
                            }
                        } else if lk == ABI_LOC_INDIRECT {
                            unsafe {
                                (*iv).must_stack = true;
                            }
                        }
                    } else if lkind == LIR_INST_ABI_RESULT {
                        let lk = unsafe { (*linst).loc_kind };
                        let lro = unsafe { (*linst).loc_reg_or_offset };
                        if lk == ABI_LOC_REG && lro < 16u32 {
                            unsafe {
                                (*iv).fixed_reg_hint = lro as i32;
                            }
                        } else if lk == ABI_LOC_INDIRECT {
                            unsafe {
                                (*iv).must_stack = true;
                            }
                        }
                    }
                } else {
                    unsafe {
                        (*iv).remat_kind = X64_REMAT_NONE;
                        (*iv).must_stack = true;
                    }
                }
            }
            if (lkind == LIR_INST_SHL || lkind == LIR_INST_SHR || lkind == LIR_INST_SAR) &&
               rhs_v != LIR_VREG_NONE && (rhs_v as usize) < vreg_count {
                let riv = unsafe { x64_interval_at(intervals, rhs_v as usize) };
                unsafe {
                    (*riv).fixed_reg_hint = REG_RCX;
                }
            }
            if lkind == LIR_INST_ABI_ARG && d_v == LIR_VREG_NONE &&
               val_v != LIR_VREG_NONE && (val_v as usize) < vreg_count {
                let lk = unsafe { (*linst).loc_kind };
                let lro = unsafe { (*linst).loc_reg_or_offset };
                let viv = unsafe { x64_interval_at(intervals, val_v as usize) };
                if lk == ABI_LOC_REG && lro < 16u32 {
                    unsafe {
                        (*viv).fixed_reg_hint = lro as i32;
                    }
                } else if lk == ABI_LOC_INDIRECT {
                    unsafe {
                        (*viv).must_stack = true;
                    }
                }
            }
            li = li + 1;
        }
        lb = lb + 1;
    }

    // Count total MI instructions across all basic blocks.
    let mut total_mi: usize = 0;
    let mut b0: usize = 0;
    while b0 < body.bb_count {
        let mbb0 = unsafe { x64_mi_bb_at(body.bbs, b0) };
        let mut inst0 = unsafe { (*mbb0).first_inst };
        let mut cnt0: usize = 0;
        while (inst0 as usize) != 0 {
            cnt0 = cnt0 + 1;
            inst0 = unsafe { (*inst0).next };
        }
        if cnt0 == 0 {
            cnt0 = 1;
        }
        total_mi = total_mi + cnt0;
        b0 = b0 + 1;
    }

    let words_per_bb = liveness_val.words_per_bb as usize;
    let live_vregs = bitset_alloc_zeroed(mut_view(*arena), words_per_bb);
    let non_mov_use = arena_alloc_raw(mut_view(*arena), vreg_count, 1) as *mut u8;
    let mut nv: usize = 0;
    while nv < vreg_count {
        unsafe {
            *u8_at_mut(non_mov_use, nv) = 0u8;
        }
        nv = nv + 1;
    }

    // Per-block analysis: walk MI instructions to record def/use positions, live ranges,
    // `must_stack` constraints, and exact physical-register interference masks.
    let mut global_mi_base: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut block_mi_cnt: usize = 0;
        let mut scan_inst = unsafe { (*mbb).first_inst };
        while (scan_inst as usize) != 0 {
            block_mi_cnt = block_mi_cnt + 1;
            scan_inst = unsafe { (*scan_inst).next };
        }

        let bb_start = x64_liveness_bb_start(view(liveness_val), b);
        let bb_end = x64_liveness_bb_end(view(liveness_val), b);
        let depth = x64_liveness_loop_depth(view(liveness_val), b);

        if block_mi_cnt > 0 {
            let mi_ptr_bytes = lir_mul_usize(block_mi_cnt, size_of<*mut X64MI>());
            let mi_u32_bytes = lir_mul_usize(block_mi_cnt, size_of<u32>());
            let mi_ptrs = arena_alloc_raw(mut_view(*arena), mi_ptr_bytes, align_of<*mut X64MI>()) as *mut *mut X64MI;
            let p_def = arena_alloc_raw(mut_view(*arena), mi_u32_bytes, align_of<u32>()) as *mut u32;
            let p_use = arena_alloc_raw(mut_view(*arena), mi_u32_bytes, align_of<u32>()) as *mut u32;
            let v_def = arena_alloc_raw(mut_view(*arena), mi_u32_bytes, align_of<u32>()) as *mut u32;
            let v_use = arena_alloc_raw(mut_view(*arena), mi_u32_bytes, align_of<u32>()) as *mut u32;
            let first_def_pos = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, align_of<u32>()) as *mut u32;
            let last_use_pos = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, align_of<u32>()) as *mut u32;

            let mut vi: usize = 0;
            while vi < vreg_count {
                unsafe {
                    *frame_u32_at(first_def_pos, vi) = 0xFFFFFFFFu32;
                    *frame_u32_at(last_use_pos, vi) = 0u32;
                }
                vi = vi + 1;
            }

            let abi_arg_reg_mask = x64_reg_bit(REG_RCX) | x64_reg_bit(REG_RDX) |
                                   x64_reg_bit(REG_R8) | x64_reg_bit(REG_R9);
            let mut pending_call_args: u32 = 0u32;
            let mut m: usize = 0;
            let mut cur = unsafe { (*mbb).first_inst };
            while m < block_mi_cnt {
                let ptr_slot = ((mi_ptrs as usize) + lir_mul_usize(m, size_of<*mut X64MI>())) as *mut *mut X64MI;
                unsafe {
                    *ptr_slot = cur;
                }
                let dm = unsafe { mi_inst_phys_def_mask(view(*cur)) };
                let mut um = unsafe { mi_inst_phys_use_mask(view(*cur)) };
                let opc = unsafe { (*cur).opcode };
                let sz = unsafe { (*cur).size };
                let oc = unsafe { (*cur).op_count };

                if opc == X64_MI_CALL {
                    um = um | pending_call_args;
                    pending_call_args = 0u32;
                } else {
                    if (um & abi_arg_reg_mask) != 0u32 {
                        pending_call_args = pending_call_args & (0xFFFFFFFFu32 ^ (um & abi_arg_reg_mask));
                    }
                    if (dm & abi_arg_reg_mask) != 0u32 {
                        pending_call_args = pending_call_args | (dm & abi_arg_reg_mask);
                    }
                }

                let mut vd: u32 = LIR_VREG_NONE;
                let mut vu: u32 = LIR_VREG_NONE;
                let pos_use = (global_mi_base + (m as u32)) * 2u32;
                let pos_def = pos_use + 1u32;

                let mut op_idx: u8 = 0u8;
                while op_idx < oc {
                    let op = unsafe { (*cur).ops[op_idx as usize] };
                    if op.kind == X64_OP_FRAME && op.frame.slot_id >= slot_offset {
                        let v_id = op.frame.slot_id - slot_offset;
                        if (v_id as usize) < vreg_count {
                            let iv = unsafe { x64_interval_at(intervals, v_id as usize) };
                            if op.frame.offset != 0 || opc == X64_MI_LEA || (sz != 8u8 && sz != 0u8) {
                                unsafe {
                                    (*iv).must_stack = true;
                                }
                            }
                            if op_idx == 0u8 && opc == X64_MI_MOV {
                                vd = v_id;
                                let fixed_d = if oc >= 2u8 && unsafe { (*cur).ops[1usize].kind } == X64_OP_REG {
                                    unsafe { (*cur).ops[1usize].reg }
                                } else {
                                    REG_NONE
                                };
                                unsafe {
                                    x64_interval_add_use(
                                        mut_view(*arena), mut_view(*iv), pos_def, fixed_d, true, depth
                                    );
                                    let fd = *frame_u32_at(first_def_pos, v_id as usize);
                                    if pos_def < fd {
                                        *frame_u32_at(first_def_pos, v_id as usize) = pos_def;
                                    }
                                    let lu = *frame_u32_at(last_use_pos, v_id as usize);
                                    if pos_def + 1u32 > lu {
                                        *frame_u32_at(last_use_pos, v_id as usize) = pos_def + 1u32;
                                    }
                                }
                            } else {
                                vu = v_id;
                                if opc != X64_MI_MOV {
                                    unsafe {
                                        *u8_at_mut(non_mov_use, v_id as usize) = 1u8;
                                    }
                                }
                                let fixed_u = if opc == X64_MI_MOV && unsafe { (*cur).ops[0usize].kind } == X64_OP_REG {
                                    unsafe { (*cur).ops[0usize].reg }
                                } else {
                                    REG_NONE
                                };
                                unsafe {
                                    x64_interval_add_use(
                                        mut_view(*arena), mut_view(*iv), pos_use, fixed_u, false, depth
                                    );
                                    let lu = *frame_u32_at(last_use_pos, v_id as usize);
                                    if pos_use + 1u32 > lu {
                                        *frame_u32_at(last_use_pos, v_id as usize) = pos_use + 1u32;
                                    }
                                }
                            }
                        }
                    }
                    op_idx = op_idx + 1u8;
                }

                unsafe {
                    *frame_u32_at(p_def, m) = dm;
                    *frame_u32_at(p_use, m) = um;
                    *frame_u32_at(v_def, m) = vd;
                    *frame_u32_at(v_use, m) = vu;
                }
                cur = unsafe { (*cur).next };
                m = m + 1;
            }

            // Record per-block live range `[r_start, r_end)` for each vreg active in block `b`.
            let mut vr: usize = 0;
            while vr < vreg_count {
                let is_in = x64_liveness_is_live_in(view(liveness_val), b, vr as u32);
                let is_out = x64_liveness_is_live_out(view(liveness_val), b, vr as u32);
                let fd = unsafe { *frame_u32_at(first_def_pos, vr) };
                let lu = unsafe { *frame_u32_at(last_use_pos, vr) };
                if is_in || is_out || fd != 0xFFFFFFFFu32 || lu != 0u32 {
                    let r_start = if is_in {
                        bb_start
                    } else if fd != 0xFFFFFFFFu32 {
                        fd
                    } else {
                        bb_start
                    };
                    let r_end = if is_out {
                        bb_end
                    } else if lu != 0u32 {
                        lu
                    } else {
                        r_start + 1u32
                    };
                    let iv = unsafe { x64_interval_at(intervals, vr) };
                    unsafe {
                        x64_interval_add_range(mut_view(*arena), mut_view(*iv), r_start, r_end);
                    }
                }
                vr = vr + 1;
            }

            // Initialize `live_vregs` from `live_out[b]` and walk `m` backward for interference.
            let base_lo = lir_mul_usize(b, words_per_bb);
            let mut w: usize = 0;
            while w < words_per_bb {
                unsafe {
                    *u64_at(live_vregs, w) = *u64_at(liveness_val.live_out, base_lo + w);
                }
                w = w + 1;
            }

            let mut live_phys_after: u32 = 0u32;
            let mut rev_m: usize = block_mi_cnt;
            while rev_m > 0 {
                rev_m = rev_m - 1;
                let ptr_slot = ((mi_ptrs as usize) + lir_mul_usize(rev_m, size_of<*mut X64MI>())) as *mut *mut X64MI;
                let inst_p = unsafe { *ptr_slot };
                let opc = unsafe { (*inst_p).opcode };
                let dm = unsafe { *frame_u32_at(p_def, rev_m) };
                let um = unsafe { *frame_u32_at(p_use, rev_m) };
                let vd = unsafe { *frame_u32_at(v_def, rev_m) };
                let vu = unsafe { *frame_u32_at(v_use, rev_m) };
                let live_phys_before = (live_phys_after & (0xFFFFFFFFu32 ^ dm)) | um;

                if vd != LIR_VREG_NONE && (vd as usize) < vreg_count {
                    let iv_d = unsafe { x64_interval_at(intervals, vd as usize) };
                    unsafe {
                        (*iv_d).forbidden_reg_mask = (*iv_d).forbidden_reg_mask | live_phys_after;
                    }
                    if !x64_liveness_is_live_in(view(liveness_val), b, vd) {
                        bitset_clear(live_vregs, words_per_bb, 0, vd);
                    }
                }

                // Every vreg still in `live_vregs` is live across instruction `rev_m`.
                let across_forbid = dm | live_phys_after | live_phys_before;
                let mut w_idx: usize = 0;
                while w_idx < words_per_bb {
                    let mut word = unsafe { *u64_at(live_vregs, w_idx) };
                    let mut bit_idx: usize = 0;
                    while word != 0u64 && bit_idx < 64 {
                        if (word & 1u64) != 0u64 {
                            let v_active = lir_mul_usize(w_idx, 64) + bit_idx;
                            if v_active < vreg_count {
                                let iv_a = unsafe { x64_interval_at(intervals, v_active) };
                                unsafe {
                                    (*iv_a).forbidden_reg_mask = (*iv_a).forbidden_reg_mask | across_forbid;
                                    if opc == X64_MI_CALL {
                                        (*iv_a).crosses_call = true;
                                    }
                                }
                            }
                        }
                        word = word >> 1u64;
                        bit_idx = bit_idx + 1;
                    }
                    w_idx = w_idx + 1;
                }

                if vu != LIR_VREG_NONE && (vu as usize) < vreg_count {
                    let iv_u = unsafe { x64_interval_at(intervals, vu as usize) };
                    unsafe {
                        (*iv_u).forbidden_reg_mask = (*iv_u).forbidden_reg_mask | live_phys_before;
                    }
                    bitset_set(live_vregs, words_per_bb, 0, vu);
                }

                live_phys_after = live_phys_before;
            }
        }

        let adv = if block_mi_cnt == 0 { 1u32 } else { block_mi_cnt as u32 };
        global_mi_base = global_mi_base + adv;
        b = b + 1;
    }

    // Compute spill weights and sort intervals by ascending `start` point (`AXS-RA-018`).
    let sorted = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, align_of<u32>()) as *mut u32;
    let mut s_idx: usize = 0;
    while s_idx < vreg_count {
        let iv = unsafe { x64_interval_at(intervals, s_idx) };
        let w = unsafe { x64_compute_spill_weight(view(*iv), block_exec_counts, lir.bb_count) };
        unsafe {
            (*iv).spill_weight = w;
            *frame_u32_at(sorted, s_idx) = s_idx as u32;
        }
        s_idx = s_idx + 1;
    }

    // Insertion sort on `sorted` by `(iv.start, iv.vreg)`.
    let mut si: usize = 1;
    while si < vreg_count {
        let key_v = unsafe { *frame_u32_at(sorted, si) };
        let key_iv = unsafe { x64_interval_at(intervals, key_v as usize) };
        let key_start = unsafe { (*key_iv).start };
        let mut sj: usize = si;
        let mut keep_shifting = true;
        while sj > 0 && keep_shifting {
            let prev_v = unsafe { *frame_u32_at(sorted, sj - 1) };
            let prev_iv = unsafe { x64_interval_at(intervals, prev_v as usize) };
            let prev_start = unsafe { (*prev_iv).start };
            if prev_start > key_start || (prev_start == key_start && prev_v > key_v) {
                unsafe {
                    *frame_u32_at(sorted, sj) = prev_v;
                }
                sj = sj - 1;
            } else {
                keep_shifting = false;
            }
        }
        unsafe {
            *frame_u32_at(sorted, sj) = key_v;
        }
        si = si + 1;
    }

    // Linear-scan register allocation walk (`AXS-RA-018..022`).
    let active = arena_alloc_raw(mut_view(*arena), vreg_u32_bytes, align_of<u32>()) as *mut u32;
    let mut active_len: usize = 0;
    let mut used_phys_mask: u32 = 0u32;
    let mut used_callee_mask: u32 = 0u32;
    let mut coalesced_cnt: u32 = 0u32;

    let mut idx: usize = 0;
    while idx < vreg_count {
        let cur_v = unsafe { *frame_u32_at(sorted, idx) };
        let cur_iv = unsafe { x64_interval_at(intervals, cur_v as usize) };
        let cur_uses = unsafe { (*cur_iv).use_count };
        let cur_must_stack = unsafe { (*cur_iv).must_stack };
        let cur_start = unsafe { (*cur_iv).start };

        // 1. Expire old intervals in `active` whose `end <= cur_start`.
        let mut write_a: usize = 0;
        let mut read_a: usize = 0;
        while read_a < active_len {
            let act_v = unsafe { *frame_u32_at(active, read_a) };
            let act_iv = unsafe { x64_interval_at(intervals, act_v as usize) };
            let act_end = unsafe { (*act_iv).end };
            if act_end > cur_start {
                unsafe {
                    *frame_u32_at(active, write_a) = act_v;
                }
                write_a = write_a + 1;
            }
            read_a = read_a + 1;
        }
        active_len = write_a;

        if cur_uses > 0u32 && !cur_must_stack {
            let rclass = unsafe { (*cur_iv).reg_class };
            let crosses = unsafe { (*cur_iv).crosses_call };
            let forbid = unsafe { (*cur_iv).forbidden_reg_mask };
            let copy_hint_v = unsafe { (*cur_iv).copy_hint_vreg };
            let mut hint_reg = unsafe { (*cur_iv).fixed_reg_hint };
            if hint_reg == REG_NONE && copy_hint_v != LIR_VREG_NONE && (copy_hint_v as usize) < vreg_count {
                let hint_iv = unsafe { x64_interval_at(intervals, copy_hint_v as usize) };
                hint_reg = unsafe { (*hint_iv).assigned_reg };
            }

            let class_mask = if rclass == REG_CLASS_GPR {
                if crosses {
                    X64_GPR_CALLEE_SAVED_MASK
                } else {
                    X64_GPR_ALLOCATABLE_MASK & (0xFFFFFFFFu32 ^ x64_reg_bit(REG_RAX))
                }
            } else {
                if crosses {
                    X64_XMM_CALLEE_SAVED_MASK
                } else {
                    X64_XMM_ALL_MASK
                }
            };
            let allowed_for_cur = class_mask & (0xFFFFFFFFu32 ^ forbid);

            // Exclude registers held by overlapping active intervals.
            let mut busy_active: u32 = 0u32;
            let mut a_i: usize = 0;
            while a_i < active_len {
                let act_v = unsafe { *frame_u32_at(active, a_i) };
                let act_iv = unsafe { x64_interval_at(intervals, act_v as usize) };
                let overlaps = unsafe { x64_intervals_overlap(view(*act_iv), view(*cur_iv)) };
                if overlaps {
                    let ar = unsafe { (*act_iv).assigned_reg };
                    busy_active = busy_active | x64_reg_bit(ar);
                }
                a_i = a_i + 1;
            }

            let avail_mask = allowed_for_cur & (0xFFFFFFFFu32 ^ busy_active);
            let chosen = pick_best_reg(avail_mask, rclass, crosses, hint_reg, used_callee_mask);
            if chosen != REG_NONE {
                unsafe {
                    (*cur_iv).assigned_reg = chosen;
                    *frame_u32_at(active, active_len) = cur_v;
                }
                active_len = active_len + 1;
                if (x64_reg_bit(chosen) & X64_ALL_CALLEE_SAVED_MASK) != 0u32 {
                    used_callee_mask = used_callee_mask | x64_reg_bit(chosen);
                }
                if chosen == hint_reg && hint_reg != REG_NONE {
                    coalesced_cnt = coalesced_cnt + 1u32;
                }
            } else {
                // Spill / eviction heuristic: compare `cur_iv.spill_weight` against the lowest-weight
                // conflicting active interval whose register is legal for `cur_iv` (`AXS-RA-018`, `AXS-RA-022`).
                let cur_weight = unsafe { (*cur_iv).spill_weight };
                let mut min_weight: u64 = 0xFFFFFFFFFFFFFFFFu64;
                let mut victim_pos: usize = active_len;
                let mut v_i: usize = 0;
                while v_i < active_len {
                    let act_v = unsafe { *frame_u32_at(active, v_i) };
                    let act_iv = unsafe { x64_interval_at(intervals, act_v as usize) };
                    let act_reg = unsafe { (*act_iv).assigned_reg };
                    let act_w = unsafe { (*act_iv).spill_weight };
                    if (allowed_for_cur & x64_reg_bit(act_reg)) != 0u32 && act_w < min_weight {
                        min_weight = act_w;
                        victim_pos = v_i;
                    }
                    v_i = v_i + 1;
                }

                if victim_pos < active_len && min_weight < cur_weight {
                    let vic_v = unsafe { *frame_u32_at(active, victim_pos) };
                    let vic_iv = unsafe { x64_interval_at(intervals, vic_v as usize) };
                    let stolen_reg = unsafe { (*vic_iv).assigned_reg };
                    unsafe {
                        (*vic_iv).assigned_reg = REG_NONE;
                        (*vic_iv).is_spilled = true;
                        (*cur_iv).assigned_reg = stolen_reg;
                        *frame_u32_at(active, victim_pos) = cur_v;
                    }
                } else {
                    unsafe {
                        (*cur_iv).assigned_reg = REG_NONE;
                        (*cur_iv).is_spilled = true;
                    }
                }
            }
        }
        idx = idx + 1;
    }

    // Finalize allocated vs. spilled/rematerialized intervals and assign colored spill slots.
    let remat_in_place = arena_alloc_raw(mut_view(*arena), vreg_count, 1) as *mut u8;
    let mut allocated_cnt: u32 = 0u32;
    let mut spilled_cnt: u32 = 0u32;
    let mut remat_cnt: u32 = 0u32;
    used_phys_mask = 0u32;
    used_callee_mask = 0u32;

    let mut fv: usize = 0;
    while fv < vreg_count {
        unsafe {
            *u8_at_mut(remat_in_place, fv) = 0u8;
        }
        let iv = unsafe { x64_interval_at(intervals, fv) };
        let u_cnt = unsafe { (*iv).use_count };
        let reg = unsafe { (*iv).assigned_reg };
        let must_s = unsafe { (*iv).must_stack };
        let rk = unsafe { (*iv).remat_kind };
        let has_non_mov = unsafe { *u8_at_mut(non_mov_use, fv) };

        if u_cnt > 0u32 {
            if reg != REG_NONE && !must_s {
                allocated_cnt = allocated_cnt + 1u32;
                let bit = x64_reg_bit(reg);
                used_phys_mask = used_phys_mask | bit;
                if (bit & X64_ALL_CALLEE_SAVED_MASK) != 0u32 {
                    used_callee_mask = used_callee_mask | bit;
                }
            } else {
                unsafe {
                    (*iv).assigned_reg = REG_NONE;
                    (*iv).is_spilled = true;
                }
                if !must_s && (rk == X64_REMAT_CONST || rk == X64_REMAT_STACK_ADDR) && has_non_mov == 0u8 {
                    unsafe {
                        *u8_at_mut(remat_in_place, fv) = 1u8;
                    }
                    remat_cnt = remat_cnt + 1u32;
                } else {
                    spilled_cnt = spilled_cnt + 1u32;
                    let vp = unsafe { lir_vreg_at(lir.vregs, fv) };
                    let vty_v: u32 = unsafe { (*vp).ty.v };
                    let sz = type_size(TypeId { v: vty_v }, interner);
                    let al = type_align(TypeId { v: vty_v }, interner);
                    let cslot = unsafe {
                        x64_stack_slot_alloc_for_interval(mut_view(*arena), mut_view(spill_alloc), view(*iv), sz, al)
                    };
                    unsafe {
                        (*iv).spill_slot = cslot as i32;
                    }
                }
            }
        }
        fv = fv + 1;
    }

    rewrite_allocated_and_remat_ops(mut_view(*body), intervals, vreg_count, slot_offset, remat_in_place);
    peephole_fold_allocated_moves(mut_view(*body));

    X64RegAllocResult {
        intervals: intervals,
        liveness: liveness_ptr,
        spill_slots: spill_alloc,
        interval_count: vreg_count as u32,
        used_phys_reg_mask: used_phys_mask,
        used_callee_saved_mask: used_callee_mask,
        allocated_vreg_count: allocated_cnt,
        spilled_vreg_count: spilled_cnt,
        remat_vreg_count: remat_cnt,
        coalesced_copy_count: coalesced_cnt,
        pad: 0u32,
    }
}

pub fn x64_regalloc_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64RegAllocResult {
    x64_regalloc_with_pgo_in_arena(mut_view(*arena), mut_view(*body), lir, interner, 0 as *const u64)
}

pub fn x64_regalloc(
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64RegAllocResult {
    let arena_ptr = body.arena;
    unsafe {
        x64_regalloc_in_arena(mut_view(*arena_ptr), mut_view(*body), lir, interner)
    }
}

// =============================================================================
// 7. x86-64 Frame Layout & Lowering (SPEC-77 §3.4 & §3.6, AXS-RA-021, AXS-RA-023)
// =============================================================================

@derive(Copy)
pub struct X64FrameLayout {
    pub slot_offsets: *mut i32,
    pub slot_count: u32,
    pub frame_size: u32,
}

pub unsafe fn i32_at(base: *mut i32, idx: usize) -> *mut i32 {
    let off = lir_mul_usize(idx, size_of<i32>());
    ((base as usize) + off) as *mut i32
}

pub fn x64_frame_slot_offset(layout: view<X64FrameLayout>, slot_id: u32) -> i32 {
    let mut res: i32 = 0;
    if slot_id < layout.slot_count && (layout.slot_offsets as usize) != 0 {
        res = unsafe { *i32_at(layout.slot_offsets, slot_id as usize) };
    }
    res
}

pub fn x64_frame_has_meta(layout: view<X64FrameLayout>) -> bool {
    if (layout.slot_offsets as usize) == 0 {
        return false;
    }
    let sc = layout.slot_count as usize;
    let m0 = unsafe { *i32_at(layout.slot_offsets, sc) };
    let m4 = unsafe { *i32_at(layout.slot_offsets, sc + 4) };
    let expected = X64_FRAME_META_MAGIC ^ (layout.frame_size as i32) ^ (layout.slot_count as i32);
    m0 == X64_FRAME_META_MAGIC && m4 == expected
}

pub fn x64_frame_callee_saved_mask(layout: view<X64FrameLayout>) -> u32 {
    if x64_frame_has_meta(layout) {
        let sc = layout.slot_count as usize;
        unsafe { (*i32_at(layout.slot_offsets, sc + 1)) as u32 }
    } else {
        X64_GPR_CALLEE_SAVED_MASK
    }
}

pub fn x64_frame_callee_saved_bytes(layout: view<X64FrameLayout>) -> u32 {
    if x64_frame_has_meta(layout) {
        let sc = layout.slot_count as usize;
        unsafe { (*i32_at(layout.slot_offsets, sc + 2)) as u32 }
    } else {
        X64_CALLEE_SAVED_BYTES
    }
}

pub fn x64_frame_xmm_save_offset(layout: view<X64FrameLayout>) -> i32 {
    if x64_frame_has_meta(layout) {
        let sc = layout.slot_count as usize;
        unsafe { *i32_at(layout.slot_offsets, sc + 3) }
    } else {
        0
    }
}

fn frame_write_meta(
    offsets_ptr: *mut i32,
    slot_count: u32,
    frame_size: u32,
    callee_mask: u32,
    callee_bytes: u32,
    xmm_offset: i32
) {
    if (offsets_ptr as usize) != 0 {
        let sc = slot_count as usize;
        let chk = X64_FRAME_META_MAGIC ^ (frame_size as i32) ^ (slot_count as i32);
        unsafe {
            *i32_at(offsets_ptr, sc) = X64_FRAME_META_MAGIC;
            *i32_at(offsets_ptr, sc + 1) = callee_mask as i32;
            *i32_at(offsets_ptr, sc + 2) = callee_bytes as i32;
            *i32_at(offsets_ptr, sc + 3) = xmm_offset;
            *i32_at(offsets_ptr, sc + 4) = chk;
        }
    }
}

fn frame_align_up_i32(val: i32, align: i32) -> i32 {
    let mask = align - 1;
    (val + mask) & (0 - align)
}

pub fn x64_frame_rewrite_ops(body: mut_view<X64MIBody>, layout: view<X64FrameLayout>) {
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let op_count = unsafe { (*inst).op_count };
            let mut i: u8 = 0u8;
            while i < op_count {
                let op = unsafe { (*inst).ops[i as usize] };
                if op.kind == X64_OP_FRAME {
                    let sid = op.frame.slot_id;
                    let off = op.frame.offset;
                    let base_off = x64_frame_slot_offset(layout, sid);
                    let disp = base_off + off;
                    unsafe {
                        (*inst).ops[i as usize] = x64_op_mem(REG_RBP, REG_NONE, 1u8, disp, false);
                    }
                }
                i = i + 1u8;
            }
            inst = unsafe { (*inst).next };
        }
        b = b + 1;
    }
}

// Baseline (`-O0`) stack-slot-per-vreg frame lowering with all 7 callee-saved GPRs saved.
pub fn x64_frame_lower_baseline_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64FrameLayout {
    let total_slots = (lir.slot_count + lir.vreg_count) as u32;
    let mut offsets_ptr: *mut i32 = 0 as *mut i32;
    if total_slots > 0u32 {
        let bytes = lir_mul_usize(total_slots as usize, size_of<i32>());
        offsets_ptr = arena_alloc_raw(mut_view(*arena), bytes, align_of<i32>()) as *mut i32;
    }

    // 7 callee-saved registers pushed after RBP: RBX, RSI, RDI, R12, R13, R14, R15 = 56 bytes
    let mut current_offset: i32 = 56;

    // Minimum shadow space on Windows x64 is 32 bytes
    let sh0 = body.shadow_space;
    if sh0 < 32u32 {
        body.shadow_space = 32u32;
    }

    let mut i: usize = 0;
    while i < lir.slot_count {
        let slot = unsafe { lir_slot_at(lir.slots, i) };
        let is_const = unsafe { (*slot).is_const };
        if is_const {
            unsafe {
                *i32_at(offsets_ptr, i) = 0;
            }
        } else {
            let sty_v = unsafe { (*slot).ty.v };
            let mut size = type_size(TypeId { v: sty_v }, interner);
            let mut align = type_align(TypeId { v: sty_v }, interner);
            if size < 8u32 { size = 8u32; }
            if align < 8u32 { align = 8u32; }
            current_offset = frame_align_up_i32(current_offset + (size as i32), align as i32);
            unsafe {
                *i32_at(offsets_ptr, i) = 0 - current_offset;
            }
        }
        i = i + 1;
    }

    let mut v: usize = 0;
    while v < lir.vreg_count {
        let vreg = unsafe { lir_vreg_at(lir.vregs, v) };
        let vty_v = unsafe { (*vreg).ty.v };
        let mut size = type_size(TypeId { v: vty_v }, interner);
        let mut align = type_align(TypeId { v: vty_v }, interner);
        if size < 8u32 { size = 8u32; }
        if align < 8u32 { align = 8u32; }
        current_offset = frame_align_up_i32(current_offset + (size as i32), align as i32);
        unsafe {
            *i32_at(offsets_ptr, lir.slot_count + v) = 0 - current_offset;
        }
        v = v + 1;
    }

    current_offset = current_offset + (body.shadow_space as i32);
    // Align total RBP-relative offset (56 + frame_size) to a multiple of 16 bytes
    current_offset = frame_align_up_i32(current_offset, 16);

    let layout = X64FrameLayout {
        slot_offsets: offsets_ptr,
        slot_count: total_slots,
        frame_size: (current_offset - 56) as u32,
    };

    x64_frame_rewrite_ops(mut_view(*body), view(layout));
    layout
}

// Optimizing (`-O1` / `-O2`) frame lowering with linear-scan register allocation,
// colored spill slots, and dynamic callee-saved register save/restore (`SPEC-77`).
pub fn x64_frame_lower_opt_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    opt_level: u8
) -> X64FrameLayout {
    if opt_level == 0u8 || lir.bb_count == 0 {
        return x64_frame_lower_baseline_in_arena(mut_view(*arena), mut_view(*body), lir, interner);
    }

    let ra = x64_regalloc_in_arena(mut_view(*arena), mut_view(*body), lir, interner);

    // Check if any instruction in `body` explicitly clobbers a callee-saved GPR (e.g. `REG_RBX` in `uoverflow`).
    let mut extra_callee_mask: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let dm = unsafe { mi_inst_phys_def_mask(view(*inst)) };
            extra_callee_mask = extra_callee_mask | (dm & X64_ALL_CALLEE_SAVED_MASK);
            inst = unsafe { (*inst).next };
        }
        b = b + 1;
    }

    let used_callee_mask = ra.used_callee_saved_mask | extra_callee_mask;
    let gpr_callee_cnt = x64_popcount_u32(used_callee_mask & X64_GPR_CALLEE_SAVED_MASK);
    let pushed_callee_bytes = gpr_callee_cnt * 8u32;
    let xmm_callee_cnt = x64_popcount_u32(used_callee_mask & X64_XMM_CALLEE_SAVED_MASK);

    let total_slots = (lir.slot_count + lir.vreg_count) as u32;
    let alloc_words = (total_slots + 5u32) as usize;
    let alloc_bytes = lir_mul_usize(alloc_words, size_of<i32>());
    let offsets_ptr = arena_alloc_raw(mut_view(*arena), alloc_bytes, align_of<i32>()) as *mut i32;

    let mut current_offset: i32 = pushed_callee_bytes as i32;

    // Reserve 16-byte-aligned slots for any used callee-saved XMM registers (XMM6..XMM15).
    let mut xmm_save_offset: i32 = 0;
    if xmm_callee_cnt > 0u32 {
        current_offset = frame_align_up_i32(current_offset + 16, 16);
        xmm_save_offset = 0 - current_offset;
        current_offset = current_offset + (((xmm_callee_cnt - 1u32) * 16u32) as i32);
    }

    let sh0 = body.shadow_space;
    if sh0 < 32u32 {
        body.shadow_space = 32u32;
    }

    let mut i: usize = 0;
    while i < lir.slot_count {
        let slot = unsafe { lir_slot_at(lir.slots, i) };
        let is_const = unsafe { (*slot).is_const };
        if is_const {
            unsafe {
                *i32_at(offsets_ptr, i) = 0;
            }
        } else {
            let sty_v = unsafe { (*slot).ty.v };
            let mut size = type_size(TypeId { v: sty_v }, interner);
            let mut align = type_align(TypeId { v: sty_v }, interner);
            if size < 8u32 { size = 8u32; }
            size = size + 8u32;
            if align < 8u32 { align = 8u32; }
            current_offset = frame_align_up_i32(current_offset + (size as i32), align as i32);
            unsafe {
                *i32_at(offsets_ptr, i) = 0 - current_offset;
            }
        }
        i = i + 1;
    }

    // Assign RBP-relative offsets to colored spill slots (`AXS-RA-023`).
    let mut cs: u32 = 0u32;
    while cs < ra.spill_slots.slot_count {
        let csp = unsafe { x64_colored_slot_at(ra.spill_slots.slots, cs as usize) };
        let sz = unsafe { (*csp).size };
        let al = unsafe { (*csp).align };
        current_offset = frame_align_up_i32(current_offset + (sz as i32), al as i32);
        unsafe {
            (*csp).rbp_offset = 0 - current_offset;
        }
        cs = cs + 1u32;
    }

    let mut v: usize = 0;
    while v < lir.vreg_count {
        let iv = unsafe { x64_interval_at(ra.intervals, v) };
        let sslot = unsafe { (*iv).spill_slot };
        if sslot >= 0 && (sslot as u32) < ra.spill_slots.slot_count {
            let csp = unsafe { x64_colored_slot_at(ra.spill_slots.slots, sslot as usize) };
            let rbp_off = unsafe { (*csp).rbp_offset };
            unsafe {
                *i32_at(offsets_ptr, lir.slot_count + v) = rbp_off;
            }
        } else {
            unsafe {
                *i32_at(offsets_ptr, lir.slot_count + v) = 0;
            }
        }
        v = v + 1;
    }

    current_offset = current_offset + (body.shadow_space as i32);
    // Align total RBP-relative offset (`pushed_callee_bytes + frame_size`) to a multiple of 16 bytes.
    current_offset = frame_align_up_i32(current_offset, 16);
    let frame_size = (current_offset - (pushed_callee_bytes as i32)) as u32;

    frame_write_meta(offsets_ptr, total_slots, frame_size, used_callee_mask, pushed_callee_bytes, xmm_save_offset);

    let layout = X64FrameLayout {
        slot_offsets: offsets_ptr,
        slot_count: total_slots,
        frame_size: frame_size,
    };

    x64_frame_rewrite_ops(mut_view(*body), view(layout));
    layout
}

pub fn x64_frame_lower_in_arena(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64FrameLayout {
    if lir.bb_count > 0 && lir.vreg_count > 2 {
        x64_frame_lower_opt_in_arena(mut_view(*arena), mut_view(*body), lir, interner, 1u8)
    } else {
        x64_frame_lower_baseline_in_arena(mut_view(*arena), mut_view(*body), lir, interner)
    }
}

pub fn x64_frame_lower(
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>
) -> X64FrameLayout {
    let arena_ptr = body.arena;
    unsafe {
        x64_frame_lower_in_arena(mut_view(*arena_ptr), mut_view(*body), lir, interner)
    }
}

pub fn ax_x64_frame_lower(
    body: mut_view<X64MIBody>,
    lir: view<LirBody>,
    interner: view<TypeInterner>,
    arena: mut_view<Arena>
) -> X64FrameLayout {
    x64_frame_lower_in_arena(mut_view(*arena), mut_view(*body), lir, interner)
}

// Helper for lowering a standalone `X64MIBody` with `slot_count` 8-byte slots without a `LirBody`.
pub fn x64_frame_lower_raw(
    arena: mut_view<Arena>,
    body: mut_view<X64MIBody>,
    slot_count: u32
) -> X64FrameLayout {
    let mut offsets_ptr: *mut i32 = 0 as *mut i32;
    if slot_count > 0u32 {
        let bytes = lir_mul_usize(slot_count as usize, size_of<i32>());
        offsets_ptr = arena_alloc_raw(mut_view(*arena), bytes, align_of<i32>()) as *mut i32;
    }

    let mut current_offset: i32 = 56;
    let sh1 = body.shadow_space;
    if sh1 < 32u32 {
        body.shadow_space = 32u32;
    }

    let mut i: u32 = 0u32;
    while i < slot_count {
        current_offset = frame_align_up_i32(current_offset + 8, 8);
        unsafe {
            *i32_at(offsets_ptr, i as usize) = 0 - current_offset;
        }
        i = i + 1u32;
    }

    current_offset = current_offset + (body.shadow_space as i32);
    current_offset = frame_align_up_i32(current_offset, 16);

    let layout = X64FrameLayout {
        slot_offsets: offsets_ptr,
        slot_count: slot_count,
        frame_size: (current_offset - 56) as u32,
    };

    x64_frame_rewrite_ops(mut_view(*body), view(layout));
    layout
}

// =============================================================================
// 8. Prologue & Epilogue Synthesis (SPEC-77 §3.4, AXS-RA-021, REQ-OPT-212)
// =============================================================================

pub fn x64_frame_emit_prologue(sec: mut_view<Section>, layout: view<X64FrameLayout>) {
    if x64_frame_has_meta(layout) {
        let mask = x64_frame_callee_saved_mask(layout);
        let xmm_off = x64_frame_xmm_save_offset(layout);
        x64_emit_prologue_masked(mut_view(*sec), layout.frame_size, mask, xmm_off);
    } else {
        x64_emit_prologue_size(mut_view(*sec), layout.frame_size);
    }
}

pub fn ax_x64_frame_emit_prologue(sec: mut_view<Section>, layout: view<X64FrameLayout>) {
    x64_frame_emit_prologue(mut_view(*sec), layout);
}

pub fn x64_frame_emit_epilogue(sec: mut_view<Section>, layout: view<X64FrameLayout>) {
    if x64_frame_has_meta(layout) {
        let mask = x64_frame_callee_saved_mask(layout);
        let xmm_off = x64_frame_xmm_save_offset(layout);
        x64_emit_epilogue_masked(mut_view(*sec), layout.frame_size, mask, xmm_off);
    } else {
        x64_emit_epilogue_size(mut_view(*sec), layout.frame_size);
    }
}

pub fn ax_x64_frame_emit_epilogue(sec: mut_view<Section>, layout: view<X64FrameLayout>) {
    x64_frame_emit_epilogue(mut_view(*sec), layout);
}

// =============================================================================
// 9. Machine IR Verifier (target/x64/verify/{verify.h,verify.c})
// =============================================================================

pub const X64_VERIFY_OK: u32 = 0u32;
pub const X64_VERIFY_ERR_SHADOW_SPACE: u32 = 1u32;
pub const X64_VERIFY_ERR_ALIGNMENT: u32 = 2u32;
pub const X64_VERIFY_ERR_FRAME_SIZE: u32 = 3u32;
pub const X64_VERIFY_ERR_MEM_MEM: u32 = 4u32;
pub const X64_VERIFY_ERR_OPERAND_FORM: u32 = 5u32;
pub const X64_VERIFY_ERR_IMUL_FORM: u32 = 6u32;
pub const X64_VERIFY_ERR_LEA_FORM: u32 = 7u32;
pub const X64_VERIFY_ERR_SHIFT_REG_CLASS: u32 = 8u32;
pub const X64_VERIFY_ERR_SHIFT_FORM: u32 = 9u32;
pub const X64_VERIFY_ERR_IDIV_FORM: u32 = 10u32;

pub fn x64_verify_error_msg(code: u32) -> Str {
    if code == X64_VERIFY_OK {
        "ok"
    } else if code == X64_VERIFY_ERR_SHADOW_SPACE {
        "Machine IR verifier: shadow space is present but < 32 bytes"
    } else if code == X64_VERIFY_ERR_ALIGNMENT {
        "Machine IR verifier: 16-byte alignment violated at call site"
    } else if code == X64_VERIFY_ERR_FRAME_SIZE {
        "Machine IR verifier: frame size consistency violated"
    } else if code == X64_VERIFY_ERR_MEM_MEM {
        "Machine IR verifier: illegal instruction form (mem, mem)"
    } else if code == X64_VERIFY_ERR_OPERAND_FORM {
        "Machine IR verifier: illegal operand form for opcode"
    } else if code == X64_VERIFY_ERR_IMUL_FORM {
        "Machine IR verifier: illegal operand form for imul"
    } else if code == X64_VERIFY_ERR_LEA_FORM {
        "Machine IR verifier: illegal operand form for lea"
    } else if code == X64_VERIFY_ERR_SHIFT_REG_CLASS {
        "Machine IR verifier: wrong register class"
    } else if code == X64_VERIFY_ERR_SHIFT_FORM {
        "Machine IR verifier: illegal operand form for shift"
    } else if code == X64_VERIFY_ERR_IDIV_FORM {
        "Machine IR verifier: illegal operand form for idiv"
    } else {
        "Machine IR verifier: unknown error"
    }
}

fn verify_inst(inst: view<X64MI>) -> u32 {
    let mut res: u32 = X64_VERIFY_OK;
    if inst.op_count == 2u8 {
        let k0 = inst.ops[0usize].kind;
        let k1 = inst.ops[1usize].kind;
        let opc = inst.opcode;

        if k0 == X64_OP_MEM && k1 == X64_OP_MEM {
            res = X64_VERIFY_ERR_MEM_MEM;
        } else if opc == X64_MI_MOV || opc == X64_MI_ADD || opc == X64_MI_SUB ||
                  opc == X64_MI_AND || opc == X64_MI_OR || opc == X64_MI_XOR {
            if !((k0 == X64_OP_REG && k1 == X64_OP_REG) ||
                 (k0 == X64_OP_REG && k1 == X64_OP_MEM) ||
                 (k0 == X64_OP_MEM && k1 == X64_OP_REG) ||
                 (k0 == X64_OP_REG && k1 == X64_OP_IMM) ||
                 (k0 == X64_OP_MEM && k1 == X64_OP_IMM)) {
                res = X64_VERIFY_ERR_OPERAND_FORM;
            }
        } else if opc == X64_MI_IMUL {
            if !((k0 == X64_OP_REG && k1 == X64_OP_REG) ||
                 (k0 == X64_OP_REG && k1 == X64_OP_MEM)) {
                res = X64_VERIFY_ERR_IMUL_FORM;
            }
        } else if opc == X64_MI_LEA {
            if !(k0 == X64_OP_REG && (k1 == X64_OP_MEM || k1 == X64_OP_SYM)) {
                res = X64_VERIFY_ERR_LEA_FORM;
            }
        } else if opc == X64_MI_SHL || opc == X64_MI_SAR || opc == X64_MI_SHR {
            if k0 == X64_OP_REG && k1 == X64_OP_IMM {
                res = X64_VERIFY_OK;
            } else if k0 == X64_OP_REG && k1 == X64_OP_REG {
                if inst.ops[1usize].reg != REG_RCX {
                    res = X64_VERIFY_ERR_SHIFT_REG_CLASS;
                }
            } else if k0 == X64_OP_MEM && k1 == X64_OP_IMM {
                res = X64_VERIFY_OK;
            } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
                if inst.ops[1usize].reg != REG_RCX {
                    res = X64_VERIFY_ERR_SHIFT_REG_CLASS;
                }
            } else {
                res = X64_VERIFY_ERR_SHIFT_FORM;
            }
        }
    } else if inst.op_count == 1u8 {
        if inst.opcode == X64_MI_IDIV && inst.ops[0usize].kind == X64_OP_IMM {
            res = X64_VERIFY_ERR_IDIV_FORM;
        }
    }
    res
}

pub fn x64_verify_checked(body: view<X64MIBody>, layout: view<X64FrameLayout>) -> u32 {
    let sh = body.shadow_space;
    let fs = layout.frame_size;
    let callee_bytes = x64_frame_callee_saved_bytes(layout);
    let mut res: u32 = X64_VERIFY_OK;
    if sh > 0u32 && sh < 32u32 {
        res = X64_VERIFY_ERR_SHADOW_SPACE;
    } else if sh > 0u32 && ((fs + callee_bytes) % 16u32) != 0u32 {
        res = X64_VERIFY_ERR_ALIGNMENT;
    } else if fs < sh {
        res = X64_VERIFY_ERR_FRAME_SIZE;
    } else {
        let mut b: usize = 0;
        while b < body.bb_count && res == X64_VERIFY_OK {
            let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
            let mut inst = unsafe { (*mbb).first_inst };
            while (inst as usize) != 0 && res == X64_VERIFY_OK {
                let err = unsafe { verify_inst(view(*inst)) };
                if err != X64_VERIFY_OK {
                    res = err;
                }
                inst = unsafe { (*inst).next };
            }
            b = b + 1;
        }
    }
    res
}

pub fn x64_verify(body: view<X64MIBody>, layout: view<X64FrameLayout>) {
    let err = x64_verify_checked(body, layout);
    assert(err == X64_VERIFY_OK);
}

pub fn ax_x64_verify(body: view<X64MIBody>, layout: view<X64FrameLayout>) {
    x64_verify(body, layout);
}

// =============================================================================
// 10. Machine IR-to-Section Encoding & Hex Formatting (driver/{emit_mc.c,emit_obj.c,build.c})
// =============================================================================

pub fn x64_encode_mi_inst(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>
) {
    let opc = inst.opcode;
    let sz = if inst.size != 0u8 { inst.size } else { 8u8 };
    let op0 = inst.ops[0usize];
    let op1 = inst.ops[1usize];

    if opc == X64_MI_MOV {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            if x64_reg_is_xmm(op0.reg) && x64_reg_is_xmm(op1.reg) {
                x64_movaps_rr(mut_view(*sec), op0.reg, op1.reg);
            } else {
                x64_mov_rr(mut_view(*sec), sz, op0.reg, op1.reg);
            }
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            if x64_reg_is_xmm(op0.reg) {
                x64_movups_rm(mut_view(*sec), op0.reg, op1.mem);
            } else {
                x64_mov_rm(mut_view(*sec), sz, op0.reg, op1.mem);
            }
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            if x64_reg_is_xmm(op1.reg) {
                x64_movups_mr(mut_view(*sec), op0.mem, op1.reg);
            } else {
                x64_mov_mr(mut_view(*sec), sz, op0.mem, op1.reg);
            }
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_mov_ri(mut_view(*sec), sz, op0.reg, op1.imm);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_IMM {
            x64_mov_mi(mut_view(*sec), sz, op0.mem, op1.imm as i32);
        }
    } else if opc == X64_MI_ADD {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_add_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_add_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_add_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_add_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_SUB {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_sub_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_sub_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_sub_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_sub_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_IMUL {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_imul_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_imul_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        }
    } else if opc == X64_MI_MUL {
        if op0.kind == X64_OP_REG {
            x64_mul_r(mut_view(*sec), 8u8, op0.reg);
        } else if op0.kind == X64_OP_MEM {
            x64_mul_m(mut_view(*sec), 8u8, op0.mem);
        }
    } else if opc == X64_MI_IDIV {
        if op0.kind == X64_OP_REG {
            x64_idiv_r(mut_view(*sec), 8u8, op0.reg);
        } else if op0.kind == X64_OP_MEM {
            x64_idiv_m(mut_view(*sec), 8u8, op0.mem);
        }
    } else if opc == X64_MI_AND {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_and_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_and_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_and_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_and_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_OR {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_or_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_or_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_or_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_or_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_XOR {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_xor_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_xor_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_xor_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_xor_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_SHL {
        if op1.kind == X64_OP_IMM {
            x64_shl_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as u8);
        } else if op1.kind == X64_OP_REG && op1.reg == REG_RCX {
            x64_shl_rcl(mut_view(*sec), 8u8, op0.reg);
        }
    } else if opc == X64_MI_SAR {
        if op1.kind == X64_OP_IMM {
            x64_sar_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as u8);
        } else if op1.kind == X64_OP_REG && op1.reg == REG_RCX {
            x64_sar_rcl(mut_view(*sec), 8u8, op0.reg);
        }
    } else if opc == X64_MI_SHR {
        if op1.kind == X64_OP_IMM {
            x64_shr_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as u8);
        } else if op1.kind == X64_OP_REG && op1.reg == REG_RCX {
            x64_shr_rcl(mut_view(*sec), 8u8, op0.reg);
        }
    } else if opc == X64_MI_LEA {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_lea(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_SYM {
            x64_lea_sym(mut_view(*sec), op0.reg, SymbolId { v: op1.sym });
        }
    } else if opc == X64_MI_CMP {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_cmp_rr(mut_view(*sec), sz, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_cmp_rm(mut_view(*sec), sz, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_cmp_ri(mut_view(*sec), sz, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_TEST {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_test_rr(mut_view(*sec), sz, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_test_rm(mut_view(*sec), sz, op0.reg, op1.mem);
        }
    } else if opc == X64_MI_SETCC {
        if op0.kind == X64_OP_IMM && op1.kind == X64_OP_REG {
            x64_setcc_r(mut_view(*sec), op0.imm as u8, op1.reg);
        }
    } else if opc == X64_MI_JMP {
        if op0.kind == X64_OP_IMM {
            x64_jmp(mut_view(*sec), op0.imm as i32);
        }
    } else if opc == X64_MI_JCC {
        if op0.kind == X64_OP_IMM && op1.kind == X64_OP_IMM {
            x64_jcc(mut_view(*sec), op0.imm as u8, op1.imm as i32);
        }
    } else if opc == X64_MI_CALL {
        if inst.op_count > 0u8 && op0.kind == X64_OP_REG {
            x64_call_r(mut_view(*sec), op0.reg);
        }
    } else if opc == X64_MI_PUSH {
        if op0.kind == X64_OP_REG {
            x64_push_r(mut_view(*sec), op0.reg);
        }
    } else if opc == X64_MI_POP {
        if op0.kind == X64_OP_REG {
            x64_pop_r(mut_view(*sec), op0.reg);
        }
    } else if opc == X64_MI_RET {
        x64_frame_emit_epilogue(mut_view(*sec), layout);
        x64_ret(mut_view(*sec));
    }
}

pub fn x64_encode_mi_inst_obj(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>,
    obj: mut_view<ObjModel>
) {
    let opc = inst.opcode;
    let op0 = inst.ops[0usize];
    let op1 = inst.ops[1usize];

    if opc == X64_MI_LEA && op0.kind == X64_OP_REG && op1.kind == X64_OP_SYM {
        if (inst.msg as usize) != 0 {
            x64_lea_extern(mut_view(*sec), mut_view(*obj), op0.reg, inst.msg);
        } else {
            x64_lea_sym(mut_view(*sec), op0.reg, SymbolId { v: op1.sym });
        }
    } else if opc == X64_MI_CALL {
        if (inst.msg as usize) != 0 {
            x64_call_extern(mut_view(*sec), mut_view(*obj), inst.msg);
        } else if inst.op_count > 0u8 && op0.kind == X64_OP_REG {
            x64_call_r(mut_view(*sec), op0.reg);
        }
    } else {
        x64_encode_mi_inst(mut_view(*sec), inst, layout);
    }
}

fn x64_encode_mi_inst_mc(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>
) {
    let opc = inst.opcode;
    let op0 = inst.ops[0usize];
    let op1 = inst.ops[1usize];

    if opc == X64_MI_MOV {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_mov_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_mov_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_mov_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_mov_ri(mut_view(*sec), 8u8, op0.reg, op1.imm);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_IMM {
            x64_mov_mi(mut_view(*sec), 8u8, op0.mem, op1.imm as i32);
        }
    } else if opc == X64_MI_ADD {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_add_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_add_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_add_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_add_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_SUB {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_sub_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_sub_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_sub_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_sub_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_IMUL {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_imul_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_imul_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        }
    } else if opc == X64_MI_LEA {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_lea(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_SYM {
            x64_lea_sym(mut_view(*sec), op0.reg, SymbolId { v: 0u32 });
        }
    } else if opc == X64_MI_RET {
        x64_frame_emit_epilogue(mut_view(*sec), layout);
        x64_ret(mut_view(*sec));
    }
}

// Emit prologue + all instructions of `body` into `sec` (matching `emit_mc.c`).
pub fn x64_emit_mi_body_mc(
    sec: mut_view<Section>,
    body: view<X64MIBody>,
    layout: view<X64FrameLayout>
) {
    x64_frame_emit_prologue(mut_view(*sec), layout);
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            unsafe {
                x64_encode_mi_inst_mc(mut_view(*sec), view(*inst), layout);
                inst = (*inst).next;
            }
        }
        b = b + 1;
    }
}

@derive(Copy)
struct BranchFixupEntry {
    fixup: u32,
    target: u32,
}

unsafe fn frame_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = lir_mul_usize(idx, size_of<u32>());
    ((base as usize) + off) as *mut u32
}

unsafe fn frame_fixup_at(base: *mut BranchFixupEntry, idx: usize) -> *mut BranchFixupEntry {
    let off = lir_mul_usize(idx, size_of<BranchFixupEntry>());
    ((base as usize) + off) as *mut BranchFixupEntry
}

// Emit prologue + all basic blocks with branch fixup resolution into `sec` (matching `emit_obj.c` / `build.c`).
pub fn x64_emit_mi_body_obj(
    sec: mut_view<Section>,
    body: view<X64MIBody>,
    layout: view<X64FrameLayout>,
    obj: mut_view<ObjModel>
) {
    x64_frame_emit_prologue(mut_view(*sec), layout);
    if body.bb_count > 0 {
        let bb_offsets = unsafe {
            arena_alloc_raw(mut_view(*body.arena), lir_mul_usize(body.bb_count, size_of<u32>()), align_of<u32>()) as *mut u32
        };

        // Count branch instructions to allocate fixup table in the arena
        let mut fixup_cap: usize = 16;
        let mut b0: usize = 0;
        while b0 < body.bb_count {
            let mbb0 = unsafe { x64_mi_bb_at(body.bbs, b0) };
            let mut inst0 = unsafe { (*mbb0).first_inst };
            while (inst0 as usize) != 0 {
                let opc0 = unsafe { (*inst0).opcode };
                if opc0 == X64_MI_JMP || opc0 == X64_MI_JCC || opc0 == X64_MI_ASSERT {
                    fixup_cap = fixup_cap + 1;
                }
                inst0 = unsafe { (*inst0).next };
            }
            b0 = b0 + 1;
        }

        let fixups = unsafe {
            arena_alloc_raw(mut_view(*body.arena), lir_mul_usize(fixup_cap, size_of<BranchFixupEntry>()), align_of<BranchFixupEntry>()) as *mut BranchFixupEntry
        };
        let mut num_fixups: usize = 0;

        let mut b: usize = 0;
        while b < body.bb_count {
            unsafe {
                *frame_u32_at(bb_offsets, b) = sec.bytes_len as u32;
            }
            let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
            let mut inst = unsafe { (*mbb).first_inst };
            while (inst as usize) != 0 {
                let opc = unsafe { (*inst).opcode };
                if opc == X64_MI_JMP {
                    let tgt = unsafe { (*inst).ops[0usize].imm as u32 };
                    let fx_off = (sec.bytes_len + 1) as u32;
                    x64_jmp(mut_view(*sec), 0);
                    if num_fixups < fixup_cap {
                        let fp = unsafe { frame_fixup_at(fixups, num_fixups) };
                        unsafe {
                            (*fp).fixup = fx_off;
                            (*fp).target = tgt;
                        }
                        num_fixups = num_fixups + 1;
                    }
                } else if opc == X64_MI_JCC {
                    let cc = unsafe { (*inst).ops[0usize].imm as u8 };
                    let tgt = unsafe { (*inst).ops[1usize].imm as u32 };
                    let fx_off = (sec.bytes_len + 2) as u32;
                    x64_jcc(mut_view(*sec), cc, 0);
                    if num_fixups < fixup_cap {
                        let fp = unsafe { frame_fixup_at(fixups, num_fixups) };
                        unsafe {
                            (*fp).fixup = fx_off;
                            (*fp).target = tgt;
                        }
                        num_fixups = num_fixups + 1;
                    }
                } else {
                    unsafe {
                        x64_encode_mi_inst_obj(mut_view(*sec), view(*inst), layout, mut_view(*obj));
                    }
                }
                inst = unsafe { (*inst).next };
            }
            b = b + 1;
        }

        let mut f: usize = 0;
        while f < num_fixups {
            let fp = unsafe { frame_fixup_at(fixups, f) };
            let fx_off = unsafe { (*fp).fixup };
            let tgt_bb = unsafe { (*fp).target as usize };
            if tgt_bb < body.bb_count {
                let tgt_byte_off = unsafe { *frame_u32_at(bb_offsets, tgt_bb) };
                x64_patch_rel32(mut_view(*sec), fx_off, tgt_byte_off);
            }
            f = f + 1;
        }
    }
}

fn hex_nibble_lower(n: u8) -> u8 {
    let v = n & 0xFu8;
    if v < 10u8 {
        48u8 + v
    } else {
        97u8 + (v - 10u8)
    }
}

// Format section bytes as lowercase hex `"%02x "` per byte followed by `"\n"`,
// matching `dump_hex` in `bootstrap/axiom0/src/driver/emit_mc.c` byte-for-byte.
pub fn x64_dump_mc_hex(sec: view<Section>, out: mut_view<DiagBuffer>) {
    let mut i: usize = 0;
    while i < sec.bytes_len {
        let b = unsafe { *(((sec.bytes as usize) + i) as *const u8) };
        diag_buf_push_byte(mut_view(*out), hex_nibble_lower(b >> 4u8));
        diag_buf_push_byte(mut_view(*out), hex_nibble_lower(b));
        diag_buf_push_byte(mut_view(*out), 32u8); // ' '
        i = i + 1;
    }
    diag_buf_push_byte(mut_view(*out), 10u8); // '\n'
}
