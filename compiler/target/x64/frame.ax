// =============================================================================
// 3. Machine IR Verifier (target/x64/verify/{verify.h,verify.c})
// =============================================================================

pub const X64_VERIFY_OK: u32 = 0u32;
pub const X64_VERIFY_ERR_SHADOW_SPACE: u32 = 1u32;
pub const X64_VERIFY_ERR_ALIGNMENT: u32 = 2u32;
pub const X64_VERIFY_ERR_FRAME_SIZE: u32 = 3u32;
pub const X64_VERIFY_ERR_MEM_MEM: u32 = 4u32;
pub const X64_VERIFY_ERR_OPERAND_FORM: u32 = 5u32;
pub const X64_VERIFY_ERR_IMUL_FORM: u32 = 6u32;
pub const X64_VERIFY_ERR_LEA_FORM: u32 = 7u32;
pub const X64_VERIFY_ERR_SHIFT_REG_CLASS: u32 = 8u32;
pub const X64_VERIFY_ERR_SHIFT_FORM: u32 = 9u32;
pub const X64_VERIFY_ERR_IDIV_FORM: u32 = 10u32;

pub fn x64_verify_error_msg(code: u32) -> Str {
    if code == X64_VERIFY_OK {
        "ok"
    } else if code == X64_VERIFY_ERR_SHADOW_SPACE {
        "Machine IR verifier: shadow space is present but < 32 bytes"
    } else if code == X64_VERIFY_ERR_ALIGNMENT {
        "Machine IR verifier: 16-byte alignment violated at call site"
    } else if code == X64_VERIFY_ERR_FRAME_SIZE {
        "Machine IR verifier: frame size consistency violated"
    } else if code == X64_VERIFY_ERR_MEM_MEM {
        "Machine IR verifier: illegal instruction form (mem, mem)"
    } else if code == X64_VERIFY_ERR_OPERAND_FORM {
        "Machine IR verifier: illegal operand form for opcode"
    } else if code == X64_VERIFY_ERR_IMUL_FORM {
        "Machine IR verifier: illegal operand form for imul"
    } else if code == X64_VERIFY_ERR_LEA_FORM {
        "Machine IR verifier: illegal operand form for lea"
    } else if code == X64_VERIFY_ERR_SHIFT_REG_CLASS {
        "Machine IR verifier: wrong register class"
    } else if code == X64_VERIFY_ERR_SHIFT_FORM {
        "Machine IR verifier: illegal operand form for shift"
    } else if code == X64_VERIFY_ERR_IDIV_FORM {
        "Machine IR verifier: illegal operand form for idiv"
    } else {
        "Machine IR verifier: unknown error"
    }
}

fn verify_inst(inst: view<X64MI>) -> u32 {
    let mut res: u32 = X64_VERIFY_OK;
    if inst.op_count == 2u8 {
        let k0 = inst.ops[0].kind;
        let k1 = inst.ops[1].kind;
        let opc = inst.opcode;

        if k0 == X64_OP_MEM && k1 == X64_OP_MEM {
            res = X64_VERIFY_ERR_MEM_MEM;
        } else if opc == X64_MI_MOV || opc == X64_MI_ADD || opc == X64_MI_SUB ||
                  opc == X64_MI_AND || opc == X64_MI_OR || opc == X64_MI_XOR {
            if !((k0 == X64_OP_REG && k1 == X64_OP_REG) ||
                 (k0 == X64_OP_REG && k1 == X64_OP_MEM) ||
                 (k0 == X64_OP_MEM && k1 == X64_OP_REG) ||
                 (k0 == X64_OP_REG && k1 == X64_OP_IMM) ||
                 (k0 == X64_OP_MEM && k1 == X64_OP_IMM)) {
                res = X64_VERIFY_ERR_OPERAND_FORM;
            }
        } else if opc == X64_MI_IMUL {
            if !((k0 == X64_OP_REG && k1 == X64_OP_REG) ||
                 (k0 == X64_OP_REG && k1 == X64_OP_MEM)) {
                res = X64_VERIFY_ERR_IMUL_FORM;
            }
        } else if opc == X64_MI_LEA {
            if !(k0 == X64_OP_REG && (k1 == X64_OP_MEM || k1 == X64_OP_SYM)) {
                res = X64_VERIFY_ERR_LEA_FORM;
            }
        } else if opc == X64_MI_SHL || opc == X64_MI_SAR || opc == X64_MI_SHR {
            if k0 == X64_OP_REG && k1 == X64_OP_IMM {
                res = X64_VERIFY_OK;
            } else if k0 == X64_OP_REG && k1 == X64_OP_REG {
                if inst.ops[1].reg != REG_RCX {
                    res = X64_VERIFY_ERR_SHIFT_REG_CLASS;
                }
            } else if k0 == X64_OP_MEM && k1 == X64_OP_IMM {
                res = X64_VERIFY_OK;
            } else if k0 == X64_OP_MEM && k1 == X64_OP_REG {
                if inst.ops[1].reg != REG_RCX {
                    res = X64_VERIFY_ERR_SHIFT_REG_CLASS;
                }
            } else {
                res = X64_VERIFY_ERR_SHIFT_FORM;
            }
        }
    } else if inst.op_count == 1u8 {
        if inst.opcode == X64_MI_IDIV && inst.ops[0].kind == X64_OP_IMM {
            res = X64_VERIFY_ERR_IDIV_FORM;
        }
    }
    res
}

pub fn x64_verify_checked(body: view<X64MIBody>, layout: view<X64FrameLayout>) -> u32 {
    let sh = body.shadow_space;
    let fs = layout.frame_size;
    let mut res: u32 = X64_VERIFY_OK;
    if sh > 0u32 && sh < 32u32 {
        res = X64_VERIFY_ERR_SHADOW_SPACE;
    } else if sh > 0u32 && ((fs + 56u32) % 16u32) != 0u32 {
        res = X64_VERIFY_ERR_ALIGNMENT;
    } else if fs < sh {
        res = X64_VERIFY_ERR_FRAME_SIZE;
    } else {
        let mut b: usize = 0;
        while b < body.bb_count && res == X64_VERIFY_OK {
            let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
            let mut inst = unsafe { (*mbb).first_inst };
            while (inst as usize) != 0 && res == X64_VERIFY_OK {
                let err = unsafe { verify_inst(view(*inst)) };
                if err != X64_VERIFY_OK {
                    res = err;
                }
                inst = unsafe { (*inst).next };
            }
            b = b + 1;
        }
    }
    res
}

pub fn x64_verify(body: view<X64MIBody>, layout: view<X64FrameLayout>) {
    let err = x64_verify_checked(body, layout);
    assert(err == X64_VERIFY_OK);
}

pub fn ax_x64_verify(body: view<X64MIBody>, layout: view<X64FrameLayout>) {
    x64_verify(body, layout);
}

// =============================================================================
// 4. Machine IR-to-Section Encoding & Hex Formatting (driver/{emit_mc.c,emit_obj.c,build.c})
// =============================================================================

pub fn x64_encode_mi_inst(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>
) {
    let opc = inst.opcode;
    let sz = if inst.size != 0u8 { inst.size } else { 8u8 };
    let op0 = inst.ops[0];
    let op1 = inst.ops[1];

    if opc == X64_MI_MOV {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_mov_rr(mut_view(*sec), sz, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_mov_rm(mut_view(*sec), sz, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_mov_mr(mut_view(*sec), sz, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_mov_ri(mut_view(*sec), sz, op0.reg, op1.imm);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_IMM {
            x64_mov_mi(mut_view(*sec), sz, op0.mem, op1.imm as i32);
        }
    } else if opc == X64_MI_ADD {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_add_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_add_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_add_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_add_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_SUB {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_sub_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_sub_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_sub_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_sub_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_IMUL {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_imul_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_imul_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        }
    } else if opc == X64_MI_MUL {
        if op0.kind == X64_OP_REG {
            x64_mul_r(mut_view(*sec), 8u8, op0.reg);
        } else if op0.kind == X64_OP_MEM {
            x64_mul_m(mut_view(*sec), 8u8, op0.mem);
        }
    } else if opc == X64_MI_IDIV {
        if op0.kind == X64_OP_REG {
            x64_idiv_r(mut_view(*sec), 8u8, op0.reg);
        } else if op0.kind == X64_OP_MEM {
            x64_idiv_m(mut_view(*sec), 8u8, op0.mem);
        }
    } else if opc == X64_MI_AND {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_and_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_and_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_and_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_and_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_OR {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_or_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_or_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_or_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_or_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_XOR {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_xor_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_xor_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_xor_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_xor_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_SHL {
        if op1.kind == X64_OP_IMM {
            x64_shl_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as u8);
        } else if op1.kind == X64_OP_REG && op1.reg == REG_RCX {
            x64_shl_rcl(mut_view(*sec), 8u8, op0.reg);
        }
    } else if opc == X64_MI_SAR {
        if op1.kind == X64_OP_IMM {
            x64_sar_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as u8);
        } else if op1.kind == X64_OP_REG && op1.reg == REG_RCX {
            x64_sar_rcl(mut_view(*sec), 8u8, op0.reg);
        }
    } else if opc == X64_MI_SHR {
        if op1.kind == X64_OP_IMM {
            x64_shr_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as u8);
        } else if op1.kind == X64_OP_REG && op1.reg == REG_RCX {
            x64_shr_rcl(mut_view(*sec), 8u8, op0.reg);
        }
    } else if opc == X64_MI_LEA {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_lea(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_SYM {
            x64_lea_sym(mut_view(*sec), op0.reg, SymbolId { v: op1.sym });
        }
    } else if opc == X64_MI_CMP {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_cmp_rr(mut_view(*sec), sz, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_cmp_rm(mut_view(*sec), sz, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_cmp_ri(mut_view(*sec), sz, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_TEST {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_test_rr(mut_view(*sec), sz, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_test_rm(mut_view(*sec), sz, op0.reg, op1.mem);
        }
    } else if opc == X64_MI_SETCC {
        if op0.kind == X64_OP_IMM && op1.kind == X64_OP_REG {
            x64_setcc_r(mut_view(*sec), op0.imm as u8, op1.reg);
        }
    } else if opc == X64_MI_JMP {
        if op0.kind == X64_OP_IMM {
            x64_jmp(mut_view(*sec), op0.imm as i32);
        }
    } else if opc == X64_MI_JCC {
        if op0.kind == X64_OP_IMM && op1.kind == X64_OP_IMM {
            x64_jcc(mut_view(*sec), op0.imm as u8, op1.imm as i32);
        }
    } else if opc == X64_MI_CALL {
        if inst.op_count > 0u8 && op0.kind == X64_OP_REG {
            x64_call_r(mut_view(*sec), op0.reg);
        }
    } else if opc == X64_MI_PUSH {
        if op0.kind == X64_OP_REG {
            x64_push_r(mut_view(*sec), op0.reg);
        }
    } else if opc == X64_MI_POP {
        if op0.kind == X64_OP_REG {
            x64_pop_r(mut_view(*sec), op0.reg);
        }
    } else if opc == X64_MI_RET {
        x64_frame_emit_epilogue(mut_view(*sec), layout);
        x64_ret(mut_view(*sec));
    }
}

pub fn x64_encode_mi_inst_obj(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>,
    obj: mut_view<ObjModel>
) {
    let opc = inst.opcode;
    let op0 = inst.ops[0];
    let op1 = inst.ops[1];

    if opc == X64_MI_LEA && op0.kind == X64_OP_REG && op1.kind == X64_OP_SYM {
        if (inst.msg as usize) != 0 {
            x64_lea_extern(mut_view(*sec), mut_view(*obj), op0.reg, inst.msg);
        } else {
            x64_lea_sym(mut_view(*sec), op0.reg, SymbolId { v: op1.sym });
        }
    } else if opc == X64_MI_CALL {
        if (inst.msg as usize) != 0 {
            x64_call_extern(mut_view(*sec), mut_view(*obj), inst.msg);
        } else if inst.op_count > 0u8 && op0.kind == X64_OP_REG {
            x64_call_r(mut_view(*sec), op0.reg);
        }
    } else {
        x64_encode_mi_inst(mut_view(*sec), inst, layout);
    }
}

fn x64_encode_mi_inst_mc(
    sec: mut_view<Section>,
    inst: view<X64MI>,
    layout: view<X64FrameLayout>
) {
    let opc = inst.opcode;
    let op0 = inst.ops[0];
    let op1 = inst.ops[1];

    if opc == X64_MI_MOV {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_mov_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_mov_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_mov_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_mov_ri(mut_view(*sec), 8u8, op0.reg, op1.imm);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_IMM {
            x64_mov_mi(mut_view(*sec), 8u8, op0.mem, op1.imm as i32);
        }
    } else if opc == X64_MI_ADD {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_add_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_add_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_add_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_add_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_SUB {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_sub_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_sub_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_MEM && op1.kind == X64_OP_REG {
            x64_sub_mr(mut_view(*sec), 8u8, op0.mem, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_IMM {
            x64_sub_ri(mut_view(*sec), 8u8, op0.reg, op1.imm as i32);
        }
    } else if opc == X64_MI_IMUL {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_REG {
            x64_imul_rr(mut_view(*sec), 8u8, op0.reg, op1.reg);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_imul_rm(mut_view(*sec), 8u8, op0.reg, op1.mem);
        }
    } else if opc == X64_MI_LEA {
        if op0.kind == X64_OP_REG && op1.kind == X64_OP_MEM {
            x64_lea(mut_view(*sec), 8u8, op0.reg, op1.mem);
        } else if op0.kind == X64_OP_REG && op1.kind == X64_OP_SYM {
            x64_lea_sym(mut_view(*sec), op0.reg, SymbolId { v: 0u32 });
        }
    } else if opc == X64_MI_RET {
        x64_frame_emit_epilogue(mut_view(*sec), layout);
        x64_ret(mut_view(*sec));
    }
}

// Emit prologue + all instructions of `body` into `sec` (matching `emit_mc.c`).
pub fn x64_emit_mi_body_mc(
    sec: mut_view<Section>,
    body: view<X64MIBody>,
    layout: view<X64FrameLayout>
) {
    x64_frame_emit_prologue(mut_view(*sec), layout);
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            unsafe {
                x64_encode_mi_inst_mc(mut_view(*sec), view(*inst), layout);
                inst = (*inst).next;
            }
        }
        b = b + 1;
    }
}

@derive(Copy)
struct BranchFixupEntry {
    fixup: u32,
    target: u32,
}

unsafe fn frame_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = lir_mul_usize(idx, size_of<u32>());
    ((base as usize) + off) as *mut u32
}

unsafe fn frame_fixup_at(base: *mut BranchFixupEntry, idx: usize) -> *mut BranchFixupEntry {
    let off = lir_mul_usize(idx, size_of<BranchFixupEntry>());
    ((base as usize) + off) as *mut BranchFixupEntry
}

// Emit prologue + all basic blocks with branch fixup resolution into `sec` (matching `emit_obj.c` / `build.c`).
pub fn x64_emit_mi_body_obj(
    sec: mut_view<Section>,
    body: view<X64MIBody>,
    layout: view<X64FrameLayout>,
    obj: mut_view<ObjModel>
) {
    x64_frame_emit_prologue(mut_view(*sec), layout);
    if body.bb_count > 0 {
        let bb_offsets = unsafe {
            arena_alloc_raw(mut_view(*body.arena), lir_mul_usize(body.bb_count, size_of<u32>()), align_of<u32>()) as *mut u32
        };

        // Count branch instructions to allocate fixup table in the arena
        let mut fixup_cap: usize = 16;
        let mut b0: usize = 0;
        while b0 < body.bb_count {
            let mbb0 = unsafe { x64_mi_bb_at(body.bbs, b0) };
            let mut inst0 = unsafe { (*mbb0).first_inst };
            while (inst0 as usize) != 0 {
                let opc0 = unsafe { (*inst0).opcode };
                if opc0 == X64_MI_JMP || opc0 == X64_MI_JCC || opc0 == X64_MI_ASSERT {
                    fixup_cap = fixup_cap + 1;
                }
                inst0 = unsafe { (*inst0).next };
            }
            b0 = b0 + 1;
        }

        let fixups = unsafe {
            arena_alloc_raw(mut_view(*body.arena), lir_mul_usize(fixup_cap, size_of<BranchFixupEntry>()), align_of<BranchFixupEntry>()) as *mut BranchFixupEntry
        };
        let mut num_fixups: usize = 0;

        let mut b: usize = 0;
        while b < body.bb_count {
            unsafe {
                *frame_u32_at(bb_offsets, b) = sec.bytes_len as u32;
            }
            let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
            let mut inst = unsafe { (*mbb).first_inst };
            while (inst as usize) != 0 {
                let opc = unsafe { (*inst).opcode };
                if opc == X64_MI_JMP {
                    let tgt = unsafe { (*inst).ops[0].imm as u32 };
                    let fx_off = (sec.bytes_len + 1) as u32;
                    x64_jmp(mut_view(*sec), 0);
                    if num_fixups < fixup_cap {
                        let fp = unsafe { frame_fixup_at(fixups, num_fixups) };
                        unsafe {
                            (*fp).fixup = fx_off;
                            (*fp).target = tgt;
                        }
                        num_fixups = num_fixups + 1;
                    }
                } else if opc == X64_MI_JCC {
                    let cc = unsafe { (*inst).ops[0].imm as u8 };
                    let tgt = unsafe { (*inst).ops[1].imm as u32 };
                    let fx_off = (sec.bytes_len + 2) as u32;
                    x64_jcc(mut_view(*sec), cc, 0);
                    if num_fixups < fixup_cap {
                        let fp = unsafe { frame_fixup_at(fixups, num_fixups) };
                        unsafe {
                            (*fp).fixup = fx_off;
                            (*fp).target = tgt;
                        }
                        num_fixups = num_fixups + 1;
                    }
                } else {
                    unsafe {
                        x64_encode_mi_inst_obj(mut_view(*sec), view(*inst), layout, mut_view(*obj));
                    }
                }
                inst = unsafe { (*inst).next };
            }
            b = b + 1;
        }

        let mut f: usize = 0;
        while f < num_fixups {
            let fp = unsafe { frame_fixup_at(fixups, f) };
            let fx_off = unsafe { (*fp).fixup };
            let tgt_bb = unsafe { (*fp).target as usize };
            if tgt_bb < body.bb_count {
                let tgt_byte_off = unsafe { *frame_u32_at(bb_offsets, tgt_bb) };
                x64_patch_rel32(mut_view(*sec), fx_off, tgt_byte_off);
            }
            f = f + 1;
        }
    }
}

fn hex_nibble_lower(n: u8) -> u8 {
    let v = n & 0xFu8;
    if v < 10u8 {
        48u8 + v
    } else {
        97u8 + (v - 10u8)
    }
}

// Format section bytes as lowercase hex `"%02x "` per byte followed by `"\n"`,
// matching `dump_hex` in `bootstrap/axiom0/src/driver/emit_mc.c` byte-for-byte.
pub fn x64_dump_mc_hex(sec: view<Section>, out: mut_view<DiagBuffer>) {
    let mut i: usize = 0;
    while i < sec.bytes_len {
        let b = unsafe { *(((sec.bytes as usize) + i) as *const u8) };
        diag_buf_push_byte(mut_view(*out), hex_nibble_lower(b >> 4u8));
        diag_buf_push_byte(mut_view(*out), hex_nibble_lower(b));
        diag_buf_push_byte(mut_view(*out), 32u8); // ' '
        i = i + 1;
    }
    diag_buf_push_byte(mut_view(*out), 10u8); // '\n'
}
