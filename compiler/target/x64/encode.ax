    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, dst, REG_NONE);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0x8Au8 } else { 0x8Bu8 });
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(dst) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

