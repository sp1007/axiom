}

pub fn x64_push_r(sec: mut_view<Section>, src: i32) {
    if x64_reg_is_extended(src) {
        x64_emit8(mut_view(*sec), 0x41u8);
    }
    x64_emit8(mut_view(*sec), 0x50u8 + x64_reg_low3(src));
}

pub fn ax_x64_push_r(sec: mut_view<Section>, src: i32) {
    x64_push_r(sec, src);
}

pub fn x64_push_m(sec: mut_view<Section>, src: X64Mem) {
    let x = x64_reg_is_extended(src.index);
    let b = x64_reg_is_extended(src.base);
    if x || b {
        let mut rex: u8 = 0x40u8;
        if x { rex = rex | 2u8; }
        if b { rex = rex | 1u8; }
        x64_emit8(mut_view(*sec), rex);
    }
    x64_emit8(mut_view(*sec), 0xFFu8);
    x64_emit_modrm_sib_disp(mut_view(*sec), 6, src);
}

pub fn ax_x64_push_m(sec: mut_view<Section>, src: X64Mem) {
    x64_push_m(sec, src);
}

pub fn x64_pop_r(sec: mut_view<Section>, dst: i32) {
    if x64_reg_is_extended(dst) {
        x64_emit8(mut_view(*sec), 0x41u8);
    }
    x64_emit8(mut_view(*sec), 0x58u8 + x64_reg_low3(dst));
}

pub fn ax_x64_pop_r(sec: mut_view<Section>, dst: i32) {
    x64_pop_r(sec, dst);
}

pub fn x64_pop_m(sec: mut_view<Section>, dst: X64Mem) {
    let x = x64_reg_is_extended(dst.index);
    let b = x64_reg_is_extended(dst.base);
    if x || b {
        let mut rex: u8 = 0x40u8;
        if x { rex = rex | 2u8; }
        if b { rex = rex | 1u8; }
        x64_emit8(mut_view(*sec), rex);
    }
    x64_emit8(mut_view(*sec), 0x8Fu8);
    x64_emit_modrm_sib_disp(mut_view(*sec), 0, dst);
}

pub fn ax_x64_pop_m(sec: mut_view<Section>, dst: X64Mem) {
    x64_pop_m(sec, dst);
}

pub fn x64_int3(sec: mut_view<Section>) {
    x64_emit8(sec, 0xCCu8);
}

pub fn ax_x64_int3(sec: mut_view<Section>) {
    x64_int3(sec);
}

pub fn x64_nop(sec: mut_view<Section>) {
    x64_emit8(sec, 0x90u8);
}

pub fn ax_x64_nop(sec: mut_view<Section>) {
    x64_nop(sec);
}

pub fn x64_align_code(sec: mut_view<Section>, align: usize) {
    if align <= 1 {
        return;
    }
    while (sec.bytes_len % align) != 0 {
        x64_emit8(mut_view(*sec), 0x90u8);
    }
}

// =============================================================================
// 11. Relocation Generation, Branch Fixups, Rodata Labels & Frame Helpers
// =============================================================================

@derive(Copy)
pub struct X64BranchFixup {
    pub fixup_offset: u32,
    pub target_bb: u32,
}

// Emit a 5-byte `jmp rel32` placeholder (0xE9 00 00 00 00) and record the 4-byte displacement offset.
pub fn x64_emit_jmp_placeholder(sec: mut_view<Section>, target_bb: u32) -> X64BranchFixup {
    let fixup_off = (sec.bytes_len + 1) as u32;
    x64_jmp(sec, 0);
    X64BranchFixup {
        fixup_offset: fixup_off,
        target_bb: target_bb,
    }
}

// Emit a 6-byte `jcc rel32` placeholder (0x0F 0x80+cc 00 00 00 00) and record the 4-byte displacement offset.
pub fn x64_emit_jcc_placeholder(sec: mut_view<Section>, cc: u8, target_bb: u32) -> X64BranchFixup {
    let fixup_off = (sec.bytes_len + 2) as u32;
    x64_jcc(sec, cc, 0);
    X64BranchFixup {
        fixup_offset: fixup_off,
        target_bb: target_bb,
    }
}

// Patch a 32-bit PC-relative displacement in-place at `fixup_offset` (where `next_rip = fixup_offset + 4`).
pub fn x64_patch_rel32(sec: mut_view<Section>, fixup_offset: u32, target_byte_offset: u32) {
    let off = fixup_offset as usize;
    if off + 4 > sec.bytes_len || (sec.bytes as usize) == 0 {
        return;
    }
    let next_rip = fixup_offset + 4u32;
    let rel32 = (target_byte_offset as i32) - (next_rip as i32);
    coff_write_u32_le(sec.bytes, off, rel32 as u32);
}

// Patch all recorded basic-block branch fixups using `bb_offsets`.
pub fn x64_patch_branch_fixups(
    sec: mut_view<Section>,
    fixups: view<[X64BranchFixup]>,
    fixup_count: usize,
    bb_offsets: view<[u32]>
) {
    let bb_len = len(bb_offsets);
    let max_fixups = if fixup_count < len(fixups) { fixup_count } else { len(fixups) };
    let mut i: usize = 0;
    while i < max_fixups {
        let fx = fixups[i];
        let tgt_idx = fx.target_bb as usize;
        if tgt_idx < bb_len {
            x64_patch_rel32(mut_view(*sec), fx.fixup_offset, bb_offsets[tgt_idx]);
        }
        i = i + 1;
    }
}

// Compute 8-bit signed relative displacement for short branches (jmp8 / jcc8) where
// `next_rip = branch_start_offset + branch_len` (branch_len == 2 for jmp8 and jcc8).
pub fn x64_compute_rel8(branch_start_offset: u32, branch_len: u32, target_byte_offset: u32) -> i8 {
    let next_rip = (branch_start_offset + branch_len) as i32;
    let rel = (target_byte_offset as i32) - next_rip;
    rel as i8
}

// Lookup an existing symbol by C-string name, or create a new external symbol if absent.
pub fn x64_find_or_add_extern_sym(obj: mut_view<ObjModel>, name: *const u8) -> SymbolId {
    let existing = objmodel_find_symbol(view(*obj), name);
    if existing.is_some() {
        return existing;
    }
    objmodel_add_symbol(obj, name, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL)
}

// Lookup an existing symbol by `Str` name, or create a new external symbol if absent.
pub fn x64_find_or_add_extern_sym_str(obj: mut_view<ObjModel>, name: Str) -> SymbolId {
    let p = unsafe { address_of(name) as *const Str };
    let existing = objmodel_find_symbol_str(view(*obj), unsafe { *p });
    if existing.is_some() {
        return existing;
    }
    objmodel_add_symbol_str(obj, unsafe { *p }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL)
}

// Emit `call sym` (0xE8 + PC32 reloc with addend -4) for a named symbol (reusing or adding external symbol).
pub fn x64_call_extern(sec: mut_view<Section>, obj: mut_view<ObjModel>, name: *const u8) -> SymbolId {
    let sym = objmodel_add_symbol(obj, name, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    x64_call_sym(sec, SymbolId { v: sym.v });
    sym
}

pub fn x64_call_extern_str(sec: mut_view<Section>, obj: mut_view<ObjModel>, name: Str) -> SymbolId {
    let sym = objmodel_add_symbol_str(obj, name, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    x64_call_sym(sec, SymbolId { v: sym.v });
    sym
}

// Emit `lea dst, [rip + sym]` for a named function/rodata symbol (finding existing symbol first, as in emit_obj.c / build.c).
pub fn x64_lea_extern(sec: mut_view<Section>, obj: mut_view<ObjModel>, dst: i32, name: *const u8) -> SymbolId {
    let sym = x64_find_or_add_extern_sym(obj, name);
    x64_lea_sym(sec, dst, SymbolId { v: sym.v });
    sym
}

pub fn x64_lea_extern_str(sec: mut_view<Section>, obj: mut_view<ObjModel>, dst: i32, name: Str) -> SymbolId {
    let sym = x64_find_or_add_extern_sym_str(obj, name);
    x64_lea_sym(sec, dst, SymbolId { v: sym.v });
    sym
}

// Emit a NUL-terminated string literal into `.rdata` (with optional 8-byte padding) and register its symbol.
pub fn x64_emit_rodata_bytes(
    rdata_sec: mut_view<Section>,
    obj: mut_view<ObjModel>,
    rdata_sec_id: SectionId,
    sym_name: *const u8,
    bytes: *const u8,
    str_len: usize,
    align8: bool,
    linkage: u32
) -> SymbolId {
    let offset = rdata_sec.bytes_len as u64;
    if str_len > 0 && (bytes as usize) != 0 {
        section_add_bytes(mut_view(*rdata_sec), bytes, str_len);
    }
    section_add_byte(mut_view(*rdata_sec), 0u8);
    if align8 {
        while (rdata_sec.bytes_len % 8) != 0 {
            section_add_byte(mut_view(*rdata_sec), 0u8);
        }
    }
    objmodel_add_symbol(obj, sym_name, rdata_sec_id, offset, str_len as u64, linkage)
}

pub fn x64_emit_rodata_slice(
    rdata_sec: mut_view<Section>,
    obj: mut_view<ObjModel>,
    rdata_sec_id: SectionId,
    sym_name: Str,
    data: view<[u8]>,
    align8: bool,
    linkage: u32
) -> SymbolId {
    let offset = rdata_sec.bytes_len as u64;
    let str_len = len(data);
    if str_len > 0 {
        section_append_slice(mut_view(*rdata_sec), data);
    }
    section_add_byte(mut_view(*rdata_sec), 0u8);
    if align8 {
        while (rdata_sec.bytes_len % 8) != 0 {
            section_add_byte(mut_view(*rdata_sec), 0u8);
        }
    }
    objmodel_add_symbol_str(obj, sym_name, rdata_sec_id, offset, str_len as u64, linkage)
}

// Emit the inline `AX_X64_MI_ASSERT` panic call sequence from `bootstrap/axiom0/src/driver/build_native/build.c`:
//   48 83 EC 20                sub rsp, 32
//   48 8D 0D 00 00 00 00       lea rcx, [rip + str_sym]   (RELOC_X86_64_PC32, addend -4)
//   48 C7 C2 <msg_len:u32>     mov rdx, msg_len
//   E8 00 00 00 00             call axiom_panic           (RELOC_X86_64_PC32, addend -4)
pub fn x64_emit_panic_sequence(
    sec: mut_view<Section>,
    str_sym: SymbolId,
    msg_len: u32,
    panic_fn_sym: SymbolId
) {
    x64_sub_ri(mut_view(*sec), 8u8, REG_RSP, 32);
    x64_lea_sym(mut_view(*sec), REG_RCX, str_sym);
    x64_emit8(mut_view(*sec), 0x48u8);
    x64_emit8(mut_view(*sec), 0xC7u8);
    x64_emit8(mut_view(*sec), 0xC2u8);
    x64_emit32(mut_view(*sec), msg_len);
    x64_call_sym(mut_view(*sec), panic_fn_sym);
}

// Emit standard Windows x64 function prologue (matching bootstrap/axiom0/src/target/x64/frame/frame.c):
//   push rbp; mov rbp, rsp; push rbx, rsi, rdi, r12, r13, r14, r15
//   if frame_size > 4096: inline 4096-byte page probe loop (`test [rsp], eax`; `ja probe_start`)
//   else if frame_size > 0: `sub rsp, frame_size`
pub fn x64_emit_prologue_size(sec: mut_view<Section>, frame_size: u32) {
    x64_push_r(mut_view(*sec), REG_RBP);
    x64_mov_rr(mut_view(*sec), 8u8, REG_RBP, REG_RSP);
    x64_push_r(mut_view(*sec), REG_RBX);
    x64_push_r(mut_view(*sec), REG_RSI);
    x64_push_r(mut_view(*sec), REG_RDI);
    x64_push_r(mut_view(*sec), REG_R12);
    x64_push_r(mut_view(*sec), REG_R13);
    x64_push_r(mut_view(*sec), REG_R14);
    x64_push_r(mut_view(*sec), REG_R15);

    if frame_size > 0u32 {
        if frame_size > 4096u32 {
            x64_mov_ri(mut_view(*sec), 8u8, REG_RAX, frame_size as i64);
            let probe_start = sec.bytes_len as u32;
            x64_sub_ri(mut_view(*sec), 8u8, REG_RSP, 4096);
            let rsp_mem = x64_mem_base(REG_RSP);
            x64_test_rm(mut_view(*sec), 4u8, REG_RAX, rsp_mem);
            x64_sub_ri(mut_view(*sec), 8u8, REG_RAX, 4096);
            x64_cmp_ri(mut_view(*sec), 8u8, REG_RAX, 4096);
            let rel8 = x64_compute_rel8(sec.bytes_len as u32, 2u32, probe_start);
            x64_jcc8(mut_view(*sec), CC_A, rel8);
            x64_sub_rr(mut_view(*sec), 8u8, REG_RSP, REG_RAX);
        } else {
            x64_sub_ri(mut_view(*sec), 8u8, REG_RSP, frame_size as i32);
        }
    }
}

pub fn ax_x64_emit_prologue_size(sec: mut_view<Section>, frame_size: u32) {
    x64_emit_prologue_size(sec, frame_size);
}

// Emit standard Windows x64 function epilogue (matching bootstrap/axiom0/src/target/x64/frame/frame.c):
//   if frame_size > 0: `add rsp, frame_size`
//   pop r15, r14, r13, r12, rdi, rsi, rbx, rbp
pub fn x64_emit_epilogue_size(sec: mut_view<Section>, frame_size: u32) {
    if frame_size > 0u32 {
        x64_add_ri(mut_view(*sec), 8u8, REG_RSP, frame_size as i32);
    }
    x64_pop_r(mut_view(*sec), REG_R15);
    x64_pop_r(mut_view(*sec), REG_R14);
    x64_pop_r(mut_view(*sec), REG_R13);
    x64_pop_r(mut_view(*sec), REG_R12);
    x64_pop_r(mut_view(*sec), REG_RDI);
    x64_pop_r(mut_view(*sec), REG_RSI);
    x64_pop_r(mut_view(*sec), REG_RBX);
    x64_pop_r(mut_view(*sec), REG_RBP);
}

pub fn ax_x64_emit_epilogue_size(sec: mut_view<Section>, frame_size: u32) {
    x64_emit_epilogue_size(sec, frame_size);
}
