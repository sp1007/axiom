// =============================================================================
// 9. Bitwise Shift Instructions (SHL, SHR, SAR)
// =============================================================================

pub fn x64_shl_rcl(sec: mut_view<Section>, sz: u8, dst: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, REG_NONE, dst);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0xD2u8 } else { 0xD3u8 });
    x64_emit8(mut_view(*sec), 0xE0u8 | x64_reg_low3(dst));
}

pub fn ax_x64_shl_rcl(sec: mut_view<Section>, sz: u8, dst: i32) {
    x64_shl_rcl(sec, sz, dst);
}

pub fn x64_shl_ri(sec: mut_view<Section>, sz: u8, dst: i32, imm: u8) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, REG_NONE, dst);
    let modrm = 0xE0u8 | x64_reg_low3(dst);
    if imm == 1u8 {
        x64_emit8(mut_view(*sec), if sz == 1u8 { 0xD0u8 } else { 0xD1u8 });
        x64_emit8(mut_view(*sec), modrm);
    } else {
        x64_emit8(mut_view(*sec), if sz == 1u8 { 0xC0u8 } else { 0xC1u8 });
        x64_emit8(mut_view(*sec), modrm);
        x64_emit8(mut_view(*sec), imm);
    }
}

