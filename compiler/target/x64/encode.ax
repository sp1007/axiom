pub fn x64_lea_sym(sec: mut_view<Section>, dst: i32, sym: SymbolId) {
    x64_emit_rex_rr(mut_view(*sec), 8u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0x8Du8);
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(dst) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_lea_sym(sec: mut_view<Section>, dst: i32, sym: SymbolId) {
    x64_lea_sym(sec, dst, sym);
}

pub fn x64_lea_sym_disp(sec: mut_view<Section>, dst: i32, sym: SymbolId, disp: i64) {
    x64_emit_rex_rr(mut_view(*sec), 8u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0x8Du8);
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(dst) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, disp - 4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

