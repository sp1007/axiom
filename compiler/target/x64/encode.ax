pub fn x64_mi_opcode_name(opc: u32) -> Str {
    if opc == X64_MI_MOV { return "mov"; }
    if opc == X64_MI_ADD { return "add"; }
    if opc == X64_MI_SUB { return "sub"; }
    if opc == X64_MI_IMUL { return "imul"; }
    if opc == X64_MI_MUL { return "mul"; }
    if opc == X64_MI_IDIV { return "idiv"; }
    if opc == X64_MI_AND { return "and"; }
    if opc == X64_MI_OR { return "or"; }
    if opc == X64_MI_XOR { return "xor"; }
    if opc == X64_MI_SHL { return "shl"; }
    if opc == X64_MI_SAR { return "sar"; }
    if opc == X64_MI_SHR { return "shr"; }
    if opc == X64_MI_LEA { return "lea"; }
    if opc == X64_MI_CMP { return "cmp"; }
    if opc == X64_MI_TEST { return "test"; }
    if opc == X64_MI_JMP { return "jmp"; }
    if opc == X64_MI_JCC { return "jcc"; }
    if opc == X64_MI_CALL { return "call"; }
    if opc == X64_MI_ASSERT { return "assert"; }
    if opc == X64_MI_PUSH { return "push"; }
    if opc == X64_MI_POP { return "pop"; }
    if opc == X64_MI_SETCC { return "setcc"; }
    if opc == X64_MI_RET { return "ret"; }
    "unknown"
}

// =============================================================================
// 4. Memory Addressing Model (X64Mem / ax_x64_mem_t)
// =============================================================================

@derive(Copy)
pub struct X64Mem {
    pub base: i32,
    pub index: i32,
    pub scale: u8,
    pub disp: i32,
    pub is_rip: bool,
}

pub fn x64_mem_base(base: i32) -> X64Mem {
    X64Mem {
        base: base,
        index: REG_NONE,
        scale: 1u8,
        disp: 0,
        is_rip: false,
    }
}

pub fn ax_x64_mem_base(base: i32) -> X64Mem {
    x64_mem_base(base)
}

pub fn x64_mem_base_disp(base: i32, disp: i32) -> X64Mem {
    X64Mem {
        base: base,
        index: REG_NONE,
        scale: 1u8,
        disp: disp,
        is_rip: false,
    }
}

pub fn ax_x64_mem_base_disp(base: i32, disp: i32) -> X64Mem {
    x64_mem_base_disp(base, disp)
}

pub fn x64_mem_index(base: i32, index: i32, scale: u8) -> X64Mem {
    X64Mem {
        base: base,
        index: index,
        scale: scale,
        disp: 0,
        is_rip: false,
    }
}

pub fn ax_x64_mem_index(base: i32, index: i32, scale: u8) -> X64Mem {
    x64_mem_index(base, index, scale)
}

pub fn x64_mem_index_disp(base: i32, index: i32, scale: u8, disp: i32) -> X64Mem {
    X64Mem {
        base: base,
        index: index,
        scale: scale,
        disp: disp,
        is_rip: false,
    }
}

pub fn ax_x64_mem_index_disp(base: i32, index: i32, scale: u8, disp: i32) -> X64Mem {
    x64_mem_index_disp(base, index, scale, disp)
}

pub fn x64_mem_rip(disp: i32) -> X64Mem {
    X64Mem {
        base: REG_NONE,
        index: REG_NONE,
        scale: 1u8,
        disp: disp,
        is_rip: true,
    }
}

pub fn ax_x64_mem_rip(disp: i32) -> X64Mem {
    x64_mem_rip(disp)
}

pub fn x64_mem_frame_rbp(disp: i32) -> X64Mem {
    x64_mem_base_disp(REG_RBP, disp)
}

pub fn x64_mem_stack_rsp(disp: i32) -> X64Mem {
    x64_mem_base_disp(REG_RSP, disp)
}

// =============================================================================
// 5. Binary Encoding Primitives: Prefixes, REX, ModR/M, SIB, Displacements
// =============================================================================

pub fn x64_emit8(sec: mut_view<Section>, b: u8) {
    section_add_byte(sec, b);
}

pub fn x64_emit16(sec: mut_view<Section>, w: u16) {
    x64_emit8(mut_view(*sec), (w & 0xFFu16) as u8);
    x64_emit8(mut_view(*sec), ((w >> 8) & 0xFFu16) as u8);
}

pub fn x64_emit_i16(sec: mut_view<Section>, w: i16) {
    x64_emit16(sec, w as u16);
}

pub fn x64_emit32(sec: mut_view<Section>, d: u32) {
    x64_emit8(mut_view(*sec), (d & 0xFFu32) as u8);
    x64_emit8(mut_view(*sec), ((d >> 8) & 0xFFu32) as u8);
    x64_emit8(mut_view(*sec), ((d >> 16) & 0xFFu32) as u8);
    x64_emit8(mut_view(*sec), ((d >> 24) & 0xFFu32) as u8);
}

pub fn x64_emit_i32(sec: mut_view<Section>, d: i32) {
    x64_emit32(sec, d as u32);
}

pub fn x64_emit64(sec: mut_view<Section>, q: u64) {
    x64_emit32(mut_view(*sec), (q & 0xFFFFFFFFu64) as u32);
    x64_emit32(mut_view(*sec), ((q >> 32) & 0xFFFFFFFFu64) as u32);
}

pub fn x64_emit_i64(sec: mut_view<Section>, q: i64) {
    x64_emit64(sec, q as u64);
}

pub fn x64_emit_sz_prefix(sec: mut_view<Section>, sz: u8) {
    if sz == 2u8 {
        x64_emit8(sec, 0x66u8);
    }
}

// Compute REX prefix byte for register-register / register-only instruction forms.
// Returns 0u8 when no REX prefix should be emitted.
pub fn x64_rex_rr_byte(sz: u8, reg: i32, rm: i32) -> u8 {
    let w = sz == 8u8;
    let r = x64_reg_is_extended(reg);
    let b = x64_reg_is_extended(rm);
    let force = sz == 1u8 && (x64_reg_needs_byte_rex(reg) || x64_reg_needs_byte_rex(rm));
    if w || r || b || force {
        let mut rex: u8 = 0x40u8;
        if w { rex = rex | 8u8; }
        if r { rex = rex | 4u8; }
        if b { rex = rex | 1u8; }
        rex
    } else {
        0u8
    }
}

// Compute REX prefix byte for register-memory instruction forms.
// Returns 0u8 when no REX prefix should be emitted.
pub fn x64_rex_rm_byte(sz: u8, reg: i32, m: X64Mem) -> u8 {
    let w = sz == 8u8;
    let r = x64_reg_is_extended(reg);
    let x = x64_reg_is_extended(m.index);
    let b = x64_reg_is_extended(m.base);
    let force = sz == 1u8 && x64_reg_needs_byte_rex(reg);
    if w || r || x || b || force {
        let mut rex: u8 = 0x40u8;
        if w { rex = rex | 8u8; }
        if r { rex = rex | 4u8; }
        if x { rex = rex | 2u8; }
        if b { rex = rex | 1u8; }
        rex
    } else {
        0u8
    }
}

pub fn x64_emit_rex_rr(sec: mut_view<Section>, sz: u8, reg: i32, rm: i32) {
    let rex = x64_rex_rr_byte(sz, reg, rm);
    if rex != 0u8 {
        x64_emit8(sec, rex);
    }
}

pub fn x64_emit_rex_rm(sec: mut_view<Section>, sz: u8, reg: i32, m: X64Mem) {
    let rex = x64_rex_rm_byte(sz, reg, m);
    if rex != 0u8 {
        x64_emit8(sec, rex);
    }
}

pub fn x64_modrm_byte(mod_bits: u8, reg_bits: u8, rm_bits: u8) -> u8 {
    ((mod_bits & 3u8) << 6) | ((reg_bits & 7u8) << 3) | (rm_bits & 7u8)
}

pub fn x64_sib_byte(scale: u8, index: i32, base: i32) -> u8 {
    let mut scale_bits: u8 = 0u8;
    if scale == 2u8 {
        scale_bits = 1u8;
    } else if scale == 4u8 {
        scale_bits = 2u8;
    } else if scale == 8u8 {
        scale_bits = 3u8;
    }
    let idx_bits: u8 = if x64_reg_is_none(index) { 4u8 } else { x64_reg_low3(index) };
    let base_bits: u8 = x64_reg_low3(base);
    (scale_bits << 6) | (idx_bits << 3) | base_bits
}

pub fn x64_emit_modrm_sib_disp(sec: mut_view<Section>, reg: i32, m: X64Mem) {
    let r_bits = x64_reg_low3(reg);

    if m.is_rip {
        x64_emit8(mut_view(*sec), (r_bits << 3) | 5u8);
        x64_emit_i32(mut_view(*sec), m.disp);
        return;
    }

    let base_low3 = x64_reg_low3(m.base);
    let has_sib = (!x64_reg_is_none(m.index)) || (base_low3 == 4u8);

    let mut mod_bits: u8 = 0u8;
    if m.disp == 0 && base_low3 != 5u8 {
        mod_bits = 0u8;
    } else if m.disp >= -128 && m.disp <= 127 {
        mod_bits = 1u8;
    } else {
        mod_bits = 2u8;
    }

    if has_sib {
        x64_emit8(mut_view(*sec), (mod_bits << 6) | (r_bits << 3) | 4u8);
        x64_emit8(mut_view(*sec), x64_sib_byte(m.scale, m.index, m.base));
    } else {
        x64_emit8(mut_view(*sec), (mod_bits << 6) | (r_bits << 3) | base_low3);
    }

    if mod_bits == 1u8 {
        x64_emit8(mut_view(*sec), ((m.disp as u32) & 0xFFu32) as u8);
    } else if mod_bits == 2u8 || (mod_bits == 0u8 && base_low3 == 5u8) {
        x64_emit_i32(mut_view(*sec), m.disp);
    }
}

pub fn x64_emit_op_rm(sec: mut_view<Section>, sz: u8, op8: u8, op: u8, reg: i32, rm: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, reg, rm);
    x64_emit8(mut_view(*sec), if sz == 1u8 { op8 } else { op });
    x64_emit8(mut_view(*sec), 0xC0u8 | (x64_reg_low3(reg) << 3) | x64_reg_low3(rm));
}

pub fn x64_emit_op_mem(sec: mut_view<Section>, sz: u8, op8: u8, op: u8, reg: i32, m: X64Mem) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, reg, m);
    x64_emit8(mut_view(*sec), if sz == 1u8 { op8 } else { op });
    x64_emit_modrm_sib_disp(mut_view(*sec), reg, m);
}

// =============================================================================
// 6. Data Movement Instructions (MOV, MOVZX, MOVSX, LEA)
// =============================================================================

pub fn x64_mov_rr(sec: mut_view<Section>, sz: u8, dst: i32, src: i32) {
    x64_emit_op_rm(sec, sz, 0x88u8, 0x89u8, src, dst);
}

pub fn ax_x64_mov_rr(sec: mut_view<Section>, sz: u8, dst: i32, src: i32) {
    x64_mov_rr(sec, sz, dst, src);
}

pub fn x64_mov_rm(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_emit_op_mem(sec, sz, 0x8Au8, 0x8Bu8, dst, src);
}

pub fn ax_x64_mov_rm(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_mov_rm(sec, sz, dst, src);
}

pub fn x64_mov_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit_op_mem(sec, sz, 0x88u8, 0x89u8, src, dst);
}

pub fn ax_x64_mov_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_mov_mr(sec, sz, dst, src);
}

pub fn x64_mov_ri(sec: mut_view<Section>, sz: u8, dst: i32, imm: i64) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, REG_NONE, dst);
    let dst_bits = x64_reg_low3(dst);
    let uimm = imm as u64;
    if sz == 1u8 {
        x64_emit8(mut_view(*sec), 0xB0u8 + dst_bits);
        x64_emit8(mut_view(*sec), (uimm & 0xFFu64) as u8);
    } else if sz == 8u8 {
        x64_emit8(mut_view(*sec), 0xB8u8 + dst_bits);
        x64_emit64(mut_view(*sec), uimm);
    } else {
        x64_emit8(mut_view(*sec), 0xB8u8 + dst_bits);
        if sz == 2u8 {
            x64_emit16(mut_view(*sec), (uimm & 0xFFFFu64) as u16);
        } else {
            x64_emit32(mut_view(*sec), (uimm & 0xFFFFFFFFu64) as u32);
        }
    }
}

pub fn ax_x64_mov_ri(sec: mut_view<Section>, sz: u8, dst: i32, imm: i64) {
    x64_mov_ri(sec, sz, dst, imm);
}

pub fn x64_mov_mi(sec: mut_view<Section>, sz: u8, dst: X64Mem, imm: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, REG_NONE, dst);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0xC6u8 } else { 0xC7u8 });
    x64_emit_modrm_sib_disp(mut_view(*sec), 0, dst);
    let uimm = imm as u32;
    if sz == 1u8 {
        x64_emit8(mut_view(*sec), (uimm & 0xFFu32) as u8);
    } else if sz == 2u8 {
        x64_emit16(mut_view(*sec), (uimm & 0xFFFFu32) as u16);
    } else {
        x64_emit32(mut_view(*sec), uimm);
    }
}

pub fn ax_x64_mov_mi(sec: mut_view<Section>, sz: u8, dst: X64Mem, imm: i32) {
    x64_mov_mi(sec, sz, dst, imm);
}

pub fn x64_movzx_rr(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, dst, src);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), if src_sz == 1u8 { 0xB6u8 } else { 0xB7u8 });
    x64_emit8(mut_view(*sec), 0xC0u8 | (x64_reg_low3(dst) << 3) | x64_reg_low3(src));
}

pub fn ax_x64_movzx_rr(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: i32) {
    x64_movzx_rr(sec, sz, src_sz, dst, src);
}

pub fn x64_movzx_rm(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: X64Mem) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, dst, src);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), if src_sz == 1u8 { 0xB6u8 } else { 0xB7u8 });
    x64_emit_modrm_sib_disp(mut_view(*sec), dst, src);
}

pub fn ax_x64_movzx_rm(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: X64Mem) {
