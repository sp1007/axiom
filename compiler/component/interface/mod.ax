pub fn axiom_component_entry_symbol() -> StrView {
    ux2_sv("axiom_component_entry")
}

@derive(Copy)
pub struct ComponentHostContext {
    pub host_abi_version: u32,
    pub host_context_size: u32,
    pub host_fingerprint_lo: u64,
    pub host_fingerprint_hi: u64,
}

pub fn component_host_context_default() -> ComponentHostContext {
    ComponentHostContext {
        host_abi_version: 1u32,
        host_context_size: 48u32,
        host_fingerprint_lo: 0u64,
        host_fingerprint_hi: 0u64,
    }
}

// =============================================================================
// 5. Capability Manifest (AXS-COMP-013)
// =============================================================================

pub const CAP_HEAP_ALLOCATION: u32 = 0x0001u32
pub const CAP_FS_READ: u32 = 0x0002u32
pub const CAP_FS_WRITE: u32 = 0x0004u32
pub const CAP_NET_CONNECT: u32 = 0x0008u32
pub const CAP_CONCURRENCY: u32 = 0x0010u32
pub const CAP_GPU: u32 = 0x0020u32

@derive(Copy)
pub struct CapabilityEntry {
    pub cap_type: u32,
    pub flags: u32,
    pub resource_path: StrView,
}

pub fn capability_entry_new(cap_type: u32, flags: u32, path: StrView) -> CapabilityEntry {
    CapabilityEntry {
        cap_type: cap_type,
        flags: flags,
        resource_path: path,
    }
}

@derive(Copy)
pub struct CapabilityManifest {
    pub mask: u32,
    pub entry_count: u32,
}

pub fn capability_manifest_new(mask: u32, entry_count: u32) -> CapabilityManifest {
    CapabilityManifest { mask: mask, entry_count: entry_count }
}

pub fn capability_manifest_satisfies(req: CapabilityManifest, grant: CapabilityManifest) -> bool {
    let ungranted = req.mask & (~grant.mask)
    ungranted == 0u32
}

// =============================================================================
// 6. Embedded .axcomp Section Layout & Serializer/Parser (AXS-COMP-005)
// =============================================================================

pub const AXCOMP_MAGIC: u32 = 0x504D4F43u32 // ASCII "COMP" in little-endian
pub const AXCOMP_FORMAT_VERSION: u16 = 1u16
pub const AXCOMP_HEADER_SIZE: u16 = 128u16

@derive(Copy)
pub struct AxCompHeader {
    pub magic: u32,
    pub format_version: u16,
    pub header_size: u16,
    pub component_id_offset: u32,
    pub component_id_len: u32,
    pub semver_major: u32,
    pub semver_minor: u32,
    pub semver_patch: u32,
    pub semver_prerelease_offset: u32,
    pub abi_fingerprint_lo: u64,
    pub abi_fingerprint_hi: u64,
    pub target_triple_lo: u64,
    pub target_triple_hi: u64,
    pub state_schema_id_lo: u64,
    pub state_schema_id_hi: u64,
    pub capability_count: u32,
    pub capability_table_offset: u32,
    pub exported_iface_count: u32,
    pub exported_iface_table_offset: u32,
}

pub fn axcomp_header_zero() -> AxCompHeader {
    AxCompHeader {
        magic: AXCOMP_MAGIC,
        format_version: AXCOMP_FORMAT_VERSION,
        header_size: AXCOMP_HEADER_SIZE,
        component_id_offset: 0u32,
        component_id_len: 0u32,
        semver_major: 0u32,
        semver_minor: 0u32,
        semver_patch: 0u32,
        semver_prerelease_offset: 0u32,
        abi_fingerprint_lo: 0u64,
        abi_fingerprint_hi: 0u64,
        target_triple_lo: 0u64,
        target_triple_hi: 0u64,
        state_schema_id_lo: 0u64,
        state_schema_id_hi: 0u64,
        capability_count: 0u32,
        capability_table_offset: 0u32,
        exported_iface_count: 0u32,
        exported_iface_table_offset: 0u32,
    }
}

@derive(Copy)
pub struct AxCompExportedInterfaceEntry {
    pub iface_fingerprint_lo: u64,
    pub iface_fingerprint_hi: u64,
    pub name_offset: u32,
    pub name_len: u32,
    pub vtable_size: u32,
    pub method_count: u32,
}

@derive(Copy)
pub struct AxCompCapabilityEntry {
    pub cap_type: u32,
    pub flags: u32,
    pub resource_path_offset: u32,
    pub resource_path_len: u32,
}

// Low-level little-endian byte read/write primitives
pub fn write_u16_le(buf: *mut u8, offset: usize, val: u16) {
    unsafe {
        *(buf + offset) = (val & 0xFFu16) as u8
        *(buf + offset + 1usize) = ((val >> 8u16) & 0xFFu16) as u8
    }
}

pub fn write_u32_le(buf: *mut u8, offset: usize, val: u32) {
    unsafe {
        *(buf + offset) = (val & 0xFFu32) as u8
        *(buf + offset + 1usize) = ((val >> 8u32) & 0xFFu32) as u8
        *(buf + offset + 2usize) = ((val >> 16u32) & 0xFFu32) as u8
        *(buf + offset + 3usize) = ((val >> 24u32) & 0xFFu32) as u8
    }
}

pub fn write_u64_le(buf: *mut u8, offset: usize, val: u64) {
    let lo = (val & 0xFFFFFFFFu64) as u32
    let hi = ((val >> 32u64) & 0xFFFFFFFFu64) as u32
    write_u32_le(buf, offset, lo)
    write_u32_le(buf, offset + 4usize, hi)
}

pub fn read_u16_le(buf: *const u8, offset: usize) -> u16 {
    unsafe {
        let b0 = (*(buf + offset)) as u16
        let b1 = (*(buf + offset + 1usize)) as u16
        b0 | (b1 << 8u16)
    }
}

pub fn read_u32_le(buf: *const u8, offset: usize) -> u32 {
    unsafe {
        let b0 = (*(buf + offset)) as u32
        let b1 = (*(buf + offset + 1usize)) as u32
        let b2 = (*(buf + offset + 2usize)) as u32
        let b3 = (*(buf + offset + 3usize)) as u32
        b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32)
    }
}

pub fn read_u64_le(buf: *const u8, offset: usize) -> u64 {
    let lo = read_u32_le(buf, offset) as u64
    let hi = read_u32_le(buf, offset + 4usize) as u64
    lo | (hi << 32u64)
}

pub fn axcomp_serialize_header(hdr: view<AxCompHeader>, buf: *mut u8, buf_len: usize) -> bool {
    if buf_len < 128usize || (buf as usize) == 0usize {
        return false
    }
    let mut i: usize = 0usize
    while i < 128usize {
        unsafe { *(buf + i) = 0u8 }
        i = i + 1usize
    }

    write_u32_le(buf, 0usize, hdr.magic)
    write_u16_le(buf, 4usize, hdr.format_version)
    write_u16_le(buf, 6usize, hdr.header_size)
    write_u32_le(buf, 8usize, hdr.component_id_offset)
    write_u32_le(buf, 12usize, hdr.component_id_len)
    write_u32_le(buf, 16usize, hdr.semver_major)
    write_u32_le(buf, 20usize, hdr.semver_minor)
    write_u32_le(buf, 24usize, hdr.semver_patch)
    write_u32_le(buf, 28usize, hdr.semver_prerelease_offset)
    write_u64_le(buf, 32usize, hdr.abi_fingerprint_lo)
    write_u64_le(buf, 40usize, hdr.abi_fingerprint_hi)
    write_u64_le(buf, 48usize, hdr.target_triple_lo)
    write_u64_le(buf, 56usize, hdr.target_triple_hi)
    write_u64_le(buf, 64usize, hdr.state_schema_id_lo)
    write_u64_le(buf, 72usize, hdr.state_schema_id_hi)
    write_u32_le(buf, 80usize, hdr.capability_count)
    write_u32_le(buf, 84usize, hdr.capability_table_offset)
    write_u32_le(buf, 88usize, hdr.exported_iface_count)
    write_u32_le(buf, 92usize, hdr.exported_iface_table_offset)

    true
}

// Parses and validates .axcomp header
// Returns: 0 on success, or diagnostic code (231 = missing, 232 = corrupt)
pub fn axcomp_parse_header(buf: *const u8, buf_len: usize, out_hdr: mut_view<AxCompHeader>) -> u32 {
    if buf_len < 128usize || (buf as usize) == 0usize {
        return 231u32 // AX_COMP_MISSING_MANIFEST
    }
    let magic = read_u32_le(buf, 0usize)
    if magic != AXCOMP_MAGIC {
        return 232u32 // AX_COMP_CORRUPT_MANIFEST
    }
    let ver = read_u16_le(buf, 4usize)
    if ver != AXCOMP_FORMAT_VERSION {
        return 232u32 // AX_COMP_CORRUPT_MANIFEST
    }
    let hdr_sz = read_u16_le(buf, 6usize)
    if hdr_sz < AXCOMP_HEADER_SIZE {
        return 232u32 // AX_COMP_CORRUPT_MANIFEST
    }

    out_hdr.magic = magic
    out_hdr.format_version = ver
    out_hdr.header_size = hdr_sz
    out_hdr.component_id_offset = read_u32_le(buf, 8usize)
    out_hdr.component_id_len = read_u32_le(buf, 12usize)
    out_hdr.semver_major = read_u32_le(buf, 16usize)
    out_hdr.semver_minor = read_u32_le(buf, 20usize)
    out_hdr.semver_patch = read_u32_le(buf, 24usize)
    out_hdr.semver_prerelease_offset = read_u32_le(buf, 28usize)
    out_hdr.abi_fingerprint_lo = read_u64_le(buf, 32usize)
    out_hdr.abi_fingerprint_hi = read_u64_le(buf, 40usize)
    out_hdr.target_triple_lo = read_u64_le(buf, 48usize)
    out_hdr.target_triple_hi = read_u64_le(buf, 56usize)
    out_hdr.state_schema_id_lo = read_u64_le(buf, 64usize)
    out_hdr.state_schema_id_hi = read_u64_le(buf, 72usize)
    out_hdr.capability_count = read_u32_le(buf, 80usize)
    out_hdr.capability_table_offset = read_u32_le(buf, 84usize)
    out_hdr.exported_iface_count = read_u32_le(buf, 88usize)
    out_hdr.exported_iface_table_offset = read_u32_le(buf, 92usize)

    0u32
}

// Validates full .axcomp binary section layout, offsets, and ComponentId syntax
pub fn axcomp_validate_section(buf: *const u8, buf_len: usize, out_hdr: mut_view<AxCompHeader>) -> u32 {
    let rc = axcomp_parse_header(buf, buf_len, mut_view(*out_hdr))
    if rc != 0u32 {
        return rc
    }

    // Validate ComponentId offset and length
    let cid_end = (out_hdr.component_id_offset as usize) + (out_hdr.component_id_len as usize)
    if cid_end > buf_len || 128u32 > out_hdr.component_id_offset {
        return 232u32 // AX_COMP_CORRUPT_MANIFEST
    }
    let cid_sv = StrView {
        ptr: unsafe { buf + (out_hdr.component_id_offset as usize) },
        len: out_hdr.component_id_len as usize,
    }
    if !validate_component_id_format(cid_sv) {
        return 232u32 // AX_COMP_CORRUPT_MANIFEST
    }

    // Validate capability table bounds if non-empty
    if out_hdr.capability_count > 0u32 {
        let cap_bytes = (out_hdr.capability_count as usize) * 16usize
        let cap_end = (out_hdr.capability_table_offset as usize) + cap_bytes
        if cap_end > buf_len || 128u32 > out_hdr.capability_table_offset {
            return 232u32 // AX_COMP_CORRUPT_MANIFEST
        }
    }

    // Validate exported interface table bounds if non-empty
    if out_hdr.exported_iface_count > 0u32 {
        let iface_bytes = (out_hdr.exported_iface_count as usize) * 32usize
        let iface_end = (out_hdr.exported_iface_table_offset as usize) + iface_bytes
        if iface_end > buf_len || 128u32 > out_hdr.exported_iface_table_offset {
            return 232u32 // AX_COMP_CORRUPT_MANIFEST
        }
    }

    0u32
}
