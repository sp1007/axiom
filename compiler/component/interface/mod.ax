// Axiom Compiler — Component Interface VTable Lowering & .axcomp Emitter (compiler/component/interface/mod.ax)
// Implements SPEC-115 §§1..2 (AXS-COMP-001..006, AXS-COMP-010..015; REQ-ECO-8734, INV-COMP-001).

module compiler.component.interface

use compiler.kernel.hash.ax_hash_bytes
use compiler.kernel.hash.ax_hash_u64
use compiler.kernel.hash.ax_hash_combine
use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_sv
use compiler.diag.format.diag_buf_push_u32
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_empty
use compiler.diag.ux2.ux2_sv_eq

use compiler.abi.fingerprint.AbiFingerprint
use compiler.abi.fingerprint.abi_fingerprint_zero
use compiler.abi.fingerprint.abi_fingerprint_eq
use compiler.abi.fingerprint.push_fingerprint_hex

// =============================================================================
// 1. 128-Bit Cryptographic Digests for Dynamic Components (AXS-COMP-003, AXS-COMP-005)
// =============================================================================

@derive(Copy)
pub struct InterfaceFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn interface_fingerprint_zero() -> InterfaceFingerprint {
    InterfaceFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn interface_fingerprint_eq(a: InterfaceFingerprint, b: InterfaceFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@derive(Copy)
pub struct TargetTripleFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn target_triple_fingerprint_zero() -> TargetTripleFingerprint {
    TargetTripleFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn target_triple_fingerprint_eq(a: TargetTripleFingerprint, b: TargetTripleFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@derive(Copy)
pub struct StateSchemaId {
    pub lo: u64,
    pub hi: u64,
}

pub fn state_schema_id_zero() -> StateSchemaId {
    StateSchemaId { lo: 0u64, hi: 0u64 }
}

pub fn state_schema_id_eq(a: StateSchemaId, b: StateSchemaId) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

// Helper to hash StrView into an accumulator
fn hash_str_view(acc: u64, sv: StrView) -> u64 {
    if sv.len == 0usize || (sv.ptr as usize) == 0usize {
        return ax_hash_combine(acc, 0u64)
    }
    let h = ax_hash_bytes(sv.ptr, sv.len)
    ax_hash_combine(acc, h)
}

pub fn compute_target_triple_fingerprint(
    arch: StrView,
    os: StrView,
    vendor: StrView,
    env: StrView
) -> TargetTripleFingerprint {
    let tag = ux2_sv("AXIOM-TRIPLE-v1\0")
    let base = ax_hash_bytes(tag.ptr, tag.len)
    let mut lo = ax_hash_combine(base, 0x4158545249504Cu64)
    let mut hi = ax_hash_combine(base, 0x9e3779b97f4a7c15u64)
    lo = hash_str_view(lo, arch)
    hi = hash_str_view(hi, os)
    lo = hash_str_view(lo, vendor)
    hi = hash_str_view(hi, env)
    TargetTripleFingerprint { lo: lo, hi: hi }
}

// =============================================================================
// 2. Component Identity & Semantic Versioning (AXS-COMP-002, AXS-COMP-011)
// =============================================================================

@derive(Copy)
pub struct ComponentSemVer {
    pub major: u32,
    pub minor: u32,
    pub patch: u32,
    pub prerelease: StrView,
}

pub fn component_semver_new(maj: u32, min: u32, pat: u32, pre: StrView) -> ComponentSemVer {
    ComponentSemVer {
        major: maj,
        minor: min,
        patch: pat,
        prerelease: pre,
    }
}

pub fn component_semver_eq(a: ComponentSemVer, b: ComponentSemVer) -> bool {
    a.major == b.major && a.minor == b.minor && a.patch == b.patch && ux2_sv_eq(a.prerelease, b.prerelease)
}

// Evaluates SemVer 2.0 Caret (^) requirement matching (AXS-COMP-011 §2):
// ^2.1.0 matches >=2.1.0, <3.0.0
// ^0.2.1 matches >=0.2.1, <0.3.0
// ^0.0.3 matches ==0.0.3
pub fn component_semver_matches_caret(req: ComponentSemVer, cand: ComponentSemVer) -> bool {
    if req.prerelease.len == 0usize && cand.prerelease.len > 0usize {
        return false
    }
    if req.prerelease.len > 0usize {
        if !ux2_sv_eq(req.prerelease, cand.prerelease) {
            return false
        }
    }
    if req.major > 0u32 {
        if cand.major != req.major {
            return false
        }
        if req.minor > cand.minor {
            return false
        }
        if cand.minor == req.minor && (req.patch > cand.patch) {
            return false
        }
        return true
    }
    if req.minor > 0u32 {
        if cand.major != 0u32 || cand.minor != req.minor {
            return false
        }
        return cand.patch >= req.patch
    }
    cand.major == 0u32 && cand.minor == 0u32 && cand.patch == req.patch
}

// Validates ComponentId format: "<vendor>.<namespace>.<name>" (AXS-COMP-002 §1)
// Must contain at least two dots, non-empty segments, allowed: [a-zA-Z0-9_-]
pub fn validate_component_id_format(id: StrView) -> bool {
    if 5usize > id.len || (id.ptr as usize) == 0usize {
        return false
    }
    let mut dot_count: u32 = 0u32
    let mut seg_len: u32 = 0u32
    let mut i: usize = 0usize
    while i < id.len {
        let b: u8 = unsafe { *(id.ptr + i) }
        if b == 46u8 { // '.'
            if seg_len == 0u32 {
                return false
            }
            dot_count = dot_count + 1u32
            seg_len = 0u32
        } else {
            let is_alpha = (b >= 97u8 && b <= 122u8) || (b >= 65u8 && b <= 90u8)
            let is_digit = (b >= 48u8 && b <= 57u8)
            let is_special = (b == 95u8 || b == 45u8)
            if !is_alpha && !is_digit && !is_special {
                return false
            }
            seg_len = seg_len + 1u32
        }
        i = i + 1usize
    }
    if seg_len == 0u32 {
        return false
    }
    dot_count >= 2u32
}

// =============================================================================
// 3. @component_interface Model & VTable Lowering (AXS-COMP-003)
// =============================================================================

pub const PARAM_PASS_BY_VAL: u8 = 0u8
pub const PARAM_PASS_VIEW: u8 = 1u8
pub const PARAM_PASS_MUT_VIEW: u8 = 2u8
pub const PARAM_PASS_COMPONENT_BOX: u8 = 3u8
pub const PARAM_PASS_COMPONENT_HANDLE: u8 = 4u8
pub const PARAM_PASS_OPAQUE_PTR: u8 = 5u8
pub const PARAM_PASS_RAW_PTR: u8 = 6u8
pub const PARAM_PASS_PLAIN_HOST_BOX: u8 = 7u8
pub const PARAM_PASS_PLAIN_HOST_COLLECTION: u8 = 8u8

@derive(Copy)
pub struct ComponentParamDesc {
    pub name: StrView,
    pub type_name: StrView,
    pub pass_mode: u8,
    pub type_id: u8,
}

pub fn component_param_desc_default(name: StrView, type_name: StrView, pass_mode: u8) -> ComponentParamDesc {
    ComponentParamDesc {
        name: name,
        type_name: type_name,
        pass_mode: pass_mode,
        type_id: 0u8,
    }
}

@derive(Copy)
pub struct ComponentMethodDesc {
    pub name: StrView,
    pub slot_index: u32,
    pub param_count: u32,
    pub param_types_hash: u64,
    pub ret_type_name: StrView,
    pub ret_type_id: u8,
    pub ret_pass_mode: u8,
    pub has_lease_contract: bool,
    pub is_unsafe: bool,
}

pub fn component_method_desc_default(name: StrView, slot_index: u32) -> ComponentMethodDesc {
    ComponentMethodDesc {
        name: name,
        slot_index: slot_index,
        param_count: 0u32,
        param_types_hash: 0u64,
        ret_type_name: ux2_sv("()"),
        ret_type_id: 0u8,
        ret_pass_mode: PARAM_PASS_BY_VAL,
        has_lease_contract: false,
        is_unsafe: false,
    }
}

@derive(Copy)
pub struct ComponentInterfaceDesc {
    pub name: StrView,
    pub version: ComponentSemVer,
    pub fingerprint: InterfaceFingerprint,
    pub method_count: u32,
    pub vtable_size: u32,
    pub vtable_abi_version: u32,
}

pub fn calculate_vtable_size(method_count: u32) -> u32 {
    // Stable Axiom ABI vtable layout:
    // abi_version (u32: 4) + vtable_size (u32: 4) + fingerprint (16 bytes) + reserved (8 bytes) = 32 bytes
    // plus method pointers: method_count * 8 bytes (ctx: *mut () + params)
    32u32 + (method_count * 8u32)
}

pub fn compute_interface_fingerprint(
    name: StrView,
    version: ComponentSemVer,
    methods: view<[8]ComponentMethodDesc>,
    count: usize
) -> InterfaceFingerprint {
    let tag = ux2_sv("AXIOM-COMP-IFACE-v1\0")
    let base = ax_hash_bytes(tag.ptr, tag.len)
    let mut lo = ax_hash_combine(base, 0x49464143454650u64)
    let mut hi = ax_hash_combine(base, 0x9e3779b97f4a7c15u64)

    lo = hash_str_view(lo, name)
    lo = ax_hash_combine(lo, version.major as u64)
    hi = ax_hash_combine(hi, version.minor as u64)
    lo = ax_hash_combine(lo, version.patch as u64)
    hi = hash_str_view(hi, version.prerelease)
    lo = ax_hash_combine(lo, count as u64)

    let mut i: usize = 0usize
    while i < count && i < 8usize {
        let m = (*methods)[i]
        lo = ax_hash_combine(lo, m.slot_index as u64)
        lo = hash_str_view(lo, m.name)
        hi = ax_hash_combine(hi, m.param_count as u64)
        hi = ax_hash_combine(hi, m.param_types_hash)
        lo = hash_str_view(lo, m.ret_type_name)
        hi = ax_hash_combine(hi, m.ret_pass_mode as u64)
        lo = ax_hash_combine(lo, if m.has_lease_contract { 1u64 } else { 0u64 })
        hi = ax_hash_combine(hi, if m.is_unsafe { 1u64 } else { 0u64 })
        i = i + 1usize
    }

    InterfaceFingerprint { lo: lo, hi: hi }
}

