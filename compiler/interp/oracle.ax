@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// Concatenated host intrinsic names:
//   0..10:   "heap_alloc"
//   10..22:  "heap_realloc"
//   22..31:  "heap_free"
//   31..36:  "stdio"
//   36..40:  "open"
//   40..44:  "read"
//   44..49:  "write"
//   49..54:  "close"
//   54..63:  "file_size"
//   63..73:  "args_count"
//   73..76:  "arg"
//   76..83:  "env_get"
//   83..91:  "exe_path"
//   91..95:  "exit"
//   95..101: "remove"
//   101..106:"mkdir"
//   106..114:"metadata"
//   114..122:"dir_open"
//   122..130:"dir_next"
//   130..139:"dir_close"
//   139..151:"monotonic_ns"
const HOST_NAMES_BYTES: [151]u8 = [
    // "heap_alloc" (0, 10)
    104u8, 101u8, 97u8, 112u8, 95u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    // "heap_realloc" (10, 12)
    104u8, 101u8, 97u8, 112u8, 95u8, 114u8, 101u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    // "heap_free" (22, 9)
    104u8, 101u8, 97u8, 112u8, 95u8, 102u8, 114u8, 101u8, 101u8,
    // "stdio" (31, 5)
    115u8, 116u8, 100u8, 105u8, 111u8,
    // "open" (36, 4)
    111u8, 112u8, 101u8, 110u8,
    // "read" (40, 4)
    114u8, 101u8, 97u8, 100u8,
    // "write" (44, 5)
    119u8, 114u8, 105u8, 116u8, 101u8,
    // "close" (49, 5)
    99u8, 108u8, 111u8, 115u8, 101u8,
    // "file_size" (54, 9)
    102u8, 105u8, 108u8, 101u8, 95u8, 115u8, 105u8, 122u8, 101u8,
    // "args_count" (63, 10)
    97u8, 114u8, 103u8, 115u8, 95u8, 99u8, 111u8, 117u8, 110u8, 116u8,
    // "arg" (73, 3)
    97u8, 114u8, 103u8,
    // "env_get" (76, 7)
    101u8, 110u8, 118u8, 95u8, 103u8, 101u8, 116u8,
    // "exe_path" (83, 8)
    101u8, 120u8, 101u8, 95u8, 112u8, 97u8, 116u8, 104u8,
    // "exit" (91, 4)
    101u8, 120u8, 105u8, 116u8,
    // "remove" (95, 6)
    114u8, 101u8, 109u8, 111u8, 118u8, 101u8,
    // "mkdir" (101, 5)
    109u8, 107u8, 100u8, 105u8, 114u8,
    // "metadata" (106, 8)
    109u8, 101u8, 116u8, 97u8, 100u8, 97u8, 116u8, 97u8,
    // "dir_open" (114, 8)
    100u8, 105u8, 114u8, 95u8, 111u8, 112u8, 101u8, 110u8,
    // "dir_next" (122, 8)
    100u8, 105u8, 114u8, 95u8, 110u8, 101u8, 120u8, 116u8,
    // "dir_close" (130, 9)
    100u8, 105u8, 114u8, 95u8, 99u8, 108u8, 111u8, 115u8, 101u8,
    // "monotonic_ns" (139, 12)
    109u8, 111u8, 110u8, 111u8, 116u8, 111u8, 110u8, 105u8, 99u8, 95u8, 110u8, 115u8,
];

fn host_name_eq(name: view<StrView>, off: usize, n: usize) -> bool {
    if name.len != n || (name.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let ch = unsafe { *(name.ptr + i) };
        if ch != HOST_NAMES_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

pub const HOST_INTR_NONE: u8 = 0u8;
pub const HOST_INTR_THREAD_SPAWN: u8 = 1u8;
pub const HOST_INTR_THREAD_JOIN: u8 = 2u8;
pub const HOST_INTR_THREAD_DETACH: u8 = 3u8;
pub const HOST_INTR_THREAD_CURRENT_ID: u8 = 4u8;
pub const HOST_INTR_THREAD_YIELD: u8 = 5u8;
pub const HOST_INTR_THREAD_SLEEP_NS: u8 = 6u8;
pub const HOST_INTR_FUTEX_WAIT: u8 = 7u8;
pub const HOST_INTR_FUTEX_WAKE: u8 = 8u8;

const HOST_THREAD_NAMES_BYTES: [100]u8 = [
    // "thread_spawn" (0, 12)
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 95u8, 115u8, 112u8, 97u8, 119u8, 110u8,
    // "thread_join" (12, 11)
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 95u8, 106u8, 111u8, 105u8, 110u8,
    // "thread_detach" (23, 13)
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 95u8, 100u8, 101u8, 116u8, 97u8, 99u8, 104u8,
    // "thread_current_id" (36, 17)
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 95u8, 99u8, 117u8, 114u8, 114u8, 101u8, 110u8, 116u8, 95u8, 105u8, 100u8,
    // "thread_yield" (53, 12)
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 95u8, 121u8, 105u8, 101u8, 108u8, 100u8,
    // "thread_sleep_ns" (65, 15)
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 95u8, 115u8, 108u8, 101u8, 101u8, 112u8, 95u8, 110u8, 115u8,
    // "futex_wait" (80, 10)
    102u8, 117u8, 116u8, 101u8, 120u8, 95u8, 119u8, 97u8, 105u8, 116u8,
    // "futex_wake" (90, 10)
    102u8, 117u8, 116u8, 101u8, 120u8, 95u8, 119u8, 97u8, 107u8, 101u8,
];

fn host_thread_name_eq(name: view<StrView>, off: usize, n: usize) -> bool {
    if name.len != n || (name.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let ch = unsafe { *(name.ptr + i) };
        if ch != HOST_THREAD_NAMES_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn interp_host_thread_intrinsic_kind(name: view<StrView>) -> u8 {
    if host_thread_name_eq(name, 0, 12) { return HOST_INTR_THREAD_SPAWN; }
    if host_thread_name_eq(name, 12, 11) { return HOST_INTR_THREAD_JOIN; }
    if host_thread_name_eq(name, 23, 13) { return HOST_INTR_THREAD_DETACH; }
    if host_thread_name_eq(name, 36, 17) { return HOST_INTR_THREAD_CURRENT_ID; }
    if host_thread_name_eq(name, 53, 12) { return HOST_INTR_THREAD_YIELD; }
    if host_thread_name_eq(name, 65, 15) { return HOST_INTR_THREAD_SLEEP_NS; }
    if host_thread_name_eq(name, 80, 10) { return HOST_INTR_FUTEX_WAIT; }
    if host_thread_name_eq(name, 90, 10) { return HOST_INTR_FUTEX_WAKE; }
    HOST_INTR_NONE
}

pub fn interp_is_host_intrinsic_name(name: view<StrView>) -> bool {
    if host_name_eq(name, 0, 10) { return true; }
    if host_name_eq(name, 10, 12) { return true; }
    if host_name_eq(name, 22, 9) { return true; }
    if host_name_eq(name, 31, 5) { return true; }
    if host_name_eq(name, 36, 4) { return true; }
    if host_name_eq(name, 40, 4) { return true; }
    if host_name_eq(name, 44, 5) { return true; }
    if host_name_eq(name, 49, 5) { return true; }
    if host_name_eq(name, 54, 9) { return true; }
    if host_name_eq(name, 63, 10) { return true; }
    if host_name_eq(name, 73, 3) { return true; }
    if host_name_eq(name, 76, 7) { return true; }
    if host_name_eq(name, 83, 8) { return true; }
    if host_name_eq(name, 91, 4) { return true; }
    if host_name_eq(name, 95, 6) { return true; }
    if host_name_eq(name, 101, 5) { return true; }
    if host_name_eq(name, 106, 8) { return true; }
    if host_name_eq(name, 114, 8) { return true; }
    if host_name_eq(name, 122, 8) { return true; }
    if host_name_eq(name, 130, 9) { return true; }
    if host_name_eq(name, 139, 12) { return true; }
    if interp_host_thread_intrinsic_kind(name) != HOST_INTR_NONE { return true; }
    false
}

// =================================================================================================
// Host State Lifecycle & Handle Tracking
// =================================================================================================

pub fn interp_host_init(ctx: mut_view<InterpCtx>) {
    ctx.host.args = 0 as *mut InterpHostArg;
    ctx.host.argc = 0;
    ctx.host.args_cap = 0;
    ctx.host.use_custom_args = false;
    ctx.host.open_fds = 0 as *mut i64;
    ctx.host.open_fds_len = 0;
    ctx.host.open_fds_cap = 0;
    ctx.host.open_dirs = 0 as *mut i64;
    ctx.host.open_dirs_len = 0;
    ctx.host.open_dirs_cap = 0;
    ctx.host.last_monotonic_ns = 0u64;
}

pub fn interp_host_set_custom_args(ctx: mut_view<InterpCtx>, enable: bool) {
    ctx.host.use_custom_args = enable;
}

pub fn interp_host_push_arg(ctx: mut_view<InterpCtx>, arg_sv: StrView) {
    ctx.host.use_custom_args = true;
    if ctx.host.argc >= ctx.host.args_cap {
        let new_cap: usize = if ctx.host.args_cap == 0 { 16 } else { interp_mul_usize(ctx.host.args_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<InterpHostArg>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<InterpHostArg>()) as *mut InterpHostArg };
        unsafe {
            interp_zero_bytes(new_arr as *mut u8, new_bytes);
        }
        if ctx.host.argc > 0 && (ctx.host.args as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.host.argc, size_of<InterpHostArg>());
            let old_cap_bytes = interp_mul_usize(ctx.host.args_cap, size_of<InterpHostArg>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, ctx.host.args as *const u8, old_bytes);
                heap_free(ctx.host.args as *mut u8, old_cap_bytes, align_of<InterpHostArg>());
            }
        }
        ctx.host.args = new_arr;
        ctx.host.args_cap = new_cap;
    }

    let arg_len = arg_sv.len;
    let alloc_len: usize = if arg_len < 16 { 16 } else { arg_len + 1 };
    let copy_buf = unsafe { heap_alloc(alloc_len, 1) };
    unsafe {
        interp_zero_bytes(copy_buf, alloc_len);
    }
    if arg_len > 0 && (arg_sv.ptr as usize) != 0 {
        unsafe {
            interp_copy_bytes(copy_buf, arg_sv.ptr, arg_len);
        }
    }
    let slot = unsafe { interp_host_arg_at(ctx.host.args, ctx.host.argc) };
    unsafe {
        (*slot).ptr = copy_buf;
        (*slot).len = arg_len;
    }
    ctx.host.argc = ctx.host.argc + 1;
}

fn host_record_open_fd(ctx: mut_view<InterpCtx>, fd: i64) {
    if ctx.host.open_fds_len >= ctx.host.open_fds_cap {
        let new_cap: usize = if ctx.host.open_fds_cap == 0 { 16 } else { interp_mul_usize(ctx.host.open_fds_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<i64>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<i64>()) as *mut i64 };
        if ctx.host.open_fds_len > 0 && (ctx.host.open_fds as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.host.open_fds_len, size_of<i64>());
            let old_cap_bytes = interp_mul_usize(ctx.host.open_fds_cap, size_of<i64>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, ctx.host.open_fds as *const u8, old_bytes);
                heap_free(ctx.host.open_fds as *mut u8, old_cap_bytes, align_of<i64>());
            }
        }
        ctx.host.open_fds = new_arr;
        ctx.host.open_fds_cap = new_cap;
    }
    unsafe {
        *interp_i64_at(ctx.host.open_fds, ctx.host.open_fds_len) = fd;
    }
    ctx.host.open_fds_len = ctx.host.open_fds_len + 1;
}

fn host_has_open_fd(ctx: view<InterpCtx>, fd: i64) -> bool {
    let mut i: usize = 0;
    while i < ctx.host.open_fds_len {
        let cur = unsafe { *interp_i64_at(ctx.host.open_fds, i) };
        if cur == fd {
            return true;
        }
        i = i + 1;
    }
    false
}

fn host_remove_open_fd(ctx: mut_view<InterpCtx>, fd: i64) -> bool {
    let mut i: usize = 0;
    while i < ctx.host.open_fds_len {
        let cur = unsafe { *interp_i64_at(ctx.host.open_fds, i) };
        if cur == fd {
            let last_idx = ctx.host.open_fds_len - 1;
            if i != last_idx {
                let last_val = unsafe { *interp_i64_at(ctx.host.open_fds, last_idx) };
                unsafe {
                    *interp_i64_at(ctx.host.open_fds, i) = last_val;
                }
            }
            ctx.host.open_fds_len = last_idx;
            return true;
        }
        i = i + 1;
    }
    false
}

fn host_record_open_dir(ctx: mut_view<InterpCtx>, dhid: i64) {
    if ctx.host.open_dirs_len >= ctx.host.open_dirs_cap {
        let new_cap: usize = if ctx.host.open_dirs_cap == 0 { 16 } else { interp_mul_usize(ctx.host.open_dirs_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<i64>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<i64>()) as *mut i64 };
        if ctx.host.open_dirs_len > 0 && (ctx.host.open_dirs as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.host.open_dirs_len, size_of<i64>());
            let old_cap_bytes = interp_mul_usize(ctx.host.open_dirs_cap, size_of<i64>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, ctx.host.open_dirs as *const u8, old_bytes);
                heap_free(ctx.host.open_dirs as *mut u8, old_cap_bytes, align_of<i64>());
            }
        }
        ctx.host.open_dirs = new_arr;
        ctx.host.open_dirs_cap = new_cap;
    }
    unsafe {
        *interp_i64_at(ctx.host.open_dirs, ctx.host.open_dirs_len) = dhid;
    }
    ctx.host.open_dirs_len = ctx.host.open_dirs_len + 1;
}

fn host_has_open_dir(ctx: view<InterpCtx>, dhid: i64) -> bool {
    let mut i: usize = 0;
    while i < ctx.host.open_dirs_len {
        let cur = unsafe { *interp_i64_at(ctx.host.open_dirs, i) };
        if cur == dhid {
            return true;
        }
        i = i + 1;
    }
    false
}

fn host_remove_open_dir(ctx: mut_view<InterpCtx>, dhid: i64) -> bool {
    let mut i: usize = 0;
    while i < ctx.host.open_dirs_len {
        let cur = unsafe { *interp_i64_at(ctx.host.open_dirs, i) };
        if cur == dhid {
            let last_idx = ctx.host.open_dirs_len - 1;
            if i != last_idx {
                let last_val = unsafe { *interp_i64_at(ctx.host.open_dirs, last_idx) };
                unsafe {
                    *interp_i64_at(ctx.host.open_dirs, i) = last_val;
                }
            }
            ctx.host.open_dirs_len = last_idx;
            return true;
        }
        i = i + 1;
    }
    false
}

pub fn interp_host_cleanup(ctx: mut_view<InterpCtx>) {
    let mut i: usize = 0;
    while i < ctx.host.open_fds_len {
        let fd = unsafe { *interp_i64_at(ctx.host.open_fds, i) };
        let _ = close(fd);
        i = i + 1;
    }
    if ctx.host.open_fds_cap > 0 && (ctx.host.open_fds as usize) != 0 {
        let cap_bytes = interp_mul_usize(ctx.host.open_fds_cap, size_of<i64>());
        unsafe {
            heap_free(ctx.host.open_fds as *mut u8, cap_bytes, align_of<i64>());
        }
    }
    ctx.host.open_fds = 0 as *mut i64;
    ctx.host.open_fds_len = 0;
    ctx.host.open_fds_cap = 0;

    i = 0;
    while i < ctx.host.open_dirs_len {
        let dhid = unsafe { *interp_i64_at(ctx.host.open_dirs, i) };
        let _ = dir_close(dhid);
        i = i + 1;
    }
    if ctx.host.open_dirs_cap > 0 && (ctx.host.open_dirs as usize) != 0 {
        let cap_bytes = interp_mul_usize(ctx.host.open_dirs_cap, size_of<i64>());
        unsafe {
            heap_free(ctx.host.open_dirs as *mut u8, cap_bytes, align_of<i64>());
        }
    }
    ctx.host.open_dirs = 0 as *mut i64;
    ctx.host.open_dirs_len = 0;
    ctx.host.open_dirs_cap = 0;

    i = 0;
    while i < ctx.host.argc {
        let slot = unsafe { interp_host_arg_at(ctx.host.args, i) };
        let p = unsafe { (*slot).ptr };
        let l = unsafe { (*slot).len };
        if (p as usize) != 0 {
            let alloc_len: usize = if l < 16 { 16 } else { l + 1 };
            unsafe {
                heap_free(p, alloc_len, 1);
                (*slot).ptr = 0 as *mut u8;
            }
        }
        i = i + 1;
    }
    if ctx.host.args_cap > 0 && (ctx.host.args as usize) != 0 {
        let cap_bytes = interp_mul_usize(ctx.host.args_cap, size_of<InterpHostArg>());
        unsafe {
            heap_free(ctx.host.args as *mut u8, cap_bytes, align_of<InterpHostArg>());
        }
    }
    ctx.host.args = 0 as *mut InterpHostArg;
    ctx.host.argc = 0;
    ctx.host.args_cap = 0;
    ctx.host.use_custom_args = false;
}

// =================================================================================================
// Host Intrinsic Dispatch
// =================================================================================================

fn eval_host_heap_alloc(ctx: mut_view<InterpCtx>, size: u64, align: u64, out_ret: mut_view<InterpValue>) {
    if size == 0u64 {
        out_ret.vals[0] = 0u64;
        return;
    }
    if align == 0u64 || (align & (align - 1u64)) != 0u64 || align > 4096u64 {
        out_ret.vals[0] = 0u64;
        return;
    }
    let alloc_bytes: usize = if size < 16u64 { 16 } else { size as usize };
    let mem = unsafe { heap_alloc(alloc_bytes, 16) };
    if (mem as usize) == 0 {
        out_ret.vals[0] = 0u64;
        return;
    }
    unsafe {
        interp_zero_bytes(mem, alloc_bytes);
    }
    let a = interp_register_alloc(mut_view(*ctx), mem, size, align as u32, -1);
    out_ret.vals[0] = unsafe { (*a).base_addr };
}

fn eval_host_heap_realloc(
    ctx: mut_view<InterpCtx>,
    p: u64,
    old_size: u64,
    new_size: u64,
    align: u64,
    out_ret: mut_view<InterpValue>
) {
    if p == 0u64 {
        eval_host_heap_alloc(mut_view(*ctx), new_size, align, mut_view(*out_ret));
        return;
    }
    if new_size == 0u64 {
        out_ret.vals[0] = 0u64;
        return;
    }
    if align == 0u64 || (align & (align - 1u64)) != 0u64 || align > 4096u64 {
        out_ret.vals[0] = 0u64;
        return;
    }

    let mut found: *mut InterpAlloc = 0 as *mut InterpAlloc;
    let mut i: usize = 0;
    while i < ctx.alloc_count {
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        if (unsafe { (*a).base_addr }) == p {
            found = a;
            break;
        }
        i = i + 1;
    }
    if (found as usize) == 0 || !(unsafe { (*found).is_live }) || (unsafe { (*found).call_depth }) != -1 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DANGLING);
        out_ret.vals[0] = 0u64;
        return;
    }

    let alloc_bytes: usize = if new_size < 16u64 { 16 } else { new_size as usize };
    let new_mem = unsafe { heap_alloc(alloc_bytes, 16) };
    if (new_mem as usize) == 0 {
        out_ret.vals[0] = 0u64;
        return;
    }
    unsafe {
        interp_zero_bytes(new_mem, alloc_bytes);
    }

    let mut copy_sz: u64 = if old_size < new_size { old_size } else { new_size };
    let found_sz = unsafe { (*found).size };
    if found_sz < copy_sz {
        copy_sz = found_sz;
    }
    let found_ptr = unsafe { (*found).host_ptr };
    if copy_sz > 0u64 && (found_ptr as usize) != 0 {
        unsafe {
            interp_copy_bytes(new_mem, found_ptr as *const u8, copy_sz as usize);
        }
    }
    if (found_ptr as usize) != 0 {
        oracle_invalidate_range(mut_view(*ctx), found_ptr, found_sz as usize);
        let old_alloc_bytes: usize = if found_sz < 16u64 { 16 } else { found_sz as usize };
        unsafe {
            heap_free(found_ptr, old_alloc_bytes, 16);
        }
    }
    unsafe {
        (*found).is_live = false;
        (*found).host_ptr = 0 as *mut u8;
    }

    let na = interp_register_alloc(mut_view(*ctx), new_mem, new_size, align as u32, -1);
    out_ret.vals[0] = unsafe { (*na).base_addr };
}

fn eval_host_heap_free(ctx: mut_view<InterpCtx>, p: u64, out_ret: mut_view<InterpValue>) {
    if p == 0u64 {
        out_ret.vals[0] = 0u64;
        return;
    }
    let mut found: *mut InterpAlloc = 0 as *mut InterpAlloc;
    let mut i: usize = 0;
    while i < ctx.alloc_count {
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        if (unsafe { (*a).base_addr }) == p {
            found = a;
            break;
        }
        i = i + 1;
    }
    if (found as usize) == 0 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_UNMAPPED);
        return;
    }
    if !(unsafe { (*found).is_live }) {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DANGLING);
        return;
    }
    if (unsafe { (*found).call_depth }) != -1 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_FREE_NON_HEAP);
        return;
    }
    let found_ptr = unsafe { (*found).host_ptr };
    let found_sz = unsafe { (*found).size };
    if (found_ptr as usize) != 0 {
        oracle_invalidate_range(mut_view(*ctx), found_ptr, found_sz as usize);
        let old_alloc_bytes: usize = if found_sz < 16u64 { 16 } else { found_sz as usize };
        unsafe {
            heap_free(found_ptr, old_alloc_bytes, 16);
        }
    }
    unsafe {
        (*found).is_live = false;
        (*found).host_ptr = 0 as *mut u8;
    }
    out_ret.vals[0] = 0u64;
}

pub fn interp_eval_host_intrinsic(
    ctx: mut_view<InterpCtx>,
    name: StrView,
    args: *const u64,
    arg_count: usize,
    out_ret: mut_view<InterpValue>
) -> bool {
    let a0: u64 = if arg_count > 0 && (args as usize) != 0 { unsafe { *(args + 0) } } else { 0u64 };
    let a1: u64 = if arg_count > 1 && (args as usize) != 0 { unsafe { *(args + 1) } } else { 0u64 };
    let a2: u64 = if arg_count > 2 && (args as usize) != 0 { unsafe { *(args + 2) } } else { 0u64 };
    let a3: u64 = if arg_count > 3 && (args as usize) != 0 { unsafe { *(args + 3) } } else { 0u64 };

    // 1. heap_alloc
    if host_name_eq(view(name), 0, 10) {
        eval_host_heap_alloc(mut_view(*ctx), a0, a1, mut_view(*out_ret));
        return true;
    }

    // 2. heap_realloc
    if host_name_eq(view(name), 10, 12) {
        eval_host_heap_realloc(mut_view(*ctx), a0, a1, a2, a3, mut_view(*out_ret));
        return true;
    }

    // 3. heap_free
    if host_name_eq(view(name), 22, 9) {
        eval_host_heap_free(mut_view(*ctx), a0, mut_view(*out_ret));
        return true;
    }

    // 4. stdio
    if host_name_eq(view(name), 31, 5) {
        if a0 <= 2u64 {
            out_ret.vals[0] = a0;
        } else {
            out_ret.vals[0] = (-4i64) as u64;
        }
        return true;
    }

    // 5. open
    if host_name_eq(view(name), 36, 4) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let mode = a2 as u32;
        if mode > 2u32 {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { open(path_host as *const u8, a1 as usize, mode) };
        if res >= 3i64 {
            host_record_open_fd(mut_view(*ctx), res);
        }
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 6. read
    if host_name_eq(view(name), 40, 4) {
        let h = a0 as i64;
        let buf_addr = a1;
        let cap = a2;
        if cap == 0u64 {
            out_ret.vals[0] = 0u64;
            return true;
        }
        let buf_host = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, cap, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        if h != 0i64 && !(h >= 3i64 && host_has_open_fd(view(*ctx), h)) {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { read(h, buf_host, cap as usize) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 7. write
    if host_name_eq(view(name), 44, 5) {
        let h = a0 as i64;
        let p_addr = a1;
        let byte_len = a2;
        if byte_len == 0u64 {
            out_ret.vals[0] = 0u64;
            return true;
        }
        let p_host = interp_validate_raw_ptr(mut_view(*ctx), p_addr, byte_len, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        if h == 1i64 && (ctx.out_buf as usize) != 0 && ctx.capture_stdout {
            unsafe {
                diag_buf_push_bytes(mut_view(*ctx.out_buf), p_host as *const u8, byte_len as usize);
            }
            out_ret.vals[0] = byte_len;
            return true;
        }
        if h != 1i64 && h != 2i64 && !(h >= 3i64 && host_has_open_fd(view(*ctx), h)) {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { write(h, p_host as *const u8, byte_len as usize) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 8. close
    if host_name_eq(view(name), 49, 5) {
        let h = a0 as i64;
        if h >= 0i64 && h <= 2i64 {
            out_ret.vals[0] = 0u64;
            return true;
        }
        if h >= 3i64 && host_remove_open_fd(mut_view(*ctx), h) {
            let res = close(h);
            out_ret.vals[0] = res as u64;
            return true;
        }
        out_ret.vals[0] = (-4i64) as u64;
        return true;
    }

    // 9. file_size
    if host_name_eq(view(name), 54, 9) {
        let h = a0 as i64;
        if h < 3i64 || !host_has_open_fd(view(*ctx), h) {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = file_size(h);
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 10. args_count
    if host_name_eq(view(name), 63, 10) {
        if ctx.host.use_custom_args {
            out_ret.vals[0] = ctx.host.argc as u64;
        } else {
            let ac = args_count();
            out_ret.vals[0] = ac as u64;
        }
        return true;
    }

    // 11. arg
    if host_name_eq(view(name), 73, 3) {
        let idx = a0 as usize;
        let buf_addr = a1;
        let cap = a2 as usize;
        if ctx.host.use_custom_args {
            if idx >= ctx.host.argc {
                out_ret.vals[0] = (-4i64) as u64;
                return true;
            }
            let slot = unsafe { interp_host_arg_at(ctx.host.args, idx) };
            let ptr = unsafe { (*slot).ptr };
            let arg_len = unsafe { (*slot).len };
            if cap > 0 && arg_len > 0 {
                let to_write: usize = if arg_len < cap { arg_len } else { cap };
                let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, to_write as u64, 1u32);
                if !ctx.failed {
                    unsafe {
                        interp_copy_bytes(host_buf, ptr as *const u8, to_write);
                    }
                }
            }
            out_ret.vals[0] = (arg_len as i64) as u64;
            return true;
        }
        let total_len = unsafe { arg(idx, 0 as *mut u8, 0) };
        if total_len < 0i64 {
            out_ret.vals[0] = total_len as u64;
            return true;
        }
        if cap > 0 && total_len > 0i64 {
            let ulen = total_len as usize;
            let to_write: usize = if ulen < cap { ulen } else { cap };
            let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, to_write as u64, 1u32);
            if !ctx.failed {
                let _ = unsafe { arg(idx, host_buf, to_write) };
            }
        }
        out_ret.vals[0] = total_len as u64;
        return true;
    }

    // 12. env_get
    if host_name_eq(view(name), 76, 7) {
        let name_addr = a0;
        let name_len = a1;
        let buf_addr = a2;
        let cap = a3 as usize;
        let name_host = interp_validate_raw_ptr(mut_view(*ctx), name_addr, name_len, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let total_len = unsafe { env_get(name_host as *const u8, name_len as usize, 0 as *mut u8, 0) };
        if total_len < 0i64 {
            out_ret.vals[0] = total_len as u64;
            return true;
        }
        if cap > 0 && total_len > 0i64 {
            let ulen = total_len as usize;
            let to_write: usize = if ulen < cap { ulen } else { cap };
            let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, to_write as u64, 1u32);
            if !ctx.failed {
                let _ = unsafe { env_get(name_host as *const u8, name_len as usize, host_buf, to_write) };
            }
        }
        out_ret.vals[0] = total_len as u64;
        return true;
    }

    // 13. exe_path
    if host_name_eq(view(name), 83, 8) {
        let buf_addr = a0;
        let cap = a1 as usize;
        let total_len = unsafe { exe_path(0 as *mut u8, 0) };
        if total_len < 0i64 {
            out_ret.vals[0] = total_len as u64;
            return true;
        }
        if cap > 0 && total_len > 0i64 {
            let ulen = total_len as usize;
            let to_write: usize = if ulen < cap { ulen } else { cap };
            let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, to_write as u64, 1u32);
            if !ctx.failed {
                let _ = unsafe { exe_path(host_buf, to_write) };
            }
        }
        out_ret.vals[0] = total_len as u64;
        return true;
    }

    // 14. exit
    if host_name_eq(view(name), 91, 4) {
        let code = (a0 as u32) as i32;
        ctx.failed = true;
        ctx.has_exited = true;
        ctx.exit_code = code;
        out_ret.vals[0] = (code as i64) as u64;
        return true;
    }

    // 15. remove
    if host_name_eq(view(name), 95, 6) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { remove(path_host as *const u8, a1 as usize) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 16. mkdir
    if host_name_eq(view(name), 101, 5) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { mkdir(path_host as *const u8, a1 as usize) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 17. metadata
    if host_name_eq(view(name), 106, 8) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        let out_host = interp_validate_raw_ptr(mut_view(*ctx), a2, 16u64, 8u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { metadata(path_host as *const u8, a1 as usize, out_host as *mut u64) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 18. dir_open
    if host_name_eq(view(name), 114, 8) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { dir_open(path_host as *const u8, a1 as usize) };
        if res > 0i64 {
            host_record_open_dir(mut_view(*ctx), res);
        }
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 19. dir_next
    if host_name_eq(view(name), 122, 8) {
        let dhid = a0 as i64;
        let buf_addr = a1;
        let cap = a2 as usize;
        if !host_has_open_dir(view(*ctx), dhid) {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let n = unsafe { dir_next(dhid, 0 as *mut u8, 0) };
        if n <= 0i64 || (n as usize) > cap {
            out_ret.vals[0] = n as u64;
            return true;
        }
        let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, n as u64, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { dir_next(dhid, host_buf, cap) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 20. dir_close
    if host_name_eq(view(name), 130, 9) {
        let dhid = a0 as i64;
        if host_remove_open_dir(mut_view(*ctx), dhid) {
            let res = dir_close(dhid);
            out_ret.vals[0] = res as u64;
            return true;
        }
        out_ret.vals[0] = (-4i64) as u64;
        return true;
    }

    // 21. monotonic_ns
    if host_name_eq(view(name), 139, 12) {
        let mut ns = monotonic_ns();
        if ns < ctx.host.last_monotonic_ns {
            ns = ctx.host.last_monotonic_ns;
        } else {
            ctx.host.last_monotonic_ns = ns;
        }
        out_ret.vals[0] = ns;
        return true;
    }

    // 22..29. Single-thread fallback for thread/futex intrinsics when invoked outside scheduler
    let tkind = interp_host_thread_intrinsic_kind(view(name));
    if tkind == HOST_INTR_THREAD_CURRENT_ID {
        out_ret.vals[0] = (ctx.oracle.current_tid as u64) + 1u64;
        return true;
    }
    if tkind == HOST_INTR_THREAD_YIELD {
        out_ret.vals[0] = 0u64;
        return true;
    }
    if tkind == HOST_INTR_THREAD_SLEEP_NS {
        oracle_advance_sleep_ns(mut_view(*ctx), a0);
        out_ret.vals[0] = 0u64;
        return true;
    }
    if tkind == HOST_INTR_THREAD_SPAWN {
        if a0 == 0u64 {
            out_ret.vals[0] = (-4i64) as u64;
        } else {
            out_ret.vals[0] = (-9i64) as u64;
        }
        return true;
    }
    if tkind == HOST_INTR_THREAD_JOIN || tkind == HOST_INTR_THREAD_DETACH {
        out_ret.vals[0] = (-4i64) as u64;
        return true;
    }
    if tkind == HOST_INTR_FUTEX_WAIT {
        let mut ferr: i64 = 0i64;
        let cur_u32 = oracle_futex_peek_u32(mut_view(*ctx), a0, mut_view(ferr));
        if ferr != 0i64 {
            out_ret.vals[0] = ferr as u64;
        } else if cur_u32 != (a1 as u32) {
            out_ret.vals[0] = 0u64;
        } else {
            if a2 != 0xFFFFFFFFFFFFFFFFu64 {
                oracle_advance_sleep_ns(mut_view(*ctx), a2);
            }
            out_ret.vals[0] = (-5i64) as u64;
        }
        return true;
    }
    if tkind == HOST_INTR_FUTEX_WAKE {
        let werr = oracle_futex_validate_addr(mut_view(*ctx), a0);
        out_ret.vals[0] = werr as u64;
        return true;
    }

    false
}

// =================================================================================================
// Oracle Thread Scheduler Pointer, Sleep Clock, Fork/Join & Futex Validation Helpers (SPEC-32 §1)
// =================================================================================================

pub fn oracle_sched_ptr(ctx: view<InterpCtx>) -> usize {
    ctx.oracle.last_thread_callee[0]
}

pub fn oracle_set_sched_ptr(ctx: mut_view<InterpCtx>, p: usize) {
    ctx.oracle.last_thread_callee[0] = p;
}

pub fn oracle_has_live_spawned_threads(ctx: view<InterpCtx>) -> bool {
    let p = ctx.oracle.last_thread_callee[0];
    if p == 0 {
        return false;
    }
    let live_cnt = unsafe { *(p as *const usize) };
    live_cnt > 0
}

pub fn oracle_advance_sleep_ns(ctx: mut_view<InterpCtx>, ns: u64) {
    if ctx.host.last_monotonic_ns == 0u64 {
        ctx.host.last_monotonic_ns = monotonic_ns();
    }
    if ns > 0u64 {
        ctx.host.last_monotonic_ns = oracle_w_add_u64(ctx.host.last_monotonic_ns, ns);
    }
}

pub fn oracle_on_thread_spawn(ctx: mut_view<InterpCtx>, parent_vc_tid: u32, child_vc_tid: u32) {
    ctx.oracle.has_concurrent_threads = true;
    let p = (parent_vc_tid as usize) % INTERP_MAX_THREADS;
    let c = (child_vc_tid as usize) % INTERP_MAX_THREADS;
    let _ = oracle_advance_tid_epoch(mut_view(*ctx), parent_vc_tid);
    let prev_own = ctx.oracle.clock[c].v[c];
    let parent_c = ctx.oracle.clock[p].v[c];
    let base_ep = if prev_own >= parent_c { prev_own } else { parent_c };
    ctx.oracle.clock[c] = ctx.oracle.clock[p];
    ctx.oracle.clock[c].v[c] = base_ep + 1u64;
    ctx.oracle.acq_fence_clock[c] = vec_clock_zero();
    ctx.oracle.rel_fence_clock[c] = vec_clock_zero();
    let _ = oracle_advance_tid_epoch(mut_view(*ctx), parent_vc_tid);
}

pub fn oracle_on_thread_join(ctx: mut_view<InterpCtx>, caller_vc_tid: u32, child_vc_tid: u32) {
    let p = (caller_vc_tid as usize) % INTERP_MAX_THREADS;
    let c = (child_vc_tid as usize) % INTERP_MAX_THREADS;
    let _ = oracle_advance_tid_epoch(mut_view(*ctx), child_vc_tid);
    ctx.oracle.clock[p] = vec_clock_join(view(ctx.oracle.clock[p]), view(ctx.oracle.clock[c]));
    let _ = oracle_advance_tid_epoch(mut_view(*ctx), caller_vc_tid);
}

pub fn oracle_futex_peek_u32(ctx: mut_view<InterpCtx>, addr: u64, out_err: mut_view<i64>) -> u32 {
    *out_err = 0i64;
    if addr == 0u64 || (addr & 3u64) != 0u64 {
        *out_err = -4i64;
        return 0u32;
    }
    let host_ptr = interp_validate_raw_ptr(mut_view(*ctx), addr, 4u64, 4u32);
    if ctx.failed || (host_ptr as usize) == 0 {
        *out_err = -4i64;
        return 0u32;
    }
    unsafe { *(host_ptr as *const u32) }
}

pub fn oracle_futex_validate_addr(ctx: mut_view<InterpCtx>, addr: u64) -> i64 {
    if addr == 0u64 || (addr & 3u64) != 0u64 {
        return -4i64;
    }
    let _ = interp_validate_raw_ptr(mut_view(*ctx), addr, 4u64, 4u32);
    if ctx.failed {
        return -4i64;
    }
    0i64
}

// =================================================================================================
// Oracle Atomic Memory Model, Vector Clocks & Deterministic Schedule Explorer (SPEC-31 §6)
// =================================================================================================

pub fn oracle_w_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let sum_hi = (a_hi + b_hi + carry) & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}

pub fn oracle_w_sub_u64(a: u64, b: u64) -> u64 {
    let neg_b = oracle_w_add_u64(b ^ 0xFFFFFFFFFFFFFFFFu64, 1u64);
    oracle_w_add_u64(a, neg_b)
}

pub fn oracle_bit_mask(size: u32) -> u64 {
    if size == 1u32 {
        return 0xFFu64;
    }
    if size == 2u32 {
        return 0xFFFFu64;
    }
    if size == 4u32 {
        return 0xFFFFFFFFu64;
    }
    0xFFFFFFFFFFFFFFFFu64
}

pub fn oracle_read_scalar(ptr: *const u8, size: u32) -> u64 {
    if (ptr as usize) == 0 {
        return 0u64;
    }
    if size == 1u32 {
        return unsafe { *ptr as u64 };
    }
    if size == 2u32 {
        return unsafe { *(ptr as *const u16) as u64 };
    }
    if size == 4u32 {
        return unsafe { *(ptr as *const u32) as u64 };
    }
    unsafe { *(ptr as *const u64) }
}

pub fn oracle_write_scalar(ptr: *mut u8, size: u32, val: u64) {
    if (ptr as usize) == 0 {
        return;
    }
    if size == 1u32 {
        unsafe {
            *ptr = val as u8;
        }
    } else if size == 2u32 {
        unsafe {
            *(ptr as *mut u16) = val as u16;
        }
    } else if size == 4u32 {
        unsafe {
            *(ptr as *mut u32) = val as u32;
        }
    } else {
        unsafe {
            *(ptr as *mut u64) = val;
        }
    }
}

pub fn vec_clock_zero() -> InterpVecClock {
    InterpVecClock {
        v: [0u64; 16],
    }
}

pub fn vec_clock_join(a: view<InterpVecClock>, b: view<InterpVecClock>) -> InterpVecClock {
    let mut r = InterpVecClock {
        v: [0u64; 16],
    };
    let mut i: usize = 0;
    while i < INTERP_MAX_THREADS {
        let va = a.v[i];
        let vb = b.v[i];
        r.v[i] = if va >= vb { va } else { vb };
        i = i + 1;
    }
    r
}

pub fn oracle_seed_prng(ctx: mut_view<InterpCtx>, seed: u64) {
    ctx.oracle.schedule_seed = seed;
    let mut s = seed ^ 0x9E3779B97F4A7C15u64;
    if s == 0u64 {
        s = 0x9E3779B97F4A7C15u64;
    }
    ctx.oracle.prng_state = s;
}

pub fn oracle_next_prng(ctx: mut_view<InterpCtx>) -> u64 {
    let mut s = ctx.oracle.prng_state;
    if s == 0u64 {
        s = 0x9E3779B97F4A7C15u64;
    }
    s = s ^ (s << 13u64);
    s = s ^ (s >> 7u64);
    s = s ^ (s << 17u64);
    ctx.oracle.prng_state = s;
    s
}

pub fn oracle_advance_tid_epoch(ctx: mut_view<InterpCtx>, tid: u32) -> u64 {
    let t = (tid as usize) % INTERP_MAX_THREADS;
    let next_e = ctx.oracle.clock[t].v[t] + 1u64;
    ctx.oracle.clock[t].v[t] = next_e;
    next_e
}

pub fn oracle_join_threads(ctx: mut_view<InterpCtx>) {
    if ctx.oracle.active_thread_mask == 0u32 {
        return;
    }
    let mut c0 = ctx.oracle.clock[0];
    let mut t: usize = 1;
    while t < INTERP_MAX_THREADS {
        let bit = 1u32 << (t as u32);
        if (ctx.oracle.active_thread_mask & bit) != 0u32 {
            c0 = vec_clock_join(view(c0), view(ctx.oracle.clock[t]));
        }
        t = t + 1;
    }
    c0.v[0] = c0.v[0] + 1u64;
    ctx.oracle.clock[0] = c0;
    ctx.oracle.fork_clock = ctx.oracle.clock[0];
    ctx.oracle.active_thread_mask = 0u32;
    let mut k: usize = 1;
    while k < INTERP_MAX_THREADS {
        ctx.oracle.last_thread_callee[k] = 0;
        k = k + 1;
    }
}

pub fn oracle_begin_concurrent_batch(ctx: mut_view<InterpCtx>) {
    if ctx.oracle.active_thread_mask != 0u32 {
        oracle_join_threads(mut_view(*ctx));
    } else {
        let e0 = ctx.oracle.clock[0].v[0] + 1u64;
        ctx.oracle.clock[0].v[0] = e0;
        ctx.oracle.fork_clock = ctx.oracle.clock[0];
    }
    ctx.oracle.has_concurrent_threads = true;
    let run_idx = ctx.oracle.schedule_run_counter;
    ctx.oracle.schedule_run_counter = run_idx + 1u64;
    let mix = oracle_w_add_u64(ctx.oracle.schedule_seed, run_idx * 0x517CC1B727220A95u64);
    let mut s = ctx.oracle.prng_state ^ mix ^ 0x9E3779B97F4A7C15u64;
    if s == 0u64 {
        s = 0x9E3779B97F4A7C15u64;
    }
    ctx.oracle.prng_state = s;
    let _ = oracle_next_prng(mut_view(*ctx));
}

pub fn oracle_fork_thread_for_batch(ctx: mut_view<InterpCtx>, tid: u32, callee_addr: usize) {
    let t = (tid as usize) % INTERP_MAX_THREADS;
    if t == 0 {
        return;
    }
    let bit = 1u32 << (t as u32);
    ctx.oracle.has_concurrent_threads = true;
    if (ctx.oracle.active_thread_mask & bit) != 0u32 {
        if ctx.oracle.last_thread_callee[t] == callee_addr {
            oracle_begin_concurrent_batch(mut_view(*ctx));
        } else {
            ctx.oracle.last_thread_callee[t] = callee_addr;
            let _ = oracle_advance_tid_epoch(mut_view(*ctx), tid);
            return;
        }
    }
    ctx.oracle.active_thread_mask = ctx.oracle.active_thread_mask | bit;
    ctx.oracle.last_thread_callee[t] = callee_addr;
    let prev_own_epoch = ctx.oracle.clock[t].v[t];
    let prev_fork_epoch = ctx.oracle.fork_clock.v[t];
    let base_epoch = if prev_own_epoch >= prev_fork_epoch { prev_own_epoch } else { prev_fork_epoch };
    ctx.oracle.clock[t] = ctx.oracle.fork_clock;
    ctx.oracle.clock[t].v[t] = base_epoch + 1u64;
    ctx.oracle.acq_fence_clock[t] = vec_clock_zero();
    ctx.oracle.rel_fence_clock[t] = vec_clock_zero();
}

pub fn oracle_ranges_overlap(a_addr: usize, a_sz: u32, b_addr: usize, b_sz: u32) -> bool {
    let a_end = a_addr + (a_sz as usize);
    let b_end = b_addr + (b_sz as usize);
    a_addr < b_end && b_addr < a_end
}

pub fn oracle_invalidate_range(ctx: mut_view<InterpCtx>, ptr: *const u8, size: usize) {
    let base = ptr as usize;
    if base == 0 || size == 0 {
        return;
    }
    let end = base + size;
    let mut i: usize = 0;
    while i < ctx.oracle.atomic_loc_len {
        let loc = unsafe { interp_atomic_loc_at(ctx.oracle.atomic_locs, i) };
        let l_addr = unsafe { (*loc).host_addr };
        let l_sz = unsafe { (*loc).size as usize };
        if l_addr < end && base < l_addr + l_sz {
            unsafe {
                (*loc).is_active = false;
                (*loc).write_len = 0;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < ctx.oracle.ord_access_len {
        let oa = unsafe { interp_ord_access_at(ctx.oracle.ord_accesses, i) };
        let o_addr = unsafe { (*oa).host_addr };
        let o_sz = unsafe { (*oa).size as usize };
        if o_addr < end && base < o_addr + o_sz {
            unsafe {
                (*oa).is_active = false;
            }
        }
        i = i + 1;
    }
}

pub fn oracle_has_active_atomic_at(ctx: view<InterpCtx>, ptr: *const u8, size: u32) -> bool {
    let addr = ptr as usize;
    if addr == 0 || size == 0u32 {
        return false;
    }
    let mut i: usize = 0;
    while i < ctx.oracle.atomic_loc_len {
        let loc = unsafe { interp_atomic_loc_at(ctx.oracle.atomic_locs, i) };
        if unsafe { (*loc).is_active } {
            let l_addr = unsafe { (*loc).host_addr };
            let l_sz = unsafe { (*loc).size };
            if oracle_ranges_overlap(addr, size, l_addr, l_sz) {
                return true;
            }
        }
        i = i + 1;
    }
    false
}

pub fn oracle_reset_atomic_loc(ctx: mut_view<InterpCtx>, ptr: *const u8, size: u32) {
    oracle_invalidate_range(mut_view(*ctx), ptr, size as usize);
}

fn oracle_append_atomic_write(
    loc: *mut InterpAtomicLoc,
    val: u64,
    writer_tid: u32,
    writer_epoch: u64,
    order: u8,
    is_rmw: bool,
    seq_cst_index: u64,
    rel_clock: view<InterpVecClock>
) -> usize {
    let wlen = unsafe { (*loc).write_len };
    let wcap = unsafe { (*loc).write_cap };
    if wlen >= wcap {
        let new_cap: usize = if wcap == 0 { 8 } else { interp_mul_usize(wcap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<InterpAtomicWrite>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<InterpAtomicWrite>()) as *mut InterpAtomicWrite };
        unsafe {
            interp_zero_bytes(new_arr as *mut u8, new_bytes);
        }
        let old_arr = unsafe { (*loc).writes };
        if wlen > 0 && (old_arr as usize) != 0 {
            let old_bytes = interp_mul_usize(wlen, size_of<InterpAtomicWrite>());
            let old_cap_bytes = interp_mul_usize(wcap, size_of<InterpAtomicWrite>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, old_arr as *const u8, old_bytes);
                heap_free(old_arr as *mut u8, old_cap_bytes, align_of<InterpAtomicWrite>());
            }
        }
        unsafe {
            (*loc).writes = new_arr;
            (*loc).write_cap = new_cap;
        }
    }
    let slot = unsafe { interp_atomic_write_at((*loc).writes, wlen) };
    unsafe {
        (*slot).val = val;
        (*slot).writer_tid = writer_tid;
        (*slot).writer_epoch = writer_epoch;
        (*slot).order = order;
        (*slot).is_rmw = is_rmw;
        (*slot).seq_cst_index = seq_cst_index;
        (*slot).rel_clock = *rel_clock;
        (*loc).write_len = wlen + 1;
    }
    wlen
}

pub fn oracle_find_or_create_atomic_loc(
    ctx: mut_view<InterpCtx>,
    host_ptr: *mut u8,
    size: u32
) -> *mut InterpAtomicLoc {
    let addr = host_ptr as usize;
    if addr == 0 || size == 0u32 {
        return 0 as *mut InterpAtomicLoc;
    }
    if size > 1u32 && (addr % (size as usize)) != 0 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_MISALIGNED);
        return 0 as *mut InterpAtomicLoc;
    }

    let mut reuse_slot: *mut InterpAtomicLoc = 0 as *mut InterpAtomicLoc;
    let mut i: usize = 0;
    while i < ctx.oracle.atomic_loc_len {
        let loc = unsafe { interp_atomic_loc_at(ctx.oracle.atomic_locs, i) };
        let active = unsafe { (*loc).is_active };
        let l_addr = unsafe { (*loc).host_addr };
        let l_sz = unsafe { (*loc).size };
        if active {
            if l_addr == addr && l_sz == size {
                return loc;
            }
            if oracle_ranges_overlap(addr, size, l_addr, l_sz) {
                interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_ATOMIC_OVERLAP);
                return 0 as *mut InterpAtomicLoc;
            }
        } else if (reuse_slot as usize) == 0 {
            reuse_slot = loc;
        }
        i = i + 1;
    }

    let mut target: *mut InterpAtomicLoc = reuse_slot;
    if (target as usize) == 0 {
        if ctx.oracle.atomic_loc_len >= ctx.oracle.atomic_loc_cap {
            let new_cap: usize = if ctx.oracle.atomic_loc_cap == 0 { 32 } else { interp_mul_usize(ctx.oracle.atomic_loc_cap, 2) };
            let new_bytes = interp_mul_usize(new_cap, size_of<InterpAtomicLoc>());
            let new_arr = unsafe { heap_alloc(new_bytes, align_of<InterpAtomicLoc>()) as *mut InterpAtomicLoc };
            unsafe {
                interp_zero_bytes(new_arr as *mut u8, new_bytes);
            }
            if ctx.oracle.atomic_loc_len > 0 && (ctx.oracle.atomic_locs as usize) != 0 {
                let old_bytes = interp_mul_usize(ctx.oracle.atomic_loc_len, size_of<InterpAtomicLoc>());
                let old_cap_bytes = interp_mul_usize(ctx.oracle.atomic_loc_cap, size_of<InterpAtomicLoc>());
                unsafe {
                    interp_copy_bytes(new_arr as *mut u8, ctx.oracle.atomic_locs as *const u8, old_bytes);
                    heap_free(ctx.oracle.atomic_locs as *mut u8, old_cap_bytes, align_of<InterpAtomicLoc>());
                }
            }
            ctx.oracle.atomic_locs = new_arr;
            ctx.oracle.atomic_loc_cap = new_cap;
        }
        target = unsafe { interp_atomic_loc_at(ctx.oracle.atomic_locs, ctx.oracle.atomic_loc_len) };
        ctx.oracle.atomic_loc_len = ctx.oracle.atomic_loc_len + 1;
    }

    let init_val = oracle_read_scalar(host_ptr as *const u8, size) & oracle_bit_mask(size);
    let init_clock = ctx.oracle.fork_clock;
    unsafe {
        (*target).host_addr = addr;
        (*target).size = size;
        (*target).is_active = true;
        (*target).write_len = 0;
        (*target).last_write_tid = 0u32;
        (*target).last_write_epoch = init_clock.v[0];
        (*target).last_spurious_mo_len = 0;
        (*target).last_spurious_tid = 0xFFFFFFFFu32;
        let mut ti: usize = 0;
        while ti < INTERP_MAX_THREADS {
            (*target).seen_mo[ti] = 0;
            (*target).last_read_epoch[ti] = 0u64;
            (*target).last_read_mo[ti] = 0;
            (*target).last_weak_load_mo_len[ti] = 0;
            ti = ti + 1;
        }
    }
    let _ = oracle_append_atomic_write(
        target,
        init_val,
        0u32,
        init_clock.v[0],
        MIR_ORDER_RELAXED,
        false,
        0u64,
        view(init_clock)
    );
    target
}

fn oracle_check_atomic_vs_ordinary(
    ctx: mut_view<InterpCtx>,
    addr: usize,
    size: u32,
    tid: u32,
    is_write: bool
) -> bool {
    let t = (tid as usize) % INTERP_MAX_THREADS;
    let mut i: usize = 0;
    while i < ctx.oracle.ord_access_len {
        let oa = unsafe { interp_ord_access_at(ctx.oracle.ord_accesses, i) };
        if unsafe { (*oa).is_active } {
            let o_addr = unsafe { (*oa).host_addr };
            let o_sz = unsafe { (*oa).size };
            if oracle_ranges_overlap(addr, size, o_addr, o_sz) {
                let w_tid = unsafe { (*oa).last_write_tid as usize };
                let w_ep = unsafe { (*oa).last_write_epoch };
                if w_ep > 0u64 && w_tid != t {
                    if w_ep > ctx.oracle.clock[t].v[w_tid] {
                        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_MIXED_ATOMIC);
                        return false;
                    }
                }
                if is_write {
                    let mut r: usize = 0;
                    while r < INTERP_MAX_THREADS {
                        if r != t {
                            let r_ep = unsafe { (*oa).read_epochs[r] };
                            if r_ep > 0u64 && r_ep > ctx.oracle.clock[t].v[r] {
                                interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_MIXED_ATOMIC);
                                return false;
                            }
                        }
                        r = r + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    true
}

fn oracle_find_or_create_ord_access(ctx: mut_view<InterpCtx>, addr: usize, size: u32) -> *mut InterpOrdAccess {
    let mut reuse_slot: *mut InterpOrdAccess = 0 as *mut InterpOrdAccess;
    let mut i: usize = 0;
    while i < ctx.oracle.ord_access_len {
        let oa = unsafe { interp_ord_access_at(ctx.oracle.ord_accesses, i) };
        let active = unsafe { (*oa).is_active };
        let o_addr = unsafe { (*oa).host_addr };
        let o_sz = unsafe { (*oa).size };
        if active && o_addr == addr && o_sz == size {
            return oa;
        }
        if !active && (reuse_slot as usize) == 0 {
            reuse_slot = oa;
        }
        i = i + 1;
    }
    let mut target = reuse_slot;
    if (target as usize) == 0 {
        if ctx.oracle.ord_access_len >= ctx.oracle.ord_access_cap {
            let new_cap: usize = if ctx.oracle.ord_access_cap == 0 { 64 } else { interp_mul_usize(ctx.oracle.ord_access_cap, 2) };
            let new_bytes = interp_mul_usize(new_cap, size_of<InterpOrdAccess>());
            let new_arr = unsafe { heap_alloc(new_bytes, align_of<InterpOrdAccess>()) as *mut InterpOrdAccess };
            unsafe {
                interp_zero_bytes(new_arr as *mut u8, new_bytes);
            }
            if ctx.oracle.ord_access_len > 0 && (ctx.oracle.ord_accesses as usize) != 0 {
                let old_bytes = interp_mul_usize(ctx.oracle.ord_access_len, size_of<InterpOrdAccess>());
                let old_cap_bytes = interp_mul_usize(ctx.oracle.ord_access_cap, size_of<InterpOrdAccess>());
                unsafe {
                    interp_copy_bytes(new_arr as *mut u8, ctx.oracle.ord_accesses as *const u8, old_bytes);
                    heap_free(ctx.oracle.ord_accesses as *mut u8, old_cap_bytes, align_of<InterpOrdAccess>());
                }
            }
            ctx.oracle.ord_accesses = new_arr;
            ctx.oracle.ord_access_cap = new_cap;
        }
        target = unsafe { interp_ord_access_at(ctx.oracle.ord_accesses, ctx.oracle.ord_access_len) };
        ctx.oracle.ord_access_len = ctx.oracle.ord_access_len + 1;
    }
    unsafe {
        (*target).host_addr = addr;
        (*target).size = size;
        (*target).is_active = true;
        (*target).last_write_tid = 0u32;
        (*target).last_write_epoch = 0u64;
        let mut r: usize = 0;
        while r < INTERP_MAX_THREADS {
            (*target).read_epochs[r] = 0u64;
            r = r + 1;
        }
    }
    target
}

pub fn oracle_record_ordinary_read(
    ctx: mut_view<InterpCtx>,
    ptr: *const u8,
    size: u32,
    is_raw_deref: bool
) {
    let addr = ptr as usize;
    if addr == 0 || size == 0u32 || ctx.failed {
        return;
    }
    let tid = ctx.oracle.current_tid;
    let t = (tid as usize) % INTERP_MAX_THREADS;

    // 1. Check against active atomic locations (mixed atomic/ordinary race, AXS-ATM-052)
    let mut i: usize = 0;
    while i < ctx.oracle.atomic_loc_len {
        let loc = unsafe { interp_atomic_loc_at(ctx.oracle.atomic_locs, i) };
        if unsafe { (*loc).is_active } {
            let l_addr = unsafe { (*loc).host_addr };
            let l_sz = unsafe { (*loc).size };
            if oracle_ranges_overlap(addr, size, l_addr, l_sz) {
                let w_tid = unsafe { (*loc).last_write_tid as usize };
                let w_ep = unsafe { (*loc).last_write_epoch };
                if (w_ep > 0u64 && w_tid != t && w_ep > ctx.oracle.clock[t].v[w_tid]) || (is_raw_deref && tid != 0u32) {
                    interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_MIXED_ATOMIC);
                    return;
                }
            }
        }
        i = i + 1;
    }

    if !ctx.oracle.has_concurrent_threads || (tid == 0u32 && !oracle_has_live_spawned_threads(view(*ctx))) {
        return;
    }
    let f_base = ctx.oracle.current_frame_storage as usize;
    let f_sz = ctx.oracle.current_frame_storage_size;
    if f_base != 0 && addr >= f_base && addr + (size as usize) <= f_base + f_sz {
        return;
    }

    // 2. Check against ordinary memory writes from other threads
    i = 0;
    while i < ctx.oracle.ord_access_len {
        let oa = unsafe { interp_ord_access_at(ctx.oracle.ord_accesses, i) };
        if unsafe { (*oa).is_active } {
            let o_addr = unsafe { (*oa).host_addr };
            let o_sz = unsafe { (*oa).size };
            if oracle_ranges_overlap(addr, size, o_addr, o_sz) {
                let w_tid = unsafe { (*oa).last_write_tid as usize };
                let w_ep = unsafe { (*oa).last_write_epoch };
                if w_ep > 0u64 && w_tid != t && w_ep > ctx.oracle.clock[t].v[w_tid] {
                    interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DATA_RACE);
                    return;
                }
            }
        }
        i = i + 1;
    }

    let oa_slot = oracle_find_or_create_ord_access(mut_view(*ctx), addr, size);
    let cur_ep = ctx.oracle.clock[t].v[t];
    unsafe {
        if cur_ep > (*oa_slot).read_epochs[t] {
            (*oa_slot).read_epochs[t] = cur_ep;
        }
    }
}

pub fn oracle_record_ordinary_write(
    ctx: mut_view<InterpCtx>,
    ptr: *const u8,
    size: u32
) {
    let addr = ptr as usize;
    if addr == 0 || size == 0u32 || ctx.failed {
        return;
    }
    let tid = ctx.oracle.current_tid;
    let t = (tid as usize) % INTERP_MAX_THREADS;

    // 1. Any non-initialization ordinary write to an active atomic location is UB (AXS-ATM-052)
    let mut i: usize = 0;
    while i < ctx.oracle.atomic_loc_len {
        let loc = unsafe { interp_atomic_loc_at(ctx.oracle.atomic_locs, i) };
        if unsafe { (*loc).is_active } {
            let l_addr = unsafe { (*loc).host_addr };
            let l_sz = unsafe { (*loc).size };
            if oracle_ranges_overlap(addr, size, l_addr, l_sz) {
                interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_MIXED_ATOMIC);
                return;
            }
        }
        i = i + 1;
    }

    if !ctx.oracle.has_concurrent_threads || (tid == 0u32 && !oracle_has_live_spawned_threads(view(*ctx))) {
        return;
    }
    let f_base = ctx.oracle.current_frame_storage as usize;
    let f_sz = ctx.oracle.current_frame_storage_size;
    if f_base != 0 && addr >= f_base && addr + (size as usize) <= f_base + f_sz {
        return;
    }

    // 2. Check against ordinary writes and reads from other threads
    i = 0;
    while i < ctx.oracle.ord_access_len {
        let oa = unsafe { interp_ord_access_at(ctx.oracle.ord_accesses, i) };
        if unsafe { (*oa).is_active } {
            let o_addr = unsafe { (*oa).host_addr };
            let o_sz = unsafe { (*oa).size };
            if oracle_ranges_overlap(addr, size, o_addr, o_sz) {
                let w_tid = unsafe { (*oa).last_write_tid as usize };
                let w_ep = unsafe { (*oa).last_write_epoch };
                if w_ep > 0u64 && w_tid != t && w_ep > ctx.oracle.clock[t].v[w_tid] {
                    interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DATA_RACE);
                    return;
                }
                let mut r: usize = 0;
                while r < INTERP_MAX_THREADS {
                    if r != t {
                        let r_ep = unsafe { (*oa).read_epochs[r] };
                        if r_ep > 0u64 && r_ep > ctx.oracle.clock[t].v[r] {
                            interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DATA_RACE);
                            return;
                        }
                    }
                    r = r + 1;
                }
            }
        }
        i = i + 1;
    }

    let oa_slot = oracle_find_or_create_ord_access(mut_view(*ctx), addr, size);
    let cur_ep = oracle_advance_tid_epoch(mut_view(*ctx), tid);
    unsafe {
        (*oa_slot).last_write_tid = tid;
        (*oa_slot).last_write_epoch = cur_ep;
    }
}

pub fn oracle_atomic_load(
    ctx: mut_view<InterpCtx>,
    host_ptr: *mut u8,
    size: u32,
    ord: u8
) -> u64 {
    if ord == MIR_ORDER_RELEASE || ord == MIR_ORDER_ACQ_REL || ord > MIR_ORDER_SEQ_CST {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_ATOMIC_ORDER);
        return 0u64;
    }
    let loc = oracle_find_or_create_atomic_loc(mut_view(*ctx), host_ptr, size);
    if (loc as usize) == 0 || ctx.failed {
        return 0u64;
    }
    let tid = ctx.oracle.current_tid;
    let t = (tid as usize) % INTERP_MAX_THREADS;
    if !oracle_check_atomic_vs_ordinary(mut_view(*ctx), host_ptr as usize, size, tid, false) {
        return 0u64;
    }

    let cur_ep = oracle_advance_tid_epoch(mut_view(*ctx), tid);
    if ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.seq_cst_tick = ctx.oracle.seq_cst_tick + 1u64;
    }

    let wlen = unsafe { (*loc).write_len };
    let writes = unsafe { (*loc).writes };
    let mut min_mo: usize = unsafe { (*loc).seen_mo[t] };

    // CoWR: any write happens-before this thread bounds min_mo
    let mut m: usize = 0;
    while m < wlen {
        let w = unsafe { interp_atomic_write_at(writes, m) };
        let w_tid = unsafe { (*w).writer_tid as usize };
        let w_ep = unsafe { (*w).writer_epoch };
        if ctx.oracle.clock[t].v[w_tid] >= w_ep && m > min_mo {
            min_mo = m;
        }
        if ord == MIR_ORDER_SEQ_CST {
            let sc_i = unsafe { (*w).seq_cst_index };
            if sc_i > 0u64 && m > min_mo {
                min_mo = m;
            }
        }
        m = m + 1;
    }

    // CoRR: any read happens-before this thread bounds min_mo
    let mut u: usize = 0;
    while u < INTERP_MAX_THREADS {
        let lr_ep = unsafe { (*loc).last_read_epoch[u] };
        let lr_mo = unsafe { (*loc).last_read_mo[u] };
        if lr_ep > 0u64 && ctx.oracle.clock[t].v[u] >= lr_ep && lr_mo > min_mo {
            min_mo = lr_mo;
        }
        u = u + 1;
    }

    if min_mo >= wlen {
        min_mo = wlen - 1;
    }

    let mut chosen_idx: usize = wlen - 1;
    let last_weak_len = unsafe { (*loc).last_weak_load_mo_len[t] };
    if min_mo < wlen - 1 && ctx.oracle.schedule_run_counter > 1u64 && last_weak_len != wlen {
        unsafe {
            (*loc).last_weak_load_mo_len[t] = wlen;
        }
        let span = wlen - min_mo;
        let rnd = (oracle_next_prng(mut_view(*ctx)) as usize) % span;
        chosen_idx = min_mo + rnd;
    }

    let chosen_w = unsafe { interp_atomic_write_at(writes, chosen_idx) };
    let w_val = unsafe { (*chosen_w).val };
    let w_rel = unsafe { (*chosen_w).rel_clock };

    ctx.oracle.acq_fence_clock[t] = vec_clock_join(view(ctx.oracle.acq_fence_clock[t]), view(w_rel));
    if ord == MIR_ORDER_ACQUIRE || ord == MIR_ORDER_ACQ_REL || ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.clock[t] = vec_clock_join(view(ctx.oracle.clock[t]), view(w_rel));
    }

    unsafe {
        if chosen_idx > (*loc).seen_mo[t] {
            (*loc).seen_mo[t] = chosen_idx;
        }
        (*loc).last_read_epoch[t] = cur_ep;
        if chosen_idx > (*loc).last_read_mo[t] {
            (*loc).last_read_mo[t] = chosen_idx;
        }
    }
    w_val & oracle_bit_mask(size)
}

pub fn oracle_atomic_store(
    ctx: mut_view<InterpCtx>,
    host_ptr: *mut u8,
    size: u32,
    val: u64,
    ord: u8
) {
    if ord == MIR_ORDER_ACQUIRE || ord == MIR_ORDER_ACQ_REL || ord > MIR_ORDER_SEQ_CST {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_ATOMIC_ORDER);
        return;
    }
    let loc = oracle_find_or_create_atomic_loc(mut_view(*ctx), host_ptr, size);
    if (loc as usize) == 0 || ctx.failed {
        return;
    }
    let tid = ctx.oracle.current_tid;
    let t = (tid as usize) % INTERP_MAX_THREADS;
    if !oracle_check_atomic_vs_ordinary(mut_view(*ctx), host_ptr as usize, size, tid, true) {
        return;
    }

    let cur_ep = oracle_advance_tid_epoch(mut_view(*ctx), tid);
    let mut sc_idx: u64 = 0u64;
    if ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.seq_cst_tick = ctx.oracle.seq_cst_tick + 1u64;
        sc_idx = ctx.oracle.seq_cst_tick;
    }

    let w_rel = if ord == MIR_ORDER_RELEASE || ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.clock[t]
    } else {
        ctx.oracle.rel_fence_clock[t]
    };

    let masked_val = val & oracle_bit_mask(size);
    let new_idx = oracle_append_atomic_write(loc, masked_val, tid, cur_ep, ord, false, sc_idx, view(w_rel));
    unsafe {
        (*loc).seen_mo[t] = new_idx;
        (*loc).last_write_tid = tid;
        (*loc).last_write_epoch = cur_ep;
    }
    oracle_write_scalar(host_ptr, size, masked_val);
}

pub fn oracle_atomic_rmw(
    ctx: mut_view<InterpCtx>,
    host_ptr: *mut u8,
    size: u32,
    aop: u8,
    arg_val: u64,
    ord: u8
) -> u64 {
    if ord > MIR_ORDER_SEQ_CST {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_ATOMIC_ORDER);
        return 0u64;
    }
    let loc = oracle_find_or_create_atomic_loc(mut_view(*ctx), host_ptr, size);
    if (loc as usize) == 0 || ctx.failed {
        return 0u64;
    }
    let tid = ctx.oracle.current_tid;
    let t = (tid as usize) % INTERP_MAX_THREADS;
    if !oracle_check_atomic_vs_ordinary(mut_view(*ctx), host_ptr as usize, size, tid, true) {
        return 0u64;
    }

    let cur_ep = oracle_advance_tid_epoch(mut_view(*ctx), tid);
    let mask = oracle_bit_mask(size);
    let wlen = unsafe { (*loc).write_len };
    let k = wlen - 1;
    let wk = unsafe { interp_atomic_write_at((*loc).writes, k) };
    let old_val = (unsafe { (*wk).val }) & mask;
    let wk_rel = unsafe { (*wk).rel_clock };

    // Acquire synchronization on read of W_k
    ctx.oracle.acq_fence_clock[t] = vec_clock_join(view(ctx.oracle.acq_fence_clock[t]), view(wk_rel));
    if ord == MIR_ORDER_ACQUIRE || ord == MIR_ORDER_ACQ_REL || ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.clock[t] = vec_clock_join(view(ctx.oracle.clock[t]), view(wk_rel));
    }

    // Wrapping two's-complement RMW computation (AXS-ATM-024)
    let rhs = arg_val & mask;
    let mut new_val: u64 = rhs;
    if aop == MIR_ATOMIC_SWAP {
        new_val = rhs;
    } else if aop == MIR_ATOMIC_ADD {
        new_val = oracle_w_add_u64(old_val, rhs) & mask;
    } else if aop == MIR_ATOMIC_SUB {
        new_val = oracle_w_sub_u64(old_val, rhs) & mask;
    } else if aop == MIR_ATOMIC_AND {
        new_val = (old_val & rhs) & mask;
    } else if aop == MIR_ATOMIC_OR {
        new_val = (old_val | rhs) & mask;
    } else if aop == MIR_ATOMIC_XOR {
        new_val = (old_val ^ rhs) & mask;
    }

    // Release sequence preservation (AXS-ATM-021, AXS-ATM-051(3))
    let mut w_rel = wk_rel;
    if ord == MIR_ORDER_RELEASE || ord == MIR_ORDER_ACQ_REL || ord == MIR_ORDER_SEQ_CST {
        w_rel = vec_clock_join(view(w_rel), view(ctx.oracle.clock[t]));
    } else {
        w_rel = vec_clock_join(view(w_rel), view(ctx.oracle.rel_fence_clock[t]));
    }

    let mut sc_idx: u64 = 0u64;
    if ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.seq_cst_tick = ctx.oracle.seq_cst_tick + 1u64;
        sc_idx = ctx.oracle.seq_cst_tick;
    }

    let new_idx = oracle_append_atomic_write(loc, new_val, tid, cur_ep, ord, true, sc_idx, view(w_rel));
    unsafe {
        (*loc).seen_mo[t] = new_idx;
        (*loc).last_write_tid = tid;
        (*loc).last_write_epoch = cur_ep;
        (*loc).last_read_epoch[t] = cur_ep;
        if k > (*loc).last_read_mo[t] {
            (*loc).last_read_mo[t] = k;
        }
    }
    oracle_write_scalar(host_ptr, size, new_val);
    old_val
}

pub fn oracle_atomic_cmpxchg(
    ctx: mut_view<InterpCtx>,
    host_ptr: *mut u8,
    size: u32,
    expected_val: u64,
    desired_val: u64,
    succ_ord: u8,
    fail_ord: u8,
    is_weak: bool,
    out_ok: mut_view<bool>
) -> u64 {
    *out_ok = false;
    if succ_ord > MIR_ORDER_SEQ_CST || fail_ord == MIR_ORDER_RELEASE || fail_ord == MIR_ORDER_ACQ_REL || fail_ord > MIR_ORDER_SEQ_CST {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_ATOMIC_ORDER);
        return 0u64;
    }
    let loc = oracle_find_or_create_atomic_loc(mut_view(*ctx), host_ptr, size);
    if (loc as usize) == 0 || ctx.failed {
        return 0u64;
    }
    let tid = ctx.oracle.current_tid;
    let t = (tid as usize) % INTERP_MAX_THREADS;

    let mask = oracle_bit_mask(size);
    let exp_masked = expected_val & mask;
    let des_masked = desired_val & mask;
    let wlen = unsafe { (*loc).write_len };
    let k = wlen - 1;
    let wk = unsafe { interp_atomic_write_at((*loc).writes, k) };
    let old_val = (unsafe { (*wk).val }) & mask;
    let wk_rel = unsafe { (*wk).rel_clock };

    // Deterministic spurious failure for compare_exchange_weak (AXS-ATM-054)
    let mut spurious_fail = false;
    if is_weak && old_val == exp_masked {
        let last_sp_len = unsafe { (*loc).last_spurious_mo_len };
        let last_sp_tid = unsafe { (*loc).last_spurious_tid };
        if last_sp_len != wlen || last_sp_tid != tid {
            unsafe {
                (*loc).last_spurious_mo_len = wlen;
                (*loc).last_spurious_tid = tid;
            }
            spurious_fail = true;
        }
    }

    if old_val != exp_masked || spurious_fail {
        if !oracle_check_atomic_vs_ordinary(mut_view(*ctx), host_ptr as usize, size, tid, false) {
            return old_val;
        }
        let cur_ep = oracle_advance_tid_epoch(mut_view(*ctx), tid);
        if fail_ord == MIR_ORDER_SEQ_CST {
            ctx.oracle.seq_cst_tick = ctx.oracle.seq_cst_tick + 1u64;
        }
        ctx.oracle.acq_fence_clock[t] = vec_clock_join(view(ctx.oracle.acq_fence_clock[t]), view(wk_rel));
        if fail_ord == MIR_ORDER_ACQUIRE || fail_ord == MIR_ORDER_SEQ_CST {
            ctx.oracle.clock[t] = vec_clock_join(view(ctx.oracle.clock[t]), view(wk_rel));
        }
        unsafe {
            if k > (*loc).seen_mo[t] {
                (*loc).seen_mo[t] = k;
            }
            (*loc).last_read_epoch[t] = cur_ep;
            if k > (*loc).last_read_mo[t] {
                (*loc).last_read_mo[t] = k;
            }
        }
        *out_ok = false;
        return old_val;
    }

    if !oracle_check_atomic_vs_ordinary(mut_view(*ctx), host_ptr as usize, size, tid, true) {
        return old_val;
    }
    let cur_ep = oracle_advance_tid_epoch(mut_view(*ctx), tid);

    ctx.oracle.acq_fence_clock[t] = vec_clock_join(view(ctx.oracle.acq_fence_clock[t]), view(wk_rel));
    if succ_ord == MIR_ORDER_ACQUIRE || succ_ord == MIR_ORDER_ACQ_REL || succ_ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.clock[t] = vec_clock_join(view(ctx.oracle.clock[t]), view(wk_rel));
    }

    let mut w_rel = wk_rel;
    if succ_ord == MIR_ORDER_RELEASE || succ_ord == MIR_ORDER_ACQ_REL || succ_ord == MIR_ORDER_SEQ_CST {
        w_rel = vec_clock_join(view(w_rel), view(ctx.oracle.clock[t]));
    } else {
        w_rel = vec_clock_join(view(w_rel), view(ctx.oracle.rel_fence_clock[t]));
    }

    let mut sc_idx: u64 = 0u64;
    if succ_ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.seq_cst_tick = ctx.oracle.seq_cst_tick + 1u64;
        sc_idx = ctx.oracle.seq_cst_tick;
    }

    let new_idx = oracle_append_atomic_write(loc, des_masked, tid, cur_ep, succ_ord, true, sc_idx, view(w_rel));
    unsafe {
        (*loc).seen_mo[t] = new_idx;
        (*loc).last_write_tid = tid;
        (*loc).last_write_epoch = cur_ep;
        (*loc).last_read_epoch[t] = cur_ep;
        if k > (*loc).last_read_mo[t] {
            (*loc).last_read_mo[t] = k;
        }
    }
    oracle_write_scalar(host_ptr, size, des_masked);
    *out_ok = true;
    old_val
}

pub fn oracle_atomic_fence(ctx: mut_view<InterpCtx>, ord: u8) {
    if ord == MIR_ORDER_RELAXED || ord > MIR_ORDER_SEQ_CST {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_ATOMIC_ORDER);
        return;
    }
    let tid = ctx.oracle.current_tid;
    let t = (tid as usize) % INTERP_MAX_THREADS;
    let _ = oracle_advance_tid_epoch(mut_view(*ctx), tid);

    if ord == MIR_ORDER_RELEASE || ord == MIR_ORDER_ACQ_REL || ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.rel_fence_clock[t] = ctx.oracle.clock[t];
    }
    if ord == MIR_ORDER_ACQUIRE || ord == MIR_ORDER_ACQ_REL || ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.clock[t] = vec_clock_join(view(ctx.oracle.clock[t]), view(ctx.oracle.acq_fence_clock[t]));
    }
    if ord == MIR_ORDER_SEQ_CST {
        ctx.oracle.clock[t] = vec_clock_join(view(ctx.oracle.clock[t]), view(ctx.oracle.seq_cst_fence_clock));
        ctx.oracle.seq_cst_fence_clock = ctx.oracle.clock[t];
        ctx.oracle.rel_fence_clock[t] = ctx.oracle.clock[t];
        ctx.oracle.seq_cst_tick = ctx.oracle.seq_cst_tick + 1u64;
    }
}

pub fn oracle_atomic_compiler_fence(ctx: mut_view<InterpCtx>, ord: u8) {
    if ord == MIR_ORDER_RELAXED || ord > MIR_ORDER_SEQ_CST {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_ATOMIC_ORDER);
        return;
    }
}

// =================================================================================================
// Async Lifecycle Tracing & Verification (SPEC-33 AXS-ASY-050, REQ-ASY-059, REQ-ASY-060)
// =================================================================================================

pub fn oracle_find_or_create_fut(
    ctx: mut_view<InterpCtx>,
    self_addr: usize,
    name: StrView
) -> *mut InterpAsyncFut {
    let mut i: usize = 0;
    while i < ctx.oracle.async_fut_len {
        let fut = unsafe { interp_async_fut_at(ctx.oracle.async_futs, i) };
        if (unsafe { (*fut).self_addr }) == self_addr {
            return fut;
        }
        i = i + 1;
    }

    if ctx.oracle.async_fut_len >= ctx.oracle.async_fut_cap {
        let new_cap: usize = if ctx.oracle.async_fut_cap == 0 { 16 } else { ctx.oracle.async_fut_cap * 2 };
        let new_bytes = interp_mul_usize(new_cap, size_of<InterpAsyncFut>());
        let new_ptr = unsafe { heap_alloc(new_bytes, align_of<InterpAsyncFut>()) as *mut InterpAsyncFut };
        unsafe {
            interp_zero_bytes(new_ptr as *mut u8, new_bytes);
        }
        if ctx.oracle.async_fut_len > 0 && (ctx.oracle.async_futs as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.oracle.async_fut_len, size_of<InterpAsyncFut>());
            unsafe {
                interp_copy_bytes(new_ptr as *mut u8, ctx.oracle.async_futs as *const u8, old_bytes);
                heap_free(ctx.oracle.async_futs as *mut u8, interp_mul_usize(ctx.oracle.async_fut_cap, size_of<InterpAsyncFut>()), align_of<InterpAsyncFut>());
            }
        }
        ctx.oracle.async_futs = new_ptr;
        ctx.oracle.async_fut_cap = new_cap;
    }

    let idx = ctx.oracle.async_fut_len;
    ctx.oracle.async_fut_len = idx + 1;
    let slot = unsafe { interp_async_fut_at(ctx.oracle.async_futs, idx) };
    let fid = ctx.oracle.next_fut_id;
    ctx.oracle.next_fut_id = fid + 1u64;

    unsafe {
        (*slot).fut_id = fid;
        (*slot).self_addr = self_addr;
        (*slot).name_ptr = name.ptr;
        (*slot).name_len = name.len;
        (*slot).state_tag = 0u32;
        (*slot).is_completed = false;
        (*slot).is_cancelled = false;
        (*slot).last_suspended_sp = 0u32;
        (*slot).has_last_suspended_sp = false;
    }
    slot
}

fn oracle_panic_str(ctx: mut_view<InterpCtx>, s: str) {
    let sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    interp_panic_sv(mut_view(*ctx), sv);
}

pub fn oracle_record_async_poll(
    ctx: mut_view<InterpCtx>,
    self_addr: usize,
    name: StrView,
    state_tag: u32
) -> u64 {
    let fut = oracle_find_or_create_fut(mut_view(*ctx), self_addr, name);
    let fid = unsafe { (*fut).fut_id };
    let is_comp = unsafe { (*fut).is_completed };
    let is_canc = unsafe { (*fut).is_cancelled };

    if state_tag == 0u32 {
        unsafe {
            (*fut).name_ptr = name.ptr;
            (*fut).name_len = name.len;
            (*fut).state_tag = 0u32;
            (*fut).is_completed = false;
            (*fut).is_cancelled = false;
            (*fut).last_suspended_sp = 0u32;
            (*fut).has_last_suspended_sp = false;
        }
        return fid;
    }

    if is_comp || is_canc || state_tag == 0xFFFFFFFFu32 || state_tag == 0xFFFFFFFEu32 {
        oracle_panic_str(mut_view(*ctx), "polling a completed Future state machine");
        return fid;
    }

    unsafe {
        (*fut).state_tag = state_tag;
    }
    fid
}

pub fn oracle_record_async_suspend(
    ctx: mut_view<InterpCtx>,
    self_addr: usize,
    name: StrView,
    sp: u32,
    state: u32
) {
    let fut = oracle_find_or_create_fut(mut_view(*ctx), self_addr, name);
    unsafe {
        (*fut).state_tag = state;
        (*fut).last_suspended_sp = sp;
        (*fut).has_last_suspended_sp = true;
    }
}

pub fn oracle_record_async_complete(
    ctx: mut_view<InterpCtx>,
    self_addr: usize,
    name: StrView
) {
    let fut = oracle_find_or_create_fut(mut_view(*ctx), self_addr, name);
    unsafe {
        (*fut).state_tag = 0xFFFFFFFFu32;
        (*fut).is_completed = true;
    }
}

pub fn oracle_record_async_cancel_drop(
    ctx: mut_view<InterpCtx>,
    self_addr: usize,
    name: StrView,
    state: u32
) {
    let fut = oracle_find_or_create_fut(mut_view(*ctx), self_addr, name);
    unsafe {
        (*fut).state_tag = 0xFFFFFFFEu32;
        (*fut).is_cancelled = true;
    }
}
