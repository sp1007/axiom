        let mut port = a2 as u16;
        if port == 0u16 {
            port = unsafe { (*st).next_ephemeral_port };
            unsafe { (*st).next_ephemeral_port = port + 1u16; }
        }
        let hid = oracle_aio_alloc_handle(st, ORACLE_AIO_KIND_UDP_SOCK, rid);
