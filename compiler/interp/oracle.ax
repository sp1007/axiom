    // 13. aio_submit_connect(reactor: i64, addr_ipv4: u32, port: u16) -> i64
    if akind == 13u8 {
        let rid = a0 as i64;
        let r = oracle_aio_get_reactor(st, rid);
        if (r as usize) == 0 {
            out_ret.vals[0] = (-4i64) as u64;
            return;
        }
        let port = a2 as u16;
        let mut listener: *mut OracleAioHandle = 0 as *mut OracleAioHandle;
        let mut hi: usize = 0;
        while hi < ORACLE_AIO_MAX_HANDLES {
            let hh = unsafe { oracle_aio_handle_at((*st).handles, hi) };
            if unsafe { (*hh).in_use } && (unsafe { (*hh).kind }) == ORACLE_AIO_KIND_TCP_LISTENER && (unsafe { (*hh).port }) == port {
                listener = hh;
                break;
            }
            hi = hi + 1;
        }
        let op_id = oracle_aio_next_op(st);
        if (listener as usize) == 0 {
            oracle_aio_push_event(r, op_id, -7i64, 0u64);
            out_ret.vals[0] = op_id;
            return;
        }
        let c_hid = oracle_aio_alloc_handle(st, ORACLE_AIO_KIND_TCP_STREAM, rid);
        let s_rid = unsafe { (*listener).reactor_id };
        let s_hid = oracle_aio_alloc_handle(st, ORACLE_AIO_KIND_TCP_STREAM, s_rid);
        if c_hid < 0i64 || s_hid < 0i64 {
            oracle_aio_push_event(r, op_id, -9i64, 0u64);
            out_ret.vals[0] = op_id;
            return;
        }
        let c_port = unsafe { (*st).next_ephemeral_port };
        unsafe { (*st).next_ephemeral_port = c_port + 1u16; }
        let ch = oracle_aio_get_handle(st, c_hid);
        let sh = oracle_aio_get_handle(st, s_hid);
