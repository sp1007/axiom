    // 12. aio_submit_accept(reactor: i64, listener: i64) -> i64
    if akind == 12u8 {
        let rid = a0 as i64;
        let r = oracle_aio_get_reactor(st, rid);
        let h = oracle_aio_get_handle(st, a1 as i64);
        if (r as usize) == 0 || (h as usize) == 0 || (unsafe { (*h).kind }) != ORACLE_AIO_KIND_TCP_LISTENER {
            out_ret.vals[0] = (-4i64) as u64;
            return;
        }
        let op_id = oracle_aio_next_op(st);
        unsafe {
            (*h).pending_accept_op = op_id;
            (*h).pending_accept_reactor = rid;
        }
        out_ret.vals[0] = op_id;
        return;
