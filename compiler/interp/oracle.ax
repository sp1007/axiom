        let peer_id = unsafe { (*h).peer_handle };
        let pop_acc = unsafe { (*h).pending_accept_op };
        let pop_rec = unsafe { (*h).pending_recv_op };
        if pop_acc != 0u64 {
            let rr = oracle_aio_get_reactor(st, unsafe { (*h).pending_accept_reactor });
            if (rr as usize) != 0 {
                oracle_aio_push_event(rr, pop_acc, -6i64, 0u64);
            }
        }
        if pop_rec != 0u64 {
            let rr = oracle_aio_get_reactor(st, unsafe { (*h).pending_recv_reactor });
            if (rr as usize) != 0 {
                oracle_aio_push_event(rr, pop_rec, -6i64, 0u64);
            }
        }
        oracle_aio_free_handle_resources(h);
        if peer_id > 0i64 {
            let peer = oracle_aio_get_handle(st, peer_id);
            if (peer as usize) != 0 {
                unsafe { (*peer).peer_handle = 0i64; }
                oracle_aio_deliver_pending_recv(mut_view(*ctx), st, peer);
            }
        }
        out_ret.vals[0] = 0u64;
        return;
    }

    out_ret.vals[0] = (-4i64) as u64;
}
