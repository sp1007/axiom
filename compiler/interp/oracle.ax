            (*ch).ip = 0x7F000001u32;
            (*ch).port = c_port;
            (*ch).peer_handle = s_hid;
            (*sh).ip = 0x7F000001u32;
            (*sh).port = port;
            (*sh).peer_handle = c_hid;
        }
        oracle_aio_push_event(r, op_id, c_hid, ((0x7F000001u64) << 16u64) | (port as u64));
        let acc_op = unsafe { (*listener).pending_accept_op };
        if acc_op != 0u64 {
            let acc_r = oracle_aio_get_reactor(st, unsafe { (*listener).pending_accept_reactor });
            unsafe { (*listener).pending_accept_op = 0u64; }
            if (acc_r as usize) != 0 {
                oracle_aio_push_event(acc_r, acc_op, s_hid, ((0x7F000001u64) << 16u64) | (c_port as u64));
            }
        }
        out_ret.vals[0] = op_id;
        return;
    }

    // 14. aio_submit_recv(reactor: i64, stream: i64, buf: *mut u8, len: usize) -> i64
    if akind == 14u8 {
        let rid = a0 as i64;
        let r = oracle_aio_get_reactor(st, rid);
        let h = oracle_aio_get_handle(st, a1 as i64);
        if (r as usize) == 0 || (h as usize) == 0 || (unsafe { (*h).kind }) != ORACLE_AIO_KIND_TCP_STREAM {
            out_ret.vals[0] = (-4i64) as u64;
