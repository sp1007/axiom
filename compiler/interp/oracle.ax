        if how == 1u32 || how == 2u32 {
            unsafe { (*h).shutdown_w = true; }
            let peer = oracle_aio_get_handle(st, unsafe { (*h).peer_handle });
            if (peer as usize) != 0 {
                oracle_aio_deliver_pending_recv(mut_view(*ctx), st, peer);
            }
        }
        out_ret.vals[0] = 0u64;
        return;
    }

    // 17. aio_udp_bind(reactor: i64, addr_ipv4: u32, port: u16) -> i64
    if akind == 17u8 {
        let rid = a0 as i64;
        let r = oracle_aio_get_reactor(st, rid);
        if (r as usize) == 0 {
            out_ret.vals[0] = (-4i64) as u64;
            return;
