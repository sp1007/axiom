        let blen = a3 as usize;
        let dst_port = a5 as u16;
        let op_id = oracle_aio_next_op(st);
        let host_buf = if blen > 0 { interp_validate_raw_ptr(mut_view(*ctx), a2, blen as u64, 1u32) } else { 0 as *mut u8 };
        if blen > 0 && (ctx.failed || (host_buf as usize) == 0) {
            out_ret.vals[0] = (-4i64) as u64;
            return;
