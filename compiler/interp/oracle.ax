        if blen > 0 {
            let host_buf = interp_validate_raw_ptr(mut_view(*ctx), a2, blen as u64, 1u32);
            if ctx.failed || (host_buf as usize) == 0 {
                out_ret.vals[0] = (-4i64) as u64;
                return;
            }
            let _ = oracle_aio_rx_push(peer, host_buf as *const u8, blen);
        }
        oracle_aio_push_event(r, op_id, blen as i64, 0u64);
        oracle_aio_deliver_pending_recv(mut_view(*ctx), st, peer);
        out_ret.vals[0] = op_id;
        return;
    }

    // 16. aio_tcp_shutdown(stream: i64, how: u32) -> i64
    if akind == 16u8 {
        let h = oracle_aio_get_handle(st, a0 as i64);
        if (h as usize) == 0 || (unsafe { (*h).kind }) != ORACLE_AIO_KIND_TCP_STREAM {
            out_ret.vals[0] = (-4i64) as u64;
            return;
        }
        let how = a1 as u32;
        if how == 0u32 || how == 2u32 {
            unsafe { (*h).shutdown_r = true; }
