            (*h).port = port;
        }
        out_ret.vals[0] = hid as u64;
        return;
    }

    // 18. aio_submit_recv_from(reactor: i64, sock: i64, buf: *mut u8, len: usize) -> i64
    if akind == 18u8 {
        let rid = a0 as i64;
        let r = oracle_aio_get_reactor(st, rid);
        let h = oracle_aio_get_handle(st, a1 as i64);
        if (r as usize) == 0 || (h as usize) == 0 || (unsafe { (*h).kind }) != ORACLE_AIO_KIND_UDP_SOCK {
            out_ret.vals[0] = (-4i64) as u64;
            return;
