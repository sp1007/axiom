        let op_id = oracle_aio_next_op(st);
        unsafe {
            (*h).pending_recv_op = op_id;
            (*h).pending_recv_reactor = rid;
            (*h).pending_recv_addr = a2;
            (*h).pending_recv_cap = a3 as usize;
        }
        oracle_aio_deliver_pending_recv(mut_view(*ctx), st, h);
        out_ret.vals[0] = op_id;
        return;
    }

    // 15. aio_submit_send(reactor: i64, stream: i64, buf: *const u8, len: usize) -> i64
    if akind == 15u8 {
        let r = oracle_aio_get_reactor(st, a0 as i64);
        let h = oracle_aio_get_handle(st, a1 as i64);
        if (r as usize) == 0 || (h as usize) == 0 || (unsafe { (*h).kind }) != ORACLE_AIO_KIND_TCP_STREAM {
            out_ret.vals[0] = (-4i64) as u64;
            return;
