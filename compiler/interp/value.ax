    // the last successful raw-pointer validation resolved into.
    pub ub_load_ctx: bool,
    pub ub_last_alloc: *mut InterpAlloc,
    // T502: spans of the HIR statements that carry a block-scope `@addr(E)` placement (collected lazily, arena memory).
    pub placement_spans: *mut Span,
    pub placement_count: usize,
    pub placement_cap: usize,
    pub placement_scanned: bool,
}

// =================================================================================================
// Pointer & Memory Helpers
// =================================================================================================

pub fn interp_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn interp_alloc_at(base: *mut InterpAlloc, idx: usize) -> *mut InterpAlloc {
    let off = interp_mul_usize(idx, size_of<InterpAlloc>());
    ((base as usize) + off) as *mut InterpAlloc
}

pub unsafe fn interp_atomic_write_at(base: *mut InterpAtomicWrite, idx: usize) -> *mut InterpAtomicWrite {
    let off = interp_mul_usize(idx, size_of<InterpAtomicWrite>());
    ((base as usize) + off) as *mut InterpAtomicWrite
}

pub unsafe fn interp_atomic_loc_at(base: *mut InterpAtomicLoc, idx: usize) -> *mut InterpAtomicLoc {
    let off = interp_mul_usize(idx, size_of<InterpAtomicLoc>());
    ((base as usize) + off) as *mut InterpAtomicLoc
}

pub unsafe fn interp_async_fut_at(base: *mut InterpAsyncFut, idx: usize) -> *mut InterpAsyncFut {
    let off = interp_mul_usize(idx, size_of<InterpAsyncFut>());
    ((base as usize) + off) as *mut InterpAsyncFut
}

pub unsafe fn interp_ord_access_at(base: *mut InterpOrdAccess, idx: usize) -> *mut InterpOrdAccess {
    let off = interp_mul_usize(idx, size_of<InterpOrdAccess>());
    ((base as usize) + off) as *mut InterpOrdAccess
}

pub unsafe fn interp_val_at(base: *mut InterpValue, idx: usize) -> *mut InterpValue {
    let off = interp_mul_usize(idx, size_of<InterpValue>());
    ((base as usize) + off) as *mut InterpValue
}

pub unsafe fn interp_host_arg_at(base: *mut InterpHostArg, idx: usize) -> *mut InterpHostArg {
    let off = interp_mul_usize(idx, size_of<InterpHostArg>());
    ((base as usize) + off) as *mut InterpHostArg
}

pub unsafe fn interp_i64_at(base: *mut i64, idx: usize) -> *mut i64 {
    let off = interp_mul_usize(idx, size_of<i64>());
    ((base as usize) + off) as *mut i64
}

pub unsafe fn interp_u8_ptr_at(base: *mut *mut u8, idx: usize) -> *mut *mut u8 {
    let off = interp_mul_usize(idx, size_of<*mut u8>());
    ((base as usize) + off) as *mut *mut u8
}

pub unsafe fn mir_body_entry_at(base: *mut MirBodyEntry, idx: usize) -> *mut MirBodyEntry {
    let off = interp_mul_usize(idx, size_of<MirBodyEntry>());
    ((base as usize) + off) as *mut MirBodyEntry
}

pub fn interp_val_zero() -> InterpValue {
    InterpValue {
        vals: [0u64; 32],
    }
}

pub fn interp_val_u64(v: u64) -> InterpValue {
    let mut r = InterpValue {
        vals: [0u64; 32],
    };
    r.vals[0] = v;
    r
}

pub fn interp_val_u128(lo: u64, hi: u64) -> InterpValue {
    let mut r = InterpValue {
        vals: [0u64; 32],
    };
    r.vals[0] = lo;
    r.vals[1] = hi;
    r
}

pub fn interp_zero_val(dst: mut_view<InterpValue>) {
    let mut i: usize = 0;
    while i < 32 {
        dst.vals[i] = 0u64;
        i = i + 1;
    }
}

pub fn interp_copy_val(dst: mut_view<InterpValue>, src: view<InterpValue>) {
    let mut i: usize = 0;
    while i < 32 {
        dst.vals[i] = src.vals[i];
        i = i + 1;
    }
}

// -------------------------------------------------------------------------------------------------
// By-value call arguments larger than one InterpValue slot (T498c)
//
// A call-argument buffer is `n` InterpValue slots followed by a spill area. A value of at most
// size_of<InterpValue>() bytes lives inline in its slot (the fast path, unchanged). A larger value is
// copied byte-exact into the spill area, which the buffer grows to hold, and its slot keeps a spill
// descriptor: vals[0] = byte offset of the value from the buffer start, vals[1] = its size,
// vals[2] = INTERP_ARG_SPILL_MAGIC. Offsets (not pointers) keep the descriptor valid when the buffer
// is reallocated, and the spill area dies with the buffer, so every existing
// `heap_free(args, args_bytes, align_of<InterpValue>())` frees it. There is no size cap: the spill
// size is the argument's own type size.
// -------------------------------------------------------------------------------------------------

pub const INTERP_ARG_SPILL_MAGIC: u64 = 0x4752414C4C495053u64;

/// Writes the `size` bytes at `src` as argument `idx` of the buffer at `*buf_addr` (`*buf_bytes` bytes,
/// slot `idx` already zeroed). Inline when it fits a slot, otherwise spilled; `*buf_addr` and
/// `*buf_bytes` are updated when the buffer grows.
pub unsafe fn interp_arg_store(buf_addr: mut_view<usize>, buf_bytes: mut_view<usize>, idx: usize, src: *const u8, size: usize) {
    let slot_sz = size_of<InterpValue>();
    if size <= slot_sz {
        let dst = interp_val_at(*buf_addr as *mut InterpValue, idx) as *mut u8;
        interp_copy_bytes(dst, src, size);
        return;
    }
    let old_bytes = *buf_bytes;
    let off = (old_bytes + 15) & (0xFFFFFFFFFFFFFFFFusize ^ 15usize);
    let new_bytes = off + ((size + 15) & (0xFFFFFFFFFFFFFFFFusize ^ 15usize));
    let new_buf = heap_alloc(new_bytes, align_of<InterpValue>());
    interp_zero_bytes(new_buf, new_bytes);
    interp_copy_bytes(new_buf, *buf_addr as *const u8, old_bytes);
    heap_free(*buf_addr as *mut u8, old_bytes, align_of<InterpValue>());
    interp_copy_bytes(new_buf + off, src, size);
    let slot = interp_val_at(new_buf as *mut InterpValue, idx);
    (*slot).vals[0] = off as u64;
    (*slot).vals[1] = size as u64;
    (*slot).vals[2] = INTERP_ARG_SPILL_MAGIC;
    *buf_addr = new_buf as usize;
    *buf_bytes = new_bytes;
}

/// Copies argument `idx` of the buffer `base` into a parameter's storage `dst` of `dst_cap` bytes
/// (never less than one slot). A spilled argument is copied in full (up to `dst_cap`); an inline one
/// copies its slot.
pub unsafe fn interp_arg_load(dst: *mut u8, dst_cap: usize, base: *const InterpValue, idx: usize) {
    let slot_sz = size_of<InterpValue>();
    let slot = interp_val_at(base as *mut InterpValue, idx);
    if dst_cap > slot_sz && (*slot).vals[2] == INTERP_ARG_SPILL_MAGIC && (*slot).vals[1] > (slot_sz as u64) {
        let spill_sz = (*slot).vals[1] as usize;
        let n = if spill_sz < dst_cap { spill_sz } else { dst_cap };
        let src = ((base as usize) + ((*slot).vals[0] as usize)) as *const u8;
        interp_copy_bytes(dst, src, n);
        return;
    }
    interp_copy_bytes(dst, slot as *const u8, slot_sz);
}

pub unsafe fn interp_zero_bytes(dst: *mut u8, count: usize) {
    if (dst as usize) == 0 || count == 0 {
        return;
    }
    ptr_write_bytes<u8>(dst, 0u8, count);
}

pub unsafe fn interp_fill_bytes(dst: *mut u8, byte_val: u8, count: usize) {
    if (dst as usize) == 0 || count == 0 {
        return;
    }
    ptr_write_bytes<u8>(dst, byte_val, count);
}

pub unsafe fn interp_copy_bytes(dst: *mut u8, src: *const u8, count: usize) {
    if count == 0 || (dst as usize) == 0 || (src as usize) == 0 {
        return;
    }
    let dst_addr = dst as usize;
    let src_addr = src as usize;
    if dst_addr == src_addr {
        return;
    }
    if dst_addr + count <= src_addr || src_addr + count <= dst_addr {
        ptr_copy_nonoverlapping<u8>(src, dst, count);
    } else if dst_addr > src_addr && dst_addr < src_addr + count {
        let mut i: usize = count;
        while i > 0 {
            i = i - 1;
            *(dst + i) = *(src + i);
        }
    } else {
        let mut i: usize = 0;
        while i < count {
            *(dst + i) = *(src + i);
            i = i + 1;
        }
    }
}

pub unsafe fn interp_move_bytes(dst: *mut u8, src: *const u8, count: usize) {
    interp_copy_bytes(dst, src, count);
}

pub unsafe fn interp_cstr_len(s: *const u8) -> usize {
    if (s as usize) == 0 {
        return 0;
    }
    let mut n: usize = 0;
    while *(s + n) != 0u8 {
        n = n + 1;
    }
    n
}

pub unsafe fn interp_bytes_eq(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if *(a + i) != *(b + i) {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn interp_sv_eq(a: view<StrView>, b: view<StrView>) -> bool {
    unsafe { interp_bytes_eq(a.ptr, a.len, b.ptr, b.len) }
}

pub fn interp_sv_contains(hay: view<StrView>, needle: view<StrView>) -> bool {
    if needle.len == 0 {
        return true;
    }
    if (hay.ptr as usize) == 0 || (needle.ptr as usize) == 0 || (hay.len) < (needle.len) {
        return false;
    }
    let mut start: usize = 0;
    while start + needle.len <= hay.len {
        let ok = unsafe { interp_bytes_eq(hay.ptr + start, needle.len, needle.ptr, needle.len) };
        if ok {
            return true;
        }
        start = start + 1;
    }
    false
}

// =================================================================================================
// Message Lookup & Formatting
// =================================================================================================

fn interp_msg_range(msg_kind: u8, out_off: mut_view<usize>, out_len: mut_view<usize>) {
    *out_off = 0;
    *out_len = 0;
    if msg_kind == INTERP_MSG_UB_NULL_DEREF {
        *out_off = 0;
        *out_len = 24;
    } else if msg_kind == INTERP_MSG_UB_MISALIGNED {
        *out_off = 24;
        *out_len = 25;
    } else if msg_kind == INTERP_MSG_UB_UNMAPPED {
        *out_off = 49;
        *out_len = 33;
    } else if msg_kind == INTERP_MSG_UB_DANGLING {
        *out_off = 82;
        *out_len = 40;
    } else if msg_kind == INTERP_MSG_UB_OOB {
        *out_off = 122;
        *out_len = 28;
    } else if msg_kind == INTERP_MSG_UB_PTR_ARITH_UNMAPPED {
        *out_off = 150;
        *out_len = 53;
    } else if msg_kind == INTERP_MSG_UB_PTR_ARITH_OOB {
        *out_off = 203;
        *out_len = 43;
    } else if msg_kind == INTERP_MSG_UB_FREE_NON_HEAP {
        *out_off = 246;
        *out_len = 39;
    } else if msg_kind == INTERP_MSG_UB_USIZE_AS_PTR {
        *out_off = 285;
        *out_len = 46;
    } else if msg_kind == INTERP_MSG_UB_OVERLAPPING_COPY {
        *out_off = 331;
        *out_len = 47;
    } else if msg_kind == INTERP_MSG_PANIC_SUBSLICE_NON_ARR {
        *out_off = 378;
        *out_len = 32;
    } else if msg_kind == INTERP_MSG_PANIC_SUBSLICE_OOB {
        *out_off = 410;
        *out_len = 23;
    } else if msg_kind == INTERP_MSG_PANIC_INDEX_NON_ARR {
        *out_off = 433;
        *out_len = 29;
    } else if msg_kind == INTERP_MSG_PANIC_INDEX_OOB {
        *out_off = 462;
        *out_len = 19;
    } else if msg_kind == INTERP_MSG_PANIC_ASSERT_FAILED {
        *out_off = 481;
        *out_len = 16;
    } else if msg_kind == INTERP_MSG_PANIC_UNREACHABLE {
        *out_off = 497;
        *out_len = 24;
    } else if msg_kind == INTERP_MSG_PANIC_PANIC {
        *out_off = 521;
        *out_len = 5;
    } else if msg_kind == INTERP_MSG_PANIC_COMPTIME_CALL {
        *out_off = 526;
        *out_len = 52;
    } else if msg_kind == INTERP_MSG_PANIC_DIV_ZERO {
        *out_off = 578;
        *out_len = 16;
    } else if msg_kind == INTERP_MSG_PANIC_SHIFT_RANGE {
        *out_off = 594;
        *out_len = 25;
    } else if msg_kind == INTERP_MSG_PANIC_ARITH_OV {
        *out_off = 619;
        *out_len = 19;
    } else if msg_kind == INTERP_MSG_PANIC_UNRESOLVED_CALL {
        *out_off = 638;
        *out_len = 24;
    } else if msg_kind == INTERP_MSG_PANIC_UNSUPPORTED_TERM {
        *out_off = 662;
        *out_len = 22;
    } else if msg_kind == INTERP_MSG_LIMIT_COMPTIME_STEP {
        *out_off = 684;
        *out_len = 52;
    } else if msg_kind == INTERP_MSG_LIMIT_STEP {
        *out_off = 736;
        *out_len = 19;
    }
}

pub fn interp_alloc_msg(arena: mut_view<Arena>, msg_kind: u8) -> StrView {
    if msg_kind == INTERP_MSG_LIMIT_STACK {
        let n: usize = 25;
        let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
        let mut i: usize = 0;
        while i < n {
            unsafe {
                *(dst + i) = INTERP_MSG_STACK_BYTES[i];
            }
            i = i + 1;
        }
        unsafe {
            *(dst + n) = 0u8;
        }
        return StrView { ptr: dst as *const u8, len: n };
    }
    if msg_kind == INTERP_MSG_FFI_NOT_IN_ORACLE {
        let n: usize = 51;
        let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
        let mut i: usize = 0;
        while i < n {
            unsafe {
                *(dst + i) = INTERP_MSG_FFI_BYTES[i];
            }
            i = i + 1;
        }
        unsafe {
            *(dst + n) = 0u8;
        }
        return StrView { ptr: dst as *const u8, len: n };
    }
    if msg_kind == INTERP_MSG_UB_DATA_RACE {
        let n: usize = 43;
        let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
        let mut i: usize = 0;
        while i < n {
            unsafe {
                *(dst + i) = INTERP_MSG_DATA_RACE_BYTES[i];
            }
            i = i + 1;
        }
        unsafe {
            *(dst + n) = 0u8;
        }
        return StrView { ptr: dst as *const u8, len: n };
    }
    if msg_kind == INTERP_MSG_UB_MIXED_ATOMIC {
        let n: usize = 46;
        let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
        let mut i: usize = 0;
        while i < n {
            unsafe {
                *(dst + i) = INTERP_MSG_MIXED_ATOMIC_BYTES[i];
            }
            i = i + 1;
        }
        unsafe {
            *(dst + n) = 0u8;
        }
        return StrView { ptr: dst as *const u8, len: n };
    }
    if msg_kind == INTERP_MSG_UB_ATOMIC_ORDER {
        let n: usize = 44;
        let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
        let mut i: usize = 0;
        while i < n {
            unsafe {
                *(dst + i) = INTERP_MSG_ATOMIC_ORDER_BYTES[i];
            }
            i = i + 1;
        }
        unsafe {
            *(dst + n) = 0u8;
        }
        return StrView { ptr: dst as *const u8, len: n };
    }
    if msg_kind == INTERP_MSG_UB_ATOMIC_OVERLAP {
        let n: usize = 47;
        let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
        let mut i: usize = 0;
        while i < n {
            unsafe {
                *(dst + i) = INTERP_MSG_ATOMIC_OVERLAP_BYTES[i];
            }
            i = i + 1;
        }
        unsafe {
            *(dst + n) = 0u8;
        }
        return StrView { ptr: dst as *const u8, len: n };
    }
    if msg_kind >= INTERP_MSG_UB_UNINIT_READ && msg_kind <= INTERP_MSG_UB_INVALID_PROVENANCE {
        // T502: the UB-04 / UB-07 / UB-12 / forged-provenance messages live in their own table.
        let mut uoff: usize = 0;
        let mut ulen: usize = 28;
        if msg_kind == INTERP_MSG_UB_WRITE_READONLY {
            uoff = 28;
            ulen = 25;
        } else if msg_kind == INTERP_MSG_UB_INVALID_FIXED_ADDR {
            uoff = 53;
            ulen = 63;
        } else if msg_kind == INTERP_MSG_UB_INVALID_PROVENANCE {
            uoff = 116;
            ulen = 58;
        }
        let udst = arena_alloc_raw(mut_view(*arena), ulen + 1, 1);
        let mut ui: usize = 0;
        while ui < ulen {
            unsafe {
                *(udst + ui) = INTERP_MSG_UB2_BYTES[uoff + ui];
            }
            ui = ui + 1;
        }
        unsafe {
            *(udst + ulen) = 0u8;
        }
        return StrView { ptr: udst as *const u8, len: ulen };
    }
    let mut off: usize = 0;
    let mut msg_len: usize = 0;
    interp_msg_range(msg_kind, mut_view(off), mut_view(msg_len));
    let dst = arena_alloc_raw(mut_view(*arena), msg_len + 1, 1);
    let mut i: usize = 0;
    while i < msg_len {
        unsafe {
            *(dst + i) = INTERP_MSG_BYTES[off + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + msg_len) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: msg_len }
}

pub fn interp_msg_sv(arena: mut_view<Arena>, msg_kind: u8) -> StrView {
    interp_alloc_msg(mut_view(*arena), msg_kind)
}

fn interp_msg_has_div_zero(msg_ptr: *const u8, msg_len: usize) -> bool {
    if (msg_ptr as usize) == 0 || msg_len < 16 {
        return false;
    }
    let mut start: usize = 0;
    while start + 16 <= msg_len {
        let mut matched = true;
        let mut j: usize = 0;
        while j < 16 {
            let b = unsafe { *(msg_ptr + start + j) };
            if b != INTERP_WORD_DIV_ZERO[j] {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched {
            return true;
        }
        start = start + 1;
    }
    false
}

// T483: true when the message contains "shift amount out of range" (INTERP_MSG_BYTES[594..619]).
fn interp_msg_has_shift_range(msg_ptr: *const u8, msg_len: usize) -> bool {
    if (msg_ptr as usize) == 0 || msg_len < 25 {
        return false;
    }
    let mut start: usize = 0;
    while start + 25 <= msg_len {
        let mut matched = true;
        let mut j: usize = 0;
        while j < 25 {
            let b = unsafe { *(msg_ptr + start + j) };
            if b != INTERP_MSG_BYTES[594 + j] {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched {
            return true;
        }
        start = start + 1;
    }
    false
}

// =================================================================================================
// UB, Panic & Limit Reporting
// =================================================================================================

pub fn interp_push_diag(ctx: mut_view<InterpCtx>, code_v: u32, span: Span, msg: StrView) {
    interp_push_diag_kind(mut_view(*ctx), code_v, span, msg, 0, 0);
}

// Same, with a structured `data.ub_kind = <kind>` entry when `kind_len > 0` (`kind_off`/`kind_len` index INTERP_UB_KIND_BYTES).
fn interp_push_diag_kind(ctx: mut_view<InterpCtx>, code_v: u32, span: Span, msg: StrView, kind_off: usize, kind_len: usize) {
    if (ctx.sink as usize) != 0 {
        let d_ptr = arena_alloc_raw(mut_view(ctx.arena), size_of<Diagnostic>(), align_of<Diagnostic>()) as *mut Diagnostic;
        unsafe {
            interp_zero_bytes(d_ptr as *mut u8, size_of<Diagnostic>());
            let c = diag_code(code_v);
            let sev = diag_code_severity(c);
            (*d_ptr).code = c;
            (*d_ptr).severity = sev;
            (*d_ptr).message = msg;
            (*d_ptr).primary = span;
            if kind_len > 0 {
                let key = interp_ub_kind_sv(mut_view(ctx.arena), 153, 7);
                let val = interp_ub_kind_sv(mut_view(ctx.arena), kind_off, kind_len);
                let ent = arena_alloc_raw(mut_view(ctx.arena), size_of<DiagDataEntry>(), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
                *ent = DiagDataEntry {
                    key: key,
                    value: DiagDataValue {
                        kind: DiagDataKind.String,
                        str_val: val,
                        int_val: 0i64,
                        bool_val: false,
                        list_items: 0 as *mut StrView,
                        list_count: 0usize,
                    },
                };
                (*d_ptr).data = ent;
                (*d_ptr).data_count = 1;
            }
            diag_sink_report(mut_view(*ctx.sink), view(*d_ptr));
        }
    }
}

fn interp_ub_kind_sv(arena: mut_view<Arena>, off: usize, len: usize) -> StrView {
    let dst = arena_alloc_raw(mut_view(*arena), len + 1, 1);
    let mut i: usize = 0;
    while i < len {
        unsafe {
            *(dst + i) = INTERP_UB_KIND_BYTES[off + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + len) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: len }
}

// The SPEC-50 AXS-UNS-015 `ub_kind` of a UB message kind: offset/length into INTERP_UB_KIND_BYTES (0/0 when none).
fn interp_ub_kind_range(msg_kind: u8, out_off: mut_view<usize>, out_len: mut_view<usize>) {
    *out_off = 0;
    *out_len = 0;
    if msg_kind == INTERP_MSG_UB_DANGLING || msg_kind == INTERP_MSG_UB_FREE_NON_HEAP {
        *out_len = 17;
    } else if msg_kind == INTERP_MSG_UB_NULL_DEREF {
        *out_off = 17;
        *out_len = 10;
    } else if msg_kind == INTERP_MSG_UB_UNMAPPED || msg_kind == INTERP_MSG_UB_PTR_ARITH_UNMAPPED ||
              msg_kind == INTERP_MSG_UB_USIZE_AS_PTR || msg_kind == INTERP_MSG_UB_INVALID_PROVENANCE {
        *out_off = 27;
        *out_len = 18;
    } else if msg_kind == INTERP_MSG_UB_OOB || msg_kind == INTERP_MSG_UB_PTR_ARITH_OOB {
        *out_off = 45;
        *out_len = 13;
    } else if msg_kind == INTERP_MSG_UB_MISALIGNED {
        *out_off = 58;
        *out_len = 17;
    } else if msg_kind == INTERP_MSG_UB_UNINIT_READ {
        *out_off = 75;
        *out_len = 18;
    } else if msg_kind == INTERP_MSG_UB_WRITE_READONLY {
        *out_off = 93;
        *out_len = 17;
    } else if msg_kind == INTERP_MSG_UB_OVERLAPPING_COPY {
        *out_off = 110;
        *out_len = 16;
    } else if msg_kind == INTERP_MSG_UB_INVALID_FIXED_ADDR {
        *out_off = 126;
        *out_len = 18;
    } else if msg_kind == INTERP_MSG_UB_DATA_RACE || msg_kind == INTERP_MSG_UB_MIXED_ATOMIC ||
              msg_kind == INTERP_MSG_UB_ATOMIC_ORDER || msg_kind == INTERP_MSG_UB_ATOMIC_OVERLAP {
        *out_off = 144;
        *out_len = 9;
    }
}

pub fn interp_report_ub_sv(ctx: mut_view<InterpCtx>, msg: StrView) {
    interp_push_diag(mut_view(*ctx), AX_UNSAFE_INTERP_UB, ctx.current_span, msg);
    ctx.failed = true;
    ctx.exit_code = 125;
}

pub fn interp_report_ub(ctx: mut_view<InterpCtx>, msg_kind: u8) {
    let msg = interp_alloc_msg(mut_view(ctx.arena), msg_kind);
    let mut koff: usize = 0;
    let mut klen: usize = 0;
    interp_ub_kind_range(msg_kind, mut_view(koff), mut_view(klen));
    interp_push_diag_kind(mut_view(*ctx), AX_UNSAFE_INTERP_UB, ctx.current_span, msg, koff, klen);
    ctx.failed = true;
    ctx.exit_code = 125;
}

pub fn interp_panic_sv(ctx: mut_view<InterpCtx>, msg: StrView) {
    let dup = arena_alloc_raw(mut_view(ctx.arena), msg.len + 1, 1);
    if msg.len > 0 && (msg.ptr as usize) != 0 {
        unsafe {
            interp_copy_bytes(dup, msg.ptr, msg.len);
        }
    }
    unsafe {
        *(dup + msg.len) = 0u8;
    }
    ctx.panic_msg_ptr = dup as *const u8;
    ctx.panic_msg_len = msg.len;
    ctx.has_panicked = true;
    if ctx.is_comptime {
        if interp_msg_has_div_zero(ctx.panic_msg_ptr, ctx.panic_msg_len) {
            ctx.comptime_err_code = AX_CONST_DIV_ZERO as u16;
        } else if interp_msg_has_shift_range(ctx.panic_msg_ptr, ctx.panic_msg_len) {
            // T483: the MIR shift guard (assert "shift amount out of range") fails in const eval of blocks/aggregates.
            ctx.comptime_err_code = AX_CONST_SHIFT_RANGE as u16;
        } else {
            ctx.comptime_err_code = AX_CONST_OVERFLOW as u16;
        }
        ctx.comptime_err_msg.ptr = ctx.panic_msg_ptr;
        ctx.comptime_err_msg.len = ctx.panic_msg_len;
        ctx.comptime_err_span = ctx.current_span;
    }
    ctx.failed = true;
    ctx.exit_code = 101;
}

pub fn interp_panic(ctx: mut_view<InterpCtx>, msg_kind: u8) {
    let msg = interp_alloc_msg(mut_view(ctx.arena), msg_kind);
    interp_panic_sv(mut_view(*ctx), msg);
    if ctx.is_comptime && msg_kind == INTERP_MSG_PANIC_SHIFT_RANGE {
        // T483 (SPEC-40 AXS-INT-005): a constant shift with a count outside 0 .. T.BITS - 1.
        ctx.comptime_err_code = AX_CONST_SHIFT_RANGE as u16;
    }
}

pub fn interp_check_step_limit(ctx: mut_view<InterpCtx>) {
    if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
        if ctx.is_comptime {
            let msg = interp_alloc_msg(mut_view(ctx.arena), INTERP_MSG_LIMIT_COMPTIME_STEP);
            ctx.comptime_err_code = AX_CONST_EVAL_LIMIT as u16;
            ctx.comptime_err_msg = msg;
            ctx.comptime_err_span = ctx.current_span;
        } else {
            let msg = interp_alloc_msg(mut_view(ctx.arena), INTERP_MSG_LIMIT_STEP);
            interp_push_diag(mut_view(*ctx), AX_DRIVER_INTERP_STEP_LIMIT, ctx.current_span, msg);
        }
        ctx.failed = true;
        ctx.exit_code = 124;
    }
}

pub fn interp_report_stack_limit(ctx: mut_view<InterpCtx>) {
    let msg = interp_alloc_msg(mut_view(ctx.arena), INTERP_MSG_LIMIT_STACK);
    interp_push_diag(mut_view(*ctx), AX_DRIVER_INTERP_STACK_LIMIT, ctx.current_span, msg);
    ctx.failed = true;
    ctx.exit_code = 124;
}

pub fn interp_report_ffi_not_in_oracle(ctx: mut_view<InterpCtx>, span: Span) {
    let msg = interp_alloc_msg(mut_view(ctx.arena), INTERP_MSG_FFI_NOT_IN_ORACLE);
    interp_push_diag(mut_view(*ctx), AX_FFI_NOT_IN_ORACLE, span, msg);
    ctx.failed = true;
    ctx.exit_code = 1;
}

// =================================================================================================
// Allocation Table & Pointer Validation
// =================================================================================================

pub fn interp_register_alloc(
    ctx: mut_view<InterpCtx>,
    host_ptr: *mut u8,
    size: u64,
    align: u32,
    call_depth: i32
) -> *mut InterpAlloc {
    ctx.ub_last_alloc = 0 as *mut InterpAlloc;
    if ctx.alloc_count >= ctx.alloc_cap {
        let new_cap: usize = if ctx.alloc_cap == 0 { 64 } else { interp_mul_usize(ctx.alloc_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<InterpAlloc>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<InterpAlloc>()) as *mut InterpAlloc };
        unsafe {
            interp_zero_bytes(new_arr as *mut u8, new_bytes);
        }
        if ctx.alloc_count > 0 && (ctx.allocs as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.alloc_count, size_of<InterpAlloc>());
            let old_cap_bytes = interp_mul_usize(ctx.alloc_cap, size_of<InterpAlloc>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(ctx.allocs as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(ctx.allocs as *mut u8, old_cap_bytes, align_of<InterpAlloc>());
            }
        }
        ctx.allocs = new_arr;
        ctx.alloc_cap = new_cap;
    }

    let idx = ctx.alloc_count;
    ctx.alloc_count = idx + 1;
    let a = unsafe { interp_alloc_at(ctx.allocs, idx) };
    let eff_align: u64 = if align > 16u32 { align as u64 } else { 16u64 };
    let mask: u64 = eff_align - 1u64;
    let base: u64 = (ctx.next_synth_addr + mask) & (0xFFFFFFFFFFFFFFFFu64 ^ mask);
    let padded_size: u64 = (size + 15u64) & (0xFFFFFFFFFFFFFFFFu64 ^ 15u64);

    unsafe {
        (*a).alloc_id = 0u32;
        (*a).base_addr = base;
        (*a).size = size;
        (*a).align = if align != 0u32 { align } else { 1u32 };
        (*a).host_ptr = host_ptr;
        (*a).is_live = true;
        (*a).call_depth = call_depth;
        (*a).init = 0 as *mut u8;
        (*a).perm = INTERP_PERM_RW;
    }
    ctx.next_synth_addr = base + padded_size + 16u64;
    a
}

pub fn interp_validate_raw_ptr(
    ctx: mut_view<InterpCtx>,
    addr: u64,
    size: u64,
    align: u32
) -> *mut u8 {
    if addr == 0u64 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_NULL_DEREF);
        return ctx.dummy_ptr;
    }
    if align > 1u32 && (addr % (align as u64)) != 0u64 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_MISALIGNED);
        return ctx.dummy_ptr;
    }

    let mut found: *mut InterpAlloc = 0 as *mut InterpAlloc;
    if addr >= INTERP_SYNTH_BASE_RUNTIME && addr < ctx.next_synth_addr {
        let mut lo: usize = 0;
        let mut hi: usize = ctx.alloc_count;
        while lo < hi {
            let mid = lo + ((hi - lo) / 2);
            let a = unsafe { interp_alloc_at(ctx.allocs, mid) };
            let base = unsafe { (*a).base_addr };
            let asz = unsafe { (*a).size };
            if addr < base {
                hi = mid;
            } else if addr >= base + asz + 16u64 {
                lo = mid + 1;
            } else {
                found = a;
                break;
            }
        }
    } else {
        // T502: a region bound by `@addr(A)` / `@at(A)` (SPEC-50 AXS-UNS-025 `FixedAddrMap`).
        found = interp_find_fixed(view(*ctx), addr, false);
    }
    if (found as usize) == 0 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_UNMAPPED);
        return ctx.dummy_ptr;
    }
    let is_live = unsafe { (*found).is_live };
    if !is_live {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DANGLING);
        return ctx.dummy_ptr;
    }
    let base = unsafe { (*found).base_addr };
    let asz = unsafe { (*found).size };
    if addr + size > base + asz {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_OOB);
        return ctx.dummy_ptr;
    }
    let off = (addr - base) as usize;
    ctx.ub_last_alloc = found;
    if (unsafe { (*found).init } as usize) != 0 && !ctx.ub_load_ctx && size > 0u64 {
        // A raw access that is not a typed load may write: the bytes count as initialised afterwards (never a false UB).
        unsafe {
            interp_alloc_mark_init(found, off, size as usize);
        }
    }
    unsafe { (*found).host_ptr + off }
}

// =================================================================================================
// T502: fixed-address regions, byte initialisation shadow & permission checks
// =================================================================================================

/// The `@addr` region containing `addr` (`base <= addr < base + size`; with `incl_end` also the one-past-the-end address).
pub fn interp_find_fixed(ctx: view<InterpCtx>, addr: u64, incl_end: bool) -> *mut InterpAlloc {
    let mut i: usize = 0;
    while i < ctx.fixed_count {
        let a = unsafe { interp_alloc_at(ctx.fixed, i) };
        let base = unsafe { (*a).base_addr };
        let asz = unsafe { (*a).size };
        if (unsafe { (*a).is_live }) && addr >= base && addr < base + asz {
            return a;
        }
        i = i + 1;
    }
    if incl_end {
        i = 0;
        while i < ctx.fixed_count {
            let a = unsafe { interp_alloc_at(ctx.fixed, i) };
            let base = unsafe { (*a).base_addr };
            let asz = unsafe { (*a).size };
            if (unsafe { (*a).is_live }) && addr == base + asz {
                return a;
            }
            i = i + 1;
        }
    }
    0 as *mut InterpAlloc
}

/// Maps the region `[addr, addr + size)` on demand (zero-filled backing store, no host OS access). A region contained in an
/// existing one reuses it (overlays of one address); a partial overlap, an address in the synthetic range or `addr == 0` is
/// rejected with a null result (UB-12 `invalid_fixed_addr`).
pub fn interp_register_fixed(ctx: mut_view<InterpCtx>, addr: u64, size: u64) -> *mut InterpAlloc {
    let sz: u64 = if size == 0u64 { 1u64 } else { size };
    if addr == 0u64 || addr >= INTERP_SYNTH_BASE_RUNTIME || addr + sz < addr {
        return 0 as *mut InterpAlloc;
    }
    let mut i: usize = 0;
    while i < ctx.fixed_count {
        let a = unsafe { interp_alloc_at(ctx.fixed, i) };
        let base = unsafe { (*a).base_addr };
        let end = base + unsafe { (*a).size };
        if addr >= base && addr + sz <= end {
            return a;
        }
        if addr < end && addr + sz > base {
            return 0 as *mut InterpAlloc;
        }
        i = i + 1;
    }
    ctx.ub_last_alloc = 0 as *mut InterpAlloc;
    if ctx.fixed_count >= ctx.fixed_cap {
        let new_cap: usize = if ctx.fixed_cap == 0 { 8 } else { interp_mul_usize(ctx.fixed_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<InterpAlloc>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<InterpAlloc>()) as *mut InterpAlloc };
        unsafe {
            interp_zero_bytes(new_arr as *mut u8, new_bytes);
        }
        if ctx.fixed_count > 0 && (ctx.fixed as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.fixed_count, size_of<InterpAlloc>());
            let old_cap_bytes = interp_mul_usize(ctx.fixed_cap, size_of<InterpAlloc>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(ctx.fixed as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(ctx.fixed as *mut u8, old_cap_bytes, align_of<InterpAlloc>());
            }
        }
        ctx.fixed = new_arr;
        ctx.fixed_cap = new_cap;
    }
    let backing: usize = if sz < 16u64 { 16 } else { sz as usize };
    let mem = unsafe { heap_alloc(backing, 16) };
    unsafe {
        interp_zero_bytes(mem, backing);
    }
    let idx = ctx.fixed_count;
    ctx.fixed_count = idx + 1;
    let a = unsafe { interp_alloc_at(ctx.fixed, idx) };
    unsafe {
        (*a).alloc_id = 0u32;
        (*a).base_addr = addr;
        (*a).size = sz;
        (*a).align = 1u32;
        (*a).host_ptr = mem;
        (*a).is_live = true;
        (*a).call_depth = -2;
        (*a).init = 0 as *mut u8;
        (*a).perm = INTERP_PERM_RW;
    }
    a
}

/// Starts tracking the initialisation state of a heap block (every byte uninitialised).
pub unsafe fn interp_alloc_track_init(a: *mut InterpAlloc) {
    let sz = (*a).size as usize;
    let bytes: usize = if sz < 16 { 16 } else { sz };
    let sh = heap_alloc(bytes, 16);
    interp_zero_bytes(sh, bytes);
    (*a).init = sh;
}

/// Stops tracking a block (freed, resized or reached through a `view`): all of its bytes count as initialised.
pub unsafe fn interp_alloc_drop_shadow(a: *mut InterpAlloc) {
    let sh = (*a).init;
    if (sh as usize) == 0 {
        return;
    }
    let sz = (*a).size as usize;
    let bytes: usize = if sz < 16 { 16 } else { sz };
    heap_free(sh, bytes, 16);
    (*a).init = 0 as *mut u8;
}

pub unsafe fn interp_alloc_mark_init(a: *mut InterpAlloc, off: usize, n: usize) {
    let sh = (*a).init;
    let total = (*a).size as usize;
    if (sh as usize) == 0 || off >= total || n == 0 {
        return;
    }
    let mut end = off + n;
    if end > total {
        end = total;
    }
    interp_fill_bytes(sh + off, 1u8, end - off);
}

/// UB-04: a typed load of `size` bytes at host address `host` from the block the last raw-pointer validation resolved into.
pub fn interp_check_init_read(ctx: mut_view<InterpCtx>, host: *const u8, size: u32) {
    let a = ctx.ub_last_alloc;
    if (a as usize) == 0 || size == 0u32 {
        return;
    }
    let sh = unsafe { (*a).init };
    if (sh as usize) == 0 || !(unsafe { (*a).is_live }) {
        return;
    }
    let hp = unsafe { (*a).host_ptr as usize };
    let sz = unsafe { (*a).size as usize };
    let h = host as usize;
    if hp == 0 || h < hp || h + (size as usize) > hp + sz {
        return;
    }
    let off = h - hp;
    let mut i: usize = 0;
    while i < (size as usize) {
        if (unsafe { *(sh + off + i) }) == 0u8 {
            interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_UNINIT_READ);
            return;
        }
        i = i + 1;
    }
}

/// UB-07: a store at host address `host` into a read-only block (constant pool, string literal).
pub fn interp_check_write_perm(ctx: mut_view<InterpCtx>, host: *const u8) {
    let a = ctx.ub_last_alloc;
    if (a as usize) == 0 || (unsafe { (*a).perm }) != INTERP_PERM_READONLY || !(unsafe { (*a).is_live }) {
        return;
    }
    let hp = unsafe { (*a).host_ptr as usize };
    let sz = unsafe { (*a).size as usize };
    let h = host as usize;
    if hp == 0 || h < hp || h >= hp + sz {
        return;
    }
    interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_WRITE_READONLY);
}

pub fn interp_resolve_synth_ptr(ctx: mut_view<InterpCtx>, addr: u64) -> *mut u8 {
    if addr == 0u64 {
        return ctx.dummy_ptr;
    }
    if addr < INTERP_SYNTH_BASE_RUNTIME || addr >= ctx.next_synth_addr {
        return (addr as usize) as *mut u8;
    }
    let mut lo: usize = 0;
    let mut hi: usize = ctx.alloc_count;
    while lo < hi {
        let mid = lo + ((hi - lo) / 2);
        let a = unsafe { interp_alloc_at(ctx.allocs, mid) };
        let base = unsafe { (*a).base_addr };
        let asz = unsafe { (*a).size };
        if addr < base {
            hi = mid;
        } else if addr > base + asz {
            lo = mid + 1;
        } else {
            let is_live = unsafe { (*a).is_live };
            if is_live {
                let off = (addr - base) as usize;
                if (unsafe { (*a).init } as usize) != 0 {
                    // T502: a `view` / `mut_view` reaches the block: its byte state is no longer tracked (never a false UB).
                    unsafe {
                        interp_alloc_drop_shadow(a);
                    }
                }
                return unsafe { (*a).host_ptr + off };
            }
            break;
        }
    }
    (addr as usize) as *mut u8
}

pub fn interp_validate_ptr_arith(ctx: mut_view<InterpCtx>, orig_addr: u64, new_addr: u64) {
    if orig_addr == 0u64 && new_addr == 0u64 {
        return;
    }
    let mut found: *mut InterpAlloc = 0 as *mut InterpAlloc;
    if orig_addr >= INTERP_SYNTH_BASE_RUNTIME && orig_addr < ctx.next_synth_addr {
        let mut lo: usize = 0;
        let mut hi: usize = ctx.alloc_count;
        while lo < hi {
            let mid = lo + ((hi - lo) / 2);
            let a = unsafe { interp_alloc_at(ctx.allocs, mid) };
            let base = unsafe { (*a).base_addr };
            let asz = unsafe { (*a).size };
            if orig_addr < base {
                hi = mid;
            } else if orig_addr > base + asz {
                lo = mid + 1;
            } else {
                let is_live = unsafe { (*a).is_live };
                if is_live {
                    found = a;
                }
                break;
            }
        }
    }
    if (found as usize) == 0 && (orig_addr < INTERP_SYNTH_BASE_RUNTIME || orig_addr >= ctx.next_synth_addr) {
        found = interp_find_fixed(view(*ctx), orig_addr, true);
    }
    if (found as usize) == 0 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_PTR_ARITH_UNMAPPED);
        return;
    }
    let base = unsafe { (*found).base_addr };
    let asz = unsafe { (*found).size };
    if new_addr < base || new_addr > base + asz {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_PTR_ARITH_OOB);
    }
}

pub fn interp_find_synth_addr(ctx: view<InterpCtx>, host_ptr: *const u8) -> u64 {
    let h_addr = host_ptr as usize;
    if h_addr == 0 {
        return 0u64;
    }
    let mut i: usize = ctx.alloc_count;
    while i > 0 {
        i = i - 1;
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let is_live = unsafe { (*a).is_live };
        let a_host = unsafe { (*a).host_ptr as usize };
        let a_size = unsafe { (*a).size as usize };
        if is_live && a_host != 0 && h_addr >= a_host && h_addr < a_host + a_size {
            unsafe {
                (*a).alloc_id = 1u32;
            }
            let off = (h_addr - a_host) as u64;
            let base = unsafe { (*a).base_addr };
            return base + off;
        }
    }
    i = ctx.alloc_count;
    while i > 0 {
        i = i - 1;
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let is_live = unsafe { (*a).is_live };
        let a_host = unsafe { (*a).host_ptr as usize };
        let a_size = unsafe { (*a).size as usize };
        if is_live && a_host != 0 && h_addr == a_host + a_size {
            unsafe {
                (*a).alloc_id = 1u32;
            }
            let base = unsafe { (*a).base_addr };
            let asz = unsafe { (*a).size };
            return base + asz;
        }
    }
    // T502: the backing store of an `@addr` region maps back to the region's fixed address.
    i = ctx.fixed_count;
    while i > 0 {
        i = i - 1;
        let a = unsafe { interp_alloc_at(ctx.fixed, i) };
        let a_host = unsafe { (*a).host_ptr as usize };
        let a_size = unsafe { (*a).size as usize };
        if (unsafe { (*a).is_live }) && a_host != 0 && h_addr >= a_host && h_addr <= a_host + a_size {
            return (unsafe { (*a).base_addr }) + ((h_addr - a_host) as u64);
        }
    }
    0u64
}

pub fn interp_ensure_const_str_alloc(
    ctx: mut_view<InterpCtx>,
    str_bytes: *const u8,
    str_len: usize
) -> u64 {
    let mut ptr: *mut u8 = str_bytes as *mut u8;
    if (ptr as usize) == 0 {
        ptr = arena_alloc_raw(mut_view(ctx.arena), 1, 1);
        unsafe {
            *ptr = 0u8;
        }
    }
    let target_host = ptr as usize;
    let min_sz: u64 = if str_len > 0 { str_len as u64 } else { 1u64 };
    let mut i: usize = 0;
    while i < ctx.alloc_count {
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let is_live = unsafe { (*a).is_live };
        let a_host = unsafe { (*a).host_ptr as usize };
        let a_sz = unsafe { (*a).size };
        if is_live && a_host == target_host && a_sz >= min_sz {
            return unsafe { (*a).base_addr };
        }
        i = i + 1;
    }
    let alloc_sz: u64 = (str_len + 1) as u64;
    let na = interp_register_alloc(mut_view(*ctx), ptr, alloc_sz, 1u32, 0);
    unsafe {
        (*na).perm = INTERP_PERM_READONLY;
    }
    unsafe { (*na).base_addr }
}

pub fn interp_register_const_allocs(ctx: mut_view<InterpCtx>) {
    if (ctx.thir as usize) == 0 {
        return;
    }
    let cap = unsafe { (*ctx.thir).symbol_consts.cap };
    let states = unsafe { (*ctx.thir).symbol_consts.states };
    let vals = unsafe { (*ctx.thir).symbol_consts.vals };
    let mut i: usize = 0;
    while i < cap {
        let st = unsafe { *(states + i) };
        if st == 1u8 {
            let off = interp_mul_usize(i, size_of<ConstValue>());
            let cv = ((vals as usize) + off) as *mut ConstValue;
            let kind = unsafe { (*cv).kind };
            let agg_data = unsafe { (*cv).agg_data };
            if kind == CONST_AGGREGATE && (agg_data as usize) != 0 {
                let agg_sz = unsafe { (*cv).agg_size as u64 };
                let agg_al = unsafe { (*cv).agg_align as u32 };
                let ca = interp_register_alloc(mut_view(*ctx), agg_data, agg_sz, agg_al, 0);
                unsafe {
                    (*ca).perm = INTERP_PERM_READONLY;
                }
            }
        }
        i = i + 1;
    }
}

// =================================================================================================
// Context Initialization & Teardown
// =================================================================================================

pub fn interp_ctx_init(
    ctx: mut_view<InterpCtx>,
    main_fn: *mut HirItem,
    thir: *mut Thir,
    hir: *const HirFile,
    interner: *mut StrInterner,
    rmap: *const ResolveMap,
    ast: *const Ast,
    db: *const SourceDatabase,
    sink: *mut DiagSink,
    mono_engine: *mut MonoEngine,
    step_limit: i32,
    call_depth_limit: i32,
    mir_map: *mut MirBodyMap,
    out_buf: *mut DiagBuffer,
    capture_stdout: bool
) {
    ctx.main_fn = main_fn;
    ctx.thir = thir;
    ctx.hir = hir;
    ctx.interner = interner;
    ctx.rmap = rmap;
    ctx.ast = ast;
    ctx.db = db;
    ctx.sink = sink;
    ctx.mono_engine = mono_engine;
    ctx.step_limit = step_limit;
    ctx.call_depth_limit = call_depth_limit;
    ctx.mir_map = mir_map;
    ctx.build_on_demand = true;
    ctx.steps = 0;
    ctx.call_depth = 0;
    let a = arena_with_chunk_size(65536);
    ctx.arena = a;
    ctx.failed = false;
    ctx.has_panicked = false;
    ctx.has_exited = false;
    ctx.exit_code = 0;
    ctx.panic_msg_ptr = 0 as *const u8;
    ctx.panic_msg_len = 0;
    ctx.out_buf = out_buf;
    ctx.capture_stdout = capture_stdout;
    let dummy = arena_alloc_raw(mut_view(ctx.arena), 64, 16);
    unsafe {
        interp_zero_bytes(dummy, 64);
    }
    ctx.dummy_ptr = dummy;
    ctx.allocs = 0 as *mut InterpAlloc;
    ctx.alloc_count = 0;
    ctx.alloc_cap = 0;
    ctx.fixed = 0 as *mut InterpAlloc;
    ctx.fixed_count = 0;
    ctx.fixed_cap = 0;
    ctx.ub_load_ctx = false;
    ctx.ub_last_alloc = 0 as *mut InterpAlloc;
    ctx.placement_spans = 0 as *mut Span;
    ctx.placement_count = 0;
    ctx.placement_cap = 0;
    ctx.placement_scanned = false;
    ctx.next_synth_addr = INTERP_SYNTH_BASE_RUNTIME;
    ctx.is_comptime = false;
    ctx.comptime_err_code = 0u16;
    ctx.comptime_err_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    ctx.comptime_err_msg = StrView { ptr: 0 as *const u8, len: 0 };
    ctx.current_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    ctx.val_hi = 0u64;
    ctx.val_ovf = false;
    ctx.rem_lo = 0u64;
    ctx.rem_hi = 0u64;
    ctx.host.args = 0 as *mut InterpHostArg;
    ctx.host.argc = 0;
    ctx.host.args_cap = 0;
    ctx.host.use_custom_args = false;
    ctx.host.open_fds = 0 as *mut i64;
    ctx.host.open_fds_len = 0;
    ctx.host.open_fds_cap = 0;
    ctx.host.open_dirs = 0 as *mut i64;
    ctx.host.open_dirs_len = 0;
    ctx.host.open_dirs_cap = 0;
    ctx.host.last_monotonic_ns = 0u64;
    ctx.oracle.current_tid = 0u32;
    ctx.oracle.has_concurrent_threads = false;
    ctx.oracle.active_thread_mask = 0u32;
    let mut ti: usize = 0;
    while ti < INTERP_MAX_THREADS {
        let mut tj: usize = 0;
        while tj < INTERP_MAX_THREADS {
            ctx.oracle.clock[ti].v[tj] = 0u64;
            ctx.oracle.acq_fence_clock[ti].v[tj] = 0u64;
            ctx.oracle.rel_fence_clock[ti].v[tj] = 0u64;
            tj = tj + 1;
        }
        ctx.oracle.fork_clock.v[ti] = 0u64;
        ctx.oracle.seq_cst_fence_clock.v[ti] = 0u64;
        ctx.oracle.last_thread_callee[ti] = 0;
        ti = ti + 1;
    }
    ctx.oracle.clock[0].v[0] = 1u64;
    ctx.oracle.fork_clock.v[0] = 1u64;
    ctx.oracle.seq_cst_tick = 0u64;
    ctx.oracle.prng_state = 0x9E3779B97F4A7C15u64;
    ctx.oracle.schedule_seed = 0u64;
    ctx.oracle.schedule_run_counter = 0u64;
    ctx.oracle.atomic_locs = 0 as *mut InterpAtomicLoc;
    ctx.oracle.atomic_loc_len = 0;
    ctx.oracle.atomic_loc_cap = 0;
    ctx.oracle.ord_accesses = 0 as *mut InterpOrdAccess;
    ctx.oracle.ord_access_len = 0;
    ctx.oracle.ord_access_cap = 0;
    ctx.oracle.current_frame_storage = 0 as *mut u8;
    ctx.oracle.current_frame_storage_size = 0;
    ctx.oracle.next_fut_id = 1u64;
    ctx.oracle.async_futs = 0 as *mut InterpAsyncFut;
    ctx.oracle.async_fut_len = 0;
    ctx.oracle.async_fut_cap = 0;
}

pub fn interp_ctx_alloc_zeroed() -> *mut InterpCtx {
    let sz = size_of<InterpCtx>();
    let al = align_of<InterpCtx>();
    let p = unsafe { heap_alloc(sz, al) as *mut InterpCtx };
    unsafe {
        interp_zero_bytes(p as *mut u8, sz);
    }
    p
}

pub fn interp_ctx_dealloc(ctx_ptr: *mut InterpCtx) {
    if (ctx_ptr as usize) != 0 {
        unsafe {
            heap_free(ctx_ptr as *mut u8, size_of<InterpCtx>(), align_of<InterpCtx>());
        }
    }
}

pub fn interp_ctx_free_allocs(ctx: mut_view<InterpCtx>) {
    if (ctx.oracle.atomic_locs as usize) != 0 {
        let mut ai: usize = 0;
        while ai < ctx.oracle.atomic_loc_len {
            let loc = unsafe { interp_atomic_loc_at(ctx.oracle.atomic_locs, ai) };
            let wptr = unsafe { (*loc).writes };
            let wcap = unsafe { (*loc).write_cap };
            if (wptr as usize) != 0 && wcap > 0 {
                let wbytes = interp_mul_usize(wcap, size_of<InterpAtomicWrite>());
                unsafe {
                    heap_free(wptr as *mut u8, wbytes, align_of<InterpAtomicWrite>());
                    (*loc).writes = 0 as *mut InterpAtomicWrite;
                    (*loc).write_cap = 0;
                }
            }
            ai = ai + 1;
        }
        if ctx.oracle.atomic_loc_cap > 0 {
            let lbytes = interp_mul_usize(ctx.oracle.atomic_loc_cap, size_of<InterpAtomicLoc>());
            unsafe {
                heap_free(ctx.oracle.atomic_locs as *mut u8, lbytes, align_of<InterpAtomicLoc>());
            }
        }
        ctx.oracle.atomic_locs = 0 as *mut InterpAtomicLoc;
        ctx.oracle.atomic_loc_len = 0;
        ctx.oracle.atomic_loc_cap = 0;
    }
    if (ctx.oracle.ord_accesses as usize) != 0 {
        if ctx.oracle.ord_access_cap > 0 {
            let obytes = interp_mul_usize(ctx.oracle.ord_access_cap, size_of<InterpOrdAccess>());
            unsafe {
                heap_free(ctx.oracle.ord_accesses as *mut u8, obytes, align_of<InterpOrdAccess>());
            }
        }
        ctx.oracle.ord_accesses = 0 as *mut InterpOrdAccess;
        ctx.oracle.ord_access_len = 0;
        ctx.oracle.ord_access_cap = 0;
    }
    if (ctx.oracle.async_futs as usize) != 0 {
        if ctx.oracle.async_fut_cap > 0 {
            let abytes = interp_mul_usize(ctx.oracle.async_fut_cap, size_of<InterpAsyncFut>());
            unsafe {
                heap_free(ctx.oracle.async_futs as *mut u8, abytes, align_of<InterpAsyncFut>());
            }
        }
        ctx.oracle.async_futs = 0 as *mut InterpAsyncFut;
        ctx.oracle.async_fut_len = 0;
        ctx.oracle.async_fut_cap = 0;
    }
    if (ctx.allocs as usize) != 0 {
        let mut i: usize = 0;
        while i < ctx.alloc_count {
            let a = unsafe { interp_alloc_at(ctx.allocs, i) };
            let depth = unsafe { (*a).call_depth };
            let hptr = unsafe { (*a).host_ptr };
            let sz = unsafe { (*a).size as usize };
            if depth == -1 && (hptr as usize) != 0 {
                let alloc_bytes = if sz < 16 { 16 } else { sz };
                unsafe {
                    heap_free(hptr, alloc_bytes, 16);
                    (*a).host_ptr = 0 as *mut u8;
                    (*a).is_live = false;
                }
            }
            unsafe {
                interp_alloc_drop_shadow(a);
            }
            i = i + 1;
        }
        let cap_bytes = interp_mul_usize(ctx.alloc_cap, size_of<InterpAlloc>());
        unsafe {
            heap_free(ctx.allocs as *mut u8, cap_bytes, align_of<InterpAlloc>());
        }
        ctx.allocs = 0 as *mut InterpAlloc;
        ctx.alloc_count = 0;
        ctx.alloc_cap = 0;
    }
    if (ctx.fixed as usize) != 0 {
        // T502: backing stores of the `@addr` regions.
        let mut fi: usize = 0;
        while fi < ctx.fixed_count {
            let fa = unsafe { interp_alloc_at(ctx.fixed, fi) };
            let fhp = unsafe { (*fa).host_ptr };
            let fsz = unsafe { (*fa).size as usize };
            if (fhp as usize) != 0 {
                let fbytes = if fsz < 16 { 16 } else { fsz };
                unsafe {
                    heap_free(fhp, fbytes, 16);
                    (*fa).host_ptr = 0 as *mut u8;
                }
            }
            fi = fi + 1;
        }
        let fcap_bytes = interp_mul_usize(ctx.fixed_cap, size_of<InterpAlloc>());
        unsafe {
            heap_free(ctx.fixed as *mut u8, fcap_bytes, align_of<InterpAlloc>());
        }
        ctx.fixed = 0 as *mut InterpAlloc;
        ctx.fixed_count = 0;
        ctx.fixed_cap = 0;
    }
    ctx.ub_last_alloc = 0 as *mut InterpAlloc;
}

// =================================================================================================
// T458: bit-exact IEEE-754 binary32/binary64 soft-float (SPEC-41 AXS-FLT-010..025)
//
// The oracle evaluates every f32/f64 operation on raw bit patterns with integer arithmetic only (axiom0
// has no floating point and the result must not depend on the host FPU). Values are raw bit patterns in
// a u64 (an f32 occupies the low 32 bits). Rounding is roundTiesToEven; subnormals are exact (no FTZ/DAZ).
// A fresh NaN is the canonical positive quiet NaN (AXS-FLT-002); sign flips (neg, abs, copysign) and
// bitcasts keep every payload bit.
// =================================================================================================

const SF_K_ZERO: u8 = 0u8;
const SF_K_FINITE: u8 = 1u8;
const SF_K_INF: u8 = 2u8;
const SF_K_NAN: u8 = 3u8;
const SF_ALL: u64 = 0xFFFFFFFFFFFFFFFFu64;

// Intrinsic kinds returned by `sf_intrinsic_kind` (names match `op` or `op_<suffix>`).
pub const SF_I_NONE: u32 = 0u32;
pub const SF_I_ROUND_TIES_EVEN: u32 = 1u32;
pub const SF_I_NEXT_DOWN: u32 = 2u32;
pub const SF_I_FROM_BITS: u32 = 3u32;
pub const SF_I_COPYSIGN: u32 = 4u32;
pub const SF_I_NEXT_UP: u32 = 5u32;
pub const SF_I_TO_BITS: u32 = 6u32;
pub const SF_I_FLOOR: u32 = 7u32;
pub const SF_I_ROUND: u32 = 8u32;
pub const SF_I_TRUNC: u32 = 9u32;
pub const SF_I_SQRT: u32 = 10u32;
pub const SF_I_CEIL: u32 = 11u32;
pub const SF_I_ABS: u32 = 12u32;
pub const SF_I_FMA: u32 = 13u32;
pub const SF_I_MIN: u32 = 14u32;
pub const SF_I_MAX: u32 = 15u32;

const SF_NAME_BYTES: [90]u8 = [
    // "round_ties_even" (0..15)
    114u8, 111u8, 117u8, 110u8, 100u8, 95u8, 116u8, 105u8, 101u8, 115u8, 95u8, 101u8, 118u8, 101u8, 110u8,
    // "next_down" (15..24)
    110u8, 101u8, 120u8, 116u8, 95u8, 100u8, 111u8, 119u8, 110u8,
    // "from_bits" (24..33)
    102u8, 114u8, 111u8, 109u8, 95u8, 98u8, 105u8, 116u8, 115u8,
    // "copysign" (33..41)
    99u8, 111u8, 112u8, 121u8, 115u8, 105u8, 103u8, 110u8,
    // "next_up" (41..48)
    110u8, 101u8, 120u8, 116u8, 95u8, 117u8, 112u8,
    // "to_bits" (48..55)
    116u8, 111u8, 95u8, 98u8, 105u8, 116u8, 115u8,
    // "floor" (55..60)
    102u8, 108u8, 111u8, 111u8, 114u8,
    // "round" (60..65)
    114u8, 111u8, 117u8, 110u8, 100u8,
    // "trunc" (65..70)
    116u8, 114u8, 117u8, 110u8, 99u8,
    // "sqrt" (70..74)
    115u8, 113u8, 114u8, 116u8,
    // "ceil" (74..78)
    99u8, 101u8, 105u8, 108u8,
    // "abs" (78..81)
    97u8, 98u8, 115u8,
    // "fma" (81..84)
    102u8, 109u8, 97u8,
    // "min" (84..87)
    109u8, 105u8, 110u8,
    // "max" (87..90)
    109u8, 97u8, 120u8,
];
const SF_NAME_OFF: [15]u8 = [0u8, 15u8, 24u8, 33u8, 41u8, 48u8, 55u8, 60u8, 65u8, 70u8, 74u8, 78u8, 81u8, 84u8, 87u8];
const SF_NAME_LEN: [15]u8 = [15u8, 9u8, 9u8, 8u8, 7u8, 7u8, 5u8, 5u8, 5u8, 4u8, 4u8, 3u8, 3u8, 3u8, 3u8];

// Maps an intrinsic function name (`sqrt`, `sqrt_f64`, ...) to its SF_I_* kind; 0 when it is not a float intrinsic.
pub fn sf_intrinsic_kind(name: view<StrView>) -> u32 {
    if (name.ptr as usize) == 0 {
        return SF_I_NONE;
    }
    let mut k: usize = 0;
    while k < 15 {
        let off = SF_NAME_OFF[k] as usize;
        let n = SF_NAME_LEN[k] as usize;
        if name.len >= n && (name.len == n || unsafe { *(name.ptr + n) } == 95u8) {
            let mut i: usize = 0;
            let mut same = true;
            while i < n {
                if (unsafe { *(name.ptr + i) }) != SF_NAME_BYTES[off + i] {
                    same = false;
                    break;
                }
                i = i + 1;
            }
            if same {
                return (k as u32) + 1u32;
            }
        }
        k = k + 1;
    }
    SF_I_NONE
}

fn sf_sign_mask(is32: bool) -> u64 {
    if is32 { 0x80000000u64 } else { 0x8000000000000000u64 }
}

fn sf_inf_bits(is32: bool) -> u64 {
    if is32 { 0x7F800000u64 } else { 0x7FF0000000000000u64 }
}

fn sf_qnan(is32: bool) -> u64 {
    if is32 { 0x7FC00000u64 } else { 0x7FF8000000000000u64 }
}

fn sf_word_mask(is32: bool) -> u64 {
    if is32 { 0xFFFFFFFFu64 } else { SF_ALL }
}

fn sf_with_sign(is32: bool, sign: u64, mag: u64) -> u64 {
    if sign != 0u64 { mag | sf_sign_mask(is32) } else { mag }
}

fn sf_wadd(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let sum_hi = (a_hi + b_hi + carry) & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}

fn sf_wsub(a: u64, b: u64) -> u64 {
    sf_wadd(a, sf_wadd(b ^ SF_ALL, 1u64))
}

fn sf_clz64(val: u64) -> i32 {
    if val == 0u64 {
        return 64;
    }
    let mut n: i32 = 0;
    let mut v = val;
    if (v >> 32u64) == 0u64 {
        n = n + 32;
        v = v << 32u64;
    }
    if (v >> 48u64) == 0u64 {
        n = n + 16;
        v = v << 16u64;
    }
    if (v >> 56u64) == 0u64 {
        n = n + 8;
        v = v << 8u64;
    }
    if (v >> 60u64) == 0u64 {
        n = n + 4;
        v = v << 4u64;
    }
    if (v >> 62u64) == 0u64 {
        n = n + 2;
        v = v << 2u64;
    }
    if (v >> 63u64) == 0u64 {
        n = n + 1;
    }
    n
}

// Right shift that ORs every bit shifted out into the lsb ("jamming"), so a later rounding sees the sticky bit.
fn sf_shr_jam64(v: u64, n: i32) -> u64 {
    if n <= 0 {
        return v;
    }
    if n >= 64 {
        if v != 0u64 {
            return 1u64;
        }
        return 0u64;
    }
    let sh = n as u64;
    let lost = v & ((1u64 << sh) - 1u64);
    let mut r = v >> sh;
    if lost != 0u64 {
        r = r | 1u64;
    }
    r
}

fn sf_shr_jam128(hi: u64, lo: u64, n: i32, out_hi: mut_view<u64>, out_lo: mut_view<u64>) {
    if n <= 0 {
        *out_hi = hi;
        *out_lo = lo;
        return;
    }
    if n >= 128 {
        *out_hi = 0u64;
        *out_lo = if (hi | lo) != 0u64 { 1u64 } else { 0u64 };
        return;
    }
    if n >= 64 {
        let k = n - 64;
        let mut nlo: u64 = hi;
        let mut lost: u64 = lo;
        if k > 0 {
            let ku = k as u64;
            lost = lost | (hi & ((1u64 << ku) - 1u64));
            nlo = hi >> ku;
        }
        if lost != 0u64 {
            nlo = nlo | 1u64;
        }
        *out_hi = 0u64;
        *out_lo = nlo;
        return;
    }
    let s = n as u64;
    let lost = lo & ((1u64 << s) - 1u64);
    let mut nlo = (lo >> s) | (hi << (64u64 - s));
    if lost != 0u64 {
        nlo = nlo | 1u64;
    }
    *out_hi = hi >> s;
    *out_lo = nlo;
}

fn sf_mul_wide(a: u64, b: u64, out_hi: mut_view<u64>) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let p0 = a_lo * b_lo;
    let p1 = a_lo * b_hi;
    let p2 = a_hi * b_lo;
    let p3 = a_hi * b_hi;
    let mid1 = p1 + ((p0 >> 32u64) & 0xFFFFFFFFu64);
    let mid2 = p2 + (mid1 & 0xFFFFFFFFu64);
    *out_hi = p3 + ((mid1 >> 32u64) & 0xFFFFFFFFu64) + ((mid2 >> 32u64) & 0xFFFFFFFFu64);
    (p0 & 0xFFFFFFFFu64) | ((mid2 & 0xFFFFFFFFu64) << 32u64)
}

// Shifts the 128-bit value left until its msb is bit 127; returns the new high word, sets the low word and the shift.
fn sf_norm128(hi_in: u64, lo_in: u64, out_lo: mut_view<u64>, out_sh: mut_view<i32>) -> u64 {
    let mut hi = hi_in;
    let mut lo = lo_in;
    let mut sh: i32 = 0;
    if hi != 0u64 {
        let k = sf_clz64(hi);
        if k > 0 {
            let ku = k as u64;
            hi = (hi << ku) | (lo >> (64u64 - ku));
            lo = lo << ku;
        }
        sh = k;
    } else if lo != 0u64 {
        let k = sf_clz64(lo);
        hi = lo << (k as u64);
        lo = 0u64;
        sh = 64 + k;
    }
    *out_lo = lo;
    *out_sh = sh;
    hi
}

// kind: ZERO / FINITE / INF / NAN. A finite non-zero value is m * 2^e (m an integer, subnormals included).
fn sf_unpack(is32: bool, bits_in: u64, out_sign: mut_view<u64>, out_e: mut_view<i32>, out_m: mut_view<u64>) -> u8 {
    let bits = bits_in & sf_word_mask(is32);
    let mut sign: u64 = bits >> 63u64;
    let mut ef: u64 = (bits >> 52u64) & 0x7FFu64;
    let mut fr: u64 = bits & 0xFFFFFFFFFFFFFu64;
    let mut ef_max: u64 = 2047u64;
    let mut hidden: u64 = 0x10000000000000u64;
    let mut bias_p: i32 = 1075;
    if is32 {
        sign = (bits >> 31u64) & 1u64;
        ef = (bits >> 23u64) & 0xFFu64;
        fr = bits & 0x7FFFFFu64;
        ef_max = 255u64;
        hidden = 0x800000u64;
        bias_p = 150;
    }
    *out_sign = sign;
    *out_e = 0;
    *out_m = 0u64;
    if ef == ef_max {
        if fr == 0u64 {
            return SF_K_INF;
        }
        return SF_K_NAN;
    }
    if ef == 0u64 {
        if fr == 0u64 {
            return SF_K_ZERO;
        }
        *out_m = fr;
        *out_e = 1 - bias_p;
        return SF_K_FINITE;
    }
    *out_m = fr | hidden;
    *out_e = (ef as i32) - bias_p;
    SF_K_FINITE
}

// Rounds (-1)^sign * (m + epsilon) * 2^e to the target format (roundTiesToEven) and packs it. `m` is any
// non-zero 64-bit significand; `sticky` says the exact value exceeds m*2^e by less than one lsb of m.
fn sf_round_pack(is32: bool, sign: u64, e_in: i32, m_in: u64, sticky_in: bool) -> u64 {
    let sbits = if sign != 0u64 { sf_sign_mask(is32) } else { 0u64 };
    if m_in == 0u64 {
        return sbits;
    }
    let mut p: i32 = 53;
    let mut emin: i32 = -1022;
    let mut emax: i32 = 1023;
    if is32 {
        p = 24;
        emin = -126;
        emax = 127;
    }
    let inf_bits = sf_inf_bits(is32);
    let lz = sf_clz64(m_in);
    let m = m_in << (lz as u64);
    let big_e = e_in - lz + 63;
    if big_e > emax {
        return sbits | inf_bits;
    }
    let mut keep: i32 = p;
    if big_e < emin {
        keep = p - (emin - big_e);
    }
    let mut q: u64 = 0u64;
    let mut up = false;
    if keep >= 1 {
        let drop = (64 - keep) as u64;
        q = m >> drop;
        let rem = m & ((1u64 << drop) - 1u64);
        let half = 1u64 << (drop - 1u64);
        if rem > half {
            up = true;
        } else if rem == half {
            if sticky_in || (q & 1u64) != 0u64 {
                up = true;
            }
        }
    } else if keep == 0 {
        if (m & 0x7FFFFFFFFFFFFFFFu64) != 0u64 || sticky_in {
            up = true;
        }
    } else {
        return sbits;
    }
    if up {
        q = q + 1u64;
    }
    let mut res: u64 = q;
    if big_e >= emin {
        res = (((big_e - emin) as u64) << ((p - 1) as u64)) + q;
    }
    if res >= inf_bits {
        res = inf_bits;
    }
    sbits | res
}

fn sf_add(is32: bool, a_in: u64, b_in: u64) -> u64 {
    let a = a_in & sf_word_mask(is32);
    let b = b_in & sf_word_mask(is32);
    let mut sa: u64 = 0u64;
    let mut ea: i32 = 0;
    let mut ma: u64 = 0u64;
    let mut sb: u64 = 0u64;
    let mut eb: i32 = 0;
    let mut mb: u64 = 0u64;
    let ka = sf_unpack(is32, a, mut_view(sa), mut_view(ea), mut_view(ma));
    let kb = sf_unpack(is32, b, mut_view(sb), mut_view(eb), mut_view(mb));
    if ka == SF_K_NAN || kb == SF_K_NAN {
        return sf_qnan(is32);
    }
    if ka == SF_K_INF {
        if kb == SF_K_INF && sa != sb {
            return sf_qnan(is32);
        }
        return a;
    }
    if kb == SF_K_INF {
        return b;
    }
    if ka == SF_K_ZERO && kb == SF_K_ZERO {
        if sa == sb {
            return a;
        }
        return 0u64;
    }
    if ka == SF_K_ZERO {
        return b;
    }
    if kb == SF_K_ZERO {
        return a;
    }
    // Both finite and non-zero: normalise the significands to msb = bit 62 and align by exponent.
    let lza = sf_clz64(ma) - 1;
    let lzb = sf_clz64(mb) - 1;
    let na = ma << (lza as u64);
    let nb = mb << (lzb as u64);
    let nea = ea - lza;
    let neb = eb - lzb;
    let mut xs = sa;
    let mut xe = nea;
    let mut xm = na;
    let mut ys = sb;
    let mut ye = neb;
    let mut ym = nb;
    if neb > nea || (neb == nea && nb > na) {
        xs = sb;
        xe = neb;
        xm = nb;
        ys = sa;
        ye = nea;
        ym = na;
    }
    let ysh = sf_shr_jam64(ym, xe - ye);
    if xs == ys {
        return sf_round_pack(is32, xs, xe, xm + ysh, false);
    }
    let rm = xm - ysh;
    if rm == 0u64 {
        return 0u64;
    }
    sf_round_pack(is32, xs, xe, rm, false)
}

fn sf_mul(is32: bool, a_in: u64, b_in: u64) -> u64 {
    let a = a_in & sf_word_mask(is32);
    let b = b_in & sf_word_mask(is32);
    let mut sa: u64 = 0u64;
    let mut ea: i32 = 0;
    let mut ma: u64 = 0u64;
    let mut sb: u64 = 0u64;
    let mut eb: i32 = 0;
    let mut mb: u64 = 0u64;
    let ka = sf_unpack(is32, a, mut_view(sa), mut_view(ea), mut_view(ma));
    let kb = sf_unpack(is32, b, mut_view(sb), mut_view(eb), mut_view(mb));
    if ka == SF_K_NAN || kb == SF_K_NAN {
        return sf_qnan(is32);
    }
    let sign = sa ^ sb;
    if (ka == SF_K_INF && kb == SF_K_ZERO) || (ka == SF_K_ZERO && kb == SF_K_INF) {
        return sf_qnan(is32);
    }
    if ka == SF_K_INF || kb == SF_K_INF {
        return sf_with_sign(is32, sign, sf_inf_bits(is32));
    }
    if ka == SF_K_ZERO || kb == SF_K_ZERO {
        return sf_with_sign(is32, sign, 0u64);
    }
    let mut phi: u64 = 0u64;
    let plo = sf_mul_wide(ma, mb, mut_view(phi));
    let mut nlo: u64 = 0u64;
    let mut sh: i32 = 0;
    let nhi = sf_norm128(phi, plo, mut_view(nlo), mut_view(sh));
    sf_round_pack(is32, sign, ea + eb + 64 - sh, nhi, nlo != 0u64)
}

fn sf_div(is32: bool, a_in: u64, b_in: u64) -> u64 {
    let a = a_in & sf_word_mask(is32);
    let b = b_in & sf_word_mask(is32);
    let mut sa: u64 = 0u64;
    let mut ea: i32 = 0;
    let mut ma: u64 = 0u64;
    let mut sb: u64 = 0u64;
    let mut eb: i32 = 0;
    let mut mb: u64 = 0u64;
    let ka = sf_unpack(is32, a, mut_view(sa), mut_view(ea), mut_view(ma));
    let kb = sf_unpack(is32, b, mut_view(sb), mut_view(eb), mut_view(mb));
    if ka == SF_K_NAN || kb == SF_K_NAN {
        return sf_qnan(is32);
    }
    let sign = sa ^ sb;
    if (ka == SF_K_INF && kb == SF_K_INF) || (ka == SF_K_ZERO && kb == SF_K_ZERO) {
        return sf_qnan(is32);
    }
    if ka == SF_K_INF || kb == SF_K_ZERO {
        return sf_with_sign(is32, sign, sf_inf_bits(is32));
    }
    if ka == SF_K_ZERO || kb == SF_K_INF {
        return sf_with_sign(is32, sign, 0u64);
    }
    let lza = sf_clz64(ma);
    let lzb = sf_clz64(mb);
    let na = ma << (lza as u64);
    let nb = mb << (lzb as u64);
    let mut rem: u64 = na;
    let mut q: u64 = 0u64;
    if na >= nb {
        rem = na - nb;
        q = 1u64;
    }
    let mut i: i32 = 0;
    while i < 63 {
        let carry = rem >> 63u64;
        let rem2 = rem << 1u64;
        if carry != 0u64 || rem2 >= nb {
            rem = sf_wsub(rem2, nb);
            q = (q << 1u64) | 1u64;
        } else {
            rem = rem2;
            q = q << 1u64;
        }
        i = i + 1;
    }
    sf_round_pack(is32, sign, (ea - lza) - (eb - lzb) - 63, q, rem != 0u64)
}

// Truncating remainder (fmod), exact: the sign of a non-zero result is the sign of the dividend.
fn sf_rem(is32: bool, a_in: u64, b_in: u64) -> u64 {
    let a = a_in & sf_word_mask(is32);
    let b = b_in & sf_word_mask(is32);
    let mut sa: u64 = 0u64;
    let mut ea: i32 = 0;
    let mut ma: u64 = 0u64;
    let mut sb: u64 = 0u64;
    let mut eb: i32 = 0;
    let mut mb: u64 = 0u64;
    let ka = sf_unpack(is32, a, mut_view(sa), mut_view(ea), mut_view(ma));
    let kb = sf_unpack(is32, b, mut_view(sb), mut_view(eb), mut_view(mb));
    if ka == SF_K_NAN || kb == SF_K_NAN || ka == SF_K_INF || kb == SF_K_ZERO {
        return sf_qnan(is32);
    }
    if kb == SF_K_INF || ka == SF_K_ZERO {
        return a;
    }
    if ea >= eb {
        let mut x = ma % mb;
        let mut k = ea - eb;
        while k > 0 && x != 0u64 {
            x = x * 2u64;
            if x >= mb {
                x = x - mb;
            }
            k = k - 1;
        }
        if x == 0u64 {
            return sf_with_sign(is32, sa, 0u64);
        }
        return sf_round_pack(is32, sa, eb, x, false);
    }
    let d = eb - ea;
    if d >= 64 || (mb >> ((64 - d) as u64)) != 0u64 {
        return a;
    }
    let bb = mb << (d as u64);
    if ma < bb {
        return a;
    }
    let r = ma % bb;
    if r == 0u64 {
        return sf_with_sign(is32, sa, 0u64);
    }
    sf_round_pack(is32, sa, ea, r, false)
}

// -1 less, 0 equal, 1 greater, 2 unordered (a NaN operand).
fn sf_cmp(is32: bool, a_in: u64, b_in: u64) -> i32 {
    let sm = sf_sign_mask(is32);
    let a = a_in & sf_word_mask(is32);
    let b = b_in & sf_word_mask(is32);
    let ma = a & (sm ^ SF_ALL);
    let mb = b & (sm ^ SF_ALL);
    let inf_bits = sf_inf_bits(is32);
    if ma > inf_bits || mb > inf_bits {
        return 2;
    }
    if ma == 0u64 && mb == 0u64 {
        return 0;
    }
    let na = (a & sm) != 0u64;
    let nb = (b & sm) != 0u64;
    if na != nb {
        if na {
            return -1;
        }
        return 1;
    }
    if ma == mb {
        return 0;
    }
    if ma < mb {
        if na {
            return 1;
        }
        return -1;
    }
    if na {
        return -1;
    }
    1
}

pub fn sf_neg(is32: bool, a: u64) -> u64 {
    (a & sf_word_mask(is32)) ^ sf_sign_mask(is32)
}

// MIR binary operator on two floats of the same type. Comparisons return 1 / 0 (unordered: only != is true).
pub fn sf_binop(op: u8, is32: bool, a: u64, b: u64) -> u64 {
    if op == MIR_BINOP_ADD {
        return sf_add(is32, a, b);
    }
    if op == MIR_BINOP_SUB {
        return sf_add(is32, a, sf_neg(is32, b));
    }
    if op == MIR_BINOP_MUL {
        return sf_mul(is32, a, b);
    }
    if op == MIR_BINOP_DIV {
        return sf_div(is32, a, b);
    }
    if op == MIR_BINOP_REM {
        return sf_rem(is32, a, b);
    }
    let c = sf_cmp(is32, a, b);
    if op == MIR_BINOP_EQ {
        return if c == 0 { 1u64 } else { 0u64 };
    }
    if op == MIR_BINOP_NE {
        return if c != 0 { 1u64 } else { 0u64 };
    }
    if op == MIR_BINOP_LT {
        return if c == -1 { 1u64 } else { 0u64 };
    }
    if op == MIR_BINOP_LE {
        return if c == -1 || c == 0 { 1u64 } else { 0u64 };
    }
    if op == MIR_BINOP_GT {
        return if c == 1 { 1u64 } else { 0u64 };
    }
    if op == MIR_BINOP_GE {
        return if c == 1 || c == 0 { 1u64 } else { 0u64 };
    }
    0u64
}

// IntToFloat: the integer is given as a 128-bit two's-complement pair already extended from its own width.
pub fn sf_int_to_float(lo: u64, hi: u64, is_signed: bool, is32: bool) -> u64 {
    let mut sign: u64 = 0u64;
    let mut mlo = lo;
    let mut mhi = hi;
    if is_signed && (hi >> 63u64) != 0u64 {
        sign = 1u64;
        mlo = sf_wadd(lo ^ SF_ALL, 1u64);
        mhi = hi ^ SF_ALL;
        if mlo == 0u64 {
            mhi = mhi + 1u64;
        }
    }
    if mlo == 0u64 && mhi == 0u64 {
        return 0u64;
    }
    let mut nlo: u64 = 0u64;
    let mut sh: i32 = 0;
    let nhi = sf_norm128(mhi, mlo, mut_view(nlo), mut_view(sh));
    sf_round_pack(is32, sign, 64 - sh, nhi, nlo != 0u64)
}

fn sf_u128_gt(alo: u64, ahi: u64, blo: u64, bhi: u64) -> bool {
    ahi > bhi || (ahi == bhi && alo > blo)
}

// FloatToInt (saturating, NaN -> 0). Returns the low word; the high word (128-bit destinations) goes to out_hi.
// For destinations narrower than 64 bits the low word is the two's-complement value masked to dest_bits.
pub fn sf_float_to_int(bits: u64, is32: bool, dest_signed: bool, dest_bits: i32, out_hi: mut_view<u64>) -> u64 {
    *out_hi = 0u64;
    let mut sign: u64 = 0u64;
    let mut e: i32 = 0;
    let mut m: u64 = 0u64;
    let k = sf_unpack(is32, bits, mut_view(sign), mut_view(e), mut_view(m));
    if k == SF_K_NAN || k == SF_K_ZERO {
        return 0u64;
    }
    let neg = sign != 0u64;
    // Magnitude of trunc(x) as a 128-bit pair; `big` when it does not fit in 128 bits (or x is infinite).
    let mut big = k == SF_K_INF;
    let mut mag_lo: u64 = 0u64;
    let mut mag_hi: u64 = 0u64;
    if k == SF_K_FINITE {
        if e >= 0 {
            let msb = 63 - sf_clz64(m);
            if msb + e >= 128 {
                big = true;
            } else if e >= 64 {
                mag_hi = m << ((e - 64) as u64);
            } else if e == 0 {
                mag_lo = m;
            } else {
                mag_lo = m << (e as u64);
                mag_hi = m >> ((64 - e) as u64);
            }
        } else {
            let n = 0 - e;
            if n < 64 {
                mag_lo = m >> (n as u64);
            }
        }
    }
    // Limits of the destination as 128-bit pairs.
    let mut max_lo: u64 = SF_ALL;
    let mut max_hi: u64 = SF_ALL;
    let mut min_lo: u64 = 0u64;
    let mut min_hi: u64 = 0u64;
    if dest_signed {
        let kb = dest_bits - 1;
        let mut p2_lo: u64 = 0u64;
        let mut p2_hi: u64 = 0u64;
        if kb >= 64 {
            p2_hi = 1u64 << ((kb - 64) as u64);
        } else {
            p2_lo = 1u64 << (kb as u64);
        }
        // |MIN| = 2^(bits-1); MAX = 2^(bits-1) - 1
        min_lo = p2_lo;
        min_hi = p2_hi;
        if kb >= 64 {
            max_lo = SF_ALL;
            max_hi = p2_hi - 1u64;
        } else {
            max_lo = p2_lo - 1u64;
            max_hi = 0u64;
        }
    } else {
        if dest_bits < 64 {
            max_lo = (1u64 << (dest_bits as u64)) - 1u64;
            max_hi = 0u64;
        } else if dest_bits == 64 {
            max_hi = 0u64;
        }
    }
    let mask: u64 = if dest_bits >= 64 { SF_ALL } else { (1u64 << (dest_bits as u64)) - 1u64 };
    if !dest_signed {
        if neg {
            return 0u64;
        }
        if big || sf_u128_gt(mag_lo, mag_hi, max_lo, max_hi) {
            mag_lo = max_lo;
            mag_hi = max_hi;
        }
        *out_hi = mag_hi;
        return mag_lo & mask;
    }
    if !neg {
        if big || sf_u128_gt(mag_lo, mag_hi, max_lo, max_hi) {
            mag_lo = max_lo;
            mag_hi = max_hi;
        }
        *out_hi = mag_hi;
        return mag_lo & mask;
    }
    // Negative: saturate at -2^(bits-1), otherwise two's complement of the magnitude.
    if big || sf_u128_gt(mag_lo, mag_hi, min_lo, min_hi) {
        mag_lo = min_lo;
        mag_hi = min_hi;
    }
    if mag_lo == 0u64 && mag_hi == 0u64 {
        return 0u64;
    }
    let mut rlo = sf_wadd(mag_lo ^ SF_ALL, 1u64);
    let mut rhi = mag_hi ^ SF_ALL;
    if rlo == 0u64 {
        rhi = rhi + 1u64;
    }
    if dest_bits == 128 {
        *out_hi = rhi;
        return rlo;
    }
    rlo & mask
}

// FloatConvert: `from_f32` true widens f32 -> f64 (exact), false narrows f64 -> f32 (roundTiesToEven).
pub fn sf_float_convert(bits_in: u64, from_f32: bool) -> u64 {
    let mut sign: u64 = 0u64;
    let mut e: i32 = 0;
    let mut m: u64 = 0u64;
    let k = sf_unpack(from_f32, bits_in, mut_view(sign), mut_view(e), mut_view(m));
    let bits = bits_in & sf_word_mask(from_f32);
    if from_f32 {
        let sbit = sign << 63u64;
        if k == SF_K_NAN {
            return sbit | 0x7FF8000000000000u64 | ((bits & 0x3FFFFFu64) << 29u64);
        }
        if k == SF_K_INF {
            return sbit | 0x7FF0000000000000u64;
        }
        if k == SF_K_ZERO {
            return sbit;
        }
        return sf_round_pack(false, sign, e, m, false);
    }
    let sbit32 = sign << 31u64;
    if k == SF_K_NAN {
        return sbit32 | 0x7FC00000u64 | ((bits >> 29u64) & 0x3FFFFFu64);
    }
    if k == SF_K_INF {
        return sbit32 | 0x7F800000u64;
    }
    if k == SF_K_ZERO {
        return sbit32;
    }
    sf_round_pack(true, sign, e, m, false)
}

fn sf_sqrt(is32: bool, a_in: u64) -> u64 {
    let a = a_in & sf_word_mask(is32);
    let mut sa: u64 = 0u64;
    let mut ea: i32 = 0;
    let mut ma: u64 = 0u64;
    let ka = sf_unpack(is32, a, mut_view(sa), mut_view(ea), mut_view(ma));
    if ka == SF_K_NAN {
        return sf_qnan(is32);
    }
    if ka == SF_K_ZERO {
        return a;
    }
    if sa != 0u64 {
        return sf_qnan(is32);
    }
    if ka == SF_K_INF {
        return a;
    }
    let lz = sf_clz64(ma);
    let m1 = ma << (lz as u64);
    let e1 = ea - lz;
    // R = m1 * 2^t with (e1 - t) even, so sqrt(value) = sqrt(R) * 2^((e1 - t) / 2).
    let mut t: i32 = 64;
    if (e1 & 1) != 0 {
        t = 63;
    }
    let mut rhi: u64 = m1;
    let mut rlo: u64 = 0u64;
    if t == 63 {
        rhi = m1 >> 1u64;
        rlo = m1 << 63u64;
    }
    let mut root: u64 = 0u64;
    let mut bit: i32 = 63;
    let mut sq_hi: u64 = 0u64;
    let mut sq_lo: u64 = 0u64;
    while bit >= 0 {
        let cand = root | (1u64 << (bit as u64));
        let mut ch: u64 = 0u64;
        let cl = sf_mul_wide(cand, cand, mut_view(ch));
        if !sf_u128_gt(cl, ch, rlo, rhi) {
            root = cand;
            sq_hi = ch;
            sq_lo = cl;
        }
        bit = bit - 1;
    }
    let exact = sq_hi == rhi && sq_lo == rlo;
    sf_round_pack(is32, 0u64, (e1 - t) / 2, root, !exact)
}

// mode: 0 trunc, 1 floor, 2 ceil, 3 round (ties away), 4 round_ties_even.
fn sf_round_int(is32: bool, a_in: u64, mode: u32) -> u64 {
    let sm = sf_sign_mask(is32);
    let a = a_in & sf_word_mask(is32);
    let mag = a & (sm ^ SF_ALL);
    let neg = (a & sm) != 0u64;
    let inf_bits = sf_inf_bits(is32);
    if mag > inf_bits {
        return sf_qnan(is32);
    }
    if mag == inf_bits || mag == 0u64 {
        return a;
    }
    let mut p1: u64 = 52u64;
    let mut bias: u64 = 1023u64;
    if is32 {
        p1 = 23u64;
        bias = 127u64;
    }
    let ef = mag >> p1;
    if ef >= bias + p1 {
        return a;
    }
    let sbits = if neg { sm } else { 0u64 };
    if ef < bias {
        // |x| < 1: the result is +-0 or +-1.
        let mut one = false;
        if mode == 1u32 {
            one = neg;
        } else if mode == 2u32 {
            one = !neg;
        } else if mode == 3u32 {
            one = ef == bias - 1u64;
        } else if mode == 4u32 {
            one = ef == bias - 1u64 && (mag & ((1u64 << p1) - 1u64)) != 0u64;
        }
        if one {
            return sbits | (bias << p1);
        }
        return sbits;
    }
    let fb = p1 - (ef - bias);
    let low_mask = (1u64 << fb) - 1u64;
    let rem = mag & low_mask;
    if rem == 0u64 {
        return a;
    }
    let tr = mag & (low_mask ^ SF_ALL);
    let unit = 1u64 << fb;
    let half = 1u64 << (fb - 1u64);
    let mut add = false;
    if mode == 1u32 {
        add = neg;
    } else if mode == 2u32 {
        add = !neg;
    } else if mode == 3u32 {
        add = rem >= half;
    } else if mode == 4u32 {
        add = rem > half || (rem == half && (tr & unit) != 0u64);
    }
    if add {
        return sbits | (tr + unit);
    }
    sbits | tr
}

// IEEE-754 nextUp; nextDown(x) = -nextUp(-x).
fn sf_next_up(is32: bool, a_in: u64) -> u64 {
    let sm = sf_sign_mask(is32);
    let a = a_in & sf_word_mask(is32);
    let mag = a & (sm ^ SF_ALL);
    let inf_bits = sf_inf_bits(is32);
    if mag > inf_bits {
        return sf_qnan(is32);
    }
    if mag == 0u64 {
        return 1u64;
    }
    if (a & sm) == 0u64 {
        if mag == inf_bits {
            return a;
        }
        return a + 1u64;
    }
    a - 1u64
}

fn sf_min_max(is32: bool, a_in: u64, b_in: u64, want_max: bool) -> u64 {
    let sm = sf_sign_mask(is32);
    let a = a_in & sf_word_mask(is32);
    let b = b_in & sf_word_mask(is32);
    let inf_bits = sf_inf_bits(is32);
    let a_nan = (a & (sm ^ SF_ALL)) > inf_bits;
    let b_nan = (b & (sm ^ SF_ALL)) > inf_bits;
    if a_nan && b_nan {
        return sf_qnan(is32);
    }
    if a_nan {
        return b;
    }
    if b_nan {
        return a;
    }
    let c = sf_cmp(is32, a, b);
    if c == 0 {
        // Equal values: only +0 / -0 can differ; min prefers -0, max prefers +0.
        if (a & sm) == (b & sm) {
            return a;
        }
        if want_max {
            if (a & sm) == 0u64 {
                return a;
            }
            return b;
        }
        if (a & sm) != 0u64 {
            return a;
        }
        return b;
    }
    if want_max {
        if c == 1 {
            return a;
        }
        return b;
    }
    if c == -1 {
        return a;
    }
    b
}

fn sf_fma(is32: bool, a_in: u64, b_in: u64, c_in: u64) -> u64 {
    let mut sa: u64 = 0u64;
    let mut ea: i32 = 0;
    let mut ma: u64 = 0u64;
    let mut sb: u64 = 0u64;
    let mut eb: i32 = 0;
    let mut mb: u64 = 0u64;
    let mut sc: u64 = 0u64;
    let mut ec: i32 = 0;
    let mut mc: u64 = 0u64;
    let ka = sf_unpack(is32, a_in, mut_view(sa), mut_view(ea), mut_view(ma));
    let kb = sf_unpack(is32, b_in, mut_view(sb), mut_view(eb), mut_view(mb));
    let kc = sf_unpack(is32, c_in, mut_view(sc), mut_view(ec), mut_view(mc));
    if ka == SF_K_NAN || kb == SF_K_NAN || kc == SF_K_NAN {
        return sf_qnan(is32);
    }
    let ps = sa ^ sb;
    if (ka == SF_K_INF && kb == SF_K_ZERO) || (ka == SF_K_ZERO && kb == SF_K_INF) {
        return sf_qnan(is32);
    }
    if ka == SF_K_INF || kb == SF_K_INF {
        if kc == SF_K_INF && sc != ps {
            return sf_qnan(is32);
        }
        return sf_with_sign(is32, ps, sf_inf_bits(is32));
    }
    if kc == SF_K_INF {
        return sf_with_sign(is32, sc, sf_inf_bits(is32));
    }
    if ka == SF_K_ZERO || kb == SF_K_ZERO {
        if kc == SF_K_ZERO {
            if ps == sc {
                return sf_with_sign(is32, sc, 0u64);
            }
            return 0u64;
        }
        return c_in & sf_word_mask(is32);
    }
    // Exact product (at most 106 bits) normalised to msb = bit 127.
    let mut phi: u64 = 0u64;
    let plo = sf_mul_wide(ma, mb, mut_view(phi));
    let pe = ea + eb;
    let mut nlo: u64 = 0u64;
    let mut sh: i32 = 0;
    let nhi = sf_norm128(phi, plo, mut_view(nlo), mut_view(sh));
    if kc == SF_K_ZERO {
        return sf_round_pack(is32, ps, pe + 64 - sh, nhi, nlo != 0u64);
    }
    // Put both terms at msb = bit 126 (the product's low bits are zero, so the shift is exact).
    let xh0 = nhi >> 1u64;
    let xl0 = (nlo >> 1u64) | (nhi << 63u64);
    let pe2 = pe + 1 - sh;
    let lzc = sf_clz64(mc);
    let ch0 = mc << ((lzc - 1) as u64);
    let ce2 = ec - (lzc + 63);
    let mut xs = ps;
    let mut xe = pe2;
    let mut xh = xh0;
    let mut xl = xl0;
    let mut ys = sc;
    let mut ye = ce2;
    let mut yh = ch0;
    let mut yl = 0u64;
    if ce2 > pe2 || (ce2 == pe2 && ch0 > xh0) {
        xs = sc;
        xe = ce2;
        xh = ch0;
        xl = 0u64;
        ys = ps;
        ye = pe2;
        yh = xh0;
        yl = xl0;
    }
    let mut sh_hi: u64 = 0u64;
    let mut sh_lo: u64 = 0u64;
    sf_shr_jam128(yh, yl, xe - ye, mut_view(sh_hi), mut_view(sh_lo));
    let mut rh: u64 = 0u64;
    let mut rl: u64 = 0u64;
    if xs == ys {
        rl = sf_wadd(xl, sh_lo);
        rh = xh + sh_hi;
        if rl < xl {
            rh = rh + 1u64;
        }
    } else {
        rl = sf_wsub(xl, sh_lo);
        rh = xh - sh_hi;
        if xl < sh_lo {
            rh = rh - 1u64;
        }
    }
    if rh == 0u64 && rl == 0u64 {
        return 0u64;
    }
    let mut ol: u64 = 0u64;
    let mut osh: i32 = 0;
    let oh = sf_norm128(rh, rl, mut_view(ol), mut_view(osh));
    sf_round_pack(is32, xs, xe + 64 - osh, oh, ol != 0u64)
}

// Float intrinsic by SF_I_* kind. `is32` is the float width of the operand (of the result for from_bits).
pub fn sf_intrinsic(kind: u32, is32: bool, a: u64, b: u64, c: u64) -> u64 {
    let wm = sf_word_mask(is32);
    if kind == SF_I_SQRT {
        return sf_sqrt(is32, a);
    }
    if kind == SF_I_ABS {
        return (a & wm) & (sf_sign_mask(is32) ^ SF_ALL);
    }
    if kind == SF_I_COPYSIGN {
        let sm = sf_sign_mask(is32);
        return ((a & wm) & (sm ^ SF_ALL)) | (b & sm);
    }
    if kind == SF_I_TRUNC {
        return sf_round_int(is32, a, 0u32);
    }
    if kind == SF_I_FLOOR {
        return sf_round_int(is32, a, 1u32);
    }
    if kind == SF_I_CEIL {
        return sf_round_int(is32, a, 2u32);
    }
    if kind == SF_I_ROUND {
        return sf_round_int(is32, a, 3u32);
    }
    if kind == SF_I_ROUND_TIES_EVEN {
        return sf_round_int(is32, a, 4u32);
    }
    if kind == SF_I_FMA {
        return sf_fma(is32, a, b, c);
    }
    if kind == SF_I_MIN {
        return sf_min_max(is32, a, b, false);
    }
    if kind == SF_I_MAX {
        return sf_min_max(is32, a, b, true);
    }
    if kind == SF_I_TO_BITS || kind == SF_I_FROM_BITS {
        return a & wm;
    }
    if kind == SF_I_NEXT_UP {
        return sf_next_up(is32, a);
    }
    if kind == SF_I_NEXT_DOWN {
        let up = sf_next_up(is32, sf_neg(is32, a));
        if (up & (sf_sign_mask(is32) ^ SF_ALL)) > sf_inf_bits(is32) {
            return sf_qnan(is32);
        }
        return sf_neg(is32, up);
    }
    0u64
}
