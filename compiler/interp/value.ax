    97u8, 110u8, 32u8, 105u8, 110u8, 116u8, 101u8, 103u8, 101u8, 114u8, 32u8, 97u8,
    100u8, 100u8, 114u8, 101u8, 115u8, 115u8,
];

// T502 (SPEC-50 AXS-UNS-015): the `data.ub_kind` strings. Offsets/lengths: dangling_or_freed 0/17, null_deref 17/10,
// invalid_provenance 27/18, out_of_bounds 45/13, misaligned_access 58/17, uninitialized_read 75/18, write_to_readonly 93/17,
// overlapping_copy 110/16, invalid_fixed_addr 126/18, data_race 144/9; the data key `ub_kind` is 153/7.
