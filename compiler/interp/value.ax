pub const INTERP_PERM_READONLY: u8 = 1u8;

// Synthetic code segment of the oracle (SPEC-50 AXS-UNS-021): fn `FnId` n has the entry address base + 0x100 * n unless an
// `@addr(A)` / `@at(A)` placement names another one. Code addresses are identities only; they are never dereferenceable.
pub const INTERP_FNCODE_BASE: u64 = 0x10000000u64;
pub const INTERP_FNCODE_STRIDE: u64 = 0x100u64;

