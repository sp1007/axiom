// Axiom Compiler — MIR Interpreter Call Frames, Places & Body Map (compiler/interp/frame.ax)
// Port of CallFrame, get_local_ptr, get_place_ptr, eval_operand, and AxMirMap from
// bootstrap/axiom0/src/interp/interp.c.
module compiler.interp.frame

