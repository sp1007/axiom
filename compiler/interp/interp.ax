// =================================================================================================
// Safe Wrapping & Two's-Complement 64-bit Arithmetic Helpers
// (Computed via 32-bit halves so host overflow traps are never triggered in interp or native mode)
// =================================================================================================

pub fn w_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let sum_hi = (a_hi + b_hi + carry) & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}

pub fn w_add_u64_ovf(a: u64, b: u64, out_ovf: mut_view<bool>) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let sum_hi_full = a_hi + b_hi + carry;
    *out_ovf = (sum_hi_full >> 32u64) != 0u64;
    let sum_hi = sum_hi_full & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}

pub fn w_neg_u64(a: u64) -> u64 {
    w_add_u64(a ^ 0xFFFFFFFFFFFFFFFFu64, 1u64)
}

pub fn w_sub_u64(a: u64, b: u64) -> u64 {
    w_add_u64(a, w_neg_u64(b))
}

pub fn w_sub_u64_ovf(a: u64, b: u64, out_ovf: mut_view<bool>) -> u64 {
    *out_ovf = a < b;
    w_sub_u64(a, b)
}

fn mul_u16_chunks(x: u64, y: u64) -> u64 {
    ((x as i64) * (y as i64)) as u64
}

pub fn w_mul_u64_ovf(a: u64, b: u64, out_ovf: mut_view<bool>) -> u64 {
    let a0 = a & 0xFFFFu64;
    let a1 = (a >> 16u64) & 0xFFFFu64;
    let a2 = (a >> 32u64) & 0xFFFFu64;
    let a3 = (a >> 48u64) & 0xFFFFu64;
    let b0 = b & 0xFFFFu64;
    let b1 = (b >> 16u64) & 0xFFFFu64;
    let b2 = (b >> 32u64) & 0xFFFFu64;
    let b3 = (b >> 48u64) & 0xFFFFu64;

    let c0 = mul_u16_chunks(a0, b0);
    let c1 = (c0 >> 16u64) + mul_u16_chunks(a0, b1) + mul_u16_chunks(a1, b0);
    let c2 = (c1 >> 16u64) + mul_u16_chunks(a0, b2) + mul_u16_chunks(a1, b1) + mul_u16_chunks(a2, b0);
    let c3 = (c2 >> 16u64) + mul_u16_chunks(a0, b3) + mul_u16_chunks(a1, b2) + mul_u16_chunks(a2, b1) + mul_u16_chunks(a3, b0);
    let high_terms = mul_u16_chunks(a1, b3) + mul_u16_chunks(a2, b2) + mul_u16_chunks(a3, b1) +
        mul_u16_chunks(a2, b3) + mul_u16_chunks(a3, b2) + mul_u16_chunks(a3, b3);
    *out_ovf = ((c3 >> 16u64) != 0u64) || (high_terms != 0u64);
    (c0 & 0xFFFFu64) |
        ((c1 & 0xFFFFu64) << 16u64) |
        ((c2 & 0xFFFFu64) << 32u64) |
        ((c3 & 0xFFFFu64) << 48u64)
}

pub fn w_mul_u64(a: u64, b: u64) -> u64 {
    let mut dummy = false;
    w_mul_u64_ovf(a, b, mut_view(dummy))
}

pub fn bit_mask_u64(bits: i32) -> u64 {
    if bits >= 64 {
        return 0xFFFFFFFFFFFFFFFFu64;
    }
    if bits <= 0 {
        return 0u64;
    }
    (1u64 << (bits as u64)) - 1u64
}

pub fn sign_extend_u64(val: u64, bits: i32) -> u64 {
    if bits >= 64 || bits <= 0 {
        return val;
    }
    let mask = bit_mask_u64(bits);
    let truncated = val & mask;
    let sign_bit = 1u64 << ((bits - 1) as u64);
    if (truncated & sign_bit) != 0u64 {
        return truncated | (mask ^ 0xFFFFFFFFFFFFFFFFu64);
    }
    truncated
}

pub fn signed_lt_u64(ua: u64, ub: u64) -> bool {
    (ua ^ 0x8000000000000000u64) < (ub ^ 0x8000000000000000u64)
}

pub fn signed_le_u64(ua: u64, ub: u64) -> bool {
    (ua ^ 0x8000000000000000u64) <= (ub ^ 0x8000000000000000u64)
}

pub fn signed_gt_u64(ua: u64, ub: u64) -> bool {
    (ua ^ 0x8000000000000000u64) > (ub ^ 0x8000000000000000u64)
}

pub fn signed_ge_u64(ua: u64, ub: u64) -> bool {
    (ua ^ 0x8000000000000000u64) >= (ub ^ 0x8000000000000000u64)
}

// =================================================================================================
// Core Intrinsic Name Table
// =================================================================================================

// Concatenated core intrinsic names:
//   0..6:   "assert"
//   6..17:  "unreachable"
//  17..22:  "panic"
//  22..34:  "wrapping_add"
//  34..46:  "wrapping_sub"
//  46..58:  "wrapping_mul"
//  58..70:  "wrapping_neg"
//  70..81:  "rotate_left"
//  81..93:  "rotate_right"
//  93..106: "leading_zeros"
// 106..120: "trailing_zeros"
// 120..130: "count_ones"
// 130..139: "intrinsic"
const CORE_INTRINSIC_BYTES: [139]u8 = [
    // "assert" (0..6)
    97u8, 115u8, 115u8, 101u8, 114u8, 116u8,
    // "unreachable" (6..17)
    117u8, 110u8, 114u8, 101u8, 97u8, 99u8, 104u8, 97u8, 98u8, 108u8, 101u8,
    // "panic" (17..22)
    112u8, 97u8, 110u8, 105u8, 99u8,
    // "wrapping_add" (22..34)
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 97u8, 100u8, 100u8,
    // "wrapping_sub" (34..46)
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 115u8, 117u8, 98u8,
    // "wrapping_mul" (46..58)
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 109u8, 117u8, 108u8,
    // "wrapping_neg" (58..70)
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 110u8, 101u8, 103u8,
    // "rotate_left" (70..81)
    114u8, 111u8, 116u8, 97u8, 116u8, 101u8, 95u8, 108u8, 101u8, 102u8, 116u8,
    // "rotate_right" (81..93)
    114u8, 111u8, 116u8, 97u8, 116u8, 101u8, 95u8, 114u8, 105u8, 103u8, 104u8, 116u8,
    // "leading_zeros" (93..106)
    108u8, 101u8, 97u8, 100u8, 105u8, 110u8, 103u8, 95u8, 122u8, 101u8, 114u8, 111u8, 115u8,
    // "trailing_zeros" (106..120)
    116u8, 114u8, 97u8, 105u8, 108u8, 105u8, 110u8, 103u8, 95u8, 122u8, 101u8, 114u8, 111u8, 115u8,
    // "count_ones" (120..130)
    99u8, 111u8, 117u8, 110u8, 116u8, 95u8, 111u8, 110u8, 101u8, 115u8,
    // "intrinsic" (130..139)
    105u8, 110u8, 116u8, 114u8, 105u8, 110u8, 115u8, 105u8, 99u8,
];

fn core_name_eq(sv: view<StrView>, off: usize, n: usize) -> bool {
    if sv.len != n || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let b = unsafe { *(sv.ptr + i) };
        if b != CORE_INTRINSIC_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

// Matches `op` or `op_<suffix>` (port of IS_OP macro in interp.c).
fn core_name_is_op(sv: view<StrView>, off: usize, n: usize) -> bool {
    if (sv.len) < n || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let b = unsafe { *(sv.ptr + i) };
        if b != CORE_INTRINSIC_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    if sv.len == n {
        return true;
    }
    let next_ch = unsafe { *(sv.ptr + n) };
    next_ch == 95u8
}

// =================================================================================================
// Output Helpers (print / print_int)
// =================================================================================================

pub fn interp_write_out(ctx: mut_view<InterpCtx>, bytes: *const u8, n: usize) {
    if n == 0 || (bytes as usize) == 0 {
        return;
    }
    if (ctx.out_buf as usize) != 0 {
        unsafe {
            diag_buf_push_bytes(mut_view(*ctx.out_buf), bytes, n);
        }
    }
    if !ctx.capture_stdout {
        unsafe {
            let _ = write(1i64, bytes, n);
        }
    }
}

pub fn interp_write_u64(ctx: mut_view<InterpCtx>, val: u64) {
    let mut buf: [24]u8 = [0u8; 24];
    if val == 0u64 {
        buf[0] = 48u8;
        let ptr = unsafe { address_of(buf[0]) };
        interp_write_out(mut_view(*ctx), ptr, 1);
        return;
    }
    let mut tmp: [24]u8 = [0u8; 24];
    let mut dlen: usize = 0;
    let mut n = val;
    while n > 0u64 {
        tmp[dlen] = (48u64 + (n % 10u64)) as u8;
        n = n / 10u64;
        dlen = dlen + 1;
    }
    let mut i: usize = 0;
    while i < dlen {
        buf[i] = tmp[dlen - 1 - i];
        i = i + 1;
    }
    let ptr = unsafe { address_of(buf[0]) };
    interp_write_out(mut_view(*ctx), ptr, dlen);
}

pub fn interp_write_i64_twos(ctx: mut_view<InterpCtx>, ua: u64) {
    if ((ua >> 63u64) & 1u64) != 0u64 {
        let mut minus_buf: [1]u8 = [45u8];
        let mptr = unsafe { address_of(minus_buf[0]) };
        interp_write_out(mut_view(*ctx), mptr, 1);
        let mag = w_neg_u64(ua);
        interp_write_u64(mut_view(*ctx), mag);
    } else {
        interp_write_u64(mut_view(*ctx), ua);
    }
}

// =================================================================================================
// Function & Destructor Lookup
// =================================================================================================

pub fn find_func_by_symbol(ctx: view<InterpCtx>, sym_v: u64) -> *mut HirItem {
    let target_sym = sym_v as u32;
    if sym_v == 0u64 || target_sym == 0u32 {
        return 0 as *mut HirItem;
    }

    if (ctx.mono_engine as usize) != 0 {
        let mut inst: *mut MonoInstance = unsafe { (*ctx.mono_engine).instances_head };
        while (inst as usize) != 0 {
            let msym = unsafe { (*inst).mangled_sym.v };
            if msym == target_sym {
                let nitem = unsafe { (*inst).new_item };
                if (nitem as usize) != 0 {
                    return nitem;
                }
                return unsafe { (*inst).orig_item };
            }
            inst = unsafe { (*inst).next };
        }
    }

    if (ctx.hir as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*ctx.hir).items };
        while (it as usize) != 0 {
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_FN && (unsafe { (*it).symbol.v }) == target_sym {
                return it;
            }
            if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).symbol.v }) == target_sym {
                        return m;
                    }
                    m = unsafe { (*m).next };
                }
            }
            it = unsafe { (*it).next };
        }
    }

    let mut target_name = StrId { v: 0u32 };
    if (ctx.ast as usize) != 0 && (ctx.rmap as usize) != 0 {
        let mut ait: *mut AstItem = unsafe { (*ctx.ast).items };
        while (ait as usize) != 0 {
            let it_sym = unsafe { nodemap_get(view((*ctx.rmap).node_map), ait as usize) };
            if (it_sym as usize) != 0 && (unsafe { (*it_sym).v }) == target_sym {
                if (unsafe { (*ait).kind }) == ITEM_FN {
                    target_name = StrId { v: unsafe { (*ait).name.v } };
                }
                break;
            }
            let ak = unsafe { (*ait).kind };
            if ak == ITEM_IMPL || ak == ITEM_TRAIT {
                let mut am: *mut AstItem = unsafe { (*ait).members };
                while (am as usize) != 0 {
                    let m_sym = unsafe { nodemap_get(view((*ctx.rmap).node_map), am as usize) };
                    if (m_sym as usize) != 0 && (unsafe { (*m_sym).v }) == target_sym {
                        if (unsafe { (*am).kind }) == ITEM_FN {
                            target_name = StrId { v: unsafe { (*am).name.v } };
                        }
                        break;
                    }
                    am = unsafe { (*am).next };
                }
                if target_name.v != 0u32 {
                    break;
                }
            }
            ait = unsafe { (*ait).next };
        }
    }

    if target_name.v == 0u32 || (ctx.hir as usize) == 0 {
        return 0 as *mut HirItem;
    }

    let mut it2: *mut HirItem = unsafe { (*ctx.hir).items };
    while (it2 as usize) != 0 {
        let ik = unsafe { (*it2).kind };
        if ik == HIR_ITEM_FN && (unsafe { (*it2).name.v }) == target_name.v {
            return it2;
        }
        if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*it2).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).name.v }) == target_name.v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        it2 = unsafe { (*it2).next };
    }
    0 as *mut HirItem
}

pub fn find_drop_fn_for_type(ctx: view<InterpCtx>, ty_id: TypeId) -> *mut HirItem {
    if ty_id.v == 0u32 || (ctx.thir as usize) == 0 || (ctx.hir as usize) == 0 || (ctx.interner as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let ty = unsafe { type_get(view((*ctx.thir).interner), ty_id) };
    if (ty as usize) == 0 || (unsafe { (*ty).kind }) != TY_STRUCT {
        return 0 as *mut HirItem;
    }
    let def = unsafe { (*ty).def as *const HirItem };
    let drop_fn = unsafe {
        mir_find_drop_impl_fn(view(*ctx.hir), def, ctx.db, view(*ctx.interner))
    };
    drop_fn as *mut HirItem
}

// =================================================================================================
// Operand & Type Width Helpers
// =================================================================================================

pub fn eval_operand_u64(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, op: view<MirOperand>) -> u64 {
    if op.kind == MIR_OP_CONST {
        return op.constant.val;
    }
    let mut ty = TypeId { v: 0u32 };
    let mut fat_len: u64 = 0u64;
    let ptr = get_place_ptr(mut_view(*ctx), frame, view(op.place), mut_view(ty), mut_view(fat_len));
    let sz = unsafe { type_size(ty, view((*ctx.thir).interner)) };
    if sz == 1u32 {
        return unsafe { *ptr as u64 };
    }
    if sz == 2u32 {
        return unsafe { *(ptr as *const u16) as u64 };
    }
    if sz == 4u32 {
        return unsafe { *(ptr as *const u32) as u64 };
    }
    unsafe { *(ptr as *const u64) }
}

fn write_scalar_to_ptr(dest: *mut u8, size: u32, val: u64) {
    if (dest as usize) == 0 {
        return;
    }
    if size == 1u32 {
        unsafe {
            *dest = val as u8;
        }
    } else if size == 2u32 {
        unsafe {
            *(dest as *mut u16) = val as u16;
        }
    } else if size == 4u32 {
        unsafe {
            *(dest as *mut u32) = val as u32;
        }
    } else if size == 8u32 {
        unsafe {
            *(dest as *mut u64) = val;
        }
    }
}

fn classify_int_ty(ctx: view<InterpCtx>, ty: TypeId, out_signed: mut_view<bool>, out_bits: mut_view<i32>) -> u8 {
    *out_signed = true;
    *out_bits = 32;
    if ty.v == 0u32 || (ctx.thir as usize) == 0 {
        return 0u8;
    }
    let t = unsafe { type_get(view((*ctx.thir).interner), ty) };
    if (t as usize) == 0 {
        return 0u8;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_I8 {
        *out_signed = true;
        *out_bits = 8;
    } else if tk == TY_I16 {
        *out_signed = true;
        *out_bits = 16;
    } else if tk == TY_I32 {
        *out_signed = true;
        *out_bits = 32;
    } else if tk == TY_I64 || tk == TY_ISIZE {
        *out_signed = true;
        *out_bits = 64;
    } else if tk == TY_U8 {
        *out_signed = false;
        *out_bits = 8;
    } else if tk == TY_U16 {
        *out_signed = false;
        *out_bits = 16;
    } else if tk == TY_U32 || tk == TY_CHAR {
        *out_signed = false;
        *out_bits = 32;
    } else if tk == TY_U64 || tk == TY_USIZE {
        *out_signed = false;
        *out_bits = 64;
    } else if tk == TY_BOOL {
        *out_signed = false;
        *out_bits = 1;
    } else if tk == TY_PTR {
        *out_signed = false;
        *out_bits = 64;
    }
    tk
}

// =================================================================================================
// Core Intrinsic & Function Call Evaluation
// =================================================================================================

fn func_has_intrinsic_attr(ctx: view<InterpCtx>, func: *const HirItem) -> bool {
    if (func as usize) == 0 || (ctx.interner as usize) == 0 {
        return false;
    }
    let mut attr: *mut HirAttr = unsafe { (*func).attrs };
    while (attr as usize) != 0 {
        let aname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*attr).name.v }) };
        if core_name_eq(view(aname), 130, 9) {
            return true;
        }
        attr = unsafe { (*attr).next };
    }
    false
}

fn eval_core_intrinsic(
    ctx: mut_view<InterpCtx>,
    func: *mut HirItem,
    name: StrView,
    args: *const u64,
    arg_count: usize,
    out_ret: mut_view<InterpValue>
) -> bool {
    let a0: u64 = if arg_count > 0 && (args as usize) != 0 { unsafe { *args } } else { 0u64 };
    let a1: u64 = if arg_count > 1 && (args as usize) != 0 { unsafe { *(args + 1) } } else { 0u64 };

    if core_name_eq(view(name), 0, 6) {
        if arg_count > 0 && a0 == 0u64 {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ASSERT);
        }
        out_ret.vals[0] = 0u64;
        return true;
    }
    if core_name_eq(view(name), 6, 11) {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNREACHABLE);
        return true;
    }
    if core_name_eq(view(name), 17, 5) {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_PANIC);
        return true;
    }

    let mut bits: i32 = 64;
    if (ctx.thir as usize) != 0 {
        let fn_ty_ptr = unsafe { thir_get_item_type(view(*ctx.thir), func as *const HirItem) };
        if (fn_ty_ptr as usize) != 0 {
            let fn_ty_id = TypeId { v: unsafe { (*fn_ty_ptr).v } };
            let fn_ty = unsafe { type_get(view((*ctx.thir).interner), fn_ty_id) };
            if (fn_ty as usize) != 0 && (unsafe { (*fn_ty).kind }) == TY_FN && (unsafe { (*fn_ty).ret_type.v }) != 0u32 && (unsafe { (*fn_ty).param_count }) > 0 {
                let p0_id = TypeId { v: unsafe { (*typeid_at((*fn_ty).param_types, 0)).v } };
                let op_ty = unsafe { type_get(view((*ctx.thir).interner), p0_id) };
                if (op_ty as usize) != 0 {
                    let ok = unsafe { (*op_ty).kind };
                    if ok == TY_I8 || ok == TY_U8 {
                        bits = 8;
                    } else if ok == TY_I16 || ok == TY_U16 {
                        bits = 16;
                    } else if ok == TY_I32 || ok == TY_U32 {
                        bits = 32;
                    } else {
                        bits = 64;
                    }
                }
            }
        }
    }
    let mask = bit_mask_u64(bits);
    let u_bits = bits as u64;

    if core_name_is_op(view(name), 22, 12) {
        if arg_count == 2 {
            let r = w_add_u64(a0, a1);
            out_ret.vals[0] = r & mask;
        }
        return true;
    }
    if core_name_is_op(view(name), 34, 12) {
        if arg_count == 2 {
            let r = w_sub_u64(a0, a1);
            out_ret.vals[0] = r & mask;
        }
        return true;
    }
    if core_name_is_op(view(name), 46, 12) {
        if arg_count == 2 {
            let r = w_mul_u64(a0, a1);
            out_ret.vals[0] = r & mask;
        }
        return true;
    }
    if core_name_is_op(view(name), 58, 12) {
        if arg_count == 1 {
            let r = w_neg_u64(a0);
            out_ret.vals[0] = r & mask;
        }
        return true;
    }
    if core_name_is_op(view(name), 70, 11) {
        if arg_count == 2 {
            let v = a0 & mask;
            let n = (a1 & 0xFFFFFFFFu64) % u_bits;
            if n == 0u64 {
                out_ret.vals[0] = v;
            } else {
                out_ret.vals[0] = ((v << n) | (v >> (u_bits - n))) & mask;
            }
        }
        return true;
    }
    if core_name_is_op(view(name), 81, 12) {
        if arg_count == 2 {
            let v = a0 & mask;
            let n = (a1 & 0xFFFFFFFFu64) % u_bits;
            if n == 0u64 {
                out_ret.vals[0] = v;
            } else {
                out_ret.vals[0] = ((v >> n) | (v << (u_bits - n))) & mask;
            }
        }
        return true;
    }
    if core_name_is_op(view(name), 93, 13) {
        if arg_count == 1 {
            let val = a0 & mask;
            if val == 0u64 {
                out_ret.vals[0] = u_bits;
            } else {
                let mut lz: u64 = 0u64;
                let mut i: i32 = bits - 1;
                while i >= 0 {
                    if ((val >> (i as u64)) & 1u64) != 0u64 {
                        break;
                    }
                    lz = lz + 1u64;
                    i = i - 1;
                }
                out_ret.vals[0] = lz;
            }
        }
        return true;
    }
    if core_name_is_op(view(name), 106, 14) {
        if arg_count == 1 {
            let val = a0 & mask;
            if val == 0u64 {
                out_ret.vals[0] = u_bits;
            } else {
                let mut tz: u64 = 0u64;
                let mut i: i32 = 0;
                while i < bits {
                    if ((val >> (i as u64)) & 1u64) != 0u64 {
                        break;
                    }
                    tz = tz + 1u64;
                    i = i + 1;
                }
                out_ret.vals[0] = tz;
            }
        }
        return true;
    }
    if core_name_is_op(view(name), 120, 10) {
        if arg_count == 1 {
            let val = a0 & mask;
            let mut ones: u64 = 0u64;
            let mut i: i32 = 0;
            while i < bits {
                if ((val >> (i as u64)) & 1u64) != 0u64 {
                    ones = ones + 1u64;
                }
                i = i + 1;
            }
            out_ret.vals[0] = ones;
        }
        return true;
    }
    false
}

fn resolve_or_build_mir_body(ctx: mut_view<InterpCtx>, func: *mut HirItem) -> *mut MirBody {
    if (func as usize) == 0 {
        return 0 as *mut MirBody;
    }
    let sym_v = unsafe { (*func).symbol.v };
    if (ctx.mir_map as usize) != 0 {
        let cached = unsafe { mir_body_map_get_by_item(view(*ctx.mir_map), func as *const HirItem) };
        if (cached as usize) != 0 {
            return cached;
        }
        if sym_v != 0u32 {
            let cached_sym = unsafe { mir_body_map_get_by_sym(view(*ctx.mir_map), sym_v) };
            if (cached_sym as usize) != 0 {
                return cached_sym;
            }
        }
    }

    if ctx.is_comptime || !ctx.build_on_demand {
        return 0 as *mut MirBody;
    }

    let mut body: *mut MirBody = 0 as *mut MirBody;
    if (ctx.mono_engine as usize) != 0 {
        let mut inst: *mut MonoInstance = unsafe { (*ctx.mono_engine).instances_head };
        while (inst as usize) != 0 {
            let nitem = unsafe { (*inst).new_item };
            let oitem = unsafe { (*inst).orig_item };
            let msym = unsafe { (*inst).mangled_sym.v };
            if nitem == func || (sym_v != 0u32 && msym == sym_v) {
                let mb_ptr = unsafe { (*inst).mir_body as *mut MirBody };
                if (mb_ptr as usize) != 0 {
                    body = mb_ptr;
                } else {
                    let target_fn = if (nitem as usize) != 0 { nitem } else { oitem };
                    body = unsafe {
                        mir_build_fn_subst(
                            mut_view(ctx.arena),
                            target_fn,
                            ctx.thir,
                            ctx.hir,
                            ctx.interner,
                            ctx.db,
                            ctx.mono_engine,
                            view((*inst).args)
                        )
                    };
                }
                break;
            }
            inst = unsafe { (*inst).next };
        }
    }

    if (body as usize) == 0 {
        body = mir_build_fn(
            mut_view(ctx.arena),
            func,
            ctx.thir,
            ctx.hir,
            ctx.interner,
            ctx.db,
            ctx.mono_engine
        );
    }

    if (body as usize) != 0 {
        if (ctx.thir as usize) != 0 && (ctx.hir as usize) != 0 && (ctx.interner as usize) != 0 {
            unsafe {
                mir_drop_elaborate(
                    mut_view(*body),
                    mut_view(*ctx.thir),
                    view(*ctx.hir),
                    ctx.db,
                    view(*ctx.interner),
                    mut_view(ctx.arena)
                );
            }
        }
        if (ctx.mir_map as usize) != 0 {
            unsafe {
                mir_body_map_insert(mut_view(*ctx.mir_map), func as *const HirItem, sym_v, body);
            }
        }
    }
    body
}

pub fn eval_call_into(
    ctx: mut_view<InterpCtx>,
    func_in: *mut HirItem,
    args_raw: *mut InterpValue,
    arg_count: usize,
    out_ret_ptr: *mut u8,
    out_ret_size: usize
) {
    if (func_in as usize) == 0 {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
        return;
    }

    ctx.call_depth = ctx.call_depth + 1;
    if ctx.call_depth_limit > 0 && ctx.call_depth > ctx.call_depth_limit {
        interp_report_stack_limit(mut_view(*ctx));
        ctx.call_depth = ctx.call_depth - 1;
        return;
    }

    let mut func = func_in;
    let abi_v = unsafe { (*func).abi.v };
    if abi_v != 0u32 {
        let fspan = Span {
            file: FileId { v: unsafe { (*func).span.file.v } },
            start: unsafe { (*func).span.start },
            end: unsafe { (*func).span.end },
        };
        interp_report_ffi_not_in_oracle(mut_view(*ctx), fspan);
        ctx.call_depth = ctx.call_depth - 1;
        return;
    }

    if func_has_intrinsic_attr(view(*ctx), func as *const HirItem) {
        let mut scalar_args: [16]u64 = [0u64; 16];
        let mut i: usize = 0;
        while i < arg_count && i < 16 {
            if (args_raw as usize) != 0 {
                let av = unsafe { interp_val_at(args_raw, i) };
                scalar_args[i] = unsafe { (*av).vals[0] };
            }
            i = i + 1;
        }
        let sargs_ptr = unsafe { address_of(scalar_args[0]) };
        let name = unsafe { interner_get(view(*ctx.interner), StrId { v: (*func).name.v }) };
        let name_ptr = name.ptr;
        let name_len = name.len;
        let mut ret_val = InterpValue { vals: [0u64; 8] };
        let host_ok = interp_eval_host_intrinsic(
            mut_view(*ctx),
            StrView { ptr: name_ptr, len: name_len },
            sargs_ptr,
            arg_count,
            mut_view(ret_val)
        );
        if host_ok {
            if (out_ret_ptr as usize) != 0 && out_ret_size > 0 {
                let copy_sz = if out_ret_size > size_of<InterpValue>() { size_of<InterpValue>() } else { out_ret_size };
                let src_bytes = unsafe { address_of(ret_val.vals[0]) as *const u8 };
                unsafe {
                    interp_copy_bytes(out_ret_ptr, src_bytes, copy_sz);
                }
            }
            ctx.call_depth = ctx.call_depth - 1;
            return;
        }
        let mut ret_val_core = InterpValue { vals: [0u64; 8] };
        let core_ok = eval_core_intrinsic(
            mut_view(*ctx),
            func,
            StrView { ptr: name_ptr, len: name_len },
            sargs_ptr,
            arg_count,
            mut_view(ret_val_core)
        );
        if core_ok {
            if (out_ret_ptr as usize) != 0 && out_ret_size > 0 {
                let copy_sz = if out_ret_size > size_of<InterpValue>() { size_of<InterpValue>() } else { out_ret_size };
                let src_bytes = unsafe { address_of(ret_val_core.vals[0]) as *const u8 };
                unsafe {
                    interp_copy_bytes(out_ret_ptr, src_bytes, copy_sz);
                }
            }
            ctx.call_depth = ctx.call_depth - 1;
            return;
        }
    }

    if (unsafe { (*func).kind }) == HIR_ITEM_FN && (unsafe { (*func).body as usize }) == 0 && (ctx.interner as usize) != 0 && (ctx.hir as usize) != 0 {
        let fname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*func).name.v }) };
        let mut it: *mut HirItem = unsafe { (*ctx.hir).items };
        while (it as usize) != 0 {
            if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).body as usize }) != 0 {
                        let mname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*m).name.v }) };
                        if interp_sv_eq(view(fname), view(mname)) {
                            func = m;
                            break;
                        }
                    }
                    m = unsafe { (*m).next };
                }
                if (unsafe { (*func).body as usize }) != 0 {
                    break;
                }
            }
            it = unsafe { (*it).next };
        }
    }

    let body = resolve_or_build_mir_body(mut_view(*ctx), func);
    if (body as usize) == 0 {
        if ctx.is_comptime {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_COMPTIME_CALL);
        } else {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
        }
        ctx.call_depth = ctx.call_depth - 1;
        return;
    }

    exec_mir_body(mut_view(*ctx), body, args_raw, arg_count, out_ret_ptr, out_ret_size);
    ctx.call_depth = ctx.call_depth - 1;
}

pub fn eval_call(
    ctx: mut_view<InterpCtx>,
    func: *mut HirItem,
    args_raw: *mut InterpValue,
    arg_count: usize,
    out_ret: mut_view<InterpValue>
) {
    interp_zero_val(mut_view(*out_ret));
    let ret_ptr = unsafe { address_of_mut(out_ret.vals[0]) as *mut u8 };
    eval_call_into(mut_view(*ctx), func, args_raw, arg_count, ret_ptr, size_of<InterpValue>());
}

// =================================================================================================
// MIR Statement & Rvalue Execution
// =================================================================================================

fn exec_assign_use(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let use_kind = unsafe { (*stmt).rvalue.use_op.kind };
    let dest_ty_v = dest_ty.v;
    if use_kind == MIR_OP_CONST {
        let size = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) };
        let const_ty_v = unsafe { (*stmt).rvalue.use_op.constant.ty.v };
        let t_str_v = unsafe { (*ctx.thir).interner.t_str.v };
        if const_ty_v != 0u32 && const_ty_v == t_str_v {
            let sbytes = unsafe { (*stmt).rvalue.use_op.constant.str_bytes };
            let slen = unsafe { (*stmt).rvalue.use_op.constant.str_len };
            let _ = interp_ensure_const_str_alloc(mut_view(*ctx), sbytes, slen);
            unsafe {
                *(dest as *mut u64) = (sbytes as usize) as u64;
                *((dest as *mut u64) + 1) = slen as u64;
            }
        } else {
            let val = unsafe { (*stmt).rvalue.use_op.constant.val };
            write_scalar_to_ptr(dest, size, val);
        }
    } else {
        let mut src_ty = TypeId { v: 0u32 };
        let mut src_len: u64 = 0u64;
        let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op.place) }, mut_view(src_ty), mut_view(src_len));
        let size = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) as usize };
        if size > 0 {
            unsafe {
                interp_copy_bytes(dest, src as *const u8, size);
            }
        }
    }
}

fn exec_assign_aggregate(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let dest_ty_v = dest_ty.v;
    let ty = unsafe { type_get(view((*ctx.thir).interner), TypeId { v: dest_ty_v }) };
    if (ty as usize) == 0 {
        return;
    }
    let tk = unsafe { (*ty).kind };
    let v_idx = unsafe { (*stmt).rvalue.variant_idx };
    if tk == TY_ENUM {
        unsafe {
            *(dest as *mut u32) = v_idx;
        }
    }

    let op_count = unsafe { (*stmt).rvalue.operand_count };
    let ops = unsafe { (*stmt).rvalue.operands };
    let mut i: usize = 0;
    while i < op_count {
        let mut offset: u32 = 0u32;
        let mut field_ty_v: u32 = 0u32;
        if tk == TY_ARRAY {
            field_ty_v = unsafe { (*ty).elem.v };
            let elem_sz = unsafe { type_size(TypeId { v: field_ty_v }, view((*ctx.thir).interner)) };
            offset = (i as u32) * elem_sz;
        } else if tk == TY_ENUM {
            offset = unsafe { type_enum_field_offset(TypeId { v: dest_ty_v }, v_idx, i, view((*ctx.thir).interner)) };
            let vfields = unsafe { *typeid_ptr_at((*ty).variant_fields, v_idx as usize) };
            field_ty_v = unsafe { (*typeid_at(vfields, i)).v };
        } else {
            offset = unsafe { type_field_offset(TypeId { v: dest_ty_v }, i, view((*ctx.thir).interner)) };
            if tk == TY_STRUCT || tk == TY_TUPLE {
                let fields = unsafe { (*ty).fields };
                field_ty_v = unsafe { (*typeid_at(fields, i)).v };
            } else if tk == TY_CLOSURE {
                if i == 0 {
                    field_ty_v = unsafe { (*ctx.thir).interner.t_u64.v };
                } else {
                    let cap = unsafe { capture_at((*ty).captures, i - 1) };
                    field_ty_v = unsafe { (*cap).ty.v };
                }
            }
        }
        let f_size = unsafe { type_size(TypeId { v: field_ty_v }, view((*ctx.thir).interner)) };
        let f_op = unsafe { mir_op_at(ops, i) };
        let dst_field = unsafe { dest + (offset as usize) };
        if (unsafe { (*f_op).kind }) == MIR_OP_CONST {
            let const_ty_v = unsafe { (*f_op).constant.ty.v };
            let t_str_v = unsafe { (*ctx.thir).interner.t_str.v };
            if const_ty_v != 0u32 && const_ty_v == t_str_v && f_size == 16u32 {
                let sbytes = unsafe { (*f_op).constant.str_bytes };
                let slen = unsafe { (*f_op).constant.str_len };
                let _ = interp_ensure_const_str_alloc(mut_view(*ctx), sbytes, slen);
                unsafe {
                    *(dst_field as *mut u64) = (sbytes as usize) as u64;
                    *((dst_field as *mut u64) + 1) = slen as u64;
                }
            } else {
                let val = unsafe { (*f_op).constant.val };
                write_scalar_to_ptr(dst_field, f_size, val);
            }
        } else {
            let mut s_ty = TypeId { v: 0u32 };
            let mut s_len: u64 = 0u64;
            let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*f_op).place) }, mut_view(s_ty), mut_view(s_len));
            if f_size > 0u32 {
                unsafe {
                    interp_copy_bytes(dst_field, src as *const u8, f_size as usize);
                }
            }
        }
        i = i + 1;
    }
}

fn exec_assign_repeat(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let ty = unsafe { type_get(view((*ctx.thir).interner), dest_ty) };
    if (ty as usize) == 0 {
        return;
    }
    let elem_ty = TypeId { v: unsafe { (*ty).elem.v } };
    let f_size = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) };

    let mut count_val: u64 = unsafe { (*stmt).rvalue.repeat_count };
    let count_op_ptr = unsafe { (*stmt).rvalue.repeat_count_op };
    if (count_op_ptr as usize) != 0 {
        if (unsafe { (*count_op_ptr).kind }) == MIR_OP_CONST {
            count_val = unsafe { (*count_op_ptr).constant.val };
        } else {
            let mut c_ty = TypeId { v: 0u32 };
            let mut c_len: u64 = 0u64;
            let c_ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*count_op_ptr).place) }, mut_view(c_ty), mut_view(c_len));
            count_val = unsafe { *(c_ptr as *const u64) };
        }
    }

    let val_is_const = (unsafe { (*stmt).rvalue.use_op.kind }) == MIR_OP_CONST;
    let mut i: u64 = 0u64;
    while i < count_val {
        let offset = interp_mul_usize(i as usize, f_size as usize);
        let dst_elem = unsafe { dest + offset };
        if val_is_const {
            let val = unsafe { (*stmt).rvalue.use_op.constant.val };
            write_scalar_to_ptr(dst_elem, f_size, val);
        } else {
            let mut s_ty = TypeId { v: 0u32 };
            let mut s_len: u64 = 0u64;
            let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op.place) }, mut_view(s_ty), mut_view(s_len));
            if f_size > 0u32 {
                unsafe {
                    interp_copy_bytes(dst_elem, src as *const u8, f_size as usize);
                }
            }
        }
        i = i + 1u64;
    }
}

fn exec_assign_ref(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let mut src_ty = TypeId { v: 0u32 };
    let mut src_fat_len: u64 = 0u64;
    let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.place) }, mut_view(src_ty), mut_view(src_fat_len));
    let t = unsafe { type_get(view((*ctx.thir).interner), dest_ty) };
    if (t as usize) == 0 {
        return;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_PTR {
        let mut synth = interp_find_synth_addr(view(*ctx), src);
        if synth == 0u64 && (src as usize) != 0 {
            synth = (src as usize) as u64;
        }
        unsafe {
            *(dest as *mut u64) = synth;
        }
        return;
    }

    if tk == TY_VIEW || tk == TY_MUT_VIEW {
        let pt_ty = interp_view_pointee_ty(t);
        let pt_ax = unsafe { type_get(view((*ctx.thir).interner), pt_ty) };
        if (pt_ax as usize) != 0 && (unsafe { (*pt_ax).kind }) == TY_SLICE {
            unsafe {
                *(dest as *mut u64) = (src as usize) as u64;
            }
            let s_t = unsafe { type_get(view((*ctx.thir).interner), src_ty) };
            let mut slen: u64 = 0u64;
            if (s_t as usize) != 0 {
                let stk = unsafe { (*s_t).kind };
                if stk == TY_SLICE {
                    slen = src_fat_len;
                } else if stk == TY_ARRAY {
                    slen = unsafe { (*s_t).array_len };
                } else if stk == TY_STR {
                    slen = unsafe { *((src as *const u64) + 1) };
                    unsafe {
                        *(dest as *mut u64) = *(src as *const u64);
                    }
                } else if stk == TY_VIEW || stk == TY_MUT_VIEW {
                    let s_pt = interp_view_pointee_ty(s_t);
                    let s_pt_ax = unsafe { type_get(view((*ctx.thir).interner), s_pt) };
                    if (s_pt_ax as usize) != 0 && (unsafe { (*s_pt_ax).kind }) == TY_SLICE {
                        slen = unsafe { *((src as *const u64) + 1) };
                        unsafe {
                            *(dest as *mut u64) = *(src as *const u64);
                        }
                    }
                }
            }
            unsafe {
                *((dest as *mut u64) + 1) = slen;
            }
            return;
        }
    }

    unsafe {
        *(dest as *mut u64) = (src as usize) as u64;
    }
}

fn exec_assign_len(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let mut arg_ty = TypeId { v: 0u32 };
    let mut arg_fat_len: u64 = 0u64;
    let ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.place) }, mut_view(arg_ty), mut_view(arg_fat_len));
    let t = unsafe { type_get(view((*ctx.thir).interner), arg_ty) };
    let mut slen: u64 = 0u64;
    if (t as usize) != 0 {
        let tk = unsafe { (*t).kind };
        if tk == TY_ARRAY {
            slen = unsafe { (*t).array_len };
        } else if tk == TY_SLICE {
            slen = arg_fat_len;
        } else if tk == TY_STR {
            slen = unsafe { *((ptr as *const u64) + 1) };
        } else if tk == TY_VIEW || tk == TY_MUT_VIEW {
            let pt_ty = interp_view_pointee_ty(t);
            let pt_ax = unsafe { type_get(view((*ctx.thir).interner), pt_ty) };
            if (pt_ax as usize) != 0 && (unsafe { (*pt_ax).kind }) == TY_SLICE {
                slen = unsafe { *((ptr as *const u64) + 1) };
            }
        }
    }
    let d_size = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) };
    write_scalar_to_ptr(dest, d_size, slen);
}

fn operand_type_id(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, op: view<MirOperand>) -> TypeId {
    if op.kind == MIR_OP_CONST {
        return TypeId { v: op.constant.ty.v };
    }
    if op.place.proj_count == 0 {
        let loc_v = op.place.local.v as usize;
        let decl = unsafe { mir_local_at((*frame.body).locals, loc_v) };
        return TypeId { v: unsafe { (*decl).ty.v } };
    }
    let mut ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let _ = get_place_ptr(mut_view(*ctx), frame, view(op.place), mut_view(ty), mut_view(dummy_len));
    ty
}

fn exec_assign_binop(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) -> u64 {
    let lhs = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.lhs) });
    let rhs = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.rhs) });
    let op = unsafe { (*stmt).rvalue.bin_op };

    let mut ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.lhs) });
    if ty.v == 0u32 {
        ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.rhs) });
    }

    let ty_v = ty.v;
    let mut is_signed = true;
    let mut bits: i32 = 32;
    let tk = classify_int_ty(view(*ctx), TypeId { v: ty_v }, mut_view(is_signed), mut_view(bits));
    let t = if ty_v != 0u32 { unsafe { type_get(view((*ctx.thir).interner), TypeId { v: ty_v }) } } else { 0 as *mut AxType };

    let mut res: u64 = 0u64;
    let mut overflow = false;

    if is_signed {
        let ua: u64 = if (unsafe { (*stmt).rvalue.lhs.kind }) == MIR_OP_CONST {
            lhs
        } else {
            sign_extend_u64(lhs, bits)
        };
        let ub: u64 = if (unsafe { (*stmt).rvalue.rhs.kind }) == MIR_OP_CONST {
            rhs
        } else {
            sign_extend_u64(rhs, bits)
        };

        let sign_a = (ua >> 63u64) & 1u64;
        let sign_b = (ub >> 63u64) & 1u64;
        let mut ur: u64 = 0u64;

        if op == MIR_BINOP_ADD {
            ur = w_add_u64(ua, ub);
            let sign_r = (ur >> 63u64) & 1u64;
            overflow = (sign_a == sign_b) && (sign_r != sign_a);
        } else if op == MIR_BINOP_SUB {
            ur = w_sub_u64(ua, ub);
            let sign_r = (ur >> 63u64) & 1u64;
            overflow = (sign_a != sign_b) && (sign_r != sign_a);
        } else if op == MIR_BINOP_MUL {
            let abs_a: u64 = if sign_a != 0u64 { w_neg_u64(ua) } else { ua };
            let abs_b: u64 = if sign_b != 0u64 { w_neg_u64(ub) } else { ub };
            let mut abs_ovf = false;
            let abs_prod = w_mul_u64_ovf(abs_a, abs_b, mut_view(abs_ovf));
            ur = w_mul_u64(ua, ub);
            if ua == 0u64 || ub == 0u64 {
                overflow = false;
            } else if abs_ovf {
                overflow = true;
            } else if sign_a == sign_b {
                overflow = abs_prod > 0x7FFFFFFFFFFFFFFFu64;
            } else {
                overflow = abs_prod > 0x8000000000000000u64;
            }
        } else if op == MIR_BINOP_DIV {
            if ub == 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_DIV_ZERO);
            } else {
                let min_u64 = sign_extend_u64(1u64 << ((bits - 1) as u64), bits);
                if ub == 0xFFFFFFFFFFFFFFFFu64 && ua == min_u64 {
                    overflow = true;
                    ur = ua;
                } else {
                    let abs_a: u64 = if sign_a != 0u64 { w_neg_u64(ua) } else { ua };
                    let abs_b: u64 = if sign_b != 0u64 { w_neg_u64(ub) } else { ub };
                    let q = abs_a / abs_b;
                    ur = if (sign_a != sign_b) && (q != 0u64) { w_neg_u64(q) } else { q };
                }
            }
        } else if op == MIR_BINOP_REM {
            if ub == 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_DIV_ZERO);
            } else {
                let min_u64 = sign_extend_u64(1u64 << ((bits - 1) as u64), bits);
                if ub == 0xFFFFFFFFFFFFFFFFu64 && ua == min_u64 {
                    overflow = true;
                    ur = 0u64;
                } else {
                    let abs_a: u64 = if sign_a != 0u64 { w_neg_u64(ua) } else { ua };
                    let abs_b: u64 = if sign_b != 0u64 { w_neg_u64(ub) } else { ub };
                    let rem = abs_a % abs_b;
                    ur = if (sign_a != 0u64) && (rem != 0u64) { w_neg_u64(rem) } else { rem };
                }
            }
        } else if op == MIR_BINOP_EQ {
            ur = if ua == ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_NE {
            ur = if ua != ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_LT {
            ur = if signed_lt_u64(ua, ub) { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_LE {
            ur = if signed_le_u64(ua, ub) { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_GT {
            ur = if signed_gt_u64(ua, ub) { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_GE {
            ur = if signed_ge_u64(ua, ub) { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_SHL {
            if sign_b != 0u64 || ub >= (bits as u64) {
                overflow = true;
            } else {
                ur = ua << ub;
            }
        } else if op == MIR_BINOP_SHR {
            if sign_b != 0u64 || ub >= (bits as u64) {
                overflow = true;
            } else if ub == 0u64 {
                ur = ua;
            } else if sign_a != 0u64 {
                let shifted = ua >> ub;
                let sign_ext = ((1u64 << (64u64 - ub)) - 1u64) ^ 0xFFFFFFFFFFFFFFFFu64;
                ur = shifted | sign_ext;
            } else {
                ur = ua >> ub;
            }
        } else if op == MIR_BINOP_BIT_AND {
            ur = ua & ub;
        } else if op == MIR_BINOP_BIT_OR {
            ur = ua | ub;
        } else if op == MIR_BINOP_BIT_XOR {
            ur = ua ^ ub;
        }

        if op == MIR_BINOP_ADD || op == MIR_BINOP_SUB || op == MIR_BINOP_MUL {
            if bits < 64 && !overflow {
                if sign_extend_u64(ur, bits) != ur {
                    overflow = true;
                }
            }
        }

        if bits < 64 {
            res = ur & bit_mask_u64(bits);
        } else {
            res = ur;
        }
    } else {
        let mask = bit_mask_u64(bits);
        let ua = lhs & mask;
        let ub = rhs & mask;
        let mut ur: u64 = 0u64;

        if op == MIR_BINOP_ADD || op == MIR_BINOP_OFFSET {
            if tk == TY_PTR && (t as usize) != 0 {
                let pt_ty = interp_view_pointee_ty(t);
                let mut elem_sz = unsafe { type_size(pt_ty, view((*ctx.thir).interner)) as u64 };
                if elem_sz == 0u64 {
                    elem_sz = 1u64;
                }
                ur = w_add_u64(ua, w_mul_u64(ub, elem_sz));
                interp_validate_ptr_arith(mut_view(*ctx), ua, ur);
                overflow = false;
            } else {
                ur = w_add_u64_ovf(ua, ub, mut_view(overflow));
            }
        } else if op == MIR_BINOP_SUB {
            if tk == TY_PTR && (t as usize) != 0 {
                let pt_ty = interp_view_pointee_ty(t);
                let mut elem_sz = unsafe { type_size(pt_ty, view((*ctx.thir).interner)) as u64 };
                if elem_sz == 0u64 {
                    elem_sz = 1u64;
                }
                let r_ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.rhs) });
                let rt = if r_ty.v != 0u32 { unsafe { type_get(view((*ctx.thir).interner), r_ty) } } else { 0 as *mut AxType };
                if (rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR {
                    let diff = w_sub_u64(ua, ub);
                    if ((diff >> 63u64) & 1u64) != 0u64 {
                        let mag = w_neg_u64(diff) / elem_sz;
                        ur = w_neg_u64(mag);
                    } else {
                        ur = diff / elem_sz;
                    }
                    overflow = false;
                } else {
                    ur = w_sub_u64(ua, w_mul_u64(ub, elem_sz));
                    interp_validate_ptr_arith(mut_view(*ctx), ua, ur);
                    overflow = false;
                }
            } else {
                ur = w_sub_u64_ovf(ua, ub, mut_view(overflow));
            }
        } else if op == MIR_BINOP_MUL {
            ur = w_mul_u64_ovf(ua, ub, mut_view(overflow));
        } else if op == MIR_BINOP_DIV {
            if ub == 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_DIV_ZERO);
            } else {
                ur = ua / ub;
            }
        } else if op == MIR_BINOP_REM {
            if ub == 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_DIV_ZERO);
            } else {
                ur = ua % ub;
            }
        } else if op == MIR_BINOP_EQ {
            ur = if ua == ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_NE {
            ur = if ua != ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_LT {
            ur = if ua < ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_LE {
            ur = if ua <= ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_GT {
            ur = if ua > ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_GE {
            ur = if ua >= ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_SHL {
            if ub >= (bits as u64) {
                overflow = true;
            } else {
                ur = ua << ub;
            }
        } else if op == MIR_BINOP_SHR {
            if ub >= (bits as u64) {
                overflow = true;
            } else {
                ur = ua >> ub;
            }
        } else if op == MIR_BINOP_BIT_AND {
            ur = ua & ub;
        } else if op == MIR_BINOP_BIT_OR {
            ur = ua | ub;
        } else if op == MIR_BINOP_BIT_XOR {
            ur = ua ^ ub;
        }

        if op == MIR_BINOP_ADD || op == MIR_BINOP_SUB || op == MIR_BINOP_MUL {
            if bits < 64 && ur > mask {
                overflow = true;
            }
        }
        res = ur & mask;
    }

    if ctx.failed {
        return 0u64;
    }

    let rv_kind = unsafe { (*stmt).rvalue.kind };
    if rv_kind == MIR_RVALUE_BINARY_OP {
        if overflow {
            if op == MIR_BINOP_SHL || op == MIR_BINOP_SHR {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_SHIFT_RANGE);
            } else if op == MIR_BINOP_ADD || op == MIR_BINOP_SUB || op == MIR_BINOP_MUL || op == MIR_BINOP_DIV || op == MIR_BINOP_REM {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ARITH_OV);
            }
        }
        return res;
    }
    if overflow { 1u64 } else { 0u64 }
}

fn exec_assign_unop(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) -> u64 {
    let op_val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
    let ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });

    let mut is_signed = true;
    let mut bits: i32 = 32;
    let _ = classify_int_ty(view(*ctx), ty, mut_view(is_signed), mut_view(bits));
    let mask = bit_mask_u64(bits);
    let uop = unsafe { (*stmt).rvalue.un_op };

    if uop == MIR_UNOP_NOT {
        return if op_val == 0u64 { 1u64 } else { 0u64 };
    }
    if uop == MIR_UNOP_BITNOT {
        return (op_val ^ 0xFFFFFFFFFFFFFFFFu64) & mask;
    }
    if uop == MIR_UNOP_NEG {
        if is_signed {
            let ua: u64 = if (unsafe { (*stmt).rvalue.use_op.kind }) == MIR_OP_CONST {
                op_val
            } else {
                sign_extend_u64(op_val, bits)
            };
            let min_u64 = sign_extend_u64(1u64 << ((bits - 1) as u64), bits);
            if ua == min_u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ARITH_OV);
                return 0u64;
            }
            return w_neg_u64(ua) & mask;
        } else {
            if (op_val & mask) != 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ARITH_OV);
            }
            return 0u64;
        }
    }
    0u64
}

fn exec_assign_cast(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) -> u64 {
    let op_val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
    let src_ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
    let dest_ty = TypeId { v: unsafe { (*stmt).rvalue.target_ty.v } };

    let mut src_signed = false;
    let mut src_bits: i32 = 64;
    if src_ty.v != 0u32 {
        let _ = classify_int_ty(view(*ctx), src_ty, mut_view(src_signed), mut_view(src_bits));
    }

    let mut dest_signed = false;
    let mut dest_bits: i32 = 64;
    let mut d_kind: u8 = 0u8;
    if dest_ty.v != 0u32 {
        d_kind = classify_int_ty(view(*ctx), dest_ty, mut_view(dest_signed), mut_view(dest_bits));
        if dest_bits == 1 {
            dest_bits = 64;
        }
    }

    let mut res = op_val;
    if src_signed && src_bits < 64 {
        res = sign_extend_u64(res, src_bits);
    }
    if dest_bits < 64 {
        res = res & bit_mask_u64(dest_bits);
    }

    if d_kind == TY_PTR && res != 0u64 {
        let mut found_live = false;
        let mut i: usize = 0;
        while i < ctx.alloc_count {
            let a = unsafe { interp_alloc_at(ctx.allocs, i) };
            let is_live = unsafe { (*a).is_live };
            let base = unsafe { (*a).base_addr };
            let sz = unsafe { (*a).size };
            if is_live && res >= base && res <= base + sz {
                found_live = true;
                break;
            }
            i = i + 1;
        }
        if !found_live {
            interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_USIZE_AS_PTR);
        }
    }
    res
}

// =================================================================================================
// Builtin Call Terminator Dispatch
// =================================================================================================

fn exec_builtin_call(
    ctx: mut_view<InterpCtx>,
    frame: view<CallFrame>,
    term: *mut MirTerminator,
    ft_kind: u8,
    out_next_bb: mut_view<MirBbId>
) -> bool {
    let args = unsafe { (*term).args };
    let target_bb = MirBbId { v: unsafe { (*term).call_target.v } };

    if ft_kind == TY_BUILTIN_PRINT {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let mut bytes: *const u8 = 0 as *const u8;
        let mut slen: usize = 0;
        if (unsafe { (*arg0).kind }) == MIR_OP_CONST {
            bytes = unsafe { (*arg0).constant.str_bytes };
            slen = unsafe { (*arg0).constant.str_len };
        } else {
            let mut ty = TypeId { v: 0u32 };
            let mut fat_len: u64 = 0u64;
            let ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*arg0).place) }, mut_view(ty), mut_view(fat_len));
            let addr = unsafe { *(ptr as *const u64) };
            bytes = interp_resolve_synth_ptr(mut_view(*ctx), addr) as *const u8;
            slen = unsafe { *((ptr as *const u64) + 1) as usize };
        }
        interp_write_out(mut_view(*ctx), bytes, slen);
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_PRINT_INT {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let mut arg_ty_id = TypeId { v: 0u32 };
        if (unsafe { (*arg0).kind }) == MIR_OP_CONST {
            arg_ty_id = TypeId { v: unsafe { (*arg0).constant.ty.v } };
        } else {
            let mut dummy_len: u64 = 0u64;
            let _ = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*arg0).place) }, mut_view(arg_ty_id), mut_view(dummy_len));
        }
        let arg_ty_v = arg_ty_id.v;
        let arg_is_signed = unsafe { type_is_signed(TypeId { v: arg_ty_v }, view((*ctx.thir).interner)) };
        if arg_is_signed {
            let sz = unsafe { type_size(TypeId { v: arg_ty_v }, view((*ctx.thir).interner)) };
            let mut sval = val;
            if sz == 1u32 {
                sval = sign_extend_u64(val, 8);
            } else if sz == 2u32 {
                sval = sign_extend_u64(val, 16);
            } else if sz == 4u32 {
                sval = sign_extend_u64(val, 32);
            }
            interp_write_i64_twos(mut_view(*ctx), sval);
        } else {
            interp_write_u64(mut_view(*ctx), val);
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_NEEDS_DROP {
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let nd = unsafe {
            mir_type_needs_drop_in(elem_ty, view(*ctx.thir), view(*ctx.hir), ctx.db, view(*ctx.interner))
        };
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *dest = if nd { 1u8 } else { 0u8 };
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_DROP_IN_PLACE {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let elem_ty_v = unsafe { (*term).func.constant.val as u32 };
        let sz = unsafe { type_size(TypeId { v: elem_ty_v }, view((*ctx.thir).interner)) };
        let al = unsafe { type_align(TypeId { v: elem_ty_v }, view((*ctx.thir).interner)) };
        let host_ptr = interp_validate_raw_ptr(mut_view(*ctx), addr, sz as u64, al);
        if !ctx.failed {
            let drop_fn = find_drop_fn_for_type(view(*ctx), TypeId { v: elem_ty_v });
            if (drop_fn as usize) != 0 {
                let mut drop_arg = InterpValue { vals: [0u64; 8] };
                drop_arg.vals[0] = (host_ptr as usize) as u64;
                let mut ret = InterpValue { vals: [0u64; 8] };
                let arg_ptr = unsafe { address_of_mut(drop_arg) };
                eval_call(mut_view(*ctx), drop_fn, arg_ptr, 1, mut_view(ret));
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_PTR_COPY || ft_kind == TY_BUILTIN_PTR_COPY_NONOVERLAPPING {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let arg1 = unsafe { mir_op_at(args, 1) };
        let arg2 = unsafe { mir_op_at(args, 2) };
        let src_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let dst_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg1) });
        let count = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg2) });
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let mut elem_sz = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) as u64 };
        if elem_sz == 0u64 {
            elem_sz = 1u64;
        }
        let bytes = w_mul_u64(count, elem_sz);
        let src_host = interp_validate_raw_ptr(mut_view(*ctx), src_addr, bytes, 1u32);
        let dst_host = interp_validate_raw_ptr(mut_view(*ctx), dst_addr, bytes, 1u32);
        if !ctx.failed && bytes > 0u64 {
            if ft_kind == TY_BUILTIN_PTR_COPY_NONOVERLAPPING {
                if src_addr < w_add_u64(dst_addr, bytes) && dst_addr < w_add_u64(src_addr, bytes) {
                    interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_OVERLAP);
                } else {
                    unsafe {
                        interp_copy_bytes(dst_host, src_host as *const u8, bytes as usize);
                    }
                }
            } else {
                unsafe {
                    interp_move_bytes(dst_host, src_host as *const u8, bytes as usize);
                }
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_PTR_WRITE_BYTES {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let arg1 = unsafe { mir_op_at(args, 1) };
        let arg2 = unsafe { mir_op_at(args, 2) };
        let dst_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let byte_val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg1) }) as u8;
        let count = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg2) });
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let mut elem_sz = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) as u64 };
        if elem_sz == 0u64 {
            elem_sz = 1u64;
        }
        let bytes = w_mul_u64(count, elem_sz);
        let dst_host = interp_validate_raw_ptr(mut_view(*ctx), dst_addr, bytes, 1u32);
        if !ctx.failed && bytes > 0u64 {
            unsafe {
                interp_fill_bytes(dst_host, byte_val, bytes as usize);
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_PTR_ADD || ft_kind == TY_BUILTIN_PTR_SUB {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let arg1 = unsafe { mir_op_at(args, 1) };
        let p_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let count = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg1) });
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let mut elem_sz = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) as u64 };
        if elem_sz == 0u64 {
            elem_sz = 1u64;
        }
        let delta = w_mul_u64(count, elem_sz);
        let new_addr = if ft_kind == TY_BUILTIN_PTR_ADD {
            w_add_u64(p_addr, delta)
        } else {
            w_sub_u64(p_addr, delta)
        };
        interp_validate_ptr_arith(mut_view(*ctx), p_addr, new_addr);
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *(dest as *mut u64) = new_addr;
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_SIZE_OF {
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let sz = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) as u64 };
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *(dest as *mut u64) = sz;
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_ALIGN_OF {
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let al = unsafe { type_align(elem_ty, view((*ctx.thir).interner)) as u64 };
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *(dest as *mut u64) = al;
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_NULL || ft_kind == TY_BUILTIN_NULL_MUT {
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *(dest as *mut u64) = 0u64;
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_IS_NULL {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let p_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *dest = if p_addr == 0u64 { 1u8 } else { 0u8 };
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_FORGET {
        *out_next_bb = target_bb;
        return true;
    }

    false
}

// =================================================================================================
// MIR Body Execution Loop
// =================================================================================================

pub fn exec_mir_body(
    ctx: mut_view<InterpCtx>,
    body: *mut MirBody,
    args_raw: *mut InterpValue,
    arg_count: usize,
    out_ret: *mut u8,
    out_ret_size: usize
) {
    if (body as usize) == 0 {
        return;
    }
    let mut frame = CallFrame {
        body: 0 as *mut MirBody,
        local_ptrs: 0 as *mut *mut u8,
        storage: 0 as *mut u8,
        storage_size: 0,
        local_cap: 0,
    };
    let alloc_start = frame_init(mut_view(*ctx), mut_view(frame), body, args_raw, arg_count);
    let bb_count = unsafe { (*body).bb_count };
    let local_count = unsafe { (*body).local_count };
    let mut current_bb = MirBbId { v: 0u32 };

    while !ctx.failed {
        ctx.steps = ctx.steps + 1;
        interp_check_step_limit(mut_view(*ctx));
        if ctx.failed {
            break;
        }
        if (current_bb.v as usize) >= bb_count {
            break;
        }

        let bb = unsafe { mir_bb_at((*body).bbs, current_bb.v as usize) };
        let stmt_count = unsafe { (*bb).stmt_count };
        let stmts = unsafe { (*bb).stmts };
        let mut i: usize = 0;
        while i < stmt_count {
            ctx.steps = ctx.steps + 1;
            interp_check_step_limit(mut_view(*ctx));
            if ctx.failed {
                break;
            }
            let stmt = unsafe { mir_stmt_at(stmts, i) };
            let loc_sp = Span {
                file: FileId { v: unsafe { (*stmt).location.file.v } },
                start: unsafe { (*stmt).location.start },
                end: unsafe { (*stmt).location.end },
            };
            if loc_sp.file.v != 0u32 || loc_sp.start != 0u32 || loc_sp.end != 0u32 {
                ctx.current_span = loc_sp;
            } else {
                ctx.current_span = Span {
                    file: FileId { v: unsafe { (*stmt).span.file.v } },
                    start: unsafe { (*stmt).span.start },
                    end: unsafe { (*stmt).span.end },
                };
            }

            let sk = unsafe { (*stmt).kind };
            if sk == MIR_STMT_ASSIGN {
                let place_loc_v = unsafe { (*stmt).place.local.v as usize };
                let mut is_const_local = false;
                if place_loc_v < local_count {
                    let ldecl = unsafe { mir_local_at((*body).locals, place_loc_v) };
                    if (unsafe { (*ldecl).kind }) == MIR_LOCAL_CONST {
                        is_const_local = true;
                    }
                }
                if !is_const_local {
                    let rvk = unsafe { (*stmt).rvalue.kind };
                    if rvk == MIR_RVALUE_USE {
                        exec_assign_use(mut_view(*ctx), view(frame), stmt);
                    } else if rvk == MIR_RVALUE_AGGREGATE {
                        exec_assign_aggregate(mut_view(*ctx), view(frame), stmt);
                    } else if rvk == MIR_RVALUE_REPEAT {
                        exec_assign_repeat(mut_view(*ctx), view(frame), stmt);
                    } else if rvk == MIR_RVALUE_REF {
                        exec_assign_ref(mut_view(*ctx), view(frame), stmt);
                    } else if rvk == MIR_RVALUE_LEN {
                        exec_assign_len(mut_view(*ctx), view(frame), stmt);
                    } else {
                        let mut val: u64 = 0u64;
                        if rvk == MIR_RVALUE_DISCRIMINANT {
                            let mut src_ty = TypeId { v: 0u32 };
                            let mut src_len: u64 = 0u64;
                            let src = get_place_ptr(mut_view(*ctx), view(frame), unsafe { view((*stmt).rvalue.place) }, mut_view(src_ty), mut_view(src_len));
                            let ty = unsafe { type_get(view((*ctx.thir).interner), src_ty) };
                            if (ty as usize) != 0 && (unsafe { (*ty).kind }) == TY_ENUM {
                                val = unsafe { *(src as *const u32) as u64 };
                            }
                        } else if rvk == MIR_RVALUE_BINARY_OP || rvk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                            val = exec_assign_binop(mut_view(*ctx), view(frame), stmt);
                        } else if rvk == MIR_RVALUE_UNARY_OP {
                            val = exec_assign_unop(mut_view(*ctx), view(frame), stmt);
                        } else if rvk == MIR_RVALUE_CAST {
                            val = exec_assign_cast(mut_view(*ctx), view(frame), stmt);
                        }
                        if !ctx.failed {
                            let mut dest_ty = TypeId { v: 0u32 };
                            let mut dummy_len: u64 = 0u64;
                            let dest = get_place_ptr(mut_view(*ctx), view(frame), unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
                            let dest_size = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) };
                            write_scalar_to_ptr(dest, dest_size, val);
                        }
                    }
                }
            }
            if ctx.failed {
                break;
            }
            i = i + 1;
        }

        if ctx.failed {
            break;
        }

        let term = mir_bb_term_mut(bb);
        let tloc = Span {
            file: FileId { v: unsafe { (*term).location.file.v } },
            start: unsafe { (*term).location.start },
            end: unsafe { (*term).location.end },
        };
        if tloc.file.v != 0u32 || tloc.start != 0u32 || tloc.end != 0u32 {
            ctx.current_span = tloc;
        } else {
            ctx.current_span = Span {
                file: FileId { v: unsafe { (*term).span.file.v } },
                start: unsafe { (*term).span.start },
                end: unsafe { (*term).span.end },
            };
        }

        let tk = unsafe { (*term).kind };
        if tk == MIR_TERM_GOTO {
            current_bb = MirBbId { v: unsafe { (*term).goto_target.v } };
        } else if tk == MIR_TERM_ASSERT {
            let cond = eval_operand_u64(mut_view(*ctx), view(frame), unsafe { view((*term).cond) });
            let expected = unsafe { (*term).expected };
            if (cond != 0u64) != expected {
                let msg_ptr = unsafe { (*term).msg_ptr };
                let msg_len = unsafe { (*term).msg_len };
                if (msg_ptr as usize) != 0 && msg_len > 0 {
                    interp_panic_sv(mut_view(*ctx), StrView { ptr: msg_ptr, len: msg_len });
                } else {
                    interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ASSERT);
                }
                break;
            }
            current_bb = MirBbId { v: unsafe { (*term).assert_target.v } };
        } else if tk == MIR_TERM_RETURN {
            break;
        } else if tk == MIR_TERM_DROP {
            current_bb = MirBbId { v: unsafe { (*term).drop_target.v } };
        } else if tk == MIR_TERM_SWITCH_INT {
            let discr = eval_operand_u64(mut_view(*ctx), view(frame), unsafe { view((*term).discr) });
            let mut next = MirBbId { v: unsafe { (*term).otherwise.v } };
            let scount = unsafe { (*term).switch_count };
            let svals = unsafe { (*term).values };
            let stargets = unsafe { (*term).targets };
            let mut s: usize = 0;
            while s < scount {
                let sv = unsafe { *mir_u64_at(svals, s) };
                if discr == sv {
                    let st = unsafe { mir_bb_id_at(stargets, s) };
                    next = MirBbId { v: unsafe { (*st).v } };
                    break;
                }
                s = s + 1;
            }
            current_bb = next;
        } else if tk == MIR_TERM_CALL {
            let mut handled_builtin = false;
            let mut next_bb = MirBbId { v: 0u32 };
            if (unsafe { (*term).func.kind }) == MIR_OP_CONST {
                let fty_id = TypeId { v: unsafe { (*term).func.constant.ty.v } };
                if fty_id.v != 0u32 && (ctx.thir as usize) != 0 {
                    let ft = unsafe { type_get(view((*ctx.thir).interner), fty_id) };
                    if (ft as usize) != 0 {
                        let ftk = unsafe { (*ft).kind };
                        handled_builtin = exec_builtin_call(mut_view(*ctx), view(frame), term, ftk, mut_view(next_bb));
                    }
                }
            }
            if handled_builtin {
                current_bb = next_bb;
            } else {
                let func_val = eval_operand_u64(mut_view(*ctx), view(frame), unsafe { view((*term).func) });
                let callee = find_func_by_symbol(view(*ctx), func_val);
                if (callee as usize) == 0 {
                    interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
                    break;
                }

                let mut callee_param_count: usize = 0;
                let mut p: *mut HirParam = unsafe { (*callee).params };
                while (p as usize) != 0 {
                    callee_param_count = callee_param_count + 1;
                    p = unsafe { (*p).next };
                }

                let term_arg_count = unsafe { (*term).arg_count };
                let total_args: usize = if callee_param_count > term_arg_count { callee_param_count } else { term_arg_count };
                let cap_count: usize = if callee_param_count > term_arg_count { callee_param_count - term_arg_count } else { 0 };

                let alloc_args: usize = if total_args > 0 { total_args } else { 1 };
                let args_bytes = interp_mul_usize(alloc_args, size_of<InterpValue>());
                let call_args = unsafe { heap_alloc(args_bytes, align_of<InterpValue>()) as *mut InterpValue };
                unsafe {
                    interp_zero_bytes(call_args as *mut u8, args_bytes);
                }

                if cap_count > 0 && (unsafe { (*term).func.kind }) != MIR_OP_CONST {
                    let mut func_ty = TypeId { v: 0u32 };
                    let mut func_len: u64 = 0u64;
                    let closure_ptr = get_place_ptr(mut_view(*ctx), view(frame), unsafe { view((*term).func.place) }, mut_view(func_ty), mut_view(func_len));
                    let mut offset: u32 = 8u32;
                    let mut cp: *mut HirParam = unsafe { (*callee).params };
                    let mut c: usize = 0;
                    while c < cap_count && (cp as usize) != 0 {
                        let pty = unsafe { thir_get_param_type(view(*ctx.thir), cp as *const HirParam) };
                        let cap_field_ty_v: u32 = if (pty as usize) != 0 {
                            unsafe { (*pty).v }
                        } else {
                            unsafe { (*ctx.thir).interner.t_u64.v }
                        };
                        let a = unsafe { type_align(TypeId { v: cap_field_ty_v }, view((*ctx.thir).interner)) };
                        let s = unsafe { type_size(TypeId { v: cap_field_ty_v }, view((*ctx.thir).interner)) };
                        if a > 0u32 {
                            let mask = a - 1u32;
                            offset = (offset + mask) & (mask ^ 0xFFFFFFFFu32);
                        }
                        let copy_s: usize = if s > 0u32 { s as usize } else { 8 };
                        let dst_arg = unsafe { interp_val_at(call_args, c) as *mut u8 };
                        let src_cap = unsafe { closure_ptr + (offset as usize) };
                        unsafe {
                            interp_copy_bytes(dst_arg, src_cap as *const u8, copy_s);
                        }
                        offset = offset + (copy_s as u32);
                        c = c + 1;
                        cp = unsafe { (*cp).next };
                    }
                }

                let term_args = unsafe { (*term).args };
                let mut a_idx: usize = 0;
                while a_idx < term_arg_count {
                    let arg_op = unsafe { mir_op_at(term_args, a_idx) };
                    let dst_slot = unsafe { interp_val_at(call_args, cap_count + a_idx) };
                    if (unsafe { (*arg_op).kind }) == MIR_OP_CONST {
                        unsafe {
                            eval_operand(mut_view(*ctx), view(frame), view(*arg_op), mut_view(*dst_slot));
                        }
                    } else {
                        let mut src_ty = TypeId { v: 0u32 };
                        let mut src_len: u64 = 0u64;
                        let src = get_place_ptr(mut_view(*ctx), view(frame), unsafe { view((*arg_op).place) }, mut_view(src_ty), mut_view(src_len));
                        let mut s_sz = unsafe { type_size(src_ty, view((*ctx.thir).interner)) as usize };
                        if s_sz > size_of<InterpValue>() {
                            s_sz = size_of<InterpValue>();
                        }
                        if s_sz > 0 {
                            unsafe {
                                interp_copy_bytes(dst_slot as *mut u8, src as *const u8, s_sz);
                            }
                        }
                    }
                    a_idx = a_idx + 1;
                }

                let mut dest_ty = TypeId { v: 0u32 };
                let mut dest_len: u64 = 0u64;
                let dest_ptr = get_place_ptr(mut_view(*ctx), view(frame), unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dest_len));
                let dest_sz = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) as usize };

                let ret_alloc_sz: usize = if dest_sz > size_of<InterpValue>() { dest_sz } else { size_of<InterpValue>() };
                let big_ret = unsafe { heap_alloc(ret_alloc_sz, 16) };
                unsafe {
                    interp_zero_bytes(big_ret, ret_alloc_sz);
                }
                eval_call_into(mut_view(*ctx), callee, call_args, total_args, big_ret, ret_alloc_sz);
                unsafe {
                    heap_free(call_args as *mut u8, args_bytes, align_of<InterpValue>());
                }
                if ctx.failed {
                    unsafe {
                        heap_free(big_ret, ret_alloc_sz, 16);
                    }
                    break;
                }
                if dest_sz > 0 && (dest_ptr as usize) != 0 {
                    unsafe {
                        interp_copy_bytes(dest_ptr, big_ret as *const u8, dest_sz);
                    }
                }
                unsafe {
                    heap_free(big_ret, ret_alloc_sz, 16);
                }
                current_bb = MirBbId { v: unsafe { (*term).call_target.v } };
            }
        } else if tk == MIR_TERM_UNREACHABLE {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNREACHABLE);
            break;
        } else {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNSUPPORTED_TERM);
            break;
        }
    }

    frame_cleanup(mut_view(*ctx), mut_view(frame), alloc_start, out_ret, out_ret_size);
}

fn mir_bb_term_mut(bb: *mut MirBb) -> *mut MirTerminator {
    unsafe { address_of_mut((*bb).terminator) }
}

fn mir_body_map_mut_ptr(m: mut_view<MirBodyMap>) -> *mut MirBodyMap {
    unsafe { address_of_mut(*m) }
}

// =================================================================================================
// Public Entry Points: interp_run & interp_eval_const_expr
// =================================================================================================

pub fn interp_run_with_ctx(ctx: mut_view<InterpCtx>) -> i32 {
    let mut local_map = MirBodyMap {
        entries: 0 as *mut compiler.interp.value.MirBodyEntry,
        len: 0,
        cap: 0,
    };
    let mut used_local_map = false;
    if (ctx.mir_map as usize) == 0 {
        mir_body_map_init(mut_view(local_map));
        let mp = mir_body_map_mut_ptr(mut_view(local_map));
        ctx.mir_map = mp;
        used_local_map = true;
    }

    interp_register_const_allocs(mut_view(*ctx));

    if (ctx.main_fn as usize) == 0 && (ctx.hir as usize) != 0 && (ctx.interner as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*ctx.hir).items };
        while (it as usize) != 0 {
            if (unsafe { (*it).kind }) == HIR_ITEM_FN {
                let fname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*it).name.v }) };
                if fname.len == 4 {
                    let b0 = unsafe { *fname.ptr };
                    let b1 = unsafe { *(fname.ptr + 1) };
                    let b2 = unsafe { *(fname.ptr + 2) };
                    let b3 = unsafe { *(fname.ptr + 3) };
                    if b0 == 109u8 && b1 == 97u8 && b2 == 105u8 && b3 == 110u8 {
                        ctx.main_fn = it;
                        break;
                    }
                }
            }
            it = unsafe { (*it).next };
        }
    }

    let mut ret = InterpValue { vals: [0u64; 8] };
    eval_call(mut_view(*ctx), ctx.main_fn, 0 as *mut InterpValue, 0, mut_view(ret));

    if used_local_map {
        mir_body_map_free(mut_view(local_map));
        ctx.mir_map = 0 as *mut MirBodyMap;
    }

    if ctx.failed {
        return ctx.exit_code;
    }
    ret.vals[0] as i32
}

pub fn interp_run(
    main_fn: *mut HirItem,
    thir: *mut Thir,
    hir: *const HirFile,
    interner: *mut StrInterner,
    rmap: *const ResolveMap,
    ast: *const Ast,
    db: *const SourceDatabase,
    sink: *mut DiagSink,
    mono_engine: *mut MonoEngine,
    step_limit: i32,
    call_depth_limit: i32,
    mir_map: *mut MirBodyMap,
    out_buf: *mut DiagBuffer,
    capture_stdout: bool,
    out_panic_sv: *mut StrView
) -> i32 {
    let ctx_ptr = interp_ctx_alloc_zeroed();
    interp_ctx_init(
        unsafe { mut_view(*ctx_ptr) },
        main_fn,
        thir,
        hir,
        interner,
        rmap,
        ast,
        db,
        sink,
        mono_engine,
        step_limit,
        call_depth_limit,
        mir_map,
        out_buf,
        capture_stdout
    );
    interp_host_init(unsafe { mut_view(*ctx_ptr) });

    let code = interp_run_with_ctx(unsafe { mut_view(*ctx_ptr) });

    if (out_panic_sv as usize) != 0 {
        let has_panicked = unsafe { (*ctx_ptr).has_panicked };
        let panic_msg_ptr = unsafe { (*ctx_ptr).panic_msg_ptr };
        if has_panicked && (panic_msg_ptr as usize) != 0 {
            let plen = unsafe { (*ctx_ptr).panic_msg_len };
            let msg_copy = unsafe { heap_alloc(plen + 1, 1) };
            unsafe {
                interp_copy_bytes(msg_copy, panic_msg_ptr, plen);
                let term_p: *mut u8 = msg_copy + plen;
                *term_p = 0u8;
                (*out_panic_sv).ptr = msg_copy as *const u8;
                (*out_panic_sv).len = plen;
            }
        } else {
            unsafe {
                (*out_panic_sv).ptr = 0 as *const u8;
                (*out_panic_sv).len = 0;
            }
        }
    }

    interp_ctx_free_allocs(unsafe { mut_view(*ctx_ptr) });
    unsafe {
        arena_destroy(mut_view((*ctx_ptr).arena));
    }
    interp_host_cleanup(unsafe { mut_view(*ctx_ptr) });
    interp_ctx_dealloc(ctx_ptr);
    code
}

// =================================================================================================
// Constant Expression Evaluation (Port of ax_interp_eval_const_expr)
// =================================================================================================

pub struct InterpConstEvalCtx {
    pub hir: *const HirFile,
    pub interner: *mut StrInterner,
    pub rmap: *const ResolveMap,
    pub ast: *const Ast,
    pub db: *const SourceDatabase,
    pub sink: *mut DiagSink,
}

pub fn interp_eval_const_expr_into(
    cctx: view<InterpConstEvalCtx>,
    thir: *mut Thir,
    expr: *mut HirExpr,
    expected_ty: TypeId,
    limits: ConstLimits,
    out_res: mut_view<ConstEvalResult>
) {
    out_res.ok = false;
    out_res.val.kind = CONST_INT;
    out_res.val.ty = TypeId { v: expected_ty.v };
    out_res.val.int_val = 0u64;
    out_res.val.str_bytes = 0 as *const u8;
    out_res.val.str_len = 0;
    out_res.val.agg_data = 0 as *mut u8;
    out_res.val.agg_size = 0;
    out_res.val.agg_align = 0;
    out_res.val.alloc_id = 0u32;
    out_res.err_code = 0u16;
    out_res.err_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };

    if (expr as usize) == 0 || (thir as usize) == 0 {
        out_res.err_code = AX_CONST_OVERFLOW as u16;
        return;
    }

    let step_limit: i32 = if limits.max_steps > 0 { limits.max_steps } else { 100000 };
    let depth_limit: i32 = if limits.max_call_depth > 0 { limits.max_call_depth } else { 100 };

    let ictx_ptr = interp_ctx_alloc_zeroed();
    interp_ctx_init(
        unsafe { mut_view(*ictx_ptr) },
        0 as *mut HirItem,
        thir,
        cctx.hir,
        cctx.interner,
        cctx.rmap,
        cctx.ast,
        cctx.db,
        cctx.sink,
        0 as *mut MonoEngine,
        step_limit,
        depth_limit,
        0 as *mut MirBodyMap,
        0 as *mut DiagBuffer,
        true
    );
    let body = unsafe {
        mir_build_expr_body(
            mut_view((*ictx_ptr).arena),
            expr,
            TypeId { v: expected_ty.v },
            thir,
            cctx.hir,
            cctx.interner,
            cctx.db
        )
    };
    if (body as usize) == 0 {
        out_res.err_code = AX_CONST_OVERFLOW as u16;
        interp_ctx_free_allocs(unsafe { mut_view(*ictx_ptr) });
        unsafe {
            arena_destroy(mut_view((*ictx_ptr).arena));
        }
        interp_host_cleanup(unsafe { mut_view(*ictx_ptr) });
        interp_ctx_dealloc(ictx_ptr);
        return;
    }

    unsafe {
        (*ictx_ptr).is_comptime = true;
        (*ictx_ptr).build_on_demand = false;
        (*ictx_ptr).next_synth_addr = 0x20000000u64;
        (*ictx_ptr).current_span = Span {
            file: FileId { v: (*expr).span.file.v },
            start: (*expr).span.start,
            end: (*expr).span.end,
        };
    }
    interp_host_init(unsafe { mut_view(*ictx_ptr) });
    interp_register_const_allocs(unsafe { mut_view(*ictx_ptr) });

    let expected_ty_v = expected_ty.v;
    let mut ret_size = unsafe { type_size(TypeId { v: expected_ty_v }, view((*thir).interner)) as usize };
    let mut ret_align = unsafe { type_align(TypeId { v: expected_ty_v }, view((*thir).interner)) as usize };
    if ret_size == 0 {
        ret_size = 8;
    }
    if ret_align == 0 {
        ret_align = 8;
    }

    let exp_t = unsafe { type_get(view((*thir).interner), TypeId { v: expected_ty_v }) };
    let mut is_aggregate = false;
    if (exp_t as usize) != 0 {
        let etk = unsafe { (*exp_t).kind };
        if etk == TY_STRUCT || etk == TY_ARRAY || etk == TY_TUPLE {
            is_aggregate = true;
        }
    }

    let mut ret_buf: *mut u8 = 0 as *mut u8;
    let alloc_buf_sz: usize = if ret_size < 16 { 16 } else { ret_size };
    if is_aggregate {
        ret_buf = unsafe { arena_alloc_raw(mut_view((*thir).interner.arena), ret_size, ret_align) };
        unsafe {
            interp_zero_bytes(ret_buf, ret_size);
        }
    } else {
        ret_buf = unsafe { heap_alloc(alloc_buf_sz, 16) };
        unsafe {
            interp_zero_bytes(ret_buf, alloc_buf_sz);
        }
    }

    exec_mir_body(unsafe { mut_view(*ictx_ptr) }, body, 0 as *mut InterpValue, 0, ret_buf, ret_size);

    let failed = unsafe { (*ictx_ptr).failed };
    if failed {
        out_res.ok = false;
        let err_c = unsafe { (*ictx_ptr).comptime_err_code };
        out_res.err_code = if err_c != 0u16 { err_c } else { AX_CONST_OVERFLOW as u16 };
        let err_sp_file = unsafe { (*ictx_ptr).comptime_err_span.file.v };
        if err_sp_file != 0u32 {
            out_res.err_span = Span {
                file: FileId { v: err_sp_file },
                start: unsafe { (*ictx_ptr).comptime_err_span.start },
                end: unsafe { (*ictx_ptr).comptime_err_span.end },
            };
        } else {
            out_res.err_span = Span {
                file: FileId { v: unsafe { (*expr).span.file.v } },
                start: unsafe { (*expr).span.start },
                end: unsafe { (*expr).span.end },
            };
        }
        if !is_aggregate {
            unsafe {
                heap_free(ret_buf, alloc_buf_sz, 16);
            }
        }
    } else {
        out_res.ok = true;
        if is_aggregate {
            out_res.val.kind = CONST_AGGREGATE;
            out_res.val.agg_data = ret_buf;
            out_res.val.agg_size = ret_size;
            out_res.val.agg_align = ret_align;
        } else if (exp_t as usize) != 0 && (unsafe { (*exp_t).kind }) == TY_STR {
            out_res.val.kind = CONST_STR;
            let addr = unsafe { *(ret_buf as *const u64) };
            let s_ptr = interp_resolve_synth_ptr(unsafe { mut_view(*ictx_ptr) }, addr);
            out_res.val.str_bytes = s_ptr as *const u8;
            out_res.val.str_len = unsafe { *((ret_buf as *const u64) + 1) as usize };
            unsafe {
                heap_free(ret_buf, alloc_buf_sz, 16);
            }
        } else if (exp_t as usize) != 0 && (unsafe { (*exp_t).kind }) == TY_UNIT {
            out_res.val.kind = CONST_UNIT;
            unsafe {
                heap_free(ret_buf, alloc_buf_sz, 16);
            }
        } else {
            out_res.val.kind = CONST_INT;
            if ret_size == 1 {
                out_res.val.int_val = unsafe { *ret_buf as u64 };
            } else if ret_size == 2 {
                out_res.val.int_val = unsafe { *(ret_buf as *const u16) as u64 };
            } else if ret_size == 4 {
                out_res.val.int_val = unsafe { *(ret_buf as *const u32) as u64 };
            } else {
                out_res.val.int_val = unsafe { *(ret_buf as *const u64) };
            }
            unsafe {
                heap_free(ret_buf, alloc_buf_sz, 16);
            }
        }
    }

    interp_ctx_free_allocs(unsafe { mut_view(*ictx_ptr) });
    unsafe {
        arena_destroy(mut_view((*ictx_ptr).arena));
    }
    interp_host_cleanup(unsafe { mut_view(*ictx_ptr) });
    interp_ctx_dealloc(ictx_ptr);
}
