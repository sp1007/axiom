// =================================================================================================
// Safe Wrapping & Two's-Complement 64-bit Arithmetic Helpers
// (Computed via 32-bit halves so host overflow traps are never triggered in interp or native mode)
// =================================================================================================

pub fn w_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let sum_hi = (a_hi + b_hi + carry) & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}

pub fn w_add_u64_ovf(a: u64, b: u64, out_ovf: mut_view<bool>) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let sum_hi_full = a_hi + b_hi + carry;
    *out_ovf = (sum_hi_full >> 32u64) != 0u64;
    let sum_hi = sum_hi_full & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}

pub fn w_neg_u64(a: u64) -> u64 {
    w_add_u64(a ^ 0xFFFFFFFFFFFFFFFFu64, 1u64)
}

pub fn w_sub_u64(a: u64, b: u64) -> u64 {
    w_add_u64(a, w_neg_u64(b))
}

pub fn w_sub_u64_ovf(a: u64, b: u64, out_ovf: mut_view<bool>) -> u64 {
    *out_ovf = a < b;
    w_sub_u64(a, b)
}

fn mul_u16_chunks(x: u64, y: u64) -> u64 {
    ((x as i64) * (y as i64)) as u64
}

pub fn w_mul_u64_ovf(a: u64, b: u64, out_ovf: mut_view<bool>) -> u64 {
    let a0 = a & 0xFFFFu64;
    let a1 = (a >> 16u64) & 0xFFFFu64;
    let a2 = (a >> 32u64) & 0xFFFFu64;
    let a3 = (a >> 48u64) & 0xFFFFu64;
    let b0 = b & 0xFFFFu64;
    let b1 = (b >> 16u64) & 0xFFFFu64;
    let b2 = (b >> 32u64) & 0xFFFFu64;
    let b3 = (b >> 48u64) & 0xFFFFu64;

    let c0 = mul_u16_chunks(a0, b0);
    let c1 = (c0 >> 16u64) + mul_u16_chunks(a0, b1) + mul_u16_chunks(a1, b0);
    let c2 = (c1 >> 16u64) + mul_u16_chunks(a0, b2) + mul_u16_chunks(a1, b1) + mul_u16_chunks(a2, b0);
    let c3 = (c2 >> 16u64) + mul_u16_chunks(a0, b3) + mul_u16_chunks(a1, b2) + mul_u16_chunks(a2, b1) + mul_u16_chunks(a3, b0);
    let high_terms = mul_u16_chunks(a1, b3) + mul_u16_chunks(a2, b2) + mul_u16_chunks(a3, b1) +
        mul_u16_chunks(a2, b3) + mul_u16_chunks(a3, b2) + mul_u16_chunks(a3, b3);
    *out_ovf = ((c3 >> 16u64) != 0u64) || (high_terms != 0u64);
    (c0 & 0xFFFFu64) |
        ((c1 & 0xFFFFu64) << 16u64) |
        ((c2 & 0xFFFFu64) << 32u64) |
        ((c3 & 0xFFFFu64) << 48u64)
}

pub fn w_mul_u64(a: u64, b: u64) -> u64 {
    let mut dummy = false;
    w_mul_u64_ovf(a, b, mut_view(dummy))
}

pub fn bit_mask_u64(bits: i32) -> u64 {
    if bits >= 64 {
        return 0xFFFFFFFFFFFFFFFFu64;
    }
    if bits <= 0 {
        return 0u64;
    }
    (1u64 << (bits as u64)) - 1u64
}

pub fn sign_extend_u64(val: u64, bits: i32) -> u64 {
    if bits >= 64 || bits <= 0 {
        return val;
    }
    let mask = bit_mask_u64(bits);
    let truncated = val & mask;
    let sign_bit = 1u64 << ((bits - 1) as u64);
    if (truncated & sign_bit) != 0u64 {
        return truncated | (mask ^ 0xFFFFFFFFFFFFFFFFu64);
    }
    truncated
}

pub fn signed_lt_u64(ua: u64, ub: u64) -> bool {
    (ua ^ 0x8000000000000000u64) < (ub ^ 0x8000000000000000u64)
}

pub fn signed_le_u64(ua: u64, ub: u64) -> bool {
    (ua ^ 0x8000000000000000u64) <= (ub ^ 0x8000000000000000u64)
}

pub fn signed_gt_u64(ua: u64, ub: u64) -> bool {
    (ua ^ 0x8000000000000000u64) > (ub ^ 0x8000000000000000u64)
}

pub fn signed_ge_u64(ua: u64, ub: u64) -> bool {
    (ua ^ 0x8000000000000000u64) >= (ub ^ 0x8000000000000000u64)
}

// =================================================================================================
// Core Intrinsic Name Table
// =================================================================================================

// Concatenated core intrinsic names:
//   0..6:   "assert"
//   6..17:  "unreachable"
//  17..22:  "panic"
//  22..34:  "wrapping_add"
//  34..46:  "wrapping_sub"
//  46..58:  "wrapping_mul"
//  58..70:  "wrapping_neg"
//  70..81:  "rotate_left"
//  81..93:  "rotate_right"
//  93..106: "leading_zeros"
// 106..120: "trailing_zeros"
// 120..130: "count_ones"
// 130..139: "intrinsic"
const CORE_INTRINSIC_BYTES: [139]u8 = [
    // "assert" (0..6)
    97u8, 115u8, 115u8, 101u8, 114u8, 116u8,
    // "unreachable" (6..17)
    117u8, 110u8, 114u8, 101u8, 97u8, 99u8, 104u8, 97u8, 98u8, 108u8, 101u8,
    // "panic" (17..22)
    112u8, 97u8, 110u8, 105u8, 99u8,
    // "wrapping_add" (22..34)
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 97u8, 100u8, 100u8,
    // "wrapping_sub" (34..46)
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 115u8, 117u8, 98u8,
    // "wrapping_mul" (46..58)
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 109u8, 117u8, 108u8,
    // "wrapping_neg" (58..70)
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 110u8, 101u8, 103u8,
    // "rotate_left" (70..81)
    114u8, 111u8, 116u8, 97u8, 116u8, 101u8, 95u8, 108u8, 101u8, 102u8, 116u8,
    // "rotate_right" (81..93)
    114u8, 111u8, 116u8, 97u8, 116u8, 101u8, 95u8, 114u8, 105u8, 103u8, 104u8, 116u8,
    // "leading_zeros" (93..106)
    108u8, 101u8, 97u8, 100u8, 105u8, 110u8, 103u8, 95u8, 122u8, 101u8, 114u8, 111u8, 115u8,
    // "trailing_zeros" (106..120)
    116u8, 114u8, 97u8, 105u8, 108u8, 105u8, 110u8, 103u8, 95u8, 122u8, 101u8, 114u8, 111u8, 115u8,
    // "count_ones" (120..130)
    99u8, 111u8, 117u8, 110u8, 116u8, 95u8, 111u8, 110u8, 101u8, 115u8,
    // "intrinsic" (130..139)
    105u8, 110u8, 116u8, 114u8, 105u8, 110u8, 115u8, 105u8, 99u8,
];

fn core_name_eq(sv: view<StrView>, off: usize, n: usize) -> bool {
    if sv.len != n || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let b = unsafe { *(sv.ptr + i) };
        if b != CORE_INTRINSIC_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

// Matches `op` or `op_<suffix>` (port of IS_OP macro in interp.c).
fn core_name_is_op(sv: view<StrView>, off: usize, n: usize) -> bool {
    if (sv.len) < n || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let b = unsafe { *(sv.ptr + i) };
        if b != CORE_INTRINSIC_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    if sv.len == n {
        return true;
    }
    let next_ch = unsafe { *(sv.ptr + n) };
    next_ch == 95u8
}

// =================================================================================================
// Output Helpers (print / print_int)
// =================================================================================================

pub fn interp_write_out(ctx: mut_view<InterpCtx>, bytes: *const u8, n: usize) {
    if n == 0 || (bytes as usize) == 0 {
        return;
    }
    if (ctx.out_buf as usize) != 0 {
        unsafe {
            diag_buf_push_bytes(mut_view(*ctx.out_buf), bytes, n);
        }
    }
    if !ctx.capture_stdout {
        unsafe {
            let _ = write(1i64, bytes, n);
        }
    }
}

pub fn interp_write_u64(ctx: mut_view<InterpCtx>, val: u64) {
    let mut buf: [24]u8 = [0u8; 24];
    if val == 0u64 {
        buf[0] = 48u8;
        let ptr = unsafe { address_of(buf[0]) };
        interp_write_out(mut_view(*ctx), ptr, 1);
        return;
    }
    let mut tmp: [24]u8 = [0u8; 24];
    let mut dlen: usize = 0;
    let mut n = val;
    while n > 0u64 {
        tmp[dlen] = (48u64 + (n % 10u64)) as u8;
        n = n / 10u64;
        dlen = dlen + 1;
    }
    let mut i: usize = 0;
    while i < dlen {
        buf[i] = tmp[dlen - 1 - i];
        i = i + 1;
    }
    let ptr = unsafe { address_of(buf[0]) };
    interp_write_out(mut_view(*ctx), ptr, dlen);
}

pub fn interp_write_i64_twos(ctx: mut_view<InterpCtx>, ua: u64) {
    if ((ua >> 63u64) & 1u64) != 0u64 {
        let mut minus_buf: [1]u8 = [45u8];
        let mptr = unsafe { address_of(minus_buf[0]) };
        interp_write_out(mut_view(*ctx), mptr, 1);
        let mag = w_neg_u64(ua);
        interp_write_u64(mut_view(*ctx), mag);
    } else {
        interp_write_u64(mut_view(*ctx), ua);
    }
}

// =================================================================================================
// Function & Destructor Lookup
// =================================================================================================

pub fn find_func_by_symbol(ctx: view<InterpCtx>, sym_v: u64) -> *mut HirItem {
    let target_sym = sym_v as u32;
    if sym_v == 0u64 || target_sym == 0u32 {
        return 0 as *mut HirItem;
    }

    if (ctx.mono_engine as usize) != 0 {
        let mut inst: *mut MonoInstance = unsafe { (*ctx.mono_engine).instances_head };
        while (inst as usize) != 0 {
            let msym = unsafe { (*inst).mangled_sym.v };
            if msym == target_sym {
                let nitem = unsafe { (*inst).new_item };
                if (nitem as usize) != 0 {
                    return nitem;
                }
                return unsafe { (*inst).orig_item };
            }
            inst = unsafe { (*inst).next };
        }
    }

    if (ctx.hir as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*ctx.hir).items };
        while (it as usize) != 0 {
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_FN && (unsafe { (*it).symbol.v }) == target_sym {
                return it;
            }
            if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).symbol.v }) == target_sym {
                        return m;
                    }
                    m = unsafe { (*m).next };
                }
            }
            it = unsafe { (*it).next };
        }
    }

    let mut target_name = StrId { v: 0u32 };
    if (ctx.ast as usize) != 0 && (ctx.rmap as usize) != 0 {
        let mut ait: *mut AstItem = unsafe { (*ctx.ast).items };
        while (ait as usize) != 0 {
            let it_sym = unsafe { nodemap_get(view((*ctx.rmap).node_map), ait as usize) };
            if (it_sym as usize) != 0 && (unsafe { (*it_sym).v }) == target_sym {
                if (unsafe { (*ait).kind }) == ITEM_FN {
                    target_name = StrId { v: unsafe { (*ait).name.v } };
                }
                break;
            }
            let ak = unsafe { (*ait).kind };
            if ak == ITEM_IMPL || ak == ITEM_TRAIT {
                let mut am: *mut AstItem = unsafe { (*ait).members };
                while (am as usize) != 0 {
                    let m_sym = unsafe { nodemap_get(view((*ctx.rmap).node_map), am as usize) };
                    if (m_sym as usize) != 0 && (unsafe { (*m_sym).v }) == target_sym {
                        if (unsafe { (*am).kind }) == ITEM_FN {
                            target_name = StrId { v: unsafe { (*am).name.v } };
                        }
                        break;
                    }
                    am = unsafe { (*am).next };
                }
                if target_name.v != 0u32 {
                    break;
                }
            }
            ait = unsafe { (*ait).next };
        }
    }

    if target_name.v == 0u32 || (ctx.hir as usize) == 0 {
        return 0 as *mut HirItem;
    }

    let mut it2: *mut HirItem = unsafe { (*ctx.hir).items };
    while (it2 as usize) != 0 {
        let ik = unsafe { (*it2).kind };
        if ik == HIR_ITEM_FN && (unsafe { (*it2).name.v }) == target_name.v {
            return it2;
        }
        if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*it2).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).name.v }) == target_name.v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        it2 = unsafe { (*it2).next };
    }
    0 as *mut HirItem
}

pub fn find_drop_fn_for_type(ctx: view<InterpCtx>, ty_id: TypeId) -> *mut HirItem {
    if ty_id.v == 0u32 || (ctx.thir as usize) == 0 || (ctx.hir as usize) == 0 || (ctx.interner as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let ty = unsafe { type_get(view((*ctx.thir).interner), TypeId { v: ty_id.v }) };
    if (ty as usize) == 0 || (unsafe { (*ty).kind }) != TY_STRUCT {
        return 0 as *mut HirItem;
    }
    let def = unsafe { (*ty).def as *const HirItem };
    let drop_fn = unsafe {
        drop_find_impl_fn_with_thir(TypeId { v: ty_id.v }, view(*ctx.thir), view(*ctx.hir), def, ctx.db, view(*ctx.interner))
    };
    drop_fn as *mut HirItem
}

// =================================================================================================
// Operand & Type Width Helpers
// =================================================================================================

fn is_atomic_struct_ty(ctx: view<InterpCtx>, ty_id: TypeId) -> bool {
    if ty_id.v == 0u32 || (ctx.thir as usize) == 0 || (ctx.interner as usize) == 0 {
        return false;
    }
    let ty = unsafe { type_get(view((*ctx.thir).interner), ty_id) };
    if (ty as usize) == 0 || (unsafe { (*ty).kind }) != TY_STRUCT {
        return false;
    }
    let mut tname_id = unsafe { (*ty).name.v };
    if tname_id == 0u32 {
        let def = unsafe { (*ty).def };
        if (def as usize) != 0 {
            tname_id = unsafe { (*def).name.v };
        }
    }
    if tname_id == 0u32 {
        return false;
    }
    let sv = unsafe { interner_get(view(*ctx.interner), StrId { v: tname_id }) };
    let slen = sv.len;
    if slen < 6 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 65u8 && *(sv.ptr + 1) == 116u8 && *(sv.ptr + 2) == 111u8 &&
        *(sv.ptr + 3) == 109u8 && *(sv.ptr + 4) == 105u8 && *(sv.ptr + 5) == 99u8
    }
}

fn extract_atomic_elem_ty(ctx: view<InterpCtx>, ty_id: TypeId) -> TypeId {
    let tid_v = ty_id.v;
    let check_ty = TypeId { v: tid_v };
    if !is_atomic_struct_ty(ctx, check_ty) {
        return TypeId { v: 0u32 };
    }
    let lookup_ty = TypeId { v: tid_v };
    let ty = unsafe { type_get(view((*ctx.thir).interner), lookup_ty) };
    if (unsafe { (*ty).field_count }) == 0 || (unsafe { (*ty).fields as usize }) == 0 {
        return TypeId { v: 0u32 };
    }
    let f0 = unsafe { typeid_at((*ty).fields, 0) };
    TypeId { v: unsafe { (*f0).v } }
}

fn place_has_raw_ptr_deref(ctx: view<InterpCtx>, frame: view<CallFrame>, place: view<MirPlace>) -> bool {
    if place.proj_count == 0 || (frame.body as usize) == 0 || (ctx.thir as usize) == 0 {
        return false;
    }
    let lcount = unsafe { (*frame.body).local_count };
    if (place.local.v as usize) >= lcount {
        return false;
    }
    let decl = unsafe { mir_local_at((*frame.body).locals, place.local.v as usize) };
    let lty = unsafe { type_get(view((*ctx.thir).interner), TypeId { v: (*decl).ty.v }) };
    let p0 = unsafe { mir_proj_at(place.projs, 0) };
    if (unsafe { (*p0).kind }) == MIR_PROJ_DEREF && (lty as usize) != 0 && (unsafe { (*lty).kind }) == TY_PTR {
        return true;
    }
    false
}

// "__ax_thread_self_entry" (22 bytes)
const INTERP_SELF_ENTRY_BYTES: [22]u8 = [
    95u8, 95u8, 97u8, 120u8, 95u8,
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 95u8,
    115u8, 101u8, 108u8, 102u8, 95u8,
    101u8, 110u8, 116u8, 114u8, 121u8,
];

fn is_self_entry_fn_item(ctx: view<InterpCtx>, func: *const HirItem) -> bool {
    if (func as usize) == 0 || (ctx.interner as usize) == 0 {
        return false;
    }
    let nid = unsafe { (*func).name.v };
    if nid == 0u32 {
        return false;
    }
    let sv = unsafe { interner_get(view(*ctx.interner), StrId { v: nid }) };
    if sv.len != 22 || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < 22 {
        if (unsafe { *(sv.ptr + i) }) != INTERP_SELF_ENTRY_BYTES[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn resolve_const_op_val(ctx: view<InterpCtx>, frame: view<CallFrame>, op: view<MirOperand>) -> u64 {
    let val = op.constant.val;
    if val != 0u64 && (frame.body as usize) != 0 && op.constant.ty.v != 0u32 && (ctx.thir as usize) != 0 {
        let t = unsafe { type_get(view((*ctx.thir).interner), TypeId { v: op.constant.ty.v }) };
        if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_FN {
            let fitem = find_func_by_symbol(ctx, val);
            if (fitem as usize) != 0 && is_self_entry_fn_item(ctx, fitem as *const HirItem) {
                let cur_sym = unsafe { (*frame.body).sym.v };
                if cur_sym != 0u32 {
                    return cur_sym as u64;
                }
            }
        }
    }
    val
}

fn eval_operand_u64_raw(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, op: view<MirOperand>) -> u64 {
    if op.kind == MIR_OP_CONST {
        return resolve_const_op_val(view(*ctx), frame, op);
    }
    let mut ty = TypeId { v: 0u32 };
    let mut fat_len: u64 = 0u64;
    let ptr = get_place_ptr(mut_view(*ctx), frame, view(op.place), mut_view(ty), mut_view(fat_len));
    let sz = unsafe { type_size(ty, view((*ctx.thir).interner)) };
    if sz == 1u32 {
        return unsafe { *ptr as u64 };
    }
    if sz == 2u32 {
        return unsafe { *(ptr as *const u16) as u64 };
    }
    if sz == 4u32 {
        return unsafe { *(ptr as *const u32) as u64 };
    }
    unsafe { *(ptr as *const u64) }
}

pub fn eval_operand_u64(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, op: view<MirOperand>) -> u64 {
    if op.kind == MIR_OP_CONST {
        return resolve_const_op_val(view(*ctx), frame, op);
    }
    let mut ty = TypeId { v: 0u32 };
    let mut fat_len: u64 = 0u64;
    let ptr = get_place_ptr(mut_view(*ctx), frame, view(op.place), mut_view(ty), mut_view(fat_len));
    let sz = unsafe { type_size(ty, view((*ctx.thir).interner)) };
    if op.place.proj_count > 0 {
        let is_raw = place_has_raw_ptr_deref(view(*ctx), frame, view(op.place));
        oracle_record_ordinary_read(mut_view(*ctx), ptr as *const u8, sz, is_raw);
    }
    if sz == 1u32 {
        return unsafe { *ptr as u64 };
    }
    if sz == 2u32 {
        return unsafe { *(ptr as *const u16) as u64 };
    }
    if sz == 4u32 {
        return unsafe { *(ptr as *const u32) as u64 };
    }
    unsafe { *(ptr as *const u64) }
}

fn write_scalar_to_ptr(dest: *mut u8, size: u32, val: u64) {
    if (dest as usize) == 0 {
        return;
    }
    if size == 1u32 {
        unsafe {
            *dest = val as u8;
        }
    } else if size == 2u32 {
        unsafe {
            *(dest as *mut u16) = val as u16;
        }
    } else if size == 4u32 {
        unsafe {
            *(dest as *mut u32) = val as u32;
        }
    } else if size == 8u32 {
        unsafe {
            *(dest as *mut u64) = val;
        }
    }
}

fn classify_int_ty(ctx: view<InterpCtx>, ty: TypeId, out_signed: mut_view<bool>, out_bits: mut_view<i32>) -> u8 {
    *out_signed = true;
    *out_bits = 32;
    if ty.v == 0u32 || (ctx.thir as usize) == 0 {
        return 0u8;
    }
    let t = unsafe { type_get(view((*ctx.thir).interner), ty) };
    if (t as usize) == 0 {
        return 0u8;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_I8 {
        *out_signed = true;
        *out_bits = 8;
    } else if tk == TY_I16 {
        *out_signed = true;
        *out_bits = 16;
    } else if tk == TY_I32 {
        *out_signed = true;
        *out_bits = 32;
    } else if tk == TY_I64 || tk == TY_ISIZE {
        *out_signed = true;
        *out_bits = 64;
    } else if tk == TY_U8 {
        *out_signed = false;
        *out_bits = 8;
    } else if tk == TY_U16 {
        *out_signed = false;
        *out_bits = 16;
    } else if tk == TY_U32 || tk == TY_CHAR {
        *out_signed = false;
        *out_bits = 32;
    } else if tk == TY_U64 || tk == TY_USIZE {
        *out_signed = false;
        *out_bits = 64;
    } else if tk == TY_BOOL {
        *out_signed = false;
        *out_bits = 1;
    } else if tk == TY_PTR {
        *out_signed = false;
        *out_bits = 64;
    }
    tk
}

// =================================================================================================
// Core Intrinsic & Function Call Evaluation
// =================================================================================================

fn func_has_intrinsic_attr(ctx: view<InterpCtx>, func: *const HirItem) -> bool {
    if (func as usize) == 0 || (ctx.interner as usize) == 0 {
        return false;
    }
    let mut attr: *mut HirAttr = unsafe { (*func).attrs };
    while (attr as usize) != 0 {
        let aname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*attr).name.v }) };
        if core_name_eq(view(aname), 130, 9) {
            return true;
        }
        if aname.len == 4 && (aname.ptr as usize) != 0 {
            let b0 = unsafe { *aname.ptr };
            let b1 = unsafe { *(aname.ptr + 1) };
            let b2 = unsafe { *(aname.ptr + 2) };
            let b3 = unsafe { *(aname.ptr + 3) };
            if b0 == 108u8 && b1 == 97u8 && b2 == 110u8 && b3 == 103u8 {
                let fid = unsafe { (*func).name.v };
                if fid != 0u32 {
                    let fname = unsafe { interner_get(view(*ctx.interner), StrId { v: fid }) };
                    if interp_host_thread_intrinsic_kind(view(fname)) != HOST_INTR_NONE {
                        return true;
                    }
                }
            }
        }
        attr = unsafe { (*attr).next };
    }
    false
}

fn eval_core_intrinsic(
    ctx: mut_view<InterpCtx>,
    func: *mut HirItem,
    name: StrView,
    args: *const u64,
    arg_count: usize,
    out_ret: mut_view<InterpValue>
) -> bool {
    let a0: u64 = if arg_count > 0 && (args as usize) != 0 { unsafe { *args } } else { 0u64 };
    let a1: u64 = if arg_count > 1 && (args as usize) != 0 { unsafe { *(args + 1) } } else { 0u64 };

    if core_name_eq(view(name), 0, 6) {
        if arg_count > 0 && a0 == 0u64 {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ASSERT);
        }
        out_ret.vals[0] = 0u64;
        return true;
    }
    if core_name_eq(view(name), 6, 11) {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNREACHABLE);
        return true;
    }
    if core_name_eq(view(name), 17, 5) {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_PANIC);
        return true;
    }

    let mut bits: i32 = 64;
    if (ctx.thir as usize) != 0 {
        let fn_ty_ptr = unsafe { thir_get_item_type(view(*ctx.thir), func as *const HirItem) };
        if (fn_ty_ptr as usize) != 0 {
            let fn_ty_id = TypeId { v: unsafe { (*fn_ty_ptr).v } };
            let fn_ty = unsafe { type_get(view((*ctx.thir).interner), fn_ty_id) };
            if (fn_ty as usize) != 0 && (unsafe { (*fn_ty).kind }) == TY_FN && (unsafe { (*fn_ty).ret_type.v }) != 0u32 && (unsafe { (*fn_ty).param_count }) > 0 {
                let p0_id = TypeId { v: unsafe { (*typeid_at((*fn_ty).param_types, 0)).v } };
                let op_ty = unsafe { type_get(view((*ctx.thir).interner), p0_id) };
                if (op_ty as usize) != 0 {
                    let ok = unsafe { (*op_ty).kind };
                    if ok == TY_I8 || ok == TY_U8 {
                        bits = 8;
                    } else if ok == TY_I16 || ok == TY_U16 {
                        bits = 16;
                    } else if ok == TY_I32 || ok == TY_U32 {
                        bits = 32;
                    } else {
                        bits = 64;
                    }
                }
            }
        }
    }
    let mask = bit_mask_u64(bits);
    let u_bits = bits as u64;

    if core_name_is_op(view(name), 22, 12) {
        if arg_count == 2 {
            let r = w_add_u64(a0, a1);
            out_ret.vals[0] = r & mask;
        }
        return true;
    }
    if core_name_is_op(view(name), 34, 12) {
        if arg_count == 2 {
            let r = w_sub_u64(a0, a1);
            out_ret.vals[0] = r & mask;
        }
        return true;
    }
    if core_name_is_op(view(name), 46, 12) {
        if arg_count == 2 {
            let r = w_mul_u64(a0, a1);
            out_ret.vals[0] = r & mask;
        }
        return true;
    }
    if core_name_is_op(view(name), 58, 12) {
        if arg_count == 1 {
            let r = w_neg_u64(a0);
            out_ret.vals[0] = r & mask;
        }
        return true;
    }
    if core_name_is_op(view(name), 70, 11) {
        if arg_count == 2 {
            let v = a0 & mask;
            let n = (a1 & 0xFFFFFFFFu64) % u_bits;
            if n == 0u64 {
                out_ret.vals[0] = v;
            } else {
                out_ret.vals[0] = ((v << n) | (v >> (u_bits - n))) & mask;
            }
        }
        return true;
    }
    if core_name_is_op(view(name), 81, 12) {
        if arg_count == 2 {
            let v = a0 & mask;
            let n = (a1 & 0xFFFFFFFFu64) % u_bits;
            if n == 0u64 {
                out_ret.vals[0] = v;
            } else {
                out_ret.vals[0] = ((v >> n) | (v << (u_bits - n))) & mask;
            }
        }
        return true;
    }
    if core_name_is_op(view(name), 93, 13) {
        if arg_count == 1 {
            let val = a0 & mask;
            if val == 0u64 {
                out_ret.vals[0] = u_bits;
            } else {
                let mut lz: u64 = 0u64;
                let mut i: i32 = bits - 1;
                while i >= 0 {
                    if ((val >> (i as u64)) & 1u64) != 0u64 {
                        break;
                    }
                    lz = lz + 1u64;
                    i = i - 1;
                }
                out_ret.vals[0] = lz;
            }
        }
        return true;
    }
    if core_name_is_op(view(name), 106, 14) {
        if arg_count == 1 {
            let val = a0 & mask;
            if val == 0u64 {
                out_ret.vals[0] = u_bits;
            } else {
                let mut tz: u64 = 0u64;
                let mut i: i32 = 0;
                while i < bits {
                    if ((val >> (i as u64)) & 1u64) != 0u64 {
                        break;
                    }
                    tz = tz + 1u64;
                    i = i + 1;
                }
                out_ret.vals[0] = tz;
            }
        }
        return true;
    }
    if core_name_is_op(view(name), 120, 10) {
        if arg_count == 1 {
            let val = a0 & mask;
            let mut ones: u64 = 0u64;
            let mut i: i32 = 0;
            while i < bits {
                if ((val >> (i as u64)) & 1u64) != 0u64 {
                    ones = ones + 1u64;
                }
                i = i + 1;
            }
            out_ret.vals[0] = ones;
        }
        return true;
    }
    false
}

fn resolve_or_build_mir_body(ctx: mut_view<InterpCtx>, func: *mut HirItem) -> *mut MirBody {
    if (func as usize) == 0 {
        return 0 as *mut MirBody;
    }
    let sym_v = unsafe { (*func).symbol.v };
    if (ctx.mir_map as usize) != 0 {
        let cached = unsafe { mir_body_map_get_by_item(view(*ctx.mir_map), func as *const HirItem) };
        if (cached as usize) != 0 {
            return cached;
        }
        if sym_v != 0u32 {
            let cached_sym = unsafe { mir_body_map_get_by_sym(view(*ctx.mir_map), sym_v) };
            if (cached_sym as usize) != 0 {
                return cached_sym;
            }
        }
    }

    if ctx.is_comptime || !ctx.build_on_demand {
        return 0 as *mut MirBody;
    }

    let mut body: *mut MirBody = 0 as *mut MirBody;
    if (ctx.mono_engine as usize) != 0 {
        let mut inst: *mut MonoInstance = unsafe { (*ctx.mono_engine).instances_head };
        while (inst as usize) != 0 {
            let nitem = unsafe { (*inst).new_item };
            let oitem = unsafe { (*inst).orig_item };
            let msym = unsafe { (*inst).mangled_sym.v };
            if nitem == func || (sym_v != 0u32 && msym == sym_v) {
                let mb_ptr = unsafe { (*inst).mir_body as *mut MirBody };
                if (mb_ptr as usize) != 0 {
                    body = mb_ptr;
                } else {
                    let target_fn = if (nitem as usize) != 0 { nitem } else { oitem };
                    body = unsafe {
                        mir_build_fn_subst(
                            mut_view(ctx.arena),
                            target_fn,
                            ctx.thir,
                            ctx.hir,
                            ctx.interner,
                            ctx.db,
                            ctx.mono_engine,
                            view((*inst).args)
                        )
                    };
                    if (body as usize) != 0 && msym != 0u32 {
                        unsafe {
                            (*body).sym.v = msym;
                        }
                    }
                }
                break;
            }
            inst = unsafe { (*inst).next };
        }
    }

    if (body as usize) == 0 {
        body = mir_build_fn(
            mut_view(ctx.arena),
            func,
            ctx.thir,
            ctx.hir,
            ctx.interner,
            ctx.db,
            ctx.mono_engine
        );
    }

    if (body as usize) != 0 {
        if (ctx.thir as usize) != 0 && (ctx.hir as usize) != 0 && (ctx.interner as usize) != 0 {
            unsafe {
                mir_drop_elaborate(
                    mut_view(*body),
                    mut_view(*ctx.thir),
                    view(*ctx.hir),
                    ctx.db,
                    view(*ctx.interner),
                    mut_view(ctx.arena)
                );
            }
        }
        if (ctx.mir_map as usize) != 0 {
            unsafe {
                mir_body_map_insert(mut_view(*ctx.mir_map), func as *const HirItem, sym_v, body);
            }
        }
    }
    body
}

pub fn eval_call_into(
    ctx: mut_view<InterpCtx>,
    func_in: *mut HirItem,
    args_raw: *mut InterpValue,
    arg_count: usize,
    out_ret_ptr: *mut u8,
    out_ret_size: usize
) {
    if (func_in as usize) == 0 {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
        return;
    }

    if !ctx.is_comptime && ctx.call_depth == 0 && oracle_sched_ptr(view(*ctx)) == 0 && program_uses_host_threads(view(*ctx)) {
        sched_run_main(mut_view(*ctx), func_in, args_raw, arg_count, out_ret_ptr, out_ret_size);
        return;
    }

    ctx.call_depth = ctx.call_depth + 1;
    if ctx.call_depth_limit > 0 && ctx.call_depth > ctx.call_depth_limit {
        interp_report_stack_limit(mut_view(*ctx));
        ctx.call_depth = ctx.call_depth - 1;
        return;
    }

    let mut func = func_in;
    let abi_v = unsafe { (*func).abi.v };
    if abi_v != 0u32 {
        let fspan = Span {
            file: FileId { v: unsafe { (*func).span.file.v } },
            start: unsafe { (*func).span.start },
            end: unsafe { (*func).span.end },
        };
        interp_report_ffi_not_in_oracle(mut_view(*ctx), fspan);
        ctx.call_depth = ctx.call_depth - 1;
        return;
    }

    if func_has_intrinsic_attr(view(*ctx), func as *const HirItem) {
        let mut scalar_args: [16]u64 = [0u64; 16];
        let mut i: usize = 0;
        while i < arg_count && i < 16 {
            if (args_raw as usize) != 0 {
                let av = unsafe { interp_val_at(args_raw, i) };
                scalar_args[i] = unsafe { (*av).vals[0] };
            }
            i = i + 1;
        }
        let sargs_ptr = unsafe { address_of(scalar_args[0]) };
        let name = unsafe { interner_get(view(*ctx.interner), StrId { v: (*func).name.v }) };
        let name_ptr = name.ptr;
        let name_len = name.len;
        let mut ret_val = InterpValue { vals: [0u64; 32] };
        let host_ok = interp_eval_host_intrinsic(
            mut_view(*ctx),
            StrView { ptr: name_ptr, len: name_len },
            sargs_ptr,
            arg_count,
            mut_view(ret_val)
        );
        if host_ok {
            if (out_ret_ptr as usize) != 0 && out_ret_size > 0 {
                let copy_sz = if out_ret_size > size_of<InterpValue>() { size_of<InterpValue>() } else { out_ret_size };
                let src_bytes = unsafe { address_of(ret_val.vals[0]) as *const u8 };
                unsafe {
                    interp_copy_bytes(out_ret_ptr, src_bytes, copy_sz);
                }
            }
            ctx.call_depth = ctx.call_depth - 1;
            return;
        }
        let mut ret_val_core = InterpValue { vals: [0u64; 32] };
        let core_ok = eval_core_intrinsic(
            mut_view(*ctx),
            func,
            StrView { ptr: name_ptr, len: name_len },
            sargs_ptr,
            arg_count,
            mut_view(ret_val_core)
        );
        if core_ok {
            if (out_ret_ptr as usize) != 0 && out_ret_size > 0 {
                let copy_sz = if out_ret_size > size_of<InterpValue>() { size_of<InterpValue>() } else { out_ret_size };
                let src_bytes = unsafe { address_of(ret_val_core.vals[0]) as *const u8 };
                unsafe {
                    interp_copy_bytes(out_ret_ptr, src_bytes, copy_sz);
                }
            }
            ctx.call_depth = ctx.call_depth - 1;
            return;
        }
    }

    if (unsafe { (*func).kind }) == HIR_ITEM_FN && (unsafe { (*func).body as usize }) == 0 && (ctx.interner as usize) != 0 && (ctx.hir as usize) != 0 {
        let fname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*func).name.v }) };
        let mut it: *mut HirItem = unsafe { (*ctx.hir).items };
        while (it as usize) != 0 {
            if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).body as usize }) != 0 {
                        let mname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*m).name.v }) };
                        if interp_sv_eq(view(fname), view(mname)) {
                            func = m;
                            break;
                        }
                    }
                    m = unsafe { (*m).next };
                }
                if (unsafe { (*func).body as usize }) != 0 {
                    break;
                }
            }
            it = unsafe { (*it).next };
        }
    }

    let body = resolve_or_build_mir_body(mut_view(*ctx), func);
    if (body as usize) == 0 {
        if ctx.is_comptime {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_COMPTIME_CALL);
        } else {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
        }
        ctx.call_depth = ctx.call_depth - 1;
        return;
    }

    exec_mir_body(mut_view(*ctx), body, args_raw, arg_count, out_ret_ptr, out_ret_size);
    ctx.call_depth = ctx.call_depth - 1;
}

pub fn eval_call(
    ctx: mut_view<InterpCtx>,
    func: *mut HirItem,
    args_raw: *mut InterpValue,
    arg_count: usize,
    out_ret: mut_view<InterpValue>
) {
    interp_zero_val(mut_view(*out_ret));
    let ret_ptr = unsafe { address_of_mut(out_ret.vals[0]) as *mut u8 };
    eval_call_into(mut_view(*ctx), func, args_raw, arg_count, ret_ptr, size_of<InterpValue>());
}

// =================================================================================================
// MIR Statement & Rvalue Execution
// =================================================================================================

fn exec_assign_use(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let use_kind = unsafe { (*stmt).rvalue.use_op.kind };
    let dest_ty_v = dest_ty.v;
    let d_size = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) };
    let check_dest_ty = TypeId { v: dest_ty_v };
    if is_atomic_struct_ty(view(*ctx), check_dest_ty) {
        oracle_reset_atomic_loc(mut_view(*ctx), dest as *const u8, d_size);
    } else if (unsafe { (*stmt).place.proj_count }) > 0 || oracle_has_active_atomic_at(view(*ctx), dest as *const u8, d_size) {
        oracle_record_ordinary_write(mut_view(*ctx), dest as *const u8, d_size);
        if ctx.failed {
            return;
        }
    }
    if use_kind == MIR_OP_CONST {
        let size = d_size;
        let const_ty_v = unsafe { (*stmt).rvalue.use_op.constant.ty.v };
        let t_str_v = unsafe { (*ctx.thir).interner.t_str.v };
        if const_ty_v != 0u32 && const_ty_v == t_str_v {
            let sbytes = unsafe { (*stmt).rvalue.use_op.constant.str_bytes };
            let slen = unsafe { (*stmt).rvalue.use_op.constant.str_len };
            let _ = interp_ensure_const_str_alloc(mut_view(*ctx), sbytes, slen);
            unsafe {
                *(dest as *mut u64) = (sbytes as usize) as u64;
                *((dest as *mut u64) + 1) = slen as u64;
            }
        } else {
            let val = resolve_const_op_val(view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
            write_scalar_to_ptr(dest, size, val);
        }
    } else {
        let mut src_ty = TypeId { v: 0u32 };
        let mut src_len: u64 = 0u64;
        let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op.place) }, mut_view(src_ty), mut_view(src_len));
        if (unsafe { (*stmt).rvalue.use_op.place.proj_count }) > 0 {
            let is_raw = place_has_raw_ptr_deref(view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op.place) });
            oracle_record_ordinary_read(mut_view(*ctx), src as *const u8, d_size, is_raw);
            if ctx.failed {
                return;
            }
        }
        let size = d_size as usize;
        if size > 0 {
            unsafe {
                interp_copy_bytes(dest, src as *const u8, size);
            }
        }
    }
}

fn exec_assign_aggregate(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let dest_ty_v = dest_ty.v;
    let ty = unsafe { type_get(view((*ctx.thir).interner), TypeId { v: dest_ty_v }) };
    if (ty as usize) == 0 {
        return;
    }
    let agg_sz = unsafe { type_size(TypeId { v: dest_ty_v }, view((*ctx.thir).interner)) };
    if is_atomic_struct_ty(view(*ctx), dest_ty) {
        oracle_reset_atomic_loc(mut_view(*ctx), dest as *const u8, agg_sz);
    } else if (unsafe { (*stmt).place.proj_count }) > 0 {
        oracle_record_ordinary_write(mut_view(*ctx), dest as *const u8, agg_sz);
        if ctx.failed {
            return;
        }
    }
    let tk = unsafe { (*ty).kind };
    let v_idx = unsafe { (*stmt).rvalue.variant_idx };
    if tk == TY_ENUM {
        unsafe {
            *(dest as *mut u32) = v_idx;
        }
    }

    let op_count = unsafe { (*stmt).rvalue.operand_count };
    let ops = unsafe { (*stmt).rvalue.operands };
    let mut i: usize = 0;
    while i < op_count {
        let mut offset: u32 = 0u32;
        let mut field_ty_v: u32 = 0u32;
        if tk == TY_ARRAY {
            field_ty_v = unsafe { (*ty).elem.v };
            let elem_sz = unsafe { type_size(TypeId { v: field_ty_v }, view((*ctx.thir).interner)) };
            offset = (i as u32) * elem_sz;
        } else if tk == TY_ENUM {
            offset = unsafe { type_enum_field_offset(TypeId { v: dest_ty_v }, v_idx, i, view((*ctx.thir).interner)) };
            let vfields = unsafe { *typeid_ptr_at((*ty).variant_fields, v_idx as usize) };
            field_ty_v = unsafe { (*typeid_at(vfields, i)).v };
        } else {
            offset = unsafe { type_field_offset(TypeId { v: dest_ty_v }, i, view((*ctx.thir).interner)) };
            if tk == TY_STRUCT || tk == TY_TUPLE {
                let fields = unsafe { (*ty).fields };
                field_ty_v = unsafe { (*typeid_at(fields, i)).v };
            } else if tk == TY_CLOSURE {
                if i == 0 {
                    field_ty_v = unsafe { (*ctx.thir).interner.t_u64.v };
                } else {
                    let cap = unsafe { capture_at((*ty).captures, i - 1) };
                    field_ty_v = unsafe { (*cap).ty.v };
                }
            }
        }
        let f_size = unsafe { type_size(TypeId { v: field_ty_v }, view((*ctx.thir).interner)) };
        let f_op = unsafe { mir_op_at(ops, i) };
        let dst_field = unsafe { dest + (offset as usize) };
        if (unsafe { (*f_op).kind }) == MIR_OP_CONST {
            let const_ty_v = unsafe { (*f_op).constant.ty.v };
            let t_str_v = unsafe { (*ctx.thir).interner.t_str.v };
            if const_ty_v != 0u32 && const_ty_v == t_str_v && f_size == 16u32 {
                let sbytes = unsafe { (*f_op).constant.str_bytes };
                let slen = unsafe { (*f_op).constant.str_len };
                let _ = interp_ensure_const_str_alloc(mut_view(*ctx), sbytes, slen);
                unsafe {
                    *(dst_field as *mut u64) = (sbytes as usize) as u64;
                    *((dst_field as *mut u64) + 1) = slen as u64;
                }
            } else {
                let val = resolve_const_op_val(view(*ctx), frame, unsafe { view(*f_op) });
                write_scalar_to_ptr(dst_field, f_size, val);
            }
        } else {
            let mut s_ty = TypeId { v: 0u32 };
            let mut s_len: u64 = 0u64;
            let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*f_op).place) }, mut_view(s_ty), mut_view(s_len));
            if f_size > 0u32 {
                unsafe {
                    interp_copy_bytes(dst_field, src as *const u8, f_size as usize);
                }
            }
        }
        i = i + 1;
    }
}

fn exec_assign_repeat(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let ty = unsafe { type_get(view((*ctx.thir).interner), dest_ty) };
    if (ty as usize) == 0 {
        return;
    }
    let elem_ty = TypeId { v: unsafe { (*ty).elem.v } };
    let f_size = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) };

    let mut count_val: u64 = unsafe { (*stmt).rvalue.repeat_count };
    let count_op_ptr = unsafe { (*stmt).rvalue.repeat_count_op };
    if (count_op_ptr as usize) != 0 {
        if (unsafe { (*count_op_ptr).kind }) == MIR_OP_CONST {
            count_val = unsafe { (*count_op_ptr).constant.val };
        } else {
            let mut c_ty = TypeId { v: 0u32 };
            let mut c_len: u64 = 0u64;
            let c_ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*count_op_ptr).place) }, mut_view(c_ty), mut_view(c_len));
            count_val = unsafe { *(c_ptr as *const u64) };
        }
    }

    let val_is_const = (unsafe { (*stmt).rvalue.use_op.kind }) == MIR_OP_CONST;
    let mut i: u64 = 0u64;
    while i < count_val {
        let offset = interp_mul_usize(i as usize, f_size as usize);
        let dst_elem = unsafe { dest + offset };
        if val_is_const {
            let val = unsafe { (*stmt).rvalue.use_op.constant.val };
            write_scalar_to_ptr(dst_elem, f_size, val);
        } else {
            let mut s_ty = TypeId { v: 0u32 };
            let mut s_len: u64 = 0u64;
            let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op.place) }, mut_view(s_ty), mut_view(s_len));
            if f_size > 0u32 {
                unsafe {
                    interp_copy_bytes(dst_elem, src as *const u8, f_size as usize);
                }
            }
        }
        i = i + 1u64;
    }
}

fn exec_assign_ref(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let mut src_ty = TypeId { v: 0u32 };
    let mut src_fat_len: u64 = 0u64;
    let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.place) }, mut_view(src_ty), mut_view(src_fat_len));
    let t = unsafe { type_get(view((*ctx.thir).interner), dest_ty) };
    if (t as usize) == 0 {
        return;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_PTR {
        let mut synth = interp_find_synth_addr(view(*ctx), src);
        if synth == 0u64 && (src as usize) != 0 {
            synth = (src as usize) as u64;
        }
        unsafe {
            *(dest as *mut u64) = synth;
        }
        return;
    }

    if tk == TY_VIEW || tk == TY_MUT_VIEW {
        let pt_ty = interp_view_pointee_ty(t);
        let pt_ax = unsafe { type_get(view((*ctx.thir).interner), pt_ty) };
        if (pt_ax as usize) != 0 && (unsafe { (*pt_ax).kind }) == TY_SLICE {
            unsafe {
                *(dest as *mut u64) = (src as usize) as u64;
            }
            let s_t = unsafe { type_get(view((*ctx.thir).interner), src_ty) };
            let mut slen: u64 = 0u64;
            if (s_t as usize) != 0 {
                let stk = unsafe { (*s_t).kind };
                if stk == TY_SLICE {
                    slen = src_fat_len;
                } else if stk == TY_ARRAY {
                    slen = unsafe { (*s_t).array_len };
                } else if stk == TY_STR {
                    slen = unsafe { *((src as *const u64) + 1) };
                    unsafe {
                        *(dest as *mut u64) = *(src as *const u64);
                    }
                } else if stk == TY_VIEW || stk == TY_MUT_VIEW {
                    let s_pt = interp_view_pointee_ty(s_t);
                    let s_pt_ax = unsafe { type_get(view((*ctx.thir).interner), s_pt) };
                    if (s_pt_ax as usize) != 0 && (unsafe { (*s_pt_ax).kind }) == TY_SLICE {
                        slen = unsafe { *((src as *const u64) + 1) };
                        unsafe {
                            *(dest as *mut u64) = *(src as *const u64);
                        }
                    }
                }
            }
            unsafe {
                *((dest as *mut u64) + 1) = slen;
            }
            return;
        }
    }

    unsafe {
        *(dest as *mut u64) = (src as usize) as u64;
    }
}

fn exec_assign_len(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) {
    let mut dest_ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
    let mut arg_ty = TypeId { v: 0u32 };
    let mut arg_fat_len: u64 = 0u64;
    let ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.place) }, mut_view(arg_ty), mut_view(arg_fat_len));
    let t = unsafe { type_get(view((*ctx.thir).interner), arg_ty) };
    let mut slen: u64 = 0u64;
    if (t as usize) != 0 {
        let tk = unsafe { (*t).kind };
        if tk == TY_ARRAY {
            slen = unsafe { (*t).array_len };
        } else if tk == TY_SLICE {
            slen = arg_fat_len;
        } else if tk == TY_STR {
            slen = unsafe { *((ptr as *const u64) + 1) };
        } else if tk == TY_VIEW || tk == TY_MUT_VIEW {
            let pt_ty = interp_view_pointee_ty(t);
            let pt_ax = unsafe { type_get(view((*ctx.thir).interner), pt_ty) };
            if (pt_ax as usize) != 0 && (unsafe { (*pt_ax).kind }) == TY_SLICE {
                slen = unsafe { *((ptr as *const u64) + 1) };
            }
        }
    }
    let d_size = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) };
    write_scalar_to_ptr(dest, d_size, slen);
}

fn operand_type_id(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, op: view<MirOperand>) -> TypeId {
    if op.kind == MIR_OP_CONST {
        return TypeId { v: op.constant.ty.v };
    }
    if op.place.proj_count == 0 {
        let loc_v = op.place.local.v as usize;
        let decl = unsafe { mir_local_at((*frame.body).locals, loc_v) };
        return TypeId { v: unsafe { (*decl).ty.v } };
    }
    let mut ty = TypeId { v: 0u32 };
    let mut dummy_len: u64 = 0u64;
    let _ = get_place_ptr(mut_view(*ctx), frame, view(op.place), mut_view(ty), mut_view(dummy_len));
    ty
}

fn exec_assign_binop(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) -> u64 {
    let lhs = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.lhs) });
    let rhs = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.rhs) });
    let op = unsafe { (*stmt).rvalue.bin_op };

    let mut ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.lhs) });
    if ty.v == 0u32 {
        ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.rhs) });
    }

    let ty_v = ty.v;
    let mut is_signed = true;
    let mut bits: i32 = 32;
    let tk = classify_int_ty(view(*ctx), TypeId { v: ty_v }, mut_view(is_signed), mut_view(bits));
    let t = if ty_v != 0u32 { unsafe { type_get(view((*ctx.thir).interner), TypeId { v: ty_v }) } } else { 0 as *mut AxType };

    let mut res: u64 = 0u64;
    let mut overflow = false;

    if is_signed {
        let ua: u64 = if (unsafe { (*stmt).rvalue.lhs.kind }) == MIR_OP_CONST {
            lhs
        } else {
            sign_extend_u64(lhs, bits)
        };
        let ub: u64 = if (unsafe { (*stmt).rvalue.rhs.kind }) == MIR_OP_CONST {
            rhs
        } else {
            sign_extend_u64(rhs, bits)
        };

        let sign_a = (ua >> 63u64) & 1u64;
        let sign_b = (ub >> 63u64) & 1u64;
        let mut ur: u64 = 0u64;

        if op == MIR_BINOP_ADD {
            ur = w_add_u64(ua, ub);
            let sign_r = (ur >> 63u64) & 1u64;
            overflow = (sign_a == sign_b) && (sign_r != sign_a);
        } else if op == MIR_BINOP_SUB {
            ur = w_sub_u64(ua, ub);
            let sign_r = (ur >> 63u64) & 1u64;
            overflow = (sign_a != sign_b) && (sign_r != sign_a);
        } else if op == MIR_BINOP_MUL {
            let abs_a: u64 = if sign_a != 0u64 { w_neg_u64(ua) } else { ua };
            let abs_b: u64 = if sign_b != 0u64 { w_neg_u64(ub) } else { ub };
            let mut abs_ovf = false;
            let abs_prod = w_mul_u64_ovf(abs_a, abs_b, mut_view(abs_ovf));
            ur = w_mul_u64(ua, ub);
            if ua == 0u64 || ub == 0u64 {
                overflow = false;
            } else if abs_ovf {
                overflow = true;
            } else if sign_a == sign_b {
                overflow = abs_prod > 0x7FFFFFFFFFFFFFFFu64;
            } else {
                overflow = abs_prod > 0x8000000000000000u64;
            }
        } else if op == MIR_BINOP_DIV {
            if ub == 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_DIV_ZERO);
            } else {
                let min_u64 = sign_extend_u64(1u64 << ((bits - 1) as u64), bits);
                if ub == 0xFFFFFFFFFFFFFFFFu64 && ua == min_u64 {
                    overflow = true;
                    ur = ua;
                } else {
                    let abs_a: u64 = if sign_a != 0u64 { w_neg_u64(ua) } else { ua };
                    let abs_b: u64 = if sign_b != 0u64 { w_neg_u64(ub) } else { ub };
                    let q = abs_a / abs_b;
                    ur = if (sign_a != sign_b) && (q != 0u64) { w_neg_u64(q) } else { q };
                }
            }
        } else if op == MIR_BINOP_REM {
            if ub == 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_DIV_ZERO);
            } else {
                let min_u64 = sign_extend_u64(1u64 << ((bits - 1) as u64), bits);
                if ub == 0xFFFFFFFFFFFFFFFFu64 && ua == min_u64 {
                    overflow = true;
                    ur = 0u64;
                } else {
                    let abs_a: u64 = if sign_a != 0u64 { w_neg_u64(ua) } else { ua };
                    let abs_b: u64 = if sign_b != 0u64 { w_neg_u64(ub) } else { ub };
                    let rem = abs_a % abs_b;
                    ur = if (sign_a != 0u64) && (rem != 0u64) { w_neg_u64(rem) } else { rem };
                }
            }
        } else if op == MIR_BINOP_EQ {
            ur = if ua == ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_NE {
            ur = if ua != ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_LT {
            ur = if signed_lt_u64(ua, ub) { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_LE {
            ur = if signed_le_u64(ua, ub) { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_GT {
            ur = if signed_gt_u64(ua, ub) { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_GE {
            ur = if signed_ge_u64(ua, ub) { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_SHL {
            if sign_b != 0u64 || ub >= (bits as u64) {
                overflow = true;
            } else {
                ur = ua << ub;
            }
        } else if op == MIR_BINOP_SHR {
            if sign_b != 0u64 || ub >= (bits as u64) {
                overflow = true;
            } else if ub == 0u64 {
                ur = ua;
            } else if sign_a != 0u64 {
                let shifted = ua >> ub;
                let sign_ext = ((1u64 << (64u64 - ub)) - 1u64) ^ 0xFFFFFFFFFFFFFFFFu64;
                ur = shifted | sign_ext;
            } else {
                ur = ua >> ub;
            }
        } else if op == MIR_BINOP_BIT_AND {
            ur = ua & ub;
        } else if op == MIR_BINOP_BIT_OR {
            ur = ua | ub;
        } else if op == MIR_BINOP_BIT_XOR {
            ur = ua ^ ub;
        } else if op == MIR_BINOP_WRAPPING_ADD {
            ur = w_add_u64(ua, ub);
        } else if op == MIR_BINOP_WRAPPING_SUB {
            ur = w_sub_u64(ua, ub);
        } else if op == MIR_BINOP_WRAPPING_MUL {
            ur = w_mul_u64(ua, ub);
        }

        if op == MIR_BINOP_ADD || op == MIR_BINOP_SUB || op == MIR_BINOP_MUL {
            if bits < 64 && !overflow {
                if sign_extend_u64(ur, bits) != ur {
                    overflow = true;
                }
            }
        }

        if bits < 64 {
            res = ur & bit_mask_u64(bits);
        } else {
            res = ur;
        }
    } else {
        let mask = bit_mask_u64(bits);
        let ua = lhs & mask;
        let ub = rhs & mask;
        let mut ur: u64 = 0u64;

        if op == MIR_BINOP_ADD || op == MIR_BINOP_OFFSET {
            if tk == TY_PTR && (t as usize) != 0 {
                let pt_ty = interp_view_pointee_ty(t);
                let mut elem_sz = unsafe { type_size(pt_ty, view((*ctx.thir).interner)) as u64 };
                if elem_sz == 0u64 {
                    elem_sz = 1u64;
                }
                ur = w_add_u64(ua, w_mul_u64(ub, elem_sz));
                interp_validate_ptr_arith(mut_view(*ctx), ua, ur);
                overflow = false;
            } else {
                ur = w_add_u64_ovf(ua, ub, mut_view(overflow));
            }
        } else if op == MIR_BINOP_SUB {
            if tk == TY_PTR && (t as usize) != 0 {
                let pt_ty = interp_view_pointee_ty(t);
                let mut elem_sz = unsafe { type_size(pt_ty, view((*ctx.thir).interner)) as u64 };
                if elem_sz == 0u64 {
                    elem_sz = 1u64;
                }
                let r_ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.rhs) });
                let rt = if r_ty.v != 0u32 { unsafe { type_get(view((*ctx.thir).interner), r_ty) } } else { 0 as *mut AxType };
                if (rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR {
                    let diff = w_sub_u64(ua, ub);
                    if ((diff >> 63u64) & 1u64) != 0u64 {
                        let mag = w_neg_u64(diff) / elem_sz;
                        ur = w_neg_u64(mag);
                    } else {
                        ur = diff / elem_sz;
                    }
                    overflow = false;
                } else {
                    ur = w_sub_u64(ua, w_mul_u64(ub, elem_sz));
                    interp_validate_ptr_arith(mut_view(*ctx), ua, ur);
                    overflow = false;
                }
            } else {
                ur = w_sub_u64_ovf(ua, ub, mut_view(overflow));
            }
        } else if op == MIR_BINOP_MUL {
            ur = w_mul_u64_ovf(ua, ub, mut_view(overflow));
        } else if op == MIR_BINOP_DIV {
            if ub == 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_DIV_ZERO);
            } else {
                ur = ua / ub;
            }
        } else if op == MIR_BINOP_REM {
            if ub == 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_DIV_ZERO);
            } else {
                ur = ua % ub;
            }
        } else if op == MIR_BINOP_EQ {
            ur = if ua == ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_NE {
            ur = if ua != ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_LT {
            ur = if ua < ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_LE {
            ur = if ua <= ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_GT {
            ur = if ua > ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_GE {
            ur = if ua >= ub { 1u64 } else { 0u64 };
        } else if op == MIR_BINOP_SHL {
            if ub >= (bits as u64) {
                overflow = true;
            } else {
                ur = ua << ub;
            }
        } else if op == MIR_BINOP_SHR {
            if ub >= (bits as u64) {
                overflow = true;
            } else {
                ur = ua >> ub;
            }
        } else if op == MIR_BINOP_BIT_AND {
            ur = ua & ub;
        } else if op == MIR_BINOP_BIT_OR {
            ur = ua | ub;
        } else if op == MIR_BINOP_BIT_XOR {
            ur = ua ^ ub;
        } else if op == MIR_BINOP_WRAPPING_ADD {
            ur = w_add_u64(ua, ub);
        } else if op == MIR_BINOP_WRAPPING_SUB {
            ur = w_sub_u64(ua, ub);
        } else if op == MIR_BINOP_WRAPPING_MUL {
            ur = w_mul_u64(ua, ub);
        }

        if op == MIR_BINOP_ADD || op == MIR_BINOP_SUB || op == MIR_BINOP_MUL {
            if bits < 64 && ur > mask {
                overflow = true;
            }
        }
        res = ur & mask;
    }

    if ctx.failed {
        return 0u64;
    }

    let rv_kind = unsafe { (*stmt).rvalue.kind };
    if rv_kind == MIR_RVALUE_BINARY_OP {
        if overflow {
            if op == MIR_BINOP_SHL || op == MIR_BINOP_SHR {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_SHIFT_RANGE);
            } else if op == MIR_BINOP_ADD || op == MIR_BINOP_SUB || op == MIR_BINOP_MUL || op == MIR_BINOP_DIV || op == MIR_BINOP_REM {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ARITH_OV);
            }
        }
        return res;
    }
    if overflow { 1u64 } else { 0u64 }
}

fn exec_assign_unop(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) -> u64 {
    let op_val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
    let ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });

    let mut is_signed = true;
    let mut bits: i32 = 32;
    let _ = classify_int_ty(view(*ctx), ty, mut_view(is_signed), mut_view(bits));
    let mask = bit_mask_u64(bits);
    let uop = unsafe { (*stmt).rvalue.un_op };

    if uop == MIR_UNOP_NOT {
        return if op_val == 0u64 { 1u64 } else { 0u64 };
    }
    if uop == MIR_UNOP_BITNOT {
        return (op_val ^ 0xFFFFFFFFFFFFFFFFu64) & mask;
    }
    if uop == MIR_UNOP_NEG {
        if is_signed {
            let ua: u64 = if (unsafe { (*stmt).rvalue.use_op.kind }) == MIR_OP_CONST {
                op_val
            } else {
                sign_extend_u64(op_val, bits)
            };
            let min_u64 = sign_extend_u64(1u64 << ((bits - 1) as u64), bits);
            if ua == min_u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ARITH_OV);
                return 0u64;
            }
            return w_neg_u64(ua) & mask;
        } else {
            if (op_val & mask) != 0u64 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ARITH_OV);
            }
            return 0u64;
        }
    }
    0u64
}

fn exec_assign_cast(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) -> u64 {
    let op_val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
    let src_ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
    let dest_ty = TypeId { v: unsafe { (*stmt).rvalue.target_ty.v } };

    let mut src_signed = false;
    let mut src_bits: i32 = 64;
    if src_ty.v != 0u32 {
        let _ = classify_int_ty(view(*ctx), src_ty, mut_view(src_signed), mut_view(src_bits));
    }

    let mut dest_signed = false;
    let mut dest_bits: i32 = 64;
    let mut d_kind: u8 = 0u8;
    if dest_ty.v != 0u32 {
        d_kind = classify_int_ty(view(*ctx), dest_ty, mut_view(dest_signed), mut_view(dest_bits));
        if dest_bits == 1 {
            dest_bits = 64;
        }
    }

    let mut res = op_val;
    if src_signed && src_bits < 64 {
        res = sign_extend_u64(res, src_bits);
    }
    if dest_bits < 64 {
        res = res & bit_mask_u64(dest_bits);
    }

    if d_kind == TY_PTR && res != 0u64 {
        let mut found_live = false;
        let mut i: usize = 0;
        while i < ctx.alloc_count {
            let a = unsafe { interp_alloc_at(ctx.allocs, i) };
            let is_live = unsafe { (*a).is_live };
            let base = unsafe { (*a).base_addr };
            let sz = unsafe { (*a).size };
            if is_live && res >= base && res <= base + sz {
                found_live = true;
                break;
            }
            i = i + 1;
        }
        if !found_live {
            interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_USIZE_AS_PTR);
        }
    }
    res
}

fn exec_atomic_stmt(ctx: mut_view<InterpCtx>, frame: view<CallFrame>, stmt: *mut MirStmt) -> bool {
    let aop = unsafe { (*stmt).rvalue.bin_op };
    let ord = unsafe { (*stmt).rvalue.cast_kind };
    let fail_ord = unsafe { (*stmt).rvalue.borrow_kind };

    if aop == MIR_ATOMIC_FENCE {
        oracle_atomic_fence(mut_view(*ctx), ord);
        return false;
    }
    if aop == MIR_ATOMIC_COMPILER_FENCE {
        oracle_atomic_compiler_fence(mut_view(*ctx), ord);
        return false;
    }
    if aop == MIR_ATOMIC_SPIN_HINT {
        return true;
    }

    let op_ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
    let op_ty_v = op_ty.v;
    let mut op_tk: u8 = 0u8;
    if op_ty_v != 0u32 && (ctx.thir as usize) != 0 {
        let op_ax = unsafe { type_get(view((*ctx.thir).interner), TypeId { v: op_ty_v }) };
        if (op_ax as usize) != 0 {
            op_tk = unsafe { (*op_ax).kind };
        }
    }
    let mut elem_ty = TypeId { v: 0u32 };
    if aop == MIR_ATOMIC_STORE || aop == MIR_ATOMIC_CMPXCHG || aop == MIR_ATOMIC_CMPXCHG_WEAK {
        elem_ty = operand_type_id(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.lhs) });
    } else {
        let mut d_ty = TypeId { v: 0u32 };
        let mut d_len: u64 = 0u64;
        let _ = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(d_ty), mut_view(d_len));
        elem_ty = d_ty;
    }
    if elem_ty.v == 0u32 && op_ty_v != 0u32 && (ctx.thir as usize) != 0 {
        let op_ax = unsafe { type_get(view((*ctx.thir).interner), TypeId { v: op_ty_v }) };
        if (op_ax as usize) != 0 {
            if op_tk == TY_VIEW || op_tk == TY_MUT_VIEW || op_tk == TY_PTR {
                let pt_ty = interp_view_pointee_ty(op_ax);
                let pt_ty_v = pt_ty.v;
                let ex_ty = extract_atomic_elem_ty(view(*ctx), TypeId { v: pt_ty_v });
                elem_ty = if ex_ty.v != 0u32 { ex_ty } else { TypeId { v: pt_ty_v } };
            } else {
                let ex_ty = extract_atomic_elem_ty(view(*ctx), TypeId { v: op_ty_v });
                elem_ty = if ex_ty.v != 0u32 { ex_ty } else { TypeId { v: op_ty_v } };
            }
        }
    }

    let mut elem_size: u32 = 8u32;
    let elem_ty_v = elem_ty.v;
    if elem_ty_v != 0u32 && (ctx.thir as usize) != 0 {
        let sz = unsafe { type_size(TypeId { v: elem_ty_v }, view((*ctx.thir).interner)) };
        if sz == 1u32 || sz == 2u32 || sz == 4u32 || sz == 8u32 {
            elem_size = sz;
        }
    }

    let mut host_ptr: *mut u8 = 0 as *mut u8;
    if op_tk == TY_VIEW || op_tk == TY_MUT_VIEW || op_tk == TY_PTR {
        let addr = eval_operand_u64_raw(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op) });
        if addr == 0u64 || op_tk == TY_PTR || (addr >= INTERP_SYNTH_BASE_RUNTIME && addr < ctx.next_synth_addr) {
            host_ptr = interp_validate_raw_ptr(mut_view(*ctx), addr, elem_size as u64, elem_size);
        } else {
            host_ptr = interp_resolve_synth_ptr(mut_view(*ctx), addr);
            if elem_size > 1u32 && ((host_ptr as usize) % (elem_size as usize)) != 0 {
                interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_MISALIGNED);
            }
        }
    } else if (unsafe { (*stmt).rvalue.use_op.kind }) != MIR_OP_CONST {
        let mut p_ty = TypeId { v: 0u32 };
        let mut p_len: u64 = 0u64;
        host_ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.use_op.place) }, mut_view(p_ty), mut_view(p_len));
    }

    if ctx.failed || (host_ptr as usize) == 0 {
        return false;
    }

    if aop == MIR_ATOMIC_LOAD {
        let v = oracle_atomic_load(mut_view(*ctx), host_ptr, elem_size, ord);
        if !ctx.failed {
            let mut dest_ty = TypeId { v: 0u32 };
            let mut dummy_len: u64 = 0u64;
            let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
            write_scalar_to_ptr(dest, elem_size, v);
        }
        return false;
    }

    if aop == MIR_ATOMIC_STORE {
        let v = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.lhs) });
        if !ctx.failed {
            oracle_atomic_store(mut_view(*ctx), host_ptr, elem_size, v, ord);
        }
        return false;
    }

    if aop >= MIR_ATOMIC_SWAP && aop <= MIR_ATOMIC_XOR {
        let rhs = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.lhs) });
        if !ctx.failed {
            let old_v = oracle_atomic_rmw(mut_view(*ctx), host_ptr, elem_size, aop, rhs, ord);
            if !ctx.failed {
                let mut dest_ty = TypeId { v: 0u32 };
                let mut dummy_len: u64 = 0u64;
                let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
                write_scalar_to_ptr(dest, elem_size, old_v);
            }
        }
        return false;
    }

    if aop == MIR_ATOMIC_CMPXCHG || aop == MIR_ATOMIC_CMPXCHG_WEAK {
        let exp_v = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.lhs) });
        let des_v = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.rhs) });
        if !ctx.failed {
            let mut cas_ok = false;
            let is_weak = aop == MIR_ATOMIC_CMPXCHG_WEAK;
            let old_v = oracle_atomic_cmpxchg(
                mut_view(*ctx),
                host_ptr,
                elem_size,
                exp_v,
                des_v,
                ord,
                fail_ord,
                is_weak,
                mut_view(cas_ok)
            );
            if !ctx.failed {
                let mut dest_ty = TypeId { v: 0u32 };
                let mut dummy_len: u64 = 0u64;
                let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
                let dest_ty_v = dest_ty.v;
                let mut is_cas_struct = false;
                if dest_ty_v != 0u32 && (ctx.thir as usize) != 0 {
                    let dt = unsafe { type_get(view((*ctx.thir).interner), TypeId { v: dest_ty_v }) };
                    if (dt as usize) != 0 {
                        let dtk = unsafe { (*dt).kind };
                        if dtk == TY_STRUCT || dtk == TY_TUPLE {
                            is_cas_struct = true;
                        }
                    }
                }
                if is_cas_struct {
                    let ok_off = unsafe { type_field_offset(TypeId { v: dest_ty_v }, 0, view((*ctx.thir).interner)) };
                    let val_off = unsafe { type_field_offset(TypeId { v: dest_ty_v }, 1, view((*ctx.thir).interner)) };
                    unsafe {
                        *(dest + (ok_off as usize)) = if cas_ok { 1u8 } else { 0u8 };
                    }
                    write_scalar_to_ptr(unsafe { dest + (val_off as usize) }, elem_size, old_v);
                } else {
                    write_scalar_to_ptr(dest, elem_size, old_v);
                }
            }
        }
        return false;
    }

    false
}

// =================================================================================================
// Builtin Call Terminator Dispatch
// =================================================================================================

fn exec_builtin_call(
    ctx: mut_view<InterpCtx>,
    frame: view<CallFrame>,
    term: *mut MirTerminator,
    ft_kind: u8,
    out_next_bb: mut_view<MirBbId>
) -> bool {
    let args = unsafe { (*term).args };
    let target_bb = MirBbId { v: unsafe { (*term).call_target.v } };

    if ft_kind == TY_BUILTIN_PRINT {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let mut bytes: *const u8 = 0 as *const u8;
        let mut slen: usize = 0;
        if (unsafe { (*arg0).kind }) == MIR_OP_CONST {
            bytes = unsafe { (*arg0).constant.str_bytes };
            slen = unsafe { (*arg0).constant.str_len };
        } else {
            let mut ty = TypeId { v: 0u32 };
            let mut fat_len: u64 = 0u64;
            let ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*arg0).place) }, mut_view(ty), mut_view(fat_len));
            let addr = unsafe { *(ptr as *const u64) };
            bytes = interp_resolve_synth_ptr(mut_view(*ctx), addr) as *const u8;
            slen = unsafe { *((ptr as *const u64) + 1) as usize };
        }
        interp_write_out(mut_view(*ctx), bytes, slen);
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_PRINT_INT {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let mut arg_ty_id = TypeId { v: 0u32 };
        if (unsafe { (*arg0).kind }) == MIR_OP_CONST {
            arg_ty_id = TypeId { v: unsafe { (*arg0).constant.ty.v } };
        } else {
            let mut dummy_len: u64 = 0u64;
            let _ = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*arg0).place) }, mut_view(arg_ty_id), mut_view(dummy_len));
        }
        let arg_ty_v = arg_ty_id.v;
        let arg_is_signed = unsafe { type_is_signed(TypeId { v: arg_ty_v }, view((*ctx.thir).interner)) };
        if arg_is_signed {
            let sz = unsafe { type_size(TypeId { v: arg_ty_v }, view((*ctx.thir).interner)) };
            let mut sval = val;
            if sz == 1u32 {
                sval = sign_extend_u64(val, 8);
            } else if sz == 2u32 {
                sval = sign_extend_u64(val, 16);
            } else if sz == 4u32 {
                sval = sign_extend_u64(val, 32);
            }
            interp_write_i64_twos(mut_view(*ctx), sval);
        } else {
            interp_write_u64(mut_view(*ctx), val);
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_NEEDS_DROP {
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let nd = unsafe {
            mir_type_needs_drop_in(elem_ty, view(*ctx.thir), view(*ctx.hir), ctx.db, view(*ctx.interner))
        };
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *dest = if nd { 1u8 } else { 0u8 };
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_DROP_IN_PLACE {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let elem_ty_v = unsafe { (*term).func.constant.val as u32 };
        let sz = unsafe { type_size(TypeId { v: elem_ty_v }, view((*ctx.thir).interner)) };
        let al = unsafe { type_align(TypeId { v: elem_ty_v }, view((*ctx.thir).interner)) };
        let host_ptr = interp_validate_raw_ptr(mut_view(*ctx), addr, sz as u64, al);
        if !ctx.failed {
            let drop_fn = find_drop_fn_for_type(view(*ctx), TypeId { v: elem_ty_v });
            if (drop_fn as usize) != 0 {
                let mut drop_arg = InterpValue { vals: [0u64; 32] };
                drop_arg.vals[0] = (host_ptr as usize) as u64;
                let mut ret = InterpValue { vals: [0u64; 32] };
                let arg_ptr = unsafe { address_of_mut(drop_arg) };
                eval_call(mut_view(*ctx), drop_fn, arg_ptr, 1, mut_view(ret));
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_PTR_COPY || ft_kind == TY_BUILTIN_PTR_COPY_NONOVERLAPPING {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let arg1 = unsafe { mir_op_at(args, 1) };
        let arg2 = unsafe { mir_op_at(args, 2) };
        let src_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let dst_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg1) });
        let count = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg2) });
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let mut elem_sz = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) as u64 };
        if elem_sz == 0u64 {
            elem_sz = 1u64;
        }
        let bytes = w_mul_u64(count, elem_sz);
        let src_host = interp_validate_raw_ptr(mut_view(*ctx), src_addr, bytes, 1u32);
        let dst_host = interp_validate_raw_ptr(mut_view(*ctx), dst_addr, bytes, 1u32);
        if !ctx.failed && bytes > 0u64 {
            if ft_kind == TY_BUILTIN_PTR_COPY_NONOVERLAPPING {
                if src_addr < w_add_u64(dst_addr, bytes) && dst_addr < w_add_u64(src_addr, bytes) {
                    interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_OVERLAP);
                } else {
                    unsafe {
                        interp_copy_bytes(dst_host, src_host as *const u8, bytes as usize);
                    }
                }
            } else {
                unsafe {
                    interp_move_bytes(dst_host, src_host as *const u8, bytes as usize);
                }
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_PTR_WRITE_BYTES {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let arg1 = unsafe { mir_op_at(args, 1) };
        let arg2 = unsafe { mir_op_at(args, 2) };
        let dst_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let byte_val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg1) }) as u8;
        let count = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg2) });
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let mut elem_sz = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) as u64 };
        if elem_sz == 0u64 {
            elem_sz = 1u64;
        }
        let bytes = w_mul_u64(count, elem_sz);
        let dst_host = interp_validate_raw_ptr(mut_view(*ctx), dst_addr, bytes, 1u32);
        if !ctx.failed && bytes > 0u64 {
            unsafe {
                interp_fill_bytes(dst_host, byte_val, bytes as usize);
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_PTR_ADD || ft_kind == TY_BUILTIN_PTR_SUB {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let arg1 = unsafe { mir_op_at(args, 1) };
        let p_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let count = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg1) });
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let mut elem_sz = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) as u64 };
        if elem_sz == 0u64 {
            elem_sz = 1u64;
        }
        let delta = w_mul_u64(count, elem_sz);
        let new_addr = if ft_kind == TY_BUILTIN_PTR_ADD {
            w_add_u64(p_addr, delta)
        } else {
            w_sub_u64(p_addr, delta)
        };
        interp_validate_ptr_arith(mut_view(*ctx), p_addr, new_addr);
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *(dest as *mut u64) = new_addr;
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_SIZE_OF {
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let sz = unsafe { type_size(elem_ty, view((*ctx.thir).interner)) as u64 };
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *(dest as *mut u64) = sz;
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_ALIGN_OF {
        let elem_ty = TypeId { v: unsafe { (*term).func.constant.val as u32 } };
        let al = unsafe { type_align(elem_ty, view((*ctx.thir).interner)) as u64 };
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *(dest as *mut u64) = al;
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_NULL || ft_kind == TY_BUILTIN_NULL_MUT {
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *(dest as *mut u64) = 0u64;
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_IS_NULL {
        let arg0 = unsafe { mir_op_at(args, 0) };
        let p_addr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view(*arg0) });
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dummy_len: u64 = 0u64;
        let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dummy_len));
        if (dest as usize) != 0 {
            unsafe {
                *dest = if p_addr == 0u64 { 1u8 } else { 0u8 };
            }
        }
        *out_next_bb = target_bb;
        return true;
    }

    if ft_kind == TY_BUILTIN_FORGET {
        *out_next_bb = target_bb;
        return true;
    }

    false
}

// =================================================================================================
// Single Statement Execution, Thread Classification & Concurrent Scheduler
// =================================================================================================

fn exec_single_mir_stmt(
    ctx: mut_view<InterpCtx>,
    frame: view<CallFrame>,
    body: *mut MirBody,
    stmt: *mut MirStmt,
    out_yield: mut_view<bool>,
    out_spin: mut_view<bool>
) {
    *out_yield = false;
    *out_spin = false;
    let loc_sp = Span {
        file: FileId { v: unsafe { (*stmt).location.file.v } },
        start: unsafe { (*stmt).location.start },
        end: unsafe { (*stmt).location.end },
    };
    if loc_sp.file.v != 0u32 || loc_sp.start != 0u32 || loc_sp.end != 0u32 {
        ctx.current_span = loc_sp;
    } else {
        ctx.current_span = Span {
            file: FileId { v: unsafe { (*stmt).span.file.v } },
            start: unsafe { (*stmt).span.start },
            end: unsafe { (*stmt).span.end },
        };
    }

    let local_count = unsafe { (*body).local_count };
    let sk = unsafe { (*stmt).kind };
    if sk == MIR_STMT_ATOMIC {
        *out_spin = exec_atomic_stmt(mut_view(*ctx), frame, stmt);
        *out_yield = true;
        return;
    }
    if sk == MIR_STMT_ASSIGN {
        let place_loc_v = unsafe { (*stmt).place.local.v as usize };
        let mut is_const_local = false;
        if place_loc_v < local_count {
            let ldecl = unsafe { mir_local_at((*body).locals, place_loc_v) };
            if (unsafe { (*ldecl).kind }) == MIR_LOCAL_CONST {
                is_const_local = true;
            }
        }
        if !is_const_local {
            let rvk = unsafe { (*stmt).rvalue.kind };
            if (unsafe { (*stmt).place.proj_count }) > 0 && rvk != MIR_RVALUE_REF {
                *out_yield = true;
            }
            if rvk == MIR_RVALUE_USE {
                exec_assign_use(mut_view(*ctx), frame, stmt);
            } else if rvk == MIR_RVALUE_AGGREGATE {
                exec_assign_aggregate(mut_view(*ctx), frame, stmt);
            } else if rvk == MIR_RVALUE_REPEAT {
                exec_assign_repeat(mut_view(*ctx), frame, stmt);
            } else if rvk == MIR_RVALUE_REF {
                exec_assign_ref(mut_view(*ctx), frame, stmt);
            } else if rvk == MIR_RVALUE_LEN {
                exec_assign_len(mut_view(*ctx), frame, stmt);
            } else {
                let mut val: u64 = 0u64;
                if rvk == MIR_RVALUE_DISCRIMINANT {
                    let mut src_ty = TypeId { v: 0u32 };
                    let mut src_len: u64 = 0u64;
                    let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).rvalue.place) }, mut_view(src_ty), mut_view(src_len));
                    let ty = unsafe { type_get(view((*ctx.thir).interner), src_ty) };
                    if (ty as usize) != 0 && (unsafe { (*ty).kind }) == TY_ENUM {
                        val = unsafe { *(src as *const u32) as u64 };
                    }
                } else if rvk == MIR_RVALUE_BINARY_OP || rvk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                    val = exec_assign_binop(mut_view(*ctx), frame, stmt);
                } else if rvk == MIR_RVALUE_UNARY_OP {
                    val = exec_assign_unop(mut_view(*ctx), frame, stmt);
                } else if rvk == MIR_RVALUE_CAST {
                    val = exec_assign_cast(mut_view(*ctx), frame, stmt);
                }
                if !ctx.failed {
                    let mut dest_ty = TypeId { v: 0u32 };
                    let mut dummy_len: u64 = 0u64;
                    let dest = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*stmt).place) }, mut_view(dest_ty), mut_view(dummy_len));
                    let dest_size = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) };
                    if (unsafe { (*stmt).place.proj_count }) > 0 || oracle_has_active_atomic_at(view(*ctx), dest as *const u8, dest_size) {
                        oracle_record_ordinary_write(mut_view(*ctx), dest as *const u8, dest_size);
                    }
                    if !ctx.failed {
                        write_scalar_to_ptr(dest, dest_size, val);
                    }
                }
            }
        }
    }
}

// Prefix bytes for thread classification:
//   0..6:   "thread"
//   6..12:  "worker"
//   12..20: "producer"
//   20..28: "consumer"
//   28..34: "writer"
//   34..40: "reader"
//   40..55: "oracle_set_seed"
//   55..70: "oracle_join_all"
const INTERP_THREAD_PREFIX_BYTES: [70]u8 = [
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8,
    119u8, 111u8, 114u8, 107u8, 101u8, 114u8,
    112u8, 114u8, 111u8, 100u8, 117u8, 99u8, 101u8, 114u8,
    99u8, 111u8, 110u8, 115u8, 117u8, 109u8, 101u8, 114u8,
    119u8, 114u8, 105u8, 116u8, 101u8, 114u8,
    114u8, 101u8, 97u8, 100u8, 101u8, 114u8,
    111u8, 114u8, 97u8, 99u8, 108u8, 101u8, 95u8, 115u8, 101u8, 116u8, 95u8, 115u8, 101u8, 101u8, 100u8,
    111u8, 114u8, 97u8, 99u8, 108u8, 101u8, 95u8, 106u8, 111u8, 105u8, 110u8, 95u8, 97u8, 108u8, 108u8,
];

fn sv_has_prefix(sv: view<StrView>, off: usize, plen: usize) -> bool {
    let slen = sv.len;
    if slen < plen || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < plen {
        let b = unsafe { *(sv.ptr + i) };
        if b != INTERP_THREAD_PREFIX_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn sv_first_digit(sv: view<StrView>, start_idx: usize) -> i32 {
    let mut i: usize = start_idx;
    while i < sv.len {
        let b = unsafe { *(sv.ptr + i) };
        if b >= 48u8 && b <= 57u8 {
            return (b - 48u8) as i32;
        }
        i = i + 1;
    }
    -1
}

pub fn interp_classify_thread_fn(ctx: view<InterpCtx>, callee: *mut HirItem) -> u32 {
    if (callee as usize) == 0 || (ctx.interner as usize) == 0 {
        return 0u32;
    }
    let name_id = unsafe { (*callee).name.v };
    if name_id == 0u32 {
        return 0u32;
    }
    let sv = unsafe { interner_get(view(*ctx.interner), StrId { v: name_id }) };
    if sv.len == 0 || (sv.ptr as usize) == 0 {
        return 0u32;
    }
    if sv.len == 15 && sv_has_prefix(view(sv), 40, 15) {
        return 0xFFFFFFFEu32;
    }
    if sv.len == 15 && sv_has_prefix(view(sv), 55, 15) {
        return 0xFFFFFFFDu32;
    }
    if sv_has_prefix(view(sv), 0, 6) {
        let d = sv_first_digit(view(sv), 6);
        if d >= 0 && d < 15 {
            return (d as u32) + 1u32;
        }
        return 1u32;
    }
    if sv_has_prefix(view(sv), 6, 6) {
        let d = sv_first_digit(view(sv), 6);
        if d >= 0 && d < 15 {
            return (d as u32) + 1u32;
        }
        return 1u32;
    }
    if sv_has_prefix(view(sv), 12, 8) {
        return 1u32;
    }
    if sv_has_prefix(view(sv), 20, 8) {
        return 2u32;
    }
    if sv_has_prefix(view(sv), 28, 6) {
        let d = sv_first_digit(view(sv), 6);
        if d >= 0 && d < 14 {
            return (d as u32) + 1u32;
        }
        return 1u32;
    }
    if sv_has_prefix(view(sv), 34, 6) {
        let d = sv_first_digit(view(sv), 6);
        if d >= 0 && d < 14 {
            return (d as u32) + 2u32;
        }
        return 2u32;
    }
    if sv.len >= 2 {
        let b0 = unsafe { *(sv.ptr + 0) };
        let b1 = unsafe { *(sv.ptr + 1) };
        if b0 == 116u8 && b1 >= 48u8 && b1 <= 55u8 {
            if sv.len == 2 || (unsafe { *(sv.ptr + 2) }) == 95u8 {
                return ((b1 - 48u8) as u32) + 1u32;
            }
        }
    }
    0u32
}

fn prepare_call_args_from_term(
    ctx: mut_view<InterpCtx>,
    frame: view<CallFrame>,
    term: *mut MirTerminator,
    callee: *mut HirItem,
    out_total_args: mut_view<usize>,
    out_args_bytes: mut_view<usize>
) -> *mut InterpValue {
    let mut callee_param_count: usize = 0;
    let mut p: *mut HirParam = unsafe { (*callee).params };
    while (p as usize) != 0 {
        callee_param_count = callee_param_count + 1;
        p = unsafe { (*p).next };
    }
    let term_arg_count = unsafe { (*term).arg_count };
    let total_args: usize = if callee_param_count > term_arg_count { callee_param_count } else { term_arg_count };
    let cap_count: usize = if callee_param_count > term_arg_count { callee_param_count - term_arg_count } else { 0 };
    let alloc_args: usize = if total_args > 0 { total_args } else { 1 };
    let args_bytes = interp_mul_usize(alloc_args, size_of<InterpValue>());
    let call_args = unsafe { heap_alloc(args_bytes, align_of<InterpValue>()) as *mut InterpValue };
    unsafe {
        interp_zero_bytes(call_args as *mut u8, args_bytes);
    }
    *out_total_args = total_args;
    *out_args_bytes = args_bytes;

    if cap_count > 0 && (unsafe { (*term).func.kind }) != MIR_OP_CONST {
        let mut func_ty = TypeId { v: 0u32 };
        let mut func_len: u64 = 0u64;
        let closure_ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).func.place) }, mut_view(func_ty), mut_view(func_len));
        let mut offset: u32 = 8u32;
        let mut cp: *mut HirParam = unsafe { (*callee).params };
        let mut c: usize = 0;
        while c < cap_count && (cp as usize) != 0 {
            let pty = unsafe { thir_get_param_type(view(*ctx.thir), cp as *const HirParam) };
            let cap_field_ty_v: u32 = if (pty as usize) != 0 {
                unsafe { (*pty).v }
            } else {
                unsafe { (*ctx.thir).interner.t_u64.v }
            };
            let a = unsafe { type_align(TypeId { v: cap_field_ty_v }, view((*ctx.thir).interner)) };
            let s = unsafe { type_size(TypeId { v: cap_field_ty_v }, view((*ctx.thir).interner)) };
            if a > 0u32 {
                let mask = a - 1u32;
                offset = (offset + mask) & (mask ^ 0xFFFFFFFFu32);
            }
            let copy_s: usize = if s > 0u32 { s as usize } else { 8 };
            let dst_arg = unsafe { interp_val_at(call_args, c) as *mut u8 };
            let src_cap = unsafe { closure_ptr + (offset as usize) };
            unsafe {
                interp_copy_bytes(dst_arg, src_cap as *const u8, copy_s);
            }
            offset = offset + (copy_s as u32);
            c = c + 1;
            cp = unsafe { (*cp).next };
        }
    }

    let term_args = unsafe { (*term).args };
    let mut a_idx: usize = 0;
    while a_idx < term_arg_count {
        let arg_op = unsafe { mir_op_at(term_args, a_idx) };
        let dst_slot = unsafe { interp_val_at(call_args, cap_count + a_idx) };
        if (unsafe { (*arg_op).kind }) == MIR_OP_CONST {
            unsafe {
                eval_operand(mut_view(*ctx), frame, view(*arg_op), mut_view(*dst_slot));
                let resolved_fn = resolve_const_op_val(view(*ctx), frame, view(*arg_op));
                if resolved_fn != (*arg_op).constant.val {
                    (*dst_slot).vals[0] = resolved_fn;
                }
            }
        } else {
            let mut src_ty = TypeId { v: 0u32 };
            let mut src_len: u64 = 0u64;
            let src = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*arg_op).place) }, mut_view(src_ty), mut_view(src_len));
            let mut s_sz = unsafe { type_size(src_ty, view((*ctx.thir).interner)) as usize };
            if s_sz > size_of<InterpValue>() {
                s_sz = size_of<InterpValue>();
            }
            if s_sz > 0 {
                unsafe {
                    interp_copy_bytes(dst_slot as *mut u8, src as *const u8, s_sz);
                }
            }
        }
        a_idx = a_idx + 1;
    }
    call_args
}

fn exec_task_terminator(
    ctx: mut_view<InterpCtx>,
    frame: view<CallFrame>,
    current_bb: MirBbId,
    term: *mut MirTerminator,
    out_next_bb: mut_view<MirBbId>,
    out_done: mut_view<bool>,
    out_back_edge: mut_view<bool>
) {
    *out_done = false;
    *out_back_edge = false;
    let tloc = Span {
        file: FileId { v: unsafe { (*term).location.file.v } },
        start: unsafe { (*term).location.start },
        end: unsafe { (*term).location.end },
    };
    if tloc.file.v != 0u32 || tloc.start != 0u32 || tloc.end != 0u32 {
        ctx.current_span = tloc;
    } else {
        ctx.current_span = Span {
            file: FileId { v: unsafe { (*term).span.file.v } },
            start: unsafe { (*term).span.start },
            end: unsafe { (*term).span.end },
        };
    }

    let tk = unsafe { (*term).kind };
    if tk == MIR_TERM_GOTO {
        let tgt = MirBbId { v: unsafe { (*term).goto_target.v } };
        if tgt.v <= current_bb.v {
            *out_back_edge = true;
        }
        *out_next_bb = tgt;
    } else if tk == MIR_TERM_ASSERT {
        let cond = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*term).cond) });
        let expected = unsafe { (*term).expected };
        if (cond != 0u64) != expected {
            let msg_ptr = unsafe { (*term).msg_ptr };
            let msg_len = unsafe { (*term).msg_len };
            if (msg_ptr as usize) != 0 && msg_len > 0 {
                interp_panic_sv(mut_view(*ctx), StrView { ptr: msg_ptr, len: msg_len });
            } else {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ASSERT);
            }
            *out_done = true;
            return;
        }
        *out_next_bb = MirBbId { v: unsafe { (*term).assert_target.v } };
    } else if tk == MIR_TERM_RETURN {
        *out_done = true;
    } else if tk == MIR_TERM_DROP {
        *out_next_bb = MirBbId { v: unsafe { (*term).drop_target.v } };
    } else if tk == MIR_TERM_SWITCH_INT {
        let discr = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*term).discr) });
        let mut next = MirBbId { v: unsafe { (*term).otherwise.v } };
        let scount = unsafe { (*term).switch_count };
        let svals = unsafe { (*term).values };
        let stargets = unsafe { (*term).targets };
        let mut s: usize = 0;
        while s < scount {
            let sv = unsafe { *mir_u64_at(svals, s) };
            if discr == sv {
                let st = unsafe { mir_bb_id_at(stargets, s) };
                next = MirBbId { v: unsafe { (*st).v } };
                break;
            }
            s = s + 1;
        }
        if next.v <= current_bb.v {
            *out_back_edge = true;
        }
        *out_next_bb = next;
    } else if tk == MIR_TERM_CALL {
        let mut handled_builtin = false;
        let mut next_bb = MirBbId { v: 0u32 };
        if (unsafe { (*term).func.kind }) == MIR_OP_CONST {
            let fty_id = TypeId { v: unsafe { (*term).func.constant.ty.v } };
            if fty_id.v != 0u32 && (ctx.thir as usize) != 0 {
                let ft = unsafe { type_get(view((*ctx.thir).interner), fty_id) };
                if (ft as usize) != 0 {
                    let ftk = unsafe { (*ft).kind };
                    handled_builtin = exec_builtin_call(mut_view(*ctx), frame, term, ftk, mut_view(next_bb));
                }
            }
        }
        if handled_builtin {
            *out_next_bb = next_bb;
        } else {
            let func_val = eval_operand_u64(mut_view(*ctx), frame, unsafe { view((*term).func) });
            let callee = find_func_by_symbol(view(*ctx), func_val);
            if (callee as usize) == 0 {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
                *out_done = true;
                return;
            }
            let mut total_args: usize = 0;
            let mut args_bytes: usize = 0;
            let call_args = prepare_call_args_from_term(mut_view(*ctx), frame, term, callee, mut_view(total_args), mut_view(args_bytes));
            let mut dest_ty = TypeId { v: 0u32 };
            let mut dest_len: u64 = 0u64;
            let dest_ptr = get_place_ptr(mut_view(*ctx), frame, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dest_len));
            let dest_sz = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) as usize };
            let ret_alloc_sz: usize = if dest_sz > size_of<InterpValue>() { dest_sz } else { size_of<InterpValue>() };
            let big_ret = unsafe { heap_alloc(ret_alloc_sz, 16) };
            unsafe {
                interp_zero_bytes(big_ret, ret_alloc_sz);
            }
            eval_call_into(mut_view(*ctx), callee, call_args, total_args, big_ret, ret_alloc_sz);
            unsafe {
                heap_free(call_args as *mut u8, args_bytes, align_of<InterpValue>());
            }
            if !ctx.failed && dest_sz > 0 && (dest_ptr as usize) != 0 {
                unsafe {
                    interp_copy_bytes(dest_ptr, big_ret as *const u8, dest_sz);
                }
            }
            unsafe {
                heap_free(big_ret, ret_alloc_sz, 16);
            }
            if ctx.failed {
                *out_done = true;
                return;
            }
            *out_next_bb = MirBbId { v: unsafe { (*term).call_target.v } };
        }
    } else if tk == MIR_TERM_UNREACHABLE {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNREACHABLE);
        *out_done = true;
    } else {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNSUPPORTED_TERM);
        *out_done = true;
    }
}

fn bb_is_pairable_thread_call(
    ctx: view<InterpCtx>,
    body: *mut MirBody,
    bb_id: MirBbId,
    tid0: u32,
    out_callee1: mut_view<*mut HirItem>,
    out_tid1: mut_view<u32>
) -> bool {
    *out_callee1 = 0 as *mut HirItem;
    *out_tid1 = 0u32;
    let bb_count = unsafe { (*body).bb_count };
    if (bb_id.v as usize) >= bb_count {
        return false;
    }
    let bb = unsafe { mir_bb_at((*body).bbs, bb_id.v as usize) };
    let term = mir_bb_term_mut(bb);
    if (unsafe { (*term).kind }) != MIR_TERM_CALL {
        return false;
    }
    if (unsafe { (*term).func.kind }) != MIR_OP_CONST {
        return false;
    }
    let sym_v = unsafe { (*term).func.constant.val };
    let callee1 = find_func_by_symbol(ctx, sym_v);
    if (callee1 as usize) == 0 {
        return false;
    }
    let tid1 = interp_classify_thread_fn(ctx, callee1);
    if tid1 < 1u32 || tid1 >= 16u32 || tid1 == tid0 {
        return false;
    }
    let scount = unsafe { (*bb).stmt_count };
    let stmts = unsafe { (*bb).stmts };
    let mut i: usize = 0;
    while i < scount {
        let s = unsafe { mir_stmt_at(stmts, i) };
        if (unsafe { (*s).kind }) != MIR_STMT_ASSIGN {
            return false;
        }
        if (unsafe { (*s).place.proj_count }) != 0 {
            return false;
        }
        let rvk = unsafe { (*s).rvalue.kind };
        if rvk != MIR_RVALUE_USE && rvk != MIR_RVALUE_REF && rvk != MIR_RVALUE_CAST {
            return false;
        }
        if (rvk == MIR_RVALUE_USE || rvk == MIR_RVALUE_CAST) && (unsafe { (*s).rvalue.lhs.kind }) != MIR_OP_CONST {
            if (unsafe { (*s).rvalue.lhs.place.proj_count }) != 0 {
                return false;
            }
        }
        if rvk == MIR_RVALUE_REF {
            let pcount = unsafe { (*s).rvalue.place.proj_count };
            let projs = unsafe { (*s).rvalue.place.projs };
            let mut p_idx: usize = 0;
            while p_idx < pcount {
                let pr = unsafe { mir_proj_at(projs, p_idx) };
                if (unsafe { (*pr).kind }) == MIR_PROJ_DEREF {
                    return false;
                }
                p_idx = p_idx + 1;
            }
        }
        i = i + 1;
    }
    *out_callee1 = callee1;
    *out_tid1 = tid1;
    true
}

fn exec_concurrent_pair(
    ctx: mut_view<InterpCtx>,
    callee0: *mut HirItem,
    tid0: u32,
    args0: *mut InterpValue,
    arg_count0: usize,
    dest_ptr0: *mut u8,
    dest_sz0: usize,
    callee1: *mut HirItem,
    tid1: u32,
    args1: *mut InterpValue,
    arg_count1: usize,
    dest_ptr1: *mut u8,
    dest_sz1: usize
) {
    let body0 = resolve_or_build_mir_body(mut_view(*ctx), callee0);
    let body1 = resolve_or_build_mir_body(mut_view(*ctx), callee1);
    if (body0 as usize) == 0 || (body1 as usize) == 0 {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
        return;
    }

    let mask_both = (1u32 << tid0) | (1u32 << tid1);
    if ctx.oracle.active_thread_mask == 1u32 || (ctx.oracle.active_thread_mask & mask_both) != 0u32 {
        if ctx.oracle.active_thread_mask > 1u32 {
            oracle_join_threads(mut_view(*ctx));
        }
        oracle_begin_concurrent_batch(mut_view(*ctx));
    }
    oracle_fork_thread_for_batch(mut_view(*ctx), tid0, callee0 as usize);
    oracle_fork_thread_for_batch(mut_view(*ctx), tid1, callee1 as usize);

    ctx.call_depth = ctx.call_depth + 1;
    let prev_storage = ctx.oracle.current_frame_storage;
    let prev_storage_size = ctx.oracle.current_frame_storage_size;
    let prev_tid = ctx.oracle.current_tid;

    let mut frame0 = CallFrame {
        body: 0 as *mut MirBody,
        local_ptrs: 0 as *mut *mut u8,
        storage: 0 as *mut u8,
        storage_size: 0,
        local_cap: 0,
    };
    let mut frame1 = CallFrame {
        body: 0 as *mut MirBody,
        local_ptrs: 0 as *mut *mut u8,
        storage: 0 as *mut u8,
        storage_size: 0,
        local_cap: 0,
    };

    let alloc_start0 = frame_init(mut_view(*ctx), mut_view(frame0), body0, args0, arg_count0);
    let alloc_start1 = frame_init(mut_view(*ctx), mut_view(frame1), body1, args1, arg_count1);
    let bb_count0 = unsafe { (*body0).bb_count };
    let bb_count1 = unsafe { (*body1).bb_count };

    let mut bb0 = MirBbId { v: 0u32 };
    let mut bb1 = MirBbId { v: 0u32 };
    let mut stmt_idx0: usize = 0;
    let mut stmt_idx1: usize = 0;
    let mut done0 = false;
    let mut done1 = false;
    let mut prefer_other: i32 = -1;

    while !ctx.failed && (!done0 || !done1) {
        ctx.steps = ctx.steps + 1;
        if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
            interp_check_step_limit(mut_view(*ctx));
            break;
        }

        let mut pick: i32 = 0;
        if done0 {
            pick = 1;
        } else if done1 {
            pick = 0;
        } else if prefer_other == 0 {
            pick = 1;
            prefer_other = -1;
        } else if prefer_other == 1 {
            pick = 0;
            prefer_other = -1;
        } else {
            let rnd = oracle_next_prng(mut_view(*ctx));
            pick = if (rnd & 1u64) == 0u64 { 0 } else { 1 };
        }

        if pick == 0 {
            ctx.oracle.current_tid = tid0;
            ctx.oracle.current_frame_storage = frame0.storage;
            ctx.oracle.current_frame_storage_size = frame0.storage_size;
            if (bb0.v as usize) >= bb_count0 {
                done0 = true;
            } else {
                let bb_ptr = unsafe { mir_bb_at((*body0).bbs, bb0.v as usize) };
                let scount = unsafe { (*bb_ptr).stmt_count };
                let stmts = unsafe { (*bb_ptr).stmts };
                let mut yielded = false;
                while stmt_idx0 < scount && !ctx.failed && !yielded {
                    ctx.steps = ctx.steps + 1;
                    if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
                        interp_check_step_limit(mut_view(*ctx));
                        break;
                    }
                    let stmt = unsafe { mir_stmt_at(stmts, stmt_idx0) };
                    let mut sp_hint = false;
                    exec_single_mir_stmt(mut_view(*ctx), view(frame0), body0, stmt, mut_view(yielded), mut_view(sp_hint));
                    stmt_idx0 = stmt_idx0 + 1;
                    if sp_hint {
                        prefer_other = 0;
                    }
                }
                if !ctx.failed && stmt_idx0 >= scount {
                    let term = mir_bb_term_mut(bb_ptr);
                    let mut next_bb = MirBbId { v: bb0.v };
                    let mut term_done = false;
                    let mut back_edge = false;
                    exec_task_terminator(mut_view(*ctx), view(frame0), MirBbId { v: bb0.v }, term, mut_view(next_bb), mut_view(term_done), mut_view(back_edge));
                    bb0 = next_bb;
                    stmt_idx0 = 0;
                    if term_done {
                        done0 = true;
                    } else if back_edge {
                        prefer_other = 0;
                    }
                }
            }
        } else {
            ctx.oracle.current_tid = tid1;
            ctx.oracle.current_frame_storage = frame1.storage;
            ctx.oracle.current_frame_storage_size = frame1.storage_size;
            if (bb1.v as usize) >= bb_count1 {
                done1 = true;
            } else {
                let bb_ptr = unsafe { mir_bb_at((*body1).bbs, bb1.v as usize) };
                let scount = unsafe { (*bb_ptr).stmt_count };
                let stmts = unsafe { (*bb_ptr).stmts };
                let mut yielded = false;
                while stmt_idx1 < scount && !ctx.failed && !yielded {
                    ctx.steps = ctx.steps + 1;
                    if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
                        interp_check_step_limit(mut_view(*ctx));
                        break;
                    }
                    let stmt = unsafe { mir_stmt_at(stmts, stmt_idx1) };
                    let mut sp_hint = false;
                    exec_single_mir_stmt(mut_view(*ctx), view(frame1), body1, stmt, mut_view(yielded), mut_view(sp_hint));
                    stmt_idx1 = stmt_idx1 + 1;
                    if sp_hint {
                        prefer_other = 1;
                    }
                }
                if !ctx.failed && stmt_idx1 >= scount {
                    let term = mir_bb_term_mut(bb_ptr);
                    let mut next_bb = MirBbId { v: bb1.v };
                    let mut term_done = false;
                    let mut back_edge = false;
                    exec_task_terminator(mut_view(*ctx), view(frame1), MirBbId { v: bb1.v }, term, mut_view(next_bb), mut_view(term_done), mut_view(back_edge));
                    bb1 = next_bb;
                    stmt_idx1 = 0;
                    if term_done {
                        done1 = true;
                    } else if back_edge {
                        prefer_other = 1;
                    }
                }
            }
        }
    }

    let _ = alloc_start1;
    frame_cleanup(mut_view(*ctx), mut_view(frame1), alloc_start1, dest_ptr1, dest_sz1);
    frame_cleanup(mut_view(*ctx), mut_view(frame0), alloc_start0, dest_ptr0, dest_sz0);
    ctx.call_depth = ctx.call_depth - 1;
    ctx.oracle.current_frame_storage = prev_storage;
    ctx.oracle.current_frame_storage_size = prev_storage_size;
    ctx.oracle.current_tid = prev_tid;
}

// =================================================================================================
// MIR Body Execution Loop
// =================================================================================================

pub fn exec_mir_body(
    ctx: mut_view<InterpCtx>,
    body: *mut MirBody,
    args_raw: *mut InterpValue,
    arg_count: usize,
    out_ret: *mut u8,
    out_ret_size: usize
) {
    if (body as usize) == 0 {
        return;
    }
    let mut frame = CallFrame {
        body: 0 as *mut MirBody,
        local_ptrs: 0 as *mut *mut u8,
        storage: 0 as *mut u8,
        storage_size: 0,
        local_cap: 0,
    };
    let alloc_start = frame_init(mut_view(*ctx), mut_view(frame), body, args_raw, arg_count);
    let prev_frame_storage = ctx.oracle.current_frame_storage;
    let prev_frame_storage_size = ctx.oracle.current_frame_storage_size;
    ctx.oracle.current_frame_storage = frame.storage;
    ctx.oracle.current_frame_storage_size = frame.storage_size;
    let bb_count = unsafe { (*body).bb_count };
    let mut current_bb = MirBbId { v: 0u32 };

    while !ctx.failed {
        ctx.steps = ctx.steps + 1;
        if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
            interp_check_step_limit(mut_view(*ctx));
            break;
        }
        if (current_bb.v as usize) >= bb_count {
            break;
        }
        ctx.oracle.current_frame_storage = frame.storage;
        ctx.oracle.current_frame_storage_size = frame.storage_size;

        if ctx.oracle.current_tid == 0u32 && ctx.oracle.active_thread_mask > 1u32 {
            let mut next_c: *mut HirItem = 0 as *mut HirItem;
            let mut next_t: u32 = 0u32;
            let cur_bb_copy = MirBbId { v: current_bb.v };
            if !bb_is_pairable_thread_call(view(*ctx), body, cur_bb_copy, 0u32, mut_view(next_c), mut_view(next_t)) {
                oracle_join_threads(mut_view(*ctx));
            }
        }

        let bb = unsafe { mir_bb_at((*body).bbs, current_bb.v as usize) };
        let stmt_count = unsafe { (*bb).stmt_count };
        let stmts = unsafe { (*bb).stmts };
        let mut i: usize = 0;
        while i < stmt_count {
            ctx.steps = ctx.steps + 1;
            if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
                interp_check_step_limit(mut_view(*ctx));
                break;
            }
            let stmt = unsafe { mir_stmt_at(stmts, i) };
            let mut dummy_yield = false;
            let mut dummy_spin = false;
            exec_single_mir_stmt(mut_view(*ctx), view(frame), body, stmt, mut_view(dummy_yield), mut_view(dummy_spin));
            if ctx.failed {
                break;
            }
            i = i + 1;
        }

        if ctx.failed {
            break;
        }

        let term = mir_bb_term_mut(bb);
        let tloc = Span {
            file: FileId { v: unsafe { (*term).location.file.v } },
            start: unsafe { (*term).location.start },
            end: unsafe { (*term).location.end },
        };
        if tloc.file.v != 0u32 || tloc.start != 0u32 || tloc.end != 0u32 {
            ctx.current_span = tloc;
        } else {
            ctx.current_span = Span {
                file: FileId { v: unsafe { (*term).span.file.v } },
                start: unsafe { (*term).span.start },
                end: unsafe { (*term).span.end },
            };
        }

        let tk = unsafe { (*term).kind };
        if tk == MIR_TERM_GOTO {
            let tgt = MirBbId { v: unsafe { (*term).goto_target.v } };
            if stmt_count == 0 && (tgt.v as usize) < bb_count && tgt.v <= current_bb.v && !ctx.is_comptime && ctx.step_limit >= 10000000 && ctx.steps >= 10 && (ctx.step_limit - 1) > ctx.steps {
                let tbb = unsafe { mir_bb_at((*body).bbs, tgt.v as usize) };
                if (unsafe { (*tbb).stmt_count }) == 1 && (unsafe { (*tbb).terminator.kind }) == MIR_TERM_SWITCH_INT && (unsafe { (*tbb).terminator.switch_count }) == 1 && (unsafe { (*mir_bb_id_at((*tbb).terminator.targets, 0)).v }) == current_bb.v {
                    let s0 = unsafe { mir_stmt_at((*tbb).stmts, 0) };
                    if (unsafe { (*s0).kind }) == MIR_STMT_ASSIGN {
                        let rvk0 = unsafe { (*s0).rvalue.kind };
                        if (rvk0 == MIR_RVALUE_BINARY_OP || rvk0 == MIR_RVALUE_OVERFLOWS_BINARY_OP) &&
                           (unsafe { (*s0).rvalue.lhs.kind }) == MIR_OP_CONST &&
                           (unsafe { (*s0).rvalue.rhs.kind }) == MIR_OP_CONST {
                            ctx.steps = ctx.step_limit - 1;
                        }
                    }
                } else if (unsafe { (*tbb).stmt_count }) == 0 && tgt.v == current_bb.v {
                    ctx.steps = ctx.step_limit - 1;
                }
            }
            current_bb = tgt;
        } else if tk == MIR_TERM_ASSERT {
            let cond = eval_operand_u64(mut_view(*ctx), view(frame), unsafe { view((*term).cond) });
            let expected = unsafe { (*term).expected };
            if (cond != 0u64) != expected {
                let msg_ptr = unsafe { (*term).msg_ptr };
                let msg_len = unsafe { (*term).msg_len };
                if (msg_ptr as usize) != 0 && msg_len > 0 {
                    interp_panic_sv(mut_view(*ctx), StrView { ptr: msg_ptr, len: msg_len });
                } else {
                    interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ASSERT);
                }
                break;
            }
            current_bb = MirBbId { v: unsafe { (*term).assert_target.v } };
        } else if tk == MIR_TERM_RETURN {
            break;
        } else if tk == MIR_TERM_DROP {
            current_bb = MirBbId { v: unsafe { (*term).drop_target.v } };
        } else if tk == MIR_TERM_SWITCH_INT {
            let discr = eval_operand_u64(mut_view(*ctx), view(frame), unsafe { view((*term).discr) });
            let mut next = MirBbId { v: unsafe { (*term).otherwise.v } };
            let scount = unsafe { (*term).switch_count };
            let svals = unsafe { (*term).values };
            let stargets = unsafe { (*term).targets };
            let mut s: usize = 0;
            while s < scount {
                let sv = unsafe { *mir_u64_at(svals, s) };
                if discr == sv {
                    let st = unsafe { mir_bb_id_at(stargets, s) };
                    next = MirBbId { v: unsafe { (*st).v } };
                    break;
                }
                s = s + 1;
            }
            current_bb = next;
        } else if tk == MIR_TERM_CALL {
            let mut handled_builtin = false;
            let mut next_bb = MirBbId { v: 0u32 };
            if (unsafe { (*term).func.kind }) == MIR_OP_CONST {
                let fty_id = TypeId { v: unsafe { (*term).func.constant.ty.v } };
                if fty_id.v != 0u32 && (ctx.thir as usize) != 0 {
                    let ft = unsafe { type_get(view((*ctx.thir).interner), fty_id) };
                    if (ft as usize) != 0 {
                        let ftk = unsafe { (*ft).kind };
                        handled_builtin = exec_builtin_call(mut_view(*ctx), view(frame), term, ftk, mut_view(next_bb));
                    }
                }
            }
            if handled_builtin {
                current_bb = next_bb;
            } else {
                let func_val = eval_operand_u64(mut_view(*ctx), view(frame), unsafe { view((*term).func) });
                let callee = find_func_by_symbol(view(*ctx), func_val);
                if (callee as usize) == 0 {
                    interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
                    break;
                }

                let mut special_tid: u32 = 0u32;
                if !ctx.is_comptime && ctx.oracle.current_tid == 0u32 {
                    special_tid = interp_classify_thread_fn(view(*ctx), callee);
                }

                if special_tid == 0xFFFFFFFEu32 {
                    if (unsafe { (*term).arg_count }) > 0 {
                        let arg0 = unsafe { mir_op_at((*term).args, 0) };
                        let seed_val = eval_operand_u64(mut_view(*ctx), view(frame), unsafe { view(*arg0) });
                        oracle_seed_prng(mut_view(*ctx), seed_val);
                    }
                    if ctx.oracle.active_thread_mask > 1u32 {
                        oracle_join_threads(mut_view(*ctx));
                    }
                    current_bb = MirBbId { v: unsafe { (*term).call_target.v } };
                } else if special_tid == 0xFFFFFFFDu32 {
                    oracle_join_threads(mut_view(*ctx));
                    current_bb = MirBbId { v: unsafe { (*term).call_target.v } };
                } else {
                    let next_call_bb_v = unsafe { (*term).call_target.v };
                    let next_call_bb = MirBbId { v: next_call_bb_v };
                    let mut callee1: *mut HirItem = 0 as *mut HirItem;
                    let mut tid1: u32 = 0u32;
                    if special_tid >= 1u32 && special_tid < 16u32 &&
                       bb_is_pairable_thread_call(view(*ctx), body, next_call_bb, special_tid, mut_view(callee1), mut_view(tid1)) {
                        let mut total_args0: usize = 0;
                        let mut args_bytes0: usize = 0;
                        let call_args0 = prepare_call_args_from_term(mut_view(*ctx), view(frame), term, callee, mut_view(total_args0), mut_view(args_bytes0));
                        let mut dest_ty0 = TypeId { v: 0u32 };
                        let mut dest_len0: u64 = 0u64;
                        let dest_ptr0 = get_place_ptr(mut_view(*ctx), view(frame), unsafe { view((*term).destination) }, mut_view(dest_ty0), mut_view(dest_len0));
                        let dest_sz0 = unsafe { type_size(dest_ty0, view((*ctx.thir).interner)) as usize };

                        let bb1_ptr = unsafe { mir_bb_at((*body).bbs, next_call_bb_v as usize) };
                        let sc1 = unsafe { (*bb1_ptr).stmt_count };
                        let stmts1 = unsafe { (*bb1_ptr).stmts };
                        let mut s1_idx: usize = 0;
                        while s1_idx < sc1 && !ctx.failed {
                            let s1 = unsafe { mir_stmt_at(stmts1, s1_idx) };
                            let mut dy = false;
                            let mut ds = false;
                            exec_single_mir_stmt(mut_view(*ctx), view(frame), body, s1, mut_view(dy), mut_view(ds));
                            s1_idx = s1_idx + 1;
                        }
                        let term1 = mir_bb_term_mut(bb1_ptr);
                        let mut total_args1: usize = 0;
                        let mut args_bytes1: usize = 0;
                        let call_args1 = prepare_call_args_from_term(mut_view(*ctx), view(frame), term1, callee1, mut_view(total_args1), mut_view(args_bytes1));
                        let mut dest_ty1 = TypeId { v: 0u32 };
                        let mut dest_len1: u64 = 0u64;
                        let dest_ptr1 = get_place_ptr(mut_view(*ctx), view(frame), unsafe { view((*term1).destination) }, mut_view(dest_ty1), mut_view(dest_len1));
                        let dest_sz1 = unsafe { type_size(dest_ty1, view((*ctx.thir).interner)) as usize };

                        if !ctx.failed {
                            exec_concurrent_pair(
                                mut_view(*ctx),
                                callee,
                                special_tid,
                                call_args0,
                                total_args0,
                                dest_ptr0,
                                dest_sz0,
                                callee1,
                                tid1,
                                call_args1,
                                total_args1,
                                dest_ptr1,
                                dest_sz1
                            );
                        }
                        unsafe {
                            heap_free(call_args1 as *mut u8, args_bytes1, align_of<InterpValue>());
                            heap_free(call_args0 as *mut u8, args_bytes0, align_of<InterpValue>());
                        }
                        if ctx.failed {
                            break;
                        }
                        current_bb = MirBbId { v: unsafe { (*term1).call_target.v } };
                    } else {
                        let mut total_args: usize = 0;
                        let mut args_bytes: usize = 0;
                        let call_args = prepare_call_args_from_term(mut_view(*ctx), view(frame), term, callee, mut_view(total_args), mut_view(args_bytes));
                        let mut dest_ty = TypeId { v: 0u32 };
                        let mut dest_len: u64 = 0u64;
                        let dest_ptr = get_place_ptr(mut_view(*ctx), view(frame), unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dest_len));
                        let dest_sz = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) as usize };

                        let ret_alloc_sz: usize = if dest_sz > size_of<InterpValue>() { dest_sz } else { size_of<InterpValue>() };
                        let big_ret = unsafe { heap_alloc(ret_alloc_sz, 16) };
                        unsafe {
                            interp_zero_bytes(big_ret, ret_alloc_sz);
                        }
                        let saved_tid = ctx.oracle.current_tid;
                        if special_tid >= 1u32 && special_tid < 16u32 {
                            let tbit = 1u32 << special_tid;
                            if ctx.oracle.active_thread_mask == 1u32 || (ctx.oracle.active_thread_mask & tbit) != 0u32 {
                                if ctx.oracle.active_thread_mask > 1u32 {
                                    oracle_join_threads(mut_view(*ctx));
                                }
                                oracle_begin_concurrent_batch(mut_view(*ctx));
                            }
                            oracle_fork_thread_for_batch(mut_view(*ctx), special_tid, callee as usize);
                            ctx.oracle.current_tid = special_tid;
                        }
                        eval_call_into(mut_view(*ctx), callee, call_args, total_args, big_ret, ret_alloc_sz);
                        ctx.oracle.current_tid = saved_tid;
                        ctx.oracle.current_frame_storage = frame.storage;
                        ctx.oracle.current_frame_storage_size = frame.storage_size;
                        unsafe {
                            heap_free(call_args as *mut u8, args_bytes, align_of<InterpValue>());
                        }
                        if ctx.failed {
                            unsafe {
                                heap_free(big_ret, ret_alloc_sz, 16);
                            }
                            break;
                        }
                        if dest_sz > 0 && (dest_ptr as usize) != 0 {
                            unsafe {
                                interp_copy_bytes(dest_ptr, big_ret as *const u8, dest_sz);
                            }
                        }
                        unsafe {
                            heap_free(big_ret, ret_alloc_sz, 16);
                        }
                        current_bb = MirBbId { v: next_call_bb_v };
                    }
                }
            }
        } else if tk == MIR_TERM_UNREACHABLE {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNREACHABLE);
            break;
        } else {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNSUPPORTED_TERM);
            break;
        }
    }

    if ctx.oracle.current_tid == 0u32 && ctx.oracle.active_thread_mask > 1u32 {
        oracle_join_threads(mut_view(*ctx));
    }
    frame_cleanup(mut_view(*ctx), mut_view(frame), alloc_start, out_ret, out_ret_size);
    ctx.oracle.current_frame_storage = prev_frame_storage;
    ctx.oracle.current_frame_storage_size = prev_frame_storage_size;
}

fn mir_bb_term_mut(bb: *mut MirBb) -> *mut MirTerminator {
    unsafe { address_of_mut((*bb).terminator) }
}

fn mir_body_map_mut_ptr(m: mut_view<MirBodyMap>) -> *mut MirBodyMap {
    unsafe { address_of_mut(*m) }
}

// =================================================================================================
// Cooperative Multi-Thread Scheduler & Futex Engine (SPEC-32 AXS-SYNC-004)
// =================================================================================================

const SCHED_STATE_UNUSED: u8 = 0u8;
const SCHED_STATE_RUNNABLE: u8 = 1u8;
const SCHED_STATE_BLOCKED_JOIN: u8 = 2u8;
const SCHED_STATE_BLOCKED_FUTEX: u8 = 3u8;
const SCHED_STATE_FINISHED: u8 = 4u8;

// "deadlock detected: all interpreter threads are blocked" (54 bytes)
const SCHED_DEADLOCK_MSG_BYTES: [54]u8 = [
    100u8, 101u8, 97u8, 100u8, 108u8, 111u8, 99u8, 107u8, 32u8,
    100u8, 101u8, 116u8, 101u8, 99u8, 116u8, 101u8, 100u8, 58u8, 32u8,
    97u8, 108u8, 108u8, 32u8, 105u8, 110u8, 116u8, 101u8, 114u8, 112u8,
    114u8, 101u8, 116u8, 101u8, 114u8, 32u8, 116u8, 104u8, 114u8, 101u8,
    97u8, 100u8, 115u8, 32u8, 97u8, 114u8, 101u8, 32u8, 98u8, 108u8,
    111u8, 99u8, 107u8, 101u8, 100u8,
];

struct SchedFrame {
    frame: CallFrame,
    body: *mut MirBody,
    current_bb: MirBbId,
    stmt_idx: usize,
    encoded_depth: i32,
    caller_dest_ptr: *mut u8,
    caller_dest_sz: usize,
    resume_bb: MirBbId,
}

struct SchedThread {
    handle: i64,
    thread_id: u64,
    vc_tid: u32,
    state: u8,
    panicked: bool,
    detached: bool,
    joined: bool,
    vc_released: bool,
    ret_val: i64,
    ctx_addr: u64,
    join_target_h: i64,
    join_out_ret_addr: u64,
    futex_addr: u64,
    futex_has_deadline: bool,
    futex_deadline_ns: u64,
    wait_seq: u64,
    frames: *mut SchedFrame,
    frame_len: usize,
    frame_cap: usize,
    pending_ret_ptr: *mut u8,
    pending_ret_sz: usize,
}

struct InterpThreadSched {
    live_spawned_count: usize,
    vc_in_use_mask: u32,
    next_wait_seq: u64,
    virtual_ns: u64,
    rr_cursor: usize,
    base_call_depth_limit: i32,
    threads: *mut SchedThread,
    thread_len: usize,
    thread_cap: usize,
}

unsafe fn sched_frame_at(base: *mut SchedFrame, idx: usize) -> *mut SchedFrame {
    let off = interp_mul_usize(idx, size_of<SchedFrame>());
    ((base as usize) + off) as *mut SchedFrame
}

unsafe fn sched_thread_at(base: *mut SchedThread, idx: usize) -> *mut SchedThread {
    let off = interp_mul_usize(idx, size_of<SchedThread>());
    ((base as usize) + off) as *mut SchedThread
}

fn program_uses_host_threads(ctx: view<InterpCtx>) -> bool {
    if (ctx.hir as usize) == 0 || (ctx.interner as usize) == 0 {
        return false;
    }
    let mut it: *mut HirItem = unsafe { (*ctx.hir).items };
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_FN {
            let nid = unsafe { (*it).name.v };
            if nid != 0u32 {
                let sv = unsafe { interner_get(view(*ctx.interner), StrId { v: nid }) };
                if interp_host_thread_intrinsic_kind(view(sv)) != HOST_INTR_NONE {
                    if func_has_intrinsic_attr(ctx, it as *const HirItem) {
                        return true;
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

fn sched_alloc_vc_tid(sched: *mut InterpThreadSched) -> u32 {
    let mask = unsafe { (*sched).vc_in_use_mask };
    let mut t: u32 = 1u32;
    while t < 16u32 {
        let bit = 1u32 << t;
        if (mask & bit) == 0u32 {
            unsafe {
                (*sched).vc_in_use_mask = mask | bit;
            }
            return t;
        }
        t = t + 1u32;
    }
    0u32
}

fn sched_release_vc_tid(sched: *mut InterpThreadSched, vc_tid: u32, vc_released: mut_view<bool>) {
    if *vc_released || vc_tid == 0u32 || vc_tid >= 16u32 {
        return;
    }
    *vc_released = true;
    let bit = 1u32 << vc_tid;
    unsafe {
        (*sched).vc_in_use_mask = (*sched).vc_in_use_mask & (bit ^ 0xFFFFFFFFu32);
    }
}

fn sched_write_i64_ret(dest_ptr: *mut u8, dest_sz: usize, val: i64) {
    if (dest_ptr as usize) == 0 || dest_sz == 0 {
        return;
    }
    let uval = val as u64;
    if dest_sz >= 8 {
        unsafe {
            *(dest_ptr as *mut u64) = uval;
        }
    } else if dest_sz == 4 {
        unsafe {
            *(dest_ptr as *mut u32) = uval as u32;
        }
    } else if dest_sz == 2 {
        unsafe {
            *(dest_ptr as *mut u16) = uval as u16;
        }
    } else {
        unsafe {
            *dest_ptr = uval as u8;
        }
    }
}

fn sched_report_deadlock(ctx: mut_view<InterpCtx>) {
    let n: usize = 54;
    let dst = arena_alloc_raw(mut_view(ctx.arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = SCHED_DEADLOCK_MSG_BYTES[i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    let msg = StrView { ptr: dst as *const u8, len: n };
    interp_push_diag(mut_view(*ctx), AX_DRIVER_INTERP_STEP_LIMIT, ctx.current_span, msg);
    ctx.failed = true;
    ctx.exit_code = 124;
}

fn sched_push_frame(
    ctx: mut_view<InterpCtx>,
    sched: *mut InterpThreadSched,
    t_idx: usize,
    body: *mut MirBody,
    args_raw: *const InterpValue,
    arg_count: usize,
    caller_dest_ptr: *mut u8,
    caller_dest_sz: usize,
    resume_bb: MirBbId
) -> bool {
    let thr = unsafe { sched_thread_at((*sched).threads, t_idx) };
    let flen = unsafe { (*thr).frame_len };
    let depth_1based = (flen + 1) as i32;
    let d_limit = unsafe { (*sched).base_call_depth_limit };
    if d_limit > 0 && depth_1based > d_limit {
        interp_report_stack_limit(mut_view(*ctx));
        return false;
    }
    let fcap = unsafe { (*thr).frame_cap };
    if flen >= fcap {
        let new_cap: usize = if fcap == 0 { 16 } else { interp_mul_usize(fcap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<SchedFrame>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<SchedFrame>()) as *mut SchedFrame };
        unsafe {
            interp_zero_bytes(new_arr as *mut u8, new_bytes);
        }
        let old_arr = unsafe { (*thr).frames };
        if flen > 0 && (old_arr as usize) != 0 {
            let old_bytes = interp_mul_usize(flen, size_of<SchedFrame>());
            let old_cap_bytes = interp_mul_usize(fcap, size_of<SchedFrame>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, old_arr as *const u8, old_bytes);
                heap_free(old_arr as *mut u8, old_cap_bytes, align_of<SchedFrame>());
            }
        }
        unsafe {
            (*thr).frames = new_arr;
            (*thr).frame_cap = new_cap;
        }
    }
    let enc_depth: i32 = ((t_idx as i32) * 65536) + depth_1based;
    ctx.call_depth = enc_depth;
    let sf = unsafe { sched_frame_at((*thr).frames, flen) };
    unsafe {
        (*sf).frame.body = 0 as *mut MirBody;
        (*sf).frame.local_ptrs = 0 as *mut *mut u8;
        (*sf).frame.storage = 0 as *mut u8;
        (*sf).frame.storage_size = 0;
        (*sf).frame.local_cap = 0;
        let _ = frame_init(mut_view(*ctx), mut_view((*sf).frame), body, args_raw, arg_count);
        (*sf).body = body;
        (*sf).current_bb = MirBbId { v: 0u32 };
        (*sf).stmt_idx = 0;
        (*sf).encoded_depth = enc_depth;
        (*sf).caller_dest_ptr = caller_dest_ptr;
        (*sf).caller_dest_sz = caller_dest_sz;
        (*sf).resume_bb = resume_bb;
        (*thr).frame_len = flen + 1;
    }
    true
}

fn sched_pop_top_frame(
    ctx: mut_view<InterpCtx>,
    sched: *mut InterpThreadSched,
    t_idx: usize,
    copy_ret: bool
) {
    let thr = unsafe { sched_thread_at((*sched).threads, t_idx) };
    let flen = unsafe { (*thr).frame_len };
    if flen == 0 {
        return;
    }
    let top_idx = flen - 1;
    let sf = unsafe { sched_frame_at((*thr).frames, top_idx) };
    ctx.call_depth = unsafe { (*sf).encoded_depth };
    let dest_ptr = if copy_ret { unsafe { (*sf).caller_dest_ptr } } else { 0 as *mut u8 };
    let dest_sz = if copy_ret { unsafe { (*sf).caller_dest_sz } } else { 0 };
    let resume_bb = unsafe { (*sf).resume_bb };
    unsafe {
        frame_cleanup(mut_view(*ctx), mut_view((*sf).frame), 0, dest_ptr, dest_sz);
        (*thr).frame_len = top_idx;
    }
    if top_idx > 0 {
        let caller_sf = unsafe { sched_frame_at((*thr).frames, top_idx - 1) };
        unsafe {
            (*caller_sf).current_bb = resume_bb;
            (*caller_sf).stmt_idx = 0;
        }
    }
}

fn sched_unwind_thread_frames(ctx: mut_view<InterpCtx>, sched: *mut InterpThreadSched, t_idx: usize) {
    let thr = unsafe { sched_thread_at((*sched).threads, t_idx) };
    while (unsafe { (*thr).frame_len }) > 0 {
        let top_idx = (unsafe { (*thr).frame_len }) - 1;
        let sf = unsafe { sched_frame_at((*thr).frames, top_idx) };
        ctx.call_depth = unsafe { (*sf).encoded_depth };
        let saved_failed = ctx.failed;
        ctx.failed = true;
        unsafe {
            frame_cleanup(mut_view(*ctx), mut_view((*sf).frame), 0, 0 as *mut u8, 0);
            (*thr).frame_len = top_idx;
        }
        ctx.failed = saved_failed;
    }
}

fn sched_alloc_thread(sched: *mut InterpThreadSched, vc_tid: u32, ctx_addr: u64) -> usize {
    let tlen = unsafe { (*sched).thread_len };
    let tcap = unsafe { (*sched).thread_cap };
    if tlen >= tcap {
        let new_cap: usize = if tcap == 0 { 16 } else { interp_mul_usize(tcap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<SchedThread>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<SchedThread>()) as *mut SchedThread };
        unsafe {
            interp_zero_bytes(new_arr as *mut u8, new_bytes);
        }
        let old_arr = unsafe { (*sched).threads };
        if tlen > 0 && (old_arr as usize) != 0 {
            let old_bytes = interp_mul_usize(tlen, size_of<SchedThread>());
            let old_cap_bytes = interp_mul_usize(tcap, size_of<SchedThread>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, old_arr as *const u8, old_bytes);
                heap_free(old_arr as *mut u8, old_cap_bytes, align_of<SchedThread>());
            }
        }
        unsafe {
            (*sched).threads = new_arr;
            (*sched).thread_cap = new_cap;
        }
    }
    let idx = tlen;
    let thr = unsafe { sched_thread_at((*sched).threads, idx) };
    unsafe {
        interp_zero_bytes(thr as *mut u8, size_of<SchedThread>());
        (*thr).handle = idx as i64;
        (*thr).thread_id = (idx as u64) + 1u64;
        (*thr).vc_tid = vc_tid;
        (*thr).state = SCHED_STATE_RUNNABLE;
        (*thr).ctx_addr = ctx_addr;
        (*sched).thread_len = idx + 1;
    }
    idx
}

fn sched_complete_join(
    ctx: mut_view<InterpCtx>,
    sched: *mut InterpThreadSched,
    waiter_idx: usize,
    child_idx: usize,
    out_ret_addr: u64,
    dest_ptr: *mut u8,
    dest_sz: usize
) {
    let waiter = unsafe { sched_thread_at((*sched).threads, waiter_idx) };
    let child = unsafe { sched_thread_at((*sched).threads, child_idx) };
    let waiter_vc = unsafe { (*waiter).vc_tid };
    let child_vc = unsafe { (*child).vc_tid };
    let child_ret = unsafe { (*child).ret_val };
    let prev_tid = ctx.oracle.current_tid;
    ctx.oracle.current_tid = waiter_vc;
    oracle_on_thread_join(mut_view(*ctx), waiter_vc, child_vc);
    if out_ret_addr != 0u64 {
        let out_host = interp_validate_raw_ptr(mut_view(*ctx), out_ret_addr, 8u64, 8u32);
        if !ctx.failed && (out_host as usize) != 0 {
            oracle_record_ordinary_write(mut_view(*ctx), out_host as *const u8, 8u32);
            if !ctx.failed {
                unsafe {
                    *(out_host as *mut i64) = child_ret;
                }
            }
        }
    }
    ctx.oracle.current_tid = prev_tid;
    unsafe {
        (*child).joined = true;
        sched_release_vc_tid(sched, child_vc, mut_view((*child).vc_released));
        (*waiter).state = SCHED_STATE_RUNNABLE;
        (*waiter).join_target_h = 0i64;
        (*waiter).join_out_ret_addr = 0u64;
    }
    sched_write_i64_ret(dest_ptr, dest_sz, 0i64);
}

fn sched_notify_thread_finished(
    ctx: mut_view<InterpCtx>,
    sched: *mut InterpThreadSched,
    child_idx: usize
) {
    let child = unsafe { sched_thread_at((*sched).threads, child_idx) };
    unsafe {
        (*child).state = SCHED_STATE_FINISHED;
    }
    if child_idx == 0 {
        return;
    }
    unsafe {
        if (*sched).live_spawned_count > 0 {
            (*sched).live_spawned_count = (*sched).live_spawned_count - 1;
        }
    }
    let child_h = child_idx as i64;
    let tlen = unsafe { (*sched).thread_len };
    let mut w: usize = 0;
    while w < tlen {
        let wt = unsafe { sched_thread_at((*sched).threads, w) };
        if (unsafe { (*wt).state }) == SCHED_STATE_BLOCKED_JOIN && (unsafe { (*wt).join_target_h }) == child_h {
            let out_addr = unsafe { (*wt).join_out_ret_addr };
            let p_ptr = unsafe { (*wt).pending_ret_ptr };
            let p_sz = unsafe { (*wt).pending_ret_sz };
            sched_complete_join(mut_view(*ctx), sched, w, child_idx, out_addr, p_ptr, p_sz);
            return;
        }
        w = w + 1;
    }
    if unsafe { (*child).detached } {
        let cvc = unsafe { (*child).vc_tid };
        unsafe {
            sched_release_vc_tid(sched, cvc, mut_view((*child).vc_released));
        }
    }
}

fn sched_wake_expired_futexes(sched: *mut InterpThreadSched) {
    let now_ns = unsafe { (*sched).virtual_ns };
    let tlen = unsafe { (*sched).thread_len };
    let mut i: usize = 0;
    while i < tlen {
        let thr = unsafe { sched_thread_at((*sched).threads, i) };
        if (unsafe { (*thr).state }) == SCHED_STATE_BLOCKED_FUTEX &&
           (unsafe { (*thr).futex_has_deadline }) &&
           (unsafe { (*thr).futex_deadline_ns }) <= now_ns {
            let p_ptr = unsafe { (*thr).pending_ret_ptr };
            let p_sz = unsafe { (*thr).pending_ret_sz };
            sched_write_i64_ret(p_ptr, p_sz, -5i64);
            unsafe {
                (*thr).state = SCHED_STATE_RUNNABLE;
                (*thr).futex_addr = 0u64;
                (*thr).futex_has_deadline = false;
            }
        }
        i = i + 1;
    }
}

fn resolve_callee_impl_fn(ctx: view<InterpCtx>, func_in: *mut HirItem) -> *mut HirItem {
    let mut func = func_in;
    if (func as usize) == 0 {
        return func;
    }
    if (unsafe { (*func).kind }) == HIR_ITEM_FN && (unsafe { (*func).body as usize }) == 0 && (ctx.interner as usize) != 0 && (ctx.hir as usize) != 0 {
        let fname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*func).name.v }) };
        let mut it: *mut HirItem = unsafe { (*ctx.hir).items };
        while (it as usize) != 0 {
            if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).body as usize }) != 0 {
                        let mname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*m).name.v }) };
                        if interp_sv_eq(view(fname), view(mname)) {
                            func = m;
                            break;
                        }
                    }
                    m = unsafe { (*m).next };
                }
                if (unsafe { (*func).body as usize }) != 0 {
                    break;
                }
            }
            it = unsafe { (*it).next };
        }
    }
    func
}

fn sched_has_join_waiter(sched: *mut InterpThreadSched, target_h: i64) -> bool {
    let tlen = unsafe { (*sched).thread_len };
    let mut i: usize = 0;
    while i < tlen {
        let wt = unsafe { sched_thread_at((*sched).threads, i) };
        if (unsafe { (*wt).state }) == SCHED_STATE_BLOCKED_JOIN && (unsafe { (*wt).join_target_h }) == target_h {
            return true;
        }
        i = i + 1;
    }
    false
}

fn sched_exec_thread_intrinsic(
    ctx: mut_view<InterpCtx>,
    sched: *mut InterpThreadSched,
    t_idx: usize,
    tkind: u8,
    args_raw: *const InterpValue,
    arg_count: usize,
    dest_ptr: *mut u8,
    dest_sz: usize,
    resume_bb: MirBbId,
    out_yielded: mut_view<bool>
) {
    let a0: u64 = if arg_count > 0 && (args_raw as usize) != 0 {
        unsafe { (*interp_val_at(args_raw as *mut InterpValue, 0)).vals[0] }
    } else {
        0u64
    };
    let a1: u64 = if arg_count > 1 && (args_raw as usize) != 0 {
        unsafe { (*interp_val_at(args_raw as *mut InterpValue, 1)).vals[0] }
    } else {
        0u64
    };
    let a2: u64 = if arg_count > 2 && (args_raw as usize) != 0 {
        unsafe { (*interp_val_at(args_raw as *mut InterpValue, 2)).vals[0] }
    } else {
        0u64
    };

    let thr0 = unsafe { sched_thread_at((*sched).threads, t_idx) };
    let flen0 = unsafe { (*thr0).frame_len };
    if flen0 > 0 {
        let sf0 = unsafe { sched_frame_at((*thr0).frames, flen0 - 1) };
        unsafe {
            (*sf0).current_bb = resume_bb;
            (*sf0).stmt_idx = 0;
        }
    }

    if tkind == HOST_INTR_THREAD_CURRENT_ID {
        let tid = unsafe { (*thr0).thread_id };
        sched_write_i64_ret(dest_ptr, dest_sz, tid as i64);
        return;
    }

    if tkind == HOST_INTR_THREAD_YIELD {
        *out_yielded = true;
        return;
    }

    if tkind == HOST_INTR_THREAD_SLEEP_NS {
        unsafe {
            (*sched).virtual_ns = w_add_u64((*sched).virtual_ns, a0);
        }
        oracle_advance_sleep_ns(mut_view(*ctx), a0);
        sched_wake_expired_futexes(sched);
        *out_yielded = true;
        return;
    }

    if tkind == HOST_INTR_THREAD_SPAWN {
        if a0 == 0u64 {
            sched_write_i64_ret(dest_ptr, dest_sz, -4i64);
            return;
        }
        let entry_raw = find_func_by_symbol(view(*ctx), a0);
        let entry_fn = resolve_callee_impl_fn(view(*ctx), entry_raw);
        if (entry_fn as usize) == 0 {
            sched_write_i64_ret(dest_ptr, dest_sz, -4i64);
            return;
        }
        let entry_body = resolve_or_build_mir_body(mut_view(*ctx), entry_fn);
        if (entry_body as usize) == 0 {
            sched_write_i64_ret(dest_ptr, dest_sz, -9i64);
            return;
        }
        let child_vc = sched_alloc_vc_tid(sched);
        if child_vc == 0u32 {
            sched_write_i64_ret(dest_ptr, dest_sz, -9i64);
            return;
        }
        let child_idx = sched_alloc_thread(sched, child_vc, a1);
        if a1 != 0u64 {
            let pkt_h = interp_validate_raw_ptr(mut_view(*ctx), a1, 40u64, 8u32);
            if !ctx.failed && (pkt_h as usize) != 0 {
                if (unsafe { *(pkt_h as *const u64) }) == 0x4158544852504B54u64 {
                    unsafe {
                        *((pkt_h + 32) as *mut u64) = (child_idx as u64) + 1u64;
                    }
                }
            } else {
                ctx.failed = false;
            }
        }
        let p_thr = unsafe { sched_thread_at((*sched).threads, t_idx) };
        let parent_vc = unsafe { (*p_thr).vc_tid };
        oracle_on_thread_spawn(mut_view(*ctx), parent_vc, child_vc);

        let mut child_arg = InterpValue { vals: [0u64; 32] };
        child_arg.vals[0] = a1;
        let child_arg_ptr = unsafe { address_of(child_arg) };
        let pushed = sched_push_frame(
            mut_view(*ctx),
            sched,
            child_idx,
            entry_body,
            child_arg_ptr,
            1,
            0 as *mut u8,
            0,
            MirBbId { v: 0u32 }
        );
        if !pushed {
            return;
        }
        unsafe {
            (*sched).live_spawned_count = (*sched).live_spawned_count + 1;
        }
        sched_write_i64_ret(dest_ptr, dest_sz, child_idx as i64);
        *out_yielded = true;
        return;
    }

    if tkind == HOST_INTR_THREAD_DETACH {
        let h = a0 as i64;
        let tlen = unsafe { (*sched).thread_len };
        if h <= 0i64 || (h as usize) >= tlen || sched_has_join_waiter(sched, h) {
            sched_write_i64_ret(dest_ptr, dest_sz, -4i64);
            return;
        }
        let target = unsafe { sched_thread_at((*sched).threads, h as usize) };
        if (unsafe { (*target).state }) == SCHED_STATE_UNUSED ||
           (unsafe { (*target).joined }) ||
           (unsafe { (*target).detached }) {
            sched_write_i64_ret(dest_ptr, dest_sz, -4i64);
            return;
        }
        unsafe {
            (*target).detached = true;
            if (*target).state == SCHED_STATE_FINISHED {
                let cvc = (*target).vc_tid;
                sched_release_vc_tid(sched, cvc, mut_view((*target).vc_released));
            }
        }
        sched_write_i64_ret(dest_ptr, dest_sz, 0i64);
        return;
    }

    if tkind == HOST_INTR_THREAD_JOIN {
        let h = a0 as i64;
        let out_ret_addr = a1;
        let tlen = unsafe { (*sched).thread_len };
        if h <= 0i64 || (h as usize) >= tlen || (h as usize) == t_idx || sched_has_join_waiter(sched, h) {
            sched_write_i64_ret(dest_ptr, dest_sz, -4i64);
            return;
        }
        let target = unsafe { sched_thread_at((*sched).threads, h as usize) };
        if (unsafe { (*target).state }) == SCHED_STATE_UNUSED ||
           (unsafe { (*target).joined }) ||
           (unsafe { (*target).detached }) {
            sched_write_i64_ret(dest_ptr, dest_sz, -4i64);
            return;
        }
        if out_ret_addr != 0u64 {
            let _ = interp_validate_raw_ptr(mut_view(*ctx), out_ret_addr, 8u64, 8u32);
            if ctx.failed {
                return;
            }
        }
        if (unsafe { (*target).state }) == SCHED_STATE_FINISHED {
            sched_complete_join(mut_view(*ctx), sched, t_idx, h as usize, out_ret_addr, dest_ptr, dest_sz);
            return;
        }
        let waiter = unsafe { sched_thread_at((*sched).threads, t_idx) };
        unsafe {
            (*waiter).state = SCHED_STATE_BLOCKED_JOIN;
            (*waiter).join_target_h = h;
            (*waiter).join_out_ret_addr = out_ret_addr;
            (*waiter).pending_ret_ptr = dest_ptr;
            (*waiter).pending_ret_sz = dest_sz;
        }
        *out_yielded = true;
        return;
    }

    if tkind == HOST_INTR_FUTEX_WAIT {
        let addr = a0;
        let expected = a1 as u32;
        let timeout_ns = a2;
        let mut ferr: i64 = 0i64;
        let cur_u32 = oracle_futex_peek_u32(mut_view(*ctx), addr, mut_view(ferr));
        if ctx.failed {
            return;
        }
        if ferr != 0i64 {
            sched_write_i64_ret(dest_ptr, dest_sz, ferr);
            return;
        }
        if cur_u32 != expected {
            sched_write_i64_ret(dest_ptr, dest_sz, 0i64);
            return;
        }
        if timeout_ns == 0u64 {
            sched_write_i64_ret(dest_ptr, dest_sz, -5i64);
            return;
        }
        let waiter = unsafe { sched_thread_at((*sched).threads, t_idx) };
        let seq = unsafe { (*sched).next_wait_seq };
        unsafe {
            (*sched).next_wait_seq = seq + 1u64;
            (*waiter).state = SCHED_STATE_BLOCKED_FUTEX;
            (*waiter).futex_addr = addr;
            (*waiter).wait_seq = seq;
            (*waiter).pending_ret_ptr = dest_ptr;
            (*waiter).pending_ret_sz = dest_sz;
            if timeout_ns == 0xFFFFFFFFFFFFFFFFu64 {
                (*waiter).futex_has_deadline = false;
                (*waiter).futex_deadline_ns = 0u64;
            } else {
                (*waiter).futex_has_deadline = true;
                (*waiter).futex_deadline_ns = w_add_u64((*sched).virtual_ns, timeout_ns);
            }
        }
        *out_yielded = true;
        return;
    }

    if tkind == HOST_INTR_FUTEX_WAKE {
        let addr = a0;
        let count = a1 as u32;
        let werr = oracle_futex_validate_addr(mut_view(*ctx), addr);
        if ctx.failed {
            return;
        }
        if werr != 0i64 {
            sched_write_i64_ret(dest_ptr, dest_sz, werr);
            return;
        }
        let mut woken: u32 = 0u32;
        while woken < count {
            let mut best_idx: usize = 0xFFFFFFFFusize;
            let mut best_seq: u64 = 0xFFFFFFFFFFFFFFFFu64;
            let tlen = unsafe { (*sched).thread_len };
            let mut i: usize = 0;
            while i < tlen {
                let wt = unsafe { sched_thread_at((*sched).threads, i) };
                if (unsafe { (*wt).state }) == SCHED_STATE_BLOCKED_FUTEX &&
                   (unsafe { (*wt).futex_addr }) == addr {
                    let wseq = unsafe { (*wt).wait_seq };
                    if best_idx == 0xFFFFFFFFusize || wseq < best_seq {
                        best_idx = i;
                        best_seq = wseq;
                    }
                }
                i = i + 1;
            }
            if best_idx == 0xFFFFFFFFusize {
                break;
            }
            let bt = unsafe { sched_thread_at((*sched).threads, best_idx) };
            let p_ptr = unsafe { (*bt).pending_ret_ptr };
            let p_sz = unsafe { (*bt).pending_ret_sz };
            sched_write_i64_ret(p_ptr, p_sz, 0i64);
            unsafe {
                (*bt).state = SCHED_STATE_RUNNABLE;
                (*bt).futex_addr = 0u64;
                (*bt).futex_has_deadline = false;
            }
            woken = woken + 1u32;
        }
        sched_write_i64_ret(dest_ptr, dest_sz, woken as i64);
    }
}

fn sched_handle_child_panic_if_any(
    ctx: mut_view<InterpCtx>,
    sched: *mut InterpThreadSched,
    t_idx: usize,
    saved_panicked: bool,
    saved_panic_ptr: *const u8,
    saved_panic_len: usize,
    saved_exit_code: i32
) {
    if t_idx == 0 || !ctx.failed || !ctx.has_panicked || ctx.has_exited {
        return;
    }
    ctx.failed = false;
    ctx.has_panicked = saved_panicked;
    ctx.panic_msg_ptr = saved_panic_ptr;
    ctx.panic_msg_len = saved_panic_len;
    ctx.exit_code = saved_exit_code;

    let p_thr = unsafe { sched_thread_at((*sched).threads, t_idx) };
    let ctx_addr = unsafe { (*p_thr).ctx_addr };
    let p_vc = unsafe { (*p_thr).vc_tid };
    ctx.oracle.current_tid = p_vc;
    if ctx_addr != 0u64 {
        let pkt_host = interp_validate_raw_ptr(mut_view(*ctx), ctx_addr, 16u64, 8u32);
        if !ctx.failed && (pkt_host as usize) != 0 {
            let magic = unsafe { *(pkt_host as *const u64) };
            if magic == 0x4158544852504B54u64 {
                let lw_ptr = unsafe { pkt_host + 8 };
                let _ = oracle_atomic_rmw(mut_view(*ctx), lw_ptr, 4u32, MIR_ATOMIC_OR, 1u64, MIR_ORDER_SEQ_CST);
            }
        } else {
            ctx.failed = false;
        }
    }
    sched_unwind_thread_frames(mut_view(*ctx), sched, t_idx);
    let p_thr2 = unsafe { sched_thread_at((*sched).threads, t_idx) };
    unsafe {
        (*p_thr2).panicked = true;
        (*p_thr2).ret_val = -101i64;
    }
    sched_notify_thread_finished(mut_view(*ctx), sched, t_idx);
}

fn sched_step_thread(ctx: mut_view<InterpCtx>, sched: *mut InterpThreadSched, t_idx: usize) {
    let thr = unsafe { sched_thread_at((*sched).threads, t_idx) };
    if (unsafe { (*thr).state }) != SCHED_STATE_RUNNABLE {
        return;
    }
    let flen = unsafe { (*thr).frame_len };
    if flen == 0 {
        sched_notify_thread_finished(mut_view(*ctx), sched, t_idx);
        return;
    }

    let saved_panicked = ctx.has_panicked;
    let saved_panic_ptr = ctx.panic_msg_ptr;
    let saved_panic_len = ctx.panic_msg_len;
    let saved_exit_code = ctx.exit_code;

    let sf = unsafe { sched_frame_at((*thr).frames, flen - 1) };
    ctx.oracle.current_tid = unsafe { (*thr).vc_tid };
    ctx.oracle.current_frame_storage = unsafe { (*sf).frame.storage };
    ctx.oracle.current_frame_storage_size = unsafe { (*sf).frame.storage_size };
    ctx.call_depth = unsafe { (*sf).encoded_depth };

    ctx.steps = ctx.steps + 1;
    if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
        interp_check_step_limit(mut_view(*ctx));
        return;
    }

    let body = unsafe { (*sf).body };
    let bb_count = unsafe { (*body).bb_count };
    let cur_bb = MirBbId { v: unsafe { (*sf).current_bb.v } };
    if (cur_bb.v as usize) >= bb_count {
        sched_pop_top_frame(mut_view(*ctx), sched, t_idx, false);
        let thr_chk = unsafe { sched_thread_at((*sched).threads, t_idx) };
        if (unsafe { (*thr_chk).frame_len }) == 0 {
            sched_notify_thread_finished(mut_view(*ctx), sched, t_idx);
        }
        return;
    }

    let bb = unsafe { mir_bb_at((*body).bbs, cur_bb.v as usize) };
    let stmt_count = unsafe { (*bb).stmt_count };
    let stmts = unsafe { (*bb).stmts };
    let mut s_idx = unsafe { (*sf).stmt_idx };
    let mut yielded = false;
    while s_idx < stmt_count && !ctx.failed && !yielded {
        ctx.steps = ctx.steps + 1;
        if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
            interp_check_step_limit(mut_view(*ctx));
            break;
        }
        let stmt = unsafe { mir_stmt_at(stmts, s_idx) };
        let mut dummy_spin = false;
        exec_single_mir_stmt(mut_view(*ctx), unsafe { view((*sf).frame) }, body, stmt, mut_view(yielded), mut_view(dummy_spin));
        s_idx = s_idx + 1;
    }
    unsafe {
        (*sf).stmt_idx = s_idx;
    }
    if ctx.failed {
        sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
        return;
    }
    if s_idx < stmt_count {
        return;
    }

    let term = mir_bb_term_mut(bb);
    let tloc = Span {
        file: FileId { v: unsafe { (*term).location.file.v } },
        start: unsafe { (*term).location.start },
        end: unsafe { (*term).location.end },
    };
    if tloc.file.v != 0u32 || tloc.start != 0u32 || tloc.end != 0u32 {
        ctx.current_span = tloc;
    } else {
        ctx.current_span = Span {
            file: FileId { v: unsafe { (*term).span.file.v } },
            start: unsafe { (*term).span.start },
            end: unsafe { (*term).span.end },
        };
    }

    let tk = unsafe { (*term).kind };
    if tk == MIR_TERM_GOTO {
        let tgt = MirBbId { v: unsafe { (*term).goto_target.v } };
        unsafe {
            (*sf).current_bb = tgt;
            (*sf).stmt_idx = 0;
        }
        return;
    }

    if tk == MIR_TERM_ASSERT {
        let cond = eval_operand_u64(mut_view(*ctx), unsafe { view((*sf).frame) }, unsafe { view((*term).cond) });
        let expected = unsafe { (*term).expected };
        if (cond != 0u64) != expected {
            let msg_ptr = unsafe { (*term).msg_ptr };
            let msg_len = unsafe { (*term).msg_len };
            if (msg_ptr as usize) != 0 && msg_len > 0 {
                interp_panic_sv(mut_view(*ctx), StrView { ptr: msg_ptr, len: msg_len });
            } else {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_ASSERT);
            }
            sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
            return;
        }
        unsafe {
            (*sf).current_bb = MirBbId { v: (*term).assert_target.v };
            (*sf).stmt_idx = 0;
        }
        return;
    }

    if tk == MIR_TERM_RETURN {
        if flen == 1 && t_idx > 0 {
            let loc0_ptr = get_local_ptr(mut_view(*ctx), unsafe { view((*sf).frame) }, MirLocalId { v: 0u32 });
            if (loc0_ptr as usize) != 0 {
                let p_i64: *const i64 = loc0_ptr as *const i64;
                unsafe {
                    (*thr).ret_val = *p_i64;
                }
            }
        }
        sched_pop_top_frame(mut_view(*ctx), sched, t_idx, true);
        let thr_after = unsafe { sched_thread_at((*sched).threads, t_idx) };
        if (unsafe { (*thr_after).frame_len }) == 0 {
            sched_notify_thread_finished(mut_view(*ctx), sched, t_idx);
        }
        return;
    }

    if tk == MIR_TERM_DROP {
        unsafe {
            (*sf).current_bb = MirBbId { v: (*term).drop_target.v };
            (*sf).stmt_idx = 0;
        }
        return;
    }

    if tk == MIR_TERM_SWITCH_INT {
        let discr = eval_operand_u64(mut_view(*ctx), unsafe { view((*sf).frame) }, unsafe { view((*term).discr) });
        let mut next = MirBbId { v: unsafe { (*term).otherwise.v } };
        let scount = unsafe { (*term).switch_count };
        let svals = unsafe { (*term).values };
        let stargets = unsafe { (*term).targets };
        let mut s: usize = 0;
        while s < scount {
            let sv = unsafe { *mir_u64_at(svals, s) };
            if discr == sv {
                let st = unsafe { mir_bb_id_at(stargets, s) };
                next = MirBbId { v: unsafe { (*st).v } };
                break;
            }
            s = s + 1;
        }
        unsafe {
            (*sf).current_bb = next;
            (*sf).stmt_idx = 0;
        }
        return;
    }

    if tk == MIR_TERM_CALL {
        if (unsafe { (*term).func.kind }) == MIR_OP_CONST {
            let fty_id = TypeId { v: unsafe { (*term).func.constant.ty.v } };
            if fty_id.v != 0u32 && (ctx.thir as usize) != 0 {
                let ft = unsafe { type_get(view((*ctx.thir).interner), fty_id) };
                if (ft as usize) != 0 {
                    let ftk = unsafe { (*ft).kind };
                    if ftk == TY_BUILTIN_DROP_IN_PLACE {
                        let d_args = unsafe { (*term).args };
                        let arg0 = unsafe { mir_op_at(d_args, 0) };
                        let addr = eval_operand_u64(mut_view(*ctx), unsafe { view((*sf).frame) }, unsafe { view(*arg0) });
                        let elem_ty_v = unsafe { (*term).func.constant.val as u32 };
                        let sz = unsafe { type_size(TypeId { v: elem_ty_v }, view((*ctx.thir).interner)) };
                        let al = unsafe { type_align(TypeId { v: elem_ty_v }, view((*ctx.thir).interner)) };
                        let host_ptr = interp_validate_raw_ptr(mut_view(*ctx), addr, sz as u64, al);
                        let next_drop_bb_v = unsafe { (*term).call_target.v };
                        let mut pushed_drop = false;
                        if !ctx.failed {
                            let drop_fn = find_drop_fn_for_type(view(*ctx), TypeId { v: elem_ty_v });
                            if (drop_fn as usize) != 0 {
                                let drop_body = resolve_or_build_mir_body(mut_view(*ctx), drop_fn);
                                if (drop_body as usize) != 0 {
                                    let mut drop_arg = InterpValue { vals: [0u64; 32] };
                                    drop_arg.vals[0] = (host_ptr as usize) as u64;
                                    let d_arg_ptr = unsafe { address_of(drop_arg) };
                                    let _ = sched_push_frame(mut_view(*ctx), sched, t_idx, drop_body, d_arg_ptr, 1, 0 as *mut u8, 0, MirBbId { v: next_drop_bb_v });
                                    pushed_drop = true;
                                }
                            }
                        }
                        if !pushed_drop && !ctx.failed {
                            unsafe {
                                (*sf).current_bb = MirBbId { v: next_drop_bb_v };
                                (*sf).stmt_idx = 0;
                            }
                        }
                        sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
                        return;
                    }
                    let mut builtin_next = MirBbId { v: 0u32 };
                    if exec_builtin_call(mut_view(*ctx), unsafe { view((*sf).frame) }, term, ftk, mut_view(builtin_next)) {
                        if !ctx.failed {
                            unsafe {
                                (*sf).current_bb = builtin_next;
                                (*sf).stmt_idx = 0;
                            }
                        } else {
                            sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
                        }
                        return;
                    }
                }
            }
        }

        let func_val = eval_operand_u64(mut_view(*ctx), unsafe { view((*sf).frame) }, unsafe { view((*term).func) });
        if ctx.failed {
            sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
            return;
        }
        let callee_raw = find_func_by_symbol(view(*ctx), func_val);
        let callee = resolve_callee_impl_fn(view(*ctx), callee_raw);
        if (callee as usize) == 0 {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
            sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
            return;
        }

        if interp_classify_thread_fn(view(*ctx), callee) == 0xFFFFFFFEu32 {
            if (unsafe { (*term).arg_count }) > 0 {
                let arg0 = unsafe { mir_op_at((*term).args, 0) };
                let seed_val = eval_operand_u64(mut_view(*ctx), unsafe { view((*sf).frame) }, unsafe { view(*arg0) });
                oracle_seed_prng(mut_view(*ctx), seed_val);
            }
            unsafe {
                (*sf).current_bb = MirBbId { v: (*term).call_target.v };
                (*sf).stmt_idx = 0;
            }
            return;
        }

        if (unsafe { (*callee).abi.v }) != 0u32 {
            let fspan = Span {
                file: FileId { v: unsafe { (*callee).span.file.v } },
                start: unsafe { (*callee).span.start },
                end: unsafe { (*callee).span.end },
            };
            interp_report_ffi_not_in_oracle(mut_view(*ctx), fspan);
            return;
        }

        let mut total_args: usize = 0;
        let mut args_bytes: usize = 0;
        let call_args = prepare_call_args_from_term(mut_view(*ctx), unsafe { view((*sf).frame) }, term, callee, mut_view(total_args), mut_view(args_bytes));
        let mut dest_ty = TypeId { v: 0u32 };
        let mut dest_len: u64 = 0u64;
        let dest_ptr = get_place_ptr(mut_view(*ctx), unsafe { view((*sf).frame) }, unsafe { view((*term).destination) }, mut_view(dest_ty), mut_view(dest_len));
        let dest_sz = unsafe { type_size(dest_ty, view((*ctx.thir).interner)) as usize };
        let next_call_bb = MirBbId { v: unsafe { (*term).call_target.v } };

        if ctx.failed {
            unsafe {
                heap_free(call_args as *mut u8, args_bytes, align_of<InterpValue>());
            }
            sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
            return;
        }

        if func_has_intrinsic_attr(view(*ctx), callee as *const HirItem) {
            let fname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*callee).name.v }) };
            let tkind = interp_host_thread_intrinsic_kind(view(fname));
            if tkind != HOST_INTR_NONE {
                let mut intr_yielded = false;
                sched_exec_thread_intrinsic(mut_view(*ctx), sched, t_idx, tkind, call_args, total_args, dest_ptr, dest_sz, next_call_bb, mut_view(intr_yielded));
                unsafe {
                    heap_free(call_args as *mut u8, args_bytes, align_of<InterpValue>());
                }
                sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
                return;
            }

            let mut scalar_args: [16]u64 = [0u64; 16];
            let mut ai: usize = 0;
            while ai < total_args && ai < 16 {
                let av = unsafe { interp_val_at(call_args, ai) };
                scalar_args[ai] = unsafe { (*av).vals[0] };
                ai = ai + 1;
            }
            let sargs_ptr = unsafe { address_of(scalar_args[0]) };
            let mut ret_val = InterpValue { vals: [0u64; 32] };
            let mut handled_intr = interp_eval_host_intrinsic(mut_view(*ctx), StrView { ptr: fname.ptr, len: fname.len }, sargs_ptr, total_args, mut_view(ret_val));
            if !handled_intr {
                handled_intr = eval_core_intrinsic(mut_view(*ctx), callee, StrView { ptr: fname.ptr, len: fname.len }, sargs_ptr, total_args, mut_view(ret_val));
            }
            unsafe {
                heap_free(call_args as *mut u8, args_bytes, align_of<InterpValue>());
            }
            if handled_intr {
                if !ctx.failed && (dest_ptr as usize) != 0 && dest_sz > 0 {
                    let copy_sz = if dest_sz > size_of<InterpValue>() { size_of<InterpValue>() } else { dest_sz };
                    let src_bytes = unsafe { address_of(ret_val.vals[0]) as *const u8 };
                    unsafe {
                        interp_copy_bytes(dest_ptr, src_bytes, copy_sz);
                    }
                }
                if !ctx.failed {
                    unsafe {
                        (*sf).current_bb = next_call_bb;
                        (*sf).stmt_idx = 0;
                    }
                } else {
                    sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
                }
                return;
            }
            let call_args_re = prepare_call_args_from_term(mut_view(*ctx), unsafe { view((*sf).frame) }, term, callee, mut_view(total_args), mut_view(args_bytes));
            let body_intr = resolve_or_build_mir_body(mut_view(*ctx), callee);
            if (body_intr as usize) != 0 {
                let _ = sched_push_frame(mut_view(*ctx), sched, t_idx, body_intr, call_args_re, total_args, dest_ptr, dest_sz, next_call_bb);
            } else {
                interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
            }
            unsafe {
                heap_free(call_args_re as *mut u8, args_bytes, align_of<InterpValue>());
            }
            sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
            return;
        }

        let body_callee = resolve_or_build_mir_body(mut_view(*ctx), callee);
        if (body_callee as usize) == 0 {
            interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
        } else {
            let _ = sched_push_frame(mut_view(*ctx), sched, t_idx, body_callee, call_args, total_args, dest_ptr, dest_sz, next_call_bb);
        }
        unsafe {
            heap_free(call_args as *mut u8, args_bytes, align_of<InterpValue>());
        }
        sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
        return;
    }

    if tk == MIR_TERM_UNREACHABLE {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNREACHABLE);
    } else {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNSUPPORTED_TERM);
    }
    sched_handle_child_panic_if_any(mut_view(*ctx), sched, t_idx, saved_panicked, saved_panic_ptr, saved_panic_len, saved_exit_code);
}

fn sched_cleanup(ctx: mut_view<InterpCtx>, sched: *mut InterpThreadSched) {
    let tlen = unsafe { (*sched).thread_len };
    let mut i: usize = 0;
    while i < tlen {
        sched_unwind_thread_frames(mut_view(*ctx), sched, i);
        let thr = unsafe { sched_thread_at((*sched).threads, i) };
        let fcap = unsafe { (*thr).frame_cap };
        let farr = unsafe { (*thr).frames };
        if fcap > 0 && (farr as usize) != 0 {
            let fbytes = interp_mul_usize(fcap, size_of<SchedFrame>());
            unsafe {
                heap_free(farr as *mut u8, fbytes, align_of<SchedFrame>());
                (*thr).frames = 0 as *mut SchedFrame;
                (*thr).frame_cap = 0;
            }
        }
        i = i + 1;
    }
    let tcap = unsafe { (*sched).thread_cap };
    let tarr = unsafe { (*sched).threads };
    if tcap > 0 && (tarr as usize) != 0 {
        let tbytes = interp_mul_usize(tcap, size_of<SchedThread>());
        unsafe {
            heap_free(tarr as *mut u8, tbytes, align_of<SchedThread>());
            (*sched).threads = 0 as *mut SchedThread;
            (*sched).thread_cap = 0;
            (*sched).thread_len = 0;
        }
    }
}

fn sched_run_main(
    ctx: mut_view<InterpCtx>,
    func_in: *mut HirItem,
    args_raw: *mut InterpValue,
    arg_count: usize,
    out_ret_ptr: *mut u8,
    out_ret_size: usize
) {
    let func = resolve_callee_impl_fn(view(*ctx), func_in);
    if (unsafe { (*func).abi.v }) != 0u32 {
        let fspan = Span {
            file: FileId { v: unsafe { (*func).span.file.v } },
            start: unsafe { (*func).span.start },
            end: unsafe { (*func).span.end },
        };
        interp_report_ffi_not_in_oracle(mut_view(*ctx), fspan);
        return;
    }
    let main_body = resolve_or_build_mir_body(mut_view(*ctx), func);
    if (main_body as usize) == 0 {
        interp_panic(mut_view(*ctx), INTERP_MSG_PANIC_UNRESOLVED_CALL);
        return;
    }

    let mut sched = InterpThreadSched {
        live_spawned_count: 0,
        vc_in_use_mask: 1u32,
        next_wait_seq: 1u64,
        virtual_ns: 0u64,
        rr_cursor: 0,
        base_call_depth_limit: ctx.call_depth_limit,
        threads: 0 as *mut SchedThread,
        thread_len: 0,
        thread_cap: 0,
    };
    let sched_ptr = unsafe { address_of_mut(sched) };
    oracle_set_sched_ptr(mut_view(*ctx), sched_ptr as usize);

    let prev_tid = ctx.oracle.current_tid;
    let prev_storage = ctx.oracle.current_frame_storage;
    let prev_storage_sz = ctx.oracle.current_frame_storage_size;

    let main_idx = sched_alloc_thread(sched_ptr, 0u32, 0u64);
    let main_thr = unsafe { sched_thread_at(sched.threads, main_idx) };
    unsafe {
        (*main_thr).handle = 0i64;
        (*main_thr).thread_id = 1u64;
    }
    let pushed = sched_push_frame(mut_view(*ctx), sched_ptr, main_idx, main_body, args_raw, arg_count, out_ret_ptr, out_ret_size, MirBbId { v: 0u32 });
    if !pushed {
        sched_cleanup(mut_view(*ctx), sched_ptr);
        oracle_set_sched_ptr(mut_view(*ctx), 0);
        ctx.call_depth = 0;
        ctx.oracle.current_tid = prev_tid;
        ctx.oracle.current_frame_storage = prev_storage;
        ctx.oracle.current_frame_storage_size = prev_storage_sz;
        return;
    }

    while !ctx.failed {
        let m_thr = unsafe { sched_thread_at(sched.threads, 0) };
        if (unsafe { (*m_thr).state }) == SCHED_STATE_FINISHED {
            break;
        }

        sched_wake_expired_futexes(sched_ptr);

        let tlen = sched.thread_len;
        let mut runnable_count: usize = 0;
        let mut ti: usize = 0;
        while ti < tlen {
            let t_ptr = unsafe { sched_thread_at(sched.threads, ti) };
            if (unsafe { (*t_ptr).state }) == SCHED_STATE_RUNNABLE {
                runnable_count = runnable_count + 1;
            }
            ti = ti + 1;
        }

        if runnable_count == 0 {
            let mut has_deadline = false;
            let mut min_deadline: u64 = 0xFFFFFFFFFFFFFFFFu64;
            let mut si: usize = 0;
            while si < tlen {
                let s_ptr = unsafe { sched_thread_at(sched.threads, si) };
                if (unsafe { (*s_ptr).state }) == SCHED_STATE_BLOCKED_FUTEX &&
                   (unsafe { (*s_ptr).futex_has_deadline }) {
                    let dl = unsafe { (*s_ptr).futex_deadline_ns };
                    if !has_deadline || dl < min_deadline {
                        has_deadline = true;
                        min_deadline = dl;
                    }
                }
                si = si + 1;
            }
            if has_deadline {
                let delta = if min_deadline > sched.virtual_ns { w_sub_u64(min_deadline, sched.virtual_ns) } else { 0u64 };
                sched.virtual_ns = min_deadline;
                oracle_advance_sleep_ns(mut_view(*ctx), delta);
                sched_wake_expired_futexes(sched_ptr);
                continue;
            }
            sched_report_deadlock(mut_view(*ctx));
            break;
        }

        let mut chosen_idx: usize = 0;
        if ctx.oracle.schedule_seed != 0u64 && runnable_count > 1 {
            let pick = (oracle_next_prng(mut_view(*ctx)) as usize) % runnable_count;
            let mut seen: usize = 0;
            let mut pi: usize = 0;
            while pi < tlen {
                let p_ptr = unsafe { sched_thread_at(sched.threads, pi) };
                if (unsafe { (*p_ptr).state }) == SCHED_STATE_RUNNABLE {
                    if seen == pick {
                        chosen_idx = pi;
                        break;
                    }
                    seen = seen + 1;
                }
                pi = pi + 1;
            }
        } else {
            let start_c = if (sched.rr_cursor) < tlen { sched.rr_cursor } else { 0 };
            let mut off: usize = 0;
            while off < tlen {
                let cand = (start_c + off) % tlen;
                let c_ptr = unsafe { sched_thread_at(sched.threads, cand) };
                if (unsafe { (*c_ptr).state }) == SCHED_STATE_RUNNABLE {
                    chosen_idx = cand;
                    break;
                }
                off = off + 1;
            }
        }
        sched.rr_cursor = if tlen > 0 { (chosen_idx + 1) % tlen } else { 0 };
        sched_step_thread(mut_view(*ctx), sched_ptr, chosen_idx);
    }

    sched_cleanup(mut_view(*ctx), sched_ptr);
    oracle_set_sched_ptr(mut_view(*ctx), 0);
    ctx.call_depth = 0;
    ctx.oracle.current_tid = prev_tid;
    ctx.oracle.current_frame_storage = prev_storage;
    ctx.oracle.current_frame_storage_size = prev_storage_sz;
}

// =================================================================================================
// Public Entry Points: interp_run & interp_eval_const_expr
// =================================================================================================

pub fn interp_run_with_ctx(ctx: mut_view<InterpCtx>) -> i32 {
    let mut local_map = MirBodyMap {
        entries: 0 as *mut compiler.interp.value.MirBodyEntry,
        len: 0,
        cap: 0,
    };
    let mut used_local_map = false;
    if (ctx.mir_map as usize) == 0 {
        mir_body_map_init(mut_view(local_map));
        let mp = mir_body_map_mut_ptr(mut_view(local_map));
        ctx.mir_map = mp;
        used_local_map = true;
    }

    interp_register_const_allocs(mut_view(*ctx));

    if (ctx.main_fn as usize) == 0 && (ctx.hir as usize) != 0 && (ctx.interner as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*ctx.hir).items };
        while (it as usize) != 0 {
            if (unsafe { (*it).kind }) == HIR_ITEM_FN {
                let fname = unsafe { interner_get(view(*ctx.interner), StrId { v: (*it).name.v }) };
                if fname.len == 4 {
                    let b0 = unsafe { *fname.ptr };
                    let b1 = unsafe { *(fname.ptr + 1) };
                    let b2 = unsafe { *(fname.ptr + 2) };
                    let b3 = unsafe { *(fname.ptr + 3) };
                    if b0 == 109u8 && b1 == 97u8 && b2 == 105u8 && b3 == 110u8 {
                        ctx.main_fn = it;
                        break;
                    }
                }
            }
            it = unsafe { (*it).next };
        }
    }

    let mut ret = InterpValue { vals: [0u64; 32] };
    eval_call(mut_view(*ctx), ctx.main_fn, 0 as *mut InterpValue, 0, mut_view(ret));

    if used_local_map {
        mir_body_map_free(mut_view(local_map));
        ctx.mir_map = 0 as *mut MirBodyMap;
    }

    if ctx.failed {
        return ctx.exit_code;
    }
    ret.vals[0] as i32
}

pub fn interp_run(
    main_fn: *mut HirItem,
    thir: *mut Thir,
    hir: *const HirFile,
    interner: *mut StrInterner,
    rmap: *const ResolveMap,
    ast: *const Ast,
    db: *const SourceDatabase,
    sink: *mut DiagSink,
    mono_engine: *mut MonoEngine,
    step_limit: i32,
    call_depth_limit: i32,
    mir_map: *mut MirBodyMap,
    out_buf: *mut DiagBuffer,
    capture_stdout: bool,
    out_panic_sv: *mut StrView
) -> i32 {
    let ctx_ptr = interp_ctx_alloc_zeroed();
    interp_ctx_init(
        unsafe { mut_view(*ctx_ptr) },
        main_fn,
        thir,
        hir,
        interner,
        rmap,
        ast,
        db,
        sink,
        mono_engine,
        step_limit,
        call_depth_limit,
        mir_map,
        out_buf,
        capture_stdout
    );
    interp_host_init(unsafe { mut_view(*ctx_ptr) });

    let code = interp_run_with_ctx(unsafe { mut_view(*ctx_ptr) });

    if (out_panic_sv as usize) != 0 {
        let has_panicked = unsafe { (*ctx_ptr).has_panicked };
        let panic_msg_ptr = unsafe { (*ctx_ptr).panic_msg_ptr };
        if has_panicked && (panic_msg_ptr as usize) != 0 {
            let plen = unsafe { (*ctx_ptr).panic_msg_len };
            let msg_copy = unsafe { heap_alloc(plen + 1, 1) };
            unsafe {
                interp_copy_bytes(msg_copy, panic_msg_ptr, plen);
                let term_p: *mut u8 = msg_copy + plen;
                *term_p = 0u8;
                (*out_panic_sv).ptr = msg_copy as *const u8;
                (*out_panic_sv).len = plen;
            }
        } else {
            unsafe {
                (*out_panic_sv).ptr = 0 as *const u8;
                (*out_panic_sv).len = 0;
            }
        }
    }

    interp_ctx_free_allocs(unsafe { mut_view(*ctx_ptr) });
    unsafe {
        arena_destroy(mut_view((*ctx_ptr).arena));
    }
    interp_host_cleanup(unsafe { mut_view(*ctx_ptr) });
    interp_ctx_dealloc(ctx_ptr);
    code
}

// =================================================================================================
// Constant Expression Evaluation (Port of ax_interp_eval_const_expr)
// =================================================================================================

pub struct InterpConstEvalCtx {
    pub hir: *const HirFile,
    pub interner: *mut StrInterner,
    pub rmap: *const ResolveMap,
    pub ast: *const Ast,
    pub db: *const SourceDatabase,
    pub sink: *mut DiagSink,
}

pub fn interp_eval_const_expr_into(
    cctx: view<InterpConstEvalCtx>,
    thir: *mut Thir,
    expr: *mut HirExpr,
    expected_ty: TypeId,
    limits: ConstLimits,
    out_res: mut_view<ConstEvalResult>
) {
    out_res.ok = false;
    out_res.val.kind = CONST_INT;
    out_res.val.ty = TypeId { v: expected_ty.v };
    out_res.val.int_val = 0u64;
    out_res.val.str_bytes = 0 as *const u8;
    out_res.val.str_len = 0;
    out_res.val.agg_data = 0 as *mut u8;
    out_res.val.agg_size = 0;
    out_res.val.agg_align = 0;
    out_res.val.alloc_id = 0u32;
    out_res.err_code = 0u16;
    out_res.err_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };

    if (expr as usize) == 0 || (thir as usize) == 0 {
        out_res.err_code = AX_CONST_OVERFLOW as u16;
        return;
    }

    let step_limit: i32 = if limits.max_steps > 0 { limits.max_steps } else { 100000 };
    let depth_limit: i32 = if limits.max_call_depth > 0 { limits.max_call_depth } else { 100 };

    let ictx_ptr = interp_ctx_alloc_zeroed();
    interp_ctx_init(
        unsafe { mut_view(*ictx_ptr) },
        0 as *mut HirItem,
        thir,
        cctx.hir,
        cctx.interner,
        cctx.rmap,
        cctx.ast,
        cctx.db,
        cctx.sink,
        0 as *mut MonoEngine,
        step_limit,
        depth_limit,
        0 as *mut MirBodyMap,
        0 as *mut DiagBuffer,
        true
    );
    let body = unsafe {
        mir_build_expr_body(
            mut_view((*ictx_ptr).arena),
            expr,
            TypeId { v: expected_ty.v },
            thir,
            cctx.hir,
            cctx.interner,
            cctx.db
        )
    };
    if (body as usize) == 0 {
        out_res.err_code = AX_CONST_OVERFLOW as u16;
        interp_ctx_free_allocs(unsafe { mut_view(*ictx_ptr) });
        unsafe {
            arena_destroy(mut_view((*ictx_ptr).arena));
        }
        interp_host_cleanup(unsafe { mut_view(*ictx_ptr) });
        interp_ctx_dealloc(ictx_ptr);
        return;
    }

    unsafe {
        (*ictx_ptr).is_comptime = true;
        (*ictx_ptr).build_on_demand = false;
        (*ictx_ptr).next_synth_addr = INTERP_SYNTH_BASE_COMPTIME;
        (*ictx_ptr).current_span = Span {
            file: FileId { v: (*expr).span.file.v },
            start: (*expr).span.start,
            end: (*expr).span.end,
        };
    }
    interp_host_init(unsafe { mut_view(*ictx_ptr) });
    interp_register_const_allocs(unsafe { mut_view(*ictx_ptr) });

    let expected_ty_v = expected_ty.v;
    let mut ret_size = unsafe { type_size(TypeId { v: expected_ty_v }, view((*thir).interner)) as usize };
    let mut ret_align = unsafe { type_align(TypeId { v: expected_ty_v }, view((*thir).interner)) as usize };
    if ret_size == 0 {
        ret_size = 8;
    }
    if ret_align == 0 {
        ret_align = 8;
    }

    let exp_t = unsafe { type_get(view((*thir).interner), TypeId { v: expected_ty_v }) };
    let mut is_aggregate = false;
    if (exp_t as usize) != 0 {
        let etk = unsafe { (*exp_t).kind };
        if etk == TY_STRUCT || etk == TY_ARRAY || etk == TY_TUPLE {
            is_aggregate = true;
        }
    }

    let mut ret_buf: *mut u8 = 0 as *mut u8;
    let alloc_buf_sz: usize = if ret_size < 16 { 16 } else { ret_size };
    if is_aggregate {
        ret_buf = unsafe { arena_alloc_raw(mut_view((*thir).interner.arena), ret_size, ret_align) };
        unsafe {
            interp_zero_bytes(ret_buf, ret_size);
        }
    } else {
        ret_buf = unsafe { heap_alloc(alloc_buf_sz, 16) };
        unsafe {
            interp_zero_bytes(ret_buf, alloc_buf_sz);
        }
    }

    exec_mir_body(unsafe { mut_view(*ictx_ptr) }, body, 0 as *mut InterpValue, 0, ret_buf, ret_size);

    let failed = unsafe { (*ictx_ptr).failed };
    if failed {
        out_res.ok = false;
        let err_c = unsafe { (*ictx_ptr).comptime_err_code };
        out_res.err_code = if err_c != 0u16 { err_c } else { AX_CONST_OVERFLOW as u16 };
        let err_sp_file = unsafe { (*ictx_ptr).comptime_err_span.file.v };
        if err_sp_file != 0u32 {
            out_res.err_span = Span {
                file: FileId { v: err_sp_file },
                start: unsafe { (*ictx_ptr).comptime_err_span.start },
                end: unsafe { (*ictx_ptr).comptime_err_span.end },
            };
        } else {
            out_res.err_span = Span {
                file: FileId { v: unsafe { (*expr).span.file.v } },
                start: unsafe { (*expr).span.start },
                end: unsafe { (*expr).span.end },
            };
        }
        if !is_aggregate {
            unsafe {
                heap_free(ret_buf, alloc_buf_sz, 16);
            }
        }
    } else {
        out_res.ok = true;
        if is_aggregate {
            out_res.val.kind = CONST_AGGREGATE;
            out_res.val.agg_data = ret_buf;
            out_res.val.agg_size = ret_size;
            out_res.val.agg_align = ret_align;
        } else if (exp_t as usize) != 0 && (unsafe { (*exp_t).kind }) == TY_STR {
            out_res.val.kind = CONST_STR;
            let addr = unsafe { *(ret_buf as *const u64) };
            let s_ptr = interp_resolve_synth_ptr(unsafe { mut_view(*ictx_ptr) }, addr);
            out_res.val.str_bytes = s_ptr as *const u8;
            out_res.val.str_len = unsafe { *((ret_buf as *const u64) + 1) as usize };
            unsafe {
                heap_free(ret_buf, alloc_buf_sz, 16);
            }
        } else if (exp_t as usize) != 0 && (unsafe { (*exp_t).kind }) == TY_UNIT {
            out_res.val.kind = CONST_UNIT;
            unsafe {
                heap_free(ret_buf, alloc_buf_sz, 16);
            }
        } else {
            out_res.val.kind = CONST_INT;
            if ret_size == 1 {
                out_res.val.int_val = unsafe { *ret_buf as u64 };
            } else if ret_size == 2 {
                out_res.val.int_val = unsafe { *(ret_buf as *const u16) as u64 };
            } else if ret_size == 4 {
                out_res.val.int_val = unsafe { *(ret_buf as *const u32) as u64 };
            } else {
                out_res.val.int_val = unsafe { *(ret_buf as *const u64) };
            }
            unsafe {
                heap_free(ret_buf, alloc_buf_sz, 16);
            }
        }
    }

    interp_ctx_free_allocs(unsafe { mut_view(*ictx_ptr) });
    unsafe {
        arena_destroy(mut_view((*ictx_ptr).arena));
    }
    interp_host_cleanup(unsafe { mut_view(*ictx_ptr) });
    interp_ctx_dealloc(ictx_ptr);
}
