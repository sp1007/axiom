// ItemNamespace tags for SemanticKey (AXS-QRY-003)
pub const ITEM_NS_MODULE: u8 = 1u8;
pub const ITEM_NS_TYPE: u8 = 2u8;
pub const ITEM_NS_VALUE: u8 = 3u8;
pub const ITEM_NS_TRAIT: u8 = 4u8;
pub const ITEM_NS_CONST: u8 = 5u8;
pub const ITEM_NS_UNIT: u8 = 6u8;
pub const ITEM_NS_PACKAGE: u8 = 7u8;
pub const ITEM_NS_SOURCE: u8 = 8u8;

@derive(Copy)
pub struct SemanticKey {
    pub package_name: StrView,
    pub module_path: StrView,
    pub item_namespace: u8,
    pub disambiguator_index: u32,
    pub canonical_name: StrView,
    pub canonical_type_args: StrView,
}

pub fn qry_sv_empty() -> StrView {
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn qry_sv_cmp(a: StrView, b: StrView) -> i32 {
    let min_len = if (a.len) < (b.len) { a.len } else { b.len };
    let mut i: usize = 0;
    while i < min_len {
        let ba = if a.ptr as usize != 0 { unsafe { *(a.ptr + i) } } else { 0u8 };
        let bb = if b.ptr as usize != 0 { unsafe { *(b.ptr + i) } } else { 0u8 };
        if ba < bb {
            return -1i32;
        }
        if ba > bb {
            return 1i32;
        }
        i = i + 1;
    }
    if (a.len) < (b.len) {
        return -1i32;
    }
    if (a.len) > (b.len) {
        return 1i32;
    }
    0i32
}

pub fn qry_sv_eq(a: StrView, b: StrView) -> bool {
    qry_sv_cmp(a, b) == 0i32
}

pub fn semantic_key_new(
    package_name: StrView,
    module_path: StrView,
    item_namespace: u8,
    disambiguator_index: u32,
    canonical_name: StrView,
    canonical_type_args: StrView
) -> SemanticKey {
    SemanticKey {
        package_name: package_name,
        module_path: module_path,
        item_namespace: item_namespace,
        disambiguator_index: disambiguator_index,
        canonical_name: canonical_name,
        canonical_type_args: canonical_type_args,
    }
}

// Allocation-order-independent lexicographical comparison by
// (PackageName, ModulePath, ItemNamespace, DisambiguatorIndex, CanonicalName, CanonicalTypeArgs)
// per AXS-QRY-003.
pub fn semantic_key_cmp(a: view<SemanticKey>, b: view<SemanticKey>) -> i32 {
    let c_pkg = qry_sv_cmp(a.package_name, b.package_name);
    if c_pkg != 0i32 {
        return c_pkg;
    }
    let c_mod = qry_sv_cmp(a.module_path, b.module_path);
    if c_mod != 0i32 {
        return c_mod;
    }
    if (a.item_namespace) < (b.item_namespace) {
        return -1i32;
    }
    if (a.item_namespace) > (b.item_namespace) {
        return 1i32;
    }
    if (a.disambiguator_index) < (b.disambiguator_index) {
        return -1i32;
    }
    if (a.disambiguator_index) > (b.disambiguator_index) {
        return 1i32;
    }
    let c_name = qry_sv_cmp(a.canonical_name, b.canonical_name);
    if c_name != 0i32 {
        return c_name;
    }
    qry_sv_cmp(a.canonical_type_args, b.canonical_type_args)
}

pub fn semantic_key_eq(a: view<SemanticKey>, b: view<SemanticKey>) -> bool {
    semantic_key_cmp(a, b) == 0i32
}

pub fn semantic_key_fingerprint(k: view<SemanticKey>) -> Fingerprint128 {
    let f_pkg = fingerprint128_bytes(0x534B45595F504B47u64, k.package_name.ptr, k.package_name.len);
    let f_mod = fingerprint128_bytes(0x534B45595F4D4F44u64, k.module_path.ptr, k.module_path.len);
    let f_meta = fingerprint128_u64(0x534B45595F4E5344u64, k.item_namespace as u64, k.disambiguator_index as u64);
    let f_name = fingerprint128_bytes(0x534B45595F4E414Du64, k.canonical_name.ptr, k.canonical_name.len);
    let f_targs = fingerprint128_bytes(0x534B45595F415247u64, k.canonical_type_args.ptr, k.canonical_type_args.len);
    fingerprint128_combine(
        fingerprint128_combine(fingerprint128_combine(f_pkg, f_mod), f_meta),
        fingerprint128_combine(f_name, f_targs)
    )
}

