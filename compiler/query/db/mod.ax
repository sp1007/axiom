// QueryKind constants (AXS-QRY-002, AXS-QRY-010, AXS-QRY-021)
pub const QUERY_INPUT_SOURCE_FILE: u8 = 1u8;
pub const QUERY_INPUT_MODULE_TREE: u8 = 2u8;
pub const QUERY_INPUT_TARGET_CONFIG: u8 = 3u8;
pub const QUERY_INPUT_PACKAGE_GRAPH: u8 = 4u8;

pub const QUERY_PARSE_MODULE: u8 = 10u8;
pub const QUERY_MODULE_DEF_MAP: u8 = 11u8;
pub const QUERY_RESOLVE_MODULE: u8 = 12u8;
pub const QUERY_ITEM_SIGNATURE: u8 = 13u8;
pub const QUERY_TYPECK_BODY: u8 = 14u8;
pub const QUERY_TRAIT_SOLVE: u8 = 15u8;
pub const QUERY_CONST_EVAL: u8 = 16u8;
pub const QUERY_MIR_BODY: u8 = 17u8;
pub const QUERY_LAYOUT_OF: u8 = 18u8;
pub const QUERY_EFFECT_SUMMARY: u8 = 19u8;

pub fn query_kind_is_input(kind: u8) -> bool {
    kind >= QUERY_INPUT_SOURCE_FILE && kind <= QUERY_INPUT_PACKAGE_GRAPH
}

pub fn query_kind_is_derived(kind: u8) -> bool {
    kind >= QUERY_PARSE_MODULE && kind <= QUERY_EFFECT_SUMMARY
}

pub fn query_kind_order_rank(kind: u8) -> u32 {
    kind as u32
}

// QuerySlotState constants (AXS-QRY-010, AXS-QRY-032)
pub const QUERY_STATE_VACANT: u8 = 0u8;
pub const QUERY_STATE_COMPUTING: u8 = 1u8;
pub const QUERY_STATE_READY: u8 = 2u8;
pub const QUERY_STATE_POISONED: u8 = 3u8;
pub const QUERY_STATE_MAYBE_DIRTY: u8 = 4u8;

// CyclePolicy constants (AXS-QRY-021)
pub const CYCLE_POLICY_REJECT: u8 = 0u8;
pub const CYCLE_POLICY_DEPTH_LIMITED: u8 = 1u8;

pub fn query_kind_cycle_policy(kind: u8) -> u8 {
    if kind == QUERY_TRAIT_SOLVE {
        return CYCLE_POLICY_DEPTH_LIMITED;
    }
    CYCLE_POLICY_REJECT
}

// Diagnostic codes (AXS-QRY-050)
pub const DIAG_AX_QUERY_CYCLE: u32 = 9201u32;
pub const DIAG_AX_TYPE_CYCLE: u32 = 9202u32;
pub const DIAG_AX_CTM_CYCLE: u32 = 9203u32;
pub const DIAG_AX_TRAIT_CYCLE: u32 = 9204u32;
pub const DIAG_AX_QUERY_DEPTH_LIMIT: u32 = 9205u32;
pub const DIAG_AX_TYP_MISMATCH: u32 = 4001u32;

// Item kinds for DefEntry
pub const ITEM_KIND_FN: u8 = 1u8;
pub const ITEM_KIND_STRUCT: u8 = 2u8;
pub const ITEM_KIND_TYPE_ALIAS: u8 = 3u8;
pub const ITEM_KIND_CONST: u8 = 4u8;
pub const ITEM_KIND_TRAIT: u8 = 5u8;
pub const ITEM_KIND_IMPL: u8 = 6u8;

// Trait solve status codes
pub const TRAIT_RESULT_IMPLEMENTED: u8 = 1u8;
pub const TRAIT_RESULT_AMBIGUOUS: u8 = 2u8;
pub const TRAIT_RESULT_NO_SOLUTION: u8 = 3u8;
pub const TRAIT_RESULT_ERROR: u8 = 4u8;

@derive(Copy)
pub struct QueryKey {
    pub kind: u8,
    pub key_raw: u32,
    pub semantic_key: SemanticKey,
}

pub fn query_key_new(kind: u8, key_raw: u32, semantic_key: SemanticKey) -> QueryKey {
    QueryKey {
        kind: kind,
        key_raw: key_raw,
        semantic_key: semantic_key,
    }
}

pub fn query_key_cmp(a: view<QueryKey>, b: view<QueryKey>) -> i32 {
    let ra = query_kind_order_rank(a.kind);
    let rb = query_kind_order_rank(b.kind);
    if ra < rb {
        return -1i32;
    }
    if ra > rb {
        return 1i32;
    }
    semantic_key_cmp(view(a.semantic_key), view(b.semantic_key))
}

pub fn query_key_eq(a: view<QueryKey>, b: view<QueryKey>) -> bool {
    a.kind == b.kind && semantic_key_eq(view(a.semantic_key), view(b.semantic_key))
}

pub fn query_key_fingerprint(k: view<QueryKey>) -> Fingerprint128 {
    let f_sk = semantic_key_fingerprint(view(k.semantic_key));
    let f_kd = fingerprint128_u64(0x514B45595F4B4E44u64, k.kind as u64, 0u64);
    fingerprint128_combine(f_kd, f_sk)
}

