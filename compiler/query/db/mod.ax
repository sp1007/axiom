// Demand-Driven Semantic Database (`CompilerDB`), Input vs Derived Query Tables,
// Session-Scoped Typed IDs & Canonical `SemanticKey`, Active `QueryStack` Dependency
// DAG Recording, Revision-Stamped Memoization, and `inspect --emit=query-graph` (T753 / E18.1).
// Implements SPEC-21 §1-§4 (AXS-QRY-001..033, AXS-QRY-050, INV-QRY-001).
module compiler.query.db

use std.core.host.heap_alloc
use std.core.host.heap_free

