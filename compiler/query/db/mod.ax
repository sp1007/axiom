use compiler.kernel.hash.ax_hash_u64
use compiler.kernel.hash.ax_hash_combine
use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_bytes
use compiler.diag.format.diag_buf_push_sv
use compiler.diag.format.diag_buf_push_u32

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// ============================================================================
// 1. Snapshot, RevisionId & Fingerprint128 (AXS-QRY-001)
// ============================================================================

@derive(Copy)
pub struct RevisionId {
    pub raw: u64,
}

pub fn revision_id_zero() -> RevisionId {
    RevisionId { raw: 0u64 }
}

pub fn revision_id_new(raw: u64) -> RevisionId {
    RevisionId { raw: raw }
}

pub fn revision_id_next(r: RevisionId) -> RevisionId {
    RevisionId { raw: r.raw + 1u64 }
}

pub fn revision_id_eq(a: RevisionId, b: RevisionId) -> bool {
    a.raw == b.raw
}

pub fn revision_id_lt(a: RevisionId, b: RevisionId) -> bool {
    (a.raw) < (b.raw)
}

pub fn revision_id_le(a: RevisionId, b: RevisionId) -> bool {
    (a.raw) <= (b.raw)
}

@derive(Copy)
pub struct SnapshotId {
    pub session_id: u64,
    pub revision: RevisionId,
}

pub fn snapshot_id_new(session_id: u64, revision: RevisionId) -> SnapshotId {
    SnapshotId { session_id: session_id, revision: revision }
}

pub fn snapshot_id_eq(a: SnapshotId, b: SnapshotId) -> bool {
    a.session_id == b.session_id && a.revision.raw == b.revision.raw
}

@derive(Copy)
pub struct Fingerprint128 {
    pub lo: u64,
    pub hi: u64,
}

pub fn fingerprint128_zero() -> Fingerprint128 {
    Fingerprint128 { lo: 0u64, hi: 0u64 }
}

pub fn fingerprint128_new(lo: u64, hi: u64) -> Fingerprint128 {
    Fingerprint128 { lo: lo, hi: hi }
}

pub fn fingerprint128_eq(a: Fingerprint128, b: Fingerprint128) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

pub fn fingerprint128_bytes(domain_tag: u64, ptr: *const u8, byte_len: usize) -> Fingerprint128 {
    let raw_h = ax_hash_bytes(ptr, byte_len);
    let lo = ax_hash_combine(domain_tag, raw_h);
    let hi = ax_hash_combine(raw_h ^ (byte_len as u64), ax_hash_u64(domain_tag ^ 0x9E3779B97F4A7C15u64));
    Fingerprint128 { lo: lo, hi: hi }
}

pub fn fingerprint128_u64(domain_tag: u64, v0: u64, v1: u64) -> Fingerprint128 {
    let lo = ax_hash_combine(ax_hash_combine(domain_tag, v0), v1);
    let hi = ax_hash_combine(ax_hash_combine(domain_tag ^ 0x5555555555555555u64, v1), v0);
    Fingerprint128 { lo: lo, hi: hi }
}

pub fn fingerprint128_combine(a: Fingerprint128, b: Fingerprint128) -> Fingerprint128 {
    let lo = ax_hash_combine(ax_hash_combine(a.lo, b.lo), a.hi);
    let hi = ax_hash_combine(ax_hash_combine(a.hi, b.hi), b.lo);
    Fingerprint128 { lo: lo, hi: hi }
}

@derive(Copy)
pub struct DatabaseSnapshot {
    pub id: SnapshotId,
    pub source_file_count: u32,
    pub module_count: u32,
    pub target_config_count: u32,
    pub package_count: u32,
    pub executed_query_count: u32,
    pub is_immutable: bool,
}

