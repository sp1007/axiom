}

// ============================================================================
// 9. Snapshot-Bound Diagnostic Capture & Equivalence Comparison (AXS-QRY-030)
// ============================================================================

pub fn engine_capture_snapshot_diags(eng: mut_view<QueryEngine>) -> SnapshotDiagSummary {
    let snap_id = snapshot_id_new(eng.db.session_id, eng.db.current_revision);
    let mut fp = fingerprint128_u64(
        0x534E41505F444947u64,
        eng.db.emitted_diag_count as u64,
        eng.emitted_cycle_count as u64
    );

    // Sort emitted diagnostic fingerprints in canonical order by `(code, primary_key)`
    // so cold and warm diagnostic sets are compared deterministically.
    let d_count = eng.db.emitted_diag_count as usize;
    let mut sorted_diags: [128]u32 = [0u32; 128];
    let mut i: usize = 0;
    while i < d_count {
        sorted_diags[i] = unsafe { *(eng.db.emitted_diag_indices + i) };
        i = i + 1;
    }
    let mut a: usize = 1;
    while a < d_count {
        let cur_idx = sorted_diags[a];
        let cur_dg = unsafe { *(eng.db.all_diags + (cur_idx as usize)) };
        let mut b: usize = a;
        while b > 0 {
            let prev_idx = sorted_diags[b - 1];
            let prev_dg = unsafe { *(eng.db.all_diags + (prev_idx as usize)) };
            let cmp_k = semantic_key_cmp(view(prev_dg.primary_key), view(cur_dg.primary_key));
            let le = if cmp_k < 0i32 {
                true
            } else if cmp_k > 0i32 {
                false
            } else {
                prev_dg.code <= cur_dg.code
            };
            if le {
                break;
            }
            sorted_diags[b] = prev_idx;
            b = b - 1;
        }
        sorted_diags[b] = cur_idx;
        a = a + 1;
    }

    let mut j: usize = 0;
    while j < d_count {
        let dg = unsafe { *(eng.db.all_diags + (sorted_diags[j] as usize)) };
        fp = fingerprint128_combine(fp, dg.fingerprint);
        j = j + 1;
    }

    let summary = SnapshotDiagSummary {
        snapshot_id: snap_id,
        revision: eng.db.current_revision,
        diag_count: eng.db.emitted_diag_count,
        cycle_count: eng.emitted_cycle_count,
        suppressed_cascades: eng.suppressed_cascades,
        warm_replays: eng.warm_diag_replays,
        combined_fingerprint: fp,
    };
    if (eng.snapshot_log_count as usize) < ENG_MAX_SNAPSHOT_LOGS {
        let log_idx = eng.snapshot_log_count as usize;
        eng.snapshot_log_count = eng.snapshot_log_count + 1u32;
        unsafe { *(eng.snapshot_logs + log_idx) = summary; }
    }
    summary
}

pub fn engine_snapshot_diags_equivalent(a: view<SnapshotDiagSummary>, b: view<SnapshotDiagSummary>) -> bool {
    a.diag_count == b.diag_count &&
        a.cycle_count == b.cycle_count &&
        fingerprint128_eq(a.combined_fingerprint, b.combined_fingerprint)
}

pub fn engine_get_tarjan_scc(eng: view<QueryEngine>, idx: u32) -> TarjanSccRecord {
    unsafe { *(eng.tarjan_sccs + (idx as usize)) }
}

pub fn engine_count_emitted_diag_code(eng: view<QueryEngine>, code: u32) -> u32 {
    let mut matches: u32 = 0u32;
    let mut i: usize = 0;
    while i < (eng.db.emitted_diag_count as usize) {
        let d_idx = unsafe { *(eng.db.emitted_diag_indices + i) };
        let dg = unsafe { *(eng.db.all_diags + (d_idx as usize)) };
        if dg.code == code {
            matches = matches + 1u32;
        }
        i = i + 1;
    }
    matches
}

// ============================================================================
// 10. Deterministic Cycle Trace, Diagnostic & Summary Formatters
// ============================================================================

// Byte table for deterministic ASCII labels without assembly label collisions:
//   0..6:   "cycle[" (6)
//   6..12:  "] rev=R" (7 -> indices 6..13)
//  13..20:  " steps=" (7)
//  20..22:  ": " (2)
//  22..26:  " -> " (4)
//  26..31:  "diag[" (5)
//  31..41:  "] primary=" (10)
//  41..52:  " trace_len=" (11)
//  52..56:  "scc[" (4)
//  56..66:  "] members=" (10)
//  66..72:  " head=" (6)
//  72..92:  "engine_summary rev=R" (20)
//  92..98:  " hits=" (6)
//  98..106: " misses=" (8)
// 106..113: " green=" (7)
// 113..121: " cycles=" (8)
// 121..133: " suppressed=" (12)
// 133..142: " replays=" (9)
// 142..151: " dirtied=" (9)
const ENG_FMT_BYTES: [151]u8 = [
    99u8, 121u8, 99u8, 108u8, 101u8, 91u8,
    93u8, 32u8, 114u8, 101u8, 118u8, 61u8, 82u8,
    32u8, 115u8, 116u8, 101u8, 112u8, 115u8, 61u8,
    58u8, 32u8,
    32u8, 45u8, 62u8, 32u8,
    100u8, 105u8, 97u8, 103u8, 91u8,
    93u8, 32u8, 112u8, 114u8, 105u8, 109u8, 97u8, 114u8, 121u8, 61u8,
    32u8, 116u8, 114u8, 97u8, 99u8, 101u8, 95u8, 108u8, 101u8, 110u8, 61u8,
    115u8, 99u8, 99u8, 91u8,
    93u8, 32u8, 109u8, 101u8, 109u8, 98u8, 101u8, 114u8, 115u8, 61u8,
    32u8, 104u8, 101u8, 97u8, 100u8, 61u8,
    101u8, 110u8, 103u8, 105u8, 110u8, 101u8, 95u8, 115u8, 117u8, 109u8, 109u8, 97u8, 114u8, 121u8, 32u8, 114u8, 101u8, 118u8, 61u8, 82u8,
    32u8, 104u8, 105u8, 116u8, 115u8, 61u8,
    32u8, 109u8, 105u8, 115u8, 115u8, 101u8, 115u8, 61u8,
    32u8, 103u8, 114u8, 101u8, 101u8, 110u8, 61u8,
    32u8, 99u8, 121u8, 99u8, 108u8, 101u8, 115u8, 61u8,
    32u8, 115u8, 117u8, 112u8, 112u8, 114u8, 101u8, 115u8, 115u8, 101u8, 100u8, 61u8,
    32u8, 114u8, 101u8, 112u8, 108u8, 97u8, 121u8, 115u8, 61u8,
    32u8, 100u8, 105u8, 114u8, 116u8, 105u8, 101u8, 100u8, 61u8
];

fn eng_buf_push_slice(out: mut_view<DiagBuffer>, start: usize, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), ENG_FMT_BYTES[start + i]);
        i = i + 1;
    }
}

// Emits active session cycle traces sorted lexicographically by `canonical_head`:
// `cycle[<CODE>] rev=R<rev> steps=<m>: <Q_0> -> <Q_1> -> ... -> <Q_0>\n`
pub fn engine_emit_cycle_traces(eng: view<QueryEngine>, out: mut_view<DiagBuffer>) {
    let c_count = eng.emitted_cycle_count as usize;
    let mut sorted: [64]u32 = [0u32; 64];
    let mut i: usize = 0;
    while i < c_count {
        sorted[i] = unsafe { *(eng.emitted_cycle_indices + i) };
        i = i + 1;
    }

    let mut a: usize = 1;
    while a < c_count {
        let cur_idx = sorted[a];
        let cur_rec = unsafe { *(eng.cycles + (cur_idx as usize)) };
        let mut b: usize = a;
        while b > 0 {
            let prev_idx = sorted[b - 1];
            let prev_rec = unsafe { *(eng.cycles + (prev_idx as usize)) };
            if query_key_cmp(view(prev_rec.canonical_head), view(cur_rec.canonical_head)) <= 0i32 {
                break;
            }
            sorted[b] = prev_idx;
            b = b - 1;
        }
        sorted[b] = cur_idx;
        a = a + 1;
    }

    let mut idx: usize = 0;
    while idx < c_count {
        let rec = unsafe { *(eng.cycles + (sorted[idx] as usize)) };
        eng_buf_push_slice(mut_view(*out), 0, 6); // "cycle["
        query_db_push_diag_code_name(mut_view(*out), rec.diag_code);
        eng_buf_push_slice(mut_view(*out), 6, 7); // "] rev=R"
        diag_buf_push_u32(mut_view(*out), rec.revision.raw as u32);
        eng_buf_push_slice(mut_view(*out), 13, 7); // " steps="
        diag_buf_push_u32(mut_view(*out), rec.step_count);
        eng_buf_push_slice(mut_view(*out), 20, 2); // ": "

        let mut s: u32 = 0u32;
        while s < (rec.step_count) {
            if s > 0u32 {
                eng_buf_push_slice(mut_view(*out), 22, 4); // " -> "
            }
            query_db_push_query_key(mut_view(*out), view(rec.steps[s as usize]));
            s = s + 1u32;
        }
        diag_buf_push_byte(mut_view(*out), 10u8);
        idx = idx + 1;
    }
}

// Emits active session diagnostics sorted deterministically by `(primary_key, code)`:
// `diag[<CODE>] primary=<SemanticKey> rev=R<rev> trace_len=<n>\n`
pub fn engine_emit_diagnostics(eng: view<QueryEngine>, out: mut_view<DiagBuffer>) {
    let d_count = eng.db.emitted_diag_count as usize;
    let mut sorted: [128]u32 = [0u32; 128];
    let mut i: usize = 0;
    while i < d_count {
        sorted[i] = unsafe { *(eng.db.emitted_diag_indices + i) };
        i = i + 1;
    }

    let mut a: usize = 1;
    while a < d_count {
        let cur_idx = sorted[a];
        let cur_dg = unsafe { *(eng.db.all_diags + (cur_idx as usize)) };
        let mut b: usize = a;
        while b > 0 {
            let prev_idx = sorted[b - 1];
            let prev_dg = unsafe { *(eng.db.all_diags + (prev_idx as usize)) };
            let cmp_k = semantic_key_cmp(view(prev_dg.primary_key), view(cur_dg.primary_key));
            let le = if cmp_k < 0i32 {
                true
            } else if cmp_k > 0i32 {
                false
            } else {
                prev_dg.code <= cur_dg.code
            };
            if le {
                break;
            }
            sorted[b] = prev_idx;
            b = b - 1;
        }
        sorted[b] = cur_idx;
        a = a + 1;
    }

    let mut idx: usize = 0;
    while idx < d_count {
        let dg = unsafe { *(eng.db.all_diags + (sorted[idx] as usize)) };
        eng_buf_push_slice(mut_view(*out), 26, 5); // "diag["
        query_db_push_diag_code_name(mut_view(*out), dg.code);
        eng_buf_push_slice(mut_view(*out), 31, 10); // "] primary="
        query_db_push_semantic_key(mut_view(*out), view(dg.primary_key));
        eng_buf_push_slice(mut_view(*out), 7, 6); // " rev=R"
        diag_buf_push_u32(mut_view(*out), dg.snapshot_id.revision.raw as u32);
        eng_buf_push_slice(mut_view(*out), 41, 11); // " trace_len="
        diag_buf_push_u32(mut_view(*out), dg.trace_len);
        diag_buf_push_byte(mut_view(*out), 10u8);
        idx = idx + 1;
    }
}

// Emits discovered Tarjan cyclic SCCs in canonical order:
// `scc[<CODE>] members=<m> head=<QueryKey>\n`
pub fn engine_emit_tarjan_sccs(eng: view<QueryEngine>, out: mut_view<DiagBuffer>) {
    let mut i: u32 = 0u32;
    while i < (eng.tarjan_scc_count) {
        let scc = unsafe { *(eng.tarjan_sccs + (i as usize)) };
        eng_buf_push_slice(mut_view(*out), 52, 4); // "scc["
        query_db_push_diag_code_name(mut_view(*out), scc.diag_code);
        eng_buf_push_slice(mut_view(*out), 56, 10); // "] members="
        diag_buf_push_u32(mut_view(*out), scc.member_count);
        eng_buf_push_slice(mut_view(*out), 66, 6); // " head="
        query_db_push_query_key(mut_view(*out), view(scc.canonical_head));
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1u32;
    }
}

// Emits deterministic single-line engine telemetry summary:
// `engine_summary rev=R<rev> hits=<h> misses=<m> green=<g> cycles=<c> suppressed=<s> replays=<r> dirtied=<d>\n`
pub fn engine_emit_summary(eng: view<QueryEngine>, out: mut_view<DiagBuffer>) {
    eng_buf_push_slice(mut_view(*out), 72, 20); // "engine_summary rev=R"
    diag_buf_push_u32(mut_view(*out), eng.db.current_revision.raw as u32);
    eng_buf_push_slice(mut_view(*out), 92, 6); // " hits="
    diag_buf_push_u32(mut_view(*out), eng.db.total_memo_hits);
    eng_buf_push_slice(mut_view(*out), 98, 8); // " misses="
    diag_buf_push_u32(mut_view(*out), eng.db.total_memo_misses);
    eng_buf_push_slice(mut_view(*out), 106, 7); // " green="
    diag_buf_push_u32(mut_view(*out), eng.db.total_green_reuses);
    eng_buf_push_slice(mut_view(*out), 113, 8); // " cycles="
    diag_buf_push_u32(mut_view(*out), eng.db.total_cycles_detected);
    eng_buf_push_slice(mut_view(*out), 121, 12); // " suppressed="
    diag_buf_push_u32(mut_view(*out), eng.suppressed_cascades);
    eng_buf_push_slice(mut_view(*out), 133, 9); // " replays="
    diag_buf_push_u32(mut_view(*out), eng.warm_diag_replays);
    eng_buf_push_slice(mut_view(*out), 142, 9); // " dirtied="
    diag_buf_push_u32(mut_view(*out), eng.total_slots_dirtied);
    diag_buf_push_byte(mut_view(*out), 10u8);
}
