pub fn engine_query_parse_module(eng: mut_view<QueryEngine>, module_id: ModuleId) -> ParseModuleResult {
    let qk = query_key_for_module(view(eng.db), QUERY_PARSE_MODULE, module_id);
    let _ = engine_invoke_query(mut_view(*eng), qk);
    unsafe { *(eng.db.parse_results + (module_id.v as usize)) }
}

pub fn engine_query_module_def_map(eng: mut_view<QueryEngine>, module_id: ModuleId) -> ModuleDefMapResult {
    let qk = query_key_for_module(view(eng.db), QUERY_MODULE_DEF_MAP, module_id);
    let memo = engine_invoke_query(mut_view(*eng), qk);
    if memo.state == QUERY_STATE_POISONED {
        return ModuleDefMapResult {
            module_id: module_id,
            exported_count: 0u32,
            total_defs: QRY_ID_ERROR,
            is_error: true,
            def_map_fingerprint: memo.value_fingerprint,
        };
    }
    unsafe { *(eng.db.def_map_results + (module_id.v as usize)) }
}

pub fn engine_query_resolve_module(eng: mut_view<QueryEngine>, module_id: ModuleId) -> ResolveModuleResult {
    let qk = query_key_for_module(view(eng.db), QUERY_RESOLVE_MODULE, module_id);
    let memo = engine_invoke_query(mut_view(*eng), qk);
    if memo.state == QUERY_STATE_POISONED {
        return ResolveModuleResult {
            module_id: module_id,
            resolved_bindings: 0u32,
            has_resolve_error: true,
            resolve_fingerprint: memo.value_fingerprint,
        };
    }
    unsafe { *(eng.db.resolve_results + (module_id.v as usize)) }
}

pub fn engine_query_item_signature(eng: mut_view<QueryEngine>, def_id: DefId) -> ItemSignatureResult {
    let qk = query_key_for_def(view(eng.db), QUERY_ITEM_SIGNATURE, def_id);
