fn engine_count_maybe_dirty_slots(db: view<CompilerDB>) -> u32 {
    let mut dirty: u32 = 0u32;
    let mut i: u32 = 0u32;
    while i < (db.memo_slot_count) {
        let slot = unsafe { *(db.memo_slots + (i as usize)) };
        if slot.state == QUERY_STATE_MAYBE_DIRTY {
            dirty = dirty + 1u32;
        }
        i = i + 1u32;
    }
    dirty
}

// Mutates `source_file_input` and records transitive dirty invalidation telemetry (AXS-QRY-032)
pub fn engine_set_source_file_input(
    eng: mut_view<QueryEngine>,
    id: SourceFileId,
    path: StrView,
    text: StrView,
    durability: u8
) -> RevisionId {
    let dirty_before = engine_count_maybe_dirty_slots(view(eng.db));
    let rev = query_db_set_source_file_input(mut_view(eng.db), id, path, text, durability);
    let dirty_after = engine_count_maybe_dirty_slots(view(eng.db));
    if dirty_after > dirty_before {
        eng.invalidation_waves = eng.invalidation_waves + 1u32;
        eng.total_slots_dirtied = eng.total_slots_dirtied + (dirty_after - dirty_before);
    }
    engine_reset_active_diagnostics(mut_view(*eng));
    rev
}

pub fn engine_set_module_tree_input(
    eng: mut_view<QueryEngine>,
    id: ModuleId,
    package_id: PackageId,
    parent_id: ModuleId,
    module_path: StrView,
    source_file_id: SourceFileId,
    durability: u8
) -> RevisionId {
    let dirty_before = engine_count_maybe_dirty_slots(view(eng.db));
    let rev = query_db_set_module_tree_input(mut_view(eng.db), id, package_id, parent_id, module_path, source_file_id, durability);
    let dirty_after = engine_count_maybe_dirty_slots(view(eng.db));
    if dirty_after > dirty_before {
        eng.invalidation_waves = eng.invalidation_waves + 1u32;
        eng.total_slots_dirtied = eng.total_slots_dirtied + (dirty_after - dirty_before);
    }
    engine_reset_active_diagnostics(mut_view(*eng));
    rev
}

