module compiler.lexer.session

use compiler.kernel.arena.arena_new
use compiler.kernel.id.FileId
use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_new
use compiler.diag.format.ax_diag_render_human
use compiler.diag.json.ax_diag_render_json
use compiler.kernel_source_diag.session.CompilerSession
use compiler.kernel_source_diag.session.session_add_virtual_file
use compiler.kernel_source_diag.session.session_file_text
use compiler.kernel_source_diag.session.session_error_count
use compiler.lex.token.Token
use compiler.lex.token.Comment
use compiler.lex.token.LexResult
use compiler.lex.token.ax_lex_render_tokens
use compiler.lex.scanner.ax_lex_result_free
use compiler.lex.scanner.ax_lex_into

pub fn session_lex_file(sess: mut_view<CompilerSession>, fid: FileId, out: mut_view<LexResult>) {
    let text = session_file_text(view(*sess), FileId { v: fid.v });
    ax_lex_into(FileId { v: fid.v }, text, mut_view(sess.diag_sink), mut_view(sess.interner), out);
}

pub fn session_lex_virtual_file(sess: mut_view<CompilerSession>, path: StrView, text: StrView, out: mut_view<LexResult>) -> FileId {
    let fid = session_add_virtual_file(mut_view(*sess), path, text);
    let stored_text = session_file_text(view(*sess), FileId { v: fid.v });
    ax_lex_into(FileId { v: fid.v }, stored_text, mut_view(sess.diag_sink), mut_view(sess.interner), out);
    FileId { v: fid.v }
}

pub fn session_render_tokens(sess: view<CompilerSession>, res: view<LexResult>) -> DiagBuffer {
    let mut buf = diag_buf_new();
    ax_lex_render_tokens(res, view(sess.interner), mut_view(buf));
    buf
}

pub fn session_render_tokens_into(sess: view<CompilerSession>, res: view<LexResult>, out: mut_view<DiagBuffer>) {
    ax_lex_render_tokens(res, view(sess.interner), out);
}

pub fn session_lex_and_render_human(
    sess: mut_view<CompilerSession>,
    path: StrView,
    text: StrView,
    out_tokens: mut_view<DiagBuffer>,
    out_diags: mut_view<DiagBuffer>
) -> usize {
    let mut res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let _fid = session_lex_virtual_file(mut_view(*sess), path, text, mut_view(res));
    ax_lex_render_tokens(view(res), view(sess.interner), out_tokens);
    ax_lex_result_free(mut_view(res));
    ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), out_diags);
    session_error_count(view(*sess))
}

pub fn session_lex_and_render_json(
    sess: mut_view<CompilerSession>,
    path: StrView,
    text: StrView,
    out_tokens: mut_view<DiagBuffer>,
    out_json: mut_view<DiagBuffer>
) -> usize {
    let mut res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let _fid = session_lex_virtual_file(mut_view(*sess), path, text, mut_view(res));
    ax_lex_render_tokens(view(res), view(sess.interner), out_tokens);
    ax_lex_result_free(mut_view(res));
    ax_diag_render_json(view(sess.diag_sink), view(sess.source_db), out_json);
    session_error_count(view(*sess))
}
