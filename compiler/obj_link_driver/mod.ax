// Axiom Compiler — axiomc Integration Facade (compiler/obj_link_driver/mod.ax)
//
// Group T085 integration point: the COFF object writer (compiler.obj, T085a), the PE32+ linker
// (compiler.link, T085b) and the compiler driver / pipeline CLI (compiler.driver, T085c) joined
// into the `axiomc` command-line compiler. The module re-exports the public artefact producers
// so that tests and the stage-1 bootstrap (T086) have one place to import from, and defines the
// `axiomc` entry point `axiomc_main`, which is the exact behaviour of `bootstrap/axiom0`'s `main`.
module compiler.obj_link_driver

// --- COFF object model and writer (compiler/obj, T085a) ---
pub use compiler.obj.coff.CoffBuf
pub use compiler.obj.coff.ObjModel
pub use compiler.obj.coff.coff_buf_new
pub use compiler.obj.coff.coff_buf_with_capacity
pub use compiler.obj.coff.coff_buf_free
pub use compiler.obj.writer.coff_write_to_buf
pub use compiler.obj.writer.coff_encode_bytes
pub use compiler.obj.writer.coff_write_path_bytes
pub use compiler.obj.writer.coff_write_str

// --- PE32+ linker (compiler/link, T085b) ---
pub use compiler.link.linker.pe_link_coff_buffers_to_buf
pub use compiler.link.linker.pe_link_single_coff_to_buf
pub use compiler.link.linker.pe_link_objmodel_to_buf
pub use compiler.link.linker.pe_link_files_to_buf
pub use compiler.link.linker.pe_link
pub use compiler.link.linker.pe_link_one_file_str
pub use compiler.link.linker.pe_link_objmodel_to_file_str

// --- Driver and pipeline CLI (compiler/driver, T085c) ---
pub use compiler.driver.opts.AX_EXIT_OK
pub use compiler.driver.opts.AX_EXIT_DIAG
pub use compiler.driver.opts.AX_EXIT_USAGE
pub use compiler.driver.opts.AX_EXIT_ICE
pub use compiler.driver.opts.DriverOptions
pub use compiler.driver.opts.driver_options_alloc
pub use compiler.driver.opts.driver_options_dealloc
pub use compiler.driver.opts.driver_parse_cli
pub use compiler.driver.pipeline.driver_execute_build_into
pub use compiler.driver.pipeline.driver_run_args
pub use compiler.driver.pipeline.driver_main

// --- axiomc entry point ---

// The whole `axiomc` program: reads the process arguments, runs the CLI (`help`, `version`,
// `inspect`, `check`, `build`, `run`), flushes stdout/stderr and returns the process exit code
// (0 ok, 1 diagnostics, 2 usage, 3 internal error, program exit code for `run`).
pub fn axiomc_main() -> i32 {
    driver_main()
}
