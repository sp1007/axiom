// Span used for generated nodes that have no source position.
fn empty_span() -> Span {
    Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }
}

// Binding power of the infix/postfix operator `kind`, or 0 when it is not an operator.
fn infix_prec(kind: u8) -> i32 {
    if kind == TOK_DOT || kind == TOK_LPAREN || kind == TOK_LBRACKET || kind == TOK_QUESTION || kind == TOK_ARROW {
        return PREC_POSTFIX;
    }
    if kind == TOK_KW_AS {
        return PREC_CAST;
    }
    if kind == TOK_STAR || kind == TOK_SLASH || kind == TOK_PERCENT {
        return PREC_MULTIPLICATIVE;
    }
    if kind == TOK_PLUS || kind == TOK_MINUS {
        return PREC_ADDITIVE;
    }
    if kind == TOK_SHL || kind == TOK_SHR {
        return PREC_SHIFT;
    }
    if kind == TOK_AMP {
        return PREC_BIT_AND;
    }
    if kind == TOK_CARET {
        return PREC_BIT_XOR;
    }
    if kind == TOK_PIPE {
        return PREC_BIT_OR;
    }
    if kind >= TOK_EQ_EQ && kind <= TOK_GT_EQ {
        return PREC_COMPARISON;
    }
    if kind == TOK_AMP_AMP {
        return PREC_LOGICAL_AND;
    }
    if kind == TOK_PIPE_PIPE {
        return PREC_LOGICAL_OR;
    }
    if kind == TOK_DOT_DOT || kind == TOK_DOT_DOT_EQ {
        return PREC_RANGE;
    }
    0
}

// AST binary operator code for a binary operator token.
fn binary_op_for_token(kind: u8) -> u8 {
    if kind == TOK_PLUS {
        return BINOP_ADD;
    }
    if kind == TOK_MINUS {
        return BINOP_SUB;
    }
    if kind == TOK_STAR {
        return BINOP_MUL;
    }
    if kind == TOK_SLASH {
        return BINOP_DIV;
    }
    if kind == TOK_PERCENT {
        return BINOP_REM;
    }
    if kind == TOK_AMP {
        return BINOP_BITAND;
    }
    if kind == TOK_PIPE {
        return BINOP_BITOR;
    }
    if kind == TOK_CARET {
        return BINOP_BITXOR;
    }
    if kind == TOK_SHL {
        return BINOP_SHL;
    }
    if kind == TOK_SHR {
        return BINOP_SHR;
    }
    if kind == TOK_EQ_EQ {
        return BINOP_EQ;
    }
    if kind == TOK_BANG_EQ {
        return BINOP_NE;
    }
    if kind == TOK_LT {
        return BINOP_LT;
    }
    if kind == TOK_LT_EQ {
        return BINOP_LE;
    }
    if kind == TOK_GT {
        return BINOP_GT;
    }
    if kind == TOK_GT_EQ {
        return BINOP_GE;
    }
    if kind == TOK_AMP_AMP {
        return BINOP_LOGAND;
    }
    BINOP_LOGOR
}

// True for tokens after which a range `a..` has no end expression.
fn is_range_end(kind: u8) -> bool {
    kind == TOK_EOF || kind == TOK_RPAREN || kind == TOK_RBRACKET || kind == TOK_RBRACE || kind == TOK_COMMA ||
        kind == TOK_SEMI
}

pub struct Parser {
    pub arena: *mut Arena,
    pub tokens: *mut Token,
    pub count: usize,
    pub pos: usize,
    pub sink: *mut DiagSink,
    pub interner: *mut StrInterner,
    // Newline sensitivity: on at statement level, off inside brackets.
    pub mode_on: bool,
    // Set while parsing the header of `if`/`while`/`match`/`for`, where `Name {` starts a block.
    pub no_struct: bool,
    pub type_tentative: bool,
    pub allow_bodiless_fn: bool,
    // Speculative parsing: errors only mark `tentative_failed` instead of being reported.
    pub tentative: i32,
    pub tentative_failed: bool,
    // `>>`, `>=` and `>>=` tokens that were split while closing generic arguments, so a failed
    // speculative parse can restore them.
    pub split_len: usize,
    pub split_indices: *mut usize,
    pub split_tokens: *mut Token,
}

// Pointer to element `idx` of a `usize` array.
fn usize_ptr(base: *mut usize, idx: usize) -> *mut usize {
    ((base as usize) + (((idx as isize) * (size_of<usize>() as isize)) as usize)) as *mut usize
}

// Copies every field of the token `src` into `dst`.
fn copy_token_into(dst: mut_view<Token>, src: *const Token) {
    unsafe {
        dst.kind = (*src).kind;
        dst.suffix = (*src).suffix;
        dst.flags = (*src).flags;
        dst.char_val = (*src).char_val;
        dst.span.file.v = (*src).span.file.v;
        dst.span.start = (*src).span.start;
        dst.span.end = (*src).span.end;
        dst.int_val = (*src).int_val;
        dst.str_ptr = (*src).str_ptr;
        dst.str_len = (*src).str_len;
        dst.ident_val.v = (*src).ident_val.v;
    }
}

// Token `n` positions ahead of the cursor (the EOF token once the stream is exhausted).
fn peek_nth_ptr(parser: view<Parser>, n: usize) -> *mut Token {
    if (parser.pos + n) < parser.count {
        return unsafe { lex_token_ptr(parser.tokens, parser.pos + n) };
    }
    unsafe { lex_token_ptr(parser.tokens, parser.count - 1) }
}

// Token `back` positions before the cursor.
fn peek_prev_ptr(parser: view<Parser>, back: usize) -> *mut Token {
    if parser.pos >= back && (parser.pos - back) < parser.count {
        return unsafe { lex_token_ptr(parser.tokens, parser.pos - back) };
    }
    unsafe { lex_token_ptr(parser.tokens, parser.count - 1) }
}

// The current token.
fn peek_ptr(parser: view<Parser>) -> *mut Token {
    peek_nth_ptr(parser, 0)
}

// Kind of the current token.
fn peek_kind(parser: view<Parser>) -> u8 {
    unsafe { (*peek_ptr(parser)).kind }
}

// Kind of the token `n` positions ahead.
fn peek_nth_kind(parser: view<Parser>, n: usize) -> u8 {
    unsafe { (*peek_nth_ptr(parser, n)).kind }
}

// Kind of the token `back` positions behind the cursor.
fn peek_prev_kind(parser: view<Parser>, back: usize) -> u8 {
    unsafe { (*peek_prev_ptr(parser, back)).kind }
}

// Source span of the current token.
fn peek_span(parser: view<Parser>) -> Span {
    unsafe { ast_copy_span((*peek_ptr(parser)).span) }
}

// Source span of the token `back` positions behind the cursor.
fn peek_prev_span(parser: view<Parser>, back: usize) -> Span {
    unsafe { ast_copy_span((*peek_prev_ptr(parser, back)).span) }
}

// Lexer flags (`TOK_FLAG_*`) of the current token.
fn peek_flags(parser: view<Parser>) -> u16 {
    unsafe { (*peek_ptr(parser)).flags }
}

// Interned name of the current token (meaningful for identifier tokens).
fn peek_ident(parser: view<Parser>) -> StrId {
    unsafe { StrId { v: (*peek_ptr(parser)).ident_val.v } }
}

// Moves past the current token (the cursor never goes beyond the final EOF token).
fn advance(parser: mut_view<Parser>) {
    if (parser.pos) < parser.count {
        parser.pos = parser.pos + 1;
    }
}

// True when the current token has the given kind.
fn check(parser: view<Parser>, kind: u8) -> bool {
    peek_kind(parser) == kind
}

// Advances and returns true when the current token has the given kind.
fn consume(parser: mut_view<Parser>, kind: u8) -> bool {
    if check(view(*parser), kind) {
        advance(mut_view(*parser));
        return true;
    }
    false
}

// True when a line break separates the current token from the previous one.
fn token_follows_newline(parser: view<Parser>) -> bool {
    (peek_flags(parser) & TOK_FLAG_NL_BEFORE) != 0u16
}

// True when newlines are significant and the current token starts a new line.
fn line_break_before(parser: view<Parser>) -> bool {
    parser.mode_on && token_follows_newline(parser)
}

// True while the current token is neither `closer` nor the end of the file.
fn more_before(parser: view<Parser>, closer: u8) -> bool {
    !check(parser, closer) && !check(parser, TOK_EOF)
}

// Copies one entry of the text table into `arena` as a NUL-terminated string view.
fn text_in_arena(arena: mut_view<Arena>, text_index: usize) -> StrView {
    let start = PARSE_OFF[text_index] as usize;
    let end = PARSE_OFF[text_index + 1] as usize;
    let length = end - start;
    let bytes = arena_alloc_raw(arena, length + 1, 1);
    let mut i: usize = 0;
    while i < length {
        unsafe {
            *(bytes + i) = PARSE_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(bytes + length) = 0u8;
    }
    StrView { ptr: bytes as *const u8, len: length }
}

// True when the interned identifier `ident_value` spells the text-table entry `text_index`.
fn ident_equals_text(interner: view<StrInterner>, ident_value: u32, text_index: usize) -> bool {
    if ident_value == 0u32 {
        return false;
    }
    let name = interner_get(interner, StrId { v: ident_value });
    let start = PARSE_OFF[text_index] as usize;
    let end = PARSE_OFF[text_index + 1] as usize;
    if name.len != end - start {
        return false;
    }
    let mut i: usize = 0;
    while i < name.len {
        if (unsafe { *(name.ptr + i) }) != PARSE_DATA[start + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

// Interns the text-table entry `text_index` and returns its id.
fn intern_text(parser: mut_view<Parser>, text_index: usize) -> StrId {
    let start = PARSE_OFF[text_index] as usize;
    let end = PARSE_OFF[text_index + 1] as usize;
    let length = end - start;
    let bytes = arena_alloc_raw(unsafe { mut_view(*parser.arena) }, length, 1);
    let mut i: usize = 0;
    while i < length {
        unsafe {
            *(bytes + i) = PARSE_DATA[start + i];
        }
        i = i + 1;
    }
    interner_intern_bytes(unsafe { mut_view(*parser.interner) }, bytes as *const u8, length)
}

// Reports a parse error, or just marks the speculative parse as failed while inside one.
fn report(parser: mut_view<Parser>, span: Span, code_value: u32, message_index: usize) {
    if parser.tentative > 0 {
        parser.tentative_failed = true;
        return;
    }
    let msg = text_in_arena(unsafe { mut_view((*parser.sink).arena) }, message_index);
    let mut diagnostic = Diagnostic {
        code: DiagCode { v: code_value }, severity: DiagSeverity.Error,
        message: StrView { ptr: msg.ptr, len: msg.len },
        primary: empty_span(),
        labels: 0 as *mut DiagLabel, label_count: 0,
        notes: 0 as *mut StrView, note_count: 0,
        helps: 0 as *mut StrView, help_count: 0,
        fixes: 0 as *mut DiagFix, fix_count: 0,
        data: 0 as *mut DiagDataEntry, data_count: 0,
    };
    ast_set_span(mut_view(diagnostic.primary), span);
    diag_sink_report(unsafe { mut_view(*parser.sink) }, view(diagnostic));
}

// Reports an error at the current token.
fn report_here(parser: mut_view<Parser>, code_value: u32, message_index: usize) {
    let span = peek_span(view(*parser));
    report(mut_view(*parser), span, code_value, message_index);
}

// Consumes a token of `kind` or reports the error `code_value` with the given message.
fn expect(parser: mut_view<Parser>, kind: u8, code_value: u32, message_index: usize) {
    if check(view(*parser), kind) {
        advance(mut_view(*parser));
    } else {
        report_here(mut_view(*parser), code_value, message_index);
    }
}

// Consumes an identifier and returns it (a zero id when missing).
fn expect_ident(parser: mut_view<Parser>, message_index: usize) -> StrId {
    let ident = peek_ident(view(*parser));
    expect(mut_view(*parser), TOK_IDENT, AX_PARSE_EXPECTED_TOKEN, message_index);
    ident
}

// True for an identifier or one of the `Self` / `self` keywords.
fn check_ident_or_self(parser: view<Parser>) -> bool {
    let kind = peek_kind(parser);
    kind == TOK_IDENT || kind == TOK_KW_SELF_TYPE || kind == TOK_KW_SELF_VALUE
}

// Consumes an identifier or `Self`/`self`, returning the interned name.
fn consume_ident_or_self(parser: mut_view<Parser>) -> StrId {
    let kind = peek_kind(view(*parser));
    let mut ident_value = peek_ident(view(*parser)).v;
    if kind == TOK_KW_SELF_TYPE {
        ident_value = intern_text(mut_view(*parser), LIT_SELF_TYPE).v;
    }
    if kind == TOK_KW_SELF_VALUE {
        ident_value = intern_text(mut_view(*parser), LIT_SELF_VALUE).v;
    }
    advance(mut_view(*parser));
    StrId { v: ident_value }
}

// Error recovery: skips tokens up to the end of the statement (`;`, `}`, EOF or a new line).
fn skip_to_terminator(parser: mut_view<Parser>) {
    while more_before(view(*parser), TOK_SEMI) && !check(view(*parser), TOK_RBRACE) {
        if line_break_before(view(*parser)) {
            break;
        }
        advance(mut_view(*parser));
    }
}

// Splits the current `>>`, `>=` or `>>=` token so that its first `>` can close a generic list.
fn split_gt(parser: mut_view<Parser>, rest: u8) {
    if parser.tentative > 0 {
        if parser.split_len >= MAX_TOKEN_SPLITS {
            parser.tentative_failed = true;
            return;
        }
        unsafe {
            let dst = lex_token_ptr(parser.split_tokens, parser.split_len);
            *(usize_ptr(parser.split_indices, parser.split_len)) = parser.pos;
            copy_token_into(mut_view(*dst), peek_ptr(view(*parser)) as *const Token);
        }
        parser.split_len = parser.split_len + 1;
    }
    let split_token = peek_ptr(view(*parser));
    unsafe {
        (*split_token).kind = rest;
        let s0 = (*split_token).span.start;
        let s1 = s0 + 1u32;
        (*split_token).span.start = s1;
        (*split_token).flags = (*split_token).flags & (~TOK_FLAG_NL_BEFORE);
    }
}

// Restores the tokens split since `mark` (used when a speculative parse is abandoned).
fn split_rollback(parser: mut_view<Parser>, mark: usize) {
    while parser.split_len > mark {
        parser.split_len = parser.split_len - 1;
        let dst = unsafe { lex_token_ptr(parser.tokens, *(usize_ptr(parser.split_indices, parser.split_len))) };
        unsafe {
            copy_token_into(mut_view(*dst), lex_token_ptr(parser.split_tokens, parser.split_len) as *const Token);
        }
    }
}

// Parses `a.b.c` into `dst`.
fn parse_dotted_name_into(parser: mut_view<Parser>, dst: mut_view<AstDottedName>) {
    ast_set_span(mut_view(dst.span), peek_span(view(*parser)));
    let capacity = MAX_DOTTED_NAME_SEGMENTS;
    let bytes = capacity * size_of<StrId>();
    let buf = arena_alloc_raw(unsafe { mut_view(*parser.arena) }, bytes, align_of<StrId>()) as *mut StrId;
    let mut count: usize = 0;
    while !check(view(*parser), TOK_EOF) && count < capacity {
        if check(view(*parser), TOK_IDENT) {
            unsafe {
                (*(str_id_ptr(buf, count))).v = peek_ident(view(*parser)).v;
            }
            count = count + 1;
            advance(mut_view(*parser));
        } else {
            report_here(mut_view(*parser), AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_IDENTIFIER);
            break;
        }
        if !consume(mut_view(*parser), TOK_DOT) {
            break;
        }
    }
    dst.segments = buf;
    dst.count = count;
}

// Parses a use declaration: `a.b`, `a.b as c` or `a.{b, c}`.
fn parse_use_tree(parser: mut_view<Parser>) -> *mut AstUseTree {
    let tree = alloc_use_tree(parser.arena, peek_span(view(*parser)));
    unsafe {
        parse_dotted_name_into(mut_view(*parser), mut_view((*tree).path));
        if consume(mut_view(*parser), TOK_KW_AS) {
            if check(view(*parser), TOK_IDENT) {
                (*tree).alias.v = peek_ident(view(*parser)).v;
                advance(mut_view(*parser));
            } else {
                report_here(mut_view(*parser), AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_ALIAS_IDENT);
            }
        } else if consume(mut_view(*parser), TOK_DOT) {
            expect(mut_view(*parser), TOK_LBRACE, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LBRACE);
            while more_before(view(*parser), TOK_RBRACE) {
                (*tree).subtrees = link_use_tree((*tree).subtrees, parse_use_tree(mut_view(*parser)));
                if !consume(mut_view(*parser), TOK_COMMA) {
                    break;
                }
            }
            expect(mut_view(*parser), TOK_RBRACE, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACE);
        }
    }
    tree
}

// Parses `<Type, name = Type, ...>`; returns null when no `<` follows.
fn parse_generic_args(parser: mut_view<Parser>) -> *mut AstGenericArgs {
    if !check(view(*parser), TOK_LT) {
        return 0 as *mut AstGenericArgs;
    }
    let args = alloc_generic_args(parser.arena, peek_span(view(*parser)));
    advance(mut_view(*parser));
    let saved_mode_on = parser.mode_on;
    parser.mode_on = false;
    while !check(view(*parser), TOK_GT) && !check(view(*parser), TOK_SHR) && !check(view(*parser), TOK_GT_EQ) &&
            more_before(view(*parser), TOK_SHR_EQ) {
        let arg = alloc_generic_arg(parser.arena, peek_span(view(*parser)));
        unsafe {
            if check(view(*parser), TOK_IDENT) && peek_nth_kind(view(*parser), 1) == TOK_EQ {
                (*arg).name.v = peek_ident(view(*parser)).v;
                advance(mut_view(*parser));
                advance(mut_view(*parser));
            }
            (*arg).ty = parse_type(mut_view(*parser));
            (*args).args = link_generic_arg((*args).args, arg);
        }
        if !consume(mut_view(*parser), TOK_COMMA) {
            break;
        }
    }
    if check(view(*parser), TOK_SHR) {
        split_gt(mut_view(*parser), TOK_GT);
    } else if check(view(*parser), TOK_GT_EQ) {
        split_gt(mut_view(*parser), TOK_EQ);
    } else if check(view(*parser), TOK_SHR_EQ) {
        split_gt(mut_view(*parser), TOK_GT_EQ);
    } else if check(view(*parser), TOK_GT) {
        advance(mut_view(*parser));
    } else {
        report_here(mut_view(*parser), AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_GT);
    }
    parser.mode_on = saved_mode_on;
    args
}

// Speculatively parses generic arguments in expression position; rewinds and returns null unless followed as required.
fn try_generic_args(parser: mut_view<Parser>, follow: u8) -> *mut AstGenericArgs {
    if !check(view(*parser), TOK_LT) {
        return 0 as *mut AstGenericArgs;
    }
    if line_break_before(view(*parser)) {
        return 0 as *mut AstGenericArgs;
    }
    let pos = parser.pos;
    let split_mark = parser.split_len;
    let outer_failed = parser.tentative_failed;
    parser.tentative = parser.tentative + 1;
    parser.tentative_failed = false;
    let old_no_struct = parser.no_struct;
    let saved_type_tentative = parser.type_tentative;
    parser.no_struct = false;
    parser.type_tentative = false;
    let args = parse_generic_args(mut_view(*parser));
    parser.no_struct = old_no_struct;
    parser.type_tentative = saved_type_tentative;
    let mut ok = !parser.tentative_failed;
    parser.tentative = parser.tentative - 1;
    parser.tentative_failed = outer_failed;
    if ok && follow != GENERIC_ARGS_FOLLOW_NONE {
        let token_kind = peek_kind(view(*parser));
        let after_newline = line_break_before(view(*parser));
        ok = (token_kind == TOK_LPAREN && !after_newline) || token_kind == TOK_DOT ||
                (follow == GENERIC_ARGS_FOLLOW_CALL_DOT_BRACE && token_kind == TOK_LBRACE && !after_newline);
    }
    if !ok {
        split_rollback(mut_view(*parser), split_mark);
        parser.pos = pos;
        return 0 as *mut AstGenericArgs;
    }
    if parser.tentative == 0 {
        parser.split_len = 0;
    }
    args
}

// Parses `Bound + Bound + ...`.
fn parse_bounds(parser: mut_view<Parser>) -> *mut AstType {
    let mut head = parse_type(mut_view(*parser));
    while consume(mut_view(*parser), TOK_PLUS) {
        head = link_type(head, parse_type(mut_view(*parser)));
    }
    head
}

// Parses a comma separated list of types up to `)`.
fn parse_type_list(parser: mut_view<Parser>) -> *mut AstType {
    let mut head = 0 as *mut AstType;
    while more_before(view(*parser), TOK_RPAREN) {
        head = link_type(head, parse_type(mut_view(*parser)));
        if !consume(mut_view(*parser), TOK_COMMA) {
            break;
        }
    }
    head
}

// Parses a path type `a.B<T>.C`.  Inside a cast (`x as T`) the generic arguments are parsed speculatively.
fn parse_path_type(parser: mut_view<Parser>, type_node: *mut AstType) {
    unsafe {
        (*type_node).kind = TYPE_PATH;
        while check_ident_or_self(view(*parser)) {
            let span = peek_span(view(*parser));
            let name = consume_ident_or_self(mut_view(*parser));
            let segment = alloc_path_seg(parser.arena, span, name);
            if check(view(*parser), TOK_LT) {
                if parser.type_tentative {
                    (*segment).generic_args = try_generic_args(mut_view(*parser), GENERIC_ARGS_FOLLOW_NONE);
                } else {
                    (*segment).generic_args = parse_generic_args(mut_view(*parser));
                }
            }
            (*type_node).segments = link_path_seg((*type_node).segments, segment);
            if !consume(mut_view(*parser), TOK_DOT) {
                break;
            }
        }
    }
}

// Parses `()`, `(Type)` or `(A, B, ...)` after `(` has been consumed.  A single parenthesised type without a
// trailing comma is returned directly instead of a tuple.
fn parse_tuple_type(parser: mut_view<Parser>, type_node: *mut AstType) -> *mut AstType {
    unsafe {
        (*type_node).kind = TYPE_TUPLE;
        if consume(mut_view(*parser), TOK_RPAREN) {
            return type_node;
        }
        (*type_node).elem_types = parse_type_list(mut_view(*parser));
        expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
        let elems = (*type_node).elem_types as *mut AstType;
        if elems as usize != 0 && (*elems).next as usize == 0 && peek_prev_kind(view(*parser), 2) != TOK_COMMA {
            return elems;
        }
        type_node
    }
}

// True when the token after `[expr]` starts an element type, which makes the brackets an array type.
fn starts_element_type(kind: u8) -> bool {
    kind == TOK_IDENT || kind == TOK_LPAREN || kind == TOK_LBRACKET || kind == TOK_STAR || kind == TOK_KW_FN ||
        kind == TOK_KW_UNSAFE || kind == TOK_KW_EXTERN || kind == TOK_KW_VIEW || kind == TOK_KW_MUT_VIEW ||
        kind == TOK_KW_DYN || kind == TOK_KW_SELF_TYPE || kind == TOK_KW_SELF_VALUE
}

// Parses `[count]Element` (array) or `[Element]` (slice) after `[` has been consumed.  The bracket content is
// parsed as an expression first and reinterpreted as a type when it turns out to be a slice.
fn parse_array_or_slice_type(parser: mut_view<Parser>, type_node: *mut AstType) {
    unsafe {
        let expr_or_type = parse_expr(mut_view(*parser));
        expect(mut_view(*parser), TOK_RBRACKET, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACKET);
        if starts_element_type(peek_kind(view(*parser))) {
            (*type_node).kind = TYPE_ARRAY;
            (*type_node).count_expr = expr_or_type;
            (*type_node).elem = parse_type(mut_view(*parser));
        } else {
            let element_type = alloc_type(parser.arena, TYPE_ERROR, empty_span());
            if (*expr_or_type).kind == EXPR_PATH {
                (*element_type).kind = TYPE_PATH;
                (*element_type).segments = (*expr_or_type).segments;
            }
            (*type_node).kind = TYPE_SLICE;
            (*type_node).elem = element_type;
        }
    }
}

// Parses `view<T>` or `mut_view<T>`.
fn parse_view_type(parser: mut_view<Parser>, type_node: *mut AstType) {
    unsafe {
        (*type_node).kind = TYPE_VIEW;
        (*type_node).is_mut = check(view(*parser), TOK_KW_MUT_VIEW);
        advance(mut_view(*parser));
        expect(mut_view(*parser), TOK_LT, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LT);
        (*type_node).elem = parse_type(mut_view(*parser));
        expect(mut_view(*parser), TOK_GT, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_GT);
    }
}

// Parses `*mut T` or `*const T` after `*` has been consumed.
fn parse_pointer_type(parser: mut_view<Parser>, type_node: *mut AstType) {
    unsafe {
        (*type_node).kind = TYPE_PTR;
        if consume(mut_view(*parser), TOK_KW_MUT) {
            (*type_node).is_mut = true;
        } else if !consume(mut_view(*parser), TOK_KW_CONST) {
            report_here(mut_view(*parser), AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_MUT_OR_CONST);
        }
        (*type_node).elem = parse_type(mut_view(*parser));
    }
}

// Parses a function pointer type `[unsafe] [extern "abi"] fn(A, B) -> R`.
fn parse_fn_type(parser: mut_view<Parser>, type_node: *mut AstType) {
    unsafe {
        (*type_node).kind = TYPE_FN;
        (*type_node).is_unsafe = consume(mut_view(*parser), TOK_KW_UNSAFE);
        if consume(mut_view(*parser), TOK_KW_EXTERN) && check(view(*parser), TOK_STR) {
            let string_token = peek_ptr(view(*parser));
            (*type_node).abi.v = interner_intern_bytes(
                mut_view(*parser.interner),
                (*string_token).str_ptr,
                (*string_token).str_len
            ).v;
            advance(mut_view(*parser));
        }
        expect(mut_view(*parser), TOK_KW_FN, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_KW_FN);
        expect(mut_view(*parser), TOK_LPAREN, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LPAREN);
        (*type_node).param_types = parse_type_list(mut_view(*parser));
        expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
        if consume(mut_view(*parser), TOK_ARROW) {
            (*type_node).ret_type = parse_type(mut_view(*parser));
        }
    }
}

// Parses a type: path, tuple, array, slice, view, pointer, function pointer or `dyn Bounds`.
fn parse_type(parser: mut_view<Parser>) -> *mut AstType {
    let type_node = alloc_type(parser.arena, TYPE_ERROR, peek_span(view(*parser)));
    if check_ident_or_self(view(*parser)) {
        parse_path_type(mut_view(*parser), type_node);
    } else if consume(mut_view(*parser), TOK_LPAREN) {
        return parse_tuple_type(mut_view(*parser), type_node);
    } else if consume(mut_view(*parser), TOK_LBRACKET) {
        parse_array_or_slice_type(mut_view(*parser), type_node);
    } else if check(view(*parser), TOK_KW_VIEW) || check(view(*parser), TOK_KW_MUT_VIEW) {
        parse_view_type(mut_view(*parser), type_node);
    } else if consume(mut_view(*parser), TOK_STAR) {
        parse_pointer_type(mut_view(*parser), type_node);
    } else if check(view(*parser), TOK_KW_FN) || check(view(*parser), TOK_KW_UNSAFE) ||
            check(view(*parser), TOK_KW_EXTERN) {
        parse_fn_type(mut_view(*parser), type_node);
    } else if consume(mut_view(*parser), TOK_KW_DYN) {
        unsafe {
            (*type_node).kind = TYPE_DYN;
            (*type_node).bounds = parse_bounds(mut_view(*parser));
        }
    } else {
        report_here(mut_view(*parser), AX_PARSE_EXPECTED_TYPE, MSG_EXPECTED_TYPE);
        advance(mut_view(*parser));
    }
    type_node
}

// True when the current token starts a literal pattern: `1`, `'a'`, `true`, `false` or `-1`.
fn at_literal_pattern_start(parser: view<Parser>) -> bool {
    let kind = peek_kind(parser);
    kind == TOK_INT || kind == TOK_CHAR || kind == TOK_KW_TRUE || kind == TOK_KW_FALSE ||
        (kind == TOK_MINUS && peek_nth_kind(parser, 1) == TOK_INT)
}

// Parses a literal pattern or a range pattern `a..b` / `a..=b` into `pat`.
fn parse_literal_or_range_pattern(parser: mut_view<Parser>, pat: *mut AstPat) {
    unsafe {
        let negated = consume(mut_view(*parser), TOK_MINUS);
        let start_span = peek_span(view(*parser));
        let start_token = peek_ptr(view(*parser)) as *const Token;
        advance(mut_view(*parser));
        if !check(view(*parser), TOK_DOT_DOT) && !check(view(*parser), TOK_DOT_DOT_EQ) {
            (*pat).kind = PAT_LITERAL;
            copy_token_into(mut_view((*pat).tok), start_token);
            (*pat).is_negated = negated;
            return;
        }
        let inclusive = consume(mut_view(*parser), TOK_DOT_DOT_EQ);
        if !inclusive {
            consume(mut_view(*parser), TOK_DOT_DOT);
        }
        let start_pat = alloc_pat(parser.arena, PAT_LITERAL, start_span);
        copy_token_into(mut_view((*start_pat).tok), start_token);
        (*start_pat).is_negated = negated;
        let end_negated = consume(mut_view(*parser), TOK_MINUS);
        let end_span = peek_span(view(*parser));
        let end_token = peek_ptr(view(*parser)) as *const Token;
        let mut expected_kind = TOK_INT;
        if (*end_token).kind == TOK_INT || (*end_token).kind == TOK_CHAR {
            expected_kind = (*end_token).kind;
        }
        expect(mut_view(*parser), expected_kind, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_RANGE_BOUND);
        let end_pat = alloc_pat(parser.arena, PAT_LITERAL, end_span);
        copy_token_into(mut_view((*end_pat).tok), end_token);
        (*end_pat).is_negated = end_negated;
        (*pat).kind = PAT_RANGE;
        (*pat).is_inclusive = inclusive;
        (*pat).start_pat = start_pat;
        (*pat).end_pat = end_pat;
    }
}

// Parses the fields of a struct pattern after `{`: `a, b: pattern, mut c, ..`.
fn parse_struct_pattern_fields(parser: mut_view<Parser>, pat: *mut AstPat) {
    unsafe {
        while more_before(view(*parser), TOK_RBRACE) {
            if consume(mut_view(*parser), TOK_DOT_DOT) {
                (*pat).has_rest = true;
                break;
            }
            let field = alloc_pat_field(parser.arena, peek_span(view(*parser)));
            if consume(mut_view(*parser), TOK_KW_MUT) {
                let field_name = expect_ident(mut_view(*parser), MSG_EXPECTED_IDENTIFIER_AFTER_MUT);
                let binding_pat = alloc_pat(parser.arena, PAT_BINDING, (*field).span);
                (*field).name.v = field_name.v;
                (*binding_pat).is_mut = true;
                (*binding_pat).name.v = field_name.v;
                (*field).pat = binding_pat;
            } else {
                (*field).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_FIELD_NAME).v;
                if consume(mut_view(*parser), TOK_COLON) {
                    (*field).pat = parse_pattern(mut_view(*parser));
                }
            }
            (*pat).fields = link_pat_field((*pat).fields, field);
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
        expect(mut_view(*parser), TOK_RBRACE, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACE);
    }
}

// Parses a path pattern `a.B`, a tuple-variant pattern `a.B(x, y)` or a struct pattern `a.B { x, .. }`.
fn parse_path_pattern(parser: mut_view<Parser>, pat: *mut AstPat) {
    unsafe {
        let mut head = 0 as *mut AstTypePathSegment;
        while check_ident_or_self(view(*parser)) {
            let span = peek_span(view(*parser));
            let name = consume_ident_or_self(mut_view(*parser));
            let segment = alloc_path_seg(parser.arena, span, name);
            if check(view(*parser), TOK_LT) {
                (*segment).generic_args = parse_generic_args(mut_view(*parser));
            }
            head = link_path_seg(head, segment);
            if !consume(mut_view(*parser), TOK_DOT) {
                break;
            }
        }
        (*pat).segments = head;
        if consume(mut_view(*parser), TOK_LPAREN) {
            let tuple_pat = alloc_pat(parser.arena, PAT_TUPLE, (*pat).span);
            while more_before(view(*parser), TOK_RPAREN) {
                (*tuple_pat).elems = link_pat((*tuple_pat).elems, parse_pattern(mut_view(*parser)));
                if !consume(mut_view(*parser), TOK_COMMA) {
                    break;
                }
            }
            expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
            (*pat).kind = PAT_PATH;
            (*pat).payload = tuple_pat;
        } else if consume(mut_view(*parser), TOK_LBRACE) {
            (*pat).kind = PAT_STRUCT;
            parse_struct_pattern_fields(mut_view(*parser), pat);
        } else {
            (*pat).kind = PAT_PATH;
        }
    }
}

// Parses a binding (`x`, `mut x`) or a path-like pattern starting at an identifier, `Self` or `mut`.
fn parse_binding_or_path_pattern(parser: mut_view<Parser>, pat: *mut AstPat) {
    unsafe {
        let next_kind = peek_nth_kind(view(*parser), 1);
        if check(view(*parser), TOK_IDENT) && next_kind != TOK_DOT && next_kind != TOK_LPAREN &&
                next_kind != TOK_LBRACE && next_kind != TOK_LT {
            (*pat).kind = PAT_BINDING;
            (*pat).name.v = peek_ident(view(*parser)).v;
            advance(mut_view(*parser));
        } else if consume(mut_view(*parser), TOK_KW_MUT) {
            (*pat).kind = PAT_BINDING;
            (*pat).is_mut = true;
            (*pat).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_IDENTIFIER_AFTER_MUT).v;
        } else {
            parse_path_pattern(mut_view(*parser), pat);
        }
    }
}

// Parses `()`, `(pattern)` or `(a, b, ...)` after `(` has been consumed.  A single parenthesised pattern
// without a trailing comma is returned directly instead of a tuple.
fn parse_paren_or_tuple_pattern(parser: mut_view<Parser>, pat: *mut AstPat) -> *mut AstPat {
    unsafe {
        (*pat).kind = PAT_TUPLE;
        if consume(mut_view(*parser), TOK_RPAREN) {
            return pat;
        }
        while more_before(view(*parser), TOK_RPAREN) {
            (*pat).elems = link_pat((*pat).elems, parse_pattern(mut_view(*parser)));
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
        expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
        let elems = (*pat).elems as *mut AstPat;
        if elems as usize != 0 && (*elems).next as usize == 0 && peek_prev_kind(view(*parser), 2) != TOK_COMMA {
            return elems;
        }
        pat
    }
}

// Parses a pattern without a top-level `|`.
fn parse_pat_no_or(parser: mut_view<Parser>) -> *mut AstPat {
    let pat = alloc_pat(parser.arena, PAT_ERROR, peek_span(view(*parser)));
    if consume(mut_view(*parser), TOK_UNDERSCORE) {
        unsafe {
            (*pat).kind = PAT_WILDCARD;
        }
    } else if at_literal_pattern_start(view(*parser)) {
        parse_literal_or_range_pattern(mut_view(*parser), pat);
    } else if check_ident_or_self(view(*parser)) || check(view(*parser), TOK_KW_MUT) {
        parse_binding_or_path_pattern(mut_view(*parser), pat);
    } else if consume(mut_view(*parser), TOK_LPAREN) {
        return parse_paren_or_tuple_pattern(mut_view(*parser), pat);
    } else {
        report_here(mut_view(*parser), AX_PARSE_EXPECTED_PATTERN, MSG_EXPECTED_PATTERN);
        advance(mut_view(*parser));
    }
    pat
}

// Parses a pattern, including `a | b` alternatives.
fn parse_pattern(parser: mut_view<Parser>) -> *mut AstPat {
    let pat = parse_pat_no_or(mut_view(*parser));
    if check(view(*parser), TOK_PIPE) {
        let or_pat = alloc_pat(parser.arena, PAT_OR, unsafe { (*pat).span });
        unsafe {
            (*or_pat).pats = pat;
            while consume(mut_view(*parser), TOK_PIPE) {
                (*or_pat).pats = link_pat((*or_pat).pats, parse_pat_no_or(mut_view(*parser)));
            }
        }
        return or_pat;
    }
    pat
}

// Consumes `loop`/`while`/`for`, optionally preceded by a label (`'outer: loop`).
fn consume_loop_head(parser: mut_view<Parser>, keyword_kind: u8, expr: *mut AstExpr) -> bool {
    if check(view(*parser), TOK_LABEL) && peek_nth_kind(view(*parser), 1) == TOK_COLON &&
            peek_nth_kind(view(*parser), 2) == keyword_kind {
        unsafe {
            (*expr).label.v = peek_ident(view(*parser)).v;
        }
        advance(mut_view(*parser));
        advance(mut_view(*parser));
        advance(mut_view(*parser));
        return true;
    }
    consume(mut_view(*parser), keyword_kind)
}

// Operators that can only be binary: seeing one at the start of a statement is an error.
fn is_leading_operator_kind(kind: u8) -> bool {
    kind == TOK_KW_AS || kind == TOK_DOT_DOT || kind == TOK_DOT_DOT_EQ || kind == TOK_QUESTION ||
        kind == TOK_ARROW || kind == TOK_FAT_ARROW || kind == TOK_PLUS || kind == TOK_SLASH ||
        kind == TOK_PERCENT || kind == TOK_AMP || kind == TOK_CARET || kind == TOK_SHL ||
        kind == TOK_SHR || kind == TOK_AMP_AMP || (kind >= TOK_EQ_EQ && kind <= TOK_SHR_EQ)
}

// AST unary operator code for a prefix operator token.
fn unary_op_for_token(kind: u8) -> u8 {
    if kind == TOK_MINUS {
        return UNOP_NEG;
    }
    if kind == TOK_BANG {
        return UNOP_NOT;
    }
    if kind == TOK_TILDE {
        return UNOP_BITNOT;
    }
    UNOP_DEREF
}

// AST jump kind for `return`, `break` or `continue`.
fn jump_kind_for_token(kind: u8) -> u8 {
    if kind == TOK_KW_RETURN {
        return JUMP_RETURN;
    }
    if kind == TOK_KW_BREAK {
        return JUMP_BREAK;
    }
    JUMP_CONTINUE
}

// True for tokens that form a literal expression.
fn is_literal_start_kind(kind: u8) -> bool {
    (kind >= TOK_INT && kind <= TOK_CHAR) || kind == TOK_KW_TRUE || kind == TOK_KW_FALSE
}

// Parses `-x`, `!x`, `~x` or `*x`.
fn parse_unary_expr(parser: mut_view<Parser>, expr: *mut AstExpr, kind: u8) {
    unsafe {
        (*expr).kind = EXPR_UNARY;
        (*expr).op = unary_op_for_token(kind);
        advance(mut_view(*parser));
        (*expr).inner = parse_expr_prec(mut_view(*parser), PREC_UNARY);
    }
}

// Parses a prefix range `..end` or `..=end`.
fn parse_prefix_range_expr(parser: mut_view<Parser>, expr: *mut AstExpr, kind: u8) {
    unsafe {
        advance(mut_view(*parser));
        (*expr).kind = EXPR_RANGE;
        (*expr).is_inclusive = kind == TOK_DOT_DOT_EQ;
        if !is_range_end(peek_kind(view(*parser))) {
            (*expr).end_expr = parse_expr_prec(mut_view(*parser), PREC_LOGICAL_OR);
        }
    }
}

// Looks ahead over `a.b<T>.c` and tells whether a `{` follows, i.e. whether a path starts a struct literal.
fn path_starts_struct_literal(parser: mut_view<Parser>) -> bool {
    if parser.no_struct {
        return false;
    }
    let initial_pos = parser.pos;
    let split_mark = parser.split_len;
    let outer_failed = parser.tentative_failed;
    parser.tentative = parser.tentative + 1;
    while check_ident_or_self(view(*parser)) {
        advance(mut_view(*parser));
        try_generic_args(mut_view(*parser), GENERIC_ARGS_FOLLOW_CALL_DOT_BRACE);
        if !consume(mut_view(*parser), TOK_DOT) {
            break;
        }
    }
    let is_struct = check(view(*parser), TOK_LBRACE) && !line_break_before(view(*parser));
    parser.tentative = parser.tentative - 1;
    parser.tentative_failed = outer_failed;
    split_rollback(mut_view(*parser), split_mark);
    parser.pos = initial_pos;
    is_struct
}

// Parses `Path { field: value, other }`.
fn parse_struct_literal_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    unsafe {
        let mut head = 0 as *mut AstTypePathSegment;
        while check_ident_or_self(view(*parser)) {
            let span = peek_span(view(*parser));
            let name = consume_ident_or_self(mut_view(*parser));
            let segment = alloc_path_seg(parser.arena, span, name);
            (*segment).generic_args = try_generic_args(mut_view(*parser), GENERIC_ARGS_FOLLOW_CALL_DOT_BRACE);
            head = link_path_seg(head, segment);
            if !consume(mut_view(*parser), TOK_DOT) {
                break;
            }
        }
        advance(mut_view(*parser));
        (*expr).kind = EXPR_STRUCT;
        (*expr).segments = head;
        while more_before(view(*parser), TOK_RBRACE) {
            let field_init = alloc_field_init(parser.arena, peek_span(view(*parser)));
            (*field_init).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_FIELD_NAME).v;
            if consume(mut_view(*parser), TOK_COLON) {
                (*field_init).expr = parse_expr(mut_view(*parser));
            }
            (*expr).fields = link_field_init((*expr).fields, field_init);
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
        expect(mut_view(*parser), TOK_RBRACE, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACE);
    }
}

// Parses a path expression or a struct literal starting at an identifier.
fn parse_path_or_struct_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    if path_starts_struct_literal(mut_view(*parser)) {
        parse_struct_literal_expr(mut_view(*parser), expr);
        return;
    }
    unsafe {
        let span = peek_span(view(*parser));
        let name = consume_ident_or_self(mut_view(*parser));
        let segment = alloc_path_seg(parser.arena, span, name);
        (*segment).generic_args = try_generic_args(mut_view(*parser), GENERIC_ARGS_FOLLOW_CALL_DOT);
        (*expr).kind = EXPR_PATH;
        (*expr).segments = segment;
    }
}

// Parses `()`, `(expr)` or `(a, b, ...)` after the opening parenthesis has been consumed.
fn parse_paren_or_tuple_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    unsafe {
        let saved_mode_on = parser.mode_on;
        let saved_no_struct = parser.no_struct;
        parser.mode_on = false;
        parser.no_struct = false;
        if consume(mut_view(*parser), TOK_RPAREN) {
            (*expr).kind = EXPR_TUPLE;
        } else {
            let inner = parse_expr(mut_view(*parser));
            if consume(mut_view(*parser), TOK_COMMA) {
                let mut elems = inner;
                while more_before(view(*parser), TOK_RPAREN) {
                    elems = link_expr(elems, parse_expr(mut_view(*parser)));
                    if !consume(mut_view(*parser), TOK_COMMA) {
                        break;
                    }
                }
                (*expr).kind = EXPR_TUPLE;
                (*expr).elems = elems;
            } else {
                (*expr).kind = EXPR_PAREN;
                (*expr).inner = inner;
            }
            expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
        }
        parser.mode_on = saved_mode_on;
        parser.no_struct = saved_no_struct;
    }
}

// Parses `[]`, `[a, b, ...]` or `[value; count]` after the opening bracket has been consumed.
fn parse_array_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    unsafe {
        let saved_mode_on = parser.mode_on;
        let saved_no_struct = parser.no_struct;
        parser.mode_on = false;
        parser.no_struct = false;
        (*expr).kind = EXPR_ARRAY;
        if !consume(mut_view(*parser), TOK_RBRACKET) {
            let mut first = parse_expr(mut_view(*parser));
            if consume(mut_view(*parser), TOK_SEMI) {
                (*expr).elems = first;
                (*expr).count_expr = parse_expr(mut_view(*parser));
            } else {
                if consume(mut_view(*parser), TOK_COMMA) {
                    while more_before(view(*parser), TOK_RBRACKET) {
                        first = link_expr(first, parse_expr(mut_view(*parser)));
                        if !consume(mut_view(*parser), TOK_COMMA) {
                            break;
                        }
                    }
                }
                (*expr).elems = first;
            }
            expect(mut_view(*parser), TOK_RBRACKET, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACKET);
        }
        parser.mode_on = saved_mode_on;
        parser.no_struct = saved_no_struct;
    }
}

// Parses the optional `let pattern =` of `if let` / `while let`.
fn parse_let_condition(parser: mut_view<Parser>, expr: *mut AstExpr) {
    if consume(mut_view(*parser), TOK_KW_LET) {
        unsafe {
            (*expr).let_pat = parse_pattern(mut_view(*parser));
        }
        expect(mut_view(*parser), TOK_EQ, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_EQ);
    }
}

// Parses `if cond { } else ...` after `if` has been consumed.
fn parse_if_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    unsafe {
        (*expr).kind = EXPR_IF;
        parse_let_condition(mut_view(*parser), expr);
        (*expr).cond = parse_header_expr(mut_view(*parser));
        (*expr).block = parse_block(mut_view(*parser));
        if consume(mut_view(*parser), TOK_KW_ELSE) {
            if check(view(*parser), TOK_KW_IF) {
                (*expr).else_branch = parse_expr(mut_view(*parser));
            } else {
                let else_block = alloc_expr(parser.arena, EXPR_BLOCK, peek_span(view(*parser)));
                (*else_block).block = parse_block(mut_view(*parser));
                (*expr).else_branch = else_block;
            }
        }
    }
}

// Parses `match scrutinee { pattern if guard => body, ... }` after `match` has been consumed.
fn parse_match_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    unsafe {
        (*expr).kind = EXPR_MATCH;
        (*expr).cond = parse_header_expr(mut_view(*parser));
        expect(mut_view(*parser), TOK_LBRACE, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LBRACE);
        while more_before(view(*parser), TOK_RBRACE) {
            let arm = alloc_match_arm(parser.arena, peek_span(view(*parser)));
            (*arm).pat = parse_pattern(mut_view(*parser));
            if consume(mut_view(*parser), TOK_KW_IF) {
                (*arm).guard = parse_expr(mut_view(*parser));
            }
            expect(mut_view(*parser), TOK_FAT_ARROW, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_FAT_ARROW);
            (*arm).body = parse_expr(mut_view(*parser));
            (*expr).arms = link_match_arm((*expr).arms, arm);
            consume(mut_view(*parser), TOK_COMMA);
        }
        expect(mut_view(*parser), TOK_RBRACE, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACE);
    }
}

// Parses `return`, `break` or `continue` (with optional label and value) after the keyword has been consumed.
fn parse_jump_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    unsafe {
        let previous_kind = peek_prev_kind(view(*parser), 1);
        (*expr).kind = EXPR_JUMP;
        (*expr).jump_kind = jump_kind_for_token(previous_kind);
        if previous_kind != TOK_KW_RETURN && check(view(*parser), TOK_LABEL) &&
                !token_follows_newline(view(*parser)) {
            (*expr).label.v = peek_ident(view(*parser)).v;
            advance(mut_view(*parser));
        }
        if previous_kind != TOK_KW_CONTINUE && !line_break_before(view(*parser)) {
            let next_kind = peek_kind(view(*parser));
            if next_kind != TOK_SEMI && next_kind != TOK_RBRACE && next_kind != TOK_EOF {
                (*expr).inner = parse_expr(mut_view(*parser));
            }
        }
    }
}

// Parses a closure `|a: T, b| body` or `|| body` after the opening `|` or `||` has been consumed.
fn parse_closure_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    unsafe {
        (*expr).kind = EXPR_CLOSURE;
        if peek_prev_kind(view(*parser), 1) == TOK_PIPE {
            while more_before(view(*parser), TOK_PIPE) {
                let param = alloc_param(parser.arena, peek_span(view(*parser)));
                if consume(mut_view(*parser), TOK_KW_MUT) {
                    (*param).is_mut = true;
                }
                if !consume(mut_view(*parser), TOK_UNDERSCORE) {
                    (*param).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_PARAM_NAME).v;
                }
                if consume(mut_view(*parser), TOK_COLON) {
                    (*param).ty = parse_type(mut_view(*parser));
                }
                (*expr).params = link_param((*expr).params, param);
                if !consume(mut_view(*parser), TOK_COMMA) {
                    break;
                }
            }
            expect(mut_view(*parser), TOK_PIPE, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_PIPE);
        }
        if consume(mut_view(*parser), TOK_ARROW) {
            (*expr).ret_type = parse_type(mut_view(*parser));
            let body_block = alloc_expr(parser.arena, EXPR_BLOCK, peek_span(view(*parser)));
            (*body_block).block = parse_block(mut_view(*parser));
            (*expr).body = body_block;
        } else {
            (*expr).body = parse_expr_prec(mut_view(*parser), PREC_LOWEST);
        }
    }
}

// Parses `view(expr)` or `mut_view(expr)`.
fn parse_view_expr(parser: mut_view<Parser>, expr: *mut AstExpr) {
    unsafe {
        (*expr).kind = EXPR_VIEW;
        (*expr).is_mut = check(view(*parser), TOK_KW_MUT_VIEW);
        advance(mut_view(*parser));
        expect(mut_view(*parser), TOK_LPAREN, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LPAREN);
        (*expr).inner = parse_expr(mut_view(*parser));
        expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
    }
}

// Parses `loop`, `while` and `for` expressions; returns false when no loop keyword (or label) is next.
fn parse_loop_expr(parser: mut_view<Parser>, expr: *mut AstExpr) -> bool {
    unsafe {
        if consume_loop_head(mut_view(*parser), TOK_KW_LOOP, expr) {
            (*expr).kind = EXPR_LOOP;
            (*expr).block = parse_block(mut_view(*parser));
            return true;
        }
        if consume_loop_head(mut_view(*parser), TOK_KW_WHILE, expr) {
            parse_let_condition(mut_view(*parser), expr);
            (*expr).kind = EXPR_WHILE;
            (*expr).cond = parse_header_expr(mut_view(*parser));
            (*expr).block = parse_block(mut_view(*parser));
            return true;
        }
        if consume_loop_head(mut_view(*parser), TOK_KW_FOR, expr) {
            (*expr).kind = EXPR_FOR;
            (*expr).pat = parse_pattern(mut_view(*parser));
            expect(mut_view(*parser), TOK_KW_IN, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_KW_IN);
            (*expr).iter = parse_header_expr(mut_view(*parser));
            (*expr).block = parse_block(mut_view(*parser));
            return true;
        }
    }
    false
}

// Parses `move` / `yield`: reserved keywords that are reported and otherwise skipped.
fn parse_reserved_keyword_expr(parser: mut_view<Parser>, kind: u8) {
    let span = peek_span(view(*parser));
    advance(mut_view(*parser));
    if kind == TOK_KW_MOVE {
        report(mut_view(*parser), span, AX_PARSE_RESERVED_KEYWORD, MSG_RESERVED_MOVE);
        if check(view(*parser), TOK_PIPE_PIPE) || check(view(*parser), TOK_PIPE) {
            parse_primary(mut_view(*parser));
        }
    } else {
        report(mut_view(*parser), span, AX_PARSE_RESERVED_KEYWORD, MSG_RESERVED_YIELD);
    }
}

// Parses a primary expression: operators, literals, paths, struct literals, brackets, control flow and closures.
fn parse_primary(parser: mut_view<Parser>) -> *mut AstExpr {
    let expr = alloc_expr(parser.arena, EXPR_ERROR, peek_span(view(*parser)));
    let token = peek_ptr(view(*parser)) as *const Token;
    let kind = unsafe { (*token).kind };
    if kind == TOK_MINUS || kind == TOK_BANG || kind == TOK_TILDE || kind == TOK_STAR {
        parse_unary_expr(mut_view(*parser), expr, kind);
    } else if is_literal_start_kind(kind) {
        advance(mut_view(*parser));
        unsafe {
            (*expr).kind = EXPR_LITERAL;
            copy_token_into(mut_view((*expr).literal), token);
        }
    } else if kind == TOK_DOT_DOT || kind == TOK_DOT_DOT_EQ {
        parse_prefix_range_expr(mut_view(*parser), expr, kind);
    } else if check_ident_or_self(view(*parser)) {
        parse_path_or_struct_expr(mut_view(*parser), expr);
    } else if consume(mut_view(*parser), TOK_LPAREN) {
        parse_paren_or_tuple_expr(mut_view(*parser), expr);
    } else if consume(mut_view(*parser), TOK_LBRACKET) {
        parse_array_expr(mut_view(*parser), expr);
    } else if check(view(*parser), TOK_LBRACE) {
        unsafe {
            (*expr).kind = EXPR_BLOCK;
            (*expr).block = parse_block(mut_view(*parser));
        }
    } else if consume(mut_view(*parser), TOK_KW_IF) {
        parse_if_expr(mut_view(*parser), expr);
    } else if consume(mut_view(*parser), TOK_KW_MATCH) {
        parse_match_expr(mut_view(*parser), expr);
    } else if parse_loop_expr(mut_view(*parser), expr) {
        // `loop`, `while` and `for` are fully handled by parse_loop_expr.
    } else if consume(mut_view(*parser), TOK_KW_UNSAFE) {
        unsafe {
            (*expr).kind = EXPR_UNSAFE;
            (*expr).block = parse_block(mut_view(*parser));
        }
    } else if check(view(*parser), TOK_KW_VIEW) || check(view(*parser), TOK_KW_MUT_VIEW) {
        parse_view_expr(mut_view(*parser), expr);
    } else if consume(mut_view(*parser), TOK_KW_COMPTIME) {
        unsafe {
            (*expr).kind = EXPR_COMPTIME;
            (*expr).block = parse_block(mut_view(*parser));
        }
    } else if consume(mut_view(*parser), TOK_KW_RETURN) || consume(mut_view(*parser), TOK_KW_BREAK) ||
            consume(mut_view(*parser), TOK_KW_CONTINUE) {
        parse_jump_expr(mut_view(*parser), expr);
    } else if kind == TOK_KW_MOVE || kind == TOK_KW_YIELD {
        parse_reserved_keyword_expr(mut_view(*parser), kind);
    } else if consume(mut_view(*parser), TOK_PIPE_PIPE) || consume(mut_view(*parser), TOK_PIPE) {
        parse_closure_expr(mut_view(*parser), expr);
    } else {
        let token_span = unsafe { ast_copy_span((*token).span) };
        report(mut_view(*parser), token_span, AX_PARSE_EXPECTED_EXPR, MSG_EXPECTED_EXPRESSION);
        advance(mut_view(*parser));
    }
    expr
}

// Wraps `left` into a postfix expression node carrying `segment`.
fn wrap_postfix(parser: mut_view<Parser>, left: *mut AstExpr, segment: *mut AstPostfixSeg) -> *mut AstExpr {
    let postfix_expr = alloc_expr(parser.arena, EXPR_POSTFIX, unsafe { (*left).span });
    unsafe {
        (*postfix_expr).head = left;
        (*postfix_expr).postfix_segs = segment;
    }
    postfix_expr
}

// Parses `.field`, `.method<T>`, `.await` or `.0` after the cursor reached the `.`.  Returns null (after
// reporting an error) when no name or index follows.
fn parse_dot_suffix(parser: mut_view<Parser>, left: *mut AstExpr) -> *mut AstExpr {
    advance(mut_view(*parser));
    unsafe {
        if check(view(*parser), TOK_IDENT) {
            let ident = peek_ident(view(*parser));
            let segment = alloc_postfix_seg(parser.arena, POSTFIX_FIELD, (*left).span);
            if ident_equals_text(view(*parser.interner), ident.v, LIT_AWAIT) {
                (*segment).kind = POSTFIX_AWAIT;
                advance(mut_view(*parser));
            } else {
                (*segment).name.v = ident.v;
                advance(mut_view(*parser));
                if check(view(*parser), TOK_LT) {
                    // `.method<T>(...)`: only a generic list directly followed by `(` belongs to the call.
                    let saved_pos = parser.pos;
                    let generic_args = parse_generic_args(mut_view(*parser));
                    if check(view(*parser), TOK_LPAREN) {
                        (*segment).generic_args = generic_args;
                    } else {
                        parser.pos = saved_pos;
                    }
                }
            }
            return wrap_postfix(mut_view(*parser), left, segment);
        }
        if check(view(*parser), TOK_INT) {
            let segment = alloc_postfix_seg(parser.arena, POSTFIX_TUPLE_INDEX, (*left).span);
            (*segment).tuple_index = (*peek_ptr(view(*parser))).int_val as u32;
            advance(mut_view(*parser));
            return wrap_postfix(mut_view(*parser), left, segment);
        }
    }
    report_here(mut_view(*parser), AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_FIELD_OR_METHOD_NAME);
    0 as *mut AstExpr
}

// Parses a call `(args)` suffix.
fn parse_call_suffix(parser: mut_view<Parser>, left: *mut AstExpr) -> *mut AstExpr {
    advance(mut_view(*parser));
    unsafe {
        let segment = alloc_postfix_seg(parser.arena, POSTFIX_CALL, (*left).span);
        let saved_mode_on = parser.mode_on;
        parser.mode_on = false;
        while more_before(view(*parser), TOK_RPAREN) {
            (*segment).args = link_expr((*segment).args, parse_expr(mut_view(*parser)));
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
        parser.mode_on = saved_mode_on;
        expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
        wrap_postfix(mut_view(*parser), left, segment)
    }
}

// Parses an index `[expr]` suffix.
fn parse_index_suffix(parser: mut_view<Parser>, left: *mut AstExpr) -> *mut AstExpr {
    advance(mut_view(*parser));
    unsafe {
        let segment = alloc_postfix_seg(parser.arena, POSTFIX_INDEX, (*left).span);
        let saved_mode_on = parser.mode_on;
        parser.mode_on = false;
        (*segment).index_arg = parse_expr(mut_view(*parser));
        parser.mode_on = saved_mode_on;
        expect(mut_view(*parser), TOK_RBRACKET, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACKET);
        wrap_postfix(mut_view(*parser), left, segment)
    }
}

// Parses a `?` suffix.
fn parse_try_suffix(parser: mut_view<Parser>, left: *mut AstExpr) -> *mut AstExpr {
    advance(mut_view(*parser));
    let segment = alloc_postfix_seg(parser.arena, POSTFIX_TRY, unsafe { (*left).span });
    wrap_postfix(mut_view(*parser), left, segment)
}

// Parses an `->name` suffix.
fn parse_arrow_suffix(parser: mut_view<Parser>, left: *mut AstExpr) -> *mut AstExpr {
    advance(mut_view(*parser));
    unsafe {
        let segment = alloc_postfix_seg(parser.arena, POSTFIX_ARROW, (*left).span);
        (*segment).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_IDENTIFIER_AFTER_ARROW).v;
        wrap_postfix(mut_view(*parser), left, segment)
    }
}

// Parses an `as Type` cast.
fn parse_cast_suffix(parser: mut_view<Parser>, left: *mut AstExpr) -> *mut AstExpr {
    advance(mut_view(*parser));
    unsafe {
        let cast_expr = alloc_expr(parser.arena, EXPR_CAST, (*left).span);
        let saved_type_tentative = parser.type_tentative;
        parser.type_tentative = true;
        (*cast_expr).inner = left;
        (*cast_expr).cast_ty = parse_type(mut_view(*parser));
        parser.type_tentative = saved_type_tentative;
        cast_expr
    }
}

// Parses the right operand of a binary operator or range whose operator token is the current token.
fn parse_binary_suffix(
    parser: mut_view<Parser>,
    left: *mut AstExpr,
    token_kind: u8,
    prec: i32,
    previous_was_comparison: bool,
    operator_span: Span
) -> *mut AstExpr {
    advance(mut_view(*parser));
    unsafe {
        let binary = alloc_expr(parser.arena, EXPR_BINARY, (*left).span);
        if token_kind == TOK_DOT_DOT || token_kind == TOK_DOT_DOT_EQ {
            (*binary).kind = EXPR_RANGE;
            (*binary).start_expr = left;
            (*binary).is_inclusive = token_kind == TOK_DOT_DOT_EQ;
            if !is_range_end(peek_kind(view(*parser))) {
                (*binary).end_expr = parse_expr_prec(mut_view(*parser), PREC_LOGICAL_OR);
            }
        } else {
            if prec == PREC_COMPARISON && previous_was_comparison {
                report(mut_view(*parser), operator_span, AX_PARSE_CHAINED_COMPARISON, MSG_CHAINED_COMPARISON);
            }
            (*binary).left = left;
            (*binary).op = binary_op_for_token(token_kind);
            (*binary).right = parse_expr_prec(mut_view(*parser), prec - 1);
        }
        binary
    }
}

// Pratt loop: parses an expression whose operators all bind at least as tight as `min_prec`.
fn parse_expr_prec(parser: mut_view<Parser>, min_prec: i32) -> *mut AstExpr {
    let mut left = parse_primary(mut_view(*parser));
    let mut left_is_comparison = false;
    while true {
        let token_kind = peek_kind(view(*parser));
        let prec = infix_prec(token_kind);
        if prec == 0 || prec > min_prec {
            break;
        }
        let previous_was_comparison = left_is_comparison;
        left_is_comparison = false;
        let operator_span = peek_span(view(*parser));
        if line_break_before(view(*parser)) && token_kind != TOK_DOT {
            break;
        }
        if token_kind == TOK_DOT {
            let suffixed = parse_dot_suffix(mut_view(*parser), left);
            if suffixed as usize == 0 {
                break;
            }
            left = suffixed;
        } else if token_kind == TOK_LPAREN {
            left = parse_call_suffix(mut_view(*parser), left);
        } else if token_kind == TOK_LBRACKET {
            left = parse_index_suffix(mut_view(*parser), left);
        } else if token_kind == TOK_QUESTION {
            left = parse_try_suffix(mut_view(*parser), left);
        } else if token_kind == TOK_ARROW {
            left = parse_arrow_suffix(mut_view(*parser), left);
        } else if token_kind == TOK_KW_AS {
            left = parse_cast_suffix(mut_view(*parser), left);
        } else {
            left = parse_binary_suffix(
                mut_view(*parser),
                left,
                token_kind,
                prec,
                previous_was_comparison,
                operator_span
            );
            left_is_comparison = unsafe { (*left).kind == EXPR_BINARY } && prec == PREC_COMPARISON;
        }
    }
    left
}

// Parses a full expression.
fn parse_expr(parser: mut_view<Parser>) -> *mut AstExpr {
    parse_expr_prec(parser, PREC_LOWEST)
}

// Parses the condition of `if`/`while`/`match`/`for`, where `Name {` is not a struct literal.
fn parse_header_expr(parser: mut_view<Parser>) -> *mut AstExpr {
    let saved_no_struct = parser.no_struct;
    parser.no_struct = true;
    let expr = parse_expr(mut_view(*parser));
    parser.no_struct = saved_no_struct;
    expr
}

// Parses `{ statements }`.
fn parse_block(parser: mut_view<Parser>) -> *mut AstBlock {
    let block = alloc_block(parser.arena, peek_span(view(*parser)));
    expect(mut_view(*parser), TOK_LBRACE, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LBRACE);
    while more_before(view(*parser), TOK_RBRACE) {
        let statement = parse_stmt(mut_view(*parser));
        unsafe {
            (*block).stmts = link_stmt((*block).stmts, statement);
        }
    }
    expect(mut_view(*parser), TOK_RBRACE, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACE);
    block
}

// Parses function parameters up to `)`.
fn parse_params(parser: mut_view<Parser>) -> *mut AstParam {
    let mut head = 0 as *mut AstParam;
    unsafe {
        while more_before(view(*parser), TOK_RPAREN) {
            let param = alloc_param(parser.arena, peek_span(view(*parser)));
            if consume(mut_view(*parser), TOK_KW_MUT) {
                (*param).is_mut = true;
            }
            if check(view(*parser), TOK_KW_SELF_VALUE) {
                (*param).name.v = intern_text(mut_view(*parser), LIT_SELF_VALUE).v;
                advance(mut_view(*parser));
            } else if !consume(mut_view(*parser), TOK_UNDERSCORE) {
                (*param).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_PARAM_NAME).v;
            }
            expect(mut_view(*parser), TOK_COLON, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_COLON);
            (*param).ty = parse_type(mut_view(*parser));
            head = link_param(head, param);
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
    }
    head
}

// True when a statement starts with a keyword that begins an item (items are not allowed inside blocks).
fn is_item_keyword(kind: u8, next_kind: u8) -> bool {
    if kind == TOK_KW_UNSAFE {
        return next_kind == TOK_KW_FN || next_kind == TOK_KW_EXTERN || next_kind == TOK_KW_TRAIT;
    }
    kind == TOK_KW_FN || kind == TOK_KW_STRUCT || kind == TOK_KW_ENUM || kind == TOK_KW_TRAIT ||
        kind == TOK_KW_IMPL || kind == TOK_KW_TYPE || kind == TOK_KW_CONST || kind == TOK_KW_STATIC ||
        kind == TOK_KW_USE || kind == TOK_KW_MODULE || kind == TOK_KW_EXTERN || kind == TOK_KW_PUB ||
        kind == TOK_KW_ASYNC
}

// Parses one statement: `let`, assignment, expression, or an item (reported as an error).
fn parse_stmt(parser: mut_view<Parser>) -> *mut AstStmt {
    let stmt = alloc_stmt(parser.arena, STMT_ERROR, peek_span(view(*parser)));
    unsafe {
        if consume(mut_view(*parser), TOK_SEMI) {
            (*stmt).kind = STMT_EXPR;
            (*stmt).expr = alloc_expr(parser.arena, EXPR_ERROR,
                    empty_span());
            (*stmt).has_semi = true;
            return stmt;
        }
        let kind = peek_kind(view(*parser));
        let ident = peek_ident(view(*parser));
        let next_kind = peek_nth_kind(view(*parser), 1);
        if kind == TOK_IDENT && ident_equals_text(view(*parser.interner), ident.v, LIT_IMPORT) {
            report_here(mut_view(*parser), AX_PARSE_IMPORT, MSG_IMPORT_NOT_KEYWORD);
            advance(mut_view(*parser));
            skip_to_terminator(mut_view(*parser));
        } else if kind == TOK_IDENT && ident_equals_text(view(*parser.interner), ident.v, LIT_VAR) {
            report_here(mut_view(*parser), AX_PARSE_VAR, MSG_REPLACE_VAR);
            advance(mut_view(*parser));
            (*stmt).kind = STMT_LET;
            (*stmt).pat = parse_pattern(mut_view(*parser));
            if consume(mut_view(*parser), TOK_COLON) {
                (*stmt).ty = parse_type(mut_view(*parser));
            }
            if consume(mut_view(*parser), TOK_EQ) {
                (*stmt).expr = parse_expr(mut_view(*parser));
            }
        } else if consume(mut_view(*parser), TOK_KW_LET) {
            (*stmt).kind = STMT_LET;
            (*stmt).pat = parse_pattern(mut_view(*parser));
            if consume(mut_view(*parser), TOK_COLON) {
                (*stmt).ty = parse_type(mut_view(*parser));
            }
            if consume(mut_view(*parser), TOK_EQ) {
                (*stmt).expr = parse_expr(mut_view(*parser));
                if consume(mut_view(*parser), TOK_KW_ELSE) {
                    (*stmt).else_block = parse_block(mut_view(*parser));
                }
            }
        } else if is_item_keyword(kind, next_kind) {
            report_here(mut_view(*parser), AX_PARSE_ITEM_IN_BLOCK, MSG_ITEM_IN_BLOCK);
            parse_item(mut_view(*parser));
            return stmt;
        } else {
            if is_leading_operator_kind(kind) {
                report_here(mut_view(*parser), AX_PARSE_LEADING_OPERATOR, MSG_LEADING_OPERATOR);
                advance(mut_view(*parser));
            }
            let expr = parse_expr(mut_view(*parser));
            let token_kind = peek_kind(view(*parser));
            if token_kind >= TOK_EQ && token_kind <= TOK_SHR_EQ && !line_break_before(view(*parser)) {
                advance(mut_view(*parser));
                (*stmt).kind = STMT_ASSIGN;
                (*stmt).op = token_kind - TOK_EQ;
                (*stmt).left = expr;
                (*stmt).right = parse_expr(mut_view(*parser));
                consume(mut_view(*parser), TOK_SEMI);
            } else {
                (*stmt).kind = STMT_EXPR;
                (*stmt).expr = expr;
                (*stmt).has_semi = consume(mut_view(*parser), TOK_SEMI);
            }
        }
    }
    skip_to_terminator(mut_view(*parser));
    consume(mut_view(*parser), TOK_SEMI);
    stmt
}

// Parses `<T: Bound, U>`; returns null when no `<` follows.
fn parse_generic_params(parser: mut_view<Parser>) -> *mut AstGenericParams {
    if !check(view(*parser), TOK_LT) {
        return 0 as *mut AstGenericParams;
    }
    let params = alloc_generic_params(parser.arena, peek_span(view(*parser)));
    advance(mut_view(*parser));
    let saved_mode_on = parser.mode_on;
    parser.mode_on = false;
    unsafe {
        while more_before(view(*parser), TOK_GT) {
            let param = alloc_generic_param(parser.arena, peek_span(view(*parser)));
            (*param).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_GENERIC_PARAM_NAME).v;
            if consume(mut_view(*parser), TOK_COLON) {
                (*param).bounds = parse_bounds(mut_view(*parser));
            }
            (*params).params = link_generic_param((*params).params, param);
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
    }
    expect(mut_view(*parser), TOK_GT, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_GT);
    parser.mode_on = saved_mode_on;
    params
}

// Parses `where T: Bound, ...`.
fn parse_where_clause(parser: mut_view<Parser>) -> *mut AstWhereClause {
    if !consume(mut_view(*parser), TOK_KW_WHERE) {
        return 0 as *mut AstWhereClause;
    }
    let where_clause = alloc_where_clause(parser.arena, peek_prev_span(view(*parser), 1));
    unsafe {
        while !check(view(*parser), TOK_LBRACE) && more_before(view(*parser), TOK_SEMI) {
            let pred = alloc_where_pred(parser.arena, peek_span(view(*parser)));
            (*pred).ty = parse_type(mut_view(*parser));
            expect(mut_view(*parser), TOK_COLON, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_COLON);
            (*pred).bounds = parse_bounds(mut_view(*parser));
            (*where_clause).preds = link_where_pred((*where_clause).preds, pred);
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
    }
    where_clause
}

// Parses any number of `@name(args)` attributes.
fn parse_attributes(parser: mut_view<Parser>) -> *mut AstAttr {
    let mut head = 0 as *mut AstAttr;
    unsafe {
        while consume(mut_view(*parser), TOK_AT) {
            let attr = alloc_attr(parser.arena, peek_prev_span(view(*parser), 1));
            (*attr).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_ATTRIBUTE_NAME).v;
            if check(view(*parser), TOK_LPAREN) && !token_follows_newline(view(*parser)) {
                advance(mut_view(*parser));
                let saved_mode_on = parser.mode_on;
                parser.mode_on = false;
                while more_before(view(*parser), TOK_RPAREN) {
                    let arg = alloc_attr_arg(parser.arena, peek_span(view(*parser)));
                    if check(view(*parser), TOK_IDENT) && peek_nth_kind(view(*parser), 1) == TOK_EQ {
                        (*arg).name.v = peek_ident(view(*parser)).v;
                        advance(mut_view(*parser));
                        advance(mut_view(*parser));
                    }
                    (*arg).expr = parse_expr(mut_view(*parser));
                    (*attr).args = link_attr_arg((*attr).args, arg);
                    if !consume(mut_view(*parser), TOK_COMMA) {
                        break;
                    }
                }
                parser.mode_on = saved_mode_on;
                expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
            }
            head = link_attr(head, attr);
        }
    }
    head
}

// Parses `pub`, `pub(package)` or `pub(module)` into `dst`.
fn parse_visibility_into(parser: mut_view<Parser>, dst: mut_view<AstVis>) {
    ast_set_span(mut_view(dst.span), peek_span(view(*parser)));
    dst.kind = VIS_PRIVATE;
    if consume(mut_view(*parser), TOK_KW_PUB) {
        dst.kind = VIS_PUB;
        if check(view(*parser), TOK_LPAREN) && !token_follows_newline(view(*parser)) {
            let saved_pos = parser.pos;
            advance(mut_view(*parser));
            if check(view(*parser), TOK_IDENT) {
                let ident = peek_ident(view(*parser));
                if ident_equals_text(unsafe { view(*parser.interner) }, ident.v, LIT_PACKAGE) {
                    advance(mut_view(*parser));
                    if consume(mut_view(*parser), TOK_RPAREN) {
                        dst.kind = VIS_PUB_PACKAGE;
                        return;
                    }
                } else if ident_equals_text(unsafe { view(*parser.interner) }, ident.v, LIT_MODULE) {
                    advance(mut_view(*parser));
                    if consume(mut_view(*parser), TOK_RPAREN) {
                        dst.kind = VIS_PUB_MODULE;
                        return;
                    }
                }
            }
            parser.pos = saved_pos;
        }
    }
}

// Parses struct or variant fields up to the closing brace.
fn parse_field_decls(parser: mut_view<Parser>, allow_vis: bool) -> *mut AstFieldDecl {
    let mut head = 0 as *mut AstFieldDecl;
    unsafe {
        while more_before(view(*parser), TOK_RBRACE) {
            let field_decl = alloc_field_decl(parser.arena, peek_span(view(*parser)));
            (*field_decl).attrs = parse_attributes(mut_view(*parser));
            if allow_vis {
                parse_visibility_into(mut_view(*parser), mut_view((*field_decl).vis));
            }
            (*field_decl).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_FIELD_NAME).v;
            expect(mut_view(*parser), TOK_COLON, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_COLON);
            (*field_decl).ty = parse_type(mut_view(*parser));
            head = link_field_decl(head, field_decl);
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
    }
    expect(mut_view(*parser), TOK_RBRACE, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACE);
    head
}

// Parses the items of a trait, impl or extern block up to the closing brace.
fn parse_member_items(parser: mut_view<Parser>, bodiless: bool) -> *mut AstItem {
    let mut head = 0 as *mut AstItem;
    let saved_allow_bodiless = parser.allow_bodiless_fn;
    parser.allow_bodiless_fn = bodiless;
    while more_before(view(*parser), TOK_RBRACE) {
        head = link_item(head, parse_item(mut_view(*parser)));
    }
    parser.allow_bodiless_fn = saved_allow_bodiless;
    expect(mut_view(*parser), TOK_RBRACE, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACE);
    head
}

// Lexes and parses `text` (generated derive code) with the current parser configuration.
fn parse_synthetic_item(parser: mut_view<Parser>, text: StrView) -> *mut AstItem {
    let mut lex_result = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    ax_lex_into(FileId { v: 0u32 }, text, unsafe { mut_view(*parser.sink) }, unsafe { mut_view(*parser.interner) },
        mut_view(lex_result));
    let mut sub_parser = Parser {
        arena: parser.arena,
        tokens: lex_result.tokens,
        count: lex_result.token_count,
        pos: 0,
        sink: parser.sink,
        interner: parser.interner,
        mode_on: parser.mode_on,
        no_struct: parser.no_struct,
        type_tentative: parser.type_tentative,
        allow_bodiless_fn: parser.allow_bodiless_fn,
        tentative: parser.tentative,
        tentative_failed: parser.tentative_failed,
        split_len: 0,
        split_indices: parser.split_indices,
        split_tokens: parser.split_tokens,
    };
    let item = parse_item(mut_view(sub_parser));
    ax_lex_result_free(mut_view(lex_result));
    item
}

// Appends text-table entry `text_index` to `buffer`.
fn push_text(buffer: mut_view<DiagBuffer>, text_index: usize) {
    let end = PARSE_OFF[text_index + 1] as usize;
    let mut i = PARSE_OFF[text_index] as usize;
    while i < end {
        diag_buf_push_byte(mut_view(*buffer), PARSE_DATA[i]);
        i = i + 1;
    }
}

// Appends the interned name `name_value` to `buffer`.
fn push_name(buffer: mut_view<DiagBuffer>, interner: view<StrInterner>, name_value: u32) {
    if name_value == 0u32 {
        return;
    }
    let text = interner_get(interner, StrId { v: name_value });
    diag_buf_push_bytes(buffer, text.ptr, text.len);
}

// Generated `impl Copy for Name {}` / `impl Eq for Name {}` (a marker trait with an empty body).
fn format_marker_derive(
    interner: view<StrInterner>,
    impl_text: usize,
    name: u32,
    buffer: mut_view<DiagBuffer>
) {
    push_text(mut_view(*buffer), impl_text);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_EMPTY_BODY);
}

// Generated `impl Clone`: `Name { field: self.field.clone(), ... }` for plain structs, an empty body otherwise.
fn format_clone_derive(
    interner: view<StrInterner>,
    name: u32,
    first_field: *const AstFieldDecl,
    is_plain_struct: bool,
    buffer: mut_view<DiagBuffer>
) {
    push_text(mut_view(*buffer), DERIVE_IMPL_CLONE);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_CLONE_SIGNATURE);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_RETURNS);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_OPEN_BODY);
    if is_plain_struct {
        push_name(mut_view(*buffer), interner, name);
        push_text(mut_view(*buffer), DERIVE_OPEN_BODY);
        let mut field = first_field;
        while field as usize != 0 {
            let field_name = unsafe { (*field).name };
            push_name(mut_view(*buffer), interner, field_name.v);
            push_text(mut_view(*buffer), DERIVE_FIELD_SELF);
            push_name(mut_view(*buffer), interner, field_name.v);
            push_text(mut_view(*buffer), DERIVE_FIELD_CLONE);
            field = unsafe { (*field).next as *const AstFieldDecl };
        }
        push_text(mut_view(*buffer), DERIVE_CLOSE_BRACE);
    }
    push_text(mut_view(*buffer), DERIVE_CLOSE_BODY_AND_IMPL);
}

// Generated `impl PartialEq`: `self.a == other.a && self.b == other.b`, or `true` without fields.
fn format_partial_eq_derive(
    interner: view<StrInterner>,
    name: u32,
    first_field: *const AstFieldDecl,
    buffer: mut_view<DiagBuffer>
) {
    push_text(mut_view(*buffer), DERIVE_IMPL_PARTIAL_EQ);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_EQ_SIGNATURE);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_EQ_OTHER);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_EQ_RETURNS_BOOL);
    if first_field as usize == 0 {
        push_text(mut_view(*buffer), DERIVE_TRUE);
    } else {
        let mut field = first_field;
        while field as usize != 0 {
            let field_name = unsafe { (*field).name };
            push_text(mut_view(*buffer), DERIVE_SELF_DOT);
            push_name(mut_view(*buffer), interner, field_name.v);
            push_text(mut_view(*buffer), DERIVE_EQUALS_OTHER_DOT);
            push_name(mut_view(*buffer), interner, field_name.v);
            if unsafe { (*field).next as usize } != 0 {
                push_text(mut_view(*buffer), DERIVE_AND);
            }
            field = unsafe { (*field).next as *const AstFieldDecl };
        }
    }
    push_text(mut_view(*buffer), DERIVE_CLOSE_BODY_AND_IMPL);
}

// Generated `impl Hash`: `self.a.hash(state); self.b.hash(state);`.
fn format_hash_derive(
    interner: view<StrInterner>,
    name: u32,
    first_field: *const AstFieldDecl,
    buffer: mut_view<DiagBuffer>
) {
    push_text(mut_view(*buffer), DERIVE_IMPL_HASH);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_HASH_SIGNATURE);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_HASH_STATE);
    let mut field = first_field;
    while field as usize != 0 {
        let field_name = unsafe { (*field).name };
        push_text(mut_view(*buffer), DERIVE_SELF_DOT);
        push_name(mut_view(*buffer), interner, field_name.v);
        push_text(mut_view(*buffer), DERIVE_DOT_HASH);
        field = unsafe { (*field).next as *const AstFieldDecl };
    }
    push_text(mut_view(*buffer), DERIVE_CLOSE_BODY_AND_IMPL);
}

// Generated `impl Ord`: compares the fields in order and returns the first non-equal result.
fn format_ord_derive(
    interner: view<StrInterner>,
    name: u32,
    first_field: *const AstFieldDecl,
    buffer: mut_view<DiagBuffer>
) {
    push_text(mut_view(*buffer), DERIVE_IMPL_ORD);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_ORD_SIGNATURE);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_EQ_OTHER);
    push_name(mut_view(*buffer), interner, name);
    push_text(mut_view(*buffer), DERIVE_ORD_RETURNS);
    let mut field = first_field;
    while field as usize != 0 {
        let field_name = unsafe { (*field).name };
        push_text(mut_view(*buffer), DERIVE_ORD_LET);
        push_name(mut_view(*buffer), interner, field_name.v);
        push_text(mut_view(*buffer), DERIVE_ORD_CMP);
        push_name(mut_view(*buffer), interner, field_name.v);
        push_text(mut_view(*buffer), DERIVE_ORD_MATCH);
        field = unsafe { (*field).next as *const AstFieldDecl };
    }
    push_text(mut_view(*buffer), DERIVE_ORD_EQUAL);
    push_text(mut_view(*buffer), DERIVE_ORD_END);
}

// Writes the source text of `impl <trait> for <item>` for one derivable trait.  Returns false for traits
// that cannot be derived.  Enums and tuple structs have no named fields, so their generated bodies are empty.
fn format_derive(
    interner: view<StrInterner>,
    item: *const AstItem,
    trait_name: StrId,
    buffer: mut_view<DiagBuffer>
) -> bool {
    let name = unsafe { (*item).name };
    let first_field = unsafe { (*item).struct_fields as *const AstFieldDecl };
    let is_plain_struct = unsafe { (*item).kind == ITEM_STRUCT && !(*item).is_tuple };
    if ident_equals_text(interner, trait_name.v, LIT_TRAIT_COPY) {
        format_marker_derive(interner, DERIVE_IMPL_COPY, name.v, mut_view(*buffer));
    } else if ident_equals_text(interner, trait_name.v, LIT_TRAIT_EQ) {
        format_marker_derive(interner, DERIVE_IMPL_EQ, name.v, mut_view(*buffer));
    } else if ident_equals_text(interner, trait_name.v, LIT_TRAIT_CLONE) {
        format_clone_derive(interner, name.v, first_field, is_plain_struct, mut_view(*buffer));
    } else if ident_equals_text(interner, trait_name.v, LIT_TRAIT_PARTIAL_EQ) {
        format_partial_eq_derive(interner, name.v, first_field, mut_view(*buffer));
    } else if ident_equals_text(interner, trait_name.v, LIT_TRAIT_HASH) {
        format_hash_derive(interner, name.v, first_field, mut_view(*buffer));
    } else if ident_equals_text(interner, trait_name.v, LIT_TRAIT_ORD) {
        format_ord_derive(interner, name.v, first_field, mut_view(*buffer));
    } else {
        return false;
    }
    true
}

// Appends the generated `impl` items for every `@derive(...)` attribute of a struct or enum.
fn expand_derives(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        let item_kind = (*item).kind;
        if item_kind != ITEM_STRUCT && item_kind != ITEM_ENUM {
            return;
        }
        let mut attr = (*item).attrs as *mut AstAttr;
        while attr as usize != 0 {
            if ident_equals_text(view(*parser.interner), (*attr).name.v, LIT_DERIVE) {
                let mut arg = (*attr).args as *mut AstAttrArg;
                while arg as usize != 0 {
                    let argument_expr = (*arg).expr as *mut AstExpr;
                    if argument_expr as usize != 0 && (*argument_expr).kind == EXPR_PATH {
                        let segment = (*argument_expr).segments as *mut AstTypePathSegment;
                        let trait_name = (*segment).name;
                        let mut buffer = diag_buf_new();
                        if format_derive(view(*parser.interner), item as *const AstItem, trait_name, mut_view(buffer)) {
                            let text = StrView { ptr: buffer.ptr as *const u8, len: buffer.len };
                            let synthetic_item = parse_synthetic_item(mut_view(*parser), text);
                            if synthetic_item as usize != 0 && (*synthetic_item).kind != ITEM_ERROR {
                                link_item(item, synthetic_item);
                            }
                        } else {
                            let derive_span = (*argument_expr).span;
                            report(mut_view(*parser), derive_span, AX_TRAIT_UNKNOWN_DERIVE, MSG_UNKNOWN_DERIVE);
                        }
                        diag_buf_free(mut_view(buffer));
                    }
                    arg = (*arg).next as *mut AstAttrArg;
                }
            }
            attr = (*attr).next as *mut AstAttr;
        }
    }
}

// Reports `vis` on an item that does not allow a visibility modifier.
fn report_vis_not_allowed(parser: mut_view<Parser>, item: *mut AstItem, message_index: usize) {
    unsafe {
        if (*item).vis.kind != VIS_PRIVATE {
            report(mut_view(*parser), (*item).span, AX_PARSE_VIS_NOT_ALLOWED, message_index);
        }
    }
}

// Parses `const NAME: Type = value;` after `const` has been consumed.
fn parse_const_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        (*item).kind = ITEM_CONST;
        (*item).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_CONST_NAME).v;
        expect(mut_view(*parser), TOK_COLON, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_COLON);
        (*item).ty = parse_type(mut_view(*parser));
        if consume(mut_view(*parser), TOK_EQ) {
            (*item).expr = parse_expr(mut_view(*parser));
        }
        skip_to_terminator(mut_view(*parser));
    }
}

// Parses `[unsafe] static [mut] NAME: Type = value;`.
fn parse_static_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        (*item).kind = ITEM_STATIC;
        (*item).is_unsafe = consume(mut_view(*parser), TOK_KW_UNSAFE);
        consume(mut_view(*parser), TOK_KW_STATIC);
        (*item).is_mut = consume(mut_view(*parser), TOK_KW_MUT);
        (*item).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_STATIC_NAME).v;
        expect(mut_view(*parser), TOK_COLON, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_COLON);
        (*item).ty = parse_type(mut_view(*parser));
        if consume(mut_view(*parser), TOK_EQ) {
            (*item).expr = parse_expr(mut_view(*parser));
        }
        skip_to_terminator(mut_view(*parser));
    }
}

// Parses a function: `[async] [comptime] [unsafe] [extern "abi"] fn name<G>(params) -> Ret where ... { body }`.
fn parse_fn_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        (*item).kind = ITEM_FN;
        (*item).is_async = consume(mut_view(*parser), TOK_KW_ASYNC);
        (*item).is_comptime = consume(mut_view(*parser), TOK_KW_COMPTIME);
        (*item).is_unsafe = consume(mut_view(*parser), TOK_KW_UNSAFE);
        if consume(mut_view(*parser), TOK_KW_EXTERN) && check(view(*parser), TOK_STR) {
            let string_token = peek_nth_ptr(view(*parser), 0);
            (*item).abi.v = interner_intern_bytes(
                mut_view(*parser.interner),
                (*string_token).str_ptr,
                (*string_token).str_len
            ).v;
            advance(mut_view(*parser));
        }
        expect(mut_view(*parser), TOK_KW_FN, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_KW_FN);
        (*item).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_FUNCTION_NAME).v;
        (*item).generic_params = parse_generic_params(mut_view(*parser));
        expect(mut_view(*parser), TOK_LPAREN, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LPAREN);
        (*item).params = parse_params(mut_view(*parser));
        expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
        if consume(mut_view(*parser), TOK_ARROW) {
            (*item).ret_type = parse_type(mut_view(*parser));
        }
        (*item).where_clause = parse_where_clause(mut_view(*parser));
        if check(view(*parser), TOK_LBRACE) {
            (*item).body = parse_block(mut_view(*parser));
        } else {
            if !parser.allow_bodiless_fn {
                report_here(mut_view(*parser), AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LBRACE);
            }
            skip_to_terminator(mut_view(*parser));
        }
    }
}

// Parses `struct Name<G> { fields }` or `struct Name(Types);` after `struct` has been consumed.
fn parse_struct_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        (*item).kind = ITEM_STRUCT;
        (*item).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_STRUCT_NAME).v;
        (*item).generic_params = parse_generic_params(mut_view(*parser));
        if consume(mut_view(*parser), TOK_LPAREN) {
            (*item).is_tuple = true;
            (*item).tuple_types = parse_type_list(mut_view(*parser));
            expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
            (*item).where_clause = parse_where_clause(mut_view(*parser));
            skip_to_terminator(mut_view(*parser));
        } else {
            (*item).where_clause = parse_where_clause(mut_view(*parser));
            if consume(mut_view(*parser), TOK_LBRACE) {
                (*item).struct_fields = parse_field_decls(mut_view(*parser), true);
            } else {
                skip_to_terminator(mut_view(*parser));
            }
        }
    }
}

// Parses the variants of an enum body after `{` has been consumed, up to and including `}`.
fn parse_enum_variants(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        while more_before(view(*parser), TOK_RBRACE) {
            let variant = alloc_variant_decl(parser.arena, peek_span(view(*parser)));
            (*variant).attrs = parse_attributes(mut_view(*parser));
            (*variant).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_VARIANT_NAME).v;
            if consume(mut_view(*parser), TOK_LPAREN) {
                (*variant).tuple_types = parse_type_list(mut_view(*parser));
                expect(mut_view(*parser), TOK_RPAREN, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RPAREN);
            } else if consume(mut_view(*parser), TOK_LBRACE) {
                (*variant).is_struct = true;
                (*variant).struct_fields = parse_field_decls(mut_view(*parser), false);
            }
            (*item).variants = link_variant_decl((*item).variants, variant);
            if !consume(mut_view(*parser), TOK_COMMA) {
                break;
            }
        }
        expect(mut_view(*parser), TOK_RBRACE, AX_PARSE_UNCLOSED_DELIMITER, MSG_EXPECTED_RBRACE);
    }
}

// Parses `enum Name<G> { Variant, Variant(T), Variant { field: T } }` after `enum` has been consumed.
fn parse_enum_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        (*item).kind = ITEM_ENUM;
        (*item).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_ENUM_NAME).v;
        (*item).generic_params = parse_generic_params(mut_view(*parser));
        (*item).where_clause = parse_where_clause(mut_view(*parser));
        if consume(mut_view(*parser), TOK_LBRACE) {
            parse_enum_variants(mut_view(*parser), item);
        } else {
            skip_to_terminator(mut_view(*parser));
        }
    }
}

// Parses `trait Name<G>: Supertraits where ... { members }` after `trait` has been consumed.
fn parse_trait_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        (*item).kind = ITEM_TRAIT;
        (*item).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_TRAIT_NAME).v;
        (*item).generic_params = parse_generic_params(mut_view(*parser));
        if consume(mut_view(*parser), TOK_COLON) {
            (*item).supertraits = parse_bounds(mut_view(*parser));
        }
        (*item).where_clause = parse_where_clause(mut_view(*parser));
        if consume(mut_view(*parser), TOK_LBRACE) {
            (*item).members = parse_member_items(mut_view(*parser), true);
        } else {
            skip_to_terminator(mut_view(*parser));
        }
    }
}

// Parses `impl<G> Type { members }` or `impl<G> Trait for Type { members }` after `impl` has been consumed.
fn parse_impl_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        report_vis_not_allowed(mut_view(*parser), item, MSG_VIS_NOT_ALLOWED_ON_IMPL);
        (*item).kind = ITEM_IMPL;
        (*item).generic_params = parse_generic_params(mut_view(*parser));
        let first_type = parse_type(mut_view(*parser));
        if consume(mut_view(*parser), TOK_KW_FOR) {
            (*item).trait_path = first_type;
            (*item).self_type = parse_type(mut_view(*parser));
        } else {
            (*item).self_type = first_type;
        }
        (*item).where_clause = parse_where_clause(mut_view(*parser));
        if consume(mut_view(*parser), TOK_LBRACE) {
            (*item).members = parse_member_items(mut_view(*parser), false);
        } else {
            skip_to_terminator(mut_view(*parser));
        }
    }
}

// Parses `type Name<G> = Type;` after `type` has been consumed.
fn parse_type_alias_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        (*item).kind = ITEM_TYPE_ALIAS;
        (*item).name.v = expect_ident(mut_view(*parser), MSG_EXPECTED_TYPE_NAME).v;
        (*item).generic_params = parse_generic_params(mut_view(*parser));
        if consume(mut_view(*parser), TOK_COLON) {
            parse_bounds(mut_view(*parser));
        }
        if consume(mut_view(*parser), TOK_EQ) {
            (*item).ty = parse_type(mut_view(*parser));
        }
        skip_to_terminator(mut_view(*parser));
    }
}

// Parses `extern "abi" { declarations }` after `extern` has been consumed.
fn parse_extern_block_item(parser: mut_view<Parser>, item: *mut AstItem) {
    unsafe {
        report_vis_not_allowed(mut_view(*parser), item, MSG_VIS_NOT_ALLOWED_ON_EXTERN);
        let string_token = peek_nth_ptr(view(*parser), 0);
        if (*string_token).kind == TOK_STR {
            (*item).abi.v = interner_intern_bytes(
                mut_view(*parser.interner),
                (*string_token).str_ptr,
                (*string_token).str_len
            ).v;
        }
        expect(mut_view(*parser), TOK_STR, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_ABI_STRING);
        expect(mut_view(*parser), TOK_LBRACE, AX_PARSE_EXPECTED_TOKEN, MSG_EXPECTED_LBRACE);
        (*item).kind = ITEM_EXTERN_BLOCK;
        (*item).members = parse_member_items(mut_view(*parser), true);
    }
}

// True when the current token starts a function item (possibly with `unsafe`, `extern "abi"`, `async`, `comptime`).
fn at_fn_item_start(parser: view<Parser>) -> bool {
    let kind = peek_kind(parser);
    let next_kind = peek_nth_kind(parser, 1);
    let second_next_kind = peek_nth_kind(parser, 2);
    kind == TOK_KW_FN || (kind == TOK_KW_UNSAFE && next_kind == TOK_KW_FN) ||
        (kind == TOK_KW_EXTERN &&
            (next_kind == TOK_KW_FN || (next_kind == TOK_STR && second_next_kind == TOK_KW_FN))) ||
        kind == TOK_KW_ASYNC || kind == TOK_KW_COMPTIME
}

// Parses one item: attributes, visibility and the declaration, recovering from errors by skipping tokens.
fn parse_item(parser: mut_view<Parser>) -> *mut AstItem {
    if consume(mut_view(*parser), TOK_SEMI) {
        return alloc_item(parser.arena, ITEM_ERROR, empty_span());
    }
    let item = alloc_item(parser.arena, ITEM_ERROR, peek_span(view(*parser)));
    unsafe {
        (*item).attrs = parse_attributes(mut_view(*parser));
        parse_visibility_into(mut_view(*parser), mut_view((*item).vis));
        let kind = peek_kind(view(*parser));
        let ident = peek_ident(view(*parser));
        let next_kind = peek_nth_kind(view(*parser), 1);
        if kind == TOK_IDENT && ident_equals_text(view(*parser.interner), ident.v, LIT_IMPORT) {
            report_here(mut_view(*parser), AX_PARSE_IMPORT, MSG_IMPORT_NOT_KEYWORD);
            advance(mut_view(*parser));
            (*item).kind = ITEM_USE;
            (*item).use_tree = parse_use_tree(mut_view(*parser));
            skip_to_terminator(mut_view(*parser));
        } else if kind == TOK_IDENT && ident_equals_text(view(*parser.interner), ident.v, LIT_MOD) {
            report_here(mut_view(*parser), AX_PARSE_MOD, MSG_MODULE_AT_TOP);
            advance(mut_view(*parser));
            (*item).kind = ITEM_MODULE;
            skip_to_terminator(mut_view(*parser));
        } else if consume(mut_view(*parser), TOK_KW_MODULE) {
            report_vis_not_allowed(mut_view(*parser), item, MSG_VIS_NOT_ALLOWED);
            (*item).kind = ITEM_MODULE;
            parse_dotted_name_into(mut_view(*parser), mut_view((*item).mod_path));
            skip_to_terminator(mut_view(*parser));
        } else if consume(mut_view(*parser), TOK_KW_USE) {
            (*item).kind = ITEM_USE;
            (*item).use_tree = parse_use_tree(mut_view(*parser));
            skip_to_terminator(mut_view(*parser));
        } else if consume(mut_view(*parser), TOK_KW_CONST) {
            parse_const_item(mut_view(*parser), item);
        } else if kind == TOK_KW_STATIC || (kind == TOK_KW_UNSAFE && next_kind == TOK_KW_STATIC) {
            parse_static_item(mut_view(*parser), item);
        } else if at_fn_item_start(view(*parser)) {
            parse_fn_item(mut_view(*parser), item);
        } else if consume(mut_view(*parser), TOK_KW_STRUCT) {
            parse_struct_item(mut_view(*parser), item);
        } else if consume(mut_view(*parser), TOK_KW_ENUM) {
            parse_enum_item(mut_view(*parser), item);
        } else if consume(mut_view(*parser), TOK_KW_TRAIT) {
            parse_trait_item(mut_view(*parser), item);
        } else if consume(mut_view(*parser), TOK_KW_IMPL) {
            parse_impl_item(mut_view(*parser), item);
        } else if consume(mut_view(*parser), TOK_KW_TYPE) {
            parse_type_alias_item(mut_view(*parser), item);
        } else if consume(mut_view(*parser), TOK_KW_EXTERN) {
            parse_extern_block_item(mut_view(*parser), item);
        } else if check(view(*parser), TOK_KW_UNION) {
            report_here(mut_view(*parser), AX_PARSE_RESERVED_KEYWORD, MSG_RESERVED_UNION);
            advance(mut_view(*parser));
            skip_to_terminator(mut_view(*parser));
        } else {
            report(mut_view(*parser), (*item).span, AX_PARSE_EXPECTED_ITEM, MSG_EXPECTED_ITEM);
            advance(mut_view(*parser));
            skip_to_terminator(mut_view(*parser));
        }
        let item_kind = (*item).kind;
        if item_kind == ITEM_STRUCT || item_kind == ITEM_ENUM {
            expand_derives(mut_view(*parser), item);
        }
    }
    item
}

// Parses a token stream (as produced by the lexer, ending in an EOF token) into top-level items.
// `arena`, `sink` and `interner` are turned into raw pointers kept by the parser until it returns; the caller must keep
// the three objects alive and in place for the duration of the call.
pub fn ax_parse(
    arena: mut_view<Arena>,
    tokens: *mut Token,
    token_count: usize,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>
) -> ParseResult {
    let indices_bytes = MAX_TOKEN_SPLITS * size_of<usize>();
    let split_indices = arena_alloc_raw(mut_view(*arena), indices_bytes, align_of<usize>()) as *mut usize;
    let tokens_bytes = MAX_TOKEN_SPLITS * size_of<Token>();
    let split_tokens = arena_alloc_raw(mut_view(*arena), tokens_bytes, align_of<Token>()) as *mut Token;
    let arena_ptr = unsafe { address_of_mut(*arena) };
    let mut parser = Parser {
        arena: arena_ptr,
        tokens: tokens,
        count: token_count,
        pos: 0,
        sink: unsafe { address_of_mut(*sink) },
        interner: unsafe { address_of_mut(*interner) },
        mode_on: true,
        no_struct: false,
        type_tentative: false,
        allow_bodiless_fn: false,
        tentative: 0,
        tentative_failed: false,
        split_len: 0,
        split_indices: split_indices,
        split_tokens: split_tokens,
    };
    let mut items = 0 as *mut AstItem;
    while !check(view(parser), TOK_EOF) {
        let item = parse_item(mut_view(parser));
        if (unsafe { (*item).kind }) != ITEM_ERROR {
            items = link_item(items, item);
        }
    }
    ParseResult { ast: Ast { items: items } }
}
