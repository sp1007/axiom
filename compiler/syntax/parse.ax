@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Maximum number of `>>`/`>=`/`>>=` tokens that can be split inside one speculative parse.
const MAX_TOKEN_SPLITS: usize = 8;

// Maximum number of segments in a dotted name (`a.b.c`) or use path.
const MAX_DOTTED_NAME_SEGMENTS: usize = 32;

// How a generic argument list must be followed to be accepted in expression position.
const GENERIC_ARGS_FOLLOW_NONE: u8 = 0u8;
const GENERIC_ARGS_FOLLOW_CALL_DOT: u8 = 1u8;
const GENERIC_ARGS_FOLLOW_CALL_DOT_BRACE: u8 = 2u8;

// Binding power of expression operators; a smaller number binds tighter.
const PREC_POSTFIX: i32 = 1;
const PREC_UNARY: i32 = 2;
const PREC_CAST: i32 = 3;
const PREC_MULTIPLICATIVE: i32 = 4;
const PREC_ADDITIVE: i32 = 5;
const PREC_SHIFT: i32 = 6;
const PREC_BIT_AND: i32 = 7;
const PREC_BIT_XOR: i32 = 8;
const PREC_BIT_OR: i32 = 9;
const PREC_COMPARISON: i32 = 10;
const PREC_LOGICAL_AND: i32 = 11;
const PREC_LOGICAL_OR: i32 = 12;
const PREC_RANGE: i32 = 13;
const PREC_LOWEST: i32 = 14;

