    pub ret_type: *mut AstType,
    pub where_clause: *mut AstWhereClause,
    pub body: *mut AstBlock,
    pub struct_fields: *mut AstFieldDecl,
    pub tuple_types: *mut AstType,
    pub variants: *mut AstVariantDecl,
    pub supertraits: *mut AstType,
    pub trait_path: *mut AstType,
    pub self_type: *mut AstType,
    pub members: *mut AstItem,
    pub ty: *mut AstType,
    pub expr: *mut AstExpr,
}

pub struct Ast {
