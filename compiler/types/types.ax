pub fn ptr_substmap_init(m: mut_view<PtrSubstMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut GenericArgsSlice;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_substmap_free(m: mut_view<PtrSubstMap>) {
    if m.cap > 0 {
