// Pattern Match Exhaustiveness and Unreachability Checker.
// Port of bootstrap/axiom0/src/types/match/exhaust.c.
module compiler.types.exhaust

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.FileId
use compiler.kernel.id.StrId
use compiler.kernel.id.TypeId
use compiler.kernel.interner.StrInterner
use compiler.kernel.interner.StrView
use compiler.kernel.interner.interner_get
use compiler.source.span.Span
use compiler.source.manager.SourceDatabase
use compiler.source.manager.source_db_text
use compiler.diag.code.AX_PAT_NON_EXHAUSTIVE
use compiler.diag.code.AX_PAT_UNREACHABLE
use compiler.diag.code.DiagCode
use compiler.diag.code.DiagSeverity
use compiler.diag.emitter.DiagDataEntry
use compiler.diag.emitter.DiagFix
use compiler.diag.emitter.DiagLabel
use compiler.diag.emitter.DiagSink
use compiler.diag.emitter.Diagnostic
use compiler.diag.emitter.diag_sink_report
use compiler.lex.token.TOK_CHAR
use compiler.lex.token.TOK_INT
use compiler.lex.token.TOK_KW_FALSE
use compiler.lex.token.TOK_KW_TRUE
use compiler.hir.hir.HIR_EXPR_MATCH
use compiler.hir.hir.HIR_PAT_BINDING
use compiler.hir.hir.HIR_PAT_LITERAL
use compiler.hir.hir.HIR_PAT_OR
use compiler.hir.hir.HIR_PAT_PATH
use compiler.hir.hir.HIR_PAT_RANGE
