@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
pub struct PatInterval {
    pub start: i64,
    pub end: i64,
}

@derive(Copy)
pub struct PatInterval128 {
    pub start_lo: u64,
    pub start_hi: u64,
    pub end_lo: u64,
    pub end_hi: u64,
}

unsafe fn pat_interval128_at(base: *const PatInterval128, idx: usize) -> *const PatInterval128 {
    ((base as usize) + mul_usize(idx, size_of<PatInterval128>())) as *const PatInterval128
}

unsafe fn pat_interval128_at_mut(base: *mut PatInterval128, idx: usize) -> *mut PatInterval128 {
    ((base as usize) + mul_usize(idx, size_of<PatInterval128>())) as *mut PatInterval128
}

fn exhaust_is_signed_kind(tk: u8) -> bool {
    tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE || tk == TY_I128
}

fn exhaust_u128_le(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64, is_signed: bool) -> bool {
    if a_hi != b_hi {
        if is_signed {
            return (a_hi as i64) < (b_hi as i64);
        }
        return a_hi < b_hi;
    }
    a_lo <= b_lo
}

unsafe fn pat_interval_at(base: *const PatInterval, idx: usize) -> *const PatInterval {
    ((base as usize) + mul_usize(idx, size_of<PatInterval>())) as *const PatInterval
}

unsafe fn pat_interval_at_mut(base: *mut PatInterval, idx: usize) -> *mut PatInterval {
    ((base as usize) + mul_usize(idx, size_of<PatInterval>())) as *mut PatInterval
}

fn exhaust_bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    if (a as usize) == (b as usize) {
        return true;
    }
    if (a as usize) == 0 || (b as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while (i < n) {
        let ba = unsafe { *(a + i) };
        let bb = unsafe { *(b + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn emit_pat_unreachable(sink: mut_view<DiagSink>, file_v: u32, start: u32, end: u32) {
    let code = DiagCode { v: AX_PAT_UNREACHABLE };
    let msg_str = diag_code_default_message(code);
    let msg_ptr = unsafe { *(address_of(msg_str) as *const *const u8) };
    let msg_len = len(msg_str);
    let d = Diagnostic {
        code: code,
        severity: DiagSeverity.Warning,
        message: StrView { ptr: msg_ptr, len: msg_len },
        primary: Span { file: FileId { v: file_v }, start: start, end: end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

fn emit_pat_non_exhaustive(sink: mut_view<DiagSink>, file_v: u32, start: u32, end: u32) {
    let code = DiagCode { v: AX_PAT_NON_EXHAUSTIVE };
    let msg_str = diag_code_default_message(code);
    let msg_ptr = unsafe { *(address_of(msg_str) as *const *const u8) };
    let msg_len = len(msg_str);
    let d = Diagnostic {
        code: code,
        severity: DiagSeverity.Error,
        message: StrView { ptr: msg_ptr, len: msg_len },
        primary: Span { file: FileId { v: file_v }, start: start, end: end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

fn exhaust_wrapping_add_u64(a: u64, b: u64) -> u64 {
    let lo_a = a & 0xffffffffu64;
    let lo_b = b & 0xffffffffu64;
    let lo = lo_a + lo_b;
    let carry = lo >> 32u64;
    let hi_a = a >> 32u64;
    let hi_b = b >> 32u64;
    let hi = (hi_a + hi_b + carry) & 0xffffffffu64;
    (lo & 0xffffffffu64) | (hi << 32u64)
}

fn exhaust_wrapping_sub_u64(a: u64, b: u64) -> u64 {
    let inv_b = b ^ 0xffffffffffffffffu64;
    let neg_b = exhaust_wrapping_add_u64(inv_b, 1u64);
    exhaust_wrapping_add_u64(a, neg_b)
}

pub fn get_pat_interval(pat: *const HirPat, out: mut_view<PatInterval>) -> bool {
    if (pat as usize) == 0 {
        return false;
    }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_LITERAL {
        let tk = unsafe { (*pat).tok.kind };
        if tk == TOK_INT || tk == TOK_CHAR {
            let mut val_u: u64 = 0u64;
            if tk == TOK_CHAR {
                let cv = unsafe { (*pat).tok.char_val };
                let iv = unsafe { (*pat).tok.int_val };
                val_u = if cv != 0u32 { cv as u64 } else { iv };
            } else {
                val_u = unsafe { (*pat).tok.int_val };
            }
            if unsafe { (*pat).is_negated } {
                val_u = exhaust_wrapping_add_u64(val_u ^ 0xffffffffffffffffu64, 1u64);
            }
            let val = val_u as i64;
            out.start = val;
            out.end = val;
            return true;
        }
        return false;
    }
    if pk == HIR_PAT_RANGE {
        let mut s = PatInterval { start: 0i64, end: 0i64 };
        let mut e = PatInterval { start: 0i64, end: 0i64 };
        let sp = unsafe { (*pat).start_pat as *const HirPat };
        let ep = unsafe { (*pat).end_pat as *const HirPat };
        let ok_s = get_pat_interval(sp, mut_view(s));
        let ok_e = get_pat_interval(ep, mut_view(e));
        if ok_s && ok_e {
            out.start = s.start;
            if unsafe { (*pat).is_inclusive } {
                out.end = e.start;
            } else if (e.start as u64) == 0x8000000000000000u64 {
                out.start = 1i64;
                out.end = 0i64;
            } else {
                out.end = exhaust_wrapping_sub_u64(e.start as u64, 1u64) as i64;
            }
            return true;
        }
        return false;
    }
    false
}

pub fn get_pat_interval_128(pat: *const HirPat, is_signed: bool, out: mut_view<PatInterval128>) -> bool {
    if (pat as usize) == 0 {
        return false;
    }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_LITERAL {
        let tk = unsafe { (*pat).tok.kind };
        if tk == TOK_INT || tk == TOK_CHAR {
            let mut lo: u64 = 0u64;
            let mut hi: u64 = 0u64;
            if tk == TOK_CHAR {
                let cv = unsafe { (*pat).tok.char_val };
                let iv = unsafe { (*pat).tok.int_val };
                lo = if cv != 0u32 { cv as u64 } else { iv };
            } else {
                lo = unsafe { (*pat).tok.int_val };
                hi = unsafe { token_int_hi(view((*pat).tok)) };
            }
            if unsafe { (*pat).is_negated } {
                if !is_signed && (lo != 0u64 || hi != 0u64) {
                    return false;
                }
                let nlo = if lo == 0u64 { 0u64 } else { exhaust_wrapping_add_u64(lo ^ 0xffffffffffffffffu64, 1u64) };
                let nhi = if lo == 0u64 {
                    if hi == 0u64 { 0u64 } else { exhaust_wrapping_add_u64(hi ^ 0xffffffffffffffffu64, 1u64) }
                } else {
                    hi ^ 0xffffffffffffffffu64
                };
                lo = nlo;
                hi = nhi;
            }
            out.start_lo = lo;
            out.start_hi = hi;
            out.end_lo = lo;
            out.end_hi = hi;
            return true;
        }
        return false;
    }
    if pk == HIR_PAT_RANGE {
        let mut s = PatInterval128 { start_lo: 0u64, start_hi: 0u64, end_lo: 0u64, end_hi: 0u64 };
        let mut e = PatInterval128 { start_lo: 0u64, start_hi: 0u64, end_lo: 0u64, end_hi: 0u64 };
        let sp = unsafe { (*pat).start_pat as *const HirPat };
        let ep = unsafe { (*pat).end_pat as *const HirPat };
        let ok_s = get_pat_interval_128(sp, is_signed, mut_view(s));
        let ok_e = get_pat_interval_128(ep, is_signed, mut_view(e));
        if ok_s && ok_e {
            out.start_lo = s.start_lo;
            out.start_hi = s.start_hi;
            if unsafe { (*pat).is_inclusive } {
                out.end_lo = e.start_lo;
                out.end_hi = e.start_hi;
            } else {
                let at_min = if is_signed {
                    e.start_lo == 0u64 && e.start_hi == 0x8000000000000000u64
                } else {
                    e.start_lo == 0u64 && e.start_hi == 0u64
                };
                if at_min {
                    out.start_lo = 1u64;
                    out.start_hi = 0u64;
                    out.end_lo = 0u64;
                    out.end_hi = 0u64;
                } else if e.start_lo == 0u64 {
                    out.end_lo = 0xffffffffffffffffu64;
                    out.end_hi = exhaust_wrapping_sub_u64(e.start_hi, 1u64);
                } else {
                    out.end_lo = exhaust_wrapping_sub_u64(e.start_lo, 1u64);
                    out.end_hi = e.start_hi;
                }
            }
            return true;
        }
        return false;
    }
    false
}

fn is_int_or_char_kind(tk: u8) -> bool {
    tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE || tk == TY_I128 ||
    tk == TY_U8 || tk == TY_U16 || tk == TY_U32 || tk == TY_U64 || tk == TY_USIZE || tk == TY_U128 ||
    tk == TY_CHAR
}

pub fn match_check_exhaustiveness(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    expr: *const HirExpr,
    val_ty: TypeId
) {
    if (expr as usize) == 0 {
        return;
    }
    if (unsafe { (*expr).kind }) != HIR_EXPR_MATCH {
        return;
    }

    let expr_file_v = unsafe { (*expr).span.file.v };
    let expr_start = unsafe { (*expr).span.start };
    let expr_end = unsafe { (*expr).span.end };

    let mut has_unconditional_wildcard = false;
    let mut arm = unsafe { (*expr).arms as *const HirMatchArm };
    while ((arm as usize) != 0) {
        let has_guard = (unsafe { (*arm).guard as usize }) != 0;
        let ap = unsafe { (*arm).pat as *const HirPat };
        if !has_guard && (ap as usize) != 0 {
            let pk = unsafe { (*ap).kind };
            if pk == HIR_PAT_WILDCARD || pk == HIR_PAT_BINDING {
                has_unconditional_wildcard = true;
                let mut unreach = unsafe { (*arm).next as *const HirMatchArm };
                while ((unreach as usize) != 0) {
                    let up = unsafe { (*unreach).pat as *const HirPat };
                    if (up as usize) != 0 {
                        let u_fv = unsafe { (*up).span.file.v };
                        let u_st = unsafe { (*up).span.start };
                        let u_en = unsafe { (*up).span.end };
                        emit_pat_unreachable(mut_view(*sink), u_fv, u_st, u_en);
                    }
                    unreach = unsafe { (*unreach).next as *const HirMatchArm };
                }
                break;
            }
        }
        arm = unsafe { (*arm).next as *const HirMatchArm };
    }

    let val_ty_v = val_ty.v;
    let t = type_get(view(thir.interner), TypeId { v: val_ty_v });
    if (t as usize) == 0 {
        return;
    }
    let tk = unsafe { (*t).kind };

    if is_int_or_char_kind(tk) {
        let is_sig = exhaust_is_signed_kind(tk);
        let cov_bytes = mul_usize(256, size_of<PatInterval128>());
        let cov_raw = arena_alloc_raw(mut_view(thir.interner.arena), cov_bytes, align_of<PatInterval128>());
        let covered = cov_raw as *mut PatInterval128;
        let mut cov_count: usize = 0;

        let mut iarm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((iarm as usize) != 0) {
            let ap = unsafe { (*iarm).pat as *const HirPat };
            let has_guard = (unsafe { (*iarm).guard as usize }) != 0;
            if (ap as usize) != 0 {
                let mut iv = PatInterval128 { start_lo: 0u64, start_hi: 0u64, end_lo: 0u64, end_hi: 0u64 };
                let got_iv = get_pat_interval_128(ap, is_sig, mut_view(iv));
                if got_iv {
                    let non_empty = exhaust_u128_le(iv.start_lo, iv.start_hi, iv.end_lo, iv.end_hi, is_sig);
                    let mut is_cov = !non_empty;
                    let mut i: usize = 0;
                    while (!is_cov && i < cov_count) {
                        let ci = unsafe { pat_interval128_at(covered as *const PatInterval128, i) };
                        if exhaust_u128_le(unsafe { (*ci).start_lo }, unsafe { (*ci).start_hi }, iv.start_lo, iv.start_hi, is_sig) &&
                           exhaust_u128_le(iv.end_lo, iv.end_hi, unsafe { (*ci).end_lo }, unsafe { (*ci).end_hi }, is_sig) {
                            is_cov = true;
                            break;
                        }
                        i = i + 1;
                    }
                    if is_cov {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        emit_pat_unreachable(mut_view(*sink), a_fv, a_st, a_en);
                    } else if !has_guard && cov_count < 256 {
                        let dst = unsafe { pat_interval128_at_mut(covered, cov_count) };
                        unsafe {
                            (*dst).start_lo = iv.start_lo;
                            (*dst).start_hi = iv.start_hi;
                            (*dst).end_lo = iv.end_lo;
                            (*dst).end_hi = iv.end_hi;
                        }
                        cov_count = cov_count + 1;
                    }
                } else if (unsafe { (*ap).kind }) == HIR_PAT_OR {
                    let mut p = unsafe { (*ap).pats as *const HirPat };
                    while ((p as usize) != 0) {
                        let got_piv = get_pat_interval_128(p, is_sig, mut_view(iv));
                        if got_piv {
                            let non_empty = exhaust_u128_le(iv.start_lo, iv.start_hi, iv.end_lo, iv.end_hi, is_sig);
                            let mut is_cov = !non_empty;
                            let mut i: usize = 0;
                            while (!is_cov && i < cov_count) {
                                let ci = unsafe { pat_interval128_at(covered as *const PatInterval128, i) };
                                if exhaust_u128_le(unsafe { (*ci).start_lo }, unsafe { (*ci).start_hi }, iv.start_lo, iv.start_hi, is_sig) &&
                                   exhaust_u128_le(iv.end_lo, iv.end_hi, unsafe { (*ci).end_lo }, unsafe { (*ci).end_hi }, is_sig) {
                                    is_cov = true;
                                    break;
                                }
                                i = i + 1;
                            }
                            if is_cov {
                                let p_fv = unsafe { (*p).span.file.v };
                                let p_st = unsafe { (*p).span.start };
                                let p_en = unsafe { (*p).span.end };
                                emit_pat_unreachable(mut_view(*sink), p_fv, p_st, p_en);
                            } else if !has_guard && cov_count < 256 {
                                let dst = unsafe { pat_interval128_at_mut(covered, cov_count) };
                                unsafe {
                                    (*dst).start_lo = iv.start_lo;
                                    (*dst).start_hi = iv.start_hi;
                                    (*dst).end_lo = iv.end_lo;
                                    (*dst).end_hi = iv.end_hi;
                                }
                                cov_count = cov_count + 1;
                            }
                        }
                        p = unsafe { (*p).next as *const HirPat };
                    }
                }
            }
            iarm = unsafe { (*iarm).next as *const HirMatchArm };
        }

        if has_unconditional_wildcard {
            return;
        }
        if tk == TY_U8 {
            let mut all_u8 = true;
            let mut v: u64 = 0u64;
            while (v <= 255u64) {
                let mut found = false;
                let mut i: usize = 0;
                while (i < cov_count) {
                    let ci = unsafe { pat_interval128_at(covered as *const PatInterval128, i) };
                    if exhaust_u128_le(unsafe { (*ci).start_lo }, unsafe { (*ci).start_hi }, v, 0u64, false) &&
                       exhaust_u128_le(v, 0u64, unsafe { (*ci).end_lo }, unsafe { (*ci).end_hi }, false) {
                        found = true;
                        break;
                    }
                    i = i + 1;
                }
                if !found {
                    all_u8 = false;
                    break;
                }
                v = v + 1u64;
            }
            if all_u8 {
                return;
            }
        }

        emit_pat_non_exhaustive(mut_view(*sink), expr_file_v, expr_start, expr_end);
        return;
    }

    match_check_exhaust_bool_or_enum(
        mut_view(*thir),
        str_in,
        db,
        mut_view(*sink),
        expr,
        val_ty,
        tk,
        has_unconditional_wildcard,
        expr_file_v,
        expr_start,
        expr_end
    );
}

fn match_check_exhaust_bool_or_enum(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    expr: *const HirExpr,
    val_ty: TypeId,
    tk: u8,
    has_unconditional_wildcard: bool,
    expr_file_v: u32,
    expr_start: u32,
    expr_end: u32
) {
    let t = type_get(view(thir.interner), TypeId { v: val_ty.v });
    if tk == TY_BOOL {
        let mut has_true = false;
        let mut has_false = false;
        let mut barm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((barm as usize) != 0) {
            let ap = unsafe { (*barm).pat as *const HirPat };
            let has_guard = (unsafe { (*barm).guard as usize }) != 0;
            if (ap as usize) != 0 && (unsafe { (*ap).kind }) == HIR_PAT_LITERAL {
                let tok_k = unsafe { (*ap).tok.kind };
                if tok_k == TOK_KW_TRUE {
                    if has_true {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        emit_pat_unreachable(mut_view(*sink), a_fv, a_st, a_en);
                    } else if !has_guard {
                        has_true = true;
                    }
                } else if tok_k == TOK_KW_FALSE {
                    if has_false {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        emit_pat_unreachable(mut_view(*sink), a_fv, a_st, a_en);
                    } else if !has_guard {
                        has_false = true;
                    }
                }
            }
            barm = unsafe { (*barm).next as *const HirMatchArm };
        }
        if has_unconditional_wildcard || (has_true && has_false) {
            return;
        }
        emit_pat_non_exhaustive(mut_view(*sink), expr_file_v, expr_start, expr_end);
        return;
    }

    if tk == TY_ENUM {
        let def = unsafe { (*t).def as *const HirItem };
        let count = unsafe { (*t).variant_count };
        let alloc_cnt = if count > 0 { count } else { 1 };
        let seen = arena_alloc_raw(mut_view(thir.interner.arena), alloc_cnt, 1);
        let mut z: usize = 0;
        while (z < count) {
            unsafe { *(seen + z) = 0u8; }
            z = z + 1;
        }

        let mut earm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((earm as usize) != 0) {
            let ap = unsafe { (*earm).pat as *const HirPat };
            let has_guard = (unsafe { (*earm).guard as usize }) != 0;
            if (ap as usize) != 0 && (def as usize) != 0 {
                let apk = unsafe { (*ap).kind };
                if apk == HIR_PAT_PATH || apk == HIR_PAT_STRUCT {
                    let p_file_v = unsafe { (*ap).path.span.file.v };
                    let p_start = unsafe { (*ap).path.span.start };
                    let p_end = unsafe { (*ap).path.span.end };
                    let p_name_v = unsafe { (*ap).path.name.v };

                    let mut ptext_ptr: *const u8 = 0 as *const u8;
                    let mut ptext_len: usize = 0;
                    if p_file_v != 0u32 && (db.files as usize) != 0 {
                        let ftext = source_db_text(db, FileId { v: p_file_v });
                        if (ftext.ptr as usize) != 0 && p_start <= p_end && (p_end as usize) <= ftext.len {
                            ptext_ptr = ((ftext.ptr as usize) + (p_start as usize)) as *const u8;
                            ptext_len = (p_end - p_start) as usize;
                        }
                    }

                    let mut vname_ptr: *const u8 = ptext_ptr;
                    let mut vname_len: usize = ptext_len;
                    let mut ename_ptr: *const u8 = 0 as *const u8;
                    let mut ename_len: usize = 0;

                    let mut bi: usize = 0;
                    while (bi < ptext_len) {
                        if (unsafe { *(ptext_ptr + bi) }) == 46u8 {
                            ename_ptr = ptext_ptr;
                            ename_len = bi;
                            vname_ptr = unsafe { ptext_ptr + (bi + 1) };
                            vname_len = ptext_len - bi - 1;
                        }
                        bi = bi + 1;
                    }

                    if vname_len == 0 && p_name_v != 0u32 {
                        let nv = interner_get(str_in, StrId { v: p_name_v });
                        vname_ptr = nv.ptr;
                        vname_len = nv.len;
                    }

                    let def_name_v = unsafe { (*def).name.v };
                    let mut v = unsafe { (*def).variants as *const HirVariantDecl };
                    let mut vidx: usize = 0;
                    while ((v as usize) != 0 && vidx < count) {
                        let v_name_v = unsafe { (*v).name.v };
                        let var_name = interner_get(str_in, StrId { v: v_name_v });
                        let mut enum_matches = true;
                        if ename_len > 0 && def_name_v != 0u32 {
                            let def_name = interner_get(str_in, StrId { v: def_name_v });
                            if def_name.len != ename_len || !exhaust_bytes_eq(def_name.ptr, ename_ptr, ename_len) {
                                enum_matches = false;
                            }
                        }
                        if enum_matches && var_name.len == vname_len && exhaust_bytes_eq(var_name.ptr, vname_ptr, vname_len) {
                            if (unsafe { *(seen + vidx) }) != 0u8 {
                                let a_fv = unsafe { (*ap).span.file.v };
                                let a_st = unsafe { (*ap).span.start };
                                let a_en = unsafe { (*ap).span.end };
                                emit_pat_unreachable(mut_view(*sink), a_fv, a_st, a_en);
                            } else if !has_guard {
                                unsafe { *(seen + vidx) = 1u8; }
                            }
                            break;
                        }
                        v = unsafe { (*v).next as *const HirVariantDecl };
                        vidx = vidx + 1;
                    }
                }
            }
            earm = unsafe { (*earm).next as *const HirMatchArm };
        }

        if has_unconditional_wildcard {
            return;
        }
        let mut all_seen = true;
        let mut si: usize = 0;
        while (si < count) {
            if (unsafe { *(seen + si) }) == 0u8 {
                all_seen = false;
                break;
            }
            si = si + 1;
        }
        if !all_seen {
            emit_pat_non_exhaustive(mut_view(*sink), expr_file_v, expr_start, expr_end);
        }
        return;
    }

    if has_unconditional_wildcard {
        return;
    }
    emit_pat_non_exhaustive(mut_view(*sink), expr_file_v, expr_start, expr_end);
}
