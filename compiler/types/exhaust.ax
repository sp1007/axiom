@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

@derive(Copy)
pub struct PatInterval {
    pub start: i64,
    pub end: i64,
}

@derive(Copy)
pub struct PatInterval128 {
    pub start_lo: u64,
    pub start_hi: u64,
    pub end_lo: u64,
    pub end_hi: u64,
}

const EXHAUST_UNREACH_MSG: [19]u8 = [
    117u8, 110u8, 114u8, 101u8, 97u8, 99u8, 104u8, 97u8, 98u8, 108u8,
    101u8, 32u8, 112u8, 97u8, 116u8, 116u8, 101u8, 114u8, 110u8
];

const EXHAUST_NONEX_MSG: [51]u8 = [
    110u8, 111u8, 110u8, 45u8, 101u8, 120u8, 104u8, 97u8, 117u8, 115u8,
    116u8, 105u8, 118u8, 101u8, 32u8, 112u8, 97u8, 116u8, 116u8, 101u8,
    114u8, 110u8, 115u8, 58u8, 32u8, 109u8, 97u8, 116u8, 99u8, 104u8,
    32u8, 109u8, 117u8, 115u8, 116u8, 32u8, 99u8, 111u8, 118u8, 101u8,
    114u8, 32u8, 97u8, 108u8, 108u8, 32u8, 99u8, 97u8, 115u8, 101u8,
    115u8
];

fn exhaust_is_signed_kind(tk: u8) -> bool {
    tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE || tk == TY_I128 || tk == TY_INT_VAR
}

fn exhaust_u128_le(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64, is_signed: bool) -> bool {
    if a_hi != b_hi {
        if is_signed {
            return (a_hi as i64) < (b_hi as i64);
        }
        return a_hi < b_hi;
    }
    a_lo <= b_lo
}

fn exhaust_bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    if (a as usize) == (b as usize) {
        return true;
    }
    if (a as usize) == 0 || (b as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while (i < n) {
        let ba = unsafe { *(a + i) };
        let bb = unsafe { *(b + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn emit_pat_unreachable(sink: mut_view<DiagSink>, file_v: u32, start: u32, end: u32) {
    let code = DiagCode { v: AX_PAT_UNREACHABLE };
    let buf = arena_alloc_raw(mut_view(sink.arena), 20, 1);
    let mut i: usize = 0;
    while (i < 19) {
        unsafe { *(buf + i) = EXHAUST_UNREACH_MSG[i]; }
        i = i + 1;
    }
    unsafe { *(buf + 19) = 0u8; }
    let d = Diagnostic {
        code: code,
        severity: DiagSeverity.Warning,
        message: StrView { ptr: buf as *const u8, len: 19 },
        primary: Span { file: FileId { v: file_v }, start: start, end: end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

fn emit_pat_non_exhaustive(sink: mut_view<DiagSink>, file_v: u32, start: u32, end: u32) {
    let code = DiagCode { v: AX_PAT_NON_EXHAUSTIVE };
    let buf = arena_alloc_raw(mut_view(sink.arena), 52, 1);
    let mut i: usize = 0;
    while (i < 51) {
        unsafe { *(buf + i) = EXHAUST_NONEX_MSG[i]; }
        i = i + 1;
    }
    unsafe { *(buf + 51) = 0u8; }
    let d = Diagnostic {
        code: code,
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf as *const u8, len: 51 },
        primary: Span { file: FileId { v: file_v }, start: start, end: end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

fn exhaust_wrapping_add_u64(a: u64, b: u64) -> u64 {
    let lo_a = a & 0xffffffffu64;
    let lo_b = b & 0xffffffffu64;
    let lo = lo_a + lo_b;
    let carry = lo >> 32u64;
    let hi_a = a >> 32u64;
    let hi_b = b >> 32u64;
    let hi = (hi_a + hi_b + carry) & 0xffffffffu64;
    (lo & 0xffffffffu64) | (hi << 32u64)
}

fn exhaust_wrapping_sub_u64(a: u64, b: u64) -> u64 {
    let inv_b = b ^ 0xffffffffffffffffu64;
    let neg_b = exhaust_wrapping_add_u64(inv_b, 1u64);
    exhaust_wrapping_add_u64(a, neg_b)
}

pub fn get_pat_interval(pat: *const HirPat, out: mut_view<PatInterval>) -> bool {
    if (pat as usize) == 0 {
        return false;
    }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_LITERAL {
        let tk = unsafe { (*pat).tok.kind };
        if tk == TOK_INT || tk == TOK_CHAR {
            let mut val_u: u64 = 0u64;
            if tk == TOK_CHAR {
                let cv = unsafe { (*pat).tok.char_val };
                let iv = unsafe { (*pat).tok.int_val };
                val_u = if cv != 0u32 { cv as u64 } else { iv };
            } else {
                val_u = unsafe { (*pat).tok.int_val };
            }
            if unsafe { (*pat).is_negated } {
                val_u = exhaust_wrapping_add_u64(val_u ^ 0xffffffffffffffffu64, 1u64);
            }
            let val = val_u as i64;
            out.start = val;
            out.end = val;
            return true;
        }
        return false;
    }
    if pk == HIR_PAT_RANGE {
        let mut s = PatInterval { start: 0i64, end: 0i64 };
        let mut e = PatInterval { start: 0i64, end: 0i64 };
        let sp = unsafe { (*pat).start_pat as *const HirPat };
        let ep = unsafe { (*pat).end_pat as *const HirPat };
        let ok_s = get_pat_interval(sp, mut_view(s));
        let ok_e = get_pat_interval(ep, mut_view(e));
        if ok_s && ok_e {
            out.start = s.start;
            if unsafe { (*pat).is_inclusive } {
                out.end = e.start;
            } else if (e.start as u64) == 0x8000000000000000u64 {
                out.start = 1i64;
                out.end = 0i64;
            } else {
                out.end = exhaust_wrapping_sub_u64(e.start as u64, 1u64) as i64;
            }
            return true;
        }
        return false;
    }
    false
}

pub fn get_pat_interval_128(pat: *const HirPat, is_signed: bool, out: mut_view<PatInterval128>) -> bool {
    if (pat as usize) == 0 {
        return false;
    }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_LITERAL {
        let tk = unsafe { (*pat).tok.kind };
        if tk == TOK_INT || tk == TOK_CHAR {
            let mut lo: u64 = 0u64;
            let mut hi: u64 = 0u64;
            if tk == TOK_CHAR {
                let cv = unsafe { (*pat).tok.char_val };
                let iv = unsafe { (*pat).tok.int_val };
                lo = if cv != 0u32 { cv as u64 } else { iv };
            } else {
                lo = unsafe { (*pat).tok.int_val };
                hi = unsafe { token_int_hi(view((*pat).tok)) };
            }
            if unsafe { (*pat).is_negated } {
                if !is_signed && (lo != 0u64 || hi != 0u64) {
                    return false;
                }
                let nlo = if lo == 0u64 { 0u64 } else { exhaust_wrapping_add_u64(lo ^ 0xffffffffffffffffu64, 1u64) };
                let nhi = if lo == 0u64 {
                    if hi == 0u64 { 0u64 } else { exhaust_wrapping_add_u64(hi ^ 0xffffffffffffffffu64, 1u64) }
                } else {
                    hi ^ 0xffffffffffffffffu64
                };
                lo = nlo;
                hi = nhi;
            }
            out.start_lo = lo;
            out.start_hi = hi;
            out.end_lo = lo;
            out.end_hi = hi;
            return true;
        }
        return false;
    }
    if pk == HIR_PAT_RANGE {
        let mut s = PatInterval128 { start_lo: 0u64, start_hi: 0u64, end_lo: 0u64, end_hi: 0u64 };
        let mut e = PatInterval128 { start_lo: 0u64, start_hi: 0u64, end_lo: 0u64, end_hi: 0u64 };
        let sp = unsafe { (*pat).start_pat as *const HirPat };
        let ep = unsafe { (*pat).end_pat as *const HirPat };
        let ok_s = get_pat_interval_128(sp, is_signed, mut_view(s));
        let ok_e = get_pat_interval_128(ep, is_signed, mut_view(e));
        if ok_s && ok_e {
            out.start_lo = s.start_lo;
            out.start_hi = s.start_hi;
            if unsafe { (*pat).is_inclusive } {
                out.end_lo = e.start_lo;
                out.end_hi = e.start_hi;
            } else {
                let at_min = if is_signed {
                    e.start_lo == 0u64 && e.start_hi == 0x8000000000000000u64
                } else {
                    e.start_lo == 0u64 && e.start_hi == 0u64
                };
                if at_min {
                    out.start_lo = 1u64;
                    out.start_hi = 0u64;
                    out.end_lo = 0u64;
                    out.end_hi = 0u64;
                } else if e.start_lo == 0u64 {
                    out.end_lo = 0xffffffffffffffffu64;
                    out.end_hi = exhaust_wrapping_sub_u64(e.start_hi, 1u64);
                } else {
                    out.end_lo = exhaust_wrapping_sub_u64(e.start_lo, 1u64);
                    out.end_hi = e.start_hi;
                }
            }
            return true;
        }
        return false;
    }
    false
}

// ---------------------------------------------------------------------------------------------------------------
// Unified column-wise usefulness (Maranget, "Warnings for pattern matching") for all match scrutinee types.
//
// A matrix row is a vector of patterns, one per column; a null pattern pointer is a wildcard (fields introduced
// by specialisation). Each column has a resolved type that decides its constructor family:
//   SINGLE  tuple / struct / () one constructor, one field per element / declared field
//   BOOL    bool                constructors `false` (0) and `true` (1)
//   ENUM    enum                one constructor per variant (from thir pat_variants or fallback), fields = payload
//   INT     i8..i128/u8..u128/char  128-bit biased unsigned intervals split into exact disjoint segments
//   OPAQUE  anything else       (str, slices, arrays, pointers, views, ...) only wildcards/bindings cover it
// `useful(P, q)` is true when some value matches q and no row of P. A match is non-exhaustive iff `[_]` is
// useful against its unguarded arms; an arm alternative is unreachable iff it is not useful against the
// unguarded alternatives before it. Anything the checker cannot classify is treated conservatively: an unknown
// pattern in P covers nothing, an unknown pattern in q is assumed useful (no false unreachable warning).
// ---------------------------------------------------------------------------------------------------------------

const EXC_OPAQUE: u8 = 0u8;
const EXC_SINGLE: u8 = 1u8;
const EXC_BOOL: u8 = 2u8;
const EXC_ENUM: u8 = 3u8;
const EXC_INT: u8 = 4u8;

const EXH_WILD: u8 = 0u8;
const EXH_CTOR: u8 = 1u8;
const EXH_RANGE: u8 = 2u8;
const EXH_UNKNOWN: u8 = 3u8;
const EXH_OR: u8 = 4u8;
const EXH_EMPTY: u8 = 5u8;

const EX_MAX_DEPTH: u32 = 200u32;

@derive(Copy)
struct ExHead {
    kind: u8,
    ctor: usize,
    lo_lo: u64,
    lo_hi: u64,
    hi_lo: u64,
    hi_hi: u64,
}

@derive(Copy)
struct ExCol {
    cat: u8,
    t: *mut AxType,
    dom_lo_lo: u64,
    dom_lo_hi: u64,
    dom_hi_lo: u64,
    dom_hi_hi: u64,
    is_signed: bool,
    is_char: bool,
}

@derive(Copy)
struct ExMat {
    cells: *mut usize,
    n: usize,
    w: usize,
}

@derive(Copy)
struct ExPt128 {
    lo: u64,
    hi: u64,
}

fn ex_alloc(thir: mut_view<Thir>, count: usize) -> *mut usize {
    let c = if count > 0 { count } else { 1 };
    arena_alloc_raw(mut_view(thir.interner.arena), mul_usize(c, size_of<usize>()), align_of<usize>()) as *mut usize
}

fn ex_get(base: *mut usize, idx: usize) -> usize {
    unsafe { *usize_at(base, idx) }
}

fn ex_set(base: *mut usize, idx: usize, v: usize) {
    unsafe { *usize_at(base, idx) = v; }
}

fn ex_alloc_pts(thir: mut_view<Thir>, count: usize) -> *mut ExPt128 {
    let c = if count > 0 { count } else { 1 };
    arena_alloc_raw(mut_view(thir.interner.arena), mul_usize(c, size_of<ExPt128>()), align_of<ExPt128>()) as *mut ExPt128
}

unsafe fn ex_pt_at(base: *mut ExPt128, idx: usize) -> *mut ExPt128 {
    ((base as usize) + mul_usize(idx, size_of<ExPt128>())) as *mut ExPt128
}

fn ex_get_pt(base: *mut ExPt128, idx: usize) -> ExPt128 {
    let p = unsafe { ex_pt_at(base, idx) };
    ExPt128 {
        lo: unsafe { (*p).lo },
        hi: unsafe { (*p).hi },
    }
}

fn ex_set_pt(base: *mut ExPt128, idx: usize, lo: u64, hi: u64) {
    let p = unsafe { ex_pt_at(base, idx) };
    unsafe {
        (*p).lo = lo;
        (*p).hi = hi;
    }
}

fn ex_u128_lt(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64) -> bool {
    if a_hi != b_hi {
        return a_hi < b_hi;
    }
    a_lo < b_lo
}

fn ex_u128_le(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64) -> bool {
    if a_hi != b_hi {
        return a_hi < b_hi;
    }
    a_lo <= b_lo
}

fn ex_u128_eq(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64) -> bool {
    a_lo == b_lo && a_hi == b_hi
}

// Precondition: (lo, hi) < (0xffffffffffffffff, 0xffffffffffffffff)
fn ex_u128_inc(lo: u64, hi: u64, out_lo: mut_view<u64>, out_hi: mut_view<u64>) {
    if lo == 0xffffffffffffffffu64 {
        *out_lo = 0u64;
        *out_hi = hi + 1u64;
    } else {
        *out_lo = lo + 1u64;
        *out_hi = hi;
    }
}

// Integer domain in the 128-bit biased (order-preserving unsigned) encoding: signed `hi` is XORed with 2^63.
fn ex_int_width(tk: u8) -> u32 {
    if tk == TY_I8 || tk == TY_U8 { return 8u32; }
    if tk == TY_I16 || tk == TY_U16 { return 16u32; }
    if tk == TY_I32 || tk == TY_U32 || tk == TY_INT_VAR { return 32u32; }
    if tk == TY_I64 || tk == TY_U64 || tk == TY_ISIZE || tk == TY_USIZE { return 64u32; }
    if tk == TY_I128 || tk == TY_U128 { return 128u32; }
    0u32
}

fn ex_half(w: u32) -> u64 {
    if w == 8u32 { return 0x80u64; }
    if w == 16u32 { return 0x8000u64; }
    if w == 32u32 { return 0x80000000u64; }
    0x8000000000000000u64
}

fn ex_col(thir: mut_view<Thir>, tv: mut_view<TypeVarTable>, ty_v: usize) -> ExCol {
    let mut c = ExCol {
        cat: EXC_OPAQUE,
        t: 0 as *mut AxType,
        dom_lo_lo: 0u64,
        dom_lo_hi: 0u64,
        dom_hi_lo: 0u64,
        dom_hi_hi: 0u64,
        is_signed: false,
        is_char: false,
    };
    if ty_v == 0 {
        return c;
    }
    let resolved = type_vars_resolve(mut_view(*tv), view(thir.interner), TypeId { v: ty_v as u32 });
    if resolved.v == 0u32 {
        return c;
    }
    let t = type_get(view(thir.interner), TypeId { v: resolved.v });
    if (t as usize) == 0 {
        return c;
    }
    c.t = t;
    let tk = unsafe { (*t).kind };
    if tk == TY_TUPLE || tk == TY_STRUCT || tk == TY_UNIT {
        c.cat = EXC_SINGLE;
    } else if tk == TY_BOOL {
        c.cat = EXC_BOOL;
    } else if tk == TY_ENUM {
        c.cat = EXC_ENUM;
    } else if tk == TY_CHAR {
        c.cat = EXC_INT;
        c.is_char = true;
        c.dom_lo_lo = 0u64;
        c.dom_lo_hi = 0u64;
        c.dom_hi_lo = 0x10ffffu64;
        c.dom_hi_hi = 0u64;
    } else {
        let w = ex_int_width(tk);
        if w != 0u32 {
            c.cat = EXC_INT;
            if exhaust_is_signed_kind(tk) {
                c.is_signed = true;
                if w == 128u32 {
                    c.dom_lo_lo = 0u64;
                    c.dom_lo_hi = 0u64;
                    c.dom_hi_lo = 0xffffffffffffffffu64;
                    c.dom_hi_hi = 0xffffffffffffffffu64;
                } else {
                    let half = ex_half(w);
                    c.dom_lo_lo = (0xffffffffffffffffu64 - half) + 1u64;
                    c.dom_lo_hi = 0x7fffffffffffffffu64;
                    c.dom_hi_lo = half - 1u64;
                    c.dom_hi_hi = 0x8000000000000000u64;
                }
            } else {
                c.dom_lo_lo = 0u64;
                c.dom_lo_hi = 0u64;
                if w == 128u32 {
                    c.dom_hi_lo = 0xffffffffffffffffu64;
                    c.dom_hi_hi = 0xffffffffffffffffu64;
                } else if w == 64u32 {
                    c.dom_hi_lo = 0xffffffffffffffffu64;
                    c.dom_hi_hi = 0u64;
                } else {
                    let half = ex_half(w);
                    c.dom_hi_lo = half + half - 1u64;
                    c.dom_hi_hi = 0u64;
                }
            }
        }
    }
    c
}

// Resolves enum variant index from symbol/span-text/name when `thir.pat_variants` was not populated (direct HIR tests).
fn ex_resolve_variant_fallback(
    col: ExCol,
    pat: *const HirPat,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    out_idx: mut_view<usize>
) -> bool {
    let def = unsafe { (*col.t).def as *const HirItem };
    let count = unsafe { (*col.t).variant_count };
    if (def as usize) == 0 || count == 0 {
        return false;
    }
    let p_file_v = unsafe { (*pat).path.span.file.v };
    let p_start = unsafe { (*pat).path.span.start };
    let p_end = unsafe { (*pat).path.span.end };
    let p_name_v = unsafe { (*pat).path.name.v };
    let p_sym_v = unsafe { (*pat).path.symbol.v };

    let mut ptext_ptr: *const u8 = 0 as *const u8;
    let mut ptext_len: usize = 0;
    if p_file_v != 0u32 && (db.files as usize) != 0 {
        let ftext = source_db_text(db, FileId { v: p_file_v });
        if (ftext.ptr as usize) != 0 && p_start <= p_end && (p_end as usize) <= ftext.len {
            ptext_ptr = ((ftext.ptr as usize) + (p_start as usize)) as *const u8;
            ptext_len = (p_end - p_start) as usize;
        }
    }

    let mut vname_ptr: *const u8 = ptext_ptr;
    let mut vname_len: usize = ptext_len;
    let mut ename_ptr: *const u8 = 0 as *const u8;
    let mut ename_len: usize = 0;

    let mut bi: usize = 0;
    while (bi < ptext_len) {
        if (unsafe { *(ptext_ptr + bi) }) == 46u8 {
            ename_ptr = ptext_ptr;
            ename_len = bi;
            vname_ptr = unsafe { ptext_ptr + (bi + 1) };
            vname_len = ptext_len - bi - 1;
        }
        bi = bi + 1;
    }

    if vname_len == 0 && p_name_v != 0u32 {
        let nv = interner_get(str_in, StrId { v: p_name_v });
        vname_ptr = nv.ptr;
        vname_len = nv.len;
    }

    let def_name_v = unsafe { (*def).name.v };
    let mut v = unsafe { (*def).variants as *const HirVariantDecl };
    let mut vidx: usize = 0;
    while ((v as usize) != 0 && vidx < count) {
        let v_sym_v = unsafe { (*v).symbol.v };
        let v_name_v = unsafe { (*v).name.v };
        let sym_matched = p_sym_v != 0u32 && v_sym_v != 0u32 && v_sym_v == p_sym_v;
        let mut text_matched = false;
        if !sym_matched && (p_sym_v == 0u32 || v_sym_v == 0u32) {
            let var_name = interner_get(str_in, StrId { v: v_name_v });
            let mut enum_matches = true;
            if ename_len > 0 && def_name_v != 0u32 {
                let def_name = interner_get(str_in, StrId { v: def_name_v });
                if def_name.len != ename_len || !exhaust_bytes_eq(def_name.ptr, ename_ptr, ename_len) {
                    enum_matches = false;
                }
            }
            if enum_matches && var_name.len == vname_len && exhaust_bytes_eq(var_name.ptr, vname_ptr, vname_len) {
                text_matched = true;
            }
        }
        if sym_matched || text_matched {
            *out_idx = vidx;
            return true;
        }
        v = unsafe { (*v).next as *const HirVariantDecl };
        vidx = vidx + 1;
    }
    false
}

fn ex_head(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    col: ExCol,
    pat: *const HirPat
) -> ExHead {
    let mut h = ExHead { kind: EXH_UNKNOWN, ctor: 0, lo_lo: 0u64, lo_hi: 0u64, hi_lo: 0u64, hi_hi: 0u64 };
    if (pat as usize) == 0 {
        h.kind = EXH_WILD;
        return h;
    }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_WILDCARD || pk == HIR_PAT_BINDING {
        h.kind = EXH_WILD;
        return h;
    }
    if pk == HIR_PAT_OR {
        h.kind = EXH_OR;
        return h;
    }
    if col.cat == EXC_SINGLE {
        let tk = unsafe { (*col.t).kind };
        if (tk == TY_TUPLE && pk == HIR_PAT_TUPLE) ||
           (tk == TY_UNIT && pk == HIR_PAT_TUPLE && (unsafe { (*pat).elems as usize }) == 0) ||
           (tk == TY_STRUCT && (pk == HIR_PAT_STRUCT || pk == HIR_PAT_PATH)) {
            h.kind = EXH_CTOR;
        }
        return h;
    }
    if col.cat == EXC_BOOL {
        if pk == HIR_PAT_LITERAL {
            let tok_k = unsafe { (*pat).tok.kind };
            if tok_k == TOK_KW_TRUE {
                h.kind = EXH_CTOR;
                h.ctor = 1;
            } else if tok_k == TOK_KW_FALSE {
                h.kind = EXH_CTOR;
                h.ctor = 0;
            }
        }
        return h;
    }
    if col.cat == EXC_ENUM {
        if pk == HIR_PAT_PATH || pk == HIR_PAT_STRUCT {
            let vp = thir_get_pat_variant(view(*thir), pat);
            if (vp as usize) != 0 {
                let vi = (unsafe { *vp }) as usize;
                if (vi < unsafe { (*col.t).variant_count }) {
                    h.kind = EXH_CTOR;
                    h.ctor = vi;
                }
            } else {
                let mut fidx: usize = 0;
                if ex_resolve_variant_fallback(col, pat, str_in, db, mut_view(fidx)) {
                    h.kind = EXH_CTOR;
                    h.ctor = fidx;
                }
            }
        }
        return h;
    }
    if col.cat == EXC_INT {
        let mut iv = PatInterval128 { start_lo: 0u64, start_hi: 0u64, end_lo: 0u64, end_hi: 0u64 };
        if get_pat_interval_128(pat, col.is_signed, mut_view(iv)) {
            let empty128 = !exhaust_u128_le(iv.start_lo, iv.start_hi, iv.end_lo, iv.end_hi, col.is_signed);
            if empty128 {
                h.kind = EXH_EMPTY;
                return h;
            }
            let mut lo_lo = iv.start_lo;
            let mut lo_hi = iv.start_hi;
            let mut hi_lo = iv.end_lo;
            let mut hi_hi = iv.end_hi;
            if col.is_signed {
                lo_hi = lo_hi ^ 0x8000000000000000u64;
                hi_hi = hi_hi ^ 0x8000000000000000u64;
            }
            if ex_u128_lt(lo_lo, lo_hi, col.dom_lo_lo, col.dom_lo_hi) {
                lo_lo = col.dom_lo_lo;
                lo_hi = col.dom_lo_hi;
            }
            if ex_u128_lt(col.dom_hi_lo, col.dom_hi_hi, hi_lo, hi_hi) {
                hi_lo = col.dom_hi_lo;
                hi_hi = col.dom_hi_hi;
            }
            if !ex_u128_lt(hi_lo, hi_hi, lo_lo, lo_hi) {
                h.kind = EXH_RANGE;
                h.lo_lo = lo_lo;
                h.lo_hi = lo_hi;
                h.hi_lo = hi_lo;
                h.hi_hi = hi_hi;
            }
        }
        return h;
    }
    h
}

fn ex_arity(col: ExCol, ctor: usize) -> usize {
    if col.cat == EXC_SINGLE {
        return unsafe { (*col.t).field_count };
    }
    if col.cat == EXC_ENUM {
        let counts = unsafe { (*col.t).variant_field_counts };
        if (counts as usize) == 0 { return 0; }
        return unsafe { *usize_at(counts, ctor) };
    }
    0
}

fn ex_field_ty(col: ExCol, ctor: usize, i: usize) -> usize {
    if col.cat == EXC_SINGLE {
        let f = unsafe { (*col.t).fields };
        if (f as usize) == 0 { return 0; }
        return (unsafe { (*typeid_at(f, i)).v }) as usize;
    }
    if col.cat == EXC_ENUM {
        let vf = unsafe { (*col.t).variant_fields };
        if (vf as usize) == 0 { return 0; }
        let row = unsafe { *typeid_ptr_at(vf, ctor) };
        if (row as usize) == 0 { return 0; }
        return (unsafe { (*typeid_at(row, i)).v }) as usize;
    }
    0
}

fn ex_nth_pat(first: *const HirPat, i: usize) -> *const HirPat {
    let mut p = first;
    let mut k: usize = 0;
    while ((p as usize) != 0 && k < i) {
        p = unsafe { (*p).next as *const HirPat };
        k = k + 1;
    }
    p
}

fn ex_nth_field_decl(first: *const HirFieldDecl, i: usize) -> *const HirFieldDecl {
    let mut f = first;
    let mut k: usize = 0;
    while ((f as usize) != 0 && k < i) {
        f = unsafe { (*f).next as *const HirFieldDecl };
        k = k + 1;
    }
    f
}

// The sub-pattern a struct-like pattern gives the declared field `decl`; null (wildcard) when it is not named.
fn ex_named_field_pat(pat: *const HirPat, decl: *const HirFieldDecl) -> *const HirPat {
    if (decl as usize) == 0 {
        return 0 as *const HirPat;
    }
    let want = unsafe { (*decl).name.v };
    let mut pf = unsafe { (*pat).fields as *const HirPatField };
    while ((pf as usize) != 0) {
        if (unsafe { (*pf).name.v }) == want {
            return unsafe { (*pf).pat as *const HirPat };
        }
        pf = unsafe { (*pf).next as *const HirPatField };
    }
    0 as *const HirPat
}

// Sub-pattern of `pat` for field `i` of the constructor `ctor`; null means wildcard.
fn ex_sub_pat(col: ExCol, ctor: usize, pat: *const HirPat, i: usize) -> *const HirPat {
    if (pat as usize) == 0 {
        return 0 as *const HirPat;
    }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_WILDCARD || pk == HIR_PAT_BINDING {
        return 0 as *const HirPat;
    }
    if pk == HIR_PAT_TUPLE {
        return ex_nth_pat(unsafe { (*pat).elems as *const HirPat }, i);
    }
    if col.cat == EXC_SINGLE && pk == HIR_PAT_STRUCT {
        let def = unsafe { (*col.t).def as *const HirItem };
        if (def as usize) == 0 { return 0 as *const HirPat; }
        let fd = ex_nth_field_decl(unsafe { (*def).struct_fields as *const HirFieldDecl }, i);
        return ex_named_field_pat(pat, fd);
    }
    if col.cat == EXC_ENUM {
        if pk == HIR_PAT_PATH {
            let payload = unsafe { (*pat).payload as *const HirPat };
            if (payload as usize) == 0 { return 0 as *const HirPat; }
            if (unsafe { (*payload).kind }) == HIR_PAT_TUPLE {
                return ex_nth_pat(unsafe { (*payload).elems as *const HirPat }, i);
            }
            if i == 0 { return payload; }
            return 0 as *const HirPat;
        }
        if pk == HIR_PAT_STRUCT {
            let def = unsafe { (*col.t).def as *const HirItem };
            if (def as usize) == 0 { return 0 as *const HirPat; }
            let mut v = unsafe { (*def).variants as *const HirVariantDecl };
            let mut k: usize = 0;
            while ((v as usize) != 0 && k < ctor) {
                v = unsafe { (*v).next as *const HirVariantDecl };
                k = k + 1;
            }
            if (v as usize) == 0 { return 0 as *const HirPat; }
            let fd = ex_nth_field_decl(unsafe { (*v).struct_fields as *const HirFieldDecl }, i);
            return ex_named_field_pat(pat, fd);
        }
    }
    0 as *const HirPat
}

fn ex_is_or(pat: *const HirPat) -> bool {
    (pat as usize) != 0 && (unsafe { (*pat).kind }) == HIR_PAT_OR
}

// Number of leaf alternatives of a (possibly nested) or-pattern.
fn ex_or_count(pat: *const HirPat) -> usize {
    if !ex_is_or(pat) {
        return 1;
    }
    let mut n: usize = 0;
    let mut p = unsafe { (*pat).pats as *const HirPat };
    while ((p as usize) != 0) {
        n = n + ex_or_count(p);
        p = unsafe { (*p).next as *const HirPat };
    }
    n
}

fn ex_or_fill(pat: *const HirPat, out: *mut usize, idx: mut_view<usize>) {
    if !ex_is_or(pat) {
        ex_set(out, *idx, pat as usize);
        *idx = *idx + 1;
        return;
    }
    let mut p = unsafe { (*pat).pats as *const HirPat };
    while ((p as usize) != 0) {
        ex_or_fill(p, out, mut_view(*idx));
        p = unsafe { (*p).next as *const HirPat };
    }
}

// Expand or-patterns in column 0 into one row per alternative.
fn ex_expand_or(thir: mut_view<Thir>, m: ExMat) -> ExMat {
    let mut total: usize = 0;
    let mut has_or = false;
    let mut r: usize = 0;
    while (r < m.n) {
        let p = ex_get(m.cells, r * m.w) as *const HirPat;
        if ex_is_or(p) { has_or = true; }
        total = total + ex_or_count(p);
        r = r + 1;
    }
    if !has_or {
        return m;
    }
    let cells = ex_alloc(mut_view(*thir), total * m.w);
    let leaves = ex_alloc(mut_view(*thir), total);
    let mut out_r: usize = 0;
    r = 0;
    while (r < m.n) {
        let p = ex_get(m.cells, r * m.w) as *const HirPat;
        let mut nl: usize = 0;
        ex_or_fill(p, leaves, mut_view(nl));
        let mut l: usize = 0;
        while (l < nl) {
            ex_set(cells, out_r * m.w, ex_get(leaves, l));
            let mut c: usize = 1;
            while (c < m.w) {
                ex_set(cells, out_r * m.w + c, ex_get(m.cells, r * m.w + c));
                c = c + 1;
            }
            out_r = out_r + 1;
            l = l + 1;
        }
        r = r + 1;
    }
    ExMat { cells: cells, n: out_r, w: m.w }
}

// Row tails (columns 1..w) of the rows whose head is a wildcard: the default matrix D(P).
fn ex_default(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    col: ExCol,
    m: ExMat
) -> ExMat {
    let nw = m.w - 1;
    let cells = ex_alloc(mut_view(*thir), m.n * nw);
    let mut n: usize = 0;
    let mut r: usize = 0;
    while (r < m.n) {
        let h = ex_head(mut_view(*thir), str_in, db, col, ex_get(m.cells, r * m.w) as *const HirPat);
        if h.kind == EXH_WILD {
            let mut c: usize = 0;
            while (c < nw) {
                ex_set(cells, n * nw + c, ex_get(m.cells, r * m.w + 1 + c));
                c = c + 1;
            }
            n = n + 1;
        }
        r = r + 1;
    }
    ExMat { cells: cells, n: n, w: nw }
}

// Specialisation S(ctor, P) for SINGLE/BOOL/ENUM columns: rows headed by `ctor` or a wildcard, with the head
// replaced by its `arity` fields.
fn ex_specialize(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    col: ExCol,
    ctor: usize,
    arity: usize,
    m: ExMat
) -> ExMat {
    let nw = arity + m.w - 1;
    let cells = ex_alloc(mut_view(*thir), m.n * nw);
    let mut n: usize = 0;
    let mut r: usize = 0;
    while (r < m.n) {
        let p = ex_get(m.cells, r * m.w) as *const HirPat;
        let h = ex_head(mut_view(*thir), str_in, db, col, p);
        if h.kind == EXH_WILD || (h.kind == EXH_CTOR && h.ctor == ctor) {
            let mut i: usize = 0;
            while (i < arity) {
                let sp = if h.kind == EXH_WILD { 0 as *const HirPat } else { ex_sub_pat(col, ctor, p, i) };
                ex_set(cells, n * nw + i, sp as usize);
                i = i + 1;
            }
            let mut c: usize = 1;
            while (c < m.w) {
                ex_set(cells, n * nw + arity + c - 1, ex_get(m.cells, r * m.w + c));
                c = c + 1;
            }
            n = n + 1;
        }
        r = r + 1;
    }
    ExMat { cells: cells, n: n, w: nw }
}

// Specialisation for the integer segment starting at `(seg_lo, seg_hi)`: rows whose head is a wildcard or an
// interval containing the segment (segments never straddle an interval boundary).
fn ex_specialize_seg(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    col: ExCol,
    seg_lo: u64,
    seg_hi: u64,
    m: ExMat
) -> ExMat {
    let nw = m.w - 1;
    let cells = ex_alloc(mut_view(*thir), m.n * nw);
    let mut n: usize = 0;
    let mut r: usize = 0;
    while (r < m.n) {
        let h = ex_head(mut_view(*thir), str_in, db, col, ex_get(m.cells, r * m.w) as *const HirPat);
        if h.kind == EXH_WILD ||
           (h.kind == EXH_RANGE &&
            ex_u128_le(h.lo_lo, h.lo_hi, seg_lo, seg_hi) &&
            ex_u128_le(seg_lo, seg_hi, h.hi_lo, h.hi_hi)) {
            let mut c: usize = 0;
            while (c < nw) {
                ex_set(cells, n * nw + c, ex_get(m.cells, r * m.w + 1 + c));
                c = c + 1;
            }
            n = n + 1;
        }
        r = r + 1;
    }
    ExMat { cells: cells, n: n, w: nw }
}

// q with its head replaced by the `arity` fields of `ctor`.
fn ex_specialize_q(thir: mut_view<Thir>, col: ExCol, ctor: usize, arity: usize, q: *mut usize, w: usize) -> *mut usize {
    let nq = ex_alloc(mut_view(*thir), arity + w - 1);
    let p = ex_get(q, 0) as *const HirPat;
    let mut i: usize = 0;
    while (i < arity) {
        ex_set(nq, i, ex_sub_pat(col, ctor, p, i) as usize);
        i = i + 1;
    }
    let mut c: usize = 1;
    while (c < w) {
        ex_set(nq, arity + c - 1, ex_get(q, c));
        c = c + 1;
    }
    nq
}

fn ex_tys_for_ctor(thir: mut_view<Thir>, col: ExCol, ctor: usize, arity: usize, tys: *mut usize, w: usize) -> *mut usize {
    let nt = ex_alloc(mut_view(*thir), arity + w - 1);
    let mut i: usize = 0;
    while (i < arity) {
        ex_set(nt, i, ex_field_ty(col, ctor, i));
        i = i + 1;
    }
    let mut c: usize = 1;
    while (c < w) {
        ex_set(nt, arity + c - 1, ex_get(tys, c));
        c = c + 1;
    }
    nt
}

fn ex_useful_ctor(
    thir: mut_view<Thir>,
    tv: mut_view<TypeVarTable>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    col: ExCol,
    ctor: usize,
    m: ExMat,
    tys: *mut usize,
    q: *mut usize,
    depth: u32
) -> bool {
    let arity = ex_arity(col, ctor);
    let sm = ex_specialize(mut_view(*thir), str_in, db, col, ctor, arity, m);
    let sq = ex_specialize_q(mut_view(*thir), col, ctor, arity, q, m.w);
    let st = ex_tys_for_ctor(mut_view(*thir), col, ctor, arity, tys, m.w);
    ex_useful(mut_view(*thir), mut_view(*tv), str_in, db, sm, st, sq, depth + 1u32)
}

fn ex_tail(q: *mut usize) -> *mut usize {
    unsafe { usize_at(q, 1) }
}

// Sorted, de-duplicated 128-bit segment start points of an integer/char column: dom_lo, surrogate boundaries
// for char, every interval start, and every interval end + 1 (clamped to the domain), over `m` and `qh`.
fn ex_int_segments(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    col: ExCol,
    m: ExMat,
    qh: ExHead,
    out_n: mut_view<usize>
) -> *mut ExPt128 {
    let cap = 2 * m.n + 6;
    let pts = ex_alloc_pts(mut_view(*thir), cap);
    let mut n: usize = 0;
    ex_set_pt(pts, n, col.dom_lo_lo, col.dom_lo_hi);
    n = n + 1;
    if col.is_char {
        ex_set_pt(pts, n, 0xd800u64, 0u64);
        n = n + 1;
        ex_set_pt(pts, n, 0xe000u64, 0u64);
        n = n + 1;
    }
    let mut r: usize = 0;
    while (r <= m.n) {
        let mut h = qh;
        if (r < m.n) {
            h = ex_head(mut_view(*thir), str_in, db, col, ex_get(m.cells, r * m.w) as *const HirPat);
        }
        if h.kind == EXH_RANGE {
            ex_set_pt(pts, n, h.lo_lo, h.lo_hi);
            n = n + 1;
            if ex_u128_lt(h.hi_lo, h.hi_hi, col.dom_hi_lo, col.dom_hi_hi) {
                let mut nlo: u64 = 0u64;
                let mut nhi: u64 = 0u64;
                ex_u128_inc(h.hi_lo, h.hi_hi, mut_view(nlo), mut_view(nhi));
                ex_set_pt(pts, n, nlo, nhi);
                n = n + 1;
            }
        }
        r = r + 1;
    }
    let mut i: usize = 1;
    while (i < n) {
        let key = ex_get_pt(pts, i);
        let mut j = i;
        while (j > 0) {
            let prev = ex_get_pt(pts, j - 1);
            if !ex_u128_lt(key.lo, key.hi, prev.lo, prev.hi) {
                break;
            }
            ex_set_pt(pts, j, prev.lo, prev.hi);
            j = j - 1;
        }
        ex_set_pt(pts, j, key.lo, key.hi);
        i = i + 1;
    }
    let mut u: usize = 0;
    i = 0;
    while (i < n) {
        let cur = ex_get_pt(pts, i);
        if u == 0 {
            ex_set_pt(pts, u, cur.lo, cur.hi);
            u = u + 1;
        } else {
            let prev_u = ex_get_pt(pts, u - 1);
            if !ex_u128_eq(prev_u.lo, prev_u.hi, cur.lo, cur.hi) {
                ex_set_pt(pts, u, cur.lo, cur.hi);
                u = u + 1;
            }
        }
        i = i + 1;
    }
    *out_n = u;
    pts
}

fn ex_is_char_surrogate(col: ExCol, lo: u64, hi: u64) -> bool {
    col.is_char && hi == 0u64 && lo >= 0xd800u64 && lo <= 0xdfffu64
}

fn ex_useful_int(
    thir: mut_view<Thir>,
    tv: mut_view<TypeVarTable>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    col: ExCol,
    m: ExMat,
    tys: *mut usize,
    q: *mut usize,
    qh: ExHead,
    depth: u32
) -> bool {
    let mut ns: usize = 0;
    let pts = ex_int_segments(mut_view(*thir), str_in, db, col, m, qh, mut_view(ns));
    if qh.kind == EXH_WILD {
        // A valid segment that no interval head covers is matched only by the wildcard rows: D(P).
        let mut s: usize = 0;
        while (s < ns) {
            let pt = ex_get_pt(pts, s);
            if !ex_is_char_surrogate(col, pt.lo, pt.hi) {
                let mut covered = false;
                let mut r: usize = 0;
                while (r < m.n) {
                    let h = ex_head(mut_view(*thir), str_in, db, col, ex_get(m.cells, r * m.w) as *const HirPat);
                    if h.kind == EXH_RANGE &&
                       ex_u128_le(h.lo_lo, h.lo_hi, pt.lo, pt.hi) &&
                       ex_u128_le(pt.lo, pt.hi, h.hi_lo, h.hi_hi) {
                        covered = true;
                        break;
                    }
                    r = r + 1;
                }
                if !covered {
                    let dm = ex_default(mut_view(*thir), str_in, db, col, m);
                    return ex_useful(mut_view(*thir), mut_view(*tv), str_in, db, dm, ex_tail(tys), ex_tail(q), depth + 1u32);
                }
            }
            s = s + 1;
        }
    }
    let mut s: usize = 0;
    while (s < ns) {
        let pt = ex_get_pt(pts, s);
        if !ex_is_char_surrogate(col, pt.lo, pt.hi) {
            if qh.kind == EXH_WILD ||
               (ex_u128_le(qh.lo_lo, qh.lo_hi, pt.lo, pt.hi) &&
                ex_u128_le(pt.lo, pt.hi, qh.hi_lo, qh.hi_hi)) {
                let sm = ex_specialize_seg(mut_view(*thir), str_in, db, col, pt.lo, pt.hi, m);
                if ex_useful(mut_view(*thir), mut_view(*tv), str_in, db, sm, ex_tail(tys), ex_tail(q), depth + 1u32) {
                    return true;
                }
            }
        }
        s = s + 1;
    }
    false
}

fn ex_useful(
    thir: mut_view<Thir>,
    tv: mut_view<TypeVarTable>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    m0: ExMat,
    tys: *mut usize,
    q: *mut usize,
    depth: u32
) -> bool {
    if m0.w == 0 {
        return m0.n == 0;
    }
    if depth > EX_MAX_DEPTH {
        return true;
    }
    let col = ex_col(mut_view(*thir), mut_view(*tv), ex_get(tys, 0));
    let qp = ex_get(q, 0) as *const HirPat;
    let qh = ex_head(mut_view(*thir), str_in, db, col, qp);
    if qh.kind == EXH_OR {
        let w = m0.w;
        let mut alt = unsafe { (*qp).pats as *const HirPat };
        while ((alt as usize) != 0) {
            let nq = ex_alloc(mut_view(*thir), w);
            ex_set(nq, 0, alt as usize);
            let mut c: usize = 1;
            while (c < w) {
                ex_set(nq, c, ex_get(q, c));
                c = c + 1;
            }
            if ex_useful(mut_view(*thir), mut_view(*tv), str_in, db, m0, tys, nq, depth + 1u32) {
                return true;
            }
            alt = unsafe { (*alt).next as *const HirPat };
        }
        return false;
    }
    if qh.kind == EXH_EMPTY {
        return false;
    }
    let m = ex_expand_or(mut_view(*thir), m0);
    if qh.kind == EXH_UNKNOWN {
        let dm = ex_default(mut_view(*thir), str_in, db, col, m);
        return ex_useful(mut_view(*thir), mut_view(*tv), str_in, db, dm, ex_tail(tys), ex_tail(q), depth + 1u32);
    }
    if qh.kind == EXH_CTOR {
        return ex_useful_ctor(mut_view(*thir), mut_view(*tv), str_in, db, col, qh.ctor, m, tys, q, depth);
    }
    if col.cat == EXC_INT {
        return ex_useful_int(mut_view(*thir), mut_view(*tv), str_in, db, col, m, tys, q, qh, depth);
    }
    // q's head is a wildcard.
    if col.cat == EXC_SINGLE {
        return ex_useful_ctor(mut_view(*thir), mut_view(*tv), str_in, db, col, 0, m, tys, q, depth);
    }
    if col.cat == EXC_BOOL || col.cat == EXC_ENUM {
        let nctor = if col.cat == EXC_BOOL { 2 } else { unsafe { (*col.t).variant_count } };
        let seen = arena_alloc_raw(mut_view(thir.interner.arena), if nctor > 0 { nctor } else { 1 }, 1);
        let mut z: usize = 0;
        while (z < nctor) {
            unsafe { *(seen + z) = 0u8; }
            z = z + 1;
        }
        let mut nseen: usize = 0;
        let mut r: usize = 0;
        while (r < m.n) {
            let h = ex_head(mut_view(*thir), str_in, db, col, ex_get(m.cells, r * m.w) as *const HirPat);
            let h_ctor = h.ctor;
            if (h.kind == EXH_CTOR && h_ctor < nctor) {
                if (unsafe { *(seen + h.ctor) }) == 0u8 {
                    unsafe { *(seen + h.ctor) = 1u8; }
                    nseen = nseen + 1;
                }
            }
            r = r + 1;
        }
        if nseen == nctor {
            let mut c: usize = 0;
            while (c < nctor) {
                if ex_useful_ctor(mut_view(*thir), mut_view(*tv), str_in, db, col, c, m, tys, q, depth) {
                    return true;
                }
                c = c + 1;
            }
            return false;
        }
    }
    let dm = ex_default(mut_view(*thir), str_in, db, col, m);
    ex_useful(mut_view(*thir), mut_view(*tv), str_in, db, dm, ex_tail(tys), ex_tail(q), depth + 1u32)
}

pub fn match_check_exhaustiveness_with_tv(
    thir: mut_view<Thir>,
    tv: mut_view<TypeVarTable>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    expr: *const HirExpr,
    val_ty: TypeId
) {
    if (expr as usize) == 0 {
        return;
    }
    if (unsafe { (*expr).kind }) != HIR_EXPR_MATCH {
        return;
    }
    let r_ty = type_vars_resolve(mut_view(*tv), view(thir.interner), TypeId { v: val_ty.v });
    let t = type_get(view(thir.interner), TypeId { v: r_ty.v });
    if (t as usize) == 0 {
        return;
    }
    if (unsafe { (*t).kind }) == TY_ERROR {
        return;
    }

    let mut total: usize = 0;
    let mut arm = unsafe { (*expr).arms as *const HirMatchArm };
    while ((arm as usize) != 0) {
        total = total + ex_or_count(unsafe { (*arm).pat as *const HirPat });
        arm = unsafe { (*arm).next as *const HirMatchArm };
    }

    let tys = ex_alloc(mut_view(*thir), 1);
    ex_set(tys, 0, r_ty.v as usize);
    let rows = ex_alloc(mut_view(*thir), total);
    let leaves = ex_alloc(mut_view(*thir), total);
    let mut n_rows: usize = 0;

    arm = unsafe { (*expr).arms as *const HirMatchArm };
    while ((arm as usize) != 0) {
        let ap = unsafe { (*arm).pat as *const HirPat };
        let has_guard = (unsafe { (*arm).guard as usize }) != 0;
        if (ap as usize) != 0 {
            let mut nl: usize = 0;
            ex_or_fill(ap, leaves, mut_view(nl));
            let mut l: usize = 0;
            while (l < nl) {
                let leaf = ex_get(leaves, l) as *const HirPat;
                let q = ex_alloc(mut_view(*thir), 1);
                ex_set(q, 0, leaf as usize);
                let pm = ExMat { cells: rows, n: n_rows, w: 1 };
                if (leaf as usize) != 0 && !ex_useful(mut_view(*thir), mut_view(*tv), str_in, db, pm, tys, q, 0u32) {
                    let l_fv = unsafe { (*leaf).span.file.v };
                    let l_st = unsafe { (*leaf).span.start };
                    let l_en = unsafe { (*leaf).span.end };
                    emit_pat_unreachable(mut_view(*sink), l_fv, l_st, l_en);
                }
                if !has_guard {
                    ex_set(rows, n_rows, leaf as usize);
                    n_rows = n_rows + 1;
                }
                l = l + 1;
            }
        }
        arm = unsafe { (*arm).next as *const HirMatchArm };
    }

    let wq = ex_alloc(mut_view(*thir), 1);
    ex_set(wq, 0, 0);
    let pm = ExMat { cells: rows, n: n_rows, w: 1 };
    if ex_useful(mut_view(*thir), mut_view(*tv), str_in, db, pm, tys, wq, 0u32) {
        let fv = unsafe { (*expr).span.file.v };
        let st = unsafe { (*expr).span.start };
        let en = unsafe { (*expr).span.end };
        emit_pat_non_exhaustive(mut_view(*sink), fv, st, en);
    }
}

pub fn match_check_exhaustiveness(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    expr: *const HirExpr,
    val_ty: TypeId
) {
    let mut empty_tv = TypeVarTable {
        items: 0 as *mut TypeVarEntry,
        len: 0,
        cap: 0,
        fn_var_start: 0,
    };
    match_check_exhaustiveness_with_tv(
        mut_view(*thir),
        mut_view(empty_tv),
        str_in,
        db,
        mut_view(*sink),
        expr,
        TypeId { v: val_ty.v }
    );
}
