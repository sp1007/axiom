    60u8, 98u8, 117u8, 105u8, 108u8, 116u8, 105u8, 110u8, 58u8, 112u8, 114u8, 105u8, 110u8, 116u8, 95u8, 105u8, 110u8, 116u8, 62u8,
    102u8, 110u8, 40u8,
    44u8, 32u8,
    41u8, 32u8, 45u8, 62u8, 32u8,
    63u8, 105u8, 110u8, 116u8,
    62u8,
];

const THIR_OFF: [114]u32 = [
    0u32, 2u32, 4u32, 7u32, 12u32, 18u32, 20u32, 30u32, 33u32, 38u32, 42u32, 54u32,
    65u32, 69u32, 76u32, 86u32, 98u32, 107u32, 112u32, 121u32, 129u32, 138u32, 147u32, 156u32,
    164u32, 171u32, 177u32, 184u32, 192u32, 200u32, 211u32, 219u32, 229u32, 239u32, 246u32, 254u32,
    259u32, 268u32, 277u32, 288u32, 296u32, 305u32, 314u32, 324u32, 333u32, 342u32, 348u32, 357u32,
    365u32, 373u32, 382u32, 389u32, 399u32, 407u32, 419u32, 427u32, 438u32, 443u32, 452u32, 462u32,
    471u32, 479u32, 488u32, 502u32, 510u32, 524u32, 533u32, 540u32, 549u32, 556u32, 565u32, 572u32,
    582u32, 590u32, 599u32, 609u32, 616u32, 622u32, 632u32, 641u32, 649u32, 660u32, 669u32, 677u32,
    690u32, 699u32, 709u32, 724u32,
    736u32, 743u32, 748u32, 750u32, 755u32, 759u32, 763u32, 765u32, 768u32, 771u32, 774u32, 779u32,
    781u32, 784u32, 787u32, 790u32, 795u32, 798u32, 811u32, 826u32, 845u32, 848u32, 850u32, 855u32,
    859u32, 860u32,
];

struct ThirDumpState {
    buf: *mut DiagBuffer,
    interner: *const StrInterner,
    thir: *const Thir,
    hir_items: *mut HirItem,
    indent: i32,
    filter_file: FileId,
}

fn td_str(st: mut_view<ThirDumpState>, idx: usize) {
    let start = THIR_OFF[idx] as usize;
    let end = THIR_OFF[idx + 1] as usize;
    let mut i = start;
    while (i < end) {
        unsafe { diag_buf_push_byte(mut_view(*st.buf), THIR_DATA[i]); }
        i = i + 1;
    }
}

fn td_nl(st: mut_view<ThirDumpState>) {
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 10u8); }
    let mut i: i32 = 0;
    while (i < st.indent) {
        td_str(mut_view(*st), 0);
        i = i + 1;
    }
}

fn td_begin(st: mut_view<ThirDumpState>, idx: usize) {
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 40u8); }
    td_str(mut_view(*st), idx);
    st.indent = st.indent + 1;
}

fn td_end(st: mut_view<ThirDumpState>) {
    st.indent = st.indent - 1;
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 41u8); }
}

fn td_strid(st: mut_view<ThirDumpState>, id: StrId) {
    if id.v == 0u32 {
        td_str(mut_view(*st), 2);
        return;
    }
    let sv = unsafe { interner_get(view(*st.interner), (StrId { v: id.v })) };
    td_str(mut_view(*st), 1);
    unsafe {
        diag_buf_push_bytes(mut_view(*st.buf), sv.ptr, sv.len);
        diag_buf_push_byte(mut_view(*st.buf), 34u8);
    }
}

fn td_bool(st: mut_view<ThirDumpState>, b: bool) {
    if b {
        td_str(mut_view(*st), 3);
    } else {
        td_str(mut_view(*st), 4);
    }
}

fn td_u32(st: mut_view<ThirDumpState>, v: u32) {
    unsafe {
        diag_buf_push_byte(mut_view(*st.buf), 32u8);
        diag_buf_push_u32(mut_view(*st.buf), v);
    }
}

fn td_symbol(st: mut_view<ThirDumpState>, sym: SymbolId) {
    if sym.v != 0u32 {
        td_str(mut_view(*st), 5);
        unsafe { diag_buf_push_u32(mut_view(*st.buf), sym.v); }
    }
}

fn td_typeid(st: mut_view<ThirDumpState>, id: TypeId) {
    if id.v == 0u32 {
        td_str(mut_view(*st), 87);
        return;
    }
    let t = unsafe { type_get(view((*st.thir).interner), (TypeId { v: id.v })) };
    if (t as usize) == 0 {
        td_str(mut_view(*st), 87);
        return;
    }
    td_str(mut_view(*st), 88);
    let k = unsafe { (*t).kind };
    if k == TY_ERROR {
        td_str(mut_view(*st), 89);
    } else if k == TY_UNIT {
        td_str(mut_view(*st), 90);
    } else if k == TY_NEVER {
        td_str(mut_view(*st), 91);
    } else if k == TY_BOOL {
        td_str(mut_view(*st), 92);
    } else if k == TY_CHAR {
        td_str(mut_view(*st), 93);
    } else if k == TY_I8 {
        td_str(mut_view(*st), 94);
    } else if k == TY_I16 {
        td_str(mut_view(*st), 95);
    } else if k == TY_I32 {
        td_str(mut_view(*st), 96);
    } else if k == TY_I64 {
        td_str(mut_view(*st), 97);
    } else if k == TY_ISIZE {
        td_str(mut_view(*st), 98);
    } else if k == TY_U8 {
        td_str(mut_view(*st), 99);
    } else if k == TY_U16 {
        td_str(mut_view(*st), 100);
    } else if k == TY_U32 {
        td_str(mut_view(*st), 101);
    } else if k == TY_U64 {
        td_str(mut_view(*st), 102);
    } else if k == TY_USIZE {
        td_str(mut_view(*st), 103);
    } else if k == TY_STR {
        td_str(mut_view(*st), 104);
    } else if k == TY_BUILTIN_LEN {
        td_str(mut_view(*st), 105);
    } else if k == TY_BUILTIN_PRINT {
        td_str(mut_view(*st), 106);
    } else if k == TY_BUILTIN_PRINT_INT {
        td_str(mut_view(*st), 107);
    } else if k == TY_FN {
        td_str(mut_view(*st), 108);
        let pcnt = unsafe { (*t).param_count };
        let ptypes: *mut TypeId = unsafe { (*t).param_types };
        let mut i: usize = 0;
        while (i < pcnt) {
            if i > 0 {
                td_str(mut_view(*st), 109);
            }
            let pt_v = unsafe { (*typeid_at(ptypes, i)).v };
            td_typeid(mut_view(*st), (TypeId { v: pt_v }));
            i = i + 1;
        }
        td_str(mut_view(*st), 110);
        let rt_v = unsafe { (*t).ret_type.v };
        td_typeid(mut_view(*st), (TypeId { v: rt_v }));
    } else if k == TY_INT_VAR {
        td_str(mut_view(*st), 111);
        let vid = unsafe { (*t).var_id };
        unsafe { diag_buf_push_u32(mut_view(*st.buf), vid); }
    }
    td_str(mut_view(*st), 112);
}

fn td_maybe_pat_ty(st: mut_view<ThirDumpState>, pat: *const HirPat) {
    let p = unsafe { ptr_typemap_get(view((*st.thir).pat_types), pat as usize) };
    if (p as usize) != 0 {
        let tv = unsafe { (*p).v };
        td_typeid(st, (TypeId { v: tv }));
    }
}

fn td_maybe_expr_ty(st: mut_view<ThirDumpState>, expr: *const HirExpr) {
    let p = unsafe { ptr_typemap_get(view((*st.thir).expr_types), expr as usize) };
    if (p as usize) != 0 {
        let tv = unsafe { (*p).v };
        td_typeid(st, (TypeId { v: tv }));
    }
}

fn td_dotted(st: mut_view<ThirDumpState>, n: view<AstDottedName>) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 6);
    let mut i: usize = 0;
    while (i < n.count) {
        let off = mul_usize(i, size_of<StrId>());
        let seg_ptr = ((n.segments as usize) + off) as *const StrId;
        td_strid(mut_view(*st), unsafe { *seg_ptr });
        i = i + 1;
    }
    td_end(mut_view(*st));
}

fn td_vis(st: mut_view<ThirDumpState>, n: view<HirVis>) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 7);
    if n.kind == HIR_VIS_PRIVATE {
        td_str(mut_view(*st), 8);
    } else if n.kind == HIR_VIS_PUB {
        td_str(mut_view(*st), 9);
    } else if n.kind == HIR_VIS_PUB_PACKAGE {
        td_str(mut_view(*st), 10);
    } else if n.kind == HIR_VIS_PUB_MODULE {
        td_str(mut_view(*st), 11);
    }
    td_end(mut_view(*st));
}

fn td_attr(st: mut_view<ThirDumpState>, n: *mut HirAttr) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 12);
        td_strid(mut_view(*st), unsafe { (*cur).name });
        let mut a: *mut HirAttrArg = unsafe { (*cur).args };
        while ((a as usize) != 0) {
            td_nl(mut_view(*st));
            td_begin(mut_view(*st), 13);
            td_strid(mut_view(*st), unsafe { (*a).name });
            td_expr(mut_view(*st), unsafe { (*a).expr });
            td_end(mut_view(*st));
            a = unsafe { (*a).next };
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_generic_args(st: mut_view<ThirDumpState>, n: *mut HirGenericArgs) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericArg = unsafe { (*n).args };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 14);
        td_strid(mut_view(*st), unsafe { (*a).name });
        td_type(mut_view(*st), unsafe { (*a).ty });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_generic_params(st: mut_view<ThirDumpState>, n: *mut HirGenericParams) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericParam = unsafe { (*n).params };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 15);
        td_strid(mut_view(*st), unsafe { (*a).name });
        td_type(mut_view(*st), unsafe { (*a).bounds });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_where_clause(st: mut_view<ThirDumpState>, n: *mut HirWhereClause) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirWherePred = unsafe { (*n).preds };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 16);
        td_type(mut_view(*st), unsafe { (*a).ty });
        td_type(mut_view(*st), unsafe { (*a).bounds });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_path(st: mut_view<ThirDumpState>, p: view<HirPath>) {
    td_symbol(mut_view(*st), p.symbol);
    td_generic_args(mut_view(*st), p.generic_args);
}

fn td_block(st: mut_view<ThirDumpState>, n: *mut HirBlock) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 17);
    if (n as usize) != 0 {
        td_stmt(mut_view(*st), unsafe { (*n).stmts });
    }
    td_end(mut_view(*st));
}

fn td_type(st: mut_view<ThirDumpState>, n: *mut HirType) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_TYPE_ERROR {
            td_begin(mut_view(*st), 18);
        } else if k == HIR_TYPE_PATH {
            td_begin(mut_view(*st), 19);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
        } else if k == HIR_TYPE_TUPLE {
            td_begin(mut_view(*st), 20);
            td_type(mut_view(*st), unsafe { (*cur).elem_types });
        } else if k == HIR_TYPE_ARRAY {
            td_begin(mut_view(*st), 21);
            let ce: *mut HirExpr = unsafe { (*cur).count_expr };
            if (ce as usize) != 0 && (unsafe { (*ce).kind }) == HIR_EXPR_LITERAL && (unsafe { (*ce).literal.kind }) == TOK_INT && (unsafe { (*ce).next as usize }) == 0 {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 38);
                td_end(mut_view(*st));
            } else {
                td_expr(mut_view(*st), ce);
            }
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_SLICE {
            td_begin(mut_view(*st), 22);
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_VIEW {
            td_begin(mut_view(*st), 23);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_PTR {
            td_begin(mut_view(*st), 24);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_FN {
            td_begin(mut_view(*st), 25);
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            td_type(mut_view(*st), unsafe { (*cur).param_types });
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
        } else if k == HIR_TYPE_DYN {
            td_begin(mut_view(*st), 26);
            td_type(mut_view(*st), unsafe { (*cur).bounds });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_pat_field(st: mut_view<ThirDumpState>, n: *mut HirPatField) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 27);
        td_strid(mut_view(*st), unsafe { (*cur).name });
        td_pat(mut_view(*st), unsafe { (*cur).pat });
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_pat(st: mut_view<ThirDumpState>, n: *mut HirPat) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_PAT_ERROR {
            td_begin(mut_view(*st), 28);
            td_maybe_pat_ty(mut_view(*st), cur);
        } else if k == HIR_PAT_WILDCARD {
            td_begin(mut_view(*st), 29);
            td_maybe_pat_ty(mut_view(*st), cur);
        } else if k == HIR_PAT_RANGE {
            td_begin(mut_view(*st), 30);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_inclusive });
            td_pat(mut_view(*st), unsafe { (*cur).start_pat });
            td_pat(mut_view(*st), unsafe { (*cur).end_pat });
        } else if k == HIR_PAT_LITERAL {
            td_begin(mut_view(*st), 31);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_negated });
        } else if k == HIR_PAT_BINDING {
            td_begin(mut_view(*st), 32);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_symbol(mut_view(*st), unsafe { (*cur).symbol });
        } else if k == HIR_PAT_PATH {
            td_begin(mut_view(*st), 33);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            td_pat(mut_view(*st), unsafe { (*cur).payload });
        } else if k == HIR_PAT_TUPLE {
            td_begin(mut_view(*st), 34);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).elems });
        } else if k == HIR_PAT_OR {
            td_begin(mut_view(*st), 35);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).pats });
        } else if k == HIR_PAT_STRUCT {
            td_begin(mut_view(*st), 36);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            td_pat_field(mut_view(*st), unsafe { (*cur).fields });
            td_bool(mut_view(*st), unsafe { (*cur).has_rest });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_expr(st: mut_view<ThirDumpState>, n: *mut HirExpr) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_ERROR {
            td_begin(mut_view(*st), 37);
            td_maybe_expr_ty(mut_view(*st), cur);
        } else if k == HIR_EXPR_LITERAL {
            td_begin(mut_view(*st), 38);
            td_maybe_expr_ty(mut_view(*st), cur);
        } else if k == HIR_EXPR_PATH {
            td_begin(mut_view(*st), 39);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
        } else if k == HIR_EXPR_ARRAY {
            td_begin(mut_view(*st), 40);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).elems });
            td_expr(mut_view(*st), unsafe { (*cur).count_expr });
        } else if k == HIR_EXPR_TUPLE {
            td_begin(mut_view(*st), 41);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).elems });
        } else if k == HIR_EXPR_STRUCT {
            td_begin(mut_view(*st), 42);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while ((f as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 43);
                td_strid(mut_view(*st), unsafe { (*f).name });
                td_expr(mut_view(*st), unsafe { (*f).expr });
                td_end(mut_view(*st));
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_BLOCK {
            td_begin(mut_view(*st), 44);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_IF {
            td_begin(mut_view(*st), 45);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).let_pat });
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            td_block(mut_view(*st), unsafe { (*cur).block });
            td_expr(mut_view(*st), unsafe { (*cur).else_branch });
        } else if k == HIR_EXPR_MATCH {
            td_begin(mut_view(*st), 46);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while ((a as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 47);
                td_pat(mut_view(*st), unsafe { (*a).pat });
                td_expr(mut_view(*st), unsafe { (*a).guard });
                td_expr(mut_view(*st), unsafe { (*a).body });
                td_end(mut_view(*st));
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_LOOP {
            td_begin(mut_view(*st), 48);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_WHILE {
            td_begin(mut_view(*st), 49);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_pat(mut_view(*st), unsafe { (*cur).let_pat });
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_FOR {
            td_begin(mut_view(*st), 50);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_pat(mut_view(*st), unsafe { (*cur).pat });
            td_expr(mut_view(*st), unsafe { (*cur).iter });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_UNSAFE {
            td_begin(mut_view(*st), 51);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_VIEW {
            td_begin(mut_view(*st), 52);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_COMPTIME {
            td_begin(mut_view(*st), 53);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_JUMP {
            td_begin(mut_view(*st), 54);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).jump_kind }) as u32);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CLOSURE {
            td_begin(mut_view(*st), 55);
            td_maybe_expr_ty(mut_view(*st), cur);
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while ((p as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 56);
                td_bool(mut_view(*st), unsafe { (*p).is_mut });
                td_symbol(mut_view(*st), unsafe { (*p).symbol });
                td_type(mut_view(*st), unsafe { (*p).ty });
                td_end(mut_view(*st));
                p = unsafe { (*p).next };
            }
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
            td_expr(mut_view(*st), unsafe { (*cur).body });
        } else if k == HIR_EXPR_RANGE {
            td_begin(mut_view(*st), 57);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_inclusive });
            td_expr(mut_view(*st), unsafe { (*cur).start_expr });
            td_expr(mut_view(*st), unsafe { (*cur).end_expr });
        } else if k == HIR_EXPR_BINARY {
            td_begin(mut_view(*st), 58);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).op }) as u32);
            td_expr(mut_view(*st), unsafe { (*cur).left });
            td_expr(mut_view(*st), unsafe { (*cur).right });
        } else if k == HIR_EXPR_UNARY {
            td_begin(mut_view(*st), 59);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).op }) as u32);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CAST {
            td_begin(mut_view(*st), 60);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
            td_type(mut_view(*st), unsafe { (*cur).cast_ty });
        } else if k == HIR_EXPR_FIELD {
            td_begin(mut_view(*st), 61);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_args(mut_view(*st), unsafe { (*cur).generic_args });
        } else if k == HIR_EXPR_TUPLE_INDEX {
            td_begin(mut_view(*st), 62);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_u32(mut_view(*st), unsafe { (*cur).tuple_index });
        } else if k == HIR_EXPR_CALL {
            td_begin(mut_view(*st), 63);
            td_maybe_expr_ty(mut_view(*st), cur);
            let callee: *mut HirExpr = unsafe { (*cur).callee };
            let mut dumped_inferred_callee = false;
            if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH && (unsafe { (*callee).next as usize }) == 0 && (unsafe { (*callee).path.generic_args as usize }) == 0 {
                let sp = unsafe { ptr_substmap_get(view((*st.thir).expr_substs), callee as usize) };
                if (sp as usize) != 0 && (unsafe { (*sp).count }) > 0 {
                    let csym = unsafe { (*callee).path.symbol };
                    if csym.v != 0u32 {
                        let st_ptr = unsafe { thir_get_sym_type(view(*st.thir), (SymbolId { v: csym.v })) };
                        let mut raw_ty_v: u32 = 0u32;
                        if (st_ptr as usize) != 0 {
                            raw_ty_v = unsafe { (*st_ptr).v };
                        }
                        if raw_ty_v == 0u32 {
                            let mut dit: *mut HirItem = st.hir_items;
                            while ((dit as usize) != 0) {
                                let dik = unsafe { (*dit).kind };
                                if dik == HIR_ITEM_FN && (unsafe { (*dit).symbol.v }) == csym.v && (unsafe { (*dit).span.file.v }) != 0xFFFFFFFEu32 {
                                    let it_ty = unsafe { thir_get_item_type(view(*st.thir), dit) };
                                    raw_ty_v = it_ty.v;
                                    break;
                                }
                                dit = unsafe { (*dit).next };
                            }
                        }
                        if raw_ty_v != 0u32 {
                            let ax = unsafe { type_get(view((*st.thir).interner), TypeId { v: raw_ty_v }) };
                            if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_FN {
                                td_nl(mut_view(*st));
                                td_begin(mut_view(*st), 39);
                                td_typeid(mut_view(*st), TypeId { v: raw_ty_v });
                                td_path(mut_view(*st), unsafe { view((*callee).path) });
                                td_end(mut_view(*st));
                                dumped_inferred_callee = true;
                            }
                        }
                    }
                }
            }
            if !dumped_inferred_callee {
                td_expr(mut_view(*st), callee);
            }
            td_expr(mut_view(*st), unsafe { (*cur).args });
        } else if k == HIR_EXPR_METHOD_CALL {
            td_begin(mut_view(*st), 64);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).receiver });
            td_strid(mut_view(*st), unsafe { (*cur).method_name });
            td_generic_args(mut_view(*st), unsafe { (*cur).generic_args });
            td_expr(mut_view(*st), unsafe { (*cur).args });
        } else if k == HIR_EXPR_INDEX {
            td_begin(mut_view(*st), 65);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_expr(mut_view(*st), unsafe { (*cur).index_arg });
        } else if k == HIR_EXPR_TRY {
            td_begin(mut_view(*st), 66);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_AWAIT {
            td_begin(mut_view(*st), 67);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_use_tree(st: mut_view<ThirDumpState>, n: *mut HirUseTree) {
    if (n as usize) == 0 {
        return;
    }
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 68);
    td_dotted(mut_view(*st), unsafe { view((*n).path) });
    if (unsafe { (*n).alias.v }) != 0u32 {
        td_strid(mut_view(*st), unsafe { (*n).alias });
    }
    if (unsafe { (*n).subtrees as usize }) != 0 {
        td_use_tree(mut_view(*st), unsafe { (*n).subtrees });
    }
    td_end(mut_view(*st));
    if (unsafe { (*n).next as usize }) != 0 {
        td_use_tree(mut_view(*st), unsafe { (*n).next });
    }
}

fn td_stmt(st: mut_view<ThirDumpState>, n: *mut HirStmt) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_STMT_ERROR {
            td_begin(mut_view(*st), 69);
        } else if k == HIR_STMT_LET {
            td_begin(mut_view(*st), 70);
            td_pat(mut_view(*st), unsafe { (*cur).pat });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
            if (unsafe { (*cur).else_block as usize }) != 0 {
                td_block(mut_view(*st), unsafe { (*cur).else_block });
            }
        } else if k == HIR_STMT_ASSIGN {
            td_begin(mut_view(*st), 71);
            td_expr(mut_view(*st), unsafe { (*cur).left });
            td_expr(mut_view(*st), unsafe { (*cur).right });
        } else if k == HIR_STMT_EXPR {
            td_begin(mut_view(*st), 72);
            td_bool(mut_view(*st), unsafe { (*cur).has_semi });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_item(st: mut_view<ThirDumpState>, n: *mut HirItem) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        if (unsafe { (*cur).span.file.v }) == 0xFFFFFFFEu32 {
            cur = unsafe { (*cur).next };
            continue;
        }
        if st.filter_file.v != 0u32 && (unsafe { (*cur).span.file.v }) != 0u32 && (unsafe { (*cur).span.file.v }) != st.filter_file.v {
            cur = unsafe { (*cur).next };
            continue;
        }
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_ITEM_ERROR {
            td_begin(mut_view(*st), 73);
        } else if k == HIR_ITEM_MODULE {
            td_begin(mut_view(*st), 74);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_dotted(mut_view(*st), unsafe { view((*cur).mod_path) });
        } else if k == HIR_ITEM_USE {
            td_begin(mut_view(*st), 75);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_use_tree(mut_view(*st), unsafe { (*cur).use_tree });
        } else if k == HIR_ITEM_FN {
            td_begin(mut_view(*st), 76);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_bool(mut_view(*st), unsafe { (*cur).is_async });
            td_bool(mut_view(*st), unsafe { (*cur).is_comptime });
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            let orig_np = unsafe { thir_get_orig_item_name(view(*st.thir), cur as *const HirItem) };
            let fn_name_id = if (orig_np as usize) != 0 {
                StrId { v: unsafe { *orig_np } }
            } else {
                unsafe { (*cur).name }
            };
            td_strid(mut_view(*st), fn_name_id);
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while ((p as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 56);
                td_bool(mut_view(*st), unsafe { (*p).is_mut });
                td_symbol(mut_view(*st), unsafe { (*p).symbol });
                td_type(mut_view(*st), unsafe { (*p).ty });
                td_end(mut_view(*st));
                p = unsafe { (*p).next };
            }
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            if (unsafe { (*cur).body as usize }) != 0 {
                td_block(mut_view(*st), unsafe { (*cur).body });
            }
        } else if k == HIR_ITEM_STRUCT {
            td_begin(mut_view(*st), 77);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_bool(mut_view(*st), unsafe { (*cur).is_tuple });
            if unsafe { (*cur).is_tuple } {
                td_type(mut_view(*st), unsafe { (*cur).tuple_types });
            } else {
                let mut f: *mut HirFieldDecl = unsafe { (*cur).struct_fields };
                while ((f as usize) != 0) {
                    td_nl(mut_view(*st));
                    td_begin(mut_view(*st), 78);
                    td_attr(mut_view(*st), unsafe { (*f).attrs });
                    td_vis(mut_view(*st), unsafe { view((*f).vis) });
                    td_strid(mut_view(*st), unsafe { (*f).name });
                    td_type(mut_view(*st), unsafe { (*f).ty });
                    td_end(mut_view(*st));
                    f = unsafe { (*f).next };
                }
            }
        } else if k == HIR_ITEM_ENUM {
            td_begin(mut_view(*st), 79);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            let mut v: *mut HirVariantDecl = unsafe { (*cur).variants };
            while ((v as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 80);
                td_attr(mut_view(*st), unsafe { (*v).attrs });
                td_strid(mut_view(*st), unsafe { (*v).name });
                td_bool(mut_view(*st), unsafe { (*v).is_struct });
                if unsafe { (*v).is_struct } {
                    let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                    while ((f as usize) != 0) {
                        td_nl(mut_view(*st));
                        td_begin(mut_view(*st), 78);
                        td_attr(mut_view(*st), unsafe { (*f).attrs });
                        td_vis(mut_view(*st), unsafe { view((*f).vis) });
                        td_strid(mut_view(*st), unsafe { (*f).name });
                        td_type(mut_view(*st), unsafe { (*f).ty });
                        td_end(mut_view(*st));
                        f = unsafe { (*f).next };
                    }
                } else {
                    td_type(mut_view(*st), unsafe { (*v).tuple_types });
                }
                td_end(mut_view(*st));
                v = unsafe { (*v).next };
            }
        } else if k == HIR_ITEM_TRAIT {
            td_begin(mut_view(*st), 81);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).supertraits });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_item(mut_view(*st), unsafe { (*cur).members });
        } else if k == HIR_ITEM_IMPL {
            td_begin(mut_view(*st), 82);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).trait_path });
            td_type(mut_view(*st), unsafe { (*cur).self_type });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_item(mut_view(*st), unsafe { (*cur).members });
        } else if k == HIR_ITEM_TYPE_ALIAS {
            td_begin(mut_view(*st), 83);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).ty });
        } else if k == HIR_ITEM_CONST {
            td_begin(mut_view(*st), 84);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_STATIC {
            td_begin(mut_view(*st), 85);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_EXTERN_BLOCK {
            td_begin(mut_view(*st), 86);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            td_item(mut_view(*st), unsafe { (*cur).members });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

pub fn emit_thir(
    buf: mut_view<DiagBuffer>,
    hir_file: view<HirFile>,
    thir: view<Thir>,
    interner: view<StrInterner>,
    filter_file: FileId
) {
    let buf_ptr = unsafe { address_of_mut(buf.ptr) as *mut DiagBuffer };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let mut st = ThirDumpState {
        buf: buf_ptr,
        interner: int_ptr,
        thir: thir_ptr,
        hir_items: hir_file.items,
        indent: 0,
        filter_file: (FileId { v: filter_file.v }),
    };
    td_item(mut_view(st), hir_file.items);
    unsafe { diag_buf_push_byte(mut_view(*buf_ptr), 10u8); }
}
