fn tc_sv_starts_self_dot(sv: view<StrView>) -> bool {
    if sv.len <= 5 || (sv.ptr as usize) == 0 { return false; }
    unsafe {
        *(sv.ptr + 0) == 83u8 && *(sv.ptr + 1) == 101u8 && *(sv.ptr + 2) == 108u8 &&
        *(sv.ptr + 3) == 102u8 && *(sv.ptr + 4) == 46u8
    }
}

const TC_STR_DATA: [141]u8 = [
    79u8, 112u8, 116u8, 105u8, 111u8, 110u8, 46u8, 83u8, 111u8, 109u8, 101u8, 115u8, 116u8, 97u8, 114u8, 116u8, 101u8, 110u8, 100u8, 100u8, 111u8, 110u8, 101u8, 82u8, 97u8, 110u8, 103u8, 101u8, 82u8, 97u8, 110u8, 103u8, 101u8, 73u8, 110u8, 99u8, 108u8, 117u8, 115u8, 105u8, 118u8, 101u8, 36u8, 99u8, 117u8, 114u8, 36u8, 101u8, 110u8, 100u8, 36u8, 100u8, 111u8, 110u8, 101u8, 36u8, 97u8, 114u8, 114u8, 108u8, 101u8, 110u8, 36u8, 105u8, 100u8, 120u8, 36u8, 108u8, 101u8, 110u8, 110u8, 101u8, 120u8, 116u8, 36u8, 105u8, 116u8, 101u8, 114u8, 97u8, 100u8, 100u8, 115u8, 117u8, 98u8, 109u8, 117u8, 108u8, 100u8, 105u8, 118u8, 114u8, 101u8, 109u8, 98u8, 105u8, 116u8, 97u8, 110u8, 100u8, 98u8, 105u8, 116u8, 111u8, 114u8, 98u8, 105u8, 116u8, 120u8, 111u8, 114u8, 115u8, 104u8, 108u8, 115u8, 104u8, 114u8, 101u8, 113u8, 99u8, 109u8, 112u8, 105u8, 110u8, 100u8, 101u8, 120u8, 116u8, 121u8, 112u8, 101u8, 32u8, 101u8, 114u8, 114u8, 111u8, 114u8, 83u8, 101u8, 108u8, 102u8
];

const TC_STR_OFF: [32]u32 = [
    0u32, 0u32, 11u32, 16u32, 19u32, 23u32, 28u32, 42u32, 46u32, 50u32, 55u32, 59u32, 62u32, 66u32, 70u32, 74u32, 79u32, 82u32, 85u32, 88u32, 91u32, 94u32, 100u32, 105u32, 111u32, 114u32, 117u32, 119u32, 122u32, 127u32, 137u32, 141u32
];

fn tc_alloc_sv(arena: mut_view<Arena>, idx: usize) -> StrView {
    let start = TC_STR_OFF[idx] as usize;
    let end = TC_STR_OFF[idx + 1] as usize;
    let n = end - start;
    if n == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let dst = arena_alloc_raw(arena, n + 1, 1);
    let mut i: usize = 0;
    while (i < n) {
        unsafe { *(dst + i) = TC_STR_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn tc_intern_idx(str_in: mut_view<StrInterner>, idx: usize) -> StrId {
    let sv = tc_alloc_sv(mut_view(str_in.bytes), idx);
    interner_intern_bytes(str_in, sv.ptr, sv.len)
}

const TC_UNKNOWN_INTR_MSG: [41]u8 = [
    117u8, 110u8, 107u8, 110u8, 111u8, 119u8, 110u8, 32u8, 111u8, 114u8, 32u8, 109u8, 105u8, 115u8, 109u8, 97u8,
    116u8, 99u8, 104u8, 101u8, 100u8, 32u8, 64u8, 105u8, 110u8, 116u8, 114u8, 105u8, 110u8, 115u8, 105u8, 99u8,
    32u8, 102u8, 117u8, 110u8, 99u8, 116u8, 105u8, 111u8, 110u8,
];

const TC_UNREACHABLE_MSG: [21]u8 = [
    117u8, 110u8, 114u8, 101u8, 97u8, 99u8, 104u8, 97u8, 98u8, 108u8, 101u8, 32u8,
    115u8, 116u8, 97u8, 116u8, 101u8, 109u8, 101u8, 110u8, 116u8,
];

pub fn report_typeck_diag(sink: mut_view<DiagSink>, code_v: u32, file_v: u32, start: u32, end: u32) {
    let code = (DiagCode { v: code_v });
    let sev = diag_code_severity(code);
    let msg_sv = if code_v == AX_TYPE_UNKNOWN_INTRINSIC {
        let dst = arena_alloc_raw(mut_view(sink.arena), 42, 1);
        let mut i: usize = 0;
        while i < 41 {
            unsafe { *(dst + i) = TC_UNKNOWN_INTR_MSG[i]; }
            i = i + 1;
        }
        unsafe { *(dst + 41) = 0u8; }
        StrView { ptr: dst as *const u8, len: 41 }
    } else if code_v == AX_TYPE_UNREACHABLE {
        let dst = arena_alloc_raw(mut_view(sink.arena), 22, 1);
        let mut i: usize = 0;
        while i < 21 {
            unsafe { *(dst + i) = TC_UNREACHABLE_MSG[i]; }
            i = i + 1;
        }
        unsafe { *(dst + 21) = 0u8; }
        StrView { ptr: dst as *const u8, len: 21 }
    } else {
        tc_alloc_sv(mut_view(sink.arena), 29)
    };
    let d = Diagnostic {
        code: code,
        severity: sev,
        message: msg_sv,
        primary: Span { file: (FileId { v: file_v }), start: start, end: end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

const TC_UNKNOWN_INTR_CODE_NAME: [25]u8 = [
    65u8, 88u8, 95u8, 84u8, 89u8, 80u8, 69u8, 95u8, 85u8, 78u8, 75u8, 78u8, 79u8, 87u8, 78u8, 95u8,
    73u8, 78u8, 84u8, 82u8, 73u8, 78u8, 83u8, 73u8, 67u8,
];

pub fn patch_unknown_intrinsic_diag_buf(sink: view<DiagSink>, buf: mut_view<DiagBuffer>) {
    let blen = buf.len;
    if sink.len == 0 || (sink.diags as usize) == 0 || blen < 9 || (buf.ptr as usize) == 0 {
        return;
    }
    let mut has_unknown_intr = false;
    let mut di: usize = 0;
    while di < sink.len {
        let dp = ((sink.diags as usize) + mul_usize(di, size_of<Diagnostic>())) as *const Diagnostic;
        if unsafe { (*dp).code.v } == AX_TYPE_UNKNOWN_INTRINSIC {
            has_unknown_intr = true;
            break;
        }
        di = di + 1;
    }
    if !has_unknown_intr {
        return;
    }
    let mut out = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut i: usize = 0;
    while i < buf.len {
        if i + 9 <= buf.len &&
           unsafe { *(buf.ptr + i + 0) == 60u8 && *(buf.ptr + i + 1) == 117u8 && *(buf.ptr + i + 2) == 110u8 &&
                    *(buf.ptr + i + 3) == 107u8 && *(buf.ptr + i + 4) == 110u8 && *(buf.ptr + i + 5) == 111u8 &&
                    *(buf.ptr + i + 6) == 119u8 && *(buf.ptr + i + 7) == 110u8 && *(buf.ptr + i + 8) == 62u8 } {
            let mut k: usize = 0;
            while k < 25 {
                diag_buf_push_byte(mut_view(out), TC_UNKNOWN_INTR_CODE_NAME[k]);
                k = k + 1;
            }
            i = i + 9;
        } else {
            diag_buf_push_byte(mut_view(out), unsafe { *(buf.ptr + i) });
            i = i + 1;
        }
    }
    if buf.cap > 0 && (buf.ptr as usize) != 0 {
        unsafe { heap_free(buf.ptr, buf.cap, 1); }
    }
    buf.ptr = out.ptr;
    buf.len = out.len;
    buf.cap = out.cap;
}

fn type_error_sp(cx: mut_view<TypeckCtx>, file_v: u32, start: u32, end: u32, code_v: u32) -> TypeId {
    if (cx.sink as usize) != 0 {
        unsafe { report_typeck_diag(mut_view(*cx.sink), code_v, file_v, start, end); }
    }
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    (TypeId { v: err_v })
}

fn type_error(cx: mut_view<TypeckCtx>, sp: view<Span>, code_v: u32) -> TypeId {
    type_error_sp(mut_view(*cx), sp.file.v, sp.start, sp.end, code_v)
}

fn resolve_ty(cx: mut_view<TypeckCtx>, id: TypeId) -> TypeId {
    unsafe {
        type_vars_resolve(mut_view(cx.type_vars), view((*cx.thir).interner), (TypeId { v: id.v }))
    }
}

fn unify_ty(cx: mut_view<TypeckCtx>, a: TypeId, b: TypeId) -> bool {
    unsafe {
        type_vars_unify(mut_view(cx.type_vars), view((*cx.thir).interner), (TypeId { v: a.v }), (TypeId { v: b.v }))
    }
}

fn kind_of(cx: mut_view<TypeckCtx>, id: TypeId) -> u8 {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    if r.v == 0u32 { return TY_ERROR; }
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r.v })) };
    if (t as usize) == 0 { return TY_ERROR; }
    unsafe { (*t).kind }
}

fn is_error(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    r.v == err_v
}

fn is_never(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    let nev_v = unsafe { (*cx.thir).interner.t_never.v };
    r.v == nev_v
}

fn is_intlike(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    if r.v == 0u32 { return false; }
    let is_i = unsafe { type_is_int((TypeId { v: r.v }), view((*cx.thir).interner)) };
    if is_i { return true; }
    kind_of(mut_view(*cx), (TypeId { v: r.v })) == TY_INT_VAR
}

fn new_int_var(cx: mut_view<TypeckCtx>) -> TypeId {
    unsafe {
        type_vars_new_int_var(mut_view(cx.type_vars), mut_view((*cx.thir).interner))
    }
}

fn new_ty_var(cx: mut_view<TypeckCtx>, sp: view<Span>) -> TypeId {
    unsafe {
        type_vars_new_ty_var(mut_view(cx.type_vars), mut_view((*cx.thir).interner), sp)
    }
}

fn push_lit_check(cx: mut_view<TypeckCtx>, sp: view<Span>, value: u64, ty: TypeId) {
    if cx.lits_len == cx.lits_cap {
        let new_cap: usize = if cx.lits_cap == 0 { 16 } else { mul_usize(cx.lits_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<LitCheck>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<LitCheck>()) as *mut LitCheck };
        if cx.lits_len > 0 && (cx.lits as usize) != 0 {
            let old_bytes = mul_usize(cx.lits_len, size_of<LitCheck>());
            let cap_bytes = mul_usize(cx.lits_cap, size_of<LitCheck>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.lits as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.lits as *mut u8, cap_bytes, align_of<LitCheck>());
            }
        }
        cx.lits = new_arr;
        cx.lits_cap = new_cap;
    }
    let e = unsafe { litcheck_at(cx.lits, cx.lits_len) };
    unsafe {
        (*e).span.file.v = sp.file.v;
        (*e).span.start = sp.start;
        (*e).span.end = sp.end;
        (*e).neg_span.file.v = sp.file.v;
        (*e).neg_span.start = sp.start;
        (*e).neg_span.end = sp.end;
        (*e).value = value;
        (*e).ty.v = ty.v;
        (*e).negated = false;
    }
    cx.lits_len = cx.lits_len + 1;
}

fn push_neg_check(cx: mut_view<TypeckCtx>, sp: view<Span>, ty: TypeId) {
    if cx.negs_len == cx.negs_cap {
        let new_cap: usize = if cx.negs_cap == 0 { 16 } else { mul_usize(cx.negs_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<NegCheck>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<NegCheck>()) as *mut NegCheck };
        if cx.negs_len > 0 && (cx.negs as usize) != 0 {
            let old_bytes = mul_usize(cx.negs_len, size_of<NegCheck>());
            let cap_bytes = mul_usize(cx.negs_cap, size_of<NegCheck>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.negs as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.negs as *mut u8, cap_bytes, align_of<NegCheck>());
            }
        }
        cx.negs = new_arr;
        cx.negs_cap = new_cap;
    }
    let e = unsafe { negcheck_at(cx.negs, cx.negs_len) };
    unsafe {
        (*e).span.file.v = sp.file.v;
        (*e).span.start = sp.start;
        (*e).span.end = sp.end;
        (*e).ty.v = ty.v;
    }
    cx.negs_len = cx.negs_len + 1;
}

fn push_var_state(cx: mut_view<TypeckCtx>, sym: SymbolId, is_mut: bool, is_init: bool) {
    if cx.vars_len == cx.vars_cap {
        let new_cap: usize = if cx.vars_cap == 0 { 16 } else { mul_usize(cx.vars_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<VarState>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<VarState>()) as *mut VarState };
        if cx.vars_len > 0 && (cx.vars as usize) != 0 {
            let old_bytes = mul_usize(cx.vars_len, size_of<VarState>());
            let cap_bytes = mul_usize(cx.vars_cap, size_of<VarState>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.vars as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.vars as *mut u8, cap_bytes, align_of<VarState>());
            }
        }
        cx.vars = new_arr;
        cx.vars_cap = new_cap;
    }
    let e = unsafe { varstate_at(cx.vars, cx.vars_len) };
    unsafe {
        (*e).sym.v = sym.v;
        (*e).is_mut = is_mut;
        (*e).is_init = is_init;
    }
    cx.vars_len = cx.vars_len + 1;
}

fn push_loop_env(cx: mut_view<TypeckCtx>, label: StrId, break_ty: TypeId) {
    if cx.loops_len == cx.loops_cap {
        let new_cap: usize = if cx.loops_cap == 0 { 8 } else { mul_usize(cx.loops_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<LoopEnv>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<LoopEnv>()) as *mut LoopEnv };
        if cx.loops_len > 0 && (cx.loops as usize) != 0 {
            let old_bytes = mul_usize(cx.loops_len, size_of<LoopEnv>());
            let cap_bytes = mul_usize(cx.loops_cap, size_of<LoopEnv>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.loops as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.loops as *mut u8, cap_bytes, align_of<LoopEnv>());
            }
        }
        cx.loops = new_arr;
        cx.loops_cap = new_cap;
    }
    let e = unsafe { loopenv_at(cx.loops, cx.loops_len) };
    unsafe {
        (*e).label.v = label.v;
        (*e).break_ty.v = break_ty.v;
        (*e).has_break = false;
    }
    cx.loops_len = cx.loops_len + 1;
}

fn push_const_stack(cx: mut_view<TypeckCtx>, sym: SymbolId) {
    if cx.const_eval_stack_len == cx.const_eval_stack_cap {
        let new_cap: usize = if cx.const_eval_stack_cap == 0 { 8 } else { mul_usize(cx.const_eval_stack_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<SymbolId>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<SymbolId>()) as *mut SymbolId };
        if cx.const_eval_stack_len > 0 && (cx.const_eval_stack as usize) != 0 {
            let old_bytes = mul_usize(cx.const_eval_stack_len, size_of<SymbolId>());
            let cap_bytes = mul_usize(cx.const_eval_stack_cap, size_of<SymbolId>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.const_eval_stack as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.const_eval_stack as *mut u8, cap_bytes, align_of<SymbolId>());
            }
        }
        cx.const_eval_stack = new_arr;
        cx.const_eval_stack_cap = new_cap;
    }
    let e = unsafe { symid_at(cx.const_eval_stack, cx.const_eval_stack_len) };
    unsafe { (*e).v = sym.v; }
    cx.const_eval_stack_len = cx.const_eval_stack_len + 1;
}

pub fn coerce(cx: mut_view<TypeckCtx>, from: TypeId, to: TypeId, sp: view<Span>) -> TypeId {
    if to.v == 0u32 {
        return resolve_ty(mut_view(*cx), (TypeId { v: from.v }));
    }
    let rf = resolve_ty(mut_view(*cx), (TypeId { v: from.v }));
    let rt = resolve_ty(mut_view(*cx), (TypeId { v: to.v }));
    if is_error(mut_view(*cx), (TypeId { v: rf.v })) || is_error(mut_view(*cx), (TypeId { v: rt.v })) {
        let err_v = unsafe { (*cx.thir).interner.t_error.v };
        return (TypeId { v: err_v });
    }
    if is_never(mut_view(*cx), (TypeId { v: rf.v })) {
        return (TypeId { v: rt.v });
    }
    if unify_ty(mut_view(*cx), (TypeId { v: rf.v }), (TypeId { v: rt.v })) {
        return resolve_ty(mut_view(*cx), (TypeId { v: rt.v }));
    }
    let tf = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rf.v })) };
    let tt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rt.v })) };
    if (tf as usize) != 0 && (tt as usize) != 0 {
        let k_f = unsafe { (*tf).kind };
        let k_t = unsafe { (*tt).kind };
        let pt_f = unsafe { (*tf).pointee.v };
        let pt_t = unsafe { (*tt).pointee.v };
        if k_f == TY_PTR && k_t == TY_PTR {
            // axiom0 coerce(): `*mut T` is accepted where `*const T` is expected
            let m_f = unsafe { (*tf).is_mut };
            let m_t = unsafe { (*tt).is_mut };
            if m_f && !m_t {
                if unify_ty(mut_view(*cx), (TypeId { v: pt_f }), (TypeId { v: pt_t })) {
                    return resolve_ty(mut_view(*cx), (TypeId { v: rt.v }));
                }
            }
        }
        if k_f == TY_MUT_VIEW && k_t == TY_VIEW {
            if unify_ty(mut_view(*cx), (TypeId { v: pt_f }), (TypeId { v: pt_t })) {
                return resolve_ty(mut_view(*cx), (TypeId { v: rt.v }));
            }
        }
        if (k_f == TY_VIEW || k_f == TY_MUT_VIEW) && k_t == TY_VIEW {
            let pf = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pt_f })) };
            let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pt_t })) };
            if (pf as usize) != 0 && (pt as usize) != 0 {
                let pk_f = unsafe { (*pf).kind };
                let pk_t = unsafe { (*pt).kind };
                if pk_f == TY_ARRAY && pk_t == TY_SLICE {
                    let el_f = unsafe { (*pf).elem.v };
                    let el_t = unsafe { (*pt).elem.v };
                    if unify_ty(mut_view(*cx), (TypeId { v: el_f }), (TypeId { v: el_t })) {
                        return resolve_ty(mut_view(*cx), (TypeId { v: rt.v }));
                    }
                }
            }
        }
        if k_f == TY_MUT_VIEW && k_t == TY_MUT_VIEW {
            let pf = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pt_f })) };
            let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pt_t })) };
            if (pf as usize) != 0 && (pt as usize) != 0 {
                let pk_f = unsafe { (*pf).kind };
                let pk_t = unsafe { (*pt).kind };
                if pk_f == TY_ARRAY && pk_t == TY_SLICE {
                    let el_f = unsafe { (*pf).elem.v };
                    let el_t = unsafe { (*pt).elem.v };
                    if unify_ty(mut_view(*cx), (TypeId { v: el_f }), (TypeId { v: el_t })) {
                        return resolve_ty(mut_view(*cx), (TypeId { v: rt.v }));
                    }
                }
            }
        }
    }
    type_error(mut_view(*cx), sp, AX_TYPE_MISMATCH)
}

fn default_int_vars(cx: mut_view<TypeckCtx>) {
    let mut i: usize = cx.type_vars.fn_var_start;
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    while (i < cx.type_vars.len) {
        let e = unsafe { typevar_at(cx.type_vars.items, i) };
        let res_v = unsafe { (*e).resolved_to.v };
        if res_v == 0u32 {
            let is_gen = unsafe { (*e).is_generic };
            if is_gen {
                let fv = unsafe { (*e).span.file.v };
                let st = unsafe { (*e).span.start };
                let en = unsafe { (*e).span.end };
                type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_UNKNOWN);
                unsafe { (*e).resolved_to.v = err_v; }
            } else {
                unsafe { (*e).resolved_to.v = i32_v; }
            }
        }
        i = i + 1;
    }
}

fn int_fits(k: u8, mag: u64, negated: bool) -> bool {
    if !negated {
        if k == TY_I8 { return mag <= 0x7fu64; }
        if k == TY_I16 { return mag <= 0x7fffu64; }
        if k == TY_I32 { return mag <= 0x7fffffffu64; }
        if k == TY_I64 || k == TY_ISIZE { return mag <= 0x7fffffffffffffffu64; }
        if k == TY_U8 { return mag <= 0xffu64; }
        if k == TY_U16 { return mag <= 0xffffu64; }
        if k == TY_U32 { return mag <= 0xffffffffu64; }
        if k == TY_U64 || k == TY_USIZE { return true; }
        return true;
    }
    if mag == 0u64 { return true; }
    if k == TY_I8 { return mag <= 0x80u64; }
    if k == TY_I16 { return mag <= 0x8000u64; }
    if k == TY_I32 { return mag <= 0x80000000u64; }
    if k == TY_I64 || k == TY_ISIZE { return mag <= 0x8000000000000000u64; }
    false
}

fn check_literal_ranges(cx: mut_view<TypeckCtx>) {
    let mut i: usize = 0;
    while (i < cx.lits_len) {
        let lc = unsafe { litcheck_at(cx.lits, i) };
        let l_ty_v = unsafe { (*lc).ty.v };
        let ty = resolve_ty(mut_view(*cx), (TypeId { v: l_ty_v }));
        let k = kind_of(mut_view(*cx), (TypeId { v: ty.v }));
        if k != TY_ERROR {
            let neg = unsafe { (*lc).negated };
            let val = unsafe { (*lc).value };
            let is_uns = unsafe { type_is_unsigned((TypeId { v: ty.v }), view((*cx.thir).interner)) };
            if neg && is_uns && val != 0u64 {
                let nfv = unsafe { (*lc).neg_span.file.v };
                let nst = unsafe { (*lc).neg_span.start };
                let nen = unsafe { (*lc).neg_span.end };
                type_error_sp(mut_view(*cx), nfv, nst, nen, AX_TYPE_NEG_UNSIGNED);
            } else if !int_fits(k, val, neg) {
                let fv = if neg { unsafe { (*lc).neg_span.file.v } } else { unsafe { (*lc).span.file.v } };
                let st = if neg { unsafe { (*lc).neg_span.start } } else { unsafe { (*lc).span.start } };
                let en = if neg { unsafe { (*lc).neg_span.end } } else { unsafe { (*lc).span.end } };
                type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_LITERAL_OUT_OF_RANGE);
            }
        }
        i = i + 1;
    }
    let mut j: usize = 0;
    while (j < cx.negs_len) {
        let nc = unsafe { negcheck_at(cx.negs, j) };
        let n_ty_v = unsafe { (*nc).ty.v };
        let ty = resolve_ty(mut_view(*cx), (TypeId { v: n_ty_v }));
        let is_uns = unsafe { type_is_unsigned((TypeId { v: ty.v }), view((*cx.thir).interner)) };
        if is_uns {
            let fv = unsafe { (*nc).span.file.v };
            let st = unsafe { (*nc).span.start };
            let en = unsafe { (*nc).span.end };
            type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_NEG_UNSIGNED);
        }
        j = j + 1;
    }
}

fn suffix_to_type(cx: mut_view<TypeckCtx>, s: u8) -> TypeId {
    unsafe {
        if s == SUFFIX_I8 { return (TypeId { v: (*cx.thir).interner.t_i8.v }); }
        if s == SUFFIX_I16 { return (TypeId { v: (*cx.thir).interner.t_i16.v }); }
        if s == SUFFIX_I32 { return (TypeId { v: (*cx.thir).interner.t_i32.v }); }
        if s == SUFFIX_I64 { return (TypeId { v: (*cx.thir).interner.t_i64.v }); }
        if s == SUFFIX_ISIZE { return (TypeId { v: (*cx.thir).interner.t_isize.v }); }
        if s == SUFFIX_U8 { return (TypeId { v: (*cx.thir).interner.t_u8.v }); }
        if s == SUFFIX_U16 { return (TypeId { v: (*cx.thir).interner.t_u16.v }); }
        if s == SUFFIX_U32 { return (TypeId { v: (*cx.thir).interner.t_u32.v }); }
        if s == SUFFIX_U64 { return (TypeId { v: (*cx.thir).interner.t_u64.v }); }
        if s == SUFFIX_USIZE { return (TypeId { v: (*cx.thir).interner.t_usize.v }); }
    }
    (TypeId { v: 0u32 })
}

fn int_literal_type(cx: mut_view<TypeckCtx>, tok: view<Token>, sp: view<Span>) -> TypeId {
    if (tok.flags & TOK_FLAG_ERROR) != 0u16 {
        let err_v = unsafe { (*cx.thir).interner.t_error.v };
        return (TypeId { v: err_v });
    }
    let val: u64 = tok.int_val;
    let suf: u8 = tok.suffix;
    let mut ty = suffix_to_type(mut_view(*cx), suf);
    if ty.v == 0u32 {
        let iv = new_int_var(mut_view(*cx));
        ty.v = iv.v;
    }
    push_lit_check(mut_view(*cx), sp, val, (TypeId { v: ty.v }));
    ty
}

fn tc_path_name_sv(cx: view<TypeckCtx>, path: view<HirPath>) -> StrView {
    if path.span.file.v != 0u32 && (cx.db as usize) != 0 {
        let sp = Span { file: (FileId { v: path.span.file.v }), start: path.span.start, end: path.span.end };
        let sv = unsafe { source_db_span_text(view(*cx.db), sp) };
        if sv.len > 0 { return sv; }
    }
    if path.name.v != 0u32 && (cx.str_in as usize) != 0 {
        let sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: path.name.v })) };
        if sv.len > 0 { return sv; }
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

fn dotted_name_eq(a: view<AstDottedName>, b: view<AstDottedName>) -> bool {
    if a.count != b.count { return false; }
    let mut i: usize = 0;
    while (i < a.count) {
        let sa = unsafe { (*strid_at_const(a.segments as *const StrId, i)).v };
        let sb = unsafe { (*strid_at_const(b.segments as *const StrId, i)).v };
        if sa != sb { return false; }
        i = i + 1;
    }
    true
}

fn is_valid_const_type(cx: mut_view<TypeckCtx>, ty: TypeId) -> bool {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
    if r.v == 0u32 { return false; }
    if is_error(mut_view(*cx), (TypeId { v: r.v })) { return true; }
    let is_i = unsafe { type_is_int((TypeId { v: r.v }), view((*cx.thir).interner)) };
    if is_i { return true; }
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r.v })) };
    if (t as usize) == 0 { return false; }
    let k = unsafe { (*t).kind };
    if k == TY_BOOL || k == TY_CHAR || k == TY_STR || k == TY_UNIT { return true; }
    if k == TY_PTR || k == TY_VIEW || k == TY_FN { return true; }
    if k == TY_ARRAY {
        let el_v = unsafe { (*t).elem.v };
        return is_valid_const_type(mut_view(*cx), (TypeId { v: el_v }));
    }
    if k == TY_TUPLE {
        let fc = unsafe { (*t).field_count };
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        while (i < fc) {
            let fv = unsafe { (*typeid_at(fptr, i)).v };
            if !is_valid_const_type(mut_view(*cx), (TypeId { v: fv })) { return false; }
            i = i + 1;
        }
        return true;
    }
    if k == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        while (i < fc) {
            let fv = unsafe { (*typeid_at(fptr, i)).v };
            if !is_valid_const_type(mut_view(*cx), (TypeId { v: fv })) { return false; }
            i = i + 1;
        }
        return true;
    }
    if k == TY_ENUM {
        let vc = unsafe { (*t).variant_count };
        let vfc = unsafe { (*t).variant_field_counts };
        let vf = unsafe { (*t).variant_fields };
        let mut v: usize = 0;
        while (v < vc) {
            let cnt = unsafe { *usize_at(vfc, v) };
            let row = unsafe { *typeid_ptr_at(vf, v) };
            let mut j: usize = 0;
            while (j < cnt) {
                let fv = unsafe { (*typeid_at(row, j)).v };
                if !is_valid_const_type(mut_view(*cx), (TypeId { v: fv })) { return false; }
                j = j + 1;
            }
            v = v + 1;
        }
        return true;
    }
    false
}

fn find_const_item_by_symbol(cx: view<TypeckCtx>, sym: SymbolId) -> *mut HirItem {
    if sym.v == 0u32 || (cx.hir as usize) == 0 { return 0 as *mut HirItem; }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((it as usize) != 0) {
        let k = unsafe { (*it).kind };
        if k == HIR_ITEM_CONST {
            if unsafe { (*it).symbol.v } == sym.v { return it; }
        } else if k == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while ((m as usize) != 0) {
                if unsafe { (*m).kind } == HIR_ITEM_CONST && unsafe { (*m).symbol.v } == sym.v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

fn find_const_item_by_name(cx: view<TypeckCtx>, name: view<StrView>) -> *mut HirItem {
    if name.len == 0 || (cx.hir as usize) == 0 || (cx.str_in as usize) == 0 { return 0 as *mut HirItem; }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((it as usize) != 0) {
        if unsafe { (*it).kind } == HIR_ITEM_CONST {
            let cname_id = unsafe { (*it).name.v };
            if cname_id != 0u32 {
                let csv = unsafe { interner_get(view(*cx.str_in), (StrId { v: cname_id })) };
                if sv_eq(view(csv), name) { return it; }
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

// Built-in constant expression evaluator for integer/bool constants and array lengths.
fn eval_const_expr_int(cx: mut_view<TypeckCtx>, expr: *const HirExpr, out_val: mut_view<u64>, out_err: mut_view<u32>) -> bool {
    *out_val = 0u64;
    *out_err = 0u32;
    if (expr as usize) == 0 { return false; }
    let k = unsafe { (*expr).kind };
    if k == HIR_EXPR_LITERAL {
        let tk = unsafe { (*expr).literal.kind };
        if tk == TOK_INT {
            *out_val = unsafe { (*expr).literal.int_val };
            return true;
        }
        if tk == TOK_KW_TRUE {
            *out_val = 1u64;
            return true;
        }
        if tk == TOK_KW_FALSE {
            *out_val = 0u64;
            return true;
        }
        if tk == TOK_CHAR {
            let cv = unsafe { (*expr).literal.char_val };
            *out_val = cv as u64;
            return true;
        }
        return false;
    }
    if k == HIR_EXPR_UNARY {
        let mut inner_v: u64 = 0u64;
        let inner_ptr: *mut HirExpr = unsafe { (*expr).inner };
        if !eval_const_expr_int(mut_view(*cx), inner_ptr, mut_view(inner_v), mut_view(*out_err)) { return false; }
        let op = unsafe { (*expr).op };
        if op == UNOP_NEG {
            *out_val = (0i64 - (inner_v as i64)) as u64;
            return true;
        }
        if op == UNOP_NOT {
            *out_val = if inner_v == 0u64 { 1u64 } else { 0u64 };
            return true;
        }
        if op == UNOP_BITNOT {
            *out_val = inner_v ^ 0xffffffffffffffffu64;
            return true;
        }
        return false;
    }
    if k == HIR_EXPR_CAST {
        let inner_ptr: *mut HirExpr = unsafe { (*expr).inner };
        return eval_const_expr_int(mut_view(*cx), inner_ptr, mut_view(*out_val), mut_view(*out_err));
    }
    if k == HIR_EXPR_BINARY {
        let mut lv: u64 = 0u64;
        let mut rv: u64 = 0u64;
        let lptr: *mut HirExpr = unsafe { (*expr).left };
        let rptr: *mut HirExpr = unsafe { (*expr).right };
        if !eval_const_expr_int(mut_view(*cx), lptr, mut_view(lv), mut_view(*out_err)) { return false; }
        if !eval_const_expr_int(mut_view(*cx), rptr, mut_view(rv), mut_view(*out_err)) { return false; }
        let op = unsafe { (*expr).op };
        if op == BINOP_ADD { *out_val = lv + rv; return true; }
        if op == BINOP_SUB { *out_val = lv - rv; return true; }
        if op == BINOP_MUL {
            *out_val = (((lv as isize) * (rv as isize)) as usize) as u64;
            return true;
        }
        if op == BINOP_DIV {
            if rv == 0u64 {
                *out_err = AX_CONST_DIV_ZERO;
                return false;
            }
            *out_val = lv / rv;
            return true;
        }
        if op == BINOP_REM {
            if rv == 0u64 {
                *out_err = AX_CONST_DIV_ZERO;
                return false;
            }
            *out_val = lv % rv;
            return true;
        }
        if op == BINOP_BITAND { *out_val = lv & rv; return true; }
        if op == BINOP_BITOR { *out_val = lv | rv; return true; }
        if op == BINOP_BITXOR { *out_val = lv ^ rv; return true; }
        if op == BINOP_SHL { *out_val = lv << (rv & 63u64); return true; }
        if op == BINOP_SHR { *out_val = lv >> (rv & 63u64); return true; }
        if op == BINOP_EQ { *out_val = if lv == rv { 1u64 } else { 0u64 }; return true; }
        if op == BINOP_NE { *out_val = if lv != rv { 1u64 } else { 0u64 }; return true; }
        if op == BINOP_LT { *out_val = if lv < rv { 1u64 } else { 0u64 }; return true; }
        if op == BINOP_LE { *out_val = if lv <= rv { 1u64 } else { 0u64 }; return true; }
        if op == BINOP_GT { *out_val = if lv > rv { 1u64 } else { 0u64 }; return true; }
        if op == BINOP_GE { *out_val = if lv >= rv { 1u64 } else { 0u64 }; return true; }
        if op == BINOP_LOGAND { *out_val = if lv != 0u64 && rv != 0u64 { 1u64 } else { 0u64 }; return true; }
        if op == BINOP_LOGOR { *out_val = if lv != 0u64 || rv != 0u64 { 1u64 } else { 0u64 }; return true; }
        return false;
    }
    if k == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        if sym_v != 0u32 {
            let existing = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: sym_v })) };
            if (existing as usize) != 0 {
                let ek = unsafe { (*existing).kind };
                if ek == CONST_INT {
                    *out_val = unsafe { (*existing).int_val };
                    return true;
                }
                return false;
            }
            let citem = find_const_item_by_symbol(view(*cx), (SymbolId { v: sym_v }));
            if (citem as usize) != 0 {
                evaluate_const_item(mut_view(*cx), citem);
                let after = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: sym_v })) };
                if (after as usize) != 0 && unsafe { (*after).kind } == CONST_INT {
                    *out_val = unsafe { (*after).int_val };
                    return true;
                }
            }
        } else {
            let psv = unsafe { tc_path_name_sv(view(*cx), view((*expr).path)) };
            let citem = find_const_item_by_name(view(*cx), view(psv));
            if (citem as usize) != 0 {
                evaluate_const_item(mut_view(*cx), citem);
                let csym = unsafe { (*citem).symbol.v };
                if csym != 0u32 {
                    let after = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: csym })) };
                    if (after as usize) != 0 && unsafe { (*after).kind } == CONST_INT {
                        *out_val = unsafe { (*after).int_val };
                        return true;
                    }
                }
            }
        }
    }
    false
}

pub fn evaluate_const_item(cx: mut_view<TypeckCtx>, it: *const HirItem) {
    if (it as usize) == 0 { return; }
    if unsafe { (*it).kind } != HIR_ITEM_CONST { return; }
    let sym_v = unsafe { (*it).symbol.v };
    if sym_v != 0u32 {
        let existing = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: sym_v })) };
        if (existing as usize) != 0 { return; }
        let mut i: usize = 0;
        while (i < cx.const_eval_stack_len) {
            let sv = unsafe { (*symid_at(cx.const_eval_stack, i)).v };
            if sv == sym_v {
                let fv = unsafe { (*it).span.file.v };
                let st = unsafe { (*it).span.start };
                let en = unsafe { (*it).span.end };
                type_error_sp(mut_view(*cx), fv, st, en, AX_CONST_CYCLE);
                let err_t = unsafe { (*cx.thir).interner.t_error.v };
                let err_val = ConstValue {
                    kind: CONST_ERROR,
                    ty: (TypeId { v: err_t }),
                    int_val: 0u64,
                    str_bytes: 0 as *const u8,
                    str_len: 0,
                    agg_data: 0 as *mut u8,
                    agg_size: 0,
                    agg_align: 0,
                    alloc_id: 0u32,
                };
                unsafe { sym_constmap_insert(mut_view((*cx.thir).symbol_consts), (SymbolId { v: sym_v }), view(err_val)); }
                return;
            }
            i = i + 1;
        }
        push_const_stack(mut_view(*cx), (SymbolId { v: sym_v }));
    }

    let cty_ptr: *mut HirType = unsafe { (*it).ty };
    let ty = hir_type_to_typeid(mut_view(*cx), cty_ptr);
    unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: ty.v })); }
    if sym_v != 0u32 {
        unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: sym_v }), (TypeId { v: ty.v })); }
    }
    if !is_valid_const_type(mut_view(*cx), (TypeId { v: ty.v })) {
        let sp_ptr: *const HirType = if (cty_ptr as usize) != 0 { cty_ptr as *const HirType } else { 0 as *const HirType };
        let fv = if (sp_ptr as usize) != 0 { unsafe { (*sp_ptr).span.file.v } } else { unsafe { (*it).span.file.v } };
        let st = if (sp_ptr as usize) != 0 { unsafe { (*sp_ptr).span.start } } else { unsafe { (*it).span.start } };
        let en = if (sp_ptr as usize) != 0 { unsafe { (*sp_ptr).span.end } } else { unsafe { (*it).span.end } };
        type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_MISMATCH);
    }

    let cexpr: *mut HirExpr = unsafe { (*it).expr };
    if (cexpr as usize) != 0 {
        let saved_start = cx.type_vars.fn_var_start;
        let saved_lits = cx.lits_len;
        let saved_negs = cx.negs_len;
        cx.type_vars.fn_var_start = cx.type_vars.len;
        cx.lits_len = 0;
        cx.negs_len = 0;

        check_expr(mut_view(*cx), cexpr, (TypeId { v: ty.v }));
        default_int_vars(mut_view(*cx));
        check_literal_ranges(mut_view(*cx));

        cx.type_vars.fn_var_start = saved_start;
        cx.lits_len = saved_lits;
        cx.negs_len = saved_negs;

        let mut iv: u64 = 0u64;
        let mut eval_err: u32 = 0u32;
        let ok = eval_const_expr_int(mut_view(*cx), cexpr, mut_view(iv), mut_view(eval_err));
        if eval_err != 0u32 {
            let efv = unsafe { (*cexpr).span.file.v };
            let est = unsafe { (*cexpr).span.start };
            let een = unsafe { (*cexpr).span.end };
            type_error_sp(mut_view(*cx), efv, est, een, eval_err);
        } else if ok && sym_v != 0u32 {
            let cv = ConstValue {
                kind: CONST_INT,
                ty: (TypeId { v: ty.v }),
                int_val: iv,
                str_bytes: 0 as *const u8,
                str_len: 0,
                agg_data: 0 as *mut u8,
                agg_size: 0,
                agg_align: 0,
                alloc_id: 0u32,
            };
            unsafe { sym_constmap_insert(mut_view((*cx.thir).symbol_consts), (SymbolId { v: sym_v }), view(cv)); }
        }
    }

    if sym_v != 0u32 && cx.const_eval_stack_len > 0 {
        cx.const_eval_stack_len = cx.const_eval_stack_len - 1;
    }
}

fn eval_array_len_expr(cx: mut_view<TypeckCtx>, len_expr: *const HirExpr, out_len: mut_view<u64>) -> bool {
    *out_len = 0u64;
    if (len_expr as usize) == 0 { return false; }
    let saved_start = cx.type_vars.fn_var_start;
    let saved_lits = cx.lits_len;
    let saved_negs = cx.negs_len;
    cx.type_vars.fn_var_start = cx.type_vars.len;
    cx.lits_len = 0;
    cx.negs_len = 0;

    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let len_ty = check_expr(mut_view(*cx), len_expr, (TypeId { v: usize_v }));
    default_int_vars(mut_view(*cx));
    check_literal_ranges(mut_view(*cx));

    cx.type_vars.fn_var_start = saved_start;
    cx.lits_len = saved_lits;
    cx.negs_len = saved_negs;

    if is_error(mut_view(*cx), (TypeId { v: len_ty.v })) { return false; }

    if unsafe { (*len_expr).kind } == HIR_EXPR_UNARY && unsafe { (*len_expr).op } == UNOP_NEG {
        let fv = unsafe { (*len_expr).span.file.v };
        let st = unsafe { (*len_expr).span.start };
        let en = unsafe { (*len_expr).span.end };
        type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_ARRAY_SIZE);
        return false;
    }

    let mut val: u64 = 0u64;
    let mut eval_err: u32 = 0u32;
    if !eval_const_expr_int(mut_view(*cx), len_expr, mut_view(val), mut_view(eval_err)) {
        let code_v = if eval_err != 0u32 { eval_err } else { AX_TYPE_ARRAY_SIZE };
        let fv = unsafe { (*len_expr).span.file.v };
        let st = unsafe { (*len_expr).span.start };
        let en = unsafe { (*len_expr).span.end };
        type_error_sp(mut_view(*cx), fv, st, en, code_v);
        return false;
    }
    *out_len = val;
    true
}

pub fn hir_type_to_typeid(cx: mut_view<TypeckCtx>, ht: *const HirType) -> TypeId {
    if (ht as usize) == 0 { return (TypeId { v: 0u32 }); }
    let k = unsafe { (*ht).kind };
    if k == HIR_TYPE_ERROR {
        let ev = unsafe { (*cx.thir).interner.t_error.v };
        return (TypeId { v: ev });
    }
    if k == HIR_TYPE_PATH {
        let name = unsafe { tc_path_name_sv(view(*cx), view((*ht).path)) };
        unsafe {
            if tc_sv_is_3(view(name), 105u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_i32.v }); } // i32
            if tc_sv_is_3(view(name), 117u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_u32.v }); } // u32
            if tc_sv_is_3(view(name), 105u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_i64.v }); } // i64
            if tc_sv_is_3(view(name), 117u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_u64.v }); } // u64
            if tc_sv_is_3(view(name), 105u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_i16.v }); } // i16
            if tc_sv_is_3(view(name), 117u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_u16.v }); } // u16
            if tc_sv_is_2(view(name), 105u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_i8.v }); } // i8
            if tc_sv_is_2(view(name), 117u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_u8.v }); } // u8
            if tc_sv_is_5(view(name), 105u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_isize.v }); } // isize
            if tc_sv_is_5(view(name), 117u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_usize.v }); } // usize
            if tc_sv_is_4(view(name), 98u8, 111u8, 111u8, 108u8) { return (TypeId { v: (*cx.thir).interner.t_bool.v }); } // bool
            if tc_sv_is_4(view(name), 99u8, 104u8, 97u8, 114u8) { return (TypeId { v: (*cx.thir).interner.t_char.v }); } // char
            if tc_sv_is_3(view(name), 83u8, 116u8, 114u8) { return (TypeId { v: (*cx.thir).interner.t_str.v }); } // Str
            if tc_sv_is_5(view(name), 110u8, 101u8, 118u8, 101u8, 114u8) { return (TypeId { v: (*cx.thir).interner.t_never.v }); } // never
            if tc_sv_is_3(view(name), 102u8, 51u8, 50u8) || tc_sv_is_3(view(name), 102u8, 54u8, 52u8) {
                return type_error(mut_view(*cx), view((*ht).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP);
            }
        }
        let mut dummy_gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        return unsafe { lookup_path_type(mut_view(*cx), view((*ht).path), mut_view(dummy_gargs)) };
    }
    if k == HIR_TYPE_FN {
        let is_u = unsafe { (*ht).is_unsafe };
        let abi_v = unsafe { (*ht).abi.v };
        let rt_ptr: *mut HirType = unsafe { (*ht).ret_type };
        let rt_id = hir_type_to_typeid(mut_view(*cx), rt_ptr);

        let mut count: usize = 0;
        let mut p: *mut HirType = unsafe { (*ht).param_types };
        while ((p as usize) != 0) {
            count = count + 1;
            p = unsafe { (*p).next };
        }
        let mut ptypes: *mut TypeId = 0 as *mut TypeId;
        if count > 0 {
            let bytes = mul_usize(count, size_of<TypeId>());
            ptypes = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
            let mut i: usize = 0;
            p = unsafe { (*ht).param_types };
            while ((p as usize) != 0) {
                let pid = hir_type_to_typeid(mut_view(*cx), p);
                let dst = unsafe { typeid_at(ptypes, i) };
                unsafe { (*dst).v = pid.v; }
                i = i + 1;
                p = unsafe { (*p).next };
            }
        }
        return unsafe { intern_fn_ty(mut_view((*cx.thir).interner), is_u, (StrId { v: abi_v }), ptypes, count, (TypeId { v: rt_id.v })) };
    }
    if k == HIR_TYPE_ARRAY {
        let elem_ptr: *mut HirType = unsafe { (*ht).elem };
        let elem = hir_type_to_typeid(mut_view(*cx), elem_ptr);
        let mut arr_len: u64 = 0u64;
        let cnt_expr: *mut HirExpr = unsafe { (*ht).count_expr };
        if !eval_array_len_expr(mut_view(*cx), cnt_expr, mut_view(arr_len)) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        return unsafe { intern_array_ty(mut_view((*cx.thir).interner), (TypeId { v: elem.v }), arr_len) };
    }
    if k == HIR_TYPE_TUPLE {
        let mut count: usize = 0;
        let mut e: *mut HirType = unsafe { (*ht).elem_types };
        while ((e as usize) != 0) {
            count = count + 1;
            e = unsafe { (*e).next };
        }
        if count == 0 {
            let uv = unsafe { (*cx.thir).interner.t_unit.v };
            return (TypeId { v: uv });
        }
        let bytes = mul_usize(count, size_of<TypeId>());
        let fields = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
        let mut i: usize = 0;
        e = unsafe { (*ht).elem_types };
        while ((e as usize) != 0) {
            let eid = hir_type_to_typeid(mut_view(*cx), e);
            let dst = unsafe { typeid_at(fields, i) };
            unsafe { (*dst).v = eid.v; }
            i = i + 1;
            e = unsafe { (*e).next };
        }
        return unsafe { intern_tuple_ty(mut_view((*cx.thir).interner), fields, count) };
    }
    if k == HIR_TYPE_SLICE {
        let elem_ptr: *mut HirType = unsafe { (*ht).elem };
        let elem = hir_type_to_typeid(mut_view(*cx), elem_ptr);
        return unsafe { intern_slice_ty(mut_view((*cx.thir).interner), (TypeId { v: elem.v })) };
    }
    if k == HIR_TYPE_VIEW {
        let is_m = unsafe { (*ht).is_mut };
        let elem_ptr: *mut HirType = unsafe { (*ht).elem };
        let pt = hir_type_to_typeid(mut_view(*cx), elem_ptr);
        return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: pt.v }), is_m) };
    }
    if k == HIR_TYPE_PTR {
        let is_m = unsafe { (*ht).is_mut };
        let elem_ptr: *mut HirType = unsafe { (*ht).elem };
        let pt = hir_type_to_typeid(mut_view(*cx), elem_ptr);
        return unsafe { intern_ptr_ty(mut_view((*cx.thir).interner), (TypeId { v: pt.v }), is_m) };
    }
    unsafe { type_error(mut_view(*cx), view((*ht).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) }
}

fn instantiate_path(
    cx: mut_view<TypeckCtx>,
    ty: TypeId,
    it: *const HirItem,
    path: view<HirPath>,
    out_args: mut_view<GenericArgsSlice>
) -> TypeId {
    if ty.v == 0u32 || (it as usize) == 0 { return (TypeId { v: ty.v }); }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    let mut param_count: usize = 0;
    if (gps as usize) != 0 {
        let mut p: *mut HirGenericParam = unsafe { (*gps).params };
        while ((p as usize) != 0) {
            param_count = param_count + 1;
            p = unsafe { (*p).next };
        }
    }
    if param_count == 0 { return (TypeId { v: ty.v }); }

    let bytes = mul_usize(param_count, size_of<TypeId>());
    let args_arr = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
    let gargs = (GenericArgsSlice { args: args_arr, count: param_count });

    let hga: *mut HirGenericArgs = path.generic_args;
    if (hga as usize) != 0 {
        let mut arg_count: usize = 0;
        let mut a: *mut HirGenericArg = unsafe { (*hga).args };
        while ((a as usize) != 0) {
            arg_count = arg_count + 1;
            a = unsafe { (*a).next };
        }
        if arg_count != param_count {
            return type_error(mut_view(*cx), view(path.span), AX_TYPE_ARG_COUNT);
        }
        let mut i: usize = 0;
        a = unsafe { (*hga).args };
        while ((a as usize) != 0) {
            let aty_ptr: *mut HirType = unsafe { (*a).ty };
            let aty = hir_type_to_typeid(mut_view(*cx), aty_ptr);
            let dst = unsafe { typeid_at(args_arr, i) };
            unsafe { (*dst).v = aty.v; }
            i = i + 1;
            a = unsafe { (*a).next };
        }
    } else {
        let mut i: usize = 0;
        while (i < param_count) {
            let tv = new_ty_var(mut_view(*cx), view(path.span));
            let dst = unsafe { typeid_at(args_arr, i) };
            unsafe { (*dst).v = tv.v; }
            i = i + 1;
        }
    }

    out_args.args = args_arr;
    out_args.count = param_count;
    unsafe {
        subst_ty_with_vars(mut_view((*cx.thir).interner), mut_view(cx.type_vars), (TypeId { v: ty.v }), view(gargs))
    }
}

fn builtin_name_kind(name: view<StrView>) -> u8 {
    let n = name.len;
    if (name.ptr as usize) == 0 || n < 3 || n > 23 { return 0u8; }
    if n == 3 && tc_sv_is_3(name, 108u8, 101u8, 110u8) { return TY_BUILTIN_LEN; }
    if n == 4 && tc_sv_is_4(name, 100u8, 114u8, 111u8, 112u8) { return TY_BUILTIN_DROP; }
    if n == 5 && tc_sv_is_5(name, 112u8, 114u8, 105u8, 110u8, 116u8) { return TY_BUILTIN_PRINT; }
    if n == 9 && tc_sv_is_9(name, 112u8, 114u8, 105u8, 110u8, 116u8, 95u8, 105u8, 110u8, 116u8) { return TY_BUILTIN_PRINT_INT; }
    let iref = intrinsic_lookup(StrView { ptr: name.ptr, len: name.len });
    if iref.has_desc {
        return iref.desc.builtin_ty;
    }
    0u8
}

fn tc_attr_is_intrinsic(at: *const HirAttr, str_in: view<StrInterner>) -> bool {
    if (at as usize) == 0 {
        return false;
    }
    let aname = unsafe { (*at).name };
    if aname.v == 0u32 {
        return false;
    }
    let sv = interner_get(str_in, StrId { v: aname.v });
    tc_sv_is_9(view(sv), 105u8, 110u8, 116u8, 114u8, 105u8, 110u8, 115u8, 105u8, 99u8)
}

fn tc_item_fn_name(it: *const HirItem, str_in: view<StrInterner>) -> StrView {
    if (it as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let fn_name_id = unsafe { (*it).name };
    if fn_name_id.v == 0u32 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    interner_get(str_in, StrId { v: fn_name_id.v })
}

fn intrinsic_attr_builtin_ty(it: *const HirItem, str_in: view<StrInterner>) -> u8 {
    if (it as usize) == 0 || unsafe { (*it).kind } != HIR_ITEM_FN {
        return 0u8;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        if tc_attr_is_intrinsic(at, str_in) {
            let arg: *mut HirAttrArg = unsafe { (*at).args };
            if (arg as usize) != 0 && (unsafe { (*arg).next } as usize) == 0 {
                let aexpr: *mut HirExpr = unsafe { (*arg).expr };
                if (aexpr as usize) != 0 && unsafe { (*aexpr).kind } == HIR_EXPR_LITERAL && unsafe { (*aexpr).literal.kind } == TOK_INT {
                    let encoded = unsafe { (*aexpr).literal.int_val };
                    let bty = ((encoded >> 32u64) & 0xFFu64) as u8;
                    if bty != 0u8 {
                        return bty;
                    }
                }
            }
            let fn_name = tc_item_fn_name(it, str_in);
            let iref = intrinsic_lookup(fn_name);
            if iref.has_desc {
                return iref.desc.builtin_ty;
            }
            return 0u8;
        }
        at = unsafe { (*at).next };
    }
    0u8
}

fn intrinsic_attr_code(it: *const HirItem, str_in: view<StrInterner>) -> u32 {
    if (it as usize) == 0 || unsafe { (*it).kind } != HIR_ITEM_FN {
        return 0u32;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        if tc_attr_is_intrinsic(at, str_in) {
            let arg: *mut HirAttrArg = unsafe { (*at).args };
            if (arg as usize) != 0 && (unsafe { (*arg).next } as usize) == 0 {
                let aexpr: *mut HirExpr = unsafe { (*arg).expr };
                if (aexpr as usize) != 0 && unsafe { (*aexpr).kind } == HIR_EXPR_LITERAL && unsafe { (*aexpr).literal.kind } == TOK_INT {
                    let encoded = unsafe { (*aexpr).literal.int_val };
                    let code = (encoded & 0xFFFFFFFFu64) as u32;
                    if code != 0u32 {
                        return code;
                    }
                }
            }
            let fn_name = tc_item_fn_name(it, str_in);
            let iref = intrinsic_lookup(fn_name);
            if iref.has_desc {
                return intrinsic_encode(view(iref));
            }
            return 0u32;
        }
        at = unsafe { (*at).next };
    }
    0u32
}

fn register_intrinsic_callee(cx: mut_view<TypeckCtx>, callee: *const HirExpr) {
    if (callee as usize) == 0 || (cx.hir as usize) == 0 || (cx.str_in as usize) == 0 {
        return;
    }
    if unsafe { (*callee).kind } != HIR_EXPR_PATH {
        return;
    }
    let sym_v = unsafe { (*callee).path.symbol.v };
    let mut found_item: *const HirItem = 0 as *const HirItem;
    if sym_v != 0u32 {
        let mut it: *mut HirItem = unsafe { (*cx.hir).items };
        while (it as usize) != 0 {
            if unsafe { (*it).kind } == HIR_ITEM_FN && unsafe { (*it).symbol.v } == sym_v {
                found_item = it;
                break;
            }
            it = unsafe { (*it).next };
        }
    }
    if (found_item as usize) == 0 {
        let name = unsafe { tc_path_name_sv(view(*cx), view((*callee).path)) };
        if name.len > 0 && (name.ptr as usize) != 0 {
            let mut it: *mut HirItem = unsafe { (*cx.hir).items };
            while (it as usize) != 0 {
                if unsafe { (*it).kind } == HIR_ITEM_FN {
                    let it_name = unsafe { tc_item_fn_name(it, view(*cx.str_in)) };
                    if sv_eq(view(it_name), view(name)) {
                        found_item = it;
                        break;
                    }
                }
                it = unsafe { (*it).next };
            }
        }
    }
    if (found_item as usize) != 0 {
        let code = unsafe { intrinsic_attr_code(found_item, view(*cx.str_in)) };
        if code != 0u32 {
            unsafe { thir_set_expr_variant(mut_view(*cx.thir), callee, code); }
        }
    }
}

fn annotate_intrinsic_item(arena: mut_view<Arena>, it: *mut HirItem, str_in: view<StrInterner>) {
    if (it as usize) == 0 || unsafe { (*it).kind } != HIR_ITEM_FN {
        return;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        if tc_attr_is_intrinsic(at, str_in) {
            if (unsafe { (*at).args } as usize) != 0 {
                return;
            }
            let fn_name = tc_item_fn_name(it, str_in);
            let iref = intrinsic_lookup(fn_name);
            if !iref.has_desc {
                return;
            }
            let code = intrinsic_encode(view(iref));
            let packed: u64 = ((iref.desc.builtin_ty as u64) << 32u64) | (code as u64);
            let arg_raw = arena_alloc_raw(mut_view(*arena), size_of<HirAttrArg>(), align_of<HirAttrArg>());
            tc_zero_bytes(arg_raw, size_of<HirAttrArg>());
            let expr_raw = arena_alloc_raw(mut_view(*arena), size_of<HirExpr>(), align_of<HirExpr>());
            tc_zero_bytes(expr_raw, size_of<HirExpr>());
            let arg_ptr = arg_raw as *mut HirAttrArg;
            let expr_ptr = expr_raw as *mut HirExpr;
            unsafe {
                (*expr_ptr).kind = HIR_EXPR_LITERAL;
                (*expr_ptr).span = (*at).span;
                (*expr_ptr).literal.kind = TOK_INT;
                (*expr_ptr).literal.int_val = packed;
                (*arg_ptr).span = (*at).span;
                (*arg_ptr).expr = expr_ptr;
                (*at).args = arg_ptr;
            }
            return;
        }
        at = unsafe { (*at).next };
    }
}

pub fn annotate_intrinsic_hir(arena: mut_view<Arena>, hir_file: view<HirFile>, str_in: view<StrInterner>) {
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        annotate_intrinsic_item(mut_view(*arena), it, str_in);
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                annotate_intrinsic_item(mut_view(*arena), m, str_in);
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
}

fn check_intrinsic_item(it: *const HirItem, thir: view<Thir>, sink: mut_view<DiagSink>, str_in: view<StrInterner>) {
    if (it as usize) == 0 || unsafe { (*it).kind } != HIR_ITEM_FN {
        return;
    }
    let mut has_intr = false;
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        if tc_attr_is_intrinsic(at, str_in) {
            has_intr = true;
            break;
        }
        at = unsafe { (*at).next };
    }
    if !has_intr {
        return;
    }
    let fn_name = tc_item_fn_name(it, str_in);
    let iref = intrinsic_lookup(fn_name);
    if !iref.has_desc || !intrinsic_signature_ok(view(iref), it, thir) {
        let sp = unsafe { (*it).span };
        report_typeck_diag(mut_view(*sink), AX_TYPE_UNKNOWN_INTRINSIC, sp.file.v, sp.start, sp.end);
    }
}

pub fn check_intrinsic_hir(hir_file: view<HirFile>, thir: view<Thir>, sink: mut_view<DiagSink>, str_in: view<StrInterner>) {
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_FN {
            let orig_m = find_orig_impl_member(hir_file, it);
            if (orig_m as usize) == 0 {
                check_intrinsic_item(it, thir, mut_view(*sink), str_in);
            }
        } else if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                check_intrinsic_item(m, thir, mut_view(*sink), str_in);
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
}

pub fn lookup_path_type(cx: mut_view<TypeckCtx>, path: view<HirPath>, out_args: mut_view<GenericArgsSlice>) -> TypeId {
    if path.symbol.v != 0u32 {
        let st = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: path.symbol.v })) };
        if st.v != 0u32 { return (TypeId { v: st.v }); }

        if (cx.hir as usize) != 0 {
            let mut it: *mut HirItem = unsafe { (*cx.hir).items };
            while ((it as usize) != 0) {
                let mut matched: bool = false;
                let ik = unsafe { (*it).kind };
                let isym = unsafe { (*it).symbol.v };
                if ik == HIR_ITEM_FN && isym == path.symbol.v { matched = true; }
                else if ik == HIR_ITEM_STRUCT && isym == path.symbol.v { matched = true; }
                else if ik == HIR_ITEM_ENUM {
                    if isym == path.symbol.v {
                        matched = true;
                    } else {
                        let mut v: *mut HirVariantDecl = unsafe { (*it).variants };
                        while ((v as usize) != 0) {
                            if unsafe { (*v).symbol.v } == path.symbol.v {
                                matched = true;
                                break;
                            }
                            v = unsafe { (*v).next };
                        }
                    }
                } else if ik == HIR_ITEM_TYPE_ALIAS && isym == path.symbol.v { matched = true; }
                else if ik == HIR_ITEM_CONST && isym == path.symbol.v { matched = true; }
                else if ik == HIR_ITEM_EXTERN_BLOCK {
                    let mut m: *mut HirItem = unsafe { (*it).members };
                    while ((m as usize) != 0) {
                        if unsafe { (*m).kind } == HIR_ITEM_FN && unsafe { (*m).symbol.v } == path.symbol.v {
                            let mt = unsafe { thir_get_item_type(view(*cx.thir), m) };
                            if mt.v != 0u32 {
                                return instantiate_path(mut_view(*cx), (TypeId { v: mt.v }), m, path, mut_view(*out_args));
                            }
                        }
                        m = unsafe { (*m).next };
                    }
                }

                if matched {
                    if ik == HIR_ITEM_FN && (cx.str_in as usize) != 0 {
                        let bk = unsafe { intrinsic_attr_builtin_ty(it, view(*cx.str_in)) };
                        if bk != 0u8 && bk != TY_BUILTIN_LEN && bk != TY_BUILTIN_PRINT && bk != TY_BUILTIN_PRINT_INT && bk != TY_BUILTIN_DROP {
                            let sty = unsafe { intern_singleton(mut_view((*cx.thir).interner), bk) };
                            return instantiate_path(mut_view(*cx), sty, it, path, mut_view(*out_args));
                        }
                    }
                    if ik == HIR_ITEM_CONST {
                        evaluate_const_item(mut_view(*cx), it);
                    }
                    let it_t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if it_t.v != 0u32 {
                        return instantiate_path(mut_view(*cx), (TypeId { v: it_t.v }), it, path, mut_view(*out_args));
                    }
                    if ik == HIR_ITEM_TYPE_ALIAS {
                        let aty_node: *mut HirType = unsafe { (*it).ty };
                        if (aty_node as usize) != 0 {
                            let old_fn = cx.current_fn;
                            cx.current_fn = it;
                            let computed = hir_type_to_typeid(mut_view(*cx), aty_node);
                            cx.current_fn = old_fn;
                            unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: computed.v })); }
                            return instantiate_path(mut_view(*cx), (TypeId { v: computed.v }), it, path, mut_view(*out_args));
                        }
                    }
                }
                it = unsafe { (*it).next };
            }
        }
    }

    let name = tc_path_name_sv(view(*cx), path);

    if path.symbol.v != 0u32 {
        if tc_sv_is_4(view(name), 83u8, 101u8, 108u8, 102u8) { // Self
            if cx.self_ty.v != 0u32 { return (TypeId { v: cx.self_ty.v }); }
            let sid = if (cx.str_in as usize) != 0 {
                unsafe { tc_intern_idx(mut_view(*cx.str_in), 30) }
            } else {
                (StrId { v: 0u32 })
            };
            return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: sid.v }), 0u32) };
        }
        let hga: *mut HirGenericArgs = path.generic_args;
        if (hga as usize) != 0 {
            let mut arg_count: usize = 0;
            let mut a: *mut HirGenericArg = unsafe { (*hga).args };
            while ((a as usize) != 0) {
                arg_count = arg_count + 1;
                a = unsafe { (*a).next };
            }
            let bytes = mul_usize(arg_count, size_of<TypeId>());
            let args_arr = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
            let mut i: usize = 0;
            a = unsafe { (*hga).args };
            while ((a as usize) != 0) {
                let aty_ptr: *mut HirType = unsafe { (*a).ty };
                let aty = hir_type_to_typeid(mut_view(*cx), aty_ptr);
                let dst = unsafe { typeid_at(args_arr, i) };
                unsafe { (*dst).v = aty.v; }
                i = i + 1;
                a = unsafe { (*a).next };
            }
            out_args.args = args_arr;
            out_args.count = arg_count;
        }
        let bk = builtin_name_kind(view(name));
        if bk != 0u8 {
            return unsafe { intern_singleton(mut_view((*cx.thir).interner), bk) };
        }
    }

    let bk2 = builtin_name_kind(view(name));
    if bk2 == TY_BUILTIN_LEN || bk2 == TY_BUILTIN_PRINT || bk2 == TY_BUILTIN_PRINT_INT || bk2 == TY_BUILTIN_DROP {
        return unsafe { intern_singleton(mut_view((*cx.thir).interner), bk2) };
    }

    if tc_sv_starts_self_dot(view(name)) {
        let assoc_name = StrView {
            ptr: unsafe { name.ptr + 5 },
            len: name.len - 5,
        };
        if (cx.current_impl as usize) != 0 {
            let ik = unsafe { (*cx.current_impl).kind };
            if ik == HIR_ITEM_IMPL {
                let mut m: *mut HirItem = unsafe { (*cx.current_impl).members };
                while ((m as usize) != 0) {
                    if unsafe { (*m).kind } == HIR_ITEM_TYPE_ALIAS && (cx.str_in as usize) != 0 {
                        let mname_id = unsafe { (*m).name.v };
                        let mname = unsafe { interner_get(view(*cx.str_in), (StrId { v: mname_id })) };
                        if sv_eq(view(mname), view(assoc_name)) {
                            let mty_ptr: *mut HirType = unsafe { (*m).ty };
                            return hir_type_to_typeid(mut_view(*cx), mty_ptr);
                        }
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        let aid = if (cx.str_in as usize) != 0 {
            unsafe { interner_intern_bytes(mut_view(*cx.str_in), assoc_name.ptr, assoc_name.len) }
        } else {
            (StrId { v: 0u32 })
        };
        return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: aid.v }), 0u32) };
    }

    lookup_path_type_by_name(mut_view(*cx), path, mut_view(*out_args), name)
}

fn lookup_path_type_by_name(
    cx: mut_view<TypeckCtx>,
    path: view<HirPath>,
    out_args: mut_view<GenericArgsSlice>,
    name: StrView
) -> TypeId {
    if tc_sv_is_4(view(name), 83u8, 101u8, 108u8, 102u8) { // Self
        if cx.self_ty.v != 0u32 { return (TypeId { v: cx.self_ty.v }); }
        let sid = if (cx.str_in as usize) != 0 {
            unsafe { tc_intern_idx(mut_view(*cx.str_in), 30) }
        } else {
            (StrId { v: 0u32 })
        };
        return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: sid.v }), 0u32) };
    }

    unsafe {
        if tc_sv_is_4(view(name), 98u8, 111u8, 111u8, 108u8) { return (TypeId { v: (*cx.thir).interner.t_bool.v }); }
        if tc_sv_is_4(view(name), 99u8, 104u8, 97u8, 114u8) { return (TypeId { v: (*cx.thir).interner.t_char.v }); }
        if tc_sv_is_2(view(name), 105u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_i8.v }); }
        if tc_sv_is_3(view(name), 105u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_i16.v }); }
        if tc_sv_is_3(view(name), 105u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_i32.v }); }
        if tc_sv_is_3(view(name), 105u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_i64.v }); }
        if tc_sv_is_5(view(name), 105u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_isize.v }); }
        if tc_sv_is_2(view(name), 117u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_u8.v }); }
        if tc_sv_is_3(view(name), 117u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_u16.v }); }
        if tc_sv_is_3(view(name), 117u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_u32.v }); }
        if tc_sv_is_3(view(name), 117u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_u64.v }); }
        if tc_sv_is_5(view(name), 117u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_usize.v }); }
        if tc_sv_is_3(view(name), 115u8, 116u8, 114u8) || tc_sv_is_3(view(name), 83u8, 116u8, 114u8) {
            return (TypeId { v: (*cx.thir).interner.t_str.v });
        }
    }

    if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*cx.hir).items };
        while ((it as usize) != 0) {
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_FN {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                if sv_eq(view(it_name), view(name)) {
                    let bk = unsafe { intrinsic_attr_builtin_ty(it, view(*cx.str_in)) };
                    if bk != 0u8 && bk != TY_BUILTIN_LEN && bk != TY_BUILTIN_PRINT && bk != TY_BUILTIN_PRINT_INT && bk != TY_BUILTIN_DROP {
                        let sty = unsafe { intern_singleton(mut_view((*cx.thir).interner), bk) };
                        return instantiate_path(mut_view(*cx), sty, it, path, mut_view(*out_args));
                    }
                    let t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if t.v != 0u32 {
                        return instantiate_path(mut_view(*cx), (TypeId { v: t.v }), it, path, mut_view(*out_args));
                    }
                }
            } else if ik == HIR_ITEM_CONST || ik == HIR_ITEM_STATIC {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                if sv_eq(view(it_name), view(name)) {
                    if ik == HIR_ITEM_CONST {
                        evaluate_const_item(mut_view(*cx), it);
                    }
                    let t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if t.v != 0u32 {
                        return (TypeId { v: t.v });
                    }
                }
            } else if ik == HIR_ITEM_STRUCT {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                let mut s_len = name.len;
                let mut k: usize = 0;
                while (k < name.len) {
                    if unsafe { *(name.ptr + k) } == 60u8 { // '<'
                        s_len = k;
                        break;
                    }
                    k = k + 1;
                }
                let struct_name = StrView { ptr: name.ptr, len: s_len };
                if sv_eq(view(it_name), view(struct_name)) {
                    let t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if t.v != 0u32 {
                        return instantiate_path(mut_view(*cx), (TypeId { v: t.v }), it, path, mut_view(*out_args));
                    }
                    let ev = unsafe { (*cx.thir).interner.t_error.v };
                    return (TypeId { v: ev });
                }
            } else if ik == HIR_ITEM_ENUM {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                let mut e_len = name.len;
                let mut k: usize = 0;
                while (k < name.len) {
                    let ch = unsafe { *(name.ptr + k) };
                    if ch == 46u8 || ch == 60u8 { // '.' or '<'
                        e_len = k;
                        break;
                    }
                    k = k + 1;
                }
                let enum_name = StrView { ptr: name.ptr, len: e_len };
                if sv_eq(view(it_name), view(enum_name)) {
                    let t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if t.v != 0u32 {
                        return instantiate_path(mut_view(*cx), (TypeId { v: t.v }), it, path, mut_view(*out_args));
                    }
                }
            }
            it = unsafe { (*it).next };
        }
    }

    if (cx.current_impl as usize) != 0 && (cx.str_in as usize) != 0 {
        let gps: *mut HirGenericParams = unsafe { (*cx.current_impl).generic_params };
        if (gps as usize) != 0 {
            let mut idx: usize = 0;
            let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
            while ((gp as usize) != 0) {
                let gname_id = unsafe { (*gp).name.v };
                let gp_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_id })) };
                if sv_eq(view(gp_name), view(name)) {
                    return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: gname_id }), idx as u32) };
                }
                idx = idx + 1;
                gp = unsafe { (*gp).next };
            }
        }
    }

    if (cx.current_fn as usize) != 0 && (cx.str_in as usize) != 0 {
        let gps: *mut HirGenericParams = unsafe { (*cx.current_fn).generic_params };
        if (gps as usize) != 0 {
            let mut idx: usize = 0;
            let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
            while ((gp as usize) != 0) {
                let gname_id = unsafe { (*gp).name.v };
                let gp_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_id })) };
                if sv_eq(view(gp_name), view(name)) {
                    return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: gname_id }), idx as u32) };
                }
                idx = idx + 1;
                gp = unsafe { (*gp).next };
            }
        }
    }

    type_error(mut_view(*cx), view(path.span), AX_NAME_UNRESOLVED)
}

fn tc_alloc_expr(cx: mut_view<TypeckCtx>, kind: u8, fv: u32, st: u32, en: u32) -> *mut HirExpr {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirExpr>(), align_of<HirExpr>()) };
    tc_zero_bytes(raw, size_of<HirExpr>());
    let e = raw as *mut HirExpr;
    unsafe {
        (*e).kind = kind;
        (*e).span.file.v = fv;
        (*e).span.start = st;
        (*e).span.end = en;
    }
    e
}

fn tc_alloc_stmt(cx: mut_view<TypeckCtx>, kind: u8, fv: u32, st: u32, en: u32) -> *mut HirStmt {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirStmt>(), align_of<HirStmt>()) };
    tc_zero_bytes(raw, size_of<HirStmt>());
    let s = raw as *mut HirStmt;
    unsafe {
        (*s).kind = kind;
        (*s).span.file.v = fv;
        (*s).span.start = st;
        (*s).span.end = en;
    }
    s
}

fn tc_alloc_pat(cx: mut_view<TypeckCtx>, kind: u8, fv: u32, st: u32, en: u32) -> *mut HirPat {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirPat>(), align_of<HirPat>()) };
    tc_zero_bytes(raw, size_of<HirPat>());
    let p = raw as *mut HirPat;
    unsafe {
        (*p).kind = kind;
        (*p).span.file.v = fv;
        (*p).span.start = st;
        (*p).span.end = en;
    }
    p
}

fn tc_alloc_block(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32) -> *mut HirBlock {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirBlock>(), align_of<HirBlock>()) };
    tc_zero_bytes(raw, size_of<HirBlock>());
    let b = raw as *mut HirBlock;
    unsafe {
        (*b).span.file.v = fv;
        (*b).span.start = st;
        (*b).span.end = en;
    }
    b
}

fn tc_alloc_match_arm(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32) -> *mut HirMatchArm {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirMatchArm>(), align_of<HirMatchArm>()) };
    tc_zero_bytes(raw, size_of<HirMatchArm>());
    let a = raw as *mut HirMatchArm;
    unsafe {
        (*a).span.file.v = fv;
        (*a).span.start = st;
        (*a).span.end = en;
    }
    a
}

fn tc_alloc_field_init(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32) -> *mut HirFieldInit {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirFieldInit>(), align_of<HirFieldInit>()) };
    tc_zero_bytes(raw, size_of<HirFieldInit>());
    let f = raw as *mut HirFieldInit;
    unsafe {
        (*f).span.file.v = fv;
        (*f).span.start = st;
        (*f).span.end = en;
    }
    f
}

fn desugar_let_else(cx: mut_view<TypeckCtx>, stmt: *mut HirStmt) {
    if (stmt as usize) == 0 { return; }
    let else_b: *mut HirBlock = unsafe { (*stmt).else_block };
    if (else_b as usize) == 0 { return; }

    let sfv = unsafe { (*stmt).span.file.v };
    let sst = unsafe { (*stmt).span.start };
    let sen = unsafe { (*stmt).span.end };
    let efv = unsafe { (*else_b).span.file.v };
    let est = unsafe { (*else_b).span.start };
    let een = unsafe { (*else_b).span.end };

    let arm_else = tc_alloc_match_arm(mut_view(*cx), sfv, sst, sen);
    let wild = tc_alloc_pat(mut_view(*cx), HIR_PAT_WILDCARD, sfv, sst, sen);
    let else_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, efv, est, een);
    unsafe {
        (*else_blk).block = else_b;
        (*arm_else).pat = wild;
        (*arm_else).body = else_blk;
    }

    let arm_then = tc_alloc_match_arm(mut_view(*cx), sfv, sst, sen);
    let then_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, sfv, sst, sen);
    let unit_b = tc_alloc_block(mut_view(*cx), sfv, sst, sen);
    let lpat: *mut HirPat = unsafe { (*stmt).pat };
    let lexpr: *mut HirExpr = unsafe { (*stmt).expr };
    unsafe {
        (*then_blk).block = unit_b;
        (*arm_then).pat = lpat;
        (*arm_then).body = then_blk;
        (*arm_then).next = arm_else;
    }

    let match_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_MATCH, sfv, sst, sen);
    unsafe {
        (*match_expr).cond = lexpr;
        (*match_expr).arms = arm_then;
        (*stmt).kind = HIR_STMT_EXPR;
        (*stmt).expr = match_expr;
        (*stmt).has_semi = true;
    }
}

fn desugar_if_let(cx: mut_view<TypeckCtx>, expr: *mut HirExpr) {
    if (expr as usize) == 0 { return; }
    let lpat: *mut HirPat = unsafe { (*expr).let_pat };
    if (lpat as usize) == 0 { return; }

    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };

    let arm_else = tc_alloc_match_arm(mut_view(*cx), efv, est, een);
    let wild = tc_alloc_pat(mut_view(*cx), HIR_PAT_WILDCARD, efv, est, een);
    let mut else_blk: *mut HirExpr = unsafe { (*expr).else_branch };
    if (else_blk as usize) == 0 {
        else_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, efv, est, een);
        let ub = tc_alloc_block(mut_view(*cx), efv, est, een);
        unsafe { (*else_blk).block = ub; }
    }
    unsafe {
        (*arm_else).pat = wild;
        (*arm_else).body = else_blk;
    }

    let tblk_ptr: *mut HirBlock = unsafe { (*expr).block };
    let bfv = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.file.v } } else { efv };
    let bst = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.start } } else { est };
    let ben = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.end } } else { een };

    let arm_then = tc_alloc_match_arm(mut_view(*cx), bfv, bst, ben);
    let then_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, bfv, bst, ben);
    unsafe {
        (*then_blk).block = tblk_ptr;
        (*arm_then).pat = lpat;
        (*arm_then).body = then_blk;
        (*arm_then).next = arm_else;
        (*expr).kind = HIR_EXPR_MATCH;
        (*expr).arms = arm_then;
    }
}

fn desugar_while_let(cx: mut_view<TypeckCtx>, expr: *mut HirExpr) {
    if (expr as usize) == 0 { return; }
    let lpat: *mut HirPat = unsafe { (*expr).let_pat };
    if (lpat as usize) == 0 { return; }

    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };

    let brk_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_JUMP, efv, est, een);
    unsafe {
        (*brk_expr).jump_kind = JUMP_BREAK;
        (*brk_expr).label.v = 0u32;
        (*brk_expr).inner = 0 as *mut HirExpr;
    }

    let arm_else = tc_alloc_match_arm(mut_view(*cx), efv, est, een);
    let wild = tc_alloc_pat(mut_view(*cx), HIR_PAT_WILDCARD, efv, est, een);
    unsafe {
        (*arm_else).pat = wild;
        (*arm_else).body = brk_expr;
    }

    let tblk_ptr: *mut HirBlock = unsafe { (*expr).block };
    let bfv = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.file.v } } else { efv };
    let bst = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.start } } else { est };
    let ben = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.end } } else { een };

    let arm_then = tc_alloc_match_arm(mut_view(*cx), bfv, bst, ben);
    let then_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, bfv, bst, ben);
    unsafe {
        (*then_blk).block = tblk_ptr;
        (*arm_then).pat = lpat;
        (*arm_then).body = then_blk;
        (*arm_then).next = arm_else;
    }

    let match_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_MATCH, efv, est, een);
    let wcond: *mut HirExpr = unsafe { (*expr).cond };
    unsafe {
        (*match_expr).cond = wcond;
        (*match_expr).arms = arm_then;
    }

    let match_stmt = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
    unsafe {
        (*match_stmt).expr = match_expr;
        (*match_stmt).has_semi = false;
    }

    let loop_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
    unsafe {
        (*loop_blk).stmts = match_stmt;
        (*expr).kind = HIR_EXPR_LOOP;
        (*expr).block = loop_blk;
    }
}

fn make_var_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, sym: SymbolId, name_idx: usize) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_PATH, fv, st, en);
    let nid = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), name_idx) }
    } else {
        (StrId { v: 0u32 })
    };
    unsafe {
        (*e).path.symbol.v = sym.v;
        (*e).path.name.v = nid.v;
    }
    e
}

fn make_let_stmt(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, sym: SymbolId, is_mut: bool, init_expr: *mut HirExpr) -> *mut HirStmt {
    let s = tc_alloc_stmt(mut_view(*cx), HIR_STMT_LET, fv, st, en);
    let p = tc_alloc_pat(mut_view(*cx), HIR_PAT_BINDING, fv, st, en);
    unsafe {
        (*p).is_mut = is_mut;
        (*p).symbol.v = sym.v;
        (*s).pat = p;
        (*s).expr = init_expr;
    }
    s
}

fn make_assign_stmt(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, left: *mut HirExpr, right: *mut HirExpr) -> *mut HirStmt {
    let s = tc_alloc_stmt(mut_view(*cx), HIR_STMT_ASSIGN, fv, st, en);
    unsafe {
        (*s).left = left;
        (*s).right = right;
    }
    s
}

fn make_binop_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, op: u8, left: *mut HirExpr, right: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BINARY, fv, st, en);
    unsafe {
        (*e).op = op;
        (*e).left = left;
        (*e).right = right;
    }
    e
}

fn make_unary_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, op: u8, inner: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_UNARY, fv, st, en);
    unsafe {
        (*e).op = op;
        (*e).inner = inner;
    }
    e
}

fn make_int_literal(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, val: u64, suffix: u8) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_LITERAL, fv, st, en);
    unsafe {
        (*e).literal.kind = TOK_INT;
        (*e).literal.span.file.v = fv;
        (*e).literal.span.start = st;
        (*e).literal.span.end = en;
        (*e).literal.int_val = val;
        (*e).literal.suffix = suffix;
    }
    e
}

fn make_bool_literal(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, val: bool) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_LITERAL, fv, st, en);
    unsafe {
        (*e).literal.kind = if val { TOK_KW_TRUE } else { TOK_KW_FALSE };
        (*e).literal.span.file.v = fv;
        (*e).literal.span.start = st;
        (*e).literal.span.end = en;
    }
    e
}

fn make_call_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, callee_idx: usize, args: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_CALL, fv, st, en);
    let callee = tc_alloc_expr(mut_view(*cx), HIR_EXPR_PATH, 0u32, 0u32, 0u32);
    let nid = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), callee_idx) }
    } else {
        (StrId { v: 0u32 })
    };
    unsafe {
        (*callee).path.symbol.v = 0x50000001u32;
        (*callee).path.name.v = nid.v;
        (*e).callee = callee;
        (*e).args = args;
    }
    e
}

fn make_index_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, base: *mut HirExpr, arg: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_INDEX, fv, st, en);
    unsafe {
        (*e).base = base;
        (*e).index_arg = arg;
    }
    e
}

fn make_method_call_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, receiver: *mut HirExpr, method_idx: usize, args: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_METHOD_CALL, fv, st, en);
    let mid = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), method_idx) }
    } else {
        (StrId { v: 0u32 })
    };
    unsafe {
        (*e).receiver = receiver;
        (*e).method_name.v = mid.v;
        (*e).args = args;
    }
    e
}

fn make_option_some_pat(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, inner_pat: *mut HirPat) -> *mut HirPat {
    let p = tc_alloc_pat(mut_view(*cx), HIR_PAT_PATH, fv, st, en);
    let nid = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), 1) }
    } else {
        (StrId { v: 0u32 })
    };
    let tup = tc_alloc_pat(mut_view(*cx), HIR_PAT_TUPLE, fv, st, en);
    unsafe {
        (*p).path.name.v = nid.v;
        (*tup).elems = inner_pat;
        if (inner_pat as usize) != 0 {
            (*inner_pat).next = 0 as *mut HirPat;
        }
        (*p).payload = tup;
    }
    p
}

fn desugar_range(cx: mut_view<TypeckCtx>, expr: *mut HirExpr) {
    if (expr as usize) == 0 { return; }
    if unsafe { (*expr).kind } != HIR_EXPR_RANGE { return; }
    let is_inc = unsafe { (*expr).is_inclusive };
    let start_e: *mut HirExpr = unsafe { (*expr).start_expr };
    let end_e: *mut HirExpr = unsafe { (*expr).end_expr };
    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };

    let sfv = if (start_e as usize) != 0 { unsafe { (*start_e).span.file.v } } else { efv };
    let sst = if (start_e as usize) != 0 { unsafe { (*start_e).span.start } } else { est };
    let sen = if (start_e as usize) != 0 { unsafe { (*start_e).span.end } } else { een };
    let f_start = tc_alloc_field_init(mut_view(*cx), sfv, sst, sen);
    let start_id = if (cx.str_in as usize) != 0 { unsafe { tc_intern_idx(mut_view(*cx.str_in), 2) } } else { (StrId { v: 0u32 }) };

    let dfv = if (end_e as usize) != 0 { unsafe { (*end_e).span.file.v } } else { efv };
    let dst = if (end_e as usize) != 0 { unsafe { (*end_e).span.start } } else { est };
    let den = if (end_e as usize) != 0 { unsafe { (*end_e).span.end } } else { een };
    let f_end = tc_alloc_field_init(mut_view(*cx), dfv, dst, den);
    let end_id = if (cx.str_in as usize) != 0 { unsafe { tc_intern_idx(mut_view(*cx.str_in), 3) } } else { (StrId { v: 0u32 }) };

    unsafe {
        (*f_start).name.v = start_id.v;
        (*f_start).expr = start_e;
        (*f_end).name.v = end_id.v;
        (*f_end).expr = end_e;
        (*f_start).next = f_end;
    }

    if is_inc {
        let f_done = tc_alloc_field_init(mut_view(*cx), efv, est, een);
        let done_id = if (cx.str_in as usize) != 0 { unsafe { tc_intern_idx(mut_view(*cx.str_in), 4) } } else { (StrId { v: 0u32 }) };
        let b_lit = make_bool_literal(mut_view(*cx), efv, est, een, false);
        unsafe {
            (*f_done).name.v = done_id.v;
            (*f_done).expr = b_lit;
            (*f_end).next = f_done;
        }
    }

    let rname_id = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), if is_inc { 6 } else { 5 }) }
    } else {
        (StrId { v: 0u32 })
    };
    unsafe {
        (*expr).kind = HIR_EXPR_STRUCT;
        (*expr).path.span.file.v = 0u32;
        (*expr).path.span.start = 0u32;
        (*expr).path.span.end = 0u32;
        (*expr).path.symbol.v = 0u32;
        (*expr).path.name.v = rname_id.v;
        (*expr).path.generic_args = 0 as *mut HirGenericArgs;
        (*expr).fields = f_start;
    }
}

fn desugar_for_range_helper(
    cx: mut_view<TypeckCtx>,
    expr: *mut HirExpr,
    is_inc: bool,
    start_e: *mut HirExpr,
    end_e: *mut HirExpr,
    label_v: u32,
    pat: *mut HirPat,
    body_blk: *mut HirBlock
) {
    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };
    let bfv = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.file.v } } else { efv };
    let bst = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.start } } else { est };
    let ben = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.end } } else { een };
    let body_stmts: *mut HirStmt = if (body_blk as usize) != 0 { unsafe { (*body_blk).stmts } } else { 0 as *mut HirStmt };

    let cur_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
    cx.next_closure_id = cx.next_closure_id + 1u32;
    let end_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
    cx.next_closure_id = cx.next_closure_id + 1u32;

    let sfv = if (start_e as usize) != 0 { unsafe { (*start_e).span.file.v } } else { efv };
    let sst = if (start_e as usize) != 0 { unsafe { (*start_e).span.start } } else { est };
    let sen = if (start_e as usize) != 0 { unsafe { (*start_e).span.end } } else { een };
    let dfv = if (end_e as usize) != 0 { unsafe { (*end_e).span.file.v } } else { efv };
    let dst = if (end_e as usize) != 0 { unsafe { (*end_e).span.start } } else { est };
    let den = if (end_e as usize) != 0 { unsafe { (*end_e).span.end } } else { een };

    let s1 = make_let_stmt(mut_view(*cx), sfv, sst, sen, (SymbolId { v: cur_sym.v }), true, start_e);
    let s2 = make_let_stmt(mut_view(*cx), dfv, dst, den, (SymbolId { v: end_sym.v }), false, end_e);
    unsafe { (*s1).next = s2; }

    let pfv = if (pat as usize) != 0 { unsafe { (*pat).span.file.v } } else { efv };
    let pst = if (pat as usize) != 0 { unsafe { (*pat).span.start } } else { est };
    let pen = if (pat as usize) != 0 { unsafe { (*pat).span.end } } else { een };

    if !is_inc {
        let v_cur1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let v_end1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: end_sym.v }), 8);
        let cond = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_LT, v_cur1, v_end1);

        let sa = tc_alloc_stmt(mut_view(*cx), HIR_STMT_LET, pfv, pst, pen);
        let v_cur2 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        unsafe {
            (*sa).pat = pat;
            (*sa).expr = v_cur2;
        }

        let one_lit = make_int_literal(mut_view(*cx), efv, est, een, 1u64, SUFFIX_NONE);
        let v_cur3 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let add_expr = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_ADD, v_cur3, one_lit);
        let v_cur4 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let sb = make_assign_stmt(mut_view(*cx), efv, est, een, v_cur4, add_expr);
        unsafe {
            (*sa).next = sb;
            (*sb).next = body_stmts;
        }

        let w_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_WHILE, efv, est, een);
        let w_blk = tc_alloc_block(mut_view(*cx), bfv, bst, ben);
        unsafe {
            (*w_blk).stmts = sa;
            (*w_expr).label.v = label_v;
            (*w_expr).cond = cond;
            (*w_expr).block = w_blk;
        }

        let sw = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
        let outer_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
        unsafe {
            (*sw).expr = w_expr;
            (*sw).has_semi = false;
            (*s2).next = sw;
            (*outer_blk).stmts = s1;
            (*expr).kind = HIR_EXPR_BLOCK;
            (*expr).block = outer_blk;
        }
    } else {
        let done_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
        cx.next_closure_id = cx.next_closure_id + 1u32;
        let b_false = make_bool_literal(mut_view(*cx), efv, est, een, false);
        let s3 = make_let_stmt(mut_view(*cx), efv, est, een, (SymbolId { v: done_sym.v }), true, b_false);
        unsafe { (*s2).next = s3; }

        let v_done1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: done_sym.v }), 9);
        let not_done = make_unary_expr(mut_view(*cx), efv, est, een, UNOP_NOT, v_done1);
        let v_cur1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let v_end1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: end_sym.v }), 8);
        let cur_le = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_LE, v_cur1, v_end1);
        let cond = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_LOGAND, not_done, cur_le);

        let sa = tc_alloc_stmt(mut_view(*cx), HIR_STMT_LET, pfv, pst, pen);
        let v_cur2 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        unsafe {
            (*sa).pat = pat;
            (*sa).expr = v_cur2;
        }

        let if_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_IF, efv, est, een);
        let v_cur_ge = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let v_end_ge = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: end_sym.v }), 8);
        let ge_cond = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_GE, v_cur_ge, v_end_ge);
        let v_done_set = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: done_sym.v }), 9);
        let b_true = make_bool_literal(mut_view(*cx), efv, est, een, true);
        let set_done = make_assign_stmt(mut_view(*cx), efv, est, een, v_done_set, b_true);
        let if_blk = tc_alloc_block(mut_view(*cx), efv, est, een);

        let one_lit = make_int_literal(mut_view(*cx), efv, est, een, 1u64, SUFFIX_NONE);
        let v_cur_add = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let add_expr = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_ADD, v_cur_add, one_lit);
        let v_cur_dst = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let inc_cur = make_assign_stmt(mut_view(*cx), efv, est, een, v_cur_dst, add_expr);
        let else_blk_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, efv, est, een);
        let else_b = tc_alloc_block(mut_view(*cx), efv, est, een);

        unsafe {
            (*if_blk).stmts = set_done;
            (*else_b).stmts = inc_cur;
            (*else_blk_expr).block = else_b;
            (*if_expr).cond = ge_cond;
            (*if_expr).block = if_blk;
            (*if_expr).else_branch = else_blk_expr;
        }

        let sb = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
        unsafe {
            (*sb).expr = if_expr;
            (*sb).has_semi = false;
            (*sa).next = sb;
            (*sb).next = body_stmts;
        }

        let w_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_WHILE, efv, est, een);
        let w_blk = tc_alloc_block(mut_view(*cx), bfv, bst, ben);
        unsafe {
            (*w_blk).stmts = sa;
            (*w_expr).label.v = label_v;
            (*w_expr).cond = cond;
            (*w_expr).block = w_blk;
        }

        let sw = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
        let outer_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
        unsafe {
            (*sw).expr = w_expr;
            (*sw).has_semi = false;
            (*s3).next = sw;
            (*outer_blk).stmts = s1;
            (*expr).kind = HIR_EXPR_BLOCK;
            (*expr).block = outer_blk;
        }
    }
}

fn desugar_for(cx: mut_view<TypeckCtx>, expr: *mut HirExpr) {
    if (expr as usize) == 0 { return; }
    if unsafe { (*expr).kind } != HIR_EXPR_FOR { return; }

    let label_v = unsafe { (*expr).label.v };
    let pat: *mut HirPat = unsafe { (*expr).pat };
    let iter: *mut HirExpr = unsafe { (*expr).iter };
    let body_blk: *mut HirBlock = unsafe { (*expr).block };
    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };

    if (iter as usize) != 0 && unsafe { (*iter).kind } == HIR_EXPR_RANGE {
        let is_inc = unsafe { (*iter).is_inclusive };
        let start_e: *mut HirExpr = unsafe { (*iter).start_expr };
        let end_e: *mut HirExpr = unsafe { (*iter).end_expr };
        desugar_for_range_helper(mut_view(*cx), expr, is_inc, start_e, end_e, label_v, pat, body_blk);
        return;
    }

    let raw_iter_ty = check_expr(mut_view(*cx), iter, (TypeId { v: 0u32 }));
    let iter_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_iter_ty.v }));
    if is_error(mut_view(*cx), (TypeId { v: iter_ty.v })) { return; }

    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: iter_ty.v })) };
    if (t as usize) == 0 { return; }
    let tk = unsafe { (*t).kind };
    let is_array = tk == TY_ARRAY;
    let mut is_slice = false;
    if tk == TY_VIEW || tk == TY_MUT_VIEW {
        let pt_v = unsafe { (*t).pointee.v };
        let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pt_v })) };
        if (pt as usize) != 0 {
            let ptk = unsafe { (*pt).kind };
            if ptk == TY_SLICE || ptk == TY_ARRAY {
                is_slice = true;
            }
        }
    }

    if is_array || is_slice {
        let arr_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
        cx.next_closure_id = cx.next_closure_id + 1u32;
        let idx_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
        cx.next_closure_id = cx.next_closure_id + 1u32;
        let len_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
        cx.next_closure_id = cx.next_closure_id + 1u32;

        let ifv = if (iter as usize) != 0 { unsafe { (*iter).span.file.v } } else { efv };
        let ist = if (iter as usize) != 0 { unsafe { (*iter).span.start } } else { est };
        let ien = if (iter as usize) != 0 { unsafe { (*iter).span.end } } else { een };

        let s1 = make_let_stmt(mut_view(*cx), ifv, ist, ien, (SymbolId { v: arr_sym.v }), false, iter);
        let zero_usize = make_int_literal(mut_view(*cx), efv, est, een, 0u64, SUFFIX_USIZE);
        let s2 = make_let_stmt(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), true, zero_usize);
        let v_arr1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: arr_sym.v }), 10);
        let len_call = make_call_expr(mut_view(*cx), efv, est, een, 11, v_arr1);
        let s3 = make_let_stmt(mut_view(*cx), efv, est, een, (SymbolId { v: len_sym.v }), false, len_call);
        unsafe {
            (*s1).next = s2;
            (*s2).next = s3;
        }

        let v_idx1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), 12);
        let v_len1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: len_sym.v }), 13);
        let cond = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_LT, v_idx1, v_len1);

        let v_arr2 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: arr_sym.v }), 10);
        let v_idx2 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), 12);
        let idx_expr = make_index_expr(mut_view(*cx), efv, est, een, v_arr2, v_idx2);

        let pfv = if (pat as usize) != 0 { unsafe { (*pat).span.file.v } } else { efv };
        let pst = if (pat as usize) != 0 { unsafe { (*pat).span.start } } else { est };
        let pen = if (pat as usize) != 0 { unsafe { (*pat).span.end } } else { een };
        let sa = tc_alloc_stmt(mut_view(*cx), HIR_STMT_LET, pfv, pst, pen);
        unsafe {
            (*sa).pat = pat;
            (*sa).expr = idx_expr;
        }

        let one_usize = make_int_literal(mut_view(*cx), efv, est, een, 1u64, SUFFIX_USIZE);
        let v_idx3 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), 12);
        let add_idx = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_ADD, v_idx3, one_usize);
        let v_idx4 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), 12);
        let sb = make_assign_stmt(mut_view(*cx), efv, est, een, v_idx4, add_idx);

        let bfv = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.file.v } } else { efv };
        let bst = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.start } } else { est };
        let ben = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.end } } else { een };
        let body_stmts: *mut HirStmt = if (body_blk as usize) != 0 { unsafe { (*body_blk).stmts } } else { 0 as *mut HirStmt };
        unsafe {
            (*sa).next = sb;
            (*sb).next = body_stmts;
        }

        let w_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_WHILE, efv, est, een);
        let w_blk = tc_alloc_block(mut_view(*cx), bfv, bst, ben);
        let sw = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
        let outer_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
        unsafe {
            (*w_blk).stmts = sa;
            (*w_expr).label.v = label_v;
            (*w_expr).cond = cond;
            (*w_expr).block = w_blk;
            (*sw).expr = w_expr;
            (*sw).has_semi = false;
            (*s3).next = sw;
            (*outer_blk).stmts = s1;
            (*expr).kind = HIR_EXPR_BLOCK;
            (*expr).block = outer_blk;
        }
        return;
    }

    let mut trait_res: u8 = TRAIT_DISPROVEN;
    let next_sv = unsafe { tc_alloc_sv(mut_view((*cx.thir).interner.arena), 14) };
    let method_item = if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
        unsafe {
            find_method(view(*cx.hir), view(*cx.thir), (TypeId { v: iter_ty.v }), view(next_sv), view(*cx.str_in), view(*cx.db), mut_view(trait_res))
        }
    } else {
        0 as *mut HirItem
    };

    if (method_item as usize) == 0 && tk == TY_STRUCT && (cx.str_in as usize) != 0 {
        let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
        if (sdef as usize) != 0 {
            let sname_id = unsafe { (*sdef).name.v };
            let sname = unsafe { interner_get(view(*cx.str_in), (StrId { v: sname_id })) };
            let is_range = tc_sv_is_5(view(sname), 82u8, 97u8, 110u8, 103u8, 101u8); // Range
            let mut is_range_inc = false;
            if sname.len == 14 && (sname.ptr as usize) != 0 {
                if unsafe { *(sname.ptr + 0) == 82u8 && *(sname.ptr + 5) == 73u8 && *(sname.ptr + 13) == 101u8 } {
                    is_range_inc = true;
                }
            }
            if is_range || is_range_inc {
                let r_start = tc_alloc_expr(mut_view(*cx), HIR_EXPR_FIELD, efv, est, een);
                let start_id = unsafe { tc_intern_idx(mut_view(*cx.str_in), 2) };
                let r_end = tc_alloc_expr(mut_view(*cx), HIR_EXPR_FIELD, efv, est, een);
                let end_id = unsafe { tc_intern_idx(mut_view(*cx.str_in), 3) };
                unsafe {
                    (*r_start).base = iter;
                    (*r_start).name.v = start_id.v;
                    (*r_end).base = iter;
                    (*r_end).name.v = end_id.v;
                }
                desugar_for_range_helper(mut_view(*cx), expr, is_range_inc, r_start, r_end, label_v, pat, body_blk);
                return;
            }
        }
    }

    let iter_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
    cx.next_closure_id = cx.next_closure_id + 1u32;
    let ifv = if (iter as usize) != 0 { unsafe { (*iter).span.file.v } } else { efv };
    let ist = if (iter as usize) != 0 { unsafe { (*iter).span.start } } else { est };
    let ien = if (iter as usize) != 0 { unsafe { (*iter).span.end } } else { een };
    let s1 = make_let_stmt(mut_view(*cx), ifv, ist, ien, (SymbolId { v: iter_sym.v }), true, iter);

    let w_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_WHILE, efv, est, een);
    let some_pat = make_option_some_pat(mut_view(*cx), efv, est, een, pat);
    let v_iter = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: iter_sym.v }), 15);
    let next_call = make_method_call_expr(mut_view(*cx), efv, est, een, v_iter, 14, 0 as *mut HirExpr);
    let sw = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
    let outer_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
    unsafe {
        (*w_expr).label.v = label_v;
        (*w_expr).let_pat = some_pat;
        (*w_expr).cond = next_call;
        (*w_expr).block = body_blk;
        (*sw).expr = w_expr;
        (*sw).has_semi = false;
        (*s1).next = sw;
        (*outer_blk).stmts = s1;
        (*expr).kind = HIR_EXPR_BLOCK;
        (*expr).block = outer_blk;
    }
}

pub fn is_pat_irrefutable(cx: mut_view<TypeckCtx>, pat: *const HirPat, ty: TypeId) -> bool {
    if (pat as usize) == 0 { return true; }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_WILDCARD || pk == HIR_PAT_BINDING { return true; }
    if pk == HIR_PAT_TUPLE {
        let mut p: *mut HirPat = unsafe { (*pat).elems };
        if (p as usize) != 0 {
            let t = if ty.v == 0u32 { 0 as *mut AxType } else { unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty.v })) } };
            let mut i: usize = 0;
            while ((p as usize) != 0) {
                let mut inner_ty = (TypeId { v: 0u32 });
                if (t as usize) != 0 && unsafe { (*t).kind } == TY_TUPLE && i < unsafe { (*t).field_count } {
                    let fptr = unsafe { (*t).fields };
                    let fv = unsafe { (*typeid_at(fptr, i)).v };
                    inner_ty.v = fv;
                }
                if !is_pat_irrefutable(mut_view(*cx), p, (TypeId { v: inner_ty.v })) { return false; }
                i = i + 1;
                p = unsafe { (*p).next };
            }
        }
        return true;
    }
    if pk == HIR_PAT_STRUCT || pk == HIR_PAT_PATH {
        if ty.v == 0u32 { return true; }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty.v })) };
        if (t as usize) == 0 { return true; }
        let tk = unsafe { (*t).kind };
        if tk == TY_STRUCT {
            if pk == HIR_PAT_STRUCT {
                let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let mut pf: *mut HirPatField = unsafe { (*pat).fields };
                while ((pf as usize) != 0) {
                    let mut idx: usize = 0;
                    if (sdef as usize) != 0 {
                        let mut fd: *mut HirFieldDecl = unsafe { (*sdef).struct_fields };
                        while ((fd as usize) != 0) {
                            if unsafe { (*fd).name.v == (*pf).name.v } { break; }
                            idx = idx + 1;
                            fd = unsafe { (*fd).next };
                        }
                    }
                    if idx < unsafe { (*t).field_count } {
                        let fptr = unsafe { (*t).fields };
                        let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                        let pf_pat: *mut HirPat = unsafe { (*pf).pat };
                        if !is_pat_irrefutable(mut_view(*cx), pf_pat, (TypeId { v: fty_v })) { return false; }
                    }
                    pf = unsafe { (*pf).next };
                }
            }
            return true;
        }
        if tk == TY_ENUM && unsafe { (*t).variant_count } == 1 {
            if pk == HIR_PAT_STRUCT {
                let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let vd: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
                if (vd as usize) != 0 {
                    let mut pf: *mut HirPatField = unsafe { (*pat).fields };
                    while ((pf as usize) != 0) {
                        let mut idx: usize = 0;
                        let mut fd: *mut HirFieldDecl = unsafe { (*vd).struct_fields };
                        while ((fd as usize) != 0) {
                            if unsafe { (*fd).name.v == (*pf).name.v } { break; }
                            idx = idx + 1;
                            fd = unsafe { (*fd).next };
                        }
                        let vfc = unsafe { *usize_at((*t).variant_field_counts, 0) };
                        if idx < vfc {
                            let row = unsafe { *typeid_ptr_at((*t).variant_fields, 0) };
                            let fty_v = unsafe { (*typeid_at(row, idx)).v };
                            let pf_pat: *mut HirPat = unsafe { (*pf).pat };
                            if !is_pat_irrefutable(mut_view(*cx), pf_pat, (TypeId { v: fty_v })) { return false; }
                        }
                        pf = unsafe { (*pf).next };
                    }
                }
            }
            return true;
        }
        return false;
    }
    false
}

pub fn check_pat(cx: mut_view<TypeckCtx>, pat: *const HirPat, expected: TypeId, is_init: bool) -> TypeId {
    if (pat as usize) == 0 {
        let uv = unsafe { (*cx.thir).interner.t_unit.v };
        return (TypeId { v: uv });
    }
    let mut ty = (TypeId { v: expected.v });
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_BINDING {
        let sym_v = unsafe { (*pat).symbol.v };
        if sym_v != 0u32 {
            unsafe { thir_set_symbol_type(mut_view(*cx.thir), (SymbolId { v: sym_v }), (TypeId { v: ty.v })); }
            let is_m = unsafe { (*pat).is_mut };
            push_var_state(mut_view(*cx), (SymbolId { v: sym_v }), is_m, is_init);
        }
    } else if pk == HIR_PAT_LITERAL {
        let tk = unsafe { (*pat).tok.kind };
        let mut lit_ty = TypeId { v: unsafe { (*cx.thir).interner.t_error.v } };
        if tk == TOK_KW_TRUE || tk == TOK_KW_FALSE {
            lit_ty.v = unsafe { (*cx.thir).interner.t_bool.v };
        } else if tk == TOK_CHAR {
            lit_ty.v = unsafe { (*cx.thir).interner.t_char.v };
        } else if tk == TOK_INT {
            let it = unsafe { int_literal_type(mut_view(*cx), view((*pat).tok), view((*pat).span)) };
            lit_ty.v = it.v;
        } else {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) };
        }
        if !unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: lit_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
    } else if pk == HIR_PAT_WILDCARD {
        // nothing
    } else if pk == HIR_PAT_STRUCT {
        return check_pat_struct(mut_view(*cx), pat, (TypeId { v: ty.v }), is_init);
    } else {
        return check_pat_path_or_compound(mut_view(*cx), pat, (TypeId { v: ty.v }), is_init, pk);
    }
    unsafe { thir_set_pat_type(mut_view(*cx.thir), pat, (TypeId { v: ty.v })); }
    ty
}

fn check_pat_struct(cx: mut_view<TypeckCtx>, pat: *const HirPat, expected: TypeId, is_init: bool) -> TypeId {
    let mut ty = (TypeId { v: expected.v });
    if true {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let path_ty = unsafe { lookup_path_type(mut_view(*cx), view((*pat).path), mut_view(gargs)) };
        if gargs.count > 0 {
            unsafe { ptr_substmap_insert(mut_view((*cx.thir).pat_substs), pat as usize, gargs.args, gargs.count); }
        }
        if !unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: path_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        if is_error(mut_view(*cx), (TypeId { v: path_ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: path_ty.v })) };
        let tk = if (t as usize) != 0 { unsafe { (*t).kind } } else { TY_ERROR };
        if tk == TY_ENUM {
            let name = unsafe { tc_path_name_sv(view(*cx), view((*pat).path)) };
            let mut vname = StrView { ptr: name.ptr, len: name.len };
            let mut k: usize = 0;
            while (k < name.len) {
                if unsafe { *(name.ptr + k) } == 46u8 { // '.'
                    vname.ptr = unsafe { name.ptr + k + 1 };
                    vname.len = name.len - k - 1;
                }
                k = k + 1;
            }
            let mut found_variant = false;
            let mut vidx: usize = 0;
            let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
            let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
            while ((v as usize) != 0) {
                let vn_id = unsafe { (*v).name.v };
                let var_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: vn_id })) };
                if sv_eq(view(var_name), view(vname)) {
                    found_variant = true;
                    unsafe { ptr_usizemap_insert(mut_view((*cx.thir).pat_variants), pat as usize, vidx); }
                    if !unsafe { (*v).is_struct } {
                        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                    }
                    let row = unsafe { *typeid_ptr_at((*t).variant_fields, vidx) };
                    let mut pf: *mut HirPatField = unsafe { (*pat).fields };
                    while ((pf as usize) != 0) {
                        let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*pf).name.v })) };
                        let mut found = false;
                        let mut idx: usize = 0;
                        let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                        while ((f as usize) != 0) {
                            let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                            if sv_eq(view(fname), view(iname)) {
                                found = true;
                                let fty_v = unsafe { (*typeid_at(row, idx)).v };
                                let pf_pat: *mut HirPat = unsafe { (*pf).pat };
                                check_pat(mut_view(*cx), pf_pat, (TypeId { v: fty_v }), is_init);
                                break;
                            }
                            idx = idx + 1;
                            f = unsafe { (*f).next };
                        }
                        if !found {
                            unsafe { type_error(mut_view(*cx), view((*pf).span), AX_TYPE_UNKNOWN_FIELD); }
                        }
                        pf = unsafe { (*pf).next };
                    }
                    if !unsafe { (*pat).has_rest } {
                        let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                        while ((f as usize) != 0) {
                            let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                            let mut found = false;
                            let mut pf2: *mut HirPatField = unsafe { (*pat).fields };
                            while ((pf2 as usize) != 0) {
                                let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*pf2).name.v })) };
                                if sv_eq(view(fname), view(iname)) { found = true; break; }
                                pf2 = unsafe { (*pf2).next };
                            }
                            if !found {
                                unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISSING_FIELD); }
                            }
                            f = unsafe { (*f).next };
                        }
                    }
                    break;
                }
                vidx = vidx + 1;
                v = unsafe { (*v).next };
            }
            if !found_variant {
                return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
            }
            ty.v = path_ty.v;
        } else if tk == TY_STRUCT {
            let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
            let fptr = unsafe { (*t).fields };
            let mut pf: *mut HirPatField = unsafe { (*pat).fields };
            while ((pf as usize) != 0) {
                let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*pf).name.v })) };
                let mut found = false;
                let mut idx: usize = 0;
                let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
                while ((f as usize) != 0) {
                    let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                    if sv_eq(view(fname), view(iname)) {
                        found = true;
                        let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                        let pf_pat: *mut HirPat = unsafe { (*pf).pat };
                        check_pat(mut_view(*cx), pf_pat, (TypeId { v: fty_v }), is_init);
                        break;
                    }
                    idx = idx + 1;
                    f = unsafe { (*f).next };
                }
                if !found {
                    unsafe { type_error(mut_view(*cx), view((*pf).span), AX_TYPE_UNKNOWN_FIELD); }
                }
                pf = unsafe { (*pf).next };
            }
            if !unsafe { (*pat).has_rest } && (sdef as usize) != 0 {
                let mut f: *mut HirFieldDecl = unsafe { (*sdef).struct_fields };
                while ((f as usize) != 0) {
                    let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                    let mut found = false;
                    let mut pf2: *mut HirPatField = unsafe { (*pat).fields };
                    while ((pf2 as usize) != 0) {
                        let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*pf2).name.v })) };
                        if sv_eq(view(fname), view(iname)) { found = true; break; }
                        pf2 = unsafe { (*pf2).next };
                    }
                    if !found {
                        unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISSING_FIELD); }
                    }
                    f = unsafe { (*f).next };
                }
            }
            ty.v = path_ty.v;
        } else if tk != TY_ERROR {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        } else {
            ty.v = path_ty.v;
        }
    }
    unsafe { thir_set_pat_type(mut_view(*cx.thir), pat, (TypeId { v: ty.v })); }
    ty
}

fn check_pat_path_or_compound(cx: mut_view<TypeckCtx>, pat: *const HirPat, expected: TypeId, is_init: bool, pk: u8) -> TypeId {
    let mut ty = (TypeId { v: expected.v });
    if pk == HIR_PAT_PATH {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let path_ty = unsafe { lookup_path_type(mut_view(*cx), view((*pat).path), mut_view(gargs)) };
        if gargs.count > 0 {
            unsafe { ptr_substmap_insert(mut_view((*cx.thir).pat_substs), pat as usize, gargs.args, gargs.count); }
        }
        if is_error(mut_view(*cx), (TypeId { v: path_ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        if !unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: path_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: path_ty.v })) };
        if (t as usize) == 0 || unsafe { (*t).kind } != TY_ENUM {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let name = unsafe { tc_path_name_sv(view(*cx), view((*pat).path)) };
        let mut vname = StrView { ptr: name.ptr, len: name.len };
        let mut k: usize = 0;
        while (k < name.len) {
            if unsafe { *(name.ptr + k) } == 46u8 {
                vname.ptr = unsafe { name.ptr + k + 1 };
                vname.len = name.len - k - 1;
            }
            k = k + 1;
        }
        let mut found_variant = false;
        let mut vidx: usize = 0;
        let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
        let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
        while ((v as usize) != 0) {
            let var_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
            if sv_eq(view(var_name), view(vname)) {
                found_variant = true;
                unsafe { ptr_usizemap_insert(mut_view((*cx.thir).pat_variants), pat as usize, vidx); }
                if unsafe { (*v).is_struct } {
                    return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                }
                let vfc = unsafe { *usize_at((*t).variant_field_counts, vidx) };
                let payload_pat: *mut HirPat = unsafe { (*pat).payload };
                if (payload_pat as usize) != 0 {
                    if unsafe { (*payload_pat).kind } != HIR_PAT_TUPLE {
                        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                    }
                    let mut count: usize = 0;
                    let mut p: *mut HirPat = unsafe { (*payload_pat).elems };
                    while ((p as usize) != 0) {
                        count = count + 1;
                        p = unsafe { (*p).next };
                    }
                    if count != vfc {
                        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                    }
                    let row = unsafe { *typeid_ptr_at((*t).variant_fields, vidx) };
                    let mut i: usize = 0;
                    p = unsafe { (*payload_pat).elems };
                    while ((p as usize) != 0) {
                        let fty_v = unsafe { (*typeid_at(row, i)).v };
                        let r_fty = resolve_ty(mut_view(*cx), (TypeId { v: fty_v }));
                        check_pat(mut_view(*cx), p, (TypeId { v: r_fty.v }), is_init);
                        i = i + 1;
                        p = unsafe { (*p).next };
                    }
                } else {
                    if vfc > 0 {
                        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                    }
                }
                break;
            }
            vidx = vidx + 1;
            v = unsafe { (*v).next };
        }
        if !found_variant {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        ty.v = path_ty.v;
    } else if pk == HIR_PAT_TUPLE {
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        if ty.v == 0u32 {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_UNKNOWN) };
        }
        let rty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rty.v })) };
        if (t as usize) == 0 || unsafe { (*t).kind } != TY_TUPLE {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let mut count: usize = 0;
        let mut p: *mut HirPat = unsafe { (*pat).elems };
        while ((p as usize) != 0) {
            count = count + 1;
            p = unsafe { (*p).next };
        }
        if count != unsafe { (*t).field_count } {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        p = unsafe { (*pat).elems };
        while ((p as usize) != 0) {
            let fty_v = unsafe { (*typeid_at(fptr, i)).v };
            check_pat(mut_view(*cx), p, (TypeId { v: fty_v }), is_init);
            i = i + 1;
            p = unsafe { (*p).next };
        }
    } else if pk == HIR_PAT_RANGE {
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        if ty.v == 0u32 {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_UNKNOWN) };
        }
        let rty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        let k = kind_of(mut_view(*cx), (TypeId { v: rty.v }));
        if k != TY_I8 && k != TY_I16 && k != TY_I32 && k != TY_I64 &&
           k != TY_U8 && k != TY_U16 && k != TY_U32 && k != TY_U64 &&
           k != TY_CHAR && k != TY_INT_VAR {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let sp_start: *mut HirPat = unsafe { (*pat).start_pat };
        let sp_end: *mut HirPat = unsafe { (*pat).end_pat };
        check_pat(mut_view(*cx), sp_start, (TypeId { v: ty.v }), is_init);
        check_pat(mut_view(*cx), sp_end, (TypeId { v: ty.v }), is_init);
    } else if pk == HIR_PAT_OR {
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        let mut p: *mut HirPat = unsafe { (*pat).pats };
        while ((p as usize) != 0) {
            check_pat(mut_view(*cx), p, (TypeId { v: ty.v }), is_init);
            p = unsafe { (*p).next };
        }
    } else {
        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) };
    }
    unsafe { thir_set_pat_type(mut_view(*cx.thir), pat, (TypeId { v: ty.v })); }
    ty
}

unsafe fn tc_pat_interval_at(base: *const PatInterval, idx: usize) -> *const PatInterval {
    ((base as usize) + mul_usize(idx, size_of<PatInterval>())) as *const PatInterval
}

unsafe fn tc_pat_interval_at_mut(base: *mut PatInterval, idx: usize) -> *mut PatInterval {
    ((base as usize) + mul_usize(idx, size_of<PatInterval>())) as *mut PatInterval
}

fn tc_exhaust_bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    if (a as usize) == (b as usize) {
        return true;
    }
    if (a as usize) == 0 || (b as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while (i < n) {
        let ba = unsafe { *(a + i) };
        let bb = unsafe { *(b + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn tc_is_int_or_char_kind(tk: u8) -> bool {
    tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE ||
    tk == TY_U8 || tk == TY_U16 || tk == TY_U32 || tk == TY_U64 || tk == TY_USIZE ||
    tk == TY_CHAR
}

fn tc_match_check_exhaustiveness(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    expr: *const HirExpr,
    val_ty: TypeId
) {
    if false {
        match_check_exhaustiveness(mut_view(*thir), str_in, db, mut_view(*sink), expr, (TypeId { v: val_ty.v }));
    }
    if (expr as usize) == 0 {
        return;
    }
    if (unsafe { (*expr).kind }) != HIR_EXPR_MATCH {
        return;
    }

    let expr_file_v = unsafe { (*expr).span.file.v };
    let expr_start = unsafe { (*expr).span.start };
    let expr_end = unsafe { (*expr).span.end };

    let mut has_unconditional_wildcard = false;
    let mut arm = unsafe { (*expr).arms as *const HirMatchArm };
    while ((arm as usize) != 0) {
        let has_guard = (unsafe { (*arm).guard as usize }) != 0;
        let ap = unsafe { (*arm).pat as *const HirPat };
        if !has_guard && (ap as usize) != 0 {
            let pk = unsafe { (*ap).kind };
            if pk == HIR_PAT_WILDCARD || pk == HIR_PAT_BINDING {
                has_unconditional_wildcard = true;
                let mut unreach = unsafe { (*arm).next as *const HirMatchArm };
                while ((unreach as usize) != 0) {
                    let up = unsafe { (*unreach).pat as *const HirPat };
                    if (up as usize) != 0 {
                        let u_fv = unsafe { (*up).span.file.v };
                        let u_st = unsafe { (*up).span.start };
                        let u_en = unsafe { (*up).span.end };
                        report_typeck_diag(mut_view(*sink), AX_PAT_UNREACHABLE, u_fv, u_st, u_en);
                    }
                    unreach = unsafe { (*unreach).next as *const HirMatchArm };
                }
                break;
            }
        }
        arm = unsafe { (*arm).next as *const HirMatchArm };
    }

    let val_ty_v = val_ty.v;
    let t = type_get(view(thir.interner), (TypeId { v: val_ty_v }));
    if (t as usize) == 0 {
        return;
    }
    let tk = unsafe { (*t).kind };

    if tc_is_int_or_char_kind(tk) {
        let cov_bytes = mul_usize(256, size_of<PatInterval>());
        let cov_raw = arena_alloc_raw(mut_view(thir.interner.arena), cov_bytes, align_of<PatInterval>());
        let covered = cov_raw as *mut PatInterval;
        let mut cov_count: usize = 0;

        let mut iarm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((iarm as usize) != 0) {
            let ap = unsafe { (*iarm).pat as *const HirPat };
            let has_guard = (unsafe { (*iarm).guard as usize }) != 0;
            if (ap as usize) != 0 {
                let mut iv = PatInterval { start: 0i64, end: 0i64 };
                let got_iv = get_pat_interval(ap, mut_view(iv));
                if got_iv {
                    let mut is_cov = false;
                    let mut i: usize = 0;
                    while (i < cov_count) {
                        let ci = unsafe { tc_pat_interval_at(covered as *const PatInterval, i) };
                        if iv.start >= (unsafe { (*ci).start }) && iv.end <= (unsafe { (*ci).end }) {
                            is_cov = true;
                            break;
                        }
                        i = i + 1;
                    }
                    if is_cov {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        report_typeck_diag(mut_view(*sink), AX_PAT_UNREACHABLE, a_fv, a_st, a_en);
                    } else if !has_guard && cov_count < 256 {
                        let dst = unsafe { tc_pat_interval_at_mut(covered, cov_count) };
                        unsafe {
                            (*dst).start = iv.start;
                            (*dst).end = iv.end;
                        }
                        cov_count = cov_count + 1;
                    }
                } else if (unsafe { (*ap).kind }) == HIR_PAT_OR {
                    let mut p = unsafe { (*ap).pats as *const HirPat };
                    while ((p as usize) != 0) {
                        let got_piv = get_pat_interval(p, mut_view(iv));
                        if got_piv {
                            let mut is_cov = false;
                            let mut i: usize = 0;
                            while (i < cov_count) {
                                let ci = unsafe { tc_pat_interval_at(covered as *const PatInterval, i) };
                                if iv.start >= (unsafe { (*ci).start }) && iv.end <= (unsafe { (*ci).end }) {
                                    is_cov = true;
                                    break;
                                }
                                i = i + 1;
                            }
                            if is_cov {
                                let p_fv = unsafe { (*p).span.file.v };
                                let p_st = unsafe { (*p).span.start };
                                let p_en = unsafe { (*p).span.end };
                                report_typeck_diag(mut_view(*sink), AX_PAT_UNREACHABLE, p_fv, p_st, p_en);
                            } else if !has_guard && cov_count < 256 {
                                let dst = unsafe { tc_pat_interval_at_mut(covered, cov_count) };
                                unsafe {
                                    (*dst).start = iv.start;
                                    (*dst).end = iv.end;
                                }
                                cov_count = cov_count + 1;
                            }
                        }
                        p = unsafe { (*p).next as *const HirPat };
                    }
                }
            }
            iarm = unsafe { (*iarm).next as *const HirMatchArm };
        }

        if has_unconditional_wildcard {
            return;
        }
        if tk == TY_U8 {
            let mut all_u8 = true;
            let mut v: i64 = 0i64;
            while (v <= 255i64) {
                let mut found = false;
                let mut i: usize = 0;
                while (i < cov_count) {
                    let ci = unsafe { tc_pat_interval_at(covered as *const PatInterval, i) };
                    if v >= (unsafe { (*ci).start }) && v <= (unsafe { (*ci).end }) {
                        found = true;
                        break;
                    }
                    i = i + 1;
                }
                if !found {
                    all_u8 = false;
                    break;
                }
                v = v + 1i64;
            }
            if all_u8 {
                return;
            }
        }

        report_typeck_diag(mut_view(*sink), AX_PAT_NON_EXHAUSTIVE, expr_file_v, expr_start, expr_end);
        return;
    }

    tc_match_check_exhaust_bool_or_enum(
        mut_view(*thir),
        str_in,
        db,
        mut_view(*sink),
        expr,
        t,
        tk,
        has_unconditional_wildcard,
        expr_file_v,
        expr_start,
        expr_end
    );
}

fn tc_match_check_exhaust_bool_or_enum(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    expr: *const HirExpr,
    t: *mut AxType,
    tk: u8,
    has_unconditional_wildcard: bool,
    expr_file_v: u32,
    expr_start: u32,
    expr_end: u32
) {
    if tk == TY_BOOL {
        let mut has_true = false;
        let mut has_false = false;
        let mut barm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((barm as usize) != 0) {
            let ap = unsafe { (*barm).pat as *const HirPat };
            let has_guard = (unsafe { (*barm).guard as usize }) != 0;
            if (ap as usize) != 0 && (unsafe { (*ap).kind }) == HIR_PAT_LITERAL {
                let tok_k = unsafe { (*ap).tok.kind };
                if tok_k == TOK_KW_TRUE {
                    if has_true {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        report_typeck_diag(mut_view(*sink), AX_PAT_UNREACHABLE, a_fv, a_st, a_en);
                    } else if !has_guard {
                        has_true = true;
                    }
                } else if tok_k == TOK_KW_FALSE {
                    if has_false {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        report_typeck_diag(mut_view(*sink), AX_PAT_UNREACHABLE, a_fv, a_st, a_en);
                    } else if !has_guard {
                        has_false = true;
                    }
                }
            }
            barm = unsafe { (*barm).next as *const HirMatchArm };
        }
        if has_unconditional_wildcard || (has_true && has_false) {
            return;
        }
        report_typeck_diag(mut_view(*sink), AX_PAT_NON_EXHAUSTIVE, expr_file_v, expr_start, expr_end);
        return;
    }

    if tk == TY_ENUM {
        let def = unsafe { (*t).def as *const HirItem };
        let count = unsafe { (*t).variant_count };
        let alloc_cnt = if count > 0 { count } else { 1 };
        let seen = arena_alloc_raw(mut_view(thir.interner.arena), alloc_cnt, 1);
        let mut z: usize = 0;
        while (z < count) {
            unsafe { *(seen + z) = 0u8; }
            z = z + 1;
        }

        let mut earm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((earm as usize) != 0) {
            let ap = unsafe { (*earm).pat as *const HirPat };
            let has_guard = (unsafe { (*earm).guard as usize }) != 0;
            if (ap as usize) != 0 && (def as usize) != 0 {
                let apk = unsafe { (*ap).kind };
                if apk == HIR_PAT_PATH || apk == HIR_PAT_STRUCT {
                    let p_file_v = unsafe { (*ap).path.span.file.v };
                    let p_start = unsafe { (*ap).path.span.start };
                    let p_end = unsafe { (*ap).path.span.end };
                    let p_name_v = unsafe { (*ap).path.name.v };

                    let mut ptext_ptr: *const u8 = 0 as *const u8;
                    let mut ptext_len: usize = 0;
                    if p_file_v != 0u32 && (db.files as usize) != 0 {
                        let ftext = source_db_text(db, (FileId { v: p_file_v }));
                        if (ftext.ptr as usize) != 0 && p_start <= p_end && (p_end as usize) <= ftext.len {
                            ptext_ptr = ((ftext.ptr as usize) + (p_start as usize)) as *const u8;
                            ptext_len = (p_end - p_start) as usize;
                        }
                    }

                    let mut vname_ptr: *const u8 = ptext_ptr;
                    let mut vname_len: usize = ptext_len;
                    let mut ename_ptr: *const u8 = 0 as *const u8;
                    let mut ename_len: usize = 0;

                    let mut bi: usize = 0;
                    while (bi < ptext_len) {
                        if (unsafe { *(ptext_ptr + bi) }) == 46u8 {
                            ename_ptr = ptext_ptr;
                            ename_len = bi;
                            vname_ptr = unsafe { ptext_ptr + (bi + 1) };
                            vname_len = ptext_len - bi - 1;
                        }
                        bi = bi + 1;
                    }

                    if vname_len == 0 && p_name_v != 0u32 {
                        let nv = interner_get(str_in, (StrId { v: p_name_v }));
                        vname_ptr = nv.ptr;
                        vname_len = nv.len;
                    }

                    let def_name_v = unsafe { (*def).name.v };
                    let mut v = unsafe { (*def).variants as *const HirVariantDecl };
                    let mut vidx: usize = 0;
                    while ((v as usize) != 0 && vidx < count) {
                        let v_name_v = unsafe { (*v).name.v };
                        let var_name = interner_get(str_in, (StrId { v: v_name_v }));
                        let mut enum_matches = true;
                        if ename_len > 0 && def_name_v != 0u32 {
                            let def_name = interner_get(str_in, (StrId { v: def_name_v }));
                            if def_name.len != ename_len || !tc_exhaust_bytes_eq(def_name.ptr, ename_ptr, ename_len) {
                                enum_matches = false;
                            }
                        }
                        if enum_matches && var_name.len == vname_len && tc_exhaust_bytes_eq(var_name.ptr, vname_ptr, vname_len) {
                            if (unsafe { *(seen + vidx) }) != 0u8 {
                                let a_fv = unsafe { (*ap).span.file.v };
                                let a_st = unsafe { (*ap).span.start };
                                let a_en = unsafe { (*ap).span.end };
                                report_typeck_diag(mut_view(*sink), AX_PAT_UNREACHABLE, a_fv, a_st, a_en);
                            } else if !has_guard {
                                unsafe { *(seen + vidx) = 1u8; }
                            }
                            break;
                        }
                        v = unsafe { (*v).next as *const HirVariantDecl };
                        vidx = vidx + 1;
                    }
                }
            }
            earm = unsafe { (*earm).next as *const HirMatchArm };
        }

        if has_unconditional_wildcard {
            return;
        }
        let mut all_seen = true;
        let mut si: usize = 0;
        while (si < count) {
            if (unsafe { *(seen + si) }) == 0u8 {
                all_seen = false;
                break;
            }
            si = si + 1;
        }
        if !all_seen {
            report_typeck_diag(mut_view(*sink), AX_PAT_NON_EXHAUSTIVE, expr_file_v, expr_start, expr_end);
        }
        return;
    }

    if has_unconditional_wildcard {
        return;
    }
    report_typeck_diag(mut_view(*sink), AX_PAT_NON_EXHAUSTIVE, expr_file_v, expr_start, expr_end);
}

fn check_literal(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    let tk = unsafe { (*expr).literal.kind };
    unsafe {
        if tk == TOK_KW_TRUE || tk == TOK_KW_FALSE {
            return (TypeId { v: (*cx.thir).interner.t_bool.v });
        }
        if tk == TOK_CHAR {
            return (TypeId { v: (*cx.thir).interner.t_char.v });
        }
        if tk == TOK_INT {
            return int_literal_type(mut_view(*cx), view((*expr).literal), view((*expr).span));
        }
        if tk == TOK_FLOAT {
            return type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP);
        }
        if tk == TOK_STR || tk == TOK_BYTE_STR {
            return (TypeId { v: (*cx.thir).interner.t_str.v });
        }
        (TypeId { v: (*cx.thir).interner.t_error.v })
    }
}

fn binop_method_idx(op: u8) -> usize {
    if op == BINOP_ADD { return 16; }
    if op == BINOP_SUB { return 17; }
    if op == BINOP_MUL { return 18; }
    if op == BINOP_DIV { return 19; }
    if op == BINOP_REM { return 20; }
    if op == BINOP_BITAND { return 21; }
    if op == BINOP_BITOR { return 22; }
    if op == BINOP_BITXOR { return 23; }
    if op == BINOP_SHL { return 24; }
    if op == BINOP_SHR { return 25; }
    if op == BINOP_EQ || op == BINOP_NE { return 26; }
    if op == BINOP_LT || op == BINOP_LE || op == BINOP_GT || op == BINOP_GE { return 27; }
    0
}

fn check_binary(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    let op = unsafe { (*expr).op };
    let lptr: *mut HirExpr = unsafe { (*expr).left };
    let rptr: *mut HirExpr = unsafe { (*expr).right };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let isize_v = unsafe { (*cx.thir).interner.t_isize.v };

    if op == BINOP_LOGAND || op == BINOP_LOGOR {
        check_expr(mut_view(*cx), lptr, (TypeId { v: bool_v }));
        check_expr(mut_view(*cx), rptr, (TypeId { v: bool_v }));
        return (TypeId { v: bool_v });
    }

    if op == BINOP_SHL || op == BINOP_SHR {
        let left_ty = check_expr(mut_view(*cx), lptr, (TypeId { v: 0u32 }));
        let right_ty = check_expr(mut_view(*cx), rptr, (TypeId { v: 0u32 }));
        if !is_error(mut_view(*cx), (TypeId { v: left_ty.v })) && !is_intlike(mut_view(*cx), (TypeId { v: left_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*lptr).span), AX_TYPE_OPERATOR) };
        }
        if !is_error(mut_view(*cx), (TypeId { v: right_ty.v })) && !is_intlike(mut_view(*cx), (TypeId { v: right_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*rptr).span), AX_TYPE_OPERATOR) };
        }
        return (TypeId { v: left_ty.v });
    }

    let left_ty = check_expr(mut_view(*cx), lptr, (TypeId { v: 0u32 }));
    if (op == BINOP_ADD || op == BINOP_SUB) && kind_of(mut_view(*cx), (TypeId { v: left_ty.v })) == TY_PTR {
        let right_ty = check_expr(mut_view(*cx), rptr, (TypeId { v: 0u32 }));
        if is_error(mut_view(*cx), (TypeId { v: right_ty.v })) { return (TypeId { v: err_v }); }
        if op == BINOP_SUB && kind_of(mut_view(*cx), (TypeId { v: right_ty.v })) == TY_PTR {
            return (TypeId { v: isize_v });
        }
        if is_intlike(mut_view(*cx), (TypeId { v: right_ty.v })) {
            return (TypeId { v: left_ty.v });
        }
        return unsafe { type_error(mut_view(*cx), view((*rptr).span), AX_TYPE_OPERATOR) };
    }

    let right_ty = check_expr(mut_view(*cx), rptr, (TypeId { v: left_ty.v }));
    let opnd = TypeId { v: if is_never(mut_view(*cx), (TypeId { v: left_ty.v })) { right_ty.v } else { left_ty.v } };
    let is_cmp = op >= BINOP_EQ && op <= BINOP_GE;
    if is_error(mut_view(*cx), (TypeId { v: opnd.v })) || is_never(mut_view(*cx), (TypeId { v: opnd.v })) {
        return if is_cmp { (TypeId { v: bool_v }) } else { (TypeId { v: opnd.v }) };
    }

    let k = kind_of(mut_view(*cx), (TypeId { v: opnd.v }));
    let mut ok = false;
    if is_cmp {
        ok = is_intlike(mut_view(*cx), (TypeId { v: opnd.v })) || k == TY_BOOL || k == TY_CHAR || k == TY_PTR;
    } else if op == BINOP_BITAND || op == BINOP_BITOR || op == BINOP_BITXOR {
        ok = is_intlike(mut_view(*cx), (TypeId { v: opnd.v })) || k == TY_BOOL;
    } else {
        ok = is_intlike(mut_view(*cx), (TypeId { v: opnd.v }));
    }

    if !ok {
        let m_idx = binop_method_idx(op);
        if m_idx > 0 && (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
            let m_sv = unsafe { tc_alloc_sv(mut_view((*cx.thir).interner.arena), m_idx) };
            let mut trait_res: u8 = TRAIT_DISPROVEN;
            let method_item = unsafe {
                find_method(view(*cx.hir), view(*cx.thir), (TypeId { v: left_ty.v }), view(m_sv), view(*cx.str_in), view(*cx.db), mut_view(trait_res))
            };
            if (method_item as usize) != 0 {
                unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, method_item); }
                let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), method_item) };
                if fn_ty_id.v != 0u32 {
                    let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
                    if (fn_ty as usize) != 0 {
                        let ret_v = unsafe { (*fn_ty).ret_type.v };
                        return if is_cmp { (TypeId { v: bool_v }) } else { (TypeId { v: ret_v }) };
                    }
                }
            }
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }

    if is_cmp { return (TypeId { v: bool_v }); }
    opnd
}

fn check_unary(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    let operand: *mut HirExpr = unsafe { (*expr).inner };
    let op = unsafe { (*expr).op };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };

    if op == UNOP_NOT {
        check_expr(mut_view(*cx), operand, (TypeId { v: bool_v }));
        return (TypeId { v: bool_v });
    }
    if op == UNOP_NEG {
        if (operand as usize) != 0 && unsafe { (*operand).kind } == HIR_EXPR_LITERAL && unsafe { (*operand).literal.kind } == TOK_INT {
            let before = cx.lits_len;
            let ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
            if cx.lits_len == before + 1 {
                let lc = unsafe { litcheck_at(cx.lits, before) };
                unsafe {
                    (*lc).negated = true;
                    (*lc).neg_span.file.v = (*expr).span.file.v;
                    (*lc).neg_span.start = (*expr).span.start;
                    (*lc).neg_span.end = (*expr).span.end;
                }
            }
            return (TypeId { v: ty.v });
        }
        let ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
        let r = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        let k = kind_of(mut_view(*cx), (TypeId { v: r.v }));
        if k == TY_ERROR || k == TY_NEVER { return (TypeId { v: r.v }); }
        if k == TY_INT_VAR {
            unsafe { push_neg_check(mut_view(*cx), view((*expr).span), (TypeId { v: r.v })); }
            return (TypeId { v: r.v });
        }
        let is_sig = unsafe { type_is_signed((TypeId { v: r.v }), view((*cx.thir).interner)) };
        if is_sig { return (TypeId { v: r.v }); }
        let is_uns = unsafe { type_is_unsigned((TypeId { v: r.v }), view((*cx.thir).interner)) };
        if is_uns {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_NEG_UNSIGNED) };
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }
    if op == UNOP_BITNOT {
        let ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) || is_never(mut_view(*cx), (TypeId { v: ty.v })) || is_intlike(mut_view(*cx), (TypeId { v: ty.v })) {
            return resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }
    if op == UNOP_DEREF {
        let op_ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
        if !is_error(mut_view(*cx), (TypeId { v: op_ty.v })) {
            let r_op = resolve_ty(mut_view(*cx), (TypeId { v: op_ty.v }));
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_op.v })) };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW {
                    let pt_v = unsafe { (*t).pointee.v };
                    return (TypeId { v: pt_v });
                }
            }
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) };
    }
    unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) }
}

fn count_expr_list(head: *const HirExpr) -> usize {
    let mut c: usize = 0;
    let mut cur = head;
    while ((cur as usize) != 0) {
        c = c + 1;
        cur = unsafe { (*cur).next };
    }
    c
}

fn check_call(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    let callee: *mut HirExpr = unsafe { (*expr).callee };
    let args_head: *mut HirExpr = unsafe { (*expr).args };
    let mut callee_ty = (TypeId { v: 0u32 });
    if (callee as usize) != 0 && unsafe { (*callee).kind } == HIR_EXPR_PATH {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let raw_cty = unsafe { lookup_path_type(mut_view(*cx), view((*callee).path), mut_view(gargs)) };
        let r_cty = resolve_ty(mut_view(*cx), (TypeId { v: raw_cty.v }));
        callee_ty.v = r_cty.v;
        unsafe { thir_set_expr_type(mut_view(*cx.thir), callee, (TypeId { v: callee_ty.v })); }
        register_intrinsic_callee(mut_view(*cx), callee);
        if gargs.count > 0 {
            unsafe { ptr_substmap_insert(mut_view((*cx.thir).expr_substs), callee as usize, gargs.args, gargs.count); }
        }
    } else {
        let raw_cty = check_expr(mut_view(*cx), callee, (TypeId { v: 0u32 }));
        let r_cty = resolve_ty(mut_view(*cx), (TypeId { v: raw_cty.v }));
        callee_ty.v = r_cty.v;
    }

    let ct = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: callee_ty.v })) };
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    let str_v = unsafe { (*cx.thir).interner.t_str.v };
    if (ct as usize) == 0 { return (TypeId { v: err_v }); }
    let ck = unsafe { (*ct).kind };
    let argc = count_expr_list(args_head);

    if ck == TY_BUILTIN_LEN {
        if argc != 1 {
            return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) };
        }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if !is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) {
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty.v })) };
            let tk = if (t as usize) != 0 { unsafe { (*t).kind } } else { TY_ERROR };
            let mut is_slice_view = false;
            if tk == TY_VIEW || tk == TY_MUT_VIEW {
                let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: (*t).pointee.v })) };
                if (pt as usize) != 0 && unsafe { (*pt).kind } == TY_SLICE {
                    is_slice_view = true;
                }
            }
            if tk != TY_ARRAY && tk != TY_STR && !is_slice_view {
                return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
            }
        }
        return (TypeId { v: usize_v });
    }
    if ck == TY_BUILTIN_PRINT {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if !is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) && arg_ty.v != str_v {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
        }
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_PRINT_INT {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if !is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) {
            let is_i = unsafe { type_is_int((TypeId { v: arg_ty.v }), view((*cx.thir).interner)) };
            if !is_i {
                return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
            }
        }
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_DROP {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_ADDRESS_OF || ck == TY_BUILTIN_ADDRESS_OF_MUT {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) { return (TypeId { v: err_v }); }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: arg_ty.v }));
        }
        return unsafe { intern_ptr_ty(mut_view((*cx.thir).interner), (TypeId { v: arg_ty.v }), ck == TY_BUILTIN_ADDRESS_OF_MUT) };
    }
    if ck == TY_BUILTIN_IS_NULL {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) { return (TypeId { v: err_v }); }
        let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty.v })) };
        if (at as usize) == 0 || unsafe { (*at).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*at).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: bool_v });
    }
    if ck == TY_BUILTIN_PTR_ADD || ck == TY_BUILTIN_PTR_SUB {
        if argc != 2 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let a1: *mut HirExpr = unsafe { (*args_head).next };
        let raw_a0 = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg0_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_a0.v }));
        let raw_a1 = check_expr(mut_view(*cx), a1, (TypeId { v: usize_v }));
        let arg1_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_a1.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg0_ty.v })) || is_error(mut_view(*cx), (TypeId { v: arg1_ty.v })) { return (TypeId { v: err_v }); }
        let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg0_ty.v })) };
        if (at as usize) == 0 || unsafe { (*at).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*at).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: arg0_ty.v });
    }
    if ck == TY_BUILTIN_SIZE_OF || ck == TY_BUILTIN_ALIGN_OF {
        if argc != 0 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        return (TypeId { v: usize_v });
    }
    if ck == TY_BUILTIN_NEEDS_DROP {
        if argc != 0 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        return (TypeId { v: bool_v });
    }
    if ck == TY_BUILTIN_NULL || ck == TY_BUILTIN_NULL_MUT {
        if argc != 0 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        let mut pointee = (TypeId { v: u8_v });
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let r_s0 = resolve_ty(mut_view(*cx), (TypeId { v: s0_v }));
            pointee.v = r_s0.v;
        }
        return unsafe { intern_ptr_ty(mut_view((*cx.thir).interner), (TypeId { v: pointee.v }), ck == TY_BUILTIN_NULL_MUT) };
    }
    if ck == TY_BUILTIN_DROP_IN_PLACE {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) { return (TypeId { v: err_v }); }
        let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty.v })) };
        if (at as usize) == 0 || unsafe { (*at).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*at).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: unit_v });
    }
    check_call_rest(mut_view(*cx), expr, callee, args_head, ct, ck, argc)
}

fn check_call_rest(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    callee: *mut HirExpr,
    args_head: *mut HirExpr,
    ct: *mut AxType,
    ck: u8,
    argc: usize
) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    if ck == TY_BUILTIN_FORGET {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: arg_ty.v }));
        }
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_PTR_COPY || ck == TY_BUILTIN_PTR_COPY_NONOVERLAPPING {
        if argc != 3 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let a0 = args_head;
        let a1: *mut HirExpr = unsafe { (*a0).next };
        let a2: *mut HirExpr = unsafe { (*a1).next };
        let raw_t0 = check_expr(mut_view(*cx), a0, (TypeId { v: 0u32 }));
        let ty0 = resolve_ty(mut_view(*cx), (TypeId { v: raw_t0.v }));
        let raw_t1 = check_expr(mut_view(*cx), a1, (TypeId { v: 0u32 }));
        let ty1 = resolve_ty(mut_view(*cx), (TypeId { v: raw_t1.v }));
        check_expr(mut_view(*cx), a2, (TypeId { v: usize_v }));
        if is_error(mut_view(*cx), (TypeId { v: ty0.v })) || is_error(mut_view(*cx), (TypeId { v: ty1.v })) { return (TypeId { v: err_v }); }
        let t0 = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty0.v })) };
        let t1 = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty1.v })) };
        if (t0 as usize) == 0 || unsafe { (*t0).kind } != TY_PTR || (t1 as usize) == 0 || unsafe { (*t1).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*t0).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_PTR_WRITE_BYTES {
        if argc != 3 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let a0 = args_head;
        let a1: *mut HirExpr = unsafe { (*a0).next };
        let a2: *mut HirExpr = unsafe { (*a1).next };
        let raw_t0 = check_expr(mut_view(*cx), a0, (TypeId { v: 0u32 }));
        let ty0 = resolve_ty(mut_view(*cx), (TypeId { v: raw_t0.v }));
        check_expr(mut_view(*cx), a1, (TypeId { v: u8_v }));
        check_expr(mut_view(*cx), a2, (TypeId { v: usize_v }));
        if is_error(mut_view(*cx), (TypeId { v: ty0.v })) { return (TypeId { v: err_v }); }
        let t0 = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty0.v })) };
        if (t0 as usize) == 0 || unsafe { (*t0).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*t0).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: unit_v });
    }

    if ck == TY_CLOSURE {
        let pcount = unsafe { (*ct).param_count };
        if argc != pcount {
            let mut a = args_head;
            while ((a as usize) != 0) {
                check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
                a = unsafe { (*a).next };
            }
            return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) };
        }
        let ret_v = unsafe { (*ct).ret_type.v };
        let params = unsafe { (*ct).param_types };
        let mut i: usize = 0;
        let mut a = args_head;
        while ((a as usize) != 0) {
            let pv = unsafe { (*typeid_at(params, i)).v };
            check_expr(mut_view(*cx), a, (TypeId { v: pv }));
            i = i + 1;
            a = unsafe { (*a).next };
        }
        return if ret_v == 0u32 { (TypeId { v: unit_v }) } else { (TypeId { v: ret_v }) };
    }

    if ck == TY_PARAM {
        let mut is_callable_param = false;
        let p_idx = unsafe { (*ct).param_index as usize };
        let p_name_v = unsafe { (*ct).name.v };
        if (cx.current_fn as usize) != 0 && (cx.str_in as usize) != 0 {
            let gps: *mut HirGenericParams = unsafe { (*cx.current_fn).generic_params };
            if (gps as usize) != 0 {
                let mut idx: usize = 0;
                let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
                while ((gp as usize) != 0) {
                    let gname_v = unsafe { (*gp).name.v };
                    if idx == p_idx || (gname_v != 0u32 && gname_v == p_name_v) {
                        let mut b: *mut HirType = unsafe { (*gp).bounds };
                        while ((b as usize) != 0) {
                            let bname = unsafe { tc_path_name_sv(view(*cx), view((*b).path)) };
                            if tc_sv_is_2(view(bname), 70u8, 110u8) ||
                               tc_sv_is_5(view(bname), 70u8, 110u8, 77u8, 117u8, 116u8) ||
                               tc_sv_is_6(view(bname), 70u8, 110u8, 79u8, 110u8, 99u8, 101u8) ||
                               tc_sv_is_8(view(bname), 67u8, 97u8, 108u8, 108u8, 97u8, 98u8, 108u8, 101u8) {
                                is_callable_param = true;
                                break;
                            }
                            b = unsafe { (*b).next };
                        }
                        break;
                    }
                    idx = idx + 1;
                    gp = unsafe { (*gp).next };
                }
            }
        }
        let mut a = args_head;
        while ((a as usize) != 0) {
            check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
            a = unsafe { (*a).next };
        }
        if is_callable_param {
            let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
            return if cx.return_type.v != 0u32 { (TypeId { v: cx.return_type.v }) } else { (TypeId { v: i32_v }) };
        }
        return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_NOT_CALLABLE) };
    }

    if ck != TY_FN {
        let mut a = args_head;
        while ((a as usize) != 0) {
            check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
            a = unsafe { (*a).next };
        }
        if ck == TY_ERROR { return (TypeId { v: err_v }); }
        return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_NOT_CALLABLE) };
    }

    let pcount = unsafe { (*ct).param_count };
    if argc != pcount {
        let mut a = args_head;
        while ((a as usize) != 0) {
            check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
            a = unsafe { (*a).next };
        }
        return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) };
    }

    let ret_v = unsafe { (*ct).ret_type.v };
    let params = unsafe { (*ct).param_types };
    let mut i: usize = 0;
    let mut a = args_head;
    while ((a as usize) != 0) {
        let pv = unsafe { (*typeid_at(params, i)).v };
        check_expr(mut_view(*cx), a, (TypeId { v: pv }));
        i = i + 1;
        a = unsafe { (*a).next };
    }
    if ret_v == 0u32 { (TypeId { v: unit_v }) } else { (TypeId { v: ret_v }) }
}

fn check_if(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let lpat: *mut HirPat = unsafe { (*expr).let_pat };
    if (lpat as usize) != 0 {
        desugar_if_let(mut_view(*cx), expr as *mut HirExpr);
        return check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let cond_e: *mut HirExpr = unsafe { (*expr).cond };
    check_expr(mut_view(*cx), cond_e, (TypeId { v: bool_v }));

    let tblk: *mut HirBlock = unsafe { (*expr).block };
    let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
    if (else_e as usize) == 0 {
        check_block(mut_view(*cx), tblk, (TypeId { v: unit_v }));
        return (TypeId { v: unit_v });
    }
    let then_ty = check_block(mut_view(*cx), tblk, (TypeId { v: expected.v }));
    let exp_else = if expected.v != 0u32 { (TypeId { v: expected.v }) } else { (TypeId { v: then_ty.v }) };
    let else_ty = check_expr(mut_view(*cx), else_e, (TypeId { v: exp_else.v }));
    if is_never(mut_view(*cx), (TypeId { v: then_ty.v })) { return (TypeId { v: else_ty.v }); }
    if is_error(mut_view(*cx), (TypeId { v: else_ty.v })) { return (TypeId { v: else_ty.v }); }
    resolve_ty(mut_view(*cx), (TypeId { v: then_ty.v }))
}

fn record_cap(caps: *mut RawCapture, cap_count: mut_view<usize>, sym: SymbolId, is_mut: bool, is_move: bool) {
    let mut i: usize = 0;
    while (i < *cap_count) {
        let rc = unsafe { rawcap_at(caps, i) };
        if unsafe { (*rc).sym.v } == sym.v {
            unsafe {
                if is_move { (*rc).is_moved = true; }
                else if is_mut { (*rc).is_mutated = true; }
                else { (*rc).is_read = true; }
            }
            return;
        }
        i = i + 1;
    }
    if *cap_count < 64 {
        let rc = unsafe { rawcap_at(caps, *cap_count) };
        unsafe {
            (*rc).sym.v = sym.v;
            (*rc).is_mutated = is_mut;
            (*rc).is_moved = is_move;
            (*rc).is_read = !is_mut && !is_move;
        }
        *cap_count = *cap_count + 1;
    }
}

fn is_inner_sym(sym: SymbolId, inner: *const SymbolId, inner_count: usize) -> bool {
    let mut i: usize = 0;
    while (i < inner_count) {
        let s = unsafe { symid_at(inner as *mut SymbolId, i) };
        if unsafe { (*s).v } == sym.v { return true; }
        i = i + 1;
    }
    false
}

fn is_outer_var(cx: view<TypeckCtx>, sym: SymbolId) -> bool {
    let mut i: usize = 0;
    while (i < cx.vars_len) {
        let vs = unsafe { varstate_at(cx.vars, i) };
        if unsafe { (*vs).sym.v } == sym.v { return true; }
        i = i + 1;
    }
    false
}

fn add_pat_syms(pat: *const HirPat, inner: *mut SymbolId, inner_count: mut_view<usize>) {
    if (pat as usize) == 0 { return; }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_BINDING {
        if *inner_count < 128 {
            let dst = unsafe { symid_at(inner, *inner_count) };
            unsafe { (*dst).v = (*pat).symbol.v; }
            *inner_count = *inner_count + 1;
        }
    } else if pk == HIR_PAT_TUPLE {
        let mut p: *mut HirPat = unsafe { (*pat).elems };
        while ((p as usize) != 0) {
            add_pat_syms(p, inner, mut_view(*inner_count));
            p = unsafe { (*p).next };
        }
    } else if pk == HIR_PAT_STRUCT {
        let mut f: *mut HirPatField = unsafe { (*pat).fields };
        while ((f as usize) != 0) {
            let fpat: *mut HirPat = unsafe { (*f).pat };
            add_pat_syms(fpat, inner, mut_view(*inner_count));
            f = unsafe { (*f).next };
        }
    }
}

fn scan_block_captures(
    cx: mut_view<TypeckCtx>,
    block: *const HirBlock,
    inner: *mut SymbolId,
    inner_count: mut_view<usize>,
    caps: *mut RawCapture,
    cap_count: mut_view<usize>
) {
    if (block as usize) == 0 { return; }
    let save_inner = *inner_count;
    let mut s: *mut HirStmt = unsafe { (*block).stmts };
    while ((s as usize) != 0) {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let lexpr: *mut HirExpr = unsafe { (*s).expr };
            let lelse: *mut HirBlock = unsafe { (*s).else_block };
            let lpat: *mut HirPat = unsafe { (*s).pat };
            if (lexpr as usize) != 0 {
                scan_expr_captures(mut_view(*cx), lexpr, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            }
            if (lelse as usize) != 0 {
                scan_block_captures(mut_view(*cx), lelse, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
            }
            add_pat_syms(lpat, inner, mut_view(*inner_count));
        } else if sk == HIR_STMT_ASSIGN {
            let lft: *mut HirExpr = unsafe { (*s).left };
            let rgt: *mut HirExpr = unsafe { (*s).right };
            scan_expr_captures(mut_view(*cx), lft, inner, mut_view(*inner_count), caps, mut_view(*cap_count), true, false);
            scan_expr_captures(mut_view(*cx), rgt, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        } else if sk == HIR_STMT_EXPR {
            let se: *mut HirExpr = unsafe { (*s).expr };
            scan_expr_captures(mut_view(*cx), se, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
        s = unsafe { (*s).next };
    }
    *inner_count = save_inner;
}

fn scan_expr_captures(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    inner: *mut SymbolId,
    inner_count: mut_view<usize>,
    caps: *mut RawCapture,
    cap_count: mut_view<usize>,
    in_mut: bool,
    in_move: bool
) {
    if (expr as usize) == 0 { return; }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        if sym_v != 0u32 {
            let sym = (SymbolId { v: sym_v });
            if !is_inner_sym((SymbolId { v: sym.v }), inner, *inner_count) && is_outer_var(view(*cx), (SymbolId { v: sym.v })) {
                record_cap(caps, mut_view(*cap_count), (SymbolId { v: sym.v }), in_mut, in_move);
            }
        }
    } else if ek == HIR_EXPR_BINARY {
        let lft: *mut HirExpr = unsafe { (*expr).left };
        let rgt: *mut HirExpr = unsafe { (*expr).right };
        scan_expr_captures(mut_view(*cx), lft, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        scan_expr_captures(mut_view(*cx), rgt, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
    } else if ek == HIR_EXPR_UNARY || ek == HIR_EXPR_CAST {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        scan_expr_captures(mut_view(*cx), in_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
    } else if ek == HIR_EXPR_VIEW {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let is_m = unsafe { (*expr).is_mut };
        scan_expr_captures(mut_view(*cx), in_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), is_m, false);
    } else if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        scan_block_captures(mut_view(*cx), blk, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
    } else if ek == HIR_EXPR_IF {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
        scan_expr_captures(mut_view(*cx), cond_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        scan_block_captures(mut_view(*cx), blk, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
        if (else_e as usize) != 0 {
            scan_expr_captures(mut_view(*cx), else_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
    } else if ek == HIR_EXPR_WHILE {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        scan_expr_captures(mut_view(*cx), cond_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        scan_block_captures(mut_view(*cx), blk, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
    } else if ek == HIR_EXPR_FOR {
        let iter_e: *mut HirExpr = unsafe { (*expr).iter };
        let pat_p: *mut HirPat = unsafe { (*expr).pat };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        scan_expr_captures(mut_view(*cx), iter_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        let save = *inner_count;
        add_pat_syms(pat_p, inner, mut_view(*inner_count));
        scan_block_captures(mut_view(*cx), blk, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
        *inner_count = save;
    } else if ek == HIR_EXPR_RANGE {
        let se: *mut HirExpr = unsafe { (*expr).start_expr };
        let ee: *mut HirExpr = unsafe { (*expr).end_expr };
        if (se as usize) != 0 { scan_expr_captures(mut_view(*cx), se, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false); }
        if (ee as usize) != 0 { scan_expr_captures(mut_view(*cx), ee, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false); }
    } else if ek == HIR_EXPR_MATCH {
        let m_e: *mut HirExpr = unsafe { (*expr).cond };
        scan_expr_captures(mut_view(*cx), m_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        let mut arm: *mut HirMatchArm = unsafe { (*expr).arms };
        while ((arm as usize) != 0) {
            let save = *inner_count;
            let apat: *mut HirPat = unsafe { (*arm).pat };
            let aguard: *mut HirExpr = unsafe { (*arm).guard };
            let abody: *mut HirExpr = unsafe { (*arm).body };
            add_pat_syms(apat, inner, mut_view(*inner_count));
            if (aguard as usize) != 0 {
                scan_expr_captures(mut_view(*cx), aguard, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            }
            scan_expr_captures(mut_view(*cx), abody, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            *inner_count = save;
            arm = unsafe { (*arm).next };
        }
    } else if ek == HIR_EXPR_CALL {
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        let mut is_drop = false;
        if (callee as usize) != 0 && unsafe { (*callee).kind } == HIR_EXPR_PATH {
            let mut dummy_gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
            let cty = unsafe { lookup_path_type(mut_view(*cx), view((*callee).path), mut_view(dummy_gargs)) };
            if cty.v != 0u32 {
                let ct = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: cty.v })) };
                if (ct as usize) != 0 && unsafe { (*ct).kind } == TY_BUILTIN_DROP {
                    is_drop = true;
                }
            }
        }
        scan_expr_captures(mut_view(*cx), callee, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while ((a as usize) != 0) {
            let mut arg_move = is_drop;
            if !arg_move && unsafe { (*a).kind } == HIR_EXPR_PATH && unsafe { (*a).path.symbol.v } != 0u32 {
                let vty = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: (*a).path.symbol.v })) };
                if vty.v != 0u32 && (cx.str_in as usize) != 0 {
                    let is_c = unsafe { type_is_copy((TypeId { v: vty.v }), view(*cx.thir), view(*cx.str_in)) };
                    if !is_c { arg_move = true; }
                }
            }
            scan_expr_captures(mut_view(*cx), a, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, arg_move);
            a = unsafe { (*a).next };
        }
    } else if ek == HIR_EXPR_METHOD_CALL {
        let recv: *mut HirExpr = unsafe { (*expr).receiver };
        scan_expr_captures(mut_view(*cx), recv, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while ((a as usize) != 0) {
            scan_expr_captures(mut_view(*cx), a, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            a = unsafe { (*a).next };
        }
    } else if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        let b: *mut HirExpr = unsafe { (*expr).base };
        scan_expr_captures(mut_view(*cx), b, inner, mut_view(*inner_count), caps, mut_view(*cap_count), in_mut, in_move);
    } else if ek == HIR_EXPR_INDEX {
        let b: *mut HirExpr = unsafe { (*expr).base };
        let ia: *mut HirExpr = unsafe { (*expr).index_arg };
        scan_expr_captures(mut_view(*cx), b, inner, mut_view(*inner_count), caps, mut_view(*cap_count), in_mut, false);
        scan_expr_captures(mut_view(*cx), ia, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
    } else if ek == HIR_EXPR_TUPLE {
        let mut e: *mut HirExpr = unsafe { (*expr).elems };
        while ((e as usize) != 0) {
            scan_expr_captures(mut_view(*cx), e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            e = unsafe { (*e).next };
        }
    } else if ek == HIR_EXPR_ARRAY {
        let mut e: *mut HirExpr = unsafe { (*expr).elems };
        while ((e as usize) != 0) {
            scan_expr_captures(mut_view(*cx), e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            e = unsafe { (*e).next };
        }
        let ce: *mut HirExpr = unsafe { (*expr).count_expr };
        if (ce as usize) != 0 {
            scan_expr_captures(mut_view(*cx), ce, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
    } else if ek == HIR_EXPR_STRUCT {
        let mut f: *mut HirFieldInit = unsafe { (*expr).fields };
        while ((f as usize) != 0) {
            let fe: *mut HirExpr = unsafe { (*f).expr };
            scan_expr_captures(mut_view(*cx), fe, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            f = unsafe { (*f).next };
        }
    } else if ek == HIR_EXPR_JUMP {
        let je: *mut HirExpr = unsafe { (*expr).inner };
        if (je as usize) != 0 {
            scan_expr_captures(mut_view(*cx), je, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
    }
}

fn check_field_vis(cx: mut_view<TypeckCtx>, f: *const HirFieldDecl, sdef: *const HirItem, err_sp: view<Span>) -> bool {
    let vk = unsafe { (*f).vis.kind };
    if (cx.current_fn as usize) == 0 || (sdef as usize) == 0 { return true; }
    if vk == HIR_VIS_PRIVATE || vk == HIR_VIS_PUB_MODULE {
        let eq = unsafe { dotted_name_eq(view((*cx.current_fn).module_path), view((*sdef).module_path)) };
        if !eq {
            type_error(mut_view(*cx), err_sp, AX_NAME_PRIVATE);
            return false;
        }
    } else if vk == HIR_VIS_PUB_PACKAGE {
        let c1 = unsafe { (*cx.current_fn).module_path.count };
        let c2 = unsafe { (*sdef).module_path.count };
        let mut diff = false;
        if c1 == 0 || c2 == 0 {
            diff = c1 != c2;
        } else {
            let s1 = unsafe { (*strid_at_const((*cx.current_fn).module_path.segments as *const StrId, 0)).v };
            let s2 = unsafe { (*strid_at_const((*sdef).module_path.segments as *const StrId, 0)).v };
            if s1 != s2 { diff = true; }
        }
        if diff {
            type_error(mut_view(*cx), err_sp, AX_NAME_PRIVATE);
            return false;
        }
    }
    true
}

pub fn check_expr_kind(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let isize_v = unsafe { (*cx.thir).interner.t_isize.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    let u32_v = unsafe { (*cx.thir).interner.t_u32.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    let char_v = unsafe { (*cx.thir).interner.t_char.v };
    let str_v = unsafe { (*cx.thir).interner.t_str.v };

    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_ERROR { return (TypeId { v: err_v }); }
    if ek == HIR_EXPR_LITERAL { return check_literal(mut_view(*cx), expr); }

    if ek == HIR_EXPR_TUPLE {
        let elems_head: *mut HirExpr = unsafe { (*expr).elems };
        let count = count_expr_list(elems_head);
        if count == 0 { return (TypeId { v: unit_v }); }
        let bytes = mul_usize(count, size_of<TypeId>());
        let fields = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
        let mut exp_t: *mut AxType = 0 as *mut AxType;
        if expected.v != 0u32 {
            let r_exp = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
            let et = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_exp.v })) };
            if (et as usize) != 0 && unsafe { (*et).kind } == TY_TUPLE && unsafe { (*et).field_count } == count {
                exp_t = et;
            }
        }
        let mut i: usize = 0;
        let mut e = elems_head;
        while ((e as usize) != 0) {
            let mut exp_elem = (TypeId { v: 0u32 });
            if (exp_t as usize) != 0 {
                let ef = unsafe { (*exp_t).fields };
                let ef_v = unsafe { (*typeid_at(ef, i)).v };
                exp_elem.v = ef_v;
            }
            let ety = check_expr(mut_view(*cx), e, (TypeId { v: exp_elem.v }));
            let dst = unsafe { typeid_at(fields, i) };
            unsafe { (*dst).v = ety.v; }
            i = i + 1;
            e = unsafe { (*e).next };
        }
        return unsafe { intern_tuple_ty(mut_view((*cx.thir).interner), fields, count) };
    }

    if ek == HIR_EXPR_STRUCT {
        return check_expr_struct(mut_view(*cx), expr);
    }
    if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        return check_expr_field_or_tuple_idx(mut_view(*cx), expr, ek);
    }
    if ek == HIR_EXPR_PATH || ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE ||
       ek == HIR_EXPR_IF || ek == HIR_EXPR_LOOP || ek == HIR_EXPR_WHILE ||
       ek == HIR_EXPR_JUMP || ek == HIR_EXPR_CALL || ek == HIR_EXPR_BINARY ||
       ek == HIR_EXPR_UNARY || ek == HIR_EXPR_CAST {
        return check_expr_flow_or_cast(mut_view(*cx), expr, (TypeId { v: expected.v }), ek);
    }
    if ek == HIR_EXPR_ARRAY || ek == HIR_EXPR_INDEX {
        return check_expr_array_or_index(mut_view(*cx), expr, (TypeId { v: expected.v }), ek);
    }
    if ek == HIR_EXPR_MATCH || ek == HIR_EXPR_VIEW || ek == HIR_EXPR_FOR ||
       ek == HIR_EXPR_RANGE || ek == HIR_EXPR_COMPTIME {
        return check_expr_match_or_view(mut_view(*cx), expr, (TypeId { v: expected.v }), ek);
    }
    if ek == HIR_EXPR_CLOSURE {
        return check_expr_closure(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_METHOD_CALL {
        return check_expr_method_call(mut_view(*cx), expr);
    }
    check_expr_try_or_await(mut_view(*cx), expr, ek)
}

fn check_expr_struct(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    if true {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let mut path_ty = unsafe { lookup_path_type(mut_view(*cx), view((*expr).path), mut_view(gargs)) };
        if gargs.count > 0 {
            unsafe { ptr_substmap_insert(mut_view((*cx.thir).expr_substs), expr as usize, gargs.args, gargs.count); }
        }
        if !is_error(mut_view(*cx), (TypeId { v: path_ty.v })) {
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: path_ty.v })) };
            let tk = if (t as usize) != 0 { unsafe { (*t).kind } } else { TY_ERROR };
            if tk == TY_ENUM {
                let name = unsafe { tc_path_name_sv(view(*cx), view((*expr).path)) };
                let mut vname = StrView { ptr: name.ptr, len: name.len };
                let mut k: usize = 0;
                while (k < name.len) {
                    if unsafe { *(name.ptr + k) } == 46u8 {
                        vname.ptr = unsafe { name.ptr + k + 1 };
                        vname.len = name.len - k - 1;
                    }
                    k = k + 1;
                }
                let mut found_variant = false;
                let mut vidx: usize = 0;
                let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
                while ((v as usize) != 0) {
                    let var_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
                    if sv_eq(view(var_name), view(vname)) {
                        found_variant = true;
                        unsafe { ptr_usizemap_insert(mut_view((*cx.thir).expr_variants), expr as usize, vidx); }
                        if !unsafe { (*v).is_struct } {
                            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                        }
                        let mut init: *mut HirFieldInit = unsafe { (*expr).fields };
                        while ((init as usize) != 0) {
                            let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                            let mut other: *mut HirFieldInit = unsafe { (*init).next };
                            while ((other as usize) != 0) {
                                let oname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*other).name.v })) };
                                if sv_eq(view(iname), view(oname)) {
                                    unsafe { type_error(mut_view(*cx), view((*other).span), AX_TYPE_DUPLICATE_FIELD); }
                                }
                                other = unsafe { (*other).next };
                            }
                            init = unsafe { (*init).next };
                        }
                        let row = unsafe { *typeid_ptr_at((*t).variant_fields, vidx) };
                        init = unsafe { (*expr).fields };
                        while ((init as usize) != 0) {
                            let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                            let mut found = false;
                            let mut idx: usize = 0;
                            let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                            while ((f as usize) != 0) {
                                let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                                if sv_eq(view(fname), view(iname)) {
                                    found = true;
                                    let fty_v = unsafe { (*typeid_at(row, idx)).v };
                                    let iexpr: *mut HirExpr = unsafe { (*init).expr };
                                    check_expr(mut_view(*cx), iexpr, (TypeId { v: fty_v }));
                                    break;
                                }
                                idx = idx + 1;
                                f = unsafe { (*f).next };
                            }
                            if !found {
                                unsafe { type_error(mut_view(*cx), view((*init).span), AX_TYPE_UNKNOWN_FIELD); }
                            }
                            init = unsafe { (*init).next };
                        }
                        let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                        while ((f as usize) != 0) {
                            let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                            let mut found = false;
                            init = unsafe { (*expr).fields };
                            while ((init as usize) != 0) {
                                let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                                if sv_eq(view(fname), view(iname)) { found = true; }
                                init = unsafe { (*init).next };
                            }
                            if !found {
                                unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISSING_FIELD); }
                            }
                            f = unsafe { (*f).next };
                        }
                        break;
                    }
                    vidx = vidx + 1;
                    v = unsafe { (*v).next };
                }
                if !found_variant {
                    return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                }
            } else if tk != TY_STRUCT {
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
            } else {
                let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let fptr = unsafe { (*t).fields };
                let mut init: *mut HirFieldInit = unsafe { (*expr).fields };
                while ((init as usize) != 0) {
                    let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                    let mut other: *mut HirFieldInit = unsafe { (*init).next };
                    while ((other as usize) != 0) {
                        let oname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*other).name.v })) };
                        if sv_eq(view(iname), view(oname)) {
                            unsafe { type_error(mut_view(*cx), view((*other).span), AX_TYPE_DUPLICATE_FIELD); }
                        }
                        other = unsafe { (*other).next };
                    }
                    init = unsafe { (*init).next };
                }
                init = unsafe { (*expr).fields };
                while ((init as usize) != 0) {
                    let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                    let mut found = false;
                    let mut idx: usize = 0;
                    let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
                    while ((f as usize) != 0) {
                        let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                        if sv_eq(view(fname), view(iname)) {
                            found = true;
                            unsafe { check_field_vis(mut_view(*cx), f, sdef, view((*init).span)); }
                            let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                            let iexpr: *mut HirExpr = unsafe { (*init).expr };
                            check_expr(mut_view(*cx), iexpr, (TypeId { v: fty_v }));
                            break;
                        }
                        idx = idx + 1;
                        f = unsafe { (*f).next };
                    }
                    if !found {
                        unsafe { type_error(mut_view(*cx), view((*init).span), AX_TYPE_UNKNOWN_FIELD); }
                    }
                    init = unsafe { (*init).next };
                }
                let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
                while ((f as usize) != 0) {
                    let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                    let mut found = false;
                    init = unsafe { (*expr).fields };
                    while ((init as usize) != 0) {
                        let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                        if sv_eq(view(fname), view(iname)) { found = true; }
                        init = unsafe { (*init).next };
                    }
                    if !found {
                        unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISSING_FIELD); }
                    }
                    f = unsafe { (*f).next };
                }
                if gargs.count > 0 {
                    let bytes = mul_usize(gargs.count, size_of<TypeId>());
                    let r_args = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
                    let mut i: usize = 0;
                    while (i < gargs.count) {
                        let gv = unsafe { (*typeid_at(gargs.args, i)).v };
                        let rg = resolve_ty(mut_view(*cx), (TypeId { v: gv }));
                        let dst = unsafe { typeid_at(r_args, i) };
                        unsafe { (*dst).v = rg.v; }
                        i = i + 1;
                    }
                    let orig_st_ty = unsafe { thir_get_item_type(view(*cx.thir), sdef) };
                    if orig_st_ty.v != 0u32 {
                        let r_slice = (GenericArgsSlice { args: r_args, count: gargs.count });
                        let sub = unsafe { subst_ty_with_vars(mut_view((*cx.thir).interner), mut_view(cx.type_vars), (TypeId { v: orig_st_ty.v }), view(r_slice)) };
                        path_ty.v = sub.v;
                    }
                }
            }
        }
        return (TypeId { v: path_ty.v });
    }
    unsafe { (*cx.thir).interner.t_error }
}

fn check_expr_field_or_tuple_idx(cx: mut_view<TypeckCtx>, expr: *const HirExpr, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    if ek == HIR_EXPR_FIELD {
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let obj_ty = check_expr(mut_view(*cx), b_expr, (TypeId { v: 0u32 }));
        if !is_error(mut_view(*cx), (TypeId { v: obj_ty.v })) {
            let mut base_ty = resolve_ty(mut_view(*cx), (TypeId { v: obj_ty.v }));
            let mut t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
            while ((t as usize) != 0 && (unsafe { (*t).kind } == TY_VIEW || unsafe { (*t).kind } == TY_MUT_VIEW || unsafe { (*t).kind } == TY_PTR)) {
                let pt_v = unsafe { (*t).pointee.v };
                let r_pt = resolve_ty(mut_view(*cx), (TypeId { v: pt_v }));
                base_ty.v = r_pt.v;
                t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
            }
            if (t as usize) == 0 { return (TypeId { v: err_v }); }
            let tk = unsafe { (*t).kind };
            let search = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*expr).name.v })) };
            if tk == TY_STRUCT {
                let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let fptr = unsafe { (*t).fields };
                let mut idx: usize = 0;
                let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
                while ((f as usize) != 0) {
                    let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                    if sv_eq(view(fname), view(search)) {
                        let ok = unsafe { check_field_vis(mut_view(*cx), f, sdef, view((*expr).span)) };
                        if !ok { return (TypeId { v: err_v }); }
                        let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                        return (TypeId { v: fty_v });
                    }
                    idx = idx + 1;
                    f = unsafe { (*f).next };
                }
                if (cx.hir as usize) != 0 {
                    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
                    while ((it as usize) != 0) {
                        let self_ht: *mut HirType = unsafe { (*it).self_type };
                        if unsafe { (*it).kind } == HIR_ITEM_IMPL && (self_ht as usize) != 0 {
                            let old_impl = cx.current_impl;
                            cx.current_impl = it;
                            let impl_self_ty = hir_type_to_typeid(mut_view(*cx), self_ht);
                            cx.current_impl = old_impl;
                            if unify_ty(mut_view(*cx), (TypeId { v: impl_self_ty.v }), (TypeId { v: base_ty.v })) {
                                let mut m: *mut HirItem = unsafe { (*it).members };
                                while ((m as usize) != 0) {
                                    if unsafe { (*m).kind } == HIR_ITEM_CONST {
                                        let cname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*m).name.v })) };
                                        if sv_eq(view(cname), view(search)) {
                                            unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, m); }
                                            let cty = unsafe { thir_get_item_type(view(*cx.thir), m) };
                                            return if cty.v != 0u32 { (TypeId { v: cty.v }) } else { (TypeId { v: i32_v }) };
                                        }
                                    }
                                    m = unsafe { (*m).next };
                                }
                            }
                        }
                        it = unsafe { (*it).next };
                    }
                }
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
            }
            if tk == TY_PARAM {
                if (cx.hir as usize) != 0 {
                    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
                    while ((it as usize) != 0) {
                        if unsafe { (*it).kind } == HIR_ITEM_TRAIT {
                            let mut m: *mut HirItem = unsafe { (*it).members };
                            while ((m as usize) != 0) {
                                if unsafe { (*m).kind } == HIR_ITEM_CONST {
                                    let cname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*m).name.v })) };
                                    if sv_eq(view(cname), view(search)) {
                                        unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, m); }
                                        let cty = unsafe { thir_get_item_type(view(*cx.thir), m) };
                                        return if cty.v != 0u32 { (TypeId { v: cty.v }) } else { (TypeId { v: i32_v }) };
                                    }
                                }
                                m = unsafe { (*m).next };
                            }
                        }
                        it = unsafe { (*it).next };
                    }
                }
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
            }
            if tk == TY_ENUM {
                let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let mut vidx: usize = 0;
                let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
                while ((v as usize) != 0) {
                    let vname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
                    if sv_eq(view(vname), view(search)) {
                        unsafe { ptr_usizemap_insert(mut_view((*cx.thir).expr_variants), expr as usize, vidx); }
                        let vfc = unsafe { *usize_at((*t).variant_field_counts, vidx) };
                        if unsafe { (*v).is_struct } || vfc > 0 {
                            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                        }
                        return (TypeId { v: obj_ty.v });
                    }
                    vidx = vidx + 1;
                    v = unsafe { (*v).next };
                }
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
            }
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
        }
        return (TypeId { v: err_v });
    }

    if ek == HIR_EXPR_TUPLE_INDEX {
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let obj_ty = check_expr(mut_view(*cx), b_expr, (TypeId { v: 0u32 }));
        if !is_error(mut_view(*cx), (TypeId { v: obj_ty.v })) {
            let r_obj = resolve_ty(mut_view(*cx), (TypeId { v: obj_ty.v }));
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_obj.v })) };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                let tidx = (unsafe { (*expr).tuple_index }) as usize;
                if tk == TY_STRUCT {
                    let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                    if (sdef as usize) != 0 && unsafe { (*sdef).is_tuple } {
                        if tidx < unsafe { (*t).field_count } {
                            let fty_v = unsafe { (*typeid_at((*t).fields, tidx)).v };
                            return (TypeId { v: fty_v });
                        }
                        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
                    }
                } else if tk == TY_TUPLE {
                    if tidx < unsafe { (*t).field_count } {
                        let fty_v = unsafe { (*typeid_at((*t).fields, tidx)).v };
                        return (TypeId { v: fty_v });
                    }
                    return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
                }
            }
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
        }
        return (TypeId { v: err_v });
    }
    (TypeId { v: err_v })
}

fn check_expr_flow_or_cast(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let isize_v = unsafe { (*cx.thir).interner.t_isize.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    let u32_v = unsafe { (*cx.thir).interner.t_u32.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    let char_v = unsafe { (*cx.thir).interner.t_char.v };
    if ek == HIR_EXPR_PATH {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let t = unsafe { lookup_path_type(mut_view(*cx), view((*expr).path), mut_view(gargs)) };
        if gargs.count > 0 {
            unsafe { ptr_substmap_insert(mut_view((*cx.thir).expr_substs), expr as usize, gargs.args, gargs.count); }
        }
        let sym_v = unsafe { (*expr).path.symbol.v };
        if sym_v != 0u32 {
            let citem = find_const_item_by_symbol(view(*cx), (SymbolId { v: sym_v }));
            if (citem as usize) != 0 {
                evaluate_const_item(mut_view(*cx), citem);
            }
        }
        if !is_error(mut_view(*cx), (TypeId { v: t.v })) {
            let k = kind_of(mut_view(*cx), (TypeId { v: t.v }));
            if k == TY_BUILTIN_DROP || k == TY_BUILTIN_LEN || k == TY_BUILTIN_PRINT || k == TY_BUILTIN_PRINT_INT {
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
            }
        }
        return (TypeId { v: t.v });
    }

    if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        return check_block(mut_view(*cx), blk, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_IF {
        return check_if(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_LOOP {
        let old_loop = cx.in_loop;
        cx.in_loop = true;
        let lbl = unsafe { (*expr).label };
        push_loop_env(mut_view(*cx), (StrId { v: lbl.v }), (TypeId { v: 0u32 }));
        let blk: *mut HirBlock = unsafe { (*expr).block };
        check_block(mut_view(*cx), blk, (TypeId { v: unit_v }));
        cx.loops_len = cx.loops_len - 1;
        cx.in_loop = old_loop;
        let le = unsafe { loopenv_at(cx.loops, cx.loops_len) };
        if unsafe { (*le).has_break } {
            let bty_v = unsafe { (*le).break_ty.v };
            return (TypeId { v: bty_v });
        }
        return (TypeId { v: never_v });
    }
    if ek == HIR_EXPR_WHILE {
        let old_loop = cx.in_loop;
        cx.in_loop = true;
        let lbl = unsafe { (*expr).label };
        push_loop_env(mut_view(*cx), (StrId { v: lbl.v }), (TypeId { v: unit_v }));
        let lpat: *mut HirPat = unsafe { (*expr).let_pat };
        if (lpat as usize) != 0 {
            desugar_while_let(mut_view(*cx), expr as *mut HirExpr);
            cx.loops_len = cx.loops_len - 1;
            cx.in_loop = old_loop;
            return check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
        }
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        check_expr(mut_view(*cx), cond_e, (TypeId { v: bool_v }));
        check_block(mut_view(*cx), blk, (TypeId { v: unit_v }));
        cx.loops_len = cx.loops_len - 1;
        cx.in_loop = old_loop;
        return (TypeId { v: unit_v });
    }
    if ek == HIR_EXPR_JUMP {
        let jk = unsafe { (*expr).jump_kind };
        let jexpr: *mut HirExpr = unsafe { (*expr).inner };
        if jk == JUMP_RETURN {
            let ret = if cx.return_type.v == 0u32 { (TypeId { v: unit_v }) } else { (TypeId { v: cx.return_type.v }) };
            if (jexpr as usize) != 0 {
                check_expr(mut_view(*cx), jexpr, (TypeId { v: ret.v }));
            } else if !unify_ty(mut_view(*cx), (TypeId { v: unit_v }), (TypeId { v: ret.v })) {
                unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH); }
            }
        } else if jk == JUMP_BREAK {
            let mut target: *mut LoopEnv = 0 as *mut LoopEnv;
            let lbl_v = unsafe { (*expr).label.v };
            if lbl_v != 0u32 {
                let mut i: usize = cx.loops_len;
                while (i > 0) {
                    let le = unsafe { loopenv_at(cx.loops, i - 1) };
                    if unsafe { (*le).label.v } == lbl_v {
                        target = le;
                        break;
                    }
                    i = i - 1;
                }
            } else if cx.loops_len > 0 {
                target = unsafe { loopenv_at(cx.loops, cx.loops_len - 1) };
            }
            if (target as usize) != 0 {
                let mut val_ty = (TypeId { v: unit_v });
                let t_bty_v = unsafe { (*target).break_ty.v };
                if (jexpr as usize) != 0 {
                    let vt = check_expr(mut_view(*cx), jexpr, (TypeId { v: t_bty_v }));
                    val_ty.v = vt.v;
                }
                if !unsafe { (*target).has_break } {
                    unsafe {
                        (*target).break_ty.v = val_ty.v;
                        (*target).has_break = true;
                    }
                } else if !is_error(mut_view(*cx), (TypeId { v: t_bty_v })) && !is_error(mut_view(*cx), (TypeId { v: val_ty.v })) {
                    let sp_ptr: *const HirExpr = if (jexpr as usize) != 0 { jexpr as *const HirExpr } else { expr as *const HirExpr };
                    let c_ty = unsafe { coerce(mut_view(*cx), (TypeId { v: val_ty.v }), (TypeId { v: t_bty_v }), view((*sp_ptr).span)) };
                    unsafe { (*target).break_ty.v = c_ty.v; }
                }
            } else {
                if (jexpr as usize) != 0 {
                    check_expr(mut_view(*cx), jexpr, (TypeId { v: 0u32 }));
                }
            }
        }
        return (TypeId { v: never_v });
    }
    if ek == HIR_EXPR_CALL { return check_call(mut_view(*cx), expr); }
    if ek == HIR_EXPR_BINARY { return check_binary(mut_view(*cx), expr); }
    if ek == HIR_EXPR_UNARY { return check_unary(mut_view(*cx), expr); }

    if ek == HIR_EXPR_CAST {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let cty_ptr: *mut HirType = unsafe { (*expr).cast_ty };
        let raw_src = check_expr(mut_view(*cx), in_e, (TypeId { v: 0u32 }));
        let src_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_src.v }));
        let raw_dest = hir_type_to_typeid(mut_view(*cx), cty_ptr);
        let dest_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_dest.v }));
        if dest_ty.v == 0u32 || is_error(mut_view(*cx), (TypeId { v: src_ty.v })) || is_error(mut_view(*cx), (TypeId { v: dest_ty.v })) {
            return (TypeId { v: err_v });
        }
        if src_ty.v == dest_ty.v { return (TypeId { v: dest_ty.v }); }

        let mut is_valid = false;
        let sk = kind_of(mut_view(*cx), (TypeId { v: src_ty.v }));
        let dk = kind_of(mut_view(*cx), (TypeId { v: dest_ty.v }));
        let dest_is_int = unsafe { type_is_int((TypeId { v: dest_ty.v }), view((*cx.thir).interner)) };
        let src_is_int = unsafe { type_is_int((TypeId { v: src_ty.v }), view((*cx.thir).interner)) };

        if is_intlike(mut_view(*cx), (TypeId { v: src_ty.v })) && dest_is_int {
            is_valid = true;
        } else if sk == TY_ENUM && dest_is_int {
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: src_ty.v })) };
            let mut has_payload = false;
            if (t as usize) != 0 {
                let mut i: usize = 0;
                while (i < unsafe { (*t).variant_count }) {
                    if unsafe { *usize_at((*t).variant_field_counts, i) } > 0 {
                        has_payload = true;
                        break;
                    }
                    i = i + 1;
                }
            }
            if !has_payload { is_valid = true; }
        } else if src_ty.v == bool_v && dest_is_int {
            is_valid = true;
        } else if (src_ty.v == u8_v || src_ty.v == u32_v) && dest_ty.v == char_v {
            is_valid = true;
        } else if src_ty.v == char_v && dest_is_int {
            if dk == TY_U32 || dk == TY_I32 || dk == TY_U64 || dk == TY_I64 || dk == TY_USIZE || dk == TY_ISIZE {
                is_valid = true;
            }
        } else if is_never(mut_view(*cx), (TypeId { v: src_ty.v })) {
            is_valid = true;
        } else if sk == TY_PTR && dk == TY_PTR {
            is_valid = true;
        } else if sk == TY_PTR && (dest_ty.v == usize_v || dest_ty.v == isize_v || dest_is_int) {
            is_valid = true;
        } else if (src_ty.v == usize_v || src_ty.v == isize_v || is_intlike(mut_view(*cx), (TypeId { v: src_ty.v })) || src_is_int) && dk == TY_PTR {
            is_valid = true;
        }
        if is_valid { return (TypeId { v: dest_ty.v }); }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_INVALID_CAST) };
    }
    (TypeId { v: err_v })
}

fn check_expr_array_or_index(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    let str_v = unsafe { (*cx.thir).interner.t_str.v };
    if ek == HIR_EXPR_ARRAY {
        let cnt_e: *mut HirExpr = unsafe { (*expr).count_expr };
        let elems_e: *mut HirExpr = unsafe { (*expr).elems };
        let mut expected_elem = (TypeId { v: 0u32 });
        if expected.v != 0u32 && kind_of(mut_view(*cx), (TypeId { v: expected.v })) == TY_ARRAY {
            let r_exp = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
            let et = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_exp.v })) };
            if (et as usize) != 0 {
                expected_elem.v = unsafe { (*et).elem.v };
            }
        }
        if (cnt_e as usize) != 0 {
            let mut arr_len: u64 = 0u64;
            if !eval_array_len_expr(mut_view(*cx), cnt_e, mut_view(arr_len)) {
                return (TypeId { v: err_v });
            }
            let elem_ty = check_expr(mut_view(*cx), elems_e, (TypeId { v: expected_elem.v }));
            if is_error(mut_view(*cx), (TypeId { v: elem_ty.v })) { return (TypeId { v: err_v }); }
            return unsafe { intern_array_ty(mut_view((*cx.thir).interner), (TypeId { v: elem_ty.v }), arr_len) };
        } else {
            let mut count: u64 = 0u64;
            let mut elem_ty = (TypeId { v: expected_elem.v });
            let mut e = elems_e;
            while ((e as usize) != 0) {
                count = count + 1u64;
                let t = check_expr(mut_view(*cx), e, (TypeId { v: elem_ty.v }));
                if elem_ty.v == 0u32 { elem_ty.v = t.v; }
                e = unsafe { (*e).next };
            }
            if elem_ty.v == 0u32 { elem_ty.v = never_v; }
            if is_error(mut_view(*cx), (TypeId { v: elem_ty.v })) { return (TypeId { v: err_v }); }
            return unsafe { intern_array_ty(mut_view((*cx.thir).interner), (TypeId { v: elem_ty.v }), count) };
        }
    }

    if ek == HIR_EXPR_INDEX {
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let ia_expr: *mut HirExpr = unsafe { (*expr).index_arg };
        let raw_b = check_expr(mut_view(*cx), b_expr, (TypeId { v: 0u32 }));
        let base_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_b.v }));
        if is_error(mut_view(*cx), (TypeId { v: base_ty.v })) { return (TypeId { v: err_v }); }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        if (t as usize) == 0 { return (TypeId { v: err_v }); }
        let tk = unsafe { (*t).kind };
        let mut is_slice = false;
        let mut slice_elem_v: u32 = 0u32;
        if tk == TY_VIEW || tk == TY_MUT_VIEW {
            let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: (*t).pointee.v })) };
            if (pt as usize) != 0 && unsafe { (*pt).kind } == TY_SLICE {
                is_slice = true;
                slice_elem_v = unsafe { (*pt).elem.v };
            }
        }
        let is_array = tk == TY_ARRAY;
        let is_str = tk == TY_STR;

        if (ia_expr as usize) != 0 && unsafe { (*ia_expr).kind } == HIR_EXPR_RANGE {
            if !is_slice && !is_array && !is_str {
                return unsafe { type_error(mut_view(*cx), view((*b_expr).span), AX_TYPE_CANNOT_INDEX) };
            }
            let se: *mut HirExpr = unsafe { (*ia_expr).start_expr };
            let ee: *mut HirExpr = unsafe { (*ia_expr).end_expr };
            if (se as usize) != 0 { check_expr(mut_view(*cx), se, (TypeId { v: usize_v })); }
            if (ee as usize) != 0 { check_expr(mut_view(*cx), ee, (TypeId { v: usize_v })); }
            if is_str { return (TypeId { v: str_v }); }
            if is_slice {
                let pt_id = TypeId { v: unsafe { (*t).pointee.v } };
                return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: pt_id.v }), tk == TY_MUT_VIEW) };
            }
            let elem_id = TypeId { v: unsafe { (*t).elem.v } };
            let sl_id = unsafe { intern_slice_ty(mut_view((*cx.thir).interner), (TypeId { v: elem_id.v })) };
            return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: sl_id.v }), false) };
        }

        if is_array || is_slice || is_str {
            let idx_ty = check_expr(mut_view(*cx), ia_expr, (TypeId { v: usize_v }));
            if is_error(mut_view(*cx), (TypeId { v: idx_ty.v })) { return (TypeId { v: err_v }); }
            if is_array {
                let ev = unsafe { (*t).elem.v };
                return (TypeId { v: ev });
            }
            if is_slice { return (TypeId { v: slice_elem_v }); }
            return (TypeId { v: u8_v });
        }

        if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
            let mut trait_res: u8 = TRAIT_DISPROVEN;
            let idx_sv = unsafe { tc_alloc_sv(mut_view((*cx.thir).interner.arena), 28) };
            let method_item = unsafe {
                find_method(view(*cx.hir), view(*cx.thir), (TypeId { v: base_ty.v }), view(idx_sv), view(*cx.str_in), view(*cx.db), mut_view(trait_res))
            };
            if (method_item as usize) != 0 {
                unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, method_item); }
                let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), method_item) };
                if fn_ty_id.v != 0u32 {
                    let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
                    if (fn_ty as usize) != 0 {
                        let expected_idx_v = if unsafe { (*fn_ty).param_count } >= 2 {
                            unsafe { (*typeid_at((*fn_ty).param_types, 1)).v }
                        } else {
                            usize_v
                        };
                        check_expr(mut_view(*cx), ia_expr, (TypeId { v: expected_idx_v }));
                        let ret_v = unsafe { (*fn_ty).ret_type.v };
                        return (TypeId { v: ret_v });
                    }
                }
            }
        }
        return unsafe { type_error(mut_view(*cx), view((*b_expr).span), AX_TYPE_CANNOT_INDEX) };
    }
    (TypeId { v: err_v })
}

fn check_expr_match_or_view(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    if ek == HIR_EXPR_MATCH {
        let m_scrut: *mut HirExpr = unsafe { (*expr).cond };
        let raw_val = check_expr(mut_view(*cx), m_scrut, (TypeId { v: 0u32 }));
        let val_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_val.v }));
        if is_error(mut_view(*cx), (TypeId { v: val_ty.v })) { return (TypeId { v: err_v }); }

        let mut match_ty = (TypeId { v: expected.v });
        let mut first = true;
        let mut has_error = false;
        let mut arm: *mut HirMatchArm = unsafe { (*expr).arms };
        while ((arm as usize) != 0) {
            let apat: *mut HirPat = unsafe { (*arm).pat };
            let aguard: *mut HirExpr = unsafe { (*arm).guard };
            let abody: *mut HirExpr = unsafe { (*arm).body };
            let p_ty = check_pat(mut_view(*cx), apat, (TypeId { v: val_ty.v }), true);
            if is_error(mut_view(*cx), (TypeId { v: p_ty.v })) { has_error = true; }
            if (aguard as usize) != 0 {
                check_expr(mut_view(*cx), aguard, (TypeId { v: bool_v }));
            }
            let arm_ty = check_expr(mut_view(*cx), abody, (TypeId { v: match_ty.v }));
            if first && !is_error(mut_view(*cx), (TypeId { v: arm_ty.v })) {
                match_ty.v = arm_ty.v;
                first = false;
            }
            arm = unsafe { (*arm).next };
        }
        if match_ty.v == 0u32 {
            let arms_head: *mut HirMatchArm = unsafe { (*expr).arms };
            let m_v = if (arms_head as usize) != 0 { err_v } else { never_v };
            match_ty.v = m_v;
        }
        if !has_error && !is_error(mut_view(*cx), (TypeId { v: val_ty.v })) && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 && (cx.sink as usize) != 0 {
            unsafe {
                tc_match_check_exhaustiveness(mut_view(*cx.thir), view(*cx.str_in), view(*cx.db), mut_view(*cx.sink), expr, (TypeId { v: val_ty.v }));
            }
        }
        return (TypeId { v: match_ty.v });
    }

    if ek == HIR_EXPR_VIEW {
        let is_m = unsafe { (*expr).is_mut };
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let mut expected_inner = (TypeId { v: 0u32 });
        if expected.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected.v })) {
            let r_exp = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
            let exp_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_exp.v })) };
            let want_k = if is_m { TY_MUT_VIEW } else { TY_VIEW };
            if (exp_t as usize) != 0 && unsafe { (*exp_t).kind } == want_k {
                expected_inner.v = unsafe { (*exp_t).pointee.v };
            }
        }
        let mut inner_ty_expected = (TypeId { v: expected_inner.v });
        if expected_inner.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected_inner.v })) && kind_of(mut_view(*cx), (TypeId { v: expected_inner.v })) == TY_SLICE {
            inner_ty_expected.v = 0u32;
        }
        let mut inner_ty = check_expr(mut_view(*cx), in_e, (TypeId { v: inner_ty_expected.v }));
        if is_error(mut_view(*cx), (TypeId { v: inner_ty.v })) { return (TypeId { v: err_v }); }
        if expected_inner.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected_inner.v })) {
            if kind_of(mut_view(*cx), (TypeId { v: inner_ty.v })) == TY_ARRAY && kind_of(mut_view(*cx), (TypeId { v: expected_inner.v })) == TY_SLICE {
                let r_in = resolve_ty(mut_view(*cx), (TypeId { v: inner_ty.v }));
                let it = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_in.v })) };
                let elem_id = TypeId { v: unsafe { (*it).elem.v } };
                let sl_id = unsafe { intern_slice_ty(mut_view((*cx.thir).interner), (TypeId { v: elem_id.v })) };
                inner_ty.v = sl_id.v;
            }
        }
        return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: inner_ty.v }), is_m) };
    }

    if ek == HIR_EXPR_FOR {
        desugar_for(mut_view(*cx), expr as *mut HirExpr);
        return check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_RANGE {
        desugar_range(mut_view(*cx), expr as *mut HirExpr);
        return check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_COMPTIME {
        return (TypeId { v: err_v });
    }
    (TypeId { v: err_v })
}

fn check_expr_closure(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    if true {
        let inner_bytes = mul_usize(128, size_of<SymbolId>());
        let inner_syms = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), inner_bytes, align_of<SymbolId>()) as *mut SymbolId };
        let mut inner_count: usize = 0;
        let mut p: *mut HirParam = unsafe { (*expr).params };
        while ((p as usize) != 0) {
            if inner_count < 128 {
                let dst = unsafe { symid_at(inner_syms, inner_count) };
                unsafe { (*dst).v = (*p).symbol.v; }
                inner_count = inner_count + 1;
            }
            p = unsafe { (*p).next };
        }

        let cap_bytes = mul_usize(64, size_of<RawCapture>());
        let raw_caps = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), cap_bytes, align_of<RawCapture>()) as *mut RawCapture };
        let mut raw_cap_count: usize = 0;
        let cbody: *mut HirExpr = unsafe { (*expr).body };
        scan_expr_captures(mut_view(*cx), cbody, inner_syms, mut_view(inner_count), raw_caps, mut_view(raw_cap_count), false, false);

        let mut caps: *mut ClosureCapture = 0 as *mut ClosureCapture;
        if raw_cap_count > 0 {
            let cbytes = mul_usize(raw_cap_count, size_of<ClosureCapture>());
            caps = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), cbytes, align_of<ClosureCapture>()) as *mut ClosureCapture };
            let mut i: usize = 0;
            while (i < raw_cap_count) {
                let rc = unsafe { rawcap_at(raw_caps, i) };
                let cc = unsafe { capture_at(caps, i) };
                let sym_v = unsafe { (*rc).sym.v };
                let vty = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: sym_v })) };
                let base_ty_v = if vty.v != 0u32 { vty.v } else { i32_v };
                unsafe { (*cc).sym.v = sym_v; }
                if unsafe { (*rc).is_moved } {
                    unsafe {
                        (*cc).mode = CAP_MOVE;
                        (*cc).ty.v = base_ty_v;
                    }
                } else if unsafe { (*rc).is_mutated } {
                    let vt_id = unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: base_ty_v }), true) };
                    unsafe {
                        (*cc).mode = CAP_MUT_VIEW;
                        (*cc).ty.v = vt_id.v;
                    }
                } else {
                    let is_c = if (cx.str_in as usize) != 0 {
                        unsafe { type_is_copy((TypeId { v: base_ty_v }), view(*cx.thir), view(*cx.str_in)) }
                    } else {
                        true
                    };
                    if is_c {
                        unsafe {
                            (*cc).mode = CAP_COPY;
                            (*cc).ty.v = base_ty_v;
                        }
                    } else {
                        let vt_id = unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: base_ty_v }), false) };
                        unsafe {
                            (*cc).mode = CAP_VIEW;
                            (*cc).ty.v = vt_id.v;
                        }
                    }
                }
                i = i + 1;
            }
        }

        let mut param_count: usize = 0;
        p = unsafe { (*expr).params };
        while ((p as usize) != 0) {
            param_count = param_count + 1;
            p = unsafe { (*p).next };
        }

        let mut exp_t: *mut AxType = 0 as *mut AxType;
        if expected.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected.v })) {
            let r_exp = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
            exp_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_exp.v })) };
        }

        let mut closure_param_types: *mut TypeId = 0 as *mut TypeId;
        if param_count > 0 {
            let pbytes = mul_usize(param_count, size_of<TypeId>());
            closure_param_types = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), pbytes, align_of<TypeId>()) as *mut TypeId };
            let mut idx: usize = 0;
            p = unsafe { (*expr).params };
            while ((p as usize) != 0) {
                let mut pty = (TypeId { v: 0u32 });
                let p_ht: *mut HirType = unsafe { (*p).ty };
                if (p_ht as usize) != 0 {
                    let raw_p = hir_type_to_typeid(mut_view(*cx), p_ht);
                    let r_p = resolve_ty(mut_view(*cx), (TypeId { v: raw_p.v }));
                    pty.v = r_p.v;
                } else if (exp_t as usize) != 0 && (unsafe { (*exp_t).kind } == TY_FN || unsafe { (*exp_t).kind } == TY_CLOSURE) && idx < unsafe { (*exp_t).param_count } {
                    let ep_v = unsafe { (*typeid_at((*exp_t).param_types, idx)).v };
                    pty.v = ep_v;
                } else {
                    let iv = new_int_var(mut_view(*cx));
                    pty.v = iv.v;
                }
                let dst = unsafe { typeid_at(closure_param_types, idx) };
                unsafe {
                    (*dst).v = pty.v;
                    thir_set_param_type(mut_view(*cx.thir), p, (TypeId { v: pty.v }));
                    thir_set_symbol_type(mut_view(*cx.thir), (SymbolId { v: (*p).symbol.v }), (TypeId { v: pty.v }));
                }
                idx = idx + 1;
                p = unsafe { (*p).next };
            }
        }

        let mut exp_ret = (TypeId { v: 0u32 });
        let cret_ht: *mut HirType = unsafe { (*expr).ret_type };
        if (cret_ht as usize) != 0 {
            let raw_r = hir_type_to_typeid(mut_view(*cx), cret_ht);
            let r_r = resolve_ty(mut_view(*cx), (TypeId { v: raw_r.v }));
            exp_ret.v = r_r.v;
        } else if (exp_t as usize) != 0 && (unsafe { (*exp_t).kind } == TY_FN || unsafe { (*exp_t).kind } == TY_CLOSURE) {
            exp_ret.v = unsafe { (*exp_t).ret_type.v };
        }

        let old_ret = (TypeId { v: cx.return_type.v });
        let old_vars_len = cx.vars_len;
        cx.return_type.v = exp_ret.v;

        p = unsafe { (*expr).params };
        while ((p as usize) != 0) {
            let psym = unsafe { (*p).symbol };
            let pmut = unsafe { (*p).is_mut };
            push_var_state(mut_view(*cx), (SymbolId { v: psym.v }), pmut, true);
            p = unsafe { (*p).next };
        }

        let mut body_ty = check_expr(mut_view(*cx), cbody, (TypeId { v: exp_ret.v }));
        if body_ty.v == 0u32 { body_ty.v = unit_v; }

        cx.return_type.v = old_ret.v;
        cx.vars_len = old_vars_len;

        return finish_closure_item(
            mut_view(*cx),
            expr,
            cbody,
            caps,
            raw_cap_count,
            closure_param_types,
            param_count,
            (TypeId { v: body_ty.v })
        );
    }
    unsafe { (*cx.thir).interner.t_error }
}

fn finish_closure_item(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    cbody: *mut HirExpr,
    caps: *mut ClosureCapture,
    raw_cap_count: usize,
    closure_param_types: *mut TypeId,
    param_count: usize,
    body_ty: TypeId
) -> TypeId {
    if true {
        let mut p: *mut HirParam = 0 as *mut HirParam;
        let closure_id = cx.next_closure_id;
        cx.next_closure_id = cx.next_closure_id + 1u32;
        let closure_sym = 0x40000000u32 + closure_id;

        let fn_raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirItem>(), align_of<HirItem>()) };
        tc_zero_bytes(fn_raw, size_of<HirItem>());
        let fn_item = fn_raw as *mut HirItem;
        let efv = unsafe { (*expr).span.file.v };
        let est = unsafe { (*expr).span.start };
        let een = unsafe { (*expr).span.end };
        unsafe {
            (*fn_item).kind = HIR_ITEM_FN;
            (*fn_item).span.file.v = efv;
            (*fn_item).span.start = est;
            (*fn_item).span.end = een;
            (*fn_item).symbol.v = closure_sym;
        }

        let mut first_p: *mut HirParam = 0 as *mut HirParam;
        let mut tail_p: *mut HirParam = 0 as *mut HirParam;
        let mut i: usize = 0;
        while (i < raw_cap_count) {
            let cc = unsafe { capture_at(caps, i) };
            let hp_raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirParam>(), align_of<HirParam>()) };
            tc_zero_bytes(hp_raw, size_of<HirParam>());
            let hp = hp_raw as *mut HirParam;
            let c_mode = unsafe { (*cc).mode };
            let c_sym_v = unsafe { (*cc).sym.v };
            let c_ty_v = unsafe { (*cc).ty.v };
            unsafe {
                (*hp).span.file.v = efv;
                (*hp).span.start = est;
                (*hp).span.end = een;
                (*hp).is_mut = c_mode == CAP_MUT_VIEW;
                (*hp).symbol.v = c_sym_v;
                if (first_p as usize) == 0 { first_p = hp; } else { (*tail_p).next = hp; }
                tail_p = hp;
                thir_set_param_type(mut_view(*cx.thir), hp, (TypeId { v: c_ty_v }));
            }
            i = i + 1;
        }
        p = unsafe { (*expr).params };
        while ((p as usize) != 0) {
            let hp_raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirParam>(), align_of<HirParam>()) };
            tc_zero_bytes(hp_raw, size_of<HirParam>());
            let hp = hp_raw as *mut HirParam;
            let pty = unsafe { thir_get_param_type(view(*cx.thir), p) };
            unsafe {
                (*hp).span.file.v = (*p).span.file.v;
                (*hp).span.start = (*p).span.start;
                (*hp).span.end = (*p).span.end;
                (*hp).name.v = (*p).name.v;
                (*hp).symbol.v = (*p).symbol.v;
                (*hp).is_mut = (*p).is_mut;
                if (first_p as usize) == 0 { first_p = hp; } else { (*tail_p).next = hp; }
                tail_p = hp;
                thir_set_param_type(mut_view(*cx.thir), hp, (TypeId { v: pty.v }));
            }
            p = unsafe { (*p).next };
        }
        unsafe { (*fn_item).params = first_p; }

        if (cbody as usize) != 0 && unsafe { (*cbody).kind } == HIR_EXPR_BLOCK {
            let b_ptr: *mut HirBlock = unsafe { (*cbody).block };
            unsafe { (*fn_item).body = b_ptr; }
        } else {
            let bfv = if (cbody as usize) != 0 { unsafe { (*cbody).span.file.v } } else { efv };
            let bst = if (cbody as usize) != 0 { unsafe { (*cbody).span.start } } else { est };
            let ben = if (cbody as usize) != 0 { unsafe { (*cbody).span.end } } else { een };
            let blk = tc_alloc_block(mut_view(*cx), bfv, bst, ben);
            let st = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, bfv, bst, ben);
            unsafe {
                (*st).expr = cbody;
                (*st).has_semi = false;
                (*blk).stmts = st;
                (*fn_item).body = blk;
            }
        }

        let total_fn_params = raw_cap_count + param_count;
        let alloc_cnt = if total_fn_params > 0 { total_fn_params } else { 1 };
        let fn_pbytes = mul_usize(alloc_cnt, size_of<TypeId>());
        let fn_param_types = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), fn_pbytes, align_of<TypeId>()) as *mut TypeId };
        i = 0;
        while (i < raw_cap_count) {
            let cc = unsafe { capture_at(caps, i) };
            let dst = unsafe { typeid_at(fn_param_types, i) };
            unsafe { (*dst).v = (*cc).ty.v; }
            i = i + 1;
        }
        i = 0;
        while (i < param_count) {
            let src = unsafe { typeid_at(closure_param_types, i) };
            let dst = unsafe { typeid_at(fn_param_types, raw_cap_count + i) };
            unsafe { (*dst).v = (*src).v; }
            i = i + 1;
        }

        let fn_type_id = unsafe { intern_fn_ty(mut_view((*cx.thir).interner), false, (StrId { v: 0u32 }), fn_param_types, total_fn_params, (TypeId { v: body_ty.v })) };
        unsafe { thir_set_item_type(mut_view(*cx.thir), fn_item, (TypeId { v: fn_type_id.v })); }

        if (cx.hir as usize) != 0 {
            let mut it: *mut HirItem = unsafe { (*cx.hir).items };
            if (it as usize) == 0 {
                let mut_hir = cx.hir as *mut HirFile;
                unsafe { (*mut_hir).items = fn_item; }
            } else {
                while ((unsafe { (*it).next } as usize) != 0) {
                    it = unsafe { (*it).next };
                }
                unsafe { (*it).next = fn_item; }
            }
        }

        return unsafe { intern_closure_ty(mut_view((*cx.thir).interner), closure_id, closure_sym, (TypeId { v: fn_type_id.v }), (TypeId { v: body_ty.v }), closure_param_types, param_count, caps, raw_cap_count) };
    }
    unsafe { (*cx.thir).interner.t_error }
}

fn check_expr_method_call(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    if true {
        let recv: *mut HirExpr = unsafe { (*expr).receiver };
        let args_head: *mut HirExpr = unsafe { (*expr).args };
        let mut is_type_name = false;
        if (recv as usize) != 0 && unsafe { (*recv).kind } == HIR_EXPR_PATH {
            is_type_name = true;
            let rsym_v = unsafe { (*recv).path.symbol.v };
            if rsym_v != 0u32 {
                let mut k: usize = 0;
                while (k < cx.vars_len) {
                    let vs = unsafe { varstate_at(cx.vars, k) };
                    if unsafe { (*vs).sym.v } == rsym_v {
                        is_type_name = false;
                        break;
                    }
                    k = k + 1;
                }
                if is_type_name && (cx.current_fn as usize) != 0 {
                    let mut p: *mut HirParam = unsafe { (*cx.current_fn).params };
                    while ((p as usize) != 0) {
                        if unsafe { (*p).symbol.v } == rsym_v {
                            is_type_name = false;
                            break;
                        }
                        p = unsafe { (*p).next };
                    }
                }
            }
        }

        let receiver_ty = check_expr(mut_view(*cx), recv, (TypeId { v: 0u32 }));
        if is_error(mut_view(*cx), (TypeId { v: receiver_ty.v })) { return (TypeId { v: err_v }); }

        let mut base_ty = resolve_ty(mut_view(*cx), (TypeId { v: receiver_ty.v }));
        let mut t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        while ((t as usize) != 0 && (unsafe { (*t).kind } == TY_VIEW || unsafe { (*t).kind } == TY_MUT_VIEW || unsafe { (*t).kind } == TY_PTR)) {
            let pt_v = unsafe { (*t).pointee.v };
            let r_pt = resolve_ty(mut_view(*cx), (TypeId { v: pt_v }));
            base_ty.v = r_pt.v;
            t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        }
        if (t as usize) == 0 { return (TypeId { v: err_v }); }

        let mname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*expr).method_name.v })) };
        let mut trait_res: u8 = TRAIT_DISPROVEN;
        let method_item = if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
            unsafe { find_method(view(*cx.hir), view(*cx.thir), (TypeId { v: base_ty.v }), view(mname), view(*cx.str_in), view(*cx.db), mut_view(trait_res)) }
        } else {
            0 as *mut HirItem
        };

        if trait_res == TRAIT_AMBIGUOUS {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TRAIT_AMBIGUOUS_METHOD) };
        }
        if (method_item as usize) == 0 {
            if unsafe { (*t).kind } == TY_ENUM {
                let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let mut vidx: usize = 0;
                let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
                while ((v as usize) != 0) {
                    let vname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
                    if sv_eq(view(vname), view(mname)) {
                        unsafe { ptr_usizemap_insert(mut_view((*cx.thir).expr_variants), expr as usize, vidx); }
                        if unsafe { (*v).is_struct } {
                            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                        }
                        let expected_args = unsafe { *usize_at((*t).variant_field_counts, vidx) };
                        let argc = count_expr_list(args_head);
                        if argc != expected_args {
                            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_ARG_COUNT) };
                        }
                        let payloads = unsafe { *typeid_ptr_at((*t).variant_fields, vidx) };
                        let mut arg_idx: usize = 0;
                        let mut a = args_head;
                        while ((a as usize) != 0) {
                            let pv = unsafe { (*typeid_at(payloads, arg_idx)).v };
                            check_expr(mut_view(*cx), a, (TypeId { v: pv }));
                            arg_idx = arg_idx + 1;
                            a = unsafe { (*a).next };
                        }
                        return (TypeId { v: receiver_ty.v });
                    }
                    vidx = vidx + 1;
                    v = unsafe { (*v).next };
                }
            }
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
        }

        unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, method_item); }
        let mut fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), method_item) };
        let gps: *mut HirGenericParams = unsafe { (*method_item).generic_params };
        if unsafe { (*method_item).kind } == HIR_ITEM_FN && (gps as usize) != 0 {
            let mut param_count: usize = 0;
            let mut p: *mut HirGenericParam = unsafe { (*gps).params };
            while ((p as usize) != 0) {
                param_count = param_count + 1;
                p = unsafe { (*p).next };
            }
            if param_count > 0 {
                let gbytes = mul_usize(param_count, size_of<TypeId>());
                let gargs_arr = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), gbytes, align_of<TypeId>()) as *mut TypeId };
                let mga: *mut HirGenericArgs = unsafe { (*expr).generic_args };
                if (mga as usize) != 0 {
                    let mut ga: *mut HirGenericArg = unsafe { (*mga).args };
                    let mut k: usize = 0;
                    while (k < param_count) {
                        let gid = if (ga as usize) != 0 {
                            let gt: *mut HirType = unsafe { (*ga).ty };
                            hir_type_to_typeid(mut_view(*cx), gt)
                        } else {
                            unsafe { new_ty_var(mut_view(*cx), view((*expr).span)) }
                        };
                        let dst = unsafe { typeid_at(gargs_arr, k) };
                        unsafe { (*dst).v = gid.v; }
                        if (ga as usize) != 0 { ga = unsafe { (*ga).next }; }
                        k = k + 1;
                    }
                } else {
                    let mut k: usize = 0;
                    while (k < param_count) {
                        let gid = unsafe { new_ty_var(mut_view(*cx), view((*expr).span)) };
                        let dst = unsafe { typeid_at(gargs_arr, k) };
                        unsafe { (*dst).v = gid.v; }
                        k = k + 1;
                    }
                }
                let gslice = (GenericArgsSlice { args: gargs_arr, count: param_count });
                let sub_fn = unsafe { subst_ty_with_vars(mut_view((*cx.thir).interner), mut_view(cx.type_vars), (TypeId { v: fn_ty_id.v }), view(gslice)) };
                fn_ty_id.v = sub_fn.v;
            }
        }

        let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
        if (fn_ty as usize) == 0 { return (TypeId { v: err_v }); }
        let expected_args = unsafe { (*fn_ty).param_count };
        let m_params: *mut HirParam = unsafe { (*method_item).params };
        let mut has_self = false;
        if (m_params as usize) != 0 && (cx.str_in as usize) != 0 {
            let pname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*m_params).name.v })) };
            if tc_sv_is_4(view(pname), 115u8, 101u8, 108u8, 102u8) { // self
                has_self = true;
            }
        }

        let pass_receiver = has_self && !is_type_name;
        let argc = (if pass_receiver { 1 } else { 0 }) + count_expr_list(args_head);
        if argc != expected_args {
            let mut a = args_head;
            while ((a as usize) != 0) {
                check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
                a = unsafe { (*a).next };
            }
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_ARG_COUNT) };
        }

        let ptypes = unsafe { (*fn_ty).param_types };
        let ret_v = unsafe { (*fn_ty).ret_type.v };
        let mut i: usize = if pass_receiver { 1 } else { 0 };
        let mut a = args_head;
        while ((a as usize) != 0) {
            let arg_expected_v = unsafe { (*typeid_at(ptypes, i)).v };
            let arg_ty = check_expr(mut_view(*cx), a, (TypeId { v: arg_expected_v }));
            if !is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) && !unify_ty(mut_view(*cx), (TypeId { v: arg_ty.v }), (TypeId { v: arg_expected_v })) {
                unsafe { type_error(mut_view(*cx), view((*a).span), AX_TYPE_MISMATCH); }
            }
            i = i + 1;
            a = unsafe { (*a).next };
        }
        return (TypeId { v: ret_v });
    }
    (TypeId { v: err_v })
}

fn check_expr_try_or_await(cx: mut_view<TypeckCtx>, expr: *const HirExpr, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    if ek == HIR_EXPR_TRY {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let raw_et = check_expr(mut_view(*cx), in_e, (TypeId { v: 0u32 }));
        let expr_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_et.v }));
        if is_error(mut_view(*cx), (TypeId { v: expr_ty.v })) { return (TypeId { v: err_v }); }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: expr_ty.v })) };
        if (t as usize) == 0 || unsafe { (*t).kind } != TY_ENUM {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_OPERAND) };
        }
        let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
        let enum_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*edef).name.v })) };
        let is_opt = tc_sv_is_6(view(enum_name), 79u8, 112u8, 116u8, 105u8, 111u8, 110u8); // Option
        let is_res = tc_sv_is_6(view(enum_name), 82u8, 101u8, 115u8, 117u8, 108u8, 116u8); // Result
        if !is_opt && !is_res {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_OPERAND) };
        }
        if is_error(mut_view(*cx), cx.return_type) { return (TypeId { v: err_v }); }
        let r_ret = resolve_ty(mut_view(*cx), cx.return_type);
        let ret_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_ret.v })) };
        if (ret_t as usize) == 0 || unsafe { (*ret_t).kind } != TY_ENUM {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_RETURN_MISMATCH) };
        }
        let rdef: *mut HirItem = unsafe { (*ret_t).def as *mut HirItem };
        let ret_enum_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*rdef).name.v })) };
        if is_opt && !tc_sv_is_6(view(ret_enum_name), 79u8, 112u8, 116u8, 105u8, 111u8, 110u8) {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_RETURN_MISMATCH) };
        }
        if is_res && !tc_sv_is_6(view(ret_enum_name), 82u8, 101u8, 115u8, 117u8, 108u8, 116u8) {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_RETURN_MISMATCH) };
        }

        let mut payload_var: *mut HirVariantDecl = 0 as *mut HirVariantDecl;
        let mut payload_idx: u32 = 0u32;
        let mut err_idx: u32 = 0u32;
        let mut curr_idx: u32 = 0u32;
        let mut v: *mut HirVariantDecl = unsafe { (*edef).variants };
        while ((v as usize) != 0) {
            let vname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
            let is_payload = if is_opt {
                tc_sv_is_4(view(vname), 83u8, 111u8, 109u8, 101u8) // Some
            } else {
                tc_sv_is_2(view(vname), 79u8, 107u8) // Ok
            };
            if is_payload {
                payload_var = v;
                payload_idx = curr_idx;
            } else {
                err_idx = curr_idx;
            }
            curr_idx = curr_idx + 1u32;
            v = unsafe { (*v).next };
        }
        let ttypes: *mut HirType = if (payload_var as usize) != 0 { unsafe { (*payload_var).tuple_types } } else { 0 as *mut HirType };
        if (payload_var as usize) == 0 || unsafe { (*payload_var).is_struct } || (ttypes as usize) == 0 {
            return (TypeId { v: err_v });
        }
        unsafe {
            ptr_trymap_insert(mut_view((*cx.thir).expr_try_info), expr as usize, is_opt, payload_idx as usize, err_idx as usize);
        }
        let pidx = payload_idx as usize;
        if unsafe { *usize_at((*t).variant_field_counts, pidx) } > 0 {
            let row = unsafe { *typeid_ptr_at((*t).variant_fields, pidx) };
            let pv = unsafe { (*typeid_at(row, 0)).v };
            return (TypeId { v: pv });
        }
        return hir_type_to_typeid(mut_view(*cx), ttypes);
    }

    if ek == HIR_EXPR_AWAIT {
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) };
    }

    (TypeId { v: err_v })
}

pub fn check_expr(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    if (expr as usize) == 0 {
        let uv = unsafe { (*cx.thir).interner.t_unit.v };
        return (TypeId { v: uv });
    }
    let ty = check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
    unsafe {
        thir_set_expr_type(mut_view(*cx.thir), expr, (TypeId { v: ty.v }));
        coerce(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: expected.v }), view((*expr).span))
    }
}

fn check_stmt_assign(cx: mut_view<TypeckCtx>, s: *mut HirStmt) -> bool {
    let r_expr: *mut HirExpr = unsafe { (*s).right };
    let l_expr: *mut HirExpr = unsafe { (*s).left };
    let right = check_expr(mut_view(*cx), r_expr, (TypeId { v: 0u32 }));
    let mut left = (TypeId { v: 0u32 });
    if (l_expr as usize) != 0 && unsafe { (*l_expr).kind } == HIR_EXPR_PATH {
        let mut dummy_gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let lt = unsafe { lookup_path_type(mut_view(*cx), view((*l_expr).path), mut_view(dummy_gargs)) };
        left.v = lt.v;
        unsafe { thir_set_expr_type(mut_view(*cx.thir), l_expr, (TypeId { v: left.v })); }
        let sym_v = unsafe { (*l_expr).path.symbol.v };
        if sym_v != 0u32 {
            let mut i: usize = 0;
            while (i < cx.vars_len) {
                let vs = unsafe { varstate_at(cx.vars, i) };
                if unsafe { (*vs).sym.v } == sym_v {
                    if unsafe { (*vs).is_init && !(*vs).is_mut } {
                        unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                    }
                    unsafe { (*vs).is_init = true; }
                    break;
                }
                i = i + 1;
            }
        }
    } else if (l_expr as usize) != 0 {
        let lt = check_expr(mut_view(*cx), l_expr, (TypeId { v: 0u32 }));
        left.v = lt.v;
        let mut base: *const HirExpr = l_expr;
        let mut dereferenced = false;
        while ((base as usize) != 0) {
            let bk = unsafe { (*base).kind };
            if bk == HIR_EXPR_FIELD {
                let bsub: *mut HirExpr = unsafe { (*base).base };
                let raw_sub = check_expr(mut_view(*cx), bsub, (TypeId { v: 0u32 }));
                let subty = resolve_ty(mut_view(*cx), (TypeId { v: raw_sub.v }));
                let st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: subty.v })) };
                if (st as usize) != 0 {
                    let stk = unsafe { (*st).kind };
                    if stk == TY_PTR {
                        if !unsafe { (*st).is_mut } {
                            unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                        }
                        dereferenced = true;
                        break;
                    } else if stk == TY_VIEW {
                        unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                        dereferenced = true;
                        break;
                    } else if stk == TY_MUT_VIEW {
                        dereferenced = true;
                        break;
                    }
                }
                base = bsub;
            } else if bk == HIR_EXPR_UNARY && unsafe { (*base).op } == UNOP_DEREF {
                let u_in: *mut HirExpr = unsafe { (*base).inner };
                let raw_sub = check_expr(mut_view(*cx), u_in, (TypeId { v: 0u32 }));
                let subty = resolve_ty(mut_view(*cx), (TypeId { v: raw_sub.v }));
                let st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: subty.v })) };
                if (st as usize) != 0 {
                    let stk = unsafe { (*st).kind };
                    if stk == TY_PTR {
                        if !unsafe { (*st).is_mut } {
                            unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                        }
                    } else if stk == TY_VIEW {
                        unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                    }
                }
                dereferenced = true;
                break;
            } else if bk == HIR_EXPR_TUPLE_INDEX {
                base = unsafe { (*base).base };
            } else {
                break;
            }
        }
        if !dereferenced && (base as usize) != 0 && unsafe { (*base).kind } == HIR_EXPR_PATH {
            let sym_v = unsafe { (*base).path.symbol.v };
            if sym_v != 0u32 {
                let mut i: usize = 0;
                while (i < cx.vars_len) {
                    let vs = unsafe { varstate_at(cx.vars, i) };
                    if unsafe { (*vs).sym.v } == sym_v {
                        if unsafe { (*vs).is_init && !(*vs).is_mut } {
                            unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                        }
                        break;
                    }
                    i = i + 1;
                }
            }
        }
    }
    if (r_expr as usize) != 0 {
        unsafe { coerce(mut_view(*cx), (TypeId { v: right.v }), (TypeId { v: left.v }), view((*r_expr).span)); }
    }
    is_never(mut_view(*cx), (TypeId { v: right.v }))
}

pub fn check_block(cx: mut_view<TypeckCtx>, block: *const HirBlock, expected: TypeId) -> TypeId {
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    if (block as usize) == 0 { return (TypeId { v: unit_v }); }

    let mut ty = (TypeId { v: unit_v });
    let mut tail: *const HirExpr = 0 as *const HirExpr;
    let mut diverges = false;
    let mut reported_unreachable = false;

    let mut s: *mut HirStmt = unsafe { (*block).stmts };
    while ((s as usize) != 0) {
        if diverges && !reported_unreachable {
            if (cx.sink as usize) != 0 {
                let sfv = unsafe { (*s).span.file.v };
                let sst = unsafe { (*s).span.start };
                let sen = unsafe { (*s).span.end };
                unsafe { report_typeck_diag(mut_view(*cx.sink), AX_TYPE_UNREACHABLE, sfv, sst, sen); }
            }
            reported_unreachable = true;
        }
        tail = 0 as *const HirExpr;
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let lelse: *mut HirBlock = unsafe { (*s).else_block };
            if (lelse as usize) != 0 {
                desugar_let_else(mut_view(*cx), s);
                let sexpr: *mut HirExpr = unsafe { (*s).expr };
                let ety = check_expr(mut_view(*cx), sexpr, (TypeId { v: 0u32 }));
                if is_never(mut_view(*cx), (TypeId { v: ety.v })) { diverges = true; }
                if unsafe { (*s).has_semi } {
                    ty.v = unit_v;
                } else {
                    ty.v = ety.v;
                    tail = sexpr;
                }
                s = unsafe { (*s).next };
                continue;
            }
            let sty_ptr: *mut HirType = unsafe { (*s).ty };
            let mut declared = hir_type_to_typeid(mut_view(*cx), sty_ptr);
            let mut is_init = false;
            let sexpr: *mut HirExpr = unsafe { (*s).expr };
            let spat: *mut HirPat = unsafe { (*s).pat };
            if (sexpr as usize) != 0 {
                let init = check_expr(mut_view(*cx), sexpr, (TypeId { v: declared.v }));
                if is_never(mut_view(*cx), (TypeId { v: init.v })) { diverges = true; }
                if declared.v == 0u32 { declared.v = init.v; }
                is_init = true;
            } else if declared.v == 0u32 {
                if (spat as usize) != 0 {
                    unsafe { type_error(mut_view(*cx), view((*spat).span), AX_TYPE_UNKNOWN); }
                } else {
                    unsafe { type_error(mut_view(*cx), view((*s).span), AX_TYPE_UNKNOWN); }
                }
                declared.v = err_v;
            }
            if !is_pat_irrefutable(mut_view(*cx), spat, (TypeId { v: declared.v })) {
                if (spat as usize) != 0 {
                    unsafe { type_error(mut_view(*cx), view((*spat).span), AX_PAT_REFUTABLE); }
                } else {
                    unsafe { type_error(mut_view(*cx), view((*s).span), AX_PAT_REFUTABLE); }
                }
            }
            check_pat(mut_view(*cx), spat, (TypeId { v: declared.v }), is_init);
            ty.v = unit_v;
        } else if sk == HIR_STMT_ASSIGN {
            if check_stmt_assign(mut_view(*cx), s) { diverges = true; }
            ty.v = unit_v;
        } else if sk == HIR_STMT_EXPR {
            let sexpr: *mut HirExpr = unsafe { (*s).expr };
            let ety = check_expr(mut_view(*cx), sexpr, (TypeId { v: 0u32 }));
            if is_never(mut_view(*cx), (TypeId { v: ety.v })) { diverges = true; }
            if unsafe { (*s).has_semi } {
                ty.v = unit_v;
            } else {
                ty.v = ety.v;
                tail = sexpr;
            }
        } else {
            ty.v = unit_v;
        }
        s = unsafe { (*s).next };
    }

    if diverges {
        ty.v = never_v;
    }

    if expected.v != 0u32 && !unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: expected.v })) {
        let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        if r_ty.v == unit_v {
            return unsafe { type_error(mut_view(*cx), view((*block).span), AX_TYPE_RETURN) };
        }
        if (tail as usize) != 0 {
            return unsafe { type_error(mut_view(*cx), view((*tail).span), AX_TYPE_MISMATCH) };
        }
        return unsafe { type_error(mut_view(*cx), view((*block).span), AX_TYPE_MISMATCH) };
    }

    ty
}

const SLOT_OCCUPIED: u8 = 1u8;

unsafe fn tc_subst_at(base: *mut GenericArgsSlice, idx: usize) -> *mut GenericArgsSlice {
    let off = mul_usize(idx, size_of<GenericArgsSlice>());
    ((base as usize) + off) as *mut GenericArgsSlice
}

fn find_item_by_symbol(cx: view<TypeckCtx>, sym: SymbolId) -> *const HirItem {
    if (cx.hir as usize) == 0 || sym.v == 0u32 {
        return 0 as *const HirItem;
    }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((it as usize) != 0) {
        if (unsafe { (*it).symbol.v }) == sym.v {
            return it;
        }
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_EXTERN_BLOCK || ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while ((m as usize) != 0) {
                if (unsafe { (*m).symbol.v }) == sym.v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *const HirItem
}

fn type_contains_view(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let r_id = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_id.v })) };
    if (t as usize) == 0 {
        return false;
    }
    let k = unsafe { (*t).kind };
    if k == TY_VIEW || k == TY_MUT_VIEW {
        return true;
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let fcnt = unsafe { (*t).field_count };
        let flds: *mut TypeId = unsafe { (*t).fields };
        let mut i: usize = 0;
        while (i < fcnt) {
            let ft_v = unsafe { (*typeid_at(flds, i)).v };
            if type_contains_view(mut_view(*cx), (TypeId { v: ft_v })) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if k == TY_ARRAY || k == TY_SLICE {
        let el_v = unsafe { (*t).elem.v };
        return type_contains_view(mut_view(*cx), (TypeId { v: el_v }));
    }
    if k == TY_ENUM {
        let vcnt = unsafe { (*t).variant_count };
        let vf_arr: *mut *mut TypeId = unsafe { (*t).variant_fields };
        let vfc_arr: *mut usize = unsafe { (*t).variant_field_counts };
        if (vf_arr as usize) == 0 || (vfc_arr as usize) == 0 {
            return false;
        }
        let mut v: usize = 0;
        while (v < vcnt) {
            let fc = unsafe { *usize_at(vfc_arr, v) };
            let vf = unsafe { *typeid_ptr_at(vf_arr, v) };
            let mut f: usize = 0;
            while (f < fc) {
                let ft_v = unsafe { (*typeid_at(vf, f)).v };
                if type_contains_view(mut_view(*cx), (TypeId { v: ft_v })) {
                    return true;
                }
                f = f + 1;
            }
            v = v + 1;
        }
        return false;
    }
    false
}

fn check_main_signature(cx: mut_view<TypeckCtx>, fn_item: *const HirItem) {
    if (cx.str_in as usize) == 0 || (fn_item as usize) == 0 {
        return;
    }
    let name_id = unsafe { (*fn_item).name };
    if name_id.v == 0u32 {
        return;
    }
    let sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: name_id.v })) };
    if !tc_sv_is_4(view(sv), 109u8, 97u8, 105u8, 110u8) {
        return;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_item).generic_params };
    let has_gp = if (gps as usize) != 0 {
        let gp_list: *mut HirGenericParam = unsafe { (*gps).params };
        (gp_list as usize) != 0
    } else {
        false
    };
    let prms: *mut HirParam = unsafe { (*fn_item).params };
    if has_gp || (prms as usize) != 0 {
        let _ = unsafe { type_error(mut_view(*cx), view((*fn_item).span), AX_TYPE_MAIN_SIGNATURE) };
        return;
    }
    let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), fn_item) };
    if fn_ty_id.v != 0u32 {
        let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
        if (fn_ty as usize) != 0 && (unsafe { (*fn_ty).kind }) == TY_FN {
            let ret_v = unsafe { (*fn_ty).ret_type.v };
            let ret_id = resolve_ty(mut_view(*cx), (TypeId { v: ret_v }));
            let rk = kind_of(mut_view(*cx), (TypeId { v: ret_id.v }));
            if rk != TY_UNIT && rk != TY_I32 && rk != TY_ERROR {
                let _ = unsafe { type_error(mut_view(*cx), view((*fn_item).span), AX_TYPE_MAIN_SIGNATURE) };
            }
        }
    }
}

fn resolve_deep_ty(cx: mut_view<TypeckCtx>, id: TypeId) -> TypeId {
    if id.v == 0u32 {
        return (TypeId { v: 0u32 });
    }
    let r_id = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_id.v })) };
    if (t as usize) == 0 {
        return (TypeId { v: r_id.v });
    }
    let k = unsafe { (*t).kind };
    if k == TY_PTR || k == TY_VIEW || k == TY_MUT_VIEW {
        let old_pt_v = unsafe { (*t).pointee.v };
        let new_pt = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_pt_v }));
        if new_pt.v == old_pt_v {
            return (TypeId { v: r_id.v });
        }
        if k == TY_PTR {
            let is_m = unsafe { (*t).is_mut };
            return unsafe { intern_ptr_ty(mut_view((*cx.thir).interner), (TypeId { v: new_pt.v }), is_m) };
        }
        if k == TY_VIEW {
            return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: new_pt.v }), false) };
        }
        return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: new_pt.v }), true) };
    }
    if k == TY_SLICE || k == TY_ARRAY {
        let old_el_v = unsafe { (*t).elem.v };
        let new_el = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_el_v }));
        if new_el.v == old_el_v {
            return (TypeId { v: r_id.v });
        }
        if k == TY_SLICE {
            return unsafe { intern_slice_ty(mut_view((*cx.thir).interner), (TypeId { v: new_el.v })) };
        }
        let alen = unsafe { (*t).array_len };
        return unsafe { intern_array_ty(mut_view((*cx.thir).interner), (TypeId { v: new_el.v }), alen) };
    }
    if k == TY_TUPLE {
        let cnt = unsafe { (*t).field_count };
        if cnt == 0 {
            return (TypeId { v: r_id.v });
        }
        let old_flds: *mut TypeId = unsafe { (*t).fields };
        let mut changed = false;
        let mut i: usize = 0;
        while (i < cnt) {
            let old_e_v = unsafe { (*typeid_at(old_flds, i)).v };
            let new_e = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_e_v }));
            if new_e.v != old_e_v {
                changed = true;
            }
            i = i + 1;
        }
        if !changed {
            return (TypeId { v: r_id.v });
        }
        let bytes = mul_usize(cnt, size_of<TypeId>());
        let new_flds = unsafe {
            arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId
        };
        i = 0;
        while (i < cnt) {
            let old_e_v = unsafe { (*typeid_at(old_flds, i)).v };
            let new_e = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_e_v }));
            let dst = unsafe { typeid_at(new_flds, i) };
            unsafe { (*dst).v = new_e.v; }
            i = i + 1;
        }
        return unsafe { intern_tuple_ty(mut_view((*cx.thir).interner), new_flds, cnt) };
    }
    if k == TY_FN {
        let cnt = unsafe { (*t).param_count };
        let old_params: *mut TypeId = unsafe { (*t).param_types };
        let old_ret_v = unsafe { (*t).ret_type.v };
        let new_ret = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_ret_v }));
        let mut changed = new_ret.v != old_ret_v;
        let mut i: usize = 0;
        while (i < cnt) {
            let old_p_v = unsafe { (*typeid_at(old_params, i)).v };
            let new_p = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_p_v }));
            if new_p.v != old_p_v {
                changed = true;
            }
            i = i + 1;
        }
        if !changed {
            return (TypeId { v: r_id.v });
        }
        let mut new_params: *mut TypeId = 0 as *mut TypeId;
        if cnt > 0 {
            let bytes = mul_usize(cnt, size_of<TypeId>());
            new_params = unsafe {
                arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId
            };
        }
        i = 0;
        while (i < cnt) {
            let old_p_v = unsafe { (*typeid_at(old_params, i)).v };
            let new_p = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_p_v }));
            let dst = unsafe { typeid_at(new_params, i) };
            unsafe { (*dst).v = new_p.v; }
            i = i + 1;
        }
        let is_u = unsafe { (*t).is_unsafe };
        let abi_v = unsafe { (*t).abi.v };
        let def_p: *const HirItem = unsafe { (*t).def };
        return unsafe {
            intern_fn_ty_full(
                mut_view((*cx.thir).interner),
                is_u,
                (StrId { v: abi_v }),
                new_params,
                cnt,
                (TypeId { v: new_ret.v }),
                def_p
            )
        };
    }
    if k == TY_CLOSURE {
        let pcnt = unsafe { (*t).param_count };
        let old_params: *mut TypeId = unsafe { (*t).param_types };
        let mut i: usize = 0;
        while (i < pcnt) {
            let dst = unsafe { typeid_at(old_params, i) };
            let old_p_v = unsafe { (*dst).v };
            let new_p = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_p_v }));
            unsafe { (*dst).v = new_p.v; }
            i = i + 1;
        }
        let old_ret_v = unsafe { (*t).ret_type.v };
        let new_ret = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_ret_v }));
        unsafe { (*t).ret_type.v = new_ret.v; }
        let old_fn_v = unsafe { (*t).fn_type.v };
        let new_fn = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_fn_v }));
        unsafe { (*t).fn_type.v = new_fn.v; }
        let ccnt = unsafe { (*t).capture_count };
        let caps: *mut ClosureCapture = unsafe { (*t).captures };
        i = 0;
        while (i < ccnt) {
            let cap_ptr = unsafe { capture_at(caps, i) };
            let old_ct_v = unsafe { (*cap_ptr).ty.v };
            let new_ct = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_ct_v }));
            unsafe { (*cap_ptr).ty.v = new_ct.v; }
            i = i + 1;
        }
        return (TypeId { v: r_id.v });
    }
    if k == TY_STRUCT || k == TY_ENUM {
        return resolve_deep_adt_ty(mut_view(*cx), r_id, t, k);
    }
    r_id
}

fn resolve_deep_adt_ty(cx: mut_view<TypeckCtx>, r_id: TypeId, t: *mut AxType, k: u8) -> TypeId {
    if k == TY_STRUCT {
        let acnt = unsafe { (*t).arg_count };
        let old_args: *mut TypeId = unsafe { (*t).args };
        let mut changed = false;
        let mut i: usize = 0;
        while (i < acnt) {
            let old_a_v = unsafe { (*typeid_at(old_args, i)).v };
            let new_a = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_a_v }));
            if new_a.v != old_a_v {
                changed = true;
            }
            i = i + 1;
        }
        if !changed {
            return (TypeId { v: r_id.v });
        }
        let abytes = mul_usize(acnt, size_of<TypeId>());
        let new_args = unsafe {
            arena_alloc_raw(mut_view((*cx.thir).interner.arena), abytes, align_of<TypeId>()) as *mut TypeId
        };
        i = 0;
        while (i < acnt) {
            let old_a_v = unsafe { (*typeid_at(old_args, i)).v };
            let new_a = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_a_v }));
            let dst = unsafe { typeid_at(new_args, i) };
            unsafe { (*dst).v = new_a.v; }
            i = i + 1;
        }
        let fcnt = unsafe { (*t).field_count };
        let old_flds: *mut TypeId = unsafe { (*t).fields };
        let mut new_flds: *mut TypeId = 0 as *mut TypeId;
        if fcnt > 0 {
            let fbytes = mul_usize(fcnt, size_of<TypeId>());
            new_flds = unsafe {
                arena_alloc_raw(mut_view((*cx.thir).interner.arena), fbytes, align_of<TypeId>()) as *mut TypeId
            };
            i = 0;
            while (i < fcnt) {
                let old_f_v = unsafe { (*typeid_at(old_flds, i)).v };
                let new_f = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_f_v }));
                let dst = unsafe { typeid_at(new_flds, i) };
                unsafe { (*dst).v = new_f.v; }
                i = i + 1;
            }
        }
        let is_rc = unsafe { (*t).is_repr_c };
        let def_p: *const HirItem = unsafe { (*t).def };
        return unsafe {
            intern_struct_ty(mut_view((*cx.thir).interner), is_rc, def_p, new_flds, fcnt, new_args, acnt)
        };
    }
    if k == TY_ENUM {
        let acnt = unsafe { (*t).arg_count };
        let old_args: *mut TypeId = unsafe { (*t).args };
        let mut changed = false;
        let mut i: usize = 0;
        while (i < acnt) {
            let old_a_v = unsafe { (*typeid_at(old_args, i)).v };
            let new_a = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_a_v }));
            if new_a.v != old_a_v {
                changed = true;
            }
            i = i + 1;
        }
        if !changed {
            return (TypeId { v: r_id.v });
        }
        let abytes = mul_usize(acnt, size_of<TypeId>());
        let new_args = unsafe {
            arena_alloc_raw(mut_view((*cx.thir).interner.arena), abytes, align_of<TypeId>()) as *mut TypeId
        };
        i = 0;
        while (i < acnt) {
            let old_a_v = unsafe { (*typeid_at(old_args, i)).v };
            let new_a = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_a_v }));
            let dst = unsafe { typeid_at(new_args, i) };
            unsafe { (*dst).v = new_a.v; }
            i = i + 1;
        }
        let vcnt = unsafe { (*t).variant_count };
        let old_vf: *mut *mut TypeId = unsafe { (*t).variant_fields };
        let vfc: *mut usize = unsafe { (*t).variant_field_counts };
        let mut new_vf: *mut *mut TypeId = 0 as *mut *mut TypeId;
        if vcnt > 0 && (old_vf as usize) != 0 && (vfc as usize) != 0 {
            let vbytes = mul_usize(vcnt, size_of<*mut TypeId>());
            new_vf = unsafe {
                arena_alloc_raw(mut_view((*cx.thir).interner.arena), vbytes, align_of<*mut TypeId>()) as *mut *mut TypeId
            };
            let mut v: usize = 0;
            while (v < vcnt) {
                let fc = unsafe { *usize_at(vfc, v) };
                let ov = unsafe { *typeid_ptr_at(old_vf, v) };
                let vslot = unsafe { typeid_ptr_at(new_vf, v) };
                if fc > 0 && (ov as usize) != 0 {
                    let fbytes = mul_usize(fc, size_of<TypeId>());
                    let nv = unsafe {
                        arena_alloc_raw(mut_view((*cx.thir).interner.arena), fbytes, align_of<TypeId>()) as *mut TypeId
                    };
                    let mut f: usize = 0;
                    while (f < fc) {
                        let old_f_v = unsafe { (*typeid_at(ov, f)).v };
                        let new_f = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_f_v }));
                        let fdst = unsafe { typeid_at(nv, f) };
                        unsafe { (*fdst).v = new_f.v; }
                        f = f + 1;
                    }
                    unsafe { *vslot = nv; }
                } else {
                    unsafe { *vslot = 0 as *mut TypeId; }
                }
                v = v + 1;
            }
        }
        let def_p: *const HirItem = unsafe { (*t).def };
        return unsafe {
            intern_enum_ty(mut_view((*cx.thir).interner), def_p, new_args, acnt, new_vf, vfc, vcnt)
        };
    }
    r_id
}

fn finalize_ptr_typemap(cx: mut_view<TypeckCtx>, m: mut_view<PtrTypeMap>) {
    let cap = m.cap;
    let states = m.states;
    let vals = m.vals;
    let mut i: usize = 0;
    while (i < cap) {
        if (unsafe { *(states + i) }) == SLOT_OCCUPIED {
            let vp = unsafe { typeid_at(vals, i) };
            let old_v = unsafe { (*vp).v };
            let new_t = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
            unsafe { (*vp).v = new_t.v; }
        }
        i = i + 1;
    }
}

fn finalize_sym_typemap(cx: mut_view<TypeckCtx>, m: mut_view<SymTypeMap>) {
    let cap = m.cap;
    let states = m.states;
    let vals = m.vals;
    let mut i: usize = 0;
    while (i < cap) {
        if (unsafe { *(states + i) }) == SLOT_OCCUPIED {
            let vp = unsafe { typeid_at(vals, i) };
            let old_v = unsafe { (*vp).v };
            let new_t = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
            unsafe { (*vp).v = new_t.v; }
        }
        i = i + 1;
    }
}

fn finalize_ptr_substmap(cx: mut_view<TypeckCtx>, m: mut_view<PtrSubstMap>) {
    let cap = m.cap;
    let states = m.states;
    let vals = m.vals;
    let mut i: usize = 0;
    while (i < cap) {
        if (unsafe { *(states + i) }) == SLOT_OCCUPIED {
            let sp = unsafe { tc_subst_at(vals, i) };
            let cnt = unsafe { (*sp).count };
            let args: *mut TypeId = unsafe { (*sp).args };
            let mut j: usize = 0;
            while (j < cnt) {
                let ap = unsafe { typeid_at(args, j) };
                let old_v = unsafe { (*ap).v };
                let new_t = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                unsafe { (*ap).v = new_t.v; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

fn finalize_types(cx: mut_view<TypeckCtx>) {
    let thir_ptr = cx.thir;
    unsafe {
        finalize_ptr_typemap(mut_view(*cx), mut_view((*thir_ptr).expr_types));
        finalize_ptr_typemap(mut_view(*cx), mut_view((*thir_ptr).pat_types));
        finalize_ptr_typemap(mut_view(*cx), mut_view((*thir_ptr).item_types));
        finalize_ptr_typemap(mut_view(*cx), mut_view((*thir_ptr).param_types));
        finalize_sym_typemap(mut_view(*cx), mut_view((*thir_ptr).symbol_types));
        finalize_ptr_substmap(mut_view(*cx), mut_view((*thir_ptr).expr_substs));
        finalize_ptr_substmap(mut_view(*cx), mut_view((*thir_ptr).pat_substs));
    }
    let mut i: usize = 1;
    while (i < (unsafe { (*thir_ptr).interner.len })) {
        let _ = resolve_deep_ty(mut_view(*cx), (TypeId { v: i as u32 }));
        i = i + 1;
    }
}

fn check_all_bounds(cx: mut_view<TypeckCtx>) {
    if (cx.hir as usize) == 0 || (cx.sink as usize) == 0 || (cx.str_in as usize) == 0 || (cx.db as usize) == 0 {
        return;
    }
    let ecap = unsafe { (*cx.thir).expr_substs.cap };
    let estates = unsafe { (*cx.thir).expr_substs.states };
    let ekeys = unsafe { (*cx.thir).expr_substs.keys };
    let evals = unsafe { (*cx.thir).expr_substs.vals };
    let mut i: usize = 0;
    while (i < ecap) {
        if (unsafe { *(estates + i) }) == SLOT_OCCUPIED {
            let ex_addr = unsafe { *usize_at(ekeys, i) };
            let ex = ex_addr as *const HirExpr;
            let args_ptr = unsafe { tc_subst_at(evals, i) };
            let acnt = unsafe { (*args_ptr).count };
            if (ex as usize) != 0 && acnt > 0 {
                let mut def: *const HirItem = 0 as *const HirItem;
                let ek = unsafe { (*ex).kind };
                if ek == HIR_EXPR_METHOD_CALL {
                    let mp = unsafe { thir_get_expr_method(view(*cx.thir), ex) };
                    if (mp as usize) != 0 {
                        def = unsafe { *mp };
                    }
                } else if ek == HIR_EXPR_CALL {
                    let callee: *mut HirExpr = unsafe { (*ex).callee };
                    if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
                        let csym_v = unsafe { (*callee).path.symbol.v };
                        def = find_item_by_symbol(view(*cx), (SymbolId { v: csym_v }));
                    }
                } else if ek == HIR_EXPR_PATH || ek == HIR_EXPR_STRUCT {
                    let esym_v = unsafe { (*ex).path.symbol.v };
                    def = find_item_by_symbol(view(*cx), (SymbolId { v: esym_v }));
                }
                if (def as usize) != 0 {
                    let sp_f = unsafe { (*ex).span.file.v };
                    let sp_s = unsafe { (*ex).span.start };
                    let sp_e = unsafe { (*ex).span.end };
                    let _ = unsafe {
                        check_item_bounds(
                            view(*cx.hir),
                            view(*cx.thir),
                            def,
                            view(*args_ptr),
                            Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e },
                            view(*cx.str_in),
                            view(*cx.db),
                            mut_view(*cx.sink)
                        )
                    };
                }
            }
        }
        i = i + 1;
    }

    let pcap = unsafe { (*cx.thir).pat_substs.cap };
    let pstates = unsafe { (*cx.thir).pat_substs.states };
    let pkeys = unsafe { (*cx.thir).pat_substs.keys };
    let pvals = unsafe { (*cx.thir).pat_substs.vals };
    i = 0;
    while (i < pcap) {
        if (unsafe { *(pstates + i) }) == SLOT_OCCUPIED {
            let pat_addr = unsafe { *usize_at(pkeys, i) };
            let pat = pat_addr as *const HirPat;
            let args_ptr = unsafe { tc_subst_at(pvals, i) };
            let acnt = unsafe { (*args_ptr).count };
            if (pat as usize) != 0 && acnt > 0 {
                let mut def: *const HirItem = 0 as *const HirItem;
                let pk = unsafe { (*pat).kind };
                if pk == HIR_PAT_PATH || pk == HIR_PAT_STRUCT {
                    let psym_v = unsafe { (*pat).path.symbol.v };
                    def = find_item_by_symbol(view(*cx), (SymbolId { v: psym_v }));
                }
                if (def as usize) != 0 {
                    let sp_f = unsafe { (*pat).span.file.v };
                    let sp_s = unsafe { (*pat).span.start };
                    let sp_e = unsafe { (*pat).span.end };
                    let _ = unsafe {
                        check_item_bounds(
                            view(*cx.hir),
                            view(*cx.thir),
                            def,
                            view(*args_ptr),
                            Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e },
                            view(*cx.str_in),
                            view(*cx.db),
                            mut_view(*cx.sink)
                        )
                    };
                }
            }
        }
        i = i + 1;
    }
}

fn build_item_generic_param_args(cx: mut_view<TypeckCtx>, it: *const HirItem, out_count: mut_view<usize>) -> *mut TypeId {
    *out_count = 0;
    if (it as usize) == 0 {
        return 0 as *mut TypeId;
    }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    if (gps as usize) == 0 {
        return 0 as *mut TypeId;
    }
    let mut cnt: usize = 0;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while ((gp as usize) != 0) {
        cnt = cnt + 1;
        gp = unsafe { (*gp).next };
    }
    if cnt == 0 {
        return 0 as *mut TypeId;
    }
    let bytes = mul_usize(cnt, size_of<TypeId>());
    let args = unsafe {
        arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId
    };
    let mut idx: usize = 0;
    gp = unsafe { (*gps).params };
    while ((gp as usize) != 0) {
        let mut p_name = unsafe { (*gp).name };
        if p_name.v == 0u32 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
            let sp_f = unsafe { (*gp).span.file.v };
            if sp_f != 0u32 {
                let sp_s = unsafe { (*gp).span.start };
                let sp_e = unsafe { (*gp).span.end };
                let sv = unsafe {
                    source_db_span_text(view(*cx.db), Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e })
                };
                if sv.len > 0 && (sv.ptr as usize) != 0 {
                    p_name = unsafe { interner_intern_bytes(mut_view(*cx.str_in), sv.ptr, sv.len) };
                }
            }
        }
        let pid = unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: p_name.v }), idx as u32) };
        let dst = unsafe { typeid_at(args, idx) };
        unsafe { (*dst).v = pid.v; }
        idx = idx + 1;
        gp = unsafe { (*gp).next };
    }
    *out_count = cnt;
    args
}

fn item_has_repr_c(cx: view<TypeckCtx>, it: *const HirItem) -> bool {
    if (it as usize) == 0 || (cx.str_in as usize) == 0 {
        return false;
    }
    let mut a: *mut HirAttr = unsafe { (*it).attrs };
    while ((a as usize) != 0) {
        let aname_id = unsafe { (*a).name };
        if aname_id.v != 0u32 {
            let asv = unsafe { interner_get(view(*cx.str_in), (StrId { v: aname_id.v })) };
            if tc_sv_is_4(view(asv), 114u8, 101u8, 112u8, 114u8) {
                let mut arg: *mut HirAttrArg = unsafe { (*a).args };
                while ((arg as usize) != 0) {
                    let arg_name_id = unsafe { (*arg).name };
                    if arg_name_id.v != 0u32 {
                        let arg_sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: arg_name_id.v })) };
                        if tc_sv_is_1(view(arg_sv), 99u8) || tc_sv_is_1(view(arg_sv), 67u8) {
                            return true;
                        }
                    }
                    let aex: *mut HirExpr = unsafe { (*arg).expr };
                    if (aex as usize) != 0 && (unsafe { (*aex).kind }) == HIR_EXPR_PATH {
                        let p_sv = unsafe { tc_path_name_sv(cx, view((*aex).path)) };
                        if tc_sv_is_1(view(p_sv), 99u8) || tc_sv_is_1(view(p_sv), 67u8) {
                            return true;
                        }
                    }
                    arg = unsafe { (*arg).next };
                }
            }
        }
        a = unsafe { (*a).next };
    }
    false
}

fn find_orig_impl_member(hir_file: view<HirFile>, top_fn: *const HirItem) -> *mut HirItem {
    if (top_fn as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let sym_v = unsafe { (*top_fn).symbol.v };
    if sym_v == 0u32 {
        return 0 as *mut HirItem;
    }
    let mut other: *mut HirItem = hir_file.items;
    while ((other as usize) != 0) {
        if (unsafe { (*other).kind }) == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*other).members };
            while ((m as usize) != 0) {
                if (m as usize) != (top_fn as usize) &&
                   (unsafe { (*m).kind }) == HIR_ITEM_FN &&
                   (unsafe { (*m).symbol.v }) == sym_v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        other = unsafe { (*other).next };
    }
    0 as *mut HirItem
}

fn register_item_sig(cx: mut_view<TypeckCtx>, it: *mut HirItem, parent_impl: *const HirItem) {
    if (it as usize) == 0 {
        return;
    }
    let ik = unsafe { (*it).kind };
    if ik == HIR_ITEM_FN {
        cx.current_fn = it;
        cx.current_impl = parent_impl;
        if (parent_impl as usize) != 0 {
            let pk = unsafe { (*parent_impl).kind };
            if pk == HIR_ITEM_IMPL {
                let st_ptr: *mut HirType = unsafe { (*parent_impl).self_type };
                let st = hir_type_to_typeid(mut_view(*cx), st_ptr);
                cx.self_ty.v = st.v;
            } else if pk == HIR_ITEM_TRAIT {
                if (cx.str_in as usize) != 0 {
                    let self_sid = unsafe { tc_intern_idx(mut_view(*cx.str_in), 30) };
                    let st = unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: self_sid.v }), 0xFFFFu32) };
                    cx.self_ty.v = st.v;
                } else {
                    cx.self_ty.v = 0u32;
                }
            } else {
                cx.self_ty.v = 0u32;
            }
        } else {
            cx.self_ty.v = 0u32;
        }

        let mut p_count: usize = 0;
        let mut p: *mut HirParam = unsafe { (*it).params };
        while ((p as usize) != 0) {
            p_count = p_count + 1;
            p = unsafe { (*p).next };
        }
        let mut p_types: *mut TypeId = 0 as *mut TypeId;
        if p_count > 0 {
            let bytes = mul_usize(p_count, size_of<TypeId>());
            p_types = unsafe {
                arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId
            };
        }
        let mut idx: usize = 0;
        p = unsafe { (*it).params };
        while ((p as usize) != 0) {
            let p_ty_node: *mut HirType = unsafe { (*p).ty };
            let mut pt = (TypeId { v: 0u32 });
            if (p_ty_node as usize) == 0 && idx == 0 && (cx.current_impl as usize) != 0 {
                pt.v = cx.self_ty.v;
            } else {
                let h_pt = hir_type_to_typeid(mut_view(*cx), p_ty_node);
                pt.v = h_pt.v;
            }
            let dst = unsafe { typeid_at(p_types, idx) };
            unsafe { (*dst).v = pt.v; }
            unsafe { thir_set_param_type(mut_view(*cx.thir), p, (TypeId { v: pt.v })); }
            let psym = unsafe { (*p).symbol };
            if psym.v != 0u32 {
                unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: psym.v }), (TypeId { v: pt.v })); }
            }
            idx = idx + 1;
            p = unsafe { (*p).next };
        }
        let ret_node: *mut HirType = unsafe { (*it).ret_type };
        let ret_ty = if (ret_node as usize) != 0 {
            hir_type_to_typeid(mut_view(*cx), ret_node)
        } else {
            let uv = unsafe { (*cx.thir).interner.t_unit.v };
            (TypeId { v: uv })
        };
        let is_u = unsafe { (*it).is_unsafe };
        let abi_v = unsafe { (*it).abi.v };
        let fn_ty = unsafe {
            intern_fn_ty_full(
                mut_view((*cx.thir).interner),
                is_u,
                (StrId { v: abi_v }),
                p_types,
                p_count,
                (TypeId { v: ret_ty.v }),
                it
            )
        };
        unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: fn_ty.v })); }
        let isym = unsafe { (*it).symbol };
        if isym.v != 0u32 && (unsafe { (*it).generic_params as usize }) == 0 {
            unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: isym.v }), (TypeId { v: fn_ty.v })); }
        }
        cx.current_fn = 0 as *const HirItem;
        cx.current_impl = 0 as *const HirItem;
        cx.self_ty.v = 0u32;
    } else if ik == HIR_ITEM_CONST {
        evaluate_const_item(mut_view(*cx), it);
    } else if ik == HIR_ITEM_STATIC {
        let sty_node: *mut HirType = unsafe { (*it).ty };
        let ty = hir_type_to_typeid(mut_view(*cx), sty_node);
        unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: ty.v })); }
        let isym = unsafe { (*it).symbol };
        if isym.v != 0u32 {
            unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: isym.v }), (TypeId { v: ty.v })); }
        }
    }
}

fn check_item_body(cx: mut_view<TypeckCtx>, it: *mut HirItem, parent_impl: *const HirItem) {
    if (it as usize) == 0 {
        return;
    }
    let ik = unsafe { (*it).kind };
    if ik == HIR_ITEM_FN {
        check_main_signature(mut_view(*cx), it);
        let body_blk: *mut HirBlock = unsafe { (*it).body };
        if (body_blk as usize) != 0 {
            cx.type_vars.fn_var_start = cx.type_vars.len;
            cx.lits_len = 0;
            cx.negs_len = 0;
            cx.vars_len = 0;
            cx.loops_len = 0;
            cx.current_fn = it;
            cx.current_impl = parent_impl;
            if (parent_impl as usize) != 0 && (unsafe { (*parent_impl).kind }) == HIR_ITEM_IMPL {
                let st_ptr: *mut HirType = unsafe { (*parent_impl).self_type };
                let st = hir_type_to_typeid(mut_view(*cx), st_ptr);
                cx.self_ty.v = st.v;
            } else {
                cx.self_ty.v = 0u32;
            }
            let mut p: *mut HirParam = unsafe { (*it).params };
            while ((p as usize) != 0) {
                let psym = unsafe { (*p).symbol };
                let pm = unsafe { (*p).is_mut };
                push_var_state(mut_view(*cx), (SymbolId { v: psym.v }), pm, true);
                p = unsafe { (*p).next };
            }
            let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), it) };
            let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
            let ret_v = if (fn_ty as usize) != 0 {
                unsafe { (*fn_ty).ret_type.v }
            } else {
                unsafe { (*cx.thir).interner.t_unit.v }
            };
            cx.return_type.v = ret_v;
            let _ = check_block(mut_view(*cx), body_blk, (TypeId { v: ret_v }));
            default_int_vars(mut_view(*cx));
            check_literal_ranges(mut_view(*cx));
            cx.return_type.v = 0u32;
            cx.current_fn = 0 as *const HirItem;
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
        }
    } else if ik == HIR_ITEM_STATIC {
        let sexpr: *mut HirExpr = unsafe { (*it).expr };
        if (sexpr as usize) != 0 {
            cx.type_vars.fn_var_start = cx.type_vars.len;
            cx.lits_len = 0;
            cx.negs_len = 0;
            let ty = unsafe { thir_get_item_type(view(*cx.thir), it) };
            let _ = check_expr(mut_view(*cx), sexpr, (TypeId { v: ty.v }));
            default_int_vars(mut_view(*cx));
            check_literal_ranges(mut_view(*cx));
        }
    }
}

pub fn typeck_into(
    hir_file: view<HirFile>,
    sink: mut_view<DiagSink>,
    str_in: mut_view<StrInterner>,
    db: view<SourceDatabase>,
    evaluator: *const ConstEvaluator,
    thir: mut_view<Thir>
) {
    thir_init(mut_view(*thir));

    let hir_ptr = unsafe { address_of(hir_file.items) as *mut HirFile };
    let sink_ptr = unsafe { address_of_mut(sink.arena.head) as *mut DiagSink };
    let str_ptr = unsafe { address_of_mut(str_in.bytes.head) as *mut StrInterner };
    let db_ptr = unsafe { address_of(db.arena.head) as *const SourceDatabase };
    let thir_ptr = unsafe { address_of_mut(thir.interner.arena.head) as *mut Thir };

    let mut cx = TypeckCtx {
        hir: hir_ptr,
        thir: thir_ptr,
        sink: sink_ptr,
        str_in: str_ptr,
        db: db_ptr,
        type_vars: TypeVarTable { items: 0 as *mut TypeVarEntry, len: 0, cap: 0, fn_var_start: 0 },
        return_type: (TypeId { v: 0u32 }),
        in_loop: false,
        lits: 0 as *mut LitCheck,
        lits_len: 0,
        lits_cap: 0,
        negs: 0 as *mut NegCheck,
        negs_len: 0,
        negs_cap: 0,
        vars: 0 as *mut VarState,
        vars_len: 0,
        vars_cap: 0,
        loops: 0 as *mut LoopEnv,
        loops_len: 0,
        loops_cap: 0,
        current_fn: 0 as *const HirItem,
        current_impl: 0 as *const HirItem,
        self_ty: (TypeId { v: 0u32 }),
        next_closure_id: 1u32,
        evaluator: evaluator,
        const_eval_stack: 0 as *mut SymbolId,
        const_eval_stack_len: 0,
        const_eval_stack_cap: 0,
    };
    type_vars_init(mut_view(cx.type_vars));

    annotate_intrinsic_hir(mut_view(thir.interner.arena), hir_file, view(*str_in));
    tc_mangle_drop_impls(mut_view(cx), hir_file);
    typeck_pass1a(mut_view(cx), hir_file, thir_ptr);
    typeck_pass1b_and_2(mut_view(cx), hir_file, thir_ptr, sink_ptr, str_ptr, db);

    type_vars_free(mut_view(cx.type_vars));
    if (cx.lits as usize) != 0 {
        unsafe { heap_free(cx.lits as *mut u8, mul_usize(cx.lits_cap, size_of<LitCheck>()), align_of<LitCheck>()); }
    }
    if (cx.negs as usize) != 0 {
        unsafe { heap_free(cx.negs as *mut u8, mul_usize(cx.negs_cap, size_of<NegCheck>()), align_of<NegCheck>()); }
    }
    if (cx.vars as usize) != 0 {
        unsafe { heap_free(cx.vars as *mut u8, mul_usize(cx.vars_cap, size_of<VarState>()), align_of<VarState>()); }
    }
    if (cx.loops as usize) != 0 {
        unsafe { heap_free(cx.loops as *mut u8, mul_usize(cx.loops_cap, size_of<LoopEnv>()), align_of<LoopEnv>()); }
    }
    if (cx.const_eval_stack as usize) != 0 {
        unsafe { heap_free(cx.const_eval_stack as *mut u8, mul_usize(cx.const_eval_stack_cap, size_of<SymbolId>()), align_of<SymbolId>()); }
    }
}

// SPEC-12 AXS-DROP-008 (ADR-0036 section 5): `impl P for T` declares the destructor of `T` iff the trait
// path `P` resolves to the prelude lang item `Drop`: `P` is the single segment `Drop` without generic
// arguments, and the impl's module neither declares a trait, struct, enum or type alias named `Drop` nor
// binds the name `Drop` with a `use`. Same predicate as hir_impl_is_lang_drop (compiler/hir/lower.ax,
// documented there) and ax_hir_impl_is_lang_drop / the twin in bootstrap/axiom0/src/types/typeck.c.
fn tc_name_is_drop(interner: view<StrInterner>, id: StrId) -> bool {
    if id.v == 0u32 {
        return false;
    }
    let sv = interner_get(interner, id);
    if sv.len != 4 {
        return false;
    }
    let b0 = unsafe { *(sv.ptr + 0) };
    let b1 = unsafe { *(sv.ptr + 1) };
    let b2 = unsafe { *(sv.ptr + 2) };
    let b3 = unsafe { *(sv.ptr + 3) };
    b0 == 68u8 && b1 == 114u8 && b2 == 111u8 && b3 == 112u8
}

fn tc_use_tree_binds_drop(interner: view<StrInterner>, t: *mut HirUseTree) -> bool {
    let mut cur: *mut HirUseTree = t;
    while (cur as usize) != 0 {
        let count = unsafe { (*cur).path.count };
        if (unsafe { (*cur).subtrees as usize }) != 0 {
            if tc_use_tree_binds_drop(interner, unsafe { (*cur).subtrees }) {
                return true;
            }
        } else if (unsafe { (*cur).alias.v }) != 0u32 {
            if tc_name_is_drop(interner, unsafe { (*cur).alias }) {
                return true;
            }
        } else if count > 0 {
            let off = (((count - 1) as isize) * (size_of<StrId>() as isize)) as usize;
            let seg_ptr = ((unsafe { (*cur).path.segments } as usize) + off) as *const StrId;
            if tc_name_is_drop(interner, unsafe { *seg_ptr }) {
                return true;
            }
        }
        cur = unsafe { (*cur).next };
    }
    false
}

fn tc_module_path_eq(a: *mut HirItem, b: *mut HirItem) -> bool {
    let count = unsafe { (*a).module_path.count };
    if count != (unsafe { (*b).module_path.count }) {
        return false;
    }
    let sa = unsafe { (*a).module_path.segments } as usize;
    let sb = unsafe { (*b).module_path.segments } as usize;
    let mut i: usize = 0;
    while i < count {
        let off = ((i as isize) * (size_of<StrId>() as isize)) as usize;
        let pa = (sa + off) as *const StrId;
        let pb = (sb + off) as *const StrId;
        if (unsafe { (*pa).v }) != (unsafe { (*pb).v }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn tc_impl_is_lang_drop(items: *mut HirItem, impl_item: *mut HirItem, interner: view<StrInterner>) -> bool {
    if (impl_item as usize) == 0 || (unsafe { (*impl_item).kind }) != HIR_ITEM_IMPL {
        return false;
    }
    let tp: *mut HirType = unsafe { (*impl_item).trait_path };
    if (tp as usize) == 0 || (unsafe { (*tp).kind }) != HIR_TYPE_PATH {
        return false;
    }
    if (unsafe { (*tp).path.generic_args as usize }) != 0 {
        return false;
    }
    if !tc_name_is_drop(interner, unsafe { (*tp).path.name }) {
        return false;
    }
    if (unsafe { (*tp).path.span.file.v }) != 0u32 {
        let span_len = (unsafe { (*tp).path.span.end }) - (unsafe { (*tp).path.span.start });
        if span_len != 4u32 {
            return false;
        }
    }
    let mut it: *mut HirItem = items;
    while (it as usize) != 0 {
        if tc_module_path_eq(it, impl_item) {
            let k = unsafe { (*it).kind };
            if k == HIR_ITEM_TRAIT || k == HIR_ITEM_STRUCT || k == HIR_ITEM_ENUM || k == HIR_ITEM_TYPE_ALIAS {
                if tc_name_is_drop(interner, unsafe { (*it).name }) {
                    return false;
                }
            } else if k == HIR_ITEM_USE {
                if tc_use_tree_binds_drop(interner, unsafe { (*it).use_tree }) {
                    return false;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    true
}

fn tc_write_u32_dec(buf: *mut u8, start: usize, val: u32) -> usize {
    let mut tmp: [16]u8 = [0u8; 16];
    let mut dlen: usize = 0;
    let mut v = val;
    if v == 0u32 {
        unsafe { *(buf + start) = 48u8; }
        return start + 1;
    }
    while v > 0u32 {
        tmp[dlen] = (48u32 + (v % 10u32)) as u8;
        v = v / 10u32;
        dlen = dlen + 1;
    }
    let mut i: usize = 0;
    while i < dlen {
        unsafe { *(buf + start + i) = tmp[dlen - 1 - i]; }
        i = i + 1;
    }
    start + dlen
}

fn tc_mangle_drop_impls(cx: mut_view<TypeckCtx>, hir_file: view<HirFile>) {
    if (cx.str_in as usize) == 0 {
        return;
    }
    let mut drop_sym_counter: u32 = 0u32;
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            let st: *mut HirType = unsafe { (*it).self_type };
            if (tp as usize) != 0 && (st as usize) != 0 && (unsafe { (*st).kind }) == HIR_TYPE_PATH {
                if tc_impl_is_lang_drop(hir_file.items, it, unsafe { view(*cx.str_in) }) {
                    let mut sname = StrView { ptr: 0 as *const u8, len: 0 };
                    if (unsafe { (*st).path.name.v }) != 0u32 {
                        sname = unsafe { interner_get(view(*cx.str_in), (*st).path.name) };
                    } else if (cx.db as usize) != 0 {
                        let raw_s = unsafe { source_db_span_text(view(*cx.db), (*st).path.span) };
                        let mut lt: usize = 0;
                        while (lt) < (raw_s.len) {
                            if (unsafe { *(raw_s.ptr + lt) }) == 60u8 {
                                break;
                            }
                            lt = lt + 1;
                        }
                        sname = StrView { ptr: raw_s.ptr, len: lt };
                    }
                    if sname.len > 0 {
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while (m as usize) != 0 {
                            if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                                let mut mbuf: [256]u8 = [0u8; 256];
                                let buf_ptr = unsafe { address_of(mbuf[0]) as *mut u8 };
                                let copy_len: usize = if sname.len > 240 { 240 } else { sname.len };
                                unsafe {
                                    ptr_copy_nonoverlapping<u8>(sname.ptr, buf_ptr, copy_len);
                                    *(buf_ptr + copy_len) = 36u8;
                                    *(buf_ptr + copy_len + 1) = 100u8;
                                    *(buf_ptr + copy_len + 2) = 114u8;
                                    *(buf_ptr + copy_len + 3) = 111u8;
                                    *(buf_ptr + copy_len + 4) = 112u8;
                                }
                                let base_len = copy_len + 5;
                                let mut new_name = unsafe {
                                    interner_intern_bytes(mut_view(*cx.str_in), buf_ptr as *const u8, base_len)
                                };
                                let mut disambig: u32 = 1u32;
                                loop {
                                    let mut collision = false;
                                    let mut prev: *mut HirItem = hir_file.items;
                                    while (prev as usize) != 0 && (prev as usize) != (it as usize) {
                                        if (unsafe { (*prev).kind }) == HIR_ITEM_IMPL {
                                            let mut pm: *mut HirItem = unsafe { (*prev).members };
                                            while (pm as usize) != 0 {
                                                if (unsafe { (*pm).kind }) == HIR_ITEM_FN &&
                                                   (unsafe { (*pm).name.v }) == new_name.v {
                                                    collision = true;
                                                    break;
                                                }
                                                pm = unsafe { (*pm).next };
                                            }
                                        }
                                        if collision {
                                            break;
                                        }
                                        prev = unsafe { (*prev).next };
                                    }
                                    if !collision {
                                        break;
                                    }
                                    disambig = disambig + 1u32;
                                    unsafe { *(buf_ptr + base_len) = 36u8; }
                                    let dlen = tc_write_u32_dec(buf_ptr, base_len + 1, disambig);
                                    new_name = unsafe {
                                        interner_intern_bytes(mut_view(*cx.str_in), buf_ptr as *const u8, dlen)
                                    };
                                }
                                drop_sym_counter = drop_sym_counter + 1u32;
                                let new_sym_v = 0x70000000u32 + drop_sym_counter;
                                let old_name_v = unsafe { (*m).name.v };
                                let m_body = unsafe { (*m).body };
                                unsafe {
                                    (*m).name.v = new_name.v;
                                    (*m).symbol.v = new_sym_v;
                                }
                                let mut top: *mut HirItem = hir_file.items;
                                while (top as usize) != 0 {
                                    if (top as usize) != (m as usize) &&
                                       (unsafe { (*top).kind }) == HIR_ITEM_FN &&
                                       (unsafe { (*top).body as usize }) == (m_body as usize) &&
                                       (unsafe { (*top).name.v }) == old_name_v {
                                        unsafe {
                                            (*top).name.v = new_name.v;
                                            (*top).symbol.v = new_sym_v;
                                        }
                                        break;
                                    }
                                    top = unsafe { (*top).next };
                                }
                            }
                            m = unsafe { (*m).next };
                        }
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
}

fn typeck_pass1a(cx: mut_view<TypeckCtx>, hir_file: view<HirFile>, thir_ptr: *mut Thir) {
    // Pass 1a0: Pre-register Struct and Enum headers so self-referential and mutually-recursive types resolve.
    let mut top_it: *mut HirItem = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_STRUCT {
            let mut arg_cnt: usize = 0;
            let args = build_item_generic_param_args(mut_view(*cx), top_it, mut_view(arg_cnt));
            let is_rc = item_has_repr_c(view(*cx), top_it);
            let st_id = unsafe { intern_struct_ty(mut_view((*thir_ptr).interner), is_rc, top_it, 0 as *mut TypeId, 0, args, arg_cnt) };
            unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: st_id.v })); }
            let s_sym = unsafe { (*top_it).symbol };
            if s_sym.v != 0u32 && arg_cnt == 0 {
                unsafe { thir_set_sym_type(mut_view(*thir_ptr), (SymbolId { v: s_sym.v }), (TypeId { v: st_id.v })); }
            }
        } else if tk == HIR_ITEM_ENUM {
            let mut arg_cnt: usize = 0;
            let args = build_item_generic_param_args(mut_view(*cx), top_it, mut_view(arg_cnt));
            let mut v_cnt: usize = 0;
            let mut v: *mut HirVariantDecl = unsafe { (*top_it).variants };
            while ((v as usize) != 0) {
                v_cnt = v_cnt + 1;
                v = unsafe { (*v).next };
            }
            let en_id = unsafe {
                intern_enum_ty(
                    mut_view((*thir_ptr).interner),
                    top_it,
                    args,
                    arg_cnt,
                    0 as *mut *mut TypeId,
                    0 as *mut usize,
                    v_cnt
                )
            };
            unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: en_id.v })); }
            let e_sym = unsafe { (*top_it).symbol };
            if e_sym.v != 0u32 && arg_cnt == 0 {
                unsafe { thir_set_sym_type(mut_view(*thir_ptr), (SymbolId { v: e_sym.v }), (TypeId { v: en_id.v })); }
            }
        }
        top_it = unsafe { (*top_it).next };
    }

    // Pass 1a1: Populate Struct fields and Enum variant fields.
    top_it = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_STRUCT {
            cx.current_fn = top_it;
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            let st_id = unsafe { thir_get_item_type(view(*thir_ptr), top_it) };
            let st_ty = unsafe { type_get(view((*thir_ptr).interner), (TypeId { v: st_id.v })) };
            if (st_ty as usize) != 0 {
                let mut f_cnt: usize = 0;
                if unsafe { (*top_it).is_tuple } {
                    let mut t: *mut HirType = unsafe { (*top_it).tuple_types };
                    while ((t as usize) != 0) {
                        f_cnt = f_cnt + 1;
                        t = unsafe { (*t).next };
                    }
                } else {
                    let mut f: *mut HirFieldDecl = unsafe { (*top_it).struct_fields };
                    while ((f as usize) != 0) {
                        f_cnt = f_cnt + 1;
                        f = unsafe { (*f).next };
                    }
                }
                let mut flds: *mut TypeId = 0 as *mut TypeId;
                if f_cnt > 0 {
                    let fbytes = mul_usize(f_cnt, size_of<TypeId>());
                    flds = unsafe { arena_alloc_raw(mut_view((*thir_ptr).interner.arena), fbytes, align_of<TypeId>()) as *mut TypeId };
                    let mut idx: usize = 0;
                    if unsafe { (*top_it).is_tuple } {
                        let mut t: *mut HirType = unsafe { (*top_it).tuple_types };
                        while ((t as usize) != 0) {
                            let ft = hir_type_to_typeid(mut_view(*cx), t);
                            let dst = unsafe { typeid_at(flds, idx) };
                            unsafe { (*dst).v = ft.v; }
                            idx = idx + 1;
                            t = unsafe { (*t).next };
                        }
                    } else {
                        let mut f: *mut HirFieldDecl = unsafe { (*top_it).struct_fields };
                        while ((f as usize) != 0) {
                            let fty_node: *mut HirType = unsafe { (*f).ty };
                            if (fty_node as usize) != 0 && (unsafe { (*fty_node).kind }) == HIR_TYPE_VIEW {
                                let _ = unsafe { type_error(mut_view(*cx), view((*f).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) };
                            }
                            let ft = hir_type_to_typeid(mut_view(*cx), fty_node);
                            let dst = unsafe { typeid_at(flds, idx) };
                            unsafe { (*dst).v = ft.v; }
                            idx = idx + 1;
                            f = unsafe { (*f).next };
                        }
                    }
                }
                unsafe {
                    (*st_ty).fields = flds;
                    (*st_ty).field_count = f_cnt;
                }
            }
            cx.current_fn = 0 as *const HirItem;
        } else if tk == HIR_ITEM_ENUM {
            cx.current_fn = top_it;
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            let en_id = unsafe { thir_get_item_type(view(*thir_ptr), top_it) };
            let en_ty = unsafe { type_get(view((*thir_ptr).interner), (TypeId { v: en_id.v })) };
            if (en_ty as usize) != 0 {
                let v_cnt = unsafe { (*en_ty).variant_count };
                let mut v_fields: *mut *mut TypeId = 0 as *mut *mut TypeId;
                let mut v_counts: *mut usize = 0 as *mut usize;
                if v_cnt > 0 {
                    let vf_bytes = mul_usize(v_cnt, size_of<*mut TypeId>());
                    let vc_bytes = mul_usize(v_cnt, size_of<usize>());
                    v_fields = unsafe { arena_alloc_raw(mut_view((*thir_ptr).interner.arena), vf_bytes, align_of<*mut TypeId>()) as *mut *mut TypeId };
                    v_counts = unsafe { arena_alloc_raw(mut_view((*thir_ptr).interner.arena), vc_bytes, align_of<usize>()) as *mut usize };
                    let mut v_idx: usize = 0;
                    let mut v: *mut HirVariantDecl = unsafe { (*top_it).variants };
                    while ((v as usize) != 0) {
                        let mut f_cnt: usize = 0;
                        if unsafe { (*v).is_struct } {
                            let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                            while ((f as usize) != 0) {
                                f_cnt = f_cnt + 1;
                                f = unsafe { (*f).next };
                            }
                        } else {
                            let mut t: *mut HirType = unsafe { (*v).tuple_types };
                            while ((t as usize) != 0) {
                                f_cnt = f_cnt + 1;
                                t = unsafe { (*t).next };
                            }
                        }
                        let vc_slot = unsafe { usize_at(v_counts, v_idx) };
                        unsafe { *vc_slot = f_cnt; }
                        let vf_slot = unsafe { typeid_ptr_at(v_fields, v_idx) };
                        if f_cnt > 0 {
                            let fbytes = mul_usize(f_cnt, size_of<TypeId>());
                            let f_arr = unsafe { arena_alloc_raw(mut_view((*thir_ptr).interner.arena), fbytes, align_of<TypeId>()) as *mut TypeId };
                            let mut f_idx: usize = 0;
                            if unsafe { (*v).is_struct } {
                                let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                                while ((f as usize) != 0) {
                                    let fty_node: *mut HirType = unsafe { (*f).ty };
                                    let ft = hir_type_to_typeid(mut_view(*cx), fty_node);
                                    let dst = unsafe { typeid_at(f_arr, f_idx) };
                                    unsafe { (*dst).v = ft.v; }
                                    f_idx = f_idx + 1;
                                    f = unsafe { (*f).next };
                                }
                            } else {
                                let mut t: *mut HirType = unsafe { (*v).tuple_types };
                                while ((t as usize) != 0) {
                                    let ft = hir_type_to_typeid(mut_view(*cx), t);
                                    let dst = unsafe { typeid_at(f_arr, f_idx) };
                                    unsafe { (*dst).v = ft.v; }
                                    f_idx = f_idx + 1;
                                    t = unsafe { (*t).next };
                                }
                            }
                            unsafe { *vf_slot = f_arr; }
                        } else {
                            unsafe { *vf_slot = 0 as *mut TypeId; }
                        }
                        v_idx = v_idx + 1;
                        v = unsafe { (*v).next };
                    }
                }
                unsafe {
                    (*en_ty).variant_fields = v_fields;
                    (*en_ty).variant_field_counts = v_counts;
                }
            }
            cx.current_fn = 0 as *const HirItem;
        }
        top_it = unsafe { (*top_it).next };
    }

}

fn typeck_pass1b_and_2(
    cx: mut_view<TypeckCtx>,
    hir_file: view<HirFile>,
    thir_ptr: *mut Thir,
    sink_ptr: *mut DiagSink,
    str_ptr: *mut StrInterner,
    db: view<SourceDatabase>
) {
    // Pass 1b: Register impl self_type, functions, methods, extern fns, consts, statics.
    let mut top_it: *mut HirItem = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_FN {
            let orig_m = find_orig_impl_member(hir_file, top_it);
            if (orig_m as usize) != 0 {
                let m_ty = unsafe { thir_get_item_type(view(*thir_ptr), orig_m) };
                if m_ty.v != 0u32 {
                    unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: m_ty.v })); }
                }
                top_it = unsafe { (*top_it).next };
                continue;
            }
            register_item_sig(mut_view(*cx), top_it, 0 as *const HirItem);
        } else if tk == HIR_ITEM_IMPL {
            cx.current_impl = top_it;
            cx.current_fn = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            let self_ty_node: *mut HirType = unsafe { (*top_it).self_type };
            let impl_self_ty = hir_type_to_typeid(mut_view(*cx), self_ty_node);
            unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: impl_self_ty.v })); }
            cx.current_impl = 0 as *const HirItem;

            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                register_item_sig(mut_view(*cx), m, top_it);
                m = unsafe { (*m).next };
            }
            let tp_node: *mut HirType = unsafe { (*top_it).trait_path };
            if (tp_node as usize) != 0 && impl_self_ty.v != 0u32 {
                if (cx.str_in as usize) != 0 && tc_impl_is_lang_drop(hir_file.items, top_it, unsafe { view(*cx.str_in) }) {
                    let self_t = unsafe { type_get(view((*thir_ptr).interner), (TypeId { v: impl_self_ty.v })) };
                    if (self_t as usize) != 0 && (unsafe { (*self_t).kind }) == TY_STRUCT {
                        let mut dm: *mut HirItem = unsafe { (*top_it).members };
                        while (dm as usize) != 0 {
                            if (unsafe { (*dm).kind }) == HIR_ITEM_FN {
                                let tk_key = ((impl_self_ty.v as usize) << 1) | 1;
                                unsafe {
                                    ptr_itemmap_insert(mut_view((*thir_ptr).expr_methods), tk_key, dm);
                                }
                                let def_ptr = unsafe { (*self_t).def };
                                if (def_ptr as usize) != 0 {
                                    let dk_key = (def_ptr as usize) | 1;
                                    unsafe {
                                        ptr_itemmap_insert(mut_view((*thir_ptr).expr_methods), dk_key, dm);
                                    }
                                }
                                break;
                            }
                            dm = unsafe { (*dm).next };
                        }
                    }
                }
            }
        } else if tk == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                register_item_sig(mut_view(*cx), m, top_it);
                m = unsafe { (*m).next };
            }
        } else if tk == HIR_ITEM_EXTERN_BLOCK {
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                register_item_sig(mut_view(*cx), m, 0 as *const HirItem);
                m = unsafe { (*m).next };
            }
        } else if tk == HIR_ITEM_CONST || tk == HIR_ITEM_STATIC {
            register_item_sig(mut_view(*cx), top_it, 0 as *const HirItem);
        }
        top_it = unsafe { (*top_it).next };
    }
    // Second sweep for top-level cloned impl methods whose impl appeared after them in hir_file.items:
    top_it = hir_file.items;
    while ((top_it as usize) != 0) {
        if (unsafe { (*top_it).kind }) == HIR_ITEM_FN {
            let existing = unsafe { thir_get_item_type(view(*thir_ptr), top_it) };
            if existing.v == 0u32 {
                let orig_m = find_orig_impl_member(hir_file, top_it);
                if (orig_m as usize) != 0 {
                    let m_ty = unsafe { thir_get_item_type(view(*thir_ptr), orig_m) };
                    if m_ty.v != 0u32 {
                        unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: m_ty.v })); }
                    }
                }
            }
        }
        top_it = unsafe { (*top_it).next };
    }

    // Pass 1c: Check overlapping trait impls and supertrait obligations.
    unsafe {
        traits_check_overlap(hir_file, mut_view(*sink_ptr));
        let _ = check_impl_supertraits(hir_file, view(*thir_ptr), view(*str_ptr), db, mut_view(*sink_ptr));
    }

    // Pass 2: Typecheck function, method, and static bodies.
    top_it = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_FN {
            let orig_m = find_orig_impl_member(hir_file, top_it);
            if (orig_m as usize) == 0 {
                check_item_body(mut_view(*cx), top_it, 0 as *const HirItem);
            }
        } else if tk == HIR_ITEM_IMPL || tk == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                check_item_body(mut_view(*cx), m, top_it);
                m = unsafe { (*m).next };
            }
        } else if tk == HIR_ITEM_STATIC {
            check_item_body(mut_view(*cx), top_it, 0 as *const HirItem);
        }
        top_it = unsafe { (*top_it).next };
    }

    finalize_types(mut_view(*cx));
    check_all_bounds(mut_view(*cx));
    if (thir_ptr as usize) != 0 && (sink_ptr as usize) != 0 && (str_ptr as usize) != 0 {
        unsafe {
            check_intrinsic_hir(hir_file, view(*thir_ptr), mut_view(*sink_ptr), view(*str_ptr));
        }
    }
}

// =============================================================================
// Unsafe Checker (Port of bootstrap/axiom0/src/own/unsafe/unsafe.c)
// =============================================================================

struct UnsafeCtx {
    hir: *const HirFile,
    thir: *const Thir,
    sink: *mut DiagSink,
    interner: *const StrInterner,
    in_unsafe: bool,
}

fn require_unsafe(cx: mut_view<UnsafeCtx>, sp: view<Span>) {
    if !cx.in_unsafe && (cx.sink as usize) != 0 {
        unsafe {
            report_typeck_diag(mut_view(*cx.sink), AX_UNSAFE_REQUIRED, sp.file.v, sp.start, sp.end);
        }
    }
}

fn is_unsafe_builtin_kind(k: u8) -> bool {
    k == TY_BUILTIN_PTR_ADD ||
    k == TY_BUILTIN_PTR_SUB ||
    k == TY_BUILTIN_ADDRESS_OF ||
    k == TY_BUILTIN_ADDRESS_OF_MUT ||
    k == TY_BUILTIN_DROP_IN_PLACE ||
    k == TY_BUILTIN_PTR_COPY ||
    k == TY_BUILTIN_PTR_COPY_NONOVERLAPPING ||
    k == TY_BUILTIN_PTR_WRITE_BYTES
}

fn is_unsafe_intrinsic_fn(interner: *const StrInterner, it: *const HirItem) -> bool {
    let _ = interner;
    if (it as usize) == 0 {
        return false;
    }
    unsafe { (*it).is_unsafe }
}

fn unsafe_find_item_by_sym(hir_file: *const HirFile, sym: SymbolId) -> *const HirItem {
    if (hir_file as usize) == 0 || sym.v == 0u32 {
        return 0 as *const HirItem;
    }
    let mut it: *mut HirItem = unsafe { (*hir_file).items };
    while ((it as usize) != 0) {
        if (unsafe { (*it).symbol.v }) == sym.v {
            return it;
        }
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_EXTERN_BLOCK || ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while ((m as usize) != 0) {
                if (unsafe { (*m).symbol.v }) == sym.v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *const HirItem
}

fn unsafe_check_stmt(cx: mut_view<UnsafeCtx>, stmt: *const HirStmt) {
    let mut cur = stmt;
    while ((cur as usize) != 0) {
        let sk = unsafe { (*cur).kind };
        if sk == HIR_STMT_LET {
            let ex: *mut HirExpr = unsafe { (*cur).expr };
            unsafe_check_expr(mut_view(*cx), ex);
            let eb: *mut HirBlock = unsafe { (*cur).else_block };
            if (eb as usize) != 0 {
                unsafe_check_block(mut_view(*cx), eb);
            }
        } else if sk == HIR_STMT_ASSIGN {
            let l: *mut HirExpr = unsafe { (*cur).left };
            let r: *mut HirExpr = unsafe { (*cur).right };
            unsafe_check_expr(mut_view(*cx), l);
            unsafe_check_expr(mut_view(*cx), r);
        } else if sk == HIR_STMT_EXPR {
            let ex: *mut HirExpr = unsafe { (*cur).expr };
            unsafe_check_expr(mut_view(*cx), ex);
        }
        cur = unsafe { (*cur).next };
    }
}

fn unsafe_check_block(cx: mut_view<UnsafeCtx>, blk: *const HirBlock) {
    if (blk as usize) == 0 {
        return;
    }
    let stmts: *mut HirStmt = unsafe { (*blk).stmts };
    unsafe_check_stmt(mut_view(*cx), stmts);
}

fn unsafe_check_expr(cx: mut_view<UnsafeCtx>, expr: *const HirExpr) {
    let mut cur = expr;
    while ((cur as usize) != 0) {
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_UNSAFE {
            let saved = cx.in_unsafe;
            cx.in_unsafe = true;
            let blk: *mut HirBlock = unsafe { (*cur).block };
            unsafe_check_block(mut_view(*cx), blk);
            cx.in_unsafe = saved;
        } else if k == HIR_EXPR_BLOCK || k == HIR_EXPR_LOOP || k == HIR_EXPR_COMPTIME {
            let blk: *mut HirBlock = unsafe { (*cur).block };
            unsafe_check_block(mut_view(*cx), blk);
        } else if k == HIR_EXPR_IF {
            let c: *mut HirExpr = unsafe { (*cur).cond };
            let blk: *mut HirBlock = unsafe { (*cur).block };
            let eb: *mut HirExpr = unsafe { (*cur).else_branch };
            unsafe_check_expr(mut_view(*cx), c);
            unsafe_check_block(mut_view(*cx), blk);
            unsafe_check_expr(mut_view(*cx), eb);
        } else if k == HIR_EXPR_WHILE {
            let c: *mut HirExpr = unsafe { (*cur).cond };
            let blk: *mut HirBlock = unsafe { (*cur).block };
            unsafe_check_expr(mut_view(*cx), c);
            unsafe_check_block(mut_view(*cx), blk);
        } else if k == HIR_EXPR_FOR {
            let it: *mut HirExpr = unsafe { (*cur).iter };
            let blk: *mut HirBlock = unsafe { (*cur).block };
            unsafe_check_expr(mut_view(*cx), it);
            unsafe_check_block(mut_view(*cx), blk);
        } else if k == HIR_EXPR_MATCH {
            let c: *mut HirExpr = unsafe { (*cur).cond };
            unsafe_check_expr(mut_view(*cx), c);
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while ((a as usize) != 0) {
                let g: *mut HirExpr = unsafe { (*a).guard };
                let b: *mut HirExpr = unsafe { (*a).body };
                unsafe_check_expr(mut_view(*cx), g);
                unsafe_check_expr(mut_view(*cx), b);
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_UNARY {
            let inner: *mut HirExpr = unsafe { (*cur).inner };
            if (unsafe { (*cur).op }) == UNOP_DEREF {
                let inner_ty_id = unsafe { thir_get_expr_type(view(*cx.thir), inner) };
                if inner_ty_id.v != 0u32 {
                    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: inner_ty_id.v })) };
                    if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_PTR {
                        unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
                    }
                }
            }
            unsafe_check_expr(mut_view(*cx), inner);
        } else if k == HIR_EXPR_BINARY {
            let l: *mut HirExpr = unsafe { (*cur).left };
            let r: *mut HirExpr = unsafe { (*cur).right };
            let op = unsafe { (*cur).op };
            if op == BINOP_ADD || op == BINOP_SUB {
                let lty_id = unsafe { thir_get_expr_type(view(*cx.thir), l) };
                let rty_id = unsafe { thir_get_expr_type(view(*cx.thir), r) };
                let mut is_ptr_arith = false;
                if lty_id.v != 0u32 {
                    let lt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: lty_id.v })) };
                    if (lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_PTR {
                        is_ptr_arith = true;
                    }
                }
                if rty_id.v != 0u32 {
                    let rt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rty_id.v })) };
                    if (rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR {
                        is_ptr_arith = true;
                    }
                }
                if is_ptr_arith {
                    unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
                }
            }
            unsafe_check_expr(mut_view(*cx), l);
            unsafe_check_expr(mut_view(*cx), r);
        } else if k == HIR_EXPR_CALL {
            let callee: *mut HirExpr = unsafe { (*cur).callee };
            let args: *mut HirExpr = unsafe { (*cur).args };
            let cty_id = unsafe { thir_get_expr_type(view(*cx.thir), callee) };
            let mut need_u = false;
            if cty_id.v != 0u32 {
                let ct = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: cty_id.v })) };
                if (ct as usize) != 0 {
                    let ctk = unsafe { (*ct).kind };
                    if ctk == TY_FN && (unsafe { (*ct).is_unsafe }) {
                        need_u = true;
                    } else if is_unsafe_builtin_kind(ctk) {
                        need_u = true;
                    }
                }
            }
            if !need_u && (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
                let sym = unsafe { (*callee).path.symbol };
                let it = unsafe_find_item_by_sym(cx.hir, sym);
                if is_unsafe_intrinsic_fn(cx.interner, it) {
                    need_u = true;
                }
            }
            if need_u {
                unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
            }
            unsafe_check_expr(mut_view(*cx), callee);
            unsafe_check_expr(mut_view(*cx), args);
        } else if k == HIR_EXPR_METHOD_CALL {
            let recv: *mut HirExpr = unsafe { (*cur).receiver };
            let args: *mut HirExpr = unsafe { (*cur).args };
            let m_it = unsafe { thir_get_expr_method(view(*cx.thir), cur) };
            if (m_it as usize) != 0 && (unsafe { (*m_it).is_unsafe }) {
                unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
            }
            unsafe_check_expr(mut_view(*cx), recv);
            unsafe_check_expr(mut_view(*cx), args);
        } else if k == HIR_EXPR_PATH {
            let sym = unsafe { (*cur).path.symbol };
            if sym.v != 0u32 {
                let it = unsafe_find_item_by_sym(cx.hir, sym);
                if (it as usize) != 0 && (unsafe { (*it).kind }) == HIR_ITEM_STATIC {
                    if unsafe { (*it).is_mut || (*it).is_unsafe } {
                        unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
                    }
                }
            }
        } else if k == HIR_EXPR_ARRAY {
            let el: *mut HirExpr = unsafe { (*cur).elems };
            let cnt: *mut HirExpr = unsafe { (*cur).count_expr };
            unsafe_check_expr(mut_view(*cx), el);
            unsafe_check_expr(mut_view(*cx), cnt);
        } else if k == HIR_EXPR_TUPLE {
            let el: *mut HirExpr = unsafe { (*cur).elems };
            unsafe_check_expr(mut_view(*cx), el);
        } else if k == HIR_EXPR_STRUCT {
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while ((f as usize) != 0) {
                let fex: *mut HirExpr = unsafe { (*f).expr };
                unsafe_check_expr(mut_view(*cx), fex);
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_VIEW || k == HIR_EXPR_JUMP || k == HIR_EXPR_CAST || k == HIR_EXPR_TRY || k == HIR_EXPR_AWAIT {
            let inner: *mut HirExpr = unsafe { (*cur).inner };
            unsafe_check_expr(mut_view(*cx), inner);
        } else if k == HIR_EXPR_CLOSURE {
            let saved = cx.in_unsafe;
            cx.in_unsafe = false;
            let body: *mut HirExpr = unsafe { (*cur).body };
            unsafe_check_expr(mut_view(*cx), body);
            cx.in_unsafe = saved;
        } else if k == HIR_EXPR_RANGE {
            let s: *mut HirExpr = unsafe { (*cur).start_expr };
            let e: *mut HirExpr = unsafe { (*cur).end_expr };
            unsafe_check_expr(mut_view(*cx), s);
            unsafe_check_expr(mut_view(*cx), e);
        } else if k == HIR_EXPR_FIELD || k == HIR_EXPR_TUPLE_INDEX {
            let b: *mut HirExpr = unsafe { (*cur).base };
            unsafe_check_expr(mut_view(*cx), b);
        } else if k == HIR_EXPR_INDEX {
            let b: *mut HirExpr = unsafe { (*cur).base };
            let a: *mut HirExpr = unsafe { (*cur).index_arg };
            unsafe_check_expr(mut_view(*cx), b);
            unsafe_check_expr(mut_view(*cx), a);
        }
        cur = unsafe { (*cur).next };
    }
}

pub fn unsafe_check(
    hir_file: view<HirFile>,
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    interner: view<StrInterner>
) {
    let hir_ptr = unsafe { address_of(hir_file.items) as *const HirFile };
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let sink_ptr = unsafe { address_of_mut(sink.arena.head) as *mut DiagSink };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };
    let mut cx = UnsafeCtx {
        hir: hir_ptr,
        thir: thir_ptr,
        sink: sink_ptr,
        interner: int_ptr,
        in_unsafe: false,
    };

    let mut top_it: *mut HirItem = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_FN {
            let orig_m = find_orig_impl_member(hir_file, top_it);
            if (orig_m as usize) == 0 {
                let body_blk: *mut HirBlock = unsafe { (*top_it).body };
                if (body_blk as usize) != 0 {
                    cx.in_unsafe = unsafe { (*top_it).is_unsafe };
                    unsafe_check_block(mut_view(cx), body_blk);
                }
            }
        } else if tk == HIR_ITEM_IMPL || tk == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    let body_blk: *mut HirBlock = unsafe { (*m).body };
                    if (body_blk as usize) != 0 {
                        cx.in_unsafe = unsafe { (*m).is_unsafe };
                        unsafe_check_block(mut_view(cx), body_blk);
                    }
                }
                m = unsafe { (*m).next };
            }
        } else if tk == HIR_ITEM_CONST || tk == HIR_ITEM_STATIC {
            let ex: *mut HirExpr = unsafe { (*top_it).expr };
            if (ex as usize) != 0 {
                cx.in_unsafe = false;
                unsafe_check_expr(mut_view(cx), ex);
            }
        }
        top_it = unsafe { (*top_it).next };
    }
}

pub fn typeck_with_evaluator(
    hir_file: view<HirFile>,
    sink: mut_view<DiagSink>,
    str_in: mut_view<StrInterner>,
    db: view<SourceDatabase>,
    evaluator: *const ConstEvaluator,
    thir: mut_view<Thir>
) {
    typeck_into(hir_file, mut_view(*sink), mut_view(*str_in), db, evaluator, mut_view(*thir));
    if sink.errors == 0 {
        unsafe_check(hir_file, view(*thir), mut_view(*sink), view(*str_in));
    }
}

pub fn typeck(
    hir_file: view<HirFile>,
    sink: mut_view<DiagSink>,
    str_in: mut_view<StrInterner>,
    db: view<SourceDatabase>,
    thir: mut_view<Thir>
) {
    typeck_with_evaluator(hir_file, sink, str_in, db, 0 as *const ConstEvaluator, thir);
}

