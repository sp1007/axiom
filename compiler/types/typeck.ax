];

fn sv_is_spawn_name(sv: view<StrView>) -> u8 {
    if sv.len == 5 && (sv.ptr as usize) != 0 {
        let ok = unsafe {
            *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 &&
            *(sv.ptr + 2) == 97u8 && *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8
        };
        if ok { return 1u8; }
    } else if sv.len == 11 && (sv.ptr as usize) != 0 {
        let ok = unsafe {
            *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 &&
            *(sv.ptr + 2) == 97u8 && *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8 &&
            *(sv.ptr + 5) == 95u8 && *(sv.ptr + 6) == 108u8 && *(sv.ptr + 7) == 111u8 &&
            *(sv.ptr + 8) == 99u8 && *(sv.ptr + 9) == 97u8 && *(sv.ptr + 10) == 108u8
        };
        if ok { return 2u8; }
    } else if sv.len == 12 && (sv.ptr as usize) != 0 {
        let ok = unsafe {
            *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 &&
            *(sv.ptr + 2) == 97u8 && *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8 &&
            *(sv.ptr + 5) == 95u8 && *(sv.ptr + 6) == 115u8 && *(sv.ptr + 7) == 99u8 &&
            *(sv.ptr + 8) == 111u8 && *(sv.ptr + 9) == 112u8 && *(sv.ptr + 10) == 101u8 &&
            *(sv.ptr + 11) == 100u8
        };
        if ok { return 4u8; }
    }
    0u8
}

fn sv_is_spawn_blocking_name(sv: view<StrView>) -> bool {
    sv.len == 14 && (sv.ptr as usize) != 0 && unsafe {
        *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 && *(sv.ptr + 2) == 97u8 &&
        *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8 && *(sv.ptr + 5) == 95u8 &&
        *(sv.ptr + 6) == 98u8 && *(sv.ptr + 7) == 108u8 && *(sv.ptr + 8) == 111u8 &&
        *(sv.ptr + 9) == 99u8 && *(sv.ptr + 10) == 107u8 && *(sv.ptr + 11) == 105u8 &&
        *(sv.ptr + 12) == 110u8 && *(sv.ptr + 13) == 103u8
    }
}

fn tc_item_is_std_module(interner: view<StrInterner>, it: *const HirItem) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    let count = unsafe { (*it).module_path.count };
    if count == 0 {
        return false;
    }
    let segs = unsafe { (*it).module_path.segments };
    if (segs as usize) == 0 {
        return false;
    }
    let s0 = unsafe { (*segs).v };
    if s0 == 0u32 {
        return false;
    }
    let sv = interner_get(interner, StrId { v: s0 });
    sv.len == 3 && (sv.ptr as usize) != 0 && unsafe {
        *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 116u8 && *(sv.ptr + 2) == 100u8
    }
}

fn sv_is_fnonce_name(sv: view<StrView>) -> bool {
    sv.len == 6 && (sv.ptr as usize) != 0 && unsafe {
        *(sv.ptr + 0) == 70u8 && *(sv.ptr + 1) == 110u8 && *(sv.ptr + 2) == 79u8 &&
        *(sv.ptr + 3) == 110u8 && *(sv.ptr + 4) == 99u8 && *(sv.ptr + 5) == 101u8
    }
}

fn tc_bound_is_fnonce(cx: view<TypeckCtx>, b: *const HirType) -> bool {
    if (b as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return false;
    }
    let raw_bname = unsafe { tc_path_name_sv(cx, view((*b).path)) };
    if raw_bname.len == 0 || (raw_bname.ptr as usize) == 0 {
        return false;
    }
    let mut start: usize = 0;
    let mut end: usize = raw_bname.len;
    let mut k: usize = 0;
    while k < raw_bname.len {
        let ch = unsafe { *(raw_bname.ptr + k) };
        if ch == 60u8 {
            end = k;
            break;
        }
        if ch == 46u8 {
            start = k + 1;
        }
        k = k + 1;
    }
    if end <= start {
        return false;
    }
    let bname = StrView { ptr: unsafe { raw_bname.ptr + start }, len: end - start };
    sv_is_fnonce_name(view(bname))
}

fn tc_item_has_fnonce_bound(cx: view<TypeckCtx>, def: *const HirItem) -> bool {
    let gps: *mut HirGenericParams = unsafe { (*def).generic_params };
    if (gps as usize) != 0 {
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while (gp as usize) != 0 {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while (b as usize) != 0 {
                if tc_bound_is_fnonce(cx, b) {
                    return true;
                }
                b = unsafe { (*b).next };
            }
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*def).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while (wp as usize) != 0 {
            let mut wb: *mut HirType = unsafe { (*wp).bounds };
            while (wb as usize) != 0 {
                if tc_bound_is_fnonce(cx, wb) {
                    return true;
                }
                wb = unsafe { (*wb).next };
            }
            wp = unsafe { (*wp).next };
        }
    }
    false
}

fn tc_item_spawn_attr_kind(cx: view<TypeckCtx>, it: *const HirItem) -> u8 {
    if (it as usize) == 0 || (cx.str_in as usize) == 0 {
        return 0u8;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        let aname_v = unsafe { (*at).name.v };
        if aname_v != 0u32 {
            let asv = unsafe { interner_get(view(*cx.str_in), (StrId { v: aname_v })) };
            let dk = sv_is_spawn_name(view(asv));
            if dk != 0u8 {
                return dk;
            }
            if sv_is_spawn_blocking_name(view(asv)) {
                return 1u8;
            }
            if asv.len == 4 && (asv.ptr as usize) != 0 && unsafe {
                *(asv.ptr + 0) == 108u8 && *(asv.ptr + 1) == 97u8 &&
                *(asv.ptr + 2) == 110u8 && *(asv.ptr + 3) == 103u8
            } {
                let a_arg: *mut HirAttrArg = unsafe { (*at).args };
                if (a_arg as usize) != 0 {
                    let aname_arg_v = unsafe { (*a_arg).name.v };
                    if aname_arg_v != 0u32 {
                        let nsv = unsafe { interner_get(view(*cx.str_in), (StrId { v: aname_arg_v })) };
                        let nk = sv_is_spawn_name(view(nsv));
                        if nk != 0u8 { return nk; }
                        if sv_is_spawn_blocking_name(view(nsv)) { return 1u8; }
                    }
                    let aexpr: *mut HirExpr = unsafe { (*a_arg).expr };
                    if (aexpr as usize) != 0 {
                        if unsafe { (*aexpr).kind == HIR_EXPR_LITERAL } {
                            let sptr = unsafe { (*aexpr).literal.str_ptr };
                            let slen = unsafe { (*aexpr).literal.str_len };
                            if (sptr as usize) != 0 && slen > 0 {
                                let lsv = StrView { ptr: sptr, len: slen };
                                let lk = sv_is_spawn_name(view(lsv));
                                if lk != 0u8 { return lk; }
                                if sv_is_spawn_blocking_name(view(lsv)) { return 1u8; }
                            }
                        } else if unsafe { (*aexpr).kind == HIR_EXPR_PATH && (*aexpr).path.name.v != 0u32 } {
                            let psv = unsafe { interner_get(view(*cx.str_in), (*aexpr).path.name) };
                            let pk = sv_is_spawn_name(view(psv));
                            if pk != 0u8 { return pk; }
                            if sv_is_spawn_blocking_name(view(psv)) { return 1u8; }
                        }
                    }
                }
            }
        }
        at = unsafe { (*at).next };
    }
    0u8
}

fn tc_receiver_spawn_method_kind(cx: view<TypeckCtx>, recv: *const HirExpr, mname_sv: view<StrView>) -> u8 {
    if (recv as usize) == 0 || (cx.thir as usize) == 0 || (cx.str_in as usize) == 0 {
        return 0u8;
    }
    let k = sv_is_spawn_name(mname_sv);
    let is_blocking = if k == 0u8 { sv_is_spawn_blocking_name(mname_sv) } else { false };
    if k == 0u8 && !is_blocking {
        return 0u8;
    }
    let mut tid = unsafe { thir_get_expr_type(view(*cx.thir), recv) };
    if tid.v == 0u32 {
        return 0u8;
    }
    let mut t = unsafe { type_get(view((*cx.thir).interner), tid) };
    while (t as usize) != 0 && (unsafe { (*t).kind == TY_VIEW || (*t).kind == TY_MUT_VIEW || (*t).kind == TY_PTR }) {
        tid = unsafe { (*t).pointee };
        t = unsafe { type_get(view((*cx.thir).interner), tid) };
    }
    if (t as usize) == 0 || unsafe { (*t).kind != TY_STRUCT } {
        return 0u8;
    }
    let sdef = unsafe { (*t).def };
    if (sdef as usize) == 0 || unsafe { (*sdef).name.v == 0u32 } {
        return 0u8;
    }
    let sv = unsafe { interner_get(view(*cx.str_in), (*sdef).name) };
    if (sv.ptr as usize) == 0 {
        return 0u8;
    }
    // "Scope" (len 5) — kept compatible with legacy `tests/ui/concurrency/data_race/*` stubs.
    if sv.len == 5 && unsafe {
        *(sv.ptr + 0) == 83u8 && *(sv.ptr + 1) == 99u8 && *(sv.ptr + 2) == 111u8 &&
        *(sv.ptr + 3) == 112u8 && *(sv.ptr + 4) == 101u8
    } {
        if k == 1u8 || k == 4u8 {
            return 4u8;
        }
        return 0u8;
    }
    // `Executor`, `Builder`, and `LocalExecutor` receiver fallback applies only to `std.*` structs.
    if !(unsafe { tc_item_is_std_module(view(*cx.str_in), sdef) }) {
        return 0u8;
    }
    // "Executor" (len 8)
    if sv.len == 8 && unsafe {
        *(sv.ptr + 0) == 69u8 && *(sv.ptr + 1) == 120u8 && *(sv.ptr + 2) == 101u8 &&
        *(sv.ptr + 3) == 99u8 && *(sv.ptr + 4) == 117u8 && *(sv.ptr + 5) == 116u8 &&
        *(sv.ptr + 6) == 111u8 && *(sv.ptr + 7) == 114u8
    } {
        if k == 1u8 || is_blocking {
            return 1u8;
        }
        return 0u8;
    }
    // "Builder" (len 7)
    if sv.len == 7 && unsafe {
        *(sv.ptr + 0) == 66u8 && *(sv.ptr + 1) == 117u8 && *(sv.ptr + 2) == 105u8 &&
        *(sv.ptr + 3) == 108u8 && *(sv.ptr + 4) == 100u8 && *(sv.ptr + 5) == 101u8 &&
        *(sv.ptr + 6) == 114u8
    } {
        if k == 1u8 {
            return 1u8;
        }
        return 0u8;
    }
    // "LocalExecutor" (len 13)
    if sv.len == 13 && unsafe {
        *(sv.ptr + 0) == 76u8 && *(sv.ptr + 1) == 111u8 && *(sv.ptr + 2) == 99u8 &&
        *(sv.ptr + 3) == 97u8 && *(sv.ptr + 4) == 108u8 && *(sv.ptr + 5) == 69u8 &&
        *(sv.ptr + 6) == 120u8 && *(sv.ptr + 7) == 101u8 && *(sv.ptr + 8) == 99u8 &&
        *(sv.ptr + 9) == 117u8 && *(sv.ptr + 10) == 116u8 && *(sv.ptr + 11) == 111u8 &&
        *(sv.ptr + 12) == 114u8
    } {
        if k == 2u8 {
            return 2u8;
        }
        return 0u8;
    }
    0u8
}

fn tc_resolve_call_def(cx: view<TypeckCtx>, callee: *const HirExpr) -> *const HirItem {
    if (callee as usize) == 0 {
        return 0 as *const HirItem;
    }
    if (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
        let sym_v = unsafe { (*callee).path.symbol.v };
        if sym_v != 0u32 {
            return find_item_by_symbol(cx, SymbolId { v: sym_v });
        }
        let name_v = unsafe { (*callee).path.name.v };
        if name_v != 0u32 && (cx.hir as usize) != 0 {
            let mut it: *mut HirItem = unsafe { (*cx.hir).items };
            while (it as usize) != 0 {
                if (unsafe { (*it).kind }) == HIR_ITEM_FN && (unsafe { (*it).name.v }) == name_v {
                    return it;
                }
                it = unsafe { (*it).next };
            }
        }
    }
    0 as *const HirItem
}

fn tc_def_is_free_spawn_fn(cx: view<TypeckCtx>, def: *const HirItem) -> u8 {
    if (def as usize) == 0 || (cx.str_in as usize) == 0 || (unsafe { (*def).kind }) != HIR_ITEM_FN {
        return 0u8;
    }
    let ak = tc_item_spawn_attr_kind(cx, def);
    if ak != 0u8 {
        return ak;
    }
    let dn_v = unsafe { (*def).name.v };
    if dn_v == 0u32 {
        return 0u8;
    }
    let dsv = unsafe { interner_get(view(*cx.str_in), (StrId { v: dn_v })) };
    let mut k = sv_is_spawn_name(view(dsv));
    if k == 0u8 && sv_is_spawn_blocking_name(view(dsv)) {
        k = 1u8;
    }
    if k == 0u8 {
        return 0u8;
    }
    let p0: *mut HirParam = unsafe { (*def).params };
    if (p0 as usize) == 0 || (unsafe { (*p0).next as usize }) != 0 {
        return 0u8;
    }
    let pty: *mut HirType = unsafe { (*p0).ty };
    if (pty as usize) == 0 || (unsafe { (*pty).kind }) != HIR_TYPE_PATH {
        return 0u8;
    }
    if unsafe { tc_item_is_std_module(view(*cx.str_in), def) } {
        return k;
    }
    if !tc_item_has_fnonce_bound(cx, def) {
        return 0u8;
    }
    k
}

fn classify_spawn_call(cx: view<TypeckCtx>, expr: *const HirExpr) -> u8 {
    if (expr as usize) == 0 || (cx.str_in as usize) == 0 {
        return 0u8;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_CALL {
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        let def = tc_resolve_call_def(cx, callee);
        if (def as usize) != 0 {
            return tc_def_is_free_spawn_fn(cx, def);
        }
        return 0u8;
    } else if ek == HIR_EXPR_METHOD_CALL {
        if (cx.thir as usize) != 0 {
            let mp = unsafe { thir_get_expr_method(view(*cx.thir), expr) };
            if (mp as usize) != 0 && (unsafe { *mp as usize }) != 0 {
                let ak = tc_item_spawn_attr_kind(cx, unsafe { *mp });
                if ak != 0u8 {
                    return ak;
                }
            }
        }
        let mn_v = unsafe { (*expr).method_name.v };
        if mn_v != 0u32 {
            let sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: mn_v })) };
            return tc_receiver_spawn_method_kind(cx, unsafe { (*expr).receiver as *const HirExpr }, view(sv));
        }
    }
    0u8
}

