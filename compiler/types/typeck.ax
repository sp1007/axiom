pub const AX_TYPE_UNKNOWN_INTRINSIC: u32 = 133u32;

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct LitCheck {
    pub span: Span,
    pub neg_span: Span,
    pub value: u64,
    pub ty: TypeId,
    pub negated: bool,
}

pub struct NegCheck {
    pub span: Span,
    pub ty: TypeId,
}

pub struct VarState {
    pub sym: SymbolId,
    pub is_mut: bool,
    pub is_init: bool,
}

pub struct LoopEnv {
    pub label: StrId,
    pub break_ty: TypeId,
    pub has_break: bool,
}

pub struct RawCapture {
    pub sym: SymbolId,
    pub is_mutated: bool,
    pub is_moved: bool,
    pub is_read: bool,
}

pub struct TypeckCtx {
    pub hir: *mut HirFile,
    pub thir: *mut Thir,
    pub sink: *mut DiagSink,
    pub str_in: *mut StrInterner,
    pub db: *const SourceDatabase,
    pub type_vars: TypeVarTable,
    pub return_type: TypeId,
    pub in_loop: bool,
    pub lits: *mut LitCheck,
    pub lits_len: usize,
    pub lits_cap: usize,
    pub negs: *mut NegCheck,
    pub negs_len: usize,
    pub negs_cap: usize,
    pub vars: *mut VarState,
    pub vars_len: usize,
    pub vars_cap: usize,
    pub loops: *mut LoopEnv,
    pub loops_len: usize,
    pub loops_cap: usize,
    pub current_fn: *const HirItem,
    pub current_impl: *const HirItem,
    pub self_ty: TypeId,
    pub next_closure_id: u32,
    pub evaluator: *const ConstEvaluator,
    pub const_eval_stack: *mut SymbolId,
    pub const_eval_stack_len: usize,
    pub const_eval_stack_cap: usize,
}

unsafe fn litcheck_at(base: *mut LitCheck, idx: usize) -> *mut LitCheck {
    let off = mul_usize(idx, size_of<LitCheck>());
    ((base as usize) + off) as *mut LitCheck
}

unsafe fn negcheck_at(base: *mut NegCheck, idx: usize) -> *mut NegCheck {
    let off = mul_usize(idx, size_of<NegCheck>());
    ((base as usize) + off) as *mut NegCheck
}

unsafe fn varstate_at(base: *mut VarState, idx: usize) -> *mut VarState {
    let off = mul_usize(idx, size_of<VarState>());
    ((base as usize) + off) as *mut VarState
}

unsafe fn loopenv_at(base: *mut LoopEnv, idx: usize) -> *mut LoopEnv {
    let off = mul_usize(idx, size_of<LoopEnv>());
    ((base as usize) + off) as *mut LoopEnv
}

unsafe fn rawcap_at(base: *mut RawCapture, idx: usize) -> *mut RawCapture {
    let off = mul_usize(idx, size_of<RawCapture>());
    ((base as usize) + off) as *mut RawCapture
}

unsafe fn symid_at(base: *mut SymbolId, idx: usize) -> *mut SymbolId {
    let off = mul_usize(idx, size_of<SymbolId>());
    ((base as usize) + off) as *mut SymbolId
}

unsafe fn strid_at_const(base: *const StrId, idx: usize) -> *const StrId {
    let off = mul_usize(idx, size_of<StrId>());
    ((base as usize) + off) as *const StrId
}

fn tc_zero_bytes(ptr: *mut u8, n: usize) {
    let mut i: usize = 0;
    while (i < n) {
        unsafe { *(ptr + i) = 0u8; }
        i = i + 1;
    }
}

pub fn thir_get_expr_type(thir: view<Thir>, expr: *const HirExpr) -> TypeId {
    let p = ptr_typemap_get(view(thir.expr_types), expr as usize);
    if (p as usize) == 0 { return (TypeId { v: 0u32 }); }
    let v = unsafe { (*p).v };
    (TypeId { v: v })
}

pub fn thir_get_pat_type(thir: view<Thir>, pat: *const HirPat) -> TypeId {
    let p = ptr_typemap_get(view(thir.pat_types), pat as usize);
    if (p as usize) == 0 { return (TypeId { v: 0u32 }); }
    let v = unsafe { (*p).v };
    (TypeId { v: v })
}

pub fn thir_get_item_type(thir: view<Thir>, item: *const HirItem) -> TypeId {
    let p = ptr_typemap_get(view(thir.item_types), item as usize);
    if (p as usize) == 0 { return (TypeId { v: 0u32 }); }
    let v = unsafe { (*p).v };
    (TypeId { v: v })
}

pub fn thir_get_param_type(thir: view<Thir>, param: *const HirParam) -> TypeId {
    let p = ptr_typemap_get(view(thir.param_types), param as usize);
    if (p as usize) == 0 { return (TypeId { v: 0u32 }); }
    let v = unsafe { (*p).v };
    (TypeId { v: v })
}

pub fn thir_get_symbol_type(thir: view<Thir>, sym: SymbolId) -> TypeId {
    let p = thir_get_sym_type(thir, (SymbolId { v: sym.v }));
    if (p as usize) == 0 { return (TypeId { v: 0u32 }); }
    let v = unsafe { (*p).v };
    (TypeId { v: v })
}

pub fn thir_set_symbol_type(thir: mut_view<Thir>, sym: SymbolId, ty: TypeId) {
    thir_set_sym_type(thir, (SymbolId { v: sym.v }), (TypeId { v: ty.v }));
}

fn ptr_usizemap_insert(m: mut_view<PtrU32Map>, key: usize, val: usize) {
    ptr_u32map_insert(m, key, val as u32);
}

fn subst_ty_with_vars(
    ti: mut_view<TypeInterner>,
    tv: mut_view<TypeVarTable>,
    ty: TypeId,
    args: view<GenericArgsSlice>
) -> TypeId {
    subst_type_with_vars((TypeId { v: ty.v }), args, tv, ti)
}

pub fn intern_fn_ty_full(
    ti: mut_view<TypeInterner>,
    is_unsafe: bool,
    abi: StrId,
    param_types: *mut TypeId,
    param_count: usize,
    ret_type: TypeId,
    def: *const HirItem
) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_FN);
        (*sp).is_unsafe = is_unsafe;
        (*sp).abi.v = abi.v;
        (*sp).param_types = param_types;
        (*sp).param_count = param_count;
        (*sp).ret_type.v = ret_type.v;
        (*sp).def = def;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_closure_ty(
    ti: mut_view<TypeInterner>,
    closure_id: u32,
    fn_sym: u32,
    fn_type: TypeId,
    ret_type: TypeId,
    param_types: *mut TypeId,
    param_count: usize,
    captures: *mut ClosureCapture,
    capture_count: usize
) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_CLOSURE);
        (*sp).closure_id = closure_id;
        (*sp).fn_sym = fn_sym;
        (*sp).fn_type.v = fn_type.v;
        (*sp).ret_type.v = ret_type.v;
        (*sp).param_types = param_types;
        (*sp).param_count = param_count;
        (*sp).captures = captures;
        (*sp).capture_count = capture_count;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_struct_ty(
    ti: mut_view<TypeInterner>,
    is_repr_c: bool,
    def: *const HirItem,
    fields: *mut TypeId,
    field_count: usize,
    args: *mut TypeId,
    arg_count: usize
) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_STRUCT);
        (*sp).is_repr_c = is_repr_c;
        (*sp).def = def;
        (*sp).fields = fields;
        (*sp).field_count = field_count;
        (*sp).args = args;
        (*sp).arg_count = arg_count;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_enum_ty(
    ti: mut_view<TypeInterner>,
    def: *const HirItem,
    args: *mut TypeId,
    arg_count: usize,
    variant_fields: *mut *mut TypeId,
    variant_field_counts: *mut usize,
    variant_count: usize
) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_ENUM);
        (*sp).def = def;
        (*sp).args = args;
        (*sp).arg_count = arg_count;
        (*sp).variant_fields = variant_fields;
        (*sp).variant_field_counts = variant_field_counts;
        (*sp).variant_count = variant_count;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

fn tc_sv_is_1(sv: view<StrView>, c0: u8) -> bool {
    if sv.len != 1 || (sv.ptr as usize) == 0 { return false; }
    unsafe { *(sv.ptr + 0) == c0 }
}

