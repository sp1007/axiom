struct ThirDumpState {
    buf: *mut DiagBuffer,
    interner: *const StrInterner,
    thir: *const Thir,
    hir_items: *mut HirItem,
    indent: i32,
    filter_file: FileId,
}

fn td_str(st: mut_view<ThirDumpState>, idx: usize) {
    let start = THIR_OFF[idx] as usize;
    let end = THIR_OFF[idx + 1] as usize;
    let mut i = start;
    while (i < end) {
        unsafe { diag_buf_push_byte(mut_view(*st.buf), THIR_DATA[i]); }
        i = i + 1;
    }
}

fn td_nl(st: mut_view<ThirDumpState>) {
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 10u8); }
    let mut i: i32 = 0;
    while (i < st.indent) {
        td_str(mut_view(*st), 0);
        i = i + 1;
    }
}

fn td_begin(st: mut_view<ThirDumpState>, idx: usize) {
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 40u8); }
    td_str(mut_view(*st), idx);
    st.indent = st.indent + 1;
}

fn td_end(st: mut_view<ThirDumpState>) {
    st.indent = st.indent - 1;
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 41u8); }
}

fn td_strid(st: mut_view<ThirDumpState>, id: StrId) {
    if id.v == 0u32 {
        td_str(mut_view(*st), 2);
        return;
    }
    let sv = unsafe { interner_get(view(*st.interner), (StrId { v: id.v })) };
    td_str(mut_view(*st), 1);
    unsafe {
        diag_buf_push_bytes(mut_view(*st.buf), sv.ptr, sv.len);
        diag_buf_push_byte(mut_view(*st.buf), 34u8);
    }
}

fn td_bool(st: mut_view<ThirDumpState>, b: bool) {
    if b {
        td_str(mut_view(*st), 3);
    } else {
        td_str(mut_view(*st), 4);
    }
}

fn td_u32(st: mut_view<ThirDumpState>, v: u32) {
    unsafe {
        diag_buf_push_byte(mut_view(*st.buf), 32u8);
        diag_buf_push_u32(mut_view(*st.buf), v);
    }
}

fn td_symbol(st: mut_view<ThirDumpState>, sym: SymbolId) {
    if sym.v != 0u32 {
        td_str(mut_view(*st), 5);
        unsafe { diag_buf_push_u32(mut_view(*st.buf), sym.v); }
    }
}

fn td_typeid(st: mut_view<ThirDumpState>, id: TypeId) {
    if id.v == 0u32 {
        td_str(mut_view(*st), 87);
        return;
    }
    let t = unsafe { type_get(view((*st.thir).interner), (TypeId { v: id.v })) };
    if (t as usize) == 0 {
        td_str(mut_view(*st), 87);
        return;
    }
    td_str(mut_view(*st), 88);
    let k = unsafe { (*t).kind };
    if k == TY_ERROR {
        td_str(mut_view(*st), 89);
    } else if k == TY_UNIT {
        td_str(mut_view(*st), 90);
    } else if k == TY_NEVER {
        td_str(mut_view(*st), 91);
    } else if k == TY_BOOL {
        td_str(mut_view(*st), 92);
    } else if k == TY_CHAR {
        td_str(mut_view(*st), 93);
    } else if k == TY_I8 {
        td_str(mut_view(*st), 94);
    } else if k == TY_I16 {
        td_str(mut_view(*st), 95);
    } else if k == TY_I32 {
        td_str(mut_view(*st), 96);
    } else if k == TY_I64 {
        td_str(mut_view(*st), 97);
    } else if k == TY_I128 {
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 105u8);
            diag_buf_push_byte(mut_view(*st.buf), 49u8);
            diag_buf_push_byte(mut_view(*st.buf), 50u8);
            diag_buf_push_byte(mut_view(*st.buf), 56u8);
        }
    } else if k == TY_ISIZE {
        td_str(mut_view(*st), 98);
    } else if k == TY_U8 {
        td_str(mut_view(*st), 99);
    } else if k == TY_U16 {
        td_str(mut_view(*st), 100);
    } else if k == TY_U32 {
        td_str(mut_view(*st), 101);
    } else if k == TY_U64 {
        td_str(mut_view(*st), 102);
    } else if k == TY_U128 {
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 117u8);
            diag_buf_push_byte(mut_view(*st.buf), 49u8);
            diag_buf_push_byte(mut_view(*st.buf), 50u8);
            diag_buf_push_byte(mut_view(*st.buf), 56u8);
        }
    } else if k == TY_USIZE {
        td_str(mut_view(*st), 103);
    } else if k == TY_STR {
        td_str(mut_view(*st), 104);
    } else if k == TY_BUILTIN_LEN {
        td_str(mut_view(*st), 105);
    } else if k == TY_BUILTIN_PRINT {
        td_str(mut_view(*st), 106);
    } else if k == TY_BUILTIN_PRINT_INT {
        td_str(mut_view(*st), 107);
    } else if k == TY_FN {
        td_str(mut_view(*st), 108);
        let pcnt = unsafe { (*t).param_count };
        let ptypes: *mut TypeId = unsafe { (*t).param_types };
        let mut i: usize = 0;
        while (i < pcnt) {
            if i > 0 {
                td_str(mut_view(*st), 109);
            }
            let pt_v = unsafe { (*typeid_at(ptypes, i)).v };
            td_typeid(mut_view(*st), (TypeId { v: pt_v }));
            i = i + 1;
        }
        td_str(mut_view(*st), 110);
        let rt_v = unsafe { (*t).ret_type.v };
        td_typeid(mut_view(*st), (TypeId { v: rt_v }));
    } else if k == TY_F32 || k == TY_F64 {
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 102u8);
            diag_buf_push_byte(mut_view(*st.buf), if k == TY_F32 { 51u8 } else { 54u8 });
            diag_buf_push_byte(mut_view(*st.buf), if k == TY_F32 { 50u8 } else { 52u8 });
        }
    } else if k == TY_FLOAT_VAR {
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 123u8);
            diag_buf_push_byte(mut_view(*st.buf), 102u8);
            diag_buf_push_byte(mut_view(*st.buf), 108u8);
            diag_buf_push_byte(mut_view(*st.buf), 111u8);
            diag_buf_push_byte(mut_view(*st.buf), 97u8);
            diag_buf_push_byte(mut_view(*st.buf), 116u8);
            diag_buf_push_byte(mut_view(*st.buf), 125u8);
        }
    } else if k == TY_INT_VAR {
        td_str(mut_view(*st), 111);
        let vid = unsafe { (*t).var_id };
        unsafe { diag_buf_push_u32(mut_view(*st.buf), vid); }
    } else if k == TY_COROUTINE {
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 67u8);
            diag_buf_push_byte(mut_view(*st.buf), 111u8);
            diag_buf_push_byte(mut_view(*st.buf), 114u8);
            diag_buf_push_byte(mut_view(*st.buf), 111u8);
            diag_buf_push_byte(mut_view(*st.buf), 117u8);
            diag_buf_push_byte(mut_view(*st.buf), 116u8);
            diag_buf_push_byte(mut_view(*st.buf), 105u8);
            diag_buf_push_byte(mut_view(*st.buf), 110u8);
            diag_buf_push_byte(mut_view(*st.buf), 101u8);
            diag_buf_push_byte(mut_view(*st.buf), 60u8);
        }
        let rt_v = unsafe { (*t).ret_type.v };
        td_typeid(mut_view(*st), (TypeId { v: rt_v }));
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 62u8);
        }
    }
    td_str(mut_view(*st), 112);
}

fn td_maybe_pat_ty(st: mut_view<ThirDumpState>, pat: *const HirPat) {
    let p = unsafe { ptr_typemap_get(view((*st.thir).pat_types), pat as usize) };
    if (p as usize) != 0 {
        let tv = unsafe { (*p).v };
        td_typeid(st, (TypeId { v: tv }));
    }
}

fn td_maybe_expr_ty(st: mut_view<ThirDumpState>, expr: *const HirExpr) {
    let p = unsafe { ptr_typemap_get(view((*st.thir).expr_types), expr as usize) };
    if (p as usize) != 0 {
        let tv = unsafe { (*p).v };
        td_typeid(st, (TypeId { v: tv }));
    }
}

fn td_dotted(st: mut_view<ThirDumpState>, n: view<AstDottedName>) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 6);
    let mut i: usize = 0;
    while (i < n.count) {
        let off = mul_usize(i, size_of<StrId>());
        let seg_ptr = ((n.segments as usize) + off) as *const StrId;
        td_strid(mut_view(*st), unsafe { *seg_ptr });
        i = i + 1;
    }
    td_end(mut_view(*st));
}

fn td_vis(st: mut_view<ThirDumpState>, n: view<HirVis>) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 7);
    if n.kind == HIR_VIS_PRIVATE {
        td_str(mut_view(*st), 8);
    } else if n.kind == HIR_VIS_PUB {
        td_str(mut_view(*st), 9);
    } else if n.kind == HIR_VIS_PUB_PACKAGE {
        td_str(mut_view(*st), 10);
    } else if n.kind == HIR_VIS_PUB_MODULE {
        td_str(mut_view(*st), 11);
    }
    td_end(mut_view(*st));
}

fn td_attr(st: mut_view<ThirDumpState>, n: *mut HirAttr) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 12);
        td_strid(mut_view(*st), unsafe { (*cur).name });
        let mut a: *mut HirAttrArg = unsafe { (*cur).args };
        while ((a as usize) != 0) {
            td_nl(mut_view(*st));
            td_begin(mut_view(*st), 13);
            td_strid(mut_view(*st), unsafe { (*a).name });
            td_expr(mut_view(*st), unsafe { (*a).expr });
            td_end(mut_view(*st));
            a = unsafe { (*a).next };
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_generic_args(st: mut_view<ThirDumpState>, n: *mut HirGenericArgs) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericArg = unsafe { (*n).args };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 14);
        td_strid(mut_view(*st), unsafe { (*a).name });
        td_type(mut_view(*st), unsafe { (*a).ty });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_generic_params(st: mut_view<ThirDumpState>, n: *mut HirGenericParams) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericParam = unsafe { (*n).params };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 15);
        td_strid(mut_view(*st), unsafe { (*a).name });
        td_type(mut_view(*st), unsafe { (*a).bounds });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_where_clause(st: mut_view<ThirDumpState>, n: *mut HirWhereClause) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirWherePred = unsafe { (*n).preds };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 16);
        td_type(mut_view(*st), unsafe { (*a).ty });
        td_type(mut_view(*st), unsafe { (*a).bounds });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_path(st: mut_view<ThirDumpState>, p: view<HirPath>) {
    td_symbol(mut_view(*st), p.symbol);
    td_generic_args(mut_view(*st), p.generic_args);
}

fn td_block(st: mut_view<ThirDumpState>, n: *mut HirBlock) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 17);
    if (n as usize) != 0 {
        td_stmt(mut_view(*st), unsafe { (*n).stmts });
    }
    td_end(mut_view(*st));
}

fn td_type(st: mut_view<ThirDumpState>, n: *mut HirType) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_TYPE_ERROR {
            td_begin(mut_view(*st), 18);
        } else if k == HIR_TYPE_PATH {
            td_begin(mut_view(*st), 19);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
        } else if k == HIR_TYPE_TUPLE {
            td_begin(mut_view(*st), 20);
            td_type(mut_view(*st), unsafe { (*cur).elem_types });
        } else if k == HIR_TYPE_ARRAY {
            td_begin(mut_view(*st), 21);
            let ce: *mut HirExpr = unsafe { (*cur).count_expr };
            if (ce as usize) != 0 && (unsafe { (*ce).kind }) == HIR_EXPR_LITERAL && (unsafe { (*ce).literal.kind }) == TOK_INT && (unsafe { (*ce).next as usize }) == 0 {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 38);
                td_end(mut_view(*st));
            } else {
                td_expr(mut_view(*st), ce);
            }
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_SLICE {
            td_begin(mut_view(*st), 22);
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_VIEW {
            td_begin(mut_view(*st), 23);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_PTR {
            td_begin(mut_view(*st), 24);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_FN {
            td_begin(mut_view(*st), 25);
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            td_type(mut_view(*st), unsafe { (*cur).param_types });
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
        } else if k == HIR_TYPE_DYN {
            td_begin(mut_view(*st), 26);
            td_type(mut_view(*st), unsafe { (*cur).bounds });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_pat_field(st: mut_view<ThirDumpState>, n: *mut HirPatField) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 27);
        td_strid(mut_view(*st), unsafe { (*cur).name });
        td_pat(mut_view(*st), unsafe { (*cur).pat });
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_pat(st: mut_view<ThirDumpState>, n: *mut HirPat) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_PAT_ERROR {
            td_begin(mut_view(*st), 28);
            td_maybe_pat_ty(mut_view(*st), cur);
        } else if k == HIR_PAT_WILDCARD {
            td_begin(mut_view(*st), 29);
            td_maybe_pat_ty(mut_view(*st), cur);
        } else if k == HIR_PAT_RANGE {
            td_begin(mut_view(*st), 30);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_inclusive });
            td_pat(mut_view(*st), unsafe { (*cur).start_pat });
            td_pat(mut_view(*st), unsafe { (*cur).end_pat });
        } else if k == HIR_PAT_LITERAL {
            td_begin(mut_view(*st), 31);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_negated });
        } else if k == HIR_PAT_BINDING {
            td_begin(mut_view(*st), 32);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_symbol(mut_view(*st), unsafe { (*cur).symbol });
        } else if k == HIR_PAT_PATH {
            td_begin(mut_view(*st), 33);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            td_pat(mut_view(*st), unsafe { (*cur).payload });
        } else if k == HIR_PAT_TUPLE {
            td_begin(mut_view(*st), 34);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).elems });
        } else if k == HIR_PAT_OR {
            td_begin(mut_view(*st), 35);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).pats });
        } else if k == HIR_PAT_STRUCT {
            td_begin(mut_view(*st), 36);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            td_pat_field(mut_view(*st), unsafe { (*cur).fields });
            td_bool(mut_view(*st), unsafe { (*cur).has_rest });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_expr(st: mut_view<ThirDumpState>, n: *mut HirExpr) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_ERROR {
            td_begin(mut_view(*st), 37);
            td_maybe_expr_ty(mut_view(*st), cur);
        } else if k == HIR_EXPR_LITERAL {
            td_begin(mut_view(*st), 38);
            td_maybe_expr_ty(mut_view(*st), cur);
        } else if k == HIR_EXPR_PATH {
            td_begin(mut_view(*st), 39);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
        } else if k == HIR_EXPR_ARRAY {
            td_begin(mut_view(*st), 40);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).elems });
            td_expr(mut_view(*st), unsafe { (*cur).count_expr });
        } else if k == HIR_EXPR_TUPLE {
            td_begin(mut_view(*st), 41);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).elems });
        } else if k == HIR_EXPR_STRUCT {
            td_begin(mut_view(*st), 42);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while ((f as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 43);
                td_strid(mut_view(*st), unsafe { (*f).name });
                td_expr(mut_view(*st), unsafe { (*f).expr });
                td_end(mut_view(*st));
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_BLOCK {
            td_begin(mut_view(*st), 44);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_IF {
            td_begin(mut_view(*st), 45);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).let_pat });
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            td_block(mut_view(*st), unsafe { (*cur).block });
            td_expr(mut_view(*st), unsafe { (*cur).else_branch });
        } else if k == HIR_EXPR_MATCH {
            td_begin(mut_view(*st), 46);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while ((a as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 47);
                td_pat(mut_view(*st), unsafe { (*a).pat });
                td_expr(mut_view(*st), unsafe { (*a).guard });
                td_expr(mut_view(*st), unsafe { (*a).body });
                td_end(mut_view(*st));
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_LOOP {
            td_begin(mut_view(*st), 48);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_WHILE {
            td_begin(mut_view(*st), 49);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_pat(mut_view(*st), unsafe { (*cur).let_pat });
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_FOR {
            td_begin(mut_view(*st), 50);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_pat(mut_view(*st), unsafe { (*cur).pat });
            td_expr(mut_view(*st), unsafe { (*cur).iter });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_UNSAFE {
            td_begin(mut_view(*st), 51);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_VIEW {
            td_begin(mut_view(*st), 52);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_COMPTIME {
            td_begin(mut_view(*st), 53);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_JUMP {
            td_begin(mut_view(*st), 54);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).jump_kind }) as u32);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CLOSURE {
            td_begin(mut_view(*st), 55);
            td_maybe_expr_ty(mut_view(*st), cur);
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while ((p as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 56);
                td_bool(mut_view(*st), unsafe { (*p).is_mut });
                td_symbol(mut_view(*st), unsafe { (*p).symbol });
                td_type(mut_view(*st), unsafe { (*p).ty });
                td_end(mut_view(*st));
                p = unsafe { (*p).next };
            }
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
            td_expr(mut_view(*st), unsafe { (*cur).body });
        } else if k == HIR_EXPR_RANGE {
            td_begin(mut_view(*st), 57);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_inclusive });
            td_expr(mut_view(*st), unsafe { (*cur).start_expr });
            td_expr(mut_view(*st), unsafe { (*cur).end_expr });
        } else if k == HIR_EXPR_BINARY {
            td_begin(mut_view(*st), 58);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).op }) as u32);
            td_expr(mut_view(*st), unsafe { (*cur).left });
            td_expr(mut_view(*st), unsafe { (*cur).right });
        } else if k == HIR_EXPR_UNARY {
            td_begin(mut_view(*st), 59);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).op }) as u32);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CAST {
            td_begin(mut_view(*st), 60);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
            td_type(mut_view(*st), unsafe { (*cur).cast_ty });
        } else if k == HIR_EXPR_FIELD {
            td_begin(mut_view(*st), 61);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_args(mut_view(*st), unsafe { (*cur).generic_args });
        } else if k == HIR_EXPR_TUPLE_INDEX {
            td_begin(mut_view(*st), 62);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_u32(mut_view(*st), unsafe { (*cur).tuple_index });
        } else if k == HIR_EXPR_CALL {
            td_begin(mut_view(*st), 63);
            td_maybe_expr_ty(mut_view(*st), cur);
            let callee: *mut HirExpr = unsafe { (*cur).callee };
            let mut dumped_inferred_callee = false;
            // axiom0 records an intrinsic callee with its builtin singleton type (printed as an
            // empty `<Type >`); only a callee typed as a plain fn shows the uninstantiated fn type.
            let mut callee_is_fn = false;
            if (callee as usize) != 0 {
                let cty = unsafe { thir_get_expr_type(view(*st.thir), callee) };
                if cty.v != 0u32 {
                    let ct = unsafe { type_get(view((*st.thir).interner), TypeId { v: cty.v }) };
                    callee_is_fn = (ct as usize) != 0 && (unsafe { (*ct).kind }) == TY_FN;
                }
            }
            if callee_is_fn && (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH && (unsafe { (*callee).next as usize }) == 0 && (unsafe { (*callee).path.generic_args as usize }) == 0 {
                let sp = unsafe { ptr_substmap_get(view((*st.thir).expr_substs), callee as usize) };
                if (sp as usize) != 0 && (unsafe { (*sp).count }) > 0 {
                    let csym = unsafe { (*callee).path.symbol };
                    if csym.v != 0u32 {
                        let mut raw_ty_v: u32 = 0u32;
                        let mut dit: *mut HirItem = st.hir_items;
                        while ((dit as usize) != 0) {
                            let dik = unsafe { (*dit).kind };
                            if dik == HIR_ITEM_FN && (unsafe { (*dit).symbol.v }) == csym.v && (unsafe { (*dit).span.file.v }) != 0xFFFFFFFEu32 {
                                let it_ty = unsafe { thir_get_item_type(view(*st.thir), dit) };
                                raw_ty_v = it_ty.v;
                                break;
                            }
                            dit = unsafe { (*dit).next };
                        }
                        if raw_ty_v == 0u32 {
                            let st_ptr = unsafe { thir_get_sym_type(view(*st.thir), (SymbolId { v: csym.v })) };
                            if (st_ptr as usize) != 0 {
                                raw_ty_v = unsafe { (*st_ptr).v };
                            }
                        }
                        if raw_ty_v != 0u32 {
                            let ax = unsafe { type_get(view((*st.thir).interner), TypeId { v: raw_ty_v }) };
                            if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_FN {
                                td_nl(mut_view(*st));
                                td_begin(mut_view(*st), 39);
                                td_typeid(mut_view(*st), TypeId { v: raw_ty_v });
                                td_path(mut_view(*st), unsafe { view((*callee).path) });
                                td_end(mut_view(*st));
                                dumped_inferred_callee = true;
                            }
                        }
                    }
                }
            }
            if !dumped_inferred_callee {
                td_expr(mut_view(*st), callee);
            }
            td_expr(mut_view(*st), unsafe { (*cur).args });
        } else if k == HIR_EXPR_METHOD_CALL {
            td_begin(mut_view(*st), 64);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).receiver });
            td_strid(mut_view(*st), unsafe { (*cur).method_name });
            td_generic_args(mut_view(*st), unsafe { (*cur).generic_args });
            td_expr(mut_view(*st), unsafe { (*cur).args });
        } else if k == HIR_EXPR_INDEX {
            td_begin(mut_view(*st), 65);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_expr(mut_view(*st), unsafe { (*cur).index_arg });
        } else if k == HIR_EXPR_TRY {
            td_begin(mut_view(*st), 66);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_AWAIT {
            td_begin(mut_view(*st), 67);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_use_tree(st: mut_view<ThirDumpState>, n: *mut HirUseTree) {
    if (n as usize) == 0 {
        return;
    }
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 68);
    td_dotted(mut_view(*st), unsafe { view((*n).path) });
    if (unsafe { (*n).alias.v }) != 0u32 {
        td_strid(mut_view(*st), unsafe { (*n).alias });
    }
    if (unsafe { (*n).subtrees as usize }) != 0 {
        td_use_tree(mut_view(*st), unsafe { (*n).subtrees });
    }
    td_end(mut_view(*st));
    if (unsafe { (*n).next as usize }) != 0 {
        td_use_tree(mut_view(*st), unsafe { (*n).next });
    }
}

fn td_stmt(st: mut_view<ThirDumpState>, n: *mut HirStmt) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_STMT_ERROR {
            td_begin(mut_view(*st), 69);
        } else if k == HIR_STMT_LET {
            td_begin(mut_view(*st), 70);
            td_pat(mut_view(*st), unsafe { (*cur).pat });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
            if (unsafe { (*cur).else_block as usize }) != 0 {
                td_block(mut_view(*st), unsafe { (*cur).else_block });
            }
        } else if k == HIR_STMT_ASSIGN {
            td_begin(mut_view(*st), 71);
            td_expr(mut_view(*st), unsafe { (*cur).left });
            td_expr(mut_view(*st), unsafe { (*cur).right });
        } else if k == HIR_STMT_EXPR {
            td_begin(mut_view(*st), 72);
            td_bool(mut_view(*st), unsafe { (*cur).has_semi });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_item(st: mut_view<ThirDumpState>, n: *mut HirItem) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        if (unsafe { (*cur).span.file.v }) == 0xFFFFFFFEu32 {
            cur = unsafe { (*cur).next };
            continue;
        }
        if st.filter_file.v != 0u32 && (unsafe { (*cur).span.file.v }) != 0u32 && (unsafe { (*cur).span.file.v }) != st.filter_file.v {
            cur = unsafe { (*cur).next };
            continue;
        }
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_ITEM_ERROR {
            td_begin(mut_view(*st), 73);
        } else if k == HIR_ITEM_MODULE {
            td_begin(mut_view(*st), 74);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_dotted(mut_view(*st), unsafe { view((*cur).mod_path) });
        } else if k == HIR_ITEM_USE {
            td_begin(mut_view(*st), 75);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_use_tree(mut_view(*st), unsafe { (*cur).use_tree });
        } else if k == HIR_ITEM_FN {
            td_begin(mut_view(*st), 76);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_bool(mut_view(*st), unsafe { (*cur).is_async });
            td_bool(mut_view(*st), unsafe { (*cur).is_comptime });
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            let orig_np = unsafe { thir_get_orig_item_name(view(*st.thir), cur as *const HirItem) };
            let fn_name_id = if (orig_np as usize) != 0 {
                StrId { v: unsafe { *orig_np } }
            } else {
                unsafe { (*cur).name }
            };
            td_strid(mut_view(*st), fn_name_id);
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while ((p as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 56);
                td_bool(mut_view(*st), unsafe { (*p).is_mut });
                td_symbol(mut_view(*st), unsafe { (*p).symbol });
                td_type(mut_view(*st), unsafe { (*p).ty });
                td_end(mut_view(*st));
                p = unsafe { (*p).next };
            }
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            if (unsafe { (*cur).body as usize }) != 0 {
                td_block(mut_view(*st), unsafe { (*cur).body });
            }
        } else if k == HIR_ITEM_STRUCT {
            td_begin(mut_view(*st), 77);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_bool(mut_view(*st), unsafe { (*cur).is_tuple });
            if unsafe { (*cur).is_tuple } {
                td_type(mut_view(*st), unsafe { (*cur).tuple_types });
            } else {
                let mut f: *mut HirFieldDecl = unsafe { (*cur).struct_fields };
                while ((f as usize) != 0) {
                    td_nl(mut_view(*st));
                    td_begin(mut_view(*st), 78);
                    td_attr(mut_view(*st), unsafe { (*f).attrs });
                    td_vis(mut_view(*st), unsafe { view((*f).vis) });
                    td_strid(mut_view(*st), unsafe { (*f).name });
                    td_type(mut_view(*st), unsafe { (*f).ty });
                    td_end(mut_view(*st));
                    f = unsafe { (*f).next };
                }
            }
        } else if k == HIR_ITEM_ENUM {
            td_begin(mut_view(*st), 79);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            let mut v: *mut HirVariantDecl = unsafe { (*cur).variants };
            while ((v as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 80);
                td_attr(mut_view(*st), unsafe { (*v).attrs });
                td_strid(mut_view(*st), unsafe { (*v).name });
                td_bool(mut_view(*st), unsafe { (*v).is_struct });
                if unsafe { (*v).is_struct } {
                    let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                    while ((f as usize) != 0) {
                        td_nl(mut_view(*st));
                        td_begin(mut_view(*st), 78);
                        td_attr(mut_view(*st), unsafe { (*f).attrs });
                        td_vis(mut_view(*st), unsafe { view((*f).vis) });
                        td_strid(mut_view(*st), unsafe { (*f).name });
                        td_type(mut_view(*st), unsafe { (*f).ty });
                        td_end(mut_view(*st));
                        f = unsafe { (*f).next };
                    }
                } else {
                    td_type(mut_view(*st), unsafe { (*v).tuple_types });
                }
                td_end(mut_view(*st));
                v = unsafe { (*v).next };
            }
        } else if k == HIR_ITEM_TRAIT {
            td_begin(mut_view(*st), 81);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).supertraits });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_item(mut_view(*st), unsafe { (*cur).members });
        } else if k == HIR_ITEM_IMPL {
            td_begin(mut_view(*st), 82);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).trait_path });
            td_type(mut_view(*st), unsafe { (*cur).self_type });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_item(mut_view(*st), unsafe { (*cur).members });
        } else if k == HIR_ITEM_TYPE_ALIAS {
            td_begin(mut_view(*st), 83);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).ty });
        } else if k == HIR_ITEM_CONST {
            td_begin(mut_view(*st), 84);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_STATIC {
            td_begin(mut_view(*st), 85);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_EXTERN_BLOCK {
            td_begin(mut_view(*st), 86);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            td_item(mut_view(*st), unsafe { (*cur).members });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

pub fn emit_thir(
    buf: mut_view<DiagBuffer>,
    hir_file: view<HirFile>,
    thir: view<Thir>,
    interner: view<StrInterner>,
    filter_file: FileId
) {
    let buf_ptr = unsafe { address_of_mut(buf.ptr) as *mut DiagBuffer };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let mut st = ThirDumpState {
        buf: buf_ptr,
        interner: int_ptr,
        thir: thir_ptr,
        hir_items: hir_file.items,
        indent: 0,
        filter_file: (FileId { v: filter_file.v }),
    };
    td_item(mut_view(st), hir_file.items);
    unsafe { diag_buf_push_byte(mut_view(*buf_ptr), 10u8); }
}

fn tc_item_has_blocking_attr(it: *const HirItem, str_in: view<StrInterner>) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        let aname = unsafe { (*at).name };
        if aname.v != 0u32 {
            let sv = interner_get(str_in, StrId { v: aname.v });
            if tc_sv_is_8(view(sv), 98u8, 108u8, 111u8, 99u8, 107u8, 105u8, 110u8, 103u8) {
                return true;
            }
        }
        at = unsafe { (*at).next };
    }
    false
}

fn tc_bound_is_future(cx: view<TypeckCtx>, b: *const HirType) -> bool {
    if (b as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return false;
    }
    let raw_bname = unsafe { tc_path_name_sv(cx, view((*b).path)) };
    if raw_bname.len == 0 || (raw_bname.ptr as usize) == 0 {
        return false;
    }
    let mut start: usize = 0;
    let mut end: usize = raw_bname.len;
    let mut k: usize = 0;
    while k < raw_bname.len {
        let ch = unsafe { *(raw_bname.ptr + k) };
        if ch == 60u8 {
            end = k;
            break;
        }
        if ch == 46u8 {
            start = k + 1;
        }
        k = k + 1;
    }
    if end <= start {
        return false;
    }
    let bname = StrView { ptr: unsafe { raw_bname.ptr + start }, len: end - start };
    is_future_trait_name(view(bname))
}

fn extract_future_bound_output_ty(cx: mut_view<TypeckCtx>, b: *const HirType) -> TypeId {
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    if (b as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return (TypeId { v: unit_v });
    }
    let hga: *mut HirGenericArgs = unsafe { (*b).path.generic_args };
    if (hga as usize) != 0 && ((unsafe { (*hga).args }) as usize) != 0 {
        let ga: *mut HirGenericArg = unsafe { (*hga).args };
        let gty: *mut HirType = unsafe { (*ga).ty };
        if (gty as usize) != 0 {
            return tc_bound_arg_typeid(mut_view(*cx), gty);
        }
    }
    (TypeId { v: unit_v })
}

fn find_param_future_bound_output_in_item(
    cx: mut_view<TypeckCtx>,
    item: *const HirItem,
    p_idx: usize,
    p_name_v: u32
) -> TypeId {
    if (item as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let mut actual_name_v: u32 = p_name_v;
    let mut actual_sym_v: u32 = 0u32;
    let gps: *mut HirGenericParams = unsafe { (*item).generic_params };
    if (gps as usize) != 0 {
        let mut idx: usize = 0;
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            let gname_v = unsafe { (*gp).name.v };
            if idx == p_idx {
                if gname_v != 0u32 {
                    actual_name_v = gname_v;
                }
                actual_sym_v = unsafe { (*gp).symbol.v };
            }
            if idx == p_idx || (gname_v != 0u32 && gname_v == p_name_v) {
                let mut b: *mut HirType = unsafe { (*gp).bounds };
                while ((b as usize) != 0) {
                    if tc_bound_is_future(view(*cx), b) {
                        return extract_future_bound_output_ty(mut_view(*cx), b);
                    }
                    b = unsafe { (*b).next };
                }
            }
            idx = idx + 1;
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*item).where_clause };
    if (wc as usize) != 0 {
        let p_sv = if (cx.str_in as usize) != 0 && actual_name_v != 0u32 {
            unsafe { interner_get(view(*cx.str_in), (StrId { v: actual_name_v })) }
        } else {
            StrView { ptr: 0 as *const u8, len: 0 }
        };
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 && (unsafe { (*wty).kind }) == HIR_TYPE_PATH {
                let wsym_v = unsafe { (*wty).path.symbol.v };
                let wname = unsafe { tc_path_name_sv(view(*cx), view((*wty).path)) };
                let matched = (actual_sym_v != 0u32 && wsym_v == actual_sym_v) ||
                              (p_sv.len > 0 && sv_eq(view(wname), view(p_sv)));
                if matched {
                    let mut b: *mut HirType = unsafe { (*wp).bounds };
                    while ((b as usize) != 0) {
                        if tc_bound_is_future(view(*cx), b) {
                            return extract_future_bound_output_ty(mut_view(*cx), b);
                        }
                        b = unsafe { (*b).next };
                    }
                }
            }
            wp = unsafe { (*wp).next };
        }
    }
    (TypeId { v: 0u32 })
}

fn tc_deduce_impl_args(
    cx: mut_view<TypeckCtx>,
    pat_ty: TypeId,
    target_ty: TypeId,
    out_args: *mut TypeId,
    arg_count: usize,
    depth: usize
) {
    if depth > 32 || pat_ty.v == 0u32 || target_ty.v == 0u32 || (out_args as usize) == 0 {
        return;
    }
    let target_r = resolve_ty(mut_view(*cx), (TypeId { v: target_ty.v }));
    if target_r.v == 0u32 {
        return;
    }
    let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pat_ty.v })) };
    let tt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: target_r.v })) };
    if (pt as usize) == 0 || (tt as usize) == 0 {
        return;
    }
    let pk = unsafe { (*pt).kind };
    let tk = unsafe { (*tt).kind };
    if pk == TY_PARAM {
        let idx = (unsafe { (*pt).param_index }) as usize;
        if idx < arg_count && tk != TY_ERROR {
            unsafe { (*typeid_at(out_args, idx)).v = target_r.v; }
        }
        return;
    }
    if pk != tk {
        return;
    }
    if pk == TY_STRUCT || pk == TY_ENUM || pk == TY_COROUTINE {
        let sdef = unsafe { (*pt).def as usize };
        let bdef = unsafe { (*tt).def as usize };
        if sdef != bdef {
            return;
        }
        if pk == TY_COROUTINE {
            tc_deduce_impl_args(
                mut_view(*cx),
                unsafe { (*pt).ret_type },
                unsafe { (*tt).ret_type },
                out_args,
                arg_count,
                depth + 1
            );
        }
        let sac = unsafe { (*pt).arg_count };
        let bac = unsafe { (*tt).arg_count };
        let sargs = unsafe { (*pt).args };
        let bargs = unsafe { (*tt).args };
        let mut i: usize = 0;
        while i < sac && i < bac {
            let sa = unsafe { *typeid_at(sargs, i) };
            let ba = unsafe { *typeid_at(bargs, i) };
            tc_deduce_impl_args(mut_view(*cx), sa, ba, out_args, arg_count, depth + 1);
            i = i + 1;
        }
        return;
    }
    if pk == TY_VIEW || pk == TY_MUT_VIEW || pk == TY_PTR {
        tc_deduce_impl_args(
            mut_view(*cx),
            unsafe { (*pt).pointee },
            unsafe { (*tt).pointee },
            out_args,
            arg_count,
            depth + 1
        );
        return;
    }
    if pk == TY_ARRAY || pk == TY_SLICE {
        tc_deduce_impl_args(
            mut_view(*cx),
            unsafe { (*pt).elem },
            unsafe { (*tt).elem },
            out_args,
            arg_count,
            depth + 1
        );
        return;
    }
    if pk == TY_TUPLE {
        let sfc = unsafe { (*pt).field_count };
        let bfc = unsafe { (*tt).field_count };
        if sfc == bfc {
            let sf = unsafe { (*pt).fields };
            let bf = unsafe { (*tt).fields };
            let mut i: usize = 0;
            while i < sfc {
                let sfi = unsafe { *typeid_at(sf, i) };
                let bfi = unsafe { *typeid_at(bf, i) };
                tc_deduce_impl_args(mut_view(*cx), sfi, bfi, out_args, arg_count, depth + 1);
                i = i + 1;
            }
        }
        return;
    }
    if pk == TY_FN {
        let spc = unsafe { (*pt).param_count };
        let bpc = unsafe { (*tt).param_count };
        if spc == bpc {
            let sp = unsafe { (*pt).param_types };
            let bp = unsafe { (*tt).param_types };
            let mut i: usize = 0;
            while i < spc {
                let spi = unsafe { *typeid_at(sp, i) };
                let bpi = unsafe { *typeid_at(bp, i) };
                tc_deduce_impl_args(mut_view(*cx), spi, bpi, out_args, arg_count, depth + 1);
                i = i + 1;
            }
            tc_deduce_impl_args(
                mut_view(*cx),
                unsafe { (*pt).ret_type },
                unsafe { (*tt).ret_type },
                out_args,
                arg_count,
                depth + 1
            );
        }
    }
}

fn resolve_future_output_ty(cx: mut_view<TypeckCtx>, fut_ty: TypeId) -> TypeId {
    let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: fut_ty.v }));
    if r_ty.v == 0u32 || is_error(mut_view(*cx), (TypeId { v: r_ty.v })) {
        return (TypeId { v: 0u32 });
    }
    let ft = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_ty.v })) };
    if (ft as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let fk = unsafe { (*ft).kind };
    if fk == TY_COROUTINE {
        let ret_id = unsafe { (*ft).ret_type };
        return resolve_ty(mut_view(*cx), (TypeId { v: ret_id.v }));
    }
    if fk == TY_PARAM {
        let p_idx = unsafe { (*ft).param_index as usize };
        let p_name_v = unsafe { (*ft).name.v };
        let impl_n = if (cx.current_impl as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
            tc_item_generic_count(cx.current_impl)
        } else {
            0
        };
        if (cx.current_fn as usize) != 0 && p_idx >= impl_n {
            let out1 = find_param_future_bound_output_in_item(mut_view(*cx), cx.current_fn, p_idx - impl_n, p_name_v);
            if out1.v != 0u32 {
                return resolve_ty(mut_view(*cx), out1);
            }
        }
        if (cx.current_impl as usize) != 0 && p_idx < impl_n {
            let out2 = find_param_future_bound_output_in_item(mut_view(*cx), cx.current_impl, p_idx, p_name_v);
            if out2.v != 0u32 {
                return resolve_ty(mut_view(*cx), out2);
            }
        }
        return (TypeId { v: 0u32 });
    }
    if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*cx.hir).items };
        while ((it as usize) != 0) {
            if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && !(unsafe { (*it).is_negative }) {
                let tp: *mut HirType = unsafe { (*it).trait_path };
                if (tp as usize) != 0 && tc_bound_is_future(view(*cx), tp) {
                    if unsafe { type_matches_impl_self_exact(view(*cx.thir), view(*cx.str_in), it, (TypeId { v: r_ty.v })) } {
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while ((m as usize) != 0) {
                            if (unsafe { (*m).kind }) == HIR_ITEM_TYPE_ALIAS {
                                let mut m_ty = unsafe { thir_get_item_type(view(*cx.thir), m) };
                                if m_ty.v == 0u32 && ((unsafe { (*m).ty }) as usize) != 0 {
                                    let save_impl = cx.current_impl;
                                    let save_self = cx.self_ty;
                                    cx.current_impl = it;
                                    cx.self_ty.v = r_ty.v;
                                    let m_ty_ptr: *mut HirType = unsafe { (*m).ty };
                                    m_ty = hir_type_to_typeid(mut_view(*cx), m_ty_ptr);
                                    cx.current_impl = save_impl;
                                    cx.self_ty.v = save_self.v;
                                }
                                let imp_n = tc_item_generic_count(it);
                                if imp_n > 0 {
                                    let dbytes = mul_usize(imp_n, size_of<TypeId>());
                                    let d_args = unsafe {
                                        arena_alloc_raw(mut_view((*cx.thir).interner.arena), dbytes, align_of<TypeId>()) as *mut TypeId
                                    };
                                    let mut zi: usize = 0;
                                    while zi < imp_n {
                                        unsafe { (*typeid_at(d_args, zi)).v = 0u32; }
                                        zi = zi + 1;
                                    }
                                    let imp_self_ty = unsafe { thir_get_item_type(view(*cx.thir), it) };
                                    if imp_self_ty.v != 0u32 {
                                        tc_deduce_impl_args(mut_view(*cx), imp_self_ty, (TypeId { v: r_ty.v }), d_args, imp_n, 0);
                                    }
                                    if (unsafe { (*ft).arg_count }) == imp_n && ((unsafe { (*ft).args }) as usize) != 0 {
                                        let mut ai: usize = 0;
                                        while ai < imp_n {
                                            let dst_p = unsafe { typeid_at(d_args, ai) };
                                            if (unsafe { (*dst_p).v }) == 0u32 {
                                                unsafe { (*dst_p).v = (*typeid_at((*ft).args, ai)).v; }
                                            }
                                            ai = ai + 1;
                                        }
                                    }
                                    let gslice = GenericArgsSlice {
                                        args: d_args,
                                        count: imp_n,
                                    };
                                    m_ty = tc_subst_ty_and_self(mut_view(*cx), m_ty, view(gslice), r_ty.v);
                                } else {
                                    let empty_g = GenericArgsSlice {
                                        args: 0 as *mut TypeId,
                                        count: 0,
                                    };
                                    m_ty = tc_subst_ty_and_self(mut_view(*cx), m_ty, view(empty_g), r_ty.v);
                                }
                                return resolve_ty(mut_view(*cx), m_ty);
                            }
                            m = unsafe { (*m).next };
                        }
                        let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
                        return (TypeId { v: unit_v });
                    }
                }
            }
            it = unsafe { (*it).next };
        }
    }
    (TypeId { v: 0u32 })
}

fn fn_item_has_any_future_bound(cx: view<TypeckCtx>, fn_def: *const HirItem) -> bool {
    if (fn_def as usize) == 0 {
        return false;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_def).generic_params };
    if (gps as usize) != 0 {
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while ((b as usize) != 0) {
                if tc_bound_is_future(view(*cx), b) && ((unsafe { (*b).path.generic_args }) as usize) != 0 {
                    return true;
                }
                b = unsafe { (*b).next };
            }
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*fn_def).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let mut wb: *mut HirType = unsafe { (*wp).bounds };
            while ((wb as usize) != 0) {
                if tc_bound_is_future(view(*cx), wb) && ((unsafe { (*wb).path.generic_args }) as usize) != 0 {
                    return true;
                }
                wb = unsafe { (*wb).next };
            }
            wp = unsafe { (*wp).next };
        }
    }
    false
}

fn tc_enter_callee_bound_scope(cx: mut_view<TypeckCtx>, fn_def: *const HirItem) {
    let enc_impl = tc_fn_enclosing_impl(cx.hir, fn_def);
    cx.current_fn = fn_def;
    cx.current_impl = enc_impl;
    if (enc_impl as usize) != 0 && (unsafe { (*enc_impl).kind }) == HIR_ITEM_IMPL {
        let st = unsafe { thir_get_item_type(view(*cx.thir), enc_impl) };
        cx.self_ty.v = st.v;
    } else {
        cx.self_ty.v = 0u32;
    }
}

fn check_future_bound_outputs_for_call(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    callee_self_v: u32,
    call_span: Span
) {
    if (fn_def as usize) == 0 || (substs as usize) == 0 {
        return;
    }
    let cnt = unsafe { (*substs).count };
    let args = unsafe { (*substs).args };
    if cnt == 0 || (args as usize) == 0 {
        return;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_def).generic_params };
    if (gps as usize) == 0 || !fn_item_has_any_future_bound(view(*cx), fn_def) {
        return;
    }
    let enc_impl = tc_fn_enclosing_impl(cx.hir, fn_def);
    let impl_n = if (enc_impl as usize) != 0 { tc_item_generic_count(enc_impl) } else { 0 };
    let own_n = tc_item_generic_count(fn_def);
    let base_offset = if cnt == impl_n + own_n { impl_n } else { 0 };
    // T448 (T422 FU-D): the type arguments belong to the caller. When one is a generic parameter of the
    // caller (`F` with `F: Future<Output = i64>`), its output comes from the caller's bounds, so resolve every
    // argument's `Future` output before switching to the callee's generic scope below.
    let outs_bytes = mul_usize(cnt, size_of<TypeId>());
    let outs = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), outs_bytes, align_of<TypeId>()) as *mut TypeId };
    let mut oi: usize = 0;
    while oi < cnt {
        let arg_ty0 = resolve_ty(mut_view(*cx), unsafe { *typeid_at(args, oi) });
        let out0 = resolve_future_output_ty(mut_view(*cx), arg_ty0);
        unsafe { (*typeid_at(outs, oi)).v = out0.v; }
        oi = oi + 1;
    }
    let save_fn = cx.current_fn;
    let save_impl = cx.current_impl;
    let save_self_v = cx.self_ty.v;
    tc_enter_callee_bound_scope(mut_view(*cx), fn_def);

    let mut m_idx: usize = 0;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while ((gp as usize) != 0) && m_idx < own_n && (base_offset + m_idx) < cnt {
        let actual_out = TypeId { v: unsafe { (*typeid_at(outs, base_offset + m_idx)).v } };
        if actual_out.v != 0u32 {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while ((b as usize) != 0) {
                if tc_bound_is_future(view(*cx), b) && ((unsafe { (*b).path.generic_args }) as usize) != 0 {
                    let raw_exp = extract_future_bound_output_ty(mut_view(*cx), b);
                    let exp_out = unsafe {
                        tc_subst_ty_and_self(mut_view(*cx), raw_exp, view(*substs), callee_self_v)
                    };
                    let _ = coerce(mut_view(*cx), (TypeId { v: actual_out.v }), exp_out, view(call_span));
                }
                b = unsafe { (*b).next };
            }
            let wc: *mut HirWhereClause = unsafe { (*fn_def).where_clause };
            let gname_v = unsafe { (*gp).name.v };
            if (wc as usize) != 0 && (cx.str_in as usize) != 0 && gname_v != 0u32 {
                let g_sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_v })) };
                let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
                while ((wp as usize) != 0) {
                    let wty: *mut HirType = unsafe { (*wp).ty };
                    if (wty as usize) != 0 && (unsafe { (*wty).kind }) == HIR_TYPE_PATH {
                        let wname = unsafe { tc_path_name_sv(view(*cx), view((*wty).path)) };
                        if sv_eq(view(wname), view(g_sv)) {
                            let mut wb: *mut HirType = unsafe { (*wp).bounds };
                            while ((wb as usize) != 0) {
                                if tc_bound_is_future(view(*cx), wb) && ((unsafe { (*wb).path.generic_args }) as usize) != 0 {
                                    let raw_exp2 = extract_future_bound_output_ty(mut_view(*cx), wb);
                                    let exp_out2 = unsafe {
                                        tc_subst_ty_and_self(mut_view(*cx), raw_exp2, view(*substs), callee_self_v)
                                    };
                                    let _ = coerce(mut_view(*cx), (TypeId { v: actual_out.v }), exp_out2, view(call_span));
                                }
                                wb = unsafe { (*wb).next };
                            }
                        }
                    }
                    wp = unsafe { (*wp).next };
                }
            }
        }
        m_idx = m_idx + 1;
        gp = unsafe { (*gp).next };
    }

    cx.current_fn = save_fn;
    cx.current_impl = save_impl;
    cx.self_ty.v = save_self_v;
}

fn tc_bound_base_name_sv(cx: view<TypeckCtx>, b: *const HirType) -> StrView {
    if (b as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let raw_bname = unsafe { tc_path_name_sv(cx, view((*b).path)) };
    if raw_bname.len == 0 || (raw_bname.ptr as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let mut start: usize = 0;
    let mut end: usize = raw_bname.len;
    let mut k: usize = 0;
    while k < raw_bname.len {
        let ch = unsafe { *(raw_bname.ptr + k) };
        if ch == 60u8 || ch == 32u8 {
            end = k;
            break;
        }
        if ch == 46u8 {
            start = k + 1;
        }
        k = k + 1;
    }
    if end <= start {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    StrView { ptr: unsafe { raw_bname.ptr + start }, len: end - start }
}

fn tc_bound_is_callable(cx: view<TypeckCtx>, b: *const HirType) -> bool {
    let bname = tc_bound_base_name_sv(cx, b);
    if bname.len == 0 {
        return false;
    }
    tc_sv_is_2(view(bname), 70u8, 110u8) ||
    tc_sv_is_5(view(bname), 70u8, 110u8, 77u8, 117u8, 116u8) ||
    tc_sv_is_6(view(bname), 70u8, 110u8, 79u8, 110u8, 99u8, 101u8) ||
    tc_sv_is_8(view(bname), 67u8, 97u8, 108u8, 108u8, 97u8, 98u8, 108u8, 101u8)
}

fn tc_find_callable_bound_in_where(
    cx: view<TypeckCtx>,
    item: *const HirItem,
    actual_sym_v: u32,
    actual_name_v: u32
) -> *const HirType {
    if (item as usize) == 0 {
        return 0 as *const HirType;
    }
    let wc: *mut HirWhereClause = unsafe { (*item).where_clause };
    if (wc as usize) == 0 {
        return 0 as *const HirType;
    }
    let p_sv = if (cx.str_in as usize) != 0 && actual_name_v != 0u32 {
        unsafe { interner_get(view(*cx.str_in), (StrId { v: actual_name_v })) }
    } else {
        StrView { ptr: 0 as *const u8, len: 0 }
    };
    let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
    while ((wp as usize) != 0) {
        let wty: *mut HirType = unsafe { (*wp).ty };
        if (wty as usize) != 0 && (unsafe { (*wty).kind }) == HIR_TYPE_PATH &&
           ((unsafe { (*wty).path.generic_args }) as usize) == 0 {
            let wsym_v = unsafe { (*wty).path.symbol.v };
            let wname = unsafe { tc_path_name_sv(cx, view((*wty).path)) };
            let matched = (actual_sym_v != 0u32 && wsym_v == actual_sym_v) ||
                          (p_sv.len > 0 && sv_eq(view(wname), view(p_sv)));
            if matched {
                let mut wb: *mut HirType = unsafe { (*wp).bounds };
                while ((wb as usize) != 0) {
                    if tc_bound_is_callable(cx, wb) {
                        return wb;
                    }
                    wb = unsafe { (*wb).next };
                }
            }
        }
        wp = unsafe { (*wp).next };
    }
    0 as *const HirType
}

fn tc_find_callable_bound_in_item(
    cx: view<TypeckCtx>,
    item: *const HirItem,
    p_idx: usize,
    p_name_v: u32
) -> *const HirType {
    if (item as usize) == 0 {
        return 0 as *const HirType;
    }
    let mut actual_name_v: u32 = p_name_v;
    let mut actual_sym_v: u32 = 0u32;
    let mut target_gp: *mut HirGenericParam = 0 as *mut HirGenericParam;
    let gps: *mut HirGenericParams = unsafe { (*item).generic_params };
    if (gps as usize) != 0 {
        let mut idx: usize = 0;
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            if idx == p_idx {
                target_gp = gp;
                break;
            }
            idx = idx + 1;
            gp = unsafe { (*gp).next };
        }
        if (target_gp as usize) == 0 && p_name_v != 0u32 {
            gp = unsafe { (*gps).params };
            while ((gp as usize) != 0) {
                let gname_v = unsafe { (*gp).name.v };
                if gname_v != 0u32 && gname_v == p_name_v {
                    target_gp = gp;
                    break;
                }
                gp = unsafe { (*gp).next };
            }
        }
        if (target_gp as usize) != 0 {
            let gname_v = unsafe { (*target_gp).name.v };
            if gname_v != 0u32 {
                actual_name_v = gname_v;
            }
            actual_sym_v = unsafe { (*target_gp).symbol.v };
            let mut b: *mut HirType = unsafe { (*target_gp).bounds };
            while ((b as usize) != 0) {
                if tc_bound_is_callable(cx, b) {
                    return b;
                }
                b = unsafe { (*b).next };
            }
        }
    }
    tc_find_callable_bound_in_where(cx, item, actual_sym_v, actual_name_v)
}

fn fn_item_has_any_callable_bound_with_args(cx: view<TypeckCtx>, fn_def: *const HirItem) -> bool {
    if (fn_def as usize) == 0 {
        return false;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_def).generic_params };
    if (gps as usize) != 0 {
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while ((b as usize) != 0) {
                if tc_bound_is_callable(cx, b) && ((unsafe { (*b).path.generic_args }) as usize) != 0 {
                    return true;
                }
                b = unsafe { (*b).next };
            }
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*fn_def).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let mut wb: *mut HirType = unsafe { (*wp).bounds };
            while ((wb as usize) != 0) {
                if tc_bound_is_callable(cx, wb) && ((unsafe { (*wb).path.generic_args }) as usize) != 0 {
                    return true;
                }
                wb = unsafe { (*wb).next };
            }
            wp = unsafe { (*wp).next };
        }
    }
    false
}

fn tc_callable_bound_to_subst_fn_ty(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    callee_self_v: u32,
    cb: *const HirType
) -> TypeId {
    if (cb as usize) == 0 || (substs as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let hga: *mut HirGenericArgs = unsafe { (*cb).path.generic_args };
    if (hga as usize) == 0 || ((unsafe { (*hga).args }) as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let mut gcount: usize = 0;
    let mut ga: *mut HirGenericArg = unsafe { (*hga).args };
    while ((ga as usize) != 0) {
        gcount = gcount + 1;
        ga = unsafe { (*ga).next };
    }
    if gcount == 0 {
        return (TypeId { v: 0u32 });
    }
    let save_fn = cx.current_fn;
    let save_impl = cx.current_impl;
    let save_self_v = cx.self_ty.v;
    tc_enter_callee_bound_scope(mut_view(*cx), fn_def);

    let pcount = gcount - 1;
    let mut ptypes: *mut TypeId = 0 as *mut TypeId;
    if pcount > 0 {
        let pbytes = mul_usize(pcount, size_of<TypeId>());
        ptypes = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), pbytes, align_of<TypeId>()) as *mut TypeId };
    }
    let mut ret_ty = (TypeId { v: unsafe { (*cx.thir).interner.t_unit.v } });
    let mut j: usize = 0;
    ga = unsafe { (*hga).args };
    while ((ga as usize) != 0) {
        let gty: *mut HirType = unsafe { (*ga).ty };
        let raw_t = if (gty as usize) != 0 { tc_bound_arg_typeid(mut_view(*cx), gty) } else { TypeId { v: ret_ty.v } };
        let sub_t = unsafe {
            tc_subst_ty_and_self(mut_view(*cx), raw_t, view(*substs), callee_self_v)
        };
        if j < pcount {
            let dst = unsafe { typeid_at(ptypes, j) };
            unsafe { (*dst).v = sub_t.v; }
        } else {
            ret_ty = sub_t;
        }
        j = j + 1;
        ga = unsafe { (*ga).next };
    }

    cx.current_fn = save_fn;
    cx.current_impl = save_impl;
    cx.self_ty.v = save_self_v;
    unsafe { intern_fn_ty(mut_view((*cx.thir).interner), false, (StrId { v: 0u32 }), ptypes, pcount, (TypeId { v: ret_ty.v })) }
}

fn tc_build_callable_hint_ty(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    callee_self_v: u32,
    param_ty: TypeId
) -> TypeId {
    if (fn_def as usize) == 0 || (substs as usize) == 0 || !fn_item_has_any_callable_bound_with_args(view(*cx), fn_def) {
        return (TypeId { v: 0u32 });
    }
    let r_param = resolve_ty(mut_view(*cx), param_ty);
    let cnt = unsafe { (*substs).count };
    let args = unsafe { (*substs).args };
    let enc_impl = tc_fn_enclosing_impl(cx.hir, fn_def);
    let impl_n = if (enc_impl as usize) != 0 { tc_item_generic_count(enc_impl) } else { 0 };
    let own_n = tc_item_generic_count(fn_def);
    let base_offset = if cnt == impl_n + own_n { impl_n } else { 0 };
    let mut m_idx: usize = 0;
    while m_idx < own_n && (base_offset + m_idx) < cnt {
        let g_var = resolve_ty(mut_view(*cx), unsafe { *typeid_at(args, base_offset + m_idx) });
        if g_var.v == r_param.v {
            let cb = tc_find_callable_bound_in_item(view(*cx), fn_def, m_idx, 0u32);
            if (cb as usize) != 0 {
                return tc_callable_bound_to_subst_fn_ty(mut_view(*cx), fn_def, substs, callee_self_v, cb);
            }
        }
        m_idx = m_idx + 1;
    }
    (TypeId { v: 0u32 })
}

fn check_callable_bound_outputs_for_call(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    callee_self_v: u32,
    call_span: Span
) {
    if (fn_def as usize) == 0 || (substs as usize) == 0 || !fn_item_has_any_callable_bound_with_args(view(*cx), fn_def) {
        return;
    }
    let cnt = unsafe { (*substs).count };
    let args = unsafe { (*substs).args };
    let enc_impl = tc_fn_enclosing_impl(cx.hir, fn_def);
    let impl_n = if (enc_impl as usize) != 0 { tc_item_generic_count(enc_impl) } else { 0 };
    let own_n = tc_item_generic_count(fn_def);
    let base_offset = if cnt == impl_n + own_n { impl_n } else { 0 };
    let mut m_idx: usize = 0;
    while m_idx < own_n && (base_offset + m_idx) < cnt {
        let arg_ty = resolve_ty(mut_view(*cx), unsafe { *typeid_at(args, base_offset + m_idx) });
        let at = unsafe { type_get(view((*cx.thir).interner), arg_ty) };
        if (at as usize) != 0 && (unsafe { (*at).kind == TY_CLOSURE || (*at).kind == TY_FN }) {
            let cb = tc_find_callable_bound_in_item(view(*cx), fn_def, m_idx, 0u32);
            if (cb as usize) != 0 {
                let sig_ty = tc_callable_bound_to_subst_fn_ty(mut_view(*cx), fn_def, substs, callee_self_v, cb);
                let st = unsafe { type_get(view((*cx.thir).interner), sig_ty) };
                if (st as usize) != 0 && unsafe { (*st).kind == TY_FN } {
                    let act_pcnt = unsafe { (*at).param_count };
                    let exp_pcnt = unsafe { (*st).param_count };
                    if act_pcnt != exp_pcnt {
                        let _ = type_error(mut_view(*cx), view(call_span), AX_TYPE_MISMATCH);
                    } else {
                        let mut p: usize = 0;
                        while p < exp_pcnt {
                            let ap = resolve_ty(mut_view(*cx), unsafe { *typeid_at((*at).param_types, p) });
                            let ep = resolve_ty(mut_view(*cx), unsafe { *typeid_at((*st).param_types, p) });
                            if ap.v != 0u32 && ep.v != 0u32 {
                                let _ = coerce(mut_view(*cx), ap, ep, view(call_span));
                            }
                            p = p + 1;
                        }
                    }
                    let act_ret = resolve_ty(mut_view(*cx), unsafe { (*at).ret_type });
                    let exp_ret = resolve_ty(mut_view(*cx), unsafe { (*st).ret_type });
                    if act_ret.v != 0u32 && exp_ret.v != 0u32 {
                        let _ = coerce(mut_view(*cx), act_ret, exp_ret, view(call_span));
                    }
                }
            }
        }
        m_idx = m_idx + 1;
    }
}

fn tc_bound_matches_trait_item(cx: view<TypeckCtx>, b: *const HirType, trait_it: *const HirItem) -> bool {
    if (b as usize) == 0 || (trait_it as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return false;
    }
    let bsym = unsafe { (*b).path.symbol.v };
    let tsym = unsafe { (*trait_it).symbol.v };
    if bsym != 0u32 && tsym != 0u32 && bsym == tsym {
        return true;
    }
    if (cx.str_in as usize) == 0 {
        return false;
    }
    let tname_id = unsafe { (*trait_it).name.v };
    if tname_id == 0u32 {
        return false;
    }
    let tname = unsafe { interner_get(view(*cx.str_in), (StrId { v: tname_id })) };
    let bname = tc_bound_base_name_sv(cx, b);
    bname.len > 0 && sv_eq(view(bname), view(tname))
}

fn tc_find_trait_bound_in_item(
    cx: view<TypeckCtx>,
    item: *const HirItem,
    p_idx: usize,
    p_name_v: u32,
    trait_it: *const HirItem
) -> *const HirType {
    if (item as usize) == 0 || (trait_it as usize) == 0 {
        return 0 as *const HirType;
    }
    let mut actual_name_v: u32 = p_name_v;
    let mut actual_sym_v: u32 = 0u32;
    let mut target_gp: *mut HirGenericParam = 0 as *mut HirGenericParam;
    let gps: *mut HirGenericParams = unsafe { (*item).generic_params };
    if (gps as usize) != 0 {
        let mut idx: usize = 0;
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            if idx == p_idx {
                target_gp = gp;
                break;
            }
            idx = idx + 1;
            gp = unsafe { (*gp).next };
        }
        if (target_gp as usize) == 0 && p_name_v != 0u32 {
            gp = unsafe { (*gps).params };
            while ((gp as usize) != 0) {
                let gname_v = unsafe { (*gp).name.v };
                if gname_v != 0u32 && gname_v == p_name_v {
                    target_gp = gp;
                    break;
                }
                gp = unsafe { (*gp).next };
            }
        }
        if (target_gp as usize) != 0 {
            let gname_v = unsafe { (*target_gp).name.v };
            if gname_v != 0u32 {
                actual_name_v = gname_v;
            }
            actual_sym_v = unsafe { (*target_gp).symbol.v };
            let mut b: *mut HirType = unsafe { (*target_gp).bounds };
            while ((b as usize) != 0) {
                if tc_bound_matches_trait_item(cx, b, trait_it) {
                    return b;
                }
                b = unsafe { (*b).next };
            }
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*item).where_clause };
    if (wc as usize) != 0 {
        let p_sv = if (cx.str_in as usize) != 0 && actual_name_v != 0u32 {
            unsafe { interner_get(view(*cx.str_in), (StrId { v: actual_name_v })) }
        } else {
            StrView { ptr: 0 as *const u8, len: 0 }
        };
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 && (unsafe { (*wty).kind }) == HIR_TYPE_PATH &&
               ((unsafe { (*wty).path.generic_args }) as usize) == 0 {
                let wsym_v = unsafe { (*wty).path.symbol.v };
                let wname = unsafe { tc_path_name_sv(cx, view((*wty).path)) };
                let matched = (actual_sym_v != 0u32 && wsym_v == actual_sym_v) ||
                              (p_sv.len > 0 && sv_eq(view(wname), view(p_sv)));
                if matched {
                    let mut wb: *mut HirType = unsafe { (*wp).bounds };
                    while ((wb as usize) != 0) {
                        if tc_bound_matches_trait_item(cx, wb, trait_it) {
                            return wb;
                        }
                        wb = unsafe { (*wb).next };
                    }
                }
            }
            wp = unsafe { (*wp).next };
        }
    }
    0 as *const HirType
}

fn tc_extract_param_trait_args(
    cx: mut_view<TypeckCtx>,
    param_t: *const AxType,
    trait_it: *const HirItem,
    trait_n: usize,
    sp: view<Span>
) -> GenericArgsSlice {
    let bytes = mul_usize(trait_n, size_of<TypeId>());
    let arr = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
    let mut i: usize = 0;
    while i < trait_n {
        unsafe { (*typeid_at(arr, i)).v = 0u32; }
        i = i + 1;
    }
    if (param_t as usize) != 0 {
        let p_idx = unsafe { (*param_t).param_index as usize };
        let p_name_v = unsafe { (*param_t).name.v };
        let impl_n = if (cx.current_impl as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
            tc_item_generic_count(cx.current_impl)
        } else {
            0
        };
        let mut tb: *const HirType = 0 as *const HirType;
        if (cx.current_fn as usize) != 0 && p_idx >= impl_n {
            tb = tc_find_trait_bound_in_item(view(*cx), cx.current_fn, p_idx - impl_n, p_name_v, trait_it);
        }
        if (tb as usize) == 0 && (cx.current_impl as usize) != 0 && p_idx < impl_n {
            if (cx.current_fn as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
                tb = tc_find_trait_bound_in_item(view(*cx), cx.current_fn, 0xFFFFFFFFusize, p_name_v, trait_it);
            }
            if (tb as usize) == 0 {
                tb = tc_find_trait_bound_in_item(view(*cx), cx.current_impl, p_idx, p_name_v, trait_it);
            }
        }
        if (tb as usize) != 0 {
            let hga: *mut HirGenericArgs = unsafe { (*tb).path.generic_args };
            if (hga as usize) != 0 {
                let mut ga: *mut HirGenericArg = unsafe { (*hga).args };
                let mut k: usize = 0;
                while (ga as usize) != 0 && k < trait_n {
                    if (unsafe { (*ga).name.v }) == 0u32 {
                        let gty: *mut HirType = unsafe { (*ga).ty };
                        if (gty as usize) != 0 {
                            let tid = tc_bound_arg_typeid(mut_view(*cx), gty);
                            unsafe { (*typeid_at(arr, k)).v = tid.v; }
                        }
                        k = k + 1;
                    }
                    ga = unsafe { (*ga).next };
                }
            }
        }
    }
    i = 0;
    while i < trait_n {
        if (unsafe { (*typeid_at(arr, i)).v }) == 0u32 {
            let tv = new_ty_var(mut_view(*cx), sp);
            unsafe { (*typeid_at(arr, i)).v = tv.v; }
        }
        i = i + 1;
    }
    GenericArgsSlice { args: arr, count: trait_n }
}

fn tc_impl_self_is_identity_params(cx: view<TypeckCtx>, impl_self_ty: TypeId, impl_n: usize) -> bool {
    if impl_self_ty.v == 0u32 || impl_n == 0 {
        return false;
    }
    let st = unsafe { type_get(view((*cx.thir).interner), impl_self_ty) };
    if (st as usize) == 0 {
        return false;
    }
    let sk = unsafe { (*st).kind };
    if (sk != TY_STRUCT && sk != TY_ENUM) || (unsafe { (*st).arg_count }) != impl_n || ((unsafe { (*st).args }) as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < impl_n {
        let a_id = unsafe { *typeid_at((*st).args, i) };
        let a_t = unsafe { type_get(view((*cx.thir).interner), a_id) };
        if (a_t as usize) == 0 || (unsafe { (*a_t).kind }) != TY_PARAM || (unsafe { (*a_t).param_index as usize }) != i {
            return false;
        }
        i = i + 1;
    }
    true
}

fn tc_build_method_call_comb_substs(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    enc_impl: *const HirItem,
    impl_n: usize,
    receiver_ty: TypeId,
    base_ty: TypeId,
    base_t: *mut AxType,
    method_args: *mut TypeId,
    method_argc: usize
) -> *mut GenericArgsSlice {
    let tot_cnt = impl_n + method_argc;
    let tot_bytes = mul_usize(tot_cnt, size_of<TypeId>());
    let comb_arr = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), tot_bytes, align_of<TypeId>()) as *mut TypeId };
    let recv_ac = if (base_t as usize) != 0 { unsafe { (*base_t).arg_count } } else { 0 };
    let recv_args = if (base_t as usize) != 0 { unsafe { (*base_t).args } } else { 0 as *mut TypeId };
    if (enc_impl as usize) != 0 && (unsafe { (*enc_impl).kind }) == HIR_ITEM_IMPL {
        let impl_self_ty = unsafe { thir_get_item_type(view(*cx.thir), enc_impl) };
        if tc_impl_self_is_identity_params(view(*cx), (TypeId { v: impl_self_ty.v }), impl_n) && recv_ac == impl_n && (recv_args as usize) != 0 {
            let mut ii: usize = 0;
            while ii < impl_n {
                unsafe { (*typeid_at(comb_arr, ii)).v = (*typeid_at(recv_args, ii)).v; }
                ii = ii + 1;
            }
        } else {
            let mut ii: usize = 0;
            while ii < impl_n {
                let tv = unsafe { new_ty_var(mut_view(*cx), view((*expr).span)) };
                unsafe { (*typeid_at(comb_arr, ii)).v = tv.v; }
                ii = ii + 1;
            }
            if impl_self_ty.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: impl_self_ty.v })) {
                let imp_only = GenericArgsSlice { args: comb_arr, count: impl_n };
                let sub_self = unsafe {
                    subst_ty_with_vars(mut_view((*cx.thir).interner), mut_view(cx.type_vars), (TypeId { v: impl_self_ty.v }), view(imp_only))
                };
                let sub_self_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: sub_self.v })) };
                let r_recv = resolve_ty(mut_view(*cx), (TypeId { v: receiver_ty.v }));
                let r_recv_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_recv.v })) };
                if (sub_self_t as usize) != 0 {
                    let ssk = unsafe { (*sub_self_t).kind };
                    let rrk = if (r_recv_t as usize) != 0 { unsafe { (*r_recv_t).kind } } else { 0u8 };
                    if (ssk == TY_VIEW || ssk == TY_MUT_VIEW || ssk == TY_PTR) && ssk == rrk {
                        let _ = unify_ty(mut_view(*cx), (TypeId { v: sub_self.v }), (TypeId { v: r_recv.v }));
                    } else if ssk == TY_VIEW || ssk == TY_MUT_VIEW || ssk == TY_PTR {
                        let spt_v = unsafe { (*sub_self_t).pointee.v };
                        let _ = unify_ty(mut_view(*cx), (TypeId { v: spt_v }), (TypeId { v: base_ty.v }));
                    } else {
                        let _ = unify_ty(mut_view(*cx), (TypeId { v: sub_self.v }), (TypeId { v: base_ty.v }));
                    }
                }
            }
        }
    } else if (enc_impl as usize) != 0 && (unsafe { (*enc_impl).kind }) == HIR_ITEM_TRAIT &&
              (base_t as usize) != 0 && (unsafe { (*base_t).kind }) == TY_PARAM {
        let tg = unsafe { tc_extract_param_trait_args(mut_view(*cx), base_t, enc_impl, impl_n, view((*expr).span)) };
        let mut ii: usize = 0;
        while ii < impl_n {
            unsafe { (*typeid_at(comb_arr, ii)).v = (*typeid_at(tg.args, ii)).v; }
            ii = ii + 1;
        }
    } else {
        let mut ii: usize = 0;
        while ii < impl_n {
            let iv = if ii < recv_ac && (recv_args as usize) != 0 {
                unsafe { (*typeid_at(recv_args, ii)).v }
            } else {
                unsafe { new_ty_var(mut_view(*cx), view((*expr).span)).v }
            };
            unsafe { (*typeid_at(comb_arr, ii)).v = iv; }
            ii = ii + 1;
        }
    }
    let mut mi: usize = 0;
    while mi < method_argc {
        unsafe { (*typeid_at(comb_arr, impl_n + mi)).v = (*typeid_at(method_args, mi)).v; }
        mi = mi + 1;
    }
    let slice_ptr = unsafe {
        arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<GenericArgsSlice>(), align_of<GenericArgsSlice>()) as *mut GenericArgsSlice
    };
    unsafe {
        (*slice_ptr).args = comb_arr;
        (*slice_ptr).count = tot_cnt;
    }
    slice_ptr
}

fn tc_bound_is_generic_user_trait(cx: view<TypeckCtx>, b: *const HirType) -> bool {
    if (b as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return false;
    }
    let hga: *mut HirGenericArgs = unsafe { (*b).path.generic_args };
    if (hga as usize) == 0 || ((unsafe { (*hga).args }) as usize) == 0 {
        return false;
    }
    if tc_bound_is_callable(cx, b) || tc_bound_is_future(cx, b) {
        return false;
    }
    let mut ga: *mut HirGenericArg = unsafe { (*hga).args };
    while (ga as usize) != 0 {
        if (unsafe { (*ga).name.v }) == 0u32 && ((unsafe { (*ga).ty }) as usize) != 0 {
            return true;
        }
        ga = unsafe { (*ga).next };
    }
    false
}

fn fn_item_has_any_generic_trait_bound(cx: view<TypeckCtx>, fn_def: *const HirItem) -> bool {
    if (fn_def as usize) == 0 {
        return false;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_def).generic_params };
    if (gps as usize) != 0 {
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while (gp as usize) != 0 {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while (b as usize) != 0 {
                if tc_bound_is_generic_user_trait(cx, b) {
                    return true;
                }
                b = unsafe { (*b).next };
            }
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*fn_def).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while (wp as usize) != 0 {
            let mut wb: *mut HirType = unsafe { (*wp).bounds };
            while (wb as usize) != 0 {
                if tc_bound_is_generic_user_trait(cx, wb) {
                    return true;
                }
                wb = unsafe { (*wb).next };
            }
            wp = unsafe { (*wp).next };
        }
    }
    false
}

fn tc_impl_trait_matches_bound(cx: view<TypeckCtx>, imp_tp: *const HirType, b: *const HirType) -> bool {
    if (imp_tp as usize) == 0 || (b as usize) == 0 ||
       (unsafe { (*imp_tp).kind }) != HIR_TYPE_PATH || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return false;
    }
    let isym = unsafe { (*imp_tp).path.symbol.v };
    let bsym = unsafe { (*b).path.symbol.v };
    if isym != 0u32 && bsym != 0u32 {
        return isym == bsym;
    }
    let iname = tc_bound_base_name_sv(cx, imp_tp);
    let bname = tc_bound_base_name_sv(cx, b);
    iname.len > 0 && sv_eq(view(iname), view(bname))
}

fn tc_check_single_generic_trait_bound(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    callee_self_v: u32,
    arg_ty: TypeId,
    b: *const HirType,
    call_span: Span
) {
    let arg_ty_v = arg_ty.v;
    if !tc_bound_is_generic_user_trait(view(*cx), b) {
        return;
    }
    if !unsafe { satisfies_bound(view(*cx.hir), view(*cx.thir), (TypeId { v: arg_ty_v }), b, view(*cx.str_in), view(*cx.db)) } {
        return;
    }
    let hga: *mut HirGenericArgs = unsafe { (*b).path.generic_args };
    let mut b_argc: usize = 0;
    let mut ga: *mut HirGenericArg = unsafe { (*hga).args };
    while (ga as usize) != 0 {
        if (unsafe { (*ga).name.v }) == 0u32 && ((unsafe { (*ga).ty }) as usize) != 0 {
            b_argc = b_argc + 1;
        }
        ga = unsafe { (*ga).next };
    }
    if b_argc == 0 {
        return;
    }
    let ebytes = mul_usize(b_argc, size_of<TypeId>());
    let exp_args = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), ebytes, align_of<TypeId>()) as *mut TypeId };
    let save_fn = cx.current_fn;
    let save_impl = cx.current_impl;
    let save_self_v = cx.self_ty.v;
    tc_enter_callee_bound_scope(mut_view(*cx), fn_def);
    let mut k: usize = 0;
    let mut any_err = false;
    ga = unsafe { (*hga).args };
    while (ga as usize) != 0 {
        if (unsafe { (*ga).name.v }) == 0u32 && ((unsafe { (*ga).ty }) as usize) != 0 {
            let raw_t = tc_bound_arg_typeid(mut_view(*cx), unsafe { (*ga).ty });
            let sub_t = unsafe {
                tc_subst_ty_and_self(mut_view(*cx), raw_t, view(*substs), callee_self_v)
            };
            let res_t = resolve_ty(mut_view(*cx), sub_t);
            let res_t_v = res_t.v;
            if is_error(mut_view(*cx), (TypeId { v: res_t_v })) {
                any_err = true;
            }
            unsafe { (*typeid_at(exp_args, k)).v = res_t_v; }
            k = k + 1;
        }
        ga = unsafe { (*ga).next };
    }
    cx.current_fn = save_fn;
    cx.current_impl = save_impl;
    cx.self_ty.v = save_self_v;
    if any_err {
        return;
    }

    let mut cand_count: usize = 0;
    let mut single_imp: *mut HirItem = 0 as *mut HirItem;
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && !(unsafe { (*it).is_negative }) {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            if tc_impl_trait_matches_bound(view(*cx), tp, b) {
                if unsafe { type_matches_impl_self_exact(view(*cx.thir), view(*cx.str_in), it, (TypeId { v: arg_ty_v })) } {
                    cand_count = cand_count + 1;
                    single_imp = it;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    if cand_count == 0 {
        return;
    }
    if cand_count == 1 {
        let imp = single_imp;
        let tp: *mut HirType = unsafe { (*imp).trait_path };
        let tp_hga: *mut HirGenericArgs = unsafe { (*tp).path.generic_args };
        if (tp_hga as usize) == 0 {
            return;
        }
        let imp_n = tc_item_generic_count(imp);
        let mut imp_vars: *mut TypeId = 0 as *mut TypeId;
        if imp_n > 0 {
            let ibytes = mul_usize(imp_n, size_of<TypeId>());
            imp_vars = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), ibytes, align_of<TypeId>()) as *mut TypeId };
            let mut ii: usize = 0;
            while ii < imp_n {
                let tv_idx = cx.type_vars.len;
                let tv = new_ty_var(mut_view(*cx), view(call_span));
                if tv_idx < cx.type_vars.len {
                    let tve = unsafe { typevar_at(cx.type_vars.items, tv_idx) };
                    unsafe { (*tve).is_generic = false; }
                }
                unsafe { (*typeid_at(imp_vars, ii)).v = tv.v; }
                ii = ii + 1;
            }
            let imp_self_ty = unsafe { thir_get_item_type(view(*cx.thir), imp) };
            if imp_self_ty.v != 0u32 {
                let islice = GenericArgsSlice { args: imp_vars, count: imp_n };
                let sub_iself = unsafe {
                    subst_ty_with_vars(mut_view((*cx.thir).interner), mut_view(cx.type_vars), imp_self_ty, view(islice))
                };
                let _ = unify_ty(mut_view(*cx), sub_iself, (TypeId { v: arg_ty_v }));
            }
        }
        let islice2 = GenericArgsSlice { args: imp_vars, count: imp_n };
        let s_fn = cx.current_fn;
        let s_im = cx.current_impl;
        let s_sf = cx.self_ty.v;
        cx.current_fn = 0 as *const HirItem;
        cx.current_impl = imp;
        cx.self_ty = unsafe { thir_get_item_type(view(*cx.thir), imp) };
        let mut tga: *mut HirGenericArg = unsafe { (*tp_hga).args };
        let mut ti: usize = 0;
        let mut ok = true;
        while (tga as usize) != 0 && ti < b_argc {
            if (unsafe { (*tga).name.v }) == 0u32 && ((unsafe { (*tga).ty }) as usize) != 0 {
                let raw_it = tc_bound_arg_typeid(mut_view(*cx), unsafe { (*tga).ty });
                let sub_it = if imp_n > 0 {
                    unsafe { subst_ty_with_vars(mut_view((*cx.thir).interner), mut_view(cx.type_vars), raw_it, view(islice2)) }
                } else {
                    raw_it
                };
                let exp_k_v = unsafe { (*typeid_at(exp_args, ti)).v };
                if !unify_ty(mut_view(*cx), sub_it, (TypeId { v: exp_k_v })) {
                    ok = false;
                }
                ti = ti + 1;
            }
            tga = unsafe { (*tga).next };
        }
        cx.current_fn = s_fn;
        cx.current_impl = s_im;
        cx.self_ty.v = s_sf;
        if !ok {
            let _ = type_error(mut_view(*cx), view(call_span), AX_TRAIT_UNSATISFIED_BOUND);
        }
        return;
    }

    // Multiple candidate impls of the same generic trait for `arg_ty` (e.g. `impl Into<i64> for X` and
    // `impl Into<bool> for X`): verify that when expected args are concrete, at least one candidate matches.
    let mut ki: usize = 0;
    while ki < b_argc {
        let ek = resolve_ty(mut_view(*cx), unsafe { *typeid_at(exp_args, ki) });
        let ek_v = ek.v;
        let ekt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ek_v })) };
        if (ekt as usize) == 0 {
            return;
        }
        let ekk = unsafe { (*ekt).kind };
        if ekk == TY_VAR || ekk == TY_INT_VAR || ekk == TY_PARAM || ekk == TY_ERROR {
            return;
        }
        unsafe { (*typeid_at(exp_args, ki)).v = ek_v; }
        ki = ki + 1;
    }
    let mut matched_any = false;
    it = unsafe { (*cx.hir).items };
    while (it as usize) != 0 && !matched_any {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && !(unsafe { (*it).is_negative }) && tc_item_generic_count(it) == 0 {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            if tc_impl_trait_matches_bound(view(*cx), tp, b) &&
               unsafe { type_matches_impl_self_exact(view(*cx.thir), view(*cx.str_in), it, (TypeId { v: arg_ty_v })) } {
                let tp_hga: *mut HirGenericArgs = unsafe { (*tp).path.generic_args };
                if (tp_hga as usize) != 0 {
                    let s_fn2 = cx.current_fn;
                    let s_im2 = cx.current_impl;
                    let s_sf2 = cx.self_ty.v;
                    cx.current_fn = 0 as *const HirItem;
                    cx.current_impl = it;
                    cx.self_ty = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    let mut tga2: *mut HirGenericArg = unsafe { (*tp_hga).args };
                    let mut ti2: usize = 0;
                    let mut all_eq = true;
                    while (tga2 as usize) != 0 && ti2 < b_argc {
                        if (unsafe { (*tga2).name.v }) == 0u32 && ((unsafe { (*tga2).ty }) as usize) != 0 {
                            let raw_cand = tc_bound_arg_typeid(mut_view(*cx), unsafe { (*tga2).ty });
                            let cand_tid = resolve_ty(mut_view(*cx), raw_cand);
                            let exp_tid_v = unsafe { (*typeid_at(exp_args, ti2)).v };
                            if cand_tid.v != exp_tid_v {
                                all_eq = false;
                            }
                            ti2 = ti2 + 1;
                        }
                        tga2 = unsafe { (*tga2).next };
                    }
                    cx.current_fn = s_fn2;
                    cx.current_impl = s_im2;
                    cx.self_ty.v = s_sf2;
                    if all_eq && ti2 == b_argc {
                        matched_any = true;
                    }
                } else {
                    return;
                }
            }
        } else if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && !(unsafe { (*it).is_negative }) && tc_item_generic_count(it) > 0 {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            if tc_impl_trait_matches_bound(view(*cx), tp, b) &&
               unsafe { type_matches_impl_self_exact(view(*cx.thir), view(*cx.str_in), it, (TypeId { v: arg_ty_v })) } {
                return;
            }
        }
        it = unsafe { (*it).next };
    }
    if !matched_any {
        let _ = type_error(mut_view(*cx), view(call_span), AX_TRAIT_UNSATISFIED_BOUND);
    }
}

fn tc_check_generic_trait_bounds_for_call(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    callee_self_v: u32,
    call_span: Span
) {
    if (fn_def as usize) == 0 || (substs as usize) == 0 ||
       (cx.hir as usize) == 0 || (cx.str_in as usize) == 0 || (cx.db as usize) == 0 ||
       !fn_item_has_any_generic_trait_bound(view(*cx), fn_def) {
        return;
    }
    let cs_f = call_span.file.v;
    let cs_s = call_span.start;
    let cs_e = call_span.end;
    let cnt = unsafe { (*substs).count };
    let args = unsafe { (*substs).args };
    let gps: *mut HirGenericParams = unsafe { (*fn_def).generic_params };
    if cnt == 0 || (args as usize) == 0 || (gps as usize) == 0 {
        return;
    }
    let enc_impl = tc_fn_enclosing_impl(cx.hir, fn_def);
    let impl_n = if (enc_impl as usize) != 0 { tc_item_generic_count(enc_impl) } else { 0 };
    let own_n = tc_item_generic_count(fn_def);
    let base_offset = if cnt == impl_n + own_n { impl_n } else { 0 };
    let mut m_idx: usize = 0;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while ((gp as usize) != 0) && m_idx < own_n && (base_offset + m_idx) < cnt {
        let arg_ty = resolve_ty(mut_view(*cx), unsafe { *typeid_at(args, base_offset + m_idx) });
        let arg_ty_v = arg_ty.v;
        let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty_v })) };
        if (at as usize) != 0 {
            let ak = unsafe { (*at).kind };
            if ak != TY_PARAM && ak != TY_VAR && ak != TY_INT_VAR && ak != TY_ERROR {
                let mut b: *mut HirType = unsafe { (*gp).bounds };
                while (b as usize) != 0 {
                    tc_check_single_generic_trait_bound(
                        mut_view(*cx),
                        fn_def,
                        substs,
                        callee_self_v,
                        (TypeId { v: arg_ty_v }),
                        b,
                        Span { file: (FileId { v: cs_f }), start: cs_s, end: cs_e }
                    );
                    b = unsafe { (*b).next };
                }
                let wc: *mut HirWhereClause = unsafe { (*fn_def).where_clause };
                let gname_v = unsafe { (*gp).name.v };
                let gsym_v = unsafe { (*gp).symbol.v };
                if (wc as usize) != 0 {
                    let g_sv = if gname_v != 0u32 {
                        unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_v })) }
                    } else {
                        StrView { ptr: 0 as *const u8, len: 0 }
                    };
                    let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
                    while (wp as usize) != 0 {
                        let wty: *mut HirType = unsafe { (*wp).ty };
                        if (wty as usize) != 0 && (unsafe { (*wty).kind }) == HIR_TYPE_PATH &&
                           ((unsafe { (*wty).path.generic_args }) as usize) == 0 {
                            let wsym_v = unsafe { (*wty).path.symbol.v };
                            let wname = unsafe { tc_path_name_sv(view(*cx), view((*wty).path)) };
                            if (gsym_v != 0u32 && wsym_v == gsym_v) || (g_sv.len > 0 && sv_eq(view(wname), view(g_sv))) {
                                let mut wb: *mut HirType = unsafe { (*wp).bounds };
                                while (wb as usize) != 0 {
                                    tc_check_single_generic_trait_bound(
                                        mut_view(*cx),
                                        fn_def,
                                        substs,
                                        callee_self_v,
                                        (TypeId { v: arg_ty_v }),
                                        wb,
                                        Span { file: (FileId { v: cs_f }), start: cs_s, end: cs_e }
                                    );
                                    wb = unsafe { (*wb).next };
                                }
                            }
                        }
                        wp = unsafe { (*wp).next };
                    }
                }
            }
        }
        m_idx = m_idx + 1;
        gp = unsafe { (*gp).next };
    }
}

struct AsyncVisitStack {
    pub fns: [64]usize,
    pub count: usize,
}

fn async_visit_contains(st: view<AsyncVisitStack>, fn_addr: usize) -> bool {
    let mut i: usize = 0;
    while i < st.count {
        if st.fns[i] == fn_addr {
            return true;
        }
        i = i + 1;
    }
    false
}

fn type_reaches_target_async_fn(
    cx: mut_view<TypeckCtx>,
    ty: TypeId,
    target_fn: *const HirItem,
    st: mut_view<AsyncVisitStack>,
    depth: usize
) -> bool {
    if depth > 16 || ty.v == 0u32 {
        return false;
    }
    let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_ty.v })) };
    if (t as usize) == 0 {
        return false;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_COROUTINE {
        let callee_fn: *const HirItem = unsafe { (*t).def };
        if (callee_fn as usize) == 0 {
            return false;
        }
        if (callee_fn as usize) == (target_fn as usize) {
            return true;
        }
        if !async_visit_contains(view(*st), callee_fn as usize) && (st.count) < 64 {
            let idx = st.count;
            st.fns[idx] = callee_fn as usize;
            st.count = idx + 1;
            let c_body: *mut HirBlock = unsafe { (*callee_fn).body };
            let hit = block_find_recursive_await(mut_view(*cx), c_body, target_fn, mut_view(*st));
            if (hit as usize) != 0 {
                return true;
            }
        }
        return false;
    }
    if tk == TY_TUPLE || tk == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        while i < fc && (fptr as usize) != 0 {
            let fv = unsafe { (*typeid_at(fptr, i)).v };
            if type_reaches_target_async_fn(mut_view(*cx), (TypeId { v: fv }), target_fn, mut_view(*st), depth + 1) {
                return true;
            }
            i = i + 1;
        }
    } else if tk == TY_ENUM {
        let vc = unsafe { (*t).variant_count };
        let vfc = unsafe { (*t).variant_field_counts };
        let vfptr = unsafe { (*t).variant_fields };
        let mut v: usize = 0;
        while v < vc && (vfc as usize) != 0 && (vfptr as usize) != 0 {
            let fc = unsafe { *usize_at(vfc, v) };
            let row = unsafe { *typeid_ptr_at(vfptr, v) };
            let mut j: usize = 0;
            while j < fc && (row as usize) != 0 {
                let fv = unsafe { (*typeid_at(row, j)).v };
                if type_reaches_target_async_fn(mut_view(*cx), (TypeId { v: fv }), target_fn, mut_view(*st), depth + 1) {
                    return true;
                }
                j = j + 1;
            }
            v = v + 1;
        }
    } else if tk == TY_ARRAY {
        let ev = unsafe { (*t).elem.v };
        return type_reaches_target_async_fn(mut_view(*cx), (TypeId { v: ev }), target_fn, mut_view(*st), depth + 1);
    }
    false
}

fn expr_find_recursive_await(
    cx: mut_view<TypeckCtx>,
    expr: *mut HirExpr,
    target_fn: *const HirItem,
    st: mut_view<AsyncVisitStack>
) -> *mut HirExpr {
    if (expr as usize) == 0 {
        return 0 as *mut HirExpr;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_AWAIT {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let inner_hit = expr_find_recursive_await(mut_view(*cx), in_e, target_fn, mut_view(*st));
        if (inner_hit as usize) != 0 {
            return inner_hit;
        }
        if (in_e as usize) != 0 {
            let tp = unsafe { thir_get_expr_type(view(*cx.thir), in_e) };
            if tp.v != 0u32 {
                if type_reaches_target_async_fn(mut_view(*cx), (TypeId { v: tp.v }), target_fn, mut_view(*st), 0) {
                    return expr;
                }
            }
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_LOOP || ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_COMPTIME {
        let sub_blk: *mut HirBlock = unsafe { (*expr).block };
        return block_find_recursive_await(mut_view(*cx), sub_blk, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_IF {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let h1 = expr_find_recursive_await(mut_view(*cx), cond_e, target_fn, mut_view(*st));
        if (h1 as usize) != 0 { return h1; }
        let then_b: *mut HirBlock = unsafe { (*expr).block };
        let h2 = block_find_recursive_await(mut_view(*cx), then_b, target_fn, mut_view(*st));
        if (h2 as usize) != 0 { return h2; }
        let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
        return expr_find_recursive_await(mut_view(*cx), else_e, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_WHILE || ek == HIR_EXPR_FOR {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let h1 = expr_find_recursive_await(mut_view(*cx), cond_e, target_fn, mut_view(*st));
        if (h1 as usize) != 0 { return h1; }
        let iter_e: *mut HirExpr = unsafe { (*expr).iter };
        let h2 = expr_find_recursive_await(mut_view(*cx), iter_e, target_fn, mut_view(*st));
        if (h2 as usize) != 0 { return h2; }
        let body_b: *mut HirBlock = unsafe { (*expr).block };
        return block_find_recursive_await(mut_view(*cx), body_b, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_MATCH {
        let scrut_e: *mut HirExpr = unsafe { (*expr).cond };
        let h1 = expr_find_recursive_await(mut_view(*cx), scrut_e, target_fn, mut_view(*st));
        if (h1 as usize) != 0 { return h1; }
        let mut arm: *mut HirMatchArm = unsafe { (*expr).arms };
        while ((arm as usize) != 0) {
            let guard_e: *mut HirExpr = unsafe { (*arm).guard };
            let hg = expr_find_recursive_await(mut_view(*cx), guard_e, target_fn, mut_view(*st));
            if (hg as usize) != 0 { return hg; }
            let body_e: *mut HirExpr = unsafe { (*arm).body };
            let hb = expr_find_recursive_await(mut_view(*cx), body_e, target_fn, mut_view(*st));
            if (hb as usize) != 0 { return hb; }
            arm = unsafe { (*arm).next };
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_CALL {
        let callee_e: *mut HirExpr = unsafe { (*expr).callee };
        let hc = expr_find_recursive_await(mut_view(*cx), callee_e, target_fn, mut_view(*st));
        if (hc as usize) != 0 { return hc; }
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while ((a as usize) != 0) {
            let ha = expr_find_recursive_await(mut_view(*cx), a, target_fn, mut_view(*st));
            if (ha as usize) != 0 { return ha; }
            a = unsafe { (*a).next };
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_METHOD_CALL {
        let recv_e: *mut HirExpr = unsafe { (*expr).receiver };
        let hr = expr_find_recursive_await(mut_view(*cx), recv_e, target_fn, mut_view(*st));
        if (hr as usize) != 0 { return hr; }
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while ((a as usize) != 0) {
            let ha = expr_find_recursive_await(mut_view(*cx), a, target_fn, mut_view(*st));
            if (ha as usize) != 0 { return ha; }
            a = unsafe { (*a).next };
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_BINARY {
        let left_e: *mut HirExpr = unsafe { (*expr).left };
        let hl = expr_find_recursive_await(mut_view(*cx), left_e, target_fn, mut_view(*st));
        if (hl as usize) != 0 { return hl; }
        let right_e: *mut HirExpr = unsafe { (*expr).right };
        return expr_find_recursive_await(mut_view(*cx), right_e, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_UNARY || ek == HIR_EXPR_TRY || ek == HIR_EXPR_CAST || ek == HIR_EXPR_VIEW || ek == HIR_EXPR_JUMP {
        let inner_e: *mut HirExpr = unsafe { (*expr).inner };
        return expr_find_recursive_await(mut_view(*cx), inner_e, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX || ek == HIR_EXPR_INDEX {
        let base_e: *mut HirExpr = unsafe { (*expr).base };
        let hb = expr_find_recursive_await(mut_view(*cx), base_e, target_fn, mut_view(*st));
        if (hb as usize) != 0 { return hb; }
        let idx_e: *mut HirExpr = unsafe { (*expr).index_arg };
        return expr_find_recursive_await(mut_view(*cx), idx_e, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_TUPLE || ek == HIR_EXPR_ARRAY {
        let mut e: *mut HirExpr = unsafe { (*expr).elems };
        while ((e as usize) != 0) {
            let he = expr_find_recursive_await(mut_view(*cx), e, target_fn, mut_view(*st));
            if (he as usize) != 0 { return he; }
            e = unsafe { (*e).next };
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_STRUCT {
        let mut f: *mut HirFieldInit = unsafe { (*expr).fields };
        while ((f as usize) != 0) {
            let f_val: *mut HirExpr = unsafe { (*f).expr };
            let hf = expr_find_recursive_await(mut_view(*cx), f_val, target_fn, mut_view(*st));
            if (hf as usize) != 0 { return hf; }
            f = unsafe { (*f).next };
        }
        return 0 as *mut HirExpr;
    }
    0 as *mut HirExpr
}

fn block_find_recursive_await(
    cx: mut_view<TypeckCtx>,
    blk: *mut HirBlock,
    target_fn: *const HirItem,
    st: mut_view<AsyncVisitStack>
) -> *mut HirExpr {
    if (blk as usize) == 0 {
        return 0 as *mut HirExpr;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while ((s as usize) != 0) {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let init_e: *mut HirExpr = unsafe { (*s).expr };
            let h = expr_find_recursive_await(mut_view(*cx), init_e, target_fn, mut_view(*st));
            if (h as usize) != 0 { return h; }
            let else_b: *mut HirBlock = unsafe { (*s).else_block };
            let he = block_find_recursive_await(mut_view(*cx), else_b, target_fn, mut_view(*st));
            if (he as usize) != 0 { return he; }
        } else if sk == HIR_STMT_ASSIGN {
            let left_e: *mut HirExpr = unsafe { (*s).left };
            let hl = expr_find_recursive_await(mut_view(*cx), left_e, target_fn, mut_view(*st));
            if (hl as usize) != 0 { return hl; }
            let right_e: *mut HirExpr = unsafe { (*s).right };
            let hr = expr_find_recursive_await(mut_view(*cx), right_e, target_fn, mut_view(*st));
            if (hr as usize) != 0 { return hr; }
        } else if sk == HIR_STMT_EXPR {
            let stmt_e: *mut HirExpr = unsafe { (*s).expr };
            let he = expr_find_recursive_await(mut_view(*cx), stmt_e, target_fn, mut_view(*st));
            if (he as usize) != 0 { return he; }
        }
        s = unsafe { (*s).next };
    }
    0 as *mut HirExpr
}

fn check_single_async_fn_recursion(cx: mut_view<TypeckCtx>, fn_it: *const HirItem) {
    if (fn_it as usize) == 0 || !(unsafe { (*fn_it).is_async }) || tc_is_default_inst(fn_it) {
        return;
    }
    let body_blk: *mut HirBlock = unsafe { (*fn_it).body };
    if (body_blk as usize) == 0 {
        return;
    }
    let mut st = AsyncVisitStack {
        fns: [0usize; 64],
        count: 1,
    };
    st.fns[0] = fn_it as usize;
    let cycle_await = block_find_recursive_await(mut_view(*cx), body_blk, fn_it, mut_view(st));
    if (cycle_await as usize) != 0 {
        let _ = unsafe { type_error(mut_view(*cx), view((*cycle_await).span), AX_ASYNC_RECURSIVE_FUTURE) };
    }
}

fn check_recursive_async_fns(cx: mut_view<TypeckCtx>) {
    if (cx.hir as usize) == 0 || (cx.thir as usize) == 0 || (cx.sink as usize) == 0 {
        return;
    }
    let mut top_it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_FN {
            let sym_v = unsafe { (*top_it).symbol.v };
            if !(sym_v >= 0x40000000u32 && sym_v < 0x50000000u32) {
                let orig_m = unsafe { find_orig_impl_member_with_thir(view(*cx.hir), cx.thir as *const Thir, top_it) };
                if (orig_m as usize) == 0 {
                    check_single_async_fn_recursion(mut_view(*cx), top_it);
                }
            }
        } else if tk == HIR_ITEM_IMPL || tk == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    check_single_async_fn_recursion(mut_view(*cx), m);
                }
                m = unsafe { (*m).next };
            }
        }
        top_it = unsafe { (*top_it).next };
    }
}

// =============================================================================
// SPEC-52: Freestanding Profiles, Entry/Naked/Section/Interrupt Validation,
// and Compile-Time Call-Graph Runtime Capability Verifier (T512)
// =============================================================================

pub const TY_PROFILE_HOSTED: u32 = 0u32;
pub const TY_PROFILE_FREESTANDING: u32 = 1u32;
pub const TY_PROFILE_KERNEL: u32 = 2u32;
pub const TY_PROFILE_SYSTEM: u32 = 3u32;

pub const RT_CAP_STARTUP: u32        = 1u32;
pub const RT_CAP_PANIC: u32          = 2u32;
pub const RT_CAP_UNWIND: u32         = 4u32;
pub const RT_CAP_HEAP_ALLOC: u32     = 8u32;
pub const RT_CAP_TLS: u32            = 16u32;
pub const RT_CAP_THREAD: u32          = 32u32;
pub const RT_CAP_BLOCKING: u32        = 64u32;
pub const RT_CAP_ASYNC_REACTOR: u32   = 128u32;
pub const RT_CAP_OS_IO: u32           = 256u32;
pub const RT_CAP_OS_ENV_PROCESS: u32  = 512u32;
pub const RT_CAP_GPU_RUNTIME: u32     = 1024u32;
pub const RT_CAP_REFLECT: u32         = 2048u32;
const RT_CAP_ASYNC_SUSPEND: u32       = 4096u32;

const RT_INTERRUPT_FORBIDDEN_MASK: u32 =
    RT_CAP_HEAP_ALLOC | RT_CAP_THREAD | RT_CAP_BLOCKING | RT_CAP_ASYNC_REACTOR |
    RT_CAP_OS_IO | RT_CAP_OS_ENV_PROCESS | RT_CAP_TLS | RT_CAP_UNWIND |
    RT_CAP_GPU_RUNTIME | RT_CAP_ASYNC_SUSPEND;

struct CapEdge {
    callee_idx: u32,
    call_span: Span,
    next: *mut CapEdge,
}

struct CapNode {
    item: *const HirItem,
    is_std: bool,
    direct_caps: u32,
    trans_caps: u32,
    direct_span: Span,
    direct_leaf_name: StrView,
    edges: *mut CapEdge,
    next_hop: [13]u32,
}

struct CapGraph {
    nodes: *mut CapNode,
    count: usize,
    hir: *const HirFile,
    thir: *const Thir,
    interner: *const StrInterner,
}

unsafe fn cap_node_at(base: *mut CapNode, idx: usize) -> *mut CapNode {
    ((base as usize) + mul_usize(idx, size_of<CapNode>())) as *mut CapNode
}

unsafe fn cap_node_const_at(base: *const CapNode, idx: usize) -> *const CapNode {
    ((base as usize) + mul_usize(idx, size_of<CapNode>())) as *const CapNode
}

fn fre_sv_eq_str(sv: view<StrView>, lit: str) -> bool {
    let raw: StrView = unsafe { *(address_of(lit) as *const StrView) };
    if sv.len != raw.len || (sv.ptr as usize) == 0 {
        return false;
    }
    let bytes: view<[u8]> = unsafe { *(address_of(lit) as *const view<[u8]>) };
    let mut i: usize = 0;
    while i < raw.len {
        if (unsafe { *(sv.ptr + i) }) != bytes[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn fre_arena_str(arena: mut_view<Arena>, lit: str) -> StrView {
    let raw: StrView = unsafe { *(address_of(lit) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(lit) as *const view<[u8]>) };
    let n = raw.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn fre_arena_clone_sv(arena: mut_view<Arena>, sv: view<StrView>) -> StrView {
    if sv.len == 0 || (sv.ptr as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let dst = arena_alloc_raw(mut_view(*arena), sv.len + 1, 1);
    let mut i: usize = 0;
    while i < sv.len {
        unsafe { *(dst + i) = *(sv.ptr + i); }
        i = i + 1;
    }
    unsafe { *(dst + sv.len) = 0u8; }
    StrView { ptr: dst as *const u8, len: sv.len }
}

fn fre_profile_name(arena: mut_view<Arena>, profile: u32) -> StrView {
    if profile == TY_PROFILE_FREESTANDING {
        return fre_arena_str(arena, "freestanding");
    }
    if profile == TY_PROFILE_KERNEL {
        return fre_arena_str(arena, "kernel");
    }
    if profile == TY_PROFILE_SYSTEM {
        return fre_arena_str(arena, "system");
    }
    fre_arena_str(arena, "hosted")
}

fn fre_cap_bit_name(arena: mut_view<Arena>, bit: usize) -> StrView {
    if bit == 0 { return fre_arena_str(arena, "startup"); }
    if bit == 1 { return fre_arena_str(arena, "panic"); }
    if bit == 2 { return fre_arena_str(arena, "unwind"); }
    if bit == 3 { return fre_arena_str(arena, "heap_alloc"); }
    if bit == 4 { return fre_arena_str(arena, "tls"); }
    if bit == 5 { return fre_arena_str(arena, "thread"); }
    if bit == 6 { return fre_arena_str(arena, "blocking"); }
    if bit == 7 { return fre_arena_str(arena, "async_reactor"); }
    if bit == 8 { return fre_arena_str(arena, "os_io"); }
    if bit == 9 { return fre_arena_str(arena, "os_env_process"); }
    if bit == 10 { return fre_arena_str(arena, "gpu_runtime"); }
    if bit == 11 { return fre_arena_str(arena, "reflect"); }
    fre_arena_str(arena, "async")
}

fn fre_pick_forbidden_bit(mask: u32) -> usize {
    if (mask & RT_CAP_HEAP_ALLOC) != 0u32 { return 3; }
    if (mask & RT_CAP_BLOCKING) != 0u32 { return 6; }
    if (mask & RT_CAP_THREAD) != 0u32 { return 5; }
    if (mask & RT_CAP_ASYNC_SUSPEND) != 0u32 { return 12; }
    if (mask & RT_CAP_ASYNC_REACTOR) != 0u32 { return 7; }
    if (mask & RT_CAP_OS_IO) != 0u32 { return 8; }
    if (mask & RT_CAP_OS_ENV_PROCESS) != 0u32 { return 9; }
    if (mask & RT_CAP_TLS) != 0u32 { return 4; }
    if (mask & RT_CAP_UNWIND) != 0u32 { return 2; }
    if (mask & RT_CAP_GPU_RUNTIME) != 0u32 { return 10; }
    let mut b: usize = 0;
    while b < 13 {
        if (mask & (1u32 << (b as u32))) != 0u32 {
            return b;
        }
        b = b + 1;
    }
    0
}

fn tc_item_is_interrupt_abi_ptr(str_in: *const StrInterner, it: *const HirItem) -> bool {
    if (str_in as usize) == 0 || (it as usize) == 0 {
        return false;
    }
    let abi_v = unsafe { (*it).abi.v };
    if abi_v == 0u32 {
        return false;
    }
    let sv = unsafe { interner_get(view(*str_in), StrId { v: abi_v }) };
    fre_sv_eq_str(view(sv), "interrupt")
}

fn fre_is_synth_fn_clone(hir_file: view<HirFile>, thir_ptr: *const Thir, it: *const HirItem, is_top_level: bool) -> bool {
    if (it as usize) == 0 {
        return true;
    }
    if (unsafe { (*it).span.file.v }) == 0xFFFFFFFEu32 {
        return true;
    }
    let sym_v = unsafe { (*it).symbol.v };
    if sym_v >= 0x08000000u32 && sym_v < 0x80000000u32 {
        return true;
    }
    if is_top_level && (unsafe { (*it).kind }) == HIR_ITEM_FN {
        let orig = find_orig_impl_member_with_thir(hir_file, thir_ptr, it);
        if (orig as usize) != 0 {
            return true;
        }
    }
    false
}

fn fre_has_generic_params(it: *const HirItem) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    let gp: *mut HirGenericParams = unsafe { (*it).generic_params };
    (gp as usize) != 0 && (unsafe { (*gp).params as usize }) != 0
}

fn fre_item_has_attr_name(interner: view<StrInterner>, attrs: *mut HirAttr, name: str, out_attr: mut_view<*mut HirAttr>) -> bool {
    *out_attr = 0 as *mut HirAttr;
    let raw: StrView = unsafe { *(address_of(name) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let mut cur: *mut HirAttr = attrs;
    while (cur as usize) != 0 {
        let sv = interner_get(interner, StrId { v: unsafe { (*cur).name.v } });
        if sv.len == raw.len && (sv.ptr as usize) != 0 {
            let mut eq = true;
            let mut i: usize = 0;
            while i < raw.len {
                if (unsafe { *(sv.ptr + i) }) != bytes[i] {
                    eq = false;
                    break;
                }
                i = i + 1;
            }
            if eq {
                *out_attr = cur;
                return true;
            }
        }
        cur = unsafe { (*cur).next };
    }
    false
}

fn fre_report_simple_diag(sink: mut_view<DiagSink>, code_v: u32, sp: Span) {
    report_typeck_diag(sink, code_v, sp.file.v, sp.start, sp.end);
}

fn fre_report_dup_diag(sink: mut_view<DiagSink>, code_v: u32, sp: Span, first_sp: Span, first_msg: str) {
    let code = DiagCode { v: code_v };
    let msg_sv = tc_alloc_code_default_msg(mut_view(sink.arena), code);
    let lbl_msg = fre_arena_str(mut_view(sink.arena), first_msg);
    let lbl = arena_alloc_raw(mut_view(sink.arena), size_of<DiagLabel>(), align_of<DiagLabel>()) as *mut DiagLabel;
    unsafe {
        (*lbl).span = first_sp;
        (*lbl).message = lbl_msg;
    }
    let d = Diagnostic {
        code: code,
        severity: diag_code_severity(code),
        message: msg_sv,
        primary: sp,
        labels: lbl,
        label_count: 1,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

fn fre_make_str_data_entry(arena: mut_view<Arena>, key_lit: str, val_sv: StrView) -> DiagDataEntry {
    DiagDataEntry {
        key: fre_arena_str(arena, key_lit),
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: val_sv,
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0,
        },
    }
}

fn fre_report_cap_diag(
    sink: mut_view<DiagSink>,
    code_v: u32,
    sp: Span,
    sec_sp: Span,
    has_sec_lbl: bool,
    note_sv: StrView,
    key1: str,
    val1: StrView,
    key2: str,
    val2: StrView
) {
    let code = DiagCode { v: code_v };
    let msg_sv = tc_alloc_code_default_msg(mut_view(sink.arena), code);
    let mut lbl_ptr: *mut DiagLabel = 0 as *mut DiagLabel;
    let mut lbl_cnt: usize = 0;
    if has_sec_lbl && sec_sp.file.v != 0u32 && (sec_sp.file.v != sp.file.v || sec_sp.start != sp.start) {
        let lbl = arena_alloc_raw(mut_view(sink.arena), size_of<DiagLabel>(), align_of<DiagLabel>()) as *mut DiagLabel;
        let lmsg = fre_arena_str(mut_view(sink.arena), "forbidden capability introduced here");
        unsafe {
            (*lbl).span = sec_sp;
            (*lbl).message = lmsg;
        }
        lbl_ptr = lbl;
        lbl_cnt = 1;
    }
    let mut note_ptr: *mut StrView = 0 as *mut StrView;
    let mut note_cnt: usize = 0;
    if note_sv.len > 0 && (note_sv.ptr as usize) != 0 {
        let np = arena_alloc_raw(mut_view(sink.arena), size_of<StrView>(), align_of<StrView>()) as *mut StrView;
        unsafe { *np = note_sv; }
        note_ptr = np;
        note_cnt = 1;
    }
    let data_arr = arena_alloc_raw(mut_view(sink.arena), mul_usize(2, size_of<DiagDataEntry>()), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
    let e0 = fre_make_str_data_entry(mut_view(sink.arena), key1, val1);
    let e1 = fre_make_str_data_entry(mut_view(sink.arena), key2, val2);
    let e1_ptr = ((data_arr as usize) + size_of<DiagDataEntry>()) as *mut DiagDataEntry;
    unsafe {
        *data_arr = e0;
        *e1_ptr = e1;
    }
    let d = Diagnostic {
        code: code,
        severity: diag_code_severity(code),
        message: msg_sv,
        primary: sp,
        labels: lbl_ptr,
        label_count: lbl_cnt,
        notes: note_ptr,
        note_count: note_cnt,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: data_arr,
        data_count: 2,
    };
    diag_sink_report(sink, view(d));
}

fn fre_resolve_tid(_thir: view<Thir>, tid: TypeId) -> TypeId {
    tid
}

fn fre_is_struct_named(interner: view<StrInterner>, thir: view<Thir>, tid: TypeId, expected: str) -> bool {
    let r = fre_resolve_tid(thir, tid);
    if r.v == 0u32 {
        return false;
    }
    let t = type_get(view(thir.interner), r);
    if (t as usize) == 0 || (unsafe { (*t).kind }) != TY_STRUCT {
        return false;
    }
    let def: *const HirItem = unsafe { (*t).def };
    if (def as usize) == 0 {
        return false;
    }
    let sv = interner_get(interner, StrId { v: unsafe { (*def).name.v } });
    fre_sv_eq_str(view(sv), expected)
}

fn fre_is_interrupt_frame_param(interner: view<StrInterner>, thir: view<Thir>, tid: TypeId) -> bool {
    let r = fre_resolve_tid(thir, tid);
    if r.v == 0u32 {
        return false;
    }
    let t = type_get(view(thir.interner), r);
    if (t as usize) == 0 {
        return false;
    }
    let k = unsafe { (*t).kind };
    if k == TY_ERROR {
        return true;
    }
    if k == TY_VIEW {
        return fre_is_struct_named(interner, thir, TypeId { v: unsafe { (*t).pointee.v } }, "InterruptFrame");
    }
    if k == TY_PTR && !(unsafe { (*t).is_mut }) {
        return fre_is_struct_named(interner, thir, TypeId { v: unsafe { (*t).pointee.v } }, "InterruptFrame");
    }
    false
}

fn fre_is_const_u8_ptr(thir: view<Thir>, tid: TypeId) -> bool {
    let r = fre_resolve_tid(thir, tid);
    if r.v == 0u32 {
        return false;
    }
    let t = type_get(view(thir.interner), r);
    if (t as usize) == 0 {
        return false;
    }
    let k = unsafe { (*t).kind };
    if k == TY_ERROR {
        return true;
    }
    if k != TY_PTR || (unsafe { (*t).is_mut }) {
        return false;
    }
    let er = fre_resolve_tid(thir, TypeId { v: unsafe { (*t).pointee.v } });
    let et = type_get(view(thir.interner), er);
    (et as usize) != 0 && ((unsafe { (*et).kind }) == TY_U8 || (unsafe { (*et).kind }) == TY_ERROR)
}

fn fre_find_drop_fn_for_def(hir_file: view<HirFile>, interner: view<StrInterner>, def: *const HirItem) -> *const HirItem {
    if (def as usize) == 0 {
        return 0 as *const HirItem;
    }
    let def_sym_v = unsafe { (*def).symbol.v };
    let def_name_v = unsafe { (*def).name.v };
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && !(unsafe { (*it).is_negative }) {
            if tc_impl_is_lang_drop(hir_file.items, it, interner) {
                let st: *mut HirType = unsafe { (*it).self_type };
                if (st as usize) != 0 && (unsafe { (*st).kind }) == HIR_TYPE_PATH {
                    let s_sym_v = unsafe { (*st).path.symbol.v };
                    let s_name_v = unsafe { (*st).path.name.v };
                    let matched = (def_sym_v != 0u32 && s_sym_v == def_sym_v) ||
                        (def_sym_v == 0u32 && def_name_v != 0u32 && s_name_v == def_name_v);
                    if matched {
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while (m as usize) != 0 {
                            if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                                return m as *const HirItem;
                            }
                            m = unsafe { (*m).next };
                        }
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *const HirItem
}

fn fre_type_implements_alloc_trait(hir_file: view<HirFile>, thir: view<Thir>, interner: view<StrInterner>, static_tid: TypeId) -> bool {
    let r = fre_resolve_tid(thir, static_tid);
    let r_v = r.v;
    if r_v == 0u32 {
        return false;
    }
    let t = type_get(view(thir.interner), r);
    if (t as usize) == 0 {
        return false;
    }
    if (unsafe { (*t).kind }) == TY_ERROR {
        return true;
    }
    let def: *const HirItem = unsafe { (*t).def };
    let def_sym_v = if (def as usize) != 0 { unsafe { (*def).symbol.v } } else { 0u32 };
    let def_name_v = if (def as usize) != 0 { unsafe { (*def).name.v } } else { 0u32 };
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && !(unsafe { (*it).is_negative }) {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            if (tp as usize) != 0 && (unsafe { (*tp).kind }) == HIR_TYPE_PATH {
                let mut tr_name_v = unsafe { (*tp).path.name.v };
                let tr_sym_v = unsafe { (*tp).path.symbol.v };
                if tr_name_v == 0u32 && tr_sym_v != 0u32 {
                    let tr_it = unsafe_find_item_by_sym(
                        unsafe { address_of(hir_file.items) as *const HirFile },
                        unsafe { address_of(thir.interner.arena.head) as *const Thir },
                        SymbolId { v: tr_sym_v }
                    );
                    if (tr_it as usize) != 0 {
                        tr_name_v = unsafe { (*tr_it).name.v };
                    }
                }
                if tr_name_v != 0u32 {
                    let tr_sv = interner_get(interner, StrId { v: tr_name_v });
                    if fre_sv_eq_str(view(tr_sv), "GlobalAlloc") || fre_sv_eq_str(view(tr_sv), "Allocator") {
                        let imp_self_tid = fre_resolve_tid(thir, thir_get_item_type(thir, it as *const HirItem));
                        if imp_self_tid.v != 0u32 && imp_self_tid.v == r_v {
                            return true;
                        }
                        let st: *mut HirType = unsafe { (*it).self_type };
                        if (st as usize) != 0 && (unsafe { (*st).kind }) == HIR_TYPE_PATH && (def as usize) != 0 {
                            let s_sym_v = unsafe { (*st).path.symbol.v };
                            let s_name_v = unsafe { (*st).path.name.v };
                            if (def_sym_v != 0u32 && s_sym_v == def_sym_v) ||
                               (def_name_v != 0u32 && s_name_v == def_name_v) {
                                return true;
                            }
                        }
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

fn fre_validate_section_name_attr(at: *const HirAttr) -> bool {
    if (at as usize) == 0 {
        return false;
    }
    let arg: *mut HirAttrArg = unsafe { (*at).args };
    if (arg as usize) == 0 || (unsafe { (*arg).next as usize }) != 0 {
        return false;
    }
    if (unsafe { (*arg).name.v }) != 0u32 {
        return false;
    }
    let ex: *mut HirExpr = unsafe { (*arg).expr };
    if (ex as usize) == 0 || (unsafe { (*ex).kind }) != HIR_EXPR_LITERAL {
        return false;
    }
    let tok_k = unsafe { (*ex).literal.kind };
    let tok_f = unsafe { (*ex).literal.flags };
    if tok_k != TOK_STR || (tok_f & TOK_FLAG_ERROR) != 0u16 {
        return false;
    }
    let slen = unsafe { (*ex).literal.str_len };
    let sptr = unsafe { (*ex).literal.str_ptr };
    if slen < 1 || slen > 64 || (sptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < slen {
        let ch = unsafe { *(sptr + i) };
        if ch < 32u8 || ch > 126u8 {
            return false;
        }
        i = i + 1;
    }
    true
}

fn fre_check_disallowed_param_or_stmt_attrs(interner: view<StrInterner>, sink: mut_view<DiagSink>, attrs: *mut HirAttr) {
    let mut cur: *mut HirAttr = attrs;
    while (cur as usize) != 0 {
        let sv = interner_get(interner, StrId { v: unsafe { (*cur).name.v } });
        if fre_sv_eq_str(view(sv), "section") || fre_sv_eq_str(view(sv), "used") {
            fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_SECTION, unsafe { (*cur).span });
        } else if fre_sv_eq_str(view(sv), "naked") {
            fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_NAKED_FN, unsafe { (*cur).span });
        } else if fre_sv_eq_str(view(sv), "entry") {
            fre_report_simple_diag(mut_view(*sink), AX_TYPE_ENTRY_SIGNATURE, unsafe { (*cur).span });
        } else if fre_sv_eq_str(view(sv), "panic_handler") {
            fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_PANIC_HANDLER, unsafe { (*cur).span });
        } else if fre_sv_eq_str(view(sv), "global_allocator") {
            fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_GLOBAL_ALLOCATOR, unsafe { (*cur).span });
        }
        cur = unsafe { (*cur).next };
    }
}

fn fre_scan_expr_stmt_attrs_and_naked(
    interner: view<StrInterner>,
    sink: mut_view<DiagSink>,
    expr: *mut HirExpr,
    is_naked_body: bool,
    reported_naked_let: mut_view<bool>
) {
    let mut cur = expr;
    while (cur as usize) != 0 {
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_BLOCK || k == HIR_EXPR_UNSAFE || k == HIR_EXPR_LOOP || k == HIR_EXPR_COMPTIME {
            fre_scan_block_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).block }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_IF {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).cond }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_block_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).block }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).else_branch }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_WHILE {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).cond }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_block_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).block }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_FOR {
            if is_naked_body && !(*reported_naked_let) {
                *reported_naked_let = true;
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_NAKED_FN, unsafe { (*cur).span });
            }
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).iter }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_block_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).block }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_MATCH {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).cond }, is_naked_body, mut_view(*reported_naked_let));
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while (a as usize) != 0 {
                fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*a).guard }, is_naked_body, mut_view(*reported_naked_let));
                fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*a).body }, is_naked_body, mut_view(*reported_naked_let));
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_CALL {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).callee }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).args }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_METHOD_CALL {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).receiver }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).args }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_CLOSURE {
            let mut cp: *mut HirParam = unsafe { (*cur).params };
            while (cp as usize) != 0 {
                fre_check_disallowed_param_or_stmt_attrs(interner, mut_view(*sink), unsafe { (*cp).attrs });
                cp = unsafe { (*cp).next };
            }
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).body }, false, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_BINARY {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).left }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).right }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_UNARY || k == HIR_EXPR_VIEW || k == HIR_EXPR_JUMP || k == HIR_EXPR_CAST || k == HIR_EXPR_TRY || k == HIR_EXPR_AWAIT {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).inner }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_ARRAY {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).elems }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).count_expr }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_TUPLE {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).elems }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_STRUCT {
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*f).expr }, is_naked_body, mut_view(*reported_naked_let));
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_RANGE {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).start_expr }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).end_expr }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_FIELD || k == HIR_EXPR_TUPLE_INDEX {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).base }, is_naked_body, mut_view(*reported_naked_let));
        } else if k == HIR_EXPR_INDEX {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).base }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*cur).index_arg }, is_naked_body, mut_view(*reported_naked_let));
        }
        cur = unsafe { (*cur).next };
    }
}

fn fre_scan_block_stmt_attrs_and_naked(
    interner: view<StrInterner>,
    sink: mut_view<DiagSink>,
    blk: *mut HirBlock,
    is_naked_body: bool,
    reported_naked_let: mut_view<bool>
) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while (s as usize) != 0 {
        fre_check_disallowed_param_or_stmt_attrs(interner, mut_view(*sink), unsafe { (*s).attrs });
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            if is_naked_body && !(*reported_naked_let) {
                *reported_naked_let = true;
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_NAKED_FN, unsafe { (*s).span });
            }
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*s).expr }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_block_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*s).else_block }, is_naked_body, mut_view(*reported_naked_let));
        } else if sk == HIR_STMT_ASSIGN {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*s).left }, is_naked_body, mut_view(*reported_naked_let));
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*s).right }, is_naked_body, mut_view(*reported_naked_let));
        } else if sk == HIR_STMT_EXPR {
            fre_scan_expr_stmt_attrs_and_naked(interner, mut_view(*sink), unsafe { (*s).expr }, is_naked_body, mut_view(*reported_naked_let));
        }
        s = unsafe { (*s).next };
    }
}

fn fre_type_ok_in_naked_sig(hir_file: view<HirFile>, thir: view<Thir>, interner: view<StrInterner>, tid: TypeId) -> bool {
    let r = fre_resolve_tid(thir, tid);
    let r_v = r.v;
    if r_v == 0u32 {
        return true;
    }
    let t = type_get(view(thir.interner), r);
    if (t as usize) == 0 {
        return true;
    }
    let k = unsafe { (*t).kind };
    if k == TY_ERROR || k == TY_UNIT || k == TY_NEVER || k == TY_BOOL || k == TY_CHAR ||
       k == TY_I8 || k == TY_I16 || k == TY_I32 || k == TY_I64 || k == TY_ISIZE ||
       k == TY_U8 || k == TY_U16 || k == TY_U32 || k == TY_U64 || k == TY_USIZE ||
       k == TY_PTR || k == TY_FN {
        return true;
    }
    if k == TY_STRUCT || k == TY_ENUM || k == TY_TUPLE {
        let def = unsafe { (*t).def };
        if (def as usize) != 0 && (fre_find_drop_fn_for_def(hir_file, interner, def) as usize) != 0 {
            return false;
        }
        let sz = type_size(TypeId { v: r_v }, view(thir.interner));
        return sz <= 8u32;
    }
    false
}

fn fre_check_item_attrs_universal(
    hir_file: view<HirFile>,
    thir: view<Thir>,
    interner: view<StrInterner>,
    sink: mut_view<DiagSink>,
    it: *const HirItem,
    in_impl_or_trait: bool,
    first_panic: mut_view<*const HirItem>,
    first_alloc: mut_view<*const HirItem>
) {
    let ik = unsafe { (*it).kind };
    let attrs: *mut HirAttr = unsafe { (*it).attrs };

    // 1. @section and @used validation on item and sub-declarations (AXS-FRE-014)
    let mut cur_at: *mut HirAttr = attrs;
    while (cur_at as usize) != 0 {
        let an_sv = interner_get(interner, StrId { v: unsafe { (*cur_at).name.v } });
        if fre_sv_eq_str(view(an_sv), "section") {
            if ik != HIR_ITEM_FN && ik != HIR_ITEM_STATIC {
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_SECTION, unsafe { (*cur_at).span });
            } else if !fre_validate_section_name_attr(cur_at as *const HirAttr) {
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_SECTION, unsafe { (*cur_at).span });
            }
        } else if fre_sv_eq_str(view(an_sv), "used") {
            if ik != HIR_ITEM_FN && ik != HIR_ITEM_STATIC {
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_SECTION, unsafe { (*cur_at).span });
            } else if (unsafe { (*cur_at).args as usize }) != 0 {
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_SECTION, unsafe { (*cur_at).span });
            }
        }
        cur_at = unsafe { (*cur_at).next };
    }

    if ik == HIR_ITEM_STRUCT {
        let mut fd: *mut HirFieldDecl = unsafe { (*it).struct_fields };
        while (fd as usize) != 0 {
            fre_check_disallowed_param_or_stmt_attrs(interner, mut_view(*sink), unsafe { (*fd).attrs });
            fd = unsafe { (*fd).next };
        }
    } else if ik == HIR_ITEM_ENUM {
        let mut vd: *mut HirVariantDecl = unsafe { (*it).variants };
        while (vd as usize) != 0 {
            fre_check_disallowed_param_or_stmt_attrs(interner, mut_view(*sink), unsafe { (*vd).attrs });
            let mut vfd: *mut HirFieldDecl = unsafe { (*vd).struct_fields };
            while (vfd as usize) != 0 {
                fre_check_disallowed_param_or_stmt_attrs(interner, mut_view(*sink), unsafe { (*vfd).attrs });
                vfd = unsafe { (*vfd).next };
            }
            vd = unsafe { (*vd).next };
        }
    }

    // 2. @panic_handler validation (AXS-FRE-011)
    if unsafe { (*it).is_panic_handler } {
        if ik != HIR_ITEM_FN || in_impl_or_trait {
            fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_PANIC_HANDLER, unsafe { (*it).span });
        } else {
            if ((*first_panic) as usize) != 0 {
                fre_report_dup_diag(
                    mut_view(*sink),
                    AX_TYPE_DUPLICATE_PANIC_HANDLER,
                    unsafe { (*it).span },
                    unsafe { (**first_panic).span },
                    "first @panic_handler defined here"
                );
            } else {
                *first_panic = it;
            }
            let mut ph_ok = !fre_has_generic_params(it) && !(unsafe { (*it).is_async }) && !(unsafe { (*it).is_comptime });
            if ph_ok {
                let fn_tid = thir_get_item_type(thir, it);
                let fn_t = type_get(view(thir.interner), fn_tid);
                if (fn_t as usize) != 0 && (unsafe { (*fn_t).kind }) == TY_FN {
                    let rt_r = fre_resolve_tid(thir, TypeId { v: unsafe { (*fn_t).ret_type.v } });
                    let rt_t = type_get(view(thir.interner), rt_r);
                    let rk = if (rt_t as usize) != 0 { unsafe { (*rt_t).kind } } else { TY_ERROR };
                    if rk != TY_NEVER && rk != TY_ERROR {
                        ph_ok = false;
                    }
                    let pc = unsafe { (*fn_t).param_count };
                    if pc == 1 {
                        let p0_v = unsafe { (*typeid_at((*fn_t).param_types, 0)).v };
                        let p0_r = fre_resolve_tid(thir, TypeId { v: p0_v });
                        let p0_t = type_get(view(thir.interner), p0_r);
                        if (p0_t as usize) != 0 && (unsafe { (*p0_t).kind }) != TY_ERROR {
                            if (unsafe { (*p0_t).kind }) != TY_VIEW ||
                               !fre_is_struct_named(interner, thir, (TypeId { v: unsafe { (*p0_t).pointee.v } }), "PanicInfo") {
                                ph_ok = false;
                            }
                        }
                    } else if pc > 1 {
                        ph_ok = false;
                    }
                }
            }
            if !ph_ok {
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_PANIC_HANDLER, unsafe { (*it).span });
            }
        }
    }

    // 3. @global_allocator validation (AXS-FRE-012)
    if unsafe { (*it).is_global_allocator } {
        if ik != HIR_ITEM_STATIC || in_impl_or_trait {
            fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_GLOBAL_ALLOCATOR, unsafe { (*it).span });
        } else {
            if ((*first_alloc) as usize) != 0 {
                fre_report_dup_diag(
                    mut_view(*sink),
                    AX_TYPE_DUPLICATE_GLOBAL_ALLOCATOR,
                    unsafe { (*it).span },
                    unsafe { (**first_alloc).span },
                    "first @global_allocator defined here"
                );
            } else {
                *first_alloc = it;
            }
            let st_tid = thir_get_item_type(thir, it);
            if !fre_type_implements_alloc_trait(hir_file, thir, interner, st_tid) {
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_GLOBAL_ALLOCATOR, unsafe { (*it).span });
            }
        }
    }

    // 4. @naked validation (AXS-FRE-013) + parameter/statement attribute scan
    if ik == HIR_ITEM_FN {
        let mut p: *mut HirParam = unsafe { (*it).params };
        while (p as usize) != 0 {
            fre_check_disallowed_param_or_stmt_attrs(interner, mut_view(*sink), unsafe { (*p).attrs });
            p = unsafe { (*p).next };
        }
        let is_intr = tc_item_is_interrupt_abi_ptr(unsafe { address_of(interner.bytes.head) as *const StrInterner }, it);
        let mut naked_decl_ok = false;
        if unsafe { (*it).is_naked } {
            let sig_ok_mods = !(unsafe { (*it).is_async }) &&
                ((unsafe { (*it).is_unsafe }) || (unsafe { (*it).is_entry }) || is_intr);
            let mut sig_ok_types = true;
            let fn_tid = thir_get_item_type(thir, it);
            let fn_t = type_get(view(thir.interner), fn_tid);
            if (fn_t as usize) != 0 && (unsafe { (*fn_t).kind }) == TY_FN {
                let pc = unsafe { (*fn_t).param_count };
                let mut pi: usize = 0;
                while pi < pc {
                    let pt_v = unsafe { (*typeid_at((*fn_t).param_types, pi)).v };
                    if !fre_type_ok_in_naked_sig(hir_file, thir, interner, (TypeId { v: pt_v })) {
                        sig_ok_types = false;
                    }
                    pi = pi + 1;
                }
                if !fre_type_ok_in_naked_sig(hir_file, thir, interner, (TypeId { v: unsafe { (*fn_t).ret_type.v } })) {
                    sig_ok_types = false;
                }
            }
            if !sig_ok_mods || !sig_ok_types {
                fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_NAKED_FN, unsafe { (*it).span });
            } else {
                naked_decl_ok = true;
            }
        }
        let mut rep_naked_let = false;
        fre_scan_block_stmt_attrs_and_naked(
            interner,
            mut_view(*sink),
            unsafe { (*it).body },
            naked_decl_ok,
            mut_view(rep_naked_let)
        );

        // 5. extern "interrupt" signature validation (AXS-FRE-015)
        if is_intr && !(unsafe { (*it).is_async }) {
            let mut intr_ok = !in_impl_or_trait && !fre_has_generic_params(it) && !(unsafe { (*it).is_comptime });
            if intr_ok {
                let fn_tid = thir_get_item_type(thir, it);
                let fn_t = type_get(view(thir.interner), fn_tid);
                if (fn_t as usize) != 0 && (unsafe { (*fn_t).kind }) == TY_FN {
                    let rt_r = fre_resolve_tid(thir, TypeId { v: unsafe { (*fn_t).ret_type.v } });
                    let rt_t = type_get(view(thir.interner), rt_r);
                    let rk = if (rt_t as usize) != 0 { unsafe { (*rt_t).kind } } else { TY_ERROR };
                    if rk != TY_UNIT && rk != TY_NEVER && rk != TY_ERROR {
                        intr_ok = false;
                    }
                    let pc = unsafe { (*fn_t).param_count };
                    if pc == 1 {
                        let p0_v = unsafe { (*typeid_at((*fn_t).param_types, 0)).v };
                        if !fre_is_interrupt_frame_param(interner, thir, (TypeId { v: p0_v })) {
                            intr_ok = false;
                        }
                    } else if pc == 2 {
                        let p0_v = unsafe { (*typeid_at((*fn_t).param_types, 0)).v };
                        let p1_v = unsafe { (*typeid_at((*fn_t).param_types, 1)).v };
                        let p1_r = fre_resolve_tid(thir, TypeId { v: p1_v });
                        let p1_t = type_get(view(thir.interner), p1_r);
                        let p1_k = if (p1_t as usize) != 0 { unsafe { (*p1_t).kind } } else { TY_ERROR };
                        if !fre_is_interrupt_frame_param(interner, thir, (TypeId { v: p0_v })) ||
                           (p1_k != TY_U64 && p1_k != TY_ERROR) {
                            intr_ok = false;
                        }
                    } else if pc > 2 {
                        intr_ok = false;
                    }
                }
            }
            if !intr_ok {
                fre_report_simple_diag(mut_view(*sink), AX_FFI_BAD_TYPE, unsafe { (*it).span });
            }
        }
    } else if unsafe { (*it).is_naked } {
        fre_report_simple_diag(mut_view(*sink), AX_TYPE_INVALID_NAKED_FN, unsafe { (*it).span });
    }
}

fn fre_intrinsic_or_std_fn_caps(interner: view<StrInterner>, it: *const HirItem) -> u32 {
    if (it as usize) == 0 || (unsafe { (*it).kind }) != HIR_ITEM_FN {
        return 0u32;
    }
    let mut caps: u32 = 0u32;
    let mut blk_at: *mut HirAttr = 0 as *mut HirAttr;
    if fre_item_has_attr_name(interner, unsafe { (*it).attrs }, "blocking", mut_view(blk_at)) {
        caps = caps | RT_CAP_BLOCKING;
    }
    if unsafe { (*it).is_async } {
        caps = caps | RT_CAP_ASYNC_SUSPEND;
    }
    let fn_sv = interner_get(interner, StrId { v: unsafe { (*it).name.v } });
    let mut intr_at: *mut HirAttr = 0 as *mut HirAttr;
    let is_intr_attr = fre_item_has_attr_name(interner, unsafe { (*it).attrs }, "intrinsic", mut_view(intr_at));
    let mut lang_at: *mut HirAttr = 0 as *mut HirAttr;
    let is_lang_attr = fre_item_has_attr_name(interner, unsafe { (*it).attrs }, "lang", mut_view(lang_at));
    let is_ext_no_body = (unsafe { (*it).abi.v }) != 0u32 && (unsafe { (*it).body as usize }) == 0;
    let mcount = unsafe { (*it).module_path.count };
    let msegs = unsafe { (*it).module_path.segments };
    let mut is_host_mod = false;
    let mut is_std = false;
    let mut s1_sv = StrView { ptr: 0 as *const u8, len: 0 };
    let mut s2_sv = StrView { ptr: 0 as *const u8, len: 0 };
    if mcount >= 1 && (msegs as usize) != 0 {
        let s0_v = unsafe { (*strid_at_const(msegs as *const StrId, 0)).v };
        let s0_sv = interner_get(interner, StrId { v: s0_v });
        if fre_sv_eq_str(view(s0_sv), "host_intrinsics") {
            is_host_mod = true;
        } else if fre_sv_eq_str(view(s0_sv), "std") {
            is_std = true;
            if mcount >= 2 {
                let s1_v = unsafe { (*strid_at_const(msegs as *const StrId, 1)).v };
                s1_sv = interner_get(interner, StrId { v: s1_v });
            }
            if mcount >= 3 {
                let s2_v = unsafe { (*strid_at_const(msegs as *const StrId, 2)).v };
                s2_sv = interner_get(interner, StrId { v: s2_v });
                if fre_sv_eq_str(view(s1_sv), "core") && fre_sv_eq_str(view(s2_sv), "host") {
                    is_host_mod = true;
                }
            }
        }
    }

    if is_intr_attr || is_lang_attr || is_host_mod || is_ext_no_body {
        if fre_sv_eq_str(view(fn_sv), "heap_alloc") ||
           fre_sv_eq_str(view(fn_sv), "heap_realloc") ||
           fre_sv_eq_str(view(fn_sv), "heap_free") {
            caps = caps | RT_CAP_HEAP_ALLOC;
        } else if fre_sv_eq_str(view(fn_sv), "thread_spawn") ||
                  fre_sv_eq_str(view(fn_sv), "thread_detach") ||
                  fre_sv_eq_str(view(fn_sv), "fiber_create") ||
                  fre_sv_eq_str(view(fn_sv), "fiber_resume") ||
                  fre_sv_eq_str(view(fn_sv), "fiber_yield") ||
                  fre_sv_eq_str(view(fn_sv), "fiber_destroy") {
            caps = caps | RT_CAP_THREAD;
        } else if fre_sv_eq_str(view(fn_sv), "futex_wait") ||
                  fre_sv_eq_str(view(fn_sv), "thread_join") ||
                  fre_sv_eq_str(view(fn_sv), "thread_sleep_ns") {
            caps = caps | RT_CAP_BLOCKING;
        } else if fre_sv_eq_str(view(fn_sv), "aio_create") ||
                  fre_sv_eq_str(view(fn_sv), "aio_destroy") ||
                  fre_sv_eq_str(view(fn_sv), "aio_wake") ||
                  fre_sv_eq_str(view(fn_sv), "aio_wait") ||
                  fre_sv_eq_str(view(fn_sv), "aio_cancel") ||
                  fre_sv_eq_str(view(fn_sv), "aio_file_open") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_read_at") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_write_at") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_flush") ||
                  fre_sv_eq_str(view(fn_sv), "aio_tcp_bind") ||
                  fre_sv_eq_str(view(fn_sv), "aio_socket_local_port") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_sleep") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_accept") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_connect") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_recv") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_send") ||
                  fre_sv_eq_str(view(fn_sv), "aio_tcp_shutdown") ||
                  fre_sv_eq_str(view(fn_sv), "aio_udp_bind") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_recv_from") ||
                  fre_sv_eq_str(view(fn_sv), "aio_submit_send_to") ||
                  fre_sv_eq_str(view(fn_sv), "aio_close") {
            caps = caps | RT_CAP_ASYNC_REACTOR;
        } else if fre_sv_eq_str(view(fn_sv), "stdio") ||
                  fre_sv_eq_str(view(fn_sv), "open") ||
                  fre_sv_eq_str(view(fn_sv), "read") ||
                  fre_sv_eq_str(view(fn_sv), "write") ||
                  fre_sv_eq_str(view(fn_sv), "close") ||
                  fre_sv_eq_str(view(fn_sv), "file_size") ||
                  fre_sv_eq_str(view(fn_sv), "remove") ||
                  fre_sv_eq_str(view(fn_sv), "mkdir") ||
                  fre_sv_eq_str(view(fn_sv), "metadata") ||
                  fre_sv_eq_str(view(fn_sv), "dir_open") ||
                  fre_sv_eq_str(view(fn_sv), "dir_next") ||
                  fre_sv_eq_str(view(fn_sv), "dir_close") {
            caps = caps | RT_CAP_OS_IO;
        } else if fre_sv_eq_str(view(fn_sv), "args_count") ||
                  fre_sv_eq_str(view(fn_sv), "arg") ||
                  fre_sv_eq_str(view(fn_sv), "env_get") ||
                  fre_sv_eq_str(view(fn_sv), "exe_path") ||
                  fre_sv_eq_str(view(fn_sv), "exit") ||
                  fre_sv_eq_str(view(fn_sv), "monotonic_ns") ||
                  fre_sv_eq_str(view(fn_sv), "proc_spawn") ||
                  fre_sv_eq_str(view(fn_sv), "proc_wait") ||
                  fre_sv_eq_str(view(fn_sv), "proc_kill") {
            caps = caps | RT_CAP_OS_ENV_PROCESS;
        } else if fre_sv_eq_str(view(fn_sv), "panic") ||
                  fre_sv_eq_str(view(fn_sv), "assert") ||
                  fre_sv_eq_str(view(fn_sv), "unreachable") {
            caps = caps | RT_CAP_PANIC;
        }
    }

    if is_std && mcount >= 2 {
        if fre_sv_eq_str(view(s1_sv), "io") ||
           fre_sv_eq_str(view(s1_sv), "fs") ||
           fre_sv_eq_str(view(s1_sv), "net") ||
           fre_sv_eq_str(view(s1_sv), "os") ||
           fre_sv_eq_str(view(s1_sv), "sys") {
            caps = caps | RT_CAP_OS_IO;
        } else if fre_sv_eq_str(view(s1_sv), "env") ||
                  fre_sv_eq_str(view(s1_sv), "process") ||
                  fre_sv_eq_str(view(s1_sv), "time") {
            caps = caps | RT_CAP_OS_ENV_PROCESS;
        } else if fre_sv_eq_str(view(s1_sv), "thread") {
            if mcount >= 3 && fre_sv_eq_str(view(s2_sv), "local") {
                caps = caps | RT_CAP_TLS;
            } else if fre_sv_eq_str(view(fn_sv), "sleep") ||
                      fre_sv_eq_str(view(fn_sv), "sleep_ms") ||
                      fre_sv_eq_str(view(fn_sv), "sleep_ns") ||
                      fre_sv_eq_str(view(fn_sv), "join") ||
                      fre_sv_eq_str(view(fn_sv), "yield_now") {
                caps = caps | RT_CAP_BLOCKING;
            } else {
                caps = caps | RT_CAP_THREAD;
            }
        } else if fre_sv_eq_str(view(s1_sv), "async") ||
                  fre_sv_eq_str(view(s1_sv), "asyn") ||
                  fre_sv_eq_str(view(s1_sv), "fiber") {
            caps = caps | RT_CAP_ASYNC_REACTOR;
        } else if fre_sv_eq_str(view(s1_sv), "future") {
            if (mcount >= 3 && fre_sv_eq_str(view(s2_sv), "block_on")) || fre_sv_eq_str(view(fn_sv), "block_on") {
                caps = caps | RT_CAP_ASYNC_REACTOR | RT_CAP_BLOCKING;
            }
        } else if fre_sv_eq_str(view(s1_sv), "gpu") {
            caps = caps | RT_CAP_GPU_RUNTIME;
        } else if fre_sv_eq_str(view(s1_sv), "reflect") {
            caps = caps | RT_CAP_REFLECT;
        }
    }
    caps
}

fn cap_graph_find_node(g: view<CapGraph>, target: *const HirItem) -> isize {
    if (target as usize) == 0 {
        return -1isize;
    }
    let tsym_v = unsafe { (*target).symbol.v };
    let mut i: usize = 0;
    while i < g.count {
        let np = unsafe { cap_node_const_at(g.nodes as *const CapNode, i) };
        let nit = unsafe { (*np).item };
        if (nit as usize) == (target as usize) {
            return i as isize;
        }
        i = i + 1;
    }
    if tsym_v != 0u32 {
        let mut j: usize = 0;
        while j < g.count {
            let np2 = unsafe { cap_node_const_at(g.nodes as *const CapNode, j) };
            let nit2 = unsafe { (*np2).item };
            if (nit2 as usize) != 0 && (unsafe { (*nit2).symbol.v }) == tsym_v {
                return j as isize;
            }
            j = j + 1;
        }
    }
    -1isize
}

fn cap_graph_add_edge(arena: mut_view<Arena>, node: *mut CapNode, callee_idx: u32, sp: Span) {
    let mut cur: *mut CapEdge = unsafe { (*node).edges };
    while (cur as usize) != 0 {
        if (unsafe { (*cur).callee_idx }) == callee_idx {
            return;
        }
        cur = unsafe { (*cur).next };
    }
    let e = arena_alloc_raw(mut_view(*arena), size_of<CapEdge>(), align_of<CapEdge>()) as *mut CapEdge;
    unsafe {
        (*e).callee_idx = callee_idx;
        (*e).call_span = sp;
        (*e).next = (*node).edges;
        (*node).edges = e;
    }
}

fn cap_graph_resolve_call_target(g: view<CapGraph>, expr: *mut HirExpr) -> *const HirItem {
    if (expr as usize) == 0 {
        return 0 as *const HirItem;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_METHOD_CALL {
        let mp = unsafe { thir_get_expr_method(view(*g.thir), expr as *const HirExpr) };
        if (mp as usize) != 0 {
            return unsafe { *mp };
        }
        return 0 as *const HirItem;
    }
    if ek == HIR_EXPR_CALL {
        let mp0 = unsafe { thir_get_expr_method(view(*g.thir), expr as *const HirExpr) };
        if (mp0 as usize) != 0 && (unsafe { *mp0 as usize }) != 0 {
            return unsafe { *mp0 };
        }
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        if (callee as usize) != 0 {
            if (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
                let sym = unsafe { (*callee).path.symbol };
                if sym.v != 0u32 {
                    let hit = unsafe_find_item_by_sym(g.hir, g.thir, sym);
                    if (hit as usize) != 0 && (unsafe { (*hit).kind }) == HIR_ITEM_FN {
                        return hit;
                    }
                }
            }
            let ctid = unsafe { thir_get_expr_type(view(*g.thir), callee as *const HirExpr) };
            let cr = unsafe { fre_resolve_tid(view(*g.thir), ctid) };
            if cr.v != 0u32 {
                let ct = unsafe { type_get(view((*g.thir).interner), cr) };
                if (ct as usize) != 0 && (unsafe { (*ct).kind }) == TY_FN {
                    let def = unsafe { (*ct).def };
                    if (def as usize) != 0 && (unsafe { (*def).kind }) == HIR_ITEM_FN {
                        return def;
                    }
                }
            }
        }
    }
    0 as *const HirItem
}

fn cap_graph_scan_expr(arena: mut_view<Arena>, g: view<CapGraph>, node: *mut CapNode, expr: *mut HirExpr) {
    let mut cur = expr;
    while (cur as usize) != 0 {
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_AWAIT {
            unsafe {
                if ((*node).direct_caps & RT_CAP_ASYNC_SUSPEND) == 0u32 {
                    (*node).direct_span = (*cur).span;
                    (*node).direct_leaf_name = fre_arena_str(mut_view(*arena), ".await");
                }
                (*node).direct_caps = (*node).direct_caps | RT_CAP_ASYNC_SUSPEND;
            }
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CALL || k == HIR_EXPR_METHOD_CALL {
            if k == HIR_EXPR_CALL {
                let callee: *mut HirExpr = unsafe { (*cur).callee };
                if (callee as usize) != 0 {
                    let ctid = unsafe { thir_get_expr_type(view(*g.thir), callee as *const HirExpr) };
                    let cr = unsafe { fre_resolve_tid(view(*g.thir), ctid) };
                    if cr.v != 0u32 {
                        let ct = unsafe { type_get(view((*g.thir).interner), cr) };
                        if (ct as usize) != 0 {
                            let ck = unsafe { (*ct).kind };
                            if ck == TY_BUILTIN_PRINT || ck == TY_BUILTIN_PRINT_INT {
                                unsafe {
                                    if ((*node).direct_caps & RT_CAP_OS_IO) == 0u32 {
                                        (*node).direct_span = (*cur).span;
                                        (*node).direct_leaf_name = fre_arena_str(mut_view(*arena), "print");
                                    }
                                    (*node).direct_caps = (*node).direct_caps | RT_CAP_OS_IO;
                                }
                            }
                        }
                    }
                }
                cap_graph_scan_expr(mut_view(*arena), g, node, callee);
            } else {
                cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).receiver });
            }
            let target = cap_graph_resolve_call_target(g, cur);
            if (target as usize) != 0 {
                let tidx = cap_graph_find_node(g, target);
                if tidx >= 0isize {
                    cap_graph_add_edge(mut_view(*arena), node, tidx as u32, unsafe { (*cur).span });
                } else {
                    let lc = unsafe { fre_intrinsic_or_std_fn_caps(view(*g.interner), target) };
                    if lc != 0u32 {
                        unsafe {
                            if (*node).direct_span.file.v == 0u32 {
                                (*node).direct_span = (*cur).span;
                            }
                            (*node).direct_caps = (*node).direct_caps | lc;
                        }
                    }
                }
            }
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).args });
        } else if k == HIR_EXPR_PATH {
            let sym = unsafe { (*cur).path.symbol };
            if sym.v != 0u32 {
                let hit = unsafe_find_item_by_sym(g.hir, g.thir, sym);
                if (hit as usize) != 0 {
                    let hk = unsafe { (*hit).kind };
                    if hk == HIR_ITEM_STATIC {
                        if unsafe { (*hit).is_tls } {
                            unsafe {
                                if ((*node).direct_caps & RT_CAP_TLS) == 0u32 {
                                    (*node).direct_span = (*cur).span;
                                    let nsv = interner_get(view(*g.interner), StrId { v: (*hit).name.v });
                                    (*node).direct_leaf_name = fre_arena_clone_sv(mut_view(*arena), view(nsv));
                                }
                                (*node).direct_caps = (*node).direct_caps | RT_CAP_TLS;
                            }
                        }
                        if unsafe { (*hit).is_global_allocator } {
                            unsafe {
                                if ((*node).direct_caps & RT_CAP_HEAP_ALLOC) == 0u32 {
                                    (*node).direct_span = (*cur).span;
                                    let nsv2 = interner_get(view(*g.interner), StrId { v: (*hit).name.v });
                                    (*node).direct_leaf_name = fre_arena_clone_sv(mut_view(*arena), view(nsv2));
                                }
                                (*node).direct_caps = (*node).direct_caps | RT_CAP_HEAP_ALLOC;
                            }
                        }
                    } else if hk == HIR_ITEM_FN {
                        let fidx = cap_graph_find_node(g, hit);
                        if fidx >= 0isize {
                            cap_graph_add_edge(mut_view(*arena), node, fidx as u32, unsafe { (*cur).span });
                        }
                    }
                }
            }
        } else if k == HIR_EXPR_BLOCK || k == HIR_EXPR_UNSAFE || k == HIR_EXPR_LOOP || k == HIR_EXPR_COMPTIME {
            cap_graph_scan_block(mut_view(*arena), g, node, unsafe { (*cur).block });
        } else if k == HIR_EXPR_IF {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).cond });
            cap_graph_scan_block(mut_view(*arena), g, node, unsafe { (*cur).block });
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).else_branch });
        } else if k == HIR_EXPR_WHILE {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).cond });
            cap_graph_scan_block(mut_view(*arena), g, node, unsafe { (*cur).block });
        } else if k == HIR_EXPR_FOR {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).iter });
            cap_graph_scan_block(mut_view(*arena), g, node, unsafe { (*cur).block });
        } else if k == HIR_EXPR_MATCH {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).cond });
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while (a as usize) != 0 {
                cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*a).guard });
                cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*a).body });
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_CLOSURE {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).body });
        } else if k == HIR_EXPR_BINARY {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).left });
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).right });
        } else if k == HIR_EXPR_UNARY || k == HIR_EXPR_VIEW || k == HIR_EXPR_JUMP || k == HIR_EXPR_CAST || k == HIR_EXPR_TRY {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).inner });
        } else if k == HIR_EXPR_ARRAY {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).elems });
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).count_expr });
        } else if k == HIR_EXPR_TUPLE {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).elems });
        } else if k == HIR_EXPR_STRUCT {
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*f).expr });
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_RANGE {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).start_expr });
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).end_expr });
        } else if k == HIR_EXPR_FIELD || k == HIR_EXPR_TUPLE_INDEX {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).base });
        } else if k == HIR_EXPR_INDEX {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).base });
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).index_arg });
        }
        cur = unsafe { (*cur).next };
    }
}

fn cap_graph_add_type_drop_edge(arena: mut_view<Arena>, g: view<CapGraph>, node: *mut CapNode, tid: TypeId, sp: Span) {
    let r = unsafe { fre_resolve_tid(view(*g.thir), tid) };
    if r.v == 0u32 {
        return;
    }
    let t = unsafe { type_get(view((*g.thir).interner), r) };
    if (t as usize) == 0 {
        return;
    }
    let k = unsafe { (*t).kind };
    if k == TY_STRUCT || k == TY_ENUM {
        let drop_fn = unsafe { fre_find_drop_fn_for_def(view(*g.hir), view(*g.interner), (*t).def) };
        if (drop_fn as usize) != 0 {
            let didx = cap_graph_find_node(g, drop_fn);
            if didx >= 0isize {
                cap_graph_add_edge(arena, node, didx as u32, sp);
            }
        }
    }
}

fn cap_graph_scan_block(arena: mut_view<Arena>, g: view<CapGraph>, node: *mut CapNode, blk: *mut HirBlock) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while (s as usize) != 0 {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let pat: *mut HirPat = unsafe { (*s).pat };
            if (pat as usize) != 0 {
                let ptid = unsafe { thir_get_pat_type(view(*g.thir), pat as *const HirPat) };
                cap_graph_add_type_drop_edge(mut_view(*arena), g, node, ptid, unsafe { (*s).span });
            }
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*s).expr });
            cap_graph_scan_block(mut_view(*arena), g, node, unsafe { (*s).else_block });
        } else if sk == HIR_STMT_ASSIGN {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*s).left });
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*s).right });
        } else if sk == HIR_STMT_EXPR {
            cap_graph_scan_expr(mut_view(*arena), g, node, unsafe { (*s).expr });
        }
        s = unsafe { (*s).next };
    }
}

fn cap_graph_build_and_solve(
    arena: mut_view<Arena>,
    hir_file: view<HirFile>,
    thir: view<Thir>,
    interner: view<StrInterner>
) -> CapGraph {
    let hir_ptr = unsafe { address_of(hir_file.items) as *const HirFile };
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };

    let mut count: usize = 0;
    let mut it0: *mut HirItem = hir_file.items;
    while (it0 as usize) != 0 {
        let ik0 = unsafe { (*it0).kind };
        if ik0 == HIR_ITEM_FN {
            count = count + 1;
        } else if ik0 == HIR_ITEM_IMPL || ik0 == HIR_ITEM_TRAIT || ik0 == HIR_ITEM_EXTERN_BLOCK {
            let mut m0: *mut HirItem = unsafe { (*it0).members };
            while (m0 as usize) != 0 {
                if (unsafe { (*m0).kind }) == HIR_ITEM_FN {
                    count = count + 1;
                }
                m0 = unsafe { (*m0).next };
            }
        }
        it0 = unsafe { (*it0).next };
    }

    if count == 0 {
        return CapGraph {
            nodes: 0 as *mut CapNode,
            count: 0,
            hir: hir_ptr,
            thir: thir_ptr,
            interner: int_ptr,
        };
    }

    let raw_bytes = mul_usize(count, size_of<CapNode>());
    let nodes_raw = arena_alloc_raw(mut_view(*arena), raw_bytes, align_of<CapNode>());
    tc_zero_bytes(nodes_raw, raw_bytes);
    let nodes = nodes_raw as *mut CapNode;

    let mut idx: usize = 0;
    let mut it1: *mut HirItem = hir_file.items;
    while (it1 as usize) != 0 {
        let ik1 = unsafe { (*it1).kind };
        if ik1 == HIR_ITEM_FN {
            let np = unsafe { cap_node_at(nodes, idx) };
            unsafe {
                (*np).item = it1 as *const HirItem;
                (*np).is_std = tc_item_is_std_module(interner, it1 as *const HirItem);
                (*np).direct_caps = fre_intrinsic_or_std_fn_caps(interner, it1 as *const HirItem);
                (*np).direct_span = (*it1).span;
            }
            idx = idx + 1;
        } else if ik1 == HIR_ITEM_IMPL || ik1 == HIR_ITEM_TRAIT || ik1 == HIR_ITEM_EXTERN_BLOCK {
            let p_std = tc_item_is_std_module(interner, it1 as *const HirItem);
            let mut m1: *mut HirItem = unsafe { (*it1).members };
            while (m1 as usize) != 0 {
                if (unsafe { (*m1).kind }) == HIR_ITEM_FN {
                    let np2 = unsafe { cap_node_at(nodes, idx) };
                    unsafe {
                        (*np2).item = m1 as *const HirItem;
                        (*np2).is_std = p_std || tc_item_is_std_module(interner, m1 as *const HirItem);
                        (*np2).direct_caps = fre_intrinsic_or_std_fn_caps(interner, m1 as *const HirItem);
                        (*np2).direct_span = (*m1).span;
                    }
                    idx = idx + 1;
                }
                m1 = unsafe { (*m1).next };
            }
        }
        it1 = unsafe { (*it1).next };
    }

    let g = CapGraph {
        nodes: nodes,
        count: idx,
        hir: hir_ptr,
        thir: thir_ptr,
        interner: int_ptr,
    };

    let mut u: usize = 0;
    while u < g.count {
        let np = unsafe { cap_node_at(g.nodes, u) };
        let uit = unsafe { (*np).item };
        let mut p: *mut HirParam = unsafe { (*uit).params };
        while (p as usize) != 0 {
            let ptid = thir_get_param_type(thir, p as *const HirParam);
            cap_graph_add_type_drop_edge(mut_view(*arena), view(g), np, ptid, unsafe { (*p).span });
            p = unsafe { (*p).next };
        }
        let body_blk: *mut HirBlock = unsafe { (*uit).body };
        if (body_blk as usize) != 0 {
            cap_graph_scan_block(mut_view(*arena), view(g), np, body_blk);
        }
        unsafe {
            (*np).trans_caps = (*np).direct_caps;
        }
        u = u + 1;
    }

    let mut changed = true;
    let mut iter_guard: usize = 0;
    let max_iters: usize = (g.count + 2) * 14;
    while changed && iter_guard < max_iters {
        changed = false;
        iter_guard = iter_guard + 1;
        let mut i: usize = 0;
        while i < g.count {
            let unode = unsafe { cap_node_at(g.nodes, i) };
            let mut e: *mut CapEdge = unsafe { (*unode).edges };
            while (e as usize) != 0 {
                let v_idx = (unsafe { (*e).callee_idx }) as usize;
                if v_idx < g.count {
                    let vnode = unsafe { cap_node_const_at(g.nodes as *const CapNode, v_idx) };
                    let v_caps = unsafe { (*vnode).trans_caps };
                    let u_caps = unsafe { (*unode).trans_caps };
                    let missing = v_caps & (u_caps ^ 0xFFFFFFFFu32);
                    if missing != 0u32 {
                        unsafe { (*unode).trans_caps = u_caps | missing; }
                        let mut b: usize = 0;
                        while b < 13 {
                            if (missing & (1u32 << (b as u32))) != 0u32 {
                                unsafe { (*unode).next_hop[b] = (v_idx as u32) + 1u32; }
                            }
                            b = b + 1;
                        }
                        changed = true;
                    }
                }
                e = unsafe { (*e).next };
            }
            i = i + 1;
        }
    }

    g
}

fn cap_graph_format_chain_note(
    arena: mut_view<Arena>,
    g: view<CapGraph>,
    root_it: *const HirItem,
    first_callee_idx: isize,
    leaf_sv: view<StrView>,
    bit: usize,
    out_sec_sp: mut_view<Span>
) -> StrView {
    let mut b = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let pfx = fre_arena_str(mut_view(*arena), "call chain: ");
    diag_buf_push_bytes(mut_view(b), pfx.ptr, pfx.len);
    let arrow = fre_arena_str(mut_view(*arena), " -> ");

    let r_sv = unsafe { interner_get(view(*g.interner), StrId { v: (*root_it).name.v }) };
    diag_buf_push_bytes(mut_view(b), r_sv.ptr, r_sv.len);

    if first_callee_idx < 0isize {
        if leaf_sv.len > 0 && (leaf_sv.ptr as usize) != 0 {
            diag_buf_push_bytes(mut_view(b), arrow.ptr, arrow.len);
            diag_buf_push_bytes(mut_view(b), leaf_sv.ptr, leaf_sv.len);
        }
    } else {
        let mut cur = first_callee_idx as usize;
        let mut hops: usize = 0;
        while cur < g.count && hops < 16 {
            let np = unsafe { cap_node_const_at(g.nodes as *const CapNode, cur) };
            let cit = unsafe { (*np).item };
            let c_sv = unsafe { interner_get(view(*g.interner), StrId { v: (*cit).name.v }) };
            if c_sv.len > 0 {
                diag_buf_push_bytes(mut_view(b), arrow.ptr, arrow.len);
                diag_buf_push_bytes(mut_view(b), c_sv.ptr, c_sv.len);
            }
            if !(unsafe { (*np).is_std }) && (unsafe { (*np).direct_span.file.v }) != 0u32 {
                *out_sec_sp = unsafe { (*np).direct_span };
            }
            let nh = if bit < 13 { unsafe { (*np).next_hop[bit] } } else { 0u32 };
            if nh == 0u32 {
                let dl = unsafe { (*np).direct_leaf_name };
                if dl.len > 0 && (dl.ptr as usize) != 0 {
                    diag_buf_push_bytes(mut_view(b), arrow.ptr, arrow.len);
                    diag_buf_push_bytes(mut_view(b), dl.ptr, dl.len);
                }
                break;
            }
            cur = (nh - 1u32) as usize;
            hops = hops + 1;
        }
    }

    let tmp_sv = StrView { ptr: b.ptr as *const u8, len: b.len };
    let out = fre_arena_clone_sv(mut_view(*arena), view(tmp_sv));
    if b.cap > 0 && (b.ptr as usize) != 0 {
        unsafe { heap_free(b.ptr, b.cap, 1); }
    }
    out
}

fn cap_graph_check_root_expr(
    sink: mut_view<DiagSink>,
    g: view<CapGraph>,
    root_it: *const HirItem,
    expr: *mut HirExpr,
    forbidden_mask: u32,
    is_interrupt_check: bool,
    profile: u32
) {
    let mut cur = expr;
    while (cur as usize) != 0 {
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_AWAIT {
            if (forbidden_mask & RT_CAP_ASYNC_SUSPEND) != 0u32 {
                let cap_sv = fre_cap_bit_name(mut_view(sink.arena), 12);
                let leaf_sv = fre_arena_str(mut_view(sink.arena), ".await");
                let mut sec_sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                let note_sv = cap_graph_format_chain_note(mut_view(sink.arena), g, root_it, -1isize, view(leaf_sv), 12, mut_view(sec_sp));
                if is_interrupt_check {
                    fre_report_cap_diag(
                        mut_view(*sink),
                        AX_UNSAFE_INTERRUPT_FORBIDDEN_OP,
                        unsafe { (*cur).span },
                        sec_sp,
                        false,
                        note_sv,
                        "capability",
                        cap_sv,
                        "callee",
                        leaf_sv
                    );
                }
            }
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).inner }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_CALL || k == HIR_EXPR_METHOD_CALL {
            if k == HIR_EXPR_CALL {
                let callee: *mut HirExpr = unsafe { (*cur).callee };
                if (callee as usize) != 0 && (forbidden_mask & RT_CAP_OS_IO) != 0u32 {
                    let ctid = unsafe { thir_get_expr_type(view(*g.thir), callee as *const HirExpr) };
                    let cr = unsafe { fre_resolve_tid(view(*g.thir), ctid) };
                    if cr.v != 0u32 {
                        let ct = unsafe { type_get(view((*g.thir).interner), cr) };
                        if (ct as usize) != 0 {
                            let ck = unsafe { (*ct).kind };
                            if ck == TY_BUILTIN_PRINT || ck == TY_BUILTIN_PRINT_INT {
                                let cap_sv = fre_cap_bit_name(mut_view(sink.arena), 8);
                                let leaf_sv = fre_arena_str(mut_view(sink.arena), "print");
                                let mut sec_sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                                let note_sv = cap_graph_format_chain_note(mut_view(sink.arena), g, root_it, -1isize, view(leaf_sv), 8, mut_view(sec_sp));
                                if is_interrupt_check {
                                    fre_report_cap_diag(
                                        mut_view(*sink),
                                        AX_UNSAFE_INTERRUPT_FORBIDDEN_OP,
                                        unsafe { (*cur).span },
                                        sec_sp,
                                        false,
                                        note_sv,
                                        "capability",
                                        cap_sv,
                                        "callee",
                                        leaf_sv
                                    );
                                } else {
                                    let prof_sv = fre_profile_name(mut_view(sink.arena), profile);
                                    fre_report_cap_diag(
                                        mut_view(*sink),
                                        AX_DRIVER_PROFILE_FORBIDDEN_CAP,
                                        unsafe { (*cur).span },
                                        sec_sp,
                                        false,
                                        note_sv,
                                        "profile",
                                        prof_sv,
                                        "capability",
                                        cap_sv
                                    );
                                }
                            }
                        }
                    }
                }
                cap_graph_check_root_expr(mut_view(*sink), g, root_it, callee, forbidden_mask, is_interrupt_check, profile);
            } else {
                cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).receiver }, forbidden_mask, is_interrupt_check, profile);
            }

            let target = cap_graph_resolve_call_target(g, cur);
            if (target as usize) != 0 {
                let tidx = cap_graph_find_node(g, target);
                let mut tcaps: u32 = 0u32;
                if tidx >= 0isize {
                    let np = unsafe { cap_node_const_at(g.nodes as *const CapNode, tidx as usize) };
                    tcaps = unsafe { (*np).trans_caps };
                } else {
                    tcaps = unsafe { fre_intrinsic_or_std_fn_caps(view(*g.interner), target) };
                }
                let bad = tcaps & forbidden_mask;
                if bad != 0u32 {
                    let bit = fre_pick_forbidden_bit(bad);
                    let cap_sv = fre_cap_bit_name(mut_view(sink.arena), bit);
                    let raw_c = unsafe { interner_get(view(*g.interner), StrId { v: (*target).name.v }) };
                    let callee_sv = fre_arena_clone_sv(mut_view(sink.arena), view(raw_c));
                    let mut sec_sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                    let note_sv = cap_graph_format_chain_note(mut_view(sink.arena), g, root_it, tidx, view(callee_sv), bit, mut_view(sec_sp));
                    if is_interrupt_check {
                        fre_report_cap_diag(
                            mut_view(*sink),
                            AX_UNSAFE_INTERRUPT_FORBIDDEN_OP,
                            unsafe { (*cur).span },
                            sec_sp,
                            true,
                            note_sv,
                            "capability",
                            cap_sv,
                            "callee",
                            callee_sv
                        );
                    } else {
                        let prof_sv = fre_profile_name(mut_view(sink.arena), profile);
                        fre_report_cap_diag(
                            mut_view(*sink),
                            AX_DRIVER_PROFILE_FORBIDDEN_CAP,
                            unsafe { (*cur).span },
                            sec_sp,
                            true,
                            note_sv,
                            "profile",
                            prof_sv,
                            "capability",
                            cap_sv
                        );
                    }
                }
            }
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).args }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_PATH {
            let sym = unsafe { (*cur).path.symbol };
            if sym.v != 0u32 {
                let hit = unsafe_find_item_by_sym(g.hir, g.thir, sym);
                if (hit as usize) != 0 && (unsafe { (*hit).kind }) == HIR_ITEM_STATIC {
                    let mut st_cap: u32 = 0u32;
                    if (unsafe { (*hit).is_tls }) && (forbidden_mask & RT_CAP_TLS) != 0u32 {
                        st_cap = RT_CAP_TLS;
                    } else if (unsafe { (*hit).is_global_allocator }) && (forbidden_mask & RT_CAP_HEAP_ALLOC) != 0u32 {
                        st_cap = RT_CAP_HEAP_ALLOC;
                    }
                    if st_cap != 0u32 {
                        let bit = fre_pick_forbidden_bit(st_cap);
                        let cap_sv = fre_cap_bit_name(mut_view(sink.arena), bit);
                        let raw_s = unsafe { interner_get(view(*g.interner), StrId { v: (*hit).name.v }) };
                        let st_sv = fre_arena_clone_sv(mut_view(sink.arena), view(raw_s));
                        let mut sec_sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                        let note_sv = cap_graph_format_chain_note(mut_view(sink.arena), g, root_it, -1isize, view(st_sv), bit, mut_view(sec_sp));
                        if is_interrupt_check {
                            fre_report_cap_diag(
                                mut_view(*sink),
                                AX_UNSAFE_INTERRUPT_FORBIDDEN_OP,
                                unsafe { (*cur).span },
                                sec_sp,
                                false,
                                note_sv,
                                "capability",
                                cap_sv,
                                "callee",
                                st_sv
                            );
                        } else {
                            let prof_sv = fre_profile_name(mut_view(sink.arena), profile);
                            fre_report_cap_diag(
                                mut_view(*sink),
                                AX_DRIVER_PROFILE_FORBIDDEN_CAP,
                                unsafe { (*cur).span },
                                sec_sp,
                                false,
                                note_sv,
                                "profile",
                                prof_sv,
                                "capability",
                                cap_sv
                            );
                        }
                    }
                }
            }
        } else if k == HIR_EXPR_BLOCK || k == HIR_EXPR_UNSAFE || k == HIR_EXPR_LOOP || k == HIR_EXPR_COMPTIME {
            cap_graph_check_root_block(mut_view(*sink), g, root_it, unsafe { (*cur).block }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_IF {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).cond }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_block(mut_view(*sink), g, root_it, unsafe { (*cur).block }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).else_branch }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_WHILE {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).cond }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_block(mut_view(*sink), g, root_it, unsafe { (*cur).block }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_FOR {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).iter }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_block(mut_view(*sink), g, root_it, unsafe { (*cur).block }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_MATCH {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).cond }, forbidden_mask, is_interrupt_check, profile);
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while (a as usize) != 0 {
                cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*a).guard }, forbidden_mask, is_interrupt_check, profile);
                cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*a).body }, forbidden_mask, is_interrupt_check, profile);
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_CLOSURE {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).body }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_BINARY {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).left }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).right }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_UNARY || k == HIR_EXPR_VIEW || k == HIR_EXPR_JUMP || k == HIR_EXPR_CAST || k == HIR_EXPR_TRY {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).inner }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_ARRAY {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).elems }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).count_expr }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_TUPLE {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).elems }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_STRUCT {
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*f).expr }, forbidden_mask, is_interrupt_check, profile);
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_RANGE {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).start_expr }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).end_expr }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_FIELD || k == HIR_EXPR_TUPLE_INDEX {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).base }, forbidden_mask, is_interrupt_check, profile);
        } else if k == HIR_EXPR_INDEX {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).base }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*cur).index_arg }, forbidden_mask, is_interrupt_check, profile);
        }
        cur = unsafe { (*cur).next };
    }
}

fn cap_graph_check_root_block(
    sink: mut_view<DiagSink>,
    g: view<CapGraph>,
    root_it: *const HirItem,
    blk: *mut HirBlock,
    forbidden_mask: u32,
    is_interrupt_check: bool,
    profile: u32
) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while (s as usize) != 0 {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let errs_before = sink.errors;
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*s).expr }, forbidden_mask, is_interrupt_check, profile);
            // If initializer didn't already report a capability error, check implicit Drop glue on the bound local!
            if sink.errors == errs_before {
                let pat: *mut HirPat = unsafe { (*s).pat };
                if (pat as usize) != 0 {
                    let ptid = unsafe { thir_get_pat_type(view(*g.thir), pat as *const HirPat) };
                    let pr = unsafe { fre_resolve_tid(view(*g.thir), ptid) };
                    if pr.v != 0u32 {
                        let pt = unsafe { type_get(view((*g.thir).interner), pr) };
                        if (pt as usize) != 0 {
                            let pk = unsafe { (*pt).kind };
                            if pk == TY_STRUCT || pk == TY_ENUM {
                                let drop_fn = unsafe { fre_find_drop_fn_for_def(view(*g.hir), view(*g.interner), (*pt).def) };
                                if (drop_fn as usize) != 0 {
                                    let didx = cap_graph_find_node(g, drop_fn);
                                    if didx >= 0isize {
                                        let dnp = unsafe { cap_node_const_at(g.nodes as *const CapNode, didx as usize) };
                                        let bad_d = (unsafe { (*dnp).trans_caps }) & forbidden_mask;
                                        if bad_d != 0u32 {
                                            let bit = fre_pick_forbidden_bit(bad_d);
                                            let cap_sv = fre_cap_bit_name(mut_view(sink.arena), bit);
                                            let drop_sv = fre_arena_str(mut_view(sink.arena), "Drop.drop");
                                            let mut sec_sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                                            let note_sv = cap_graph_format_chain_note(mut_view(sink.arena), g, root_it, didx, view(drop_sv), bit, mut_view(sec_sp));
                                            if is_interrupt_check {
                                                fre_report_cap_diag(
                                                    mut_view(*sink),
                                                    AX_UNSAFE_INTERRUPT_FORBIDDEN_OP,
                                                    unsafe { (*s).span },
                                                    sec_sp,
                                                    true,
                                                    note_sv,
                                                    "capability",
                                                    cap_sv,
                                                    "callee",
                                                    drop_sv
                                                );
                                            } else {
                                                let prof_sv = fre_profile_name(mut_view(sink.arena), profile);
                                                fre_report_cap_diag(
                                                    mut_view(*sink),
                                                    AX_DRIVER_PROFILE_FORBIDDEN_CAP,
                                                    unsafe { (*s).span },
                                                    sec_sp,
                                                    true,
                                                    note_sv,
                                                    "profile",
                                                    prof_sv,
                                                    "capability",
                                                    cap_sv
                                                );
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            cap_graph_check_root_block(mut_view(*sink), g, root_it, unsafe { (*s).else_block }, forbidden_mask, is_interrupt_check, profile);
        } else if sk == HIR_STMT_ASSIGN {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*s).left }, forbidden_mask, is_interrupt_check, profile);
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*s).right }, forbidden_mask, is_interrupt_check, profile);
        } else if sk == HIR_STMT_EXPR {
            cap_graph_check_root_expr(mut_view(*sink), g, root_it, unsafe { (*s).expr }, forbidden_mask, is_interrupt_check, profile);
        }
        s = unsafe { (*s).next };
    }
}

fn check_freestanding_attrs_and_interrupts(cx: mut_view<TypeckCtx>) {
    if (cx.hir as usize) == 0 || (cx.thir as usize) == 0 || (cx.sink as usize) == 0 || (cx.str_in as usize) == 0 {
        return;
    }
    let hir_file = unsafe { view(*cx.hir) };
    let thir = unsafe { view(*cx.thir) };
    let interner = unsafe { view(*cx.str_in) };

    let mut first_panic: *const HirItem = 0 as *const HirItem;
    let mut first_alloc: *const HirItem = 0 as *const HirItem;
    let mut has_interrupt_fn: bool = false;

    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        if !tc_item_is_std_module(interner, it as *const HirItem) &&
           !fre_is_synth_fn_clone(hir_file, cx.thir as *const Thir, it as *const HirItem, true) {
            if tc_item_is_interrupt_abi_ptr(cx.str_in, it as *const HirItem) {
                has_interrupt_fn = true;
            }
            unsafe {
                fre_check_item_attrs_universal(
                    hir_file,
                    thir,
                    interner,
                    mut_view(*cx.sink),
                    it as *const HirItem,
                    false,
                    mut_view(first_panic),
                    mut_view(first_alloc)
                );
            }
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
                let in_imp = ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT;
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if !fre_is_synth_fn_clone(hir_file, cx.thir as *const Thir, m as *const HirItem, false) {
                        if tc_item_is_interrupt_abi_ptr(cx.str_in, m as *const HirItem) {
                            has_interrupt_fn = true;
                        }
                        unsafe {
                            fre_check_item_attrs_universal(
                                hir_file,
                                thir,
                                interner,
                                mut_view(*cx.sink),
                                m as *const HirItem,
                                in_imp,
                                mut_view(first_panic),
                                mut_view(first_alloc)
                            );
                        }
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }

    if has_interrupt_fn {
        let g = unsafe { cap_graph_build_and_solve(mut_view((*cx.sink).arena), hir_file, thir, interner) };
        let mut it2: *mut HirItem = hir_file.items;
        while (it2 as usize) != 0 {
            if !tc_item_is_std_module(interner, it2 as *const HirItem) &&
               !fre_is_synth_fn_clone(hir_file, cx.thir as *const Thir, it2 as *const HirItem, true) &&
               (unsafe { (*it2).kind }) == HIR_ITEM_FN &&
               tc_item_is_interrupt_abi_ptr(cx.str_in, it2 as *const HirItem) &&
               !(unsafe { (*it2).is_async }) {
                unsafe {
                    cap_graph_check_root_block(
                        mut_view(*cx.sink),
                        view(g),
                        it2 as *const HirItem,
                        (*it2).body,
                        RT_INTERRUPT_FORBIDDEN_MASK,
                        true,
                        TY_PROFILE_HOSTED
                    );
                }
            }
            it2 = unsafe { (*it2).next };
        }
    }
}

pub fn fre_is_forbidden_std_layer3_seg(sv: view<StrView>) -> bool {
    fre_sv_eq_str(sv, "os") ||
    fre_sv_eq_str(sv, "sys") ||
    fre_sv_eq_str(sv, "io") ||
    fre_sv_eq_str(sv, "fs") ||
    fre_sv_eq_str(sv, "net") ||
    fre_sv_eq_str(sv, "process") ||
    fre_sv_eq_str(sv, "thread") ||
    fre_sv_eq_str(sv, "env") ||
    fre_sv_eq_str(sv, "time") ||
    fre_sv_eq_str(sv, "async") ||
    fre_sv_eq_str(sv, "asyn") ||
    fre_sv_eq_str(sv, "fiber")
}

fn fre_check_hir_use_tree_imports(
    interner: view<StrInterner>,
    sink: mut_view<DiagSink>,
    tree: *mut HirUseTree,
    has_std_prefix: bool,
    profile: u32
) {
    let mut cur = tree;
    while (cur as usize) != 0 {
        let p_cnt = unsafe { (*cur).path.count };
        let p_segs = unsafe { (*cur).path.segments };
        let mut now_std = has_std_prefix;
        let mut bad_seg_sv = StrView { ptr: 0 as *const u8, len: 0 };
        if !has_std_prefix {
            if p_cnt >= 1 && (p_segs as usize) != 0 {
                let s0 = interner_get(interner, StrId { v: unsafe { (*strid_at_const(p_segs as *const StrId, 0)).v } });
                if fre_sv_eq_str(view(s0), "std") {
                    now_std = true;
                    if p_cnt >= 2 {
                        let s1 = interner_get(interner, StrId { v: unsafe { (*strid_at_const(p_segs as *const StrId, 1)).v } });
                        if fre_is_forbidden_std_layer3_seg(view(s1)) {
                            bad_seg_sv = s1;
                        }
                    }
                }
            }
        } else if p_cnt >= 1 && (p_segs as usize) != 0 {
            let s0b = interner_get(interner, StrId { v: unsafe { (*strid_at_const(p_segs as *const StrId, 0)).v } });
            if fre_is_forbidden_std_layer3_seg(view(s0b)) {
                bad_seg_sv = s0b;
            }
        }

        if bad_seg_sv.len > 0 {
            let mut mbuf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            let std_dot = fre_arena_str(mut_view(sink.arena), "std.");
            diag_buf_push_bytes(mut_view(mbuf), std_dot.ptr, std_dot.len);
            diag_buf_push_bytes(mut_view(mbuf), bad_seg_sv.ptr, bad_seg_sv.len);
            let mbuf_sv = StrView { ptr: mbuf.ptr as *const u8, len: mbuf.len };
            let mod_sv = fre_arena_clone_sv(mut_view(sink.arena), view(mbuf_sv));
            if mbuf.cap > 0 && (mbuf.ptr as usize) != 0 {
                unsafe { heap_free(mbuf.ptr, mbuf.cap, 1); }
            }
            let prof_sv = fre_profile_name(mut_view(sink.arena), profile);
            let empty_sv = StrView { ptr: 0 as *const u8, len: 0 };
            let no_sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
            fre_report_cap_diag(
                mut_view(*sink),
                AX_NAME_FREESTANDING_FORBIDDEN_IMPORT,
                unsafe { (*cur).span },
                no_sp,
                false,
                empty_sv,
                "module",
                mod_sv,
                "profile",
                prof_sv
            );
        } else {
            let sub: *mut HirUseTree = unsafe { (*cur).subtrees };
            if (sub as usize) != 0 {
                fre_check_hir_use_tree_imports(interner, mut_view(*sink), sub, now_std, profile);
            }
        }
        cur = unsafe { (*cur).next };
    }
}

fn fre_check_entry_item(
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    it: *const HirItem,
    in_impl_or_trait: bool,
    is_dll: bool,
    first_entry: mut_view<*const HirItem>,
    entry_count: mut_view<usize>
) {
    if !(unsafe { (*it).is_entry }) {
        return;
    }
    *entry_count = *entry_count + 1;
    if (unsafe { (*it).kind }) != HIR_ITEM_FN || in_impl_or_trait {
        fre_report_simple_diag(mut_view(*sink), AX_TYPE_ENTRY_SIGNATURE, unsafe { (*it).span });
        return;
    }
    if ((*first_entry) as usize) != 0 {
        fre_report_dup_diag(
            mut_view(*sink),
            AX_TYPE_DUPLICATE_ENTRY,
            unsafe { (*it).span },
            unsafe { (**first_entry).span },
            "first @entry defined here"
        );
    } else {
        *first_entry = it;
    }
    if fre_has_generic_params(it) || (unsafe { (*it).is_async }) || (unsafe { (*it).is_comptime }) {
        fre_report_simple_diag(mut_view(*sink), AX_TYPE_ENTRY_SIGNATURE, unsafe { (*it).span });
        return;
    }
    if is_dll {
        return;
    }
    let fn_tid = thir_get_item_type(thir, it);
    let fn_t = type_get(view(thir.interner), fn_tid);
    if (fn_t as usize) == 0 || (unsafe { (*fn_t).kind }) != TY_FN {
        return;
    }
    let pc = unsafe { (*fn_t).param_count };
    let rt_r = fre_resolve_tid(thir, TypeId { v: unsafe { (*fn_t).ret_type.v } });
    let rt_t = type_get(view(thir.interner), rt_r);
    let rk = if (rt_t as usize) != 0 { unsafe { (*rt_t).kind } } else { TY_ERROR };
    let mut ok = false;
    if pc == 0 {
        ok = rk == TY_NEVER || rk == TY_I32 || rk == TY_U32 || rk == TY_USIZE || rk == TY_ERROR;
    } else if pc == 1 {
        let p0_v = unsafe { (*typeid_at((*fn_t).param_types, 0)).v };
        let p0_r = fre_resolve_tid(thir, TypeId { v: p0_v });
        let p0_t = type_get(view(thir.interner), p0_r);
        let p0_k = if (p0_t as usize) != 0 { unsafe { (*p0_t).kind } } else { TY_ERROR };
        ok = (p0_k == TY_USIZE || p0_k == TY_ERROR) && (rk == TY_NEVER || rk == TY_ERROR);
    } else if pc == 2 {
        let p0_v = unsafe { (*typeid_at((*fn_t).param_types, 0)).v };
        let p1_v = unsafe { (*typeid_at((*fn_t).param_types, 1)).v };
        ok = fre_is_const_u8_ptr(thir, TypeId { v: p0_v }) &&
             fre_is_const_u8_ptr(thir, TypeId { v: p1_v }) &&
             (rk == TY_USIZE || rk == TY_ERROR);
    }
    if !ok {
        fre_report_simple_diag(mut_view(*sink), AX_TYPE_ENTRY_SIGNATURE, unsafe { (*it).span });
    }
}

pub fn typeck_check_profile(
    hir_file: view<HirFile>,
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    interner: view<StrInterner>,
    profile: u32,
    require_entry: bool,
    is_dll: bool,
    main_fid_v: u32
) {
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };
    let is_free_or_kern = profile == TY_PROFILE_FREESTANDING || profile == TY_PROFILE_KERNEL;

    let mut first_entry: *const HirItem = 0 as *const HirItem;
    let mut entry_count: usize = 0;
    let mut has_valid_global_alloc: bool = false;
    let mut fallback_sp = Span { file: FileId { v: main_fid_v }, start: 0u32, end: 0u32 };
    let mut found_fallback_sp: bool = false;

    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        let is_std = tc_item_is_std_module(interner, it as *const HirItem);
        if !is_std && !fre_is_synth_fn_clone(hir_file, thir_ptr, it as *const HirItem, true) {
            let ik = unsafe { (*it).kind };
            if !found_fallback_sp && ik != HIR_ITEM_MODULE && ik != HIR_ITEM_USE &&
               (main_fid_v == 0u32 || (unsafe { (*it).span.file.v }) == main_fid_v) {
                fallback_sp = unsafe { (*it).span };
                found_fallback_sp = true;
            }
            if is_free_or_kern && ik == HIR_ITEM_USE {
                fre_check_hir_use_tree_imports(interner, mut_view(*sink), unsafe { (*it).use_tree }, false, profile);
            }
            if ik == HIR_ITEM_STATIC && (unsafe { (*it).is_global_allocator }) {
                let st_tid = thir_get_item_type(thir, it as *const HirItem);
                if fre_type_implements_alloc_trait(hir_file, thir, interner, st_tid) {
                    has_valid_global_alloc = true;
                }
            }
            if is_free_or_kern && ik == HIR_ITEM_STATIC && (unsafe { (*it).is_tls }) {
                let mut st_exp_at: *mut HirAttr = 0 as *mut HirAttr;
                let has_st_export = fre_item_has_attr_name(interner, unsafe { (*it).attrs }, "export", mut_view(st_exp_at));
                if (unsafe { (*it).is_used }) || has_st_export {
                    let prof_sv = fre_profile_name(mut_view(sink.arena), profile);
                    let cap_sv = fre_cap_bit_name(mut_view(sink.arena), 4);
                    let empty_sv = StrView { ptr: 0 as *const u8, len: 0 };
                    let no_sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                    fre_report_cap_diag(
                        mut_view(*sink),
                        AX_DRIVER_PROFILE_FORBIDDEN_CAP,
                        unsafe { (*it).span },
                        no_sp,
                        false,
                        empty_sv,
                        "profile",
                        prof_sv,
                        "capability",
                        cap_sv
                    );
                }
            }
            fre_check_entry_item(
                thir,
                mut_view(*sink),
                it as *const HirItem,
                false,
                is_dll,
                mut_view(first_entry),
                mut_view(entry_count)
            );
            if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if !fre_is_synth_fn_clone(hir_file, thir_ptr, m as *const HirItem, false) {
                        fre_check_entry_item(
                            thir,
                            mut_view(*sink),
                            m as *const HirItem,
                            true,
                            is_dll,
                            mut_view(first_entry),
                            mut_view(entry_count)
                        );
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }

    if is_free_or_kern && require_entry && entry_count == 0 {
        fre_report_simple_diag(mut_view(*sink), AX_TYPE_ENTRY_MISSING, fallback_sp);
    }

    if is_free_or_kern {
        let mut forbidden_mask: u32 =
            RT_CAP_UNWIND | RT_CAP_TLS | RT_CAP_THREAD | RT_CAP_BLOCKING |
            RT_CAP_ASYNC_REACTOR | RT_CAP_OS_IO | RT_CAP_OS_ENV_PROCESS | RT_CAP_GPU_RUNTIME;
        if !has_valid_global_alloc {
            forbidden_mask = forbidden_mask | RT_CAP_HEAP_ALLOC;
        }

        let g = cap_graph_build_and_solve(mut_view(sink.arena), hir_file, thir, interner);
        let mut rit: *mut HirItem = hir_file.items;
        while (rit as usize) != 0 {
            if !tc_item_is_std_module(interner, rit as *const HirItem) &&
               !fre_is_synth_fn_clone(hir_file, thir_ptr, rit as *const HirItem, true) &&
               (unsafe { (*rit).kind }) == HIR_ITEM_FN {
                let mut exp_at: *mut HirAttr = 0 as *mut HirAttr;
                let has_export = fre_item_has_attr_name(interner, unsafe { (*rit).attrs }, "export", mut_view(exp_at));
                let is_intr = tc_item_is_interrupt_abi_ptr(int_ptr, rit as *const HirItem);
                // Note: interrupt roots already check RT_INTERRUPT_FORBIDDEN_MASK via AX_UNSAFE_INTERRUPT_FORBIDDEN_OP.
                let is_root = !is_intr &&
                    ((unsafe { (*rit).is_entry }) || (unsafe { (*rit).is_used }) || has_export || (unsafe { (*rit).is_panic_handler }));
                if is_root {
                    cap_graph_check_root_block(
                        mut_view(*sink),
                        view(g),
                        rit as *const HirItem,
                        unsafe { (*rit).body },
                        forbidden_mask,
                        false,
                        profile
                    );
                }
            }
            rit = unsafe { (*rit).next };
        }
    }
}

// =============================================================================
// E13.4 (T517, SPEC-53): Safety Profiles, `@forbid_unsafe`, Ambient-Authority
// Ban (`sandbox` / `comptime`), and Capability Forgery Rejection (`REQ-CAP-123`)
// =============================================================================

pub const TY_SAFETY_PROFILE_SYSTEM: u32 = 0u32;
pub const TY_SAFETY_PROFILE_SAFE: u32 = 1u32;
pub const TY_SAFETY_PROFILE_SANDBOX: u32 = 2u32;

const SEC_AUTH_FS: u32 = 1u32;
const SEC_AUTH_NET: u32 = 2u32;
const SEC_AUTH_ENV: u32 = 4u32;
const SEC_AUTH_PROCESS: u32 = 8u32;
const SEC_AUTH_CLOCK: u32 = 16u32;

fn sec_is_authority_cap_struct_name(sv: view<StrView>) -> u32 {
    if fre_sv_eq_str(sv, "FsCap") { return SEC_AUTH_FS; }
    if fre_sv_eq_str(sv, "NetCap") { return SEC_AUTH_NET; }
    if fre_sv_eq_str(sv, "EnvCap") { return SEC_AUTH_ENV; }
    if fre_sv_eq_str(sv, "ProcessCap") { return SEC_AUTH_PROCESS; }
    if fre_sv_eq_str(sv, "ClockCap") { return SEC_AUTH_CLOCK; }
    if fre_sv_eq_str(sv, "SandboxCaps") || fre_sv_eq_str(sv, "RootCaps") {
        return SEC_AUTH_FS | SEC_AUTH_NET | SEC_AUTH_ENV | SEC_AUTH_PROCESS | SEC_AUTH_CLOCK;
    }
    0u32
}

fn sec_is_raw_addr_struct_name(sv: view<StrView>) -> bool {
    fre_sv_eq_str(sv, "PhysAddr") || fre_sv_eq_str(sv, "VirtAddr") || fre_sv_eq_str(sv, "WasmAddr")
}

fn tc_try_report_capability_forgery(
    cx: mut_view<TypeckCtx>,
    src_raw: TypeId,
    dest_raw: TypeId,
    sp: view<Span>,
    is_explicit_cast: bool
) -> bool {
    if (cx.thir as usize) == 0 || (cx.sink as usize) == 0 {
        return false;
    }
    let src_ty = resolve_ty(mut_view(*cx), (TypeId { v: src_raw.v }));
    let dest_ty = resolve_ty(mut_view(*cx), (TypeId { v: dest_raw.v }));
    if src_ty.v == 0u32 || dest_ty.v == 0u32 ||
       is_error(mut_view(*cx), (TypeId { v: src_ty.v })) ||
       is_error(mut_view(*cx), (TypeId { v: dest_ty.v })) {
        return false;
    }
    let st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: src_ty.v })) };
    let dt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: dest_ty.v })) };
    if (st as usize) == 0 || (dt as usize) == 0 {
        return false;
    }
    let sk = unsafe { (*st).kind };
    let dk = unsafe { (*dt).kind };

    let mut src_kind_code: u8 = 0u8; // 1 = raw_ptr, 2 = integer_addr
    if sk == TY_PTR {
        src_kind_code = 1u8;
    } else if sk == TY_USIZE || sk == TY_ISIZE {
        src_kind_code = 2u8;
    } else if is_explicit_cast && is_intlike(mut_view(*cx), (TypeId { v: src_ty.v })) {
        src_kind_code = 2u8;
    } else if sk == TY_STRUCT && (cx.str_in as usize) != 0 {
        let sdef: *const HirItem = unsafe { (*st).def };
        if (sdef as usize) != 0 {
            let sname = unsafe { interner_get(view(*cx.str_in), StrId { v: (*sdef).name.v }) };
            if sec_is_raw_addr_struct_name(view(sname)) {
                src_kind_code = 2u8;
            }
        }
    }
    if src_kind_code == 0u8 {
        return false;
    }

    let mut dst_kind_code: u8 = 0u8; // 1 = view, 2 = mut_view, 3 = str, 4 = authority_cap
    if dk == TY_VIEW {
        dst_kind_code = 1u8;
    } else if dk == TY_MUT_VIEW {
        dst_kind_code = 2u8;
    } else if dk == TY_STR {
        if is_explicit_cast || src_kind_code == 1u8 {
            dst_kind_code = 3u8;
        }
    } else if dk == TY_STRUCT && (cx.str_in as usize) != 0 {
        let ddef: *const HirItem = unsafe { (*dt).def };
        if (ddef as usize) != 0 {
            let dname = unsafe { interner_get(view(*cx.str_in), StrId { v: (*ddef).name.v }) };
            if sec_is_authority_cap_struct_name(view(dname)) != 0u32 {
                dst_kind_code = 4u8;
            }
        }
    }
    if dst_kind_code == 0u8 {
        return false;
    }

    let sink = cx.sink;
    let code = DiagCode { v: AX_SEC_CAPABILITY_FORGERY };
    let msg_sv = unsafe { tc_alloc_code_default_msg(mut_view((*sink).arena), code) };
    let src_sv = if src_kind_code == 1u8 {
        unsafe { fre_arena_str(mut_view((*sink).arena), "raw_ptr") }
    } else {
        unsafe { fre_arena_str(mut_view((*sink).arena), "integer_addr") }
    };
    let dst_sv = if dst_kind_code == 1u8 {
        unsafe { fre_arena_str(mut_view((*sink).arena), "view") }
    } else if dst_kind_code == 2u8 {
        unsafe { fre_arena_str(mut_view((*sink).arena), "mut_view") }
    } else if dst_kind_code == 3u8 {
        unsafe { fre_arena_str(mut_view((*sink).arena), "str") }
    } else {
        unsafe { fre_arena_str(mut_view((*sink).arena), "authority_cap") }
    };
    let data_arr = unsafe {
        arena_alloc_raw(mut_view((*sink).arena), mul_usize(2, size_of<DiagDataEntry>()), align_of<DiagDataEntry>()) as *mut DiagDataEntry
    };
    let e0 = unsafe { fre_make_str_data_entry(mut_view((*sink).arena), "source", src_sv) };
    let e1 = unsafe { fre_make_str_data_entry(mut_view((*sink).arena), "target", dst_sv) };
    let e1_ptr = ((data_arr as usize) + size_of<DiagDataEntry>()) as *mut DiagDataEntry;
    unsafe {
        *data_arr = e0;
        *e1_ptr = e1;
    }
    let d = Diagnostic {
        code: code,
        severity: diag_code_severity(code),
        message: msg_sv,
        primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: data_arr,
        data_count: 2,
    };
    unsafe { diag_sink_report(mut_view(*sink), view(d)); }
    true
}

fn sec_type_direct_authority_cap_mask(interner: view<StrInterner>, thir: view<Thir>, tid: TypeId) -> u32 {
    if tid.v == 0u32 {
        return 0u32;
    }
    let mut cur_id = TypeId { v: tid.v };
    let mut depth: usize = 0;
    while cur_id.v != 0u32 && depth < 6 {
        let t = type_get(view(thir.interner), cur_id);
        if (t as usize) == 0 {
            return 0u32;
        }
        let tk = unsafe { (*t).kind };
        if tk == TY_VIEW || tk == TY_MUT_VIEW {
            cur_id.v = unsafe { (*t).pointee.v };
            depth = depth + 1;
        } else if tk == TY_STRUCT {
            let def: *const HirItem = unsafe { (*t).def };
            if (def as usize) != 0 {
                let sv = interner_get(interner, StrId { v: unsafe { (*def).name.v } });
                return sec_is_authority_cap_struct_name(view(sv));
            }
            return 0u32;
        } else {
            return 0u32;
        }
    }
    0u32
}

fn sec_type_contains_authority_cap_mask(interner: view<StrInterner>, thir: view<Thir>, tid: TypeId, depth: usize) -> u32 {
    let tv = tid.v;
    if tv == 0u32 || depth > 8 {
        return 0u32;
    }
    let direct = sec_type_direct_authority_cap_mask(interner, thir, TypeId { v: tv });
    if direct != 0u32 {
        return direct;
    }
    let t = type_get(view(thir.interner), TypeId { v: tv });
    if (t as usize) == 0 {
        return 0u32;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_VIEW || tk == TY_MUT_VIEW {
        return sec_type_contains_authority_cap_mask(interner, thir, TypeId { v: unsafe { (*t).pointee.v } }, depth + 1);
    }
    if tk == TY_ARRAY || tk == TY_SLICE {
        return sec_type_contains_authority_cap_mask(interner, thir, TypeId { v: unsafe { (*t).elem.v } }, depth + 1);
    }
    if tk == TY_TUPLE || tk == TY_STRUCT {
        let fcnt = unsafe { (*t).field_count };
        let flds = unsafe { (*t).fields };
        if (flds as usize) == 0 {
            return 0u32;
        }
        let mut i: usize = 0;
        while i < fcnt {
            let fv = unsafe { (*typeid_at(flds, i)).v };
            let m = sec_type_contains_authority_cap_mask(interner, thir, TypeId { v: fv }, depth + 1);
            if m != 0u32 {
                return m;
            }
            i = i + 1;
        }
        return 0u32;
    }
    if tk == TY_ENUM {
        let vcnt = unsafe { (*t).variant_count };
        let vf_arr = unsafe { (*t).variant_fields };
        let vfc_arr = unsafe { (*t).variant_field_counts };
        if (vf_arr as usize) == 0 || (vfc_arr as usize) == 0 {
            return 0u32;
        }
        let mut v: usize = 0;
        while v < vcnt {
            let fc = unsafe { *usize_at(vfc_arr, v) };
            let vf = unsafe { *typeid_ptr_at(vf_arr, v) };
            let mut f: usize = 0;
            while f < fc && (vf as usize) != 0 {
                let fv = unsafe { (*typeid_at(vf, f)).v };
                let m = sec_type_contains_authority_cap_mask(interner, thir, TypeId { v: fv }, depth + 1);
                if m != 0u32 {
                    return m;
                }
                f = f + 1;
            }
            v = v + 1;
        }
    }
    0u32
}

struct SecForbidMod {
    mod_path: AstDottedName,
    file_v: u32,
    attr_span: Span,
}

unsafe fn sec_forbid_mod_at(base: *mut SecForbidMod, idx: usize) -> *mut SecForbidMod {
    ((base as usize) + mul_usize(idx, size_of<SecForbidMod>())) as *mut SecForbidMod
}

unsafe fn sec_forbid_mod_const_at(base: *const SecForbidMod, idx: usize) -> *const SecForbidMod {
    ((base as usize) + mul_usize(idx, size_of<SecForbidMod>())) as *const SecForbidMod
}

unsafe fn sec_u32_const_at(base: *const u32, idx: usize) -> *const u32 {
    ((base as usize) + mul_usize(idx, size_of<u32>())) as *const u32
}

fn sec_is_user_item(
    interner: view<StrInterner>,
    it: *const HirItem,
    user_fids: *const u32,
    user_fid_count: usize
) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    let fv = unsafe { (*it).span.file.v };
    if user_fid_count > 0 && (user_fids as usize) != 0 && fv != 0u32 {
        let mut i: usize = 0;
        while i < user_fid_count {
            if (unsafe { *sec_u32_const_at(user_fids, i) }) == fv {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    !tc_item_is_std_module(interner, it)
}

fn sec_dotted_is_prefix(interner: view<StrInterner>, prefix: view<AstDottedName>, full: view<AstDottedName>) -> bool {
    if prefix.count == 0 || prefix.count > full.count {
        return false;
    }
    if (prefix.segments as usize) == 0 || (full.segments as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < prefix.count {
        let p_id = unsafe { (*strid_at_const(prefix.segments as *const StrId, i)).v };
        let f_id = unsafe { (*strid_at_const(full.segments as *const StrId, i)).v };
        if p_id != f_id {
            let p_sv = interner_get(interner, StrId { v: p_id });
            let f_sv = interner_get(interner, StrId { v: f_id });
            if !sv_eq(view(p_sv), view(f_sv)) {
                return false;
            }
        }
        i = i + 1;
    }
    true
}

fn sec_is_item_mod_forbidden(
    interner: view<StrInterner>,
    it: *const HirItem,
    forbid_mods: *const SecForbidMod,
    forbid_mod_count: usize,
    safety_profile: u32,
    pkg_forbid_unsafe: bool
) -> bool {
    if safety_profile != TY_SAFETY_PROFILE_SYSTEM || pkg_forbid_unsafe {
        return true;
    }
    if (it as usize) == 0 || forbid_mod_count == 0 || (forbid_mods as usize) == 0 {
        return false;
    }
    let fv = unsafe { (*it).span.file.v };
    let ik = unsafe { (*it).kind };
    let mut i: usize = 0;
    while i < forbid_mod_count {
        let fm = unsafe { sec_forbid_mod_const_at(forbid_mods, i) };
        let fm_cnt = unsafe { (*fm).mod_path.count };
        if fm_cnt > 0 {
            let matched = if ik == HIR_ITEM_MODULE && (unsafe { (*it).mod_path.count }) > 0 {
                unsafe { sec_dotted_is_prefix(interner, view((*fm).mod_path), view((*it).mod_path)) }
            } else {
                unsafe { sec_dotted_is_prefix(interner, view((*fm).mod_path), view((*it).module_path)) }
            };
            if matched {
                return true;
            }
        } else if fv != 0u32 && (unsafe { (*fm).file_v }) == fv {
            return true;
        }
        i = i + 1;
    }
    false
}

fn sec_mk_span(fv: u32, s: u32, e: u32) -> Span {
    Span { file: FileId { v: fv }, start: s, end: e }
}

fn sec_report_1data_diag(sink: mut_view<DiagSink>, code_v: u32, sp: Span, k0: str, v0_lit: str) {
    let code = DiagCode { v: code_v };
    let msg_sv = tc_alloc_code_default_msg(mut_view(sink.arena), code);
    let v0_sv = fre_arena_str(mut_view(sink.arena), v0_lit);
    let data_arr = arena_alloc_raw(mut_view(sink.arena), size_of<DiagDataEntry>(), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
    let e0 = fre_make_str_data_entry(mut_view(sink.arena), k0, v0_sv);
    unsafe { *data_arr = e0; }
    let d = Diagnostic {
        code: code,
        severity: diag_code_severity(code),
        message: msg_sv,
        primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: data_arr,
        data_count: 1,
    };
    diag_sink_report(sink, view(d));
}

fn sec_report_ambient_diag(
    sink: mut_view<DiagSink>,
    sp: Span,
    op_sv_raw: view<StrView>,
    req_cap_lit: str,
    profile_lit: str,
    reason_lit: str,
    has_reason: bool,
    chain_note: view<StrView>
) {
    let code = DiagCode { v: AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN };
    let msg_sv = tc_alloc_code_default_msg(mut_view(sink.arena), code);
    let op_sv = if op_sv_raw.len > 0 && (op_sv_raw.ptr as usize) != 0 {
        fre_arena_clone_sv(mut_view(sink.arena), op_sv_raw)
    } else {
        fre_arena_str(mut_view(sink.arena), "ambient_os")
    };
    let cap_sv = fre_arena_str(mut_view(sink.arena), req_cap_lit);
    let prof_sv = fre_arena_str(mut_view(sink.arena), profile_lit);
    let dcount: usize = if has_reason { 4 } else { 3 };
    let data_arr = arena_alloc_raw(mut_view(sink.arena), mul_usize(dcount, size_of<DiagDataEntry>()), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
    let e0 = fre_make_str_data_entry(mut_view(sink.arena), "operation", op_sv);
    let e1 = fre_make_str_data_entry(mut_view(sink.arena), "required_cap", cap_sv);
    let e2 = fre_make_str_data_entry(mut_view(sink.arena), "profile", prof_sv);
    let p1 = ((data_arr as usize) + size_of<DiagDataEntry>()) as *mut DiagDataEntry;
    let p2 = ((data_arr as usize) + mul_usize(2, size_of<DiagDataEntry>())) as *mut DiagDataEntry;
    unsafe {
        *data_arr = e0;
        *p1 = e1;
        *p2 = e2;
    }
    if has_reason {
        let r_sv = fre_arena_str(mut_view(sink.arena), reason_lit);
        let e3 = fre_make_str_data_entry(mut_view(sink.arena), "reason", r_sv);
        let p3 = ((data_arr as usize) + mul_usize(3, size_of<DiagDataEntry>())) as *mut DiagDataEntry;
        unsafe { *p3 = e3; }
    }
    let mut notes_ptr: *mut StrView = 0 as *mut StrView;
    let mut note_cnt: usize = 0;
    if chain_note.len > 0 && (chain_note.ptr as usize) != 0 {
        let narr = arena_alloc_raw(mut_view(sink.arena), size_of<StrView>(), align_of<StrView>()) as *mut StrView;
        unsafe { *narr = StrView { ptr: chain_note.ptr, len: chain_note.len }; }
        notes_ptr = narr;
        note_cnt = 1;
    }
    let d = Diagnostic {
        code: code,
        severity: diag_code_severity(code),
        message: msg_sv,
        primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: notes_ptr,
        note_count: note_cnt,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: data_arr,
        data_count: dcount,
    };
    diag_sink_report(sink, view(d));
}

fn sec_scan_policy_attrs(
    interner: view<StrInterner>,
    sink: mut_view<DiagSink>,
    attrs: *mut HirAttr,
    allow_on_this_node: bool,
    out_has_forbid: mut_view<bool>,
    out_forbid_sp: mut_view<Span>,
    out_has_allow: mut_view<bool>,
    out_allow_sp: mut_view<Span>
) {
    *out_has_forbid = false;
    *out_has_allow = false;
    let mut cur: *mut HirAttr = attrs;
    while (cur as usize) != 0 {
        let sv = interner_get(interner, StrId { v: unsafe { (*cur).name.v } });
        let is_forbid = fre_sv_eq_str(view(sv), "forbid_unsafe");
        let is_allow = !is_forbid && fre_sv_eq_str(view(sv), "allow_unsafe");
        if is_forbid || is_allow {
            let csp = unsafe { (*cur).span };
            if !allow_on_this_node || (unsafe { (*cur).args as usize }) != 0 {
                sec_report_1data_diag(mut_view(*sink), AX_SEC_CONFLICTING_SAFETY_POLICY, csp, "policy", "invalid_safety_attr");
            } else if is_forbid {
                *out_has_forbid = true;
                *out_forbid_sp = csp;
            } else {
                *out_has_allow = true;
                *out_allow_sp = csp;
            }
        }
        cur = unsafe { (*cur).next };
    }
}

fn sec_find_fixed_addr_attr(interner: view<StrInterner>, attrs: *mut HirAttr, out_sp: mut_view<Span>) -> bool {
    let mut cur: *mut HirAttr = attrs;
    while (cur as usize) != 0 {
        let sv = interner_get(interner, StrId { v: unsafe { (*cur).name.v } });
        if fre_sv_eq_str(view(sv), "at") || fre_sv_eq_str(view(sv), "addr") {
            *out_sp = unsafe { (*cur).span };
            return true;
        }
        cur = unsafe { (*cur).next };
    }
    false
}

fn sec_check_item_header_forbid_unsafe(
    interner: view<StrInterner>,
    sink: mut_view<DiagSink>,
    it: *const HirItem
) {
    if (it as usize) == 0 {
        return;
    }
    let ik = unsafe { (*it).kind };
    let attrs: *mut HirAttr = unsafe { (*it).attrs };
    let it_f = unsafe { (*it).span.file.v };
    let it_s = unsafe { (*it).span.start };
    let it_e = unsafe { (*it).span.end };

    let mut addr_sp = sec_mk_span(it_f, it_s, it_e);
    if sec_find_fixed_addr_attr(interner, attrs, mut_view(addr_sp)) {
        sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, addr_sp, "construct", "fixed_addr");
        return;
    }
    if ik == HIR_ITEM_STRUCT {
        let mut fd: *mut HirFieldDecl = unsafe { (*it).struct_fields };
        while (fd as usize) != 0 {
            if sec_find_fixed_addr_attr(interner, unsafe { (*fd).attrs }, mut_view(addr_sp)) {
                sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, addr_sp, "construct", "fixed_addr");
                return;
            }
            fd = unsafe { (*fd).next };
        }
    }

    let mut naked_at: *mut HirAttr = 0 as *mut HirAttr;
    if (unsafe { (*it).is_naked }) || fre_item_has_attr_name(interner, attrs, "naked", mut_view(naked_at)) {
        let nsp = if (naked_at as usize) != 0 { unsafe { (*naked_at).span } } else { sec_mk_span(it_f, it_s, it_e) };
        sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, nsp, "construct", "naked_fn");
        return;
    }

    if ik == HIR_ITEM_EXTERN_BLOCK {
        sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(it_f, it_s, it_e), "construct", "extern_block");
        return;
    }

    let abi_v = unsafe { (*it).abi.v };
    let mut is_foreign_abi = false;
    if abi_v != 0u32 {
        let abi_sv = interner_get(interner, StrId { v: abi_v });
        if !fre_sv_eq_str(view(abi_sv), "axiom") {
            is_foreign_abi = true;
        }
    }
    let mut exp_at: *mut HirAttr = 0 as *mut HirAttr;
    let mut nm_at: *mut HirAttr = 0 as *mut HirAttr;
    let has_exp = fre_item_has_attr_name(interner, attrs, "export", mut_view(exp_at));
    let has_nm = (unsafe { (*it).is_no_mangle }) || fre_item_has_attr_name(interner, attrs, "no_mangle", mut_view(nm_at));
    if is_foreign_abi || has_exp || has_nm {
        sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(it_f, it_s, it_e), "construct", "extern_block");
        return;
    }

    if ik == HIR_ITEM_FN && (unsafe { (*it).is_unsafe }) {
        sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(it_f, it_s, it_e), "construct", "unsafe_fn");
        return;
    }
    if ik == HIR_ITEM_TRAIT && (unsafe { (*it).is_unsafe }) {
        sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(it_f, it_s, it_e), "construct", "unsafe_trait");
        return;
    }
    if ik == HIR_ITEM_IMPL && (unsafe { (*it).is_unsafe }) {
        sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(it_f, it_s, it_e), "construct", "unsafe_impl");
        return;
    }
    if ik == HIR_ITEM_STATIC && (unsafe { (*it).is_mut }) {
        sec_report_1data_diag(sink, AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(it_f, it_s, it_e), "construct", "static_mut");
        return;
    }
}

fn sec_is_raw_ptr_intrinsic_name(sv: view<StrView>) -> bool {
    fre_sv_eq_str(sv, "address_of") ||
    fre_sv_eq_str(sv, "address_of_mut") ||
    fre_sv_eq_str(sv, "ptr_add") ||
    fre_sv_eq_str(sv, "ptr_sub") ||
    fre_sv_eq_str(sv, "ptr_read") ||
    fre_sv_eq_str(sv, "ptr_write") ||
    fre_sv_eq_str(sv, "ptr_copy") ||
    fre_sv_eq_str(sv, "ptr_copy_nonoverlapping") ||
    fre_sv_eq_str(sv, "ptr_write_bytes") ||
    fre_sv_eq_str(sv, "drop_in_place") ||
    fre_sv_eq_str(sv, "volatile_load") ||
    fre_sv_eq_str(sv, "volatile_store")
}

fn sec_find_mut_static_by_path(hir_file: view<HirFile>, sym_v: u32, name_v: u32) -> *const HirItem {
    if sym_v == 0u32 && name_v == 0u32 {
        return 0 as *const HirItem;
    }
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_STATIC && (unsafe { (*it).is_mut }) && !(unsafe { (*it).is_tls }) {
            let isym = unsafe { (*it).symbol.v };
            let iname = unsafe { (*it).name.v };
            if (sym_v != 0u32 && isym == sym_v) || (sym_v == 0u32 && name_v != 0u32 && iname == name_v) {
                return it as *const HirItem;
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *const HirItem
}

struct SecOsNode {
    item: *const HirItem,
    is_std: bool,
    has_cap_param: bool,
    raw_os_mask: u32,
    ambient_os_mask: u32,
    next_hop_plus1: u32,
    edges: *mut CapEdge,
}

struct SecOsGraph {
    nodes: *mut SecOsNode,
    count: usize,
    hir: *const HirFile,
    thir: *const Thir,
    interner: *const StrInterner,
}

unsafe fn sec_os_node_at(base: *mut SecOsNode, idx: usize) -> *mut SecOsNode {
    ((base as usize) + mul_usize(idx, size_of<SecOsNode>())) as *mut SecOsNode
}

unsafe fn sec_os_node_const_at(base: *const SecOsNode, idx: usize) -> *const SecOsNode {
    ((base as usize) + mul_usize(idx, size_of<SecOsNode>())) as *const SecOsNode
}

fn sec_fn_has_authority_cap_param(interner: view<StrInterner>, thir: view<Thir>, it: *const HirItem) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    let mut p: *mut HirParam = unsafe { (*it).params };
    while (p as usize) != 0 {
        let mut ptid = thir_get_param_type(thir, p as *const HirParam);
        if ptid.v == 0u32 && (unsafe { (*p).symbol.v }) != 0u32 {
            ptid = thir_get_symbol_type(thir, SymbolId { v: unsafe { (*p).symbol.v } });
        }
        if sec_type_direct_authority_cap_mask(interner, thir, ptid) != 0u32 {
            return true;
        }
        p = unsafe { (*p).next };
    }
    let fn_tid = thir_get_item_type(thir, it);
    let fn_t = type_get(view(thir.interner), fn_tid);
    if (fn_t as usize) != 0 && (unsafe { (*fn_t).kind }) == TY_FN {
        let pc = unsafe { (*fn_t).param_count };
        let ptypes = unsafe { (*fn_t).param_types };
        let mut i: usize = 0;
        while i < pc && (ptypes as usize) != 0 {
            let pv = unsafe { (*typeid_at(ptypes, i)).v };
            if sec_type_direct_authority_cap_mask(interner, thir, (TypeId { v: pv })) != 0u32 {
                return true;
            }
            i = i + 1;
        }
    }
    false
}

fn sec_fn_direct_os_mask(interner: view<StrInterner>, it: *const HirItem, has_cap_param: bool) -> u32 {
    if (it as usize) == 0 || (unsafe { (*it).kind }) != HIR_ITEM_FN {
        return 0u32;
    }
    let fn_sv = interner_get(interner, StrId { v: unsafe { (*it).name.v } });
    let mut intr_at: *mut HirAttr = 0 as *mut HirAttr;
    let is_intr = fre_item_has_attr_name(interner, unsafe { (*it).attrs }, "intrinsic", mut_view(intr_at));
    let is_ext_no_body = (unsafe { (*it).abi.v }) != 0u32 && (unsafe { (*it).body as usize }) == 0;

    let mcount = unsafe { (*it).module_path.count };
    let msegs = unsafe { (*it).module_path.segments };
    let mut is_host_mod = false;
    let mut is_std = false;
    let mut s1_sv = StrView { ptr: 0 as *const u8, len: 0 };
    if mcount >= 1 && (msegs as usize) != 0 {
        let s0_sv = interner_get(interner, StrId { v: unsafe { (*strid_at_const(msegs as *const StrId, 0)).v } });
        if fre_sv_eq_str(view(s0_sv), "host_intrinsics") {
            is_host_mod = true;
        } else if fre_sv_eq_str(view(s0_sv), "std") {
            is_std = true;
            if mcount >= 2 {
                s1_sv = interner_get(interner, StrId { v: unsafe { (*strid_at_const(msegs as *const StrId, 1)).v } });
                if mcount >= 3 {
                    let s2_sv = interner_get(interner, StrId { v: unsafe { (*strid_at_const(msegs as *const StrId, 2)).v } });
                    if fre_sv_eq_str(view(s1_sv), "core") && fre_sv_eq_str(view(s2_sv), "host") {
                        is_host_mod = true;
                    }
                }
            }
        }
    }

    // Root ambient authority constructors (in std.security, std.os, or test modules)
    if !has_cap_param {
        if fre_sv_eq_str(view(fn_sv), "root_fs_cap") { return SEC_AUTH_FS; }
        if fre_sv_eq_str(view(fn_sv), "root_net_cap") { return SEC_AUTH_NET; }
        if fre_sv_eq_str(view(fn_sv), "root_env_cap") { return SEC_AUTH_ENV; }
        if fre_sv_eq_str(view(fn_sv), "root_process_cap") { return SEC_AUTH_PROCESS; }
        if fre_sv_eq_str(view(fn_sv), "root_clock_cap") { return SEC_AUTH_CLOCK; }
        if fre_sv_eq_str(view(fn_sv), "ambient_caps") {
            return SEC_AUTH_FS | SEC_AUTH_NET | SEC_AUTH_ENV | SEC_AUTH_PROCESS | SEC_AUTH_CLOCK;
        }
    }

    if is_intr || is_host_mod || is_ext_no_body {
        if fre_sv_eq_str(view(fn_sv), "stdio") ||
           fre_sv_eq_str(view(fn_sv), "open") ||
           fre_sv_eq_str(view(fn_sv), "read") ||
           fre_sv_eq_str(view(fn_sv), "write") ||
           fre_sv_eq_str(view(fn_sv), "close") ||
           fre_sv_eq_str(view(fn_sv), "file_size") ||
           fre_sv_eq_str(view(fn_sv), "remove") ||
           fre_sv_eq_str(view(fn_sv), "mkdir") ||
           fre_sv_eq_str(view(fn_sv), "metadata") ||
           fre_sv_eq_str(view(fn_sv), "dir_open") ||
           fre_sv_eq_str(view(fn_sv), "dir_next") ||
           fre_sv_eq_str(view(fn_sv), "dir_close") {
            return SEC_AUTH_FS;
        }
        if fre_sv_eq_str(view(fn_sv), "aio_submit_accept") ||
           fre_sv_eq_str(view(fn_sv), "aio_submit_connect") ||
           fre_sv_eq_str(view(fn_sv), "aio_submit_recv") ||
           fre_sv_eq_str(view(fn_sv), "aio_submit_send") {
            return SEC_AUTH_NET;
        }
        if fre_sv_eq_str(view(fn_sv), "env_get") ||
           fre_sv_eq_str(view(fn_sv), "args_count") ||
           fre_sv_eq_str(view(fn_sv), "arg") {
            return SEC_AUTH_ENV;
        }
        if fre_sv_eq_str(view(fn_sv), "exit") ||
           fre_sv_eq_str(view(fn_sv), "exe_path") ||
           fre_sv_eq_str(view(fn_sv), "proc_spawn") ||
           fre_sv_eq_str(view(fn_sv), "proc_wait") ||
           fre_sv_eq_str(view(fn_sv), "proc_kill") {
            return SEC_AUTH_PROCESS;
        }
        if fre_sv_eq_str(view(fn_sv), "monotonic_ns") {
            return SEC_AUTH_CLOCK;
        }
    }

    if is_std && mcount >= 2 && !has_cap_param {
        if fre_sv_eq_str(view(s1_sv), "net") {
            if fre_sv_eq_str(view(fn_sv), "connect") ||
               fre_sv_eq_str(view(fn_sv), "bind") ||
               fre_sv_eq_str(view(fn_sv), "accept") ||
               fre_sv_eq_str(view(fn_sv), "send") ||
               fre_sv_eq_str(view(fn_sv), "recv") ||
               fre_sv_eq_str(view(fn_sv), "send_to") ||
               fre_sv_eq_str(view(fn_sv), "recv_from") ||
               fre_sv_eq_str(view(fn_sv), "lookup_host") {
                return SEC_AUTH_NET;
            }
        } else if fre_sv_eq_str(view(s1_sv), "io") {
            if fre_sv_eq_str(view(fn_sv), "open") ||
               fre_sv_eq_str(view(fn_sv), "create") ||
               fre_sv_eq_str(view(fn_sv), "append") ||
               fre_sv_eq_str(view(fn_sv), "file_open") ||
               fre_sv_eq_str(view(fn_sv), "file_create") ||
               fre_sv_eq_str(view(fn_sv), "file_append") ||
               fre_sv_eq_str(view(fn_sv), "file_read") ||
               fre_sv_eq_str(view(fn_sv), "file_write") ||
               fre_sv_eq_str(view(fn_sv), "file_size_of") ||
               fre_sv_eq_str(view(fn_sv), "file_close") ||
               fre_sv_eq_str(view(fn_sv), "read_to_string") ||
               fre_sv_eq_str(view(fn_sv), "write_string") ||
               fre_sv_eq_str(view(fn_sv), "write_file") ||
               fre_sv_eq_str(view(fn_sv), "print") ||
               fre_sv_eq_str(view(fn_sv), "println") ||
               fre_sv_eq_str(view(fn_sv), "eprint") ||
               fre_sv_eq_str(view(fn_sv), "eprintln") {
                return SEC_AUTH_FS;
            }
        } else if fre_sv_eq_str(view(s1_sv), "fs") {
            if fre_sv_eq_str(view(fn_sv), "open") ||
               fre_sv_eq_str(view(fn_sv), "create") ||
               fre_sv_eq_str(view(fn_sv), "read") ||
               fre_sv_eq_str(view(fn_sv), "read_to_string") ||
               fre_sv_eq_str(view(fn_sv), "write") ||
               fre_sv_eq_str(view(fn_sv), "remove_file") ||
               fre_sv_eq_str(view(fn_sv), "remove_dir") ||
               fre_sv_eq_str(view(fn_sv), "remove_dir_all") ||
               fre_sv_eq_str(view(fn_sv), "create_dir") ||
               fre_sv_eq_str(view(fn_sv), "create_dir_all") ||
               fre_sv_eq_str(view(fn_sv), "metadata") ||
               fre_sv_eq_str(view(fn_sv), "exists") ||
               fre_sv_eq_str(view(fn_sv), "read_dir") {
                return SEC_AUTH_FS;
            }
        } else if fre_sv_eq_str(view(s1_sv), "env") {
            if fre_sv_eq_str(view(fn_sv), "get") ||
               fre_sv_eq_str(view(fn_sv), "var") ||
               fre_sv_eq_str(view(fn_sv), "set_var") ||
               fre_sv_eq_str(view(fn_sv), "remove_var") ||
               fre_sv_eq_str(view(fn_sv), "args") ||
               fre_sv_eq_str(view(fn_sv), "current_dir") ||
               fre_sv_eq_str(view(fn_sv), "set_current_dir") ||
               fre_sv_eq_str(view(fn_sv), "temp_dir") {
                return SEC_AUTH_ENV;
            }
        } else if fre_sv_eq_str(view(s1_sv), "process") {
            if fre_sv_eq_str(view(fn_sv), "spawn") ||
               fre_sv_eq_str(view(fn_sv), "status") ||
               fre_sv_eq_str(view(fn_sv), "output") ||
               fre_sv_eq_str(view(fn_sv), "exit") ||
               fre_sv_eq_str(view(fn_sv), "abort") ||
               fre_sv_eq_str(view(fn_sv), "exe_path") ||
               fre_sv_eq_str(view(fn_sv), "args") {
                return SEC_AUTH_PROCESS;
            }
        } else if fre_sv_eq_str(view(s1_sv), "time") {
            if fre_sv_eq_str(view(fn_sv), "now") ||
               fre_sv_eq_str(view(fn_sv), "instant_now") ||
               fre_sv_eq_str(view(fn_sv), "elapsed") ||
               fre_sv_eq_str(view(fn_sv), "instant_elapsed") ||
               fre_sv_eq_str(view(fn_sv), "system_time_now") {
                return SEC_AUTH_CLOCK;
            }
        }
    }
    0u32
}

fn sec_os_find_node(g: view<SecOsGraph>, target: *const HirItem) -> isize {
    if (target as usize) == 0 {
        return -1isize;
    }
    let tsym_v = unsafe { (*target).symbol.v };
    let mut i: usize = 0;
    while i < g.count {
        let np = unsafe { sec_os_node_const_at(g.nodes as *const SecOsNode, i) };
        if (unsafe { (*np).item as usize }) == (target as usize) {
            return i as isize;
        }
        i = i + 1;
    }
    if tsym_v != 0u32 {
        let mut j: usize = 0;
        while j < g.count {
            let np2 = unsafe { sec_os_node_const_at(g.nodes as *const SecOsNode, j) };
            let nit2 = unsafe { (*np2).item };
            if (nit2 as usize) != 0 && (unsafe { (*nit2).symbol.v }) == tsym_v {
                return j as isize;
            }
            j = j + 1;
        }
    }
    -1isize
}

fn sec_os_resolve_call_target(hir_ptr: *const HirFile, thir_ptr: *const Thir, expr: *const HirExpr) -> *const HirItem {
    if (expr as usize) == 0 || (thir_ptr as usize) == 0 {
        return 0 as *const HirItem;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_METHOD_CALL {
        let mp = unsafe { thir_get_expr_method(view(*thir_ptr), expr) };
        if (mp as usize) != 0 {
            return unsafe { *mp };
        }
        return 0 as *const HirItem;
    }
    if ek == HIR_EXPR_CALL {
        let mp0 = unsafe { thir_get_expr_method(view(*thir_ptr), expr) };
        if (mp0 as usize) != 0 && (unsafe { *mp0 as usize }) != 0 {
            return unsafe { *mp0 };
        }
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        if (callee as usize) != 0 {
            if (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
                let sym = unsafe { (*callee).path.symbol };
                if sym.v != 0u32 {
                    let hit = unsafe_find_item_by_sym(hir_ptr, thir_ptr, sym);
                    if (hit as usize) != 0 && (unsafe { (*hit).kind }) == HIR_ITEM_FN {
                        return hit;
                    }
                }
            }
            let ctid = unsafe { thir_get_expr_type(view(*thir_ptr), callee as *const HirExpr) };
            if ctid.v != 0u32 {
                let ct = unsafe { type_get(view((*thir_ptr).interner), ctid) };
                if (ct as usize) != 0 && (unsafe { (*ct).kind }) == TY_FN {
                    let def = unsafe { (*ct).def };
                    if (def as usize) != 0 && (unsafe { (*def).kind }) == HIR_ITEM_FN {
                        return def;
                    }
                }
            }
        }
    }
    0 as *const HirItem
}

fn sec_os_add_edge(arena: mut_view<Arena>, node: *mut SecOsNode, callee_idx: u32, sp: Span) {
    let mut cur: *mut CapEdge = unsafe { (*node).edges };
    while (cur as usize) != 0 {
        if (unsafe { (*cur).callee_idx }) == callee_idx {
            return;
        }
        cur = unsafe { (*cur).next };
    }
    let e = arena_alloc_raw(mut_view(*arena), size_of<CapEdge>(), align_of<CapEdge>()) as *mut CapEdge;
    unsafe {
        (*e).callee_idx = callee_idx;
        (*e).call_span = sp;
        (*e).next = (*node).edges;
        (*node).edges = e;
    }
}

fn sec_os_scan_expr(arena: mut_view<Arena>, g: view<SecOsGraph>, node: *mut SecOsNode, expr: *mut HirExpr) {
    let mut cur = expr;
    while (cur as usize) != 0 {
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_CALL || k == HIR_EXPR_METHOD_CALL {
            if k == HIR_EXPR_CALL {
                let callee: *mut HirExpr = unsafe { (*cur).callee };
                if (callee as usize) != 0 {
                    let ctid = unsafe { thir_get_expr_type(view(*g.thir), callee as *const HirExpr) };
                    if ctid.v != 0u32 {
                        let ct = unsafe { type_get(view((*g.thir).interner), ctid) };
                        if (ct as usize) != 0 {
                            let ck = unsafe { (*ct).kind };
                            if ck == TY_BUILTIN_PRINT || ck == TY_BUILTIN_PRINT_INT {
                                unsafe {
                                    (*node).raw_os_mask = (*node).raw_os_mask | SEC_AUTH_FS;
                                    if !((*node).is_std && (*node).has_cap_param) {
                                        (*node).ambient_os_mask = (*node).ambient_os_mask | SEC_AUTH_FS;
                                    }
                                }
                            }
                        }
                    }
                }
                sec_os_scan_expr(mut_view(*arena), g, node, callee);
            } else {
                sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).receiver });
            }
            let target = sec_os_resolve_call_target(g.hir, g.thir, cur as *const HirExpr);
            if (target as usize) != 0 {
                let tidx = sec_os_find_node(g, target);
                if tidx >= 0isize {
                    sec_os_add_edge(mut_view(*arena), node, tidx as u32, unsafe { (*cur).span });
                } else {
                    let t_has_cap = unsafe { sec_fn_has_authority_cap_param(view(*g.interner), view(*g.thir), target) };
                    let dm = unsafe { sec_fn_direct_os_mask(view(*g.interner), target, t_has_cap) };
                    if dm != 0u32 {
                        unsafe {
                            (*node).raw_os_mask = (*node).raw_os_mask | dm;
                            if !((*node).is_std && (*node).has_cap_param) {
                                (*node).ambient_os_mask = (*node).ambient_os_mask | dm;
                            }
                        }
                    }
                }
            }
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).args });
        } else if k == HIR_EXPR_BLOCK || k == HIR_EXPR_UNSAFE || k == HIR_EXPR_LOOP || k == HIR_EXPR_COMPTIME {
            sec_os_scan_block(mut_view(*arena), g, node, unsafe { (*cur).block });
        } else if k == HIR_EXPR_IF {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).cond });
            sec_os_scan_block(mut_view(*arena), g, node, unsafe { (*cur).block });
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).else_branch });
        } else if k == HIR_EXPR_WHILE {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).cond });
            sec_os_scan_block(mut_view(*arena), g, node, unsafe { (*cur).block });
        } else if k == HIR_EXPR_FOR {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).iter });
            sec_os_scan_block(mut_view(*arena), g, node, unsafe { (*cur).block });
        } else if k == HIR_EXPR_MATCH {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).cond });
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while (a as usize) != 0 {
                sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*a).guard });
                sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*a).body });
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_CLOSURE {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).body });
        } else if k == HIR_EXPR_BINARY {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).left });
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).right });
        } else if k == HIR_EXPR_UNARY || k == HIR_EXPR_VIEW || k == HIR_EXPR_JUMP || k == HIR_EXPR_CAST || k == HIR_EXPR_TRY || k == HIR_EXPR_AWAIT {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).inner });
        } else if k == HIR_EXPR_ARRAY {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).elems });
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).count_expr });
        } else if k == HIR_EXPR_TUPLE {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).elems });
        } else if k == HIR_EXPR_STRUCT {
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*f).expr });
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_RANGE {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).start_expr });
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).end_expr });
        } else if k == HIR_EXPR_FIELD || k == HIR_EXPR_TUPLE_INDEX {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).base });
        } else if k == HIR_EXPR_INDEX {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).base });
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*cur).index_arg });
        }
        cur = unsafe { (*cur).next };
    }
}

fn sec_os_scan_block(arena: mut_view<Arena>, g: view<SecOsGraph>, node: *mut SecOsNode, blk: *mut HirBlock) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while (s as usize) != 0 {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*s).expr });
            sec_os_scan_block(mut_view(*arena), g, node, unsafe { (*s).else_block });
        } else if sk == HIR_STMT_ASSIGN {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*s).left });
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*s).right });
        } else if sk == HIR_STMT_EXPR {
            sec_os_scan_expr(mut_view(*arena), g, node, unsafe { (*s).expr });
        }
        s = unsafe { (*s).next };
    }
}

fn sec_os_graph_build(
    arena: mut_view<Arena>,
    hir_file: view<HirFile>,
    thir: view<Thir>,
    interner: view<StrInterner>,
    user_fids: *const u32,
    user_fid_count: usize
) -> SecOsGraph {
    let hir_ptr = unsafe { address_of(hir_file.items) as *const HirFile };
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };

    let mut count: usize = 0;
    let mut it0: *mut HirItem = hir_file.items;
    while (it0 as usize) != 0 {
        let ik0 = unsafe { (*it0).kind };
        if ik0 == HIR_ITEM_FN {
            count = count + 1;
        } else if ik0 == HIR_ITEM_IMPL || ik0 == HIR_ITEM_TRAIT || ik0 == HIR_ITEM_EXTERN_BLOCK {
            let mut m0: *mut HirItem = unsafe { (*it0).members };
            while (m0 as usize) != 0 {
                if (unsafe { (*m0).kind }) == HIR_ITEM_FN {
                    count = count + 1;
                }
                m0 = unsafe { (*m0).next };
            }
        }
        it0 = unsafe { (*it0).next };
    }

    if count == 0 {
        return SecOsGraph {
            nodes: 0 as *mut SecOsNode,
            count: 0,
            hir: hir_ptr,
            thir: thir_ptr,
            interner: int_ptr,
        };
    }

    let raw_bytes = mul_usize(count, size_of<SecOsNode>());
    let nodes_raw = arena_alloc_raw(mut_view(*arena), raw_bytes, align_of<SecOsNode>());
    tc_zero_bytes(nodes_raw, raw_bytes);
    let nodes = nodes_raw as *mut SecOsNode;

    let mut idx: usize = 0;
    let mut it1: *mut HirItem = hir_file.items;
    while (it1 as usize) != 0 {
        let ik1 = unsafe { (*it1).kind };
        if ik1 == HIR_ITEM_FN {
            let np = unsafe { sec_os_node_at(nodes, idx) };
            let is_std = !sec_is_user_item(interner, it1 as *const HirItem, user_fids, user_fid_count);
            let has_cap = sec_fn_has_authority_cap_param(interner, thir, it1 as *const HirItem);
            let dm = sec_fn_direct_os_mask(interner, it1 as *const HirItem, has_cap);
            unsafe {
                (*np).item = it1 as *const HirItem;
                (*np).is_std = is_std;
                (*np).has_cap_param = has_cap;
                (*np).raw_os_mask = dm;
                (*np).ambient_os_mask = if is_std && has_cap { 0u32 } else { dm };
            }
            idx = idx + 1;
        } else if ik1 == HIR_ITEM_IMPL || ik1 == HIR_ITEM_TRAIT || ik1 == HIR_ITEM_EXTERN_BLOCK {
            let p_std = !sec_is_user_item(interner, it1 as *const HirItem, user_fids, user_fid_count);
            let mut m1: *mut HirItem = unsafe { (*it1).members };
            while (m1 as usize) != 0 {
                if (unsafe { (*m1).kind }) == HIR_ITEM_FN {
                    let np2 = unsafe { sec_os_node_at(nodes, idx) };
                    let is_std2 = p_std || !sec_is_user_item(interner, m1 as *const HirItem, user_fids, user_fid_count);
                    let has_cap2 = sec_fn_has_authority_cap_param(interner, thir, m1 as *const HirItem);
                    let dm2 = sec_fn_direct_os_mask(interner, m1 as *const HirItem, has_cap2);
                    unsafe {
                        (*np2).item = m1 as *const HirItem;
                        (*np2).is_std = is_std2;
                        (*np2).has_cap_param = has_cap2;
                        (*np2).raw_os_mask = dm2;
                        (*np2).ambient_os_mask = if is_std2 && has_cap2 { 0u32 } else { dm2 };
                    }
                    idx = idx + 1;
                }
                m1 = unsafe { (*m1).next };
            }
        }
        it1 = unsafe { (*it1).next };
    }

    let g = SecOsGraph {
        nodes: nodes,
        count: idx,
        hir: hir_ptr,
        thir: thir_ptr,
        interner: int_ptr,
    };

    let mut u: usize = 0;
    while u < g.count {
        let np = unsafe { sec_os_node_at(g.nodes, u) };
        let uit = unsafe { (*np).item };
        let body_blk: *mut HirBlock = unsafe { (*uit).body };
        if (body_blk as usize) != 0 {
            sec_os_scan_block(mut_view(*arena), view(g), np, body_blk);
        }
        u = u + 1;
    }

    let mut changed = true;
    let mut guard: usize = 0;
    let max_iters: usize = (g.count + 2) * 8;
    while changed && guard < max_iters {
        changed = false;
        guard = guard + 1;
        let mut i: usize = 0;
        while i < g.count {
            let unode = unsafe { sec_os_node_at(g.nodes, i) };
            let u_gated = (unsafe { (*unode).is_std }) && (unsafe { (*unode).has_cap_param });
            let mut e: *mut CapEdge = unsafe { (*unode).edges };
            while (e as usize) != 0 {
                let v_idx = (unsafe { (*e).callee_idx }) as usize;
                if v_idx < g.count {
                    let vnode = unsafe { sec_os_node_const_at(g.nodes as *const SecOsNode, v_idx) };
                    let v_raw = unsafe { (*vnode).raw_os_mask };
                    let u_raw = unsafe { (*unode).raw_os_mask };
                    if (v_raw & (u_raw ^ 0xFFFFFFFFu32)) != 0u32 {
                        unsafe {
                            (*unode).raw_os_mask = u_raw | v_raw;
                            if (*unode).next_hop_plus1 == 0u32 {
                                (*unode).next_hop_plus1 = (v_idx as u32) + 1u32;
                            }
                        }
                        changed = true;
                    }
                    if !u_gated {
                        let v_amb = unsafe { (*vnode).ambient_os_mask };
                        let u_amb = unsafe { (*unode).ambient_os_mask };
                        if (v_amb & (u_amb ^ 0xFFFFFFFFu32)) != 0u32 {
                            unsafe {
                                (*unode).ambient_os_mask = u_amb | v_amb;
                                if (*unode).next_hop_plus1 == 0u32 {
                                    (*unode).next_hop_plus1 = (v_idx as u32) + 1u32;
                                }
                            }
                            changed = true;
                        }
                    }
                }
                e = unsafe { (*e).next };
            }
            i = i + 1;
        }
    }

    g
}

fn sec_call_passes_authority_cap(interner: view<StrInterner>, thir: view<Thir>, call_expr: *const HirExpr) -> bool {
    if (call_expr as usize) == 0 {
        return false;
    }
    if (unsafe { (*call_expr).kind }) == HIR_EXPR_METHOD_CALL {
        let recv: *mut HirExpr = unsafe { (*call_expr).receiver };
        if (recv as usize) != 0 {
            let rty = thir_get_expr_type(thir, recv as *const HirExpr);
            if sec_type_direct_authority_cap_mask(interner, thir, rty) != 0u32 {
                return true;
            }
        }
    }
    let mut a: *mut HirExpr = unsafe { (*call_expr).args };
    while (a as usize) != 0 {
        let aty = thir_get_expr_type(thir, a as *const HirExpr);
        if sec_type_direct_authority_cap_mask(interner, thir, aty) != 0u32 {
            return true;
        }
        a = unsafe { (*a).next };
    }
    false
}

fn sec_required_cap_name_for_mask(mask: u32) -> str {
    if (mask & SEC_AUTH_FS) != 0u32 { return "FsCap"; }
    if (mask & SEC_AUTH_NET) != 0u32 { return "NetCap"; }
    if (mask & SEC_AUTH_ENV) != 0u32 { return "EnvCap"; }
    if (mask & SEC_AUTH_PROCESS) != 0u32 { return "ProcessCap"; }
    if (mask & SEC_AUTH_CLOCK) != 0u32 { return "ClockCap"; }
    "FsCap"
}

fn sec_format_os_chain_note(
    arena: mut_view<Arena>,
    g: view<SecOsGraph>,
    caller_it: *const HirItem,
    first_callee_idx: isize
) -> StrView {
    if first_callee_idx < 0isize || g.count == 0 || (g.nodes as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let np0 = unsafe { sec_os_node_const_at(g.nodes as *const SecOsNode, first_callee_idx as usize) };
    if (unsafe { (*np0).next_hop_plus1 }) == 0u32 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let mut b = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let pfx = fre_arena_str(mut_view(*arena), "call chain: ");
    diag_buf_push_bytes(mut_view(b), pfx.ptr, pfx.len);
    let arrow = fre_arena_str(mut_view(*arena), " -> ");
    if (caller_it as usize) != 0 {
        let c_sv = unsafe { interner_get(view(*g.interner), StrId { v: (*caller_it).name.v }) };
        if c_sv.len > 0 {
            diag_buf_push_bytes(mut_view(b), c_sv.ptr, c_sv.len);
            diag_buf_push_bytes(mut_view(b), arrow.ptr, arrow.len);
        }
    }
    let mut cur = first_callee_idx as usize;
    let mut hops: usize = 0;
    while cur < g.count && hops < 16 {
        let np = unsafe { sec_os_node_const_at(g.nodes as *const SecOsNode, cur) };
        let cit = unsafe { (*np).item };
        let fn_sv = unsafe { interner_get(view(*g.interner), StrId { v: (*cit).name.v }) };
        if hops > 0 {
            diag_buf_push_bytes(mut_view(b), arrow.ptr, arrow.len);
        }
        diag_buf_push_bytes(mut_view(b), fn_sv.ptr, fn_sv.len);
        let nh = unsafe { (*np).next_hop_plus1 };
        if nh == 0u32 {
            break;
        }
        cur = (nh - 1u32) as usize;
        hops = hops + 1;
    }
    let tmp_sv = StrView { ptr: b.ptr as *const u8, len: b.len };
    let out = fre_arena_clone_sv(mut_view(*arena), view(tmp_sv));
    if b.cap > 0 && (b.ptr as usize) != 0 {
        unsafe { heap_free(b.ptr, b.cap, 1); }
    }
    out
}

struct SecBodyWalkCtx {
    hir: *const HirFile,
    thir: *const Thir,
    interner: *const StrInterner,
    sink: *mut DiagSink,
    os_graph: *const SecOsGraph,
    owner_item: *const HirItem,
    forbid_unsafe: bool,
    is_sandbox: bool,
    fn_has_cap_param: bool,
    suppress_cap_path_diag: bool,
    ambient_emitted: usize,
}

fn sec_check_hir_type_comptime_exprs(w: mut_view<SecBodyWalkCtx>, ht: *mut HirType, in_rejected_unsafe: bool) {
    if (ht as usize) == 0 {
        return;
    }
    let tk = unsafe { (*ht).kind };
    if tk == HIR_TYPE_ARRAY {
        sec_walk_expr(mut_view(*w), unsafe { (*ht).count_expr }, in_rejected_unsafe, true);
        sec_check_hir_type_comptime_exprs(w, unsafe { (*ht).elem }, in_rejected_unsafe);
    } else if tk == HIR_TYPE_SLICE || tk == HIR_TYPE_PTR || tk == HIR_TYPE_VIEW {
        sec_check_hir_type_comptime_exprs(w, unsafe { (*ht).elem }, in_rejected_unsafe);
    } else if tk == HIR_TYPE_TUPLE {
        let mut cur: *mut HirType = unsafe { (*ht).elem_types };
        while (cur as usize) != 0 {
            sec_check_hir_type_comptime_exprs(mut_view(*w), cur, in_rejected_unsafe);
            cur = unsafe { (*cur).next };
        }
    } else if tk == HIR_TYPE_FN {
        let mut cur_p: *mut HirType = unsafe { (*ht).param_types };
        while (cur_p as usize) != 0 {
            sec_check_hir_type_comptime_exprs(mut_view(*w), cur_p, in_rejected_unsafe);
            cur_p = unsafe { (*cur_p).next };
        }
        sec_check_hir_type_comptime_exprs(w, unsafe { (*ht).ret_type }, in_rejected_unsafe);
    }
}

fn sec_check_disallowed_local_policy_attrs(interner: view<StrInterner>, sink: mut_view<DiagSink>, attrs: *mut HirAttr) {
    let mut hf = false;
    let mut fsp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    let mut ha = false;
    let mut asp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    sec_scan_policy_attrs(interner, sink, attrs, false, mut_view(hf), mut_view(fsp), mut_view(ha), mut_view(asp));
}

fn sec_walk_block(
    w: mut_view<SecBodyWalkCtx>,
    blk: *mut HirBlock,
    in_rejected_unsafe: bool,
    in_comptime: bool
) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while (s as usize) != 0 {
        unsafe { sec_check_disallowed_local_policy_attrs(view(*w.interner), mut_view(*w.sink), (*s).attrs); }
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            sec_check_hir_type_comptime_exprs(mut_view(*w), unsafe { (*s).ty }, in_rejected_unsafe);
            sec_walk_expr(mut_view(*w), unsafe { (*s).expr }, in_rejected_unsafe, in_comptime);
            sec_walk_block(mut_view(*w), unsafe { (*s).else_block }, in_rejected_unsafe, in_comptime);
        } else if sk == HIR_STMT_ASSIGN {
            sec_walk_expr(mut_view(*w), unsafe { (*s).left }, in_rejected_unsafe, in_comptime);
            sec_walk_expr(mut_view(*w), unsafe { (*s).right }, in_rejected_unsafe, in_comptime);
        } else if sk == HIR_STMT_EXPR {
            sec_walk_expr(mut_view(*w), unsafe { (*s).expr }, in_rejected_unsafe, in_comptime);
        }
        s = unsafe { (*s).next };
    }
}

fn sec_walk_expr(
    w: mut_view<SecBodyWalkCtx>,
    expr: *mut HirExpr,
    in_rejected_unsafe: bool,
    in_comptime: bool
) {
    let mut cur = expr;
    while (cur as usize) != 0 {
        let ek = unsafe { (*cur).kind };
        let sp_f = unsafe { (*cur).span.file.v };
        let sp_s = unsafe { (*cur).span.start };
        let sp_e = unsafe { (*cur).span.end };
        let empty_note = StrView { ptr: 0 as *const u8, len: 0 };

        if ek == HIR_EXPR_UNSAFE {
            let mut next_rej = in_rejected_unsafe;
            if w.forbid_unsafe {
                if !in_rejected_unsafe {
                    unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "unsafe_block"); }
                }
                next_rej = true;
            }
            sec_walk_block(mut_view(*w), unsafe { (*cur).block }, next_rej, in_comptime);
            cur = unsafe { (*cur).next };
            continue;
        }

        if ek == HIR_EXPR_COMPTIME {
            sec_walk_block(mut_view(*w), unsafe { (*cur).block }, in_rejected_unsafe, true);
            cur = unsafe { (*cur).next };
            continue;
        }

        if ek == HIR_EXPR_PATH {
            if w.forbid_unsafe && !in_rejected_unsafe {
                let st_it = unsafe { sec_find_mut_static_by_path(view(*w.hir), (*cur).path.symbol.v, (*cur).path.name.v) };
                if (st_it as usize) != 0 {
                    unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "static_mut"); }
                }
            }
            if in_comptime {
                let psym_v = unsafe { (*cur).path.symbol.v };
                if psym_v != 0u32 {
                    let sym_ty = unsafe { thir_get_symbol_type(view(*w.thir), SymbolId { v: psym_v }) };
                    let cap_m = unsafe { sec_type_direct_authority_cap_mask(view(*w.interner), view(*w.thir), sym_ty) };
                    if cap_m != 0u32 && !w.suppress_cap_path_diag {
                        let pname_sv = unsafe { interner_get(view(*w.interner), StrId { v: (*cur).path.name.v }) };
                        let req_cap = sec_required_cap_name_for_mask(cap_m);
                        unsafe {
                            sec_report_ambient_diag(
                                mut_view(*w.sink),
                                sec_mk_span(sp_f, sp_s, sp_e),
                                view(pname_sv),
                                req_cap,
                                "comptime",
                                "runtime_to_comptime_authority",
                                true,
                                view(empty_note)
                            );
                        }
                        w.ambient_emitted = w.ambient_emitted + 1;
                    }
                }
            }
            cur = unsafe { (*cur).next };
            continue;
        }

        if ek == HIR_EXPR_UNARY {
            let op = unsafe { (*cur).op };
            let inner: *mut HirExpr = unsafe { (*cur).inner };
            let mut next_rej = in_rejected_unsafe;
            if w.forbid_unsafe && !in_rejected_unsafe && op == UNOP_DEREF && (inner as usize) != 0 {
                let op_ty = unsafe { thir_get_expr_type(view(*w.thir), inner as *const HirExpr) };
                if op_ty.v != 0u32 {
                    let t = unsafe { type_get(view((*w.thir).interner), op_ty) };
                    if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_PTR {
                        unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "raw_ptr_op"); }
                        next_rej = true;
                    }
                }
            }
            sec_walk_expr(mut_view(*w), inner, next_rej, in_comptime);
            cur = unsafe { (*cur).next };
            continue;
        }

        if ek == HIR_EXPR_FIELD {
            let base: *mut HirExpr = unsafe { (*cur).base };
            let mut next_rej = in_rejected_unsafe;
            if w.forbid_unsafe && !in_rejected_unsafe && (base as usize) != 0 {
                let bty = unsafe { thir_get_expr_type(view(*w.thir), base as *const HirExpr) };
                if bty.v != 0u32 {
                    let bt = unsafe { type_get(view((*w.thir).interner), bty) };
                    if (bt as usize) != 0 && (unsafe { (*bt).kind }) == TY_PTR {
                        unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "raw_ptr_op"); }
                        next_rej = true;
                    }
                }
            }
            sec_walk_expr(mut_view(*w), base, next_rej, in_comptime);
            cur = unsafe { (*cur).next };
            continue;
        }

        if ek == HIR_EXPR_BINARY {
            let op = unsafe { (*cur).op };
            let left: *mut HirExpr = unsafe { (*cur).left };
            let right: *mut HirExpr = unsafe { (*cur).right };
            if w.forbid_unsafe && !in_rejected_unsafe && (op == BINOP_ADD || op == BINOP_SUB) {
                let lty = if (left as usize) != 0 { unsafe { thir_get_expr_type(view(*w.thir), left as *const HirExpr) } } else { TypeId { v: 0u32 } };
                let rty = if (right as usize) != 0 { unsafe { thir_get_expr_type(view(*w.thir), right as *const HirExpr) } } else { TypeId { v: 0u32 } };
                let mut is_ptr_arith = false;
                if lty.v != 0u32 {
                    let lt = unsafe { type_get(view((*w.thir).interner), lty) };
                    if (lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_PTR {
                        is_ptr_arith = true;
                    }
                }
                if rty.v != 0u32 {
                    let rt = unsafe { type_get(view((*w.thir).interner), rty) };
                    if (rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR {
                        is_ptr_arith = true;
                    }
                }
                if is_ptr_arith {
                    unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "raw_ptr_op"); }
                }
            }
            sec_walk_expr(mut_view(*w), left, in_rejected_unsafe, in_comptime);
            sec_walk_expr(mut_view(*w), right, in_rejected_unsafe, in_comptime);
            cur = unsafe { (*cur).next };
            continue;
        }

        if ek == HIR_EXPR_CALL || ek == HIR_EXPR_METHOD_CALL {
            let target = sec_os_resolve_call_target(w.hir, w.thir, cur as *const HirExpr);

            // 1. `@forbid_unsafe` / `--safety-profile safe|sandbox` call checks
            if w.forbid_unsafe && !in_rejected_unsafe {
                let mut reported_call_unsafe = false;
                if ek == HIR_EXPR_CALL {
                    let callee: *mut HirExpr = unsafe { (*cur).callee };
                    if (callee as usize) != 0 {
                        let ctid = unsafe { thir_get_expr_type(view(*w.thir), callee as *const HirExpr) };
                        if ctid.v != 0u32 {
                            let ct = unsafe { type_get(view((*w.thir).interner), ctid) };
                            if (ct as usize) != 0 {
                                let ck = unsafe { (*ct).kind };
                                if ck == TY_BUILTIN_ADDRESS_OF ||
                                   ck == TY_BUILTIN_ADDRESS_OF_MUT ||
                                   ck == TY_BUILTIN_PTR_ADD ||
                                   ck == TY_BUILTIN_PTR_SUB ||
                                   ck == TY_BUILTIN_DROP_IN_PLACE ||
                                   ck == TY_BUILTIN_PTR_COPY ||
                                   ck == TY_BUILTIN_PTR_COPY_NONOVERLAPPING ||
                                   ck == TY_BUILTIN_PTR_WRITE_BYTES {
                                    unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "raw_ptr_op"); }
                                    reported_call_unsafe = true;
                                } else if ck == TY_FN && (unsafe { (*ct).is_unsafe }) && (target as usize) == 0 {
                                    unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "unsafe_fn"); }
                                    reported_call_unsafe = true;
                                }
                            }
                        }
                    }
                }
                if !reported_call_unsafe && (target as usize) != 0 {
                    let t_abi_v = unsafe { (*target).abi.v };
                    let mut t_foreign = false;
                    if t_abi_v != 0u32 {
                        let t_abi_sv = unsafe { interner_get(view(*w.interner), StrId { v: t_abi_v }) };
                        if !fre_sv_eq_str(view(t_abi_sv), "axiom") {
                            t_foreign = true;
                        }
                    }
                    if t_foreign {
                        unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "extern_block"); }
                    } else if unsafe { (*target).is_unsafe } {
                        let t_name_sv = unsafe { interner_get(view(*w.interner), StrId { v: (*target).name.v }) };
                        let mut intr_at: *mut HirAttr = 0 as *mut HirAttr;
                        let is_intr = unsafe { fre_item_has_attr_name(view(*w.interner), (*target).attrs, "intrinsic", mut_view(intr_at)) };
                        if is_intr && sec_is_raw_ptr_intrinsic_name(view(t_name_sv)) {
                            unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "raw_ptr_op"); }
                        } else {
                            unsafe { sec_report_1data_diag(mut_view(*w.sink), AX_SEC_UNSAFE_FORBIDDEN, sec_mk_span(sp_f, sp_s, sp_e), "construct", "unsafe_fn"); }
                        }
                    }
                }
            }

            // 2. `sandbox` and `comptime` ambient-authority checks (`REQ-CAP-131`, `AXS-SEC-011`)
            if in_comptime || w.is_sandbox {
                let passes_cap = unsafe { sec_call_passes_authority_cap(view(*w.interner), view(*w.thir), cur as *const HirExpr) };
                let mut builtin_print_mask: u32 = 0u32;
                if ek == HIR_EXPR_CALL {
                    let callee_p: *mut HirExpr = unsafe { (*cur).callee };
                    if (callee_p as usize) != 0 {
                        let ctid2 = unsafe { thir_get_expr_type(view(*w.thir), callee_p as *const HirExpr) };
                        if ctid2.v != 0u32 {
                            let ct2 = unsafe { type_get(view((*w.thir).interner), ctid2) };
                            if (ct2 as usize) != 0 {
                                let ck2 = unsafe { (*ct2).kind };
                                if ck2 == TY_BUILTIN_PRINT || ck2 == TY_BUILTIN_PRINT_INT {
                                    builtin_print_mask = SEC_AUTH_FS;
                                }
                            }
                        }
                    }
                }

                if builtin_print_mask != 0u32 {
                    let p_sv = unsafe { fre_arena_str(mut_view((*w.sink).arena), "print") };
                    if in_comptime {
                        let has_rt_rsn = w.fn_has_cap_param || passes_cap;
                        unsafe {
                            sec_report_ambient_diag(
                                mut_view(*w.sink),
                                sec_mk_span(sp_f, sp_s, sp_e),
                                view(p_sv),
                                "FsCap",
                                "comptime",
                                "runtime_to_comptime_authority",
                                has_rt_rsn,
                                view(empty_note)
                            );
                        }
                    } else {
                        unsafe {
                            sec_report_ambient_diag(mut_view(*w.sink), sec_mk_span(sp_f, sp_s, sp_e), view(p_sv), "FsCap", "sandbox", "", false, view(empty_note));
                        }
                    }
                    w.ambient_emitted = w.ambient_emitted + 1;
                } else if (target as usize) != 0 && (w.os_graph as usize) != 0 {
                    let tidx = unsafe { sec_os_find_node(view(*w.os_graph), target) };
                    let mut t_is_std = false;
                    let mut t_raw_mask: u32 = 0u32;
                    let mut t_amb_mask: u32 = 0u32;
                    if tidx >= 0isize {
                        let np = unsafe { sec_os_node_const_at((*w.os_graph).nodes as *const SecOsNode, tidx as usize) };
                        t_is_std = unsafe { (*np).is_std };
                        t_raw_mask = unsafe { (*np).raw_os_mask };
                        t_amb_mask = unsafe { (*np).ambient_os_mask };
                    } else {
                        t_is_std = unsafe { tc_item_is_std_module(view(*w.interner), target) };
                        let t_has_cap = unsafe { sec_fn_has_authority_cap_param(view(*w.interner), view(*w.thir), target) };
                        t_raw_mask = unsafe { sec_fn_direct_os_mask(view(*w.interner), target, t_has_cap) };
                        t_amb_mask = if t_is_std && t_has_cap { 0u32 } else { t_raw_mask };
                    }
                    let op_name_sv = unsafe { interner_get(view(*w.interner), StrId { v: (*target).name.v }) };
                    if in_comptime {
                        if t_raw_mask != 0u32 {
                            let req_cap = sec_required_cap_name_for_mask(t_raw_mask);
                            let has_rt_rsn = w.fn_has_cap_param || passes_cap;
                            let cnote = unsafe { sec_format_os_chain_note(mut_view((*w.sink).arena), view(*w.os_graph), w.owner_item, tidx) };
                            unsafe {
                                sec_report_ambient_diag(
                                    mut_view(*w.sink),
                                    sec_mk_span(sp_f, sp_s, sp_e),
                                    view(op_name_sv),
                                    req_cap,
                                    "comptime",
                                    "runtime_to_comptime_authority",
                                    has_rt_rsn,
                                    view(cnote)
                                );
                            }
                            w.ambient_emitted = w.ambient_emitted + 1;
                        }
                    } else if w.is_sandbox && !passes_cap && t_amb_mask != 0u32 {
                        let req_cap2 = sec_required_cap_name_for_mask(t_amb_mask);
                        let cnote2 = unsafe { sec_format_os_chain_note(mut_view((*w.sink).arena), view(*w.os_graph), w.owner_item, tidx) };
                        unsafe {
                            sec_report_ambient_diag(
                                mut_view(*w.sink),
                                sec_mk_span(sp_f, sp_s, sp_e),
                                view(op_name_sv),
                                req_cap2,
                                "sandbox",
                                "",
                                false,
                                view(cnote2)
                            );
                        }
                        w.ambient_emitted = w.ambient_emitted + 1;
                    }
                }
            }

            let prev_amb = w.ambient_emitted;
            if ek == HIR_EXPR_CALL {
                sec_walk_expr(mut_view(*w), unsafe { (*cur).callee }, in_rejected_unsafe, in_comptime);
            } else {
                sec_walk_expr(mut_view(*w), unsafe { (*cur).receiver }, in_rejected_unsafe, in_comptime);
            }
            // Avoid emitting a second runtime_to_comptime_authority on `cap` arg if the call itself already reported it
            if in_comptime && w.ambient_emitted > prev_amb {
                let old_sup = w.suppress_cap_path_diag;
                w.suppress_cap_path_diag = true;
                sec_walk_expr(mut_view(*w), unsafe { (*cur).args }, in_rejected_unsafe, in_comptime);
                w.suppress_cap_path_diag = old_sup;
            } else {
                sec_walk_expr(mut_view(*w), unsafe { (*cur).args }, in_rejected_unsafe, in_comptime);
            }
            cur = unsafe { (*cur).next };
            continue;
        }

        if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_LOOP {
            sec_walk_block(mut_view(*w), unsafe { (*cur).block }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_IF {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).cond }, in_rejected_unsafe, in_comptime);
            sec_walk_block(mut_view(*w), unsafe { (*cur).block }, in_rejected_unsafe, in_comptime);
            sec_walk_expr(mut_view(*w), unsafe { (*cur).else_branch }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_WHILE {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).cond }, in_rejected_unsafe, in_comptime);
            sec_walk_block(mut_view(*w), unsafe { (*cur).block }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_FOR {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).iter }, in_rejected_unsafe, in_comptime);
            sec_walk_block(mut_view(*w), unsafe { (*cur).block }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_MATCH {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).cond }, in_rejected_unsafe, in_comptime);
            let mut arm: *mut HirMatchArm = unsafe { (*cur).arms };
            while (arm as usize) != 0 {
                sec_walk_expr(mut_view(*w), unsafe { (*arm).guard }, in_rejected_unsafe, in_comptime);
                sec_walk_expr(mut_view(*w), unsafe { (*arm).body }, in_rejected_unsafe, in_comptime);
                arm = unsafe { (*arm).next };
            }
        } else if ek == HIR_EXPR_CLOSURE {
            let mut cp: *mut HirParam = unsafe { (*cur).params };
            while (cp as usize) != 0 {
                unsafe { sec_check_disallowed_local_policy_attrs(view(*w.interner), mut_view(*w.sink), (*cp).attrs); }
                sec_check_hir_type_comptime_exprs(mut_view(*w), unsafe { (*cp).ty }, in_rejected_unsafe);
                cp = unsafe { (*cp).next };
            }
            sec_walk_expr(mut_view(*w), unsafe { (*cur).body }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_VIEW || ek == HIR_EXPR_JUMP || ek == HIR_EXPR_CAST || ek == HIR_EXPR_TRY || ek == HIR_EXPR_AWAIT {
            if ek == HIR_EXPR_CAST {
                sec_check_hir_type_comptime_exprs(mut_view(*w), unsafe { (*cur).cast_ty }, in_rejected_unsafe);
            }
            sec_walk_expr(mut_view(*w), unsafe { (*cur).inner }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_ARRAY {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).elems }, in_rejected_unsafe, in_comptime);
            sec_walk_expr(mut_view(*w), unsafe { (*cur).count_expr }, in_rejected_unsafe, true);
        } else if ek == HIR_EXPR_TUPLE {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).elems }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_STRUCT {
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                sec_walk_expr(mut_view(*w), unsafe { (*f).expr }, in_rejected_unsafe, in_comptime);
                f = unsafe { (*f).next };
            }
        } else if ek == HIR_EXPR_RANGE {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).start_expr }, in_rejected_unsafe, in_comptime);
            sec_walk_expr(mut_view(*w), unsafe { (*cur).end_expr }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_TUPLE_INDEX {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).base }, in_rejected_unsafe, in_comptime);
        } else if ek == HIR_EXPR_INDEX {
            sec_walk_expr(mut_view(*w), unsafe { (*cur).base }, in_rejected_unsafe, in_comptime);
            sec_walk_expr(mut_view(*w), unsafe { (*cur).index_arg }, in_rejected_unsafe, in_comptime);
        }
        cur = unsafe { (*cur).next };
    }
}

fn sec_check_single_item(
    hir_file: view<HirFile>,
    thir: view<Thir>,
    interner: view<StrInterner>,
    sink: mut_view<DiagSink>,
    os_graph: view<SecOsGraph>,
    it: *const HirItem,
    eff_forbid: bool,
    is_sandbox: bool
) {
    if (it as usize) == 0 {
        return;
    }
    let ik = unsafe { (*it).kind };
    if eff_forbid {
        sec_check_item_header_forbid_unsafe(interner, mut_view(*sink), it);
    }

    let hir_ptr = unsafe { address_of(hir_file.items) as *const HirFile };
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };
    let sink_ptr = unsafe { address_of_mut(sink.arena.head) as *mut DiagSink };
    let g_ptr = unsafe { address_of(os_graph.nodes) as *const SecOsGraph };

    if ik == HIR_ITEM_STRUCT {
        let mut fd: *mut HirFieldDecl = unsafe { (*it).struct_fields };
        while (fd as usize) != 0 {
            sec_check_disallowed_local_policy_attrs(interner, mut_view(*sink), unsafe { (*fd).attrs });
            let mut fw = SecBodyWalkCtx {
                hir: hir_ptr,
                thir: thir_ptr,
                interner: int_ptr,
                sink: sink_ptr,
                os_graph: g_ptr,
                owner_item: it,
                forbid_unsafe: eff_forbid,
                is_sandbox: is_sandbox,
                fn_has_cap_param: false,
                suppress_cap_path_diag: false,
                ambient_emitted: 0,
            };
            sec_check_hir_type_comptime_exprs(mut_view(fw), unsafe { (*fd).ty }, false);
            fd = unsafe { (*fd).next };
        }
        return;
    }
    if ik == HIR_ITEM_ENUM {
        let mut vd: *mut HirVariantDecl = unsafe { (*it).variants };
        while (vd as usize) != 0 {
            sec_check_disallowed_local_policy_attrs(interner, mut_view(*sink), unsafe { (*vd).attrs });
            let mut vfd: *mut HirFieldDecl = unsafe { (*vd).struct_fields };
            while (vfd as usize) != 0 {
                sec_check_disallowed_local_policy_attrs(interner, mut_view(*sink), unsafe { (*vfd).attrs });
                vfd = unsafe { (*vfd).next };
            }
            vd = unsafe { (*vd).next };
        }
        return;
    }

    let empty_note = StrView { ptr: 0 as *const u8, len: 0 };

    // ASEC-24 (`SPEC-53 AXS-SEC-011 (3)`): comptime authority NEVER becomes runtime authority
    if ik == HIR_ITEM_CONST || ik == HIR_ITEM_STATIC {
        let mut item_tid = thir_get_item_type(thir, it);
        if item_tid.v == 0u32 && (unsafe { (*it).symbol.v }) != 0u32 {
            item_tid = thir_get_symbol_type(thir, SymbolId { v: unsafe { (*it).symbol.v } });
        }
        let cap_m = sec_type_contains_authority_cap_mask(interner, thir, item_tid, 0);
        if cap_m != 0u32 {
            let iname_sv = interner_get(interner, StrId { v: unsafe { (*it).name.v } });
            let req_cap = sec_required_cap_name_for_mask(cap_m);
            sec_report_ambient_diag(
                mut_view(*sink),
                unsafe { (*it).span },
                view(iname_sv),
                req_cap,
                "comptime",
                "comptime_to_runtime_authority",
                true,
                view(empty_note)
            );
            return;
        }
        let mut cw = SecBodyWalkCtx {
            hir: hir_ptr,
            thir: thir_ptr,
            interner: int_ptr,
            sink: sink_ptr,
            os_graph: g_ptr,
            owner_item: it,
            forbid_unsafe: eff_forbid,
            is_sandbox: is_sandbox,
            fn_has_cap_param: false,
            suppress_cap_path_diag: false,
            ambient_emitted: 0,
        };
        sec_check_hir_type_comptime_exprs(mut_view(cw), unsafe { (*it).ty }, false);
        sec_walk_expr(mut_view(cw), unsafe { (*it).expr }, false, true);
        return;
    }

    if ik == HIR_ITEM_FN {
        let is_ct_fn = unsafe { (*it).is_comptime };
        let fn_has_cap = sec_fn_has_authority_cap_param(interner, thir, it);
        let mut first_cap_param_sp = unsafe { (*it).span };
        let mut first_cap_mask: u32 = 0u32;
        let mut p: *mut HirParam = unsafe { (*it).params };
        while (p as usize) != 0 {
            sec_check_disallowed_local_policy_attrs(interner, mut_view(*sink), unsafe { (*p).attrs });
            let mut ptid = thir_get_param_type(thir, p as *const HirParam);
            if ptid.v == 0u32 && (unsafe { (*p).symbol.v }) != 0u32 {
                ptid = thir_get_symbol_type(thir, SymbolId { v: unsafe { (*p).symbol.v } });
            }
            let pm = sec_type_direct_authority_cap_mask(interner, thir, ptid);
            if pm != 0u32 && first_cap_mask == 0u32 {
                first_cap_mask = pm;
                first_cap_param_sp = unsafe { (*p).span };
            }
            p = unsafe { (*p).next };
        }

        // ASEC-25 (`SPEC-53 AXS-SEC-011 (3)`): comptime fn declaring a runtime authority capability param
        let mut reported_ct_param = false;
        if is_ct_fn && first_cap_mask != 0u32 {
            let fname_sv = interner_get(interner, StrId { v: unsafe { (*it).name.v } });
            let req_cap = sec_required_cap_name_for_mask(first_cap_mask);
            sec_report_ambient_diag(
                mut_view(*sink),
                first_cap_param_sp,
                view(fname_sv),
                req_cap,
                "comptime",
                "runtime_to_comptime_authority",
                true,
                view(empty_note)
            );
            reported_ct_param = true;
        }

        let mut bw = SecBodyWalkCtx {
            hir: hir_ptr,
            thir: thir_ptr,
            interner: int_ptr,
            sink: sink_ptr,
            os_graph: g_ptr,
            owner_item: it,
            forbid_unsafe: eff_forbid,
            is_sandbox: is_sandbox,
            fn_has_cap_param: fn_has_cap,
            suppress_cap_path_diag: reported_ct_param,
            ambient_emitted: 0,
        };
        let mut p2: *mut HirParam = unsafe { (*it).params };
        while (p2 as usize) != 0 {
            sec_check_hir_type_comptime_exprs(mut_view(bw), unsafe { (*p2).ty }, false);
            p2 = unsafe { (*p2).next };
        }
        sec_check_hir_type_comptime_exprs(mut_view(bw), unsafe { (*it).ret_type }, false);
        let in_rej = eff_forbid && (unsafe { (*it).is_unsafe });
        sec_walk_block(mut_view(bw), unsafe { (*it).body }, in_rej, is_ct_fn);
    }
}

pub fn typeck_check_safety_profile(
    hir_file: view<HirFile>,
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    interner: view<StrInterner>,
    safety_profile: u32,
    pkg_forbid_unsafe: bool,
    user_fids: *const u32,
    user_fid_count: usize
) {
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let is_sandbox = safety_profile == TY_SAFETY_PROFILE_SANDBOX;

    // 1. Collect module-level `@forbid_unsafe` declarations and validate module policy attributes
    let mut mod_cap: usize = 0;
    let mut it_cnt: *mut HirItem = hir_file.items;
    while (it_cnt as usize) != 0 {
        if (unsafe { (*it_cnt).kind }) == HIR_ITEM_MODULE &&
           sec_is_user_item(interner, it_cnt as *const HirItem, user_fids, user_fid_count) {
            mod_cap = mod_cap + 1;
        }
        it_cnt = unsafe { (*it_cnt).next };
    }

    let forbid_mods: *mut SecForbidMod = if mod_cap > 0 {
        let mbytes = mul_usize(mod_cap, size_of<SecForbidMod>());
        let raw = arena_alloc_raw(mut_view(sink.arena), mbytes, align_of<SecForbidMod>());
        tc_zero_bytes(raw, mbytes);
        raw as *mut SecForbidMod
    } else {
        0 as *mut SecForbidMod
    };
    let mut forbid_mod_count: usize = 0;

    let mut it_m1: *mut HirItem = hir_file.items;
    while (it_m1 as usize) != 0 {
        if (unsafe { (*it_m1).kind }) == HIR_ITEM_MODULE &&
           sec_is_user_item(interner, it_m1 as *const HirItem, user_fids, user_fid_count) {
            let mut hf = false;
            let mut fsp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
            let mut ha = false;
            let mut asp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
            sec_scan_policy_attrs(
                interner,
                mut_view(*sink),
                unsafe { (*it_m1).attrs },
                true,
                mut_view(hf),
                mut_view(fsp),
                mut_view(ha),
                mut_view(asp)
            );
            if hf && forbid_mod_count < mod_cap {
                let slot = unsafe { sec_forbid_mod_at(forbid_mods, forbid_mod_count) };
                unsafe {
                    (*slot).mod_path = (*it_m1).mod_path;
                    (*slot).file_v = (*it_m1).span.file.v;
                    (*slot).attr_span = fsp;
                }
                forbid_mod_count = forbid_mod_count + 1;
            }
        }
        it_m1 = unsafe { (*it_m1).next };
    }

    // Check module-level `@allow_unsafe` monotonic non-escalation against profile, package, or parent modules
    let mut it_m2: *mut HirItem = hir_file.items;
    while (it_m2 as usize) != 0 {
        if (unsafe { (*it_m2).kind }) == HIR_ITEM_MODULE &&
           sec_is_user_item(interner, it_m2 as *const HirItem, user_fids, user_fid_count) {
            let mut cur_at: *mut HirAttr = unsafe { (*it_m2).attrs };
            while (cur_at as usize) != 0 {
                let sv = interner_get(interner, StrId { v: unsafe { (*cur_at).name.v } });
                if fre_sv_eq_str(view(sv), "allow_unsafe") && (unsafe { (*cur_at).args as usize }) == 0 {
                    if sec_is_item_mod_forbidden(
                        interner,
                        it_m2 as *const HirItem,
                        forbid_mods as *const SecForbidMod,
                        forbid_mod_count,
                        safety_profile,
                        pkg_forbid_unsafe
                    ) {
                        sec_report_1data_diag(
                            mut_view(*sink),
                            AX_SEC_CONFLICTING_SAFETY_POLICY,
                            unsafe { (*cur_at).span },
                            "policy",
                            "allow_unsafe"
                        );
                    }
                }
                cur_at = unsafe { (*cur_at).next };
            }
        }
        it_m2 = unsafe { (*it_m2).next };
    }

    // 2. Build OS authority call graph for `sandbox` and `comptime` verification
    let os_graph = sec_os_graph_build(mut_view(sink.arena), hir_file, thir, interner, user_fids, user_fid_count);

    // 3. Walk all user items and members
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        if sec_is_user_item(interner, it as *const HirItem, user_fids, user_fid_count) &&
           !fre_is_synth_fn_clone(hir_file, thir_ptr, it as *const HirItem, true) &&
           !sec_is_extern_block_clone(hir_file, it as *const HirItem) {
            let ik = unsafe { (*it).kind };
            if ik != HIR_ITEM_MODULE {
                let mod_forbid = sec_is_item_mod_forbidden(
                    interner,
                    it as *const HirItem,
                    forbid_mods as *const SecForbidMod,
                    forbid_mod_count,
                    safety_profile,
                    pkg_forbid_unsafe
                );
                let mut hf = false;
                let mut fsp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                let mut ha = false;
                let mut asp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                sec_scan_policy_attrs(
                    interner,
                    mut_view(*sink),
                    unsafe { (*it).attrs },
                    true,
                    mut_view(hf),
                    mut_view(fsp),
                    mut_view(ha),
                    mut_view(asp)
                );
                let item_forbid = mod_forbid || hf;
                if ha && item_forbid {
                    sec_report_1data_diag(mut_view(*sink), AX_SEC_CONFLICTING_SAFETY_POLICY, asp, "policy", "allow_unsafe");
                }

                sec_check_single_item(
                    hir_file,
                    thir,
                    interner,
                    mut_view(*sink),
                    view(os_graph),
                    it as *const HirItem,
                    item_forbid,
                    is_sandbox
                );

                if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
                    let is_ext_blk = ik == HIR_ITEM_EXTERN_BLOCK;
                    let mut m: *mut HirItem = unsafe { (*it).members };
                    while (m as usize) != 0 {
                        if !fre_is_synth_fn_clone(hir_file, thir_ptr, m as *const HirItem, false) {
                            let mut m_hf = false;
                            let mut m_fsp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                            let mut m_ha = false;
                            let mut m_asp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                            sec_scan_policy_attrs(
                                interner,
                                mut_view(*sink),
                                unsafe { (*m).attrs },
                                true,
                                mut_view(m_hf),
                                mut_view(m_fsp),
                                mut_view(m_ha),
                                mut_view(m_asp)
                            );
                            let mem_forbid = item_forbid || m_hf;
                            if m_ha && mem_forbid {
                                sec_report_1data_diag(mut_view(*sink), AX_SEC_CONFLICTING_SAFETY_POLICY, m_asp, "policy", "allow_unsafe");
                            }
                            if !is_ext_blk {
                                sec_check_single_item(
                                    hir_file,
                                    thir,
                                    interner,
                                    mut_view(*sink),
                                    view(os_graph),
                                    m as *const HirItem,
                                    mem_forbid,
                                    is_sandbox
                                );
                            }
                        }
                        m = unsafe { (*m).next };
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
}

fn sec_is_extern_block_clone(hir_file: view<HirFile>, it: *const HirItem) -> bool {
    if (it as usize) == 0 || (unsafe { (*it).kind }) != HIR_ITEM_FN || (unsafe { (*it).body as usize }) != 0 {
        return false;
    }
    let sym_v = unsafe { (*it).symbol.v };
    let sp_f = unsafe { (*it).span.file.v };
    let sp_s = unsafe { (*it).span.start };
    let sp_e = unsafe { (*it).span.end };
    let mut cur: *mut HirItem = hir_file.items;
    while (cur as usize) != 0 {
        if (unsafe { (*cur).kind }) == HIR_ITEM_EXTERN_BLOCK {
            let mut m: *mut HirItem = unsafe { (*cur).members };
            while (m as usize) != 0 {
                if (m as *const HirItem) != it && (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    let m_sym = unsafe { (*m).symbol.v };
                    if sym_v != 0u32 && m_sym == sym_v {
                        return true;
                    }
                    if sp_f != 0u32 &&
                       (unsafe { (*m).span.file.v }) == sp_f &&
                       (unsafe { (*m).span.start }) == sp_s &&
                       (unsafe { (*m).span.end }) == sp_e {
                        return true;
                    }
                }
                m = unsafe { (*m).next };
            }
        }
        cur = unsafe { (*cur).next };
    }
    false
}

fn sec_expr_max_end(ex: *mut HirExpr) -> u32 {
    let mut e: u32 = 0u32;
    let mut cur = ex;
    while (cur as usize) != 0 {
        let ce = unsafe { (*cur).span.end };
        if ce > e {
            e = ce;
        }
        let ek = unsafe { (*cur).kind };
        if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_LOOP || ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_COMPTIME {
            let be = sec_block_max_end(unsafe { (*cur).block });
            if be > e { e = be; }
        } else if ek == HIR_EXPR_IF {
            let c1 = sec_expr_max_end(unsafe { (*cur).cond });
            let b1 = sec_block_max_end(unsafe { (*cur).block });
            let e1 = sec_expr_max_end(unsafe { (*cur).else_branch });
            if c1 > e { e = c1; }
            if b1 > e { e = b1; }
            if e1 > e { e = e1; }
        } else if ek == HIR_EXPR_WHILE {
            let c1 = sec_expr_max_end(unsafe { (*cur).cond });
            let b1 = sec_block_max_end(unsafe { (*cur).block });
            if c1 > e { e = c1; }
            if b1 > e { e = b1; }
        } else if ek == HIR_EXPR_FOR {
            let i1 = sec_expr_max_end(unsafe { (*cur).iter });
            let b1 = sec_block_max_end(unsafe { (*cur).block });
            if i1 > e { e = i1; }
            if b1 > e { e = b1; }
        } else if ek == HIR_EXPR_MATCH {
            let c1 = sec_expr_max_end(unsafe { (*cur).cond });
            if c1 > e { e = c1; }
            let mut arm: *mut HirMatchArm = unsafe { (*cur).arms };
            while (arm as usize) != 0 {
                let ae = unsafe { (*arm).span.end };
                let ab = sec_expr_max_end(unsafe { (*arm).body });
                if ae > e { e = ae; }
                if ab > e { e = ab; }
                arm = unsafe { (*arm).next };
            }
        } else if ek == HIR_EXPR_UNARY || ek == HIR_EXPR_VIEW || ek == HIR_EXPR_JUMP || ek == HIR_EXPR_CAST || ek == HIR_EXPR_TRY || ek == HIR_EXPR_AWAIT {
            let ie = sec_expr_max_end(unsafe { (*cur).inner });
            if ie > e { e = ie; }
        } else if ek == HIR_EXPR_BINARY {
            let le = sec_expr_max_end(unsafe { (*cur).left });
            let re = sec_expr_max_end(unsafe { (*cur).right });
            if le > e { e = le; }
            if re > e { e = re; }
        } else if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
            let be = sec_expr_max_end(unsafe { (*cur).base });
            if be > e { e = be; }
        } else if ek == HIR_EXPR_INDEX {
            let be = sec_expr_max_end(unsafe { (*cur).base });
            let ie = sec_expr_max_end(unsafe { (*cur).index_arg });
            if be > e { e = be; }
            if ie > e { e = ie; }
        } else if ek == HIR_EXPR_CALL {
            let ce2 = sec_expr_max_end(unsafe { (*cur).callee });
            let ae2 = sec_expr_max_end(unsafe { (*cur).args });
            if ce2 > e { e = ce2; }
            if ae2 > e { e = ae2; }
        } else if ek == HIR_EXPR_METHOD_CALL {
            let re2 = sec_expr_max_end(unsafe { (*cur).receiver });
            let ae2 = sec_expr_max_end(unsafe { (*cur).args });
            if re2 > e { e = re2; }
            if ae2 > e { e = ae2; }
        } else if ek == HIR_EXPR_CLOSURE {
            let be = sec_expr_max_end(unsafe { (*cur).body });
            if be > e { e = be; }
        }
        cur = unsafe { (*cur).next };
    }
    e
}

fn sec_block_max_end(b: *mut HirBlock) -> u32 {
    if (b as usize) == 0 {
        return 0u32;
    }
    let mut e = unsafe { (*b).span.end };
    let mut s: *mut HirStmt = unsafe { (*b).stmts };
    while (s as usize) != 0 {
        let se = unsafe { (*s).span.end };
        if se > e {
            e = se;
        }
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let ee = sec_expr_max_end(unsafe { (*s).expr });
            let eb = sec_block_max_end(unsafe { (*s).else_block });
            if ee > e { e = ee; }
            if eb > e { e = eb; }
        } else if sk == HIR_STMT_ASSIGN {
            let le = sec_expr_max_end(unsafe { (*s).left });
            let re = sec_expr_max_end(unsafe { (*s).right });
            if le > e { e = le; }
            if re > e { e = re; }
        } else if sk == HIR_STMT_EXPR {
            let ee = sec_expr_max_end(unsafe { (*s).expr });
            if ee > e { e = ee; }
        }
        s = unsafe { (*s).next };
    }
    e
}

fn sec_item_file_v(it: *const HirItem) -> u32 {
    let fv = unsafe { (*it).span.file.v };
    if fv != 0u32 {
        return fv;
    }
    let mut a: *mut HirAttr = unsafe { (*it).attrs };
    while (a as usize) != 0 {
        let afv = unsafe { (*a).span.file.v };
        if afv != 0u32 {
            return afv;
        }
        a = unsafe { (*a).next };
    }
    let mut m: *mut HirItem = unsafe { (*it).members };
    while (m as usize) != 0 {
        let mfv = unsafe { (*m).span.file.v };
        if mfv != 0u32 {
            return mfv;
        }
        m = unsafe { (*m).next };
    }
    0u32
}

fn sec_item_full_start(it: *const HirItem) -> u32 {
    let mut s = unsafe { (*it).span.start };
    let mut a: *mut HirAttr = unsafe { (*it).attrs };
    while (a as usize) != 0 {
        let as_v = unsafe { (*a).span.start };
        if s == 0u32 || as_v < s {
            s = as_v;
        }
        a = unsafe { (*a).next };
    }
    s
}

fn sec_item_full_end(it: *const HirItem) -> u32 {
    let mut e = unsafe { (*it).span.end };
    let be = sec_block_max_end(unsafe { (*it).body });
    if be > e {
        e = be;
    }
    let ee = sec_expr_max_end(unsafe { (*it).expr });
    if ee > e {
        e = ee;
    }
    let ik = unsafe { (*it).kind };
    if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
        let mut m: *mut HirItem = unsafe { (*it).members };
        while (m as usize) != 0 {
            let me = sec_item_full_end(m as *const HirItem);
            if me > e {
                e = me;
            }
            m = unsafe { (*m).next };
        }
    }
    e
}

fn sec_span_in_forbid_unsafe_scope(
    hir_file: view<HirFile>,
    interner: view<StrInterner>,
    forbid_mods: *const SecForbidMod,
    forbid_mod_count: usize,
    safety_profile: u32,
    pkg_forbid_unsafe: bool,
    user_fids: *const u32,
    user_fid_count: usize,
    sp: Span
) -> bool {
    let sp_f = sp.file.v;
    let sp_s = sp.start;
    let sp_e = sp.end;
    if sp_f == 0u32 {
        return false;
    }
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        if sec_is_user_item(interner, it as *const HirItem, user_fids, user_fid_count) &&
           (unsafe { (*it).kind }) != HIR_ITEM_MODULE {
            let mod_f = sec_is_item_mod_forbidden(
                interner,
                it as *const HirItem,
                forbid_mods,
                forbid_mod_count,
                safety_profile,
                pkg_forbid_unsafe
            );
            let it_f_v = sec_item_file_v(it as *const HirItem);
            if mod_f && it_f_v == sp_f {
                return true;
            }
            let mut f_at: *mut HirAttr = 0 as *mut HirAttr;
            let it_f = mod_f || fre_item_has_attr_name(interner, unsafe { (*it).attrs }, "forbid_unsafe", mut_view(f_at));
            if it_f && it_f_v == sp_f && sp_s >= sec_item_full_start(it as *const HirItem) && sp_e <= sec_item_full_end(it as *const HirItem) {
                return true;
            }
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    let mut mf_at: *mut HirAttr = 0 as *mut HirAttr;
                    let mem_f = it_f || fre_item_has_attr_name(interner, unsafe { (*m).attrs }, "forbid_unsafe", mut_view(mf_at));
                    let m_f_v = sec_item_file_v(m as *const HirItem);
                    if mem_f && m_f_v == sp_f && sp_s >= sec_item_full_start(m as *const HirItem) && sp_e <= sec_item_full_end(m as *const HirItem) {
                        return true;
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

pub fn typeck_dedup_unsafe_diags_under_forbid(
    hir_file: view<HirFile>,
    sink: mut_view<DiagSink>,
    interner: view<StrInterner>,
    from_diag_idx: usize,
    safety_profile: u32,
    pkg_forbid_unsafe: bool,
    user_fids: *const u32,
    user_fid_count: usize
) {
    if sink.len <= from_diag_idx || (sink.diags as usize) == 0 {
        return;
    }
    let mut mod_cap: usize = 0;
    let mut it_cnt: *mut HirItem = hir_file.items;
    while (it_cnt as usize) != 0 {
        if (unsafe { (*it_cnt).kind }) == HIR_ITEM_MODULE &&
           sec_is_user_item(interner, it_cnt as *const HirItem, user_fids, user_fid_count) {
            mod_cap = mod_cap + 1;
        }
        it_cnt = unsafe { (*it_cnt).next };
    }
    let forbid_mods: *mut SecForbidMod = if mod_cap > 0 {
        let mbytes = mul_usize(mod_cap, size_of<SecForbidMod>());
        let raw = arena_alloc_raw(mut_view(sink.arena), mbytes, align_of<SecForbidMod>());
        tc_zero_bytes(raw, mbytes);
        raw as *mut SecForbidMod
    } else {
        0 as *mut SecForbidMod
    };
    let mut forbid_mod_count: usize = 0;
    let mut it_m: *mut HirItem = hir_file.items;
    while (it_m as usize) != 0 {
        if (unsafe { (*it_m).kind }) == HIR_ITEM_MODULE &&
           sec_is_user_item(interner, it_m as *const HirItem, user_fids, user_fid_count) {
            let mut f_at: *mut HirAttr = 0 as *mut HirAttr;
            if fre_item_has_attr_name(interner, unsafe { (*it_m).attrs }, "forbid_unsafe", mut_view(f_at)) &&
               (unsafe { (*f_at).args as usize }) == 0 &&
               forbid_mod_count < mod_cap {
                let slot = unsafe { sec_forbid_mod_at(forbid_mods, forbid_mod_count) };
                unsafe {
                    (*slot).mod_path = (*it_m).mod_path;
                    (*slot).file_v = (*it_m).span.file.v;
                    (*slot).attr_span = (*f_at).span;
                }
                forbid_mod_count = forbid_mod_count + 1;
            }
        }
        it_m = unsafe { (*it_m).next };
    }

    let dsz = size_of<Diagnostic>();
    let mut i: usize = from_diag_idx;
    while i < sink.len {
        let dp = ((sink.diags as usize) + mul_usize(i, dsz)) as *mut Diagnostic;
        let cv = unsafe { (*dp).code.v };
        let psp = unsafe { (*dp).primary };
        if (cv == AX_UNSAFE_REQUIRED || cv == AX_CONC_UNSYNC_STATIC) &&
           sec_span_in_forbid_unsafe_scope(
               hir_file,
               interner,
               forbid_mods as *const SecForbidMod,
               forbid_mod_count,
               safety_profile,
               pkg_forbid_unsafe,
               user_fids,
               user_fid_count,
               psp
           ) {
            let mut j: usize = i;
            while j + 1 < sink.len {
                let dst = ((sink.diags as usize) + mul_usize(j, dsz)) as *mut Diagnostic;
                let src = ((sink.diags as usize) + mul_usize(j + 1, dsz)) as *mut Diagnostic;
                unsafe { *dst = *src; }
                j = j + 1;
            }
            sink.len = sink.len - 1;
            if sink.errors > 0 {
                sink.errors = sink.errors - 1;
            }
            continue;
        }
        i = i + 1;
    }
}
