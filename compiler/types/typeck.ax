pub fn patch_unknown_intrinsic_diag_buf(sink: view<DiagSink>, buf: mut_view<DiagBuffer>) {
    let blen = buf.len;
    let slen = sink.len;
    if slen == 0 || (sink.diags as usize) == 0 || blen < 9 || (buf.ptr as usize) == 0 {
        return;
    }
    let mut has_ext_code = false;
    let mut di: usize = 0;
    while di < slen {
        let dp = ((sink.diags as usize) + mul_usize(di, size_of<Diagnostic>())) as *const Diagnostic;
        let cv = unsafe { (*dp).code.v };
        if (cv >= 133u32 && cv <= 136u32) || (cv >= 142u32 && cv <= 144u32) || (cv >= 149u32 && cv <= 152u32) || (cv >= 156u32 && cv <= 165u32) {
            has_ext_code = true;
            break;
        }
        di = di + 1;
    }
    if !has_ext_code {
        return;
    }
    let mut out = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut i: usize = 0;
    let mut next_di: usize = 0;
    while i < blen {
        if i + 9 <= blen &&
           unsafe { *(buf.ptr + i + 0) == 60u8 && *(buf.ptr + i + 1) == 117u8 && *(buf.ptr + i + 2) == 110u8 &&
                    *(buf.ptr + i + 3) == 107u8 && *(buf.ptr + i + 4) == 110u8 && *(buf.ptr + i + 5) == 111u8 &&
                    *(buf.ptr + i + 6) == 119u8 && *(buf.ptr + i + 7) == 110u8 && *(buf.ptr + i + 8) == 62u8 } {
            let mut match_cv: u32 = 0u32;
            while next_di < slen {
                let dp = ((sink.diags as usize) + mul_usize(next_di, size_of<Diagnostic>())) as *const Diagnostic;
                let cv = unsafe { (*dp).code.v };
                next_di = next_di + 1;
                if cv >= 133u32 {
                    match_cv = cv;
                    break;
                }
            }
            if match_cv == 134u32 {
                let mut k: usize = 0;
                while k < 16 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_NOT_SEND_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 135u32 {
                let mut k: usize = 0;
                while k < 17 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_NOT_SHARE_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 136u32 {
                let mut k: usize = 0;
                while k < 28 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_SAFE_IMPL_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 142u32 {
                let mut k: usize = 0;
                while k < 24 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_CAPTURE_NOT_SEND_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 143u32 {
                let mut k: usize = 0;
                while k < 21 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_ESCAPING_VIEW_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 144u32 {
                let mut k: usize = 0;
                while k < 27 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_SPAWN_MOVE_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 149u32 {
                let mut k: usize = 0;
                while k < 23 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_ATOMIC_MUT_VIEW_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 150u32 {
                let mut k: usize = 0;
                while k < 27 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_INVALID_ATOMIC_TYPE_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 151u32 {
                let mut k: usize = 0;
                while k < 31 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_INVALID_ATOMIC_ORDERING_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 152u32 {
                let mut k: usize = 0;
                while k < 32 {
                    diag_buf_push_byte(mut_view(out), TC_CONC_INVALID_ATOMIC_ALIGNMENT_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 133u32 {
                let mut k: usize = 0;
                while k < 25 {
                    diag_buf_push_byte(mut_view(out), TC_UNKNOWN_INTR_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv >= 156u32 && match_cv <= 165u32 {
                let c_idx: usize = (match_cv - 156u32) as usize;
                let mut k: usize = TC_ASYNC_CODE_NAMES_OFF[c_idx];
                let k_end: usize = TC_ASYNC_CODE_NAMES_OFF[c_idx + 1];
                while k < k_end {
                    diag_buf_push_byte(mut_view(out), TC_ASYNC_CODE_NAMES_DATA[k]);
                    k = k + 1;
                }
            } else if match_cv == AX_TYPE_INVALID_TLS_DECL {
                let mut k: usize = 0;
                while k < 24 {
                    diag_buf_push_byte(mut_view(out), TC_INVALID_TLS_DECL_CODE_NAME[k]);
                    k = k + 1;
                }
            } else {
                let mut k: usize = 0;
                while k < 9 {
                    diag_buf_push_byte(mut_view(out), unsafe { *(buf.ptr + i + k) });
                    k = k + 1;
                }
            }
            i = i + 9;
        } else {
            diag_buf_push_byte(mut_view(out), unsafe { *(buf.ptr + i) });
            i = i + 1;
        }
    }
    if buf.cap > 0 && (buf.ptr as usize) != 0 {
        unsafe { heap_free(buf.ptr, buf.cap, 1); }
    }
    buf.ptr = out.ptr;
    buf.len = out.len;
    buf.cap = out.cap;
}

fn type_error_sp(cx: mut_view<TypeckCtx>, file_v: u32, start: u32, end: u32, code_v: u32) -> TypeId {
    if (cx.sink as usize) != 0 {
        unsafe { report_typeck_diag(mut_view(*cx.sink), code_v, file_v, start, end); }
    }
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    (TypeId { v: err_v })
}

fn type_error(cx: mut_view<TypeckCtx>, sp: view<Span>, code_v: u32) -> TypeId {
    type_error_sp(mut_view(*cx), sp.file.v, sp.start, sp.end, code_v)
}

// T497 (SPEC-40 AXS-INT-053 rule 1, AXS-INT-060 row 2014): message of AX_TYPE_INDEX_NOT_INT,
// `index must be an integer, found <type word>` (the type word is the kind of the index type: the interner has no
// type printer in this stage). Prefix = bytes 0..32, word i = TC_IDX_MSG_OFF[i]..TC_IDX_MSG_OFF[i + 1].
const TC_IDX_MSG_DATA: [95]u8 = [
    105u8, 110u8, 100u8, 101u8, 120u8, 32u8, 109u8, 117u8, 115u8, 116u8, 32u8, 98u8, 101u8, 32u8, 97u8, 110u8,
    32u8, 105u8, 110u8, 116u8, 101u8, 103u8, 101u8, 114u8, 44u8, 32u8, 102u8, 111u8, 117u8, 110u8, 100u8, 32u8,
    98u8, 111u8, 111u8, 108u8, 99u8, 104u8, 97u8, 114u8, 83u8, 116u8, 114u8, 116u8, 117u8, 112u8, 108u8, 101u8,
    115u8, 116u8, 114u8, 117u8, 99u8, 116u8, 101u8, 110u8, 117u8, 109u8, 102u8, 110u8, 118u8, 105u8, 101u8, 119u8,
    112u8, 111u8, 105u8, 110u8, 116u8, 101u8, 114u8, 97u8, 114u8, 114u8, 97u8, 121u8, 115u8, 108u8, 105u8, 99u8,
    101u8, 117u8, 110u8, 105u8, 116u8, 102u8, 108u8, 111u8, 97u8, 116u8, 118u8, 97u8, 108u8, 117u8, 101u8,
];

// word index: 0 bool, 1 char, 2 Str, 3 tuple, 4 struct, 5 enum, 6 fn, 7 view, 8 pointer, 9 array, 10 slice,
// 11 unit, 12 float, 13 value
const TC_IDX_MSG_OFF: [15]usize = [
    32, 36, 40, 43, 48, 54, 58, 60, 64, 71, 76, 81, 85, 90, 95
];

const TC_IDX_WORD_FLOAT: usize = 12;

fn tc_index_word(k: u8) -> usize {
    if k == TY_BOOL { return 0; }
    if k == TY_CHAR { return 1; }
    if k == TY_STR { return 2; }
    if k == TY_TUPLE { return 3; }
    if k == TY_STRUCT { return 4; }
    if k == TY_ENUM { return 5; }
    if k == TY_FN { return 6; }
    if k == TY_VIEW || k == TY_MUT_VIEW { return 7; }
    if k == TY_PTR { return 8; }
    if k == TY_ARRAY { return 9; }
    if k == TY_SLICE { return 10; }
    if k == TY_UNIT { return 11; }
    if k == TY_F32 || k == TY_F64 || k == TY_FLOAT_VAR { return 12; }
    13
}

fn tc_alloc_index_msg(arena: mut_view<Arena>, word: usize) -> StrView {
    let ws = TC_IDX_MSG_OFF[word] as usize;
    let we = TC_IDX_MSG_OFF[word + 1] as usize;
    let n = 32 + (we - ws);
    let dst = arena_alloc_raw(arena, n + 1, 1);
    let mut i: usize = 0;
    while i < 32 {
        unsafe { *(dst + i) = TC_IDX_MSG_DATA[i]; }
        i = i + 1;
    }
    let mut j: usize = ws;
    while j < we {
        unsafe { *(dst + i) = TC_IDX_MSG_DATA[j]; }
        i = i + 1;
        j = j + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

// Emits AX_TYPE_INDEX_NOT_INT with the primary span on the index expression and the message that names the
// offending type word.
fn type_error_index_not_int(cx: mut_view<TypeckCtx>, sp: view<Span>, word: usize) -> TypeId {
    let before: usize = if (cx.sink as usize) != 0 { unsafe { (*cx.sink).len } } else { 0 };
    let r = type_error(mut_view(*cx), sp, AX_TYPE_INDEX_NOT_INT);
    if (cx.sink as usize) != 0 {
        let sink: *mut DiagSink = cx.sink;
        let after: usize = unsafe { (*sink).len };
        if after > before && (unsafe { (*sink).diags } as usize) != 0 {
            let dp = ((unsafe { (*sink).diags } as usize) + mul_usize(after - 1, size_of<Diagnostic>())) as *mut Diagnostic;
            let m = unsafe { tc_alloc_index_msg(mut_view((*sink).arena), word) };
            unsafe {
                (*dp).message.ptr = m.ptr;
                (*dp).message.len = m.len;
            }
        }
    }
    r
}

// Checks the operand of an array/slice/str subscript (single index, or one bound of a range index). Integer
// literals (IntVar) default to usize. Returns false when the operand is erroneous (already reported). A float
// literal is reported here directly because float types do not exist in this stage (E12.2), so
// `check_expr` would otherwise report AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP for it.
fn check_index_operand(cx: mut_view<TypeckCtx>, ie: *mut HirExpr) -> bool {
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    if unsafe { (*ie).kind } == HIR_EXPR_LITERAL && unsafe { (*ie).literal.kind } == TOK_FLOAT {
        type_error_index_not_int(mut_view(*cx), unsafe { view((*ie).span) }, TC_IDX_WORD_FLOAT);
        return false;
    }
    let raw = check_expr(mut_view(*cx), ie, (TypeId { v: 0u32 }));
    let ty = resolve_ty(mut_view(*cx), (TypeId { v: raw.v }));
    if is_error(mut_view(*cx), (TypeId { v: ty.v })) { return false; }
    let k = kind_of(mut_view(*cx), (TypeId { v: ty.v }));
    if k == TY_INT_VAR {
        unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: usize_v }));
        return true;
    }
    if !unsafe { type_is_int((TypeId { v: ty.v }), view((*cx.thir).interner)) } {
        type_error_index_not_int(mut_view(*cx), unsafe { view((*ie).span) }, tc_index_word(k));
        return false;
    }
    true
}

fn resolve_ty(cx: mut_view<TypeckCtx>, id: TypeId) -> TypeId {
    unsafe {
        type_vars_resolve(mut_view(cx.type_vars), view((*cx.thir).interner), (TypeId { v: id.v }))
    }
}

fn unify_ty(cx: mut_view<TypeckCtx>, a: TypeId, b: TypeId) -> bool {
    unsafe {
        type_vars_unify(mut_view(cx.type_vars), view((*cx.thir).interner), (TypeId { v: a.v }), (TypeId { v: b.v }))
    }
}

fn kind_of(cx: mut_view<TypeckCtx>, id: TypeId) -> u8 {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    if r.v == 0u32 { return TY_ERROR; }
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r.v })) };
    if (t as usize) == 0 { return TY_ERROR; }
    unsafe { (*t).kind }
}

fn is_error(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    r.v == err_v
}

fn is_never(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    let nev_v = unsafe { (*cx.thir).interner.t_never.v };
    r.v == nev_v
}

fn is_intlike(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    if r.v == 0u32 { return false; }
    let is_i = unsafe { type_is_int((TypeId { v: r.v }), view((*cx.thir).interner)) };
    if is_i { return true; }
    kind_of(mut_view(*cx), (TypeId { v: r.v })) == TY_INT_VAR
}

fn new_int_var(cx: mut_view<TypeckCtx>) -> TypeId {
    unsafe {
        type_vars_new_int_var(mut_view(cx.type_vars), mut_view((*cx.thir).interner))
    }
}

fn new_float_var(cx: mut_view<TypeckCtx>) -> TypeId {
    unsafe {
        type_vars_new_float_var(mut_view(cx.type_vars), mut_view((*cx.thir).interner))
    }
}

// T457: f32, f64 or an unsuffixed float literal variable.
fn is_floatlike(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let k = kind_of(mut_view(*cx), (TypeId { v: id.v }));
    k == TY_F32 || k == TY_F64 || k == TY_FLOAT_VAR
}

fn new_ty_var(cx: mut_view<TypeckCtx>, sp: view<Span>) -> TypeId {
    unsafe {
        type_vars_new_ty_var(mut_view(cx.type_vars), mut_view((*cx.thir).interner), sp)
    }
}

fn push_lit_check(cx: mut_view<TypeckCtx>, sp: view<Span>, value: u64, value_hi: u64, ty: TypeId) {
    if cx.lits_len == cx.lits_cap {
        let new_cap: usize = if cx.lits_cap == 0 { 16 } else { mul_usize(cx.lits_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<LitCheck>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<LitCheck>()) as *mut LitCheck };
        if cx.lits_len > 0 && (cx.lits as usize) != 0 {
            let old_bytes = mul_usize(cx.lits_len, size_of<LitCheck>());
            let cap_bytes = mul_usize(cx.lits_cap, size_of<LitCheck>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.lits as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.lits as *mut u8, cap_bytes, align_of<LitCheck>());
            }
        }
        cx.lits = new_arr;
        cx.lits_cap = new_cap;
    }
    let e = unsafe { litcheck_at(cx.lits, cx.lits_len) };
    unsafe {
        (*e).span.file.v = sp.file.v;
        (*e).span.start = sp.start;
        (*e).span.end = sp.end;
        (*e).neg_span.file.v = sp.file.v;
        (*e).neg_span.start = sp.start;
        (*e).neg_span.end = sp.end;
        (*e).value = value;
        (*e).value_hi = value_hi;
        (*e).ty.v = ty.v;
        (*e).negated = false;
        (*e).unary = 0 as *mut HirExpr;
        (*e).float_flags = 0u8;
    }
    cx.lits_len = cx.lits_len + 1;
}

fn push_neg_check(cx: mut_view<TypeckCtx>, sp: view<Span>, ty: TypeId) {
    if cx.negs_len == cx.negs_cap {
        let new_cap: usize = if cx.negs_cap == 0 { 16 } else { mul_usize(cx.negs_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<NegCheck>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<NegCheck>()) as *mut NegCheck };
        if cx.negs_len > 0 && (cx.negs as usize) != 0 {
            let old_bytes = mul_usize(cx.negs_len, size_of<NegCheck>());
            let cap_bytes = mul_usize(cx.negs_cap, size_of<NegCheck>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.negs as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.negs as *mut u8, cap_bytes, align_of<NegCheck>());
            }
        }
        cx.negs = new_arr;
        cx.negs_cap = new_cap;
    }
    let e = unsafe { negcheck_at(cx.negs, cx.negs_len) };
    unsafe {
        (*e).span.file.v = sp.file.v;
        (*e).span.start = sp.start;
        (*e).span.end = sp.end;
        (*e).ty.v = ty.v;
    }
    cx.negs_len = cx.negs_len + 1;
}

fn push_var_state(cx: mut_view<TypeckCtx>, sym: SymbolId, is_mut: bool, is_init: bool) {
    if cx.vars_len == cx.vars_cap {
        let new_cap: usize = if cx.vars_cap == 0 { 16 } else { mul_usize(cx.vars_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<VarState>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<VarState>()) as *mut VarState };
        if cx.vars_len > 0 && (cx.vars as usize) != 0 {
            let old_bytes = mul_usize(cx.vars_len, size_of<VarState>());
            let cap_bytes = mul_usize(cx.vars_cap, size_of<VarState>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.vars as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.vars as *mut u8, cap_bytes, align_of<VarState>());
            }
        }
        cx.vars = new_arr;
        cx.vars_cap = new_cap;
    }
    let e = unsafe { varstate_at(cx.vars, cx.vars_len) };
    unsafe {
        (*e).sym.v = sym.v;
        (*e).is_mut = is_mut;
        (*e).is_init = is_init;
        (*e).is_placed = false;
    }
    cx.vars_len = cx.vars_len + 1;
}

fn push_loop_env(cx: mut_view<TypeckCtx>, label: StrId, break_ty: TypeId) {
    if cx.loops_len == cx.loops_cap {
        let new_cap: usize = if cx.loops_cap == 0 { 8 } else { mul_usize(cx.loops_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<LoopEnv>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<LoopEnv>()) as *mut LoopEnv };
        if cx.loops_len > 0 && (cx.loops as usize) != 0 {
            let old_bytes = mul_usize(cx.loops_len, size_of<LoopEnv>());
            let cap_bytes = mul_usize(cx.loops_cap, size_of<LoopEnv>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.loops as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.loops as *mut u8, cap_bytes, align_of<LoopEnv>());
            }
        }
        cx.loops = new_arr;
        cx.loops_cap = new_cap;
    }
    let e = unsafe { loopenv_at(cx.loops, cx.loops_len) };
    unsafe {
        (*e).label.v = label.v;
        (*e).break_ty.v = break_ty.v;
        (*e).has_break = false;
    }
    cx.loops_len = cx.loops_len + 1;
}

fn push_const_stack(cx: mut_view<TypeckCtx>, sym: SymbolId) {
    if cx.const_eval_stack_len == cx.const_eval_stack_cap {
        let new_cap: usize = if cx.const_eval_stack_cap == 0 { 8 } else { mul_usize(cx.const_eval_stack_cap, 2) };
        let new_bytes = mul_usize(new_cap, size_of<SymbolId>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<SymbolId>()) as *mut SymbolId };
        if cx.const_eval_stack_len > 0 && (cx.const_eval_stack as usize) != 0 {
            let old_bytes = mul_usize(cx.const_eval_stack_len, size_of<SymbolId>());
            let cap_bytes = mul_usize(cx.const_eval_stack_cap, size_of<SymbolId>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(cx.const_eval_stack as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(cx.const_eval_stack as *mut u8, cap_bytes, align_of<SymbolId>());
            }
        }
        cx.const_eval_stack = new_arr;
        cx.const_eval_stack_cap = new_cap;
    }
    let e = unsafe { symid_at(cx.const_eval_stack, cx.const_eval_stack_len) };
    unsafe { (*e).v = sym.v; }
    cx.const_eval_stack_len = cx.const_eval_stack_len + 1;
}

pub fn coerce(cx: mut_view<TypeckCtx>, from: TypeId, to: TypeId, sp: view<Span>) -> TypeId {
    if to.v == 0u32 {
        return (TypeId { v: from.v });
    }
    if from.v != 0u32 && to.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: from.v })) && !is_error(mut_view(*cx), (TypeId { v: to.v })) {
        let rf = resolve_ty(mut_view(*cx), (TypeId { v: from.v }));
        let rt = resolve_ty(mut_view(*cx), (TypeId { v: to.v }));
        let tf = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rf.v })) };
        let tt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rt.v })) };
        if (tf as usize) != 0 && (tt as usize) != 0 {
            let k_f = unsafe { (*tf).kind };
            let k_t = unsafe { (*tt).kind };
            let pt_f = unsafe { (*tf).pointee.v };
            let pt_t = unsafe { (*tt).pointee.v };
            if (k_f == TY_VIEW || k_f == TY_MUT_VIEW) && k_t == TY_VIEW {
                if unify_ty(mut_view(*cx), (TypeId { v: pt_f }), (TypeId { v: pt_t })) {
                    return (TypeId { v: to.v });
                }
                let r_pf = resolve_ty(mut_view(*cx), (TypeId { v: pt_f }));
                let r_pt = resolve_ty(mut_view(*cx), (TypeId { v: pt_t }));
                let pf = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_pf.v })) };
                let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_pt.v })) };
                if (pf as usize) != 0 && (pt as usize) != 0 {
                    let pk_f = unsafe { (*pf).kind };
                    let pk_t = unsafe { (*pt).kind };
                    if pk_f == TY_ARRAY && pk_t == TY_SLICE {
                        let el_f = unsafe { (*pf).elem.v };
                        let el_t = unsafe { (*pt).elem.v };
                        if unify_ty(mut_view(*cx), (TypeId { v: el_f }), (TypeId { v: el_t })) {
                            return (TypeId { v: to.v });
                        }
                    }
                }
            }
            if k_f == TY_MUT_VIEW && k_t == TY_MUT_VIEW {
                let r_pf = resolve_ty(mut_view(*cx), (TypeId { v: pt_f }));
                let r_pt = resolve_ty(mut_view(*cx), (TypeId { v: pt_t }));
                let pf = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_pf.v })) };
                let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_pt.v })) };
                if (pf as usize) != 0 && (pt as usize) != 0 {
                    let pk_f = unsafe { (*pf).kind };
                    let pk_t = unsafe { (*pt).kind };
                    if pk_f == TY_ARRAY && pk_t == TY_SLICE {
                        let el_f = unsafe { (*pf).elem.v };
                        let el_t = unsafe { (*pt).elem.v };
                        if unify_ty(mut_view(*cx), (TypeId { v: el_f }), (TypeId { v: el_t })) {
                            return (TypeId { v: to.v });
                        }
                    }
                }
            }
            if k_f == TY_PTR && k_t == TY_PTR {
                let m_f = unsafe { (*tf).is_mut };
                let m_t = unsafe { (*tt).is_mut };
                if m_f && !m_t {
                    if unify_ty(mut_view(*cx), (TypeId { v: pt_f }), (TypeId { v: pt_t })) {
                        return (TypeId { v: to.v });
                    }
                }
            }
            if k_f == TY_CLOSURE && k_t == TY_FN {
                let cap_cnt = unsafe { (*tf).capture_count };
                let c_pcnt = unsafe { (*tf).param_count };
                let f_pcnt = unsafe { (*tt).param_count };
                if cap_cnt == 0 && c_pcnt == f_pcnt {
                    let c_ret_v = unsafe { (*tf).ret_type.v };
                    let f_ret_v = unsafe { (*tt).ret_type.v };
                    let c_params = unsafe { (*tf).param_types };
                    let f_params = unsafe { (*tt).param_types };
                    let mut ok = unify_ty(mut_view(*cx), (TypeId { v: c_ret_v }), (TypeId { v: f_ret_v }));
                    let mut i: usize = 0;
                    while (i < c_pcnt && ok) {
                        let cp_v = unsafe { (*typeid_at(c_params, i)).v };
                        let fp_v = unsafe { (*typeid_at(f_params, i)).v };
                        ok = unify_ty(mut_view(*cx), (TypeId { v: cp_v }), (TypeId { v: fp_v }));
                        i = i + 1;
                    }
                    if ok {
                        return (TypeId { v: to.v });
                    }
                }
                return type_error(mut_view(*cx), sp, AX_TYPE_MISMATCH);
            }
            if k_f == TY_FN && k_t == TY_CLOSURE {
                return type_error(mut_view(*cx), sp, AX_TYPE_MISMATCH);
            }
        }
    }
    if !unify_ty(mut_view(*cx), (TypeId { v: from.v }), (TypeId { v: to.v })) {
        if tc_try_report_capability_forgery(mut_view(*cx), (TypeId { v: from.v }), (TypeId { v: to.v }), sp, false) {
            let err_v = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: err_v });
        }
        return type_error(mut_view(*cx), sp, AX_TYPE_MISMATCH);
    }
    (TypeId { v: from.v })
}

fn default_int_vars(cx: mut_view<TypeckCtx>) {
    let mut i: usize = cx.type_vars.fn_var_start;
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    while (i < cx.type_vars.len) {
        let e = unsafe { typevar_at(cx.type_vars.items, i) };
        let res_v = unsafe { (*e).resolved_to.v };
        if res_v == 0u32 {
            let is_gen = unsafe { (*e).is_generic };
            if is_gen {
                let fv = unsafe { (*e).span.file.v };
                let st = unsafe { (*e).span.start };
                let en = unsafe { (*e).span.end };
                type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_UNKNOWN);
                unsafe { (*e).resolved_to.v = err_v; }
            } else if unsafe { (*e).is_float } {
                // T457 (SPEC-41 AXS-FLT-003): an unconstrained float literal defaults to f64.
                unsafe { (*e).resolved_to.v = TYPEID_F64; }
            } else {
                unsafe { (*e).resolved_to.v = i32_v; }
            }
        }
        i = i + 1;
    }
}

fn int_fits(k: u8, mag: u64, mag_hi: u64, negated: bool) -> bool {
    if k == TY_I128 {
        if !negated {
            return mag_hi <= 0x7fffffffffffffffu64;
        }
        return mag_hi < 0x8000000000000000u64 || (mag_hi == 0x8000000000000000u64 && mag == 0u64);
    }
    if k == TY_U128 {
        if !negated {
            return true;
        }
        return mag == 0u64 && mag_hi == 0u64;
    }
    if mag_hi != 0u64 {
        return false;
    }
    if !negated {
        if k == TY_I8 { return mag <= 0x7fu64; }
        if k == TY_I16 { return mag <= 0x7fffu64; }
        if k == TY_I32 { return mag <= 0x7fffffffu64; }
        if k == TY_I64 || k == TY_ISIZE { return mag <= 0x7fffffffffffffffu64; }
        if k == TY_U8 { return mag <= 0xffu64; }
        if k == TY_U16 { return mag <= 0xffffu64; }
        if k == TY_U32 { return mag <= 0xffffffffu64; }
        if k == TY_U64 || k == TY_USIZE { return true; }
        return true;
    }
    if mag == 0u64 { return true; }
    if k == TY_I8 { return mag <= 0x80u64; }
    if k == TY_I16 { return mag <= 0x8000u64; }
    if k == TY_I32 { return mag <= 0x80000000u64; }
    if k == TY_I64 || k == TY_ISIZE { return mag <= 0x8000000000000000u64; }
    false
}

// T483 (SPEC-40 AXS-INT-004): `-9223372036854775808` of type i64/isize (the one literal whose magnitude is not
// representable, so the checked `0 - x` that MIR builds for `-lit` panics) is folded into one literal node once the
// literal's type is final and its range check (applied to the magnitude with the sign) has passed. Every other
// `-lit` already reaches MIR correctly and keeps its MIR (byte-identical to the axiom0 goldens that the selfhost
// bundles compare against); i128 has its own MIR builder path. The folded node holds the 128-bit two's
// complement of the magnitude, so `-9223372036854775808i64` reaches MIR as the constant `i64.MIN` instead of the
// checked `0 - 9223372036854775808` that panics. TC_TOK_FLAG_NEG_FOLDED marks the node: a second typeck pass over the
// same HIR (the literal now stands alone) recovers the magnitude and range-checks it as negated again.
const TC_TOK_FLAG_NEG_FOLDED: u16 = 0x8000u16;

fn tc_fold_neg_literal(up: *mut HirExpr) {
    unsafe {
        let inner: *mut HirExpr = (*up).inner;
        if (inner as usize) == 0 { return; }
        if (*inner).kind != HIR_EXPR_LITERAL || (*inner).literal.kind != TOK_INT { return; }
        let lo = (*inner).literal.int_val;
        let hi = token_int_hi(view((*inner).literal));
        let mut r_lo: u64 = 0u64;
        let mut r_hi: u64 = 0u64;
        tc_u128_neg(lo, hi, mut_view(r_lo), mut_view(r_hi));
        (*up).kind = HIR_EXPR_LITERAL;
        (*up).literal.kind = (*inner).literal.kind;
        (*up).literal.suffix = (*inner).literal.suffix;
        (*up).literal.flags = (*inner).literal.flags | TC_TOK_FLAG_NEG_FOLDED;
        (*up).literal.span.file.v = (*inner).literal.span.file.v;
        (*up).literal.span.start = (*inner).literal.span.start;
        (*up).literal.span.end = (*inner).literal.span.end;
        (*up).literal.int_val = r_lo;
        (*up).literal.char_val = (r_hi & 0xFFFFFFFFu64) as u32;
        (*up).literal.str_len = ((r_hi >> 32u64) & 0xFFFFFFFFu64) as usize;
        (*up).inner = 0 as *mut HirExpr;
    }
}

fn check_literal_ranges(cx: mut_view<TypeckCtx>) {
    let mut i: usize = 0;
    while (i < cx.lits_len) {
        let lc = unsafe { litcheck_at(cx.lits, i) };
        let l_ty_v = unsafe { (*lc).ty.v };
        let ty = resolve_ty(mut_view(*cx), (TypeId { v: l_ty_v }));
        let k = kind_of(mut_view(*cx), (TypeId { v: ty.v }));
        let ffl = unsafe { (*lc).float_flags };
        if k == TY_F32 || k == TY_F64 {
            // T457 (SPEC-41 AXS-FLT-003): a literal whose value rounds to infinity is out of range.
            let mut ovf = false;
            if (ffl & TC_LIT_FLOAT_TOKEN) != 0u8 {
                if k == TY_F32 {
                    ovf = (ffl & (FLOAT_LIT_F32_OVERFLOW as u8)) != 0u8;
                } else {
                    ovf = (ffl & (FLOAT_LIT_F64_OVERFLOW as u8)) != 0u8;
                }
            } else {
                let mut o = false;
                let lv = unsafe { (*lc).value };
                let lvh = unsafe { (*lc).value_hi };
                let _ = float_bits_from_u128(lv, lvh, false, k == TY_F32, mut_view(o));
                ovf = o;
            }
            if ovf {
                let neg = unsafe { (*lc).negated };
                let fv = if neg { unsafe { (*lc).neg_span.file.v } } else { unsafe { (*lc).span.file.v } };
                let st = if neg { unsafe { (*lc).neg_span.start } } else { unsafe { (*lc).span.start } };
                let en = if neg { unsafe { (*lc).neg_span.end } } else { unsafe { (*lc).span.end } };
                type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_LITERAL_OUT_OF_RANGE);
            }
        } else if (ffl & TC_LIT_FLOAT_TOKEN) != 0u8 {
            // A float literal unified with a non-float type was already reported as a mismatch.
        } else if k != TY_ERROR {
            let neg = unsafe { (*lc).negated };
            let val = unsafe { (*lc).value };
            let val_hi = unsafe { (*lc).value_hi };
            let is_uns = unsafe { type_is_unsigned((TypeId { v: ty.v }), view((*cx.thir).interner)) };
            if neg && is_uns && (val != 0u64 || val_hi != 0u64) {
                let nfv = unsafe { (*lc).neg_span.file.v };
                let nst = unsafe { (*lc).neg_span.start };
                let nen = unsafe { (*lc).neg_span.end };
                type_error_sp(mut_view(*cx), nfv, nst, nen, AX_TYPE_NEG_UNSIGNED);
            } else if !int_fits(k, val, val_hi, neg) {
                let fv = if neg { unsafe { (*lc).neg_span.file.v } } else { unsafe { (*lc).span.file.v } };
                let st = if neg { unsafe { (*lc).neg_span.start } } else { unsafe { (*lc).span.start } };
                let en = if neg { unsafe { (*lc).neg_span.end } } else { unsafe { (*lc).span.end } };
                type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_LITERAL_OUT_OF_RANGE);
            } else if neg && !is_uns {
                let up: *mut HirExpr = unsafe { (*lc).unary };
                if (up as usize) != 0 && (unsafe { (*up).kind }) == HIR_EXPR_UNARY && (k == TY_I64 || k == TY_ISIZE) && val == 0x8000000000000000u64 && val_hi == 0u64 {
                    tc_fold_neg_literal(up);
                }
            }
        }
        i = i + 1;
    }
    let mut j: usize = 0;
    while (j < cx.negs_len) {
        let nc = unsafe { negcheck_at(cx.negs, j) };
        let n_ty_v = unsafe { (*nc).ty.v };
        let ty = resolve_ty(mut_view(*cx), (TypeId { v: n_ty_v }));
        let is_uns = unsafe { type_is_unsigned((TypeId { v: ty.v }), view((*cx.thir).interner)) };
        if is_uns {
            let fv = unsafe { (*nc).span.file.v };
            let st = unsafe { (*nc).span.start };
            let en = unsafe { (*nc).span.end };
            type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_NEG_UNSIGNED);
        }
        j = j + 1;
    }
}

fn suffix_to_type(cx: mut_view<TypeckCtx>, s: u8) -> TypeId {
    unsafe {
        if s == SUFFIX_I8 { return (TypeId { v: (*cx.thir).interner.t_i8.v }); }
        if s == SUFFIX_I16 { return (TypeId { v: (*cx.thir).interner.t_i16.v }); }
        if s == SUFFIX_I32 { return (TypeId { v: (*cx.thir).interner.t_i32.v }); }
        if s == SUFFIX_I64 { return (TypeId { v: (*cx.thir).interner.t_i64.v }); }
        if s == SUFFIX_I128 { return (TypeId { v: (*cx.thir).interner.t_i128.v }); }
        if s == SUFFIX_ISIZE { return (TypeId { v: (*cx.thir).interner.t_isize.v }); }
        if s == SUFFIX_U8 { return (TypeId { v: (*cx.thir).interner.t_u8.v }); }
        if s == SUFFIX_U16 { return (TypeId { v: (*cx.thir).interner.t_u16.v }); }
        if s == SUFFIX_U32 { return (TypeId { v: (*cx.thir).interner.t_u32.v }); }
        if s == SUFFIX_U64 { return (TypeId { v: (*cx.thir).interner.t_u64.v }); }
        if s == SUFFIX_U128 { return (TypeId { v: (*cx.thir).interner.t_u128.v }); }
        if s == SUFFIX_USIZE { return (TypeId { v: (*cx.thir).interner.t_usize.v }); }
    }
    (TypeId { v: 0u32 })
}

fn int_literal_type(cx: mut_view<TypeckCtx>, tok: view<Token>, sp: view<Span>) -> TypeId {
    if (tok.flags & TOK_FLAG_ERROR) != 0u16 {
        let err_v = unsafe { (*cx.thir).interner.t_error.v };
        return (TypeId { v: err_v });
    }
    let mut val: u64 = tok.int_val;
    let mut val_hi: u64 = token_int_hi(tok);
    let folded = (tok.flags & TC_TOK_FLAG_NEG_FOLDED) != 0u16;
    if folded {
        let mut m_lo: u64 = 0u64;
        let mut m_hi: u64 = 0u64;
        tc_u128_neg(val, val_hi, mut_view(m_lo), mut_view(m_hi));
        val = m_lo;
        val_hi = m_hi;
    }
    let suf: u8 = tok.suffix;
    let mut ty = suffix_to_type(mut_view(*cx), suf);
    if ty.v == 0u32 {
        let iv = new_int_var(mut_view(*cx));
        ty.v = iv.v;
    }
    push_lit_check(mut_view(*cx), sp, val, val_hi, (TypeId { v: ty.v }));
    if folded {
        let lc = unsafe { litcheck_at(cx.lits, cx.lits_len - 1) };
        unsafe { (*lc).negated = true; }
    }
    ty
}

// T457 (SPEC-41 AXS-FLT-003): `2.5f32` / `2.5f64` are concrete; an unsuffixed float literal gets a fresh
// float variable (default f64). The range check (rounding to infinity) runs once the type is final.
fn float_literal_type(cx: mut_view<TypeckCtx>, tok: view<Token>, sp: view<Span>) -> TypeId {
    if (tok.flags & TOK_FLAG_ERROR) != 0u16 {
        let err_v = unsafe { (*cx.thir).interner.t_error.v };
        return (TypeId { v: err_v });
    }
    let mut ty = (TypeId { v: 0u32 });
    if tok.suffix == SUFFIX_F32 {
        ty.v = TYPEID_F32;
    } else if tok.suffix == SUFFIX_F64 {
        ty.v = TYPEID_F64;
    } else {
        let fv = new_float_var(mut_view(*cx));
        ty.v = fv.v;
    }
    push_lit_check(mut_view(*cx), sp, 0u64, 0u64, (TypeId { v: ty.v }));
    let lc = unsafe { litcheck_at(cx.lits, cx.lits_len - 1) };
    let ovf_bits: u8 = (tok.str_len & 3) as u8;
    unsafe { (*lc).float_flags = TC_LIT_FLOAT_TOKEN | ovf_bits; }
    ty
}

// T457: an integer literal operand as written in source (`3` or `-3`); returns the literal node.
fn tc_int_lit_operand(e: *const HirExpr) -> *mut HirExpr {
    if (e as usize) == 0 { return 0 as *mut HirExpr; }
    let ek = unsafe { (*e).kind };
    if ek == HIR_EXPR_LITERAL && (unsafe { (*e).literal.kind }) == TOK_INT {
        return e as *mut HirExpr;
    }
    if ek == HIR_EXPR_UNARY && (unsafe { (*e).op }) == UNOP_NEG {
        let inner: *mut HirExpr = unsafe { (*e).inner };
        if (inner as usize) != 0 && (unsafe { (*inner).kind }) == HIR_EXPR_LITERAL && (unsafe { (*inner).literal.kind }) == TOK_INT {
            return inner;
        }
    }
    0 as *mut HirExpr
}

// T457 (SPEC-04 AXS-EXT-035, SPEC-41 AXS-FLT-032 rule 2): an unsuffixed integer literal operand of a numeric
// operator whose peer is floating-point is typed directly as that float type (no cast needed).
fn tc_fix_int_lit_to_float(cx: mut_view<TypeckCtx>, e: *const HirExpr, fty: TypeId) -> bool {
    let lit = tc_int_lit_operand(e);
    if (lit as usize) == 0 { return false; }
    if (unsafe { (*lit).literal.suffix }) != SUFFIX_NONE { return false; }
    unsafe {
        thir_set_expr_type(mut_view(*cx.thir), lit as *const HirExpr, (TypeId { v: fty.v }));
        thir_set_expr_type(mut_view(*cx.thir), e, (TypeId { v: fty.v }));
    }
    let fv = unsafe { (*lit).span.file.v };
    let st = unsafe { (*lit).span.start };
    let en = unsafe { (*lit).span.end };
    let mut i = cx.lits_len;
    while i > 0 {
        let lc = unsafe { litcheck_at(cx.lits, i - 1) };
        if unsafe { (*lc).span.file.v } == fv && unsafe { (*lc).span.start } == st && unsafe { (*lc).span.end } == en {
            unsafe { (*lc).ty.v = fty.v; }
            break;
        }
        i = i - 1;
    }
    true
}

// T457 (REQ-OWNER-007, SPEC-41 AXS-FLT-031..033): typing of a binary arithmetic / comparison node where at
// least one operand is floating-point. Returns the operator type (bool for comparisons). Integer operands
// that are not literals keep their own type and are promoted by an explicit IntToFloat cast in the MIR
// builder; an f32 operand of an f64 operation is promoted with FloatConvert.
fn check_binary_float(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    lptr: *const HirExpr,
    left_ty: TypeId,
    rptr: *const HirExpr,
    right_ty: TypeId,
    expected: TypeId
) -> TypeId {
    let op = unsafe { (*expr).op };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let is_cmp = op >= BINOP_EQ && op <= BINOP_GE;
    let rl = resolve_ty(mut_view(*cx), (TypeId { v: left_ty.v }));
    let rr = resolve_ty(mut_view(*cx), (TypeId { v: right_ty.v }));
    if is_error(mut_view(*cx), (TypeId { v: rl.v })) || is_error(mut_view(*cx), (TypeId { v: rr.v })) {
        return if is_cmp { (TypeId { v: bool_v }) } else { (TypeId { v: err_v }) };
    }
    if op == BINOP_BITAND || op == BINOP_BITOR || op == BINOP_BITXOR {
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }
    let lnev = is_never(mut_view(*cx), (TypeId { v: rl.v }));
    let rnev = is_never(mut_view(*cx), (TypeId { v: rr.v }));
    if lnev || rnev {
        let o = if lnev { (TypeId { v: rr.v }) } else { (TypeId { v: rl.v }) };
        return if is_cmp { (TypeId { v: bool_v }) } else { o };
    }
    let lf = is_floatlike(mut_view(*cx), (TypeId { v: rl.v }));
    let rf = is_floatlike(mut_view(*cx), (TypeId { v: rr.v }));
    let li = is_intlike(mut_view(*cx), (TypeId { v: rl.v }));
    let ri = is_intlike(mut_view(*cx), (TypeId { v: rr.v }));
    if (!lf && !li) || (!rf && !ri) {
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
    }
    let lk = kind_of(mut_view(*cx), (TypeId { v: rl.v }));
    let rk = kind_of(mut_view(*cx), (TypeId { v: rr.v }));
    let mut f = (TypeId { v: 0u32 });
    if lf && rf {
        if lk == TY_FLOAT_VAR && rk == TY_FLOAT_VAR {
            let _ = unify_ty(mut_view(*cx), (TypeId { v: rl.v }), (TypeId { v: rr.v }));
            f.v = rl.v;
        } else if lk == TY_FLOAT_VAR {
            let _ = unify_ty(mut_view(*cx), (TypeId { v: rl.v }), (TypeId { v: rr.v }));
            f.v = rr.v;
        } else if rk == TY_FLOAT_VAR {
            let _ = unify_ty(mut_view(*cx), (TypeId { v: rr.v }), (TypeId { v: rl.v }));
            f.v = rl.v;
        } else if lk == TY_F64 || rk == TY_F64 {
            f.v = TYPEID_F64;
        } else {
            f.v = TYPEID_F32;
        }
    } else if lf {
        f.v = rl.v;
    } else {
        f.v = rr.v;
    }
    if !is_cmp && expected.v != 0u32 {
        let re = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
        let ek = kind_of(mut_view(*cx), (TypeId { v: re.v }));
        let fk = kind_of(mut_view(*cx), (TypeId { v: f.v }));
        if ek == TY_F32 || ek == TY_F64 {
            if fk == TY_FLOAT_VAR {
                let _ = unify_ty(mut_view(*cx), (TypeId { v: f.v }), (TypeId { v: re.v }));
                f.v = re.v;
            } else if fk == TY_F32 && ek == TY_F64 {
                // An enclosing f64 context evaluates the operation in f64 (SPEC-41 AXS-FLT-031 rule 2).
                f.v = re.v;
            }
        }
    }
    if li {
        let _ = tc_fix_int_lit_to_float(mut_view(*cx), lptr, (TypeId { v: f.v }));
    }
    if ri {
        let _ = tc_fix_int_lit_to_float(mut_view(*cx), rptr, (TypeId { v: f.v }));
    }
    if is_cmp { return (TypeId { v: bool_v }); }
    f
}

fn tc_path_name_sv(cx: view<TypeckCtx>, path: view<HirPath>) -> StrView {
    if path.span.file.v != 0u32 && (cx.db as usize) != 0 {
        let sp = Span { file: (FileId { v: path.span.file.v }), start: path.span.start, end: path.span.end };
        let sv = unsafe { source_db_span_text(view(*cx.db), sp) };
        if sv.len > 0 { return sv; }
    }
    if path.name.v != 0u32 && (cx.str_in as usize) != 0 {
        let sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: path.name.v })) };
        if sv.len > 0 { return sv; }
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

fn dotted_name_eq(a: view<AstDottedName>, b: view<AstDottedName>) -> bool {
    if a.count != b.count { return false; }
    let mut i: usize = 0;
    while (i < a.count) {
        let sa = unsafe { (*strid_at_const(a.segments as *const StrId, i)).v };
        let sb = unsafe { (*strid_at_const(b.segments as *const StrId, i)).v };
        if sa != sb { return false; }
        i = i + 1;
    }
    true
}

fn is_valid_const_type(cx: mut_view<TypeckCtx>, ty: TypeId) -> bool {
    let r = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
    if r.v == 0u32 { return false; }
    if is_error(mut_view(*cx), (TypeId { v: r.v })) { return true; }
    let is_i = unsafe { type_is_int((TypeId { v: r.v }), view((*cx.thir).interner)) };
    if is_i { return true; }
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r.v })) };
    if (t as usize) == 0 { return false; }
    let k = unsafe { (*t).kind };
    if k == TY_BOOL || k == TY_CHAR || k == TY_STR || k == TY_UNIT { return true; }
    if k == TY_F32 || k == TY_F64 || k == TY_FLOAT_VAR { return true; } // T458b (SPEC-41 AXS-FLT-003 rule 4)
    if k == TY_PTR || k == TY_VIEW || k == TY_FN { return true; }
    if k == TY_ARRAY {
        let el_v = unsafe { (*t).elem.v };
        return is_valid_const_type(mut_view(*cx), (TypeId { v: el_v }));
    }
    if k == TY_TUPLE {
        let fc = unsafe { (*t).field_count };
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        while (i < fc) {
            let fv = unsafe { (*typeid_at(fptr, i)).v };
            if !is_valid_const_type(mut_view(*cx), (TypeId { v: fv })) { return false; }
            i = i + 1;
        }
        return true;
    }
    if k == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        while (i < fc) {
            let fv = unsafe { (*typeid_at(fptr, i)).v };
            if !is_valid_const_type(mut_view(*cx), (TypeId { v: fv })) { return false; }
            i = i + 1;
        }
        return true;
    }
    if k == TY_ENUM {
        let vc = unsafe { (*t).variant_count };
        let vfc = unsafe { (*t).variant_field_counts };
        let vf = unsafe { (*t).variant_fields };
        let mut v: usize = 0;
        while (v < vc) {
            let cnt = unsafe { *usize_at(vfc, v) };
            let row = unsafe { *typeid_ptr_at(vf, v) };
            let mut j: usize = 0;
            while (j < cnt) {
                let fv = unsafe { (*typeid_at(row, j)).v };
                if !is_valid_const_type(mut_view(*cx), (TypeId { v: fv })) { return false; }
                j = j + 1;
            }
            v = v + 1;
        }
        return true;
    }
    false
}

fn find_const_item_by_symbol(cx: view<TypeckCtx>, sym: SymbolId) -> *mut HirItem {
    if sym.v == 0u32 || (cx.hir as usize) == 0 { return 0 as *mut HirItem; }
    if (cx.thir as usize) != 0 && (unsafe { (*cx.thir).expr_methods.cap }) > 0 {
        let indexed: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), 4usize) };
        if (indexed as usize) != 0 {
            let k: usize = ((sym.v as usize) << 3) | 4usize;
            let p: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), k) };
            if (p as usize) != 0 {
                let it: *mut HirItem = (unsafe { *p }) as *mut HirItem;
                if (it as usize) != 0 && (unsafe { (*it).kind }) == HIR_ITEM_CONST {
                    return it;
                }
            }
            return 0 as *mut HirItem;
        }
    }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((it as usize) != 0) {
        let k = unsafe { (*it).kind };
        if k == HIR_ITEM_CONST {
            if unsafe { (*it).symbol.v } == sym.v { return it; }
        } else if k == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while ((m as usize) != 0) {
                if unsafe { (*m).kind } == HIR_ITEM_CONST && unsafe { (*m).symbol.v } == sym.v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

fn find_const_item_by_name(cx: view<TypeckCtx>, name: view<StrView>) -> *mut HirItem {
    if name.len == 0 || (cx.hir as usize) == 0 || (cx.str_in as usize) == 0 { return 0 as *mut HirItem; }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((it as usize) != 0) {
        if unsafe { (*it).kind } == HIR_ITEM_CONST {
            let cname_id = unsafe { (*it).name.v };
            if cname_id != 0u32 {
                let csv = unsafe { interner_get(view(*cx.str_in), (StrId { v: cname_id })) };
                if sv_eq(view(csv), name) { return it; }
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

// Trap-free 64-bit two's-complement helpers for `eval_const_expr_int`.
fn tc_wrapping_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xffffffffu64;
    let a_hi = (a >> 32u64) & 0xffffffffu64;
    let b_lo = b & 0xffffffffu64;
    let b_hi = (b >> 32u64) & 0xffffffffu64;
    let sum_lo = a_lo + b_lo;
    let carry = (sum_lo >> 32u64) & 1u64;
    let sum_hi = (a_hi + b_hi + carry) & 0xffffffffu64;
    (sum_lo & 0xffffffffu64) | (sum_hi << 32u64)
}

fn tc_wrapping_neg_u64(x: u64) -> u64 {
    tc_wrapping_add_u64(x ^ 0xffffffffffffffffu64, 1u64)
}

fn tc_wrapping_sub_u64(a: u64, b: u64) -> u64 {
    tc_wrapping_add_u64(a, tc_wrapping_neg_u64(b))
}

fn tc_wrapping_mul_u64(a: u64, b: u64) -> u64 {
    let mut res: u64 = 0u64;
    let mut cur_a: u64 = a;
    let mut cur_b: u64 = b;
    let mut bit: u32 = 0u32;
    while bit < 64u32 && cur_b != 0u64 {
        if (cur_b & 1u64) != 0u64 {
            res = tc_wrapping_add_u64(res, cur_a);
        }
        cur_a = cur_a << 1u64;
        cur_b = cur_b >> 1u64;
        bit = bit + 1u32;
    }
    res
}

fn tc_u128_add(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64, out_lo: mut_view<u64>, out_hi: mut_view<u64>) {
    let sum_lo = tc_wrapping_add_u64(a_lo, b_lo);
    let carry = if sum_lo < a_lo { 1u64 } else { 0u64 };
    let sum_hi = tc_wrapping_add_u64(tc_wrapping_add_u64(a_hi, b_hi), carry);
    *out_lo = sum_lo;
    *out_hi = sum_hi;
}

fn tc_u128_neg(x_lo: u64, x_hi: u64, out_lo: mut_view<u64>, out_hi: mut_view<u64>) {
    tc_u128_add(x_lo ^ 0xffffffffffffffffu64, x_hi ^ 0xffffffffffffffffu64, 1u64, 0u64, mut_view(*out_lo), mut_view(*out_hi));
}

fn tc_u128_sub(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64, out_lo: mut_view<u64>, out_hi: mut_view<u64>) {
    let mut n_lo: u64 = 0u64;
    let mut n_hi: u64 = 0u64;
    tc_u128_neg(b_lo, b_hi, mut_view(n_lo), mut_view(n_hi));
    tc_u128_add(a_lo, a_hi, n_lo, n_hi, mut_view(*out_lo), mut_view(*out_hi));
}

fn tc_u128_umul_checked(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64, out_lo: mut_view<u64>, out_hi: mut_view<u64>) -> bool {
    let mut r_lo: u64 = 0u64;
    let mut r_hi: u64 = 0u64;
    let mut ca_lo: u64 = a_lo;
    let mut ca_hi: u64 = a_hi;
    let mut cb_lo: u64 = b_lo;
    let mut cb_hi: u64 = b_hi;
    let mut ovf = false;
    let mut bit: u32 = 0u32;
    while bit < 128u32 && (cb_lo != 0u64 || cb_hi != 0u64) {
        if (cb_lo & 1u64) != 0u64 {
            let prev_lo = r_lo;
            let prev_hi = r_hi;
            tc_u128_add(r_lo, r_hi, ca_lo, ca_hi, mut_view(r_lo), mut_view(r_hi));
            if r_hi < prev_hi || (r_hi == prev_hi && r_lo < prev_lo) {
                ovf = true;
            }
        }
        cb_lo = (cb_lo >> 1u64) | (cb_hi << 63u64);
        cb_hi = cb_hi >> 1u64;
        if cb_lo != 0u64 || cb_hi != 0u64 {
            if (ca_hi & 0x8000000000000000u64) != 0u64 {
                ovf = true;
            }
            ca_hi = (ca_hi << 1u64) | (ca_lo >> 63u64);
            ca_lo = ca_lo << 1u64;
        }
        bit = bit + 1u32;
    }
    *out_lo = r_lo;
    *out_hi = r_hi;
    ovf
}

fn tc_kind_is_signed(k: u8) -> bool {
    k == TY_I8 || k == TY_I16 || k == TY_I32 || k == TY_I64 || k == TY_ISIZE || k == TY_I128
}

fn tc_kind_bits(k: u8) -> u64 {
    if k == TY_I8 || k == TY_U8 { return 8u64; }
    if k == TY_I16 || k == TY_U16 { return 16u64; }
    if k == TY_I32 || k == TY_U32 { return 32u64; }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE { return 64u64; }
    if k == TY_I128 || k == TY_U128 { return 128u64; }
    0u64
}

fn tc_is_signed_min(k: u8, lo: u64, hi: u64) -> bool {
    if k == TY_I8 { return lo == 0xffffffffffffff80u64 && hi == 0xffffffffffffffffu64; }
    if k == TY_I16 { return lo == 0xffffffffffff8000u64 && hi == 0xffffffffffffffffu64; }
    if k == TY_I32 { return lo == 0xffffffff80000000u64 && hi == 0xffffffffffffffffu64; }
    if k == TY_I64 || k == TY_ISIZE { return lo == 0x8000000000000000u64 && hi == 0xffffffffffffffffu64; }
    if k == TY_I128 { return lo == 0u64 && hi == 0x8000000000000000u64; }
    false
}

fn tc_fits_narrow_kind(k: u8, r_lo: u64, r_hi: u64) -> bool {
    let mut n_lo: u64 = 0u64;
    let mut n_hi: u64 = 0u64;
    tc_norm_u128_for_kind(k, r_lo, r_hi, mut_view(n_lo), mut_view(n_hi));
    n_lo == r_lo && n_hi == r_hi
}

fn tc_u128_shl(a_lo: u64, a_hi: u64, sh_raw: u64, is_128: bool, out_lo: mut_view<u64>, out_hi: mut_view<u64>) {
    let sh = sh_raw & (if is_128 { 127u64 } else { 63u64 });
    if sh == 0u64 {
        *out_lo = a_lo;
        *out_hi = a_hi;
    } else if sh < 64u64 {
        *out_lo = a_lo << sh;
        *out_hi = (a_hi << sh) | (a_lo >> (64u64 - sh));
    } else {
        *out_lo = 0u64;
        *out_hi = a_lo << (sh - 64u64);
    }
}

fn tc_u128_shr(a_lo: u64, a_hi: u64, sh_raw: u64, is_128: bool, is_signed: bool, out_lo: mut_view<u64>, out_hi: mut_view<u64>) {
    let sh = sh_raw & (if is_128 { 127u64 } else { 63u64 });
    let fill = if is_signed && (a_hi & 0x8000000000000000u64) != 0u64 { 0xffffffffffffffffu64 } else { 0u64 };
    if sh == 0u64 {
        *out_lo = a_lo;
        *out_hi = a_hi;
    } else if sh < 64u64 {
        *out_lo = (a_lo >> sh) | (a_hi << (64u64 - sh));
        *out_hi = (a_hi >> sh) | (if fill != 0u64 { fill << (64u64 - sh) } else { 0u64 });
    } else {
        *out_lo = (a_hi >> (sh - 64u64)) | (if fill != 0u64 && sh > 64u64 { fill << (128u64 - sh) } else { 0u64 });
        *out_hi = fill;
    }
}

fn tc_u128_udivrem(
    n_lo: u64,
    n_hi: u64,
    d_lo: u64,
    d_hi: u64,
    q_lo: mut_view<u64>,
    q_hi: mut_view<u64>,
    r_lo: mut_view<u64>,
    r_hi: mut_view<u64>
) {
    let mut ql: u64 = 0u64;
    let mut qh: u64 = 0u64;
    let mut rl: u64 = 0u64;
    let mut rh: u64 = 0u64;
    let mut step: u32 = 0u32;
    while step < 128u32 {
        let bit = 127u32 - step;
        let b_in = if bit >= 64u32 {
            (n_hi >> ((bit - 64u32) as u64)) & 1u64
        } else {
            (n_lo >> (bit as u64)) & 1u64
        };
        rh = (rh << 1u64) | (rl >> 63u64);
        rl = (rl << 1u64) | b_in;
        if rh > d_hi || (rh == d_hi && rl >= d_lo) {
            tc_u128_sub(rl, rh, d_lo, d_hi, mut_view(rl), mut_view(rh));
            if bit >= 64u32 {
                qh = qh | (1u64 << ((bit - 64u32) as u64));
            } else {
                ql = ql | (1u64 << (bit as u64));
            }
        }
        step = step + 1u32;
    }
    *q_lo = ql;
    *q_hi = qh;
    *r_lo = rl;
    *r_hi = rh;
}

fn tc_u128_divrem(
    n_lo: u64,
    n_hi: u64,
    d_lo: u64,
    d_hi: u64,
    is_signed: bool,
    q_lo: mut_view<u64>,
    q_hi: mut_view<u64>,
    r_lo: mut_view<u64>,
    r_hi: mut_view<u64>
) {
    if !is_signed {
        tc_u128_udivrem(n_lo, n_hi, d_lo, d_hi, mut_view(*q_lo), mut_view(*q_hi), mut_view(*r_lo), mut_view(*r_hi));
        return;
    }
    let neg_n = (n_hi & 0x8000000000000000u64) != 0u64;
    let neg_d = (d_hi & 0x8000000000000000u64) != 0u64;
    let mut an_lo: u64 = n_lo;
    let mut an_hi: u64 = n_hi;
    if neg_n {
        tc_u128_neg(n_lo, n_hi, mut_view(an_lo), mut_view(an_hi));
    }
    let mut ad_lo: u64 = d_lo;
    let mut ad_hi: u64 = d_hi;
    if neg_d {
        tc_u128_neg(d_lo, d_hi, mut_view(ad_lo), mut_view(ad_hi));
    }
    let mut uq_lo: u64 = 0u64;
    let mut uq_hi: u64 = 0u64;
    let mut ur_lo: u64 = 0u64;
    let mut ur_hi: u64 = 0u64;
    tc_u128_udivrem(an_lo, an_hi, ad_lo, ad_hi, mut_view(uq_lo), mut_view(uq_hi), mut_view(ur_lo), mut_view(ur_hi));
    if neg_n != neg_d {
        tc_u128_neg(uq_lo, uq_hi, mut_view(*q_lo), mut_view(*q_hi));
    } else {
        *q_lo = uq_lo;
        *q_hi = uq_hi;
    }
    if neg_n {
        tc_u128_neg(ur_lo, ur_hi, mut_view(*r_lo), mut_view(*r_hi));
    } else {
        *r_lo = ur_lo;
        *r_hi = ur_hi;
    }
}

fn tc_u128_lt(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64, is_signed: bool) -> bool {
    if a_hi != b_hi {
        if is_signed {
            return (a_hi as i64) < (b_hi as i64);
        }
        return a_hi < b_hi;
    }
    a_lo < b_lo
}

fn tc_norm_u128_for_kind(k: u8, in_lo: u64, in_hi: u64, out_lo: mut_view<u64>, out_hi: mut_view<u64>) {
    if k == TY_U8 { *out_lo = in_lo & 0xffu64; *out_hi = 0u64; return; }
    if k == TY_U16 { *out_lo = in_lo & 0xffffu64; *out_hi = 0u64; return; }
    if k == TY_U32 { *out_lo = in_lo & 0xffffffffu64; *out_hi = 0u64; return; }
    if k == TY_U64 || k == TY_USIZE || k == TY_CHAR { *out_lo = in_lo; *out_hi = 0u64; return; }
    if k == TY_U128 || k == TY_I128 { *out_lo = in_lo; *out_hi = in_hi; return; }
    if k == TY_BOOL {
        *out_lo = if in_lo != 0u64 || in_hi != 0u64 { 1u64 } else { 0u64 };
        *out_hi = 0u64;
        return;
    }
    if k == TY_I8 {
        let v = in_lo & 0xffu64;
        if (v & 0x80u64) != 0u64 {
            *out_lo = v | 0xffffffffffffff00u64;
            *out_hi = 0xffffffffffffffffu64;
        } else {
            *out_lo = v;
            *out_hi = 0u64;
        }
        return;
    }
    if k == TY_I16 {
        let v = in_lo & 0xffffu64;
        if (v & 0x8000u64) != 0u64 {
            *out_lo = v | 0xffffffffffff0000u64;
            *out_hi = 0xffffffffffffffffu64;
        } else {
            *out_lo = v;
            *out_hi = 0u64;
        }
        return;
    }
    if k == TY_I32 {
        let v = in_lo & 0xffffffffu64;
        if (v & 0x80000000u64) != 0u64 {
            *out_lo = v | 0xffffffff00000000u64;
            *out_hi = 0xffffffffffffffffu64;
        } else {
            *out_lo = v;
            *out_hi = 0u64;
        }
        return;
    }
    if k == TY_I64 || k == TY_ISIZE {
        *out_lo = in_lo;
        *out_hi = if (in_lo & 0x8000000000000000u64) != 0u64 { 0xffffffffffffffffu64 } else { 0u64 };
        return;
    }
    *out_lo = in_lo;
    *out_hi = in_hi;
}

fn tc_expr_const_ty_kind(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> u8 {
    if (expr as usize) == 0 || (cx.thir as usize) == 0 { return 0u8; }
    let ety = unsafe { thir_get_expr_type(view(*cx.thir), expr) };
    if ety.v == 0u32 { return 0u8; }
    let r = resolve_ty(mut_view(*cx), (TypeId { v: ety.v }));
    if r.v == 0u32 { return 0u8; }
    let k = kind_of(mut_view(*cx), (TypeId { v: r.v }));
    if k == TY_ERROR || k == TY_VAR || k == TY_INT_VAR { return 0u8; }
    k
}

// Built-in 128-bit constant expression evaluator for integer/bool constants and array lengths.
fn eval_const_expr_u128(cx: mut_view<TypeckCtx>, expr: *const HirExpr, out_lo: mut_view<u64>, out_hi: mut_view<u64>, out_err: mut_view<u32>) -> bool {
    *out_lo = 0u64;
    *out_hi = 0u64;
    *out_err = 0u32;
    if (expr as usize) == 0 { return false; }
    let k = unsafe { (*expr).kind };
    let ek_ty = tc_expr_const_ty_kind(mut_view(*cx), expr);
    // T458b (SPEC-41 AXS-FLT-003 rule 4): a float-typed (sub)expression is never folded as an integer here; float
    // constants are evaluated by the oracle's strict soft-float through the session const evaluator (ADR-0004 §8).
    if ek_ty == TY_F32 || ek_ty == TY_F64 || ek_ty == TY_FLOAT_VAR { return false; }
    if k == HIR_EXPR_LITERAL {
        let tk = unsafe { (*expr).literal.kind };
        if tk == TOK_INT {
            let lo = unsafe { (*expr).literal.int_val };
            let hi = unsafe { token_int_hi(view((*expr).literal)) };
            if ek_ty != 0u8 {
                tc_norm_u128_for_kind(ek_ty, lo, hi, mut_view(*out_lo), mut_view(*out_hi));
            } else {
                *out_lo = lo;
                *out_hi = hi;
            }
            return true;
        }
        if tk == TOK_KW_TRUE {
            *out_lo = 1u64;
            *out_hi = 0u64;
            return true;
        }
        if tk == TOK_KW_FALSE {
            *out_lo = 0u64;
            *out_hi = 0u64;
            return true;
        }
        if tk == TOK_CHAR {
            let cv = unsafe { (*expr).literal.char_val };
            *out_lo = cv as u64;
            *out_hi = 0u64;
            return true;
        }
        return false;
    }
    if k == HIR_EXPR_UNARY {
        let mut in_lo: u64 = 0u64;
        let mut in_hi: u64 = 0u64;
        let inner_ptr: *mut HirExpr = unsafe { (*expr).inner };
        if (unsafe { (*expr).op }) == UNOP_NEG && (inner_ptr as usize) != 0 && (unsafe { (*inner_ptr).kind }) == HIR_EXPR_LITERAL && (unsafe { (*inner_ptr).literal.kind }) == TOK_INT {
            let raw_lo = unsafe { (*inner_ptr).literal.int_val };
            let raw_hi = unsafe { token_int_hi(view((*inner_ptr).literal)) };
            let mut r_lo: u64 = 0u64;
            let mut r_hi: u64 = 0u64;
            tc_u128_neg(raw_lo, raw_hi, mut_view(r_lo), mut_view(r_hi));
            if ek_ty != 0u8 {
                tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi));
            } else {
                *out_lo = r_lo;
                *out_hi = r_hi;
            }
            return true;
        }
        if !eval_const_expr_u128(mut_view(*cx), inner_ptr, mut_view(in_lo), mut_view(in_hi), mut_view(*out_err)) { return false; }
        let op = unsafe { (*expr).op };
        if op == UNOP_NEG {
            let u_bits = tc_kind_bits(ek_ty);
            if ek_ty == TY_I128 && in_lo == 0u64 && in_hi == 0x8000000000000000u64 {
                *out_err = AX_CONST_OVERFLOW;
                return false;
            }
            let mut r_lo: u64 = 0u64;
            let mut r_hi: u64 = 0u64;
            tc_u128_neg(in_lo, in_hi, mut_view(r_lo), mut_view(r_hi));
            if u_bits != 0u64 && u_bits < 128u64 && !tc_fits_narrow_kind(ek_ty, r_lo, r_hi) {
                *out_err = AX_CONST_OVERFLOW;
                return false;
            }
            if ek_ty != 0u8 {
                tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi));
            } else {
                *out_lo = r_lo;
                *out_hi = r_hi;
            }
            return true;
        }
        if op == UNOP_NOT {
            *out_lo = if in_lo == 0u64 && in_hi == 0u64 { 1u64 } else { 0u64 };
            *out_hi = 0u64;
            return true;
        }
        if op == UNOP_BITNOT {
            let r_lo = in_lo ^ 0xffffffffffffffffu64;
            let r_hi = in_hi ^ 0xffffffffffffffffu64;
            if ek_ty != 0u8 {
                tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi));
            } else {
                *out_lo = r_lo;
                *out_hi = r_hi;
            }
            return true;
        }
        return false;
    }
    if k == HIR_EXPR_CAST {
        let inner_ptr: *mut HirExpr = unsafe { (*expr).inner };
        let mut in_lo: u64 = 0u64;
        let mut in_hi: u64 = 0u64;
        if !eval_const_expr_u128(mut_view(*cx), inner_ptr, mut_view(in_lo), mut_view(in_hi), mut_view(*out_err)) {
            return false;
        }
        if ek_ty != 0u8 {
            tc_norm_u128_for_kind(ek_ty, in_lo, in_hi, mut_view(*out_lo), mut_view(*out_hi));
        } else {
            *out_lo = in_lo;
            *out_hi = in_hi;
        }
        return true;
    }
    if k == HIR_EXPR_BINARY {
        let mut lv_lo: u64 = 0u64;
        let mut lv_hi: u64 = 0u64;
        let mut rv_lo: u64 = 0u64;
        let mut rv_hi: u64 = 0u64;
        let lptr: *mut HirExpr = unsafe { (*expr).left };
        let rptr: *mut HirExpr = unsafe { (*expr).right };
        if !eval_const_expr_u128(mut_view(*cx), lptr, mut_view(lv_lo), mut_view(lv_hi), mut_view(*out_err)) { return false; }
        if !eval_const_expr_u128(mut_view(*cx), rptr, mut_view(rv_lo), mut_view(rv_hi), mut_view(*out_err)) { return false; }
        let op = unsafe { (*expr).op };
        let lk_ty = tc_expr_const_ty_kind(mut_view(*cx), lptr);
        let rk_ty = tc_expr_const_ty_kind(mut_view(*cx), rptr);
        let opnd_k = if ek_ty != 0u8 && ek_ty != TY_BOOL {
            ek_ty
        } else if lk_ty != 0u8 {
            lk_ty
        } else {
            rk_ty
        };
        let is_sig = tc_kind_is_signed(opnd_k);
        let cmp_sig = if lk_ty != 0u8 || rk_ty != 0u8 {
            tc_kind_is_signed(lk_ty) || tc_kind_is_signed(rk_ty)
        } else {
            is_sig
        };
        let opnd_bits = tc_kind_bits(opnd_k);
        let is_128 = opnd_k == TY_I128 || opnd_k == TY_U128;
        let mut r_lo: u64 = 0u64;
        let mut r_hi: u64 = 0u64;
        if op == BINOP_ADD {
            tc_u128_add(lv_lo, lv_hi, rv_lo, rv_hi, mut_view(r_lo), mut_view(r_hi));
            let mut ovf = false;
            if opnd_k == TY_U128 {
                ovf = r_hi < lv_hi || (r_hi == lv_hi && r_lo < lv_lo);
            } else if opnd_k == TY_I128 {
                ovf = ((lv_hi ^ rv_hi) & 0x8000000000000000u64) == 0u64 &&
                    ((lv_hi ^ r_hi) & 0x8000000000000000u64) != 0u64;
            } else if opnd_bits != 0u64 {
                ovf = !tc_fits_narrow_kind(opnd_k, r_lo, r_hi);
            }
            if ovf {
                *out_err = AX_CONST_OVERFLOW;
                return false;
            }
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_SUB {
            tc_u128_sub(lv_lo, lv_hi, rv_lo, rv_hi, mut_view(r_lo), mut_view(r_hi));
            let mut ovf = false;
            if opnd_k == TY_U128 {
                ovf = lv_hi < rv_hi || (lv_hi == rv_hi && lv_lo < rv_lo);
            } else if opnd_k == TY_I128 {
                ovf = ((lv_hi ^ rv_hi) & 0x8000000000000000u64) != 0u64 &&
                    ((lv_hi ^ r_hi) & 0x8000000000000000u64) != 0u64;
            } else if opnd_bits != 0u64 {
                ovf = !tc_fits_narrow_kind(opnd_k, r_lo, r_hi);
            }
            if ovf {
                *out_err = AX_CONST_OVERFLOW;
                return false;
            }
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_MUL {
            let mut ovf = false;
            if opnd_k == TY_U128 {
                ovf = tc_u128_umul_checked(lv_lo, lv_hi, rv_lo, rv_hi, mut_view(r_lo), mut_view(r_hi));
            } else if opnd_k == TY_I128 {
                let neg_a = (lv_hi & 0x8000000000000000u64) != 0u64;
                let neg_b = (rv_hi & 0x8000000000000000u64) != 0u64;
                let mut ma_lo: u64 = lv_lo;
                let mut ma_hi: u64 = lv_hi;
                if neg_a { tc_u128_neg(lv_lo, lv_hi, mut_view(ma_lo), mut_view(ma_hi)); }
                let mut mb_lo: u64 = rv_lo;
                let mut mb_hi: u64 = rv_hi;
                if neg_b { tc_u128_neg(rv_lo, rv_hi, mut_view(mb_lo), mut_view(mb_hi)); }
                let mut m_lo: u64 = 0u64;
                let mut m_hi: u64 = 0u64;
                let mag_ovf = tc_u128_umul_checked(ma_lo, ma_hi, mb_lo, mb_hi, mut_view(m_lo), mut_view(m_hi));
                if m_lo == 0u64 && m_hi == 0u64 && !mag_ovf {
                    r_lo = 0u64;
                    r_hi = 0u64;
                } else if neg_a != neg_b {
                    if mag_ovf || m_hi > 0x8000000000000000u64 || (m_hi == 0x8000000000000000u64 && m_lo != 0u64) {
                        ovf = true;
                    } else {
                        tc_u128_neg(m_lo, m_hi, mut_view(r_lo), mut_view(r_hi));
                    }
                } else if mag_ovf || m_hi >= 0x8000000000000000u64 {
                    ovf = true;
                } else {
                    r_lo = m_lo;
                    r_hi = m_hi;
                }
            } else {
                let _ = tc_u128_umul_checked(lv_lo, lv_hi, rv_lo, rv_hi, mut_view(r_lo), mut_view(r_hi));
                if opnd_bits != 0u64 {
                    ovf = !tc_fits_narrow_kind(opnd_k, r_lo, r_hi);
                }
            }
            if ovf {
                *out_err = AX_CONST_OVERFLOW;
                return false;
            }
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_DIV {
            if rv_lo == 0u64 && rv_hi == 0u64 {
                *out_err = AX_CONST_DIV_ZERO;
                return false;
            }
            if is_sig && tc_is_signed_min(opnd_k, lv_lo, lv_hi) && rv_lo == 0xffffffffffffffffu64 && rv_hi == 0xffffffffffffffffu64 {
                *out_err = AX_CONST_OVERFLOW;
                return false;
            }
            let mut rem_lo: u64 = 0u64;
            let mut rem_hi: u64 = 0u64;
            tc_u128_divrem(lv_lo, lv_hi, rv_lo, rv_hi, is_sig, mut_view(r_lo), mut_view(r_hi), mut_view(rem_lo), mut_view(rem_hi));
            if opnd_bits != 0u64 && opnd_bits < 128u64 && !tc_fits_narrow_kind(opnd_k, r_lo, r_hi) {
                *out_err = AX_CONST_OVERFLOW;
                return false;
            }
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_REM {
            if rv_lo == 0u64 && rv_hi == 0u64 {
                *out_err = AX_CONST_DIV_ZERO;
                return false;
            }
            if is_sig && tc_is_signed_min(opnd_k, lv_lo, lv_hi) && rv_lo == 0xffffffffffffffffu64 && rv_hi == 0xffffffffffffffffu64 {
                *out_err = AX_CONST_OVERFLOW;
                return false;
            }
            let mut q_lo: u64 = 0u64;
            let mut q_hi: u64 = 0u64;
            tc_u128_divrem(lv_lo, lv_hi, rv_lo, rv_hi, is_sig, mut_view(q_lo), mut_view(q_hi), mut_view(r_lo), mut_view(r_hi));
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_BITAND {
            r_lo = lv_lo & rv_lo;
            r_hi = lv_hi & rv_hi;
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_BITOR {
            r_lo = lv_lo | rv_lo;
            r_hi = lv_hi | rv_hi;
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_BITXOR {
            r_lo = lv_lo ^ rv_lo;
            r_hi = lv_hi ^ rv_hi;
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_SHL {
            let sh_bits = if opnd_bits != 0u64 { opnd_bits } else { 128u64 };
            if rv_hi != 0u64 || rv_lo >= sh_bits {
                *out_err = AX_CONST_SHIFT_RANGE;
                return false;
            }
            tc_u128_shl(lv_lo, lv_hi, rv_lo, is_128, mut_view(r_lo), mut_view(r_hi));
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_SHR {
            let sh_bits = if opnd_bits != 0u64 { opnd_bits } else { 128u64 };
            if rv_hi != 0u64 || rv_lo >= sh_bits {
                *out_err = AX_CONST_SHIFT_RANGE;
                return false;
            }
            tc_u128_shr(lv_lo, lv_hi, rv_lo, is_128, is_sig, mut_view(r_lo), mut_view(r_hi));
            if ek_ty != 0u8 { tc_norm_u128_for_kind(ek_ty, r_lo, r_hi, mut_view(*out_lo), mut_view(*out_hi)); } else { *out_lo = r_lo; *out_hi = r_hi; }
            return true;
        }
        if op == BINOP_EQ { *out_lo = if lv_lo == rv_lo && lv_hi == rv_hi { 1u64 } else { 0u64 }; *out_hi = 0u64; return true; }
        if op == BINOP_NE { *out_lo = if lv_lo != rv_lo || lv_hi != rv_hi { 1u64 } else { 0u64 }; *out_hi = 0u64; return true; }
        if op == BINOP_LT { *out_lo = if tc_u128_lt(lv_lo, lv_hi, rv_lo, rv_hi, cmp_sig) { 1u64 } else { 0u64 }; *out_hi = 0u64; return true; }
        if op == BINOP_LE { *out_lo = if !tc_u128_lt(rv_lo, rv_hi, lv_lo, lv_hi, cmp_sig) { 1u64 } else { 0u64 }; *out_hi = 0u64; return true; }
        if op == BINOP_GT { *out_lo = if tc_u128_lt(rv_lo, rv_hi, lv_lo, lv_hi, cmp_sig) { 1u64 } else { 0u64 }; *out_hi = 0u64; return true; }
        if op == BINOP_GE { *out_lo = if !tc_u128_lt(lv_lo, lv_hi, rv_lo, rv_hi, cmp_sig) { 1u64 } else { 0u64 }; *out_hi = 0u64; return true; }
        if op == BINOP_LOGAND { *out_lo = if (lv_lo != 0u64 || lv_hi != 0u64) && (rv_lo != 0u64 || rv_hi != 0u64) { 1u64 } else { 0u64 }; *out_hi = 0u64; return true; }
        if op == BINOP_LOGOR { *out_lo = if (lv_lo != 0u64 || lv_hi != 0u64) || (rv_lo != 0u64 || rv_hi != 0u64) { 1u64 } else { 0u64 }; *out_hi = 0u64; return true; }
        return false;
    }
    if k == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        if sym_v != 0u32 {
            let citem = find_const_item_by_symbol(view(*cx), (SymbolId { v: sym_v }));
            if (citem as usize) != 0 {
                let existing = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: sym_v })) };
                if (existing as usize) != 0 {
                    let ek = unsafe { (*existing).kind };
                    if ek == CONST_INT {
                        let cty = resolve_ty(mut_view(*cx), (TypeId { v: unsafe { (*existing).ty.v } }));
                        let ck = kind_of(mut_view(*cx), (TypeId { v: cty.v }));
                        let elo = unsafe { (*existing).int_val };
                        let ehi = unsafe { const_val_int_hi(view(*existing)) };
                        tc_norm_u128_for_kind(ck, elo, ehi, mut_view(*out_lo), mut_view(*out_hi));
                        return true;
                    }
                    return false;
                }
                evaluate_const_item(mut_view(*cx), citem);
                let after = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: sym_v })) };
                if (after as usize) != 0 && unsafe { (*after).kind } == CONST_INT {
                    let cty = resolve_ty(mut_view(*cx), (TypeId { v: unsafe { (*after).ty.v } }));
                    let ck = kind_of(mut_view(*cx), (TypeId { v: cty.v }));
                    let alo = unsafe { (*after).int_val };
                    let ahi = unsafe { const_val_int_hi(view(*after)) };
                    tc_norm_u128_for_kind(ck, alo, ahi, mut_view(*out_lo), mut_view(*out_hi));
                    return true;
                }
            }
        } else {
            let psv = unsafe { tc_path_name_sv(view(*cx), view((*expr).path)) };
            let citem = find_const_item_by_name(view(*cx), view(psv));
            if (citem as usize) != 0 {
                evaluate_const_item(mut_view(*cx), citem);
                let csym = unsafe { (*citem).symbol.v };
                if csym != 0u32 {
                    let after = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: csym })) };
                    if (after as usize) != 0 && unsafe { (*after).kind } == CONST_INT {
                        let cty = resolve_ty(mut_view(*cx), (TypeId { v: unsafe { (*after).ty.v } }));
                        let ck = kind_of(mut_view(*cx), (TypeId { v: cty.v }));
                        let alo = unsafe { (*after).int_val };
                        let ahi = unsafe { const_val_int_hi(view(*after)) };
                        tc_norm_u128_for_kind(ck, alo, ahi, mut_view(*out_lo), mut_view(*out_hi));
                        return true;
                    }
                }
            }
        }
    }
    if k == HIR_EXPR_FIELD {
        if (cx.thir as usize) != 0 {
            let vp = unsafe { ptr_u32map_get(view((*cx.thir).expr_variants), expr as usize) };
            if (vp as usize) != 0 {
                *out_lo = (unsafe { *vp }) as u64;
                *out_hi = 0u64;
                return true;
            }
            let mp = unsafe { thir_get_expr_method(view(*cx.thir), expr) };
            if (mp as usize) != 0 {
                let m_it: *const HirItem = unsafe { *mp };
                if (m_it as usize) != 0 && (unsafe { (*m_it).kind }) == HIR_ITEM_CONST {
                    let m_sym_v = unsafe { (*m_it).symbol.v };
                    if m_sym_v != 0u32 {
                        let mut cptr = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: m_sym_v })) };
                        if (cptr as usize) == 0 {
                            evaluate_const_item(mut_view(*cx), m_it);
                            cptr = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: m_sym_v })) };
                        }
                        if (cptr as usize) != 0 && (unsafe { (*cptr).kind }) == CONST_INT {
                            let cty = resolve_ty(mut_view(*cx), (TypeId { v: unsafe { (*cptr).ty.v } }));
                            let ck = kind_of(mut_view(*cx), (TypeId { v: cty.v }));
                            let clo = unsafe { (*cptr).int_val };
                            let chi = unsafe { const_val_int_hi(view(*cptr)) };
                            tc_norm_u128_for_kind(ck, clo, chi, mut_view(*out_lo), mut_view(*out_hi));
                            return true;
                        }
                    }
                }
            }
        }
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        if (b_expr as usize) != 0 && (cx.str_in as usize) != 0 {
            let bty = unsafe { thir_get_expr_type(view(*cx.thir), b_expr) };
            let rb = resolve_ty(mut_view(*cx), (TypeId { v: bty.v }));
            if unsafe { type_is_int((TypeId { v: rb.v }), view((*cx.thir).interner)) } {
                let bk = kind_of(mut_view(*cx), (TypeId { v: rb.v }));
                let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*expr).name.v })) };
                if tc_sv_is_4(view(fname), 66u8, 73u8, 84u8, 83u8) { // BITS
                    if bk == TY_I8 || bk == TY_U8 { *out_lo = 8u64; *out_hi = 0u64; return true; }
                    if bk == TY_I16 || bk == TY_U16 { *out_lo = 16u64; *out_hi = 0u64; return true; }
                    if bk == TY_I32 || bk == TY_U32 { *out_lo = 32u64; *out_hi = 0u64; return true; }
                    if bk == TY_I64 || bk == TY_U64 || bk == TY_ISIZE || bk == TY_USIZE { *out_lo = 64u64; *out_hi = 0u64; return true; }
                    if bk == TY_I128 || bk == TY_U128 { *out_lo = 128u64; *out_hi = 0u64; return true; }
                } else if tc_sv_is_3(view(fname), 77u8, 73u8, 78u8) { // MIN
                    if bk == TY_U8 || bk == TY_U16 || bk == TY_U32 || bk == TY_U64 || bk == TY_USIZE || bk == TY_U128 {
                        *out_lo = 0u64;
                        *out_hi = 0u64;
                        return true;
                    }
                    if bk == TY_I8 { *out_lo = 0xffffffffffffff80u64; *out_hi = 0xffffffffffffffffu64; return true; }
                    if bk == TY_I16 { *out_lo = 0xffffffffffff8000u64; *out_hi = 0xffffffffffffffffu64; return true; }
                    if bk == TY_I32 { *out_lo = 0xffffffff80000000u64; *out_hi = 0xffffffffffffffffu64; return true; }
                    if bk == TY_I64 || bk == TY_ISIZE { *out_lo = 0x8000000000000000u64; *out_hi = 0xffffffffffffffffu64; return true; }
                    if bk == TY_I128 { *out_lo = 0u64; *out_hi = 0x8000000000000000u64; return true; }
                } else if tc_sv_is_3(view(fname), 77u8, 65u8, 88u8) { // MAX
                    if bk == TY_I8 { *out_lo = 0x7fu64; *out_hi = 0u64; return true; }
                    if bk == TY_I16 { *out_lo = 0x7fffu64; *out_hi = 0u64; return true; }
                    if bk == TY_I32 { *out_lo = 0x7fffffffu64; *out_hi = 0u64; return true; }
                    if bk == TY_I64 || bk == TY_ISIZE { *out_lo = 0x7fffffffffffffffu64; *out_hi = 0u64; return true; }
                    if bk == TY_U8 { *out_lo = 0xffu64; *out_hi = 0u64; return true; }
                    if bk == TY_U16 { *out_lo = 0xffffu64; *out_hi = 0u64; return true; }
                    if bk == TY_U32 { *out_lo = 0xffffffffu64; *out_hi = 0u64; return true; }
                    if bk == TY_U64 || bk == TY_USIZE { *out_lo = 0xffffffffffffffffu64; *out_hi = 0u64; return true; }
                    if bk == TY_I128 { *out_lo = 0xffffffffffffffffu64; *out_hi = 0x7fffffffffffffffu64; return true; }
                    if bk == TY_U128 { *out_lo = 0xffffffffffffffffu64; *out_hi = 0xffffffffffffffffu64; return true; }
                }
            }
        }
    }
    false
}

fn eval_const_expr_int(cx: mut_view<TypeckCtx>, expr: *const HirExpr, out_val: mut_view<u64>, out_err: mut_view<u32>) -> bool {
    let mut hi: u64 = 0u64;
    eval_const_expr_u128(mut_view(*cx), expr, mut_view(*out_val), mut_view(hi), mut_view(*out_err))
}

fn typeck_extract_fn_sym_from_arg(cx: view<TypeckCtx>, arg: *const HirExpr) -> u32 {
    if (arg as usize) == 0 { return 0u32; }
    let ak = unsafe { (*arg).kind };
    if ak == HIR_EXPR_PATH {
        let sym_v = unsafe { (*arg).path.symbol.v };
        if sym_v != 0u32 { return sym_v; }
        let nid = unsafe { (*arg).path.name.v };
        if nid != 0u32 && (cx.hir as usize) != 0 {
            let mut cur: *mut HirItem = unsafe { (*cx.hir).items };
            while (cur as usize) != 0 {
                if (unsafe { (*cur).kind }) == HIR_ITEM_FN && (unsafe { (*cur).name.v }) == nid {
                    return unsafe { (*cur).symbol.v };
                }
                cur = unsafe { (*cur).next };
            }
        }
    }
    0u32
}

fn tc_write_u128_le(dst: *mut u8, dst_cap: usize, lo: u64, hi: u64, elem_sz: usize) {
    if (dst as usize) == 0 || dst_cap == 0 || elem_sz == 0 { return; }
    let limit = if elem_sz < dst_cap { elem_sz } else { dst_cap };
    let mut b: usize = 0;
    while b < limit && b < 8 {
        unsafe { *(dst + b) = ((lo >> ((b as u64) * 8u64)) & 0xffu64) as u8; }
        b = b + 1;
    }
    while b < limit && b < 16 {
        let sh = ((b - 8) as u64) * 8u64;
        unsafe { *(dst + b) = ((hi >> sh) & 0xffu64) as u8; }
        b = b + 1;
    }
}

fn tc_align_up_usize(off: usize, al: usize) -> usize {
    if al <= 1 { return off; }
    let rem = off % al;
    if rem == 0 { off } else { off + (al - rem) }
}

fn tc_eval_tls_const_bytes(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    ty_v: u32,
    dst: *mut u8,
    dst_cap: usize,
    out_err: mut_view<u32>,
    depth: usize
) -> bool {
    if (expr as usize) == 0 || depth > 16 || (cx.thir as usize) == 0 {
        return false;
    }
    let mut lo: u64 = 0u64;
    let mut hi: u64 = 0u64;
    if eval_const_expr_u128(mut_view(*cx), expr, mut_view(lo), mut_view(hi), mut_view(*out_err)) {
        let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: ty_v }));
        let tk = kind_of(mut_view(*cx), (TypeId { v: r_ty.v }));
        let mut norm_lo: u64 = lo;
        let mut norm_hi: u64 = hi;
        if tk != 0u8 {
            tc_norm_u128_for_kind(tk, lo, hi, mut_view(norm_lo), mut_view(norm_hi));
        }
        let esz = if r_ty.v != 0u32 {
            unsafe { type_size(r_ty, view((*cx.thir).interner)) as usize }
        } else {
            dst_cap
        };
        tc_write_u128_le(dst, dst_cap, norm_lo, norm_hi, esz);
        return true;
    }
    if *out_err != 0u32 {
        return false;
    }

    let ek = unsafe { (*expr).kind };
    let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: ty_v }));
    let r_tk = kind_of(mut_view(*cx), (TypeId { v: r_ty.v }));
    if r_tk == TY_F32 || r_tk == TY_F64 {
        // T458b: a float leaf of a `@thread_local static` initializer is a (possibly negated) float literal, whose
        // IEEE-754 bits the lexer already rounded directly to the target width (SPEC-41 AXS-FLT-003 rules 1, 3).
        let mut lit_e: *const HirExpr = expr;
        let mut neg = false;
        if ek == HIR_EXPR_UNARY && (unsafe { (*expr).op }) == UNOP_NEG {
            lit_e = unsafe { (*expr).inner as *const HirExpr };
            neg = true;
        }
        if (lit_e as usize) == 0 || (unsafe { (*lit_e).kind }) != HIR_EXPR_LITERAL ||
           (unsafe { (*lit_e).literal.kind }) != TOK_FLOAT {
            return false;
        }
        let mut bits: u64 = if r_tk == TY_F32 {
            (unsafe { (*lit_e).literal.char_val }) as u64
        } else {
            unsafe { (*lit_e).literal.int_val }
        };
        if neg {
            bits = bits ^ (if r_tk == TY_F32 { 0x80000000u64 } else { 0x8000000000000000u64 });
        }
        tc_write_u128_le(dst, dst_cap, bits, 0u64, if r_tk == TY_F32 { 4 } else { 8 });
        return true;
    }
    let t = if r_ty.v != 0u32 {
        unsafe { type_get(view((*cx.thir).interner), r_ty) }
    } else {
        0 as *mut AxType
    };

    if ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_COMPTIME {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        if (blk as usize) != 0 && (unsafe { (*blk).stmts as usize }) != 0 {
            let s0: *mut HirStmt = unsafe { (*blk).stmts };
            if (unsafe { (*s0).next as usize }) == 0 &&
               (unsafe { (*s0).kind }) == HIR_STMT_EXPR &&
               !(unsafe { (*s0).has_semi }) {
                return tc_eval_tls_const_bytes(
                    cx,
                    unsafe { (*s0).expr as *const HirExpr },
                    ty_v,
                    dst,
                    dst_cap,
                    out_err,
                    depth + 1
                );
            }
        }
        return false;
    }

    if ek == HIR_EXPR_STRUCT {
        if (t as usize) == 0 || (unsafe { (*t).kind }) != TY_STRUCT {
            return false;
        }
        let sdef = unsafe { (*t).def as *const HirItem };
        if (sdef as usize) == 0 {
            return false;
        }
        let fc = unsafe { (*t).field_count };
        let ftypes = unsafe { (*t).fields };
        let mut fdecl: *mut HirFieldDecl = unsafe { (*sdef).struct_fields };
        let mut off: usize = 0;
        let mut fi: usize = 0;
        while fi < fc && (fdecl as usize) != 0 {
            let fty_v = unsafe { (*typeid_at(ftypes, fi)).v };
            let f_sz = unsafe { type_size(TypeId { v: fty_v }, view((*cx.thir).interner)) as usize };
            let raw_al = unsafe { type_align(TypeId { v: fty_v }, view((*cx.thir).interner)) as usize };
            let f_al = if raw_al > 0 { raw_al } else { 1 };
            off = tc_align_up_usize(off, f_al);
            let decl_name_v = unsafe { (*fdecl).name.v };
            let mut matched_e: *const HirExpr = 0 as *const HirExpr;
            let mut finit: *mut HirFieldInit = unsafe { (*expr).fields };
            while (finit as usize) != 0 {
                if (unsafe { (*finit).name.v }) == decl_name_v {
                    matched_e = unsafe { (*finit).expr as *const HirExpr };
                    break;
                }
                finit = unsafe { (*finit).next };
            }
            if (matched_e as usize) == 0 {
                return false;
            }
            let sub_dst = if (dst as usize) != 0 && off < dst_cap { unsafe { dst + off } } else { 0 as *mut u8 };
            let sub_cap = if off < dst_cap { dst_cap - off } else { 0 };
            if !tc_eval_tls_const_bytes(mut_view(*cx), matched_e, fty_v, sub_dst, sub_cap, mut_view(*out_err), depth + 1) {
                return false;
            }
            off = off + f_sz;
            fi = fi + 1;
            fdecl = unsafe { (*fdecl).next };
        }
        return fi == fc;
    }

    if ek == HIR_EXPR_TUPLE {
        if (unsafe { (*expr).elems as usize }) == 0 {
            return true;
        }
        if (t as usize) == 0 || (unsafe { (*t).kind }) != TY_TUPLE {
            return false;
        }
        let fc = unsafe { (*t).field_count };
        let ftypes = unsafe { (*t).fields };
        let mut el: *mut HirExpr = unsafe { (*expr).elems };
        let mut off: usize = 0;
        let mut fi: usize = 0;
        while fi < fc && (el as usize) != 0 {
            let fty_v = unsafe { (*typeid_at(ftypes, fi)).v };
            let f_sz = unsafe { type_size(TypeId { v: fty_v }, view((*cx.thir).interner)) as usize };
            let raw_al = unsafe { type_align(TypeId { v: fty_v }, view((*cx.thir).interner)) as usize };
            let f_al = if raw_al > 0 { raw_al } else { 1 };
            off = tc_align_up_usize(off, f_al);
            let sub_dst = if (dst as usize) != 0 && off < dst_cap { unsafe { dst + off } } else { 0 as *mut u8 };
            let sub_cap = if off < dst_cap { dst_cap - off } else { 0 };
            if !tc_eval_tls_const_bytes(mut_view(*cx), el as *const HirExpr, fty_v, sub_dst, sub_cap, mut_view(*out_err), depth + 1) {
                return false;
            }
            off = off + f_sz;
            fi = fi + 1;
            el = unsafe { (*el).next };
        }
        return fi == fc && (el as usize) == 0;
    }

    if ek == HIR_EXPR_ARRAY {
        if (t as usize) == 0 || (unsafe { (*t).kind }) != TY_ARRAY {
            return false;
        }
        let el_ty_v = unsafe { (*t).elem.v };
        let el_sz = unsafe { type_size(TypeId { v: el_ty_v }, view((*cx.thir).interner)) as usize };
        let arr_len = unsafe { (*t).array_len as usize };
        if (unsafe { (*expr).count_expr as usize }) != 0 {
            let first_e: *const HirExpr = unsafe { (*expr).elems as *const HirExpr };
            if (first_e as usize) == 0 {
                return false;
            }
            let mut ai: usize = 0;
            while ai < arr_len {
                let off = mul_usize(ai, el_sz);
                let sub_dst = if (dst as usize) != 0 && off < dst_cap { unsafe { dst + off } } else { 0 as *mut u8 };
                let sub_cap = if off < dst_cap { dst_cap - off } else { 0 };
                if !tc_eval_tls_const_bytes(mut_view(*cx), first_e, el_ty_v, sub_dst, sub_cap, mut_view(*out_err), depth + 1) {
                    return false;
                }
                ai = ai + 1;
            }
            return true;
        }
        let mut cur_e: *mut HirExpr = unsafe { (*expr).elems };
        let mut ai: usize = 0;
        while ai < arr_len && (cur_e as usize) != 0 {
            let off = mul_usize(ai, el_sz);
            let sub_dst = if (dst as usize) != 0 && off < dst_cap { unsafe { dst + off } } else { 0 as *mut u8 };
            let sub_cap = if off < dst_cap { dst_cap - off } else { 0 };
            if !tc_eval_tls_const_bytes(mut_view(*cx), cur_e as *const HirExpr, el_ty_v, sub_dst, sub_cap, mut_view(*out_err), depth + 1) {
                return false;
            }
            ai = ai + 1;
            cur_e = unsafe { (*cur_e).next };
        }
        return ai == arr_len && (cur_e as usize) == 0;
    }

    false
}

fn typeck_eval_tls_aggregate(
    cx: mut_view<TypeckCtx>,
    cexpr: *const HirExpr,
    ty_v: u32,
    out_cv: mut_view<ConstValue>
) -> bool {
    if (cexpr as usize) == 0 { return false; }
    let ek = unsafe { (*cexpr).kind };
    let mut fn_sym_v: u32 = 0u32;
    let mut drop_sym_v: u32 = 0u32;

    if ek == HIR_EXPR_METHOD_CALL {
        let m_arg0: *mut HirExpr = unsafe { (*cexpr).args };
        fn_sym_v = typeck_extract_fn_sym_from_arg(view(*cx), m_arg0 as *const HirExpr);
        if (m_arg0 as usize) != 0 {
            let m_arg1: *mut HirExpr = unsafe { (*m_arg0).next };
            drop_sym_v = typeck_extract_fn_sym_from_arg(view(*cx), m_arg1 as *const HirExpr);
        }
    } else if ek == HIR_EXPR_CALL {
        let c_arg0: *mut HirExpr = unsafe { (*cexpr).args };
        fn_sym_v = typeck_extract_fn_sym_from_arg(view(*cx), c_arg0 as *const HirExpr);
        if (c_arg0 as usize) != 0 {
            let c_arg1: *mut HirExpr = unsafe { (*c_arg0).next };
            drop_sym_v = typeck_extract_fn_sym_from_arg(view(*cx), c_arg1 as *const HirExpr);
        }
    } else if ek == HIR_EXPR_STRUCT {
        let mut fld: *mut HirFieldInit = unsafe { (*cexpr).fields };
        while (fld as usize) != 0 {
            let fname_sv = unsafe { interner_get(view(*cx.str_in), (*fld).name) };
            if fname_sv.len == 7 && unsafe { *fname_sv.ptr == 105u8 } {
                fn_sym_v = typeck_extract_fn_sym_from_arg(view(*cx), unsafe { (*fld).expr as *const HirExpr });
            } else if fname_sv.len == 7 && unsafe { *fname_sv.ptr == 100u8 } {
                drop_sym_v = typeck_extract_fn_sym_from_arg(view(*cx), unsafe { (*fld).expr as *const HirExpr });
            }
            fld = unsafe { (*fld).next };
        }
    }

    if fn_sym_v == 0u32 {
        if (cx.thir as usize) == 0 { return false; }
        let raw_sz = if ty_v != 0u32 {
            unsafe { type_size(TypeId { v: ty_v }, view((*cx.thir).interner)) as usize }
        } else {
            0
        };
        let raw_al = if ty_v != 0u32 {
            unsafe { type_align(TypeId { v: ty_v }, view((*cx.thir).interner)) as usize }
        } else {
            0
        };
        let c_sz = if raw_sz > 0 { raw_sz } else { 1 };
        let c_al = if raw_al > 0 { raw_al } else { 1 };
        let c_buf = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), c_sz, c_al) };
        if (c_buf as usize) == 0 { return false; }
        let mut c_zi: usize = 0;
        while c_zi < c_sz {
            unsafe { *(c_buf + c_zi) = 0u8; }
            c_zi = c_zi + 1;
        }
        let mut dummy_err: u32 = 0u32;
        if !tc_eval_tls_const_bytes(mut_view(*cx), cexpr, ty_v, c_buf, c_sz, mut_view(dummy_err), 0) {
            return false;
        }
        let s_rty = resolve_ty(mut_view(*cx), (TypeId { v: ty_v }));
        let s_tk = kind_of(mut_view(*cx), (TypeId { v: s_rty.v }));
        if s_tk == TY_F32 || s_tk == TY_F64 {
            // T458b: a scalar float initializer is a ConstValue.Float (bits in int_val), like a session-evaluated one.
            out_cv.kind = CONST_FLOAT;
            out_cv.ty = TypeId { v: ty_v };
            out_cv.int_val = if s_tk == TY_F32 { (unsafe { *(c_buf as *const u32) }) as u64 } else { unsafe { *(c_buf as *const u64) } };
            out_cv.str_bytes = 0 as *const u8;
            out_cv.str_len = 0;
            out_cv.agg_data = 0 as *mut u8;
            out_cv.agg_size = 0;
            out_cv.agg_align = 0;
            out_cv.alloc_id = 0u32;
            return true;
        }
        out_cv.kind = CONST_AGGREGATE;
        out_cv.ty = TypeId { v: ty_v };
        out_cv.int_val = 0u64;
        out_cv.str_bytes = 0 as *const u8;
        out_cv.str_len = 0;
        out_cv.agg_data = c_buf;
        out_cv.agg_size = c_sz;
        out_cv.agg_align = c_al;
        out_cv.alloc_id = 0u32;
        return true;
    }

    let mut sz: usize = 24;
    let mut al: usize = 8;
    if ty_v != 0u32 && (cx.thir as usize) != 0 {
        let raw_sz = unsafe { type_size(TypeId { v: ty_v }, view((*cx.thir).interner)) } as usize;
        let raw_al = unsafe { type_align(TypeId { v: ty_v }, view((*cx.thir).interner)) } as usize;
        if raw_sz > 0 { sz = raw_sz; }
        if raw_al > 0 { al = raw_al; }
    }
    if sz < 24 { sz = 24; }
    if al < 8 { al = 8; }

    let agg_buf = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), sz, al) };
    if (agg_buf as usize) == 0 { return false; }

    let mut zi: usize = 0;
    while zi < sz {
        unsafe { *(agg_buf + zi) = 0u8; }
        zi = zi + 1;
    }

    unsafe {
        let p_u64 = agg_buf as *mut u64;
        *p_u64 = fn_sym_v as u64;
        if drop_sym_v != 0u32 && sz >= 16 {
            let p_u64_1 = (agg_buf + 8) as *mut u64;
            *p_u64_1 = drop_sym_v as u64;
        }
    }

    out_cv.kind = CONST_AGGREGATE;
    out_cv.ty = TypeId { v: ty_v };
    out_cv.int_val = 0u64;
    out_cv.str_bytes = 0 as *const u8;
    out_cv.str_len = 0;
    out_cv.agg_data = agg_buf;
    out_cv.agg_size = sz;
    out_cv.agg_align = al;
    out_cv.alloc_id = fn_sym_v;
    true
}

fn evaluate_const_item_in_impl(cx: mut_view<TypeckCtx>, it: *const HirItem, parent_impl: *const HirItem) {
    if (it as usize) == 0 { return; }
    let ik = unsafe { (*it).kind };
    if ik != HIR_ITEM_CONST && ik != HIR_ITEM_STATIC { return; }
    let sym_v = unsafe { (*it).symbol.v };
    if sym_v != 0u32 {
        let existing = unsafe { sym_constmap_get(view((*cx.thir).symbol_consts), (SymbolId { v: sym_v })) };
        if (existing as usize) != 0 { return; }
        let mut i: usize = 0;
        while (i < cx.const_eval_stack_len) {
            let sv = unsafe { (*symid_at(cx.const_eval_stack, i)).v };
            if sv == sym_v {
                let fv = unsafe { (*it).span.file.v };
                let st = unsafe { (*it).span.start };
                let en = unsafe { (*it).span.end };
                type_error_sp(mut_view(*cx), fv, st, en, AX_CONST_CYCLE);
                let err_t = unsafe { (*cx.thir).interner.t_error.v };
                let err_val = ConstValue {
                    kind: CONST_ERROR,
                    ty: (TypeId { v: err_t }),
                    int_val: 0u64,
                    str_bytes: 0 as *const u8,
                    str_len: 0,
                    agg_data: 0 as *mut u8,
                    agg_size: 0,
                    agg_align: 0,
                    alloc_id: 0u32,
                };
                unsafe { sym_constmap_insert(mut_view((*cx.thir).symbol_consts), (SymbolId { v: sym_v }), view(err_val)); }
                return;
            }
            i = i + 1;
        }
    }
    let cexpr: *mut HirExpr = unsafe { (*it).expr };
    if (cexpr as usize) != 0 {
        let existing_ety = unsafe { thir_get_expr_type(view(*cx.thir), cexpr) };
        if existing_ety.v != 0u32 { return; }
    }
    if sym_v != 0u32 {
        push_const_stack(mut_view(*cx), (SymbolId { v: sym_v }));
    }

    let save_fn = cx.current_fn;
    let save_impl = cx.current_impl;
    let save_ret = cx.return_type;
    let save_in_loop = cx.in_loop;
    let save_in_closure = cx.in_closure;
    let saved_start = cx.type_vars.fn_var_start;
    let saved_lits = cx.lits_len;
    let saved_negs = cx.negs_len;
    let saved_vars_len = cx.vars_len;

    cx.current_fn = 0 as *const HirItem;
    cx.current_impl = parent_impl;
    cx.return_type = (TypeId { v: 0u32 });
    cx.in_loop = false;
    cx.in_closure = false;
    cx.type_vars.fn_var_start = cx.type_vars.len;
    cx.lits_len = 0;
    cx.negs_len = 0;
    cx.vars_len = 0;

    let cty_ptr: *mut HirType = unsafe { (*it).ty };
    let ty = hir_type_to_typeid(mut_view(*cx), cty_ptr);
    unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: ty.v })); }
    if sym_v != 0u32 {
        unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: sym_v }), (TypeId { v: ty.v })); }
    }
    let _ = is_valid_const_type(mut_view(*cx), (TypeId { v: ty.v }));

    let errs_before: usize = if (cx.sink as usize) != 0 { unsafe { (*cx.sink).errors } } else { 0 };
    if (cexpr as usize) != 0 {
        check_expr(mut_view(*cx), cexpr, (TypeId { v: ty.v }));
        default_int_vars(mut_view(*cx));
        check_literal_ranges(mut_view(*cx));
    }
    let errs_after: usize = if (cx.sink as usize) != 0 { unsafe { (*cx.sink).errors } } else { 0 };

    let mut iv: u64 = 0u64;
    let mut iv_hi: u64 = 0u64;
    let mut eval_err: u32 = 0u32;
    let mut ok = false;
    let mut is_agg = false;
    if (cexpr as usize) != 0 && errs_after == errs_before {
        ok = eval_const_expr_u128(mut_view(*cx), cexpr, mut_view(iv), mut_view(iv_hi), mut_view(eval_err));
        if !ok && ik == HIR_ITEM_STATIC {
            let mut agg_cv = ConstValue {
                kind: CONST_ERROR,
                ty: (TypeId { v: 0u32 }),
                int_val: 0u64,
                str_bytes: 0 as *const u8,
                str_len: 0,
                agg_data: 0 as *mut u8,
                agg_size: 0,
                agg_align: 0,
                alloc_id: 0u32,
            };
            if ((unsafe { (*it).is_tls }) && typeck_eval_tls_aggregate(mut_view(*cx), cexpr, ty.v, mut_view(agg_cv))) ||
               (!(unsafe { (*it).is_tls }) && eval_err == 0u32 && (unsafe { (*cexpr).kind }) != HIR_EXPR_CALL &&
                (unsafe { (*cexpr).kind }) != HIR_EXPR_METHOD_CALL &&
                typeck_eval_tls_aggregate(mut_view(*cx), cexpr, ty.v, mut_view(agg_cv))) {
                unsafe { sym_constmap_insert(mut_view((*cx.thir).symbol_consts), (SymbolId { v: sym_v }), view(agg_cv)); }
                ok = true;
                is_agg = true;
                eval_err = 0u32;
            }
        }
        if eval_err != 0u32 {
            let efv = unsafe { (*cexpr).span.file.v };
            let est = unsafe { (*cexpr).span.start };
            let een = unsafe { (*cexpr).span.end };
            type_error_sp(mut_view(*cx), efv, est, een, eval_err);
        }
    }

    cx.type_vars.fn_var_start = saved_start;
    cx.lits_len = saved_lits;
    cx.negs_len = saved_negs;
    cx.vars_len = saved_vars_len;
    cx.current_fn = save_fn;
    cx.current_impl = save_impl;
    cx.return_type = save_ret;
    cx.in_loop = save_in_loop;
    cx.in_closure = save_in_closure;

    if sym_v != 0u32 && cx.const_eval_stack_len > 0 {
        cx.const_eval_stack_len = cx.const_eval_stack_len - 1;
    }
    if ok && !is_agg && eval_err == 0u32 && sym_v != 0u32 {
        let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        let tk = kind_of(mut_view(*cx), (TypeId { v: r_ty.v }));
        let mut norm_lo: u64 = iv;
        let mut norm_hi: u64 = iv_hi;
        if tk != 0u8 {
            tc_norm_u128_for_kind(tk, iv, iv_hi, mut_view(norm_lo), mut_view(norm_hi));
        }
        let mut cv = ConstValue {
            kind: CONST_INT,
            ty: (TypeId { v: r_ty.v }),
            int_val: norm_lo,
            str_bytes: 0 as *const u8,
            str_len: 0,
            agg_data: 0 as *mut u8,
            agg_size: 0,
            agg_align: 0,
            alloc_id: 0u32,
        };
        const_val_set_int_hi(mut_view(cv), if tk == TY_I128 || tk == TY_U128 { norm_hi } else { 0u64 });
        unsafe { sym_constmap_insert(mut_view((*cx.thir).symbol_consts), (SymbolId { v: sym_v }), view(cv)); }
    }
}

pub fn evaluate_const_item(cx: mut_view<TypeckCtx>, it: *const HirItem) {
    evaluate_const_item_in_impl(mut_view(*cx), it, 0 as *const HirItem);
}

// Mirrors axiom0 `eval_array_len_expr` (typeck.c): an integer literal is taken as is (never
// type-checked, so it carries no THIR type), `-e` is rejected before any checking, any other
// expression is checked without an expected type (int vars default to i32), must be an integer
// and is then const-evaluated (T156: dump parity).
fn eval_array_len_expr(cx: mut_view<TypeckCtx>, len_expr: *const HirExpr, out_len: mut_view<u64>) -> bool {
    *out_len = 0u64;
    if (len_expr as usize) == 0 { return false; }
    let lk = unsafe { (*len_expr).kind };
    let fv = unsafe { (*len_expr).span.file.v };
    let st = unsafe { (*len_expr).span.start };
    let en = unsafe { (*len_expr).span.end };
    if lk == HIR_EXPR_LITERAL && unsafe { (*len_expr).literal.kind } == TOK_INT {
        if unsafe { token_int_hi(view((*len_expr).literal)) } != 0u64 {
            type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_ARRAY_SIZE);
            return false;
        }
        *out_len = unsafe { (*len_expr).literal.int_val };
        return true;
    }
    if lk == HIR_EXPR_UNARY && unsafe { (*len_expr).op } == UNOP_NEG {
        type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_ARRAY_SIZE);
        return false;
    }
    let saved_start = cx.type_vars.fn_var_start;
    let saved_lits = cx.lits_len;
    let saved_negs = cx.negs_len;
    cx.type_vars.fn_var_start = cx.type_vars.len;
    cx.lits_len = 0;
    cx.negs_len = 0;

    let errs_before: usize = if (cx.sink as usize) != 0 { unsafe { (*cx.sink).errors } } else { 0 };
    let len_ty = check_expr(mut_view(*cx), len_expr, (TypeId { v: 0u32 }));
    default_int_vars(mut_view(*cx));
    check_literal_ranges(mut_view(*cx));
    let errs_after: usize = if (cx.sink as usize) != 0 { unsafe { (*cx.sink).errors } } else { 0 };

    cx.type_vars.fn_var_start = saved_start;
    cx.lits_len = saved_lits;
    cx.negs_len = saved_negs;

    if is_error(mut_view(*cx), (TypeId { v: len_ty.v })) || errs_after > errs_before { return false; }
    let resolved = resolve_ty(mut_view(*cx), (TypeId { v: len_ty.v }));
    if !unsafe { type_is_int((TypeId { v: resolved.v }), view((*cx.thir).interner)) } {
        type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_ARRAY_SIZE);
        return false;
    }

    let mut val: u64 = 0u64;
    let mut val_hi: u64 = 0u64;
    let mut eval_err: u32 = 0u32;
    if !eval_const_expr_u128(mut_view(*cx), len_expr, mut_view(val), mut_view(val_hi), mut_view(eval_err)) {
        let code_v = if eval_err != 0u32 { eval_err } else { AX_TYPE_ARRAY_SIZE };
        type_error_sp(mut_view(*cx), fv, st, en, code_v);
        return false;
    }
    let rk = kind_of(mut_view(*cx), (TypeId { v: resolved.v }));
    let is_sig = unsafe { type_is_signed((TypeId { v: resolved.v }), view((*cx.thir).interner)) };
    if is_sig {
        let is_neg = if rk == TY_I128 {
            (val_hi & 0x8000000000000000u64) != 0u64
        } else {
            (val as i64) < 0i64
        };
        if is_neg || val_hi != 0u64 {
            type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_ARRAY_SIZE);
            return false;
        }
    } else if val_hi != 0u64 {
        type_error_sp(mut_view(*cx), fv, st, en, AX_TYPE_ARRAY_SIZE);
        return false;
    }
    *out_len = val;
    true
}

fn tc_struct_is_lang_atomic(def: *const HirItem, str_in: view<StrInterner>) -> bool {
    if (def as usize) == 0 || unsafe { (*def).kind } != HIR_ITEM_STRUCT {
        return false;
    }
    let sname_v = unsafe { (*def).name.v };
    if sname_v == 0u32 {
        return false;
    }
    let sname = interner_get(str_in, (StrId { v: sname_v }));
    if !tc_sv_is_6(view(sname), 65u8, 116u8, 111u8, 109u8, 105u8, 99u8) { // Atomic
        return false;
    }
    let mut attr: *mut HirAttr = unsafe { (*def).attrs };
    while (attr as usize) != 0 {
        let aname_v = unsafe { (*attr).name.v };
        if aname_v != 0u32 {
            let sv = interner_get(str_in, (StrId { v: aname_v }));
            if tc_sv_is_4(view(sv), 108u8, 97u8, 110u8, 103u8) { // lang
                return true;
            }
        }
        attr = unsafe { (*attr).next };
    }
    false
}

fn tc_type_is_lang_atomic(ti: view<TypeInterner>, str_in: view<StrInterner>, ty: TypeId, out_inner: mut_view<TypeId>) -> bool {
    *out_inner = TypeId { v: 0u32 };
    if ty.v == 0u32 { return false; }
    let t = type_get(ti, (TypeId { v: ty.v }));
    if (t as usize) == 0 || unsafe { (*t).kind } != TY_STRUCT {
        return false;
    }
    let sdef = unsafe { (*t).def };
    if !tc_struct_is_lang_atomic(sdef, str_in) {
        return false;
    }
    if unsafe { (*t).arg_count } > 0 && (unsafe { (*t).args as usize }) != 0 {
        *out_inner = TypeId { v: unsafe { (*typeid_at((*t).args, 0)).v } };
    } else if unsafe { (*t).field_count } > 0 && (unsafe { (*t).fields as usize }) != 0 {
        *out_inner = TypeId { v: unsafe { (*typeid_at((*t).fields, 0)).v } };
    }
    true
}

fn tc_is_valid_atomic_payload(ti: view<TypeInterner>, inner_ty: TypeId) -> bool {
    if inner_ty.v == 0u32 { return true; }
    let t = type_get(ti, (TypeId { v: inner_ty.v }));
    if (t as usize) == 0 { return true; }
    let k = unsafe { (*t).kind };
    if k == TY_ERROR || k == TY_VAR || k == TY_INT_VAR || k == TY_PARAM || k == TY_NEVER {
        return true;
    }
    if k == TY_BOOL || k == TY_PTR {
        return true;
    }
    if k >= TY_I8 && k <= TY_USIZE && k != TY_I128 && k != TY_U128 {
        return true;
    }
    false
}

fn tc_eval_ordering_arg(cx: mut_view<TypeckCtx>, ord_expr: *const HirExpr, out_ord: mut_view<u64>) -> bool {
    *out_ord = 0u64;
    if (ord_expr as usize) == 0 { return false; }
    let ek = unsafe { (*ord_expr).kind };
    if ek == HIR_EXPR_PATH {
        let sym_v = unsafe { (*ord_expr).path.symbol.v };
        if sym_v != 0u32 {
            let mut k: usize = 0;
            while k < cx.vars_len {
                let vs = unsafe { varstate_at(cx.vars, k) };
                if unsafe { (*vs).sym.v } == sym_v {
                    unsafe { type_error(mut_view(*cx), view((*ord_expr).span), AX_CONC_INVALID_ATOMIC_ORDERING); }
                    return false;
                }
                k = k + 1;
            }
            if (cx.current_fn as usize) != 0 {
                let mut p: *mut HirParam = unsafe { (*cx.current_fn).params };
                while (p as usize) != 0 {
                    if unsafe { (*p).symbol.v } == sym_v {
                        unsafe { type_error(mut_view(*cx), view((*ord_expr).span), AX_CONC_INVALID_ATOMIC_ORDERING); }
                        return false;
                    }
                    p = unsafe { (*p).next };
                }
            }
        }
    }
    let mut ord_lo: u64 = 0u64;
    let mut ord_hi: u64 = 0u64;
    let mut eval_err: u32 = 0u32;
    if eval_const_expr_u128(mut_view(*cx), ord_expr, mut_view(ord_lo), mut_view(ord_hi), mut_view(eval_err)) {
        if ord_hi == 0u64 && ord_lo <= 4u64 {
            unsafe { thir_set_expr_variant(mut_view(*cx.thir), ord_expr, ord_lo as u32); }
            *out_ord = ord_lo;
            return true;
        }
    }
    unsafe { type_error(mut_view(*cx), view((*ord_expr).span), AX_CONC_INVALID_ATOMIC_ORDERING); }
    false
}

fn tc_validate_ordering_op(cx: mut_view<TypeckCtx>, sp: view<Span>, op_kind: u8, ord: u64, fail_ord: u64) {
    if op_kind == 1u8 {
        if ord == 2u64 || ord == 3u64 {
            type_error(mut_view(*cx), sp, AX_CONC_INVALID_ATOMIC_ORDERING);
        }
    } else if op_kind == 2u8 {
        if ord == 1u64 || ord == 3u64 {
            type_error(mut_view(*cx), sp, AX_CONC_INVALID_ATOMIC_ORDERING);
        }
    } else if op_kind == 3u8 {
        if fail_ord == 2u64 || fail_ord == 3u64 ||
           ((ord == 0u64 || ord == 2u64) && fail_ord != 0u64) ||
           ((ord == 1u64 || ord == 3u64) && fail_ord == 4u64) {
            type_error(mut_view(*cx), sp, AX_CONC_INVALID_ATOMIC_ORDERING);
        }
    } else if op_kind == 4u8 {
        if ord == 0u64 {
            type_error(mut_view(*cx), sp, AX_CONC_INVALID_ATOMIC_ORDERING);
        }
    }
}

pub fn hir_type_to_typeid(cx: mut_view<TypeckCtx>, ht: *const HirType) -> TypeId {
    if (ht as usize) == 0 { return (TypeId { v: 0u32 }); }
    let k = unsafe { (*ht).kind };
    if k == HIR_TYPE_ERROR {
        let ev = unsafe { (*cx.thir).interner.t_error.v };
        return (TypeId { v: ev });
    }
    if k == HIR_TYPE_PATH {
        let name = unsafe { tc_path_name_sv(view(*cx), view((*ht).path)) };
        unsafe {
            if tc_sv_is_3(view(name), 105u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_i32.v }); } // i32
            if tc_sv_is_3(view(name), 117u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_u32.v }); } // u32
            if tc_sv_is_3(view(name), 105u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_i64.v }); } // i64
            if tc_sv_is_3(view(name), 117u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_u64.v }); } // u64
            if tc_sv_is_4(view(name), 105u8, 49u8, 50u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_i128.v }); } // i128
            if tc_sv_is_4(view(name), 117u8, 49u8, 50u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_u128.v }); } // u128
            if tc_sv_is_3(view(name), 105u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_i16.v }); } // i16
            if tc_sv_is_3(view(name), 117u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_u16.v }); } // u16
            if tc_sv_is_2(view(name), 105u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_i8.v }); } // i8
            if tc_sv_is_2(view(name), 117u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_u8.v }); } // u8
            if tc_sv_is_5(view(name), 105u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_isize.v }); } // isize
            if tc_sv_is_5(view(name), 117u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_usize.v }); } // usize
            if tc_sv_is_4(view(name), 98u8, 111u8, 111u8, 108u8) { return (TypeId { v: (*cx.thir).interner.t_bool.v }); } // bool
            if tc_sv_is_4(view(name), 99u8, 104u8, 97u8, 114u8) { return (TypeId { v: (*cx.thir).interner.t_char.v }); } // char
            if tc_sv_is_3(view(name), 83u8, 116u8, 114u8) { return (TypeId { v: (*cx.thir).interner.t_str.v }); } // Str
            if tc_sv_is_5(view(name), 110u8, 101u8, 118u8, 101u8, 114u8) { return (TypeId { v: (*cx.thir).interner.t_never.v }); } // never
            if tc_sv_is_3(view(name), 102u8, 51u8, 50u8) { return (TypeId { v: TYPEID_F32 }); } // f32
            if tc_sv_is_3(view(name), 102u8, 54u8, 52u8) { return (TypeId { v: TYPEID_F64 }); } // f64
        }
        let mut dummy_gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let res_ty = unsafe { lookup_path_type(mut_view(*cx), view((*ht).path), mut_view(dummy_gargs)) };
        if (cx.str_in as usize) != 0 {
            let mut inner_ty = (TypeId { v: 0u32 });
            if unsafe { tc_type_is_lang_atomic(view((*cx.thir).interner), view(*cx.str_in), (TypeId { v: res_ty.v }), mut_view(inner_ty)) } {
                let r_in = resolve_ty(mut_view(*cx), (TypeId { v: inner_ty.v }));
                if !unsafe { tc_is_valid_atomic_payload(view((*cx.thir).interner), (TypeId { v: r_in.v })) } {
                    return unsafe { type_error(mut_view(*cx), view((*ht).span), AX_CONC_INVALID_ATOMIC_TYPE) };
                }
            }
        }
        return (TypeId { v: res_ty.v });
    }
    if k == HIR_TYPE_FN {
        let is_u = unsafe { (*ht).is_unsafe };
        let abi_v = unsafe { (*ht).abi.v };
        let rt_ptr: *mut HirType = unsafe { (*ht).ret_type };
        let rt_id = hir_type_to_typeid(mut_view(*cx), rt_ptr);

        let mut count: usize = 0;
        let mut p: *mut HirType = unsafe { (*ht).param_types };
        while ((p as usize) != 0) {
            count = count + 1;
            p = unsafe { (*p).next };
        }
        let mut ptypes: *mut TypeId = 0 as *mut TypeId;
        if count > 0 {
            let bytes = mul_usize(count, size_of<TypeId>());
            ptypes = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
            let mut i: usize = 0;
            p = unsafe { (*ht).param_types };
            while ((p as usize) != 0) {
                let pid = hir_type_to_typeid(mut_view(*cx), p);
                let dst = unsafe { typeid_at(ptypes, i) };
                unsafe { (*dst).v = pid.v; }
                i = i + 1;
                p = unsafe { (*p).next };
            }
        }
        return unsafe { intern_fn_ty(mut_view((*cx.thir).interner), is_u, (StrId { v: abi_v }), ptypes, count, (TypeId { v: rt_id.v })) };
    }
    if k == HIR_TYPE_ARRAY {
        let elem_ptr: *mut HirType = unsafe { (*ht).elem };
        let elem = hir_type_to_typeid(mut_view(*cx), elem_ptr);
        let mut arr_len: u64 = 0u64;
        let cnt_expr: *mut HirExpr = unsafe { (*ht).count_expr };
        if !eval_array_len_expr(mut_view(*cx), cnt_expr, mut_view(arr_len)) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        return unsafe { intern_array_ty(mut_view((*cx.thir).interner), (TypeId { v: elem.v }), arr_len) };
    }
    if k == HIR_TYPE_TUPLE {
        let mut count: usize = 0;
        let mut e: *mut HirType = unsafe { (*ht).elem_types };
        while ((e as usize) != 0) {
            count = count + 1;
            e = unsafe { (*e).next };
        }
        if count == 0 {
            let uv = unsafe { (*cx.thir).interner.t_unit.v };
            return (TypeId { v: uv });
        }
        let bytes = mul_usize(count, size_of<TypeId>());
        let fields = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
        let mut i: usize = 0;
        e = unsafe { (*ht).elem_types };
        while ((e as usize) != 0) {
            let eid = hir_type_to_typeid(mut_view(*cx), e);
            let dst = unsafe { typeid_at(fields, i) };
            unsafe { (*dst).v = eid.v; }
            i = i + 1;
            e = unsafe { (*e).next };
        }
        return unsafe { intern_tuple_ty(mut_view((*cx.thir).interner), fields, count) };
    }
    if k == HIR_TYPE_SLICE {
        let elem_ptr: *mut HirType = unsafe { (*ht).elem };
        let elem = hir_type_to_typeid(mut_view(*cx), elem_ptr);
        return unsafe { intern_slice_ty(mut_view((*cx.thir).interner), (TypeId { v: elem.v })) };
    }
    if k == HIR_TYPE_VIEW {
        let is_m = unsafe { (*ht).is_mut };
        let elem_ptr: *mut HirType = unsafe { (*ht).elem };
        let pt = hir_type_to_typeid(mut_view(*cx), elem_ptr);
        if is_m && (cx.str_in as usize) != 0 {
            let mut dummy_in = (TypeId { v: 0u32 });
            let r_pt = resolve_ty(mut_view(*cx), (TypeId { v: pt.v }));
            if unsafe { tc_type_is_lang_atomic(view((*cx.thir).interner), view(*cx.str_in), (TypeId { v: r_pt.v }), mut_view(dummy_in)) } {
                return unsafe { type_error(mut_view(*cx), view((*ht).span), AX_CONC_ATOMIC_MUT_VIEW) };
            }
        }
        return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: pt.v }), is_m) };
    }
    if k == HIR_TYPE_PTR {
        let is_m = unsafe { (*ht).is_mut };
        let elem_ptr: *mut HirType = unsafe { (*ht).elem };
        let pt = hir_type_to_typeid(mut_view(*cx), elem_ptr);
        return unsafe { intern_ptr_ty(mut_view((*cx.thir).interner), (TypeId { v: pt.v }), is_m) };
    }
    unsafe { type_error(mut_view(*cx), view((*ht).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) }
}

fn instantiate_path(
    cx: mut_view<TypeckCtx>,
    ty: TypeId,
    it: *const HirItem,
    path: view<HirPath>,
    out_args: mut_view<GenericArgsSlice>
) -> TypeId {
    if ty.v == 0u32 || (it as usize) == 0 { return (TypeId { v: ty.v }); }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    let mut param_count: usize = 0;
    if (gps as usize) != 0 {
        let mut p: *mut HirGenericParam = unsafe { (*gps).params };
        while ((p as usize) != 0) {
            param_count = param_count + 1;
            p = unsafe { (*p).next };
        }
    }
    if param_count == 0 { return (TypeId { v: ty.v }); }

    let bytes = mul_usize(param_count, size_of<TypeId>());
    let args_arr = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
    let gargs = (GenericArgsSlice { args: args_arr, count: param_count });

    let hga: *mut HirGenericArgs = path.generic_args;
    if (hga as usize) != 0 {
        let mut arg_count: usize = 0;
        let mut a: *mut HirGenericArg = unsafe { (*hga).args };
        while ((a as usize) != 0) {
            arg_count = arg_count + 1;
            a = unsafe { (*a).next };
        }
        if arg_count != param_count {
            return type_error(mut_view(*cx), view(path.span), AX_TYPE_ARG_COUNT);
        }
        let mut i: usize = 0;
        a = unsafe { (*hga).args };
        while ((a as usize) != 0) {
            let aty_ptr: *mut HirType = unsafe { (*a).ty };
            let aty = hir_type_to_typeid(mut_view(*cx), aty_ptr);
            let dst = unsafe { typeid_at(args_arr, i) };
            unsafe { (*dst).v = aty.v; }
            i = i + 1;
            a = unsafe { (*a).next };
        }
    } else {
        let mut i: usize = 0;
        while (i < param_count) {
            let tv = new_ty_var(mut_view(*cx), view(path.span));
            let dst = unsafe { typeid_at(args_arr, i) };
            unsafe { (*dst).v = tv.v; }
            i = i + 1;
        }
    }

    out_args.args = args_arr;
    out_args.count = param_count;
    unsafe {
        subst_ty_with_vars(mut_view((*cx.thir).interner), mut_view(cx.type_vars), (TypeId { v: ty.v }), view(gargs))
    }
}

fn builtin_name_kind(name: view<StrView>) -> u8 {
    let n = name.len;
    if (name.ptr as usize) == 0 || n < 3 || n > 32 { return 0u8; }
    if n == 3 && tc_sv_is_3(name, 108u8, 101u8, 110u8) { return TY_BUILTIN_LEN; }
    if n == 4 && tc_sv_is_4(name, 100u8, 114u8, 111u8, 112u8) { return TY_BUILTIN_DROP; }
    if n == 5 && tc_sv_is_5(name, 112u8, 114u8, 105u8, 110u8, 116u8) { return TY_BUILTIN_PRINT; }
    if n == 9 && tc_sv_is_9(name, 112u8, 114u8, 105u8, 110u8, 116u8, 95u8, 105u8, 110u8, 116u8) { return TY_BUILTIN_PRINT_INT; }
    let iref = intrinsic_lookup(StrView { ptr: name.ptr, len: name.len });
    if iref.has_desc {
        return iref.desc.builtin_ty;
    }
    0u8
}

fn tc_attr_is_intrinsic(at: *const HirAttr, str_in: view<StrInterner>) -> bool {
    if (at as usize) == 0 {
        return false;
    }
    let aname = unsafe { (*at).name };
    if aname.v == 0u32 {
        return false;
    }
    let sv = interner_get(str_in, StrId { v: aname.v });
    tc_sv_is_9(view(sv), 105u8, 110u8, 116u8, 114u8, 105u8, 110u8, 115u8, 105u8, 99u8)
}

fn tc_attr_is_host_lang(at: *const HirAttr, str_in: view<StrInterner>) -> bool {
    if (at as usize) == 0 {
        return false;
    }
    let aname = unsafe { (*at).name };
    if aname.v == 0u32 {
        return false;
    }
    let sv = interner_get(str_in, StrId { v: aname.v });
    if sv.len != 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    if unsafe { !(*(sv.ptr + 0) == 108u8 && *(sv.ptr + 1) == 97u8 && *(sv.ptr + 2) == 110u8 && *(sv.ptr + 3) == 103u8) } {
        return false;
    }
    let arg: *mut HirAttrArg = unsafe { (*at).args };
    if (arg as usize) == 0 || (unsafe { (*arg).next } as usize) != 0 {
        return false;
    }
    let aexpr: *mut HirExpr = unsafe { (*arg).expr };
    if (aexpr as usize) == 0 || unsafe { (*aexpr).kind } != HIR_EXPR_LITERAL {
        return false;
    }
    if unsafe { (*aexpr).literal.kind } == TOK_INT {
        return unsafe { (*aexpr).literal.int_val } == ((36u32 << 8u32) as u64);
    }
    let sptr = unsafe { (*aexpr).literal.str_ptr };
    let slen = unsafe { (*aexpr).literal.str_len };
    if slen != 14 || (sptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sptr + 0) == 104u8 && *(sptr + 1) == 111u8 && *(sptr + 2) == 115u8 && *(sptr + 3) == 116u8 &&
        *(sptr + 4) == 95u8 && *(sptr + 5) == 105u8 && *(sptr + 6) == 110u8 && *(sptr + 7) == 116u8 &&
        *(sptr + 8) == 114u8 && *(sptr + 9) == 105u8 && *(sptr + 10) == 110u8 && *(sptr + 11) == 115u8 &&
        *(sptr + 12) == 105u8 && *(sptr + 13) == 99u8
    }
}

fn tc_item_fn_name(it: *const HirItem, str_in: view<StrInterner>) -> StrView {
    if (it as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let fn_name_id = unsafe { (*it).name };
    if fn_name_id.v == 0u32 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    interner_get(str_in, StrId { v: fn_name_id.v })
}

fn intrinsic_attr_builtin_ty(it: *const HirItem, str_in: view<StrInterner>) -> u8 {
    if (it as usize) == 0 || unsafe { (*it).kind } != HIR_ITEM_FN {
        return 0u8;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        if tc_attr_is_intrinsic(at, str_in) || tc_attr_is_host_lang(at, str_in) {
            let arg: *mut HirAttrArg = unsafe { (*at).args };
            if (arg as usize) != 0 && (unsafe { (*arg).next } as usize) == 0 {
                let aexpr: *mut HirExpr = unsafe { (*arg).expr };
                if (aexpr as usize) != 0 && unsafe { (*aexpr).kind } == HIR_EXPR_LITERAL && unsafe { (*aexpr).literal.kind } == TOK_INT {
                    let encoded = unsafe { (*aexpr).literal.int_val };
                    let bty = ((encoded >> 32u64) & 0xFFu64) as u8;
                    if bty != 0u8 {
                        return bty;
                    }
                }
            }
            let fn_name = tc_item_fn_name(it, str_in);
            let iref = intrinsic_lookup(fn_name);
            if iref.has_desc {
                return iref.desc.builtin_ty;
            }
            return 0u8;
        }
        at = unsafe { (*at).next };
    }
    0u8
}

fn tc_host_aio_intrinsic_kind(name: view<StrView>) -> u8 {
    let n = name.len;
    let p = name.ptr;
    if (p as usize) == 0 || n < 8 || n > 21 {
        return 0u8;
    }
    // Must start with "aio_"
    if unsafe { !(*(p + 0) == 97u8 && *(p + 1) == 105u8 && *(p + 2) == 111u8 && *(p + 3) == 95u8) } {
        return 0u8;
    }
    if fre_sv_eq_str(name, "aio_create") { return 13u8; }
    if fre_sv_eq_str(name, "aio_destroy") { return 14u8; }
    if fre_sv_eq_str(name, "aio_wake") { return 15u8; }
    if fre_sv_eq_str(name, "aio_wait") { return 16u8; }
    if fre_sv_eq_str(name, "aio_cancel") { return 17u8; }
    if fre_sv_eq_str(name, "aio_file_open") { return 18u8; }
    if fre_sv_eq_str(name, "aio_submit_read_at") { return 19u8; }
    if fre_sv_eq_str(name, "aio_submit_write_at") { return 20u8; }
    if fre_sv_eq_str(name, "aio_submit_flush") { return 21u8; }
    if fre_sv_eq_str(name, "aio_tcp_bind") { return 22u8; }
    if fre_sv_eq_str(name, "aio_socket_local_port") { return 23u8; }
    if fre_sv_eq_str(name, "aio_submit_accept") { return 24u8; }
    if fre_sv_eq_str(name, "aio_submit_connect") { return 25u8; }
    if fre_sv_eq_str(name, "aio_submit_recv") { return 26u8; }
    if fre_sv_eq_str(name, "aio_submit_send") { return 27u8; }
    if fre_sv_eq_str(name, "aio_tcp_shutdown") { return 28u8; }
    if fre_sv_eq_str(name, "aio_udp_bind") { return 29u8; }
    if fre_sv_eq_str(name, "aio_submit_recv_from") { return 30u8; }
    if fre_sv_eq_str(name, "aio_submit_send_to") { return 31u8; }
    if fre_sv_eq_str(name, "aio_close") { return 32u8; }
    0u8
}

fn tc_host_thread_intrinsic_kind(name: view<StrView>) -> u8 {
    let aio_k = tc_host_aio_intrinsic_kind(name);
    if aio_k != 0u8 {
        return aio_k;
    }
    let n = name.len;
    let p = name.ptr;
    if (p as usize) == 0 || n < 10 || n > 17 {
        return 0u8;
    }
    if n == 10 {
        // futex_wait / futex_wake
        if unsafe { *(p + 0) == 102u8 && *(p + 1) == 117u8 && *(p + 2) == 116u8 && *(p + 3) == 101u8 && *(p + 4) == 120u8 && *(p + 5) == 95u8 && *(p + 6) == 119u8 && *(p + 7) == 97u8 } {
            if unsafe { *(p + 8) == 105u8 && *(p + 9) == 116u8 } { return 7u8; }
            if unsafe { *(p + 8) == 107u8 && *(p + 9) == 101u8 } { return 8u8; }
        }
        return 0u8;
    }
    // fiber_create / fiber_resume / fiber_yield / fiber_destroy (SPEC-34 AXS-EXEC-054)
    if unsafe { *(p + 0) == 102u8 && *(p + 1) == 105u8 && *(p + 2) == 98u8 && *(p + 3) == 101u8 && *(p + 4) == 114u8 && *(p + 5) == 95u8 } {
        if n == 12 && unsafe { *(p + 6) == 99u8 && *(p + 7) == 114u8 && *(p + 8) == 101u8 && *(p + 9) == 97u8 && *(p + 10) == 116u8 && *(p + 11) == 101u8 } { return 9u8; }
        if n == 12 && unsafe { *(p + 6) == 114u8 && *(p + 7) == 101u8 && *(p + 8) == 115u8 && *(p + 9) == 117u8 && *(p + 10) == 109u8 && *(p + 11) == 101u8 } { return 10u8; }
        if n == 11 && unsafe { *(p + 6) == 121u8 && *(p + 7) == 105u8 && *(p + 8) == 101u8 && *(p + 9) == 108u8 && *(p + 10) == 100u8 } { return 11u8; }
        if n == 13 && unsafe { *(p + 6) == 100u8 && *(p + 7) == 101u8 && *(p + 8) == 115u8 && *(p + 9) == 116u8 && *(p + 10) == 114u8 && *(p + 11) == 111u8 && *(p + 12) == 121u8 } { return 12u8; }
        return 0u8;
    }
    // All others start with "thread_"
    if unsafe { !(*(p + 0) == 116u8 && *(p + 1) == 104u8 && *(p + 2) == 114u8 && *(p + 3) == 101u8 && *(p + 4) == 97u8 && *(p + 5) == 100u8 && *(p + 6) == 95u8) } {
        return 0u8;
    }
    if n == 11 && unsafe { *(p + 7) == 106u8 && *(p + 8) == 111u8 && *(p + 9) == 105u8 && *(p + 10) == 110u8 } {
        return 2u8; // thread_join
    }
    if n == 12 {
        if unsafe { *(p + 7) == 115u8 && *(p + 8) == 112u8 && *(p + 9) == 97u8 && *(p + 10) == 119u8 && *(p + 11) == 110u8 } {
            return 1u8; // thread_spawn
        }
        if unsafe { *(p + 7) == 121u8 && *(p + 8) == 105u8 && *(p + 9) == 101u8 && *(p + 10) == 108u8 && *(p + 11) == 100u8 } {
            return 5u8; // thread_yield
        }
    }
    if n == 13 && unsafe { *(p + 7) == 100u8 && *(p + 8) == 101u8 && *(p + 9) == 116u8 && *(p + 10) == 97u8 && *(p + 11) == 99u8 && *(p + 12) == 104u8 } {
        return 3u8; // thread_detach
    }
    if n == 15 && unsafe { *(p + 7) == 115u8 && *(p + 8) == 108u8 && *(p + 9) == 101u8 && *(p + 10) == 101u8 && *(p + 11) == 112u8 && *(p + 12) == 95u8 && *(p + 13) == 110u8 && *(p + 14) == 115u8 } {
        return 6u8; // thread_sleep_ns
    }
    if n == 17 && unsafe { *(p + 7) == 99u8 && *(p + 8) == 117u8 && *(p + 9) == 114u8 && *(p + 10) == 114u8 && *(p + 11) == 101u8 && *(p + 12) == 110u8 && *(p + 13) == 116u8 && *(p + 14) == 95u8 && *(p + 15) == 105u8 && *(p + 16) == 100u8 } {
        return 4u8; // thread_current_id
    }
    0u8
}

fn tc_is_ptr_to(ti: view<TypeInterner>, tid: TypeId, pointee_v: u32, want_mut: bool) -> bool {
    let t = type_get(ti, tid);
    if (t as usize) == 0 { return false; }
    unsafe { (*t).kind == TY_PTR && (*t).is_mut == want_mut && (*t).pointee.v == pointee_v }
}

fn tc_host_thread_intrinsic_sig_ok(hk: u8, it: *const HirItem, thir: view<Thir>) -> bool {
    let fn_tid = thir_get_item_type(thir, it);
    let ft = type_get(view(thir.interner), fn_tid);
    if (ft as usize) == 0 || unsafe { (*ft).kind } != TY_FN {
        return false;
    }
    let pcnt = unsafe { (*ft).param_count };
    let ptypes = unsafe { (*ft).param_types };
    let ret_v = unsafe { (*ft).ret_type.v };
    let u8_v = thir.interner.t_u8.v;
    let u32_v = thir.interner.t_u32.v;
    let u64_v = thir.interner.t_u64.v;
    let i32_v = thir.interner.t_i32.v;
    let i64_v = thir.interner.t_i64.v;
    let usize_v = thir.interner.t_usize.v;
    let unit_v = thir.interner.t_unit.v;
    if hk == 1u8 {
        if pcnt != 3 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p0_t = type_get(view(thir.interner), p0);
        if (p0_t as usize) == 0 || unsafe { (*p0_t).kind != TY_FN || (*p0_t).param_count != 1 || (*p0_t).ret_type.v != i64_v } {
            return false;
        }
        let ep0 = unsafe { *typeid_at((*p0_t).param_types, 0) };
        return tc_is_ptr_to(view(thir.interner), ep0, u8_v, true) &&
               tc_is_ptr_to(view(thir.interner), p1, u8_v, true) &&
               p2.v == usize_v;
    }
    if hk == 2u8 {
        if pcnt != 2 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        return p0.v == i64_v && tc_is_ptr_to(view(thir.interner), p1, i64_v, true);
    }
    if hk == 3u8 {
        if pcnt != 1 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        return p0.v == i64_v;
    }
    if hk == 4u8 {
        return pcnt == 0 && ret_v == u64_v;
    }
    if hk == 5u8 {
        return pcnt == 0 && (ret_v == unit_v || ret_v == 0u32);
    }
    if hk == 6u8 {
        if pcnt != 1 || (ret_v != unit_v && ret_v != 0u32) { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        return p0.v == u64_v;
    }
    if hk == 7u8 {
        if pcnt != 3 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        return tc_is_ptr_to(view(thir.interner), p0, u32_v, false) && p1.v == u32_v && p2.v == u64_v;
    }
    if hk == 8u8 {
        if pcnt != 2 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        return tc_is_ptr_to(view(thir.interner), p0, u32_v, false) && p1.v == u32_v;
    }
    if hk == 9u8 {
        // fiber_create(entry: fn(*mut u8) -> i64, ctx: *mut u8, stack_commit: usize, stack_reserve: usize) -> i64
        if pcnt != 4 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p3 = unsafe { *typeid_at(ptypes, 3) };
        let p0_t = type_get(view(thir.interner), p0);
        if (p0_t as usize) == 0 || unsafe { (*p0_t).kind != TY_FN || (*p0_t).param_count != 1 || (*p0_t).ret_type.v != i64_v } {
            return false;
        }
        let ep0 = unsafe { *typeid_at((*p0_t).param_types, 0) };
        return tc_is_ptr_to(view(thir.interner), ep0, u8_v, true) &&
               tc_is_ptr_to(view(thir.interner), p1, u8_v, true) &&
               p2.v == usize_v && p3.v == usize_v;
    }
    if hk == 10u8 {
        // fiber_resume(h: i64, arg: i64, out_val: *mut i64) -> i64
        if pcnt != 3 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        return p0.v == i64_v && p1.v == i64_v && tc_is_ptr_to(view(thir.interner), p2, i64_v, true);
    }
    if hk == 11u8 || hk == 12u8 {
        // fiber_yield(val: i64) -> i64 / fiber_destroy(h: i64) -> i64
        if pcnt != 1 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        return p0.v == i64_v;
    }
    let u16_v = thir.interner.t_u16.v;
    if hk == 13u8 {
        // aio_create() -> i64
        return pcnt == 0 && ret_v == i64_v;
    }
    if hk == 14u8 || hk == 15u8 || hk == 23u8 {
        // aio_destroy(reactor: i64) -> i64 / aio_wake(reactor: i64) -> i64 / aio_socket_local_port(handle: i64) -> i64
        if pcnt != 1 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        return p0.v == i64_v;
    }
    if hk == 16u8 {
        // aio_wait(reactor: i64, events_out: *mut u64, max_events: usize, timeout_ns: i64) -> i64
        if pcnt != 4 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p3 = unsafe { *typeid_at(ptypes, 3) };
        return p0.v == i64_v && tc_is_ptr_to(view(thir.interner), p1, u64_v, true) && p2.v == usize_v && p3.v == i64_v;
    }
    if hk == 17u8 {
        // aio_cancel(reactor: i64, op_id: u64) -> i64
        if pcnt != 2 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        return p0.v == i64_v && p1.v == u64_v;
    }
    if hk == 18u8 {
        // aio_file_open(reactor: i64, path: *const u8, path_len: usize, mode: u32) -> i64
        if pcnt != 4 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p3 = unsafe { *typeid_at(ptypes, 3) };
        return p0.v == i64_v && tc_is_ptr_to(view(thir.interner), p1, u8_v, false) && p2.v == usize_v && p3.v == u32_v;
    }
    if hk == 19u8 {
        // aio_submit_read_at(reactor: i64, handle: i64, offset: u64, buf: *mut u8, len: usize) -> i64
        if pcnt != 5 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p3 = unsafe { *typeid_at(ptypes, 3) };
        let p4 = unsafe { *typeid_at(ptypes, 4) };
        return p0.v == i64_v && p1.v == i64_v && p2.v == u64_v && tc_is_ptr_to(view(thir.interner), p3, u8_v, true) && p4.v == usize_v;
    }
    if hk == 20u8 {
        // aio_submit_write_at(reactor: i64, handle: i64, offset: u64, buf: *const u8, len: usize) -> i64
        if pcnt != 5 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p3 = unsafe { *typeid_at(ptypes, 3) };
        let p4 = unsafe { *typeid_at(ptypes, 4) };
        return p0.v == i64_v && p1.v == i64_v && p2.v == u64_v && tc_is_ptr_to(view(thir.interner), p3, u8_v, false) && p4.v == usize_v;
    }
    if hk == 21u8 || hk == 24u8 || hk == 32u8 {
        // aio_submit_flush / aio_submit_accept / aio_close (reactor: i64, handle: i64) -> i64
        if pcnt != 2 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        return p0.v == i64_v && p1.v == i64_v;
    }
    if hk == 22u8 || hk == 25u8 || hk == 29u8 {
        // aio_tcp_bind / aio_submit_connect / aio_udp_bind (reactor: i64, addr_ipv4: u32, port: u16) -> i64
        if pcnt != 3 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        return p0.v == i64_v && p1.v == u32_v && p2.v == u16_v;
    }
    if hk == 26u8 || hk == 30u8 {
        // aio_submit_recv / aio_submit_recv_from (reactor: i64, handle: i64, buf: *mut u8, len: usize) -> i64
        if pcnt != 4 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p3 = unsafe { *typeid_at(ptypes, 3) };
        return p0.v == i64_v && p1.v == i64_v && tc_is_ptr_to(view(thir.interner), p2, u8_v, true) && p3.v == usize_v;
    }
    if hk == 27u8 {
        // aio_submit_send(reactor: i64, stream: i64, buf: *const u8, len: usize) -> i64
        if pcnt != 4 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p3 = unsafe { *typeid_at(ptypes, 3) };
        return p0.v == i64_v && p1.v == i64_v && tc_is_ptr_to(view(thir.interner), p2, u8_v, false) && p3.v == usize_v;
    }
    if hk == 28u8 {
        // aio_tcp_shutdown(stream: i64, how: u32) -> i64
        if pcnt != 2 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        return p0.v == i64_v && p1.v == u32_v;
    }
    if hk == 31u8 {
        // aio_submit_send_to(reactor: i64, sock: i64, buf: *const u8, len: usize, addr_ipv4: u32, port: u16) -> i64
        if pcnt != 6 || ret_v != i64_v { return false; }
        let p0 = unsafe { *typeid_at(ptypes, 0) };
        let p1 = unsafe { *typeid_at(ptypes, 1) };
        let p2 = unsafe { *typeid_at(ptypes, 2) };
        let p3 = unsafe { *typeid_at(ptypes, 3) };
        let p4 = unsafe { *typeid_at(ptypes, 4) };
        let p5 = unsafe { *typeid_at(ptypes, 5) };
        return p0.v == i64_v && p1.v == i64_v && tc_is_ptr_to(view(thir.interner), p2, u8_v, false) && p3.v == usize_v && p4.v == u32_v && p5.v == u16_v;
    }
    false
}

fn intrinsic_attr_code(it: *const HirItem, str_in: view<StrInterner>) -> u32 {
    if (it as usize) == 0 || unsafe { (*it).kind } != HIR_ITEM_FN {
        return 0u32;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        if tc_attr_is_intrinsic(at, str_in) || tc_attr_is_host_lang(at, str_in) {
            let arg: *mut HirAttrArg = unsafe { (*at).args };
            if (arg as usize) != 0 && (unsafe { (*arg).next } as usize) == 0 {
                let aexpr: *mut HirExpr = unsafe { (*arg).expr };
                if (aexpr as usize) != 0 && unsafe { (*aexpr).kind } == HIR_EXPR_LITERAL && unsafe { (*aexpr).literal.kind } == TOK_INT {
                    let encoded = unsafe { (*aexpr).literal.int_val };
                    let code = (encoded & 0xFFFFFFFFu64) as u32;
                    if code != 0u32 {
                        return code;
                    }
                }
            }
            let fn_name = tc_item_fn_name(it, str_in);
            let iref = intrinsic_lookup(fn_name);
            if iref.has_desc {
                return intrinsic_encode(view(iref));
            }
            if tc_host_thread_intrinsic_kind(view(fn_name)) != 0u8 {
                return 36u32 << 8u32;
            }
            return 0u32;
        }
        at = unsafe { (*at).next };
    }
    0u32
}

fn register_intrinsic_callee(cx: mut_view<TypeckCtx>, callee: *const HirExpr) {
    if (callee as usize) == 0 || (cx.hir as usize) == 0 || (cx.str_in as usize) == 0 {
        return;
    }
    if unsafe { (*callee).kind } != HIR_EXPR_PATH {
        return;
    }
    let sym_v = unsafe { (*callee).path.symbol.v };
    let mut found_item: *const HirItem = 0 as *const HirItem;
    let mut used_index = false;
    if sym_v != 0u32 && (cx.thir as usize) != 0 && (unsafe { (*cx.thir).expr_methods.cap }) > 0 {
        let indexed: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), 4usize) };
        if (indexed as usize) != 0 {
            used_index = true;
            let k: usize = ((sym_v as usize) << 3) | 4usize;
            let p: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), k) };
            if (p as usize) != 0 {
                let cand: *const HirItem = unsafe { *p };
                if (cand as usize) != 0 && (unsafe { (*cand).kind }) == HIR_ITEM_FN {
                    found_item = cand;
                }
            }
        }
    }
    if sym_v != 0u32 && !used_index {
        let mut it: *mut HirItem = unsafe { (*cx.hir).items };
        while (it as usize) != 0 {
            if unsafe { (*it).kind } == HIR_ITEM_FN && unsafe { (*it).symbol.v } == sym_v {
                found_item = it;
                break;
            }
            it = unsafe { (*it).next };
        }
    }
    if (found_item as usize) == 0 {
        let name = unsafe { tc_path_name_sv(view(*cx), view((*callee).path)) };
        if name.len > 0 && (name.ptr as usize) != 0 {
            let iref = intrinsic_lookup(name);
            if iref.has_desc || tc_host_thread_intrinsic_kind(view(name)) != 0u8 {
                let mut it: *mut HirItem = unsafe { (*cx.hir).items };
                while (it as usize) != 0 {
                    if unsafe { (*it).kind } == HIR_ITEM_FN {
                        let it_name = unsafe { tc_item_fn_name(it, view(*cx.str_in)) };
                        if sv_eq(view(it_name), view(name)) {
                            found_item = it;
                            break;
                        }
                    }
                    it = unsafe { (*it).next };
                }
            }
        }
    }
    if (found_item as usize) != 0 {
        let code = unsafe { intrinsic_attr_code(found_item, view(*cx.str_in)) };
        if code != 0u32 {
            unsafe { thir_set_expr_variant(mut_view(*cx.thir), callee, code); }
        }
    }
}

fn annotate_intrinsic_item(arena: mut_view<Arena>, it: *mut HirItem, str_in: view<StrInterner>) {
    if (it as usize) == 0 || unsafe { (*it).kind } != HIR_ITEM_FN {
        return;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        let is_intr = tc_attr_is_intrinsic(at, str_in);
        let is_hlang = if is_intr { false } else { tc_attr_is_host_lang(at, str_in) };
        if is_intr || is_hlang {
            if is_intr && (unsafe { (*at).args } as usize) != 0 {
                return;
            }
            if is_hlang {
                let a0: *mut HirAttrArg = unsafe { (*at).args };
                if (a0 as usize) != 0 {
                    let e0: *mut HirExpr = unsafe { (*a0).expr };
                    if (e0 as usize) != 0 && unsafe { (*e0).kind } == HIR_EXPR_LITERAL && unsafe { (*e0).literal.kind } == TOK_INT {
                        return;
                    }
                }
            }
            let fn_name = tc_item_fn_name(it, str_in);
            let iref = intrinsic_lookup(fn_name);
            let mut packed: u64 = 0u64;
            if iref.has_desc {
                let code = intrinsic_encode(view(iref));
                packed = ((iref.desc.builtin_ty as u64) << 32u64) | (code as u64);
            } else if tc_host_thread_intrinsic_kind(view(fn_name)) != 0u8 {
                packed = (36u32 << 8u32) as u64;
            } else {
                return;
            }
            let arg_raw = arena_alloc_raw(mut_view(*arena), size_of<HirAttrArg>(), align_of<HirAttrArg>());
            tc_zero_bytes(arg_raw, size_of<HirAttrArg>());
            let expr_raw = arena_alloc_raw(mut_view(*arena), size_of<HirExpr>(), align_of<HirExpr>());
            tc_zero_bytes(expr_raw, size_of<HirExpr>());
            let arg_ptr = arg_raw as *mut HirAttrArg;
            let expr_ptr = expr_raw as *mut HirExpr;
            unsafe {
                (*expr_ptr).kind = HIR_EXPR_LITERAL;
                (*expr_ptr).span = (*at).span;
                (*expr_ptr).literal.kind = TOK_INT;
                (*expr_ptr).literal.int_val = packed;
                (*arg_ptr).span = (*at).span;
                (*arg_ptr).expr = expr_ptr;
                (*at).args = arg_ptr;
            }
            return;
        }
        at = unsafe { (*at).next };
    }
}

pub fn annotate_intrinsic_hir(arena: mut_view<Arena>, hir_file: view<HirFile>, str_in: view<StrInterner>) {
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        annotate_intrinsic_item(mut_view(*arena), it, str_in);
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                annotate_intrinsic_item(mut_view(*arena), m, str_in);
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
}

fn check_intrinsic_item(it: *const HirItem, thir: view<Thir>, sink: mut_view<DiagSink>, str_in: view<StrInterner>) {
    if (it as usize) == 0 || unsafe { (*it).kind } != HIR_ITEM_FN {
        return;
    }
    let mut has_intr = false;
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        if tc_attr_is_intrinsic(at, str_in) || tc_attr_is_host_lang(at, str_in) {
            has_intr = true;
            break;
        }
        at = unsafe { (*at).next };
    }
    if !has_intr {
        return;
    }
    let fn_name = tc_item_fn_name(it, str_in);
    let iref = intrinsic_lookup(fn_name);
    if iref.has_desc {
        if !intrinsic_signature_ok(view(iref), it, thir) {
            let sp = unsafe { (*it).span };
            report_typeck_diag(mut_view(*sink), AX_TYPE_UNKNOWN_INTRINSIC, sp.file.v, sp.start, sp.end);
        }
        return;
    }
    let hk = tc_host_thread_intrinsic_kind(view(fn_name));
    if hk == 0u8 || !tc_host_thread_intrinsic_sig_ok(hk, it, thir) {
        let sp = unsafe { (*it).span };
        report_typeck_diag(mut_view(*sink), AX_TYPE_UNKNOWN_INTRINSIC, sp.file.v, sp.start, sp.end);
    }
}

pub fn check_intrinsic_hir(hir_file: view<HirFile>, thir: view<Thir>, sink: mut_view<DiagSink>, str_in: view<StrInterner>) {
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_FN {
            let orig_m = find_orig_impl_member(hir_file, it);
            if (orig_m as usize) == 0 {
                check_intrinsic_item(it, thir, mut_view(*sink), str_in);
            }
        } else if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT || ik == HIR_ITEM_EXTERN_BLOCK {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                check_intrinsic_item(m, thir, mut_view(*sink), str_in);
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
}

fn tc_item_has_generic_sym(it: *const HirItem, sym_v: u32) -> bool {
    if (it as usize) == 0 || sym_v == 0u32 {
        return false;
    }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    if (gps as usize) == 0 {
        return false;
    }
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while (gp as usize) != 0 {
        if (unsafe { (*gp).symbol.v }) == sym_v {
            return true;
        }
        gp = unsafe { (*gp).next };
    }
    false
}

fn tc_sym_in_active_scope(cx: view<TypeckCtx>, sym_v: u32) -> bool {
    if sym_v == 0u32 {
        return false;
    }
    if (cx.hir as usize) == 0 {
        return true;
    }
    if (cx.str_in as usize) == 0 && (cx.db as usize) == 0 {
        return true;
    }
    if (cx.vars as usize) != 0 {
        let mut i: usize = 0;
        while i < cx.vars_len {
            let e = unsafe { varstate_at(cx.vars, i) };
            if (unsafe { (*e).sym.v }) == sym_v {
                return true;
            }
            i = i + 1;
        }
    }
    if tc_item_has_generic_sym(cx.current_fn, sym_v) {
        return true;
    }
    if tc_item_has_generic_sym(cx.current_impl, sym_v) {
        return true;
    }
    false
}

fn tc_item_generic_count(it: *const HirItem) -> usize {
    if (it as usize) == 0 {
        return 0;
    }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    if (gps as usize) == 0 {
        return 0;
    }
    let mut n: usize = 0;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while (gp as usize) != 0 {
        n = n + 1;
        gp = unsafe { (*gp).next };
    }
    n
}

fn tc_fn_enclosing_impl(hir: *const HirFile, method_item: *const HirItem) -> *const HirItem {
    if (hir as usize) == 0 || (method_item as usize) == 0 {
        return 0 as *const HirItem;
    }
    let is_def_inst = tc_is_default_inst(method_item);
    let sym_v = unsafe { (*method_item).symbol.v };
    let mut it: *mut HirItem = unsafe { (*hir).items };
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                if (m as usize) == (method_item as usize) ||
                   (!is_def_inst && sym_v != 0u32 && (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).symbol.v }) == sym_v) {
                    return it as *const HirItem;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    it = unsafe { (*hir).items };
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                if (m as usize) == (method_item as usize) ||
                   (!is_def_inst && sym_v != 0u32 && (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).symbol.v }) == sym_v) {
                    return it as *const HirItem;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *const HirItem
}

fn tc_enclosing_impl_generic_count(hir: *const HirFile, method_item: *const HirItem) -> usize {
    let enc = tc_fn_enclosing_impl(hir, method_item);
    if (enc as usize) == 0 {
        return 0;
    }
    tc_item_generic_count(enc)
}

fn tc_bound_arg_typeid(cx: mut_view<TypeckCtx>, gty: *mut HirType) -> TypeId {
    if (gty as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let cached = unsafe { ptr_typemap_get(view((*cx.thir).item_types), gty as usize) };
    if (cached as usize) != 0 {
        return TypeId { v: unsafe { (*cached).v } };
    }
    let computed = hir_type_to_typeid(mut_view(*cx), gty);
    unsafe {
        ptr_typemap_insert(mut_view((*cx.thir).item_types), gty as usize, (TypeId { v: computed.v }));
    }
    computed
}

fn tc_check_bound_list_types(cx: mut_view<TypeckCtx>, bounds: *mut HirType) {
    let mut b: *mut HirType = bounds;
    while (b as usize) != 0 {
        if (unsafe { (*b).kind }) == HIR_TYPE_PATH {
            let hga: *mut HirGenericArgs = unsafe { (*b).path.generic_args };
            if (hga as usize) != 0 {
                let mut ga: *mut HirGenericArg = unsafe { (*hga).args };
                while (ga as usize) != 0 {
                    let gty: *mut HirType = unsafe { (*ga).ty };
                    if (gty as usize) != 0 {
                        let _ = tc_bound_arg_typeid(mut_view(*cx), gty);
                    }
                    ga = unsafe { (*ga).next };
                }
            }
        }
        b = unsafe { (*b).next };
    }
}

fn tc_check_item_bound_types(cx: mut_view<TypeckCtx>, it: *const HirItem) {
    if (it as usize) == 0 || (cx.str_in as usize) == 0 || (unsafe { (*it).span.file.v }) == 0xFFFFFFFEu32 {
        return;
    }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    if (gps as usize) != 0 {
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while (gp as usize) != 0 {
            tc_check_bound_list_types(mut_view(*cx), unsafe { (*gp).bounds });
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*it).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while (wp as usize) != 0 {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 {
                let _ = tc_bound_arg_typeid(mut_view(*cx), wty);
            }
            tc_check_bound_list_types(mut_view(*cx), unsafe { (*wp).bounds });
            wp = unsafe { (*wp).next };
        }
    }
}

fn tc_resolve_generic_param_sym(cx: mut_view<TypeckCtx>, it: *const HirItem, sym_v: u32, base_idx: u32) -> TypeId {
    if (it as usize) == 0 || sym_v == 0u32 || (cx.thir as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    if (gps as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let mut idx: u32 = base_idx;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while (gp as usize) != 0 {
        if (unsafe { (*gp).symbol.v }) == sym_v {
            let mut p_name = unsafe { (*gp).name };
            if p_name.v == 0u32 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
                let sp_f = unsafe { (*gp).span.file.v };
                if sp_f != 0u32 {
                    let sp_s = unsafe { (*gp).span.start };
                    let sp_e = unsafe { (*gp).span.end };
                    let sv = unsafe {
                        source_db_span_text(view(*cx.db), Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e })
                    };
                    if sv.len > 0 && (sv.ptr as usize) != 0 {
                        p_name = unsafe { interner_intern_bytes(mut_view(*cx.str_in), sv.ptr, sv.len) };
                    }
                }
            }
            return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: p_name.v }), idx) };
        }
        idx = idx + 1u32;
        gp = unsafe { (*gp).next };
    }
    (TypeId { v: 0u32 })
}

// T447 (FU-B, ADR-0042 §2): the impl whose associated type `it` is. HIR post-processing appends a shallow clone of
// every impl member to the top-level item list (compiler/hir/lower.ax `clone_hir_item_shallow`, which shares the
// `ty` node), so the clone is recognised by its shared type node. Null for a free type alias.
fn tc_alias_enclosing_impl(hir: *const HirFile, it: *const HirItem) -> *const HirItem {
    if (hir as usize) == 0 || (it as usize) == 0 {
        return 0 as *const HirItem;
    }
    let ty_p = unsafe { (*it).ty as usize };
    let mut im: *mut HirItem = unsafe { (*hir).items };
    while (im as usize) != 0 {
        if (unsafe { (*im).kind }) == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*im).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_TYPE_ALIAS &&
                   ((m as usize) == (it as usize) || (ty_p != 0 && (unsafe { (*m).ty as usize }) == ty_p)) {
                    return im as *const HirItem;
                }
                m = unsafe { (*m).next };
            }
        }
        im = unsafe { (*im).next };
    }
    0 as *const HirItem
}

// T447 (FU-B): for the top-level clone of an impl's associated type, the impl member it was cloned from; else null.
fn tc_alias_orig_member(hir: *const HirFile, it: *const HirItem) -> *const HirItem {
    if (hir as usize) == 0 || (it as usize) == 0 {
        return 0 as *const HirItem;
    }
    let ty_p = unsafe { (*it).ty as usize };
    if ty_p == 0 {
        return 0 as *const HirItem;
    }
    let mut im: *mut HirItem = unsafe { (*hir).items };
    while (im as usize) != 0 {
        if (unsafe { (*im).kind }) == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*im).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_TYPE_ALIAS && (m as usize) != (it as usize) &&
                   (unsafe { (*m).ty as usize }) == ty_p {
                    return m as *const HirItem;
                }
                m = unsafe { (*m).next };
            }
        }
        im = unsafe { (*im).next };
    }
    0 as *const HirItem
}

// T447 (FU-B): the type of a type alias, computed with the alias as the current item and — for an impl's associated
// type, or its top-level clone — the impl's generic scope (and `Self`) in force, so `type Output = Result<T, E>`
// resolves the impl parameter `T`.
fn tc_alias_type_in_scope(cx: mut_view<TypeckCtx>, it: *mut HirItem, aty_node: *mut HirType) -> TypeId {
    let old_fn = cx.current_fn;
    let old_impl = cx.current_impl;
    let old_self = cx.self_ty.v;
    cx.current_fn = it;
    let enc = tc_alias_enclosing_impl(cx.hir as *const HirFile, it as *const HirItem);
    if (enc as usize) != 0 {
        cx.current_impl = enc;
        let st = unsafe { thir_get_item_type(view(*cx.thir), enc) };
        if st.v != 0u32 {
            cx.self_ty.v = st.v;
        }
    }
    let t = hir_type_to_typeid(mut_view(*cx), aty_node);
    cx.current_fn = old_fn;
    cx.current_impl = old_impl;
    cx.self_ty.v = old_self;
    t
}

// T447 (FU-B): the binding `Name = X` for `assoc` in a bound list (`F: Future<Output = X> + ...`), or null.
fn tc_bound_list_assoc_binding(cx: view<TypeckCtx>, bounds: *mut HirType, assoc: view<StrView>) -> *mut HirType {
    let mut b: *mut HirType = bounds;
    while (b as usize) != 0 {
        if (unsafe { (*b).kind }) == HIR_TYPE_PATH {
            let hga: *mut HirGenericArgs = unsafe { (*b).path.generic_args };
            if (hga as usize) != 0 {
                let mut a: *mut HirGenericArg = unsafe { (*hga).args };
                while (a as usize) != 0 {
                    let an = unsafe { (*a).name.v };
                    if an != 0u32 {
                        let asv = unsafe { interner_get(view(*cx.str_in), (StrId { v: an })) };
                        if sv_eq(view(asv), assoc) {
                            return unsafe { (*a).ty };
                        }
                    }
                    a = unsafe { (*a).next };
                }
            }
        }
        b = unsafe { (*b).next };
    }
    0 as *mut HirType
}

// T447 (FU-B): the binding for `pname.assoc` from the bounds of generic parameter `pname` of item `it` (inline bounds
// and `where` predicates). `found` is set when `it` declares `pname` at all (an inner declaration shadows outer ones).
fn tc_item_param_assoc_binding(
    cx: view<TypeckCtx>,
    it: *const HirItem,
    pname: view<StrView>,
    assoc: view<StrView>,
    found: mut_view<bool>
) -> *mut HirType {
    if (it as usize) == 0 {
        return 0 as *mut HirType;
    }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    if (gps as usize) == 0 {
        return 0 as *mut HirType;
    }
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while (gp as usize) != 0 {
        let gsv = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*gp).name.v })) };
        if sv_eq(view(gsv), pname) {
            *found = true;
            let r = tc_bound_list_assoc_binding(cx, unsafe { (*gp).bounds }, assoc);
            if (r as usize) != 0 {
                return r;
            }
        }
        gp = unsafe { (*gp).next };
    }
    if !*found {
        return 0 as *mut HirType;
    }
    let wc: *mut HirWhereClause = unsafe { (*it).where_clause };
    if (wc as usize) != 0 {
        let mut pred: *mut HirWherePred = unsafe { (*wc).preds };
        while (pred as usize) != 0 {
            let pty: *mut HirType = unsafe { (*pred).ty };
            if (pty as usize) != 0 && (unsafe { (*pty).kind }) == HIR_TYPE_PATH &&
               (unsafe { (*pty).path.generic_args as usize }) == 0 {
                let psv = unsafe { tc_path_name_sv(cx, view((*pty).path)) };
                if sv_eq(view(psv), pname) {
                    let r = tc_bound_list_assoc_binding(cx, unsafe { (*pred).bounds }, assoc);
                    if (r as usize) != 0 {
                        return r;
                    }
                }
            }
            pred = unsafe { (*pred).next };
        }
    }
    0 as *mut HirType
}

// T447 (FU-B): `P.Assoc` where `P` is a generic parameter of the current item or impl whose bounds bind `Assoc`
// (`impl<F: Future<Output = T>, T>` → `F.Output` is `T`). Returns 0 when the path is not such a projection.
fn tc_param_assoc_projection(cx: mut_view<TypeckCtx>, path: view<HirPath>) -> TypeId {
    if (cx.str_in as usize) == 0 || (path.generic_args as usize) != 0 {
        return (TypeId { v: 0u32 });
    }
    let name = tc_path_name_sv(view(*cx), path);
    if 3 > name.len || (name.ptr as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let mut dot: usize = 0;
    let mut k: usize = 0;
    while k < name.len {
        let ch = unsafe { *(name.ptr + k) };
        if ch == 46u8 {
            if dot != 0 {
                return (TypeId { v: 0u32 });
            }
            dot = k;
        } else if ch == 60u8 || ch == 32u8 || ch == 40u8 || ch == 91u8 {
            return (TypeId { v: 0u32 });
        }
        k = k + 1;
    }
    if dot == 0 || dot + 1 >= name.len {
        return (TypeId { v: 0u32 });
    }
    let pname = StrView { ptr: name.ptr, len: dot };
    let assoc = StrView { ptr: unsafe { name.ptr + dot + 1 }, len: name.len - dot - 1 };
    if tc_sv_is_4(view(pname), 83u8, 101u8, 108u8, 102u8) { // Self
        return (TypeId { v: 0u32 });
    }
    let mut found_fn = false;
    let mut bt = tc_item_param_assoc_binding(view(*cx), cx.current_fn, view(pname), view(assoc), mut_view(found_fn));
    if (bt as usize) == 0 && !found_fn && (cx.current_impl as usize) != (cx.current_fn as usize) {
        let mut found_im = false;
        bt = tc_item_param_assoc_binding(view(*cx), cx.current_impl, view(pname), view(assoc), mut_view(found_im));
    }
    if (bt as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    // A binding that names the projection itself (`F: Tr<A = F.A>`) has no meaning; leave it to the name lookup.
    if (unsafe { (*bt).kind }) == HIR_TYPE_PATH {
        let bsv = unsafe { tc_path_name_sv(view(*cx), view((*bt).path)) };
        if sv_eq(view(bsv), view(name)) {
            return (TypeId { v: 0u32 });
        }
    }
    hir_type_to_typeid(mut_view(*cx), bt)
}

pub fn lookup_path_type(cx: mut_view<TypeckCtx>, path: view<HirPath>, out_args: mut_view<GenericArgsSlice>) -> TypeId {
    let proj = tc_param_assoc_projection(mut_view(*cx), path);
    if proj.v != 0u32 {
        return proj;
    }
    if path.symbol.v != 0u32 {
        let in_active = tc_sym_in_active_scope(view(*cx), path.symbol.v);
        if in_active {
            let st = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: path.symbol.v })) };
            if st.v != 0u32 { return (TypeId { v: st.v }); }
            let impl_n = if (cx.current_impl as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
                tc_item_generic_count(cx.current_impl) as u32
            } else {
                0u32
            };
            let gp_fn = tc_resolve_generic_param_sym(mut_view(*cx), cx.current_fn, path.symbol.v, impl_n);
            if gp_fn.v != 0u32 { return gp_fn; }
            let gp_im = tc_resolve_generic_param_sym(mut_view(*cx), cx.current_impl, path.symbol.v, 0u32);
            if gp_im.v != 0u32 { return gp_im; }
        }

        if (cx.hir as usize) != 0 {
            let mut used_index = false;
            let mut indexed_it: *mut HirItem = 0 as *mut HirItem;
            if (cx.thir as usize) != 0 && (unsafe { (*cx.thir).expr_methods.cap }) > 0 {
                let indexed: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), 4usize) };
                if (indexed as usize) != 0 {
                    used_index = true;
                    let k4: usize = ((path.symbol.v as usize) << 3) | 4usize;
                    let p4: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), k4) };
                    if (p4 as usize) != 0 {
                        indexed_it = (unsafe { *p4 }) as *mut HirItem;
                    } else {
                        let k2: usize = ((path.symbol.v as usize) << 3) | 2usize;
                        let p2: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), k2) };
                        if (p2 as usize) != 0 {
                            indexed_it = (unsafe { *p2 }) as *mut HirItem;
                        }
                    }
                }
            }
            if used_index {
                if (indexed_it as usize) != 0 {
                    let it = indexed_it;
                    let ik = unsafe { (*it).kind };
                    if ik == HIR_ITEM_FN || ik == HIR_ITEM_STRUCT || ik == HIR_ITEM_ENUM || ik == HIR_ITEM_TYPE_ALIAS || ik == HIR_ITEM_CONST || ik == HIR_ITEM_STATIC {
                        if ik == HIR_ITEM_FN && (cx.str_in as usize) != 0 {
                            let bk = unsafe { intrinsic_attr_builtin_ty(it, view(*cx.str_in)) };
                            if bk != 0u8 && bk != TY_BUILTIN_LEN && bk != TY_BUILTIN_PRINT && bk != TY_BUILTIN_PRINT_INT && bk != TY_BUILTIN_DROP {
                                let sty = unsafe { intern_singleton(mut_view((*cx.thir).interner), bk) };
                                return instantiate_path(mut_view(*cx), sty, it, path, mut_view(*out_args));
                            }
                        }
                        let it_t = tc_item_type_on_demand(mut_view(*cx), it);
                        if it_t.v != 0u32 {
                            return instantiate_path(mut_view(*cx), (TypeId { v: it_t.v }), it, path, mut_view(*out_args));
                        }
                        if ik == HIR_ITEM_STRUCT && (cx.str_in as usize) == 0 && (cx.db as usize) == 0 {
                            return unsafe { (*cx.thir).interner.t_error };
                        }
                        if ik == HIR_ITEM_TYPE_ALIAS {
                            let aty_node: *mut HirType = unsafe { (*it).ty };
                            if (aty_node as usize) != 0 {
                                let computed = tc_alias_type_in_scope(mut_view(*cx), it, aty_node);
                                if !is_error(mut_view(*cx), (TypeId { v: computed.v })) && computed.v != 0u32 {
                                    unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: computed.v })); }
                                }
                                return instantiate_path(mut_view(*cx), (TypeId { v: computed.v }), it, path, mut_view(*out_args));
                            }
                        }
                    }
                }
            } else {
                let mut it: *mut HirItem = unsafe { (*cx.hir).items };
                while ((it as usize) != 0) {
                    let mut matched: bool = false;
                    let ik = unsafe { (*it).kind };
                    let isym = unsafe { (*it).symbol.v };
                    if ik == HIR_ITEM_FN && isym == path.symbol.v { matched = true; }
                    else if ik == HIR_ITEM_STRUCT && isym == path.symbol.v { matched = true; }
                    else if ik == HIR_ITEM_ENUM {
                        if isym == path.symbol.v {
                            matched = true;
                        } else {
                            let mut v: *mut HirVariantDecl = unsafe { (*it).variants };
                            while ((v as usize) != 0) {
                                if unsafe { (*v).symbol.v } == path.symbol.v {
                                    matched = true;
                                    break;
                                }
                                v = unsafe { (*v).next };
                            }
                        }
                    } else if ik == HIR_ITEM_TYPE_ALIAS && isym == path.symbol.v { matched = true; }
                    else if (ik == HIR_ITEM_CONST || ik == HIR_ITEM_STATIC) && isym == path.symbol.v { matched = true; }
                    else if ik == HIR_ITEM_EXTERN_BLOCK {
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while ((m as usize) != 0) {
                            if unsafe { (*m).kind } == HIR_ITEM_FN && unsafe { (*m).symbol.v } == path.symbol.v {
                                let mt = unsafe { thir_get_item_type(view(*cx.thir), m) };
                                if mt.v != 0u32 {
                                    return instantiate_path(mut_view(*cx), (TypeId { v: mt.v }), m, path, mut_view(*out_args));
                                }
                            }
                            m = unsafe { (*m).next };
                        }
                    }

                    if matched {
                        if ik == HIR_ITEM_FN && (cx.str_in as usize) != 0 {
                            let bk = unsafe { intrinsic_attr_builtin_ty(it, view(*cx.str_in)) };
                            if bk != 0u8 && bk != TY_BUILTIN_LEN && bk != TY_BUILTIN_PRINT && bk != TY_BUILTIN_PRINT_INT && bk != TY_BUILTIN_DROP {
                                let sty = unsafe { intern_singleton(mut_view((*cx.thir).interner), bk) };
                                return instantiate_path(mut_view(*cx), sty, it, path, mut_view(*out_args));
                            }
                        }
                        let it_t = tc_item_type_on_demand(mut_view(*cx), it);
                        if it_t.v != 0u32 {
                            return instantiate_path(mut_view(*cx), (TypeId { v: it_t.v }), it, path, mut_view(*out_args));
                        }
                        if ik == HIR_ITEM_STRUCT && (cx.str_in as usize) == 0 && (cx.db as usize) == 0 {
                            return unsafe { (*cx.thir).interner.t_error };
                        }
                        if ik == HIR_ITEM_TYPE_ALIAS {
                            let aty_node: *mut HirType = unsafe { (*it).ty };
                            if (aty_node as usize) != 0 {
                                let computed = tc_alias_type_in_scope(mut_view(*cx), it, aty_node);
                                if !is_error(mut_view(*cx), (TypeId { v: computed.v })) && computed.v != 0u32 {
                                    unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: computed.v })); }
                                }
                                return instantiate_path(mut_view(*cx), (TypeId { v: computed.v }), it, path, mut_view(*out_args));
                            }
                        }
                    }
                    it = unsafe { (*it).next };
                }
            }
        }
        if !in_active {
            let st2 = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: path.symbol.v })) };
            if st2.v != 0u32 { return (TypeId { v: st2.v }); }
        }
    }

    let name = tc_path_name_sv(view(*cx), path);

    if path.symbol.v != 0u32 {
        if tc_sv_is_4(view(name), 83u8, 101u8, 108u8, 102u8) { // Self
            if cx.self_ty.v != 0u32 { return (TypeId { v: cx.self_ty.v }); }
            let sid = if (cx.str_in as usize) != 0 {
                unsafe { tc_intern_idx(mut_view(*cx.str_in), 30) }
            } else {
                (StrId { v: 0u32 })
            };
            return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: sid.v }), TC_SELF_PARAM_INDEX) };
        }
        let hga: *mut HirGenericArgs = path.generic_args;
        if (hga as usize) != 0 {
            let mut arg_count: usize = 0;
            let mut a: *mut HirGenericArg = unsafe { (*hga).args };
            while ((a as usize) != 0) {
                arg_count = arg_count + 1;
                a = unsafe { (*a).next };
            }
            let bytes = mul_usize(arg_count, size_of<TypeId>());
            let args_arr = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
            let mut i: usize = 0;
            a = unsafe { (*hga).args };
            while ((a as usize) != 0) {
                let aty_ptr: *mut HirType = unsafe { (*a).ty };
                let aty = hir_type_to_typeid(mut_view(*cx), aty_ptr);
                let dst = unsafe { typeid_at(args_arr, i) };
                unsafe { (*dst).v = aty.v; }
                i = i + 1;
                a = unsafe { (*a).next };
            }
            out_args.args = args_arr;
            out_args.count = arg_count;
        }
        let bk = builtin_name_kind(view(name));
        if bk != 0u8 {
            return unsafe { intern_singleton(mut_view((*cx.thir).interner), bk) };
        }
    }

    let bk2 = builtin_name_kind(view(name));
    if bk2 == TY_BUILTIN_LEN || bk2 == TY_BUILTIN_PRINT || bk2 == TY_BUILTIN_PRINT_INT || bk2 == TY_BUILTIN_DROP {
        return unsafe { intern_singleton(mut_view((*cx.thir).interner), bk2) };
    }

    if tc_sv_starts_self_dot(view(name)) {
        let assoc_name = StrView {
            ptr: unsafe { name.ptr + 5 },
            len: name.len - 5,
        };
        if (cx.current_impl as usize) != 0 {
            let ik = unsafe { (*cx.current_impl).kind };
            if ik == HIR_ITEM_IMPL {
                let mut m: *mut HirItem = unsafe { (*cx.current_impl).members };
                while ((m as usize) != 0) {
                    if unsafe { (*m).kind } == HIR_ITEM_TYPE_ALIAS && (cx.str_in as usize) != 0 {
                        let mname_id = unsafe { (*m).name.v };
                        let mname = unsafe { interner_get(view(*cx.str_in), (StrId { v: mname_id })) };
                        if sv_eq(view(mname), view(assoc_name)) {
                            let mty_ptr: *mut HirType = unsafe { (*m).ty };
                            return hir_type_to_typeid(mut_view(*cx), mty_ptr);
                        }
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        let aid = if (cx.str_in as usize) != 0 {
            unsafe { interner_intern_bytes(mut_view(*cx.str_in), assoc_name.ptr, assoc_name.len) }
        } else {
            (StrId { v: 0u32 })
        };
        return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: aid.v }), 0u32) };
    }

    lookup_path_type_by_name(mut_view(*cx), path, mut_view(*out_args), name)
}

fn lookup_path_type_by_name(
    cx: mut_view<TypeckCtx>,
    path: view<HirPath>,
    out_args: mut_view<GenericArgsSlice>,
    name: StrView
) -> TypeId {
    if tc_sv_is_4(view(name), 83u8, 101u8, 108u8, 102u8) { // Self
        if cx.self_ty.v != 0u32 { return (TypeId { v: cx.self_ty.v }); }
        let sid = if (cx.str_in as usize) != 0 {
            unsafe { tc_intern_idx(mut_view(*cx.str_in), 30) }
        } else {
            (StrId { v: 0u32 })
        };
        return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: sid.v }), TC_SELF_PARAM_INDEX) };
    }

    unsafe {
        if tc_sv_is_4(view(name), 98u8, 111u8, 111u8, 108u8) { return (TypeId { v: (*cx.thir).interner.t_bool.v }); }
        if tc_sv_is_4(view(name), 99u8, 104u8, 97u8, 114u8) { return (TypeId { v: (*cx.thir).interner.t_char.v }); }
        if tc_sv_is_2(view(name), 105u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_i8.v }); }
        if tc_sv_is_3(view(name), 105u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_i16.v }); }
        if tc_sv_is_3(view(name), 105u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_i32.v }); }
        if tc_sv_is_3(view(name), 105u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_i64.v }); }
        if tc_sv_is_4(view(name), 105u8, 49u8, 50u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_i128.v }); }
        if tc_sv_is_5(view(name), 105u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_isize.v }); }
        if tc_sv_is_2(view(name), 117u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_u8.v }); }
        if tc_sv_is_3(view(name), 117u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_u16.v }); }
        if tc_sv_is_3(view(name), 117u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_u32.v }); }
        if tc_sv_is_3(view(name), 117u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_u64.v }); }
        if tc_sv_is_4(view(name), 117u8, 49u8, 50u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_u128.v }); }
        if tc_sv_is_5(view(name), 117u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_usize.v }); }
        // T458b (SPEC-41 AXS-FLT-004): `f32` / `f64` are path heads exactly like the integer names.
        if tc_sv_is_3(view(name), 102u8, 51u8, 50u8) { return (TypeId { v: TYPEID_F32 }); }
        if tc_sv_is_3(view(name), 102u8, 54u8, 52u8) { return (TypeId { v: TYPEID_F64 }); }
        if tc_sv_is_3(view(name), 115u8, 116u8, 114u8) || tc_sv_is_3(view(name), 83u8, 116u8, 114u8) {
            return (TypeId { v: (*cx.thir).interner.t_str.v });
        }
        if tc_sv_is_5(view(name), 110u8, 101u8, 118u8, 101u8, 114u8) {
            return (TypeId { v: (*cx.thir).interner.t_never.v });
        }
    }

    if (path.generic_args as usize) == 0 && (cx.str_in as usize) != 0 {
        let impl_n_b = if (cx.current_impl as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
            tc_item_generic_count(cx.current_impl)
        } else {
            0
        };
        if (cx.current_fn as usize) != 0 {
            let gps_f: *mut HirGenericParams = unsafe { (*cx.current_fn).generic_params };
            if (gps_f as usize) != 0 {
                let mut idx_f: usize = impl_n_b;
                let mut gp_f: *mut HirGenericParam = unsafe { (*gps_f).params };
                while ((gp_f as usize) != 0) {
                    let gname_id_f = unsafe { (*gp_f).name.v };
                    let gp_name_f = unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_id_f })) };
                    if sv_eq(view(gp_name_f), view(name)) {
                        return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: gname_id_f }), idx_f as u32) };
                    }
                    idx_f = idx_f + 1;
                    gp_f = unsafe { (*gp_f).next };
                }
            }
        }
        if (cx.current_impl as usize) != 0 {
            let gps_i: *mut HirGenericParams = unsafe { (*cx.current_impl).generic_params };
            if (gps_i as usize) != 0 {
                let mut idx_i: usize = 0;
                let mut gp_i: *mut HirGenericParam = unsafe { (*gps_i).params };
                while ((gp_i as usize) != 0) {
                    let gname_id_i = unsafe { (*gp_i).name.v };
                    let gp_name_i = unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_id_i })) };
                    if sv_eq(view(gp_name_i), view(name)) {
                        return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: gname_id_i }), idx_i as u32) };
                    }
                    idx_i = idx_i + 1;
                    gp_i = unsafe { (*gp_i).next };
                }
            }
        }
    }

    if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*cx.hir).items };
        while ((it as usize) != 0) {
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_FN {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                if sv_eq(view(it_name), view(name)) {
                    let bk = unsafe { intrinsic_attr_builtin_ty(it, view(*cx.str_in)) };
                    if bk != 0u8 && bk != TY_BUILTIN_LEN && bk != TY_BUILTIN_PRINT && bk != TY_BUILTIN_PRINT_INT && bk != TY_BUILTIN_DROP {
                        let sty = unsafe { intern_singleton(mut_view((*cx.thir).interner), bk) };
                        return instantiate_path(mut_view(*cx), sty, it, path, mut_view(*out_args));
                    }
                    let t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if t.v != 0u32 {
                        return instantiate_path(mut_view(*cx), (TypeId { v: t.v }), it, path, mut_view(*out_args));
                    }
                }
            } else if ik == HIR_ITEM_CONST || ik == HIR_ITEM_STATIC {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                if sv_eq(view(it_name), view(name)) {
                    let t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if t.v != 0u32 {
                        return (TypeId { v: t.v });
                    }
                }
            } else if ik == HIR_ITEM_STRUCT {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                let mut s_len = name.len;
                let mut k: usize = 0;
                while (k < name.len) {
                    if unsafe { *(name.ptr + k) } == 60u8 { // '<'
                        s_len = k;
                        break;
                    }
                    k = k + 1;
                }
                let struct_name = StrView { ptr: name.ptr, len: s_len };
                if sv_eq(view(it_name), view(struct_name)) {
                    let t = tc_item_type_on_demand(mut_view(*cx), it);
                    if t.v != 0u32 {
                        return instantiate_path(mut_view(*cx), (TypeId { v: t.v }), it, path, mut_view(*out_args));
                    }
                    let ev = unsafe { (*cx.thir).interner.t_error.v };
                    return (TypeId { v: ev });
                }
            } else if ik == HIR_ITEM_ENUM {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                let mut e_len = name.len;
                let mut k: usize = 0;
                while (k < name.len) {
                    let ch = unsafe { *(name.ptr + k) };
                    if ch == 46u8 || ch == 60u8 { // '.' or '<'
                        e_len = k;
                        break;
                    }
                    k = k + 1;
                }
                let enum_name = StrView { ptr: name.ptr, len: e_len };
                if sv_eq(view(it_name), view(enum_name)) {
                    let t = tc_item_type_on_demand(mut_view(*cx), it);
                    if t.v != 0u32 {
                        return instantiate_path(mut_view(*cx), (TypeId { v: t.v }), it, path, mut_view(*out_args));
                    }
                }
            } else if ik == HIR_ITEM_TYPE_ALIAS {
                let iname_id = unsafe { (*it).name.v };
                let it_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                let mut a_len = name.len;
                let mut k: usize = 0;
                while (k < name.len) {
                    if unsafe { *(name.ptr + k) } == 60u8 {
                        a_len = k;
                        break;
                    }
                    k = k + 1;
                }
                let alias_name = StrView { ptr: name.ptr, len: a_len };
                if sv_eq(view(it_name), view(alias_name)) {
                    let mut t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if t.v == 0u32 {
                        let aty_node: *mut HirType = unsafe { (*it).ty };
                        if (aty_node as usize) != 0 {
                            t = tc_alias_type_in_scope(mut_view(*cx), it, aty_node);
                            if !is_error(mut_view(*cx), (TypeId { v: t.v })) && t.v != 0u32 {
                                unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: t.v })); }
                            }
                        }
                    }
                    if t.v != 0u32 {
                        return instantiate_path(mut_view(*cx), (TypeId { v: t.v }), it, path, mut_view(*out_args));
                    }
                }
            }
            it = unsafe { (*it).next };
        }
    }

    if (cx.current_impl as usize) != 0 && (cx.str_in as usize) != 0 {
        let gps: *mut HirGenericParams = unsafe { (*cx.current_impl).generic_params };
        if (gps as usize) != 0 {
            let mut idx: usize = 0;
            let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
            while ((gp as usize) != 0) {
                let gname_id = unsafe { (*gp).name.v };
                let gp_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_id })) };
                if sv_eq(view(gp_name), view(name)) {
                    return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: gname_id }), idx as u32) };
                }
                idx = idx + 1;
                gp = unsafe { (*gp).next };
            }
        }
    }

    if (cx.current_fn as usize) != 0 && (cx.str_in as usize) != 0 {
        let gps: *mut HirGenericParams = unsafe { (*cx.current_fn).generic_params };
        if (gps as usize) != 0 {
            let impl_n_fb = if (cx.current_impl as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
                tc_item_generic_count(cx.current_impl)
            } else {
                0
            };
            let mut idx: usize = impl_n_fb;
            let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
            while ((gp as usize) != 0) {
                let gname_id = unsafe { (*gp).name.v };
                let gp_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_id })) };
                if sv_eq(view(gp_name), view(name)) {
                    return unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: gname_id }), idx as u32) };
                }
                idx = idx + 1;
                gp = unsafe { (*gp).next };
            }
        }
        let mut p: *mut HirParam = unsafe { (*cx.current_fn).params };
        while ((p as usize) != 0) {
            let pname_id = unsafe { (*p).name.v };
            let p_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: pname_id })) };
            if sv_eq(view(p_name), view(name)) {
                let psym = unsafe { (*p).symbol.v };
                if psym != 0u32 {
                    let st = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: psym })) };
                    if st.v != 0u32 { return (TypeId { v: st.v }); }
                }
            }
            p = unsafe { (*p).next };
        }
    }

    type_error(mut_view(*cx), view(path.span), AX_NAME_UNRESOLVED)
}

fn tc_alloc_expr(cx: mut_view<TypeckCtx>, kind: u8, fv: u32, st: u32, en: u32) -> *mut HirExpr {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirExpr>(), align_of<HirExpr>()) };
    tc_zero_bytes(raw, size_of<HirExpr>());
    let e = raw as *mut HirExpr;
    unsafe {
        (*e).kind = kind;
        (*e).span.file.v = fv;
        (*e).span.start = st;
        (*e).span.end = en;
    }
    e
}

fn tc_alloc_stmt(cx: mut_view<TypeckCtx>, kind: u8, fv: u32, st: u32, en: u32) -> *mut HirStmt {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirStmt>(), align_of<HirStmt>()) };
    tc_zero_bytes(raw, size_of<HirStmt>());
    let s = raw as *mut HirStmt;
    unsafe {
        (*s).kind = kind;
        (*s).span.file.v = fv;
        (*s).span.start = st;
        (*s).span.end = en;
    }
    s
}

fn tc_alloc_pat(cx: mut_view<TypeckCtx>, kind: u8, fv: u32, st: u32, en: u32) -> *mut HirPat {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirPat>(), align_of<HirPat>()) };
    tc_zero_bytes(raw, size_of<HirPat>());
    let p = raw as *mut HirPat;
    unsafe {
        (*p).kind = kind;
        (*p).span.file.v = fv;
        (*p).span.start = st;
        (*p).span.end = en;
    }
    p
}

fn tc_alloc_block(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32) -> *mut HirBlock {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirBlock>(), align_of<HirBlock>()) };
    tc_zero_bytes(raw, size_of<HirBlock>());
    let b = raw as *mut HirBlock;
    unsafe {
        (*b).span.file.v = fv;
        (*b).span.start = st;
        (*b).span.end = en;
    }
    b
}

fn tc_alloc_match_arm(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32) -> *mut HirMatchArm {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirMatchArm>(), align_of<HirMatchArm>()) };
    tc_zero_bytes(raw, size_of<HirMatchArm>());
    let a = raw as *mut HirMatchArm;
    unsafe {
        (*a).span.file.v = fv;
        (*a).span.start = st;
        (*a).span.end = en;
    }
    a
}

fn tc_alloc_field_init(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32) -> *mut HirFieldInit {
    let raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirFieldInit>(), align_of<HirFieldInit>()) };
    tc_zero_bytes(raw, size_of<HirFieldInit>());
    let f = raw as *mut HirFieldInit;
    unsafe {
        (*f).span.file.v = fv;
        (*f).span.start = st;
        (*f).span.end = en;
    }
    f
}

fn desugar_let_else(cx: mut_view<TypeckCtx>, stmt: *mut HirStmt) {
    if (stmt as usize) == 0 { return; }
    let else_b: *mut HirBlock = unsafe { (*stmt).else_block };
    if (else_b as usize) == 0 { return; }

    let sfv = unsafe { (*stmt).span.file.v };
    let sst = unsafe { (*stmt).span.start };
    let sen = unsafe { (*stmt).span.end };
    let efv = unsafe { (*else_b).span.file.v };
    let est = unsafe { (*else_b).span.start };
    let een = unsafe { (*else_b).span.end };

    let arm_else = tc_alloc_match_arm(mut_view(*cx), sfv, sst, sen);
    let wild = tc_alloc_pat(mut_view(*cx), HIR_PAT_WILDCARD, sfv, sst, sen);
    let else_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, efv, est, een);
    unsafe {
        (*else_blk).block = else_b;
        (*arm_else).pat = wild;
        (*arm_else).body = else_blk;
    }

    let arm_then = tc_alloc_match_arm(mut_view(*cx), sfv, sst, sen);
    let then_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, sfv, sst, sen);
    let unit_b = tc_alloc_block(mut_view(*cx), sfv, sst, sen);
    let lpat: *mut HirPat = unsafe { (*stmt).pat };
    let lexpr: *mut HirExpr = unsafe { (*stmt).expr };
    unsafe {
        (*then_blk).block = unit_b;
        (*arm_then).pat = lpat;
        (*arm_then).body = then_blk;
        (*arm_then).next = arm_else;
    }

    let match_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_MATCH, sfv, sst, sen);
    unsafe {
        (*match_expr).cond = lexpr;
        (*match_expr).arms = arm_then;
        (*stmt).kind = HIR_STMT_EXPR;
        (*stmt).expr = match_expr;
        (*stmt).has_semi = true;
    }
}

fn desugar_if_let(cx: mut_view<TypeckCtx>, expr: *mut HirExpr) {
    if (expr as usize) == 0 { return; }
    let lpat: *mut HirPat = unsafe { (*expr).let_pat };
    if (lpat as usize) == 0 { return; }

    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };

    let arm_else = tc_alloc_match_arm(mut_view(*cx), efv, est, een);
    let wild = tc_alloc_pat(mut_view(*cx), HIR_PAT_WILDCARD, efv, est, een);
    let mut else_blk: *mut HirExpr = unsafe { (*expr).else_branch };
    if (else_blk as usize) == 0 {
        else_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, efv, est, een);
        let ub = tc_alloc_block(mut_view(*cx), efv, est, een);
        unsafe { (*else_blk).block = ub; }
    }
    unsafe {
        (*arm_else).pat = wild;
        (*arm_else).body = else_blk;
    }

    let tblk_ptr: *mut HirBlock = unsafe { (*expr).block };
    let bfv = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.file.v } } else { efv };
    let bst = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.start } } else { est };
    let ben = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.end } } else { een };

    let arm_then = tc_alloc_match_arm(mut_view(*cx), bfv, bst, ben);
    let then_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, bfv, bst, ben);
    unsafe {
        (*then_blk).block = tblk_ptr;
        (*arm_then).pat = lpat;
        (*arm_then).body = then_blk;
        (*arm_then).next = arm_else;
        (*expr).kind = HIR_EXPR_MATCH;
        (*expr).arms = arm_then;
    }
}

fn desugar_while_let(cx: mut_view<TypeckCtx>, expr: *mut HirExpr) {
    if (expr as usize) == 0 { return; }
    let lpat: *mut HirPat = unsafe { (*expr).let_pat };
    if (lpat as usize) == 0 { return; }

    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };

    let brk_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_JUMP, efv, est, een);
    unsafe {
        (*brk_expr).jump_kind = JUMP_BREAK;
        (*brk_expr).label.v = 0u32;
        (*brk_expr).inner = 0 as *mut HirExpr;
    }

    let arm_else = tc_alloc_match_arm(mut_view(*cx), efv, est, een);
    let wild = tc_alloc_pat(mut_view(*cx), HIR_PAT_WILDCARD, efv, est, een);
    unsafe {
        (*arm_else).pat = wild;
        (*arm_else).body = brk_expr;
    }

    let tblk_ptr: *mut HirBlock = unsafe { (*expr).block };
    let bfv = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.file.v } } else { efv };
    let bst = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.start } } else { est };
    let ben = if (tblk_ptr as usize) != 0 { unsafe { (*tblk_ptr).span.end } } else { een };

    let arm_then = tc_alloc_match_arm(mut_view(*cx), bfv, bst, ben);
    let then_blk = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, bfv, bst, ben);
    unsafe {
        (*then_blk).block = tblk_ptr;
        (*arm_then).pat = lpat;
        (*arm_then).body = then_blk;
        (*arm_then).next = arm_else;
    }

    let match_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_MATCH, efv, est, een);
    let wcond: *mut HirExpr = unsafe { (*expr).cond };
    unsafe {
        (*match_expr).cond = wcond;
        (*match_expr).arms = arm_then;
    }

    let match_stmt = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
    unsafe {
        (*match_stmt).expr = match_expr;
        (*match_stmt).has_semi = false;
    }

    let loop_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
    unsafe {
        (*loop_blk).stmts = match_stmt;
        (*expr).kind = HIR_EXPR_LOOP;
        (*expr).block = loop_blk;
    }
}

fn make_var_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, sym: SymbolId, name_idx: usize) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_PATH, fv, st, en);
    let nid = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), name_idx) }
    } else {
        (StrId { v: 0u32 })
    };
    unsafe {
        (*e).path.symbol.v = sym.v;
        (*e).path.name.v = nid.v;
    }
    e
}

fn make_let_stmt(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, sym: SymbolId, is_mut: bool, init_expr: *mut HirExpr) -> *mut HirStmt {
    let s = tc_alloc_stmt(mut_view(*cx), HIR_STMT_LET, fv, st, en);
    let p = tc_alloc_pat(mut_view(*cx), HIR_PAT_BINDING, fv, st, en);
    unsafe {
        (*p).is_mut = is_mut;
        (*p).symbol.v = sym.v;
        (*s).pat = p;
        (*s).expr = init_expr;
    }
    s
}

fn make_assign_stmt(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, left: *mut HirExpr, right: *mut HirExpr) -> *mut HirStmt {
    let s = tc_alloc_stmt(mut_view(*cx), HIR_STMT_ASSIGN, fv, st, en);
    unsafe {
        (*s).left = left;
        (*s).right = right;
    }
    s
}

fn make_binop_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, op: u8, left: *mut HirExpr, right: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BINARY, fv, st, en);
    unsafe {
        (*e).op = op;
        (*e).left = left;
        (*e).right = right;
    }
    e
}

fn make_unary_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, op: u8, inner: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_UNARY, fv, st, en);
    unsafe {
        (*e).op = op;
        (*e).inner = inner;
    }
    e
}

fn make_int_literal(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, val: u64, suffix: u8) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_LITERAL, fv, st, en);
    unsafe {
        (*e).literal.kind = TOK_INT;
        (*e).literal.span.file.v = fv;
        (*e).literal.span.start = st;
        (*e).literal.span.end = en;
        (*e).literal.int_val = val;
        (*e).literal.suffix = suffix;
    }
    e
}

fn make_bool_literal(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, val: bool) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_LITERAL, fv, st, en);
    unsafe {
        (*e).literal.kind = if val { TOK_KW_TRUE } else { TOK_KW_FALSE };
        (*e).literal.span.file.v = fv;
        (*e).literal.span.start = st;
        (*e).literal.span.end = en;
    }
    e
}

fn make_call_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, callee_idx: usize, args: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_CALL, fv, st, en);
    let callee = tc_alloc_expr(mut_view(*cx), HIR_EXPR_PATH, 0u32, 0u32, 0u32);
    let nid = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), callee_idx) }
    } else {
        (StrId { v: 0u32 })
    };
    unsafe {
        (*callee).path.symbol.v = 0x50000001u32;
        (*callee).path.name.v = nid.v;
        (*e).callee = callee;
        (*e).args = args;
    }
    e
}

fn make_index_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, base: *mut HirExpr, arg: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_INDEX, fv, st, en);
    unsafe {
        (*e).base = base;
        (*e).index_arg = arg;
    }
    e
}

fn make_method_call_expr(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, receiver: *mut HirExpr, method_idx: usize, args: *mut HirExpr) -> *mut HirExpr {
    let e = tc_alloc_expr(mut_view(*cx), HIR_EXPR_METHOD_CALL, fv, st, en);
    let mid = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), method_idx) }
    } else {
        (StrId { v: 0u32 })
    };
    unsafe {
        (*e).receiver = receiver;
        (*e).method_name.v = mid.v;
        (*e).args = args;
    }
    e
}

fn make_option_some_pat(cx: mut_view<TypeckCtx>, fv: u32, st: u32, en: u32, inner_pat: *mut HirPat) -> *mut HirPat {
    let p = tc_alloc_pat(mut_view(*cx), HIR_PAT_PATH, fv, st, en);
    let nid = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), 1) }
    } else {
        (StrId { v: 0u32 })
    };
    let tup = tc_alloc_pat(mut_view(*cx), HIR_PAT_TUPLE, fv, st, en);
    unsafe {
        (*p).path.name.v = nid.v;
        (*tup).elems = inner_pat;
        if (inner_pat as usize) != 0 {
            (*inner_pat).next = 0 as *mut HirPat;
        }
        (*p).payload = tup;
    }
    p
}

fn desugar_range(cx: mut_view<TypeckCtx>, expr: *mut HirExpr) {
    if (expr as usize) == 0 { return; }
    if unsafe { (*expr).kind } != HIR_EXPR_RANGE { return; }
    let is_inc = unsafe { (*expr).is_inclusive };
    let start_e: *mut HirExpr = unsafe { (*expr).start_expr };
    let end_e: *mut HirExpr = unsafe { (*expr).end_expr };
    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };

    let sfv = if (start_e as usize) != 0 { unsafe { (*start_e).span.file.v } } else { efv };
    let sst = if (start_e as usize) != 0 { unsafe { (*start_e).span.start } } else { est };
    let sen = if (start_e as usize) != 0 { unsafe { (*start_e).span.end } } else { een };
    let f_start = tc_alloc_field_init(mut_view(*cx), sfv, sst, sen);
    let start_id = if (cx.str_in as usize) != 0 { unsafe { tc_intern_idx(mut_view(*cx.str_in), 2) } } else { (StrId { v: 0u32 }) };

    let dfv = if (end_e as usize) != 0 { unsafe { (*end_e).span.file.v } } else { efv };
    let dst = if (end_e as usize) != 0 { unsafe { (*end_e).span.start } } else { est };
    let den = if (end_e as usize) != 0 { unsafe { (*end_e).span.end } } else { een };
    let f_end = tc_alloc_field_init(mut_view(*cx), dfv, dst, den);
    let end_id = if (cx.str_in as usize) != 0 { unsafe { tc_intern_idx(mut_view(*cx.str_in), 3) } } else { (StrId { v: 0u32 }) };

    unsafe {
        (*f_start).name.v = start_id.v;
        (*f_start).expr = start_e;
        (*f_end).name.v = end_id.v;
        (*f_end).expr = end_e;
        (*f_start).next = f_end;
    }

    if is_inc {
        let f_done = tc_alloc_field_init(mut_view(*cx), efv, est, een);
        let done_id = if (cx.str_in as usize) != 0 { unsafe { tc_intern_idx(mut_view(*cx.str_in), 4) } } else { (StrId { v: 0u32 }) };
        let b_lit = make_bool_literal(mut_view(*cx), efv, est, een, false);
        unsafe {
            (*f_done).name.v = done_id.v;
            (*f_done).expr = b_lit;
            (*f_end).next = f_done;
        }
    }

    let rname_id = if (cx.str_in as usize) != 0 {
        unsafe { tc_intern_idx(mut_view(*cx.str_in), if is_inc { 6 } else { 5 }) }
    } else {
        (StrId { v: 0u32 })
    };
    unsafe {
        (*expr).kind = HIR_EXPR_STRUCT;
        (*expr).path.span.file.v = 0u32;
        (*expr).path.span.start = 0u32;
        (*expr).path.span.end = 0u32;
        (*expr).path.symbol.v = 0u32;
        (*expr).path.name.v = rname_id.v;
        (*expr).path.generic_args = 0 as *mut HirGenericArgs;
        (*expr).fields = f_start;
    }
}

fn desugar_for_range_helper(
    cx: mut_view<TypeckCtx>,
    expr: *mut HirExpr,
    is_inc: bool,
    start_e: *mut HirExpr,
    end_e: *mut HirExpr,
    label_v: u32,
    pat: *mut HirPat,
    body_blk: *mut HirBlock
) {
    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };
    let bfv = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.file.v } } else { efv };
    let bst = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.start } } else { est };
    let ben = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.end } } else { een };
    let body_stmts: *mut HirStmt = if (body_blk as usize) != 0 { unsafe { (*body_blk).stmts } } else { 0 as *mut HirStmt };

    let cur_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
    cx.next_closure_id = cx.next_closure_id + 1u32;
    let end_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
    cx.next_closure_id = cx.next_closure_id + 1u32;

    let sfv = if (start_e as usize) != 0 { unsafe { (*start_e).span.file.v } } else { efv };
    let sst = if (start_e as usize) != 0 { unsafe { (*start_e).span.start } } else { est };
    let sen = if (start_e as usize) != 0 { unsafe { (*start_e).span.end } } else { een };
    let dfv = if (end_e as usize) != 0 { unsafe { (*end_e).span.file.v } } else { efv };
    let dst = if (end_e as usize) != 0 { unsafe { (*end_e).span.start } } else { est };
    let den = if (end_e as usize) != 0 { unsafe { (*end_e).span.end } } else { een };

    let s1 = make_let_stmt(mut_view(*cx), sfv, sst, sen, (SymbolId { v: cur_sym.v }), true, start_e);
    let s2 = make_let_stmt(mut_view(*cx), dfv, dst, den, (SymbolId { v: end_sym.v }), false, end_e);
    unsafe { (*s1).next = s2; }

    let pfv = if (pat as usize) != 0 { unsafe { (*pat).span.file.v } } else { efv };
    let pst = if (pat as usize) != 0 { unsafe { (*pat).span.start } } else { est };
    let pen = if (pat as usize) != 0 { unsafe { (*pat).span.end } } else { een };

    if !is_inc {
        let v_cur1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let v_end1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: end_sym.v }), 8);
        let cond = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_LT, v_cur1, v_end1);

        let sa = tc_alloc_stmt(mut_view(*cx), HIR_STMT_LET, pfv, pst, pen);
        let v_cur2 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        unsafe {
            (*sa).pat = pat;
            (*sa).expr = v_cur2;
        }

        let one_lit = make_int_literal(mut_view(*cx), efv, est, een, 1u64, SUFFIX_NONE);
        let v_cur3 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let add_expr = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_ADD, v_cur3, one_lit);
        let v_cur4 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let sb = make_assign_stmt(mut_view(*cx), efv, est, een, v_cur4, add_expr);
        unsafe {
            (*sa).next = sb;
            (*sb).next = body_stmts;
        }

        let w_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_WHILE, efv, est, een);
        let w_blk = tc_alloc_block(mut_view(*cx), bfv, bst, ben);
        unsafe {
            (*w_blk).stmts = sa;
            (*w_expr).label.v = label_v;
            (*w_expr).cond = cond;
            (*w_expr).block = w_blk;
        }

        let sw = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
        let outer_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
        unsafe {
            (*sw).expr = w_expr;
            (*sw).has_semi = false;
            (*s2).next = sw;
            (*outer_blk).stmts = s1;
            (*expr).kind = HIR_EXPR_BLOCK;
            (*expr).block = outer_blk;
        }
    } else {
        let done_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
        cx.next_closure_id = cx.next_closure_id + 1u32;
        let b_false = make_bool_literal(mut_view(*cx), efv, est, een, false);
        let s3 = make_let_stmt(mut_view(*cx), efv, est, een, (SymbolId { v: done_sym.v }), true, b_false);
        unsafe { (*s2).next = s3; }

        let v_done1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: done_sym.v }), 9);
        let not_done = make_unary_expr(mut_view(*cx), efv, est, een, UNOP_NOT, v_done1);
        let v_cur1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let v_end1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: end_sym.v }), 8);
        let cur_le = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_LE, v_cur1, v_end1);
        let cond = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_LOGAND, not_done, cur_le);

        let sa = tc_alloc_stmt(mut_view(*cx), HIR_STMT_LET, pfv, pst, pen);
        let v_cur2 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        unsafe {
            (*sa).pat = pat;
            (*sa).expr = v_cur2;
        }

        let if_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_IF, efv, est, een);
        let v_cur_ge = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let v_end_ge = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: end_sym.v }), 8);
        let ge_cond = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_GE, v_cur_ge, v_end_ge);
        let v_done_set = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: done_sym.v }), 9);
        let b_true = make_bool_literal(mut_view(*cx), efv, est, een, true);
        let set_done = make_assign_stmt(mut_view(*cx), efv, est, een, v_done_set, b_true);
        let if_blk = tc_alloc_block(mut_view(*cx), efv, est, een);

        let one_lit = make_int_literal(mut_view(*cx), efv, est, een, 1u64, SUFFIX_NONE);
        let v_cur_add = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let add_expr = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_ADD, v_cur_add, one_lit);
        let v_cur_dst = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: cur_sym.v }), 7);
        let inc_cur = make_assign_stmt(mut_view(*cx), efv, est, een, v_cur_dst, add_expr);
        let else_blk_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_BLOCK, efv, est, een);
        let else_b = tc_alloc_block(mut_view(*cx), efv, est, een);

        unsafe {
            (*if_blk).stmts = set_done;
            (*else_b).stmts = inc_cur;
            (*else_blk_expr).block = else_b;
            (*if_expr).cond = ge_cond;
            (*if_expr).block = if_blk;
            (*if_expr).else_branch = else_blk_expr;
        }

        let sb = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
        unsafe {
            (*sb).expr = if_expr;
            (*sb).has_semi = false;
            (*sa).next = sb;
            (*sb).next = body_stmts;
        }

        let w_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_WHILE, efv, est, een);
        let w_blk = tc_alloc_block(mut_view(*cx), bfv, bst, ben);
        unsafe {
            (*w_blk).stmts = sa;
            (*w_expr).label.v = label_v;
            (*w_expr).cond = cond;
            (*w_expr).block = w_blk;
        }

        let sw = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
        let outer_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
        unsafe {
            (*sw).expr = w_expr;
            (*sw).has_semi = false;
            (*s3).next = sw;
            (*outer_blk).stmts = s1;
            (*expr).kind = HIR_EXPR_BLOCK;
            (*expr).block = outer_blk;
        }
    }
}

fn pre_find_method_types(cx: mut_view<TypeckCtx>, base_ty: TypeId) {
    if is_error(mut_view(*cx), (TypeId { v: base_ty.v })) || (cx.hir as usize) == 0 {
        return;
    }
    let saved_vars_len = cx.type_vars.len;
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((it as usize) != 0) {
        if unsafe { (*it).kind } == HIR_ITEM_IMPL {
            let old_impl = cx.current_impl;
            cx.current_impl = it as *const HirItem;
            let st_ptr = unsafe { (*it).self_type };
            let _ = hir_type_to_typeid(mut_view(*cx), st_ptr);
            cx.current_impl = old_impl;
        }
        it = unsafe { (*it).next };
    }
    cx.type_vars.len = saved_vars_len;
}

fn desugar_for(cx: mut_view<TypeckCtx>, expr: *mut HirExpr) {
    if (expr as usize) == 0 { return; }
    if unsafe { (*expr).kind } != HIR_EXPR_FOR { return; }

    let label_v = unsafe { (*expr).label.v };
    let pat: *mut HirPat = unsafe { (*expr).pat };
    let iter: *mut HirExpr = unsafe { (*expr).iter };
    let body_blk: *mut HirBlock = unsafe { (*expr).block };
    let efv = unsafe { (*expr).span.file.v };
    let est = unsafe { (*expr).span.start };
    let een = unsafe { (*expr).span.end };

    if (iter as usize) != 0 && unsafe { (*iter).kind } == HIR_EXPR_RANGE {
        let is_inc = unsafe { (*iter).is_inclusive };
        let start_e: *mut HirExpr = unsafe { (*iter).start_expr };
        let end_e: *mut HirExpr = unsafe { (*iter).end_expr };
        desugar_for_range_helper(mut_view(*cx), expr, is_inc, start_e, end_e, label_v, pat, body_blk);
        return;
    }

    let raw_iter_ty = check_expr(mut_view(*cx), iter, (TypeId { v: 0u32 }));
    let iter_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_iter_ty.v }));
    if is_error(mut_view(*cx), (TypeId { v: iter_ty.v })) { return; }

    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: iter_ty.v })) };
    if (t as usize) == 0 { return; }
    let tk = unsafe { (*t).kind };
    let is_array = tk == TY_ARRAY;
    let mut is_slice = false;
    if tk == TY_VIEW || tk == TY_MUT_VIEW {
        let pt_v = unsafe { (*t).pointee.v };
        let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pt_v })) };
        if (pt as usize) != 0 {
            let ptk = unsafe { (*pt).kind };
            if ptk == TY_SLICE || ptk == TY_ARRAY {
                is_slice = true;
            }
        }
    }

    if is_array || is_slice {
        let arr_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
        cx.next_closure_id = cx.next_closure_id + 1u32;
        let idx_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
        cx.next_closure_id = cx.next_closure_id + 1u32;
        let len_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
        cx.next_closure_id = cx.next_closure_id + 1u32;

        let ifv = if (iter as usize) != 0 { unsafe { (*iter).span.file.v } } else { efv };
        let ist = if (iter as usize) != 0 { unsafe { (*iter).span.start } } else { est };
        let ien = if (iter as usize) != 0 { unsafe { (*iter).span.end } } else { een };

        let s1 = make_let_stmt(mut_view(*cx), ifv, ist, ien, (SymbolId { v: arr_sym.v }), false, iter);
        let zero_usize = make_int_literal(mut_view(*cx), efv, est, een, 0u64, SUFFIX_USIZE);
        let s2 = make_let_stmt(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), true, zero_usize);
        let v_arr1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: arr_sym.v }), 10);
        let len_call = make_call_expr(mut_view(*cx), efv, est, een, 11, v_arr1);
        let s3 = make_let_stmt(mut_view(*cx), efv, est, een, (SymbolId { v: len_sym.v }), false, len_call);
        unsafe {
            (*s1).next = s2;
            (*s2).next = s3;
        }

        let v_idx1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), 12);
        let v_len1 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: len_sym.v }), 13);
        let cond = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_LT, v_idx1, v_len1);

        let v_arr2 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: arr_sym.v }), 10);
        let v_idx2 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), 12);
        let idx_expr = make_index_expr(mut_view(*cx), efv, est, een, v_arr2, v_idx2);

        let pfv = if (pat as usize) != 0 { unsafe { (*pat).span.file.v } } else { efv };
        let pst = if (pat as usize) != 0 { unsafe { (*pat).span.start } } else { est };
        let pen = if (pat as usize) != 0 { unsafe { (*pat).span.end } } else { een };
        let sa = tc_alloc_stmt(mut_view(*cx), HIR_STMT_LET, pfv, pst, pen);
        unsafe {
            (*sa).pat = pat;
            (*sa).expr = idx_expr;
        }

        let one_usize = make_int_literal(mut_view(*cx), efv, est, een, 1u64, SUFFIX_USIZE);
        let v_idx3 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), 12);
        let add_idx = make_binop_expr(mut_view(*cx), efv, est, een, BINOP_ADD, v_idx3, one_usize);
        let v_idx4 = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: idx_sym.v }), 12);
        let sb = make_assign_stmt(mut_view(*cx), efv, est, een, v_idx4, add_idx);

        let bfv = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.file.v } } else { efv };
        let bst = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.start } } else { est };
        let ben = if (body_blk as usize) != 0 { unsafe { (*body_blk).span.end } } else { een };
        let body_stmts: *mut HirStmt = if (body_blk as usize) != 0 { unsafe { (*body_blk).stmts } } else { 0 as *mut HirStmt };
        unsafe {
            (*sa).next = sb;
            (*sb).next = body_stmts;
        }

        let w_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_WHILE, efv, est, een);
        let w_blk = tc_alloc_block(mut_view(*cx), bfv, bst, ben);
        let sw = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
        let outer_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
        unsafe {
            (*w_blk).stmts = sa;
            (*w_expr).label.v = label_v;
            (*w_expr).cond = cond;
            (*w_expr).block = w_blk;
            (*sw).expr = w_expr;
            (*sw).has_semi = false;
            (*s3).next = sw;
            (*outer_blk).stmts = s1;
            (*expr).kind = HIR_EXPR_BLOCK;
            (*expr).block = outer_blk;
        }
        return;
    }

    let mut trait_res: u8 = TRAIT_DISPROVEN;
    let next_sv = unsafe { tc_alloc_sv(mut_view((*cx.thir).interner.arena), 14) };
    let method_item = if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
        pre_find_method_types(mut_view(*cx), (TypeId { v: iter_ty.v }));
        unsafe {
            find_method_in_scope(view(*cx.hir), view(*cx.thir), (TypeId { v: iter_ty.v }), view(next_sv), cx.current_fn, cx.current_impl, view(*cx.str_in), view(*cx.db), mut_view(trait_res))
        }
    } else {
        0 as *mut HirItem
    };
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: iter_ty.v })) };

    if (method_item as usize) == 0 && tk == TY_STRUCT && (cx.str_in as usize) != 0 {
        let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
        if (sdef as usize) != 0 {
            let sname_id = unsafe { (*sdef).name.v };
            let sname = unsafe { interner_get(view(*cx.str_in), (StrId { v: sname_id })) };
            let is_range = tc_sv_is_5(view(sname), 82u8, 97u8, 110u8, 103u8, 101u8); // Range
            let mut is_range_inc = false;
            if sname.len == 14 && (sname.ptr as usize) != 0 {
                if unsafe { *(sname.ptr + 0) == 82u8 && *(sname.ptr + 5) == 73u8 && *(sname.ptr + 13) == 101u8 } {
                    is_range_inc = true;
                }
            }
            if is_range || is_range_inc {
                let r_start = tc_alloc_expr(mut_view(*cx), HIR_EXPR_FIELD, efv, est, een);
                let start_id = unsafe { tc_intern_idx(mut_view(*cx.str_in), 2) };
                let r_end = tc_alloc_expr(mut_view(*cx), HIR_EXPR_FIELD, efv, est, een);
                let end_id = unsafe { tc_intern_idx(mut_view(*cx.str_in), 3) };
                unsafe {
                    (*r_start).base = iter;
                    (*r_start).name.v = start_id.v;
                    (*r_end).base = iter;
                    (*r_end).name.v = end_id.v;
                }
                desugar_for_range_helper(mut_view(*cx), expr, is_range_inc, r_start, r_end, label_v, pat, body_blk);
                return;
            }
        }
    }

    let iter_sym = (SymbolId { v: 0x60000000u32 + cx.next_closure_id });
    cx.next_closure_id = cx.next_closure_id + 1u32;
    let ifv = if (iter as usize) != 0 { unsafe { (*iter).span.file.v } } else { efv };
    let ist = if (iter as usize) != 0 { unsafe { (*iter).span.start } } else { est };
    let ien = if (iter as usize) != 0 { unsafe { (*iter).span.end } } else { een };
    let s1 = make_let_stmt(mut_view(*cx), ifv, ist, ien, (SymbolId { v: iter_sym.v }), true, iter);

    let w_expr = tc_alloc_expr(mut_view(*cx), HIR_EXPR_WHILE, efv, est, een);
    let some_pat = make_option_some_pat(mut_view(*cx), efv, est, een, pat);
    let v_iter = make_var_expr(mut_view(*cx), efv, est, een, (SymbolId { v: iter_sym.v }), 15);
    let next_call = make_method_call_expr(mut_view(*cx), efv, est, een, v_iter, 14, 0 as *mut HirExpr);
    let sw = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, efv, est, een);
    let outer_blk = tc_alloc_block(mut_view(*cx), efv, est, een);
    unsafe {
        (*w_expr).label.v = label_v;
        (*w_expr).let_pat = some_pat;
        (*w_expr).cond = next_call;
        (*w_expr).block = body_blk;
        (*sw).expr = w_expr;
        (*sw).has_semi = false;
        (*s1).next = sw;
        (*outer_blk).stmts = s1;
        (*expr).kind = HIR_EXPR_BLOCK;
        (*expr).block = outer_blk;
    }
}

pub fn is_pat_irrefutable(cx: mut_view<TypeckCtx>, pat: *const HirPat, ty: TypeId) -> bool {
    if (pat as usize) == 0 { return true; }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_WILDCARD || pk == HIR_PAT_BINDING { return true; }
    if pk == HIR_PAT_TUPLE {
        let mut p: *mut HirPat = unsafe { (*pat).elems };
        if (p as usize) != 0 {
            let t = if ty.v == 0u32 { 0 as *mut AxType } else { unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty.v })) } };
            let mut i: usize = 0;
            while ((p as usize) != 0) {
                let mut inner_ty = (TypeId { v: 0u32 });
                if (t as usize) != 0 && unsafe { (*t).kind } == TY_TUPLE && i < unsafe { (*t).field_count } {
                    let fptr = unsafe { (*t).fields };
                    let fv = unsafe { (*typeid_at(fptr, i)).v };
                    inner_ty.v = fv;
                }
                if !is_pat_irrefutable(mut_view(*cx), p, (TypeId { v: inner_ty.v })) { return false; }
                i = i + 1;
                p = unsafe { (*p).next };
            }
        }
        return true;
    }
    if pk == HIR_PAT_STRUCT || pk == HIR_PAT_PATH {
        if ty.v == 0u32 { return true; }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty.v })) };
        if (t as usize) == 0 { return true; }
        let tk = unsafe { (*t).kind };
        if tk == TY_STRUCT {
            if pk == HIR_PAT_STRUCT {
                let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let mut pf: *mut HirPatField = unsafe { (*pat).fields };
                while ((pf as usize) != 0) {
                    let mut idx: usize = 0;
                    if (sdef as usize) != 0 {
                        let mut fd: *mut HirFieldDecl = unsafe { (*sdef).struct_fields };
                        while ((fd as usize) != 0) {
                            if unsafe { (*fd).name.v == (*pf).name.v } { break; }
                            idx = idx + 1;
                            fd = unsafe { (*fd).next };
                        }
                    }
                    if idx < unsafe { (*t).field_count } {
                        let fptr = unsafe { (*t).fields };
                        let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                        let pf_pat: *mut HirPat = unsafe { (*pf).pat };
                        if !is_pat_irrefutable(mut_view(*cx), pf_pat, (TypeId { v: fty_v })) { return false; }
                    }
                    pf = unsafe { (*pf).next };
                }
            }
            return true;
        }
        if tk == TY_ENUM && unsafe { (*t).variant_count } == 1 {
            if pk == HIR_PAT_STRUCT {
                let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let vd: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
                if (vd as usize) != 0 {
                    let mut pf: *mut HirPatField = unsafe { (*pat).fields };
                    while ((pf as usize) != 0) {
                        let mut idx: usize = 0;
                        let mut fd: *mut HirFieldDecl = unsafe { (*vd).struct_fields };
                        while ((fd as usize) != 0) {
                            if unsafe { (*fd).name.v == (*pf).name.v } { break; }
                            idx = idx + 1;
                            fd = unsafe { (*fd).next };
                        }
                        let vfc = unsafe { *usize_at((*t).variant_field_counts, 0) };
                        if idx < vfc {
                            let row = unsafe { *typeid_ptr_at((*t).variant_fields, 0) };
                            let fty_v = unsafe { (*typeid_at(row, idx)).v };
                            let pf_pat: *mut HirPat = unsafe { (*pf).pat };
                            if !is_pat_irrefutable(mut_view(*cx), pf_pat, (TypeId { v: fty_v })) { return false; }
                        }
                        pf = unsafe { (*pf).next };
                    }
                }
            }
            return true;
        }
        return false;
    }
    false
}

pub fn check_pat(cx: mut_view<TypeckCtx>, pat: *const HirPat, expected: TypeId, is_init: bool) -> TypeId {
    if (pat as usize) == 0 {
        let uv = unsafe { (*cx.thir).interner.t_unit.v };
        return (TypeId { v: uv });
    }
    let mut ty = (TypeId { v: expected.v });
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_BINDING {
        let sym_v = unsafe { (*pat).symbol.v };
        if sym_v != 0u32 {
            unsafe { thir_set_symbol_type(mut_view(*cx.thir), (SymbolId { v: sym_v }), (TypeId { v: ty.v })); }
            let is_m = unsafe { (*pat).is_mut };
            push_var_state(mut_view(*cx), (SymbolId { v: sym_v }), is_m, is_init);
        }
    } else if pk == HIR_PAT_LITERAL {
        let tk = unsafe { (*pat).tok.kind };
        let mut lit_ty = TypeId { v: unsafe { (*cx.thir).interner.t_error.v } };
        if tk == TOK_KW_TRUE || tk == TOK_KW_FALSE {
            lit_ty.v = unsafe { (*cx.thir).interner.t_bool.v };
        } else if tk == TOK_CHAR {
            lit_ty.v = unsafe { (*cx.thir).interner.t_char.v };
        } else if tk == TOK_INT {
            let before = cx.lits_len;
            let it = unsafe { int_literal_type(mut_view(*cx), view((*pat).tok), view((*pat).span)) };
            if unsafe { (*pat).is_negated } && cx.lits_len == before + 1 {
                let lc = unsafe { litcheck_at(cx.lits, before) };
                unsafe {
                    (*lc).negated = true;
                    (*lc).neg_span.file.v = (*pat).span.file.v;
                    (*lc).neg_span.start = (*pat).span.start;
                    (*lc).neg_span.end = (*pat).span.end;
                }
            }
            lit_ty.v = it.v;
        } else if tk == TOK_FLOAT {
            // T457 (SPEC-41 AXS-FLT-006): float literal pattern, compared with IEEE `==`.
            let before = cx.lits_len;
            let ft = unsafe { float_literal_type(mut_view(*cx), view((*pat).tok), view((*pat).span)) };
            if unsafe { (*pat).is_negated } && cx.lits_len == before + 1 {
                let lc = unsafe { litcheck_at(cx.lits, before) };
                unsafe {
                    (*lc).negated = true;
                    (*lc).neg_span.file.v = (*pat).span.file.v;
                    (*lc).neg_span.start = (*pat).span.start;
                    (*lc).neg_span.end = (*pat).span.end;
                }
            }
            lit_ty.v = ft.v;
        } else {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) };
        }
        if !unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: lit_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
    } else if pk == HIR_PAT_WILDCARD {
        // nothing
    } else if pk == HIR_PAT_STRUCT {
        return check_pat_struct(mut_view(*cx), pat, (TypeId { v: ty.v }), is_init);
    } else {
        return check_pat_path_or_compound(mut_view(*cx), pat, (TypeId { v: ty.v }), is_init, pk);
    }
    unsafe { thir_set_pat_type(mut_view(*cx.thir), pat, (TypeId { v: ty.v })); }
    ty
}

fn check_pat_struct(cx: mut_view<TypeckCtx>, pat: *const HirPat, expected: TypeId, is_init: bool) -> TypeId {
    let mut ty = (TypeId { v: expected.v });
    if true {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let path_ty = unsafe { lookup_path_type(mut_view(*cx), view((*pat).path), mut_view(gargs)) };
        if gargs.count > 0 {
            unsafe { ptr_substmap_insert(mut_view((*cx.thir).pat_substs), pat as usize, gargs.args, gargs.count); }
        }
        if !unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: path_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        if is_error(mut_view(*cx), (TypeId { v: path_ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: path_ty.v })) };
        let tk = if (t as usize) != 0 { unsafe { (*t).kind } } else { TY_ERROR };
        if tk == TY_ENUM {
            let name = unsafe { tc_path_name_sv(view(*cx), view((*pat).path)) };
            let mut vname = StrView { ptr: name.ptr, len: name.len };
            let mut k: usize = 0;
            while (k < name.len) {
                if unsafe { *(name.ptr + k) } == 46u8 { // '.'
                    vname.ptr = unsafe { name.ptr + k + 1 };
                    vname.len = name.len - k - 1;
                }
                k = k + 1;
            }
            let mut found_variant = false;
            let mut vidx: usize = 0;
            let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
            let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
            while ((v as usize) != 0) {
                let vn_id = unsafe { (*v).name.v };
                let var_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: vn_id })) };
                if sv_eq(view(var_name), view(vname)) {
                    found_variant = true;
                    unsafe { ptr_usizemap_insert(mut_view((*cx.thir).pat_variants), pat as usize, vidx); }
                    if !unsafe { (*v).is_struct } {
                        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                    }
                    let row = unsafe { *typeid_ptr_at((*t).variant_fields, vidx) };
                    let mut pf: *mut HirPatField = unsafe { (*pat).fields };
                    while ((pf as usize) != 0) {
                        let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*pf).name.v })) };
                        let mut found = false;
                        let mut idx: usize = 0;
                        let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                        while ((f as usize) != 0) {
                            let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                            if sv_eq(view(fname), view(iname)) {
                                found = true;
                                let fty_v = unsafe { (*typeid_at(row, idx)).v };
                                let pf_pat: *mut HirPat = unsafe { (*pf).pat };
                                check_pat(mut_view(*cx), pf_pat, (TypeId { v: fty_v }), is_init);
                                break;
                            }
                            idx = idx + 1;
                            f = unsafe { (*f).next };
                        }
                        if !found {
                            unsafe { type_error(mut_view(*cx), view((*pf).span), AX_TYPE_UNKNOWN_FIELD); }
                        }
                        pf = unsafe { (*pf).next };
                    }
                    if !unsafe { (*pat).has_rest } {
                        let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                        while ((f as usize) != 0) {
                            let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                            let mut found = false;
                            let mut pf2: *mut HirPatField = unsafe { (*pat).fields };
                            while ((pf2 as usize) != 0) {
                                let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*pf2).name.v })) };
                                if sv_eq(view(fname), view(iname)) { found = true; break; }
                                pf2 = unsafe { (*pf2).next };
                            }
                            if !found {
                                unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISSING_FIELD); }
                            }
                            f = unsafe { (*f).next };
                        }
                    }
                    break;
                }
                vidx = vidx + 1;
                v = unsafe { (*v).next };
            }
            if !found_variant {
                return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
            }
            ty.v = path_ty.v;
        } else if tk == TY_STRUCT {
            let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
            let fptr = unsafe { (*t).fields };
            let mut pf: *mut HirPatField = unsafe { (*pat).fields };
            while ((pf as usize) != 0) {
                let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*pf).name.v })) };
                let mut found = false;
                let mut idx: usize = 0;
                let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
                while ((f as usize) != 0) {
                    let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                    if sv_eq(view(fname), view(iname)) {
                        found = true;
                        let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                        let pf_pat: *mut HirPat = unsafe { (*pf).pat };
                        check_pat(mut_view(*cx), pf_pat, (TypeId { v: fty_v }), is_init);
                        break;
                    }
                    idx = idx + 1;
                    f = unsafe { (*f).next };
                }
                if !found {
                    unsafe { type_error(mut_view(*cx), view((*pf).span), AX_TYPE_UNKNOWN_FIELD); }
                }
                pf = unsafe { (*pf).next };
            }
            if !unsafe { (*pat).has_rest } && (sdef as usize) != 0 {
                let mut f: *mut HirFieldDecl = unsafe { (*sdef).struct_fields };
                while ((f as usize) != 0) {
                    let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                    let mut found = false;
                    let mut pf2: *mut HirPatField = unsafe { (*pat).fields };
                    while ((pf2 as usize) != 0) {
                        let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*pf2).name.v })) };
                        if sv_eq(view(fname), view(iname)) { found = true; break; }
                        pf2 = unsafe { (*pf2).next };
                    }
                    if !found {
                        unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISSING_FIELD); }
                    }
                    f = unsafe { (*f).next };
                }
            }
            ty.v = path_ty.v;
        } else if tk != TY_ERROR {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        } else {
            ty.v = path_ty.v;
        }
    }
    unsafe { thir_set_pat_type(mut_view(*cx.thir), pat, (TypeId { v: ty.v })); }
    ty
}

fn check_pat_path_or_compound(cx: mut_view<TypeckCtx>, pat: *const HirPat, expected: TypeId, is_init: bool, pk: u8) -> TypeId {
    let mut ty = (TypeId { v: expected.v });
    if pk == HIR_PAT_PATH {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let path_ty = unsafe { lookup_path_type(mut_view(*cx), view((*pat).path), mut_view(gargs)) };
        if gargs.count > 0 {
            unsafe { ptr_substmap_insert(mut_view((*cx.thir).pat_substs), pat as usize, gargs.args, gargs.count); }
        }
        if is_error(mut_view(*cx), (TypeId { v: path_ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        if !unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: path_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: path_ty.v })) };
        if (t as usize) == 0 || unsafe { (*t).kind } != TY_ENUM {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let name = unsafe { tc_path_name_sv(view(*cx), view((*pat).path)) };
        let mut vname = StrView { ptr: name.ptr, len: name.len };
        let mut k: usize = 0;
        while (k < name.len) {
            if unsafe { *(name.ptr + k) } == 46u8 {
                vname.ptr = unsafe { name.ptr + k + 1 };
                vname.len = name.len - k - 1;
            }
            k = k + 1;
        }
        let mut found_variant = false;
        let mut vidx: usize = 0;
        let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
        let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
        while ((v as usize) != 0) {
            let var_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
            if sv_eq(view(var_name), view(vname)) {
                found_variant = true;
                unsafe { ptr_usizemap_insert(mut_view((*cx.thir).pat_variants), pat as usize, vidx); }
                if unsafe { (*v).is_struct } {
                    return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                }
                let vfc = unsafe { *usize_at((*t).variant_field_counts, vidx) };
                let payload_pat: *mut HirPat = unsafe { (*pat).payload };
                if (payload_pat as usize) != 0 {
                    if unsafe { (*payload_pat).kind } != HIR_PAT_TUPLE {
                        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                    }
                    let mut count: usize = 0;
                    let mut p: *mut HirPat = unsafe { (*payload_pat).elems };
                    while ((p as usize) != 0) {
                        count = count + 1;
                        p = unsafe { (*p).next };
                    }
                    if count != vfc {
                        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                    }
                    let row = unsafe { *typeid_ptr_at((*t).variant_fields, vidx) };
                    let mut i: usize = 0;
                    p = unsafe { (*payload_pat).elems };
                    while ((p as usize) != 0) {
                        let fty_v = unsafe { (*typeid_at(row, i)).v };
                        let r_fty = resolve_ty(mut_view(*cx), (TypeId { v: fty_v }));
                        check_pat(mut_view(*cx), p, (TypeId { v: r_fty.v }), is_init);
                        i = i + 1;
                        p = unsafe { (*p).next };
                    }
                } else {
                    if vfc > 0 {
                        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
                    }
                }
                break;
            }
            vidx = vidx + 1;
            v = unsafe { (*v).next };
        }
        if !found_variant {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        ty.v = path_ty.v;
    } else if pk == HIR_PAT_TUPLE {
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        if ty.v == 0u32 {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_UNKNOWN) };
        }
        let rty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rty.v })) };
        if (t as usize) == 0 || unsafe { (*t).kind } != TY_TUPLE {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let mut count: usize = 0;
        let mut p: *mut HirPat = unsafe { (*pat).elems };
        while ((p as usize) != 0) {
            count = count + 1;
            p = unsafe { (*p).next };
        }
        if count != unsafe { (*t).field_count } {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        p = unsafe { (*pat).elems };
        while ((p as usize) != 0) {
            let fty_v = unsafe { (*typeid_at(fptr, i)).v };
            check_pat(mut_view(*cx), p, (TypeId { v: fty_v }), is_init);
            i = i + 1;
            p = unsafe { (*p).next };
        }
    } else if pk == HIR_PAT_RANGE {
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        if ty.v == 0u32 {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_UNKNOWN) };
        }
        let rty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        let k = kind_of(mut_view(*cx), (TypeId { v: rty.v }));
        if k != TY_I8 && k != TY_I16 && k != TY_I32 && k != TY_I64 && k != TY_I128 && k != TY_ISIZE &&
           k != TY_U8 && k != TY_U16 && k != TY_U32 && k != TY_U64 && k != TY_U128 && k != TY_USIZE &&
           k != TY_CHAR && k != TY_INT_VAR {
            return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_MISMATCH) };
        }
        let sp_start: *mut HirPat = unsafe { (*pat).start_pat };
        let sp_end: *mut HirPat = unsafe { (*pat).end_pat };
        check_pat(mut_view(*cx), sp_start, (TypeId { v: ty.v }), is_init);
        check_pat(mut_view(*cx), sp_end, (TypeId { v: ty.v }), is_init);
    } else if pk == HIR_PAT_OR {
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) {
            let ev = unsafe { (*cx.thir).interner.t_error.v };
            return (TypeId { v: ev });
        }
        let mut p: *mut HirPat = unsafe { (*pat).pats };
        while ((p as usize) != 0) {
            check_pat(mut_view(*cx), p, (TypeId { v: ty.v }), is_init);
            p = unsafe { (*p).next };
        }
    } else {
        return unsafe { type_error(mut_view(*cx), view((*pat).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) };
    }
    unsafe { thir_set_pat_type(mut_view(*cx.thir), pat, (TypeId { v: ty.v })); }
    ty
}

fn tc_match_check_exhaustiveness(
    thir: mut_view<Thir>,
    tv: mut_view<TypeVarTable>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    expr: *const HirExpr,
    val_ty: TypeId
) {
    match_check_exhaustiveness_with_tv(mut_view(*thir), mut_view(*tv), str_in, db, mut_view(*sink), expr, (TypeId { v: val_ty.v }));
}

fn check_literal(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    let tk = unsafe { (*expr).literal.kind };
    unsafe {
        if tk == TOK_KW_TRUE || tk == TOK_KW_FALSE {
            return (TypeId { v: (*cx.thir).interner.t_bool.v });
        }
        if tk == TOK_CHAR {
            return (TypeId { v: (*cx.thir).interner.t_char.v });
        }
        if tk == TOK_INT {
            return int_literal_type(mut_view(*cx), view((*expr).literal), view((*expr).span));
        }
        if tk == TOK_FLOAT {
            return float_literal_type(mut_view(*cx), view((*expr).literal), view((*expr).span));
        }
        if tk == TOK_STR || tk == TOK_BYTE_STR {
            return (TypeId { v: (*cx.thir).interner.t_str.v });
        }
        (TypeId { v: (*cx.thir).interner.t_error.v })
    }
}

fn binop_method_idx(op: u8) -> usize {
    if op == BINOP_ADD { return 16; }
    if op == BINOP_SUB { return 17; }
    if op == BINOP_MUL { return 18; }
    if op == BINOP_DIV { return 19; }
    if op == BINOP_REM { return 20; }
    if op == BINOP_BITAND { return 21; }
    if op == BINOP_BITOR { return 22; }
    if op == BINOP_BITXOR { return 23; }
    if op == BINOP_SHL { return 24; }
    if op == BINOP_SHR { return 25; }
    if op == BINOP_EQ || op == BINOP_NE { return 26; }
    if op == BINOP_LT || op == BINOP_LE || op == BINOP_GT || op == BINOP_GE { return 27; }
    0
}

fn int_kind_bits(k: u8) -> u32 {
    if k == TY_I8 || k == TY_U8 { return 8u32; }
    if k == TY_I16 || k == TY_U16 { return 16u32; }
    if k == TY_I32 || k == TY_U32 { return 32u32; }
    if k == TY_I64 || k == TY_ISIZE || k == TY_U64 || k == TY_USIZE { return 64u32; }
    if k == TY_I128 || k == TY_U128 { return 128u32; }
    0u32
}

fn signed_type_for_bits(cx: view<TypeckCtx>, bits: u32) -> TypeId {
    unsafe {
        if bits == 8u32 { return (TypeId { v: (*cx.thir).interner.t_i8.v }); }
        if bits == 16u32 { return (TypeId { v: (*cx.thir).interner.t_i16.v }); }
        if bits == 32u32 { return (TypeId { v: (*cx.thir).interner.t_i32.v }); }
        if bits == 64u32 { return (TypeId { v: (*cx.thir).interner.t_i64.v }); }
        if bits == 128u32 { return (TypeId { v: (*cx.thir).interner.t_i128.v }); }
    }
    (TypeId { v: 0u32 })
}

fn can_widen_int_to(cx: mut_view<TypeckCtx>, from: TypeId, to: TypeId) -> bool {
    let rf = resolve_ty(mut_view(*cx), (TypeId { v: from.v }));
    let rt = resolve_ty(mut_view(*cx), (TypeId { v: to.v }));
    if !unsafe { type_is_int((TypeId { v: rf.v }), view((*cx.thir).interner)) } { return false; }
    if !unsafe { type_is_int((TypeId { v: rt.v }), view((*cx.thir).interner)) } { return false; }
    if rf.v == rt.v { return true; }
    let sf = unsafe { type_is_signed((TypeId { v: rf.v }), view((*cx.thir).interner)) };
    let st = unsafe { type_is_signed((TypeId { v: rt.v }), view((*cx.thir).interner)) };
    let bf = int_kind_bits(kind_of(mut_view(*cx), (TypeId { v: rf.v })));
    let bt = int_kind_bits(kind_of(mut_view(*cx), (TypeId { v: rt.v })));
    if bf == 0u32 || bt == 0u32 { return false; }
    if sf && st { return bf <= bt; }
    if !sf && !st { return bf <= bt; }
    if !sf && st { return bf < bt; }
    false
}

pub fn join_int(cx: mut_view<TypeckCtx>, a: TypeId, b: TypeId, expected: TypeId) -> TypeId {
    let ra = resolve_ty(mut_view(*cx), (TypeId { v: a.v }));
    let rb = resolve_ty(mut_view(*cx), (TypeId { v: b.v }));
    let re = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
    if !unsafe { type_is_int((TypeId { v: ra.v }), view((*cx.thir).interner)) } { return (TypeId { v: 0u32 }); }
    if !unsafe { type_is_int((TypeId { v: rb.v }), view((*cx.thir).interner)) } { return (TypeId { v: 0u32 }); }
    if ra.v == rb.v { return (TypeId { v: ra.v }); }
    let ka = kind_of(mut_view(*cx), (TypeId { v: ra.v }));
    let kb = kind_of(mut_view(*cx), (TypeId { v: rb.v }));
    let ke = kind_of(mut_view(*cx), (TypeId { v: re.v }));
    let sa = unsafe { type_is_signed((TypeId { v: ra.v }), view((*cx.thir).interner)) };
    let sb = unsafe { type_is_signed((TypeId { v: rb.v }), view((*cx.thir).interner)) };
    let ba = int_kind_bits(ka);
    let bb = int_kind_bits(kb);
    if ba == 0u32 || bb == 0u32 { return (TypeId { v: 0u32 }); }
    if sa && sb {
        if ba > bb { return (TypeId { v: ra.v }); }
        if bb > ba { return (TypeId { v: rb.v }); }
        return unsafe {
            if ke == TY_ISIZE {
                (TypeId { v: (*cx.thir).interner.t_isize.v })
            } else {
                (TypeId { v: (*cx.thir).interner.t_i64.v })
            }
        };
    }
    if !sa && !sb {
        if ba > bb { return (TypeId { v: ra.v }); }
        if bb > ba { return (TypeId { v: rb.v }); }
        return unsafe {
            if ke == TY_USIZE {
                (TypeId { v: (*cx.thir).interner.t_usize.v })
            } else {
                (TypeId { v: (*cx.thir).interner.t_u64.v })
            }
        };
    }
    let s_ty = if sa { ra } else { rb };
    let s_bits = if sa { ba } else { bb };
    let u_bits = if sa { bb } else { ba };
    if s_bits > u_bits {
        return (TypeId { v: s_ty.v });
    }
    if s_bits < u_bits {
        if u_bits == 16u32 { return signed_type_for_bits(view(*cx), 32u32); }
        if u_bits == 32u32 { return signed_type_for_bits(view(*cx), 64u32); }
        if u_bits == 64u32 { return signed_type_for_bits(view(*cx), 128u32); }
        return (TypeId { v: 0u32 });
    }
    if re.v != 0u32 && unsafe { type_is_signed((TypeId { v: re.v }), view((*cx.thir).interner)) } && int_kind_bits(ke) > s_bits {
        return (TypeId { v: re.v });
    }
    (TypeId { v: 0u32 })
}

fn is_arith_binop_expr(expr: *const HirExpr) -> bool {
    if (expr as usize) == 0 { return false; }
    if unsafe { (*expr).kind } != HIR_EXPR_BINARY { return false; }
    let op = unsafe { (*expr).op };
    op == BINOP_ADD || op == BINOP_SUB || op == BINOP_MUL || op == BINOP_DIV || op == BINOP_REM ||
    op == BINOP_BITAND || op == BINOP_BITOR || op == BINOP_BITXOR
}

// An implicit integer promotion cast synthesized by typeck (a cast node without a source type).
fn tc_is_promote_cast(expr: *const HirExpr) -> bool {
    if (expr as usize) == 0 { return false; }
    if unsafe { (*expr).kind } != HIR_EXPR_CAST { return false; }
    (unsafe { (*expr).cast_ty } as usize) == 0
}

fn is_arith_unary_expr(expr: *const HirExpr) -> bool {
    if (expr as usize) == 0 { return false; }
    if unsafe { (*expr).kind } != HIR_EXPR_UNARY { return false; }
    let uop = unsafe { (*expr).op };
    uop == UNOP_NEG || uop == UNOP_BITNOT
}

fn is_arith_tree_subexpr(expr: *const HirExpr) -> bool {
    is_arith_binop_expr(expr) || is_arith_unary_expr(expr)
}

fn tree_has_arith_binop(expr: *const HirExpr) -> bool {
    if (expr as usize) == 0 { return false; }
    if is_arith_binop_expr(expr) { return true; }
    if is_arith_unary_expr(expr) {
        let in_ptr: *const HirExpr = (unsafe { (*expr).inner }) as *const HirExpr;
        return tree_has_arith_binop(in_ptr);
    }
    false
}

fn merge_arith_leaf_ty(cx: mut_view<TypeckCtx>, leaf_ty: TypeId, expected: TypeId, acc: mut_view<TypeId>) -> bool {
    let rl = resolve_ty(mut_view(*cx), (TypeId { v: leaf_ty.v }));
    if rl.v == 0u32 || !unsafe { type_is_int((TypeId { v: rl.v }), view((*cx.thir).interner)) } {
        return false;
    }
    if (*acc).v == 0u32 {
        (*acc).v = rl.v;
        return true;
    }
    if (*acc).v == rl.v {
        return true;
    }
    let j = join_int(mut_view(*cx), (TypeId { v: (*acc).v }), (TypeId { v: rl.v }), (TypeId { v: expected.v }));
    if j.v != 0u32 {
        (*acc).v = j.v;
        return true;
    }
    false
}

fn peek_prim_int_name(cx: view<TypeckCtx>, name: view<StrView>) -> TypeId {
    unsafe {
        if tc_sv_is_2(name, 105u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_i8.v }); }
        if tc_sv_is_3(name, 105u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_i16.v }); }
        if tc_sv_is_3(name, 105u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_i32.v }); }
        if tc_sv_is_3(name, 105u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_i64.v }); }
        if tc_sv_is_4(name, 105u8, 49u8, 50u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_i128.v }); }
        if tc_sv_is_5(name, 105u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_isize.v }); }
        if tc_sv_is_2(name, 117u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_u8.v }); }
        if tc_sv_is_3(name, 117u8, 49u8, 54u8) { return (TypeId { v: (*cx.thir).interner.t_u16.v }); }
        if tc_sv_is_3(name, 117u8, 51u8, 50u8) { return (TypeId { v: (*cx.thir).interner.t_u32.v }); }
        if tc_sv_is_3(name, 117u8, 54u8, 52u8) { return (TypeId { v: (*cx.thir).interner.t_u64.v }); }
        if tc_sv_is_4(name, 117u8, 49u8, 50u8, 56u8) { return (TypeId { v: (*cx.thir).interner.t_u128.v }); }
        if tc_sv_is_5(name, 117u8, 115u8, 105u8, 122u8, 101u8) { return (TypeId { v: (*cx.thir).interner.t_usize.v }); }
    }
    (TypeId { v: 0u32 })
}

fn peek_prim_int_hir_type(cx: view<TypeckCtx>, ht: *const HirType) -> TypeId {
    if (ht as usize) == 0 || (unsafe { (*ht).kind }) != HIR_TYPE_PATH {
        return (TypeId { v: 0u32 });
    }
    let name = unsafe { tc_path_name_sv(cx, view((*ht).path)) };
    let prim = peek_prim_int_name(cx, view(name));
    if prim.v != 0u32 {
        return prim;
    }
    let tsym_v = unsafe { (*ht).path.symbol.v };
    if tsym_v != 0u32 {
        let tit = find_item_by_symbol(cx, (SymbolId { v: tsym_v }));
        if (tit as usize) != 0 && (unsafe { (*tit).kind }) == HIR_ITEM_TYPE_ALIAS {
            let tty = unsafe { thir_get_item_type(view(*cx.thir), tit) };
            if tty.v != 0u32 {
                return tty;
            }
        }
    }
    (TypeId { v: 0u32 })
}

fn peek_expr_type_nonmut(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    if (expr as usize) == 0 { return (TypeId { v: 0u32 }); }
    let existing = unsafe { thir_get_expr_type(view(*cx.thir), expr) };
    if existing.v != 0u32 {
        return resolve_ty(mut_view(*cx), (TypeId { v: existing.v }));
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_LITERAL {
        if (unsafe { (*expr).literal.kind }) == TOK_INT {
            return suffix_to_type(mut_view(*cx), unsafe { (*expr).literal.suffix });
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        if sym_v != 0u32 {
            let in_active = tc_sym_in_active_scope(view(*cx), sym_v);
            if in_active {
                let st = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: sym_v })) };
                if st.v != 0u32 {
                    return resolve_ty(mut_view(*cx), (TypeId { v: st.v }));
                }
            }
            let it = find_item_by_symbol(view(*cx), (SymbolId { v: sym_v }));
            if (it as usize) != 0 {
                let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
                if (gps as usize) == 0 || (unsafe { (*gps).params } as usize) == 0 {
                    let it_t = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if it_t.v != 0u32 {
                        return resolve_ty(mut_view(*cx), (TypeId { v: it_t.v }));
                    }
                    let ik = unsafe { (*it).kind };
                    if ik == HIR_ITEM_CONST || ik == HIR_ITEM_STATIC {
                        let ht_ptr: *const HirType = (unsafe { (*it).ty }) as *const HirType;
                        return peek_prim_int_hir_type(view(*cx), ht_ptr);
                    }
                }
            }
            if !in_active {
                let st2 = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: sym_v })) };
                if st2.v != 0u32 {
                    return resolve_ty(mut_view(*cx), (TypeId { v: st2.v }));
                }
            }
        }
        let pname = unsafe { tc_path_name_sv(view(*cx), view((*expr).path)) };
        return peek_prim_int_name(view(*cx), view(pname));
    }
    if ek == HIR_EXPR_CAST {
        if tc_is_promote_cast(expr) {
            let pt = unsafe { thir_get_expr_type(view(*cx.thir), expr) };
            if pt.v != 0u32 {
                return resolve_ty(mut_view(*cx), (TypeId { v: pt.v }));
            }
            return (TypeId { v: 0u32 });
        }
        let cty_ptr: *const HirType = (unsafe { (*expr).cast_ty }) as *const HirType;
        let p = peek_prim_int_hir_type(view(*cx), cty_ptr);
        if p.v != 0u32 {
            return resolve_ty(mut_view(*cx), (TypeId { v: p.v }));
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_FIELD {
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let raw_b = peek_expr_type_nonmut(mut_view(*cx), b_expr);
        if raw_b.v == 0u32 || (cx.str_in as usize) == 0 {
            return (TypeId { v: 0u32 });
        }
        let mut base_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_b.v }));
        let mut t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        while ((t as usize) != 0 && ((unsafe { (*t).kind }) == TY_VIEW || (unsafe { (*t).kind }) == TY_MUT_VIEW || (unsafe { (*t).kind }) == TY_PTR)) {
            let pt_v = unsafe { (*t).pointee.v };
            base_ty = resolve_ty(mut_view(*cx), (TypeId { v: pt_v }));
            t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        }
        if (t as usize) == 0 { return (TypeId { v: 0u32 }); }
        let tk = unsafe { (*t).kind };
        let search = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*expr).name.v })) };
        if tk == TY_STRUCT {
            let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
            let fptr = unsafe { (*t).fields };
            let fcnt = unsafe { (*t).field_count };
            let mut idx: usize = 0;
            let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
            while ((f as usize) != 0 && idx < fcnt) {
                let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                if sv_eq(view(fname), view(search)) {
                    let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                    return resolve_ty(mut_view(*cx), (TypeId { v: fty_v }));
                }
                idx = idx + 1;
                f = unsafe { (*f).next };
            }
            return (TypeId { v: 0u32 });
        }
        if unsafe { type_is_int((TypeId { v: base_ty.v }), view((*cx.thir).interner)) } {
            if tc_sv_is_3(view(search), 77u8, 73u8, 78u8) || tc_sv_is_3(view(search), 77u8, 65u8, 88u8) {
                return base_ty;
            }
            if tc_sv_is_4(view(search), 66u8, 73u8, 84u8, 83u8) {
                let u32_v = unsafe { (*cx.thir).interner.t_u32.v };
                return (TypeId { v: u32_v });
            }
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_TUPLE_INDEX {
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let raw_b = peek_expr_type_nonmut(mut_view(*cx), b_expr);
        if raw_b.v == 0u32 { return (TypeId { v: 0u32 }); }
        let mut base_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_b.v }));
        let mut t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        while ((t as usize) != 0 && ((unsafe { (*t).kind }) == TY_VIEW || (unsafe { (*t).kind }) == TY_MUT_VIEW || (unsafe { (*t).kind }) == TY_PTR)) {
            let pt_v = unsafe { (*t).pointee.v };
            base_ty = resolve_ty(mut_view(*cx), (TypeId { v: pt_v }));
            t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        }
        if (t as usize) == 0 { return (TypeId { v: 0u32 }); }
        let tk = unsafe { (*t).kind };
        let tidx = (unsafe { (*expr).tuple_index }) as usize;
        if tk == TY_TUPLE {
            if tidx < (unsafe { (*t).field_count }) {
                let fty_v = unsafe { (*typeid_at((*t).fields, tidx)).v };
                return resolve_ty(mut_view(*cx), (TypeId { v: fty_v }));
            }
        } else if tk == TY_STRUCT {
            let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
            if (sdef as usize) != 0 && (unsafe { (*sdef).is_tuple }) && tidx < (unsafe { (*t).field_count }) {
                let fty_v = unsafe { (*typeid_at((*t).fields, tidx)).v };
                return resolve_ty(mut_view(*cx), (TypeId { v: fty_v }));
            }
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_INDEX {
        let ia_expr: *mut HirExpr = unsafe { (*expr).index_arg };
        if (ia_expr as usize) != 0 && (unsafe { (*ia_expr).kind }) == HIR_EXPR_RANGE {
            return (TypeId { v: 0u32 });
        }
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let raw_b = peek_expr_type_nonmut(mut_view(*cx), b_expr);
        if raw_b.v == 0u32 { return (TypeId { v: 0u32 }); }
        let r_b = resolve_ty(mut_view(*cx), (TypeId { v: raw_b.v }));
        let mut bt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_b.v })) };
        while ((bt as usize) != 0 && ((unsafe { (*bt).kind }) == TY_VIEW || (unsafe { (*bt).kind }) == TY_MUT_VIEW)) {
            let pt = resolve_ty(mut_view(*cx), (TypeId { v: unsafe { (*bt).pointee.v } }));
            bt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pt.v })) };
        }
        if (bt as usize) != 0 {
            let btk = unsafe { (*bt).kind };
            if btk == TY_ARRAY || btk == TY_SLICE {
                return resolve_ty(mut_view(*cx), (TypeId { v: unsafe { (*bt).elem.v } }));
            }
            if btk == TY_STR {
                let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
                return (TypeId { v: u8_v });
            }
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_CALL {
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
            let cname = unsafe { tc_path_name_sv(view(*cx), view((*callee).path)) };
            let bk = builtin_name_kind(view(cname));
            if bk == TY_BUILTIN_LEN || bk == TY_BUILTIN_SIZE_OF || bk == TY_BUILTIN_ALIGN_OF {
                let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
                return (TypeId { v: usize_v });
            }
        }
        let cty = peek_expr_type_nonmut(mut_view(*cx), callee);
        if cty.v != 0u32 {
            let ct = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: cty.v })) };
            if (ct as usize) != 0 {
                let ck = unsafe { (*ct).kind };
                if ck == TY_FN || ck == TY_CLOSURE {
                    let ret_v = unsafe { (*ct).ret_type.v };
                    if ret_v != 0u32 {
                        return resolve_ty(mut_view(*cx), (TypeId { v: ret_v }));
                    }
                }
            }
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_METHOD_CALL {
        let recv: *mut HirExpr = unsafe { (*expr).receiver };
        let raw_r = peek_expr_type_nonmut(mut_view(*cx), recv);
        if raw_r.v == 0u32 || (cx.str_in as usize) == 0 { return (TypeId { v: 0u32 }); }
        let mut base_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_r.v }));
        let mut t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        while ((t as usize) != 0 && ((unsafe { (*t).kind }) == TY_VIEW || (unsafe { (*t).kind }) == TY_MUT_VIEW || (unsafe { (*t).kind }) == TY_PTR)) {
            let pt_v = unsafe { (*t).pointee.v };
            base_ty = resolve_ty(mut_view(*cx), (TypeId { v: pt_v }));
            t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        }
        if (t as usize) == 0 { return (TypeId { v: 0u32 }); }
        let mname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*expr).method_name.v })) };
        if (cx.hir as usize) != 0 && (cx.db as usize) != 0 {
            let mut trait_res: u8 = TRAIT_DISPROVEN;
            let method_item = unsafe { find_method_in_scope(view(*cx.hir), view(*cx.thir), (TypeId { v: base_ty.v }), view(mname), cx.current_fn, cx.current_impl, view(*cx.str_in), view(*cx.db), mut_view(trait_res)) };
            if (method_item as usize) != 0 && tc_method_impl_matches_receiver(view(*cx), method_item, (TypeId { v: base_ty.v })) {
                let gps: *mut HirGenericParams = unsafe { (*method_item).generic_params };
                if (gps as usize) == 0 || (unsafe { (*gps).params } as usize) == 0 {
                    let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), method_item) };
                    if fn_ty_id.v != 0u32 {
                        let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
                        if (fn_ty as usize) != 0 {
                            let ret_v = unsafe { (*fn_ty).ret_type.v };
                            if ret_v != 0u32 {
                                let rk = kind_of(mut_view(*cx), (TypeId { v: ret_v }));
                                if rk == TY_PARAM {
                                    return base_ty;
                                }
                                return resolve_ty(mut_view(*cx), (TypeId { v: ret_v }));
                            }
                        }
                    }
                }
                return (TypeId { v: 0u32 });
            }
        }
        let iref = intrinsic_lookup_int_method(mname, unsafe { (*t).kind });
        if iref.has_desc {
            let op = iref.desc.op;
            if op == INTR_OP_LEADING_ZEROS || op == INTR_OP_TRAILING_ZEROS || op == INTR_OP_COUNT_ONES {
                let u32_v = unsafe { (*cx.thir).interner.t_u32.v };
                return (TypeId { v: u32_v });
            }
            return base_ty;
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_UNARY {
        let uop = unsafe { (*expr).op };
        if uop == UNOP_DEREF {
            let in_ptr: *const HirExpr = (unsafe { (*expr).inner }) as *const HirExpr;
            let raw_op = peek_expr_type_nonmut(mut_view(*cx), in_ptr);
            if raw_op.v != 0u32 {
                let r_op = resolve_ty(mut_view(*cx), (TypeId { v: raw_op.v }));
                let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_op.v })) };
                if (t as usize) != 0 {
                    let tk = unsafe { (*t).kind };
                    if tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW {
                        return resolve_ty(mut_view(*cx), (TypeId { v: unsafe { (*t).pointee.v } }));
                    }
                }
            }
            return (TypeId { v: 0u32 });
        }
        if uop == UNOP_NEG || uop == UNOP_BITNOT {
            return peek_arith_tree_int_type(mut_view(*cx), expr, (TypeId { v: 0u32 }));
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_BINARY {
        let op = unsafe { (*expr).op };
        if is_arith_binop_expr(expr) || op == BINOP_SHL || op == BINOP_SHR {
            return peek_arith_tree_int_type(mut_view(*cx), expr, (TypeId { v: 0u32 }));
        }
        return (TypeId { v: 0u32 });
    }
    if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        if (blk as usize) != 0 {
            let mut s: *mut HirStmt = unsafe { (*blk).stmts };
            let mut last: *mut HirStmt = 0 as *mut HirStmt;
            while ((s as usize) != 0) {
                last = s;
                s = unsafe { (*s).next };
            }
            if (last as usize) != 0 && (unsafe { (*last).kind }) == HIR_STMT_EXPR && !(unsafe { (*last).has_semi }) {
                let tail_ptr: *const HirExpr = (unsafe { (*last).expr }) as *const HirExpr;
                return peek_expr_type_nonmut(mut_view(*cx), tail_ptr);
            }
        }
        return (TypeId { v: 0u32 });
    }
    (TypeId { v: 0u32 })
}

fn collect_arith_tree_join(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId, acc: mut_view<TypeId>) -> bool {
    if (expr as usize) == 0 { return false; }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_BINARY {
        let op = unsafe { (*expr).op };
        let lptr: *mut HirExpr = unsafe { (*expr).left };
        let rptr: *mut HirExpr = unsafe { (*expr).right };
        if op == BINOP_ADD || op == BINOP_SUB || op == BINOP_MUL || op == BINOP_DIV || op == BINOP_REM ||
           op == BINOP_BITAND || op == BINOP_BITOR || op == BINOP_BITXOR {
            if !collect_arith_tree_join(mut_view(*cx), lptr, (TypeId { v: expected.v }), mut_view(*acc)) {
                return false;
            }
            return collect_arith_tree_join(mut_view(*cx), rptr, (TypeId { v: expected.v }), mut_view(*acc));
        }
        if op == BINOP_SHL || op == BINOP_SHR {
            return collect_arith_tree_join(mut_view(*cx), lptr, (TypeId { v: expected.v }), mut_view(*acc));
        }
        return false;
    }
    if ek == HIR_EXPR_UNARY {
        let uop = unsafe { (*expr).op };
        if uop == UNOP_NEG || uop == UNOP_BITNOT {
            let in_ptr: *mut HirExpr = unsafe { (*expr).inner };
            return collect_arith_tree_join(mut_view(*cx), in_ptr, (TypeId { v: expected.v }), mut_view(*acc));
        }
    }
    if ek == HIR_EXPR_LITERAL {
        if unsafe { (*expr).literal.kind } == TOK_INT {
            let sty = suffix_to_type(mut_view(*cx), unsafe { (*expr).literal.suffix });
            if sty.v != 0u32 {
                return merge_arith_leaf_ty(mut_view(*cx), (TypeId { v: sty.v }), (TypeId { v: expected.v }), mut_view(*acc));
            }
            return true;
        }
        return false;
    }
    let pty = peek_expr_type_nonmut(mut_view(*cx), expr);
    if pty.v == 0u32 {
        return false;
    }
    let rp = resolve_ty(mut_view(*cx), (TypeId { v: pty.v }));
    if rp.v == 0u32 {
        return false;
    }
    if unsafe { type_is_int((TypeId { v: rp.v }), view((*cx.thir).interner)) } {
        return merge_arith_leaf_ty(mut_view(*cx), (TypeId { v: rp.v }), (TypeId { v: expected.v }), mut_view(*acc));
    }
    kind_of(mut_view(*cx), (TypeId { v: rp.v })) == TY_INT_VAR
}

fn peek_arith_tree_int_type(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let mut acc = (TypeId { v: 0u32 });
    if !collect_arith_tree_join(mut_view(*cx), expr, (TypeId { v: expected.v }), mut_view(acc)) {
        return (TypeId { v: 0u32 });
    }
    let re = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
    if acc.v != 0u32 && re.v != 0u32 && unsafe { type_is_int((TypeId { v: re.v }), view((*cx.thir).interner)) } {
        if can_widen_int_to(mut_view(*cx), (TypeId { v: acc.v }), (TypeId { v: re.v })) {
            acc.v = re.v;
        }
    }
    acc
}

fn check_arith_subexpr(cx: mut_view<TypeckCtx>, expr: *const HirExpr, ctx_ty: TypeId) -> TypeId {
    if (expr as usize) == 0 {
        let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
        return (TypeId { v: unit_v });
    }
    if is_arith_unary_expr(expr) && ctx_ty.v != 0u32 {
        let ty = check_unary_in_arith(mut_view(*cx), expr, (TypeId { v: ctx_ty.v }));
        unsafe { thir_set_expr_type(mut_view(*cx.thir), expr, (TypeId { v: ty.v })); }
        return ty;
    }
    let exp = if is_arith_binop_expr(expr) { (TypeId { v: ctx_ty.v }) } else { (TypeId { v: 0u32 }) };
    check_expr(mut_view(*cx), expr, exp)
}

fn check_unary_in_arith(cx: mut_view<TypeckCtx>, expr: *const HirExpr, ctx_ty: TypeId) -> TypeId {
    let operand: *mut HirExpr = unsafe { (*expr).inner };
    let op = unsafe { (*expr).op };
    let rc = resolve_ty(mut_view(*cx), (TypeId { v: ctx_ty.v }));
    if op == UNOP_NEG {
        if (operand as usize) != 0 && (unsafe { (*operand).kind }) == HIR_EXPR_LITERAL && (unsafe { (*operand).literal.kind }) == TOK_INT {
            let before = cx.lits_len;
            let ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
            if cx.lits_len == before + 1 {
                let lc = unsafe { litcheck_at(cx.lits, before) };
                unsafe {
                    (*lc).negated = true;
                    (*lc).unary = expr as *mut HirExpr;
                    (*lc).neg_span.file.v = (*expr).span.file.v;
                    (*lc).neg_span.start = (*expr).span.start;
                    (*lc).neg_span.end = (*expr).span.end;
                }
            }
            let r_lit = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
            if kind_of(mut_view(*cx), (TypeId { v: r_lit.v })) == TY_INT_VAR &&
               rc.v != 0u32 && unsafe { type_is_signed((TypeId { v: rc.v }), view((*cx.thir).interner)) } {
                let _ = unify_ty(mut_view(*cx), (TypeId { v: r_lit.v }), (TypeId { v: rc.v }));
                return rc;
            }
            return (TypeId { v: ty.v });
        }
        let ty = check_arith_subexpr(mut_view(*cx), operand, (TypeId { v: rc.v }));
        let r = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        let k = kind_of(mut_view(*cx), (TypeId { v: r.v }));
        if k == TY_ERROR || k == TY_NEVER { return (TypeId { v: r.v }); }
        if k == TY_F32 || k == TY_F64 || k == TY_FLOAT_VAR { return (TypeId { v: r.v }); }
        if k == TY_INT_VAR {
            unsafe { push_neg_check(mut_view(*cx), view((*expr).span), (TypeId { v: r.v })); }
            if rc.v != 0u32 && unsafe { type_is_signed((TypeId { v: rc.v }), view((*cx.thir).interner)) } {
                let _ = unify_ty(mut_view(*cx), (TypeId { v: r.v }), (TypeId { v: rc.v }));
                return rc;
            }
            return (TypeId { v: r.v });
        }
        let is_sig = unsafe { type_is_signed((TypeId { v: r.v }), view((*cx.thir).interner)) };
        if is_sig {
            if rc.v != 0u32 && unsafe { type_is_signed((TypeId { v: rc.v }), view((*cx.thir).interner)) } &&
               can_widen_int_to(mut_view(*cx), (TypeId { v: r.v }), (TypeId { v: rc.v })) {
                return rc;
            }
            return (TypeId { v: r.v });
        }
        let is_uns = unsafe { type_is_unsigned((TypeId { v: r.v }), view((*cx.thir).interner)) };
        if is_uns {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_NEG_UNSIGNED) };
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }
    if op == UNOP_BITNOT {
        // ADR-0044 section 2 / SPEC-40 AXS-INT-052 rule 4: inside a widening tree `~` is evaluated in the
        // context type, so a narrower concrete operand is first widened by an implicit promotion cast
        // (a HIR_EXPR_CAST with a null `cast_ty`, typed `rc`).  A re-check of this node drops the cast
        // inserted by the previous check and decides again.
        let em: *mut HirExpr = expr as *mut HirExpr;
        let mut opnd: *mut HirExpr = operand;
        if tc_is_promote_cast(opnd as *const HirExpr) {
            opnd = unsafe { (*opnd).inner };
            unsafe { (*em).inner = opnd; }
        }
        let ty = check_arith_subexpr(mut_view(*cx), opnd, (TypeId { v: rc.v }));
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) || is_never(mut_view(*cx), (TypeId { v: ty.v })) || is_intlike(mut_view(*cx), (TypeId { v: ty.v })) {
            let r = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
            if kind_of(mut_view(*cx), (TypeId { v: r.v })) == TY_INT_VAR &&
               rc.v != 0u32 && unsafe { type_is_int((TypeId { v: rc.v }), view((*cx.thir).interner)) } {
                let _ = unify_ty(mut_view(*cx), (TypeId { v: r.v }), (TypeId { v: rc.v }));
                return rc;
            }
            if rc.v != 0u32 && r.v != rc.v && (opnd as usize) != 0 &&
               unsafe { type_is_int((TypeId { v: r.v }), view((*cx.thir).interner)) } &&
               unsafe { type_is_int((TypeId { v: rc.v }), view((*cx.thir).interner)) } &&
               can_widen_int_to(mut_view(*cx), (TypeId { v: r.v }), (TypeId { v: rc.v })) {
                let pc = unsafe { tc_alloc_expr(mut_view(*cx), HIR_EXPR_CAST, (*opnd).span.file.v, (*opnd).span.start, (*opnd).span.end) };
                unsafe {
                    (*pc).inner = opnd;
                    (*pc).cast_ty = 0 as *mut HirType;
                    thir_set_expr_type(mut_view(*cx.thir), pc as *const HirExpr, (TypeId { v: rc.v }));
                    (*em).inner = pc;
                }
                return rc;
            }
            return r;
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }
    check_unary(mut_view(*cx), expr)
}

fn check_binary(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let op = unsafe { (*expr).op };
    let lptr: *mut HirExpr = unsafe { (*expr).left };
    let rptr: *mut HirExpr = unsafe { (*expr).right };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let isize_v = unsafe { (*cx.thir).interner.t_isize.v };

    if op == BINOP_LOGAND || op == BINOP_LOGOR {
        check_expr(mut_view(*cx), lptr, (TypeId { v: bool_v }));
        check_expr(mut_view(*cx), rptr, (TypeId { v: bool_v }));
        return (TypeId { v: bool_v });
    }

    if op == BINOP_SHL || op == BINOP_SHR {
        let left_ty = check_expr(mut_view(*cx), lptr, (TypeId { v: 0u32 }));
        let right_ty = check_expr(mut_view(*cx), rptr, (TypeId { v: 0u32 }));
        if !is_error(mut_view(*cx), (TypeId { v: left_ty.v })) && !is_intlike(mut_view(*cx), (TypeId { v: left_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*lptr).span), AX_TYPE_OPERATOR) };
        }
        if !is_error(mut_view(*cx), (TypeId { v: right_ty.v })) && !is_intlike(mut_view(*cx), (TypeId { v: right_ty.v })) {
            return unsafe { type_error(mut_view(*cx), view((*rptr).span), AX_TYPE_OPERATOR) };
        }
        return (TypeId { v: left_ty.v });
    }

    let is_cmp = op >= BINOP_EQ && op <= BINOP_GE;
    let mut ctx_ty = (TypeId { v: 0u32 });
    if !is_cmp {
        ctx_ty = peek_arith_tree_int_type(mut_view(*cx), expr, (TypeId { v: expected.v }));
    } else {
        let lp = peek_arith_tree_int_type(mut_view(*cx), lptr, (TypeId { v: 0u32 }));
        let rp = peek_arith_tree_int_type(mut_view(*cx), rptr, (TypeId { v: 0u32 }));
        if lp.v != 0u32 && rp.v != 0u32 {
            ctx_ty = join_int(mut_view(*cx), (TypeId { v: lp.v }), (TypeId { v: rp.v }), (TypeId { v: 0u32 }));
        } else if lp.v != 0u32 {
            ctx_ty = lp;
        } else {
            ctx_ty = rp;
        }
    }

    let left_ty = if is_arith_tree_subexpr(lptr) {
        check_arith_subexpr(mut_view(*cx), lptr, (TypeId { v: ctx_ty.v }))
    } else {
        check_expr(mut_view(*cx), lptr, (TypeId { v: 0u32 }))
    };
    if (op == BINOP_ADD || op == BINOP_SUB) && kind_of(mut_view(*cx), (TypeId { v: left_ty.v })) == TY_PTR {
        let right_ty = check_expr(mut_view(*cx), rptr, (TypeId { v: 0u32 }));
        if is_error(mut_view(*cx), (TypeId { v: right_ty.v })) { return (TypeId { v: err_v }); }
        if op == BINOP_SUB && kind_of(mut_view(*cx), (TypeId { v: right_ty.v })) == TY_PTR {
            return (TypeId { v: isize_v });
        }
        if is_intlike(mut_view(*cx), (TypeId { v: right_ty.v })) {
            return (TypeId { v: left_ty.v });
        }
        return unsafe { type_error(mut_view(*cx), view((*rptr).span), AX_TYPE_OPERATOR) };
    }

    if is_floatlike(mut_view(*cx), (TypeId { v: left_ty.v })) {
        let right_f = if is_arith_tree_subexpr(rptr) {
            check_arith_subexpr(mut_view(*cx), rptr, (TypeId { v: 0u32 }))
        } else {
            check_expr(mut_view(*cx), rptr, (TypeId { v: 0u32 }))
        };
        return check_binary_float(mut_view(*cx), expr, lptr, (TypeId { v: left_ty.v }), rptr, (TypeId { v: right_f.v }), (TypeId { v: expected.v }));
    }

    let rl_pre = resolve_ty(mut_view(*cx), (TypeId { v: left_ty.v }));
    if unsafe { type_is_int((TypeId { v: rl_pre.v }), view((*cx.thir).interner)) } {
        let mut r_acc = (TypeId { v: ctx_ty.v });
        if r_acc.v != 0u32 || (is_arith_tree_subexpr(rptr) && collect_arith_tree_join(mut_view(*cx), rptr, (TypeId { v: expected.v }), mut_view(r_acc))) {
            if merge_arith_leaf_ty(mut_view(*cx), (TypeId { v: rl_pre.v }), (TypeId { v: expected.v }), mut_view(r_acc)) {
                ctx_ty.v = r_acc.v;
                let re_pre = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
                if !is_cmp && ctx_ty.v != 0u32 && re_pre.v != 0u32 && unsafe { type_is_int((TypeId { v: re_pre.v }), view((*cx.thir).interner)) } {
                    if can_widen_int_to(mut_view(*cx), (TypeId { v: ctx_ty.v }), (TypeId { v: re_pre.v })) {
                        ctx_ty.v = re_pre.v;
                    }
                }
            }
        }
    }

    let right_ty = if !is_intlike(mut_view(*cx), (TypeId { v: left_ty.v })) {
        check_expr(mut_view(*cx), rptr, (TypeId { v: left_ty.v }))
    } else if is_arith_tree_subexpr(rptr) {
        check_arith_subexpr(mut_view(*cx), rptr, (TypeId { v: ctx_ty.v }))
    } else {
        check_expr(mut_view(*cx), rptr, (TypeId { v: 0u32 }))
    };

    if is_intlike(mut_view(*cx), (TypeId { v: left_ty.v })) && is_floatlike(mut_view(*cx), (TypeId { v: right_ty.v })) {
        return check_binary_float(mut_view(*cx), expr, lptr, (TypeId { v: left_ty.v }), rptr, (TypeId { v: right_ty.v }), (TypeId { v: expected.v }));
    }

    if is_intlike(mut_view(*cx), (TypeId { v: left_ty.v })) && is_intlike(mut_view(*cx), (TypeId { v: right_ty.v })) {
        let rl = resolve_ty(mut_view(*cx), (TypeId { v: left_ty.v }));
        let rr = resolve_ty(mut_view(*cx), (TypeId { v: right_ty.v }));
        let kl = kind_of(mut_view(*cx), (TypeId { v: rl.v }));
        let kr = kind_of(mut_view(*cx), (TypeId { v: rr.v }));
        let mut opnd_int = (TypeId { v: 0u32 });
        if kl == TY_INT_VAR && kr == TY_INT_VAR {
            let _ = unify_ty(mut_view(*cx), (TypeId { v: rl.v }), (TypeId { v: rr.v }));
            if !is_cmp && ctx_ty.v != 0u32 && is_intlike(mut_view(*cx), (TypeId { v: ctx_ty.v })) {
                let _ = unify_ty(mut_view(*cx), (TypeId { v: rl.v }), (TypeId { v: ctx_ty.v }));
            } else if !is_cmp && expected.v != 0u32 && is_intlike(mut_view(*cx), (TypeId { v: expected.v })) {
                let _ = unify_ty(mut_view(*cx), (TypeId { v: rl.v }), (TypeId { v: expected.v }));
            }
            opnd_int = resolve_ty(mut_view(*cx), (TypeId { v: rl.v }));
        } else if kl == TY_INT_VAR {
            let mut t_join = (TypeId { v: rr.v });
            if !is_cmp && ctx_ty.v != 0u32 && can_widen_int_to(mut_view(*cx), (TypeId { v: rr.v }), (TypeId { v: ctx_ty.v })) {
                t_join.v = ctx_ty.v;
            }
            let _ = unify_ty(mut_view(*cx), (TypeId { v: rl.v }), (TypeId { v: t_join.v }));
            opnd_int.v = t_join.v;
        } else if kr == TY_INT_VAR {
            let mut t_join = (TypeId { v: rl.v });
            if !is_cmp && ctx_ty.v != 0u32 && can_widen_int_to(mut_view(*cx), (TypeId { v: rl.v }), (TypeId { v: ctx_ty.v })) {
                t_join.v = ctx_ty.v;
            }
            let _ = unify_ty(mut_view(*cx), (TypeId { v: rr.v }), (TypeId { v: t_join.v }));
            opnd_int.v = t_join.v;
        } else {
            let join_exp = if ctx_ty.v != 0u32 { (TypeId { v: ctx_ty.v }) } else { (TypeId { v: expected.v }) };
            let mut j = join_int(mut_view(*cx), (TypeId { v: rl.v }), (TypeId { v: rr.v }), (TypeId { v: join_exp.v }));
            if j.v == 0u32 {
                let _ = unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                return if is_cmp { (TypeId { v: bool_v }) } else { (TypeId { v: err_v }) };
            }
            if !is_cmp && ctx_ty.v != 0u32 && can_widen_int_to(mut_view(*cx), (TypeId { v: j.v }), (TypeId { v: ctx_ty.v })) {
                j.v = ctx_ty.v;
            }
            opnd_int.v = j.v;
        }
        return if is_cmp { (TypeId { v: bool_v }) } else { (TypeId { v: opnd_int.v }) };
    }

    if is_intlike(mut_view(*cx), (TypeId { v: left_ty.v })) && !is_never(mut_view(*cx), (TypeId { v: right_ty.v })) {
        let _ = unsafe { coerce(mut_view(*cx), (TypeId { v: right_ty.v }), (TypeId { v: left_ty.v }), view((*rptr).span)) };
    }
    let opnd = TypeId { v: if is_never(mut_view(*cx), (TypeId { v: left_ty.v })) { right_ty.v } else { left_ty.v } };
    if is_error(mut_view(*cx), (TypeId { v: opnd.v })) || is_never(mut_view(*cx), (TypeId { v: opnd.v })) {
        return if is_cmp { (TypeId { v: bool_v }) } else { (TypeId { v: opnd.v }) };
    }

    let k = kind_of(mut_view(*cx), (TypeId { v: opnd.v }));
    let mut ok = false;
    if is_cmp {
        ok = is_intlike(mut_view(*cx), (TypeId { v: opnd.v })) || k == TY_BOOL || k == TY_CHAR || k == TY_PTR ||
             k == TY_F32 || k == TY_F64 || k == TY_FLOAT_VAR;
    } else if op == BINOP_BITAND || op == BINOP_BITOR || op == BINOP_BITXOR {
        ok = is_intlike(mut_view(*cx), (TypeId { v: opnd.v })) || k == TY_BOOL;
    } else {
        ok = is_intlike(mut_view(*cx), (TypeId { v: opnd.v }));
    }

    if !ok {
        let m_idx = binop_method_idx(op);
        if m_idx > 0 && (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
            let m_sv = unsafe { tc_alloc_sv(mut_view((*cx.thir).interner.arena), m_idx) };
            let mut trait_res: u8 = TRAIT_DISPROVEN;
            let method_item = unsafe {
                find_method_in_scope(view(*cx.hir), view(*cx.thir), (TypeId { v: left_ty.v }), view(m_sv), cx.current_fn, cx.current_impl, view(*cx.str_in), view(*cx.db), mut_view(trait_res))
            };
            if (method_item as usize) != 0 {
                unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, method_item); }
                let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), method_item) };
                if fn_ty_id.v != 0u32 {
                    let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
                    if (fn_ty as usize) != 0 {
                        let ret_v = unsafe { (*fn_ty).ret_type.v };
                        return if is_cmp { (TypeId { v: bool_v }) } else { (TypeId { v: ret_v }) };
                    }
                }
            }
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }

    if is_cmp { return (TypeId { v: bool_v }); }
    opnd
}

fn check_unary(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    let operand: *mut HirExpr = unsafe { (*expr).inner };
    let op = unsafe { (*expr).op };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };

    if op == UNOP_NOT {
        check_expr(mut_view(*cx), operand, (TypeId { v: bool_v }));
        return (TypeId { v: bool_v });
    }
    if op == UNOP_NEG {
        if (operand as usize) != 0 && unsafe { (*operand).kind } == HIR_EXPR_LITERAL && unsafe { (*operand).literal.kind } == TOK_INT {
            let before = cx.lits_len;
            let ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
            if cx.lits_len == before + 1 {
                let lc = unsafe { litcheck_at(cx.lits, before) };
                unsafe {
                    (*lc).negated = true;
                    (*lc).unary = expr as *mut HirExpr;
                    (*lc).neg_span.file.v = (*expr).span.file.v;
                    (*lc).neg_span.start = (*expr).span.start;
                    (*lc).neg_span.end = (*expr).span.end;
                }
            }
            return (TypeId { v: ty.v });
        }
        let ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
        let r = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        let k = kind_of(mut_view(*cx), (TypeId { v: r.v }));
        if k == TY_ERROR || k == TY_NEVER { return (TypeId { v: r.v }); }
        if k == TY_F32 || k == TY_F64 || k == TY_FLOAT_VAR { return (TypeId { v: r.v }); }
        if k == TY_INT_VAR {
            unsafe { push_neg_check(mut_view(*cx), view((*expr).span), (TypeId { v: r.v })); }
            return (TypeId { v: r.v });
        }
        let is_sig = unsafe { type_is_signed((TypeId { v: r.v }), view((*cx.thir).interner)) };
        if is_sig { return (TypeId { v: r.v }); }
        let is_uns = unsafe { type_is_unsigned((TypeId { v: r.v }), view((*cx.thir).interner)) };
        if is_uns {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_NEG_UNSIGNED) };
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }
    if op == UNOP_BITNOT {
        let ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
        if is_error(mut_view(*cx), (TypeId { v: ty.v })) || is_never(mut_view(*cx), (TypeId { v: ty.v })) || is_intlike(mut_view(*cx), (TypeId { v: ty.v })) {
            return resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) };
    }
    if op == UNOP_DEREF {
        let op_ty = check_expr(mut_view(*cx), operand, (TypeId { v: 0u32 }));
        if !is_error(mut_view(*cx), (TypeId { v: op_ty.v })) {
            let r_op = resolve_ty(mut_view(*cx), (TypeId { v: op_ty.v }));
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_op.v })) };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW {
                    let pt_v = unsafe { (*t).pointee.v };
                    return (TypeId { v: pt_v });
                }
            }
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP) };
    }
    unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_OPERATOR) }
}

fn count_expr_list(head: *const HirExpr) -> usize {
    let mut c: usize = 0;
    let mut cur = head;
    while ((cur as usize) != 0) {
        c = c + 1;
        cur = unsafe { (*cur).next };
    }
    c
}

// T501 (SPEC-55 AXS-ADR-010): `static_addr(s)` operand is a path to a `static` item or to a block-scope `@addr(E)` binding.
fn tc_expr_is_static_place(cx: view<TypeckCtx>, e: *const HirExpr) -> bool {
    if (e as usize) == 0 || unsafe { (*e).kind } != HIR_EXPR_PATH { return false; }
    let sym_v = unsafe { (*e).path.symbol.v };
    if sym_v == 0u32 { return false; }
    let mut i: usize = cx.vars_len;
    while (i > 0) {
        i = i - 1;
        let vs = unsafe { varstate_at(cx.vars, i) };
        if unsafe { (*vs).sym.v } == sym_v {
            return unsafe { (*vs).is_placed };
        }
    }
    if (cx.hir as usize) == 0 { return false; }
    let it = unsafe_find_item_by_sym(cx.hir, cx.thir as *const Thir, SymbolId { v: sym_v });
    if (it as usize) == 0 { return false; }
    unsafe { (*it).kind } == HIR_ITEM_STATIC
}

// T501 (SPEC-55 AXS-ADR-010): structural place test for `addr_of(x)` (temporaries such as `addr_of(1 + 2)` are not places).
fn tc_expr_is_place(e: *const HirExpr) -> bool {
    if (e as usize) == 0 { return false; }
    let k = unsafe { (*e).kind };
    if k == HIR_EXPR_PATH { return true; }
    if k == HIR_EXPR_FIELD || k == HIR_EXPR_TUPLE_INDEX || k == HIR_EXPR_INDEX {
        return tc_expr_is_place(unsafe { (*e).base as *const HirExpr });
    }
    if k == HIR_EXPR_UNARY && unsafe { (*e).op } == UNOP_DEREF { return true; }
    false
}

fn check_call(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    let callee: *mut HirExpr = unsafe { (*expr).callee };
    let args_head: *mut HirExpr = unsafe { (*expr).args };
    let mut callee_ty = (TypeId { v: 0u32 });
    if (callee as usize) != 0 && unsafe { (*callee).kind } == HIR_EXPR_PATH {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let raw_cty = unsafe { lookup_path_type(mut_view(*cx), view((*callee).path), mut_view(gargs)) };
        let r_cty = resolve_ty(mut_view(*cx), (TypeId { v: raw_cty.v }));
        callee_ty.v = r_cty.v;
        unsafe { thir_set_expr_type(mut_view(*cx.thir), callee, (TypeId { v: callee_ty.v })); }
        register_intrinsic_callee(mut_view(*cx), callee);
        if gargs.count > 0 {
            unsafe {
                ptr_substmap_insert(mut_view((*cx.thir).expr_substs), callee as usize, gargs.args, gargs.count);
                ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (callee as usize) | 1usize, cx.current_fn);
                ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (callee as usize) | 3usize, cx.current_impl);
            }
        }
    } else {
        let raw_cty = check_expr(mut_view(*cx), callee, (TypeId { v: 0u32 }));
        let r_cty = resolve_ty(mut_view(*cx), (TypeId { v: raw_cty.v }));
        callee_ty.v = r_cty.v;
    }

    let ct = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: callee_ty.v })) };
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    let str_v = unsafe { (*cx.thir).interner.t_str.v };
    if (ct as usize) == 0 { return (TypeId { v: err_v }); }
    let ck = unsafe { (*ct).kind };
    let argc = count_expr_list(args_head);

    if ck == TY_BUILTIN_LEN {
        if argc != 1 {
            return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) };
        }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if !is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) {
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty.v })) };
            let tk = if (t as usize) != 0 { unsafe { (*t).kind } } else { TY_ERROR };
            let mut is_slice_view = false;
            if tk == TY_VIEW || tk == TY_MUT_VIEW {
                let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: (*t).pointee.v })) };
                if (pt as usize) != 0 && unsafe { (*pt).kind } == TY_SLICE {
                    is_slice_view = true;
                }
            }
            if tk != TY_ARRAY && tk != TY_STR && !is_slice_view {
                return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
            }
        }
        return (TypeId { v: usize_v });
    }
    if ck == TY_BUILTIN_PRINT {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if !is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) && arg_ty.v != str_v {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
        }
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_PRINT_INT {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if !is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) {
            let is_i = unsafe { type_is_int((TypeId { v: arg_ty.v }), view((*cx.thir).interner)) };
            if !is_i {
                return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
            }
        }
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_DROP {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_ADDRESS_OF || ck == TY_BUILTIN_ADDRESS_OF_MUT {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) { return (TypeId { v: err_v }); }
        if ck == TY_BUILTIN_ADDRESS_OF_MUT {
            tc_check_addr_of_mut_immut_static(mut_view(*cx), args_head);
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: arg_ty.v }));
        }
        return unsafe { intern_ptr_ty(mut_view((*cx.thir).interner), (TypeId { v: arg_ty.v }), ck == TY_BUILTIN_ADDRESS_OF_MUT) };
    }
    if ck == TY_BUILTIN_FN_ADDR || ck == TY_BUILTIN_STATIC_ADDR || ck == TY_BUILTIN_ADDR_OF {
        // T501 (REQ-OWNER-008, SPEC-55 AXS-ADR-010): address introspection. All three are safe and return the `usize` address.
        if argc == 0 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) { return (TypeId { v: err_v }); }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: arg_ty.v }));
        }
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty.v })) };
        let atk = if (at as usize) != 0 { unsafe { (*at).kind } } else { TY_ERROR };
        if ck == TY_BUILTIN_FN_ADDR {
            // Any `fn` item or `fn(...) -> R` value; closures are rejected (a capturing closure has no code address).
            if atk != TY_FN {
                return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
            }
        } else if ck == TY_BUILTIN_STATIC_ADDR {
            if !tc_expr_is_static_place(view(*cx), args_head) {
                return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
            }
        } else if atk != TY_FN && !tc_expr_is_place(args_head) {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_NOT_A_PLACE) };
        }
        return (TypeId { v: usize_v });
    }
    if ck == TY_BUILTIN_IS_NULL {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) { return (TypeId { v: err_v }); }
        let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty.v })) };
        if (at as usize) == 0 || unsafe { (*at).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*at).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: bool_v });
    }
    if ck == TY_BUILTIN_PTR_ADD || ck == TY_BUILTIN_PTR_SUB {
        if argc != 2 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let a1: *mut HirExpr = unsafe { (*args_head).next };
        let raw_a0 = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg0_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_a0.v }));
        let raw_a1 = check_expr(mut_view(*cx), a1, (TypeId { v: usize_v }));
        let arg1_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_a1.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg0_ty.v })) || is_error(mut_view(*cx), (TypeId { v: arg1_ty.v })) { return (TypeId { v: err_v }); }
        let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg0_ty.v })) };
        if (at as usize) == 0 || unsafe { (*at).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*at).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: arg0_ty.v });
    }
    if ck == TY_BUILTIN_SIZE_OF || ck == TY_BUILTIN_ALIGN_OF {
        if argc != 0 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        return (TypeId { v: usize_v });
    }
    if ck == TY_BUILTIN_NEEDS_DROP {
        if argc != 0 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        return (TypeId { v: bool_v });
    }
    if ck == TY_BUILTIN_NULL || ck == TY_BUILTIN_NULL_MUT {
        if argc != 0 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        let mut pointee = (TypeId { v: u8_v });
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let r_s0 = resolve_ty(mut_view(*cx), (TypeId { v: s0_v }));
            pointee.v = r_s0.v;
        }
        return unsafe { intern_ptr_ty(mut_view((*cx.thir).interner), (TypeId { v: pointee.v }), ck == TY_BUILTIN_NULL_MUT) };
    }
    if ck == TY_BUILTIN_DROP_IN_PLACE {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        if is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) { return (TypeId { v: err_v }); }
        let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty.v })) };
        if (at as usize) == 0 || unsafe { (*at).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*args_head).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*at).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: unit_v });
    }
    check_call_rest(mut_view(*cx), expr, callee, args_head, ct, ck, argc)
}

fn check_call_rest(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    callee: *mut HirExpr,
    args_head: *mut HirExpr,
    ct: *mut AxType,
    ck: u8,
    argc: usize
) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    if ck == TY_BUILTIN_FORGET {
        if argc != 1 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let raw_at = check_expr(mut_view(*cx), args_head, (TypeId { v: 0u32 }));
        let arg_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_at.v }));
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: arg_ty.v }));
        }
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_PTR_COPY || ck == TY_BUILTIN_PTR_COPY_NONOVERLAPPING {
        if argc != 3 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let a0 = args_head;
        let a1: *mut HirExpr = unsafe { (*a0).next };
        let a2: *mut HirExpr = unsafe { (*a1).next };
        let raw_t0 = check_expr(mut_view(*cx), a0, (TypeId { v: 0u32 }));
        let ty0 = resolve_ty(mut_view(*cx), (TypeId { v: raw_t0.v }));
        let raw_t1 = check_expr(mut_view(*cx), a1, (TypeId { v: 0u32 }));
        let ty1 = resolve_ty(mut_view(*cx), (TypeId { v: raw_t1.v }));
        check_expr(mut_view(*cx), a2, (TypeId { v: usize_v }));
        if is_error(mut_view(*cx), (TypeId { v: ty0.v })) || is_error(mut_view(*cx), (TypeId { v: ty1.v })) { return (TypeId { v: err_v }); }
        let t0 = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty0.v })) };
        let t1 = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty1.v })) };
        if (t0 as usize) == 0 || unsafe { (*t0).kind } != TY_PTR || (t1 as usize) == 0 || unsafe { (*t1).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*t0).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: unit_v });
    }
    if ck == TY_BUILTIN_PTR_WRITE_BYTES {
        if argc != 3 { return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) }; }
        let a0 = args_head;
        let a1: *mut HirExpr = unsafe { (*a0).next };
        let a2: *mut HirExpr = unsafe { (*a1).next };
        let raw_t0 = check_expr(mut_view(*cx), a0, (TypeId { v: 0u32 }));
        let ty0 = resolve_ty(mut_view(*cx), (TypeId { v: raw_t0.v }));
        check_expr(mut_view(*cx), a1, (TypeId { v: u8_v }));
        check_expr(mut_view(*cx), a2, (TypeId { v: usize_v }));
        if is_error(mut_view(*cx), (TypeId { v: ty0.v })) { return (TypeId { v: err_v }); }
        let t0 = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ty0.v })) };
        if (t0 as usize) == 0 || unsafe { (*t0).kind } != TY_PTR {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
        }
        let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
        if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
            let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
            let pt_v = unsafe { (*t0).pointee.v };
            unify_ty(mut_view(*cx), (TypeId { v: s0_v }), (TypeId { v: pt_v }));
        }
        return (TypeId { v: unit_v });
    }

    if ck == TY_CLOSURE {
        let pcount = unsafe { (*ct).param_count };
        if argc != pcount {
            let mut a = args_head;
            while ((a as usize) != 0) {
                check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
                a = unsafe { (*a).next };
            }
            return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) };
        }
        let ret_v = unsafe { (*ct).ret_type.v };
        let params = unsafe { (*ct).param_types };
        let mut i: usize = 0;
        let mut a = args_head;
        while ((a as usize) != 0) {
            let pv = unsafe { (*typeid_at(params, i)).v };
            check_expr(mut_view(*cx), a, (TypeId { v: pv }));
            i = i + 1;
            a = unsafe { (*a).next };
        }
        return if ret_v == 0u32 { (TypeId { v: unit_v }) } else { (TypeId { v: ret_v }) };
    }

    if ck == TY_PARAM {
        let p_idx = unsafe { (*ct).param_index as usize };
        let p_name_v = unsafe { (*ct).name.v };
        let impl_n_call = if (cx.current_impl as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
            tc_item_generic_count(cx.current_impl)
        } else {
            0
        };
        let mut cb: *const HirType = 0 as *const HirType;
        if (cx.current_fn as usize) != 0 && p_idx >= impl_n_call {
            cb = tc_find_callable_bound_in_item(view(*cx), cx.current_fn, p_idx - impl_n_call, p_name_v);
        }
        if (cb as usize) == 0 && (cx.current_impl as usize) != 0 && p_idx < impl_n_call {
            if (cx.current_fn as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
                cb = tc_find_callable_bound_in_where(view(*cx), cx.current_fn, 0u32, p_name_v);
            }
            if (cb as usize) == 0 {
                cb = tc_find_callable_bound_in_item(view(*cx), cx.current_impl, p_idx, p_name_v);
            }
        }
        if (cb as usize) != 0 {
            let hga: *mut HirGenericArgs = unsafe { (*cb).path.generic_args };
            if (hga as usize) != 0 && ((unsafe { (*hga).args }) as usize) != 0 {
                let mut gcnt: usize = 0;
                let mut ga: *mut HirGenericArg = unsafe { (*hga).args };
                while ((ga as usize) != 0) {
                    gcnt = gcnt + 1;
                    ga = unsafe { (*ga).next };
                }
                if gcnt > 0 {
                    let exp_argc = gcnt - 1;
                    if argc != exp_argc {
                        let mut a = args_head;
                        while ((a as usize) != 0) {
                            check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
                            a = unsafe { (*a).next };
                        }
                        return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) };
                    }
                    let mut a = args_head;
                    ga = unsafe { (*hga).args };
                    let mut j: usize = 0;
                    while j < exp_argc && ((a as usize) != 0) && ((ga as usize) != 0) {
                        let gty: *mut HirType = unsafe { (*ga).ty };
                        let pty = if (gty as usize) != 0 { tc_bound_arg_typeid(mut_view(*cx), gty) } else { TypeId { v: 0u32 } };
                        check_expr(mut_view(*cx), a, pty);
                        j = j + 1;
                        a = unsafe { (*a).next };
                        ga = unsafe { (*ga).next };
                    }
                    if (ga as usize) != 0 {
                        let r_ht: *mut HirType = unsafe { (*ga).ty };
                        if (r_ht as usize) != 0 {
                            let r_tid = tc_bound_arg_typeid(mut_view(*cx), r_ht);
                            return resolve_ty(mut_view(*cx), r_tid);
                        }
                    }
                    return (TypeId { v: unit_v });
                }
            }
            let mut a = args_head;
            while ((a as usize) != 0) {
                check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
                a = unsafe { (*a).next };
            }
            let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
            return if cx.return_type.v != 0u32 { (TypeId { v: cx.return_type.v }) } else { (TypeId { v: i32_v }) };
        }
        let mut a = args_head;
        while ((a as usize) != 0) {
            check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
            a = unsafe { (*a).next };
        }
        return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_NOT_CALLABLE) };
    }

    if ck != TY_FN {
        let mut a = args_head;
        while ((a as usize) != 0) {
            check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
            a = unsafe { (*a).next };
        }
        if ck == TY_ERROR { return (TypeId { v: err_v }); }
        return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_NOT_CALLABLE) };
    }

    let pcount = unsafe { (*ct).param_count };
    if argc != pcount {
        let mut a = args_head;
        while ((a as usize) != 0) {
            check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
            a = unsafe { (*a).next };
        }
        return unsafe { type_error(mut_view(*cx), view((*callee).span), AX_TYPE_ARG_COUNT) };
    }

    let fn_def_item: *const HirItem = unsafe { (*ct).def };
    let call_substs = if (fn_def_item as usize) != 0 && (callee as usize) != 0 {
        unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) }
    } else {
        0 as *mut GenericArgsSlice
    };
    let ret_v = unsafe { (*ct).ret_type.v };
    let params = unsafe { (*ct).param_types };
    let mut i: usize = 0;
    let mut a = args_head;
    while ((a as usize) != 0) {
        let pv = unsafe { (*typeid_at(params, i)).v };
        if (unsafe { (*a).kind }) == HIR_EXPR_CLOSURE && (call_substs as usize) != 0 {
            let hint_ty = tc_build_callable_hint_ty(mut_view(*cx), fn_def_item, call_substs, 0u32, (TypeId { v: pv }));
            if hint_ty.v != 0u32 {
                let clos_ty = check_expr_closure(mut_view(*cx), a, (TypeId { v: hint_ty.v }));
                unsafe { thir_set_expr_type(mut_view(*cx.thir), a, (TypeId { v: clos_ty.v })); }
                if !is_error(mut_view(*cx), (TypeId { v: clos_ty.v })) {
                    let _ = unify_ty(mut_view(*cx), (TypeId { v: pv }), (TypeId { v: clos_ty.v }));
                }
            } else {
                check_expr(mut_view(*cx), a, (TypeId { v: pv }));
            }
        } else {
            check_expr(mut_view(*cx), a, (TypeId { v: pv }));
        }
        i = i + 1;
        a = unsafe { (*a).next };
    }
    if (call_substs as usize) != 0 && (unsafe { (*call_substs).count }) > 0 {
        let sp_f = unsafe { (*expr).span.file.v };
        let sp_s = unsafe { (*expr).span.start };
        let sp_e = unsafe { (*expr).span.end };
        check_future_bound_outputs_for_call(
            mut_view(*cx),
            fn_def_item,
            call_substs,
            0u32,
            Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e }
        );
        check_callable_bound_outputs_for_call(
            mut_view(*cx),
            fn_def_item,
            call_substs,
            0u32,
            Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e }
        );
        tc_check_generic_trait_bounds_for_call(
            mut_view(*cx),
            fn_def_item,
            call_substs,
            0u32,
            Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e }
        );
    }
    if !cx.in_closure && (cx.current_fn as usize) != 0 && (unsafe { (*cx.current_fn).is_async }) &&
       (cx.str_in as usize) != 0 && (cx.sink as usize) != 0 && (fn_def_item as usize) != 0 {
        if unsafe { tc_item_has_blocking_attr(fn_def_item, view(*cx.str_in)) } {
            unsafe {
                report_typeck_diag(
                    mut_view(*cx.sink),
                    AX_ASYNC_BLOCKING_IN_ASYNC,
                    (*expr).span.file.v,
                    (*expr).span.start,
                    (*expr).span.end
                );
            }
        }
    }
    if (callee as usize) != 0 && unsafe { (*callee).kind } == HIR_EXPR_PATH && (cx.str_in as usize) != 0 {
        let raw_cname = unsafe { tc_path_name_sv(view(*cx), view((*callee).path)) };
        let mut c_start: usize = 0;
        let mut c_end: usize = raw_cname.len;
        let mut k: usize = 0;
        while k < raw_cname.len {
            let ch = unsafe { *(raw_cname.ptr + k) };
            if ch == 60u8 {
                c_end = k;
                break;
            }
            if ch == 46u8 {
                c_start = k + 1;
            }
            k = k + 1;
        }
        let cname = StrView { ptr: unsafe { raw_cname.ptr + c_start }, len: c_end - c_start };
        let is_fence = tc_sv_is_5(view(cname), 102u8, 101u8, 110u8, 99u8, 101u8); // fence
        let is_cfence = cname.len == 14 &&
            unsafe { *(cname.ptr + 0) == 99u8 && *(cname.ptr + 8) == 95u8 && *(cname.ptr + 9) == 102u8 && *(cname.ptr + 13) == 101u8 }; // compiler_fence
        if (is_fence || is_cfence) && argc == 1 && (args_head as usize) != 0 {
            let mut ord_val: u64 = 0u64;
            if tc_eval_ordering_arg(mut_view(*cx), args_head, mut_view(ord_val)) {
                unsafe { tc_validate_ordering_op(mut_view(*cx), view((*args_head).span), 4u8, ord_val, 0u64); }
            }
        }
        let is_lock_free_fn = cname.len == 12 &&
            unsafe { *(cname.ptr + 0) == 105u8 && *(cname.ptr + 1) == 115u8 && *(cname.ptr + 2) == 95u8 && *(cname.ptr + 3) == 108u8 && *(cname.ptr + 8) == 102u8 }; // is_lock_free
        if is_lock_free_fn && argc == 0 {
            let substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), callee as usize) };
            if (substs as usize) != 0 && unsafe { (*substs).count } > 0 {
                let s0_v = unsafe { (*typeid_at((*substs).args, 0)).v };
                let r_s0 = resolve_ty(mut_view(*cx), (TypeId { v: s0_v }));
                if !unsafe { tc_is_valid_atomic_payload(view((*cx.thir).interner), (TypeId { v: r_s0.v })) } {
                    unsafe { type_error(mut_view(*cx), view((*callee).span), AX_CONC_INVALID_ATOMIC_TYPE); }
                }
            }
        }
    }
    if ret_v == 0u32 { (TypeId { v: unit_v }) } else { resolve_ty(mut_view(*cx), (TypeId { v: ret_v })) }
}

fn check_if(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let lpat: *mut HirPat = unsafe { (*expr).let_pat };
    if (lpat as usize) != 0 {
        desugar_if_let(mut_view(*cx), expr as *mut HirExpr);
        return check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let cond_e: *mut HirExpr = unsafe { (*expr).cond };
    check_expr(mut_view(*cx), cond_e, (TypeId { v: bool_v }));

    let tblk: *mut HirBlock = unsafe { (*expr).block };
    let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
    if (else_e as usize) == 0 {
        check_block(mut_view(*cx), tblk, (TypeId { v: unit_v }));
        return (TypeId { v: unit_v });
    }
    let then_ty = check_block(mut_view(*cx), tblk, (TypeId { v: expected.v }));
    let exp_else = if expected.v != 0u32 { (TypeId { v: expected.v }) } else { (TypeId { v: then_ty.v }) };
    let else_ty = check_expr(mut_view(*cx), else_e, (TypeId { v: exp_else.v }));
    if is_never(mut_view(*cx), (TypeId { v: then_ty.v })) { return (TypeId { v: else_ty.v }); }
    if is_error(mut_view(*cx), (TypeId { v: else_ty.v })) { return (TypeId { v: else_ty.v }); }
    resolve_ty(mut_view(*cx), (TypeId { v: then_ty.v }))
}

fn record_cap(caps: *mut RawCapture, cap_count: mut_view<usize>, sym: SymbolId, name: StrId, is_mut: bool, is_move: bool) {
    let mut i: usize = 0;
    while (i < *cap_count) {
        let rc = unsafe { rawcap_at(caps, i) };
        if unsafe { (*rc).sym.v } == sym.v {
            unsafe {
                if (*rc).name.v == 0u32 && name.v != 0u32 {
                    (*rc).name.v = name.v;
                }
                if is_move { (*rc).is_moved = true; }
                else if is_mut { (*rc).is_mutated = true; }
                else { (*rc).is_read = true; }
            }
            return;
        }
        i = i + 1;
    }
    if *cap_count < 64 {
        let rc = unsafe { rawcap_at(caps, *cap_count) };
        unsafe {
            (*rc).sym.v = sym.v;
            (*rc).name.v = name.v;
            (*rc).is_mutated = is_mut;
            (*rc).is_moved = is_move;
            (*rc).is_read = !is_mut && !is_move;
        }
        *cap_count = *cap_count + 1;
    }
}

fn is_inner_sym(sym: SymbolId, inner: *const SymbolId, inner_count: usize) -> bool {
    let mut i: usize = 0;
    while (i < inner_count) {
        let s = unsafe { symid_at(inner as *mut SymbolId, i) };
        if unsafe { (*s).v } == sym.v { return true; }
        i = i + 1;
    }
    false
}

fn is_outer_var(cx: view<TypeckCtx>, sym: SymbolId) -> bool {
    let mut i: usize = 0;
    while (i < cx.vars_len) {
        let vs = unsafe { varstate_at(cx.vars, i) };
        if unsafe { (*vs).sym.v } == sym.v { return true; }
        i = i + 1;
    }
    false
}

fn add_pat_syms(pat: *const HirPat, inner: *mut SymbolId, inner_count: mut_view<usize>) {
    if (pat as usize) == 0 { return; }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_BINDING {
        if *inner_count < 128 {
            let dst = unsafe { symid_at(inner, *inner_count) };
            unsafe { (*dst).v = (*pat).symbol.v; }
            *inner_count = *inner_count + 1;
        }
    } else if pk == HIR_PAT_TUPLE {
        let mut p: *mut HirPat = unsafe { (*pat).elems };
        while ((p as usize) != 0) {
            add_pat_syms(p, inner, mut_view(*inner_count));
            p = unsafe { (*p).next };
        }
    } else if pk == HIR_PAT_STRUCT {
        let mut f: *mut HirPatField = unsafe { (*pat).fields };
        while ((f as usize) != 0) {
            let fpat: *mut HirPat = unsafe { (*f).pat };
            add_pat_syms(fpat, inner, mut_view(*inner_count));
            f = unsafe { (*f).next };
        }
    } else if pk == HIR_PAT_PATH {
        let mut p: *mut HirPat = unsafe { (*pat).payload };
        while ((p as usize) != 0) {
            add_pat_syms(p, inner, mut_view(*inner_count));
            p = unsafe { (*p).next };
        }
    } else if pk == HIR_PAT_OR {
        let mut p: *mut HirPat = unsafe { (*pat).pats };
        while ((p as usize) != 0) {
            add_pat_syms(p, inner, mut_view(*inner_count));
            p = unsafe { (*p).next };
        }
    }
}

fn scan_block_captures(
    cx: mut_view<TypeckCtx>,
    block: *const HirBlock,
    inner: *mut SymbolId,
    inner_count: mut_view<usize>,
    caps: *mut RawCapture,
    cap_count: mut_view<usize>
) {
    if (block as usize) == 0 { return; }
    let save_inner = *inner_count;
    let mut s: *mut HirStmt = unsafe { (*block).stmts };
    while ((s as usize) != 0) {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let lexpr: *mut HirExpr = unsafe { (*s).expr };
            let lelse: *mut HirBlock = unsafe { (*s).else_block };
            let lpat: *mut HirPat = unsafe { (*s).pat };
            if (lexpr as usize) != 0 {
                scan_expr_captures(mut_view(*cx), lexpr, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            }
            if (lelse as usize) != 0 {
                scan_block_captures(mut_view(*cx), lelse, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
            }
            add_pat_syms(lpat, inner, mut_view(*inner_count));
        } else if sk == HIR_STMT_ASSIGN {
            let lft: *mut HirExpr = unsafe { (*s).left };
            let rgt: *mut HirExpr = unsafe { (*s).right };
            scan_expr_captures(mut_view(*cx), lft, inner, mut_view(*inner_count), caps, mut_view(*cap_count), true, false);
            scan_expr_captures(mut_view(*cx), rgt, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        } else if sk == HIR_STMT_EXPR {
            let se: *mut HirExpr = unsafe { (*s).expr };
            scan_expr_captures(mut_view(*cx), se, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
        s = unsafe { (*s).next };
    }
    *inner_count = save_inner;
}

fn tc_is_builtin_drop_callee(
    cx: view<TypeckCtx>,
    callee: *const HirExpr,
    inner: *mut SymbolId,
    inner_count: usize
) -> bool {
    if (callee as usize) == 0 || (unsafe { (*callee).kind }) != HIR_EXPR_PATH {
        return false;
    }
    let name = unsafe { tc_path_name_sv(cx, view((*callee).path)) };
    if builtin_name_kind(view(name)) != TY_BUILTIN_DROP {
        return false;
    }
    let sym_v = unsafe { (*callee).path.symbol.v };
    if sym_v != 0u32 {
        if is_inner_sym((SymbolId { v: sym_v }), inner, inner_count) {
            return false;
        }
        if tc_sym_in_active_scope(cx, sym_v) {
            return false;
        }
        if (find_item_by_symbol(cx, (SymbolId { v: sym_v })) as usize) != 0 {
            return false;
        }
        if (cx.thir as usize) != 0 {
            let st = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: sym_v })) };
            if st.v != 0u32 {
                return false;
            }
        }
    }
    true
}

fn scan_expr_captures(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    inner: *mut SymbolId,
    inner_count: mut_view<usize>,
    caps: *mut RawCapture,
    cap_count: mut_view<usize>,
    in_mut: bool,
    in_move: bool
) {
    if (expr as usize) == 0 { return; }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        if sym_v != 0u32 {
            let sym = (SymbolId { v: sym_v });
            if !is_inner_sym((SymbolId { v: sym.v }), inner, *inner_count) && is_outer_var(view(*cx), (SymbolId { v: sym.v })) {
                let pname_v = unsafe { (*expr).path.name.v };
                record_cap(caps, mut_view(*cap_count), (SymbolId { v: sym.v }), (StrId { v: pname_v }), in_mut, in_move);
            }
        }
    } else if ek == HIR_EXPR_BINARY {
        let lft: *mut HirExpr = unsafe { (*expr).left };
        let rgt: *mut HirExpr = unsafe { (*expr).right };
        scan_expr_captures(mut_view(*cx), lft, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        scan_expr_captures(mut_view(*cx), rgt, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
    } else if ek == HIR_EXPR_UNARY || ek == HIR_EXPR_CAST {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        scan_expr_captures(mut_view(*cx), in_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
    } else if ek == HIR_EXPR_VIEW {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let is_m = unsafe { (*expr).is_mut };
        scan_expr_captures(mut_view(*cx), in_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), is_m, false);
    } else if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_COMPTIME {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        scan_block_captures(mut_view(*cx), blk, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
    } else if ek == HIR_EXPR_IF {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
        scan_expr_captures(mut_view(*cx), cond_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        scan_block_captures(mut_view(*cx), blk, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
        if (else_e as usize) != 0 {
            scan_expr_captures(mut_view(*cx), else_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
    } else if ek == HIR_EXPR_WHILE {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        scan_expr_captures(mut_view(*cx), cond_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        scan_block_captures(mut_view(*cx), blk, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
    } else if ek == HIR_EXPR_FOR {
        let iter_e: *mut HirExpr = unsafe { (*expr).iter };
        let pat_p: *mut HirPat = unsafe { (*expr).pat };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        scan_expr_captures(mut_view(*cx), iter_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        let save = *inner_count;
        add_pat_syms(pat_p, inner, mut_view(*inner_count));
        scan_block_captures(mut_view(*cx), blk, inner, mut_view(*inner_count), caps, mut_view(*cap_count));
        *inner_count = save;
    } else if ek == HIR_EXPR_RANGE {
        let se: *mut HirExpr = unsafe { (*expr).start_expr };
        let ee: *mut HirExpr = unsafe { (*expr).end_expr };
        if (se as usize) != 0 { scan_expr_captures(mut_view(*cx), se, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false); }
        if (ee as usize) != 0 { scan_expr_captures(mut_view(*cx), ee, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false); }
    } else if ek == HIR_EXPR_MATCH {
        let m_e: *mut HirExpr = unsafe { (*expr).cond };
        scan_expr_captures(mut_view(*cx), m_e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        let mut arm: *mut HirMatchArm = unsafe { (*expr).arms };
        while ((arm as usize) != 0) {
            let save = *inner_count;
            let apat: *mut HirPat = unsafe { (*arm).pat };
            let aguard: *mut HirExpr = unsafe { (*arm).guard };
            let abody: *mut HirExpr = unsafe { (*arm).body };
            add_pat_syms(apat, inner, mut_view(*inner_count));
            if (aguard as usize) != 0 {
                scan_expr_captures(mut_view(*cx), aguard, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            }
            scan_expr_captures(mut_view(*cx), abody, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            *inner_count = save;
            arm = unsafe { (*arm).next };
        }
    } else if ek == HIR_EXPR_CALL {
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        // T423c: check for prelude `drop` without calling `lookup_path_type`, which would
        // instantiate generic callees with fresh `TY_VAR`s that are discarded and later fail
        // `default_int_vars` with `AX_TYPE_UNKNOWN`.
        let is_drop = tc_is_builtin_drop_callee(view(*cx), callee as *const HirExpr, inner, *inner_count);
        scan_expr_captures(mut_view(*cx), callee, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while ((a as usize) != 0) {
            let mut arg_move = is_drop;
            if !arg_move && unsafe { (*a).kind } == HIR_EXPR_PATH && unsafe { (*a).path.symbol.v } != 0u32 {
                let vty = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: (*a).path.symbol.v })) };
                if vty.v != 0u32 && (cx.str_in as usize) != 0 {
                    let is_c = unsafe { type_is_copy((TypeId { v: vty.v }), view(*cx.thir), view(*cx.str_in)) };
                    if !is_c { arg_move = true; }
                }
            }
            scan_expr_captures(mut_view(*cx), a, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, arg_move);
            a = unsafe { (*a).next };
        }
    } else if ek == HIR_EXPR_METHOD_CALL {
        let recv: *mut HirExpr = unsafe { (*expr).receiver };
        scan_expr_captures(mut_view(*cx), recv, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while ((a as usize) != 0) {
            scan_expr_captures(mut_view(*cx), a, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            a = unsafe { (*a).next };
        }
    } else if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        let b: *mut HirExpr = unsafe { (*expr).base };
        scan_expr_captures(mut_view(*cx), b, inner, mut_view(*inner_count), caps, mut_view(*cap_count), in_mut, in_move);
    } else if ek == HIR_EXPR_INDEX {
        let b: *mut HirExpr = unsafe { (*expr).base };
        let ia: *mut HirExpr = unsafe { (*expr).index_arg };
        scan_expr_captures(mut_view(*cx), b, inner, mut_view(*inner_count), caps, mut_view(*cap_count), in_mut, false);
        scan_expr_captures(mut_view(*cx), ia, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
    } else if ek == HIR_EXPR_TUPLE {
        let mut e: *mut HirExpr = unsafe { (*expr).elems };
        while ((e as usize) != 0) {
            scan_expr_captures(mut_view(*cx), e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            e = unsafe { (*e).next };
        }
    } else if ek == HIR_EXPR_ARRAY {
        let mut e: *mut HirExpr = unsafe { (*expr).elems };
        while ((e as usize) != 0) {
            scan_expr_captures(mut_view(*cx), e, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            e = unsafe { (*e).next };
        }
        let ce: *mut HirExpr = unsafe { (*expr).count_expr };
        if (ce as usize) != 0 {
            scan_expr_captures(mut_view(*cx), ce, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
    } else if ek == HIR_EXPR_STRUCT {
        let mut f: *mut HirFieldInit = unsafe { (*expr).fields };
        while ((f as usize) != 0) {
            let fe: *mut HirExpr = unsafe { (*f).expr };
            scan_expr_captures(mut_view(*cx), fe, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
            f = unsafe { (*f).next };
        }
    } else if ek == HIR_EXPR_JUMP {
        let je: *mut HirExpr = unsafe { (*expr).inner };
        if (je as usize) != 0 {
            scan_expr_captures(mut_view(*cx), je, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
    } else if ek == HIR_EXPR_TRY || ek == HIR_EXPR_AWAIT {
        let ie: *mut HirExpr = unsafe { (*expr).inner };
        if (ie as usize) != 0 {
            scan_expr_captures(mut_view(*cx), ie, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
    } else if ek == HIR_EXPR_CLOSURE {
        let save = *inner_count;
        let mut cp: *mut HirParam = unsafe { (*expr).params };
        while ((cp as usize) != 0) {
            if *inner_count < 128 {
                let dst = unsafe { symid_at(inner, *inner_count) };
                unsafe { (*dst).v = (*cp).symbol.v; }
                *inner_count = *inner_count + 1;
            }
            cp = unsafe { (*cp).next };
        }
        let cb: *mut HirExpr = unsafe { (*expr).body };
        if (cb as usize) != 0 {
            scan_expr_captures(mut_view(*cx), cb, inner, mut_view(*inner_count), caps, mut_view(*cap_count), false, false);
        }
        *inner_count = save;
    }
}

fn check_field_vis(cx: mut_view<TypeckCtx>, f: *const HirFieldDecl, sdef: *const HirItem, err_sp: view<Span>) -> bool {
    let vk = unsafe { (*f).vis.kind };
    if (cx.current_fn as usize) == 0 || (sdef as usize) == 0 { return true; }
    if vk == HIR_VIS_PRIVATE || vk == HIR_VIS_PUB_MODULE {
        let eq = unsafe { dotted_name_eq(view((*cx.current_fn).module_path), view((*sdef).module_path)) };
        if !eq {
            type_error(mut_view(*cx), err_sp, AX_NAME_PRIVATE);
            return false;
        }
    } else if vk == HIR_VIS_PUB_PACKAGE {
        let c1 = unsafe { (*cx.current_fn).module_path.count };
        let c2 = unsafe { (*sdef).module_path.count };
        let mut diff = false;
        if c1 == 0 || c2 == 0 {
            diff = c1 != c2;
        } else {
            let s1 = unsafe { (*strid_at_const((*cx.current_fn).module_path.segments as *const StrId, 0)).v };
            let s2 = unsafe { (*strid_at_const((*sdef).module_path.segments as *const StrId, 0)).v };
            if s1 != s2 { diff = true; }
        }
        if diff {
            type_error(mut_view(*cx), err_sp, AX_NAME_PRIVATE);
            return false;
        }
    }
    true
}

pub fn check_expr_kind(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let isize_v = unsafe { (*cx.thir).interner.t_isize.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    let u32_v = unsafe { (*cx.thir).interner.t_u32.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    let char_v = unsafe { (*cx.thir).interner.t_char.v };
    let str_v = unsafe { (*cx.thir).interner.t_str.v };

    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_ERROR { return (TypeId { v: err_v }); }
    if ek == HIR_EXPR_LITERAL { return check_literal(mut_view(*cx), expr); }

    if ek == HIR_EXPR_TUPLE {
        let elems_head: *mut HirExpr = unsafe { (*expr).elems };
        let count = count_expr_list(elems_head);
        if count == 0 { return (TypeId { v: unit_v }); }
        let bytes = mul_usize(count, size_of<TypeId>());
        let fields = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
        let mut exp_t: *mut AxType = 0 as *mut AxType;
        if expected.v != 0u32 {
            let r_exp = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
            let et = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_exp.v })) };
            if (et as usize) != 0 && unsafe { (*et).kind } == TY_TUPLE && unsafe { (*et).field_count } == count {
                exp_t = et;
            }
        }
        let mut i: usize = 0;
        let mut e = elems_head;
        while ((e as usize) != 0) {
            let mut exp_elem = (TypeId { v: 0u32 });
            if (exp_t as usize) != 0 {
                let ef = unsafe { (*exp_t).fields };
                let ef_v = unsafe { (*typeid_at(ef, i)).v };
                exp_elem.v = ef_v;
            }
            let ety = check_expr(mut_view(*cx), e, (TypeId { v: exp_elem.v }));
            let dst = unsafe { typeid_at(fields, i) };
            unsafe { (*dst).v = ety.v; }
            i = i + 1;
            e = unsafe { (*e).next };
        }
        return unsafe { intern_tuple_ty(mut_view((*cx.thir).interner), fields, count) };
    }

    if ek == HIR_EXPR_STRUCT {
        return check_expr_struct(mut_view(*cx), expr);
    }
    if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        return check_expr_field_or_tuple_idx(mut_view(*cx), expr, ek);
    }
    if ek == HIR_EXPR_PATH || ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE ||
       ek == HIR_EXPR_IF || ek == HIR_EXPR_LOOP || ek == HIR_EXPR_WHILE ||
       ek == HIR_EXPR_JUMP || ek == HIR_EXPR_CALL || ek == HIR_EXPR_BINARY ||
       ek == HIR_EXPR_UNARY || ek == HIR_EXPR_CAST {
        return check_expr_flow_or_cast(mut_view(*cx), expr, (TypeId { v: expected.v }), ek);
    }
    if ek == HIR_EXPR_ARRAY || ek == HIR_EXPR_INDEX {
        return check_expr_array_or_index(mut_view(*cx), expr, (TypeId { v: expected.v }), ek);
    }
    if ek == HIR_EXPR_MATCH || ek == HIR_EXPR_VIEW || ek == HIR_EXPR_FOR ||
       ek == HIR_EXPR_RANGE || ek == HIR_EXPR_COMPTIME {
        return check_expr_match_or_view(mut_view(*cx), expr, (TypeId { v: expected.v }), ek);
    }
    if ek == HIR_EXPR_CLOSURE {
        return check_expr_closure(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_METHOD_CALL {
        return check_expr_method_call(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    check_expr_try_or_await(mut_view(*cx), expr, ek)
}

fn check_expr_struct(cx: mut_view<TypeckCtx>, expr: *const HirExpr) -> TypeId {
    if true {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let mut path_ty = unsafe { lookup_path_type(mut_view(*cx), view((*expr).path), mut_view(gargs)) };
        if gargs.count > 0 {
            unsafe {
                ptr_substmap_insert(mut_view((*cx.thir).expr_substs), expr as usize, gargs.args, gargs.count);
                ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (expr as usize) | 1usize, cx.current_fn);
                ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (expr as usize) | 3usize, cx.current_impl);
            }
        }
        if !is_error(mut_view(*cx), (TypeId { v: path_ty.v })) {
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: path_ty.v })) };
            let tk = if (t as usize) != 0 { unsafe { (*t).kind } } else { TY_ERROR };
            if tk == TY_ENUM {
                let name = unsafe { tc_path_name_sv(view(*cx), view((*expr).path)) };
                let mut vname = StrView { ptr: name.ptr, len: name.len };
                let mut k: usize = 0;
                while (k < name.len) {
                    if unsafe { *(name.ptr + k) } == 46u8 {
                        vname.ptr = unsafe { name.ptr + k + 1 };
                        vname.len = name.len - k - 1;
                    }
                    k = k + 1;
                }
                let mut found_variant = false;
                let mut vidx: usize = 0;
                let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
                while ((v as usize) != 0) {
                    let var_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
                    if sv_eq(view(var_name), view(vname)) {
                        found_variant = true;
                        unsafe { ptr_usizemap_insert(mut_view((*cx.thir).expr_variants), expr as usize, vidx); }
                        if !unsafe { (*v).is_struct } {
                            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                        }
                        let mut init: *mut HirFieldInit = unsafe { (*expr).fields };
                        while ((init as usize) != 0) {
                            let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                            let mut other: *mut HirFieldInit = unsafe { (*init).next };
                            while ((other as usize) != 0) {
                                let oname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*other).name.v })) };
                                if sv_eq(view(iname), view(oname)) {
                                    unsafe { type_error(mut_view(*cx), view((*other).span), AX_TYPE_DUPLICATE_FIELD); }
                                }
                                other = unsafe { (*other).next };
                            }
                            init = unsafe { (*init).next };
                        }
                        let row = unsafe { *typeid_ptr_at((*t).variant_fields, vidx) };
                        init = unsafe { (*expr).fields };
                        while ((init as usize) != 0) {
                            let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                            let mut found = false;
                            let mut idx: usize = 0;
                            let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                            while ((f as usize) != 0) {
                                let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                                if sv_eq(view(fname), view(iname)) {
                                    found = true;
                                    let fty_v = unsafe { (*typeid_at(row, idx)).v };
                                    let iexpr: *mut HirExpr = unsafe { (*init).expr };
                                    check_expr(mut_view(*cx), iexpr, (TypeId { v: fty_v }));
                                    break;
                                }
                                idx = idx + 1;
                                f = unsafe { (*f).next };
                            }
                            if !found {
                                unsafe { type_error(mut_view(*cx), view((*init).span), AX_TYPE_UNKNOWN_FIELD); }
                            }
                            init = unsafe { (*init).next };
                        }
                        let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                        while ((f as usize) != 0) {
                            let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                            let mut found = false;
                            init = unsafe { (*expr).fields };
                            while ((init as usize) != 0) {
                                let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                                if sv_eq(view(fname), view(iname)) { found = true; }
                                init = unsafe { (*init).next };
                            }
                            if !found {
                                unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISSING_FIELD); }
                            }
                            f = unsafe { (*f).next };
                        }
                        break;
                    }
                    vidx = vidx + 1;
                    v = unsafe { (*v).next };
                }
                if !found_variant {
                    return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                }
            } else if tk != TY_STRUCT {
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
            } else {
                let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let fptr = unsafe { (*t).fields };
                let mut init: *mut HirFieldInit = unsafe { (*expr).fields };
                while ((init as usize) != 0) {
                    let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                    let mut other: *mut HirFieldInit = unsafe { (*init).next };
                    while ((other as usize) != 0) {
                        let oname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*other).name.v })) };
                        if sv_eq(view(iname), view(oname)) {
                            unsafe { type_error(mut_view(*cx), view((*other).span), AX_TYPE_DUPLICATE_FIELD); }
                        }
                        other = unsafe { (*other).next };
                    }
                    init = unsafe { (*init).next };
                }
                init = unsafe { (*expr).fields };
                while ((init as usize) != 0) {
                    let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                    let mut found = false;
                    let mut idx: usize = 0;
                    let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
                    while ((f as usize) != 0) {
                        let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                        if sv_eq(view(fname), view(iname)) {
                            found = true;
                            unsafe { check_field_vis(mut_view(*cx), f, sdef, view((*init).span)); }
                            let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                            let iexpr: *mut HirExpr = unsafe { (*init).expr };
                            check_expr(mut_view(*cx), iexpr, (TypeId { v: fty_v }));
                            break;
                        }
                        idx = idx + 1;
                        f = unsafe { (*f).next };
                    }
                    if !found {
                        unsafe { type_error(mut_view(*cx), view((*init).span), AX_TYPE_UNKNOWN_FIELD); }
                    }
                    init = unsafe { (*init).next };
                }
                let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
                while ((f as usize) != 0) {
                    let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                    let mut found = false;
                    init = unsafe { (*expr).fields };
                    while ((init as usize) != 0) {
                        let iname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*init).name.v })) };
                        if sv_eq(view(fname), view(iname)) { found = true; }
                        init = unsafe { (*init).next };
                    }
                    if !found {
                        unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISSING_FIELD); }
                    }
                    f = unsafe { (*f).next };
                }
                if gargs.count > 0 {
                    let bytes = mul_usize(gargs.count, size_of<TypeId>());
                    let r_args = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId };
                    let mut i: usize = 0;
                    while (i < gargs.count) {
                        let gv = unsafe { (*typeid_at(gargs.args, i)).v };
                        let rg = resolve_ty(mut_view(*cx), (TypeId { v: gv }));
                        let dst = unsafe { typeid_at(r_args, i) };
                        unsafe { (*dst).v = rg.v; }
                        i = i + 1;
                    }
                    let orig_st_ty = unsafe { thir_get_item_type(view(*cx.thir), sdef) };
                    if orig_st_ty.v != 0u32 {
                        let r_slice = (GenericArgsSlice { args: r_args, count: gargs.count });
                        let sub = unsafe { subst_ty_with_vars(mut_view((*cx.thir).interner), mut_view(cx.type_vars), (TypeId { v: orig_st_ty.v }), view(r_slice)) };
                        path_ty.v = sub.v;
                    }
                }
            }
        }
        return (TypeId { v: path_ty.v });
    }
    unsafe { (*cx.thir).interner.t_error }
}

// `Type.NAME` for an associated constant of an impl whose self type unifies with `base_ty`: evaluates the constant,
// records it in expr_methods and returns its type (0 when no impl declares NAME).
fn tc_impl_assoc_const_ty(cx: mut_view<TypeckCtx>, expr: *const HirExpr, base_ty: TypeId, search: view<StrView>) -> TypeId {
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    if (cx.hir as usize) == 0 || (cx.str_in as usize) == 0 { return (TypeId { v: 0u32 }); }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((it as usize) != 0) {
        let self_ht: *mut HirType = unsafe { (*it).self_type };
        if unsafe { (*it).kind } == HIR_ITEM_IMPL && (self_ht as usize) != 0 {
            let old_impl = cx.current_impl;
            cx.current_impl = it;
            let impl_self_ty = hir_type_to_typeid(mut_view(*cx), self_ht);
            cx.current_impl = old_impl;
            if unify_ty(mut_view(*cx), (TypeId { v: impl_self_ty.v }), (TypeId { v: base_ty.v })) {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while ((m as usize) != 0) {
                    if unsafe { (*m).kind } == HIR_ITEM_CONST {
                        let cname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*m).name.v })) };
                        if sv_eq(view(cname), search) {
                            evaluate_const_item_in_impl(mut_view(*cx), m as *const HirItem, it as *const HirItem);
                            unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, m); }
                            let cty = unsafe { thir_get_item_type(view(*cx.thir), m) };
                            return if cty.v != 0u32 { (TypeId { v: cty.v }) } else { (TypeId { v: i32_v }) };
                        }
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }
    (TypeId { v: 0u32 })
}

fn check_expr_field_or_tuple_idx(cx: mut_view<TypeckCtx>, expr: *const HirExpr, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    if ek == HIR_EXPR_FIELD {
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let obj_ty = check_expr(mut_view(*cx), b_expr, (TypeId { v: 0u32 }));
        if !is_error(mut_view(*cx), (TypeId { v: obj_ty.v })) {
            let mut base_ty = resolve_ty(mut_view(*cx), (TypeId { v: obj_ty.v }));
            let mut t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
            while ((t as usize) != 0 && (unsafe { (*t).kind } == TY_VIEW || unsafe { (*t).kind } == TY_MUT_VIEW || unsafe { (*t).kind } == TY_PTR)) {
                let pt_v = unsafe { (*t).pointee.v };
                let r_pt = resolve_ty(mut_view(*cx), (TypeId { v: pt_v }));
                base_ty.v = r_pt.v;
                t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
            }
            if (t as usize) == 0 { return (TypeId { v: err_v }); }
            let tk = unsafe { (*t).kind };
            let search = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*expr).name.v })) };
            if tk == TY_STRUCT {
                let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let fptr = unsafe { (*t).fields };
                let mut idx: usize = 0;
                let mut f: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
                while ((f as usize) != 0) {
                    let fname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*f).name.v })) };
                    if sv_eq(view(fname), view(search)) {
                        if (cx.str_in as usize) != 0 && unsafe { tc_struct_is_lang_atomic(sdef, view(*cx.str_in)) } {
                            let same_mod = (cx.current_fn as usize) != 0 && (sdef as usize) != 0 &&
                                unsafe { dotted_name_eq(view((*cx.current_fn).module_path), view((*sdef).module_path)) };
                            if !same_mod {
                                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_CONC_ATOMIC_MUT_VIEW) };
                            }
                        }
                        let ok = unsafe { check_field_vis(mut_view(*cx), f, sdef, view((*expr).span)) };
                        if !ok { return (TypeId { v: err_v }); }
                        let fty_v = unsafe { (*typeid_at(fptr, idx)).v };
                        return (TypeId { v: fty_v });
                    }
                    idx = idx + 1;
                    f = unsafe { (*f).next };
                }
                let ac = tc_impl_assoc_const_ty(mut_view(*cx), expr, (TypeId { v: base_ty.v }), view(search));
                if ac.v != 0u32 { return ac; }
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
            }
            if tk == TY_PARAM {
                if (cx.hir as usize) != 0 {
                    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
                    while ((it as usize) != 0) {
                        if unsafe { (*it).kind } == HIR_ITEM_TRAIT {
                            let mut m: *mut HirItem = unsafe { (*it).members };
                            while ((m as usize) != 0) {
                                if unsafe { (*m).kind } == HIR_ITEM_CONST {
                                    let cname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*m).name.v })) };
                                    if sv_eq(view(cname), view(search)) {
                                        unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, m); }
                                        let cty = unsafe { thir_get_item_type(view(*cx.thir), m) };
                                        return if cty.v != 0u32 { (TypeId { v: cty.v }) } else { (TypeId { v: i32_v }) };
                                    }
                                }
                                m = unsafe { (*m).next };
                            }
                        }
                        it = unsafe { (*it).next };
                    }
                }
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
            }
            if tk == TY_ENUM {
                let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let mut vidx: usize = 0;
                let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
                while ((v as usize) != 0) {
                    let vname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
                    if sv_eq(view(vname), view(search)) {
                        unsafe { ptr_usizemap_insert(mut_view((*cx.thir).expr_variants), expr as usize, vidx); }
                        let vfc = unsafe { *usize_at((*t).variant_field_counts, vidx) };
                        if unsafe { (*v).is_struct } || vfc > 0 {
                            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                        }
                        return (TypeId { v: obj_ty.v });
                    }
                    vidx = vidx + 1;
                    v = unsafe { (*v).next };
                }
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
            }
            if unsafe { type_is_int((TypeId { v: base_ty.v }), view((*cx.thir).interner)) } {
                if tc_sv_is_3(view(search), 77u8, 73u8, 78u8) || tc_sv_is_3(view(search), 77u8, 65u8, 88u8) {
                    return (TypeId { v: base_ty.v });
                }
                if tc_sv_is_4(view(search), 66u8, 73u8, 84u8, 83u8) {
                    let u32_v = unsafe { (*cx.thir).interner.t_u32.v };
                    return (TypeId { v: u32_v });
                }
            }
            // T458b (SPEC-41 AXS-FLT-004): inherent associated constants of primitive types (`impl f64 { pub const
            // EPSILON: f64 = ...; }` read as `f64.EPSILON`, also on the integer types, bool and char). The built-in
            // integer MIN / MAX / BITS above take precedence.
            if tk == TY_F32 || tk == TY_F64 || tk == TY_BOOL || tk == TY_CHAR ||
               unsafe { type_is_int((TypeId { v: base_ty.v }), view((*cx.thir).interner)) } {
                let ac = tc_impl_assoc_const_ty(mut_view(*cx), expr, (TypeId { v: base_ty.v }), view(search));
                if ac.v != 0u32 { return ac; }
            }
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
        }
        return (TypeId { v: err_v });
    }

    if ek == HIR_EXPR_TUPLE_INDEX {
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let obj_ty = check_expr(mut_view(*cx), b_expr, (TypeId { v: 0u32 }));
        if !is_error(mut_view(*cx), (TypeId { v: obj_ty.v })) {
            let r_obj = resolve_ty(mut_view(*cx), (TypeId { v: obj_ty.v }));
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_obj.v })) };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                let tidx = (unsafe { (*expr).tuple_index }) as usize;
                if tk == TY_STRUCT {
                    let sdef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                    if (sdef as usize) != 0 && unsafe { (*sdef).is_tuple } {
                        if tidx < unsafe { (*t).field_count } {
                            let fty_v = unsafe { (*typeid_at((*t).fields, tidx)).v };
                            return (TypeId { v: fty_v });
                        }
                        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
                    }
                } else if tk == TY_TUPLE {
                    if tidx < unsafe { (*t).field_count } {
                        let fty_v = unsafe { (*typeid_at((*t).fields, tidx)).v };
                        return (TypeId { v: fty_v });
                    }
                    return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
                }
            }
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
        }
        return (TypeId { v: err_v });
    }
    (TypeId { v: err_v })
}

fn check_expr_flow_or_cast(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let isize_v = unsafe { (*cx.thir).interner.t_isize.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    let u32_v = unsafe { (*cx.thir).interner.t_u32.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    let char_v = unsafe { (*cx.thir).interner.t_char.v };
    if ek == HIR_EXPR_PATH {
        let mut gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let t = unsafe { lookup_path_type(mut_view(*cx), view((*expr).path), mut_view(gargs)) };
        if gargs.count > 0 {
            unsafe {
                ptr_substmap_insert(mut_view((*cx.thir).expr_substs), expr as usize, gargs.args, gargs.count);
                ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (expr as usize) | 1usize, cx.current_fn);
                ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (expr as usize) | 3usize, cx.current_impl);
            }
        }
        let sym_v = unsafe { (*expr).path.symbol.v };
        if sym_v != 0u32 {
            let citem = find_const_item_by_symbol(view(*cx), (SymbolId { v: sym_v }));
            if (citem as usize) != 0 {
                evaluate_const_item(mut_view(*cx), citem);
            }
        }
        if !is_error(mut_view(*cx), (TypeId { v: t.v })) {
            let k = kind_of(mut_view(*cx), (TypeId { v: t.v }));
            if k == TY_BUILTIN_DROP || k == TY_BUILTIN_LEN || k == TY_BUILTIN_PRINT || k == TY_BUILTIN_PRINT_INT {
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
            }
        }
        return (TypeId { v: t.v });
    }

    if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        return check_block(mut_view(*cx), blk, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_IF {
        return check_if(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_LOOP {
        let old_loop = cx.in_loop;
        cx.in_loop = true;
        let lbl = unsafe { (*expr).label };
        push_loop_env(mut_view(*cx), (StrId { v: lbl.v }), (TypeId { v: 0u32 }));
        let blk: *mut HirBlock = unsafe { (*expr).block };
        check_block(mut_view(*cx), blk, (TypeId { v: unit_v }));
        cx.loops_len = cx.loops_len - 1;
        cx.in_loop = old_loop;
        let le = unsafe { loopenv_at(cx.loops, cx.loops_len) };
        if unsafe { (*le).has_break } {
            let bty_v = unsafe { (*le).break_ty.v };
            return (TypeId { v: bty_v });
        }
        return (TypeId { v: never_v });
    }
    if ek == HIR_EXPR_WHILE {
        let old_loop = cx.in_loop;
        cx.in_loop = true;
        let lbl = unsafe { (*expr).label };
        push_loop_env(mut_view(*cx), (StrId { v: lbl.v }), (TypeId { v: unit_v }));
        let lpat: *mut HirPat = unsafe { (*expr).let_pat };
        if (lpat as usize) != 0 {
            desugar_while_let(mut_view(*cx), expr as *mut HirExpr);
            cx.loops_len = cx.loops_len - 1;
            cx.in_loop = old_loop;
            return check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
        }
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        check_expr(mut_view(*cx), cond_e, (TypeId { v: bool_v }));
        check_block(mut_view(*cx), blk, (TypeId { v: unit_v }));
        cx.loops_len = cx.loops_len - 1;
        cx.in_loop = old_loop;
        return (TypeId { v: unit_v });
    }
    if ek == HIR_EXPR_JUMP {
        let jk = unsafe { (*expr).jump_kind };
        let jexpr: *mut HirExpr = unsafe { (*expr).inner };
        if jk == JUMP_RETURN {
            let ret = if cx.return_type.v == 0u32 { (TypeId { v: unit_v }) } else { (TypeId { v: cx.return_type.v }) };
            if (jexpr as usize) != 0 {
                check_expr(mut_view(*cx), jexpr, (TypeId { v: ret.v }));
            } else if !unify_ty(mut_view(*cx), (TypeId { v: unit_v }), (TypeId { v: ret.v })) {
                unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH); }
            }
        } else if jk == JUMP_BREAK {
            let mut target: *mut LoopEnv = 0 as *mut LoopEnv;
            let lbl_v = unsafe { (*expr).label.v };
            if lbl_v != 0u32 {
                let mut i: usize = cx.loops_len;
                while (i > 0) {
                    let le = unsafe { loopenv_at(cx.loops, i - 1) };
                    if unsafe { (*le).label.v } == lbl_v {
                        target = le;
                        break;
                    }
                    i = i - 1;
                }
            } else if cx.loops_len > 0 {
                target = unsafe { loopenv_at(cx.loops, cx.loops_len - 1) };
            }
            if (target as usize) != 0 {
                let mut val_ty = (TypeId { v: unit_v });
                let t_bty_v = unsafe { (*target).break_ty.v };
                if (jexpr as usize) != 0 {
                    let vt = check_expr(mut_view(*cx), jexpr, (TypeId { v: t_bty_v }));
                    val_ty.v = vt.v;
                }
                if !unsafe { (*target).has_break } {
                    unsafe {
                        (*target).break_ty.v = val_ty.v;
                        (*target).has_break = true;
                    }
                } else if !is_error(mut_view(*cx), (TypeId { v: t_bty_v })) && !is_error(mut_view(*cx), (TypeId { v: val_ty.v })) {
                    let sp_ptr: *const HirExpr = if (jexpr as usize) != 0 { jexpr as *const HirExpr } else { expr as *const HirExpr };
                    let c_ty = unsafe { coerce(mut_view(*cx), (TypeId { v: val_ty.v }), (TypeId { v: t_bty_v }), view((*sp_ptr).span)) };
                    unsafe { (*target).break_ty.v = c_ty.v; }
                }
            } else {
                if (jexpr as usize) != 0 {
                    check_expr(mut_view(*cx), jexpr, (TypeId { v: 0u32 }));
                }
            }
        }
        return (TypeId { v: never_v });
    }
    if ek == HIR_EXPR_CALL { return check_call(mut_view(*cx), expr); }
    if ek == HIR_EXPR_BINARY { return check_binary(mut_view(*cx), expr, (TypeId { v: expected.v })); }
    if ek == HIR_EXPR_UNARY {
        let in_ptr: *const HirExpr = (unsafe { (*expr).inner }) as *const HirExpr;
        if is_arith_unary_expr(expr) && tree_has_arith_binop(in_ptr) {
            let ctx_ty = peek_arith_tree_int_type(mut_view(*cx), expr, (TypeId { v: expected.v }));
            if ctx_ty.v != 0u32 {
                return check_unary_in_arith(mut_view(*cx), expr, (TypeId { v: ctx_ty.v }));
            }
        }
        return check_unary(mut_view(*cx), expr);
    }

    if ek == HIR_EXPR_CAST {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let cty_ptr: *mut HirType = unsafe { (*expr).cast_ty };
        if tc_is_promote_cast(expr) {
            // Implicit promotion cast inserted by `check_unary_in_arith` (ADR-0044 section 2): its type is
            // the recorded tree context type; only the operand needs checking.
            check_expr(mut_view(*cx), in_e, (TypeId { v: 0u32 }));
            let pt = unsafe { thir_get_expr_type(view(*cx.thir), expr) };
            if pt.v != 0u32 {
                return (TypeId { v: pt.v });
            }
            return (TypeId { v: err_v });
        }
        let raw_src = check_expr(mut_view(*cx), in_e, (TypeId { v: 0u32 }));
        let src_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_src.v }));
        let raw_dest = hir_type_to_typeid(mut_view(*cx), cty_ptr);
        let dest_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_dest.v }));
        if dest_ty.v == 0u32 || is_error(mut_view(*cx), (TypeId { v: src_ty.v })) || is_error(mut_view(*cx), (TypeId { v: dest_ty.v })) {
            return (TypeId { v: err_v });
        }
        if src_ty.v == dest_ty.v { return (TypeId { v: dest_ty.v }); }

        let mut is_valid = false;
        let sk = kind_of(mut_view(*cx), (TypeId { v: src_ty.v }));
        let dk = kind_of(mut_view(*cx), (TypeId { v: dest_ty.v }));
        let dest_is_int = unsafe { type_is_int((TypeId { v: dest_ty.v }), view((*cx.thir).interner)) };
        let src_is_int = unsafe { type_is_int((TypeId { v: src_ty.v }), view((*cx.thir).interner)) };

        let src_is_fl = sk == TY_F32 || sk == TY_F64 || sk == TY_FLOAT_VAR;
        let dest_is_fl = dk == TY_F32 || dk == TY_F64;
        if is_intlike(mut_view(*cx), (TypeId { v: src_ty.v })) && dest_is_int {
            is_valid = true;
        } else if (src_is_fl || is_intlike(mut_view(*cx), (TypeId { v: src_ty.v }))) && dest_is_fl {
            // T457 (SPEC-41 AXS-FLT-023/024): IntToFloat, FloatConvert (f32 <-> f64).
            if sk == TY_FLOAT_VAR {
                let _ = unify_ty(mut_view(*cx), (TypeId { v: src_ty.v }), (TypeId { v: dest_ty.v }));
            }
            is_valid = true;
        } else if src_is_fl && dest_is_int {
            // T457 (SPEC-41 AXS-FLT-022): saturating FloatToInt.
            is_valid = true;
        } else if sk == TY_ENUM && dest_is_int {
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: src_ty.v })) };
            let mut has_payload = false;
            if (t as usize) != 0 {
                let mut i: usize = 0;
                while (i < unsafe { (*t).variant_count }) {
                    if unsafe { *usize_at((*t).variant_field_counts, i) } > 0 {
                        has_payload = true;
                        break;
                    }
                    i = i + 1;
                }
            }
            if !has_payload { is_valid = true; }
        } else if src_ty.v == bool_v && dest_is_int {
            is_valid = true;
        } else if (src_ty.v == u8_v || src_ty.v == u32_v) && dest_ty.v == char_v {
            is_valid = true;
        } else if src_ty.v == char_v && dest_is_int {
            if dk == TY_U32 || dk == TY_I32 || dk == TY_U64 || dk == TY_I64 || dk == TY_U128 || dk == TY_I128 || dk == TY_USIZE || dk == TY_ISIZE {
                is_valid = true;
            }
        } else if is_never(mut_view(*cx), (TypeId { v: src_ty.v })) {
            is_valid = true;
        } else if sk == TY_PTR && dk == TY_PTR {
            is_valid = true;
        } else if sk == TY_PTR && (dest_ty.v == usize_v || dest_ty.v == isize_v || dest_is_int) {
            is_valid = true;
        } else if (src_ty.v == usize_v || src_ty.v == isize_v || is_intlike(mut_view(*cx), (TypeId { v: src_ty.v })) || src_is_int) && dk == TY_PTR {
            is_valid = true;
        } else if sk == TY_FN && dest_ty.v == usize_v {
            // T501 (REQ-OWNER-008, SPEC-55 AXS-ADR-010): `f as usize` is the code address of a function item / fn pointer.
            is_valid = true;
        }
        if is_valid { return (TypeId { v: dest_ty.v }); }
        if unsafe { tc_try_report_capability_forgery(mut_view(*cx), (TypeId { v: src_ty.v }), (TypeId { v: dest_ty.v }), view((*expr).span), true) } {
            return (TypeId { v: err_v });
        }
        return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_INVALID_CAST) };
    }
    (TypeId { v: err_v })
}

fn check_expr_array_or_index(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let usize_v = unsafe { (*cx.thir).interner.t_usize.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    let u8_v = unsafe { (*cx.thir).interner.t_u8.v };
    let str_v = unsafe { (*cx.thir).interner.t_str.v };
    if ek == HIR_EXPR_ARRAY {
        let cnt_e: *mut HirExpr = unsafe { (*expr).count_expr };
        let elems_e: *mut HirExpr = unsafe { (*expr).elems };
        let mut expected_elem = (TypeId { v: 0u32 });
        if expected.v != 0u32 && kind_of(mut_view(*cx), (TypeId { v: expected.v })) == TY_ARRAY {
            let r_exp = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
            let et = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_exp.v })) };
            if (et as usize) != 0 {
                expected_elem.v = unsafe { (*et).elem.v };
            }
        }
        if (cnt_e as usize) != 0 {
            let mut arr_len: u64 = 0u64;
            if !eval_array_len_expr(mut_view(*cx), cnt_e, mut_view(arr_len)) {
                return (TypeId { v: err_v });
            }
            let elem_ty = check_expr(mut_view(*cx), elems_e, (TypeId { v: expected_elem.v }));
            if is_error(mut_view(*cx), (TypeId { v: elem_ty.v })) { return (TypeId { v: err_v }); }
            return unsafe { intern_array_ty(mut_view((*cx.thir).interner), (TypeId { v: elem_ty.v }), arr_len) };
        } else {
            let mut count: u64 = 0u64;
            let mut elem_ty = (TypeId { v: expected_elem.v });
            let mut e = elems_e;
            while ((e as usize) != 0) {
                count = count + 1u64;
                let t = check_expr(mut_view(*cx), e, (TypeId { v: elem_ty.v }));
                if elem_ty.v == 0u32 { elem_ty.v = t.v; }
                e = unsafe { (*e).next };
            }
            if elem_ty.v == 0u32 { elem_ty.v = never_v; }
            if is_error(mut_view(*cx), (TypeId { v: elem_ty.v })) { return (TypeId { v: err_v }); }
            return unsafe { intern_array_ty(mut_view((*cx.thir).interner), (TypeId { v: elem_ty.v }), count) };
        }
    }

    if ek == HIR_EXPR_INDEX {
        let b_expr: *mut HirExpr = unsafe { (*expr).base };
        let ia_expr: *mut HirExpr = unsafe { (*expr).index_arg };
        let raw_b = check_expr(mut_view(*cx), b_expr, (TypeId { v: 0u32 }));
        let base_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_b.v }));
        if is_error(mut_view(*cx), (TypeId { v: base_ty.v })) { return (TypeId { v: err_v }); }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        if (t as usize) == 0 { return (TypeId { v: err_v }); }
        let tk = unsafe { (*t).kind };
        let mut is_slice = false;
        let mut slice_elem_v: u32 = 0u32;
        if tk == TY_VIEW || tk == TY_MUT_VIEW {
            let pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: (*t).pointee.v })) };
            if (pt as usize) != 0 && unsafe { (*pt).kind } == TY_SLICE {
                is_slice = true;
                slice_elem_v = unsafe { (*pt).elem.v };
            }
        }
        let is_array = tk == TY_ARRAY;
        let is_str = tk == TY_STR;

        if (ia_expr as usize) != 0 && unsafe { (*ia_expr).kind } == HIR_EXPR_RANGE {
            if !is_slice && !is_array && !is_str {
                return unsafe { type_error(mut_view(*cx), view((*b_expr).span), AX_TYPE_CANNOT_INDEX) };
            }
            let se: *mut HirExpr = unsafe { (*ia_expr).start_expr };
            let ee: *mut HirExpr = unsafe { (*ia_expr).end_expr };
            if (se as usize) != 0 {
                let _ = check_index_operand(mut_view(*cx), se);
            }
            if (ee as usize) != 0 {
                let _ = check_index_operand(mut_view(*cx), ee);
            }
            if is_str { return (TypeId { v: str_v }); }
            if is_slice {
                let pt_id = TypeId { v: unsafe { (*t).pointee.v } };
                return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: pt_id.v }), tk == TY_MUT_VIEW) };
            }
            let elem_id = TypeId { v: unsafe { (*t).elem.v } };
            let sl_id = unsafe { intern_slice_ty(mut_view((*cx.thir).interner), (TypeId { v: elem_id.v })) };
            return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: sl_id.v }), false) };
        }

        if is_array || is_slice || is_str {
            if !check_index_operand(mut_view(*cx), ia_expr) { return (TypeId { v: err_v }); }
            if is_array {
                let ev = unsafe { (*t).elem.v };
                return (TypeId { v: ev });
            }
            if is_slice { return (TypeId { v: slice_elem_v }); }
            return (TypeId { v: u8_v });
        }

        if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
            let mut trait_res: u8 = TRAIT_DISPROVEN;
            let idx_sv = unsafe { tc_alloc_sv(mut_view((*cx.thir).interner.arena), 28) };
            let method_item = unsafe {
                find_method_in_scope(view(*cx.hir), view(*cx.thir), (TypeId { v: base_ty.v }), view(idx_sv), cx.current_fn, cx.current_impl, view(*cx.str_in), view(*cx.db), mut_view(trait_res))
            };
            if (method_item as usize) != 0 {
                unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, method_item); }
                let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), method_item) };
                if fn_ty_id.v != 0u32 {
                    let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
                    if (fn_ty as usize) != 0 {
                        let expected_idx_v = if unsafe { (*fn_ty).param_count } >= 2 {
                            unsafe { (*typeid_at((*fn_ty).param_types, 1)).v }
                        } else {
                            usize_v
                        };
                        check_expr(mut_view(*cx), ia_expr, (TypeId { v: expected_idx_v }));
                        let ret_v = unsafe { (*fn_ty).ret_type.v };
                        return (TypeId { v: ret_v });
                    }
                }
            }
        }
        return unsafe { type_error(mut_view(*cx), view((*b_expr).span), AX_TYPE_CANNOT_INDEX) };
    }
    (TypeId { v: err_v })
}

fn check_expr_match_or_view(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    let bool_v = unsafe { (*cx.thir).interner.t_bool.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    if ek == HIR_EXPR_MATCH {
        let m_scrut: *mut HirExpr = unsafe { (*expr).cond };
        let raw_val = check_expr(mut_view(*cx), m_scrut, (TypeId { v: 0u32 }));
        let val_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_val.v }));
        if is_error(mut_view(*cx), (TypeId { v: val_ty.v })) { return (TypeId { v: err_v }); }

        let mut match_ty = (TypeId { v: expected.v });
        let mut first = true;
        let mut has_error = false;
        let mut arm: *mut HirMatchArm = unsafe { (*expr).arms };
        while ((arm as usize) != 0) {
            let apat: *mut HirPat = unsafe { (*arm).pat };
            let aguard: *mut HirExpr = unsafe { (*arm).guard };
            let abody: *mut HirExpr = unsafe { (*arm).body };
            let p_ty = check_pat(mut_view(*cx), apat, (TypeId { v: val_ty.v }), true);
            if is_error(mut_view(*cx), (TypeId { v: p_ty.v })) { has_error = true; }
            if (aguard as usize) != 0 {
                check_expr(mut_view(*cx), aguard, (TypeId { v: bool_v }));
            }
            let arm_ty = check_expr(mut_view(*cx), abody, (TypeId { v: match_ty.v }));
            if first && !is_error(mut_view(*cx), (TypeId { v: arm_ty.v })) {
                match_ty.v = arm_ty.v;
                first = false;
            }
            arm = unsafe { (*arm).next };
        }
        if match_ty.v == 0u32 {
            let arms_head: *mut HirMatchArm = unsafe { (*expr).arms };
            let m_v = if (arms_head as usize) != 0 { err_v } else { never_v };
            match_ty.v = m_v;
        }
        if !has_error && !is_error(mut_view(*cx), (TypeId { v: val_ty.v })) && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 && (cx.sink as usize) != 0 {
            let fin_val_ty = resolve_ty(mut_view(*cx), (TypeId { v: val_ty.v }));
            unsafe {
                tc_match_check_exhaustiveness(
                    mut_view(*cx.thir),
                    mut_view(cx.type_vars),
                    view(*cx.str_in),
                    view(*cx.db),
                    mut_view(*cx.sink),
                    expr,
                    (TypeId { v: fin_val_ty.v })
                );
            }
        }
        return (TypeId { v: match_ty.v });
    }

    if ek == HIR_EXPR_VIEW {
        let is_m = unsafe { (*expr).is_mut };
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let mut expected_inner = (TypeId { v: 0u32 });
        if expected.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected.v })) {
            let r_exp = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
            let exp_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_exp.v })) };
            let want_k = if is_m { TY_MUT_VIEW } else { TY_VIEW };
            if (exp_t as usize) != 0 && unsafe { (*exp_t).kind } == want_k {
                expected_inner.v = unsafe { (*exp_t).pointee.v };
            }
        }
        let mut inner_ty_expected = (TypeId { v: expected_inner.v });
        if expected_inner.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected_inner.v })) && kind_of(mut_view(*cx), (TypeId { v: expected_inner.v })) == TY_SLICE {
            inner_ty_expected.v = 0u32;
        }
        let mut inner_ty = check_expr(mut_view(*cx), in_e, (TypeId { v: inner_ty_expected.v }));
        if is_error(mut_view(*cx), (TypeId { v: inner_ty.v })) { return (TypeId { v: err_v }); }
        if is_m && (in_e as usize) != 0 {
            // T498f (SPEC-02 AXS-GRM-041, SPEC-03 AXS-SEM-047): `mut_view(a[i])` / `mut_view(s.f)`
            // needs a mutable place: an immutable binding is AX_TYPE_ASSIGN_IMMUTABLE, a read-only
            // `view` level is AX_CAP_CONFLICT_MUT. A whole binding `mut_view(x)` keeps its check in
            // the MIR verifier.
            let ink = unsafe { (*in_e).kind };
            if ink == HIR_EXPR_FIELD || ink == HIR_EXPR_TUPLE_INDEX || ink == HIR_EXPR_INDEX {
                tc_check_place_mutable(mut_view(*cx), in_e, AX_CAP_CONFLICT_MUT, false);
            } else if ink == HIR_EXPR_PATH {
                let sym_v = unsafe { (*in_e).path.symbol.v };
                if sym_v != 0u32 && !tc_sym_is_local_var(view(*cx), sym_v) && tc_sym_is_immutable_item(view(*cx), sym_v) {
                    unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                }
            }
        }
        if is_m && (cx.str_in as usize) != 0 {
            let mut dummy_in = (TypeId { v: 0u32 });
            let r_in_chk = resolve_ty(mut_view(*cx), (TypeId { v: inner_ty.v }));
            if unsafe { tc_type_is_lang_atomic(view((*cx.thir).interner), view(*cx.str_in), (TypeId { v: r_in_chk.v }), mut_view(dummy_in)) } {
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_CONC_ATOMIC_MUT_VIEW) };
            }
        }
        if expected_inner.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected_inner.v })) {
            if kind_of(mut_view(*cx), (TypeId { v: inner_ty.v })) == TY_ARRAY && kind_of(mut_view(*cx), (TypeId { v: expected_inner.v })) == TY_SLICE {
                let r_in = resolve_ty(mut_view(*cx), (TypeId { v: inner_ty.v }));
                let it = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_in.v })) };
                let elem_id = TypeId { v: unsafe { (*it).elem.v } };
                let sl_id = unsafe { intern_slice_ty(mut_view((*cx.thir).interner), (TypeId { v: elem_id.v })) };
                inner_ty.v = sl_id.v;
            }
        }
        return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: inner_ty.v }), is_m) };
    }

    if ek == HIR_EXPR_FOR {
        desugar_for(mut_view(*cx), expr as *mut HirExpr);
        return check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_RANGE {
        desugar_range(mut_view(*cx), expr as *mut HirExpr);
        return check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
    }
    if ek == HIR_EXPR_COMPTIME {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        return check_block(mut_view(*cx), blk, (TypeId { v: expected.v }));
    }
    (TypeId { v: err_v })
}

fn check_expr_closure(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
    if true {
        let inner_bytes = mul_usize(128, size_of<SymbolId>());
        let inner_syms = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), inner_bytes, align_of<SymbolId>()) as *mut SymbolId };
        let mut inner_count: usize = 0;
        let mut p: *mut HirParam = unsafe { (*expr).params };
        while ((p as usize) != 0) {
            if inner_count < 128 {
                let dst = unsafe { symid_at(inner_syms, inner_count) };
                unsafe { (*dst).v = (*p).symbol.v; }
                inner_count = inner_count + 1;
            }
            p = unsafe { (*p).next };
        }

        let cap_bytes = mul_usize(64, size_of<RawCapture>());
        let raw_caps = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), cap_bytes, align_of<RawCapture>()) as *mut RawCapture };
        let mut raw_cap_count: usize = 0;
        let cbody: *mut HirExpr = unsafe { (*expr).body };
        scan_expr_captures(mut_view(*cx), cbody, inner_syms, mut_view(inner_count), raw_caps, mut_view(raw_cap_count), false, false);

        let mut caps: *mut ClosureCapture = 0 as *mut ClosureCapture;
        if raw_cap_count > 0 {
            let cbytes = mul_usize(raw_cap_count, size_of<ClosureCapture>());
            caps = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), cbytes, align_of<ClosureCapture>()) as *mut ClosureCapture };
            let mut i: usize = 0;
            while (i < raw_cap_count) {
                let rc = unsafe { rawcap_at(raw_caps, i) };
                let cc = unsafe { capture_at(caps, i) };
                let sym_v = unsafe { (*rc).sym.v };
                let vty = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: sym_v })) };
                let base_ty_v = if vty.v != 0u32 { vty.v } else { i32_v };
                unsafe { (*cc).sym.v = sym_v; }
                if unsafe { (*rc).is_moved } {
                    unsafe {
                        (*cc).mode = CAP_MOVE;
                        (*cc).ty.v = base_ty_v;
                    }
                } else if unsafe { (*rc).is_mutated } {
                    let vt_id = unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: base_ty_v }), true) };
                    unsafe {
                        (*cc).mode = CAP_MUT_VIEW;
                        (*cc).ty.v = vt_id.v;
                    }
                } else {
                    let is_c = if (cx.str_in as usize) != 0 {
                        unsafe { type_is_copy((TypeId { v: base_ty_v }), view(*cx.thir), view(*cx.str_in)) }
                    } else {
                        true
                    };
                    if is_c {
                        unsafe {
                            (*cc).mode = CAP_COPY;
                            (*cc).ty.v = base_ty_v;
                        }
                    } else {
                        let vt_id = unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: base_ty_v }), false) };
                        unsafe {
                            (*cc).mode = CAP_VIEW;
                            (*cc).ty.v = vt_id.v;
                        }
                    }
                }
                i = i + 1;
            }
        }

        let mut param_count: usize = 0;
        p = unsafe { (*expr).params };
        while ((p as usize) != 0) {
            param_count = param_count + 1;
            p = unsafe { (*p).next };
        }

        let mut exp_t: *mut AxType = 0 as *mut AxType;
        if expected.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected.v })) {
            let r_exp = resolve_ty(mut_view(*cx), (TypeId { v: expected.v }));
            exp_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_exp.v })) };
        }

        let mut closure_param_types: *mut TypeId = 0 as *mut TypeId;
        if param_count > 0 {
            let pbytes = mul_usize(param_count, size_of<TypeId>());
            closure_param_types = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), pbytes, align_of<TypeId>()) as *mut TypeId };
            let mut idx: usize = 0;
            p = unsafe { (*expr).params };
            while ((p as usize) != 0) {
                let mut pty = (TypeId { v: 0u32 });
                let p_ht: *mut HirType = unsafe { (*p).ty };
                if (p_ht as usize) != 0 {
                    let raw_p = hir_type_to_typeid(mut_view(*cx), p_ht);
                    let r_p = resolve_ty(mut_view(*cx), (TypeId { v: raw_p.v }));
                    pty.v = r_p.v;
                } else if (exp_t as usize) != 0 && (unsafe { (*exp_t).kind } == TY_FN || unsafe { (*exp_t).kind } == TY_CLOSURE) && idx < unsafe { (*exp_t).param_count } {
                    let ep_v = unsafe { (*typeid_at((*exp_t).param_types, idx)).v };
                    pty.v = ep_v;
                } else {
                    let iv = new_int_var(mut_view(*cx));
                    pty.v = iv.v;
                }
                let dst = unsafe { typeid_at(closure_param_types, idx) };
                unsafe {
                    (*dst).v = pty.v;
                    thir_set_param_type(mut_view(*cx.thir), p, (TypeId { v: pty.v }));
                    thir_set_symbol_type(mut_view(*cx.thir), (SymbolId { v: (*p).symbol.v }), (TypeId { v: pty.v }));
                }
                idx = idx + 1;
                p = unsafe { (*p).next };
            }
        }

        let mut exp_ret = (TypeId { v: 0u32 });
        let cret_ht: *mut HirType = unsafe { (*expr).ret_type };
        if (cret_ht as usize) != 0 {
            let raw_r = hir_type_to_typeid(mut_view(*cx), cret_ht);
            let r_r = resolve_ty(mut_view(*cx), (TypeId { v: raw_r.v }));
            exp_ret.v = r_r.v;
        } else if (exp_t as usize) != 0 && (unsafe { (*exp_t).kind } == TY_FN || unsafe { (*exp_t).kind } == TY_CLOSURE) {
            exp_ret.v = unsafe { (*exp_t).ret_type.v };
        }

        let old_ret = (TypeId { v: cx.return_type.v });
        let old_vars_len = cx.vars_len;
        let old_in_closure = cx.in_closure;
        cx.return_type.v = exp_ret.v;
        cx.in_closure = true;

        p = unsafe { (*expr).params };
        while ((p as usize) != 0) {
            let psym = unsafe { (*p).symbol };
            let pmut = unsafe { (*p).is_mut };
            push_var_state(mut_view(*cx), (SymbolId { v: psym.v }), pmut, true);
            p = unsafe { (*p).next };
        }

        let mut body_ty = check_expr(mut_view(*cx), cbody, (TypeId { v: exp_ret.v }));
        if body_ty.v == 0u32 { body_ty.v = unit_v; }
        let mut r_body = resolve_ty(mut_view(*cx), (TypeId { v: body_ty.v }));
        if (cret_ht as usize) == 0 && kind_of(mut_view(*cx), (TypeId { v: r_body.v })) == TY_INT_VAR {
            let _ = unify_ty(mut_view(*cx), (TypeId { v: r_body.v }), (TypeId { v: i32_v }));
            r_body = resolve_ty(mut_view(*cx), (TypeId { v: r_body.v }));
        }
        body_ty.v = r_body.v;

        cx.return_type.v = old_ret.v;
        cx.vars_len = old_vars_len;
        cx.in_closure = old_in_closure;

        return finish_closure_item(
            mut_view(*cx),
            expr,
            cbody,
            raw_caps,
            caps,
            raw_cap_count,
            closure_param_types,
            param_count,
            (TypeId { v: body_ty.v })
        );
    }
    unsafe { (*cx.thir).interner.t_error }
}

fn finish_closure_item(
    cx: mut_view<TypeckCtx>,
    expr: *const HirExpr,
    cbody: *mut HirExpr,
    raw_caps: *mut RawCapture,
    caps: *mut ClosureCapture,
    raw_cap_count: usize,
    closure_param_types: *mut TypeId,
    param_count: usize,
    body_ty: TypeId
) -> TypeId {
    if true {
        let mut p: *mut HirParam = 0 as *mut HirParam;
        let closure_id = cx.next_closure_id;
        cx.next_closure_id = cx.next_closure_id + 1u32;
        let closure_sym = 0x40000000u32 + closure_id;

        let fn_raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirItem>(), align_of<HirItem>()) };
        tc_zero_bytes(fn_raw, size_of<HirItem>());
        let fn_item = fn_raw as *mut HirItem;
        let efv = unsafe { (*expr).span.file.v };
        let est = unsafe { (*expr).span.start };
        let een = unsafe { (*expr).span.end };
        unsafe {
            (*fn_item).kind = HIR_ITEM_FN;
            (*fn_item).span.file.v = efv;
            (*fn_item).span.start = est;
            (*fn_item).span.end = een;
            (*fn_item).symbol.v = closure_sym;
            ptr_itemmap_insert(
                mut_view((*cx.thir).expr_methods),
                ((closure_sym as usize) << 3) | 4usize,
                fn_item as *const HirItem
            );
        }

        let mut first_p: *mut HirParam = 0 as *mut HirParam;
        let mut tail_p: *mut HirParam = 0 as *mut HirParam;
        let mut i: usize = 0;
        while (i < raw_cap_count) {
            let rc = unsafe { rawcap_at(raw_caps, i) };
            let cc = unsafe { capture_at(caps, i) };
            let hp_raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirParam>(), align_of<HirParam>()) };
            tc_zero_bytes(hp_raw, size_of<HirParam>());
            let hp = hp_raw as *mut HirParam;
            let c_mode = unsafe { (*cc).mode };
            let c_sym_v = unsafe { (*cc).sym.v };
            let c_ty_v = unsafe { (*cc).ty.v };
            let c_name_v = unsafe { (*rc).name.v };
            unsafe {
                (*hp).span.file.v = efv;
                (*hp).span.start = est;
                (*hp).span.end = een;
                (*hp).name.v = c_name_v;
                (*hp).is_mut = c_mode == CAP_MUT_VIEW;
                (*hp).symbol.v = c_sym_v;
                if (first_p as usize) == 0 { first_p = hp; } else { (*tail_p).next = hp; }
                tail_p = hp;
                thir_set_param_type(mut_view(*cx.thir), hp, (TypeId { v: c_ty_v }));
            }
            i = i + 1;
        }
        p = unsafe { (*expr).params };
        while ((p as usize) != 0) {
            let hp_raw = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<HirParam>(), align_of<HirParam>()) };
            tc_zero_bytes(hp_raw, size_of<HirParam>());
            let hp = hp_raw as *mut HirParam;
            let pty = unsafe { thir_get_param_type(view(*cx.thir), p) };
            unsafe {
                (*hp).span.file.v = (*p).span.file.v;
                (*hp).span.start = (*p).span.start;
                (*hp).span.end = (*p).span.end;
                (*hp).name.v = (*p).name.v;
                (*hp).symbol.v = (*p).symbol.v;
                (*hp).is_mut = (*p).is_mut;
                if (first_p as usize) == 0 { first_p = hp; } else { (*tail_p).next = hp; }
                tail_p = hp;
                thir_set_param_type(mut_view(*cx.thir), hp, (TypeId { v: pty.v }));
            }
            p = unsafe { (*p).next };
        }
        unsafe { (*fn_item).params = first_p; }

        if (cbody as usize) != 0 && unsafe { (*cbody).kind } == HIR_EXPR_BLOCK {
            let b_ptr: *mut HirBlock = unsafe { (*cbody).block };
            unsafe { (*fn_item).body = b_ptr; }
        } else {
            let bfv = if (cbody as usize) != 0 { unsafe { (*cbody).span.file.v } } else { efv };
            let bst = if (cbody as usize) != 0 { unsafe { (*cbody).span.start } } else { est };
            let ben = if (cbody as usize) != 0 { unsafe { (*cbody).span.end } } else { een };
            let blk = tc_alloc_block(mut_view(*cx), bfv, bst, ben);
            let st = tc_alloc_stmt(mut_view(*cx), HIR_STMT_EXPR, bfv, bst, ben);
            unsafe {
                (*st).expr = cbody;
                (*st).has_semi = false;
                (*blk).stmts = st;
                (*fn_item).body = blk;
            }
        }

        let total_fn_params = raw_cap_count + param_count;
        let alloc_cnt = if total_fn_params > 0 { total_fn_params } else { 1 };
        let fn_pbytes = mul_usize(alloc_cnt, size_of<TypeId>());
        let fn_param_types = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), fn_pbytes, align_of<TypeId>()) as *mut TypeId };
        i = 0;
        while (i < raw_cap_count) {
            let cc = unsafe { capture_at(caps, i) };
            let dst = unsafe { typeid_at(fn_param_types, i) };
            unsafe { (*dst).v = (*cc).ty.v; }
            i = i + 1;
        }
        i = 0;
        while (i < param_count) {
            let src = unsafe { typeid_at(closure_param_types, i) };
            let dst = unsafe { typeid_at(fn_param_types, raw_cap_count + i) };
            unsafe { (*dst).v = (*src).v; }
            i = i + 1;
        }

        let fn_type_id = unsafe { intern_fn_ty(mut_view((*cx.thir).interner), false, (StrId { v: 0u32 }), fn_param_types, total_fn_params, (TypeId { v: body_ty.v })) };
        unsafe { thir_set_item_type(mut_view(*cx.thir), fn_item, (TypeId { v: fn_type_id.v })); }

        if (cx.hir as usize) != 0 {
            let mut it: *mut HirItem = unsafe { (*cx.hir).items };
            if (it as usize) == 0 {
                let mut_hir = cx.hir as *mut HirFile;
                unsafe { (*mut_hir).items = fn_item; }
            } else {
                while ((unsafe { (*it).next } as usize) != 0) {
                    it = unsafe { (*it).next };
                }
                unsafe { (*it).next = fn_item; }
            }
        }

        let clos_ty_id = unsafe { intern_closure_ty(mut_view((*cx.thir).interner), closure_id, closure_sym, (TypeId { v: fn_type_id.v }), (TypeId { v: body_ty.v }), closure_param_types, param_count, caps, raw_cap_count) };
        let clos_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: clos_ty_id.v })) };
        if (clos_t as usize) != 0 {
            unsafe { (*clos_t).def = fn_item as *const HirItem; }
            let impl_gn = if (cx.current_impl as usize) != 0 && (cx.current_fn as usize) != (cx.current_impl as usize) {
                tc_item_generic_count(cx.current_impl)
            } else {
                0
            };
            let fn_gn = tc_item_generic_count(cx.current_fn);
            let enc_gn = impl_gn + fn_gn;
            if enc_gn > 0 {
                let gbytes = mul_usize(enc_gn, size_of<TypeId>());
                let clos_gargs = unsafe {
                    arena_alloc_raw(mut_view((*cx.thir).interner.arena), gbytes, align_of<TypeId>()) as *mut TypeId
                };
                let mut gidx: usize = 0;
                if impl_gn > 0 && (cx.current_impl as usize) != 0 {
                    let igps: *mut HirGenericParams = unsafe { (*cx.current_impl).generic_params };
                    if (igps as usize) != 0 {
                        let mut igp: *mut HirGenericParam = unsafe { (*igps).params };
                        while (igp as usize) != 0 && gidx < impl_gn {
                            let iname = unsafe { (*igp).name };
                            let pid = unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: iname.v }), gidx as u32) };
                            unsafe { (*typeid_at(clos_gargs, gidx)).v = pid.v; }
                            gidx = gidx + 1;
                            igp = unsafe { (*igp).next };
                        }
                    }
                }
                if fn_gn > 0 && (cx.current_fn as usize) != 0 {
                    let fgps: *mut HirGenericParams = unsafe { (*cx.current_fn).generic_params };
                    if (fgps as usize) != 0 {
                        let mut fgp: *mut HirGenericParam = unsafe { (*fgps).params };
                        while (fgp as usize) != 0 && gidx < enc_gn {
                            let fname = unsafe { (*fgp).name };
                            let pid = unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: fname.v }), gidx as u32) };
                            unsafe { (*typeid_at(clos_gargs, gidx)).v = pid.v; }
                            gidx = gidx + 1;
                            fgp = unsafe { (*fgp).next };
                        }
                    }
                }
                while gidx < enc_gn {
                    let pid = unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: 0u32 }), gidx as u32) };
                    unsafe { (*typeid_at(clos_gargs, gidx)).v = pid.v; }
                    gidx = gidx + 1;
                }
                unsafe {
                    (*clos_t).args = clos_gargs;
                    (*clos_t).arg_count = enc_gn;
                    ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (fn_item as usize) | 1usize, cx.current_fn);
                    ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (fn_item as usize) | 3usize, cx.current_impl);
                    if (cx.current_impl as usize) != 0 && cx.self_ty.v != 0u32 {
                        ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (fn_item as usize) | 2usize, cx.current_impl);
                        ptr_typemap_insert(mut_view((*cx.thir).item_types), (fn_item as usize) | 2usize, (TypeId { v: cx.self_ty.v }));
                    }
                }
            }
        }
        return clos_ty_id;
    }
    unsafe { (*cx.thir).interner.t_error }
}

fn check_expr_method_call(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    if true {
        let recv: *mut HirExpr = unsafe { (*expr).receiver };
        let args_head: *mut HirExpr = unsafe { (*expr).args };
        let mut is_type_name = false;
        if (recv as usize) != 0 && unsafe { (*recv).kind } == HIR_EXPR_PATH {
            is_type_name = true;
            let rsym_v = unsafe { (*recv).path.symbol.v };
            if rsym_v != 0u32 {
                let mut k: usize = 0;
                while (k < cx.vars_len) {
                    let vs = unsafe { varstate_at(cx.vars, k) };
                    if unsafe { (*vs).sym.v } == rsym_v {
                        is_type_name = false;
                        break;
                    }
                    k = k + 1;
                }
                if is_type_name && (cx.current_fn as usize) != 0 {
                    let mut p: *mut HirParam = unsafe { (*cx.current_fn).params };
                    while ((p as usize) != 0) {
                        if unsafe { (*p).symbol.v } == rsym_v {
                            is_type_name = false;
                            break;
                        }
                        p = unsafe { (*p).next };
                    }
                }
                if is_type_name {
                    let rit = find_item_by_symbol(view(*cx), (SymbolId { v: rsym_v }));
                    if (rit as usize) != 0 {
                        let rik = unsafe { (*rit).kind };
                        if rik == HIR_ITEM_CONST || rik == HIR_ITEM_STATIC {
                            is_type_name = false;
                        }
                    }
                }
            }
            if is_type_name && (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 {
                let rpsv = unsafe { tc_path_name_sv(view(*cx), view((*recv).path)) };
                if rpsv.len > 0 {
                    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
                    while ((it as usize) != 0) {
                        let ik = unsafe { (*it).kind };
                        if ik == HIR_ITEM_CONST || ik == HIR_ITEM_STATIC {
                            let iname_id = unsafe { (*it).name.v };
                            if iname_id != 0u32 {
                                let isv = unsafe { interner_get(view(*cx.str_in), (StrId { v: iname_id })) };
                                if sv_eq(view(isv), view(rpsv)) {
                                    is_type_name = false;
                                    break;
                                }
                            }
                        }
                        it = unsafe { (*it).next };
                    }
                }
            }
        }

        let receiver_ty = check_expr(mut_view(*cx), recv, (TypeId { v: 0u32 }));
        if is_error(mut_view(*cx), (TypeId { v: receiver_ty.v })) { return (TypeId { v: err_v }); }

        let mut base_ty = resolve_ty(mut_view(*cx), (TypeId { v: receiver_ty.v }));
        let mut t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        while ((t as usize) != 0 && (unsafe { (*t).kind } == TY_VIEW || unsafe { (*t).kind } == TY_MUT_VIEW || unsafe { (*t).kind } == TY_PTR)) {
            let pt_v = unsafe { (*t).pointee.v };
            let r_pt = resolve_ty(mut_view(*cx), (TypeId { v: pt_v }));
            base_ty.v = r_pt.v;
            t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };
        }
        if (t as usize) == 0 { return (TypeId { v: err_v }); }

        let mname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*expr).method_name.v })) };
        let mut trait_res: u8 = TRAIT_DISPROVEN;
        let mut method_item = if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
            pre_find_method_types(mut_view(*cx), (TypeId { v: base_ty.v }));
            unsafe { find_method_in_scope(view(*cx.hir), view(*cx.thir), (TypeId { v: base_ty.v }), view(mname), cx.current_fn, cx.current_impl, view(*cx.str_in), view(*cx.db), mut_view(trait_res)) }
        } else {
            0 as *mut HirItem
        };
        if (method_item as usize) != 0 && !tc_method_impl_matches_receiver(view(*cx), method_item, (TypeId { v: base_ty.v })) {
            method_item = 0 as *mut HirItem;
        }
        t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: base_ty.v })) };

        if trait_res == TRAIT_AMBIGUOUS {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TRAIT_AMBIGUOUS_METHOD) };
        }
        if (method_item as usize) == 0 {
            if unsafe { (*t).kind } == TY_ENUM {
                let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
                let mut vidx: usize = 0;
                let mut v: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
                while ((v as usize) != 0) {
                    let vname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
                    if sv_eq(view(vname), view(mname)) {
                        unsafe { ptr_usizemap_insert(mut_view((*cx.thir).expr_variants), expr as usize, vidx); }
                        if unsafe { (*v).is_struct } {
                            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_MISMATCH) };
                        }
                        let expected_args = unsafe { *usize_at((*t).variant_field_counts, vidx) };
                        let argc = count_expr_list(args_head);
                        if argc != expected_args {
                            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_ARG_COUNT) };
                        }
                        let payloads = unsafe { *typeid_ptr_at((*t).variant_fields, vidx) };
                        let mut arg_idx: usize = 0;
                        let mut a = args_head;
                        while ((a as usize) != 0) {
                            let pv = unsafe { (*typeid_at(payloads, arg_idx)).v };
                            check_expr(mut_view(*cx), a, (TypeId { v: pv }));
                            arg_idx = arg_idx + 1;
                            a = unsafe { (*a).next };
                        }
                        return (TypeId { v: receiver_ty.v });
                    }
                    vidx = vidx + 1;
                    v = unsafe { (*v).next };
                }
            }
            let mut int_base_ty = (TypeId { v: base_ty.v });
            let mut int_tk = unsafe { (*t).kind };
            if int_tk == TY_INT_VAR {
                let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
                unify_ty(mut_view(*cx), (TypeId { v: int_base_ty.v }), (TypeId { v: i32_v }));
                int_base_ty = resolve_ty(mut_view(*cx), (TypeId { v: int_base_ty.v }));
                let it = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: int_base_ty.v })) };
                if (it as usize) != 0 { int_tk = unsafe { (*it).kind }; }
            }
            let iref = intrinsic_lookup_int_method(mname, int_tk);
            if iref.has_desc {
                let code = intrinsic_encode(view(iref)) as usize;
                unsafe { ptr_usizemap_insert(mut_view((*cx.thir).expr_variants), expr as usize, code); }
                let op = iref.desc.op;
                let u32_v = unsafe { (*cx.thir).interner.t_u32.v };
                let argc = count_expr_list(args_head);
                let is_bin = op == INTR_OP_WRAPPING_ADD || op == INTR_OP_WRAPPING_SUB || op == INTR_OP_WRAPPING_MUL ||
                             op == INTR_OP_SATURATING_ADD || op == INTR_OP_SATURATING_SUB || op == INTR_OP_SATURATING_MUL ||
                             op == INTR_OP_ROTATE_LEFT || op == INTR_OP_ROTATE_RIGHT;
                let expected_total: usize = if is_bin { 2 } else { 1 };
                let pass_recv = !is_type_name;
                let total_args = (if pass_recv { 1 } else { 0 }) + argc;
                if total_args != expected_total {
                    let mut a = args_head;
                    while ((a as usize) != 0) {
                        check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
                        a = unsafe { (*a).next };
                    }
                    return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_ARG_COUNT) };
                }
                let mut a = args_head;
                let mut arg_idx: usize = if pass_recv { 1 } else { 0 };
                while ((a as usize) != 0) {
                    let exp_arg_v = if arg_idx == 1 && (op == INTR_OP_ROTATE_LEFT || op == INTR_OP_ROTATE_RIGHT) {
                        u32_v
                    } else {
                        int_base_ty.v
                    };
                    check_expr(mut_view(*cx), a, (TypeId { v: exp_arg_v }));
                    arg_idx = arg_idx + 1;
                    a = unsafe { (*a).next };
                }
                if op == INTR_OP_LEADING_ZEROS || op == INTR_OP_TRAILING_ZEROS || op == INTR_OP_COUNT_ONES {
                    return (TypeId { v: u32_v });
                }
                return (TypeId { v: int_base_ty.v });
            }
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_UNKNOWN_FIELD) };
        }

        unsafe { ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), expr as usize, method_item); }
        if !cx.in_closure && (cx.current_fn as usize) != 0 && (unsafe { (*cx.current_fn).is_async }) &&
           (cx.str_in as usize) != 0 && (cx.sink as usize) != 0 {
            if unsafe { tc_item_has_blocking_attr(method_item, view(*cx.str_in)) } {
                unsafe {
                    report_typeck_diag(
                        mut_view(*cx.sink),
                        AX_ASYNC_BLOCKING_IN_ASYNC,
                        (*expr).span.file.v,
                        (*expr).span.start,
                        (*expr).span.end
                    );
                }
            }
        }
        let mut fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), method_item) };
        let mut call_bound_substs: *mut GenericArgsSlice = 0 as *mut GenericArgsSlice;
        let mut fn_sig_subbed = false;
        let gps: *mut HirGenericParams = unsafe { (*method_item).generic_params };
        if unsafe { (*method_item).kind } == HIR_ITEM_FN && (gps as usize) != 0 {
            let mut param_count: usize = 0;
            let mut p: *mut HirGenericParam = unsafe { (*gps).params };
            while ((p as usize) != 0) {
                param_count = param_count + 1;
                p = unsafe { (*p).next };
            }
            if param_count > 0 {
                let gbytes = mul_usize(param_count, size_of<TypeId>());
                let gargs_arr = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), gbytes, align_of<TypeId>()) as *mut TypeId };
                let mga: *mut HirGenericArgs = unsafe { (*expr).generic_args };
                if (mga as usize) != 0 {
                    let mut ga: *mut HirGenericArg = unsafe { (*mga).args };
                    let mut k: usize = 0;
                    while (k < param_count) {
                        let gid = if (ga as usize) != 0 {
                            let gt: *mut HirType = unsafe { (*ga).ty };
                            hir_type_to_typeid(mut_view(*cx), gt)
                        } else {
                            unsafe { new_ty_var(mut_view(*cx), view((*expr).span)) }
                        };
                        let dst = unsafe { typeid_at(gargs_arr, k) };
                        unsafe { (*dst).v = gid.v; }
                        if (ga as usize) != 0 { ga = unsafe { (*ga).next }; }
                        k = k + 1;
                    }
                } else {
                    let mut k: usize = 0;
                    while (k < param_count) {
                        let gid = unsafe { new_ty_var(mut_view(*cx), view((*expr).span)) };
                        let dst = unsafe { typeid_at(gargs_arr, k) };
                        unsafe { (*dst).v = gid.v; }
                        k = k + 1;
                    }
                }
                let gslice = (GenericArgsSlice { args: gargs_arr, count: param_count });
                unsafe {
                    ptr_substmap_insert(mut_view((*cx.thir).expr_substs), expr as usize, gargs_arr, param_count);
                    ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (expr as usize) | 1usize, cx.current_fn);
                    ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (expr as usize) | 3usize, cx.current_impl);
                }
                let enc_impl = tc_fn_enclosing_impl(cx.hir, method_item as *const HirItem);
                let impl_n = if (enc_impl as usize) != 0 { tc_item_generic_count(enc_impl) } else { 0 };
                if impl_n > 0 {
                    let comb_ptr = tc_build_method_call_comb_substs(
                        mut_view(*cx),
                        expr,
                        enc_impl,
                        impl_n,
                        (TypeId { v: receiver_ty.v }),
                        (TypeId { v: base_ty.v }),
                        t,
                        gargs_arr,
                        param_count
                    );
                    call_bound_substs = comb_ptr;
                    let sub_fn = unsafe { tc_subst_ty_and_self(mut_view(*cx), (TypeId { v: fn_ty_id.v }), view(*comb_ptr), base_ty.v) };
                    fn_ty_id.v = sub_fn.v;
                } else {
                    let sub_fn = tc_subst_ty_and_self(mut_view(*cx), (TypeId { v: fn_ty_id.v }), view(gslice), base_ty.v);
                    fn_ty_id.v = sub_fn.v;
                }
                fn_sig_subbed = true;
            }
        }
        // T161: in the signature of a trait member, `Self` is the receiver's type.
        if !fn_sig_subbed {
            let enc_for_nongeneric = tc_fn_enclosing_impl(cx.hir, method_item as *const HirItem);
            let enc_ng_n = if (enc_for_nongeneric as usize) != 0 {
                tc_item_generic_count(enc_for_nongeneric)
            } else {
                0
            };
            if (enc_for_nongeneric as usize) != 0 &&
               (unsafe { (*enc_for_nongeneric).kind }) == HIR_ITEM_TRAIT && enc_ng_n > 0 &&
               (t as usize) != 0 && (unsafe { (*t).kind }) == TY_PARAM {
                let trait_gslice = unsafe { tc_extract_param_trait_args(mut_view(*cx), t, enc_for_nongeneric, enc_ng_n, view((*expr).span)) };
                let var_sub = tc_subst_ty_and_self(mut_view(*cx), (TypeId { v: fn_ty_id.v }), view(trait_gslice), base_ty.v);
                fn_ty_id.v = var_sub.v;
            } else if (enc_for_nongeneric as usize) != 0 &&
                      (unsafe { (*enc_for_nongeneric).kind }) == HIR_ITEM_IMPL && enc_ng_n > 0 {
                let comb_ng = tc_build_method_call_comb_substs(
                    mut_view(*cx),
                    expr,
                    enc_for_nongeneric,
                    enc_ng_n,
                    (TypeId { v: receiver_ty.v }),
                    (TypeId { v: base_ty.v }),
                    t,
                    0 as *mut TypeId,
                    0
                );
                let var_sub = unsafe { tc_subst_ty_and_self(mut_view(*cx), (TypeId { v: fn_ty_id.v }), view(*comb_ng), base_ty.v) };
                fn_ty_id.v = var_sub.v;
            } else if (t as usize) != 0 && unsafe { (*t).arg_count } > 0 && (unsafe { (*t).args as usize }) != 0 {
                let impl_gslice = (GenericArgsSlice { args: unsafe { (*t).args }, count: unsafe { (*t).arg_count } });
                let var_sub = tc_subst_ty_and_self(mut_view(*cx), (TypeId { v: fn_ty_id.v }), view(impl_gslice), base_ty.v);
                fn_ty_id.v = var_sub.v;
            } else if tc_sv_is_4(view(mname), 112u8, 111u8, 108u8, 108u8) {
                let mut inner_recv_v: u32 = base_ty.v;
                if (t as usize) != 0 && (unsafe { (*t).kind } == TY_VIEW || unsafe { (*t).kind } == TY_MUT_VIEW) {
                    inner_recv_v = unsafe { (*t).pointee.v };
                }
                let fut_out = resolve_future_output_ty(mut_view(*cx), (TypeId { v: inner_recv_v }));
                if fut_out.v != 0u32 {
                    let out_slot = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId };
                    unsafe { (*out_slot).v = fut_out.v; }
                    let fut_gslice = (GenericArgsSlice { args: out_slot, count: 1 });
                    let var_sub = tc_subst_ty_and_self(mut_view(*cx), (TypeId { v: fn_ty_id.v }), view(fut_gslice), inner_recv_v);
                    fn_ty_id.v = var_sub.v;
                } else {
                    let no_args = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
                    let self_sub = tc_subst_ty_and_self(mut_view(*cx), (TypeId { v: fn_ty_id.v }), view(no_args), base_ty.v);
                    fn_ty_id.v = self_sub.v;
                }
            } else {
                let no_args = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
                let self_sub = tc_subst_ty_and_self(mut_view(*cx), (TypeId { v: fn_ty_id.v }), view(no_args), base_ty.v);
                fn_ty_id.v = self_sub.v;
            }
        }

        let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
        if (fn_ty as usize) == 0 { return (TypeId { v: err_v }); }
        let expected_args = unsafe { (*fn_ty).param_count };
        let m_params: *mut HirParam = unsafe { (*method_item).params };
        let mut has_self = false;
        if (m_params as usize) != 0 && (cx.str_in as usize) != 0 {
            let pname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*m_params).name.v })) };
            if tc_sv_is_4(view(pname), 115u8, 101u8, 108u8, 102u8) { // self
                has_self = true;
            }
        }

        let pass_receiver = has_self && !is_type_name;
        // T445 QA F2 (SPEC-11 AXS-CAP-001/002): a receiver of type `view<T>` is reborrowed for a
        // `self: view<..>` method only; it never upgrades to the `mut_view<..>` that a
        // `self: mut_view<Self>` method needs (same code as passing view<T> to a mut_view<T> param).
        if pass_receiver && expected_args > 0 {
            let rtop = resolve_ty(mut_view(*cx), (TypeId { v: receiver_ty.v }));
            let rtop_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rtop.v })) };
            if (rtop_t as usize) != 0 && (unsafe { (*rtop_t).kind }) == TY_VIEW {
                let p0_raw_v = unsafe { (*typeid_at((*fn_ty).param_types, 0)).v };
                let p0 = resolve_ty(mut_view(*cx), (TypeId { v: p0_raw_v }));
                let p0_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: p0.v })) };
                if (p0_t as usize) != 0 && (unsafe { (*p0_t).kind }) == TY_MUT_VIEW {
                    let p0_pt_raw_v = unsafe { (*p0_t).pointee.v };
                    let p0_pt_id = resolve_ty(mut_view(*cx), (TypeId { v: p0_pt_raw_v }));
                    let p0_pt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: p0_pt_id.v })) };
                    // `self: mut_view<Self>` with `Self = view<..>` autorefs the view value itself: allowed.
                    if (p0_pt as usize) != 0 && (unsafe { (*p0_pt).kind }) != TY_VIEW && (unsafe { (*p0_pt).kind }) != TY_MUT_VIEW {
                        return unsafe { type_error(mut_view(*cx), view((*recv).span), AX_TYPE_MISMATCH) };
                    }
                }
            }
        }
        let argc = (if pass_receiver { 1 } else { 0 }) + count_expr_list(args_head);
        if argc != expected_args {
            let mut a = args_head;
            while ((a as usize) != 0) {
                check_expr(mut_view(*cx), a, (TypeId { v: 0u32 }));
                a = unsafe { (*a).next };
            }
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_ARG_COUNT) };
        }

        let ptypes = unsafe { (*fn_ty).param_types };
        let mut ret_v = unsafe { (*fn_ty).ret_type.v };
        if is_type_name && expected.v != 0u32 && !is_error(mut_view(*cx), (TypeId { v: expected.v })) {
            let _ = unify_ty(mut_view(*cx), (TypeId { v: ret_v }), (TypeId { v: expected.v }));
        }
        let method_substs = unsafe { ptr_substmap_get(view((*cx.thir).expr_substs), expr as usize) };
        let bound_substs: *mut GenericArgsSlice = if (call_bound_substs as usize) != 0 {
            call_bound_substs
        } else {
            method_substs
        };
        let mut i: usize = if pass_receiver { 1 } else { 0 };
        let mut a = args_head;
        while ((a as usize) != 0) {
            let raw_arg_exp_v = unsafe { (*typeid_at(ptypes, i)).v };
            let arg_expected = resolve_ty(mut_view(*cx), (TypeId { v: raw_arg_exp_v }));
            let arg_expected_v = arg_expected.v;
            let mut arg_ty = (TypeId { v: 0u32 });
            if (unsafe { (*a).kind }) == HIR_EXPR_CLOSURE && (bound_substs as usize) != 0 {
                let hint_ty = tc_build_callable_hint_ty(mut_view(*cx), method_item, bound_substs, base_ty.v, (TypeId { v: arg_expected_v }));
                if hint_ty.v != 0u32 {
                    arg_ty = check_expr_closure(mut_view(*cx), a, hint_ty);
                    unsafe { thir_set_expr_type(mut_view(*cx.thir), a, (TypeId { v: arg_ty.v })); }
                } else {
                    arg_ty = check_expr(mut_view(*cx), a, (TypeId { v: arg_expected_v }));
                }
            } else {
                arg_ty = check_expr(mut_view(*cx), a, (TypeId { v: arg_expected_v }));
            }
            if !is_error(mut_view(*cx), (TypeId { v: arg_ty.v })) && !unify_ty(mut_view(*cx), (TypeId { v: arg_ty.v }), (TypeId { v: arg_expected_v })) {
                unsafe { type_error(mut_view(*cx), view((*a).span), AX_TYPE_MISMATCH); }
            }
            i = i + 1;
            a = unsafe { (*a).next };
        }
        if (bound_substs as usize) != 0 && (unsafe { (*bound_substs).count }) > 0 {
            let msp_f = unsafe { (*expr).span.file.v };
            let msp_s = unsafe { (*expr).span.start };
            let msp_e = unsafe { (*expr).span.end };
            check_future_bound_outputs_for_call(
                mut_view(*cx),
                method_item,
                bound_substs,
                base_ty.v,
                Span { file: (FileId { v: msp_f }), start: msp_s, end: msp_e }
            );
            check_callable_bound_outputs_for_call(
                mut_view(*cx),
                method_item,
                bound_substs,
                base_ty.v,
                Span { file: (FileId { v: msp_f }), start: msp_s, end: msp_e }
            );
            tc_check_generic_trait_bounds_for_call(
                mut_view(*cx),
                method_item,
                bound_substs,
                base_ty.v,
                Span { file: (FileId { v: msp_f }), start: msp_s, end: msp_e }
            );
            ret_v = tc_deep_resolve_vars(mut_view(*cx), (TypeId { v: ret_v })).v;
            base_ty = tc_deep_resolve_vars(mut_view(*cx), (TypeId { v: base_ty.v }));
            if (method_substs as usize) != 0 {
                let mcnt = unsafe { (*method_substs).count };
                let margs = unsafe { (*method_substs).args };
                let mut mk: usize = 0;
                while mk < mcnt && (margs as usize) != 0 {
                    let mv = unsafe { (*typeid_at(margs, mk)).v };
                    let rmv = tc_deep_resolve_vars(mut_view(*cx), (TypeId { v: mv }));
                    unsafe { (*typeid_at(margs, mk)).v = rmv.v; }
                    mk = mk + 1;
                }
            }
        }
        let r_ret = resolve_ty(mut_view(*cx), (TypeId { v: ret_v }));
        ret_v = r_ret.v;
        base_ty = resolve_ty(mut_view(*cx), (TypeId { v: base_ty.v }));
        if is_type_name && (recv as usize) != 0 {
            unsafe { thir_set_expr_type(mut_view(*cx.thir), recv, (TypeId { v: base_ty.v })); }
        }
        if (cx.str_in as usize) != 0 {
            let mut inner_ty = (TypeId { v: 0u32 });
            if unsafe { tc_type_is_lang_atomic(view((*cx.thir).interner), view(*cx.str_in), (TypeId { v: base_ty.v }), mut_view(inner_ty)) } {
                let mut r_in = resolve_ty(mut_view(*cx), (TypeId { v: inner_ty.v }));
                if kind_of(mut_view(*cx), (TypeId { v: r_in.v })) == TY_INT_VAR {
                    let i32_v = unsafe { (*cx.thir).interner.t_i32.v };
                    let _ = unify_ty(mut_view(*cx), (TypeId { v: r_in.v }), (TypeId { v: i32_v }));
                    r_in = resolve_ty(mut_view(*cx), (TypeId { v: r_in.v }));
                    base_ty = resolve_ty(mut_view(*cx), (TypeId { v: base_ty.v }));
                    let r_ret2 = resolve_ty(mut_view(*cx), (TypeId { v: ret_v }));
                    ret_v = r_ret2.v;
                    if is_type_name && (recv as usize) != 0 {
                        unsafe { thir_set_expr_type(mut_view(*cx.thir), recv, (TypeId { v: base_ty.v })); }
                    }
                }
                if !unsafe { tc_is_valid_atomic_payload(view((*cx.thir).interner), (TypeId { v: r_in.v })) } {
                    unsafe { type_error(mut_view(*cx), view((*expr).span), AX_CONC_INVALID_ATOMIC_TYPE); }
                }
                let in_k = kind_of(mut_view(*cx), (TypeId { v: r_in.v }));
                let mut ord_val: u64 = 0u64;
                let mut fail_ord_val: u64 = 0u64;
                if tc_sv_is_4(view(mname), 108u8, 111u8, 97u8, 100u8) && (args_head as usize) != 0 { // load
                    if tc_eval_ordering_arg(mut_view(*cx), args_head, mut_view(ord_val)) {
                        unsafe { tc_validate_ordering_op(mut_view(*cx), view((*args_head).span), 1u8, ord_val, 0u64); }
                    }
                } else if tc_sv_is_5(view(mname), 115u8, 116u8, 111u8, 114u8, 101u8) && (args_head as usize) != 0 { // store
                    let a1: *mut HirExpr = unsafe { (*args_head).next };
                    if (a1 as usize) != 0 && tc_eval_ordering_arg(mut_view(*cx), a1, mut_view(ord_val)) {
                        unsafe { tc_validate_ordering_op(mut_view(*cx), view((*a1).span), 2u8, ord_val, 0u64); }
                    }
                } else if tc_sv_is_4(view(mname), 115u8, 119u8, 97u8, 112u8) && (args_head as usize) != 0 { // swap
                    let a1: *mut HirExpr = unsafe { (*args_head).next };
                    if (a1 as usize) != 0 {
                        let _ = tc_eval_ordering_arg(mut_view(*cx), a1, mut_view(ord_val));
                    }
                } else if (mname.len == 16 && unsafe { *(mname.ptr + 0) == 99u8 && *(mname.ptr + 7) == 95u8 && *(mname.ptr + 8) == 101u8 }) ||
                          (mname.len == 21 && unsafe { *(mname.ptr + 0) == 99u8 && *(mname.ptr + 16) == 95u8 && *(mname.ptr + 17) == 119u8 }) { // compare_exchange[_weak]
                    if (args_head as usize) != 0 {
                        let a1: *mut HirExpr = unsafe { (*args_head).next };
                        let a2: *mut HirExpr = if (a1 as usize) != 0 { unsafe { (*a1).next } } else { 0 as *mut HirExpr };
                        let a3: *mut HirExpr = if (a2 as usize) != 0 { unsafe { (*a2).next } } else { 0 as *mut HirExpr };
                        if (a2 as usize) != 0 && (a3 as usize) != 0 {
                            let ok1 = tc_eval_ordering_arg(mut_view(*cx), a2, mut_view(ord_val));
                            let ok2 = tc_eval_ordering_arg(mut_view(*cx), a3, mut_view(fail_ord_val));
                            if ok1 && ok2 {
                                unsafe { tc_validate_ordering_op(mut_view(*cx), view((*a3).span), 3u8, ord_val, fail_ord_val); }
                            }
                        }
                    }
                } else if mname.len == 9 && unsafe { *(mname.ptr + 0) == 102u8 && *(mname.ptr + 5) == 95u8 && ((*(mname.ptr + 6) == 97u8 && *(mname.ptr + 7) == 100u8) || (*(mname.ptr + 6) == 115u8 && *(mname.ptr + 7) == 117u8)) } { // fetch_add / fetch_sub
                    if in_k == TY_BOOL || in_k == TY_PTR {
                        unsafe { type_error(mut_view(*cx), view((*expr).span), AX_CONC_INVALID_ATOMIC_TYPE); }
                    }
                    if (args_head as usize) != 0 {
                        let a1: *mut HirExpr = unsafe { (*args_head).next };
                        if (a1 as usize) != 0 {
                            let _ = tc_eval_ordering_arg(mut_view(*cx), a1, mut_view(ord_val));
                        }
                    }
                } else if (mname.len == 9 && unsafe { *(mname.ptr + 0) == 102u8 && *(mname.ptr + 5) == 95u8 && ((*(mname.ptr + 6) == 97u8 && *(mname.ptr + 7) == 110u8) || (*(mname.ptr + 6) == 120u8 && *(mname.ptr + 7) == 111u8)) }) ||
                          (mname.len == 8 && unsafe { *(mname.ptr + 0) == 102u8 && *(mname.ptr + 5) == 95u8 && *(mname.ptr + 6) == 111u8 && *(mname.ptr + 7) == 114u8 }) { // fetch_and / fetch_or / fetch_xor
                    if in_k == TY_PTR {
                        unsafe { type_error(mut_view(*cx), view((*expr).span), AX_CONC_INVALID_ATOMIC_TYPE); }
                    }
                    if (args_head as usize) != 0 {
                        let a1: *mut HirExpr = unsafe { (*args_head).next };
                        if (a1 as usize) != 0 {
                            let _ = tc_eval_ordering_arg(mut_view(*cx), a1, mut_view(ord_val));
                        }
                    }
                }
            }
        }
        return (TypeId { v: ret_v });
    }
    (TypeId { v: err_v })
}

fn check_expr_try_or_await(cx: mut_view<TypeckCtx>, expr: *const HirExpr, ek: u8) -> TypeId {
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    if ek == HIR_EXPR_TRY {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let raw_et = check_expr(mut_view(*cx), in_e, (TypeId { v: 0u32 }));
        let expr_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_et.v }));
        if is_error(mut_view(*cx), (TypeId { v: expr_ty.v })) { return (TypeId { v: err_v }); }
        let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: expr_ty.v })) };
        if (t as usize) == 0 || unsafe { (*t).kind } != TY_ENUM {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_OPERAND) };
        }
        let edef: *mut HirItem = unsafe { (*t).def as *mut HirItem };
        let enum_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*edef).name.v })) };
        let is_opt = tc_sv_is_6(view(enum_name), 79u8, 112u8, 116u8, 105u8, 111u8, 110u8); // Option
        let is_res = tc_sv_is_6(view(enum_name), 82u8, 101u8, 115u8, 117u8, 108u8, 116u8); // Result
        if !is_opt && !is_res {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_OPERAND) };
        }
        if is_error(mut_view(*cx), cx.return_type) { return (TypeId { v: err_v }); }
        let r_ret = resolve_ty(mut_view(*cx), cx.return_type);
        let ret_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_ret.v })) };
        if (ret_t as usize) == 0 || unsafe { (*ret_t).kind } != TY_ENUM {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_RETURN_MISMATCH) };
        }
        let rdef: *mut HirItem = unsafe { (*ret_t).def as *mut HirItem };
        let ret_enum_name = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*rdef).name.v })) };
        if is_opt && !tc_sv_is_6(view(ret_enum_name), 79u8, 112u8, 116u8, 105u8, 111u8, 110u8) {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_RETURN_MISMATCH) };
        }
        if is_res && !tc_sv_is_6(view(ret_enum_name), 82u8, 101u8, 115u8, 117u8, 108u8, 116u8) {
            return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_TYPE_TRY_RETURN_MISMATCH) };
        }

        let mut payload_var: *mut HirVariantDecl = 0 as *mut HirVariantDecl;
        let mut payload_idx: u32 = 0u32;
        let mut err_idx: u32 = 0u32;
        let mut curr_idx: u32 = 0u32;
        let mut v: *mut HirVariantDecl = unsafe { (*edef).variants };
        while ((v as usize) != 0) {
            let vname = unsafe { interner_get(view(*cx.str_in), (StrId { v: (*v).name.v })) };
            let is_payload = if is_opt {
                tc_sv_is_4(view(vname), 83u8, 111u8, 109u8, 101u8) // Some
            } else {
                tc_sv_is_2(view(vname), 79u8, 107u8) // Ok
            };
            if is_payload {
                payload_var = v;
                payload_idx = curr_idx;
            } else {
                err_idx = curr_idx;
            }
            curr_idx = curr_idx + 1u32;
            v = unsafe { (*v).next };
        }
        let ttypes: *mut HirType = if (payload_var as usize) != 0 { unsafe { (*payload_var).tuple_types } } else { 0 as *mut HirType };
        if (payload_var as usize) == 0 || unsafe { (*payload_var).is_struct } || (ttypes as usize) == 0 {
            return (TypeId { v: err_v });
        }
        unsafe {
            ptr_trymap_insert(mut_view((*cx.thir).expr_try_info), expr as usize, is_opt, payload_idx as usize, err_idx as usize);
        }
        let pidx = payload_idx as usize;
        if unsafe { *usize_at((*t).variant_field_counts, pidx) } > 0 {
            let row = unsafe { *typeid_ptr_at((*t).variant_fields, pidx) };
            let pv = unsafe { (*typeid_at(row, 0)).v };
            return (TypeId { v: pv });
        }
        return hir_type_to_typeid(mut_view(*cx), ttypes);
    }

    if ek == HIR_EXPR_AWAIT {
        let mut bad_ctx = false;
        if (cx.current_impl as usize) != 0 && (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 &&
           tc_impl_is_lang_drop(unsafe { (*cx.hir).items }, cx.current_impl as *mut HirItem, unsafe { view(*cx.str_in) }) {
            let _ = unsafe { type_error(mut_view(*cx), view((*expr).span), AX_ASYNC_AWAIT_IN_DROP) };
            bad_ctx = true;
        } else if !cx.in_closure && (cx.current_fn as usize) != 0 && tc_item_is_interrupt_abi_ptr(cx.str_in, cx.current_fn) {
            bad_ctx = true;
        } else if cx.in_closure || (cx.current_fn as usize) == 0 || !unsafe { (*cx.current_fn).is_async } {
            let _ = unsafe { type_error(mut_view(*cx), view((*expr).span), AX_ASYNC_AWAIT_OUTSIDE_ASYNC) };
            bad_ctx = true;
        }
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let raw_ft = check_expr(mut_view(*cx), in_e, (TypeId { v: 0u32 }));
        let fut_ty = resolve_ty(mut_view(*cx), (TypeId { v: raw_ft.v }));
        if is_error(mut_view(*cx), (TypeId { v: fut_ty.v })) {
            return (TypeId { v: err_v });
        }
        let out_ty = resolve_future_output_ty(mut_view(*cx), (TypeId { v: fut_ty.v }));
        if out_ty.v == 0u32 {
            if !bad_ctx {
                return unsafe { type_error(mut_view(*cx), view((*expr).span), AX_ASYNC_NOT_A_FUTURE) };
            }
            return (TypeId { v: err_v });
        }
        return (TypeId { v: out_ty.v });
    }

    (TypeId { v: err_v })
}

pub fn check_expr(cx: mut_view<TypeckCtx>, expr: *const HirExpr, expected: TypeId) -> TypeId {
    if (expr as usize) == 0 {
        let uv = unsafe { (*cx.thir).interner.t_unit.v };
        return (TypeId { v: uv });
    }
    let ty = check_expr_kind(mut_view(*cx), expr, (TypeId { v: expected.v }));
    unsafe {
        thir_set_expr_type(mut_view(*cx.thir), expr, (TypeId { v: ty.v }));
        coerce(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: expected.v }), view((*expr).span))
    }
}

// T498f: reject a write (`=`, `op=`, `mut_view(..)`) into the place `l_expr` when it lies inside an
// immutable binding (SPEC-02 AXS-GRM-041) or behind a read-only `view` (SPEC-03 AXS-SEM-047, reported
// with `view_code`). Fields, tuple fields, elements and range sub-slices of a local continue to the
// base binding; the first `view`/`mut_view`/raw-pointer level decides instead. `recheck` is set for
// assignment targets: their sub-expressions are re-typed and a store through a `*const` pointer is
// rejected (existing rule); for `mut_view(..)` the recorded THIR types are used and raw pointers are
// not checked here (unchanged behaviour, `unsafe` code takes `mut_view((*p).f)` of `*const` bases).
fn tc_sym_is_local_var(cx: view<TypeckCtx>, sym_v: u32) -> bool {
    let mut i: usize = 0;
    while (i < cx.vars_len) {
        let vs = unsafe { varstate_at(cx.vars, i) };
        if unsafe { (*vs).sym.v } == sym_v {
            return true;
        }
        i = i + 1;
    }
    false
}

fn tc_sym_is_immutable_item(cx: view<TypeckCtx>, sym_v: u32) -> bool {
    if sym_v == 0u32 || (cx.hir as usize) == 0 { return false; }
    let it = unsafe_find_item_by_sym(cx.hir, cx.thir as *const Thir, SymbolId { v: sym_v });
    if (it as usize) == 0 { return false; }
    let ik = unsafe { (*it).kind };
    if ik == HIR_ITEM_CONST { return true; }
    if ik == HIR_ITEM_STATIC && !(unsafe { (*it).is_mut }) { return true; }
    false
}

fn tc_check_addr_of_mut_immut_static(cx: mut_view<TypeckCtx>, arg: *mut HirExpr) {
    if (arg as usize) == 0 { return; }
    let mut base: *const HirExpr = arg;
    while (base as usize) != 0 {
        let bk = unsafe { (*base).kind };
        if bk == HIR_EXPR_FIELD {
            let bsub: *mut HirExpr = unsafe { (*base).base };
            let raw_sub = unsafe { thir_get_expr_type(view(*cx.thir), bsub) };
            let subty = resolve_ty(mut_view(*cx), (TypeId { v: raw_sub.v }));
            let st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: subty.v })) };
            if (st as usize) != 0 {
                let stk = unsafe { (*st).kind };
                if stk == TY_PTR || stk == TY_VIEW || stk == TY_MUT_VIEW {
                    return;
                }
            }
            base = bsub;
        } else if bk == HIR_EXPR_TUPLE_INDEX {
            base = unsafe { (*base).base };
        } else if bk == HIR_EXPR_INDEX {
            let bsub: *mut HirExpr = unsafe { (*base).base };
            if (bsub as usize) == 0 { return; }
            if tc_expr_is_range_index(bsub) {
                base = bsub;
                continue;
            }
            let raw_sub = unsafe { thir_get_expr_type(view(*cx.thir), bsub) };
            let subty = resolve_ty(mut_view(*cx), (TypeId { v: raw_sub.v }));
            let st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: subty.v })) };
            if (st as usize) == 0 || unsafe { (*st).kind } != TY_ARRAY {
                return;
            }
            base = bsub;
        } else {
            break;
        }
    }
    if (base as usize) != 0 && unsafe { (*base).kind } == HIR_EXPR_PATH {
        let sym_v = unsafe { (*base).path.symbol.v };
        if sym_v != 0u32 && !tc_sym_is_local_var(view(*cx), sym_v) && tc_sym_is_immutable_item(view(*cx), sym_v) {
            unsafe { type_error(mut_view(*cx), view((*arg).span), AX_TYPE_ASSIGN_IMMUTABLE); }
        }
    }
}

fn tc_place_sub_ty(cx: mut_view<TypeckCtx>, e: *mut HirExpr, recheck: bool) -> TypeId {
    if recheck {
        return check_expr(mut_view(*cx), e, (TypeId { v: 0u32 }));
    }
    unsafe { thir_get_expr_type(view(*cx.thir), e) }
}

fn tc_check_place_mutable(cx: mut_view<TypeckCtx>, l_expr: *mut HirExpr, view_code: u32, recheck: bool) {
    let mut base: *const HirExpr = l_expr;
    let mut dereferenced = false;
    while ((base as usize) != 0) {
        let bk = unsafe { (*base).kind };
        if bk == HIR_EXPR_FIELD {
            let bsub: *mut HirExpr = unsafe { (*base).base };
            let raw_sub = tc_place_sub_ty(mut_view(*cx), bsub, recheck);
            let subty = resolve_ty(mut_view(*cx), (TypeId { v: raw_sub.v }));
            let st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: subty.v })) };
            if (st as usize) != 0 {
                let stk = unsafe { (*st).kind };
                if stk == TY_PTR {
                    if recheck && !unsafe { (*st).is_mut } {
                        unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                    }
                    dereferenced = true;
                    break;
                } else if stk == TY_VIEW {
                    unsafe { type_error(mut_view(*cx), view((*l_expr).span), view_code); }
                    dereferenced = true;
                    break;
                } else if stk == TY_MUT_VIEW {
                    dereferenced = true;
                    break;
                }
            }
            base = bsub;
        } else if bk == HIR_EXPR_UNARY && unsafe { (*base).op } == UNOP_DEREF {
            let u_in: *mut HirExpr = unsafe { (*base).inner };
            let raw_sub = tc_place_sub_ty(mut_view(*cx), u_in, recheck);
            let subty = resolve_ty(mut_view(*cx), (TypeId { v: raw_sub.v }));
            let st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: subty.v })) };
            if (st as usize) != 0 {
                let stk = unsafe { (*st).kind };
                if stk == TY_PTR {
                    if recheck && !unsafe { (*st).is_mut } {
                        unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                    }
                } else if stk == TY_VIEW {
                    unsafe { type_error(mut_view(*cx), view((*l_expr).span), view_code); }
                }
            }
            dereferenced = true;
            break;
        } else if bk == HIR_EXPR_TUPLE_INDEX {
            base = unsafe { (*base).base };
        } else if bk == HIR_EXPR_INDEX {
            // T498f (SPEC-02 AXS-GRM-041, SPEC-03 AXS-SEM-047): an element `a[i]` (or a range
            // sub-slice `a[lo..hi]` used as a place) of a local array is part of the array's
            // binding, so the walk continues to the base exactly as for fields. A base reached
            // through views is writable only when every view level is `mut_view`.
            let bsub: *mut HirExpr = unsafe { (*base).base };
            if (bsub as usize) == 0 { break; }
            if tc_expr_is_range_index(bsub) {
                base = bsub;
                continue;
            }
            let raw_sub = unsafe { thir_get_expr_type(view(*cx.thir), bsub) };
            if raw_sub.v == 0u32 { break; }
            let subty = resolve_ty(mut_view(*cx), (TypeId { v: raw_sub.v }));
            let mut st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: subty.v })) };
            if (st as usize) == 0 { break; }
            let stk0 = unsafe { (*st).kind };
            if stk0 == TY_ARRAY {
                base = bsub;
            } else if stk0 == TY_VIEW || stk0 == TY_MUT_VIEW {
                let mut all_mut = true;
                while ((st as usize) != 0 && (unsafe { (*st).kind } == TY_VIEW || unsafe { (*st).kind } == TY_MUT_VIEW)) {
                    if unsafe { (*st).kind } == TY_VIEW { all_mut = false; }
                    let pt = resolve_ty(mut_view(*cx), (TypeId { v: unsafe { (*st).pointee.v } }));
                    st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: pt.v })) };
                }
                if !all_mut {
                    unsafe { type_error(mut_view(*cx), view((*l_expr).span), view_code); }
                }
                dereferenced = true;
                break;
            } else {
                // Raw pointers (`AX_TYPE_CANNOT_INDEX`, SEM-T24), `str` and user `Index` impls
                // keep their existing rules.
                dereferenced = true;
                break;
            }
        } else {
            break;
        }
    }
    if !dereferenced && (base as usize) != 0 && (base as usize) != (l_expr as usize) && unsafe { (*base).kind } == HIR_EXPR_PATH {
        // A projection write (`s.f = v`, `a[i] = v`) into a binding needs `mut` even when the
        // binding is still uninitialised: a deferred `let` is initialised only by a whole
        // assignment (SPEC-02 AXS-GRM-041).
        let sym_v = unsafe { (*base).path.symbol.v };
        if sym_v != 0u32 {
            let mut found_var = false;
            let mut i: usize = 0;
            while (i < cx.vars_len) {
                let vs = unsafe { varstate_at(cx.vars, i) };
                if unsafe { (*vs).sym.v } == sym_v {
                    found_var = true;
                    if unsafe { !(*vs).is_mut } {
                        unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                    }
                    break;
                }
                i = i + 1;
            }
            if !found_var && tc_sym_is_immutable_item(view(*cx), sym_v) {
                unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
            }
        }
    }
}

// T498f: `e` is a range sub-slice `base[lo..hi]`.
fn tc_expr_is_range_index(e: *const HirExpr) -> bool {
    if (e as usize) == 0 || unsafe { (*e).kind } != HIR_EXPR_INDEX { return false; }
    let ia: *mut HirExpr = unsafe { (*e).index_arg };
    (ia as usize) != 0 && unsafe { (*ia).kind } == HIR_EXPR_RANGE
}

fn check_stmt_assign(cx: mut_view<TypeckCtx>, s: *mut HirStmt) -> bool {
    let r_expr: *mut HirExpr = unsafe { (*s).right };
    let l_expr: *mut HirExpr = unsafe { (*s).left };
    let right = check_expr(mut_view(*cx), r_expr, (TypeId { v: 0u32 }));
    let mut left = (TypeId { v: 0u32 });
    if (l_expr as usize) != 0 && unsafe { (*l_expr).kind } == HIR_EXPR_PATH {
        let mut dummy_gargs = (GenericArgsSlice { args: 0 as *mut TypeId, count: 0 });
        let lt = unsafe { lookup_path_type(mut_view(*cx), view((*l_expr).path), mut_view(dummy_gargs)) };
        left.v = lt.v;
        unsafe { thir_set_expr_type(mut_view(*cx.thir), l_expr, (TypeId { v: left.v })); }
        let sym_v = unsafe { (*l_expr).path.symbol.v };
        if sym_v != 0u32 {
            let mut found_var = false;
            let mut i: usize = 0;
            while (i < cx.vars_len) {
                let vs = unsafe { varstate_at(cx.vars, i) };
                if unsafe { (*vs).sym.v } == sym_v {
                    found_var = true;
                    if unsafe { (*vs).is_init && !(*vs).is_mut } {
                        unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
                    }
                    unsafe { (*vs).is_init = true; }
                    break;
                }
                i = i + 1;
            }
            if !found_var && tc_sym_is_immutable_item(view(*cx), sym_v) {
                unsafe { type_error(mut_view(*cx), view((*l_expr).span), AX_TYPE_ASSIGN_IMMUTABLE); }
            }
        }
    } else if (l_expr as usize) != 0 {
        let lt = check_expr(mut_view(*cx), l_expr, (TypeId { v: 0u32 }));
        left.v = lt.v;
        tc_check_place_mutable(mut_view(*cx), l_expr, AX_TYPE_ASSIGN_IMMUTABLE, true);
    }
    if (r_expr as usize) != 0 {
        unsafe { coerce(mut_view(*cx), (TypeId { v: right.v }), (TypeId { v: left.v }), view((*r_expr).span)); }
    }
    is_never(mut_view(*cx), (TypeId { v: right.v }))
}

pub fn check_block(cx: mut_view<TypeckCtx>, block: *const HirBlock, expected: TypeId) -> TypeId {
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    let never_v = unsafe { (*cx.thir).interner.t_never.v };
    let err_v = unsafe { (*cx.thir).interner.t_error.v };
    if (block as usize) == 0 { return (TypeId { v: unit_v }); }

    let mut ty = (TypeId { v: unit_v });
    let mut tail: *const HirExpr = 0 as *const HirExpr;
    let mut diverges = false;
    let mut reported_unreachable = false;

    let mut s: *mut HirStmt = unsafe { (*block).stmts };
    while ((s as usize) != 0) {
        if diverges && !reported_unreachable {
            if (cx.sink as usize) != 0 {
                let sfv = unsafe { (*s).span.file.v };
                let sst = unsafe { (*s).span.start };
                let sen = unsafe { (*s).span.end };
                unsafe { report_typeck_diag(mut_view(*cx.sink), AX_TYPE_UNREACHABLE, sfv, sst, sen); }
            }
            reported_unreachable = true;
        }
        tail = 0 as *const HirExpr;
        let sk = unsafe { (*s).kind };
        if sk != HIR_STMT_LET && (unsafe { (*s).attrs } as usize) != 0 {
            let _ = tc_validate_addr_stmt(mut_view(*cx), s);
        }
        if sk == HIR_STMT_LET {
            let lelse: *mut HirBlock = unsafe { (*s).else_block };
            if (lelse as usize) != 0 {
                desugar_let_else(mut_view(*cx), s);
                let sexpr: *mut HirExpr = unsafe { (*s).expr };
                let ety = check_expr(mut_view(*cx), sexpr, (TypeId { v: 0u32 }));
                if is_never(mut_view(*cx), (TypeId { v: ety.v })) { diverges = true; }
                if unsafe { (*s).has_semi } {
                    ty.v = unit_v;
                } else {
                    ty.v = ety.v;
                    tail = sexpr;
                }
                s = unsafe { (*s).next };
                continue;
            }
            let sty_ptr: *mut HirType = unsafe { (*s).ty };
            let mut declared = hir_type_to_typeid(mut_view(*cx), sty_ptr);
            let mut is_init = false;
            let sexpr: *mut HirExpr = unsafe { (*s).expr };
            let spat: *mut HirPat = unsafe { (*s).pat };
            if (sexpr as usize) != 0 {
                let init = check_expr(mut_view(*cx), sexpr, (TypeId { v: declared.v }));
                if is_never(mut_view(*cx), (TypeId { v: init.v })) { diverges = true; }
                if declared.v == 0u32 { declared.v = init.v; }
                is_init = true;
            } else if declared.v == 0u32 {
                if (spat as usize) != 0 {
                    unsafe { type_error(mut_view(*cx), view((*spat).span), AX_TYPE_UNKNOWN); }
                } else {
                    unsafe { type_error(mut_view(*cx), view((*s).span), AX_TYPE_UNKNOWN); }
                }
                declared.v = err_v;
            }
            if !is_pat_irrefutable(mut_view(*cx), spat, (TypeId { v: declared.v })) {
                if (spat as usize) != 0 {
                    unsafe { type_error(mut_view(*cx), view((*spat).span), AX_PAT_REFUTABLE); }
                } else {
                    unsafe { type_error(mut_view(*cx), view((*s).span), AX_PAT_REFUTABLE); }
                }
            }
            check_pat(mut_view(*cx), spat, (TypeId { v: declared.v }), is_init);
            if (unsafe { (*s).attrs } as usize) != 0 && tc_validate_addr_stmt(mut_view(*cx), s) {
                // T501: the binding lives at the fixed address, so it is initialised from the start and valid for `static_addr`.
                let mut vi: usize = cx.vars_len;
                while (vi > 0) {
                    vi = vi - 1;
                    let vs = unsafe { varstate_at(cx.vars, vi) };
                    if unsafe { (*vs).sym.v } == unsafe { (*spat).symbol.v } {
                        unsafe { (*vs).is_placed = true; (*vs).is_init = true; }
                        break;
                    }
                }
            }
            ty.v = unit_v;
        } else if sk == HIR_STMT_ASSIGN {
            if check_stmt_assign(mut_view(*cx), s) { diverges = true; }
            ty.v = unit_v;
        } else if sk == HIR_STMT_EXPR {
            let sexpr: *mut HirExpr = unsafe { (*s).expr };
            let ety = check_expr(mut_view(*cx), sexpr, (TypeId { v: 0u32 }));
            if is_never(mut_view(*cx), (TypeId { v: ety.v })) { diverges = true; }
            if unsafe { (*s).has_semi } {
                ty.v = unit_v;
            } else {
                ty.v = ety.v;
                tail = sexpr;
            }
        } else {
            ty.v = unit_v;
        }
        s = unsafe { (*s).next };
    }

    if diverges {
        ty.v = never_v;
    }

    if expected.v != 0u32 && !unify_ty(mut_view(*cx), (TypeId { v: ty.v }), (TypeId { v: expected.v })) {
        let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
        if r_ty.v == unit_v {
            return unsafe { type_error(mut_view(*cx), view((*block).span), AX_TYPE_RETURN) };
        }
        if (tail as usize) != 0 {
            if unsafe { tc_try_report_capability_forgery(mut_view(*cx), (TypeId { v: r_ty.v }), (TypeId { v: expected.v }), view((*tail).span), false) } {
                return (TypeId { v: err_v });
            }
            return unsafe { type_error(mut_view(*cx), view((*tail).span), AX_TYPE_MISMATCH) };
        }
        return unsafe { type_error(mut_view(*cx), view((*block).span), AX_TYPE_MISMATCH) };
    }

    ty
}

const SLOT_OCCUPIED: u8 = 1u8;

unsafe fn tc_subst_at(base: *mut GenericArgsSlice, idx: usize) -> *mut GenericArgsSlice {
    let off = mul_usize(idx, size_of<GenericArgsSlice>());
    ((base as usize) + off) as *mut GenericArgsSlice
}

fn find_item_by_symbol(cx: view<TypeckCtx>, sym: SymbolId) -> *const HirItem {
    if (cx.hir as usize) == 0 || sym.v == 0u32 {
        return 0 as *const HirItem;
    }
    if (cx.thir as usize) != 0 && (unsafe { (*cx.thir).expr_methods.cap }) > 0 {
        let indexed: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), 4usize) };
        if (indexed as usize) != 0 {
            let k: usize = ((sym.v as usize) << 3) | 4usize;
            let p: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), k) };
            if (p as usize) != 0 {
                return unsafe { *p };
            }
            return 0 as *const HirItem;
        }
    }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((it as usize) != 0) {
        if (unsafe { (*it).symbol.v }) == sym.v {
            return it;
        }
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_EXTERN_BLOCK || ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while ((m as usize) != 0) {
                if (unsafe { (*m).symbol.v }) == sym.v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *const HirItem
}

fn type_contains_view(cx: mut_view<TypeckCtx>, id: TypeId) -> bool {
    let r_id = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_id.v })) };
    if (t as usize) == 0 {
        return false;
    }
    let k = unsafe { (*t).kind };
    if k == TY_VIEW || k == TY_MUT_VIEW {
        return true;
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let fcnt = unsafe { (*t).field_count };
        let flds: *mut TypeId = unsafe { (*t).fields };
        let mut i: usize = 0;
        while (i < fcnt) {
            let ft_v = unsafe { (*typeid_at(flds, i)).v };
            if type_contains_view(mut_view(*cx), (TypeId { v: ft_v })) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if k == TY_ARRAY || k == TY_SLICE {
        let el_v = unsafe { (*t).elem.v };
        return type_contains_view(mut_view(*cx), (TypeId { v: el_v }));
    }
    if k == TY_ENUM {
        let vcnt = unsafe { (*t).variant_count };
        let vf_arr: *mut *mut TypeId = unsafe { (*t).variant_fields };
        let vfc_arr: *mut usize = unsafe { (*t).variant_field_counts };
        if (vf_arr as usize) == 0 || (vfc_arr as usize) == 0 {
            return false;
        }
        let mut v: usize = 0;
        while (v < vcnt) {
            let fc = unsafe { *usize_at(vfc_arr, v) };
            let vf = unsafe { *typeid_ptr_at(vf_arr, v) };
            let mut f: usize = 0;
            while (f < fc) {
                let ft_v = unsafe { (*typeid_at(vf, f)).v };
                if type_contains_view(mut_view(*cx), (TypeId { v: ft_v })) {
                    return true;
                }
                f = f + 1;
            }
            v = v + 1;
        }
        return false;
    }
    if k == TY_CLOSURE {
        let ccnt = unsafe { (*t).capture_count };
        let caps: *mut ClosureCapture = unsafe { (*t).captures };
        let mut i: usize = 0;
        while (i < ccnt) {
            let cc = unsafe { capture_at(caps, i) };
            let cm = unsafe { (*cc).mode };
            let ct_v = unsafe { (*cc).ty.v };
            if cm == CAP_MUT_VIEW || type_contains_view(mut_view(*cx), (TypeId { v: ct_v })) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    false
}

fn check_main_signature(cx: mut_view<TypeckCtx>, fn_item: *const HirItem) {
    if (cx.str_in as usize) == 0 || (fn_item as usize) == 0 {
        return;
    }
    let name_id = unsafe { (*fn_item).name };
    if name_id.v == 0u32 {
        return;
    }
    let sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: name_id.v })) };
    if !tc_sv_is_4(view(sv), 109u8, 97u8, 105u8, 110u8) {
        return;
    }
    if unsafe { (*fn_item).is_entry } {
        return;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_item).generic_params };
    let has_gp = if (gps as usize) != 0 {
        let gp_list: *mut HirGenericParam = unsafe { (*gps).params };
        (gp_list as usize) != 0
    } else {
        false
    };
    let prms: *mut HirParam = unsafe { (*fn_item).params };
    let is_u = unsafe { (*fn_item).is_unsafe };
    let abi_v = unsafe { (*fn_item).abi.v };
    let is_a = unsafe { (*fn_item).is_async };
    let is_c = unsafe { (*fn_item).is_comptime };
    if has_gp || (prms as usize) != 0 || is_u || abi_v != 0u32 || is_a || is_c {
        let _ = unsafe { type_error(mut_view(*cx), view((*fn_item).span), AX_TYPE_MAIN_SIGNATURE) };
        return;
    }
    let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), fn_item) };
    if fn_ty_id.v != 0u32 {
        let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
        if (fn_ty as usize) != 0 && (unsafe { (*fn_ty).kind }) == TY_FN {
            let ret_v = unsafe { (*fn_ty).ret_type.v };
            let ret_id = resolve_ty(mut_view(*cx), (TypeId { v: ret_v }));
            let rk = kind_of(mut_view(*cx), (TypeId { v: ret_id.v }));
            if rk != TY_UNIT && rk != TY_I32 && rk != TY_U32 && rk != TY_NEVER && rk != TY_ERROR {
                let _ = unsafe { type_error(mut_view(*cx), view((*fn_item).span), AX_TYPE_MAIN_SIGNATURE) };
            }
        }
    }
}

fn tc_method_impl_matches_receiver(cx: view<TypeckCtx>, method_item: *const HirItem, base_ty: TypeId) -> bool {
    if (method_item as usize) == 0 || (cx.hir as usize) == 0 || (cx.thir as usize) == 0 {
        return false;
    }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                if (m as usize) == (method_item as usize) {
                    let self_ty = unsafe { thir_get_item_type(view(*cx.thir), it) };
                    if self_ty.v == 0u32 || self_ty.v == base_ty.v {
                        return true;
                    }
                    let b_ptr = unsafe { type_get(view((*cx.thir).interner), base_ty) };
                    let s_ptr = unsafe { type_get(view((*cx.thir).interner), self_ty) };
                    if (b_ptr as usize) != 0 && (s_ptr as usize) != 0 {
                        let bk = unsafe { (*b_ptr).kind };
                        let sk = unsafe { (*s_ptr).kind };
                        if bk == sk && (bk == TY_STRUCT || bk == TY_ENUM) {
                            let bac = unsafe { (*b_ptr).arg_count };
                            let sac = unsafe { (*s_ptr).arg_count };
                            if bac != sac {
                                return false;
                            }
                            let mut i: usize = 0;
                            while i < bac {
                                let ba_v = unsafe { (*typeid_at((*b_ptr).args, i)).v };
                                let sa_v = unsafe { (*typeid_at((*s_ptr).args, i)).v };
                                if ba_v != sa_v {
                                    let sa_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: sa_v })) };
                                    let ba_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ba_v })) };
                                    let sa_k = if (sa_t as usize) != 0 { unsafe { (*sa_t).kind } } else { 0u8 };
                                    let ba_k = if (ba_t as usize) != 0 { unsafe { (*ba_t).kind } } else { 0u8 };
                                    if sa_k != TY_PARAM && sa_k != TY_VAR && ba_k != TY_PARAM && ba_k != TY_VAR {
                                        return false;
                                    }
                                }
                                i = i + 1;
                            }
                        }
                    }
                    return true;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    true
}

fn resolve_deep_ty(cx: mut_view<TypeckCtx>, id: TypeId) -> TypeId {
    if id.v == 0u32 {
        return (TypeId { v: 0u32 });
    }
    let r_id = resolve_ty(mut_view(*cx), (TypeId { v: id.v }));
    if r_id.v == 0u32 {
        return (TypeId { v: 0u32 });
    }
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_id.v })) };
    if (t as usize) == 0 {
        return (TypeId { v: r_id.v });
    }
    let k = unsafe { (*t).kind };
    if k == TY_VIEW || k == TY_MUT_VIEW {
        let old_pt_v = unsafe { (*t).pointee.v };
        let new_pt = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_pt_v }));
        if new_pt.v != old_pt_v {
            return unsafe { intern_view_ty(mut_view((*cx.thir).interner), (TypeId { v: new_pt.v }), k == TY_MUT_VIEW) };
        }
        return r_id;
    }
    r_id
}

fn finalize_ptr_typemap(cx: mut_view<TypeckCtx>, m: mut_view<PtrTypeMap>) {
    let cap = m.cap;
    let states = m.states;
    let vals = m.vals;
    let mut i: usize = 0;
    while (i < cap) {
        if (unsafe { *(states + i) }) == SLOT_OCCUPIED {
            let vp = unsafe { typeid_at(vals, i) };
            let old_v = unsafe { (*vp).v };
            let new_t = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
            unsafe { (*vp).v = new_t.v; }
        }
        i = i + 1;
    }
}

fn finalize_sym_typemap(cx: mut_view<TypeckCtx>, m: mut_view<SymTypeMap>) {
    let cap = m.cap;
    let states = m.states;
    let vals = m.vals;
    let mut i: usize = 0;
    while (i < cap) {
        if (unsafe { *(states + i) }) == SLOT_OCCUPIED {
            let vp = unsafe { typeid_at(vals, i) };
            let old_v = unsafe { (*vp).v };
            let new_t = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
            unsafe { (*vp).v = new_t.v; }
        }
        i = i + 1;
    }
}

fn finalize_ptr_substmap(cx: mut_view<TypeckCtx>, m: mut_view<PtrSubstMap>, is_expr_map: bool) {
    let cap = m.cap;
    let states = m.states;
    let keys = m.keys;
    let vals = m.vals;
    let mut i: usize = 0;
    while (i < cap) {
        if (unsafe { *(states + i) }) == SLOT_OCCUPIED {
            let mut skip_builtin = false;
            if is_expr_map {
                let k_addr = unsafe { *usize_at(keys, i) };
                let ety = unsafe { thir_get_expr_type(view(*cx.thir), k_addr as *const HirExpr) };
                if ety.v != 0u32 {
                    let et = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ety.v })) };
                    if (et as usize) != 0 {
                        let ek = unsafe { (*et).kind };
                        // T498g: the generic raw-memory intrinsics (TY_BUILTIN_ADDRESS_OF ..= TY_BUILTIN_NULL_MUT) are
                        // NOT skipped. Their substitution is the element type `T` that the MIR builder hands to the
                        // interp and the LIR lowering (`size_of<T>()` per element of ptr_copy / ptr_write_bytes /
                        // ptr_add / drop_in_place). An inferred `T` (`ptr_copy_nonoverlapping(p, q, 1)` without
                        // `<T>`) is an inference variable that was unified with the pointee; leaving it unresolved
                        // gave it size 0, which the backends clamp to 1, so every inferred-`T` call moved `count`
                        // BYTES (`[4]u32` / `u64` copies moved 1 byte per element; std `swap` on arrays exchanged
                        // only the low byte of element 0).
                        if ek == TY_BUILTIN_LEN ||
                           (ek >= TY_BUILTIN_PRINT && ek <= TY_BUILTIN_DROP) {
                            skip_builtin = true;
                        }
                    }
                }
            }
            if !skip_builtin {
                let sp = unsafe { tc_subst_at(vals, i) };
                let cnt = unsafe { (*sp).count };
                let args: *mut TypeId = unsafe { (*sp).args };
                let mut j: usize = 0;
                while (j < cnt) {
                    let ap = unsafe { typeid_at(args, j) };
                    let old_v = unsafe { (*ap).v };
                    let new_t = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                    unsafe { (*ap).v = new_t.v; }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
}

fn finalize_types(cx: mut_view<TypeckCtx>) {
    let thir_ptr = cx.thir;
    unsafe {
        finalize_ptr_typemap(mut_view(*cx), mut_view((*thir_ptr).expr_types));
        finalize_ptr_typemap(mut_view(*cx), mut_view((*thir_ptr).pat_types));
        finalize_ptr_typemap(mut_view(*cx), mut_view((*thir_ptr).param_types));
        finalize_sym_typemap(mut_view(*cx), mut_view((*thir_ptr).symbol_types));
        finalize_ptr_substmap(mut_view(*cx), mut_view((*thir_ptr).expr_substs), true);
        finalize_ptr_substmap(mut_view(*cx), mut_view((*thir_ptr).pat_substs), false);

        let ilen = (*thir_ptr).interner.len;
        let mut i: usize = 0;
        while i < ilen {
            let tid = TypeId { v: (i + 1) as u32 };
            let t = type_get(view((*thir_ptr).interner), tid);
            if (t as usize) != 0 {
                let k = (*t).kind;
                if k == TY_TUPLE {
                    let fc = (*t).field_count;
                    let fptr = (*t).fields;
                    let mut j: usize = 0;
                    while j < fc {
                        let fp = typeid_at(fptr, j);
                        let old_v = (*fp).v;
                        let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                        (*fp).v = r_ty.v;
                        j = j + 1;
                    }
                } else if k == TY_ARRAY || k == TY_SLICE {
                    let old_v = (*t).elem.v;
                    let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                    (*t).elem.v = r_ty.v;
                } else if k == TY_PTR {
                    let old_v = (*t).pointee.v;
                    let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                    (*t).pointee.v = r_ty.v;
                } else if k == TY_STRUCT {
                    let ac = (*t).arg_count;
                    let aptr = (*t).args;
                    let mut j: usize = 0;
                    while j < ac {
                        let ap = typeid_at(aptr, j);
                        let old_v = (*ap).v;
                        let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                        (*ap).v = r_ty.v;
                        j = j + 1;
                    }
                    let fc = (*t).field_count;
                    let fptr = (*t).fields;
                    j = 0;
                    while j < fc {
                        let fp = typeid_at(fptr, j);
                        let old_v = (*fp).v;
                        let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                        (*fp).v = r_ty.v;
                        j = j + 1;
                    }
                } else if k == TY_ENUM {
                    let ac = (*t).arg_count;
                    let aptr = (*t).args;
                    let mut j: usize = 0;
                    while j < ac {
                        let ap = typeid_at(aptr, j);
                        let old_v = (*ap).v;
                        let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                        (*ap).v = r_ty.v;
                        j = j + 1;
                    }
                    let vc = (*t).variant_count;
                    let vfc = (*t).variant_field_counts;
                    let vfptr = (*t).variant_fields;
                    if (vfc as usize) != 0 && (vfptr as usize) != 0 {
                        let mut v: usize = 0;
                        while v < vc {
                            let fc = *usize_at(vfc, v);
                            let row = *typeid_ptr_at(vfptr, v);
                            if (row as usize) != 0 {
                                j = 0;
                                while j < fc {
                                    let fp = typeid_at(row, j);
                                    let old_v = (*fp).v;
                                    let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                                    (*fp).v = r_ty.v;
                                    j = j + 1;
                                }
                            }
                            v = v + 1;
                        }
                    }
                } else if k == TY_CLOSURE {
                    let mut clos_changed = false;
                    let cc = (*t).capture_count;
                    let cptr = (*t).captures;
                    if (cptr as usize) != 0 {
                        let mut j: usize = 0;
                        while j < cc {
                            let cap = capture_at(cptr, j);
                            let old_v = (*cap).ty.v;
                            let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                            if r_ty.v != old_v {
                                (*cap).ty.v = r_ty.v;
                                clos_changed = true;
                            }
                            j = j + 1;
                        }
                    }
                    let pc = (*t).param_count;
                    let pptr = (*t).param_types;
                    if (pptr as usize) != 0 {
                        let mut j: usize = 0;
                        while j < pc {
                            let pp = typeid_at(pptr, j);
                            let old_pv = (*pp).v;
                            let r_pty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_pv }));
                            if r_pty.v != old_pv {
                                (*pp).v = r_pty.v;
                                clos_changed = true;
                            }
                            j = j + 1;
                        }
                    }
                    let old_ret = (*t).ret_type.v;
                    let r_ret = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_ret }));
                    if r_ret.v != old_ret {
                        (*t).ret_type.v = r_ret.v;
                        clos_changed = true;
                    }
                    if clos_changed {
                        let tot_p = cc + pc;
                        let alloc_p = if tot_p > 0 { tot_p } else { 1 };
                        let fp_bytes = mul_usize(alloc_p, size_of<TypeId>());
                        let fn_ptypes = arena_alloc_raw(mut_view((*thir_ptr).interner.arena), fp_bytes, align_of<TypeId>()) as *mut TypeId;
                        let mut j: usize = 0;
                        while j < cc {
                            let cap = capture_at(cptr, j);
                            (*typeid_at(fn_ptypes, j)).v = (*cap).ty.v;
                            j = j + 1;
                        }
                        j = 0;
                        while j < pc {
                            (*typeid_at(fn_ptypes, cc + j)).v = (*typeid_at(pptr, j)).v;
                            j = j + 1;
                        }
                        let new_fn_ty = intern_fn_ty(
                            mut_view((*thir_ptr).interner),
                            false,
                            (StrId { v: 0u32 }),
                            fn_ptypes,
                            tot_p,
                            (TypeId { v: r_ret.v })
                        );
                        (*t).fn_type.v = new_fn_ty.v;
                        let csym_v = (*t).fn_sym;
                        let fn_ptr = ptr_itemmap_get(view((*thir_ptr).expr_methods), ((csym_v as usize) << 3) | 4usize);
                        if (fn_ptr as usize) != 0 {
                            let fn_it = (*fn_ptr) as *mut HirItem;
                            if (fn_it as usize) != 0 {
                                thir_set_item_type(mut_view(*thir_ptr), fn_it, (TypeId { v: new_fn_ty.v }));
                                let mut hp: *mut HirParam = (*fn_it).params;
                                let mut pi: usize = 0;
                                while pi < cc && (hp as usize) != 0 {
                                    let cap = capture_at(cptr, pi);
                                    thir_set_param_type(mut_view(*thir_ptr), hp, (TypeId { v: (*cap).ty.v }));
                                    hp = (*hp).next;
                                    pi = pi + 1;
                                }
                                pi = 0;
                                while pi < pc && (hp as usize) != 0 {
                                    let pty_v = (*typeid_at(pptr, pi)).v;
                                    thir_set_param_type(mut_view(*thir_ptr), hp, (TypeId { v: pty_v }));
                                    if (*hp).symbol.v != 0u32 {
                                        thir_set_sym_type(mut_view(*thir_ptr), (SymbolId { v: (*hp).symbol.v }), (TypeId { v: pty_v }));
                                    }
                                    hp = (*hp).next;
                                    pi = pi + 1;
                                }
                            }
                        }
                    }
                } else if k == TY_COROUTINE {
                    let old_ret = (*t).ret_type.v;
                    let r_ret = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_ret }));
                    let mut coro_changed = false;
                    if r_ret.v != old_ret {
                        (*t).ret_type.v = r_ret.v;
                        coro_changed = true;
                    }
                    let ac = (*t).arg_count;
                    let aptr = (*t).args;
                    let mut j: usize = 0;
                    while j < ac {
                        let ap = typeid_at(aptr, j);
                        let old_v = (*ap).v;
                        let r_ty = resolve_deep_ty(mut_view(*cx), (TypeId { v: old_v }));
                        if r_ty.v != old_v {
                            (*ap).v = r_ty.v;
                            coro_changed = true;
                        }
                        j = j + 1;
                    }
                    if coro_changed {
                        let ex_coro = typemap_get(view((*thir_ptr).interner.map), view(*t));
                        if (ex_coro as usize) == 0 {
                            typemap_insert(mut_view((*thir_ptr).interner.map), t, (TypeId { v: (i + 1) as u32 }));
                        }
                    }
                }
            }
            i = i + 1;
        }

        i = 0;
        while i < ilen {
            let tid = TypeId { v: (i + 1) as u32 };
            let t = type_get(view((*thir_ptr).interner), tid);
            if (t as usize) != 0 {
                let k = (*t).kind;
                if k == TY_VIEW || k == TY_MUT_VIEW {
                    let pt_id = (*t).pointee;
                    let pt = type_get(view((*thir_ptr).interner), pt_id);
                    if (pt as usize) != 0 && (*pt).kind == TY_ARRAY {
                        let alen = (*pt).array_len;
                        let elem_v = (*pt).elem.v;
                        let mut m: usize = 0;
                        while m < ilen {
                            let mt = type_get(view((*thir_ptr).interner), TypeId { v: (m + 1) as u32 });
                            if (mt as usize) != 0 && (*mt).kind == TY_ARRAY && (*mt).array_len == alen && (*mt).elem.v == elem_v {
                                (*t).pointee.v = (m + 1) as u32;
                                break;
                            }
                            m = m + 1;
                        }
                    }
                } else if k == TY_STRUCT && (*t).arg_count == 0 && (*t).field_count > 0 {
                    let fc = (*t).field_count;
                    let fptr = (*t).fields;
                    let mut j: usize = 0;
                    while j < fc {
                        let fp = typeid_at(fptr, j);
                        let ft = type_get(view((*thir_ptr).interner), TypeId { v: (*fp).v });
                        if (ft as usize) != 0 && (*ft).kind == TY_TUPLE {
                            let tfc = (*ft).field_count;
                            let tfptr = (*ft).fields;
                            let mut m: usize = (*fp).v as usize;
                            while m < ilen {
                                let mt = type_get(view((*thir_ptr).interner), TypeId { v: (m + 1) as u32 });
                                if (mt as usize) != 0 && (*mt).kind == TY_TUPLE && (*mt).field_count == tfc {
                                    let mfptr = (*mt).fields;
                                    let mut all_eq = true;
                                    let mut ti: usize = 0;
                                    while ti < tfc {
                                        if (*typeid_at(tfptr, ti)).v != (*typeid_at(mfptr, ti)).v {
                                            all_eq = false;
                                            break;
                                        }
                                        ti = ti + 1;
                                    }
                                    if all_eq {
                                        (*fp).v = (m + 1) as u32;
                                    }
                                }
                                m = m + 1;
                            }
                        }
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        }
    }
}

