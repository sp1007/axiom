@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

// Zero-filled arena allocation: synthesized MIR records are only partially initialized below.
fn al_alloc_z(a: mut_view<Arena>, size: usize, align: usize) -> *mut u8 {
    let p = arena_alloc_raw(mut_view(*a), size, align);
    let mut i: usize = 0;
    while i < size {
        unsafe { *(p + i) = 0u8; }
        i = i + 1;
    }
    p
}

unsafe fn u8_at(base: *mut u8, idx: usize) -> *mut u8 {
    let off = idx;
    ((base as usize) + off) as *mut u8
}

pub const STATE_UNPOLLED: u32 = 0u32;
pub const STATE_COMPLETED: u32 = 0xFFFFFFFFu32;
pub const STATE_PANICKED: u32 = 0xFFFFFFFEu32;
pub const STATE_CANCELLED: u32 = 0xFFFFFFFEu32;

