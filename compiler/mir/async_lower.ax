    pub bb_idx: usize,
    pub sp_id: u32,
    pub fut_place: MirPlace,
    pub dest_place: MirPlace,
    pub resume_bb: usize,
    pub cleanup_bb: usize,
    pub fut_ty: TypeId,
    pub dest_ty: TypeId,
    pub span: Span,
    pub live_locals: *mut u32,
    pub live_count: usize,
}

