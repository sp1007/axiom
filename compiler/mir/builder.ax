                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), unsafe {
                (*expr).elems
            }, mut_view(elem_op));
            let mut cnt_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), count_expr, mut_view(cnt_op));
            let cnt_op_ptr = unsafe {
                arena_alloc_raw(mut_view(*b.arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand
            };
            unsafe {
                mir_copy_operand(mut_view(*cnt_op_ptr), view(cnt_op));
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_REPEAT;
            mir_copy_operand(mut_view(rv.use_op), view(elem_op));
            rv.repeat_count = mb_eval_const_int_expr(view(*b), count_expr);
            rv.repeat_count_op = cnt_op_ptr;
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        } else {
            let mut cnt: usize = 0;
            let mut el: *mut HirExpr = unsafe {
                (*expr).elems
            };
            while ((el as usize) != 0) {
                cnt = cnt + 1;
                el = unsafe {
                    (*el).next
                };
            }
            let mut ops: *mut MirOperand = 0 as *mut MirOperand;
            if cnt > 0 {
                let bytes = mir_mul_usize(cnt, size_of<MirOperand>());
                ops = unsafe {
                    arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
                };
                let mut i: usize = 0;
                el = unsafe {
                    (*expr).elems
                };
                while ((el as usize) != 0) {
                    let mut op_i = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), el, mut_view(op_i));
                    let dst_op = unsafe {
                        mir_op_at(ops, i)
                    };
                    unsafe {
                        mir_copy_operand(mut_view(*dst_op), view(op_i));
                    }
                    i = i + 1;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_AGGREGATE;
            rv.variant_idx = 0u32;
            rv.operands = ops;
            rv.operand_count = cnt;
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        }
        return;
    }

    if ek == HIR_EXPR_STRUCT {
        let ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: e_ty.v
            }))
        };
        let mut is_enum_struct = false;
        let mut v_idx: u32 = 0u32;
        let mut f_count: usize = 0;
        let mut def_item: *mut HirItem = 0 as *mut HirItem;
        if (ax as usize) != 0 {
            def_item = unsafe {
                ((*ax).def) as *mut HirItem
            };
            if (unsafe { (*ax).kind }) == TY_ENUM {
                is_enum_struct = true;
                let vp2 = unsafe {
                    thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
                };
                if (vp2 as usize) != 0 {
                    v_idx = unsafe {
                        *vp2
                    };
                }
                if (v_idx as usize) < (unsafe { (*ax).variant_count }) && (unsafe { (*ax).variant_field_counts as usize }) != 0 {
                    f_count = unsafe {
                        *usize_at((*ax).variant_field_counts, v_idx as usize)
                    };
                }
            } else if (unsafe { (*ax).kind }) == TY_STRUCT {
                f_count = unsafe {
                    (*ax).field_count
                };
            }
        }
        if f_count == 0 {
            let mut fi: *mut HirFieldInit = unsafe {
                (*expr).fields
            };
            while ((fi as usize) != 0) {
                f_count = f_count + 1;
                fi = unsafe {
                    (*fi).next
                };
            }
        }
        let mut ops: *mut MirOperand = 0 as *mut MirOperand;
        if f_count > 0 {
            let bytes = mir_mul_usize(f_count, size_of<MirOperand>());
            ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut i: usize = 0;
            while (i < f_count) {
                let dst_op = unsafe {
                    mir_op_at(ops, i)
                };
                unsafe {
                    *dst_op = MirOperand {
                        kind: MIR_OP_CONST, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                }
                i = i + 1;
            }
            let mut fi: *mut HirFieldInit = unsafe {
                (*expr).fields
            };
            let mut pos_idx: usize = 0;
            while ((fi as usize) != 0) {
                let fi_sp = Span {
                    file: FileId { v: unsafe { (*fi).span.file.v } },
                    start: unsafe { (*fi).span.start },
                    end: unsafe { (*fi).span.end },
                };
                let fi_name = StrId {
                    v: unsafe {
                        (*fi).name.v
                    }
                };
                let mut target_idx: usize = pos_idx;
                if (def_item as usize) != 0 {
                    if is_enum_struct {
                        target_idx = mb_find_enum_variant_field_index(view(*b), def_item, v_idx, (StrId {
                            v: fi_name.v
                        }), view(fi_sp)) as usize;
                    } else {
                        target_idx = mb_find_struct_field_index(view(*b), def_item, (StrId {
                            v: fi_name.v
                        }), view(fi_sp)) as usize;
                    }
                }
                if target_idx >= f_count {
                    target_idx = pos_idx;
                }
                if target_idx < f_count {
                    let mut op_f = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), unsafe {
                        (*fi).expr
                    }, mut_view(op_f));
                    let dst_op = unsafe {
                        mir_op_at(ops, target_idx)
                    };
                    unsafe {
                        mir_copy_operand(mut_view(*dst_op), view(op_f));
                    }
                }
                pos_idx = pos_idx + 1;
                fi = unsafe {
                    (*fi).next
                };
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = v_idx;
        rv.operands = ops;
        rv.operand_count = f_count;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    mb_build_control_or_call_expr(mut_view(*b), expr, mut_view(*dest), has_dest);
}
fn mb_build_control_or_call_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);

    if ek == HIR_EXPR_CALL {
        let callee_expr: *mut HirExpr = unsafe {
            (*expr).callee
        };
        if (callee_expr as usize) != 0 && (unsafe { (*callee_expr).kind }) == HIR_EXPR_PATH {
            let c_ty = mb_expr_ty(mut_view(*b), callee_expr);
            let ct = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: c_ty.v
                }))
            };
            if (ct as usize) != 0 {
                let ck = unsafe {
                    (*ct).kind
                };
                if ck == TY_BUILTIN_DROP {
                    let arg0: *mut HirExpr = unsafe {
                        (*expr).args
                    };
                    let mut arg_op = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(arg_op));
                    let mut arg_pl = mir_local_place(0u32);
                    if arg_op.kind == MIR_OP_COPY || arg_op.kind == MIR_OP_MOVE {
                        mir_copy_place(mut_view(arg_pl), view(arg_op.place));
                    } else {
                        let arg_ty = mb_expr_ty(mut_view(*b), arg0);
                        let temp = mb_new_temp(mut_view(*b), (TypeId {
                            v: arg_ty.v
                        }), view(sp));
                        arg_pl = mir_local_place(temp.v);
                        mb_emit_assign_use(mut_view(*b), view(arg_pl), view(arg_op), view(sp));
                    }
                    let next_bb = mb_new_bb(mut_view(*b), false);
                    let bb = unsafe {
                        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                    };
                    unsafe {
                        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_DROP);
                        (*bb).terminator.span.file.v = sp.file.v;
                        (*bb).terminator.span.start = sp.start;
                        (*bb).terminator.span.end = sp.end;
                        mir_copy_place(mut_view((*bb).terminator.drop_place), view(arg_pl));
                        (*bb).terminator.drop_target.v = next_bb.v;
                        (*bb).terminator.drop_unwind.v = 0u32;
                        (*bb).terminator.drop_is_explicit = true;
                        (*bb).has_terminator = true;
                    }
                    b.curr_bb.v = next_bb.v;
                    b.is_diverged = false;
                    if has_dest {
                        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                        rv.kind = MIR_RVALUE_AGGREGATE;
                        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
                    }
                    return;
                }
                if ck == TY_BUILTIN_LEN {
                    let arg0: *mut HirExpr = unsafe {
                        (*expr).args
                    };
                    let mut arg_op = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(arg_op));
                    let mut arg_pl = mir_local_place(0u32);
                    if arg_op.kind == MIR_OP_COPY || arg_op.kind == MIR_OP_MOVE {
                        mir_copy_place(mut_view(arg_pl), view(arg_op.place));
                    } else {
                        let arg_ty = mb_expr_ty(mut_view(*b), arg0);
                        let temp = mb_new_temp(mut_view(*b), (TypeId {
                            v: arg_ty.v
                        }), view(sp));
                        arg_pl = mir_local_place(temp.v);
                        mb_emit_assign_use(mut_view(*b), view(arg_pl), view(arg_op), view(sp));
                    }
                    let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
