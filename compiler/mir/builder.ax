        }
        let has_self: bool = if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).kind }) == TY_FN {
            (explicit_args + 1) == (unsafe { (*fn_ax).param_count })
        } else {
            true
        };
        let total_args = explicit_args + (if has_self {
            1
        } else {
            0
        });
        let mut args_arr: *mut MirOperand = 0 as *mut MirOperand;
        if total_args > 0 {
            let bytes = mir_mul_usize(total_args, size_of<MirOperand>());
            args_arr = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut idx: usize = 0;
            if has_self {
                let recv: *mut HirExpr = unsafe {
                    (*expr).receiver
                };
                let recv_ty = mb_expr_ty(mut_view(*b), recv);
                let recv_ax = unsafe {
                    type_get(view((*b.thir).interner), (TypeId {
                        v: recv_ty.v
                    }))
                };
                let mut need_auto_ref = false;
                let mut is_mut_ref = false;
                let mut self_ty = (TypeId {
                    v: recv_ty.v
                });
                if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).param_count }) > 0 {
                    let p0_ptr = unsafe {
                        typeid_at((*fn_ax).param_types, 0)
                    };
                    self_ty = mb_resolve_ty(mut_view(*b), TypeId {
                        v: unsafe {
                            (*p0_ptr).v
                        }
                    });
                    let self_ax = unsafe {
                        type_get(view((*b.thir).interner), (TypeId {
                            v: self_ty.v
                        }))
                    };
                    if (self_ax as usize) != 0 && ((unsafe { (*self_ax).kind }) == TY_VIEW || (unsafe { (*self_ax).kind }) == TY_MUT_VIEW) {
                        if (recv_ax as usize) != 0 && (unsafe { (*recv_ax).kind }) != TY_VIEW && (unsafe { (*recv_ax).kind }) != TY_MUT_VIEW {
                            need_auto_ref = true;
                            is_mut_ref = (unsafe {
                                (*self_ax).kind
                            }) == TY_MUT_VIEW;
                        }
                    }
                }
                let dst0 = unsafe {
                    mir_op_at(args_arr, 0)
                };
                if need_auto_ref {
                    let mut dummy_sl = false;
                    let recv_pl = mir_build_lvalue(mut_view(*b), recv, mut_view(dummy_sl));
                    let tmp = mb_new_temp(mut_view(*b), self_ty, view(sp));
                    let tmp_pl = mir_local_place(tmp.v);
                    let mut ref_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                    ref_rv.kind = MIR_RVALUE_REF;
                    ref_rv.borrow_kind = if is_mut_ref {
                        MIR_BORROW_MUT
                    } else {
                        MIR_BORROW_SHARED
                    };
                    mir_copy_place(mut_view(ref_rv.place), view(recv_pl));
                    mb_emit_assign(mut_view(*b), view(tmp_pl), view(ref_rv), view(sp));
                    unsafe {
                        *dst0 = MirOperand {
                            kind: MIR_OP_MOVE, location: Span {
                                file: FileId {
                                    v: 0u32
                                }, start: 0u32, end: 0u32
                            }, place: MirPlace {
                                local: MirLocalId {
                                    v: tmp.v
                                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                            }, constant: MirConst {
                                ty: TypeId {
                                    v: 0u32
                                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                    v: 0u32
                                }
                            }
                        };
                    }
                } else {
                    let mut op0 = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), recv, mut_view(op0));
                    unsafe {
                        mir_copy_operand(mut_view(*dst0), view(op0));
                    }
                }
                idx = 1;
            }
            cur_a = unsafe {
                (*expr).args
            };
            while ((cur_a as usize) != 0) {
                let mut op_a = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_build_expr_as_operand(mut_view(*b), cur_a, mut_view(op_a));
                let dst_op = unsafe {
                    mir_op_at(args_arr, idx)
                };
                unsafe {
                    mir_copy_operand(mut_view(*dst_op), view(op_a));
                }
                idx = idx + 1;
                cur_a = unsafe {
                    (*cur_a).next
                };
            }
        }
        mb_consume_op(mut_view(*b), view(callee_op));
        let mut mci: usize = 0;
        while (mci < total_args) {
            let op_mci = unsafe {
                mir_op_at(args_arr, mci)
            };
            unsafe {
                mb_consume_op(mut_view(*b), view(*op_mci));
            }
            mci = mci + 1;
        }
        let next_bb = mb_new_bb(mut_view(*b), false);
        let bb = unsafe {
            mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_CALL);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            mir_copy_operand(mut_view((*bb).terminator.func), view(callee_op));
            (*bb).terminator.args = args_arr;
            (*bb).terminator.arg_count = total_args;
            mir_copy_place(mut_view((*bb).terminator.destination), view(*dest));
            (*bb).terminator.has_destination = has_dest;
            (*bb).terminator.call_target.v = next_bb.v;
            (*bb).terminator.call_unwind.v = 0u32;
            (*bb).has_terminator = true;
        }
        b.curr_bb.v = next_bb.v;
        b.is_diverged = false;
        return;
    }

    if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_COMPTIME {
        mir_build_block(mut_view(*b), unsafe {
            (*expr).block
        }, mut_view(*dest), has_dest);
        return;
    }

    if ek == HIR_EXPR_IF {
        let let_pat: *mut HirPat = unsafe {
            (*expr).let_pat
        };
        if (let_pat as usize) != 0 {
            let scrut_expr: *mut HirExpr = unsafe {
                (*expr).cond
            };
            let scrut_ty = mb_expr_ty(mut_view(*b), scrut_expr);
            let scrut_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: scrut_ty.v
            }), view(sp));
            let mut scrut_pl = mir_local_place(scrut_loc.v);
            mir_build_expr(mut_view(*b), scrut_expr, mut_view(scrut_pl), true);
            let bb_else = mb_new_bb(mut_view(*b), false);
            let bb_end = mb_new_bb(mut_view(*b), false);
            mb_build_pat_match_in_place(mut_view(*b), let_pat, view(scrut_pl), (TypeId {
                v: scrut_ty.v
            }), (MirBbId {
                v: bb_else.v
            }));
            mir_build_block(mut_view(*b), unsafe {
                (*expr).block
            }, mut_view(*dest), has_dest);
            let then_diverged = b.is_diverged;
            if !b.is_diverged {
                mb_terminate_goto(mut_view(*b), (MirBbId {
                    v: bb_end.v
                }), view(sp));
            }
            b.curr_bb.v = bb_else.v;
            b.is_diverged = false;
            let else_br: *mut HirExpr = unsafe {
                (*expr).else_branch
            };
            if (else_br as usize) != 0 {
                mir_build_expr(mut_view(*b), else_br, mut_view(*dest), has_dest);
            }
            let else_diverged = b.is_diverged;
            if !b.is_diverged {
                mb_terminate_goto(mut_view(*b), (MirBbId {
                    v: bb_end.v
                }), view(sp));
            }
            b.curr_bb.v = bb_end.v;
            b.is_diverged = then_diverged && else_diverged;
            return;
        }

        let mut cond_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), unsafe {
            (*expr).cond
        }, mut_view(cond_op));
        let bb_then = mb_new_bb(mut_view(*b), false);
        let bb_else = mb_new_bb(mut_view(*b), false);
        let bb_end = mb_new_bb(mut_view(*b), false);
        mb_emit_switch_single(mut_view(*b), view(cond_op), 0u64, (MirBbId {
            v: bb_else.v
        }), (MirBbId {
            v: bb_then.v
        }), view(sp));

        b.curr_bb.v = bb_then.v;
        b.is_diverged = false;
        mir_build_block(mut_view(*b), unsafe {
            (*expr).block
        }, mut_view(*dest), has_dest);
        let then_diverged = b.is_diverged;
        if !b.is_diverged {
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: bb_end.v
            }), view(sp));
        }

        b.curr_bb.v = bb_else.v;
        b.is_diverged = false;
        let else_br: *mut HirExpr = unsafe {
            (*expr).else_branch
        };
        if (else_br as usize) != 0 {
            mir_build_expr(mut_view(*b), else_br, mut_view(*dest), has_dest);
        }
        let else_diverged = b.is_diverged;
        if !b.is_diverged {
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: bb_end.v
            }), view(sp));
        }

        b.curr_bb.v = bb_end.v;
        b.is_diverged = then_diverged && else_diverged;
        return;
    }

    mb_build_match_loop_jump_try_closure_expr(mut_view(*b), expr, mut_view(*dest), has_dest);
}
fn mb_build_match_loop_jump_try_closure_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);

    if ek == HIR_EXPR_MATCH {
        let scrut_expr: *mut HirExpr = unsafe {
            (*expr).cond
        };
        let scrut_ty = mb_expr_ty(mut_view(*b), scrut_expr);
        let scrut_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: scrut_ty.v
        }), view(sp));
        let mut scrut_pl = mir_local_place(scrut_loc.v);
        mir_build_expr(mut_view(*b), scrut_expr, mut_view(scrut_pl), true);

        let bb_end = mb_new_bb(mut_view(*b), false);
        let mut any_arm_reached_end = false;
        let mut arm: *mut HirMatchArm = unsafe {
            (*expr).arms
        };
        while ((arm as usize) != 0) {
            let next_arm: *mut HirMatchArm = unsafe {
                (*arm).next
            };
            let bb_next_arm = mb_new_bb(mut_view(*b), false);
            if (next_arm as usize) == 0 {
                let unreach_bb = unsafe {
                    mir_bb_at((*b.body).bbs, bb_next_arm.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*unreach_bb).terminator), MIR_TERM_UNREACHABLE);
                    (*unreach_bb).terminator.span.file.v = sp.file.v;
                    (*unreach_bb).terminator.span.start = sp.start;
                    (*unreach_bb).terminator.span.end = sp.end;
                    (*unreach_bb).has_terminator = true;
                }
            }
            mb_build_pat_match_in_place(mut_view(*b), unsafe {
                (*arm).pat
            }, view(scrut_pl), (TypeId {
                v: scrut_ty.v
            }), (MirBbId {
                v: bb_next_arm.v
            }));

            let guard: *mut HirExpr = unsafe {
                (*arm).guard
            };
            if (guard as usize) != 0 {
                let mut g_op = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_build_expr_as_operand(mut_view(*b), guard, mut_view(g_op));
                let bb_guard_ok = mb_new_bb(mut_view(*b), false);
                mb_emit_switch_single(mut_view(*b), view(g_op), 0u64, (MirBbId {
                    v: bb_next_arm.v
                }), (MirBbId {
                    v: bb_guard_ok.v
                }), view(sp));
                b.curr_bb.v = bb_guard_ok.v;
                b.is_diverged = false;
            }

            mir_build_expr(mut_view(*b), unsafe {
                (*arm).body
            }, mut_view(*dest), has_dest);
            if !b.is_diverged {
                any_arm_reached_end = true;
                mb_terminate_goto(mut_view(*b), (MirBbId {
                    v: bb_end.v
                }), view(sp));
            }

            b.curr_bb.v = bb_next_arm.v;
            b.is_diverged = false;
            arm = next_arm;
        }
        b.curr_bb.v = bb_end.v;
        b.is_diverged = !any_arm_reached_end;
        return;
    }

    if ek == HIR_EXPR_LOOP {
        let loop_bb = mb_new_bb(mut_view(*b), false);
        let exit_bb = mb_new_bb(mut_view(*b), false);
        mb_terminate_goto(mut_view(*b), (MirBbId {
            v: loop_bb.v
        }), view(sp));
        b.curr_bb.v = loop_bb.v;
        b.is_diverged = false;

        mb_push_loop(mut_view(*b), StrId {
            v: unsafe {
                (*expr).label.v
            }
        }, (MirBbId {
            v: exit_bb.v
        }), (MirBbId {
            v: loop_bb.v
        }), view(*dest), has_dest);
        mir_build_block(mut_view(*b), unsafe {
            (*expr).block
        }, mut_view(*dest), has_dest);
        if !b.is_diverged {
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: loop_bb.v
            }), view(sp));
        }
        b.loop_depth = b.loop_depth - 1;
        b.curr_bb.v = exit_bb.v;
        b.is_diverged = false;
        return;
    }

    if ek == HIR_EXPR_WHILE {
        let cond_bb = mb_new_bb(mut_view(*b), false);
        let body_bb = mb_new_bb(mut_view(*b), false);
        let exit_bb = mb_new_bb(mut_view(*b), false);
        mb_terminate_goto(mut_view(*b), (MirBbId {
            v: cond_bb.v
        }), view(sp));

        b.curr_bb.v = cond_bb.v;
        b.is_diverged = false;
        let let_pat: *mut HirPat = unsafe {
            (*expr).let_pat
        };
        if (let_pat as usize) != 0 {
            let scrut_expr: *mut HirExpr = unsafe {
                (*expr).cond
            };
            let scrut_ty = mb_expr_ty(mut_view(*b), scrut_expr);
            let scrut_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: scrut_ty.v
            }), view(sp));
            let mut scrut_pl = mir_local_place(scrut_loc.v);
            mir_build_expr(mut_view(*b), scrut_expr, mut_view(scrut_pl), true);
            mb_build_pat_match_in_place(mut_view(*b), let_pat, view(scrut_pl), (TypeId {
                v: scrut_ty.v
            }), (MirBbId {
                v: exit_bb.v
            }));
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: body_bb.v
            }), view(sp));
        } else {
            let mut cond_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), unsafe {
                (*expr).cond
            }, mut_view(cond_op));
            mb_emit_switch_single(mut_view(*b), view(cond_op), 1u64, (MirBbId {
                v: body_bb.v
            }), (MirBbId {
                v: exit_bb.v
            }), view(sp));
        }

        b.curr_bb.v = body_bb.v;
        b.is_diverged = false;
        mb_push_loop(mut_view(*b), StrId {
            v: unsafe {
                (*expr).label.v
            }
        }, (MirBbId {
            v: exit_bb.v
        }), (MirBbId {
            v: cond_bb.v
        }), view(*dest), has_dest);
        mir_build_block(mut_view(*b), unsafe {
            (*expr).block
        }, mut_view(*dest), has_dest);
        if !b.is_diverged {
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: cond_bb.v
            }), view(sp));
        }
        b.loop_depth = b.loop_depth - 1;
        b.curr_bb.v = exit_bb.v;
        b.is_diverged = false;
        return;
    }

    if ek == HIR_EXPR_JUMP {
        let jk = unsafe {
            (*expr).jump_kind
        };
        if jk == JUMP_RETURN {
            let inner: *mut HirExpr = unsafe {
                (*expr).inner
            };
            if (inner as usize) != 0 {
                let mut ret_pl = mir_local_place(0u32);
                mir_build_expr(mut_view(*b), inner, mut_view(ret_pl), true);
            }
            if !b.is_diverged {
                mb_build_drop_chain(mut_view(*b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
                    v: 0u32
                }, view(sp));
                let bb = unsafe {
                    mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
                    (*bb).terminator.span.file.v = sp.file.v;
                    (*bb).terminator.span.start = sp.start;
                    (*bb).terminator.span.end = sp.end;
                    (*bb).has_terminator = true;
                }
                b.is_diverged = true;
            }
        } else if jk == JUMP_BREAK {
            let ls = mb_find_loop(view(*b), StrId {
                v: unsafe {
                    (*expr).label.v
                }
            });
            if (ls as usize) != 0 {
                let inner: *mut HirExpr = unsafe {
                    (*expr).inner
                };
                let b_bb = MirBbId {
                    v: unsafe {
                        (*ls).break_bb.v
                    }
                };
                let d_scope = unsafe {
                    (*ls).drop_scope
                };
                if (inner as usize) != 0 {
                    let mut d_pl = mir_local_place(0u32);
                    unsafe {
                        mir_copy_place(mut_view(d_pl), view((*ls).dest));
                    }
                    mir_build_expr(mut_view(*b), inner, mut_view(d_pl), true);
                }
                if !b.is_diverged {
                    mb_build_drop_chain(mut_view(*b), b.current_drops, d_scope, (MirBbId {
                        v: b_bb.v
                    }), view(sp));
                }
            }
        } else if jk == JUMP_CONTINUE {
            let ls = mb_find_loop(view(*b), StrId {
                v: unsafe {
                    (*expr).label.v
                }
            });
            if (ls as usize) != 0 {
                let c_bb = MirBbId {
                    v: unsafe {
                        (*ls).continue_bb.v
                    }
                };
                let d_scope = unsafe {
                    (*ls).drop_scope
                };
                if !b.is_diverged {
                    mb_build_drop_chain(mut_view(*b), b.current_drops, d_scope, (MirBbId {
                        v: c_bb.v
                    }), view(sp));
                }
            }
        }
        return;
    }

    if ek == HIR_EXPR_TRY {
        let inner: *mut HirExpr = unsafe {
            (*expr).inner
        };
        let inner_ty = mb_expr_ty(mut_view(*b), inner);
        let expr_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: inner_ty.v
        }), view(sp));
        let mut expr_pl = mir_local_place(expr_loc.v);
        mir_build_expr(mut_view(*b), inner, mut_view(expr_pl), true);

        let mut is_opt = false;
        let mut payload_idx: u32 = 0u32;
        let mut err_idx: u32 = 1u32;
        let tinfo = unsafe {
            ptr_trymap_get(view((*b.thir).expr_try_info), expr as usize)
        };
        if (tinfo as usize) != 0 {
            is_opt = unsafe {
                (*tinfo).is_opt
            };
            payload_idx = unsafe {
                (*tinfo).payload_idx as u32
            };
            err_idx = unsafe {
                (*tinfo).err_idx as u32
            };
        }

        let u32_ty = TypeId {
            v: unsafe {
                (*b.thir).interner.t_u32.v
            }
        };
        let discr_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: u32_ty.v
        }), view(sp));
        let discr_pl = mir_local_place(discr_loc.v);
        let mut discr_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
