                }
            }

            let sym_intr = SymbolId {
                v: unsafe { (*callee_expr).path.symbol.v }
            };
            let mut fn_item_intr: *mut HirItem = 0 as *mut HirItem;
            if sym_intr.v != 0u32 {
                fn_item_intr = mb_find_item_by_sym(b.hir, sym_intr);
            }
            if (fn_item_intr as usize) == 0 {
                let mut p_sv = StrView { ptr: 0 as *const u8, len: 0 };
                let pnv = unsafe { (*callee_expr).path.name.v };
                if pnv != 0u32 && (b.str_in as usize) != 0 {
                    p_sv = unsafe { interner_get(view(*b.str_in), StrId { v: pnv }) };
                } else {
                    let csp = Span {
                        file: FileId { v: unsafe { (*callee_expr).span.file.v } },
                        start: unsafe { (*callee_expr).span.start },
                        end: unsafe { (*callee_expr).span.end },
                    };
                    p_sv = mb_span_sv(view(*b), view(csp));
                }
                fn_item_intr = mb_find_item_by_path_sv(view(*b), view(p_sv));
            }
            let intr_term_kind = mb_item_term_intrinsic_kind(b.str_in, b.db, fn_item_intr);
            if intr_term_kind != 0u8 {
                let mut argc: usize = 0;
                let mut cur_a: *mut HirExpr = unsafe { (*expr).args };
                while (cur_a as usize) != 0 {
                    argc = argc + 1;
                    cur_a = unsafe { (*cur_a).next };
                }
                let ok_args = if intr_term_kind == 1u8 {
                    argc == 1
                } else if intr_term_kind == 3u8 {
                    argc == 0
                } else {
                    argc <= 1
                };
                if ok_args {
                    let arg0: *mut HirExpr = unsafe { (*expr).args };
                    let mut arg_op = MirOperand {
                        kind: MIR_OP_COPY,
                        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
                        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
                    };
                    if argc == 1 {
                        mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(arg_op));
                    }
                    let t_bool_v = unsafe { (*b.thir).interner.t_bool.v };
                    let c_loc = mb_new_temp(mut_view(*b), (TypeId { v: t_bool_v }), view(sp));
                    let c_pl = mir_local_place(c_loc.v);
                    if intr_term_kind == 1u8 {
                        mb_emit_assign_use(mut_view(*b), view(c_pl), view(arg_op), view(sp));
                        let c_copy_op = MirOperand {
                            kind: MIR_OP_COPY,
                            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                            place: MirPlace { local: MirLocalId { v: c_loc.v }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
                            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
                        };
                        mb_emit_assert(mut_view(*b), view(c_copy_op), true, MB_ASSERT_MSG_ASSERT, view(sp));
                        if has_dest {
                            let mut rv = MirRvalue {
                                kind: MIR_RVALUE_AGGREGATE,
                                use_op: MirOperand {
                                    kind: MIR_OP_COPY,
                                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                                    place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
                                    constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
                                },
