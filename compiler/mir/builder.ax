@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct MirSymLocalMapEntry {
    pub sym: SymbolId,
    pub local: MirLocalId,
    pub is_slice_len: bool,
}

pub struct MirDropNode {
    pub place: MirPlace,
    pub span: Span,
    pub is_temp: bool,
    pub next: *mut MirDropNode,
}

pub struct MirDeferScope {
    pub locals: *mut MirLocalId,
    pub local_count: usize,
    pub local_cap: usize,
    pub defers: *mut *mut HirExpr,
    pub defer_count: usize,
    pub defer_cap: usize,
}

pub struct MirLoopScope {
    pub label: StrId,
    pub break_bb: MirBbId,
    pub continue_bb: MirBbId,
    pub dest: MirPlace,
    pub has_dest: bool,
    pub scope_depth: usize,
    pub drop_scope: *mut MirDropNode,
}

pub struct MirClosureBodyEntry {
    pub sym: SymbolId,
    pub closure_id: u32,
    pub body: *mut MirBody,
    pub next: *mut MirClosureBodyEntry,
}

pub struct MirBuilder {
    pub arena: *mut Arena,
    pub thir: *mut Thir,
    pub hir: *const HirFile,
    pub str_in: *mut StrInterner,
    pub db: *const SourceDatabase,
    pub mono: *mut MonoEngine,
    pub subst_args: GenericArgsSlice,
    pub body: *mut MirBody,
    pub curr_bb: MirBbId,
    pub sym_map: *mut MirSymLocalMapEntry,
    pub sym_map_count: usize,
    pub sym_map_cap: usize,
    pub loop_stack: *mut MirLoopScope,
    pub loop_depth: usize,
    pub loop_cap: usize,
    pub scopes: *mut MirDeferScope,
    pub scope_depth: usize,
    pub scope_cap: usize,
    pub current_drops: *mut MirDropNode,
    pub is_diverged: bool,
    pub unwind_bb: MirBbId,
    pub has_unwind_bb: bool,
    pub closure_env_local: MirLocalId,
    pub closure_captures: *const ClosureCapture,
    pub closure_capture_count: usize,
    pub closure_head: *mut MirClosureBodyEntry,
    pub closure_tail: *mut MirClosureBodyEntry,
    // T161: the impl whose instance of a trait default method is being built (null otherwise).
    pub self_impl: *const HirItem,
}

unsafe fn mb_sym_entry_at(base: *mut MirSymLocalMapEntry, idx: usize) -> *mut MirSymLocalMapEntry {
    let off = ((idx as isize) * (size_of<MirSymLocalMapEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut MirSymLocalMapEntry
}

unsafe fn mb_local_id_at(base: *mut MirLocalId, idx: usize) -> *mut MirLocalId {
    let off = ((idx as isize) * (size_of<MirLocalId>() as isize)) as usize;
    ((base as usize) + off) as *mut MirLocalId
}

unsafe fn mb_expr_ptr_at(base: *mut *mut HirExpr, idx: usize) -> *mut *mut HirExpr {
    let off = ((idx as isize) * (size_of<*mut HirExpr>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut HirExpr
}

unsafe fn mb_defer_scope_at(base: *mut MirDeferScope, idx: usize) -> *mut MirDeferScope {
    let off = ((idx as isize) * (size_of<MirDeferScope>() as isize)) as usize;
    ((base as usize) + off) as *mut MirDeferScope
}

unsafe fn mb_loop_scope_at(base: *mut MirLoopScope, idx: usize) -> *mut MirLoopScope {
    let off = ((idx as isize) * (size_of<MirLoopScope>() as isize)) as usize;
    ((base as usize) + off) as *mut MirLoopScope
}

