        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_DISCRIMINANT;
            mir_copy_place(mut_view(rv.place), scrutinee);
            mb_emit_assign(mut_view(*b), view(discr_pl), view(rv), view(sp));

            let bb_succ = mb_new_bb(mut_view(*b), false);
            let discr_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: discr_loc.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_switch_single(mut_view(*b), view(discr_op), v_idx as u64, (MirBbId {
                v: bb_succ.v
            }), (MirBbId {
                v: on_fail.v
            }), view(sp));
            b.curr_bb.v = bb_succ.v;
            b.is_diverged = false;

            if pk == HIR_PAT_STRUCT {
                let down_pl = mb_append_proj_downcast(mut_view(*b), scrutinee, v_idx);
                let mut pf: *mut HirPatField = unsafe {
                    (*pat).fields
                };
                while ((pf as usize) != 0) {
                    let pf_sp = Span {
                        file: FileId { v: unsafe { (*pf).span.file.v } },
                        start: unsafe { (*pf).span.start },
                        end: unsafe { (*pf).span.end },
                    };
                    let f_idx = mb_find_enum_variant_field_index(view(*b), def_item, v_idx, StrId {
                        v: unsafe {
                            (*pf).name.v
                        }
                    }, view(pf_sp));
                    let f_pl = mb_append_proj_field(mut_view(*b), view(down_pl), f_idx);
                    let f_ty = mb_pat_ty(mut_view(*b), unsafe {
                        (*pf).pat
                    });
                    mb_build_pat_match_in_place(mut_view(*b), unsafe {
                        (*pf).pat
                    }, view(f_pl), (TypeId {
                        v: f_ty.v
                    }), (MirBbId {
                        v: on_fail.v
                    }));
                    pf = unsafe {
                        (*pf).next
                    };
                }
            } else if pk == HIR_PAT_PATH {
                let payload_head: *mut HirPat = unsafe {
                    (*pat).payload
                };
                if (payload_head as usize) != 0 {
                    let down_pl = mb_append_proj_downcast(mut_view(*b), scrutinee, v_idx);
                    let mut el: *mut HirPat = if (unsafe { (*payload_head).kind }) == HIR_PAT_TUPLE && (unsafe { (*payload_head).elems as usize }) != 0 {
                        unsafe { (*payload_head).elems }
                    } else {
                        payload_head
                    };
                    let mut idx: u32 = 0u32;
                    while ((el as usize) != 0) {
                        let f_pl = mb_append_proj_field(mut_view(*b), view(down_pl), idx);
                        let f_ty = mb_pat_ty(mut_view(*b), el);
                        mb_build_pat_match_in_place(mut_view(*b), el, view(f_pl), (TypeId {
                            v: f_ty.v
                        }), (MirBbId {
                            v: on_fail.v
                        }));
                        idx = idx + 1u32;
                        el = unsafe {
                            (*el).next
                        };
                    }
                }
            }
        } else if tk == TY_STRUCT {
            if pk == HIR_PAT_STRUCT {
                let mut pf: *mut HirPatField = unsafe {
                    (*pat).fields
                };
                while ((pf as usize) != 0) {
                    let pf_sp = Span {
                        file: FileId { v: unsafe { (*pf).span.file.v } },
                        start: unsafe { (*pf).span.start },
                        end: unsafe { (*pf).span.end },
                    };
                    let f_idx = mb_find_struct_field_index(view(*b), def_item, StrId {
                        v: unsafe {
                            (*pf).name.v
                        }
                    }, view(pf_sp));
                    let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, f_idx);
                    let f_ty = mb_pat_ty(mut_view(*b), unsafe {
                        (*pf).pat
                    });
                    mb_build_pat_match_in_place(mut_view(*b), unsafe {
                        (*pf).pat
                    }, view(f_pl), (TypeId {
                        v: f_ty.v
                    }), (MirBbId {
                        v: on_fail.v
                    }));
                    pf = unsafe {
                        (*pf).next
                    };
                }
            } else if pk == HIR_PAT_TUPLE {
                let mut el: *mut HirPat = unsafe {
                    (*pat).elems
                };
                let mut idx: u32 = 0u32;
                while ((el as usize) != 0) {
                    let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, idx);
                    let f_ty = mb_pat_ty(mut_view(*b), el);
                    mb_build_pat_match_in_place(mut_view(*b), el, view(f_pl), (TypeId {
                        v: f_ty.v
                    }), (MirBbId {
                        v: on_fail.v
                    }));
                    idx = idx + 1u32;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
        } else if tk == TY_TUPLE {
            let mut el: *mut HirPat = unsafe {
                (*pat).elems
            };
            let mut idx: u32 = 0u32;
            while ((el as usize) != 0) {
                let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, idx);
                let f_ty = mb_pat_ty(mut_view(*b), el);
                mb_build_pat_match_in_place(mut_view(*b), el, view(f_pl), (TypeId {
                    v: f_ty.v
                }), (MirBbId {
                    v: on_fail.v
                }));
                idx = idx + 1u32;
                el = unsafe {
                    (*el).next
                };
            }
        }
    }
}

fn mb_build_pat_match(
    b: mut_view<MirBuilder>,
    pat: *mut HirPat,
    scrutinee: view<MirPlace>,
    scrut_ty: TypeId,
    on_match: MirBbId,
    on_fail: MirBbId
) {
    let sp = if (pat as usize) != 0 {
        Span {
            file: FileId { v: unsafe { (*pat).span.file.v } },
            start: unsafe { (*pat).span.start },
            end: unsafe { (*pat).span.end },
        }
    } else {
        Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }
    };
    mb_build_pat_match_in_place(mut_view(*b), pat, scrutinee, (TypeId {
        v: scrut_ty.v
    }), (MirBbId {
        v: on_fail.v
    }));
    mb_terminate_goto(mut_view(*b), (MirBbId {
        v: on_match.v
    }), view(sp));
}

fn mb_build_const_agg_local(
    b: mut_view<MirBuilder>,
    sym: SymbolId,
    cv_ty: TypeId,
    sp: view<Span>
) -> MirPlace {
    let loc = mb_new_local(mut_view(*b), (TypeId {
        v: cv_ty.v
    }), MIR_LOCAL_CONST, false, StrId {
        v: 0u32
    }, sp);
    let decl = unsafe {
        mir_local_at((*b.body).locals, loc.v as usize)
    };
    unsafe {
        (*decl).const_sym.v = sym.v;
    }
    mb_register_sym(mut_view(*b), (SymbolId {
        v: sym.v
    }), (MirLocalId {
        v: loc.v
    }), false);
    let init_stmt = MirStmt {
        kind: MIR_STMT_ASSIGN,
        span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(loc.v),
        rvalue: MirRvalue {
            kind: MIR_RVALUE_USE,
            use_op: MirOperand {
                kind: MIR_OP_CONST,
                location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                place: mir_local_place(0u32),
                constant: MirConst {
                    ty: TypeId { v: cv_ty.v },
                    kind: MIR_CONST_INT,
                    val: 0u64,
                    str_bytes: 0 as *const u8,
                    str_len: 0,
                    sym: SymbolId { v: 0u32 },
                },
            },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        },
        storage_local: MirLocalId { v: 0u32 },
    };
    let bb0 = unsafe {
        mir_bb_at((*b.body).bbs, 0)
    };
    unsafe {
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*b.arena), view(init_stmt));
    }
    mir_local_place(loc.v)
}

fn mb_emit_index_bounds_check(
    b: mut_view<MirBuilder>,
    base_pl: view<MirPlace>,
    ax: *mut AxType,
    idx_loc: MirLocalId,
    sp: view<Span>
) {
    let bk = unsafe {
        (*ax).kind
    };
    if bk != TY_ARRAY && bk != TY_VIEW && bk != TY_MUT_VIEW && bk != TY_SLICE && bk != TY_STR {
        return;
    }
    let usize_ty = TypeId {
        v: unsafe {
            (*b.thir).interner.t_usize.v
        }
    };
    let bool_ty = TypeId {
        v: unsafe {
            (*b.thir).interner.t_bool.v
        }
    };
    let len_loc = mb_new_temp(mut_view(*b), (TypeId {
        v: usize_ty.v
    }), sp);
    let len_pl = mir_local_place(len_loc.v);
    if bk == TY_ARRAY {
        let len_op = MirOperand {
            kind: MIR_OP_CONST,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst {
                ty: TypeId { v: usize_ty.v },
                kind: MIR_CONST_INT,
                val: unsafe { (*ax).array_len },
                str_bytes: 0 as *const u8,
                str_len: 0,
                sym: SymbolId { v: 0u32 },
            },
        };
        mb_emit_assign_use(mut_view(*b), view(len_pl), view(len_op), sp);
    } else {
        let mut len_rv = MirRvalue {
            kind: MIR_RVALUE_LEN,
            use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mir_copy_place(mut_view(len_rv.place), base_pl);
        mb_emit_assign(mut_view(*b), view(len_pl), view(len_rv), sp);
    }
    let cond_loc = mb_new_temp(mut_view(*b), (TypeId {
        v: bool_ty.v
    }), sp);
    let cond_pl = mir_local_place(cond_loc.v);
    let u_idx = mb_new_temp(mut_view(*b), (TypeId {
        v: usize_ty.v
    }), sp);
    let u_idx_pl = mir_local_place(u_idx.v);
    let idx_copy_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(idx_loc.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let cast_rv = MirRvalue {
        kind: MIR_RVALUE_CAST,
        use_op: idx_copy_op,
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: usize_ty.v },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mb_emit_assign(mut_view(*b), view(u_idx_pl), view(cast_rv), sp);

    let u_idx_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(u_idx.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let len_copy_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(len_loc.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let cmp_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_LT,
        lhs: u_idx_op,
        rhs: len_copy_op,
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mb_emit_assign(mut_view(*b), view(cond_pl), view(cmp_rv), sp);
    let cond_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(cond_loc.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mb_emit_assert(mut_view(*b), view(cond_op), true, MB_ASSERT_MSG_BOUNDS, sp);
}

fn mb_emit_u32_to_char_check(
    b: mut_view<MirBuilder>,
    op: view<MirOperand>,
    t_u32_v: u32,
    t_bool_v: u32,
    sp: view<Span>
) {
    let is_le_max = mb_new_temp(mut_view(*b), (TypeId {
        v: t_bool_v
    }), sp);
    let is_le_max_pl = mir_local_place(is_le_max.v);
    let mut le_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_LE,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_CONST, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: t_u32_v }, kind: MIR_CONST_INT, val: 0x10FFFFu64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(le_rv.lhs), op);
    mb_emit_assign(mut_view(*b), view(is_le_max_pl), view(le_rv), sp);
    let is_le_max_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(is_le_max.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mb_emit_assert(mut_view(*b), view(is_le_max_op), true, MB_ASSERT_MSG_INVALID_CHAR, sp);

    let is_lt_d800 = mb_new_temp(mut_view(*b), (TypeId {
        v: t_bool_v
    }), sp);
    let is_lt_d800_pl = mir_local_place(is_lt_d800.v);
    let mut lt_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_LT,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_CONST, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: t_u32_v }, kind: MIR_CONST_INT, val: 0xD800u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(lt_rv.lhs), op);
    mb_emit_assign(mut_view(*b), view(is_lt_d800_pl), view(lt_rv), sp);

    let is_gt_dfff = mb_new_temp(mut_view(*b), (TypeId {
        v: t_bool_v
    }), sp);
    let is_gt_dfff_pl = mir_local_place(is_gt_dfff.v);
    let mut gt_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_GT,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_CONST, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: t_u32_v }, kind: MIR_CONST_INT, val: 0xDFFFu64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(gt_rv.lhs), op);
    mb_emit_assign(mut_view(*b), view(is_gt_dfff_pl), view(gt_rv), sp);

    let is_valid = mb_new_temp(mut_view(*b), (TypeId {
        v: t_bool_v
    }), sp);
    let is_valid_pl = mir_local_place(is_valid.v);
    let or_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_BIT_OR,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(is_lt_d800.v), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(is_gt_dfff.v), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mb_emit_assign(mut_view(*b), view(is_valid_pl), view(or_rv), sp);
    let is_valid_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(is_valid.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mb_emit_assert(mut_view(*b), view(is_valid_op), true, MB_ASSERT_MSG_INVALID_CHAR, sp);
}

// =============================================================================
// Lvalue & Operand Lowering
// =============================================================================

pub fn mir_build_lvalue(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_is_slice_len: mut_view<bool>) -> MirPlace {
    *out_is_slice_len = false;
    if (expr as usize) == 0 {
        return mir_local_place(0u32);
    }
    let ek = unsafe {
        (*expr).kind
    };
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };

    if ek == HIR_EXPR_PATH {
        let sym = SymbolId {
            v: unsafe {
                (*expr).path.symbol.v
            }
        };
        let mut loc = MirLocalId {
            v: 0u32
        };
        let mut is_sl: bool = false;
        if sym.v != 0u32 && mb_lookup_sym(view(*b), (SymbolId { v: sym.v }), mut_view(loc), mut_view(is_sl)) {
            *out_is_slice_len = is_sl;
            let p = mir_local_place(loc.v);
            if (loc.v as usize) < (unsafe { (*b.body).local_count }) {
                let decl = unsafe {
                    mir_local_at((*b.body).locals, loc.v as usize)
                };
                let loc_ty = TypeId {
                    v: unsafe {
                        (*decl).ty.v
                    }
                };
                if loc_ty.v != 0u32 {
                    let lt = unsafe {
                        type_get(view((*b.thir).interner), (TypeId {
                            v: loc_ty.v
                        }))
                    };
                    if (lt as usize) != 0 && ((unsafe { (*lt).kind }) == TY_VIEW || (unsafe { (*lt).kind }) == TY_MUT_VIEW) {
                        let expr_ty = mb_expr_ty(mut_view(*b), expr);
                        if expr_ty.v != 0u32 && expr_ty.v != loc_ty.v {
                            return mb_append_proj_deref(mut_view(*b), view(p));
                        }
                    }
                }
            }
            return p;
        }
        // Check closure captures if inside a closure body
        if b.closure_capture_count > 0 && (b.closure_captures as usize) != 0 && sym.v != 0u32 {
            let mut ci: usize = 0;
            while (ci < b.closure_capture_count) {
                let cap = unsafe {
                    capture_at(b.closure_captures as *mut ClosureCapture, ci)
                };
                if (unsafe { (*cap).sym.v }) == sym.v {
                    let env_pl = mir_local_place(b.closure_env_local.v);
                    let env_deref = mb_append_proj_deref(mut_view(*b), view(env_pl));
                    let cap_field = mb_append_proj_field(mut_view(*b), view(env_deref), ci as u32);
                    let cmode = unsafe {
                        (*cap).mode
                    };
                    if cmode == CAP_VIEW || cmode == CAP_MUT_VIEW {
                        return mb_append_proj_deref(mut_view(*b), view(cap_field));
                    }
                    return cap_field;
                }
                ci = ci + 1;
            }
        }
        if sym.v != 0u32 {
            let cv = unsafe {
                sym_constmap_get(view((*b.thir).symbol_consts), (SymbolId {
                    v: sym.v
                }))
            };
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_AGGREGATE {
                let cv_ty = TypeId {
                    v: unsafe {
                        (*cv).ty.v
                    }
                };
                return mb_build_const_agg_local(mut_view(*b), (SymbolId { v: sym.v }), cv_ty, view(sp));
            }
        }
    } else if ek == HIR_EXPR_UNARY && (unsafe { (*expr).op }) == UNOP_DEREF {
        let mut inner_sl: bool = false;
        let base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).inner
        }, mut_view(inner_sl));
        return mb_append_proj_deref(mut_view(*b), view(base_pl));
    } else if ek == HIR_EXPR_FIELD {
        let mut inner_sl: bool = false;
        let mut base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let mut base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let mut ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: base_ty.v
            }))
        };
        while ((ax as usize) != 0 && ((unsafe { (*ax).kind }) == TY_VIEW || (unsafe { (*ax).kind }) == TY_MUT_VIEW || (unsafe { (*ax).kind }) == TY_PTR)) {
            base_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            let next_ty = TypeId {
                v: unsafe {
                    (*ax).pointee.v
                }
            };
            base_ty = mb_resolve_ty(mut_view(*b), next_ty);
            ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            };
        }
        let mut f_idx: u32 = 0u32;
        if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_STRUCT {
            let fname = StrId {
                v: unsafe {
                    (*expr).name.v
                }
            };
            f_idx = mb_find_struct_field_index(view(*b), unsafe {
                ((*ax).def) as *mut HirItem
            }, (StrId {
                v: fname.v
            }), view(sp));
        }
        return mb_append_proj_field(mut_view(*b), view(base_pl), f_idx);
    } else if ek == HIR_EXPR_TUPLE_INDEX {
        let mut inner_sl: bool = false;
        let mut base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let mut base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let mut ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: base_ty.v
            }))
        };
        while ((ax as usize) != 0 && ((unsafe { (*ax).kind }) == TY_VIEW || (unsafe { (*ax).kind }) == TY_MUT_VIEW || (unsafe { (*ax).kind }) == TY_PTR)) {
            base_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            let next_ty = TypeId {
                v: unsafe {
                    (*ax).pointee.v
                }
            };
            base_ty = mb_resolve_ty(mut_view(*b), next_ty);
            ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            };
        }
        return mb_append_proj_field(mut_view(*b), view(base_pl), unsafe {
            (*expr).tuple_index
        });
    } else if ek == HIR_EXPR_INDEX {
        let mut inner_sl: bool = false;
        let base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let idx_arg: *mut HirExpr = unsafe {
            (*expr).index_arg
        };
        let mut idx_op = MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        };
        mb_build_expr_as_operand(mut_view(*b), idx_arg, mut_view(idx_op));
        let idx_ty = mb_expr_ty(mut_view(*b), idx_arg);
        let mut idx_loc = MirLocalId { v: 0u32 };
        if (idx_op.kind == MIR_OP_COPY || idx_op.kind == MIR_OP_MOVE) && idx_op.place.proj_count == 0 {
            idx_loc.v = idx_op.place.local.v;
        } else {
            idx_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: idx_ty.v
            }), view(sp));
            let idx_pl = mir_local_place(idx_loc.v);
            mb_emit_assign_use(mut_view(*b), view(idx_pl), view(idx_op), view(sp));
        }

        let base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let ax = if base_ty.v != 0u32 {
            unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            }
        } else {
            0 as *mut AxType
        };

        if !b.is_diverged && (ax as usize) != 0 {
            mb_emit_index_bounds_check(mut_view(*b), view(base_pl), ax, (MirLocalId { v: idx_loc.v }), view(sp));
        }

        let mut is_slice_view = false;
        if (ax as usize) != 0 {
            let bk = unsafe {
                (*ax).kind
            };
            if (bk == TY_VIEW || bk == TY_MUT_VIEW) && (unsafe { (*ax).pointee.v }) != 0u32 {
                let pt = unsafe {
                    type_get(view((*b.thir).interner), (TypeId {
                        v: (*ax).pointee.v
                    }))
                };
                if (pt as usize) != 0 && (unsafe { (*pt).kind }) == TY_SLICE {
                    is_slice_view = true;
                }
            }
        }
        if is_slice_view {
            let deref_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            return mb_append_proj_index(mut_view(*b), view(deref_pl), (MirLocalId {
                v: idx_loc.v
            }));
        }
        return mb_append_proj_index(mut_view(*b), view(base_pl), (MirLocalId {
            v: idx_loc.v
        }));
    }

    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    tmp_pl
}

fn mb_build_operand(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_op: mut_view<MirOperand>) {
    if (expr as usize) == 0 {
        *out_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    mb_operand_from_place(view(*b), view(tmp_pl), (TypeId {
        v: e_ty.v
    }), mut_view(*out_op));
}

fn mb_build_expr_as_operand(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_op: mut_view<MirOperand>) {
    if (expr as usize) == 0 {
        *out_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        return;
    }
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };

    if ek == HIR_EXPR_LITERAL {
        mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
        out_op.constant.ty.v = e_ty.v;
        let tk = unsafe {
            (*expr).literal.kind
        };
        if tk == TOK_STR || tk == TOK_BYTE_STR {
            out_op.constant.kind = MIR_CONST_STR;
            let s_ptr = unsafe {
                (*expr).literal.str_ptr
            };
            let s_len = unsafe {
                (*expr).literal.str_len as usize
            };
            if (s_ptr as usize) != 0 {
                out_op.constant.str_bytes = s_ptr;
                out_op.constant.str_len = s_len;
            } else {
                let sv = mb_span_sv(view(*b), view(sp));
                if sv.len >= 2 {
                    out_op.constant.str_bytes = unsafe {
                        sv.ptr + 1
                    };
                    out_op.constant.str_len = sv.len - 2;
                }
            }
        } else if tk == TOK_KW_TRUE {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = 1u64;
        } else if tk == TOK_KW_FALSE {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = 0u64;
        } else {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = unsafe {
                mb_token_int_val(view(*b), view((*expr).literal), false)
            };
        }
        return;
    }

    if ek == HIR_EXPR_PATH {
        let sym = SymbolId {
            v: unsafe {
                (*expr).path.symbol.v
            }
        };
        let mut loc = MirLocalId {
            v: 0u32
        };
        let mut is_sl: bool = false;
        let mut in_local = false;
        if sym.v != 0u32 && mb_lookup_sym(view(*b), (SymbolId { v: sym.v }), mut_view(loc), mut_view(is_sl)) {
            in_local = true;
        } else if b.closure_capture_count > 0 && (b.closure_captures as usize) != 0 && sym.v != 0u32 {
            let mut ci: usize = 0;
            while (ci < b.closure_capture_count) {
                let cap = unsafe {
                    capture_at(b.closure_captures as *mut ClosureCapture, ci)
                };
                if (unsafe { (*cap).sym.v }) == sym.v {
                    in_local = true;
                    break;
                }
                ci = ci + 1;
            }
        }
        if in_local {
            let mut dummy_sl = false;
            let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            mb_operand_from_place(view(*b), view(p), (TypeId {
                v: e_ty.v
            }), mut_view(*out_op));
            return;
        }
        // Check if enum unit variant
        let vp = unsafe {
            thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
        };
        if (vp as usize) == 0 {
            let mut cv: *mut ConstValue = 0 as *mut ConstValue;
            if sym.v != 0u32 {
                cv = unsafe {
                    sym_constmap_get(view((*b.thir).symbol_consts), (SymbolId {
                        v: sym.v
                    }))
                };
            }
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_STR {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_STR;
                out_op.constant.str_bytes = unsafe {
                    (*cv).str_bytes
                };
                out_op.constant.str_len = unsafe {
                    (*cv).str_len
                };
                return;
            }
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_INT {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_INT;
                out_op.constant.val = unsafe {
                    (*cv).int_val
                };
                return;
            }
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_AGGREGATE {
                let mut dummy_sl = false;
                let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
                mb_operand_from_place(view(*b), view(p), (TypeId {
                    v: e_ty.v
                }), mut_view(*out_op));
                return;
            }
            let ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: e_ty.v
                }))
            };
            if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_FN {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_FN;
                out_op.constant.sym.v = sym.v;
                out_op.constant.val = sym.v as u64;
                return;
            }
            if sym.v != 0u32 {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_INT;
                out_op.constant.val = sym.v as u64;
                out_op.constant.sym.v = sym.v;
                return;
            }
        }
    }

    let mut is_lval_cand = false;
    if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        is_lval_cand = true;
    } else if ek == HIR_EXPR_INDEX {
        let idx_arg: *mut HirExpr = unsafe {
            (*expr).index_arg
        };
        if (idx_arg as usize) != 0 && (unsafe { (*idx_arg).kind }) != HIR_EXPR_RANGE {
            is_lval_cand = true;
        }
    }
    if is_lval_cand {
        let vp = unsafe {
            thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
        };
        let mp = unsafe {
            thir_get_expr_method(view(*b.thir), expr as *const HirExpr)
        };
        if (vp as usize) == 0 && (mp as usize) == 0 {
            let mut dummy_sl = false;
            let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            mb_operand_from_place(view(*b), view(p), (TypeId {
                v: e_ty.v
            }), mut_view(*out_op));
            return;
        }
    }

    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    out_op.kind = MIR_OP_MOVE;
    mir_copy_place(mut_view(out_op.place), view(tmp_pl));
}

fn mb_ast_binop_to_mir(op: u8, out_is_checked: mut_view<bool>) -> u8 {
    *out_is_checked = false;
    if op == BINOP_ADD {
        *out_is_checked = true;
        return MIR_BINOP_ADD;
    }
    if op == BINOP_SUB {
        *out_is_checked = true;
        return MIR_BINOP_SUB;
    }
    if op == BINOP_MUL {
        *out_is_checked = true;
        return MIR_BINOP_MUL;
    }
    if op == BINOP_DIV {
        *out_is_checked = true;
        return MIR_BINOP_DIV;
    }
    if op == BINOP_REM {
        *out_is_checked = true;
        return MIR_BINOP_REM;
    }
    if op == BINOP_SHL {
        *out_is_checked = true;
        return MIR_BINOP_SHL;
    }
    if op == BINOP_SHR {
        *out_is_checked = true;
        return MIR_BINOP_SHR;
    }
    if op == BINOP_BITAND {
        return MIR_BINOP_BIT_AND;
    }
    if op == BINOP_BITOR {
        return MIR_BINOP_BIT_OR;
    }
    if op == BINOP_BITXOR {
        return MIR_BINOP_BIT_XOR;
    }
    if op == BINOP_EQ {
        return MIR_BINOP_EQ;
    }
    if op == BINOP_NE {
        return MIR_BINOP_NE;
    }
    if op == BINOP_LT {
        return MIR_BINOP_LT;
    }
    if op == BINOP_LE {
        return MIR_BINOP_LE;
    }
    if op == BINOP_GT {
        return MIR_BINOP_GT;
    }
    if op == BINOP_GE {
        return MIR_BINOP_GE;
    }
    MIR_BINOP_ADD
}

fn mb_type_bit_width(b: view<MirBuilder>, ty: TypeId) -> u64 {
    if (b.thir as usize) != 0 {
        let lay = unsafe { type_layout(TypeId { v: ty.v }, view((*b.thir).interner)) };
        if lay.size != 0u32 {
            return (lay.size as u64) * 8u64;
        }
    }
    32u64
}

fn mb_build_binary_expr(b: mut_view<MirBuilder>, expr: *mut HirExpr, dest: mut_view<MirPlace>) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let op = unsafe {
        (*expr).op
    };
    let left_expr: *mut HirExpr = unsafe {
        (*expr).left
    };
    let right_expr: *mut HirExpr = unsafe {
        (*expr).right
    };

    // Short-circuit && and ||
    if op == BINOP_LOGAND || op == BINOP_LOGOR {
        let mut lhs = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), left_expr, mut_view(lhs));
        if lhs.kind == MIR_OP_MOVE {
            lhs.kind = MIR_OP_COPY;
        }
        let bb_rhs = mb_new_bb(mut_view(*b), false);
        let bb_end = mb_new_bb(mut_view(*b), false);
        mb_emit_assign_use(mut_view(*b), view(*dest), view(lhs), view(sp));
        if op == BINOP_LOGAND {
            mb_emit_switch_single(mut_view(*b), view(lhs), 0u64, (MirBbId {
                v: bb_end.v
            }), (MirBbId {
                v: bb_rhs.v
            }), view(sp));
        } else {
            mb_emit_switch_single(mut_view(*b), view(lhs), 0u64, (MirBbId {
                v: bb_rhs.v
            }), (MirBbId {
                v: bb_end.v
            }), view(sp));
        }
        b.curr_bb.v = bb_rhs.v;
        b.is_diverged = false;
        let mut rhs = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), right_expr, mut_view(rhs));
        mb_emit_assign_use(mut_view(*b), view(*dest), view(rhs), view(sp));
        mb_terminate_goto(mut_view(*b), (MirBbId {
            v: bb_end.v
        }), view(sp));
        b.curr_bb.v = bb_end.v;
        b.is_diverged = false;
        return;
    }

    let mut lhs = MirOperand {
        kind: MIR_OP_COPY, location: Span {
            file: FileId {
                v: 0u32
            }, start: 0u32, end: 0u32
        }, place: MirPlace {
            local: MirLocalId {
                v: 0u32
            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
        }, constant: MirConst {
            ty: TypeId {
                v: 0u32
            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                v: 0u32
            }
        }
    };
    mb_build_expr_as_operand(mut_view(*b), left_expr, mut_view(lhs));
    let mut rhs = MirOperand {
        kind: MIR_OP_COPY, location: Span {
            file: FileId {
                v: 0u32
            }, start: 0u32, end: 0u32
        }, place: MirPlace {
            local: MirLocalId {
                v: 0u32
            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
        }, constant: MirConst {
            ty: TypeId {
                v: 0u32
            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                v: 0u32
            }
        }
    };
    mb_build_expr_as_operand(mut_view(*b), right_expr, mut_view(rhs));

    let mut is_checked = false;
    let binop = mb_ast_binop_to_mir(op, mut_view(is_checked));
    let lty = mb_expr_ty(mut_view(*b), left_expr);
    let rty = mb_expr_ty(mut_view(*b), right_expr);
    let lt = unsafe {
        type_get(view((*b.thir).interner), (TypeId {
            v: lty.v
        }))
    };
    let rt = unsafe {
        type_get(view((*b.thir).interner), (TypeId {
            v: rty.v
        }))
    };

    if ((lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_PTR) || ((rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR) {
        is_checked = false;
    }

    let bool_ty = TypeId {
        v: unsafe {
            (*b.thir).interner.t_bool.v
        }
    };

    if is_checked {
        if binop == MIR_BINOP_DIV || binop == MIR_BINOP_REM {
            let cond_nz = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let cond_nz_pl = mir_local_place(cond_nz.v);
            let zero_op = MirOperand {
                kind: MIR_OP_CONST, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: rty.v
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            let mut ne_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            ne_rv.kind = MIR_RVALUE_BINARY_OP;
            ne_rv.bin_op = MIR_BINOP_NE;
            mir_copy_operand(mut_view(ne_rv.lhs), view(rhs));
            mir_copy_operand(mut_view(ne_rv.rhs), view(zero_op));
            mb_emit_assign(mut_view(*b), view(cond_nz_pl), view(ne_rv), view(sp));
            let nz_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: cond_nz.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assert(mut_view(*b), view(nz_op), true, MB_ASSERT_MSG_DIV_ZERO, view(sp));

            let cond_not_ov = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let cond_not_ov_pl = mir_local_place(cond_not_ov.v);
            let temp_ov = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let temp_ov_pl = mir_local_place(temp_ov.v);
            let mut ov_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            ov_rv.kind = MIR_RVALUE_OVERFLOWS_BINARY_OP;
            ov_rv.bin_op = binop;
            mir_copy_operand(mut_view(ov_rv.lhs), view(lhs));
            mir_copy_operand(mut_view(ov_rv.rhs), view(rhs));
            mb_emit_assign(mut_view(*b), view(temp_ov_pl), view(ov_rv), view(sp));

            let mut not_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            not_rv.kind = MIR_RVALUE_UNARY_OP;
            not_rv.un_op = MIR_UNOP_NOT;
            not_rv.use_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: temp_ov.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assign(mut_view(*b), view(cond_not_ov_pl), view(not_rv), view(sp));
            let not_ov_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: cond_not_ov.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assert(mut_view(*b), view(not_ov_op), true, MB_ASSERT_MSG_ARITH_OV, view(sp));
        } else if binop == MIR_BINOP_SHL || binop == MIR_BINOP_SHR {
            let cond_ge = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let cond_ge_pl = mir_local_place(cond_ge.v);
            let zero_op = MirOperand {
                kind: MIR_OP_CONST, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: rty.v
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            let mut ge_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            ge_rv.kind = MIR_RVALUE_BINARY_OP;
            ge_rv.bin_op = MIR_BINOP_GE;
            mir_copy_operand(mut_view(ge_rv.lhs), view(rhs));
            mir_copy_operand(mut_view(ge_rv.rhs), view(zero_op));
            mb_emit_assign(mut_view(*b), view(cond_ge_pl), view(ge_rv), view(sp));
            let ge_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: cond_ge.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assert(mut_view(*b), view(ge_op), true, MB_ASSERT_MSG_SHIFT_RANGE, view(sp));

            let cond_lt = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let cond_lt_pl = mir_local_place(cond_lt.v);
            let bits = mb_type_bit_width(view(*b), (TypeId {
                v: lty.v
            }));
            let bits_op = MirOperand {
                kind: MIR_OP_CONST, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: rty.v
                    }, kind: MIR_CONST_INT, val: bits, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            let mut lt_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            lt_rv.kind = MIR_RVALUE_BINARY_OP;
            lt_rv.bin_op = MIR_BINOP_LT;
            mir_copy_operand(mut_view(lt_rv.lhs), view(rhs));
            mir_copy_operand(mut_view(lt_rv.rhs), view(bits_op));
            mb_emit_assign(mut_view(*b), view(cond_lt_pl), view(lt_rv), view(sp));
            let lt_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: cond_lt.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assert(mut_view(*b), view(lt_op), true, MB_ASSERT_MSG_SHIFT_RANGE, view(sp));
        } else {
            let temp_ov = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let temp_ov_pl = mir_local_place(temp_ov.v);
            let mut ov_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            ov_rv.kind = MIR_RVALUE_OVERFLOWS_BINARY_OP;
            ov_rv.bin_op = binop;
            mir_copy_operand(mut_view(ov_rv.lhs), view(lhs));
            mir_copy_operand(mut_view(ov_rv.rhs), view(rhs));
            mb_emit_assign(mut_view(*b), view(temp_ov_pl), view(ov_rv), view(sp));

            let cond_not_ov = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let cond_not_ov_pl = mir_local_place(cond_not_ov.v);
            let mut not_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            not_rv.kind = MIR_RVALUE_UNARY_OP;
            not_rv.un_op = MIR_UNOP_NOT;
            not_rv.use_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: temp_ov.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assign(mut_view(*b), view(cond_not_ov_pl), view(not_rv), view(sp));
            let not_ov_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: cond_not_ov.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assert(mut_view(*b), view(not_ov_op), true, MB_ASSERT_MSG_ARITH_OV, view(sp));
        }
    }

    let mut res_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    res_rv.kind = MIR_RVALUE_BINARY_OP;
    res_rv.bin_op = binop;
    mir_copy_operand(mut_view(res_rv.lhs), view(lhs));
    mir_copy_operand(mut_view(res_rv.rhs), view(rhs));
    mb_emit_assign(mut_view(*b), view(*dest), view(res_rv), view(sp));
}
fn mb_push_loop(
    b: mut_view<MirBuilder>,
    label: StrId,
    break_bb: MirBbId,
    continue_bb: MirBbId,
    dest: view<MirPlace>,
    has_dest: bool
) {
    if b.loop_depth >= b.loop_cap {
        let new_cap: usize = if b.loop_cap == 0 {
            8
        } else {
            b.loop_cap + b.loop_cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirLoopScope>());
        let new_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<MirLoopScope>()) as *mut MirLoopScope
        };
        if b.loop_depth > 0 && (b.loop_stack as usize) != 0 {
            let old_bytes = mir_mul_usize(b.loop_depth, size_of<MirLoopScope>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.loop_stack as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        b.loop_stack = new_arr;
        b.loop_cap = new_cap;
    }
    let ls = unsafe {
        mb_loop_scope_at(b.loop_stack, b.loop_depth)
    };
    unsafe {
        (*ls).label.v = label.v;
        (*ls).break_bb.v = break_bb.v;
        (*ls).continue_bb.v = continue_bb.v;
        mir_copy_place(mut_view((*ls).dest), dest);
        (*ls).has_dest = has_dest;
        (*ls).scope_depth = b.scope_depth;
        (*ls).drop_scope = b.current_drops;
    }
    b.loop_depth = b.loop_depth + 1;
}

fn mb_find_loop(b: view<MirBuilder>, label: StrId) -> *mut MirLoopScope {
    if b.loop_depth == 0 || (b.loop_stack as usize) == 0 {
        return 0 as *mut MirLoopScope;
    }
    if label.v != 0u32 {
        let mut i = b.loop_depth;
        while (i > 0) {
            i = i - 1;
            let ls = unsafe {
                mb_loop_scope_at(b.loop_stack, i)
            };
            if (unsafe { (*ls).label.v }) == label.v {
                return ls;
            }
        }
    }
    unsafe { mb_loop_scope_at(b.loop_stack, b.loop_depth - 1) }
}

pub fn mir_build_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    if (expr as usize) == 0 || b.is_diverged {
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);

    // Check if expression is an enum variant constructor in THIR
    let vp = unsafe {
        thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
    };
    if (vp as usize) != 0 {
        let v_idx = unsafe {
            *vp
        };
        let mut arg_head: *mut HirExpr = 0 as *mut HirExpr;
        if ek == HIR_EXPR_CALL {
            arg_head = unsafe {
                (*expr).args
            };
        } else if ek == HIR_EXPR_METHOD_CALL {
            arg_head = unsafe {
                (*expr).args
            };
        }
        let mut f_count: usize = 0;
        let mut cur_a = arg_head;
        while ((cur_a as usize) != 0) {
            f_count = f_count + 1;
            cur_a = unsafe {
                (*cur_a).next
            };
        }
        let mut ops: *mut MirOperand = 0 as *mut MirOperand;
        if f_count > 0 {
            let bytes = mir_mul_usize(f_count, size_of<MirOperand>());
            ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut idx: usize = 0;
            cur_a = arg_head;
            while ((cur_a as usize) != 0) {
                let mut op_i = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_build_expr_as_operand(mut_view(*b), cur_a, mut_view(op_i));
                let dst_op = unsafe {
                    mir_op_at(ops, idx)
                };
                unsafe {
                    mir_copy_operand(mut_view(*dst_op), view(op_i));
                }
                idx = idx + 1;
                cur_a = unsafe {
                    (*cur_a).next
                };
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = v_idx;
        rv.operands = ops;
        rv.operand_count = f_count;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    if ek == HIR_EXPR_LITERAL || ek == HIR_EXPR_PATH || ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX || ek == HIR_EXPR_INDEX {
        let mut op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), expr, mut_view(op));
        if has_dest {
            mb_emit_assign_use(mut_view(*b), view(*dest), view(op), view(sp));
        }
        return;
    }

    if ek == HIR_EXPR_BINARY {
        mb_build_binary_expr(mut_view(*b), expr, dest);
        return;
    }

    if ek == HIR_EXPR_UNARY {
        let uop = unsafe {
            (*expr).op
        };
        if uop == UNOP_DEREF {
            let mut dummy_sl = false;
            let pl = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            let mut op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mir_copy_place(mut_view(op.place), view(pl));
            if has_dest {
                mb_emit_assign_use(mut_view(*b), view(*dest), view(op), view(sp));
            }
            return;
        }
        let inner_expr: *mut HirExpr = unsafe {
            (*expr).inner
        };
        let mut inner_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), inner_expr, mut_view(inner_op));
        if uop == UNOP_NEG {
            let inner_ty = mb_expr_ty(mut_view(*b), inner_expr);
            let bool_ty = TypeId {
                v: unsafe {
                    (*b.thir).interner.t_bool.v
                }
            };
            let zero_op = MirOperand {
                kind: MIR_OP_CONST, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
