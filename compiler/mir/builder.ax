            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = 0u32;
        rv.operands = ops;
        rv.operand_count = cnt;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    if ek == HIR_EXPR_ARRAY {
        let count_expr: *mut HirExpr = unsafe {
            (*expr).count_expr
        };
        if (count_expr as usize) != 0 {
            let mut elem_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), unsafe {
                (*expr).elems
            }, mut_view(elem_op));
            let mut cnt_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), count_expr, mut_view(cnt_op));
            let cnt_op_ptr = unsafe {
                arena_alloc_raw(mut_view(*b.arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand
            };
            unsafe {
                mir_copy_operand(mut_view(*cnt_op_ptr), view(cnt_op));
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_REPEAT;
            mir_copy_operand(mut_view(rv.use_op), view(elem_op));
            rv.repeat_count = mb_eval_const_int_expr(view(*b), count_expr);
            rv.repeat_count_op = cnt_op_ptr;
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        } else {
            let mut cnt: usize = 0;
            let mut el: *mut HirExpr = unsafe {
                (*expr).elems
            };
            while ((el as usize) != 0) {
                cnt = cnt + 1;
                el = unsafe {
                    (*el).next
                };
            }
            let mut ops: *mut MirOperand = 0 as *mut MirOperand;
            if cnt > 0 {
                let bytes = mir_mul_usize(cnt, size_of<MirOperand>());
                ops = unsafe {
                    arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
                };
                let mut i: usize = 0;
                el = unsafe {
                    (*expr).elems
                };
                while ((el as usize) != 0) {
                    let mut op_i = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), el, mut_view(op_i));
                    let dst_op = unsafe {
                        mir_op_at(ops, i)
                    };
                    unsafe {
                        mir_copy_operand(mut_view(*dst_op), view(op_i));
                    }
                    i = i + 1;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_AGGREGATE;
            rv.variant_idx = 0u32;
            rv.operands = ops;
            rv.operand_count = cnt;
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        }
        return;
    }

    if ek == HIR_EXPR_STRUCT {
        let ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: e_ty.v
            }))
        };
        let mut is_enum_struct = false;
        let mut v_idx: u32 = 0u32;
        let mut f_count: usize = 0;
        let mut def_item: *mut HirItem = 0 as *mut HirItem;
        if (ax as usize) != 0 {
            def_item = unsafe {
                ((*ax).def) as *mut HirItem
            };
            if (unsafe { (*ax).kind }) == TY_ENUM {
                is_enum_struct = true;
                let vp2 = unsafe {
                    thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
                };
                if (vp2 as usize) != 0 {
                    v_idx = unsafe {
                        *vp2
                    };
                }
                if (v_idx as usize) < (unsafe { (*ax).variant_count }) && (unsafe { (*ax).variant_field_counts as usize }) != 0 {
                    f_count = unsafe {
                        *usize_at((*ax).variant_field_counts, v_idx as usize)
                    };
                }
            } else if (unsafe { (*ax).kind }) == TY_STRUCT {
                f_count = unsafe {
                    (*ax).field_count
                };
            }
        }
        if f_count == 0 {
            let mut fi: *mut HirFieldInit = unsafe {
                (*expr).fields
            };
            while ((fi as usize) != 0) {
                f_count = f_count + 1;
                fi = unsafe {
                    (*fi).next
                };
            }
        }
        let mut ops: *mut MirOperand = 0 as *mut MirOperand;
        if f_count > 0 {
            let bytes = mir_mul_usize(f_count, size_of<MirOperand>());
            ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut i: usize = 0;
            while (i < f_count) {
                let dst_op = unsafe {
                    mir_op_at(ops, i)
                };
                unsafe {
                    *dst_op = MirOperand {
                        kind: MIR_OP_CONST, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                }
                i = i + 1;
            }
            let mut fi: *mut HirFieldInit = unsafe {
                (*expr).fields
            };
            let mut pos_idx: usize = 0;
            while ((fi as usize) != 0) {
                let fi_sp = Span {
                    file: FileId { v: unsafe { (*fi).span.file.v } },
                    start: unsafe { (*fi).span.start },
                    end: unsafe { (*fi).span.end },
                };
                let fi_name = StrId {
                    v: unsafe {
                        (*fi).name.v
                    }
                };
                let mut target_idx: usize = pos_idx;
                if (def_item as usize) != 0 {
                    if is_enum_struct {
                        target_idx = mb_find_enum_variant_field_index(view(*b), def_item, v_idx, (StrId {
                            v: fi_name.v
                        }), view(fi_sp)) as usize;
                    } else {
                        target_idx = mb_find_struct_field_index(view(*b), def_item, (StrId {
                            v: fi_name.v
                        }), view(fi_sp)) as usize;
                    }
                }
                if target_idx >= f_count {
                    target_idx = pos_idx;
                }
                if target_idx < f_count {
                    let mut op_f = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), unsafe {
                        (*fi).expr
                    }, mut_view(op_f));
                    let dst_op = unsafe {
                        mir_op_at(ops, target_idx)
                    };
                    unsafe {
                        mir_copy_operand(mut_view(*dst_op), view(op_f));
                    }
                }
                pos_idx = pos_idx + 1;
                fi = unsafe {
                    (*fi).next
                };
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = v_idx;
        rv.operands = ops;
        rv.operand_count = f_count;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    mb_build_control_or_call_expr(mut_view(*b), expr, mut_view(*dest), has_dest);
}

fn mb_intr_temp(b: mut_view<MirBuilder>, ty_v: u32, sp: view<Span>) -> MirPlace {
    let loc = mb_new_temp(mut_view(*b), (TypeId { v: ty_v }), sp);
    mir_local_place(loc.v)
}

fn mb_intr_copy_op(p: MirPlace) -> MirOperand {
    let mut op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mir_copy_place(mut_view(op.place), view(p));
    op
}

fn mb_intr_const_op(ty_v: u32, v: u64) -> MirOperand {
    MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: ty_v }, kind: MIR_CONST_INT, val: v, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    }
}

fn mb_intr_binop_into(
    b: mut_view<MirBuilder>,
    out_pl: view<MirPlace>,
    op: u8,
    lhs: view<MirOperand>,
    rhs: view<MirOperand>,
    sp: view<Span>
) -> MirOperand {
    let mut rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: mb_intr_copy_op(mir_local_place(0u32)),
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: op,
        lhs: mb_intr_copy_op(mir_local_place(0u32)),
        rhs: mb_intr_copy_op(mir_local_place(0u32)),
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(rv.lhs), lhs);
    mir_copy_operand(mut_view(rv.rhs), rhs);
    mb_emit_assign(mut_view(*b), out_pl, view(rv), sp);
    let mut cp_pl = mir_local_place(0u32);
    mir_copy_place(mut_view(cp_pl), out_pl);
    mb_intr_copy_op(cp_pl)
}

fn mb_intr_binop(
    b: mut_view<MirBuilder>,
    op: u8,
    ty_v: u32,
    lhs: view<MirOperand>,
    rhs: view<MirOperand>,
    sp: view<Span>
) -> MirOperand {
    let t = mb_intr_temp(mut_view(*b), ty_v, sp);
    mb_intr_binop_into(mut_view(*b), view(t), op, lhs, rhs, sp)
}

fn mb_intr_cast_into(
    b: mut_view<MirBuilder>,
    out_pl: view<MirPlace>,
    v: view<MirOperand>,
    to_ty_v: u32,
    sp: view<Span>
) {
    let mut rv = MirRvalue {
        kind: MIR_RVALUE_CAST,
        use_op: mb_intr_copy_op(mir_local_place(0u32)),
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: to_ty_v },
        bin_op: MIR_BINOP_ADD,
        lhs: mb_intr_copy_op(mir_local_place(0u32)),
        rhs: mb_intr_copy_op(mir_local_place(0u32)),
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(rv.use_op), v);
    mb_emit_assign(mut_view(*b), out_pl, view(rv), sp);
}

fn mb_intr_cast(
    b: mut_view<MirBuilder>,
    v: view<MirOperand>,
    from_ty_v: u32,
    to_ty_v: u32,
    sp: view<Span>
) -> MirOperand {
    if from_ty_v == to_ty_v {
        let mut out_v = mb_intr_copy_op(mir_local_place(0u32));
        mir_copy_operand(mut_view(out_v), v);
        return out_v;
    }
    let t = mb_intr_temp(mut_view(*b), to_ty_v, sp);
    mb_intr_cast_into(mut_view(*b), view(t), v, to_ty_v, sp);
    mb_intr_copy_op(t)
}

fn mb_intr_materialize(
    b: mut_view<MirBuilder>,
    v: view<MirOperand>,
    ty_v: u32,
    sp: view<Span>
) -> MirOperand {
    let t = mb_intr_temp(mut_view(*b), ty_v, sp);
    mb_emit_assign_use(mut_view(*b), view(t), v, sp);
    mb_intr_copy_op(t)
}

fn mb_intr_popcount64(b: mut_view<MirBuilder>, x: view<MirOperand>, sp: view<Span>) -> MirOperand {
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    let u32_ty_v = unsafe { (*b.thir).interner.t_u32.v };
    let c1 = mb_intr_const_op(u32_ty_v, 1u64);
    let c2 = mb_intr_const_op(u32_ty_v, 2u64);
    let c4 = mb_intr_const_op(u32_ty_v, 4u64);
    let c56 = mb_intr_const_op(u32_ty_v, 56u64);
    let m55 = mb_intr_const_op(u64_ty_v, 0x5555555555555555u64);
    let m33 = mb_intr_const_op(u64_ty_v, 0x3333333333333333u64);
    let m0f = mb_intr_const_op(u64_ty_v, 0x0F0F0F0F0F0F0F0Fu64);
    let m01 = mb_intr_const_op(u64_ty_v, 0x0101010101010101u64);
    let mut t = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, x, view(c1), sp);
    t = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(t), view(m55), sp);
    let x1 = mb_intr_binop(mut_view(*b), MIR_BINOP_SUB, u64_ty_v, x, view(t), sp);
    let lo = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(x1), view(m33), sp);
    let mut hi = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(x1), view(c2), sp);
    hi = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(hi), view(m33), sp);
    let x2 = mb_intr_binop(mut_view(*b), MIR_BINOP_ADD, u64_ty_v, view(lo), view(hi), sp);
    let sh = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(x2), view(c4), sp);
    let sum = mb_intr_binop(mut_view(*b), MIR_BINOP_ADD, u64_ty_v, view(x2), view(sh), sp);
    let x3 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(sum), view(m0f), sp);
    let prod = mb_intr_binop(mut_view(*b), MIR_BINOP_WRAPPING_MUL, u64_ty_v, view(x3), view(m01), sp);
    mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(prod), view(c56), sp)
}

fn mb_intr_zext64(
    b: mut_view<MirBuilder>,
    a: view<MirOperand>,
    w_ty_v: u32,
    u_ty_v: u32,
    sp: view<Span>
) -> MirOperand {
    let u = mb_intr_cast(mut_view(*b), a, w_ty_v, u_ty_v, sp);
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    mb_intr_cast(mut_view(*b), view(u), u_ty_v, u64_ty_v, sp)
}

fn mb_intr_finish_use(b: mut_view<MirBuilder>, dest: view<MirPlace>, v: view<MirOperand>, sp: view<Span>) {
    mb_emit_assign_use(mut_view(*b), dest, v, sp);
}

fn mb_intr_assert(b: mut_view<MirBuilder>, cond: view<MirOperand>, msg_kind: u8, sp: view<Span>) {
    let bool_ty_v = unsafe { (*b.thir).interner.t_bool.v };
    let c = mb_intr_temp(mut_view(*b), bool_ty_v, sp);
    mb_emit_assign_use(mut_view(*b), view(c), cond, sp);
    let c_op = mb_intr_copy_op(c);
    mb_emit_assert(mut_view(*b), view(c_op), true, msg_kind, sp);
}

fn mb_try_build_intrinsic_call(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool,
    sp: view<Span>
) -> bool {
    let callee_expr: *mut HirExpr = unsafe { (*expr).callee };
    let mut iref = intrinsic_decode(0u32);
    let code_ptr = unsafe { thir_get_expr_variant(view(*b.thir), callee_expr as *const HirExpr) };
    if (code_ptr as usize) != 0 {
        iref = intrinsic_decode(unsafe { *code_ptr });
    }
    if !iref.has_desc {
        let sym_intr = SymbolId { v: unsafe { (*callee_expr).path.symbol.v } };
        let mut fn_item_intr: *mut HirItem = 0 as *mut HirItem;
        if sym_intr.v != 0u32 {
            fn_item_intr = mb_find_item_by_sym(b.hir, sym_intr);
        }
        if (fn_item_intr as usize) == 0 {
            let mut p_sv = StrView { ptr: 0 as *const u8, len: 0 };
            let pnv = unsafe { (*callee_expr).path.name.v };
            if pnv != 0u32 && (b.str_in as usize) != 0 {
                p_sv = unsafe { interner_get(view(*b.str_in), StrId { v: pnv }) };
            } else {
                let csp = Span {
                    file: FileId { v: unsafe { (*callee_expr).span.file.v } },
                    start: unsafe { (*callee_expr).span.start },
                    end: unsafe { (*callee_expr).span.end },
                };
                p_sv = mb_span_sv(view(*b), view(csp));
            }
            fn_item_intr = mb_find_item_by_path_sv(view(*b), view(p_sv));
        }
        if (fn_item_intr as usize) != 0 && mb_has_intrinsic_attr(b.str_in, b.db, fn_item_intr) {
            let fn_sv = mb_item_name_sv(view(*b), fn_item_intr);
            iref = intrinsic_lookup(fn_sv);
        }
    }
    if !iref.has_desc {
        return false;
    }
    if iref.desc.cls != INTR_MIR_OP && iref.desc.cls != INTR_MIR_TERM {
        return false;
    }

    let mut argc: usize = 0;
    let mut cur_a: *mut HirExpr = unsafe { (*expr).args };
    while (cur_a as usize) != 0 {
        argc = argc + 1;
        cur_a = unsafe { (*cur_a).next };
    }

    if iref.desc.cls == INTR_MIR_TERM {
        if argc > 1 { return false; }
        if iref.desc.op == INTR_OP_ASSERT && argc != 1 { return false; }
        if iref.desc.op == INTR_OP_UNREACHABLE && argc != 0 { return false; }
        let mut arg_op = mb_intr_copy_op(mir_local_place(0u32));
        if argc == 1 {
            mb_build_expr_as_operand(mut_view(*b), unsafe { (*expr).args }, mut_view(arg_op));
        }
        if iref.desc.op == INTR_OP_ASSERT {
            mb_intr_assert(mut_view(*b), view(arg_op), MB_ASSERT_MSG_ASSERT, sp);
            if has_dest {
                let mut rv = MirRvalue {
                    kind: MIR_RVALUE_AGGREGATE,
                    use_op: mb_intr_copy_op(mir_local_place(0u32)),
                    repeat_count: 0u64,
                    repeat_count_op: 0 as *mut MirOperand,
                    borrow_kind: MIR_BORROW_SHARED,
                    place: mir_local_place(0u32),
                    cast_kind: MIR_CAST_INT_TO_INT,
                    target_ty: TypeId { v: 0u32 },
                    bin_op: MIR_BINOP_ADD,
                    lhs: mb_intr_copy_op(mir_local_place(0u32)),
                    rhs: mb_intr_copy_op(mir_local_place(0u32)),
                    un_op: MIR_UNOP_NOT,
                    variant_idx: 0u32,
                    operands: 0 as *mut MirOperand,
                    operand_count: 0,
                };
                mb_emit_assign(mut_view(*b), view(*dest), view(rv), sp);
            }
        } else {
            let msg_kind = if iref.desc.op == INTR_OP_UNREACHABLE {
                MB_ASSERT_MSG_UNREACHABLE
            } else {
                MB_ASSERT_MSG_PANIC
            };
            let bool_ty_v = unsafe { (*b.thir).interner.t_bool.v };
            let false_op = mb_intr_const_op(bool_ty_v, 0u64);
            mb_intr_assert(mut_view(*b), view(false_op), msg_kind, sp);
        }
        return true;
    }

    let w_ty = unsafe { intrinsic_width_type(iref.width, view((*b.thir).interner)) };
    let u_ty = unsafe { intrinsic_width_unsigned_type(iref.width, view((*b.thir).interner)) };
    let w_ty_v = w_ty.v;
    let u_ty_v = u_ty.v;
    let bits = intrinsic_width_bits(iref.width);
    let u32_ty_v = unsafe { (*b.thir).interner.t_u32.v };
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    let op = iref.desc.op;
    let want: usize = if op == INTR_OP_WRAPPING_ADD || op == INTR_OP_WRAPPING_SUB || op == INTR_OP_WRAPPING_MUL || op == INTR_OP_ROTATE_LEFT || op == INTR_OP_ROTATE_RIGHT {
        2
    } else {
        1
    };
    if argc != want {
        return false;
    }

    let arg0: *mut HirExpr = unsafe { (*expr).args };
    let mut a = mb_intr_copy_op(mir_local_place(0u32));
    mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(a));
    let mut a2 = mb_intr_copy_op(mir_local_place(0u32));
    if want == 2 {
        mb_build_expr_as_operand(mut_view(*b), unsafe { (*arg0).next }, mut_view(a2));
    }

    if op == INTR_OP_WRAPPING_ADD || op == INTR_OP_WRAPPING_SUB || op == INTR_OP_WRAPPING_MUL {
        let bop = if op == INTR_OP_WRAPPING_ADD {
            MIR_BINOP_WRAPPING_ADD
        } else if op == INTR_OP_WRAPPING_SUB {
            MIR_BINOP_WRAPPING_SUB
        } else {
            MIR_BINOP_WRAPPING_MUL
        };
        let xa = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        let xb = mb_intr_materialize(mut_view(*b), view(a2), w_ty_v, sp);
        let _ = mb_intr_binop_into(mut_view(*b), view(*dest), bop, view(xa), view(xb), sp);
    } else if op == INTR_OP_WRAPPING_NEG {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        let zero_w = mb_intr_const_op(w_ty_v, 0u64);
        let _ = mb_intr_binop_into(mut_view(*b), view(*dest), MIR_BINOP_WRAPPING_SUB, view(zero_w), view(x), sp);
    } else if op == INTR_OP_ROTATE_LEFT || op == INTR_OP_ROTATE_RIGHT {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        let n = mb_intr_materialize(mut_view(*b), view(a2), u32_ty_v, sp);
        let xu = mb_intr_cast(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
        let mask = mb_intr_const_op(u32_ty_v, (bits - 1u32) as u64);
        let nm = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u32_ty_v, view(n), view(mask), sp);
        let bits_c = mb_intr_const_op(u32_ty_v, bits as u64);
        let mut inv = mb_intr_binop(mut_view(*b), MIR_BINOP_SUB, u32_ty_v, view(bits_c), view(nm), sp);
        inv = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u32_ty_v, view(inv), view(mask), sp);
        let hi = if op == INTR_OP_ROTATE_LEFT {
            mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u_ty_v, view(xu), view(nm), sp)
        } else {
            mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u_ty_v, view(xu), view(inv), sp)
        };
        let lo = if op == INTR_OP_ROTATE_LEFT {
            mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u_ty_v, view(xu), view(inv), sp)
        } else {
            mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u_ty_v, view(xu), view(nm), sp)
        };
        let r = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u_ty_v, view(hi), view(lo), sp);
        if w_ty_v == u_ty_v {
            mb_intr_finish_use(mut_view(*b), view(*dest), view(r), sp);
        } else {
            mb_intr_cast_into(mut_view(*b), view(*dest), view(r), w_ty_v, sp);
        }
    } else if op == INTR_OP_COUNT_ONES {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        let z = mb_intr_zext64(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
        let cnt = mb_intr_popcount64(mut_view(*b), view(z), sp);
        mb_intr_cast_into(mut_view(*b), view(*dest), view(cnt), u32_ty_v, sp);
    } else if op == INTR_OP_LEADING_ZEROS {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        let mut y = mb_intr_zext64(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
        let mut s: u32 = 1u32;
        while s < bits {
            let sc = mb_intr_const_op(u32_ty_v, s as u64);
            let sh = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(y), view(sc), sp);
            y = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u64_ty_v, view(y), view(sh), sp);
            s = s << 1u32;
        }
        let pc = mb_intr_popcount64(mut_view(*b), view(y), sp);
        let ones = mb_intr_cast(mut_view(*b), view(pc), u64_ty_v, u32_ty_v, sp);
        let bits_c = mb_intr_const_op(u32_ty_v, bits as u64);
        let _ = mb_intr_binop_into(mut_view(*b), view(*dest), MIR_BINOP_SUB, view(bits_c), view(ones), sp);
    } else if op == INTR_OP_TRAILING_ZEROS {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        let y = mb_intr_zext64(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
        let one64 = mb_intr_const_op(u64_ty_v, 1u64);
        let ym1 = mb_intr_binop(mut_view(*b), MIR_BINOP_WRAPPING_SUB, u64_ty_v, view(y), view(one64), sp);
        let ny = mb_intr_temp(mut_view(*b), u64_ty_v, sp);
        let mut nrv = MirRvalue {
            kind: MIR_RVALUE_UNARY_OP,
            use_op: mb_intr_copy_op(mir_local_place(0u32)),
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: mb_intr_copy_op(mir_local_place(0u32)),
            rhs: mb_intr_copy_op(mir_local_place(0u32)),
            un_op: MIR_UNOP_BITNOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mir_copy_operand(mut_view(nrv.use_op), view(y));
        mb_emit_assign(mut_view(*b), view(ny), view(nrv), sp);
        let ny_op = mb_intr_copy_op(ny);
        let mut t = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(ny_op), view(ym1), sp);
        if bits < 64u32 {
            let m = mb_intr_const_op(u64_ty_v, (1u64 << (bits as u64)) - 1u64);
            t = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(t), view(m), sp);
        }
        let pc = mb_intr_popcount64(mut_view(*b), view(t), sp);
        mb_intr_cast_into(mut_view(*b), view(*dest), view(pc), u32_ty_v, sp);
    }
    true
}

fn mb_build_control_or_call_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);

    if ek == HIR_EXPR_CALL {
        let callee_expr: *mut HirExpr = unsafe {
            (*expr).callee
        };
        if (callee_expr as usize) != 0 && (unsafe { (*callee_expr).kind }) == HIR_EXPR_PATH {
            if mb_try_build_intrinsic_call(mut_view(*b), expr, mut_view(*dest), has_dest, view(sp)) {
                return;
            }
            let c_ty = mb_expr_ty(mut_view(*b), callee_expr);
            let ct = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: c_ty.v
                }))
            };
            if (ct as usize) != 0 {
                let ck = unsafe {
                    (*ct).kind
                };
                if ck == TY_BUILTIN_DROP {
                    let arg0: *mut HirExpr = unsafe {
                        (*expr).args
                    };
                    let mut arg_op = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(arg_op));
                    let mut arg_pl = mir_local_place(0u32);
                    if arg_op.kind == MIR_OP_COPY || arg_op.kind == MIR_OP_MOVE {
                        mir_copy_place(mut_view(arg_pl), view(arg_op.place));
                    } else {
                        let arg_ty = mb_expr_ty(mut_view(*b), arg0);
                        let temp = mb_new_temp(mut_view(*b), (TypeId {
                            v: arg_ty.v
                        }), view(sp));
                        arg_pl = mir_local_place(temp.v);
                        mb_emit_assign_use(mut_view(*b), view(arg_pl), view(arg_op), view(sp));
                    }
                    let next_bb = mb_new_bb(mut_view(*b), false);
                    let bb = unsafe {
                        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                    };
                    unsafe {
                        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_DROP);
                        (*bb).terminator.span.file.v = sp.file.v;
                        (*bb).terminator.span.start = sp.start;
                        (*bb).terminator.span.end = sp.end;
                        mir_copy_place(mut_view((*bb).terminator.drop_place), view(arg_pl));
                        (*bb).terminator.drop_target.v = next_bb.v;
                        (*bb).terminator.drop_unwind.v = 0u32;
                        (*bb).terminator.drop_is_explicit = true;
                        (*bb).has_terminator = true;
                    }
                    b.curr_bb.v = next_bb.v;
                    b.is_diverged = false;
                    if has_dest {
                        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                        rv.kind = MIR_RVALUE_AGGREGATE;
                        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
                    }
                    return;
                }
                if ck == TY_BUILTIN_LEN {
                    let arg0: *mut HirExpr = unsafe {
                        (*expr).args
                    };
                    let mut arg_op = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(arg_op));
                    let mut arg_pl = mir_local_place(0u32);
                    if arg_op.kind == MIR_OP_COPY || arg_op.kind == MIR_OP_MOVE {
                        mir_copy_place(mut_view(arg_pl), view(arg_op.place));
                    } else {
                        let arg_ty = mb_expr_ty(mut_view(*b), arg0);
                        let temp = mb_new_temp(mut_view(*b), (TypeId {
                            v: arg_ty.v
                        }), view(sp));
                        arg_pl = mir_local_place(temp.v);
                        mb_emit_assign_use(mut_view(*b), view(arg_pl), view(arg_op), view(sp));
                    }
                    let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
