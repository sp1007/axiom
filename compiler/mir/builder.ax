                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: temp_ov.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assign(mut_view(*b), view(cond_not_ov_pl), view(not_rv), view(sp));
            let not_ov_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: cond_not_ov.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assert(mut_view(*b), view(not_ov_op), true, MB_ASSERT_MSG_ARITH_OV, view(sp));
        }
    }

    let mut res_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    res_rv.kind = MIR_RVALUE_BINARY_OP;
    res_rv.bin_op = binop;
    mir_copy_operand(mut_view(res_rv.lhs), view(lhs));
    mir_copy_operand(mut_view(res_rv.rhs), view(rhs));
    mb_emit_assign(mut_view(*b), view(*dest), view(res_rv), view(sp));
}
fn mb_push_loop(
    b: mut_view<MirBuilder>,
    label: StrId,
    break_bb: MirBbId,
    continue_bb: MirBbId,
    dest: view<MirPlace>,
    has_dest: bool
) {
    if b.loop_depth >= b.loop_cap {
        let new_cap: usize = if b.loop_cap == 0 {
            8
        } else {
            b.loop_cap + b.loop_cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirLoopScope>());
        let new_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<MirLoopScope>()) as *mut MirLoopScope
        };
        if b.loop_depth > 0 && (b.loop_stack as usize) != 0 {
            let old_bytes = mir_mul_usize(b.loop_depth, size_of<MirLoopScope>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.loop_stack as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        b.loop_stack = new_arr;
        b.loop_cap = new_cap;
    }
    let ls = unsafe {
        mb_loop_scope_at(b.loop_stack, b.loop_depth)
    };
    unsafe {
        (*ls).label.v = label.v;
        (*ls).break_bb.v = break_bb.v;
        (*ls).continue_bb.v = continue_bb.v;
        mir_copy_place(mut_view((*ls).dest), dest);
        (*ls).has_dest = has_dest;
        (*ls).scope_depth = b.scope_depth;
        (*ls).drop_scope = b.current_drops;
    }
    b.loop_depth = b.loop_depth + 1;
}

fn mb_find_loop(b: view<MirBuilder>, label: StrId) -> *mut MirLoopScope {
    if b.loop_depth == 0 || (b.loop_stack as usize) == 0 {
        return 0 as *mut MirLoopScope;
    }
    if label.v != 0u32 {
        let mut i = b.loop_depth;
        while (i > 0) {
            i = i - 1;
            let ls = unsafe {
                mb_loop_scope_at(b.loop_stack, i)
            };
            if (unsafe { (*ls).label.v }) == label.v {
                return ls;
            }
        }
    }
    unsafe { mb_loop_scope_at(b.loop_stack, b.loop_depth - 1) }
}

fn mb_build_index_special_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    e_ty_v: u32,
    dest: view<MirPlace>,
    has_dest: bool,
    sp: view<Span>
) -> bool {
    let idx_mp = unsafe { thir_get_expr_method(view(*b.thir), expr as *const HirExpr) };
    if (idx_mp as usize) != 0 && (unsafe { *idx_mp as usize }) != 0 {
        let method_item: *mut HirItem = unsafe { (*idx_mp) as *mut HirItem };
        let fn_ty_id = mb_item_ty(mut_view(*b), method_item);
        let fn_ax = unsafe { type_get(view((*b.thir).interner), (TypeId { v: fn_ty_id.v })) };
        let callee_op = MirOperand {
            kind: MIR_OP_CONST,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst {
                ty: TypeId { v: fn_ty_id.v },
                kind: MIR_CONST_FN,
                val: (unsafe { (*method_item).symbol.v }) as u64,
                str_bytes: 0 as *const u8,
                str_len: 0,
                sym: SymbolId { v: unsafe { (*method_item).symbol.v } },
            },
        };
        let args_bytes = mir_mul_usize(2, size_of<MirOperand>());
        let args_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), args_bytes, align_of<MirOperand>()) as *mut MirOperand
        };
        let self_ty = if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).param_count }) > 0 {
            mb_resolve_ty(mut_view(*b), TypeId { v: unsafe { (*typeid_at((*fn_ax).param_types, 0)).v } })
        } else {
            TypeId { v: 0u32 }
        };
        let base_expr: *mut HirExpr = unsafe { (*expr).base };
        let actual_base_ty = mb_expr_ty(mut_view(*b), base_expr);
        let actual_base_t = unsafe { type_get(view((*b.thir).interner), (TypeId { v: actual_base_ty.v })) };
        let self_t = unsafe { type_get(view((*b.thir).interner), (TypeId { v: self_ty.v })) };
        let arg0_dst = unsafe { mir_op_at(args_arr, 0) };
        if (self_t as usize) != 0 && ((unsafe { (*self_t).kind }) == TY_VIEW || (unsafe { (*self_t).kind }) == TY_MUT_VIEW) &&
            (actual_base_t as usize) != 0 && (unsafe { (*actual_base_t).kind }) != TY_VIEW && (unsafe { (*actual_base_t).kind }) != TY_MUT_VIEW {
            let mut dsl0 = false;
            let base_pl = mir_build_lvalue(mut_view(*b), base_expr, mut_view(dsl0));
            let b_sp = Span { file: FileId { v: unsafe { (*base_expr).span.file.v } }, start: unsafe { (*base_expr).span.start }, end: unsafe { (*base_expr).span.end } };
            let tmp0 = mb_new_temp(mut_view(*b), (TypeId { v: self_ty.v }), view(b_sp));
            let tmp0_pl = mir_local_place(tmp0.v);
            let mut ref0 = MirRvalue {
                kind: MIR_RVALUE_REF,
                use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
                repeat_count: 0u64,
                repeat_count_op: 0 as *mut MirOperand,
                borrow_kind: if (unsafe { (*self_t).kind }) == TY_MUT_VIEW { MIR_BORROW_MUT } else { MIR_BORROW_SHARED },
                place: mir_local_place(0u32),
                cast_kind: MIR_CAST_INT_TO_INT,
                target_ty: TypeId { v: 0u32 },
                bin_op: MIR_BINOP_ADD,
                lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
                rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
                un_op: MIR_UNOP_NOT,
                variant_idx: 0u32,
                operands: 0 as *mut MirOperand,
                operand_count: 0,
            };
            mir_copy_place(mut_view(ref0.place), view(base_pl));
            mb_emit_assign(mut_view(*b), view(tmp0_pl), view(ref0), view(b_sp));
            unsafe {
                *arg0_dst = MirOperand {
                    kind: MIR_OP_COPY,
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: tmp0_pl,
                    constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
                };
            }
        } else {
            let mut op0 = MirOperand {
                kind: MIR_OP_COPY,
                location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                place: mir_local_place(0u32),
                constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
            };
            mb_build_expr_as_operand(mut_view(*b), base_expr, mut_view(op0));
            unsafe { mir_copy_operand(mut_view(*arg0_dst), view(op0)); }
        }
        let arg1_dst = unsafe { mir_op_at(args_arr, 1) };
        let mut op1 = MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        };
        mb_build_expr_as_operand(mut_view(*b), unsafe { (*expr).index_arg }, mut_view(op1));
        unsafe { mir_copy_operand(mut_view(*arg1_dst), view(op1)); }
        unsafe {
            mb_consume_op(mut_view(*b), view(*arg0_dst));
            mb_consume_op(mut_view(*b), view(*arg1_dst));
        }
        let next_bb = mb_new_bb(mut_view(*b), false);
        let bb = unsafe { mir_bb_at((*b.body).bbs, b.curr_bb.v as usize) };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_CALL);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            mir_copy_operand(mut_view((*bb).terminator.func), view(callee_op));
            (*bb).terminator.args = args_arr;
            (*bb).terminator.arg_count = 2;
            mir_copy_place(mut_view((*bb).terminator.destination), view(*dest));
            (*bb).terminator.has_destination = has_dest;
            (*bb).terminator.call_target.v = next_bb.v;
            (*bb).terminator.call_unwind.v = 0u32;
            (*bb).has_terminator = true;
        }
        b.curr_bb.v = next_bb.v;
        b.is_diverged = false;
        return true;
    }
    let idx_arg_e: *mut HirExpr = unsafe { (*expr).index_arg };
    if (idx_arg_e as usize) != 0 && (unsafe { (*idx_arg_e).kind }) == HIR_EXPR_RANGE {
        let mut dsl_r = false;
        let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dsl_r));
        if has_dest {
            let t = unsafe { type_get(view((*b.thir).interner), (TypeId { v: e_ty_v })) };
            let bk = if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_MUT_VIEW {
                MIR_BORROW_MUT
            } else {
                MIR_BORROW_SHARED
            };
            let mut ref_rv = MirRvalue {
                kind: MIR_RVALUE_REF,
                use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
                repeat_count: 0u64,
                repeat_count_op: 0 as *mut MirOperand,
                borrow_kind: bk,
                place: mir_local_place(0u32),
                cast_kind: MIR_CAST_INT_TO_INT,
                target_ty: TypeId { v: 0u32 },
                bin_op: MIR_BINOP_ADD,
                lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
                rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
                un_op: MIR_UNOP_NOT,
                variant_idx: 0u32,
                operands: 0 as *mut MirOperand,
                operand_count: 0,
            };
            mir_copy_place(mut_view(ref_rv.place), view(p));
            mb_emit_assign(mut_view(*b), view(*dest), view(ref_rv), sp);
        }
        return true;
    }
    false
}

pub fn mir_build_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    if (expr as usize) == 0 || b.is_diverged {
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);

    // Check if expression is an enum variant constructor in THIR
    let vp = unsafe {
        thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
    };
    if (vp as usize) != 0 && (unsafe { *vp }) < 256u32 {
        let v_idx = unsafe {
            *vp
        };
        let mut arg_head: *mut HirExpr = 0 as *mut HirExpr;
        if ek == HIR_EXPR_CALL {
            arg_head = unsafe {
                (*expr).args
            };
        } else if ek == HIR_EXPR_METHOD_CALL {
            arg_head = unsafe {
                (*expr).args
            };
        }
        let mut f_count: usize = 0;
        let mut cur_a = arg_head;
        while ((cur_a as usize) != 0) {
            f_count = f_count + 1;
            cur_a = unsafe {
                (*cur_a).next
            };
        }
        let mut ops: *mut MirOperand = 0 as *mut MirOperand;
        if f_count > 0 {
            let bytes = mir_mul_usize(f_count, size_of<MirOperand>());
            ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut idx: usize = 0;
            cur_a = arg_head;
            while ((cur_a as usize) != 0) {
                let mut op_i = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_build_expr_as_operand(mut_view(*b), cur_a, mut_view(op_i));
                let dst_op = unsafe {
                    mir_op_at(ops, idx)
                };
                unsafe {
                    mir_copy_operand(mut_view(*dst_op), view(op_i));
                }
                idx = idx + 1;
                cur_a = unsafe {
                    (*cur_a).next
                };
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = v_idx;
        rv.operands = ops;
        rv.operand_count = f_count;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    if ek == HIR_EXPR_INDEX {
        if mb_build_index_special_expr(mut_view(*b), expr, e_ty.v, view(*dest), has_dest, view(sp)) {
            return;
        }
    }

    if ek == HIR_EXPR_LITERAL || ek == HIR_EXPR_PATH || ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX || ek == HIR_EXPR_INDEX {
        let mut op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), expr, mut_view(op));
        if has_dest {
            mb_emit_assign_use(mut_view(*b), view(*dest), view(op), view(sp));
        }
        return;
    }

    if ek == HIR_EXPR_BINARY {
        mb_build_binary_expr(mut_view(*b), expr, dest);
        return;
    }

    if ek == HIR_EXPR_UNARY {
        let uop = unsafe {
            (*expr).op
        };
        if uop == UNOP_DEREF {
            let mut dummy_sl = false;
            let pl = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            let mut op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
