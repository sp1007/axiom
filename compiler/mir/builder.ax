            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                rv.kind = MIR_RVALUE_AGGREGATE;
                rv.variant_idx = 0u32;
                rv.operands = ops;
                rv.operand_count = num_ops;
                mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
            }
        }
        return;
    }
}

// =============================================================================
// Statement, Block & Function/Closure Entry Points
// =============================================================================

pub fn mir_build_stmt(b: mut_view<MirBuilder>, stmt: *mut HirStmt) {
    if (stmt as usize) == 0 || b.is_diverged {
        return;
    }
    let sk = unsafe {
        (*stmt).kind
    };
    let sp = Span {
        file: FileId { v: unsafe { (*stmt).span.file.v } },
        start: unsafe { (*stmt).span.start },
        end: unsafe { (*stmt).span.end },
    };

    if sk == HIR_STMT_LET {
        let pat: *mut HirPat = unsafe {
            (*stmt).pat
        };
        let init_expr: *mut HirExpr = unsafe {
            (*stmt).expr
        };
        let else_blk: *mut HirBlock = unsafe {
            (*stmt).else_block
        };
        let mut p_ty = mb_pat_ty(mut_view(*b), pat);
        if p_ty.v == 0u32 && (init_expr as usize) != 0 {
            p_ty = mb_expr_ty(mut_view(*b), init_expr);
        }
        if (init_expr as usize) != 0 {
            let tmp = mb_new_temp(mut_view(*b), (TypeId {
                v: p_ty.v
            }), view(sp));
            let mut tmp_pl = mir_local_place(tmp.v);
            mir_build_expr(mut_view(*b), init_expr, mut_view(tmp_pl), true);
            if !b.is_diverged {
                if (else_blk as usize) != 0 {
                    let ok_bb = mb_new_bb(mut_view(*b), false);
                    let fail_bb = mb_new_bb(mut_view(*b), false);
                    mb_build_pat_match(mut_view(*b), pat, view(tmp_pl), (TypeId {
                        v: p_ty.v
                    }), (MirBbId {
                        v: ok_bb.v
                    }), (MirBbId {
                        v: fail_bb.v
                    }));
                    b.curr_bb.v = fail_bb.v;
                    b.is_diverged = false;
                    let mut dummy_pl = mir_local_place(0u32);
                    mir_build_block(mut_view(*b), else_blk, mut_view(dummy_pl), false);
                    if !b.is_diverged {
                        let fbb = unsafe {
                            mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                        };
                        unsafe {
                            mir_term_zero(mut_view((*fbb).terminator), MIR_TERM_UNREACHABLE);
                            (*fbb).terminator.span.file.v = sp.file.v;
                            (*fbb).terminator.span.start = sp.start;
                            (*fbb).terminator.span.end = sp.end;
                            (*fbb).has_terminator = true;
                        }
                    }
                    b.curr_bb.v = ok_bb.v;
                    b.is_diverged = false;
                } else {
                    mb_build_pat_match_in_place(mut_view(*b), pat, view(tmp_pl), (TypeId {
                        v: p_ty.v
                    }), MirBbId {
                        v: 0u32
                    });
                }
            }
        } else {
            mb_declare_pat_locals(mut_view(*b), pat, (TypeId {
                v: p_ty.v
            }));
        }
    } else if sk == HIR_STMT_ASSIGN {
        let lhs_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*stmt).left
        });
        if unsafe { mir_type_needs_drop_in((TypeId { v: lhs_ty.v }), view(*b.thir), view(*b.hir), b.db, view(*b.str_in)) } {
            // SPEC-03 AXS-SEM-043: (1) evaluate rhs into a temporary, (2) evaluate the place,
            // (3) drop the old value, (4) move the temporary into the place. Places reached
            // through a raw-pointer deref are raw stores (std writes uninitialised slots with
            // `*p = v`); places reached only through view/mut_view derefs drop the old value.
            // Mirrors axiom0 mir/build/builder.c AX_HIR_STMT_ASSIGN.
            let tmp = mb_new_temp(mut_view(*b), (TypeId {
                v: lhs_ty.v
            }), view(sp));
            let mut tmp_pl = mir_local_place(tmp.v);
            mir_build_expr(mut_view(*b), unsafe {
                (*stmt).right
            }, mut_view(tmp_pl), true);
            let mut dummy_sl = false;
            let mut lhs_pl = mir_build_lvalue(mut_view(*b), unsafe {
                (*stmt).left
            }, mut_view(dummy_sl));
            if lhs_pl.local.v != 0u32 && !mb_place_has_raw_deref(view(*b), view(lhs_pl)) && !b.is_diverged {
                let next_bb = mb_new_bb(mut_view(*b), false);
                let bb = unsafe {
                    mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb).terminator), MIR_TERM_DROP);
                    (*bb).terminator.span.file.v = sp.file.v;
                    (*bb).terminator.span.start = sp.start;
                    (*bb).terminator.span.end = sp.end;
                    mir_copy_place(mut_view((*bb).terminator.drop_place), view(lhs_pl));
                    (*bb).terminator.drop_target.v = next_bb.v;
                    (*bb).terminator.drop_unwind.v = 0u32;
                    (*bb).has_terminator = true;
                }
                b.curr_bb.v = next_bb.v;
                b.is_diverged = false;
            }
            if !b.is_diverged {
                let mut mv_op = MirOperand {
                    kind: MIR_OP_MOVE, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: mir_local_place(tmp.v), constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_emit_assign_use(mut_view(*b), view(lhs_pl), view(mv_op), view(sp));
            }
        } else {
            let mut dummy_sl = false;
            let mut lhs_pl = mir_build_lvalue(mut_view(*b), unsafe {
                (*stmt).left
            }, mut_view(dummy_sl));
            mir_build_expr(mut_view(*b), unsafe {
                (*stmt).right
            }, mut_view(lhs_pl), true);
        }
    } else if sk == HIR_STMT_EXPR {
        let e: *mut HirExpr = unsafe {
            (*stmt).expr
        };
        let e_ty = mb_expr_ty(mut_view(*b), e);
        if e_ty.v != 0u32 {
            let tmp = mb_new_temp(mut_view(*b), (TypeId {
                v: e_ty.v
            }), view(sp));
            let mut tmp_pl = mir_local_place(tmp.v);
            mir_build_expr(mut_view(*b), e, mut_view(tmp_pl), true);
        } else {
            let mut void_pl = mir_local_place(0u32);
            mir_build_expr(mut_view(*b), e, mut_view(void_pl), false);
        }
    }
}

pub fn mir_build_block(
    b: mut_view<MirBuilder>,
    blk: *mut HirBlock,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    if (blk as usize) == 0 || b.is_diverged {
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*blk).span.file.v } },
        start: unsafe { (*blk).span.start },
        end: unsafe { (*blk).span.end },
    };
    let old_drops: *mut MirDropNode = b.current_drops;
    let mut st: *mut HirStmt = unsafe {
        (*blk).stmts
    };
    while ((st as usize) != 0 && !b.is_diverged) {
        let next_st: *mut HirStmt = unsafe {
            (*st).next
        };
        let st_sp = Span {
            file: FileId { v: unsafe { (*st).span.file.v } },
            start: unsafe { (*st).span.start },
            end: unsafe { (*st).span.end },
        };
        if (next_st as usize) == 0 && (unsafe { (*st).kind }) == HIR_STMT_EXPR && !(unsafe { (*st).has_semi }) {
            mir_build_expr(mut_view(*b), unsafe {
                (*st).expr
            }, mut_view(*dest), has_dest);
        } else {
            mir_build_stmt(mut_view(*b), st);
        }
        // Cleanup temporaries
        if !b.is_diverged {
            let mut curr: *mut MirDropNode = b.current_drops;
            let mut prev: *mut MirDropNode = 0 as *mut MirDropNode;
            while ((curr as usize) != (old_drops as usize) && (curr as usize) != 0) {
                let is_tmp = unsafe {
                    (*curr).is_temp
                };
                let nxt = unsafe {
                    (*curr).next
                };
                if is_tmp {
                    let next_bb = mb_new_bb(mut_view(*b), false);
                    let bb = unsafe {
                        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                    };
                    unsafe {
                        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_DROP);
                        (*bb).terminator.span.file.v = st_sp.file.v;
                        (*bb).terminator.span.start = st_sp.start;
                        (*bb).terminator.span.end = st_sp.end;
                        mir_copy_place(mut_view((*bb).terminator.drop_place), view((*curr).place));
                        (*bb).terminator.drop_target.v = next_bb.v;
                        (*bb).terminator.drop_unwind.v = 0u32;
                        (*bb).has_terminator = true;
                    }
                    b.curr_bb.v = next_bb.v;
                    b.is_diverged = false;
                    if (prev as usize) != 0 {
                        unsafe {
                            (*prev).next = nxt;
                        }
                    } else {
                        b.current_drops = nxt;
                    }
                    curr = nxt;
                } else {
                    prev = curr;
                    curr = nxt;
                }
            }
        }
        st = next_st;
    }
    if !b.is_diverged {
        mb_build_drop_chain(mut_view(*b), b.current_drops, old_drops, MirBbId {
            v: 0u32
        }, view(sp));
    }
    b.current_drops = old_drops;
}

pub fn mir_build_closure(
    arena: mut_view<Arena>,
    closure_expr: *mut HirExpr,
    closure_ty: TypeId,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase,
    mono: *mut MonoEngine,
    subst_args: view<GenericArgsSlice>
) -> *mut MirBody {
    if (closure_expr as usize) == 0 {
        return 0 as *mut MirBody;
    }
    let body = mir_body_new(mut_view(*arena));
    let mut b = MirBuilder {
        arena: unsafe { address_of_mut(arena.head) as *mut Arena },
        thir: thir,
        hir: hir,
        str_in: str_in,
        db: db,
        mono: mono,
        subst_args: GenericArgsSlice {
            args: subst_args.args,
            count: subst_args.count,
        },
        body: body,
        curr_bb: MirBbId { v: 0u32 },
        sym_map: 0 as *mut MirSymLocalMapEntry,
        sym_map_count: 0,
        sym_map_cap: 0,
        loop_stack: 0 as *mut MirLoopScope,
        loop_depth: 0,
        loop_cap: 0,
        scopes: 0 as *mut MirDeferScope,
        scope_depth: 0,
        scope_cap: 0,
        current_drops: 0 as *mut MirDropNode,
        is_diverged: false,
        unwind_bb: MirBbId { v: 0u32 },
        has_unwind_bb: false,
        closure_env_local: MirLocalId { v: 0u32 },
        closure_captures: 0 as *const ClosureCapture,
        closure_capture_count: 0,
        closure_head: 0 as *mut MirClosureBodyEntry,
        closure_tail: 0 as *mut MirClosureBodyEntry,
        self_impl: 0 as *const HirItem,
    };
    let sp = Span {
        file: FileId { v: unsafe { (*closure_expr).span.file.v } },
        start: unsafe { (*closure_expr).span.start },
        end: unsafe { (*closure_expr).span.end },
    };
    unsafe {
        (*body).span.file.v = sp.file.v;
        (*body).span.start = sp.start;
        (*body).span.end = sp.end;
    }

    let c_ax = unsafe {
        type_get(view((*thir).interner), (TypeId {
            v: closure_ty.v
        }))
    };
    let mut ret_ty = mb_expr_ty(mut_view(b), unsafe {
        (*closure_expr).body
    });
    if (c_ax as usize) != 0 && (unsafe { (*c_ax).kind }) == TY_CLOSURE {
        unsafe {
            (*body).sym.v = (*c_ax).fn_sym;
        }
        let fn_ty = TypeId {
            v: unsafe {
                (*c_ax).fn_type.v
            }
        };
        let fn_ax = unsafe {
            type_get(view((*thir).interner), (TypeId {
                v: fn_ty.v
            }))
        };
        if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).kind }) == TY_FN {
            ret_ty = mb_resolve_ty(mut_view(b), TypeId {
                v: unsafe {
                    (*fn_ax).ret_type.v
                }
            });
        }
        b.closure_captures = unsafe {
            (*c_ax).captures
        };
        b.closure_capture_count = unsafe {
            (*c_ax).capture_count
        };
    }

    mb_new_local(mut_view(b), (TypeId {
        v: ret_ty.v
    }), MIR_LOCAL_RETURN, true, StrId {
        v: 0u32
    }, view(sp));

    let mut arg_cnt: usize = 0;
    if b.closure_capture_count > 0 {
        let ti = unsafe {
            mut_view((*thir).interner)
        };
        let env_ptr_ty = intern_ptr_ty(ti, (TypeId {
            v: closure_ty.v
        }), true);
        let env_loc = mb_new_local(mut_view(b), (TypeId {
            v: env_ptr_ty.v
        }), MIR_LOCAL_ARG, false, StrId {
            v: 0u32
        }, view(sp));
        b.closure_env_local.v = env_loc.v;
        arg_cnt = arg_cnt + 1;
    }

    let mut p: *mut HirParam = unsafe {
        (*closure_expr).params
    };
    while ((p as usize) != 0) {
        let p_ty = mb_param_ty(mut_view(b), p);
        let p_sp = Span {
            file: FileId { v: unsafe { (*p).span.file.v } },
            start: unsafe { (*p).span.start },
            end: unsafe { (*p).span.end },
        };
        let loc = mb_new_local(mut_view(b), (TypeId {
            v: p_ty.v
        }), MIR_LOCAL_ARG, unsafe {
            (*p).is_mut
        }, StrId {
            v: unsafe {
                (*p).name.v
            }
        }, view(p_sp));
        let loc_pl = mir_local_place(loc.v);
        mb_push_drop(mut_view(b), view(loc_pl), (TypeId {
            v: p_ty.v
        }), false, view(p_sp));
        mb_register_sym(mut_view(b), SymbolId {
            v: unsafe {
                (*p).symbol.v
            }
        }, (MirLocalId {
            v: loc.v
        }), false);
        arg_cnt = arg_cnt + 1;
        p = unsafe {
            (*p).next
        };
    }
    unsafe {
        (*body).arg_count = arg_cnt;
    }

    b.curr_bb = mb_new_bb(mut_view(b), false);
    let mut ret_pl = mir_local_place(0u32);
    mir_build_expr(mut_view(b), unsafe {
        (*closure_expr).body
    }, mut_view(ret_pl), true);

    if !b.is_diverged {
        mb_build_drop_chain(mut_view(b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
            v: 0u32
        }, view(sp));
        let bb = unsafe {
            mir_bb_at((*body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            (*bb).has_terminator = true;
        }
    }
    body
}

// T161: must equal TC_SELF_PARAM_INDEX (compiler/types/typeck.ax) and axiom0 BUILD_SELF_PARAM_INDEX.
pub const MB_SELF_PARAM_INDEX: u32 = 0xFFFFFF00u32;

// T161: `Self.NAME` in a trait default body, built as the instance for b.self_impl, reads the constant of
// that impl (0133 §14; axiom0 builder.c self_impl_const). Any other constant reference is returned unchanged.
fn mb_self_impl_const(b: view<MirBuilder>, field_expr: *const HirExpr, m: *const HirItem) -> *const HirItem {
    if (b.self_impl as usize) == 0 || (m as usize) == 0 || (field_expr as usize) == 0 {
        return m;
    }
    if (unsafe { (*m).kind }) != HIR_ITEM_CONST {
        return m;
    }
    let base: *mut HirExpr = unsafe { (*field_expr).base };
    let bt_ptr = unsafe { thir_get_expr_type(view(*b.thir), base as *const HirExpr) };
    if (bt_ptr as usize) == 0 {
        return m;
    }
    let bt_v = unsafe { (*bt_ptr).v };
    if bt_v == 0u32 {
        return m;
    }
    let bt = unsafe { type_get(view((*b.thir).interner), TypeId { v: bt_v }) };
    if (bt as usize) == 0 {
        return m;
    }
    if (unsafe { (*bt).kind }) != TY_PARAM {
        return m;
    }
    if (unsafe { (*bt).param_index }) != MB_SELF_PARAM_INDEX {
        return m;
    }
    let m_name_v = unsafe { (*m).name.v };
    let mut im: *mut HirItem = unsafe { (*b.self_impl).members };
    while (im as usize) != 0 {
        if (unsafe { (*im).kind }) == HIR_ITEM_CONST && (unsafe { (*im).name.v }) == m_name_v {
            return im as *const HirItem;
        }
        im = unsafe { (*im).next };
    }
    m
}

fn mb_subst_self_op(thir: *mut Thir, op: *mut MirOperand, self_v: u32) {
    if (op as usize) == 0 {
        return;
    }
    if (unsafe { (*op).kind }) == MIR_OP_CONST {
        let no_args = GenericArgsSlice { args: 0 as *mut TypeId, count: 0 };
        let t = unsafe { subst_ty_self(mut_view((*thir).interner), TypeId { v: (*op).constant.ty.v }, view(no_args), self_v) };
        unsafe { (*op).constant.ty.v = t.v; }
    }
}

// The trait that declares the fn symbol `sym_v` (its member in out_member), or null.
fn mb_trait_of_member(hir: *const HirFile, sym_v: u32, out_member: mut_view<*mut HirItem>) -> *mut HirItem {
    let mut it: *mut HirItem = unsafe { (*hir).items };
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).symbol.v }) == sym_v {
                    *out_member = m;
                    return it;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

// The member named `name_v` (original name) of an impl for the receiver type: of an impl of trait `tr` first,
// of any trait impl otherwise (axiom0 mono.c impl_member_for).
fn mb_impl_member_for(b: view<MirBuilder>, tr: *mut HirItem, name_v: u32, recv_v: u32) -> *mut HirItem {
    let mut pass: u32 = 0u32;
    while pass < 2u32 {
        let mut it: *mut HirItem = unsafe { (*b.hir).items };
        while (it as usize) != 0 {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && (tp as usize) != 0 {
                let mut of_trait = true;
                if pass == 0u32 {
                    let itr = unsafe { find_trait_by_type_path(view(*b.hir), tp, view(*b.str_in), view(*b.db)) };
                    of_trait = (itr as usize) == (tr as usize);
                }
                if of_trait {
                    let recv_t = TypeId { v: recv_v };
                    let recv_ok = unsafe { impl_matches_receiver(view((*b.thir).interner), view(*b.str_in), it, recv_t) };
                    if recv_ok {
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while (m as usize) != 0 {
                            if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                                if mb_orig_fn_name_v(b.thir as *const Thir, m as *const HirItem) == name_v {
                                    return m;
                                }
                            }
                            m = unsafe { (*m).next };
                        }
                    }
                }
            }
            it = unsafe { (*it).next };
        }
        pass = pass + 1u32;
    }
    0 as *mut HirItem
}

fn mb_sv_is_self(sv: view<StrView>) -> bool {
    if sv.len != 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 101u8 && *(sv.ptr + 2) == 108u8 && *(sv.ptr + 3) == 102u8
    }
}

fn mb_tm_has_self(b: view<MirBuilder>, tm: *const HirItem) -> bool {
    if (tm as usize) == 0 {
        return false;
    }
    let p0: *mut HirParam = unsafe { (*tm).params };
    if (p0 as usize) == 0 {
        return false;
    }
    let mut sv = StrView { ptr: 0 as *const u8, len: 0 };
    let nv = unsafe { (*p0).name.v };
    if nv != 0u32 && (b.str_in as usize) != 0 {
        sv = unsafe { interner_get(view(*b.str_in), StrId { v: nv }) };
    } else {
        let sp = Span {
            file: FileId { v: unsafe { (*p0).span.file.v } },
            start: unsafe { (*p0).span.start },
            end: unsafe { (*p0).span.end },
        };
        sv = mb_span_sv(b, view(sp));
    }
    mb_sv_is_self(view(sv))
}

// T161 (axiom0 driver/mono.c ax_mono_instantiate_default): the MIR built from the shared body of a trait default
// method becomes the body of its instance for one implementing type: `Self` is replaced by that type (the one
// typeck recorded under the item address tagged with 2), and every call of a trait member whose receiver now has
// a concrete type is bound to that type's impl member (an override or the type's own default instance).
fn mb_instantiate_default(b: view<MirBuilder>, func: *mut HirItem) {
    let st_ptr = unsafe { thir_get_item_type(view(*b.thir), ((func as usize) | 2) as *const HirItem) };
    if (st_ptr as usize) == 0 {
        return;
    }
    let self_v = unsafe { (*st_ptr).v };
    if self_v == 0u32 {
        return;
    }
    let body = b.body;
    let thir = b.thir;
    let no_args = GenericArgsSlice { args: 0 as *mut TypeId, count: 0 };
    let lcnt = unsafe { (*body).local_count };
    let mut li: usize = 0;
    while li < lcnt {
        let l = unsafe { mir_local_at((*body).locals, li) };
        let t = unsafe { subst_ty_self(mut_view((*thir).interner), TypeId { v: (*l).ty.v }, view(no_args), self_v) };
        unsafe { (*l).ty.v = t.v; }
        li = li + 1;
    }
    let bcnt = unsafe { (*body).bb_count };
    let mut bi: usize = 0;
    while bi < bcnt {
        let bb = unsafe { mir_bb_at((*body).bbs, bi) };
        let scnt = unsafe { (*bb).stmt_count };
        let mut si: usize = 0;
        while si < scnt {
            let st = unsafe { mir_stmt_at((*bb).stmts, si) };
            if (unsafe { (*st).kind }) == MIR_STMT_ASSIGN {
                let rk = unsafe { (*st).rvalue.kind };
                if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP {
                    mb_subst_self_op(thir, unsafe { address_of_mut((*st).rvalue.use_op) }, self_v);
                } else if rk == MIR_RVALUE_REPEAT {
                    mb_subst_self_op(thir, unsafe { address_of_mut((*st).rvalue.use_op) }, self_v);
                    mb_subst_self_op(thir, unsafe { (*st).rvalue.repeat_count_op }, self_v);
                } else if rk == MIR_RVALUE_CAST {
                    let ct = unsafe { subst_ty_self(mut_view((*thir).interner), TypeId { v: (*st).rvalue.target_ty.v }, view(no_args), self_v) };
                    unsafe { (*st).rvalue.target_ty.v = ct.v; }
                    mb_subst_self_op(thir, unsafe { address_of_mut((*st).rvalue.use_op) }, self_v);
                } else if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                    mb_subst_self_op(thir, unsafe { address_of_mut((*st).rvalue.lhs) }, self_v);
                    mb_subst_self_op(thir, unsafe { address_of_mut((*st).rvalue.rhs) }, self_v);
                } else if rk == MIR_RVALUE_AGGREGATE {
                    let ocnt = unsafe { (*st).rvalue.operand_count };
                    let mut oi: usize = 0;
                    while oi < ocnt {
                        mb_subst_self_op(thir, unsafe { mir_op_at((*st).rvalue.operands, oi) }, self_v);
                        oi = oi + 1;
                    }
                }
            }
            si = si + 1;
        }
        if unsafe { (*bb).has_terminator } {
            let tk = unsafe { (*bb).terminator.kind };
            if tk == MIR_TERM_CALL {
                mb_subst_self_op(thir, unsafe { address_of_mut((*bb).terminator.func) }, self_v);
                let acnt = unsafe { (*bb).terminator.arg_count };
                let mut ai: usize = 0;
                while ai < acnt {
                    mb_subst_self_op(thir, unsafe { mir_op_at((*bb).terminator.args, ai) }, self_v);
                    ai = ai + 1;
                }
            } else if tk == MIR_TERM_SWITCH_INT {
                mb_subst_self_op(thir, unsafe { address_of_mut((*bb).terminator.discr) }, self_v);
            } else if tk == MIR_TERM_ASSERT {
                mb_subst_self_op(thir, unsafe { address_of_mut((*bb).terminator.cond) }, self_v);
            }
        }
        bi = bi + 1;
    }
    // Bind the calls of trait members whose receiver is now concrete.
    bi = 0;
    while bi < bcnt {
        let bb = unsafe { mir_bb_at((*body).bbs, bi) };
        let mut is_call = unsafe { (*bb).has_terminator };
        if is_call {
            is_call = (unsafe { (*bb).terminator.kind }) == MIR_TERM_CALL;
        }
        if is_call {
            is_call = (unsafe { (*bb).terminator.func.kind }) == MIR_OP_CONST;
        }
        if is_call {
            let fty_v = unsafe { (*bb).terminator.func.constant.ty.v };
            let mut fn_kind = false;
            if fty_v != 0u32 {
                let ft = unsafe { type_get(view((*b.thir).interner), TypeId { v: fty_v }) };
                if (ft as usize) != 0 {
                    fn_kind = (unsafe { (*ft).kind }) == TY_FN;
                }
            }
            if fn_kind {
                let mut sym_v: u32 = unsafe { (*bb).terminator.func.constant.sym.v };
                if sym_v == 0u32 {
                    sym_v = (unsafe { (*bb).terminator.func.constant.val }) as u32;
                }
                let mut tm: *mut HirItem = 0 as *mut HirItem;
                let tr = mb_trait_of_member(b.hir, sym_v, mut_view(tm));
                if (tr as usize) != 0 {
                    let has_self = mb_tm_has_self(b, tm as *const HirItem);
                    let mut recv_v: u32 = 0u32;
                    if has_self {
                        if (unsafe { (*bb).terminator.arg_count }) > 0 {
                            let a0 = unsafe { mir_op_at((*bb).terminator.args, 0) };
                            if (unsafe { (*a0).kind }) == MIR_OP_CONST {
                                recv_v = unsafe { (*a0).constant.ty.v };
                            } else if (unsafe { (*a0).place.local.v as usize }) < lcnt {
                                let l0 = unsafe { mir_local_at((*body).locals, (*a0).place.local.v as usize) };
                                recv_v = unsafe { (*l0).ty.v };
                            }
                        }
                    } else {
                        recv_v = self_v;
                    }
                    if recv_v != 0u32 {
                        let tm_name_v = mb_orig_fn_name_v(b.thir as *const Thir, tm as *const HirItem);
                        let m = mb_impl_member_for(b, tr, tm_name_v, recv_v);
                        if (m as usize) != 0 {
                            let m_sv = unsafe { (*m).symbol.v };
                            unsafe {
                                (*bb).terminator.func.constant.sym.v = m_sv;
                                (*bb).terminator.func.constant.val = m_sv as u64;
                            }
                            let mty = unsafe { thir_get_item_type(view(*b.thir), m as *const HirItem) };
                            if (mty as usize) != 0 {
                                if (unsafe { (*mty).v }) != 0u32 {
                                    unsafe { (*bb).terminator.func.constant.ty.v = (*mty).v; }
                                }
                            }
                        }
                    }
                }
            }
        }
        bi = bi + 1;
    }
}

pub fn mir_build_fn_subst(
    arena: mut_view<Arena>,
    func: *mut HirItem,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase,
    mono: *mut MonoEngine,
    subst_args: view<GenericArgsSlice>
) -> *mut MirBody {
    if (func as usize) == 0 || (unsafe { (*func).kind }) != HIR_ITEM_FN || (unsafe { (*func).body as usize }) == 0 {
        return 0 as *mut MirBody;
    }
    if mb_is_intrinsic_fn(str_in, db, func) {
        return 0 as *mut MirBody;
    }
    if (unsafe { (*func).generic_params as usize }) != 0 {
        if mb_has_intrinsic_attr(str_in, db, func) {
            return 0 as *mut MirBody;
        }
    }
    let body = mir_body_new(mut_view(*arena));
    let mut b = MirBuilder {
        arena: unsafe { address_of_mut(arena.head) as *mut Arena },
        thir: thir,
        hir: hir,
        str_in: str_in,
        db: db,
        mono: mono,
        subst_args: GenericArgsSlice {
            args: subst_args.args,
            count: subst_args.count,
        },
        body: body,
        curr_bb: MirBbId { v: 0u32 },
        sym_map: 0 as *mut MirSymLocalMapEntry,
        sym_map_count: 0,
        sym_map_cap: 0,
        loop_stack: 0 as *mut MirLoopScope,
        loop_depth: 0,
        loop_cap: 0,
        scopes: 0 as *mut MirDeferScope,
        scope_depth: 0,
        scope_cap: 0,
        current_drops: 0 as *mut MirDropNode,
        is_diverged: false,
        unwind_bb: MirBbId { v: 0u32 },
        has_unwind_bb: false,
        closure_env_local: MirLocalId { v: 0u32 },
        closure_captures: 0 as *const ClosureCapture,
        closure_capture_count: 0,
        closure_head: 0 as *mut MirClosureBodyEntry,
        closure_tail: 0 as *mut MirClosureBodyEntry,
        self_impl: 0 as *const HirItem,
    };
    // T161: typeck records the impl of a default-method instance under the instance item's address tagged
    // with 2 (items are 8-aligned; the drop-impl keys use tag 1).
    let impl_pp = unsafe { thir_get_expr_method(view(*thir), ((func as usize) | 2) as *const HirExpr) };
    if (impl_pp as usize) != 0 {
        b.self_impl = unsafe { *impl_pp };
    }
    let sp = Span {
        file: FileId { v: unsafe { (*func).span.file.v } },
        start: unsafe { (*func).span.start },
        end: unsafe { (*func).span.end },
    };
    unsafe {
        (*body).span.file.v = sp.file.v;
        (*body).span.start = sp.start;
        (*body).span.end = sp.end;
        (*body).sym.v = (*func).symbol.v;
    }

    let fn_ty = mb_item_ty(mut_view(b), func);
    let fn_ax = unsafe {
        type_get(view((*thir).interner), (TypeId {
            v: fn_ty.v
        }))
    };
    let mut ret_ty = TypeId {
        v: 0u32
    };
    if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).kind }) == TY_FN {
        ret_ty = mb_resolve_ty(mut_view(b), TypeId {
            v: unsafe {
                (*fn_ax).ret_type.v
            }
        });
    }

    mb_new_local(mut_view(b), (TypeId {
        v: ret_ty.v
    }), MIR_LOCAL_RETURN, true, StrId {
        v: 0u32
    }, view(sp));

    let mut param_idx: usize = 0;
    let mut p: *mut HirParam = unsafe {
        (*func).params
    };
    while ((p as usize) != 0) {
        let mut p_ty = mb_param_ty(mut_view(b), p);
        if p_ty.v == 0u32 && (fn_ax as usize) != 0 && (unsafe { (*fn_ax).kind }) == TY_FN && param_idx < (unsafe { (*fn_ax).param_count }) {
            let pt_ptr = unsafe {
                typeid_at((*fn_ax).param_types, param_idx)
            };
            p_ty = mb_resolve_ty(mut_view(b), TypeId {
                v: unsafe {
                    (*pt_ptr).v
                }
            });
        }
        let p_sp = Span {
            file: FileId { v: unsafe { (*p).span.file.v } },
            start: unsafe { (*p).span.start },
            end: unsafe { (*p).span.end },
        };
        let loc = mb_new_local(mut_view(b), (TypeId {
            v: p_ty.v
        }), MIR_LOCAL_ARG, unsafe {
            (*p).is_mut
        }, StrId {
            v: unsafe {
                (*p).name.v
            }
        }, view(p_sp));
        let loc_pl = mir_local_place(loc.v);
        mb_push_drop(mut_view(b), view(loc_pl), (TypeId {
            v: p_ty.v
        }), false, view(p_sp));
        mb_register_sym(mut_view(b), SymbolId {
            v: unsafe {
                (*p).symbol.v
            }
        }, (MirLocalId {
            v: loc.v
        }), false);
        param_idx = param_idx + 1;
        p = unsafe {
            (*p).next
        };
    }
    unsafe {
        (*body).arg_count = param_idx;
    }

    b.curr_bb = mb_new_bb(mut_view(b), false);
    let mut ret_pl = mir_local_place(0u32);
    mir_build_block(mut_view(b), unsafe {
        (*func).body
    }, mut_view(ret_pl), true);

    if !b.is_diverged {
        mb_build_drop_chain(mut_view(b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
            v: 0u32
        }, view(sp));
        let bb = unsafe {
            mir_bb_at((*body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            (*bb).has_terminator = true;
        }
    }
    if (b.self_impl as usize) != 0 {
        mb_instantiate_default(view(b), func);
    }
    body
}

fn mb_count_generic_params(it: *const HirItem) -> usize {
    if (it as usize) == 0 {
        return 0;
    }
    let gps = unsafe { (*it).generic_params };
    if (gps as usize) == 0 {
        return 0;
    }
    let mut n: usize = 0;
    let mut p: *mut HirGenericParam = unsafe { (*gps).params };
    while ((p as usize) != 0) {
        n = n + 1;
        p = unsafe { (*p).next };
    }
    n
}

fn mb_orig_fn_name_v(thir: *const Thir, it: *const HirItem) -> u32 {
    if (it as usize) == 0 {
        return 0u32;
    }
    if (thir as usize) != 0 {
        let p = unsafe { thir_get_orig_item_name(view(*thir), it) };
        if (p as usize) != 0 {
            return unsafe { *p };
        }
    }
    unsafe { (*it).name.v }
}

fn mb_sv_is_main(sv: view<StrView>) -> bool {
    if sv.len != 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 109u8 && *(sv.ptr + 1) == 97u8 && *(sv.ptr + 2) == 105u8 && *(sv.ptr + 3) == 110u8
    }
}

fn mb_append_hir_item_tail(hir: *const HirFile, new_it: *mut HirItem) {
    if (hir as usize) == 0 || (new_it as usize) == 0 {
        return;
    }
    let mut cur: *mut HirItem = unsafe { (*hir).items };
    if (cur as usize) == 0 {
        return;
    }
    while ((unsafe { (*cur).next as usize }) != 0) {
        cur = unsafe { (*cur).next };
    }
    unsafe {
        (*cur).next = new_it;
    }
}

// T161: a generic clone of a default-method instance (a mono instance with arguments) keeps the instance's
// implementing impl and type, so its MIR is instantiated the same way.
fn mb_copy_default_inst_tags(thir: *mut Thir, orig: *const HirItem, new_it: *const HirItem) {
    if (thir as usize) == 0 || (orig as usize) == 0 || (new_it as usize) == 0 || (orig as usize) == (new_it as usize) {
        return;
    }
    let ip = unsafe { thir_get_expr_method(view(*thir), ((orig as usize) | 2) as *const HirExpr) };
    if (ip as usize) == 0 {
        return;
    }
    let impl_it: *const HirItem = unsafe { *ip };
    unsafe { ptr_itemmap_insert(mut_view((*thir).expr_methods), (new_it as usize) | 2, impl_it); }
    let tp = unsafe { thir_get_item_type(view(*thir), ((orig as usize) | 2) as *const HirItem) };
    if (tp as usize) != 0 {
        let tv = unsafe { (*tp).v };
        unsafe { ptr_typemap_insert(mut_view((*thir).item_types), (new_it as usize) | 2, TypeId { v: tv }); }
    }
}

fn mb_mono_find_or_create(
    eng: *mut MonoEngine,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    orig: *mut HirItem,
    args: view<GenericArgsSlice>
) -> *mut MonoInstance {
    if (eng as usize) == 0 || (orig as usize) == 0 {
        return 0 as *mut MonoInstance;
    }
    let existing = unsafe { mono_find_instance(view(*eng), orig as *const HirItem, args) };
    if (existing as usize) != 0 {
        return existing;
    }
    let arena_ptr = unsafe { (*eng).arena };
    let inst = unsafe {
        arena_alloc_raw(mut_view(*arena_ptr), size_of<MonoInstance>(), align_of<MonoInstance>()) as *mut MonoInstance
    };
    let ac: usize = args.count;
    let a_ptr: *mut TypeId = args.args;
    let mut copied_args: *mut TypeId = 0 as *mut TypeId;
    if ac > 0 && (a_ptr as usize) != 0 {
        let abytes = mir_mul_usize(ac, size_of<TypeId>());
        copied_args = unsafe {
            arena_alloc_raw(mut_view(*arena_ptr), abytes, align_of<TypeId>()) as *mut TypeId
        };
        unsafe {
            ptr_copy_nonoverlapping<u8>(a_ptr as *const u8, copied_args as *mut u8, abytes);
        }
    }
    let orig_name_v = mb_orig_fn_name_v(thir as *const Thir, orig as *const HirItem);
    let orig_sym_v = unsafe { (*orig).symbol.v };
    let mut m_sym_v: u32 = orig_sym_v;
    let mut m_name_v: u32 = orig_name_v;
    let mut new_it: *mut HirItem = orig;
    if orig_name_v == 0u32 {
        let anon_id = unsafe { mangle_anon_fn_name(mut_view(*str_in), SymbolId { v: orig_sym_v }) };
        m_name_v = anon_id.v;
    } else if ac > 0 {
        m_sym_v = unsafe { (*eng).next_sym_id };
        unsafe { (*eng).next_sym_id = m_sym_v + 1u32; }
        let cnt = unsafe { (*eng).next_counter };
        unsafe { (*eng).next_counter = cnt + 1u32; }
        let m_id = unsafe {
            mangle_instance_name(
                mut_view(*str_in),
                StrId { v: orig_name_v },
                SymbolId { v: orig_sym_v },
                ac,
                cnt
            )
        };
        m_name_v = m_id.v;
        let ibytes = size_of<HirItem>();
        new_it = unsafe {
            arena_alloc_raw(mut_view(*arena_ptr), ibytes, align_of<HirItem>()) as *mut HirItem
        };
        unsafe {
            ptr_copy_nonoverlapping<u8>(orig as *const u8, new_it as *mut u8, ibytes);
            (*new_it).symbol.v = m_sym_v;
            (*new_it).name.v = m_name_v;
            (*new_it).generic_params = 0 as *mut HirGenericParams;
            (*new_it).span.file.v = 0xFFFFFFFEu32;
            (*new_it).next = 0 as *mut HirItem;
        }
        let orig_pty = unsafe { thir_get_item_type(view(*thir), orig as *const HirItem) };
        if (orig_pty as usize) != 0 {
            let copied_slice = GenericArgsSlice { args: copied_args, count: ac };
            let new_ty = unsafe {
                subst_ty(mut_view((*thir).interner), TypeId { v: (*orig_pty).v }, view(copied_slice))
            };
            unsafe {
                thir_set_item_type(mut_view(*thir), new_it as *const HirItem, new_ty);
            }
        }
        mb_append_hir_item_tail(hir, new_it);
        mb_copy_default_inst_tags(thir, orig as *const HirItem, new_it as *const HirItem);
    }
    unsafe {
        (*inst).orig_item = orig;
        (*inst).new_item = new_it;
        (*inst).args.args = copied_args;
        (*inst).args.count = ac;
        (*inst).mangled_sym.v = m_sym_v;
        (*inst).mangled_name.v = m_name_v;
        (*inst).mir_body = 0;
        (*inst).next = (*eng).instances_head;
        (*eng).instances_head = inst;
        if ((*eng).instances_tail as usize) == 0 {
            (*eng).instances_tail = inst;
        }
        (*eng).instance_count = (*eng).instance_count + 1;
        (*inst).work_next = (*eng).work_head;
        (*eng).work_head = inst;
        (*inst).in_worklist = true;
    }
    inst
}

fn mb_scan_or_rewrite_calls(
    body: *mut MirBody,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase,
    eng: *mut MonoEngine
) {
    if (body as usize) == 0 || (thir as usize) == 0 || (hir as usize) == 0 || (eng as usize) == 0 {
        return;
    }
    let bb_cnt = unsafe { (*body).bb_count };
    let mut bi: usize = 0;
    while (bi < bb_cnt) {
        let bb = unsafe { mir_bb_at((*body).bbs, bi) };
        let is_fn_call = (unsafe { (*bb).has_terminator }) &&
            (unsafe { (*bb).terminator.kind }) == MIR_TERM_CALL &&
            (unsafe { (*bb).terminator.func.kind }) == MIR_OP_CONST &&
            (unsafe { (*bb).terminator.func.constant.kind }) == MIR_CONST_FN;
        if is_fn_call {
            let mut sym_v: u32 = unsafe { (*bb).terminator.func.constant.sym.v };
            if sym_v == 0u32 {
                sym_v = (unsafe { (*bb).terminator.func.constant.val }) as u32;
            }
            let mut callee: *mut HirItem = 0 as *mut HirItem;
            let mut it: *mut HirItem = unsafe { (*hir).items };
            while ((it as usize) != 0) {
                if (unsafe { (*it).span.file.v }) != 0xFFFFFFFEu32 {
                    let ik = unsafe { (*it).kind };
                    if ik == HIR_ITEM_FN && (unsafe { (*it).symbol.v }) == sym_v {
                        callee = it;
                        break;
                    }
                    if ik == HIR_ITEM_IMPL {
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while ((m as usize) != 0) {
                            if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).symbol.v }) == sym_v {
                                callee = m;
                                break;
                            }
                            m = unsafe { (*m).next };
                        }
                        if (callee as usize) != 0 {
                            break;
                        }
                    }
                }
                it = unsafe { (*it).next };
            }
            if (callee as usize) == 0 {
                let mut trait_method: *mut HirItem = 0 as *mut HirItem;
                let mut tit: *mut HirItem = unsafe { (*hir).items };
                while ((tit as usize) != 0) {
                    if (unsafe { (*tit).kind }) == HIR_ITEM_TRAIT {
                        let mut tm: *mut HirItem = unsafe { (*tit).members };
                        while ((tm as usize) != 0) {
                            if (unsafe { (*tm).kind }) == HIR_ITEM_FN && (unsafe { (*tm).symbol.v }) == sym_v {
                                trait_method = tm;
                                break;
                            }
                            tm = unsafe { (*tm).next };
                        }
                        if (trait_method as usize) != 0 {
                            break;
                        }
                    }
                    tit = unsafe { (*tit).next };
                }
                if (trait_method as usize) != 0 {
                    let mut receiver_ty = TypeId { v: 0u32 };
                    if (unsafe { (*bb).terminator.arg_count }) > 0 {
                        let a0 = unsafe { mir_op_at((*bb).terminator.args, 0) };
                        if (unsafe { (*a0).kind }) == MIR_OP_CONST {
                            receiver_ty.v = unsafe { (*a0).constant.ty.v };
                        } else if (unsafe { (*a0).place.local.v as usize }) < (unsafe { (*body).local_count }) {
                            let l0 = unsafe { mir_local_at((*body).locals, (*a0).place.local.v as usize) };
                            receiver_ty.v = unsafe { (*l0).ty.v };
                        }
                    }
                    let tm_orig_name = mb_orig_fn_name_v(thir as *const Thir, trait_method as *const HirItem);
                    let mut iit: *mut HirItem = unsafe { (*hir).items };
                    while ((iit as usize) != 0) {
                        if (unsafe { (*iit).kind }) == HIR_ITEM_IMPL && (unsafe { (*iit).trait_path as usize }) != 0 {
                            let matches = receiver_ty.v == 0u32 || unsafe {
                                impl_matches_receiver(view((*thir).interner), view(*str_in), iit, TypeId { v: receiver_ty.v })
                            };
                            if matches {
                                let mut im: *mut HirItem = unsafe { (*iit).members };
                                while ((im as usize) != 0) {
                                    if (unsafe { (*im).kind }) == HIR_ITEM_FN && mb_orig_fn_name_v(thir as *const Thir, im as *const HirItem) == tm_orig_name {
                                        callee = im;
                                        let m_sv = unsafe { (*im).symbol.v };
                                        unsafe {
                                            (*bb).terminator.func.constant.sym.v = m_sv;
                                            (*bb).terminator.func.constant.val = m_sv as u64;
                                        }
                                        break;
                                    }
                                    im = unsafe { (*im).next };
                                }
                                if (callee as usize) != 0 {
                                    break;
                                }
                            }
                        }
                        iit = unsafe { (*iit).next };
                    }
                    if (callee as usize) == 0 {
                        callee = trait_method;
                        let t_sv = unsafe { (*trait_method).symbol.v };
                        unsafe {
                            (*bb).terminator.func.constant.sym.v = t_sv;
                            (*bb).terminator.func.constant.val = t_sv as u64;
                        }
                    }
                }
            }
            if (callee as usize) != 0 && !mb_is_intrinsic_fn(str_in, db, callee) {
                let gcount = mb_count_generic_params(callee as *const HirItem);
                if gcount > 0 && !mb_has_intrinsic_attr(str_in, db, callee) {
                    let pty = unsafe { thir_get_item_type(view(*thir), callee as *const HirItem) };
                    if (pty as usize) != 0 {
                        let gen_ty = TypeId { v: unsafe { (*pty).v } };
                        let spec_ty = TypeId { v: unsafe { (*bb).terminator.func.constant.ty.v } };
                        let arena_ptr = unsafe { (*eng).arena };
                        let dbytes = mir_mul_usize(gcount, size_of<TypeId>());
                        let d_args = unsafe {
                            arena_alloc_raw(mut_view(*arena_ptr), dbytes, align_of<TypeId>()) as *mut TypeId
                        };
                        let mut zi: usize = 0;
                        while (zi < gcount) {
                            unsafe { (*typeid_at(d_args, zi)).v = 0u32; }
                            zi = zi + 1;
                        }
                        unsafe {
                            deduce_args(TypeId { v: gen_ty.v }, spec_ty, view((*thir).interner), d_args, gcount);
                        }
                        let gt = unsafe { type_get(view((*thir).interner), TypeId { v: gen_ty.v }) };
                        if (gt as usize) != 0 && (unsafe { (*gt).kind }) == TY_FN {
                            let acnt = unsafe { (*bb).terminator.arg_count };
                            let pcnt = unsafe { (*gt).param_count };
                            let mut a: usize = 0;
                            while (a < acnt && a < pcnt) {
                                let arg_op = unsafe { mir_op_at((*bb).terminator.args, a) };
                                let mut arg_ty = TypeId { v: 0u32 };
                                if (unsafe { (*arg_op).kind }) == MIR_OP_CONST {
                                    arg_ty.v = unsafe { (*arg_op).constant.ty.v };
                                } else if (unsafe { (*arg_op).place.local.v as usize }) < (unsafe { (*body).local_count }) {
                                    let al = unsafe { mir_local_at((*body).locals, (*arg_op).place.local.v as usize) };
                                    arg_ty.v = unsafe { (*al).ty.v };
                                }
                                if arg_ty.v != 0u32 {
                                    let gp_ty = TypeId { v: unsafe { (*typeid_at((*gt).param_types, a)).v } };
                                    unsafe {
                                        deduce_args(gp_ty, arg_ty, view((*thir).interner), d_args, gcount);
                                    }
                                }
                                a = a + 1;
                            }
                            if (unsafe { (*bb).terminator.has_destination }) && (unsafe { (*bb).terminator.destination.local.v as usize }) < (unsafe { (*body).local_count }) {
                                let dl = unsafe { mir_local_at((*body).locals, (*bb).terminator.destination.local.v as usize) };
                                let ret_ty = TypeId { v: unsafe { (*dl).ty.v } };
                                if ret_ty.v != 0u32 {
                                    let gr_ty = TypeId { v: unsafe { (*gt).ret_type.v } };
                                    unsafe {
                                        deduce_args(gr_ty, ret_ty, view((*thir).interner), d_args, gcount);
                                    }
                                }
                            }
                        }
                        let gslice = GenericArgsSlice { args: d_args, count: gcount };
                        if unsafe { mono_has_concrete_args(view(gslice), view((*thir).interner)) } {
                            let c_inst = mb_mono_find_or_create(eng, thir, hir, str_in, callee, view(gslice));
                            if (c_inst as usize) != 0 {
                                let msv = unsafe { (*c_inst).mangled_sym.v };
                                unsafe {
                                    (*bb).terminator.func.constant.sym.v = msv;
                                    (*bb).terminator.func.constant.val = msv as u64;
                                }
                                let inst_ty = unsafe { thir_get_item_type(view(*thir), (*c_inst).new_item as *const HirItem) };
                                if (inst_ty as usize) != 0 && (unsafe { (*inst_ty).v }) != 0u32 {
                                    unsafe { (*bb).terminator.func.constant.ty.v = (*inst_ty).v; }
                                }
                            }
                        }
                    }
                } else if gcount == 0 {
                    let empty_g = GenericArgsSlice { args: 0 as *mut TypeId, count: 0 };
                    let c_inst = mb_mono_find_or_create(eng, thir, hir, str_in, callee, view(empty_g));
                    if (c_inst as usize) != 0 {
                        let msv = unsafe { (*c_inst).mangled_sym.v };
                        unsafe {
                            (*bb).terminator.func.constant.sym.v = msv;
                            (*bb).terminator.func.constant.val = msv as u64;
                        }
                        let inst_ty = unsafe { thir_get_item_type(view(*thir), (*c_inst).new_item as *const HirItem) };
                        if (inst_ty as usize) != 0 && (unsafe { (*inst_ty).v }) != 0u32 {
                            unsafe { (*bb).terminator.func.constant.ty.v = (*inst_ty).v; }
                        }
                    }
                }
            }
        }
        bi = bi + 1;
    }
}

fn mb_dedup_mono_names(
    eng: *mut MonoEngine,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner
) {
    let mut w: *mut MonoInstance = unsafe { (*eng).instances_head };
    while ((w as usize) != 0) {
        let w_orig = unsafe { (*w).orig_item };
        if (unsafe { (*w).mir_body }) != 0 && (w_orig as usize) != 0 && (unsafe { (*w_orig).name.v }) != 0u32 {
            let w_cur_name_v: u32 = unsafe { (*w_orig).name.v };
            let w_sv = unsafe { interner_get(view(*str_in), StrId { v: w_cur_name_v }) };
            if !mb_sv_is_main(view(w_sv)) {
                let mut has_dup = false;
                let mut other: *mut MonoInstance = unsafe { (*eng).instances_head };
                while ((other as usize) != 0) {
                    if (other as usize) != (w as usize) && (unsafe { (*other).mir_body }) != 0 {
                        let o_orig = unsafe { (*other).orig_item };
                        if (o_orig as usize) != 0 && (unsafe { (*o_orig).name.v }) != 0u32 && (unsafe { (*o_orig).name.v }) == w_cur_name_v {
                            has_dup = true;
                            break;
                        }
                    }
                    other = unsafe { (*other).next };
                }
                if has_dup {
                    let w_sym_v: u32 = unsafe { (*w).mangled_sym.v };
                    let new_name = unsafe { mangle_collision_name(mut_view(*str_in), StrId { v: w_cur_name_v }, SymbolId { v: w_sym_v }) };
                    unsafe {
                        (*w).mangled_name.v = new_name.v;
                        let w_new = (*w).new_item;
                        if (w_new as usize) != 0 {
                            thir_set_orig_item_name(mut_view(*thir), w_new as *const HirItem, (*w_new).name.v);
                            (*w_new).name.v = new_name.v;
                        }
                        thir_set_orig_item_name(mut_view(*thir), w_orig as *const HirItem, (*w_orig).name.v);
                        (*w_orig).name.v = new_name.v;
                    }
                    let mut it: *mut HirItem = unsafe { (*hir).items };
                    while ((it as usize) != 0) {
                        let ik = unsafe { (*it).kind };
                        if ik == HIR_ITEM_FN && (unsafe { (*it).symbol.v }) == w_sym_v {
                            unsafe {
                                thir_set_orig_item_name(mut_view(*thir), it as *const HirItem, (*it).name.v);
                                (*it).name.v = new_name.v;
                            }
                        }
                        if ik == HIR_ITEM_IMPL {
                            let mut m: *mut HirItem = unsafe { (*it).members };
                            while ((m as usize) != 0) {
                                if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).symbol.v }) == w_sym_v {
                                    unsafe {
                                        thir_set_orig_item_name(mut_view(*thir), m as *const HirItem, (*m).name.v);
                                        (*m).name.v = new_name.v;
                                    }
                                }
                                m = unsafe { (*m).next };
                            }
                        }
                        it = unsafe { (*it).next };
                    }
                }
            }
        }
        w = unsafe { (*w).next };
    }
}

fn mb_prepare_mono(
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase,
    mono: *mut MonoEngine
) {
    if (thir as usize) == 0 || (hir as usize) == 0 || (mono as usize) == 0 {
        return;
    }
    unsafe {
        thir_set_mono_prepared(mut_view(*thir), mono as *mut u8);
    }
    let head_it: *mut HirItem = unsafe { (*hir).items };
    if (head_it as usize) == 0 {
        return;
    }
    let r_next = unsafe { (*head_it).resolve_next_sym_v };
    let first_sym: u32 = if r_next != 0u32 { r_next + 1u32 } else { MONO_FIRST_SYM_ID };
    unsafe {
        (*mono).instances_head = 0 as *mut MonoInstance;
        (*mono).instances_tail = 0 as *mut MonoInstance;
        (*mono).instance_count = 0;
        (*mono).work_head = 0 as *mut MonoInstance;
        (*mono).work_tail = 0 as *mut MonoInstance;
        (*mono).next_counter = 1u32;
        (*mono).next_sym_id = first_sym;
    }
    let mut orig_tail: *mut HirItem = head_it;
    while ((unsafe { (*orig_tail).next as usize }) != 0) {
        orig_tail = unsafe { (*orig_tail).next };
    }
    let empty_g = GenericArgsSlice { args: 0 as *mut TypeId, count: 0 };
    let mut it: *mut HirItem = head_it;
    while ((it as usize) != 0) {
        let is_last = (it as usize) == (orig_tail as usize);
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && mb_count_generic_params(it as *const HirItem) == 0 {
            let _ = mb_mono_find_or_create(mono, thir, hir, str_in, it, view(empty_g));
        }
        if is_last {
            break;
        }
        it = unsafe { (*it).next };
    }
    let mut tmp_arena = arena_new();
    while (((unsafe { (*mono).work_head }) as usize) != 0) {
        let w: *mut MonoInstance = unsafe { (*mono).work_head };
        unsafe {
            (*mono).work_head = (*w).work_next;
            (*w).work_next = 0 as *mut MonoInstance;
            (*w).in_worklist = false;
        }
        let w_orig = unsafe { (*w).orig_item };
        let w_body = mir_build_fn_subst(
            mut_view(tmp_arena),
            w_orig,
            thir,
            hir,
            str_in,
            db,
            0 as *mut MonoEngine,
            unsafe { view((*w).args) }
        );
        if (w_body as usize) != 0 {
            unsafe { (*w).mir_body = 1; }
            mb_scan_or_rewrite_calls(w_body, thir, hir, str_in, db, mono);
        }
    }
    arena_destroy(mut_view(tmp_arena));
    mb_dedup_mono_names(mono, thir, hir, str_in);
}

fn mb_find_inst_by_new_item(eng: *const MonoEngine, func: *const HirItem) -> *mut MonoInstance {
    if (eng as usize) == 0 || (func as usize) == 0 {
        return 0 as *mut MonoInstance;
    }
    let mut cur: *mut MonoInstance = unsafe { (*eng).instances_head };
    while ((cur as usize) != 0) {
        if (unsafe { (*cur).new_item as usize }) == (func as usize) {
            return cur;
        }
        cur = unsafe { (*cur).next };
    }
    0 as *mut MonoInstance
}

pub fn mir_build_fn(
    arena: mut_view<Arena>,
    func: *mut HirItem,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase,
    mono: *mut MonoEngine
) -> *mut MirBody {
    let empty_subst = GenericArgsSlice {
        args: 0 as *mut TypeId,
        count: 0,
    };
    if (thir as usize) != 0 {
        if (mono as usize) != 0 && !(unsafe { thir_is_mono_prepared(view(*thir)) }) {
            mb_prepare_mono(thir, hir, str_in, db, mono);
        }
        if unsafe { thir_is_mono_prepared(view(*thir)) } {
            let eng = (unsafe { thir_get_mono_engine(view(*thir)) }) as *mut MonoEngine;
            let gcnt = mb_count_generic_params(func as *const HirItem);
            if gcnt > 0 {
                if (mono as usize) == 0 {
                    return 0 as *mut MirBody;
                }
                return mir_build_fn_subst(arena, func, thir, hir, str_in, db, 0 as *mut MonoEngine, view(empty_subst));
            }
            let inst = mb_find_inst_by_new_item(eng as *const MonoEngine, func as *const HirItem);
            let body = if (inst as usize) != 0 && (unsafe { (*inst).args.count }) > 0 {
                mir_build_fn_subst(arena, func, thir, hir, str_in, db, 0 as *mut MonoEngine, unsafe { view((*inst).args) })
            } else {
                mir_build_fn_subst(arena, func, thir, hir, str_in, db, 0 as *mut MonoEngine, view(empty_subst))
            };
            if (body as usize) != 0 && (eng as usize) != 0 {
                mb_scan_or_rewrite_calls(body, thir, hir, str_in, db, eng);
            }
            return body;
        }
    }
    mir_build_fn_subst(arena, func, thir, hir, str_in, db, mono, view(empty_subst))
}

pub fn mir_build_expr_body(
    arena: mut_view<Arena>,
    expr: *mut HirExpr,
    ty: TypeId,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase
) -> *mut MirBody {
    if (expr as usize) == 0 {
        return 0 as *mut MirBody;
    }
    let body = mir_body_new(mut_view(*arena));
    let mut b = MirBuilder {
        arena: unsafe { address_of_mut(arena.head) as *mut Arena },
        thir: thir,
        hir: hir,
        str_in: str_in,
        db: db,
        mono: 0 as *mut MonoEngine,
        subst_args: GenericArgsSlice {
            args: 0 as *mut TypeId,
            count: 0,
        },
        body: body,
        curr_bb: MirBbId { v: 0u32 },
        sym_map: 0 as *mut MirSymLocalMapEntry,
        sym_map_count: 0,
        sym_map_cap: 0,
        loop_stack: 0 as *mut MirLoopScope,
        loop_depth: 0,
        loop_cap: 0,
        scopes: 0 as *mut MirDeferScope,
        scope_depth: 0,
        scope_cap: 0,
        current_drops: 0 as *mut MirDropNode,
        is_diverged: false,
        unwind_bb: MirBbId { v: 0u32 },
        has_unwind_bb: false,
        closure_env_local: MirLocalId { v: 0u32 },
        closure_captures: 0 as *const ClosureCapture,
        closure_capture_count: 0,
        closure_head: 0 as *mut MirClosureBodyEntry,
        closure_tail: 0 as *mut MirClosureBodyEntry,
        self_impl: 0 as *const HirItem,
    };
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    mb_new_local(mut_view(b), (TypeId {
        v: ty.v
    }), MIR_LOCAL_RETURN, true, StrId {
        v: 0u32
    }, view(sp));
    b.curr_bb = mb_new_bb(mut_view(b), false);
    let mut ret_pl = mir_local_place(0u32);
    mir_build_expr(mut_view(b), expr, mut_view(ret_pl), true);
    if !b.is_diverged {
        mb_build_drop_chain(mut_view(b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
            v: 0u32
        }, view(sp));
        let bb = unsafe {
            mir_bb_at((*body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            (*bb).has_terminator = true;
        }
    }
    body
}
