}

fn mb_append_proj_sub_slice(
    b: mut_view<MirBuilder>,
    src: view<MirPlace>,
    from_loc: MirLocalId,
    to_loc: MirLocalId,
    has_from: bool,
    has_to: bool
) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_SUB_SLICE,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: from_loc.v },
        to_local: MirLocalId { v: to_loc.v },
        has_from: has_from,
        has_to: has_to,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    unsafe {
        mir_place_append_proj(mut_view(*b.arena), src, view(proj), mut_view(dst));
    }
    dst
}

fn mb_emit_assert(
    b: mut_view<MirBuilder>,
    cond: view<MirOperand>,
    expected: bool,
    msg_kind: u8,
    sp: view<Span>
) {
    if b.is_diverged {
        return;
    }
    mb_consume_op(mut_view(*b), cond);
    let next_bb = mb_new_bb(mut_view(*b), false);
    let ubb = mb_new_bb(mut_view(*b), false);
    let ubb_ptr = unsafe {
        mir_bb_at((*b.body).bbs, ubb.v as usize)
    };
    unsafe {
        mir_term_zero(mut_view((*ubb_ptr).terminator), MIR_TERM_UNREACHABLE);
        (*ubb_ptr).has_terminator = true;
    }
    let mut msg_len: usize = 0;
    let msg_ptr = unsafe {
        mb_alloc_msg_kind(mut_view(*b.arena), msg_kind, mut_view(msg_len))
    };
    let bb = unsafe {
        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
    };
    unsafe {
        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_ASSERT);
        (*bb).terminator.span.file.v = sp.file.v;
        (*bb).terminator.span.start = sp.start;
        (*bb).terminator.span.end = sp.end;
        mir_copy_operand(mut_view((*bb).terminator.cond), cond);
        (*bb).terminator.expected = expected;
        (*bb).terminator.msg_ptr = msg_ptr;
        (*bb).terminator.msg_len = msg_len;
        (*bb).terminator.assert_target.v = next_bb.v;
        (*bb).terminator.assert_unwind.v = ubb.v;
        (*bb).has_terminator = true;
    }
    b.curr_bb.v = next_bb.v;
    b.is_diverged = false;
}



// =============================================================================
// Pattern Local Declaration & Decision Tree Lowering
// =============================================================================

fn mb_declare_pat_locals(b: mut_view<MirBuilder>, pat: *mut HirPat, ty: TypeId) {
    if (pat as usize) == 0 {
        return;
    }
    let pk = unsafe {
        (*pat).kind
    };
    let sp = Span {
        file: FileId { v: unsafe { (*pat).span.file.v } },
        start: unsafe { (*pat).span.start },
        end: unsafe { (*pat).span.end },
    };
    if pk == HIR_PAT_BINDING {
        let sym = SymbolId {
            v: unsafe {
                (*pat).symbol.v
            }
        };
        let loc = mb_new_local(mut_view(*b), (TypeId {
            v: ty.v
        }), MIR_LOCAL_USER, unsafe {
            (*pat).is_mut
        }, StrId {
            v: unsafe {
                (*pat).path.name.v
            }
        }, view(sp));
        if sym.v != 0u32 {
            mb_register_sym(mut_view(*b), (SymbolId {
                v: sym.v
            }), (MirLocalId {
                v: loc.v
            }), false);
        }
    } else if pk == HIR_PAT_TUPLE {
        let t = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: ty.v
            }))
        };
        if (t as usize) == 0 || (unsafe { (*t).kind }) != TY_TUPLE {
            return;
        }
        let mut i: usize = 0;
        let mut el: *mut HirPat = unsafe {
            (*pat).elems
        };
        while ((el as usize) != 0) {
            if i < (unsafe { (*t).field_count }) {
                let fptr = unsafe {
                    typeid_at((*t).fields, i)
                };
                mb_declare_pat_locals(mut_view(*b), el, TypeId {
                    v: unsafe {
                        (*fptr).v
                    }
                });
            }
            i = i + 1;
            el = unsafe {
                (*el).next
            };
        }
    } else if pk == HIR_PAT_STRUCT {
        let t = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: ty.v
            }))
        };
        if (t as usize) == 0 {
            return;
        }
        let tk = unsafe {
            (*t).kind
        };
        if tk == TY_STRUCT {
            let def_item: *mut HirItem = unsafe {
                ((*t).def) as *mut HirItem
            };
            let mut pf: *mut HirPatField = unsafe {
                (*pat).fields
            };
            while ((pf as usize) != 0) {
                let pf_sp = Span {
                    file: FileId { v: unsafe { (*pf).span.file.v } },
                    start: unsafe { (*pf).span.start },
                    end: unsafe { (*pf).span.end },
                };
                let f_idx = mb_find_struct_field_index(view(*b), def_item, StrId {
                    v: unsafe {
                        (*pf).name.v
                    }
                }, view(pf_sp));
                if (f_idx as usize) < (unsafe { (*t).field_count }) {
                    let fptr = unsafe {
                        typeid_at((*t).fields, f_idx as usize)
                    };
                    mb_declare_pat_locals(mut_view(*b), unsafe {
                        (*pf).pat
                    }, TypeId {
                        v: unsafe {
                            (*fptr).v
                        }
                    });
                }
                pf = unsafe {
                    (*pf).next
                };
            }
        } else if tk == TY_ENUM && (unsafe { (*t).variant_count }) == 1 {
            let def_item: *mut HirItem = unsafe {
                ((*t).def) as *mut HirItem
            };
            let mut pf: *mut HirPatField = unsafe {
                (*pat).fields
            };
            while ((pf as usize) != 0) {
                let pf_sp = Span {
                    file: FileId { v: unsafe { (*pf).span.file.v } },
                    start: unsafe { (*pf).span.start },
                    end: unsafe { (*pf).span.end },
                };
                let f_idx = mb_find_enum_variant_field_index(view(*b), def_item, 0u32, StrId {
                    v: unsafe {
                        (*pf).name.v
                    }
                }, view(pf_sp));
                let vfc = unsafe {
                    *usize_at((*t).variant_field_counts, 0)
                };
                if (f_idx as usize) < vfc {
                    let vf_row = unsafe {
                        *typeid_ptr_at((*t).variant_fields, 0)
                    };
                    let fptr = unsafe {
                        typeid_at(vf_row, f_idx as usize)
                    };
                    mb_declare_pat_locals(mut_view(*b), unsafe {
                        (*pf).pat
                    }, TypeId {
                        v: unsafe {
                            (*fptr).v
                        }
                    });
                }
                pf = unsafe {
                    (*pf).next
                };
            }
        }
    } else if pk == HIR_PAT_PATH {
        let payload_head: *mut HirPat = unsafe {
            (*pat).payload
        };
        if (payload_head as usize) != 0 {
            let t = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: ty.v
                }))
            };
            if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_ENUM && (unsafe { (*t).variant_count }) == 1 {
                let vfc = unsafe {
                    *usize_at((*t).variant_field_counts, 0)
                };
                let vf_row = unsafe {
                    *typeid_ptr_at((*t).variant_fields, 0)
                };
                let mut el: *mut HirPat = if (unsafe { (*payload_head).kind }) == HIR_PAT_TUPLE && (unsafe { (*payload_head).elems as usize }) != 0 {
                    unsafe { (*payload_head).elems }
                } else {
                    payload_head
                };
                let mut idx: usize = 0;
                while ((el as usize) != 0) {
                    if idx < vfc {
                        let fptr = unsafe {
                            typeid_at(vf_row, idx)
                        };
                        mb_declare_pat_locals(mut_view(*b), el, TypeId {
                            v: unsafe {
                                (*fptr).v
                            }
                        });
                    }
                    idx = idx + 1;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
        }
    }
}

fn mb_build_pat_match_in_place(
    b: mut_view<MirBuilder>,
    pat: *mut HirPat,
    scrutinee: view<MirPlace>,
    scrut_ty: TypeId,
    on_fail: MirBbId
) {
    if (pat as usize) == 0 {
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*pat).span.file.v } },
        start: unsafe { (*pat).span.start },
        end: unsafe { (*pat).span.end },
    };
    let s_ty = mb_resolve_ty(mut_view(*b), (TypeId {
        v: scrut_ty.v
    }));
    let pk = unsafe {
        (*pat).kind
    };

    if pk == HIR_PAT_WILDCARD {
        return;
    } else if pk == HIR_PAT_BINDING {
        let mut v_idx: u32 = 0u32;
        if mb_resolve_pat_variant_idx(view(*b), pat, (TypeId { v: s_ty.v }), mut_view(v_idx)) && (unsafe { (*pat).symbol.v }) == 0u32 {
            let u32_ty = TypeId {
                v: unsafe {
                    (*b.thir).interner.t_u32.v
                }
            };
            let discr_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: u32_ty.v
            }), view(sp));
            let discr_pl = mir_local_place(discr_loc.v);
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_DISCRIMINANT;
            mir_copy_place(mut_view(rv.place), scrutinee);
            mb_emit_assign(mut_view(*b), view(discr_pl), view(rv), view(sp));
            let bb_succ = mb_new_bb(mut_view(*b), false);
            let discr_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: discr_loc.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_switch_single(mut_view(*b), view(discr_op), v_idx as u64, (MirBbId {
                v: bb_succ.v
            }), (MirBbId {
                v: on_fail.v
            }), view(sp));
            b.curr_bb.v = bb_succ.v;
            b.is_diverged = false;
        } else {
            let p_ty = mb_pat_ty(mut_view(*b), pat);
            let loc = mb_new_local(mut_view(*b), (TypeId {
                v: p_ty.v
            }), MIR_LOCAL_USER, unsafe {
                (*pat).is_mut
            }, StrId {
                v: unsafe {
                    (*pat).path.name.v
                }
            }, view(sp));
            let sym = SymbolId {
                v: unsafe {
                    (*pat).symbol.v
                }
            };
            if sym.v != 0u32 {
                mb_register_sym(mut_view(*b), (SymbolId {
                    v: sym.v
                }), (MirLocalId {
                    v: loc.v
                }), false);
            }
            let dst = mir_local_place(loc.v);
            let mut op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_operand_from_place(view(*b), scrutinee, (TypeId {
                v: p_ty.v
            }), mut_view(op));
            mb_emit_assign_use(mut_view(*b), view(dst), view(op), view(sp));
        }
    } else if pk == HIR_PAT_LITERAL {
        let p_ty = mb_pat_ty(mut_view(*b), pat);
        let val = mb_parse_pat_int(view(*b), pat);
        let const_op = MirOperand {
            kind: MIR_OP_CONST, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: p_ty.v
                }, kind: MIR_CONST_INT, val: val, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        let bool_ty = TypeId {
            v: unsafe {
                (*b.thir).interner.t_bool.v
            }
        };
        let cmp_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: bool_ty.v
        }), view(sp));
        let cmp_pl = mir_local_place(cmp_loc.v);
        let mut lhs_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        lhs_op.kind = MIR_OP_COPY;
        mir_copy_place(mut_view(lhs_op.place), scrutinee);
        let mut eq_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        eq_rv.kind = MIR_RVALUE_BINARY_OP;
        eq_rv.bin_op = MIR_BINOP_EQ;
        mir_copy_operand(mut_view(eq_rv.lhs), view(lhs_op));
        mir_copy_operand(mut_view(eq_rv.rhs), view(const_op));
        mb_emit_assign(mut_view(*b), view(cmp_pl), view(eq_rv), view(sp));

        let bb_succ = mb_new_bb(mut_view(*b), false);
        let cmp_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: cmp_loc.v
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_emit_switch_single(mut_view(*b), view(cmp_op), 0u64, (MirBbId {
            v: on_fail.v
        }), (MirBbId {
            v: bb_succ.v
        }), view(sp));
        b.curr_bb.v = bb_succ.v;
        b.is_diverged = false;
    } else if pk == HIR_PAT_RANGE {
        let start_pat: *mut HirPat = unsafe {
            (*pat).start_pat
        };
        let end_pat: *mut HirPat = unsafe {
            (*pat).end_pat
        };
        let start_ty = mb_pat_ty(mut_view(*b), start_pat);
        let end_ty = mb_pat_ty(mut_view(*b), end_pat);
        let start_val = mb_parse_pat_int(view(*b), start_pat);
        let end_val = mb_parse_pat_int(view(*b), end_pat);
        let bool_ty = TypeId {
            v: unsafe {
                (*b.thir).interner.t_bool.v
            }
        };

        let ge_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: bool_ty.v
        }), view(sp));
        let ge_pl = mir_local_place(ge_loc.v);
        let mut scr_op1 = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        scr_op1.kind = MIR_OP_COPY;
        mir_copy_place(mut_view(scr_op1.place), scrutinee);
        let start_op = MirOperand {
            kind: MIR_OP_CONST, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: start_ty.v
                }, kind: MIR_CONST_INT, val: start_val, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        let mut ge_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        ge_rv.kind = MIR_RVALUE_BINARY_OP;
        ge_rv.bin_op = MIR_BINOP_GE;
        mir_copy_operand(mut_view(ge_rv.lhs), view(scr_op1));
        mir_copy_operand(mut_view(ge_rv.rhs), view(start_op));
        mb_emit_assign(mut_view(*b), view(ge_pl), view(ge_rv), view(sp));

        let check_upper_bb = mb_new_bb(mut_view(*b), false);
        let ge_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: ge_loc.v
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_emit_switch_single(mut_view(*b), view(ge_op), 0u64, (MirBbId {
            v: on_fail.v
        }), (MirBbId {
            v: check_upper_bb.v
        }), view(sp));

        b.curr_bb.v = check_upper_bb.v;
        b.is_diverged = false;
        let le_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: bool_ty.v
        }), view(sp));
        let le_pl = mir_local_place(le_loc.v);
        let mut scr_op2 = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        scr_op2.kind = MIR_OP_COPY;
        mir_copy_place(mut_view(scr_op2.place), scrutinee);
        let end_op = MirOperand {
            kind: MIR_OP_CONST, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: end_ty.v
                }, kind: MIR_CONST_INT, val: end_val, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        let mut le_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        le_rv.kind = MIR_RVALUE_BINARY_OP;
        le_rv.bin_op = if unsafe {
            (*pat).is_inclusive
        } {
            MIR_BINOP_LE
        } else {
            MIR_BINOP_LT
        };
        mir_copy_operand(mut_view(le_rv.lhs), view(scr_op2));
        mir_copy_operand(mut_view(le_rv.rhs), view(end_op));
        mb_emit_assign(mut_view(*b), view(le_pl), view(le_rv), view(sp));

        let bb_succ = mb_new_bb(mut_view(*b), false);
        let le_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: le_loc.v
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_emit_switch_single(mut_view(*b), view(le_op), 0u64, (MirBbId {
            v: on_fail.v
        }), (MirBbId {
            v: bb_succ.v
        }), view(sp));
        b.curr_bb.v = bb_succ.v;
        b.is_diverged = false;
    } else if pk == HIR_PAT_OR {
        let bb_succ = mb_new_bb(mut_view(*b), false);
        let mut alt: *mut HirPat = unsafe {
            (*pat).pats
        };
        while ((alt as usize) != 0) {
            let next_alt: *mut HirPat = unsafe {
                (*alt).next
            };
            let next_or = if (next_alt as usize) != 0 {
                mb_new_bb(mut_view(*b), false)
            } else {
                (MirBbId {
                    v: on_fail.v
                })
            };
            mb_build_pat_match_in_place(mut_view(*b), alt, scrutinee, (TypeId {
                v: s_ty.v
            }), (MirBbId {
                v: next_or.v
            }));
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: bb_succ.v
            }), view(sp));
            b.curr_bb.v = next_or.v;
            b.is_diverged = false;
            alt = next_alt;
        }
        b.curr_bb.v = bb_succ.v;
        b.is_diverged = false;
    } else if pk == HIR_PAT_PATH || pk == HIR_PAT_STRUCT || pk == HIR_PAT_TUPLE {
        let p_ty = mb_pat_ty(mut_view(*b), pat);
        let t_ty = if p_ty.v != 0u32 {
            p_ty
        } else {
            s_ty
        };
        let t = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: t_ty.v
            }))
        };
        if (t as usize) == 0 {
            return;
        }
        let tk = unsafe {
            (*t).kind
        };
        let def_item: *mut HirItem = unsafe {
            ((*t).def) as *mut HirItem
        };
        if tk == TY_ENUM {
            let mut v_idx: u32 = 0u32;
            if !mb_resolve_pat_variant_idx(view(*b), pat, (TypeId { v: t_ty.v }), mut_view(v_idx)) {
                b.curr_bb.v = on_fail.v;
                b.is_diverged = false;
                return;
            }
            let u32_ty = TypeId {
                v: unsafe {
                    (*b.thir).interner.t_u32.v
                }
            };
            let discr_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: u32_ty.v
            }), view(sp));
            let discr_pl = mir_local_place(discr_loc.v);
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_DISCRIMINANT;
            mir_copy_place(mut_view(rv.place), scrutinee);
            mb_emit_assign(mut_view(*b), view(discr_pl), view(rv), view(sp));

            let bb_succ = mb_new_bb(mut_view(*b), false);
            let discr_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: discr_loc.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_switch_single(mut_view(*b), view(discr_op), v_idx as u64, (MirBbId {
                v: bb_succ.v
            }), (MirBbId {
                v: on_fail.v
            }), view(sp));
            b.curr_bb.v = bb_succ.v;
            b.is_diverged = false;

            if pk == HIR_PAT_STRUCT {
                let down_pl = mb_append_proj_downcast(mut_view(*b), scrutinee, v_idx);
                let mut pf: *mut HirPatField = unsafe {
                    (*pat).fields
                };
                while ((pf as usize) != 0) {
                    let pf_sp = Span {
                        file: FileId { v: unsafe { (*pf).span.file.v } },
                        start: unsafe { (*pf).span.start },
                        end: unsafe { (*pf).span.end },
                    };
                    let f_idx = mb_find_enum_variant_field_index(view(*b), def_item, v_idx, StrId {
                        v: unsafe {
                            (*pf).name.v
                        }
                    }, view(pf_sp));
                    let f_pl = mb_append_proj_field(mut_view(*b), view(down_pl), f_idx);
                    let f_ty = mb_pat_ty(mut_view(*b), unsafe {
                        (*pf).pat
                    });
                    mb_build_pat_match_in_place(mut_view(*b), unsafe {
                        (*pf).pat
                    }, view(f_pl), (TypeId {
                        v: f_ty.v
                    }), (MirBbId {
                        v: on_fail.v
                    }));
                    pf = unsafe {
                        (*pf).next
                    };
                }
            } else if pk == HIR_PAT_PATH {
                let payload_head: *mut HirPat = unsafe {
                    (*pat).payload
                };
                if (payload_head as usize) != 0 {
                    let down_pl = mb_append_proj_downcast(mut_view(*b), scrutinee, v_idx);
                    let mut el: *mut HirPat = if (unsafe { (*payload_head).kind }) == HIR_PAT_TUPLE && (unsafe { (*payload_head).elems as usize }) != 0 {
                        unsafe { (*payload_head).elems }
                    } else {
                        payload_head
                    };
                    let mut idx: u32 = 0u32;
                    while ((el as usize) != 0) {
                        let f_pl = mb_append_proj_field(mut_view(*b), view(down_pl), idx);
                        let f_ty = mb_pat_ty(mut_view(*b), el);
                        mb_build_pat_match_in_place(mut_view(*b), el, view(f_pl), (TypeId {
                            v: f_ty.v
                        }), (MirBbId {
                            v: on_fail.v
                        }));
                        idx = idx + 1u32;
                        el = unsafe {
                            (*el).next
                        };
                    }
                }
            }
        } else if tk == TY_STRUCT {
            if pk == HIR_PAT_STRUCT {
                let mut pf: *mut HirPatField = unsafe {
                    (*pat).fields
                };
                while ((pf as usize) != 0) {
                    let pf_sp = Span {
                        file: FileId { v: unsafe { (*pf).span.file.v } },
                        start: unsafe { (*pf).span.start },
                        end: unsafe { (*pf).span.end },
                    };
                    let f_idx = mb_find_struct_field_index(view(*b), def_item, StrId {
                        v: unsafe {
                            (*pf).name.v
                        }
                    }, view(pf_sp));
                    let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, f_idx);
                    let f_ty = mb_pat_ty(mut_view(*b), unsafe {
                        (*pf).pat
                    });
                    mb_build_pat_match_in_place(mut_view(*b), unsafe {
                        (*pf).pat
                    }, view(f_pl), (TypeId {
                        v: f_ty.v
                    }), (MirBbId {
                        v: on_fail.v
                    }));
                    pf = unsafe {
                        (*pf).next
                    };
                }
            } else if pk == HIR_PAT_TUPLE {
                let mut el: *mut HirPat = unsafe {
                    (*pat).elems
                };
                let mut idx: u32 = 0u32;
                while ((el as usize) != 0) {
                    let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, idx);
                    let f_ty = mb_pat_ty(mut_view(*b), el);
                    mb_build_pat_match_in_place(mut_view(*b), el, view(f_pl), (TypeId {
                        v: f_ty.v
                    }), (MirBbId {
                        v: on_fail.v
                    }));
                    idx = idx + 1u32;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
        } else if tk == TY_TUPLE {
            let mut el: *mut HirPat = unsafe {
                (*pat).elems
            };
            let mut idx: u32 = 0u32;
            while ((el as usize) != 0) {
                let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, idx);
                let f_ty = mb_pat_ty(mut_view(*b), el);
                mb_build_pat_match_in_place(mut_view(*b), el, view(f_pl), (TypeId {
                    v: f_ty.v
                }), (MirBbId {
                    v: on_fail.v
                }));
                idx = idx + 1u32;
                el = unsafe {
                    (*el).next
                };
            }
        }
    }
}

fn mb_build_pat_match(
    b: mut_view<MirBuilder>,
    pat: *mut HirPat,
    scrutinee: view<MirPlace>,
    scrut_ty: TypeId,
    on_match: MirBbId,
    on_fail: MirBbId
) {
    let sp = if (pat as usize) != 0 {
        Span {
            file: FileId { v: unsafe { (*pat).span.file.v } },
            start: unsafe { (*pat).span.start },
            end: unsafe { (*pat).span.end },
        }
    } else {
        Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }
    };
    mb_build_pat_match_in_place(mut_view(*b), pat, scrutinee, (TypeId {
        v: scrut_ty.v
    }), (MirBbId {
        v: on_fail.v
    }));
    mb_terminate_goto(mut_view(*b), (MirBbId {
        v: on_match.v
    }), view(sp));
}

fn mb_build_const_agg_local(
    b: mut_view<MirBuilder>,
    sym: SymbolId,
    cv_ty: TypeId,
    sp: view<Span>
) -> MirPlace {
    let loc = mb_new_local(mut_view(*b), (TypeId {
        v: cv_ty.v
    }), MIR_LOCAL_CONST, false, StrId {
        v: 0u32
    }, sp);
    let decl = unsafe {
        mir_local_at((*b.body).locals, loc.v as usize)
    };
    unsafe {
        (*decl).const_sym.v = sym.v;
    }
    mb_register_sym(mut_view(*b), (SymbolId {
        v: sym.v
    }), (MirLocalId {
        v: loc.v
    }), false);
    let init_stmt = MirStmt {
        kind: MIR_STMT_ASSIGN,
        span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(loc.v),
        rvalue: MirRvalue {
            kind: MIR_RVALUE_USE,
            use_op: MirOperand {
                kind: MIR_OP_CONST,
                location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                place: mir_local_place(0u32),
                constant: MirConst {
                    ty: TypeId { v: cv_ty.v },
                    kind: MIR_CONST_INT,
                    val: 0u64,
                    str_bytes: 0 as *const u8,
                    str_len: 0,
                    sym: SymbolId { v: 0u32 },
                },
            },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        },
        storage_local: MirLocalId { v: 0u32 },
    };
    let bb0 = unsafe {
        mir_bb_at((*b.body).bbs, 0)
    };
    unsafe {
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*b.arena), view(init_stmt));
    }
    mir_local_place(loc.v)
}

fn mb_emit_index_bounds_check(
    b: mut_view<MirBuilder>,
    base_pl: view<MirPlace>,
    ax: *mut AxType,
    idx_loc: MirLocalId,
    sp: view<Span>
) {
    let bk = unsafe {
        (*ax).kind
    };
    if bk != TY_ARRAY && bk != TY_VIEW && bk != TY_MUT_VIEW && bk != TY_SLICE && bk != TY_STR {
        return;
    }
    let usize_ty = TypeId {
        v: unsafe {
            (*b.thir).interner.t_usize.v
        }
    };
    let bool_ty = TypeId {
        v: unsafe {
            (*b.thir).interner.t_bool.v
        }
    };
    let len_loc = mb_new_temp(mut_view(*b), (TypeId {
        v: usize_ty.v
    }), sp);
    let len_pl = mir_local_place(len_loc.v);
    if bk == TY_ARRAY {
        let len_op = MirOperand {
            kind: MIR_OP_CONST,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst {
                ty: TypeId { v: usize_ty.v },
                kind: MIR_CONST_INT,
                val: unsafe { (*ax).array_len },
                str_bytes: 0 as *const u8,
                str_len: 0,
                sym: SymbolId { v: 0u32 },
            },
        };
        mb_emit_assign_use(mut_view(*b), view(len_pl), view(len_op), sp);
    } else {
        let mut len_rv = MirRvalue {
            kind: MIR_RVALUE_LEN,
            use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mir_copy_place(mut_view(len_rv.place), base_pl);
        mb_emit_assign(mut_view(*b), view(len_pl), view(len_rv), sp);
    }
    let cond_loc = mb_new_temp(mut_view(*b), (TypeId {
        v: bool_ty.v
    }), sp);
    let cond_pl = mir_local_place(cond_loc.v);
    let u_idx = mb_new_temp(mut_view(*b), (TypeId {
        v: usize_ty.v
    }), sp);
    let u_idx_pl = mir_local_place(u_idx.v);
    let idx_copy_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(idx_loc.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let cast_rv = MirRvalue {
        kind: MIR_RVALUE_CAST,
        use_op: idx_copy_op,
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: usize_ty.v },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mb_emit_assign(mut_view(*b), view(u_idx_pl), view(cast_rv), sp);

    let u_idx_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(u_idx.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let len_copy_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(len_loc.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let cmp_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_LT,
        lhs: u_idx_op,
        rhs: len_copy_op,
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mb_emit_assign(mut_view(*b), view(cond_pl), view(cmp_rv), sp);
    let cond_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(cond_loc.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mb_emit_assert(mut_view(*b), view(cond_op), true, MB_ASSERT_MSG_BOUNDS, sp);
}

fn mb_emit_range_cast_usize(
    b: mut_view<MirBuilder>,
    src_loc_v: u32,
    dst_loc_v: u32,
    usize_ty_v: u32,
    sp: view<Span>
) {
    let dst_pl = mir_local_place(dst_loc_v);
    let mut cast_rv = MirRvalue {
        kind: MIR_RVALUE_CAST,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(src_loc_v),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: usize_ty_v },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mb_emit_assign(mut_view(*b), view(dst_pl), view(cast_rv), sp);
}

fn mb_emit_range_le_assert(
    b: mut_view<MirBuilder>,
    cond_loc_v: u32,
    lhs_loc_v: u32,
    rhs_loc_v: u32,
    sp: view<Span>
) {
    let cond_pl = mir_local_place(cond_loc_v);
    let cmp_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_LE,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(lhs_loc_v),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(rhs_loc_v),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mb_emit_assign(mut_view(*b), view(cond_pl), view(cmp_rv), sp);
    let cond_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(cond_loc_v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mb_emit_assert(mut_view(*b), view(cond_op), true, MB_ASSERT_MSG_BOUNDS, sp);
}

fn mb_emit_range_bounds_check(
    b: mut_view<MirBuilder>,
    base_pl: view<MirPlace>,
    ax: *mut AxType,
    start_loc_v: u32,
    end_loc_v: u32,
    has_start: bool,
    has_end: bool,
    sp: view<Span>
) {
    let bk = unsafe { (*ax).kind };
    if bk != TY_ARRAY && bk != TY_VIEW && bk != TY_MUT_VIEW && bk != TY_SLICE && bk != TY_STR {
        return;
    }
    let usize_ty_v: u32 = unsafe { (*b.thir).interner.t_usize.v };
    let bool_ty_v: u32 = unsafe { (*b.thir).interner.t_bool.v };
    let len_loc = mb_new_temp(mut_view(*b), (TypeId { v: usize_ty_v }), sp);
    let len_pl = mir_local_place(len_loc.v);
    if bk == TY_ARRAY {
        let len_op = MirOperand {
            kind: MIR_OP_CONST,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst {
                ty: TypeId { v: usize_ty_v },
                kind: MIR_CONST_INT,
                val: unsafe { (*ax).array_len },
                str_bytes: 0 as *const u8,
                str_len: 0,
                sym: SymbolId { v: 0u32 },
            },
        };
        mb_emit_assign_use(mut_view(*b), view(len_pl), view(len_op), sp);
    } else {
        let mut len_rv = MirRvalue {
            kind: MIR_RVALUE_LEN,
            use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mir_copy_place(mut_view(len_rv.place), base_pl);
        mb_emit_assign(mut_view(*b), view(len_pl), view(len_rv), sp);
    }
    if has_start {
        let cond_loc = mb_new_temp(mut_view(*b), (TypeId { v: bool_ty_v }), sp);
        let u_start = mb_new_temp(mut_view(*b), (TypeId { v: usize_ty_v }), sp);
        mb_emit_range_cast_usize(mut_view(*b), start_loc_v, u_start.v, usize_ty_v, sp);
        mb_emit_range_le_assert(mut_view(*b), cond_loc.v, u_start.v, len_loc.v, sp);
    }
    if has_end {
        let cond_loc = mb_new_temp(mut_view(*b), (TypeId { v: bool_ty_v }), sp);
        let u_end = mb_new_temp(mut_view(*b), (TypeId { v: usize_ty_v }), sp);
        mb_emit_range_cast_usize(mut_view(*b), end_loc_v, u_end.v, usize_ty_v, sp);
        mb_emit_range_le_assert(mut_view(*b), cond_loc.v, u_end.v, len_loc.v, sp);
    }
    if has_start && has_end {
        let cond_loc = mb_new_temp(mut_view(*b), (TypeId { v: bool_ty_v }), sp);
        let u_start = mb_new_temp(mut_view(*b), (TypeId { v: usize_ty_v }), sp);
        mb_emit_range_cast_usize(mut_view(*b), start_loc_v, u_start.v, usize_ty_v, sp);
        let u_end = mb_new_temp(mut_view(*b), (TypeId { v: usize_ty_v }), sp);
        mb_emit_range_cast_usize(mut_view(*b), end_loc_v, u_end.v, usize_ty_v, sp);
        mb_emit_range_le_assert(mut_view(*b), cond_loc.v, u_start.v, u_end.v, sp);
    }
}

fn mb_emit_u32_to_char_check(
    b: mut_view<MirBuilder>,
    op: view<MirOperand>,
    t_u32_v: u32,
    t_bool_v: u32,
    sp: view<Span>
) {
    let is_le_max = mb_new_temp(mut_view(*b), (TypeId {
        v: t_bool_v
    }), sp);
    let is_le_max_pl = mir_local_place(is_le_max.v);
    let mut le_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_LE,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_CONST, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: t_u32_v }, kind: MIR_CONST_INT, val: 0x10FFFFu64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(le_rv.lhs), op);
    mb_emit_assign(mut_view(*b), view(is_le_max_pl), view(le_rv), sp);
    let is_le_max_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(is_le_max.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mb_emit_assert(mut_view(*b), view(is_le_max_op), true, MB_ASSERT_MSG_INVALID_CHAR, sp);

    let is_lt_d800 = mb_new_temp(mut_view(*b), (TypeId {
        v: t_bool_v
    }), sp);
    let is_lt_d800_pl = mir_local_place(is_lt_d800.v);
    let mut lt_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_LT,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_CONST, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: t_u32_v }, kind: MIR_CONST_INT, val: 0xD800u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(lt_rv.lhs), op);
    mb_emit_assign(mut_view(*b), view(is_lt_d800_pl), view(lt_rv), sp);

    let is_gt_dfff = mb_new_temp(mut_view(*b), (TypeId {
        v: t_bool_v
    }), sp);
    let is_gt_dfff_pl = mir_local_place(is_gt_dfff.v);
    let mut gt_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_GT,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_CONST, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: t_u32_v }, kind: MIR_CONST_INT, val: 0xDFFFu64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(gt_rv.lhs), op);
    mb_emit_assign(mut_view(*b), view(is_gt_dfff_pl), view(gt_rv), sp);

    let is_valid = mb_new_temp(mut_view(*b), (TypeId {
        v: t_bool_v
    }), sp);
    let is_valid_pl = mir_local_place(is_valid.v);
    let or_rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_BIT_OR,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(is_lt_d800.v), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(is_gt_dfff.v), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mb_emit_assign(mut_view(*b), view(is_valid_pl), view(or_rv), sp);
    let is_valid_op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(is_valid.v),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mb_emit_assert(mut_view(*b), view(is_valid_op), true, MB_ASSERT_MSG_INVALID_CHAR, sp);
}

// =============================================================================
// Lvalue & Operand Lowering
// =============================================================================

fn mb_build_range_subslice_lvalue(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    base_pl: view<MirPlace>,
    idx_arg: *mut HirExpr,
    sp: view<Span>
) -> MirPlace {
    let start_expr: *mut HirExpr = unsafe { (*idx_arg).start_expr };
    let end_expr: *mut HirExpr = unsafe { (*idx_arg).end_expr };
    let has_start: bool = (start_expr as usize) != 0;
    let has_end: bool = (end_expr as usize) != 0;
    let mut start_loc = MirLocalId { v: 0u32 };
    let mut end_loc = MirLocalId { v: 0u32 };
    if has_start {
        let mut start_op = MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        };
        mb_build_expr_as_operand(mut_view(*b), start_expr, mut_view(start_op));
        if (start_op.kind == MIR_OP_COPY || start_op.kind == MIR_OP_MOVE) && start_op.place.proj_count == 0 {
            start_loc.v = start_op.place.local.v;
        } else {
            let start_ty = mb_expr_ty(mut_view(*b), start_expr);
            start_loc = mb_new_temp(mut_view(*b), (TypeId { v: start_ty.v }), sp);
            let start_pl = mir_local_place(start_loc.v);
            mb_emit_assign_use(mut_view(*b), view(start_pl), view(start_op), sp);
        }
    }
    if has_end {
        let mut end_op = MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        };
        mb_build_expr_as_operand(mut_view(*b), end_expr, mut_view(end_op));
        if (end_op.kind == MIR_OP_COPY || end_op.kind == MIR_OP_MOVE) && end_op.place.proj_count == 0 {
            end_loc.v = end_op.place.local.v;
        } else {
            let end_ty = mb_expr_ty(mut_view(*b), end_expr);
            end_loc = mb_new_temp(mut_view(*b), (TypeId { v: end_ty.v }), sp);
            let end_pl = mir_local_place(end_loc.v);
            mb_emit_assign_use(mut_view(*b), view(end_pl), view(end_op), sp);
        }
    }
    let base_ty = mb_expr_ty(mut_view(*b), unsafe { (*expr).base });
    let ax = if base_ty.v != 0u32 {
        unsafe { type_get(view((*b.thir).interner), (TypeId { v: base_ty.v })) }
    } else {
        0 as *mut AxType
    };
    if !b.is_diverged && (ax as usize) != 0 {
        mb_emit_range_bounds_check(mut_view(*b), base_pl, ax, start_loc.v, end_loc.v, has_start, has_end, sp);
    }
    let mut is_slice_view = false;
    if (ax as usize) != 0 {
        let bk = unsafe { (*ax).kind };
        if (bk == TY_VIEW || bk == TY_MUT_VIEW) && (unsafe { (*ax).pointee.v }) != 0u32 {
            let pt = unsafe { type_get(view((*b.thir).interner), (TypeId { v: (*ax).pointee.v })) };
            if (pt as usize) != 0 && (unsafe { (*pt).kind }) == TY_SLICE {
                is_slice_view = true;
            }
        }
    }
    if is_slice_view {
        let deref_pl = mb_append_proj_deref(mut_view(*b), base_pl);
        return mb_append_proj_sub_slice(mut_view(*b), view(deref_pl), (MirLocalId { v: start_loc.v }), (MirLocalId { v: end_loc.v }), has_start, has_end);
    }
    mb_append_proj_sub_slice(mut_view(*b), base_pl, (MirLocalId { v: start_loc.v }), (MirLocalId { v: end_loc.v }), has_start, has_end)
}

pub fn mir_build_lvalue(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_is_slice_len: mut_view<bool>) -> MirPlace {
    *out_is_slice_len = false;
    if (expr as usize) == 0 {
        return mir_local_place(0u32);
    }
    let ek = unsafe {
        (*expr).kind
    };
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };

    if ek == HIR_EXPR_PATH {
        let sym = SymbolId {
            v: unsafe {
                (*expr).path.symbol.v
            }
        };
        let mut loc = MirLocalId {
            v: 0u32
        };
        let mut is_sl: bool = false;
        if sym.v != 0u32 && mb_lookup_sym(view(*b), (SymbolId { v: sym.v }), mut_view(loc), mut_view(is_sl)) {
            *out_is_slice_len = is_sl;
            let p = mir_local_place(loc.v);
            if (loc.v as usize) < (unsafe { (*b.body).local_count }) {
                let decl = unsafe {
                    mir_local_at((*b.body).locals, loc.v as usize)
                };
                let loc_ty = TypeId {
                    v: unsafe {
                        (*decl).ty.v
                    }
                };
                if loc_ty.v != 0u32 {
                    let lt = unsafe {
                        type_get(view((*b.thir).interner), (TypeId {
                            v: loc_ty.v
                        }))
                    };
                    if (lt as usize) != 0 && ((unsafe { (*lt).kind }) == TY_VIEW || (unsafe { (*lt).kind }) == TY_MUT_VIEW) {
                        let expr_ty = mb_expr_ty(mut_view(*b), expr);
                        if expr_ty.v != 0u32 && expr_ty.v != loc_ty.v {
                            return mb_append_proj_deref(mut_view(*b), view(p));
                        }
                    }
                }
            }
            return p;
        }
        // Check closure captures if inside a closure body
        if b.closure_capture_count > 0 && (b.closure_captures as usize) != 0 && sym.v != 0u32 {
            let mut ci: usize = 0;
            while (ci < b.closure_capture_count) {
                let cap = unsafe {
                    capture_at(b.closure_captures as *mut ClosureCapture, ci)
                };
                if (unsafe { (*cap).sym.v }) == sym.v {
                    let env_pl = mir_local_place(b.closure_env_local.v);
                    let env_deref = mb_append_proj_deref(mut_view(*b), view(env_pl));
                    let cap_field = mb_append_proj_field(mut_view(*b), view(env_deref), ci as u32);
                    let cmode = unsafe {
                        (*cap).mode
                    };
                    if cmode == CAP_VIEW || cmode == CAP_MUT_VIEW {
                        return mb_append_proj_deref(mut_view(*b), view(cap_field));
                    }
                    return cap_field;
                }
                ci = ci + 1;
            }
        }
        if sym.v != 0u32 {
            let cv = unsafe {
                sym_constmap_get(view((*b.thir).symbol_consts), (SymbolId {
                    v: sym.v
                }))
            };
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_AGGREGATE {
                let cv_ty = TypeId {
                    v: unsafe {
                        (*cv).ty.v
                    }
                };
                return mb_build_const_agg_local(mut_view(*b), (SymbolId { v: sym.v }), cv_ty, view(sp));
            }
        }
    } else if ek == HIR_EXPR_UNARY && (unsafe { (*expr).op }) == UNOP_DEREF {
        let mut inner_sl: bool = false;
        let base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).inner
        }, mut_view(inner_sl));
        return mb_append_proj_deref(mut_view(*b), view(base_pl));
    } else if ek == HIR_EXPR_FIELD {
        let mut inner_sl: bool = false;
        let mut base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let mut base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let mut ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: base_ty.v
            }))
        };
        while ((ax as usize) != 0 && ((unsafe { (*ax).kind }) == TY_VIEW || (unsafe { (*ax).kind }) == TY_MUT_VIEW || (unsafe { (*ax).kind }) == TY_PTR)) {
            base_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            let next_ty = TypeId {
                v: unsafe {
                    (*ax).pointee.v
                }
            };
            base_ty = mb_resolve_ty(mut_view(*b), next_ty);
            ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            };
        }
        let mut f_idx: u32 = 0u32;
        if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_STRUCT {
            let fname = StrId {
                v: unsafe {
                    (*expr).name.v
                }
            };
            f_idx = mb_find_struct_field_index(view(*b), unsafe {
                ((*ax).def) as *mut HirItem
            }, (StrId {
                v: fname.v
            }), view(sp));
        }
        return mb_append_proj_field(mut_view(*b), view(base_pl), f_idx);
    } else if ek == HIR_EXPR_TUPLE_INDEX {
        let mut inner_sl: bool = false;
        let mut base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let mut base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let mut ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: base_ty.v
            }))
        };
        while ((ax as usize) != 0 && ((unsafe { (*ax).kind }) == TY_VIEW || (unsafe { (*ax).kind }) == TY_MUT_VIEW || (unsafe { (*ax).kind }) == TY_PTR)) {
            base_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            let next_ty = TypeId {
                v: unsafe {
                    (*ax).pointee.v
                }
            };
            base_ty = mb_resolve_ty(mut_view(*b), next_ty);
            ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            };
        }
        return mb_append_proj_field(mut_view(*b), view(base_pl), unsafe {
            (*expr).tuple_index
        });
    } else if ek == HIR_EXPR_INDEX {
        let mut inner_sl: bool = false;
        let base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let idx_arg: *mut HirExpr = unsafe {
            (*expr).index_arg
        };
        if (idx_arg as usize) != 0 && (unsafe { (*idx_arg).kind }) == HIR_EXPR_RANGE {
            return mb_build_range_subslice_lvalue(mut_view(*b), expr, view(base_pl), idx_arg, view(sp));
        }
        let mut idx_op = MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        };
        mb_build_expr_as_operand(mut_view(*b), idx_arg, mut_view(idx_op));
        let idx_ty = mb_expr_ty(mut_view(*b), idx_arg);
        let mut idx_loc = MirLocalId { v: 0u32 };
        if (idx_op.kind == MIR_OP_COPY || idx_op.kind == MIR_OP_MOVE) && idx_op.place.proj_count == 0 {
            idx_loc.v = idx_op.place.local.v;
        } else {
            idx_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: idx_ty.v
            }), view(sp));
            let idx_pl = mir_local_place(idx_loc.v);
            mb_emit_assign_use(mut_view(*b), view(idx_pl), view(idx_op), view(sp));
        }

        let base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let ax = if base_ty.v != 0u32 {
            unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            }
        } else {
            0 as *mut AxType
        };

        if !b.is_diverged && (ax as usize) != 0 {
            mb_emit_index_bounds_check(mut_view(*b), view(base_pl), ax, (MirLocalId { v: idx_loc.v }), view(sp));
        }

        let mut is_slice_view = false;
        if (ax as usize) != 0 {
            let bk = unsafe {
                (*ax).kind
            };
            if (bk == TY_VIEW || bk == TY_MUT_VIEW) && (unsafe { (*ax).pointee.v }) != 0u32 {
                let pt = unsafe {
                    type_get(view((*b.thir).interner), (TypeId {
                        v: (*ax).pointee.v
                    }))
                };
                if (pt as usize) != 0 && (unsafe { (*pt).kind }) == TY_SLICE {
                    is_slice_view = true;
                }
            }
        }
        if is_slice_view {
            let deref_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            return mb_append_proj_index(mut_view(*b), view(deref_pl), (MirLocalId {
                v: idx_loc.v
            }));
        }
        return mb_append_proj_index(mut_view(*b), view(base_pl), (MirLocalId {
            v: idx_loc.v
        }));
    }

    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    tmp_pl
}

fn mb_build_operand(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_op: mut_view<MirOperand>) {
    if (expr as usize) == 0 {
        *out_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    mb_operand_from_place(view(*b), view(tmp_pl), (TypeId {
        v: e_ty.v
    }), mut_view(*out_op));
}

fn mb_build_expr_as_operand(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_op: mut_view<MirOperand>) {
    if (expr as usize) == 0 {
        *out_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        return;
    }
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };

    if ek == HIR_EXPR_LITERAL {
        mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
        out_op.constant.ty.v = e_ty.v;
        let tk = unsafe {
            (*expr).literal.kind
        };
        if tk == TOK_STR || tk == TOK_BYTE_STR {
            out_op.constant.kind = MIR_CONST_STR;
            let s_ptr = unsafe {
                (*expr).literal.str_ptr
            };
            let s_len = unsafe {
                (*expr).literal.str_len as usize
            };
            if (s_ptr as usize) != 0 {
                out_op.constant.str_bytes = s_ptr;
                out_op.constant.str_len = s_len;
            } else {
                let sv = mb_span_sv(view(*b), view(sp));
                if sv.len >= 2 {
                    out_op.constant.str_bytes = unsafe {
                        sv.ptr + 1
                    };
                    out_op.constant.str_len = sv.len - 2;
                }
            }
        } else if tk == TOK_KW_TRUE {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = 1u64;
        } else if tk == TOK_KW_FALSE {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = 0u64;
        } else {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = unsafe {
                mb_token_int_val(view(*b), view((*expr).literal), false)
            };
        }
        return;
    }

    if ek == HIR_EXPR_PATH {
        let sym = SymbolId {
            v: unsafe {
                (*expr).path.symbol.v
            }
        };
        let mut loc = MirLocalId {
            v: 0u32
        };
        let mut is_sl: bool = false;
        let mut in_local = false;
        if sym.v != 0u32 && mb_lookup_sym(view(*b), (SymbolId { v: sym.v }), mut_view(loc), mut_view(is_sl)) {
            in_local = true;
        } else if b.closure_capture_count > 0 && (b.closure_captures as usize) != 0 && sym.v != 0u32 {
            let mut ci: usize = 0;
            while (ci < b.closure_capture_count) {
                let cap = unsafe {
                    capture_at(b.closure_captures as *mut ClosureCapture, ci)
                };
                if (unsafe { (*cap).sym.v }) == sym.v {
                    in_local = true;
                    break;
                }
                ci = ci + 1;
            }
        }
        if in_local {
            let mut dummy_sl = false;
            let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            mb_operand_from_place(view(*b), view(p), (TypeId {
                v: e_ty.v
            }), mut_view(*out_op));
            return;
        }
        // Check if enum unit variant
        let vp = unsafe {
            thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
        };
        if (vp as usize) == 0 || (unsafe { *vp }) >= 256u32 {
            let mut cv: *mut ConstValue = 0 as *mut ConstValue;
            if sym.v != 0u32 {
                cv = unsafe {
                    sym_constmap_get(view((*b.thir).symbol_consts), (SymbolId {
                        v: sym.v
                    }))
                };
            }
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_STR {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_STR;
                out_op.constant.str_bytes = unsafe {
                    (*cv).str_bytes
                };
                out_op.constant.str_len = unsafe {
                    (*cv).str_len
                };
                return;
            }
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_INT {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_INT;
                out_op.constant.val = unsafe {
                    (*cv).int_val
                };
                return;
            }
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_AGGREGATE {
                let mut dummy_sl = false;
                let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
                mb_operand_from_place(view(*b), view(p), (TypeId {
                    v: e_ty.v
                }), mut_view(*out_op));
                return;
            }
            let ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: e_ty.v
                }))
            };
            if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_FN {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_FN;
                out_op.constant.sym.v = sym.v;
                out_op.constant.val = sym.v as u64;
                return;
            }
            if sym.v != 0u32 || ((ax as usize) != 0 && (unsafe { (*ax).kind }) >= TY_BUILTIN_PRINT && (unsafe { (*ax).kind }) <= TY_BUILTIN_IS_NULL) {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_INT;
                out_op.constant.val = sym.v as u64;
                out_op.constant.sym.v = sym.v;
                return;
            }
        }
    } else if ek == HIR_EXPR_CLOSURE {
        let ax = if e_ty.v != 0u32 {
            unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: e_ty.v
                }))
            }
        } else {
            0 as *mut AxType
        };
        if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_CLOSURE && (unsafe { (*ax).capture_count }) == 0 {
            let fn_sym_v = unsafe {
                (*ax).fn_sym
            };
            mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
            out_op.constant.ty.v = e_ty.v;
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = fn_sym_v as u64;
            return;
        }
    }

    let mut is_lval_cand = false;
    if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        is_lval_cand = true;
    } else if ek == HIR_EXPR_INDEX {
        let idx_arg: *mut HirExpr = unsafe {
            (*expr).index_arg
        };
        if (idx_arg as usize) != 0 && (unsafe { (*idx_arg).kind }) != HIR_EXPR_RANGE {
            is_lval_cand = true;
        }
    }
    if is_lval_cand {
        let vp = unsafe {
            thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
        };
        let mp = unsafe {
            thir_get_expr_method(view(*b.thir), expr as *const HirExpr)
        };
        // T153: `Type.CONST` (an associated constant reached through a field-style path) is recorded by typeck as
        // the const item in expr_methods. Its value is the operand (bootstrap/axiom0/src/mir/build/builder.c
        // operand-of-FIELD branch); without this case the expression fell through to the temp path below and
        // mir_build_expr called back into this function without end.
        let mut const_item_cand = false;
        if ek == HIR_EXPR_FIELD && (mp as usize) != 0 {
            if (unsafe { *mp as usize }) != 0 {
                if (unsafe { (**mp).kind }) == HIR_ITEM_CONST {
                    const_item_cand = true;
                }
            }
        }
        if const_item_cand {
            let cm: *const HirItem = mb_self_impl_const(view(*b), expr as *const HirExpr, unsafe { *mp });
            let ccv = unsafe {
                sym_constmap_get(view((*b.thir).symbol_consts), (SymbolId {
                    v: (*cm).symbol.v
                }))
            };
            if (ccv as usize) != 0 && (unsafe { (*ccv).kind }) == CONST_AGGREGATE {
                let mut dummy_sl = false;
                let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
                mb_operand_from_place(view(*b), view(p), (TypeId {
                    v: e_ty.v
                }), mut_view(*out_op));
                return;
            }
            mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
            out_op.constant.ty.v = e_ty.v;
            if (ccv as usize) != 0 && (unsafe { (*ccv).kind }) == CONST_STR {
                out_op.constant.kind = MIR_CONST_STR;
                out_op.constant.str_bytes = unsafe { (*ccv).str_bytes };
                out_op.constant.str_len = unsafe { (*ccv).str_len };
            } else {
                out_op.constant.kind = MIR_CONST_INT;
                out_op.constant.val = if (ccv as usize) != 0 { unsafe { (*ccv).int_val } } else { 0u64 };
            }
            return;
        }
        if (vp as usize) == 0 && (mp as usize) == 0 {
            let mut dummy_sl = false;
            let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            mb_operand_from_place(view(*b), view(p), (TypeId {
                v: e_ty.v
            }), mut_view(*out_op));
            return;
        }
    }

    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    out_op.kind = MIR_OP_MOVE;
    mir_copy_place(mut_view(out_op.place), view(tmp_pl));
}

fn mb_ast_binop_to_mir(op: u8, out_is_checked: mut_view<bool>) -> u8 {
    *out_is_checked = false;
    if op == BINOP_ADD {
        *out_is_checked = true;
        return MIR_BINOP_ADD;
    }
    if op == BINOP_SUB {
        *out_is_checked = true;
        return MIR_BINOP_SUB;
    }
    if op == BINOP_MUL {
        *out_is_checked = true;
        return MIR_BINOP_MUL;
    }
    if op == BINOP_DIV {
        *out_is_checked = true;
        return MIR_BINOP_DIV;
    }
    if op == BINOP_REM {
        *out_is_checked = true;
        return MIR_BINOP_REM;
    }
    if op == BINOP_SHL {
        *out_is_checked = true;
        return MIR_BINOP_SHL;
    }
    if op == BINOP_SHR {
        *out_is_checked = true;
        return MIR_BINOP_SHR;
    }
    if op == BINOP_BITAND {
        return MIR_BINOP_BIT_AND;
    }
    if op == BINOP_BITOR {
        return MIR_BINOP_BIT_OR;
    }
    if op == BINOP_BITXOR {
        return MIR_BINOP_BIT_XOR;
    }
    if op == BINOP_EQ {
        return MIR_BINOP_EQ;
    }
    if op == BINOP_NE {
        return MIR_BINOP_NE;
    }
    if op == BINOP_LT {
        return MIR_BINOP_LT;
    }
    if op == BINOP_LE {
        return MIR_BINOP_LE;
    }
    if op == BINOP_GT {
        return MIR_BINOP_GT;
    }
    if op == BINOP_GE {
        return MIR_BINOP_GE;
    }
    MIR_BINOP_ADD
}

fn mb_type_bit_width(b: view<MirBuilder>, ty: TypeId) -> u64 {
    if (b.thir as usize) != 0 {
        let lay = unsafe { type_layout(TypeId { v: ty.v }, view((*b.thir).interner)) };
        if lay.size != 0u32 {
            return (lay.size as u64) * 8u64;
        }
    }
    32u64
}

fn mb_build_op_trait_binary(
    b: mut_view<MirBuilder>,
    method_item: *mut HirItem,
    op: u8,
    left_expr: *mut HirExpr,
    right_expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    sp: view<Span>
) {
    let fn_ty_id = mb_item_ty(mut_view(*b), method_item);
    let fn_ax = unsafe { type_get(view((*b.thir).interner), (TypeId { v: fn_ty_id.v })) };
    let callee_op = MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst {
            ty: TypeId { v: fn_ty_id.v },
            kind: MIR_CONST_FN,
            val: (unsafe { (*method_item).symbol.v }) as u64,
            str_bytes: 0 as *const u8,
            str_len: 0,
            sym: SymbolId { v: unsafe { (*method_item).symbol.v } },
        },
    };
    let args_bytes = mir_mul_usize(2, size_of<MirOperand>());
    let args_arr = unsafe {
        arena_alloc_raw(mut_view(*b.arena), args_bytes, align_of<MirOperand>()) as *mut MirOperand
    };
    let self_ty = if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).param_count }) > 0 {
        mb_resolve_ty(mut_view(*b), TypeId { v: unsafe { (*typeid_at((*fn_ax).param_types, 0)).v } })
    } else {
        TypeId { v: 0u32 }
    };
    let other_ty = if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).param_count }) > 1 {
        mb_resolve_ty(mut_view(*b), TypeId { v: unsafe { (*typeid_at((*fn_ax).param_types, 1)).v } })
    } else {
        TypeId { v: 0u32 }
    };
    let ret_ty = if (fn_ax as usize) != 0 {
        mb_resolve_ty(mut_view(*b), TypeId { v: unsafe { (*fn_ax).ret_type.v } })
    } else {
        TypeId { v: 0u32 }
    };
    let left_ty = mb_expr_ty(mut_view(*b), left_expr);
    let left_t = unsafe { type_get(view((*b.thir).interner), (TypeId { v: left_ty.v })) };
    let self_t = unsafe { type_get(view((*b.thir).interner), (TypeId { v: self_ty.v })) };
    let arg0_dst = unsafe { mir_op_at(args_arr, 0) };
    if (self_t as usize) != 0 && ((unsafe { (*self_t).kind }) == TY_VIEW || (unsafe { (*self_t).kind }) == TY_MUT_VIEW) &&
        (left_t as usize) != 0 && (unsafe { (*left_t).kind }) != TY_VIEW && (unsafe { (*left_t).kind }) != TY_MUT_VIEW {
        let mut dsl0 = false;
        let left_pl = mir_build_lvalue(mut_view(*b), left_expr, mut_view(dsl0));
        let l_sp = Span { file: FileId { v: unsafe { (*left_expr).span.file.v } }, start: unsafe { (*left_expr).span.start }, end: unsafe { (*left_expr).span.end } };
        let tmp0 = mb_new_temp(mut_view(*b), (TypeId { v: self_ty.v }), view(l_sp));
        let tmp0_pl = mir_local_place(tmp0.v);
        let mut ref0 = MirRvalue {
            kind: MIR_RVALUE_REF,
            use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: if (unsafe { (*self_t).kind }) == TY_MUT_VIEW { MIR_BORROW_MUT } else { MIR_BORROW_SHARED },
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mir_copy_place(mut_view(ref0.place), view(left_pl));
        mb_emit_assign(mut_view(*b), view(tmp0_pl), view(ref0), view(l_sp));
        unsafe {
            *arg0_dst = MirOperand {
                kind: MIR_OP_COPY,
                location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                place: tmp0_pl,
                constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
            };
        }
    } else {
        let mut op0 = MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        };
        mb_build_expr_as_operand(mut_view(*b), left_expr, mut_view(op0));
        unsafe { mir_copy_operand(mut_view(*arg0_dst), view(op0)); }
    }
    let right_ty = mb_expr_ty(mut_view(*b), right_expr);
    let right_t = unsafe { type_get(view((*b.thir).interner), (TypeId { v: right_ty.v })) };
    let other_t = unsafe { type_get(view((*b.thir).interner), (TypeId { v: other_ty.v })) };
    let arg1_dst = unsafe { mir_op_at(args_arr, 1) };
    if (other_t as usize) != 0 && ((unsafe { (*other_t).kind }) == TY_VIEW || (unsafe { (*other_t).kind }) == TY_MUT_VIEW) &&
        (right_t as usize) != 0 && (unsafe { (*right_t).kind }) != TY_VIEW && (unsafe { (*right_t).kind }) != TY_MUT_VIEW {
        let mut dsl1 = false;
        let right_pl = mir_build_lvalue(mut_view(*b), right_expr, mut_view(dsl1));
        let r_sp = Span { file: FileId { v: unsafe { (*right_expr).span.file.v } }, start: unsafe { (*right_expr).span.start }, end: unsafe { (*right_expr).span.end } };
        let tmp1 = mb_new_temp(mut_view(*b), (TypeId { v: other_ty.v }), view(r_sp));
        let tmp1_pl = mir_local_place(tmp1.v);
        let mut ref1 = MirRvalue {
            kind: MIR_RVALUE_REF,
            use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: if (unsafe { (*other_t).kind }) == TY_MUT_VIEW { MIR_BORROW_MUT } else { MIR_BORROW_SHARED },
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mir_copy_place(mut_view(ref1.place), view(right_pl));
        mb_emit_assign(mut_view(*b), view(tmp1_pl), view(ref1), view(r_sp));
        unsafe {
            *arg1_dst = MirOperand {
                kind: MIR_OP_COPY,
                location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                place: tmp1_pl,
                constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
            };
        }
    } else {
        let mut op1 = MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        };
        mb_build_expr_as_operand(mut_view(*b), right_expr, mut_view(op1));
        unsafe { mir_copy_operand(mut_view(*arg1_dst), view(op1)); }
    }
    unsafe {
        mb_consume_op(mut_view(*b), view(*arg0_dst));
        mb_consume_op(mut_view(*b), view(*arg1_dst));
    }
    let next_bb = mb_new_bb(mut_view(*b), false);
    let is_post_cmp = op == BINOP_NE || op == BINOP_LT || op == BINOP_LE || op == BINOP_GT || op == BINOP_GE;
    let mut call_dest = mir_local_place(0u32);
    let mut tmp_ret = MirLocalId { v: 0u32 };
    if is_post_cmp {
        tmp_ret = mb_new_temp(mut_view(*b), (TypeId { v: ret_ty.v }), sp);
        call_dest = mir_local_place(tmp_ret.v);
    } else {
        mir_copy_place(mut_view(call_dest), view(*dest));
    }
    let bb = unsafe { mir_bb_at((*b.body).bbs, b.curr_bb.v as usize) };
    unsafe {
        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_CALL);
        (*bb).terminator.span.file.v = sp.file.v;
        (*bb).terminator.span.start = sp.start;
        (*bb).terminator.span.end = sp.end;
        mir_copy_operand(mut_view((*bb).terminator.func), view(callee_op));
        (*bb).terminator.args = args_arr;
        (*bb).terminator.arg_count = 2;
        mir_copy_place(mut_view((*bb).terminator.destination), view(call_dest));
        (*bb).terminator.has_destination = true;
        (*bb).terminator.call_target.v = next_bb.v;
        (*bb).terminator.call_unwind.v = 0u32;
        (*bb).has_terminator = true;
    }
    b.curr_bb.v = next_bb.v;
    b.is_diverged = false;
    if is_post_cmp {
        let bool_ty = TypeId { v: unsafe { (*b.thir).interner.t_bool.v } };
        let mut m_op: u8 = MIR_BINOP_EQ;
        let mut m_val: u64 = 0u64;
        let mut m_ty = TypeId { v: ret_ty.v };
        if op == BINOP_NE {
            m_op = MIR_BINOP_EQ;
            m_val = 0u64;
            m_ty.v = bool_ty.v;
        } else if op == BINOP_LT {
            m_op = MIR_BINOP_EQ;
            m_val = 0u64;
        } else if op == BINOP_LE {
            m_op = MIR_BINOP_LE;
            m_val = 1u64;
        } else if op == BINOP_GT {
            m_op = MIR_BINOP_EQ;
            m_val = 2u64;
        } else if op == BINOP_GE {
            m_op = MIR_BINOP_GE;
            m_val = 1u64;
        }
        let map_rv = MirRvalue {
            kind: MIR_RVALUE_BINARY_OP,
            use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: mir_local_place(0u32), constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: m_op,
            lhs: MirOperand {
                kind: MIR_OP_COPY,
                location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                place: call_dest,
                constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
            },
            rhs: MirOperand {
                kind: MIR_OP_CONST,
                location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                place: mir_local_place(0u32),
                constant: MirConst { ty: m_ty, kind: MIR_CONST_INT, val: m_val, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
            },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mb_emit_assign(mut_view(*b), view(*dest), view(map_rv), sp);
    }
}

fn mb_build_binary_expr(b: mut_view<MirBuilder>, expr: *mut HirExpr, dest: mut_view<MirPlace>) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let op = unsafe {
        (*expr).op
    };
    let left_expr: *mut HirExpr = unsafe {
        (*expr).left
    };
    let right_expr: *mut HirExpr = unsafe {
        (*expr).right
    };

    let mp = unsafe { thir_get_expr_method(view(*b.thir), expr as *const HirExpr) };
    if (mp as usize) != 0 && (unsafe { *mp as usize }) != 0 {
        mb_build_op_trait_binary(mut_view(*b), unsafe { (*mp) as *mut HirItem }, op, left_expr, right_expr, dest, view(sp));
        return;
    }

    // Short-circuit && and ||
    if op == BINOP_LOGAND || op == BINOP_LOGOR {
        let mut lhs = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), left_expr, mut_view(lhs));
        if lhs.kind == MIR_OP_MOVE {
            lhs.kind = MIR_OP_COPY;
        }
        let bb_rhs = mb_new_bb(mut_view(*b), false);
        let bb_end = mb_new_bb(mut_view(*b), false);
        mb_emit_assign_use(mut_view(*b), view(*dest), view(lhs), view(sp));
        if op == BINOP_LOGAND {
            mb_emit_switch_single(mut_view(*b), view(lhs), 0u64, (MirBbId {
                v: bb_end.v
            }), (MirBbId {
                v: bb_rhs.v
            }), view(sp));
        } else {
            mb_emit_switch_single(mut_view(*b), view(lhs), 0u64, (MirBbId {
                v: bb_rhs.v
            }), (MirBbId {
                v: bb_end.v
            }), view(sp));
        }
        b.curr_bb.v = bb_rhs.v;
        b.is_diverged = false;
        let mut rhs = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), right_expr, mut_view(rhs));
        mb_emit_assign_use(mut_view(*b), view(*dest), view(rhs), view(sp));
        mb_terminate_goto(mut_view(*b), (MirBbId {
            v: bb_end.v
        }), view(sp));
        b.curr_bb.v = bb_end.v;
        b.is_diverged = false;
        return;
    }

    let mut lhs = MirOperand {
        kind: MIR_OP_COPY, location: Span {
            file: FileId {
                v: 0u32
            }, start: 0u32, end: 0u32
        }, place: MirPlace {
            local: MirLocalId {
                v: 0u32
            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
        }, constant: MirConst {
            ty: TypeId {
                v: 0u32
            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                v: 0u32
            }
        }
    };
    mb_build_expr_as_operand(mut_view(*b), left_expr, mut_view(lhs));
    let mut rhs = MirOperand {
        kind: MIR_OP_COPY, location: Span {
            file: FileId {
                v: 0u32
            }, start: 0u32, end: 0u32
        }, place: MirPlace {
            local: MirLocalId {
                v: 0u32
            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
        }, constant: MirConst {
            ty: TypeId {
                v: 0u32
            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                v: 0u32
            }
        }
    };
    mb_build_expr_as_operand(mut_view(*b), right_expr, mut_view(rhs));

    let mut is_checked = false;
    let binop = mb_ast_binop_to_mir(op, mut_view(is_checked));
    let lty = mb_expr_ty(mut_view(*b), left_expr);
    let rty = mb_expr_ty(mut_view(*b), right_expr);
    let lt = unsafe {
        type_get(view((*b.thir).interner), (TypeId {
            v: lty.v
        }))
    };
    let rt = unsafe {
        type_get(view((*b.thir).interner), (TypeId {
            v: rty.v
        }))
    };

    if (lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_PTR && (op == BINOP_ADD || op == BINOP_SUB) && ((rt as usize) == 0 || (unsafe { (*rt).kind }) != TY_PTR) {
        let builtin_kind = if op == BINOP_ADD { TY_BUILTIN_PTR_ADD } else { TY_BUILTIN_PTR_SUB };
        let fn_ty = unsafe { intern_singleton(mut_view((*b.thir).interner), builtin_kind) };
        let pointee_v = unsafe { (*lt).pointee.v };
        let callee_op = MirOperand {
            kind: MIR_OP_CONST,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            constant: MirConst {
                ty: TypeId { v: fn_ty.v },
                kind: MIR_CONST_INT,
                val: pointee_v as u64,
                str_bytes: 0 as *const u8,
                str_len: 0,
                sym: SymbolId { v: pointee_v },
            },
        };
        let bytes = mir_mul_usize(2, size_of<MirOperand>());
        let args_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
        };
        unsafe {
            let a0 = mir_op_at(args_arr, 0);
            mir_copy_operand(mut_view(*a0), view(lhs));
            let a1 = mir_op_at(args_arr, 1);
            mir_copy_operand(mut_view(*a1), view(rhs));
        }
        mb_consume_op(mut_view(*b), view(callee_op));
        mb_consume_op(mut_view(*b), view(lhs));
        mb_consume_op(mut_view(*b), view(rhs));
        let next_bb = mb_new_bb(mut_view(*b), false);
        let bb = unsafe {
            mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_CALL);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            mir_copy_operand(mut_view((*bb).terminator.func), view(callee_op));
            (*bb).terminator.args = args_arr;
            (*bb).terminator.arg_count = 2;
            mir_copy_place(mut_view((*bb).terminator.destination), view(*dest));
            (*bb).terminator.has_destination = true;
            (*bb).terminator.call_target.v = next_bb.v;
            (*bb).terminator.call_unwind.v = 0u32;
            (*bb).has_terminator = true;
        }
        b.curr_bb.v = next_bb.v;
        b.is_diverged = false;
        return;
    }

    if ((lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_PTR) || ((rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR) {
        is_checked = false;
    }

    let bool_ty = TypeId {
        v: unsafe {
            (*b.thir).interner.t_bool.v
        }
    };

    if is_checked {
        if binop == MIR_BINOP_DIV || binop == MIR_BINOP_REM {
            let cond_nz = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let cond_nz_pl = mir_local_place(cond_nz.v);
            let zero_op = MirOperand {
                kind: MIR_OP_CONST, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: rty.v
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            let mut ne_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
