    100u8, 105u8, 118u8, 105u8, 115u8, 105u8, 111u8, 110u8, 32u8,
    98u8, 121u8, 32u8, 122u8, 101u8, 114u8, 111u8, 0u8,
];

const MB_MSG_ARITH_OV_C: [20]u8 = [
    97u8, 114u8, 105u8, 116u8, 104u8, 109u8, 101u8, 116u8, 105u8, 99u8, 32u8,
    111u8, 118u8, 101u8, 114u8, 102u8, 108u8, 111u8, 119u8, 0u8,
];

const MB_MSG_SHIFT_RANGE_C: [26]u8 = [
    115u8, 104u8, 105u8, 102u8, 116u8, 32u8, 97u8, 109u8, 111u8, 117u8, 110u8, 116u8, 32u8,
    111u8, 117u8, 116u8, 32u8, 111u8, 102u8, 32u8, 114u8, 97u8, 110u8, 103u8, 101u8, 0u8,
];

const MB_MSG_INVALID_CHAR_C: [19]u8 = [
    105u8, 110u8, 118u8, 97u8, 108u8, 105u8, 100u8, 32u8, 99u8, 104u8, 97u8, 114u8, 32u8,
    118u8, 97u8, 108u8, 117u8, 101u8, 0u8,
];

const MB_MSG_ASSERT_FAILED_C: [17]u8 = [
    97u8, 115u8, 115u8, 101u8, 114u8, 116u8, 105u8, 111u8, 110u8, 32u8,
    102u8, 97u8, 105u8, 108u8, 101u8, 100u8, 0u8,
];

const MB_MSG_EXPLICIT_PANIC_C: [15]u8 = [
    101u8, 120u8, 112u8, 108u8, 105u8, 99u8, 105u8, 116u8, 32u8,
    112u8, 97u8, 110u8, 105u8, 99u8, 0u8,
];

const MB_MSG_UNREACHABLE_C: [25]u8 = [
    101u8, 110u8, 116u8, 101u8, 114u8, 101u8, 100u8, 32u8, 117u8, 110u8,
    114u8, 101u8, 97u8, 99u8, 104u8, 97u8, 98u8, 108u8, 101u8, 32u8,
    99u8, 111u8, 100u8, 101u8, 0u8,
];

const MB_ASSERT_MSG_BOUNDS: u8 = 0u8;
const MB_ASSERT_MSG_DIV_ZERO: u8 = 1u8;
const MB_ASSERT_MSG_ARITH_OV: u8 = 2u8;
const MB_ASSERT_MSG_SHIFT_RANGE: u8 = 3u8;
const MB_ASSERT_MSG_INVALID_CHAR: u8 = 4u8;
const MB_ASSERT_MSG_ASSERT: u8 = 5u8;
const MB_ASSERT_MSG_PANIC: u8 = 6u8;
const MB_ASSERT_MSG_UNREACHABLE: u8 = 7u8;

fn mb_alloc_msg_kind(arena: mut_view<Arena>, msg_kind: u8, out_len: mut_view<usize>) -> *const u8 {
    let mut n: usize = 19;
    if msg_kind == MB_ASSERT_MSG_DIV_ZERO {
        n = 16;
    } else if msg_kind == MB_ASSERT_MSG_ARITH_OV {
        n = 19;
    } else if msg_kind == MB_ASSERT_MSG_SHIFT_RANGE {
        n = 25;
    } else if msg_kind == MB_ASSERT_MSG_INVALID_CHAR {
        n = 18;
    } else if msg_kind == MB_ASSERT_MSG_ASSERT {
        n = 16;
    } else if msg_kind == MB_ASSERT_MSG_PANIC {
        n = 14;
    } else if msg_kind == MB_ASSERT_MSG_UNREACHABLE {
        n = 24;
    }
    *out_len = n;
    let buf = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while (i < n) {
        let mut ch: u8 = 0u8;
        if msg_kind == MB_ASSERT_MSG_BOUNDS {
            ch = MB_MSG_BOUNDS_CHECK[i];
        } else if msg_kind == MB_ASSERT_MSG_DIV_ZERO {
            ch = MB_MSG_DIV_ZERO_C[i];
        } else if msg_kind == MB_ASSERT_MSG_ARITH_OV {
            ch = MB_MSG_ARITH_OV_C[i];
        } else if msg_kind == MB_ASSERT_MSG_SHIFT_RANGE {
            ch = MB_MSG_SHIFT_RANGE_C[i];
        } else if msg_kind == MB_ASSERT_MSG_INVALID_CHAR {
            ch = MB_MSG_INVALID_CHAR_C[i];
        } else if msg_kind == MB_ASSERT_MSG_ASSERT {
            ch = MB_MSG_ASSERT_FAILED_C[i];
        } else if msg_kind == MB_ASSERT_MSG_PANIC {
            ch = MB_MSG_EXPLICIT_PANIC_C[i];
        } else {
            ch = MB_MSG_UNREACHABLE_C[i];
        }
        unsafe {
            *(buf + i) = ch;
        }
        i = i + 1;
    }
    unsafe {
        *(buf + n) = 0u8;
    }
    buf as *const u8
}

// --- Builder Core Helpers ---

pub fn mb_resolve_ty(b: mut_view<MirBuilder>, ty: TypeId) -> TypeId {
    if b.subst_args.count > 0 && (b.subst_args.args as usize) != 0 {
        let ti = unsafe {
            mut_view((*b.thir).interner)
        };
        return subst_ty(ti, (TypeId {
            v: ty.v
        }), view(b.subst_args));
    }
    (TypeId { v: ty.v })
}

pub fn mb_expr_ty(b: mut_view<MirBuilder>, e: *mut HirExpr) -> TypeId {
    if (e as usize) == 0 {
        return TypeId {
            v: 0u32
        };
    }
    let ptr = unsafe {
        thir_get_expr_type(view(*b.thir), e as *const HirExpr)
    };
    if (ptr as usize) != 0 {
        let raw_v = unsafe {
            (*ptr).v
        };
        return mb_resolve_ty(mut_view(*b), TypeId {
            v: raw_v
        });
    }
    TypeId { v: 0u32 }
}

pub fn mb_pat_ty(b: mut_view<MirBuilder>, p: *mut HirPat) -> TypeId {
    if (p as usize) == 0 {
        return TypeId {
            v: 0u32
        };
    }
    let ptr = unsafe {
        thir_get_pat_type(view(*b.thir), p as *const HirPat)
    };
    if (ptr as usize) != 0 {
        let raw_v = unsafe {
            (*ptr).v
        };
        return mb_resolve_ty(mut_view(*b), TypeId {
            v: raw_v
        });
    }
    TypeId { v: 0u32 }
}

pub fn mb_item_ty(b: mut_view<MirBuilder>, it: *mut HirItem) -> TypeId {
    if (it as usize) == 0 {
        return TypeId {
            v: 0u32
        };
    }
    let ptr = unsafe {
        thir_get_item_type(view(*b.thir), it as *const HirItem)
    };
    if (ptr as usize) != 0 {
        let raw_v = unsafe {
            (*ptr).v
        };
        return mb_resolve_ty(mut_view(*b), TypeId {
            v: raw_v
        });
    }
    TypeId { v: 0u32 }
}

pub fn mb_param_ty(b: mut_view<MirBuilder>, param: *mut HirParam) -> TypeId {
    if (param as usize) == 0 {
        return TypeId {
            v: 0u32
        };
    }
    let ptr = unsafe {
        thir_get_param_type(view(*b.thir), param as *const HirParam)
    };
    if (ptr as usize) != 0 {
        let raw_v = unsafe {
            (*ptr).v
        };
        return mb_resolve_ty(mut_view(*b), TypeId {
            v: raw_v
        });
    }
    TypeId { v: 0u32 }
}

pub fn mb_sym_ty(b: mut_view<MirBuilder>, sym: SymbolId) -> TypeId {
    let ptr = unsafe {
        thir_get_sym_type(view(*b.thir), (SymbolId {
            v: sym.v
        }))
    };
    if (ptr as usize) != 0 {
        let raw_v = unsafe {
            (*ptr).v
        };
        return mb_resolve_ty(mut_view(*b), TypeId {
            v: raw_v
        });
    }
    TypeId { v: 0u32 }
}

fn mb_new_bb(b: mut_view<MirBuilder>, is_cleanup: bool) -> MirBbId {
    unsafe {
        mir_add_bb(mut_view(*b.body), mut_view(*b.arena), is_cleanup)
    }
}

fn mb_push_drop(b: mut_view<MirBuilder>, place: view<MirPlace>, ty: TypeId, is_temp: bool, sp: view<Span>) {
    if unsafe { mir_type_needs_drop_in((TypeId { v: ty.v }), view(*b.thir), view(*b.hir), b.db, view(*b.str_in)) } {
        let node = unsafe {
            arena_alloc_raw(mut_view(*b.arena), size_of<MirDropNode>(), align_of<MirDropNode>()) as *mut MirDropNode
        };
        unsafe {
            mir_copy_place(mut_view((*node).place), place);
            (*node).span.file.v = sp.file.v;
            (*node).span.start = sp.start;
            (*node).span.end = sp.end;
            (*node).is_temp = is_temp;
            (*node).next = b.current_drops;
        }
        b.current_drops = node;
    }
}

fn mb_consume_local(b: mut_view<MirBuilder>, place: view<MirPlace>) {
    if place.proj_count > 0 {
        return;
    }
    let mut prev: *mut MirDropNode = 0 as *mut MirDropNode;
    let mut curr: *mut MirDropNode = b.current_drops;
    while ((curr as usize) != 0) {
        let cloc = unsafe {
            (*curr).place.local.v
        };
        let ctemp = unsafe {
            (*curr).is_temp
        };
        if cloc == place.local.v && ctemp {
            let nxt = unsafe {
                (*curr).next
            };
            if (prev as usize) == 0 {
                b.current_drops = nxt;
            } else {
                unsafe {
                    (*prev).next = nxt;
                }
            }
            return;
        }
        prev = curr;
        curr = unsafe {
            (*curr).next
        };
    }
}

fn mb_consume_op(b: mut_view<MirBuilder>, op: view<MirOperand>) {
    if op.kind == MIR_OP_MOVE {
        mb_consume_local(mut_view(*b), view(op.place));
    }
}

fn mb_new_local(
    b: mut_view<MirBuilder>,
    ty: TypeId,
    kind: u8,
    mut_flag: bool,
    name: StrId,
    sp: view<Span>
) -> MirLocalId {
    let rty = mb_resolve_ty(mut_view(*b), (TypeId {
        v: ty.v
    }));
    let id = unsafe {
        mir_add_local(mut_view(*b.body), mut_view(*b.arena), (TypeId { v: rty.v }), kind, mut_flag, (StrId { v: name.v }), sp)
    };
    if kind == MIR_LOCAL_USER || kind == MIR_LOCAL_TEMP {
        let pl = mir_local_place(id.v);
        mb_push_drop(mut_view(*b), view(pl), (TypeId {
            v: rty.v
        }), kind == MIR_LOCAL_TEMP, sp);
    }
    id
}

fn mb_new_temp(b: mut_view<MirBuilder>, ty: TypeId, sp: view<Span>) -> MirLocalId {
    mb_new_local(mut_view(*b), (TypeId { v: ty.v }), MIR_LOCAL_TEMP, false, StrId { v: 0u32 }, sp)
}

fn mb_emit_stmt(b: mut_view<MirBuilder>, stmt: view<MirStmt>) {
    if b.is_diverged {
        return;
    }
    if stmt.kind == MIR_STMT_ASSIGN {
        let rvk = stmt.rvalue.kind;
        if rvk == MIR_RVALUE_USE || rvk == MIR_RVALUE_CAST || rvk == MIR_RVALUE_UNARY_OP {
            mb_consume_op(mut_view(*b), view(stmt.rvalue.use_op));
        } else if rvk == MIR_RVALUE_BINARY_OP {
            mb_consume_op(mut_view(*b), view(stmt.rvalue.lhs));
            mb_consume_op(mut_view(*b), view(stmt.rvalue.rhs));
        } else if rvk == MIR_RVALUE_AGGREGATE {
            let mut i: usize = 0;
            while (i < stmt.rvalue.operand_count) {
                let op_i = unsafe {
                    mir_op_at(stmt.rvalue.operands, i)
                };
                unsafe {
                    mb_consume_op(mut_view(*b), view(*op_i));
                }
                i = i + 1;
            }
        }
    }
    let bb = unsafe {
        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
    };
    unsafe {
        mir_bb_push_stmt(mut_view(*bb), mut_view(*b.arena), stmt);
    }
}

fn mb_emit_assign(b: mut_view<MirBuilder>, place: view<MirPlace>, rv: view<MirRvalue>, sp: view<Span>) {
    let mut stmt = MirStmt {
        kind: MIR_STMT_ASSIGN,
        span: Span {
            file: FileId { v: sp.file.v },
            start: sp.start,
            end: sp.end,
        },
        location: Span {
            file: FileId { v: sp.file.v },
            start: sp.start,
            end: sp.end,
        },
        place: mir_local_place(0u32),
        rvalue: MirRvalue {
            kind: MIR_RVALUE_USE,
            use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE }, constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE }, constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE }, constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        },
        storage_local: MirLocalId { v: 0u32 },
    };
    mir_copy_place(mut_view(stmt.place), place);
    mir_copy_rvalue(mut_view(stmt.rvalue), rv);
    mb_emit_stmt(mut_view(*b), view(stmt));
}

fn mb_emit_assign_use(b: mut_view<MirBuilder>, place: view<MirPlace>, op: view<MirOperand>, sp: view<Span>) {
    let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE }, constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE }, constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        rhs: MirOperand { kind: MIR_OP_COPY, location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }, place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE }, constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } } },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(rv.use_op), op);
    mb_emit_assign(mut_view(*b), place, view(rv), sp);
}

fn mb_emit_storage_live(b: mut_view<MirBuilder>, loc: MirLocalId, sp: view<Span>) {
}

fn mb_emit_storage_dead(b: mut_view<MirBuilder>, loc: MirLocalId, sp: view<Span>) {
}

fn mb_terminate(b: mut_view<MirBuilder>, term: view<MirTerminator>) {
    if b.is_diverged {
        return;
    }
    let bb = unsafe {
        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
    };
    unsafe {
        mir_bb_set_terminator(mut_view(*bb), term);
    }
    b.is_diverged = true;
}

fn mb_terminate_goto(b: mut_view<MirBuilder>, target: MirBbId, sp: view<Span>) {
    if b.is_diverged {
        return;
    }
    let bb = unsafe {
        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
    };
    unsafe {
        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_GOTO);
        (*bb).terminator.span.file.v = sp.file.v;
        (*bb).terminator.span.start = sp.start;
        (*bb).terminator.span.end = sp.end;
        (*bb).terminator.goto_target.v = target.v;
        (*bb).has_terminator = true;
    }
    b.is_diverged = true;
}

fn mb_get_unwind_bb(b: mut_view<MirBuilder>, sp: view<Span>) -> MirBbId {
    MirBbId { v: 0u32 }
}

fn mb_build_drop_chain(
    b: mut_view<MirBuilder>,
    from: *mut MirDropNode,
    to: *mut MirDropNode,
    target_bb: MirBbId,
    sp: view<Span>
) {
    let mut curr = from;
    while ((curr as usize) != (to as usize) && (curr as usize) != 0) {
        if !b.is_diverged {
            let next_bb = mb_new_bb(mut_view(*b), false);
            let bb = unsafe {
                mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
            };
            unsafe {
                mir_term_zero(mut_view((*bb).terminator), MIR_TERM_DROP);
                (*bb).terminator.span.file.v = sp.file.v;
                (*bb).terminator.span.start = sp.start;
                (*bb).terminator.span.end = sp.end;
                mir_copy_place(mut_view((*bb).terminator.drop_place), view((*curr).place));
                (*bb).terminator.drop_target.v = next_bb.v;
                (*bb).terminator.drop_unwind.v = 0u32;
                (*bb).has_terminator = true;
            }
            b.curr_bb.v = next_bb.v;
            b.is_diverged = false;
        }
        curr = unsafe {
            (*curr).next
        };
    }
    if target_bb.v != 0u32 && !b.is_diverged {
        mb_terminate_goto(mut_view(*b), (MirBbId {
            v: target_bb.v
        }), sp);
    }
}

// --- Scope & Symbol Table Management ---

fn mb_push_scope(b: mut_view<MirBuilder>) {
    if b.scope_depth >= b.scope_cap {
        let new_cap: usize = if b.scope_cap == 0 {
            8
        } else {
            b.scope_cap + b.scope_cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirDeferScope>());
        let new_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<MirDeferScope>()) as *mut MirDeferScope
        };
        if b.scope_depth > 0 && (b.scopes as usize) != 0 {
            let old_bytes = mir_mul_usize(b.scope_depth, size_of<MirDeferScope>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.scopes as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        b.scopes = new_arr;
        b.scope_cap = new_cap;
    }
    let sc = unsafe {
        mb_defer_scope_at(b.scopes, b.scope_depth)
    };
    unsafe {
        (*sc).locals = 0 as *mut MirLocalId;
        (*sc).local_count = 0;
        (*sc).local_cap = 0;
        (*sc).defers = 0 as *mut *mut HirExpr;
        (*sc).defer_count = 0;
        (*sc).defer_cap = 0;
    }
    b.scope_depth = b.scope_depth + 1;
}

fn mb_record_local_in_scope(b: mut_view<MirBuilder>, loc: MirLocalId) {
    if b.scope_depth == 0 {
        return;
    }
    let sc = unsafe {
        mb_defer_scope_at(b.scopes, b.scope_depth - 1)
    };
    let cnt = unsafe {
        (*sc).local_count
    };
    let cap = unsafe {
        (*sc).local_cap
    };
    if cnt >= cap {
        let new_cap: usize = if cap == 0 {
            8
        } else {
            cap + cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirLocalId>());
        let new_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<MirLocalId>()) as *mut MirLocalId
        };
        if cnt > 0 && (unsafe { (*sc).locals as usize }) != 0 {
            let old_bytes = mir_mul_usize(cnt, size_of<MirLocalId>());
            unsafe {
                ptr_copy_nonoverlapping<u8>((*sc).locals as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        unsafe {
            (*sc).locals = new_arr;
            (*sc).local_cap = new_cap;
        }
    }
    unsafe {
        let dst = mb_local_id_at((*sc).locals, cnt);
        (*dst).v = loc.v;
        (*sc).local_count = cnt + 1;
    }
}

fn mb_record_defer_in_scope(b: mut_view<MirBuilder>, e: *mut HirExpr) {
    if b.scope_depth == 0 {
        return;
    }
    let sc = unsafe {
        mb_defer_scope_at(b.scopes, b.scope_depth - 1)
    };
    let cnt = unsafe {
        (*sc).defer_count
    };
    let cap = unsafe {
        (*sc).defer_cap
    };
    if cnt >= cap {
        let new_cap: usize = if cap == 0 {
            4
        } else {
            cap + cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<*mut HirExpr>());
        let new_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<*mut HirExpr>()) as *mut *mut HirExpr
        };
        if cnt > 0 && (unsafe { (*sc).defers as usize }) != 0 {
            let old_bytes = mir_mul_usize(cnt, size_of<*mut HirExpr>());
            unsafe {
                ptr_copy_nonoverlapping<u8>((*sc).defers as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        unsafe {
            (*sc).defers = new_arr;
            (*sc).defer_cap = new_cap;
        }
    }
    unsafe {
        let dst = mb_expr_ptr_at((*sc).defers, cnt);
        *dst = e;
        (*sc).defer_count = cnt + 1;
    }
}

fn mb_register_sym(b: mut_view<MirBuilder>, sym: SymbolId, loc: MirLocalId, is_slice_len: bool) {
    if b.sym_map_count >= b.sym_map_cap {
        let new_cap: usize = if b.sym_map_cap == 0 {
            16
        } else {
            b.sym_map_cap + b.sym_map_cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirSymLocalMapEntry>());
        let new_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<MirSymLocalMapEntry>()) as *mut MirSymLocalMapEntry
        };
        if b.sym_map_count > 0 && (b.sym_map as usize) != 0 {
            let old_bytes = mir_mul_usize(b.sym_map_count, size_of<MirSymLocalMapEntry>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.sym_map as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        b.sym_map = new_arr;
        b.sym_map_cap = new_cap;
    }
    let ent = unsafe {
        mb_sym_entry_at(b.sym_map, b.sym_map_count)
    };
    unsafe {
        (*ent).sym.v = sym.v;
        (*ent).local.v = loc.v;
        (*ent).is_slice_len = is_slice_len;
    }
    b.sym_map_count = b.sym_map_count + 1;
}

fn mb_lookup_sym(b: view<MirBuilder>, sym: SymbolId, out_loc: mut_view<MirLocalId>, out_is_slice_len: mut_view<bool>) -> bool {
    if sym.v == 0u32 {
        return false;
    }
    let mut i: usize = b.sym_map_count;
    while (i > 0) {
        i = i - 1;
        let ent = unsafe {
            mb_sym_entry_at(b.sym_map, i)
        };
        let esym = unsafe {
            (*ent).sym.v
        };
        if esym == sym.v {
            out_loc.v = unsafe {
                (*ent).local.v
            };
            *out_is_slice_len = unsafe {
                (*ent).is_slice_len
            };
            return true;
        }
    }
    false
}

fn mb_type_is_copy(b: view<MirBuilder>, ty: TypeId) -> bool {
    unsafe {
        type_is_copy((TypeId { v: ty.v }), view(*b.thir), view(*b.str_in))
    }
}

fn mb_operand_from_place(b: view<MirBuilder>, place: view<MirPlace>, ty: TypeId, out_op: mut_view<MirOperand>) {
    let ax = if ty.v != 0u32 {
        unsafe { type_get(view((*b.thir).interner), (TypeId { v: ty.v })) }
    } else {
        0 as *mut AxType
    };
    let mut is_cp = true;
    if (ax as usize) != 0 {
        let tk = unsafe {
            (*ax).kind
        };
        if tk == TY_STR || tk == TY_ARRAY {
            is_cp = false;
        }
    }
    if is_cp {
        out_op.kind = MIR_OP_COPY;
    } else {
        out_op.kind = MIR_OP_MOVE;
    }
    mir_copy_place(mut_view(out_op.place), place);
}

// True when some DEREF projection of `place` goes through a raw pointer (or a base whose type is
// not known to be a view/mut_view). Such a store is raw and never drops the old value; a place
// reached only through view/mut_view derefs is an ordinary initialised place (SPEC-03
// AXS-SEM-043). Mirrors axiom0 mir/build/builder.c place_has_raw_deref.
fn mb_place_has_raw_deref(b: view<MirBuilder>, place: view<MirPlace>) -> bool {
    let mut cur: u32 = 0u32;
    if (place.local.v as usize) < (unsafe { (*b.body).local_count }) {
        let decl = unsafe { mir_local_at((*b.body).locals, place.local.v as usize) };
        cur = unsafe { (*decl).ty.v };
    }
    let mut i: usize = 0;
    while i < place.proj_count {
        let pr = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*pr).kind };
        let t = if cur != 0u32 {
            unsafe { type_get(view((*b.thir).interner), (TypeId { v: cur })) }
        } else {
            0 as *mut AxType
        };
        let has_t = (t as usize) != 0;
        let tk = if has_t { unsafe { (*t).kind } } else { TY_ERROR };
        if pk == MIR_PROJ_DEREF {
            if !has_t || (tk != TY_VIEW && tk != TY_MUT_VIEW) {
                return true;
            }
            cur = unsafe { (*t).pointee.v };
        } else if !has_t {
            cur = 0u32;
        } else if pk == MIR_PROJ_FIELD {
            let fi = (unsafe { (*pr).field_idx }) as usize;
            if (tk == TY_STRUCT || tk == TY_TUPLE) && fi < (unsafe { (*t).field_count }) {
                cur = unsafe { (*typeid_at((*t).fields, fi)).v };
            } else {
                cur = 0u32;
            }
        } else if pk == MIR_PROJ_DOWNCAST {
            let mut done = false;
            if tk == TY_ENUM && i + 1 < place.proj_count {
                let nx = unsafe { mir_proj_at(place.projs, i + 1) };
                if (unsafe { (*nx).kind }) == MIR_PROJ_FIELD {
                    let vi = (unsafe { (*pr).variant_idx }) as usize;
                    let fi = (unsafe { (*nx).field_idx }) as usize;
                    let row = unsafe { *typeid_ptr_at((*t).variant_fields, vi) };
                    cur = unsafe { (*typeid_at(row, fi)).v };
                    i = i + 1;
                    done = true;
                }
            }
            if !done {
                cur = 0u32;
            }
        } else if pk == MIR_PROJ_INDEX {
            if tk == TY_ARRAY || tk == TY_SLICE {
                cur = unsafe { (*t).elem.v };
            } else {
                cur = 0u32;
            }
        }
        // MIR_PROJ_SUB_SLICE keeps the slice type.
        i = i + 1;
    }
    false
}

// --- Span Text & Helper Comparisons ---

fn mb_span_sv(b: view<MirBuilder>, sp: view<Span>) -> StrView {
    if (b.db as usize) == 0 || sp.file.v == 0u32 || sp.end <= sp.start {
        return StrView {
            ptr: 0 as *const u8, len: 0
        };
    }
    let s = Span {
        file: FileId { v: sp.file.v },
        start: sp.start,
        end: sp.end,
    };
    unsafe { source_db_span_text(view(*b.db), s) }
}

fn mb_sv_eq(a: view<StrView>, b: view<StrView>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while (i < a.len) {
        let ca = unsafe {
            *(a.ptr + i)
        };
        let cb = unsafe {
            *(b.ptr + i)
        };
        if ca != cb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn mb_sv_ends_with_dot_name(full: view<StrView>, name: view<StrView>) -> bool {
    if name.len == 0 || (full.len) < name.len {
        return false;
    }
    if full.len == name.len {
        return mb_sv_eq(full, name);
    }
    let prefix_len = full.len - name.len;
    let sep = unsafe {
        *(full.ptr + prefix_len - 1)
    };
    if sep != 46u8 && sep != 58u8 {
        return false;
    }
    let tail = StrView {
        ptr: unsafe { full.ptr + prefix_len },
        len: name.len,
    };
    mb_sv_eq(view(tail), name)
}

fn mb_item_name_sv(b: view<MirBuilder>, it: *mut HirItem) -> StrView {
    if (it as usize) == 0 {
        return StrView {
            ptr: 0 as *const u8, len: 0
        };
    }
    let nv = unsafe {
        (*it).name.v
    };
    if nv != 0u32 {
        return unsafe {
            interner_get(view(*b.str_in), StrId {
                v: nv
            })
        };
    }
    let sp = Span {
        file: FileId { v: unsafe { (*it).span.file.v } },
        start: unsafe { (*it).span.start },
        end: unsafe { (*it).span.end },
    };
    mb_span_sv(b, view(sp))
}

fn mb_find_item_by_sym(hir: *const HirFile, sym: SymbolId) -> *mut HirItem {
    if sym.v == 0u32 || (hir as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let mut it: *mut HirItem = unsafe {
        (*hir).items
    };
    while ((it as usize) != 0) {
        if (unsafe { (*it).symbol.v }) == sym.v {
            return it;
        }
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe {
                (*it).members
            };
            while ((m as usize) != 0) {
                if (unsafe { (*m).symbol.v }) == sym.v {
                    return m;
                }
                m = unsafe {
                    (*m).next
                };
            }
        }
        it = unsafe {
            (*it).next
        };
    }
    0 as *mut HirItem
}

fn mb_find_item_by_path_sv(b: view<MirBuilder>, path_sv: view<StrView>) -> *mut HirItem {
    if path_sv.len == 0 || (b.hir as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let mut it: *mut HirItem = unsafe {
        (*b.hir).items
    };
    while ((it as usize) != 0) {
        let ik = unsafe {
            (*it).kind
        };
        if ik == HIR_ITEM_FN || ik == HIR_ITEM_STRUCT || ik == HIR_ITEM_ENUM || ik == HIR_ITEM_CONST {
            let iname = mb_item_name_sv(b, it);
            if mb_sv_ends_with_dot_name(path_sv, view(iname)) {
                return it;
            }
        }
        if ik == HIR_ITEM_IMPL {
            let st: *mut HirType = unsafe {
                (*it).self_type
            };
            let mut self_name = StrView {
                ptr: 0 as *const u8, len: 0
            };
            if (st as usize) != 0 {
                let sn_v = unsafe {
                    (*st).path.name.v
                };
                if sn_v != 0u32 {
                    self_name = unsafe {
                        interner_get(view(*b.str_in), StrId {
                            v: sn_v
                        })
                    };
                } else {
                    let st_sp = Span {
                        file: FileId { v: unsafe { (*st).span.file.v } },
                        start: unsafe { (*st).span.start },
                        end: unsafe { (*st).span.end },
                    };
                    self_name = mb_span_sv(b, view(st_sp));
                }
            }
            let mut m: *mut HirItem = unsafe {
                (*it).members
            };
            while ((m as usize) != 0) {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    let mname = mb_item_name_sv(b, m);
                    if mb_sv_ends_with_dot_name(path_sv, view(mname)) {
                        if self_name.len == 0 || path_sv.len == mname.len {
                            return m;
                        }
                        // Check if prefix before `.mname` ends with `self_name`
                        let prefix_len = path_sv.len - mname.len - 1;
                        let prefix_sv = StrView {
                            ptr: path_sv.ptr, len: prefix_len
                        };
                        if mb_sv_ends_with_dot_name(view(prefix_sv), view(self_name)) {
                            return m;
                        }
                    }
                }
                m = unsafe {
                    (*m).next
                };
            }
        }
        it = unsafe {
            (*it).next
        };
    }
    0 as *mut HirItem
}

fn mb_has_intrinsic_attr(str_in: *const StrInterner, db: *const SourceDatabase, func: *const HirItem) -> bool {
    let mut at: *mut HirAttr = unsafe { (*func).attrs };
    while (at as usize) != 0 {
        let mut an = StrView { ptr: 0 as *const u8, len: 0 };
        if (str_in as usize) != 0 && (unsafe { (*at).name.v }) != 0u32 {
            an = unsafe { interner_get(view(*str_in), StrId { v: (*at).name.v }) };
        } else if (db as usize) != 0 {
            let asp = Span {
                file: FileId { v: unsafe { (*at).span.file.v } },
                start: unsafe { (*at).span.start },
                end: unsafe { (*at).span.end },
            };
            if asp.file.v != 0u32 && asp.end > asp.start {
                an = unsafe { source_db_span_text(view(*db), asp) };
            }
        }
        if an.len == 9 && (an.ptr as usize) != 0 {
            if unsafe {
                *(an.ptr + 0) == 105u8 && *(an.ptr + 1) == 110u8 && *(an.ptr + 2) == 116u8 &&
                *(an.ptr + 3) == 114u8 && *(an.ptr + 4) == 105u8 && *(an.ptr + 5) == 110u8 &&
                *(an.ptr + 6) == 115u8 && *(an.ptr + 7) == 105u8 && *(an.ptr + 8) == 99u8
            } {
                return true;
            }
        }
        at = unsafe { (*at).next };
    }
    false
}

fn mb_item_term_intrinsic_kind(str_in: *const StrInterner, db: *const SourceDatabase, func: *const HirItem) -> u8 {
    if (func as usize) == 0 || (unsafe { (*func).kind }) != HIR_ITEM_FN {
        return 0u8;
    }
    if !mb_has_intrinsic_attr(str_in, db, func) {
        return 0u8;
    }
    let mut fn_sv = StrView { ptr: 0 as *const u8, len: 0 };
    if (str_in as usize) != 0 && (unsafe { (*func).name.v }) != 0u32 {
        fn_sv = unsafe { interner_get(view(*str_in), StrId { v: (*func).name.v }) };
    } else if (db as usize) != 0 {
        let fsp = Span {
            file: FileId { v: unsafe { (*func).span.file.v } },
            start: unsafe { (*func).span.start },
            end: unsafe { (*func).span.end },
        };
        if fsp.file.v != 0u32 && fsp.end > fsp.start {
            fn_sv = unsafe { source_db_span_text(view(*db), fsp) };
        }
    }
    if fn_sv.len == 6 && (fn_sv.ptr as usize) != 0 {
        if unsafe {
            *(fn_sv.ptr + 0) == 97u8 && *(fn_sv.ptr + 1) == 115u8 && *(fn_sv.ptr + 2) == 115u8 &&
            *(fn_sv.ptr + 3) == 101u8 && *(fn_sv.ptr + 4) == 114u8 && *(fn_sv.ptr + 5) == 116u8
        } {
            return 1u8;
        }
    }
    if fn_sv.len == 5 && (fn_sv.ptr as usize) != 0 {
        if unsafe {
            *(fn_sv.ptr + 0) == 112u8 && *(fn_sv.ptr + 1) == 97u8 && *(fn_sv.ptr + 2) == 110u8 &&
            *(fn_sv.ptr + 3) == 105u8 && *(fn_sv.ptr + 4) == 99u8
        } {
            return 2u8;
        }
    }
    if fn_sv.len == 11 && (fn_sv.ptr as usize) != 0 {
        if unsafe {
            *(fn_sv.ptr + 0) == 117u8 && *(fn_sv.ptr + 1) == 110u8 && *(fn_sv.ptr + 2) == 114u8 &&
            *(fn_sv.ptr + 3) == 101u8 && *(fn_sv.ptr + 4) == 97u8 && *(fn_sv.ptr + 5) == 99u8 &&
            *(fn_sv.ptr + 6) == 104u8 && *(fn_sv.ptr + 7) == 97u8 && *(fn_sv.ptr + 8) == 98u8 &&
            *(fn_sv.ptr + 9) == 108u8 && *(fn_sv.ptr + 10) == 101u8
        } {
            return 3u8;
        }
    }
    0u8
}

fn mb_find_struct_field_index(
    b: view<MirBuilder>,
    def: *mut HirItem,
    fname_id: StrId,
    fspan: view<Span>
) -> u32 {
    if (def as usize) == 0 {
        return 0u32;
    }
    let mut target_sv = StrView {
        ptr: 0 as *const u8, len: 0
    };
    if fname_id.v != 0u32 {
        target_sv = unsafe {
            interner_get(view(*b.str_in), (StrId {
                v: fname_id.v
            }))
        };
    } else {
        target_sv = mb_span_sv(b, fspan);
    }
    let mut sf: *mut HirFieldDecl = unsafe {
        (*def).struct_fields
    };
    let mut idx: u32 = 0u32;
    while ((sf as usize) != 0) {
        let sfn_v = unsafe {
            (*sf).name.v
        };
        if fname_id.v != 0u32 && sfn_v == fname_id.v {
            return idx;
        }
        if target_sv.len > 0 {
            let mut sf_sv = StrView {
                ptr: 0 as *const u8, len: 0
            };
            if sfn_v != 0u32 {
                sf_sv = unsafe {
                    interner_get(view(*b.str_in), StrId {
                        v: sfn_v
                    })
                };
            } else {
                let sf_sp = Span {
                    file: FileId { v: unsafe { (*sf).span.file.v } },
                    start: unsafe { (*sf).span.start },
                    end: unsafe { (*sf).span.end },
                };
                sf_sv = mb_span_sv(b, view(sf_sp));
            }
            if mb_sv_eq(view(target_sv), view(sf_sv)) {
                return idx;
            }
        }
        idx = idx + 1u32;
        sf = unsafe {
            (*sf).next
        };
    }
    0u32
}

fn mb_find_enum_variant_field_index(
    b: view<MirBuilder>,
    def: *mut HirItem,
    v_idx: u32,
    fname_id: StrId,
    fspan: view<Span>
) -> u32 {
    if (def as usize) == 0 {
        return 0u32;
    }
    let mut vd: *mut HirVariantDecl = unsafe {
        (*def).variants
    };
    let mut cur_v: u32 = 0u32;
    while ((vd as usize) != 0 && cur_v < v_idx) {
        vd = unsafe {
            (*vd).next
        };
        cur_v = cur_v + 1u32;
    }
    if (vd as usize) == 0 {
        return 0u32;
    }
    let mut target_sv = StrView {
        ptr: 0 as *const u8, len: 0
    };
    if fname_id.v != 0u32 {
        target_sv = unsafe {
            interner_get(view(*b.str_in), (StrId {
                v: fname_id.v
            }))
        };
    } else {
        target_sv = mb_span_sv(b, fspan);
    }
    let mut sf: *mut HirFieldDecl = unsafe {
        (*vd).struct_fields
    };
    let mut idx: u32 = 0u32;
    while ((sf as usize) != 0) {
        let sfn_v = unsafe {
            (*sf).name.v
        };
        if fname_id.v != 0u32 && sfn_v == fname_id.v {
            return idx;
        }
        if target_sv.len > 0 {
            let mut sf_sv = StrView {
                ptr: 0 as *const u8, len: 0
            };
            if sfn_v != 0u32 {
                sf_sv = unsafe {
                    interner_get(view(*b.str_in), StrId {
                        v: sfn_v
                    })
                };
            } else {
                let sf_sp = Span {
                    file: FileId { v: unsafe { (*sf).span.file.v } },
                    start: unsafe { (*sf).span.start },
                    end: unsafe { (*sf).span.end },
                };
                sf_sv = mb_span_sv(b, view(sf_sp));
            }
            if mb_sv_eq(view(target_sv), view(sf_sv)) {
                return idx;
            }
        }
        idx = idx + 1u32;
        sf = unsafe {
            (*sf).next
        };
    }
    0u32
}

fn mb_parse_decimal_u32(sv: view<StrView>, out_val: mut_view<u32>) -> bool {
    if sv.len == 0 {
        return false;
    }
    let mut v: u32 = 0u32;
    let mut i: usize = 0;
    while (i < sv.len) {
        let c = unsafe {
            *(sv.ptr + i)
        };
        if c < 48u8 || c > 57u8 {
            return false;
        }
        v = (v * 10u32) + ((c - 48u8) as u32);
        i = i + 1;
    }
    *out_val = v;
    true
}

// --- Scope Cleanup, Defers & Drops ---

fn mb_emit_scope_cleanup(b: mut_view<MirBuilder>, target_depth: usize, sp: view<Span>) {
    let mut d_idx: usize = b.scope_depth;
    while (d_idx > target_depth) {
        d_idx = d_idx - 1;
        let sc = unsafe {
            mb_defer_scope_at(b.scopes, d_idx)
        };
        let mut def_i: usize = unsafe {
            (*sc).defer_count
        };
        while (def_i > 0) {
            def_i = def_i - 1;
            if !b.is_diverged {
                let sc_cur = unsafe {
                    mb_defer_scope_at(b.scopes, d_idx)
                };
                let def_expr = unsafe {
                    *mb_expr_ptr_at((*sc_cur).defers, def_i)
                };
                let mut dummy_dest = mir_local_place(0u32);
                mir_build_expr(mut_view(*b), def_expr, mut_view(dummy_dest), false);
            }
        }
        let sc_after = unsafe {
            mb_defer_scope_at(b.scopes, d_idx)
        };
        let mut loc_i: usize = unsafe {
            (*sc_after).local_count
        };
        while (loc_i > 0) {
            loc_i = loc_i - 1;
            if !b.is_diverged {
                let sc_loc = unsafe {
                    mb_defer_scope_at(b.scopes, d_idx)
                };
                let loc_id_v = unsafe {
                    (*mb_local_id_at((*sc_loc).locals, loc_i)).v
                };
                let loc_decl = unsafe {
                    mir_local_at((*b.body).locals, loc_id_v as usize)
                };
                let loc_ty = TypeId {
                    v: unsafe {
                        (*loc_decl).ty.v
                    }
                };
                if unsafe { mir_type_needs_drop_in((TypeId { v: loc_ty.v }), view(*b.thir), view(*b.hir), b.db, view(*b.str_in)) } {
                    let next_bb = mb_new_bb(mut_view(*b), false);
                    let ubb = mb_get_unwind_bb(mut_view(*b), sp);
                    let cur_bb_ptr = unsafe {
                        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                    };
                    unsafe {
                        mir_term_zero(mut_view((*cur_bb_ptr).terminator), MIR_TERM_DROP);
                        (*cur_bb_ptr).terminator.span.file.v = sp.file.v;
                        (*cur_bb_ptr).terminator.span.start = sp.start;
                        (*cur_bb_ptr).terminator.span.end = sp.end;
                        (*cur_bb_ptr).terminator.drop_place = mir_local_place(loc_id_v);
                        (*cur_bb_ptr).terminator.drop_target.v = next_bb.v;
                        (*cur_bb_ptr).terminator.drop_unwind.v = ubb.v;
                        (*cur_bb_ptr).has_terminator = true;
                    }
                    b.curr_bb.v = next_bb.v;
                    b.is_diverged = false;
                }
                mb_emit_storage_dead(mut_view(*b), MirLocalId {
                    v: loc_id_v
                }, sp);
            }
        }
    }
}

fn mb_pop_scope(b: mut_view<MirBuilder>, sp: view<Span>) {
    if b.scope_depth == 0 {
        return;
    }
    mb_emit_scope_cleanup(mut_view(*b), b.scope_depth - 1, sp);
    b.scope_depth = b.scope_depth - 1;
}

// --- Literal & Constant Evaluation Helpers ---

fn mb_hex_val(c: u8) -> u64 {
    if c >= 48u8 && c <= 57u8 {
        return (c - 48u8) as u64;
    }
    if c >= 97u8 && c <= 102u8 {
        return (c - 97u8 + 10u8) as u64;
    }
    if c >= 65u8 && c <= 70u8 {
        return (c - 65u8 + 10u8) as u64;
    }
    0u64
}

fn mb_is_hex_digit(c: u8) -> bool {
    (c >= 48u8 && c <= 57u8) || (c >= 97u8 && c <= 102u8) || (c >= 65u8 && c <= 70u8)
}

fn mb_parse_int_sv(sv: view<StrView>, is_negated: bool) -> u64 {
    if sv.len == 0 || (sv.ptr as usize) == 0 {
        return 0u64;
    }
    let mut i: usize = 0;
    let mut neg: bool = is_negated;
    if i < sv.len && (unsafe { *(sv.ptr + i) }) == 45u8 {
        neg = !neg;
        i = i + 1;
    }
    let mut base: u64 = 10u64;
    if (i + 2) <= sv.len && (unsafe { *(sv.ptr + i) }) == 48u8 {
        let c1 = unsafe {
            *(sv.ptr + i + 1)
        };
        if c1 == 120u8 || c1 == 88u8 {
            base = 16u64;
            i = i + 2;
        } else if c1 == 98u8 || c1 == 66u8 {
            base = 2u64;
            i = i + 2;
        } else if c1 == 111u8 || c1 == 79u8 {
            base = 8u64;
            i = i + 2;
        }
    }
    let mut val: u64 = 0u64;
    while (i < sv.len) {
        let c = unsafe {
            *(sv.ptr + i)
        };
        if c == 95u8 {
            i = i + 1;
            continue;
        }
        if base == 10u64 {
            if c < 48u8 || c > 57u8 {
                break;
            }
            val = mir_mul_u64(val, 10u64) + ((c - 48u8) as u64);
        } else if base == 16u64 {
            if !mb_is_hex_digit(c) {
                break;
            }
            val = mir_mul_u64(val, 16u64) + mb_hex_val(c);
        } else if base == 2u64 {
            if c != 48u8 && c != 49u8 {
                break;
            }
            val = mir_mul_u64(val, 2u64) + ((c - 48u8) as u64);
        } else {
            if c < 48u8 || c > 55u8 {
                break;
            }
            val = mir_mul_u64(val, 8u64) + ((c - 48u8) as u64);
        }
        i = i + 1;
    }
    if neg {
        return (0i64 - (val as i64)) as u64;
    }
    val
}

fn mb_parse_char_sv(sv: view<StrView>) -> u64 {
    if (sv.len) < 2 || (sv.ptr as usize) == 0 {
        return 0u64;
    }
    let c0 = unsafe {
        *(sv.ptr + 1)
    };
    if c0 != 92u8 {
        return c0 as u64;
    }
    if (sv.len) < 3 {
        return 0u64;
    }
    let esc = unsafe {
        *(sv.ptr + 2)
    };
    if esc == 110u8 {
        return 10u64;
    }
    if esc == 114u8 {
        return 13u64;
    }
    if esc == 116u8 {
        return 9u64;
    }
    if esc == 48u8 {
        return 0u64;
    }
    if esc == 92u8 {
        return 92u64;
    }
    if esc == 39u8 {
        return 39u64;
    }
    if esc == 34u8 {
        return 34u64;
    }
    esc as u64
}

fn mb_token_int_val(b: view<MirBuilder>, tok: view<Token>, is_negated: bool) -> u64 {
    let tk = tok.kind;
    if tk == TOK_KW_TRUE {
        return 1u64;
    }
    if tk == TOK_KW_FALSE {
        return 0u64;
    }
    if tk == TOK_CHAR {
        if tok.char_val != 0u32 || tok.int_val != 0u64 {
            let v: u64 = if tok.int_val != 0u64 {
                tok.int_val
            } else {
                tok.char_val as u64
            };
            return v;
        }
        let sv = mb_span_sv(b, view(tok.span));
        return mb_parse_char_sv(view(sv));
    }
    if tok.int_val != 0u64 {
        if is_negated {
            return (0i64 - (tok.int_val as i64)) as u64;
        }
        return tok.int_val;
    }
    let sv = mb_span_sv(b, view(tok.span));
    mb_parse_int_sv(view(sv), is_negated)
}

fn mb_eval_const_int_expr(b: view<MirBuilder>, e: *mut HirExpr) -> u64 {
    if (e as usize) == 0 {
        return 0u64;
    }
    let ek = unsafe {
        (*e).kind
    };
    if ek == HIR_EXPR_LITERAL {
        return unsafe {
            mb_token_int_val(b, view((*e).literal), false)
        };
    }
    if ek == HIR_EXPR_UNARY {
        let v = mb_eval_const_int_expr(b, unsafe {
            (*e).inner
        });
        let uop = unsafe {
            (*e).op
        };
        if uop == UNOP_NEG {
            return (0i64 - (v as i64)) as u64;
        }
        if uop == UNOP_NOT || uop == UNOP_BITNOT {
            return ~v;
        }
        return v;
    }
    if ek == HIR_EXPR_PATH {
        let sym = SymbolId {
            v: unsafe {
                (*e).path.symbol.v
            }
        };
        if sym.v != 0u32 {
            let cv = unsafe {
                sym_constmap_get(view((*b.thir).symbol_consts), (SymbolId {
                    v: sym.v
                }))
            };
            if (cv as usize) != 0 {
                return unsafe {
                    (*cv).int_val as u64
                };
            }
        }
    }
    0u64
}

fn mb_parse_pat_int(b: view<MirBuilder>, pat: *mut HirPat) -> u64 {
    if (pat as usize) == 0 {
        return 0u64;
    }
    unsafe {
        mb_token_int_val(b, view((*pat).tok), (*pat).is_negated)
    }
}

fn mb_resolve_pat_variant_idx(b: view<MirBuilder>, pat: *mut HirPat, scrut_ty: TypeId, out_v_idx: mut_view<u32>) -> bool {
    let vp = unsafe {
        thir_get_pat_variant(view(*b.thir), pat as *const HirPat)
    };
    if (vp as usize) != 0 {
        *out_v_idx = unsafe {
            *vp
        };
        return true;
    }
    let ax = unsafe {
        type_get(view((*b.thir).interner), (TypeId {
            v: scrut_ty.v
        }))
    };
    if (ax as usize) == 0 || (unsafe { (*ax).kind }) != TY_ENUM {
        return false;
    }
    let enum_def = unsafe {
        (*ax).def
    };
    if (enum_def as usize) == 0 {
        return false;
    }
    let mut target_sv = StrView {
        ptr: 0 as *const u8, len: 0
    };
    let pk = unsafe {
        (*pat).kind
    };
    if pk == HIR_PAT_PATH || pk == HIR_PAT_STRUCT {
        let nv = unsafe {
            (*pat).path.name.v
        };
        if nv != 0u32 {
            target_sv = unsafe {
                interner_get(view(*b.str_in), StrId {
                    v: nv
                })
            };
        }
    }
    if target_sv.len == 0 {
        let psp = Span {
            file: FileId { v: unsafe { (*pat).span.file.v } },
            start: unsafe { (*pat).span.start },
            end: unsafe { (*pat).span.end },
        };
        target_sv = mb_span_sv(b, view(psp));
    }
    if target_sv.len == 0 {
        return false;
    }
    let mut vd: *mut HirVariantDecl = unsafe {
        (*enum_def).variants
    };
    let mut idx: u32 = 0u32;
    while ((vd as usize) != 0) {
        let vnv = unsafe {
            (*vd).name.v
        };
        let mut v_sv = StrView {
            ptr: 0 as *const u8, len: 0
        };
        if vnv != 0u32 {
            v_sv = unsafe {
                interner_get(view(*b.str_in), StrId {
                    v: vnv
                })
            };
        } else {
            let vsp = Span {
                file: FileId { v: unsafe { (*vd).span.file.v } },
                start: unsafe { (*vd).span.start },
                end: unsafe { (*vd).span.end },
            };
            v_sv = mb_span_sv(b, view(vsp));
        }
        if mb_sv_ends_with_dot_name(view(target_sv), view(v_sv)) {
            *out_v_idx = idx;
            return true;
        }
        idx = idx + 1u32;
        vd = unsafe {
            (*vd).next
        };
    }
    false
}

fn mb_emit_switch_single(
    b: mut_view<MirBuilder>,
    discr_op: view<MirOperand>,
    val: u64,
    true_bb: MirBbId,
    false_bb: MirBbId,
    sp: view<Span>
) {
    if b.is_diverged {
        return;
    }
    mb_consume_op(mut_view(*b), discr_op);
    let vals = unsafe {
        arena_alloc_raw(mut_view(*b.arena), size_of<u64>(), align_of<u64>()) as *mut u64
    };
    let tgs = unsafe {
        arena_alloc_raw(mut_view(*b.arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId
    };
    unsafe {
        *vals = val;
        (*tgs).v = true_bb.v;
    }
    let bb = unsafe {
        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
    };
    unsafe {
        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_SWITCH_INT);
        (*bb).terminator.span.file.v = sp.file.v;
        (*bb).terminator.span.start = sp.start;
        (*bb).terminator.span.end = sp.end;
        mir_copy_operand(mut_view((*bb).terminator.discr), discr_op);
        (*bb).terminator.values = vals;
        (*bb).terminator.targets = tgs;
        (*bb).terminator.switch_count = 1;
        (*bb).terminator.otherwise.v = false_bb.v;
        (*bb).has_terminator = true;
    }
    b.is_diverged = true;
}

fn mb_append_proj_deref(b: mut_view<MirBuilder>, src: view<MirPlace>) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_DEREF,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    unsafe {
        mir_place_append_proj(mut_view(*b.arena), src, view(proj), mut_view(dst));
    }
    dst
}

fn mb_append_proj_field(b: mut_view<MirBuilder>, src: view<MirPlace>, f_idx: u32) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_FIELD,
        field_idx: f_idx,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    unsafe {
        mir_place_append_proj(mut_view(*b.arena), src, view(proj), mut_view(dst));
    }
    dst
}

fn mb_append_proj_index(b: mut_view<MirBuilder>, src: view<MirPlace>, idx_loc: MirLocalId) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_INDEX,
        field_idx: 0u32,
        index_local: MirLocalId { v: idx_loc.v },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    unsafe {
        mir_place_append_proj(mut_view(*b.arena), src, view(proj), mut_view(dst));
    }
    dst
}

fn mb_append_proj_downcast(b: mut_view<MirBuilder>, src: view<MirPlace>, v_idx: u32) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_DOWNCAST,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: v_idx,
    };
    let mut dst = mir_local_place(0u32);
    unsafe {
        mir_place_append_proj(mut_view(*b.arena), src, view(proj), mut_view(dst));
    }
    dst
}

fn mb_emit_assert(
    b: mut_view<MirBuilder>,
    cond: view<MirOperand>,
    expected: bool,
    msg_kind: u8,
    sp: view<Span>
) {
    if b.is_diverged {
        return;
    }
    mb_consume_op(mut_view(*b), cond);
    let next_bb = mb_new_bb(mut_view(*b), false);
    let ubb = mb_new_bb(mut_view(*b), false);
    let ubb_ptr = unsafe {
        mir_bb_at((*b.body).bbs, ubb.v as usize)
    };
    unsafe {
        mir_term_zero(mut_view((*ubb_ptr).terminator), MIR_TERM_UNREACHABLE);
        (*ubb_ptr).has_terminator = true;
    }
    let mut msg_len: usize = 0;
    let msg_ptr = unsafe {
        mb_alloc_msg_kind(mut_view(*b.arena), msg_kind, mut_view(msg_len))
    };
    let bb = unsafe {
        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
    };
    unsafe {
        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_ASSERT);
        (*bb).terminator.span.file.v = sp.file.v;
        (*bb).terminator.span.start = sp.start;
        (*bb).terminator.span.end = sp.end;
        mir_copy_operand(mut_view((*bb).terminator.cond), cond);
        (*bb).terminator.expected = expected;
        (*bb).terminator.msg_ptr = msg_ptr;
        (*bb).terminator.msg_len = msg_len;
        (*bb).terminator.assert_target.v = next_bb.v;
        (*bb).terminator.assert_unwind.v = ubb.v;
        (*bb).has_terminator = true;
    }
    b.curr_bb.v = next_bb.v;
    b.is_diverged = false;
}



// =============================================================================
// Pattern Local Declaration & Decision Tree Lowering
// =============================================================================

fn mb_declare_pat_locals(b: mut_view<MirBuilder>, pat: *mut HirPat, ty: TypeId) {
    if (pat as usize) == 0 {
        return;
    }
    let pk = unsafe {
        (*pat).kind
    };
    let sp = Span {
        file: FileId { v: unsafe { (*pat).span.file.v } },
        start: unsafe { (*pat).span.start },
        end: unsafe { (*pat).span.end },
    };
    if pk == HIR_PAT_BINDING {
        let sym = SymbolId {
            v: unsafe {
                (*pat).symbol.v
            }
        };
        let loc = mb_new_local(mut_view(*b), (TypeId {
            v: ty.v
        }), MIR_LOCAL_USER, unsafe {
            (*pat).is_mut
        }, StrId {
            v: unsafe {
                (*pat).path.name.v
            }
        }, view(sp));
        if sym.v != 0u32 {
            mb_register_sym(mut_view(*b), (SymbolId {
                v: sym.v
            }), (MirLocalId {
                v: loc.v
            }), false);
        }
    } else if pk == HIR_PAT_TUPLE {
        let t = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: ty.v
            }))
        };
        if (t as usize) == 0 || (unsafe { (*t).kind }) != TY_TUPLE {
            return;
        }
        let mut i: usize = 0;
        let mut el: *mut HirPat = unsafe {
            (*pat).elems
        };
        while ((el as usize) != 0) {
            if i < (unsafe { (*t).field_count }) {
                let fptr = unsafe {
                    typeid_at((*t).fields, i)
                };
                mb_declare_pat_locals(mut_view(*b), el, TypeId {
                    v: unsafe {
                        (*fptr).v
                    }
                });
            }
            i = i + 1;
            el = unsafe {
                (*el).next
            };
        }
    } else if pk == HIR_PAT_STRUCT {
        let t = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: ty.v
            }))
        };
        if (t as usize) == 0 {
            return;
        }
        let tk = unsafe {
            (*t).kind
        };
        if tk == TY_STRUCT {
            let def_item: *mut HirItem = unsafe {
                ((*t).def) as *mut HirItem
            };
            let mut pf: *mut HirPatField = unsafe {
                (*pat).fields
            };
            while ((pf as usize) != 0) {
                let pf_sp = Span {
                    file: FileId { v: unsafe { (*pf).span.file.v } },
                    start: unsafe { (*pf).span.start },
                    end: unsafe { (*pf).span.end },
                };
                let f_idx = mb_find_struct_field_index(view(*b), def_item, StrId {
                    v: unsafe {
                        (*pf).name.v
                    }
                }, view(pf_sp));
                if (f_idx as usize) < (unsafe { (*t).field_count }) {
                    let fptr = unsafe {
                        typeid_at((*t).fields, f_idx as usize)
                    };
                    mb_declare_pat_locals(mut_view(*b), unsafe {
                        (*pf).pat
                    }, TypeId {
                        v: unsafe {
                            (*fptr).v
                        }
                    });
                }
                pf = unsafe {
                    (*pf).next
                };
            }
        } else if tk == TY_ENUM && (unsafe { (*t).variant_count }) == 1 {
            let def_item: *mut HirItem = unsafe {
                ((*t).def) as *mut HirItem
            };
            let mut pf: *mut HirPatField = unsafe {
                (*pat).fields
            };
            while ((pf as usize) != 0) {
                let pf_sp = Span {
                    file: FileId { v: unsafe { (*pf).span.file.v } },
                    start: unsafe { (*pf).span.start },
                    end: unsafe { (*pf).span.end },
                };
                let f_idx = mb_find_enum_variant_field_index(view(*b), def_item, 0u32, StrId {
                    v: unsafe {
                        (*pf).name.v
                    }
                }, view(pf_sp));
                let vfc = unsafe {
                    *usize_at((*t).variant_field_counts, 0)
                };
                if (f_idx as usize) < vfc {
                    let vf_row = unsafe {
                        *typeid_ptr_at((*t).variant_fields, 0)
                    };
                    let fptr = unsafe {
                        typeid_at(vf_row, f_idx as usize)
                    };
                    mb_declare_pat_locals(mut_view(*b), unsafe {
                        (*pf).pat
                    }, TypeId {
                        v: unsafe {
                            (*fptr).v
                        }
                    });
                }
                pf = unsafe {
                    (*pf).next
                };
            }
        }
    } else if pk == HIR_PAT_PATH {
        let payload_head: *mut HirPat = unsafe {
            (*pat).payload
        };
        if (payload_head as usize) != 0 {
            let t = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: ty.v
                }))
            };
            if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_ENUM && (unsafe { (*t).variant_count }) == 1 {
                let vfc = unsafe {
                    *usize_at((*t).variant_field_counts, 0)
                };
                let vf_row = unsafe {
                    *typeid_ptr_at((*t).variant_fields, 0)
                };
                let mut el: *mut HirPat = if (unsafe { (*payload_head).kind }) == HIR_PAT_TUPLE && (unsafe { (*payload_head).elems as usize }) != 0 {
                    unsafe { (*payload_head).elems }
                } else {
                    payload_head
                };
                let mut idx: usize = 0;
                while ((el as usize) != 0) {
                    if idx < vfc {
                        let fptr = unsafe {
                            typeid_at(vf_row, idx)
                        };
                        mb_declare_pat_locals(mut_view(*b), el, TypeId {
                            v: unsafe {
                                (*fptr).v
                            }
                        });
                    }
                    idx = idx + 1;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
        }
    }
}

fn mb_build_pat_match_in_place(
    b: mut_view<MirBuilder>,
    pat: *mut HirPat,
    scrutinee: view<MirPlace>,
    scrut_ty: TypeId,
    on_fail: MirBbId
) {
    if (pat as usize) == 0 {
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*pat).span.file.v } },
        start: unsafe { (*pat).span.start },
        end: unsafe { (*pat).span.end },
    };
    let s_ty = mb_resolve_ty(mut_view(*b), (TypeId {
        v: scrut_ty.v
    }));
    let pk = unsafe {
        (*pat).kind
    };

    if pk == HIR_PAT_WILDCARD {
        return;
    } else if pk == HIR_PAT_BINDING {
        let mut v_idx: u32 = 0u32;
        if mb_resolve_pat_variant_idx(view(*b), pat, (TypeId { v: s_ty.v }), mut_view(v_idx)) && (unsafe { (*pat).symbol.v }) == 0u32 {
            let u32_ty = TypeId {
                v: unsafe {
                    (*b.thir).interner.t_u32.v
                }
            };
            let discr_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: u32_ty.v
            }), view(sp));
            let discr_pl = mir_local_place(discr_loc.v);
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_DISCRIMINANT;
            mir_copy_place(mut_view(rv.place), scrutinee);
            mb_emit_assign(mut_view(*b), view(discr_pl), view(rv), view(sp));
            let bb_succ = mb_new_bb(mut_view(*b), false);
            let discr_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: discr_loc.v
