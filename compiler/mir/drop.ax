@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// The name of the destructor trait, compared byte-wise with the last segment of every impl trait path.
const DROP_TRAIT_NAME: [4]u8 = [68u8, 114u8, 111u8, 112u8];

// =================================================================================================
// String helpers
// =================================================================================================

fn drop_sv_eq(a: view<StrView>, b: view<StrView>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let byte_a = unsafe { *(a.ptr + i) };
        let byte_b = unsafe { *(b.ptr + i) };
        if byte_a != byte_b {
            return false;
        }
        i = i + 1;
    }
    true
}

// Cuts a type path text at its first `<` (`Wrap<T>` -> `Wrap`).
fn drop_sv_before_generics(sv: StrView) -> StrView {
    let mut less_idx: usize = 0;
    while less_idx < sv.len {
        let byte = unsafe { *(sv.ptr + less_idx) };
        if byte == 60u8 {
            break;
        }
        less_idx = less_idx + 1;
    }
    StrView { ptr: sv.ptr, len: less_idx }
}

// =================================================================================================
// User destructors (`impl Drop for T`)
// =================================================================================================

// SPEC-12 AXS-DROP-008 (ADR-0036 section 5): `impl P for T` declares the destructor of `T` iff the trait
// path `P` resolves to the prelude lang item `Drop`: `P` is the single segment `Drop` without generic
// arguments, and the impl's module neither declares a trait, struct, enum or type alias named `Drop` nor
// binds the name `Drop` with a `use`. Same predicate as hir_impl_is_lang_drop (compiler/hir/lower.ax,
// documented there), tc_impl_is_lang_drop (compiler/types/typeck.ax) and ax_hir_impl_is_lang_drop
// (bootstrap/axiom0/src/mir/drop/drop.c). The trait name is never read from source text.
fn drop_name_is_drop(interner: view<StrInterner>, id: StrId) -> bool {
    if id.v == 0u32 {
        return false;
    }
    let sv = interner_get(interner, id);
    if sv.len != 4 {
        return false;
    }
    let mut i: usize = 0;
    while i < 4 {
        let byte = unsafe { *(sv.ptr + i) };
        if byte != DROP_TRAIT_NAME[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn drop_use_tree_binds_drop(interner: view<StrInterner>, t: *mut HirUseTree) -> bool {
    let mut cur: *mut HirUseTree = t;
    while (cur as usize) != 0 {
        let count = unsafe { (*cur).path.count };
        if (unsafe { (*cur).subtrees as usize }) != 0 {
            if drop_use_tree_binds_drop(interner, unsafe { (*cur).subtrees }) {
                return true;
            }
        } else if (unsafe { (*cur).alias.v }) != 0u32 {
            if drop_name_is_drop(interner, unsafe { (*cur).alias }) {
                return true;
            }
        } else if count > 0 {
            let off = (((count - 1) as isize) * (size_of<StrId>() as isize)) as usize;
            let seg_ptr = ((unsafe { (*cur).path.segments } as usize) + off) as *const StrId;
            if drop_name_is_drop(interner, unsafe { *seg_ptr }) {
                return true;
            }
        }
        cur = unsafe { (*cur).next };
    }
    false
}

fn drop_module_path_eq(a: *mut HirItem, b: *mut HirItem) -> bool {
    let count = unsafe { (*a).module_path.count };
    if count != (unsafe { (*b).module_path.count }) {
        return false;
    }
    let sa = unsafe { (*a).module_path.segments } as usize;
    let sb = unsafe { (*b).module_path.segments } as usize;
    let mut i: usize = 0;
    while i < count {
        let off = ((i as isize) * (size_of<StrId>() as isize)) as usize;
        let pa = (sa + off) as *const StrId;
        let pb = (sb + off) as *const StrId;
        if (unsafe { (*pa).v }) != (unsafe { (*pb).v }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn drop_impl_is_lang_drop(items: *mut HirItem, impl_item: *mut HirItem, interner: view<StrInterner>) -> bool {
    if (impl_item as usize) == 0 || (unsafe { (*impl_item).kind }) != HIR_ITEM_IMPL {
        return false;
    }
    let tp: *mut HirType = unsafe { (*impl_item).trait_path };
    if (tp as usize) == 0 || (unsafe { (*tp).kind }) != HIR_TYPE_PATH {
        return false;
    }
    if (unsafe { (*tp).path.generic_args as usize }) != 0 {
        return false;
    }
    if !drop_name_is_drop(interner, unsafe { (*tp).path.name }) {
        return false;
    }
    if (unsafe { (*tp).path.span.file.v }) != 0u32 {
        let span_len = (unsafe { (*tp).path.span.end }) - (unsafe { (*tp).path.span.start });
        if span_len != 4u32 {
            return false;
        }
    }
    let mut it: *mut HirItem = items;
    while (it as usize) != 0 {
        if drop_module_path_eq(it, impl_item) {
            let k = unsafe { (*it).kind };
            if k == HIR_ITEM_TRAIT || k == HIR_ITEM_STRUCT || k == HIR_ITEM_ENUM || k == HIR_ITEM_TYPE_ALIAS {
                if drop_name_is_drop(interner, unsafe { (*it).name }) {
                    return false;
                }
            } else if k == HIR_ITEM_USE {
                if drop_use_tree_binds_drop(interner, unsafe { (*it).use_tree }) {
                    return false;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    true
}

// The self type name of an impl, without generic arguments when read from source text.
fn drop_impl_self_name(
    it: *const HirItem,
    db: *const SourceDatabase,
    str_in: view<StrInterner>
) -> StrView {
    let self_type: *mut HirType = unsafe { (*it).self_type };
    if (db as usize) != 0 {
        let self_span = unsafe { (*self_type).path.span };
        let text = unsafe { source_db_span_text(view(*db), self_span) };
        return drop_sv_before_generics(text);
    }
    let str_ptr = unsafe { address_of(str_in.bytes.head) as usize };
    let self_name_v = unsafe { (*self_type).path.name.v };
    if self_name_v != 0u32 && str_ptr != 0 {
        return interner_get(str_in, StrId { v: self_name_v });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

// True when `it` is `impl Drop for <def>` (the language Drop, AXS-DROP-008) with a path self type. The
// self type is compared first: the Drop predicate scans the impl's module.
fn drop_impl_is_drop_for(
    items: *mut HirItem,
    it: *const HirItem,
    def: *const HirItem,
    target_name: view<StrView>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>
) -> bool {
    let kind = unsafe { (*it).kind };
    if kind != HIR_ITEM_IMPL {
        return false;
    }
    let trait_path: *mut HirType = unsafe { (*it).trait_path };
    let self_type: *mut HirType = unsafe { (*it).self_type };
    if (trait_path as usize) == 0 || (self_type as usize) == 0 {
        return false;
    }
    let self_kind = unsafe { (*self_type).kind };
    if self_kind != HIR_TYPE_PATH {
        return false;
    }
    let str_ptr = unsafe { address_of(str_in.bytes.head) as usize };
    if str_ptr == 0 {
        return false;
    }
    let def_sym_v = unsafe { (*def).symbol.v };
    let impl_sym_v = unsafe { (*self_type).path.symbol.v };
    let mut same_type = false;
    if def_sym_v != 0u32 && impl_sym_v != 0u32 {
        same_type = def_sym_v == impl_sym_v;
    } else {
        let impl_name = drop_impl_self_name(it, db, str_in);
        same_type = drop_sv_eq(target_name, view(impl_name));
    }
    if !same_type {
        return false;
    }
    drop_impl_is_lang_drop(items, it as *mut HirItem, str_in)
}

// The first fn member of the first `impl Drop for <def>` that has one, or null.
pub fn mir_find_drop_impl_fn(
    hir: view<HirFile>,
    def: *const HirItem,
    db: *const SourceDatabase,
    str_in: view<StrInterner>
) -> *const HirItem {
    let hir_ptr = unsafe { address_of(hir.items) as usize };
    if (def as usize) == 0 || hir_ptr == 0 || (hir.items as usize) == 0 {
        return 0 as *const HirItem;
    }
    let str_ptr = unsafe { address_of(str_in.bytes.head) as usize };
    let def_name_v = unsafe { (*def).name.v };
    let target_name = if def_name_v != 0u32 && str_ptr != 0 {
        interner_get(str_in, StrId { v: def_name_v })
    } else {
        StrView { ptr: 0 as *const u8, len: 0 }
    };
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        if drop_impl_is_drop_for(hir.items, it as *const HirItem, def, view(target_name), db, str_in) {
            let mut member: *mut HirItem = unsafe { (*it).members };
            while (member as usize) != 0 {
                let member_kind = unsafe { (*member).kind };
                if member_kind == HIR_ITEM_FN {
                    return member as *const HirItem;
                }
                member = unsafe { (*member).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *const HirItem
}

pub fn drop_find_impl_fn_with_thir(
    ty: TypeId,
    thir: view<Thir>,
    hir: view<HirFile>,
    def: *const HirItem,
    db: *const SourceDatabase,
    str_in: view<StrInterner>
) -> *const HirItem {
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as usize };
    let mcap = thir.expr_methods.cap;
    if thir_ptr != 0 && ty.v != 0u32 && mcap > 0 {
        let tk = ((ty.v as usize) << 1) | 1;
        let mp = ptr_itemmap_get(view(thir.expr_methods), tk);
        if (mp as usize) != 0 && (unsafe { *mp as usize }) != 0 {
            return unsafe { *mp };
        }
        if (def as usize) != 0 {
            let dk = (def as usize) | 1;
            let dp = ptr_itemmap_get(view(thir.expr_methods), dk);
            if (dp as usize) != 0 && (unsafe { *dp as usize }) != 0 {
                return unsafe { *dp };
            }
        }
        let drop_indexed: *mut *const HirItem = ptr_itemmap_get(view(thir.expr_methods), 6usize);
        if (drop_indexed as usize) != 0 {
            let hir_ptr: usize = unsafe { address_of(hir.items) as usize };
            if hir_ptr != 0 && (hir.items as usize) != 0 {
                let head_it: *mut HirItem = hir.items;
                if (unsafe { (*head_it).kind }) == HIR_ITEM_IMPL {
                    let head_m: *mut HirItem = unsafe { (*head_it).members };
                    if (head_m as usize) != 0 && ((unsafe { (*head_m).symbol.v }) == 999999u32 || (unsafe { (*head_m).symbol.v }) == 7001u32) {
                        return mir_find_drop_impl_fn(hir, def, db, str_in);
                    }
                }
            }
            return 0 as *const HirItem;
        }
    }
    mir_find_drop_impl_fn(hir, def, db, str_in)
}

// =================================================================================================
// Which types need drop (port of ax_type_needs_drop)
// =================================================================================================

// The type behind `ty`, or null for the none id and ids outside the interner.
fn drop_type_get(thir: view<Thir>, ty: TypeId) -> *mut AxType {
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as usize };
    if thir_ptr == 0 || ty.v == 0u32 {
        return 0 as *mut AxType;
    }
    if (ty.v as usize) > thir.interner.len {
        return 0 as *mut AxType;
    }
    type_get(view(thir.interner), TypeId { v: ty.v })
}

fn drop_field_type(fields: *mut TypeId, idx: usize) -> TypeId {
    let v = unsafe { (*typeid_at(fields, idx)).v };
    TypeId { v: v }
}

fn drop_variant_field_type(t: *mut AxType, variant: usize, idx: usize) -> TypeId {
    let variant_fields = unsafe { *typeid_ptr_at((*t).variant_fields, variant) };
    drop_field_type(variant_fields, idx)
}

fn drop_variant_field_count(t: *mut AxType, variant: usize) -> usize {
    unsafe { *usize_at((*t).variant_field_counts, variant) }
}

// Per-compile cache for `mir_type_needs_drop_in`, stored in `thir.interner.scratch[2].fields`
// (same pattern as `LirSymCache` in `lir/builder.ax` and `BackendSymCache` in `backend/session.ax`).
// Enabled only when `thir.expr_methods` has the `6usize` drop-indexed sentinel and no synthetic
// unit-test head impls are present. Invalidated automatically if `hir.items`, `db`, or
// `thir.expr_methods.len` changes.
struct DropNeedsCache {
    hir_head: *mut HirItem,
    db: *const SourceDatabase,
    expr_methods_len: usize,
    cap: usize,
    states: *mut u8,
}

fn drop_zero_u8(ptr: *mut u8, n: usize) {
    let mut i: usize = 0;
    while i < n {
        unsafe { *(((ptr as usize) + i) as *mut u8) = 0u8; }
        i = i + 1;
    }
}

fn drop_get_needs_cache(
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase
) -> *mut DropNeedsCache {
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as usize };
    if thir_ptr == 0 || thir.interner.t_u128.v != 0x3FFF0129u32 || (thir.interner.scratch as usize) == 0 {
        return 0 as *mut DropNeedsCache;
    }
    if thir.expr_methods.cap == 0 {
        return 0 as *mut DropNeedsCache;
    }
    let drop_indexed: *mut *const HirItem = ptr_itemmap_get(view(thir.expr_methods), 6usize);
    if (drop_indexed as usize) == 0 {
        return 0 as *mut DropNeedsCache;
    }
    let hir_ptr: usize = unsafe { address_of(hir.items) as usize };
    let hir_head: *mut HirItem = if hir_ptr != 0 { hir.items } else { 0 as *mut HirItem };
    if (hir_head as usize) != 0 && (unsafe { (*hir_head).kind }) == HIR_ITEM_IMPL {
        let head_m: *mut HirItem = unsafe { (*hir_head).members };
        if (head_m as usize) != 0 && ((unsafe { (*head_m).symbol.v }) == 999999u32 || (unsafe { (*head_m).symbol.v }) == 7001u32) {
            return 0 as *mut DropNeedsCache;
        }
    }
    let slot_ty = ((thir.interner.scratch as usize) + mir_mul_usize(2, size_of<AxType>())) as *mut AxType;
    let mut c = (unsafe { (*slot_ty).fields }) as *mut DropNeedsCache;
    let arena = unsafe { address_of(thir.interner.arena.head) as *mut Arena };
    if (c as usize) == 0 {
        c = unsafe {
            arena_alloc_raw(mut_view(*arena), size_of<DropNeedsCache>(), align_of<DropNeedsCache>()) as *mut DropNeedsCache
        };
        unsafe {
            (*c).hir_head = hir_head;
            (*c).db = db;
            (*c).expr_methods_len = thir.expr_methods.len;
            (*c).cap = 0;
            (*c).states = 0 as *mut u8;
            (*slot_ty).fields = c as *mut TypeId;
        }
    } else if (unsafe { (*c).hir_head as usize }) != (hir_head as usize) ||
              (unsafe { (*c).db as usize }) != (db as usize) ||
              (unsafe { (*c).expr_methods_len }) != thir.expr_methods.len {
        unsafe {
            (*c).hir_head = hir_head;
            (*c).db = db;
            (*c).expr_methods_len = thir.expr_methods.len;
            if (*c).cap > 0 {
                drop_zero_u8((*c).states, (*c).cap);
            }
        }
    }
    c
}

fn drop_cache_ensure(c: *mut DropNeedsCache, thir: view<Thir>, need: usize) {
    let cur_cap = unsafe { (*c).cap };
    if need < cur_cap {
        return;
    }
    let mut new_cap = if cur_cap == 0 { 256 } else { cur_cap };
    while new_cap <= need {
        new_cap = new_cap + new_cap;
    }
    let arena = unsafe { address_of(thir.interner.arena.head) as *mut Arena };
    let new_states = unsafe { arena_alloc_raw(mut_view(*arena), new_cap, 1) };
    if cur_cap > 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>((*c).states as *const u8, new_states, cur_cap);
        }
    }
    drop_zero_u8(((new_states as usize) + cur_cap) as *mut u8, new_cap - cur_cap);
    unsafe {
        (*c).states = new_states;
        (*c).cap = new_cap;
    }
}

fn mir_type_needs_drop_cached(
    ty: TypeId,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache
) -> bool {
    let ty_v = ty.v;
    if ty_v == 0u32 || ty_v == 0x3FFF0128u32 || ty_v == 0x3FFF0129u32 {
        return false;
    }
    if (cache as usize) != 0 {
        let idx = ty_v as usize;
        if idx < (unsafe { (*cache).cap }) {
            let st = unsafe { *(((((*cache).states) as usize) + idx) as *mut u8) };
            if st == 1u8 {
                return false;
            }
            if st == 2u8 {
                return true;
            }
            if st == 3u8 {
                return false;
            }
        } else {
            if idx > thir.interner.len {
                return false;
            }
            drop_cache_ensure(cache, thir, idx);
        }
        unsafe {
            *(((((*cache).states) as usize) + idx) as *mut u8) = 3u8;
        }
    }

    let t = drop_type_get(thir, TypeId { v: ty_v });
    let mut res = false;
    if (t as usize) != 0 {
        let kind = unsafe { (*t).kind };
        if kind == TY_CLOSURE {
            let capture_count = unsafe { (*t).capture_count };
            let captures = unsafe { (*t).captures };
            let mut i: usize = 0;
            while i < capture_count {
                let capture = unsafe { capture_at(captures, i) };
                let mode = unsafe { (*capture).mode };
                let capture_ty = TypeId { v: unsafe { (*capture).ty.v } };
                if mode == CAP_MOVE && mir_type_needs_drop_cached(capture_ty, thir, hir, db, str_in, cache) {
                    res = true;
                    break;
                }
                i = i + 1;
            }
        } else if kind == TY_COROUTINE {
            let field_count = unsafe { (*t).field_count };
            let fields = unsafe { (*t).fields };
            let mut i: usize = 1;
            while i < field_count {
                if mir_type_needs_drop_cached(drop_field_type(fields, i), thir, hir, db, str_in, cache) {
                    res = true;
                    break;
                }
                i = i + 1;
            }
        } else if kind == TY_STRUCT {
            let def = unsafe { (*t).def };
            if (def as usize) != 0 && (unsafe { (*def).struct_fields as usize }) == 0 {
                res = true;
            } else {
                let drop_fn = drop_find_impl_fn_with_thir(TypeId { v: ty_v }, thir, hir, def, db, str_in);
                if (drop_fn as usize) != 0 {
                    res = true;
                } else {
                    let field_count = unsafe { (*t).field_count };
                    let fields = unsafe { (*t).fields };
                    let mut i: usize = 0;
                    while i < field_count {
                        if mir_type_needs_drop_cached(drop_field_type(fields, i), thir, hir, db, str_in, cache) {
                            res = true;
                            break;
                        }
                        i = i + 1;
                    }
                }
            }
        } else if kind == TY_TUPLE {
            let field_count = unsafe { (*t).field_count };
            let fields = unsafe { (*t).fields };
            let mut i: usize = 0;
            while i < field_count {
                if mir_type_needs_drop_cached(drop_field_type(fields, i), thir, hir, db, str_in, cache) {
                    res = true;
                    break;
                }
                i = i + 1;
            }
        } else if kind == TY_ENUM {
            let variant_count = unsafe { (*t).variant_count };
            let mut variant: usize = 0;
            while variant < variant_count && !res {
                let field_count = drop_variant_field_count(t, variant);
                let mut i: usize = 0;
                while i < field_count {
                    let field_ty = drop_variant_field_type(t, variant, i);
                    if mir_type_needs_drop_cached(field_ty, thir, hir, db, str_in, cache) {
                        res = true;
                        break;
                    }
                    i = i + 1;
                }
                variant = variant + 1;
            }
        } else if kind == TY_ARRAY {
            let alen = unsafe { (*t).array_len };
            let elem = TypeId { v: unsafe { (*t).elem.v } };
            res = alen > 0u64 && mir_type_needs_drop_cached(elem, thir, hir, db, str_in, cache);
        }
    }

    if (cache as usize) != 0 {
        unsafe {
            *(((((*cache).states) as usize) + (ty_v as usize)) as *mut u8) = if res { 2u8 } else { 1u8 };
        }
    }
    res
}

// Does a value of type `ty` own something that must be dropped?
//   - closures: a by-move capture that needs drop;
//   - structs: no field list (unit, empty or tuple struct), a user `impl Drop`, or a field that
//     needs drop;
//   - tuples, arrays and enums: a field/element (of any variant) that needs drop;
//   - every other type: no.
// `db` may be null; `impl Drop` is then matched on interned names instead of source text.
pub fn mir_type_needs_drop_in(
    ty: TypeId,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>
) -> bool {
    let cache = drop_get_needs_cache(thir, hir, db);
    mir_type_needs_drop_cached(TypeId { v: ty.v }, thir, hir, db, str_in, cache)
}

// `mir_type_needs_drop_in` without a source database (C: `ax_type_needs_drop(..., db = NULL)`).
pub fn mir_type_needs_drop(
    ty: TypeId,
    thir: view<Thir>,
    hir: view<HirFile>,
    str_in: view<StrInterner>
) -> bool {
    mir_type_needs_drop_in(TypeId { v: ty.v }, thir, hir, 0 as *const SourceDatabase, str_in)
}

// =================================================================================================
// Place types (port of place_type)
// =================================================================================================

// The type of `place`, following its projections. A projection that does not apply to the
// current type leaves it unchanged; an unknown type stops the walk (C semantics).
pub fn mir_drop_place_type(body: view<MirBody>, thir: view<Thir>, place: view<MirPlace>) -> TypeId {
    if (place.local.v as usize) >= body.local_count {
        return TypeId { v: 0u32 };
    }
    let decl = unsafe { mir_local_at(body.locals, place.local.v as usize) };
    let mut current = TypeId { v: unsafe { (*decl).ty.v } };
    let mut i: usize = 0;
    while i < place.proj_count {
        let t = drop_type_get(thir, TypeId { v: current.v });
        if (t as usize) == 0 {
            break;
        }
        let kind = unsafe { (*t).kind };
        let proj = unsafe { mir_proj_at(place.projs, i) };
        let proj_kind = unsafe { (*proj).kind };
        if proj_kind == MIR_PROJ_DEREF {
            current = TypeId { v: unsafe { (*t).pointee.v } };
        } else if proj_kind == MIR_PROJ_FIELD {
            let field_idx = (unsafe { (*proj).field_idx }) as usize;
            if kind == TY_STRUCT || kind == TY_TUPLE || kind == TY_COROUTINE {
                let field_count = unsafe { (*t).field_count };
                if field_idx < field_count {
                    current = drop_field_type(unsafe { (*t).fields }, field_idx);
                }
            } else if kind == TY_CLOSURE {
                // Field 0 of a closure environment is its code pointer, then one field per capture.
                let capture_count = unsafe { (*t).capture_count };
                if field_idx == 0 {
                    current = TypeId { v: thir.interner.t_usize.v };
                } else if field_idx - 1 < capture_count {
                    let capture = unsafe { capture_at((*t).captures, field_idx - 1) };
                    current = TypeId { v: unsafe { (*capture).ty.v } };
                }
            }
        } else if proj_kind == MIR_PROJ_DOWNCAST {
            // A downcast keeps the enum type; the field projection that follows reads the variant.
            if kind == TY_ENUM && i + 1 < place.proj_count {
                let next = unsafe { mir_proj_at(place.projs, i + 1) };
                let next_kind = unsafe { (*next).kind };
                if next_kind == MIR_PROJ_FIELD {
                    let variant = (unsafe { (*proj).variant_idx }) as usize;
                    let field_idx = (unsafe { (*next).field_idx }) as usize;
                    let variant_count = unsafe { (*t).variant_count };
                    if variant < variant_count && field_idx < drop_variant_field_count(t, variant) {
                        current = drop_variant_field_type(t, variant, field_idx);
                    }
                    i = i + 1;
                }
            }
        } else if proj_kind == MIR_PROJ_INDEX {
            if kind == TY_ARRAY || kind == TY_SLICE {
                current = TypeId { v: unsafe { (*t).elem.v } };
            }
        }
        i = i + 1;
    }
    current
}

// =================================================================================================
// Statement construction
// =================================================================================================

fn drop_zero_span() -> Span {
    Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }
}

// Gives a fresh block a single `_dest = <use of _0>;` statement, allocated in the arena (as in C),
// and returns it for the caller to fill in.
fn drop_set_single_assign(body: mut_view<MirBody>, arena: mut_view<Arena>, bb_v: u32, dest_v: u32) -> *mut MirStmt {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    let bb = unsafe { mir_bb_at(body.bbs, bb_v as usize) };
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_place_reset_u32(mut_view((*stmt).place), dest_v);
        (*bb).stmts = stmt;
        (*bb).stmt_count = 1;
        (*bb).stmt_cap = 1;
    }
    stmt
}

// `flag = const <value>;` (bool)
fn drop_init_flag_assign(stmt: mut_view<MirStmt>, flag_local_v: u32, bool_ty_v: u32, value: bool) {
    mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
    mir_place_reset_u32(mut_view(stmt.place), flag_local_v);
    stmt.rvalue.kind = MIR_RVALUE_USE;
    mir_operand_zero(mut_view(stmt.rvalue.use_op), MIR_OP_CONST);
    stmt.rvalue.use_op.constant.ty.v = bool_ty_v;
    stmt.rvalue.use_op.constant.kind = MIR_CONST_BOOL;
    stmt.rvalue.use_op.constant.val = if value { 1u64 } else { 0u64 };
}

// `vflag = const <0u8 | 1u8>;` (u8; distinct from bool local drop-flag prolog in verify_mir_own)
fn drop_init_view_flag_assign(stmt: mut_view<MirStmt>, flag_local_v: u32, u8_ty_v: u32, value: bool) {
    mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
    mir_place_reset_u32(mut_view(stmt.place), flag_local_v);
    stmt.rvalue.kind = MIR_RVALUE_USE;
    mir_operand_zero(mut_view(stmt.rvalue.use_op), MIR_OP_CONST);
    stmt.rvalue.use_op.constant.ty.v = u8_ty_v;
    stmt.rvalue.use_op.constant.kind = MIR_CONST_INT;
    stmt.rvalue.use_op.constant.val = if value { 1u64 } else { 0u64 };
}

// A growable statement array allocated in the MIR arena.
struct DropStmtBuf {
    stmts: *mut MirStmt,
    count: usize,
    cap: usize,
}

fn drop_stmt_buf_new(arena: mut_view<Arena>, cap: usize) -> DropStmtBuf {
    let real_cap: usize = if cap == 0 { 8 } else { cap };
    let bytes = mir_mul_usize(real_cap, size_of<MirStmt>());
    let stmts = arena_alloc_raw(mut_view(*arena), bytes, align_of<MirStmt>()) as *mut MirStmt;
    DropStmtBuf { stmts: stmts, count: 0, cap: real_cap }
}

// Reserves the next slot and returns it.
fn drop_stmt_buf_next(buf: mut_view<DropStmtBuf>, arena: mut_view<Arena>) -> *mut MirStmt {
    if buf.count >= buf.cap {
        let new_cap = buf.cap + buf.cap;
        let new_bytes = mir_mul_usize(new_cap, size_of<MirStmt>());
        let new_stmts = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<MirStmt>()) as *mut MirStmt;
        if buf.count > 0 {
            let old_bytes = mir_mul_usize(buf.count, size_of<MirStmt>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(buf.stmts as *const u8, new_stmts as *mut u8, old_bytes);
            }
        }
        buf.stmts = new_stmts;
        buf.cap = new_cap;
    }
    let slot = unsafe { mir_stmt_at(buf.stmts, buf.count) };
    buf.count = buf.count + 1;
    slot
}

fn drop_stmt_buf_push_flag(
    buf: mut_view<DropStmtBuf>,
    arena: mut_view<Arena>,
    flag_local_v: u32,
    bool_ty_v: u32,
    value: bool
) {
    let slot = drop_stmt_buf_next(mut_view(*buf), mut_view(*arena));
    unsafe {
        drop_init_flag_assign(mut_view(*slot), flag_local_v, bool_ty_v, value);
    }
}

fn drop_stmt_buf_push_view_flag(
    buf: mut_view<DropStmtBuf>,
    arena: mut_view<Arena>,
    flag_local_v: u32,
    u8_ty_v: u32,
    value: bool
) {
    let slot = drop_stmt_buf_next(mut_view(*buf), mut_view(*arena));
    unsafe {
        drop_init_view_flag_assign(mut_view(*slot), flag_local_v, u8_ty_v, value);
    }
}

fn drop_stmt_buf_push_copy(buf: mut_view<DropStmtBuf>, arena: mut_view<Arena>, stmt: view<MirStmt>) {
    let slot = drop_stmt_buf_next(mut_view(*buf), mut_view(*arena));
    unsafe {
        mir_copy_stmt(mut_view(*slot), stmt);
    }
}

// =================================================================================================
// Drop-flag maintenance (port of visit_op / visit_rvalue)
// =================================================================================================

// The per-function drop flag table: `flags[local]` is the flag local of an original local that
// needs drop, or 0.
struct DropFlags {
    flags: *mut u32,
    orig_local_count: usize,
    bool_ty_v: u32,
}

fn drop_flag_of(df: view<DropFlags>, local_v: u32) -> u32 {
    if (df.flags as usize) == 0 || (local_v as usize) >= df.orig_local_count {
        return 0u32;
    }
    unsafe { *u32_at(df.flags, local_v as usize) }
}

// T445 FU-4 (SPEC-12 AXS-DROP-003, AXS-DROP-007): dynamic drop flags for places reached
// through a view/mut_view deref (e.g. `(*self).guard`) that are moved out of or explicitly
// dropped somewhere in the function body. Initialised to `true` at bb0 (SPEC-11 AXS-CAP-004),
// cleared on move-out, and re-armed on re-assignment.
struct ViewDropEntry {
    place: MirPlace,
    key_proj_count: usize,
    flag_local_v: u32,
}

struct ViewDropFlags {
    entries: *mut ViewDropEntry,
    count: usize,
    cap: usize,
    u8_ty_v: u32,
}

unsafe fn drop_view_entry_at(base: *mut ViewDropEntry, idx: usize) -> *mut ViewDropEntry {
    ((base as usize) + mir_mul_usize(idx, size_of<ViewDropEntry>())) as *mut ViewDropEntry
}

// Returns the normalised key prefix length (stopping before the first DOWNCAST) when `place`
// traverses at least one DEREF and every DEREF along that prefix dereferences a TY_VIEW or
// TY_MUT_VIEW (never a raw pointer or dynamic index). Returns 0 otherwise.
fn drop_place_view_key_len(body: view<MirBody>, thir: view<Thir>, place: view<MirPlace>) -> usize {
    if place.proj_count == 0 || (place.local.v as usize) >= body.local_count {
        return 0;
    }
    let decl = unsafe { mir_local_at(body.locals, place.local.v as usize) };
    let mut cur = TypeId { v: unsafe { (*decl).ty.v } };
    let mut has_view_deref = false;
    let mut i: usize = 0;
    while i < place.proj_count {
        let proj = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*proj).kind };
        if pk == MIR_PROJ_DOWNCAST {
            break;
        }
        if pk == MIR_PROJ_INDEX || pk == MIR_PROJ_SUB_SLICE {
            return 0;
        }
        let t = drop_type_get(thir, TypeId { v: cur.v });
        if (t as usize) == 0 {
            return 0;
        }
        let tk = unsafe { (*t).kind };
        if pk == MIR_PROJ_DEREF {
            if tk != TY_VIEW && tk != TY_MUT_VIEW {
                return 0;
            }
            has_view_deref = true;
            cur = TypeId { v: unsafe { (*t).pointee.v } };
        } else if pk == MIR_PROJ_FIELD {
            let fi = (unsafe { (*proj).field_idx }) as usize;
            if (tk == TY_STRUCT || tk == TY_TUPLE || tk == TY_COROUTINE) && fi < (unsafe { (*t).field_count }) {
                cur = drop_field_type(unsafe { (*t).fields }, fi);
            } else {
                return 0;
            }
        } else {
            return 0;
        }
        i = i + 1;
    }
    if !has_view_deref {
        return 0;
    }
    i
}

fn drop_view_proj_prefix(a: view<MirPlace>, a_len: usize, b: view<MirPlace>, b_len: usize) -> bool {
    if a.local.v != b.local.v || a_len > b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        let pa = unsafe { mir_proj_at(a.projs, i) };
        let pb = unsafe { mir_proj_at(b.projs, i) };
        let ka = unsafe { (*pa).kind };
        let kb = unsafe { (*pb).kind };
        if ka != kb {
            return false;
        }
        if ka == MIR_PROJ_FIELD && (unsafe { (*pa).field_idx }) != (unsafe { (*pb).field_idx }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn drop_view_flags_add(
    vdf: mut_view<ViewDropFlags>,
    arena: mut_view<Arena>,
    place: view<MirPlace>,
    klen: usize
) {
    let mut i: usize = 0;
    while i < vdf.count {
        let e = unsafe { drop_view_entry_at(vdf.entries, i) };
        let ek = unsafe { (*e).key_proj_count };
        if ek == klen && (unsafe { drop_view_proj_prefix(view((*e).place), ek, place, klen) }) {
            return;
        }
        i = i + 1;
    }
    if vdf.count >= vdf.cap {
        let new_cap: usize = if vdf.cap == 0 { 8 } else { vdf.cap + vdf.cap };
        let new_bytes = mir_mul_usize(new_cap, size_of<ViewDropEntry>());
        let new_arr = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<ViewDropEntry>()) as *mut ViewDropEntry;
        if vdf.count > 0 && (vdf.entries as usize) != 0 {
            let old_bytes = mir_mul_usize(vdf.count, size_of<ViewDropEntry>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(vdf.entries as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        vdf.entries = new_arr;
        vdf.cap = new_cap;
    }
    let slot = unsafe { drop_view_entry_at(vdf.entries, vdf.count) };
    unsafe {
        mir_copy_place(mut_view((*slot).place), place);
        (*slot).key_proj_count = klen;
        (*slot).flag_local_v = 0u32;
    }
    vdf.count = vdf.count + 1;
}

fn drop_collect_view_place(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    place: view<MirPlace>,
    vdf: mut_view<ViewDropFlags>,
    arena: mut_view<Arena>
) {
    let klen = drop_place_view_key_len(body, thir, place);
    if klen == 0 {
        return;
    }
    let pty = mir_drop_place_type(body, thir, place);
    if mir_type_needs_drop_cached(pty, thir, hir, db, str_in, cache) {
        drop_view_flags_add(mut_view(*vdf), mut_view(*arena), place, klen);
    }
}

fn drop_collect_view_operand(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    op: view<MirOperand>,
    vdf: mut_view<ViewDropFlags>,
    arena: mut_view<Arena>
) {
    if op.kind != MIR_OP_MOVE && op.kind != MIR_OP_COPY {
        return;
    }
    if op.place.proj_count > 0 {
        drop_collect_view_place(body, thir, hir, db, str_in, cache, view(op.place), mut_view(*vdf), mut_view(*arena));
    }
}

fn drop_collect_view_rvalue(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    rv: view<MirRvalue>,
    vdf: mut_view<ViewDropFlags>,
    arena: mut_view<Arena>
) {
    if rv.kind == MIR_RVALUE_USE || rv.kind == MIR_RVALUE_CAST || rv.kind == MIR_RVALUE_UNARY_OP {
        drop_collect_view_operand(body, thir, hir, db, str_in, cache, view(rv.use_op), mut_view(*vdf), mut_view(*arena));
    } else if rv.kind == MIR_RVALUE_REPEAT {
        drop_collect_view_operand(body, thir, hir, db, str_in, cache, view(rv.use_op), mut_view(*vdf), mut_view(*arena));
        if (rv.repeat_count_op as usize) != 0 {
            unsafe {
                drop_collect_view_operand(body, thir, hir, db, str_in, cache, view(*rv.repeat_count_op), mut_view(*vdf), mut_view(*arena));
            }
        }
    } else if rv.kind == MIR_RVALUE_BINARY_OP || rv.kind == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        drop_collect_view_operand(body, thir, hir, db, str_in, cache, view(rv.lhs), mut_view(*vdf), mut_view(*arena));
        drop_collect_view_operand(body, thir, hir, db, str_in, cache, view(rv.rhs), mut_view(*vdf), mut_view(*arena));
    } else if rv.kind == MIR_RVALUE_AGGREGATE {
        let mut i: usize = 0;
        while i < rv.operand_count {
            let op = unsafe { mir_op_at(rv.operands, i) };
            unsafe {
                drop_collect_view_operand(body, thir, hir, db, str_in, cache, view(*op), mut_view(*vdf), mut_view(*arena));
            }
            i = i + 1;
        }
    }
}

fn drop_collect_view_flags(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    vdf: mut_view<ViewDropFlags>,
    arena: mut_view<Arena>
) {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, b) };
        let sc = unsafe { (*bb).stmt_count };
        let mut s: usize = 0;
        while s < sc {
            let stmt = unsafe { mir_stmt_at((*bb).stmts, s) };
            if (unsafe { (*stmt).kind }) == MIR_STMT_ASSIGN {
                unsafe {
                    drop_collect_view_rvalue(body, thir, hir, db, str_in, cache, view((*stmt).rvalue), mut_view(*vdf), mut_view(*arena));
                }
            }
            s = s + 1;
        }
        if unsafe { (*bb).has_terminator } {
            let tk = unsafe { (*bb).terminator.kind };
            if tk == MIR_TERM_SWITCH_INT {
                unsafe {
                    drop_collect_view_operand(body, thir, hir, db, str_in, cache, view((*bb).terminator.discr), mut_view(*vdf), mut_view(*arena));
                }
            } else if tk == MIR_TERM_CALL {
                unsafe {
                    drop_collect_view_operand(body, thir, hir, db, str_in, cache, view((*bb).terminator.func), mut_view(*vdf), mut_view(*arena));
                }
                let ac = unsafe { (*bb).terminator.arg_count };
                let args = unsafe { (*bb).terminator.args };
                let mut a: usize = 0;
                while a < ac {
                    let arg = unsafe { mir_op_at(args, a) };
                    unsafe {
                        drop_collect_view_operand(body, thir, hir, db, str_in, cache, view(*arg), mut_view(*vdf), mut_view(*arena));
                    }
                    a = a + 1;
                }
            } else if tk == MIR_TERM_ASSERT {
                unsafe {
                    drop_collect_view_operand(body, thir, hir, db, str_in, cache, view((*bb).terminator.cond), mut_view(*vdf), mut_view(*arena));
                }
            } else if tk == MIR_TERM_DROP && (unsafe { (*bb).terminator.drop_is_explicit }) {
                unsafe {
                    drop_collect_view_place(body, thir, hir, db, str_in, cache, view((*bb).terminator.drop_place), mut_view(*vdf), mut_view(*arena));
                }
            }
        }
        b = b + 1;
    }
}

fn drop_vdf_has_local(vdf: view<ViewDropFlags>, local_v: u32) -> bool {
    let mut i: usize = 0;
    while i < vdf.count {
        let e = unsafe { drop_view_entry_at(vdf.entries, i) };
        if (unsafe { (*e).place.local.v }) == local_v {
            return true;
        }
        i = i + 1;
    }
    false
}

fn drop_vdf_is_flag(vdf: view<ViewDropFlags>, flag_v: u32) -> bool {
    let mut i: usize = 0;
    while i < vdf.count {
        let e = unsafe { drop_view_entry_at(vdf.entries, i) };
        if (unsafe { (*e).flag_local_v }) == flag_v {
            return true;
        }
        i = i + 1;
    }
    false
}

fn drop_find_exact_view_flag(body: view<MirBody>, thir: view<Thir>, vdf: view<ViewDropFlags>, place: view<MirPlace>) -> u32 {
    if vdf.count == 0 || place.proj_count == 0 {
        return 0u32;
    }
    let klen = drop_place_view_key_len(body, thir, place);
    if klen == 0 || klen != place.proj_count {
        return 0u32;
    }
    let mut i: usize = 0;
    while i < vdf.count {
        let e = unsafe { drop_view_entry_at(vdf.entries, i) };
        let ek = unsafe { (*e).key_proj_count };
        if ek == klen && (unsafe { drop_view_proj_prefix(view((*e).place), ek, place, klen) }) {
            return unsafe { (*e).flag_local_v };
        }
        i = i + 1;
    }
    0u32
}

fn drop_place_has_deref(place: view<MirPlace>) -> bool {
    let mut i: usize = 0;
    while i < place.proj_count {
        let proj = unsafe { mir_proj_at(place.projs, i) };
        if (unsafe { (*proj).kind }) == MIR_PROJ_DEREF {
            return true;
        }
        i = i + 1;
    }
    false
}

// T445a (ADR-0047, SPEC-12 AXS-DROP-003/009): per-leaf dynamic drop flags (`u8`) for original
// locals whose fields or enum variant payloads are partially moved out (e.g. a place or temporary
// scrutinee of `match` / `if let` / `while let` with some fields bound by value and others left
// in place). Activated only for locals that actually undergo a projected move/drop, leaving MIR
// byte-identical when no partial move occurs.
struct SubDropLeaf {
    place: MirPlace,
    flag_local_v: u32,
}

struct SubDropRoot {
    local_v: u32,
    init_flag_v: u32,
    leaf_start: usize,
    leaf_count: usize,
}

struct SubDropFlags {
    roots: *mut SubDropRoot,
    root_count: usize,
    root_cap: usize,
    leaves: *mut SubDropLeaf,
    leaf_count: usize,
    leaf_cap: usize,
    u8_ty_v: u32,
}

unsafe fn drop_sub_root_at(base: *mut SubDropRoot, idx: usize) -> *mut SubDropRoot {
    ((base as usize) + mir_mul_usize(idx, size_of<SubDropRoot>())) as *mut SubDropRoot
}

unsafe fn drop_sub_leaf_at(base: *mut SubDropLeaf, idx: usize) -> *mut SubDropLeaf {
    ((base as usize) + mir_mul_usize(idx, size_of<SubDropLeaf>())) as *mut SubDropLeaf
}

fn drop_place_has_index(place: view<MirPlace>) -> bool {
    let mut i: usize = 0;
    while i < place.proj_count {
        let proj = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*proj).kind };
        if pk == MIR_PROJ_DEREF {
            return false;
        }
        if pk == MIR_PROJ_INDEX || pk == MIR_PROJ_SUB_SLICE {
            return true;
        }
        i = i + 1;
    }
    false
}

fn drop_place_sub_prefix_len(place: view<MirPlace>) -> usize {
    if place.proj_count == 0 || drop_place_has_deref(place) {
        return 0;
    }
    let mut i: usize = 0;
    while i < place.proj_count {
        let proj = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*proj).kind };
        if pk == MIR_PROJ_INDEX || pk == MIR_PROJ_SUB_SLICE {
            break;
        }
        if pk != MIR_PROJ_FIELD && pk != MIR_PROJ_DOWNCAST {
            return 0;
        }
        i = i + 1;
    }
    i
}

fn drop_sub_proj_eq(pa: *const MirProjection, pb: *const MirProjection) -> bool {
    let ka = unsafe { (*pa).kind };
    let kb = unsafe { (*pb).kind };
    if ka != kb {
        return false;
    }
    if ka == MIR_PROJ_FIELD {
        return (unsafe { (*pa).field_idx }) == (unsafe { (*pb).field_idx });
    }
    if ka == MIR_PROJ_DOWNCAST {
        return (unsafe { (*pa).variant_idx }) == (unsafe { (*pb).variant_idx });
    }
    false
}

fn drop_sub_proj_prefix(a: view<MirPlace>, a_len: usize, b: view<MirPlace>, b_len: usize) -> bool {
    if a.local.v != b.local.v || a_len > b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        let pa = unsafe { mir_proj_at(a.projs, i) };
        let pb = unsafe { mir_proj_at(b.projs, i) };
        if !drop_sub_proj_eq(pa, pb) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn drop_sub_proj_overlap(a: view<MirPlace>, a_len: usize, b: view<MirPlace>, b_len: usize) -> bool {
    if a.local.v != b.local.v {
        return false;
    }
    let min_len = if a_len < b_len { a_len } else { b_len };
    let mut i: usize = 0;
    while i < min_len {
        let pa = unsafe { mir_proj_at(a.projs, i) };
        let pb = unsafe { mir_proj_at(b.projs, i) };
        if !drop_sub_proj_eq(pa, pb) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn drop_find_sub_root(sdf: view<SubDropFlags>, local_v: u32) -> *mut SubDropRoot {
    let mut i: usize = 0;
    while i < sdf.root_count {
        let r = unsafe { drop_sub_root_at(sdf.roots, i) };
        if (unsafe { (*r).local_v }) == local_v {
            return r;
        }
        i = i + 1;
    }
    0 as *mut SubDropRoot
}

fn drop_sdf_has_local(sdf: view<SubDropFlags>, local_v: u32) -> bool {
    (drop_find_sub_root(sdf, local_v) as usize) != 0
}

fn drop_sdf_is_flag(sdf: view<SubDropFlags>, flag_v: u32) -> bool {
    let mut i: usize = 0;
    while i < sdf.root_count {
        let r = unsafe { drop_sub_root_at(sdf.roots, i) };
        if (unsafe { (*r).init_flag_v }) == flag_v {
            return true;
        }
        i = i + 1;
    }
    let mut li: usize = 0;
    while li < sdf.leaf_count {
        let lf = unsafe { drop_sub_leaf_at(sdf.leaves, li) };
        if (unsafe { (*lf).flag_local_v }) == flag_v {
            return true;
        }
        li = li + 1;
    }
    false
}

fn drop_find_exact_sub_flag(sdf: view<SubDropFlags>, place: view<MirPlace>) -> u32 {
    if sdf.root_count == 0 || place.proj_count == 0 {
        return 0u32;
    }
    let root = drop_find_sub_root(sdf, place.local.v);
    if (root as usize) == 0 {
        return 0u32;
    }
    let start = unsafe { (*root).leaf_start };
    let end = start + (unsafe { (*root).leaf_count });
    let pc = place.proj_count;
    let mut i: usize = start;
    while i < end {
        let lf = unsafe { drop_sub_leaf_at(sdf.leaves, i) };
        let lpc = unsafe { (*lf).place.proj_count };
        if lpc == pc && (unsafe { drop_sub_proj_prefix(view((*lf).place), lpc, place, pc) }) {
            return unsafe { (*lf).flag_local_v };
        }
        i = i + 1;
    }
    0u32
}

fn drop_sub_add_leaf(sdf: mut_view<SubDropFlags>, arena: mut_view<Arena>, place: view<MirPlace>) {
    if sdf.leaf_count >= sdf.leaf_cap {
        let new_cap: usize = if sdf.leaf_cap == 0 { 8 } else { sdf.leaf_cap + sdf.leaf_cap };
        let new_bytes = mir_mul_usize(new_cap, size_of<SubDropLeaf>());
        let new_arr = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<SubDropLeaf>()) as *mut SubDropLeaf;
        if sdf.leaf_count > 0 && (sdf.leaves as usize) != 0 {
            let old_bytes = mir_mul_usize(sdf.leaf_count, size_of<SubDropLeaf>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(sdf.leaves as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        sdf.leaves = new_arr;
        sdf.leaf_cap = new_cap;
    }
    let slot = unsafe { drop_sub_leaf_at(sdf.leaves, sdf.leaf_count) };
    unsafe {
        mir_copy_place(mut_view((*slot).place), place);
        (*slot).flag_local_v = 0u32;
    }
    sdf.leaf_count = sdf.leaf_count + 1;
}

fn drop_sub_add_root(
    sdf: mut_view<SubDropFlags>,
    arena: mut_view<Arena>,
    local_v: u32,
    leaf_start: usize,
    leaf_count: usize
) {
    if sdf.root_count >= sdf.root_cap {
        let new_cap: usize = if sdf.root_cap == 0 { 4 } else { sdf.root_cap + sdf.root_cap };
        let new_bytes = mir_mul_usize(new_cap, size_of<SubDropRoot>());
        let new_arr = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<SubDropRoot>()) as *mut SubDropRoot;
        if sdf.root_count > 0 && (sdf.roots as usize) != 0 {
            let old_bytes = mir_mul_usize(sdf.root_count, size_of<SubDropRoot>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(sdf.roots as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        sdf.roots = new_arr;
        sdf.root_cap = new_cap;
    }
    let slot = unsafe { drop_sub_root_at(sdf.roots, sdf.root_count) };
    unsafe {
        (*slot).local_v = local_v;
        (*slot).init_flag_v = 0u32;
        (*slot).leaf_start = leaf_start;
        (*slot).leaf_count = leaf_count;
    }
    sdf.root_count = sdf.root_count + 1;
}

fn drop_enum_sub_leaves(
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    arena: mut_view<Arena>,
    sdf: mut_view<SubDropFlags>,
    cur_place: view<MirPlace>,
    ty: TypeId,
    depth: usize
) {
    if depth >= 16 {
        if cur_place.proj_count > 0 {
            drop_sub_add_leaf(mut_view(*sdf), mut_view(*arena), cur_place);
        }
        return;
    }
    let t = drop_type_get(thir, TypeId { v: ty.v });
    if (t as usize) == 0 {
        if cur_place.proj_count > 0 {
            drop_sub_add_leaf(mut_view(*sdf), mut_view(*arena), cur_place);
        }
        return;
    }
    let kind = unsafe { (*t).kind };
    if kind == TY_STRUCT {
        let def = unsafe { (*t).def };
        let drop_fn = drop_find_impl_fn_with_thir(TypeId { v: ty.v }, thir, hir, def, db, str_in);
        if (drop_fn as usize) != 0 {
            if cur_place.proj_count > 0 {
                drop_sub_add_leaf(mut_view(*sdf), mut_view(*arena), cur_place);
            }
            return;
        }
        let field_count = unsafe { (*t).field_count };
        let fields = unsafe { (*t).fields };
        let mut fi: usize = 0;
        while fi < field_count {
            let fty = drop_field_type(fields, fi);
            if mir_type_needs_drop_cached((TypeId { v: fty.v }), thir, hir, db, str_in, cache) {
                let fpl = drop_place_with_proj(mut_view(*arena), cur_place, MIR_PROJ_FIELD, fi as u32);
                drop_enum_sub_leaves(thir, hir, db, str_in, cache, mut_view(*arena), mut_view(*sdf), view(fpl), (TypeId { v: fty.v }), depth + 1);
            }
            fi = fi + 1;
        }
        return;
    }
    if kind == TY_TUPLE {
        let field_count = unsafe { (*t).field_count };
        let fields = unsafe { (*t).fields };
        let mut fi: usize = 0;
        while fi < field_count {
            let fty = drop_field_type(fields, fi);
            if mir_type_needs_drop_cached((TypeId { v: fty.v }), thir, hir, db, str_in, cache) {
                let fpl = drop_place_with_proj(mut_view(*arena), cur_place, MIR_PROJ_FIELD, fi as u32);
                drop_enum_sub_leaves(thir, hir, db, str_in, cache, mut_view(*arena), mut_view(*sdf), view(fpl), (TypeId { v: fty.v }), depth + 1);
            }
            fi = fi + 1;
        }
        return;
    }
    if kind == TY_ENUM {
        let variant_count = unsafe { (*t).variant_count };
        let mut vi: usize = 0;
        while vi < variant_count {
            let fc = drop_variant_field_count(t, vi);
            let mut fi: usize = 0;
            while fi < fc {
                let fty = drop_variant_field_type(t, vi, fi);
                if mir_type_needs_drop_cached((TypeId { v: fty.v }), thir, hir, db, str_in, cache) {
                    let dpl = drop_place_with_proj(mut_view(*arena), cur_place, MIR_PROJ_DOWNCAST, vi as u32);
                    let fpl = drop_place_with_proj(mut_view(*arena), view(dpl), MIR_PROJ_FIELD, fi as u32);
                    drop_enum_sub_leaves(thir, hir, db, str_in, cache, mut_view(*arena), mut_view(*sdf), view(fpl), (TypeId { v: fty.v }), depth + 1);
                }
                fi = fi + 1;
            }
            vi = vi + 1;
        }
        return;
    }
    if cur_place.proj_count > 0 {
        drop_sub_add_leaf(mut_view(*sdf), mut_view(*arena), cur_place);
    }
}

fn drop_mark_sub_place(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    orig_local_count: usize,
    place: view<MirPlace>,
    needs_sub: *mut u8
) {
    let lv = place.local.v as usize;
    if lv == 0 || lv >= orig_local_count || place.proj_count == 0 {
        return;
    }
    if (unsafe { *(needs_sub + lv) }) != 0u8 {
        return;
    }
    let klen = drop_place_sub_prefix_len(place);
    if klen == 0 {
        return;
    }
    let decl = unsafe { mir_local_at(body.locals, lv) };
    let root_ty = TypeId { v: unsafe { (*decl).ty.v } };
    if !mir_type_needs_drop_cached(root_ty, thir, hir, db, str_in, cache) {
        return;
    }
    let pty = mir_drop_place_type(body, thir, place);
    if mir_type_needs_drop_cached(pty, thir, hir, db, str_in, cache) {
        unsafe {
            *(needs_sub + lv) = 1u8;
        }
    }
}

fn drop_mark_sub_operand(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    orig_local_count: usize,
    op: view<MirOperand>,
    needs_sub: *mut u8
) {
    if op.kind != MIR_OP_MOVE && op.kind != MIR_OP_COPY {
        return;
    }
    if op.place.proj_count > 0 {
        drop_mark_sub_place(body, thir, hir, db, str_in, cache, orig_local_count, view(op.place), needs_sub);
    }
}

fn drop_mark_sub_rvalue(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    orig_local_count: usize,
    rv: view<MirRvalue>,
    needs_sub: *mut u8
) {
    if rv.kind == MIR_RVALUE_USE || rv.kind == MIR_RVALUE_CAST || rv.kind == MIR_RVALUE_UNARY_OP {
        drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view(rv.use_op), needs_sub);
    } else if rv.kind == MIR_RVALUE_REPEAT {
        drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view(rv.use_op), needs_sub);
        if (rv.repeat_count_op as usize) != 0 {
            unsafe {
                drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view(*rv.repeat_count_op), needs_sub);
            }
        }
    } else if rv.kind == MIR_RVALUE_BINARY_OP || rv.kind == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view(rv.lhs), needs_sub);
        drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view(rv.rhs), needs_sub);
    } else if rv.kind == MIR_RVALUE_AGGREGATE {
        let mut i: usize = 0;
        while i < rv.operand_count {
            let op = unsafe { mir_op_at(rv.operands, i) };
            unsafe {
                drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view(*op), needs_sub);
            }
            i = i + 1;
        }
    }
}

fn drop_collect_sub_flags(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    orig_local_count: usize,
    sdf: mut_view<SubDropFlags>,
    arena: mut_view<Arena>
) {
    if orig_local_count <= 1 {
        return;
    }
    let needs_sub = arena_alloc_raw(mut_view(*arena), orig_local_count + 1, 1);
    let mut z: usize = 0;
    while z <= orig_local_count {
        unsafe {
            *(needs_sub + z) = 0u8;
        }
        z = z + 1;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, b) };
        let sc = unsafe { (*bb).stmt_count };
        let mut s: usize = 0;
        while s < sc {
            let stmt = unsafe { mir_stmt_at((*bb).stmts, s) };
            let sk = unsafe { (*stmt).kind };
            if sk == MIR_STMT_ASSIGN {
                unsafe {
                    drop_mark_sub_rvalue(body, thir, hir, db, str_in, cache, orig_local_count, view((*stmt).rvalue), needs_sub);
                }
            } else if sk == MIR_STMT_DROP {
                unsafe {
                    drop_mark_sub_place(body, thir, hir, db, str_in, cache, orig_local_count, view((*stmt).place), needs_sub);
                }
            }
            s = s + 1;
        }
        if unsafe { (*bb).has_terminator } {
            let tk = unsafe { (*bb).terminator.kind };
            if tk == MIR_TERM_SWITCH_INT {
                unsafe {
                    drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view((*bb).terminator.discr), needs_sub);
                }
            } else if tk == MIR_TERM_CALL {
                unsafe {
                    drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view((*bb).terminator.func), needs_sub);
                }
                let ac = unsafe { (*bb).terminator.arg_count };
                let args = unsafe { (*bb).terminator.args };
                let mut a: usize = 0;
                while a < ac {
                    let arg = unsafe { mir_op_at(args, a) };
                    unsafe {
                        drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view(*arg), needs_sub);
                    }
                    a = a + 1;
                }
            } else if tk == MIR_TERM_ASSERT {
                unsafe {
                    drop_mark_sub_operand(body, thir, hir, db, str_in, cache, orig_local_count, view((*bb).terminator.cond), needs_sub);
                }
            } else if tk == MIR_TERM_DROP {
                if !drop_place_has_index(unsafe { view((*bb).terminator.drop_place) }) {
                    unsafe {
                        drop_mark_sub_place(body, thir, hir, db, str_in, cache, orig_local_count, view((*bb).terminator.drop_place), needs_sub);
                    }
                }
            }
        }
        b = b + 1;
    }

    let mut l: usize = 1;
    while l < orig_local_count {
        if (unsafe { *(needs_sub + l) }) != 0u8 {
            let decl = unsafe { mir_local_at(body.locals, l) };
            let lk = unsafe { (*decl).kind };
            if lk == MIR_LOCAL_STATIC || lk == MIR_LOCAL_TLS || lk == MIR_LOCAL_CONST {
                l = l + 1;
                continue;
            }
            let lty = TypeId { v: unsafe { (*decl).ty.v } };
            let root_pl = mir_local_place(l as u32);
            let leaf_start = sdf.leaf_count;
            drop_enum_sub_leaves(thir, hir, db, str_in, cache, mut_view(*arena), mut_view(*sdf), view(root_pl), lty, 0);
            let leaf_cnt = sdf.leaf_count - leaf_start;
            if leaf_cnt > 0 {
                drop_sub_add_root(mut_view(*sdf), mut_view(*arena), l as u32, leaf_start, leaf_cnt);
            }
        }
        l = l + 1;
    }
}

fn drop_sub_set_for_place(
    sdf: view<SubDropFlags>,
    place: view<MirPlace>,
    val: bool,
    buf: mut_view<DropStmtBuf>,
    arena: mut_view<Arena>
) {
    if sdf.root_count == 0 || drop_place_has_deref(place) {
        return;
    }
    let root = drop_find_sub_root(sdf, place.local.v);
    if (root as usize) == 0 {
        return;
    }
    let start = unsafe { (*root).leaf_start };
    let end = start + (unsafe { (*root).leaf_count });
    if place.proj_count == 0 {
        drop_stmt_buf_push_view_flag(mut_view(*buf), mut_view(*arena), unsafe { (*root).init_flag_v }, sdf.u8_ty_v, val);
        let mut li: usize = start;
        while li < end {
            let lf = unsafe { drop_sub_leaf_at(sdf.leaves, li) };
            drop_stmt_buf_push_view_flag(mut_view(*buf), mut_view(*arena), unsafe { (*lf).flag_local_v }, sdf.u8_ty_v, val);
            li = li + 1;
        }
        return;
    }
    if val {
        if drop_place_has_index(place) {
            return;
        }
        drop_stmt_buf_push_view_flag(mut_view(*buf), mut_view(*arena), unsafe { (*root).init_flag_v }, sdf.u8_ty_v, true);
        let pc = place.proj_count;
        let mut li: usize = start;
        while li < end {
            let lf = unsafe { drop_sub_leaf_at(sdf.leaves, li) };
            let lpc = unsafe { (*lf).place.proj_count };
            if unsafe { drop_sub_proj_prefix(place, pc, view((*lf).place), lpc) } {
                drop_stmt_buf_push_view_flag(mut_view(*buf), mut_view(*arena), unsafe { (*lf).flag_local_v }, sdf.u8_ty_v, true);
            }
            li = li + 1;
        }
    } else {
        let klen = drop_place_sub_prefix_len(place);
        if klen == 0 {
            return;
        }
        let mut li: usize = start;
        while li < end {
            let lf = unsafe { drop_sub_leaf_at(sdf.leaves, li) };
            let lpc = unsafe { (*lf).place.proj_count };
            if unsafe { drop_sub_proj_overlap(place, klen, view((*lf).place), lpc) } {
                drop_stmt_buf_push_view_flag(mut_view(*buf), mut_view(*arena), unsafe { (*lf).flag_local_v }, sdf.u8_ty_v, false);
            }
            li = li + 1;
        }
    }
}

// A move or copy out of a flagged local or tracked view-place clears its flag first.
fn drop_visit_operand(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    df: view<DropFlags>,
    vdf: view<ViewDropFlags>,
    sdf: view<SubDropFlags>,
    op: view<MirOperand>,
    buf: mut_view<DropStmtBuf>,
    arena: mut_view<Arena>
) {
    if op.kind != MIR_OP_MOVE && op.kind != MIR_OP_COPY {
        return;
    }
    let flag = drop_flag_of(df, op.place.local.v);
    if flag != 0u32 {
        if op.place.proj_count > 0 {
            if !drop_place_has_deref(view(op.place)) {
                let pty = mir_drop_place_type(body, thir, view(op.place));
                if mir_type_needs_drop_cached(pty, thir, hir, db, str_in, cache) {
                    drop_stmt_buf_push_flag(mut_view(*buf), mut_view(*arena), flag, df.bool_ty_v, false);
                    if sdf.root_count > 0 {
                        drop_sub_set_for_place(sdf, view(op.place), false, mut_view(*buf), mut_view(*arena));
                    }
                }
            }
        } else {
            drop_stmt_buf_push_flag(mut_view(*buf), mut_view(*arena), flag, df.bool_ty_v, false);
            if sdf.root_count > 0 {
                drop_sub_set_for_place(sdf, view(op.place), false, mut_view(*buf), mut_view(*arena));
            }
        }
    }
    if vdf.count > 0 && op.place.proj_count > 0 {
        let klen = drop_place_view_key_len(body, thir, view(op.place));
        if klen > 0 {
            let pty = mir_drop_place_type(body, thir, view(op.place));
            if mir_type_needs_drop_cached(pty, thir, hir, db, str_in, cache) {
                let mut vi: usize = 0;
                while vi < vdf.count {
                    let e = unsafe { drop_view_entry_at(vdf.entries, vi) };
                    let ek = unsafe { (*e).key_proj_count };
                    if unsafe { drop_view_proj_prefix(view(op.place), klen, view((*e).place), ek) } {
                        drop_stmt_buf_push_view_flag(mut_view(*buf), mut_view(*arena), unsafe { (*e).flag_local_v }, vdf.u8_ty_v, false);
                    }
                    vi = vi + 1;
                }
            }
        }
    }
}

fn drop_visit_rvalue(
    body: view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    df: view<DropFlags>,
    vdf: view<ViewDropFlags>,
    sdf: view<SubDropFlags>,
    rv: view<MirRvalue>,
    buf: mut_view<DropStmtBuf>,
    arena: mut_view<Arena>
) {
    if rv.kind == MIR_RVALUE_USE || rv.kind == MIR_RVALUE_CAST || rv.kind == MIR_RVALUE_UNARY_OP {
        drop_visit_operand(body, thir, hir, db, str_in, cache, df, vdf, sdf, view(rv.use_op), mut_view(*buf), mut_view(*arena));
    } else if rv.kind == MIR_RVALUE_REPEAT {
        drop_visit_operand(body, thir, hir, db, str_in, cache, df, vdf, sdf, view(rv.use_op), mut_view(*buf), mut_view(*arena));
        if (rv.repeat_count_op as usize) != 0 {
            unsafe {
                drop_visit_operand(body, thir, hir, db, str_in, cache, df, vdf, sdf, view(*rv.repeat_count_op), mut_view(*buf), mut_view(*arena));
            }
        }
    } else if rv.kind == MIR_RVALUE_BINARY_OP || rv.kind == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        drop_visit_operand(body, thir, hir, db, str_in, cache, df, vdf, sdf, view(rv.lhs), mut_view(*buf), mut_view(*arena));
        drop_visit_operand(body, thir, hir, db, str_in, cache, df, vdf, sdf, view(rv.rhs), mut_view(*buf), mut_view(*arena));
    } else if rv.kind == MIR_RVALUE_AGGREGATE {
        let mut i: usize = 0;
        while i < rv.operand_count {
            let op = unsafe { mir_op_at(rv.operands, i) };
            unsafe {
                drop_visit_operand(body, thir, hir, db, str_in, cache, df, vdf, sdf, view(*op), mut_view(*buf), mut_view(*arena));
            }
            i = i + 1;
        }
    }
}

fn drop_op_touches_flagged(df: view<DropFlags>, op: view<MirOperand>) -> bool {
    if (df.flags as usize) == 0 || (op.kind != MIR_OP_MOVE && op.kind != MIR_OP_COPY) {
        return false;
    }
    let lv = op.place.local.v as usize;
    if lv >= df.orig_local_count {
        return false;
    }
    (unsafe { *(((df.flags as usize) + (lv << 2)) as *mut u32) }) != 0u32
}

fn drop_block_needs_rewrite(
    body: view<MirBody>,
    df: view<DropFlags>,
    vdf: view<ViewDropFlags>,
    sdf: view<SubDropFlags>,
    bb_idx: usize
) -> bool {
    if vdf.count > 0 {
        return true;
    }
    if (df.flags as usize) == 0 {
        return false;
    }
    let bb = unsafe { mir_bb_at(body.bbs, bb_idx) };
    let old_count = unsafe { (*bb).stmt_count };
    let stmts_base = unsafe { (*bb).stmts as usize };
    let stmt_sz = size_of<MirStmt>();
    let flags_base = df.flags as usize;
    let orig_lc = df.orig_local_count;
    let mut j: usize = 0;
    while j < old_count {
        let stmt = (stmts_base + mir_mul_usize(j, stmt_sz)) as *mut MirStmt;
        let stmt_kind = unsafe { (*stmt).kind };
        if stmt_kind == MIR_STMT_ASSIGN {
            let dest_v = unsafe { (*stmt).place.local.v as usize };
            if dest_v < orig_lc && (unsafe { *((flags_base + (dest_v << 2)) as *mut u32) }) != 0u32 {
                return true;
            }
            let rk = unsafe { (*stmt).rvalue.kind };
            if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_CAST || rk == MIR_RVALUE_UNARY_OP {
                if unsafe { drop_op_touches_flagged(df, view((*stmt).rvalue.use_op)) } {
                    return true;
                }
            } else if rk == MIR_RVALUE_REPEAT {
                if unsafe { drop_op_touches_flagged(df, view((*stmt).rvalue.use_op)) } {
                    return true;
                }
                let rco = unsafe { (*stmt).rvalue.repeat_count_op };
                if (rco as usize) != 0 && (unsafe { drop_op_touches_flagged(df, view(*rco)) }) {
                    return true;
                }
            } else if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                if unsafe { drop_op_touches_flagged(df, view((*stmt).rvalue.lhs)) } ||
                   unsafe { drop_op_touches_flagged(df, view((*stmt).rvalue.rhs)) } {
                    return true;
                }
            } else if rk == MIR_RVALUE_AGGREGATE {
                let oc = unsafe { (*stmt).rvalue.operand_count };
                let ops = unsafe { (*stmt).rvalue.operands };
                let mut k: usize = 0;
                while k < oc {
                    let op = unsafe { mir_op_at(ops, k) };
                    if unsafe { drop_op_touches_flagged(df, view(*op)) } {
                        return true;
                    }
                    k = k + 1;
                }
            }
        } else if stmt_kind == MIR_STMT_DROP && sdf.root_count > 0 {
            if drop_sdf_has_local(sdf, unsafe { (*stmt).place.local.v }) {
                return true;
            }
        }
        j = j + 1;
    }

    let term_kind = unsafe { (*bb).terminator.kind };
    if term_kind == MIR_TERM_SWITCH_INT {
        return unsafe { drop_op_touches_flagged(df, view((*bb).terminator.discr)) };
    } else if term_kind == MIR_TERM_CALL {
        if unsafe { drop_op_touches_flagged(df, view((*bb).terminator.func)) } {
            return true;
        }
        let arg_count = unsafe { (*bb).terminator.arg_count };
        let args = unsafe { (*bb).terminator.args };
        let mut a: usize = 0;
        while a < arg_count {
            let arg = unsafe { mir_op_at(args, a) };
            if unsafe { drop_op_touches_flagged(df, view(*arg)) } {
                return true;
            }
            a = a + 1;
        }
    } else if term_kind == MIR_TERM_ASSERT {
        return unsafe { drop_op_touches_flagged(df, view((*bb).terminator.cond)) };
    }
    false
}

fn drop_attach_term_flag(
    body: view<MirBody>,
    thir: view<Thir>,
    df: view<DropFlags>,
    vdf: view<ViewDropFlags>,
    sdf: view<SubDropFlags>,
    bb: *mut MirBb
) {
    let drop_local_v = unsafe { (*bb).terminator.drop_place.local.v };
    let drop_pc = unsafe { (*bb).terminator.drop_place.proj_count };
    if drop_pc > 0 && sdf.root_count > 0 && drop_sdf_has_local(sdf, drop_local_v) &&
       !drop_place_has_deref(unsafe { view((*bb).terminator.drop_place) }) {
        let sflag = unsafe { drop_find_exact_sub_flag(sdf, view((*bb).terminator.drop_place)) };
        if sflag != 0u32 {
            unsafe {
                (*bb).terminator.drop_flag = sflag;
            }
        }
        return;
    }
    let flag = drop_flag_of(df, drop_local_v);
    if flag != 0u32 {
        unsafe {
            (*bb).terminator.drop_flag = flag;
        }
    } else if vdf.count > 0 {
        let vflag = unsafe { drop_find_exact_view_flag(body, thir, vdf, view((*bb).terminator.drop_place)) };
        if vflag != 0u32 {
            unsafe {
                (*bb).terminator.drop_flag = vflag;
            }
        }
    }
}

// Rewrites the statements of one block: flag set in a call's return block, flag clears before
// moves and copies, flag sets after assignments; then records the flag of a `drop` terminator.
fn drop_rewrite_block(
    body: mut_view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    cache: *mut DropNeedsCache,
    df: view<DropFlags>,
    vdf: view<ViewDropFlags>,
    sdf: view<SubDropFlags>,
    bb_idx: usize,
    call_pred_plus1: u32,
    arena: mut_view<Arena>
) {
    let bb = unsafe { mir_bb_at(body.bbs, bb_idx) };
    let term_kind = unsafe { (*bb).terminator.kind };

    if call_pred_plus1 == 0u32 && !drop_block_needs_rewrite(view(*body), df, vdf, sdf, bb_idx) {
        if term_kind == MIR_TERM_DROP {
            drop_attach_term_flag(view(*body), thir, df, vdf, sdf, bb);
        }
        return;
    }

    let old_count = unsafe { (*bb).stmt_count };
    let mut buf = drop_stmt_buf_new(mut_view(*arena), old_count + 16);

    if call_pred_plus1 != 0u32 {
        let pred_bb = unsafe { mir_bb_at(body.bbs, (call_pred_plus1 - 1u32) as usize) };
        let call_init_local_v = unsafe { (*pred_bb).terminator.destination.local.v };
        let flag = drop_flag_of(df, call_init_local_v);
        if flag != 0u32 {
            drop_stmt_buf_push_flag(mut_view(buf), mut_view(*arena), flag, df.bool_ty_v, true);
        }
        if sdf.root_count > 0 {
            unsafe {
                drop_sub_set_for_place(sdf, view((*pred_bb).terminator.destination), true, mut_view(buf), mut_view(*arena));
            }
        }
        if vdf.count > 0 {
            let cpc = unsafe { (*pred_bb).terminator.destination.proj_count };
            if cpc == 0 {
                let mut vi: usize = 0;
                while vi < vdf.count {
                    let e = unsafe { drop_view_entry_at(vdf.entries, vi) };
                    if (unsafe { (*e).place.local.v }) == call_init_local_v {
                        drop_stmt_buf_push_view_flag(mut_view(buf), mut_view(*arena), unsafe { (*e).flag_local_v }, vdf.u8_ty_v, true);
                    }
                    vi = vi + 1;
                }
            } else {
                let klen = unsafe { drop_place_view_key_len(view(*body), thir, view((*pred_bb).terminator.destination)) };
                if klen > 0 {
                    let mut vi: usize = 0;
                    while vi < vdf.count {
                        let e = unsafe { drop_view_entry_at(vdf.entries, vi) };
                        let ek = unsafe { (*e).key_proj_count };
                        if unsafe { drop_view_proj_prefix(view((*pred_bb).terminator.destination), klen, view((*e).place), ek) } {
                            drop_stmt_buf_push_view_flag(mut_view(buf), mut_view(*arena), unsafe { (*e).flag_local_v }, vdf.u8_ty_v, true);
                        }
                        vi = vi + 1;
                    }
                }
            }
        }
    }

    let mut j: usize = 0;
    while j < old_count {
        let stmt = unsafe { mir_stmt_at((*bb).stmts, j) };
        let stmt_kind = unsafe { (*stmt).kind };
        if stmt_kind == MIR_STMT_ASSIGN {
            unsafe {
                drop_visit_rvalue(view(*body), thir, hir, db, str_in, cache, df, vdf, sdf, view((*stmt).rvalue), mut_view(buf), mut_view(*arena));
            }
        } else if stmt_kind == MIR_STMT_DROP && sdf.root_count > 0 {
            unsafe {
                drop_sub_set_for_place(sdf, view((*stmt).place), false, mut_view(buf), mut_view(*arena));
            }
        }
        unsafe {
            drop_stmt_buf_push_copy(mut_view(buf), mut_view(*arena), view(*stmt));
        }
        if stmt_kind == MIR_STMT_ASSIGN {
            let dest_v = unsafe { (*stmt).place.local.v };
            let flag = drop_flag_of(df, dest_v);
            if flag != 0u32 {
                drop_stmt_buf_push_flag(mut_view(buf), mut_view(*arena), flag, df.bool_ty_v, true);
            }
            if sdf.root_count > 0 {
                unsafe {
                    drop_sub_set_for_place(sdf, view((*stmt).place), true, mut_view(buf), mut_view(*arena));
                }
            }
            if vdf.count > 0 {
                let pc = unsafe { (*stmt).place.proj_count };
                if pc == 0 {
                    let mut vi: usize = 0;
                    while vi < vdf.count {
                        let e = unsafe { drop_view_entry_at(vdf.entries, vi) };
                        if (unsafe { (*e).place.local.v }) == dest_v {
                            drop_stmt_buf_push_view_flag(mut_view(buf), mut_view(*arena), unsafe { (*e).flag_local_v }, vdf.u8_ty_v, true);
                        }
                        vi = vi + 1;
                    }
                } else {
                    let klen = unsafe { drop_place_view_key_len(view(*body), thir, view((*stmt).place)) };
                    if klen > 0 {
                        let mut vi: usize = 0;
                        while vi < vdf.count {
                            let e = unsafe { drop_view_entry_at(vdf.entries, vi) };
                            let ek = unsafe { (*e).key_proj_count };
                            if unsafe { drop_view_proj_prefix(view((*stmt).place), klen, view((*e).place), ek) } {
                                drop_stmt_buf_push_view_flag(mut_view(buf), mut_view(*arena), unsafe { (*e).flag_local_v }, vdf.u8_ty_v, true);
                            }
                            vi = vi + 1;
                        }
                    }
                }
            }
        }
        j = j + 1;
    }

    if term_kind == MIR_TERM_SWITCH_INT {
        unsafe {
            drop_visit_operand(view(*body), thir, hir, db, str_in, cache, df, vdf, sdf, view((*bb).terminator.discr), mut_view(buf), mut_view(*arena));
        }
    } else if term_kind == MIR_TERM_CALL {
        unsafe {
            drop_visit_operand(view(*body), thir, hir, db, str_in, cache, df, vdf, sdf, view((*bb).terminator.func), mut_view(buf), mut_view(*arena));
        }
        let arg_count = unsafe { (*bb).terminator.arg_count };
        let args = unsafe { (*bb).terminator.args };
        let mut a: usize = 0;
        while a < arg_count {
            let arg = unsafe { mir_op_at(args, a) };
            unsafe {
                drop_visit_operand(view(*body), thir, hir, db, str_in, cache, df, vdf, sdf, view(*arg), mut_view(buf), mut_view(*arena));
            }
            a = a + 1;
        }
    } else if term_kind == MIR_TERM_ASSERT {
        unsafe {
            drop_visit_operand(view(*body), thir, hir, db, str_in, cache, df, vdf, sdf, view((*bb).terminator.cond), mut_view(buf), mut_view(*arena));
        }
    }

    unsafe {
        (*bb).stmts = buf.stmts;
        (*bb).stmt_count = buf.count;
        (*bb).stmt_cap = buf.cap;
    }

    if term_kind == MIR_TERM_DROP {
        drop_attach_term_flag(view(*body), thir, df, vdf, sdf, bb);
    }
}

// =================================================================================================
// Cleanup block construction (port of expand_drop)
// =================================================================================================

fn drop_new_local(body: mut_view<MirBody>, arena: mut_view<Arena>, ty_v: u32, mut_flag: bool) -> MirLocalId {
    let zero = drop_zero_span();
    mir_add_local(
        mut_view(*body),
        mut_view(*arena),
        TypeId { v: ty_v },
        MIR_LOCAL_TEMP,
        mut_flag,
        StrId { v: 0u32 },
        view(zero)
    )
}

// `place` extended with one projection.
fn drop_place_with_proj(arena: mut_view<Arena>, place: view<MirPlace>, kind: u8, idx: u32) -> MirPlace {
    let mut proj = MirProjection {
        kind: kind,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    mir_proj_reset(mut_view(proj), kind);
    if kind == MIR_PROJ_DOWNCAST {
        proj.variant_idx = idx;
    } else if kind == MIR_PROJ_INDEX {
        proj.index_local = MirLocalId { v: idx };
    } else {
        proj.field_idx = idx;
    }
    let mut out = mir_local_place(0u32);
    mir_place_append_proj(mut_view(*arena), place, view(proj), mut_view(out));
    out
}

// A fresh block whose terminator is `drop(place) -> [return: target, unwind: bb0]` without a flag.
fn drop_new_field_drop_bb(
    body: mut_view<MirBody>,
    arena: mut_view<Arena>,
    place: view<MirPlace>,
    target_v: u32
) -> MirBbId {
    let bb_id = mir_add_bb(mut_view(*body), mut_view(*arena), false);
    let bb = unsafe { mir_bb_at(body.bbs, bb_id.v as usize) };
    unsafe {
        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_DROP);
        mir_copy_place(mut_view((*bb).terminator.drop_place), place);
        (*bb).terminator.drop_place.drop_flag = MIR_DROP_FLAG_NONE;
        (*bb).terminator.drop_target.v = target_v;
        (*bb).terminator.drop_unwind.v = 0u32;
        (*bb).terminator.drop_flag = 0u32;
        (*bb).has_terminator = true;
    }
    bb_id
}

fn drop_set_goto(body: mut_view<MirBody>, bb_idx: usize, target_v: u32) {
    let bb = unsafe { mir_bb_at(body.bbs, bb_idx) };
    unsafe {
        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_GOTO);
        (*bb).terminator.goto_target.v = target_v;
        (*bb).has_terminator = true;
    }
}

// Field drops of a struct or tuple, last field first; returns the new entry block.
fn drop_expand_aggregate_fields(
    body: mut_view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    arena: mut_view<Arena>,
    t: *mut AxType,
    place: view<MirPlace>,
    target_v: u32
) -> u32 {
    let mut inner_target_v = target_v;
    let field_count = unsafe { (*t).field_count };
    let fields = unsafe { (*t).fields };
    let mut i: usize = field_count;
    while i > 0 {
        let idx = i - 1;
        if mir_type_needs_drop_in(drop_field_type(fields, idx), thir, hir, db, str_in) {
            let field_place = drop_place_with_proj(mut_view(*arena), place, MIR_PROJ_FIELD, idx as u32);
            let field_bb = drop_new_field_drop_bb(mut_view(*body), mut_view(*arena), view(field_place), inner_target_v);
            inner_target_v = field_bb.v;
        }
        i = i - 1;
    }
    inner_target_v
}

// Drops of the by-move captures of a closure environment, last capture first. Capture k lives in
// environment field k + 1 (field 0 is the code pointer).
fn drop_expand_closure_captures(
    body: mut_view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    arena: mut_view<Arena>,
    t: *mut AxType,
    place: view<MirPlace>,
    target_v: u32
) -> u32 {
    let mut inner_target_v = target_v;
    let capture_count = unsafe { (*t).capture_count };
    let captures = unsafe { (*t).captures };
    let mut i: usize = capture_count;
    while i > 0 {
        let idx = i - 1;
        let capture = unsafe { capture_at(captures, idx) };
        let mode = unsafe { (*capture).mode };
        let capture_ty = TypeId { v: unsafe { (*capture).ty.v } };
        if mode == CAP_MOVE && mir_type_needs_drop_in(capture_ty, thir, hir, db, str_in) {
            let field_place = drop_place_with_proj(mut_view(*arena), place, MIR_PROJ_FIELD, (idx + 1) as u32);
            let field_bb = drop_new_field_drop_bb(mut_view(*body), mut_view(*arena), view(field_place), inner_target_v);
            inner_target_v = field_bb.v;
        }
        i = i - 1;
    }
    inner_target_v
}

// Enum drop: `_d = discriminant(place); switchInt(move _d) -> [v: <variant v field drops>, ...,
// otherwise: target]` with one arm per variant that has a field needing drop. Returns the switch
// block.
fn drop_expand_enum_variants(
    body: mut_view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    arena: mut_view<Arena>,
    t: *mut AxType,
    place: view<MirPlace>,
    target_v: u32
) -> u32 {
    let discr_local = drop_new_local(mut_view(*body), mut_view(*arena), thir.interner.t_isize.v, false);
    let switch_bb = mir_add_bb(mut_view(*body), mut_view(*arena), false);

    // `_d = discriminant(place);`
    let discr_stmt = drop_set_single_assign(mut_view(*body), mut_view(*arena), switch_bb.v, discr_local.v);
    unsafe {
        (*discr_stmt).rvalue.kind = MIR_RVALUE_DISCRIMINANT;
        mir_copy_place(mut_view((*discr_stmt).rvalue.place), place);
    }

    let variant_count = unsafe { (*t).variant_count };
    let values_bytes = mir_mul_usize(variant_count, size_of<u64>());
    let targets_bytes = mir_mul_usize(variant_count, size_of<MirBbId>());
    let values = arena_alloc_raw(mut_view(*arena), values_bytes, align_of<u64>()) as *mut u64;
    let targets = arena_alloc_raw(mut_view(*arena), targets_bytes, align_of<MirBbId>()) as *mut MirBbId;
    let mut arm_count: usize = 0;

    let mut variant: usize = 0;
    while variant < variant_count {
        let field_count = drop_variant_field_count(t, variant);
        let mut variant_needs_drop = false;
        let mut f: usize = 0;
        while f < field_count {
            if mir_type_needs_drop_in(drop_variant_field_type(t, variant, f), thir, hir, db, str_in) {
                variant_needs_drop = true;
                break;
            }
            f = f + 1;
        }

        if variant_needs_drop {
            let mut variant_target_v = target_v;
            let mut i: usize = field_count;
            while i > 0 {
                let idx = i - 1;
                if mir_type_needs_drop_in(drop_variant_field_type(t, variant, idx), thir, hir, db, str_in) {
                    let downcast_place = drop_place_with_proj(mut_view(*arena), place, MIR_PROJ_DOWNCAST, variant as u32);
                    let field_place = drop_place_with_proj(mut_view(*arena), view(downcast_place), MIR_PROJ_FIELD, idx as u32);
                    let field_bb = drop_new_field_drop_bb(mut_view(*body), mut_view(*arena), view(field_place), variant_target_v);
                    variant_target_v = field_bb.v;
                }
                i = i - 1;
            }
            unsafe {
                *mir_u64_at(values, arm_count) = variant as u64;
                (*mir_bb_id_at(targets, arm_count)).v = variant_target_v;
            }
            arm_count = arm_count + 1;
        }
        variant = variant + 1;
    }

    let switch_ptr_now = unsafe { mir_bb_at(body.bbs, switch_bb.v as usize) };
    unsafe {
        mir_term_zero(mut_view((*switch_ptr_now).terminator), MIR_TERM_SWITCH_INT);
        mir_operand_zero(mut_view((*switch_ptr_now).terminator.discr), MIR_OP_MOVE);
        mir_place_reset_u32(mut_view((*switch_ptr_now).terminator.discr.place), discr_local.v);
        (*switch_ptr_now).terminator.values = values;
        (*switch_ptr_now).terminator.targets = targets;
        (*switch_ptr_now).terminator.switch_count = arm_count;
        (*switch_ptr_now).terminator.otherwise.v = target_v;
        (*switch_ptr_now).has_terminator = true;
    }
    switch_bb.v
}

fn drop_new_coro_tag_reset_bb(
    body: mut_view<MirBody>,
    arena: mut_view<Arena>,
    place: view<MirPlace>,
    t_u32_v: u32,
    target_v: u32
) -> MirBbId {
    let bb = mir_add_bb(mut_view(*body), mut_view(*arena), false);
    let stmts = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    let tag_place = drop_place_with_proj(mut_view(*arena), place, MIR_PROJ_FIELD, 0u32);
    unsafe {
        mir_stmt_zero(mut_view(*stmts), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmts).place), view(tag_place));
        (*stmts).rvalue.kind = MIR_RVALUE_USE;
        mir_operand_zero(mut_view((*stmts).rvalue.use_op), MIR_OP_CONST);
        (*stmts).rvalue.use_op.constant.kind = MIR_CONST_INT;
        (*stmts).rvalue.use_op.constant.ty.v = t_u32_v;
        (*stmts).rvalue.use_op.constant.val = 0xFFFFFFFEu64;

        let bb_ptr = mir_bb_at(body.bbs, bb.v as usize);
        (*bb_ptr).stmts = stmts;
        (*bb_ptr).stmt_count = 1;
        (*bb_ptr).stmt_cap = 1;

        mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_GOTO);
        (*bb_ptr).terminator.goto_target.v = target_v;
        (*bb_ptr).has_terminator = true;
    }
    bb
}

pub fn drop_expand_coroutine(
    body: mut_view<MirBody>,
    thir: view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    arena: mut_view<Arena>,
    t: *mut AxType,
    place: view<MirPlace>,
    target_v: u32
) -> u32 {
    let state_count = unsafe { (*t).variant_count };
    if state_count == 0 {
        return target_v;
    }

    let tag_local = drop_new_local(mut_view(*body), mut_view(*arena), thir.interner.t_u32.v, false);
    let switch_bb = mir_add_bb(mut_view(*body), mut_view(*arena), false);

    // tag_local = place.0;
    let tag_place = drop_place_with_proj(mut_view(*arena), place, MIR_PROJ_FIELD, 0u32);
    let tag_stmt = drop_set_single_assign(mut_view(*body), mut_view(*arena), switch_bb.v, tag_local.v);
    unsafe {
        (*tag_stmt).rvalue.kind = MIR_RVALUE_USE;
        mir_operand_zero(mut_view((*tag_stmt).rvalue.use_op), MIR_OP_COPY);
        mir_copy_place(mut_view((*tag_stmt).rvalue.use_op.place), view(tag_place));
    }

    let values_bytes = mir_mul_usize(state_count, size_of<u64>());
    let targets_bytes = mir_mul_usize(state_count, size_of<MirBbId>());
    let values = arena_alloc_raw(mut_view(*arena), values_bytes, align_of<u64>()) as *mut u64;
    let targets = arena_alloc_raw(mut_view(*arena), targets_bytes, align_of<MirBbId>()) as *mut MirBbId;
    let mut arm_count: usize = 0;

    let state_counts = unsafe { (*t).variant_field_counts };
    let state_fields = unsafe { (*t).variant_fields as *mut *mut u32 };

    let mut state: usize = 0;
    while state < state_count {
        let fcnt = if (state_counts as usize) != 0 { unsafe { *usize_at(state_counts, state) } } else { 0 };
        let fidx_arr = if (state_fields as usize) != 0 { unsafe { *(state_fields + state) } } else { 0 as *mut u32 };

        let mut state_target_v = target_v;

        if state == 0 {
            let mut p_idx: usize = 0;
            while p_idx < fcnt {
                let f_idx = unsafe { *u32_at(fidx_arr, p_idx) };
                if (f_idx as usize) < (unsafe { (*t).field_count }) {
                    let field_ty = unsafe { *typeid_at((*t).fields, f_idx as usize) };
                    if mir_type_needs_drop_in(field_ty, thir, hir, db, str_in) {
                        let field_place = drop_place_with_proj(mut_view(*arena), place, MIR_PROJ_FIELD, f_idx);
                        let field_bb = drop_new_field_drop_bb(mut_view(*body), mut_view(*arena), view(field_place), state_target_v);
                        state_target_v = field_bb.v;
                    }
                }
                p_idx = p_idx + 1;
            }
        } else {
            let mut li: usize = 1;
            while li < fcnt {
                let f_idx = unsafe { *u32_at(fidx_arr, li) };
                if (f_idx as usize) < (unsafe { (*t).field_count }) {
                    let field_ty = unsafe { *typeid_at((*t).fields, f_idx as usize) };
                    if mir_type_needs_drop_in(field_ty, thir, hir, db, str_in) {
                        let field_place = drop_place_with_proj(mut_view(*arena), place, MIR_PROJ_FIELD, f_idx);
                        let field_bb = drop_new_field_drop_bb(mut_view(*body), mut_view(*arena), view(field_place), state_target_v);
                        state_target_v = field_bb.v;
                    }
                }
                li = li + 1;
            }
            if fcnt > 0 {
                let subfut_idx = unsafe { *u32_at(fidx_arr, 0) };
                if (subfut_idx as usize) < (unsafe { (*t).field_count }) {
                    let field_ty = unsafe { *typeid_at((*t).fields, subfut_idx as usize) };
                    if mir_type_needs_drop_in(field_ty, thir, hir, db, str_in) {
                        let field_place = drop_place_with_proj(mut_view(*arena), place, MIR_PROJ_FIELD, subfut_idx);
                        let field_bb = drop_new_field_drop_bb(mut_view(*body), mut_view(*arena), view(field_place), state_target_v);
                        state_target_v = field_bb.v;
                    }
                }
            }
        }

        unsafe {
            *mir_u64_at(values, arm_count) = state as u64;
            (*mir_bb_id_at(targets, arm_count)).v = state_target_v;
        }
        arm_count = arm_count + 1;
        state = state + 1;
    }

    let switch_ptr_now = unsafe { mir_bb_at(body.bbs, switch_bb.v as usize) };
    unsafe {
        mir_term_zero(mut_view((*switch_ptr_now).terminator), MIR_TERM_SWITCH_INT);
        mir_operand_zero(mut_view((*switch_ptr_now).terminator.discr), MIR_OP_MOVE);
        mir_place_reset_u32(mut_view((*switch_ptr_now).terminator.discr.place), tag_local.v);
        (*switch_ptr_now).terminator.values = values;
        (*switch_ptr_now).terminator.targets = targets;
        (*switch_ptr_now).terminator.switch_count = arm_count;
        (*switch_ptr_now).terminator.otherwise.v = target_v;
        (*switch_ptr_now).has_terminator = true;
    }
    switch_bb.v
}

// The destructor call block: `_a = &place; _t = const <drop fn>(move _a) -> [return: target,
// unwind: bb0]`. Returns the call block.
fn drop_expand_user_destructor(
    body: mut_view<MirBody>,
    thir: mut_view<Thir>,
    arena: mut_view<Arena>,
    drop_fn: *const HirItem,
    ty: TypeId,
    place: view<MirPlace>,
    target_v: u32
) -> u32 {
    let result_local = drop_new_local(mut_view(*body), mut_view(*arena), thir.interner.t_unit.v, false);
    let arg_ty = intern_view_ty(mut_view(thir.interner), TypeId { v: ty.v }, true);
    let arg_local = drop_new_local(mut_view(*body), mut_view(*arena), arg_ty.v, false);
    let call_bb = mir_add_bb(mut_view(*body), mut_view(*arena), false);

    // `_a = &place;` — C leaves the borrow kind zero-initialised: a shared borrow (see the module
    // header).
    let ref_stmt = drop_set_single_assign(mut_view(*body), mut_view(*arena), call_bb.v, arg_local.v);
    unsafe {
        (*ref_stmt).rvalue.kind = MIR_RVALUE_REF;
        (*ref_stmt).rvalue.borrow_kind = MIR_BORROW_SHARED;
        mir_copy_place(mut_view((*ref_stmt).rvalue.place), place);
    }

    // Prefer the destructor's full function signature from THIR `item_types` so native ABI lowering
    // sees the `self: mut_view<T>` parameter even without the separate monomorphization pass; fall
    // back to the bare `fn` type (`AxType fn_t = { .kind = AX_TY_FN }`) when `item_types` is unpopulated.
    let mut fn_ty = intern_fn_ty(mut_view(thir.interner), false, StrId { v: 0u32 }, 0 as *mut TypeId, 0, TypeId { v: 0u32 });
    let item_fn_ty_ptr = thir_get_item_type(view(*thir), drop_fn);
    if (item_fn_ty_ptr as usize) != 0 {
        let item_fn_v = unsafe { (*item_fn_ty_ptr).v };
        if item_fn_v != 0u32 {
            fn_ty.v = item_fn_v;
        }
    }
    let drop_sym_v = unsafe { (*drop_fn).symbol.v };

    let args = arena_alloc_raw(mut_view(*arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*args), MIR_OP_MOVE);
        mir_place_reset_u32(mut_view((*args).place), arg_local.v);
    }

    let call_ptr = unsafe { mir_bb_at(body.bbs, call_bb.v as usize) };
    unsafe {
        mir_term_zero(mut_view((*call_ptr).terminator), MIR_TERM_CALL);
        mir_operand_zero(mut_view((*call_ptr).terminator.func), MIR_OP_CONST);
        (*call_ptr).terminator.func.constant.kind = MIR_CONST_FN;
        (*call_ptr).terminator.func.constant.ty.v = fn_ty.v;
        (*call_ptr).terminator.func.constant.val = drop_sym_v as u64;
        (*call_ptr).terminator.func.constant.sym.v = drop_sym_v;
        (*call_ptr).terminator.args = args;
        (*call_ptr).terminator.arg_count = 1;
        mir_place_reset_u32(mut_view((*call_ptr).terminator.destination), result_local.v);
        (*call_ptr).terminator.has_destination = true;
        (*call_ptr).terminator.call_target.v = target_v;
        (*call_ptr).terminator.call_unwind.v = 0u32;
        (*call_ptr).has_terminator = true;
    }
    call_bb.v
}

// Rewrites the `drop` terminator of block `bb_idx` into explicit cleanup blocks. Returns false
// (and leaves the terminator alone) when the block does not end in `drop` or the dropped place
// has no known type.
fn drop_expand_block(
    body: mut_view<MirBody>,
    thir: mut_view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    vdf: view<ViewDropFlags>,
    sdf: view<SubDropFlags>,
    arena: mut_view<Arena>,
    bb_idx: usize
) -> bool {
    let bb = unsafe { mir_bb_at(body.bbs, bb_idx) };
    let has_terminator = unsafe { (*bb).has_terminator };
    let term_kind = unsafe { (*bb).terminator.kind };
    if !has_terminator || term_kind != MIR_TERM_DROP {
        return false;
    }

    let mut place = mir_local_place(0u32);
    unsafe {
        mir_copy_place(mut_view(place), view((*bb).terminator.drop_place));
    }
    let target_v = unsafe { (*bb).terminator.drop_target.v };
    let mut flag = unsafe { (*bb).terminator.drop_flag };
    let mut is_view_flag = flag != 0u32 && flag != MIR_DROP_FLAG_NONE &&
        ((vdf.count > 0 && drop_vdf_is_flag(vdf, flag)) || (sdf.root_count > 0 && drop_sdf_is_flag(sdf, flag)));
    if (flag == 0u32 || flag == MIR_DROP_FLAG_NONE) && vdf.count > 0 {
        let vflag = drop_find_exact_view_flag(view(*body), view(*thir), vdf, view(place));
        if vflag != 0u32 {
            flag = vflag;
            is_view_flag = true;
        }
    }
    if (flag == 0u32 || flag == MIR_DROP_FLAG_NONE) && sdf.root_count > 0 && place.proj_count > 0 &&
       !drop_place_has_deref(view(place)) {
        let sflag = drop_find_exact_sub_flag(sdf, view(place));
        if sflag != 0u32 {
            flag = sflag;
            is_view_flag = true;
        }
    }

    let ty = mir_drop_place_type(view(*body), view(*thir), view(place));
    let t = drop_type_get(view(*thir), TypeId { v: ty.v });
    if (t as usize) == 0 {
        return false;
    }
    let kind = unsafe { (*t).kind };

    let mut drop_fn: *const HirItem = 0 as *const HirItem;
    if kind == TY_STRUCT {
        let def = unsafe { (*t).def };
        drop_fn = drop_find_impl_fn_with_thir(TypeId { v: ty.v }, view(*thir), hir, def, db, str_in);
    }

    let mut sub_root: *mut SubDropRoot = 0 as *mut SubDropRoot;
    if sdf.root_count > 0 && !drop_place_has_deref(view(place)) {
        sub_root = drop_find_sub_root(sdf, place.local.v);
    }

    let mut inner_target_v = target_v;
    if (sub_root as usize) != 0 && place.proj_count == 0 {
        let init_flag_v = unsafe { (*sub_root).init_flag_v };
        let clear_init_bb = mir_add_bb(mut_view(*body), mut_view(*arena), false);
        let clear_init_ptr = unsafe { mir_bb_at(body.bbs, clear_init_bb.v as usize) };
        let clear_init_stmts = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
        unsafe {
            drop_init_view_flag_assign(mut_view(*clear_init_stmts), init_flag_v, thir.interner.t_u8.v, false);
            (*clear_init_ptr).stmts = clear_init_stmts;
            (*clear_init_ptr).stmt_count = 1;
            (*clear_init_ptr).stmt_cap = 1;
        }
        drop_set_goto(mut_view(*body), clear_init_bb.v as usize, target_v);
        inner_target_v = clear_init_bb.v;
    }

    if kind == TY_STRUCT || kind == TY_TUPLE {
        inner_target_v = drop_expand_aggregate_fields(
            mut_view(*body), view(*thir), hir, db, str_in, mut_view(*arena), t, view(place), inner_target_v
        );
    } else if kind == TY_CLOSURE {
        inner_target_v = drop_expand_closure_captures(
            mut_view(*body), view(*thir), hir, db, str_in, mut_view(*arena), t, view(place), inner_target_v
        );
    } else if kind == TY_ENUM {
        inner_target_v = drop_expand_enum_variants(
            mut_view(*body), view(*thir), hir, db, str_in, mut_view(*arena), t, view(place), inner_target_v
        );
    } else if kind == TY_COROUTINE {
        inner_target_v = drop_expand_coroutine(
            mut_view(*body), view(*thir), hir, db, str_in, mut_view(*arena), t, view(place), inner_target_v
        );
    } else if kind == TY_ARRAY {
        let alen = (unsafe { (*t).array_len }) as usize;
        let elem_ty = TypeId { v: unsafe { (*t).elem.v } };
        if alen > 0 && mir_type_needs_drop_in(elem_ty, view(*thir), hir, db, str_in) {
            let mut i: usize = alen;
            while i > 0 {
                let idx = i - 1;
                let idx_local = drop_new_local(mut_view(*body), mut_view(*arena), thir.interner.t_usize.v, false);
                let elem_place = drop_place_with_proj(mut_view(*arena), view(place), MIR_PROJ_INDEX, idx_local.v);
                let elem_bb = drop_new_field_drop_bb(mut_view(*body), mut_view(*arena), view(elem_place), inner_target_v);
                let idx_stmt = drop_set_single_assign(mut_view(*body), mut_view(*arena), elem_bb.v, idx_local.v);
                unsafe {
                    (*idx_stmt).rvalue.kind = MIR_RVALUE_USE;
                    mir_operand_zero(mut_view((*idx_stmt).rvalue.use_op), MIR_OP_CONST);
                    (*idx_stmt).rvalue.use_op.constant.kind = MIR_CONST_INT;
                    (*idx_stmt).rvalue.use_op.constant.ty.v = thir.interner.t_usize.v;
                    (*idx_stmt).rvalue.use_op.constant.val = idx as u64;
                }
                inner_target_v = elem_bb.v;
                i = i - 1;
            }
        }
    }

    if (drop_fn as usize) != 0 {
        inner_target_v = drop_expand_user_destructor(
            mut_view(*body), mut_view(*thir), mut_view(*arena), drop_fn, TypeId { v: ty.v }, view(place), inner_target_v
        );
    }

    if (sub_root as usize) != 0 {
        let init_flag_v = unsafe { (*sub_root).init_flag_v };
        if place.proj_count == 0 {
            let check_init_bb = mir_add_bb(mut_view(*body), mut_view(*arena), false);
            let init_vals = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
            let init_tgts = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
            unsafe {
                *init_vals = 1u64;
                (*init_tgts).v = inner_target_v;
            }
            let check_init_ptr = unsafe { mir_bb_at(body.bbs, check_init_bb.v as usize) };
            unsafe {
                mir_term_zero(mut_view((*check_init_ptr).terminator), MIR_TERM_SWITCH_INT);
                mir_operand_zero(mut_view((*check_init_ptr).terminator.discr), MIR_OP_COPY);
                mir_place_reset_u32(mut_view((*check_init_ptr).terminator.discr.place), init_flag_v);
                (*check_init_ptr).terminator.values = init_vals;
                (*check_init_ptr).terminator.targets = init_tgts;
                (*check_init_ptr).terminator.switch_count = 1;
                (*check_init_ptr).terminator.otherwise.v = target_v;
                (*check_init_ptr).has_terminator = true;
            }

            if flag != 0u32 && flag != MIR_DROP_FLAG_NONE && !is_view_flag {
                let clear_bb = mir_add_bb(mut_view(*body), mut_view(*arena), false);
                let clear_ptr = unsafe { mir_bb_at(body.bbs, clear_bb.v as usize) };
                let clear_stmts = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
                unsafe {
                    drop_init_flag_assign(mut_view(*clear_stmts), flag, thir.interner.t_bool.v, false);
                    (*clear_ptr).stmts = clear_stmts;
                    (*clear_ptr).stmt_count = 1;
                    (*clear_ptr).stmt_cap = 1;
                }
                drop_set_goto(mut_view(*body), clear_bb.v as usize, check_init_bb.v);

                let values = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
                let targets = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
                unsafe {
                    *values = 1u64;
                    (*targets).v = clear_bb.v;
                }
                let bb_now = unsafe { mir_bb_at(body.bbs, bb_idx) };
                unsafe {
                    mir_term_zero(mut_view((*bb_now).terminator), MIR_TERM_SWITCH_INT);
                    mir_operand_zero(mut_view((*bb_now).terminator.discr), MIR_OP_COPY);
                    mir_place_reset_u32(mut_view((*bb_now).terminator.discr.place), flag);
                    (*bb_now).terminator.values = values;
                    (*bb_now).terminator.targets = targets;
                    (*bb_now).terminator.switch_count = 1;
                    (*bb_now).terminator.otherwise.v = check_init_bb.v;
                    (*bb_now).has_terminator = true;
                }
            } else {
                drop_set_goto(mut_view(*body), bb_idx, check_init_bb.v);
            }
            return true;
        } else if flag == 0u32 || flag == MIR_DROP_FLAG_NONE {
            let init_vals = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
            let init_tgts = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
            unsafe {
                *init_vals = 1u64;
                (*init_tgts).v = inner_target_v;
            }
            let bb_now = unsafe { mir_bb_at(body.bbs, bb_idx) };
            unsafe {
                mir_term_zero(mut_view((*bb_now).terminator), MIR_TERM_SWITCH_INT);
                mir_operand_zero(mut_view((*bb_now).terminator.discr), MIR_OP_COPY);
                mir_place_reset_u32(mut_view((*bb_now).terminator.discr.place), init_flag_v);
                (*bb_now).terminator.values = init_vals;
                (*bb_now).terminator.targets = init_tgts;
                (*bb_now).terminator.switch_count = 1;
                (*bb_now).terminator.otherwise.v = target_v;
                (*bb_now).has_terminator = true;
            }
            return true;
        }
    }

    if flag != 0u32 && flag != MIR_DROP_FLAG_NONE {
        // `if flag { flag = false; <drop> }`
        let clear_bb = mir_add_bb(mut_view(*body), mut_view(*arena), false);
        let clear_ptr = unsafe { mir_bb_at(body.bbs, clear_bb.v as usize) };
        let clear_stmts = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
        unsafe {
            if is_view_flag {
                drop_init_view_flag_assign(mut_view(*clear_stmts), flag, thir.interner.t_u8.v, false);
            } else {
                drop_init_flag_assign(mut_view(*clear_stmts), flag, thir.interner.t_bool.v, false);
            }
            (*clear_ptr).stmts = clear_stmts;
            (*clear_ptr).stmt_count = 1;
            (*clear_ptr).stmt_cap = 1;
        }
        drop_set_goto(mut_view(*body), clear_bb.v as usize, inner_target_v);

        let values = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
        let targets = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
        unsafe {
            *values = 1u64;
            (*targets).v = clear_bb.v;
        }
        let bb_now = unsafe { mir_bb_at(body.bbs, bb_idx) };
        unsafe {
            mir_term_zero(mut_view((*bb_now).terminator), MIR_TERM_SWITCH_INT);
            mir_operand_zero(mut_view((*bb_now).terminator.discr), MIR_OP_COPY);
            mir_place_reset_u32(mut_view((*bb_now).terminator.discr.place), flag);
            (*bb_now).terminator.values = values;
            (*bb_now).terminator.targets = targets;
            (*bb_now).terminator.switch_count = 1;
            (*bb_now).terminator.otherwise.v = target_v;
            (*bb_now).has_terminator = true;
        }
    } else {
        drop_set_goto(mut_view(*body), bb_idx, inner_target_v);
    }
    true
}

// =================================================================================================
// In-place `async fn` locals (ADR-0050, SPEC-33 AXS-ASY-043 item 7)
// =================================================================================================

// `map[slot]` is the state field of an in-place `poll` local, 0 for every other local.
struct InplaceMap {
    map: *mut u32,
    len: usize,
}

fn inplace_field_of(m: view<InplaceMap>, l: u32) -> u32 {
    if (l as usize) >= m.len {
        return 0u32;
    }
    unsafe { *u32_at(m.map, l as usize) }
}

// `(*_1).field` followed by the projections of `place`.
fn inplace_place(arena: mut_view<Arena>, field: u32, place: mut_view<MirPlace>) {
    let n = place.proj_count;
    let projs = arena_alloc_raw(mut_view(*arena), mir_mul_usize(n + 2, size_of<MirProjection>()), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        let d0 = mir_proj_at(projs, 0);
        mir_proj_reset(mut_view(*d0), MIR_PROJ_DEREF);
        let d1 = mir_proj_at(projs, 1);
        mir_proj_reset(mut_view(*d1), MIR_PROJ_FIELD);
        (*d1).field_idx = field;
        let mut i: usize = 0;
        while i < n {
            *mir_proj_at(projs, i + 2) = *mir_proj_at(place.projs, i);
            i = i + 1;
        }
    }
    place.local.v = 1u32;
    place.projs = projs;
    place.proj_count = n + 2;
}

// A projection names an index/bound local, not a place: its slot is refreshed from the field before the use.
fn inplace_refresh(m: view<InplaceMap>, l: u32, buf: mut_view<DropStmtBuf>, arena: mut_view<Arena>) {
    let field = inplace_field_of(m, l);
    if field == 0u32 {
        return;
    }
    let mut src = mir_local_place(l);
    inplace_place(mut_view(*arena), field, mut_view(src));
    let st = drop_stmt_buf_next(mut_view(*buf), mut_view(*arena));
    unsafe {
        mir_stmt_zero(mut_view(*st), MIR_STMT_ASSIGN);
        mir_place_reset_u32(mut_view((*st).place), l);
        (*st).rvalue.kind = MIR_RVALUE_USE;
        mir_operand_zero(mut_view((*st).rvalue.use_op), MIR_OP_COPY);
        mir_copy_place(mut_view((*st).rvalue.use_op.place), view(src));
    }
}

fn inplace_rewrite_place(m: view<InplaceMap>, p: mut_view<MirPlace>, buf: mut_view<DropStmtBuf>, arena: mut_view<Arena>) {
    let mut i: usize = 0;
    while i < p.proj_count {
        let pr = unsafe { mir_proj_at(p.projs, i) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX {
            inplace_refresh(m, (unsafe { (*pr).index_local.v }), mut_view(*buf), mut_view(*arena));
        } else if pk == MIR_PROJ_SUB_SLICE {
            if unsafe { (*pr).has_from } {
                inplace_refresh(m, (unsafe { (*pr).from_local.v }), mut_view(*buf), mut_view(*arena));
            }
            if unsafe { (*pr).has_to } {
                inplace_refresh(m, (unsafe { (*pr).to_local.v }), mut_view(*buf), mut_view(*arena));
            }
        }
        i = i + 1;
    }
    let field = inplace_field_of(m, p.local.v);
    if field != 0u32 {
        inplace_place(mut_view(*arena), field, mut_view(*p));
    }
}

fn inplace_rewrite_operand(m: view<InplaceMap>, op: mut_view<MirOperand>, buf: mut_view<DropStmtBuf>, arena: mut_view<Arena>) {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        inplace_rewrite_place(m, mut_view(op.place), mut_view(*buf), mut_view(*arena));
    }
}

fn inplace_rewrite_rvalue(m: view<InplaceMap>, rv: mut_view<MirRvalue>, buf: mut_view<DropStmtBuf>, arena: mut_view<Arena>) {
    let k = rv.kind;
    if k == MIR_RVALUE_USE || k == MIR_RVALUE_CAST || k == MIR_RVALUE_UNARY_OP || k == MIR_RVALUE_REPEAT {
        inplace_rewrite_operand(m, mut_view(rv.use_op), mut_view(*buf), mut_view(*arena));
        if k == MIR_RVALUE_REPEAT && (rv.repeat_count_op as usize) != 0 {
            inplace_rewrite_operand(m, unsafe { mut_view(*rv.repeat_count_op) }, mut_view(*buf), mut_view(*arena));
        }
    } else if k == MIR_RVALUE_REF || k == MIR_RVALUE_LEN || k == MIR_RVALUE_DISCRIMINANT {
        inplace_rewrite_place(m, mut_view(rv.place), mut_view(*buf), mut_view(*arena));
    } else if k == MIR_RVALUE_BINARY_OP || k == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        inplace_rewrite_operand(m, mut_view(rv.lhs), mut_view(*buf), mut_view(*arena));
        inplace_rewrite_operand(m, mut_view(rv.rhs), mut_view(*buf), mut_view(*arena));
    } else if k == MIR_RVALUE_AGGREGATE {
        let mut i: usize = 0;
        while i < rv.operand_count {
            let op = unsafe { mir_op_at(rv.operands, i) };
            inplace_rewrite_operand(m, unsafe { mut_view(*op) }, mut_view(*buf), mut_view(*arena));
            i = i + 1;
        }
    }
}

fn inplace_rewrite_terminator(m: view<InplaceMap>, term: mut_view<MirTerminator>, buf: mut_view<DropStmtBuf>, arena: mut_view<Arena>) {
    let tk = term.kind;
    if tk == MIR_TERM_SWITCH_INT {
        inplace_rewrite_operand(m, mut_view(term.discr), mut_view(*buf), mut_view(*arena));
    } else if tk == MIR_TERM_CALL {
        inplace_rewrite_operand(m, mut_view(term.func), mut_view(*buf), mut_view(*arena));
        let mut a: usize = 0;
        while a < term.arg_count {
            let op = unsafe { mir_op_at(term.args, a) };
            inplace_rewrite_operand(m, unsafe { mut_view(*op) }, mut_view(*buf), mut_view(*arena));
            a = a + 1;
        }
        if term.has_destination {
            inplace_rewrite_place(m, mut_view(term.destination), mut_view(*buf), mut_view(*arena));
        }
    } else if tk == MIR_TERM_ASSERT {
        inplace_rewrite_operand(m, mut_view(term.cond), mut_view(*buf), mut_view(*arena));
    } else if tk == MIR_TERM_DROP {
        inplace_rewrite_place(m, mut_view(term.drop_place), mut_view(*buf), mut_view(*arena));
    }
}

// Is `slot` a whole in-place local and `field_pl` exactly its state field `(*_1).field`?
fn inplace_is_own_field(m: view<InplaceMap>, slot: view<MirPlace>, field_pl: view<MirPlace>) -> bool {
    let field = inplace_field_of(m, slot.local.v);
    if field == 0u32 || slot.proj_count != 0 || field_pl.local.v != 1u32 || field_pl.proj_count != 2 {
        return false;
    }
    let d0 = unsafe { mir_proj_at(field_pl.projs, 0) };
    let d1 = unsafe { mir_proj_at(field_pl.projs, 1) };
    (unsafe { (*d0).kind }) == MIR_PROJ_DEREF && (unsafe { (*d1).kind }) == MIR_PROJ_FIELD && (unsafe { (*d1).field_idx }) == field
}

fn inplace_is_save_or_restore(m: view<InplaceMap>, st: view<MirStmt>) -> bool {
    if st.kind != MIR_STMT_ASSIGN || st.rvalue.kind != MIR_RVALUE_USE || st.rvalue.use_op.kind != MIR_OP_MOVE {
        return false;
    }
    inplace_is_own_field(m, view(st.place), view(st.rvalue.use_op.place)) ||
        inplace_is_own_field(m, view(st.rvalue.use_op.place), view(st.place))
}

fn inplace_is_marker(st: view<MirStmt>) -> bool {
    st.kind == MIR_STMT_STORAGE_LIVE && st.place.local.v == 1u32 && st.place.proj_count == 2
}

// Gives the in-place locals of a synthesized `poll` body their storage in the state machine: the dispatch block
// names each slot and its field (`StorageLive(slot)` with `place = (*_1).field`, `async_lower.ax`). Slot and field
// never hold different values (the field is only written by the save and read by the restore of its slot), so
// every place rooted at the slot becomes `(*_1).field..` and the save/restore moves and storage markers of the slot
// are removed. Runs after drop elaboration, whose flags therefore treat in-place locals like all other locals.
fn drop_coalesce_inplace(body: mut_view<MirBody>, arena: mut_view<Arena>) {
    if !body.async_lowered || body.bb_count == 0 {
        return;
    }
    let bb0 = unsafe { mir_bb_at(body.bbs, 0) };
    let mut m = InplaceMap { map: 0 as *mut u32, len: 0 };
    let mut s: usize = 0;
    while s < (unsafe { (*bb0).stmt_count }) {
        let st = unsafe { mir_stmt_at((*bb0).stmts, s) };
        if inplace_is_marker(unsafe { view(*st) }) {
            if m.len == 0 {
                m.len = body.local_count;
                m.map = arena_alloc_raw(mut_view(*arena), m.len << 2, align_of<u32>()) as *mut u32;
                let mut z: usize = 0;
                while z < m.len {
                    unsafe { *u32_at(m.map, z) = 0u32; }
                    z = z + 1;
                }
            }
            let slot = (unsafe { (*st).storage_local.v }) as usize;
            if slot < m.len {
                let fp = unsafe { mir_proj_at((*st).place.projs, 1) };
                unsafe { *u32_at(m.map, slot) = (*fp).field_idx; }
            }
        }
        s = s + 1;
    }
    if m.len == 0 {
        return;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, b) };
        let sc = unsafe { (*bb).stmt_count };
        let mut buf = drop_stmt_buf_new(mut_view(*arena), sc + 4);
        s = 0;
        while s < sc {
            let st = unsafe { mir_stmt_at((*bb).stmts, s) };
            let sk = unsafe { (*st).kind };
            let is_storage = sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD;
            let dead = (is_storage && inplace_field_of(view(m), (unsafe { (*st).storage_local.v })) != 0u32) ||
                inplace_is_save_or_restore(view(m), unsafe { view(*st) });
            if !dead {
                unsafe {
                    if sk == MIR_STMT_ASSIGN {
                        inplace_rewrite_rvalue(view(m), mut_view((*st).rvalue), mut_view(buf), mut_view(*arena));
                        inplace_rewrite_place(view(m), mut_view((*st).place), mut_view(buf), mut_view(*arena));
                    } else if sk == MIR_STMT_DROP {
                        inplace_rewrite_place(view(m), mut_view((*st).place), mut_view(buf), mut_view(*arena));
                    } else if sk == MIR_STMT_ATOMIC {
                        inplace_rewrite_operand(view(m), mut_view((*st).rvalue.use_op), mut_view(buf), mut_view(*arena));
                        inplace_rewrite_operand(view(m), mut_view((*st).rvalue.lhs), mut_view(buf), mut_view(*arena));
                        inplace_rewrite_operand(view(m), mut_view((*st).rvalue.rhs), mut_view(buf), mut_view(*arena));
                        inplace_rewrite_place(view(m), mut_view((*st).place), mut_view(buf), mut_view(*arena));
                    }
                    drop_stmt_buf_push_copy(mut_view(buf), mut_view(*arena), view(*st));
                }
            }
            s = s + 1;
        }
        if unsafe { (*bb).has_terminator } {
            unsafe {
                inplace_rewrite_terminator(view(m), mut_view((*bb).terminator), mut_view(buf), mut_view(*arena));
            }
        }
        unsafe {
            (*bb).stmts = buf.stmts;
            (*bb).stmt_count = buf.count;
            (*bb).stmt_cap = buf.cap;
        }
        b = b + 1;
    }
}

// =================================================================================================
// Entry point (port of ax_mir_drop_elaborate)
// =================================================================================================

// Elaborates the drops of one MIR body in place. `db` may be null (destructor impls are then
// matched on interned names); new blocks, locals, statements and projections are allocated in
// `arena`; new types (`mut_view<T>` destructor arguments, the bare `fn` callee type) are interned
// into `thir`.
pub fn mir_drop_elaborate(
    body: mut_view<MirBody>,
    thir: mut_view<Thir>,
    hir: view<HirFile>,
    db: *const SourceDatabase,
    str_in: view<StrInterner>,
    arena: mut_view<Arena>
) {
    // Prebuilt bodies (lowered `async fn` constructors / `poll`) can be reached from several items.
    if body.drop_elaborated {
        return;
    }
    body.drop_elaborated = true;
    let orig_local_count = body.local_count;
    let bool_ty_v = thir.interner.t_bool.v;
    let cache = drop_get_needs_cache(view(*thir), hir, db);

    // 1. One flag local per original local (the return slot excluded) whose type needs drop.
    //    Allocate `flags` lazily on the first local that needs drop.
    let mut flags: *mut u32 = 0 as *mut u32;
    let mut flag_count: usize = 0;
    let mut i: usize = 1;
    while i < orig_local_count {
        let decl = unsafe { mir_local_at(body.locals, i) };
        let lk = unsafe { (*decl).kind };
        let local_ty = TypeId { v: unsafe { (*decl).ty.v } };
        if lk != MIR_LOCAL_STATIC && lk != MIR_LOCAL_TLS && lk != MIR_LOCAL_CONST &&
           mir_type_needs_drop_cached(local_ty, view(*thir), hir, db, str_in, cache) {
            if (flags as usize) == 0 {
                let flags_bytes = (orig_local_count + 1) << 2;
                flags = arena_alloc_raw(mut_view(*arena), flags_bytes, align_of<u32>()) as *mut u32;
                let mut z: usize = 0;
                while z <= orig_local_count {
                    unsafe {
                        *(((flags as usize) + (z << 2)) as *mut u32) = 0u32;
                    }
                    z = z + 1;
                }
            }
            let flag_local = drop_new_local(mut_view(*body), mut_view(*arena), bool_ty_v, true);
            unsafe {
                *(((flags as usize) + (i << 2)) as *mut u32) = flag_local.v;
            }
            flag_count = flag_count + 1;
        }
        i = i + 1;
    }
    let u8_ty_v = thir.interner.t_u8.v;
    let mut vdf = ViewDropFlags {
        entries: 0 as *mut ViewDropEntry,
        count: 0,
        cap: 0,
        u8_ty_v: u8_ty_v,
    };
    drop_collect_view_flags(view(*body), view(*thir), hir, db, str_in, cache, mut_view(vdf), mut_view(*arena));
    if vdf.count > 0 {
        let mut vi: usize = 0;
        while vi < vdf.count {
            let fl = drop_new_local(mut_view(*body), mut_view(*arena), u8_ty_v, false);
            let e = unsafe { drop_view_entry_at(vdf.entries, vi) };
            unsafe {
                (*e).flag_local_v = fl.v;
            }
            vi = vi + 1;
        }
    }
    let mut sdf = SubDropFlags {
        roots: 0 as *mut SubDropRoot,
        root_count: 0,
        root_cap: 0,
        leaves: 0 as *mut SubDropLeaf,
        leaf_count: 0,
        leaf_cap: 0,
        u8_ty_v: u8_ty_v,
    };
    drop_collect_sub_flags(view(*body), view(*thir), hir, db, str_in, cache, orig_local_count, mut_view(sdf), mut_view(*arena));
    if sdf.root_count > 0 {
        let mut ri: usize = 0;
        while ri < sdf.root_count {
            let init_fl = drop_new_local(mut_view(*body), mut_view(*arena), u8_ty_v, false);
            let r = unsafe { drop_sub_root_at(sdf.roots, ri) };
            let lstart = unsafe { (*r).leaf_start };
            let lend = lstart + (unsafe { (*r).leaf_count });
            unsafe {
                (*r).init_flag_v = init_fl.v;
            }
            let mut li: usize = lstart;
            while li < lend {
                let lfl = drop_new_local(mut_view(*body), mut_view(*arena), u8_ty_v, false);
                let lf = unsafe { drop_sub_leaf_at(sdf.leaves, li) };
                unsafe {
                    (*lf).flag_local_v = lfl.v;
                }
                li = li + 1;
            }
            ri = ri + 1;
        }
    }
    body.drop_flag_count = body.drop_flag_count + flag_count;

    // 2..4. Flag initialisation, call-return arming, and per-block flag maintenance are all
    //       no-ops when no original local or view-place needs a drop flag.
    if flag_count > 0 || vdf.count > 0 || sdf.root_count > 0 {
        let df = DropFlags { flags: flags, orig_local_count: orig_local_count, bool_ty_v: bool_ty_v };

        // 2. Flag initialisation at the top of bb0: arguments and view-places arrive initialised.
        if body.bb_count > 0 {
            let bb0 = unsafe { mir_bb_at(body.bbs, 0) };
            let old_count = unsafe { (*bb0).stmt_count };
            let mut buf = drop_stmt_buf_new(mut_view(*arena), old_count + flag_count + vdf.count + sdf.root_count + sdf.leaf_count);
            if flag_count > 0 {
                i = 1;
                while i < orig_local_count {
                    let flag = drop_flag_of(view(df), i as u32);
                    if flag != 0u32 {
                        let decl = unsafe { mir_local_at(body.locals, i) };
                        let is_arg = (unsafe { (*decl).kind }) == MIR_LOCAL_ARG;
                        drop_stmt_buf_push_flag(mut_view(buf), mut_view(*arena), flag, bool_ty_v, is_arg);
                    }
                    i = i + 1;
                }
            }
            if vdf.count > 0 {
                let mut vi: usize = 0;
                while vi < vdf.count {
                    let e = unsafe { drop_view_entry_at(vdf.entries, vi) };
                    drop_stmt_buf_push_view_flag(mut_view(buf), mut_view(*arena), unsafe { (*e).flag_local_v }, u8_ty_v, true);
                    vi = vi + 1;
                }
            }
            if sdf.root_count > 0 {
                let mut ri: usize = 0;
                while ri < sdf.root_count {
                    let r = unsafe { drop_sub_root_at(sdf.roots, ri) };
                    let rv_loc = (unsafe { (*r).local_v }) as usize;
                    let decl = unsafe { mir_local_at(body.locals, rv_loc) };
                    let is_arg = (unsafe { (*decl).kind }) == MIR_LOCAL_ARG;
                    drop_stmt_buf_push_view_flag(mut_view(buf), mut_view(*arena), unsafe { (*r).init_flag_v }, u8_ty_v, is_arg);
                    let lstart = unsafe { (*r).leaf_start };
                    let lend = lstart + (unsafe { (*r).leaf_count });
                    let mut li: usize = lstart;
                    while li < lend {
                        let lf = unsafe { drop_sub_leaf_at(sdf.leaves, li) };
                        drop_stmt_buf_push_view_flag(mut_view(buf), mut_view(*arena), unsafe { (*lf).flag_local_v }, u8_ty_v, is_arg);
                        li = li + 1;
                    }
                    ri = ri + 1;
                }
            }
            let mut j: usize = 0;
            while j < old_count {
                let stmt = unsafe { mir_stmt_at((*bb0).stmts, j) };
                unsafe {
                    drop_stmt_buf_push_copy(mut_view(buf), mut_view(*arena), view(*stmt));
                }
                j = j + 1;
            }
            unsafe {
                (*bb0).stmts = buf.stmts;
                (*bb0).stmt_count = buf.count;
                (*bb0).stmt_cap = buf.cap;
            }
        }

        // 3. A call that writes a flagged local arms its flag at the start of its return block.
        let bb_count = body.bb_count;
        let call_inits_bytes = (bb_count + 1) << 2;
        let call_preds = arena_alloc_raw(mut_view(*arena), call_inits_bytes, align_of<u32>()) as *mut u32;
        i = 0;
        while i <= bb_count {
            unsafe {
                *(((call_preds as usize) + (i << 2)) as *mut u32) = 0u32;
            }
            i = i + 1;
        }
        i = 0;
        while i < bb_count {
            let bb = unsafe { mir_bb_at(body.bbs, i) };
            let term_kind = unsafe { (*bb).terminator.kind };
            if term_kind == MIR_TERM_CALL {
                let dest_v = unsafe { (*bb).terminator.destination.local.v };
                let dest_pc = unsafe { (*bb).terminator.destination.proj_count };
                let has_vdf = if vdf.count > 0 {
                    if dest_pc == 0 {
                        drop_vdf_has_local(view(vdf), dest_v)
                    } else {
                        (unsafe { drop_place_view_key_len(view(*body), view(*thir), view((*bb).terminator.destination)) }) > 0
                    }
                } else {
                    false
                };
                if drop_flag_of(view(df), dest_v) != 0u32 || has_vdf || drop_sdf_has_local(view(sdf), dest_v) {
                    let call_target = (unsafe { (*bb).terminator.call_target.v }) as usize;
                    if call_target < bb_count {
                        unsafe {
                            *(((call_preds as usize) + (call_target << 2)) as *mut u32) = (i + 1) as u32;
                        }
                    }
                }
            }
            i = i + 1;
        }

        // 4. Flag maintenance inside every original block.
        i = 0;
        while i < bb_count {
            let call_pred_plus1 = unsafe { *(((call_preds as usize) + (i << 2)) as *mut u32) };
            drop_rewrite_block(mut_view(*body), view(*thir), hir, db, str_in, cache, view(df), view(vdf), view(sdf), i, call_pred_plus1, mut_view(*arena));
            i = i + 1;
        }
    }

    // 5. Expand drop terminators until none with a known type remains; only blocks created by
    //    pass k (`start_bb .. current_count`) can contain newly-introduced `drop` terminators.
    let mut start_bb: usize = 0;
    let mut changed = true;
    while changed {
        changed = false;
        let current_count = body.bb_count;
        i = start_bb;
        while i < current_count {
            if drop_expand_block(mut_view(*body), mut_view(*thir), hir, db, str_in, view(vdf), view(sdf), mut_view(*arena), i) {
                changed = true;
            }
            i = i + 1;
        }
        start_bb = current_count;
    }

    // 6. In-place locals of a lowered `async fn` move into their state field (ADR-0050).
    drop_coalesce_inplace(mut_view(*body), mut_view(*arena));
}
