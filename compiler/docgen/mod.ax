pub fn doc_deprecation_none() -> DocDeprecation {
    DocDeprecation {
        is_deprecated: false,
        since: ux2_sv_empty(),
        note: ux2_sv_empty(),
        replacement: ux2_sv_empty(),
    }
}

pub fn doc_param_contract_empty() -> DocParamContract {
    DocParamContract {
        name: ux2_sv_empty(),
        ty_display: ux2_sv_empty(),
        passing_mode: DOC_PASS_COPY,
        has_lifetime_bound: false,
        lifetime_bound: ux2_sv_empty(),
    }
}

pub fn doc_trait_sig_empty() -> DocTraitSig {
    DocTraitSig {
        is_trait: false,
        object_safety: DOC_OBJ_SAFE,
        reason_0: ux2_sv_empty(),
        reason_count: 0usize,
        required_0: ux2_sv_empty(),
        required_count: 0usize,
        provided_0: ux2_sv_empty(),
        provided_count: 0usize,
    }
}

pub fn doc_sem_key(ns: u8, mod_path: StrView, name: StrView, sig: StrView) -> SemanticKey {
    semantic_key_new(ux2_sv("metrics"), mod_path, ns, 0u32, name, sig)
}

pub fn doc_link_empty() -> DocLink {
    DocLink {
        raw_target: ux2_sv_empty(),
        resolved_key: doc_sem_key(ITEM_NS_TYPE, ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty()),
        resolved_href: ux2_sv_empty(),
        file_id: 0u32,
        span_start: 0u32,
        span_end: 0u32,
        is_resolved: false,
        has_legacy_colon_colon: false,
    }
}

