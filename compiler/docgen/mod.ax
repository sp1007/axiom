// ============================================================================
// 1. Constants & Core Model Types (`SPEC-104 §§2..4`, `AXS-DOC-001..012`)
// ============================================================================

pub const DOC_SCHEMA_VERSION: u32 = 1u32

// Documented item kinds ordered by deterministic `kind_ordinal` (`AXS-DOC-010`)
pub const DOC_KIND_MODULE: u8 = 0u8
pub const DOC_KIND_STRUCT: u8 = 1u8
pub const DOC_KIND_ENUM: u8 = 2u8
pub const DOC_KIND_TRAIT: u8 = 3u8
pub const DOC_KIND_FN: u8 = 4u8
pub const DOC_KIND_TYPE_ALIAS: u8 = 5u8
pub const DOC_KIND_CONST: u8 = 6u8

// Visibility levels (`SPEC-104 §2.2`)
pub const DOC_VIS_PUB: u8 = 0u8
pub const DOC_VIS_PUB_PACKAGE: u8 = 1u8
pub const DOC_VIS_PRIVATE: u8 = 2u8

// Parameter passing modes (`AXS-DOC-003`)
pub const DOC_PASS_MOVE: u8 = 0u8
pub const DOC_PASS_COPY: u8 = 1u8
pub const DOC_PASS_VIEW: u8 = 2u8
pub const DOC_PASS_MUT_VIEW: u8 = 3u8

// Trait object safety (`AXS-DOC-003`)
pub const DOC_OBJ_SAFE: u8 = 0u8
pub const DOC_OBJ_NOT_SAFE: u8 = 1u8

// Doc-test execution modes (`AXS-DOC-051`)
pub const DOC_TEST_RUN: u8 = 0u8
pub const DOC_TEST_NO_RUN: u8 = 1u8
pub const DOC_TEST_COMPILE_FAIL: u8 = 2u8
pub const DOC_TEST_SHOULD_PANIC: u8 = 3u8
pub const DOC_TEST_IGNORE: u8 = 4u8

@derive(Copy)
pub struct DocDeprecation {
    pub is_deprecated: bool,
    pub since: StrView,
    pub note: StrView,
    pub replacement: StrView,
}

@derive(Copy)
pub struct DocParamContract {
    pub name: StrView,
    pub ty_display: StrView,
    pub passing_mode: u8,
    pub has_lifetime_bound: bool,
    pub lifetime_bound: StrView,
}

@derive(Copy)
pub struct DocTraitSig {
    pub is_trait: bool,
    pub object_safety: u8,
    pub reason_0: StrView,
    pub reason_count: usize,
    pub required_0: StrView,
    pub required_count: usize,
    pub provided_0: StrView,
    pub provided_count: usize,
}

@derive(Copy)
pub struct DocLink {
    pub raw_target: StrView,
    pub resolved_key: SemanticKey,
    pub resolved_href: StrView,
    pub file_id: u32,
    pub span_start: u32,
    pub span_end: u32,
    pub is_resolved: bool,
    pub has_legacy_colon_colon: bool,
}

