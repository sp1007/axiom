// =============================================================================
// 3. Triple Alias Normalization & Registry Lookup (`AXS-SDK-005`, `025`, `026`)
// =============================================================================

pub fn normalize_target_triple(input: StrView) -> StrView {
    let t = bld_sv_trim(input)
    if ux2_sv_eq(t, ux2_sv("x86_64-windows")) ||
        ux2_sv_eq(t, ux2_sv("x86_64-pc-windows")) ||
        ux2_sv_eq(t, ux2_sv("x86_64-windows-msvc")) ||
        ux2_sv_eq(t, ux2_sv("x86_64-pc-windows-msvc")) {
        return ux2_sv("x86_64-pc-windows-msvc")
    }
    if ux2_sv_eq(t, ux2_sv("x86_64-linux")) ||
        ux2_sv_eq(t, ux2_sv("x86_64-unknown-linux")) ||
        ux2_sv_eq(t, ux2_sv("x86_64-linux-gnu")) ||
        ux2_sv_eq(t, ux2_sv("x86_64-unknown-linux-gnu")) {
        return ux2_sv("x86_64-unknown-linux-gnu")
    }
    if ux2_sv_eq(t, ux2_sv("aarch64-linux")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-unknown-linux")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-linux-gnu")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-unknown-linux-gnu")) {
        return ux2_sv("aarch64-unknown-linux-gnu")
    }
    if ux2_sv_eq(t, ux2_sv("aarch64-macos")) ||
        ux2_sv_eq(t, ux2_sv("arm64-apple-darwin")) ||
        ux2_sv_eq(t, ux2_sv("arm64-macos")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-darwin")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-apple-darwin")) {
        return ux2_sv("aarch64-apple-darwin")
    }
    if ux2_sv_eq(t, ux2_sv("aarch64-windows")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-pc-windows")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-pc-windows-msvc")) {
        return ux2_sv("aarch64-pc-windows-msvc")
    }
    if ux2_sv_eq(t, ux2_sv("aarch64-android")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-unknown-linux-android")) ||
        ux2_sv_eq(t, ux2_sv("aarch64-linux-android")) {
        return ux2_sv("aarch64-linux-android")
    }
    if ux2_sv_eq(t, ux2_sv("wasm32")) ||
        ux2_sv_eq(t, ux2_sv("wasm32-wasi")) ||
        ux2_sv_eq(t, ux2_sv("wasm32-unknown-unknown")) ||
        ux2_sv_eq(t, ux2_sv("wasm32-unknown-wasi")) {
        return ux2_sv("wasm32-unknown-wasi")
    }
    if ux2_sv_eq(t, ux2_sv("riscv64-linux")) ||
        ux2_sv_eq(t, ux2_sv("riscv64-unknown-linux")) ||
        ux2_sv_eq(t, ux2_sv("riscv64-linux-gnu")) ||
        ux2_sv_eq(t, ux2_sv("riscv64-unknown-linux-gnu")) {
        return ux2_sv("riscv64-unknown-linux-gnu")
    }
    t
}

pub fn toolchain_registry_lookup(
    query: StrView,
    out_desc: mut_view<TargetDescriptor>,
    sink: mut_view<DiagSink>
) -> bool {
    let norm = normalize_target_triple(query)
    if ux2_sv_eq(norm, ux2_sv("x86_64-pc-windows-msvc")) {
        *out_desc = target_desc_x86_64_windows()
        return true
    }
    if ux2_sv_eq(norm, ux2_sv("x86_64-unknown-linux-gnu")) {
        *out_desc = target_desc_x86_64_linux()
        return true
    }
    if ux2_sv_eq(norm, ux2_sv("aarch64-unknown-linux-gnu")) {
        *out_desc = target_desc_aarch64_linux()
        return true
    }
    if ux2_sv_eq(norm, ux2_sv("aarch64-apple-darwin")) {
        *out_desc = target_desc_aarch64_macos()
        return true
    }
    if ux2_sv_eq(norm, ux2_sv("aarch64-pc-windows-msvc")) {
        *out_desc = target_desc_aarch64_windows()
        return true
    }
    if ux2_sv_eq(norm, ux2_sv("aarch64-linux-android")) {
        *out_desc = target_desc_aarch64_android()
        return true
    }
    if ux2_sv_eq(norm, ux2_sv("wasm32-unknown-wasi")) {
        *out_desc = target_desc_wasm32()
        return true
    }
    if ux2_sv_eq(norm, ux2_sv("riscv64-unknown-linux-gnu")) {
        *out_desc = target_desc_riscv64_linux()
        return true
    }

    *out_desc = target_descriptor_empty()
    report_toolchain_diag_1(
        mut_view(*sink),
        AX_SDK_TOOLCHAIN_NOT_FOUND,
        "requested target triple or architecture was not found in AXTOOLCHAIN registry",
        "target",
        query
    )
    false
}

pub fn verify_target_compatibility(
    desc: view<TargetDescriptor>,
    expected_obj_fmt: StrView,
    expected_ptr_width: u32,
    sink: mut_view<DiagSink>
) -> bool {
    if !desc.is_valid {
        report_toolchain_diag_1(
            mut_view(*sink),
            AX_SDK_TOOLCHAIN_NOT_FOUND,
            "cannot verify compatibility for invalid target descriptor",
            "triple",
            desc.triple
        )
        return false
    }

    let obj_ok = ux2_sv_eq(desc.object_format, expected_obj_fmt)
    let ptr_ok = desc.pointer_width == expected_ptr_width

    if !obj_ok || !ptr_ok {
        report_toolchain_diag_2(
            mut_view(*sink),
            AX_SDK_TOOLCHAIN_INCOMPATIBLE,
            "selected toolchain components disagree on pointer width, endianness, or ABI format",
            "target",
            desc.triple,
            "expected_format",
            expected_obj_fmt
        )
        return false
    }
    true
}

// =============================================================================
// 4. Domain-Separated `ToolchainFingerprint` Calculation & Verification (`AXS-SDK-036`)
// =============================================================================

pub fn compute_toolchain_fingerprint(
    toolchain_id: StrView,
    version: StrView,
    compiler_binary_hash: Digest256,
    descriptor_bytes: StrView
) -> Digest256 {
    let mut d = digest256_domain_init(ux2_sv("AXIOM_TOOLCHAIN_FINGERPRINT_V1\0"))
    d = digest256_mix_sv(d, toolchain_id)
    d = digest256_mix_sv(d, version)
    d = digest256_combine(d, compiler_binary_hash)
    d = digest256_mix_sv(d, descriptor_bytes)
    d
}

pub fn verify_toolchain_fingerprint(
    computed: Digest256,
    expected: Digest256,
    toolchain_id: StrView,
    sink: mut_view<DiagSink>
) -> bool {
    if digest256_eq(computed, expected) {
        return true
    }
    report_toolchain_diag_2(
        mut_view(*sink),
        AX_SDK_TOOLCHAIN_FINGERPRINT_MISMATCH,
        "computed ToolchainFingerprint does not match expected fingerprint or axiom.lock",
        "toolchain_id",
        toolchain_id,
        "status",
        ux2_sv("mismatch")
    )
    false
}
