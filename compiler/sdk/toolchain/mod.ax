// Canonical AXTOOLCHAIN Target, ABI & Object-Pipeline Registry
// (`compiler/sdk/toolchain/mod.ax`, T875 / E20.6).
//
// Implements SPEC-116 §§3, 4 (`AXS-SDK-025`..`AXS-SDK-034`, `AXS-SDK-036`,
// `AXS-SDK-038`..`AXS-SDK-042`, `INV-SDK-001`, `REQ-ECO-8736`, `REQ-PKG-022`).

module compiler.sdk.toolchain

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

