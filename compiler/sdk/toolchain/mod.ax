// =============================================================================
// 1. Toolchain Diagnostic Codes & Structured Helpers (`AXS-SDK-025`..`034`)
// =============================================================================

pub const AX_SDK_TOOLCHAIN_NOT_FOUND: u32 = 247u32
pub const AX_SDK_TOOLCHAIN_INCOMPATIBLE: u32 = 248u32
pub const AX_SDK_TOOLCHAIN_FINGERPRINT_MISMATCH: u32 = 249u32

pub fn toolchain_diag_code_name(code_raw: u32) -> StrView {
    if code_raw == AX_SDK_TOOLCHAIN_NOT_FOUND {
        return ux2_sv("AX_SDK_TOOLCHAIN_NOT_FOUND")
    }
    if code_raw == AX_SDK_TOOLCHAIN_INCOMPATIBLE {
        return ux2_sv("AX_SDK_TOOLCHAIN_INCOMPATIBLE")
    }
    if code_raw == AX_SDK_TOOLCHAIN_FINGERPRINT_MISMATCH {
        return ux2_sv("AX_SDK_TOOLCHAIN_FINGERPRINT_MISMATCH")
    }
    ux2_sv("AX_SDK_TOOLCHAIN_UNKNOWN")
}

fn make_str_entry(key: StrView, val: StrView) -> DiagDataEntry {
    DiagDataEntry {
        key: key,
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: val,
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0usize,
        },
    }
}

pub fn report_toolchain_diag_1(
    sink: mut_view<DiagSink>,
    code_raw: u32,
    msg: str,
    k1: str,
    v1: StrView
) {
    let mut d = diag_new(diag_code(code_raw), span_none(), ux2_sv(msg))
    let mut entries: [1]DiagDataEntry = [make_str_entry(ux2_sv(k1), v1)]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 1usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_toolchain_diag_2(
    sink: mut_view<DiagSink>,
    code_raw: u32,
    msg: str,
    k1: str,
    v1: StrView,
    k2: str,
    v2: StrView
) {
    let mut d = diag_new(diag_code(code_raw), span_none(), ux2_sv(msg))
    let mut entries: [2]DiagDataEntry = [
        make_str_entry(ux2_sv(k1), v1),
        make_str_entry(ux2_sv(k2), v2),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 2usize
    diag_sink_report(mut_view(*sink), view(d))
}

// =============================================================================
// 2. `TargetDescriptor` Definition Across 8 Tier-1/Tier-2 Targets (`AXS-SDK-026`)
// =============================================================================

pub struct TargetDescriptor {
    pub triple: StrView,
    pub tier: u8,
    pub architecture: StrView,
    pub vendor: StrView,
    pub os: StrView,
    pub abi: StrView,
    pub endianness: StrView,
    pub pointer_width: u32,
    pub data_model: StrView,
    pub calling_convention: StrView,
    pub simd_abi: StrView,
    pub float_abi: StrView,
    pub page_size: u32,
    pub object_format: StrView,
    pub executable_format: StrView,
    pub linker_engine: StrView,
    pub unwind_format: StrView,
    pub stack_alignment: u32,
    pub red_zone_bytes: u32,
    pub shadow_space_bytes: u32,
    pub default_sdk_name: StrView,
    pub is_valid: bool,
}

pub fn target_descriptor_empty() -> TargetDescriptor {
    let e = ux2_sv_empty()
    TargetDescriptor {
        triple: e,
        tier: 0u8,
        architecture: e,
        vendor: e,
        os: e,
        abi: e,
        endianness: e,
        pointer_width: 0u32,
        data_model: e,
        calling_convention: e,
        simd_abi: e,
        float_abi: e,
        page_size: 0u32,
        object_format: e,
        executable_format: e,
        linker_engine: e,
        unwind_format: e,
        stack_alignment: 0u32,
        red_zone_bytes: 0u32,
        shadow_space_bytes: 0u32,
        default_sdk_name: e,
        is_valid: false,
    }
}

// Tier-1 Target 1: x86_64-pc-windows-msvc (LLP64, COFF/PE64, win64)
pub fn target_desc_x86_64_windows() -> TargetDescriptor {
    TargetDescriptor {
        triple: ux2_sv("x86_64-pc-windows-msvc"),
        tier: 1u8,
        architecture: ux2_sv("x86_64"),
        vendor: ux2_sv("pc"),
        os: ux2_sv("windows"),
        abi: ux2_sv("msvc"),
        endianness: ux2_sv("little"),
        pointer_width: 64u32,
        data_model: ux2_sv("LLP64"),
        calling_convention: ux2_sv("win64"),
        simd_abi: ux2_sv("sse2"),
        float_abi: ux2_sv("hard_float"),
        page_size: 4096u32,
        object_format: ux2_sv("coff"),
        executable_format: ux2_sv("pe64"),
        linker_engine: ux2_sv("axiom_native"),
        unwind_format: ux2_sv("windows_seh"),
        stack_alignment: 16u32,
        red_zone_bytes: 0u32,
        shadow_space_bytes: 32u32,
        default_sdk_name: ux2_sv("windows-x86_64-10.0.22621"),
        is_valid: true,
    }
}

