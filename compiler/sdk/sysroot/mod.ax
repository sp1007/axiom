// Declarative `.axsdk` Sysroot Loader, SdkFingerprint Verifier,
// C-Free Platform Import/CRT Resolver & OS API Availability Gating
// (`compiler/sdk/sysroot/mod.ax`, T875 / E20.6).
//
// Implements SPEC-116 §§1, 2, 4 (`AXS-SDK-001`..`AXS-SDK-024`, `AXS-SDK-035`,
// `AXS-SDK-037`, `AXS-SDK-039`..`AXS-SDK-042`, `INV-SDK-001`, `REQ-ECO-8736`, `REQ-PKG-022`).

module compiler.sdk.sysroot

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

