// Session-level parser integration: wires `compiler.lexer.session`, `compiler.syntax.parse`, and
// `compiler.syntax.ast` together over `CompilerSession` so a file can be registered, tokenized, parsed into an AST,
// and rendered in canonical `inspect --emit=ast` format alongside human or JSON diagnostics.
module compiler.parser.session

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.id.FileId
use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_new
use compiler.diag.format.ax_diag_render_human
use compiler.diag.json.ax_diag_render_json
use compiler.kernel_source_diag.session.CompilerSession
use compiler.kernel_source_diag.session.session_error_count
use compiler.lex.token.Token
use compiler.lex.token.Comment
use compiler.lex.token.LexResult
use compiler.lex.scanner.ax_lex_result_free
use compiler.lexer.session.session_lex_file
use compiler.lexer.session.session_lex_virtual_file
use compiler.syntax.ast.Ast
use compiler.syntax.ast.ParseResult
use compiler.syntax.ast.ax_ast_render
use compiler.syntax.parse.ax_parse

// Parses an already-tokenized stream using the session's `DiagSink` and `StrInterner`, allocating AST nodes in
// `parse_arena`.
pub fn session_parse_tokens(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    tokens: *mut Token,
    token_count: usize
) -> ParseResult {
    ax_parse(
        parse_arena,
        tokens,
        token_count,
        mut_view(sess.diag_sink),
        mut_view(sess.interner)
    )
}

// Tokenizes and parses an already-registered source file `fid` in `sess`, allocating AST nodes in `parse_arena`.
pub fn session_parse_file(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    fid: FileId
) -> ParseResult {
    let mut lex_res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    session_lex_file(mut_view(*sess), FileId { v: fid.v }, mut_view(lex_res));
    let parse_res = ax_parse(
        parse_arena,
        lex_res.tokens,
        lex_res.token_count,
        mut_view(sess.diag_sink),
        mut_view(sess.interner)
    );
    ax_lex_result_free(mut_view(lex_res));
    parse_res
}

// Registers a virtual source file `(path, text)` in `sess`, tokenizes and parses it into `parse_arena`, and stores
// the resulting `FileId` in `out_fid`.
pub fn session_parse_virtual_file(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    path: StrView,
    text: StrView,
    out_fid: mut_view<FileId>
) -> ParseResult {
    let mut lex_res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let fid = session_lex_virtual_file(mut_view(*sess), path, text, mut_view(lex_res));
    out_fid.v = fid.v;
    let parse_res = ax_parse(
        parse_arena,
        lex_res.tokens,
        lex_res.token_count,
        mut_view(sess.diag_sink),
        mut_view(sess.interner)
    );
    ax_lex_result_free(mut_view(lex_res));
    parse_res
}

// Renders `ast` into a new `DiagBuffer` in canonical `inspect --emit=ast` S-expression format.
pub fn session_render_ast(
    sess: view<CompilerSession>,
    ast: view<Ast>,
    filter_file: FileId
) -> DiagBuffer {
    let mut buf = diag_buf_new();
    ax_ast_render(ast, view(sess.interner), FileId { v: filter_file.v }, mut_view(buf));
    buf
}

// Renders `ast` into an existing `DiagBuffer` in canonical `inspect --emit=ast` S-expression format.
pub fn session_render_ast_into(
    sess: view<CompilerSession>,
    ast: view<Ast>,
    filter_file: FileId,
    out: mut_view<DiagBuffer>
) {
    ax_ast_render(ast, view(sess.interner), FileId { v: filter_file.v }, out);
}

// Registers `(path, text)` in `sess`, lexes and parses it into `parse_arena`, renders the AST S-expression into
// `out_ast` and human-readable diagnostics into `out_diags`, and returns the total error count.
pub fn session_parse_and_render_human(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    path: StrView,
    text: StrView,
    out_ast: mut_view<DiagBuffer>,
    out_diags: mut_view<DiagBuffer>
) -> usize {
    let mut fid = FileId { v: 0u32 };
    let parse_res = session_parse_virtual_file(
        mut_view(*sess),
        parse_arena,
        path,
        text,
        mut_view(fid)
    );
    ax_ast_render(view(parse_res.ast), view(sess.interner), FileId { v: fid.v }, out_ast);
    ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), out_diags);
    session_error_count(view(*sess))
}

// Registers `(path, text)` in `sess`, lexes and parses it into `parse_arena`, renders the AST S-expression into
// `out_ast` and JSON diagnostics into `out_json`, and returns the total error count.
pub fn session_parse_and_render_json(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    path: StrView,
    text: StrView,
    out_ast: mut_view<DiagBuffer>,
    out_json: mut_view<DiagBuffer>
) -> usize {
    let mut fid = FileId { v: 0u32 };
    let parse_res = session_parse_virtual_file(
        mut_view(*sess),
        parse_arena,
        path,
        text,
        mut_view(fid)
    );
    ax_ast_render(view(parse_res.ast), view(sess.interner), FileId { v: fid.v }, out_ast);
    ax_diag_render_json(view(sess.diag_sink), view(sess.source_db), out_json);
    session_error_count(view(*sess))
}
