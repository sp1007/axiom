pub const TEST_RUNNER_SCHEMA_VERSION: u32 = 1u32

// Surface syntax forms (`AXS-TST-002 §1`)
pub const TEST_FORM_BLOCK: u8 = 0u8     // `test "name" { ... }`
pub const TEST_FORM_ATTR_FN: u8 = 1u8   // `@test fn test_name() { ... }`

// Debug emission tiers (`AXS-TST-031`, `REQ-TOOL-010`, `REQ-TOOL-011`)
pub const DEBUG_TIER_NONE: u8 = 0u8
pub const DEBUG_TIER_LINE_TABLES_O0: u8 = 1u8
pub const DEBUG_TIER_FULL_DWARF: u8 = 2u8

// Debug variable storage classifications (`AXS-TST-030`, `AXS-TST-033`, `REQ-TOOL-005`)
pub const DBG_STORAGE_REGISTER: u8 = 0u8
pub const DBG_STORAGE_STACK_OFFSET: u8 = 1u8
pub const DBG_STORAGE_CONSTANT_VALUE: u8 = 2u8
pub const DBG_STORAGE_SCALARIZED_PIECES: u8 = 3u8
pub const DBG_STORAGE_OPTIMIZED_OUT: u8 = 4u8

@derive(Copy)
pub enum TestOutcomeKind {
    Passed,
    Failed,
    PanickedUnexpectedly,
    ExpectedPanicMissing,
    DifferentialMismatch,
    TimedOut,
    Ignored,
}

@derive(Copy)
pub struct DiscoveredTestCase {
    pub test_id: Fingerprint128,
    pub module_path: StrView,
    pub name: StrView,
    pub surface_form: u8,
    pub span: Span,
    pub should_panic: bool,
    pub expected_panic_substr: StrView,
    pub is_ignored: bool,
    pub ignore_reason: StrView,
    pub timeout_ms: u64,
    pub is_serial: bool,
    pub has_pinned_seed: bool,
    pub pinned_seed: u64,
    pub sim_panics: bool,
    pub sim_panic_msg: StrView,
    pub sim_assertion_failed: bool,
    pub sim_timed_out: bool,
    pub sim_diff_mismatch: bool,
    pub sim_interp_exit: i32,
    pub sim_native_exit: i32,
    pub sim_duration_us: u64,
    pub sim_stdout: StrView,
    pub sim_stderr: StrView,
}

@derive(Copy)
pub struct TestCaseResult {
    pub test_id: Fingerprint128,
    pub module_path: StrView,
    pub name: StrView,
    pub span_start: u32,
    pub outcome: TestOutcomeKind,
    pub duration_us: u64,
    pub seed: u64,
    pub temp_dir_cleaned: bool,
    pub interp_exit_code: i32,
    pub native_exit_code: i32,
    pub stdout_text: StrView,
    pub stderr_text: StrView,
    pub failure_reason: StrView,
    pub repro_command: StrView,
}

