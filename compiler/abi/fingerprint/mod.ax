// Axiom Compiler — AbiFingerprint, SemanticFingerprint & ApiFingerprint Engine (compiler/abi/fingerprint/mod.ax)
// Implements SPEC-114 §3 (AXS-ABI-020..024; REQ-PKG-022, REQ-PKG-024, INV-SABI-002).

module compiler.abi.fingerprint

use compiler.kernel.hash.ax_hash_bytes
use compiler.kernel.hash.ax_hash_u64
use compiler.kernel.hash.ax_hash_combine
use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_sv
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_empty
use compiler.diag.ux2.ux2_sv_eq

use compiler.abi.stability.ABI_TIER_INTERNAL
use compiler.abi.stability.ABI_TIER_PACKAGE
use compiler.abi.stability.ABI_TIER_STABLE
use compiler.abi.stability.CALL_CONV_C
use compiler.abi.stability.CALL_CONV_WIN64
use compiler.abi.stability.CALL_CONV_SYSV64
use compiler.abi.stability.CALL_CONV_AAPCS64

// =============================================================================
// 1. 128-Bit Cryptographic Fingerprint Types (AXS-ABI-020)
// =============================================================================

@derive(Copy)
pub struct ApiFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn api_fingerprint_zero() -> ApiFingerprint {
    ApiFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn api_fingerprint_eq(a: ApiFingerprint, b: ApiFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@derive(Copy)
pub struct SemanticFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn semantic_fingerprint_zero() -> SemanticFingerprint {
    SemanticFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn semantic_fingerprint_eq(a: SemanticFingerprint, b: SemanticFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@derive(Copy)
pub struct AbiFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn abi_fingerprint_zero() -> AbiFingerprint {
    AbiFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn abi_fingerprint_eq(a: AbiFingerprint, b: AbiFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@derive(Copy)
pub struct ModuleFingerprints {
    pub api_fingerprint: ApiFingerprint,
    pub semantic_fingerprint: SemanticFingerprint,
    pub abi_fingerprint: AbiFingerprint,
}

// Hexadecimal formatting helper for 128-bit digests
const HEX_DIGITS: [16]u8 = [
    48u8, 49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8,
    56u8, 57u8, 97u8, 98u8, 99u8, 100u8, 101u8, 102u8
]

fn push_u64_hex16(buf: mut_view<DiagBuffer>, v: u64) {
    let mut i: i32 = 60
    while i >= 0 {
        let shift: u32 = i as u32
        let nibble: usize = ((v >> shift) & 0x0Fu64) as usize
        diag_buf_push_byte(mut_view(*buf), HEX_DIGITS[nibble])
        i = i - 4
    }
}

pub fn push_fingerprint_hex(lo: u64, hi: u64, buf: mut_view<DiagBuffer>) {
    push_u64_hex16(mut_view(*buf), hi)
    push_u64_hex16(mut_view(*buf), lo)
}

// =============================================================================
// 2. Input Data Models for Fingerprinting (AXS-ABI-021..023)
// =============================================================================

pub const ITEM_KIND_FN: u8 = 1u8
pub const ITEM_KIND_STRUCT: u8 = 2u8
pub const ITEM_KIND_ENUM: u8 = 3u8
pub const ITEM_KIND_CONST: u8 = 4u8

@derive(Copy)
pub struct ApiItemInput {
    pub item_kind: u8,
    pub name: StrView,
    pub module_path: StrView,
    pub is_pub: bool,
    pub fn_param_count: u32,
    pub fn_param_types_hash: u64,
    pub fn_ret_type_name: StrView,
    pub struct_field_count: u32,
    pub struct_fields_hash: u64,
    pub enum_variant_count: u32,
    pub enum_variants_hash: u64,
}

pub fn api_item_input_default(kind: u8, name: StrView, mod_path: StrView, is_pub: bool) -> ApiItemInput {
    ApiItemInput {
        item_kind: kind,
        name: name,
        module_path: mod_path,
        is_pub: is_pub,
        fn_param_count: 0u32,
        fn_param_types_hash: 0u64,
        fn_ret_type_name: ux2_sv_empty(),
        struct_field_count: 0u32,
        struct_fields_hash: 0u64,
        enum_variant_count: 0u32,
        enum_variants_hash: 0u64,
    }
}

@derive(Copy)
pub struct SemanticItemInput {
    pub name: StrView,
    pub is_inline: bool,
    pub inline_mir_body_hash: u64,
    pub is_comptime: bool,
    pub comptime_mir_body_hash: u64,
    pub const_value_hash: u64,
    pub capability_contract_hash: u64,
    pub effect_flags: u32,
}

pub fn semantic_item_input_default(name: StrView) -> SemanticItemInput {
    SemanticItemInput {
        name: name,
        is_inline: false,
        inline_mir_body_hash: 0u64,
        is_comptime: false,
        comptime_mir_body_hash: 0u64,
        const_value_hash: 0u64,
        capability_contract_hash: 0u64,
        effect_flags: 0u32,
    }
}

@derive(Copy)
pub struct TargetPlatformDesc {
    pub arch_name: StrView,
    pub os_name: StrView,
    pub pointer_width: u8,
    pub is_little_endian: bool,
    pub cpu_features_mask: u64,
}

pub fn target_platform_win64() -> TargetPlatformDesc {
    TargetPlatformDesc {
        arch_name: ux2_sv("x86_64"),
        os_name: ux2_sv("windows"),
        pointer_width: 64u8,
        is_little_endian: true,
        cpu_features_mask: 0x0000000000000001u64,
    }
}

pub fn target_platform_sysv64() -> TargetPlatformDesc {
    TargetPlatformDesc {
        arch_name: ux2_sv("x86_64"),
        os_name: ux2_sv("linux"),
        pointer_width: 64u8,
        is_little_endian: true,
        cpu_features_mask: 0x0000000000000001u64,
    }
}

@derive(Copy)
pub struct AbiLayoutItemInput {
    pub name: StrView,
    pub module_path: StrView,
    pub is_abi_stable: bool,
    pub is_opaque: bool,
    pub call_conv: u8,
    pub symbol_version: StrView,
    pub is_default_version: bool,
    pub size: u32,
    pub align: u32,
    pub field_offsets_hash: u64,
    pub is_extensible: bool,
    pub has_abi_header: bool,
    pub header_version: u32,
    pub header_struct_size: u32,
    pub private_body_hash: u64,
}

pub fn abi_layout_item_input_default(name: StrView, mod_path: StrView, is_stable: bool) -> AbiLayoutItemInput {
    AbiLayoutItemInput {
        name: name,
        module_path: mod_path,
        is_abi_stable: is_stable,
        is_opaque: false,
        call_conv: CALL_CONV_WIN64,
        symbol_version: ux2_sv("1.0"),
        is_default_version: true,
        size: 0u32,
        align: 1u32,
        field_offsets_hash: 0u64,
        is_extensible: false,
        has_abi_header: false,
        header_version: 1u32,
        header_struct_size: 0u32,
        private_body_hash: 0u64,
    }
}

// =============================================================================
// 3. Independent Fingerprint Calculators (AXS-ABI-020..023, INV-SABI-002)
// =============================================================================

// Helper for hashing StrView into a 64-bit accumulator
fn hash_str_view(acc: u64, sv: StrView) -> u64 {
    if sv.len == 0usize || (sv.ptr as usize) == 0usize {
        return ax_hash_combine(acc, 0u64)
    }
    let h = ax_hash_bytes(sv.ptr, sv.len)
    ax_hash_combine(acc, h)
}

// ApiFingerprint: Domain "AXIOM-API-v1\0" (AXS-ABI-021)
// Invariant under private bodies, formatting, comments, and optimization flags.
pub fn compute_api_fingerprint(
    items: view<[8]ApiItemInput>,
    count: usize
) -> ApiFingerprint {
    let tag = ux2_sv("AXIOM-API-v1\0")
    let base = ax_hash_bytes(tag.ptr, tag.len)
    let mut lo = ax_hash_combine(base, 0x9e3779b97f4a7c15u64)
    let mut hi = ax_hash_combine(base, 0xbf58476d1ce4e5b9u64)

    let mut i: usize = 0usize
    while i < count && i < 8usize {
        let it = (*items)[i]
        // ApiFingerprint hashes ONLY public items (AXS-ABI-021 §2)
        if it.is_pub {
            lo = ax_hash_combine(lo, it.item_kind as u64)
            lo = hash_str_view(lo, it.name)
            lo = hash_str_view(lo, it.module_path)

            if it.item_kind == ITEM_KIND_FN {
                lo = ax_hash_combine(lo, it.fn_param_count as u64)
                lo = ax_hash_combine(lo, it.fn_param_types_hash)
                hi = hash_str_view(hi, it.fn_ret_type_name)
            } else if it.item_kind == ITEM_KIND_STRUCT {
                lo = ax_hash_combine(lo, it.struct_field_count as u64)
                hi = ax_hash_combine(hi, it.struct_fields_hash)
            } else if it.item_kind == ITEM_KIND_ENUM {
                lo = ax_hash_combine(lo, it.enum_variant_count as u64)
                hi = ax_hash_combine(hi, it.enum_variants_hash)
            }
        }
        i = i + 1usize
    }

    ApiFingerprint { lo: lo, hi: hi }
}

// SemanticFingerprint: Domain "AXIOM-SEM-v1\0" (AXS-ABI-022)
// Begins with ApiFingerprint. Invariant under non-inlined function body edits.
// Changes when @inline bodies, comptime evaluation, or effect contracts change.
pub fn compute_semantic_fingerprint(
    api_fp: ApiFingerprint,
    sem_items: view<[8]SemanticItemInput>,
    count: usize
) -> SemanticFingerprint {
    let tag = ux2_sv("AXIOM-SEM-v1\0")
    let base = ax_hash_bytes(tag.ptr, tag.len)
    let mut lo = ax_hash_combine(base, api_fp.lo)
    let mut hi = ax_hash_combine(base, api_fp.hi)

    let mut i: usize = 0usize
    while i < count && i < 8usize {
        let s = (*sem_items)[i]
        lo = hash_str_view(lo, s.name)
        if s.is_inline {
            lo = ax_hash_combine(lo, s.inline_mir_body_hash)
        }
        if s.is_comptime {
            hi = ax_hash_combine(hi, s.comptime_mir_body_hash)
        }
        hi = ax_hash_combine(hi, s.const_value_hash)
        lo = ax_hash_combine(lo, s.capability_contract_hash)
        hi = ax_hash_combine(hi, s.effect_flags as u64)
        i = i + 1usize
    }

    SemanticFingerprint { lo: lo, hi: hi }
}

// AbiFingerprint: Domain "AXIOM-ABI-v1\0" (AXS-ABI-023)
// Incorporates Target, Calling Conventions, Physical Layouts, Extensible Headers, and Symbol Versions.
// Invariant under non-inlined bodies and invariant under private struct fields encapsulated behind @opaque handles!
pub fn compute_abi_fingerprint(
    target: view<TargetPlatformDesc>,
    abi_items: view<[8]AbiLayoutItemInput>,
    count: usize
) -> AbiFingerprint {
    let tag = ux2_sv("AXIOM-ABI-v1\0")
    let base = ax_hash_bytes(tag.ptr, tag.len)
    let mut lo = ax_hash_combine(base, 0x517cc1b727220a95u64)
    let mut hi = ax_hash_combine(base, 0x6c62272e07bb0142u64)

    // Mix target platform parameters
    lo = hash_str_view(lo, target.arch_name)
    hi = hash_str_view(hi, target.os_name)
    lo = ax_hash_combine(lo, target.pointer_width as u64)
    hi = ax_hash_combine(hi, target.cpu_features_mask)

    let mut i: usize = 0usize
    while i < count && i < 8usize {
        let it = (*abi_items)[i]
        // AbiFingerprint is computed for items participating in the ABI (AXS-ABI-023 §2)
        if it.is_abi_stable {
            lo = hash_str_view(lo, it.name)
            hi = hash_str_view(hi, it.module_path)
            lo = ax_hash_combine(lo, it.call_conv as u64)
            hi = hash_str_view(hi, it.symbol_version)
            lo = ax_hash_combine(lo, if it.is_default_version { 1u64 } else { 0u64 })

            // OPAQUE HANDLE ISOLATION GUARANTEE (AXS-ABI-013, AXS-ABI-023 §3, INV-SABI-001):
            // Outside consumers only see the pointer handle (*mut T). The internal fields, count,
            // and size of an @opaque struct are NEVER hashed into the public AbiFingerprint.
            if it.is_opaque {
                lo = ax_hash_combine(lo, 0x0FA9E0C100u64)
                hi = ax_hash_combine(hi, target.pointer_width as u64)
            } else {
                lo = ax_hash_combine(lo, it.size as u64)
                hi = ax_hash_combine(hi, it.align as u64)
                lo = ax_hash_combine(lo, it.field_offsets_hash)

                if it.is_extensible {
                    hi = ax_hash_combine(hi, if it.has_abi_header { 1u64 } else { 0u64 })
                    lo = ax_hash_combine(lo, it.header_version as u64)
                    hi = ax_hash_combine(hi, it.header_struct_size as u64)
                }
            }
        }
        i = i + 1usize
    }

    AbiFingerprint { lo: lo, hi: hi }
}

// Combined triple fingerprint computation helper
pub fn compute_module_fingerprints(
    target: view<TargetPlatformDesc>,
    api_items: view<[8]ApiItemInput>,
    api_count: usize,
    sem_items: view<[8]SemanticItemInput>,
    sem_count: usize,
    abi_items: view<[8]AbiLayoutItemInput>,
    abi_count: usize
) -> ModuleFingerprints {
    let api_fp = compute_api_fingerprint(api_items, api_count)
    let sem_fp = compute_semantic_fingerprint(api_fp, sem_items, sem_count)
    let abi_fp = compute_abi_fingerprint(target, abi_items, abi_count)
    ModuleFingerprints {
        api_fingerprint: api_fp,
        semantic_fingerprint: sem_fp,
        abi_fingerprint: abi_fp,
    }
}
