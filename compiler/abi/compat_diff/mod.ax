    pub ret_type_size: u32,
    pub ret_type_align: u32,
    pub capability_mask: u64,
    pub is_pure: bool,
    pub is_pub: bool,
}

pub fn interface_fn_desc_default(name: StrView, mod_path: StrView) -> InterfaceFnDesc {
    InterfaceFnDesc {
        name: name,
        module_path: mod_path,
        call_conv: CALL_CONV_WIN64,
        symbol_version: ux2_sv("1.0"),
        is_default_version: true,
        param_count: 0u32,
        param_types_hash: 0u64,
        ret_type_name: ux2_sv("u32"),
        ret_type_size: 4u32,
        ret_type_align: 4u32,
        capability_mask: 0u64,
        is_pure: false,
        is_pub: true,
    }
}

@derive(Copy)
pub struct InterfaceStructDesc {
