}

pub fn interface_enum_desc_default(name: StrView, mod_path: StrView) -> InterfaceEnumDesc {
    let dummy_var = stable_variant_desc_default(ux2_sv_empty(), 0u64)
    InterfaceEnumDesc {
        name: name,
        module_path: mod_path,
        repr_kind: 5u8, // STABLE_TYPE_U32
        is_non_exhaustive: false,
        is_pub: true,
        variant_count: 0u32,
        variants: [dummy_var; 16],
    }
}

@derive(Copy)
pub struct InterfaceDescriptor {
    pub package_name: StrView,
    pub module_path: StrView,
    pub target: TargetPlatformDesc,
    pub api_fingerprint: ApiFingerprint,
    pub semantic_fingerprint: SemanticFingerprint,
    pub abi_fingerprint: AbiFingerprint,
    pub impl_hash: u64,
    pub fn_count: usize,
    pub fns: [16]InterfaceFnDesc,
    pub struct_count: usize,
    pub structs: [16]InterfaceStructDesc,
    pub enum_count: usize,
    pub enums: [16]InterfaceEnumDesc,
    pub version_count: usize,
    pub versions: [16]SymbolVersionEntry,
}

pub fn interface_descriptor_empty() -> InterfaceDescriptor {
    let e = ux2_sv_empty()
    let dummy_fn = interface_fn_desc_default(e, e)
    let dummy_struct = interface_struct_desc_default(e, e)
    let dummy_enum = interface_enum_desc_default(e, e)
    let dummy_ver = symbol_version_entry_new(e, e, e, false)
    InterfaceDescriptor {
        package_name: e,
        module_path: e,
        target: target_platform_win64(),
        api_fingerprint: api_fingerprint_zero(),
        semantic_fingerprint: semantic_fingerprint_zero(),
        abi_fingerprint: abi_fingerprint_zero(),
        impl_hash: 0u64,
        fn_count: 0usize,
        fns: [dummy_fn; 16],
        struct_count: 0usize,
        structs: [dummy_struct; 16],
        enum_count: 0usize,
        enums: [dummy_enum; 16],
        version_count: 0usize,
        versions: [dummy_ver; 16],
    }
}

// =============================================================================
// 4. Binary & API Compatibility Diff Engine (AXS-ABI-040)
// =============================================================================

pub fn diff_interface_descriptors(
    old_desc: view<InterfaceDescriptor>,
    new_desc: view<InterfaceDescriptor>,
    res: mut_view<InterfaceDiffResult>
) {
    *res = interface_diff_result_empty()

    let api_eq = api_fingerprint_eq(old_desc.api_fingerprint, new_desc.api_fingerprint)
    let abi_eq = abi_fingerprint_eq(old_desc.abi_fingerprint, new_desc.abi_fingerprint)

    if api_eq && abi_eq {
        if old_desc.impl_hash == new_desc.impl_hash {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_IDENTICAL,
                SEVERITY_COMPATIBLE,
                old_desc.module_path,
                ux2_sv_empty(),
                0u64,
                0u64,
                ux2_sv("interface and implementation are identical")
            ))
            res.overall_class = COMPAT_CLASS_IDENTICAL
            res.status_name = ux2_sv("identical")
            return
        } else {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_IMPL_ONLY,
                SEVERITY_COMPATIBLE,
                old_desc.module_path,
                ux2_sv_empty(),
                old_desc.impl_hash,
                new_desc.impl_hash,
                ux2_sv("implementation changed; public API and ABI are identical")
            ))
            res.overall_class = COMPAT_CLASS_IMPL_ONLY
            res.status_name = ux2_sv("implementation-only")
            return
        }
    }

    // 1. Functions diff
    let mut i: usize = 0usize
    while i < old_desc.fn_count && i < 16usize {
        let f_old = old_desc.fns[i]
        let mut found = false
        let mut j: usize = 0usize
        while j < new_desc.fn_count && j < 16usize {
            let f_new = new_desc.fns[j]
            if ux2_sv_eq(f_old.name, f_new.name) && ux2_sv_eq(f_old.module_path, f_new.module_path) {
                found = true
                if f_old.call_conv != f_new.call_conv {
                    diff_result_push(mut_view(*res), item_diff_new(
                        DIFF_KIND_FN_CALL_CONV_CHANGED,
                        SEVERITY_MAJOR_BREAKING,
                        f_old.name,
                        ux2_sv("call_conv"),
                        f_old.call_conv as u64,
                        f_new.call_conv as u64,
                        ux2_sv("calling convention altered")
                    ))
                }
                if f_old.param_count != f_new.param_count {
                    diff_result_push(mut_view(*res), item_diff_new(
                        DIFF_KIND_FN_PARAM_COUNT_CHANGED,
                        SEVERITY_MAJOR_BREAKING,
                        f_old.name,
                        ux2_sv("param_count"),
                        f_old.param_count as u64,
                        f_new.param_count as u64,
                        ux2_sv("parameter count altered")
                    ))
                }
                if f_old.param_types_hash != f_new.param_types_hash {
                    diff_result_push(mut_view(*res), item_diff_new(
                        DIFF_KIND_FN_PARAM_TYPE_CHANGED,
                        SEVERITY_MAJOR_BREAKING,
                        f_old.name,
                        ux2_sv("param_types"),
                        f_old.param_types_hash,
                        f_new.param_types_hash,
                        ux2_sv("parameter types modified")
                    ))
                }
                if !ux2_sv_eq(f_old.ret_type_name, f_new.ret_type_name) || f_old.ret_type_size != f_new.ret_type_size {
                    diff_result_push(mut_view(*res), item_diff_new(
                        DIFF_KIND_FN_RET_TYPE_CHANGED,
                        SEVERITY_MAJOR_BREAKING,
                        f_old.name,
                        ux2_sv("ret_type"),
                        f_old.ret_type_size as u64,
                        f_new.ret_type_size as u64,
                        ux2_sv("return type modified")
                    ))
                }
                let tightened = (f_old.capability_mask & f_new.capability_mask) != f_new.capability_mask
                if tightened {
                    diff_result_push(mut_view(*res), item_diff_new(
                        DIFF_KIND_CAPABILITY_TIGHTENED,
                        SEVERITY_MAJOR_BREAKING,
                        f_old.name,
                        ux2_sv("capability"),
                        f_old.capability_mask,
                        f_new.capability_mask,
                        ux2_sv("capability requirement tightened")
                    ))
                } else if f_old.capability_mask != f_new.capability_mask {
                    diff_result_push(mut_view(*res), item_diff_new(
                        DIFF_KIND_CAPABILITY_RELAXED,
                        SEVERITY_MINOR_ADDITIVE,
                        f_old.name,
                        ux2_sv("capability"),
                        f_old.capability_mask,
                        f_new.capability_mask,
                        ux2_sv("capability requirement relaxed")
                    ))
                }
            }
            j = j + 1usize
        }

        if !found {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_FN_REMOVED,
                SEVERITY_MAJOR_BREAKING,
                f_old.name,
                ux2_sv_empty(),
                0u64,
                0u64,
                ux2_sv("exported function removed")
            ))
        }
        i = i + 1usize
    }

    let mut k: usize = 0usize
    while k < new_desc.fn_count && k < 16usize {
        let f_new = new_desc.fns[k]
        let mut found = false
        let mut m: usize = 0usize
        while m < old_desc.fn_count && m < 16usize {
            let f_old = old_desc.fns[m]
            if ux2_sv_eq(f_old.name, f_new.name) && ux2_sv_eq(f_old.module_path, f_new.module_path) {
                found = true
            }
            m = m + 1usize
        }
        if !found {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_FN_ADDED,
                SEVERITY_MINOR_ADDITIVE,
                f_new.name,
                ux2_sv_empty(),
                0u64,
                0u64,
                ux2_sv("new exported function added")
            ))
        }
        k = k + 1usize
    }

    // 2. Structs diff
    let mut si: usize = 0usize
    while si < old_desc.struct_count && si < 16usize {
        let s_old = old_desc.structs[si]
        let mut found = false
        let mut sj: usize = 0usize
        while sj < new_desc.struct_count && sj < 16usize {
            let s_new = new_desc.structs[sj]
            if ux2_sv_eq(s_old.name, s_new.name) && ux2_sv_eq(s_old.module_path, s_new.module_path) {
                found = true

                if !s_old.is_opaque {
                    let mut fi: usize = 0usize
                    while fi < (s_old.field_count as usize) && fi < 16usize {
                        let f_old = s_old.fields[fi]
                        let mut field_found = false
                        let mut fj: usize = 0usize
                        while fj < (s_new.field_count as usize) && fj < 16usize {
                            let f_new = s_new.fields[fj]
                            if ux2_sv_eq(f_old.name, f_new.name) {
                                field_found = true
                                if f_old.offset != f_new.offset {
                                    diff_result_push(mut_view(*res), item_diff_new(
                                        DIFF_KIND_STRUCT_FIELD_OFFSET_CHANGED,
                                        SEVERITY_MAJOR_BREAKING,
                                        s_old.name,
                                        f_old.name,
                                        f_old.offset as u64,
                                        f_new.offset as u64,
                                        ux2_sv("struct field offset altered")
                                    ))
                                }
                                if f_old.size != f_new.size || f_old.align != f_new.align {
                                    diff_result_push(mut_view(*res), item_diff_new(
                                        DIFF_KIND_STRUCT_SIZE_CHANGED,
                                        SEVERITY_MAJOR_BREAKING,
                                        s_old.name,
                                        f_old.name,
                                        f_old.size as u64,
                                        f_new.size as u64,
                                        ux2_sv("struct field size/align altered")
                                    ))
                                }
                            }
                            fj = fj + 1usize
                        }
                        if !field_found {
                            diff_result_push(mut_view(*res), item_diff_new(
                                DIFF_KIND_STRUCT_FIELD_REMOVED,
                                SEVERITY_MAJOR_BREAKING,
                                s_old.name,
                                f_old.name,
                                0u64,
                                0u64,
                                ux2_sv("struct field removed")
                            ))
                        }
                        fi = fi + 1usize
                    }

                    if s_new.field_count > s_old.field_count {
                        if s_old.is_extensible && s_new.is_extensible && s_new.has_abi_header && s_new.header_version > s_old.header_version {
                            diff_result_push(mut_view(*res), item_diff_new(
                                DIFF_KIND_STRUCT_EXTENSIBLE_FIELD_APPENDED,
                                SEVERITY_MINOR_ADDITIVE,
                                s_old.name,
                                ux2_sv("fields"),
                                s_old.field_count as u64,
                                s_new.field_count as u64,
                                ux2_sv("field appended to extensible struct with version bump")
                            ))
                        } else {
                            diff_result_push(mut_view(*res), item_diff_new(
                                DIFF_KIND_STRUCT_NON_EXTENSIBLE_FIELD_ADDED,
                                SEVERITY_MAJOR_BREAKING,
                                s_old.name,
                                ux2_sv("fields"),
                                s_old.field_count as u64,
                                s_new.field_count as u64,
                                ux2_sv("field added to non-extensible struct (alters size)")
                            ))
                        }
                    }

                    if s_old.align != s_new.align {
                        diff_result_push(mut_view(*res), item_diff_new(
                            DIFF_KIND_STRUCT_ALIGN_CHANGED,
                            SEVERITY_MAJOR_BREAKING,
                            s_old.name,
                            ux2_sv("align"),
                            s_old.align as u64,
                            s_new.align as u64,
                            ux2_sv("struct alignment modified")
                        ))
                    }

                    if !s_old.is_extensible && s_old.size != s_new.size {
                        diff_result_push(mut_view(*res), item_diff_new(
                            DIFF_KIND_STRUCT_SIZE_CHANGED,
                            SEVERITY_MAJOR_BREAKING,
                            s_old.name,
                            ux2_sv("size"),
                            s_old.size as u64,
                            s_new.size as u64,
                            ux2_sv("non-extensible struct size altered")
                        ))
                    }
                }
            }
            sj = sj + 1usize
        }

        if !found {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_STRUCT_REMOVED,
                SEVERITY_MAJOR_BREAKING,
                s_old.name,
                ux2_sv_empty(),
                0u64,
                0u64,
                ux2_sv("exported struct removed")
            ))
        }
        si = si + 1usize
    }

    let mut sk: usize = 0usize
    while sk < new_desc.struct_count && sk < 16usize {
        let s_new = new_desc.structs[sk]
        let mut found = false
        let mut sm: usize = 0usize
        while sm < old_desc.struct_count && sm < 16usize {
            let s_old = old_desc.structs[sm]
            if ux2_sv_eq(s_old.name, s_new.name) && ux2_sv_eq(s_old.module_path, s_new.module_path) {
                found = true
            }
            sm = sm + 1usize
        }
        if !found {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_STRUCT_ADDED,
                SEVERITY_MINOR_ADDITIVE,
                s_new.name,
                ux2_sv_empty(),
                0u64,
                0u64,
                ux2_sv("new exported struct added")
            ))
        }
        sk = sk + 1usize
    }

    // 3. Enums diff
    let mut ei: usize = 0usize
    while ei < old_desc.enum_count && ei < 16usize {
        let e_old = old_desc.enums[ei]
        let mut found = false
        let mut ej: usize = 0usize
        while ej < new_desc.enum_count && ej < 16usize {
            let e_new = new_desc.enums[ej]
            if ux2_sv_eq(e_old.name, e_new.name) && ux2_sv_eq(e_old.module_path, e_new.module_path) {
                found = true
                let mut vi: usize = 0usize
                while vi < (e_old.variant_count as usize) && vi < 16usize {
                    let v_old = e_old.variants[vi]
                    let mut var_found = false
                    let mut vj: usize = 0usize
                    while vj < (e_new.variant_count as usize) && vj < 16usize {
                        let v_new = e_new.variants[vj]
                        if ux2_sv_eq(v_old.name, v_new.name) {
                            var_found = true
                            if v_old.tag != v_new.tag {
                                diff_result_push(mut_view(*res), item_diff_new(
                                    DIFF_KIND_ENUM_DISCRIMINANT_CHANGED,
                                    SEVERITY_MAJOR_BREAKING,
                                    e_old.name,
                                    v_old.name,
                                    v_old.tag,
                                    v_new.tag,
                                    ux2_sv("enum discriminant tag value changed")
                                ))
                            }
                        }
                        vj = vj + 1usize
                    }
                    if !var_found {
                        diff_result_push(mut_view(*res), item_diff_new(
                            DIFF_KIND_ENUM_REMOVED,
                            SEVERITY_MAJOR_BREAKING,
                            e_old.name,
                            v_old.name,
                            0u64,
                            0u64,
                            ux2_sv("enum variant removed")
                        ))
                    }
                    vi = vi + 1usize
                }

                let mut vk: usize = 0usize
                while vk < (e_new.variant_count as usize) && vk < 16usize {
                    let v_new = e_new.variants[vk]
                    let mut var_found = false
                    let mut vm: usize = 0usize
                    while vm < (e_old.variant_count as usize) && vm < 16usize {
                        let v_old = e_old.variants[vm]
                        if ux2_sv_eq(v_old.name, v_new.name) {
                            var_found = true
                        }
                        vm = vm + 1usize
                    }
                    if !var_found {
                        if e_old.is_non_exhaustive {
                            diff_result_push(mut_view(*res), item_diff_new(
                                DIFF_KIND_ENUM_NON_EXHAUSTIVE_VARIANT_ADDED,
                                SEVERITY_MINOR_ADDITIVE,
                                e_old.name,
                                v_new.name,
                                0u64,
                                0u64,
                                ux2_sv("variant added to @non_exhaustive enum")
                            ))
                        } else {
                            diff_result_push(mut_view(*res), item_diff_new(
                                DIFF_KIND_ENUM_EXHAUSTIVE_VARIANT_ADDED,
                                SEVERITY_MAJOR_BREAKING,
                                e_old.name,
                                v_new.name,
                                0u64,
                                0u64,
                                ux2_sv("variant added to exhaustive enum")
                            ))
                        }
                    }
                    vk = vk + 1usize
                }
            }
            ej = ej + 1usize
        }
        if !found {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_ENUM_REMOVED,
                SEVERITY_MAJOR_BREAKING,
                e_old.name,
                ux2_sv_empty(),
                0u64,
                0u64,
                ux2_sv("exported enum removed")
            ))
        }
        ei = ei + 1usize
    }

    let mut ek: usize = 0usize
    while ek < new_desc.enum_count && ek < 16usize {
        let e_new = new_desc.enums[ek]
        let mut found = false
        let mut em: usize = 0usize
        while em < old_desc.enum_count && em < 16usize {
            let e_old = old_desc.enums[em]
            if ux2_sv_eq(e_old.name, e_new.name) && ux2_sv_eq(e_old.module_path, e_new.module_path) {
                found = true
            }
            em = em + 1usize
        }
        if !found {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_ENUM_ADDED,
                SEVERITY_MINOR_ADDITIVE,
                e_new.name,
                ux2_sv_empty(),
                0u64,
                0u64,
                ux2_sv("new exported enum added")
            ))
        }
        ek = ek + 1usize
    }

    // 4. Symbol versions diff
    let mut vi: usize = 0usize
    while vi < old_desc.version_count && vi < 16usize {
        let v_old = old_desc.versions[vi]
        let mut found = false
        let mut vj: usize = 0usize
        while vj < new_desc.version_count && vj < 16usize {
            let v_new = new_desc.versions[vj]
            if ux2_sv_eq(v_old.name, v_new.name) && ux2_sv_eq(v_old.version, v_new.version) {
                found = true
            }
            vj = vj + 1usize
        }
        if !found {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_SYMBOL_VERSION_REMOVED,
                SEVERITY_MAJOR_BREAKING,
                v_old.name,
                v_old.version,
                0u64,
                0u64,
                ux2_sv("@symbol_version removed")
            ))
        }
        vi = vi + 1usize
    }

    let mut vk: usize = 0usize
    while vk < new_desc.version_count && vk < 16usize {
        let v_new = new_desc.versions[vk]
        let mut found = false
        let mut vm: usize = 0usize
        while vm < old_desc.version_count && vm < 16usize {
            let v_old = old_desc.versions[vm]
            if ux2_sv_eq(v_old.name, v_new.name) && ux2_sv_eq(v_old.version, v_new.version) {
                found = true
            }
            vm = vm + 1usize
        }
        if !found {
            diff_result_push(mut_view(*res), item_diff_new(
                DIFF_KIND_SYMBOL_VERSION_ADDED,
                SEVERITY_MINOR_ADDITIVE,
                v_new.name,
                v_new.version,
                0u64,
                0u64,
                ux2_sv("new @symbol_version added")
            ))
        }
        vk = vk + 1usize
    }

    // Overall classification computation
    let mut has_breaking = false
    let mut has_additive = false
    let mut di: usize = 0usize
    while di < res.diff_count {
        let d = res.diffs[di]
        if d.severity == SEVERITY_MAJOR_BREAKING {
            has_breaking = true
        } else if d.severity == SEVERITY_ADDITIVE {
            has_additive = true
        }
        di = di + 1usize
    }

    if has_breaking {
        res.overall_class = COMPAT_CLASS_MAJOR_BREAKING
        res.status_name = ux2_sv("major-breaking")
    } else if has_additive {
        res.overall_class = COMPAT_CLASS_MINOR_ADDITIVE
        res.status_name = ux2_sv("minor-additive")
    } else {
        res.overall_class = COMPAT_CLASS_IMPL_ONLY
        res.status_name = ux2_sv("compatible")
    }
}

// =============================================================================
// 5. Output Formatters (Text & JSON)
// =============================================================================

pub fn render_diff_text(
    res: view<InterfaceDiffResult>,
    old_ver: StrView,
    new_ver: StrView,
    target_name: StrView,
    buf: mut_view<DiagBuffer>
) {
    diag_buf_push_sv(mut_view(*buf), ux2_sv("--- axiomc abi-check report ---\n"))
    diag_buf_push_sv(mut_view(*buf), ux2_sv("Baseline version: "))
    diag_buf_push_sv(mut_view(*buf), old_ver)
    diag_buf_push_byte(mut_view(*buf), 10u8)

    diag_buf_push_sv(mut_view(*buf), ux2_sv("Candidate version: "))
    diag_buf_push_sv(mut_view(*buf), new_ver)
    diag_buf_push_byte(mut_view(*buf), 10u8)

    diag_buf_push_sv(mut_view(*buf), ux2_sv("Target: "))
    diag_buf_push_sv(mut_view(*buf), target_name)
    diag_buf_push_byte(mut_view(*buf), 10u8)

    diag_buf_push_sv(mut_view(*buf), ux2_sv("Classification: "))
    diag_buf_push_sv(mut_view(*buf), res.status_name)
    diag_buf_push_byte(mut_view(*buf), 10u8)

    diag_buf_push_sv(mut_view(*buf), ux2_sv("Differences ("))
    diag_buf_push_u32(mut_view(*buf), res.diff_count as u32)
    diag_buf_push_sv(mut_view(*buf), ux2_sv("):\n"))

    let mut i: usize = 0usize
    while i < res.diff_count {
        let d = res.diffs[i]
        diag_buf_push_sv(mut_view(*buf), ux2_sv("  ["))
        diag_buf_push_sv(mut_view(*buf), severity_name(d.severity))
        diag_buf_push_sv(mut_view(*buf), ux2_sv("] "))
        diag_buf_push_sv(mut_view(*buf), diff_kind_name(d.diff_kind))
        diag_buf_push_sv(mut_view(*buf), ux2_sv(": "))
        diag_buf_push_sv(mut_view(*buf), d.item_name)
        if d.member_name.len > 0 {
            diag_buf_push_byte(mut_view(*buf), 46u8) // '.'
            diag_buf_push_sv(mut_view(*buf), d.member_name)
        }
        diag_buf_push_sv(mut_view(*buf), ux2_sv(" ("))
        diag_buf_push_sv(mut_view(*buf), d.message)
        diag_buf_push_sv(mut_view(*buf), ux2_sv(")\n"))
        i = i + 1usize
    }
}

pub fn render_diff_json(
    res: view<InterfaceDiffResult>,
    status_field: StrView,
    old_ver: StrView,
    new_ver: StrView,
    target_fp_str: StrView,
    buf: mut_view<DiagBuffer>
) {
    diag_buf_push_sv(mut_view(*buf), ux2_sv("{\n  \"status\": "))
    write_json_string(mut_view(*buf), status_field)
    diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n  \"old_version\": "))
    write_json_string(mut_view(*buf), old_ver)
    diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n  \"new_version\": "))
    write_json_string(mut_view(*buf), new_ver)
    diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n  \"target_fingerprint\": "))
    write_json_string(mut_view(*buf), target_fp_str)
    diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n  \"classification\": "))
    write_json_string(mut_view(*buf), res.status_name)
    diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n  \"differences\": [\n"))

    let mut i: usize = 0usize
    while i < res.diff_count {
        let d = res.diffs[i]
        diag_buf_push_sv(mut_view(*buf), ux2_sv("    {\n      \"kind\": "))
        write_json_string(mut_view(*buf), diff_kind_name(d.diff_kind))
        diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n      \"item\": "))
        write_json_string(mut_view(*buf), d.item_name)
        diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n      \"field\": "))
        write_json_string(mut_view(*buf), d.member_name)
        diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n      \"old_value\": "))
        diag_buf_push_u32(mut_view(*buf), d.old_val as u32)
        diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n      \"new_value\": "))
        diag_buf_push_u32(mut_view(*buf), d.new_val as u32)
        diag_buf_push_sv(mut_view(*buf), ux2_sv(",\n      \"severity\": "))
        write_json_string(mut_view(*buf), severity_name(d.severity))
        diag_buf_push_sv(mut_view(*buf), ux2_sv("\n    }"))
        if i + 1usize < res.diff_count {
            diag_buf_push_byte(mut_view(*buf), 44u8) // ','
        }
        diag_buf_push_byte(mut_view(*buf), 10u8)
        i = i + 1usize
    }

    diag_buf_push_sv(mut_view(*buf), ux2_sv("  ]\n}\n"))
}
