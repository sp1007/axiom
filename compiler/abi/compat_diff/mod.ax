pub fn interface_struct_desc_default(name: StrView, mod_path: StrView) -> InterfaceStructDesc {
    let dummy_field = stable_field_desc_default(ux2_sv_empty(), ux2_sv_empty(), 0u8, 0u32, 1u32)
    InterfaceStructDesc {
        name: name,
        module_path: mod_path,
        size: 0u32,
        align: 1u32,
        is_extensible: false,
        has_abi_header: false,
        header_version: 1u32,
        header_struct_size: 0u32,
        is_opaque: false,
        is_pub: true,
        field_count: 0u32,
        fields: [dummy_field; 16],
