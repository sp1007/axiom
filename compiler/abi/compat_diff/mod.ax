// =============================================================================
// 1. Classification & Severity Constants (SPEC-114 §5, AXS-ABI-040)
// =============================================================================

pub const COMPAT_CLASS_IDENTICAL: u8 = 0u8
pub const COMPAT_CLASS_IMPL_ONLY: u8 = 1u8
pub const COMPAT_CLASS_MINOR_ADDITIVE: u8 = 2u8
pub const COMPAT_CLASS_MAJOR_BREAKING: u8 = 3u8

pub fn compat_class_name(c: u8) -> StrView {
    if c == COMPAT_CLASS_IDENTICAL {
        return ux2_sv("identical")
    }
    if c == COMPAT_CLASS_IMPL_ONLY {
        return ux2_sv("implementation-only")
    }
    if c == COMPAT_CLASS_MINOR_ADDITIVE {
        return ux2_sv("minor-additive")
    }
    if c == COMPAT_CLASS_MAJOR_BREAKING {
        return ux2_sv("major-breaking")
    }
    ux2_sv("unknown")
}

pub const SEVERITY_COMPATIBLE: u8 = 0u8
pub const SEVERITY_ADDITIVE: u8 = 1u8
pub const SEVERITY_BREAKING: u8 = 2u8
pub const SEVERITY_MINOR_ADDITIVE: u8 = 1u8
pub const SEVERITY_MAJOR_BREAKING: u8 = 2u8

pub fn severity_name(s: u8) -> StrView {
    if s == SEVERITY_COMPATIBLE {
        return ux2_sv("compatible")
    }
    if s == SEVERITY_ADDITIVE {
        return ux2_sv("additive")
    }
    if s == SEVERITY_BREAKING {
        return ux2_sv("breaking")
    }
    ux2_sv("unknown")
}

// Detailed difference kinds (AXS-ABI-040)
pub const DIFF_KIND_IDENTICAL: u16 = 0u16
pub const DIFF_KIND_IMPL_ONLY: u16 = 1u16
pub const DIFF_KIND_FN_ADDED: u16 = 2u16
pub const DIFF_KIND_FN_REMOVED: u16 = 3u16
pub const DIFF_KIND_FN_PARAM_COUNT_CHANGED: u16 = 4u16
pub const DIFF_KIND_FN_PARAM_TYPE_CHANGED: u16 = 5u16
pub const DIFF_KIND_FN_RET_TYPE_CHANGED: u16 = 6u16
pub const DIFF_KIND_FN_CALL_CONV_CHANGED: u16 = 7u16
pub const DIFF_KIND_STRUCT_ADDED: u16 = 8u16
pub const DIFF_KIND_STRUCT_REMOVED: u16 = 9u16
pub const DIFF_KIND_STRUCT_FIELD_OFFSET_CHANGED: u16 = 10u16
pub const DIFF_KIND_STRUCT_FIELD_REMOVED: u16 = 11u16
pub const DIFF_KIND_STRUCT_SIZE_CHANGED: u16 = 12u16
pub const DIFF_KIND_STRUCT_ALIGN_CHANGED: u16 = 13u16
pub const DIFF_KIND_STRUCT_EXTENSIBLE_FIELD_APPENDED: u16 = 14u16
pub const DIFF_KIND_STRUCT_NON_EXTENSIBLE_FIELD_ADDED: u16 = 15u16
pub const DIFF_KIND_ENUM_ADDED: u16 = 16u16
pub const DIFF_KIND_ENUM_REMOVED: u16 = 17u16
pub const DIFF_KIND_ENUM_DISCRIMINANT_CHANGED: u16 = 18u16
pub const DIFF_KIND_ENUM_NON_EXHAUSTIVE_VARIANT_ADDED: u16 = 19u16
pub const DIFF_KIND_ENUM_EXHAUSTIVE_VARIANT_ADDED: u16 = 20u16
pub const DIFF_KIND_SYMBOL_VERSION_ADDED: u16 = 21u16
pub const DIFF_KIND_SYMBOL_VERSION_REMOVED: u16 = 22u16
pub const DIFF_KIND_CAPABILITY_RELAXED: u16 = 23u16
pub const DIFF_KIND_CAPABILITY_TIGHTENED: u16 = 24u16

pub fn diff_kind_name(kind: u16) -> StrView {
    if kind == DIFF_KIND_IDENTICAL { return ux2_sv("identical") }
    if kind == DIFF_KIND_IMPL_ONLY { return ux2_sv("implementation_only") }
    if kind == DIFF_KIND_FN_ADDED { return ux2_sv("function_added") }
    if kind == DIFF_KIND_FN_REMOVED { return ux2_sv("function_removed") }
    if kind == DIFF_KIND_FN_PARAM_COUNT_CHANGED { return ux2_sv("function_param_count_changed") }
    if kind == DIFF_KIND_FN_PARAM_TYPE_CHANGED { return ux2_sv("function_param_type_changed") }
    if kind == DIFF_KIND_FN_RET_TYPE_CHANGED { return ux2_sv("function_return_type_changed") }
    if kind == DIFF_KIND_FN_CALL_CONV_CHANGED { return ux2_sv("function_call_conv_changed") }
    if kind == DIFF_KIND_STRUCT_ADDED { return ux2_sv("struct_added") }
    if kind == DIFF_KIND_STRUCT_REMOVED { return ux2_sv("struct_removed") }
    if kind == DIFF_KIND_STRUCT_FIELD_OFFSET_CHANGED { return ux2_sv("struct_field_offset_changed") }
    if kind == DIFF_KIND_STRUCT_FIELD_REMOVED { return ux2_sv("struct_field_removed") }
    if kind == DIFF_KIND_STRUCT_SIZE_CHANGED { return ux2_sv("struct_size_changed") }
    if kind == DIFF_KIND_STRUCT_ALIGN_CHANGED { return ux2_sv("struct_align_changed") }
    if kind == DIFF_KIND_STRUCT_EXTENSIBLE_FIELD_APPENDED { return ux2_sv("extensible_struct_field_appended") }
    if kind == DIFF_KIND_STRUCT_NON_EXTENSIBLE_FIELD_ADDED { return ux2_sv("non_extensible_struct_field_added") }
    if kind == DIFF_KIND_ENUM_ADDED { return ux2_sv("enum_added") }
    if kind == DIFF_KIND_ENUM_REMOVED { return ux2_sv("enum_removed") }
    if kind == DIFF_KIND_ENUM_DISCRIMINANT_CHANGED { return ux2_sv("enum_discriminant_changed") }
    if kind == DIFF_KIND_ENUM_NON_EXHAUSTIVE_VARIANT_ADDED { return ux2_sv("non_exhaustive_enum_variant_added") }
    if kind == DIFF_KIND_ENUM_EXHAUSTIVE_VARIANT_ADDED { return ux2_sv("exhaustive_enum_variant_added") }
    if kind == DIFF_KIND_SYMBOL_VERSION_ADDED { return ux2_sv("symbol_version_added") }
    if kind == DIFF_KIND_SYMBOL_VERSION_REMOVED { return ux2_sv("symbol_version_removed") }
    if kind == DIFF_KIND_CAPABILITY_RELAXED { return ux2_sv("capability_relaxed") }
    if kind == DIFF_KIND_CAPABILITY_TIGHTENED { return ux2_sv("capability_tightened") }
    ux2_sv("unknown_diff")
}

// =============================================================================
// 2. Versioned Symbol Mangling & Export Table Models (REQ-ECO-8734)
// =============================================================================

fn push_sanitized_name(buf: mut_view<DiagBuffer>, s: StrView) {
    let mut i: usize = 0usize
    while i < s.len {
        let b = unsafe { *(s.ptr + i) }
        if b == 46u8 { // '.'
            diag_buf_push_byte(mut_view(*buf), 95u8) // '_'
        } else {
            diag_buf_push_byte(mut_view(*buf), b)
        }
        i = i + 1usize
    }
}

pub fn format_versioned_mangled_name(
    pkg: StrView,
    mod_path: StrView,
    ident: StrView,
    ver: StrView,
    is_default: bool,
    buf: mut_view<DiagBuffer>
) {
    diag_buf_push_sv(mut_view(*buf), ux2_sv("axiom_"))
    push_sanitized_name(mut_view(*buf), pkg)
    diag_buf_push_byte(mut_view(*buf), 95u8) // '_'
    push_sanitized_name(mut_view(*buf), mod_path)
    diag_buf_push_byte(mut_view(*buf), 95u8) // '_'
    diag_buf_push_sv(mut_view(*buf), ident)
    if is_default {
        diag_buf_push_byte(mut_view(*buf), 64u8) // '@'
        diag_buf_push_byte(mut_view(*buf), 64u8) // '@'
    } else {
        diag_buf_push_byte(mut_view(*buf), 64u8) // '@'
    }
    diag_buf_push_sv(mut_view(*buf), ver)
}

pub fn format_pe_export_alias(
    ident: StrView,
    ver: StrView,
    is_default: bool,
    buf: mut_view<DiagBuffer>
) {
    if is_default {
        diag_buf_push_sv(mut_view(*buf), ident)
    } else {
        diag_buf_push_sv(mut_view(*buf), ident)
        diag_buf_push_sv(mut_view(*buf), ux2_sv("_v"))
        push_sanitized_name(mut_view(*buf), ver)
    }
}

@derive(Copy)
pub struct VersionedExportDesc {
    pub package_name: StrView,
    pub module_path: StrView,
    pub symbol_name: StrView,
    pub version: StrView,
    pub is_default: bool,
    pub mangled_symbol: StrView,
    pub pe_alias: StrView,
    pub call_conv: u8,
    pub is_abi_stable: bool,
}

pub fn versioned_export_desc_new(
    pkg: StrView,
    mod_path: StrView,
    sym: StrView,
    ver: StrView,
    is_def: bool,
    mangled: StrView,
    pe_alias: StrView
) -> VersionedExportDesc {
    VersionedExportDesc {
        package_name: pkg,
        module_path: mod_path,
        symbol_name: sym,
        version: ver,
        is_default: is_def,
        mangled_symbol: mangled,
        pe_alias: pe_alias,
        call_conv: CALL_CONV_WIN64,
        is_abi_stable: true,
    }
}

pub fn validate_versioned_export_coexistence(
    exports: view<[16]VersionedExportDesc>,
    count: usize,
    sink: mut_view<DiagSink>
) -> bool {
    let mut valid = true
    let mut i: usize = 0usize
    while i < count && i < 16usize {
        let a = (*exports)[i]
        let mut j: usize = i + 1usize
        while j < count && j < 16usize {
            let b = (*exports)[j]
            let same_ident = ux2_sv_eq(a.symbol_name, b.symbol_name) && ux2_sv_eq(a.module_path, b.module_path)
            if same_ident {
                if ux2_sv_eq(a.version, b.version) {
                    report_abi_diag_2(
                        mut_view(*sink),
                        AX_ABI_SYMBOL_VERSION_DUPLICATE,
                        "duplicate @symbol_version in exported symbol table",
                        "symbol",
                        a.symbol_name,
                        "version",
                        a.version
                    )
                    valid = false
                }
                if a.is_default && b.is_default {
                    report_abi_diag_1(
                        mut_view(*sink),
                        AX_ABI_SYMBOL_VERSION_DUPLICATE,
                        "multiple @symbol_version exports marked default = true in the same symbol group",
                        "symbol",
                        a.symbol_name
                    )
                    valid = false
                }
            }

            if a.mangled_symbol.len > 0 && b.mangled_symbol.len > 0 {
                if ux2_sv_eq(a.mangled_symbol, b.mangled_symbol) {
                    report_abi_diag_2(
                        mut_view(*sink),
                        AX_ABI_SYMBOL_VERSION_DUPLICATE,
                        "symbol collision: identical mangled names in export table",
                        "mangled_a",
                        a.mangled_symbol,
                        "mangled_b",
                        b.mangled_symbol
                    )
                    valid = false
                }
            }

            if a.pe_alias.len > 0 && b.pe_alias.len > 0 {
                if ux2_sv_eq(a.pe_alias, b.pe_alias) {
                    report_abi_diag_2(
                        mut_view(*sink),
                        AX_ABI_SYMBOL_VERSION_DUPLICATE,
                        "export table collision: identical PE export alias",
                        "alias",
                        a.pe_alias,
                        "symbol",
                        a.symbol_name
                    )
                    valid = false
                }
            }

            j = j + 1usize
        }
        i = i + 1usize
    }
    valid
}

// =============================================================================
// 3. Interface Descriptors (.axmeta) & Item Models
// =============================================================================

@derive(Copy)
pub struct ItemDiff {
    pub diff_kind: u16,
    pub severity: u8,
    pub item_name: StrView,
    pub member_name: StrView,
    pub old_val: u64,
    pub new_val: u64,
    pub message: StrView,
}

pub fn item_diff_new(
    kind: u16,
    sev: u8,
    item: StrView,
    member: StrView,
    old_v: u64,
    new_v: u64,
    msg: StrView
) -> ItemDiff {
    ItemDiff {
        diff_kind: kind,
        severity: sev,
        item_name: item,
        member_name: member,
        old_val: old_v,
        new_val: new_v,
        message: msg,
    }
}

pub const MAX_DIFFS: usize = 32usize

@derive(Copy)
pub struct InterfaceDiffResult {
    pub overall_class: u8,
    pub status_name: StrView,
    pub diff_count: usize,
    pub diffs: [32]ItemDiff,
}

pub fn interface_diff_result_empty() -> InterfaceDiffResult {
    let e = ux2_sv_empty()
    let dummy = item_diff_new(0u16, 0u8, e, e, 0u64, 0u64, e)
    InterfaceDiffResult {
        overall_class: COMPAT_CLASS_IDENTICAL,
        status_name: ux2_sv("identical"),
        diff_count: 0usize,
        diffs: [dummy; 32],
    }
}

pub fn diff_result_push(res: mut_view<InterfaceDiffResult>, diff: ItemDiff) {
    let cur_count = res.diff_count
    if cur_count < 32usize {
        res.diffs[cur_count] = diff
        res.diff_count = cur_count + 1usize
    }
}

@derive(Copy)
pub struct InterfaceFnDesc {
    pub name: StrView,
    pub module_path: StrView,
    pub call_conv: u8,
    pub symbol_version: StrView,
    pub is_default_version: bool,
