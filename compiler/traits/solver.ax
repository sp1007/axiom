fn hir_field_name_sv(
    f: *const HirFieldDecl,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (f as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*f).name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*f).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*f).span.start };
        let sp_e = unsafe { (*f).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

fn hir_variant_name_sv(
    v: *const HirVariantDecl,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (v as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*v).name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*v).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*v).span.start };
        let sp_e = unsafe { (*v).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

fn find_auto_trait_failure_reason(
    hir: view<HirFile>,
    thir: view<Thir>,
    ty_id: TypeId,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    out_name: mut_view<StrView>,
    depth: usize
) -> u8 {
    let ty_v: u32 = ty_id.v;
    if depth > 16 {
        return 0u8;
    }
    let t = type_get(view(thir.interner), (TypeId { v: ty_v }));
    if (t as usize) == 0 {
        return 0u8;
    }
    let tk = unsafe { (*t).kind };
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        let tp = unsafe { (*it).trait_path };
        if ik == HIR_ITEM_IMPL && (tp as usize) != 0 && unsafe { (*it).is_negative } {
            if impl_trait_matches_target(tp, auto_kind, tr_sym_v, tr_name, str_in, db) {
                if type_matches_impl_self_exact(thir, str_in, it, (TypeId { v: ty_v })) &&
                   impl_bounds_satisfied(hir, thir, it, (TypeId { v: ty_v }), str_in, db, depth + 1) {
                    if (tk == TY_STRUCT || tk == TY_ENUM) && (unsafe { (*t).def as usize }) != 0 {
                        *out_name = hir_item_name_sv(unsafe { (*t).def }, str_in, db);
                    }
                    return 1u8;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    if tk == TY_PTR {
        return 2u8;
    }
    if tk == TY_MUT_VIEW {
        if auto_kind == 2u8 {
            return 3u8;
        }
        return find_auto_trait_failure_reason(hir, thir, unsafe { (*t).pointee }, 1u8, 10007u32, tr_name, str_in, db, out_name, depth + 1);
    }
    if tk == TY_VIEW {
        return 4u8;
    }
    if tk == TY_PARAM {
        let pid_v = unsafe { (*t).name.v };
        if pid_v != 0u32 {
            *out_name = interner_get(str_in, (StrId { v: pid_v }));
        }
        return 8u8;
    }
    if tk == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let flds = unsafe { (*t).fields };
        let sdef = unsafe { (*t).def };
        let mut fdecl: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
        let mut i: usize = 0;
        while i < fc {
            let ft = unsafe { *typeid_at(flds, i) };
            if !type_satisfies_auto_trait(hir, thir, ft, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                if (fdecl as usize) != 0 {
                    *out_name = hir_field_name_sv(fdecl, str_in, db);
                } else if (sdef as usize) != 0 {
                    *out_name = hir_item_name_sv(sdef, str_in, db);
                }
                return 5u8;
            }
            if (fdecl as usize) != 0 {
                fdecl = unsafe { (*fdecl).next };
            }
            i = i + 1;
        }
        if (sdef as usize) != 0 {
            *out_name = hir_item_name_sv(sdef, str_in, db);
        }
        return 1u8;
    }
    if tk == TY_ENUM {
        let vc = unsafe { (*t).variant_count };
        let vf_arr = unsafe { (*t).variant_fields };
        let vfc_arr = unsafe { (*t).variant_field_counts };
        let edef = unsafe { (*t).def };
        let mut vdecl: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
        if (vf_arr as usize) != 0 && (vfc_arr as usize) != 0 {
            let mut v: usize = 0;
            while v < vc {
                let fc = unsafe { *usize_at(vfc_arr, v) };
                let row = unsafe { *typeid_ptr_at(vf_arr, v) };
                if (row as usize) != 0 {
                    let mut f: usize = 0;
                    while f < fc {
                        let ft = unsafe { *typeid_at(row, f) };
                        if !type_satisfies_auto_trait(hir, thir, ft, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                            if (vdecl as usize) != 0 {
                                *out_name = hir_variant_name_sv(vdecl, str_in, db);
                            }
                            return 6u8;
                        }
                        f = f + 1;
                    }
                }
                if (vdecl as usize) != 0 {
                    vdecl = unsafe { (*vdecl).next };
                }
                v = v + 1;
            }
        }
        return 6u8;
    }
    if tk == TY_CLOSURE {
        return 7u8;
    }
    if tk == TY_COROUTINE {
        if auto_kind == 2u8 {
            return 3u8;
        }
        return find_auto_trait_failure_reason(hir, thir, unsafe { (*t).ret_type }, auto_kind, tr_sym_v, tr_name, str_in, db, out_name, depth + 1);
    }
    if tk == TY_ARRAY || tk == TY_SLICE {
        return find_auto_trait_failure_reason(hir, thir, unsafe { (*t).elem }, auto_kind, tr_sym_v, tr_name, str_in, db, out_name, depth + 1);
    }
    if tk == TY_TUPLE {
        let fc = unsafe { (*t).field_count };
        let flds = unsafe { (*t).fields };
        let mut i: usize = 0;
        while i < fc {
            let ft_v = unsafe { (*typeid_at(flds, i)).v };
            if !type_satisfies_auto_trait(hir, thir, (TypeId { v: ft_v }), auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                return find_auto_trait_failure_reason(hir, thir, (TypeId { v: ft_v }), auto_kind, tr_sym_v, tr_name, str_in, db, out_name, depth + 1);
            }
            i = i + 1;
        }
    }
    0u8
}

fn append_bytes_to_buf(dst: *mut u8, pos: usize, src: *const u8, len: usize) -> usize {
    let mut i: usize = 0;
    while i < len {
        unsafe {
            *(dst + pos + i) = *(src + i);
        }
        i = i + 1;
    }
    pos + len
}

fn append_trait_tag(dst: *mut u8, pos: usize, auto_kind: u8) -> usize {
    let mut p = pos;
    if auto_kind == 1u8 {
        unsafe {
            *(dst + p + 0) = 83u8;
            *(dst + p + 1) = 101u8;
            *(dst + p + 2) = 110u8;
            *(dst + p + 3) = 100u8;
            *(dst + p + 4) = 96u8;
        }
        p = p + 5;
    } else {
        unsafe {
            *(dst + p + 0) = 83u8;
            *(dst + p + 1) = 104u8;
            *(dst + p + 2) = 97u8;
            *(dst + p + 3) = 114u8;
            *(dst + p + 4) = 101u8;
            *(dst + p + 5) = 96u8;
        }
        p = p + 6;
    }
    p
}

fn build_conc_failure_note(
    arena: mut_view<Arena>,
    reason: u8,
    auto_kind: u8,
    name_sv: view<StrView>
) -> StrView {
    let buf = arena_alloc_raw(arena, 128, 1);
    let mut pos: usize = 0;
    let nlen: usize = if name_sv.len > 48 { 48 } else { name_sv.len };
    if reason == 3u8 {
        let mut i: usize = 0;
        while i < 58 {
            unsafe { *(buf + i) = NOTE_MUT_VIEW_SHARE[i]; }
            i = i + 1;
        }
        pos = 58;
    } else if reason == 4u8 {
        let mut i: usize = 0;
        while i < 42 {
            unsafe { *(buf + i) = NOTE_VIEW_REQUIRES_SHARE[i]; }
            i = i + 1;
        }
        pos = 42;
    } else if reason == 1u8 && nlen > 0 && (name_sv.ptr as usize) != 0 {
        let mut i: usize = 0;
        while i < 28 {
            unsafe { *(buf + i) = NOTE_NEG_IMPL[i]; }
            i = i + 1;
        }
        pos = append_bytes_to_buf(buf, 28, name_sv.ptr, nlen);
        let mut j: usize = 0;
        while j < 10 {
            unsafe { *(buf + pos + j) = NOTE_SUFFIX_NOT[j]; }
            j = j + 1;
        }
        pos = append_trait_tag(buf, pos + 10, auto_kind);
    } else if (reason == 5u8 || reason == 6u8 || reason == 8u8) && nlen > 0 && (name_sv.ptr as usize) != 0 {
        if reason == 5u8 {
            let mut i: usize = 0;
            while i < 7 {
                unsafe { *(buf + i) = NOTE_FIELD_PREFIX[i]; }
                i = i + 1;
            }
            pos = 7;
        } else if reason == 6u8 {
            let mut i: usize = 0;
            while i < 9 {
                unsafe { *(buf + i) = NOTE_VARIANT_PREFIX[i]; }
                i = i + 1;
            }
            pos = 9;
        } else {
            let mut i: usize = 0;
            while i < 16 {
                unsafe { *(buf + i) = NOTE_PARAM_PREFIX[i]; }
                i = i + 1;
            }
            pos = 16;
        }
        pos = append_bytes_to_buf(buf, pos, name_sv.ptr, nlen);
        let mut j: usize = 0;
        while j < 10 {
            unsafe { *(buf + pos + j) = NOTE_SUFFIX_NOT[j]; }
            j = j + 1;
        }
        pos = append_trait_tag(buf, pos + 10, auto_kind);
    } else if reason == 7u8 {
        let mut i: usize = 0;
        while i < 34 {
            unsafe { *(buf + i) = NOTE_CLOSURE_CAPTURE[i]; }
            i = i + 1;
        }
        pos = append_trait_tag(buf, 34, auto_kind);
    } else {
        let mut i: usize = 0;
        while i < 42 {
            unsafe { *(buf + i) = NOTE_RAW_PTR[i]; }
            i = i + 1;
        }
        pos = append_trait_tag(buf, 42, auto_kind);
    }
    unsafe { *(buf + pos) = 0u8; }
    StrView { ptr: buf as *const u8, len: pos }
}

pub fn emit_conc_bound_diag(
    hir: view<HirFile>,
    thir: view<Thir>,
    arg_ty: TypeId,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    sp: Span
) {
    let code_v = if auto_kind == 1u8 { AX_CONC_NOT_SEND } else { AX_CONC_NOT_SHARE };
    let msg_len: usize = if auto_kind == 1u8 { 68 } else { 65 };
    let buf = arena_alloc_raw(mut_view(sink.arena), msg_len + 1, 1);
    let mut i: usize = 0;
    while i < msg_len {
        unsafe {
            *(buf + i) = if auto_kind == 1u8 { MSG_NOT_SEND[i] } else { MSG_NOT_SHARE[i] };
        }
        i = i + 1;
    }
    unsafe { *(buf + msg_len) = 0u8; }

    let mut reason_name = StrView { ptr: 0 as *const u8, len: 0 };
    let reason = find_auto_trait_failure_reason(
        hir,
        thir,
        arg_ty,
        auto_kind,
        tr_sym_v,
        tr_name,
        str_in,
        db,
        mut_view(reason_name),
        0
    );
    let note_sv = build_conc_failure_note(mut_view(sink.arena), reason, auto_kind, view(reason_name));
    let notes_ptr = arena_alloc_raw(mut_view(sink.arena), 16, 8) as *mut StrView;
    unsafe {
        (*notes_ptr).ptr = note_sv.ptr;
        (*notes_ptr).len = note_sv.len;
    }

    let sev = diag_code_severity(DiagCode { v: code_v });
    let mut d = Diagnostic {
        code: DiagCode { v: code_v },
        severity: sev,
        message: StrView { ptr: buf as *const u8, len: msg_len },
        primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: notes_ptr,
        note_count: 1,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(*sink), view(d));
}

pub fn emit_safe_send_share_impl_diag(sink: mut_view<DiagSink>, sp: Span) {
    let buf = arena_alloc_raw(mut_view(sink.arena), 66, 1);
    let mut i: usize = 0;
    while i < 65 {
        unsafe { *(buf + i) = MSG_SAFE_SEND_SHARE_IMPL[i]; }
        i = i + 1;
    }
    unsafe { *(buf + 65) = 0u8; }
    let sev = diag_code_severity(DiagCode { v: AX_CONC_SAFE_SEND_SHARE_IMPL });
    let d = Diagnostic {
        code: DiagCode { v: AX_CONC_SAFE_SEND_SHARE_IMPL },
        severity: sev,
        message: StrView { ptr: buf as *const u8, len: 65 },
        primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(*sink), view(d));
}

pub fn check_send_share_impl_safety(
    hir: view<HirFile>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>
) -> bool {
    let mut all_ok: bool = true;
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        let tp = unsafe { (*it).trait_path };
        if ik == HIR_ITEM_IMPL && (tp as usize) != 0 && unsafe { (*tp).kind } == HIR_TYPE_PATH {
            if !unsafe { (*it).is_negative } && !unsafe { (*it).is_unsafe } {
                let tr_sym_v = unsafe { (*tp).path.symbol.v };
                let tr_name = hir_type_path_name_sv(tp, str_in, db);
                let ak = trait_auto_kind(hir, tr_sym_v, view(tr_name), str_in, db);
                let tr_it = find_trait_item(hir, SymbolId { v: tr_sym_v }, view(tr_name), str_in, db);
                let is_unsafe_tr = (tr_it as usize) != 0 && unsafe { (*tr_it).is_unsafe };
                if ak == 1u8 || ak == 2u8 || is_unsafe_tr {
                    let sp_f = unsafe { (*it).span.file.v };
                    let sp_s = unsafe { (*it).span.start };
                    let sp_e = unsafe { (*it).span.end };
                    emit_safe_send_share_impl_diag(
                        mut_view(*sink),
                        Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e }
                    );
                    all_ok = false;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    all_ok
}

fn report_unsatisfied_bound_or_conc(
    hir: view<HirFile>,
    thir: view<Thir>,
    arg_ty: TypeId,
    bound: *const HirType,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    sp: Span
) {
    if (bound as usize) != 0 && unsafe { (*bound).kind } == HIR_TYPE_PATH {
        let tr_sym_v = unsafe { (*bound).path.symbol.v };
        let tr_name = hir_type_path_name_sv(bound, str_in, db);
        let ak = trait_auto_kind(hir, tr_sym_v, view(tr_name), str_in, db);
        if ak == 1u8 || ak == 2u8 {
            emit_conc_bound_diag(hir, thir, arg_ty, ak, tr_sym_v, view(tr_name), str_in, db, sink, sp);
            return;
        }
    }
    emit_trait_unsatisfied_bound_diag(sink, sp);
}

pub fn check_item_bounds(
    hir: view<HirFile>,
    thir: view<Thir>,
    callee_it: *const HirItem,
    args: view<GenericArgsSlice>,
    call_span: Span,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>
) -> bool {
    let sp_file_v = call_span.file.v;
    let sp_start = call_span.start;
    let sp_end = call_span.end;
    let arg_cnt: usize = args.count;
    let arg_ptr: *mut TypeId = args.args;
    if (callee_it as usize) == 0 || arg_cnt == 0 || (arg_ptr as usize) == 0 {
        return true;
    }
    let gps = unsafe { (*callee_it).generic_params };
    if (gps as usize) == 0 {
        return true;
    }
    let mut all_ok: bool = true;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    let mut p_idx: usize = 0;
    while ((gp as usize) != 0 && p_idx < arg_cnt) {
        let arg_ty_v = unsafe { (*typeid_at(arg_ptr, p_idx)).v };
        let mut b: *mut HirType = unsafe { (*gp).bounds };
        while ((b as usize) != 0) {
            if !satisfies_bound(hir, thir, (TypeId { v: arg_ty_v }), b, str_in, db) {
                let sp = Span { file: FileId { v: sp_file_v }, start: sp_start, end: sp_end };
                report_unsatisfied_bound_or_conc(hir, thir, (TypeId { v: arg_ty_v }), b, str_in, db, mut_view(*sink), sp);
                all_ok = false;
            }
            b = unsafe { (*b).next };
        }
        gp = unsafe { (*gp).next };
        p_idx = p_idx + 1;
    }

    let wc = unsafe { (*callee_it).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 && unsafe { (*wty).kind } == HIR_TYPE_PATH {
                let wp_name = hir_type_path_name_sv(wty, str_in, db);
                let mut gp2: *mut HirGenericParam = unsafe { (*gps).params };
                let mut idx2: usize = 0;
                while ((gp2 as usize) != 0 && idx2 < arg_cnt) {
                    let gp_name = hir_generic_param_name_sv(gp2, str_in, db);
                    if sv_eq(view(wp_name), view(gp_name)) {
                        let arg_ty2_v = unsafe { (*typeid_at(arg_ptr, idx2)).v };
                        let mut wb: *mut HirType = unsafe { (*wp).bounds };
                        while ((wb as usize) != 0) {
                            if !satisfies_bound(hir, thir, (TypeId { v: arg_ty2_v }), wb, str_in, db) {
                                let sp2 = Span {
                                    file: FileId { v: sp_file_v },
                                    start: sp_start,
                                    end: sp_end
                                };
                                report_unsatisfied_bound_or_conc(hir, thir, (TypeId { v: arg_ty2_v }), wb, str_in, db, mut_view(*sink), sp2);
                                all_ok = false;
                            }
                            wb = unsafe { (*wb).next };
                        }
                        break;
                    }
                    gp2 = unsafe { (*gp2).next };
                    idx2 = idx2 + 1;
                }
            }
            wp = unsafe { (*wp).next };
        }
    }
    all_ok
}

pub fn check_impl_supertraits(
    hir: view<HirFile>,
    thir: view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>
) -> bool {
    let mut all_ok: bool = true;
    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        let ik = unsafe { (*it).kind };
        let tp = unsafe { (*it).trait_path };
        if ik == HIR_ITEM_IMPL && (tp as usize) != 0 && !unsafe { (*it).is_negative } {
            let tr_it = find_trait_by_type_path(hir, tp, str_in, db);
            let self_ty_ptr = thir_get_item_type(thir, it);
            if (tr_it as usize) != 0 && (self_ty_ptr as usize) != 0 {
                let self_ty_v = unsafe { (*self_ty_ptr).v };
                let mut st: *mut HirType = unsafe { (*tr_it).supertraits };
                while ((st as usize) != 0) {
                    if !satisfies_bound(hir, thir, (TypeId { v: self_ty_v }), st, str_in, db) {
                        let sp_f = unsafe { (*it).span.file.v };
                        let sp_s = unsafe { (*it).span.start };
                        let sp_e = unsafe { (*it).span.end };
                        report_unsatisfied_bound_or_conc(
                            hir,
                            thir,
                            (TypeId { v: self_ty_v }),
                            st,
                            str_in,
                            db,
                            mut_view(*sink),
                            Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e }
                        );
                        all_ok = false;
                    }
                    st = unsafe { (*st).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }
    all_ok
}
