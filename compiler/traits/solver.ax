    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*gp).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*gp).span.start };
        let sp_e = unsafe { (*gp).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn emit_trait_overlap_diag(sink: mut_view<DiagSink>, sp: Span) {
    let buf = arena_alloc_raw(mut_view(sink.arena), 38, 1);
    let mut i: usize = 0;
    while (i < 37) {
        unsafe {
            *(buf + i) = MSG_OVERLAP[i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + 37) = 0u8;
    }
    let sev = diag_code_severity(DiagCode { v: AX_TRAIT_OVERLAP });
    let mut d = Diagnostic {
        code: DiagCode { v: AX_TRAIT_OVERLAP },
        severity: sev,
        message: StrView { ptr: 0 as *const u8, len: 0 },
        primary: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    d.message.ptr = buf as *const u8;
    d.message.len = 37;
    d.primary.file.v = sp.file.v;
    d.primary.start = sp.start;
    d.primary.end = sp.end;
    diag_sink_report(mut_view(*sink), view(d));
}

pub fn emit_trait_ambiguous_diag(sink: mut_view<DiagSink>, sp: Span) {
    let buf = arena_alloc_raw(mut_view(sink.arena), 25, 1);
    let mut i: usize = 0;
    while (i < 24) {
        unsafe {
            *(buf + i) = MSG_AMBIGUOUS[i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + 24) = 0u8;
    }
    let sev = diag_code_severity(DiagCode { v: AX_TRAIT_AMBIGUOUS_METHOD });
    let mut d = Diagnostic {
        code: DiagCode { v: AX_TRAIT_AMBIGUOUS_METHOD },
        severity: sev,
        message: StrView { ptr: 0 as *const u8, len: 0 },
        primary: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    d.message.ptr = buf as *const u8;
    d.message.len = 24;
    d.primary.file.v = sp.file.v;
    d.primary.start = sp.start;
    d.primary.end = sp.end;
    diag_sink_report(mut_view(*sink), view(d));
}

