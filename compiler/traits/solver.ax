pub fn hir_types_overlap_target(t1: *const HirType, t2: *const HirType) -> bool {
    if (t1 as usize) == 0 || (t2 as usize) == 0 {
        return false;
    }
    let k1 = unsafe { (*t1).kind };
    let k2 = unsafe { (*t2).kind };
    if k1 != k2 {
        return false;
    }
    if k1 == HIR_TYPE_PATH {
        let sym1 = unsafe { (*t1).path.symbol.v };
        let sym2 = unsafe { (*t2).path.symbol.v };
        if sym1 != 0u32 && sym2 != 0u32 {
            return sym1 == sym2;
        }
        let name1 = unsafe { (*t1).path.name.v };
        let name2 = unsafe { (*t2).path.name.v };
        if name1 != 0u32 && name2 != 0u32 {
            return name1 == name2;
        }
        return false;
    }
    if k1 == HIR_TYPE_SLICE {
        let e1 = unsafe { (*t1).elem };
        let e2 = unsafe { (*t2).elem };
        return hir_types_overlap_target(e1, e2);
    }
    if k1 == HIR_TYPE_VIEW || k1 == HIR_TYPE_PTR {
        let m1 = unsafe { (*t1).is_mut };
        let m2 = unsafe { (*t2).is_mut };
        if m1 != m2 {
            return false;
        }
        let e1 = unsafe { (*t1).elem };
        let e2 = unsafe { (*t2).elem };
        return hir_types_overlap_target(e1, e2);
    }
    false
}

pub fn traits_check_overlap(hir: view<HirFile>, sink: mut_view<DiagSink>) {
    let mut i1: *mut HirItem = hir.items;
    while ((i1 as usize) != 0) {
        let k1 = unsafe { (*i1).kind };
        let t1 = unsafe { (*i1).trait_path };
        let s1 = unsafe { (*i1).self_type };
        if k1 == HIR_ITEM_IMPL && (t1 as usize) != 0 && (s1 as usize) != 0 {
            let mut i2: *mut HirItem = unsafe { (*i1).next };
            while ((i2 as usize) != 0) {
                let k2 = unsafe { (*i2).kind };
                let t2 = unsafe { (*i2).trait_path };
                let s2 = unsafe { (*i2).self_type };
                if k2 == HIR_ITEM_IMPL && (t2 as usize) != 0 && (s2 as usize) != 0 {
                    if hir_types_overlap_target(t1, t2) && hir_types_overlap_target(s1, s2) {
                        let sp2_f = unsafe { (*i2).span.file.v };
                        let sp2_s = unsafe { (*i2).span.start };
                        let sp2_e = unsafe { (*i2).span.end };
                        emit_trait_overlap_diag(
                            mut_view(*sink),
                            Span { file: FileId { v: sp2_f }, start: sp2_s, end: sp2_e }
                        );
                    }
                }
                i2 = unsafe { (*i2).next };
            }
        }
        i1 = unsafe { (*i1).next };
    }
}

pub fn find_trait_item(
    hir: view<HirFile>,
    sym: SymbolId,
    name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirItem {
    let name_len: usize = name.len;
    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        let k = unsafe { (*it).kind };
        if k == HIR_ITEM_TRAIT {
            let it_sym = unsafe { (*it).symbol.v };
            if sym.v != 0u32 && it_sym == sym.v {
                return it;
            }
            if name_len > 0 {
                let it_name = hir_item_name_sv(it, str_in, db);
                if sv_eq(view(it_name), name) {
                    return it;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

pub fn find_trait_by_type_path(
    hir: view<HirFile>,
    trait_path: *const HirType,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirItem {
    if (trait_path as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let tk = unsafe { (*trait_path).kind };
    if tk != HIR_TYPE_PATH {
        return 0 as *mut HirItem;
    }
    let sym_v = unsafe { (*trait_path).path.symbol.v };
    let tr_name = hir_type_path_name_sv(trait_path, str_in, db);
    find_trait_item(hir, SymbolId { v: sym_v }, view(tr_name), str_in, db)
}

pub fn find_trait_default_method(
    hir: view<HirFile>,
    tr: *const HirItem,
    method_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirItem {
    if (tr as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let tk = unsafe { (*tr).kind };
    if tk != HIR_ITEM_TRAIT {
        return 0 as *mut HirItem;
    }
    let mut m: *mut HirItem = unsafe { (*tr).members };
    while ((m as usize) != 0) {
        let mk = unsafe { (*m).kind };
        let mbody = unsafe { (*m).body };
        if mk == HIR_ITEM_FN && (mbody as usize) != 0 {
            let m_name = hir_item_name_sv(m, str_in, db);
            if sv_eq(view(m_name), method_name) {
                return m;
            }
        }
        m = unsafe { (*m).next };
    }
    let mut st: *mut HirType = unsafe { (*tr).supertraits };
    while ((st as usize) != 0) {
        let st_it = find_trait_by_type_path(hir, st, str_in, db);
        if (st_it as usize) != 0 && (st_it as usize) != (tr as usize) {
            let found = find_trait_default_method(hir, st_it, method_name, str_in, db);
            if (found as usize) != 0 {
                return found;
            }
        }
        st = unsafe { (*st).next };
    }
    0 as *mut HirItem
}

fn prim_kind_matches_name(tk: u8, name: view<StrView>) -> bool {
    if tk == TY_I8 {
        return sv_is_2(name, 105u8, 56u8);
    }
    if tk == TY_I16 {
        return sv_is_3(name, 105u8, 49u8, 54u8);
    }
    if tk == TY_I32 {
        return sv_is_3(name, 105u8, 51u8, 50u8);
    }
    if tk == TY_I64 {
        return sv_is_3(name, 105u8, 54u8, 52u8);
    }
    if tk == TY_ISIZE {
        return sv_is_5(name, 105u8, 115u8, 105u8, 122u8, 101u8);
    }
    if tk == TY_U8 {
        return sv_is_2(name, 117u8, 56u8);
    }
    if tk == TY_U16 {
        return sv_is_3(name, 117u8, 49u8, 54u8);
    }
    if tk == TY_U32 {
        return sv_is_3(name, 117u8, 51u8, 50u8);
    }
    if tk == TY_U64 {
        return sv_is_3(name, 117u8, 54u8, 52u8);
    }
    if tk == TY_USIZE {
        return sv_is_5(name, 117u8, 115u8, 105u8, 122u8, 101u8);
    }
    if tk == TY_BOOL {
        return sv_is_4(name, 98u8, 111u8, 111u8, 108u8);
    }
    if tk == TY_CHAR {
        return sv_is_4(name, 99u8, 104u8, 97u8, 114u8);
    }
    if tk == TY_STR {
        return sv_is_3(name, 115u8, 116u8, 114u8) || sv_is_3(name, 83u8, 116u8, 114u8);
    }
    false
}

pub fn impl_matches_receiver(
    ti: view<TypeInterner>,
    str_in: view<StrInterner>,
    impl_it: *const HirItem,
    receiver_ty: TypeId
) -> bool {
    if (impl_it as usize) == 0 || receiver_ty.v == 0u32 {
        return false;
    }
    let ik = unsafe { (*impl_it).kind };
    let self_hir = unsafe { (*impl_it).self_type };
    if ik != HIR_ITEM_IMPL || (self_hir as usize) == 0 {
        return false;
    }
    let mut rt_v = receiver_ty.v;
    let mut t = type_get(ti, TypeId { v: rt_v });
    while ((t as usize) != 0) {
        let tk = unsafe { (*t).kind };
        if tk == TY_VIEW || tk == TY_MUT_VIEW || tk == TY_PTR {
            rt_v = unsafe { (*t).pointee.v };
            t = type_get(ti, TypeId { v: rt_v });
        } else {
            break;
        }
    }
    if (t as usize) == 0 {
        return false;
    }
    let mut st_hir: *const HirType = self_hir;
    while ((st_hir as usize) != 0) {
        let stk = unsafe { (*st_hir).kind };
        if stk == HIR_TYPE_VIEW || stk == HIR_TYPE_PTR {
            st_hir = unsafe { (*st_hir).elem };
        } else {
            break;
        }
    }
    if (st_hir as usize) == 0 {
        return false;
    }
    let sk = unsafe { (*st_hir).kind };
    if sk == HIR_TYPE_PATH {
        let sym_v = unsafe { (*st_hir).path.symbol.v };
        let name_v = unsafe { (*st_hir).path.name.v };
        let tk = unsafe { (*t).kind };
        let tdef = unsafe { (*t).def };
        if (tk == TY_STRUCT || tk == TY_ENUM) && (tdef as usize) != 0 {
            let def_sym_v = unsafe { (*tdef).symbol.v };
            if sym_v != 0u32 && def_sym_v == sym_v {
                return true;
            }
            let def_name_v = unsafe { (*tdef).name.v };
            if name_v != 0u32 && def_name_v == name_v {
                return true;
            }
        }
        if name_v != 0u32 {
            let name_sv = interner_get(str_in, StrId { v: name_v });
            if prim_kind_matches_name(tk, view(name_sv)) {
                return true;
            }
        }
    }
    false
}

pub fn receiver_matches_impl_self(
    thir: view<Thir>,
    str_in: view<StrInterner>,
    impl_it: *const HirItem,
    base_ty: TypeId
) -> bool {
    let base_v = base_ty.v;
    if (impl_it as usize) == 0 || base_v == 0u32 {
        return false;
    }
    let self_ty_ptr = thir_get_item_type(thir, impl_it);
    if (self_ty_ptr as usize) != 0 {
        let self_ty_v = unsafe { (*self_ty_ptr).v };
        if self_ty_v == base_v {
            return true;
        }
        let b_ptr = type_get(view(thir.interner), TypeId { v: base_v });
        let s_ptr = type_get(view(thir.interner), TypeId { v: self_ty_v });
        if (b_ptr as usize) != 0 && (s_ptr as usize) != 0 {
            let bk = unsafe { (*b_ptr).kind };
            let sk = unsafe { (*s_ptr).kind };
            let b_pt = unsafe { (*b_ptr).pointee.v };
            let s_pt = unsafe { (*s_ptr).pointee.v };
            if bk == TY_VIEW && sk == TY_VIEW && b_pt == s_pt {
                return true;
            }
            if bk == TY_VIEW && b_pt == self_ty_v {
                return true;
            }
            if bk == TY_MUT_VIEW && b_pt == self_ty_v {
                return true;
            }
            if (bk == TY_VIEW || bk == TY_MUT_VIEW) && (sk == TY_STRUCT || sk == TY_ENUM) {
                let inner_ptr = type_get(view(thir.interner), TypeId { v: b_pt });
                if (inner_ptr as usize) != 0 {
                    let ik = unsafe { (*inner_ptr).kind };
                    let idef = unsafe { (*inner_ptr).def as usize };
                    let sdef = unsafe { (*s_ptr).def as usize };
                    if ik == sk && idef != 0 && idef == sdef {
                        return true;
                    }
                }
            }
            if bk == sk && (bk == TY_STRUCT || bk == TY_ENUM) {
                let bdef = unsafe { (*b_ptr).def as usize };
                let sdef = unsafe { (*s_ptr).def as usize };
                if bdef != 0 && bdef == sdef {
                    return true;
                }
            }
        }
        return false;
    }
    impl_matches_receiver(view(thir.interner), str_in, impl_it, TypeId { v: base_v })
}

pub fn find_method_in_impl(
    hir: view<HirFile>,
    impl_it: *const HirItem,
    method_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirItem {
    if (impl_it as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let ik = unsafe { (*impl_it).kind };
    if ik != HIR_ITEM_IMPL {
        return 0 as *mut HirItem;
    }
    let mut m: *mut HirItem = unsafe { (*impl_it).members };
    while ((m as usize) != 0) {
        let mk = unsafe { (*m).kind };
        if mk == HIR_ITEM_FN {
            let m_name = hir_item_name_sv(m, str_in, db);
            if sv_eq(view(m_name), method_name) {
                return m;
            }
        }
        m = unsafe { (*m).next };
    }
    let tp = unsafe { (*impl_it).trait_path };
    if (tp as usize) != 0 {
        let tr_it = find_trait_by_type_path(hir, tp, str_in, db);
        if (tr_it as usize) != 0 {
            return find_trait_default_method(hir, tr_it, method_name, str_in, db);
        }
    }
    0 as *mut HirItem
}

pub fn find_method(
    hir: view<HirFile>,
    thir: view<Thir>,
    base_ty: TypeId,
    method_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    out_res: mut_view<u8>
) -> *mut HirItem {
    *out_res = TRAIT_DISPROVEN;
    let base_v = base_ty.v;
    if base_v == 0u32 {
        return 0 as *mut HirItem;
    }
    let mut found_fn: *mut HirItem = 0 as *mut HirItem;
    let mut match_count: usize = 0;

    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_IMPL && !unsafe { (*it).is_negative } {
            if receiver_matches_impl_self(thir, str_in, it, (TypeId { v: base_v })) {
                let m = find_method_in_impl(hir, it, method_name, str_in, db);
                if (m as usize) != 0 {
                    found_fn = m;
                    match_count = match_count + 1;
                }
            }
        } else if ik == HIR_ITEM_TRAIT {
            let mut check_v = base_v;
            let b_ptr = type_get(view(thir.interner), TypeId { v: base_v });
            if (b_ptr as usize) != 0 {
                let bk = unsafe { (*b_ptr).kind };
                if bk == TY_VIEW || bk == TY_MUT_VIEW {
                    check_v = unsafe { (*b_ptr).pointee.v };
                }
            }
            let c_ptr = type_get(view(thir.interner), TypeId { v: check_v });
            if (c_ptr as usize) != 0 && unsafe { (*c_ptr).kind } == TY_PARAM {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while ((m as usize) != 0) {
                    if unsafe { (*m).kind } == HIR_ITEM_FN {
                        let m_name = hir_item_name_sv(m, str_in, db);
                        if sv_eq(view(m_name), method_name) {
                            found_fn = m;
                            match_count = match_count + 1;
                        }
                    }
                    m = unsafe { (*m).next };
                }
            } else if (c_ptr as usize) != 0 && unsafe { (*c_ptr).kind } == TY_COROUTINE && (found_fn as usize) == 0 {
                let tr_name = hir_item_name_sv(it, str_in, db);
                if sv_is_6(view(tr_name), 70u8, 117u8, 116u8, 117u8, 114u8, 101u8) {
                    let mut m: *mut HirItem = unsafe { (*it).members };
                    while ((m as usize) != 0) {
                        if unsafe { (*m).kind } == HIR_ITEM_FN {
                            let m_name = hir_item_name_sv(m, str_in, db);
                            if sv_eq(view(m_name), method_name) {
                                found_fn = m;
                                match_count = match_count + 1;
                                break;
                            }
                        }
                        m = unsafe { (*m).next };
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }

    if match_count == 1 {
        *out_res = TRAIT_PROVEN;
        return found_fn;
    }
    if match_count > 1 {
        *out_res = TRAIT_AMBIGUOUS;
        return 0 as *mut HirItem;
    }
    *out_res = TRAIT_DISPROVEN;
    0 as *mut HirItem
}

pub fn resolve_assoc_type_in_impl(
    hir: view<HirFile>,
    impl_it: *const HirItem,
    assoc_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirType {
    if (impl_it as usize) == 0 {
        return 0 as *mut HirType;
    }
    let ik = unsafe { (*impl_it).kind };
    if ik != HIR_ITEM_IMPL || unsafe { (*impl_it).is_negative } {
        return 0 as *mut HirType;
    }
    let mut m: *mut HirItem = unsafe { (*impl_it).members };
    while ((m as usize) != 0) {
        let mk = unsafe { (*m).kind };
        let mty = unsafe { (*m).ty };
        if mk == HIR_ITEM_TYPE_ALIAS && (mty as usize) != 0 {
            let m_name = hir_item_name_sv(m, str_in, db);
            if sv_eq(view(m_name), assoc_name) {
                return mty;
            }
        }
        m = unsafe { (*m).next };
    }
    let tp = unsafe { (*impl_it).trait_path };
    if (tp as usize) != 0 {
        let tr_it = find_trait_by_type_path(hir, tp, str_in, db);
        if (tr_it as usize) != 0 {
            let mut tm: *mut HirItem = unsafe { (*tr_it).members };
            while ((tm as usize) != 0) {
                let tmk = unsafe { (*tm).kind };
                let tmty = unsafe { (*tm).ty };
                if tmk == HIR_ITEM_TYPE_ALIAS && (tmty as usize) != 0 {
                    let tm_name = hir_item_name_sv(tm, str_in, db);
                    if sv_eq(view(tm_name), assoc_name) {
                        return tmty;
                    }
                }
                tm = unsafe { (*tm).next };
            }
        }
    }
    0 as *mut HirType
}

pub fn resolve_assoc_type(
    hir: view<HirFile>,
    thir: view<Thir>,
    self_ty: TypeId,
    assoc_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirType {
    let self_v = self_ty.v;
    if self_v == 0u32 {
        return 0 as *mut HirType;
    }
    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        if unsafe { (*it).kind } == HIR_ITEM_IMPL && !unsafe { (*it).is_negative } {
            if receiver_matches_impl_self(thir, str_in, it, (TypeId { v: self_v })) {
                let found = resolve_assoc_type_in_impl(hir, it, assoc_name, str_in, db);
                if (found as usize) != 0 {
                    return found;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirType
}

pub fn is_callable_trait_name(tr_name: view<StrView>) -> bool {
    if sv_is_2(tr_name, 70u8, 110u8) {
        return true;
    }
    if sv_is_5(tr_name, 70u8, 110u8, 77u8, 117u8, 116u8) {
        return true;
    }
    if sv_is_6(tr_name, 70u8, 110u8, 79u8, 110u8, 99u8, 101u8) {
        return true;
    }
    if sv_is_8(tr_name, 67u8, 97u8, 108u8, 108u8, 97u8, 98u8, 108u8, 101u8) {
        return true;
    }
    false
}

pub fn satisfies_callable_bound(
    ti: view<TypeInterner>,
    arg_ty: TypeId,
    tr_name: view<StrView>
) -> bool {
    let t = type_get(ti, arg_ty);
    if (t as usize) == 0 {
        return false;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_FN {
        return true;
    }
    if tk == TY_CLOSURE {
        let ccount = unsafe { (*t).capture_count };
        let caps = unsafe { (*t).captures };
        if sv_is_2(tr_name, 70u8, 110u8) {
            let mut i: usize = 0;
            while (i < ccount) {
                let cap = unsafe { capture_at(caps, i) };
                let mode = unsafe { (*cap).mode };
                if mode == CAP_MUT_VIEW || mode == CAP_MOVE {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        if sv_is_5(tr_name, 70u8, 110u8, 77u8, 117u8, 116u8) {
            let mut i: usize = 0;
            while (i < ccount) {
                let cap = unsafe { capture_at(caps, i) };
                let mode = unsafe { (*cap).mode };
                if mode == CAP_MOVE {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        return true;
    }
    false
}

pub fn is_send_trait_name(tr_name: view<StrView>) -> bool {
    sv_is_4(tr_name, 83u8, 101u8, 110u8, 100u8)
}

pub fn is_share_trait_name(tr_name: view<StrView>) -> bool {
    sv_is_5(tr_name, 83u8, 104u8, 97u8, 114u8, 101u8)
}

pub fn is_future_trait_name(tr_name: view<StrView>) -> bool {
    sv_is_6(tr_name, 70u8, 117u8, 116u8, 117u8, 114u8, 101u8)
}

fn trait_auto_kind(
    hir: view<HirFile>,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> u8 {
    if tr_sym_v == 10007u32 || is_send_trait_name(tr_name) {
        return 1u8;
    }
    if tr_sym_v == 10008u32 || is_share_trait_name(tr_name) {
        return 2u8;
    }
    let tr_it = find_trait_item(hir, SymbolId { v: tr_sym_v }, tr_name, str_in, db);
    if (tr_it as usize) != 0 && unsafe { (*tr_it).is_auto } {
        return 3u8;
    }
    0u8
}

fn impl_trait_matches_target(
    tp: *const HirType,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> bool {
    if (tp as usize) == 0 || unsafe { (*tp).kind } != HIR_TYPE_PATH {
        return false;
    }
    let impl_tr_sym_v = unsafe { (*tp).path.symbol.v };
    let impl_tr_name = hir_type_path_name_sv(tp, str_in, db);
    if auto_kind == 1u8 {
        return impl_tr_sym_v == 10007u32 || is_send_trait_name(view(impl_tr_name));
    }
    if auto_kind == 2u8 {
        return impl_tr_sym_v == 10008u32 || is_share_trait_name(view(impl_tr_name));
    }
    if tr_sym_v != 0u32 && impl_tr_sym_v == tr_sym_v {
        return true;
    }
    if tr_name.len > 0 && sv_eq(tr_name, view(impl_tr_name)) {
        return true;
    }
    false
}

pub fn type_matches_impl_self_exact(
    thir: view<Thir>,
    str_in: view<StrInterner>,
    impl_it: *const HirItem,
    target_ty: TypeId
) -> bool {
    let base_v = target_ty.v;
    if (impl_it as usize) == 0 || base_v == 0u32 {
        return false;
    }
    let self_ty_ptr = thir_get_item_type(thir, impl_it);
    if (self_ty_ptr as usize) != 0 {
        let self_ty_v = unsafe { (*self_ty_ptr).v };
        if self_ty_v != 0u32 {
            if self_ty_v == base_v {
                return true;
            }
            let b_ptr = type_get(view(thir.interner), TypeId { v: base_v });
            let s_ptr = type_get(view(thir.interner), TypeId { v: self_ty_v });
            if (b_ptr as usize) != 0 && (s_ptr as usize) != 0 {
                let bk = unsafe { (*b_ptr).kind };
                let sk = unsafe { (*s_ptr).kind };
                if bk != sk {
                    return false;
                }
                if bk == TY_STRUCT || bk == TY_ENUM {
                    let bdef = unsafe { (*b_ptr).def as usize };
                    let sdef = unsafe { (*s_ptr).def as usize };
                    if bdef == 0 || bdef != sdef {
                        return false;
                    }
                    let sac = unsafe { (*s_ptr).arg_count };
                    let bac = unsafe { (*b_ptr).arg_count };
                    let sargs = unsafe { (*s_ptr).args };
                    let bargs = unsafe { (*b_ptr).args };
                    let mut i: usize = 0;
                    while i < sac && i < bac {
                        let sa_v = unsafe { (*typeid_at(sargs, i)).v };
                        let ba_v = unsafe { (*typeid_at(bargs, i)).v };
                        let sa_t = type_get(view(thir.interner), TypeId { v: sa_v });
                        if (sa_t as usize) != 0 && unsafe { (*sa_t).kind } != TY_PARAM && sa_v != ba_v {
                            return false;
                        }
                        i = i + 1;
                    }
                    return true;
                }
                if bk == TY_VIEW || bk == TY_MUT_VIEW || bk == TY_PTR {
                    if bk == TY_PTR && unsafe { (*b_ptr).is_mut != (*s_ptr).is_mut } {
                        return false;
                    }
                    let spt_v = unsafe { (*s_ptr).pointee.v };
                    let bpt_v = unsafe { (*b_ptr).pointee.v };
                    let spt_t = type_get(view(thir.interner), TypeId { v: spt_v });
                    if (spt_t as usize) != 0 && unsafe { (*spt_t).kind } == TY_PARAM {
                        return true;
                    }
                    return spt_v == bpt_v;
                }
            }
            return false;
        }
    }
    let self_hir = unsafe { (*impl_it).self_type };
    let t = type_get(view(thir.interner), TypeId { v: base_v });
    if (self_hir as usize) == 0 || (t as usize) == 0 {
        return false;
    }
    let tk = unsafe { (*t).kind };
    let sk = unsafe { (*self_hir).kind };
    if sk == HIR_TYPE_VIEW {
        let is_m = unsafe { (*self_hir).is_mut };
        return (tk == TY_VIEW && !is_m) || (tk == TY_MUT_VIEW && is_m);
    }
    if sk == HIR_TYPE_PTR {
        return tk == TY_PTR && unsafe { (*t).is_mut == (*self_hir).is_mut };
    }
    if sk == HIR_TYPE_PATH {
        let sym_v = unsafe { (*self_hir).path.symbol.v };
        let name_v = unsafe { (*self_hir).path.name.v };
        let tdef = unsafe { (*t).def };
        if (tk == TY_STRUCT || tk == TY_ENUM) && (tdef as usize) != 0 {
            let def_sym_v = unsafe { (*tdef).symbol.v };
            if sym_v != 0u32 && def_sym_v == sym_v {
                return true;
            }
            let def_name_v = unsafe { (*tdef).name.v };
            if name_v != 0u32 && def_name_v == name_v {
                return true;
            }
        }
        if name_v != 0u32 {
            let name_sv = interner_get(str_in, StrId { v: name_v });
            if prim_kind_matches_name(tk, view(name_sv)) {
                return true;
            }
        }
    }
    false
}

fn get_target_ty_generic_arg(thir: view<Thir>, target_ty: TypeId, p_idx: usize) -> TypeId {
    let t = type_get(view(thir.interner), target_ty);
    if (t as usize) == 0 {
        return TypeId { v: 0u32 };
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_STRUCT || tk == TY_ENUM {
        let ac = unsafe { (*t).arg_count };
        let aptr = unsafe { (*t).args };
        if p_idx < ac && (aptr as usize) != 0 {
            return unsafe { *typeid_at(aptr, p_idx) };
        }
    } else if (tk == TY_VIEW || tk == TY_MUT_VIEW || tk == TY_PTR) && p_idx == 0 {
        return unsafe { (*t).pointee };
    } else if (tk == TY_ARRAY || tk == TY_SLICE) && p_idx == 0 {
        return unsafe { (*t).elem };
    }
    TypeId { v: 0u32 }
}

fn impl_bounds_satisfied(
    hir: view<HirFile>,
    thir: view<Thir>,
    impl_it: *const HirItem,
    target_ty: TypeId,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    depth: usize
) -> bool {
    let target_v: u32 = target_ty.v;
    if (impl_it as usize) == 0 {
        return true;
    }
    let gps = unsafe { (*impl_it).generic_params };
    if (gps as usize) == 0 {
        return true;
    }
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    let mut p_idx: usize = 0;
    while (gp as usize) != 0 {
        let arg_ty = get_target_ty_generic_arg(thir, (TypeId { v: target_v }), p_idx);
        let arg_v: u32 = arg_ty.v;
        if arg_v != 0u32 {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while (b as usize) != 0 {
                if !satisfies_bound_depth(hir, thir, (TypeId { v: arg_v }), b, str_in, db, depth + 1) {
                    return false;
                }
                b = unsafe { (*b).next };
            }
        }
        gp = unsafe { (*gp).next };
        p_idx = p_idx + 1;
    }
    let wc = unsafe { (*impl_it).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while (wp as usize) != 0 {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 && unsafe { (*wty).kind } == HIR_TYPE_PATH {
                let wp_name = hir_type_path_name_sv(wty, str_in, db);
                let mut gp2: *mut HirGenericParam = unsafe { (*gps).params };
                let mut idx2: usize = 0;
                while (gp2 as usize) != 0 {
                    let gp_name = hir_generic_param_name_sv(gp2, str_in, db);
                    if sv_eq(view(wp_name), view(gp_name)) {
                        let arg_ty2 = get_target_ty_generic_arg(thir, (TypeId { v: target_v }), idx2);
                        let arg_v2: u32 = arg_ty2.v;
                        if arg_v2 != 0u32 {
                            let mut wb: *mut HirType = unsafe { (*wp).bounds };
                            while (wb as usize) != 0 {
                                if !satisfies_bound_depth(hir, thir, (TypeId { v: arg_v2 }), wb, str_in, db, depth + 1) {
                                    return false;
                                }
                                wb = unsafe { (*wb).next };
                            }
                        }
                        break;
                    }
                    gp2 = unsafe { (*gp2).next };
                    idx2 = idx2 + 1;
                }
            }
            wp = unsafe { (*wp).next };
        }
    }
    true
}

fn bound_implies_trait(
    hir: view<HirFile>,
    b: *const HirType,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    depth: usize
) -> bool {
    if (b as usize) == 0 || depth > 16 || unsafe { (*b).kind } != HIR_TYPE_PATH {
        return false;
    }
    if impl_trait_matches_target(b, auto_kind, tr_sym_v, tr_name, str_in, db) {
        return true;
    }
    let b_sym_v = unsafe { (*b).path.symbol.v };
    let b_name = hir_type_path_name_sv(b, str_in, db);
    let b_tr = find_trait_item(hir, SymbolId { v: b_sym_v }, view(b_name), str_in, db);
    if (b_tr as usize) != 0 {
        let mut st: *mut HirType = unsafe { (*b_tr).supertraits };
        while (st as usize) != 0 {
            if bound_implies_trait(hir, st, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                return true;
            }
            st = unsafe { (*st).next };
        }
    }
    false
}

fn item_declares_param_bound(
    hir: view<HirFile>,
    it: *const HirItem,
    param_name: view<StrView>,
    param_idx: u32,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    let mut actual_name = StrView { ptr: param_name.ptr, len: param_name.len };
    let gps = unsafe { (*it).generic_params };
    if (gps as usize) != 0 {
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        let mut idx: u32 = 0u32;
        while (gp as usize) != 0 {
            let gp_name = hir_generic_param_name_sv(gp, str_in, db);
            if idx == param_idx && gp_name.len > 0 {
                actual_name = gp_name;
            }
            let name_match = idx == param_idx || (param_name.len > 0 && gp_name.len > 0 && sv_eq(param_name, view(gp_name)));
            if name_match {
                let mut b: *mut HirType = unsafe { (*gp).bounds };
                while (b as usize) != 0 {
                    if bound_implies_trait(hir, b, auto_kind, tr_sym_v, tr_name, str_in, db, 0) {
                        return true;
                    }
                    b = unsafe { (*b).next };
                }
            }
            gp = unsafe { (*gp).next };
            idx = idx + 1u32;
        }
    }
    let wc = unsafe { (*it).where_clause };
    if (wc as usize) != 0 && (actual_name.len > 0 || param_name.len > 0) {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while (wp as usize) != 0 {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 && unsafe { (*wty).kind } == HIR_TYPE_PATH {
                let wp_name = hir_type_path_name_sv(wty, str_in, db);
                if (actual_name.len > 0 && sv_eq(view(actual_name), view(wp_name))) ||
                   (param_name.len > 0 && sv_eq(param_name, view(wp_name))) {
                    let mut wb: *mut HirType = unsafe { (*wp).bounds };
                    while (wb as usize) != 0 {
                        if bound_implies_trait(hir, wb, auto_kind, tr_sym_v, tr_name, str_in, db, 0) {
                            return true;
                        }
                        wb = unsafe { (*wb).next };
                    }
                }
            }
            wp = unsafe { (*wp).next };
        }
    }
    false
}

fn param_satisfies_auto_trait(
    hir: view<HirFile>,
    thir: view<Thir>,
    param_t: *const AxType,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> bool {
    if (param_t as usize) == 0 {
        return true;
    }
    let caller_fn_ptr = ptr_itemmap_get(view(thir.expr_methods), 1usize);
    if (caller_fn_ptr as usize) == 0 {
        return true;
    }
    let caller_fn = unsafe { *caller_fn_ptr };
    if (caller_fn as usize) == 0 {
        return true;
    }
    let p_name_v = unsafe { (*param_t).name.v };
    let p_name = if p_name_v != 0u32 {
        interner_get(str_in, (StrId { v: p_name_v }))
    } else {
        StrView { ptr: 0 as *const u8, len: 0 }
    };
    let p_idx = unsafe { (*param_t).param_index };
    if item_declares_param_bound(hir, caller_fn, view(p_name), p_idx, auto_kind, tr_sym_v, tr_name, str_in, db) {
        return true;
    }
    let caller_impl_ptr = ptr_itemmap_get(view(thir.expr_methods), 3usize);
    if (caller_impl_ptr as usize) != 0 {
        let caller_impl = unsafe { *caller_impl_ptr };
        if (caller_impl as usize) != 0 {
            if item_declares_param_bound(hir, caller_impl, view(p_name), p_idx, auto_kind, tr_sym_v, tr_name, str_in, db) {
                return true;
            }
        }
    }
    false
}

pub fn type_satisfies_auto_trait(
    hir: view<HirFile>,
    thir: view<Thir>,
    ty_id: TypeId,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    depth: usize
) -> bool {
    if depth > 32 {
        return true;
    }
    let arg_v = ty_id.v;
    let err_v = thir.interner.t_error.v;
    if arg_v == 0u32 || arg_v == err_v {
        return true;
    }
    let t = type_get(view(thir.interner), TypeId { v: arg_v });
    if (t as usize) == 0 {
        return true;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_ERROR || tk == TY_VAR || tk == TY_INT_VAR || tk == TY_NEVER || tk == TY_UNIT {
        return true;
    }
    if tk == TY_PARAM {
        return param_satisfies_auto_trait(hir, thir, t, auto_kind, tr_sym_v, tr_name, str_in, db);
    }

    // 1. Check explicit positive and negative impls for this exact type constructor.
    let mut saw_positive_impl: bool = false;
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        let tp = unsafe { (*it).trait_path };
        if ik == HIR_ITEM_IMPL && (tp as usize) != 0 {
            if impl_trait_matches_target(tp, auto_kind, tr_sym_v, tr_name, str_in, db) {
                if type_matches_impl_self_exact(thir, str_in, it, (TypeId { v: arg_v })) {
                    if unsafe { (*it).is_negative } {
                        if impl_bounds_satisfied(hir, thir, it, (TypeId { v: arg_v }), str_in, db, depth + 1) {
                            return false;
                        }
                    } else {
                        saw_positive_impl = true;
                        if impl_bounds_satisfied(hir, thir, it, (TypeId { v: arg_v }), str_in, db, depth + 1) {
                            return true;
                        }
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
    if saw_positive_impl {
        return false;
    }

    // 2. Built-in type rules (AXS-CONC-013..016).
    if tk == TY_BOOL || tk == TY_CHAR || tk == TY_STR || tk == TY_FN || (tk >= TY_I8 && tk <= TY_USIZE) {
        return true;
    }
    if tk == TY_PTR {
        return false;
    }
    if tk == TY_VIEW {
        let pt = unsafe { (*t).pointee };
        if auto_kind == 1u8 || auto_kind == 2u8 {
            return type_satisfies_auto_trait(hir, thir, pt, 2u8, 10008u32, tr_name, str_in, db, depth + 1);
        }
        return type_satisfies_auto_trait(hir, thir, pt, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1);
    }
    if tk == TY_MUT_VIEW {
        if auto_kind == 2u8 {
            return false;
        }
        let pt = unsafe { (*t).pointee };
        if auto_kind == 1u8 {
            return type_satisfies_auto_trait(hir, thir, pt, 1u8, 10007u32, tr_name, str_in, db, depth + 1);
        }
        return type_satisfies_auto_trait(hir, thir, pt, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1);
    }
    if tk == TY_ARRAY || tk == TY_SLICE {
        let el = unsafe { (*t).elem };
        return type_satisfies_auto_trait(hir, thir, el, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1);
    }
    if tk == TY_TUPLE || tk == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let flds = unsafe { (*t).fields };
        let mut i: usize = 0;
        while i < fc {
            let ft = unsafe { *typeid_at(flds, i) };
            if !type_satisfies_auto_trait(hir, thir, ft, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if tk == TY_ENUM {
        let vc = unsafe { (*t).variant_count };
        let vf_arr = unsafe { (*t).variant_fields };
        let vfc_arr = unsafe { (*t).variant_field_counts };
        if (vf_arr as usize) != 0 && (vfc_arr as usize) != 0 {
            let mut v: usize = 0;
            while v < vc {
                let fc = unsafe { *usize_at(vfc_arr, v) };
                let row = unsafe { *typeid_ptr_at(vf_arr, v) };
                if (row as usize) != 0 {
                    let mut f: usize = 0;
                    while f < fc {
                        let ft = unsafe { *typeid_at(row, f) };
                        if !type_satisfies_auto_trait(hir, thir, ft, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                            return false;
                        }
                        f = f + 1;
                    }
                }
                v = v + 1;
            }
        }
        return true;
    }
    if tk == TY_CLOSURE {
        let ccnt = unsafe { (*t).capture_count };
        let caps = unsafe { (*t).captures };
        let mut i: usize = 0;
        while i < ccnt {
            let cap = unsafe { capture_at(caps, i) };
            let mode = unsafe { (*cap).mode };
            let cty_v = unsafe { (*cap).ty.v };
            let ct = type_get(view(thir.interner), (TypeId { v: cty_v }));
            let ctk = if (ct as usize) != 0 { unsafe { (*ct).kind } } else { TY_ERROR };
            if mode == CAP_MUT_VIEW {
                if auto_kind == 2u8 {
                    return false;
                }
                let inner_v = if ctk == TY_MUT_VIEW { unsafe { (*ct).pointee.v } } else { cty_v };
                if auto_kind == 1u8 {
                    if !type_satisfies_auto_trait(hir, thir, (TypeId { v: inner_v }), 1u8, 10007u32, tr_name, str_in, db, depth + 1) {
                        return false;
                    }
                } else if !type_satisfies_auto_trait(hir, thir, (TypeId { v: inner_v }), auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                    return false;
                }
            } else if mode == CAP_VIEW {
                let inner_v = if ctk == TY_VIEW { unsafe { (*ct).pointee.v } } else { cty_v };
                if auto_kind == 1u8 || auto_kind == 2u8 {
                    if !type_satisfies_auto_trait(hir, thir, (TypeId { v: inner_v }), 2u8, 10008u32, tr_name, str_in, db, depth + 1) {
                        return false;
                    }
                } else if !type_satisfies_auto_trait(hir, thir, (TypeId { v: inner_v }), auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                    return false;
                }
            } else {
                if !type_satisfies_auto_trait(hir, thir, (TypeId { v: cty_v }), auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }
    if tk == TY_COROUTINE {
        if auto_kind == 2u8 {
            return false;
        }
        let ret_ty = unsafe { (*t).ret_type };
        if !type_satisfies_auto_trait(hir, thir, ret_ty, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
            return false;
        }
        let ac = unsafe { (*t).arg_count };
        let aptr = unsafe { (*t).args };
        let mut i: usize = 0;
        while i < ac {
            let at = unsafe { *typeid_at(aptr, i) };
            if !type_satisfies_auto_trait(hir, thir, at, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    true
}

fn satisfies_bound_depth(
    hir: view<HirFile>,
    thir: view<Thir>,
    arg_ty: TypeId,
    bound: *const HirType,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    depth: usize
) -> bool {
    if depth > 32 {
        return true;
    }
    if (bound as usize) == 0 {
        return true;
    }
    let bk = unsafe { (*bound).kind };
    if bk != HIR_TYPE_PATH {
        return true;
    }
    let arg_v = arg_ty.v;
    let err_v = thir.interner.t_error.v;
    if arg_v == 0u32 || arg_v == err_v {
        return true;
    }
    let t = type_get(view(thir.interner), TypeId { v: arg_v });
    if (t as usize) == 0 {
        return true;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_ERROR || tk == TY_VAR || tk == TY_INT_VAR {
        return true;
    }

    let tr_sym_v = unsafe { (*bound).path.symbol.v };
    let tr_name = hir_type_path_name_sv(bound, str_in, db);
    let ak = trait_auto_kind(hir, tr_sym_v, view(tr_name), str_in, db);
    if ak != 0u8 {
        return type_satisfies_auto_trait(hir, thir, TypeId { v: arg_v }, ak, tr_sym_v, view(tr_name), str_in, db, depth);
    }

    if tk == TY_PARAM {
        return true;
    }

    if tk == TY_COROUTINE && is_future_trait_name(view(tr_name)) {
        return true;
    }

    if is_callable_trait_name(view(tr_name)) {
        return satisfies_callable_bound(view(thir.interner), TypeId { v: arg_v }, view(tr_name));
    }

    // Copy bound check via built-in / @derive(Copy) rules before scanning impl blocks
    if sv_is_4(view(tr_name), 67u8, 111u8, 112u8, 121u8) {
        if type_is_copy((TypeId { v: arg_v }), thir, str_in) {
            return true;
        }
    }

    let tr_name_len: usize = tr_name.len;
    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        let ik = unsafe { (*it).kind };
        let tp = unsafe { (*it).trait_path };
        if ik == HIR_ITEM_IMPL && (tp as usize) != 0 {
            let tpk = unsafe { (*tp).kind };
            if tpk == HIR_TYPE_PATH {
                let mut trait_match: bool = false;
                let impl_tr_sym_v = unsafe { (*tp).path.symbol.v };
                if tr_sym_v != 0u32 && impl_tr_sym_v == tr_sym_v {
                    trait_match = true;
                } else {
                    let impl_tr_name = hir_type_path_name_sv(tp, str_in, db);
                    if tr_name_len > 0 && sv_eq(view(tr_name), view(impl_tr_name)) {
                        trait_match = true;
                    }
                }
                if trait_match {
                    if unsafe { (*it).is_negative } {
                        if type_matches_impl_self_exact(thir, str_in, it, (TypeId { v: arg_v })) &&
                           impl_bounds_satisfied(hir, thir, it, (TypeId { v: arg_v }), str_in, db, depth + 1) {
                            return false;
                        }
                    } else if receiver_matches_impl_self(thir, str_in, it, (TypeId { v: arg_v })) &&
                              impl_bounds_satisfied(hir, thir, it, (TypeId { v: arg_v }), str_in, db, depth + 1) {
                        return true;
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

pub fn satisfies_bound(
    hir: view<HirFile>,
    thir: view<Thir>,
    arg_ty: TypeId,
    bound: *const HirType,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> bool {
    satisfies_bound_depth(hir, thir, arg_ty, bound, str_in, db, 0)
}

