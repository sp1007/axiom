@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// "entry function 'main' not found" (31 bytes) + "MIR syntax error" (16 bytes)
const SESSION_MSG_BYTES: [47]u8 = [
    101u8, 110u8, 116u8, 114u8, 121u8, 32u8, 102u8, 117u8, 110u8, 99u8, 116u8, 105u8, 111u8, 110u8, 32u8, 39u8,
    109u8, 97u8, 105u8, 110u8, 39u8, 32u8, 110u8, 111u8, 116u8, 32u8, 102u8, 111u8, 117u8, 110u8, 100u8,
    77u8, 73u8, 82u8, 32u8, 115u8, 121u8, 110u8, 116u8, 97u8, 120u8, 32u8, 101u8, 114u8, 114u8, 111u8, 114u8
];

// "intrinsic" (9 bytes) + "main" (4 bytes)
const SESSION_IDENT_BYTES: [13]u8 = [
    105u8, 110u8, 116u8, 114u8, 105u8, 110u8, 115u8, 105u8, 99u8,
    109u8, 97u8, 105u8, 110u8
];

fn interner_mut_ptr(s: mut_view<StrInterner>) -> *mut StrInterner {
    unsafe { address_of_mut(s.bytes.head) as *mut StrInterner }
}

fn source_db_const_ptr(db: view<SourceDatabase>) -> *const SourceDatabase {
    unsafe { address_of(db.arena.head) as *const SourceDatabase }
}

fn diag_sink_mut_ptr(s: mut_view<DiagSink>) -> *mut DiagSink {
    unsafe { address_of_mut(s.arena.head) as *mut DiagSink }
}

fn thir_mut_ptr(t: mut_view<Thir>) -> *mut Thir {
    unsafe { address_of_mut(t.interner.arena.head) as *mut Thir }
}

fn thir_const_ptr(t: view<Thir>) -> *const Thir {
    unsafe { address_of(t.interner.arena.head) as *const Thir }
}

fn hir_const_ptr(h: view<HirFile>) -> *const HirFile {
    unsafe { address_of(h.items) as *const HirFile }
}

fn rmap_const_ptr(r: view<ResolveMap>) -> *const ResolveMap {
    unsafe { address_of(r.node_map.keys) as *const ResolveMap }
}

fn ast_const_ptr(a: view<Ast>) -> *const Ast {
    unsafe { address_of(a.items) as *const Ast }
}

fn diag_buf_mut_ptr(b: mut_view<DiagBuffer>) -> *mut DiagBuffer {
    unsafe { address_of_mut(b.ptr) as *mut DiagBuffer }
}

fn mir_body_map_mut_ptr(m: mut_view<MirBodyMap>) -> *mut MirBodyMap {
    unsafe { address_of_mut(m.entries) as *mut MirBodyMap }
}

fn sv_matches_ident_slice(sv: view<StrView>, start: usize, slen: usize) -> bool {
    if sv.len != slen || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < slen {
        if (unsafe { *(sv.ptr + i) }) != SESSION_IDENT_BYTES[start + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn emit_session_diag(sink: mut_view<DiagSink>, code_v: u32, sp: view<Span>, msg_start: usize, msg_len: usize) {
    let buf = arena_alloc_raw(mut_view(sink.arena), msg_len + 1, 1);
    let mut i: usize = 0;
    while i < msg_len {
        unsafe {
            *(buf + i) = SESSION_MSG_BYTES[msg_start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + msg_len) = 0u8;
    }
    let d = Diagnostic {
        code: DiagCode { v: code_v },
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf as *const u8, len: msg_len },
        primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

unsafe fn diag_at_mut(base: *mut Diagnostic, idx: usize) -> *mut Diagnostic {
    ((base as usize) + interp_mul_usize(idx, size_of<Diagnostic>())) as *mut Diagnostic
}

// =============================================================================
// Comptime Type Validation & Array-Length Diagnostic Fixup
// =============================================================================

pub fn session_is_valid_const_type(thir: view<Thir>, ty_id: TypeId) -> bool {
    if ty_id.v == 0u32 {
        return false;
    }
    let ty = type_get(view(thir.interner), ty_id);
    if (ty as usize) == 0 {
        return false;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_ERROR || k == TY_UNIT || k == TY_BOOL || k == TY_CHAR || k == TY_STR || k == TY_INT_VAR {
        return true;
    }
    if k >= TY_I8 && k <= TY_USIZE {
        return true;
    }
    if k == TY_ARRAY {
        let el_v = unsafe { (*ty).elem.v };
        return session_is_valid_const_type(thir, TypeId { v: el_v });
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let fcnt = unsafe { (*ty).field_count };
        let flds = unsafe { (*ty).fields };
        let mut i: usize = 0;
        while i < fcnt {
            let fv = unsafe { (*typeid_at(flds, i)).v };
            if !session_is_valid_const_type(thir, (TypeId { v: fv })) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if k == TY_ENUM {
        let vcnt = unsafe { (*ty).variant_count };
        let vfcnts = unsafe { (*ty).variant_field_counts };
        let mut i: usize = 0;
        while i < vcnt {
            let fc = unsafe { *usize_at(vfcnts, i) };
            if fc > 0 {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    false
}

fn rewrite_mismatch_diag_at_span(sink: mut_view<DiagSink>, sp: view<Span>, new_code_v: u32, new_sp: view<Span>) -> bool {
    let mut found = false;
    let mut i: usize = 0;
    while i < sink.len {
        let d = unsafe { diag_at_mut(sink.diags, i) };
        let dc = unsafe { (*d).code.v };
        let df = unsafe { (*d).primary.file.v };
        let ds = unsafe { (*d).primary.start };
        let de = unsafe { (*d).primary.end };
        if dc == AX_TYPE_MISMATCH && df == sp.file.v && ds == sp.start && de == sp.end {
            unsafe {
                (*d).code.v = new_code_v;
                (*d).primary.file.v = new_sp.file.v;
                (*d).primary.start = new_sp.start;
                (*d).primary.end = new_sp.end;
            }
            found = true;
        }
        i = i + 1;
    }
    found
}

fn walk_hir_type_fixup_array_len(sink: mut_view<DiagSink>, ty: *const HirType) {
    if (ty as usize) == 0 {
        return;
    }
    let k = unsafe { (*ty).kind };
    if k == HIR_TYPE_ARRAY {
        let cnt_expr = unsafe { (*ty).count_expr as *const HirExpr };
        if (cnt_expr as usize) != 0 {
            let sp = unsafe { (*cnt_expr).span };
            let _ = rewrite_mismatch_diag_at_span(mut_view(*sink), view(sp), AX_TYPE_ARRAY_SIZE, view(sp));
        }
        let elem = unsafe { (*ty).elem as *const HirType };
        walk_hir_type_fixup_array_len(mut_view(*sink), elem);
    } else if k == HIR_TYPE_SLICE || k == HIR_TYPE_PTR || k == HIR_TYPE_VIEW {
        let elem = unsafe { (*ty).elem as *const HirType };
        walk_hir_type_fixup_array_len(mut_view(*sink), elem);
    } else if k == HIR_TYPE_TUPLE {
        let mut el: *const HirType = unsafe { (*ty).elem_types as *const HirType };
        while (el as usize) != 0 {
            walk_hir_type_fixup_array_len(mut_view(*sink), el);
            el = unsafe { (*el).next as *const HirType };
        }
    } else if k == HIR_TYPE_FN {
        let mut pt: *const HirType = unsafe { (*ty).param_types as *const HirType };
        while (pt as usize) != 0 {
            walk_hir_type_fixup_array_len(mut_view(*sink), pt);
            pt = unsafe { (*pt).next as *const HirType };
        }
        let rty = unsafe { (*ty).ret_type as *const HirType };
        walk_hir_type_fixup_array_len(mut_view(*sink), rty);
    }
}

fn walk_hir_expr_fixup_array_len(sink: mut_view<DiagSink>, expr: *const HirExpr) {
    if (expr as usize) == 0 {
        return;
    }
    let k = unsafe { (*expr).kind };
    if k == HIR_EXPR_BLOCK || k == HIR_EXPR_LOOP {
        let blk = unsafe { (*expr).block as *const HirBlock };
        walk_hir_block_fixup_array_len(mut_view(*sink), blk);
    } else if k == HIR_EXPR_IF {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).cond as *const HirExpr });
        walk_hir_block_fixup_array_len(mut_view(*sink), unsafe { (*expr).block as *const HirBlock });
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).else_branch as *const HirExpr });
    } else if k == HIR_EXPR_WHILE {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).cond as *const HirExpr });
        walk_hir_block_fixup_array_len(mut_view(*sink), unsafe { (*expr).block as *const HirBlock });
    } else if k == HIR_EXPR_FOR {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).iter as *const HirExpr });
        walk_hir_block_fixup_array_len(mut_view(*sink), unsafe { (*expr).block as *const HirBlock });
    } else if k == HIR_EXPR_MATCH {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).cond as *const HirExpr });
        let mut arm: *const HirMatchArm = unsafe { (*expr).arms as *const HirMatchArm };
        while (arm as usize) != 0 {
            walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*arm).guard as *const HirExpr });
            walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*arm).body as *const HirExpr });
            arm = unsafe { (*arm).next as *const HirMatchArm };
        }
    } else if k == HIR_EXPR_CAST {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).inner as *const HirExpr });
        walk_hir_type_fixup_array_len(mut_view(*sink), unsafe { (*expr).cast_ty as *const HirType });
    } else if k == HIR_EXPR_BINARY {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).left as *const HirExpr });
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).right as *const HirExpr });
    } else if k == HIR_EXPR_UNARY || k == HIR_EXPR_JUMP {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).inner as *const HirExpr });
    } else if k == HIR_EXPR_CALL || k == HIR_EXPR_METHOD_CALL {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*expr).callee as *const HirExpr });
        let mut a: *const HirExpr = unsafe { (*expr).args as *const HirExpr };
        while (a as usize) != 0 {
            walk_hir_expr_fixup_array_len(mut_view(*sink), a);
            a = unsafe { (*a).next as *const HirExpr };
        }
    }
}

fn walk_hir_stmt_fixup_array_len(sink: mut_view<DiagSink>, stmt: *const HirStmt) {
    if (stmt as usize) == 0 {
        return;
    }
    let k = unsafe { (*stmt).kind };
    if k == HIR_STMT_LET {
        walk_hir_type_fixup_array_len(mut_view(*sink), unsafe { (*stmt).ty as *const HirType });
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*stmt).expr as *const HirExpr });
        walk_hir_block_fixup_array_len(mut_view(*sink), unsafe { (*stmt).else_block as *const HirBlock });
    } else if k == HIR_STMT_EXPR {
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*stmt).expr as *const HirExpr });
    }
}

fn walk_hir_block_fixup_array_len(sink: mut_view<DiagSink>, blk: *const HirBlock) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s: *const HirStmt = unsafe { (*blk).stmts as *const HirStmt };
    while (s as usize) != 0 {
        walk_hir_stmt_fixup_array_len(mut_view(*sink), s);
        s = unsafe { (*s).next as *const HirStmt };
    }
}

fn walk_hir_item_fixup_array_len(sink: mut_view<DiagSink>, it: *const HirItem) {
    if (it as usize) == 0 {
        return;
    }
    let k = unsafe { (*it).kind };
    if k == HIR_ITEM_FN {
        let mut p: *const HirParam = unsafe { (*it).params as *const HirParam };
        while (p as usize) != 0 {
            walk_hir_type_fixup_array_len(mut_view(*sink), unsafe { (*p).ty as *const HirType });
            p = unsafe { (*p).next as *const HirParam };
        }
        walk_hir_type_fixup_array_len(mut_view(*sink), unsafe { (*it).ret_type as *const HirType });
        walk_hir_block_fixup_array_len(mut_view(*sink), unsafe { (*it).body as *const HirBlock });
    } else if k == HIR_ITEM_CONST || k == HIR_ITEM_STATIC || k == HIR_ITEM_TYPE_ALIAS {
        walk_hir_type_fixup_array_len(mut_view(*sink), unsafe { (*it).ty as *const HirType });
        walk_hir_expr_fixup_array_len(mut_view(*sink), unsafe { (*it).expr as *const HirExpr });
    } else if k == HIR_ITEM_STRUCT {
        let mut f: *const HirFieldDecl = unsafe { (*it).struct_fields as *const HirFieldDecl };
        while (f as usize) != 0 {
            walk_hir_type_fixup_array_len(mut_view(*sink), unsafe { (*f).ty as *const HirType });
            f = unsafe { (*f).next as *const HirFieldDecl };
        }
    } else if k == HIR_ITEM_ENUM {
        let mut v: *const HirVariantDecl = unsafe { (*it).variants as *const HirVariantDecl };
        while (v as usize) != 0 {
            let mut f: *const HirFieldDecl = unsafe { (*v).struct_fields as *const HirFieldDecl };
            while (f as usize) != 0 {
                walk_hir_type_fixup_array_len(mut_view(*sink), unsafe { (*f).ty as *const HirType });
                f = unsafe { (*f).next as *const HirFieldDecl };
            }
            let mut tt: *const HirType = unsafe { (*v).tuple_types as *const HirType };
            while (tt as usize) != 0 {
                walk_hir_type_fixup_array_len(mut_view(*sink), tt);
                tt = unsafe { (*tt).next as *const HirType };
            }
            v = unsafe { (*v).next as *const HirVariantDecl };
        }
    } else if k == HIR_ITEM_IMPL || k == HIR_ITEM_TRAIT {
        walk_hir_type_fixup_array_len(mut_view(*sink), unsafe { (*it).self_type as *const HirType });
        let mut m: *const HirItem = unsafe { (*it).members as *const HirItem };
        while (m as usize) != 0 {
            walk_hir_item_fixup_array_len(mut_view(*sink), m);
            m = unsafe { (*m).next as *const HirItem };
        }
    }
}

fn session_eval_const_expr_into(
    eval_arena: mut_view<Arena>,
    cctx: view<InterpConstEvalCtx>,
    thir: mut_view<Thir>,
    expr: *mut HirExpr,
    expected_ty: TypeId,
    limits: ConstLimits,
    out_res: mut_view<ConstEvalResult>
) {
    out_res.ok = false;
    out_res.val.kind = CONST_INT;
    out_res.val.ty = TypeId { v: expected_ty.v };
    out_res.val.int_val = 0u64;
    out_res.val.str_bytes = 0 as *const u8;
    out_res.val.str_len = 0;
    out_res.val.agg_data = 0 as *mut u8;
    out_res.val.agg_size = 0;
    out_res.val.agg_align = 0;
    out_res.val.alloc_id = 0u32;
    out_res.err_code = 0u16;
    out_res.err_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };

    let thir_ptr = thir_mut_ptr(mut_view(*thir));
    if (expr as usize) == 0 || (thir_ptr as usize) == 0 {
        out_res.err_code = AX_CONST_OVERFLOW as u16;
        return;
    }

    let step_limit: i32 = if limits.max_steps > 0 { limits.max_steps } else { 100000 };
    let depth_limit: i32 = if limits.max_call_depth > 0 { limits.max_call_depth } else { 100 };

    let ictx_ptr = interp_ctx_alloc_zeroed();
    interp_ctx_init(
        unsafe { mut_view(*ictx_ptr) },
        0 as *mut HirItem,
        thir_ptr,
        cctx.hir,
        cctx.interner,
        cctx.rmap,
        cctx.ast,
        cctx.db,
        cctx.sink,
        0 as *mut MonoEngine,
        step_limit,
        depth_limit,
        0 as *mut MirBodyMap,
        0 as *mut DiagBuffer,
        true
    );
    let body = mir_build_expr_body(
        mut_view(*eval_arena),
        expr,
        TypeId { v: expected_ty.v },
        thir_ptr,
        cctx.hir,
        cctx.interner,
        cctx.db
    );
    if (body as usize) == 0 {
        out_res.err_code = AX_CONST_OVERFLOW as u16;
        interp_ctx_free_allocs(unsafe { mut_view(*ictx_ptr) });
        interp_host_cleanup(unsafe { mut_view(*ictx_ptr) });
        interp_ctx_dealloc(ictx_ptr);
        return;
    }

    session_bind_mir_const_locals(unsafe { mut_view(*body) }, view(*thir));

    unsafe {
        (*ictx_ptr).is_comptime = true;
        (*ictx_ptr).build_on_demand = false;
        (*ictx_ptr).next_synth_addr = 0x20000000u64;
        (*ictx_ptr).current_span = Span {
            file: FileId { v: (*expr).span.file.v },
            start: (*expr).span.start,
            end: (*expr).span.end,
        };
    }
    interp_host_init(unsafe { mut_view(*ictx_ptr) });
    interp_register_const_allocs(unsafe { mut_view(*ictx_ptr) });

    let expected_ty_v = expected_ty.v;
    let mut ret_size = type_size(TypeId { v: expected_ty_v }, view(thir.interner)) as usize;
    let mut ret_align = type_align(TypeId { v: expected_ty_v }, view(thir.interner)) as usize;
    if ret_size == 0 {
        ret_size = 8;
    }
    if ret_align == 0 {
        ret_align = 8;
    }

    let exp_t = type_get(view(thir.interner), TypeId { v: expected_ty_v });
    let mut exp_tk: u8 = 0u8;
    let mut is_aggregate = false;
    if (exp_t as usize) != 0 {
        exp_tk = unsafe { (*exp_t).kind };
        if exp_tk == TY_STRUCT || exp_tk == TY_ARRAY || exp_tk == TY_TUPLE {
            is_aggregate = true;
        }
    }

    let mut ret_buf: *mut u8 = 0 as *mut u8;
    let alloc_buf_sz: usize = if ret_size < 16 { 16 } else { ret_size };
    if is_aggregate {
        ret_buf = arena_alloc_raw(mut_view(thir.interner.arena), ret_size, ret_align);
        unsafe {
            interp_zero_bytes(ret_buf, ret_size);
        }
    } else {
        ret_buf = arena_alloc_raw(mut_view(*eval_arena), alloc_buf_sz, 16);
        unsafe {
            interp_zero_bytes(ret_buf, alloc_buf_sz);
        }
    }

    exec_mir_body(unsafe { mut_view(*ictx_ptr) }, body, 0 as *mut InterpValue, 0, ret_buf, ret_size);

    let failed = unsafe { (*ictx_ptr).failed };
    if failed {
        out_res.ok = false;
        let err_c = unsafe { (*ictx_ptr).comptime_err_code };
        out_res.err_code = if err_c != 0u16 { err_c } else { AX_CONST_OVERFLOW as u16 };
        let err_sp_file = unsafe { (*ictx_ptr).comptime_err_span.file.v };
        if err_sp_file != 0u32 {
            out_res.err_span = Span {
                file: FileId { v: err_sp_file },
                start: unsafe { (*ictx_ptr).comptime_err_span.start },
                end: unsafe { (*ictx_ptr).comptime_err_span.end },
            };
        } else {
            out_res.err_span = Span {
                file: FileId { v: unsafe { (*expr).span.file.v } },
                start: unsafe { (*expr).span.start },
                end: unsafe { (*expr).span.end },
            };
        }
    } else {
        out_res.ok = true;
        if is_aggregate {
            out_res.val.kind = CONST_AGGREGATE;
            out_res.val.agg_data = ret_buf;
            out_res.val.agg_size = ret_size;
            out_res.val.agg_align = ret_align;
        } else if (exp_t as usize) != 0 && exp_tk == TY_STR {
            out_res.val.kind = CONST_STR;
            let addr = unsafe { *(ret_buf as *const u64) };
            let s_ptr = interp_resolve_synth_ptr(unsafe { mut_view(*ictx_ptr) }, addr);
            out_res.val.str_bytes = s_ptr as *const u8;
            out_res.val.str_len = unsafe { *((ret_buf as *const u64) + 1) as usize };
        } else if (exp_t as usize) != 0 && exp_tk == TY_UNIT {
            out_res.val.kind = CONST_UNIT;
        } else {
            out_res.val.kind = CONST_INT;
            let mut raw_v: u64 = 0u64;
            if ret_size == 1 {
                raw_v = unsafe { *ret_buf as u64 };
                if exp_tk == TY_I8 {
                    raw_v = sign_extend_u64(raw_v, 8);
                }
            } else if ret_size == 2 {
                raw_v = unsafe { *(ret_buf as *const u16) as u64 };
                if exp_tk == TY_I16 {
                    raw_v = sign_extend_u64(raw_v, 16);
                }
            } else if ret_size == 4 {
                raw_v = unsafe { *(ret_buf as *const u32) as u64 };
                if exp_tk == TY_I32 {
                    raw_v = sign_extend_u64(raw_v, 32);
                }
            } else {
                raw_v = unsafe { *(ret_buf as *const u64) };
            }
            out_res.val.int_val = raw_v;
        }
    }

    interp_ctx_free_allocs(unsafe { mut_view(*ictx_ptr) });
    interp_host_cleanup(unsafe { mut_view(*ictx_ptr) });
    interp_ctx_dealloc(ictx_ptr);
}

pub fn session_comptime_check_and_eval(
    sess: mut_view<CompilerSession>,
    ast: view<Ast>,
    rmap: view<ResolveMap>,
    hir: view<HirFile>,
    thir: mut_view<Thir>
) -> bool {
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        walk_hir_item_fixup_array_len(mut_view(sess.diag_sink), it as *const HirItem);
        it = unsafe { (*it).next };
    }

    it = hir.items;
    while (it as usize) != 0 {
        let it_sp = unsafe { (*it).span };
        if it_sp.file.v != 0u32 {
            let k = unsafe { (*it).kind };
            if k == HIR_ITEM_STATIC {
                report_typeck_diag(mut_view(sess.diag_sink), AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP, it_sp.file.v, it_sp.start, it_sp.end);
            } else if k == HIR_ITEM_CONST {
                let mut ty_id = TypeId { v: 0u32 };
                let item_ty_ptr = thir_get_item_type(view(*thir), it as *const HirItem);
                if (item_ty_ptr as usize) != 0 {
                    ty_id.v = unsafe { (*item_ty_ptr).v };
                } else {
                    let sym_v = unsafe { (*it).symbol.v };
                    if sym_v != 0u32 {
                        let sym_ty_ptr = thir_get_sym_type(view(*thir), SymbolId { v: sym_v });
                        if (sym_ty_ptr as usize) != 0 {
                            ty_id.v = unsafe { (*sym_ty_ptr).v };
                        }
                    }
                }
                if ty_id.v != 0u32 && !session_is_valid_const_type(view(*thir), ty_id) {
                    let cty_ptr = unsafe { (*it).ty as *const HirType };
                    let mut rewrote = rewrite_mismatch_diag_at_span(
                        mut_view(sess.diag_sink),
                        view(it_sp),
                        AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP,
                        view(it_sp)
                    );
                    if !rewrote && (cty_ptr as usize) != 0 {
                        let cty_sp = unsafe { (*cty_ptr).span };
                        rewrote = rewrite_mismatch_diag_at_span(
                            mut_view(sess.diag_sink),
                            view(cty_sp),
                            AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP,
                            view(it_sp)
                        );
                    }
                    if !rewrote {
                        report_typeck_diag(
                            mut_view(sess.diag_sink),
                            AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP,
                            it_sp.file.v,
                            it_sp.start,
                            it_sp.end
                        );
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }

    if session_has_errors(view(*sess)) {
        return false;
    }

    let cctx = InterpConstEvalCtx {
        hir: hir_const_ptr(hir),
        interner: interner_mut_ptr(mut_view(sess.interner)),
        rmap: rmap_const_ptr(rmap),
        ast: ast_const_ptr(ast),
        db: source_db_const_ptr(view(sess.source_db)),
        sink: diag_sink_mut_ptr(mut_view(sess.diag_sink)),
    };
    let mut eval_arena = arena_new();
    let res_ptr = arena_alloc_raw(mut_view(eval_arena), size_of<ConstEvalResult>(), align_of<ConstEvalResult>()) as *mut ConstEvalResult;

    it = hir.items;
    while (it as usize) != 0 {
        let it_sp = unsafe { (*it).span };
        if it_sp.file.v != 0u32 && (unsafe { (*it).kind }) == HIR_ITEM_CONST {
            let cexpr = unsafe { (*it).expr };
            if (cexpr as usize) != 0 {
                let mut expected_ty = TypeId { v: 0u32 };
                let item_ty_ptr = thir_get_item_type(view(*thir), it as *const HirItem);
                if (item_ty_ptr as usize) != 0 {
                    expected_ty.v = unsafe { (*item_ty_ptr).v };
                } else {
                    let expr_ty_ptr = thir_get_expr_type(view(*thir), cexpr as *const HirExpr);
                    if (expr_ty_ptr as usize) != 0 {
                        expected_ty.v = unsafe { (*expr_ty_ptr).v };
                    }
                }
                let sym_v = unsafe { (*it).symbol.v };
                session_eval_const_expr_into(
                    mut_view(eval_arena),
                    view(cctx),
                    mut_view(*thir),
                    cexpr,
                    expected_ty,
                    ConstLimits { max_steps: 100000, max_call_depth: 100 },
                    unsafe { mut_view(*res_ptr) }
                );
                let ok = unsafe { (*res_ptr).ok };
                if !ok {
                    let err_code_u16 = unsafe { (*res_ptr).err_code };
                    let code_v: u32 = if err_code_u16 != 0u16 { err_code_u16 as u32 } else { AX_CONST_OVERFLOW };
                    let err_sp_file = unsafe { (*res_ptr).err_span.file.v };
                    if err_sp_file != 0u32 {
                        let esp_start = unsafe { (*res_ptr).err_span.start };
                        let esp_end = unsafe { (*res_ptr).err_span.end };
                        report_typeck_diag(mut_view(sess.diag_sink), code_v, err_sp_file, esp_start, esp_end);
                    } else {
                        let expr_sp = unsafe { (*cexpr).span };
                        report_typeck_diag(mut_view(sess.diag_sink), code_v, expr_sp.file.v, expr_sp.start, expr_sp.end);
                    }
                } else if sym_v != 0u32 {
                    unsafe {
                        sym_constmap_insert(mut_view(thir.symbol_consts), SymbolId { v: sym_v }, view((*res_ptr).val));
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }

    arena_destroy(mut_view(eval_arena));
    !session_has_errors(view(*sess))
}

// =============================================================================
// MIR Constant Local Binding & Host Intrinsic Filtering
// =============================================================================

fn local_can_be_direct_const(body: view<MirBody>, target_loc_v: u32) -> bool {
    if target_loc_v == 0u32 || (target_loc_v as usize) >= body.local_count {
        return false;
    }
    let ldecl = unsafe { mir_local_at(body.locals, target_loc_v as usize) };
    if (unsafe { (*ldecl).kind }) != MIR_LOCAL_TEMP || (unsafe { (*ldecl).mut_flag }) {
        return false;
    }
    let mut assign_count: usize = 0;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, b) };
        let sc = unsafe { (*bb).stmt_count };
        let stmts = unsafe { (*bb).stmts };
        let mut s: usize = 0;
        while s < sc {
            let st = unsafe { mir_stmt_at(stmts, s) };
            if (unsafe { (*st).kind }) == MIR_STMT_ASSIGN {
                if (unsafe { (*st).place.local.v }) == target_loc_v {
                    if (unsafe { (*st).place.proj_count }) > 0 {
                        return false;
                    }
                    assign_count = assign_count + 1;
                    if assign_count > 1 {
                        return false;
                    }
                }
                if (unsafe { (*st).rvalue.kind }) == MIR_RVALUE_REF &&
                    (unsafe { (*st).rvalue.borrow_kind }) == MIR_BORROW_MUT &&
                    (unsafe { (*st).rvalue.place.local.v }) == target_loc_v {
                    return false;
                }
            }
            s = s + 1;
        }
        if (unsafe { (*bb).has_terminator }) &&
            (unsafe { (*bb).terminator.kind }) == MIR_TERM_CALL &&
            (unsafe { (*bb).terminator.has_destination }) &&
            (unsafe { (*bb).terminator.destination.local.v }) == target_loc_v {
            return false;
        }
        b = b + 1;
    }
    assign_count == 1
}

fn get_or_add_const_agg_local(
    body: mut_view<MirBody>,
    thir: view<Thir>,
    csym_v: u32,
    ty: TypeId,
    sp: view<Span>
) -> MirLocalId {
    let mut i: usize = 0;
    while i < body.local_count {
        let decl = unsafe { mir_local_at(body.locals, i) };
        if (unsafe { (*decl).kind }) == MIR_LOCAL_CONST &&
            (unsafe { (*decl).const_sym.v }) == csym_v &&
            (unsafe { (*decl).ty.v }) == ty.v {
            return MirLocalId { v: i as u32 };
        }
        i = i + 1;
    }
    let arena_ptr = unsafe { address_of(thir.interner.arena.head) as *mut Arena };
    let loc_id = mir_add_local(
        mut_view(*body),
        unsafe { mut_view(*arena_ptr) },
        TypeId { v: ty.v },
        MIR_LOCAL_CONST,
        false,
        StrId { v: 0u32 },
        sp
    );
    let new_decl = unsafe { mir_local_at(body.locals, loc_id.v as usize) };
    unsafe {
        (*new_decl).const_sym.v = csym_v;
    }
    loc_id
}

fn bind_const_agg_operand(body: mut_view<MirBody>, thir: view<Thir>, op: mut_view<MirOperand>) {
    if op.kind != MIR_OP_CONST {
        return;
    }
    let csym_v = op.constant.sym.v;
    if csym_v == 0u32 {
        return;
    }
    let cv = sym_constmap_get(view(thir.symbol_consts), SymbolId { v: csym_v });
    if (cv as usize) == 0 || (unsafe { (*cv).kind }) != CONST_AGGREGATE {
        return;
    }
    let mut cty = TypeId { v: op.constant.ty.v };
    if cty.v == 0u32 {
        cty.v = unsafe { (*cv).ty.v };
    }
    let sp = Span {
        file: FileId { v: op.location.file.v },
        start: op.location.start,
        end: op.location.end,
    };
    let const_loc = get_or_add_const_agg_local(mut_view(*body), thir, csym_v, cty, view(sp));
    op.kind = MIR_OP_COPY;
    op.place = mir_local_place(const_loc.v);
}

pub fn session_bind_mir_const_locals(body: mut_view<MirBody>, thir: view<Thir>) {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, b) };
        let sc = unsafe { (*bb).stmt_count };
        let stmts = unsafe { (*bb).stmts };
        let mut s: usize = 0;
        while s < sc {
            let st = unsafe { mir_stmt_at(stmts, s) };
            if (unsafe { (*st).kind }) == MIR_STMT_ASSIGN {
                let rvk = unsafe { (*st).rvalue.kind };
                if (unsafe { (*st).place.proj_count }) == 0 &&
                    rvk == MIR_RVALUE_USE &&
                    (unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_CONST {
                    let csym_v = unsafe { (*st).rvalue.use_op.constant.sym.v };
                    if csym_v != 0u32 {
                        let cv = sym_constmap_get(view(thir.symbol_consts), SymbolId { v: csym_v });
                        if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_AGGREGATE {
                            let dst_loc_v = unsafe { (*st).place.local.v };
                            if local_can_be_direct_const(view(*body), dst_loc_v) {
                                let ldecl = unsafe { mir_local_at(body.locals, dst_loc_v as usize) };
                                unsafe {
                                    (*ldecl).kind = MIR_LOCAL_CONST;
                                    (*ldecl).const_sym.v = csym_v;
                                }
                            } else {
                                bind_const_agg_operand(mut_view(*body), thir, unsafe { mut_view((*st).rvalue.use_op) });
                            }
                        }
                    }
                } else if rvk == MIR_RVALUE_USE || rvk == MIR_RVALUE_REPEAT {
                    bind_const_agg_operand(mut_view(*body), thir, unsafe { mut_view((*st).rvalue.use_op) });
                } else if rvk == MIR_RVALUE_AGGREGATE {
                    let op_cnt = unsafe { (*st).rvalue.operand_count };
                    let ops = unsafe { (*st).rvalue.operands };
                    let mut oi: usize = 0;
                    while oi < op_cnt {
                        let f_op = unsafe { mir_op_at(ops, oi) };
                        bind_const_agg_operand(mut_view(*body), thir, unsafe { mut_view(*f_op) });
                        oi = oi + 1;
                    }
                }
            }
            s = s + 1;
        }
        if (unsafe { (*bb).has_terminator }) && (unsafe { (*bb).terminator.kind }) == MIR_TERM_CALL {
            let arg_cnt = unsafe { (*bb).terminator.arg_count };
            let args = unsafe { (*bb).terminator.args };
            let mut ai: usize = 0;
            while ai < arg_cnt {
                let a_op = unsafe { mir_op_at(args, ai) };
                bind_const_agg_operand(mut_view(*body), thir, unsafe { mut_view(*a_op) });
                ai = ai + 1;
            }
        }
        b = b + 1;
    }
}

pub fn session_is_host_intrinsic_fn(sess: view<CompilerSession>, it: *const HirItem) -> bool {
    if (it as usize) == 0 || (unsafe { (*it).kind }) != HIR_ITEM_FN {
        return false;
    }
    let mut attr: *mut HirAttr = unsafe { (*it).attrs };
    while (attr as usize) != 0 {
        let aname = interner_get(view(sess.interner), StrId { v: unsafe { (*attr).name.v } });
        if sv_matches_ident_slice(view(aname), 0, 9) {
            let fname = interner_get(view(sess.interner), StrId { v: unsafe { (*it).name.v } });
            if interp_is_host_intrinsic_name(view(fname)) {
                return true;
            }
        }
        attr = unsafe { (*attr).next };
    }
    false
}

// =============================================================================
// Optimizer & Full-Pipeline Per-Function / Per-File Integration
// =============================================================================

pub fn session_opt_body(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    it: *const HirItem,
    body: mut_view<MirBody>,
    thir: view<Thir>,
    verify_each: bool
) -> bool {
    let thir_ptr = thir_const_ptr(thir);
    opt_run_in_arena(
        mut_view(*body),
        thir_ptr,
        mut_view(*mir_arena),
        mut_view(sess.diag_sink),
        verify_each,
        it
    );
    !session_has_errors(view(*sess))
}

pub fn session_interp_opt_fn(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    it: *mut HirItem,
    hir: view<HirFile>,
    thir: mut_view<Thir>,
    mono: *mut MonoEngine,
    opt_O1: bool,
    verify_each: bool,
    run_drop_elab: bool,
    pre_mir_out: *mut DiagBuffer,
    elab_mir_out: *mut DiagBuffer
) -> *mut MirBody {
    if (it as usize) == 0 || (unsafe { (*it).kind }) != HIR_ITEM_FN {
        return 0 as *mut MirBody;
    }
    if (unsafe { (*it).body as usize }) == 0 {
        return 0 as *mut MirBody;
    }
    if session_is_host_intrinsic_fn(view(*sess), it as *const HirItem) {
        return 0 as *mut MirBody;
    }

    let thir_ptr = thir_mut_ptr(mut_view(*thir));
    let hir_ptr = hir_const_ptr(hir);
    let str_in_ptr = interner_mut_ptr(mut_view(sess.interner));
    let db_ptr = source_db_const_ptr(view(sess.source_db));

    let body = mir_build_fn(
        mut_view(*mir_arena),
        it,
        thir_ptr,
        hir_ptr,
        str_in_ptr,
        db_ptr,
        mono
    );
    if (body as usize) == 0 {
        return 0 as *mut MirBody;
    }

    verify_mir(
        unsafe { view(*body) },
        thir_ptr as *const Thir,
        mut_view(sess.diag_sink),
        it as *const HirItem
    );

    if opt_O1 && !session_has_errors(view(*sess)) {
        let _ = session_opt_body(
            mut_view(*sess),
            mut_view(*mir_arena),
            it as *const HirItem,
            unsafe { mut_view(*body) },
            view(*thir),
            verify_each
        );
    }

    if (pre_mir_out as usize) != 0 {
        unsafe {
            mir_print(mut_view(*pre_mir_out), view(*body));
        }
    }

    let _ = session_own_check_body(
        mut_view(*sess),
        it as *const HirItem,
        unsafe { mut_view(*body) },
        view(*thir)
    );

    if run_drop_elab && !session_has_errors(view(*sess)) {
        session_drop_elaborate_body(
            mut_view(*sess),
            mut_view(*mir_arena),
            unsafe { mut_view(*body) },
            mut_view(*thir),
            hir
        );
        if !session_has_errors(view(*sess)) {
            verify_mir_drop_flags(
                unsafe { view(*body) },
                thir_ptr as *const Thir,
                mut_view(sess.diag_sink),
                it as *const HirItem
            );
        }
        if (elab_mir_out as usize) != 0 {
            unsafe {
                mir_print(mut_view(*elab_mir_out), view(*body));
            }
        }
    }

    session_bind_mir_const_locals(unsafe { mut_view(*body) }, view(*thir));

    body
}

fn insert_impl_alias_in_mir_map(mir_map: mut_view<MirBodyMap>, hir: view<HirFile>, it: *const HirItem, body: *mut MirBody) {
    let it_sym_v = unsafe { (*it).symbol.v };
    let it_body = unsafe { (*it).body as usize };
    let it_start = unsafe { (*it).span.start };
    mir_body_map_insert(mut_view(*mir_map), it, it_sym_v, body);
    if it_body == 0 {
        return;
    }
    let mut top: *mut HirItem = hir.items;
    while (top as usize) != 0 {
        let tk = unsafe { (*top).kind };
        if tk == HIR_ITEM_IMPL || tk == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*top).members };
            while (m as usize) != 0 {
                if (m as *const HirItem) != it && (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    if (unsafe { (*m).body as usize }) == it_body && (unsafe { (*m).span.start }) == it_start {
                        let m_sym_v = unsafe { (*m).symbol.v };
                        mir_body_map_insert(mut_view(*mir_map), m as *const HirItem, m_sym_v, body);
                    }
                }
                m = unsafe { (*m).next };
            }
        }
        top = unsafe { (*top).next };
    }
}

pub fn session_interp_opt_file(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    hir: view<HirFile>,
    thir: mut_view<Thir>,
    main_fid: FileId,
    mono: *mut MonoEngine,
    opt_O1: bool,
    verify_each: bool,
    run_drop_elab: bool,
    pre_mir_out: *mut DiagBuffer,
    elab_mir_out: *mut DiagBuffer,
    mir_map: *mut MirBodyMap
) -> usize {
    if !session_unsafe_check(mut_view(*sess), hir, view(*thir)) {
        return 0;
    }

    let mut fn_count: usize = 0;
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        let it_file = unsafe { (*it).span.file.v };
        let it_kind = unsafe { (*it).kind };
        let is_fn = it_kind == HIR_ITEM_FN;
        if is_fn && (main_fid.v == 0u32 || it_file == 0u32 || it_file == main_fid.v) {
            let body = session_interp_opt_fn(
                mut_view(*sess),
                mut_view(*mir_arena),
                it,
                hir,
                mut_view(*thir),
                mono,
                opt_O1,
                verify_each,
                run_drop_elab,
                pre_mir_out,
                elab_mir_out
            );
            if (body as usize) != 0 {
                fn_count = fn_count + 1;
                if (mir_map as usize) != 0 {
                    insert_impl_alias_in_mir_map(unsafe { mut_view(*mir_map) }, hir, it as *const HirItem, body);
                }
            }
        } else if is_fn && (mir_map as usize) != 0 {
            let prelude_body = session_interp_opt_fn(
                mut_view(*sess),
                mut_view(*mir_arena),
                it,
                hir,
                mut_view(*thir),
                mono,
                opt_O1,
                verify_each,
                run_drop_elab,
                0 as *mut DiagBuffer,
                0 as *mut DiagBuffer
            );
            if (prelude_body as usize) != 0 {
                insert_impl_alias_in_mir_map(unsafe { mut_view(*mir_map) }, hir, it as *const HirItem, prelude_body);
            }
        } else if (it_kind == HIR_ITEM_IMPL || it_kind == HIR_ITEM_TRAIT) && (mir_map as usize) != 0 {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).body as usize }) != 0 {
                    let cached_m = unsafe { mir_body_map_get_by_item(view(*mir_map), m as *const HirItem) };
                    if (cached_m as usize) == 0 {
                        let m_body = session_interp_opt_fn(
                            mut_view(*sess),
                            mut_view(*mir_arena),
                            m,
                            hir,
                            mut_view(*thir),
                            mono,
                            opt_O1,
                            verify_each,
                            run_drop_elab,
                            0 as *mut DiagBuffer,
                            0 as *mut DiagBuffer
                        );
                        if (m_body as usize) != 0 {
                            insert_impl_alias_in_mir_map(unsafe { mut_view(*mir_map) }, hir, m as *const HirItem, m_body);
                        }
                    }
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }

    if (mono as usize) != 0 && (mir_map as usize) != 0 {
        let mut inst: *mut MonoInstance = unsafe { (*mono).instances_head };
        while (inst as usize) != 0 {
            let nitem = unsafe { (*inst).new_item };
            if (nitem as usize) != 0 && (unsafe { (*nitem).kind }) == HIR_ITEM_FN && (unsafe { (*nitem).body as usize }) != 0 {
                let cached_inst = unsafe { mir_body_map_get_by_item(view(*mir_map), nitem as *const HirItem) };
                if (cached_inst as usize) == 0 {
                    let inst_body = session_interp_opt_fn(
                        mut_view(*sess),
                        mut_view(*mir_arena),
                        nitem,
                        hir,
                        mut_view(*thir),
                        mono,
                        opt_O1,
                        verify_each,
                        run_drop_elab,
                        0 as *mut DiagBuffer,
                        0 as *mut DiagBuffer
                    );
                    if (inst_body as usize) != 0 {
                        let msym_v = unsafe { (*inst).mangled_sym.v };
                        unsafe {
                            (*inst).mir_body = inst_body as usize;
                            mir_body_map_insert(mut_view(*mir_map), nitem as *const HirItem, msym_v, inst_body);
                        }
                    }
                }
            }
            inst = unsafe { (*inst).next };
        }
    }

    fn_count
}

pub fn session_emit_mir_opt(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    hir: view<HirFile>,
    thir: mut_view<Thir>,
    main_fid: FileId,
    verify_each: bool,
    out: mut_view<DiagBuffer>
) -> usize {
    let out_ptr = diag_buf_mut_ptr(out);
    session_interp_opt_file(
        sess,
        mir_arena,
        hir,
        thir,
        main_fid,
        0 as *mut MonoEngine,
        true,
        verify_each,
        true,
        out_ptr,
        0 as *mut DiagBuffer,
        0 as *mut MirBodyMap
    )
}

pub fn session_find_main_fn(sess: view<CompilerSession>, hir: view<HirFile>) -> *mut HirItem {
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN {
            let fname = interner_get(view(sess.interner), StrId { v: unsafe { (*it).name.v } });
            if sv_matches_ident_slice(view(fname), 9, 4) {
                return it;
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

pub fn session_run_interp(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    ast: view<Ast>,
    rmap: view<ResolveMap>,
    hir: view<HirFile>,
    thir: mut_view<Thir>,
    main_fid: FileId,
    mono: *mut MonoEngine,
    opt_O1: bool,
    verify_each: bool,
    step_limit: i32,
    call_depth_limit: i32,
    out_buf: *mut DiagBuffer,
    capture_stdout: bool,
    out_panic_sv: *mut StrView
) -> i32 {
    if session_has_errors(view(*sess)) {
        return 1;
    }

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut compiler.interp.MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    let mir_map_ptr = mir_body_map_mut_ptr(mut_view(mir_map));

    let _ = session_interp_opt_file(
        mut_view(*sess),
        mut_view(*mir_arena),
        hir,
        mut_view(*thir),
        FileId { v: main_fid.v },
        mono,
        opt_O1,
        verify_each,
        true,
        0 as *mut DiagBuffer,
        0 as *mut DiagBuffer,
        mir_map_ptr
    );

    if session_has_errors(view(*sess)) {
        mir_body_map_free(mut_view(mir_map));
        return 1;
    }

    let main_fn = session_find_main_fn(view(*sess), hir);
    if (main_fn as usize) == 0 {
        let sp = Span { file: FileId { v: main_fid.v }, start: 0u32, end: 0u32 };
        emit_session_diag(mut_view(sess.diag_sink), AX_TYPE_MAIN_MISSING, view(sp), 0, 31);
        mir_body_map_free(mut_view(mir_map));
        return 1;
    }

    let ctx_ptr = interp_ctx_alloc_zeroed();
    interp_ctx_init(
        unsafe { mut_view(*ctx_ptr) },
        main_fn,
        thir_mut_ptr(mut_view(*thir)),
        hir_const_ptr(hir),
        interner_mut_ptr(mut_view(sess.interner)),
        rmap_const_ptr(rmap),
        ast_const_ptr(ast),
        source_db_const_ptr(view(sess.source_db)),
        diag_sink_mut_ptr(mut_view(sess.diag_sink)),
        mono,
        step_limit,
        call_depth_limit,
        mir_map_ptr,
        out_buf,
        capture_stdout
    );
    interp_host_init(unsafe { mut_view(*ctx_ptr) });
    interp_register_const_allocs(unsafe { mut_view(*ctx_ptr) });
    let mut ret_val: u64 = 0u64;
    let ret_ptr = unsafe { address_of_mut(ret_val) as *mut u8 };
    eval_call_into(unsafe { mut_view(*ctx_ptr) }, main_fn, 0 as *mut InterpValue, 0, ret_ptr, 8);

    let failed = unsafe { (*ctx_ptr).failed };
    let exit_code = unsafe { (*ctx_ptr).exit_code };
    let code: i32 = if failed { exit_code } else { ret_val as i32 };

    if (out_panic_sv as usize) != 0 {
        let has_panicked = unsafe { (*ctx_ptr).has_panicked };
        let panic_msg_ptr = unsafe { (*ctx_ptr).panic_msg_ptr };
        if has_panicked && (panic_msg_ptr as usize) != 0 {
            let plen = unsafe { (*ctx_ptr).panic_msg_len };
            let msg_copy = arena_alloc_raw(mut_view(*mir_arena), plen + 1, 1);
            unsafe {
                interp_copy_bytes(msg_copy, panic_msg_ptr, plen);
                *(msg_copy + plen) = 0u8;
                (*out_panic_sv).ptr = msg_copy as *const u8;
                (*out_panic_sv).len = plen;
            }
        } else {
            unsafe {
                (*out_panic_sv).ptr = 0 as *const u8;
                (*out_panic_sv).len = 0;
            }
        }
    }

    interp_ctx_free_allocs(unsafe { mut_view(*ctx_ptr) });
    unsafe {
        arena_destroy(mut_view((*ctx_ptr).arena));
    }
    interp_host_cleanup(unsafe { mut_view(*ctx_ptr) });
    interp_ctx_dealloc(ctx_ptr);
    mir_body_map_free(mut_view(mir_map));
    code
}

// =============================================================================
// Standalone .mir Text Optimization & Interpretation Entrypoints
// =============================================================================

pub fn session_opt_mir_text(
    sess: mut_view<CompilerSession>,
    arena: mut_view<Arena>,
    text: StrView,
    verify_each: bool,
    out: mut_view<DiagBuffer>
) -> bool {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let ti_arena = arena_new();
    unsafe {
        (*thir_ptr).interner.arena = ti_arena;
        thir_init(mut_view(*thir_ptr));
    }
    let body = verify_parse_mir(
        text,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(*arena)
    );
    if (body as usize) == 0 {
        let zsp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
        emit_session_diag(mut_view(sess.diag_sink), AX_VERIFY_MIR_SYNTAX, view(zsp), 31, 16);
        unsafe {
            thir_free(mut_view(*thir_ptr));
        }
        return false;
    }

    verify_mir(
        unsafe { view(*body) },
        thir_ptr as *const Thir,
        mut_view(sess.diag_sink),
        0 as *const HirItem
    );
    if !session_has_errors(view(*sess)) {
        opt_run_in_arena(
            unsafe { mut_view(*body) },
            thir_ptr as *const Thir,
            mut_view(*arena),
            mut_view(sess.diag_sink),
            verify_each,
            0 as *const HirItem
        );
    }
    if !session_has_errors(view(*sess)) {
        verify_mir(
            unsafe { view(*body) },
            thir_ptr as *const Thir,
            mut_view(sess.diag_sink),
            0 as *const HirItem
        );
    }
    if !session_has_errors(view(*sess)) {
        unsafe {
            mir_print(out, view(*body));
        }
    }

    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    !session_has_errors(view(*sess))
}

pub fn session_interp_mir_text(
    sess: mut_view<CompilerSession>,
    arena: mut_view<Arena>,
    text: StrView,
    opt_O1: bool,
    verify_each: bool,
    step_limit: i32,
    call_depth_limit: i32,
    out_buf: *mut DiagBuffer,
    capture_stdout: bool,
    out_panic_sv: *mut StrView
) -> i32 {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let ti_arena = arena_new();
    unsafe {
        (*thir_ptr).interner.arena = ti_arena;
        thir_init(mut_view(*thir_ptr));
    }
    let body = verify_parse_mir(
        text,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(*arena)
    );
    if (body as usize) == 0 {
        let zsp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
        emit_session_diag(mut_view(sess.diag_sink), AX_VERIFY_MIR_SYNTAX, view(zsp), 31, 16);
        unsafe {
            thir_free(mut_view(*thir_ptr));
        }
        return 1;
    }

    verify_mir(
        unsafe { view(*body) },
        thir_ptr as *const Thir,
        mut_view(sess.diag_sink),
        0 as *const HirItem
    );
    if session_has_errors(view(*sess)) {
        unsafe {
            thir_free(mut_view(*thir_ptr));
        }
        return 1;
    }

    if opt_O1 {
        opt_run_in_arena(
            unsafe { mut_view(*body) },
            thir_ptr as *const Thir,
            mut_view(*arena),
            mut_view(sess.diag_sink),
            verify_each,
            0 as *const HirItem
        );
        if session_has_errors(view(*sess)) {
            unsafe {
                thir_free(mut_view(*thir_ptr));
            }
            return 1;
        }
    }

    let ctx_ptr = interp_ctx_alloc_zeroed();
    interp_ctx_init(
        unsafe { mut_view(*ctx_ptr) },
        0 as *mut HirItem,
        thir_ptr,
        0 as *const HirFile,
        interner_mut_ptr(mut_view(sess.interner)),
        0 as *const ResolveMap,
        0 as *const Ast,
        source_db_const_ptr(view(sess.source_db)),
        diag_sink_mut_ptr(mut_view(sess.diag_sink)),
        0 as *mut MonoEngine,
        step_limit,
        call_depth_limit,
        0 as *mut MirBodyMap,
        out_buf,
        capture_stdout
    );
    interp_host_init(unsafe { mut_view(*ctx_ptr) });

    let ret_buf = unsafe { arena_alloc_raw(mut_view((*ctx_ptr).arena), 64, 16) };
    unsafe {
        interp_zero_bytes(ret_buf, 64);
    }
    exec_mir_body(
        unsafe { mut_view(*ctx_ptr) },
        body,
        0 as *mut InterpValue,
        0,
        ret_buf,
        64
    );

    if (out_panic_sv as usize) != 0 {
        let has_panicked = unsafe { (*ctx_ptr).has_panicked };
        let panic_msg_ptr = unsafe { (*ctx_ptr).panic_msg_ptr };
        if has_panicked && (panic_msg_ptr as usize) != 0 {
            let plen = unsafe { (*ctx_ptr).panic_msg_len };
            let msg_copy = arena_alloc_raw(mut_view(*arena), plen + 1, 1);
            unsafe {
                interp_copy_bytes(msg_copy, panic_msg_ptr, plen);
                *(msg_copy + plen) = 0u8;
                (*out_panic_sv).ptr = msg_copy as *const u8;
                (*out_panic_sv).len = plen;
            }
        } else {
            unsafe {
                (*out_panic_sv).ptr = 0 as *const u8;
                (*out_panic_sv).len = 0;
            }
        }
    }

    let failed = unsafe { (*ctx_ptr).failed };
    let exit_code = unsafe { (*ctx_ptr).exit_code };
    let ret_val = unsafe { *(ret_buf as *const i32) };

    interp_ctx_free_allocs(unsafe { mut_view(*ctx_ptr) });
    unsafe {
        arena_destroy(mut_view((*ctx_ptr).arena));
    }
    interp_host_cleanup(unsafe { mut_view(*ctx_ptr) });
    interp_ctx_dealloc(ctx_ptr);
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }

    if failed {
        return exit_code;
    }
    ret_val
}

pub fn session_interp_opt_and_render_human(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    ast: view<Ast>,
    rmap: view<ResolveMap>,
    hir: view<HirFile>,
    thir: mut_view<Thir>,
    main_fid: FileId,
    opt_O1: bool,
    out: mut_view<DiagBuffer>
) {
    let _ = session_comptime_check_and_eval(mut_view(*sess), ast, rmap, hir, mut_view(*thir));
    if !session_has_errors(view(*sess)) {
        let _ = session_interp_opt_file(
            mut_view(*sess),
            mir_arena,
            hir,
            thir,
            main_fid,
            0 as *mut MonoEngine,
            opt_O1,
            true,
            true,
            0 as *mut DiagBuffer,
            0 as *mut DiagBuffer,
            0 as *mut MirBodyMap
        );
    }
    session_render_human(sess, out);
}

pub fn session_interp_opt_and_render_json(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    ast: view<Ast>,
    rmap: view<ResolveMap>,
    hir: view<HirFile>,
    thir: mut_view<Thir>,
    main_fid: FileId,
    opt_O1: bool,
    out: mut_view<DiagBuffer>
) {
    let _ = session_comptime_check_and_eval(mut_view(*sess), ast, rmap, hir, mut_view(*thir));
    if !session_has_errors(view(*sess)) {
        let _ = session_interp_opt_file(
            mut_view(*sess),
            mir_arena,
            hir,
            thir,
            main_fid,
            0 as *mut MonoEngine,
            opt_O1,
            true,
            true,
            0 as *mut DiagBuffer,
            0 as *mut DiagBuffer,
            0 as *mut MirBodyMap
        );
    }
    session_render_json(sess, out);
}
