// --- Three-Valued Certainty Lattice Operations (REQ-OPT-390..403) ---

pub fn certainty_meet(a: u8, b: u8) -> u8 {
    if a >= b { a } else { b }
}

pub fn certainty_and(a: u8, b: u8) -> u8 {
    certainty_meet(a, b)
}

pub fn certainty_join_paths(a: u8, b: u8) -> u8 {
    if a == CERTAINTY_PROVEN && b == CERTAINTY_PROVEN {
        return CERTAINTY_PROVEN;
    }
    if a == CERTAINTY_UNKNOWN && b == CERTAINTY_UNKNOWN {
        return CERTAINTY_UNKNOWN;
    }
    if a == CERTAINTY_PROVEN || b == CERTAINTY_PROVEN || a == CERTAINTY_POSSIBLE || b == CERTAINTY_POSSIBLE {
        return CERTAINTY_POSSIBLE;
    }
    CERTAINTY_UNKNOWN
}

pub fn certainty_negate_hazard(has_hazard: bool, base_cert: u8) -> u8 {
    if !has_hazard {
        return base_cert;
    }
    // Floating-point hazards (NaN, -0.0, non-associativity) degrade Proven to Possible (REQ-OPT-397).
    if base_cert == CERTAINTY_PROVEN {
        return CERTAINTY_POSSIBLE;
    }
    CERTAINTY_UNKNOWN
}

pub fn opt_can_rewrite_proven(certainty: u8) -> bool {
    certainty == CERTAINTY_PROVEN
}

pub fn certainty_can_rewrite(certainty: u8) -> bool {
    certainty == CERTAINTY_PROVEN
}

pub fn certainty_should_emit_remark(certainty: u8) -> bool {
    certainty == CERTAINTY_POSSIBLE
}

pub fn optir_alias_certainty(alias_res: u8) -> u8 {
    if alias_res == ALIAS_NO_ALIAS || alias_res == ALIAS_MUST_ALIAS {
        return CERTAINTY_PROVEN;
    }
    if alias_res == ALIAS_PARTIAL_ALIAS || alias_res == ALIAS_MAY_ALIAS {
        return CERTAINTY_POSSIBLE;
    }
    CERTAINTY_UNKNOWN
}

// --- Provenance Recording ---

pub fn optir_record_provenance(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    prop_kind: u8,
    certainty: u8,
    source_analysis: u8,
    subject_val: OptValueId,
    aux_val: OptValueId,
    at_bb: OptBbId,
    at_inst: OptInstId,
    pass_id: u16
) {
    if body.provenance_count >= body.provenance_cap {
        let new_cap: usize = if body.provenance_cap == 0 { 16 } else { body.provenance_cap + body.provenance_cap };
        let new_bytes = opt_mul_usize(new_cap, size_of<ProofProvenance>());
        let new_arr = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<ProofProvenance>()) as *mut ProofProvenance;
        if body.provenance_count > 0 && (body.provenance as usize) != 0 {
            let old_bytes = opt_mul_usize(body.provenance_count, size_of<ProofProvenance>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(body.provenance as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        body.provenance = new_arr;
        body.provenance_cap = new_cap;
    }
    let idx = body.provenance_count;
    body.provenance_count = idx + 1;
    let dst = unsafe { opt_prov_at(body.provenance, idx) };
    unsafe {
        (*dst).prop_kind = prop_kind;
        (*dst).certainty = certainty;
        (*dst).source_analysis = source_analysis;
        (*dst).subject_val = subject_val;
        (*dst).aux_val = aux_val;
        (*dst).at_bb = at_bb;
        (*dst).at_inst = at_inst;
        (*dst).pass_id = pass_id;
    }
}

// --- Type Inspection Helpers ---

fn opt_type_kind(thir: *const Thir, ty: TypeId) -> u8 {
    let tv = ty.v;
    if (thir as usize) != 0 {
        let node = unsafe { type_get(view((*thir).interner), TypeId { v: tv }) };
        if (node as usize) != 0 {
            return unsafe { (*node).kind };
        }
    }
    // Fallback for canonical primitive TypeIds (matching compiler/opt/const_fold.ax)
    if tv == 4u32 { return TY_BOOL; }
    if tv == 5u32 { return TY_CHAR; }
    if tv == 6u32 { return TY_I8; }
    if tv == 7u32 { return TY_I16; }
    if tv == 8u32 { return TY_I32; }
    if tv == 9u32 { return TY_I64; }
    if tv == 10u32 { return TY_ISIZE; }
    if tv == 11u32 { return TY_U8; }
    if tv == 12u32 { return TY_U16; }
    if tv == 13u32 { return TY_U32; }
    if tv == 14u32 { return TY_U64; }
    if tv == 15u32 { return TY_USIZE; }
    0u8
}

fn opt_type_is_signed(thir: *const Thir, ty: TypeId) -> bool {
    let k = opt_type_kind(thir, ty);
    k == TY_I8 || k == TY_I16 || k == TY_I32 || k == TY_I64 || k == TY_ISIZE
}

fn opt_type_is_int_or_bool(thir: *const Thir, ty: TypeId) -> bool {
    let k = opt_type_kind(thir, ty);
    k == TY_BOOL || k == TY_CHAR ||
    k == TY_I8 || k == TY_I16 || k == TY_I32 || k == TY_I64 || k == TY_ISIZE ||
    k == TY_U8 || k == TY_U16 || k == TY_U32 || k == TY_U64 || k == TY_USIZE
}

fn opt_type_bit_width(thir: *const Thir, ty: TypeId) -> u32 {
    let k = opt_type_kind(thir, ty);
    if k == TY_BOOL { return 1u32; }
    if k == TY_I8 || k == TY_U8 { return 8u32; }
    if k == TY_I16 || k == TY_U16 { return 16u32; }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR { return 32u32; }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE { return 64u32; }
    0u32
}

fn opt_type_field_ty(thir: *const Thir, agg_ty: TypeId, field_idx: u32) -> TypeId {
    let tv = agg_ty.v;
    if (thir as usize) != 0 {
        let node = unsafe { type_get(view((*thir).interner), TypeId { v: tv }) };
        if (node as usize) != 0 {
            let k = unsafe { (*node).kind };
            if k == TY_STRUCT || k == TY_TUPLE {
                let fc = unsafe { (*node).field_count };
                let flds = unsafe { (*node).fields };
                if (field_idx as usize) < fc && (flds as usize) != 0 {
                    let fp = unsafe { typeid_at(flds, field_idx as usize) };
                    return unsafe { *fp };
                }
            }
        }
    }
    TypeId { v: tv }
}

// --- Value & MemorySSA Allocation Helpers ---

fn opt_zero_const(ty: TypeId) -> MirConst {
    MirConst {
        ty: ty,
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: SymbolId { v: 0u32 },
    }
}

fn opt_origin_make(span: view<Span>, mir_bb_v: u32, stmt_idx: u32, pass_id: u16) -> OptOrigin {
    OptOrigin {
        span: Span { file: FileId { v: span.file.v }, start: span.start, end: span.end },
        mir_bb: MirBbId { v: mir_bb_v },
        mir_stmt_idx: stmt_idx,
        pass_id: pass_id,
    }
}

fn opt_copy_origin(dst: mut_view<OptOrigin>, src: view<OptOrigin>) {
    dst.span.file.v = src.span.file.v;
    dst.span.start = src.span.start;
    dst.span.end = src.span.end;
    dst.mir_bb.v = src.mir_bb.v;
    dst.mir_stmt_idx = src.mir_stmt_idx;
    dst.pass_id = src.pass_id;
}

pub fn optir_alloc_value(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    ty: TypeId,
    kind: u8,
    def_bb: OptBbId,
    def_inst: OptInstId,
    src_local: MirLocalId,
    proj_field: u32,
    const_val: view<MirConst>,
    origin: view<OptOrigin>
) -> OptValueId {
    // 1-based value indexing: index 0 is reserved for OPT_VALUE_NONE
    let need = body.value_count + 2;
    if need > body.value_cap {
        let new_cap: usize = if body.value_cap == 0 { 32 } else { body.value_cap + body.value_cap };
        let cap_use: usize = if new_cap < need { need + 16 } else { new_cap };
        let new_bytes = opt_mul_usize(cap_use, size_of<OptValue>());
        let new_vals = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<OptValue>()) as *mut OptValue;
        if body.value_count > 0 && (body.values as usize) != 0 {
            let old_bytes = opt_mul_usize(body.value_count + 1, size_of<OptValue>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(body.values as *const u8, new_vals as *mut u8, old_bytes);
            }
        }
        body.values = new_vals;
        body.value_cap = cap_use;
    }
    let id_v = (body.value_count + 1) as u32;
    body.value_count = body.value_count + 1;
    let vp = unsafe { opt_val_at(body.values, id_v as usize) };
    unsafe {
        (*vp).id = OptValueId { v: id_v };
        (*vp).ty = ty;
        (*vp).kind = kind;
        (*vp).def_bb = def_bb;
        (*vp).def_inst = def_inst;
        (*vp).src_local = src_local;
        (*vp).proj_field = proj_field;
        mir_copy_const(mut_view((*vp).const_val), const_val);
        opt_copy_origin(mut_view((*vp).origin), origin);
    }
    OptValueId { v: id_v }
}

fn optir_alloc_mem_def(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    kind: u8,
    bb: OptBbId,
    inst_idx: u32,
    prev_mem: MemSsaId,
    region: view<MemoryRegion>,
    effect: u16,
    is_barrier: bool
) -> MemSsaId {
    if body.mem_ssa_count >= body.mem_ssa_cap {
        let new_cap: usize = if body.mem_ssa_cap == 0 { 16 } else { body.mem_ssa_cap + body.mem_ssa_cap };
        let new_bytes = opt_mul_usize(new_cap, size_of<MemSsaDefNode>());
        let new_defs = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<MemSsaDefNode>()) as *mut MemSsaDefNode;
        if body.mem_ssa_count > 0 && (body.mem_defs as usize) != 0 {
            let old_bytes = opt_mul_usize(body.mem_ssa_count, size_of<MemSsaDefNode>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(body.mem_defs as *const u8, new_defs as *mut u8, old_bytes);
            }
        }
        body.mem_defs = new_defs;
        body.mem_ssa_cap = new_cap;
    }
    let idx = body.mem_ssa_count;
    body.mem_ssa_count = idx + 1;
    let dp = unsafe { opt_memdef_at(body.mem_defs, idx) };
    unsafe {
        (*dp).id = MemSsaId { v: idx as u32 };
        (*dp).kind = kind;
        (*dp).bb = bb;
        (*dp).inst_idx = inst_idx;
        (*dp).prev_mem = prev_mem;
        (*dp).region.domain = region.domain;
        (*dp).region.base_local = region.base_local;
        (*dp).region.base_value = region.base_value;
        (*dp).region.const_offset = region.const_offset;
        (*dp).region.byte_size = region.byte_size;
        (*dp).region.has_known_bounds = region.has_known_bounds;
        mir_copy_place(mut_view((*dp).region.place), view(region.place));
        (*dp).effect = effect;
        (*dp).is_barrier = is_barrier;
    }
    MemSsaId { v: idx as u32 }
}

fn opt_empty_region() -> MemoryRegion {
    MemoryRegion {
        domain: STORAGE_UNKNOWN,
        base_local: MirLocalId { v: 0u32 },
        base_value: OptValueId { v: OPT_VALUE_NONE },
        const_offset: 0i64,
        byte_size: 0u64,
        has_known_bounds: false,
        place: mir_local_place(0u32),
    }
}

// --- Block Instruction & Phi Builders ---

fn opt_block_push_inst(bb: mut_view<OptBlock>, arena: mut_view<Arena>, inst: view<OptInst>) {
    if bb.inst_count >= bb.inst_cap {
        let new_cap: usize = if bb.inst_cap == 0 { 8 } else { bb.inst_cap + bb.inst_cap };
        let new_bytes = opt_mul_usize(new_cap, size_of<OptInst>());
        let new_insts = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<OptInst>()) as *mut OptInst;
        if bb.inst_count > 0 && (bb.insts as usize) != 0 {
            let old_bytes = opt_mul_usize(bb.inst_count, size_of<OptInst>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(bb.insts as *const u8, new_insts as *mut u8, old_bytes);
            }
        }
        bb.insts = new_insts;
        bb.inst_cap = new_cap;
    }
    let idx = bb.inst_count;
    bb.inst_count = idx + 1;
    let dst = unsafe { opt_inst_at(bb.insts, idx) };
    unsafe {
        (*dst).id = inst.id;
        (*dst).opcode = inst.opcode;
        (*dst).sub_op = inst.sub_op;
        (*dst).flags = inst.flags;
        (*dst).result = inst.result;
        (*dst).ty = inst.ty;
        (*dst).lhs = inst.lhs;
        (*dst).rhs = inst.rhs;
        (*dst).extra_args = inst.extra_args;
        (*dst).extra_arg_count = inst.extra_arg_count;
        mir_copy_place(mut_view((*dst).place), view(inst.place));
        mir_copy_place(mut_view((*dst).rhs_place), view(inst.rhs_place));
        (*dst).mem_use = inst.mem_use;
        (*dst).mem_def = inst.mem_def;
        opt_copy_origin(mut_view((*dst).origin), view(inst.origin));
        mir_copy_stmt(mut_view((*dst).orig_stmt), view(inst.orig_stmt));
    }
}

fn opt_block_push_phi(bb: mut_view<OptBlock>, arena: mut_view<Arena>, phi: view<OptPhi>) {
    if bb.phi_count >= bb.phi_cap {
        let new_cap: usize = if bb.phi_cap == 0 { 4 } else { bb.phi_cap + bb.phi_cap };
        let new_bytes = opt_mul_usize(new_cap, size_of<OptPhi>());
        let new_phis = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<OptPhi>()) as *mut OptPhi;
        if bb.phi_count > 0 && (bb.phis as usize) != 0 {
            let old_bytes = opt_mul_usize(bb.phi_count, size_of<OptPhi>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(bb.phis as *const u8, new_phis as *mut u8, old_bytes);
            }
        }
        bb.phis = new_phis;
        bb.phi_cap = new_cap;
    }
    let idx = bb.phi_count;
    bb.phi_count = idx + 1;
    let dst = unsafe { opt_phi_at(bb.phis, idx) };
    unsafe {
        (*dst).result = phi.result;
        (*dst).ty = phi.ty;
        (*dst).src_local = phi.src_local;
        (*dst).proj_field = phi.proj_field;
        (*dst).slot_idx = phi.slot_idx;
        (*dst).incoming_values = phi.incoming_values;
        (*dst).incoming_blocks = phi.incoming_blocks;
        (*dst).arity = phi.arity;
        opt_copy_origin(mut_view((*dst).origin), view(phi.origin));
    }
}

// --- Place Classification & SROA Eligibility (AXS-OPT-012, AXS-OPT-014) ---

fn opt_place_is_memory_deref_or_index(p: view<MirPlace>) -> bool {
    let mut i: usize = 0;
    while i < p.proj_count {
        let pr = unsafe { mir_proj_at(p.projs, i) };
        let k = unsafe { (*pr).kind };
        if k == MIR_PROJ_DEREF || k == MIR_PROJ_INDEX || k == MIR_PROJ_SUB_SLICE || k == MIR_PROJ_DOWNCAST {
            return true;
        }
        i = i + 1;
    }
    false
}

fn opt_place_single_field(p: view<MirPlace>) -> u32 {
    if p.proj_count == 1 && (p.projs as usize) != 0 {
        let pr = unsafe { mir_proj_at(p.projs, 0) };
        if (unsafe { (*pr).kind }) == MIR_PROJ_FIELD {
            return unsafe { (*pr).field_idx };
        }
    }
    OPT_PROJ_NONE
}

fn opt_scan_place_usage(
    p: view<MirPlace>,
    is_ref_target: bool,
    is_drop_target: bool,
    is_whole_use: bool,
    addr_taken: *mut bool,
    dropped: *mut bool,
    has_complex_proj: *mut bool,
    has_whole_use: *mut bool,
    max_field_plus1: *mut u32,
    local_count: usize
) {
    let lv = p.local.v as usize;
    if lv >= local_count {
        return;
    }
    if is_ref_target && p.proj_count == 0 {
        unsafe { *opt_bool_at(addr_taken, lv) = true; }
    }
    if is_drop_target || p.drop_flag != MIR_DROP_FLAG_NONE {
        unsafe { *opt_bool_at(dropped, lv) = true; }
    }
    if p.proj_count == 0 {
        if is_whole_use {
            unsafe { *opt_bool_at(has_whole_use, lv) = true; }
        }
        return;
    }
    // If address of a projected place is taken, mark base local address-taken unless it's through a deref
    let pr0 = unsafe { mir_proj_at(p.projs, 0) };
    let k0 = unsafe { (*pr0).kind };
    if is_ref_target && k0 != MIR_PROJ_DEREF {
        unsafe { *opt_bool_at(addr_taken, lv) = true; }
    }
    if p.proj_count == 1 && k0 == MIR_PROJ_FIELD {
        let fidx = unsafe { (*pr0).field_idx };
        if fidx < OPT_MAX_SROA_FIELDS {
            let cur_max = unsafe { *opt_u32_at(max_field_plus1, lv) };
            if fidx + 1u32 > cur_max {
                unsafe { *opt_u32_at(max_field_plus1, lv) = fidx + 1u32; }
            }
            return;
        }
    }
    // Any other projection (deref, index, subslice, downcast, nested field)
    if k0 != MIR_PROJ_DEREF {
        unsafe { *opt_bool_at(has_complex_proj, lv) = true; }
    } else {
        unsafe { *opt_bool_at(has_whole_use, lv) = true; }
    }
}

fn opt_scan_operand_usage(
    op: view<MirOperand>,
    addr_taken: *mut bool,
    dropped: *mut bool,
    has_complex_proj: *mut bool,
    has_whole_use: *mut bool,
    max_field_plus1: *mut u32,
    local_count: usize
) {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        let is_whole = op.place.proj_count == 0;
        opt_scan_place_usage(
            view(op.place),
            false,
            false,
            is_whole,
            addr_taken,
            dropped,
            has_complex_proj,
            has_whole_use,
            max_field_plus1,
            local_count
        );
    }
}

fn optir_classify_locals(
    body: mut_view<OptBody>,
    mir: view<MirBody>,
    arena: mut_view<Arena>
) {
    let lc = mir.local_count;
    body.local_count = lc;
    body.arg_count = mir.arg_count;

    let alloc_lc: usize = if lc == 0 { 1 } else { lc };
    body.local_tys = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_lc, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    body.local_modes = arena_alloc_raw(mut_view(*arena), alloc_lc, 1);
    body.local_addr_taken = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_lc, size_of<bool>()), align_of<bool>()) as *mut bool;
    body.local_dropped = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_lc, size_of<bool>()), align_of<bool>()) as *mut bool;
    body.local_sroa_base = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_lc, size_of<u32>()), align_of<u32>()) as *mut u32;
    body.local_sroa_count = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_lc, size_of<u32>()), align_of<u32>()) as *mut u32;

    let has_complex_proj = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_lc, size_of<bool>()), align_of<bool>()) as *mut bool;
    let has_whole_use = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_lc, size_of<bool>()), align_of<bool>()) as *mut bool;
    let max_field_plus1 = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_lc, size_of<u32>()), align_of<u32>()) as *mut u32;

    let mut i: usize = 0;
    while i < lc {
        let decl = unsafe { mir_local_at(mir.locals, i) };
        let ty = unsafe { (*decl).ty };
        unsafe {
            *opt_typeid_at(body.local_tys, i) = ty;
            *opt_u8_at(body.local_modes, i) = OPT_LOCAL_SCALAR;
            *opt_bool_at(body.local_addr_taken, i) = false;
            *opt_bool_at(body.local_dropped, i) = false;
            *opt_u32_at(body.local_sroa_base, i) = OPT_PROJ_NONE;
            *opt_u32_at(body.local_sroa_count, i) = 0u32;
            *opt_bool_at(has_complex_proj, i) = false;
            *opt_bool_at(has_whole_use, i) = false;
            *opt_u32_at(max_field_plus1, i) = 0u32;
        }
        i = i + 1;
    }

    let mut b: usize = 0;
    while b < mir.bb_count {
        let bb = unsafe { mir_bb_at(mir.bbs, b) };
        let sc = unsafe { (*bb).stmt_count };
        let stmts = unsafe { (*bb).stmts };
        let mut s: usize = 0;
        while s < sc {
            let st = unsafe { mir_stmt_at(stmts, s) };
            let sk = unsafe { (*st).kind };
            if sk == MIR_STMT_ASSIGN {
                let rvk = unsafe { (*st).rvalue.kind };
                let lhs_whole = (unsafe { (*st).place.proj_count }) == 0 && rvk != MIR_RVALUE_AGGREGATE;
                opt_scan_place_usage(
                    unsafe { view((*st).place) },
                    false,
                    false,
                    lhs_whole,
                    body.local_addr_taken,
                    body.local_dropped,
                    has_complex_proj,
                    has_whole_use,
                    max_field_plus1,
                    lc
                );
                if rvk == MIR_RVALUE_AGGREGATE {
                    let lv = (unsafe { (*st).place.local.v }) as usize;
                    let oc = unsafe { (*st).rvalue.operand_count };
                    if lv < lc && (unsafe { (*st).place.proj_count }) == 0 && oc > 0 && (oc as u32) <= OPT_MAX_SROA_FIELDS {
                        let cur_max = unsafe { *opt_u32_at(max_field_plus1, lv) };
                        if (oc as u32) > cur_max {
                            unsafe { *opt_u32_at(max_field_plus1, lv) = oc as u32; }
                        }
                    }
                    let mut oi: usize = 0;
                    while oi < oc {
                        let op = unsafe { mir_op_at((*st).rvalue.operands, oi) };
                        opt_scan_operand_usage(
                            unsafe { view(*op) },
                            body.local_addr_taken,
                            body.local_dropped,
                            has_complex_proj,
                            has_whole_use,
                            max_field_plus1,
                            lc
                        );
                        oi = oi + 1;
                    }
                } else if rvk == MIR_RVALUE_USE || rvk == MIR_RVALUE_REPEAT || rvk == MIR_RVALUE_CAST || rvk == MIR_RVALUE_UNARY_OP {
                    opt_scan_operand_usage(
                        unsafe { view((*st).rvalue.use_op) },
                        body.local_addr_taken,
                        body.local_dropped,
                        has_complex_proj,
                        has_whole_use,
                        max_field_plus1,
                        lc
                    );
                } else if rvk == MIR_RVALUE_REF {
                    opt_scan_place_usage(
                        unsafe { view((*st).rvalue.place) },
                        true,
                        false,
                        true,
                        body.local_addr_taken,
                        body.local_dropped,
                        has_complex_proj,
                        has_whole_use,
                        max_field_plus1,
                        lc
                    );
                } else if rvk == MIR_RVALUE_LEN || rvk == MIR_RVALUE_DISCRIMINANT {
                    opt_scan_place_usage(
                        unsafe { view((*st).rvalue.place) },
                        false,
                        false,
                        true,
                        body.local_addr_taken,
                        body.local_dropped,
                        has_complex_proj,
                        has_whole_use,
                        max_field_plus1,
                        lc
                    );
                } else if rvk == MIR_RVALUE_BINARY_OP || rvk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                    opt_scan_operand_usage(
                        unsafe { view((*st).rvalue.lhs) },
                        body.local_addr_taken,
                        body.local_dropped,
                        has_complex_proj,
                        has_whole_use,
                        max_field_plus1,
                        lc
                    );
                    opt_scan_operand_usage(
                        unsafe { view((*st).rvalue.rhs) },
                        body.local_addr_taken,
                        body.local_dropped,
                        has_complex_proj,
                        has_whole_use,
                        max_field_plus1,
                        lc
                    );
                }
            } else if sk == MIR_STMT_DROP {
                opt_scan_place_usage(
                    unsafe { view((*st).place) },
                    false,
                    true,
                    true,
                    body.local_addr_taken,
                    body.local_dropped,
                    has_complex_proj,
                    has_whole_use,
                    max_field_plus1,
                    lc
                );
            }
            s = s + 1;
        }
        if unsafe { (*bb).has_terminator } {
            let tk = unsafe { (*bb).terminator.kind };
            if tk == MIR_TERM_SWITCH_INT {
                opt_scan_operand_usage(
                    unsafe { view((*bb).terminator.discr) },
                    body.local_addr_taken,
                    body.local_dropped,
                    has_complex_proj,
                    has_whole_use,
                    max_field_plus1,
                    lc
                );
            } else if tk == MIR_TERM_DROP {
                opt_scan_place_usage(
                    unsafe { view((*bb).terminator.drop_place) },
                    false,
                    true,
                    true,
                    body.local_addr_taken,
                    body.local_dropped,
                    has_complex_proj,
                    has_whole_use,
                    max_field_plus1,
                    lc
                );
            } else if tk == MIR_TERM_CALL {
                opt_scan_operand_usage(
                    unsafe { view((*bb).terminator.func) },
                    body.local_addr_taken,
                    body.local_dropped,
                    has_complex_proj,
                    has_whole_use,
                    max_field_plus1,
                    lc
                );
                let ac = unsafe { (*bb).terminator.arg_count };
                let mut ai: usize = 0;
                while ai < ac {
                    let aop = unsafe { mir_op_at((*bb).terminator.args, ai) };
                    opt_scan_operand_usage(
                        unsafe { view(*aop) },
                        body.local_addr_taken,
                        body.local_dropped,
                        has_complex_proj,
                        has_whole_use,
                        max_field_plus1,
                        lc
                    );
                    ai = ai + 1;
                }
                if unsafe { (*bb).terminator.has_destination } {
                    opt_scan_place_usage(
                        unsafe { view((*bb).terminator.destination) },
                        false,
                        false,
                        true,
                        body.local_addr_taken,
                        body.local_dropped,
                        has_complex_proj,
                        has_whole_use,
                        max_field_plus1,
                        lc
                    );
                }
            } else if tk == MIR_TERM_ASSERT {
                opt_scan_operand_usage(
                    unsafe { view((*bb).terminator.cond) },
                    body.local_addr_taken,
                    body.local_dropped,
                    has_complex_proj,
                    has_whole_use,
                    max_field_plus1,
                    lc
                );
            }
        }
        b = b + 1;
    }

    // Assign SSA slots:
    // Slots 0..lc-1 correspond to locals _0.._(lc-1).
    // Extra slots lc..slot_count-1 correspond to SROA fields of eligible aggregate locals.
    let mut total_slots: usize = lc;
    i = 0;
    while i < lc {
        let is_addr = unsafe { *opt_bool_at(body.local_addr_taken, i) };
        let is_drp = unsafe { *opt_bool_at(body.local_dropped, i) };
        let is_cpx = unsafe { *opt_bool_at(has_complex_proj, i) };
        let is_whl = unsafe { *opt_bool_at(has_whole_use, i) };
        let fcnt = unsafe { *opt_u32_at(max_field_plus1, i) };
        if is_addr || is_cpx {
            unsafe { *opt_u8_at(body.local_modes, i) = OPT_LOCAL_MEMORY; }
        } else if fcnt > 0u32 {
            // Eligible for SROA field scalarization if not dropped and not address-taken (AXS-OPT-014)
            if !is_drp && !is_whl && i != 0 {
                unsafe {
                    *opt_u8_at(body.local_modes, i) = OPT_LOCAL_SROA;
                    *opt_u32_at(body.local_sroa_base, i) = total_slots as u32;
                    *opt_u32_at(body.local_sroa_count, i) = fcnt;
                }
                total_slots = total_slots + (fcnt as usize);
            } else {
                unsafe { *opt_u8_at(body.local_modes, i) = OPT_LOCAL_MEMORY; }
            }
        } else {
            unsafe { *opt_u8_at(body.local_modes, i) = OPT_LOCAL_SCALAR; }
        }
        i = i + 1;
    }

    let alloc_slots: usize = if total_slots == 0 { 1 } else { total_slots };
    body.slot_count = total_slots;
    body.slot_local = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_slots, size_of<u32>()), align_of<u32>()) as *mut u32;
    body.slot_field = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_slots, size_of<u32>()), align_of<u32>()) as *mut u32;
    body.slot_ty = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_slots, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;

    i = 0;
    while i < lc {
        let lty_v = (unsafe { *opt_typeid_at(body.local_tys, i) }).v;
        unsafe {
            *opt_u32_at(body.slot_local, i) = i as u32;
            *opt_u32_at(body.slot_field, i) = OPT_PROJ_NONE;
            *opt_typeid_at(body.slot_ty, i) = TypeId { v: lty_v };
        }
        let mode = unsafe { *opt_u8_at(body.local_modes, i) };
        if mode == OPT_LOCAL_SROA {
            let sbase = unsafe { *opt_u32_at(body.local_sroa_base, i) } as usize;
            let scnt = unsafe { *opt_u32_at(body.local_sroa_count, i) } as usize;
            let mut f: usize = 0;
            while f < scnt {
                let fty = opt_type_field_ty(body.thir, TypeId { v: lty_v }, f as u32);
                unsafe {
                    *opt_u32_at(body.slot_local, sbase + f) = i as u32;
                    *opt_u32_at(body.slot_field, sbase + f) = f as u32;
                    *opt_typeid_at(body.slot_ty, sbase + f) = fty;
                }
                f = f + 1;
            }
        }
        i = i + 1;
    }
}

fn opt_place_to_slot(body: view<OptBody>, p: view<MirPlace>) -> u32 {
    let lv = p.local.v as usize;
    if lv >= body.local_count {
        return OPT_PROJ_NONE;
    }
    let mode = unsafe { *opt_u8_at(body.local_modes, lv) };
    if p.proj_count == 0 {
        if mode == OPT_LOCAL_SCALAR {
            return lv as u32;
        }
        return OPT_PROJ_NONE;
    }
    if mode == OPT_LOCAL_SROA {
        let fidx = opt_place_single_field(p);
        let scnt = unsafe { *opt_u32_at(body.local_sroa_count, lv) };
        if fidx < scnt {
            let sbase = unsafe { *opt_u32_at(body.local_sroa_base, lv) };
            return sbase + fidx;
        }
    }
    OPT_PROJ_NONE
}

// --- CFG & Edge Helpers (AXS-OPT-011) ---

fn opt_bbid_push_unique_sorted(arr: *mut OptBbId, count: mut_view<usize>, cap: usize, val: OptBbId) {
    if val.v == OPT_BB_NONE {
        return;
    }
    let n = *count;
    let mut i: usize = 0;
    while i < n {
        let cur = unsafe { (*opt_bbid_at(arr, i)).v };
        if cur == val.v {
            return;
        }
        if cur > val.v {
            break;
        }
        i = i + 1;
    }
    if n >= cap {
        return;
    }
    let mut j: usize = n;
    while j > i {
        let prev = unsafe { *opt_bbid_at(arr, j - 1) };
        unsafe { *opt_bbid_at(arr, j) = prev; }
        j = j - 1;
    }
    unsafe { *opt_bbid_at(arr, i) = val; }
    *count = n + 1;
}

pub fn optir_compute_cfg(body: mut_view<OptBody>, arena: mut_view<Arena>) {
    let n = body.bb_count;
    if n == 0 {
        return;
    }
    // 1. Compute sorted unique successors for each block
    let mut i: usize = 0;
    while i < n {
        let bb = unsafe { opt_block_at(body.blocks, i) };
        let tk = unsafe { (*bb).term.kind };
        let max_succs: usize = if tk == OPT_TERM_SWITCH_INT {
            (unsafe { (*bb).term.switch_count }) + 1
        } else {
            2
        };
        let alloc_succs: usize = if max_succs == 0 { 1 } else { max_succs };
        let succ_arr = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_succs, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
        let mut scnt: usize = 0;
        if tk == OPT_TERM_GOTO {
            let t = unsafe { (*bb).term.true_bb };
            if (t.v as usize) < n {
                opt_bbid_push_unique_sorted(succ_arr, mut_view(scnt), alloc_succs, t);
            }
        } else if tk == OPT_TERM_BRANCH {
            let t1 = unsafe { (*bb).term.true_bb };
            let t2 = unsafe { (*bb).term.false_bb };
            if (t1.v as usize) < n {
                opt_bbid_push_unique_sorted(succ_arr, mut_view(scnt), alloc_succs, t1);
            }
            if (t2.v as usize) < n {
                opt_bbid_push_unique_sorted(succ_arr, mut_view(scnt), alloc_succs, t2);
            }
        } else if tk == OPT_TERM_SWITCH_INT {
            let sw_cnt = unsafe { (*bb).term.switch_count };
            let sw_tgts = unsafe { (*bb).term.switch_targets };
            let mut k: usize = 0;
            while k < sw_cnt {
                let st = unsafe { *opt_bbid_at(sw_tgts, k) };
                if (st.v as usize) < n {
                    opt_bbid_push_unique_sorted(succ_arr, mut_view(scnt), alloc_succs, st);
                }
                k = k + 1;
            }
            let ow = unsafe { (*bb).term.otherwise_bb };
            if (ow.v as usize) < n {
                opt_bbid_push_unique_sorted(succ_arr, mut_view(scnt), alloc_succs, ow);
            }
        } else if tk == OPT_TERM_CALL || tk == OPT_TERM_ASSERT || tk == OPT_TERM_DROP {
            let t1 = unsafe { (*bb).term.true_bb };
            let unw = unsafe { (*bb).term.unwind_bb };
            if (t1.v as usize) < n {
                opt_bbid_push_unique_sorted(succ_arr, mut_view(scnt), alloc_succs, t1);
            }
            if unw.v != OPT_BB_NONE && (unw.v as usize) < n {
                // Only include cleanup unwind edge if unwind target is non-empty or not pure unreachable stub
                let unw_bb = unsafe { opt_block_at(body.blocks, unw.v as usize) };
                let unw_tk = unsafe { (*unw_bb).term.kind };
                let unw_ic = unsafe { (*unw_bb).inst_count };
                if unw_tk != OPT_TERM_UNREACHABLE || unw_ic > 0 {
                    opt_bbid_push_unique_sorted(succ_arr, mut_view(scnt), alloc_succs, unw);
                }
            }
        }
        unsafe {
            (*bb).succs = succ_arr;
            (*bb).succ_count = scnt;
            (*bb).pred_count = 0;
        }
        i = i + 1;
    }

    // 2. Count predecessors per block
    let pred_caps = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<u32>()), align_of<u32>()) as *mut u32;
    i = 0;
    while i < n {
        unsafe { *opt_u32_at(pred_caps, i) = 0u32; }
        i = i + 1;
    }
    i = 0;
    while i < n {
        let bb = unsafe { opt_block_at(body.blocks, i) };
        let sc = unsafe { (*bb).succ_count };
        let mut s: usize = 0;
        while s < sc {
            let sid = (unsafe { (*opt_bbid_at((*bb).succs, s)).v }) as usize;
            if sid < n {
                let old_c = unsafe { *opt_u32_at(pred_caps, sid) };
                unsafe { *opt_u32_at(pred_caps, sid) = old_c + 1u32; }
            }
            s = s + 1;
        }
        i = i + 1;
    }

    i = 0;
    while i < n {
        let bb = unsafe { opt_block_at(body.blocks, i) };
        let pcap = (unsafe { *opt_u32_at(pred_caps, i) }) as usize;
        let alloc_p: usize = if pcap == 0 { 1 } else { pcap };
        let parr = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_p, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
        unsafe {
            (*bb).preds = parr;
            (*bb).pred_count = 0;
        }
        i = i + 1;
    }

    // 3. Populate sorted unique predecessors
    i = 0;
    while i < n {
        let bb = unsafe { opt_block_at(body.blocks, i) };
        let sc = unsafe { (*bb).succ_count };
        let mut s: usize = 0;
        while s < sc {
            let sid = (unsafe { (*opt_bbid_at((*bb).succs, s)).v }) as usize;
            if sid < n {
                let sbb = unsafe { opt_block_at(body.blocks, sid) };
                let pcap = (unsafe { *opt_u32_at(pred_caps, sid) }) as usize;
                let mut pcnt = unsafe { (*sbb).pred_count };
                opt_bbid_push_unique_sorted(unsafe { (*sbb).preds }, mut_view(pcnt), pcap, OptBbId { v: i as u32 });
                unsafe { (*sbb).pred_count = pcnt; }
            }
            s = s + 1;
        }
        i = i + 1;
    }
}

// --- Reachability, RPO, Cooper-Harvey-Kennedy Dominator Tree & Dominance Frontier (AXS-OPT-011) ---

fn opt_dfs_rpo(
    blocks: *mut OptBlock,
    bb_count: usize,
    cur: usize,
    vis: *mut bool,
    post: *mut OptBbId,
    post_len: mut_view<usize>
) {
    if cur >= bb_count || (unsafe { *opt_bool_at(vis, cur) }) {
        return;
    }
    unsafe { *opt_bool_at(vis, cur) = true; }
    let bb = unsafe { opt_block_at(blocks, cur) };
    let sc = unsafe { (*bb).succ_count };
    let succs = unsafe { (*bb).succs };
    let mut i: usize = 0;
    while i < sc {
        let nxt = (unsafe { (*opt_bbid_at(succs, i)).v }) as usize;
        opt_dfs_rpo(blocks, bb_count, nxt, vis, post, mut_view(*post_len));
        i = i + 1;
    }
    let idx = *post_len;
    unsafe { *opt_bbid_at(post, idx) = OptBbId { v: cur as u32 }; }
    *post_len = idx + 1;
}

fn opt_chk_intersect(blocks: *mut OptBlock, b1: OptBbId, b2: OptBbId) -> OptBbId {
    let mut f1 = b1;
    let mut f2 = b2;
    while f1.v != f2.v {
        let mut r1 = unsafe { (*opt_block_at(blocks, f1.v as usize)).rpo_idx };
        let mut r2 = unsafe { (*opt_block_at(blocks, f2.v as usize)).rpo_idx };
        while r1 > r2 {
            f1 = unsafe { (*opt_block_at(blocks, f1.v as usize)).idom };
            r1 = unsafe { (*opt_block_at(blocks, f1.v as usize)).rpo_idx };
        }
        while r2 > r1 {
            f2 = unsafe { (*opt_block_at(blocks, f2.v as usize)).idom };
            r2 = unsafe { (*opt_block_at(blocks, f2.v as usize)).rpo_idx };
        }
    }
    f1
}

pub fn optir_compute_dominators(body: mut_view<OptBody>, arena: mut_view<Arena>) {
    let n = body.bb_count;
    if n == 0 {
        body.rpo_count = 0;
        return;
    }
    let vis = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let post = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
    let rpo = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;

    let mut i: usize = 0;
    while i < n {
        unsafe { *opt_bool_at(vis, i) = false; }
        let bb = unsafe { opt_block_at(body.blocks, i) };
        unsafe {
            (*bb).is_reachable = false;
            (*bb).idom = OptBbId { v: OPT_BB_NONE };
            (*bb).dom_depth = 0u32;
            (*bb).rpo_idx = OPT_BB_NONE;
        }
        i = i + 1;
    }

    let mut post_len: usize = 0;
    opt_dfs_rpo(body.blocks, n, 0, vis, post, mut_view(post_len));

    body.rpo_order = rpo;
    body.rpo_count = post_len;

    i = 0;
    while i < post_len {
        let bbid_v = (unsafe { *opt_bbid_at(post, post_len - 1 - i) }).v;
        unsafe { *opt_bbid_at(rpo, i) = OptBbId { v: bbid_v }; }
        let bb = unsafe { opt_block_at(body.blocks, bbid_v as usize) };
        unsafe {
            (*bb).is_reachable = true;
            (*bb).rpo_idx = i as u32;
        }
        i = i + 1;
    }

    // Entry block bb0 dominates itself
    let bb0 = unsafe { opt_block_at(body.blocks, 0) };
    unsafe { (*bb0).idom = OptBbId { v: 0u32 }; }

    // Cooper-Harvey-Kennedy iterative RPO fixed-point
    let mut changed = true;
    while changed {
        changed = false;
        let mut r: usize = 1;
        while r < post_len {
            let b_id_v = (unsafe { *opt_bbid_at(rpo, r) }).v;
            let bb = unsafe { opt_block_at(body.blocks, b_id_v as usize) };
            let pcnt = unsafe { (*bb).pred_count };
            let preds = unsafe { (*bb).preds };
            let mut new_idom_v = OPT_BB_NONE;
            let mut p: usize = 0;
            while p < pcnt {
                let pid_v = (unsafe { *opt_bbid_at(preds, p) }).v;
                let pbb = unsafe { opt_block_at(body.blocks, pid_v as usize) };
                if (unsafe { (*pbb).is_reachable }) && (unsafe { (*pbb).idom.v }) != OPT_BB_NONE {
                    if new_idom_v == OPT_BB_NONE {
                        new_idom_v = pid_v;
                    } else {
                        let inter = opt_chk_intersect(body.blocks, OptBbId { v: pid_v }, OptBbId { v: new_idom_v });
                        new_idom_v = inter.v;
                    }
                }
                p = p + 1;
            }
            if new_idom_v != OPT_BB_NONE && (unsafe { (*bb).idom.v }) != new_idom_v {
                unsafe { (*bb).idom = OptBbId { v: new_idom_v }; }
                changed = true;
            }
            r = r + 1;
        }
    }

    // Compute dom_depth in RPO order (idom(B) always has smaller rpo_idx than B)
    let mut r2: usize = 0;
    while r2 < post_len {
        let b_id_v = (unsafe { *opt_bbid_at(rpo, r2) }).v;
        let bb = unsafe { opt_block_at(body.blocks, b_id_v as usize) };
        if b_id_v == 0u32 {
            unsafe { (*bb).dom_depth = 0u32; }
        } else {
            let idom_v = unsafe { (*bb).idom.v };
            if idom_v != OPT_BB_NONE && idom_v != b_id_v {
                let idom_bb = unsafe { opt_block_at(body.blocks, idom_v as usize) };
                unsafe { (*bb).dom_depth = (*idom_bb).dom_depth + 1u32; }
            }
        }
        r2 = r2 + 1;
    }
}

pub fn opt_dominates(body: view<OptBody>, a: OptBbId, b: OptBbId) -> bool {
    if (a.v as usize) >= body.bb_count || (b.v as usize) >= body.bb_count {
        return false;
    }
    let bba = unsafe { opt_block_at(body.blocks, a.v as usize) };
    let bbb = unsafe { opt_block_at(body.blocks, b.v as usize) };
    if !(unsafe { (*bba).is_reachable }) || !(unsafe { (*bbb).is_reachable }) {
        return false;
    }
    let mut cur = b;
    let mut steps: usize = 0;
    while steps <= body.bb_count {
        if cur.v == a.v {
            return true;
        }
        if cur.v == 0u32 {
            break;
        }
        let cbb = unsafe { opt_block_at(body.blocks, cur.v as usize) };
        let nxt = unsafe { (*cbb).idom };
        if nxt.v == OPT_BB_NONE || nxt.v == cur.v {
            break;
        }
        cur = nxt;
        steps = steps + 1;
    }
    false
}

pub fn opt_strictly_dominates(body: view<OptBody>, a: OptBbId, b: OptBbId) -> bool {
    a.v != b.v && opt_dominates(body, a, b)
}

pub fn optir_compute_dom_frontier(body: mut_view<OptBody>, arena: mut_view<Arena>) {
    let n = body.bb_count;
    if n == 0 {
        return;
    }
    // Allocate temporary n * n frontier buffer or per-block cap = n
    let mut i: usize = 0;
    while i < n {
        let bb = unsafe { opt_block_at(body.blocks, i) };
        let df_arr = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
        unsafe {
            (*bb).dom_frontier = df_arr;
            (*bb).dom_frontier_count = 0;
        }
        i = i + 1;
    }

    let mut j: usize = 0;
    while j < n {
        let jbb = unsafe { opt_block_at(body.blocks, j) };
        if unsafe { (*jbb).is_reachable } {
            let pcnt = unsafe { (*jbb).pred_count };
            let preds = unsafe { (*jbb).preds };
            // Count reachable predecessors
            let mut reach_preds: usize = 0;
            let mut p: usize = 0;
            while p < pcnt {
                let pid = unsafe { *opt_bbid_at(preds, p) };
                let pbb = unsafe { opt_block_at(body.blocks, pid.v as usize) };
                if unsafe { (*pbb).is_reachable } {
                    reach_preds = reach_preds + 1;
                }
                p = p + 1;
            }
            if reach_preds >= 2 {
                let idom_j = unsafe { (*jbb).idom };
                p = 0;
                while p < pcnt {
                    let pid = unsafe { *opt_bbid_at(preds, p) };
                    let pbb = unsafe { opt_block_at(body.blocks, pid.v as usize) };
                    if unsafe { (*pbb).is_reachable } {
                        let mut runner = pid;
                        let mut guard: usize = 0;
                        while runner.v != OPT_BB_NONE && runner.v != idom_j.v && guard <= n {
                            let rbb = unsafe { opt_block_at(body.blocks, runner.v as usize) };
                            let mut df_cnt = unsafe { (*rbb).dom_frontier_count };
                            opt_bbid_push_unique_sorted(unsafe { (*rbb).dom_frontier }, mut_view(df_cnt), n, OptBbId { v: j as u32 });
                            unsafe { (*rbb).dom_frontier_count = df_cnt; }
                            runner = unsafe { (*rbb).idom };
                            guard = guard + 1;
                        }
                    }
                    p = p + 1;
                }
            }
        }
        j = j + 1;
    }
}

// --- Initial MIR -> OptIR Statement & Terminator Lowering ---

fn opt_operand_temp_val(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    op: view<MirOperand>,
    bb_id_v: u32,
    inst_id_v: u32,
    origin: view<OptOrigin>
) -> OptValueId {
    if op.kind == MIR_OP_CONST {
        return optir_alloc_value(
            mut_view(*body),
            mut_view(*arena),
            TypeId { v: op.constant.ty.v },
            OPT_VAL_CONST,
            OptBbId { v: bb_id_v },
            OptInstId { v: inst_id_v },
            MirLocalId { v: 0u32 },
            OPT_PROJ_NONE,
            view(op.constant),
            origin
        );
    }
    let lv = op.place.local.v;
    let lty_v: u32 = if (lv as usize) < body.local_count {
        (unsafe { *opt_typeid_at(body.local_tys, lv as usize) }).v
    } else {
        0u32
    };
    let fidx = opt_place_single_field(view(op.place));
    let val_ty_v: u32 = if fidx != OPT_PROJ_NONE {
        opt_type_field_ty(body.thir, TypeId { v: lty_v }, fidx).v
    } else {
        lty_v
    };
    let zc = opt_zero_const(TypeId { v: val_ty_v });
    optir_alloc_value(
        mut_view(*body),
        mut_view(*arena),
        TypeId { v: val_ty_v },
        OPT_VAL_INST,
        OptBbId { v: bb_id_v },
        OptInstId { v: inst_id_v },
        MirLocalId { v: lv },
        fidx,
        view(zc),
        origin
    )
}

fn opt_make_blank_inst(id_v: u32, opcode: u8, origin: view<OptOrigin>, st: view<MirStmt>) -> OptInst {
    let mut inst = OptInst {
        id: OptInstId { v: id_v },
        opcode: opcode,
        sub_op: 0u8,
        flags: OPT_FLAG_NONE,
        result: OptValueId { v: OPT_VALUE_NONE },
        ty: TypeId { v: 0u32 },
        lhs: OptValueId { v: OPT_VALUE_NONE },
        rhs: OptValueId { v: OPT_VALUE_NONE },
        extra_args: 0 as *mut OptValueId,
        extra_arg_count: 0,
        place: mir_local_place(0u32),
        rhs_place: mir_local_place(0u32),
        mem_use: MemSsaId { v: MEM_SSA_NONE },
        mem_def: MemSsaId { v: MEM_SSA_NONE },
        origin: opt_origin_make(view(origin.span), origin.mir_bb.v, origin.mir_stmt_idx, origin.pass_id),
        orig_stmt: MirStmt {
            kind: MIR_STMT_STORAGE_LIVE,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: mir_local_place(0u32),
            rvalue: MirRvalue {
                kind: MIR_RVALUE_USE,
                use_op: MirOperand {
                    kind: MIR_OP_CONST,
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    constant: opt_zero_const(TypeId { v: 0u32 }),
                },
                repeat_count: 0u64,
                repeat_count_op: 0 as *mut MirOperand,
                borrow_kind: 0u8,
                place: mir_local_place(0u32),
                cast_kind: 0u8,
                target_ty: TypeId { v: 0u32 },
                bin_op: 0u8,
                lhs: MirOperand {
                    kind: MIR_OP_CONST,
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    constant: opt_zero_const(TypeId { v: 0u32 }),
                },
                rhs: MirOperand {
                    kind: MIR_OP_CONST,
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    constant: opt_zero_const(TypeId { v: 0u32 }),
                },
                un_op: 0u8,
                variant_idx: 0u32,
                operands: 0 as *mut MirOperand,
                operand_count: 0,
            },
            storage_local: MirLocalId { v: 0u32 },
        },
    };
    mir_copy_stmt(mut_view(inst.orig_stmt), st);
    inst
}

fn optir_lower_mir_blocks(
    body: mut_view<OptBody>,
    mir: view<MirBody>,
    arena: mut_view<Arena>
) {
    let bb_cnt = mir.bb_count;
    body.bb_count = bb_cnt;
    let alloc_bbs: usize = if bb_cnt == 0 { 1 } else { bb_cnt };
    body.blocks = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_bbs, size_of<OptBlock>()), align_of<OptBlock>()) as *mut OptBlock;

    let mut next_inst_id: u32 = 0u32;

    let mut b: usize = 0;
    while b < bb_cnt {
        let mbb = unsafe { mir_bb_at(mir.bbs, b) };
        let obb = unsafe { opt_block_at(body.blocks, b) };
        let bb_id = OptBbId { v: b as u32 };
        unsafe {
            (*obb).id = bb_id;
            (*obb).is_cleanup = (*mbb).is_cleanup;
            (*obb).is_reachable = false;
            (*obb).preds = 0 as *mut OptBbId;
            (*obb).pred_count = 0;
            (*obb).succs = 0 as *mut OptBbId;
            (*obb).succ_count = 0;
            (*obb).phis = 0 as *mut OptPhi;
            (*obb).phi_count = 0;
            (*obb).phi_cap = 0;
            (*obb).has_mem_phi = false;
            (*obb).mem_phi_result = MemSsaId { v: MEM_SSA_NONE };
            (*obb).mem_phi_inputs = 0 as *mut MemSsaId;
            (*obb).mem_in = MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY };
            (*obb).mem_out = MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY };
            (*obb).insts = 0 as *mut OptInst;
            (*obb).inst_count = 0;
            (*obb).inst_cap = 0;
            (*obb).has_term = false;
            (*obb).idom = OptBbId { v: OPT_BB_NONE };
            (*obb).dom_depth = 0u32;
            (*obb).rpo_idx = OPT_BB_NONE;
            (*obb).dom_frontier = 0 as *mut OptBbId;
            (*obb).dom_frontier_count = 0;
        }

        let sc = unsafe { (*mbb).stmt_count };
        let stmts = unsafe { (*mbb).stmts };
        let mut s: usize = 0;
        while s < sc {
            let st = unsafe { mir_stmt_at(stmts, s) };
            let sk = unsafe { (*st).kind };
            let origin = opt_origin_make(unsafe { view((*st).span) }, b as u32, s as u32, OPT_PASS_LOWER_MIR);
            let cur_iid_v = next_inst_id;
            next_inst_id = next_inst_id + 1u32;

            let mut inst = opt_make_blank_inst(cur_iid_v, OPT_INST_NOP, view(origin), unsafe { view(*st) });
            if sk == MIR_STMT_STORAGE_LIVE {
                inst.opcode = OPT_INST_NOP;
                inst.flags = OPT_FLAG_STORAGE_LIVE;
                inst.place = mir_local_place(unsafe { (*st).storage_local.v });
            } else if sk == MIR_STMT_STORAGE_DEAD {
                inst.opcode = OPT_INST_NOP;
                inst.flags = OPT_FLAG_STORAGE_DEAD;
                inst.place = mir_local_place(unsafe { (*st).storage_local.v });
            } else if sk == MIR_STMT_DROP {
                inst.opcode = OPT_INST_DROP_FLAG;
                inst.flags = OPT_FLAG_BARRIER;
                mir_copy_place(mut_view(inst.place), unsafe { view((*st).place) });
            } else if sk == MIR_STMT_ASSIGN {
                mir_copy_place(mut_view(inst.place), unsafe { view((*st).place) });
                let dst_lv = (unsafe { (*st).place.local.v }) as usize;
                let dst_base_ty_v: u32 = if dst_lv < body.local_count {
                    (unsafe { *opt_typeid_at(body.local_tys, dst_lv) }).v
                } else {
                    0u32
                };
                let dst_fidx = opt_place_single_field(unsafe { view((*st).place) });
                let dst_ty_v: u32 = if dst_fidx != OPT_PROJ_NONE {
                    opt_type_field_ty(body.thir, TypeId { v: dst_base_ty_v }, dst_fidx).v
                } else {
                    dst_base_ty_v
                };
                inst.ty = TypeId { v: dst_ty_v };

                let rvk = unsafe { (*st).rvalue.kind };
                let dst_slot = opt_place_to_slot(view(*body), unsafe { view((*st).place) });
                let dst_is_mem = dst_slot == OPT_PROJ_NONE || opt_place_is_memory_deref_or_index(unsafe { view((*st).place) });

                if rvk == MIR_RVALUE_USE {
                    let uop_kind = unsafe { (*st).rvalue.use_op.kind };
                    if uop_kind == MIR_OP_CONST {
                        inst.opcode = if dst_is_mem { OPT_INST_STORE } else { OPT_INST_CONST };
                        let cval_v = opt_operand_temp_val(
                            mut_view(*body),
                            mut_view(*arena),
                            unsafe { view((*st).rvalue.use_op) },
                            b as u32,
                            cur_iid_v,
                            view(origin)
                        ).v;
                        inst.lhs = OptValueId { v: cval_v };
                        inst.result = OptValueId { v: cval_v };
                    } else {
                        let src_slot = opt_place_to_slot(view(*body), unsafe { view((*st).rvalue.use_op.place) });
                        let src_is_mem = src_slot == OPT_PROJ_NONE || opt_place_is_memory_deref_or_index(unsafe { view((*st).rvalue.use_op.place) });
                        mir_copy_place(mut_view(inst.rhs_place), unsafe { view((*st).rvalue.use_op.place) });
                        if uop_kind == MIR_OP_MOVE {
                            inst.flags = inst.flags | OPT_FLAG_MOVE;
                        }
                        if (unsafe { (*st).place.drop_flag }) != MIR_DROP_FLAG_NONE ||
                           (unsafe { (*st).rvalue.use_op.place.drop_flag }) != MIR_DROP_FLAG_NONE {
                            inst.flags = inst.flags | OPT_FLAG_BARRIER;
                        }
                        let src_val = opt_operand_temp_val(
                            mut_view(*body),
                            mut_view(*arena),
                            unsafe { view((*st).rvalue.use_op) },
                            b as u32,
                            cur_iid_v,
                            view(origin)
                        );
                        inst.lhs = src_val;
                        if dst_is_mem {
                            if dst_fidx != OPT_PROJ_NONE && !opt_place_is_memory_deref_or_index(unsafe { view((*st).place) }) {
                                inst.opcode = OPT_INST_INSERT_FIELD;
                                inst.sub_op = dst_fidx as u8;
                            } else {
                                inst.opcode = OPT_INST_STORE;
                            }
                        } else if src_is_mem {
                            let src_fidx = opt_place_single_field(unsafe { view((*st).rvalue.use_op.place) });
                            if src_fidx != OPT_PROJ_NONE && !opt_place_is_memory_deref_or_index(unsafe { view((*st).rvalue.use_op.place) }) {
                                inst.opcode = OPT_INST_EXTRACT_FIELD;
                                inst.sub_op = src_fidx as u8;
                            } else {
                                inst.opcode = OPT_INST_LOAD;
                            }
                        } else {
                            inst.opcode = OPT_INST_COPY;
                        }
                    }
                } else if rvk == MIR_RVALUE_BINARY_OP {
                    let bop = unsafe { (*st).rvalue.bin_op };
                    inst.sub_op = bop;
                    if bop >= MIR_BINOP_WRAPPING_ADD && bop <= MIR_BINOP_WRAPPING_MUL {
                        inst.opcode = OPT_INST_WRAPPING_BINOP;
                    } else {
                        inst.opcode = OPT_INST_BINOP;
                        if bop == MIR_BINOP_DIV || bop == MIR_BINOP_REM || bop == MIR_BINOP_SHL || bop == MIR_BINOP_SHR {
                            inst.flags = inst.flags | OPT_FLAG_MAY_TRAP;
                        }
                    }
                    inst.lhs = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view((*st).rvalue.lhs) }, b as u32, cur_iid_v, view(origin));
                    inst.rhs = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view((*st).rvalue.rhs) }, b as u32, cur_iid_v, view(origin));
                } else if rvk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                    inst.opcode = OPT_INST_CHECKED_BINOP;
                    inst.sub_op = unsafe { (*st).rvalue.bin_op };
                    inst.flags = inst.flags | OPT_FLAG_MAY_TRAP;
                    inst.lhs = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view((*st).rvalue.lhs) }, b as u32, cur_iid_v, view(origin));
                    inst.rhs = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view((*st).rvalue.rhs) }, b as u32, cur_iid_v, view(origin));
                } else if rvk == MIR_RVALUE_UNARY_OP {
                    inst.opcode = OPT_INST_UNOP;
                    inst.sub_op = unsafe { (*st).rvalue.un_op };
                    if inst.sub_op == MIR_UNOP_NEG {
                        inst.flags = inst.flags | OPT_FLAG_MAY_TRAP;
                    }
                    inst.lhs = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view((*st).rvalue.use_op) }, b as u32, cur_iid_v, view(origin));
                } else if rvk == MIR_RVALUE_CAST {
                    inst.opcode = OPT_INST_CAST;
                    inst.sub_op = unsafe { (*st).rvalue.cast_kind };
                    inst.ty = TypeId { v: unsafe { (*st).rvalue.target_ty.v } };
                    inst.lhs = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view((*st).rvalue.use_op) }, b as u32, cur_iid_v, view(origin));
                } else if rvk == MIR_RVALUE_REF {
                    inst.opcode = OPT_INST_ADDR_OF;
                    inst.sub_op = unsafe { (*st).rvalue.borrow_kind };
                    mir_copy_place(mut_view(inst.rhs_place), unsafe { view((*st).rvalue.place) });
                } else if rvk == MIR_RVALUE_LEN {
                    inst.opcode = OPT_INST_LEN;
                    mir_copy_place(mut_view(inst.rhs_place), unsafe { view((*st).rvalue.place) });
                } else if rvk == MIR_RVALUE_DISCRIMINANT {
                    inst.opcode = OPT_INST_DISCRIMINANT;
                    mir_copy_place(mut_view(inst.rhs_place), unsafe { view((*st).rvalue.place) });
                } else if rvk == MIR_RVALUE_AGGREGATE || rvk == MIR_RVALUE_REPEAT {
                    inst.opcode = OPT_INST_AGGREGATE;
                    inst.sub_op = (unsafe { (*st).rvalue.variant_idx }) as u8;
                    if rvk == MIR_RVALUE_REPEAT {
                        inst.lhs = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view((*st).rvalue.use_op) }, b as u32, cur_iid_v, view(origin));
                    } else {
                        let oc = unsafe { (*st).rvalue.operand_count };
                        inst.extra_arg_count = oc;
                        if oc > 0 {
                            let earr = arena_alloc_raw(mut_view(*arena), opt_mul_usize(oc, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
                            let mut oi: usize = 0;
                            while oi < oc {
                                let op = unsafe { mir_op_at((*st).rvalue.operands, oi) };
                                let ov_v = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view(*op) }, b as u32, cur_iid_v, view(origin)).v;
                                unsafe { *opt_valid_at(earr, oi) = OptValueId { v: ov_v }; }
                                if oi == 0 { inst.lhs = OptValueId { v: ov_v }; }
                                if oi == 1 { inst.rhs = OptValueId { v: ov_v }; }
                                oi = oi + 1;
                            }
                            inst.extra_args = earr;
                        }
                    }
                }

                // Allocate result OptValueId for non-const assignment instructions
                if inst.result.v == OPT_VALUE_NONE {
                    let ity_v = inst.ty.v;
                    let zc = opt_zero_const(TypeId { v: ity_v });
                    inst.result = optir_alloc_value(
                        mut_view(*body),
                        mut_view(*arena),
                        TypeId { v: ity_v },
                        OPT_VAL_INST,
                        OptBbId { v: b as u32 },
                        OptInstId { v: cur_iid_v },
                        MirLocalId { v: unsafe { (*st).place.local.v } },
                        dst_fidx,
                        view(zc),
                        view(origin)
                    );
                }
            }
            opt_block_push_inst(unsafe { mut_view(*obb) }, mut_view(*arena), view(inst));
            s = s + 1;
        }

        // Lower block terminator
        let mterm_ref = unsafe { view((*mbb).terminator) };
        let torigin = opt_origin_make(view(mterm_ref.span), b as u32, sc as u32, OPT_PASS_LOWER_MIR);
        let term_iid_v = next_inst_id;
        next_inst_id = next_inst_id + 1u32;

        let mut oterm = OptTerminator {
            kind: OPT_TERM_UNREACHABLE,
            cond: OptValueId { v: OPT_VALUE_NONE },
            true_bb: OptBbId { v: OPT_BB_NONE },
            false_bb: OptBbId { v: OPT_BB_NONE },
            switch_ty: TypeId { v: 0u32 },
            switch_vals: 0 as *mut u64,
            switch_targets: 0 as *mut OptBbId,
            switch_count: 0,
            otherwise_bb: OptBbId { v: OPT_BB_NONE },
            callee: OptValueId { v: OPT_VALUE_NONE },
            call_args: 0 as *mut OptValueId,
            call_arg_count: 0,
            call_result: OptValueId { v: OPT_VALUE_NONE },
            call_dest: mir_local_place(0u32),
            has_call_dest: false,
            unwind_bb: OptBbId { v: OPT_BB_NONE },
            drop_place: mir_local_place(0u32),
            drop_flag: MIR_DROP_FLAG_NONE,
            drop_is_explicit: false,
            assert_expected: true,
            assert_msg_ptr: 0 as *const u8,
            assert_msg_len: 0,
            mem_use: MemSsaId { v: MEM_SSA_NONE },
            mem_def: MemSsaId { v: MEM_SSA_NONE },
            origin: opt_origin_make(view(mterm_ref.span), b as u32, sc as u32, OPT_PASS_LOWER_MIR),
            orig_term: MirTerminator {
                kind: MIR_TERM_UNREACHABLE,
                span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                goto_target: MirBbId { v: 0u32 },
                discr: MirOperand {
                    kind: MIR_OP_CONST,
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    constant: opt_zero_const(TypeId { v: 0u32 }),
                },
                switch_ty: TypeId { v: 0u32 },
                values: 0 as *mut u64,
                targets: 0 as *mut MirBbId,
                switch_count: 0,
                otherwise: MirBbId { v: 0u32 },
                drop_place: mir_local_place(0u32),
                drop_target: MirBbId { v: 0u32 },
                drop_unwind: MirBbId { v: 0u32 },
                drop_flag: MIR_DROP_FLAG_NONE,
                drop_is_explicit: false,
                func: MirOperand {
                    kind: MIR_OP_CONST,
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    constant: opt_zero_const(TypeId { v: 0u32 }),
                },
                args: 0 as *mut MirOperand,
                arg_count: 0,
                destination: mir_local_place(0u32),
                has_destination: false,
                call_target: MirBbId { v: 0u32 },
                call_unwind: MirBbId { v: 0u32 },
                cond: MirOperand {
                    kind: MIR_OP_CONST,
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    constant: opt_zero_const(TypeId { v: 0u32 }),
                },
                expected: true,
                msg_ptr: 0 as *const u8,
                msg_len: 0,
                assert_target: MirBbId { v: 0u32 },
                assert_unwind: MirBbId { v: 0u32 },
            },
        };
        mir_copy_terminator(mut_view(oterm.orig_term), mterm_ref);

        if unsafe { (*mbb).has_terminator } {
            let mtk = mterm_ref.kind;
            if mtk == MIR_TERM_GOTO {
                oterm.kind = OPT_TERM_GOTO;
                oterm.true_bb = OptBbId { v: mterm_ref.goto_target.v };
            } else if mtk == MIR_TERM_RETURN {
                oterm.kind = OPT_TERM_RETURN;
            } else if mtk == MIR_TERM_UNREACHABLE {
                oterm.kind = OPT_TERM_UNREACHABLE;
            } else if mtk == MIR_TERM_SWITCH_INT {
                oterm.cond = opt_operand_temp_val(mut_view(*body), mut_view(*arena), view(mterm_ref.discr), b as u32, term_iid_v, view(torigin));
                oterm.switch_ty = TypeId { v: mterm_ref.switch_ty.v };
                oterm.otherwise_bb = OptBbId { v: mterm_ref.otherwise.v };
                let swc = mterm_ref.switch_count;
                // Boolean 2-way switch [0: false_bb, otherwise: true_bb] lowers to OPT_TERM_BRANCH
                if swc == 1 && (mterm_ref.values as usize) != 0 && (mterm_ref.targets as usize) != 0 &&
                   (unsafe { *mir_u64_at(mterm_ref.values, 0) }) == 0u64 {
                    oterm.kind = OPT_TERM_BRANCH;
                    let f_bb = unsafe { (*mir_bb_id_at(mterm_ref.targets, 0)).v };
                    oterm.true_bb = OptBbId { v: mterm_ref.otherwise.v };
                    oterm.false_bb = OptBbId { v: f_bb };
                } else {
                    oterm.kind = OPT_TERM_SWITCH_INT;
                    oterm.switch_count = swc;
                    if swc > 0 {
                        let v_arr = arena_alloc_raw(mut_view(*arena), opt_mul_usize(swc, size_of<u64>()), align_of<u64>()) as *mut u64;
                        let t_arr = arena_alloc_raw(mut_view(*arena), opt_mul_usize(swc, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                        let mut k: usize = 0;
                        while k < swc {
                            let kv = unsafe { *mir_u64_at(mterm_ref.values, k) };
                            let kt = unsafe { (*mir_bb_id_at(mterm_ref.targets, k)).v };
                            unsafe {
                                *opt_u64_at(v_arr, k) = kv;
                                *opt_bbid_at(t_arr, k) = OptBbId { v: kt };
                            }
                            k = k + 1;
                        }
                        oterm.switch_vals = v_arr;
                        oterm.switch_targets = t_arr;
                    }
                }
            } else if mtk == MIR_TERM_CALL {
                oterm.kind = OPT_TERM_CALL;
                oterm.callee = opt_operand_temp_val(mut_view(*body), mut_view(*arena), view(mterm_ref.func), b as u32, term_iid_v, view(torigin));
                let ac = mterm_ref.arg_count;
                oterm.call_arg_count = ac;
                if ac > 0 {
                    let a_arr = arena_alloc_raw(mut_view(*arena), opt_mul_usize(ac, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
                    let mut ai: usize = 0;
                    while ai < ac {
                        let aop = unsafe { mir_op_at(mterm_ref.args, ai) };
                        let av = opt_operand_temp_val(mut_view(*body), mut_view(*arena), unsafe { view(*aop) }, b as u32, term_iid_v, view(torigin));
                        unsafe { *opt_valid_at(a_arr, ai) = av; }
                        ai = ai + 1;
                    }
                    oterm.call_args = a_arr;
                }
                oterm.has_call_dest = mterm_ref.has_destination;
                mir_copy_place(mut_view(oterm.call_dest), view(mterm_ref.destination));
                oterm.true_bb = OptBbId { v: mterm_ref.call_target.v };
                oterm.unwind_bb = OptBbId { v: mterm_ref.call_unwind.v };
                if mterm_ref.has_destination {
                    let dlv = mterm_ref.destination.local.v as usize;
                    let dty_v: u32 = if dlv < body.local_count {
                        (unsafe { *opt_typeid_at(body.local_tys, dlv) }).v
                    } else {
                        0u32
                    };
                    let dfidx = opt_place_single_field(view(mterm_ref.destination));
                    let zc = opt_zero_const(TypeId { v: dty_v });
                    oterm.call_result = optir_alloc_value(
                        mut_view(*body),
                        mut_view(*arena),
                        TypeId { v: dty_v },
                        OPT_VAL_INST,
                        OptBbId { v: b as u32 },
                        OptInstId { v: term_iid_v },
                        MirLocalId { v: mterm_ref.destination.local.v },
                        dfidx,
                        view(zc),
                        view(torigin)
                    );
                }
            } else if mtk == MIR_TERM_ASSERT {
                oterm.kind = OPT_TERM_ASSERT;
                oterm.cond = opt_operand_temp_val(mut_view(*body), mut_view(*arena), view(mterm_ref.cond), b as u32, term_iid_v, view(torigin));
                oterm.assert_expected = mterm_ref.expected;
                oterm.assert_msg_ptr = mterm_ref.msg_ptr;
                oterm.assert_msg_len = mterm_ref.msg_len;
                oterm.true_bb = OptBbId { v: mterm_ref.assert_target.v };
                oterm.unwind_bb = OptBbId { v: mterm_ref.assert_unwind.v };
            } else if mtk == MIR_TERM_DROP {
                oterm.kind = OPT_TERM_DROP;
                mir_copy_place(mut_view(oterm.drop_place), view(mterm_ref.drop_place));
                oterm.drop_flag = mterm_ref.drop_flag;
                oterm.drop_is_explicit = mterm_ref.drop_is_explicit;
                oterm.true_bb = OptBbId { v: mterm_ref.drop_target.v };
                oterm.unwind_bb = OptBbId { v: mterm_ref.drop_unwind.v };
            }
        }
        unsafe {
            (*obb).term = oterm;
            (*obb).has_term = true;
        }
        b = b + 1;
    }
    body.inst_count = next_inst_id as usize;
}

// --- Minimal SSA Construction: Liveness, IDF OptPhi Placement, and Renaming (AXS-OPT-012..014) ---

fn opt_val_slot(body: view<OptBody>, val_id: OptValueId) -> u32 {
    if val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count {
        return OPT_PROJ_NONE;
    }
    let vp = unsafe { opt_val_at(body.values, val_id.v as usize) };
    let k = unsafe { (*vp).kind };
    if k == OPT_VAL_CONST {
        return OPT_PROJ_NONE;
    }
    let lv = (unsafe { (*vp).src_local.v }) as usize;
    if lv >= body.local_count {
        return OPT_PROJ_NONE;
    }
    let mode = unsafe { *opt_u8_at(body.local_modes, lv) };
    let pf = unsafe { (*vp).proj_field };
    if mode == OPT_LOCAL_SCALAR && pf == OPT_PROJ_NONE {
        return lv as u32;
    }
    if mode == OPT_LOCAL_SROA && pf != OPT_PROJ_NONE {
        let scnt = unsafe { *opt_u32_at(body.local_sroa_count, lv) };
        if pf < scnt {
            let sbase = unsafe { *opt_u32_at(body.local_sroa_base, lv) };
            return sbase + pf;
        }
    }
    OPT_PROJ_NONE
}

fn opt_mark_use_slot(
    slot: u32,
    slot_count: usize,
    b: usize,
    use_before_def: *mut bool,
    def_in_block: *mut bool
) {
    if slot == OPT_PROJ_NONE || (slot as usize) >= slot_count {
        return;
    }
    let idx = opt_mul_usize(b, slot_count) + (slot as usize);
    if !(unsafe { *opt_bool_at(def_in_block, idx) }) {
        unsafe { *opt_bool_at(use_before_def, idx) = true; }
    }
}

fn opt_mark_def_slot(
    slot: u32,
    slot_count: usize,
    b: usize,
    def_in_block: *mut bool
) {
    if slot == OPT_PROJ_NONE || (slot as usize) >= slot_count {
        return;
    }
    let idx = opt_mul_usize(b, slot_count) + (slot as usize);
    unsafe { *opt_bool_at(def_in_block, idx) = true; }
}

fn opt_find_pred_index(bb: view<OptBlock>, pred_id: OptBbId) -> usize {
    let mut i: usize = 0;
    while i < bb.pred_count {
        if (unsafe { (*opt_bbid_at(bb.preds, i)).v }) == pred_id.v {
            return i;
        }
        i = i + 1;
    }
    bb.pred_count
}

fn opt_ensure_slot_val(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    cur_vals: *mut OptValueId,
    slot: usize
) -> OptValueId {
    let cur_v = unsafe { (*opt_valid_at(cur_vals, slot)).v };
    if cur_v != OPT_VALUE_NONE {
        return OptValueId { v: cur_v };
    }
    let sloc = unsafe { *opt_u32_at(body.slot_local, slot) };
    let sfld = unsafe { *opt_u32_at(body.slot_field, slot) };
    let sty_v = unsafe { (*opt_typeid_at(body.slot_ty, slot)).v };
    let zc = opt_zero_const(TypeId { v: sty_v });
    let orig = opt_origin_make(view(body.span), 0u32, 0u32, OPT_PASS_SSA_CONSTRUCT);
    let nv_v = optir_alloc_value(
        mut_view(*body),
        mut_view(*arena),
        TypeId { v: sty_v },
        OPT_VAL_CONST,
        OptBbId { v: 0u32 },
        OptInstId { v: OPT_INST_NONE },
        MirLocalId { v: sloc },
        sfld,
        view(zc),
        view(orig)
    ).v;
    unsafe { *opt_valid_at(cur_vals, slot) = OptValueId { v: nv_v }; }
    OptValueId { v: nv_v }
}

fn opt_rewrite_operand_val(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    cur_vals: *mut OptValueId,
    val_id: OptValueId
) -> OptValueId {
    let vv = val_id.v;
    if vv == OPT_VALUE_NONE {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    let slot = opt_val_slot(view(*body), OptValueId { v: vv });
    if slot != OPT_PROJ_NONE && (slot as usize) < body.slot_count {
        return opt_ensure_slot_val(mut_view(*body), mut_view(*arena), cur_vals, slot as usize);
    }
    OptValueId { v: vv }
}

fn opt_ssa_rename_dom_tree(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    b_idx: usize,
    cur_vals: *mut OptValueId
) {
    let scnt = body.slot_count;
    let alloc_s: usize = if scnt == 0 { 1 } else { scnt };
    let saved = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_s, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
    let mut s: usize = 0;
    while s < scnt {
        let vv = unsafe { (*opt_valid_at(cur_vals, s)).v };
        unsafe { *opt_valid_at(saved, s) = OptValueId { v: vv }; }
        s = s + 1;
    }

    let bb = unsafe { opt_block_at(body.blocks, b_idx) };
    let bb_v = b_idx as u32;

    // 1. Activate OptPhi results at block entry
    let pcnt = unsafe { (*bb).phi_count };
    let phis = unsafe { (*bb).phis };
    let mut p: usize = 0;
    while p < pcnt {
        let phi = unsafe { opt_phi_at(phis, p) };
        let pslot = (unsafe { (*phi).slot_idx }) as usize;
        let pres_v = unsafe { (*phi).result.v };
        if pslot < scnt {
            unsafe { *opt_valid_at(cur_vals, pslot) = OptValueId { v: pres_v }; }
        }
        p = p + 1;
    }

    // 2. Rename instructions in program order
    let icnt = unsafe { (*bb).inst_count };
    let insts = unsafe { (*bb).insts };
    let mut i: usize = 0;
    while i < icnt {
        let inst = unsafe { opt_inst_at(insts, i) };
        let opc = unsafe { (*inst).opcode };
        let flags = unsafe { (*inst).flags };

        // Rewrite uses
        let old_lhs_v = unsafe { (*inst).lhs.v };
        let old_rhs_v = unsafe { (*inst).rhs.v };
        let new_lhs = opt_rewrite_operand_val(mut_view(*body), mut_view(*arena), cur_vals, OptValueId { v: old_lhs_v });
        let new_rhs = opt_rewrite_operand_val(mut_view(*body), mut_view(*arena), cur_vals, OptValueId { v: old_rhs_v });
        unsafe {
            (*inst).lhs = new_lhs;
            (*inst).rhs = new_rhs;
        }
        let eac = unsafe { (*inst).extra_arg_count };
        let eargs = unsafe { (*inst).extra_args };
        let mut ei: usize = 0;
        while ei < eac {
            let old_ev_v = unsafe { (*opt_valid_at(eargs, ei)).v };
            let new_ev_v = opt_rewrite_operand_val(mut_view(*body), mut_view(*arena), cur_vals, OptValueId { v: old_ev_v }).v;
            unsafe { *opt_valid_at(eargs, ei) = OptValueId { v: new_ev_v }; }
            if ei == 0 { unsafe { (*inst).lhs = OptValueId { v: new_ev_v }; } }
            if ei == 1 { unsafe { (*inst).rhs = OptValueId { v: new_ev_v }; } }
            ei = ei + 1;
        }

        // Update definitions
        if opc != OPT_INST_NOP && opc != OPT_INST_DROP_FLAG {
            let dst_lv = (unsafe { (*inst).place.local.v }) as usize;
            let dst_mode: u8 = if dst_lv < body.local_count {
                unsafe { *opt_u8_at(body.local_modes, dst_lv) }
            } else {
                OPT_LOCAL_MEMORY
            };
            let dst_slot = opt_place_to_slot(view(*body), unsafe { view((*inst).place) });

            if opc == OPT_INST_AGGREGATE && dst_mode == OPT_LOCAL_SROA && (unsafe { (*inst).place.proj_count }) == 0 {
                // Aggregate initialization of SROA local defines each field slot directly (AXS-OPT-014)
                let sbase = (unsafe { *opt_u32_at(body.local_sroa_base, dst_lv) }) as usize;
                let sf_cnt = (unsafe { *opt_u32_at(body.local_sroa_count, dst_lv) }) as usize;
                let mut f: usize = 0;
                while f < sf_cnt {
                    if f < eac && (eargs as usize) != 0 {
                        let fv_v = unsafe { (*opt_valid_at(eargs, f)).v };
                        unsafe { *opt_valid_at(cur_vals, sbase + f) = OptValueId { v: fv_v }; }
                    } else if eac == 0 && (unsafe { (*inst).lhs.v }) != OPT_VALUE_NONE {
                        let lv_v = unsafe { (*inst).lhs.v };
                        unsafe { *opt_valid_at(cur_vals, sbase + f) = OptValueId { v: lv_v }; }
                    }
                    f = f + 1;
                }
            } else if dst_slot != OPT_PROJ_NONE && (dst_slot as usize) < scnt {
                // Copy/Move value sharing on promoted SSA slots (REQ-OPT-337, REQ-OPT-338)
                if (opc == OPT_INST_COPY || opc == OPT_INST_CONST) &&
                   (flags & OPT_FLAG_BARRIER) == 0u16 &&
                   (unsafe { (*inst).lhs.v }) != OPT_VALUE_NONE {
                    let shared_v = unsafe { (*inst).lhs.v };
                    unsafe {
                        (*inst).result = OptValueId { v: shared_v };
                        *opt_valid_at(cur_vals, dst_slot as usize) = OptValueId { v: shared_v };
                    }
                } else {
                    let res_v = unsafe { (*inst).result.v };
                    if res_v != OPT_VALUE_NONE {
                        unsafe { *opt_valid_at(cur_vals, dst_slot as usize) = OptValueId { v: res_v }; }
                    }
                }
            }
        }
        i = i + 1;
    }

    // 3. Rename terminator operands and call destination
    let tk = unsafe { (*bb).term.kind };
    if tk == OPT_TERM_BRANCH || tk == OPT_TERM_SWITCH_INT || tk == OPT_TERM_ASSERT {
        let old_cond_v = unsafe { (*bb).term.cond.v };
        let nc = opt_rewrite_operand_val(mut_view(*body), mut_view(*arena), cur_vals, OptValueId { v: old_cond_v });
        unsafe { (*bb).term.cond = nc; }
    } else if tk == OPT_TERM_CALL {
        let old_cal_v = unsafe { (*bb).term.callee.v };
        let ncal = opt_rewrite_operand_val(mut_view(*body), mut_view(*arena), cur_vals, OptValueId { v: old_cal_v });
        unsafe { (*bb).term.callee = ncal; }
        let cac = unsafe { (*bb).term.call_arg_count };
        let cargs = unsafe { (*bb).term.call_args };
        let mut ci: usize = 0;
        while ci < cac {
            let ocv_v = unsafe { (*opt_valid_at(cargs, ci)).v };
            let ncv = opt_rewrite_operand_val(mut_view(*body), mut_view(*arena), cur_vals, OptValueId { v: ocv_v });
            unsafe { *opt_valid_at(cargs, ci) = ncv; }
            ci = ci + 1;
        }
        if unsafe { (*bb).term.has_call_dest } {
            let cslot = opt_place_to_slot(view(*body), unsafe { view((*bb).term.call_dest) });
            if cslot != OPT_PROJ_NONE && (cslot as usize) < scnt {
                let cres_v = unsafe { (*bb).term.call_result.v };
                if cres_v != OPT_VALUE_NONE {
                    unsafe { *opt_valid_at(cur_vals, cslot as usize) = OptValueId { v: cres_v }; }
                }
            }
        }
    }

    // 4. Populate incoming OptPhi operands in CFG successors
    let succ_cnt = unsafe { (*bb).succ_count };
    let succs = unsafe { (*bb).succs };
    let mut si: usize = 0;
    while si < succ_cnt {
        let sid = (unsafe { (*opt_bbid_at(succs, si)).v }) as usize;
        if sid < body.bb_count {
            let sbb = unsafe { opt_block_at(body.blocks, sid) };
            let pidx = opt_find_pred_index(unsafe { view(*sbb) }, OptBbId { v: bb_v });
            if pidx < (unsafe { (*sbb).pred_count }) {
                let sp_cnt = unsafe { (*sbb).phi_count };
                let sphis = unsafe { (*sbb).phis };
                let mut sp: usize = 0;
                while sp < sp_cnt {
                    let sphi = unsafe { opt_phi_at(sphis, sp) };
                    let s_slot = (unsafe { (*sphi).slot_idx }) as usize;
                    let inc_v = opt_ensure_slot_val(mut_view(*body), mut_view(*arena), cur_vals, s_slot);
                    unsafe {
                        *opt_bbid_at((*sphi).incoming_blocks, pidx) = OptBbId { v: bb_v };
                        *opt_valid_at((*sphi).incoming_values, pidx) = inc_v;
                    }
                    sp = sp + 1;
                }
            }
        }
        si = si + 1;
    }

    // 5. Recurse on dominator-tree children in ascending OptBbId order
    let mut c: usize = 0;
    while c < body.bb_count {
        if c != b_idx {
            let cbb = unsafe { opt_block_at(body.blocks, c) };
            if (unsafe { (*cbb).is_reachable }) && (unsafe { (*cbb).idom.v }) == bb_v {
                opt_ssa_rename_dom_tree(mut_view(*body), mut_view(*arena), c, cur_vals);
            }
        }
        c = c + 1;
    }

    // 6. Restore reaching values snapshot
    s = 0;
    while s < scnt {
        let sv_v = unsafe { (*opt_valid_at(saved, s)).v };
        unsafe { *opt_valid_at(cur_vals, s) = OptValueId { v: sv_v }; }
        s = s + 1;
    }
}

pub fn optir_construct_ssa(body: mut_view<OptBody>, arena: mut_view<Arena>) {
    let n = body.bb_count;
    let scnt = body.slot_count;
    if n == 0 || scnt == 0 {
        return;
    }

    // 1. Compute use_before_def and def_in_block per (block, slot)
    let mat_len = opt_mul_usize(n, scnt);
    let alloc_mat: usize = if mat_len == 0 { 1 } else { mat_len };
    let use_before_def = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_mat, size_of<bool>()), align_of<bool>()) as *mut bool;
    let def_in_block = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_mat, size_of<bool>()), align_of<bool>()) as *mut bool;
    let live_in = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_mat, size_of<bool>()), align_of<bool>()) as *mut bool;

    let mut m: usize = 0;
    while m < mat_len {
        unsafe {
            *opt_bool_at(use_before_def, m) = false;
            *opt_bool_at(def_in_block, m) = false;
            *opt_bool_at(live_in, m) = false;
        }
        m = m + 1;
    }

    // Parameters _1.._arg_count (and any SROA fields of parameters) are defined at entry of bb0
    let mut s_init: usize = 0;
    while s_init < scnt {
        let sloc = (unsafe { *opt_u32_at(body.slot_local, s_init) }) as usize;
        if sloc >= 1 && sloc <= body.arg_count {
            opt_mark_def_slot(s_init as u32, scnt, 0, def_in_block);
        }
        s_init = s_init + 1;
    }

    let mut b: usize = 0;
    while b < n {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let lhs_v = unsafe { (*inst).lhs.v };
                let rhs_v = unsafe { (*inst).rhs.v };
                opt_mark_use_slot(opt_val_slot(view(*body), OptValueId { v: lhs_v }), scnt, b, use_before_def, def_in_block);
                opt_mark_use_slot(opt_val_slot(view(*body), OptValueId { v: rhs_v }), scnt, b, use_before_def, def_in_block);
                let eac = unsafe { (*inst).extra_arg_count };
                let eargs = unsafe { (*inst).extra_args };
                let mut ei: usize = 0;
                while ei < eac {
                    let ev_v = unsafe { (*opt_valid_at(eargs, ei)).v };
                    opt_mark_use_slot(opt_val_slot(view(*body), OptValueId { v: ev_v }), scnt, b, use_before_def, def_in_block);
                    ei = ei + 1;
                }
                if opc != OPT_INST_NOP && opc != OPT_INST_DROP_FLAG {
                    let dlv = (unsafe { (*inst).place.local.v }) as usize;
                    let dmode: u8 = if dlv < body.local_count {
                        unsafe { *opt_u8_at(body.local_modes, dlv) }
                    } else {
                        OPT_LOCAL_MEMORY
                    };
                    if opc == OPT_INST_AGGREGATE && dmode == OPT_LOCAL_SROA && (unsafe { (*inst).place.proj_count }) == 0 {
                        let sbase = unsafe { *opt_u32_at(body.local_sroa_base, dlv) };
                        let sfc = unsafe { *opt_u32_at(body.local_sroa_count, dlv) };
                        let mut f: u32 = 0u32;
                        while f < sfc {
                            opt_mark_def_slot(sbase + f, scnt, b, def_in_block);
                            f = f + 1u32;
                        }
                    } else {
                        let dslot = opt_place_to_slot(view(*body), unsafe { view((*inst).place) });
                        opt_mark_def_slot(dslot, scnt, b, def_in_block);
                    }
                }
                i = i + 1;
            }
            let tk = unsafe { (*bb).term.kind };
            if tk == OPT_TERM_BRANCH || tk == OPT_TERM_SWITCH_INT || tk == OPT_TERM_ASSERT {
                let cond_v = unsafe { (*bb).term.cond.v };
                opt_mark_use_slot(opt_val_slot(view(*body), OptValueId { v: cond_v }), scnt, b, use_before_def, def_in_block);
            } else if tk == OPT_TERM_CALL {
                let cal_v = unsafe { (*bb).term.callee.v };
                opt_mark_use_slot(opt_val_slot(view(*body), OptValueId { v: cal_v }), scnt, b, use_before_def, def_in_block);
                let cac = unsafe { (*bb).term.call_arg_count };
                let cargs = unsafe { (*bb).term.call_args };
                let mut ci: usize = 0;
                while ci < cac {
                    let cv_v = unsafe { (*opt_valid_at(cargs, ci)).v };
                    opt_mark_use_slot(opt_val_slot(view(*body), OptValueId { v: cv_v }), scnt, b, use_before_def, def_in_block);
                    ci = ci + 1;
                }
                if unsafe { (*bb).term.has_call_dest } {
                    let cslot = opt_place_to_slot(view(*body), unsafe { view((*bb).term.call_dest) });
                    opt_mark_def_slot(cslot, scnt, b, def_in_block);
                }
            }
        }
        b = b + 1;
    }

    // 2. Backward liveness fixed-point over reachable blocks
    let mut live_changed = true;
    while live_changed {
        live_changed = false;
        let mut r: usize = body.rpo_count;
        while r > 0 {
            r = r - 1;
            let bid = (unsafe { (*opt_bbid_at(body.rpo_order, r)).v }) as usize;
            let bb = unsafe { opt_block_at(body.blocks, bid) };
            let succ_cnt = unsafe { (*bb).succ_count };
            let succs = unsafe { (*bb).succs };
            let mut s: usize = 0;
            while s < scnt {
                let idx = opt_mul_usize(bid, scnt) + s;
                let mut is_live = unsafe { *opt_bool_at(use_before_def, idx) };
                if !is_live && !(unsafe { *opt_bool_at(def_in_block, idx) }) {
                    let mut si: usize = 0;
                    while si < succ_cnt {
                        let sid = (unsafe { (*opt_bbid_at(succs, si)).v }) as usize;
                        if sid < n && (unsafe { *opt_bool_at(live_in, opt_mul_usize(sid, scnt) + s) }) {
                            is_live = true;
                            break;
                        }
                        si = si + 1;
                    }
                }
                if is_live && !(unsafe { *opt_bool_at(live_in, idx) }) {
                    unsafe { *opt_bool_at(live_in, idx) = true; }
                    live_changed = true;
                }
                s = s + 1;
            }
        }
    }

    // 3. Pruned Iterated Dominance Frontier (IDF) OptPhi placement per slot
    let has_phi = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let in_work = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let worklist = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;

    let mut slot: usize = 0;
    while slot < scnt {
        let sloc = unsafe { *opt_u32_at(body.slot_local, slot) };
        let sfld = unsafe { *opt_u32_at(body.slot_field, slot) };
        let sty_v = unsafe { (*opt_typeid_at(body.slot_ty, slot)).v };
        let mode = unsafe { *opt_u8_at(body.local_modes, sloc as usize) };
        let slot_active = (mode == OPT_LOCAL_SCALAR && sfld == OPT_PROJ_NONE) ||
                          (mode == OPT_LOCAL_SROA && sfld != OPT_PROJ_NONE);
        if slot_active {
            let mut w_len: usize = 0;
            b = 0;
            while b < n {
                unsafe {
                    *opt_bool_at(has_phi, b) = false;
                    *opt_bool_at(in_work, b) = false;
                }
                if unsafe { *opt_bool_at(def_in_block, opt_mul_usize(b, scnt) + slot) } {
                    unsafe {
                        *opt_bool_at(in_work, b) = true;
                        *opt_bbid_at(worklist, w_len) = OptBbId { v: b as u32 };
                    }
                    w_len = w_len + 1;
                }
                b = b + 1;
            }

            let mut w_idx: usize = 0;
            while w_idx < w_len {
                let x_v = unsafe { (*opt_bbid_at(worklist, w_idx)).v };
                w_idx = w_idx + 1;
                let xbb = unsafe { opt_block_at(body.blocks, x_v as usize) };
                let df_cnt = unsafe { (*xbb).dom_frontier_count };
                let df_arr = unsafe { (*xbb).dom_frontier };
                let mut di: usize = 0;
                while di < df_cnt {
                    let y_v = unsafe { (*opt_bbid_at(df_arr, di)).v };
                    let y = y_v as usize;
                    if y < n && !(unsafe { *opt_bool_at(has_phi, y) }) {
                        if unsafe { *opt_bool_at(live_in, opt_mul_usize(y, scnt) + slot) } {
                            unsafe { *opt_bool_at(has_phi, y) = true; }
                            if !(unsafe { *opt_bool_at(in_work, y) }) {
                                unsafe {
                                    *opt_bool_at(in_work, y) = true;
                                    *opt_bbid_at(worklist, w_len) = OptBbId { v: y_v };
                                }
                                w_len = w_len + 1;
                            }
                        }
                    }
                    di = di + 1;
                }
            }

            // Insert OptPhi in ascending block order
            b = 0;
            while b < n {
                if unsafe { *opt_bool_at(has_phi, b) } {
                    let ybb = unsafe { opt_block_at(body.blocks, b) };
                    let arity = unsafe { (*ybb).pred_count };
                    if arity >= 2 {
                        let orig = opt_origin_make(view(body.span), b as u32, 0u32, OPT_PASS_SSA_CONSTRUCT);
                        let zc = opt_zero_const(TypeId { v: sty_v });
                        let phi_val = optir_alloc_value(
                            mut_view(*body),
                            mut_view(*arena),
                            TypeId { v: sty_v },
                            OPT_VAL_PHI,
                            OptBbId { v: b as u32 },
                            OptInstId { v: OPT_INST_NONE },
                            MirLocalId { v: sloc },
                            sfld,
                            view(zc),
                            view(orig)
                        );
                        let inc_vals = arena_alloc_raw(mut_view(*arena), opt_mul_usize(arity, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
                        let inc_blks = arena_alloc_raw(mut_view(*arena), opt_mul_usize(arity, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                        let mut pi: usize = 0;
                        while pi < arity {
                            let pred_v = unsafe { (*opt_bbid_at((*ybb).preds, pi)).v };
                            unsafe {
                                *opt_bbid_at(inc_blks, pi) = OptBbId { v: pred_v };
                                *opt_valid_at(inc_vals, pi) = OptValueId { v: OPT_VALUE_NONE };
                            }
                            pi = pi + 1;
                        }
                        let phi = OptPhi {
                            result: phi_val,
                            ty: TypeId { v: sty_v },
                            src_local: MirLocalId { v: sloc },
                            proj_field: sfld,
                            slot_idx: slot as u32,
                            incoming_values: inc_vals,
                            incoming_blocks: inc_blks,
                            arity: arity,
                            origin: orig,
                        };
                        opt_block_push_phi(unsafe { mut_view(*ybb) }, mut_view(*arena), view(phi));
                    }
                }
                b = b + 1;
            }
        }
        slot = slot + 1;
    }

    // 4. Initialize entry reaching values (parameters _1.._arg_count) and run dominator-tree renaming
    let cur_vals = arena_alloc_raw(mut_view(*arena), opt_mul_usize(scnt, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
    slot = 0;
    while slot < scnt {
        let sloc = (unsafe { *opt_u32_at(body.slot_local, slot) }) as usize;
        let sfld = unsafe { *opt_u32_at(body.slot_field, slot) };
        let sty_v = unsafe { (*opt_typeid_at(body.slot_ty, slot)).v };
        if sloc >= 1 && sloc <= body.arg_count {
            let orig = opt_origin_make(view(body.span), 0u32, 0u32, OPT_PASS_SSA_CONSTRUCT);
            let zc = opt_zero_const(TypeId { v: sty_v });
            let pval = optir_alloc_value(
                mut_view(*body),
                mut_view(*arena),
                TypeId { v: sty_v },
                OPT_VAL_PARAM,
                OptBbId { v: 0u32 },
                OptInstId { v: OPT_INST_NONE },
                MirLocalId { v: sloc as u32 },
                sfld,
                view(zc),
                view(orig)
            );
            unsafe { *opt_valid_at(cur_vals, slot) = pval; }
        } else {
            unsafe { *opt_valid_at(cur_vals, slot) = OptValueId { v: OPT_VALUE_NONE }; }
        }
        slot = slot + 1;
    }

    opt_ssa_rename_dom_tree(mut_view(*body), mut_view(*arena), 0, cur_vals);
    optir_simplify_trivial_phis(mut_view(*body));
}

// --- Trivial Phi Simplification (AXS-OPT-012) ---

fn opt_replace_value_in_body(body: mut_view<OptBody>, from_val: OptValueId, to_val: OptValueId) {
    let from_v = from_val.v;
    let to_v = to_val.v;
    if from_v == OPT_VALUE_NONE || to_v == OPT_VALUE_NONE || from_v == to_v {
        return;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let pcnt = unsafe { (*bb).phi_count };
        let phis = unsafe { (*bb).phis };
        let mut p: usize = 0;
        while p < pcnt {
            let phi = unsafe { opt_phi_at(phis, p) };
            let arity = unsafe { (*phi).arity };
            let incs = unsafe { (*phi).incoming_values };
            let mut k: usize = 0;
            while k < arity {
                if (unsafe { (*opt_valid_at(incs, k)).v }) == from_v {
                    unsafe { *opt_valid_at(incs, k) = OptValueId { v: to_v }; }
                }
                k = k + 1;
            }
            p = p + 1;
        }
        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            if (unsafe { (*inst).lhs.v }) == from_v { unsafe { (*inst).lhs = OptValueId { v: to_v }; } }
            if (unsafe { (*inst).rhs.v }) == from_v { unsafe { (*inst).rhs = OptValueId { v: to_v }; } }
            if (unsafe { (*inst).result.v }) == from_v { unsafe { (*inst).result = OptValueId { v: to_v }; } }
            let eac = unsafe { (*inst).extra_arg_count };
            let eargs = unsafe { (*inst).extra_args };
            let mut ei: usize = 0;
            while ei < eac {
                if (unsafe { (*opt_valid_at(eargs, ei)).v }) == from_v {
                    unsafe { *opt_valid_at(eargs, ei) = OptValueId { v: to_v }; }
                }
                ei = ei + 1;
            }
            i = i + 1;
        }
        if (unsafe { (*bb).term.cond.v }) == from_v { unsafe { (*bb).term.cond = OptValueId { v: to_v }; } }
        if (unsafe { (*bb).term.callee.v }) == from_v { unsafe { (*bb).term.callee = OptValueId { v: to_v }; } }
        let cac = unsafe { (*bb).term.call_arg_count };
        let cargs = unsafe { (*bb).term.call_args };
        let mut ci: usize = 0;
        while ci < cac {
            if (unsafe { (*opt_valid_at(cargs, ci)).v }) == from_v {
                unsafe { *opt_valid_at(cargs, ci) = OptValueId { v: to_v }; }
            }
            ci = ci + 1;
        }
        b = b + 1;
    }
}

pub fn optir_simplify_trivial_phis(body: mut_view<OptBody>) {
    let mut changed = true;
    while changed {
        changed = false;
        let mut b: usize = 0;
        while b < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, b) };
            let mut write_p: usize = 0;
            let pcnt = unsafe { (*bb).phi_count };
            let phis = unsafe { (*bb).phis };
            let mut p: usize = 0;
            while p < pcnt {
                let phi = unsafe { opt_phi_at(phis, p) };
                let pres_v = unsafe { (*phi).result.v };
                let arity = unsafe { (*phi).arity };
                let incs = unsafe { (*phi).incoming_values };
                let mut same_val_v: u32 = OPT_VALUE_NONE;
                let mut is_trivial = true;
                let mut k: usize = 0;
                while k < arity {
                    let iv_v = unsafe { (*opt_valid_at(incs, k)).v };
                    if iv_v != pres_v && iv_v != OPT_VALUE_NONE {
                        if same_val_v == OPT_VALUE_NONE {
                            same_val_v = iv_v;
                        } else if same_val_v != iv_v {
                            is_trivial = false;
                            break;
                        }
                    }
                    k = k + 1;
                }
                if is_trivial && same_val_v != OPT_VALUE_NONE {
                    opt_replace_value_in_body(mut_view(*body), OptValueId { v: pres_v }, OptValueId { v: same_val_v });
                    changed = true;
                } else {
                    if write_p != p {
                        let dst = unsafe { opt_phi_at(phis, write_p) };
                        unsafe {
                            ptr_copy_nonoverlapping<u8>(phi as *const u8, dst as *mut u8, size_of<OptPhi>());
                        }
                    }
                    write_p = write_p + 1;
                }
                p = p + 1;
            }
            unsafe { (*bb).phi_count = write_p; }
            b = b + 1;
        }
    }
}

// --- MemoryRegion, Alias Analysis, Effect Summary & MemorySSA Construction (AXS-OPT-020..024) ---

pub fn optir_extract_memory_region(body: view<OptBody>, place: view<MirPlace>) -> MemoryRegion {
    let lv = place.local.v as usize;
    let mut domain = STORAGE_STACK_LOCAL;
    let mut const_off: i64 = 0i64;
    let byte_sz: u64 = 1u64;
    let mut known_bounds = true;

    if place.proj_count > 0 && (place.projs as usize) != 0 {
        let pr0 = unsafe { mir_proj_at(place.projs, 0) };
        let k0 = unsafe { (*pr0).kind };
        if k0 == MIR_PROJ_DEREF {
            if place.view_kind == MIR_VIEW_READ || place.view_kind == MIR_VIEW_MUT {
                domain = STORAGE_VIEW_BORROW;
            } else if lv < body.local_count {
                let lty_v = unsafe { (*opt_typeid_at(body.local_tys, lv)).v };
                let tk = opt_type_kind(body.thir, TypeId { v: lty_v });
                if tk == TY_VIEW || tk == TY_MUT_VIEW {
                    domain = STORAGE_VIEW_BORROW;
                } else if tk == TY_PTR {
                    domain = STORAGE_RAW_PTR;
                } else {
                    domain = STORAGE_UNKNOWN;
                }
            } else {
                domain = STORAGE_UNKNOWN;
            }
            known_bounds = false;
        }
        let mut pi: usize = 0;
        while pi < place.proj_count {
            let pr = unsafe { mir_proj_at(place.projs, pi) };
            let pk = unsafe { (*pr).kind };
            if pk == MIR_PROJ_FIELD {
                const_off = const_off + ((unsafe { (*pr).field_idx }) as i64);
            } else if pk == MIR_PROJ_INDEX || pk == MIR_PROJ_SUB_SLICE {
                known_bounds = false;
            }
            pi = pi + 1;
        }
    } else if lv >= body.local_count {
        domain = STORAGE_UNKNOWN;
        known_bounds = false;
    }

    let mut reg_place = mir_local_place(place.local.v);
    mir_copy_place(mut_view(reg_place), place);

    MemoryRegion {
        domain: domain,
        base_local: MirLocalId { v: place.local.v },
        base_value: OptValueId { v: OPT_VALUE_NONE },
        const_offset: const_off,
        byte_size: byte_sz,
        has_known_bounds: known_bounds,
        place: reg_place,
    }
}

pub fn optir_alias_query(body: view<OptBody>, reg_a: view<MemoryRegion>, reg_b: view<MemoryRegion>) -> u8 {
    // 1. Both stack locals
    if reg_a.domain == STORAGE_STACK_LOCAL && reg_b.domain == STORAGE_STACK_LOCAL {
        if reg_a.base_local.v != reg_b.base_local.v {
            return ALIAS_NO_ALIAS;
        }
        let rel = mir_region_relate(view(reg_a.place), view(reg_b.place));
        if rel == MIR_REGION_DISJOINT {
            return ALIAS_NO_ALIAS;
        }
        if rel == MIR_REGION_SAME {
            return ALIAS_MUST_ALIAS;
        }
        if rel == MIR_REGION_CONTAINS || rel == MIR_REGION_OVERLAPS {
            return ALIAS_PARTIAL_ALIAS;
        }
        return ALIAS_MAY_ALIAS;
    }

    // 2. Non-address-taken stack local vs non-stack domain (view, raw ptr, heap, global)
    if reg_a.domain == STORAGE_STACK_LOCAL && (reg_a.base_local.v as usize) < body.local_count {
        let addr_a = unsafe { *opt_bool_at(body.local_addr_taken, reg_a.base_local.v as usize) };
        if !addr_a && reg_b.domain != STORAGE_STACK_LOCAL && reg_b.domain != STORAGE_UNKNOWN {
            return ALIAS_NO_ALIAS;
        }
    }
    if reg_b.domain == STORAGE_STACK_LOCAL && (reg_b.base_local.v as usize) < body.local_count {
        let addr_b = unsafe { *opt_bool_at(body.local_addr_taken, reg_b.base_local.v as usize) };
        if !addr_b && reg_a.domain != STORAGE_STACK_LOCAL && reg_a.domain != STORAGE_UNKNOWN {
            return ALIAS_NO_ALIAS;
        }
    }

    // 3. Verified capability views (view<T> / mut_view<T>)
    if reg_a.domain == STORAGE_VIEW_BORROW && reg_b.domain == STORAGE_VIEW_BORROW {
        let rel = mir_region_relate(view(reg_a.place), view(reg_b.place));
        if rel == MIR_REGION_SAME {
            return ALIAS_MUST_ALIAS;
        }
        if rel == MIR_REGION_DISJOINT {
            // In Verified MIR, a mut_view<T> cannot alias any other distinct active view/mut_view local
            if reg_a.place.view_kind == MIR_VIEW_MUT || reg_b.place.view_kind == MIR_VIEW_MUT {
                return ALIAS_NO_ALIAS;
            }
            let la = reg_a.base_local.v as usize;
            let lb = reg_b.base_local.v as usize;
            if la < body.local_count && lb < body.local_count {
                let ta_v = unsafe { (*opt_typeid_at(body.local_tys, la)).v };
                let tb_v = unsafe { (*opt_typeid_at(body.local_tys, lb)).v };
                let ka = opt_type_kind(body.thir, TypeId { v: ta_v });
                let kb = opt_type_kind(body.thir, TypeId { v: tb_v });
                if ka == TY_MUT_VIEW || kb == TY_MUT_VIEW {
                    return ALIAS_NO_ALIAS;
                }
            }
            if reg_a.base_local.v == reg_b.base_local.v && reg_a.const_offset != reg_b.const_offset {
                return ALIAS_NO_ALIAS;
            }
        }
        return ALIAS_MAY_ALIAS;
    }

    // 4. Raw pointers with same base local and distinct field projections
    if reg_a.domain == STORAGE_RAW_PTR && reg_b.domain == STORAGE_RAW_PTR {
        if reg_a.base_local.v == reg_b.base_local.v {
            let rel = mir_region_relate(view(reg_a.place), view(reg_b.place));
            if rel == MIR_REGION_SAME {
                return ALIAS_MUST_ALIAS;
            }
            if rel == MIR_REGION_DISJOINT {
                return ALIAS_NO_ALIAS;
            }
        }
    }

    ALIAS_UNKNOWN
}

pub fn optir_inst_effects(inst: view<OptInst>) -> u16 {
    let opc = inst.opcode;
    let mut eff = EFFECT_PURE;
    if (inst.flags & OPT_FLAG_MAY_TRAP) != 0u16 || opc == OPT_INST_CHECKED_BINOP {
        eff = eff | EFFECT_MAY_PANIC;
    }
    if opc == OPT_INST_LOAD || opc == OPT_INST_LEN || opc == OPT_INST_DISCRIMINANT || opc == OPT_INST_EXTRACT_FIELD {
        eff = eff | EFFECT_READS_MEM;
    } else if opc == OPT_INST_STORE || opc == OPT_INST_INSERT_FIELD {
        eff = eff | EFFECT_WRITES_MEM;
    } else if opc == OPT_INST_VOLATILE_LOAD {
        eff = eff | EFFECT_READS_MEM | EFFECT_VOLATILE;
    } else if opc == OPT_INST_VOLATILE_STORE {
        eff = eff | EFFECT_WRITES_MEM | EFFECT_VOLATILE;
    } else if opc == OPT_INST_ATOMIC {
        eff = eff | EFFECT_READS_MEM | EFFECT_WRITES_MEM | EFFECT_ATOMIC;
    } else if opc == OPT_INST_BLACK_BOX {
        eff = eff | EFFECT_READS_MEM | EFFECT_WRITES_MEM | EFFECT_VOLATILE;
    } else if opc == OPT_INST_ZEROIZE {
        eff = eff | EFFECT_WRITES_MEM | EFFECT_VOLATILE;
    } else if opc == OPT_INST_DROP_FLAG {
        eff = eff | EFFECT_READS_MEM | EFFECT_WRITES_MEM;
    }
    eff
}

pub fn optir_term_effects(body: view<OptBody>, term: view<OptTerminator>) -> u16 {
    let _ = body;
    let tk = term.kind;
    if tk == OPT_TERM_GOTO || tk == OPT_TERM_BRANCH || tk == OPT_TERM_SWITCH_INT || tk == OPT_TERM_RETURN {
        return EFFECT_PURE;
    }
    if tk == OPT_TERM_ASSERT || tk == OPT_TERM_UNREACHABLE {
        return EFFECT_MAY_PANIC;
    }
    if tk == OPT_TERM_DROP {
        return EFFECT_READS_MEM | EFFECT_WRITES_MEM | EFFECT_MAY_PANIC;
    }
    if tk == OPT_TERM_CALL {
        // Conservative default for calls (REQ-OPT-398)
        return EFFECT_READS_MEM | EFFECT_WRITES_MEM | EFFECT_MAY_PANIC | EFFECT_UNKNOWN;
    }
    EFFECT_UNKNOWN
}

fn opt_inst_reads_mem(body: view<OptBody>, inst: view<OptInst>) -> bool {
    let opc = inst.opcode;
    if opc == OPT_INST_LOAD || opc == OPT_INST_LEN || opc == OPT_INST_DISCRIMINANT ||
       opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_ATOMIC || opc == OPT_INST_BLACK_BOX ||
       opc == OPT_INST_DROP_FLAG {
        return true;
    }
    if opc == OPT_INST_EXTRACT_FIELD {
        let slot = opt_place_to_slot(body, view(inst.rhs_place));
        return slot == OPT_PROJ_NONE;
    }
    false
}

fn opt_inst_writes_mem(body: view<OptBody>, inst: view<OptInst>) -> bool {
    let opc = inst.opcode;
    if opc == OPT_INST_STORE || opc == OPT_INST_VOLATILE_STORE || opc == OPT_INST_VOLATILE_LOAD ||
       opc == OPT_INST_ATOMIC || opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE ||
       opc == OPT_INST_DROP_FLAG {
        return true;
    }
    if opc == OPT_INST_INSERT_FIELD {
        let slot = opt_place_to_slot(body, view(inst.place));
        return slot == OPT_PROJ_NONE;
    }
    if opc == OPT_INST_AGGREGATE {
        let lv = inst.place.local.v as usize;
        if lv < body.local_count {
            let mode = unsafe { *opt_u8_at(body.local_modes, lv) };
            return mode == OPT_LOCAL_MEMORY;
        }
    }
    false
}

fn opt_memssa_rename_dom_tree(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    b_idx: usize,
    incoming_mem: MemSsaId
) {
    let bb = unsafe { opt_block_at(body.blocks, b_idx) };
    let bb_v = b_idx as u32;
    let mut cur_mem_v = incoming_mem.v;

    if unsafe { (*bb).has_mem_phi } {
        cur_mem_v = unsafe { (*bb).mem_phi_result.v };
    }
    unsafe { (*bb).mem_in = MemSsaId { v: cur_mem_v }; }

    let icnt = unsafe { (*bb).inst_count };
    let insts = unsafe { (*bb).insts };
    let mut i: usize = 0;
    while i < icnt {
        let inst = unsafe { opt_inst_at(insts, i) };
        let reads = opt_inst_reads_mem(view(*body), unsafe { view(*inst) });
        let writes = opt_inst_writes_mem(view(*body), unsafe { view(*inst) });
        if reads {
            unsafe { (*inst).mem_use = MemSsaId { v: cur_mem_v }; }
        }
        if writes {
            let reg = optir_extract_memory_region(view(*body), unsafe { view((*inst).place) });
            let eff = optir_inst_effects(unsafe { view(*inst) });
            let opc = unsafe { (*inst).opcode };
            let is_bar = ((unsafe { (*inst).flags }) & OPT_FLAG_BARRIER) != 0u16 ||
                         opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_VOLATILE_STORE ||
                         opc == OPT_INST_ATOMIC || opc == OPT_INST_BLACK_BOX ||
                         opc == OPT_INST_ZEROIZE || opc == OPT_INST_DROP_FLAG;
            let new_mem_v = optir_alloc_mem_def(
                mut_view(*body),
                mut_view(*arena),
                MEM_DEF_INST,
                OptBbId { v: bb_v },
                i as u32,
                MemSsaId { v: cur_mem_v },
                view(reg),
                eff,
                is_bar
            ).v;
            unsafe { (*inst).mem_def = MemSsaId { v: new_mem_v }; }
            cur_mem_v = new_mem_v;
        }
        i = i + 1;
    }

    let tk = unsafe { (*bb).term.kind };
    if tk == OPT_TERM_CALL || tk == OPT_TERM_DROP {
        unsafe { (*bb).term.mem_use = MemSsaId { v: cur_mem_v }; }
        let treg: MemoryRegion = if tk == OPT_TERM_DROP {
            optir_extract_memory_region(view(*body), unsafe { view((*bb).term.drop_place) })
        } else if unsafe { (*bb).term.has_call_dest } {
            optir_extract_memory_region(view(*body), unsafe { view((*bb).term.call_dest) })
        } else {
            opt_empty_region()
        };
        let teff = optir_term_effects(view(*body), unsafe { view((*bb).term) });
        let tmem_v = optir_alloc_mem_def(
            mut_view(*body),
            mut_view(*arena),
            MEM_DEF_TERM,
            OptBbId { v: bb_v },
            OPT_INST_NONE,
            MemSsaId { v: cur_mem_v },
            view(treg),
            teff,
            true
        ).v;
        unsafe { (*bb).term.mem_def = MemSsaId { v: tmem_v }; }
        cur_mem_v = tmem_v;
    }

    unsafe { (*bb).mem_out = MemSsaId { v: cur_mem_v }; }

    // Fill MemoryPhi incoming versions in CFG successors
    let succ_cnt = unsafe { (*bb).succ_count };
    let succs = unsafe { (*bb).succs };
    let mut si: usize = 0;
    while si < succ_cnt {
        let sid = (unsafe { (*opt_bbid_at(succs, si)).v }) as usize;
        if sid < body.bb_count {
            let sbb = unsafe { opt_block_at(body.blocks, sid) };
            if unsafe { (*sbb).has_mem_phi } {
                let pidx = opt_find_pred_index(unsafe { view(*sbb) }, OptBbId { v: bb_v });
                if pidx < (unsafe { (*sbb).pred_count }) {
                    unsafe { *opt_memid_at((*sbb).mem_phi_inputs, pidx) = MemSsaId { v: cur_mem_v }; }
                }
            }
        }
        si = si + 1;
    }

    // Recurse on dominator-tree children in ascending OptBbId order
    let mut c: usize = 0;
    while c < body.bb_count {
        if c != b_idx {
            let cbb = unsafe { opt_block_at(body.blocks, c) };
            if (unsafe { (*cbb).is_reachable }) && (unsafe { (*cbb).idom.v }) == bb_v {
                opt_memssa_rename_dom_tree(mut_view(*body), mut_view(*arena), c, MemSsaId { v: cur_mem_v });
            }
        }
        c = c + 1;
    }
}

pub fn optir_construct_memssa(body: mut_view<OptBody>, arena: mut_view<Arena>) {
    let n = body.bb_count;
    body.mem_ssa_count = 0;
    let empty_reg = opt_empty_region();
    // Allocate mem0 = LiveOnEntry
    let _ = optir_alloc_mem_def(
        mut_view(*body),
        mut_view(*arena),
        MEM_DEF_LIVE_ON_ENTRY,
        OptBbId { v: 0u32 },
        OPT_INST_NONE,
        MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY },
        view(empty_reg),
        EFFECT_PURE,
        false
    );
    if n == 0 {
        return;
    }

    // 1. Identify blocks containing at least one MemoryDef
    let has_mphi = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let in_work = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let worklist = arena_alloc_raw(mut_view(*arena), opt_mul_usize(n, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
    let mut w_len: usize = 0;

    let mut b: usize = 0;
    while b < n {
        unsafe {
            *opt_bool_at(has_mphi, b) = false;
            *opt_bool_at(in_work, b) = false;
        }
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let mut blk_writes = false;
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                if opt_inst_writes_mem(view(*body), unsafe { view(*inst) }) {
                    blk_writes = true;
                    break;
                }
                i = i + 1;
            }
            let tk = unsafe { (*bb).term.kind };
            if tk == OPT_TERM_CALL || tk == OPT_TERM_DROP {
                blk_writes = true;
            }
            if blk_writes {
                unsafe {
                    *opt_bool_at(in_work, b) = true;
                    *opt_bbid_at(worklist, w_len) = OptBbId { v: b as u32 };
                }
                w_len = w_len + 1;
            }
        }
        b = b + 1;
    }

    // 2. Compute IDF(Defs_mem) for MemoryPhi placement
    let mut w_idx: usize = 0;
    while w_idx < w_len {
        let x_v = unsafe { (*opt_bbid_at(worklist, w_idx)).v };
        w_idx = w_idx + 1;
        let xbb = unsafe { opt_block_at(body.blocks, x_v as usize) };
        let df_cnt = unsafe { (*xbb).dom_frontier_count };
        let df_arr = unsafe { (*xbb).dom_frontier };
        let mut di: usize = 0;
        while di < df_cnt {
            let y_v = unsafe { (*opt_bbid_at(df_arr, di)).v };
            let y = y_v as usize;
            if y < n && !(unsafe { *opt_bool_at(has_mphi, y) }) {
                unsafe { *opt_bool_at(has_mphi, y) = true; }
                if !(unsafe { *opt_bool_at(in_work, y) }) {
                    unsafe {
                        *opt_bool_at(in_work, y) = true;
                        *opt_bbid_at(worklist, w_len) = OptBbId { v: y_v };
                    }
                    w_len = w_len + 1;
                }
            }
            di = di + 1;
        }
    }

    b = 0;
    while b < n {
        if unsafe { *opt_bool_at(has_mphi, b) } {
            let ybb = unsafe { opt_block_at(body.blocks, b) };
            let arity = unsafe { (*ybb).pred_count };
            if arity >= 2 {
                let mphi_id = optir_alloc_mem_def(
                    mut_view(*body),
                    mut_view(*arena),
                    MEM_DEF_PHI,
                    OptBbId { v: b as u32 },
                    OPT_INST_NONE,
                    MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY },
                    view(empty_reg),
                    EFFECT_WRITES_MEM,
                    false
                );
                let minps = arena_alloc_raw(mut_view(*arena), opt_mul_usize(arity, size_of<MemSsaId>()), align_of<MemSsaId>()) as *mut MemSsaId;
                let mut pi: usize = 0;
                while pi < arity {
                    unsafe { *opt_memid_at(minps, pi) = MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY }; }
                    pi = pi + 1;
                }
                unsafe {
                    (*ybb).has_mem_phi = true;
                    (*ybb).mem_phi_result = mphi_id;
                    (*ybb).mem_phi_inputs = minps;
                }
            }
        }
        b = b + 1;
    }

    // 3. Top-down dominator-tree renaming of MemorySSA versions
    opt_memssa_rename_dom_tree(mut_view(*body), mut_view(*arena), 0, MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY });
}

pub fn memssa_does_clobber(body: view<OptBody>, def_id: MemSsaId, read_region: view<MemoryRegion>) -> bool {
    let dv = def_id.v;
    if dv == MEM_SSA_LIVE_ON_ENTRY || (dv as usize) >= body.mem_ssa_count {
        return false;
    }
    let dnode = unsafe { opt_memdef_at(body.mem_defs, dv as usize) };
    let dkind = unsafe { (*dnode).kind };
    if dkind == MEM_DEF_PHI {
        return true;
    }
    if unsafe { (*dnode).is_barrier } {
        return true;
    }
    let deff = unsafe { (*dnode).effect };
    if (deff & (EFFECT_VOLATILE | EFFECT_ATOMIC | EFFECT_IO | EFFECT_FFI | EFFECT_UNKNOWN)) != 0u16 {
        return true;
    }
    let alias = optir_alias_query(body, unsafe { view((*dnode).region) }, read_region);
    alias != ALIAS_NO_ALIAS
}

pub fn memssa_find_clobbering_def(
    body: view<OptBody>,
    start_mem: MemSsaId,
    read_region: view<MemoryRegion>,
    max_steps: u32
) -> MemSsaId {
    let mut cur_v = start_mem.v;
    let mut steps: u32 = 0u32;
    while cur_v != MEM_SSA_LIVE_ON_ENTRY && cur_v != MEM_SSA_NONE && (cur_v as usize) < body.mem_ssa_count {
        if steps >= max_steps {
            return MemSsaId { v: cur_v };
        }
        let cur_id = MemSsaId { v: cur_v };
        if memssa_does_clobber(view(*body), cur_id, view(*read_region)) {
            return MemSsaId { v: cur_v };
        }
        let dnode = unsafe { opt_memdef_at(body.mem_defs, cur_v as usize) };
        cur_v = unsafe { (*dnode).prev_mem.v };
        steps = steps + 1u32;
    }
    MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY }
}

// --- Bounded Range, Certainty Lattice & ProofProvenance Analysis (AXS-OPT-005, REQ-OPT-390..403) ---

fn opt_type_max_unsigned(thir: *const Thir, ty: TypeId) -> u64 {
    let bw = opt_type_bit_width(thir, ty);
    if bw == 1u32 { return 1u64; }
    if bw == 8u32 { return 0xFFu64; }
    if bw == 16u32 { return 0xFFFFu64; }
    if bw == 32u32 { return 0xFFFFFFFFu64; }
    0xFFFFFFFFFFFFFFFFu64
}

fn opt_type_max_signed_pos(thir: *const Thir, ty: TypeId) -> u64 {
    let bw = opt_type_bit_width(thir, ty);
    if bw == 8u32 { return 0x7Fu64; }
    if bw == 16u32 { return 0x7FFFu64; }
    if bw == 32u32 { return 0x7FFFFFFFu64; }
    0x7FFFFFFFFFFFFFFFu64
}

pub fn optir_query_non_zero_certainty(body: view<OptBody>, val_id: OptValueId, max_steps: u32) -> u8 {
    if val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count || max_steps == 0u32 {
        return CERTAINTY_UNKNOWN;
    }
    if (body.ranges as usize) != 0 {
        let rp = unsafe { opt_range_at(body.ranges, val_id.v as usize) };
        if unsafe { (*rp).has_fp_hazard } {
            return certainty_negate_hazard(true, unsafe { (*rp).non_zero_certainty });
        }
        return unsafe { (*rp).non_zero_certainty };
    }
    let vp = unsafe { opt_val_at(body.values, val_id.v as usize) };
    if (unsafe { (*vp).kind }) == OPT_VAL_CONST {
        if (unsafe { (*vp).const_val.val }) != 0u64 {
            return CERTAINTY_PROVEN;
        }
    }
    CERTAINTY_UNKNOWN
}

pub fn optir_query_in_bounds_certainty(body: view<OptBody>, idx_id: OptValueId, len_val: u64, max_steps: u32) -> u8 {
    if idx_id.v == OPT_VALUE_NONE || (idx_id.v as usize) > body.value_count || max_steps == 0u32 || len_val == 0u64 {
        return CERTAINTY_UNKNOWN;
    }
    if (body.ranges as usize) != 0 {
        let rp = unsafe { opt_range_at(body.ranges, idx_id.v as usize) };
        if unsafe { (*rp).has_range } {
            let lo = unsafe { (*rp).lo };
            let hi = unsafe { (*rp).hi };
            let is_sig = unsafe { (*rp).is_signed };
            if !is_sig || (lo <= 0x7FFFFFFFFFFFFFFFu64 && hi <= 0x7FFFFFFFFFFFFFFFu64) {
                if hi < len_val {
                    return CERTAINTY_PROVEN;
                }
                if lo < len_val {
                    return CERTAINTY_POSSIBLE;
                }
            }
        }
    }
    CERTAINTY_UNKNOWN
}

pub fn optir_query_no_overflow_certainty(
    body: view<OptBody>,
    bin_op: u8,
    ty: TypeId,
    lhs_id: OptValueId,
    rhs_id: OptValueId,
    max_steps: u32
) -> u8 {
    let ty_v = ty.v;
    let lhs_v = lhs_id.v;
    let rhs_v = rhs_id.v;
    if max_steps == 0u32 || lhs_v == OPT_VALUE_NONE || rhs_v == OPT_VALUE_NONE {
        return CERTAINTY_UNKNOWN;
    }
    if (lhs_v as usize) > body.value_count || (rhs_v as usize) > body.value_count {
        return CERTAINTY_UNKNOWN;
    }
    if (body.ranges as usize) == 0 {
        return CERTAINTY_UNKNOWN;
    }
    let rl = unsafe { opt_range_at(body.ranges, lhs_v as usize) };
    let rr = unsafe { opt_range_at(body.ranges, rhs_v as usize) };
    if (unsafe { (*rl).has_fp_hazard }) || (unsafe { (*rr).has_fp_hazard }) {
        return CERTAINTY_POSSIBLE;
    }
    if bin_op == MIR_BINOP_BIT_AND || bin_op == MIR_BINOP_BIT_OR || bin_op == MIR_BINOP_BIT_XOR ||
       bin_op == MIR_BINOP_EQ || bin_op == MIR_BINOP_NE || bin_op == MIR_BINOP_LT ||
       bin_op == MIR_BINOP_LE || bin_op == MIR_BINOP_GT || bin_op == MIR_BINOP_GE {
        return CERTAINTY_PROVEN;
    }
    if bin_op == MIR_BINOP_DIV || bin_op == MIR_BINOP_REM {
        let nz = unsafe { (*rr).non_zero_certainty };
        if nz != CERTAINTY_PROVEN {
            return nz;
        }
        let div_ty = TypeId { v: ty_v };
        if !opt_type_is_signed(body.thir, div_ty) {
            return CERTAINTY_PROVEN;
        }
        // Signed division/remainder only overflows on MIN / -1
        if (unsafe { (*rr).has_range }) && (unsafe { (*rr).hi }) < 0x7FFFFFFFFFFFFFFFu64 {
            return CERTAINTY_PROVEN;
        }
        return CERTAINTY_POSSIBLE;
    }
    if !(unsafe { (*rl).has_range }) || !(unsafe { (*rr).has_range }) {
        return CERTAINTY_UNKNOWN;
    }
    let l_lo = unsafe { (*rl).lo };
    let l_hi = unsafe { (*rl).hi };
    let r_lo = unsafe { (*rr).lo };
    let r_hi = unsafe { (*rr).hi };

    if bin_op == MIR_BINOP_SHL || bin_op == MIR_BINOP_SHR {
        let bw = opt_type_bit_width(body.thir, TypeId { v: ty_v }) as u64;
        if bw == 0u64 {
            return CERTAINTY_UNKNOWN;
        }
        if r_hi < bw {
            return CERTAINTY_PROVEN;
        }
        if r_lo < bw {
            return CERTAINTY_POSSIBLE;
        }
        return CERTAINTY_UNKNOWN;
    }

    let is_sig = opt_type_is_signed(body.thir, TypeId { v: ty_v });
    let max_lim: u64 = if is_sig {
        opt_type_max_signed_pos(body.thir, TypeId { v: ty_v })
    } else {
        opt_type_max_unsigned(body.thir, TypeId { v: ty_v })
    };

    // Check non-negative interval [l_lo..l_hi] op [r_lo..r_hi] within [0..max_lim]
    if l_hi <= max_lim && r_hi <= max_lim {
        if bin_op == MIR_BINOP_ADD {
            if l_hi <= max_lim - r_hi {
                return CERTAINTY_PROVEN;
            }
            if l_lo <= max_lim - r_lo {
                return CERTAINTY_POSSIBLE;
            }
        } else if bin_op == MIR_BINOP_SUB {
            if is_sig {
                return CERTAINTY_PROVEN;
            }
            if l_lo >= r_hi {
                return CERTAINTY_PROVEN;
            }
            if l_hi >= r_lo {
                return CERTAINTY_POSSIBLE;
            }
        } else if bin_op == MIR_BINOP_MUL {
            if r_hi == 0u64 || l_hi <= (max_lim / r_hi) {
                return CERTAINTY_PROVEN;
            }
            if r_lo == 0u64 || l_lo <= (max_lim / r_lo) {
                return CERTAINTY_POSSIBLE;
            }
        }
    }
    CERTAINTY_UNKNOWN
}

pub fn optir_analyze_ranges_and_provenance(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    max_steps: u32
) {
    let vcnt = body.value_count;
    let alloc_v: usize = if vcnt == 0 { 2 } else { vcnt + 2 };
    body.ranges = arena_alloc_raw(mut_view(*arena), opt_mul_usize(alloc_v, size_of<OptRange>()), align_of<OptRange>()) as *mut OptRange;

    let mut v: usize = 0;
    while v <= vcnt {
        let rp = unsafe { opt_range_at(body.ranges, v) };
        unsafe {
            (*rp).has_range = false;
            (*rp).is_signed = false;
            (*rp).lo = 0u64;
            (*rp).hi = 0u64;
            (*rp).non_zero_certainty = CERTAINTY_UNKNOWN;
            (*rp).has_fp_hazard = false;
        }
        if v >= 1 {
            let vp = unsafe { opt_val_at(body.values, v) };
            let vk = unsafe { (*vp).kind };
            let vty_v = unsafe { (*vp).ty.v };
            let is_sig = opt_type_is_signed(body.thir, TypeId { v: vty_v });
            unsafe { (*rp).is_signed = is_sig; }
            if vk == OPT_VAL_CONST {
                let ck = unsafe { (*vp).const_val.kind };
                if ck == MIR_CONST_INT || ck == MIR_CONST_BOOL {
                    let cval = unsafe { (*vp).const_val.val };
                    unsafe {
                        (*rp).has_range = true;
                        (*rp).lo = cval;
                        (*rp).hi = cval;
                        (*rp).non_zero_certainty = if cval != 0u64 { CERTAINTY_PROVEN } else { CERTAINTY_UNKNOWN };
                    }
                }
            }
        }
        v = v + 1;
    }

    let mut steps: u32 = 0u32;

    // Propagate ranges in RPO block order (bounded by max_steps per REQ-OPT-400)
    let mut r: usize = 0;
    while r < body.rpo_count {
        let bid_v = unsafe { (*opt_bbid_at(body.rpo_order, r)).v };
        let bb = unsafe { opt_block_at(body.blocks, bid_v as usize) };

        // Record reachability provenance for reachable block
        if steps < max_steps {
            optir_record_provenance(
                mut_view(*body),
                mut_view(*arena),
                PROP_REACHABLE,
                CERTAINTY_PROVEN,
                ANALYSIS_CFG,
                OptValueId { v: OPT_VALUE_NONE },
                OptValueId { v: OPT_VALUE_NONE },
                OptBbId { v: bid_v },
                OptInstId { v: OPT_INST_NONE },
                OPT_PASS_SSA_CONSTRUCT
            );
            steps = steps + 1u32;
        }

        // 1. Evaluate OptPhis in block
        let pcnt = unsafe { (*bb).phi_count };
        let phis = unsafe { (*bb).phis };
        let mut p: usize = 0;
        while p < pcnt {
            let phi = unsafe { opt_phi_at(phis, p) };
            let pres_v = unsafe { (*phi).result.v };
            let arity = unsafe { (*phi).arity };
            let incs = unsafe { (*phi).incoming_values };
            if pres_v != OPT_VALUE_NONE && (pres_v as usize) <= vcnt && arity > 0 {
                let mut all_have_range = steps < max_steps;
                let mut min_lo: u64 = 0xFFFFFFFFFFFFFFFFu64;
                let mut max_hi: u64 = 0u64;
                let mut joined_nz: u8 = CERTAINTY_PROVEN;
                let mut any_nz_proven = false;
                let mut k: usize = 0;
                while k < arity {
                    let iv_v = unsafe { (*opt_valid_at(incs, k)).v };
                    if iv_v == OPT_VALUE_NONE || (iv_v as usize) > vcnt {
                        all_have_range = false;
                        joined_nz = CERTAINTY_UNKNOWN;
                    } else {
                        let irp = unsafe { opt_range_at(body.ranges, iv_v as usize) };
                        let inz = unsafe { (*irp).non_zero_certainty };
                        if inz == CERTAINTY_PROVEN {
                            any_nz_proven = true;
                        }
                        if k == 0 {
                            joined_nz = inz;
                        } else {
                            joined_nz = certainty_join_paths(joined_nz, inz);
                        }
                        if unsafe { (*irp).has_range } {
                            let ilo = unsafe { (*irp).lo };
                            let ihi = unsafe { (*irp).hi };
                            if ilo < min_lo { min_lo = ilo; }
                            if ihi > max_hi { max_hi = ihi; }
                        } else {
                            all_have_range = false;
                        }
                    }
                    k = k + 1;
                }
                if joined_nz != CERTAINTY_PROVEN && any_nz_proven {
                    joined_nz = CERTAINTY_POSSIBLE;
                }
                let prp = unsafe { opt_range_at(body.ranges, pres_v as usize) };
                unsafe {
                    (*prp).has_range = all_have_range;
                    if all_have_range {
                        (*prp).lo = min_lo;
                        (*prp).hi = max_hi;
                    }
                    (*prp).non_zero_certainty = joined_nz;
                }
                if joined_nz == CERTAINTY_PROVEN || joined_nz == CERTAINTY_POSSIBLE {
                    optir_record_provenance(
                        mut_view(*body),
                        mut_view(*arena),
                        PROP_NON_ZERO,
                        joined_nz,
                        ANALYSIS_RANGE_INFO,
                        OptValueId { v: pres_v },
                        OptValueId { v: OPT_VALUE_NONE },
                        OptBbId { v: bid_v },
                        OptInstId { v: OPT_INST_NONE },
                        OPT_PASS_SSA_CONSTRUCT
                    );
                }
            }
            p = p + 1;
        }

        // 2. Evaluate instructions in block
        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        let mut last_store_inst_v: u32 = OPT_INST_NONE;
        let mut last_store_reg = opt_empty_region();
        let mut has_last_store = false;

        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            let opc = unsafe { (*inst).opcode };
            let sub = unsafe { (*inst).sub_op };
            let iid_v = unsafe { (*inst).id.v };
            let res_v = unsafe { (*inst).result.v };
            let lhs_v = unsafe { (*inst).lhs.v };
            let rhs_v = unsafe { (*inst).rhs.v };
            let ity_v = unsafe { (*inst).ty.v };

            if opc == OPT_INST_COPY && res_v != OPT_VALUE_NONE && lhs_v != OPT_VALUE_NONE && res_v != lhs_v &&
               (res_v as usize) <= vcnt && (lhs_v as usize) <= vcnt {
                let lrp = unsafe { opt_range_at(body.ranges, lhs_v as usize) };
                let rrp = unsafe { opt_range_at(body.ranges, res_v as usize) };
                unsafe {
                    ptr_copy_nonoverlapping<u8>(lrp as *const u8, rrp as *mut u8, size_of<OptRange>());
                }
            } else if opc == OPT_INST_BINOP || opc == OPT_INST_CHECKED_BINOP || opc == OPT_INST_WRAPPING_BINOP {
                let rem_budget: u32 = if steps < max_steps { max_steps - steps } else { 0u32 };
                let ovf_cert = optir_query_no_overflow_certainty(
                    view(*body),
                    sub,
                    TypeId { v: ity_v },
                    OptValueId { v: lhs_v },
                    OptValueId { v: rhs_v },
                    rem_budget
                );
                if steps < max_steps {
                    steps = steps + 1u32;
                }
                if opc == OPT_INST_CHECKED_BINOP || (sub == MIR_BINOP_ADD || sub == MIR_BINOP_SUB || sub == MIR_BINOP_MUL || sub == MIR_BINOP_DIV || sub == MIR_BINOP_REM || sub == MIR_BINOP_SHL || sub == MIR_BINOP_SHR) {
                    optir_record_provenance(
                        mut_view(*body),
                        mut_view(*arena),
                        PROP_NO_OVERFLOW,
                        ovf_cert,
                        ANALYSIS_RANGE_INFO,
                        OptValueId { v: res_v },
                        OptValueId { v: lhs_v },
                        OptBbId { v: bid_v },
                        OptInstId { v: iid_v },
                        OPT_PASS_SSA_CONSTRUCT
                    );
                }
                if sub == MIR_BINOP_DIV || sub == MIR_BINOP_REM {
                    let nz_cert = optir_query_non_zero_certainty(view(*body), OptValueId { v: rhs_v }, rem_budget);
                    optir_record_provenance(
                        mut_view(*body),
                        mut_view(*arena),
                        PROP_NON_ZERO,
                        nz_cert,
                        ANALYSIS_RANGE_INFO,
                        OptValueId { v: rhs_v },
                        OptValueId { v: lhs_v },
                        OptBbId { v: bid_v },
                        OptInstId { v: iid_v },
                        OPT_PASS_SSA_CONSTRUCT
                    );
                }
                // Propagate constant/interval range for non-overflowing ADD/SUB/MUL
                if ovf_cert == CERTAINTY_PROVEN && res_v != OPT_VALUE_NONE && (res_v as usize) <= vcnt &&
                   lhs_v != OPT_VALUE_NONE && rhs_v != OPT_VALUE_NONE &&
                   (lhs_v as usize) <= vcnt && (rhs_v as usize) <= vcnt {
                    let rl = unsafe { opt_range_at(body.ranges, lhs_v as usize) };
                    let rr = unsafe { opt_range_at(body.ranges, rhs_v as usize) };
                    let r_out = unsafe { opt_range_at(body.ranges, res_v as usize) };
                    if (unsafe { (*rl).has_range }) && (unsafe { (*rr).has_range }) {
                        if sub == MIR_BINOP_ADD {
                            let nlo = (unsafe { (*rl).lo }) + (unsafe { (*rr).lo });
                            let nhi = (unsafe { (*rl).hi }) + (unsafe { (*rr).hi });
                            unsafe {
                                (*r_out).has_range = true;
                                (*r_out).lo = nlo;
                                (*r_out).hi = nhi;
                                (*r_out).non_zero_certainty = if nlo > 0u64 { CERTAINTY_PROVEN } else { CERTAINTY_UNKNOWN };
                            }
                        } else if sub == MIR_BINOP_SUB && (unsafe { (*rl).lo }) >= (unsafe { (*rr).hi }) {
                            let nlo = (unsafe { (*rl).lo }) - (unsafe { (*rr).hi });
                            let nhi = (unsafe { (*rl).hi }) - (unsafe { (*rr).lo });
                            unsafe {
                                (*r_out).has_range = true;
                                (*r_out).lo = nlo;
                                (*r_out).hi = nhi;
                                (*r_out).non_zero_certainty = if nlo > 0u64 { CERTAINTY_PROVEN } else { CERTAINTY_UNKNOWN };
                            }
                        } else if sub == MIR_BINOP_MUL {
                            let nlo = (unsafe { (*rl).lo }) * (unsafe { (*rr).lo });
                            let nhi = (unsafe { (*rl).hi }) * (unsafe { (*rr).hi });
                            unsafe {
                                (*r_out).has_range = true;
                                (*r_out).lo = nlo;
                                (*r_out).hi = nhi;
                                (*r_out).non_zero_certainty = if nlo > 0u64 { CERTAINTY_PROVEN } else { CERTAINTY_UNKNOWN };
                            }
                        }
                    }
                }
            }

            // Memory alias / dead-store provenance tracking
            let muse_v = unsafe { (*inst).mem_use.v };
            let mdef_v = unsafe { (*inst).mem_def.v };
            if muse_v != MEM_SSA_NONE && mdef_v == MEM_SSA_NONE {
                // Memory read: check against previous store in block
                let read_reg = optir_extract_memory_region(view(*body), unsafe { view((*inst).rhs_place) });
                if has_last_store {
                    let al = optir_alias_query(view(*body), view(last_store_reg), view(read_reg));
                    let al_cert: u8 = if al == ALIAS_NO_ALIAS {
                        CERTAINTY_PROVEN
                    } else if al == ALIAS_MAY_ALIAS || al == ALIAS_PARTIAL_ALIAS {
                        CERTAINTY_POSSIBLE
                    } else {
                        CERTAINTY_UNKNOWN
                    };
                    if al != ALIAS_MUST_ALIAS {
                        optir_record_provenance(
                            mut_view(*body),
                            mut_view(*arena),
                            PROP_NO_ALIAS,
                            al_cert,
                            ANALYSIS_ALIAS_INFO,
                            OptValueId { v: res_v },
                            OptValueId { v: OPT_VALUE_NONE },
                            OptBbId { v: bid_v },
                            OptInstId { v: iid_v },
                            OPT_PASS_MEMSSA_CONSTRUCT
                        );
                    } else {
                        has_last_store = false;
                    }
                }
            }
            if mdef_v != MEM_SSA_NONE {
                let write_reg = optir_extract_memory_region(view(*body), unsafe { view((*inst).place) });
                let is_bar = ((unsafe { (*inst).flags }) & OPT_FLAG_BARRIER) != 0u16 ||
                             opc == OPT_INST_VOLATILE_STORE || opc == OPT_INST_VOLATILE_LOAD ||
                             opc == OPT_INST_ATOMIC || opc == OPT_INST_BLACK_BOX ||
                             opc == OPT_INST_ZEROIZE || opc == OPT_INST_DROP_FLAG;
                if !is_bar && has_last_store {
                    let al = optir_alias_query(view(*body), view(last_store_reg), view(write_reg));
                    if al == ALIAS_MUST_ALIAS {
                        // Two consecutive stores to MustAlias region without intervening read -> first is DeadStore (Proven)
                        optir_record_provenance(
                            mut_view(*body),
                            mut_view(*arena),
                            PROP_DEAD_STORE,
                            CERTAINTY_PROVEN,
                            ANALYSIS_MEMORY_SSA,
                            OptValueId { v: mdef_v },
                            OptValueId { v: OPT_VALUE_NONE },
                            OptBbId { v: bid_v },
                            OptInstId { v: last_store_inst_v },
                            OPT_PASS_MEMSSA_CONSTRUCT
                        );
                    } else if al == ALIAS_NO_ALIAS {
                        optir_record_provenance(
                            mut_view(*body),
                            mut_view(*arena),
                            PROP_NO_ALIAS,
                            CERTAINTY_PROVEN,
                            ANALYSIS_ALIAS_INFO,
                            OptValueId { v: mdef_v },
                            OptValueId { v: OPT_VALUE_NONE },
                            OptBbId { v: bid_v },
                            OptInstId { v: iid_v },
                            OPT_PASS_MEMSSA_CONSTRUCT
                        );
                    }
                }
                if !is_bar {
                    last_store_inst_v = iid_v;
                    last_store_reg.domain = write_reg.domain;
                    last_store_reg.base_local = MirLocalId { v: write_reg.base_local.v };
                    last_store_reg.base_value = OptValueId { v: write_reg.base_value.v };
                    last_store_reg.const_offset = write_reg.const_offset;
                    last_store_reg.byte_size = write_reg.byte_size;
                    last_store_reg.has_known_bounds = write_reg.has_known_bounds;
                    mir_copy_place(mut_view(last_store_reg.place), view(write_reg.place));
                    has_last_store = true;
                } else {
                    has_last_store = false;
                }
            }
            i = i + 1;
        }
        r = r + 1;
    }
}

// --- OptIR Structural & Semantic Contract Verifier (AXS-OPT-034) ---

pub fn optir_verify_contract(body: view<OptBody>) -> bool {
    if body.bb_count == 0 || (body.blocks as usize) == 0 {
        return false;
    }
    let bb0 = unsafe { opt_block_at(body.blocks, 0) };
    if !(unsafe { (*bb0).is_reachable }) || (unsafe { (*bb0).idom.v }) != 0u32 {
        return false;
    }

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if !(unsafe { (*bb).has_term }) {
            return false;
        }
        // Check sorted ascending preds and succs
        let pcnt = unsafe { (*bb).pred_count };
        let preds = unsafe { (*bb).preds };
        let mut p: usize = 0;
        while p < pcnt {
            let pv = unsafe { (*opt_bbid_at(preds, p)).v };
            if (pv as usize) >= body.bb_count {
                return false;
            }
            if p > 0 && pv <= (unsafe { (*opt_bbid_at(preds, p - 1)).v }) {
                return false;
            }
            p = p + 1;
        }
        let scnt = unsafe { (*bb).succ_count };
        let succs = unsafe { (*bb).succs };
        let mut s: usize = 0;
        while s < scnt {
            let sv = unsafe { (*opt_bbid_at(succs, s)).v };
            if (sv as usize) >= body.bb_count {
                return false;
            }
            if s > 0 && sv <= (unsafe { (*opt_bbid_at(succs, s - 1)).v }) {
                return false;
            }
            // Verify CFG edge symmetry: B in S.preds
            let sbb = unsafe { opt_block_at(body.blocks, sv as usize) };
            let pidx = opt_find_pred_index(unsafe { view(*sbb) }, OptBbId { v: b as u32 });
            if pidx >= (unsafe { (*sbb).pred_count }) {
                return false;
            }
            s = s + 1;
        }

        if unsafe { (*bb).is_reachable } {
            if b != 0 {
                let idom_v = unsafe { (*bb).idom.v };
                let idom_bb_id = OptBbId { v: idom_v };
                let cur_bb_id = OptBbId { v: b as u32 };
                if idom_v == OPT_BB_NONE || !opt_dominates(view(*body), idom_bb_id, cur_bb_id) {
                    return false;
                }
            }
            // Verify OptPhi arity and incoming block alignment
            let phi_cnt = unsafe { (*bb).phi_count };
            let phis = unsafe { (*bb).phis };
            let mut pi: usize = 0;
            while pi < phi_cnt {
                let phi = unsafe { opt_phi_at(phis, pi) };
                if (unsafe { (*phi).arity }) != pcnt {
                    return false;
                }
                let mut k: usize = 0;
                while k < pcnt {
                    let ib = unsafe { (*opt_bbid_at((*phi).incoming_blocks, k)).v };
                    let pb = unsafe { (*opt_bbid_at(preds, k)).v };
                    if ib != pb {
                        return false;
                    }
                    let iv = unsafe { (*opt_valid_at((*phi).incoming_values, k)).v };
                    let pred_bb = unsafe { opt_block_at(body.blocks, pb as usize) };
                    if (unsafe { (*pred_bb).is_reachable }) && (iv == OPT_VALUE_NONE || (iv as usize) > body.value_count) {
                        return false;
                    }
                    k = k + 1;
                }
                pi = pi + 1;
            }
            // Verify MemoryPhi arity
            if unsafe { (*bb).has_mem_phi } {
                let mphi_res = unsafe { (*bb).mem_phi_result.v };
                if mphi_res == MEM_SSA_NONE || (mphi_res as usize) >= body.mem_ssa_count {
                    return false;
                }
            }
            // Verify instruction MemorySSA IDs
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut ii: usize = 0;
            while ii < icnt {
                let inst = unsafe { opt_inst_at(insts, ii) };
                let mu = unsafe { (*inst).mem_use.v };
                let md = unsafe { (*inst).mem_def.v };
                if mu != MEM_SSA_NONE && (mu as usize) >= body.mem_ssa_count {
                    return false;
                }
                if md != MEM_SSA_NONE && (md as usize) >= body.mem_ssa_count {
                    return false;
                }
                ii = ii + 1;
            }
        }
        b = b + 1;
    }
    true
}

// --- OptIR -> MirBody Reconstruction (AXS-OPT-034) ---

pub fn optir_reconstruct_mir(
    opt_body: view<OptBody>,
    out_mir: mut_view<MirBody>,
    arena: mut_view<Arena>
) -> bool {
    if !optir_verify_contract(view(*opt_body)) {
        return false;
    }
    mir_body_reset(mut_view(*out_mir));
    out_mir.fn_sym = SymbolId { v: opt_body.fn_sym.v };
    out_mir.fn_name = StrId { v: opt_body.fn_name.v };
    out_mir.span = Span {
        file: FileId { v: opt_body.span.file.v },
        start: opt_body.span.start,
        end: opt_body.span.end,
    };
    if (opt_body.orig_mir as usize) != 0 {
        let orig = unsafe { view(*opt_body.orig_mir) };
        out_mir.sym = SymbolId { v: orig.sym.v };
        out_mir.drop_flag_count = orig.drop_flag_count;
        let mut l: usize = 0;
        while l < orig.local_count {
            let decl = unsafe { mir_local_at(orig.locals, l) };
            let lid = mir_add_local(
                mut_view(*out_mir),
                mut_view(*arena),
                TypeId { v: unsafe { (*decl).ty.v } },
                unsafe { (*decl).kind },
                unsafe { (*decl).mut_flag },
                StrId { v: unsafe { (*decl).name.v } },
                unsafe { view((*decl).span) }
            );
            let new_decl = unsafe { mir_local_at(out_mir.locals, lid.v as usize) };
            unsafe { (*new_decl).const_sym = SymbolId { v: (*decl).const_sym.v }; }
            l = l + 1;
        }
    } else {
        let mut l: usize = 0;
        while l < opt_body.local_count {
            let lty_v = unsafe { (*opt_typeid_at(opt_body.local_tys, l)).v };
            let lkind: u8 = if l >= 1 && l <= opt_body.arg_count { MIR_LOCAL_ARG } else { 0u8 };
            let _ = mir_add_local(
                mut_view(*out_mir),
                mut_view(*arena),
                TypeId { v: lty_v },
                lkind,
                true,
                StrId { v: 0u32 },
                view(opt_body.span)
            );
            l = l + 1;
        }
    }

    let rterm_ptr = arena_alloc_raw(mut_view(*arena), size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    let mut b: usize = 0;
    while b < opt_body.bb_count {
        let obb = unsafe { opt_block_at(opt_body.blocks, b) };
        let mbb_id = mir_add_bb(mut_view(*out_mir), mut_view(*arena), unsafe { (*obb).is_cleanup });
        let mbb = unsafe { mir_bb_at(out_mir.bbs, mbb_id.v as usize) };
        let icnt = unsafe { (*obb).inst_count };
        let insts = unsafe { (*obb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            let opc = unsafe { (*inst).opcode };
            let flg = unsafe { (*inst).flags };
            let is_deleted_nop = opc == OPT_INST_NOP && (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16;
            if !is_deleted_nop {
                mir_bb_push_stmt(unsafe { mut_view(*mbb) }, mut_view(*arena), unsafe { view((*inst).orig_stmt) });
            }
            i = i + 1;
        }
        mir_copy_terminator(unsafe { mut_view(*rterm_ptr) }, unsafe { view((*obb).term.orig_term) });
        let otk = unsafe { (*obb).term.kind };
        if otk == OPT_TERM_GOTO {
            unsafe {
                (*rterm_ptr).kind = MIR_TERM_GOTO;
                (*rterm_ptr).goto_target = MirBbId { v: (*obb).term.true_bb.v };
            }
        } else if otk == OPT_TERM_RETURN {
            unsafe { (*rterm_ptr).kind = MIR_TERM_RETURN; }
        } else if otk == OPT_TERM_UNREACHABLE {
            unsafe { (*rterm_ptr).kind = MIR_TERM_UNREACHABLE; }
        }
        mir_bb_set_terminator(unsafe { mut_view(*mbb) }, unsafe { view(*rterm_ptr) });
        b = b + 1;
    }
    true
}

