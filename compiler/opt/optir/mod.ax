];

const OPTIR_STR_OFF: [104]u32 = [
    0u32, 13u32, 27u32, 38u32, 45u32, 55u32, 63u32, 73u32, 79u32, 89u32,
    100u32, 109u32, 118u32, 125u32, 132u32, 138u32, 142u32, 144u32, 146u32, 149u32,
    163u32, 168u32, 172u32, 180u32, 183u32, 189u32, 194u32, 200u32, 214u32, 229u32,
    234u32, 239u32, 250u32, 264u32, 277u32, 282u32, 288u32, 302u32, 317u32, 324u32,
    334u32, 342u32, 352u32, 360u32, 364u32, 377u32, 380u32, 394u32, 395u32, 409u32,
    411u32, 421u32, 429u32, 442u32, 453u32, 464u32, 470u32, 474u32, 487u32, 493u32,
    499u32, 507u32, 512u32, 523u32, 529u32, 540u32, 547u32, 558u32, 568u32, 574u32,
    580u32, 587u32, 595u32, 602u32, 612u32, 620u32, 628u32, 637u32, 646u32, 652u32,
    660u32, 667u32, 670u32, 680u32, 683u32, 692u32, 702u32, 711u32, 721u32, 730u32,
    738u32, 761u32, 774u32, 788u32, 801u32, 816u32, 827u32, 829u32, 845u32, 857u32,
    868u32, 872u32, 877u32, 879u32,
];

fn opt_push_tok(out: mut_view<DiagBuffer>, tok: usize) {
    let start = OPTIR_STR_OFF[tok] as usize;
    let end = OPTIR_STR_OFF[tok + 1] as usize;
    let mut i: usize = start;
    while i < end {
        diag_buf_push_byte(mut_view(*out), OPTIR_STR_DATA[i]);
        i = i + 1;
    }
}

fn opt_push_spaces(out: mut_view<DiagBuffer>, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), 32u8);
        i = i + 1;
    }
}

fn opt_print_bb_list(out: mut_view<DiagBuffer>, arr: *mut OptBbId, count: usize) {
    let mut i: usize = 0;
    while i < count {
        if i > 0 {
            opt_push_tok(mut_view(*out), 16); // ", "
        }
        opt_push_tok(mut_view(*out), 17); // "bb"
        let bid = unsafe { (*opt_bbid_at(arr, i)).v };
        diag_buf_push_u32(mut_view(*out), bid);
        i = i + 1;
    }
}

fn opt_print_val_ref(out: mut_view<DiagBuffer>, body: view<OptBody>, vid: OptValueId) {
    if vid.v == OPT_VALUE_NONE || (vid.v as usize) > body.value_count {
        diag_buf_push_byte(mut_view(*out), 118u8); // 'v'
        diag_buf_push_u32(mut_view(*out), 0u32);
        return;
    }
    let vp = unsafe { opt_val_at(body.values, vid.v as usize) };
    if (unsafe { (*vp).kind }) == OPT_VAL_CONST && (unsafe { (*vp).const_val.kind }) != MIR_CONST_STR {
        diag_buf_push_byte(mut_view(*out), 118u8); // 'v'
        diag_buf_push_u32(mut_view(*out), vid.v);
        diag_buf_push_byte(mut_view(*out), 40u8); // '('
        mir_buf_push_u64(mut_view(*out), unsafe { (*vp).const_val.val });
        diag_buf_push_byte(mut_view(*out), 41u8); // ')'
        return;
    }
    diag_buf_push_byte(mut_view(*out), 118u8); // 'v'
    diag_buf_push_u32(mut_view(*out), vid.v);
}

fn opt_print_mem_annotations(out: mut_view<DiagBuffer>, mu: MemSsaId, md: MemSsaId) {
    if mu.v != MEM_SSA_NONE {
        opt_push_tok(mut_view(*out), 46); // " [mem_use: mem"
        diag_buf_push_u32(mut_view(*out), mu.v);
        opt_push_tok(mut_view(*out), 47); // "]"
    }
    if md.v != MEM_SSA_NONE {
        opt_push_tok(mut_view(*out), 48); // " [mem_def: mem"
        diag_buf_push_u32(mut_view(*out), md.v);
        opt_push_tok(mut_view(*out), 47); // "]"
    }
}

pub fn optir_print(out: mut_view<DiagBuffer>, body: view<OptBody>) {
    opt_push_tok(mut_view(*out), 0); // "optir_body {\n"

    // 1. Print locals with mode classification
    let mut l: usize = 0;
    while l < body.local_count {
        opt_push_tok(mut_view(*out), 2); // "    local _"
        diag_buf_push_u32(mut_view(*out), l as u32);
        opt_push_tok(mut_view(*out), 3); // ": type#"
        let lty = unsafe { (*opt_typeid_at(body.local_tys, l)).v };
        diag_buf_push_u32(mut_view(*out), lty);
        let mode = unsafe { *opt_u8_at(body.local_modes, l) };
        if mode == OPT_LOCAL_SCALAR {
            opt_push_tok(mut_view(*out), 4); // " [scalar]\n"
        } else if mode == OPT_LOCAL_SROA {
            opt_push_tok(mut_view(*out), 5); // " [sroa]\n"
        } else {
            opt_push_tok(mut_view(*out), 6); // " [memory]\n"
        }
        l = l + 1;
    }

    // 2. Print blocks in deterministic ascending OptBbId order
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        opt_push_tok(mut_view(*out), 7); // "    bb"
        diag_buf_push_u32(mut_view(*out), b as u32);
        opt_push_tok(mut_view(*out), 8); // " (preds: ["
        opt_print_bb_list(mut_view(*out), unsafe { (*bb).preds }, unsafe { (*bb).pred_count });
        opt_push_tok(mut_view(*out), 9); // "], succs: ["
        opt_print_bb_list(mut_view(*out), unsafe { (*bb).succs }, unsafe { (*bb).succ_count });
        opt_push_tok(mut_view(*out), 10); // "], idom: "
        let idom_v = unsafe { (*bb).idom.v };
        if idom_v == OPT_BB_NONE {
            opt_push_tok(mut_view(*out), 15); // "none"
        } else {
            opt_push_tok(mut_view(*out), 17); // "bb"
            diag_buf_push_u32(mut_view(*out), idom_v);
        }
        opt_push_tok(mut_view(*out), 11); // ", depth: "
        diag_buf_push_u32(mut_view(*out), unsafe { (*bb).dom_depth });
        opt_push_tok(mut_view(*out), 12); // ", rpo: "
        let rpo_v = unsafe { (*bb).rpo_idx };
        if rpo_v == OPT_BB_NONE {
            opt_push_tok(mut_view(*out), 15); // "none"
        } else {
            diag_buf_push_u32(mut_view(*out), rpo_v);
        }
        opt_push_tok(mut_view(*out), 13); // ", df: ["
        opt_print_bb_list(mut_view(*out), unsafe { (*bb).dom_frontier }, unsafe { (*bb).dom_frontier_count });
        opt_push_tok(mut_view(*out), 14); // "]): {\n"

        // Print MemoryPhi if present
        if unsafe { (*bb).has_mem_phi } {
            opt_push_spaces(mut_view(*out), 8);
            opt_push_tok(mut_view(*out), 18); // "mem"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).mem_phi_result.v });
            opt_push_tok(mut_view(*out), 19); // " = MemoryPhi(["
            let pcnt = unsafe { (*bb).pred_count };
            let preds = unsafe { (*bb).preds };
            let minps = unsafe { (*bb).mem_phi_inputs };
            let mut k: usize = 0;
            while k < pcnt {
                if k > 0 {
                    opt_push_tok(mut_view(*out), 16); // ", "
                }
                opt_push_tok(mut_view(*out), 17); // "bb"
                diag_buf_push_u32(mut_view(*out), unsafe { (*opt_bbid_at(preds, k)).v });
                opt_push_tok(mut_view(*out), 20); // ": mem"
                diag_buf_push_u32(mut_view(*out), unsafe { (*opt_memid_at(minps, k)).v });
                k = k + 1;
            }
            opt_push_tok(mut_view(*out), 21); // "]);\n"
        }

        // Print scalar/SROA OptPhis
        let pcnt = unsafe { (*bb).phi_count };
        let phis = unsafe { (*bb).phis };
        let mut p: usize = 0;
        while p < pcnt {
            let phi = unsafe { opt_phi_at(phis, p) };
            opt_push_spaces(mut_view(*out), 8);
            diag_buf_push_byte(mut_view(*out), 118u8); // 'v'
            diag_buf_push_u32(mut_view(*out), unsafe { (*phi).result.v });
            opt_push_tok(mut_view(*out), 3); // ": type#"
            diag_buf_push_u32(mut_view(*out), unsafe { (*phi).ty.v });
            opt_push_tok(mut_view(*out), 22); // " = phi(_"
            diag_buf_push_u32(mut_view(*out), unsafe { (*phi).src_local.v });
            let pf = unsafe { (*phi).proj_field };
            if pf != OPT_PROJ_NONE {
                diag_buf_push_byte(mut_view(*out), 46u8); // '.'
                diag_buf_push_u32(mut_view(*out), pf);
            }
            opt_push_tok(mut_view(*out), 16); // ", "
            diag_buf_push_byte(mut_view(*out), 91u8); // '['
            let arity = unsafe { (*phi).arity };
            let iblks = unsafe { (*phi).incoming_blocks };
            let ivals = unsafe { (*phi).incoming_values };
            let mut k: usize = 0;
            while k < arity {
                if k > 0 {
                    opt_push_tok(mut_view(*out), 16); // ", "
                }
                opt_push_tok(mut_view(*out), 17); // "bb"
                diag_buf_push_u32(mut_view(*out), unsafe { (*opt_bbid_at(iblks, k)).v });
                opt_push_tok(mut_view(*out), 23); // ": v"
                diag_buf_push_u32(mut_view(*out), unsafe { (*opt_valid_at(ivals, k)).v });
                k = k + 1;
            }
            opt_push_tok(mut_view(*out), 21); // "]);\n"
            p = p + 1;
        }

        // Print instructions
        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            let opc = unsafe { (*inst).opcode };
            if opc != OPT_INST_NOP {
                opt_push_spaces(mut_view(*out), 8);
                let res_v = unsafe { (*inst).result.v };
                if res_v != OPT_VALUE_NONE {
                    diag_buf_push_byte(mut_view(*out), 118u8); // 'v'
                    diag_buf_push_u32(mut_view(*out), res_v);
                    opt_push_tok(mut_view(*out), 3); // ": type#"
                    diag_buf_push_u32(mut_view(*out), unsafe { (*inst).ty.v });
                    diag_buf_push_byte(mut_view(*out), 32u8);
                    diag_buf_push_byte(mut_view(*out), 61u8);
                    diag_buf_push_byte(mut_view(*out), 32u8);
                }
                let tok_op = 24 + (opc as usize);
                opt_push_tok(mut_view(*out), tok_op);
                if opc == OPT_INST_CONST {
                    let lhs_v = unsafe { (*inst).lhs.v };
                    let val_to_print = if lhs_v != OPT_VALUE_NONE { lhs_v } else { res_v };
                    opt_print_val_ref(mut_view(*out), view(*body), OptValueId { v: val_to_print });
                } else if opc == OPT_INST_COPY || opc == OPT_INST_UNOP || opc == OPT_INST_CAST {
                    opt_print_val_ref(mut_view(*out), view(*body), OptValueId { v: unsafe { (*inst).lhs.v } });
                } else if opc == OPT_INST_BINOP || opc == OPT_INST_CHECKED_BINOP || opc == OPT_INST_WRAPPING_BINOP {
                    opt_print_val_ref(mut_view(*out), view(*body), OptValueId { v: unsafe { (*inst).lhs.v } });
                    diag_buf_push_byte(mut_view(*out), 32u8);
                    mir_print_binop(mut_view(*out), unsafe { (*inst).sub_op });
                    diag_buf_push_byte(mut_view(*out), 32u8);
                    opt_print_val_ref(mut_view(*out), view(*body), OptValueId { v: unsafe { (*inst).rhs.v } });
                } else if opc == OPT_INST_AGGREGATE {
                    let eac = unsafe { (*inst).extra_arg_count };
                    let eargs = unsafe { (*inst).extra_args };
                    let mut ei: usize = 0;
                    while ei < eac {
                        if ei > 0 {
                            opt_push_tok(mut_view(*out), 16); // ", "
                        }
                        opt_print_val_ref(mut_view(*out), view(*body), OptValueId { v: unsafe { (*opt_valid_at(eargs, ei)).v } });
                        ei = ei + 1;
                    }
                    diag_buf_push_byte(mut_view(*out), 93u8); // ']'
                    diag_buf_push_byte(mut_view(*out), 41u8); // ')'
                } else if opc == OPT_INST_LOAD || opc == OPT_INST_EXTRACT_FIELD || opc == OPT_INST_ADDR_OF || opc == OPT_INST_LEN || opc == OPT_INST_DISCRIMINANT {
                    mir_print_place(mut_view(*out), unsafe { view((*inst).rhs_place) });
                } else if opc == OPT_INST_STORE || opc == OPT_INST_INSERT_FIELD || opc == OPT_INST_DROP_FLAG {
                    mir_print_place(mut_view(*out), unsafe { view((*inst).place) });
                    if (unsafe { (*inst).lhs.v }) != OPT_VALUE_NONE {
                        opt_push_tok(mut_view(*out), 16); // ", "
                        opt_print_val_ref(mut_view(*out), view(*body), OptValueId { v: unsafe { (*inst).lhs.v } });
                    }
                }
                opt_print_mem_annotations(
                    mut_view(*out),
                    MemSsaId { v: unsafe { (*inst).mem_use.v } },
                    MemSsaId { v: unsafe { (*inst).mem_def.v } }
                );
                opt_push_tok(mut_view(*out), 49); // ";\n"
            }
            i = i + 1;
        }

        // Print terminator
        opt_push_spaces(mut_view(*out), 8);
        let tk = unsafe { (*bb).term.kind };
        if tk == OPT_TERM_GOTO {
            opt_push_tok(mut_view(*out), 50); // "goto -> bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.true_bb.v });
        } else if tk == OPT_TERM_BRANCH {
            opt_push_tok(mut_view(*out), 51); // "branch v"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.cond.v });
            opt_push_tok(mut_view(*out), 52); // " -> [true: bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.true_bb.v });
            opt_push_tok(mut_view(*out), 53); // ", false: bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.false_bb.v });
            opt_push_tok(mut_view(*out), 47); // "]"
        } else if tk == OPT_TERM_SWITCH_INT {
            opt_push_tok(mut_view(*out), 54); // "switchInt(v"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.cond.v });
            opt_push_tok(mut_view(*out), 55); // ") -> ["
            let swc = unsafe { (*bb).term.switch_count };
            let svals = unsafe { (*bb).term.switch_vals };
            let stgts = unsafe { (*bb).term.switch_targets };
            let mut k: usize = 0;
            while k < swc {
                mir_buf_push_u64(mut_view(*out), unsafe { *opt_u64_at(svals, k) });
                opt_push_tok(mut_view(*out), 56); // ": bb"
                diag_buf_push_u32(mut_view(*out), unsafe { (*opt_bbid_at(stgts, k)).v });
                opt_push_tok(mut_view(*out), 16); // ", "
                k = k + 1;
            }
            opt_push_tok(mut_view(*out), 57); // "otherwise: bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.otherwise_bb.v });
            opt_push_tok(mut_view(*out), 47); // "]"
        } else if tk == OPT_TERM_RETURN {
            opt_push_tok(mut_view(*out), 58); // "return"
        } else if tk == OPT_TERM_CALL {
            opt_push_tok(mut_view(*out), 59); // "call v"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.callee.v });
            diag_buf_push_byte(mut_view(*out), 40u8); // '('
            let cac = unsafe { (*bb).term.call_arg_count };
            let cargs = unsafe { (*bb).term.call_args };
            let mut ci: usize = 0;
            while ci < cac {
                if ci > 0 {
                    opt_push_tok(mut_view(*out), 16); // ", "
                }
                opt_print_val_ref(mut_view(*out), view(*body), OptValueId { v: unsafe { (*opt_valid_at(cargs, ci)).v } });
                ci = ci + 1;
            }
            diag_buf_push_byte(mut_view(*out), 41u8); // ')'
            opt_push_tok(mut_view(*out), 52); // " -> [true: bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.true_bb.v });
            opt_push_tok(mut_view(*out), 47); // "]"
        } else if tk == OPT_TERM_ASSERT {
            opt_push_tok(mut_view(*out), 60); // "assert(v"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.cond.v });
            opt_push_tok(mut_view(*out), 55); // ") -> ["
            opt_push_tok(mut_view(*out), 17); // "bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.true_bb.v });
            opt_push_tok(mut_view(*out), 47); // "]"
        } else if tk == OPT_TERM_DROP {
            opt_push_tok(mut_view(*out), 61); // "drop "
            mir_print_place(mut_view(*out), unsafe { view((*bb).term.drop_place) });
            opt_push_tok(mut_view(*out), 52); // " -> [true: bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).term.true_bb.v });
            opt_push_tok(mut_view(*out), 47); // "]"
        } else {
            opt_push_tok(mut_view(*out), 62); // "unreachable"
        }
        opt_print_mem_annotations(
            mut_view(*out),
            MemSsaId { v: unsafe { (*bb).term.mem_use.v } },
            MemSsaId { v: unsafe { (*bb).term.mem_def.v } }
        );
        opt_push_tok(mut_view(*out), 49); // ";\n"
        opt_push_tok(mut_view(*out), 63); // "    }\n"
        b = b + 1;
    }

    // 3. Print ProofProvenance records
    let mut pr: usize = 0;
    while pr < body.provenance_count {
        let pv = unsafe { opt_prov_at(body.provenance, pr) };
        opt_push_tok(mut_view(*out), 64); // "    proof #"
        diag_buf_push_u32(mut_view(*out), pr as u32);
        opt_push_tok(mut_view(*out), 65); // ": prop="
        let pk = (unsafe { (*pv).prop_kind }) as usize;
        if pk <= 7 {
            opt_push_tok(mut_view(*out), 70 + pk);
        }
        opt_push_tok(mut_view(*out), 66); // " certainty="
        let ck = (unsafe { (*pv).certainty }) as usize;
        if ck <= 2 {
            opt_push_tok(mut_view(*out), 78 + ck);
        }
        opt_push_tok(mut_view(*out), 67); // " analysis="
        let ak = (unsafe { (*pv).source_analysis }) as usize;
        if ak <= 8 {
            opt_push_tok(mut_view(*out), 81 + ak);
        }
        opt_push_tok(mut_view(*out), 68); // " val=v"
        diag_buf_push_u32(mut_view(*out), unsafe { (*pv).subject_val.v });
        opt_push_tok(mut_view(*out), 69); // " bb=bb"
        diag_buf_push_u32(mut_view(*out), unsafe { (*pv).at_bb.v });
        diag_buf_push_byte(mut_view(*out), 10u8); // '\n'
        pr = pr + 1;
    }

    opt_push_tok(mut_view(*out), 102); // "}\n"
}

pub fn memssa_print(out: mut_view<DiagBuffer>, body: view<OptBody>) {
    opt_push_tok(mut_view(*out), 1); // "memssa_body {\n"
    opt_push_tok(mut_view(*out), 90); // "    mem0 = LiveOnEntry\n"

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        opt_push_tok(mut_view(*out), 7); // "    bb"
        diag_buf_push_u32(mut_view(*out), b as u32);
        opt_push_tok(mut_view(*out), 91); // " (mem_in: mem"
        diag_buf_push_u32(mut_view(*out), unsafe { (*bb).mem_in.v });
        opt_push_tok(mut_view(*out), 92); // ", mem_out: mem"
        diag_buf_push_u32(mut_view(*out), unsafe { (*bb).mem_out.v });
        opt_push_tok(mut_view(*out), 13); // ", df: ["
        opt_print_bb_list(mut_view(*out), unsafe { (*bb).dom_frontier }, unsafe { (*bb).dom_frontier_count });
        opt_push_tok(mut_view(*out), 14); // "]): {\n"

        if unsafe { (*bb).has_mem_phi } {
            opt_push_spaces(mut_view(*out), 8);
            opt_push_tok(mut_view(*out), 18); // "mem"
            diag_buf_push_u32(mut_view(*out), unsafe { (*bb).mem_phi_result.v });
            opt_push_tok(mut_view(*out), 19); // " = MemoryPhi(["
            let pcnt = unsafe { (*bb).pred_count };
            let preds = unsafe { (*bb).preds };
            let minps = unsafe { (*bb).mem_phi_inputs };
            let mut k: usize = 0;
            while k < pcnt {
                if k > 0 {
                    opt_push_tok(mut_view(*out), 16); // ", "
                }
                opt_push_tok(mut_view(*out), 17); // "bb"
                diag_buf_push_u32(mut_view(*out), unsafe { (*opt_bbid_at(preds, k)).v });
                opt_push_tok(mut_view(*out), 20); // ": mem"
                diag_buf_push_u32(mut_view(*out), unsafe { (*opt_memid_at(minps, k)).v });
                k = k + 1;
            }
            opt_push_tok(mut_view(*out), 21); // "]);\n"
        }

        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            let mu_v = unsafe { (*inst).mem_use.v };
            let md_v = unsafe { (*inst).mem_def.v };
            if mu_v != MEM_SSA_NONE {
                let rreg = optir_extract_memory_region(view(*body), unsafe { view((*inst).rhs_place) });
                let clob = memssa_find_clobbering_def(view(*body), MemSsaId { v: mu_v }, view(rreg), OPT_MAX_CERTAINTY_STEPS);
                opt_push_spaces(mut_view(*out), 8);
                opt_push_tok(mut_view(*out), 93); // "MemoryUse(mem"
                diag_buf_push_u32(mut_view(*out), mu_v);
                opt_push_tok(mut_view(*out), 94); // ") [clobber: mem"
                diag_buf_push_u32(mut_view(*out), clob.v);
                opt_push_tok(mut_view(*out), 95); // ", region: _"
                diag_buf_push_u32(mut_view(*out), rreg.base_local.v);
                opt_push_tok(mut_view(*out), 96); // "]\n"
            }
            if md_v != MEM_SSA_NONE && (md_v as usize) < body.mem_ssa_count {
                let dnode = unsafe { opt_memdef_at(body.mem_defs, md_v as usize) };
                opt_push_spaces(mut_view(*out), 8);
                opt_push_tok(mut_view(*out), 18); // "mem"
                diag_buf_push_u32(mut_view(*out), md_v);
                opt_push_tok(mut_view(*out), 97); // " = MemoryDef(mem"
                diag_buf_push_u32(mut_view(*out), unsafe { (*dnode).prev_mem.v });
                opt_push_tok(mut_view(*out), 98); // ") [region: _"
                diag_buf_push_u32(mut_view(*out), unsafe { (*dnode).region.base_local.v });
                opt_push_tok(mut_view(*out), 99); // ", barrier: "
                if unsafe { (*dnode).is_barrier } {
                    opt_push_tok(mut_view(*out), 100); // "true"
                } else {
                    opt_push_tok(mut_view(*out), 101); // "false"
                }
                opt_push_tok(mut_view(*out), 96); // "]\n"
            }
            i = i + 1;
        }

        let tmu_v = unsafe { (*bb).term.mem_use.v };
        let tmd_v = unsafe { (*bb).term.mem_def.v };
        if tmu_v != MEM_SSA_NONE {
            opt_push_spaces(mut_view(*out), 8);
            opt_push_tok(mut_view(*out), 93); // "MemoryUse(mem"
            diag_buf_push_u32(mut_view(*out), tmu_v);
            opt_push_tok(mut_view(*out), 94); // ") [clobber: mem"
            diag_buf_push_u32(mut_view(*out), tmu_v);
            opt_push_tok(mut_view(*out), 95); // ", region: _"
            diag_buf_push_u32(mut_view(*out), 0u32);
            opt_push_tok(mut_view(*out), 96); // "]\n"
        }
        if tmd_v != MEM_SSA_NONE && (tmd_v as usize) < body.mem_ssa_count {
            let dnode = unsafe { opt_memdef_at(body.mem_defs, tmd_v as usize) };
            opt_push_spaces(mut_view(*out), 8);
            opt_push_tok(mut_view(*out), 18); // "mem"
            diag_buf_push_u32(mut_view(*out), tmd_v);
            opt_push_tok(mut_view(*out), 97); // " = MemoryDef(mem"
            diag_buf_push_u32(mut_view(*out), unsafe { (*dnode).prev_mem.v });
            opt_push_tok(mut_view(*out), 98); // ") [region: _"
            diag_buf_push_u32(mut_view(*out), unsafe { (*dnode).region.base_local.v });
            opt_push_tok(mut_view(*out), 99); // ", barrier: "
            opt_push_tok(mut_view(*out), 100); // "true"
            opt_push_tok(mut_view(*out), 96); // "]\n"
        }

        opt_push_tok(mut_view(*out), 63); // "    }\n"
        b = b + 1;
    }

    // Print memory-related ProofProvenance records
    let mut pr: usize = 0;
    while pr < body.provenance_count {
        let pv = unsafe { opt_prov_at(body.provenance, pr) };
        let pk = unsafe { (*pv).prop_kind };
        if pk == PROP_NO_ALIAS || pk == PROP_DEAD_STORE {
            opt_push_tok(mut_view(*out), 64); // "    proof #"
            diag_buf_push_u32(mut_view(*out), pr as u32);
            opt_push_tok(mut_view(*out), 65); // ": prop="
            opt_push_tok(mut_view(*out), 70 + (pk as usize));
            opt_push_tok(mut_view(*out), 66); // " certainty="
            let ck = (unsafe { (*pv).certainty }) as usize;
            if ck <= 2 {
                opt_push_tok(mut_view(*out), 78 + ck);
            }
            opt_push_tok(mut_view(*out), 67); // " analysis="
            let ak = (unsafe { (*pv).source_analysis }) as usize;
            if ak <= 8 {
                opt_push_tok(mut_view(*out), 81 + ak);
            }
            opt_push_tok(mut_view(*out), 68); // " val=v"
            diag_buf_push_u32(mut_view(*out), unsafe { (*pv).subject_val.v });
            opt_push_tok(mut_view(*out), 69); // " bb=bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*pv).at_bb.v });
            diag_buf_push_byte(mut_view(*out), 10u8); // '\n'
        }
        pr = pr + 1;
    }

    opt_push_tok(mut_view(*out), 102); // "}\n"
}

// --- Top-Level Lowering & Entry Gate (AXS-OPT-001) ---

pub fn optir_build_from_verified_mir(
    mir_body: view<MirBody>,
    thir: *const Thir,
    arena: mut_view<Arena>
) -> *mut OptBody {
    if mir_body.bb_count == 0 {
        return 0 as *mut OptBody;
    }
    let body_ptr = arena_alloc_raw(mut_view(*arena), size_of<OptBody>(), align_of<OptBody>()) as *mut OptBody;
    let orig_copy = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    unsafe {
        (*orig_copy).sym = SymbolId { v: mir_body.sym.v };
        (*orig_copy).fn_sym = SymbolId { v: mir_body.fn_sym.v };
        (*orig_copy).fn_name = StrId { v: mir_body.fn_name.v };
        (*orig_copy).span = Span {
            file: FileId { v: mir_body.span.file.v },
            start: mir_body.span.start,
            end: mir_body.span.end,
        };
        (*orig_copy).locals = mir_body.locals;
        (*orig_copy).local_count = mir_body.local_count;
        (*orig_copy).local_cap = mir_body.local_cap;
        (*orig_copy).arg_count = mir_body.arg_count;
        (*orig_copy).bbs = mir_body.bbs;
        (*orig_copy).bb_count = mir_body.bb_count;
        (*orig_copy).bb_cap = mir_body.bb_cap;
        (*orig_copy).drop_flag_count = mir_body.drop_flag_count;
        (*body_ptr).fn_sym = SymbolId { v: mir_body.fn_sym.v };
        (*body_ptr).fn_name = StrId { v: mir_body.fn_name.v };
        (*body_ptr).span = Span {
            file: FileId { v: mir_body.span.file.v },
            start: mir_body.span.start,
            end: mir_body.span.end,
        };
        (*body_ptr).arg_count = mir_body.arg_count;
        (*body_ptr).local_count = 0;
        (*body_ptr).local_tys = 0 as *mut TypeId;
        (*body_ptr).local_modes = 0 as *mut u8;
        (*body_ptr).local_addr_taken = 0 as *mut bool;
        (*body_ptr).local_dropped = 0 as *mut bool;
        (*body_ptr).local_sroa_base = 0 as *mut u32;
        (*body_ptr).local_sroa_count = 0 as *mut u32;
        (*body_ptr).slot_count = 0;
        (*body_ptr).slot_local = 0 as *mut u32;
        (*body_ptr).slot_field = 0 as *mut u32;
        (*body_ptr).slot_ty = 0 as *mut TypeId;
        (*body_ptr).blocks = 0 as *mut OptBlock;
        (*body_ptr).bb_count = 0;
        (*body_ptr).rpo_order = 0 as *mut OptBbId;
        (*body_ptr).rpo_count = 0;
        (*body_ptr).values = 0 as *mut OptValue;
        (*body_ptr).value_count = 0;
        (*body_ptr).value_cap = 0;
        (*body_ptr).ranges = 0 as *mut OptRange;
        (*body_ptr).inst_count = 0;
        (*body_ptr).mem_defs = 0 as *mut MemSsaDefNode;
        (*body_ptr).mem_ssa_count = 0;
        (*body_ptr).mem_ssa_cap = 0;
        (*body_ptr).provenance = 0 as *mut ProofProvenance;
        (*body_ptr).provenance_count = 0;
        (*body_ptr).provenance_cap = 0;
        (*body_ptr).thir = thir;
        (*body_ptr).orig_mir = orig_copy as *const MirBody;
    }

    optir_classify_locals(unsafe { mut_view(*body_ptr) }, unsafe { view(*orig_copy) }, mut_view(*arena));
    optir_lower_mir_blocks(unsafe { mut_view(*body_ptr) }, unsafe { view(*orig_copy) }, mut_view(*arena));
    optir_compute_cfg(unsafe { mut_view(*body_ptr) }, mut_view(*arena));
    optir_compute_dominators(unsafe { mut_view(*body_ptr) }, mut_view(*arena));
    optir_compute_dom_frontier(unsafe { mut_view(*body_ptr) }, mut_view(*arena));
    optir_construct_ssa(unsafe { mut_view(*body_ptr) }, mut_view(*arena));
    optir_construct_memssa(unsafe { mut_view(*body_ptr) }, mut_view(*arena));
    optir_analyze_ranges_and_provenance(unsafe { mut_view(*body_ptr) }, mut_view(*arena), OPT_MAX_CERTAINTY_STEPS);
    body_ptr
}

pub fn optir_build_from_mir(
    mir_body: view<MirBody>,
    thir: *const Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    fn_item: *const HirItem
) -> *mut OptBody {
    // AXS-OPT-001 Entry Gate: Only Verified MIR may be lowered to OptIR
    let prev_errs = sink.errors;
    verify_mir(view(*mir_body), thir, mut_view(*sink), fn_item);
    if sink.errors != prev_errs || mir_body.bb_count == 0 {
        return 0 as *mut OptBody;
    }
    optir_build_from_verified_mir(view(*mir_body), thir, arena)
}

pub fn optir_inspect_mir_text(
    mir_text: StrView,
    emit_memssa: bool,
    verify_each: bool,
    out: mut_view<DiagBuffer>,
    sink: mut_view<DiagSink>,
    arena: mut_view<Arena>
) -> bool {
    let mptr = mir_text.ptr;
    let mlen = mir_text.len;
    let sv1 = StrView { ptr: mptr, len: mlen };
    let sv2 = StrView { ptr: mptr, len: mlen };
    let prev_errs = sink.errors;
    if !verify_mir_text(sv1, mut_view(*sink)) || sink.errors != prev_errs {
        return false;
    }
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));
    let mbody = verify_parse_mir(
        sv2,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(*arena)
    );
    if (mbody as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return false;
    }
    let obody = optir_build_from_mir(
        unsafe { view(*mbody) },
        thir_ptr as *const Thir,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    );
    if (obody as usize) == 0 || sink.errors != prev_errs {
        opt_free_minimal_thir(thir_ptr);
        return false;
    }
    if verify_each {
        if !optir_verify_contract(unsafe { view(*obody) }) {
            opt_free_minimal_thir(thir_ptr);
            return false;
        }
        let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
        if !optir_reconstruct_mir(unsafe { view(*obody) }, unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
            opt_free_minimal_thir(thir_ptr);
            return false;
        }
        verify_mir(unsafe { view(*rec_mir) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
        if sink.errors != prev_errs {
            opt_free_minimal_thir(thir_ptr);
            return false;
        }
    }
    if emit_memssa {
        memssa_print(mut_view(*out), unsafe { view(*obody) });
    } else {
        optir_print(mut_view(*out), unsafe { view(*obody) });
    }
    opt_free_minimal_thir(thir_ptr);
    true
}
