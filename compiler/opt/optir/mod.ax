    pub const_val: MirConst,
    pub origin: OptOrigin,
}

pub struct OptPhi {
    pub result: OptValueId,
    pub ty: TypeId,
    pub src_local: MirLocalId,
    pub proj_field: u32,
    pub slot_idx: u32,
    pub incoming_values: *mut OptValueId,
    pub incoming_blocks: *mut OptBbId,
    pub arity: usize,
    pub origin: OptOrigin,
}

pub struct OptInst {
    pub id: OptInstId,
    pub opcode: u8,
    pub sub_op: u8,
    pub flags: u16,
    pub result: OptValueId,
    pub ty: TypeId,
    pub lhs: OptValueId,
    pub rhs: OptValueId,
    pub extra_args: *mut OptValueId,
    pub extra_arg_count: usize,
    pub place: MirPlace,
    pub rhs_place: MirPlace,
    pub mem_use: MemSsaId,
    pub mem_def: MemSsaId,
    pub origin: OptOrigin,
    pub orig_stmt: MirStmt,
}

pub struct OptTerminator {
    pub kind: u8,
    pub cond: OptValueId,
    pub true_bb: OptBbId,
    pub false_bb: OptBbId,
    pub switch_ty: TypeId,
    pub switch_vals: *mut u64,
    pub switch_targets: *mut OptBbId,
    pub switch_count: usize,
    pub otherwise_bb: OptBbId,
    pub callee: OptValueId,
    pub call_args: *mut OptValueId,
    pub call_arg_count: usize,
    pub call_result: OptValueId,
    pub call_dest: MirPlace,
    pub has_call_dest: bool,
    pub unwind_bb: OptBbId,
    pub drop_place: MirPlace,
    pub drop_flag: u32,
    pub drop_is_explicit: bool,
    pub assert_expected: bool,
    pub assert_msg_ptr: *const u8,
    pub assert_msg_len: usize,
    pub mem_use: MemSsaId,
    pub mem_def: MemSsaId,
    pub origin: OptOrigin,
    pub orig_term: MirTerminator,
}

