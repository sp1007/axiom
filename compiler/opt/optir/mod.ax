}

// --- Pointer Indexing Helpers ---

fn opt_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn opt_u8_at(base: *mut u8, idx: usize) -> *mut u8 {
    ((base as usize) + idx) as *mut u8
}

pub unsafe fn opt_bool_at(base: *mut bool, idx: usize) -> *mut bool {
    let off = ((idx as isize) * (size_of<bool>() as isize)) as usize;
    ((base as usize) + off) as *mut bool
}

pub unsafe fn opt_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = ((idx as isize) * (size_of<u32>() as isize)) as usize;
    ((base as usize) + off) as *mut u32
}

