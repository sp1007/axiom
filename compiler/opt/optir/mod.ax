    ((base as usize) + off) as *mut MemSsaId
}

pub unsafe fn opt_val_at(base: *mut OptValue, idx: usize) -> *mut OptValue {
    let off = ((idx as isize) * (size_of<OptValue>() as isize)) as usize;
    ((base as usize) + off) as *mut OptValue
