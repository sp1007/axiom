const SLP_STR_OFF: [25]u32 = [
    0u32, 16u32, 28u32, 46u32, 56u32, 63u32, 80u32, 92u32,
    104u32, 113u32, 123u32, 130u32, 141u32, 147u32, 154u32, 162u32,
    175u32, 185u32, 196u32, 210u32, 222u32, 225u32, 243u32, 245u32,
    251u32
];

fn slp_push_str(buf: mut_view<DiagBuffer>, idx: usize) {
    let start = SLP_STR_OFF[idx] as usize;
    let end = SLP_STR_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*buf), SLP_STR_DATA[i]);
        i = i + 1;
    }
}

pub fn slp_vec_print(stats: view<SlpVecStats>, buf: mut_view<DiagBuffer>) {
    slp_push_str(mut_view(*buf), 0);
    slp_push_str(mut_view(*buf), 1);
    diag_buf_push_u32(mut_view(*buf), stats.pass_runs);
    slp_push_str(mut_view(*buf), 2);
    diag_buf_push_u32(mut_view(*buf), stats.trees_vectorized);
    slp_push_str(mut_view(*buf), 3);
    diag_buf_push_u32(mut_view(*buf), stats.trees_rejected);
    slp_push_str(mut_view(*buf), 4);
    diag_buf_push_u32(mut_view(*buf), stats.lanes_packed_total);

    slp_push_str(mut_view(*buf), 5);
    diag_buf_push_u32(mut_view(*buf), stats.store_chains_vectorized);
    slp_push_str(mut_view(*buf), 6);
    diag_buf_push_u32(mut_view(*buf), stats.reductions_vectorized);
    slp_push_str(mut_view(*buf), 7);
    diag_buf_push_u32(mut_view(*buf), stats.broadcast_nodes_emitted);
    slp_push_str(mut_view(*buf), 8);
    diag_buf_push_u32(mut_view(*buf), stats.gather_packs_emitted);
    slp_push_str(mut_view(*buf), 9);
    diag_buf_push_u32(mut_view(*buf), stats.external_extracts_emitted);

    let mut r: usize = 0;
    while r < stats.record_count && (stats.records as usize) != 0 {
        let rec = unsafe { slp_vec_record_at(stats.records, r) };
        slp_push_str(mut_view(*buf), 10);
        diag_buf_push_u32(mut_view(*buf), unsafe { (*rec).bb_id.v });
        slp_push_str(mut_view(*buf), 11);
        diag_buf_push_u32(mut_view(*buf), if unsafe { (*rec).applied } { 1u32 } else { 0u32 });
        slp_push_str(mut_view(*buf), 12);
        diag_buf_push_u32(mut_view(*buf), (unsafe { (*rec).seed_kind }) as u32);
        slp_push_str(mut_view(*buf), 4);
        diag_buf_push_u32(mut_view(*buf), (unsafe { (*rec).lane_count }) as u32);
        slp_push_str(mut_view(*buf), 13);
        diag_buf_push_u32(mut_view(*buf), (unsafe { (*rec).node_count }) as u32);
        slp_push_str(mut_view(*buf), 15);
        diag_buf_push_u32(mut_view(*buf), unsafe { (*rec).scalar_cost });
        slp_push_str(mut_view(*buf), 16);
        diag_buf_push_u32(mut_view(*buf), unsafe { (*rec).vec_cost });
        slp_push_str(mut_view(*buf), 14);
        diag_buf_push_u32(mut_view(*buf), (unsafe { (*rec).reason }) as u32);
        r = r + 1;
    }

    slp_push_str(mut_view(*buf), 20);
}

pub fn slp_vec_cost_print(est: view<SlpCostEstimate>, buf: mut_view<DiagBuffer>) {
    slp_push_str(mut_view(*buf), 21);
    slp_push_str(mut_view(*buf), 10);
    diag_buf_push_u32(mut_view(*buf), est.bb_id.v);
    slp_push_str(mut_view(*buf), 22);
    slp_push_str(mut_view(*buf), 12);
    diag_buf_push_u32(mut_view(*buf), est.seed_kind as u32);
    slp_push_str(mut_view(*buf), 4);
    diag_buf_push_u32(mut_view(*buf), est.lane_count as u32);
    slp_push_str(mut_view(*buf), 13);
    diag_buf_push_u32(mut_view(*buf), est.node_count as u32);
    slp_push_str(mut_view(*buf), 15);
    diag_buf_push_u32(mut_view(*buf), est.scalar_cost);
    slp_push_str(mut_view(*buf), 16);
    diag_buf_push_u32(mut_view(*buf), est.total_vec_cost);
    slp_push_str(mut_view(*buf), 17);
    diag_buf_push_u32(mut_view(*buf), est.pack_cost);
    slp_push_str(mut_view(*buf), 18);
    diag_buf_push_u32(mut_view(*buf), est.extract_cost);
    slp_push_str(mut_view(*buf), 23);
    diag_buf_push_u32(mut_view(*buf), est.confidence as u32);
    slp_push_str(mut_view(*buf), 19);
    diag_buf_push_u32(mut_view(*buf), if est.profitable { 1u32 } else { 0u32 });
    slp_push_str(mut_view(*buf), 14);
    diag_buf_push_u32(mut_view(*buf), est.reject_reason as u32);
    slp_push_str(mut_view(*buf), 20);
}
