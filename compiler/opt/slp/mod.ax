    115u8, 108u8, 112u8, 95u8, 118u8, 101u8, 99u8, 116u8, 111u8, 114u8, 95u8, 99u8, 111u8, 115u8, 116u8, 32u8, 123u8, 10u8,
    // 22: "]:" (2)
    93u8, 58u8,
    // 23: " conf=" (6)
