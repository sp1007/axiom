@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

const SC_ALL_ONES_U64: u64 = 0xFFFFFFFFFFFFFFFFu64;
const SC_SIGN64_U64: u64 = 0x8000000000000000u64;

// --- Wegman-Zadeck SCCP Lattice Constants (AXS-OPT-045) ---

pub const SCCP_TOP: u8 = 0u8;
pub const SCCP_CONST: u8 = 1u8;
pub const SCCP_OVERDEFINED: u8 = 2u8;

// --- Explicit Intrinsic Semantic Identity Contracts (REQ-OPT-351, REQ-OPT-011, REQ-OPT-352..353) ---

pub const INTRINSIC_SEM_NONE: u8 = 0u8;
pub const INTRINSIC_SEM_BLACK_BOX: u8 = 1u8;
pub const INTRINSIC_SEM_ZEROIZE: u8 = 2u8;
pub const INTRINSIC_SEM_VOLATILE_LOAD: u8 = 3u8;
pub const INTRINSIC_SEM_VOLATILE_STORE: u8 = 4u8;
pub const INTRINSIC_SEM_ATOMIC: u8 = 5u8;
pub const INTRINSIC_SEM_WRAPPING_ARITH: u8 = 6u8;
pub const INTRINSIC_SEM_CHECKED_ARITH: u8 = 7u8;
pub const INTRINSIC_SEM_PURE_CALL: u8 = 8u8;
pub const INTRINSIC_SEM_EXPLICIT_CLONE_OR_IMPURE: u8 = 9u8;

// --- Scalar Optimization Telemetry & Counters ---

@derive(Copy)
pub struct ScalarOptStats {
    pub sccp_consts_folded: u32,
    pub sccp_branches_folded: u32,
    pub sccp_blocks_pruned: u32,
    pub inst_combine_rewrites: u32,
    pub gvn_cse_eliminated: u32,
    pub gvn_loads_forwarded: u32,
    pub gvn_pure_calls_eliminated: u32,
    pub dce_insts_eliminated: u32,
    pub dce_dead_stores_eliminated: u32,
    pub dce_move_copy_elided: u32,
    pub cfg_edges_simplified: u32,
    pub rejected_candidates: u32,
}

pub fn scalar_stats_zero(stats: mut_view<ScalarOptStats>) {
    stats.sccp_consts_folded = 0u32;
    stats.sccp_branches_folded = 0u32;
    stats.sccp_blocks_pruned = 0u32;
    stats.inst_combine_rewrites = 0u32;
    stats.gvn_cse_eliminated = 0u32;
    stats.gvn_loads_forwarded = 0u32;
    stats.gvn_pure_calls_eliminated = 0u32;
    stats.dce_insts_eliminated = 0u32;
    stats.dce_dead_stores_eliminated = 0u32;
    stats.dce_move_copy_elided = 0u32;
    stats.cfg_edges_simplified = 0u32;
    stats.rejected_candidates = 0u32;
}

const GVN_KIND_SCALAR: u8 = 1u8;
const GVN_KIND_CHECKED_ASSERTED: u8 = 2u8;
const GVN_KIND_LOAD: u8 = 3u8;
const GVN_KIND_PURE_CALL: u8 = 4u8;

@derive(Copy)
struct GvnEntry {
    kind: u8,
    opcode: u8,
    sub_op: u8,
    is_comm: bool,
    ty_v: u32,
    op0: u32,
    op1: u32,
    op2: u32,
    op3: u32,
    arg_cnt: u32,
    mem_ver: u32,
    def_bb: u32,
    def_inst_idx: u32,
    def_val: u32,
    def_local: u32,
}

fn sc_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

unsafe fn sc_gvn_at(base: *mut GvnEntry, idx: usize) -> *mut GvnEntry {
    let off = ((idx as isize) * (size_of<GvnEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut GvnEntry
}

unsafe fn sc_inst_grow_push(bb: mut_view<OptBlock>, arena: mut_view<Arena>, src_inst: *const OptInst) {
    let cur = bb.inst_count;
    if cur >= bb.inst_cap {
        let ncap: usize = if bb.inst_cap == 0 { 8 } else { bb.inst_cap + bb.inst_cap };
        let nbytes = sc_mul_usize(ncap, size_of<OptInst>());
        let narr = arena_alloc_raw(mut_view(*arena), nbytes, align_of<OptInst>()) as *mut OptInst;
        if cur > 0 && (bb.insts as usize) != 0 {
            let obytes = sc_mul_usize(cur, size_of<OptInst>());
            ptr_copy_nonoverlapping<u8>(bb.insts as *const u8, narr as *mut u8, obytes);
        }
        bb.insts = narr;
        bb.inst_cap = ncap;
    }
    let dst = opt_inst_at(bb.insts, cur);
    ptr_copy_nonoverlapping<u8>(src_inst as *const u8, dst as *mut u8, size_of<OptInst>());
    bb.inst_count = cur + 1;
}

// --- Explicit Semantic Intrinsic Contract Classifier (REQ-OPT-351) ---

pub fn scalar_classify_inst_intrinsic(inst: view<OptInst>) -> u8 {
    let opc = inst.opcode;
    if opc == OPT_INST_BLACK_BOX {
        return INTRINSIC_SEM_BLACK_BOX;
    }
    if opc == OPT_INST_ZEROIZE {
        return INTRINSIC_SEM_ZEROIZE;
    }
    if opc == OPT_INST_VOLATILE_LOAD {
        return INTRINSIC_SEM_VOLATILE_LOAD;
    }
    if opc == OPT_INST_VOLATILE_STORE {
        return INTRINSIC_SEM_VOLATILE_STORE;
    }
    if opc == OPT_INST_ATOMIC {
        return INTRINSIC_SEM_ATOMIC;
    }
    if opc == OPT_INST_WRAPPING_BINOP {
        return INTRINSIC_SEM_WRAPPING_ARITH;
    }
    if opc == OPT_INST_CHECKED_BINOP {
        return INTRINSIC_SEM_CHECKED_ARITH;
    }
    INTRINSIC_SEM_NONE
}

pub fn scalar_classify_call_intrinsic(
    body: view<OptBody>,
    term: view<OptTerminator>,
    call_table: *const EffectCallTable
) -> u8 {
    if term.kind != OPT_TERM_CALL {
        return INTRINSIC_SEM_NONE;
    }
    let csum = effect_infer_term_with_table(body, term, call_table);
    if effect_summary_is_pure(view(csum)) {
        return INTRINSIC_SEM_PURE_CALL;
    }
    if (csum.flags & EFFECT_ATOMIC) != 0u16 {
        return INTRINSIC_SEM_ATOMIC;
    }
    if (csum.flags & EFFECT_VOLATILE) != 0u16 {
        if (csum.flags & EFFECT_READS_MEM) != 0u16 && (csum.flags & EFFECT_WRITES_MEM) != 0u16 {
            return INTRINSIC_SEM_BLACK_BOX;
        }
        if (csum.flags & EFFECT_WRITES_MEM) != 0u16 {
            return INTRINSIC_SEM_ZEROIZE;
        }
        return INTRINSIC_SEM_VOLATILE_LOAD;
    }
    // Explicit Clone and any non-pure call remain semantically observable (REQ-OPT-306)
    INTRINSIC_SEM_EXPLICIT_CLONE_OR_IMPURE
}

// --- Type, Float-Hazard, and Constant Evaluation Helpers (REQ-OPT-363..364, REQ-OPT-397) ---

fn scalar_type_kind(thir: *const Thir, ty: TypeId) -> u8 {
    if (thir as usize) != 0 && ty.v != 0u32 {
        let types_ptr = unsafe { (*thir).interner.types };
        if (types_ptr as usize) != 0 {
            let ax = type_get(unsafe { view((*thir).interner) }, (TypeId { v: ty.v }));
            if (ax as usize) != 0 {
                return unsafe { (*ax).kind };
            }
        }
    }
    0u8
}

fn scalar_type_is_bool_ty(thir: *const Thir, ty: TypeId) -> bool {
    scalar_type_kind(thir, (TypeId { v: ty.v })) == TY_BOOL || opt_type_is_bool(thir, (TypeId { v: ty.v }))
}

pub fn scalar_type_is_discrete(thir: *const Thir, ty: TypeId) -> bool {
    if scalar_type_is_bool_ty(thir, (TypeId { v: ty.v })) {
        return true;
    }
    let tk = scalar_type_kind(thir, (TypeId { v: ty.v }));
    if tk == TY_CHAR || tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE ||
       tk == TY_U8 || tk == TY_U16 || tk == TY_U32 || tk == TY_U64 || tk == TY_USIZE {
        return true;
    }
    let bits = opt_type_bits(thir, (TypeId { v: ty.v }));
    bits == 8u32 || bits == 16u32 || bits == 32u32 || bits == 64u32
}

fn scalar_type_is_copy_safe(thir: *const Thir, ty: TypeId) -> bool {
    if scalar_type_is_discrete(thir, (TypeId { v: ty.v })) {
        return true;
    }
    let tk = scalar_type_kind(thir, (TypeId { v: ty.v }));
    tk == TY_UNIT || tk == TY_PTR || tk == TY_VIEW || tk == TY_FN
}

pub fn scalar_raw_val_has_fp_hazard(pm: view<PassManager>, body: view<OptBody>, val_id: OptValueId) -> bool {
    if val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count {
        return false;
    }
    if pm_value_has_fp_hazard(view(*pm), view(*body), (OptValueId { v: val_id.v })) {
        return true;
    }
    if (body.ranges as usize) != 0 {
        let rp = unsafe { opt_range_at(body.ranges, val_id.v as usize) };
        if unsafe { (*rp).has_fp_hazard } {
            return true;
        }
    }
    false
}

fn scalar_val_ty(body: view<OptBody>, val_id: OptValueId, fallback_ty: TypeId) -> TypeId {
    if val_id.v != OPT_VALUE_NONE && (val_id.v as usize) <= body.value_count && (body.values as usize) != 0 {
        let vp = unsafe { opt_val_at(body.values, val_id.v as usize) };
        let tv = unsafe { (*vp).ty.v };
        if tv != 0u32 {
            return (TypeId { v: tv });
        }
    }
    (TypeId { v: fallback_ty.v })
}

fn scalar_alloc_const_value(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    ty: TypeId,
    cval: u64,
    bb_v: u32,
    inst_v: u32,
    pass_id: u16
) -> OptValueId {
    let old_vcnt = body.value_count;
    let is_b = scalar_type_is_bool_ty(body.thir, (TypeId { v: ty.v }));
    let ckind: u8 = if is_b { MIR_CONST_BOOL } else { MIR_CONST_INT };
    let norm_val: u64 = if is_b {
        if cval != 0u64 { 1u64 } else { 0u64 }
    } else {
        let bits = opt_type_bits(body.thir, (TypeId { v: ty.v }));
        if bits > 0u32 && bits <= 64u32 { cval & opt_bit_mask(bits) } else { cval }
    };
    let mc = MirConst {
        ty: (TypeId { v: ty.v }),
        kind: ckind,
        val: norm_val,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: (SymbolId { v: 0u32 }),
    };
    let orig = OptOrigin {
        span: Span {
            file: (FileId { v: body.span.file.v }),
            start: body.span.start,
            end: body.span.end,
        },
        mir_bb: (MirBbId { v: bb_v }),
        mir_stmt_idx: 0u32,
        pass_id: pass_id,
    };
    let vid = optir_alloc_value(
        mut_view(*body),
        mut_view(*arena),
        (TypeId { v: ty.v }),
        OPT_VAL_CONST,
        (OptBbId { v: bb_v }),
        (OptInstId { v: inst_v }),
        (MirLocalId { v: 0u32 }),
        OPT_PROJ_NONE,
        view(mc),
        view(orig)
    );
    if (body.ranges as usize) != 0 {
        let ncap = body.value_count + 4;
        let nbytes = sc_mul_usize(ncap, size_of<OptRange>());
        let nranges = arena_alloc_raw(mut_view(*arena), nbytes, align_of<OptRange>()) as *mut OptRange;
        let copy_cnt = old_vcnt + 1;
        let obytes = sc_mul_usize(copy_cnt, size_of<OptRange>());
        unsafe {
            ptr_copy_nonoverlapping<u8>(body.ranges as *const u8, nranges as *mut u8, obytes);
        }
        let mut idx: usize = copy_cnt;
        while idx < ncap {
            let rp = unsafe { opt_range_at(nranges, idx) };
            unsafe {
                (*rp).has_range = false;
                (*rp).is_signed = opt_type_is_signed(body.thir, (TypeId { v: ty.v }));
                (*rp).lo = 0u64;
                (*rp).hi = 0u64;
                (*rp).non_zero_certainty = CERTAINTY_UNKNOWN;
                (*rp).has_fp_hazard = false;
            }
            idx = idx + 1;
        }
        if (vid.v as usize) < ncap {
            let vrp = unsafe { opt_range_at(nranges, vid.v as usize) };
            unsafe {
                (*vrp).has_range = true;
                (*vrp).lo = norm_val;
                (*vrp).hi = norm_val;
                (*vrp).non_zero_certainty = if norm_val != 0u64 { CERTAINTY_PROVEN } else { CERTAINTY_UNKNOWN };
                (*vrp).has_fp_hazard = false;
            }
        }
        body.ranges = nranges;
    }
    vid
}

fn scalar_is_commutative_binop(sub: u8) -> bool {
    sub == MIR_BINOP_ADD || sub == MIR_BINOP_MUL ||
    sub == MIR_BINOP_WRAPPING_ADD || sub == MIR_BINOP_WRAPPING_MUL ||
    sub == MIR_BINOP_BIT_AND || sub == MIR_BINOP_BIT_OR || sub == MIR_BINOP_BIT_XOR ||
    sub == MIR_BINOP_EQ || sub == MIR_BINOP_NE
}

fn scalar_eval_const_binop(
    thir: *const Thir,
    opc: u8,
    sub: u8,
    lhs_ty: TypeId,
    rhs_ty: TypeId,
    res_ty: TypeId,
    lv: u64,
    rv: u64,
    out_val: mut_view<u64>,
    out_ovf: mut_view<bool>
) -> bool {
    *out_ovf = false;
    let lhs_bits = opt_type_bits(thir, (TypeId { v: lhs_ty.v }));
    if lhs_bits == 0u32 || lhs_bits > 64u32 {
        return false;
    }
    let mask = opt_bit_mask(lhs_bits);
    let is_signed = opt_type_is_signed(thir, (TypeId { v: lhs_ty.v }));
    let is_bool_op = scalar_type_is_bool_ty(thir, (TypeId { v: lhs_ty.v }));
    let is_bool_res = scalar_type_is_bool_ty(thir, (TypeId { v: res_ty.v }));
    let a_u = lv & mask;
    let b_u = rv & mask;
    let a_tc = opt_sign_extend_u64(a_u, lhs_bits);
    let b_tc = opt_sign_extend_u64(b_u, lhs_bits);

    if sub == MIR_BINOP_EQ {
        *out_val = if a_u == b_u { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_NE {
        *out_val = if a_u != b_u { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_LT {
        let cmp = if is_signed { opt_signed_lt(a_tc, b_tc) } else { a_u < b_u };
        *out_val = if cmp { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_LE {
        let cmp = if is_signed { opt_signed_le(a_tc, b_tc) } else { a_u <= b_u };
        *out_val = if cmp { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_GT {
        let cmp = if is_signed { opt_signed_lt(b_tc, a_tc) } else { a_u > b_u };
        *out_val = if cmp { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_GE {
        let cmp = if is_signed { opt_signed_le(b_tc, a_tc) } else { a_u >= b_u };
        *out_val = if cmp { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_BIT_AND {
        let raw = (a_u & b_u) & mask;
        *out_val = if is_bool_res { if raw != 0u64 { 1u64 } else { 0u64 } } else { raw };
        return true;
    }
    if sub == MIR_BINOP_BIT_OR {
        let raw = (a_u | b_u) & mask;
        *out_val = if is_bool_res { if raw != 0u64 { 1u64 } else { 0u64 } } else { raw };
        return true;
    }
    if sub == MIR_BINOP_BIT_XOR {
        let raw = (a_u ^ b_u) & mask;
        *out_val = if is_bool_res { if raw != 0u64 { 1u64 } else { 0u64 } } else { raw };
        return true;
    }
    if is_bool_op {
        return false;
    }

    if sub == MIR_BINOP_WRAPPING_ADD || (opc == OPT_INST_WRAPPING_BINOP && sub == MIR_BINOP_ADD) {
        *out_val = opt_wrapping_add_u64(a_u, b_u) & mask;
        return true;
    }
    if sub == MIR_BINOP_WRAPPING_SUB || (opc == OPT_INST_WRAPPING_BINOP && sub == MIR_BINOP_SUB) {
        let neg_b = opt_twos_complement_u64(b_u);
        *out_val = opt_wrapping_add_u64(a_u, neg_b) & mask;
        return true;
    }
    if sub == MIR_BINOP_WRAPPING_MUL || (opc == OPT_INST_WRAPPING_BINOP && sub == MIR_BINOP_MUL) {
        let mut raw_prod: u64 = 0u64;
        let _ = opt_checked_mul_u64_raw(a_u, b_u, mut_view(raw_prod));
        *out_val = raw_prod & mask;
        return true;
    }

    if sub == MIR_BINOP_ADD {
        if is_signed {
            *out_ovf = opt_checked_add_signed(a_tc, b_tc, lhs_bits, out_val);
        } else {
            *out_ovf = opt_checked_add_u64(a_u, b_u, lhs_bits, out_val);
        }
        return true;
    }
    if sub == MIR_BINOP_SUB {
        if is_signed {
            *out_ovf = opt_checked_sub_signed(a_tc, b_tc, lhs_bits, out_val);
        } else {
            *out_ovf = opt_checked_sub_u64(a_u, b_u, lhs_bits, out_val);
        }
        return true;
    }
    if sub == MIR_BINOP_MUL {
        if is_signed {
            *out_ovf = opt_checked_mul_signed(a_tc, b_tc, lhs_bits, out_val);
        } else {
            *out_ovf = opt_checked_mul_u64(a_u, b_u, lhs_bits, out_val);
        }
        return true;
    }
    if sub == MIR_BINOP_DIV {
        if is_signed {
            let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(lhs_bits), lhs_bits);
            if b_tc == 0u64 || (a_tc == min_tc && b_tc == SC_ALL_ONES_U64) {
                *out_val = 0u64;
                *out_ovf = true;
            } else {
                let a_neg = (a_tc & SC_SIGN64_U64) != 0u64;
                let b_neg = (b_tc & SC_SIGN64_U64) != 0u64;
                let a_mag: u64 = if a_neg { opt_twos_complement_u64(a_tc) } else { a_tc };
                let b_mag: u64 = if b_neg { opt_twos_complement_u64(b_tc) } else { b_tc };
                let mut rem_unused: u64 = 0u64;
                let q_mag = opt_div_rem_u64(a_mag, b_mag, mut_view(rem_unused));
                let q_tc: u64 = if (a_neg != b_neg) && q_mag != 0u64 {
                    opt_twos_complement_u64(q_mag)
                } else {
                    q_mag
                };
                *out_val = q_tc & mask;
            }
        } else {
            if b_u == 0u64 {
                *out_val = 0u64;
                *out_ovf = true;
            } else {
                let mut rem_unused: u64 = 0u64;
                *out_val = opt_div_rem_u64(a_u, b_u, mut_view(rem_unused)) & mask;
            }
        }
        return true;
    }
    if sub == MIR_BINOP_REM {
        if is_signed {
            let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(lhs_bits), lhs_bits);
            if b_tc == 0u64 || (a_tc == min_tc && b_tc == SC_ALL_ONES_U64) {
                *out_val = 0u64;
                *out_ovf = true;
            } else {
                let a_neg = (a_tc & SC_SIGN64_U64) != 0u64;
                let b_neg = (b_tc & SC_SIGN64_U64) != 0u64;
                let a_mag: u64 = if a_neg { opt_twos_complement_u64(a_tc) } else { a_tc };
                let b_mag: u64 = if b_neg { opt_twos_complement_u64(b_tc) } else { b_tc };
                let mut r_mag: u64 = 0u64;
                let _ = opt_div_rem_u64(a_mag, b_mag, mut_view(r_mag));
                let r_tc: u64 = if a_neg && r_mag != 0u64 {
                    opt_twos_complement_u64(r_mag)
                } else {
                    r_mag
                };
                *out_val = r_tc & mask;
            }
        } else {
            if b_u == 0u64 {
                *out_val = 0u64;
                *out_ovf = true;
            } else {
                let mut r_u: u64 = 0u64;
                let _ = opt_div_rem_u64(a_u, b_u, mut_view(r_u));
                *out_val = r_u & mask;
            }
        }
        return true;
    }
    if sub == MIR_BINOP_SHL || sub == MIR_BINOP_SHR {
        let rhs_bits_raw = opt_type_bits(thir, (TypeId { v: rhs_ty.v }));
        let rhs_bits: u32 = if rhs_bits_raw == 0u32 { lhs_bits } else { rhs_bits_raw };
        let rhs_mask = opt_bit_mask(rhs_bits);
        let rhs_signed = opt_type_is_signed(thir, (TypeId { v: rhs_ty.v }));
        let shift_amt: u64 = if rhs_signed {
            opt_sign_extend_u64(rv & rhs_mask, rhs_bits)
        } else {
            rv & rhs_mask
        };
        if shift_amt >= (lhs_bits as u64) {
            *out_val = 0u64;
            *out_ovf = true;
            return true;
        }
        if sub == MIR_BINOP_SHL {
            *out_val = (a_u << shift_amt) & mask;
            return true;
        }
        if is_signed {
            if shift_amt == 0u64 {
                *out_val = a_tc & mask;
            } else {
                let shifted = a_tc >> shift_amt;
                if (a_tc & SC_SIGN64_U64) != 0u64 {
                    let fill = SC_ALL_ONES_U64 << (64u64 - shift_amt);
                    *out_val = (shifted | fill) & mask;
                } else {
                    *out_val = shifted & mask;
                }
            }
        } else {
            *out_val = (a_u >> shift_amt) & mask;
        }
        return true;
    }
    false
}

fn scalar_eval_const_unop(
    thir: *const Thir,
    sub: u8,
    op_ty: TypeId,
    lv: u64,
    out_val: mut_view<u64>,
    out_ovf: mut_view<bool>
) -> bool {
    *out_ovf = false;
    let bits = opt_type_bits(thir, (TypeId { v: op_ty.v }));
    if bits == 0u32 || bits > 64u32 {
        return false;
    }
    let mask = opt_bit_mask(bits);
    let is_b = scalar_type_is_bool_ty(thir, (TypeId { v: op_ty.v }));
    let is_signed = opt_type_is_signed(thir, (TypeId { v: op_ty.v }));
    if sub == MIR_UNOP_NOT {
        if is_b {
            *out_val = if lv == 0u64 { 1u64 } else { 0u64 };
        } else {
            *out_val = (lv ^ SC_ALL_ONES_U64) & mask;
        }
        return true;
    }
    if sub == MIR_UNOP_BITNOT {
        if is_b {
            *out_val = if lv == 0u64 { 1u64 } else { 0u64 };
        } else {
            *out_val = (lv ^ SC_ALL_ONES_U64) & mask;
        }
        return true;
    }
    if sub == MIR_UNOP_NEG {
        if !is_signed || is_b {
            return false;
        }
        let s_tc = opt_sign_extend_u64(lv & mask, bits);
        let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(bits), bits);
        if s_tc == min_tc {
            *out_val = 0u64;
            *out_ovf = true;
            return true;
        }
        *out_val = opt_twos_complement_u64(s_tc) & mask;
        return true;
    }
    false
}

fn scalar_eval_const_cast(
    thir: *const Thir,
    sub: u8,
    src_ty: TypeId,
    dst_ty: TypeId,
    lv: u64,
    out_val: mut_view<u64>
) -> bool {
    if sub != MIR_CAST_INT_TO_INT {
        return false;
    }
    if !scalar_type_is_discrete(thir, (TypeId { v: src_ty.v })) ||
       !scalar_type_is_discrete(thir, (TypeId { v: dst_ty.v })) {
        return false;
    }
    let src_bits = opt_type_bits(thir, (TypeId { v: src_ty.v }));
    let dst_bits = opt_type_bits(thir, (TypeId { v: dst_ty.v }));
    if src_bits == 0u32 || dst_bits == 0u32 {
        return false;
    }
    let src_mask = opt_bit_mask(src_bits);
    if scalar_type_is_bool_ty(thir, (TypeId { v: dst_ty.v })) {
        *out_val = if (lv & src_mask) != 0u64 { 1u64 } else { 0u64 };
        return true;
    }
    let ext: u64 = if opt_type_is_signed(thir, (TypeId { v: src_ty.v })) && !scalar_type_is_bool_ty(thir, (TypeId { v: src_ty.v })) {
        opt_sign_extend_u64(lv & src_mask, src_bits)
    } else {
        lv & src_mask
    };
    *out_val = ext & opt_bit_mask(dst_bits);
    true
}

fn sc_max_signed_pos_for_bits(bits: u32) -> u64 {
    if bits == 8u32 { return 0x7Fu64; }
    if bits == 16u32 { return 0x7FFFu64; }
    if bits == 32u32 { return 0x7FFFFFFFu64; }
    if bits == 64u32 { return 0x7FFFFFFFFFFFFFFFu64; }
    0u64
}

fn sc_query_no_overflow_certainty_safe(
    pm: view<PassManager>,
    body: view<OptBody>,
    sub: u8,
    op_ty: TypeId,
    lhs_id: OptValueId,
    rhs_id: OptValueId,
    max_steps: u32
) -> u8 {
    if sub == MIR_BINOP_DIV || sub == MIR_BINOP_REM {
        if max_steps == 0u32 || lhs_id.v == OPT_VALUE_NONE || rhs_id.v == OPT_VALUE_NONE {
            return CERTAINTY_UNKNOWN;
        }
        if scalar_raw_val_has_fp_hazard(pm, body, lhs_id) || scalar_raw_val_has_fp_hazard(pm, body, rhs_id) {
            return CERTAINTY_POSSIBLE;
        }
        let bits = opt_type_bits(body.thir, (TypeId { v: op_ty.v }));
        if bits != 8u32 && bits != 16u32 && bits != 32u32 && bits != 64u32 {
            return CERTAINTY_UNKNOWN;
        }
        let mask = opt_bit_mask(bits);
        let is_sig = opt_type_is_signed(body.thir, (TypeId { v: op_ty.v })) &&
                     !scalar_type_is_bool_ty(body.thir, (TypeId { v: op_ty.v }));
        let mut lc: u64 = 0u64;
        let mut rc: u64 = 0u64;
        let l_const = pm_value_is_const_int(pm, body, lhs_id, mut_view(lc));
        let r_const = pm_value_is_const_int(pm, body, rhs_id, mut_view(rc));
        if l_const && r_const {
            let mut dummy_out: u64 = 0u64;
            let mut did_ovf = false;
            if scalar_eval_const_binop(
                body.thir,
                OPT_INST_BINOP,
                sub,
                (TypeId { v: op_ty.v }),
                (TypeId { v: op_ty.v }),
                (TypeId { v: op_ty.v }),
                lc,
                rc,
                mut_view(dummy_out),
                mut_view(did_ovf)
            ) {
                return if did_ovf { CERTAINTY_POSSIBLE } else { CERTAINTY_PROVEN };
            }
            return CERTAINTY_UNKNOWN;
        }
        if r_const {
            let rm = rc & mask;
            if rm == 0u64 {
                return CERTAINTY_POSSIBLE;
            }
            if !is_sig {
                return CERTAINTY_PROVEN;
            }
            if rm != mask {
                return CERTAINTY_PROVEN;
            }
            return CERTAINTY_POSSIBLE;
        }
        let nz = optir_query_non_zero_certainty(body, rhs_id, max_steps);
        if nz != CERTAINTY_PROVEN {
            return nz;
        }
        if !is_sig {
            return CERTAINTY_PROVEN;
        }
        if l_const && (lc & mask) != opt_sign_bit_mask(bits) {
            return CERTAINTY_PROVEN;
        }
        if (body.ranges as usize) != 0 && (rhs_id.v as usize) <= body.value_count {
            let rr = unsafe { opt_range_at(body.ranges, rhs_id.v as usize) };
            let max_pos = sc_max_signed_pos_for_bits(bits);
            if (unsafe { (*rr).has_range }) &&
               !(unsafe { (*rr).has_fp_hazard }) &&
               (unsafe { (*rr).non_zero_certainty }) == CERTAINTY_PROVEN &&
               (unsafe { (*rr).hi }) <= max_pos {
                return CERTAINTY_PROVEN;
            }
        }
        return CERTAINTY_POSSIBLE;
    }
    optir_query_no_overflow_certainty(body, sub, (TypeId { v: op_ty.v }), lhs_id, rhs_id, max_steps)
}

fn sc_effect_infer_inst_safe(
    pm: view<PassManager>,
    body: view<OptBody>,
    inst: view<OptInst>,
    max_steps: u32
) -> u16 {
    let mut eff = effect_infer_inst(body, inst, max_steps);
    let opc = inst.opcode;
    let sub = inst.sub_op;
    if (opc == OPT_INST_BINOP || opc == OPT_INST_CHECKED_BINOP) &&
       (sub == MIR_BINOP_DIV || sub == MIR_BINOP_REM) {
        let op_ty = if opc == OPT_INST_CHECKED_BINOP {
            scalar_val_ty(body, (OptValueId { v: inst.lhs.v }), (TypeId { v: inst.ty.v }))
        } else {
            (TypeId { v: inst.ty.v })
        };
        let nz = optir_query_non_zero_certainty(body, (OptValueId { v: inst.rhs.v }), max_steps);
        let ovf = sc_query_no_overflow_certainty_safe(
            pm,
            body,
            sub,
            op_ty,
            (OptValueId { v: inst.lhs.v }),
            (OptValueId { v: inst.rhs.v }),
            max_steps
        );
        if nz != CERTAINTY_PROVEN || ovf != CERTAINTY_PROVEN {
            eff = eff | EFFECT_MAY_PANIC;
        }
    }
    eff
}

fn sc_can_dce_inst_safe(
    pm: view<PassManager>,
    body: view<OptBody>,
    inst: view<OptInst>,
    max_steps: u32
) -> bool {
    if !effect_can_dce_inst(body, inst, max_steps) {
        return false;
    }
    sc_effect_infer_inst_safe(pm, body, inst, max_steps) == EFFECT_PURE
}

// --- SSA Value Replacement & MIR Local Safety Helpers ---

fn sc_replace_value_in_body(body: mut_view<OptBody>, from_val: OptValueId, to_val: OptValueId) {
    let from_v = from_val.v;
    let to_v = to_val.v;
    if from_v == OPT_VALUE_NONE || from_v == to_v {
        return;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let pcnt = unsafe { (*bb).phi_count };
        let phis = unsafe { (*bb).phis };
        let mut p: usize = 0;
        while p < pcnt {
            let phi = unsafe { opt_phi_at(phis, p) };
            let arity = unsafe { (*phi).arity };
            let incs = unsafe { (*phi).incoming_values };
            let mut k: usize = 0;
            while k < arity {
                if (unsafe { (*opt_valid_at(incs, k)).v }) == from_v {
                    unsafe { *opt_valid_at(incs, k) = (OptValueId { v: to_v }); }
                }
                k = k + 1;
            }
            p = p + 1;
        }
        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            if (unsafe { (*inst).lhs.v }) == from_v { unsafe { (*inst).lhs = (OptValueId { v: to_v }); } }
            if (unsafe { (*inst).rhs.v }) == from_v { unsafe { (*inst).rhs = (OptValueId { v: to_v }); } }
            if (unsafe { (*inst).result.v }) == from_v { unsafe { (*inst).result = (OptValueId { v: to_v }); } }
            let eac = unsafe { (*inst).extra_arg_count };
            let eargs = unsafe { (*inst).extra_args };
            let mut ei: usize = 0;
            while ei < eac {
                if (unsafe { (*opt_valid_at(eargs, ei)).v }) == from_v {
                    unsafe { *opt_valid_at(eargs, ei) = (OptValueId { v: to_v }); }
                }
                ei = ei + 1;
            }
            i = i + 1;
        }
        if (unsafe { (*bb).term.cond.v }) == from_v { unsafe { (*bb).term.cond = (OptValueId { v: to_v }); } }
        if (unsafe { (*bb).term.callee.v }) == from_v { unsafe { (*bb).term.callee = (OptValueId { v: to_v }); } }
        let cac = unsafe { (*bb).term.call_arg_count };
        let cargs = unsafe { (*bb).term.call_args };
        let mut ci: usize = 0;
        while ci < cac {
            if (unsafe { (*opt_valid_at(cargs, ci)).v }) == from_v {
                unsafe { *opt_valid_at(cargs, ci) = (OptValueId { v: to_v }); }
            }
            ci = ci + 1;
        }
        b = b + 1;
    }
}

fn sc_replace_value_uses_except_def(
    body: mut_view<OptBody>,
    from_val: OptValueId,
    to_val: OptValueId,
    keep_def_inst_v: u32
) {
    let from_v = from_val.v;
    let to_v = to_val.v;
    if from_v == OPT_VALUE_NONE || from_v == to_v {
        return;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let pcnt = unsafe { (*bb).phi_count };
        let phis = unsafe { (*bb).phis };
        let mut p: usize = 0;
        while p < pcnt {
            let phi = unsafe { opt_phi_at(phis, p) };
            let arity = unsafe { (*phi).arity };
            let incs = unsafe { (*phi).incoming_values };
            let mut k: usize = 0;
            while k < arity {
                if (unsafe { (*opt_valid_at(incs, k)).v }) == from_v {
                    unsafe { *opt_valid_at(incs, k) = (OptValueId { v: to_v }); }
                }
                k = k + 1;
            }
            p = p + 1;
        }
        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            let iid_v = unsafe { (*inst).id.v };
            if iid_v != keep_def_inst_v {
                if (unsafe { (*inst).lhs.v }) == from_v { unsafe { (*inst).lhs = (OptValueId { v: to_v }); } }
                if (unsafe { (*inst).rhs.v }) == from_v { unsafe { (*inst).rhs = (OptValueId { v: to_v }); } }
                if (unsafe { (*inst).opcode }) == OPT_INST_COPY && (unsafe { (*inst).result.v }) == from_v {
                    unsafe { (*inst).result = (OptValueId { v: to_v }); }
                }
                let eac = unsafe { (*inst).extra_arg_count };
                let eargs = unsafe { (*inst).extra_args };
                let mut ei: usize = 0;
                while ei < eac {
                    if (unsafe { (*opt_valid_at(eargs, ei)).v }) == from_v {
                        unsafe { *opt_valid_at(eargs, ei) = (OptValueId { v: to_v }); }
                    }
                    ei = ei + 1;
                }
            }
            i = i + 1;
        }
        if (unsafe { (*bb).term.cond.v }) == from_v { unsafe { (*bb).term.cond = (OptValueId { v: to_v }); } }
        if (unsafe { (*bb).term.callee.v }) == from_v { unsafe { (*bb).term.callee = (OptValueId { v: to_v }); } }
        let cac = unsafe { (*bb).term.call_arg_count };
        let cargs = unsafe { (*bb).term.call_args };
        let mut ci: usize = 0;
        while ci < cac {
            if (unsafe { (*opt_valid_at(cargs, ci)).v }) == from_v {
                unsafe { *opt_valid_at(cargs, ci) = (OptValueId { v: to_v }); }
            }
            ci = ci + 1;
        }
        b = b + 1;
    }
}

fn sc_inst_is_deleted_nop(inst: view<OptInst>) -> bool {
    inst.opcode == OPT_INST_NOP && (inst.flags & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16
}

fn sc_local_addr_taken_anywhere(body: view<OptBody>, loc_v: u32) -> bool {
    let lv = loc_v as usize;
    if lv >= body.local_count {
        return true;
    }
    if (body.local_addr_taken as usize) != 0 && (unsafe { *opt_bool_at(body.local_addr_taken, lv) }) {
        return true;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                if !sc_inst_is_deleted_nop(unsafe { view(*inst) }) {
                    if (unsafe { (*inst).opcode }) == OPT_INST_ADDR_OF &&
                       (unsafe { (*inst).rhs_place.local.v }) == loc_v {
                        return true;
                    }
                    if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                       (unsafe { (*inst).orig_stmt.rvalue.kind }) == MIR_RVALUE_REF &&
                       (unsafe { (*inst).orig_stmt.rvalue.place.local.v }) == loc_v {
                        return true;
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    false
}

fn sc_place_is_ssa_slot(body: view<OptBody>, pl: view<MirPlace>) -> bool {
    let lv = pl.local.v as usize;
    if lv >= body.local_count || (body.local_modes as usize) == 0 {
        return false;
    }
    if pl.proj_count != 0 || pl.view_kind != 0u8 || pl.drop_flag != MIR_DROP_FLAG_NONE {
        return false;
    }
    if (unsafe { *opt_u8_at(body.local_modes, lv) }) != OPT_LOCAL_SCALAR {
        return false;
    }
    !sc_local_addr_taken_anywhere(body, lv as u32)
}

unsafe fn sc_rewrite_inst_to_const(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    inst: *mut OptInst,
    bb_v: u32,
    pass_id: u16,
    cval: u64
) {
    let dst_is_ssa = sc_place_is_ssa_slot(view(*body), view((*inst).place));
    let inst_ty_v = (*inst).ty.v;
    let is_b = scalar_type_is_bool_ty(body.thir, (TypeId { v: inst_ty_v }));
    let ckind: u8 = if is_b { MIR_CONST_BOOL } else { MIR_CONST_INT };
    let norm_val: u64 = if is_b {
        if cval != 0u64 { 1u64 } else { 0u64 }
    } else {
        let bits = opt_type_bits(body.thir, (TypeId { v: inst_ty_v }));
        if bits > 0u32 && bits <= 64u32 { cval & opt_bit_mask(bits) } else { cval }
    };
    let old_res_v = (*inst).result.v;
    let mut updated_in_place = false;
    if old_res_v != OPT_VALUE_NONE && (old_res_v as usize) <= body.value_count && (body.values as usize) != 0 {
        let vp = opt_val_at(body.values, old_res_v as usize);
        if (*vp).kind == OPT_VAL_INST && (*vp).def_inst.v == (*inst).id.v {
            (*vp).kind = OPT_VAL_CONST;
            (*vp).const_val.kind = ckind;
            (*vp).const_val.ty = (TypeId { v: inst_ty_v });
            (*vp).const_val.val = norm_val;
            if (body.ranges as usize) != 0 {
                let rp = opt_range_at(body.ranges, old_res_v as usize);
                (*rp).has_range = true;
                (*rp).lo = norm_val;
                (*rp).hi = norm_val;
                (*rp).non_zero_certainty = if norm_val != 0u64 { CERTAINTY_PROVEN } else { CERTAINTY_UNKNOWN };
                (*rp).has_fp_hazard = false;
            }
            updated_in_place = true;
        }
    }
    if !updated_in_place {
        let new_vid = scalar_alloc_const_value(
            mut_view(*body),
            mut_view(*arena),
            (TypeId { v: inst_ty_v }),
            norm_val,
            bb_v,
            (*inst).id.v,
            pass_id
        );
        if old_res_v != OPT_VALUE_NONE {
            sc_replace_value_in_body(mut_view(*body), (OptValueId { v: old_res_v }), new_vid);
        }
        (*inst).result = new_vid;
    }
    let c_vid = (*inst).result;
    (*inst).opcode = if dst_is_ssa { OPT_INST_CONST } else { OPT_INST_STORE };
    (*inst).sub_op = 0u8;
    (*inst).flags = 0u16;
    (*inst).lhs = c_vid;
    if !dst_is_ssa {
        (*inst).result = (OptValueId { v: OPT_VALUE_NONE });
    }
    (*inst).rhs = (OptValueId { v: OPT_VALUE_NONE });
    (*inst).extra_arg_count = 0;
    (*inst).mem_use = (MemSsaId { v: MEM_SSA_NONE });
    (*inst).mem_def = (MemSsaId { v: MEM_SSA_NONE });
    (*inst).orig_stmt.rvalue.kind = MIR_RVALUE_USE;
    (*inst).orig_stmt.rvalue.use_op.kind = MIR_OP_CONST;
    (*inst).orig_stmt.rvalue.use_op.constant.kind = ckind;
    (*inst).orig_stmt.rvalue.use_op.constant.ty = (TypeId { v: inst_ty_v });
    (*inst).orig_stmt.rvalue.use_op.constant.val = norm_val;
}

// --- MIR Local Liveness, Path Clobber & CFG/SSA Rebuild Helpers ---

fn sc_mir_place_proj_reads_local(pl: view<MirPlace>, loc_v: u32) -> bool {
    if pl.proj_count == 0 || (pl.projs as usize) == 0 {
        return false;
    }
    let mut p: usize = 0;
    while p < pl.proj_count {
        let pr = unsafe { mir_proj_at(pl.projs, p) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX && (unsafe { (*pr).index_local.v }) == loc_v {
            return true;
        }
        if pk == MIR_PROJ_SUB_SLICE {
            if (unsafe { (*pr).has_from }) && (unsafe { (*pr).from_local.v }) == loc_v {
                return true;
            }
            if (unsafe { (*pr).has_to }) && (unsafe { (*pr).to_local.v }) == loc_v {
                return true;
            }
        }
        p = p + 1;
    }
    false
}

fn sc_mir_place_reads_local(pl: view<MirPlace>, loc_v: u32) -> bool {
    pl.local.v == loc_v || sc_mir_place_proj_reads_local(pl, loc_v)
}

fn sc_mir_op_reads_local(op: view<MirOperand>, loc_v: u32) -> bool {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        return sc_mir_place_reads_local(view(op.place), loc_v);
    }
    false
}

fn sc_mir_op_is_move(op: view<MirOperand>) -> bool {
    op.kind == MIR_OP_MOVE
}

fn sc_mir_op_is_drop_move(body: view<OptBody>, op: view<MirOperand>) -> bool {
    if op.kind != MIR_OP_MOVE {
        return false;
    }
    if op.place.drop_flag != MIR_DROP_FLAG_NONE {
        return true;
    }
    let lv = op.place.local.v as usize;
    if lv < body.local_count && (body.local_dropped as usize) != 0 {
        return unsafe { *opt_bool_at(body.local_dropped, lv) };
    }
    false
}

fn sc_mir_stmt_has_move_operand(st: view<MirStmt>) -> bool {
    if st.kind != MIR_STMT_ASSIGN {
        return false;
    }
    let rk = st.rvalue.kind;
    if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP || rk == MIR_RVALUE_CAST {
        return st.rvalue.use_op.kind == MIR_OP_MOVE;
    }
    if rk == MIR_RVALUE_REPEAT {
        if st.rvalue.use_op.kind == MIR_OP_MOVE {
            return true;
        }
        let rcop = st.rvalue.repeat_count_op;
        if (rcop as usize) != 0 && (unsafe { (*rcop).kind }) == MIR_OP_MOVE {
            return true;
        }
        return false;
    }
    if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        return st.rvalue.lhs.kind == MIR_OP_MOVE || st.rvalue.rhs.kind == MIR_OP_MOVE;
    }
    if rk == MIR_RVALUE_AGGREGATE {
        let mut idx: usize = 0;
        while idx < st.rvalue.operand_count {
            let op = unsafe { mir_op_at(st.rvalue.operands, idx) };
            if (unsafe { (*op).kind }) == MIR_OP_MOVE {
                return true;
            }
            idx = idx + 1;
        }
    }
    false
}

fn sc_mir_stmt_reads_or_drops_local(st: view<MirStmt>, loc_v: u32) -> bool {
    if st.kind == MIR_STMT_DROP {
        return sc_mir_place_reads_local(view(st.place), loc_v);
    }
    if st.kind != MIR_STMT_ASSIGN {
        return false;
    }
    if st.place.proj_count > 0 && sc_mir_place_reads_local(view(st.place), loc_v) {
        return true;
    }
    let rk = st.rvalue.kind;
    if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP || rk == MIR_RVALUE_CAST {
        return sc_mir_op_reads_local(view(st.rvalue.use_op), loc_v);
    }
    if rk == MIR_RVALUE_REPEAT {
        if sc_mir_op_reads_local(view(st.rvalue.use_op), loc_v) {
            return true;
        }
        let rcop = st.rvalue.repeat_count_op;
        if (rcop as usize) != 0 && sc_mir_op_reads_local(unsafe { view(*rcop) }, loc_v) {
            return true;
        }
        return false;
    }
    if rk == MIR_RVALUE_REF || rk == MIR_RVALUE_LEN || rk == MIR_RVALUE_DISCRIMINANT {
        return sc_mir_place_reads_local(view(st.rvalue.place), loc_v);
    }
    if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        return sc_mir_op_reads_local(view(st.rvalue.lhs), loc_v) ||
               sc_mir_op_reads_local(view(st.rvalue.rhs), loc_v);
    }
    if rk == MIR_RVALUE_AGGREGATE {
        let mut idx: usize = 0;
        while idx < st.rvalue.operand_count {
            let op = unsafe { mir_op_at(st.rvalue.operands, idx) };
            if sc_mir_op_reads_local(unsafe { view(*op) }, loc_v) {
                return true;
            }
            idx = idx + 1;
        }
    }
    false
}

fn sc_mir_term_reads_or_drops_local(tm: view<MirTerminator>, loc_v: u32) -> bool {
    if tm.kind == MIR_TERM_SWITCH_INT {
        return sc_mir_op_reads_local(view(tm.discr), loc_v);
    }
    if tm.kind == MIR_TERM_DROP {
        return sc_mir_place_reads_local(view(tm.drop_place), loc_v);
    }
    if tm.kind == MIR_TERM_ASSERT {
        return sc_mir_op_reads_local(view(tm.cond), loc_v);
    }
    if tm.kind == MIR_TERM_CALL {
        if sc_mir_op_reads_local(view(tm.func), loc_v) {
            return true;
        }
        if tm.has_destination && tm.destination.proj_count > 0 && sc_mir_place_reads_local(view(tm.destination), loc_v) {
            return true;
        }
        let mut ai: usize = 0;
        while ai < tm.arg_count {
            let aop = unsafe { mir_op_at(tm.args, ai) };
            if sc_mir_op_reads_local(unsafe { view(*aop) }, loc_v) {
                return true;
            }
            ai = ai + 1;
        }
    }
    false
}

fn sc_mir_local_read_or_dropped_anywhere(
    body: view<OptBody>,
    skip_b: usize,
    skip_i: usize,
    loc_v: u32
) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                if !(b == skip_b && i == skip_i) {
                    let inst = unsafe { opt_inst_at(insts, i) };
                    if !sc_inst_is_deleted_nop(unsafe { view(*inst) }) &&
                       sc_mir_stmt_reads_or_drops_local(unsafe { view((*inst).orig_stmt) }, loc_v) {
                        return true;
                    }
                }
                i = i + 1;
            }
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) != OPT_TERM_UNREACHABLE &&
               sc_mir_term_reads_or_drops_local(unsafe { view((*bb).term.orig_term) }, loc_v) {
                return true;
            }
        }
        b = b + 1;
    }
    false
}

fn sc_mir_local_overwritten_before_read_in_block(
    pm: view<PassManager>,
    body: view<OptBody>,
    bb: view<OptBlock>,
    start_i: usize,
    loc_v: u32,
    max_steps: u32
) -> bool {
    let lv = loc_v as usize;
    if lv == 0 || lv >= body.local_count || (body.local_modes as usize) == 0 {
        return false;
    }
    if (unsafe { *opt_u8_at(body.local_modes, lv) }) != OPT_LOCAL_SCALAR ||
       sc_local_addr_taken_anywhere(body, loc_v) {
        return false;
    }
    let has_unwind = bb.has_term && bb.term.unwind_bb.v != OPT_BB_NONE;
    let mut k: usize = start_i + 1;
    while k < bb.inst_count {
        let inst_k = unsafe { opt_inst_at(bb.insts, k) };
        if !sc_inst_is_deleted_nop(unsafe { view(*inst_k) }) {
            let opc_k = unsafe { (*inst_k).opcode };
            let flg_k = unsafe { (*inst_k).flags };
            if (flg_k & OPT_FLAG_BARRIER) != 0u16 ||
               opc_k == OPT_INST_BLACK_BOX || opc_k == OPT_INST_ZEROIZE ||
               opc_k == OPT_INST_VOLATILE_LOAD || opc_k == OPT_INST_VOLATILE_STORE ||
               opc_k == OPT_INST_ATOMIC || opc_k == OPT_INST_DROP_FLAG {
                return false;
            }
            if (flg_k & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 &&
               (unsafe { (*inst_k).orig_stmt.storage_local.v }) == loc_v {
                return false;
            }
            if sc_mir_stmt_reads_or_drops_local(unsafe { view((*inst_k).orig_stmt) }, loc_v) {
                return false;
            }
            if has_unwind {
                let eff_k = sc_effect_infer_inst_safe(pm, body, unsafe { view(*inst_k) }, max_steps);
                if (eff_k & EFFECT_MAY_PANIC) != 0u16 {
                    return false;
                }
            }
            if (unsafe { (*inst_k).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
               (unsafe { (*inst_k).place.local.v }) == loc_v &&
               (unsafe { (*inst_k).place.proj_count }) == 0 &&
               (unsafe { (*inst_k).place.drop_flag }) == MIR_DROP_FLAG_NONE {
                return true;
            }
        }
        k = k + 1;
    }
    false
}

fn sc_inst_clobbers_local(inst: view<OptInst>, loc_v: u32) -> bool {
    if sc_inst_is_deleted_nop(inst) {
        return false;
    }
    let flg = inst.flags;
    if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
        return inst.orig_stmt.storage_local.v == loc_v || inst.place.local.v == loc_v;
    }
    if inst.opcode == OPT_INST_DROP_FLAG && sc_mir_place_reads_local(view(inst.place), loc_v) {
        return true;
    }
    if inst.orig_stmt.kind == MIR_STMT_ASSIGN && inst.place.local.v == loc_v {
        return true;
    }
    if inst.opcode == OPT_INST_ADDR_OF && inst.rhs_place.local.v == loc_v {
        return true;
    }
    if (flg & OPT_FLAG_MOVE) != 0u16 && inst.rhs_place.local.v == loc_v {
        return true;
    }
    let st = view(inst.orig_stmt);
    if st.kind == MIR_STMT_ASSIGN {
        let rk = st.rvalue.kind;
        if rk == MIR_RVALUE_REF && st.rvalue.place.local.v == loc_v {
            return true;
        }
        if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP || rk == MIR_RVALUE_CAST {
            if st.rvalue.use_op.kind == MIR_OP_MOVE && st.rvalue.use_op.place.local.v == loc_v {
                return true;
            }
        } else if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
            if (st.rvalue.lhs.kind == MIR_OP_MOVE && st.rvalue.lhs.place.local.v == loc_v) ||
               (st.rvalue.rhs.kind == MIR_OP_MOVE && st.rvalue.rhs.place.local.v == loc_v) {
                return true;
            }
        } else if rk == MIR_RVALUE_AGGREGATE {
            let mut idx: usize = 0;
            while idx < st.rvalue.operand_count {
                let op = unsafe { mir_op_at(st.rvalue.operands, idx) };
                if (unsafe { (*op).kind }) == MIR_OP_MOVE && (unsafe { (*op).place.local.v }) == loc_v {
                    return true;
                }
                idx = idx + 1;
            }
        }
    }
    false
}

fn sc_term_clobbers_local(term: view<OptTerminator>, loc_v: u32) -> bool {
    let tk = term.kind;
    if tk == OPT_TERM_DROP {
        return sc_mir_place_reads_local(view(term.drop_place), loc_v);
    }
    if tk == OPT_TERM_CALL {
        if term.has_call_dest && term.call_dest.local.v == loc_v {
            return true;
        }
        let mt = view(term.orig_term);
        let mut ai: usize = 0;
        while ai < mt.arg_count {
            let aop = unsafe { mir_op_at(mt.args, ai) };
            if (unsafe { (*aop).kind }) == MIR_OP_MOVE && (unsafe { (*aop).place.local.v }) == loc_v {
                return true;
            }
            ai = ai + 1;
        }
    }
    if tk == OPT_TERM_SWITCH_INT {
        if term.orig_term.discr.kind == MIR_OP_MOVE && term.orig_term.discr.place.local.v == loc_v {
            return true;
        }
    }
    if tk == OPT_TERM_ASSERT {
        if term.orig_term.cond.kind == MIR_OP_MOVE && term.orig_term.cond.place.local.v == loc_v {
            return true;
        }
    }
    false
}

fn sc_mir_local_clobbered_in_range(bb: view<OptBlock>, lo: usize, hi: usize, loc_v: u32) -> bool {
    let end: usize = if hi > bb.inst_count { bb.inst_count } else { hi };
    let mut k: usize = lo;
    while k < end {
        let inst_k = unsafe { opt_inst_at(bb.insts, k) };
        if sc_inst_clobbers_local(unsafe { view(*inst_k) }, loc_v) {
            return true;
        }
        k = k + 1;
    }
    false
}

fn sc_mir_local_clobbered_on_path(
    body: view<OptBody>,
    arena: mut_view<Arena>,
    dom_b: usize,
    def_i: usize,
    cur_b: usize,
    cur_i: usize,
    loc_v: u32
) -> bool {
    if dom_b >= body.bb_count || cur_b >= body.bb_count {
        return true;
    }
    if !opt_dominates(view(*body), (OptBbId { v: dom_b as u32 }), (OptBbId { v: cur_b as u32 })) {
        return true;
    }
    if dom_b == cur_b {
        if def_i >= cur_i {
            return true;
        }
        let bb = unsafe { opt_block_at(body.blocks, cur_b) };
        return sc_mir_local_clobbered_in_range(unsafe { view(*bb) }, def_i + 1, cur_i, loc_v);
    }

    let cbb = unsafe { opt_block_at(body.blocks, cur_b) };
    if sc_mir_local_clobbered_in_range(unsafe { view(*cbb) }, 0, cur_i, loc_v) {
        return true;
    }

    let n = body.bb_count;
    let vis = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let queue = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n + 2, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut z: usize = 0;
    while z < n {
        unsafe { *opt_bool_at(vis, z) = false; }
        z = z + 1;
    }

    let mut q_head: usize = 0;
    let mut q_len: usize = 0;
    let c_pcnt = unsafe { (*cbb).pred_count };
    let c_preds = unsafe { (*cbb).preds };
    let mut p: usize = 0;
    while p < c_pcnt {
        let pv = (unsafe { (*opt_bbid_at(c_preds, p)).v }) as usize;
        if pv < n {
            let pbb = unsafe { opt_block_at(body.blocks, pv) };
            if (unsafe { (*pbb).is_reachable }) && !(unsafe { *opt_bool_at(vis, pv) }) {
                unsafe {
                    *opt_bool_at(vis, pv) = true;
                    *opt_u32_at(queue, q_len) = pv as u32;
                }
                q_len = q_len + 1;
            }
        }
        p = p + 1;
    }

    while q_head < q_len {
        let b_idx = (unsafe { *opt_u32_at(queue, q_head) }) as usize;
        q_head = q_head + 1;
        let bb = unsafe { opt_block_at(body.blocks, b_idx) };
        if b_idx == dom_b {
            let icnt = unsafe { (*bb).inst_count };
            if def_i + 1 < icnt && sc_mir_local_clobbered_in_range(unsafe { view(*bb) }, def_i + 1, icnt, loc_v) {
                return true;
            }
            if (unsafe { (*bb).has_term }) && sc_term_clobbers_local(unsafe { view((*bb).term) }, loc_v) {
                return true;
            }
        } else {
            let icnt = unsafe { (*bb).inst_count };
            if sc_mir_local_clobbered_in_range(unsafe { view(*bb) }, 0, icnt, loc_v) {
                return true;
            }
            if (unsafe { (*bb).has_term }) && sc_term_clobbers_local(unsafe { view((*bb).term) }, loc_v) {
                return true;
            }
            let pcnt = unsafe { (*bb).pred_count };
            let preds = unsafe { (*bb).preds };
            let mut pi: usize = 0;
            while pi < pcnt {
                let pv = (unsafe { (*opt_bbid_at(preds, pi)).v }) as usize;
                if pv < n {
                    let pbb = unsafe { opt_block_at(body.blocks, pv) };
                    if (unsafe { (*pbb).is_reachable }) && !(unsafe { *opt_bool_at(vis, pv) }) {
                        unsafe {
                            *opt_bool_at(vis, pv) = true;
                            *opt_u32_at(queue, q_len) = pv as u32;
                        }
                        q_len = q_len + 1;
                    }
                }
                pi = pi + 1;
            }
        }
    }
    false
}

fn sc_place_address_locals_clobbered_on_path(
    body: view<OptBody>,
    arena: mut_view<Arena>,
    dom_b: usize,
    def_i: usize,
    cur_b: usize,
    cur_i: usize,
    pl: view<MirPlace>
) -> bool {
    if pl.proj_count == 0 || (pl.projs as usize) == 0 {
        return false;
    }
    let pr0 = unsafe { mir_proj_at(pl.projs, 0) };
    if (unsafe { (*pr0).kind }) == MIR_PROJ_DEREF {
        if sc_mir_local_clobbered_on_path(body, mut_view(*arena), dom_b, def_i, cur_b, cur_i, pl.local.v) {
            return true;
        }
    }
    let mut pi: usize = 0;
    while pi < pl.proj_count {
        let pr = unsafe { mir_proj_at(pl.projs, pi) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX {
            let idx_loc = unsafe { (*pr).index_local.v };
            if sc_mir_local_clobbered_on_path(body, mut_view(*arena), dom_b, def_i, cur_b, cur_i, idx_loc) {
                return true;
            }
        } else if pk == MIR_PROJ_SUB_SLICE {
            if (unsafe { (*pr).has_from }) {
                let fl = unsafe { (*pr).from_local.v };
                if sc_mir_local_clobbered_on_path(body, mut_view(*arena), dom_b, def_i, cur_b, cur_i, fl) {
                    return true;
                }
            }
            if (unsafe { (*pr).has_to }) {
                let tl = unsafe { (*pr).to_local.v };
                if sc_mir_local_clobbered_on_path(body, mut_view(*arena), dom_b, def_i, cur_b, cur_i, tl) {
                    return true;
                }
            }
        }
        pi = pi + 1;
    }
    false
}

fn sc_local_is_unprojected_scalar(body: view<OptBody>, pl: view<MirPlace>) -> bool {
    let lv = pl.local.v as usize;
    if lv == 0 || lv >= body.local_count || (body.local_modes as usize) == 0 {
        return false;
    }
    if pl.proj_count != 0 || pl.view_kind != 0u8 || pl.drop_flag != MIR_DROP_FLAG_NONE {
        return false;
    }
    if (unsafe { *opt_u8_at(body.local_modes, lv) }) != OPT_LOCAL_SCALAR {
        return false;
    }
    !sc_local_addr_taken_anywhere(body, lv as u32)
}

fn sc_local_any_clobber_in_body(body: view<OptBody>, loc_v: u32) -> bool {
    if sc_local_addr_taken_anywhere(body, loc_v) {
        return true;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            if sc_mir_local_clobbered_in_range(unsafe { view(*bb) }, 0, icnt, loc_v) {
                return true;
            }
            if (unsafe { (*bb).has_term }) && sc_term_clobbers_local(unsafe { view((*bb).term) }, loc_v) {
                return true;
            }
        }
        b = b + 1;
    }
    false
}

fn sc_call_dest_clobbered_on_path(
    body: view<OptBody>,
    arena: mut_view<Arena>,
    call_b: usize,
    cont_b: usize,
    cur_b: usize,
    cur_i: usize,
    loc_v: u32
) -> bool {
    if call_b >= body.bb_count || cont_b >= body.bb_count || cur_b >= body.bb_count {
        return true;
    }
    if call_b == cont_b || cur_b == call_b {
        return true;
    }
    if sc_local_addr_taken_anywhere(body, loc_v) {
        return true;
    }
    if !opt_dominates(body, (OptBbId { v: call_b as u32 }), (OptBbId { v: cur_b as u32 })) ||
       !opt_dominates(body, (OptBbId { v: cont_b as u32 }), (OptBbId { v: cur_b as u32 })) {
        return true;
    }
    let call_bb = unsafe { opt_block_at(body.blocks, call_b) };
    let unwind_v = if unsafe { (*call_bb).has_term } {
        unsafe { (*call_bb).term.unwind_bb.v }
    } else {
        OPT_BB_NONE
    };
    if !(unsafe { (*call_bb).has_term }) ||
       (unsafe { (*call_bb).term.kind }) != OPT_TERM_CALL ||
       (unsafe { (*call_bb).term.true_bb.v }) != (cont_b as u32) ||
       unwind_v == (cont_b as u32) {
        return true;
    }

    let cbb = unsafe { opt_block_at(body.blocks, cur_b) };
    if sc_mir_local_clobbered_in_range(unsafe { view(*cbb) }, 0, cur_i, loc_v) {
        return true;
    }

    let n = body.bb_count;
    let vis = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let queue = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n + 2, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut z: usize = 0;
    while z < n {
        unsafe { *opt_bool_at(vis, z) = false; }
        z = z + 1;
    }

    let mut q_head: usize = 0;
    let mut q_len: usize = 0;
    let c_pcnt = unsafe { (*cbb).pred_count };
    let c_preds = unsafe { (*cbb).preds };
    let mut p: usize = 0;
    while p < c_pcnt {
        let pv = (unsafe { (*opt_bbid_at(c_preds, p)).v }) as usize;
        if pv < n {
            let pbb = unsafe { opt_block_at(body.blocks, pv) };
            if (unsafe { (*pbb).is_reachable }) && !(unsafe { *opt_bool_at(vis, pv) }) {
                unsafe {
                    *opt_bool_at(vis, pv) = true;
                    *opt_u32_at(queue, q_len) = pv as u32;
                }
                q_len = q_len + 1;
            }
        }
        p = p + 1;
    }

    while q_head < q_len {
        let b_idx = (unsafe { *opt_u32_at(queue, q_head) }) as usize;
        q_head = q_head + 1;
        if (b_idx as u32) == unwind_v {
            return true;
        }
        if b_idx != call_b {
            let bb = unsafe { opt_block_at(body.blocks, b_idx) };
            let icnt = unsafe { (*bb).inst_count };
            if sc_mir_local_clobbered_in_range(unsafe { view(*bb) }, 0, icnt, loc_v) {
                return true;
            }
            if (unsafe { (*bb).has_term }) && sc_term_clobbers_local(unsafe { view((*bb).term) }, loc_v) {
                return true;
            }
            let pcnt = unsafe { (*bb).pred_count };
            let preds = unsafe { (*bb).preds };
            let mut pi: usize = 0;
            while pi < pcnt {
                let pv = (unsafe { (*opt_bbid_at(preds, pi)).v }) as usize;
                if pv < n {
                    let pbb = unsafe { opt_block_at(body.blocks, pv) };
                    if (unsafe { (*pbb).is_reachable }) && !(unsafe { *opt_bool_at(vis, pv) }) {
                        unsafe {
                            *opt_bool_at(vis, pv) = true;
                            *opt_u32_at(queue, q_len) = pv as u32;
                        }
                        q_len = q_len + 1;
                    }
                }
                pi = pi + 1;
            }
        }
    }
    false
}

fn sc_inst_clobbers_region(
    body: view<OptBody>,
    inst: view<OptInst>,
    rreg: view<MemoryRegion>
) -> bool {
    if sc_inst_is_deleted_nop(inst) {
        return false;
    }
    let opc = inst.opcode;
    let flg = inst.flags;
    if (flg & OPT_FLAG_BARRIER) != 0u16 ||
       opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE ||
       opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_VOLATILE_STORE ||
       opc == OPT_INST_ATOMIC || opc == OPT_INST_DROP_FLAG {
        return true;
    }
    if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
        let sloc = inst.orig_stmt.storage_local.v;
        if rreg.domain == STORAGE_STACK_LOCAL {
            return sloc == rreg.base_local.v || inst.place.local.v == rreg.base_local.v;
        }
        return sc_local_addr_taken_anywhere(body, sloc);
    }
    if inst.orig_stmt.kind == MIR_STMT_DROP {
        let dreg = optir_extract_memory_region(body, view(inst.orig_stmt.place));
        return optir_alias_query(body, view(dreg), rreg) != ALIAS_NO_ALIAS;
    }
    if inst.orig_stmt.kind == MIR_STMT_ASSIGN {
        let wreg = optir_extract_memory_region(body, view(inst.place));
        if optir_alias_query(body, view(wreg), rreg) != ALIAS_NO_ALIAS {
            return true;
        }
    }
    false
}

fn sc_term_clobbers_region(
    body: view<OptBody>,
    term: view<OptTerminator>,
    call_table: *const EffectCallTable,
    rreg: view<MemoryRegion>
) -> bool {
    let tk = term.kind;
    if tk == OPT_TERM_DROP {
        return true;
    }
    if tk == OPT_TERM_CALL {
        if term.has_call_dest {
            let cd_reg = optir_extract_memory_region(body, view(term.call_dest));
            if optir_alias_query(body, view(cd_reg), rreg) != ALIAS_NO_ALIAS {
                return true;
            }
        }
        let teff = effect_infer_term_with_table(body, term, call_table);
        let write_mask = EFFECT_WRITES_MEM | EFFECT_VOLATILE | EFFECT_ATOMIC | EFFECT_IO | EFFECT_FFI | EFFECT_UNKNOWN;
        if (teff.flags & write_mask) != 0u16 {
            if rreg.domain != STORAGE_STACK_LOCAL {
                return true;
            }
            if sc_local_addr_taken_anywhere(body, rreg.base_local.v) {
                return true;
            }
        }
    }
    false
}

fn sc_region_clobbered_in_range(
    body: view<OptBody>,
    bb: view<OptBlock>,
    lo: usize,
    hi: usize,
    rreg: view<MemoryRegion>
) -> bool {
    let end: usize = if hi > bb.inst_count { bb.inst_count } else { hi };
    let mut k: usize = lo;
    while k < end {
        let inst_k = unsafe { opt_inst_at(bb.insts, k) };
        if sc_inst_clobbers_region(body, unsafe { view(*inst_k) }, rreg) {
            return true;
        }
        k = k + 1;
    }
    false
}

fn sc_region_clobbered_on_path(
    body: view<OptBody>,
    arena: mut_view<Arena>,
    call_table: *const EffectCallTable,
    dom_b: usize,
    def_i: usize,
    cur_b: usize,
    cur_i: usize,
    rreg: view<MemoryRegion>
) -> bool {
    if dom_b >= body.bb_count || cur_b >= body.bb_count {
        return true;
    }
    if !opt_dominates(body, (OptBbId { v: dom_b as u32 }), (OptBbId { v: cur_b as u32 })) {
        return true;
    }
    if dom_b == cur_b {
        if def_i >= cur_i {
            return true;
        }
        let bb = unsafe { opt_block_at(body.blocks, cur_b) };
        return sc_region_clobbered_in_range(body, unsafe { view(*bb) }, def_i + 1, cur_i, rreg);
    }

    let cbb = unsafe { opt_block_at(body.blocks, cur_b) };
    if sc_region_clobbered_in_range(body, unsafe { view(*cbb) }, 0, cur_i, rreg) {
        return true;
    }

    let n = body.bb_count;
    let vis = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let queue = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n + 2, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut z: usize = 0;
    while z < n {
        unsafe { *opt_bool_at(vis, z) = false; }
        z = z + 1;
    }

    let mut q_head: usize = 0;
    let mut q_len: usize = 0;
    let c_pcnt = unsafe { (*cbb).pred_count };
    let c_preds = unsafe { (*cbb).preds };
    let mut p: usize = 0;
    while p < c_pcnt {
        let pv = (unsafe { (*opt_bbid_at(c_preds, p)).v }) as usize;
        if pv < n {
            let pbb = unsafe { opt_block_at(body.blocks, pv) };
            if (unsafe { (*pbb).is_reachable }) && !(unsafe { *opt_bool_at(vis, pv) }) {
                unsafe {
                    *opt_bool_at(vis, pv) = true;
                    *opt_u32_at(queue, q_len) = pv as u32;
                }
                q_len = q_len + 1;
            }
        }
        p = p + 1;
    }

    while q_head < q_len {
        let b_idx = (unsafe { *opt_u32_at(queue, q_head) }) as usize;
        q_head = q_head + 1;
        let bb = unsafe { opt_block_at(body.blocks, b_idx) };
        if b_idx == dom_b {
            let icnt = unsafe { (*bb).inst_count };
            if def_i + 1 < icnt && sc_region_clobbered_in_range(body, unsafe { view(*bb) }, def_i + 1, icnt, rreg) {
                return true;
            }
            if (unsafe { (*bb).has_term }) && sc_term_clobbers_region(body, unsafe { view((*bb).term) }, call_table, rreg) {
                return true;
            }
        } else {
            let icnt = unsafe { (*bb).inst_count };
            if sc_region_clobbered_in_range(body, unsafe { view(*bb) }, 0, icnt, rreg) {
                return true;
            }
            if (unsafe { (*bb).has_term }) && sc_term_clobbers_region(body, unsafe { view((*bb).term) }, call_table, rreg) {
                return true;
            }
            let pcnt = unsafe { (*bb).pred_count };
            let preds = unsafe { (*bb).preds };
            let mut pi: usize = 0;
            while pi < pcnt {
                let pv = (unsafe { (*opt_bbid_at(preds, pi)).v }) as usize;
                if pv < n {
                    let pbb = unsafe { opt_block_at(body.blocks, pv) };
                    if (unsafe { (*pbb).is_reachable }) && !(unsafe { *opt_bool_at(vis, pv) }) {
                        unsafe {
                            *opt_bool_at(vis, pv) = true;
                            *opt_u32_at(queue, q_len) = pv as u32;
                        }
                        q_len = q_len + 1;
                    }
                }
                pi = pi + 1;
            }
        }
    }
    false
}

fn sc_mir_place_reads_aliasing_region(
    body: view<OptBody>,
    pl: view<MirPlace>,
    wreg: view<MemoryRegion>
) -> bool {
    let rreg = optir_extract_memory_region(body, pl);
    if optir_alias_query(body, wreg, view(rreg)) != ALIAS_NO_ALIAS {
        return true;
    }
    if wreg.domain == STORAGE_STACK_LOCAL && wreg.place.proj_count == 0 &&
       sc_mir_place_reads_local(pl, wreg.base_local.v) {
        return true;
    }
    false
}

fn sc_mir_op_reads_aliasing_region(
    body: view<OptBody>,
    op: view<MirOperand>,
    wreg: view<MemoryRegion>
) -> bool {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        return sc_mir_place_reads_aliasing_region(body, view(op.place), wreg);
    }
    false
}

fn sc_mir_lhs_proj_reads_aliasing_region(
    body: view<OptBody>,
    lhs_pl: view<MirPlace>,
    wreg: view<MemoryRegion>
) -> bool {
    if lhs_pl.proj_count == 0 || (lhs_pl.projs as usize) == 0 {
        return false;
    }
    let pr0 = unsafe { mir_proj_at(lhs_pl.projs, 0) };
    if (unsafe { (*pr0).kind }) == MIR_PROJ_DEREF {
        let base_pl = mir_local_place(lhs_pl.local.v);
        let breg = optir_extract_memory_region(body, view(base_pl));
        if optir_alias_query(body, wreg, view(breg)) != ALIAS_NO_ALIAS {
            return true;
        }
    }
    let mut p: usize = 0;
    while p < lhs_pl.proj_count {
        let pr = unsafe { mir_proj_at(lhs_pl.projs, p) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX {
            let idx_pl = mir_local_place(unsafe { (*pr).index_local.v });
            let ireg = optir_extract_memory_region(body, view(idx_pl));
            if optir_alias_query(body, wreg, view(ireg)) != ALIAS_NO_ALIAS {
                return true;
            }
        } else if pk == MIR_PROJ_SUB_SLICE {
            if unsafe { (*pr).has_from } {
                let f_pl = mir_local_place(unsafe { (*pr).from_local.v });
                let freg = optir_extract_memory_region(body, view(f_pl));
                if optir_alias_query(body, wreg, view(freg)) != ALIAS_NO_ALIAS {
                    return true;
                }
            }
            if unsafe { (*pr).has_to } {
                let t_pl = mir_local_place(unsafe { (*pr).to_local.v });
                let treg = optir_extract_memory_region(body, view(t_pl));
                if optir_alias_query(body, wreg, view(treg)) != ALIAS_NO_ALIAS {
                    return true;
                }
            }
        }
        p = p + 1;
    }
    false
}

fn sc_mir_stmt_reads_aliasing_region(
    body: view<OptBody>,
    st: view<MirStmt>,
    wreg: view<MemoryRegion>
) -> bool {
    if st.kind == MIR_STMT_DROP {
        return sc_mir_place_reads_aliasing_region(body, view(st.place), wreg);
    }
    if st.kind != MIR_STMT_ASSIGN {
        return false;
    }
    if st.place.proj_count > 0 && sc_mir_lhs_proj_reads_aliasing_region(body, view(st.place), wreg) {
        return true;
    }
    let rk = st.rvalue.kind;
    if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP || rk == MIR_RVALUE_CAST {
        return sc_mir_op_reads_aliasing_region(body, view(st.rvalue.use_op), wreg);
    }
    if rk == MIR_RVALUE_REPEAT {
        if sc_mir_op_reads_aliasing_region(body, view(st.rvalue.use_op), wreg) {
            return true;
        }
        let rcop = st.rvalue.repeat_count_op;
        if (rcop as usize) != 0 && sc_mir_op_reads_aliasing_region(body, unsafe { view(*rcop) }, wreg) {
            return true;
        }
        return false;
    }
    if rk == MIR_RVALUE_REF || rk == MIR_RVALUE_LEN || rk == MIR_RVALUE_DISCRIMINANT {
        return sc_mir_place_reads_aliasing_region(body, view(st.rvalue.place), wreg);
    }
    if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        return sc_mir_op_reads_aliasing_region(body, view(st.rvalue.lhs), wreg) ||
               sc_mir_op_reads_aliasing_region(body, view(st.rvalue.rhs), wreg);
    }
    if rk == MIR_RVALUE_AGGREGATE {
        let mut idx: usize = 0;
        while idx < st.rvalue.operand_count {
            let op = unsafe { mir_op_at(st.rvalue.operands, idx) };
            if sc_mir_op_reads_aliasing_region(body, unsafe { view(*op) }, wreg) {
                return true;
            }
            idx = idx + 1;
        }
    }
    false
}

fn sc_count_local_writes_in_body(body: view<OptBody>, loc_v: u32) -> u32 {
    let mut cnt: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                if !sc_inst_is_deleted_nop(unsafe { view(*inst) }) {
                    if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                       (unsafe { (*inst).place.local.v }) == loc_v {
                        cnt = cnt + 1u32;
                    }
                    if (unsafe { (*inst).opcode }) == OPT_INST_ADDR_OF &&
                       (unsafe { (*inst).rhs_place.local.v }) == loc_v {
                        cnt = cnt + 2u32;
                    }
                }
                i = i + 1;
            }
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) == OPT_TERM_CALL &&
               (unsafe { (*bb).term.has_call_dest }) && (unsafe { (*bb).term.call_dest.local.v }) == loc_v {
                cnt = cnt + 1u32;
            }
        }
        b = b + 1;
    }
    cnt
}

// --- CFG Reachability, Dead-Block Pruning & OptPhi/Dominator/MemSSA Rebuild ---

fn sc_mark_reach_target(body: view<OptBody>, reach: *mut bool, queue: *mut u32, q_len: mut_view<usize>, tgt_v: u32) {
    let idx = tgt_v as usize;
    if idx < body.bb_count && !(unsafe { *opt_bool_at(reach, idx) }) {
        unsafe {
            *opt_bool_at(reach, idx) = true;
            *opt_u32_at(queue, *q_len) = tgt_v;
        }
        *q_len = *q_len + 1;
    }
}

fn sc_mark_unwind_if_active(body: view<OptBody>, reach: *mut bool, queue: *mut u32, q_len: mut_view<usize>, unw_v: u32) {
    if unw_v != OPT_BB_NONE && (unw_v as usize) < body.bb_count {
        let ubb = unsafe { opt_block_at(body.blocks, unw_v as usize) };
        let utk = unsafe { (*ubb).term.kind };
        let uic = unsafe { (*ubb).inst_count };
        if utk != OPT_TERM_UNREACHABLE || uic > 0 {
            sc_mark_reach_target(body, reach, queue, q_len, unw_v);
        }
    }
}

fn sc_prune_unreachable_and_rebuild_cfg_ssa(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    arena: mut_view<Arena>
) -> u32 {
    let n = body.bb_count;
    if n == 0 || (body.blocks as usize) == 0 {
        return 0u32;
    }
    let reach = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let queue = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n + 2, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut b: usize = 0;
    while b < n {
        unsafe { *opt_bool_at(reach, b) = false; }
        b = b + 1;
    }

    let mut q_head: usize = 0;
    let mut q_len: usize = 0;
    sc_mark_reach_target(view(*body), reach, queue, mut_view(q_len), 0u32);

    while q_head < q_len {
        let cur = (unsafe { *opt_u32_at(queue, q_head) }) as usize;
        q_head = q_head + 1;
        let bb = unsafe { opt_block_at(body.blocks, cur) };
        if unsafe { (*bb).has_term } {
            let tk = unsafe { (*bb).term.kind };
            if tk == OPT_TERM_GOTO {
                sc_mark_reach_target(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.true_bb.v });
            } else if tk == OPT_TERM_BRANCH {
                sc_mark_reach_target(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.true_bb.v });
                sc_mark_reach_target(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.false_bb.v });
            } else if tk == OPT_TERM_SWITCH_INT {
                let swc = unsafe { (*bb).term.switch_count };
                let swt = unsafe { (*bb).term.switch_targets };
                let mut k: usize = 0;
                while k < swc {
                    let st_v = unsafe { (*opt_bbid_at(swt, k)).v };
                    sc_mark_reach_target(view(*body), reach, queue, mut_view(q_len), st_v);
                    k = k + 1;
                }
                sc_mark_reach_target(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.otherwise_bb.v });
            } else if tk == OPT_TERM_CALL || tk == OPT_TERM_ASSERT || tk == OPT_TERM_DROP {
                sc_mark_reach_target(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.true_bb.v });
                sc_mark_unwind_if_active(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.unwind_bb.v });
            }
        }
    }

    let mut pruned_blocks: u32 = 0u32;
    b = 0;
    while b < n {
        if !(unsafe { *opt_bool_at(reach, b) }) {
            let ubb = unsafe { opt_block_at(body.blocks, b) };
            if unsafe { (*ubb).is_reachable } {
                if pm.has_baseline_effects {
                    let u_eff = effect_infer_block_with_table(
                        view(*body),
                        unsafe { view(*ubb) },
                        0 as *const EffectCallTable,
                        pm.budget.max_symbolic_steps
                    );
                    if pm.baseline_effect_summary.volatile_count >= u_eff.volatile_count {
                        pm.baseline_effect_summary.volatile_count = pm.baseline_effect_summary.volatile_count - u_eff.volatile_count;
                    } else {
                        pm.baseline_effect_summary.volatile_count = 0u32;
                    }
                    if pm.baseline_effect_summary.atomic_count >= u_eff.atomic_count {
                        pm.baseline_effect_summary.atomic_count = pm.baseline_effect_summary.atomic_count - u_eff.atomic_count;
                    } else {
                        pm.baseline_effect_summary.atomic_count = 0u32;
                    }
                    if pm.baseline_effect_summary.io_count >= u_eff.io_count {
                        pm.baseline_effect_summary.io_count = pm.baseline_effect_summary.io_count - u_eff.io_count;
                    } else {
                        pm.baseline_effect_summary.io_count = 0u32;
                    }
                    if pm.baseline_effect_summary.drop_count >= u_eff.drop_count {
                        pm.baseline_effect_summary.drop_count = pm.baseline_effect_summary.drop_count - u_eff.drop_count;
                    } else {
                        pm.baseline_effect_summary.drop_count = 0u32;
                    }
                }
                pruned_blocks = pruned_blocks + 1u32;
            }
            let icnt = unsafe { (*ubb).inst_count };
            let insts = unsafe { (*ubb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                unsafe {
                    (*inst).opcode = OPT_INST_NOP;
                    (*inst).sub_op = 0u8;
                    (*inst).flags = 0u16;
                    (*inst).lhs = (OptValueId { v: OPT_VALUE_NONE });
                    (*inst).rhs = (OptValueId { v: OPT_VALUE_NONE });
                    (*inst).extra_arg_count = 0;
                    (*inst).mem_use = (MemSsaId { v: MEM_SSA_NONE });
                    (*inst).mem_def = (MemSsaId { v: MEM_SSA_NONE });
                }
                i = i + 1;
            }
            let mut loc = Span { file: (FileId { v: 0u32 }), start: 0u32, end: 0u32 };
            unsafe {
                (*ubb).inst_count = 0;
                (*ubb).phi_count = 0;
                (*ubb).has_mem_phi = false;
                (*ubb).mem_phi_result = (MemSsaId { v: MEM_SSA_NONE });
                (*ubb).is_reachable = false;
                mir_span_copy(mut_view(loc), view((*ubb).term.orig_term.location));
                mir_term_reset(mut_view((*ubb).term.orig_term), MIR_TERM_UNREACHABLE, view(loc));
                (*ubb).term.kind = OPT_TERM_UNREACHABLE;
                (*ubb).term.cond = (OptValueId { v: OPT_VALUE_NONE });
                (*ubb).term.callee = (OptValueId { v: OPT_VALUE_NONE });
                (*ubb).term.call_arg_count = 0;
                (*ubb).term.switch_count = 0;
                (*ubb).term.true_bb = (OptBbId { v: OPT_BB_NONE });
                (*ubb).term.false_bb = (OptBbId { v: OPT_BB_NONE });
                (*ubb).term.otherwise_bb = (OptBbId { v: OPT_BB_NONE });
                (*ubb).term.unwind_bb = (OptBbId { v: OPT_BB_NONE });
            }
        }
        b = b + 1;
    }

    // Recompute CFG edges and synchronize OptPhi incoming arrays to new predecessor lists
    optir_compute_cfg(mut_view(*body), mut_view(*arena));

    b = 0;
    while b < n {
        let sbb = unsafe { opt_block_at(body.blocks, b) };
        let new_pcnt = unsafe { (*sbb).pred_count };
        let new_preds = unsafe { (*sbb).preds };
        let pcnt = unsafe { (*sbb).phi_count };
        if new_pcnt == 0 {
            unsafe { (*sbb).phi_count = 0; }
        } else if pcnt > 0 {
            let phis = unsafe { (*sbb).phis };
            let mut pi: usize = 0;
            while pi < pcnt {
                let phi = unsafe { opt_phi_at(phis, pi) };
                let old_arity = unsafe { (*phi).arity };
                let old_ib = unsafe { (*phi).incoming_blocks };
                let old_iv = unsafe { (*phi).incoming_values };
                let new_ib = arena_alloc_raw(mut_view(*arena), sc_mul_usize(new_pcnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                let new_iv = arena_alloc_raw(mut_view(*arena), sc_mul_usize(new_pcnt, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
                let mut np: usize = 0;
                while np < new_pcnt {
                    let pb_v = unsafe { (*opt_bbid_at(new_preds, np)).v };
                    let mut matched_val = (OptValueId { v: OPT_VALUE_NONE });
                    let mut ok_idx: usize = 0;
                    while ok_idx < old_arity {
                        if (unsafe { (*opt_bbid_at(old_ib, ok_idx)).v }) == pb_v {
                            matched_val = unsafe { *opt_valid_at(old_iv, ok_idx) };
                            break;
                        }
                        ok_idx = ok_idx + 1;
                    }
                    unsafe {
                        *opt_bbid_at(new_ib, np) = (OptBbId { v: pb_v });
                        *opt_valid_at(new_iv, np) = matched_val;
                    }
                    np = np + 1;
                }
                unsafe {
                    (*phi).arity = new_pcnt;
                    (*phi).incoming_blocks = new_ib;
                    (*phi).incoming_values = new_iv;
                }
                pi = pi + 1;
            }
        }
        b = b + 1;
    }

    optir_compute_dominators(mut_view(*body), mut_view(*arena));
    optir_compute_dom_frontier(mut_view(*body), mut_view(*arena));
    optir_simplify_trivial_phis(mut_view(*body));
    optir_construct_memssa(mut_view(*body), mut_view(*arena));
    pruned_blocks
}

unsafe fn sc_rewrite_term_to_goto(bb: *mut OptBlock, target_bb: OptBbId) {
    let mut loc = Span { file: (FileId { v: 0u32 }), start: 0u32, end: 0u32 };
    mir_span_copy(mut_view(loc), view((*bb).term.orig_term.location));
    mir_term_reset(mut_view((*bb).term.orig_term), MIR_TERM_GOTO, view(loc));
    (*bb).term.orig_term.goto_target = (MirBbId { v: target_bb.v });
    (*bb).term.kind = OPT_TERM_GOTO;
    (*bb).term.true_bb = target_bb;
    (*bb).term.false_bb = (OptBbId { v: OPT_BB_NONE });
    (*bb).term.otherwise_bb = (OptBbId { v: OPT_BB_NONE });
    (*bb).term.unwind_bb = (OptBbId { v: OPT_BB_NONE });
    (*bb).term.cond = (OptValueId { v: OPT_VALUE_NONE });
    (*bb).term.callee = (OptValueId { v: OPT_VALUE_NONE });
    (*bb).term.call_arg_count = 0;
    (*bb).term.switch_count = 0;
}

// ============================================================================
// Component A: Wegman-Zadeck Sparse Conditional Constant Propagation (AXS-OPT-045)
// ============================================================================

fn sc_sccp_raise(
    val_v: u32,
    vcnt: usize,
    new_state: u8,
    new_cval: u64,
    lat_state: *mut u8,
    lat_val: *mut u64,
    ssa_wl: *mut u32,
    ssa_wl_len: mut_view<usize>,
    ssa_wl_cap: usize
) {
    let idx = val_v as usize;
    if val_v == OPT_VALUE_NONE || idx > vcnt || new_state == SCCP_TOP {
        return;
    }
    let cur_state = unsafe { *opt_u8_at(lat_state, idx) };
    if cur_state == SCCP_OVERDEFINED {
        return;
    }
    if cur_state == SCCP_TOP {
        unsafe {
            *opt_u8_at(lat_state, idx) = new_state;
            *opt_u64_at(lat_val, idx) = if new_state == SCCP_CONST { new_cval } else { 0u64 };
        }
        if *ssa_wl_len < ssa_wl_cap {
            unsafe { *opt_u32_at(ssa_wl, *ssa_wl_len) = val_v; }
            *ssa_wl_len = *ssa_wl_len + 1;
        }
        return;
    }
    // cur_state == SCCP_CONST
    let cur_cval = unsafe { *opt_u64_at(lat_val, idx) };
    if new_state == SCCP_OVERDEFINED || (new_state == SCCP_CONST && cur_cval != new_cval) {
        unsafe {
            *opt_u8_at(lat_state, idx) = SCCP_OVERDEFINED;
            *opt_u64_at(lat_val, idx) = 0u64;
        }
        if *ssa_wl_len < ssa_wl_cap {
            unsafe { *opt_u32_at(ssa_wl, *ssa_wl_len) = val_v; }
            *ssa_wl_len = *ssa_wl_len + 1;
        }
    }
}

fn sc_sccp_mark_edge(
    from_b: usize,
    to_b_v: u32,
    n: usize,
    edge_exec: *mut bool,
    cfg_wl_from: *mut u32,
    cfg_wl_to: *mut u32,
    cfg_wl_len: mut_view<usize>,
    cfg_wl_cap: usize
) {
    let to_b = to_b_v as usize;
    if from_b >= n || to_b >= n {
        return;
    }
    let eidx = sc_mul_usize(from_b, n) + to_b;
    if !(unsafe { *opt_bool_at(edge_exec, eidx) }) {
        unsafe { *opt_bool_at(edge_exec, eidx) = true; }
        if *cfg_wl_len < cfg_wl_cap {
            unsafe {
                *opt_u32_at(cfg_wl_from, *cfg_wl_len) = from_b as u32;
                *opt_u32_at(cfg_wl_to, *cfg_wl_len) = to_b as u32;
            }
            *cfg_wl_len = *cfg_wl_len + 1;
        }
    }
}

fn sc_sccp_eval_phi(
    pm: view<PassManager>,
    body: view<OptBody>,
    b_idx: usize,
    phi_idx: usize,
    lat_state: *mut u8,
    lat_val: *mut u64,
    edge_exec: *mut bool,
    ssa_wl: *mut u32,
    ssa_wl_len: mut_view<usize>,
    ssa_wl_cap: usize
) {
    let bb = unsafe { opt_block_at(body.blocks, b_idx) };
    let phi = unsafe { opt_phi_at((*bb).phis, phi_idx) };
    let res_v = unsafe { (*phi).result.v };
    let vcnt = body.value_count;
    if res_v == OPT_VALUE_NONE || (res_v as usize) > vcnt {
        return;
    }
    let phi_ty = (TypeId { v: unsafe { (*phi).ty.v } });
    if !scalar_type_is_discrete(body.thir, (TypeId { v: phi_ty.v })) ||
       scalar_raw_val_has_fp_hazard(pm, body, (OptValueId { v: res_v })) {
        sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        return;
    }
    let arity = unsafe { (*phi).arity };
    let ibs = unsafe { (*phi).incoming_blocks };
    let ivs = unsafe { (*phi).incoming_values };
    let n = body.bb_count;
    let mut acc_state = SCCP_TOP;
    let mut acc_val: u64 = 0u64;
    let mut k: usize = 0;
    while k < arity {
        let pb = (unsafe { (*opt_bbid_at(ibs, k)).v }) as usize;
        if pb < n && (unsafe { *opt_bool_at(edge_exec, sc_mul_usize(pb, n) + b_idx) }) {
            let iv_v = unsafe { (*opt_valid_at(ivs, k)).v };
            if iv_v == OPT_VALUE_NONE || (iv_v as usize) > vcnt ||
               scalar_raw_val_has_fp_hazard(pm, body, (OptValueId { v: iv_v })) {
                acc_state = SCCP_OVERDEFINED;
                break;
            }
            let st = unsafe { *opt_u8_at(lat_state, iv_v as usize) };
            let cv = unsafe { *opt_u64_at(lat_val, iv_v as usize) };
            if st == SCCP_OVERDEFINED {
                acc_state = SCCP_OVERDEFINED;
                break;
            } else if st == SCCP_CONST {
                if acc_state == SCCP_TOP {
                    acc_state = SCCP_CONST;
                    acc_val = cv;
                } else if acc_state == SCCP_CONST && acc_val != cv {
                    acc_state = SCCP_OVERDEFINED;
                    break;
                }
            }
        }
        k = k + 1;
    }
    sc_sccp_raise(res_v, vcnt, acc_state, acc_val, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
}

fn sc_sccp_eval_inst(
    pm: view<PassManager>,
    body: view<OptBody>,
    inst: view<OptInst>,
    lat_state: *mut u8,
    lat_val: *mut u64,
    ssa_wl: *mut u32,
    ssa_wl_len: mut_view<usize>,
    ssa_wl_cap: usize
) {
    let res_v = inst.result.v;
    let vcnt = body.value_count;
    if res_v == OPT_VALUE_NONE || (res_v as usize) > vcnt {
        return;
    }
    let opc = inst.opcode;
    if opc == OPT_INST_NOP {
        return;
    }
    // Barriers and non-discrete/float-hazard instructions strictly evaluate to Overdefined (REQ-OPT-011, REQ-OPT-397)
    if opc == OPT_INST_BLACK_BOX || opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_ATOMIC ||
       (inst.flags & OPT_FLAG_BARRIER) != 0u16 ||
       !scalar_type_is_discrete(body.thir, (TypeId { v: inst.ty.v })) ||
       scalar_raw_val_has_fp_hazard(pm, body, (OptValueId { v: res_v })) ||
       scalar_raw_val_has_fp_hazard(pm, body, (OptValueId { v: inst.lhs.v })) ||
       scalar_raw_val_has_fp_hazard(pm, body, (OptValueId { v: inst.rhs.v })) {
        sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        return;
    }

    if opc == OPT_INST_CONST {
        if inst.lhs.v != OPT_VALUE_NONE && (inst.lhs.v as usize) <= vcnt {
            let ls = unsafe { *opt_u8_at(lat_state, inst.lhs.v as usize) };
            let lv = unsafe { *opt_u64_at(lat_val, inst.lhs.v as usize) };
            sc_sccp_raise(res_v, vcnt, ls, lv, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        }
        return;
    }
    if opc == OPT_INST_COPY {
        if inst.lhs.v != OPT_VALUE_NONE && (inst.lhs.v as usize) <= vcnt {
            let ls = unsafe { *opt_u8_at(lat_state, inst.lhs.v as usize) };
            let lv = unsafe { *opt_u64_at(lat_val, inst.lhs.v as usize) };
            sc_sccp_raise(res_v, vcnt, ls, lv, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        } else {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        }
        return;
    }
    if opc == OPT_INST_UNOP {
        let lhs_v = inst.lhs.v;
        if lhs_v == OPT_VALUE_NONE || (lhs_v as usize) > vcnt {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
            return;
        }
        let ls = unsafe { *opt_u8_at(lat_state, lhs_v as usize) };
        if ls == SCCP_TOP {
            return;
        }
        if ls == SCCP_OVERDEFINED {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
            return;
        }
        let lv = unsafe { *opt_u64_at(lat_val, lhs_v as usize) };
        let op_ty = scalar_val_ty(body, (OptValueId { v: lhs_v }), (TypeId { v: inst.ty.v }));
        let mut out_v: u64 = 0u64;
        let mut ovf = false;
        if scalar_eval_const_unop(body.thir, inst.sub_op, (TypeId { v: op_ty.v }), lv, mut_view(out_v), mut_view(ovf)) && !ovf {
            sc_sccp_raise(res_v, vcnt, SCCP_CONST, out_v, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        } else {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        }
        return;
    }
    if opc == OPT_INST_CAST {
        let lhs_v = inst.lhs.v;
        if lhs_v == OPT_VALUE_NONE || (lhs_v as usize) > vcnt {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
            return;
        }
        let ls = unsafe { *opt_u8_at(lat_state, lhs_v as usize) };
        if ls == SCCP_TOP {
            return;
        }
        if ls == SCCP_OVERDEFINED {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
            return;
        }
        let lv = unsafe { *opt_u64_at(lat_val, lhs_v as usize) };
        let src_ty = scalar_val_ty(body, (OptValueId { v: lhs_v }), (TypeId { v: 0u32 }));
        let mut out_v: u64 = 0u64;
        if scalar_eval_const_cast(body.thir, inst.sub_op, (TypeId { v: src_ty.v }), (TypeId { v: inst.ty.v }), lv, mut_view(out_v)) {
            sc_sccp_raise(res_v, vcnt, SCCP_CONST, out_v, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        } else {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        }
        return;
    }
    if opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP || opc == OPT_INST_CHECKED_BINOP {
        let lhs_v = inst.lhs.v;
        let rhs_v = inst.rhs.v;
        if lhs_v == OPT_VALUE_NONE || rhs_v == OPT_VALUE_NONE ||
           (lhs_v as usize) > vcnt || (rhs_v as usize) > vcnt {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
            return;
        }
        let ls = unsafe { *opt_u8_at(lat_state, lhs_v as usize) };
        let rs = unsafe { *opt_u8_at(lat_state, rhs_v as usize) };
        if ls == SCCP_CONST && rs == SCCP_CONST {
            let lv = unsafe { *opt_u64_at(lat_val, lhs_v as usize) };
            let rv = unsafe { *opt_u64_at(lat_val, rhs_v as usize) };
            let lhs_ty = scalar_val_ty(body, (OptValueId { v: lhs_v }), (TypeId { v: inst.ty.v }));
            let rhs_ty = scalar_val_ty(body, (OptValueId { v: rhs_v }), (TypeId { v: lhs_ty.v }));
            if !scalar_type_is_discrete(body.thir, (TypeId { v: lhs_ty.v })) {
                sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
                return;
            }
            let mut out_v: u64 = 0u64;
            let mut ovf = false;
            if scalar_eval_const_binop(body.thir, opc, inst.sub_op, (TypeId { v: lhs_ty.v }), (TypeId { v: rhs_ty.v }), (TypeId { v: inst.ty.v }), lv, rv, mut_view(out_v), mut_view(ovf)) {
                if opc == OPT_INST_CHECKED_BINOP {
                    let b_res: u64 = if ovf { 1u64 } else { 0u64 };
                    sc_sccp_raise(res_v, vcnt, SCCP_CONST, b_res, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
                } else if !ovf {
                    sc_sccp_raise(res_v, vcnt, SCCP_CONST, out_v, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
                } else {
                    // Checked overflow/div-by-zero/shift-OOB fails closed to preserve runtime trap (REQ-OPT-363..364)
                    sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
                }
            } else {
                sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
            }
            return;
        }
        if ls == SCCP_OVERDEFINED || rs == SCCP_OVERDEFINED {
            sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        }
        return;
    }

    // Loads, field extracts, aggregates, lengths, discriminants, addresses are Overdefined in SCCP
    sc_sccp_raise(res_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
}

fn sc_sccp_mark_unwind_edge_if_valid(
    body: view<OptBody>,
    from_b: usize,
    unw_v: u32,
    edge_exec: *mut bool,
    cfg_wl_from: *mut u32,
    cfg_wl_to: *mut u32,
    cfg_wl_len: mut_view<usize>,
    cfg_wl_cap: usize
) {
    let n = body.bb_count;
    if unw_v != OPT_BB_NONE && (unw_v as usize) < n {
        let ubb = unsafe { opt_block_at(body.blocks, unw_v as usize) };
        let utk = unsafe { (*ubb).term.kind };
        let uic = unsafe { (*ubb).inst_count };
        if utk != OPT_TERM_UNREACHABLE || uic > 0 {
            sc_sccp_mark_edge(from_b, unw_v, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        }
    }
}

fn sc_sccp_eval_term(
    body: view<OptBody>,
    b_idx: usize,
    lat_state: *mut u8,
    lat_val: *mut u64,
    edge_exec: *mut bool,
    cfg_wl_from: *mut u32,
    cfg_wl_to: *mut u32,
    cfg_wl_len: mut_view<usize>,
    cfg_wl_cap: usize,
    ssa_wl: *mut u32,
    ssa_wl_len: mut_view<usize>,
    ssa_wl_cap: usize
) {
    let n = body.bb_count;
    let vcnt = body.value_count;
    let bb = unsafe { opt_block_at(body.blocks, b_idx) };
    if !(unsafe { (*bb).has_term }) {
        return;
    }
    let tk = unsafe { (*bb).term.kind };
    if tk == OPT_TERM_GOTO {
        sc_sccp_mark_edge(b_idx, unsafe { (*bb).term.true_bb.v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        return;
    }
    if tk == OPT_TERM_BRANCH {
        let cv = unsafe { (*bb).term.cond.v };
        if cv == OPT_VALUE_NONE || (cv as usize) > vcnt {
            sc_sccp_mark_edge(b_idx, unsafe { (*bb).term.true_bb.v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            sc_sccp_mark_edge(b_idx, unsafe { (*bb).term.false_bb.v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            return;
        }
        let cs = unsafe { *opt_u8_at(lat_state, cv as usize) };
        if cs == SCCP_CONST {
            let cval = unsafe { *opt_u64_at(lat_val, cv as usize) };
            let target_v: u32 = if cval != 0u64 { unsafe { (*bb).term.true_bb.v } } else { unsafe { (*bb).term.false_bb.v } };
            sc_sccp_mark_edge(b_idx, target_v, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        } else if cs == SCCP_OVERDEFINED {
            sc_sccp_mark_edge(b_idx, unsafe { (*bb).term.true_bb.v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            sc_sccp_mark_edge(b_idx, unsafe { (*bb).term.false_bb.v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        }
        return;
    }
    if tk == OPT_TERM_SWITCH_INT {
        let cv = unsafe { (*bb).term.cond.v };
        let swc = unsafe { (*bb).term.switch_count };
        let swv = unsafe { (*bb).term.switch_vals };
        let swt = unsafe { (*bb).term.switch_targets };
        let ow_v = unsafe { (*bb).term.otherwise_bb.v };
        if cv == OPT_VALUE_NONE || (cv as usize) > vcnt {
            let mut k: usize = 0;
            while k < swc {
                sc_sccp_mark_edge(b_idx, unsafe { (*opt_bbid_at(swt, k)).v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
                k = k + 1;
            }
            sc_sccp_mark_edge(b_idx, ow_v, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            return;
        }
        let cs = unsafe { *opt_u8_at(lat_state, cv as usize) };
        if cs == SCCP_CONST {
            let raw_c = unsafe { *opt_u64_at(lat_val, cv as usize) };
            let sw_bits = opt_type_bits(body.thir, (TypeId { v: unsafe { (*bb).term.switch_ty.v } }));
            let masked_c: u64 = if sw_bits > 0u32 && sw_bits <= 64u32 { raw_c & opt_bit_mask(sw_bits) } else { raw_c };
            let mut chosen_v = ow_v;
            let mut k: usize = 0;
            while k < swc {
                if (unsafe { *opt_u64_at(swv, k) }) == masked_c {
                    chosen_v = unsafe { (*opt_bbid_at(swt, k)).v };
                    break;
                }
                k = k + 1;
            }
            sc_sccp_mark_edge(b_idx, chosen_v, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        } else if cs == SCCP_OVERDEFINED {
            let mut k: usize = 0;
            while k < swc {
                sc_sccp_mark_edge(b_idx, unsafe { (*opt_bbid_at(swt, k)).v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
                k = k + 1;
            }
            sc_sccp_mark_edge(b_idx, ow_v, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        }
        return;
    }
    if tk == OPT_TERM_ASSERT {
        let cv = unsafe { (*bb).term.cond.v };
        let exp = unsafe { (*bb).term.assert_expected };
        let t_v = unsafe { (*bb).term.true_bb.v };
        let u_v = unsafe { (*bb).term.unwind_bb.v };
        if cv == OPT_VALUE_NONE || (cv as usize) > vcnt {
            sc_sccp_mark_edge(b_idx, t_v, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            sc_sccp_mark_unwind_edge_if_valid(body, b_idx, u_v, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            return;
        }
        let cs = unsafe { *opt_u8_at(lat_state, cv as usize) };
        if cs == SCCP_CONST {
            let cbool = (unsafe { *opt_u64_at(lat_val, cv as usize) }) != 0u64;
            if cbool == exp {
                sc_sccp_mark_edge(b_idx, t_v, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            } else {
                sc_sccp_mark_unwind_edge_if_valid(body, b_idx, u_v, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            }
        } else if cs == SCCP_OVERDEFINED {
            sc_sccp_mark_edge(b_idx, t_v, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
            sc_sccp_mark_unwind_edge_if_valid(body, b_idx, u_v, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        }
        return;
    }
    if tk == OPT_TERM_CALL {
        if (unsafe { (*bb).term.has_call_dest }) {
            let cres_v = unsafe { (*bb).term.call_result.v };
            sc_sccp_raise(cres_v, vcnt, SCCP_OVERDEFINED, 0u64, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        }
        sc_sccp_mark_edge(b_idx, unsafe { (*bb).term.true_bb.v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        sc_sccp_mark_unwind_edge_if_valid(body, b_idx, unsafe { (*bb).term.unwind_bb.v }, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        return;
    }
    if tk == OPT_TERM_DROP {
        sc_sccp_mark_edge(b_idx, unsafe { (*bb).term.true_bb.v }, n, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
        sc_sccp_mark_unwind_edge_if_valid(body, b_idx, unsafe { (*bb).term.unwind_bb.v }, edge_exec, cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap);
    }
}

fn sc_sccp_visit_block_full(
    pm: view<PassManager>,
    body: view<OptBody>,
    b_idx: usize,
    lat_state: *mut u8,
    lat_val: *mut u64,
    edge_exec: *mut bool,
    cfg_wl_from: *mut u32,
    cfg_wl_to: *mut u32,
    cfg_wl_len: mut_view<usize>,
    cfg_wl_cap: usize,
    ssa_wl: *mut u32,
    ssa_wl_len: mut_view<usize>,
    ssa_wl_cap: usize
) {
    let bb = unsafe { opt_block_at(body.blocks, b_idx) };
    let pcnt = unsafe { (*bb).phi_count };
    let mut p: usize = 0;
    while p < pcnt {
        sc_sccp_eval_phi(pm, body, b_idx, p, lat_state, lat_val, edge_exec, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        p = p + 1;
    }
    let icnt = unsafe { (*bb).inst_count };
    let insts = unsafe { (*bb).insts };
    let mut i: usize = 0;
    while i < icnt {
        let inst = unsafe { opt_inst_at(insts, i) };
        sc_sccp_eval_inst(pm, body, unsafe { view(*inst) }, lat_state, lat_val, ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap);
        i = i + 1;
    }
    sc_sccp_eval_term(
        body, b_idx, lat_state, lat_val, edge_exec,
        cfg_wl_from, cfg_wl_to, mut_view(*cfg_wl_len), cfg_wl_cap,
        ssa_wl, mut_view(*ssa_wl_len), ssa_wl_cap
    );
}

pub fn scalar_run_sccp(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    stats: mut_view<ScalarOptStats>,
    arena: mut_view<Arena>
) -> bool {
    let _ = call_table;
    let n = body.bb_count;
    if n == 0 || (body.blocks as usize) == 0 {
        return false;
    }
    let vcnt = body.value_count;
    let v_alloc = vcnt + 2;
    let lat_state = arena_alloc_raw(mut_view(*arena), sc_mul_usize(v_alloc, size_of<u8>()), align_of<u8>());
    let lat_val = arena_alloc_raw(mut_view(*arena), sc_mul_usize(v_alloc, size_of<u64>()), align_of<u64>()) as *mut u64;
    let bb_exec = arena_alloc_raw(mut_view(*arena), sc_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let edge_cnt = sc_mul_usize(n, n);
    let edge_alloc: usize = if edge_cnt == 0 { 1 } else { edge_cnt };
    let edge_exec = arena_alloc_raw(mut_view(*arena), sc_mul_usize(edge_alloc, size_of<bool>()), align_of<bool>()) as *mut bool;

    let cfg_wl_cap = edge_alloc + 4;
    let cfg_wl_from = arena_alloc_raw(mut_view(*arena), sc_mul_usize(cfg_wl_cap, size_of<u32>()), align_of<u32>()) as *mut u32;
    let cfg_wl_to = arena_alloc_raw(mut_view(*arena), sc_mul_usize(cfg_wl_cap, size_of<u32>()), align_of<u32>()) as *mut u32;
    let ssa_wl_cap = sc_mul_usize(v_alloc, 3) + 8;
    let ssa_wl = arena_alloc_raw(mut_view(*arena), sc_mul_usize(ssa_wl_cap, size_of<u32>()), align_of<u32>()) as *mut u32;

    let mut vi: usize = 0;
    while vi < v_alloc {
        unsafe {
            *opt_u8_at(lat_state, vi) = SCCP_TOP;
            *opt_u64_at(lat_val, vi) = 0u64;
        }
        vi = vi + 1;
    }
    let mut bi: usize = 0;
    while bi < n {
        unsafe { *opt_bool_at(bb_exec, bi) = false; }
        bi = bi + 1;
    }
    let mut ei: usize = 0;
    while ei < edge_alloc {
        unsafe { *opt_bool_at(edge_exec, ei) = false; }
        ei = ei + 1;
    }

    // Seed parameter and constant SSA values
    if (body.values as usize) != 0 {
        vi = 1;
        while vi <= vcnt {
            let vp = unsafe { opt_val_at(body.values, vi) };
            let vk = unsafe { (*vp).kind };
            let vty = (TypeId { v: unsafe { (*vp).ty.v } });
            if vk == OPT_VAL_PARAM {
                unsafe { *opt_u8_at(lat_state, vi) = SCCP_OVERDEFINED; }
            } else if vk == OPT_VAL_CONST {
                let ck = unsafe { (*vp).const_val.kind };
                if (ck == MIR_CONST_INT || ck == MIR_CONST_BOOL) &&
                   scalar_type_is_discrete(body.thir, (TypeId { v: vty.v })) &&
                   !scalar_raw_val_has_fp_hazard(view(*pm), view(*body), (OptValueId { v: vi as u32 })) {
                    let raw_v = unsafe { (*vp).const_val.val };
                    let norm_v: u64 = if scalar_type_is_bool_ty(body.thir, (TypeId { v: vty.v })) {
                        if raw_v != 0u64 { 1u64 } else { 0u64 }
                    } else {
                        let bits = opt_type_bits(body.thir, (TypeId { v: vty.v }));
                        if bits > 0u32 && bits <= 64u32 { raw_v & opt_bit_mask(bits) } else { raw_v }
                    };
                    unsafe {
                        *opt_u8_at(lat_state, vi) = SCCP_CONST;
                        *opt_u64_at(lat_val, vi) = norm_v;
                    }
                } else {
                    unsafe { *opt_u8_at(lat_state, vi) = SCCP_OVERDEFINED; }
                }
            }
            vi = vi + 1;
        }
    }

    let mut cfg_wl_head: usize = 0;
    let mut cfg_wl_len: usize = 0;
    let mut ssa_wl_head: usize = 0;
    let mut ssa_wl_len: usize = 0;

    // Seed entry block bb0 executable
    unsafe { *opt_bool_at(bb_exec, 0) = true; }
    sc_sccp_visit_block_full(
        view(*pm), view(*body), 0, lat_state, lat_val, edge_exec,
        cfg_wl_from, cfg_wl_to, mut_view(cfg_wl_len), cfg_wl_cap,
        ssa_wl, mut_view(ssa_wl_len), ssa_wl_cap
    );

    // Solve Wegman-Zadeck sparse dataflow + CFG reachability fixed point
    while cfg_wl_head < cfg_wl_len || ssa_wl_head < ssa_wl_len {
        while cfg_wl_head < cfg_wl_len {
            let _from_b = (unsafe { *opt_u32_at(cfg_wl_from, cfg_wl_head) }) as usize;
            let to_b = (unsafe { *opt_u32_at(cfg_wl_to, cfg_wl_head) }) as usize;
            cfg_wl_head = cfg_wl_head + 1;
            if to_b < n {
                if !(unsafe { *opt_bool_at(bb_exec, to_b) }) {
                    unsafe { *opt_bool_at(bb_exec, to_b) = true; }
                    sc_sccp_visit_block_full(
                        view(*pm), view(*body), to_b, lat_state, lat_val, edge_exec,
                        cfg_wl_from, cfg_wl_to, mut_view(cfg_wl_len), cfg_wl_cap,
                        ssa_wl, mut_view(ssa_wl_len), ssa_wl_cap
                    );
                } else {
                    let tbb = unsafe { opt_block_at(body.blocks, to_b) };
                    let pcnt = unsafe { (*tbb).phi_count };
                    let mut p: usize = 0;
                    while p < pcnt {
                        sc_sccp_eval_phi(
                            view(*pm), view(*body), to_b, p, lat_state, lat_val, edge_exec,
                            ssa_wl, mut_view(ssa_wl_len), ssa_wl_cap
                        );
                        p = p + 1;
                    }
                }
            }
        }

        if ssa_wl_head < ssa_wl_len {
            let changed_v = unsafe { *opt_u32_at(ssa_wl, ssa_wl_head) };
            ssa_wl_head = ssa_wl_head + 1;
            let mut b: usize = 0;
            while b < n {
                if unsafe { *opt_bool_at(bb_exec, b) } {
                    let bb = unsafe { opt_block_at(body.blocks, b) };
                    let pcnt = unsafe { (*bb).phi_count };
                    let phis = unsafe { (*bb).phis };
                    let mut p: usize = 0;
                    while p < pcnt {
                        let phi = unsafe { opt_phi_at(phis, p) };
                        let arity = unsafe { (*phi).arity };
                        let ivs = unsafe { (*phi).incoming_values };
                        let mut uses_v = false;
                        let mut k: usize = 0;
                        while k < arity {
                            if (unsafe { (*opt_valid_at(ivs, k)).v }) == changed_v {
                                uses_v = true;
                                break;
                            }
                            k = k + 1;
                        }
                        if uses_v {
                            sc_sccp_eval_phi(
                                view(*pm), view(*body), b, p, lat_state, lat_val, edge_exec,
                                ssa_wl, mut_view(ssa_wl_len), ssa_wl_cap
                            );
                        }
                        p = p + 1;
                    }
                    let icnt = unsafe { (*bb).inst_count };
                    let insts = unsafe { (*bb).insts };
                    let mut i: usize = 0;
                    while i < icnt {
                        let inst = unsafe { opt_inst_at(insts, i) };
                        if (unsafe { (*inst).lhs.v }) == changed_v || (unsafe { (*inst).rhs.v }) == changed_v {
                            sc_sccp_eval_inst(
                                view(*pm), view(*body), unsafe { view(*inst) }, lat_state, lat_val,
                                ssa_wl, mut_view(ssa_wl_len), ssa_wl_cap
                            );
                        }
                        i = i + 1;
                    }
                    if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.cond.v }) == changed_v {
                        sc_sccp_eval_term(
                            view(*body), b, lat_state, lat_val, edge_exec,
                            cfg_wl_from, cfg_wl_to, mut_view(cfg_wl_len), cfg_wl_cap,
                            ssa_wl, mut_view(ssa_wl_len), ssa_wl_cap
                        );
                    }
                }
                b = b + 1;
            }
        }
    }

    // Materialize proven constants and prune dead edges/blocks
    let mut changed = false;
    let mut cfg_changed = false;

    // 1. Fold constant OptPhis in executable blocks
    bi = 0;
    while bi < n {
        if unsafe { *opt_bool_at(bb_exec, bi) } {
            let bb = unsafe { opt_block_at(body.blocks, bi) };
            let pcnt = unsafe { (*bb).phi_count };
            let phis = unsafe { (*bb).phis };
            let mut write_p: usize = 0;
            let mut p: usize = 0;
            while p < pcnt {
                let phi = unsafe { opt_phi_at(phis, p) };
                let pres_v = unsafe { (*phi).result.v };
                let pty = (TypeId { v: unsafe { (*phi).ty.v } });
                let mut folded_phi = false;
                if pres_v != OPT_VALUE_NONE && (pres_v as usize) <= vcnt &&
                   (unsafe { *opt_u8_at(lat_state, pres_v as usize) }) == SCCP_CONST &&
                   scalar_type_is_discrete(body.thir, (TypeId { v: pty.v })) {
                    let cand = CandidateRewrite {
                        pass_id: PASS_SCCP,
                        required_prop: PROP_NO_OVERFLOW,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_RANGE_INFO,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        let cval = unsafe { *opt_u64_at(lat_val, pres_v as usize) };
                        let c_vid = scalar_alloc_const_value(
                            mut_view(*body),
                            mut_view(*arena),
                            (TypeId { v: pty.v }),
                            cval,
                            bi as u32,
                            OPT_INST_NONE,
                            PASS_SCCP
                        );
                        sc_replace_value_in_body(mut_view(*body), (OptValueId { v: pres_v }), c_vid);
                        stats.sccp_consts_folded = stats.sccp_consts_folded + 1u32;
                        changed = true;
                        folded_phi = true;
                    } else {
                        stats.rejected_candidates = stats.rejected_candidates + 1u32;
                    }
                }
                if !folded_phi {
                    if write_p != p {
                        let dst_phi = unsafe { opt_phi_at(phis, write_p) };
                        unsafe {
                            ptr_copy_nonoverlapping<u8>(phi as *const u8, dst_phi as *mut u8, size_of<OptPhi>());
                        }
                    }
                    write_p = write_p + 1;
                }
                p = p + 1;
            }
            unsafe { (*bb).phi_count = write_p; }
        }
        bi = bi + 1;
    }

    // 2. Fold constant OptInsts in executable blocks
    bi = 0;
    while bi < n {
        if unsafe { *opt_bool_at(bb_exec, bi) } {
            let bb = unsafe { opt_block_at(body.blocks, bi) };
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let flg = unsafe { (*inst).flags };
                let res_v = unsafe { (*inst).result.v };
                let is_foldable_opc = opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP ||
                                      opc == OPT_INST_CHECKED_BINOP || opc == OPT_INST_UNOP ||
                                      opc == OPT_INST_CAST || opc == OPT_INST_COPY;
                if is_foldable_opc &&
                   (flg & (OPT_FLAG_BARRIER | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
                   (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                   (unsafe { (*inst).place.proj_count }) == 0 &&
                   !sc_mir_stmt_has_move_operand(unsafe { view((*inst).orig_stmt) }) &&
                   scalar_type_is_discrete(body.thir, (TypeId { v: unsafe { (*inst).ty.v } })) {
                    let mut has_c = false;
                    let mut cval: u64 = 0u64;
                    if res_v != OPT_VALUE_NONE && (res_v as usize) <= vcnt &&
                       (unsafe { *opt_u8_at(lat_state, res_v as usize) }) == SCCP_CONST {
                        has_c = true;
                        cval = unsafe { *opt_u64_at(lat_val, res_v as usize) };
                    } else if pm_value_is_const_int(view(*pm), view(*body), (OptValueId { v: res_v }), mut_view(cval)) {
                        has_c = true;
                    }
                    if has_c {
                        let cand = CandidateRewrite {
                            pass_id: PASS_SCCP,
                            required_prop: PROP_NO_OVERFLOW,
                            proof_certainty: CERTAINTY_PROVEN,
                            proof_source_analysis: ANALYSIS_RANGE_INFO,
                            proof_revision: pm.ir_revision,
                            target_effect_flags: EFFECT_PURE,
                            src_view_kind: 0u8,
                            dst_view_kind: 0u8,
                            is_removing_inst: false,
                            cost_delta: -2i32,
                        };
                        if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                            optir_record_provenance(
                                mut_view(*body),
                                mut_view(*arena),
                                PROP_NO_OVERFLOW,
                                CERTAINTY_PROVEN,
                                ANALYSIS_RANGE_INFO,
                                (OptValueId { v: res_v }),
                                (OptValueId { v: OPT_VALUE_NONE }),
                                (OptBbId { v: bi as u32 }),
                                (OptInstId { v: unsafe { (*inst).id.v } }),
                                PASS_SCCP
                            );
                            unsafe {
                                sc_rewrite_inst_to_const(mut_view(*body), mut_view(*arena), inst, bi as u32, PASS_SCCP, cval);
                            }
                            stats.sccp_consts_folded = stats.sccp_consts_folded + 1u32;
                            changed = true;
                        } else {
                            stats.rejected_candidates = stats.rejected_candidates + 1u32;
                        }
                    }
                }
                i = i + 1;
            }
        }
        bi = bi + 1;
    }

    // 3. Fold constant terminators (BRANCH, SWITCH_INT, and proven-succeeding ASSERT)
    bi = 0;
    while bi < n {
        let bb = unsafe { opt_block_at(body.blocks, bi) };
        if unsafe { *opt_bool_at(bb_exec, bi) } {
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                let cond_v = unsafe { (*bb).term.cond.v };
                let mut has_cond_c = false;
                let mut cond_cval: u64 = 0u64;
                if cond_v != OPT_VALUE_NONE && (cond_v as usize) <= vcnt &&
                   (unsafe { *opt_u8_at(lat_state, cond_v as usize) }) == SCCP_CONST {
                    has_cond_c = true;
                    cond_cval = unsafe { *opt_u64_at(lat_val, cond_v as usize) };
                } else if pm_value_is_const_int(view(*pm), view(*body), (OptValueId { v: cond_v }), mut_view(cond_cval)) {
                    has_cond_c = true;
                }

                if tk == OPT_TERM_BRANCH && has_cond_c &&
                   !sc_mir_op_is_drop_move(view(*body), unsafe { view((*bb).term.orig_term.discr) }) {
                    let cand = CandidateRewrite {
                        pass_id: PASS_SCCP,
                        required_prop: PROP_REACHABLE,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_CFG,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        let tgt: OptBbId = if cond_cval != 0u64 {
                            unsafe { (*bb).term.true_bb }
                        } else {
                            unsafe { (*bb).term.false_bb }
                        };
                        unsafe { sc_rewrite_term_to_goto(bb, tgt); }
                        stats.sccp_branches_folded = stats.sccp_branches_folded + 1u32;
                        changed = true;
                        cfg_changed = true;
                    } else {
                        stats.rejected_candidates = stats.rejected_candidates + 1u32;
                    }
                } else if tk == OPT_TERM_SWITCH_INT && has_cond_c &&
                          !sc_mir_op_is_drop_move(view(*body), unsafe { view((*bb).term.orig_term.discr) }) {
                    let cand = CandidateRewrite {
                        pass_id: PASS_SCCP,
                        required_prop: PROP_REACHABLE,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_CFG,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        let swc = unsafe { (*bb).term.switch_count };
                        let swv = unsafe { (*bb).term.switch_vals };
                        let swt = unsafe { (*bb).term.switch_targets };
                        let sw_bits = opt_type_bits(body.thir, (TypeId { v: unsafe { (*bb).term.switch_ty.v } }));
                        let masked_c: u64 = if sw_bits > 0u32 && sw_bits <= 64u32 { cond_cval & opt_bit_mask(sw_bits) } else { cond_cval };
                        let mut tgt = unsafe { (*bb).term.otherwise_bb };
                        let mut k: usize = 0;
                        while k < swc {
                            if (unsafe { *opt_u64_at(swv, k) }) == masked_c {
                                tgt = unsafe { *opt_bbid_at(swt, k) };
                                break;
                            }
                            k = k + 1;
                        }
                        unsafe { sc_rewrite_term_to_goto(bb, tgt); }
                        stats.sccp_branches_folded = stats.sccp_branches_folded + 1u32;
                        changed = true;
                        cfg_changed = true;
                    } else {
                        stats.rejected_candidates = stats.rejected_candidates + 1u32;
                    }
                } else if tk == OPT_TERM_ASSERT && has_cond_c &&
                          ((cond_cval != 0u64) == (unsafe { (*bb).term.assert_expected })) &&
                          !sc_mir_op_is_drop_move(view(*body), unsafe { view((*bb).term.orig_term.cond) }) {
                    let cand = CandidateRewrite {
                        pass_id: PASS_SCCP,
                        required_prop: PROP_NO_OVERFLOW,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_RANGE_INFO,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        let tgt = unsafe { (*bb).term.true_bb };
                        unsafe { sc_rewrite_term_to_goto(bb, tgt); }
                        stats.sccp_branches_folded = stats.sccp_branches_folded + 1u32;
                        changed = true;
                        cfg_changed = true;
                    } else {
                        stats.rejected_candidates = stats.rejected_candidates + 1u32;
                    }
                }
            }
        } else if unsafe { (*bb).is_reachable } {
            cfg_changed = true;
        }
        bi = bi + 1;
    }

    if cfg_changed {
        let pruned = sc_prune_unreachable_and_rebuild_cfg_ssa(mut_view(*pm), mut_view(*body), mut_view(*arena));
        stats.sccp_blocks_pruned = stats.sccp_blocks_pruned + pruned;
        changed = true;
    } else if changed && (body.mem_defs as usize) != 0 {
        optir_compute_dom_frontier(mut_view(*body), mut_view(*arena));
        optir_construct_memssa(mut_view(*body), mut_view(*arena));
    }
    changed
}


// ============================================================================
// Shared Value-Equivalence, Def-Lookup, and Copy-Materialization Helpers
// ============================================================================

fn sc_gvn_value_eq(
    pm: view<PassManager>,
    body: view<OptBody>,
    v1: OptValueId,
    v2: OptValueId
) -> bool {
    if v1.v == OPT_VALUE_NONE || v2.v == OPT_VALUE_NONE {
        return false;
    }
    // Floating-point hazards (NaN != NaN, signed zero) never unify structurally (REQ-OPT-397)
    if scalar_raw_val_has_fp_hazard(pm, body, v1) || scalar_raw_val_has_fp_hazard(pm, body, v2) {
        return false;
    }
    if v1.v == v2.v {
        return true;
    }
    if (v1.v as usize) <= body.value_count && (v2.v as usize) <= body.value_count &&
       (body.values as usize) != 0 {
        let p1 = unsafe { opt_val_at(body.values, v1.v as usize) };
        let p2 = unsafe { opt_val_at(body.values, v2.v as usize) };
        if (unsafe { (*p1).kind }) == OPT_VAL_CONST && (unsafe { (*p2).kind }) == OPT_VAL_CONST {
            let k1 = unsafe { (*p1).const_val.kind };
            let k2 = unsafe { (*p2).const_val.kind };
            let t1 = unsafe { (*p1).const_val.ty.v };
            let t2 = unsafe { (*p2).const_val.ty.v };
            let val1 = unsafe { (*p1).const_val.val };
            let val2 = unsafe { (*p2).const_val.val };
            let sym1 = unsafe { (*p1).const_val.sym.v };
            let sym2 = unsafe { (*p2).const_val.sym.v };
            let sl1 = unsafe { (*p1).const_val.str_len };
            let sl2 = unsafe { (*p2).const_val.str_len };
            if k1 == k2 && t1 == t2 && val1 == val2 && sym1 == sym2 && sl1 == 0 && sl2 == 0 {
                return true;
            }
        }
    }
    false
}

fn sc_find_def_inst(
    body: view<OptBody>,
    val_id: OptValueId,
    out_b: mut_view<usize>,
    out_i: mut_view<usize>
) -> *mut OptInst {
    if val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count || (body.values as usize) == 0 {
        return 0 as *mut OptInst;
    }
    let vp = unsafe { opt_val_at(body.values, val_id.v as usize) };
    if (unsafe { (*vp).kind }) != OPT_VAL_INST {
        return 0 as *mut OptInst;
    }
    let db = (unsafe { (*vp).def_bb.v }) as usize;
    let diid = unsafe { (*vp).def_inst.v };
    if db >= body.bb_count || diid == OPT_INST_NONE {
        return 0 as *mut OptInst;
    }
    let bb = unsafe { opt_block_at(body.blocks, db) };
    let icnt = unsafe { (*bb).inst_count };
    let insts = unsafe { (*bb).insts };
    let mut i: usize = 0;
    while i < icnt {
        let inst = unsafe { opt_inst_at(insts, i) };
        if !sc_inst_is_deleted_nop(unsafe { view(*inst) }) && (unsafe { (*inst).id.v }) == diid {
            *out_b = db;
            *out_i = i;
            return inst;
        }
        i = i + 1;
    }
    0 as *mut OptInst
}

fn sc_local_clobbered_from_block_entry(
    body: view<OptBody>,
    arena: mut_view<Arena>,
    entry_b: usize,
    cur_b: usize,
    cur_i: usize,
    loc_v: u32
) -> bool {
    if entry_b >= body.bb_count || cur_b >= body.bb_count {
        return true;
    }
    let ebb = unsafe { opt_block_at(body.blocks, entry_b) };
    let e_icnt = unsafe { (*ebb).inst_count };
    let e_insts = unsafe { (*ebb).insts };
    if entry_b == cur_b {
        let lim: usize = if cur_i <= e_icnt { cur_i } else { e_icnt };
        let mut k: usize = 0;
        while k < lim {
            let inst_k = unsafe { opt_inst_at(e_insts, k) };
            if sc_inst_clobbers_local(unsafe { view(*inst_k) }, loc_v) {
                return true;
            }
            k = k + 1;
        }
        return false;
    }
    let mut k: usize = 0;
    while k < e_icnt {
        let inst_k = unsafe { opt_inst_at(e_insts, k) };
        if sc_inst_clobbers_local(unsafe { view(*inst_k) }, loc_v) {
            return true;
        }
        k = k + 1;
    }
    if (unsafe { (*ebb).has_term }) && sc_term_clobbers_local(unsafe { view((*ebb).term) }, loc_v) {
        return true;
    }
    sc_mir_local_clobbered_on_path(body, mut_view(*arena), entry_b, e_icnt, cur_b, cur_i, loc_v)
}

fn sc_resolve_copy_source_for_val(
    pm: view<PassManager>,
    body: view<OptBody>,
    arena: mut_view<Arena>,
    cur_b: usize,
    cur_i: usize,
    val_id: OptValueId,
    out_local_v: mut_view<u32>,
    out_is_const: mut_view<bool>,
    out_const_val: mut_view<u64>
) -> bool {
    *out_local_v = 0u32;
    *out_is_const = false;
    *out_const_val = 0u64;
    if val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count || (body.values as usize) == 0 {
        return false;
    }
    if scalar_raw_val_has_fp_hazard(pm, body, val_id) {
        return false;
    }
    let vp = unsafe { opt_val_at(body.values, val_id.v as usize) };
    let vk = unsafe { (*vp).kind };
    let vty = (TypeId { v: unsafe { (*vp).ty.v } });

    if vk == OPT_VAL_CONST {
        let ck = unsafe { (*vp).const_val.kind };
        if (ck == MIR_CONST_INT || ck == MIR_CONST_BOOL) && scalar_type_is_discrete(body.thir, (TypeId { v: vty.v })) {
            *out_is_const = true;
            *out_const_val = unsafe { (*vp).const_val.val };
            return true;
        }
        return false;
    }

    if !scalar_type_is_copy_safe(body.thir, (TypeId { v: vty.v })) {
        return false;
    }

    if vk == OPT_VAL_PARAM {
        let ploc = unsafe { (*vp).src_local.v };
        let pf = unsafe { (*vp).proj_field };
        if ploc == 0u32 || (ploc as usize) >= body.local_count || pf != OPT_PROJ_NONE || (body.local_modes as usize) == 0 {
            return false;
        }
        if (unsafe { *opt_u8_at(body.local_modes, ploc as usize) }) != OPT_LOCAL_SCALAR {
            return false;
        }
        if (body.local_dropped as usize) != 0 && (unsafe { *opt_bool_at(body.local_dropped, ploc as usize) }) {
            return false;
        }
        let bb0_has_preds = body.bb_count == 0 || (unsafe { (*opt_block_at(body.blocks, 0)).pred_count }) > 0;
        if !sc_local_addr_taken_anywhere(body, ploc) &&
           (!sc_local_any_clobber_in_body(body, ploc) ||
            (!bb0_has_preds && !sc_local_clobbered_from_block_entry(body, mut_view(*arena), 0, cur_b, cur_i, ploc))) {
            *out_local_v = ploc;
            return true;
        }
        return false;
    }

    if vk == OPT_VAL_INST {
        let mut def_b: usize = 0;
        let mut def_i: usize = 0;
        let def_inst = sc_find_def_inst(body, val_id, mut_view(def_b), mut_view(def_i));
        if (def_inst as usize) != 0 {
            if opt_dominates(body, (OptBbId { v: def_b as u32 }), (OptBbId { v: cur_b as u32 })) &&
               (def_b != cur_b || def_i < cur_i) &&
               sc_local_is_unprojected_scalar(body, unsafe { view((*def_inst).place) }) {
                let dloc = unsafe { (*def_inst).place.local.v };
                if (body.local_dropped as usize) == 0 || !(unsafe { *opt_bool_at(body.local_dropped, dloc as usize) }) {
                    if !sc_mir_local_clobbered_on_path(body, mut_view(*arena), def_b, def_i, cur_b, cur_i, dloc) {
                        *out_local_v = dloc;
                        return true;
                    }
                }
            }
            return false;
        }
        // Call result SSA value (def_inst == term_iid_v)
        let cb = (unsafe { (*vp).def_bb.v }) as usize;
        if cb < body.bb_count {
            let cbb = unsafe { opt_block_at(body.blocks, cb) };
            if (unsafe { (*cbb).has_term }) && (unsafe { (*cbb).term.kind }) == OPT_TERM_CALL &&
               (unsafe { (*cbb).term.has_call_dest }) && (unsafe { (*cbb).term.call_result.v }) == val_id.v &&
               sc_local_is_unprojected_scalar(body, unsafe { view((*cbb).term.call_dest) }) {
                let cont_b = (unsafe { (*cbb).term.true_bb.v }) as usize;
                let cloc = unsafe { (*cbb).term.call_dest.local.v };
                if cont_b < body.bb_count &&
                   opt_dominates(body, (OptBbId { v: cb as u32 }), (OptBbId { v: cur_b as u32 })) &&
                   opt_dominates(body, (OptBbId { v: cont_b as u32 }), (OptBbId { v: cur_b as u32 })) &&
                   ((body.local_dropped as usize) == 0 || !(unsafe { *opt_bool_at(body.local_dropped, cloc as usize) })) &&
                   !sc_call_dest_clobbered_on_path(body, mut_view(*arena), cb, cont_b, cur_b, cur_i, cloc) {
                    *out_local_v = cloc;
                    return true;
                }
            }
        }
        return false;
    }

    // OPT_VAL_PHI
    let pb = (unsafe { (*vp).def_bb.v }) as usize;
    let ploc = unsafe { (*vp).src_local.v };
    let ppf = unsafe { (*vp).proj_field };
    if pb < body.bb_count && ploc > 0u32 && (ploc as usize) < body.local_count &&
       ppf == OPT_PROJ_NONE && (body.local_modes as usize) != 0 &&
       (unsafe { *opt_u8_at(body.local_modes, ploc as usize) }) == OPT_LOCAL_SCALAR &&
       !sc_local_addr_taken_anywhere(body, ploc) &&
       opt_dominates(body, (OptBbId { v: pb as u32 }), (OptBbId { v: cur_b as u32 })) &&
       ((body.local_dropped as usize) == 0 || !(unsafe { *opt_bool_at(body.local_dropped, ploc as usize) })) &&
       !sc_local_clobbered_from_block_entry(body, mut_view(*arena), pb, cur_b, cur_i, ploc) {
        *out_local_v = ploc;
        return true;
    }
    false
}

unsafe fn sc_rewrite_inst_to_copy_local(
    body: mut_view<OptBody>,
    inst: *mut OptInst,
    src_val: OptValueId,
    src_local_v: u32
) {
    let old_res = (OptValueId { v: (*inst).result.v });
    let iid_v = (*inst).id.v;
    let dst_is_ssa = sc_place_is_ssa_slot(view(*body), view((*inst).place));
    if dst_is_ssa {
        sc_replace_value_uses_except_def(mut_view(*body), old_res, src_val, iid_v);
        (*inst).opcode = OPT_INST_COPY;
        (*inst).lhs = src_val;
    } else {
        sc_replace_value_in_body(mut_view(*body), old_res, src_val);
        (*inst).opcode = OPT_INST_STORE;
        (*inst).result = (OptValueId { v: OPT_VALUE_NONE });
        (*inst).lhs = src_val;
    }
    (*inst).sub_op = 0u8;
    (*inst).flags = 0u16;
    (*inst).rhs = (OptValueId { v: OPT_VALUE_NONE });
    (*inst).extra_arg_count = 0;
    (*inst).mem_use = (MemSsaId { v: MEM_SSA_NONE });
    (*inst).mem_def = (MemSsaId { v: MEM_SSA_NONE });
    (*inst).rhs_place = mir_local_place(src_local_v);
    (*inst).orig_stmt.rvalue.kind = MIR_RVALUE_USE;
    (*inst).orig_stmt.rvalue.use_op.kind = MIR_OP_COPY;
    (*inst).orig_stmt.rvalue.use_op.place = mir_local_place(src_local_v);
}

fn sc_apply_copy_or_const_rewrite(
    pm: view<PassManager>,
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    inst: *mut OptInst,
    cur_b: usize,
    cur_i: usize,
    pass_id: u16,
    target_val: OptValueId
) -> bool {
    let mut src_loc: u32 = 0u32;
    let mut is_c = false;
    let mut cval: u64 = 0u64;
    if !sc_resolve_copy_source_for_val(
        pm, view(*body), mut_view(*arena), cur_b, cur_i, target_val,
        mut_view(src_loc), mut_view(is_c), mut_view(cval)
    ) {
        return false;
    }
    unsafe {
        if is_c {
            sc_rewrite_inst_to_const(mut_view(*body), mut_view(*arena), inst, cur_b as u32, pass_id, cval);
        } else {
            sc_rewrite_inst_to_copy_local(mut_view(*body), inst, target_val, src_loc);
        }
    }
    true
}

// ============================================================================
// Component B: Algebraic Instruction Simplifier (InstCombine) (REQ-OPT-363..364, REQ-OPT-397)
// ============================================================================

fn sc_mir_op_is_unprojected_copy_of(op: view<MirOperand>, loc_v: u32) -> bool {
    op.kind == MIR_OP_COPY &&
    op.place.local.v == loc_v &&
    op.place.proj_count == 0 &&
    op.place.view_kind == 0u8 &&
    op.place.drop_flag == MIR_DROP_FLAG_NONE
}

fn sc_propagate_mir_copy_in_body(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>
) -> u32 {
    let mut rewrites: u32 = 0u32;
    let mut db: usize = 0;
    while db < body.bb_count {
        let dbb = unsafe { opt_block_at(body.blocks, db) };
        if unsafe { (*dbb).is_reachable } {
            let dicnt = unsafe { (*dbb).inst_count };
            let dinsts = unsafe { (*dbb).insts };
            let mut di: usize = 0;
            while di < dicnt {
                let dinst = unsafe { opt_inst_at(dinsts, di) };
                if (unsafe { (*dinst).opcode }) == OPT_INST_COPY &&
                   ((unsafe { (*dinst).flags }) & (OPT_FLAG_BARRIER | OPT_FLAG_MOVE | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
                   (unsafe { (*dinst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                   (unsafe { (*dinst).orig_stmt.rvalue.kind }) == MIR_RVALUE_USE &&
                   (unsafe { (*dinst).orig_stmt.rvalue.use_op.kind }) == MIR_OP_COPY &&
                   sc_local_is_unprojected_scalar(view(*body), unsafe { view((*dinst).place) }) &&
                   sc_local_is_unprojected_scalar(view(*body), unsafe { view((*dinst).orig_stmt.rvalue.use_op.place) }) &&
                   scalar_type_is_copy_safe(body.thir, (TypeId { v: unsafe { (*dinst).ty.v } })) {
                    let tmp_loc = unsafe { (*dinst).place.local.v };
                    let src_loc = unsafe { (*dinst).orig_stmt.rvalue.use_op.place.local.v };
                    if (tmp_loc as usize) > body.arg_count && tmp_loc != src_loc &&
                       ((body.local_dropped as usize) == 0 ||
                        (!(unsafe { *opt_bool_at(body.local_dropped, tmp_loc as usize) }) &&
                         !(unsafe { *opt_bool_at(body.local_dropped, src_loc as usize) }))) &&
                       sc_count_local_writes_in_body(view(*body), tmp_loc) == 1u32 {
                        let mut ub: usize = 0;
                        while ub < body.bb_count {
                            let ubb = unsafe { opt_block_at(body.blocks, ub) };
                            if (unsafe { (*ubb).is_reachable }) &&
                               opt_dominates(view(*body), (OptBbId { v: db as u32 }), (OptBbId { v: ub as u32 })) {
                                let uicnt = unsafe { (*ubb).inst_count };
                                let uinsts = unsafe { (*ubb).insts };
                                let start_ui: usize = if ub == db { di + 1 } else { 0 };
                                let mut ui: usize = start_ui;
                                while ui < uicnt {
                                    let uinst = unsafe { opt_inst_at(uinsts, ui) };
                                    if !sc_inst_is_deleted_nop(unsafe { view(*uinst) }) &&
                                       ((unsafe { (*uinst).flags }) & OPT_FLAG_BARRIER) == 0u16 &&
                                       (unsafe { (*uinst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                                       sc_mir_stmt_reads_or_drops_local(unsafe { view((*uinst).orig_stmt) }, tmp_loc) {
                                        if !sc_mir_local_clobbered_on_path(view(*body), mut_view(*arena), db, di, ub, ui, tmp_loc) &&
                                           !sc_mir_local_clobbered_on_path(view(*body), mut_view(*arena), db, di, ub, ui, src_loc) {
                                            let rk = unsafe { (*uinst).orig_stmt.rvalue.kind };
                                            if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP || rk == MIR_RVALUE_CAST {
                                                if sc_mir_op_is_unprojected_copy_of(unsafe { view((*uinst).orig_stmt.rvalue.use_op) }, tmp_loc) {
                                                    unsafe {
                                                        (*uinst).orig_stmt.rvalue.use_op.place = mir_local_place(src_loc);
                                                        if (*uinst).opcode == OPT_INST_COPY {
                                                            (*uinst).rhs_place = mir_local_place(src_loc);
                                                        }
                                                    }
                                                    rewrites = rewrites + 1u32;
                                                }
                                            } else if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                                                if sc_mir_op_is_unprojected_copy_of(unsafe { view((*uinst).orig_stmt.rvalue.lhs) }, tmp_loc) {
                                                    unsafe { (*uinst).orig_stmt.rvalue.lhs.place = mir_local_place(src_loc); }
                                                    rewrites = rewrites + 1u32;
                                                }
                                                if sc_mir_op_is_unprojected_copy_of(unsafe { view((*uinst).orig_stmt.rvalue.rhs) }, tmp_loc) {
                                                    unsafe { (*uinst).orig_stmt.rvalue.rhs.place = mir_local_place(src_loc); }
                                                    rewrites = rewrites + 1u32;
                                                }
                                            }
                                        }
                                    }
                                    ui = ui + 1;
                                }
                                if (unsafe { (*ubb).has_term }) &&
                                   sc_mir_term_reads_or_drops_local(unsafe { view((*ubb).term.orig_term) }, tmp_loc) &&
                                   !sc_mir_local_clobbered_on_path(view(*body), mut_view(*arena), db, di, ub, uicnt, tmp_loc) &&
                                   !sc_mir_local_clobbered_on_path(view(*body), mut_view(*arena), db, di, ub, uicnt, src_loc) {
                                    let mtk = unsafe { (*ubb).term.orig_term.kind };
                                    if mtk == MIR_TERM_SWITCH_INT && sc_mir_op_is_unprojected_copy_of(unsafe { view((*ubb).term.orig_term.discr) }, tmp_loc) {
                                        unsafe { (*ubb).term.orig_term.discr.place = mir_local_place(src_loc); }
                                        rewrites = rewrites + 1u32;
                                    } else if mtk == MIR_TERM_ASSERT && sc_mir_op_is_unprojected_copy_of(unsafe { view((*ubb).term.orig_term.cond) }, tmp_loc) {
                                        unsafe { (*ubb).term.orig_term.cond.place = mir_local_place(src_loc); }
                                        rewrites = rewrites + 1u32;
                                    } else if mtk == MIR_TERM_CALL {
                                        let acnt = unsafe { (*ubb).term.orig_term.arg_count };
                                        let args = unsafe { (*ubb).term.orig_term.args };
                                        let mut ai: usize = 0;
                                        while ai < acnt {
                                            let aop = unsafe { mir_op_at(args, ai) };
                                            if sc_mir_op_is_unprojected_copy_of(unsafe { view(*aop) }, tmp_loc) {
                                                unsafe { (*aop).place = mir_local_place(src_loc); }
                                                rewrites = rewrites + 1u32;
                                            }
                                            ai = ai + 1;
                                        }
                                    }
                                }
                            }
                            ub = ub + 1;
                        }
                    }
                }
                di = di + 1;
            }
        }
        db = db + 1;
    }
    rewrites
}

pub fn scalar_run_inst_combine(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    stats: mut_view<ScalarOptStats>,
    arena: mut_view<Arena>
) -> bool {
    let mut changed = false;
    let max_steps = pm.budget.max_symbolic_steps;

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let sub = unsafe { (*inst).sub_op };
                let flg = unsafe { (*inst).flags };

                if !sc_inst_is_deleted_nop(unsafe { view(*inst) }) &&
                   (flg & (OPT_FLAG_BARRIER | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
                   opc != OPT_INST_BLACK_BOX && opc != OPT_INST_ZEROIZE &&
                   opc != OPT_INST_VOLATILE_LOAD && opc != OPT_INST_VOLATILE_STORE &&
                   opc != OPT_INST_ATOMIC && opc != OPT_INST_DROP_FLAG &&
                   (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                   (unsafe { (*inst).place.proj_count }) == 0 &&
                   (unsafe { (*inst).place.drop_flag }) == MIR_DROP_FLAG_NONE &&
                   !sc_mir_stmt_has_move_operand(unsafe { view((*inst).orig_stmt) }) {

                    let inst_ty = (TypeId { v: unsafe { (*inst).ty.v } });
                    let mut lhs_id = (OptValueId { v: unsafe { (*inst).lhs.v } });
                    let mut rhs_id = (OptValueId { v: unsafe { (*inst).rhs.v } });
                    let res_id = (OptValueId { v: unsafe { (*inst).result.v } });
                    let has_fp = scalar_raw_val_has_fp_hazard(view(*pm), view(*body), res_id) ||
                                 scalar_raw_val_has_fp_hazard(view(*pm), view(*body), lhs_id) ||
                                 scalar_raw_val_has_fp_hazard(view(*pm), view(*body), rhs_id);

                    // 1. Canonicalize commutative constants to RHS when non-hazardous
                    if (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP || opc == OPT_INST_CHECKED_BINOP) &&
                       scalar_is_commutative_binop(sub) && !has_fp {
                        let mut lc_tmp: u64 = 0u64;
                        let mut rc_tmp: u64 = 0u64;
                        let l_is_c = pm_value_is_const_int(view(*pm), view(*body), lhs_id, mut_view(lc_tmp));
                        let r_is_c = pm_value_is_const_int(view(*pm), view(*body), rhs_id, mut_view(rc_tmp));
                        if l_is_c && !r_is_c {
                            let tmp_op = arena_alloc_raw(mut_view(*arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
                            unsafe {
                                (*inst).lhs = rhs_id;
                                (*inst).rhs = lhs_id;
                                mir_copy_operand(mut_view(*tmp_op), view((*inst).orig_stmt.rvalue.lhs));
                                mir_copy_operand(mut_view((*inst).orig_stmt.rvalue.lhs), view((*inst).orig_stmt.rvalue.rhs));
                                mir_copy_operand(mut_view((*inst).orig_stmt.rvalue.rhs), view(*tmp_op));
                            }
                            lhs_id = (OptValueId { v: unsafe { (*inst).lhs.v } });
                            rhs_id = (OptValueId { v: unsafe { (*inst).rhs.v } });
                            stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                            changed = true;
                        }
                    }

                    // 2. Checked overflow predicate (OPT_INST_CHECKED_BINOP) simplifications
                    if opc == OPT_INST_CHECKED_BINOP && scalar_type_is_bool_ty(body.thir, (TypeId { v: inst_ty.v })) {
                        let lhs_ty = scalar_val_ty(view(*body), lhs_id, (TypeId { v: 0u32 }));
                        let rhs_ty = scalar_val_ty(view(*body), rhs_id, (TypeId { v: lhs_ty.v }));
                        if scalar_type_is_discrete(body.thir, (TypeId { v: lhs_ty.v })) {
                            let mut lc: u64 = 0u64;
                            let mut rc: u64 = 0u64;
                            let l_const = pm_value_is_const_int(view(*pm), view(*body), lhs_id, mut_view(lc));
                            let r_const = pm_value_is_const_int(view(*pm), view(*body), rhs_id, mut_view(rc));
                            let mut fold_ovf = false;
                            let mut fold_val: u64 = 0u64;
                            let mut fold_cert = CERTAINTY_UNKNOWN;

                            if l_const && r_const && !has_fp {
                                let mut dummy_out: u64 = 0u64;
                                let mut did_ovf = false;
                                if scalar_eval_const_binop(body.thir, opc, sub, (TypeId { v: lhs_ty.v }), (TypeId { v: rhs_ty.v }), (TypeId { v: inst_ty.v }), lc, rc, mut_view(dummy_out), mut_view(did_ovf)) {
                                    fold_ovf = true;
                                    fold_val = if did_ovf { 1u64 } else { 0u64 };
                                    fold_cert = CERTAINTY_PROVEN;
                                }
                            } else {
                                let same_ops = lhs_id.v == rhs_id.v || sc_gvn_value_eq(view(*pm), view(*body), lhs_id, rhs_id);
                                if (sub == MIR_BINOP_ADD && ((r_const && rc == 0u64) || (l_const && lc == 0u64))) ||
                                   (sub == MIR_BINOP_SUB && ((r_const && rc == 0u64) || same_ops)) ||
                                   (sub == MIR_BINOP_MUL && ((r_const && (rc == 0u64 || rc == 1u64)) || (l_const && (lc == 0u64 || lc == 1u64)))) ||
                                   ((sub == MIR_BINOP_DIV || sub == MIR_BINOP_REM) && (r_const && rc == 1u64)) ||
                                   ((sub == MIR_BINOP_SHL || sub == MIR_BINOP_SHR) && (r_const && rc == 0u64)) {
                                    fold_ovf = true;
                                    fold_val = 0u64;
                                    fold_cert = if has_fp { CERTAINTY_POSSIBLE } else { CERTAINTY_PROVEN };
                                } else if (sub == MIR_BINOP_DIV || sub == MIR_BINOP_REM) && same_ops {
                                    let nz = optir_query_non_zero_certainty(view(*body), rhs_id, max_steps);
                                    fold_ovf = true;
                                    fold_val = 0u64;
                                    fold_cert = if has_fp { CERTAINTY_POSSIBLE } else { nz };
                                } else {
                                    let qcert = sc_query_no_overflow_certainty_safe(view(*pm), view(*body), sub, (TypeId { v: lhs_ty.v }), lhs_id, rhs_id, max_steps);
                                    if qcert == CERTAINTY_PROVEN {
                                        fold_ovf = true;
                                        fold_val = 0u64;
                                        fold_cert = if has_fp { CERTAINTY_POSSIBLE } else { CERTAINTY_PROVEN };
                                    }
                                }
                            }

                            if fold_ovf {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_INST_COMBINE,
                                    required_prop: PROP_NO_OVERFLOW,
                                    proof_certainty: fold_cert,
                                    proof_source_analysis: ANALYSIS_RANGE_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -2i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    unsafe {
                                        sc_rewrite_inst_to_const(mut_view(*body), mut_view(*arena), inst, b as u32, PASS_INST_COMBINE, fold_val);
                                    }
                                    stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                    changed = true;
                                } else {
                                    stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                }
                            }
                        }
                    } else if (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP) &&
                              scalar_type_is_discrete(body.thir, (TypeId { v: inst_ty.v })) {
                        // 3. Checked & Wrapping Binary Algebraic Identities and Reassociation
                        let lhs_ty = scalar_val_ty(view(*body), lhs_id, (TypeId { v: inst_ty.v }));
                        let rhs_ty = scalar_val_ty(view(*body), rhs_id, (TypeId { v: lhs_ty.v }));
                        let mut lc: u64 = 0u64;
                        let mut rc: u64 = 0u64;
                        let l_const = pm_value_is_const_int(view(*pm), view(*body), lhs_id, mut_view(lc));
                        let r_const = pm_value_is_const_int(view(*pm), view(*body), rhs_id, mut_view(rc));

                        // Note: even when has_fp is true on an operand, check structural literal constants for candidate rejection testing
                        let mut raw_rc_zero = false;
                        let mut raw_rc_one = false;
                        if (rhs_id.v as usize) <= body.value_count && rhs_id.v != OPT_VALUE_NONE && (body.values as usize) != 0 {
                            let rvp = unsafe { opt_val_at(body.values, rhs_id.v as usize) };
                            if (unsafe { (*rvp).kind }) == OPT_VAL_CONST {
                                let rv_raw = unsafe { (*rvp).const_val.val };
                                raw_rc_zero = rv_raw == 0u64;
                                raw_rc_one = rv_raw == 1u64;
                            }
                        }

                        let mut did_rewrite = false;
                        if l_const && r_const && !has_fp {
                            let mut c_out: u64 = 0u64;
                            let mut c_ovf = false;
                            if scalar_eval_const_binop(body.thir, opc, sub, (TypeId { v: lhs_ty.v }), (TypeId { v: rhs_ty.v }), (TypeId { v: inst_ty.v }), lc, rc, mut_view(c_out), mut_view(c_ovf)) && !c_ovf {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_INST_COMBINE,
                                    required_prop: PROP_NO_OVERFLOW,
                                    proof_certainty: CERTAINTY_PROVEN,
                                    proof_source_analysis: ANALYSIS_RANGE_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -2i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    unsafe {
                                        sc_rewrite_inst_to_const(mut_view(*body), mut_view(*arena), inst, b as u32, PASS_INST_COMBINE, c_out);
                                    }
                                    stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                    changed = true;
                                    did_rewrite = true;
                                } else {
                                    stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                }
                            }
                        }

                        if !did_rewrite && scalar_type_is_discrete(body.thir, (TypeId { v: lhs_ty.v })) {
                            let lbits = opt_type_bits(body.thir, (TypeId { v: lhs_ty.v }));
                            let all_ones: u64 = if scalar_type_is_bool_ty(body.thir, (TypeId { v: lhs_ty.v })) {
                                1u64
                            } else if lbits > 0u32 && lbits <= 64u32 {
                                opt_bit_mask(lbits)
                            } else {
                                SC_ALL_ONES_U64
                            };
                            let same_ops = lhs_id.v == rhs_id.v || sc_gvn_value_eq(view(*pm), view(*body), lhs_id, rhs_id);
                            let base_cert: u8 = if has_fp { CERTAINTY_POSSIBLE } else { CERTAINTY_PROVEN };

                            let mut want_const = false;
                            let mut const_res: u64 = 0u64;
                            let mut want_copy = false;
                            let mut copy_val = (OptValueId { v: OPT_VALUE_NONE });
                            let mut req_prop = PROP_NO_OVERFLOW;
                            let mut cert = base_cert;

                            // Identity -> Copy of operand
                            if (sub == MIR_BINOP_ADD || sub == MIR_BINOP_WRAPPING_ADD) && ((r_const && rc == 0u64) || raw_rc_zero) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if (sub == MIR_BINOP_ADD || sub == MIR_BINOP_WRAPPING_ADD) && (l_const && lc == 0u64) {
                                want_copy = true;
                                copy_val = rhs_id;
                            } else if (sub == MIR_BINOP_SUB || sub == MIR_BINOP_WRAPPING_SUB) && ((r_const && rc == 0u64) || raw_rc_zero) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if (sub == MIR_BINOP_MUL || sub == MIR_BINOP_WRAPPING_MUL) && ((r_const && rc == 1u64) || raw_rc_one) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if (sub == MIR_BINOP_MUL || sub == MIR_BINOP_WRAPPING_MUL) && (l_const && lc == 1u64) {
                                want_copy = true;
                                copy_val = rhs_id;
                            } else if sub == MIR_BINOP_DIV && ((r_const && rc == 1u64) || raw_rc_one) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if (sub == MIR_BINOP_SHL || sub == MIR_BINOP_SHR) && ((r_const && rc == 0u64) || raw_rc_zero) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if (sub == MIR_BINOP_BIT_OR || sub == MIR_BINOP_BIT_XOR) && (r_const && rc == 0u64) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if (sub == MIR_BINOP_BIT_OR || sub == MIR_BINOP_BIT_XOR) && (l_const && lc == 0u64) {
                                want_copy = true;
                                copy_val = rhs_id;
                            } else if sub == MIR_BINOP_BIT_AND && (r_const && (rc & all_ones) == all_ones) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if sub == MIR_BINOP_BIT_AND && (l_const && (lc & all_ones) == all_ones) {
                                want_copy = true;
                                copy_val = rhs_id;
                            } else if (sub == MIR_BINOP_BIT_AND || sub == MIR_BINOP_BIT_OR) && same_ops {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if scalar_type_is_bool_ty(body.thir, (TypeId { v: lhs_ty.v })) && sub == MIR_BINOP_EQ && (r_const && rc == 1u64) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if scalar_type_is_bool_ty(body.thir, (TypeId { v: lhs_ty.v })) && sub == MIR_BINOP_NE && (r_const && rc == 0u64) {
                                want_copy = true;
                                copy_val = lhs_id;
                            } else if (sub == MIR_BINOP_MUL || sub == MIR_BINOP_WRAPPING_MUL) &&
                                      ((r_const && rc == 0u64) || (l_const && lc == 0u64) || raw_rc_zero) {
                                // Identity -> Constant
                                want_const = true;
                                const_res = 0u64;
                            } else if sub == MIR_BINOP_REM && ((r_const && rc == 1u64) || raw_rc_one) {
                                want_const = true;
                                const_res = 0u64;
                            } else if sub == MIR_BINOP_BIT_AND && ((r_const && rc == 0u64) || (l_const && lc == 0u64)) {
                                want_const = true;
                                const_res = 0u64;
                            } else if sub == MIR_BINOP_BIT_OR && ((r_const && (rc & all_ones) == all_ones) || (l_const && (lc & all_ones) == all_ones)) {
                                want_const = true;
                                const_res = all_ones;
                            } else if same_ops {
                                if sub == MIR_BINOP_SUB || sub == MIR_BINOP_WRAPPING_SUB || sub == MIR_BINOP_BIT_XOR {
                                    want_const = true;
                                    const_res = 0u64;
                                } else if sub == MIR_BINOP_EQ || sub == MIR_BINOP_LE || sub == MIR_BINOP_GE {
                                    want_const = true;
                                    const_res = 1u64;
                                } else if sub == MIR_BINOP_NE || sub == MIR_BINOP_LT || sub == MIR_BINOP_GT {
                                    want_const = true;
                                    const_res = 0u64;
                                } else if sub == MIR_BINOP_DIV || sub == MIR_BINOP_REM {
                                    // x / x -> 1 and x % x -> 0 REQUIRE Proven NonZero(x) (REQ-OPT-363..364)
                                    let nz = optir_query_non_zero_certainty(view(*body), rhs_id, max_steps);
                                    want_const = true;
                                    const_res = if sub == MIR_BINOP_DIV { 1u64 } else { 0u64 };
                                    req_prop = PROP_NON_ZERO;
                                    cert = if has_fp { CERTAINTY_POSSIBLE } else { nz };
                                }
                            }

                            // Reassociation / Cancellation: wrapping vs checked contrast (REQ-OPT-363..364)
                            if !want_const && !want_copy {
                                let mut def_b: usize = 0;
                                let mut def_i: usize = 0;
                                let def_inst = sc_find_def_inst(view(*body), lhs_id, mut_view(def_b), mut_view(def_i));
                                if (def_inst as usize) != 0 {
                                    let dopc = unsafe { (*def_inst).opcode };
                                    let dsub = unsafe { (*def_inst).sub_op };
                                    let dlhs = (OptValueId { v: unsafe { (*def_inst).lhs.v } });
                                    let drhs = (OptValueId { v: unsafe { (*def_inst).rhs.v } });
                                    if opc == OPT_INST_WRAPPING_BINOP && dopc == OPT_INST_WRAPPING_BINOP {
                                        if sub == MIR_BINOP_WRAPPING_SUB && dsub == MIR_BINOP_WRAPPING_ADD {
                                            if sc_gvn_value_eq(view(*pm), view(*body), drhs, rhs_id) {
                                                want_copy = true;
                                                copy_val = dlhs;
                                            } else if sc_gvn_value_eq(view(*pm), view(*body), dlhs, rhs_id) {
                                                want_copy = true;
                                                copy_val = drhs;
                                            }
                                        } else if sub == MIR_BINOP_WRAPPING_ADD && dsub == MIR_BINOP_WRAPPING_SUB {
                                            if sc_gvn_value_eq(view(*pm), view(*body), drhs, rhs_id) {
                                                want_copy = true;
                                                copy_val = dlhs;
                                            }
                                        }
                                    } else if opc == OPT_INST_BINOP && dopc == OPT_INST_BINOP {
                                        // Checked (x + y) - y -> x is FORBIDDEN unless NoOverflow is Proven on BOTH steps!
                                        if (sub == MIR_BINOP_SUB && dsub == MIR_BINOP_ADD &&
                                            (sc_gvn_value_eq(view(*pm), view(*body), drhs, rhs_id) || sc_gvn_value_eq(view(*pm), view(*body), dlhs, rhs_id))) ||
                                           (sub == MIR_BINOP_ADD && dsub == MIR_BINOP_SUB &&
                                            sc_gvn_value_eq(view(*pm), view(*body), drhs, rhs_id)) {
                                            let c_inner = sc_query_no_overflow_certainty_safe(view(*pm), view(*body), dsub, (TypeId { v: inst_ty.v }), dlhs, drhs, max_steps);
                                            let c_outer = sc_query_no_overflow_certainty_safe(view(*pm), view(*body), sub, (TypeId { v: inst_ty.v }), lhs_id, rhs_id, max_steps);
                                            want_copy = true;
                                            copy_val = if sub == MIR_BINOP_SUB && dsub == MIR_BINOP_ADD && sc_gvn_value_eq(view(*pm), view(*body), dlhs, rhs_id) {
                                                drhs
                                            } else {
                                                dlhs
                                            };
                                            req_prop = PROP_NO_OVERFLOW;
                                            if has_fp {
                                                cert = CERTAINTY_POSSIBLE;
                                            } else if c_inner == CERTAINTY_PROVEN && c_outer == CERTAINTY_PROVEN {
                                                cert = CERTAINTY_PROVEN;
                                            } else if c_inner == CERTAINTY_UNKNOWN || c_outer == CERTAINTY_UNKNOWN {
                                                cert = CERTAINTY_UNKNOWN;
                                            } else {
                                                cert = CERTAINTY_POSSIBLE;
                                            }
                                        }
                                    }
                                }
                            }

                            if want_const {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_INST_COMBINE,
                                    required_prop: req_prop,
                                    proof_certainty: cert,
                                    proof_source_analysis: ANALYSIS_RANGE_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -2i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    optir_record_provenance(
                                        mut_view(*body),
                                        mut_view(*arena),
                                        req_prop,
                                        CERTAINTY_PROVEN,
                                        ANALYSIS_RANGE_INFO,
                                        res_id,
                                        rhs_id,
                                        (OptBbId { v: b as u32 }),
                                        (OptInstId { v: unsafe { (*inst).id.v } }),
                                        PASS_INST_COMBINE
                                    );
                                    unsafe {
                                        sc_rewrite_inst_to_const(mut_view(*body), mut_view(*arena), inst, b as u32, PASS_INST_COMBINE, const_res);
                                    }
                                    stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                    changed = true;
                                } else {
                                    stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                }
                            } else if want_copy {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_INST_COMBINE,
                                    required_prop: req_prop,
                                    proof_certainty: cert,
                                    proof_source_analysis: ANALYSIS_RANGE_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -1i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    if sc_apply_copy_or_const_rewrite(
                                        view(*pm), mut_view(*body), mut_view(*arena), inst, b, i, PASS_INST_COMBINE, copy_val
                                    ) {
                                        stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                        changed = true;
                                    }
                                } else {
                                    stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                }
                            } else if opc == OPT_INST_WRAPPING_BINOP && sub == MIR_BINOP_WRAPPING_ADD && r_const && !has_fp {
                                // Wrapping constant reassociation: (x +w c1) +w c2 -> x +w (c1 +w c2)
                                let mut def_b2: usize = 0;
                                let mut def_i2: usize = 0;
                                let def_inst2 = sc_find_def_inst(view(*body), lhs_id, mut_view(def_b2), mut_view(def_i2));
                                if (def_inst2 as usize) != 0 &&
                                   (unsafe { (*def_inst2).opcode }) == OPT_INST_WRAPPING_BINOP &&
                                   (unsafe { (*def_inst2).sub_op }) == MIR_BINOP_WRAPPING_ADD {
                                    let inner_x = (OptValueId { v: unsafe { (*def_inst2).lhs.v } });
                                    let inner_c_id = (OptValueId { v: unsafe { (*def_inst2).rhs.v } });
                                    let mut inner_c: u64 = 0u64;
                                    let mut x_loc: u32 = 0u32;
                                    let mut x_is_c = false;
                                    let mut x_cval: u64 = 0u64;
                                    if pm_value_is_const_int(view(*pm), view(*body), inner_c_id, mut_view(inner_c)) &&
                                       sc_resolve_copy_source_for_val(
                                           view(*pm), view(*body), mut_view(*arena), b, i, inner_x,
                                           mut_view(x_loc), mut_view(x_is_c), mut_view(x_cval)
                                       ) && !x_is_c {
                                        let cand = CandidateRewrite {
                                            pass_id: PASS_INST_COMBINE,
                                            required_prop: PROP_NO_OVERFLOW,
                                            proof_certainty: CERTAINTY_PROVEN,
                                            proof_source_analysis: ANALYSIS_RANGE_INFO,
                                            proof_revision: pm.ir_revision,
                                            target_effect_flags: EFFECT_PURE,
                                            src_view_kind: 0u8,
                                            dst_view_kind: 0u8,
                                            is_removing_inst: false,
                                            cost_delta: -1i32,
                                        };
                                        if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                            let sum_c = opt_wrapping_add_u64(inner_c, rc) & all_ones;
                                            let new_c_vid = scalar_alloc_const_value(
                                                mut_view(*body),
                                                mut_view(*arena),
                                                (TypeId { v: inst_ty.v }),
                                                sum_c,
                                                b as u32,
                                                unsafe { (*inst).id.v },
                                                PASS_INST_COMBINE
                                            );
                                            unsafe {
                                                (*inst).lhs = inner_x;
                                                (*inst).rhs = new_c_vid;
                                                (*inst).orig_stmt.rvalue.lhs.kind = MIR_OP_COPY;
                                                (*inst).orig_stmt.rvalue.lhs.place = mir_local_place(x_loc);
                                                (*inst).orig_stmt.rvalue.rhs.kind = MIR_OP_CONST;
                                                (*inst).orig_stmt.rvalue.rhs.constant.kind = MIR_CONST_INT;
                                                (*inst).orig_stmt.rvalue.rhs.constant.ty = (TypeId { v: inst_ty.v });
                                                (*inst).orig_stmt.rvalue.rhs.constant.val = sum_c;
                                            }
                                            stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                            changed = true;
                                        }
                                    }
                                }
                            }
                        }
                    } else if opc == OPT_INST_UNOP && scalar_type_is_discrete(body.thir, (TypeId { v: inst_ty.v })) {
                        // 4. Unary constant folding & involutions (!!b -> b, ~~x -> x; never checked -(-x))
                        let mut uc: u64 = 0u64;
                        if pm_value_is_const_int(view(*pm), view(*body), lhs_id, mut_view(uc)) && !has_fp {
                            let mut u_out: u64 = 0u64;
                            let mut u_ovf = false;
                            if scalar_eval_const_unop(body.thir, sub, (TypeId { v: inst_ty.v }), uc, mut_view(u_out), mut_view(u_ovf)) && !u_ovf {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_INST_COMBINE,
                                    required_prop: PROP_NO_OVERFLOW,
                                    proof_certainty: CERTAINTY_PROVEN,
                                    proof_source_analysis: ANALYSIS_RANGE_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -2i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    unsafe {
                                        sc_rewrite_inst_to_const(mut_view(*body), mut_view(*arena), inst, b as u32, PASS_INST_COMBINE, u_out);
                                    }
                                    stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                    changed = true;
                                }
                            }
                        } else if sub == MIR_UNOP_NOT || sub == MIR_UNOP_BITNOT {
                            let mut udef_b: usize = 0;
                            let mut udef_i: usize = 0;
                            let udef = sc_find_def_inst(view(*body), lhs_id, mut_view(udef_b), mut_view(udef_i));
                            if (udef as usize) != 0 &&
                               (unsafe { (*udef).opcode }) == OPT_INST_UNOP &&
                               (unsafe { (*udef).sub_op }) == sub &&
                               (unsafe { (*udef).ty.v }) == inst_ty.v {
                                let inner_u = (OptValueId { v: unsafe { (*udef).lhs.v } });
                                let ucert: u8 = if has_fp || scalar_raw_val_has_fp_hazard(view(*pm), view(*body), inner_u) {
                                    CERTAINTY_POSSIBLE
                                } else {
                                    CERTAINTY_PROVEN
                                };
                                let cand = CandidateRewrite {
                                    pass_id: PASS_INST_COMBINE,
                                    required_prop: PROP_NO_OVERFLOW,
                                    proof_certainty: ucert,
                                    proof_source_analysis: ANALYSIS_RANGE_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -2i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    if sc_apply_copy_or_const_rewrite(
                                        view(*pm), mut_view(*body), mut_view(*arena), inst, b, i, PASS_INST_COMBINE, inner_u
                                    ) {
                                        stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                        changed = true;
                                    }
                                } else {
                                    stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                }
                            }
                        }
                    } else if opc == OPT_INST_CAST && scalar_type_is_discrete(body.thir, (TypeId { v: inst_ty.v })) {
                        let src_ty = scalar_val_ty(view(*body), lhs_id, (TypeId { v: 0u32 }));
                        let mut cc: u64 = 0u64;
                        if src_ty.v == inst_ty.v && !has_fp {
                            // Identity cast T -> T
                            let cand = CandidateRewrite {
                                pass_id: PASS_INST_COMBINE,
                                required_prop: PROP_NO_OVERFLOW,
                                proof_certainty: CERTAINTY_PROVEN,
                                proof_source_analysis: ANALYSIS_RANGE_INFO,
                                proof_revision: pm.ir_revision,
                                target_effect_flags: EFFECT_PURE,
                                src_view_kind: 0u8,
                                dst_view_kind: 0u8,
                                is_removing_inst: false,
                                cost_delta: -1i32,
                            };
                            if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                if sc_apply_copy_or_const_rewrite(
                                    view(*pm), mut_view(*body), mut_view(*arena), inst, b, i, PASS_INST_COMBINE, lhs_id
                                ) {
                                    stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                    changed = true;
                                }
                            }
                        } else if pm_value_is_const_int(view(*pm), view(*body), lhs_id, mut_view(cc)) && !has_fp {
                            let mut cast_out: u64 = 0u64;
                            if scalar_eval_const_cast(body.thir, sub, (TypeId { v: src_ty.v }), (TypeId { v: inst_ty.v }), cc, mut_view(cast_out)) {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_INST_COMBINE,
                                    required_prop: PROP_NO_OVERFLOW,
                                    proof_certainty: CERTAINTY_PROVEN,
                                    proof_source_analysis: ANALYSIS_RANGE_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -2i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    unsafe {
                                        sc_rewrite_inst_to_const(mut_view(*body), mut_view(*arena), inst, b as u32, PASS_INST_COMBINE, cast_out);
                                    }
                                    stats.inst_combine_rewrites = stats.inst_combine_rewrites + 1u32;
                                    changed = true;
                                }
                            }
                        }
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }

    // 5. Dominator-safe MIR scalar copy propagation for unprojected Copy temporaries
    let cp_cnt = sc_propagate_mir_copy_in_body(mut_view(*body), mut_view(*arena));
    if cp_cnt > 0u32 {
        stats.inst_combine_rewrites = stats.inst_combine_rewrites + cp_cnt;
        changed = true;
    }

    if changed && (body.mem_defs as usize) != 0 {
        optir_compute_dom_frontier(mut_view(*body), mut_view(*arena));
        optir_construct_memssa(mut_view(*body), mut_view(*arena));
    }

    changed
}

// ============================================================================
// Component C: Dominator-Scoped GVN / CSE + MemorySSA Load Forwarding (AXS-OPT-044, AXS-OPT-046)
// ============================================================================

fn sc_mir_term_has_move_arg(tm: view<MirTerminator>) -> bool {
    if tm.kind != MIR_TERM_CALL {
        return false;
    }
    if sc_mir_op_is_move(view(tm.func)) {
        return true;
    }
    let mut i: usize = 0;
    while i < tm.arg_count {
        let aop = unsafe { mir_op_at(tm.args, i) };
        if sc_mir_op_is_move(unsafe { view(*aop) }) {
            return true;
        }
        i = i + 1;
    }
    false
}

fn sc_gvn_push_entry(
    table: *mut GvnEntry,
    table_len: mut_view<usize>,
    table_cap: usize,
    entry: view<GvnEntry>
) {
    if *table_len < table_cap && (table as usize) != 0 {
        let dst = unsafe { sc_gvn_at(table, *table_len) };
        unsafe { *dst = *entry; }
        *table_len = *table_len + 1;
    }
}

fn sc_gvn_ops_match(
    pm: view<PassManager>,
    body: view<OptBody>,
    is_comm: bool,
    a0: OptValueId,
    a1: OptValueId,
    b0: OptValueId,
    b1: OptValueId
) -> bool {
    let direct_lhs = sc_gvn_value_eq(pm, body, a0, b0);
    let direct_rhs: bool = if a1.v == OPT_VALUE_NONE && b1.v == OPT_VALUE_NONE {
        true
    } else {
        sc_gvn_value_eq(pm, body, a1, b1)
    };
    if direct_lhs && direct_rhs {
        return true;
    }
    if is_comm && a1.v != OPT_VALUE_NONE && b1.v != OPT_VALUE_NONE {
        if sc_gvn_value_eq(pm, body, a0, b1) && sc_gvn_value_eq(pm, body, a1, b0) {
            return true;
        }
    }
    false
}

fn sc_gvn_walk_dom_tree(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    table: *mut GvnEntry,
    table_len: mut_view<usize>,
    table_cap: usize,
    b_idx: usize,
    stats: mut_view<ScalarOptStats>,
    changed: mut_view<bool>,
    cfg_changed: mut_view<bool>,
    arena: mut_view<Arena>
) {
    if b_idx >= body.bb_count {
        return;
    }
    let bb = unsafe { opt_block_at(body.blocks, b_idx) };
    if !(unsafe { (*bb).is_reachable }) {
        return;
    }
    let saved_len = *table_len;
    let max_steps = pm.budget.max_symbolic_steps;

    let icnt = unsafe { (*bb).inst_count };
    let insts = unsafe { (*bb).insts };
    let mut i: usize = 0;
    while i < icnt {
        let inst = unsafe { opt_inst_at(insts, i) };
        let opc = unsafe { (*inst).opcode };
        let sub = unsafe { (*inst).sub_op };
        let flg = unsafe { (*inst).flags };

        if !sc_inst_is_deleted_nop(unsafe { view(*inst) }) &&
           (flg & (OPT_FLAG_BARRIER | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
           (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
           (unsafe { (*inst).place.proj_count }) == 0 &&
           (unsafe { (*inst).place.drop_flag }) == MIR_DROP_FLAG_NONE &&
           !sc_mir_stmt_has_move_operand(unsafe { view((*inst).orig_stmt) }) {

            let inst_ty = (TypeId { v: unsafe { (*inst).ty.v } });
            let lhs_id = (OptValueId { v: unsafe { (*inst).lhs.v } });
            let rhs_id = (OptValueId { v: unsafe { (*inst).rhs.v } });
            let res_id = (OptValueId { v: unsafe { (*inst).result.v } });
            let has_fp = scalar_raw_val_has_fp_hazard(view(*pm), view(*body), res_id) ||
                         scalar_raw_val_has_fp_hazard(view(*pm), view(*body), lhs_id) ||
                         scalar_raw_val_has_fp_hazard(view(*pm), view(*body), rhs_id);

            // C.1: Dominated Checked Overflow Predicate (Overflows(op, a, b))
            if opc == OPT_INST_CHECKED_BINOP && scalar_type_is_bool_ty(body.thir, (TypeId { v: inst_ty.v })) && !has_fp {
                let op_ty = scalar_val_ty(view(*body), lhs_id, (TypeId { v: 0u32 }));
                let is_comm = scalar_is_commutative_binop(sub);
                let mut eliminated = false;
                let mut idx_rev = *table_len;
                while idx_rev > 0 {
                    idx_rev = idx_rev - 1;
                    let ent = unsafe { sc_gvn_at(table, idx_rev) };
                    let ekind = unsafe { (*ent).kind };
                    if ekind == GVN_KIND_CHECKED_ASSERTED &&
                       (unsafe { (*ent).sub_op }) == sub &&
                       (unsafe { (*ent).ty_v }) == op_ty.v &&
                       opt_dominates(view(*body), (OptBbId { v: unsafe { (*ent).def_bb } }), (OptBbId { v: b_idx as u32 })) &&
                       sc_gvn_ops_match(
                           view(*pm), view(*body), is_comm,
                           (OptValueId { v: unsafe { (*ent).op0 } }), (OptValueId { v: unsafe { (*ent).op1 } }),
                           lhs_id, rhs_id
                       ) {
                        let cand = CandidateRewrite {
                            pass_id: PASS_GVN_CSE,
                            required_prop: PROP_PURE_CALL,
                            proof_certainty: CERTAINTY_PROVEN,
                            proof_source_analysis: ANALYSIS_EFFECT_INFO,
                            proof_revision: pm.ir_revision,
                            target_effect_flags: EFFECT_PURE,
                            src_view_kind: 0u8,
                            dst_view_kind: 0u8,
                            is_removing_inst: false,
                            cost_delta: -2i32,
                        };
                        if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                            unsafe {
                                sc_rewrite_inst_to_const(mut_view(*body), mut_view(*arena), inst, b_idx as u32, PASS_GVN_CSE, 0u64);
                            }
                            stats.gvn_cse_eliminated = stats.gvn_cse_eliminated + 1u32;
                            *changed = true;
                            eliminated = true;
                        } else {
                            stats.rejected_candidates = stats.rejected_candidates + 1u32;
                        }
                        break;
                    } else if ekind == GVN_KIND_SCALAR &&
                              (unsafe { (*ent).opcode }) == OPT_INST_CHECKED_BINOP &&
                              (unsafe { (*ent).sub_op }) == sub &&
                              (unsafe { (*ent).ty_v }) == inst_ty.v &&
                              sc_gvn_ops_match(
                                  view(*pm), view(*body), is_comm,
                                  (OptValueId { v: unsafe { (*ent).op0 } }), (OptValueId { v: unsafe { (*ent).op1 } }),
                                  lhs_id, rhs_id
                              ) {
                        let dbb_u = (unsafe { (*ent).def_bb }) as usize;
                        let di_u = (unsafe { (*ent).def_inst_idx }) as usize;
                        let dloc = unsafe { (*ent).def_local };
                        let dval = (OptValueId { v: unsafe { (*ent).def_val } });
                        if !sc_mir_local_clobbered_on_path(view(*body), mut_view(*arena), dbb_u, di_u, b_idx, i, dloc) {
                            let cand = CandidateRewrite {
                                pass_id: PASS_GVN_CSE,
                                required_prop: PROP_PURE_CALL,
                                proof_certainty: CERTAINTY_PROVEN,
                                proof_source_analysis: ANALYSIS_EFFECT_INFO,
                                proof_revision: pm.ir_revision,
                                target_effect_flags: EFFECT_PURE,
                                src_view_kind: 0u8,
                                dst_view_kind: 0u8,
                                is_removing_inst: false,
                                cost_delta: -2i32,
                            };
                            if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                unsafe {
                                    sc_rewrite_inst_to_copy_local(mut_view(*body), inst, dval, dloc);
                                }
                                stats.gvn_cse_eliminated = stats.gvn_cse_eliminated + 1u32;
                                *changed = true;
                                eliminated = true;
                            } else {
                                stats.rejected_candidates = stats.rejected_candidates + 1u32;
                            }
                            break;
                        }
                    }
                }
                if !eliminated &&
                   sc_local_is_unprojected_scalar(view(*body), unsafe { view((*inst).place) }) &&
                   scalar_type_is_copy_safe(body.thir, (TypeId { v: inst_ty.v })) {
                    let dlv = unsafe { (*inst).place.local.v };
                    if (body.local_dropped as usize) == 0 || !(unsafe { *opt_bool_at(body.local_dropped, dlv as usize) }) {
                        let nent = GvnEntry {
                            kind: GVN_KIND_SCALAR,
                            opcode: opc,
                            sub_op: sub,
                            is_comm: is_comm,
                            ty_v: inst_ty.v,
                            op0: lhs_id.v,
                            op1: rhs_id.v,
                            op2: 0u32,
                            op3: 0u32,
                            arg_cnt: 2u32,
                            mem_ver: 0u32,
                            def_bb: b_idx as u32,
                            def_inst_idx: i as u32,
                            def_val: res_id.v,
                            def_local: dlv,
                        };
                        sc_gvn_push_entry(table, mut_view(*table_len), table_cap, view(nent));
                    }
                }
            } else if (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP ||
                       opc == OPT_INST_UNOP || opc == OPT_INST_CAST) &&
                      scalar_type_is_copy_safe(body.thir, (TypeId { v: inst_ty.v })) && !has_fp {
                // C.2: Dominator-scoped Scalar Expression Value Numbering / CSE
                // Note: dominating deterministic scalar traps (EFFECT_MAY_PANIC) already executed at def_inst
                // on every path reaching cur_inst; memory/volatile/atomic/IO/unknown effects are strictly excluded.
                let eff = sc_effect_infer_inst_safe(view(*pm), view(*body), unsafe { view(*inst) }, max_steps);
                let non_trap_eff = eff & (0xFFFFu16 ^ EFFECT_MAY_PANIC);
                if non_trap_eff == EFFECT_PURE {
                    let is_comm = (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP) && scalar_is_commutative_binop(sub);
                    let mut eliminated = false;
                    let mut idx_rev = *table_len;
                    while idx_rev > 0 {
                        idx_rev = idx_rev - 1;
                        let ent = unsafe { sc_gvn_at(table, idx_rev) };
                        if (unsafe { (*ent).kind }) == GVN_KIND_SCALAR &&
                           (unsafe { (*ent).opcode }) == opc &&
                           (unsafe { (*ent).sub_op }) == sub &&
                           (unsafe { (*ent).ty_v }) == inst_ty.v &&
                           sc_gvn_ops_match(
                               view(*pm), view(*body), is_comm,
                               (OptValueId { v: unsafe { (*ent).op0 } }), (OptValueId { v: unsafe { (*ent).op1 } }),
                               lhs_id, rhs_id
                           ) {
                            let dbb_u = (unsafe { (*ent).def_bb }) as usize;
                            let di_u = (unsafe { (*ent).def_inst_idx }) as usize;
                            let dloc = unsafe { (*ent).def_local };
                            let dval = (OptValueId { v: unsafe { (*ent).def_val } });
                            if !sc_mir_local_clobbered_on_path(view(*body), mut_view(*arena), dbb_u, di_u, b_idx, i, dloc) {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_GVN_CSE,
                                    required_prop: PROP_PURE_CALL,
                                    proof_certainty: CERTAINTY_PROVEN,
                                    proof_source_analysis: ANALYSIS_EFFECT_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -2i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    unsafe {
                                        sc_rewrite_inst_to_copy_local(mut_view(*body), inst, dval, dloc);
                                    }
                                    stats.gvn_cse_eliminated = stats.gvn_cse_eliminated + 1u32;
                                    *changed = true;
                                    eliminated = true;
                                } else {
                                    stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                }
                                break;
                            }
                        }
                    }
                    if !eliminated && sc_local_is_unprojected_scalar(view(*body), unsafe { view((*inst).place) }) {
                        let dlv = unsafe { (*inst).place.local.v };
                        if (body.local_dropped as usize) == 0 || !(unsafe { *opt_bool_at(body.local_dropped, dlv as usize) }) {
                            let nent = GvnEntry {
                                kind: GVN_KIND_SCALAR,
                                opcode: opc,
                                sub_op: sub,
                                is_comm: is_comm,
                                ty_v: inst_ty.v,
                                op0: lhs_id.v,
                                op1: rhs_id.v,
                                op2: 0u32,
                                op3: 0u32,
                                arg_cnt: if opc == OPT_INST_UNOP || opc == OPT_INST_CAST { 1u32 } else { 2u32 },
                                mem_ver: 0u32,
                                def_bb: b_idx as u32,
                                def_inst_idx: i as u32,
                                def_val: res_id.v,
                                def_local: dlv,
                            };
                            sc_gvn_push_entry(table, mut_view(*table_len), table_cap, view(nent));
                        }
                    }
                }
            } else if opc == OPT_INST_LOAD && scalar_type_is_copy_safe(body.thir, (TypeId { v: inst_ty.v })) && !has_fp {
                // C.3: MemorySSA Load Value Numbering & Store-to-Load Forwarding (AXS-OPT-046)
                let mu_id = (MemSsaId { v: unsafe { (*inst).mem_use.v } });
                if mu_id.v != MEM_SSA_NONE {
                    let rreg = optir_extract_memory_region(view(*body), unsafe { view((*inst).rhs_place) });
                    let clob = memssa_find_clobbering_def(view(*body), mu_id, view(rreg), max_steps);
                    let mut forwarded = false;

                    // Subcase 1: Dominating MustAlias non-barrier Store -> Load Forwarding
                    if clob.v != MEM_SSA_LIVE_ON_ENTRY && clob.v != MEM_SSA_NONE && (clob.v as usize) < body.mem_ssa_count {
                        let dnode = unsafe { opt_memdef_at(body.mem_defs, clob.v as usize) };
                        if (unsafe { (*dnode).kind }) == MEM_DEF_INST && !(unsafe { (*dnode).is_barrier }) {
                            let sb = (unsafe { (*dnode).bb.v }) as usize;
                            let si = (unsafe { (*dnode).inst_idx }) as usize;
                            if sb < body.bb_count &&
                               opt_dominates(view(*body), (OptBbId { v: sb as u32 }), (OptBbId { v: b_idx as u32 })) &&
                               (sb != b_idx || si < i) {
                                let sbb = unsafe { opt_block_at(body.blocks, sb) };
                                if si < (unsafe { (*sbb).inst_count }) {
                                    let sinst = unsafe { opt_inst_at((*sbb).insts, si) };
                                    if !sc_inst_is_deleted_nop(unsafe { view(*sinst) }) &&
                                       (unsafe { (*sinst).opcode }) == OPT_INST_STORE &&
                                       ((unsafe { (*sinst).flags }) & OPT_FLAG_BARRIER) == 0u16 &&
                                       (unsafe { (*sinst).ty.v }) == inst_ty.v {
                                        let al = optir_alias_query(view(*body), unsafe { view((*dnode).region) }, view(rreg));
                                        if al == ALIAS_MUST_ALIAS &&
                                           (unsafe { (*dnode).region.byte_size }) == rreg.byte_size &&
                                           !sc_region_clobbered_on_path(view(*body), mut_view(*arena), call_table, sb, si, b_idx, i, view(rreg)) &&
                                           !sc_place_address_locals_clobbered_on_path(view(*body), mut_view(*arena), sb, si, b_idx, i, unsafe { view((*inst).rhs_place) }) &&
                                           !sc_place_address_locals_clobbered_on_path(view(*body), mut_view(*arena), sb, si, b_idx, i, unsafe { view((*sinst).place) }) {
                                            let sval = (OptValueId { v: unsafe { (*sinst).lhs.v } });
                                            let cand = CandidateRewrite {
                                                pass_id: PASS_GVN_CSE,
                                                required_prop: PROP_NO_ALIAS,
                                                proof_certainty: CERTAINTY_PROVEN,
                                                proof_source_analysis: ANALYSIS_ALIAS_INFO,
                                                proof_revision: pm.ir_revision,
                                                target_effect_flags: EFFECT_PURE,
                                                src_view_kind: unsafe { (*inst).rhs_place.view_kind },
                                                dst_view_kind: unsafe { (*inst).place.view_kind },
                                                is_removing_inst: false,
                                                cost_delta: -3i32,
                                            };
                                            if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                                if sc_apply_copy_or_const_rewrite(
                                                    view(*pm), mut_view(*body), mut_view(*arena), inst, b_idx, i, PASS_GVN_CSE, sval
                                                ) {
                                                    optir_record_provenance(
                                                        mut_view(*body),
                                                        mut_view(*arena),
                                                        PROP_NO_ALIAS,
                                                        CERTAINTY_PROVEN,
                                                        ANALYSIS_ALIAS_INFO,
                                                        res_id,
                                                        sval,
                                                        (OptBbId { v: b_idx as u32 }),
                                                        (OptInstId { v: unsafe { (*inst).id.v } }),
                                                        PASS_GVN_CSE
                                                    );
                                                    stats.gvn_loads_forwarded = stats.gvn_loads_forwarded + 1u32;
                                                    *changed = true;
                                                    forwarded = true;
                                                }
                                            } else {
                                                stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Subcase 2: Redundant Load Elimination across non-clobbering (NoAlias) memory versions
                    if !forwarded {
                        let mut idx_rev = *table_len;
                        while idx_rev > 0 {
                            idx_rev = idx_rev - 1;
                            let ent = unsafe { sc_gvn_at(table, idx_rev) };
                            if (unsafe { (*ent).kind }) == GVN_KIND_LOAD &&
                               (unsafe { (*ent).mem_ver }) == clob.v &&
                               (unsafe { (*ent).ty_v }) == inst_ty.v {
                                let pb = (unsafe { (*ent).def_bb }) as usize;
                                let pi = (unsafe { (*ent).def_inst_idx }) as usize;
                                let ploc = unsafe { (*ent).def_local };
                                let pval = (OptValueId { v: unsafe { (*ent).def_val } });
                                if pb < body.bb_count {
                                    let pbb = unsafe { opt_block_at(body.blocks, pb) };
                                    if pi < (unsafe { (*pbb).inst_count }) {
                                        let pinst = unsafe { opt_inst_at((*pbb).insts, pi) };
                                        let preg = optir_extract_memory_region(view(*body), unsafe { view((*pinst).rhs_place) });
                                        if !sc_inst_is_deleted_nop(unsafe { view(*pinst) }) &&
                                           (unsafe { (*pinst).opcode }) == OPT_INST_LOAD &&
                                           optir_alias_query(view(*body), view(preg), view(rreg)) == ALIAS_MUST_ALIAS &&
                                           preg.byte_size == rreg.byte_size &&
                                           !sc_region_clobbered_on_path(view(*body), mut_view(*arena), call_table, pb, pi, b_idx, i, view(rreg)) &&
                                           !sc_place_address_locals_clobbered_on_path(view(*body), mut_view(*arena), pb, pi, b_idx, i, unsafe { view((*inst).rhs_place) }) &&
                                           !sc_place_address_locals_clobbered_on_path(view(*body), mut_view(*arena), pb, pi, b_idx, i, unsafe { view((*pinst).rhs_place) }) &&
                                           !sc_mir_local_clobbered_on_path(view(*body), mut_view(*arena), pb, pi, b_idx, i, ploc) {
                                            let cand = CandidateRewrite {
                                                pass_id: PASS_GVN_CSE,
                                                required_prop: PROP_NO_ALIAS,
                                                proof_certainty: CERTAINTY_PROVEN,
                                                proof_source_analysis: ANALYSIS_ALIAS_INFO,
                                                proof_revision: pm.ir_revision,
                                                target_effect_flags: EFFECT_PURE,
                                                src_view_kind: unsafe { (*inst).rhs_place.view_kind },
                                                dst_view_kind: unsafe { (*inst).place.view_kind },
                                                is_removing_inst: false,
                                                cost_delta: -3i32,
                                            };
                                            if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                                optir_record_provenance(
                                                    mut_view(*body),
                                                    mut_view(*arena),
                                                    PROP_NO_ALIAS,
                                                    CERTAINTY_PROVEN,
                                                    ANALYSIS_ALIAS_INFO,
                                                    res_id,
                                                    pval,
                                                    (OptBbId { v: b_idx as u32 }),
                                                    (OptInstId { v: unsafe { (*inst).id.v } }),
                                                    PASS_GVN_CSE
                                                );
                                                unsafe {
                                                    sc_rewrite_inst_to_copy_local(mut_view(*body), inst, pval, ploc);
                                                }
                                                stats.gvn_loads_forwarded = stats.gvn_loads_forwarded + 1u32;
                                                *changed = true;
                                                forwarded = true;
                                            } else {
                                                stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                            }
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if !forwarded && sc_local_is_unprojected_scalar(view(*body), unsafe { view((*inst).place) }) {
                        let dlv = unsafe { (*inst).place.local.v };
                        if (body.local_dropped as usize) == 0 || !(unsafe { *opt_bool_at(body.local_dropped, dlv as usize) }) {
                            let nent = GvnEntry {
                                kind: GVN_KIND_LOAD,
                                opcode: OPT_INST_LOAD,
                                sub_op: 0u8,
                                is_comm: false,
                                ty_v: inst_ty.v,
                                op0: 0u32,
                                op1: 0u32,
                                op2: 0u32,
                                op3: 0u32,
                                arg_cnt: 0u32,
                                mem_ver: clob.v,
                                def_bb: b_idx as u32,
                                def_inst_idx: i as u32,
                                def_val: res_id.v,
                                def_local: dlv,
                            };
                            sc_gvn_push_entry(table, mut_view(*table_len), table_cap, view(nent));
                        }
                    }
                }
            }
        }
        i = i + 1;
    }

    // C.4: Terminator-level facts (dominating NoOverflow asserts and Pure Call CSE)
    if unsafe { (*bb).has_term } {
        let tk = unsafe { (*bb).term.kind };
        if tk == OPT_TERM_ASSERT {
            let cond_id = (OptValueId { v: unsafe { (*bb).term.cond.v } });
            let exp = unsafe { (*bb).term.assert_expected };
            let true_bb_v = unsafe { (*bb).term.true_bb.v };
            let mut db1: usize = 0;
            let mut di1: usize = 0;
            let mut ovf_inst = sc_find_def_inst(view(*body), cond_id, mut_view(db1), mut_view(di1));
            let mut ovf_is_false = !exp;
            if (ovf_inst as usize) != 0 &&
               (unsafe { (*ovf_inst).opcode }) == OPT_INST_UNOP &&
               (unsafe { (*ovf_inst).sub_op }) == MIR_UNOP_NOT {
                let inner_id = (OptValueId { v: unsafe { (*ovf_inst).lhs.v } });
                ovf_inst = sc_find_def_inst(view(*body), inner_id, mut_view(db1), mut_view(di1));
                ovf_is_false = exp;
            }
            if ovf_is_false && (ovf_inst as usize) != 0 &&
               (unsafe { (*ovf_inst).opcode }) == OPT_INST_CHECKED_BINOP &&
               true_bb_v != OPT_BB_NONE {
                let olhs = (OptValueId { v: unsafe { (*ovf_inst).lhs.v } });
                let orhs = (OptValueId { v: unsafe { (*ovf_inst).rhs.v } });
                let osub = unsafe { (*ovf_inst).sub_op };
                let oty = scalar_val_ty(view(*body), olhs, (TypeId { v: 0u32 }));
                let aent = GvnEntry {
                    kind: GVN_KIND_CHECKED_ASSERTED,
                    opcode: OPT_INST_CHECKED_BINOP,
                    sub_op: osub,
                    is_comm: scalar_is_commutative_binop(osub),
                    ty_v: oty.v,
                    op0: olhs.v,
                    op1: orhs.v,
                    op2: 0u32,
                    op3: 0u32,
                    arg_cnt: 2u32,
                    mem_ver: 0u32,
                    def_bb: true_bb_v,
                    def_inst_idx: 0u32,
                    def_val: 0u32,
                    def_local: 0u32,
                };
                sc_gvn_push_entry(table, mut_view(*table_len), table_cap, view(aent));
            }
        } else if tk == OPT_TERM_CALL {
            // Pure Call CSE: ONLY INTRINSIC_SEM_PURE_CALL may be eliminated; explicit Clone / impure preserved (REQ-OPT-306)
            let csem = scalar_classify_call_intrinsic(view(*body), unsafe { view((*bb).term) }, call_table);
            let cac = unsafe { (*bb).term.call_arg_count };
            if csem == INTRINSIC_SEM_PURE_CALL &&
               (unsafe { (*bb).term.has_call_dest }) &&
               sc_local_is_unprojected_scalar(view(*body), unsafe { view((*bb).term.call_dest) }) &&
               cac <= 4 &&
               !sc_mir_term_has_move_arg(unsafe { view((*bb).term.orig_term) }) {
                let cres_id = (OptValueId { v: unsafe { (*bb).term.call_result.v } });
                let cres_ty = scalar_val_ty(view(*body), cres_id, (TypeId { v: 0u32 }));
                let cal_id = (OptValueId { v: unsafe { (*bb).term.callee.v } });
                let cargs = unsafe { (*bb).term.call_args };
                let mut call_fp = scalar_raw_val_has_fp_hazard(view(*pm), view(*body), cres_id);
                let mut ai: usize = 0;
                while ai < cac {
                    let av = unsafe { *opt_valid_at(cargs, ai) };
                    if scalar_raw_val_has_fp_hazard(view(*pm), view(*body), av) {
                        call_fp = true;
                    }
                    ai = ai + 1;
                }
                if !call_fp && scalar_type_is_copy_safe(body.thir, (TypeId { v: cres_ty.v })) {
                    let a0_v: u32 = if cac > 0 { unsafe { (*opt_valid_at(cargs, 0)).v } } else { OPT_VALUE_NONE };
                    let a1_v: u32 = if cac > 1 { unsafe { (*opt_valid_at(cargs, 1)).v } } else { OPT_VALUE_NONE };
                    let a2_v: u32 = if cac > 2 { unsafe { (*opt_valid_at(cargs, 2)).v } } else { OPT_VALUE_NONE };
                    let a3_v: u32 = if cac > 3 { unsafe { (*opt_valid_at(cargs, 3)).v } } else { OPT_VALUE_NONE };
                    let cur_inst_end = unsafe { (*bb).inst_count };
                    let mut call_elim = false;
                    let mut idx_rev = *table_len;
                    while idx_rev > 0 {
                        idx_rev = idx_rev - 1;
                        let ent = unsafe { sc_gvn_at(table, idx_rev) };
                        if (unsafe { (*ent).kind }) == GVN_KIND_PURE_CALL &&
                           (unsafe { (*ent).arg_cnt }) == (cac as u32) &&
                           (unsafe { (*ent).mem_ver }) == cres_ty.v &&
                           sc_gvn_value_eq(view(*pm), view(*body), (OptValueId { v: unsafe { (*ent).ty_v } }), cal_id) {
                            let cont_bb_v = unsafe { (*ent).def_bb };
                            let call_bb_v = unsafe { (*ent).def_inst_idx };
                            let dloc = unsafe { (*ent).def_local };
                            let dval_v = unsafe { (*ent).def_val };
                            let m0 = cac <= 0 || sc_gvn_value_eq(view(*pm), view(*body), (OptValueId { v: unsafe { (*ent).op0 } }), (OptValueId { v: a0_v }));
                            let m1 = cac <= 1 || sc_gvn_value_eq(view(*pm), view(*body), (OptValueId { v: unsafe { (*ent).op1 } }), (OptValueId { v: a1_v }));
                            let m2 = cac <= 2 || sc_gvn_value_eq(view(*pm), view(*body), (OptValueId { v: unsafe { (*ent).op2 } }), (OptValueId { v: a2_v }));
                            let m3 = cac <= 3 || sc_gvn_value_eq(view(*pm), view(*body), (OptValueId { v: unsafe { (*ent).op3 } }), (OptValueId { v: a3_v }));
                            if m0 && m1 && m2 && m3 &&
                               cont_bb_v != OPT_BB_NONE &&
                               call_bb_v != OPT_BB_NONE &&
                               opt_dominates(view(*body), (OptBbId { v: call_bb_v }), (OptBbId { v: b_idx as u32 })) &&
                               opt_dominates(view(*body), (OptBbId { v: cont_bb_v }), (OptBbId { v: b_idx as u32 })) &&
                               !sc_call_dest_clobbered_on_path(view(*body), mut_view(*arena), call_bb_v as usize, cont_bb_v as usize, b_idx, cur_inst_end, dloc) {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_GVN_CSE,
                                    required_prop: PROP_PURE_CALL,
                                    proof_certainty: CERTAINTY_PROVEN,
                                    proof_source_analysis: ANALYSIS_EFFECT_INFO,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: false,
                                    cost_delta: -4i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    let new_iid_v = body.inst_count as u32;
                                    body.inst_count = body.inst_count + 1;
                                    let copy_inst = arena_alloc_raw(mut_view(*arena), size_of<OptInst>(), align_of<OptInst>()) as *mut OptInst;
                                    let mut cspan = Span { file: (FileId { v: 0u32 }), start: 0u32, end: 0u32 };
                                    unsafe {
                                        mir_span_copy(mut_view(cspan), view((*bb).term.orig_term.location));
                                        (*copy_inst).id = (OptInstId { v: new_iid_v });
                                        (*copy_inst).opcode = OPT_INST_COPY;
                                        (*copy_inst).sub_op = 0u8;
                                        (*copy_inst).flags = 0u16;
                                        (*copy_inst).result = cres_id;
                                        (*copy_inst).ty = (TypeId { v: cres_ty.v });
                                        (*copy_inst).lhs = (OptValueId { v: dval_v });
                                        if cres_id.v != OPT_VALUE_NONE && (cres_id.v as usize) <= body.value_count && (body.values as usize) != 0 {
                                            let cvp = opt_val_at(body.values, cres_id.v as usize);
                                            (*cvp).def_inst = (OptInstId { v: new_iid_v });
                                        }
                                        (*copy_inst).rhs = (OptValueId { v: OPT_VALUE_NONE });
                                        (*copy_inst).extra_args = 0 as *mut OptValueId;
                                        (*copy_inst).extra_arg_count = 0;
                                        mir_copy_place(mut_view((*copy_inst).place), view((*bb).term.call_dest));
                                        (*copy_inst).rhs_place = mir_local_place(dloc);
                                        (*copy_inst).mem_use = (MemSsaId { v: MEM_SSA_NONE });
                                        (*copy_inst).mem_def = (MemSsaId { v: MEM_SSA_NONE });
                                        (*copy_inst).origin = OptOrigin {
                                            span: Span { file: (FileId { v: cspan.file.v }), start: cspan.start, end: cspan.end },
                                            mir_bb: (MirBbId { v: b_idx as u32 }),
                                            mir_stmt_idx: cur_inst_end as u32,
                                            pass_id: PASS_GVN_CSE,
                                        };
                                        mir_stmt_reset(mut_view((*copy_inst).orig_stmt), MIR_STMT_ASSIGN, view(cspan));
                                        mir_copy_place(mut_view((*copy_inst).orig_stmt.place), view((*bb).term.call_dest));
                                        mir_rvalue_reset(mut_view((*copy_inst).orig_stmt.rvalue), MIR_RVALUE_USE);
                                        (*copy_inst).orig_stmt.rvalue.use_op.kind = MIR_OP_COPY;
                                        (*copy_inst).orig_stmt.rvalue.use_op.place = mir_local_place(dloc);
                                    }
                                    sc_replace_value_uses_except_def(mut_view(*body), cres_id, (OptValueId { v: dval_v }), new_iid_v);
                                    unsafe {
                                        sc_inst_grow_push(mut_view(*bb), mut_view(*arena), copy_inst as *const OptInst);
                                        let next_tgt = (*bb).term.true_bb;
                                        (*bb).term.mem_use = (MemSsaId { v: MEM_SSA_NONE });
                                        (*bb).term.mem_def = (MemSsaId { v: MEM_SSA_NONE });
                                        sc_rewrite_term_to_goto(bb, next_tgt);
                                    }
                                    optir_record_provenance(
                                        mut_view(*body),
                                        mut_view(*arena),
                                        PROP_PURE_CALL,
                                        CERTAINTY_PROVEN,
                                        ANALYSIS_EFFECT_INFO,
                                        cres_id,
                                        (OptValueId { v: dval_v }),
                                        (OptBbId { v: b_idx as u32 }),
                                        (OptInstId { v: new_iid_v }),
                                        PASS_GVN_CSE
                                    );
                                    stats.gvn_pure_calls_eliminated = stats.gvn_pure_calls_eliminated + 1u32;
                                    *changed = true;
                                    *cfg_changed = true;
                                    call_elim = true;
                                } else {
                                    stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                }
                                break;
                            }
                        }
                    }
                    if !call_elim {
                        let cloc = unsafe { (*bb).term.call_dest.local.v };
                        let cont_v = unsafe { (*bb).term.true_bb.v };
                        if cont_v != OPT_BB_NONE &&
                           ((body.local_dropped as usize) == 0 || !(unsafe { *opt_bool_at(body.local_dropped, cloc as usize) })) {
                            let cent = GvnEntry {
                                kind: GVN_KIND_PURE_CALL,
                                opcode: OPT_TERM_CALL,
                                sub_op: 0u8,
                                is_comm: false,
                                ty_v: cal_id.v,
                                op0: a0_v,
                                op1: a1_v,
                                op2: a2_v,
                                op3: a3_v,
                                arg_cnt: cac as u32,
                                mem_ver: cres_ty.v,
                                def_bb: cont_v,
                                def_inst_idx: b_idx as u32,
                                def_val: cres_id.v,
                                def_local: cloc,
                            };
                            sc_gvn_push_entry(table, mut_view(*table_len), table_cap, view(cent));
                        }
                    }
                }
            }
        }
    }

    // Recurse on dominated child blocks in deterministic block index order
    let mut child_b: usize = 0;
    while child_b < body.bb_count {
        if child_b != b_idx {
            let cbb = unsafe { opt_block_at(body.blocks, child_b) };
            if (unsafe { (*cbb).is_reachable }) && (unsafe { (*cbb).idom.v }) == (b_idx as u32) {
                sc_gvn_walk_dom_tree(
                    mut_view(*pm), mut_view(*body), call_table,
                    table, mut_view(*table_len), table_cap, child_b,
                    mut_view(*stats), mut_view(*changed), mut_view(*cfg_changed), mut_view(*arena)
                );
            }
        }
        child_b = child_b + 1;
    }

    *table_len = saved_len;
}

pub fn scalar_run_gvn_cse(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    stats: mut_view<ScalarOptStats>,
    arena: mut_view<Arena>
) -> bool {
    if body.bb_count == 0 || (body.blocks as usize) == 0 {
        return false;
    }
    let table_cap = body.inst_count + sc_mul_usize(body.bb_count, 2) + 16;
    let table = arena_alloc_raw(mut_view(*arena), sc_mul_usize(table_cap, size_of<GvnEntry>()), align_of<GvnEntry>()) as *mut GvnEntry;
    let mut table_len: usize = 0;
    let mut changed = false;
    let mut cfg_changed = false;

    sc_gvn_walk_dom_tree(
        mut_view(*pm), mut_view(*body), call_table,
        table, mut_view(table_len), table_cap, 0,
        mut_view(*stats), mut_view(changed), mut_view(cfg_changed), mut_view(*arena)
    );

    if cfg_changed {
        let _ = sc_prune_unreachable_and_rebuild_cfg_ssa(mut_view(*pm), mut_view(*body), mut_view(*arena));
        changed = true;
    } else if changed && (body.mem_defs as usize) != 0 {
        optir_compute_dom_frontier(mut_view(*body), mut_view(*arena));
        optir_construct_memssa(mut_view(*body), mut_view(*arena));
    }
    changed
}

// ============================================================================
// Component D: Effect-Aware Worklist DCE, Dead-Store & Move/Copy Elision (AXS-OPT-047)
// ============================================================================

fn sc_count_value_uses_excluding_inst(
    body: view<OptBody>,
    target_val: OptValueId,
    skip_inst_v: u32
) -> u32 {
    let tv = target_val.v;
    if tv == OPT_VALUE_NONE {
        return 0u32;
    }
    let mut uses: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let pcnt = unsafe { (*bb).phi_count };
            let phis = unsafe { (*bb).phis };
            let mut p: usize = 0;
            while p < pcnt {
                let phi = unsafe { opt_phi_at(phis, p) };
                let arity = unsafe { (*phi).arity };
                let ivs = unsafe { (*phi).incoming_values };
                let mut k: usize = 0;
                while k < arity {
                    if (unsafe { (*opt_valid_at(ivs, k)).v }) == tv {
                        uses = uses + 1u32;
                    }
                    k = k + 1;
                }
                p = p + 1;
            }
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                if !sc_inst_is_deleted_nop(unsafe { view(*inst) }) && (unsafe { (*inst).id.v }) != skip_inst_v {
                    let opc = unsafe { (*inst).opcode };
                    let lhs_v = unsafe { (*inst).lhs.v };
                    let res_v = unsafe { (*inst).result.v };
                    let is_const_self = opc == OPT_INST_CONST && lhs_v == res_v;
                    if !is_const_self && lhs_v == tv {
                        uses = uses + 1u32;
                    }
                    if (unsafe { (*inst).rhs.v }) == tv {
                        uses = uses + 1u32;
                    }
                    let eac = unsafe { (*inst).extra_arg_count };
                    let eargs = unsafe { (*inst).extra_args };
                    let mut ei: usize = 0;
                    while ei < eac {
                        if (unsafe { (*opt_valid_at(eargs, ei)).v }) == tv {
                            uses = uses + 1u32;
                        }
                        ei = ei + 1;
                    }
                }
                i = i + 1;
            }
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) != OPT_TERM_UNREACHABLE {
                if (unsafe { (*bb).term.cond.v }) == tv { uses = uses + 1u32; }
                if (unsafe { (*bb).term.callee.v }) == tv { uses = uses + 1u32; }
                let cac = unsafe { (*bb).term.call_arg_count };
                let cargs = unsafe { (*bb).term.call_args };
                let mut ci: usize = 0;
                while ci < cac {
                    if (unsafe { (*opt_valid_at(cargs, ci)).v }) == tv {
                        uses = uses + 1u32;
                    }
                    ci = ci + 1;
                }
            }
        }
        b = b + 1;
    }
    uses
}

fn sc_prove_dead_store(
    pm: view<PassManager>,
    body: view<OptBody>,
    arena: mut_view<Arena>,
    b: usize,
    i: usize,
    inst: view<OptInst>,
    max_steps: u32
) -> bool {
    if inst.opcode != OPT_INST_STORE {
        return false;
    }
    if (inst.flags & OPT_FLAG_BARRIER) != 0u16 || inst.place.drop_flag != MIR_DROP_FLAG_NONE {
        return false;
    }
    if sc_mir_stmt_has_move_operand(view(inst.orig_stmt)) {
        return false;
    }
    let eff = sc_effect_infer_inst_safe(pm, body, inst, max_steps);
    if (eff & EFFECT_MASK_NON_STORE_OBSERVABLE) != 0u16 {
        return false;
    }

    let wreg1 = optir_extract_memory_region(body, view(inst.place));

    // 1. Same-block MustAlias overwrite before any aliasing read, address-of, drop, or barrier
    let bb = unsafe { opt_block_at(body.blocks, b) };
    let icnt = unsafe { (*bb).inst_count };
    let insts = unsafe { (*bb).insts };
    let mut k: usize = i + 1;
    let mut blocked_same_bb = false;
    while k < icnt && !blocked_same_bb {
        let inst_k = unsafe { opt_inst_at(insts, k) };
        if !sc_inst_is_deleted_nop(unsafe { view(*inst_k) }) {
            let opc_k = unsafe { (*inst_k).opcode };
            let flg_k = unsafe { (*inst_k).flags };
            if (flg_k & OPT_FLAG_BARRIER) != 0u16 ||
               opc_k == OPT_INST_BLACK_BOX || opc_k == OPT_INST_ZEROIZE ||
               opc_k == OPT_INST_VOLATILE_LOAD || opc_k == OPT_INST_VOLATILE_STORE ||
               opc_k == OPT_INST_ATOMIC || opc_k == OPT_INST_DROP_FLAG {
                blocked_same_bb = true;
            } else if (flg_k & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
                let sloc = unsafe { (*inst_k).orig_stmt.storage_local.v };
                if wreg1.domain == STORAGE_STACK_LOCAL {
                    if sloc == wreg1.base_local.v || (unsafe { (*inst_k).place.local.v }) == wreg1.base_local.v {
                        blocked_same_bb = true;
                    }
                } else if sc_local_addr_taken_anywhere(body, sloc) {
                    blocked_same_bb = true;
                }
            } else if opc_k == OPT_INST_ADDR_OF || (unsafe { (*inst_k).orig_stmt.rvalue.kind }) == MIR_RVALUE_REF {
                let areg = optir_extract_memory_region(body, unsafe { view((*inst_k).rhs_place) });
                if optir_alias_query(body, view(wreg1), view(areg)) != ALIAS_NO_ALIAS {
                    blocked_same_bb = true;
                } else if wreg1.domain == STORAGE_STACK_LOCAL &&
                          ((unsafe { (*inst_k).rhs_place.local.v }) == wreg1.base_local.v ||
                           (unsafe { (*inst_k).orig_stmt.rvalue.place.local.v }) == wreg1.base_local.v) {
                    blocked_same_bb = true;
                }
            } else {
                // Check if inst_k reads memory or operands that may alias wreg1
                if (unsafe { (*inst_k).mem_use.v }) != MEM_SSA_NONE ||
                   opc_k == OPT_INST_LOAD || opc_k == OPT_INST_EXTRACT_FIELD ||
                   opc_k == OPT_INST_LEN || opc_k == OPT_INST_DISCRIMINANT {
                    let rreg = optir_extract_memory_region(body, unsafe { view((*inst_k).rhs_place) });
                    if optir_alias_query(body, view(wreg1), view(rreg)) != ALIAS_NO_ALIAS {
                        blocked_same_bb = true;
                    }
                }
                if !blocked_same_bb &&
                   sc_mir_stmt_reads_aliasing_region(body, unsafe { view((*inst_k).orig_stmt) }, view(wreg1)) {
                    blocked_same_bb = true;
                }
                if !blocked_same_bb && inst.place.proj_count == 0 &&
                   sc_mir_stmt_reads_or_drops_local(unsafe { view((*inst_k).orig_stmt) }, inst.place.local.v) {
                    blocked_same_bb = true;
                }
                if !blocked_same_bb && (unsafe { (*inst_k).orig_stmt.kind }) == MIR_STMT_DROP {
                    let dreg = optir_extract_memory_region(body, unsafe { view((*inst_k).orig_stmt.place) });
                    if optir_alias_query(body, view(wreg1), view(dreg)) != ALIAS_NO_ALIAS {
                        blocked_same_bb = true;
                    }
                }
                if !blocked_same_bb {
                    let eff_k = sc_effect_infer_inst_safe(pm, body, unsafe { view(*inst_k) }, max_steps);
                    if (eff_k & EFFECT_MAY_PANIC) != 0u16 {
                        if wreg1.domain != STORAGE_STACK_LOCAL ||
                           ((unsafe { (*bb).has_term }) && (unsafe { (*bb).term.unwind_bb.v }) != OPT_BB_NONE) {
                            blocked_same_bb = true;
                        }
                    }
                }
                if !blocked_same_bb && (unsafe { (*inst_k).orig_stmt.kind }) == MIR_STMT_ASSIGN {
                    let wreg2 = optir_extract_memory_region(body, unsafe { view((*inst_k).place) });
                    let al2 = optir_alias_query(body, view(wreg1), view(wreg2));
                    if opc_k == OPT_INST_STORE &&
                       (unsafe { (*inst_k).place.drop_flag }) == MIR_DROP_FLAG_NONE &&
                       al2 == ALIAS_MUST_ALIAS &&
                       wreg1.byte_size == wreg2.byte_size &&
                       (unsafe { (*inst_k).ty.v }) == inst.ty.v &&
                       !sc_place_address_locals_clobbered_on_path(body, mut_view(*arena), b, i, b, k, view(inst.place)) {
                        return true;
                    }
                    if al2 != ALIAS_NO_ALIAS {
                        blocked_same_bb = true;
                    }
                }
            }
        }
        k = k + 1;
    }

    // 2. Store to non-address-taken, non-dropped unprojected stack local (loc != _0) never read anywhere in OptBody
    if wreg1.domain == STORAGE_STACK_LOCAL && inst.place.proj_count == 0 {
        let dlv = wreg1.base_local.v as usize;
        if dlv > 0 && dlv < body.local_count {
            let dropped: bool = if (body.local_dropped as usize) != 0 {
                unsafe { *opt_bool_at(body.local_dropped, dlv) }
            } else {
                false
            };
            if !sc_local_addr_taken_anywhere(body, dlv as u32) && !dropped &&
               !sc_mir_local_read_or_dropped_anywhere(body, b, i, dlv as u32) {
                return true;
            }
        }
    }
    false
}

fn sc_local_has_any_non_storage_stmt(body: view<OptBody>, loc_v: u32) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            let opc = unsafe { (*inst).opcode };
            let flg = unsafe { (*inst).flags };
            if opc != OPT_INST_NOP {
                if (unsafe { (*inst).place.local.v }) == loc_v ||
                   (unsafe { (*inst).rhs_place.local.v }) == loc_v ||
                   sc_mir_stmt_reads_or_drops_local(unsafe { view((*inst).orig_stmt) }, loc_v) {
                    return true;
                }
            } else if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 {
                // deleted nop: ignore
            }
            i = i + 1;
        }
        if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) != OPT_TERM_UNREACHABLE {
            if sc_mir_term_reads_or_drops_local(unsafe { view((*bb).term.orig_term) }, loc_v) {
                return true;
            }
            if (unsafe { (*bb).term.kind }) == OPT_TERM_CALL &&
               (unsafe { (*bb).term.has_call_dest }) &&
               (unsafe { (*bb).term.call_dest.local.v }) == loc_v {
                return true;
            }
        }
        b = b + 1;
    }
    false
}

unsafe fn sc_wipe_inst_to_nop(inst: *mut OptInst) {
    (*inst).opcode = OPT_INST_NOP;
    (*inst).sub_op = 0u8;
    (*inst).flags = 0u16;
    (*inst).lhs = (OptValueId { v: OPT_VALUE_NONE });
    (*inst).rhs = (OptValueId { v: OPT_VALUE_NONE });
    (*inst).extra_arg_count = 0;
    (*inst).mem_use = (MemSsaId { v: MEM_SSA_NONE });
    (*inst).mem_def = (MemSsaId { v: MEM_SSA_NONE });
}

pub fn scalar_run_dce(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    stats: mut_view<ScalarOptStats>,
    arena: mut_view<Arena>
) -> bool {
    let _ = call_table;
    let max_steps = pm.budget.max_symbolic_steps;
    let mut changed = false;
    let mut dce_mem_changed = false;
    let mut round_changed = true;
    let mut iter_guard: u32 = 0u32;

    while round_changed && iter_guard < 16u32 {
        round_changed = false;
        iter_guard = iter_guard + 1u32;

        // 1. Prune unused OptPhis in reachable blocks so feeding definitions can become dead
        let mut pb: usize = 0;
        while pb < body.bb_count {
            let pbb = unsafe { opt_block_at(body.blocks, pb) };
            if unsafe { (*pbb).is_reachable } {
                let pcnt = unsafe { (*pbb).phi_count };
                let phis = unsafe { (*pbb).phis };
                let mut wp: usize = 0;
                let mut p: usize = 0;
                while p < pcnt {
                    let phi = unsafe { opt_phi_at(phis, p) };
                    let pres = (OptValueId { v: unsafe { (*phi).result.v } });
                    let uses = sc_count_value_uses_excluding_inst(view(*body), pres, OPT_INST_NONE);
                    if uses == 0u32 {
                        stats.dce_insts_eliminated = stats.dce_insts_eliminated + 1u32;
                        changed = true;
                        round_changed = true;
                    } else {
                        if wp != p {
                            let dst_p = unsafe { opt_phi_at(phis, wp) };
                            unsafe {
                                ptr_copy_nonoverlapping<u8>(phi as *const u8, dst_p as *mut u8, size_of<OptPhi>());
                            }
                        }
                        wp = wp + 1;
                    }
                    p = p + 1;
                }
                unsafe { (*pbb).phi_count = wp; }
            }
            pb = pb + 1;
        }

        // 2. Backward scan of instructions in reachable blocks for DeadStore and dead pure/copy/move elision
        let mut b_rev = body.bb_count;
        while b_rev > 0 {
            b_rev = b_rev - 1;
            let bb = unsafe { opt_block_at(body.blocks, b_rev) };
            if unsafe { (*bb).is_reachable } {
                let icnt = unsafe { (*bb).inst_count };
                let insts = unsafe { (*bb).insts };
                let mut i_rev = icnt;
                while i_rev > 0 {
                    i_rev = i_rev - 1;
                    let inst = unsafe { opt_inst_at(insts, i_rev) };
                    let opc = unsafe { (*inst).opcode };
                    let flg = unsafe { (*inst).flags };

                    if !sc_inst_is_deleted_nop(unsafe { view(*inst) }) &&
                       (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 {

                        // Never touch explicit semantic barriers (REQ-OPT-011, REQ-OPT-351..353)
                        let is_hard_barrier = (flg & OPT_FLAG_BARRIER) != 0u16 ||
                                              opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE ||
                                              opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_VOLATILE_STORE ||
                                              opc == OPT_INST_ATOMIC || opc == OPT_INST_DROP_FLAG;

                        if !is_hard_barrier && opc == OPT_INST_STORE {
                            if sc_prove_dead_store(view(*pm), view(*body), mut_view(*arena), b_rev, i_rev, unsafe { view(*inst) }, max_steps) {
                                let cand = CandidateRewrite {
                                    pass_id: PASS_DCE,
                                    required_prop: PROP_DEAD_STORE,
                                    proof_certainty: CERTAINTY_PROVEN,
                                    proof_source_analysis: ANALYSIS_MEMORY_SSA,
                                    proof_revision: pm.ir_revision,
                                    target_effect_flags: EFFECT_PURE,
                                    src_view_kind: 0u8,
                                    dst_view_kind: 0u8,
                                    is_removing_inst: true,
                                    cost_delta: -2i32,
                                };
                                if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                    optir_record_provenance(
                                        mut_view(*body),
                                        mut_view(*arena),
                                        PROP_DEAD_STORE,
                                        CERTAINTY_PROVEN,
                                        ANALYSIS_MEMORY_SSA,
                                        (OptValueId { v: unsafe { (*inst).lhs.v } }),
                                        (OptValueId { v: OPT_VALUE_NONE }),
                                        (OptBbId { v: b_rev as u32 }),
                                        (OptInstId { v: unsafe { (*inst).id.v } }),
                                        PASS_DCE
                                    );
                                    unsafe { sc_wipe_inst_to_nop(inst); }
                                    stats.dce_dead_stores_eliminated = stats.dce_dead_stores_eliminated + 1u32;
                                    stats.dce_insts_eliminated = stats.dce_insts_eliminated + 1u32;
                                    changed = true;
                                    dce_mem_changed = true;
                                    round_changed = true;
                                } else {
                                    stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                }
                            }
                        } else if !is_hard_barrier && opc != OPT_INST_INSERT_FIELD &&
                                  sc_can_dce_inst_safe(view(*pm), view(*body), unsafe { view(*inst) }, max_steps) {
                            let dloc = unsafe { (*inst).place.local.v };
                            let dst_dropped: bool = if (dloc as usize) < body.local_count && (body.local_dropped as usize) != 0 {
                                unsafe { *opt_bool_at(body.local_dropped, dloc as usize) }
                            } else {
                                true
                            };
                            if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                               sc_local_is_unprojected_scalar(view(*body), unsafe { view((*inst).place) }) &&
                               !dst_dropped {

                                // Check move/drop safety (REQ-OPT-304..305): only Copy-safe non-dropped temporaries may elide moves
                                let has_move = sc_mir_stmt_has_move_operand(unsafe { view((*inst).orig_stmt) });
                                let mut move_ok = !has_move;
                                if has_move && opc == OPT_INST_COPY &&
                                   (unsafe { (*inst).orig_stmt.rvalue.kind }) == MIR_RVALUE_USE &&
                                   (unsafe { (*inst).orig_stmt.rvalue.use_op.kind }) == MIR_OP_MOVE &&
                                   (unsafe { (*inst).orig_stmt.rvalue.use_op.place.proj_count }) == 0 &&
                                   (unsafe { (*inst).orig_stmt.rvalue.use_op.place.drop_flag }) == MIR_DROP_FLAG_NONE &&
                                   scalar_type_is_copy_safe(body.thir, (TypeId { v: unsafe { (*inst).ty.v } })) {
                                    let sloc = (unsafe { (*inst).orig_stmt.rvalue.use_op.place.local.v }) as usize;
                                    let src_dropped: bool = if sloc < body.local_count && (body.local_dropped as usize) != 0 {
                                        unsafe { *opt_bool_at(body.local_dropped, sloc) }
                                    } else {
                                        true
                                    };
                                    if !src_dropped {
                                        move_ok = true;
                                    }
                                }

                                if move_ok {
                                    let res_v = unsafe { (*inst).result.v };
                                    let iid_v = unsafe { (*inst).id.v };
                                    let mut ssa_dead = true;
                                    if res_v != OPT_VALUE_NONE && (res_v as usize) <= body.value_count && (body.values as usize) != 0 {
                                        let vp = unsafe { opt_val_at(body.values, res_v as usize) };
                                        if (unsafe { (*vp).kind }) == OPT_VAL_INST && (unsafe { (*vp).def_inst.v }) == iid_v {
                                            if sc_count_value_uses_excluding_inst(view(*body), (OptValueId { v: res_v }), iid_v) != 0u32 {
                                                ssa_dead = false;
                                            }
                                        }
                                    }
                                    if ssa_dead &&
                                       (!sc_mir_local_read_or_dropped_anywhere(view(*body), b_rev, i_rev, dloc) ||
                                        sc_mir_local_overwritten_before_read_in_block(view(*pm), view(*body), unsafe { view(*bb) }, i_rev, dloc, max_steps)) {
                                        let eff = sc_effect_infer_inst_safe(view(*pm), view(*body), unsafe { view(*inst) }, max_steps);
                                        let cand = CandidateRewrite {
                                            pass_id: PASS_DCE,
                                            required_prop: PROP_PURE_CALL,
                                            proof_certainty: CERTAINTY_PROVEN,
                                            proof_source_analysis: ANALYSIS_EFFECT_INFO,
                                            proof_revision: pm.ir_revision,
                                            target_effect_flags: eff,
                                            src_view_kind: 0u8,
                                            dst_view_kind: 0u8,
                                            is_removing_inst: true,
                                            cost_delta: -2i32,
                                        };
                                        if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                            if opc == OPT_INST_COPY {
                                                stats.dce_move_copy_elided = stats.dce_move_copy_elided + 1u32;
                                            }
                                            unsafe { sc_wipe_inst_to_nop(inst); }
                                            stats.dce_insts_eliminated = stats.dce_insts_eliminated + 1u32;
                                            changed = true;
                                            round_changed = true;
                                        } else {
                                            stats.rejected_candidates = stats.rejected_candidates + 1u32;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 3. Clean up orphaned StorageLive / StorageDead markers for temporaries with zero remaining uses/defs
    if changed {
        let mut l: usize = body.arg_count + 1;
        while l < body.local_count {
            let l_dropped: bool = if (body.local_dropped as usize) != 0 {
                unsafe { *opt_bool_at(body.local_dropped, l) }
            } else {
                false
            };
            if !l_dropped && !sc_local_has_any_non_storage_stmt(view(*body), l as u32) {
                let mut sb: usize = 0;
                while sb < body.bb_count {
                    let sbb = unsafe { opt_block_at(body.blocks, sb) };
                    let sicnt = unsafe { (*sbb).inst_count };
                    let sinsts = unsafe { (*sbb).insts };
                    let mut si: usize = 0;
                    while si < sicnt {
                        let sinst = unsafe { opt_inst_at(sinsts, si) };
                        let sflg = unsafe { (*sinst).flags };
                        if (unsafe { (*sinst).opcode }) == OPT_INST_NOP &&
                           (sflg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 &&
                           (unsafe { (*sinst).orig_stmt.storage_local.v }) == (l as u32) {
                            unsafe { (*sinst).flags = 0u16; }
                        }
                        si = si + 1;
                    }
                    sb = sb + 1;
                }
            }
            l = l + 1;
        }
    }

    if dce_mem_changed && (body.mem_defs as usize) != 0 {
        optir_compute_dom_frontier(mut_view(*body), mut_view(*arena));
        optir_construct_memssa(mut_view(*body), mut_view(*arena));
    }

    changed
}

// ============================================================================
// Component E: CFG Dead-Edge Folding & Unreachable Block Pruning (PASS_CFG_SIMPLIFY)
// ============================================================================

pub fn scalar_run_cfg_simplify(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    stats: mut_view<ScalarOptStats>,
    arena: mut_view<Arena>
) -> bool {
    let mut changed = false;
    let mut cfg_changed = false;

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if (unsafe { (*bb).is_reachable }) && (unsafe { (*bb).has_term }) {
            let tk = unsafe { (*bb).term.kind };
            let cond_id = (OptValueId { v: unsafe { (*bb).term.cond.v } });

            if tk == OPT_TERM_BRANCH && !sc_mir_op_is_drop_move(view(*body), unsafe { view((*bb).term.orig_term.discr) }) {
                let t_bb = unsafe { (*bb).term.true_bb };
                let f_bb = unsafe { (*bb).term.false_bb };
                let mut cval: u64 = 0u64;
                if t_bb.v == f_bb.v && t_bb.v != OPT_BB_NONE {
                    let cand = CandidateRewrite {
                        pass_id: PASS_CFG_SIMPLIFY,
                        required_prop: PROP_REACHABLE,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_CFG,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        unsafe { sc_rewrite_term_to_goto(bb, t_bb); }
                        stats.cfg_edges_simplified = stats.cfg_edges_simplified + 1u32;
                        changed = true;
                        cfg_changed = true;
                    }
                } else if pm_value_is_const_int(view(*pm), view(*body), cond_id, mut_view(cval)) {
                    let cand = CandidateRewrite {
                        pass_id: PASS_CFG_SIMPLIFY,
                        required_prop: PROP_REACHABLE,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_CFG,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        let chosen: OptBbId = if cval != 0u64 { t_bb } else { f_bb };
                        unsafe { sc_rewrite_term_to_goto(bb, chosen); }
                        stats.cfg_edges_simplified = stats.cfg_edges_simplified + 1u32;
                        changed = true;
                        cfg_changed = true;
                    }
                }
            } else if tk == OPT_TERM_SWITCH_INT && !sc_mir_op_is_drop_move(view(*body), unsafe { view((*bb).term.orig_term.discr) }) {
                let swc = unsafe { (*bb).term.switch_count };
                let swv = unsafe { (*bb).term.switch_vals };
                let swt = unsafe { (*bb).term.switch_targets };
                let ow = unsafe { (*bb).term.otherwise_bb };
                let mut all_same = ow.v != OPT_BB_NONE;
                let mut k: usize = 0;
                while k < swc {
                    if (unsafe { (*opt_bbid_at(swt, k)).v }) != ow.v {
                        all_same = false;
                        break;
                    }
                    k = k + 1;
                }
                let mut cval: u64 = 0u64;
                if all_same {
                    let cand = CandidateRewrite {
                        pass_id: PASS_CFG_SIMPLIFY,
                        required_prop: PROP_REACHABLE,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_CFG,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        unsafe { sc_rewrite_term_to_goto(bb, ow); }
                        stats.cfg_edges_simplified = stats.cfg_edges_simplified + 1u32;
                        changed = true;
                        cfg_changed = true;
                    }
                } else if pm_value_is_const_int(view(*pm), view(*body), cond_id, mut_view(cval)) {
                    let cand = CandidateRewrite {
                        pass_id: PASS_CFG_SIMPLIFY,
                        required_prop: PROP_REACHABLE,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_CFG,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        let sw_bits = opt_type_bits(body.thir, (TypeId { v: unsafe { (*bb).term.switch_ty.v } }));
                        let masked_c: u64 = if sw_bits > 0u32 && sw_bits <= 64u32 { cval & opt_bit_mask(sw_bits) } else { cval };
                        let mut chosen = ow;
                        let mut m: usize = 0;
                        while m < swc {
                            if (unsafe { *opt_u64_at(swv, m) }) == masked_c {
                                chosen = unsafe { *opt_bbid_at(swt, m) };
                                break;
                            }
                            m = m + 1;
                        }
                        unsafe { sc_rewrite_term_to_goto(bb, chosen); }
                        stats.cfg_edges_simplified = stats.cfg_edges_simplified + 1u32;
                        changed = true;
                        cfg_changed = true;
                    }
                }
            } else if tk == OPT_TERM_ASSERT && !sc_mir_op_is_drop_move(view(*body), unsafe { view((*bb).term.orig_term.cond) }) {
                let mut acval: u64 = 0u64;
                if pm_value_is_const_int(view(*pm), view(*body), cond_id, mut_view(acval)) &&
                   ((acval != 0u64) == (unsafe { (*bb).term.assert_expected })) {
                    let cand = CandidateRewrite {
                        pass_id: PASS_CFG_SIMPLIFY,
                        required_prop: PROP_REACHABLE,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_CFG,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        let tgt = unsafe { (*bb).term.true_bb };
                        unsafe { sc_rewrite_term_to_goto(bb, tgt); }
                        stats.cfg_edges_simplified = stats.cfg_edges_simplified + 1u32;
                        changed = true;
                        cfg_changed = true;
                    }
                }
            }
        }
        b = b + 1;
    }

    if cfg_changed {
        let pruned = sc_prune_unreachable_and_rebuild_cfg_ssa(mut_view(*pm), mut_view(*body), mut_view(*arena));
        stats.cfg_edges_simplified = stats.cfg_edges_simplified + pruned;
        changed = true;
    }

    changed
}

// ============================================================================
// Unified Scalar Pass Runner, Fixed-Point Pipeline & MirBody Entry Point
// ============================================================================

pub fn scalar_run_pass(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    pass_id: u16,
    call_table: *const EffectCallTable,
    stats: mut_view<ScalarOptStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    if (pass_id as usize) >= PASS_COUNT {
        return false;
    }
    let facts = passmgr_collect_body_facts(view(*body));
    let mut should_sched = passmgr_should_schedule_pass(pass_id, view(pm.budget), view(facts));
    if !should_sched && pass_id == PASS_GVN_CSE &&
       pm.budget.profile != OPT_PROFILE_DEBUG_O0 &&
       pm.budget.profile != OPT_PROFILE_BALANCED_O1 &&
       facts.inst_count > 1u32 &&
       facts.inst_count <= pm.budget.max_ir_insts_per_fn {
        should_sched = true;
    }
    if !should_sched {
        let prev_sk = unsafe { *opt_u32_at(pm.pass_skip_counts, pass_id as usize) };
        unsafe { *opt_u32_at(pm.pass_skip_counts, pass_id as usize) = prev_sk + 1u32; }
        return false;
    }

    let contract = passmgr_contract_for_pass(pass_id);
    let mut req_analyses = contract.required_analyses;
    if pass_id == PASS_INST_COMBINE {
        // Dominator tree is used by sc_resolve_copy_source_for_val and sc_propagate_mir_copy_in_body
        req_analyses = req_analyses | analysis_bit(1u8);
    }
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), req_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_base_eff = pm.baseline_effect_summary;
    let pre_has_base = pm.has_baseline_effects;
    let pre_stats = *stats;

    let prev_run = unsafe { *opt_u32_at(pm.pass_run_counts, pass_id as usize) };
    unsafe { *opt_u32_at(pm.pass_run_counts, pass_id as usize) = prev_run + 1u32; }

    let mut changed = false;
    if pass_id == PASS_SCCP {
        changed = scalar_run_sccp(mut_view(*pm), mut_view(*body), call_table, mut_view(*stats), mut_view(*arena));
    } else if pass_id == PASS_INST_COMBINE {
        changed = scalar_run_inst_combine(mut_view(*pm), mut_view(*body), mut_view(*stats), mut_view(*arena));
    } else if pass_id == PASS_GVN_CSE {
        changed = scalar_run_gvn_cse(mut_view(*pm), mut_view(*body), call_table, mut_view(*stats), mut_view(*arena));
    } else if pass_id == PASS_DCE {
        changed = scalar_run_dce(mut_view(*pm), mut_view(*body), call_table, mut_view(*stats), mut_view(*arena));
    } else if pass_id == PASS_CFG_SIMPLIFY {
        changed = scalar_run_cfg_simplify(mut_view(*pm), mut_view(*body), mut_view(*stats), mut_view(*arena));
    } else if pass_id == PASS_SROA {
        changed = false;
    }

    if changed {
        let new_rev = pm.ir_revision + 1u32;
        pm.ir_revision = new_rev;
        let prev_ch = unsafe { *opt_u32_at(pm.pass_change_counts, pass_id as usize) };
        unsafe { *opt_u32_at(pm.pass_change_counts, pass_id as usize) = prev_ch + 1u32; }

        let non_preserved = ANALYSIS_MASK_ALL ^ (contract.preserved_analyses & ANALYSIS_MASK_ALL);
        passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses | non_preserved);
        if !passmgr_is_analysis_valid(view(*pm), ANALYSIS_RANGE_INFO) {
            body.ranges = 0 as *mut OptRange;
        }

        let mut a: u8 = 0u8;
        while (a as usize) < ANALYSIS_COUNT {
            let bit = analysis_bit(a);
            if (pm.valid_analyses & bit) != 0u32 && (contract.preserved_analyses & bit) != 0u32 {
                unsafe { *opt_u32_at(pm.analysis_revs, a as usize) = new_rev; }
            }
            a = a + 1u8;
        }
    }

    if pm.budget.verify_each {
        let vstatus = passmgr_verify_postconditions(mut_view(*pm), mut_view(*body), pass_id, mut_view(*arena), mut_view(*sink));
        if vstatus != CONTRACT_OK {
            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
            pm.ir_revision = pre_rev;
            pm.valid_analyses = pre_valid;
            pm.baseline_effect_summary = pre_base_eff;
            pm.has_baseline_effects = pre_has_base;
            *stats = pre_stats;
            let mut a2: usize = 0;
            while a2 < ANALYSIS_COUNT {
                if (pre_valid & (1u32 << (a2 as u32))) != 0u32 {
                    unsafe { *opt_u32_at(pm.analysis_revs, a2) = pre_rev; }
                }
                a2 = a2 + 1;
            }
            let prev_rb = unsafe { *opt_u32_at(pm.pass_rollback_counts, pass_id as usize) };
            unsafe { *opt_u32_at(pm.pass_rollback_counts, pass_id as usize) = prev_rb + 1u32; }
            return false;
        }
    }

    changed
}

pub fn scalar_run_pipeline(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    stats: mut_view<ScalarOptStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    passmgr_mark_all_valid_from_lowering(mut_view(*pm), mut_view(*body), mut_view(*arena));

    if pm.budget.profile == OPT_PROFILE_DEBUG_O0 || pm.budget.max_fixedpoint_rounds == 0u32 {
        if pm.budget.verify_each {
            let vst = passmgr_verify_postconditions(mut_view(*pm), mut_view(*body), PASS_LOWER_MIR, mut_view(*arena), mut_view(*sink));
            return vst == CONTRACT_OK;
        }
        return true;
    }

    let _ = scalar_run_pass(mut_view(*pm), mut_view(*body), PASS_SROA, call_table, mut_view(*stats), mut_view(*arena), mut_view(*sink));

    let max_rounds = pm.budget.max_fixedpoint_rounds;
    let mut round: u32 = 0u32;
    while round < max_rounds {
        round = round + 1u32;
        pm.fixedpoint_rounds_executed = round;
        let mut round_changed = false;

        if scalar_run_pass(mut_view(*pm), mut_view(*body), PASS_SCCP, call_table, mut_view(*stats), mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }
        if scalar_run_pass(mut_view(*pm), mut_view(*body), PASS_INST_COMBINE, call_table, mut_view(*stats), mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }
        if scalar_run_pass(mut_view(*pm), mut_view(*body), PASS_GVN_CSE, call_table, mut_view(*stats), mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }
        if scalar_run_pass(mut_view(*pm), mut_view(*body), PASS_DCE, call_table, mut_view(*stats), mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }
        if scalar_run_pass(mut_view(*pm), mut_view(*body), PASS_CFG_SIMPLIFY, call_table, mut_view(*stats), mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }

        if !round_changed {
            break;
        }
    }

    // Ensure CFG, Dominators, SSA, and MemorySSA are valid prior to MIR reconstruction
    let exit_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(1u8) | analysis_bit(2u8) | analysis_bit(ANALYSIS_MEMORY_SSA);
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), exit_mask);

    pm.last_verify_status == CONTRACT_OK
}

pub fn scalar_optimize_mir_body(
    mir_body: mut_view<MirBody>,
    thir: *const Thir,
    profile: u8,
    verify_each: bool,
    call_table: *const EffectCallTable,
    stats: mut_view<ScalarOptStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    fn_item: *const HirItem
) -> bool {
    scalar_stats_zero(mut_view(*stats));
    let prev_errs = sink.errors;

    // AXS-OPT-001 Entry Gate: lower only Verified MIR
    let obody = optir_build_from_mir(view(*mir_body), thir, mut_view(*arena), mut_view(*sink), fn_item);
    if (obody as usize) == 0 || sink.errors != prev_errs {
        return false;
    }

    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, verify_each);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget, mut_view(*arena));

    if !scalar_run_pipeline(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        call_table,
        mut_view(*stats),
        mut_view(*arena),
        mut_view(*sink)
    ) {
        return false;
    }

    // Reconstruct into a fresh MirBody first because optir_reconstruct_mir resets out_mir before reading orig_mir
    let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*obody) }, unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
        return false;
    }

    verify_mir(unsafe { view(*rec_mir) }, thir, mut_view(*sink), fn_item);
    if sink.errors != prev_errs {
        return false;
    }

    unsafe {
        mir_body.sym = (SymbolId { v: (*rec_mir).sym.v });
        mir_body.fn_sym = (SymbolId { v: (*rec_mir).fn_sym.v });
        mir_body.fn_name = (*rec_mir).fn_name;
        mir_body.span = (*rec_mir).span;
        mir_body.locals = (*rec_mir).locals;
        mir_body.local_count = (*rec_mir).local_count;
        mir_body.local_cap = (*rec_mir).local_cap;
        mir_body.arg_count = (*rec_mir).arg_count;
        mir_body.bbs = (*rec_mir).bbs;
        mir_body.bb_count = (*rec_mir).bb_count;
        mir_body.bb_cap = (*rec_mir).bb_cap;
        mir_body.drop_flag_count = (*rec_mir).drop_flag_count;
    }
    true
}
