// --- Pass Identifier & TransformationContract (SPEC-71 AXS-ESC-016) ---

pub const PASS_ALIAS_MEM: u16 = 9u16;

pub fn memopt_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_ALIAS_MEM,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                           ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO |
                           ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_RANGE_INFO,
        required_proofs: PROP_MASK_NO_ALIAS | PROP_MASK_DEAD_STORE,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA,
        invalidated_analyses: ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_ALL,
        postconditions: POSTCOND_ALL,
    }
}

// --- Memory Access Kind Classification (SPEC-71 AXS-ALIAS-006.1, REQ-OPT-365) ---

pub const MEM_ACCESS_NONE: u8 = 0u8;
pub const MEM_ACCESS_LOAD: u8 = 1u8;
pub const MEM_ACCESS_STORE: u8 = 2u8;
pub const MEM_ACCESS_ATOMIC_LOAD: u8 = 3u8;
pub const MEM_ACCESS_ATOMIC_STORE: u8 = 4u8;
