const MEMOPT_STR_OFF: [25]u32 = [
    0u32, 13u32, 15u32, 26u32, 38u32, 44u32, 50u32, 58u32, 59u32, 67u32,
    75u32, 76u32, 80u32, 101u32, 120u32, 135u32, 152u32, 168u32, 176u32, 182u32,
    191u32, 194u32, 206u32, 210u32, 219u32,
];

fn mo_push_tok(out: mut_view<DiagBuffer>, tok: usize) {
    let start = MEMOPT_STR_OFF[tok] as usize;
    let end = MEMOPT_STR_OFF[tok + 1] as usize;
    let mut i: usize = start;
    while i < end {
        diag_buf_push_byte(mut_view(*out), MEMOPT_STR_DATA[i]);
        i = i + 1;
    }
}

pub fn memopt_print(out: mut_view<DiagBuffer>, log: view<MemOptLog>) {
    mo_push_tok(mut_view(*out), 0); // "memopt_log {\n"
    let mut i: usize = 0;
    while i < log.count && (log.records as usize) != 0 {
        let rec = unsafe { memopt_record_at(log.records, i) };
        let is_bar = unsafe { (*rec).is_barrier };
        let code = (unsafe { (*rec).code }) as usize;
        if is_bar {
            mo_push_tok(mut_view(*out), 3); // "    barrier "
            let b_tok: usize = if code >= 1 && code <= 7 { 16 + code } else { 11 };
            mo_push_tok(mut_view(*out), b_tok);
        } else {
            mo_push_tok(mut_view(*out), 2); // "    action "
            let a_tok: usize = if code >= 1 && code <= 5 { 11 + code } else { 11 };
            mo_push_tok(mut_view(*out), a_tok);
        }
        mo_push_tok(mut_view(*out), 4); // " bb=bb"
        diag_buf_push_u32(mut_view(*out), unsafe { (*rec).bb_idx });
        mo_push_tok(mut_view(*out), 5); // " inst="
        diag_buf_push_u32(mut_view(*out), unsafe { (*rec).inst_idx });
        if !is_bar {
            mo_push_tok(mut_view(*out), 6); // " from=bb"
            diag_buf_push_u32(mut_view(*out), unsafe { (*rec).src_bb_idx });
            mo_push_tok(mut_view(*out), 7); // ":"
            diag_buf_push_u32(mut_view(*out), unsafe { (*rec).src_inst_idx });
        }
        mo_push_tok(mut_view(*out), 8); // " local=_"
        diag_buf_push_u32(mut_view(*out), unsafe { (*rec).local_id });
        mo_push_tok(mut_view(*out), 9); // " reason="
        diag_buf_push_u32(mut_view(*out), (unsafe { (*rec).reason }) as u32);
        mo_push_tok(mut_view(*out), 10); // "\n"
        i = i + 1;
    }
    mo_push_tok(mut_view(*out), 1); // "}\n"
}
