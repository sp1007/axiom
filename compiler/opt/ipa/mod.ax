// --- Pass Identifiers & TransformationContracts (`SPEC-73 §8, AXS-INL-034`) ---

pub const PASS_IPA_SPECIALIZE: u16 = 15u16;
pub const PASS_TAILCALL: u16 = 17u16;

pub fn ipa_specialize_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_IPA_SPECIALIZE,
        required_analyses: ANALYSIS_MASK_CALL_GRAPH | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO |
                           ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_ALIAS_INFO,
        required_proofs: PROP_MASK_REACHABLE | PROP_MASK_PURE_CALL | PROP_MASK_NO_ESCAPE | PROP_MASK_NO_ALIAS,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA,
        invalidated_analyses: ANALYSIS_MASK_CALL_GRAPH | ANALYSIS_MASK_EFFECT_INFO |
                              ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_REACHABLE | PROP_MASK_NO_ALIAS | PROP_MASK_NO_ESCAPE | PROP_MASK_PURE_CALL,
        postconditions: POSTCOND_ALL,
    }
}

pub fn tailcall_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_TAILCALL,
        required_analyses: ANALYSIS_MASK_CALL_GRAPH | ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS |
                           ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ESCAPE_INFO,
        required_proofs: PROP_MASK_REACHABLE | PROP_MASK_NO_ESCAPE,
        preserved_analyses: ANALYSIS_MASK_NONE,
        invalidated_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                              ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_LOOP_INFO,
        preserved_properties: PROP_MASK_REACHABLE | PROP_MASK_NO_ESCAPE,
        postconditions: POSTCOND_ALL,
    }
}

