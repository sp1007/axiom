    pub benefit_score: i32,
    pub reason: u8,
    pub decision: u8,
}

pub struct SpecDecisionLog {
    pub records: *mut SpecDecisionRecord,
    pub count: usize,
    pub cap: usize,
}

@derive(Copy)
pub struct IpaSpecStats {
