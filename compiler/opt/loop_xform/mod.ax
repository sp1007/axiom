pub fn loop_cost_budget_for_profile(profile: u8) -> LoopCostBudget {
    if profile == OPT_PROFILE_DEBUG_O0 {
        return LoopCostBudget {
            allow_licm: false,
            allow_iv_sr: false,
            allow_peeling: false,
            allow_unswitching: false,
            allow_full_unroll: false,
            allow_partial_unroll: false,
            allow_versioning: false,
            allow_fusion: false,
            max_full_unroll_trip: 0u64,
            max_full_unroll_insts: 0u32,
            max_partial_unroll_factor: 0u32,
            max_unswitch_block_count: 0u32,
            max_version_block_count: 0u32,
        };
    }
    if profile == OPT_PROFILE_SIZE_OS {
        return LoopCostBudget {
            allow_licm: true,
            allow_iv_sr: true,
            allow_peeling: false,
            allow_unswitching: false,
            allow_full_unroll: false,
            allow_partial_unroll: false,
            allow_versioning: false,
            allow_fusion: true,
            max_full_unroll_trip: 0u64,
            max_full_unroll_insts: 0u32,
            max_partial_unroll_factor: 0u32,
            max_unswitch_block_count: 0u32,
            max_version_block_count: 0u32,
        };
    }
    if profile == OPT_PROFILE_BALANCED_O1 {
        return LoopCostBudget {
            allow_licm: true,
            allow_iv_sr: true,
            allow_peeling: true,
            allow_unswitching: true,
            allow_full_unroll: true,
            allow_partial_unroll: false,
            allow_versioning: false,
            allow_fusion: true,
            max_full_unroll_trip: 8u64,
            max_full_unroll_insts: 32u32,
            max_partial_unroll_factor: 0u32,
            max_unswitch_block_count: 4u32,
            max_version_block_count: 0u32,
        };
    }
    LoopCostBudget {
        allow_licm: true,
        allow_iv_sr: true,
        allow_peeling: true,
        allow_unswitching: true,
        allow_full_unroll: true,
        allow_partial_unroll: true,
        allow_versioning: true,
        allow_fusion: true,
        max_full_unroll_trip: 16u64,
        max_full_unroll_insts: 64u32,
        max_partial_unroll_factor: 2u32,
        max_unswitch_block_count: 8u32,
        max_version_block_count: 8u32,
    }
}

pub fn loop_xform_stats_zero(stats: mut_view<LoopXformStats>) {
    stats.pass_runs = 0u32;
    stats.pass_changes = 0u32;
    stats.pass_rollbacks = 0u32;
    stats.licm_hoisted_scalars = 0u32;
    stats.licm_hoisted_loads = 0u32;
    stats.licm_hoisted_guards = 0u32;
    stats.licm_blocked_traps = 0u32;
    stats.licm_blocked_clobbers = 0u32;
    stats.licm_blocked_barriers = 0u32;
    stats.iv_strength_reduced = 0u32;
    stats.iv_addr_evolutions = 0u32;
    stats.iv_blocked_overflow = 0u32;
    stats.loops_peeled = 0u32;
    stats.loops_unswitched = 0u32;
    stats.loops_unrolled_full = 0u32;
    stats.loops_unrolled_partial = 0u32;
    stats.loops_versioned = 0u32;
    stats.loops_fused = 0u32;
    stats.iter_buffers_forwarded = 0u32;
    stats.fusion_blocked_dep = 0u32;
    stats.fusion_blocked_barriers = 0u32;
    stats.bce_eliminated_after_xform = 0u32;
    stats.records = 0 as *mut LoopXformRecord;
    stats.record_count = 0;
    stats.record_cap = 0;
}

pub unsafe fn loop_xform_record_at(base: *mut LoopXformRecord, idx: usize) -> *mut LoopXformRecord {
    let byte_off = idx * size_of<LoopXformRecord>();
    ((base as usize) + byte_off) as *mut LoopXformRecord
}


// --- Internal Allocation, Snapshot, MIR Extraction, & Resync Helpers ---

fn lxf_mul_usize(a: usize, b: usize) -> usize {
    let mut res: usize = 0;
    let mut i: usize = 0;
    while i < b {
        res = res + a;
        i = i + 1;
    }
    res
}

pub fn lxf_push_record(
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    pass_id: u16,
    kind: u8,
    applied: bool,
    certainty: u8,
    loop_id: LoopId,
    bb: OptBbId,
    inst_idx: u32,
    primary_val: OptValueId,
    secondary_val: OptValueId,
    factor_or_trip: u64,
    reason: u8
) {
    if stats.record_count >= stats.record_cap {
        let new_cap: usize = if stats.record_cap == 0 { 16 } else { stats.record_cap + stats.record_cap };
        let new_bytes = lxf_mul_usize(new_cap, size_of<LoopXformRecord>());
        let new_arr = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<LoopXformRecord>()) as *mut LoopXformRecord;
        if stats.record_count > 0 && (stats.records as usize) != 0 {
            let old_bytes = lxf_mul_usize(stats.record_count, size_of<LoopXformRecord>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(stats.records as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        stats.records = new_arr;
        stats.record_cap = new_cap;
    }
    let idx = stats.record_count;
    stats.record_count = idx + 1;
    unsafe {
        *loop_xform_record_at(stats.records, idx) = LoopXformRecord {
            pass_id: pass_id,
            kind: kind,
            applied: applied,
            certainty: certainty,
            loop_id: loop_id,
            bb: bb,
            inst_idx: inst_idx,
            primary_val: primary_val,
            secondary_val: secondary_val,
            factor_or_trip: factor_or_trip,
            reason: reason,
        };
    }
}

struct LxfExtraSnapshot {
    blocks_ptr: *mut OptBlock,
    bb_count: usize,
    values_ptr: *mut OptValue,
    value_cap: usize,
    rpo_ptr: *mut OptBbId,
    rpo_count: usize,
    mem_defs_ptr: *mut u8,
    mem_ssa_cap: usize,
    prov_ptr: *mut ProofProvenance,
    prov_cap: usize,
    local_tys_ptr: *mut TypeId,
    local_modes_ptr: *mut u8,
    local_addr_ptr: *mut bool,
    local_dropped_ptr: *mut bool,
    local_sroa_base_ptr: *mut u32,
    local_sroa_count_ptr: *mut u32,
    slot_local_ptr: *mut u32,
    slot_field_ptr: *mut u32,
    slot_ty_ptr: *mut TypeId,
    local_count: usize,
    slot_count: usize,
    orig_mir_ptr: *const MirBody,
    orig_mir_local_count: usize,
}

fn lxf_save_extra_snap(body: view<OptBody>) -> LxfExtraSnapshot {
    let orig_lc: usize = if (body.orig_mir as usize) != 0 {
        unsafe { (*body.orig_mir).local_count }
    } else {
        0
    };
    LxfExtraSnapshot {
        blocks_ptr: body.blocks,
        bb_count: body.bb_count,
        values_ptr: body.values,
        value_cap: body.value_cap,
        rpo_ptr: body.rpo_order,
        rpo_count: body.rpo_count,
        mem_defs_ptr: body.mem_defs as *mut u8,
        mem_ssa_cap: body.mem_ssa_cap,
        prov_ptr: body.provenance,
        prov_cap: body.provenance_cap,
        local_tys_ptr: body.local_tys,
        local_modes_ptr: body.local_modes,
        local_addr_ptr: body.local_addr_taken,
        local_dropped_ptr: body.local_dropped,
        local_sroa_base_ptr: body.local_sroa_base,
        local_sroa_count_ptr: body.local_sroa_count,
        slot_local_ptr: body.slot_local,
        slot_field_ptr: body.slot_field,
        slot_ty_ptr: body.slot_ty,
        local_count: body.local_count,
        slot_count: body.slot_count,
        orig_mir_ptr: body.orig_mir,
        orig_mir_local_count: orig_lc,
    }
}

fn lxf_restore_extra_snap(body: mut_view<OptBody>, ex: view<LxfExtraSnapshot>) {
    body.blocks = ex.blocks_ptr;
    body.bb_count = ex.bb_count;
    body.values = ex.values_ptr;
    body.value_cap = ex.value_cap;
    body.rpo_order = ex.rpo_ptr;
    body.rpo_count = ex.rpo_count;
    body.mem_defs = ex.mem_defs_ptr as *mut MemSsaDefNode;
    body.mem_ssa_cap = ex.mem_ssa_cap;
    body.provenance = ex.prov_ptr;
    body.provenance_cap = ex.prov_cap;
    body.local_tys = ex.local_tys_ptr;
    body.local_modes = ex.local_modes_ptr;
    body.local_addr_taken = ex.local_addr_ptr;
    body.local_dropped = ex.local_dropped_ptr;
    body.local_sroa_base = ex.local_sroa_base_ptr;
    body.local_sroa_count = ex.local_sroa_count_ptr;
    body.slot_local = ex.slot_local_ptr;
    body.slot_field = ex.slot_field_ptr;
    body.slot_ty = ex.slot_ty_ptr;
    body.local_count = ex.local_count;
    body.slot_count = ex.slot_count;
    body.orig_mir = ex.orig_mir_ptr;
    if (body.orig_mir as usize) != 0 {
        let mut_orig = body.orig_mir as *mut MirBody;
        unsafe { (*mut_orig).local_count = ex.orig_mir_local_count; }
    }
}

fn lxf_add_fresh_local(body: mut_view<OptBody>, arena: mut_view<Arena>, ty: TypeId) -> MirLocalId {
    let old_cnt = body.local_count;
    let new_cnt = old_cnt + 1;
    let new_tys = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(new_cnt, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let new_modes = arena_alloc_raw(mut_view(*arena), new_cnt, 1) as *mut u8;
    let new_addr = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(new_cnt, size_of<bool>()), align_of<bool>()) as *mut bool;
    let new_drop = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(new_cnt, size_of<bool>()), align_of<bool>()) as *mut bool;
    let new_sbase = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(new_cnt, size_of<u32>()), align_of<u32>()) as *mut u32;
    let new_scnt = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(new_cnt, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut l: usize = 0;
    while l < old_cnt {
        unsafe {
            *opt_typeid_at(new_tys, l) = if (body.local_tys as usize) != 0 { *opt_typeid_at(body.local_tys, l) } else { TypeId { v: 0u32 } };
            *opt_u8_at(new_modes, l) = if (body.local_modes as usize) != 0 { *opt_u8_at(body.local_modes, l) } else { OPT_LOCAL_SCALAR };
            *opt_bool_at(new_addr, l) = if (body.local_addr_taken as usize) != 0 { *opt_bool_at(body.local_addr_taken, l) } else { false };
            *opt_bool_at(new_drop, l) = if (body.local_dropped as usize) != 0 { *opt_bool_at(body.local_dropped, l) } else { false };
            *opt_u32_at(new_sbase, l) = if (body.local_sroa_base as usize) != 0 { *opt_u32_at(body.local_sroa_base, l) } else { OPT_PROJ_NONE };
            *opt_u32_at(new_scnt, l) = if (body.local_sroa_count as usize) != 0 { *opt_u32_at(body.local_sroa_count, l) } else { 0u32 };
        }
        l = l + 1;
    }
    let ty_v = ty.v;
    unsafe {
        *opt_typeid_at(new_tys, old_cnt) = TypeId { v: ty_v };
        *opt_u8_at(new_modes, old_cnt) = OPT_LOCAL_SCALAR;
        *opt_bool_at(new_addr, old_cnt) = false;
        *opt_bool_at(new_drop, old_cnt) = false;
        *opt_u32_at(new_sbase, old_cnt) = OPT_PROJ_NONE;
        *opt_u32_at(new_scnt, old_cnt) = 0u32;
    }
    body.local_tys = new_tys;
    body.local_modes = new_modes;
    body.local_addr_taken = new_addr;
    body.local_dropped = new_drop;
    body.local_sroa_base = new_sbase;
    body.local_sroa_count = new_scnt;
    body.local_count = new_cnt;

    let old_sc = body.slot_count;
    let new_sc = old_sc + 1;
    let new_sloc = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(new_sc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let new_sfld = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(new_sc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let new_sty = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(new_sc, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let mut s: usize = 0;
    while s < old_sc {
        unsafe {
            *opt_u32_at(new_sloc, s) = if (body.slot_local as usize) != 0 { *opt_u32_at(body.slot_local, s) } else { s as u32 };
            *opt_u32_at(new_sfld, s) = if (body.slot_field as usize) != 0 { *opt_u32_at(body.slot_field, s) } else { OPT_PROJ_NONE };
            *opt_typeid_at(new_sty, s) = if (body.slot_ty as usize) != 0 { *opt_typeid_at(body.slot_ty, s) } else { TypeId { v: 0u32 } };
        }
        s = s + 1;
    }
    unsafe {
        *opt_u32_at(new_sloc, old_sc) = old_cnt as u32;
        *opt_u32_at(new_sfld, old_sc) = OPT_PROJ_NONE;
        *opt_typeid_at(new_sty, old_sc) = TypeId { v: ty_v };
    }
    body.slot_local = new_sloc;
    body.slot_field = new_sfld;
    body.slot_ty = new_sty;
    body.slot_count = new_sc;

    if (body.orig_mir as usize) != 0 {
        let mut_orig = body.orig_mir as *mut MirBody;
        if (unsafe { (*mut_orig).local_count }) == old_cnt {
            let _ = mir_add_local(
                unsafe { mut_view(*mut_orig) },
                mut_view(*arena),
                TypeId { v: ty_v },
                0u8,
                true,
                StrId { v: 0u32 },
                view(body.span)
            );
        }
    }
    MirLocalId { v: old_cnt as u32 }
}

fn lxf_copy_stats(dst: mut_view<LoopXformStats>, src: view<LoopXformStats>) {
    dst.pass_runs = src.pass_runs;
    dst.pass_changes = src.pass_changes;
    dst.pass_rollbacks = src.pass_rollbacks;
    dst.licm_hoisted_scalars = src.licm_hoisted_scalars;
    dst.licm_hoisted_loads = src.licm_hoisted_loads;
    dst.licm_hoisted_guards = src.licm_hoisted_guards;
    dst.licm_blocked_traps = src.licm_blocked_traps;
    dst.licm_blocked_clobbers = src.licm_blocked_clobbers;
    dst.licm_blocked_barriers = src.licm_blocked_barriers;
    dst.iv_strength_reduced = src.iv_strength_reduced;
    dst.iv_addr_evolutions = src.iv_addr_evolutions;
    dst.iv_blocked_overflow = src.iv_blocked_overflow;
    dst.loops_peeled = src.loops_peeled;
    dst.loops_unswitched = src.loops_unswitched;
    dst.loops_unrolled_full = src.loops_unrolled_full;
    dst.loops_unrolled_partial = src.loops_unrolled_partial;
    dst.loops_versioned = src.loops_versioned;
    dst.loops_fused = src.loops_fused;
    dst.iter_buffers_forwarded = src.iter_buffers_forwarded;
    dst.fusion_blocked_dep = src.fusion_blocked_dep;
    dst.fusion_blocked_barriers = src.fusion_blocked_barriers;
    dst.bce_eliminated_after_xform = src.bce_eliminated_after_xform;
    dst.records = src.records;
    dst.record_count = src.record_count;
    dst.record_cap = src.record_cap;
}

fn lxf_append_goto_block(body: mut_view<OptBody>, arena: mut_view<Arena>, target: OptBbId, loc_span: view<Span>) -> OptBbId {
    let target_v = target.v;
    let old_cnt = body.bb_count;
    let new_cnt = old_cnt + 1;
    let new_blocks = arena_alloc_raw(
        mut_view(*arena),
        lxf_mul_usize(new_cnt, size_of<OptBlock>()),
        align_of<OptBlock>()
    ) as *mut OptBlock;
    if old_cnt > 0 && (body.blocks as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(
                body.blocks as *const u8,
                new_blocks as *mut u8,
                lxf_mul_usize(old_cnt, size_of<OptBlock>())
            );
        }
    }
    body.blocks = new_blocks;
    body.bb_count = new_cnt;

    let new_id_v = old_cnt as u32;
    let nbb = unsafe { opt_block_at(body.blocks, old_cnt) };
    let mut loc = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    mir_span_copy(mut_view(loc), loc_span);

    unsafe {
        (*nbb).id = OptBbId { v: new_id_v };
        (*nbb).is_cleanup = false;
        (*nbb).is_reachable = true;
        (*nbb).preds = 0 as *mut OptBbId;
        (*nbb).pred_count = 0;
        (*nbb).succs = 0 as *mut OptBbId;
        (*nbb).succ_count = 0;
        (*nbb).phis = 0 as *mut OptPhi;
        (*nbb).phi_count = 0;
        (*nbb).phi_cap = 0;
        (*nbb).has_mem_phi = false;
        (*nbb).mem_phi_result = MemSsaId { v: MEM_SSA_NONE };
        (*nbb).mem_phi_inputs = 0 as *mut MemSsaId;
        (*nbb).mem_in = MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY };
        (*nbb).mem_out = MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY };
        (*nbb).insts = 0 as *mut OptInst;
        (*nbb).inst_count = 0;
        (*nbb).inst_cap = 0;
        (*nbb).has_term = true;
        (*nbb).idom = OptBbId { v: OPT_BB_NONE };
        (*nbb).dom_depth = 0u32;
        (*nbb).rpo_idx = new_id_v;
        (*nbb).dom_frontier = 0 as *mut OptBbId;
        (*nbb).dom_frontier_count = 0;

        mir_term_reset(mut_view((*nbb).term.orig_term), MIR_TERM_GOTO, view(loc));
        (*nbb).term.orig_term.goto_target = MirBbId { v: target_v };
        (*nbb).term.kind = OPT_TERM_GOTO;
        (*nbb).term.cond = OptValueId { v: OPT_VALUE_NONE };
        (*nbb).term.true_bb = OptBbId { v: target_v };
        (*nbb).term.false_bb = OptBbId { v: OPT_BB_NONE };
        (*nbb).term.switch_ty = TypeId { v: 0u32 };
        (*nbb).term.switch_vals = 0 as *mut u64;
        (*nbb).term.switch_targets = 0 as *mut OptBbId;
        (*nbb).term.switch_count = 0;
        (*nbb).term.otherwise_bb = OptBbId { v: OPT_BB_NONE };
        (*nbb).term.callee = OptValueId { v: OPT_VALUE_NONE };
        (*nbb).term.call_args = 0 as *mut OptValueId;
        (*nbb).term.call_arg_count = 0;
        (*nbb).term.call_result = OptValueId { v: OPT_VALUE_NONE };
        (*nbb).term.call_dest = mir_local_place(0u32);
        (*nbb).term.has_call_dest = false;
        (*nbb).term.unwind_bb = OptBbId { v: OPT_BB_NONE };
        (*nbb).term.drop_place = mir_local_place(0u32);
        (*nbb).term.drop_flag = MIR_DROP_FLAG_NONE;
        (*nbb).term.drop_is_explicit = false;
        (*nbb).term.assert_expected = true;
        (*nbb).term.assert_msg_ptr = 0 as *const u8;
        (*nbb).term.assert_msg_len = 0;
        (*nbb).term.mem_use = MemSsaId { v: MEM_SSA_NONE };
        (*nbb).term.mem_def = MemSsaId { v: MEM_SSA_NONE };
        (*nbb).term.origin = OptOrigin {
            span: loc,
            mir_bb: MirBbId { v: new_id_v },
            mir_stmt_idx: 0u32,
            pass_id: PASS_LICM,
        };
    }
    OptBbId { v: new_id_v }
}

fn lxf_push_inst_to_block(bb: mut_view<OptBlock>, arena: mut_view<Arena>, inst: OptInst) {
    if bb.inst_count >= bb.inst_cap {
        let new_cap: usize = if bb.inst_cap == 0 { 8 } else { bb.inst_cap + bb.inst_cap };
        let new_bytes = lxf_mul_usize(new_cap, size_of<OptInst>());
        let new_arr = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<OptInst>()) as *mut OptInst;
        if bb.inst_count > 0 && (bb.insts as usize) != 0 {
            let old_bytes = lxf_mul_usize(bb.inst_count, size_of<OptInst>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(bb.insts as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        bb.insts = new_arr;
        bb.inst_cap = new_cap;
    }
    let idx = bb.inst_count;
    bb.inst_count = idx + 1;
    let dst = unsafe { opt_inst_at(bb.insts, idx) };
    unsafe {
        *dst = inst;
        (*dst).id = OptInstId { v: idx as u32 };
    }
}

fn lxf_clone_inst(src: view<OptInst>, arena: mut_view<Arena>, pass_id: u16) -> OptInst {
    let mut res = *src;
    res.origin.pass_id = pass_id;
    mir_copy_place(mut_view(res.place), view(src.place));
    mir_copy_place(mut_view(res.rhs_place), view(src.rhs_place));
    mir_copy_stmt(mut_view(res.orig_stmt), view(src.orig_stmt));
    if src.extra_arg_count > 0 && (src.extra_args as usize) != 0 {
        let ebytes = lxf_mul_usize(src.extra_arg_count, size_of<OptValueId>());
        let earr = arena_alloc_raw(mut_view(*arena), ebytes, align_of<OptValueId>()) as *mut OptValueId;
        unsafe {
            ptr_copy_nonoverlapping<u8>(src.extra_args as *const u8, earr as *mut u8, ebytes);
        }
        res.extra_args = earr;
    }
    res
}

fn lxf_make_const_int_inst(
    dest_local: MirLocalId,
    ty: TypeId,
    val_u64: u64,
    span: view<Span>,
    pass_id: u16
) -> OptInst {
    let dest_v = dest_local.v;
    let ty_v = ty.v;
    let sp1 = Span { file: FileId { v: span.file.v }, start: span.start, end: span.end };
    let sp2 = Span { file: FileId { v: span.file.v }, start: span.start, end: span.end };
    let sp3 = Span { file: FileId { v: span.file.v }, start: span.start, end: span.end };
    let mut stmt = MirStmt {
        kind: MIR_STMT_ASSIGN,
        span: sp1,
        location: sp2,
        place: mir_local_place(dest_v),
        rvalue: MirRvalue {
            kind: MIR_RVALUE_USE,
            use_op: mir_op_const_int(ty_v, val_u64),
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: 0u8,
            place: mir_local_place(0u32),
            cast_kind: 0u8,
            target_ty: TypeId { v: ty_v },
            bin_op: 0u8,
            lhs: mir_op_const_int(ty_v, 0u64),
            rhs: mir_op_const_int(ty_v, 0u64),
            un_op: 0u8,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        },
        storage_local: MirLocalId { v: 0u32 },
    };
    mir_stmt_reset(mut_view(stmt), MIR_STMT_ASSIGN, span);
    stmt.place = mir_local_place(dest_v);
    mir_rvalue_reset(mut_view(stmt.rvalue), MIR_RVALUE_USE);
    stmt.rvalue.use_op = mir_op_const_int(ty_v, val_u64);

    OptInst {
        id: OptInstId { v: 0u32 },
        opcode: OPT_INST_CONST,
        sub_op: 0u8,
        flags: OPT_FLAG_NONE,
        result: OptValueId { v: OPT_VALUE_NONE },
        ty: TypeId { v: ty_v },
        lhs: OptValueId { v: OPT_VALUE_NONE },
        rhs: OptValueId { v: OPT_VALUE_NONE },
        extra_args: 0 as *mut OptValueId,
        extra_arg_count: 0,
        place: mir_local_place(dest_v),
        rhs_place: mir_local_place(0u32),
        mem_use: MemSsaId { v: MEM_SSA_NONE },
        mem_def: MemSsaId { v: MEM_SSA_NONE },
        origin: OptOrigin {
            span: sp3,
            mir_bb: MirBbId { v: 0u32 },
            mir_stmt_idx: 0u32,
            pass_id: pass_id,
        },
        orig_stmt: stmt,
    }
}

fn lxf_make_copy_inst(
    dest_local: MirLocalId,
    src_local: MirLocalId,
    ty: TypeId,
    span: view<Span>,
    pass_id: u16
) -> OptInst {
    let src_v = src_local.v;
    let mut inst = lxf_make_const_int_inst(dest_local, ty, 0u64, span, pass_id);
    inst.opcode = OPT_INST_COPY;
    inst.rhs_place = mir_local_place(src_v);
    mir_rvalue_reset(mut_view(inst.orig_stmt.rvalue), MIR_RVALUE_USE);
    inst.orig_stmt.rvalue.use_op = mir_op_copy_local(src_v);
    inst
}

fn lxf_make_binop_inst(
    dest_local: MirLocalId,
    ty: TypeId,
    bin_op: u8,
    is_wrapping: bool,
    lhs_op: view<MirOperand>,
    rhs_op: view<MirOperand>,
    span: view<Span>,
    arena: mut_view<Arena>,
    pass_id: u16
) -> OptInst {
    let _ = arena;
    let mut inst = lxf_make_const_int_inst(dest_local, ty, 0u64, span, pass_id);
    inst.opcode = if is_wrapping { OPT_INST_WRAPPING_BINOP } else { OPT_INST_BINOP };
    inst.sub_op = bin_op;
    mir_rvalue_reset(mut_view(inst.orig_stmt.rvalue), MIR_RVALUE_BINARY_OP);
    inst.orig_stmt.rvalue.bin_op = bin_op;
    mir_copy_operand(mut_view(inst.orig_stmt.rvalue.lhs), lhs_op);
    mir_copy_operand(mut_view(inst.orig_stmt.rvalue.rhs), rhs_op);
    inst
}

fn lxf_redirect_edge_in_block(
    bb: mut_view<OptBlock>,
    arena: mut_view<Arena>,
    old_target: OptBbId,
    new_target: OptBbId
) -> bool {
    if !bb.has_term {
        return false;
    }
    let old_v = old_target.v;
    let new_v = new_target.v;
    let mut changed = false;
    let tk = bb.term.kind;
    if tk == OPT_TERM_GOTO {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = OptBbId { v: new_v };
            bb.term.orig_term.goto_target = MirBbId { v: new_v };
            changed = true;
        }
    } else if tk == OPT_TERM_BRANCH {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = OptBbId { v: new_v };
            changed = true;
        }
        if bb.term.false_bb.v == old_v {
            bb.term.false_bb = OptBbId { v: new_v };
            changed = true;
        }
        if bb.term.orig_term.kind == MIR_TERM_SWITCH_INT {
            if bb.term.orig_term.otherwise.v == old_v {
                bb.term.orig_term.otherwise = MirBbId { v: new_v };
            }
            if bb.term.orig_term.switch_count > 0 && (bb.term.orig_term.targets as usize) != 0 {
                let n = bb.term.orig_term.switch_count;
                let nbytes = lxf_mul_usize(n, size_of<MirBbId>());
                let narr = arena_alloc_raw(mut_view(*arena), nbytes, align_of<MirBbId>()) as *mut MirBbId;
                let mut i: usize = 0;
                while i < n {
                    let cur_v = unsafe { (*mir_bb_id_at(bb.term.orig_term.targets, i)).v };
                    unsafe {
                        *mir_bb_id_at(narr, i) = MirBbId { v: if cur_v == old_v { new_v } else { cur_v } };
                    }
                    i = i + 1;
                }
                bb.term.orig_term.targets = narr;
            }
        }
    } else if tk == OPT_TERM_SWITCH_INT {
        if bb.term.otherwise_bb.v == old_v {
            bb.term.otherwise_bb = OptBbId { v: new_v };
            bb.term.orig_term.otherwise = MirBbId { v: new_v };
            changed = true;
        }
        if bb.term.switch_count > 0 && (bb.term.switch_targets as usize) != 0 {
            let n = bb.term.switch_count;
            let obytes = lxf_mul_usize(n, size_of<OptBbId>());
            let oarr = arena_alloc_raw(mut_view(*arena), obytes, align_of<OptBbId>()) as *mut OptBbId;
            let mut i: usize = 0;
            while i < n {
                let cur_v = unsafe { (*opt_bbid_at(bb.term.switch_targets, i)).v };
                if cur_v == old_v {
                    unsafe { *opt_bbid_at(oarr, i) = OptBbId { v: new_v }; }
                    changed = true;
                } else {
                    unsafe { *opt_bbid_at(oarr, i) = OptBbId { v: cur_v }; }
                }
                i = i + 1;
            }
            bb.term.switch_targets = oarr;
        }
        if bb.term.orig_term.switch_count > 0 && (bb.term.orig_term.targets as usize) != 0 {
            let n = bb.term.orig_term.switch_count;
            let mbytes = lxf_mul_usize(n, size_of<MirBbId>());
            let marr = arena_alloc_raw(mut_view(*arena), mbytes, align_of<MirBbId>()) as *mut MirBbId;
            let mut i: usize = 0;
            while i < n {
                let cur_v = unsafe { (*mir_bb_id_at(bb.term.orig_term.targets, i)).v };
                unsafe {
                    *mir_bb_id_at(marr, i) = MirBbId { v: if cur_v == old_v { new_v } else { cur_v } };
                }
                i = i + 1;
            }
            bb.term.orig_term.targets = marr;
        }
    } else if tk == OPT_TERM_CALL {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = OptBbId { v: new_v };
            bb.term.orig_term.call_target = MirBbId { v: new_v };
            changed = true;
        }
    } else if tk == OPT_TERM_DROP {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = OptBbId { v: new_v };
            bb.term.orig_term.drop_target = MirBbId { v: new_v };
            changed = true;
        }
    } else if tk == OPT_TERM_ASSERT {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = OptBbId { v: new_v };
            bb.term.orig_term.assert_target = MirBbId { v: new_v };
            changed = true;
        }
    }
    changed
}

fn lxf_extract_mir_from_opt_body(
    opt_body: view<OptBody>,
    out_mir: mut_view<MirBody>,
    arena: mut_view<Arena>
) {
    mir_body_reset(mut_view(*out_mir));
    out_mir.fn_sym = SymbolId { v: opt_body.fn_sym.v };
    out_mir.fn_name = StrId { v: opt_body.fn_name.v };
    out_mir.span = Span {
        file: FileId { v: opt_body.span.file.v },
        start: opt_body.span.start,
        end: opt_body.span.end,
    };
    if (opt_body.orig_mir as usize) != 0 {
        let orig = unsafe { view(*opt_body.orig_mir) };
        out_mir.sym = SymbolId { v: orig.sym.v };
        out_mir.drop_flag_count = orig.drop_flag_count;
        let mut l: usize = 0;
        while l < orig.local_count {
            let decl = unsafe { mir_local_at(orig.locals, l) };
            let lid = mir_add_local(
                mut_view(*out_mir),
                mut_view(*arena),
                TypeId { v: unsafe { (*decl).ty.v } },
                unsafe { (*decl).kind },
                unsafe { (*decl).mut_flag },
                StrId { v: unsafe { (*decl).name.v } },
                unsafe { view((*decl).span) }
            );
            let new_decl = unsafe { mir_local_at(out_mir.locals, lid.v as usize) };
            unsafe { (*new_decl).const_sym = SymbolId { v: (*decl).const_sym.v }; }
            l = l + 1;
        }
        while l < opt_body.local_count {
            let lty_v = unsafe { (*opt_typeid_at(opt_body.local_tys, l)).v };
            let _ = mir_add_local(
                mut_view(*out_mir),
                mut_view(*arena),
                TypeId { v: lty_v },
                0u8,
                true,
                StrId { v: 0u32 },
                view(opt_body.span)
            );
            l = l + 1;
        }
    } else {
        let mut l: usize = 0;
        while l < opt_body.local_count {
            let lty_v = unsafe { (*opt_typeid_at(opt_body.local_tys, l)).v };
            let lkind: u8 = if l >= 1 && l <= opt_body.arg_count { MIR_LOCAL_ARG } else { 0u8 };
            let _ = mir_add_local(
                mut_view(*out_mir),
                mut_view(*arena),
                TypeId { v: lty_v },
                lkind,
                true,
                StrId { v: 0u32 },
                view(opt_body.span)
            );
            l = l + 1;
        }
    }
    out_mir.arg_count = opt_body.arg_count;

    let rterm_ptr = arena_alloc_raw(mut_view(*arena), size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    let mut b: usize = 0;
    while b < opt_body.bb_count {
        let obb = unsafe { opt_block_at(opt_body.blocks, b) };
        let mbb_id = mir_add_bb(mut_view(*out_mir), mut_view(*arena), unsafe { (*obb).is_cleanup });
        let mbb = unsafe { mir_bb_at(out_mir.bbs, mbb_id.v as usize) };
        let icnt = unsafe { (*obb).inst_count };
        let insts = unsafe { (*obb).insts };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            let opc = unsafe { (*inst).opcode };
            let flg = unsafe { (*inst).flags };
            let is_deleted_nop = opc == OPT_INST_NOP && (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16;
            if !is_deleted_nop {
                mir_bb_push_stmt(unsafe { mut_view(*mbb) }, mut_view(*arena), unsafe { view((*inst).orig_stmt) });
            }
            i = i + 1;
        }
        mir_copy_terminator(unsafe { mut_view(*rterm_ptr) }, unsafe { view((*obb).term.orig_term) });
        let otk = unsafe { (*obb).term.kind };
        if otk == OPT_TERM_GOTO {
            unsafe {
                (*rterm_ptr).kind = MIR_TERM_GOTO;
                (*rterm_ptr).goto_target = MirBbId { v: (*obb).term.true_bb.v };
            }
        } else if otk == OPT_TERM_RETURN {
            unsafe { (*rterm_ptr).kind = MIR_TERM_RETURN; }
        } else if otk == OPT_TERM_UNREACHABLE {
            unsafe { (*rterm_ptr).kind = MIR_TERM_UNREACHABLE; }
        }
        mir_bb_set_terminator(unsafe { mut_view(*mbb) }, unsafe { view(*rterm_ptr) });
        b = b + 1;
    }
}

fn lxf_resync_opt_body(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let saved_prov_cnt = body.provenance_count;
    let saved_provs: *mut ProofProvenance = if saved_prov_cnt > 0 && (body.provenance as usize) != 0 {
        let pbytes = lxf_mul_usize(saved_prov_cnt, size_of<ProofProvenance>());
        let parr = arena_alloc_raw(mut_view(*arena), pbytes, align_of<ProofProvenance>()) as *mut ProofProvenance;
        unsafe {
            ptr_copy_nonoverlapping<u8>(body.provenance as *const u8, parr as *mut u8, pbytes);
        }
        parr
    } else {
        0 as *mut ProofProvenance
    };

    let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    lxf_extract_mir_from_opt_body(view(*body), unsafe { mut_view(*rec_mir) }, mut_view(*arena));

    let prev_errs = sink.errors;
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let dummy_bytes = dummy_fn as *mut u8;
    let mut zi: usize = 0;
    while zi < size_of<HirItem>() {
        unsafe { *opt_u8_at(dummy_bytes, zi) = 0u8; }
        zi = zi + 1;
    }
    verify_mir(unsafe { view(*rec_mir) }, body.thir, mut_view(*sink), dummy_fn as *const HirItem);
    if sink.errors != prev_errs {
        sink.errors = prev_errs;
        return false;
    }

    let rebuilt = optir_build_from_verified_mir(unsafe { view(*rec_mir) }, body.thir, mut_view(*arena));
    if (rebuilt as usize) == 0 {
        return false;
    }

    let mut pi: usize = 0;
    while pi < saved_prov_cnt {
        let p = unsafe { opt_prov_at(saved_provs, pi) };
        optir_record_provenance(
            unsafe { mut_view(*rebuilt) },
            mut_view(*arena),
            unsafe { (*p).prop_kind },
            unsafe { (*p).certainty },
            unsafe { (*p).source_analysis },
            unsafe { (*p).subject_val },
            unsafe { (*p).aux_val },
            unsafe { (*p).at_bb },
            unsafe { (*p).at_inst },
            unsafe { (*p).pass_id }
        );
        pi = pi + 1;
    }

    unsafe { *body = *rebuilt; }

    let mut simp_stats = LoopSimplifyStats {
        pass_runs: 0u32,
        pass_changes: 0u32,
        pass_rollbacks: 0u32,
        loops_discovered: 0u32,
        irreducible_cycles: 0u32,
        preheaders_inserted: 0u32,
        latches_merged: 0u32,
        dedicated_exits_inserted: 0u32,
        lcssa_phis_inserted: 0u32,
    };
    let fresh_alias = alias_build_info(view(*body), call_table, mut_view(*arena));
    let use_alias: *const AliasInfo = if (fresh_alias as usize) != 0 { fresh_alias as *const AliasInfo } else { alias_info };
    let _ = opt_loop_simplify(
        mut_view(*pm),
        mut_view(*body),
        call_table,
        use_alias,
        mut_view(simp_stats),
        mut_view(*arena),
        mut_view(*sink)
    );

    if pm.has_baseline_effects {
        let cur_eff = effect_infer_body(mut_view(*body), mut_view(*arena), pm.budget.max_symbolic_steps);
        let vc = cur_eff.volatile_count;
        let bvc = pm.baseline_effect_summary.volatile_count;
        let ac = cur_eff.atomic_count;
        let bac = pm.baseline_effect_summary.atomic_count;
        let ic = cur_eff.io_count;
        let bic = pm.baseline_effect_summary.io_count;
        let dc = cur_eff.drop_count;
        let bdc = pm.baseline_effect_summary.drop_count;
        if vc < bvc || ac < bac || ic < bic || dc < bdc {
            return false;
        }
    }

    optir_verify_contract(view(*body))
}


// --- 1. Effect- and MemorySSA-Verified LICM (`opt_licm`, AXS-LOOP-010, AXS-LXF-001) ---

fn lxf_bb(v: u32) -> OptBbId {
    OptBbId { v: v }
}

fn lxf_val(v: u32) -> OptValueId {
    OptValueId { v: v }
}

fn lxf_loc(v: u32) -> MirLocalId {
    MirLocalId { v: v }
}

fn lxf_ty(v: u32) -> TypeId {
    TypeId { v: v }
}

fn lxf_loop_id(v: u32) -> LoopId {
    LoopId { v: v }
}

fn lxf_dominates_all_exits(lp: view<LoopDesc>, body: view<OptBody>, bb_id: OptBbId) -> bool {
    if lp.exiting_count == 0 || lp.latch_count == 0 {
        return false;
    }
    let bb_v = bb_id.v;
    let mut l_i: usize = 0;
    while l_i < lp.latch_count {
        let latch_v = unsafe { (*opt_bbid_at(lp.latches, l_i)).v };
        if !opt_dominates(body, lxf_bb(bb_v), lxf_bb(latch_v)) {
            return false;
        }
        l_i = l_i + 1;
    }
    let mut e: usize = 0;
    while e < lp.exiting_count {
        let ex_v = unsafe { (*opt_bbid_at(lp.exiting_blocks, e)).v };
        if ex_v != lp.header.v && !opt_dominates(body, lxf_bb(bb_v), lxf_bb(ex_v)) {
            return false;
        }
        e = e + 1;
    }
    let mut k: usize = 0;
    while k < lp.block_count {
        let kb_v = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if kb_v != bb_v && opt_dominates(body, lxf_bb(kb_v), lxf_bb(bb_v)) && (kb_v as usize) < body.bb_count {
            let kbb = unsafe { opt_block_at(body.blocks, kb_v as usize) };
            if unsafe { (*kbb).has_term } {
                let ktk = unsafe { (*kbb).term.kind };
                if ktk == OPT_TERM_ASSERT || ktk == OPT_TERM_CALL {
                    return false;
                }
            }
        }
        k = k + 1;
    }
    true
}

fn lxf_place_reads_local(pl: view<MirPlace>, loc_v: u32) -> bool {
    if pl.local.v == loc_v {
        return true;
    }
    let mut pi: usize = 0;
    while pi < pl.proj_count && (pl.projs as usize) != 0 {
        let pr = unsafe { mir_proj_at(pl.projs, pi) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX && (unsafe { (*pr).index_local.v }) == loc_v {
            return true;
        }
        if pk == MIR_PROJ_SUB_SLICE {
            if (unsafe { (*pr).has_from }) && (unsafe { (*pr).from_local.v }) == loc_v {
                return true;
            }
            if (unsafe { (*pr).has_to }) && (unsafe { (*pr).to_local.v }) == loc_v {
                return true;
            }
        }
        pi = pi + 1;
    }
    false
}

fn lxf_operand_reads_local(op: view<MirOperand>, loc_v: u32) -> bool {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        return lxf_place_reads_local(view(op.place), loc_v);
    }
    false
}

fn lxf_stmt_reads_local(stmt: view<MirStmt>, loc_v: u32) -> bool {
    let sk = stmt.kind;
    if sk == MIR_STMT_DROP {
        return lxf_place_reads_local(view(stmt.place), loc_v);
    }
    if sk != MIR_STMT_ASSIGN {
        return false;
    }
    if stmt.place.proj_count > 0 && lxf_place_reads_local(view(stmt.place), loc_v) {
        return true;
    }
    let rk = stmt.rvalue.kind;
    if rk == MIR_RVALUE_USE {
        return lxf_operand_reads_local(view(stmt.rvalue.use_op), loc_v);
    }
    if rk == MIR_RVALUE_REPEAT {
        return lxf_operand_reads_local(view(stmt.rvalue.use_op), loc_v);
    }
    if rk == MIR_RVALUE_REF {
        return lxf_place_reads_local(view(stmt.rvalue.place), loc_v);
    }
    if rk == MIR_RVALUE_LEN {
        return lxf_place_reads_local(view(stmt.rvalue.place), loc_v);
    }
    if rk == MIR_RVALUE_CAST {
        return lxf_operand_reads_local(view(stmt.rvalue.use_op), loc_v);
    }
    if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        return lxf_operand_reads_local(view(stmt.rvalue.lhs), loc_v) ||
               lxf_operand_reads_local(view(stmt.rvalue.rhs), loc_v);
    }
    if rk == MIR_RVALUE_UNARY_OP {
        return lxf_operand_reads_local(view(stmt.rvalue.use_op), loc_v);
    }
    if rk == MIR_RVALUE_DISCRIMINANT {
        return lxf_place_reads_local(view(stmt.rvalue.place), loc_v);
    }
    if rk == MIR_RVALUE_AGGREGATE {
        let mut ai: usize = 0;
        while ai < stmt.rvalue.operand_count && (stmt.rvalue.operands as usize) != 0 {
            let aop = unsafe { mir_op_at(stmt.rvalue.operands, ai) };
            if lxf_operand_reads_local(unsafe { view(*aop) }, loc_v) {
                return true;
            }
            ai = ai + 1;
        }
    }
    false
}

fn lxf_term_reads_local(term: view<MirTerminator>, loc_v: u32) -> bool {
    let tk = term.kind;
    if tk == MIR_TERM_SWITCH_INT {
        return lxf_operand_reads_local(view(term.discr), loc_v);
    }
    if tk == MIR_TERM_ASSERT {
        return lxf_operand_reads_local(view(term.cond), loc_v);
    }
    if tk == MIR_TERM_DROP {
        return lxf_place_reads_local(view(term.drop_place), loc_v);
    }
    if tk == MIR_TERM_CALL {
        if lxf_operand_reads_local(view(term.func), loc_v) {
            return true;
        }
        let mut ai: usize = 0;
        while ai < term.arg_count && (term.args as usize) != 0 {
            let aop = unsafe { mir_op_at(term.args, ai) };
            if lxf_operand_reads_local(unsafe { view(*aop) }, loc_v) {
                return true;
            }
            ai = ai + 1;
        }
    }
    false
}

fn lxf_local_single_def_dominates_uses_in_loop(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    def_bb: OptBbId,
    def_idx: usize,
    loc_v: u32
) -> bool {
    if loc_v == 0u32 || loops_local_has_indirect_mutation(body, info, loc_v) {
        return false;
    }
    let def_v = def_bb.v;
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                let flg = unsafe { (*inst).flags };
                if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
                    if (unsafe { (*inst).place.local.v }) == loc_v ||
                       (unsafe { (*inst).orig_stmt.storage_local.v }) == loc_v {
                        return false;
                    }
                }
                if opc != OPT_INST_NOP {
                    if !(bv == def_v && i == def_idx) {
                        if (unsafe { (*inst).place.local.v }) == loc_v ||
                           (unsafe { (*inst).orig_stmt.place.local.v }) == loc_v {
                            return false;
                        }
                    }
                    if lxf_stmt_reads_local(unsafe { view((*inst).orig_stmt) }, loc_v) {
                        if bv == def_v {
                            if i <= def_idx {
                                return false;
                            }
                        } else if !opt_dominates(body, lxf_bb(def_v), lxf_bb(bv)) {
                            return false;
                        }
                    }
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_CALL && (unsafe { (*bb).term.has_call_dest }) &&
                   (unsafe { (*bb).term.call_dest.local.v }) == loc_v {
                    return false;
                }
                if tk == OPT_TERM_DROP && (unsafe { (*bb).term.drop_place.local.v }) == loc_v {
                    return false;
                }
                if lxf_term_reads_local(unsafe { view((*bb).term.orig_term) }, loc_v) {
                    if !opt_dominates(body, lxf_bb(def_v), lxf_bb(bv)) {
                        return false;
                    }
                }
            }
        }
        k = k + 1;
    }
    true
}

fn lxf_inst_operands_invariant(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    inst: view<OptInst>
) -> bool {
    let opc = inst.opcode;
    let is_place_read = opc == OPT_INST_LOAD || opc == OPT_INST_LEN ||
                        opc == OPT_INST_DISCRIMINANT || opc == OPT_INST_EXTRACT_FIELD ||
                        opc == OPT_INST_VOLATILE_LOAD;
    if is_place_read {
        let mut rpi: usize = 0;
        while rpi < inst.rhs_place.proj_count && (inst.rhs_place.projs as usize) != 0 {
            let rp = unsafe { mir_proj_at(inst.rhs_place.projs, rpi) };
            let rpk = unsafe { (*rp).kind };
            if rpk == MIR_PROJ_INDEX &&
               loops_local_written_in_loop(lp, body, info, unsafe { (*rp).index_local.v }) {
                return false;
            }
            if rpk == MIR_PROJ_SUB_SLICE {
                if (unsafe { (*rp).has_from }) &&
                   loops_local_written_in_loop(lp, body, info, unsafe { (*rp).from_local.v }) {
                    return false;
                }
                if (unsafe { (*rp).has_to }) &&
                   loops_local_written_in_loop(lp, body, info, unsafe { (*rp).to_local.v }) {
                    return false;
                }
            }
            rpi = rpi + 1;
        }
        return true;
    }
    if inst.lhs.v != OPT_VALUE_NONE && !loops_is_val_invariant(lp, body, info, lxf_val(inst.lhs.v)) {
        return false;
    }
    if inst.rhs.v != OPT_VALUE_NONE && !loops_is_val_invariant(lp, body, info, lxf_val(inst.rhs.v)) {
        return false;
    }
    let mut ei: usize = 0;
    while ei < inst.extra_arg_count && (inst.extra_args as usize) != 0 {
        let ev_v = unsafe { (*opt_valid_at(inst.extra_args, ei)).v };
        if ev_v != OPT_VALUE_NONE && !loops_is_val_invariant(lp, body, info, lxf_val(ev_v)) {
            return false;
        }
        ei = ei + 1;
    }
    true
}

fn lxf_load_is_clobbered_in_loop(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    inst: view<OptInst>,
    arena: mut_view<Arena>
) -> bool {
    if (info as usize) == 0 {
        return true;
    }
    let rbase_l = inst.rhs_place.local.v;
    if rbase_l != 0u32 && loops_local_written_in_loop(lp, body, info, rbase_l) {
        return true;
    }
    let ainfo = unsafe { view(*info) };
    let rreg = alias_extract_region(ainfo, body, view(inst.rhs_place), lxf_val(OPT_VALUE_NONE), mut_view(*arena));
    loops_region_clobbered_in_loop(lp, body, info, call_table, view(rreg), mut_view(*arena))
}

fn lxf_can_hoist_inst(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    bb_id: OptBbId,
    inst_idx: usize,
    arena: mut_view<Arena>
) -> bool {
    let bb_v = bb_id.v;
    if loops_can_hoist_inst(lp, body, info, call_table, lxf_bb(bb_v), inst_idx, mut_view(*arena)) {
        return true;
    }
    if lp.is_irreducible || (lp.has_observable_barriers & BARRIER_GPU_DOMAIN) != 0u16 {
        return false;
    }
    if (bb_v as usize) >= body.bb_count || !lp_block_in_set(lp.blocks, lp.block_count, bb_v) {
        return false;
    }
    let bb = unsafe { opt_block_at(body.blocks, bb_v as usize) };
    if inst_idx >= (unsafe { (*bb).inst_count }) {
        return false;
    }
    let inst = unsafe { opt_inst_at((*bb).insts, inst_idx) };
    let opc = unsafe { (*inst).opcode };
    let flg = unsafe { (*inst).flags };
    if opc == OPT_INST_NOP || opc == OPT_INST_STORE || opc == OPT_INST_VOLATILE_LOAD ||
       opc == OPT_INST_VOLATILE_STORE || opc == OPT_INST_ATOMIC || opc == OPT_INST_BLACK_BOX ||
       opc == OPT_INST_ZEROIZE || opc == OPT_INST_DROP_FLAG || opc == OPT_INST_ADDR_OF {
        return false;
    }
    if (flg & (OPT_FLAG_BARRIER | OPT_FLAG_MOVE | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
        return false;
    }
    if !lxf_inst_operands_invariant(lp, body, info, unsafe { view(*inst) }) {
        return false;
    }
    let dlv = unsafe { (*inst).place.local.v };
    let dpc = unsafe { (*inst).place.proj_count };
    if dpc > 0 || (dlv != 0u32 && loops_local_has_indirect_mutation(body, info, dlv)) {
        return false;
    }
    let eff = effect_infer_inst(body, unsafe { view(*inst) }, 64u32);
    if (eff & (EFFECT_WRITES_MEM | EFFECT_ALLOCATES | EFFECT_IO | EFFECT_ATOMIC |
               EFFECT_VOLATILE | EFFECT_FFI | EFFECT_NONTERM | EFFECT_UNKNOWN)) != 0u16 {
        return false;
    }
    if (eff & EFFECT_MAY_PANIC) != 0u16 {
        let proven_nonzero_trip = lp.trip_count.kind == TRIP_CONST &&
                                  lp.trip_count.const_iters >= 1u64 &&
                                  lp.trip_count.certainty == CERTAINTY_PROVEN;
        if !proven_nonzero_trip || !lxf_dominates_all_exits(lp, body, lxf_bb(bb_v)) ||
           (lp.has_observable_barriers & (BARRIER_IO | BARRIER_VOLATILE | BARRIER_ATOMIC | BARRIER_FFI)) != 0u16 {
            return false;
        }
    }
    if opc == OPT_INST_LOAD || opc == OPT_INST_LEN || opc == OPT_INST_DISCRIMINANT || opc == OPT_INST_EXTRACT_FIELD {
        if lxf_load_is_clobbered_in_loop(lp, body, info, call_table, unsafe { view(*inst) }, mut_view(*arena)) {
            return false;
        }
        let ainfo = unsafe { view(*info) };
        let rreg = alias_extract_region(ainfo, body, unsafe { view((*inst).rhs_place) }, lxf_val(OPT_VALUE_NONE), mut_view(*arena));
        if rreg.cap_mode == CAP_MODE_RAW_PTR {
            let proven_nonzero_trip = lp.trip_count.kind == TRIP_CONST &&
                                      lp.trip_count.const_iters >= 1u64 &&
                                      lp.trip_count.certainty == CERTAINTY_PROVEN;
            if !proven_nonzero_trip || !lxf_dominates_all_exits(lp, body, lxf_bb(bb_v)) {
                return false;
            }
        }
    }
    true
}

pub fn opt_licm(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let budget = loop_cost_budget_for_profile(pm.budget.profile);
    if !budget.allow_licm {
        return false;
    }

    let contract = licm_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let ex_snap = lxf_save_extra_snap(view(*body));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_stats = *stats;
    stats.pass_runs = stats.pass_runs + 1u32;

    let use_alias: *const AliasInfo = if (alias_info as usize) != 0 {
        alias_info
    } else {
        alias_build_info(view(*body), call_table, mut_view(*arena)) as *const AliasInfo
    };

    let tree = loops_discover(view(*body), call_table, use_alias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*tree) }, view(*body), use_alias, mut_view(*arena));

    let lcnt = unsafe { (*tree).loop_count };
    if lcnt == 0 {
        return false;
    }

    let mut max_d: u32 = 0u32;
    let mut li: usize = 0;
    while li < lcnt {
        let ld = unsafe { (*loop_desc_at((*tree).loops, li)).depth };
        if ld > max_d {
            max_d = ld;
        }
        li = li + 1;
    }

    let mut changed = false;
    let mut d_iter: u32 = max_d + 1u32;
    while d_iter > 1u32 {
        d_iter = d_iter - 1u32;
        li = 0;
        while li < lcnt {
            let lp = unsafe { loop_desc_at((*tree).loops, li) };
            if !(unsafe { (*lp).is_irreducible }) &&
               (unsafe { (*lp).depth }) == d_iter &&
               (unsafe { (*lp).preheader.v }) != OPT_BB_NONE &&
               ((unsafe { (*lp).preheader.v }) as usize) < body.bb_count {
                // 1. Fixed-point hoisting of loop-invariant instructions
                let mut iter_hoisted = true;
                let mut fp_steps: usize = 0;
                while iter_hoisted && fp_steps < 16 {
                    iter_hoisted = false;
                    fp_steps = fp_steps + 1;
                    let mut k: usize = 0;
                    while k < (unsafe { (*lp).block_count }) {
                        let bb_v = unsafe { (*opt_bbid_at((*lp).blocks, k)).v };
                        if (bb_v as usize) < body.bb_count {
                            let bb = unsafe { opt_block_at(body.blocks, bb_v as usize) };
                            let icnt = unsafe { (*bb).inst_count };
                            let mut i: usize = 0;
                            while i < icnt {
                                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                                let opc = unsafe { (*inst).opcode };
                                let flg = unsafe { (*inst).flags };
                                let sk = unsafe { (*inst).orig_stmt.kind };
                                let dlv = unsafe { (*inst).place.local.v };
                                let dpc = unsafe { (*inst).place.proj_count };
                                if opc != OPT_INST_NOP &&
                                   opc != OPT_INST_CONST &&
                                   opc != OPT_INST_COPY &&
                                   opc != OPT_INST_STORE &&
                                   opc != OPT_INST_ADDR_OF &&
                                   (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
                                   sk == MIR_STMT_ASSIGN &&
                                   dlv != 0u32 && dpc == 0 {
                                    if lxf_local_single_def_dominates_uses_in_loop(unsafe { view(*lp) }, view(*body), use_alias, lxf_bb(bb_v), i, dlv) &&
                                       lxf_inst_operands_invariant(unsafe { view(*lp) }, view(*body), use_alias, unsafe { view(*inst) }) {
                                        if opc == OPT_INST_LOAD || opc == OPT_INST_EXTRACT_FIELD {
                                            unsafe { (*inst).lhs = lxf_val(OPT_VALUE_NONE); }
                                        }
                                        if lxf_can_hoist_inst(unsafe { view(*lp) }, view(*body), use_alias, call_table, lxf_bb(bb_v), i, mut_view(*arena)) {
                                            let res_v = unsafe { (*inst).result.v };
                                            let is_load_like = opc == OPT_INST_LOAD || opc == OPT_INST_LEN ||
                                                               opc == OPT_INST_DISCRIMINANT || opc == OPT_INST_EXTRACT_FIELD;
                                            let ph_v = unsafe { (*lp).preheader.v };
                                            let ph_bb = unsafe { opt_block_at(body.blocks, ph_v as usize) };
                                            let moved_inst = lxf_clone_inst(unsafe { view(*inst) }, mut_view(*arena), PASS_LICM);
                                            lxf_push_inst_to_block(unsafe { mut_view(*ph_bb) }, mut_view(*arena), moved_inst);

                                            // Mark original instruction in loop block as deleted NOP
                                            let cur_bb = unsafe { opt_block_at(body.blocks, bb_v as usize) };
                                            let cur_inst = unsafe { opt_inst_at((*cur_bb).insts, i) };
                                            unsafe {
                                                (*cur_inst).opcode = OPT_INST_NOP;
                                                (*cur_inst).flags = OPT_FLAG_NONE;
                                            }
                                            if res_v != OPT_VALUE_NONE && (res_v as usize) <= body.value_count {
                                                let vp = unsafe { opt_val_at(body.values, res_v as usize) };
                                                unsafe { (*vp).def_bb = lxf_bb(ph_v); }
                                            }
                                            if is_load_like {
                                                stats.licm_hoisted_loads = stats.licm_hoisted_loads + 1u32;
                                                optir_record_provenance(
                                                    mut_view(*body),
                                                    mut_view(*arena),
                                                    PROP_NO_ALIAS,
                                                    CERTAINTY_PROVEN,
                                                    ANALYSIS_ALIAS_INFO,
                                                    lxf_val(res_v),
                                                    lxf_val(OPT_VALUE_NONE),
                                                    lxf_bb(ph_v),
                                                    OptInstId { v: i as u32 },
                                                    PASS_LICM
                                                );
                                                lxf_push_record(
                                                    mut_view(*stats), mut_view(*arena),
                                                    PASS_LICM, LXF_KIND_LICM_LOAD, true, CERTAINTY_PROVEN,
                                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                                    lxf_val(res_v), lxf_val(OPT_VALUE_NONE), 0u64,
                                                    LXF_REASON_INVARIANT_LOAD
                                                );
                                            } else {
                                                stats.licm_hoisted_scalars = stats.licm_hoisted_scalars + 1u32;
                                                lxf_push_record(
                                                    mut_view(*stats), mut_view(*arena),
                                                    PASS_LICM, LXF_KIND_LICM_SCALAR, true, CERTAINTY_PROVEN,
                                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                                    lxf_val(res_v), lxf_val(OPT_VALUE_NONE), 0u64,
                                                    LXF_REASON_PURE_INVARIANT
                                                );
                                            }
                                            iter_hoisted = true;
                                            changed = true;
                                        } else if fp_steps == 1 {
                                            let res_v = unsafe { (*inst).result.v };
                                            let eff = effect_infer_inst(view(*body), unsafe { view(*inst) }, 64u32);
                                            let is_clobbered_load = (opc == OPT_INST_LOAD || opc == OPT_INST_LEN ||
                                                                     opc == OPT_INST_DISCRIMINANT || opc == OPT_INST_EXTRACT_FIELD) &&
                                                                    lxf_load_is_clobbered_in_loop(unsafe { view(*lp) }, view(*body), use_alias, call_table, unsafe { view(*inst) }, mut_view(*arena));
                                            if opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_VOLATILE_STORE ||
                                               opc == OPT_INST_ATOMIC || opc == OPT_INST_BLACK_BOX ||
                                               (flg & OPT_FLAG_BARRIER) != 0u16 ||
                                               (eff & (EFFECT_VOLATILE | EFFECT_ATOMIC | EFFECT_IO | EFFECT_FFI)) != 0u16 ||
                                               ((unsafe { (*lp).has_observable_barriers }) & BARRIER_GPU_DOMAIN) != 0u16 {
                                                stats.licm_blocked_barriers = stats.licm_blocked_barriers + 1u32;
                                                lxf_push_record(
                                                    mut_view(*stats), mut_view(*arena),
                                                    PASS_LICM, LXF_KIND_NONE, false, CERTAINTY_UNKNOWN,
                                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                                    lxf_val(res_v), lxf_val(OPT_VALUE_NONE), 0u64,
                                                    LXF_REASON_BARRIER
                                                );
                                            } else if is_clobbered_load {
                                                stats.licm_blocked_clobbers = stats.licm_blocked_clobbers + 1u32;
                                                lxf_push_record(
                                                    mut_view(*stats), mut_view(*arena),
                                                    PASS_LICM, LXF_KIND_NONE, false, CERTAINTY_POSSIBLE,
                                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                                    lxf_val(res_v), lxf_val(OPT_VALUE_NONE), 0u64,
                                                    LXF_REASON_ALIAS_CLOBBER
                                                );
                                            } else if (eff & EFFECT_MAY_PANIC) != 0u16 {
                                                stats.licm_blocked_traps = stats.licm_blocked_traps + 1u32;
                                                lxf_push_record(
                                                    mut_view(*stats), mut_view(*arena),
                                                    PASS_LICM, LXF_KIND_NONE, false, CERTAINTY_POSSIBLE,
                                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                                    lxf_val(res_v), lxf_val(OPT_VALUE_NONE), 0u64,
                                                    LXF_REASON_ZERO_TRIP_TRAP
                                                );
                                            } else if opc == OPT_INST_LOAD || opc == OPT_INST_LEN ||
                                                      opc == OPT_INST_DISCRIMINANT || opc == OPT_INST_EXTRACT_FIELD {
                                                stats.licm_blocked_clobbers = stats.licm_blocked_clobbers + 1u32;
                                                lxf_push_record(
                                                    mut_view(*stats), mut_view(*arena),
                                                    PASS_LICM, LXF_KIND_NONE, false, CERTAINTY_POSSIBLE,
                                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                                    lxf_val(res_v), lxf_val(OPT_VALUE_NONE), 0u64,
                                                    LXF_REASON_ALIAS_CLOBBER
                                                );
                                            }
                                        }
                                    }
                                } else if fp_steps == 1 && (opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_ATOMIC || opc == OPT_INST_BLACK_BOX) {
                                    if lxf_inst_operands_invariant(unsafe { view(*lp) }, view(*body), use_alias, unsafe { view(*inst) }) {
                                        stats.licm_blocked_barriers = stats.licm_blocked_barriers + 1u32;
                                        lxf_push_record(
                                            mut_view(*stats), mut_view(*arena),
                                            PASS_LICM, LXF_KIND_NONE, false, CERTAINTY_UNKNOWN,
                                            lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                            lxf_val(unsafe { (*inst).result.v }), lxf_val(OPT_VALUE_NONE), 0u64,
                                            LXF_REASON_BARRIER
                                        );
                                    }
                                }
                                i = i + 1;
                            }
                        }
                        k = k + 1;
                    }
                }

                // 2. Check loop-invariant `OPT_TERM_ASSERT` guards inside the loop (AXS-LOOP-010, REQ-OPT-162)
                let mut gk: usize = 0;
                while gk < (unsafe { (*lp).block_count }) {
                    let gbb_v = unsafe { (*opt_bbid_at((*lp).blocks, gk)).v };
                    if (gbb_v as usize) < body.bb_count {
                        let gbb = unsafe { opt_block_at(body.blocks, gbb_v as usize) };
                        if (unsafe { (*gbb).has_term }) && (unsafe { (*gbb).term.kind }) == OPT_TERM_ASSERT {
                            let gcond_v = unsafe { (*gbb).term.cond.v };
                            if loops_is_val_invariant(unsafe { view(*lp) }, view(*body), use_alias, lxf_val(gcond_v)) {
                                let proven_nonzero = (unsafe { (*lp).trip_count.kind }) == TRIP_CONST &&
                                                     (unsafe { (*lp).trip_count.const_iters }) >= 1u64 &&
                                                     (unsafe { (*lp).trip_count.certainty }) == CERTAINTY_PROVEN;
                                let no_barriers = ((unsafe { (*lp).has_observable_barriers }) &
                                                   (BARRIER_IO | BARRIER_VOLATILE | BARRIER_ATOMIC | BARRIER_FFI | BARRIER_GPU_DOMAIN)) == 0u16;
                                let ph_v = unsafe { (*lp).preheader.v };
                                let ph_bb = unsafe { opt_block_at(body.blocks, ph_v as usize) };
                                let ph_is_goto = (unsafe { (*ph_bb).has_term }) && (unsafe { (*ph_bb).term.kind }) == OPT_TERM_GOTO;
                                if proven_nonzero && no_barriers && ph_is_goto &&
                                   lxf_dominates_all_exits(unsafe { view(*lp) }, view(*body), lxf_bb(gbb_v)) {
                                    let hdr_v = unsafe { (*lp).header.v };
                                    let mut span_copy = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                                    mir_span_copy(mut_view(span_copy), unsafe { view((*gbb).term.orig_term.location) });
                                    let new_ph = lxf_append_goto_block(mut_view(*body), mut_view(*arena), lxf_bb(hdr_v), view(span_copy));
                                    let new_ph_v = new_ph.v;

                                    let ph_bb2 = unsafe { opt_block_at(body.blocks, ph_v as usize) };
                                    let gbb2 = unsafe { opt_block_at(body.blocks, gbb_v as usize) };
                                    let old_true_v = unsafe { (*gbb2).term.true_bb.v };

                                    // Hoist assert terminator into `ph_bb2` targeting `new_ph`
                                    let mut hoisted_term = unsafe { (*gbb2).term };
                                    mir_copy_terminator(mut_view(hoisted_term.orig_term), unsafe { view((*gbb2).term.orig_term) });
                                    hoisted_term.true_bb = lxf_bb(new_ph_v);
                                    hoisted_term.orig_term.assert_target = MirBbId { v: new_ph_v };
                                    hoisted_term.origin.pass_id = PASS_LICM;
                                    unsafe { (*ph_bb2).term = hoisted_term; }

                                    // Fold in-loop assert in `gbb2` to unconditional `GOTO old_true_bb`
                                    unsafe {
                                        (*gbb2).term.kind = OPT_TERM_GOTO;
                                        (*gbb2).term.cond = lxf_val(OPT_VALUE_NONE);
                                        (*gbb2).term.true_bb = lxf_bb(old_true_v);
                                        (*gbb2).term.false_bb = lxf_bb(OPT_BB_NONE);
                                        (*gbb2).term.unwind_bb = lxf_bb(OPT_BB_NONE);
                                        mir_term_reset(mut_view((*gbb2).term.orig_term), MIR_TERM_GOTO, view(span_copy));
                                        (*gbb2).term.orig_term.goto_target = MirBbId { v: old_true_v };
                                        (*lp).preheader = lxf_bb(new_ph_v);
                                    }
                                    stats.licm_hoisted_guards = stats.licm_hoisted_guards + 1u32;
                                    lxf_push_record(
                                        mut_view(*stats), mut_view(*arena),
                                        PASS_LICM, LXF_KIND_LICM_GUARD, true, CERTAINTY_PROVEN,
                                        lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(gbb_v), 0u32,
                                        lxf_val(gcond_v), lxf_val(OPT_VALUE_NONE),
                                        unsafe { (*lp).trip_count.const_iters },
                                        LXF_REASON_INVARIANT_GUARD
                                    );
                                    changed = true;
                                } else {
                                    stats.licm_blocked_traps = stats.licm_blocked_traps + 1u32;
                                    lxf_push_record(
                                        mut_view(*stats), mut_view(*arena),
                                        PASS_LICM, LXF_KIND_NONE, false, CERTAINTY_POSSIBLE,
                                        lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(gbb_v), 0u32,
                                        lxf_val(gcond_v), lxf_val(OPT_VALUE_NONE), 0u64,
                                        LXF_REASON_ZERO_TRIP_TRAP
                                    );
                                }
                            }
                        }
                    }
                    gk = gk + 1;
                }
            }
            li = li + 1;
        }
    }

    if !changed {
        return false;
    }

    if !lxf_resync_opt_body(mut_view(*pm), mut_view(*body), call_table, use_alias, mut_view(*arena), mut_view(*sink)) {
        lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
        pm.ir_revision = pre_rev;
        pm.valid_analyses = pre_valid;
        lxf_copy_stats(mut_view(*stats), view(pre_stats));
        stats.pass_runs = pre_stats.pass_runs + 1u32;
        stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
        return false;
    }

    pm.ir_revision = pm.ir_revision + 1u32;
    stats.pass_changes = stats.pass_changes + 1u32;
    passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
    let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                    analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                    analysis_bit(ANALYSIS_LOOP_INFO);
    pm.valid_analyses = pm.valid_analyses | keep_mask;
    loops_stamp_valid_analysis_revs(mut_view(*pm));

    if pm.budget.verify_each {
        if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
            lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
            pm.ir_revision = pre_rev;
            pm.valid_analyses = pre_valid;
            lxf_copy_stats(mut_view(*stats), view(pre_stats));
            stats.pass_runs = pre_stats.pass_runs + 1u32;
            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
            return false;
        }
    }

    true
}

// --- 2. Induction Variable Strength Reduction & Address Evolution (`opt_iv_strength_reduce`, AXS-LOOP-012, AXS-LXF-002) ---

fn lxf_find_primary_iv_for_val(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    val_id: OptValueId
) -> *mut InductionVar {
    if lp.iv_count == 0 || (lp.ivs as usize) == 0 {
        return 0 as *mut InductionVar;
    }
    let pv = lp_peel_copy(body, val_id);
    if pv.v == OPT_VALUE_NONE || (pv.v as usize) > body.value_count {
        return 0 as *mut InductionVar;
    }
    let vp = unsafe { opt_val_at(body.values, pv.v as usize) };
    let v_loc = unsafe { (*vp).src_local.v };
    let mut i: usize = 0;
    while i < lp.iv_count {
        let iv = unsafe { loop_iv_at(lp.ivs, i) };
        if unsafe { (*iv).is_primary } {
            let phi_v = unsafe { (*iv).phi_val.v };
            if phi_v == pv.v {
                return iv;
            }
            if phi_v != OPT_VALUE_NONE && (phi_v as usize) <= body.value_count {
                let pvp = unsafe { opt_val_at(body.values, phi_v as usize) };
                if v_loc != 0u32 && (unsafe { (*pvp).src_local.v }) == v_loc &&
                   (unsafe { (*vp).def_bb.v }) == lp.header.v {
                    return iv;
                }
            }
        }
        i = i + 1;
    }
    0 as *mut InductionVar
}

fn lxf_find_iv_step_site(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    iv_local: u32,
    out_bb: mut_view<OptBbId>,
    out_idx: mut_view<usize>
) -> bool {
    let mut found = false;
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                if (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP || opc == OPT_INST_COPY) &&
                   (unsafe { (*inst).place.local.v }) == iv_local &&
                   (unsafe { (*inst).place.proj_count }) == 0 {
                    if found {
                        return false;
                    }
                    found = true;
                    *out_bb = lxf_bb(bv);
                    *out_idx = i;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    found
}

fn lxf_prove_mul_no_overflow_on_loop(
    tree: view<LoopTree>,
    lp: view<LoopDesc>,
    body: view<OptBody>,
    piv: view<InductionVar>,
    scale_u: u64,
    scale_i: i64,
    ty: TypeId,
    out_init_u: mut_view<u64>,
    out_stride_u: mut_view<u64>
) -> bool {
    if !piv.no_wrap_proven || lp.trip_count.kind != TRIP_CONST ||
       lp.trip_count.certainty != CERTAINTY_PROVEN || piv.step_const <= 0i64 {
        return false;
    }
    let start_idx = piv.start_expr as usize;
    if piv.start_expr == SCEV_IDX_NONE || start_idx >= tree.scev_count || (tree.scev_pool as usize) == 0 {
        return false;
    }
    let st_ex = unsafe { scev_expr_at(tree.scev_pool, start_idx) };
    if (unsafe { (*st_ex).kind }) != SCEV_CONST {
        return false;
    }
    let start_i = unsafe { (*st_ex).const_val };
    let start_u = start_i as u64;
    let step_u = piv.step_const as u64;
    let ty_v = ty.v;
    let mut bits = opt_type_bits(body.thir, lxf_ty(ty_v));
    if bits == 0u32 {
        bits = 64u32;
    }
    let is_signed = opt_type_is_signed(body.thir, lxf_ty(ty_v));
    if is_signed && (start_i < 0i64 || scale_i < 0i64) {
        return false;
    }

    let mut init_u: u64 = 0u64;
    let mut stride_u: u64 = 0u64;
    if is_signed {
        if opt_checked_mul_signed(start_u, scale_u, bits, mut_view(init_u)) {
            return false;
        }
        if opt_checked_mul_signed(step_u, scale_u, bits, mut_view(stride_u)) {
            return false;
        }
    } else {
        if opt_checked_mul_u64(start_u, scale_u, bits, mut_view(init_u)) {
            return false;
        }
        if opt_checked_mul_u64(step_u, scale_u, bits, mut_view(stride_u)) {
            return false;
        }
    }

    let iters = lp.trip_count.const_iters;
    if iters > 0u64 {
        let mut total_delta: u64 = 0u64;
        if opt_checked_mul_u64(iters, stride_u, bits, mut_view(total_delta)) {
            return false;
        }
        let mut end_val: u64 = 0u64;
        if is_signed {
            if opt_checked_add_signed(init_u, total_delta, bits, mut_view(end_val)) {
                return false;
            }
        } else {
            if opt_checked_add_u64(init_u, total_delta, bits, mut_view(end_val)) {
                return false;
            }
        }
    }

    *out_init_u = init_u;
    *out_stride_u = stride_u;
    true
}

fn lxf_try_fold_dominating_mul_overflow_assert(
    lp: view<LoopDesc>,
    body: mut_view<OptBody>,
    mul_bb: OptBbId,
    iv_val: OptValueId,
    scale_u: u64,
    arena: mut_view<Arena>
) {
    let mul_bb_v = mul_bb.v;
    let iv_val_v = iv_val.v;
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if bv != mul_bb_v && (bv as usize) < body.bb_count &&
           opt_dominates(view(*body), lxf_bb(bv), lxf_bb(mul_bb_v)) {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) == OPT_TERM_ASSERT {
                let cond_v = lp_peel_copy(view(*body), lxf_val(unsafe { (*bb).term.cond.v })).v;
                let mut ov_v = cond_v;
                if unsafe { (*bb).term.assert_expected } {
                    let cinst = lp_find_def_inst(view(*body), lxf_val(cond_v));
                    if (cinst as usize) != 0 && (unsafe { (*cinst).opcode }) == OPT_INST_UNOP &&
                       (unsafe { (*cinst).sub_op }) == MIR_UNOP_NOT {
                        ov_v = lp_peel_copy(view(*body), lxf_val(unsafe { (*cinst).lhs.v })).v;
                    } else {
                        ov_v = OPT_VALUE_NONE;
                    }
                }
                if ov_v != OPT_VALUE_NONE {
                    let oinst = lp_find_def_inst(view(*body), lxf_val(ov_v));
                    if (oinst as usize) != 0 && (unsafe { (*oinst).opcode }) == OPT_INST_CHECKED_BINOP &&
                       (unsafe { (*oinst).sub_op }) == MIR_BINOP_MUL {
                        let ol_v = lp_peel_copy(view(*body), lxf_val(unsafe { (*oinst).lhs.v })).v;
                        let or_v = lp_peel_copy(view(*body), lxf_val(unsafe { (*oinst).rhs.v })).v;
                        let mut cu: u64 = 0u64;
                        let mut ci: i64 = 0i64;
                        let matched = (ol_v == iv_val_v && lp_val_const_int(view(*body), lxf_val(or_v), mut_view(cu), mut_view(ci)) && cu == scale_u) ||
                                      (or_v == iv_val_v && lp_val_const_int(view(*body), lxf_val(ol_v), mut_view(cu), mut_view(ci)) && cu == scale_u);
                        if matched {
                            let target_v = unsafe { (*bb).term.true_bb.v };
                            let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                            mir_span_copy(mut_view(sp), unsafe { view((*bb).term.orig_term.location) });
                            unsafe {
                                (*bb).term.kind = OPT_TERM_GOTO;
                                (*bb).term.cond = lxf_val(OPT_VALUE_NONE);
                                (*bb).term.true_bb = lxf_bb(target_v);
                                (*bb).term.false_bb = lxf_bb(OPT_BB_NONE);
                                (*bb).term.unwind_bb = lxf_bb(OPT_BB_NONE);
                                mir_term_reset(mut_view((*bb).term.orig_term), MIR_TERM_GOTO, view(sp));
                                (*bb).term.orig_term.goto_target = MirBbId { v: target_v };
                            }
                            optir_record_provenance(
                                mut_view(*body),
                                mut_view(*arena),
                                PROP_NO_OVERFLOW,
                                CERTAINTY_PROVEN,
                                ANALYSIS_LOOP_INFO,
                                lxf_val(ov_v),
                                lxf_val(iv_val_v),
                                lxf_bb(bv),
                                OptInstId { v: OPT_INST_NONE },
                                PASS_IV_STRENGTH_REDUCE
                            );
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
}

pub fn opt_iv_strength_reduce(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let budget = loop_cost_budget_for_profile(pm.budget.profile);
    if !budget.allow_iv_sr {
        return false;
    }

    let contract = iv_strength_reduce_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let ex_snap = lxf_save_extra_snap(view(*body));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_stats = *stats;
    stats.pass_runs = stats.pass_runs + 1u32;

    let use_alias: *const AliasInfo = if (alias_info as usize) != 0 {
        alias_info
    } else {
        alias_build_info(view(*body), call_table, mut_view(*arena)) as *const AliasInfo
    };

    let tree = loops_discover(view(*body), call_table, use_alias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*tree) }, view(*body), use_alias, mut_view(*arena));

    let lcnt = unsafe { (*tree).loop_count };
    if lcnt == 0 {
        return false;
    }

    let mut changed = false;
    let mut li: usize = 0;
    while li < lcnt {
        let lp = unsafe { loop_desc_at((*tree).loops, li) };
        if !(unsafe { (*lp).is_irreducible }) &&
           (unsafe { (*lp).preheader.v }) != OPT_BB_NONE &&
           ((unsafe { (*lp).preheader.v }) as usize) < body.bb_count &&
           (unsafe { (*lp).iv_count }) > 0 {
            let mut k: usize = 0;
            while k < (unsafe { (*lp).block_count }) {
                let bb_v = unsafe { (*opt_bbid_at((*lp).blocks, k)).v };
                if (bb_v as usize) < body.bb_count {
                    let bb = unsafe { opt_block_at(body.blocks, bb_v as usize) };
                    let icnt = unsafe { (*bb).inst_count };
                    let mut i: usize = 0;
                    while i < icnt {
                        let inst = unsafe { opt_inst_at((*bb).insts, i) };
                        let opc = unsafe { (*inst).opcode };
                        let sop = unsafe { (*inst).sub_op };
                        let dlv = unsafe { (*inst).place.local.v };
                        let dpc = unsafe { (*inst).place.proj_count };
                        if (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP) &&
                           (sop == MIR_BINOP_MUL || sop == MIR_BINOP_WRAPPING_MUL) &&
                           dlv != 0u32 && dpc == 0 {
                            let lhs_v = lp_peel_copy(view(*body), lxf_val(unsafe { (*inst).lhs.v })).v;
                            let rhs_v = lp_peel_copy(view(*body), lxf_val(unsafe { (*inst).rhs.v })).v;
                            let mut iv_ptr = lxf_find_primary_iv_for_val(unsafe { view(*lp) }, view(*body), lxf_val(lhs_v));
                            let mut scale_v = rhs_v;
                            let mut iv_op_v = lhs_v;
                            if (iv_ptr as usize) == 0 {
                                iv_ptr = lxf_find_primary_iv_for_val(unsafe { view(*lp) }, view(*body), lxf_val(rhs_v));
                                scale_v = lhs_v;
                                iv_op_v = rhs_v;
                            }
                            let mut scale_u: u64 = 0u64;
                            let mut scale_i: i64 = 0i64;
                            if (iv_ptr as usize) != 0 &&
                               lp_val_const_int(view(*body), lxf_val(scale_v), mut_view(scale_u), mut_view(scale_i)) &&
                               scale_i > 1i64 {
                                let piv = unsafe { view(*iv_ptr) };
                                let phi_vp = unsafe { opt_val_at(body.values, piv.phi_val.v as usize) };
                                let iv_local = unsafe { (*phi_vp).src_local.v };
                                let mut step_bb = lxf_bb(OPT_BB_NONE);
                                let mut step_idx: usize = 0;
                                if iv_local != 0u32 && piv.step_const > 0i64 &&
                                   lxf_find_iv_step_site(unsafe { view(*lp) }, view(*body), iv_local, mut_view(step_bb), mut_view(step_idx)) &&
                                   (bb_v != step_bb.v || i < step_idx) &&
                                   opt_dominates(view(*body), lxf_bb(bb_v), lxf_bb(step_bb.v)) {
                                    let is_wrapping_mul = opc == OPT_INST_WRAPPING_BINOP || sop == MIR_BINOP_WRAPPING_MUL;
                                    let inst_ty_v = unsafe { (*inst).ty.v };
                                    let res_v = unsafe { (*inst).result.v };
                                    let mut init_u: u64 = 0u64;
                                    let mut stride_u: u64 = 0u64;
                                    let mut can_sr = false;
                                    let start_idx = piv.start_expr as usize;
                                    if is_wrapping_mul {
                                        if piv.start_expr != SCEV_IDX_NONE && start_idx < (unsafe { (*tree).scev_count }) {
                                            let st_ex = unsafe { scev_expr_at((*tree).scev_pool, start_idx) };
                                            if (unsafe { (*st_ex).kind }) == SCEV_CONST {
                                                let mut bits = opt_type_bits(body.thir, lxf_ty(inst_ty_v));
                                                if bits == 0u32 { bits = 64u32; }
                                                let mask = opt_bit_mask(bits);
                                                let start_u = (unsafe { (*st_ex).const_val }) as u64;
                                                let step_u = piv.step_const as u64;
                                                init_u = (start_u * scale_u) & mask;
                                                stride_u = (step_u * scale_u) & mask;
                                                can_sr = true;
                                            }
                                        }
                                    } else {
                                        if lxf_prove_mul_no_overflow_on_loop(
                                            unsafe { view(*tree) },
                                            unsafe { view(*lp) },
                                            view(*body),
                                            piv,
                                            scale_u,
                                            scale_i,
                                            lxf_ty(inst_ty_v),
                                            mut_view(init_u),
                                            mut_view(stride_u)
                                        ) {
                                            can_sr = true;
                                        }
                                    }

                                    if can_sr {
                                        let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                                        mir_span_copy(mut_view(sp), unsafe { view((*inst).orig_stmt.span) });
                                        let acc_v = lxf_add_fresh_local(mut_view(*body), mut_view(*arena), lxf_ty(inst_ty_v)).v;

                                        // 1. Initialize `acc_local = init_u` in `lp.preheader`
                                        let ph_v = unsafe { (*lp).preheader.v };
                                        let ph_bb = unsafe { opt_block_at(body.blocks, ph_v as usize) };
                                        let init_inst = lxf_make_const_int_inst(lxf_loc(acc_v), lxf_ty(inst_ty_v), init_u, view(sp), PASS_IV_STRENGTH_REDUCE);
                                        lxf_push_inst_to_block(unsafe { mut_view(*ph_bb) }, mut_view(*arena), init_inst);

                                        // 2. Replace `dlv = iv * scale` with `dlv = Copy(acc_local)`
                                        let cur_bb = unsafe { opt_block_at(body.blocks, bb_v as usize) };
                                        let cur_inst = unsafe { opt_inst_at((*cur_bb).insts, i) };
                                        let copy_inst = lxf_make_copy_inst(lxf_loc(dlv), lxf_loc(acc_v), lxf_ty(inst_ty_v), view(sp), PASS_IV_STRENGTH_REDUCE);
                                        unsafe {
                                            (*cur_inst).opcode = OPT_INST_COPY;
                                            (*cur_inst).sub_op = 0u8;
                                            (*cur_inst).rhs = lxf_val(OPT_VALUE_NONE);
                                            mir_copy_stmt(mut_view((*cur_inst).orig_stmt), view(copy_inst.orig_stmt));
                                        }

                                        // 3. If checked mul, fold its proven-safe dominating overflow assert if present
                                        if !is_wrapping_mul {
                                            lxf_try_fold_dominating_mul_overflow_assert(
                                                unsafe { view(*lp) },
                                                mut_view(*body),
                                                lxf_bb(bb_v),
                                                lxf_val(iv_op_v),
                                                scale_u,
                                                mut_view(*arena)
                                            );
                                            optir_record_provenance(
                                                mut_view(*body),
                                                mut_view(*arena),
                                                PROP_NO_OVERFLOW,
                                                CERTAINTY_PROVEN,
                                                ANALYSIS_LOOP_INFO,
                                                lxf_val(res_v),
                                                lxf_val(piv.phi_val.v),
                                                lxf_bb(bb_v),
                                                OptInstId { v: i as u32 },
                                                PASS_IV_STRENGTH_REDUCE
                                            );
                                        }

                                        // 4. Append `acc_local = acc_local +% stride_u` in `step_bb`
                                        let sbb = unsafe { opt_block_at(body.blocks, step_bb.v as usize) };
                                        let lhs_op = mir_op_copy_local(acc_v);
                                        let rhs_op = mir_op_const_int(inst_ty_v, stride_u);
                                        let add_op: u8 = if is_wrapping_mul { MIR_BINOP_WRAPPING_ADD } else { MIR_BINOP_ADD };
                                        let step_acc_inst = lxf_make_binop_inst(
                                            lxf_loc(acc_v), lxf_ty(inst_ty_v), add_op, is_wrapping_mul,
                                            view(lhs_op), view(rhs_op), view(sp), mut_view(*arena), PASS_IV_STRENGTH_REDUCE
                                        );
                                        lxf_push_inst_to_block(unsafe { mut_view(*sbb) }, mut_view(*arena), step_acc_inst);

                                        stats.iv_strength_reduced = stats.iv_strength_reduced + 1u32;
                                        lxf_push_record(
                                            mut_view(*stats), mut_view(*arena),
                                            PASS_IV_STRENGTH_REDUCE, LXF_KIND_IV_STRENGTH_REDUCE, true, CERTAINTY_PROVEN,
                                            lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                            lxf_val(res_v), lxf_val(piv.phi_val.v), stride_u,
                                            LXF_REASON_STRENGTH_REDUCED
                                        );
                                        changed = true;
                                    } else {
                                        stats.iv_blocked_overflow = stats.iv_blocked_overflow + 1u32;
                                        lxf_push_record(
                                            mut_view(*stats), mut_view(*arena),
                                            PASS_IV_STRENGTH_REDUCE, LXF_KIND_NONE, false, CERTAINTY_POSSIBLE,
                                            lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                            lxf_val(res_v), lxf_val(piv.phi_val.v), scale_u,
                                            LXF_REASON_OVERFLOW_UNPROVEN
                                        );
                                    }
                                }
                            }
                        } else if opc == OPT_INST_LOAD || opc == OPT_INST_STORE {
                            let pl: view<MirPlace> = if opc == OPT_INST_LOAD {
                                unsafe { view((*inst).rhs_place) }
                            } else {
                                unsafe { view((*inst).place) }
                            };
                            if pl.proj_count > 0 && (pl.projs as usize) != 0 &&
                               ((unsafe { (*lp).has_observable_barriers }) & BARRIER_STABLE_ADDR) == 0u16 {
                                let last_p = unsafe { mir_proj_at(pl.projs, pl.proj_count - 1) };
                                if (unsafe { (*last_p).kind }) == MIR_PROJ_INDEX {
                                    let idx_loc = unsafe { (*last_p).index_local.v };
                                    let mut iv_i: usize = 0;
                                    while iv_i < (unsafe { (*lp).iv_count }) {
                                        let iv = unsafe { loop_iv_at((*lp).ivs, iv_i) };
                                        let ssa_v = unsafe { (*iv).ssa_val.v };
                                        if ssa_v != OPT_VALUE_NONE && (ssa_v as usize) <= body.value_count {
                                            let svp = unsafe { opt_val_at(body.values, ssa_v as usize) };
                                            if (unsafe { (*svp).src_local.v }) == idx_loc && (unsafe { (*iv).no_wrap_proven }) {
                                                stats.iv_addr_evolutions = stats.iv_addr_evolutions + 1u32;
                                                lxf_push_record(
                                                    mut_view(*stats), mut_view(*arena),
                                                    PASS_IV_STRENGTH_REDUCE, LXF_KIND_IV_ADDR_EVOLUTION, true, CERTAINTY_PROVEN,
                                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(bb_v), i as u32,
                                                    lxf_val(ssa_v), lxf_val(unsafe { (*iv).phi_val.v }),
                                                    (unsafe { (*iv).scale_const }) as u64,
                                                    LXF_REASON_STRENGTH_REDUCED
                                                );
                                                break;
                                            }
                                        }
                                        iv_i = iv_i + 1;
                                    }
                                }
                            }
                        }
                        i = i + 1;
                    }
                }
                k = k + 1;
            }
        }
        li = li + 1;
    }

    if !changed {
        return false;
    }

    if !lxf_resync_opt_body(mut_view(*pm), mut_view(*body), call_table, use_alias, mut_view(*arena), mut_view(*sink)) {
        lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
        pm.ir_revision = pre_rev;
        pm.valid_analyses = pre_valid;
        lxf_copy_stats(mut_view(*stats), view(pre_stats));
        stats.pass_runs = pre_stats.pass_runs + 1u32;
        stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
        return false;
    }

    pm.ir_revision = pm.ir_revision + 1u32;
    stats.pass_changes = stats.pass_changes + 1u32;
    passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
    let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                    analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                    analysis_bit(ANALYSIS_LOOP_INFO);
    pm.valid_analyses = pm.valid_analyses | keep_mask;
    loops_stamp_valid_analysis_revs(mut_view(*pm));

    if pm.budget.verify_each {
        if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
            lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
            pm.ir_revision = pre_rev;
            pm.valid_analyses = pre_valid;
            lxf_copy_stats(mut_view(*stats), view(pre_stats));
            stats.pass_runs = pre_stats.pass_runs + 1u32;
            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
            return false;
        }
    }

    true
}


// --- 3. Loop Cloning & Peeling / Unswitching / Unrolling / Versioning (`AXS-LOOP-013..014`, `AXS-LXF-003..006`) ---

const LXF_BARRIER_ALL_MASK: u16 = BARRIER_VOLATILE | BARRIER_ATOMIC | BARRIER_IO |
                                  BARRIER_DROP | BARRIER_FFI | BARRIER_STABLE_ADDR |
                                  BARRIER_AWAIT | BARRIER_GPU_DOMAIN;

fn lxf_count_loop_active_insts(lp: view<LoopDesc>, body: view<OptBody>) -> u32 {
    let mut total: u32 = 0u32;
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                let flg = unsafe { (*inst).flags };
                if opc != OPT_INST_NOP && (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 {
                    total = total + 1u32;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    total
}

fn lxf_loop_has_call_term(lp: view<LoopDesc>, body: view<OptBody>) -> bool {
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) == OPT_TERM_CALL {
                return true;
            }
        }
        k = k + 1;
    }
    false
}

fn lxf_clone_loop_blocks(
    lp: view<LoopDesc>,
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    pass_id: u16
) -> *mut OptBbId {
    let orig_bb_cnt = body.bb_count;
    let map_cap = orig_bb_cnt + lp.block_count + 4;
    let clone_map = arena_alloc_raw(mut_view(*arena), lxf_mul_usize(map_cap, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
    let mut b: usize = 0;
    while b < map_cap {
        unsafe { *opt_bbid_at(clone_map, b) = OptBbId { v: b as u32 }; }
        b = b + 1;
    }

    let mut k: usize = 0;
    while k < lp.block_count {
        let orig_v = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        let orig_bb = unsafe { opt_block_at(body.blocks, orig_v as usize) };
        let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
        mir_span_copy(mut_view(sp), unsafe { view((*orig_bb).term.orig_term.location) });
        let new_id = lxf_append_goto_block(mut_view(*body), mut_view(*arena), OptBbId { v: 0u32 }, view(sp));
        unsafe { *opt_bbid_at(clone_map, orig_v as usize) = new_id; }
        k = k + 1;
    }

    k = 0;
    while k < lp.block_count {
        let orig_v = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        let new_v = unsafe { (*opt_bbid_at(clone_map, orig_v as usize)).v };
        let orig_bb = unsafe { opt_block_at(body.blocks, orig_v as usize) };
        let icnt = unsafe { (*orig_bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let orig_bb_cur = unsafe { opt_block_at(body.blocks, orig_v as usize) };
            let inst = unsafe { opt_inst_at((*orig_bb_cur).insts, i) };
            let opc = unsafe { (*inst).opcode };
            let flg = unsafe { (*inst).flags };
            let is_deleted = opc == OPT_INST_NOP && (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16;
            if !is_deleted {
                let cinst = lxf_clone_inst(unsafe { view(*inst) }, mut_view(*arena), pass_id);
                let new_bb_cur = unsafe { opt_block_at(body.blocks, new_v as usize) };
                lxf_push_inst_to_block(unsafe { mut_view(*new_bb_cur) }, mut_view(*arena), cinst);
            }
            i = i + 1;
        }

        let orig_bb2 = unsafe { opt_block_at(body.blocks, orig_v as usize) };
        let new_bb2 = unsafe { opt_block_at(body.blocks, new_v as usize) };
        let mut cterm = unsafe { (*orig_bb2).term };
        mir_copy_terminator(mut_view(cterm.orig_term), unsafe { view((*orig_bb2).term.orig_term) });
        cterm.origin.pass_id = pass_id;
        unsafe {
            (*new_bb2).term = cterm;
            (*new_bb2).has_term = (*orig_bb2).has_term;
        }

        // Remap all intra-loop successor edges in `new_bb2` through `clone_map`
        let mut m: usize = 0;
        while m < lp.block_count {
            let from_v = unsafe { (*opt_bbid_at(lp.blocks, m)).v };
            let to_v = unsafe { (*opt_bbid_at(clone_map, from_v as usize)).v };
            let new_bb3 = unsafe { opt_block_at(body.blocks, new_v as usize) };
            let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*new_bb3) }, mut_view(*arena), OptBbId { v: from_v }, OptBbId { v: to_v });
            m = m + 1;
        }
        k = k + 1;
    }

    clone_map
}

fn lxf_set_block_goto_target(bb: mut_view<OptBlock>, target: OptBbId) {
    let target_v = target.v;
    let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    mir_span_copy(mut_view(sp), view(bb.term.orig_term.location));
    bb.term.kind = OPT_TERM_GOTO;
    bb.term.cond = OptValueId { v: OPT_VALUE_NONE };
    bb.term.true_bb = OptBbId { v: target_v };
    bb.term.false_bb = OptBbId { v: OPT_BB_NONE };
    bb.term.otherwise_bb = OptBbId { v: OPT_BB_NONE };
    bb.term.unwind_bb = OptBbId { v: OPT_BB_NONE };
    bb.term.switch_count = 0;
    bb.term.call_arg_count = 0;
    mir_term_reset(mut_view(bb.term.orig_term), MIR_TERM_GOTO, view(sp));
    bb.term.orig_term.goto_target = MirBbId { v: target_v };
}

fn lxf_set_block_bool_branch(
    bb: mut_view<OptBlock>,
    arena: mut_view<Arena>,
    cond_local: MirLocalId,
    cond_val: OptValueId,
    true_bb: OptBbId,
    false_bb: OptBbId
) {
    let cond_loc_v = cond_local.v;
    let cond_val_v = cond_val.v;
    let true_v = true_bb.v;
    let false_v = false_bb.v;
    let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    mir_span_copy(mut_view(sp), view(bb.term.orig_term.location));
    let svals = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
    let stgts = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
    unsafe {
        *svals = 0u64;
        *stgts = MirBbId { v: false_v };
    }
    mir_term_reset(mut_view(bb.term.orig_term), MIR_TERM_SWITCH_INT, view(sp));
    bb.term.orig_term.discr = mir_op_copy_local(cond_loc_v);
    bb.term.orig_term.values = svals;
    bb.term.orig_term.targets = stgts;
    bb.term.orig_term.switch_count = 1;
    bb.term.orig_term.otherwise = MirBbId { v: true_v };

    bb.term.kind = OPT_TERM_BRANCH;
    bb.term.cond = OptValueId { v: cond_val_v };
    bb.term.true_bb = OptBbId { v: true_v };
    bb.term.false_bb = OptBbId { v: false_v };
    bb.term.otherwise_bb = OptBbId { v: OPT_BB_NONE };
    bb.term.unwind_bb = OptBbId { v: OPT_BB_NONE };
    bb.term.switch_count = 0;
}

// Check if loop `lp` benefits from first-iteration peeling (`k = 1`, `AXS-LOOP-013`, `AXS-LXF-003`):
// Specifically when the loop body contains either:
//  (a) an interior branch comparing primary IV `i == start` / `i != start` / `i > start` / `i <= start`, or
//  (b) a shifted index `i - 1` where peeling iteration `0` tightens the remaining loop start to `start + step`.
fn lxf_find_peel_candidate_branch_or_shift(
    tree: view<LoopTree>,
    lp: view<LoopDesc>,
    body: view<OptBody>,
    piv: view<InductionVar>,
    start_u: u64,
    out_branch_bb: mut_view<OptBbId>,
    out_first_takes_true: mut_view<bool>
) -> bool {
    *out_branch_bb = lxf_bb(OPT_BB_NONE);
    *out_first_takes_true = false;

    let phi_vp = unsafe { opt_val_at(body.values, piv.phi_val.v as usize) };
    let iv_loc = unsafe { (*phi_vp).src_local.v };
    let mut has_minus_one_shift = false;
    let mut iv_i: usize = 0;
    while iv_i < lp.iv_count {
        let iv = unsafe { loop_iv_at(lp.ivs, iv_i) };
        if !(unsafe { (*iv).is_primary }) && (unsafe { (*iv).phi_val.v }) == piv.phi_val.v {
            let off_idx = (unsafe { (*iv).offset_expr }) as usize;
            if (unsafe { (*iv).offset_expr }) != SCEV_IDX_NONE && off_idx < tree.scev_count {
                let oex = unsafe { scev_expr_at(tree.scev_pool, off_idx) };
                if (unsafe { (*oex).kind }) == SCEV_CONST && (unsafe { (*oex).const_val }) < 0i64 {
                    has_minus_one_shift = true;
                }
            }
        }
        iv_i = iv_i + 1;
    }

    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if bv != lp.header.v && (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            let mut cond_v = lxf_val(OPT_VALUE_NONE);
            let mut t_bb = lxf_bb(OPT_BB_NONE);
            let mut f_bb = lxf_bb(OPT_BB_NONE);
            if loops_extract_bool_branch(unsafe { view(*bb) }, mut_view(cond_v), mut_view(t_bb), mut_view(f_bb)) &&
               lp_block_in_set(lp.blocks, lp.block_count, t_bb.v) &&
               lp_block_in_set(lp.blocks, lp.block_count, f_bb.v) {
                let cinst = lp_find_def_inst(body, lxf_val(cond_v.v));
                if (cinst as usize) != 0 && (unsafe { (*cinst).opcode }) == OPT_INST_BINOP {
                    let bop = unsafe { (*cinst).sub_op };
                    let lhs = lp_peel_copy(body, lxf_val(unsafe { (*cinst).lhs.v }));
                    let rhs = lp_peel_copy(body, lxf_val(unsafe { (*cinst).rhs.v }));
                    let mut cu: u64 = 0u64;
                    let mut ci: i64 = 0i64;
                    let lhs_is_iv = lhs.v == piv.phi_val.v ||
                                    (lhs.v != OPT_VALUE_NONE && (lhs.v as usize) <= body.value_count &&
                                     (unsafe { (*opt_val_at(body.values, lhs.v as usize)).src_local.v }) == iv_loc);
                    if lhs_is_iv && lp_val_const_int(body, lxf_val(rhs.v), mut_view(cu), mut_view(ci)) && cu == start_u {
                        if bop == MIR_BINOP_EQ || bop == MIR_BINOP_LE {
                            *out_branch_bb = lxf_bb(bv);
                            *out_first_takes_true = true;
                            return true;
                        }
                        if bop == MIR_BINOP_NE || bop == MIR_BINOP_GT {
                            *out_branch_bb = lxf_bb(bv);
                            *out_first_takes_true = false;
                            return true;
                        }
                    }
                }
            }
        }
        k = k + 1;
    }

    has_minus_one_shift
}

pub fn opt_loop_peel(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let budget = loop_cost_budget_for_profile(pm.budget.profile);
    if !budget.allow_peeling {
        return false;
    }

    let contract = loop_peel_unroll_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let ex_snap = lxf_save_extra_snap(view(*body));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_stats = *stats;
    stats.pass_runs = stats.pass_runs + 1u32;

    let use_alias: *const AliasInfo = if (alias_info as usize) != 0 {
        alias_info
    } else {
        alias_build_info(view(*body), call_table, mut_view(*arena)) as *const AliasInfo
    };

    let tree = loops_discover(view(*body), call_table, use_alias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*tree) }, view(*body), use_alias, mut_view(*arena));

    let lcnt = unsafe { (*tree).loop_count };
    let mut li: usize = 0;
    while li < lcnt {
        let lp = unsafe { loop_desc_at((*tree).loops, li) };
        if !(unsafe { (*lp).is_irreducible }) &&
           (unsafe { (*lp).preheader.v }) != OPT_BB_NONE &&
           (unsafe { (*lp).latch_count }) == 1 &&
           (unsafe { (*lp).exit_count }) == 1 &&
           (unsafe { (*lp).exiting_count }) == 1 &&
           (unsafe { (*lp).iv_count }) > 0 &&
           (unsafe { (*lp).block_count }) <= 8 &&
           ((unsafe { (*lp).has_observable_barriers }) & LXF_BARRIER_ALL_MASK) == 0u16 &&
           !lxf_loop_has_call_term(unsafe { view(*lp) }, view(*body)) {
            let piv = unsafe { loop_iv_at((*lp).ivs, 0) };
            let start_idx = (unsafe { (*piv).start_expr }) as usize;
            if (unsafe { (*piv).is_primary }) &&
               (unsafe { (*piv).no_wrap_proven }) &&
               (unsafe { (*piv).step_const }) > 0i64 &&
               (unsafe { (*piv).start_expr }) != SCEV_IDX_NONE &&
               start_idx < (unsafe { (*tree).scev_count }) {
                let st_ex = unsafe { scev_expr_at((*tree).scev_pool, start_idx) };
                if (unsafe { (*st_ex).kind }) == SCEV_CONST {
                    let start_u = (unsafe { (*st_ex).const_val }) as u64;
                    let step_u = (unsafe { (*piv).step_const }) as u64;
                    let next_start_u = start_u + step_u;
                    let mut br_bb = lxf_bb(OPT_BB_NONE);
                    let mut first_true = false;
                    if lxf_find_peel_candidate_branch_or_shift(
                        unsafe { view(*tree) },
                        unsafe { view(*lp) },
                        view(*body),
                        unsafe { view(*piv) },
                        start_u,
                        mut_view(br_bb),
                        mut_view(first_true)
                    ) {
                        let ph_v = unsafe { (*lp).preheader.v };
                        let hdr_v = unsafe { (*lp).header.v };
                        let latch_v = unsafe { (*opt_bbid_at((*lp).latches, 0)).v };
                        let phi_vp = unsafe { opt_val_at(body.values, (*piv).phi_val.v as usize) };
                        let iv_loc_v = unsafe { (*phi_vp).src_local.v };
                        let iv_ty_v = unsafe { (*phi_vp).ty.v };

                        let clone_map = lxf_clone_loop_blocks(unsafe { view(*lp) }, mut_view(*body), mut_view(*arena), PASS_LOOP_PEEL_UNROLL);
                        let peel_hdr_v = unsafe { (*opt_bbid_at(clone_map, hdr_v as usize)).v };
                        let peel_latch_v = unsafe { (*opt_bbid_at(clone_map, latch_v as usize)).v };

                        // 1. Redirect preheader `ph_id -> peel_hdr`
                        let ph_bb = unsafe { opt_block_at(body.blocks, ph_v as usize) };
                        let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*ph_bb) }, mut_view(*arena), lxf_bb(hdr_v), lxf_bb(peel_hdr_v));

                        // 2. Redirect `peel_latch`'s backedge `peel_hdr -> hdr_id` and stamp `iv_local = next_start_u`
                        let pl_bb = unsafe { opt_block_at(body.blocks, peel_latch_v as usize) };
                        let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*pl_bb) }, mut_view(*arena), lxf_bb(peel_hdr_v), lxf_bb(hdr_v));
                        let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                        mir_span_copy(mut_view(sp), unsafe { view((*pl_bb).term.orig_term.location) });
                        let set_next_inst = lxf_make_const_int_inst(lxf_loc(iv_loc_v), lxf_ty(iv_ty_v), next_start_u, view(sp), PASS_LOOP_PEEL_UNROLL);
                        lxf_push_inst_to_block(unsafe { mut_view(*pl_bb) }, mut_view(*arena), set_next_inst);

                        // 3. If an interior first-iteration branch `br_bb` was found, fold it in both peeled & remaining loops!
                        if br_bb.v != OPT_BB_NONE {
                            let peel_br_v = unsafe { (*opt_bbid_at(clone_map, br_bb.v as usize)).v };
                            let orig_br_bb = unsafe { opt_block_at(body.blocks, br_bb.v as usize) };
                            let peel_br_bb = unsafe { opt_block_at(body.blocks, peel_br_v as usize) };
                            let mut dc = lxf_val(OPT_VALUE_NONE);
                            let mut orig_t = lxf_bb(OPT_BB_NONE);
                            let mut orig_f = lxf_bb(OPT_BB_NONE);
                            let mut peel_t = lxf_bb(OPT_BB_NONE);
                            let mut peel_f = lxf_bb(OPT_BB_NONE);
                            if loops_extract_bool_branch(unsafe { view(*orig_br_bb) }, mut_view(dc), mut_view(orig_t), mut_view(orig_f)) &&
                               loops_extract_bool_branch(unsafe { view(*peel_br_bb) }, mut_view(dc), mut_view(peel_t), mut_view(peel_f)) {
                                let peel_target_v = if first_true { peel_t.v } else { peel_f.v };
                                let rem_target_v = if first_true { orig_f.v } else { orig_t.v };
                                lxf_set_block_goto_target(unsafe { mut_view(*peel_br_bb) }, lxf_bb(peel_target_v));
                                lxf_set_block_goto_target(unsafe { mut_view(*orig_br_bb) }, lxf_bb(rem_target_v));
                            }
                        }

                        if !lxf_resync_opt_body(mut_view(*pm), mut_view(*body), call_table, use_alias, mut_view(*arena), mut_view(*sink)) {
                            lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                            pm.ir_revision = pre_rev;
                            pm.valid_analyses = pre_valid;
                            lxf_copy_stats(mut_view(*stats), view(pre_stats));
                            stats.pass_runs = pre_stats.pass_runs + 1u32;
                            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                            return false;
                        }

                        stats.loops_peeled = stats.loops_peeled + 1u32;
                        lxf_push_record(
                            mut_view(*stats), mut_view(*arena),
                            PASS_LOOP_PEEL_UNROLL, LXF_KIND_LOOP_PEEL, true, CERTAINTY_PROVEN,
                            lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(hdr_v), 0u32,
                            lxf_val(unsafe { (*piv).phi_val.v }), lxf_val(OPT_VALUE_NONE), 1u64,
                            LXF_REASON_PEELED_FIRST_ITER
                        );

                        pm.ir_revision = pm.ir_revision + 1u32;
                        stats.pass_changes = stats.pass_changes + 1u32;
                        passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
                        let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                                        analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                                        analysis_bit(ANALYSIS_LOOP_INFO);
                        pm.valid_analyses = pm.valid_analyses | keep_mask;
                        loops_stamp_valid_analysis_revs(mut_view(*pm));

                        if pm.budget.verify_each {
                            if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
                                lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                pm.ir_revision = pre_rev;
                                pm.valid_analyses = pre_valid;
                                lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                stats.pass_runs = pre_stats.pass_runs + 1u32;
                                stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                return false;
                            }
                        }
                        return true;
                    }
                }
            }
        }
        li = li + 1;
    }

    false
}

// --- 4. Loop Unswitching (`opt_loop_unswitch`, AXS-LOOP-013, AXS-LXF-004, REQ-OPT-171) ---

pub fn opt_loop_unswitch(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let budget = loop_cost_budget_for_profile(pm.budget.profile);
    if !budget.allow_unswitching {
        return false;
    }

    let contract = loop_unswitch_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let ex_snap = lxf_save_extra_snap(view(*body));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_stats = *stats;
    stats.pass_runs = stats.pass_runs + 1u32;

    let use_alias: *const AliasInfo = if (alias_info as usize) != 0 {
        alias_info
    } else {
        alias_build_info(view(*body), call_table, mut_view(*arena)) as *const AliasInfo
    };

    let tree = loops_discover(view(*body), call_table, use_alias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*tree) }, view(*body), use_alias, mut_view(*arena));

    let lcnt = unsafe { (*tree).loop_count };
    let mut li: usize = 0;
    while li < lcnt {
        let lp = unsafe { loop_desc_at((*tree).loops, li) };
        if !(unsafe { (*lp).is_irreducible }) &&
           (unsafe { (*lp).preheader.v }) != OPT_BB_NONE &&
           ((unsafe { (*lp).block_count }) as u32) <= budget.max_unswitch_block_count &&
           ((unsafe { (*lp).has_observable_barriers }) & LXF_BARRIER_ALL_MASK) == 0u16 &&
           !lxf_loop_has_call_term(unsafe { view(*lp) }, view(*body)) {
            let ph_v = unsafe { (*lp).preheader.v };
            let hdr_v = unsafe { (*lp).header.v };
            let ph_bb_chk = unsafe { opt_block_at(body.blocks, ph_v as usize) };
            if (unsafe { (*ph_bb_chk).has_term }) && (unsafe { (*ph_bb_chk).term.kind }) == OPT_TERM_GOTO {
                let mut k: usize = 0;
                while k < (unsafe { (*lp).block_count }) {
                    let ub_v = unsafe { (*opt_bbid_at((*lp).blocks, k)).v };
                    if ub_v != hdr_v && (ub_v as usize) < body.bb_count {
                        let ubb = unsafe { opt_block_at(body.blocks, ub_v as usize) };
                        let mut cond_val = lxf_val(OPT_VALUE_NONE);
                        let mut t_bb = lxf_bb(OPT_BB_NONE);
                        let mut f_bb = lxf_bb(OPT_BB_NONE);
                        if loops_extract_bool_branch(unsafe { view(*ubb) }, mut_view(cond_val), mut_view(t_bb), mut_view(f_bb)) &&
                           t_bb.v != f_bb.v &&
                           lp_block_in_set(unsafe { (*lp).blocks }, unsafe { (*lp).block_count }, t_bb.v) &&
                           lp_block_in_set(unsafe { (*lp).blocks }, unsafe { (*lp).block_count }, f_bb.v) &&
                           loops_is_val_invariant(unsafe { view(*lp) }, view(*body), use_alias, lxf_val(cond_val.v)) {
                            let discr_op = unsafe { view((*ubb).term.orig_term.discr) };
                            let discr_loc_v = discr_op.place.local.v;
                            if (discr_op.kind == MIR_OP_COPY || discr_op.kind == MIR_OP_MOVE) &&
                               discr_op.place.proj_count == 0 &&
                               discr_loc_v != 0u32 &&
                               !loops_local_written_in_loop(unsafe { view(*lp) }, view(*body), use_alias, discr_loc_v) {
                                let clone_map = lxf_clone_loop_blocks(unsafe { view(*lp) }, mut_view(*body), mut_view(*arena), PASS_LOOP_UNSWITCH);
                                let false_hdr_v = unsafe { (*opt_bbid_at(clone_map, hdr_v as usize)).v };
                                let false_ub_v = unsafe { (*opt_bbid_at(clone_map, ub_v as usize)).v };
                                let false_target_v = unsafe { (*opt_bbid_at(clone_map, f_bb.v as usize)).v };

                                // Specialize original loop (`true` arm) and cloned loop (`false` arm)
                                let ubb_true = unsafe { opt_block_at(body.blocks, ub_v as usize) };
                                lxf_set_block_goto_target(unsafe { mut_view(*ubb_true) }, lxf_bb(t_bb.v));
                                let ubb_false = unsafe { opt_block_at(body.blocks, false_ub_v as usize) };
                                lxf_set_block_goto_target(unsafe { mut_view(*ubb_false) }, lxf_bb(false_target_v));

                                // Hoist loop-invariant branch to `lp.preheader`
                                let ph_bb = unsafe { opt_block_at(body.blocks, ph_v as usize) };
                                lxf_set_block_bool_branch(
                                    unsafe { mut_view(*ph_bb) },
                                    mut_view(*arena),
                                    lxf_loc(discr_loc_v),
                                    lxf_val(cond_val.v),
                                    lxf_bb(hdr_v),
                                    lxf_bb(false_hdr_v)
                                );

                                if !lxf_resync_opt_body(mut_view(*pm), mut_view(*body), call_table, use_alias, mut_view(*arena), mut_view(*sink)) {
                                    lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                    passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                    pm.ir_revision = pre_rev;
                                    pm.valid_analyses = pre_valid;
                                    lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                    stats.pass_runs = pre_stats.pass_runs + 1u32;
                                    stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                    return false;
                                }

                                stats.loops_unswitched = stats.loops_unswitched + 1u32;
                                lxf_push_record(
                                    mut_view(*stats), mut_view(*arena),
                                    PASS_LOOP_UNSWITCH, LXF_KIND_LOOP_UNSWITCH, true, CERTAINTY_PROVEN,
                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(ub_v), 0u32,
                                    lxf_val(cond_val.v), lxf_val(OPT_VALUE_NONE), 2u64,
                                    LXF_REASON_UNSWITCHED_INVARIANT
                                );

                                pm.ir_revision = pm.ir_revision + 1u32;
                                stats.pass_changes = stats.pass_changes + 1u32;
                                passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
                                let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                                                analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                                                analysis_bit(ANALYSIS_LOOP_INFO);
                                pm.valid_analyses = pm.valid_analyses | keep_mask;
                                loops_stamp_valid_analysis_revs(mut_view(*pm));

                                if pm.budget.verify_each {
                                    if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
                                        lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                        pm.ir_revision = pre_rev;
                                        pm.valid_analyses = pre_valid;
                                        lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                        stats.pass_runs = pre_stats.pass_runs + 1u32;
                                        stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                        return false;
                                    }
                                }
                                return true;
                            }
                        }
                    }
                    k = k + 1;
                }
            }
        }
        li = li + 1;
    }

    false
}

// --- 5. Cost-Bounded Full & Partial Loop Unrolling (`opt_loop_unroll`, AXS-LOOP-013, AXS-LXF-005) ---

pub fn opt_loop_unroll(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let budget = loop_cost_budget_for_profile(pm.budget.profile);
    if !budget.allow_full_unroll && !budget.allow_partial_unroll {
        return false;
    }

    let contract = loop_peel_unroll_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let ex_snap = lxf_save_extra_snap(view(*body));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_stats = *stats;
    stats.pass_runs = stats.pass_runs + 1u32;

    let use_alias: *const AliasInfo = if (alias_info as usize) != 0 {
        alias_info
    } else {
        alias_build_info(view(*body), call_table, mut_view(*arena)) as *const AliasInfo
    };

    let tree = loops_discover(view(*body), call_table, use_alias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*tree) }, view(*body), use_alias, mut_view(*arena));

    let lcnt = unsafe { (*tree).loop_count };
    let mut max_d: u32 = 0u32;
    let mut li: usize = 0;
    while li < lcnt {
        let ld = unsafe { (*loop_desc_at((*tree).loops, li)).depth };
        if ld > max_d {
            max_d = ld;
        }
        li = li + 1;
    }

    // Transform innermost eligible loop first
    let mut d_iter: u32 = max_d + 1u32;
    while d_iter > 1u32 {
        d_iter = d_iter - 1u32;
        li = 0;
        while li < lcnt {
            let lp = unsafe { loop_desc_at((*tree).loops, li) };
            if !(unsafe { (*lp).is_irreducible }) &&
               (unsafe { (*lp).depth }) == d_iter &&
               (unsafe { (*lp).child_count }) == 0 &&
               (unsafe { (*lp).preheader.v }) != OPT_BB_NONE &&
               (unsafe { (*lp).latch_count }) == 1 &&
               (unsafe { (*lp).exit_count }) == 1 &&
               (unsafe { (*lp).exiting_count }) == 1 &&
               ((unsafe { (*lp).has_observable_barriers }) & LXF_BARRIER_ALL_MASK) == 0u16 &&
               !lxf_loop_has_call_term(unsafe { view(*lp) }, view(*body)) {
                let hdr_v = unsafe { (*lp).header.v };
                let latch_v = unsafe { (*opt_bbid_at((*lp).latches, 0)).v };
                let exit_v = unsafe { (*opt_bbid_at((*lp).exit_blocks, 0)).v };
                let exiting_v = unsafe { (*opt_bbid_at((*lp).exiting_blocks, 0)).v };
                if exiting_v == hdr_v && hdr_v != latch_v {
                    let hbb = unsafe { opt_block_at(body.blocks, hdr_v as usize) };
                    let mut cond_val = lxf_val(OPT_VALUE_NONE);
                    let mut t_bb = lxf_bb(OPT_BB_NONE);
                    let mut f_bb = lxf_bb(OPT_BB_NONE);
                    if loops_extract_bool_branch(unsafe { view(*hbb) }, mut_view(cond_val), mut_view(t_bb), mut_view(f_bb)) {
                        let t_in = lp_block_in_set(unsafe { (*lp).blocks }, unsafe { (*lp).block_count }, t_bb.v);
                        let f_in = lp_block_in_set(unsafe { (*lp).blocks }, unsafe { (*lp).block_count }, f_bb.v);
                        if t_in != f_in {
                            let body_entry_v: u32 = if t_in { t_bb.v } else { f_bb.v };
                            let inst_cnt = lxf_count_loop_active_insts(unsafe { view(*lp) }, view(*body));
                            let tk = unsafe { (*lp).trip_count.kind };
                            let tc = unsafe { (*lp).trip_count.const_iters };
                            let cert = unsafe { (*lp).trip_count.certainty };

                            // Case A: Exact Constant Trip Count Full Unrolling (`AXS-LXF-005`, `REQ-OPT-169`)
                            if budget.allow_full_unroll && tk == TRIP_CONST && cert == CERTAINTY_PROVEN &&
                               tc <= budget.max_full_unroll_trip &&
                               (tc * (inst_cnt as u64)) <= (budget.max_full_unroll_insts as u64) {
                                if tc == 0u64 {
                                    let hbb0 = unsafe { opt_block_at(body.blocks, hdr_v as usize) };
                                    lxf_set_block_goto_target(unsafe { mut_view(*hbb0) }, lxf_bb(exit_v));
                                } else {
                                    let hbb0 = unsafe { opt_block_at(body.blocks, hdr_v as usize) };
                                    lxf_set_block_goto_target(unsafe { mut_view(*hbb0) }, lxf_bb(body_entry_v));
                                    let mut first_iter_hdr_v = exit_v;
                                    let mut prev_latch_v = latch_v;
                                    let mut prev_hdr_v = hdr_v;
                                    let mut iter: u64 = 1u64;
                                    while iter < tc {
                                        let cmap = lxf_clone_loop_blocks(unsafe { view(*lp) }, mut_view(*body), mut_view(*arena), PASS_LOOP_PEEL_UNROLL);
                                        let iter_hdr_v = unsafe { (*opt_bbid_at(cmap, hdr_v as usize)).v };
                                        let iter_body_v = unsafe { (*opt_bbid_at(cmap, body_entry_v as usize)).v };
                                        let iter_latch_v = unsafe { (*opt_bbid_at(cmap, latch_v as usize)).v };

                                        let ih_bb = unsafe { opt_block_at(body.blocks, iter_hdr_v as usize) };
                                        lxf_set_block_goto_target(unsafe { mut_view(*ih_bb) }, lxf_bb(iter_body_v));

                                        if iter == 1u64 {
                                            first_iter_hdr_v = iter_hdr_v;
                                        } else {
                                            let pl_bb = unsafe { opt_block_at(body.blocks, prev_latch_v as usize) };
                                            let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*pl_bb) }, mut_view(*arena), lxf_bb(prev_hdr_v), lxf_bb(iter_hdr_v));
                                        }

                                        prev_latch_v = iter_latch_v;
                                        prev_hdr_v = iter_hdr_v;
                                        iter = iter + 1u64;
                                    }
                                    if tc > 1u64 {
                                        let orig_lbb = unsafe { opt_block_at(body.blocks, latch_v as usize) };
                                        let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*orig_lbb) }, mut_view(*arena), lxf_bb(hdr_v), lxf_bb(first_iter_hdr_v));
                                    }
                                    let last_lbb = unsafe { opt_block_at(body.blocks, prev_latch_v as usize) };
                                    let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*last_lbb) }, mut_view(*arena), lxf_bb(prev_hdr_v), lxf_bb(exit_v));
                                }

                                if !lxf_resync_opt_body(mut_view(*pm), mut_view(*body), call_table, use_alias, mut_view(*arena), mut_view(*sink)) {
                                    lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                    passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                    pm.ir_revision = pre_rev;
                                    pm.valid_analyses = pre_valid;
                                    lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                    stats.pass_runs = pre_stats.pass_runs + 1u32;
                                    stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                    return false;
                                }

                                stats.loops_unrolled_full = stats.loops_unrolled_full + 1u32;
                                lxf_push_record(
                                    mut_view(*stats), mut_view(*arena),
                                    PASS_LOOP_PEEL_UNROLL, LXF_KIND_LOOP_UNROLL_FULL, true, CERTAINTY_PROVEN,
                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(hdr_v), 0u32,
                                    lxf_val(cond_val.v), lxf_val(OPT_VALUE_NONE), tc,
                                    LXF_REASON_UNROLLED_CONST_TRIP
                                );

                                pm.ir_revision = pm.ir_revision + 1u32;
                                stats.pass_changes = stats.pass_changes + 1u32;
                                passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
                                let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                                                analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                                                analysis_bit(ANALYSIS_LOOP_INFO);
                                pm.valid_analyses = pm.valid_analyses | keep_mask;
                                loops_stamp_valid_analysis_revs(mut_view(*pm));

                                if pm.budget.verify_each {
                                    if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
                                        lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                        pm.ir_revision = pre_rev;
                                        pm.valid_analyses = pre_valid;
                                        lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                        stats.pass_runs = pre_stats.pass_runs + 1u32;
                                        stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                        return false;
                                    }
                                }
                                return true;
                            }

                            // Case B: Cost-Bounded Partial Unrolling by factor U = 2 (`AXS-LXF-005`, `REQ-OPT-170`)
                            if budget.allow_partial_unroll &&
                               budget.max_partial_unroll_factor >= 2u32 &&
                               (inst_cnt * 2u32) <= budget.max_full_unroll_insts &&
                               tk == TRIP_CONST && cert == CERTAINTY_PROVEN &&
                               tc > budget.max_full_unroll_trip && (tc & 1u64) == 0u64 {
                                let cmap = lxf_clone_loop_blocks(unsafe { view(*lp) }, mut_view(*body), mut_view(*arena), PASS_LOOP_PEEL_UNROLL);
                                let second_hdr_v = unsafe { (*opt_bbid_at(cmap, hdr_v as usize)).v };
                                let second_body_v = unsafe { (*opt_bbid_at(cmap, body_entry_v as usize)).v };
                                let second_latch_v = unsafe { (*opt_bbid_at(cmap, latch_v as usize)).v };

                                // Since `tc` is proven even, `second_hdr` is unconditionally entered after iteration `2k`
                                let sh_bb = unsafe { opt_block_at(body.blocks, second_hdr_v as usize) };
                                lxf_set_block_goto_target(unsafe { mut_view(*sh_bb) }, lxf_bb(second_body_v));

                                // First latch chains into `second_hdr`; `second_latch` jumps back to `hdr_id`
                                let l0_bb = unsafe { opt_block_at(body.blocks, latch_v as usize) };
                                let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*l0_bb) }, mut_view(*arena), lxf_bb(hdr_v), lxf_bb(second_hdr_v));
                                let l1_bb = unsafe { opt_block_at(body.blocks, second_latch_v as usize) };
                                let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*l1_bb) }, mut_view(*arena), lxf_bb(second_hdr_v), lxf_bb(hdr_v));

                                if !lxf_resync_opt_body(mut_view(*pm), mut_view(*body), call_table, use_alias, mut_view(*arena), mut_view(*sink)) {
                                    lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                    passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                    pm.ir_revision = pre_rev;
                                    pm.valid_analyses = pre_valid;
                                    lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                    stats.pass_runs = pre_stats.pass_runs + 1u32;
                                    stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                    return false;
                                }

                                stats.loops_unrolled_partial = stats.loops_unrolled_partial + 1u32;
                                lxf_push_record(
                                    mut_view(*stats), mut_view(*arena),
                                    PASS_LOOP_PEEL_UNROLL, LXF_KIND_LOOP_UNROLL_PARTIAL, true, CERTAINTY_PROVEN,
                                    lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(hdr_v), 0u32,
                                    lxf_val(cond_val.v), lxf_val(OPT_VALUE_NONE), 2u64,
                                    LXF_REASON_UNROLLED_PARTIAL
                                );

                                pm.ir_revision = pm.ir_revision + 1u32;
                                stats.pass_changes = stats.pass_changes + 1u32;
                                passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
                                let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                                                analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                                                analysis_bit(ANALYSIS_LOOP_INFO);
                                pm.valid_analyses = pm.valid_analyses | keep_mask;
                                loops_stamp_valid_analysis_revs(mut_view(*pm));

                                if pm.budget.verify_each {
                                    if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
                                        lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                        pm.ir_revision = pre_rev;
                                        pm.valid_analyses = pre_valid;
                                        lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                        stats.pass_runs = pre_stats.pass_runs + 1u32;
                                        stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                        return false;
                                    }
                                }
                                return true;
                            }
                        }
                    }
                }
            }
            li = li + 1;
        }
    }

    false
}

// --- 6. Loop Versioning with Pure Preheader Guards (`opt_loop_version`, AXS-LOOP-014, AXS-LXF-006) ---

fn lxf_find_versionable_bounds_assert(
    tree: view<LoopTree>,
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    out_assert_bb: mut_view<OptBbId>,
    out_bound_local: mut_view<MirLocalId>,
    out_len_place: mut_view<MirPlace>,
    out_len_ty: mut_view<TypeId>,
    out_bool_ty: mut_view<TypeId>
) -> bool {
    if lp.iv_count == 0 || (lp.ivs as usize) == 0 {
        return false;
    }
    let piv = unsafe { loop_iv_at(lp.ivs, 0) };
    if !(unsafe { (*piv).is_primary }) || (unsafe { (*piv).step_const }) != 1i64 {
        return false;
    }
    let start_idx = (unsafe { (*piv).start_expr }) as usize;
    if (unsafe { (*piv).start_expr }) == SCEV_IDX_NONE || start_idx >= tree.scev_count {
        return false;
    }
    let st_ex = unsafe { scev_expr_at(tree.scev_pool, start_idx) };
    if (unsafe { (*st_ex).kind }) != SCEV_CONST || (unsafe { (*st_ex).const_val }) != 0i64 {
        return false;
    }

    // Extract symbolic upper bound local `bound_loc` from header `i < bound_loc`
    let hbb = unsafe { opt_block_at(body.blocks, lp.header.v as usize) };
    let mut hcond = lxf_val(OPT_VALUE_NONE);
    let mut ht = lxf_bb(OPT_BB_NONE);
    let mut hf = lxf_bb(OPT_BB_NONE);
    if !loops_extract_bool_branch(unsafe { view(*hbb) }, mut_view(hcond), mut_view(ht), mut_view(hf)) {
        return false;
    }
    let hc_inst = lp_find_def_inst(body, lxf_val(hcond.v));
    if (hc_inst as usize) == 0 || (unsafe { (*hc_inst).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*hc_inst).sub_op }) != MIR_BINOP_LT {
        return false;
    }
    let bnd_val = lp_peel_copy(body, lxf_val(unsafe { (*hc_inst).rhs.v }));
    if bnd_val.v == OPT_VALUE_NONE || (bnd_val.v as usize) > body.value_count ||
       !loops_is_val_invariant(lp, body, info, lxf_val(bnd_val.v)) {
        return false;
    }
    let bnd_vp = unsafe { opt_val_at(body.values, bnd_val.v as usize) };
    let bnd_loc_v = unsafe { (*bnd_vp).src_local.v };
    if bnd_loc_v == 0u32 || loops_local_written_in_loop(lp, body, info, bnd_loc_v) {
        return false;
    }
    let phi_vp = unsafe { opt_val_at(body.values, (*piv).phi_val.v as usize) };
    let iv_loc_v = unsafe { (*phi_vp).src_local.v };

    // Scan loop blocks for an `OPT_TERM_ASSERT` checking `iv < len(container)`
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) == OPT_TERM_ASSERT &&
               (unsafe { (*bb).term.assert_expected }) {
                let acond = lp_peel_copy(body, lxf_val(unsafe { (*bb).term.cond.v }));
                let ac_inst = lp_find_def_inst(body, lxf_val(acond.v));
                if (ac_inst as usize) != 0 && (unsafe { (*ac_inst).opcode }) == OPT_INST_BINOP &&
                   (unsafe { (*ac_inst).sub_op }) == MIR_BINOP_LT {
                    let alhs = lp_peel_copy(body, lxf_val(unsafe { (*ac_inst).lhs.v }));
                    let arhs = lp_peel_copy(body, lxf_val(unsafe { (*ac_inst).rhs.v }));
                    let len_inst = lp_find_def_inst(body, lxf_val(arhs.v));
                    if alhs.v != OPT_VALUE_NONE && (alhs.v as usize) <= body.value_count &&
                       (len_inst as usize) != 0 && (unsafe { (*len_inst).opcode }) == OPT_INST_LEN {
                        let al_vp = unsafe { opt_val_at(body.values, alhs.v as usize) };
                        let len_pl = unsafe { view((*len_inst).rhs_place) };
                        if (unsafe { (*al_vp).src_local.v }) == iv_loc_v &&
                           len_pl.local.v != 0u32 &&
                           !loops_local_written_in_loop(lp, body, info, len_pl.local.v) {
                            *out_assert_bb = lxf_bb(bv);
                            *out_bound_local = lxf_loc(bnd_loc_v);
                            mir_copy_place(out_len_place, len_pl);
                            *out_len_ty = lxf_ty(unsafe { (*len_inst).ty.v });
                            *out_bool_ty = lxf_ty(unsafe { (*ac_inst).ty.v });
                            return true;
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    false
}

pub fn opt_loop_version(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let budget = loop_cost_budget_for_profile(pm.budget.profile);
    if !budget.allow_versioning {
        return false;
    }

    let contract = loop_version_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let ex_snap = lxf_save_extra_snap(view(*body));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_stats = *stats;
    stats.pass_runs = stats.pass_runs + 1u32;

    let use_alias: *const AliasInfo = if (alias_info as usize) != 0 {
        alias_info
    } else {
        alias_build_info(view(*body), call_table, mut_view(*arena)) as *const AliasInfo
    };

    let tree = loops_discover(view(*body), call_table, use_alias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*tree) }, view(*body), use_alias, mut_view(*arena));

    let lcnt = unsafe { (*tree).loop_count };
    let mut li: usize = 0;
    while li < lcnt {
        let lp = unsafe { loop_desc_at((*tree).loops, li) };
        if !(unsafe { (*lp).is_irreducible }) &&
           (unsafe { (*lp).preheader.v }) != OPT_BB_NONE &&
           ((unsafe { (*lp).block_count }) as u32) <= budget.max_version_block_count &&
           ((unsafe { (*lp).has_observable_barriers }) & LXF_BARRIER_ALL_MASK) == 0u16 &&
           !lxf_loop_has_call_term(unsafe { view(*lp) }, view(*body)) {
            let ph_v = unsafe { (*lp).preheader.v };
            let hdr_v = unsafe { (*lp).header.v };
            let ph_bb_chk = unsafe { opt_block_at(body.blocks, ph_v as usize) };
            if (unsafe { (*ph_bb_chk).has_term }) && (unsafe { (*ph_bb_chk).term.kind }) == OPT_TERM_GOTO {
                let mut assert_bb = lxf_bb(OPT_BB_NONE);
                let mut bound_loc = lxf_loc(0u32);
                let mut len_place = mir_local_place(0u32);
                let mut len_ty = lxf_ty(0u32);
                let mut bool_ty = lxf_ty(0u32);
                if lxf_find_versionable_bounds_assert(
                    unsafe { view(*tree) },
                    unsafe { view(*lp) },
                    view(*body),
                    use_alias,
                    mut_view(assert_bb),
                    mut_view(bound_loc),
                    mut_view(len_place),
                    mut_view(len_ty),
                    mut_view(bool_ty)
                ) {
                    let len_ty_v = len_ty.v;
                    let bool_ty_v = bool_ty.v;
                    let assert_bb_v = assert_bb.v;
                    let bound_loc_v = bound_loc.v;
                    let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                    mir_span_copy(mut_view(sp), unsafe { view((*ph_bb_chk).term.orig_term.location) });

                    // 1. Allocate fresh locals for `len_tmp = Len(len_place)` and `guard_local = bound_loc <= len_tmp`
                    let len_loc_v = lxf_add_fresh_local(mut_view(*body), mut_view(*arena), lxf_ty(len_ty_v)).v;
                    let guard_loc_v = lxf_add_fresh_local(mut_view(*body), mut_view(*arena), lxf_ty(bool_ty_v)).v;

                    // 2. Clone loop `lp` into the exact fallback loop BEFORE modifying the fast path
                    let cmap = lxf_clone_loop_blocks(unsafe { view(*lp) }, mut_view(*body), mut_view(*arena), PASS_LOOP_VERSION);
                    let fallback_hdr_v = unsafe { (*opt_bbid_at(cmap, hdr_v as usize)).v };

                    // 3. Emit pure (`EFFECT_PURE`) guard instructions in `lp.preheader`
                    let mut len_inst = lxf_make_const_int_inst(lxf_loc(len_loc_v), lxf_ty(len_ty_v), 0u64, view(sp), PASS_LOOP_VERSION);
                    len_inst.opcode = OPT_INST_LEN;
                    mir_copy_place(mut_view(len_inst.rhs_place), view(len_place));
                    mir_rvalue_reset(mut_view(len_inst.orig_stmt.rvalue), MIR_RVALUE_LEN);
                    mir_copy_place(mut_view(len_inst.orig_stmt.rvalue.place), view(len_place));

                    let lhs_op = mir_op_copy_local(bound_loc_v);
                    let rhs_op = mir_op_copy_local(len_loc_v);
                    let cmp_inst = lxf_make_binop_inst(
                        lxf_loc(guard_loc_v), lxf_ty(bool_ty_v), MIR_BINOP_LE, false,
                        view(lhs_op), view(rhs_op), view(sp), mut_view(*arena), PASS_LOOP_VERSION
                    );

                    let ph_bb = unsafe { opt_block_at(body.blocks, ph_v as usize) };
                    lxf_push_inst_to_block(unsafe { mut_view(*ph_bb) }, mut_view(*arena), len_inst);
                    lxf_push_inst_to_block(unsafe { mut_view(*ph_bb) }, mut_view(*arena), cmp_inst);
                    lxf_set_block_bool_branch(
                        unsafe { mut_view(*ph_bb) },
                        mut_view(*arena),
                        lxf_loc(guard_loc_v),
                        lxf_val(OPT_VALUE_NONE),
                        lxf_bb(hdr_v),
                        lxf_bb(fallback_hdr_v)
                    );

                    // 4. Fold `assert_bb`'s bounds check in the fast loop (`hdr_id`) to `OPT_TERM_GOTO`
                    let abb = unsafe { opt_block_at(body.blocks, assert_bb_v as usize) };
                    let assert_cond_v = unsafe { (*abb).term.cond.v };
                    let assert_ok_v = unsafe { (*abb).term.true_bb.v };
                    lxf_set_block_goto_target(unsafe { mut_view(*abb) }, lxf_bb(assert_ok_v));

                    optir_record_provenance(
                        mut_view(*body),
                        mut_view(*arena),
                        PROP_IN_BOUNDS,
                        CERTAINTY_PROVEN,
                        ANALYSIS_LOOP_INFO,
                        lxf_val(assert_cond_v),
                        lxf_val(OPT_VALUE_NONE),
                        lxf_bb(ph_v),
                        OptInstId { v: OPT_INST_NONE },
                        PASS_LOOP_VERSION
                    );

                    if !lxf_resync_opt_body(mut_view(*pm), mut_view(*body), call_table, use_alias, mut_view(*arena), mut_view(*sink)) {
                        lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                        pm.ir_revision = pre_rev;
                        pm.valid_analyses = pre_valid;
                        lxf_copy_stats(mut_view(*stats), view(pre_stats));
                        stats.pass_runs = pre_stats.pass_runs + 1u32;
                        stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                        return false;
                    }

                    stats.loops_versioned = stats.loops_versioned + 1u32;
                    stats.bce_eliminated_after_xform = stats.bce_eliminated_after_xform + 1u32;
                    lxf_push_record(
                        mut_view(*stats), mut_view(*arena),
                        PASS_LOOP_VERSION, LXF_KIND_LOOP_VERSION, true, CERTAINTY_PROVEN,
                        lxf_loop_id(unsafe { (*lp).id.v }), lxf_bb(assert_bb_v), 0u32,
                        lxf_val(assert_cond_v), lxf_val(OPT_VALUE_NONE), 2u64,
                        LXF_REASON_VERSIONED_FAST_GUARD
                    );

                    pm.ir_revision = pm.ir_revision + 1u32;
                    stats.pass_changes = stats.pass_changes + 1u32;
                    passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
                    let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                                    analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                                    analysis_bit(ANALYSIS_LOOP_INFO);
                    pm.valid_analyses = pm.valid_analyses | keep_mask;
                    loops_stamp_valid_analysis_revs(mut_view(*pm));

                    if pm.budget.verify_each {
                        if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
                            lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                            pm.ir_revision = pre_rev;
                            pm.valid_analyses = pre_valid;
                            lxf_copy_stats(mut_view(*stats), view(pre_stats));
                            stats.pass_runs = pre_stats.pass_runs + 1u32;
                            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                            return false;
                        }
                    }
                    return true;
                }
            }
        }
        li = li + 1;
    }

    false
}


// --- 7. Adjacent Loop Fusion & Producer-Consumer Buffer Forwarding (`opt_loop_fuse`, AXS-LOOP-015, AXS-LXF-007) ---

fn lxf_is_pure_bridge_between_loops(
    body: view<OptBody>,
    exit1: OptBbId,
    ph2: OptBbId,
    iv2_local: u32
) -> bool {
    let mut cur_v = exit1.v;
    let ph2_v = ph2.v;
    let mut hops: usize = 0;
    while hops < 4 {
        if (cur_v as usize) >= body.bb_count {
            return false;
        }
        let bb = unsafe { opt_block_at(body.blocks, cur_v as usize) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            let opc = unsafe { (*inst).opcode };
            let flg = unsafe { (*inst).flags };
            if opc != OPT_INST_NOP && (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 {
                if (opc != OPT_INST_CONST && opc != OPT_INST_COPY) ||
                   (unsafe { (*inst).place.local.v }) != iv2_local ||
                   (unsafe { (*inst).place.proj_count }) != 0 {
                    return false;
                }
            }
            i = i + 1;
        }
        if cur_v == ph2_v {
            return true;
        }
        if !(unsafe { (*bb).has_term }) || (unsafe { (*bb).term.kind }) != OPT_TERM_GOTO {
            return false;
        }
        cur_v = unsafe { (*bb).term.true_bb.v };
        hops = hops + 1;
    }
    false
}

fn lxf_loops_have_matching_trip_and_iv(
    tree: view<LoopTree>,
    lp1: view<LoopDesc>,
    lp2: view<LoopDesc>,
    body: view<OptBody>,
    out_iv1_loc: mut_view<u32>,
    out_iv2_loc: mut_view<u32>
) -> bool {
    if lp1.iv_count == 0 || lp2.iv_count == 0 || (lp1.ivs as usize) == 0 || (lp2.ivs as usize) == 0 {
        return false;
    }
    let piv1 = unsafe { loop_iv_at(lp1.ivs, 0) };
    let piv2 = unsafe { loop_iv_at(lp2.ivs, 0) };
    if !(unsafe { (*piv1).is_primary }) || !(unsafe { (*piv2).is_primary }) {
        return false;
    }
    if !(unsafe { (*piv1).no_wrap_proven }) || !(unsafe { (*piv2).no_wrap_proven }) {
        return false;
    }
    if (unsafe { (*piv1).step_const }) <= 0i64 ||
       (unsafe { (*piv1).step_const }) != (unsafe { (*piv2).step_const }) {
        return false;
    }
    let st1_idx = (unsafe { (*piv1).start_expr }) as usize;
    let st2_idx = (unsafe { (*piv2).start_expr }) as usize;
    if (unsafe { (*piv1).start_expr }) == SCEV_IDX_NONE ||
       (unsafe { (*piv2).start_expr }) == SCEV_IDX_NONE ||
       st1_idx >= tree.scev_count || st2_idx >= tree.scev_count {
        return false;
    }
    let st1 = unsafe { scev_expr_at(tree.scev_pool, st1_idx) };
    let st2 = unsafe { scev_expr_at(tree.scev_pool, st2_idx) };
    if (unsafe { (*st1).kind }) != SCEV_CONST || (unsafe { (*st2).kind }) != SCEV_CONST ||
       (unsafe { (*st1).const_val }) != (unsafe { (*st2).const_val }) {
        return false;
    }

    let pvp1 = unsafe { opt_val_at(body.values, (*piv1).phi_val.v as usize) };
    let pvp2 = unsafe { opt_val_at(body.values, (*piv2).phi_val.v as usize) };
    let loc1 = unsafe { (*pvp1).src_local.v };
    let loc2 = unsafe { (*pvp2).src_local.v };
    if loc1 == 0u32 || loc2 == 0u32 {
        return false;
    }
    *out_iv1_loc = loc1;
    *out_iv2_loc = loc2;

    if lp1.trip_count.kind == TRIP_CONST && lp2.trip_count.kind == TRIP_CONST &&
       lp1.trip_count.certainty == CERTAINTY_PROVEN && lp2.trip_count.certainty == CERTAINTY_PROVEN &&
       lp1.trip_count.const_iters == lp2.trip_count.const_iters {
        return true;
    }

    if lp1.trip_count.kind == TRIP_SYMBOLIC && lp2.trip_count.kind == TRIP_SYMBOLIC &&
       lp1.trip_count.certainty == CERTAINTY_PROVEN && lp2.trip_count.certainty == CERTAINTY_PROVEN {
        let sym1_idx = lp1.trip_count.sym_expr_idx as usize;
        let sym2_idx = lp2.trip_count.sym_expr_idx as usize;
        if lp1.trip_count.sym_expr_idx != SCEV_IDX_NONE &&
           lp2.trip_count.sym_expr_idx != SCEV_IDX_NONE &&
           sym1_idx < tree.scev_count && sym2_idx < tree.scev_count {
            let sex1 = unsafe { scev_expr_at(tree.scev_pool, sym1_idx) };
            let sex2 = unsafe { scev_expr_at(tree.scev_pool, sym2_idx) };
            let sv1 = lp_peel_copy(body, lxf_val(unsafe { (*sex1).ssa_val.v }));
            let sv2 = lp_peel_copy(body, lxf_val(unsafe { (*sex2).ssa_val.v }));
            if sv1.v != OPT_VALUE_NONE && sv1.v == sv2.v {
                return true;
            }
            if sv1.v != OPT_VALUE_NONE && sv2.v != OPT_VALUE_NONE &&
               (sv1.v as usize) <= body.value_count && (sv2.v as usize) <= body.value_count {
                let bvp1 = unsafe { opt_val_at(body.values, sv1.v as usize) };
                let bvp2 = unsafe { opt_val_at(body.values, sv2.v as usize) };
                if (unsafe { (*bvp1).src_local.v }) != 0u32 &&
                   (unsafe { (*bvp1).src_local.v }) == (unsafe { (*bvp2).src_local.v }) {
                    return true;
                }
            }
        }
    }
    false
}

fn lxf_try_fold_proven_iv_step_asserts(
    lp: view<LoopDesc>,
    body: mut_view<OptBody>,
    iv_local: u32
) -> bool {
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_CALL || tk == OPT_TERM_DROP {
                    return false;
                }
                if tk == OPT_TERM_ASSERT {
                    let cond_v = lp_peel_copy(view(*body), lxf_val(unsafe { (*bb).term.cond.v })).v;
                    let mut ov_v = cond_v;
                    if unsafe { (*bb).term.assert_expected } {
                        let cinst = lp_find_def_inst(view(*body), lxf_val(cond_v));
                        if (cinst as usize) != 0 && (unsafe { (*cinst).opcode }) == OPT_INST_UNOP &&
                           (unsafe { (*cinst).sub_op }) == MIR_UNOP_NOT {
                            ov_v = lp_peel_copy(view(*body), lxf_val(unsafe { (*cinst).lhs.v })).v;
                        } else {
                            return false;
                        }
                    }
                    let oinst = lp_find_def_inst(view(*body), lxf_val(ov_v));
                    if (oinst as usize) == 0 || (unsafe { (*oinst).opcode }) != OPT_INST_CHECKED_BINOP ||
                       (unsafe { (*oinst).sub_op }) != MIR_BINOP_ADD {
                        return false;
                    }
                    let ol = lp_peel_copy(view(*body), lxf_val(unsafe { (*oinst).lhs.v }));
                    if ol.v == OPT_VALUE_NONE || (ol.v as usize) > body.value_count {
                        return false;
                    }
                    let ol_vp = unsafe { opt_val_at(body.values, ol.v as usize) };
                    if (unsafe { (*ol_vp).src_local.v }) != iv_local {
                        return false;
                    }
                }
            }
        }
        k = k + 1;
    }

    // All asserts in `lp` are proven-safe IV step overflow asserts; fold them to `OPT_TERM_GOTO`
    k = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) == OPT_TERM_ASSERT {
                let ok_t_v = unsafe { (*bb).term.true_bb.v };
                lxf_set_block_goto_target(unsafe { mut_view(*bb) }, lxf_bb(ok_t_v));
            }
        }
        k = k + 1;
    }
    true
}

fn lxf_extract_loop_iv_offset_for_local(
    tree: view<LoopTree>,
    lp: view<LoopDesc>,
    body: view<OptBody>,
    iv_loc: u32,
    idx_loc: u32,
    out_off: mut_view<i64>
) -> bool {
    if idx_loc == iv_loc {
        *out_off = 0i64;
        return true;
    }
    let mut i: usize = 0;
    while i < lp.iv_count {
        let iv = unsafe { loop_iv_at(lp.ivs, i) };
        let ssa_v = unsafe { (*iv).ssa_val };
        if ssa_v.v != OPT_VALUE_NONE && (ssa_v.v as usize) <= body.value_count {
            let svp = unsafe { opt_val_at(body.values, ssa_v.v as usize) };
            if (unsafe { (*svp).src_local.v }) == idx_loc && (unsafe { (*iv).scale_const }) == 1i64 {
                let off_raw = unsafe { (*iv).offset_expr };
                if off_raw == SCEV_IDX_NONE {
                    *out_off = 0i64;
                    return true;
                }
                let off_idx = off_raw as usize;
                if off_idx < tree.scev_count {
                    let oex = unsafe { scev_expr_at(tree.scev_pool, off_idx) };
                    if (unsafe { (*oex).kind }) == SCEV_CONST {
                        *out_off = unsafe { (*oex).const_val };
                        return true;
                    }
                }
            }
        }
        i = i + 1;
    }
    false
}

fn lxf_check_cross_loop_fusion_dependences(
    tree: view<LoopTree>,
    lp1: view<LoopDesc>,
    lp2: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    iv1_loc: u32,
    iv2_loc: u32,
    arena: mut_view<Arena>
) -> bool {
    if (info as usize) == 0 {
        return false;
    }
    let ainfo = unsafe { view(*info) };

    // 1. Ensure L2 does not read any scalar local written in L1 (except iv1_loc / iv2_loc)
    let mut k1: usize = 0;
    while k1 < lp1.block_count {
        let b1 = unsafe { (*opt_bbid_at(lp1.blocks, k1)).v };
        if (b1 as usize) < body.bb_count {
            let bb1 = unsafe { opt_block_at(body.blocks, b1 as usize) };
            let mut i1: usize = 0;
            while i1 < (unsafe { (*bb1).inst_count }) {
                let inst1 = unsafe { opt_inst_at((*bb1).insts, i1) };
                let opc1 = unsafe { (*inst1).opcode };
                if opc1 != OPT_INST_NOP && (unsafe { (*inst1).orig_stmt.kind }) == MIR_STMT_ASSIGN {
                    let dpl1 = unsafe { view((*inst1).orig_stmt.place) };
                    if dpl1.proj_count == 0 && dpl1.local.v != 0u32 &&
                       dpl1.local.v != iv1_loc && dpl1.local.v != iv2_loc {
                        // Check if L2 reads this scalar local without writing it first
                        let mut k2: usize = 0;
                        while k2 < lp2.block_count {
                            let b2 = unsafe { (*opt_bbid_at(lp2.blocks, k2)).v };
                            if (b2 as usize) < body.bb_count {
                                let bb2 = unsafe { opt_block_at(body.blocks, b2 as usize) };
                                let mut i2: usize = 0;
                                while i2 < (unsafe { (*bb2).inst_count }) {
                                    let inst2 = unsafe { opt_inst_at((*bb2).insts, i2) };
                                    if (unsafe { (*inst2).opcode }) != OPT_INST_NOP &&
                                       lxf_stmt_reads_local(unsafe { view((*inst2).orig_stmt) }, dpl1.local.v) {
                                        return false;
                                    }
                                    i2 = i2 + 1;
                                }
                            }
                            k2 = k2 + 1;
                        }
                    }
                }
                i1 = i1 + 1;
            }
        }
        k1 = k1 + 1;
    }

    // 2. Check all memory access pairs `(inst1 in L1, inst2 in L2)` for negative fusion distance (`d < 0`)
    k1 = 0;
    while k1 < lp1.block_count {
        let b1 = unsafe { (*opt_bbid_at(lp1.blocks, k1)).v };
        if (b1 as usize) < body.bb_count {
            let bb1 = unsafe { opt_block_at(body.blocks, b1 as usize) };
            let mut i1: usize = 0;
            while i1 < (unsafe { (*bb1).inst_count }) {
                let inst1 = unsafe { opt_inst_at((*bb1).insts, i1) };
                let opc1 = unsafe { (*inst1).opcode };
                let is_w1 = opc1 == OPT_INST_STORE;
                let is_r1 = opc1 == OPT_INST_LOAD;
                if is_w1 || is_r1 {
                    let pl1: view<MirPlace> = if is_w1 {
                        unsafe { view((*inst1).place) }
                    } else {
                        unsafe { view((*inst1).rhs_place) }
                    };
                    let reg1 = alias_extract_region(ainfo, body, pl1, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
                    let mut k2: usize = 0;
                    while k2 < lp2.block_count {
                        let b2 = unsafe { (*opt_bbid_at(lp2.blocks, k2)).v };
                        if (b2 as usize) < body.bb_count {
                            let bb2 = unsafe { opt_block_at(body.blocks, b2 as usize) };
                            let mut i2: usize = 0;
                            while i2 < (unsafe { (*bb2).inst_count }) {
                                let inst2 = unsafe { opt_inst_at((*bb2).insts, i2) };
                                let opc2 = unsafe { (*inst2).opcode };
                                let is_w2 = opc2 == OPT_INST_STORE;
                                let is_r2 = opc2 == OPT_INST_LOAD;
                                if (is_w2 || is_r2) && (is_w1 || is_w2) {
                                    let pl2: view<MirPlace> = if is_w2 {
                                        unsafe { view((*inst2).place) }
                                    } else {
                                        unsafe { view((*inst2).rhs_place) }
                                    };
                                    let reg2 = alias_extract_region(ainfo, body, pl2, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
                                    let pt = alias_make_prog_pt(b2, i2 as u32);
                                    let af = alias_query_regions(ainfo, body, mut_view(*arena), view(reg1), view(reg2), pt);
                                    if !alias_is_no_alias_proven(view(af)) {
                                        if pl1.local.v != pl2.local.v || pl1.proj_count != pl2.proj_count || pl1.proj_count == 0 {
                                            return false;
                                        }
                                        let p1 = unsafe { mir_proj_at(pl1.projs, pl1.proj_count - 1) };
                                        let p2 = unsafe { mir_proj_at(pl2.projs, pl2.proj_count - 1) };
                                        if (unsafe { (*p1).kind }) != MIR_PROJ_INDEX || (unsafe { (*p2).kind }) != MIR_PROJ_INDEX {
                                            return false;
                                        }
                                        let mut off1: i64 = 0i64;
                                        let mut off2: i64 = 0i64;
                                        if !lxf_extract_loop_iv_offset_for_local(tree, lp1, body, iv1_loc, unsafe { (*p1).index_local.v }, mut_view(off1)) ||
                                           !lxf_extract_loop_iv_offset_for_local(tree, lp2, body, iv2_loc, unsafe { (*p2).index_local.v }, mut_view(off2)) {
                                            return false;
                                        }
                                        // Negative fusion distance (`d = off1 - off2 < 0`, i.e. `off2 > off1`) is illegal!
                                        if off2 > off1 {
                                            return false;
                                        }
                                    }
                                }
                                i2 = i2 + 1;
                            }
                        }
                        k2 = k2 + 1;
                    }
                }
                i1 = i1 + 1;
            }
        }
        k1 = k1 + 1;
    }

    true
}

fn lxf_local_read_outside_loops(
    lp1: view<LoopDesc>,
    lp2: view<LoopDesc>,
    body: view<OptBody>,
    loc_v: u32
) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if (unsafe { (*bb).is_reachable }) &&
           !lp_block_in_set(lp1.blocks, lp1.block_count, b as u32) &&
           !lp_block_in_set(lp2.blocks, lp2.block_count, b as u32) {
            let mut i: usize = 0;
            while i < (unsafe { (*bb).inst_count }) {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                if (unsafe { (*inst).opcode }) != OPT_INST_NOP &&
                   lxf_stmt_reads_local(unsafe { view((*inst).orig_stmt) }, loc_v) {
                    return true;
                }
                i = i + 1;
            }
            if (unsafe { (*bb).has_term }) &&
               lxf_term_reads_local(unsafe { view((*bb).term.orig_term) }, loc_v) {
                return true;
            }
        }
        b = b + 1;
    }
    false
}

fn lxf_forward_producer_consumer_buffers(
    lp1: view<LoopDesc>,
    lp2: view<LoopDesc>,
    body: mut_view<OptBody>,
    info: *const AliasInfo,
    iv1_loc: u32,
    iv2_loc: u32,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>
) {
    let mut k1: usize = 0;
    while k1 < lp1.block_count {
        let b1 = unsafe { (*opt_bbid_at(lp1.blocks, k1)).v };
        if (b1 as usize) < body.bb_count {
            let bb1 = unsafe { opt_block_at(body.blocks, b1 as usize) };
            let mut i1: usize = 0;
            while i1 < (unsafe { (*bb1).inst_count }) {
                let bb1_cur = unsafe { opt_block_at(body.blocks, b1 as usize) };
                let inst1 = unsafe { opt_inst_at((*bb1_cur).insts, i1) };
                if (unsafe { (*inst1).opcode }) == OPT_INST_STORE &&
                   (unsafe { (*inst1).place.proj_count }) == 1 &&
                   ((unsafe { (*inst1).place.projs }) as usize) != 0 &&
                   (unsafe { (*inst1).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                   (unsafe { (*inst1).orig_stmt.rvalue.kind }) == MIR_RVALUE_USE {
                    let p1 = unsafe { mir_proj_at((*inst1).place.projs, 0) };
                    let buf_loc_v = unsafe { (*inst1).place.local.v };
                    if (unsafe { (*p1).kind }) == MIR_PROJ_INDEX &&
                       (unsafe { (*p1).index_local.v }) == iv1_loc &&
                       buf_loc_v != 0u32 {
                        let elem_ty_v = unsafe { (*inst1).ty.v };
                        let store_op = unsafe { view((*inst1).orig_stmt.rvalue.use_op) };
                        let store_op_kind = store_op.kind;
                        let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                        mir_span_copy(mut_view(sp), unsafe { view((*inst1).orig_stmt.span) });

                        // Scan L2 for matching `dest = buf_loc[iv2_loc]` loads
                        let mut k2: usize = 0;
                        let mut forwarded_any = false;
                        while k2 < lp2.block_count {
                            let b2 = unsafe { (*opt_bbid_at(lp2.blocks, k2)).v };
                            if (b2 as usize) < body.bb_count {
                                let bb2 = unsafe { opt_block_at(body.blocks, b2 as usize) };
                                let mut i2: usize = 0;
                                while i2 < (unsafe { (*bb2).inst_count }) {
                                    let inst2 = unsafe { opt_inst_at((*bb2).insts, i2) };
                                    if (unsafe { (*inst2).opcode }) == OPT_INST_LOAD &&
                                       (unsafe { (*inst2).rhs_place.local.v }) == buf_loc_v &&
                                       (unsafe { (*inst2).rhs_place.proj_count }) == 1 &&
                                       ((unsafe { (*inst2).rhs_place.projs }) as usize) != 0 &&
                                       (unsafe { (*inst2).place.proj_count }) == 0 &&
                                       (unsafe { (*inst2).place.local.v }) != 0u32 {
                                        let p2 = unsafe { mir_proj_at((*inst2).rhs_place.projs, 0) };
                                        if (unsafe { (*p2).kind }) == MIR_PROJ_INDEX &&
                                           ((unsafe { (*p2).index_local.v }) == iv2_loc ||
                                            (unsafe { (*p2).index_local.v }) == iv1_loc) {
                                            let dest_loc_v = unsafe { (*inst2).place.local.v };
                                            let load_res_v = unsafe { (*inst2).result.v };
                                            let mut fwd_inst = lxf_make_const_int_inst(lxf_loc(dest_loc_v), lxf_ty(elem_ty_v), 0u64, view(sp), PASS_LOOP_FUSE);
                                            fwd_inst.opcode = if store_op_kind == MIR_OP_CONST { OPT_INST_CONST } else { OPT_INST_COPY };
                                            mir_rvalue_reset(mut_view(fwd_inst.orig_stmt.rvalue), MIR_RVALUE_USE);
                                            mir_copy_operand(mut_view(fwd_inst.orig_stmt.rvalue.use_op), store_op);
                                            unsafe {
                                                (*inst2).opcode = fwd_inst.opcode;
                                            }
                                            mir_copy_stmt(unsafe { mut_view((*inst2).orig_stmt) }, view(fwd_inst.orig_stmt));
                                            forwarded_any = true;
                                            stats.iter_buffers_forwarded = stats.iter_buffers_forwarded + 1u32;
                                            lxf_push_record(
                                                mut_view(*stats), mut_view(*arena),
                                                PASS_LOOP_FUSE, LXF_KIND_ITER_BUFFER_FORWARD, true, CERTAINTY_PROVEN,
                                                lxf_loop_id(lp1.id.v), lxf_bb(b2), i2 as u32,
                                                lxf_val(load_res_v), lxf_val(OPT_VALUE_NONE), 1u64,
                                                LXF_REASON_ITER_FUSED
                                            );
                                        }
                                    }
                                    i2 = i2 + 1;
                                }
                            }
                            k2 = k2 + 1;
                        }

                        // If `buf_loc` is a non-escaping stack local not read outside L1/L2, elide the dead store!
                        if forwarded_any &&
                           (buf_loc_v as usize) > body.arg_count &&
                           !loops_local_has_indirect_mutation(view(*body), info, buf_loc_v) &&
                           !lxf_local_read_outside_loops(lp1, lp2, view(*body), buf_loc_v) {
                            let bb1_fin = unsafe { opt_block_at(body.blocks, b1 as usize) };
                            let inst1_fin = unsafe { opt_inst_at((*bb1_fin).insts, i1) };
                            unsafe {
                                (*inst1_fin).opcode = OPT_INST_NOP;
                                (*inst1_fin).flags = OPT_FLAG_NONE;
                            }
                            optir_record_provenance(
                                mut_view(*body),
                                mut_view(*arena),
                                PROP_NO_ESCAPE,
                                CERTAINTY_PROVEN,
                                ANALYSIS_ALIAS_INFO,
                                lxf_val(OPT_VALUE_NONE),
                                lxf_val(OPT_VALUE_NONE),
                                lxf_bb(b1),
                                OptInstId { v: i1 as u32 },
                                PASS_LOOP_FUSE
                            );
                            optir_record_provenance(
                                mut_view(*body),
                                mut_view(*arena),
                                PROP_DEAD_STORE,
                                CERTAINTY_PROVEN,
                                ANALYSIS_ALIAS_INFO,
                                lxf_val(OPT_VALUE_NONE),
                                lxf_val(OPT_VALUE_NONE),
                                lxf_bb(b1),
                                OptInstId { v: i1 as u32 },
                                PASS_LOOP_FUSE
                            );
                        }
                    }
                }
                i1 = i1 + 1;
            }
        }
        k1 = k1 + 1;
    }
}

pub fn opt_loop_fuse(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let budget = loop_cost_budget_for_profile(pm.budget.profile);
    if !budget.allow_fusion {
        return false;
    }

    let contract = loop_fuse_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let ex_snap = lxf_save_extra_snap(view(*body));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_stats = *stats;
    stats.pass_runs = stats.pass_runs + 1u32;

    let use_alias: *const AliasInfo = if (alias_info as usize) != 0 {
        alias_info
    } else {
        alias_build_info(view(*body), call_table, mut_view(*arena)) as *const AliasInfo
    };

    let tree = loops_discover(view(*body), call_table, use_alias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*tree) }, view(*body), use_alias, mut_view(*arena));

    let lcnt = unsafe { (*tree).loop_count };
    if lcnt < 2 {
        return false;
    }

    let mut i1: usize = 0;
    while i1 < lcnt {
        let lp1 = unsafe { loop_desc_at((*tree).loops, i1) };
        if !(unsafe { (*lp1).is_irreducible }) &&
           (unsafe { (*lp1).child_count }) == 0 &&
           (unsafe { (*lp1).preheader.v }) != OPT_BB_NONE &&
           (unsafe { (*lp1).latch_count }) == 1 &&
           (unsafe { (*lp1).exit_count }) == 1 &&
           (unsafe { (*lp1).exiting_count }) == 1 {
            let hdr1_v = unsafe { (*lp1).header.v };
            let latch1_v = unsafe { (*opt_bbid_at((*lp1).latches, 0)).v };
            let exit1_v = unsafe { (*opt_bbid_at((*lp1).exit_blocks, 0)).v };
            let exiting1_v = unsafe { (*opt_bbid_at((*lp1).exiting_blocks, 0)).v };
            if exiting1_v == hdr1_v {
                let mut i2: usize = 0;
                while i2 < lcnt {
                    if i2 != i1 {
                        let lp2 = unsafe { loop_desc_at((*tree).loops, i2) };
                        if !(unsafe { (*lp2).is_irreducible }) &&
                           (unsafe { (*lp2).child_count }) == 0 &&
                           (unsafe { (*lp2).parent.v }) == (unsafe { (*lp1).parent.v }) &&
                           (unsafe { (*lp2).preheader.v }) != OPT_BB_NONE &&
                           (unsafe { (*lp2).latch_count }) == 1 &&
                           (unsafe { (*lp2).exit_count }) == 1 &&
                           (unsafe { (*lp2).exiting_count }) == 1 {
                            let ph2_v = unsafe { (*lp2).preheader.v };
                            let hdr2_v = unsafe { (*lp2).header.v };
                            let latch2_v = unsafe { (*opt_bbid_at((*lp2).latches, 0)).v };
                            let exit2_v = unsafe { (*opt_bbid_at((*lp2).exit_blocks, 0)).v };
                            let exiting2_v = unsafe { (*opt_bbid_at((*lp2).exiting_blocks, 0)).v };
                            let mut iv1_loc: u32 = 0u32;
                            let mut iv2_loc: u32 = 0u32;
                            if exiting2_v == hdr2_v &&
                               lxf_loops_have_matching_trip_and_iv(
                                   unsafe { view(*tree) },
                                   unsafe { view(*lp1) },
                                   unsafe { view(*lp2) },
                                   view(*body),
                                   mut_view(iv1_loc),
                                   mut_view(iv2_loc)
                               ) &&
                               lxf_is_pure_bridge_between_loops(view(*body), lxf_bb(exit1_v), lxf_bb(ph2_v), iv2_loc) {
                                // Check barriers & interior panics
                                let combined_bar = (unsafe { (*lp1).has_observable_barriers }) |
                                                   (unsafe { (*lp2).has_observable_barriers });
                                if (combined_bar & LXF_BARRIER_ALL_MASK) != 0u16 ||
                                   lxf_loop_has_call_term(unsafe { view(*lp1) }, view(*body)) ||
                                   lxf_loop_has_call_term(unsafe { view(*lp2) }, view(*body)) {
                                    stats.fusion_blocked_barriers = stats.fusion_blocked_barriers + 1u32;
                                    lxf_push_record(
                                        mut_view(*stats), mut_view(*arena),
                                        PASS_LOOP_FUSE, LXF_KIND_NONE, false, CERTAINTY_UNKNOWN,
                                        lxf_loop_id(unsafe { (*lp1).id.v }), lxf_bb(hdr1_v), (unsafe { (*lp2).id.v }),
                                        lxf_val(OPT_VALUE_NONE), lxf_val(OPT_VALUE_NONE), 0u64,
                                        LXF_REASON_BARRIER
                                    );
                                    return false;
                                }

                                // Check cross-loop negative distance & scalar dependences
                                if !lxf_check_cross_loop_fusion_dependences(
                                    unsafe { view(*tree) },
                                    unsafe { view(*lp1) },
                                    unsafe { view(*lp2) },
                                    view(*body),
                                    use_alias,
                                    iv1_loc,
                                    iv2_loc,
                                    mut_view(*arena)
                                ) {
                                    stats.fusion_blocked_dep = stats.fusion_blocked_dep + 1u32;
                                    lxf_push_record(
                                        mut_view(*stats), mut_view(*arena),
                                        PASS_LOOP_FUSE, LXF_KIND_NONE, false, CERTAINTY_POSSIBLE,
                                        lxf_loop_id(unsafe { (*lp1).id.v }), lxf_bb(hdr1_v), (unsafe { (*lp2).id.v }),
                                        lxf_val(OPT_VALUE_NONE), lxf_val(OPT_VALUE_NONE), 0u64,
                                        LXF_REASON_NEGATIVE_DEP_DIST
                                    );
                                    return false;
                                }

                                // Fold proven-safe IV step overflow asserts in L1 and L2; if any unproven interior assert remains, block fusion
                                if !lxf_try_fold_proven_iv_step_asserts(unsafe { view(*lp1) }, mut_view(*body), iv1_loc) ||
                                   !lxf_try_fold_proven_iv_step_asserts(unsafe { view(*lp2) }, mut_view(*body), iv2_loc) {
                                    stats.fusion_blocked_barriers = stats.fusion_blocked_barriers + 1u32;
                                    lxf_push_record(
                                        mut_view(*stats), mut_view(*arena),
                                        PASS_LOOP_FUSE, LXF_KIND_NONE, false, CERTAINTY_POSSIBLE,
                                        lxf_loop_id(unsafe { (*lp1).id.v }), lxf_bb(hdr1_v), (unsafe { (*lp2).id.v }),
                                        lxf_val(OPT_VALUE_NONE), lxf_val(OPT_VALUE_NONE), 0u64,
                                        LXF_REASON_BARRIER
                                    );
                                    lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                    passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                    return false;
                                }

                                let mut step1_bb = lxf_bb(OPT_BB_NONE);
                                let mut step1_idx: usize = 0;
                                let mut step2_bb = lxf_bb(OPT_BB_NONE);
                                let mut step2_idx: usize = 0;
                                let hbb2 = unsafe { opt_block_at(body.blocks, hdr2_v as usize) };
                                let mut c2 = lxf_val(OPT_VALUE_NONE);
                                let mut t2 = lxf_bb(OPT_BB_NONE);
                                let mut f2 = lxf_bb(OPT_BB_NONE);
                                if lxf_find_iv_step_site(unsafe { view(*lp1) }, view(*body), iv1_loc, mut_view(step1_bb), mut_view(step1_idx)) &&
                                   lxf_find_iv_step_site(unsafe { view(*lp2) }, view(*body), iv2_loc, mut_view(step2_bb), mut_view(step2_idx)) &&
                                   loops_extract_bool_branch(unsafe { view(*hbb2) }, mut_view(c2), mut_view(t2), mut_view(f2)) {
                                    let t2_in = lp_block_in_set(unsafe { (*lp2).blocks }, unsafe { (*lp2).block_count }, t2.v);
                                    let body2_entry_v: u32 = if t2_in { t2.v } else { f2.v };

                                    // 1. Move L1's step `iv1_loc = iv1_loc + step` to L2's step site (`step2_bb, step2_idx`)
                                    //    and replace L1's step site with `iv2_loc = Copy(iv1_loc)` so L2's body sees `iv2_loc == iv1_loc`!
                                    let s1_bb = unsafe { opt_block_at(body.blocks, step1_bb.v as usize) };
                                    let s1_inst = unsafe { opt_inst_at((*s1_bb).insts, step1_idx) };
                                    let saved_step1 = lxf_clone_inst(unsafe { view(*s1_inst) }, mut_view(*arena), PASS_LOOP_FUSE);
                                    let iv_ty_v = saved_step1.ty.v;
                                    let mut sp = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                                    mir_span_copy(mut_view(sp), view(saved_step1.orig_stmt.span));

                                    let sync_iv2_inst = lxf_make_copy_inst(
                                        lxf_loc(iv2_loc),
                                        lxf_loc(iv1_loc),
                                        lxf_ty(iv_ty_v),
                                        view(sp),
                                        PASS_LOOP_FUSE
                                    );
                                    unsafe {
                                        (*s1_inst).opcode = OPT_INST_COPY;
                                        (*s1_inst).sub_op = 0u8;
                                    }
                                    mir_copy_place(unsafe { mut_view((*s1_inst).place) }, view(sync_iv2_inst.place));
                                    mir_copy_stmt(unsafe { mut_view((*s1_inst).orig_stmt) }, view(sync_iv2_inst.orig_stmt));

                                    let s2_bb = unsafe { opt_block_at(body.blocks, step2_bb.v as usize) };
                                    let s2_inst = unsafe { opt_inst_at((*s2_bb).insts, step2_idx) };
                                    unsafe {
                                        *s2_inst = saved_step1;
                                        (*s2_inst).id = OptInstId { v: step2_idx as u32 };
                                    }

                                    // 2. Forward producer-consumer temporary buffer stores in L1 to loads in L2
                                    lxf_forward_producer_consumer_buffers(
                                        unsafe { view(*lp1) },
                                        unsafe { view(*lp2) },
                                        mut_view(*body),
                                        use_alias,
                                        iv1_loc,
                                        iv2_loc,
                                        mut_view(*stats),
                                        mut_view(*arena)
                                    );

                                    // 3. Splice CFG edges:
                                    //    - `latch1` jumps to `body2_entry` instead of `hdr1`
                                    //    - `latch2` jumps back to `hdr1` instead of `hdr2`
                                    //    - `hdr1` exits to `exit2` instead of `exit1`
                                    let l1_bb = unsafe { opt_block_at(body.blocks, latch1_v as usize) };
                                    let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*l1_bb) }, mut_view(*arena), lxf_bb(hdr1_v), lxf_bb(body2_entry_v));
                                    let l2_bb = unsafe { opt_block_at(body.blocks, latch2_v as usize) };
                                    let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*l2_bb) }, mut_view(*arena), lxf_bb(hdr2_v), lxf_bb(hdr1_v));
                                    let h1_bb = unsafe { opt_block_at(body.blocks, hdr1_v as usize) };
                                    let _ = lxf_redirect_edge_in_block(unsafe { mut_view(*h1_bb) }, mut_view(*arena), lxf_bb(exit1_v), lxf_bb(exit2_v));

                                    if !lxf_resync_opt_body(mut_view(*pm), mut_view(*body), call_table, use_alias, mut_view(*arena), mut_view(*sink)) {
                                        lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                        pm.ir_revision = pre_rev;
                                        pm.valid_analyses = pre_valid;
                                        lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                        stats.pass_runs = pre_stats.pass_runs + 1u32;
                                        stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                        return false;
                                    }

                                    stats.loops_fused = stats.loops_fused + 1u32;
                                    lxf_push_record(
                                        mut_view(*stats), mut_view(*arena),
                                        PASS_LOOP_FUSE, LXF_KIND_LOOP_FUSE, true, CERTAINTY_PROVEN,
                                        lxf_loop_id(unsafe { (*lp1).id.v }), lxf_bb(hdr1_v), (unsafe { (*lp2).id.v }),
                                        lxf_val(OPT_VALUE_NONE), lxf_val(OPT_VALUE_NONE), 2u64,
                                        LXF_REASON_FUSED_ADJACENT
                                    );

                                    pm.ir_revision = pm.ir_revision + 1u32;
                                    stats.pass_changes = stats.pass_changes + 1u32;
                                    passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
                                    let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                                                    analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                                                    analysis_bit(ANALYSIS_LOOP_INFO);
                                    pm.valid_analyses = pm.valid_analyses | keep_mask;
                                    loops_stamp_valid_analysis_revs(mut_view(*pm));

                                    if pm.budget.verify_each {
                                        if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
                                            lxf_restore_extra_snap(mut_view(*body), view(ex_snap));
                                            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
                                            pm.ir_revision = pre_rev;
                                            pm.valid_analyses = pre_valid;
                                            lxf_copy_stats(mut_view(*stats), view(pre_stats));
                                            stats.pass_runs = pre_stats.pass_runs + 1u32;
                                            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
                                            return false;
                                        }
                                    }
                                    return true;
                                }
                            }
                        }
                    }
                    i2 = i2 + 1;
                }
            }
        }
        i1 = i1 + 1;
    }

    false
}

// --- 8. Reduction, Distribution, Interchange & Vectorization Legality Analyzers (`AXS-LOOP-016`, `REQ-OPT-175`) ---

fn lxf_is_float_type(thir: *const Thir, ty: TypeId) -> bool {
    let ty_v = ty.v;
    if (thir as usize) != 0 && ty_v != 0u32 {
        let node = unsafe { type_get(view((*thir).interner), TypeId { v: ty_v }) };
        if (node as usize) != 0 {
            let tk = unsafe { (*node).kind };
            return tk == LXF_TY_F32 || tk == LXF_TY_F64;
        }
    }
    false
}

pub fn loop_xform_recognize_reduction(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo
) -> LoopReduction {
    let none = LoopReduction {
        valid: false,
        reassoc_legal: false,
        bin_op: 0u8,
        is_float: false,
        phi_val: OptValueId { v: OPT_VALUE_NONE },
        init_val: OptValueId { v: OPT_VALUE_NONE },
        step_val: OptValueId { v: OPT_VALUE_NONE },
        certainty: CERTAINTY_UNKNOWN,
    };
    if lp.is_irreducible || lp.latch_count != 1 || (lp.header.v as usize) >= body.bb_count {
        return none;
    }
    let latch_v = unsafe { (*opt_bbid_at(lp.latches, 0)).v };
    let hbb = unsafe { opt_block_at(body.blocks, lp.header.v as usize) };
    let mut hdr_cond = lxf_val(OPT_VALUE_NONE);
    let mut hdr_t = lxf_bb(OPT_BB_NONE);
    let mut hdr_f = lxf_bb(OPT_BB_NONE);
    let mut cond_lhs_v: u32 = OPT_VALUE_NONE;
    let mut cond_rhs_v: u32 = OPT_VALUE_NONE;
    if loops_extract_bool_branch(unsafe { view(*hbb) }, mut_view(hdr_cond), mut_view(hdr_t), mut_view(hdr_f)) {
        let cinst = lp_find_def_inst(body, lp_peel_copy(body, hdr_cond));
        if (cinst as usize) != 0 {
            cond_lhs_v = lp_peel_copy(body, lxf_val(unsafe { (*cinst).lhs.v })).v;
            cond_rhs_v = lp_peel_copy(body, lxf_val(unsafe { (*cinst).rhs.v })).v;
        }
    }
    let pcnt = unsafe { (*hbb).phi_count };
    let mut pi: usize = 0;
    while pi < pcnt {
        let phi = unsafe { opt_phi_at((*hbb).phis, pi) };
        let phi_res_v = unsafe { (*phi).result.v };
        let phi_loc = unsafe { (*phi).src_local.v };
        // Skip the exit-controlling induction counter phi
        let is_iv = phi_res_v == cond_lhs_v || phi_res_v == cond_rhs_v;
        if !is_iv && (unsafe { (*phi).arity }) == 2 && phi_loc != 0u32 &&
           !loops_local_has_indirect_mutation(body, info, phi_loc) {
            let b0_v = unsafe { (*opt_bbid_at((*phi).incoming_blocks, 0)).v };
            let v0_v = unsafe { (*opt_valid_at((*phi).incoming_values, 0)).v };
            let v1_v = unsafe { (*opt_valid_at((*phi).incoming_values, 1)).v };
            let init_v_id: u32 = if b0_v == latch_v { v1_v } else { v0_v };
            let step_v_id: u32 = if b0_v == latch_v { v0_v } else { v1_v };
            let step_peeled = lp_peel_copy(body, lxf_val(step_v_id));
            let sinst = lp_find_def_inst(body, step_peeled);
            if (sinst as usize) != 0 {
                let opc = unsafe { (*sinst).opcode };
                let bop = unsafe { (*sinst).sub_op };
                if (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP) &&
                   (bop == MIR_BINOP_ADD || bop == MIR_BINOP_WRAPPING_ADD ||
                    bop == MIR_BINOP_MUL || bop == MIR_BINOP_WRAPPING_MUL ||
                    bop == MIR_BINOP_BIT_AND || bop == MIR_BINOP_BIT_OR || bop == MIR_BINOP_BIT_XOR) {
                    let sl = lp_peel_copy(body, lxf_val(unsafe { (*sinst).lhs.v }));
                    let sr = lp_peel_copy(body, lxf_val(unsafe { (*sinst).rhs.v }));
                    if sl.v == phi_res_v || sr.v == phi_res_v {
                        let phi_ty_v = unsafe { (*phi).ty.v };
                        let is_flt = lxf_is_float_type(body.thir, lxf_ty(phi_ty_v));
                        let is_wrap_or_bits = opc == OPT_INST_WRAPPING_BINOP ||
                                              bop == MIR_BINOP_WRAPPING_ADD ||
                                              bop == MIR_BINOP_WRAPPING_MUL ||
                                              bop == MIR_BINOP_BIT_AND ||
                                              bop == MIR_BINOP_BIT_OR ||
                                              bop == MIR_BINOP_BIT_XOR;
                        let reassoc = !is_flt && is_wrap_or_bits;
                        return LoopReduction {
                            valid: true,
                            reassoc_legal: reassoc,
                            bin_op: bop,
                            is_float: is_flt,
                            phi_val: lxf_val(phi_res_v),
                            init_val: lxf_val(init_v_id),
                            step_val: lxf_val(step_v_id),
                            certainty: if reassoc { CERTAINTY_PROVEN } else { CERTAINTY_POSSIBLE },
                        };
                    }
                }
            }
        }
        pi = pi + 1;
    }
    none
}

pub fn loop_xform_can_distribute(
    tree: view<LoopTree>,
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    arena: mut_view<Arena>
) -> bool {
    if lp.is_irreducible || lp.latch_count != 1 || lp.exit_count != 1 ||
       (lp.has_observable_barriers & LXF_BARRIER_ALL_MASK) != 0u16 ||
       lxf_loop_has_call_term(lp, body) {
        return false;
    }
    // Check that no pair of memory accesses in `lp` has a negative or unknown dependence distance
    let mut k1: usize = 0;
    while k1 < lp.block_count {
        let b1 = unsafe { (*opt_bbid_at(lp.blocks, k1)).v };
        if (b1 as usize) < body.bb_count {
            let bb1 = unsafe { opt_block_at(body.blocks, b1 as usize) };
            if (unsafe { (*bb1).has_term }) && (unsafe { (*bb1).term.kind }) == OPT_TERM_ASSERT {
                return false;
            }
            let mut i1: usize = 0;
            while i1 < (unsafe { (*bb1).inst_count }) {
                let inst1 = unsafe { opt_inst_at((*bb1).insts, i1) };
                let opc1 = unsafe { (*inst1).opcode };
                if opc1 == OPT_INST_STORE {
                    let pl1 = unsafe { view((*inst1).place) };
                    let mut i2: usize = 0;
                    while i2 < i1 {
                        let inst2 = unsafe { opt_inst_at((*bb1).insts, i2) };
                        let opc2 = unsafe { (*inst2).opcode };
                        if opc2 == OPT_INST_LOAD || opc2 == OPT_INST_STORE {
                            let pl2: view<MirPlace> = if opc2 == OPT_INST_STORE {
                                unsafe { view((*inst2).place) }
                            } else {
                                unsafe { view((*inst2).rhs_place) }
                            };
                            let pt1 = alias_make_prog_pt(b1, i1 as u32);
                            let pt2 = alias_make_prog_pt(b1, i2 as u32);
                            let dep = loops_query_dependence(tree, lp, body, info, pl1, pt1, true, pl2, pt2, opc2 == OPT_INST_STORE, mut_view(*arena));
                            if dep.kind != DEP_NONE && dep.kind != DEP_LOOP_INDEPENDENT {
                                return false;
                            }
                        }
                        i2 = i2 + 1;
                    }
                }
                i1 = i1 + 1;
            }
        }
        k1 = k1 + 1;
    }
    true
}

pub fn loop_xform_can_interchange(
    tree: view<LoopTree>,
    outer_lp: view<LoopDesc>,
    inner_lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    arena: mut_view<Arena>
) -> bool {
    if outer_lp.is_irreducible || inner_lp.is_irreducible ||
       inner_lp.parent.v != outer_lp.id.v || outer_lp.child_count != 1 {
        return false;
    }
    if ((outer_lp.has_observable_barriers | inner_lp.has_observable_barriers) & LXF_BARRIER_ALL_MASK) != 0u16 {
        return false;
    }
    if outer_lp.trip_count.certainty != CERTAINTY_PROVEN || inner_lp.trip_count.certainty != CERTAINTY_PROVEN {
        return false;
    }
    loop_xform_can_vectorize_or_parallelize(tree, inner_lp, body, info, mut_view(*arena))
}

pub fn loop_xform_can_vectorize_or_parallelize(
    tree: view<LoopTree>,
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    arena: mut_view<Arena>
) -> bool {
    if lp.is_irreducible || lp.child_count != 0 ||
       (lp.has_observable_barriers & LXF_BARRIER_ALL_MASK) != 0u16 ||
       lxf_loop_has_call_term(lp, body) {
        return false;
    }
    let mut k1: usize = 0;
    while k1 < lp.block_count {
        let b1 = unsafe { (*opt_bbid_at(lp.blocks, k1)).v };
        if (b1 as usize) < body.bb_count {
            let bb1 = unsafe { opt_block_at(body.blocks, b1 as usize) };
            let mut i1: usize = 0;
            while i1 < (unsafe { (*bb1).inst_count }) {
                let inst1 = unsafe { opt_inst_at((*bb1).insts, i1) };
                let opc1 = unsafe { (*inst1).opcode };
                if opc1 == OPT_INST_STORE {
                    let pl1 = unsafe { view((*inst1).place) };
                    let mut k2: usize = 0;
                    while k2 < lp.block_count {
                        let b2 = unsafe { (*opt_bbid_at(lp.blocks, k2)).v };
                        if (b2 as usize) < body.bb_count {
                            let bb2 = unsafe { opt_block_at(body.blocks, b2 as usize) };
                            let mut i2: usize = 0;
                            while i2 < (unsafe { (*bb2).inst_count }) {
                                if !(b1 == b2 && i1 == i2) {
                                    let inst2 = unsafe { opt_inst_at((*bb2).insts, i2) };
                                    let opc2 = unsafe { (*inst2).opcode };
                                    if opc2 == OPT_INST_LOAD || opc2 == OPT_INST_STORE {
                                        let pl2: view<MirPlace> = if opc2 == OPT_INST_STORE {
                                            unsafe { view((*inst2).place) }
                                        } else {
                                            unsafe { view((*inst2).rhs_place) }
                                        };
                                        let pt1 = alias_make_prog_pt(b1, i1 as u32);
                                        let pt2 = alias_make_prog_pt(b2, i2 as u32);
                                        let dep = loops_query_dependence(tree, lp, body, info, pl1, pt1, true, pl2, pt2, opc2 == OPT_INST_STORE, mut_view(*arena));
                                        if dep.kind != DEP_NONE && dep.kind != DEP_LOOP_INDEPENDENT {
                                            return false;
                                        }
                                    }
                                }
                                i2 = i2 + 1;
                            }
                        }
                        k2 = k2 + 1;
                    }
                }
                i1 = i1 + 1;
            }
        }
        k1 = k1 + 1;
    }
    true
}


// --- 9. Top-Level Loop Transformation Pipeline Orchestrator (`opt_loop_xform`, `SPEC-72 §3.8`, `AXS-LOOP-017`) ---

pub fn opt_loop_xform(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    if pm.budget.profile == OPT_PROFILE_DEBUG_O0 {
        return false;
    }

    let mut simp_stats = LoopSimplifyStats {
        pass_runs: 0u32,
        pass_changes: 0u32,
        pass_rollbacks: 0u32,
        loops_discovered: 0u32,
        irreducible_cycles: 0u32,
        preheaders_inserted: 0u32,
        latches_merged: 0u32,
        dedicated_exits_inserted: 0u32,
        lcssa_phis_inserted: 0u32,
    };
    let mut bce_stats = BceStats {
        pass_runs: 0u32,
        pass_changes: 0u32,
        pass_rollbacks: 0u32,
        sites_inspected: 0u32,
        checks_eliminated: 0u32,
        checks_retained_possible: 0u32,
        checks_retained_unknown: 0u32,
        array_checks_eliminated: 0u32,
        slice_checks_eliminated: 0u32,
        vec_checks_eliminated: 0u32,
        blocks_pruned: 0u32,
    };
    bce_stats_zero(mut_view(bce_stats));

    let mut any_changed = false;

    // Step 1: Canonicalize loops into Simplified + LCSSA form
    let c_simp = opt_loop_simplify(mut_view(*pm), mut_view(*body), call_table, alias_info, mut_view(simp_stats), mut_view(*arena), mut_view(*sink));
    if c_simp {
        any_changed = true;
    }

    // Step 2: Effect- & MemorySSA-verified LICM
    let c_licm = opt_licm(mut_view(*pm), mut_view(*body), call_table, alias_info, mut_view(*stats), mut_view(*arena), mut_view(*sink));
    if c_licm {
        any_changed = true;
    }

    // Step 3: Overflow-faithful IV strength reduction & address evolution
    let c_sr = opt_iv_strength_reduce(mut_view(*pm), mut_view(*body), call_table, alias_info, mut_view(*stats), mut_view(*arena), mut_view(*sink));
    if c_sr {
        any_changed = true;
    }

    // Step 4: Loop unswitching of loop-invariant interior branches
    let c_unsw = opt_loop_unswitch(mut_view(*pm), mut_view(*body), call_table, alias_info, mut_view(*stats), mut_view(*arena), mut_view(*sink));
    if c_unsw {
        any_changed = true;
    }

    // Step 5: First-iteration loop peeling (tightening IV ranges for downstream BCE)
    let c_peel = opt_loop_peel(mut_view(*pm), mut_view(*body), call_table, alias_info, mut_view(*stats), mut_view(*arena), mut_view(*sink));
    if c_peel {
        any_changed = true;
    }

    // Step 6: Downstream BCE & safety check elimination after LICM / SR / Unswitch / Peel
    let c_bce1 = opt_bce(
        mut_view(*pm),
        mut_view(*body),
        call_table,
        mut_view(*arena),
        mut_view(*sink),
        mut_view(bce_stats),
        0 as *mut *mut BceSiteRecord,
        0 as *mut usize
    );
    if c_bce1 {
        stats.bce_eliminated_after_xform = stats.bce_eliminated_after_xform + bce_stats.checks_eliminated;
        any_changed = true;
    }

    // Step 7: Adjacent loop fusion & producer-consumer / iterator adapter buffer forwarding
    let c_fuse = opt_loop_fuse(mut_view(*pm), mut_view(*body), call_table, alias_info, mut_view(*stats), mut_view(*arena), mut_view(*sink));
    if c_fuse {
        any_changed = true;
    }

    // Step 8: Loop versioning with pure preheader guards for remaining symbolic bounds checks
    let c_ver = opt_loop_version(mut_view(*pm), mut_view(*body), call_table, alias_info, mut_view(*stats), mut_view(*arena), mut_view(*sink));
    if c_ver {
        any_changed = true;
    }

    // Step 9: Cost-bounded full & partial loop unrolling
    let c_unroll = opt_loop_unroll(mut_view(*pm), mut_view(*body), call_table, alias_info, mut_view(*stats), mut_view(*arena), mut_view(*sink));
    if c_unroll {
        any_changed = true;
    }

    // Step 10: Final BCE cleanup pass on unrolled/fused/versioned loops
    bce_stats_zero(mut_view(bce_stats));
    let c_bce2 = opt_bce(
        mut_view(*pm),
        mut_view(*body),
        call_table,
        mut_view(*arena),
        mut_view(*sink),
        mut_view(bce_stats),
        0 as *mut *mut BceSiteRecord,
        0 as *mut usize
    );
    if c_bce2 {
        stats.bce_eliminated_after_xform = stats.bce_eliminated_after_xform + bce_stats.checks_eliminated;
        any_changed = true;
    }

    any_changed
}

pub fn loop_xform_optimize_mir_body(
    mir_body: mut_view<MirBody>,
    thir: *const Thir,
    profile: u8,
    verify_each: bool,
    call_table: *const EffectCallTable,
    stats: mut_view<LoopXformStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    fn_item: *const HirItem
) -> bool {
    loop_xform_stats_zero(mut_view(*stats));
    let prev_errs = sink.errors;

    let obody = optir_build_from_mir(view(*mir_body), thir, mut_view(*arena), mut_view(*sink), fn_item);
    if (obody as usize) == 0 || sink.errors != prev_errs {
        return false;
    }

    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, verify_each);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));

    if profile == OPT_PROFILE_DEBUG_O0 {
        if verify_each {
            return loops_verify_pass_postconditions(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink));
        }
        return true;
    }

    let alias_ptr = alias_build_info(unsafe { view(*obody) }, call_table, mut_view(*arena));
    let _ = opt_loop_xform(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        call_table,
        alias_ptr as *const AliasInfo,
        mut_view(*stats),
        mut_view(*arena),
        mut_view(*sink)
    );

    let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*obody) }, unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
        return false;
    }
    verify_mir(unsafe { view(*rec_mir) }, thir, mut_view(*sink), fn_item);
    if sink.errors != prev_errs {
        return false;
    }

    unsafe {
        mir_body.sym.v = (*rec_mir).sym.v;
        mir_body.fn_sym.v = (*rec_mir).fn_sym.v;
        mir_body.fn_name.v = (*rec_mir).fn_name.v;
        mir_body.span.file.v = (*rec_mir).span.file.v;
        mir_body.span.start = (*rec_mir).span.start;
        mir_body.span.end = (*rec_mir).span.end;
        mir_body.locals = (*rec_mir).locals;
        mir_body.local_count = (*rec_mir).local_count;
        mir_body.local_cap = (*rec_mir).local_cap;
        mir_body.arg_count = (*rec_mir).arg_count;
        mir_body.bbs = (*rec_mir).bbs;
        mir_body.bb_count = (*rec_mir).bb_count;
        mir_body.bb_cap = (*rec_mir).bb_cap;
        mir_body.drop_flag_count = (*rec_mir).drop_flag_count;
    }
    true
}

