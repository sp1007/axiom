const LXF_STR_OFF: [33]u32 = [
    0u32, 13u32, 25u32, 34u32, 45u32, 62u32, 69u32, 77u32,
    92u32, 110u32, 128u32, 146u32, 157u32, 175u32, 192u32, 204u32,
    217u32, 233u32, 244u32, 259u32, 269u32, 282u32, 295u32, 306u32,
    317u32, 324u32, 332u32, 338u32, 347u32, 354u32, 360u32, 368u32,
    371u32
];

fn lxf_push_str(buf: mut_view<DiagBuffer>, idx: usize) {
    let start = LXF_STR_OFF[idx] as usize;
    let end = LXF_STR_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*buf), LXF_STR_DATA[i]);
        i = i + 1;
    }
}

pub fn loop_xform_print(stats: view<LoopXformStats>, buf: mut_view<DiagBuffer>) {
    lxf_push_str(mut_view(*buf), 0);
    lxf_push_str(mut_view(*buf), 1);
    diag_buf_push_u32(mut_view(*buf), stats.pass_runs);
    lxf_push_str(mut_view(*buf), 2);
    diag_buf_push_u32(mut_view(*buf), stats.pass_changes);
    lxf_push_str(mut_view(*buf), 3);
    diag_buf_push_u32(mut_view(*buf), stats.pass_rollbacks);

    lxf_push_str(mut_view(*buf), 4);
    diag_buf_push_u32(mut_view(*buf), stats.licm_hoisted_scalars);
    lxf_push_str(mut_view(*buf), 5);
    diag_buf_push_u32(mut_view(*buf), stats.licm_hoisted_loads);
    lxf_push_str(mut_view(*buf), 6);
    diag_buf_push_u32(mut_view(*buf), stats.licm_hoisted_guards);
    lxf_push_str(mut_view(*buf), 7);
    diag_buf_push_u32(mut_view(*buf), stats.licm_blocked_traps);
    lxf_push_str(mut_view(*buf), 8);
    diag_buf_push_u32(mut_view(*buf), stats.licm_blocked_clobbers);
    lxf_push_str(mut_view(*buf), 9);
    diag_buf_push_u32(mut_view(*buf), stats.licm_blocked_barriers);

    lxf_push_str(mut_view(*buf), 10);
    diag_buf_push_u32(mut_view(*buf), stats.iv_strength_reduced);
    lxf_push_str(mut_view(*buf), 11);
    diag_buf_push_u32(mut_view(*buf), stats.iv_addr_evolutions);
    lxf_push_str(mut_view(*buf), 12);
    diag_buf_push_u32(mut_view(*buf), stats.iv_blocked_overflow);

    lxf_push_str(mut_view(*buf), 13);
    diag_buf_push_u32(mut_view(*buf), stats.loops_peeled);
    lxf_push_str(mut_view(*buf), 14);
    diag_buf_push_u32(mut_view(*buf), stats.loops_unswitched);
    lxf_push_str(mut_view(*buf), 15);
    diag_buf_push_u32(mut_view(*buf), stats.loops_unrolled_full);
    lxf_push_str(mut_view(*buf), 16);
    diag_buf_push_u32(mut_view(*buf), stats.loops_unrolled_partial);
    lxf_push_str(mut_view(*buf), 17);
    diag_buf_push_u32(mut_view(*buf), stats.loops_versioned);

    lxf_push_str(mut_view(*buf), 18);
    diag_buf_push_u32(mut_view(*buf), stats.loops_fused);
    lxf_push_str(mut_view(*buf), 19);
    diag_buf_push_u32(mut_view(*buf), stats.iter_buffers_forwarded);
    lxf_push_str(mut_view(*buf), 20);
    diag_buf_push_u32(mut_view(*buf), stats.fusion_blocked_dep);
    lxf_push_str(mut_view(*buf), 21);
    diag_buf_push_u32(mut_view(*buf), stats.fusion_blocked_barriers);
    lxf_push_str(mut_view(*buf), 22);
    diag_buf_push_u32(mut_view(*buf), stats.bce_eliminated_after_xform);

    lxf_push_str(mut_view(*buf), 23);
    diag_buf_push_u32(mut_view(*buf), stats.record_count as u32);

    let mut r: usize = 0;
    while r < stats.record_count && (stats.records as usize) != 0 {
        let rec = unsafe { loop_xform_record_at(stats.records, r) };
        lxf_push_str(mut_view(*buf), 24);
        diag_buf_push_u32(mut_view(*buf), r as u32);
        lxf_push_str(mut_view(*buf), 25);
        diag_buf_push_u32(mut_view(*buf), (unsafe { (*rec).pass_id }) as u32);
        lxf_push_str(mut_view(*buf), 26);
        diag_buf_push_u32(mut_view(*buf), (unsafe { (*rec).kind }) as u32);
        lxf_push_str(mut_view(*buf), 27);
        diag_buf_push_u32(mut_view(*buf), if unsafe { (*rec).applied } { 1u32 } else { 0u32 });
        lxf_push_str(mut_view(*buf), 28);
        diag_buf_push_u32(mut_view(*buf), unsafe { (*rec).loop_id.v });
        lxf_push_str(mut_view(*buf), 29);
        diag_buf_push_u32(mut_view(*buf), unsafe { (*rec).bb.v });
        lxf_push_str(mut_view(*buf), 30);
        diag_buf_push_u32(mut_view(*buf), (unsafe { (*rec).reason }) as u32);
        r = r + 1;
    }

    lxf_push_str(mut_view(*buf), 31);
}
