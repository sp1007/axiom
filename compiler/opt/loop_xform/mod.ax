@derive(Copy)
pub struct LoopCostBudget {
    pub allow_licm: bool,
    pub allow_iv_sr: bool,
    pub allow_peeling: bool,
    pub allow_unswitching: bool,
    pub allow_full_unroll: bool,
    pub allow_partial_unroll: bool,
    pub allow_versioning: bool,
    pub allow_fusion: bool,
    pub max_full_unroll_trip: u64,
    pub max_full_unroll_insts: u32,
    pub max_partial_unroll_factor: u32,
    pub max_unswitch_block_count: u32,
    pub max_version_block_count: u32,
}

@derive(Copy)
pub struct LoopXformRecord {
    pub pass_id: u16,
    pub kind: u8,
    pub applied: bool,
    pub certainty: u8,
    pub loop_id: LoopId,
    pub bb: OptBbId,
    pub inst_idx: u32,
    pub primary_val: OptValueId,
    pub secondary_val: OptValueId,
    pub factor_or_trip: u64,
    pub reason: u8,
}

@derive(Copy)
pub struct LoopXformStats {
    pub pass_runs: u32,
    pub pass_changes: u32,
    pub pass_rollbacks: u32,
    pub licm_hoisted_scalars: u32,
    pub licm_hoisted_loads: u32,
    pub licm_hoisted_guards: u32,
    pub licm_blocked_traps: u32,
    pub licm_blocked_clobbers: u32,
    pub licm_blocked_barriers: u32,
    pub iv_strength_reduced: u32,
    pub iv_addr_evolutions: u32,
    pub iv_blocked_overflow: u32,
    pub loops_peeled: u32,
    pub loops_unswitched: u32,
    pub loops_unrolled_full: u32,
    pub loops_unrolled_partial: u32,
    pub loops_versioned: u32,
    pub loops_fused: u32,
    pub iter_buffers_forwarded: u32,
    pub fusion_blocked_dep: u32,
    pub fusion_blocked_barriers: u32,
    pub bce_eliminated_after_xform: u32,
    pub records: *mut LoopXformRecord,
    pub record_count: usize,
    pub record_cap: usize,
}

@derive(Copy)
pub struct LoopReduction {
    pub valid: bool,
    pub reassoc_legal: bool,
    pub bin_op: u8,
    pub is_float: bool,
    pub phi_val: OptValueId,
    pub init_val: OptValueId,
    pub step_val: OptValueId,
    pub certainty: u8,
}

// --- Pass Contracts & Profile Cost Budgets (SPEC-72 §3.8, AXS-LOOP-017) ---

pub fn licm_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_LICM,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                           ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO |
                           ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_LOOP_INFO,
        required_proofs: PROP_MASK_NO_ALIAS | PROP_MASK_NO_OVERFLOW,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                            ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_LOOP_INFO,
        invalidated_analyses: ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_NO_ALIAS | PROP_MASK_NO_OVERFLOW,
        postconditions: POSTCOND_ALL,
    }
}

pub fn iv_strength_reduce_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_IV_STRENGTH_REDUCE,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                           ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_LOOP_INFO,
        required_proofs: PROP_MASK_NO_OVERFLOW,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                            ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_LOOP_INFO,
        invalidated_analyses: ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_NO_OVERFLOW,
        postconditions: POSTCOND_ALL,
    }
}

