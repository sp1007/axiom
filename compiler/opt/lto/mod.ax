@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// --- Pass Identifier & TransformationContract (`SPEC-75 §5, AXS-LTO-030`) ---

pub const PASS_LTO: u16 = 18u16;

pub fn lto_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_LTO,
        required_analyses: ANALYSIS_MASK_CALL_GRAPH | ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS |
                           ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO |
                           ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_ALIAS_INFO,
        required_proofs: PROP_MASK_REACHABLE | PROP_MASK_PURE_CALL | PROP_MASK_NO_ESCAPE | PROP_MASK_NO_ALIAS,
        preserved_analyses: ANALYSIS_MASK_CALL_GRAPH,
        invalidated_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                              ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ESCAPE_INFO |
                              ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_LOOP_INFO | ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_REACHABLE | PROP_MASK_NO_ALIAS | PROP_MASK_NO_ESCAPE | PROP_MASK_PURE_CALL,
        postconditions: POSTCOND_ALL,
    }
}

// --- Section 1: LTO Modes, World Scopes, Visibility Lattice, Root Set, & Alias Codes (`AXS-LTO-001..005, AXS-LTO-010..014`) ---

