@derive(Copy)
pub struct LtoDigest128 {
    pub lo: u64,
    pub hi: u64,
}

@derive(Copy)
pub struct LtoFnSummary {
    pub fn_sym: SymbolId,
    pub fn_name: StrId,
    pub module_id: u32,
    pub visibility: u8,
    pub linkage: u8,
    pub root_kind: u8,
    pub reachability: u8,
    pub signature_hash: u64,
    pub cfg_fingerprint: u64,
    pub body_fingerprint: u64,
    pub inst_count: u32,
    pub effect_flags: u16,
    pub escape_return_mask: u32,
    pub param_no_escape_mask: u64,
    pub param_no_alias_mask: u64,
    pub alias_state: u8,
    pub has_raw_ptr_or_ffi_alias: bool,
    pub has_atomic_ops: bool,
    pub has_volatile_ops: bool,
    pub has_custom_drop: bool,
    pub address_taken_fn: bool,
    pub eligible_for_cross_inline: bool,
    pub generic_def_id: u32,
    pub canonical_type_arg_hash: u64,
    pub rep_type_size: u32,
    pub rep_type_align: u32,
    pub rep_abi_class: u8,
    pub canonical_leader_sym: SymbolId,
}

