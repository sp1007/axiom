pub const LTO_MODE_THIN: u8 = 1u8;
pub const LTO_MODE_FAT: u8 = 2u8;
pub const LTO_MODE_FULL: u8 = 2u8;

pub const WORLD_CLOSED: u8 = 0u8;
pub const WORLD_PARTIAL: u8 = 1u8;
pub const WORLD_OPEN: u8 = 2u8;

pub const LTO_VIS_PRIVATE: u8 = 0u8;
pub const LTO_VIS_PUB: u8 = 1u8;
pub const LTO_VIS_EXPORTED: u8 = 2u8;
pub const LTO_VIS_EXTERN_FFI: u8 = 3u8;

pub const LTO_LINKAGE_LOCAL: u8 = 0u8;
pub const LTO_LINKAGE_GLOBAL: u8 = 1u8;
pub const LTO_LINKAGE_INTERNALIZED: u8 = 2u8;
pub const LTO_LINKAGE_EXPORTED_ROOT: u8 = 3u8;
pub const LTO_LINKAGE_DEAD_ELIMINATED: u8 = 4u8;

pub const LTO_ROOT_NONE: u8 = 0u8;
pub const LTO_ROOT_ENTRY: u8 = 1u8;
pub const LTO_ROOT_EXPORT: u8 = 2u8;
pub const LTO_ROOT_DYNAMIC_LOOKUP: u8 = 3u8;
pub const LTO_ROOT_FFI_CALLBACK: u8 = 4u8;
pub const LTO_ROOT_REFLECTION: u8 = 5u8;
pub const LTO_ROOT_PINNED_AT: u8 = 6u8;
pub const LTO_ROOT_MODULE_INIT: u8 = 7u8;

pub const LTO_ALIAS_NO_ALIAS: u8 = 0u8;
pub const LTO_ALIAS_MAY_ALIAS: u8 = 1u8;
pub const LTO_ALIAS_UNKNOWN_ALIAS: u8 = 2u8;

pub const LTO_DEDUP_NONE: u8 = 0u8;
pub const LTO_DEDUP_EXACT_INSTANCE: u8 = 1u8;
pub const LTO_DEDUP_REP_EQUIV_SHARED: u8 = 2u8;
pub const LTO_DEDUP_KEPT_ADDRESS_TAKEN: u8 = 3u8;
pub const LTO_DEDUP_KEPT_CUSTOM_DROP: u8 = 4u8;
pub const LTO_DEDUP_KEPT_LAYOUT_MISMATCH: u8 = 5u8;

pub const AXMETA_MAGIC_0: u8 = 65u8; // 'A'
pub const AXMETA_MAGIC_1: u8 = 88u8; // 'X'
pub const AXMETA_MAGIC_2: u8 = 76u8; // 'L'
pub const AXMETA_MAGIC_3: u8 = 84u8; // 'T'
