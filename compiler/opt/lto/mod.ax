fn lto_push_tbl(out: mut_view<DiagBuffer>, off: usize, byte_len: usize) {
    let mut i: usize = 0;
    while i < byte_len {
        diag_buf_push_byte(mut_view(*out), LTO_PRINT_DATA[off + i]);
        i = i + 1;
    }
}

pub fn lto_print(
    wpo: view<LtoWholeProgram>,
    stats: view<LtoStats>,
    out: mut_view<DiagBuffer>
) {
    lto_push_tbl(mut_view(*out), 0, 10);
    lto_push_tbl(mut_view(*out), 10, 7);
    if wpo.lto_mode == LTO_MODE_OFF {
        lto_push_tbl(mut_view(*out), 17, 3);
    } else if wpo.lto_mode == LTO_MODE_THIN {
        lto_push_tbl(mut_view(*out), 20, 4);
    } else {
        lto_push_tbl(mut_view(*out), 24, 3);
    }
    lto_push_tbl(mut_view(*out), 27, 7);
    if wpo.world_scope == WORLD_CLOSED {
        lto_push_tbl(mut_view(*out), 34, 6);
    } else if wpo.world_scope == WORLD_PARTIAL {
        lto_push_tbl(mut_view(*out), 40, 7);
    } else {
        lto_push_tbl(mut_view(*out), 47, 4);
    }
    lto_push_tbl(mut_view(*out), 51, 9);
    diag_buf_push_u32(mut_view(*out), wpo.module_count as u32);
    diag_buf_push_byte(mut_view(*out), 10u8);

    let mut i: usize = 0;
    while i < wpo.fn_count && (wpo.fns as usize) != 0 {
        let fp = unsafe { lto_fn_at(wpo.fns, i) };
        lto_push_tbl(mut_view(*out), 60, 8);
        diag_buf_push_u32(mut_view(*out), unsafe { (*fp).fn_sym.v });
        lto_push_tbl(mut_view(*out), 68, 5);
        diag_buf_push_u32(mut_view(*out), unsafe { (*fp).module_id });
        lto_push_tbl(mut_view(*out), 73, 5);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).visibility }) as u32);
        lto_push_tbl(mut_view(*out), 78, 9);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).linkage }) as u32);
        lto_push_tbl(mut_view(*out), 87, 6);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).root_kind }) as u32);
        lto_push_tbl(mut_view(*out), 93, 7);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).reachability }) as u32);
        lto_push_tbl(mut_view(*out), 100, 8);
        diag_buf_push_u32(mut_view(*out), unsafe { (*fp).canonical_leader_sym.v });
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1;
    }

    let mut d: usize = 0;
    while d < wpo.dedup_count && (wpo.dedup_records as usize) != 0 {
        let dp = unsafe { lto_dedup_at(wpo.dedup_records, d) };
        lto_push_tbl(mut_view(*out), 108, 18);
        diag_buf_push_u32(mut_view(*out), unsafe { (*dp).canonical_sym.v });
        lto_push_tbl(mut_view(*out), 126, 11);
        diag_buf_push_u32(mut_view(*out), unsafe { (*dp).candidate_sym.v });
        lto_push_tbl(mut_view(*out), 137, 10);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*dp).decision }) as u32);
        diag_buf_push_byte(mut_view(*out), 10u8);
        d = d + 1;
    }

    lto_push_tbl(mut_view(*out), 147, 23);
    diag_buf_push_u32(mut_view(*out), stats.symbols_internalized);
    lto_push_tbl(mut_view(*out), 170, 10);
    diag_buf_push_u32(mut_view(*out), stats.dead_fns_eliminated);
    lto_push_tbl(mut_view(*out), 180, 14);
    diag_buf_push_u32(mut_view(*out), stats.dead_statics_eliminated);
    lto_push_tbl(mut_view(*out), 194, 14);
    diag_buf_push_u32(mut_view(*out), stats.dead_vtables_eliminated);
    lto_push_tbl(mut_view(*out), 208, 9);
    diag_buf_push_u32(mut_view(*out), stats.cross_module_inlined);
    lto_push_tbl(mut_view(*out), 217, 13);
    diag_buf_push_u32(mut_view(*out), stats.cross_module_specialized);
    lto_push_tbl(mut_view(*out), 230, 8);
    diag_buf_push_u32(mut_view(*out), stats.cross_module_devirt_exact + stats.cross_module_devirt_guarded);
    lto_push_tbl(mut_view(*out), 238, 13);
    diag_buf_push_u32(mut_view(*out), stats.generics_dedup_exact);
    lto_push_tbl(mut_view(*out), 251, 12);
    diag_buf_push_u32(mut_view(*out), stats.generics_rep_shared);
    lto_push_tbl(mut_view(*out), 263, 11);
    diag_buf_push_u32(mut_view(*out), stats.generics_kept_addr_taken);
    lto_push_tbl(mut_view(*out), 274, 11);
    diag_buf_push_u32(mut_view(*out), stats.pass_rollbacks);
    diag_buf_push_byte(mut_view(*out), 10u8);
    lto_push_tbl(mut_view(*out), 285, 2);
}
