pub const PASS_DCE: u16 = 7u16;
pub const PASS_CFG_SIMPLIFY: u16 = 8u16;
pub const PASS_COUNT: usize = 9;

pub const ANALYSIS_COUNT: usize = 9;

// --- Analysis Bitmasks (AXS-OPT-030, REQ-CORE-447, REQ-OPT-350) ---

pub const ANALYSIS_MASK_NONE: u32 = 0u32;
pub const ANALYSIS_MASK_CFG: u32 = 1u32;          // 1 << ANALYSIS_CFG (0)
pub const ANALYSIS_MASK_DOMINATORS: u32 = 2u32;   // 1 << ANALYSIS_DOMINATORS (1)
pub const ANALYSIS_MASK_SSA: u32 = 4u32;          // 1 << ANALYSIS_SSA (2)
pub const ANALYSIS_MASK_MEMORY_SSA: u32 = 8u32;   // 1 << ANALYSIS_MEMORY_SSA (3)
pub const ANALYSIS_MASK_EFFECT_INFO: u32 = 16u32; // 1 << ANALYSIS_EFFECT_INFO (4)
pub const ANALYSIS_MASK_ALIAS_INFO: u32 = 32u32;  // 1 << ANALYSIS_ALIAS_INFO (5)
pub const ANALYSIS_MASK_ESCAPE_INFO: u32 = 64u32; // 1 << ANALYSIS_ESCAPE_INFO (6)
pub const ANALYSIS_MASK_RANGE_INFO: u32 = 128u32; // 1 << ANALYSIS_RANGE_INFO (7)
pub const ANALYSIS_MASK_LOOP_INFO: u32 = 256u32;  // 1 << ANALYSIS_LOOP_INFO (8)
pub const ANALYSIS_MASK_ALL: u32 = 511u32;

// --- Property Bitmasks (SPEC-70 §8.2) ---

pub const PROP_MASK_NONE: u32 = 0u32;
pub const PROP_MASK_NO_ALIAS: u32 = 1u32;    // 1 << PROP_NO_ALIAS (0)
pub const PROP_MASK_IN_BOUNDS: u32 = 2u32;   // 1 << PROP_IN_BOUNDS (1)
pub const PROP_MASK_NON_ZERO: u32 = 4u32;    // 1 << PROP_NON_ZERO (2)
pub const PROP_MASK_NO_OVERFLOW: u32 = 8u32; // 1 << PROP_NO_OVERFLOW (3)
pub const PROP_MASK_PURE_CALL: u32 = 16u32;  // 1 << PROP_PURE_CALL (4)
pub const PROP_MASK_NO_ESCAPE: u32 = 32u32;  // 1 << PROP_NO_ESCAPE (5)
pub const PROP_MASK_DEAD_STORE: u32 = 64u32; // 1 << PROP_DEAD_STORE (6)
pub const PROP_MASK_REACHABLE: u32 = 128u32; // 1 << PROP_REACHABLE (7)
pub const PROP_MASK_ALL: u32 = 255u32;

// --- Postcondition Bitmasks (AXS-OPT-031, AXS-OPT-034) ---

pub const POSTCOND_CFG_VALID: u32 = 1u32;
pub const POSTCOND_DOM_VALID: u32 = 2u32;
pub const POSTCOND_SSA_VALID: u32 = 4u32;
