// --- Data Structures ---

@derive(Copy)
pub struct TransformationContract {
    pub pass_id: u16,
    pub required_analyses: u32,
    pub required_proofs: u32,
    pub preserved_analyses: u32,
    pub invalidated_analyses: u32,
    pub preserved_properties: u32,
    pub postconditions: u32,
}

@derive(Copy)
pub struct OptBudget {
    pub profile: u8,
    pub verify_each: bool,
    pub max_fixedpoint_rounds: u32,
    pub max_ir_insts_per_fn: u32,
    pub max_symbolic_steps: u32,
    pub inline_cost_threshold: u32,
}

@derive(Copy)
pub struct BodyFacts {
    pub bb_count: u32,
    pub inst_count: u32,
    pub sroa_candidate_count: u32,
    pub memory_op_count: u32,
    pub branch_count: u32,
    pub call_count: u32,
    pub loop_backedge_count: u32,
    pub binop_count: u32,
}

@derive(Copy)
pub struct CandidateRewrite {
    pub pass_id: u16,
    pub required_prop: u8,
    pub proof_certainty: u8,
    pub proof_source_analysis: u8,
    pub proof_revision: u32,
    pub target_effect_flags: u16,
    pub src_view_kind: u8,
    pub dst_view_kind: u8,
    pub is_removing_inst: bool,
    pub cost_delta: i32,
}

pub struct PassManager {
    pub budget: OptBudget,
    pub valid_analyses: u32,
    pub ir_revision: u32,
    pub analysis_revs: *mut u32,
    pub analysis_compute_counts: *mut u32,
    pub analysis_invalidation_counts: *mut u32,
    pub pass_run_counts: *mut u32,
    pub pass_skip_counts: *mut u32,
    pub pass_change_counts: *mut u32,
    pub pass_rollback_counts: *mut u32,
    pub verify_run_count: u32,
    pub verify_fail_count: u32,
    pub fixedpoint_rounds_executed: u32,
    pub last_verify_status: u8,
    pub last_effect_summary: EffectSummary,
    pub baseline_effect_summary: EffectSummary,
    pub has_baseline_effects: bool,
}

pub struct OptBodySnapshot {
    pub bb_count: usize,
    pub blocks_copy: *mut OptBlock,
    pub block_phis_copy: *mut *mut OptPhi,
    pub block_insts_copy: *mut *mut OptInst,
    pub block_preds_copy: *mut *mut OptBbId,
    pub block_succs_copy: *mut *mut OptBbId,
    pub block_mphi_copy: *mut *mut MemSsaId,
    pub rpo_count: usize,
    pub rpo_copy: *mut OptBbId,
    pub value_count: usize,
    pub values_copy: *mut OptValue,
    pub mem_ssa_count: usize,
    pub mem_defs_copy: *mut MemSsaDefNode,
    pub provenance_count: usize,
    pub provenance_copy: *mut ProofProvenance,
    pub ranges_ptr: *mut OptRange,
}

// --- Pointer Indexing Helpers ---

fn pm_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

unsafe fn pm_ptr_phi_at(base: *mut *mut OptPhi, idx: usize) -> *mut *mut OptPhi {
    let off = ((idx as isize) * (size_of<*mut OptPhi>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut OptPhi
}

unsafe fn pm_ptr_inst_at(base: *mut *mut OptInst, idx: usize) -> *mut *mut OptInst {
    let off = ((idx as isize) * (size_of<*mut OptInst>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut OptInst
}

unsafe fn pm_ptr_bbid_at(base: *mut *mut OptBbId, idx: usize) -> *mut *mut OptBbId {
    let off = ((idx as isize) * (size_of<*mut OptBbId>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut OptBbId
}

unsafe fn pm_ptr_memid_at(base: *mut *mut MemSsaId, idx: usize) -> *mut *mut MemSsaId {
    let off = ((idx as isize) * (size_of<*mut MemSsaId>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut MemSsaId
}

fn pm_type_kind(thir: *const Thir, ty: TypeId) -> u8 {
    let tv = ty.v;
    if (thir as usize) != 0 && tv != 0u32 {
        let node = unsafe { type_get(view((*thir).interner), TypeId { v: tv }) };
        if (node as usize) != 0 {
            return unsafe { (*node).kind };
        }
    }
    0u8
}

// --- Analysis Dependency & Invalidation DAG (AXS-OPT-030, REQ-CORE-447, REQ-OPT-350) ---

pub fn analysis_bit(analysis_id: u8) -> u32 {
    if (analysis_id as usize) >= ANALYSIS_COUNT {
        return 0u32;
    }
    1u32 << (analysis_id as u32)
}

pub fn prop_bit(prop_kind: u8) -> u32 {
    if prop_kind > 7u8 {
        return 0u32;
    }
    1u32 << (prop_kind as u32)
}

pub fn analysis_dependencies(analysis_id: u8) -> u32 {
    if analysis_id == ANALYSIS_CFG {
        return ANALYSIS_MASK_CFG;
    }
    if analysis_id == ANALYSIS_DOMINATORS {
        return ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS;
    }
    if analysis_id == ANALYSIS_SSA {
        return ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA;
    }
    if analysis_id == ANALYSIS_MEMORY_SSA {
        return ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
               ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ALIAS_INFO;
    }
    if analysis_id == ANALYSIS_EFFECT_INFO {
        return ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO;
    }
    if analysis_id == ANALYSIS_ALIAS_INFO {
        return ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_ALIAS_INFO;
    }
    if analysis_id == ANALYSIS_ESCAPE_INFO {
        return ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_ESCAPE_INFO;
    }
    if analysis_id == ANALYSIS_RANGE_INFO {
        return ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_RANGE_INFO;
    }
    if analysis_id == ANALYSIS_LOOP_INFO {
        return ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_LOOP_INFO;
    }
    0u32
}

pub fn analysis_expand_required(required_mask: u32) -> u32 {
    let mut expanded = required_mask;
    let mut changed = true;
    while changed {
        changed = false;
        let mut i: u8 = 0u8;
        while (i as usize) < ANALYSIS_COUNT {
            let bit = analysis_bit(i);
            if (expanded & bit) != 0u32 {
                let deps = analysis_dependencies(i);
                if (expanded | deps) != expanded {
                    expanded = expanded | deps;
                    changed = true;
                }
            }
            i = i + 1u8;
        }
    }
    expanded
}

pub fn analysis_expand_invalidated(directly_invalidated: u32) -> u32 {
    // AXS-OPT-030 Transitive Invalidation Rules:
    // - Invalidating CFG transitively invalidates DominatorTree, SSA, MemorySSA, RangeInfo, LoopInfo.
    // - Invalidating DominatorTree transitively invalidates SSA, MemorySSA, RangeInfo, LoopInfo.
    // - Invalidating SSA transitively invalidates MemorySSA, EffectInfo, AliasInfo, EscapeInfo, RangeInfo.
    // - Invalidating MemorySSA transitively invalidates memory-dependent AliasInfo.
    let mut inv = directly_invalidated;
    if (inv & ANALYSIS_MASK_CFG) != 0u32 {
        inv = inv | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA |
                    ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_LOOP_INFO;
    }
    if (inv & ANALYSIS_MASK_DOMINATORS) != 0u32 {
        inv = inv | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA |
                    ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_LOOP_INFO;
    }
    if (inv & ANALYSIS_MASK_SSA) != 0u32 {
        inv = inv | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO |
                    ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_RANGE_INFO;
    }
    if (inv & ANALYSIS_MASK_MEMORY_SSA) != 0u32 {
        inv = inv | ANALYSIS_MASK_ALIAS_INFO;
    }
    inv
}

// --- TransformationContract Registry (AXS-OPT-031, REQ-OPT-052, REQ-OPT-356, REQ-OPT-406) ---

pub fn passmgr_contract_for_pass(pass_id: u16) -> TransformationContract {
    if pass_id == PASS_SCCP {
        return TransformationContract {
            pass_id: PASS_SCCP,
            required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                               ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_RANGE_INFO,
            required_proofs: PROP_MASK_REACHABLE | PROP_MASK_NO_OVERFLOW | PROP_MASK_NON_ZERO,
            preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA |
                                ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_LOOP_INFO,
            invalidated_analyses: ANALYSIS_MASK_RANGE_INFO,
            preserved_properties: PROP_MASK_ALL,
            postconditions: POSTCOND_ALL,
        };
    }
    if pass_id == PASS_INST_COMBINE {
        return TransformationContract {
            pass_id: PASS_INST_COMBINE,
            required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_RANGE_INFO,
            required_proofs: PROP_MASK_NO_OVERFLOW | PROP_MASK_NON_ZERO,
            preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA |
                                ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_LOOP_INFO,
            invalidated_analyses: ANALYSIS_MASK_RANGE_INFO,
            preserved_properties: PROP_MASK_ALL,
            postconditions: POSTCOND_ALL,
        };
    }
    if pass_id == PASS_GVN_CSE {
        return TransformationContract {
            pass_id: PASS_GVN_CSE,
            required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                               ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ALIAS_INFO,
            required_proofs: PROP_MASK_PURE_CALL | PROP_MASK_NO_ALIAS,
            preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA |
                                ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_LOOP_INFO,
            invalidated_analyses: ANALYSIS_MASK_RANGE_INFO,
            preserved_properties: PROP_MASK_ALL,
            postconditions: POSTCOND_ALL,
        };
    }
    if pass_id == PASS_SROA {
        return TransformationContract {
            pass_id: PASS_SROA,
            required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                               ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_ALIAS_INFO,
            required_proofs: PROP_MASK_NO_ESCAPE | PROP_MASK_NO_ALIAS,
            preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_LOOP_INFO,
            invalidated_analyses: ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_RANGE_INFO,
            preserved_properties: PROP_MASK_REACHABLE | PROP_MASK_NO_ESCAPE | PROP_MASK_NO_ALIAS,
            postconditions: POSTCOND_ALL,
        };
    }
    if pass_id == PASS_DCE {
        return TransformationContract {
            pass_id: PASS_DCE,
            required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA |
                               ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ESCAPE_INFO,
            required_proofs: PROP_MASK_PURE_CALL | PROP_MASK_DEAD_STORE,
            preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                                ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_LOOP_INFO,
            invalidated_analyses: ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_RANGE_INFO,
            preserved_properties: PROP_MASK_ALL,
            postconditions: POSTCOND_ALL,
        };
    }
    if pass_id == PASS_CFG_SIMPLIFY {
        return TransformationContract {
            pass_id: PASS_CFG_SIMPLIFY,
            required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO,
            required_proofs: PROP_MASK_REACHABLE,
            preserved_analyses: ANALYSIS_MASK_NONE,
            invalidated_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                                  ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_LOOP_INFO,
            preserved_properties: PROP_MASK_NO_ESCAPE | PROP_MASK_PURE_CALL,
            postconditions: POSTCOND_ALL,
        };
    }
    // Lowering / SSA / MemorySSA construction passes
    TransformationContract {
        pass_id: pass_id,
        required_analyses: ANALYSIS_MASK_CFG,
        required_proofs: PROP_MASK_NONE,
        preserved_analyses: ANALYSIS_MASK_ALL,
        invalidated_analyses: ANALYSIS_MASK_NONE,
        preserved_properties: PROP_MASK_ALL,
        postconditions: POSTCOND_ALL,
    }
}

// --- OptProfile, OptBudget & Fact-Driven Pass Scheduling (AXS-OPT-033, REQ-OPT-065, REQ-OPT-373..374) ---

pub fn opt_budget_for_profile(profile: u8, verify_each: bool) -> OptBudget {
    if profile == OPT_PROFILE_DEBUG_O0 {
        return OptBudget {
            profile: OPT_PROFILE_DEBUG_O0,
            verify_each: verify_each,
            max_fixedpoint_rounds: 0u32,
            max_ir_insts_per_fn: 100000u32,
            max_symbolic_steps: 64u32,
            inline_cost_threshold: 0u32,
        };
    }
    if profile == OPT_PROFILE_BALANCED_O1 {
        return OptBudget {
            profile: OPT_PROFILE_BALANCED_O1,
            verify_each: verify_each,
            max_fixedpoint_rounds: 2u32,
            max_ir_insts_per_fn: 50000u32,
            max_symbolic_steps: 128u32,
            inline_cost_threshold: 25u32,
        };
    }
    if profile == OPT_PROFILE_SIZE_OS {
        return OptBudget {
            profile: OPT_PROFILE_SIZE_OS,
            verify_each: verify_each,
            max_fixedpoint_rounds: 2u32,
            max_ir_insts_per_fn: 50000u32,
            max_symbolic_steps: 128u32,
            inline_cost_threshold: 10u32,
        };
    }
    // Default / OPT_PROFILE_SPEED_O2 (-O2 / -O3)
    OptBudget {
        profile: OPT_PROFILE_SPEED_O2,
        verify_each: verify_each,
        max_fixedpoint_rounds: 4u32,
        max_ir_insts_per_fn: 100000u32,
        max_symbolic_steps: 256u32,
        inline_cost_threshold: 75u32,
    }
}

pub fn passmgr_collect_body_facts(body: view<OptBody>) -> BodyFacts {
    let mut sroa_cands: u32 = 0u32;
    let mut l: usize = 0;
    while l < body.local_count {
        if (body.local_modes as usize) != 0 {
            let mode = unsafe { *opt_u8_at(body.local_modes, l) };
            if mode == OPT_LOCAL_SROA {
                sroa_cands = sroa_cands + 1u32;
            }
        }
        l = l + 1;
    }

    let mut total_insts: u32 = 0u32;
    let mut mem_ops: u32 = 0u32;
    let mut branches: u32 = 0u32;
    let mut calls: u32 = 0u32;
    let mut backedges: u32 = 0u32;
    let mut binops: u32 = 0u32;

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        total_insts = total_insts + (icnt as u32);
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at(insts, i) };
            let opc = unsafe { (*inst).opcode };
            if opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP {
                binops = binops + 1u32;
            }
            if (unsafe { (*inst).mem_use.v }) != MEM_SSA_NONE || (unsafe { (*inst).mem_def.v }) != MEM_SSA_NONE {
                mem_ops = mem_ops + 1u32;
            }
            i = i + 1;
        }
        if unsafe { (*bb).has_term } {
            let tk = unsafe { (*bb).term.kind };
            if tk == OPT_TERM_BRANCH || tk == OPT_TERM_SWITCH_INT {
                branches = branches + 1u32;
            } else if tk == OPT_TERM_CALL {
                calls = calls + 1u32;
                mem_ops = mem_ops + 1u32;
            }
        }
        let u_rpo = unsafe { (*bb).rpo_idx };
        let scnt = unsafe { (*bb).succ_count };
        let succs = unsafe { (*bb).succs };
        let mut s: usize = 0;
        while s < scnt {
            let sv = (unsafe { (*opt_bbid_at(succs, s)).v }) as usize;
            if sv < body.bb_count {
                let sbb = unsafe { opt_block_at(body.blocks, sv) };
                let v_rpo = unsafe { (*sbb).rpo_idx };
                if (unsafe { (*bb).is_reachable }) && (unsafe { (*sbb).is_reachable }) &&
                   u_rpo != OPT_BB_NONE && v_rpo != OPT_BB_NONE && v_rpo <= u_rpo {
                    backedges = backedges + 1u32;
                }
            }
            s = s + 1;
        }
        b = b + 1;
    }

    BodyFacts {
        bb_count: body.bb_count as u32,
        inst_count: total_insts,
        sroa_candidate_count: sroa_cands,
        memory_op_count: mem_ops,
        branch_count: branches,
        call_count: calls,
        loop_backedge_count: backedges,
        binop_count: binops,
    }
}

pub fn passmgr_should_schedule_pass(
    pass_id: u16,
    budget: view<OptBudget>,
    facts: view<BodyFacts>
) -> bool {
    // 1. -O0 Debug profile disables all optional optimization passes (REQ-OPT-373)
    if budget.profile == OPT_PROFILE_DEBUG_O0 {
        return false;
    }
    // 2. Budget ceiling guard: skip pass cleanly if IR instruction count exceeds budget (REQ-OPT-374)
    if facts.inst_count > budget.max_ir_insts_per_fn {
        return false;
    }
    // 3. Fact-driven skipping (AXS-OPT-033):
    if pass_id == PASS_SROA {
        return facts.sroa_candidate_count > 0u32;
    }
    if pass_id == PASS_GVN_CSE {
        if budget.profile == OPT_PROFILE_BALANCED_O1 {
            // -O1 skips full GVN/CSE unless both binops and memory ops exist
            return facts.binop_count > 1u32;
        }
        return facts.binop_count > 0u32 || facts.memory_op_count > 0u32;
    }
    if pass_id == PASS_CFG_SIMPLIFY {
        return facts.bb_count > 1u32 || facts.branch_count > 0u32;
    }
    if pass_id == PASS_SCCP || pass_id == PASS_INST_COMBINE || pass_id == PASS_DCE {
        return facts.inst_count > 0u32 || facts.branch_count > 0u32;
    }
    true
}

// --- PassManager Initialization & Analysis Orchestrator (AXS-OPT-030) ---

pub fn passmgr_init(pm: mut_view<PassManager>, budget: OptBudget, arena: mut_view<Arena>) {
    pm.budget = budget;
    pm.valid_analyses = ANALYSIS_MASK_NONE;
    pm.ir_revision = 0u32;
    pm.analysis_revs = arena_alloc_raw(mut_view(*arena), pm_mul_usize(ANALYSIS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;
    pm.analysis_compute_counts = arena_alloc_raw(mut_view(*arena), pm_mul_usize(ANALYSIS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;
    pm.analysis_invalidation_counts = arena_alloc_raw(mut_view(*arena), pm_mul_usize(ANALYSIS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;
    pm.pass_run_counts = arena_alloc_raw(mut_view(*arena), pm_mul_usize(PASS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;
    pm.pass_skip_counts = arena_alloc_raw(mut_view(*arena), pm_mul_usize(PASS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;
    pm.pass_change_counts = arena_alloc_raw(mut_view(*arena), pm_mul_usize(PASS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;
    pm.pass_rollback_counts = arena_alloc_raw(mut_view(*arena), pm_mul_usize(PASS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;

    let mut i: usize = 0;
    while i < ANALYSIS_COUNT {
        unsafe {
            *opt_u32_at(pm.analysis_revs, i) = 0u32;
            *opt_u32_at(pm.analysis_compute_counts, i) = 0u32;
            *opt_u32_at(pm.analysis_invalidation_counts, i) = 0u32;
        }
        i = i + 1;
    }
    let mut p: usize = 0;
    while p < PASS_COUNT {
        unsafe {
            *opt_u32_at(pm.pass_run_counts, p) = 0u32;
            *opt_u32_at(pm.pass_skip_counts, p) = 0u32;
            *opt_u32_at(pm.pass_change_counts, p) = 0u32;
            *opt_u32_at(pm.pass_rollback_counts, p) = 0u32;
        }
        p = p + 1;
    }
    pm.verify_run_count = 0u32;
    pm.verify_fail_count = 0u32;
    pm.fixedpoint_rounds_executed = 0u32;
    pm.last_verify_status = CONTRACT_OK;
    pm.last_effect_summary = effect_summary_empty(SymbolId { v: 0u32 });
    pm.baseline_effect_summary = effect_summary_empty(SymbolId { v: 0u32 });
    pm.has_baseline_effects = false;
}

pub fn passmgr_get_analysis_rev(pm: view<PassManager>, analysis_id: u8) -> u32 {
    if (analysis_id as usize) >= ANALYSIS_COUNT || (pm.analysis_revs as usize) == 0 {
        return 0u32;
    }
    unsafe { *opt_u32_at(pm.analysis_revs, analysis_id as usize) }
}

pub fn passmgr_get_analysis_compute_count(pm: view<PassManager>, analysis_id: u8) -> u32 {
    if (analysis_id as usize) >= ANALYSIS_COUNT || (pm.analysis_compute_counts as usize) == 0 {
        return 0u32;
    }
    unsafe { *opt_u32_at(pm.analysis_compute_counts, analysis_id as usize) }
}

pub fn passmgr_get_analysis_invalidation_count(pm: view<PassManager>, analysis_id: u8) -> u32 {
    if (analysis_id as usize) >= ANALYSIS_COUNT || (pm.analysis_invalidation_counts as usize) == 0 {
        return 0u32;
    }
    unsafe { *opt_u32_at(pm.analysis_invalidation_counts, analysis_id as usize) }
}

pub fn passmgr_get_pass_run_count(pm: view<PassManager>, pass_id: u16) -> u32 {
    if (pass_id as usize) >= PASS_COUNT || (pm.pass_run_counts as usize) == 0 {
        return 0u32;
    }
    unsafe { *opt_u32_at(pm.pass_run_counts, pass_id as usize) }
}

pub fn passmgr_get_pass_skip_count(pm: view<PassManager>, pass_id: u16) -> u32 {
    if (pass_id as usize) >= PASS_COUNT || (pm.pass_skip_counts as usize) == 0 {
        return 0u32;
    }
    unsafe { *opt_u32_at(pm.pass_skip_counts, pass_id as usize) }
}

pub fn passmgr_get_pass_change_count(pm: view<PassManager>, pass_id: u16) -> u32 {
    if (pass_id as usize) >= PASS_COUNT || (pm.pass_change_counts as usize) == 0 {
        return 0u32;
    }
    unsafe { *opt_u32_at(pm.pass_change_counts, pass_id as usize) }
}

pub fn passmgr_get_pass_rollback_count(pm: view<PassManager>, pass_id: u16) -> u32 {
    if (pass_id as usize) >= PASS_COUNT || (pm.pass_rollback_counts as usize) == 0 {
        return 0u32;
    }
    unsafe { *opt_u32_at(pm.pass_rollback_counts, pass_id as usize) }
}

pub fn passmgr_is_analysis_valid(pm: view<PassManager>, analysis_id: u8) -> bool {
    let bit = analysis_bit(analysis_id);
    if bit == 0u32 || (pm.valid_analyses & bit) == 0u32 {
        return false;
    }
    passmgr_get_analysis_rev(pm, analysis_id) == pm.ir_revision
}

pub fn passmgr_mark_all_valid_from_lowering(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    arena: mut_view<Arena>
) {
    let rev: u32 = if pm.ir_revision == 0u32 { 1u32 } else { pm.ir_revision };
    pm.ir_revision = rev;
    let eff_sum = effect_infer_body(mut_view(*body), mut_view(*arena), pm.budget.max_symbolic_steps);
    pm.last_effect_summary = eff_sum;
    if !pm.has_baseline_effects {
        pm.baseline_effect_summary = eff_sum;
        pm.has_baseline_effects = true;
    }
    pm.valid_analyses = ANALYSIS_MASK_ALL;
    let mut i: usize = 0;
    while i < ANALYSIS_COUNT {
        unsafe {
            *opt_u32_at(pm.analysis_revs, i) = rev;
            let c = *opt_u32_at(pm.analysis_compute_counts, i);
            *opt_u32_at(pm.analysis_compute_counts, i) = c + 1u32;
        }
        i = i + 1;
    }
}

pub fn passmgr_invalidate_analyses(pm: mut_view<PassManager>, directly_invalidated: u32) {
    let expanded_inv = analysis_expand_invalidated(directly_invalidated);
    let mut i: u8 = 0u8;
    while (i as usize) < ANALYSIS_COUNT {
        let bit = analysis_bit(i);
        if (expanded_inv & bit) != 0u32 && (pm.valid_analyses & bit) != 0u32 {
            let old_inv = unsafe { *opt_u32_at(pm.analysis_invalidation_counts, i as usize) };
            unsafe { *opt_u32_at(pm.analysis_invalidation_counts, i as usize) = old_inv + 1u32; }
        }
        i = i + 1u8;
    }
    pm.valid_analyses = pm.valid_analyses & (ANALYSIS_MASK_ALL ^ (expanded_inv & ANALYSIS_MASK_ALL));
}

pub fn passmgr_ensure_analyses(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    required_mask: u32
) {
    if pm.ir_revision == 0u32 {
        pm.ir_revision = 1u32;
    }
    let needed = analysis_expand_required(required_mask);
    // Recompute missing or stale analyses in topological DAG order (0..9)
    let mut i: u8 = 0u8;
    while (i as usize) < ANALYSIS_COUNT {
        let bit = analysis_bit(i);
        if (needed & bit) != 0u32 && !passmgr_is_analysis_valid(view(*pm), i) {
            if i == ANALYSIS_CFG {
                optir_compute_cfg(mut_view(*body), mut_view(*arena));
            } else if i == ANALYSIS_DOMINATORS {
                optir_compute_dominators(mut_view(*body), mut_view(*arena));
                optir_compute_dom_frontier(mut_view(*body), mut_view(*arena));
            } else if i == ANALYSIS_SSA {
                optir_simplify_trivial_phis(mut_view(*body));
            } else if i == ANALYSIS_MEMORY_SSA {
                optir_construct_memssa(mut_view(*body), mut_view(*arena));
            } else if i == ANALYSIS_EFFECT_INFO {
                let eff_sum = effect_infer_body(mut_view(*body), mut_view(*arena), pm.budget.max_symbolic_steps);
                pm.last_effect_summary = eff_sum;
                if !pm.has_baseline_effects {
                    pm.baseline_effect_summary = eff_sum;
                    pm.has_baseline_effects = true;
                }
            } else if i == ANALYSIS_RANGE_INFO {
                optir_analyze_ranges_and_provenance(mut_view(*body), mut_view(*arena), pm.budget.max_symbolic_steps);
            }
            // ANALYSIS_ALIAS_INFO, ANALYSIS_ESCAPE_INFO, ANALYSIS_LOOP_INFO are derived on top of valid CFG/Dom/SSA/MemSSA
            pm.valid_analyses = pm.valid_analyses | bit;
            unsafe {
                *opt_u32_at(pm.analysis_revs, i as usize) = pm.ir_revision;
                let prev_c = *opt_u32_at(pm.analysis_compute_counts, i as usize);
                *opt_u32_at(pm.analysis_compute_counts, i as usize) = prev_c + 1u32;
            }
        }
        i = i + 1u8;
    }
}

// --- Two-Stage Candidate Legality & Proof Verifier (AXS-OPT-032, REQ-OPT-060..065, REQ-OPT-332, REQ-OPT-402, REQ-OPT-405) ---

pub fn passmgr_forbids_capability_promotion(src_view_kind: u8, dst_view_kind: u8) -> bool {
    // REQ-OPT-064: Shared capability view<T> (MIR_VIEW_READ) may NEVER be promoted to exclusive mutable mut_view<T> (MIR_VIEW_MUT).
    src_view_kind == MIR_VIEW_READ && dst_view_kind == MIR_VIEW_MUT
}

pub fn passmgr_forbids_type_capability_promotion(thir: *const Thir, src_ty: TypeId, dst_ty: TypeId) -> bool {
    let sk = pm_type_kind(thir, src_ty);
    let dk = pm_type_kind(thir, dst_ty);
    sk == TY_VIEW && dk == TY_MUT_VIEW
}

pub fn passmgr_verify_candidate_legality(
    pm: view<PassManager>,
    candidate: view<CandidateRewrite>
) -> u8 {
    // Stage 1: Legality Proof Gate (always precedes Stage 2 Cost Model Gate per AXS-OPT-032)
    let contract = passmgr_contract_for_pass(candidate.pass_id);

    // 1. Check all required analyses for the pass and for the proof's source analysis are valid at current ir_revision
    let req_mask = contract.required_analyses | analysis_bit(candidate.proof_source_analysis);
    let mut a: u8 = 0u8;
    while (a as usize) < ANALYSIS_COUNT {
        let bit = analysis_bit(a);
        if (req_mask & bit) != 0u32 && !passmgr_is_analysis_valid(view(*pm), a) {
            return CONTRACT_ERR_MISSING_ANALYSIS;
        }
        a = a + 1u8;
    }

    // 2. Reject stale proof provenance from an earlier IR revision
    if candidate.proof_revision != pm.ir_revision {
        return CONTRACT_ERR_STALE_PROOF_REVISION;
    }

    // 3. Reject forbidden capability promotion (view<T> -> mut_view<T>, REQ-OPT-064)
    if passmgr_forbids_capability_promotion(candidate.src_view_kind, candidate.dst_view_kind) {
        return CONTRACT_ERR_CAPABILITY_PROMOTION;
    }

    // 4. Reject removal of observable effects, volatile/atomic accesses, panics, or security barriers (REQ-OPT-061..063)
    if candidate.is_removing_inst && !effect_can_dce(candidate.target_effect_flags) {
        return CONTRACT_ERR_OBSERVABLE_EFFECT_LOSS;
    }

    // 5. Three-valued certainty gate: only CERTAINTY_PROVEN authorizes semantic rewrites (REQ-OPT-402, REQ-OPT-405)
    // CERTAINTY_POSSIBLE and CERTAINTY_UNKNOWN fail closed regardless of cost model profitability!
    if candidate.proof_certainty != CERTAINTY_PROVEN {
        return CONTRACT_ERR_NON_PROVEN_CERTAINTY;
    }

    CONTRACT_OK
}

pub fn passmgr_evaluate_candidate(
    pm: view<PassManager>,
    candidate: view<CandidateRewrite>
) -> u8 {
    // Stage 1: Legality Proof Gate
    let leg = passmgr_verify_candidate_legality(pm, candidate);
    if leg != CONTRACT_OK {
        return leg;
    }
    // Stage 2: Cost Model Gate (only consulted after Stage 1 Proven legality succeeds per AXS-OPT-032)
    if candidate.cost_delta > 0i32 {
        return CONTRACT_ERR_COST_UNPROFITABLE;
    }
    CONTRACT_OK
}

pub fn passmgr_find_proven_property(
    body: view<OptBody>,
    prop_kind: u8,
    subject_val: OptValueId,
    at_bb: OptBbId,
    at_inst: OptInstId
) -> u8 {
    let mut best_cert = CERTAINTY_UNKNOWN;
    let mut i: usize = 0;
    while i < body.provenance_count {
        let pv = unsafe { opt_prov_at(body.provenance, i) };
        if (unsafe { (*pv).prop_kind }) == prop_kind {
            let match_val = subject_val.v == OPT_VALUE_NONE || (unsafe { (*pv).subject_val.v }) == subject_val.v;
            let match_bb = at_bb.v == OPT_BB_NONE || (unsafe { (*pv).at_bb.v }) == at_bb.v;
            let match_inst = at_inst.v == OPT_INST_NONE || (unsafe { (*pv).at_inst.v }) == at_inst.v;
            if match_val && match_bb && match_inst {
                let c = unsafe { (*pv).certainty };
                if c == CERTAINTY_PROVEN {
                    return CERTAINTY_PROVEN;
                }
                if c == CERTAINTY_POSSIBLE {
                    best_cert = CERTAINTY_POSSIBLE;
                }
            }
        }
        i = i + 1;
    }
    best_cert
}

// --- Snapshot & Rollback for Postcondition Failure Recovery (AXS-OPT-034, REQ-OPT-404) ---

pub fn passmgr_snapshot_body(body: view<OptBody>, arena: mut_view<Arena>) -> OptBodySnapshot {
    let n = body.bb_count;
    let alloc_n: usize = if n == 0 { 1 } else { n };
    let blocks_cp = arena_alloc_raw(mut_view(*arena), pm_mul_usize(alloc_n, size_of<OptBlock>()), align_of<OptBlock>()) as *mut OptBlock;
    let phis_cp = arena_alloc_raw(mut_view(*arena), pm_mul_usize(alloc_n, size_of<*mut OptPhi>()), align_of<*mut OptPhi>()) as *mut *mut OptPhi;
    let insts_cp = arena_alloc_raw(mut_view(*arena), pm_mul_usize(alloc_n, size_of<*mut OptInst>()), align_of<*mut OptInst>()) as *mut *mut OptInst;
    let preds_cp = arena_alloc_raw(mut_view(*arena), pm_mul_usize(alloc_n, size_of<*mut OptBbId>()), align_of<*mut OptBbId>()) as *mut *mut OptBbId;
    let succs_cp = arena_alloc_raw(mut_view(*arena), pm_mul_usize(alloc_n, size_of<*mut OptBbId>()), align_of<*mut OptBbId>()) as *mut *mut OptBbId;
    let mphi_cp = arena_alloc_raw(mut_view(*arena), pm_mul_usize(alloc_n, size_of<*mut MemSsaId>()), align_of<*mut MemSsaId>()) as *mut *mut MemSsaId;

    let mut b: usize = 0;
    while b < n {
        let src_bb = unsafe { opt_block_at(body.blocks, b) };
        let dst_bb = unsafe { opt_block_at(blocks_cp, b) };
        unsafe {
            ptr_copy_nonoverlapping<u8>(src_bb as *const u8, dst_bb as *mut u8, size_of<OptBlock>());
        }
        let pcnt = unsafe { (*src_bb).phi_count };
        if pcnt > 0 && ((unsafe { (*src_bb).phis }) as usize) != 0 {
            let p_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(pcnt, size_of<OptPhi>()), align_of<OptPhi>()) as *mut OptPhi;
            unsafe {
                ptr_copy_nonoverlapping<u8>((*src_bb).phis as *const u8, p_arr as *mut u8, pm_mul_usize(pcnt, size_of<OptPhi>()));
                *pm_ptr_phi_at(phis_cp, b) = p_arr;
            }
        } else {
            unsafe { *pm_ptr_phi_at(phis_cp, b) = 0 as *mut OptPhi; }
        }

        let icnt = unsafe { (*src_bb).inst_count };
        if icnt > 0 && ((unsafe { (*src_bb).insts }) as usize) != 0 {
            let i_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(icnt, size_of<OptInst>()), align_of<OptInst>()) as *mut OptInst;
            unsafe {
                ptr_copy_nonoverlapping<u8>((*src_bb).insts as *const u8, i_arr as *mut u8, pm_mul_usize(icnt, size_of<OptInst>()));
                *pm_ptr_inst_at(insts_cp, b) = i_arr;
            }
        } else {
            unsafe { *pm_ptr_inst_at(insts_cp, b) = 0 as *mut OptInst; }
        }

        let pr_cnt = unsafe { (*src_bb).pred_count };
        if pr_cnt > 0 && ((unsafe { (*src_bb).preds }) as usize) != 0 {
            let pr_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(pr_cnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
            unsafe {
                ptr_copy_nonoverlapping<u8>((*src_bb).preds as *const u8, pr_arr as *mut u8, pm_mul_usize(pr_cnt, size_of<OptBbId>()));
                *pm_ptr_bbid_at(preds_cp, b) = pr_arr;
            }
        } else {
            unsafe { *pm_ptr_bbid_at(preds_cp, b) = 0 as *mut OptBbId; }
        }

        let su_cnt = unsafe { (*src_bb).succ_count };
        if su_cnt > 0 && ((unsafe { (*src_bb).succs }) as usize) != 0 {
            let su_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(su_cnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
            unsafe {
                ptr_copy_nonoverlapping<u8>((*src_bb).succs as *const u8, su_arr as *mut u8, pm_mul_usize(su_cnt, size_of<OptBbId>()));
                *pm_ptr_bbid_at(succs_cp, b) = su_arr;
            }
        } else {
            unsafe { *pm_ptr_bbid_at(succs_cp, b) = 0 as *mut OptBbId; }
        }

        if (unsafe { (*src_bb).has_mem_phi }) && pr_cnt > 0 && ((unsafe { (*src_bb).mem_phi_inputs }) as usize) != 0 {
            let mp_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(pr_cnt, size_of<MemSsaId>()), align_of<MemSsaId>()) as *mut MemSsaId;
            unsafe {
                ptr_copy_nonoverlapping<u8>((*src_bb).mem_phi_inputs as *const u8, mp_arr as *mut u8, pm_mul_usize(pr_cnt, size_of<MemSsaId>()));
                *pm_ptr_memid_at(mphi_cp, b) = mp_arr;
            }
        } else {
            unsafe { *pm_ptr_memid_at(mphi_cp, b) = 0 as *mut MemSsaId; }
        }
        b = b + 1;
    }

    let rcnt = body.rpo_count;
    let rpo_cp: *mut OptBbId = if rcnt > 0 && (body.rpo_order as usize) != 0 {
        let r_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(rcnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
        unsafe {
            ptr_copy_nonoverlapping<u8>(body.rpo_order as *const u8, r_arr as *mut u8, pm_mul_usize(rcnt, size_of<OptBbId>()));
        }
        r_arr
    } else {
        0 as *mut OptBbId
    };

    let vcnt = body.value_count;
    let vals_cp: *mut OptValue = if vcnt > 0 && (body.values as usize) != 0 {
        let v_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(vcnt + 1, size_of<OptValue>()), align_of<OptValue>()) as *mut OptValue;
        unsafe {
            ptr_copy_nonoverlapping<u8>(body.values as *const u8, v_arr as *mut u8, pm_mul_usize(vcnt + 1, size_of<OptValue>()));
        }
        v_arr
    } else {
        0 as *mut OptValue
    };

    let mcnt = body.mem_ssa_count;
    let mdefs_cp: *mut MemSsaDefNode = if mcnt > 0 && (body.mem_defs as usize) != 0 {
        let m_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(mcnt, size_of<MemSsaDefNode>()), align_of<MemSsaDefNode>()) as *mut MemSsaDefNode;
        unsafe {
            ptr_copy_nonoverlapping<u8>(body.mem_defs as *const u8, m_arr as *mut u8, pm_mul_usize(mcnt, size_of<MemSsaDefNode>()));
        }
        m_arr
    } else {
        0 as *mut MemSsaDefNode
    };

    let pvcnt = body.provenance_count;
    let prov_cp: *mut ProofProvenance = if pvcnt > 0 && (body.provenance as usize) != 0 {
        let pv_arr = arena_alloc_raw(mut_view(*arena), pm_mul_usize(pvcnt, size_of<ProofProvenance>()), align_of<ProofProvenance>()) as *mut ProofProvenance;
        unsafe {
            ptr_copy_nonoverlapping<u8>(body.provenance as *const u8, pv_arr as *mut u8, pm_mul_usize(pvcnt, size_of<ProofProvenance>()));
        }
        pv_arr
    } else {
        0 as *mut ProofProvenance
    };

    OptBodySnapshot {
        bb_count: n,
        blocks_copy: blocks_cp,
        block_phis_copy: phis_cp,
        block_insts_copy: insts_cp,
        block_preds_copy: preds_cp,
        block_succs_copy: succs_cp,
        block_mphi_copy: mphi_cp,
        rpo_count: rcnt,
        rpo_copy: rpo_cp,
        value_count: vcnt,
        values_copy: vals_cp,
        mem_ssa_count: mcnt,
        mem_defs_copy: mdefs_cp,
        provenance_count: pvcnt,
        provenance_copy: prov_cp,
        ranges_ptr: body.ranges,
    }
}

pub fn passmgr_rollback_body(
    body: mut_view<OptBody>,
    snap: view<OptBodySnapshot>,
    arena: mut_view<Arena>
) {
    let _ = arena;
    body.bb_count = snap.bb_count;
    let mut b: usize = 0;
    while b < snap.bb_count {
        let src_bb = unsafe { opt_block_at(snap.blocks_copy, b) };
        let dst_bb = unsafe { opt_block_at(body.blocks, b) };
        unsafe {
            ptr_copy_nonoverlapping<u8>(src_bb as *const u8, dst_bb as *mut u8, size_of<OptBlock>());
            let p_arr = *pm_ptr_phi_at(snap.block_phis_copy, b);
            if (p_arr as usize) != 0 && (*dst_bb).phi_count > 0 && ((*dst_bb).phis as usize) != 0 {
                ptr_copy_nonoverlapping<u8>(p_arr as *const u8, (*dst_bb).phis as *mut u8, pm_mul_usize((*dst_bb).phi_count, size_of<OptPhi>()));
            }
            let i_arr = *pm_ptr_inst_at(snap.block_insts_copy, b);
            if (i_arr as usize) != 0 && (*dst_bb).inst_count > 0 && ((*dst_bb).insts as usize) != 0 {
                ptr_copy_nonoverlapping<u8>(i_arr as *const u8, (*dst_bb).insts as *mut u8, pm_mul_usize((*dst_bb).inst_count, size_of<OptInst>()));
            }
            let pr_arr = *pm_ptr_bbid_at(snap.block_preds_copy, b);
            if (pr_arr as usize) != 0 && (*dst_bb).pred_count > 0 && ((*dst_bb).preds as usize) != 0 {
                ptr_copy_nonoverlapping<u8>(pr_arr as *const u8, (*dst_bb).preds as *mut u8, pm_mul_usize((*dst_bb).pred_count, size_of<OptBbId>()));
            }
            let su_arr = *pm_ptr_bbid_at(snap.block_succs_copy, b);
            if (su_arr as usize) != 0 && (*dst_bb).succ_count > 0 && ((*dst_bb).succs as usize) != 0 {
                ptr_copy_nonoverlapping<u8>(su_arr as *const u8, (*dst_bb).succs as *mut u8, pm_mul_usize((*dst_bb).succ_count, size_of<OptBbId>()));
            }
            let mp_arr = *pm_ptr_memid_at(snap.block_mphi_copy, b);
            if (mp_arr as usize) != 0 && (*dst_bb).has_mem_phi && (*dst_bb).pred_count > 0 && ((*dst_bb).mem_phi_inputs as usize) != 0 {
                ptr_copy_nonoverlapping<u8>(mp_arr as *const u8, (*dst_bb).mem_phi_inputs as *mut u8, pm_mul_usize((*dst_bb).pred_count, size_of<MemSsaId>()));
            }
        }
        b = b + 1;
    }

    body.rpo_count = snap.rpo_count;
    if snap.rpo_count > 0 && (snap.rpo_copy as usize) != 0 && (body.rpo_order as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(snap.rpo_copy as *const u8, body.rpo_order as *mut u8, pm_mul_usize(snap.rpo_count, size_of<OptBbId>()));
        }
    }
    body.value_count = snap.value_count;
    if snap.value_count > 0 && (snap.values_copy as usize) != 0 && (body.values as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(snap.values_copy as *const u8, body.values as *mut u8, pm_mul_usize(snap.value_count + 1, size_of<OptValue>()));
        }
    }
    body.mem_ssa_count = snap.mem_ssa_count;
    if snap.mem_ssa_count > 0 && (snap.mem_defs_copy as usize) != 0 && (body.mem_defs as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(snap.mem_defs_copy as *const u8, body.mem_defs as *mut u8, pm_mul_usize(snap.mem_ssa_count, size_of<MemSsaDefNode>()));
        }
    }
    body.provenance_count = snap.provenance_count;
    if snap.provenance_count > 0 && (snap.provenance_copy as usize) != 0 && (body.provenance as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(snap.provenance_copy as *const u8, body.provenance as *mut u8, pm_mul_usize(snap.provenance_count, size_of<ProofProvenance>()));
        }
    }
    body.ranges = snap.ranges_ptr;
}

// --- Post-Pass Contract & Proof Verifier (AXS-OPT-034, REQ-OPT-064, REQ-OPT-361, REQ-OPT-404) ---

fn pm_verify_body_capabilities(body: view<OptBody>) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                // Check destination place view capability on shared view<T> locals
                let dlv = (unsafe { (*inst).place.local.v }) as usize;
                if dlv < body.local_count && (body.local_tys as usize) != 0 {
                    let lty = unsafe { *opt_typeid_at(body.local_tys, dlv) };
                    let tk = pm_type_kind(body.thir, lty);
                    if tk == TY_VIEW {
                        if (unsafe { (*inst).place.view_kind }) == MIR_VIEW_MUT {
                            return false;
                        }
                        if opc == OPT_INST_STORE && (unsafe { (*inst).place.proj_count }) > 0 {
                            return false;
                        }
                    }
                }
                // Check rhs_place view capability on shared view<T> locals
                let rlv = (unsafe { (*inst).rhs_place.local.v }) as usize;
                if rlv < body.local_count && (body.local_tys as usize) != 0 {
                    let rty = unsafe { *opt_typeid_at(body.local_tys, rlv) };
                    let rtk = pm_type_kind(body.thir, rty);
                    if rtk == TY_VIEW {
                        if (unsafe { (*inst).rhs_place.view_kind }) == MIR_VIEW_MUT {
                            return false;
                        }
                        if opc == OPT_INST_ADDR_OF && (unsafe { (*inst).sub_op }) == MIR_VIEW_MUT {
                            return false;
                        }
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    true
}

pub fn passmgr_verify_postconditions(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    pass_id: u16,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> u8 {
    let contract = passmgr_contract_for_pass(pass_id);
    pm.verify_run_count = pm.verify_run_count + 1u32;

    // 1. Check structural CFG, DominatorTree, SSA, and MemorySSA invariants BEFORE recomputing cached analyses
    // so corrupted cached analyses (e.g. broken idom or dangling SSA/MemSSA IDs) are caught immediately.
    if (contract.postconditions & (POSTCOND_CFG_VALID | POSTCOND_DOM_VALID | POSTCOND_SSA_VALID | POSTCOND_MEMSSA_VALID)) != 0u32 {
        // Recompute only analyses that the pass explicitly invalidated
        let inv_mask = contract.invalidated_analyses & (ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA);
        if inv_mask != 0u32 {
            passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), inv_mask);
        }
        if !optir_verify_contract(view(*body)) {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_POSTCOND_CFG_DOM;
            return CONTRACT_ERR_POSTCOND_CFG_DOM;
        }
    }

    // 2. Check capability preservation (no view<T> -> mut_view<T> promotion, REQ-OPT-064)
    if (contract.postconditions & POSTCOND_CAPABILITY_PRESERVED) != 0u32 {
        if !pm_verify_body_capabilities(view(*body)) {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_CAPABILITY_PROMOTION;
            return CONTRACT_ERR_CAPABILITY_PROMOTION;
        }
    }

    // 3. Check observable effect preservation (no lost volatile, atomic, I/O, or drop operations, REQ-OPT-061..063)
    if (contract.postconditions & POSTCOND_EFFECTS_PRESERVED) != 0u32 {
        let cur_eff = effect_infer_body(mut_view(*body), mut_view(*arena), pm.budget.max_symbolic_steps);
        pm.last_effect_summary = cur_eff;
        if pm.has_baseline_effects {
            let cur_vol = cur_eff.volatile_count;
            let base_vol = pm.baseline_effect_summary.volatile_count;
            let cur_ato = cur_eff.atomic_count;
            let base_ato = pm.baseline_effect_summary.atomic_count;
            let cur_io = cur_eff.io_count;
            let base_io = pm.baseline_effect_summary.io_count;
            let cur_drp = cur_eff.drop_count;
            let base_drp = pm.baseline_effect_summary.drop_count;
            if cur_vol < base_vol || cur_ato < base_ato || cur_io < base_io || cur_drp < base_drp {
                pm.verify_fail_count = pm.verify_fail_count + 1u32;
                pm.last_verify_status = CONTRACT_ERR_POSTCOND_EFFECTS;
                return CONTRACT_ERR_POSTCOND_EFFECTS;
            }
        }
    }

    // 4. Reconstruct MirBody and run Verified MIR checker (AXS-OPT-034, REQ-OPT-361)
    if (contract.postconditions & POSTCOND_VERIFIED_MIR) != 0u32 {
        let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
        if !optir_reconstruct_mir(view(*body), unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_POSTCOND_MIR_VERIFY;
            return CONTRACT_ERR_POSTCOND_MIR_VERIFY;
        }
        let prev_errs = sink.errors;
        verify_mir(unsafe { view(*rec_mir) }, body.thir, mut_view(*sink), 0 as *const HirItem);
        if sink.errors != prev_errs {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_POSTCOND_MIR_VERIFY;
            return CONTRACT_ERR_POSTCOND_MIR_VERIFY;
        }
    }

    pm.last_verify_status = CONTRACT_OK;
    CONTRACT_OK
}

// --- Proof-Gated Pass Implementations over OptIR ---

pub fn pm_value_is_const_int(
    pm: view<PassManager>,
    body: view<OptBody>,
    val_id: OptValueId,
    out_val: mut_view<u64>
) -> bool {
    if val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count {
        return false;
    }
    if passmgr_is_analysis_valid(view(*pm), ANALYSIS_SSA) && (body.values as usize) != 0 {
        let vp = unsafe { opt_val_at(body.values, val_id.v as usize) };
        if (unsafe { (*vp).kind }) == OPT_VAL_CONST {
            let ck = unsafe { (*vp).const_val.kind };
            if ck == MIR_CONST_INT || ck == MIR_CONST_BOOL {
                *out_val = unsafe { (*vp).const_val.val };
                return true;
            }
        }
    }
    if passmgr_is_analysis_valid(view(*pm), ANALYSIS_RANGE_INFO) && (body.ranges as usize) != 0 {
        let rp = unsafe { opt_range_at(body.ranges, val_id.v as usize) };
        if (unsafe { (*rp).has_range }) && !(unsafe { (*rp).has_fp_hazard }) &&
           (unsafe { (*rp).lo }) == (unsafe { (*rp).hi }) {
            *out_val = unsafe { (*rp).lo };
            return true;
        }
    }
    false
}

pub fn pm_value_has_fp_hazard(
    pm: view<PassManager>,
    body: view<OptBody>,
    val_id: OptValueId
) -> bool {
    if val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count {
        return false;
    }
    if !passmgr_is_analysis_valid(view(*pm), ANALYSIS_RANGE_INFO) || (body.ranges as usize) == 0 {
        return false;
    }
    let rp = unsafe { opt_range_at(body.ranges, val_id.v as usize) };
    unsafe { (*rp).has_fp_hazard }
}

fn pm_count_value_uses_excluding_inst(
    body: view<OptBody>,
    target_val: OptValueId,
    excl_inst_id: u32
) -> u32 {
    let tv = target_val.v;
    if tv == OPT_VALUE_NONE {
        return 0u32;
    }
    let mut uses: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let pcnt = unsafe { (*bb).phi_count };
            let phis = unsafe { (*bb).phis };
            let mut p: usize = 0;
            while p < pcnt {
                let phi = unsafe { opt_phi_at(phis, p) };
                let arity = unsafe { (*phi).arity };
                let incs = unsafe { (*phi).incoming_values };
                let mut k: usize = 0;
                while k < arity {
                    if (unsafe { (*opt_valid_at(incs, k)).v }) == tv {
                        uses = uses + 1u32;
                    }
                    k = k + 1;
                }
                p = p + 1;
            }
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let iid_v = unsafe { (*inst).id.v };
                if opc != OPT_INST_NOP && iid_v != excl_inst_id {
                    let lhs_v = unsafe { (*inst).lhs.v };
                    let res_v = unsafe { (*inst).result.v };
                    let is_const_self_ref = opc == OPT_INST_CONST && lhs_v == res_v;
                    if !is_const_self_ref && lhs_v == tv {
                        uses = uses + 1u32;
                    }
                    if (unsafe { (*inst).rhs.v }) == tv {
                        uses = uses + 1u32;
                    }
                    let eac = unsafe { (*inst).extra_arg_count };
                    let eargs = unsafe { (*inst).extra_args };
                    let mut ei: usize = 0;
                    while ei < eac {
                        if (unsafe { (*opt_valid_at(eargs, ei)).v }) == tv {
                            uses = uses + 1u32;
                        }
                        ei = ei + 1;
                    }
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                if (unsafe { (*bb).term.cond.v }) == tv { uses = uses + 1u32; }
                if (unsafe { (*bb).term.callee.v }) == tv { uses = uses + 1u32; }
                let cac = unsafe { (*bb).term.call_arg_count };
                let cargs = unsafe { (*bb).term.call_args };
                let mut ci: usize = 0;
                while ci < cac {
                    if (unsafe { (*opt_valid_at(cargs, ci)).v }) == tv {
                        uses = uses + 1u32;
                    }
                    ci = ci + 1;
                }
            }
        }
        b = b + 1;
    }
    uses
}

pub fn pm_count_value_uses(body: view<OptBody>, target_val: OptValueId) -> u32 {
    pm_count_value_uses_excluding_inst(body, target_val, OPT_INST_NONE)
}

fn pm_mir_place_proj_reads_local(pl: view<MirPlace>, loc_v: u32) -> bool {
    if pl.proj_count == 0 || (pl.projs as usize) == 0 {
        return false;
    }
    let mut p: usize = 0;
    while p < pl.proj_count {
        let pr = unsafe { mir_proj_at(pl.projs, p) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX && (unsafe { (*pr).index_local.v }) == loc_v {
            return true;
        }
        if pk == MIR_PROJ_SUB_SLICE {
            if (unsafe { (*pr).has_from }) && (unsafe { (*pr).from_local.v }) == loc_v {
                return true;
            }
            if (unsafe { (*pr).has_to }) && (unsafe { (*pr).to_local.v }) == loc_v {
                return true;
            }
        }
        p = p + 1;
    }
    false
}

fn pm_mir_place_reads_local(pl: view<MirPlace>, loc_v: u32) -> bool {
    pl.local.v == loc_v || pm_mir_place_proj_reads_local(pl, loc_v)
}

fn pm_mir_op_reads_local(op: view<MirOperand>, loc_v: u32) -> bool {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        return pm_mir_place_reads_local(view(op.place), loc_v);
    }
    false
}

fn pm_mir_stmt_has_move_operand(st: view<MirStmt>) -> bool {
    if st.kind != MIR_STMT_ASSIGN {
        return false;
    }
    let rk = st.rvalue.kind;
    if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP || rk == MIR_RVALUE_CAST {
        return st.rvalue.use_op.kind == MIR_OP_MOVE;
    }
    if rk == MIR_RVALUE_REPEAT {
        if st.rvalue.use_op.kind == MIR_OP_MOVE {
            return true;
        }
        let rcop = st.rvalue.repeat_count_op;
        if (rcop as usize) != 0 && (unsafe { (*rcop).kind }) == MIR_OP_MOVE {
            return true;
        }
        return false;
    }
    if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        return st.rvalue.lhs.kind == MIR_OP_MOVE || st.rvalue.rhs.kind == MIR_OP_MOVE;
    }
    if rk == MIR_RVALUE_AGGREGATE {
        let mut idx: usize = 0;
        while idx < st.rvalue.operand_count {
            let op = unsafe { mir_op_at(st.rvalue.operands, idx) };
            if (unsafe { (*op).kind }) == MIR_OP_MOVE {
                return true;
            }
            idx = idx + 1;
        }
    }
    false
}

fn pm_mir_stmt_clobbers_or_moves_local(st: view<MirStmt>, loc_v: u32) -> bool {
    if st.kind == MIR_STMT_STORAGE_LIVE || st.kind == MIR_STMT_STORAGE_DEAD {
        return st.storage_local.v == loc_v;
    }
    if st.kind == MIR_STMT_DROP {
        return pm_mir_place_reads_local(view(st.place), loc_v);
    }
    if st.kind == MIR_STMT_ASSIGN {
        if st.place.local.v == loc_v {
            return true;
        }
        let rk = st.rvalue.kind;
        if rk == MIR_RVALUE_REF && st.rvalue.place.local.v == loc_v {
            return true;
        }
        if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP || rk == MIR_RVALUE_CAST {
            if st.rvalue.use_op.kind == MIR_OP_MOVE && st.rvalue.use_op.place.local.v == loc_v {
                return true;
            }
        } else if rk == MIR_RVALUE_REPEAT {
            if st.rvalue.use_op.kind == MIR_OP_MOVE && st.rvalue.use_op.place.local.v == loc_v {
                return true;
            }
            let rcop = st.rvalue.repeat_count_op;
            if (rcop as usize) != 0 &&
               (unsafe { (*rcop).kind }) == MIR_OP_MOVE &&
               (unsafe { (*rcop).place.local.v }) == loc_v {
                return true;
            }
        } else if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
            if (st.rvalue.lhs.kind == MIR_OP_MOVE && st.rvalue.lhs.place.local.v == loc_v) ||
               (st.rvalue.rhs.kind == MIR_OP_MOVE && st.rvalue.rhs.place.local.v == loc_v) {
                return true;
            }
        } else if rk == MIR_RVALUE_AGGREGATE {
            let mut idx: usize = 0;
            while idx < st.rvalue.operand_count {
                let op = unsafe { mir_op_at(st.rvalue.operands, idx) };
                if (unsafe { (*op).kind }) == MIR_OP_MOVE && (unsafe { (*op).place.local.v }) == loc_v {
                    return true;
                }
                idx = idx + 1;
            }
        }
    }
    false
}

fn pm_mir_local_clobbered_between(bb: view<OptBlock>, j: usize, i: usize, src_loc: u32) -> bool {
    let mut k: usize = j + 1;
    while k < i {
        let inst_k = unsafe { opt_inst_at(bb.insts, k) };
        let opc_k = unsafe { (*inst_k).opcode };
        let flg_k = unsafe { (*inst_k).flags };
        let is_deleted_nop = opc_k == OPT_INST_NOP && (flg_k & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16;
        if !is_deleted_nop {
            if (unsafe { (*inst_k).place.local.v }) == src_loc {
                return true;
            }
            if (flg_k & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 &&
               (unsafe { (*inst_k).orig_stmt.storage_local.v }) == src_loc {
                return true;
            }
            if opc_k == OPT_INST_ADDR_OF && (unsafe { (*inst_k).rhs_place.local.v }) == src_loc {
                return true;
            }
            if (flg_k & OPT_FLAG_MOVE) != 0u16 && (unsafe { (*inst_k).rhs_place.local.v }) == src_loc {
                return true;
            }
            if pm_mir_stmt_clobbers_or_moves_local(unsafe { view((*inst_k).orig_stmt) }, src_loc) {
                return true;
            }
        }
        k = k + 1;
    }
    false
}

fn pm_mir_stmt_reads_or_drops_local(st: view<MirStmt>, loc_v: u32) -> bool {
    if st.kind == MIR_STMT_DROP {
        return pm_mir_place_reads_local(view(st.place), loc_v);
    }
    if st.kind != MIR_STMT_ASSIGN {
        return false;
    }
    if st.place.proj_count > 0 && pm_mir_place_reads_local(view(st.place), loc_v) {
        return true;
    }
    if pm_mir_place_proj_reads_local(view(st.place), loc_v) {
        return true;
    }
    let rk = st.rvalue.kind;
    if rk == MIR_RVALUE_USE || rk == MIR_RVALUE_UNARY_OP || rk == MIR_RVALUE_CAST {
        return pm_mir_op_reads_local(view(st.rvalue.use_op), loc_v);
    }
    if rk == MIR_RVALUE_REPEAT {
        if pm_mir_op_reads_local(view(st.rvalue.use_op), loc_v) {
            return true;
        }
        let rcop = st.rvalue.repeat_count_op;
        if (rcop as usize) != 0 && pm_mir_op_reads_local(unsafe { view(*rcop) }, loc_v) {
            return true;
        }
        return false;
    }
    if rk == MIR_RVALUE_REF || rk == MIR_RVALUE_LEN || rk == MIR_RVALUE_DISCRIMINANT {
        return pm_mir_place_reads_local(view(st.rvalue.place), loc_v);
    }
    if rk == MIR_RVALUE_BINARY_OP || rk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        return pm_mir_op_reads_local(view(st.rvalue.lhs), loc_v) ||
               pm_mir_op_reads_local(view(st.rvalue.rhs), loc_v);
    }
    if rk == MIR_RVALUE_AGGREGATE {
        let mut idx: usize = 0;
        while idx < st.rvalue.operand_count {
            let op = unsafe { mir_op_at(st.rvalue.operands, idx) };
            if pm_mir_op_reads_local(unsafe { view(*op) }, loc_v) {
                return true;
            }
            idx = idx + 1;
        }
    }
    false
}

fn pm_mir_term_reads_or_drops_local(tm: view<MirTerminator>, loc_v: u32) -> bool {
    if tm.kind == MIR_TERM_SWITCH_INT {
        return pm_mir_op_reads_local(view(tm.discr), loc_v);
    }
    if tm.kind == MIR_TERM_DROP {
        return pm_mir_place_reads_local(view(tm.drop_place), loc_v);
    }
    if tm.kind == MIR_TERM_ASSERT {
        return pm_mir_op_reads_local(view(tm.cond), loc_v);
    }
    if tm.kind == MIR_TERM_CALL {
        if pm_mir_op_reads_local(view(tm.func), loc_v) {
            return true;
        }
        if tm.has_destination && tm.destination.proj_count > 0 && pm_mir_place_reads_local(view(tm.destination), loc_v) {
            return true;
        }
        let mut ai: usize = 0;
        while ai < tm.arg_count {
            let aop = unsafe { mir_op_at(tm.args, ai) };
            if pm_mir_op_reads_local(unsafe { view(*aop) }, loc_v) {
                return true;
            }
            ai = ai + 1;
        }
    }
    false
}

fn pm_mir_local_read_or_dropped_anywhere(
    body: view<OptBody>,
    skip_b: usize,
    skip_i: usize,
    loc_v: u32
) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let insts = unsafe { (*bb).insts };
        let mut i: usize = 0;
        while i < icnt {
            if !(b == skip_b && i == skip_i) {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let flg = unsafe { (*inst).flags };
                let is_deleted_nop = opc == OPT_INST_NOP && (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16;
                if !is_deleted_nop && pm_mir_stmt_reads_or_drops_local(unsafe { view((*inst).orig_stmt) }, loc_v) {
                    return true;
                }
            }
            i = i + 1;
        }
        if (unsafe { (*bb).has_term }) && pm_mir_term_reads_or_drops_local(unsafe { view((*bb).term.orig_term) }, loc_v) {
            return true;
        }
        b = b + 1;
    }
    false
}

fn pm_fold_const_int_binop(
    thir: *const Thir,
    opc: u8,
    sub: u8,
    operand_ty: TypeId,
    result_ty: TypeId,
    lv: u64,
    rv: u64,
    out_val: mut_view<u64>
) -> bool {
    let op_ty_v = operand_ty.v;
    let res_ty_v = result_ty.v;
    let bits = opt_type_bits(thir, TypeId { v: op_ty_v });
    if bits == 0u32 {
        return false;
    }
    let mask = opt_bit_mask(bits);
    let is_signed = opt_type_is_signed(thir, TypeId { v: op_ty_v });
    let is_bool_op = opt_type_is_bool(thir, TypeId { v: op_ty_v });
    let is_bool_res = opt_type_is_bool(thir, TypeId { v: res_ty_v });

    if sub == MIR_BINOP_EQ {
        *out_val = if (lv & mask) == (rv & mask) { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_NE {
        *out_val = if (lv & mask) != (rv & mask) { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_LT {
        let l_tc = opt_sign_extend_u64(lv, bits);
        let r_tc = opt_sign_extend_u64(rv, bits);
        let cmp = if is_signed { opt_signed_lt(l_tc, r_tc) } else { (lv & mask) < (rv & mask) };
        *out_val = if cmp { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_LE {
        let l_tc = opt_sign_extend_u64(lv, bits);
        let r_tc = opt_sign_extend_u64(rv, bits);
        let cmp = if is_signed { opt_signed_le(l_tc, r_tc) } else { (lv & mask) <= (rv & mask) };
        *out_val = if cmp { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_GT {
        let l_tc = opt_sign_extend_u64(lv, bits);
        let r_tc = opt_sign_extend_u64(rv, bits);
        let cmp = if is_signed { opt_signed_lt(r_tc, l_tc) } else { (lv & mask) > (rv & mask) };
        *out_val = if cmp { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_GE {
        let l_tc = opt_sign_extend_u64(lv, bits);
        let r_tc = opt_sign_extend_u64(rv, bits);
        let cmp = if is_signed { opt_signed_le(r_tc, l_tc) } else { (lv & mask) >= (rv & mask) };
        *out_val = if cmp { 1u64 } else { 0u64 };
        return true;
    }
    if sub == MIR_BINOP_BIT_AND {
        let raw = (lv & rv) & mask;
        *out_val = if is_bool_res { if raw != 0u64 { 1u64 } else { 0u64 } } else { raw };
        return true;
    }
    if sub == MIR_BINOP_BIT_OR {
        let raw = (lv | rv) & mask;
        *out_val = if is_bool_res { if raw != 0u64 { 1u64 } else { 0u64 } } else { raw };
        return true;
    }
    if sub == MIR_BINOP_BIT_XOR {
        let raw = (lv ^ rv) & mask;
        *out_val = if is_bool_res { if raw != 0u64 { 1u64 } else { 0u64 } } else { raw };
        return true;
    }
    if is_bool_op || is_bool_res {
        return false;
    }
    if sub == MIR_BINOP_WRAPPING_ADD || (opc == OPT_INST_WRAPPING_BINOP && sub == MIR_BINOP_ADD) {
        *out_val = opt_wrapping_add_u64(lv & mask, rv & mask) & mask;
        return true;
    }
    if sub == MIR_BINOP_WRAPPING_SUB || (opc == OPT_INST_WRAPPING_BINOP && sub == MIR_BINOP_SUB) {
        let neg_r = opt_twos_complement_u64(rv & mask);
        *out_val = opt_wrapping_add_u64(lv & mask, neg_r) & mask;
        return true;
    }
    if sub == MIR_BINOP_WRAPPING_MUL || (opc == OPT_INST_WRAPPING_BINOP && sub == MIR_BINOP_MUL) {
        let mut raw: u64 = 0u64;
        let _ = opt_checked_mul_u64_raw(lv & mask, rv & mask, mut_view(raw));
        *out_val = raw & mask;
        return true;
    }
    if sub == MIR_BINOP_ADD {
        if is_signed {
            let l_tc = opt_sign_extend_u64(lv, bits);
            let r_tc = opt_sign_extend_u64(rv, bits);
            return !opt_checked_add_signed(l_tc, r_tc, bits, out_val);
        }
        return !opt_checked_add_u64(lv, rv, bits, out_val);
    }
    if sub == MIR_BINOP_SUB {
        if is_signed {
            let l_tc = opt_sign_extend_u64(lv, bits);
            let r_tc = opt_sign_extend_u64(rv, bits);
            return !opt_checked_sub_signed(l_tc, r_tc, bits, out_val);
        }
        return !opt_checked_sub_u64(lv, rv, bits, out_val);
    }
    if sub == MIR_BINOP_MUL {
        if is_signed {
            let l_tc = opt_sign_extend_u64(lv, bits);
            let r_tc = opt_sign_extend_u64(rv, bits);
            return !opt_checked_mul_signed(l_tc, r_tc, bits, out_val);
        }
        return !opt_checked_mul_u64(lv, rv, bits, out_val);
    }
    false
}

fn pm_exec_sccp(pm: view<PassManager>, body: mut_view<OptBody>) -> bool {
    let mut changed = false;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let sub = unsafe { (*inst).sub_op };
                let flg = unsafe { (*inst).flags };
                if (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP) &&
                   (flg & (OPT_FLAG_BARRIER | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
                   !pm_mir_stmt_has_move_operand(unsafe { view((*inst).orig_stmt) }) {
                    let mut lv: u64 = 0u64;
                    let mut rv: u64 = 0u64;
                    let lhs_id = OptValueId { v: unsafe { (*inst).lhs.v } };
                    let rhs_id = OptValueId { v: unsafe { (*inst).rhs.v } };
                    let inst_ty_v = unsafe { (*inst).ty.v };
                    let op_ty_v: u32 = if lhs_id.v != OPT_VALUE_NONE && (lhs_id.v as usize) <= body.value_count && (body.values as usize) != 0 {
                        let lvp = unsafe { opt_val_at(body.values, lhs_id.v as usize) };
                        let lty = unsafe { (*lvp).ty.v };
                        if lty != 0u32 { lty } else { inst_ty_v }
                    } else {
                        inst_ty_v
                    };
                    if pm_value_is_const_int(view(*pm), view(*body), lhs_id, mut_view(lv)) &&
                       pm_value_is_const_int(view(*pm), view(*body), rhs_id, mut_view(rv)) {
                        let ovf_cert: u8 = if opc == OPT_INST_WRAPPING_BINOP {
                            CERTAINTY_PROVEN
                        } else {
                            optir_query_no_overflow_certainty(
                                view(*body),
                                sub,
                                TypeId { v: op_ty_v },
                                lhs_id,
                                rhs_id,
                                pm.budget.max_symbolic_steps
                            )
                        };
                        let cand = CandidateRewrite {
                            pass_id: PASS_SCCP,
                            required_prop: PROP_NO_OVERFLOW,
                            proof_certainty: ovf_cert,
                            proof_source_analysis: ANALYSIS_RANGE_INFO,
                            proof_revision: pm.ir_revision,
                            target_effect_flags: EFFECT_PURE,
                            src_view_kind: 0u8,
                            dst_view_kind: 0u8,
                            is_removing_inst: false,
                            cost_delta: -2i32,
                        };
                        if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                            let mut folded_v: u64 = 0u64;
                            let folded_ok = pm_fold_const_int_binop(
                                body.thir,
                                opc,
                                sub,
                                TypeId { v: op_ty_v },
                                TypeId { v: inst_ty_v },
                                lv,
                                rv,
                                mut_view(folded_v)
                            );
                            if folded_ok {
                                let inst_ty_a = TypeId { v: inst_ty_v };
                                let inst_ty_b = TypeId { v: inst_ty_v };
                                let is_bool_ck = pm_type_kind(body.thir, inst_ty_a) == TY_BOOL ||
                                                 opt_type_is_bool(body.thir, inst_ty_b);
                                let ckind: u8 = if is_bool_ck { MIR_CONST_BOOL } else { MIR_CONST_INT };
                                let res_v = unsafe { (*inst).result.v };
                                if res_v != OPT_VALUE_NONE && (res_v as usize) <= body.value_count {
                                    let vp = unsafe { opt_val_at(body.values, res_v as usize) };
                                    unsafe {
                                        (*vp).kind = OPT_VAL_CONST;
                                        (*vp).const_val.kind = ckind;
                                        (*vp).const_val.ty = TypeId { v: inst_ty_v };
                                        (*vp).const_val.val = folded_v;
                                    }
                                }
                                unsafe {
                                    (*inst).opcode = OPT_INST_CONST;
                                    (*inst).sub_op = 0u8;
                                    (*inst).flags = 0u16;
                                    (*inst).lhs = OptValueId { v: OPT_VALUE_NONE };
                                    (*inst).rhs = OptValueId { v: OPT_VALUE_NONE };
                                    (*inst).extra_arg_count = 0;
                                    (*inst).orig_stmt.rvalue.kind = MIR_RVALUE_USE;
                                    (*inst).orig_stmt.rvalue.use_op.kind = MIR_OP_CONST;
                                    (*inst).orig_stmt.rvalue.use_op.constant.kind = ckind;
                                    (*inst).orig_stmt.rvalue.use_op.constant.ty = TypeId { v: inst_ty_v };
                                    (*inst).orig_stmt.rvalue.use_op.constant.val = folded_v;
                                }
                                changed = true;
                            }
                        }
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    changed
}

fn pm_exec_inst_combine(pm: view<PassManager>, body: mut_view<OptBody>) -> bool {
    let mut changed = false;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let sub = unsafe { (*inst).sub_op };
                let flg = unsafe { (*inst).flags };
                if (opc == OPT_INST_BINOP || opc == OPT_INST_WRAPPING_BINOP) &&
                   (flg & (OPT_FLAG_BARRIER | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
                   (unsafe { (*inst).orig_stmt.rvalue.rhs.kind }) != MIR_OP_MOVE {
                    let lhs_id = OptValueId { v: unsafe { (*inst).lhs.v } };
                    let rhs_id = OptValueId { v: unsafe { (*inst).rhs.v } };
                    let has_haz = pm_value_has_fp_hazard(view(*pm), view(*body), lhs_id) ||
                                  pm_value_has_fp_hazard(view(*pm), view(*body), rhs_id);
                    let mut rv: u64 = 0u64;
                    if pm_value_is_const_int(view(*pm), view(*body), rhs_id, mut_view(rv)) {
                        let is_identity = ((sub == MIR_BINOP_ADD || sub == MIR_BINOP_WRAPPING_ADD) && rv == 0u64) ||
                                          ((sub == MIR_BINOP_SUB || sub == MIR_BINOP_WRAPPING_SUB) && rv == 0u64) ||
                                          ((sub == MIR_BINOP_MUL || sub == MIR_BINOP_WRAPPING_MUL) && rv == 1u64) ||
                                          (sub == MIR_BINOP_BIT_OR && rv == 0u64) ||
                                          (sub == MIR_BINOP_BIT_XOR && rv == 0u64);
                        if is_identity {
                            // Floating-point hazard degrades certainty to CERTAINTY_POSSIBLE, which fails closed (REQ-OPT-397)
                            let cert: u8 = if has_haz { CERTAINTY_POSSIBLE } else { CERTAINTY_PROVEN };
                            let cand = CandidateRewrite {
                                pass_id: PASS_INST_COMBINE,
                                required_prop: PROP_NO_OVERFLOW,
                                proof_certainty: cert,
                                proof_source_analysis: ANALYSIS_RANGE_INFO,
                                proof_revision: pm.ir_revision,
                                target_effect_flags: EFFECT_PURE,
                                src_view_kind: 0u8,
                                dst_view_kind: 0u8,
                                is_removing_inst: false,
                                cost_delta: -1i32,
                            };
                            if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                unsafe {
                                    (*inst).opcode = OPT_INST_COPY;
                                    (*inst).sub_op = 0u8;
                                    (*inst).rhs = OptValueId { v: OPT_VALUE_NONE };
                                    (*inst).flags = 0u16;
                                    (*inst).orig_stmt.rvalue.kind = MIR_RVALUE_USE;
                                    (*inst).orig_stmt.rvalue.use_op = (*inst).orig_stmt.rvalue.lhs;
                                }
                                changed = true;
                            }
                        }
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    changed
}

fn pm_exec_gvn_cse(pm: view<PassManager>, body: mut_view<OptBody>) -> bool {
    let mut changed = false;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst_i = unsafe { opt_inst_at(insts, i) };
                let opc_i = unsafe { (*inst_i).opcode };
                let flg_i = unsafe { (*inst_i).flags };
                let eff_i = effect_infer_inst(view(*body), unsafe { view(*inst_i) }, pm.budget.max_symbolic_steps);
                if (opc_i == OPT_INST_BINOP || opc_i == OPT_INST_WRAPPING_BINOP) &&
                   eff_i == EFFECT_PURE &&
                   (flg_i & (OPT_FLAG_MOVE | OPT_FLAG_BARRIER | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
                   (unsafe { (*inst_i).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                   !pm_mir_stmt_has_move_operand(unsafe { view((*inst_i).orig_stmt) }) {
                    let mut j: usize = 0;
                    while j < i {
                        let inst_j = unsafe { opt_inst_at(insts, j) };
                        let opc_j = unsafe { (*inst_j).opcode };
                        let flg_j = unsafe { (*inst_j).flags };
                        let src_loc = unsafe { (*inst_j).place.local.v };
                        let src_is_scalar: bool = src_loc != 0u32 &&
                            (src_loc as usize) < body.local_count &&
                            (body.local_modes as usize) != 0 &&
                            (unsafe { *opt_u8_at(body.local_modes, src_loc as usize) }) == OPT_LOCAL_SCALAR;
                        if opc_j == opc_i &&
                           src_is_scalar &&
                           (flg_j & (OPT_FLAG_BARRIER | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
                           (unsafe { (*inst_j).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                           (unsafe { (*inst_j).sub_op }) == (unsafe { (*inst_i).sub_op }) &&
                           (unsafe { (*inst_j).ty.v }) == (unsafe { (*inst_i).ty.v }) &&
                           (unsafe { (*inst_j).lhs.v }) == (unsafe { (*inst_i).lhs.v }) &&
                           (unsafe { (*inst_j).rhs.v }) == (unsafe { (*inst_i).rhs.v }) &&
                           (unsafe { (*inst_j).place.proj_count }) == 0 &&
                           (unsafe { (*inst_j).place.view_kind }) == 0u8 &&
                           (unsafe { (*inst_j).place.drop_flag }) == MIR_DROP_FLAG_NONE &&
                           !pm_mir_local_clobbered_between(unsafe { view(*bb) }, j, i, src_loc) {
                            let cand = CandidateRewrite {
                                pass_id: PASS_GVN_CSE,
                                required_prop: PROP_PURE_CALL,
                                proof_certainty: CERTAINTY_PROVEN,
                                proof_source_analysis: ANALYSIS_EFFECT_INFO,
                                proof_revision: pm.ir_revision,
                                target_effect_flags: eff_i,
                                src_view_kind: 0u8,
                                dst_view_kind: 0u8,
                                is_removing_inst: false,
                                cost_delta: -2i32,
                            };
                            if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                unsafe {
                                    (*inst_i).opcode = OPT_INST_COPY;
                                    (*inst_i).sub_op = 0u8;
                                    (*inst_i).lhs = (*inst_j).result;
                                    (*inst_i).rhs = OptValueId { v: OPT_VALUE_NONE };
                                    (*inst_i).orig_stmt.rvalue.kind = MIR_RVALUE_USE;
                                    (*inst_i).orig_stmt.rvalue.use_op.kind = MIR_OP_COPY;
                                    mir_copy_place(mut_view((*inst_i).orig_stmt.rvalue.use_op.place), view((*inst_j).place));
                                }
                                changed = true;
                                break;
                            }
                        }
                        j = j + 1;
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    changed
}

pub fn passmgr_can_dce_value_inst(
    body: view<OptBody>,
    inst: view<OptInst>,
    max_steps: u32
) -> bool {
    if inst.opcode == OPT_INST_NOP || inst.place.local.v == 0u32 {
        return false;
    }
    if !effect_can_dce_inst(view(*body), view(*inst), max_steps) {
        return false;
    }
    pm_count_value_uses_excluding_inst(view(*body), OptValueId { v: inst.result.v }, inst.id.v) == 0u32
}

fn pm_exec_dce(pm: view<PassManager>, body: mut_view<OptBody>) -> bool {
    let mut changed = false;
    let mut round_changed = true;
    while round_changed {
        round_changed = false;
        let mut b: usize = 0;
        while b < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, b) };
            if unsafe { (*bb).is_reachable } {
                let icnt = unsafe { (*bb).inst_count };
                let insts = unsafe { (*bb).insts };
                let mut i: usize = 0;
                while i < icnt {
                    let inst = unsafe { opt_inst_at(insts, i) };
                    let opc = unsafe { (*inst).opcode };
                    let iid = OptInstId { v: unsafe { (*inst).id.v } };
                    let mdef_id = OptValueId { v: unsafe { (*inst).mem_def.v } };
                    // 1. Check Proven DeadStore elimination (from MemorySSA)
                    if opc == OPT_INST_STORE &&
                       mdef_id.v != MEM_SSA_NONE &&
                       !pm_mir_stmt_has_move_operand(unsafe { view((*inst).orig_stmt) }) {
                        let ds_cert = passmgr_find_proven_property(
                            view(*body),
                            PROP_DEAD_STORE,
                            OptValueId { v: OPT_VALUE_NONE },
                            OptBbId { v: b as u32 },
                            iid
                        );
                        let eff = effect_infer_inst(view(*body), unsafe { view(*inst) }, pm.budget.max_symbolic_steps);
                        // Only ordinary non-volatile/non-barrier stores with Proven DeadStore can be eliminated
                        let cand_eff: u16 = if (eff & EFFECT_MASK_NON_STORE_OBSERVABLE) == 0u16 { EFFECT_PURE } else { eff };
                        let cand = CandidateRewrite {
                            pass_id: PASS_DCE,
                            required_prop: PROP_DEAD_STORE,
                            proof_certainty: ds_cert,
                            proof_source_analysis: ANALYSIS_MEMORY_SSA,
                            proof_revision: pm.ir_revision,
                            target_effect_flags: cand_eff,
                            src_view_kind: 0u8,
                            dst_view_kind: 0u8,
                            is_removing_inst: true,
                            cost_delta: -3i32,
                        };
                        if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                            unsafe {
                                (*inst).opcode = OPT_INST_NOP;
                                (*inst).sub_op = 0u8;
                                (*inst).flags = 0u16;
                                (*inst).lhs = OptValueId { v: OPT_VALUE_NONE };
                                (*inst).rhs = OptValueId { v: OPT_VALUE_NONE };
                                (*inst).extra_arg_count = 0;
                                (*inst).mem_use = MemSsaId { v: MEM_SSA_NONE };
                                (*inst).mem_def = MemSsaId { v: MEM_SSA_NONE };
                            }
                            changed = true;
                            round_changed = true;
                        }
                    } else if passmgr_can_dce_value_inst(view(*body), unsafe { view(*inst) }, pm.budget.max_symbolic_steps) {
                        // 2. Eliminate dead pure/read-only value instructions whose MIR destination local has no remaining reads/drops
                        let dloc = unsafe { (*inst).place.local.v };
                        if (unsafe { (*inst).place.proj_count }) == 0 &&
                           (unsafe { (*inst).place.drop_flag }) == MIR_DROP_FLAG_NONE &&
                           !pm_mir_stmt_has_move_operand(unsafe { view((*inst).orig_stmt) }) &&
                           !pm_mir_local_read_or_dropped_anywhere(view(*body), b, i, dloc) {
                            let eff = effect_infer_inst(view(*body), unsafe { view(*inst) }, pm.budget.max_symbolic_steps);
                            let cand = CandidateRewrite {
                                pass_id: PASS_DCE,
                                required_prop: PROP_PURE_CALL,
                                proof_certainty: CERTAINTY_PROVEN,
                                proof_source_analysis: ANALYSIS_EFFECT_INFO,
                                proof_revision: pm.ir_revision,
                                target_effect_flags: eff,
                                src_view_kind: 0u8,
                                dst_view_kind: 0u8,
                                is_removing_inst: true,
                                cost_delta: -2i32,
                            };
                            if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                                unsafe {
                                    (*inst).opcode = OPT_INST_NOP;
                                    (*inst).sub_op = 0u8;
                                    (*inst).flags = 0u16;
                                    (*inst).lhs = OptValueId { v: OPT_VALUE_NONE };
                                    (*inst).rhs = OptValueId { v: OPT_VALUE_NONE };
                                    (*inst).extra_arg_count = 0;
                                    (*inst).mem_use = MemSsaId { v: MEM_SSA_NONE };
                                    (*inst).mem_def = MemSsaId { v: MEM_SSA_NONE };
                                }
                                changed = true;
                                round_changed = true;
                            }
                        }
                    }
                    i = i + 1;
                }
            }
            b = b + 1;
        }
    }
    changed
}

fn pm_exec_cfg_simplify(pm: view<PassManager>, body: mut_view<OptBody>) -> bool {
    let mut changed = false;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if (unsafe { (*bb).is_reachable }) && (unsafe { (*bb).has_term }) {
            let tk = unsafe { (*bb).term.kind };
            if tk == OPT_TERM_BRANCH {
                let cond_id = OptValueId { v: unsafe { (*bb).term.cond.v } };
                let mut cval: u64 = 0u64;
                if pm_value_is_const_int(view(*pm), view(*body), cond_id, mut_view(cval)) {
                    let cand = CandidateRewrite {
                        pass_id: PASS_CFG_SIMPLIFY,
                        required_prop: PROP_REACHABLE,
                        proof_certainty: CERTAINTY_PROVEN,
                        proof_source_analysis: ANALYSIS_CFG,
                        proof_revision: pm.ir_revision,
                        target_effect_flags: EFFECT_PURE,
                        src_view_kind: 0u8,
                        dst_view_kind: 0u8,
                        is_removing_inst: false,
                        cost_delta: -2i32,
                    };
                    if passmgr_evaluate_candidate(view(*pm), view(cand)) == CONTRACT_OK {
                        let target_bb: OptBbId = if cval != 0u64 {
                            unsafe { (*bb).term.true_bb }
                        } else {
                            unsafe { (*bb).term.false_bb }
                        };
                        let dead_bb: OptBbId = if cval != 0u64 {
                            unsafe { (*bb).term.false_bb }
                        } else {
                            unsafe { (*bb).term.true_bb }
                        };
                        // Only fold branch if dead_bb has no multi-predecessor phi that would become arity-mismatched before SSA rebuild
                        let can_fold: bool = if (dead_bb.v as usize) < body.bb_count {
                            let dbb = unsafe { opt_block_at(body.blocks, dead_bb.v as usize) };
                            (unsafe { (*dbb).phi_count }) == 0 && !(unsafe { (*dbb).has_mem_phi })
                        } else {
                            false
                        };
                        if can_fold {
                            unsafe {
                                (*bb).term.kind = OPT_TERM_GOTO;
                                (*bb).term.true_bb = target_bb;
                                (*bb).term.false_bb = OptBbId { v: OPT_BB_NONE };
                                (*bb).term.orig_term.kind = MIR_TERM_GOTO;
                                (*bb).term.orig_term.goto_target = MirBbId { v: target_bb.v };
                            }
                            changed = true;
                        }
                    }
                }
            }
        }
        b = b + 1;
    }
    changed
}

// --- Pass Runner & Fixed-Point Pipeline (AXS-OPT-030..034, REQ-OPT-065, REQ-OPT-373..374) ---

pub fn passmgr_run_pass(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    pass_id: u16,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    if (pass_id as usize) >= PASS_COUNT {
        return false;
    }
    let facts = passmgr_collect_body_facts(view(*body));
    if !passmgr_should_schedule_pass(pass_id, view(pm.budget), view(facts)) {
        let prev_sk = unsafe { *opt_u32_at(pm.pass_skip_counts, pass_id as usize) };
        unsafe { *opt_u32_at(pm.pass_skip_counts, pass_id as usize) = prev_sk + 1u32; }
        return false;
    }

    let contract = passmgr_contract_for_pass(pass_id);
    // 1. Ensure all required analyses are up to date before the pass executes
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    // 2. Take pre-pass snapshot if --verify-each is active so postcondition failures roll back cleanly
    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;

    // 3. Execute the pass
    let prev_run = unsafe { *opt_u32_at(pm.pass_run_counts, pass_id as usize) };
    unsafe { *opt_u32_at(pm.pass_run_counts, pass_id as usize) = prev_run + 1u32; }

    let mut changed = false;
    if pass_id == PASS_SCCP {
        changed = pm_exec_sccp(view(*pm), mut_view(*body));
    } else if pass_id == PASS_INST_COMBINE {
        changed = pm_exec_inst_combine(view(*pm), mut_view(*body));
    } else if pass_id == PASS_GVN_CSE {
        changed = pm_exec_gvn_cse(view(*pm), mut_view(*body));
    } else if pass_id == PASS_DCE {
        changed = pm_exec_dce(view(*pm), mut_view(*body));
    } else if pass_id == PASS_CFG_SIMPLIFY {
        changed = pm_exec_cfg_simplify(view(*pm), mut_view(*body));
    } else if pass_id == PASS_SROA {
        // Scalar replacement slots are classified during OptIR SSA construction; validate non-escaping slots
        changed = false;
    }

    // 4. Update IR revision and invalidate non-preserved analyses if the pass mutated OptBody
    if changed {
        let new_rev = pm.ir_revision + 1u32;
        pm.ir_revision = new_rev;
        let prev_ch = unsafe { *opt_u32_at(pm.pass_change_counts, pass_id as usize) };
        unsafe { *opt_u32_at(pm.pass_change_counts, pass_id as usize) = prev_ch + 1u32; }

        let non_preserved = ANALYSIS_MASK_ALL ^ (contract.preserved_analyses & ANALYSIS_MASK_ALL);
        passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses | non_preserved);
        if !passmgr_is_analysis_valid(view(*pm), ANALYSIS_RANGE_INFO) {
            body.ranges = 0 as *mut OptRange;
        }

        // Advance revision stamp for preserved analyses that were valid before the pass
        let mut a: u8 = 0u8;
        while (a as usize) < ANALYSIS_COUNT {
            let bit = analysis_bit(a);
            if (pm.valid_analyses & bit) != 0u32 && (contract.preserved_analyses & bit) != 0u32 {
                unsafe { *opt_u32_at(pm.analysis_revs, a as usize) = new_rev; }
            }
            a = a + 1u8;
        }
    }

    // 5. Verify postconditions under --verify-each; rollback on any contract violation
    if pm.budget.verify_each {
        let vstatus = passmgr_verify_postconditions(mut_view(*pm), mut_view(*body), pass_id, mut_view(*arena), mut_view(*sink));
        if vstatus != CONTRACT_OK {
            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
            pm.ir_revision = pre_rev;
            pm.valid_analyses = pre_valid;
            let mut a2: usize = 0;
            while a2 < ANALYSIS_COUNT {
                if (pre_valid & (1u32 << (a2 as u32))) != 0u32 {
                    unsafe { *opt_u32_at(pm.analysis_revs, a2) = pre_rev; }
                }
                a2 = a2 + 1;
            }
            let prev_rb = unsafe { *opt_u32_at(pm.pass_rollback_counts, pass_id as usize) };
            unsafe { *opt_u32_at(pm.pass_rollback_counts, pass_id as usize) = prev_rb + 1u32; }
            return false;
        }
    }

    changed
}

pub fn passmgr_inject_fault_and_verify(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    pass_id: u16,
    fault_kind: u8,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> u8 {
    let contract = passmgr_contract_for_pass(pass_id);
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;

    if fault_kind == FAULT_CORRUPT_IDOM && body.bb_count > 0 {
        let bb0 = unsafe { opt_block_at(body.blocks, 0) };
        unsafe { (*bb0).idom = OptBbId { v: 999u32 }; }
    } else if fault_kind == FAULT_DROP_VOLATILE_INST {
        let mut b: usize = 0;
        while b < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, b) };
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                if opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_VOLATILE_STORE {
                    unsafe { (*inst).opcode = OPT_INST_NOP; }
                }
                i = i + 1;
            }
            b = b + 1;
        }
    } else if fault_kind == FAULT_DROP_ATOMIC_INST {
        let mut b: usize = 0;
        while b < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, b) };
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                if opc == OPT_INST_ATOMIC {
                    unsafe { (*inst).opcode = OPT_INST_NOP; }
                }
                i = i + 1;
            }
            b = b + 1;
        }
    } else if fault_kind == FAULT_PROMOTE_VIEW_TO_MUT {
        let mut b: usize = 0;
        while b < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, b) };
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                if opc == OPT_INST_LOAD || opc == OPT_INST_STORE || opc == OPT_INST_ADDR_OF {
                    unsafe {
                        (*inst).place.view_kind = MIR_VIEW_MUT;
                        (*inst).rhs_place.view_kind = MIR_VIEW_MUT;
                    }
                }
                i = i + 1;
            }
            b = b + 1;
        }
    }

    let status = passmgr_verify_postconditions(mut_view(*pm), mut_view(*body), pass_id, mut_view(*arena), mut_view(*sink));
    if status != CONTRACT_OK {
        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
        pm.ir_revision = pre_rev;
        pm.valid_analyses = pre_valid;
        let mut a2: usize = 0;
        while a2 < ANALYSIS_COUNT {
            if (pre_valid & (1u32 << (a2 as u32))) != 0u32 {
                unsafe { *opt_u32_at(pm.analysis_revs, a2) = pre_rev; }
            }
            a2 = a2 + 1;
        }
        let prev_rb = unsafe { *opt_u32_at(pm.pass_rollback_counts, pass_id as usize) };
        unsafe { *opt_u32_at(pm.pass_rollback_counts, pass_id as usize) = prev_rb + 1u32; }
    }
    status
}

pub fn passmgr_run_pipeline(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    passmgr_mark_all_valid_from_lowering(mut_view(*pm), mut_view(*body), mut_view(*arena));

    // -O0 Debug profile: 0 optional optimization rounds (REQ-OPT-373)
    if pm.budget.profile == OPT_PROFILE_DEBUG_O0 || pm.budget.max_fixedpoint_rounds == 0u32 {
        if pm.budget.verify_each {
            let vst = passmgr_verify_postconditions(mut_view(*pm), mut_view(*body), PASS_LOWER_MIR, mut_view(*arena), mut_view(*sink));
            return vst == CONTRACT_OK;
        }
        return true;
    }

    let _ = passmgr_run_pass(mut_view(*pm), mut_view(*body), PASS_SROA, mut_view(*arena), mut_view(*sink));

    let max_rounds = pm.budget.max_fixedpoint_rounds;
    let mut round: u32 = 0u32;
    while round < max_rounds {
        round = round + 1u32;
        pm.fixedpoint_rounds_executed = round;
        let mut round_changed = false;

        if passmgr_run_pass(mut_view(*pm), mut_view(*body), PASS_SCCP, mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }
        if passmgr_run_pass(mut_view(*pm), mut_view(*body), PASS_INST_COMBINE, mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }
        if passmgr_run_pass(mut_view(*pm), mut_view(*body), PASS_GVN_CSE, mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }
        if passmgr_run_pass(mut_view(*pm), mut_view(*body), PASS_DCE, mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }
        if passmgr_run_pass(mut_view(*pm), mut_view(*body), PASS_CFG_SIMPLIFY, mut_view(*arena), mut_view(*sink)) {
            round_changed = true;
        }

        // Fixed-point early termination: stop immediately when a full round produces no IR changes (AXS-OPT-033)
        if !round_changed {
            break;
        }
    }

    pm.last_verify_status == CONTRACT_OK
}
