@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

const OPT_ALL_ONES_U64: u64 = 0xFFFFFFFFFFFFFFFFu64;
const OPT_SIGN64_U64: u64 = 0x8000000000000000u64;
const OPT_LOW32_U64: u64 = 0xFFFFFFFFu64;

// --- Type Metadata Helpers ---

pub fn opt_type_bits(thir: *const Thir, ty: TypeId) -> u32 {
    let ty_v = ty.v;
    if (thir as usize) != 0 {
        let types_ptr = unsafe { (*thir).interner.types };
        if (types_ptr as usize) != 0 {
            let t = unsafe { type_get(view((*thir).interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let k = unsafe { (*t).kind };
                if k == TY_I8 || k == TY_U8 || k == TY_BOOL {
                    return 8u32;
                }
                if k == TY_I16 || k == TY_U16 {
                    return 16u32;
                }
                if k == TY_I32 || k == TY_U32 || k == TY_CHAR {
                    return 32u32;
                }
                if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
                    return 64u32;
                }
                if k == TY_I128 || k == TY_U128 {
                    return 128u32;
                }
                return 0u32;
            }
        }
    }
    // Canonical builtin TypeId fallback when Thir is null or unpopulated:
    // 4=bool, 5=char, 6=i8, 7=i16, 8=i32, 9=i64, 10=isize, 11=u8, 12=u16, 13=u32, 14=u64, 15=usize
    if ty_v == 4u32 || ty_v == 6u32 || ty_v == 11u32 {
        return 8u32;
    }
    if ty_v == 7u32 || ty_v == 12u32 {
        return 16u32;
    }
    if ty_v == 5u32 || ty_v == 8u32 || ty_v == 13u32 {
        return 32u32;
    }
    if ty_v == 9u32 || ty_v == 10u32 || ty_v == 14u32 || ty_v == 15u32 {
        return 64u32;
    }
    if ty_v == 0x3FFF0128u32 || ty_v == 0x3FFF0129u32 {
        return 128u32;
    }
    0u32
}

pub fn opt_type_is_signed(thir: *const Thir, ty: TypeId) -> bool {
    let ty_v = ty.v;
    if (thir as usize) != 0 {
        let types_ptr = unsafe { (*thir).interner.types };
        if (types_ptr as usize) != 0 {
            let t = unsafe { type_get(view((*thir).interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let k = unsafe { (*t).kind };
                return k == TY_I8 || k == TY_I16 || k == TY_I32 || k == TY_I64 || k == TY_ISIZE || k == TY_I128;
            }
        }
    }
    (ty_v >= 6u32 && ty_v <= 10u32) || ty_v == 0x3FFF0128u32
}

pub fn opt_type_is_bool(thir: *const Thir, ty: TypeId) -> bool {
    let ty_v = ty.v;
    if (thir as usize) != 0 {
        let types_ptr = unsafe { (*thir).interner.types };
        if (types_ptr as usize) != 0 {
            let t = unsafe { type_get(view((*thir).interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let k = unsafe { (*t).kind };
                return k == TY_BOOL;
            }
        }
    }
    ty_v == 4u32
}

pub fn opt_bool_type_id(thir: *const Thir) -> TypeId {
    if (thir as usize) != 0 {
        let bv = unsafe { (*thir).interner.t_bool.v };
        if bv != 0u32 {
            return TypeId { v: bv };
        }
    }
    TypeId { v: 4u32 }
}

pub fn opt_type_is_int_scalar(thir: *const Thir, ty: TypeId) -> bool {
    let ty_v = ty.v;
    if (thir as usize) != 0 {
        let types_ptr = unsafe { (*thir).interner.types };
        if (types_ptr as usize) != 0 {
            let t = unsafe { type_get(view((*thir).interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let k = unsafe { (*t).kind };
                return k >= TY_I8 && k <= TY_USIZE;
            }
        }
    }
    (ty_v >= 6u32 && ty_v <= 15u32) || ty_v == 0x3FFF0128u32 || ty_v == 0x3FFF0129u32
}

// --- Trap-Free 64-Bit Two's-Complement Arithmetic Helpers ---

pub fn opt_bit_mask(bits: u32) -> u64 {
    if bits == 8u32 {
        0xFFu64
    } else if bits == 16u32 {
        0xFFFFu64
    } else if bits == 32u32 {
        0xFFFFFFFFu64
    } else {
        OPT_ALL_ONES_U64
    }
}

pub fn opt_sign_bit_mask(bits: u32) -> u64 {
    if bits == 8u32 {
        0x80u64
    } else if bits == 16u32 {
        0x8000u64
    } else if bits == 32u32 {
        0x80000000u64
    } else {
        OPT_SIGN64_U64
    }
}

pub fn opt_wrapping_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & OPT_LOW32_U64;
    let a_hi = (a >> 32u64) & OPT_LOW32_U64;
    let b_lo = b & OPT_LOW32_U64;
    let b_hi = (b >> 32u64) & OPT_LOW32_U64;
    let sum_lo = a_lo + b_lo;
    let carry = (sum_lo >> 32u64) & 1u64;
    let sum_hi = (a_hi + b_hi + carry) & OPT_LOW32_U64;
    (sum_lo & OPT_LOW32_U64) | (sum_hi << 32u64)
}

pub fn opt_twos_complement_u64(x: u64) -> u64 {
    opt_wrapping_add_u64(x ^ OPT_ALL_ONES_U64, 1u64)
}

pub fn opt_sign_extend_u64(val: u64, bits: u32) -> u64 {
    let m = opt_bit_mask(bits);
    let v = val & m;
    if bits >= 64u32 {
        return v;
    }
    let sign_bit = opt_sign_bit_mask(bits);
    if (v & sign_bit) != 0u64 {
        v | (m ^ OPT_ALL_ONES_U64)
    } else {
        v
    }
}

pub fn opt_fits_signed_bits(val_tc: u64, bits: u32) -> bool {
    if bits >= 64u32 {
        return true;
    }
    opt_sign_extend_u64(val_tc, bits) == val_tc
}

pub fn opt_checked_add_u64(a: u64, b: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let a_u = a & m;
    let b_u = b & m;
    let a_lo = a_u & OPT_LOW32_U64;
    let a_hi = (a_u >> 32u64) & OPT_LOW32_U64;
    let b_lo = b_u & OPT_LOW32_U64;
    let b_hi = (b_u >> 32u64) & OPT_LOW32_U64;
    let sum_lo = a_lo + b_lo;
    let carry = (sum_lo >> 32u64) & 1u64;
    let sum_hi_full = a_hi + b_hi + carry;
    let res = (sum_lo & OPT_LOW32_U64) | ((sum_hi_full & OPT_LOW32_U64) << 32u64);
    *out = res & m;
    if bits >= 64u32 {
        (sum_hi_full >> 32u64) != 0u64
    } else {
        (res & (m ^ OPT_ALL_ONES_U64)) != 0u64
    }
}

pub fn opt_checked_sub_u64(a: u64, b: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let a_u = a & m;
    let b_u = b & m;
    if a_u < b_u {
        *out = 0u64;
        return true;
    }
    *out = (a_u - b_u) & m;
    false
}

pub fn opt_mul_u32_to_u64(x: u64, y: u64) -> u64 {
    let x32 = x & OPT_LOW32_U64;
    let y_lo = y & 0xFFFFu64;
    let y_hi = (y >> 16u64) & 0xFFFFu64;
    let lo_prod = ((x32 as i64) * (y_lo as i64)) as u64;
    let hi_prod = ((x32 as i64) * (y_hi as i64)) as u64;
    lo_prod + (hi_prod << 16u64)
}

pub fn opt_div_rem_u64(n: u64, d: u64, rem_out: mut_view<u64>) -> u64 {
    if d == 0u64 {
        *rem_out = 0u64;
        return 0u64;
    }
    if (d & OPT_SIGN64_U64) != 0u64 {
        if n >= d {
            *rem_out = n - d;
            return 1u64;
        } else {
            *rem_out = n;
            return 0u64;
        }
    }
    let mut q: u64 = 0u64;
    let mut r: u64 = 0u64;
    let mut i: u32 = 64u32;
    while i > 0u32 {
        i = i - 1u32;
        let bit = (n >> (i as u64)) & 1u64;
        r = (r << 1u64) | bit;
        if r >= d {
            r = r - d;
            q = q | (1u64 << (i as u64));
        }
    }
    *rem_out = r;
    q
}

pub fn opt_checked_mul_u64_raw(a: u64, b: u64, out: mut_view<u64>) -> bool {
    let a_lo = a & OPT_LOW32_U64;
    let a_hi = (a >> 32u64) & OPT_LOW32_U64;
    let b_lo = b & OPT_LOW32_U64;
    let b_hi = (b >> 32u64) & OPT_LOW32_U64;
    let p0 = opt_mul_u32_to_u64(a_lo, b_lo);
    let p1 = opt_mul_u32_to_u64(a_lo, b_hi);
    let p2 = opt_mul_u32_to_u64(a_hi, b_lo);
    let mid = (p0 >> 32u64) + (p1 & OPT_LOW32_U64) + (p2 & OPT_LOW32_U64);
    *out = (p0 & OPT_LOW32_U64) | ((mid & OPT_LOW32_U64) << 32u64);
    if a_hi != 0u64 && b_hi != 0u64 {
        return true;
    }
    if (p1 >> 32u64) != 0u64 || (p2 >> 32u64) != 0u64 {
        return true;
    }
    (mid >> 32u64) != 0u64
}

pub fn opt_checked_mul_u64(a: u64, b: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let a_u = a & m;
    let b_u = b & m;
    let mut raw: u64 = 0u64;
    let ovf64 = opt_checked_mul_u64_raw(a_u, b_u, mut_view(raw));
    *out = raw & m;
    if bits >= 64u32 {
        ovf64
    } else {
        ovf64 || ((raw & (m ^ OPT_ALL_ONES_U64)) != 0u64)
    }
}

pub fn opt_checked_add_signed(a_tc: u64, b_tc: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let res_tc = opt_wrapping_add_u64(a_tc, b_tc);
    let same_sign = ((a_tc ^ b_tc) & OPT_SIGN64_U64) == 0u64;
    let flipped_sign = ((a_tc ^ res_tc) & OPT_SIGN64_U64) != 0u64;
    let ovf64 = same_sign && flipped_sign;
    let ovf = ovf64 || !opt_fits_signed_bits(res_tc, bits);
    *out = res_tc & m;
    ovf
}

pub fn opt_checked_sub_signed(a_tc: u64, b_tc: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let neg_b = opt_twos_complement_u64(b_tc);
    let res_tc = opt_wrapping_add_u64(a_tc, neg_b);
    let diff_sign = ((a_tc ^ b_tc) & OPT_SIGN64_U64) != 0u64;
    let flipped_sign = ((a_tc ^ res_tc) & OPT_SIGN64_U64) != 0u64;
    let ovf64 = diff_sign && flipped_sign;
    let ovf = ovf64 || !opt_fits_signed_bits(res_tc, bits);
    *out = res_tc & m;
    ovf
}

pub fn opt_checked_mul_signed(a_tc: u64, b_tc: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let a_neg = (a_tc & OPT_SIGN64_U64) != 0u64;
    let b_neg = (b_tc & OPT_SIGN64_U64) != 0u64;
    let a_mag: u64 = if a_neg {
        opt_twos_complement_u64(a_tc)
    } else {
        a_tc
    };
    let b_mag: u64 = if b_neg {
        opt_twos_complement_u64(b_tc)
    } else {
        b_tc
    };
    if a_mag == 0u64 || b_mag == 0u64 {
        *out = 0u64;
        return false;
    }
    let mut mag_prod: u64 = 0u64;
    let mag_ovf = opt_checked_mul_u64_raw(a_mag, b_mag, mut_view(mag_prod));
    if mag_ovf {
        *out = 0u64;
        return true;
    }
    let res_neg = a_neg != b_neg;
    let mut res_tc: u64 = 0u64;
    if res_neg {
        if mag_prod > OPT_SIGN64_U64 {
            *out = 0u64;
            return true;
        }
        res_tc = opt_twos_complement_u64(mag_prod);
    } else {
        if mag_prod >= OPT_SIGN64_U64 {
            *out = 0u64;
            return true;
        }
        res_tc = mag_prod;
    }
    if !opt_fits_signed_bits(res_tc, bits) {
        *out = 0u64;
        return true;
    }
    *out = res_tc & m;
    false
}

pub fn opt_signed_lt(a_tc: u64, b_tc: u64) -> bool {
    (a_tc ^ OPT_SIGN64_U64) < (b_tc ^ OPT_SIGN64_U64)
}

pub fn opt_signed_le(a_tc: u64, b_tc: u64) -> bool {
    (a_tc ^ OPT_SIGN64_U64) <= (b_tc ^ OPT_SIGN64_U64)
}

pub fn opt_u64_mul_wide(u: u64, v: u64, out_hi: mut_view<u64>) -> u64 {
    let u_lo = u & 0xFFFFFFFFu64;
    let u_hi = u >> 32u64;
    let v_lo = v & 0xFFFFFFFFu64;
    let v_hi = v >> 32u64;

    let p0 = u_lo * v_lo;
    let p1 = u_lo * v_hi;
    let p2 = u_hi * v_lo;
    let p3 = u_hi * v_hi;

    let mid = (p0 >> 32u64) + (p1 & 0xFFFFFFFFu64) + (p2 & 0xFFFFFFFFu64);
    let lo = (p0 & 0xFFFFFFFFu64) | (mid << 32u64);
    let hi = p3 + (p1 >> 32u64) + (p2 >> 32u64) + (mid >> 32u64);
    *out_hi = hi;
    lo
}

pub fn opt_u128_lt(alo: u64, ahi: u64, blo: u64, bhi: u64) -> bool {
    if ahi < bhi {
        return true;
    }
    if ahi == bhi {
        return alo < blo;
    }
    false
}

pub fn opt_u128_le(alo: u64, ahi: u64, blo: u64, bhi: u64) -> bool {
    if ahi < bhi {
        return true;
    }
    if ahi == bhi {
        return alo <= blo;
    }
    false
}

pub fn opt_u128_ge(alo: u64, ahi: u64, blo: u64, bhi: u64) -> bool {
    opt_u128_le(blo, bhi, alo, ahi)
}

pub fn opt_i128_lt(alo: u64, ahi: u64, blo: u64, bhi: u64) -> bool {
    let a_s = (ahi >> 63u64) & 1u64;
    let b_s = (bhi >> 63u64) & 1u64;
    if a_s != b_s {
        return a_s > b_s;
    }
    opt_u128_lt(alo, ahi, blo, bhi)
}

pub fn opt_i128_le(alo: u64, ahi: u64, blo: u64, bhi: u64) -> bool {
    let a_s = (ahi >> 63u64) & 1u64;
    let b_s = (bhi >> 63u64) & 1u64;
    if a_s != b_s {
        return a_s > b_s;
    }
    opt_u128_le(alo, ahi, blo, bhi)
}

pub fn opt_i128_gt(alo: u64, ahi: u64, blo: u64, bhi: u64) -> bool {
    opt_i128_lt(blo, bhi, alo, ahi)
}

pub fn opt_i128_ge(alo: u64, ahi: u64, blo: u64, bhi: u64) -> bool {
    opt_i128_le(blo, bhi, alo, ahi)
}

pub fn opt_u128_add_raw(alo: u64, ahi: u64, blo: u64, bhi: u64, out_hi: mut_view<u64>, out_ovf: mut_view<bool>, is_signed: bool) -> u64 {
    let slo = opt_wrapping_add_u64(alo, blo);
    let carry: u64 = if slo < alo { 1u64 } else { 0u64 };
    let s1 = opt_wrapping_add_u64(ahi, bhi);
    let shi_carry = s1 < ahi;
    let shi = opt_wrapping_add_u64(s1, carry);
    let s2_carry = shi < s1;
    if is_signed {
        let sign_a = (ahi >> 63u64) & 1u64;
        let sign_b = (bhi >> 63u64) & 1u64;
        let sign_r = (shi >> 63u64) & 1u64;
        *out_ovf = (sign_a == sign_b) && (sign_r != sign_a);
    } else {
        *out_ovf = shi_carry || s2_carry;
    }
    *out_hi = shi;
    slo
}

pub fn opt_u128_sub_raw(alo: u64, ahi: u64, blo: u64, bhi: u64, out_hi: mut_view<u64>, out_ovf: mut_view<bool>, is_signed: bool) -> u64 {
    let borrow: u64 = if alo < blo { 1u64 } else { 0u64 };
    let rlo = opt_wrapping_add_u64(alo, opt_twos_complement_u64(blo));
    let rhi1 = opt_wrapping_add_u64(ahi, opt_twos_complement_u64(bhi));
    let rhi = opt_wrapping_add_u64(rhi1, opt_twos_complement_u64(borrow));
    if is_signed {
        let sign_a = (ahi >> 63u64) & 1u64;
        let sign_b = (bhi >> 63u64) & 1u64;
        let sign_r = (rhi >> 63u64) & 1u64;
        *out_ovf = (sign_a != sign_b) && (sign_r != sign_a);
    } else {
        *out_ovf = (ahi < bhi) || (ahi == bhi && alo < blo);
    }
    *out_hi = rhi;
    rlo
}

pub fn opt_u128_neg_raw(lo: u64, hi: u64, out_lo: mut_view<u64>, out_hi: mut_view<u64>) {
    let nlo = opt_wrapping_add_u64(0u64, opt_twos_complement_u64(lo));
    let mut borrow: u64 = 0u64;
    if lo != 0u64 {
        borrow = 1u64;
    }
    let nhi1 = opt_wrapping_add_u64(0u64, opt_twos_complement_u64(hi));
    let nhi = opt_wrapping_add_u64(nhi1, opt_twos_complement_u64(borrow));
    *out_lo = nlo;
    *out_hi = nhi;
}

pub fn opt_u128_mul_raw(alo: u64, ahi: u64, blo: u64, bhi: u64, out_hi: mut_view<u64>, out_ovf: mut_view<bool>, is_signed: bool) -> u64 {
    if !is_signed {
        let mut ovf = false;
        if ahi != 0u64 && bhi != 0u64 {
            ovf = true;
        }
        let mut m0_hi: u64 = 0u64;
        let rlo = opt_u64_mul_wide(alo, blo, mut_view(m0_hi));

        let mut c1_hi: u64 = 0u64;
        let c1_lo = opt_u64_mul_wide(alo, bhi, mut_view(c1_hi));

        let mut c2_hi: u64 = 0u64;
        let c2_lo = opt_u64_mul_wide(ahi, blo, mut_view(c2_hi));

        if c1_hi != 0u64 || c2_hi != 0u64 {
            ovf = true;
        }

        let s1 = opt_wrapping_add_u64(m0_hi, c1_lo);
        let ovf1 = s1 < m0_hi;
        let rhi = opt_wrapping_add_u64(s1, c2_lo);
        let ovf2 = rhi < s1;
        if ovf1 || ovf2 {
            ovf = true;
        }
        *out_ovf = ovf;
        *out_hi = rhi;
        return rlo;
    }

    let sign_a = (ahi >> 63u64) & 1u64;
    let sign_b = (bhi >> 63u64) & 1u64;

    let mut abs_a_lo = alo;
    let mut abs_a_hi = ahi;
    if sign_a != 0u64 {
        opt_u128_neg_raw(alo, ahi, mut_view(abs_a_lo), mut_view(abs_a_hi));
    }

    let mut abs_b_lo = blo;
    let mut abs_b_hi = bhi;
    if sign_b != 0u64 {
        opt_u128_neg_raw(blo, bhi, mut_view(abs_b_lo), mut_view(abs_b_hi));
    }

    let mut abs_ovf = false;
    let mut prod_hi: u64 = 0u64;
    let prod_lo = opt_u128_mul_raw(abs_a_lo, abs_a_hi, abs_b_lo, abs_b_hi, mut_view(prod_hi), mut_view(abs_ovf), false);

    if (alo == 0u64 && ahi == 0u64) || (blo == 0u64 && bhi == 0u64) {
        *out_ovf = false;
        *out_hi = 0u64;
        return 0u64;
    }

    if abs_ovf {
        *out_ovf = true;
    } else if sign_a == sign_b {
        *out_ovf = prod_hi >= 0x8000000000000000u64;
    } else {
        *out_ovf = prod_hi > 0x8000000000000000u64 || (prod_hi == 0x8000000000000000u64 && prod_lo != 0u64);
    }

    if sign_a != sign_b {
        let mut neg_lo: u64 = 0u64;
        let mut neg_hi: u64 = 0u64;
        opt_u128_neg_raw(prod_lo, prod_hi, mut_view(neg_lo), mut_view(neg_hi));
        *out_hi = neg_hi;
        neg_lo
    } else {
        *out_hi = prod_hi;
        prod_lo
    }
}

pub fn opt_u128_shl_raw(alo: u64, ahi: u64, sh: u64, out_hi: mut_view<u64>) -> u64 {
    if sh == 0u64 {
        *out_hi = ahi;
        return alo;
    }
    if sh < 64u64 {
        let rlo = alo << sh;
        let rhi = (ahi << sh) | (alo >> (64u64 - sh));
        *out_hi = rhi;
        return rlo;
    }
    if sh == 64u64 {
        *out_hi = alo;
        return 0u64;
    }
    if sh < 128u64 {
        *out_hi = alo << (sh - 64u64);
        return 0u64;
    }
    *out_hi = 0u64;
    0u64
}

pub fn opt_u128_shr_raw(alo: u64, ahi: u64, sh: u64, out_hi: mut_view<u64>) -> u64 {
    if sh == 0u64 {
        *out_hi = ahi;
        return alo;
    }
    if sh < 64u64 {
        let rlo = (alo >> sh) | (ahi << (64u64 - sh));
        let rhi = ahi >> sh;
        *out_hi = rhi;
        return rlo;
    }
    if sh == 64u64 {
        *out_hi = 0u64;
        return ahi;
    }
    if sh < 128u64 {
        *out_hi = 0u64;
        return ahi >> (sh - 64u64);
    }
    *out_hi = 0u64;
    0u64
}

pub fn opt_i128_shr_raw(alo: u64, ahi: u64, sh: u64, out_hi: mut_view<u64>) -> u64 {
    let sign = (ahi >> 63u64) & 1u64;
    if sign == 0u64 {
        return opt_u128_shr_raw(alo, ahi, sh, out_hi);
    }
    if sh == 0u64 {
        *out_hi = ahi;
        return alo;
    }
    if sh < 64u64 {
        let rlo = (alo >> sh) | (ahi << (64u64 - sh));
        let fill = 0xFFFFFFFFFFFFFFFFu64 << (64u64 - sh);
        let rhi = (ahi >> sh) | fill;
        *out_hi = rhi;
        return rlo;
    }
    if sh == 64u64 {
        *out_hi = 0xFFFFFFFFFFFFFFFFu64;
        return ahi;
    }
    if sh < 128u64 {
        let fill = 0xFFFFFFFFFFFFFFFFu64 << (128u64 - sh);
        let rlo = (ahi >> (sh - 64u64)) | fill;
        *out_hi = 0xFFFFFFFFFFFFFFFFu64;
        return rlo;
    }
    *out_hi = 0xFFFFFFFFFFFFFFFFu64;
    0xFFFFFFFFFFFFFFFFu64
}

pub fn opt_u128_div_rem_raw(
    alo: u64, ahi: u64,
    blo: u64, bhi: u64,
    out_q_lo: mut_view<u64>, out_q_hi: mut_view<u64>,
    out_r_lo: mut_view<u64>, out_r_hi: mut_view<u64>
) {
    if blo == 0u64 && bhi == 0u64 {
        *out_q_lo = 0u64;
        *out_q_hi = 0u64;
        *out_r_lo = 0u64;
        *out_r_hi = 0u64;
        return;
    }
    if bhi == 0u64 && ahi == 0u64 {
        let mut rem_unused: u64 = 0u64;
        *out_q_lo = opt_div_rem_u64(alo, blo, mut_view(rem_unused));
        *out_q_hi = 0u64;
        *out_r_lo = rem_unused;
        *out_r_hi = 0u64;
        return;
    }
    if opt_u128_lt(alo, ahi, blo, bhi) {
        *out_q_lo = 0u64;
        *out_q_hi = 0u64;
        *out_r_lo = alo;
        *out_r_hi = ahi;
        return;
    }
    if alo == blo && ahi == bhi {
        *out_q_lo = 1u64;
        *out_q_hi = 0u64;
        *out_r_lo = 0u64;
        *out_r_hi = 0u64;
        return;
    }
    let mut rem_lo: u64 = 0u64;
    let mut rem_hi: u64 = 0u64;
    let mut q_lo: u64 = 0u64;
    let mut q_hi: u64 = 0u64;

    let mut i: i32 = 127;
    while i >= 0 {
        let bit_i: u64 = if i >= 64 {
            (ahi >> ((i - 64) as u64)) & 1u64
        } else {
            (alo >> (i as u64)) & 1u64
        };
        let rem_carry = (rem_lo >> 63u64) & 1u64;
        rem_hi = (rem_hi << 1u64) | rem_carry;
        rem_lo = (rem_lo << 1u64) | bit_i;

        if opt_u128_ge(rem_lo, rem_hi, blo, bhi) {
            let mut sub_ovf = false;
            let mut new_rem_hi: u64 = 0u64;
            rem_lo = opt_u128_sub_raw(rem_lo, rem_hi, blo, bhi, mut_view(new_rem_hi), mut_view(sub_ovf), false);
            rem_hi = new_rem_hi;
            if i >= 64 {
                q_hi = q_hi | (1u64 << ((i - 64) as u64));
            } else {
                q_lo = q_lo | (1u64 << (i as u64));
            }
        }
        i = i - 1;
    }
    *out_q_lo = q_lo;
    *out_q_hi = q_hi;
    *out_r_lo = rem_lo;
    *out_r_hi = rem_hi;
}

pub fn opt_is_scalar_const_op(op: view<MirOperand>) -> bool {
    if op.kind != MIR_OP_CONST {
        return false;
    }
    op.constant.kind == MIR_CONST_INT || op.constant.kind == MIR_CONST_BOOL
}

pub fn opt_extract_shift_amount(
    thir: *const Thir,
    rhs: view<MirOperand>,
    lhs_bits: u32,
    out_sh: mut_view<u64>
) -> bool {
    *out_sh = 0u64;
    let rhs_ty_v = rhs.constant.ty.v;
    if !opt_type_is_int_scalar(thir, (TypeId { v: rhs_ty_v })) {
        return false;
    }
    let rhs_bits = opt_type_bits(thir, TypeId { v: rhs_ty_v });
    if rhs_bits == 0u32 || rhs_bits > 128u32 {
        return false;
    }
    let rhs_signed = opt_type_is_signed(thir, TypeId { v: rhs_ty_v });
    if rhs_bits == 128u32 {
        let rlo = rhs.constant.val;
        let rhi = mir_const_int_hi(view(rhs.constant));
        if (rhs_signed && ((rhi >> 63u64) & 1u64) != 0u64) || rhi != 0u64 || rlo >= (lhs_bits as u64) {
            return false;
        }
        *out_sh = rlo;
        return true;
    }
    let rraw = rhs.constant.val;
    if rhs_signed {
        let rtc = opt_sign_extend_u64(rraw, rhs_bits);
        if (rtc & OPT_SIGN64_U64) != 0u64 || rtc >= (lhs_bits as u64) {
            return false;
        }
        *out_sh = rtc;
        return true;
    }
    let ru = rraw & opt_bit_mask(rhs_bits);
    if ru >= (lhs_bits as u64) {
        return false;
    }
    *out_sh = ru;
    true
}

// --- Binary, Unary & Cast Constant Folding ---

pub fn do_const_fold_binop(
    thir: *const Thir,
    op: u8,
    lhs: view<MirOperand>,
    rhs: view<MirOperand>,
    out_const: mut_view<MirConst>
) -> bool {
    if !opt_is_scalar_const_op(lhs) || !opt_is_scalar_const_op(rhs) {
        return false;
    }
    let is_shift = op == MIR_BINOP_SHL || op == MIR_BINOP_SHR;
    if !is_shift && lhs.constant.ty.v != rhs.constant.ty.v {
        return false;
    }

    let ty_v = lhs.constant.ty.v;
    if is_shift && !opt_type_is_int_scalar(thir, (TypeId { v: ty_v })) {
        return false;
    }
    let bits = opt_type_bits(thir, TypeId { v: ty_v });
    if bits == 0u32 || bits > 128u32 {
        return false;
    }

    if bits == 128u32 {
        let alo = lhs.constant.val;
        let ahi = mir_const_int_hi(view(lhs.constant));
        let blo = rhs.constant.val;
        let bhi = mir_const_int_hi(view(rhs.constant));
        let is_signed = opt_type_is_signed(thir, TypeId { v: ty_v });

        let mut res: u64 = 0u64;
        let mut res_hi: u64 = 0u64;
        let mut overflow = false;
        let mut res_ty_v: u32 = ty_v;

        if op == MIR_BINOP_ADD {
            res = opt_u128_add_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(overflow), is_signed);
        } else if op == MIR_BINOP_SUB {
            res = opt_u128_sub_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(overflow), is_signed);
        } else if op == MIR_BINOP_MUL {
            res = opt_u128_mul_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(overflow), is_signed);
        } else if op == MIR_BINOP_DIV {
            if blo == 0u64 && bhi == 0u64 {
                overflow = true;
            } else if is_signed && alo == 0u64 && ahi == 0x8000000000000000u64 && blo == 0xFFFFFFFFFFFFFFFFu64 && bhi == 0xFFFFFFFFFFFFFFFFu64 {
                overflow = true;
            } else if is_signed {
                let sign_a = (ahi >> 63u64) & 1u64;
                let sign_b = (bhi >> 63u64) & 1u64;
                let mut abs_a_lo = alo;
                let mut abs_a_hi = ahi;
                if sign_a != 0u64 {
                    opt_u128_neg_raw(alo, ahi, mut_view(abs_a_lo), mut_view(abs_a_hi));
                }
                let mut abs_b_lo = blo;
                let mut abs_b_hi = bhi;
                if sign_b != 0u64 {
                    opt_u128_neg_raw(blo, bhi, mut_view(abs_b_lo), mut_view(abs_b_hi));
                }
                let mut q_lo = 0u64;
                let mut q_hi = 0u64;
                let mut r_lo = 0u64;
                let mut r_hi = 0u64;
                opt_u128_div_rem_raw(abs_a_lo, abs_a_hi, abs_b_lo, abs_b_hi, mut_view(q_lo), mut_view(q_hi), mut_view(r_lo), mut_view(r_hi));
                if sign_a != sign_b && (q_lo != 0u64 || q_hi != 0u64) {
                    opt_u128_neg_raw(q_lo, q_hi, mut_view(res), mut_view(res_hi));
                } else {
                    res = q_lo;
                    res_hi = q_hi;
                }
            } else {
                let mut r_lo = 0u64;
                let mut r_hi = 0u64;
                opt_u128_div_rem_raw(alo, ahi, blo, bhi, mut_view(res), mut_view(res_hi), mut_view(r_lo), mut_view(r_hi));
            }
        } else if op == MIR_BINOP_REM {
            if blo == 0u64 && bhi == 0u64 {
                overflow = true;
            } else if is_signed && alo == 0u64 && ahi == 0x8000000000000000u64 && blo == 0xFFFFFFFFFFFFFFFFu64 && bhi == 0xFFFFFFFFFFFFFFFFu64 {
                overflow = true;
            } else if is_signed {
                let sign_a = (ahi >> 63u64) & 1u64;
                let sign_b = (bhi >> 63u64) & 1u64;
                let mut abs_a_lo = alo;
                let mut abs_a_hi = ahi;
                if sign_a != 0u64 {
                    opt_u128_neg_raw(alo, ahi, mut_view(abs_a_lo), mut_view(abs_a_hi));
                }
                let mut abs_b_lo = blo;
                let mut abs_b_hi = bhi;
                if sign_b != 0u64 {
                    opt_u128_neg_raw(blo, bhi, mut_view(abs_b_lo), mut_view(abs_b_hi));
                }
                let mut q_lo = 0u64;
                let mut q_hi = 0u64;
                let mut r_lo = 0u64;
                let mut r_hi = 0u64;
                opt_u128_div_rem_raw(abs_a_lo, abs_a_hi, abs_b_lo, abs_b_hi, mut_view(q_lo), mut_view(q_hi), mut_view(r_lo), mut_view(r_hi));
                if sign_a != 0u64 && (r_lo != 0u64 || r_hi != 0u64) {
                    opt_u128_neg_raw(r_lo, r_hi, mut_view(res), mut_view(res_hi));
                } else {
                    res = r_lo;
                    res_hi = r_hi;
                }
            } else {
                let mut q_lo = 0u64;
                let mut q_hi = 0u64;
                opt_u128_div_rem_raw(alo, ahi, blo, bhi, mut_view(q_lo), mut_view(q_hi), mut_view(res), mut_view(res_hi));
            }
        } else if op == MIR_BINOP_SHL {
            let mut sh128: u64 = 0u64;
            if !opt_extract_shift_amount(thir, rhs, 128u32, mut_view(sh128)) {
                overflow = true;
            } else {
                res = opt_u128_shl_raw(alo, ahi, sh128, mut_view(res_hi));
            }
        } else if op == MIR_BINOP_SHR {
            let mut sh128: u64 = 0u64;
            if !opt_extract_shift_amount(thir, rhs, 128u32, mut_view(sh128)) {
                overflow = true;
            } else if is_signed {
                res = opt_i128_shr_raw(alo, ahi, sh128, mut_view(res_hi));
            } else {
                res = opt_u128_shr_raw(alo, ahi, sh128, mut_view(res_hi));
            }
        } else if op == MIR_BINOP_BIT_AND {
            res = alo & blo;
            res_hi = ahi & bhi;
        } else if op == MIR_BINOP_BIT_OR {
            res = alo | blo;
            res_hi = ahi | bhi;
        } else if op == MIR_BINOP_BIT_XOR {
            res = alo ^ blo;
            res_hi = ahi ^ bhi;
        } else if op == MIR_BINOP_EQ {
            res = if alo == blo && ahi == bhi { 1u64 } else { 0u64 };
            let bty = opt_bool_type_id(thir);
            res_ty_v = bty.v;
        } else if op == MIR_BINOP_NE {
            res = if alo != blo || ahi != bhi { 1u64 } else { 0u64 };
            let bty = opt_bool_type_id(thir);
            res_ty_v = bty.v;
        } else if op == MIR_BINOP_LT {
            let cmp = if is_signed { opt_i128_lt(alo, ahi, blo, bhi) } else { opt_u128_lt(alo, ahi, blo, bhi) };
            res = if cmp { 1u64 } else { 0u64 };
            let bty = opt_bool_type_id(thir);
            res_ty_v = bty.v;
        } else if op == MIR_BINOP_LE {
            let cmp = if is_signed { opt_i128_le(alo, ahi, blo, bhi) } else { opt_u128_le(alo, ahi, blo, bhi) };
            res = if cmp { 1u64 } else { 0u64 };
            let bty = opt_bool_type_id(thir);
            res_ty_v = bty.v;
        } else if op == MIR_BINOP_GT {
            let cmp = if is_signed { opt_i128_gt(alo, ahi, blo, bhi) } else { opt_u128_lt(blo, bhi, alo, ahi) };
            res = if cmp { 1u64 } else { 0u64 };
            let bty = opt_bool_type_id(thir);
            res_ty_v = bty.v;
        } else if op == MIR_BINOP_GE {
            let cmp = if is_signed { opt_i128_ge(alo, ahi, blo, bhi) } else { opt_u128_le(blo, bhi, alo, ahi) };
            res = if cmp { 1u64 } else { 0u64 };
            let bty = opt_bool_type_id(thir);
            res_ty_v = bty.v;
        } else if op == MIR_BINOP_WRAPPING_ADD {
            let mut dummy_ovf = false;
            res = opt_u128_add_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(dummy_ovf), false);
        } else if op == MIR_BINOP_WRAPPING_SUB {
            let mut dummy_ovf = false;
            res = opt_u128_sub_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(dummy_ovf), false);
        } else if op == MIR_BINOP_WRAPPING_MUL {
            let mut dummy_ovf = false;
            res = opt_u128_mul_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(dummy_ovf), false);
        } else if op == MIR_BINOP_SAT_ADD {
            res = opt_u128_add_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(overflow), is_signed);
            if overflow {
                if is_signed {
                    let sign_a = (ahi >> 63u64) & 1u64;
                    if sign_a == 0u64 {
                        res = 0xFFFFFFFFFFFFFFFFu64;
                        res_hi = 0x7FFFFFFFFFFFFFFFu64;
                    } else {
                        res = 0u64;
                        res_hi = 0x8000000000000000u64;
                    }
                } else {
                    res = 0xFFFFFFFFFFFFFFFFu64;
                    res_hi = 0xFFFFFFFFFFFFFFFFu64;
                }
                overflow = false;
            }
        } else if op == MIR_BINOP_SAT_SUB {
            res = opt_u128_sub_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(overflow), is_signed);
            if overflow {
                if is_signed {
                    let sign_a = (ahi >> 63u64) & 1u64;
                    if sign_a == 0u64 {
                        res = 0xFFFFFFFFFFFFFFFFu64;
                        res_hi = 0x7FFFFFFFFFFFFFFFu64;
                    } else {
                        res = 0u64;
                        res_hi = 0x8000000000000000u64;
                    }
                } else {
                    res = 0u64;
                    res_hi = 0u64;
                }
                overflow = false;
            }
        } else if op == MIR_BINOP_SAT_MUL {
            res = opt_u128_mul_raw(alo, ahi, blo, bhi, mut_view(res_hi), mut_view(overflow), is_signed);
            if overflow {
                if is_signed {
                    let sign_a = (ahi >> 63u64) & 1u64;
                    let sign_b = (bhi >> 63u64) & 1u64;
                    if sign_a == sign_b {
                        res = 0xFFFFFFFFFFFFFFFFu64;
                        res_hi = 0x7FFFFFFFFFFFFFFFu64;
                    } else {
                        res = 0u64;
                        res_hi = 0x8000000000000000u64;
                    }
                } else {
                    res = 0xFFFFFFFFFFFFFFFFu64;
                    res_hi = 0xFFFFFFFFFFFFFFFFu64;
                }
                overflow = false;
            }
        } else {
            return false;
        }

        if overflow {
            return false;
        }

        mir_const_reset_vals(mut_view(*out_const), MIR_CONST_INT, res_ty_v, res);
        mir_const_set_int_hi(mut_view(*out_const), res_hi);
        return true;
    }
    let is_signed = opt_type_is_signed(thir, TypeId { v: ty_v });
    let mask = opt_bit_mask(bits);

    let a_val = lhs.constant.val;
    let b_val = rhs.constant.val;
    let a_tc = opt_sign_extend_u64(a_val, bits);
    let b_tc = opt_sign_extend_u64(b_val, bits);

    let mut res: u64 = 0u64;
    let mut overflow: bool = false;
    let mut res_ty_v: u32 = ty_v;

    if op == MIR_BINOP_ADD {
        if is_signed {
            overflow = opt_checked_add_signed(a_tc, b_tc, bits, mut_view(res));
        } else {
            overflow = opt_checked_add_u64(a_val, b_val, bits, mut_view(res));
        }
    } else if op == MIR_BINOP_SUB {
        if is_signed {
            overflow = opt_checked_sub_signed(a_tc, b_tc, bits, mut_view(res));
        } else {
            overflow = opt_checked_sub_u64(a_val, b_val, bits, mut_view(res));
        }
    } else if op == MIR_BINOP_MUL {
        if is_signed {
            overflow = opt_checked_mul_signed(a_tc, b_tc, bits, mut_view(res));
        } else {
            overflow = opt_checked_mul_u64(a_val, b_val, bits, mut_view(res));
        }
    } else if op == MIR_BINOP_DIV {
        if is_signed {
            let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(bits), bits);
            if b_tc == 0u64 || (a_tc == min_tc && b_tc == OPT_ALL_ONES_U64) {
                overflow = true;
            } else {
                let a_neg = (a_tc & OPT_SIGN64_U64) != 0u64;
                let b_neg = (b_tc & OPT_SIGN64_U64) != 0u64;
                let a_mag: u64 = if a_neg { opt_twos_complement_u64(a_tc) } else { a_tc };
                let b_mag: u64 = if b_neg { opt_twos_complement_u64(b_tc) } else { b_tc };
                let mut rem_unused: u64 = 0u64;
                let q_mag = opt_div_rem_u64(a_mag, b_mag, mut_view(rem_unused));
                let q_tc: u64 = if (a_neg != b_neg) && q_mag != 0u64 {
                    opt_twos_complement_u64(q_mag)
                } else {
                    q_mag
                };
                res = q_tc & mask;
            }
        } else {
            let b_u = b_val & mask;
            if b_u == 0u64 {
                overflow = true;
            } else {
                let mut rem_unused: u64 = 0u64;
                let q_u = opt_div_rem_u64(a_val & mask, b_u, mut_view(rem_unused));
                res = q_u & mask;
            }
        }
    } else if op == MIR_BINOP_REM {
        if is_signed {
            let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(bits), bits);
            if b_tc == 0u64 || (a_tc == min_tc && b_tc == OPT_ALL_ONES_U64) {
                overflow = true;
            } else {
                let a_neg = (a_tc & OPT_SIGN64_U64) != 0u64;
                let b_neg = (b_tc & OPT_SIGN64_U64) != 0u64;
                let a_mag: u64 = if a_neg { opt_twos_complement_u64(a_tc) } else { a_tc };
                let b_mag: u64 = if b_neg { opt_twos_complement_u64(b_tc) } else { b_tc };
                let mut r_mag: u64 = 0u64;
                let _q_unused = opt_div_rem_u64(a_mag, b_mag, mut_view(r_mag));
                let r_tc: u64 = if a_neg && r_mag != 0u64 {
                    opt_twos_complement_u64(r_mag)
                } else {
                    r_mag
                };
                res = r_tc & mask;
            }
        } else {
            let b_u = b_val & mask;
            if b_u == 0u64 {
                overflow = true;
            } else {
                let mut r_u: u64 = 0u64;
                let _q_unused = opt_div_rem_u64(a_val & mask, b_u, mut_view(r_u));
                res = r_u & mask;
            }
        }
    } else if op == MIR_BINOP_SHL {
        let mut sh64: u64 = 0u64;
        if !opt_extract_shift_amount(thir, rhs, bits, mut_view(sh64)) {
            overflow = true;
        } else {
            res = ((a_val & mask) << sh64) & mask;
        }
    } else if op == MIR_BINOP_SHR {
        let mut sh64: u64 = 0u64;
        if !opt_extract_shift_amount(thir, rhs, bits, mut_view(sh64)) {
            overflow = true;
        } else if is_signed {
            if sh64 == 0u64 {
                res = a_tc & mask;
            } else {
                let shifted = a_tc >> sh64;
                if (a_tc & OPT_SIGN64_U64) != 0u64 {
                    let fill = OPT_ALL_ONES_U64 << (64u64 - sh64);
                    res = (shifted | fill) & mask;
                } else {
                    res = shifted & mask;
                }
            }
        } else {
            res = ((a_val & mask) >> sh64) & mask;
        }
    } else if op == MIR_BINOP_BIT_AND {
        res = (a_val & b_val) & mask;
    } else if op == MIR_BINOP_BIT_OR {
        res = (a_val | b_val) & mask;
    } else if op == MIR_BINOP_BIT_XOR {
        res = (a_val ^ b_val) & mask;
    } else if op == MIR_BINOP_EQ {
        res = if (a_val & mask) == (b_val & mask) { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_NE {
        res = if (a_val & mask) != (b_val & mask) { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_LT {
        let cmp: bool = if is_signed {
            opt_signed_lt(a_tc, b_tc)
        } else {
            (a_val & mask) < (b_val & mask)
        };
        res = if cmp { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_LE {
        let cmp: bool = if is_signed {
            opt_signed_le(a_tc, b_tc)
        } else {
            (a_val & mask) <= (b_val & mask)
        };
        res = if cmp { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_GT {
        let cmp: bool = if is_signed {
            opt_signed_lt(b_tc, a_tc)
        } else {
            (a_val & mask) > (b_val & mask)
        };
        res = if cmp { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_GE {
        let cmp: bool = if is_signed {
            opt_signed_le(b_tc, a_tc)
        } else {
            (a_val & mask) >= (b_val & mask)
        };
        res = if cmp { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_WRAPPING_ADD {
        res = opt_wrapping_add_u64(a_val, b_val) & mask;
    } else if op == MIR_BINOP_WRAPPING_SUB {
        res = opt_wrapping_add_u64(a_val, opt_twos_complement_u64(b_val)) & mask;
    } else if op == MIR_BINOP_WRAPPING_MUL {
        let mut p_raw: u64 = 0u64;
        let _ = opt_checked_mul_u64_raw(a_val, b_val, mut_view(p_raw));
        res = p_raw & mask;
    } else if op == MIR_BINOP_SAT_ADD {
        if is_signed {
            let mut ovf = opt_checked_add_signed(a_tc, b_tc, bits, mut_view(res));
            if ovf {
                let sign_a = (a_tc & OPT_SIGN64_U64) != 0u64;
                if !sign_a {
                    res = (1u64 << ((bits - 1) as u64)) - 1u64;
                } else {
                    res = opt_sign_extend_u64(1u64 << ((bits - 1) as u64), bits) & mask;
                }
            }
        } else {
            let mut ovf = opt_checked_add_u64(a_val, b_val, bits, mut_view(res));
            if ovf {
                res = mask;
            }
        }
    } else if op == MIR_BINOP_SAT_SUB {
        if is_signed {
            let mut ovf = opt_checked_sub_signed(a_tc, b_tc, bits, mut_view(res));
            if ovf {
                let sign_a = (a_tc & OPT_SIGN64_U64) != 0u64;
                if !sign_a {
                    res = (1u64 << ((bits - 1) as u64)) - 1u64;
                } else {
                    res = opt_sign_extend_u64(1u64 << ((bits - 1) as u64), bits) & mask;
                }
            }
        } else {
            let mut ovf = opt_checked_sub_u64(a_val, b_val, bits, mut_view(res));
            if ovf {
                res = 0u64;
            }
        }
    } else if op == MIR_BINOP_SAT_MUL {
        if is_signed {
            let mut ovf = opt_checked_mul_signed(a_tc, b_tc, bits, mut_view(res));
            if ovf {
                let sign_a = (a_tc & OPT_SIGN64_U64) != 0u64;
                let sign_b = (b_tc & OPT_SIGN64_U64) != 0u64;
                if sign_a == sign_b {
                    res = (1u64 << ((bits - 1) as u64)) - 1u64;
                } else {
                    res = opt_sign_extend_u64(1u64 << ((bits - 1) as u64), bits) & mask;
                }
            }
        } else {
            let mut ovf = opt_checked_mul_u64(a_val, b_val, bits, mut_view(res));
            if ovf {
                res = mask;
            }
        }
    } else {
        return false;
    }

    if overflow {
        return false;
    }

    mir_const_reset_vals(mut_view(*out_const), MIR_CONST_INT, res_ty_v, res);
    true
}

pub fn do_const_fold_unop(
    thir: *const Thir,
    op: u8,
    operand: view<MirOperand>,
    out_const: mut_view<MirConst>
) -> bool {
    if !opt_is_scalar_const_op(operand) {
        return false;
    }

    let ty_v = operand.constant.ty.v;
    let bits = opt_type_bits(thir, TypeId { v: ty_v });
    if bits == 0u32 || bits > 128u32 {
        return false;
    }
    let is_signed = opt_type_is_signed(thir, TypeId { v: ty_v });

    if bits == 128u32 {
        let alo = operand.constant.val;
        let ahi = mir_const_int_hi(view(operand.constant));
        let mut res: u64 = 0u64;
        let mut res_hi: u64 = 0u64;
        if op == MIR_UNOP_BITNOT {
            res = alo ^ 0xFFFFFFFFFFFFFFFFu64;
            res_hi = ahi ^ 0xFFFFFFFFFFFFFFFFu64;
        } else if op == MIR_UNOP_NEG {
            if !is_signed {
                return false;
            }
            if alo == 0u64 && ahi == 0x8000000000000000u64 {
                return false;
            }
            opt_u128_neg_raw(alo, ahi, mut_view(res), mut_view(res_hi));
        } else {
            return false;
        }
        mir_const_reset_vals(mut_view(*out_const), MIR_CONST_INT, ty_v, res);
        mir_const_set_int_hi(mut_view(*out_const), res_hi);
        return true;
    }

    let mask = opt_bit_mask(bits);
    let val = operand.constant.val;

    let mut res: u64 = 0u64;
    if op == MIR_UNOP_NOT {
        let is_b = opt_type_is_bool(thir, TypeId { v: ty_v });
        if !is_b {
            return false;
        }
        res = if val == 0u64 { 1u64 } else { 0u64 };
    } else if op == MIR_UNOP_BITNOT {
        res = (val ^ OPT_ALL_ONES_U64) & mask;
    } else if op == MIR_UNOP_NEG {
        if !is_signed {
            return false;
        }
        let s_tc = opt_sign_extend_u64(val, bits);
        let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(bits), bits);
        if s_tc == min_tc {
            return false;
        }
        res = opt_twos_complement_u64(s_tc) & mask;
    } else {
        return false;
    }

    mir_const_reset_vals(mut_view(*out_const), MIR_CONST_INT, ty_v, res);
    true
}

pub fn do_const_fold_cast(
    thir: *const Thir,
    cast_kind: u8,
    operand: view<MirOperand>,
    target_ty: TypeId,
    out_const: mut_view<MirConst>
) -> bool {
    if cast_kind != MIR_CAST_INT_TO_INT {
        return false;
    }
    if !opt_is_scalar_const_op(operand) {
        return false;
    }
    let src_ty_v = operand.constant.ty.v;
    let dst_ty_v = target_ty.v;
    if !opt_type_is_int_scalar(thir, (TypeId { v: src_ty_v })) || !opt_type_is_int_scalar(thir, (TypeId { v: dst_ty_v })) {
        return false;
    }
    let src_bits = opt_type_bits(thir, TypeId { v: src_ty_v });
    let dst_bits = opt_type_bits(thir, TypeId { v: dst_ty_v });
    if src_bits == 0u32 || src_bits > 128u32 || dst_bits == 0u32 || dst_bits > 128u32 {
        return false;
    }
    let src_signed = opt_type_is_signed(thir, TypeId { v: src_ty_v });

    let mut res_lo: u64 = 0u64;
    let mut res_hi: u64 = 0u64;

    if src_bits == 128u32 {
        let alo = operand.constant.val;
        let ahi = mir_const_int_hi(view(operand.constant));
        if dst_bits == 128u32 {
            res_lo = alo;
            res_hi = ahi;
        } else if dst_bits == 64u32 {
            res_lo = alo;
            res_hi = 0u64;
        } else {
            res_lo = alo & opt_bit_mask(dst_bits);
            res_hi = 0u64;
        }
    } else {
        let raw = operand.constant.val;
        let ext64: u64 = if src_signed {
            opt_sign_extend_u64(raw, src_bits)
        } else {
            raw & opt_bit_mask(src_bits)
        };
        if dst_bits == 128u32 {
            res_lo = ext64;
            res_hi = if src_signed && (ext64 & OPT_SIGN64_U64) != 0u64 {
                OPT_ALL_ONES_U64
            } else {
                0u64
            };
        } else {
            res_lo = ext64 & opt_bit_mask(dst_bits);
            res_hi = 0u64;
        }
    }

    mir_const_reset_vals(mut_view(*out_const), MIR_CONST_INT, dst_ty_v, res_lo);
    if dst_bits == 128u32 {
        mir_const_set_int_hi(mut_view(*out_const), res_hi);
    }
    true
}

pub fn opt_stmt_is_sync_barrier(stmt: view<MirStmt>) -> bool {
    mir_stmt_is_sync_barrier(stmt) || mir_stmt_is_acquire_barrier(stmt) || mir_stmt_is_release_barrier(stmt)
}

pub fn opt_term_is_sync_barrier(term: view<MirTerminator>) -> bool {
    mir_term_is_sync_barrier(term)
}

unsafe fn opt_cf_u8_at(base: *mut u8, idx: usize) -> *mut u8 {
    ((base as usize) + idx) as *mut u8
}

unsafe fn opt_cf_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = mir_mul_usize(idx, size_of<u32>());
    ((base as usize) + off) as *mut u32
}

unsafe fn opt_cf_const_at(base: *mut MirConst, idx: usize) -> *mut MirConst {
    let off = mir_mul_usize(idx, size_of<MirConst>());
    ((base as usize) + off) as *mut MirConst
}

fn opt_dummy_operand() -> MirOperand {
    MirOperand {
        kind: MIR_OP_COPY,
        location: Span {
            file: compiler.kernel.id.FileId { v: 0u32 },
            start: 0u32,
            end: 0u32,
        },
        place: mir_local_place(0u32),
        constant: MirConst {
            ty: TypeId { v: 0u32 },
            kind: MIR_CONST_INT,
            val: 0u64,
            str_bytes: 0 as *const u8,
            str_len: 0,
            sym: compiler.kernel.id.SymbolId { v: 0u32 },
        },
    }
}

unsafe fn opt_compute_single_def_locals(
    body: view<MirBody>,
    def_cnt: *mut u32,
    bad_loc: *mut u8
) {
    let max_locals = body.local_count;
    let has_locals = (body.locals as usize) != 0;
    let mut l: usize = 0;
    while l < max_locals {
        *opt_cf_u32_at(def_cnt, l) = 0u32;
        let mut is_bad: u8 = 0u8;
        if l == 0 || l <= body.arg_count || !has_locals {
            is_bad = 1u8;
        } else {
            let lk = (*mir_local_at(body.locals, l)).kind;
            if lk == MIR_LOCAL_RETURN || lk == MIR_LOCAL_ARG || lk == MIR_LOCAL_CONST || lk == MIR_LOCAL_TLS || lk == MIR_LOCAL_STATIC {
                is_bad = 1u8;
            }
        }
        *opt_cf_u8_at(bad_loc, l) = is_bad;
        l = l + 1;
    }

    let mut i: usize = 0;
    while i < body.bb_count {
        let bb = mir_bb_at(body.bbs, i);
        let stmt_count = (*bb).stmt_count;
        let stmts = (*bb).stmts;
        let mut j: usize = 0;
        while j < stmt_count {
            let stmt = mir_stmt_at(stmts, j);
            let sk = (*stmt).kind;
            if sk == MIR_STMT_ASSIGN {
                let dl = (*stmt).place.local.v as usize;
                if dl < max_locals {
                    if (*stmt).place.proj_count > 0 {
                        *opt_cf_u8_at(bad_loc, dl) = 1u8;
                    } else {
                        let cur = *opt_cf_u32_at(def_cnt, dl);
                        *opt_cf_u32_at(def_cnt, dl) = cur + 1u32;
                    }
                }
                if (*stmt).rvalue.kind == MIR_RVALUE_REF {
                    let rl = (*stmt).rvalue.place.local.v as usize;
                    if rl < max_locals {
                        *opt_cf_u8_at(bad_loc, rl) = 1u8;
                    }
                }
            } else if sk == MIR_STMT_ATOMIC || sk == MIR_STMT_DROP {
                let sl = (*stmt).place.local.v as usize;
                if sl < max_locals {
                    *opt_cf_u8_at(bad_loc, sl) = 1u8;
                }
            }
            j = j + 1;
        }
        if (*bb).has_terminator {
            let tk = (*bb).terminator.kind;
            if tk == MIR_TERM_CALL {
                if (*bb).terminator.has_destination {
                    let cl = (*bb).terminator.destination.local.v as usize;
                    if cl < max_locals {
                        *opt_cf_u8_at(bad_loc, cl) = 1u8;
                    }
                }
            } else if tk == MIR_TERM_SUSPEND {
                let sl = (*bb).terminator.destination.local.v as usize;
                if sl < max_locals {
                    *opt_cf_u8_at(bad_loc, sl) = 1u8;
                }
                let fl = (*bb).terminator.drop_place.local.v as usize;
                if fl < max_locals {
                    *opt_cf_u8_at(bad_loc, fl) = 1u8;
                }
            } else if tk == MIR_TERM_DROP {
                let drl = (*bb).terminator.drop_place.local.v as usize;
                if drl < max_locals {
                    *opt_cf_u8_at(bad_loc, drl) = 1u8;
                }
            }
        }
        i = i + 1;
    }
}

fn opt_cf_is_valid_unwind(unwind_v: u32, bb_count: usize) -> bool {
    unwind_v != 0u32 && unwind_v != MIR_BB_NONE && (unwind_v as usize) < bb_count
}

unsafe fn opt_cf_mark_reach(reach: *mut u8, target_v: u32, bb_count: usize, skip_bb: usize) -> bool {
    let idx = target_v as usize;
    if idx < bb_count && idx != skip_bb {
        let slot = opt_cf_u8_at(reach, idx);
        if *slot == 0u8 {
            *slot = 1u8;
            return true;
        }
    }
    false
}

unsafe fn opt_cf_compute_reach_skipping(body: view<MirBody>, reach: *mut u8, skip_bb: usize) {
    let bb_count = body.bb_count;
    if bb_count == 0 || (body.bbs as usize) == 0 || (reach as usize) == 0 {
        return;
    }
    let mut i: usize = 0;
    while i < bb_count {
        *opt_cf_u8_at(reach, i) = 0u8;
        i = i + 1;
    }
    if skip_bb == 0 {
        return;
    }
    *opt_cf_u8_at(reach, 0) = 1u8;

    let mut changed: bool = true;
    while changed {
        changed = false;
        i = 0;
        while i < bb_count {
            if i != skip_bb && (*opt_cf_u8_at(reach, i)) != 0u8 {
                let bb = mir_bb_at(body.bbs, i);
                if (*bb).has_terminator {
                    let tk = (*bb).terminator.kind;
                    if tk == MIR_TERM_GOTO {
                        if opt_cf_mark_reach(reach, (*bb).terminator.goto_target.v, bb_count, skip_bb) {
                            changed = true;
                        }
                    } else if tk == MIR_TERM_SWITCH_INT {
                        let sc = (*bb).terminator.switch_count;
                        let targets = (*bb).terminator.targets;
                        if sc > 0 && (targets as usize) != 0 {
                            let mut j: usize = 0;
                            while j < sc {
                                let tgt_v = (*mir_bb_id_at(targets, j)).v;
                                if opt_cf_mark_reach(reach, tgt_v, bb_count, skip_bb) {
                                    changed = true;
                                }
                                j = j + 1;
                            }
                        }
                        if opt_cf_mark_reach(reach, (*bb).terminator.otherwise.v, bb_count, skip_bb) {
                            changed = true;
                        }
                    } else if tk == MIR_TERM_DROP {
                        if opt_cf_mark_reach(reach, (*bb).terminator.drop_target.v, bb_count, skip_bb) {
                            changed = true;
                        }
                        let du_v = (*bb).terminator.drop_unwind.v;
                        if opt_cf_is_valid_unwind(du_v, bb_count) {
                            if opt_cf_mark_reach(reach, du_v, bb_count, skip_bb) {
                                changed = true;
                            }
                        }
                    } else if tk == MIR_TERM_CALL || tk == MIR_TERM_SUSPEND {
                        if opt_cf_mark_reach(reach, (*bb).terminator.call_target.v, bb_count, skip_bb) {
                            changed = true;
                        }
                        let cu_v = (*bb).terminator.call_unwind.v;
                        if opt_cf_is_valid_unwind(cu_v, bb_count) {
                            if opt_cf_mark_reach(reach, cu_v, bb_count, skip_bb) {
                                changed = true;
                            }
                        }
                    } else if tk == MIR_TERM_ASSERT {
                        if opt_cf_mark_reach(reach, (*bb).terminator.assert_target.v, bb_count, skip_bb) {
                            changed = true;
                        }
                        let au_v = (*bb).terminator.assert_unwind.v;
                        if opt_cf_is_valid_unwind(au_v, bb_count) {
                            if opt_cf_mark_reach(reach, au_v, bb_count, skip_bb) {
                                changed = true;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
}

unsafe fn opt_known_dominates_stmt(
    body: view<MirBody>,
    src_lv: usize,
    cur_bb: usize,
    cur_stmt: usize,
    def_bb: *mut u32,
    def_stmt: *mut u32,
    base_reach: *mut u8,
    base_reach_ready: mut_view<bool>,
    reach_scratch: *mut u8
) -> bool {
    let dbb = (*opt_cf_u32_at(def_bb, src_lv)) as usize;
    let dstmt = (*opt_cf_u32_at(def_stmt, src_lv)) as usize;
    if dbb == cur_bb {
        return dstmt < cur_stmt;
    }
    if cur_bb == 0 || dbb >= body.bb_count || cur_bb >= body.bb_count {
        return false;
    }
    if !*base_reach_ready {
        opt_cf_compute_reach_skipping(body, base_reach, MIR_BB_NONE as usize);
        *base_reach_ready = true;
    }
    if (*opt_cf_u8_at(base_reach, cur_bb)) == 0u8 {
        return false;
    }
    if dbb == 0 {
        return true;
    }
    opt_cf_compute_reach_skipping(body, reach_scratch, dbb);
    (*opt_cf_u8_at(reach_scratch, cur_bb)) == 0u8
}

unsafe fn opt_record_known_const(
    body: view<MirBody>,
    dst_lv: usize,
    cur_bb: usize,
    cur_stmt: usize,
    c: view<MirConst>,
    mark_from_intr: bool,
    known_state: *mut u8,
    known_const: *mut MirConst,
    from_intr: *mut u8,
    def_bb: *mut u32,
    def_stmt: *mut u32
) -> bool {
    let mut state_changed: bool = false;
    let st_slot = opt_cf_u8_at(known_state, dst_lv);
    let c_slot = opt_cf_const_at(known_const, dst_lv);
    mir_copy_const(mut_view(*c_slot), c);
    if (*c_slot).ty.v == 0u32 && (body.locals as usize) != 0 && dst_lv < body.local_count {
        (*c_slot).ty.v = (*mir_local_at(body.locals, dst_lv)).ty.v;
    }
    *opt_cf_u32_at(def_bb, dst_lv) = cur_bb as u32;
    *opt_cf_u32_at(def_stmt, dst_lv) = cur_stmt as u32;
    if *st_slot == 0u8 {
        *st_slot = 1u8;
        state_changed = true;
    }
    if mark_from_intr && (body.locals as usize) != 0 && dst_lv < body.local_count {
        let lk = (*mir_local_at(body.locals, dst_lv)).kind;
        if lk == MIR_LOCAL_TEMP {
            let fi_slot = opt_cf_u8_at(from_intr, dst_lv);
            if *fi_slot == 0u8 {
                *fi_slot = 1u8;
                state_changed = true;
            }
        }
    }
    state_changed
}

unsafe fn opt_resolve_operand(
    body: view<MirBody>,
    op: view<MirOperand>,
    cur_bb: usize,
    cur_stmt: usize,
    allow_any_known: bool,
    max_locals: usize,
    known_state: *mut u8,
    known_const: *mut MirConst,
    from_intr: *mut u8,
    def_bb: *mut u32,
    def_stmt: *mut u32,
    base_reach: *mut u8,
    base_reach_ready: mut_view<bool>,
    reach_scratch: *mut u8,
    out_op: mut_view<MirOperand>,
    out_used_from_intr: mut_view<bool>
) {
    *out_used_from_intr = false;
    mir_copy_operand(mut_view(*out_op), op);
    if (op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE) && op.place.proj_count == 0 && max_locals > 0 {
        let lv = op.place.local.v as usize;
        if lv < max_locals && (*opt_cf_u8_at(known_state, lv)) == 1u8 {
            let is_fi = (*opt_cf_u8_at(from_intr, lv)) == 1u8;
            if allow_any_known || is_fi {
                if opt_known_dominates_stmt(
                    body,
                    lv,
                    cur_bb,
                    cur_stmt,
                    def_bb,
                    def_stmt,
                    base_reach,
                    mut_view(*base_reach_ready),
                    reach_scratch
                ) {
                    let kc_ptr = opt_cf_const_at(known_const, lv);
                    out_op.kind = MIR_OP_CONST;
                    mir_copy_const(mut_view(out_op.constant), view(*kc_ptr));
                    if is_fi {
                        *out_used_from_intr = true;
                    }
                }
            }
        }
    }
}

pub fn opt_const_fold_in_arena(
    body: mut_view<MirBody>,
    thir: *const Thir,
    arena: mut_view<Arena>
) -> bool {
    if body.bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }
    let max_locals = body.local_count;
    let mut def_cnt: *mut u32 = 0 as *mut u32;
    let mut bad_loc: *mut u8 = 0 as *mut u8;
    let mut known_state: *mut u8 = 0 as *mut u8;
    let mut known_const: *mut MirConst = 0 as *mut MirConst;
    let mut from_intr: *mut u8 = 0 as *mut u8;
    let mut def_bb: *mut u32 = 0 as *mut u32;
    let mut def_stmt: *mut u32 = 0 as *mut u32;
    let mut base_reach: *mut u8 = 0 as *mut u8;
    let mut reach_scratch: *mut u8 = 0 as *mut u8;
    let mut base_reach_ready: bool = false;
    if max_locals > 0 {
        def_cnt = arena_alloc_raw(mut_view(*arena), mir_mul_usize(max_locals, size_of<u32>()), 4) as *mut u32;
        bad_loc = arena_alloc_raw(mut_view(*arena), max_locals, 1);
        known_state = arena_alloc_raw(mut_view(*arena), max_locals, 1);
        known_const = arena_alloc_raw(mut_view(*arena), mir_mul_usize(max_locals, size_of<MirConst>()), align_of<MirConst>()) as *mut MirConst;
        from_intr = arena_alloc_raw(mut_view(*arena), max_locals, 1);
        def_bb = arena_alloc_raw(mut_view(*arena), mir_mul_usize(max_locals, size_of<u32>()), 4) as *mut u32;
        def_stmt = arena_alloc_raw(mut_view(*arena), mir_mul_usize(max_locals, size_of<u32>()), 4) as *mut u32;
        base_reach = arena_alloc_raw(mut_view(*arena), body.bb_count, 1);
        reach_scratch = arena_alloc_raw(mut_view(*arena), body.bb_count, 1);
        let mut z: usize = 0;
        while z < max_locals {
            unsafe {
                *opt_cf_u8_at(known_state, z) = 0u8;
                *opt_cf_u8_at(from_intr, z) = 0u8;
                *opt_cf_u32_at(def_bb, z) = 0u32;
                *opt_cf_u32_at(def_stmt, z) = 0u32;
            }
            z = z + 1;
        }
        unsafe {
            opt_compute_single_def_locals(view(*body), def_cnt, bad_loc);
        }
    }

    let bool_ty = opt_bool_type_id(thir);
    let mut total_changed: bool = false;
    let mut pass_changed: bool = true;
    let mut folded = MirConst {
        ty: TypeId { v: 0u32 },
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: compiler.kernel.id.SymbolId { v: 0u32 },
    };
    let mut loc = Span {
        file: compiler.kernel.id.FileId { v: 0u32 },
        start: 0u32,
        end: 0u32,
    };
    let mut eff_lhs = opt_dummy_operand();
    let mut eff_rhs = opt_dummy_operand();

    while pass_changed {
        pass_changed = false;
        let mut i: usize = 0;
        while i < body.bb_count {
            let bb = unsafe { mir_bb_at(body.bbs, i) };
            let stmt_count = unsafe { (*bb).stmt_count };
            let stmts = unsafe { (*bb).stmts };
            let mut j: usize = 0;
            while j < stmt_count {
                let stmt = unsafe { mir_stmt_at(stmts, j) };
                let is_sync = unsafe { opt_stmt_is_sync_barrier(view(*stmt)) };
                let sk = unsafe { (*stmt).kind };
                if !is_sync && sk == MIR_STMT_ASSIGN {
                    let rv_kind = unsafe { (*stmt).rvalue.kind };
                    let rv_vidx = unsafe { (*stmt).rvalue.variant_idx };
                    let is_intr_rv = rv_kind != MIR_RVALUE_AGGREGATE && rv_vidx == MIR_RVALUE_FLAG_INTRINSIC;
                    let dst_unproj = unsafe { (*stmt).place.proj_count == 0 };
                    let dst_lv = unsafe { (*stmt).place.local.v as usize };
                    let dst_can_record = dst_unproj && dst_lv > 0 && dst_lv < max_locals &&
                        (unsafe { *opt_cf_u8_at(bad_loc, dst_lv) }) == 0u8 &&
                        (unsafe { *opt_cf_u32_at(def_cnt, dst_lv) }) == 1u32;

                    if rv_kind == MIR_RVALUE_USE {
                        let uok = unsafe { opt_is_scalar_const_op(view((*stmt).rvalue.use_op)) };
                        if uok {
                            if is_intr_rv {
                                let c_kind = unsafe { (*stmt).rvalue.use_op.constant.kind };
                                let c_ty_v = unsafe { (*stmt).rvalue.use_op.constant.ty.v };
                                let c_bits = opt_type_bits(thir, TypeId { v: c_ty_v });
                                if c_kind == MIR_CONST_INT && c_bits > 0u32 && c_bits < 64u32 {
                                    let cur_val = unsafe { (*stmt).rvalue.use_op.constant.val };
                                    let masked = cur_val & opt_bit_mask(c_bits);
                                    if cur_val != masked {
                                        unsafe { (*stmt).rvalue.use_op.constant.val = masked };
                                        pass_changed = true;
                                        total_changed = true;
                                    }
                                }
                                unsafe { (*stmt).rvalue.variant_idx = 0u32 };
                            }
                            if dst_can_record {
                                let sc = unsafe {
                                    opt_record_known_const(
                                        view(*body),
                                        dst_lv,
                                        i,
                                        j,
                                        view((*stmt).rvalue.use_op.constant),
                                        is_intr_rv,
                                        known_state,
                                        known_const,
                                        from_intr,
                                        def_bb,
                                        def_stmt
                                    )
                                };
                                if sc {
                                    pass_changed = true;
                                }
                            }
                        } else {
                            let opk = unsafe { (*stmt).rvalue.use_op.kind };
                            let op_projs = unsafe { (*stmt).rvalue.use_op.place.proj_count };
                            if (opk == MIR_OP_COPY || opk == MIR_OP_MOVE) && op_projs == 0 && max_locals > 0 {
                                let src_lv = unsafe { (*stmt).rvalue.use_op.place.local.v as usize };
                                if src_lv < max_locals && (unsafe { *opt_cf_u8_at(known_state, src_lv) }) == 1u8 {
                                    let src_fi = (unsafe { *opt_cf_u8_at(from_intr, src_lv) }) == 1u8;
                                    let src_c_ptr = unsafe { opt_cf_const_at(known_const, src_lv) };
                                    if is_intr_rv || src_fi {
                                        let dom_ok = unsafe {
                                            opt_known_dominates_stmt(
                                                view(*body),
                                                src_lv,
                                                i,
                                                j,
                                                def_bb,
                                                def_stmt,
                                                base_reach,
                                                mut_view(base_reach_ready),
                                                reach_scratch
                                            )
                                        };
                                        if dom_ok {
                                            mir_const_reset_vals(mut_view(folded), MIR_CONST_INT, 0u32, 0u64);
                                            unsafe { mir_copy_const(mut_view(folded), view(*src_c_ptr)) };
                                            if dst_unproj && (body.locals as usize) != 0 && dst_lv < max_locals {
                                                let d_ty_v = unsafe { (*mir_local_at(body.locals, dst_lv)).ty.v };
                                                if d_ty_v != 0u32 && folded.ty.v == 0u32 {
                                                    folded.ty.v = d_ty_v;
                                                }
                                            }
                                            let f_bits = opt_type_bits(thir, TypeId { v: folded.ty.v });
                                            if folded.kind == MIR_CONST_INT && f_bits > 0u32 && f_bits < 64u32 {
                                                folded.val = folded.val & opt_bit_mask(f_bits);
                                            }
                                            unsafe {
                                                mir_span_copy(mut_view(loc), view((*stmt).rvalue.use_op.location));
                                                mir_rvalue_reset(mut_view((*stmt).rvalue), MIR_RVALUE_USE);
                                                (*stmt).rvalue.use_op.kind = MIR_OP_CONST;
                                                mir_span_copy(mut_view((*stmt).rvalue.use_op.location), view(loc));
                                                mir_copy_const(mut_view((*stmt).rvalue.use_op.constant), view(folded));
                                            }
                                            if dst_can_record {
                                                let _ = unsafe {
                                                    opt_record_known_const(
                                                        view(*body),
                                                        dst_lv,
                                                        i,
                                                        j,
                                                        view(folded),
                                                        true,
                                                        known_state,
                                                        known_const,
                                                        from_intr,
                                                        def_bb,
                                                        def_stmt
                                                    )
                                                };
                                            }
                                            pass_changed = true;
                                            total_changed = true;
                                        }
                                    } else if dst_can_record {
                                        let dom_ok = unsafe {
                                            opt_known_dominates_stmt(
                                                view(*body),
                                                src_lv,
                                                i,
                                                j,
                                                def_bb,
                                                def_stmt,
                                                base_reach,
                                                mut_view(base_reach_ready),
                                                reach_scratch
                                            )
                                        };
                                        if dom_ok {
                                            let sc = unsafe {
                                                opt_record_known_const(
                                                    view(*body),
                                                    dst_lv,
                                                    i,
                                                    j,
                                                    view(*src_c_ptr),
                                                    false,
                                                    known_state,
                                                    known_const,
                                                    from_intr,
                                                    def_bb,
                                                    def_stmt
                                                )
                                            };
                                            if sc {
                                                pass_changed = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else if rv_kind == MIR_RVALUE_CAST {
                        let orig_ck = unsafe { (*stmt).rvalue.cast_kind };
                        let orig_tty = TypeId { v: unsafe { (*stmt).rvalue.target_ty.v } };
                        let mut used_fi: bool = false;
                        unsafe {
                            opt_resolve_operand(
                                view(*body),
                                view((*stmt).rvalue.use_op),
                                i,
                                j,
                                is_intr_rv,
                                max_locals,
                                known_state,
                                known_const,
                                from_intr,
                                def_bb,
                                def_stmt,
                                base_reach,
                                mut_view(base_reach_ready),
                                reach_scratch,
                                mut_view(eff_lhs),
                                mut_view(used_fi)
                            );
                        }
                        mir_const_reset_vals(mut_view(folded), MIR_CONST_INT, 0u32, 0u64);
                        let ok = do_const_fold_cast(thir, orig_ck, view(eff_lhs), orig_tty, mut_view(folded));
                        if ok {
                            unsafe {
                                mir_span_copy(mut_view(loc), view((*stmt).rvalue.use_op.location));
                                mir_rvalue_reset(mut_view((*stmt).rvalue), MIR_RVALUE_USE);
                                (*stmt).rvalue.use_op.kind = MIR_OP_CONST;
                                mir_span_copy(mut_view((*stmt).rvalue.use_op.location), view(loc));
                                mir_copy_const(mut_view((*stmt).rvalue.use_op.constant), view(folded));
                            }
                            if dst_can_record {
                                let _ = unsafe {
                                    opt_record_known_const(
                                        view(*body),
                                        dst_lv,
                                        i,
                                        j,
                                        view(folded),
                                        is_intr_rv || used_fi,
                                        known_state,
                                        known_const,
                                        from_intr,
                                        def_bb,
                                        def_stmt
                                    )
                                };
                            }
                            pass_changed = true;
                            total_changed = true;
                        }
                    } else if rv_kind == MIR_RVALUE_BINARY_OP {
                        let orig_op = unsafe { (*stmt).rvalue.bin_op };
                        let mut lhs_fi: bool = false;
                        let mut rhs_fi: bool = false;
                        unsafe {
                            opt_resolve_operand(
                                view(*body),
                                view((*stmt).rvalue.lhs),
                                i,
                                j,
                                is_intr_rv,
                                max_locals,
                                known_state,
                                known_const,
                                from_intr,
                                def_bb,
                                def_stmt,
                                base_reach,
                                mut_view(base_reach_ready),
                                reach_scratch,
                                mut_view(eff_lhs),
                                mut_view(lhs_fi)
                            );
                            opt_resolve_operand(
                                view(*body),
                                view((*stmt).rvalue.rhs),
                                i,
                                j,
                                is_intr_rv,
                                max_locals,
                                known_state,
                                known_const,
                                from_intr,
                                def_bb,
                                def_stmt,
                                base_reach,
                                mut_view(base_reach_ready),
                                reach_scratch,
                                mut_view(eff_rhs),
                                mut_view(rhs_fi)
                            );
                        }
                        mir_const_reset_vals(mut_view(folded), MIR_CONST_INT, 0u32, 0u64);
                        let ok = do_const_fold_binop(
                            thir,
                            orig_op,
                            view(eff_lhs),
                            view(eff_rhs),
                            mut_view(folded)
                        );
                        if ok {
                            unsafe {
                                mir_span_copy(mut_view(loc), view((*stmt).rvalue.lhs.location));
                                mir_rvalue_reset(mut_view((*stmt).rvalue), MIR_RVALUE_USE);
                                (*stmt).rvalue.use_op.kind = MIR_OP_CONST;
                                mir_span_copy(mut_view((*stmt).rvalue.use_op.location), view(loc));
                                mir_copy_const(mut_view((*stmt).rvalue.use_op.constant), view(folded));
                            }
                            if dst_can_record {
                                let _ = unsafe {
                                    opt_record_known_const(
                                        view(*body),
                                        dst_lv,
                                        i,
                                        j,
                                        view(folded),
                                        is_intr_rv || lhs_fi || rhs_fi,
                                        known_state,
                                        known_const,
                                        from_intr,
                                        def_bb,
                                        def_stmt
                                    )
                                };
                            }
                            pass_changed = true;
                            total_changed = true;
                        }
                    } else if rv_kind == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                        let orig_op = unsafe { (*stmt).rvalue.bin_op };
                        let mut lhs_fi: bool = false;
                        let mut rhs_fi: bool = false;
                        unsafe {
                            opt_resolve_operand(
                                view(*body),
                                view((*stmt).rvalue.lhs),
                                i,
                                j,
                                is_intr_rv,
                                max_locals,
                                known_state,
                                known_const,
                                from_intr,
                                def_bb,
                                def_stmt,
                                base_reach,
                                mut_view(base_reach_ready),
                                reach_scratch,
                                mut_view(eff_lhs),
                                mut_view(lhs_fi)
                            );
                            opt_resolve_operand(
                                view(*body),
                                view((*stmt).rvalue.rhs),
                                i,
                                j,
                                is_intr_rv,
                                max_locals,
                                known_state,
                                known_const,
                                from_intr,
                                def_bb,
                                def_stmt,
                                base_reach,
                                mut_view(base_reach_ready),
                                reach_scratch,
                                mut_view(eff_rhs),
                                mut_view(rhs_fi)
                            );
                        }
                        mir_const_reset_vals(mut_view(folded), MIR_CONST_INT, 0u32, 0u64);
                        let ok = do_const_fold_binop(
                            thir,
                            orig_op,
                            view(eff_lhs),
                            view(eff_rhs),
                            mut_view(folded)
                        );
                        if ok {
                            let mut dst_ty_v = bool_ty.v;
                            if (body.locals as usize) != 0 && dst_lv < body.local_count {
                                let l_ty = unsafe { (*mir_local_at(body.locals, dst_lv)).ty.v };
                                if l_ty != 0u32 {
                                    dst_ty_v = l_ty;
                                }
                            }
                            unsafe {
                                mir_span_copy(mut_view(loc), view((*stmt).rvalue.lhs.location));
                                mir_rvalue_reset(mut_view((*stmt).rvalue), MIR_RVALUE_USE);
                                (*stmt).rvalue.use_op.kind = MIR_OP_CONST;
                                mir_span_copy(mut_view((*stmt).rvalue.use_op.location), view(loc));
                                mir_const_reset_vals(
                                    mut_view((*stmt).rvalue.use_op.constant),
                                    MIR_CONST_INT,
                                    dst_ty_v,
                                    0u64
                                );
                            }
                            if dst_can_record {
                                let _ = unsafe {
                                    opt_record_known_const(
                                        view(*body),
                                        dst_lv,
                                        i,
                                        j,
                                        view((*stmt).rvalue.use_op.constant),
                                        is_intr_rv || lhs_fi || rhs_fi,
                                        known_state,
                                        known_const,
                                        from_intr,
                                        def_bb,
                                        def_stmt
                                    )
                                };
                            }
                            pass_changed = true;
                            total_changed = true;
                        }
                    } else if rv_kind == MIR_RVALUE_UNARY_OP {
                        let orig_unop = unsafe { (*stmt).rvalue.un_op };
                        let mut used_fi: bool = false;
                        unsafe {
                            opt_resolve_operand(
                                view(*body),
                                view((*stmt).rvalue.use_op),
                                i,
                                j,
                                is_intr_rv,
                                max_locals,
                                known_state,
                                known_const,
                                from_intr,
                                def_bb,
                                def_stmt,
                                base_reach,
                                mut_view(base_reach_ready),
                                reach_scratch,
                                mut_view(eff_lhs),
                                mut_view(used_fi)
                            );
                        }
                        mir_const_reset_vals(mut_view(folded), MIR_CONST_INT, 0u32, 0u64);
                        let ok = do_const_fold_unop(
                            thir,
                            orig_unop,
                            view(eff_lhs),
                            mut_view(folded)
                        );
                        if ok {
                            unsafe {
                                mir_span_copy(mut_view(loc), view((*stmt).rvalue.use_op.location));
                                mir_rvalue_reset(mut_view((*stmt).rvalue), MIR_RVALUE_USE);
                                (*stmt).rvalue.use_op.kind = MIR_OP_CONST;
                                mir_span_copy(mut_view((*stmt).rvalue.use_op.location), view(loc));
                                mir_copy_const(mut_view((*stmt).rvalue.use_op.constant), view(folded));
                            }
                            if dst_can_record {
                                let _ = unsafe {
                                    opt_record_known_const(
                                        view(*body),
                                        dst_lv,
                                        i,
                                        j,
                                        view(folded),
                                        is_intr_rv || used_fi,
                                        known_state,
                                        known_const,
                                        from_intr,
                                        def_bb,
                                        def_stmt
                                    )
                                };
                            }
                            pass_changed = true;
                            total_changed = true;
                        }
                    }
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    total_changed
}

pub fn opt_const_fold(body: mut_view<MirBody>, thir: *const Thir) -> bool {
    if body.bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }
    let mut scratch = arena_new();
    let changed = opt_const_fold_in_arena(body, thir, mut_view(scratch));
    arena_destroy(mut_view(scratch));
    changed
}

pub fn ax_opt_const_fold(body: mut_view<MirBody>, thir: *const Thir) -> bool {
    if (thir as usize) == 0 {
        return false;
    }
    opt_const_fold(body, thir)
}
