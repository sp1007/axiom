    0u8, 0u8, 0u8, 0u8, 0u8,
];

fn pgo_push_tbl(out: mut_view<DiagBuffer>, off: usize, byte_len: usize) {
    let mut i: usize = 0;
    while i < byte_len {
        diag_buf_push_byte(mut_view(*out), PGO_PRINT_DATA[off + i]);
        i = i + 1;
    }
}

pub fn pgo_print(
    prof: view<PgoProfileData>,
    stats: view<PgoStats>,
    out: mut_view<DiagBuffer>
) {
    pgo_push_tbl(mut_view(*out), 0, 14);
    pgo_push_tbl(mut_view(*out), 14, 7);
    diag_buf_push_u32(mut_view(*out), prof.provenance_kind as u32);
    pgo_push_tbl(mut_view(*out), 21, 6);
    diag_buf_push_u32(mut_view(*out), prof.total_runs_merged);
    pgo_push_tbl(mut_view(*out), 27, 5);
    diag_buf_push_u32(mut_view(*out), prof.fn_count as u32);
    diag_buf_push_byte(mut_view(*out), 10u8);

    let mut i: usize = 0;
    while i < prof.fn_count && (prof.fns as usize) != 0 {
        let fp = unsafe { pgo_fn_at(prof.fns, i) };
        pgo_push_tbl(mut_view(*out), 32, 8);
        diag_buf_push_u32(mut_view(*out), unsafe { (*fp).fn_sym.v });
        pgo_push_tbl(mut_view(*out), 40, 7);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).entry_count }) as u32);
        pgo_push_tbl(mut_view(*out), 47, 9);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).hotness_class }) as u32);
        pgo_push_tbl(mut_view(*out), 56, 8);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).compatibility }) as u32);
        pgo_push_tbl(mut_view(*out), 64, 6);
        diag_buf_push_u32(mut_view(*out), unsafe { (*fp).confidence });
        pgo_push_tbl(mut_view(*out), 70, 10);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).branch_count }) as u32);
        pgo_push_tbl(mut_view(*out), 80, 7);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).call_count }) as u32);
        pgo_push_tbl(mut_view(*out), 87, 7);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).loop_count }) as u32);
        pgo_push_tbl(mut_view(*out), 94, 8);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*fp).value_count }) as u32);
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1;
    }

    pgo_push_tbl(mut_view(*out), 102, 16);
    diag_buf_push_u32(mut_view(*out), stats.exact_fn_matches);
    pgo_push_tbl(mut_view(*out), 118, 8);
    diag_buf_push_u32(mut_view(*out), stats.compatible_fn_matches);
    pgo_push_tbl(mut_view(*out), 126, 7);
    diag_buf_push_u32(mut_view(*out), stats.stale_fn_fallbacks);
    pgo_push_tbl(mut_view(*out), 133, 12);
    diag_buf_push_u32(mut_view(*out), stats.hot_inline_boosts);
    pgo_push_tbl(mut_view(*out), 145, 13);
    diag_buf_push_u32(mut_view(*out), stats.cold_inline_suppressions);
    pgo_push_tbl(mut_view(*out), 158, 11);
    diag_buf_push_u32(mut_view(*out), stats.value_guarded_specs);
    pgo_push_tbl(mut_view(*out), 169, 16);
    diag_buf_push_u32(mut_view(*out), stats.guarded_devirt_sites);
    pgo_push_tbl(mut_view(*out), 185, 14);
    diag_buf_push_u32(mut_view(*out), stats.loop_unroll_boosts);
    pgo_push_tbl(mut_view(*out), 199, 12);
    diag_buf_push_u32(mut_view(*out), stats.hot_cold_blocks_split);
    pgo_push_tbl(mut_view(*out), 211, 16);
    diag_buf_push_u32(mut_view(*out), stats.forbidden_proof_upgrades_blocked);
    pgo_push_tbl(mut_view(*out), 227, 11);
    diag_buf_push_u32(mut_view(*out), stats.pass_rollbacks);
    diag_buf_push_byte(mut_view(*out), 10u8);
    pgo_push_tbl(mut_view(*out), 238, 2);
}
