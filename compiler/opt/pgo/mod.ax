    //   0..14  "pgo_profile {\n" (14 bytes)
    112u8, 103u8, 111u8, 95u8, 112u8, 114u8, 111u8, 102u8, 105u8, 108u8, 101u8, 32u8, 123u8, 10u8,
    //  14..24  "  prov=" (7 bytes)
    32u8, 32u8, 112u8, 114u8, 111u8, 118u8, 61u8,
    //  21..27  " runs=" (6 bytes)
    32u8, 114u8, 117u8, 110u8, 115u8, 61u8,
    //  27..33  " fns=" (5 bytes)
    32u8, 102u8, 110u8, 115u8, 61u8,
    //  32..40  "  fn fn#" (8 bytes)
    32u8, 32u8, 102u8, 110u8, 32u8, 102u8, 110u8, 35u8,
    //  40..47  " entry=" (7 bytes)
    32u8, 101u8, 110u8, 116u8, 114u8, 121u8, 61u8,
    //  47..56  " hotness=" (9 bytes)
    32u8, 104u8, 111u8, 116u8, 110u8, 101u8, 115u8, 115u8, 61u8,
    //  56..64  " compat=" (8 bytes)
    32u8, 99u8, 111u8, 109u8, 112u8, 97u8, 116u8, 61u8,
    //  64..70  " conf=" (6 bytes)
    32u8, 99u8, 111u8, 110u8, 102u8, 61u8,
    //  70..80  " branches=" (10 bytes)
    32u8, 98u8, 114u8, 97u8, 110u8, 99u8, 104u8, 101u8, 115u8, 61u8,
    //  80..87  " calls=" (7 bytes)
    32u8, 99u8, 97u8, 108u8, 108u8, 115u8, 61u8,
    //  87..94  " loops=" (7 bytes)
    32u8, 108u8, 111u8, 111u8, 112u8, 115u8, 61u8,
    //  94..102 " values=" (8 bytes)
    32u8, 118u8, 97u8, 108u8, 117u8, 101u8, 115u8, 61u8,
    // 102..118 "  summary exact=" (16 bytes)
    32u8, 32u8, 115u8, 117u8, 109u8, 109u8, 97u8, 114u8, 121u8, 32u8, 101u8, 120u8, 97u8, 99u8, 116u8, 61u8,
    // 118..126 " compat=" (8 bytes)
    32u8, 99u8, 111u8, 109u8, 112u8, 97u8, 116u8, 61u8,
    // 126..133 " stale=" (7 bytes)
    32u8, 115u8, 116u8, 97u8, 108u8, 101u8, 61u8,
    // 133..146 " inline_hot=" (12 bytes)
    32u8, 105u8, 110u8, 108u8, 105u8, 110u8, 101u8, 95u8, 104u8, 111u8, 116u8, 61u8,
    // 145..158 " inline_cold=" (13 bytes)
    32u8, 105u8, 110u8, 108u8, 105u8, 110u8, 101u8, 95u8, 99u8, 111u8, 108u8, 100u8, 61u8,
    // 158..169 " val_specs=" (11 bytes)
    32u8, 118u8, 97u8, 108u8, 95u8, 115u8, 112u8, 101u8, 99u8, 115u8, 61u8,
    // 169..184 " guarded_devirt=" (16 bytes)
    32u8, 103u8, 117u8, 97u8, 114u8, 100u8, 101u8, 100u8, 95u8, 100u8, 101u8, 118u8, 105u8, 114u8, 116u8, 61u8,
    // 185..198 " unroll_boost=" (14 bytes)
    32u8, 117u8, 110u8, 114u8, 111u8, 108u8, 108u8, 95u8, 98u8, 111u8, 111u8, 115u8, 116u8, 61u8,
    // 199..211 " split_cold=" (12 bytes)
    32u8, 115u8, 112u8, 108u8, 105u8, 116u8, 95u8, 99u8, 111u8, 108u8, 100u8, 61u8,
    // 211..227 " blocked_proofs=" (16 bytes)
    32u8, 98u8, 108u8, 111u8, 99u8, 107u8, 101u8, 100u8, 95u8, 112u8, 114u8, 111u8, 111u8, 102u8, 115u8, 61u8,
    // 227..238 " rollbacks=" (11 bytes)
    32u8, 114u8, 111u8, 108u8, 108u8, 98u8, 97u8, 99u8, 107u8, 115u8, 61u8,
    // 238..288 "}\n" + padding
    125u8, 10u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
