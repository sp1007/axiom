// =============================================================================
// 1. Pass Contract (`PASS_PGO = 19u16`), Epistemic Tiers, and Schema Constants
// =============================================================================

pub const PASS_PGO: u16 = 19u16;

pub fn pgo_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_PGO,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_LOOP_INFO |
                           ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA,
        required_proofs: PROP_MASK_REACHABLE,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                            ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_LOOP_INFO,
        invalidated_analyses: 0u32,
        preserved_properties: PROP_MASK_REACHABLE | PROP_MASK_NO_ALIAS | PROP_MASK_IN_BOUNDS |
                              PROP_MASK_NON_ZERO | PROP_MASK_NO_OVERFLOW | PROP_MASK_PURE_CALL |
                              PROP_MASK_NO_ESCAPE,
        postconditions: POSTCOND_ALL,
    }
}

