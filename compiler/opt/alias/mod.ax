const ALIAS_STR_OFF: [57]u32 = [
    0u32, 13u32, 15u32, 20u32, 29u32, 37u32, 43u32, 50u32, 55u32, 56u32,
    67u32, 70u32, 74u32, 79u32, 85u32, 93u32, 101u32, 103u32, 105u32, 116u32,
    124u32, 137u32, 148u32, 155u32, 162u32, 172u32, 182u32, 193u32, 198u32, 207u32,
    221u32, 233u32, 240u32, 249u32, 261u32, 269u32, 281u32, 289u32, 293u32, 301u32,
    313u32, 321u32, 327u32, 335u32, 342u32, 356u32, 372u32, 389u32, 403u32, 414u32,
    428u32, 445u32, 460u32, 478u32, 497u32, 510u32, 528u32,
];

fn al_push_tok(out: mut_view<DiagBuffer>, tok: usize) {
    let start = ALIAS_STR_OFF[tok] as usize;
    let end = ALIAS_STR_OFF[tok + 1] as usize;
    let mut i: usize = start;
    while i < end {
        diag_buf_push_byte(mut_view(*out), ALIAS_STR_DATA[i]);
        i = i + 1;
    }
}

pub fn alias_print(out: mut_view<DiagBuffer>, info: view<AliasInfo>) {
    al_push_tok(mut_view(*out), 0); // "alias_info {\n"
    let mut i: usize = 0;
    while i < info.region_count {
        let reg = unsafe { alias_region_at(info.regions, i) };
        al_push_tok(mut_view(*out), 2); // "    R"
        diag_buf_push_u32(mut_view(*out), i as u32);
        al_push_tok(mut_view(*out), 3); // ": domain="
        let dom = (unsafe { (*reg).domain }) as usize;
        let dom_tok: usize = if dom <= 8 { 18 + dom } else { 23 };
        al_push_tok(mut_view(*out), dom_tok);
        al_push_tok(mut_view(*out), 4); // " local=_"
        diag_buf_push_u32(mut_view(*out), unsafe { (*reg).base_local.v });
        al_push_tok(mut_view(*out), 5); // " root="
        diag_buf_push_u32(mut_view(*out), unsafe { (*reg).alloc_root });
        al_push_tok(mut_view(*out), 6); // " projs="
        diag_buf_push_u32(mut_view(*out), (unsafe { (*reg).place.proj_count }) as u32);
        al_push_tok(mut_view(*out), 7); // " cap="
        let cm = unsafe { (*reg).cap_mode };
        let cm_tok: usize = if cm == CAP_MODE_OWNER {
            27
        } else if cm == CAP_MODE_VIEW_READ {
            28
        } else if cm == CAP_MODE_MUT_VIEW_WRITE {
            29
        } else if cm == CAP_MODE_RAW_PTR {
            22
        } else {
            30
        };
        al_push_tok(mut_view(*out), cm_tok);
        al_push_tok(mut_view(*out), 8); // "\n"
        i = i + 1;
    }

    let mut p: usize = 0;
    while p < info.pair_count {
        let pr = unsafe { alias_pair_at(info.pairs, p) };
        let f = unsafe { (*pr).fact };
        al_push_tok(mut_view(*out), 9); // "    fact (R"
        diag_buf_push_u32(mut_view(*out), unsafe { (*pr).lhs_region_id });
        al_push_tok(mut_view(*out), 10); // ", R"
        diag_buf_push_u32(mut_view(*out), unsafe { (*pr).rhs_region_id });
        al_push_tok(mut_view(*out), 11); // ") = "
        let r_tok: usize = if (f.result as usize) <= 4 { 31 + (f.result as usize) } else { 35 };
        al_push_tok(mut_view(*out), r_tok);
        al_push_tok(mut_view(*out), 12); // " rel="
        let rel_tok: usize = if (f.relation as usize) <= 4 { 36 + (f.relation as usize) } else { 23 };
        al_push_tok(mut_view(*out), rel_tok);
        al_push_tok(mut_view(*out), 13); // " cert="
        let c_tok: usize = if (f.certainty as usize) <= 2 { 41 + (f.certainty as usize) } else { 43 };
        al_push_tok(mut_view(*out), c_tok);
        al_push_tok(mut_view(*out), 14); // " reason="
        let rsn_tok: usize = if (f.reason as usize) <= 11 { 44 + (f.reason as usize) } else { 55 };
        al_push_tok(mut_view(*out), rsn_tok);
        al_push_tok(mut_view(*out), 15); // " valid=["
        diag_buf_push_u32(mut_view(*out), f.valid_start);
        al_push_tok(mut_view(*out), 16); // ".."
        diag_buf_push_u32(mut_view(*out), f.valid_end);
        al_push_tok(mut_view(*out), 17); // "]\n"
        p = p + 1;
    }
    al_push_tok(mut_view(*out), 1); // "}\n"
}
