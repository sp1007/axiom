// --- Pass Identifier & Range/BCE Lattice Constants (SPEC-72 §2) ---

pub const PASS_BCE: u16 = 11u16;

pub const BOUND_LT: u8 = 0u8;
pub const BOUND_LE: u8 = 1u8;
pub const BOUND_EQ: u8 = 2u8;
pub const BOUND_GE: u8 = 3u8;
pub const BOUND_GT: u8 = 4u8;

pub const LEN_KIND_NONE: u8 = 0u8;
pub const LEN_KIND_FIXED_ARRAY: u8 = 1u8;
pub const LEN_KIND_SLICE_VIEW: u8 = 2u8;
pub const LEN_KIND_VEC_LEN: u8 = 3u8;

pub const BCE_RETAINED_UNKNOWN: u8 = 0u8;
pub const BCE_RETAINED_POSSIBLE: u8 = 1u8;
pub const BCE_ELIMINATED_PROVEN: u8 = 2u8;

// --- Core RangeInfo & BCE Data Structures (SPEC-72 §2, AXS-BCE-001..006) ---

@derive(Copy)
pub struct ValueRange {
    pub has_range: bool,
    pub is_signed: bool,
    pub lo: u64,
    pub hi: u64,
    pub known_zeros: u64,
    pub known_ones: u64,
    pub non_negative_proven: bool,
    pub certainty: u8,
}

// Canonical difference-bound inequality over non-negative mathematical integers:
//   If `rhs_base != OPT_VALUE_NONE`: `lhs <= rhs_base + rhs_offset` (`rel == BOUND_LE`).
//   If `rhs_base == OPT_VALUE_NONE`: `lhs <= rhs_offset` (`BOUND_LE`) or `lhs >= rhs_offset` (`BOUND_GE`).
// Valid in `valid_at_bb` and every block dominated by `valid_at_bb` (`OPT_BB_NONE` = global).
@derive(Copy)
pub struct SymbolicBound {
    pub lhs: OptValueId,
    pub rhs_base: OptValueId,
    pub rhs_offset: i64,
    pub rel: u8,
    pub certainty: u8,
    pub valid_at_bb: OptBbId,
}

@derive(Copy)
pub struct NonNegFact {
    pub val: OptValueId,
    pub valid_at_bb: OptBbId,
}

@derive(Copy)
pub struct CheckedNonWrapOp {
    pub bin_op: u8,
    pub lhs: OptValueId,
    pub rhs: OptValueId,
    pub valid_at_bb: OptBbId,
}

pub struct LengthFact {
    pub val: OptValueId,
    pub kind: u8,
    pub root_local: u32,
    pub src_local: u32,
    pub const_len: u64,
    pub def_bb: OptBbId,
    pub def_inst_idx: u32,
    pub region_place: MirPlace,
    pub is_readonly_view: bool,
    pub is_sroa_ssa: bool,
}

@derive(Copy)
pub struct SubsliceRangeFact {
    pub slice_local: u32,
    pub root_local: u32,
    pub def_bb: OptBbId,
    pub def_inst_idx: u32,
    pub base_ssa: OptValueId,
    pub is_array_root: bool,
    pub has_start: bool,
    pub start_val: OptValueId,
    pub has_end: bool,
    pub end_val: OptValueId,
}

pub struct InlineVecBound {
    pub idx_val: OptValueId,
    pub rhs_offset: i64,
    pub root_local: u32,
    pub src_local: u32,
    pub cmp_bb: OptBbId,
    pub cmp_inst_idx: u32,
    pub valid_at_bb: OptBbId,
    pub region_place: MirPlace,
}

@derive(Copy)
pub struct BceSiteRecord {
    pub bb: OptBbId,
    pub cond_val: OptValueId,
    pub idx_val: OptValueId,
    pub len_val: OptValueId,
    pub len_kind: u8,
    pub decision: u8,
    pub certainty: u8,
}

pub struct RangeInfo {
    pub value_ranges: *mut ValueRange,
    pub value_cap: usize,
    pub bounds: *mut SymbolicBound,
    pub bound_count: usize,
    pub bound_cap: usize,
    pub nonneg_facts: *mut NonNegFact,
    pub nonneg_count: usize,
    pub nonneg_cap: usize,
    pub checked_ops: *mut CheckedNonWrapOp,
    pub checked_count: usize,
    pub checked_cap: usize,
    pub lengths: *mut LengthFact,
    pub length_count: usize,
    pub length_cap: usize,
    pub subslices: *mut SubsliceRangeFact,
    pub subslice_count: usize,
    pub subslice_cap: usize,
    pub inline_vec_bounds: *mut InlineVecBound,
    pub inline_vec_count: usize,
    pub inline_vec_cap: usize,
}

@derive(Copy)
pub struct BceStats {
    pub pass_runs: u32,
    pub pass_changes: u32,
    pub pass_rollbacks: u32,
    pub sites_inspected: u32,
    pub checks_eliminated: u32,
    pub checks_retained_possible: u32,
    pub checks_retained_unknown: u32,
    pub array_checks_eliminated: u32,
    pub slice_checks_eliminated: u32,
    pub vec_checks_eliminated: u32,
    pub blocks_pruned: u32,
}

// --- Pointer Indexing & Contract Helpers ---

fn bce_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn bce_range_at(base: *mut ValueRange, idx: usize) -> *mut ValueRange {
    let off = bce_mul_usize(idx, size_of<ValueRange>());
    ((base as usize) + off) as *mut ValueRange
}

pub unsafe fn bce_bound_at(base: *mut SymbolicBound, idx: usize) -> *mut SymbolicBound {
    let off = bce_mul_usize(idx, size_of<SymbolicBound>());
    ((base as usize) + off) as *mut SymbolicBound
}

unsafe fn bce_nonneg_at(base: *mut NonNegFact, idx: usize) -> *mut NonNegFact {
    let off = bce_mul_usize(idx, size_of<NonNegFact>());
    ((base as usize) + off) as *mut NonNegFact
}

unsafe fn bce_checked_at(base: *mut CheckedNonWrapOp, idx: usize) -> *mut CheckedNonWrapOp {
    let off = bce_mul_usize(idx, size_of<CheckedNonWrapOp>());
    ((base as usize) + off) as *mut CheckedNonWrapOp
}

pub unsafe fn bce_len_at(base: *mut LengthFact, idx: usize) -> *mut LengthFact {
    let off = bce_mul_usize(idx, size_of<LengthFact>());
    ((base as usize) + off) as *mut LengthFact
}

pub unsafe fn bce_subslice_at(base: *mut SubsliceRangeFact, idx: usize) -> *mut SubsliceRangeFact {
    let off = bce_mul_usize(idx, size_of<SubsliceRangeFact>());
    ((base as usize) + off) as *mut SubsliceRangeFact
}

unsafe fn bce_inline_vec_at(base: *mut InlineVecBound, idx: usize) -> *mut InlineVecBound {
    let off = bce_mul_usize(idx, size_of<InlineVecBound>());
    ((base as usize) + off) as *mut InlineVecBound
}

pub unsafe fn bce_site_at(base: *mut BceSiteRecord, idx: usize) -> *mut BceSiteRecord {
    let off = bce_mul_usize(idx, size_of<BceSiteRecord>());
    ((base as usize) + off) as *mut BceSiteRecord
}

pub fn bce_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_BCE,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                           ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO |
                           ANALYSIS_MASK_LOOP_INFO | ANALYSIS_MASK_RANGE_INFO,
        required_proofs: PROP_MASK_IN_BOUNDS,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS |
                            ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA,
        invalidated_analyses: ANALYSIS_MASK_LOOP_INFO | ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_ALIAS_INFO,
        preserved_properties: PROP_MASK_NONE,
        postconditions: POSTCOND_ALL,
    }
}

pub fn bce_stats_zero(stats: mut_view<BceStats>) {
    stats.pass_runs = 0u32;
    stats.pass_changes = 0u32;
    stats.pass_rollbacks = 0u32;
    stats.sites_inspected = 0u32;
    stats.checks_eliminated = 0u32;
    stats.checks_retained_possible = 0u32;
    stats.checks_retained_unknown = 0u32;
    stats.array_checks_eliminated = 0u32;
    stats.slice_checks_eliminated = 0u32;
    stats.vec_checks_eliminated = 0u32;
    stats.blocks_pruned = 0u32;
}

// --- Message Byte & Container Type Helpers (0 string literals) ---

fn bce_is_index_oob_msg(ptr: *const u8, msg_len: usize) -> bool {
    if (ptr as usize) == 0 || msg_len < 19 {
        return false;
    }
    // Exact prefix "index out of bounds" (19 bytes)
    let b0 = unsafe { *opt_u8_at(ptr as *mut u8, 0) };
    let b1 = unsafe { *opt_u8_at(ptr as *mut u8, 1) };
    let b2 = unsafe { *opt_u8_at(ptr as *mut u8, 2) };
    let b3 = unsafe { *opt_u8_at(ptr as *mut u8, 3) };
    let b4 = unsafe { *opt_u8_at(ptr as *mut u8, 4) };
    let b6 = unsafe { *opt_u8_at(ptr as *mut u8, 6) };
    let b7 = unsafe { *opt_u8_at(ptr as *mut u8, 7) };
    let b8 = unsafe { *opt_u8_at(ptr as *mut u8, 8) };
    b0 == 105u8 && b1 == 110u8 && b2 == 100u8 && b3 == 101u8 && b4 == 120u8 &&
    b6 == 111u8 && b7 == 117u8 && b8 == 116u8
}

fn bce_is_arith_or_div_msg(ptr: *const u8, msg_len: usize) -> bool {
    if (ptr as usize) == 0 || msg_len < 5 {
        return false;
    }
    let b0 = unsafe { *opt_u8_at(ptr as *mut u8, 0) };
    let b1 = unsafe { *opt_u8_at(ptr as *mut u8, 1) };
    let b2 = unsafe { *opt_u8_at(ptr as *mut u8, 2) };
    let b3 = unsafe { *opt_u8_at(ptr as *mut u8, 3) };
    // "arith...", "divis...", "remai...", "shift..."
    let is_arith = b0 == 97u8 && b1 == 114u8 && b2 == 105u8 && b3 == 116u8;
    let is_div = b0 == 100u8 && b1 == 105u8 && b2 == 118u8 && b3 == 105u8;
    let is_rem = b0 == 114u8 && b1 == 101u8 && b2 == 109u8 && b3 == 97u8;
    let is_shf = b0 == 115u8 && b1 == 104u8 && b2 == 105u8 && b3 == 102u8;
    is_arith || is_div || is_rem || is_shf
}

fn bce_type_kind(thir: *const Thir, ty: TypeId) -> u8 {
    if (thir as usize) == 0 || ty.v == 0u32 {
        return 0u8;
    }
    let ax = unsafe { type_get(view((*thir).interner), ty) };
    if (ax as usize) == 0 {
        return 0u8;
    }
    unsafe { (*ax).kind }
}

// Recognizes `Vec<T> { ptr: *mut T, len: usize, cap: usize }` in `Thir` (both monomorphized and generic HIR).
fn bce_type_is_vec_struct(thir: *const Thir, ty: TypeId) -> bool {
    if (thir as usize) == 0 || ty.v == 0u32 {
        return false;
    }
    let ax = unsafe { type_get(view((*thir).interner), ty) };
    if (ax as usize) == 0 || (unsafe { (*ax).kind }) != TY_STRUCT {
        return false;
    }
    if (unsafe { (*ax).field_count }) == 3 && ((unsafe { (*ax).fields }) as usize) != 0 {
        let f0 = unsafe { *typeid_at((*ax).fields, 0) };
        let f1 = unsafe { *typeid_at((*ax).fields, 1) };
        let f2 = unsafe { *typeid_at((*ax).fields, 2) };
        return bce_type_kind(thir, f0) == TY_PTR &&
               bce_type_kind(thir, f1) == TY_USIZE &&
               bce_type_kind(thir, f2) == TY_USIZE;
    }
    let def_item = unsafe { (*ax).def };
    if (def_item as usize) != 0 {
        let fd0: *mut HirFieldDecl = unsafe { (*def_item).struct_fields };
        if (fd0 as usize) != 0 {
            let fd1: *mut HirFieldDecl = unsafe { (*fd0).next };
            if (fd1 as usize) != 0 {
                let fd2: *mut HirFieldDecl = unsafe { (*fd1).next };
                if (fd2 as usize) != 0 && ((unsafe { (*fd2).next }) as usize) == 0 {
                    let t0 = unsafe { (*fd0).ty };
                    let t1 = unsafe { (*fd1).ty };
                    let t2 = unsafe { (*fd2).ty };
                    if (t0 as usize) != 0 && (t1 as usize) != 0 && (t2 as usize) != 0 {
                        let k0 = unsafe { (*t0).kind };
                        let k1 = unsafe { (*t1).kind };
                        let k2 = unsafe { (*t2).kind };
                        let n1 = unsafe { (*t1).path.name.v };
                        let n2 = unsafe { (*t2).path.name.v };
                        return k0 == HIR_TYPE_PTR && k1 != HIR_TYPE_PTR && k1 == k2 && n1 != 0u32 && n1 == n2;
                    }
                }
            }
        }
    }
    false
}

fn bce_place_is_vec_len_field(body: view<OptBody>, place: view<MirPlace>, out_vec_loc: mut_view<u32>) -> bool {
    *out_vec_loc = 0xFFFFFFFFu32;
    let lv = place.local.v as usize;
    if lv >= body.local_count || (body.local_tys as usize) == 0 {
        return false;
    }
    let base_ty = unsafe { *opt_typeid_at(body.local_tys, lv) };
    if place.proj_count == 1 && (place.projs as usize) != 0 {
        let p0 = unsafe { mir_proj_at(place.projs, 0) };
        if (unsafe { (*p0).kind }) == MIR_PROJ_FIELD && (unsafe { (*p0).field_idx }) == 1u32 &&
           bce_type_is_vec_struct(body.thir, base_ty) {
            *out_vec_loc = lv as u32;
            return true;
        }
    } else if place.proj_count == 2 && (place.projs as usize) != 0 {
        let p0 = unsafe { mir_proj_at(place.projs, 0) };
        let p1 = unsafe { mir_proj_at(place.projs, 1) };
        if (unsafe { (*p0).kind }) == MIR_PROJ_DEREF &&
           (unsafe { (*p1).kind }) == MIR_PROJ_FIELD && (unsafe { (*p1).field_idx }) == 1u32 {
            if (body.thir as usize) != 0 && base_ty.v != 0u32 {
                let ax = unsafe { type_get(view((*body.thir).interner), base_ty) };
                if (ax as usize) != 0 {
                    let bk = unsafe { (*ax).kind };
                    let pt = unsafe { (*ax).pointee };
                    if (bk == TY_VIEW || bk == TY_MUT_VIEW) && bce_type_is_vec_struct(body.thir, pt) {
                        *out_vec_loc = lv as u32;
                        return true;
                    }
                }
            }
        }
    }
    false
}

fn bce_place_writes_local_directly(place: view<MirPlace>, loc: u32) -> bool {
    if place.local.v != loc {
        return false;
    }
    if place.proj_count == 0 || (place.projs as usize) == 0 {
        return true;
    }
    let p0 = unsafe { mir_proj_at(place.projs, 0) };
    (unsafe { (*p0).kind }) != MIR_PROJ_DEREF
}

fn bce_local_is_single_def_unescaped(body: view<OptBody>, info: *const AliasInfo, loc: u32) -> bool {
    let lu = loc as usize;
    if lu >= body.local_count || (info as usize) == 0 || lu >= (unsafe { (*info).local_count }) {
        return false;
    }
    if (body.local_addr_taken as usize) != 0 && (unsafe { *opt_bool_at(body.local_addr_taken, lu) }) {
        return false;
    }
    let prov = unsafe { alias_local_prov_at((*info).locals, lu) };
    if (unsafe { (*prov).mut_borrow_taken }) || (unsafe { (*prov).raw_addr_exposed }) ||
       (unsafe { (*prov).def_count }) != 1u32 {
        return false;
    }
    let mut write_cnt: u32 = 0u32;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                if opc != OPT_INST_NOP {
                    let sk = unsafe { (*inst).orig_stmt.kind };
                    if sk == MIR_STMT_DROP && (unsafe { (*inst).orig_stmt.place.local.v }) == loc {
                        return false;
                    }
                    if opc == OPT_INST_DROP_FLAG && (unsafe { (*inst).place.local.v }) == loc {
                        return false;
                    }
                    if (sk == MIR_STMT_ASSIGN && bce_place_writes_local_directly(unsafe { view((*inst).orig_stmt.place) }, loc)) ||
                       ((opc == OPT_INST_STORE || opc == OPT_INST_INSERT_FIELD) && bce_place_writes_local_directly(unsafe { view((*inst).place) }, loc)) {
                        write_cnt = write_cnt + 1u32;
                        if write_cnt > 1u32 {
                            return false;
                        }
                    }
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_DROP && (unsafe { (*bb).term.drop_place.local.v }) == loc {
                    return false;
                }
                if tk == OPT_TERM_CALL && (unsafe { (*bb).term.has_call_dest }) &&
                   bce_place_writes_local_directly(unsafe { view((*bb).term.call_dest) }, loc) {
                    write_cnt = write_cnt + 1u32;
                    if write_cnt > 1u32 {
                        return false;
                    }
                }
            }
        }
        b = b + 1;
    }
    let is_param = loc >= 1u32 && lu <= body.arg_count;
    if is_param {
        return write_cnt == 0u32;
    }
    write_cnt == 1u32
}

// Resolves single-assignment unescaped scalar local copy/reborrow chains (`_tmp = copy _src`, `_v = & (*_src)`)
// back to a single-definition or fixed-array container local so `len(_tmp)` and `len(_src)` share a canonical root.
fn bce_resolve_root_local_chain(body: view<OptBody>, info: *const AliasInfo, start_loc: u32) -> u32 {
    let mut cur = start_loc;
    let mut hops: usize = 0;
    while hops < 8 && (cur as usize) < body.local_count {
        if !bce_local_is_single_def_unescaped(body, info, cur) {
            break;
        }
        let mut next_loc = 0xFFFFFFFFu32;
        if (info as usize) != 0 && (cur as usize) < (unsafe { (*info).local_count }) {
            let prov = unsafe { alias_local_prov_at((*info).locals, cur as usize) };
            if (unsafe { (*prov).def_count }) == 1u32 && (unsafe { (*prov).has_origin_place }) {
                let op = unsafe { view((*prov).origin_place) };
                if op.proj_count == 0 {
                    next_loc = op.local.v;
                } else if op.proj_count == 1 && (op.projs as usize) != 0 {
                    let pr0 = unsafe { mir_proj_at(op.projs, 0) };
                    if (unsafe { (*pr0).kind }) == MIR_PROJ_DEREF {
                        let base_ty = unsafe { *opt_typeid_at(body.local_tys, op.local.v as usize) };
                        let bk = bce_type_kind(body.thir, base_ty);
                        if bk == TY_VIEW || bk == TY_MUT_VIEW {
                            next_loc = op.local.v;
                        }
                    }
                }
            }
        }
        // Also check single-definition `OPT_INST_COPY` `_cur = copy _src`
        if next_loc == 0xFFFFFFFFu32 {
            let mut found_defs: u32 = 0u32;
            let mut copy_src = 0xFFFFFFFFu32;
            let mut b: usize = 0;
            while b < body.bb_count && found_defs <= 1u32 {
                let bb = unsafe { opt_block_at(body.blocks, b) };
                if unsafe { (*bb).is_reachable } {
                    let icnt = unsafe { (*bb).inst_count };
                    let mut i: usize = 0;
                    while i < icnt {
                        let inst = unsafe { opt_inst_at((*bb).insts, i) };
                        let opc = unsafe { (*inst).opcode };
                        let flg = unsafe { (*inst).flags };
                        let is_nop = opc == OPT_INST_NOP || opc == OPT_INST_DROP_FLAG;
                        if !is_nop && (unsafe { (*inst).place.local.v }) == cur {
                            found_defs = found_defs + 1u32;
                            if opc == OPT_INST_COPY &&
                               (unsafe { (*inst).place.proj_count }) == 0 &&
                               (unsafe { (*inst).rhs_place.proj_count }) == 0 &&
                               (flg & OPT_FLAG_BARRIER) == 0u16 {
                                copy_src = unsafe { (*inst).rhs_place.local.v };
                            }
                        }
                        i = i + 1;
                    }
                    if (unsafe { (*bb).term.kind }) == OPT_TERM_CALL &&
                       (unsafe { (*bb).term.has_call_dest }) &&
                       (unsafe { (*bb).term.call_dest.local.v }) == cur {
                        found_defs = found_defs + 2u32;
                    }
                }
                b = b + 1;
            }
            if found_defs == 1u32 && copy_src != 0xFFFFFFFFu32 {
                next_loc = copy_src;
            }
        }
        if next_loc == 0xFFFFFFFFu32 || next_loc == cur || (next_loc as usize) >= body.local_count {
            break;
        }
        let next_is_arr = (body.local_tys as usize) != 0 &&
                          bce_type_kind(body.thir, unsafe { *opt_typeid_at(body.local_tys, next_loc as usize) }) == TY_ARRAY;
        if !next_is_arr && !bce_local_is_single_def_unescaped(body, info, next_loc) {
            break;
        }
        cur = next_loc;
        hops = hops + 1;
    }
    cur
}

const BCE_DEF_NONE: u8 = 0u8;
const BCE_DEF_INST: u8 = 1u8;
const BCE_DEF_PHI: u8 = 2u8;
const BCE_DEF_CALL: u8 = 3u8;
const BCE_DEF_PARAM: u8 = 4u8;

fn bce_inst_clobbers_scalar_local(inst: view<OptInst>, loc: u32) -> bool {
    let flg = inst.flags;
    if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
        if inst.place.local.v == loc || inst.orig_stmt.storage_local.v == loc {
            return true;
        }
    }
    let opc = inst.opcode;
    if opc == OPT_INST_NOP {
        return false;
    }
    if opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE {
        return true;
    }
    if opc == OPT_INST_ADDR_OF && bce_place_writes_local_directly(view(inst.rhs_place), loc) {
        return true;
    }
    let sk = inst.orig_stmt.kind;
    if sk == MIR_STMT_DROP && bce_place_writes_local_directly(view(inst.orig_stmt.place), loc) {
        return true;
    }
    if sk == MIR_STMT_ASSIGN &&
       (bce_place_writes_local_directly(view(inst.place), loc) ||
        bce_place_writes_local_directly(view(inst.orig_stmt.place), loc)) {
        return true;
    }
    if (opc == OPT_INST_STORE || opc == OPT_INST_VOLATILE_STORE ||
        opc == OPT_INST_INSERT_FIELD || opc == OPT_INST_AGGREGATE ||
        opc == OPT_INST_DROP_FLAG) &&
       bce_place_writes_local_directly(view(inst.place), loc) {
        return true;
    }
    if inst.result.v != OPT_VALUE_NONE && bce_place_writes_local_directly(view(inst.place), loc) {
        return true;
    }
    false
}

fn bce_term_clobbers_scalar_local(term: view<OptTerminator>, loc: u32) -> bool {
    let tk = term.kind;
    if tk == OPT_TERM_DROP {
        return bce_place_writes_local_directly(view(term.drop_place), loc);
    }
    if tk == OPT_TERM_CALL {
        if term.has_call_dest && bce_place_writes_local_directly(view(term.call_dest), loc) {
            return true;
        }
    }
    false
}

fn bce_block_range_clobbers_scalar_local(bb: view<OptBlock>, lo: usize, hi: usize, loc: u32) -> bool {
    let end: usize = if hi > bb.inst_count { bb.inst_count } else { hi };
    let mut k: usize = lo;
    while k < end {
        let inst_k = unsafe { opt_inst_at(bb.insts, k) };
        if bce_inst_clobbers_scalar_local(unsafe { view(*inst_k) }, loc) {
            return true;
        }
        k = k + 1;
    }
    false
}

// Verifies across ALL reachable CFG paths (including diamond branches and loop backedges) that
// `loc` is never written, dropped, StorageDead/StorageLive, or unwound between its candidate
// definition `(def_kind, def_bb, def_i)` and `(at_bb, before_inst)`.
fn bce_scalar_local_unclobbered_from_def(
    body: view<OptBody>,
    def_kind: u8,
    def_bb: usize,
    def_i: usize,
    at_bb: usize,
    before_inst: usize,
    loc: u32,
    arena: mut_view<Arena>
) -> bool {
    let n = body.bb_count;
    if def_kind == BCE_DEF_NONE || at_bb >= n {
        return false;
    }
    let abb = unsafe { opt_block_at(body.blocks, at_bb) };
    if !(unsafe { (*abb).is_reachable }) || before_inst > (unsafe { (*abb).inst_count }) {
        return false;
    }

    let at_id = OptBbId { v: at_bb as u32 };
    if def_kind == BCE_DEF_INST {
        let def_id = OptBbId { v: def_bb as u32 };
        if def_bb >= n || !opt_dominates(body, def_id, at_id) {
            return false;
        }
        if def_bb == at_bb {
            if def_i >= before_inst {
                return false;
            }
            return !bce_block_range_clobbers_scalar_local(unsafe { view(*abb) }, def_i + 1, before_inst, loc);
        }
    } else if def_kind == BCE_DEF_PHI {
        let def_id = OptBbId { v: def_bb as u32 };
        if def_bb >= n || !opt_dominates(body, def_id, at_id) {
            return false;
        }
        if def_bb == at_bb {
            return !bce_block_range_clobbers_scalar_local(unsafe { view(*abb) }, 0, before_inst, loc);
        }
    } else if def_kind == BCE_DEF_CALL {
        if def_bb >= n || def_bb == at_bb {
            return false;
        }
        let call_bb = unsafe { opt_block_at(body.blocks, def_bb) };
        if !(unsafe { (*call_bb).has_term }) || (unsafe { (*call_bb).term.kind }) != OPT_TERM_CALL {
            return false;
        }
        let cont_v = unsafe { (*call_bb).term.true_bb.v };
        let unwind_v = unsafe { (*call_bb).term.unwind_bb.v };
        if (cont_v as usize) >= n || (cont_v as usize) == def_bb || cont_v == unwind_v {
            return false;
        }
        let def_id = OptBbId { v: def_bb as u32 };
        let cont_id = OptBbId { v: cont_v };
        if !opt_dominates(body, def_id, at_id) || !opt_dominates(body, cont_id, at_id) {
            return false;
        }
    } else if def_kind != BCE_DEF_PARAM {
        return false;
    }

    if bce_block_range_clobbers_scalar_local(unsafe { view(*abb) }, 0, before_inst, loc) {
        return false;
    }

    let call_unwind_v: u32 = if def_kind == BCE_DEF_CALL {
        let cbb0 = unsafe { opt_block_at(body.blocks, def_bb) };
        unsafe { (*cbb0).term.unwind_bb.v }
    } else {
        OPT_BB_NONE
    };

    let vis = arena_alloc_raw(mut_view(*arena), bce_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let queue = arena_alloc_raw(mut_view(*arena), bce_mul_usize(n + 2, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut z: usize = 0;
    while z < n {
        unsafe { *opt_bool_at(vis, z) = false; }
        z = z + 1;
    }

    let mut q_head: usize = 0;
    let mut q_tail: usize = 0;
    let apcnt = unsafe { (*abb).pred_count };
    let mut p: usize = 0;
    while p < apcnt {
        let pv = (unsafe { (*opt_bbid_at((*abb).preds, p)).v }) as usize;
        if pv < n && !(unsafe { *opt_bool_at(vis, pv) }) {
            let pbb = unsafe { opt_block_at(body.blocks, pv) };
            if unsafe { (*pbb).is_reachable } {
                unsafe {
                    *opt_bool_at(vis, pv) = true;
                    *opt_u32_at(queue, q_tail) = pv as u32;
                }
                q_tail = q_tail + 1;
            }
        }
        p = p + 1;
    }

    while q_head < q_tail {
        let b_idx = (unsafe { *opt_u32_at(queue, q_head) }) as usize;
        q_head = q_head + 1;
        let qbb = unsafe { opt_block_at(body.blocks, b_idx) };
        let q_icnt = unsafe { (*qbb).inst_count };

        if def_kind == BCE_DEF_CALL && (b_idx as u32) == call_unwind_v {
            return false;
        }

        if def_kind != BCE_DEF_PARAM && b_idx == def_bb {
            if def_kind == BCE_DEF_INST {
                if def_i + 1 < q_icnt &&
                   bce_block_range_clobbers_scalar_local(unsafe { view(*qbb) }, def_i + 1, q_icnt, loc) {
                    return false;
                }
                if (unsafe { (*qbb).has_term }) && bce_term_clobbers_scalar_local(unsafe { view((*qbb).term) }, loc) {
                    return false;
                }
            } else if def_kind == BCE_DEF_PHI {
                if bce_block_range_clobbers_scalar_local(unsafe { view(*qbb) }, 0, q_icnt, loc) {
                    return false;
                }
                if (unsafe { (*qbb).has_term }) && bce_term_clobbers_scalar_local(unsafe { view((*qbb).term) }, loc) {
                    return false;
                }
            }
            // Do not walk past `def_bb` entry (or `def_bb -> cont_bb` call edge for `BCE_DEF_CALL`).
        } else {
            if bce_block_range_clobbers_scalar_local(unsafe { view(*qbb) }, 0, q_icnt, loc) {
                return false;
            }
            if (unsafe { (*qbb).has_term }) && bce_term_clobbers_scalar_local(unsafe { view((*qbb).term) }, loc) {
                return false;
            }
            let qpcnt = unsafe { (*qbb).pred_count };
            let mut qp: usize = 0;
            while qp < qpcnt {
                let npv = (unsafe { (*opt_bbid_at((*qbb).preds, qp)).v }) as usize;
                if npv < n && !(unsafe { *opt_bool_at(vis, npv) }) {
                    let npbb = unsafe { opt_block_at(body.blocks, npv) };
                    if unsafe { (*npbb).is_reachable } {
                        unsafe {
                            *opt_bool_at(vis, npv) = true;
                            *opt_u32_at(queue, q_tail) = npv as u32;
                        }
                        q_tail = q_tail + 1;
                    }
                }
                qp = qp + 1;
            }
        }
    }
    true
}

// Resolves the reaching SSA `OptValueId` of a non-addressed scalar local `loc` at `(at_bb, before_inst)`,
// verifying zero clobbers across ALL CFG paths (including non-dominating branches and loop backedges)
// because pruned SSA omits join/header `OptPhi`s when `loc` is only read inside a `MirPlace`.
fn bce_resolve_ssa_local_at(
    body: view<OptBody>,
    info: *const AliasInfo,
    loc: u32,
    at_bb: usize,
    before_inst: usize,
    arena: mut_view<Arena>
) -> OptValueId {
    let lu = loc as usize;
    if lu >= body.local_count || at_bb >= body.bb_count {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    if (body.local_addr_taken as usize) == 0 && (info as usize) == 0 {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    if (body.local_addr_taken as usize) != 0 && (unsafe { *opt_bool_at(body.local_addr_taken, lu) }) {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    if (body.local_modes as usize) != 0 {
        let mode = unsafe { *opt_u8_at(body.local_modes, lu) };
        if mode != 0u8 { // OPT_LOCAL_SCALAR == 0
            return OptValueId { v: OPT_VALUE_NONE };
        }
    }
    if (info as usize) != 0 {
        if lu >= (unsafe { (*info).local_count }) {
            return OptValueId { v: OPT_VALUE_NONE };
        }
        let prov = unsafe { alias_local_prov_at((*info).locals, lu) };
        if (unsafe { (*prov).mut_borrow_taken }) || (unsafe { (*prov).raw_addr_exposed }) ||
           (unsafe { (*prov).escaped_external }) || (unsafe { (*prov).is_fixed_mmio }) {
            return OptValueId { v: OPT_VALUE_NONE };
        }
    } else {
        let mut ab: usize = 0;
        while ab < body.bb_count {
            let abb_scan = unsafe { opt_block_at(body.blocks, ab) };
            if unsafe { (*abb_scan).is_reachable } {
                let aic = unsafe { (*abb_scan).inst_count };
                let mut ai: usize = 0;
                while ai < aic {
                    let ainst = unsafe { opt_inst_at((*abb_scan).insts, ai) };
                    if (unsafe { (*ainst).opcode }) == OPT_INST_ADDR_OF &&
                       bce_place_writes_local_directly(unsafe { view((*ainst).rhs_place) }, loc) {
                        return OptValueId { v: OPT_VALUE_NONE };
                    }
                    ai = ai + 1;
                }
            }
            ab = ab + 1;
        }
    }
    let start_bb = unsafe { opt_block_at(body.blocks, at_bb) };
    if !(unsafe { (*start_bb).is_reachable }) || before_inst > (unsafe { (*start_bb).inst_count }) {
        return OptValueId { v: OPT_VALUE_NONE };
    }

    let mut cand_kind: u8 = BCE_DEF_NONE;
    let mut cand_bb: usize = 0;
    let mut cand_i: usize = 0;
    let mut cand_val = OptValueId { v: OPT_VALUE_NONE };

    let mut cur_bb = at_bb;
    let mut first = true;
    let mut steps: usize = 0;
    while steps <= body.bb_count && cur_bb < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, cur_bb) };
        let icnt = unsafe { (*bb).inst_count };
        if !first && (unsafe { (*bb).has_term }) {
            let tk = unsafe { (*bb).term.kind };
            if tk == OPT_TERM_CALL && (unsafe { (*bb).term.has_call_dest }) &&
               (unsafe { (*bb).term.call_dest.local.v }) == loc {
                if (unsafe { (*bb).term.call_dest.proj_count }) == 0 &&
                   (unsafe { (*bb).term.call_result.v }) != OPT_VALUE_NONE {
                    cand_kind = BCE_DEF_CALL;
                    cand_bb = cur_bb;
                    cand_i = icnt;
                    cand_val = unsafe { (*bb).term.call_result };
                    break;
                }
                return OptValueId { v: OPT_VALUE_NONE };
            }
            if bce_term_clobbers_scalar_local(unsafe { view((*bb).term) }, loc) {
                return OptValueId { v: OPT_VALUE_NONE };
            }
        }
        let mut i: usize = if first && before_inst <= icnt { before_inst } else { icnt };
        first = false;
        let mut hit_inst = false;
        while i > 0 {
            i = i - 1;
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            let opc = unsafe { (*inst).opcode };
            let flg = unsafe { (*inst).flags };
            if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
               opc != OPT_INST_NOP && opc != OPT_INST_DROP_FLAG && opc != OPT_INST_STORE &&
               opc != OPT_INST_VOLATILE_STORE && opc != OPT_INST_INSERT_FIELD &&
               opc != OPT_INST_AGGREGATE && opc != OPT_INST_BLACK_BOX && opc != OPT_INST_ZEROIZE &&
               (unsafe { (*inst).place.local.v }) == loc &&
               (unsafe { (*inst).place.proj_count }) == 0 &&
               (unsafe { (*inst).result.v }) != OPT_VALUE_NONE {
                cand_kind = BCE_DEF_INST;
                cand_bb = cur_bb;
                cand_i = i;
                cand_val = unsafe { (*inst).result };
                hit_inst = true;
                break;
            }
            if bce_inst_clobbers_scalar_local(unsafe { view(*inst) }, loc) {
                return OptValueId { v: OPT_VALUE_NONE };
            }
        }
        if hit_inst {
            break;
        }
        let pcnt = unsafe { (*bb).phi_count };
        let mut p: usize = 0;
        let mut hit_phi = false;
        while p < pcnt {
            let phi = unsafe { opt_phi_at((*bb).phis, p) };
            // Ignore synthetic LCSSA phis (`slot_idx == OPT_PROJ_NONE`), which forward a specific SSA value rather than a MIR local slot.
            if (unsafe { (*phi).src_local.v }) == loc &&
               (unsafe { (*phi).proj_field }) == OPT_PROJ_NONE &&
               (unsafe { (*phi).slot_idx }) != OPT_PROJ_NONE &&
               (unsafe { (*phi).result.v }) != OPT_VALUE_NONE {
                cand_kind = BCE_DEF_PHI;
                cand_bb = cur_bb;
                cand_i = 0;
                cand_val = unsafe { (*phi).result };
                hit_phi = true;
                break;
            }
            p = p + 1;
        }
        if hit_phi {
            break;
        }
        if cur_bb == 0 {
            break;
        }
        let idom = unsafe { (*bb).idom };
        if idom.v == OPT_BB_NONE || (idom.v as usize) == cur_bb {
            break;
        }
        cur_bb = idom.v as usize;
        steps = steps + 1;
    }

    if cand_kind == BCE_DEF_NONE && loc >= 1u32 && lu <= body.arg_count {
        let mut v: usize = 1;
        while v <= body.value_count {
            let vp = unsafe { opt_val_at(body.values, v) };
            if (unsafe { (*vp).kind }) == OPT_VAL_PARAM &&
               (unsafe { (*vp).src_local.v }) == loc &&
               (unsafe { (*vp).proj_field }) == OPT_PROJ_NONE {
                cand_kind = BCE_DEF_PARAM;
                cand_bb = 0;
                cand_i = 0;
                cand_val = OptValueId { v: v as u32 };
                break;
            }
            v = v + 1;
        }
    }

    if cand_kind == BCE_DEF_NONE || cand_val.v == OPT_VALUE_NONE {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    if !bce_scalar_local_unclobbered_from_def(body, cand_kind, cand_bb, cand_i, at_bb, before_inst, loc, mut_view(*arena)) {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    lp_peel_copy_and_lcssa(body, cand_val)
}

fn bce_inst_clobbers_len_state(
    body: view<OptBody>,
    info: *const AliasInfo,
    inst: view<OptInst>,
    bb_v: u32,
    inst_idx: u32,
    root_loc: u32,
    src_loc: u32,
    check_mem: bool,
    region_place: view<MirPlace>,
    arena: mut_view<Arena>
) -> bool {
    let opc = inst.opcode;
    let flg = inst.flags;
    if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
        let dl = inst.place.local.v;
        let sl = inst.orig_stmt.storage_local.v;
        if dl == root_loc || dl == src_loc || sl == root_loc || sl == src_loc {
            return true;
        }
    }
    if opc == OPT_INST_NOP {
        return false;
    }
    if opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE || opc == OPT_INST_ATOMIC || opc == OPT_INST_VOLATILE_STORE {
        return true;
    }
    // Any direct local or direct struct-field overwrite/drop of `root_loc` or `src_loc` (e.g. `v.len = 0`) invalidates length
    if inst.orig_stmt.kind == MIR_STMT_DROP {
        let dl2 = inst.orig_stmt.place.local.v;
        if dl2 == root_loc || dl2 == src_loc {
            return true;
        }
    }
    if inst.orig_stmt.kind == MIR_STMT_ASSIGN {
        if bce_place_writes_local_directly(view(inst.place), root_loc) ||
           bce_place_writes_local_directly(view(inst.place), src_loc) ||
           bce_place_writes_local_directly(view(inst.orig_stmt.place), root_loc) ||
           bce_place_writes_local_directly(view(inst.orig_stmt.place), src_loc) {
            return true;
        }
    }
    if !check_mem {
        // Also check if `root_loc` has its address mutated via `*mut_view(s) = new_slice`
        if (info as usize) != 0 && (root_loc as usize) < (unsafe { (*info).local_count }) {
            let rprov = unsafe { alias_local_prov_at((*info).locals, root_loc as usize) };
            if !(unsafe { (*rprov).mut_borrow_taken }) && !(unsafe { (*rprov).raw_addr_exposed }) {
                return false;
            }
        }
    }
    let writes_mem_or_proj = inst.orig_stmt.kind == MIR_STMT_ASSIGN && opc != OPT_INST_NOP &&
                             (inst.place.proj_count > 0 || inst.orig_stmt.place.proj_count > 0 ||
                              inst.mem_def.v != MEM_SSA_NONE || opc == OPT_INST_AGGREGATE);
    if opc == OPT_INST_STORE || opc == OPT_INST_INSERT_FIELD ||
       opc == OPT_INST_DROP_FLAG || writes_mem_or_proj {
        if (info as usize) == 0 {
            return true;
        }
        let pt = alias_make_prog_pt(bb_v, inst_idx);
        if inst.place.local.v != 0u32 || inst.orig_stmt.place.local.v == 0u32 {
            let af = alias_query_places(unsafe { view(*info) }, body, mut_view(*arena), view(inst.place), region_place, pt);
            if !alias_is_no_alias_proven(view(af)) {
                return true;
            }
        } else {
            let af = alias_query_places(unsafe { view(*info) }, body, mut_view(*arena), view(inst.orig_stmt.place), region_place, pt);
            if !alias_is_no_alias_proven(view(af)) {
                return true;
            }
        }
    }
    false
}

fn bce_term_clobbers_len_state(
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    bb: view<OptBlock>,
    bb_v: u32,
    root_loc: u32,
    src_loc: u32,
    check_mem: bool,
    region_place: view<MirPlace>,
    arena: mut_view<Arena>
) -> bool {
    if !bb.has_term {
        return false;
    }
    let mut can_mutate_root = check_mem;
    if !can_mutate_root {
        if (info as usize) != 0 && (root_loc as usize) < (unsafe { (*info).local_count }) {
            let rprov = unsafe { alias_local_prov_at((*info).locals, root_loc as usize) };
            if (unsafe { (*rprov).mut_borrow_taken }) || (unsafe { (*rprov).raw_addr_exposed }) {
                can_mutate_root = true;
            }
        } else {
            can_mutate_root = true;
        }
    }
    let tk = bb.term.kind;
    if tk == OPT_TERM_DROP {
        let dl = bb.term.drop_place.local.v;
        if dl == root_loc || dl == src_loc {
            return true;
        }
        if can_mutate_root {
            if (info as usize) == 0 {
                return true;
            }
            let pt = alias_make_prog_pt(bb_v, bb.inst_count as u32);
            let af = alias_query_places(unsafe { view(*info) }, body, mut_view(*arena), view(bb.term.drop_place), region_place, pt);
            if !alias_is_no_alias_proven(view(af)) {
                return true;
            }
        }
        return false;
    }
    if tk == OPT_TERM_CALL {
        if bb.term.has_call_dest {
            let cl = bb.term.call_dest.local.v;
            if cl == root_loc || cl == src_loc {
                return true;
            }
            if can_mutate_root {
                if (info as usize) == 0 {
                    return true;
                }
                let pt = alias_make_prog_pt(bb_v, bb.inst_count as u32);
                let af = alias_query_places(unsafe { view(*info) }, body, mut_view(*arena), view(bb.term.call_dest), region_place, pt);
                if !alias_is_no_alias_proven(view(af)) {
                    return true;
                }
            }
        }
        if can_mutate_root {
            let teff = effect_infer_term_with_table(body, view(bb.term), call_table);
            if (teff.flags & (EFFECT_WRITES_MEM | EFFECT_VOLATILE | EFFECT_ATOMIC | EFFECT_FFI | EFFECT_UNKNOWN)) != 0u16 {
                return true;
            }
        }
    }
    false
}

// Exact SSA-dominance backward walk verifying zero clobbers on all paths from `(bb1, inst1)` to `(bb2, inst2)`.
fn bce_path_unclobbered_between(
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    bb1: u32,
    inst1: u32,
    bb2: u32,
    inst2: u32,
    root_loc: u32,
    src_loc1: u32,
    src_loc2: u32,
    check_mem: bool,
    region_place: view<MirPlace>,
    arena: mut_view<Arena>
) -> bool {
    if (bb1 as usize) >= body.bb_count || (bb2 as usize) >= body.bb_count {
        return false;
    }
    let id_bb1 = OptBbId { v: bb1 };
    let id_bb2 = OptBbId { v: bb2 };
    if !opt_dominates(body, id_bb1, id_bb2) {
        return false;
    }
    if bb1 == bb2 {
        if inst1 > inst2 {
            return false;
        }
        let blk = unsafe { opt_block_at(body.blocks, bb1 as usize) };
        let icnt = unsafe { (*blk).inst_count };
        let end_i: usize = if (inst2 as usize) < icnt { inst2 as usize } else { icnt };
        let mut k: usize = (inst1 as usize) + 1;
        while k < end_i {
            let ki = unsafe { opt_inst_at((*blk).insts, k) };
            if bce_inst_clobbers_len_state(body, info, unsafe { view(*ki) }, bb1, k as u32, root_loc, src_loc1, check_mem, region_place, mut_view(*arena)) ||
               (src_loc2 != src_loc1 && bce_inst_clobbers_len_state(body, info, unsafe { view(*ki) }, bb1, k as u32, root_loc, src_loc2, check_mem, region_place, mut_view(*arena))) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }

    // 1. Check `bb1` after `inst1` + `bb1.term`
    let blk1 = unsafe { opt_block_at(body.blocks, bb1 as usize) };
    let icnt1 = unsafe { (*blk1).inst_count };
    let mut k1: usize = (inst1 as usize) + 1;
    while k1 < icnt1 {
        let ki = unsafe { opt_inst_at((*blk1).insts, k1) };
        if bce_inst_clobbers_len_state(body, info, unsafe { view(*ki) }, bb1, k1 as u32, root_loc, src_loc1, check_mem, region_place, mut_view(*arena)) {
            return false;
        }
        k1 = k1 + 1;
    }
    if bce_term_clobbers_len_state(body, info, call_table, unsafe { view(*blk1) }, bb1, root_loc, src_loc1, check_mem, region_place, mut_view(*arena)) {
        return false;
    }

    // 2. Check `bb2` before `inst2`
    let blk2 = unsafe { opt_block_at(body.blocks, bb2 as usize) };
    let icnt2 = unsafe { (*blk2).inst_count };
    let end2: usize = if (inst2 as usize) < icnt2 { inst2 as usize } else { icnt2 };
    let mut k2: usize = 0;
    while k2 < end2 {
        let ki = unsafe { opt_inst_at((*blk2).insts, k2) };
        if bce_inst_clobbers_len_state(body, info, unsafe { view(*ki) }, bb2, k2 as u32, root_loc, src_loc2, check_mem, region_place, mut_view(*arena)) {
            return false;
        }
        k2 = k2 + 1;
    }

    // 3. Backward BFS from `bb2` predecessors stopping at `bb1` (includes any loop cycles not containing `bb1`!)
    let n = body.bb_count;
    let vis = arena_alloc_raw(mut_view(*arena), bce_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let q = arena_alloc_raw(mut_view(*arena), bce_mul_usize(n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut b: usize = 0;
    while b < n {
        unsafe { *opt_bool_at(vis, b) = false; }
        b = b + 1;
    }
    unsafe { *opt_bool_at(vis, bb1 as usize) = true; }

    let mut q_head: usize = 0;
    let mut q_tail: usize = 0;
    let pcnt2 = unsafe { (*blk2).pred_count };
    let mut p: usize = 0;
    while p < pcnt2 {
        let pv = (unsafe { (*opt_bbid_at((*blk2).preds, p)).v }) as usize;
        if pv < n && !(unsafe { *opt_bool_at(vis, pv) }) {
            let pbb = unsafe { opt_block_at(body.blocks, pv) };
            if (unsafe { (*pbb).is_reachable }) && !(unsafe { (*pbb).is_cleanup }) {
                unsafe {
                    *opt_bool_at(vis, pv) = true;
                    *opt_u32_at(q, q_tail) = pv as u32;
                }
                q_tail = q_tail + 1;
            }
        }
        p = p + 1;
    }

    while q_head < q_tail {
        let cur_v = unsafe { *opt_u32_at(q, q_head) };
        q_head = q_head + 1;
        let cbb = unsafe { opt_block_at(body.blocks, cur_v as usize) };
        let cicnt = unsafe { (*cbb).inst_count };
        let mut ci: usize = 0;
        while ci < cicnt {
            let cinst = unsafe { opt_inst_at((*cbb).insts, ci) };
            if bce_inst_clobbers_len_state(body, info, unsafe { view(*cinst) }, cur_v, ci as u32, root_loc, src_loc1, check_mem, region_place, mut_view(*arena)) ||
               (src_loc2 != src_loc1 && bce_inst_clobbers_len_state(body, info, unsafe { view(*cinst) }, cur_v, ci as u32, root_loc, src_loc2, check_mem, region_place, mut_view(*arena))) {
                return false;
            }
            ci = ci + 1;
        }
        if bce_term_clobbers_len_state(body, info, call_table, unsafe { view(*cbb) }, cur_v, root_loc, src_loc1, check_mem, region_place, mut_view(*arena)) ||
           (src_loc2 != src_loc1 && bce_term_clobbers_len_state(body, info, call_table, unsafe { view(*cbb) }, cur_v, root_loc, src_loc2, check_mem, region_place, mut_view(*arena))) {
            return false;
        }
        let cpcnt = unsafe { (*cbb).pred_count };
        let mut cp: usize = 0;
        while cp < cpcnt {
            let npv = (unsafe { (*opt_bbid_at((*cbb).preds, cp)).v }) as usize;
            if npv < n && !(unsafe { *opt_bool_at(vis, npv) }) {
                let npbb = unsafe { opt_block_at(body.blocks, npv) };
                if (unsafe { (*npbb).is_reachable }) && !(unsafe { (*npbb).is_cleanup }) {
                    unsafe {
                        *opt_bool_at(vis, npv) = true;
                        *opt_u32_at(q, q_tail) = npv as u32;
                    }
                    q_tail = q_tail + 1;
                }
            }
            cp = cp + 1;
        }
    }
    true
}

// --- Dynamic Pool Push Helpers for `RangeInfo` ---

fn bce_push_bound(ri: mut_view<RangeInfo>, arena: mut_view<Arena>, sb: SymbolicBound) {
    // Deduplicate identical or weaker bounds
    let mut i: usize = 0;
    while i < ri.bound_count && (ri.bounds as usize) != 0 {
        let cur = unsafe { bce_bound_at(ri.bounds, i) };
        if (unsafe { (*cur).lhs.v }) == sb.lhs.v &&
           (unsafe { (*cur).rhs_base.v }) == sb.rhs_base.v &&
           (unsafe { (*cur).rel }) == sb.rel &&
           (unsafe { (*cur).valid_at_bb.v }) == sb.valid_at_bb.v {
            let cur_off = unsafe { (*cur).rhs_offset };
            let sb_off = sb.rhs_offset;
            if sb.rel == BOUND_LE && sb_off < cur_off {
                unsafe { (*cur).rhs_offset = sb_off; }
            } else if sb.rel == BOUND_GE && sb_off > cur_off {
                unsafe { (*cur).rhs_offset = sb_off; }
            }
            return;
        }
        i = i + 1;
    }
    if ri.bound_count >= ri.bound_cap {
        let new_cap: usize = if ri.bound_cap == 0 { 32 } else { ri.bound_cap + ri.bound_cap };
        let new_arr = arena_alloc_raw(mut_view(*arena), bce_mul_usize(new_cap, size_of<SymbolicBound>()), align_of<SymbolicBound>()) as *mut SymbolicBound;
        if ri.bound_count > 0 && (ri.bounds as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(ri.bounds as *const u8, new_arr as *mut u8, bce_mul_usize(ri.bound_count, size_of<SymbolicBound>()));
            }
        }
        ri.bounds = new_arr;
        ri.bound_cap = new_cap;
    }
    unsafe { *bce_bound_at(ri.bounds, ri.bound_count) = sb; }
    ri.bound_count = ri.bound_count + 1;
}

fn bce_push_nonneg(ri: mut_view<RangeInfo>, arena: mut_view<Arena>, val: OptValueId, at_bb: OptBbId) {
    if val.v == OPT_VALUE_NONE {
        return;
    }
    let mut i: usize = 0;
    while i < ri.nonneg_count && (ri.nonneg_facts as usize) != 0 {
        let nf = unsafe { bce_nonneg_at(ri.nonneg_facts, i) };
        if (unsafe { (*nf).val.v }) == val.v && (unsafe { (*nf).valid_at_bb.v }) == at_bb.v {
            return;
        }
        i = i + 1;
    }
    if ri.nonneg_count >= ri.nonneg_cap {
        let new_cap: usize = if ri.nonneg_cap == 0 { 16 } else { ri.nonneg_cap + ri.nonneg_cap };
        let new_arr = arena_alloc_raw(mut_view(*arena), bce_mul_usize(new_cap, size_of<NonNegFact>()), align_of<NonNegFact>()) as *mut NonNegFact;
        if ri.nonneg_count > 0 && (ri.nonneg_facts as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(ri.nonneg_facts as *const u8, new_arr as *mut u8, bce_mul_usize(ri.nonneg_count, size_of<NonNegFact>()));
            }
        }
        ri.nonneg_facts = new_arr;
        ri.nonneg_cap = new_cap;
    }
    unsafe {
        *bce_nonneg_at(ri.nonneg_facts, ri.nonneg_count) = NonNegFact { val: val, valid_at_bb: at_bb };
    }
    ri.nonneg_count = ri.nonneg_count + 1;
}

fn bce_push_checked_op(ri: mut_view<RangeInfo>, arena: mut_view<Arena>, bop: u8, lhs: OptValueId, rhs: OptValueId, at_bb: OptBbId) {
    if ri.checked_count >= ri.checked_cap {
        let new_cap: usize = if ri.checked_cap == 0 { 16 } else { ri.checked_cap + ri.checked_cap };
        let new_arr = arena_alloc_raw(mut_view(*arena), bce_mul_usize(new_cap, size_of<CheckedNonWrapOp>()), align_of<CheckedNonWrapOp>()) as *mut CheckedNonWrapOp;
        if ri.checked_count > 0 && (ri.checked_ops as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(ri.checked_ops as *const u8, new_arr as *mut u8, bce_mul_usize(ri.checked_count, size_of<CheckedNonWrapOp>()));
            }
        }
        ri.checked_ops = new_arr;
        ri.checked_cap = new_cap;
    }
    unsafe {
        *bce_checked_at(ri.checked_ops, ri.checked_count) = CheckedNonWrapOp {
            bin_op: bop, lhs: lhs, rhs: rhs, valid_at_bb: at_bb,
        };
    }
    ri.checked_count = ri.checked_count + 1;
}

fn bce_push_length(ri: mut_view<RangeInfo>, arena: mut_view<Arena>, lf: view<LengthFact>) {
    if ri.length_count >= ri.length_cap {
        let new_cap: usize = if ri.length_cap == 0 { 16 } else { ri.length_cap + ri.length_cap };
        let new_arr = arena_alloc_raw(mut_view(*arena), bce_mul_usize(new_cap, size_of<LengthFact>()), align_of<LengthFact>()) as *mut LengthFact;
        if ri.length_count > 0 && (ri.lengths as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(ri.lengths as *const u8, new_arr as *mut u8, bce_mul_usize(ri.length_count, size_of<LengthFact>()));
            }
        }
        ri.lengths = new_arr;
        ri.length_cap = new_cap;
    }
    let dst = unsafe { bce_len_at(ri.lengths, ri.length_count) };
    unsafe {
        (*dst).val = lf.val;
        (*dst).kind = lf.kind;
        (*dst).root_local = lf.root_local;
        (*dst).src_local = lf.src_local;
        (*dst).const_len = lf.const_len;
        (*dst).def_bb = lf.def_bb;
        (*dst).def_inst_idx = lf.def_inst_idx;
        mir_copy_place(mut_view((*dst).region_place), view(lf.region_place));
        (*dst).is_readonly_view = lf.is_readonly_view;
        (*dst).is_sroa_ssa = lf.is_sroa_ssa;
    }
    ri.length_count = ri.length_count + 1;
}

fn bce_push_inline_vec(ri: mut_view<RangeInfo>, arena: mut_view<Arena>, ib: view<InlineVecBound>) {
    let mut k: usize = 0;
    while k < ri.inline_vec_count && (ri.inline_vec_bounds as usize) != 0 {
        let cur = unsafe { bce_inline_vec_at(ri.inline_vec_bounds, k) };
        if (unsafe { (*cur).idx_val.v }) == ib.idx_val.v &&
           (unsafe { (*cur).root_local }) == ib.root_local &&
           (unsafe { (*cur).cmp_bb.v }) == ib.cmp_bb.v &&
           (unsafe { (*cur).cmp_inst_idx }) == ib.cmp_inst_idx &&
           (unsafe { (*cur).valid_at_bb.v }) == ib.valid_at_bb.v {
            let ib_off = ib.rhs_offset;
            let cur_off = unsafe { (*cur).rhs_offset };
            if ib_off < cur_off {
                unsafe { (*cur).rhs_offset = ib_off; }
            }
            return;
        }
        k = k + 1;
    }
    if ri.inline_vec_count >= ri.inline_vec_cap {
        let new_cap: usize = if ri.inline_vec_cap == 0 { 8 } else { ri.inline_vec_cap + ri.inline_vec_cap };
        let new_arr = arena_alloc_raw(mut_view(*arena), bce_mul_usize(new_cap, size_of<InlineVecBound>()), align_of<InlineVecBound>()) as *mut InlineVecBound;
        if ri.inline_vec_count > 0 && (ri.inline_vec_bounds as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(ri.inline_vec_bounds as *const u8, new_arr as *mut u8, bce_mul_usize(ri.inline_vec_count, size_of<InlineVecBound>()));
            }
        }
        ri.inline_vec_bounds = new_arr;
        ri.inline_vec_cap = new_cap;
    }
    let dst = unsafe { bce_inline_vec_at(ri.inline_vec_bounds, ri.inline_vec_count) };
    unsafe {
        (*dst).idx_val = ib.idx_val;
        (*dst).rhs_offset = ib.rhs_offset;
        (*dst).root_local = ib.root_local;
        (*dst).src_local = ib.src_local;
        (*dst).cmp_bb = ib.cmp_bb;
        (*dst).cmp_inst_idx = ib.cmp_inst_idx;
        (*dst).valid_at_bb = ib.valid_at_bb;
        mir_copy_place(mut_view((*dst).region_place), view(ib.region_place));
    }
    ri.inline_vec_count = ri.inline_vec_count + 1;
}

fn bce_push_subslice(ri: mut_view<RangeInfo>, arena: mut_view<Arena>, sf: SubsliceRangeFact) {
    if ri.subslice_count >= ri.subslice_cap {
        let new_cap: usize = if ri.subslice_cap == 0 { 8 } else { ri.subslice_cap + ri.subslice_cap };
        let new_arr = arena_alloc_raw(mut_view(*arena), bce_mul_usize(new_cap, size_of<SubsliceRangeFact>()), align_of<SubsliceRangeFact>()) as *mut SubsliceRangeFact;
        if ri.subslice_count > 0 && (ri.subslices as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(ri.subslices as *const u8, new_arr as *mut u8, bce_mul_usize(ri.subslice_count, size_of<SubsliceRangeFact>()));
            }
        }
        ri.subslices = new_arr;
        ri.subslice_cap = new_cap;
    }
    unsafe { *bce_subslice_at(ri.subslices, ri.subslice_count) = sf; }
    ri.subslice_count = ri.subslice_count + 1;
}

fn bce_find_length_fact(ri: view<RangeInfo>, val: OptValueId) -> *mut LengthFact {
    if val.v == OPT_VALUE_NONE || (ri.lengths as usize) == 0 {
        return 0 as *mut LengthFact;
    }
    let mut i: usize = 0;
    while i < ri.length_count {
        let lf = unsafe { bce_len_at(ri.lengths, i) };
        if (unsafe { (*lf).val.v }) == val.v {
            return lf;
        }
        i = i + 1;
    }
    0 as *mut LengthFact
}

fn bce_find_subslice_for_local(ri: view<RangeInfo>, loc: u32) -> *mut SubsliceRangeFact {
    if (ri.subslices as usize) == 0 {
        return 0 as *mut SubsliceRangeFact;
    }
    let mut i: usize = 0;
    while i < ri.subslice_count {
        let sf = unsafe { bce_subslice_at(ri.subslices, i) };
        if (unsafe { (*sf).slice_local }) == loc {
            return sf;
        }
        i = i + 1;
    }
    0 as *mut SubsliceRangeFact
}

fn bce_block_in_cycle(body: view<OptBody>, start_v: u32, arena: mut_view<Arena>) -> bool {
    let n = body.bb_count;
    if (start_v as usize) >= n || n == 0 {
        return false;
    }
    let vis = arena_alloc_raw(mut_view(*arena), bce_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let q = arena_alloc_raw(mut_view(*arena), bce_mul_usize(n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut i: usize = 0;
    while i < n {
        unsafe { *opt_bool_at(vis, i) = false; }
        i = i + 1;
    }
    let sbb = unsafe { opt_block_at(body.blocks, start_v as usize) };
    let scnt = unsafe { (*sbb).succ_count };
    let mut q_head: usize = 0;
    let mut q_tail: usize = 0;
    let mut s: usize = 0;
    while s < scnt {
        let sv = unsafe { (*opt_bbid_at((*sbb).succs, s)).v };
        if sv == start_v {
            return true;
        }
        if (sv as usize) < n && !(unsafe { *opt_bool_at(vis, sv as usize) }) {
            unsafe {
                *opt_bool_at(vis, sv as usize) = true;
                *opt_u32_at(q, q_tail) = sv;
            }
            q_tail = q_tail + 1;
        }
        s = s + 1;
    }
    while q_head < q_tail {
        let cur = unsafe { *opt_u32_at(q, q_head) };
        q_head = q_head + 1;
        let cbb = unsafe { opt_block_at(body.blocks, cur as usize) };
        let cscnt = unsafe { (*cbb).succ_count };
        let mut cs: usize = 0;
        while cs < cscnt {
            let nsv = unsafe { (*opt_bbid_at((*cbb).succs, cs)).v };
            if nsv == start_v {
                return true;
            }
            if (nsv as usize) < n && !(unsafe { *opt_bool_at(vis, nsv as usize) }) {
                unsafe {
                    *opt_bool_at(vis, nsv as usize) = true;
                    *opt_u32_at(q, q_tail) = nsv;
                }
                q_tail = q_tail + 1;
            }
            cs = cs + 1;
        }
    }
    false
}

fn bce_body_has_barrier_clobber(body: view<OptBody>, call_table: *const EffectCallTable) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                if opc == OPT_INST_VOLATILE_STORE || opc == OPT_INST_ATOMIC ||
                   opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE {
                    return true;
                }
                i = i + 1;
            }
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) == OPT_TERM_CALL {
                let teff = effect_infer_term_with_table(body, unsafe { view((*bb).term) }, call_table);
                if (teff.flags & (EFFECT_FFI | EFFECT_VOLATILE | EFFECT_ATOMIC)) != 0u16 {
                    return true;
                }
            }
        }
        b = b + 1;
    }
    false
}

fn bce_local_immutable_at(
    body: view<OptBody>,
    info: *const AliasInfo,
    loc: u32,
    b1_v: u32,
    b2_v: u32,
    qbb_v: u32,
    arena: mut_view<Arena>
) -> bool {
    if (info as usize) == 0 || (loc as usize) >= (unsafe { (*info).local_count }) {
        return false;
    }
    let rprov = unsafe { alias_local_prov_at((*info).locals, loc as usize) };
    if (unsafe { (*rprov).mut_borrow_taken }) || (unsafe { (*rprov).raw_addr_exposed }) {
        return false;
    }
    let dc = unsafe { (*rprov).def_count };
    if dc > 1u32 {
        return false;
    }
    let mut def_bv: u32 = OPT_BB_NONE;
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let sk = unsafe { (*inst).orig_stmt.kind };
                let pl_loc = unsafe { (*inst).place.local.v };
                let pl_pc = unsafe { (*inst).place.proj_count };
                if sk == MIR_STMT_DROP && pl_loc == loc {
                    return false;
                }
                if sk == MIR_STMT_ASSIGN && (unsafe { (*inst).opcode }) != OPT_INST_NOP &&
                   (bce_place_writes_local_directly(unsafe { view((*inst).place) }, loc) ||
                    bce_place_writes_local_directly(unsafe { view((*inst).orig_stmt.place) }, loc)) {
                    if pl_pc != 0 || def_bv != OPT_BB_NONE {
                        return false;
                    }
                    def_bv = b as u32;
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_DROP && (unsafe { (*bb).term.drop_place.local.v }) == loc {
                    return false;
                }
                if tk == OPT_TERM_CALL && (unsafe { (*bb).term.has_call_dest }) &&
                   (unsafe { (*bb).term.call_dest.local.v }) == loc {
                    if (unsafe { (*bb).term.call_dest.proj_count }) != 0 || def_bv != OPT_BB_NONE {
                        return false;
                    }
                    def_bv = b as u32;
                }
            }
        }
        b = b + 1;
    }
    let is_param = loc >= 1u32 && (loc as usize) <= body.arg_count;
    if is_param {
        return dc == 1u32 && def_bv == OPT_BB_NONE;
    }
    if dc == 0u32 {
        return false;
    }
    if def_bv == OPT_BB_NONE || bce_block_in_cycle(body, def_bv, mut_view(*arena)) {
        return false;
    }
    let def_id = OptBbId { v: def_bv };
    let b1_id = OptBbId { v: b1_v };
    let b2_id = OptBbId { v: b2_v };
    let q_id = OptBbId { v: qbb_v };
    opt_dominates(body, def_id, b1_id) &&
    opt_dominates(body, def_id, b2_id) &&
    opt_dominates(body, def_id, q_id)
}

fn bce_op_is_non_ssa_mem_read(body: view<OptBody>, op: view<MirOperand>) -> bool {
    if op.kind == MIR_OP_CONST {
        return false;
    }
    let lv = op.place.local.v as usize;
    if lv >= body.local_count {
        return true;
    }
    let mode: u8 = if (body.local_modes as usize) != 0 {
        unsafe { *opt_u8_at(body.local_modes, lv) }
    } else {
        2u8
    };
    let addr_taken: bool = (body.local_addr_taken as usize) != 0 &&
                           (unsafe { *opt_bool_at(body.local_addr_taken, lv) });
    if op.place.proj_count == 0 {
        return mode != 0u8 || addr_taken;
    }
    if op.place.proj_count == 1 && (op.place.projs as usize) != 0 {
        let p0 = unsafe { mir_proj_at(op.place.projs, 0) };
        if (unsafe { (*p0).kind }) == MIR_PROJ_FIELD {
            let scnt: u32 = if (body.local_sroa_count as usize) != 0 {
                unsafe { *opt_u32_at(body.local_sroa_count, lv) }
            } else {
                0u32
            };
            return mode != OPT_LOCAL_SROA || addr_taken || (unsafe { (*p0).field_idx }) >= scnt;
        }
    }
    true
}

fn bce_op_is_vec_len(
    body: view<OptBody>,
    info: *const AliasInfo,
    op: view<MirOperand>,
    out_vec_loc: mut_view<u32>,
    out_rpl: mut_view<MirPlace>,
    out_is_ro: mut_view<bool>,
    arena: mut_view<Arena>
) -> bool {
    *out_vec_loc = 0xFFFFFFFFu32;
    *out_is_ro = false;
    if op.kind == MIR_OP_CONST || op.place.proj_count == 0 {
        return false;
    }
    let mut vec_loc: u32 = 0xFFFFFFFFu32;
    let mut matched = bce_place_is_vec_len_field(body, view(op.place), mut_view(vec_loc));
    if matched {
        mir_copy_place(mut_view(*out_rpl), view(op.place));
    } else if (info as usize) != 0 && op.place.proj_count == 1 && (op.place.projs as usize) != 0 {
        let rp0 = unsafe { mir_proj_at(op.place.projs, 0) };
        let rloc_u = op.place.local.v as usize;
        if (unsafe { (*rp0).kind }) == MIR_PROJ_DEREF && rloc_u < (unsafe { (*info).local_count }) {
            let rprov = unsafe { alias_local_prov_at((*info).locals, rloc_u) };
            if (unsafe { (*rprov).def_count }) == 1u32 && (unsafe { (*rprov).has_origin_place }) &&
               bce_place_is_vec_len_field(body, unsafe { view((*rprov).origin_place) }, mut_view(vec_loc)) {
                mir_copy_place(mut_view(*out_rpl), unsafe { view((*rprov).origin_place) });
                matched = true;
            }
        }
    }
    if !matched {
        return false;
    }
    *out_vec_loc = vec_loc;
    if (info as usize) != 0 {
        let vreg = alias_extract_region(unsafe { view(*info) }, body, view(*out_rpl), OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
        *out_is_ro = alias_is_view_readonly_region(unsafe { view(*info) }, body, view(vreg));
    }
    true
}

fn bce_lengths_equal_at(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    v1: OptValueId,
    v2: OptValueId,
    query_bb: u32,
    query_inst: u32,
    arena: mut_view<Arena>
) -> bool {
    let pv1 = lp_peel_copy_and_lcssa(body, v1);
    let pv2 = lp_peel_copy_and_lcssa(body, v2);
    if pv1.v != OPT_VALUE_NONE && pv1.v == pv2.v && (pv1.v as usize) <= body.value_count {
        let pvp = unsafe { opt_val_at(body.values, pv1.v as usize) };
        if opt_type_bits(body.thir, unsafe { (*pvp).ty }) > 0u32 {
            return true;
        }
    }
    let lf1 = bce_find_length_fact(ri, pv1);
    let lf2 = bce_find_length_fact(ri, pv2);
    if (lf1 as usize) == 0 || (lf2 as usize) == 0 {
        return false;
    }
    let k1 = unsafe { (*lf1).kind };
    let k2 = unsafe { (*lf2).kind };
    if k1 != k2 || k1 == LEN_KIND_NONE {
        return false;
    }
    if k1 == LEN_KIND_FIXED_ARRAY {
        return (unsafe { (*lf1).const_len }) == (unsafe { (*lf2).const_len });
    }
    // Distinct SROA-promoted SSA `.len` values (`pv1.v != pv2.v`) represent different SSA versions (e.g. across `v.len = 0` or join phis)
    if (unsafe { (*lf1).is_sroa_ssa }) || (unsafe { (*lf2).is_sroa_ssa }) {
        return false;
    }
    let r1 = unsafe { (*lf1).root_local };
    let r2 = unsafe { (*lf2).root_local };
    if r1 == 0xFFFFFFFFu32 || r1 != r2 {
        return false;
    }
    if (r1 as usize) < body.local_count && (body.local_modes as usize) != 0 &&
       (unsafe { *opt_u8_at(body.local_modes, r1 as usize) }) == OPT_LOCAL_SROA {
        return false;
    }
    let b1 = unsafe { (*lf1).def_bb.v };
    let i1 = unsafe { (*lf1).def_inst_idx };
    let s1 = unsafe { (*lf1).src_local };
    let b2 = unsafe { (*lf2).def_bb.v };
    let i2 = unsafe { (*lf2).def_inst_idx };
    let s2 = unsafe { (*lf2).src_local };
    let check_mem = k1 == LEN_KIND_VEC_LEN;

    let id_b1 = OptBbId { v: b1 };
    let id_b2 = OptBbId { v: b2 };
    if opt_dominates(body, id_b1, id_b2) && (b1 != b2 || i1 <= i2) {
        if !bce_path_unclobbered_between(body, info, call_table, b1, i1, b2, i2, r1, s1, s2, check_mem, unsafe { view((*lf1).region_place) }, mut_view(*arena)) {
            return false;
        }
        return bce_path_unclobbered_between(body, info, call_table, b2, i2, query_bb, query_inst, r1, s2, s2, check_mem, unsafe { view((*lf2).region_place) }, mut_view(*arena));
    }
    if opt_dominates(body, id_b2, id_b1) && (b1 != b2 || i2 <= i1) {
        if !bce_path_unclobbered_between(body, info, call_table, b2, i2, b1, i1, r1, s2, s1, check_mem, unsafe { view((*lf2).region_place) }, mut_view(*arena)) {
            return false;
        }
        return bce_path_unclobbered_between(body, info, call_table, b1, i1, query_bb, query_inst, r1, s1, s1, check_mem, unsafe { view((*lf1).region_place) }, mut_view(*arena));
    }
    if !check_mem && (k1 == LEN_KIND_SLICE_VIEW || !bce_body_has_barrier_clobber(body, call_table)) {
        if bce_local_immutable_at(body, info, r1, b1, b2, query_bb, mut_view(*arena)) &&
           (s1 == r1 || bce_local_immutable_at(body, info, s1, b1, b2, query_bb, mut_view(*arena))) &&
           (s2 == r1 || bce_local_immutable_at(body, info, s2, b1, b2, query_bb, mut_view(*arena))) {
            return true;
        }
    }
    false
}

fn bce_collect_length_and_subslice_facts(
    ri: mut_view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    arena: mut_view<Arena>
) {
    // 1. First pass: discover single-def `SubsliceRangeFact`s (`_sub = & (*s)[from..to]` / `& a[from..to]`)
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                if opc == OPT_INST_ADDR_OF && (unsafe { (*inst).place.proj_count }) == 0 {
                    let dst_loc = unsafe { (*inst).place.local.v };
                    let rpl = unsafe { view((*inst).rhs_place) };
                    if (rpl.proj_count == 1 || rpl.proj_count == 2) && (rpl.projs as usize) != 0 &&
                       bce_local_is_single_def_unescaped(body, info, dst_loc) {
                        let last_p = unsafe { mir_proj_at(rpl.projs, rpl.proj_count - 1) };
                        let mut only_deref_prefix = true;
                        let mut pk_idx: usize = 0;
                        while pk_idx + 1 < rpl.proj_count {
                            let pp = unsafe { mir_proj_at(rpl.projs, pk_idx) };
                            if (unsafe { (*pp).kind }) != MIR_PROJ_DEREF {
                                only_deref_prefix = false;
                            }
                            pk_idx = pk_idx + 1;
                        }
                        if only_deref_prefix && (unsafe { (*last_p).kind }) == MIR_PROJ_SUB_SLICE {
                            let base_lu = rpl.local.v as usize;
                            let mut base_valid = false;
                            let mut root_loc: u32 = 0xFFFFFFFFu32;
                            let mut b_ssa = OptValueId { v: OPT_VALUE_NONE };
                            let mut is_arr = false;
                            if rpl.proj_count == 1 {
                                if base_lu < body.local_count && (body.local_tys as usize) != 0 &&
                                   bce_type_kind(body.thir, unsafe { *opt_typeid_at(body.local_tys, base_lu) }) == TY_ARRAY &&
                                   (info as usize) != 0 && base_lu < (unsafe { (*info).local_count }) {
                                    let bprov = unsafe { alias_local_prov_at((*info).locals, base_lu) };
                                    if !(unsafe { (*bprov).raw_addr_exposed }) {
                                        root_loc = rpl.local.v;
                                        is_arr = true;
                                        base_valid = true;
                                    }
                                }
                            } else if (info as usize) != 0 && base_lu < (unsafe { (*info).local_count }) {
                                let bprov = unsafe { alias_local_prov_at((*info).locals, base_lu) };
                                if !(unsafe { (*bprov).mut_borrow_taken }) && !(unsafe { (*bprov).raw_addr_exposed }) {
                                    root_loc = bce_resolve_root_local_chain(body, info, rpl.local.v);
                                    let rlu = root_loc as usize;
                                    if rlu < body.local_count && (body.local_tys as usize) != 0 &&
                                       bce_type_kind(body.thir, unsafe { *opt_typeid_at(body.local_tys, rlu) }) == TY_ARRAY &&
                                       rlu < (unsafe { (*info).local_count }) {
                                        let rprov = unsafe { alias_local_prov_at((*info).locals, rlu) };
                                        if !(unsafe { (*rprov).raw_addr_exposed }) {
                                            is_arr = true;
                                            base_valid = true;
                                        }
                                    } else {
                                        let ssa_loc: u32 = if root_loc == rpl.local.v { rpl.local.v } else { root_loc };
                                        let resolved_b = bce_resolve_ssa_local_at(body, info, ssa_loc, b, i, mut_view(*arena));
                                        if resolved_b.v != OPT_VALUE_NONE {
                                            b_ssa = lp_peel_copy_and_lcssa(body, resolved_b);
                                            base_valid = b_ssa.v != OPT_VALUE_NONE;
                                        }
                                    }
                                }
                            }
                            let has_from = unsafe { (*last_p).has_from };
                            let has_to = unsafe { (*last_p).has_to };
                            let sv: OptValueId = if has_from {
                                bce_resolve_ssa_local_at(body, info, unsafe { (*last_p).from_local.v }, b, i, mut_view(*arena))
                            } else {
                                OptValueId { v: OPT_VALUE_NONE }
                            };
                            let ev: OptValueId = if has_to {
                                bce_resolve_ssa_local_at(body, info, unsafe { (*last_p).to_local.v }, b, i, mut_view(*arena))
                            } else {
                                OptValueId { v: OPT_VALUE_NONE }
                            };
                            if base_valid && (!has_from || sv.v != OPT_VALUE_NONE) && (!has_to || ev.v != OPT_VALUE_NONE) {
                                bce_push_subslice(mut_view(*ri), mut_view(*arena), SubsliceRangeFact {
                                    slice_local: dst_loc,
                                    root_local: root_loc,
                                    def_bb: OptBbId { v: b as u32 },
                                    def_inst_idx: i as u32,
                                    base_ssa: b_ssa,
                                    is_array_root: is_arr,
                                    has_start: has_from,
                                    start_val: sv,
                                    has_end: has_to,
                                    end_val: ev,
                                });
                            }
                        }
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }

    // 2. Second pass: discover `OPT_INST_LEN` (`LEN_KIND_SLICE_VIEW`) and `Vec<T>.len` (`LEN_KIND_VEC_LEN`)
    b = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                let res_v = lp_peel_copy_and_lcssa(body, unsafe { (*inst).result });
                if res_v.v != OPT_VALUE_NONE {
                    if opc == OPT_INST_LEN && (unsafe { (*inst).rhs_place.proj_count }) == 0 {
                        let src_loc = unsafe { (*inst).rhs_place.local.v };
                        let root_loc = bce_resolve_root_local_chain(body, info, src_loc);
                        let lf = LengthFact {
                            val: res_v, kind: LEN_KIND_SLICE_VIEW, root_local: root_loc, src_local: src_loc,
                            const_len: 0u64, def_bb: OptBbId { v: b as u32 }, def_inst_idx: i as u32,
                            region_place: mir_local_place(src_loc), is_readonly_view: true, is_sroa_ssa: false,
                        };
                        bce_push_length(mut_view(*ri), mut_view(*arena), view(lf));
                        // Link sub-slice length `[0..mid)` -> `len(sub) == mid`, or `[c_s..c_e)` -> `len(sub) == c_e - c_s`
                        let sf = bce_find_subslice_for_local(view(*ri), root_loc);
                        let vbb = OptBbId { v: b as u32 };
                        if (sf as usize) != 0 &&
                           bce_local_is_single_def_unescaped(body, info, src_loc) &&
                           opt_dominates(body, unsafe { (*sf).def_bb }, vbb) &&
                           ((unsafe { (*sf).def_bb.v }) != (b as u32) || (unsafe { (*sf).def_inst_idx }) < (i as u32)) &&
                           bce_scalar_local_unclobbered_from_def(
                               body, BCE_DEF_INST,
                               (unsafe { (*sf).def_bb.v }) as usize,
                               (unsafe { (*sf).def_inst_idx }) as usize,
                               b, i, unsafe { (*sf).slice_local }, mut_view(*arena)
                           ) {
                            let mut start_is_zero = !(unsafe { (*sf).has_start });
                            let mut cs_u: u64 = 1u64;
                            let mut cs_i: i64 = 1i64;
                            let start_const = (unsafe { (*sf).has_start }) &&
                                              (unsafe { (*sf).start_val.v }) != OPT_VALUE_NONE &&
                                              lp_val_const_int(body, unsafe { (*sf).start_val }, mut_view(cs_u), mut_view(cs_i));
                            if !start_is_zero && start_const && cs_u == 0u64 && cs_i == 0i64 {
                                start_is_zero = true;
                            }
                            if start_is_zero && (unsafe { (*sf).has_end }) && (unsafe { (*sf).end_val.v }) != OPT_VALUE_NONE {
                                let ev = unsafe { (*sf).end_val };
                                bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                                    lhs: res_v, rhs_base: ev, rhs_offset: 0i64, rel: BOUND_LE, certainty: CERTAINTY_PROVEN, valid_at_bb: vbb,
                                });
                                bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                                    lhs: ev, rhs_base: res_v, rhs_offset: 0i64, rel: BOUND_LE, certainty: CERTAINTY_PROVEN, valid_at_bb: vbb,
                                });
                            } else if start_const && cs_i >= 0i64 &&
                                      (unsafe { (*sf).has_end }) && (unsafe { (*sf).end_val.v }) != OPT_VALUE_NONE {
                                let mut ce_u: u64 = 0u64;
                                let mut ce_i: i64 = 0i64;
                                if lp_val_const_int(body, unsafe { (*sf).end_val }, mut_view(ce_u), mut_view(ce_i)) &&
                                   ce_i >= cs_i {
                                    let sub_len = ce_i - cs_i;
                                    bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                                        lhs: res_v, rhs_base: OptValueId { v: OPT_VALUE_NONE }, rhs_offset: sub_len,
                                        rel: BOUND_LE, certainty: CERTAINTY_PROVEN, valid_at_bb: vbb,
                                    });
                                    bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                                        lhs: res_v, rhs_base: OptValueId { v: OPT_VALUE_NONE }, rhs_offset: sub_len,
                                        rel: BOUND_GE, certainty: CERTAINTY_PROVEN, valid_at_bb: vbb,
                                    });
                                }
                            }
                        }
                    } else if (opc == OPT_INST_EXTRACT_FIELD && (unsafe { (*inst).sub_op }) == 1u8) || opc == OPT_INST_LOAD {
                        let mut vec_loc: u32 = 0xFFFFFFFFu32;
                        let mut rpl = mir_local_place(0u32);
                        let mut matched_vec = bce_place_is_vec_len_field(body, unsafe { view((*inst).rhs_place) }, mut_view(vec_loc));
                        if matched_vec {
                            mir_copy_place(mut_view(rpl), unsafe { view((*inst).rhs_place) });
                        } else if (info as usize) != 0 && (unsafe { (*inst).rhs_place.proj_count }) == 1 &&
                                  ((unsafe { (*inst).rhs_place.projs }) as usize) != 0 {
                            let rp0 = unsafe { mir_proj_at((*inst).rhs_place.projs, 0) };
                            let rloc_u = (unsafe { (*inst).rhs_place.local.v }) as usize;
                            if (unsafe { (*rp0).kind }) == MIR_PROJ_DEREF && rloc_u < (unsafe { (*info).local_count }) {
                                let rprov = unsafe { alias_local_prov_at((*info).locals, rloc_u) };
                                if (unsafe { (*rprov).def_count }) == 1u32 && (unsafe { (*rprov).has_origin_place }) &&
                                   bce_place_is_vec_len_field(body, unsafe { view((*rprov).origin_place) }, mut_view(vec_loc)) {
                                    mir_copy_place(mut_view(rpl), unsafe { view((*rprov).origin_place) });
                                    matched_vec = true;
                                }
                            }
                        }
                        if matched_vec {
                            let root_loc = bce_resolve_root_local_chain(body, info, vec_loc);
                            let lf = LengthFact {
                                val: res_v, kind: LEN_KIND_VEC_LEN, root_local: root_loc, src_local: vec_loc,
                                const_len: 0u64, def_bb: OptBbId { v: b as u32 }, def_inst_idx: i as u32,
                                region_place: rpl, is_readonly_view: false, is_sroa_ssa: false,
                            };
                            bce_push_length(mut_view(*ri), mut_view(*arena), view(lf));
                        }
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }

    // 3. Also register SROA-promoted `Vec<T>.len` values (`proj_field == 1`) and `OPT_VAL_CONST` `usize` array lengths
    let mut v: usize = 1;
    while v <= body.value_count {
        let vp = unsafe { opt_val_at(body.values, v) };
        let vk = unsafe { (*vp).kind };
        if vk == OPT_VAL_CONST && (unsafe { (*vp).const_val.kind }) == MIR_CONST_INT {
            if !opt_type_is_signed(body.thir, unsafe { (*vp).ty }) && opt_type_bits(body.thir, unsafe { (*vp).ty }) == 64u32 {
                let lf = LengthFact {
                    val: OptValueId { v: v as u32 }, kind: LEN_KIND_FIXED_ARRAY,
                    root_local: 0xFFFFFFFFu32, src_local: 0xFFFFFFFFu32,
                    const_len: unsafe { (*vp).const_val.val },
                    def_bb: OptBbId { v: 0u32 }, def_inst_idx: 0u32,
                    region_place: mir_local_place(0u32), is_readonly_view: true, is_sroa_ssa: false,
                };
                bce_push_length(mut_view(*ri), mut_view(*arena), view(lf));
            }
        } else if (unsafe { (*vp).proj_field }) == 1u32 {
            let slv = (unsafe { (*vp).src_local.v }) as usize;
            if slv < body.local_count && (body.local_modes as usize) != 0 &&
               (unsafe { *opt_u8_at(body.local_modes, slv) }) == OPT_LOCAL_SROA &&
               bce_type_is_vec_struct(body.thir, unsafe { *opt_typeid_at(body.local_tys, slv) }) {
                let lf = LengthFact {
                    val: OptValueId { v: v as u32 }, kind: LEN_KIND_VEC_LEN,
                    root_local: slv as u32, src_local: slv as u32, const_len: 0u64,
                    def_bb: unsafe { (*vp).def_bb }, def_inst_idx: 0u32,
                    region_place: mir_local_place(slv as u32), is_readonly_view: false, is_sroa_ssa: true,
                };
                bce_push_length(mut_view(*ri), mut_view(*arena), view(lf));
            }
        }
        v = v + 1;
    }
}

// --- Structural `ValueRange` Initialization & Non-Negative Proofs (SPEC-72 §2.1, AXS-BCE-003) ---

fn bce_init_value_ranges(ri: mut_view<RangeInfo>, body: view<OptBody>, arena: mut_view<Arena>) {
    let cap = body.value_count + 2;
    ri.value_cap = cap;
    ri.value_ranges = arena_alloc_raw(mut_view(*arena), bce_mul_usize(cap, size_of<ValueRange>()), align_of<ValueRange>()) as *mut ValueRange;

    let mut v: usize = 0;
    while v < cap {
        let vr = unsafe { bce_range_at(ri.value_ranges, v) };
        unsafe {
            (*vr).has_range = false;
            (*vr).is_signed = true;
            (*vr).lo = 0u64;
            (*vr).hi = 0u64;
            (*vr).known_zeros = 0u64;
            (*vr).known_ones = 0u64;
            (*vr).non_negative_proven = false;
            (*vr).certainty = CERTAINTY_UNKNOWN;
        }
        if v >= 1 && v <= body.value_count {
            let vp = unsafe { opt_val_at(body.values, v) };
            let ty_v = unsafe { (*vp).ty.v };
            let bits = opt_type_bits(body.thir, TypeId { v: ty_v });
            if bits > 0u32 && bits <= 64u32 {
                let is_sig = opt_type_is_signed(body.thir, TypeId { v: ty_v });
                let mask = opt_bit_mask(bits);
                unsafe { (*vr).is_signed = is_sig; }
                if (unsafe { (*vp).kind }) == OPT_VAL_CONST && (unsafe { (*vp).const_val.kind }) == MIR_CONST_INT {
                    let raw = (unsafe { (*vp).const_val.val }) & mask;
                    let non_neg = !is_sig || !opt_signed_lt(opt_sign_extend_u64(raw, bits), 0u64);
                    unsafe {
                        (*vr).has_range = true;
                        (*vr).lo = raw;
                        (*vr).hi = raw;
                        (*vr).known_ones = raw;
                        (*vr).known_zeros = mask ^ raw;
                        (*vr).non_negative_proven = non_neg;
                        (*vr).certainty = CERTAINTY_PROVEN;
                    }
                } else if !is_sig {
                    unsafe {
                        (*vr).has_range = true;
                        (*vr).lo = 0u64;
                        (*vr).hi = mask;
                        (*vr).non_negative_proven = true;
                        (*vr).certainty = CERTAINTY_PROVEN;
                    }
                }
            }
        }
        v = v + 1;
    }

    // Two RPO sweeps propagating `idx & mask`, unsigned `% d`, unsigned `>> sh`, copies, and widening casts
    let mut pass: usize = 0;
    while pass < 2 {
        let mut r: usize = 0;
        while r < body.rpo_count && (body.rpo_order as usize) != 0 {
            let b_v = (unsafe { (*opt_bbid_at(body.rpo_order, r)).v }) as usize;
            if b_v < body.bb_count {
                let bb = unsafe { opt_block_at(body.blocks, b_v) };
                let icnt = unsafe { (*bb).inst_count };
                let mut i: usize = 0;
                while i < icnt {
                    let inst = unsafe { opt_inst_at((*bb).insts, i) };
                    let opc = unsafe { (*inst).opcode };
                    let res_id = unsafe { (*inst).result };
                    if (res_id.v as usize) >= 1 && (res_id.v as usize) <= body.value_count {
                        let dst_vr = unsafe { bce_range_at(ri.value_ranges, res_id.v as usize) };
                        let dst_ty_v = unsafe { (*inst).ty.v };
                        let dst_bits = opt_type_bits(body.thir, TypeId { v: dst_ty_v });
                        let dst_sig = opt_type_is_signed(body.thir, TypeId { v: dst_ty_v });
                        if opc == OPT_INST_COPY && ((unsafe { (*inst).lhs.v }) as usize) <= body.value_count && (unsafe { (*inst).lhs.v }) != OPT_VALUE_NONE {
                            let src_vr = unsafe { bce_range_at(ri.value_ranges, (*inst).lhs.v as usize) };
                            if unsafe { (*src_vr).has_range } {
                                unsafe { *dst_vr = *src_vr; }
                            }
                        } else if opc == OPT_INST_BINOP && dst_bits > 0u32 && dst_bits <= 64u32 {
                            let bop = unsafe { (*inst).sub_op };
                            let lv = lp_peel_copy(body, unsafe { (*inst).lhs });
                            let rv = lp_peel_copy(body, unsafe { (*inst).rhs });
                            if bop == MIR_BINOP_BIT_AND && (lv.v as usize) <= body.value_count && (rv.v as usize) <= body.value_count {
                                let lvr = unsafe { bce_range_at(ri.value_ranges, lv.v as usize) };
                                let rvr = unsafe { bce_range_at(ri.value_ranges, rv.v as usize) };
                                let l_nn = (unsafe { (*lvr).has_range }) && (unsafe { (*lvr).non_negative_proven });
                                let r_nn = (unsafe { (*rvr).has_range }) && (unsafe { (*rvr).non_negative_proven });
                                if l_nn || r_nn {
                                    let mut cap_hi = opt_bit_mask(dst_bits);
                                    if l_nn && (unsafe { (*lvr).hi }) < cap_hi {
                                        cap_hi = unsafe { (*lvr).hi };
                                    }
                                    if r_nn && (unsafe { (*rvr).hi }) < cap_hi {
                                        cap_hi = unsafe { (*rvr).hi };
                                    }
                                    unsafe {
                                        (*dst_vr).has_range = true;
                                        (*dst_vr).is_signed = dst_sig;
                                        (*dst_vr).lo = 0u64;
                                        (*dst_vr).hi = cap_hi;
                                        (*dst_vr).non_negative_proven = true;
                                        (*dst_vr).certainty = CERTAINTY_PROVEN;
                                    }
                                }
                            } else if bop == MIR_BINOP_REM && !dst_sig {
                                let mut d_u: u64 = 0u64;
                                let mut d_i: i64 = 0i64;
                                if lp_val_const_int(body, rv, mut_view(d_u), mut_view(d_i)) && d_u > 0u64 {
                                    unsafe {
                                        (*dst_vr).has_range = true;
                                        (*dst_vr).lo = 0u64;
                                        (*dst_vr).hi = d_u - 1u64;
                                        (*dst_vr).non_negative_proven = true;
                                        (*dst_vr).certainty = CERTAINTY_PROVEN;
                                    }
                                }
                            } else if bop == MIR_BINOP_SHR && !dst_sig && (lv.v as usize) <= body.value_count {
                                let mut sh_u: u64 = 0u64;
                                let mut sh_i: i64 = 0i64;
                                if lp_val_const_int(body, rv, mut_view(sh_u), mut_view(sh_i)) && sh_u < (dst_bits as u64) {
                                    let lvr = unsafe { bce_range_at(ri.value_ranges, lv.v as usize) };
                                    let hi_in: u64 = if unsafe { (*lvr).has_range } { unsafe { (*lvr).hi } } else { opt_bit_mask(dst_bits) };
                                    unsafe {
                                        (*dst_vr).has_range = true;
                                        (*dst_vr).lo = 0u64;
                                        (*dst_vr).hi = hi_in >> sh_u;
                                        (*dst_vr).non_negative_proven = true;
                                        (*dst_vr).certainty = CERTAINTY_PROVEN;
                                    }
                                }
                            }
                        } else if opc == OPT_INST_CAST && (unsafe { (*inst).sub_op }) == MIR_CAST_INT_TO_INT &&
                                  dst_bits > 0u32 && dst_bits <= 64u32 {
                            let sv = lp_peel_copy(body, unsafe { (*inst).lhs });
                            if sv.v != OPT_VALUE_NONE && (sv.v as usize) <= body.value_count {
                                let svp = unsafe { opt_val_at(body.values, sv.v as usize) };
                                let src_bits = opt_type_bits(body.thir, unsafe { (*svp).ty });
                                let svr = unsafe { bce_range_at(ri.value_ranges, sv.v as usize) };
                                if src_bits > 0u32 && src_bits <= 64u32 &&
                                   (unsafe { (*svr).has_range }) && (unsafe { (*svr).non_negative_proven }) {
                                    let dst_max: u64 = if dst_sig {
                                        opt_bit_mask(dst_bits) ^ opt_sign_bit_mask(dst_bits)
                                    } else {
                                        opt_bit_mask(dst_bits)
                                    };
                                    if (dst_bits > src_bits && (!dst_sig || src_bits < dst_bits)) ||
                                       (unsafe { (*svr).hi }) <= dst_max {
                                        unsafe {
                                            (*dst_vr).has_range = true;
                                            (*dst_vr).is_signed = dst_sig;
                                            (*dst_vr).lo = (*svr).lo;
                                            (*dst_vr).hi = (*svr).hi;
                                            (*dst_vr).non_negative_proven = true;
                                            (*dst_vr).certainty = CERTAINTY_PROVEN;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
            }
            r = r + 1;
        }
        pass = pass + 1;
    }
}

pub fn bce_is_non_negative_proven(ri: view<RangeInfo>, body: view<OptBody>, val_id: OptValueId, query_bb: OptBbId) -> bool {
    let pv = lp_peel_copy(body, val_id);
    if pv.v == OPT_VALUE_NONE || (pv.v as usize) > body.value_count {
        return false;
    }
    let vp = unsafe { opt_val_at(body.values, pv.v as usize) };
    let bits = opt_type_bits(body.thir, unsafe { (*vp).ty });
    if bits > 0u32 && !opt_type_is_signed(body.thir, unsafe { (*vp).ty }) {
        return true;
    }
    if (pv.v as usize) < ri.value_cap && (ri.value_ranges as usize) != 0 {
        let vr = unsafe { bce_range_at(ri.value_ranges, pv.v as usize) };
        if (unsafe { (*vr).has_range }) && (unsafe { (*vr).non_negative_proven }) {
            return true;
        }
    }
    let mut i: usize = 0;
    while i < ri.nonneg_count && (ri.nonneg_facts as usize) != 0 {
        let nf = unsafe { bce_nonneg_at(ri.nonneg_facts, i) };
        if (unsafe { (*nf).val.v }) == pv.v {
            let vbb = unsafe { (*nf).valid_at_bb };
            if vbb.v == OPT_BB_NONE || opt_dominates(body, vbb, query_bb) {
                return true;
            }
        }
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < ri.bound_count && (ri.bounds as usize) != 0 {
        let sb = unsafe { bce_bound_at(ri.bounds, j) };
        if (unsafe { (*sb).lhs.v }) == pv.v &&
           (unsafe { (*sb).rhs_base.v }) == OPT_VALUE_NONE &&
           (unsafe { (*sb).rel }) == BOUND_GE &&
           (unsafe { (*sb).rhs_offset }) >= 0i64 {
            let vbb = unsafe { (*sb).valid_at_bb };
            if vbb.v == OPT_BB_NONE || opt_dominates(body, vbb, query_bb) {
                return true;
            }
        }
        j = j + 1;
    }
    false
}

fn bce_single_reachable_pred(body: view<OptBody>, dst_bb_v: u32) -> u32 {
    if (dst_bb_v as usize) >= body.bb_count {
        return OPT_BB_NONE;
    }
    let dbb = unsafe { opt_block_at(body.blocks, dst_bb_v as usize) };
    if !(unsafe { (*dbb).is_reachable }) {
        return OPT_BB_NONE;
    }
    let pcnt = unsafe { (*dbb).pred_count };
    let mut found = OPT_BB_NONE;
    let mut p: usize = 0;
    while p < pcnt {
        let pv = unsafe { (*opt_bbid_at((*dbb).preds, p)).v };
        if (pv as usize) < body.bb_count {
            let pbb = unsafe { opt_block_at(body.blocks, pv as usize) };
            if unsafe { (*pbb).is_reachable } {
                if found != OPT_BB_NONE && found != pv {
                    return OPT_BB_NONE;
                }
                found = pv;
            }
        }
        p = p + 1;
    }
    found
}

// --- SCEV Induction-Variable Bounds Extraction (SPEC-72 §2.2, AXS-BCE-004, REQ-OPT-139) ---

fn bce_collect_scev_facts(
    ri: mut_view<RangeInfo>,
    body: view<OptBody>,
    loop_tree: *const LoopTree,
    arena: mut_view<Arena>
) {
    if (loop_tree as usize) == 0 || (unsafe { (*loop_tree).loops as usize }) == 0 {
        return;
    }
    let lcnt = unsafe { (*loop_tree).loop_count };
    let mut li: usize = 0;
    while li < lcnt {
        let lp = unsafe { loop_desc_at((*loop_tree).loops, li) };
        if !(unsafe { (*lp).is_irreducible }) {
            let hdr = unsafe { (*lp).header };
            let ivc = unsafe { (*lp).iv_count };
            let mut k: usize = 0;
            while k < ivc && ((unsafe { (*lp).ivs }) as usize) != 0 {
                let iv = unsafe { loop_iv_at((*lp).ivs, k) };
                if unsafe { (*iv).no_wrap_proven } {
                    let s_idx = (unsafe { (*iv).start_expr }) as usize;
                    let step_c = unsafe { (*iv).step_const };
                    let iv_val = lp_peel_copy(body, unsafe { (*iv).ssa_val });
                    let has_start = s_idx < (unsafe { (*loop_tree).scev_count }) && ((unsafe { (*loop_tree).scev_pool }) as usize) != 0;
                    if step_c >= 0i64 && has_start {
                        let se = unsafe { scev_expr_at((*loop_tree).scev_pool, s_idx) };
                        let sk = unsafe { (*se).kind };
                        if sk == SCEV_CONST && (unsafe { (*se).const_val }) >= 0i64 && (unsafe { (*iv).is_primary }) {
                            let sc = unsafe { (*se).const_val };
                            bce_push_nonneg(mut_view(*ri), mut_view(*arena), iv_val, hdr);
                            bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                                lhs: iv_val, rhs_base: OptValueId { v: OPT_VALUE_NONE }, rhs_offset: sc,
                                rel: BOUND_GE, certainty: CERTAINTY_PROVEN, valid_at_bb: hdr,
                            });
                            if (unsafe { (*lp).trip_count.kind }) == TRIP_CONST &&
                               (unsafe { (*lp).trip_count.certainty }) == CERTAINTY_PROVEN &&
                               (unsafe { (*lp).trip_count.const_iters }) > 0u64 &&
                               (unsafe { (*lp).exiting_count }) == 1 &&
                               (unsafe { (*opt_bbid_at((*lp).exiting_blocks, 0)).v }) == hdr.v {
                                let iters_m1 = (unsafe { (*lp).trip_count.const_iters }) - 1u64;
                                let mut prod: u64 = 0u64;
                                let mut max_v: u64 = 0u64;
                                if !opt_checked_mul_u64(iters_m1, step_c as u64, 64u32, mut_view(prod)) &&
                                   !opt_checked_add_u64(sc as u64, prod, 64u32, mut_view(max_v)) &&
                                   max_v <= 0x7FFFFFFFFFFFFFFFu64 {
                                    // Valid inside body blocks strictly dominated by header's in-loop successor
                                    let hbb = unsafe { opt_block_at(body.blocks, hdr.v as usize) };
                                    let mut hs: usize = 0;
                                    while hs < (unsafe { (*hbb).succ_count }) {
                                        let sv = unsafe { (*opt_bbid_at((*hbb).succs, hs)).v };
                                        if bce_single_reachable_pred(body, sv) == hdr.v {
                                            // Check `sv` is inside loop `lp`
                                            let mut in_lp = false;
                                            let mut bi: usize = 0;
                                            while bi < (unsafe { (*lp).block_count }) {
                                                if (unsafe { (*opt_bbid_at((*lp).blocks, bi)).v }) == sv {
                                                    in_lp = true;
                                                }
                                                bi = bi + 1;
                                            }
                                            if in_lp {
                                                bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                                                    lhs: iv_val, rhs_base: OptValueId { v: OPT_VALUE_NONE },
                                                    rhs_offset: max_v as i64, rel: BOUND_LE,
                                                    certainty: CERTAINTY_PROVEN, valid_at_bb: OptBbId { v: sv },
                                                });
                                            }
                                        }
                                        hs = hs + 1;
                                    }
                                }
                            }
                        } else if sk == SCEV_INVARIANT && (unsafe { (*iv).is_primary }) &&
                                  bce_is_non_negative_proven(view(*ri), body, unsafe { (*se).ssa_val }, hdr) {
                            bce_push_nonneg(mut_view(*ri), mut_view(*arena), iv_val, hdr);
                        }
                    } else if step_c < 0i64 && has_start && (unsafe { (*iv).is_primary }) {
                        let am = unsafe { (*iv).arith_mode };
                        if am == ARITH_CHECKED || am == ARITH_PROVEN_NSW_NUW {
                            let se = unsafe { scev_expr_at((*loop_tree).scev_pool, s_idx) };
                            let sk = unsafe { (*se).kind };
                            if sk == SCEV_INVARIANT && (unsafe { (*se).ssa_val.v }) != OPT_VALUE_NONE {
                                let sv = lp_peel_copy(body, unsafe { (*se).ssa_val });
                                bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                                    lhs: iv_val, rhs_base: sv, rhs_offset: 0i64,
                                    rel: BOUND_LE, certainty: CERTAINTY_PROVEN, valid_at_bb: hdr,
                                });
                            } else if sk == SCEV_CONST && (unsafe { (*se).const_val }) >= 0i64 {
                                bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                                    lhs: iv_val, rhs_base: OptValueId { v: OPT_VALUE_NONE },
                                    rhs_offset: unsafe { (*se).const_val }, rel: BOUND_LE,
                                    certainty: CERTAINTY_PROVEN, valid_at_bb: hdr,
                                });
                            }
                        }
                    }
                }
                k = k + 1;
            }
        }
        li = li + 1;
    }
}

// --- Non-Wrapping Affine Decomposition & Dominating Guard Extraction (AXS-BCE-003) ---

fn bce_invert_int_cmp(bop: u8, out_op: mut_view<u8>) -> bool {
    if bop == MIR_BINOP_LT { *out_op = MIR_BINOP_GE; return true; }
    if bop == MIR_BINOP_LE { *out_op = MIR_BINOP_GT; return true; }
    if bop == MIR_BINOP_GT { *out_op = MIR_BINOP_LE; return true; }
    if bop == MIR_BINOP_GE { *out_op = MIR_BINOP_LT; return true; }
    if bop == MIR_BINOP_EQ { *out_op = MIR_BINOP_NE; return true; }
    if bop == MIR_BINOP_NE { *out_op = MIR_BINOP_EQ; return true; }
    false
}

fn bce_has_checked_nonwrap(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    bop: u8,
    lhs: OptValueId,
    rhs: OptValueId,
    query_bb: OptBbId
) -> bool {
    let pl = lp_peel_copy(body, lhs);
    let pr = lp_peel_copy(body, rhs);
    let mut c_r_u: u64 = 0u64;
    let mut c_r_i: i64 = 0i64;
    let r_is_const = lp_val_const_int(body, pr, mut_view(c_r_u), mut_view(c_r_i));

    let mut i: usize = 0;
    while i < ri.checked_count && (ri.checked_ops as usize) != 0 {
        let co = unsafe { bce_checked_at(ri.checked_ops, i) };
        if (unsafe { (*co).bin_op }) == bop {
            let vbb = unsafe { (*co).valid_at_bb };
            if vbb.v == OPT_BB_NONE || opt_dominates(body, vbb, query_bb) {
                let cl = unsafe { (*co).lhs };
                let cr = unsafe { (*co).rhs };
                let mut rhs_eq = cr.v == pr.v;
                if !rhs_eq && r_is_const {
                    let mut cu2: u64 = 0u64;
                    let mut ci2: i64 = 0i64;
                    if lp_val_const_int(body, cr, mut_view(cu2), mut_view(ci2)) && cu2 == c_r_u {
                        rhs_eq = true;
                    }
                }
                if cl.v == pl.v && rhs_eq {
                    return true;
                }
                if bop == MIR_BINOP_ADD && cr.v == pl.v && cl.v == pr.v {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    false
}

fn bce_unwrap_cast_nonneg(ri: view<RangeInfo>, body: view<OptBody>, val_id: OptValueId, query_bb: OptBbId) -> OptValueId {
    let mut cur = lp_peel_copy(body, val_id);
    let mut hops: usize = 0;
    while hops < 4 && cur.v != OPT_VALUE_NONE && (cur.v as usize) <= body.value_count {
        let inst = lp_find_def_inst(body, cur);
        if (inst as usize) == 0 || (unsafe { (*inst).opcode }) != OPT_INST_CAST ||
           (unsafe { (*inst).sub_op }) != MIR_CAST_INT_TO_INT {
            break;
        }
        let dst_ty_v = unsafe { (*inst).ty.v };
        let dst_bits = opt_type_bits(body.thir, TypeId { v: dst_ty_v });
        let dst_sig = opt_type_is_signed(body.thir, TypeId { v: dst_ty_v });
        let sv = lp_peel_copy(body, unsafe { (*inst).lhs });
        if sv.v == OPT_VALUE_NONE || (sv.v as usize) > body.value_count {
            break;
        }
        let svp = unsafe { opt_val_at(body.values, sv.v as usize) };
        let src_bits = opt_type_bits(body.thir, unsafe { (*svp).ty });
        if dst_bits == 0u32 || dst_bits > 64u32 || src_bits == 0u32 || src_bits > 64u32 {
            break;
        }
        if !bce_is_non_negative_proven(ri, body, sv, query_bb) ||
           !bce_is_non_negative_proven(ri, body, cur, query_bb) {
            break;
        }
        if dst_bits > src_bits {
            cur = sv;
            hops = hops + 1;
        } else if dst_bits == src_bits && !dst_sig {
            // `sv >= 0` already proven; either `sv` is unsigned (identity) or signed `0 <= sv <= INT_MAX < UINT_MAX`
            cur = sv;
            hops = hops + 1;
        } else {
            break;
        }
    }
    cur
}

fn bce_best_lower_const(ri: view<RangeInfo>, body: view<OptBody>, val_id: OptValueId, query_bb: OptBbId) -> u64 {
    let pv = lp_peel_copy(body, val_id);
    if pv.v == OPT_VALUE_NONE || (pv.v as usize) > body.value_count {
        return 0u64;
    }
    let mut best: u64 = 0u64;
    let mut cu: u64 = 0u64;
    let mut ci: i64 = 0i64;
    if lp_val_const_int(body, pv, mut_view(cu), mut_view(ci)) {
        if bce_is_non_negative_proven(ri, body, pv, query_bb) {
            best = cu;
        }
    }
    if (pv.v as usize) < ri.value_cap && (ri.value_ranges as usize) != 0 {
        let vr = unsafe { bce_range_at(ri.value_ranges, pv.v as usize) };
        if (unsafe { (*vr).has_range }) && (unsafe { (*vr).non_negative_proven }) && (unsafe { (*vr).lo }) > best {
            best = unsafe { (*vr).lo };
        }
    }
    let mut i: usize = 0;
    while i < ri.bound_count && (ri.bounds as usize) != 0 {
        let sb = unsafe { bce_bound_at(ri.bounds, i) };
        if (unsafe { (*sb).lhs.v }) == pv.v &&
           (unsafe { (*sb).rhs_base.v }) == OPT_VALUE_NONE &&
           (unsafe { (*sb).rel }) == BOUND_GE &&
           (unsafe { (*sb).rhs_offset }) >= 0i64 {
            let vbb = unsafe { (*sb).valid_at_bb };
            if vbb.v == OPT_BB_NONE || opt_dominates(body, vbb, query_bb) {
                let cand = (unsafe { (*sb).rhs_offset }) as u64;
                if cand > best {
                    best = cand;
                }
            }
        }
        i = i + 1;
    }
    best
}

fn bce_best_upper_const(ri: view<RangeInfo>, body: view<OptBody>, val_id: OptValueId, query_bb: OptBbId, out_hi: mut_view<u64>) -> bool {
    let pv = lp_peel_copy(body, val_id);
    if pv.v == OPT_VALUE_NONE || (pv.v as usize) > body.value_count {
        return false;
    }
    if !bce_is_non_negative_proven(ri, body, pv, query_bb) {
        return false;
    }
    let mut has_b = false;
    let mut best: u64 = 0xFFFFFFFFFFFFFFFFu64;
    let mut cu: u64 = 0u64;
    let mut ci: i64 = 0i64;
    if lp_val_const_int(body, pv, mut_view(cu), mut_view(ci)) {
        has_b = true;
        best = cu;
    }
    if (pv.v as usize) < ri.value_cap && (ri.value_ranges as usize) != 0 {
        let vr = unsafe { bce_range_at(ri.value_ranges, pv.v as usize) };
        if (unsafe { (*vr).has_range }) && (unsafe { (*vr).non_negative_proven }) {
            has_b = true;
            if (unsafe { (*vr).hi }) < best {
                best = unsafe { (*vr).hi };
            }
        }
    }
    let mut i: usize = 0;
    while i < ri.bound_count && (ri.bounds as usize) != 0 {
        let sb = unsafe { bce_bound_at(ri.bounds, i) };
        if (unsafe { (*sb).lhs.v }) == pv.v &&
           (unsafe { (*sb).rhs_base.v }) == OPT_VALUE_NONE &&
           (unsafe { (*sb).rel }) == BOUND_LE &&
           (unsafe { (*sb).rhs_offset }) >= 0i64 {
            let vbb = unsafe { (*sb).valid_at_bb };
            if vbb.v == OPT_BB_NONE || opt_dominates(body, vbb, query_bb) {
                let cand = (unsafe { (*sb).rhs_offset }) as u64;
                if !has_b || cand < best {
                    best = cand;
                    has_b = true;
                }
            }
        }
        i = i + 1;
    }
    *out_hi = best;
    has_b
}

// Decomposes `val` into `(base, delta)` over non-negative integers where `val == base + delta`
// is proven non-wrapping at `query_bb`.
fn bce_decompose_nonneg_affine(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    val_id: OptValueId,
    query_bb: OptBbId,
    out_base: mut_view<OptValueId>,
    out_delta: mut_view<i64>
) {
    let mut cur = bce_unwrap_cast_nonneg(ri, body, val_id, query_bb);
    let mut delta: i64 = 0i64;
    let mut hops: usize = 0;
    while hops < 4 && cur.v != OPT_VALUE_NONE && (cur.v as usize) <= body.value_count {
        let inst = lp_find_def_inst(body, cur);
        if (inst as usize) == 0 {
            break;
        }
        let opc = unsafe { (*inst).opcode };
        let bop = unsafe { (*inst).sub_op };
        if opc != OPT_INST_BINOP && opc != OPT_INST_WRAPPING_BINOP {
            break;
        }
        let is_add = bop == MIR_BINOP_ADD || bop == MIR_BINOP_WRAPPING_ADD;
        let is_sub = bop == MIR_BINOP_SUB || bop == MIR_BINOP_WRAPPING_SUB;
        if !is_add && !is_sub {
            break;
        }
        let vp = unsafe { opt_val_at(body.values, cur.v as usize) };
        let def_bb = unsafe { (*vp).def_bb };
        let check_bb: OptBbId = if opt_dominates(body, def_bb, query_bb) { def_bb } else { query_bb };
        let lv = lp_peel_copy(body, unsafe { (*inst).lhs });
        let rv = lp_peel_copy(body, unsafe { (*inst).rhs });
        let mut cu: u64 = 0u64;
        let mut ci: i64 = 0i64;
        if !lp_val_const_int(body, rv, mut_view(cu), mut_view(ci)) {
            break;
        }
        let is_sig = opt_type_is_signed(body.thir, unsafe { (*inst).ty });
        let bits = opt_type_bits(body.thir, unsafe { (*inst).ty });
        if bits == 0u32 || bits > 64u32 || !bce_is_non_negative_proven(ri, body, lv, query_bb) {
            break;
        }
        let step_c: i64 = if is_sig {
            ci
        } else {
            if cu > 0x7FFFFFFFFFFFFFFFu64 { break; }
            cu as i64
        };
        if step_c < 0i64 {
            break;
        }
        let mut nowrap_ok = false;
        if opc == OPT_INST_BINOP {
            let chk_bop: u8 = if is_add { MIR_BINOP_ADD } else { MIR_BINOP_SUB };
            if bce_has_checked_nonwrap(ri, body, chk_bop, lv, rv, check_bb) ||
               bce_has_checked_nonwrap(ri, body, chk_bop, lv, rv, query_bb) {
                nowrap_ok = true;
            }
        }
        if !nowrap_ok {
            if is_sub {
                let lo_l = bce_best_lower_const(ri, body, lv, query_bb);
                if lo_l >= (step_c as u64) {
                    nowrap_ok = true;
                }
            } else {
                let mut hi_l: u64 = 0u64;
                if bce_best_upper_const(ri, body, lv, query_bb, mut_view(hi_l)) {
                    let max_t: u64 = if is_sig { opt_bit_mask(bits) ^ opt_sign_bit_mask(bits) } else { opt_bit_mask(bits) };
                    let mut sum_u: u64 = 0u64;
                    if !opt_checked_add_u64(hi_l, step_c as u64, 64u32, mut_view(sum_u)) && sum_u <= max_t {
                        nowrap_ok = true;
                    }
                }
            }
        }
        if !nowrap_ok {
            break;
        }
        let signed_step: i64 = if is_sub { 0i64 - step_c } else { step_c };
        let mut new_delta_u: u64 = 0u64;
        if opt_checked_add_signed(delta as u64, signed_step as u64, 64u32, mut_view(new_delta_u)) {
            break;
        }
        delta = new_delta_u as i64;
        cur = bce_unwrap_cast_nonneg(ri, body, lv, query_bb);
        hops = hops + 1;
    }
    *out_base = cur;
    *out_delta = delta;
}

fn bce_record_cmp_fact(
    ri: mut_view<RangeInfo>,
    body: view<OptBody>,
    bop_in: u8,
    lhs_in: OptValueId,
    rhs_in: OptValueId,
    at_bb: OptBbId,
    arena: mut_view<Arena>
) {
    let mut bop = bop_in;
    let mut lhs = lp_peel_copy(body, lhs_in);
    let mut rhs = lp_peel_copy(body, rhs_in);
    if lhs.v == OPT_VALUE_NONE || rhs.v == OPT_VALUE_NONE ||
       (lhs.v as usize) > body.value_count || (rhs.v as usize) > body.value_count {
        return;
    }
    let lvp = unsafe { opt_val_at(body.values, lhs.v as usize) };
    let bits = opt_type_bits(body.thir, unsafe { (*lvp).ty });
    if bits == 0u32 || bits > 64u32 {
        return;
    }
    let is_sig = opt_type_is_signed(body.thir, unsafe { (*lvp).ty });

    // Normalize `>` / `>=` by swapping `lhs` and `rhs` into `<` / `<=`
    if bop == MIR_BINOP_GT {
        let tmp = lhs; lhs = rhs; rhs = tmp; bop = MIR_BINOP_LT;
    } else if bop == MIR_BINOP_GE {
        let tmp = lhs; lhs = rhs; rhs = tmp; bop = MIR_BINOP_LE;
    }

    let mut l_u: u64 = 0u64;
    let mut l_i: i64 = 0i64;
    let l_const = lp_val_const_int(body, lhs, mut_view(l_u), mut_view(l_i));
    let mut r_u: u64 = 0u64;
    let mut r_i: i64 = 0i64;
    let r_const = lp_val_const_int(body, rhs, mut_view(r_u), mut_view(r_i));

    // 1. Extract non-negativity facts (`c <= rhs`, `c < rhs`, `lhs == c`)
    if l_const {
        let lc_val: i64 = if is_sig { l_i } else { if l_u <= 0x7FFFFFFFFFFFFFFFu64 { l_u as i64 } else { -1i64 } };
        if bop == MIR_BINOP_LE && lc_val >= 0i64 {
            let r_base = bce_unwrap_cast_nonneg(view(*ri), body, rhs, at_bb);
            bce_push_nonneg(mut_view(*ri), mut_view(*arena), rhs, at_bb);
            bce_push_nonneg(mut_view(*ri), mut_view(*arena), r_base, at_bb);
            bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                lhs: r_base, rhs_base: OptValueId { v: OPT_VALUE_NONE }, rhs_offset: lc_val,
                rel: BOUND_GE, certainty: CERTAINTY_PROVEN, valid_at_bb: at_bb,
            });
        } else if bop == MIR_BINOP_LT && lc_val >= -1i64 && lc_val < 0x7FFFFFFFFFFFFFFFi64 {
            let min_v = lc_val + 1i64;
            let r_base = bce_unwrap_cast_nonneg(view(*ri), body, rhs, at_bb);
            bce_push_nonneg(mut_view(*ri), mut_view(*arena), rhs, at_bb);
            bce_push_nonneg(mut_view(*ri), mut_view(*arena), r_base, at_bb);
            bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                lhs: r_base, rhs_base: OptValueId { v: OPT_VALUE_NONE }, rhs_offset: min_v,
                rel: BOUND_GE, certainty: CERTAINTY_PROVEN, valid_at_bb: at_bb,
            });
        }
    }
    if bop == MIR_BINOP_EQ && r_const {
        let rc_val: i64 = if is_sig { r_i } else { if r_u <= 0x7FFFFFFFFFFFFFFFu64 { r_u as i64 } else { -1i64 } };
        if rc_val >= 0i64 {
            bce_push_nonneg(mut_view(*ri), mut_view(*arena), lhs, at_bb);
        }
    }
    if bop == MIR_BINOP_EQ && l_const {
        let lc_val: i64 = if is_sig { l_i } else { if l_u <= 0x7FFFFFFFFFFFFFFFu64 { l_u as i64 } else { -1i64 } };
        if lc_val >= 0i64 {
            bce_push_nonneg(mut_view(*ri), mut_view(*arena), rhs, at_bb);
        }
    }
    // `lhs >= rhs` (`rhs <= lhs`) where `rhs` is already proven non-negative implies `lhs >= 0`!
    if (bop == MIR_BINOP_LE || bop == MIR_BINOP_LT) && bce_is_non_negative_proven(view(*ri), body, lhs, at_bb) {
        bce_push_nonneg(mut_view(*ri), mut_view(*arena), rhs, at_bb);
    }

    // 2. Record canonical difference bounds (`BOUND_LE`: `lhs <= rhs + off`)
    if bop != MIR_BINOP_LT && bop != MIR_BINOP_LE && bop != MIR_BINOP_EQ {
        return;
    }
    let base_off: i64 = if bop == MIR_BINOP_LT { -1i64 } else { 0i64 };

    // Constant upper bound (`lhs <= c`)
    if r_const {
        let mut rc_ok = true;
        let mut rc_val: i64 = 0i64;
        if is_sig {
            rc_val = r_i;
        } else if r_u <= 0x7FFFFFFFFFFFFFFFu64 {
            rc_val = r_u as i64;
        } else {
            rc_ok = false;
        }
        let mut adj_c_u: u64 = 0u64;
        if rc_ok && !opt_checked_add_signed(rc_val as u64, base_off as u64, 64u32, mut_view(adj_c_u)) && (adj_c_u as i64) >= 0i64 {
            let adj_c = adj_c_u as i64;
            let mut lb = lhs;
            let mut ld: i64 = 0i64;
            if bce_is_non_negative_proven(view(*ri), body, lhs, at_bb) {
                bce_decompose_nonneg_affine(view(*ri), body, lhs, at_bb, mut_view(lb), mut_view(ld));
            }
            let mut fin_c_u: u64 = 0u64;
            if !opt_checked_sub_signed(adj_c as u64, ld as u64, 64u32, mut_view(fin_c_u)) && (fin_c_u as i64) >= 0i64 {
                let fin_c = fin_c_u as i64;
                bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                    lhs: lb, rhs_base: OptValueId { v: OPT_VALUE_NONE }, rhs_offset: fin_c,
                    rel: BOUND_LE, certainty: CERTAINTY_PROVEN, valid_at_bb: at_bb,
                });
                if bop == MIR_BINOP_EQ {
                    bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                        lhs: lb, rhs_base: OptValueId { v: OPT_VALUE_NONE }, rhs_offset: fin_c,
                        rel: BOUND_GE, certainty: CERTAINTY_PROVEN, valid_at_bb: at_bb,
                    });
                }
            }
        }
    }

    // Symbolic difference bound (`lhs <= rhs + base_off`)
    let mut lb = lhs;
    let mut ld: i64 = 0i64;
    if bce_is_non_negative_proven(view(*ri), body, lhs, at_bb) {
        bce_decompose_nonneg_affine(view(*ri), body, lhs, at_bb, mut_view(lb), mut_view(ld));
    }
    let mut rb = rhs;
    let mut rd: i64 = 0i64;
    if bce_is_non_negative_proven(view(*ri), body, rhs, at_bb) {
        bce_decompose_nonneg_affine(view(*ri), body, rhs, at_bb, mut_view(rb), mut_view(rd));
    }
    let mut tmp_off_u: u64 = 0u64;
    let mut fin_off_u: u64 = 0u64;
    if !opt_checked_add_signed(base_off as u64, rd as u64, 64u32, mut_view(tmp_off_u)) &&
       !opt_checked_sub_signed(tmp_off_u, ld as u64, 64u32, mut_view(fin_off_u)) {
        let fin_off = fin_off_u as i64;
        bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
            lhs: lb, rhs_base: rb, rhs_offset: fin_off,
            rel: BOUND_LE, certainty: CERTAINTY_PROVEN, valid_at_bb: at_bb,
        });
        if bop == MIR_BINOP_EQ {
            let mut rev_off_u: u64 = 0u64;
            if !opt_checked_sub_signed(0u64, fin_off as u64, 64u32, mut_view(rev_off_u)) {
                bce_push_bound(mut_view(*ri), mut_view(*arena), SymbolicBound {
                    lhs: rb, rhs_base: lb, rhs_offset: rev_off_u as i64,
                    rel: BOUND_LE, certainty: CERTAINTY_PROVEN, valid_at_bb: at_bb,
                });
            }
        }
    }
}

fn bce_find_phi_for_val(body: view<OptBody>, val_id: OptValueId, out_bb: mut_view<u32>) -> *mut compiler.opt.optir.OptPhi {
    *out_bb = OPT_BB_NONE;
    if val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count {
        return 0 as *mut compiler.opt.optir.OptPhi;
    }
    let vp = unsafe { opt_val_at(body.values, val_id.v as usize) };
    if (unsafe { (*vp).kind }) != OPT_VAL_PHI {
        return 0 as *mut compiler.opt.optir.OptPhi;
    }
    let b_v = unsafe { (*vp).def_bb.v };
    if (b_v as usize) >= body.bb_count {
        return 0 as *mut compiler.opt.optir.OptPhi;
    }
    let bb = unsafe { opt_block_at(body.blocks, b_v as usize) };
    let pcnt = unsafe { (*bb).phi_count };
    let mut p: usize = 0;
    while p < pcnt {
        let phi = unsafe { opt_phi_at((*bb).phis, p) };
        if (unsafe { (*phi).result.v }) == val_id.v {
            *out_bb = b_v;
            return phi;
        }
        p = p + 1;
    }
    0 as *mut compiler.opt.optir.OptPhi
}

fn bce_record_cond_tree(
    ri: mut_view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    cond_raw: OptValueId,
    want_true_in: bool,
    at_bb: OptBbId,
    depth: u32,
    arena: mut_view<Arena>
) {
    if depth > 12u32 {
        return;
    }
    let mut cur = lp_peel_copy(body, cond_raw);
    let mut want_true = want_true_in;
    let mut not_hops: usize = 0;
    while not_hops < 8 && cur.v != OPT_VALUE_NONE {
        let ninst = lp_find_def_inst(body, cur);
        if (ninst as usize) != 0 &&
           (unsafe { (*ninst).opcode }) == OPT_INST_UNOP &&
           (unsafe { (*ninst).sub_op }) == MIR_UNOP_NOT {
            want_true = !want_true;
            cur = lp_peel_copy(body, unsafe { (*ninst).lhs });
            not_hops = not_hops + 1;
        } else {
            break;
        }
    }
    if cur.v == OPT_VALUE_NONE || (cur.v as usize) > body.value_count {
        return;
    }

    // 1. Short-circuit `&&` / `||` 2-arm boolean `OptPhi` (`builder.ax:5051`)
    let mut phi_bb_v: u32 = OPT_BB_NONE;
    let phi = bce_find_phi_for_val(body, cur, mut_view(phi_bb_v));
    if (phi as usize) != 0 && (unsafe { (*phi).arity }) == 2 && opt_type_is_bool(body.thir, unsafe { (*phi).ty }) {
        let mut arm: usize = 0;
        while arm < 2 {
            let other: usize = 1 - arm;
            let b_short = unsafe { (*opt_bbid_at((*phi).incoming_blocks, arm)).v };
            let v_short = lp_peel_copy(body, unsafe { *opt_valid_at((*phi).incoming_values, arm) });
            let b_other = unsafe { (*opt_bbid_at((*phi).incoming_blocks, other)).v };
            let v_other = lp_peel_copy(body, unsafe { *opt_valid_at((*phi).incoming_values, other) });
            if (b_short as usize) < body.bb_count && (b_other as usize) < body.bb_count {
                let b_other_id = OptBbId { v: b_other };
                let sbb = unsafe { opt_block_at(body.blocks, b_short as usize) };
                let mut sb_cond = OptValueId { v: OPT_VALUE_NONE };
                let mut sb_t = OptBbId { v: OPT_BB_NONE };
                let mut sb_f = OptBbId { v: OPT_BB_NONE };
                let has_sb_br = loops_extract_bool_branch(unsafe { view(*sbb) }, mut_view(sb_cond), mut_view(sb_t), mut_view(sb_f));
                if has_sb_br {
                    let s_cond = lp_peel_copy(body, sb_cond);
                    let s_t = sb_t;
                    let s_f = sb_f;
                    if want_true && s_cond.v == v_short.v && s_f.v == phi_bb_v && s_t.v != phi_bb_v &&
                       opt_dominates(body, s_t, b_other_id) {
                        bce_record_cond_tree(mut_view(*ri), body, info, v_short, true, at_bb, depth + 1u32, mut_view(*arena));
                        bce_record_cond_tree(mut_view(*ri), body, info, v_other, true, at_bb, depth + 1u32, mut_view(*arena));
                        return;
                    }
                    if !want_true && s_cond.v == v_short.v && s_t.v == phi_bb_v && s_f.v != phi_bb_v &&
                       opt_dominates(body, s_f, b_other_id) {
                        bce_record_cond_tree(mut_view(*ri), body, info, v_short, false, at_bb, depth + 1u32, mut_view(*arena));
                        bce_record_cond_tree(mut_view(*ri), body, info, v_other, false, at_bb, depth + 1u32, mut_view(*arena));
                        return;
                    }
                }
                // Also handle constant-folded short-circuit arm `[b_short: const(!want_true), b_other: v_other]`
                if v_short.v != OPT_VALUE_NONE && (v_short.v as usize) <= body.value_count {
                    let svp = unsafe { opt_val_at(body.values, v_short.v as usize) };
                    if (unsafe { (*svp).kind }) == OPT_VAL_CONST && (unsafe { (*svp).const_val.kind }) == MIR_CONST_BOOL {
                        let c_b = (unsafe { (*svp).const_val.val }) != 0u64;
                        if c_b != want_true {
                            if has_sb_br {
                                let s_cond = lp_peel_copy(body, sb_cond);
                                let s_t = sb_t;
                                let s_f = sb_f;
                                if want_true && s_f.v == phi_bb_v && opt_dominates(body, s_t, b_other_id) {
                                    bce_record_cond_tree(mut_view(*ri), body, info, s_cond, true, at_bb, depth + 1u32, mut_view(*arena));
                                } else if !want_true && s_t.v == phi_bb_v && opt_dominates(body, s_f, b_other_id) {
                                    bce_record_cond_tree(mut_view(*ri), body, info, s_cond, false, at_bb, depth + 1u32, mut_view(*arena));
                                }
                            } else {
                                let p_short_v = bce_single_reachable_pred(body, b_short);
                                if p_short_v != OPT_BB_NONE && (p_short_v as usize) < body.bb_count {
                                    let pbb = unsafe { opt_block_at(body.blocks, p_short_v as usize) };
                                    let mut pb_cond = OptValueId { v: OPT_VALUE_NONE };
                                    let mut pb_t = OptBbId { v: OPT_BB_NONE };
                                    let mut pb_f = OptBbId { v: OPT_BB_NONE };
                                    if loops_extract_bool_branch(unsafe { view(*pbb) }, mut_view(pb_cond), mut_view(pb_t), mut_view(pb_f)) {
                                        let p_cond = lp_peel_copy(body, pb_cond);
                                        if want_true && pb_f.v == b_short && opt_dominates(body, pb_t, b_other_id) {
                                            bce_record_cond_tree(mut_view(*ri), body, info, p_cond, true, at_bb, depth + 1u32, mut_view(*arena));
                                        } else if !want_true && pb_t.v == b_short && opt_dominates(body, pb_f, b_other_id) {
                                            bce_record_cond_tree(mut_view(*ri), body, info, p_cond, false, at_bb, depth + 1u32, mut_view(*arena));
                                        }
                                    }
                                }
                            }
                            bce_record_cond_tree(mut_view(*ri), body, info, v_other, want_true, at_bb, depth + 1u32, mut_view(*arena));
                            return;
                        }
                    }
                }
            }
            arm = arm + 1;
        }
    }

    let inst = lp_find_def_inst(body, cur);
    if (inst as usize) == 0 {
        return;
    }
    let opc = unsafe { (*inst).opcode };
    if opc == OPT_INST_CHECKED_BINOP && !want_true {
        let bop = unsafe { (*inst).sub_op };
        let lv = lp_peel_copy(body, unsafe { (*inst).lhs });
        let rv = lp_peel_copy(body, unsafe { (*inst).rhs });
        bce_push_checked_op(mut_view(*ri), mut_view(*arena), bop, lv, rv, at_bb);
        return;
    }
    if opc == OPT_INST_BINOP {
        let mut bop = unsafe { (*inst).sub_op };
        let lv = lp_peel_copy_and_lcssa(body, unsafe { (*inst).lhs });
        let rv = lp_peel_copy_and_lcssa(body, unsafe { (*inst).rhs });
        if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
           (unsafe { (*inst).orig_stmt.rvalue.kind }) == MIR_RVALUE_BINARY_OP {
            let lhs_non_ssa = bce_op_is_non_ssa_mem_read(body, unsafe { view((*inst).orig_stmt.rvalue.lhs) });
            let rhs_non_ssa = bce_op_is_non_ssa_mem_read(body, unsafe { view((*inst).orig_stmt.rvalue.rhs) });
            if lhs_non_ssa || rhs_non_ssa {
                if lhs_non_ssa != rhs_non_ssa {
                    let idx_ssa: OptValueId = if lhs_non_ssa { rv } else { lv };
                    if idx_ssa.v != OPT_VALUE_NONE && (idx_ssa.v as usize) <= body.value_count {
                        let ivp = unsafe { opt_val_at(body.values, idx_ssa.v as usize) };
                        if opt_type_bits(body.thir, unsafe { (*ivp).ty }) > 0u32 {
                            let mut vloc: u32 = 0xFFFFFFFFu32;
                            let mut vrpl = mir_local_place(0u32);
                            let mut vro = false;
                            let is_vlen = if lhs_non_ssa {
                                bce_op_is_vec_len(body, info, unsafe { view((*inst).orig_stmt.rvalue.lhs) }, mut_view(vloc), mut_view(vrpl), mut_view(vro), mut_view(*arena))
                            } else {
                                bce_op_is_vec_len(body, info, unsafe { view((*inst).orig_stmt.rvalue.rhs) }, mut_view(vloc), mut_view(vrpl), mut_view(vro), mut_view(*arena))
                            };
                            if is_vlen {
                                let mut eff_bop = bop;
                                let mut bop_ok = true;
                                if !want_true {
                                    let mut inv_op: u8 = 0u8;
                                    if bce_invert_int_cmp(eff_bop, mut_view(inv_op)) {
                                        eff_bop = inv_op;
                                    } else {
                                        bop_ok = false;
                                    }
                                }
                                let mut has_off = false;
                                let mut off_v: i64 = 0i64;
                                if bop_ok {
                                    if !lhs_non_ssa {
                                        if eff_bop == MIR_BINOP_LT {
                                            has_off = true;
                                            off_v = -1i64;
                                        } else if eff_bop == MIR_BINOP_LE || eff_bop == MIR_BINOP_EQ {
                                            has_off = true;
                                            off_v = 0i64;
                                        }
                                    } else {
                                        if eff_bop == MIR_BINOP_GT {
                                            has_off = true;
                                            off_v = -1i64;
                                        } else if eff_bop == MIR_BINOP_GE || eff_bop == MIR_BINOP_EQ {
                                            has_off = true;
                                            off_v = 0i64;
                                        }
                                    }
                                }
                                if has_off {
                                    let cvp = unsafe { opt_val_at(body.values, cur.v as usize) };
                                    let cmp_bb_v = unsafe { (*cvp).def_bb.v };
                                    let mut cmp_iidx: u32 = 0u32;
                                    if (cmp_bb_v as usize) < body.bb_count {
                                        let cbb = unsafe { opt_block_at(body.blocks, cmp_bb_v as usize) };
                                        let cic = unsafe { (*cbb).inst_count };
                                        let mut ci: usize = 0;
                                        while ci < cic {
                                            let cinst = unsafe { opt_inst_at((*cbb).insts, ci) };
                                            if (unsafe { (*cinst).result.v }) == cur.v {
                                                cmp_iidx = ci as u32;
                                                break;
                                            }
                                            ci = ci + 1;
                                        }
                                    }
                                    let rloc = bce_resolve_root_local_chain(body, info, vloc);
                                    let ib = InlineVecBound {
                                        idx_val: idx_ssa,
                                        rhs_offset: off_v,
                                        root_local: rloc,
                                        src_local: vloc,
                                        cmp_bb: OptBbId { v: cmp_bb_v },
                                        cmp_inst_idx: cmp_iidx,
                                        valid_at_bb: at_bb,
                                        region_place: vrpl,
                                    };
                                    bce_push_inline_vec(mut_view(*ri), mut_view(*arena), view(ib));
                                }
                            }
                        }
                    }
                }
                return;
            }
        }
        if lv.v == OPT_VALUE_NONE || (lv.v as usize) > body.value_count {
            return;
        }
        let lvp = unsafe { opt_val_at(body.values, lv.v as usize) };
        if opt_type_bits(body.thir, unsafe { (*lvp).ty }) == 0u32 {
            // Never invert floating-point comparisons (NaN hazard)
            return;
        }
        if !want_true {
            let mut inv_op: u8 = 0u8;
            if !bce_invert_int_cmp(bop, mut_view(inv_op)) {
                return;
            }
            bop = inv_op;
        }
        bce_record_cmp_fact(mut_view(*ri), body, bop, lv, rv, at_bb, mut_view(*arena));
    }
}

fn bce_collect_dominating_guards(ri: mut_view<RangeInfo>, body: view<OptBody>, info: *const AliasInfo, arena: mut_view<Arena>) {
    let mut pass: usize = 0;
    while pass < 2 {
        let mut r: usize = 0;
        while r < body.rpo_count && (body.rpo_order as usize) != 0 {
            let src_v = unsafe { (*opt_bbid_at(body.rpo_order, r)).v };
            if (src_v as usize) < body.bb_count {
                let bb = unsafe { opt_block_at(body.blocks, src_v as usize) };
                if (unsafe { (*bb).is_reachable }) && (unsafe { (*bb).has_term }) {
                    let tk = unsafe { (*bb).term.kind };
                    let mut br_cond = OptValueId { v: OPT_VALUE_NONE };
                    let mut t_bb = OptBbId { v: OPT_BB_NONE };
                    let mut f_bb = OptBbId { v: OPT_BB_NONE };
                    if loops_extract_bool_branch(unsafe { view(*bb) }, mut_view(br_cond), mut_view(t_bb), mut_view(f_bb)) {
                        if t_bb.v != f_bb.v {
                            if bce_single_reachable_pred(body, t_bb.v) == src_v {
                                bce_record_cond_tree(mut_view(*ri), body, info, br_cond, true, t_bb, 0u32, mut_view(*arena));
                            }
                            if bce_single_reachable_pred(body, f_bb.v) == src_v {
                                bce_record_cond_tree(mut_view(*ri), body, info, br_cond, false, f_bb, 0u32, mut_view(*arena));
                            }
                        }
                    } else if tk == OPT_TERM_ASSERT {
                        // CRITICAL: attach strictly at continuation `true_bb` (never `src_v`!) so no assert proves itself
                        let t_bb = unsafe { (*bb).term.true_bb };
                        if t_bb.v != src_v && bce_single_reachable_pred(body, t_bb.v) == src_v {
                            let cond = unsafe { (*bb).term.cond };
                            let exp = unsafe { (*bb).term.assert_expected };
                            bce_record_cond_tree(mut_view(*ri), body, info, cond, exp, t_bb, 0u32, mut_view(*arena));
                        }
                    }
                }
            }
            r = r + 1;
        }
        pass = pass + 1;
    }
}

// --- Canonical Difference-Bound Prover (`x <= y + max_diff` over Z_{>=0}) ---

fn bce_interval_satisfies_diff_le(hi_x: u64, lo_y: u64, target_diff: i64) -> bool {
    if target_diff >= 0i64 {
        let mut rhs_sum: u64 = 0u64;
        if opt_checked_add_u64(lo_y, target_diff as u64, 64u32, mut_view(rhs_sum)) {
            return true;
        }
        return hi_x <= rhs_sum;
    }
    let neg_d = opt_twos_complement_u64(target_diff as u64);
    lo_y >= neg_d && hi_x <= (lo_y - neg_d)
}

fn bce_dfs_diff_chain(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    cur_x: OptValueId,
    target_y: OptValueId,
    lo_y: u64,
    rem_diff: i64,
    query_bb: OptBbId,
    query_inst: u32,
    depth_left: u32,
    v0: u32,
    v1: u32,
    v2: u32,
    arena: mut_view<Arena>
) -> bool {
    if bce_lengths_equal_at(ri, body, info, call_table, cur_x, target_y, query_bb.v, query_inst, mut_view(*arena)) &&
       rem_diff >= 0i64 {
        return true;
    }
    let mut hi_cur: u64 = 0u64;
    if bce_best_upper_const(ri, body, cur_x, query_bb, mut_view(hi_cur)) &&
       bce_interval_satisfies_diff_le(hi_cur, lo_y, rem_diff) {
        return true;
    }
    if depth_left == 0u32 {
        return false;
    }
    let mut i: usize = 0;
    while i < ri.bound_count && (ri.bounds as usize) != 0 {
        let sb = unsafe { bce_bound_at(ri.bounds, i) };
        if (unsafe { (*sb).rel }) == BOUND_LE && (unsafe { (*sb).rhs_base.v }) != OPT_VALUE_NONE &&
           (unsafe { (*sb).certainty }) == CERTAINTY_PROVEN {
            let vbb = unsafe { (*sb).valid_at_bb };
            if vbb.v == OPT_BB_NONE || opt_dominates(body, vbb, query_bb) {
                let slhs = unsafe { (*sb).lhs };
                let srhs = unsafe { (*sb).rhs_base };
                if bce_is_non_negative_proven(ri, body, slhs, query_bb) &&
                   bce_is_non_negative_proven(ri, body, srhs, query_bb) &&
                   bce_lengths_equal_at(ri, body, info, call_table, cur_x, slhs, query_bb.v, query_inst, mut_view(*arena)) {
                    let mut mid0 = srhs;
                    let mut d_mid: i64 = 0i64;
                    bce_decompose_nonneg_affine(ri, body, srhs, query_bb, mut_view(mid0), mut_view(d_mid));
                    if mid0.v != v0 && mid0.v != v1 && mid0.v != v2 {
                        let mut step_off_u: u64 = 0u64;
                        let mut next_rem_u: u64 = 0u64;
                        if !opt_checked_add_signed((unsafe { (*sb).rhs_offset }) as u64, d_mid as u64, 64u32, mut_view(step_off_u)) &&
                           !opt_checked_sub_signed(rem_diff as u64, step_off_u, 64u32, mut_view(next_rem_u)) {
                            let next_rem = next_rem_u as i64;
                            let nv1: u32 = if depth_left == 3u32 { mid0.v } else { v1 };
                            let nv2: u32 = if depth_left == 2u32 { mid0.v } else { v2 };
                            if bce_dfs_diff_chain(ri, body, info, call_table, mid0, target_y, lo_y, next_rem, query_bb, query_inst, depth_left - 1u32, v0, nv1, nv2, mut_view(*arena)) {
                                return true;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    false
}

pub fn bce_prove_diff_le(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    x_raw: OptValueId,
    y_raw: OptValueId,
    max_diff: i64,
    query_bb: OptBbId,
    query_inst: u32,
    arena: mut_view<Arena>
) -> bool {
    if !bce_is_non_negative_proven(ri, body, x_raw, query_bb) ||
       !bce_is_non_negative_proven(ri, body, y_raw, query_bb) {
        return false;
    }
    let mut x0 = x_raw;
    let mut dx: i64 = 0i64;
    bce_decompose_nonneg_affine(ri, body, x_raw, query_bb, mut_view(x0), mut_view(dx));
    let mut y0 = y_raw;
    let mut dy: i64 = 0i64;
    bce_decompose_nonneg_affine(ri, body, y_raw, query_bb, mut_view(y0), mut_view(dy));

    let mut t1_u: u64 = 0u64;
    let mut target_diff_u: u64 = 0u64;
    if opt_checked_add_signed(max_diff as u64, dy as u64, 64u32, mut_view(t1_u)) ||
       opt_checked_sub_signed(t1_u, dx as u64, 64u32, mut_view(target_diff_u)) {
        return false;
    }
    let target_diff = target_diff_u as i64;
    let lo_y = bce_best_lower_const(ri, body, y0, query_bb);
    bce_dfs_diff_chain(ri, body, info, call_table, x0, y0, lo_y, target_diff, query_bb, query_inst, 3u32, x0.v, OPT_VALUE_NONE, OPT_VALUE_NONE, mut_view(*arena))
}

fn bce_prove_against_inline_vec_bounds(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    lhs_id: OptValueId,
    req_diff: i64,
    check_root: u32,
    check_vloc: u32,
    check_bb_v: u32,
    check_iidx: u32,
    check_rpl: view<MirPlace>,
    at_bb: OptBbId,
    inst_idx: u32,
    arena: mut_view<Arena>
) -> bool {
    if check_root == 0xFFFFFFFFu32 || ri.inline_vec_count == 0 || (ri.inline_vec_bounds as usize) == 0 {
        return false;
    }
    let mut m: usize = 0;
    while m < ri.inline_vec_count {
        let ib = unsafe { bce_inline_vec_at(ri.inline_vec_bounds, m) };
        if (unsafe { (*ib).root_local }) == check_root &&
           opt_dominates(body, unsafe { (*ib).valid_at_bb }, at_bb) {
            let ib_bb = unsafe { (*ib).cmp_bb.v };
            let ib_iidx = unsafe { (*ib).cmp_inst_idx };
            let ib_src = unsafe { (*ib).src_local };
            let ib_idx = unsafe { (*ib).idx_val };
            let ib_off = unsafe { (*ib).rhs_offset };
            if bce_path_unclobbered_between(body, info, call_table, ib_bb, ib_iidx, check_bb_v, check_iidx, check_root, ib_src, check_vloc, true, check_rpl, mut_view(*arena)) &&
               bce_path_unclobbered_between(body, info, call_table, check_bb_v, check_iidx, at_bb.v, inst_idx, check_root, check_vloc, check_vloc, true, check_rpl, mut_view(*arena)) {
                let mut need_diff_u: u64 = 0u64;
                if !opt_checked_sub_signed(req_diff as u64, ib_off as u64, 64u32, mut_view(need_diff_u)) {
                    if bce_prove_diff_le(ri, body, info, call_table, lhs_id, ib_idx, need_diff_u as i64, at_bb, inst_idx, mut_view(*arena)) {
                        return true;
                    }
                }
            }
        }
        m = m + 1;
    }
    false
}

// Evaluates whether a bounds condition `cond_raw == expected` is `CERTAINTY_PROVEN` at `(at_bb, inst_idx)`.
fn bce_eval_bounds_cond(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    cond_raw: OptValueId,
    expected: bool,
    at_bb: OptBbId,
    inst_idx: u32,
    out_idx: mut_view<OptValueId>,
    out_len: mut_view<OptValueId>,
    out_len_kind: mut_view<u8>,
    arena: mut_view<Arena>
) -> u8 {
    *out_idx = OptValueId { v: OPT_VALUE_NONE };
    *out_len = OptValueId { v: OPT_VALUE_NONE };
    *out_len_kind = LEN_KIND_NONE;

    let mut cur = lp_peel_copy(body, cond_raw);
    let mut want_true = expected;
    let mut hops: usize = 0;
    while hops < 8 && cur.v != OPT_VALUE_NONE {
        let ninst = lp_find_def_inst(body, cur);
        if (ninst as usize) != 0 &&
           (unsafe { (*ninst).opcode }) == OPT_INST_UNOP &&
           (unsafe { (*ninst).sub_op }) == MIR_UNOP_NOT {
            want_true = !want_true;
            cur = lp_peel_copy(body, unsafe { (*ninst).lhs });
            hops = hops + 1;
        } else {
            break;
        }
    }
    let inst = lp_find_def_inst(body, cur);
    if (inst as usize) == 0 || (unsafe { (*inst).opcode }) != OPT_INST_BINOP {
        return CERTAINTY_UNKNOWN;
    }
    let mut bop = unsafe { (*inst).sub_op };
    let mut lhs = lp_peel_copy_and_lcssa(body, unsafe { (*inst).lhs });
    let mut rhs = lp_peel_copy_and_lcssa(body, unsafe { (*inst).rhs });
    if lhs.v == OPT_VALUE_NONE || rhs.v == OPT_VALUE_NONE || (lhs.v as usize) > body.value_count {
        return CERTAINTY_UNKNOWN;
    }
    let lvp = unsafe { opt_val_at(body.values, lhs.v as usize) };
    let rvp = unsafe { opt_val_at(body.values, rhs.v as usize) };
    if opt_type_bits(body.thir, unsafe { (*lvp).ty }) == 0u32 &&
       opt_type_bits(body.thir, unsafe { (*rvp).ty }) == 0u32 {
        return CERTAINTY_UNKNOWN;
    }
    if !want_true {
        let mut inv_op: u8 = 0u8;
        if !bce_invert_int_cmp(bop, mut_view(inv_op)) {
            return CERTAINTY_UNKNOWN;
        }
        bop = inv_op;
    }
    let mut swapped = false;
    if bop == MIR_BINOP_GT {
        let tmp = lhs; lhs = rhs; rhs = tmp; bop = MIR_BINOP_LT; swapped = true;
    } else if bop == MIR_BINOP_GE {
        let tmp = lhs; lhs = rhs; rhs = tmp; bop = MIR_BINOP_LE; swapped = true;
    }
    if bop != MIR_BINOP_LT && bop != MIR_BINOP_LE {
        return CERTAINTY_POSSIBLE;
    }

    let at_bb_v = at_bb.v;
    let lhs_v = lhs.v;
    let rhs_v = rhs.v;
    *out_idx = OptValueId { v: lhs_v };
    *out_len = OptValueId { v: rhs_v };
    let lf = bce_find_length_fact(ri, OptValueId { v: rhs_v });
    if (lf as usize) != 0 {
        *out_len_kind = unsafe { (*lf).kind };
    } else {
        let lf_l = bce_find_length_fact(ri, OptValueId { v: lhs_v });
        if (lf_l as usize) != 0 {
            *out_len_kind = unsafe { (*lf_l).kind };
        }
    }

    let req_diff: i64 = if bop == MIR_BINOP_LT { -1i64 } else { 0i64 };
    if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
       (unsafe { (*inst).orig_stmt.rvalue.kind }) == MIR_RVALUE_BINARY_OP {
        let idx_non_ssa = if swapped {
            bce_op_is_non_ssa_mem_read(body, unsafe { view((*inst).orig_stmt.rvalue.rhs) })
        } else {
            bce_op_is_non_ssa_mem_read(body, unsafe { view((*inst).orig_stmt.rvalue.lhs) })
        };
        let len_non_ssa = if swapped {
            bce_op_is_non_ssa_mem_read(body, unsafe { view((*inst).orig_stmt.rvalue.lhs) })
        } else {
            bce_op_is_non_ssa_mem_read(body, unsafe { view((*inst).orig_stmt.rvalue.rhs) })
        };
        let mut len_vloc: u32 = 0xFFFFFFFFu32;
        let mut len_vrpl = mir_local_place(0u32);
        let mut len_vro = false;
        let len_is_vec = if swapped {
            bce_op_is_vec_len(body, info, unsafe { view((*inst).orig_stmt.rvalue.lhs) }, mut_view(len_vloc), mut_view(len_vrpl), mut_view(len_vro), mut_view(*arena))
        } else {
            bce_op_is_vec_len(body, info, unsafe { view((*inst).orig_stmt.rvalue.rhs) }, mut_view(len_vloc), mut_view(len_vrpl), mut_view(len_vro), mut_view(*arena))
        };
        if len_is_vec && *out_len_kind == LEN_KIND_NONE {
            *out_len_kind = LEN_KIND_VEC_LEN;
        }
        if idx_non_ssa {
            return CERTAINTY_POSSIBLE;
        }
        if len_non_ssa {
            if len_is_vec {
                let cvp = unsafe { opt_val_at(body.values, cur.v as usize) };
                let cmp_bb_v = unsafe { (*cvp).def_bb.v };
                let mut cmp_iidx: u32 = 0u32;
                if (cmp_bb_v as usize) < body.bb_count {
                    let cbb = unsafe { opt_block_at(body.blocks, cmp_bb_v as usize) };
                    let cic = unsafe { (*cbb).inst_count };
                    let mut ci: usize = 0;
                    while ci < cic {
                        let cinst = unsafe { opt_inst_at((*cbb).insts, ci) };
                        if (unsafe { (*cinst).result.v }) == cur.v {
                            cmp_iidx = ci as u32;
                            break;
                        }
                        ci = ci + 1;
                    }
                }
                let vec_root = bce_resolve_root_local_chain(body, info, len_vloc);
                let mut k: usize = 0;
                while k < ri.length_count && (ri.lengths as usize) != 0 {
                    let lfk = unsafe { bce_len_at(ri.lengths, k) };
                    let lfk_val_v = unsafe { (*lfk).val.v };
                    if (unsafe { (*lfk).kind }) == LEN_KIND_VEC_LEN &&
                       !(unsafe { (*lfk).is_sroa_ssa }) &&
                       (unsafe { (*lfk).root_local }) == vec_root &&
                       lfk_val_v != rhs_v {
                        let lb_v = unsafe { (*lfk).def_bb.v };
                        let li_v = unsafe { (*lfk).def_inst_idx };
                        let ls_v = unsafe { (*lfk).src_local };
                        let p1_ok = bce_path_unclobbered_between(body, info, call_table, lb_v, li_v, cmp_bb_v, cmp_iidx, vec_root, ls_v, len_vloc, true, view(len_vrpl), mut_view(*arena));
                        if p1_ok {
                            let p2_ok = bce_path_unclobbered_between(body, info, call_table, cmp_bb_v, cmp_iidx, at_bb_v, inst_idx, vec_root, len_vloc, len_vloc, true, view(len_vrpl), mut_view(*arena));
                            if p2_ok {
                                let lhs_id = OptValueId { v: lhs_v };
                                let lfk_id = OptValueId { v: lfk_val_v };
                                let qbb_id = OptBbId { v: at_bb_v };
                                if bce_prove_diff_le(ri, body, info, call_table, lhs_id, lfk_id, req_diff, qbb_id, inst_idx, mut_view(*arena)) {
                                    return CERTAINTY_PROVEN;
                                }
                            }
                        }
                    }
                    k = k + 1;
                }
                let lhs_iv = OptValueId { v: lhs_v };
                let qbb_iv = OptBbId { v: at_bb_v };
                if bce_prove_against_inline_vec_bounds(
                    ri, body, info, call_table, lhs_iv, req_diff,
                    vec_root, len_vloc, cmp_bb_v, cmp_iidx, view(len_vrpl),
                    qbb_iv, inst_idx, mut_view(*arena)
                ) {
                    return CERTAINTY_PROVEN;
                }
                return CERTAINTY_POSSIBLE;
            }
            return CERTAINTY_POSSIBLE;
        }
    }

    let lhs_id2 = OptValueId { v: lhs_v };
    let rhs_id2 = OptValueId { v: rhs_v };
    let qbb_id2 = OptBbId { v: at_bb_v };
    if bce_prove_diff_le(ri, body, info, call_table, lhs_id2, rhs_id2, req_diff, qbb_id2, inst_idx, mut_view(*arena)) {
        return CERTAINTY_PROVEN;
    }
    if (lf as usize) != 0 && (unsafe { (*lf).kind }) == LEN_KIND_VEC_LEN && !(unsafe { (*lf).is_sroa_ssa }) {
        if bce_prove_against_inline_vec_bounds(
            ri, body, info, call_table, lhs_id2, req_diff,
            unsafe { (*lf).root_local }, unsafe { (*lf).src_local },
            unsafe { (*lf).def_bb.v }, unsafe { (*lf).def_inst_idx },
            unsafe { view((*lf).region_place) }, qbb_id2, inst_idx, mut_view(*arena)
        ) {
            return CERTAINTY_PROVEN;
        }
    }
    CERTAINTY_POSSIBLE
}

// --- Half-Open Sub-Range & Dynamic Index Disjointness Prover (AXS-BCE-005, REQ-OPT-141, REQ-OPT-142) ---

fn bce_extract_place_slice_or_index(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    place: view<MirPlace>,
    at_bb: usize,
    inst_idx: usize,
    arena: mut_view<Arena>,
    out_root_loc: mut_view<u32>,
    out_base_ssa: mut_view<OptValueId>,
    out_is_arr_root: mut_view<bool>,
    out_is_subslice: mut_view<bool>,
    out_is_elem: mut_view<bool>,
    out_has_lo: mut_view<bool>,
    out_lo: mut_view<OptValueId>,
    out_has_hi: mut_view<bool>,
    out_hi: mut_view<OptValueId>
) {
    *out_root_loc = 0xFFFFFFFFu32;
    *out_base_ssa = OptValueId { v: OPT_VALUE_NONE };
    *out_is_arr_root = false;
    *out_is_subslice = false;
    *out_is_elem = false;
    *out_has_lo = false;
    *out_lo = OptValueId { v: OPT_VALUE_NONE };
    *out_has_hi = false;
    *out_hi = OptValueId { v: OPT_VALUE_NONE };

    let loc = place.local.v;
    let sf = bce_find_subslice_for_local(ri, bce_resolve_root_local_chain(body, info, loc));
    let sf_direct = if (sf as usize) != 0 { sf } else { bce_find_subslice_for_local(ri, loc) };
    let at_bb_id = OptBbId { v: at_bb as u32 };
    if (sf_direct as usize) != 0 &&
       bce_local_is_single_def_unescaped(body, info, loc) &&
       opt_dominates(body, unsafe { (*sf_direct).def_bb }, at_bb_id) &&
       ((unsafe { (*sf_direct).def_bb.v }) != (at_bb as u32) ||
        ((unsafe { (*sf_direct).def_inst_idx }) as usize) < inst_idx) &&
       bce_scalar_local_unclobbered_from_def(
           body, BCE_DEF_INST,
           (unsafe { (*sf_direct).def_bb.v }) as usize,
           (unsafe { (*sf_direct).def_inst_idx }) as usize,
           at_bb, inst_idx, unsafe { (*sf_direct).slice_local }, mut_view(*arena)
       ) {
        let mut shape_ok = place.proj_count == 0;
        if !shape_ok && (place.projs as usize) != 0 {
            let sp0 = unsafe { mir_proj_at(place.projs, 0) };
            if place.proj_count == 1 && (unsafe { (*sp0).kind }) == MIR_PROJ_DEREF {
                shape_ok = true;
            } else if place.proj_count == 2 && (unsafe { (*sp0).kind }) == MIR_PROJ_DEREF {
                let sp1 = unsafe { mir_proj_at(place.projs, 1) };
                let sk1 = unsafe { (*sp1).kind };
                shape_ok = sk1 == MIR_PROJ_INDEX || sk1 == MIR_PROJ_SUB_SLICE;
            }
        }
        if shape_ok {
            *out_root_loc = unsafe { (*sf_direct).root_local };
            *out_base_ssa = unsafe { (*sf_direct).base_ssa };
            *out_is_arr_root = unsafe { (*sf_direct).is_array_root };
            *out_is_subslice = true;
            *out_has_lo = unsafe { (*sf_direct).has_start };
            *out_lo = unsafe { (*sf_direct).start_val };
            *out_has_hi = unsafe { (*sf_direct).has_end };
            *out_hi = unsafe { (*sf_direct).end_val };
            return;
        }
    }

    if (place.proj_count == 1 || place.proj_count == 2) && (place.projs as usize) != 0 {
        let mut only_deref = true;
        let mut k: usize = 0;
        while k + 1 < place.proj_count {
            let pp = unsafe { mir_proj_at(place.projs, k) };
            if (unsafe { (*pp).kind }) != MIR_PROJ_DEREF {
                only_deref = false;
            }
            k = k + 1;
        }
        if only_deref {
            let lu = loc as usize;
            let mut base_ok = false;
            let mut rloc: u32 = 0xFFFFFFFFu32;
            let mut b_ssa = OptValueId { v: OPT_VALUE_NONE };
            let mut is_arr = false;
            if place.proj_count == 1 {
                if lu < body.local_count && (body.local_tys as usize) != 0 &&
                   bce_type_kind(body.thir, unsafe { *opt_typeid_at(body.local_tys, lu) }) == TY_ARRAY &&
                   (info as usize) != 0 && lu < (unsafe { (*info).local_count }) {
                    let bprov = unsafe { alias_local_prov_at((*info).locals, lu) };
                    if !(unsafe { (*bprov).raw_addr_exposed }) {
                        rloc = loc;
                        is_arr = true;
                        base_ok = true;
                    }
                }
            } else if bce_local_is_single_def_unescaped(body, info, loc) {
                rloc = bce_resolve_root_local_chain(body, info, loc);
                let rlu = rloc as usize;
                if rlu < body.local_count && (body.local_tys as usize) != 0 &&
                   bce_type_kind(body.thir, unsafe { *opt_typeid_at(body.local_tys, rlu) }) == TY_ARRAY &&
                   (info as usize) != 0 && rlu < (unsafe { (*info).local_count }) {
                    let rprov = unsafe { alias_local_prov_at((*info).locals, rlu) };
                    if !(unsafe { (*rprov).raw_addr_exposed }) {
                        is_arr = true;
                        base_ok = true;
                    }
                } else if bce_local_is_single_def_unescaped(body, info, rloc) {
                    let resolved_b = bce_resolve_ssa_local_at(body, info, rloc, at_bb, inst_idx, mut_view(*arena));
                    if resolved_b.v != OPT_VALUE_NONE {
                        b_ssa = lp_peel_copy_and_lcssa(body, resolved_b);
                        base_ok = b_ssa.v != OPT_VALUE_NONE;
                    }
                }
            }
            if base_ok {
                let last_p = unsafe { mir_proj_at(place.projs, place.proj_count - 1) };
                let pk = unsafe { (*last_p).kind };
                if pk == MIR_PROJ_SUB_SLICE {
                    let hf = unsafe { (*last_p).has_from };
                    let ht = unsafe { (*last_p).has_to };
                    let lo_v: OptValueId = if hf {
                        bce_resolve_ssa_local_at(body, info, unsafe { (*last_p).from_local.v }, at_bb, inst_idx, mut_view(*arena))
                    } else {
                        OptValueId { v: OPT_VALUE_NONE }
                    };
                    let hi_v: OptValueId = if ht {
                        bce_resolve_ssa_local_at(body, info, unsafe { (*last_p).to_local.v }, at_bb, inst_idx, mut_view(*arena))
                    } else {
                        OptValueId { v: OPT_VALUE_NONE }
                    };
                    if (!hf || lo_v.v != OPT_VALUE_NONE) && (!ht || hi_v.v != OPT_VALUE_NONE) {
                        *out_root_loc = rloc;
                        *out_base_ssa = b_ssa;
                        *out_is_arr_root = is_arr;
                        *out_is_subslice = true;
                        *out_has_lo = hf;
                        *out_lo = lo_v;
                        *out_has_hi = ht;
                        *out_hi = hi_v;
                    }
                } else if pk == MIR_PROJ_INDEX {
                    let iv = bce_resolve_ssa_local_at(body, info, unsafe { (*last_p).index_local.v }, at_bb, inst_idx, mut_view(*arena));
                    if iv.v != OPT_VALUE_NONE {
                        *out_root_loc = rloc;
                        *out_base_ssa = b_ssa;
                        *out_is_arr_root = is_arr;
                        *out_is_elem = true;
                        *out_has_lo = true;
                        *out_lo = iv;
                    }
                }
            }
        }
    }
}

fn bce_normalize_subrange_place(body: view<OptBody>, place: view<MirPlace>, arena: mut_view<Arena>) -> MirPlace {
    let lv = place.local.v as usize;
    if place.proj_count == 0 && lv < body.local_count && (body.local_tys as usize) != 0 {
        let lty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, lv)).v } };
        let tk = bce_type_kind(body.thir, lty);
        if tk == TY_VIEW || tk == TY_MUT_VIEW || tk == TY_PTR {
            let pr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
            unsafe {
                (*pr).kind = MIR_PROJ_DEREF;
                (*pr).field_idx = 0u32;
                (*pr).index_local = MirLocalId { v: 0u32 };
                (*pr).from_local = MirLocalId { v: 0u32 };
                (*pr).to_local = MirLocalId { v: 0u32 };
                (*pr).has_from = false;
                (*pr).has_to = false;
                (*pr).variant_idx = 0u32;
            }
            let mut pl = mir_local_place(place.local.v);
            pl.projs = pr;
            pl.proj_count = 1;
            return pl;
        }
    }
    let mut out = mir_local_place(0u32);
    mir_copy_place(mut_view(out), place);
    out
}

pub fn bce_prove_subrange_disjoint(
    ri: view<RangeInfo>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    place_a: view<MirPlace>,
    place_b: view<MirPlace>,
    at_bb: OptBbId,
    inst_idx: u32,
    arena: mut_view<Arena>
) -> AliasFact {
    let pt = alias_make_prog_pt(at_bb.v, inst_idx);
    if (info as usize) != 0 {
        let eff_a = bce_normalize_subrange_place(body, place_a, mut_view(*arena));
        let eff_b = bce_normalize_subrange_place(body, place_b, mut_view(*arena));
        let none_v1 = OptValueId { v: OPT_VALUE_NONE };
        let none_v2 = OptValueId { v: OPT_VALUE_NONE };
        let reg_a = alias_extract_region(unsafe { view(*info) }, body, view(eff_a), none_v1, mut_view(*arena));
        let reg_b = alias_extract_region(unsafe { view(*info) }, body, view(eff_b), none_v2, mut_view(*arena));
        if reg_a.domain == DOMAIN_RAW_PTR || reg_b.domain == DOMAIN_RAW_PTR ||
           reg_a.cap_mode == CAP_MODE_RAW_PTR || reg_b.cap_mode == CAP_MODE_RAW_PTR {
            return AliasFact {
                result: ALIAS_UNKNOWN, relation: REGION_UNKNOWN, certainty: CERTAINTY_UNKNOWN,
                reason: ALIAS_REASON_RAW_PTR_PROVENANCE, valid_start: 0u32, valid_end: 0xFFFFFFFFu32,
            };
        }
        let base_af = alias_query_regions(unsafe { view(*info) }, body, mut_view(*arena), view(reg_a), view(reg_b), pt);
        if alias_is_no_alias_proven(view(base_af)) {
            return base_af;
        }
    }

    let mut root_a: u32 = 0xFFFFFFFFu32;
    let mut base_ssa_a = OptValueId { v: OPT_VALUE_NONE };
    let mut is_arr_a = false;
    let mut is_sub_a = false;
    let mut is_el_a = false;
    let mut has_lo_a = false;
    let mut lo_a = OptValueId { v: OPT_VALUE_NONE };
    let mut has_hi_a = false;
    let mut hi_a = OptValueId { v: OPT_VALUE_NONE };
    bce_extract_place_slice_or_index(
        ri, body, info, place_a, at_bb.v as usize, inst_idx as usize, mut_view(*arena),
        mut_view(root_a), mut_view(base_ssa_a), mut_view(is_arr_a),
        mut_view(is_sub_a), mut_view(is_el_a),
        mut_view(has_lo_a), mut_view(lo_a), mut_view(has_hi_a), mut_view(hi_a)
    );

    let mut root_b: u32 = 0xFFFFFFFFu32;
    let mut base_ssa_b = OptValueId { v: OPT_VALUE_NONE };
    let mut is_arr_b = false;
    let mut is_sub_b = false;
    let mut is_el_b = false;
    let mut has_lo_b = false;
    let mut lo_b = OptValueId { v: OPT_VALUE_NONE };
    let mut has_hi_b = false;
    let mut hi_b = OptValueId { v: OPT_VALUE_NONE };
    bce_extract_place_slice_or_index(
        ri, body, info, place_b, at_bb.v as usize, inst_idx as usize, mut_view(*arena),
        mut_view(root_b), mut_view(base_ssa_b), mut_view(is_arr_b),
        mut_view(is_sub_b), mut_view(is_el_b),
        mut_view(has_lo_b), mut_view(lo_b), mut_view(has_hi_b), mut_view(hi_b)
    );

    let same_verified_base = root_a != 0xFFFFFFFFu32 && root_a == root_b && is_arr_a == is_arr_b &&
                             (is_arr_a || (base_ssa_a.v != OPT_VALUE_NONE && base_ssa_a.v == base_ssa_b.v));
    if same_verified_base {
        let mut proven_disjoint = false;
        if is_sub_a && is_sub_b {
            if has_hi_a && hi_a.v != OPT_VALUE_NONE && has_lo_b && lo_b.v != OPT_VALUE_NONE &&
               bce_prove_diff_le(ri, body, info, call_table, hi_a, lo_b, 0i64, at_bb, inst_idx, mut_view(*arena)) {
                proven_disjoint = true;
            } else if has_hi_b && hi_b.v != OPT_VALUE_NONE && has_lo_a && lo_a.v != OPT_VALUE_NONE &&
                      bce_prove_diff_le(ri, body, info, call_table, hi_b, lo_a, 0i64, at_bb, inst_idx, mut_view(*arena)) {
                proven_disjoint = true;
            }
        } else if is_sub_a && is_el_b && has_lo_b && lo_b.v != OPT_VALUE_NONE {
            if (has_hi_a && hi_a.v != OPT_VALUE_NONE && bce_prove_diff_le(ri, body, info, call_table, hi_a, lo_b, 0i64, at_bb, inst_idx, mut_view(*arena))) ||
               (has_lo_a && lo_a.v != OPT_VALUE_NONE && bce_prove_diff_le(ri, body, info, call_table, lo_b, lo_a, -1i64, at_bb, inst_idx, mut_view(*arena))) {
                proven_disjoint = true;
            }
        } else if is_el_a && is_sub_b && has_lo_a && lo_a.v != OPT_VALUE_NONE {
            if (has_hi_b && hi_b.v != OPT_VALUE_NONE && bce_prove_diff_le(ri, body, info, call_table, hi_b, lo_a, 0i64, at_bb, inst_idx, mut_view(*arena))) ||
               (has_lo_b && lo_b.v != OPT_VALUE_NONE && bce_prove_diff_le(ri, body, info, call_table, lo_a, lo_b, -1i64, at_bb, inst_idx, mut_view(*arena))) {
                proven_disjoint = true;
            }
        } else if is_el_a && is_el_b && has_lo_a && lo_a.v != OPT_VALUE_NONE && has_lo_b && lo_b.v != OPT_VALUE_NONE {
            if bce_prove_diff_le(ri, body, info, call_table, lo_a, lo_b, -1i64, at_bb, inst_idx, mut_view(*arena)) ||
               bce_prove_diff_le(ri, body, info, call_table, lo_b, lo_a, -1i64, at_bb, inst_idx, mut_view(*arena)) {
                proven_disjoint = true;
            }
        }
        if proven_disjoint {
            return AliasFact {
                result: ALIAS_NO_ALIAS, relation: REGION_DISJOINT, certainty: CERTAINTY_PROVEN,
                reason: ALIAS_REASON_RANGE_DISJOINT, valid_start: 0u32, valid_end: 0xFFFFFFFFu32,
            };
        }
    }

    AliasFact {
        result: ALIAS_MAY_ALIAS, relation: REGION_UNKNOWN, certainty: CERTAINTY_POSSIBLE,
        reason: ALIAS_REASON_DYNAMIC_INDEX, valid_start: 0u32, valid_end: 0xFFFFFFFFu32,
    }
}

// --- Public `RangeInfo` Builder & `opt_bce` Pass Entry Points (SPEC-72 §2) ---

pub fn range_build_info(
    body: view<OptBody>,
    loop_tree: *const LoopTree,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    arena: mut_view<Arena>
) -> *mut RangeInfo {
    let _ = call_table;
    let ri = arena_alloc_raw(mut_view(*arena), size_of<RangeInfo>(), align_of<RangeInfo>()) as *mut RangeInfo;
    unsafe {
        (*ri).value_ranges = 0 as *mut ValueRange;
        (*ri).value_cap = 0;
        (*ri).bounds = 0 as *mut SymbolicBound;
        (*ri).bound_count = 0;
        (*ri).bound_cap = 0;
        (*ri).nonneg_facts = 0 as *mut NonNegFact;
        (*ri).nonneg_count = 0;
        (*ri).nonneg_cap = 0;
        (*ri).checked_ops = 0 as *mut CheckedNonWrapOp;
        (*ri).checked_count = 0;
        (*ri).checked_cap = 0;
        (*ri).lengths = 0 as *mut LengthFact;
        (*ri).length_count = 0;
        (*ri).length_cap = 0;
        (*ri).subslices = 0 as *mut SubsliceRangeFact;
        (*ri).subslice_count = 0;
        (*ri).subslice_cap = 0;
        (*ri).inline_vec_bounds = 0 as *mut InlineVecBound;
        (*ri).inline_vec_count = 0;
        (*ri).inline_vec_cap = 0;
    }
    bce_init_value_ranges(unsafe { mut_view(*ri) }, body, mut_view(*arena));
    bce_collect_length_and_subslice_facts(unsafe { mut_view(*ri) }, body, info, mut_view(*arena));
    bce_collect_scev_facts(unsafe { mut_view(*ri) }, body, loop_tree, mut_view(*arena));
    bce_collect_dominating_guards(unsafe { mut_view(*ri) }, body, info, mut_view(*arena));
    ri
}

fn bce_mark_reach(body: view<OptBody>, reach: *mut bool, queue: *mut u32, q_len: mut_view<usize>, bb_v: u32) {
    if bb_v != OPT_BB_NONE && (bb_v as usize) < body.bb_count {
        if !(unsafe { *opt_bool_at(reach, bb_v as usize) }) {
            unsafe {
                *opt_bool_at(reach, bb_v as usize) = true;
                *opt_u32_at(queue, *q_len) = bb_v;
            }
            *q_len = *q_len + 1;
        }
    }
}

fn bce_prune_unreachable_and_rebuild_cfg_ssa(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    arena: mut_view<Arena>
) -> u32 {
    let n = body.bb_count;
    if n == 0 || (body.blocks as usize) == 0 {
        return 0u32;
    }
    let reach = arena_alloc_raw(mut_view(*arena), bce_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let queue = arena_alloc_raw(mut_view(*arena), bce_mul_usize(n + 2, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut b: usize = 0;
    while b < n {
        unsafe { *opt_bool_at(reach, b) = false; }
        b = b + 1;
    }
    let mut q_head: usize = 0;
    let mut q_len: usize = 0;
    bce_mark_reach(view(*body), reach, queue, mut_view(q_len), 0u32);

    while q_head < q_len {
        let cur = (unsafe { *opt_u32_at(queue, q_head) }) as usize;
        q_head = q_head + 1;
        let bb = unsafe { opt_block_at(body.blocks, cur) };
        if unsafe { (*bb).has_term } {
            let tk = unsafe { (*bb).term.kind };
            if tk == OPT_TERM_GOTO {
                bce_mark_reach(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.true_bb.v });
            } else if tk == OPT_TERM_BRANCH {
                bce_mark_reach(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.true_bb.v });
                bce_mark_reach(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.false_bb.v });
            } else if tk == OPT_TERM_SWITCH_INT {
                let swc = unsafe { (*bb).term.switch_count };
                let mut k: usize = 0;
                while k < swc {
                    let st_v = unsafe { (*opt_bbid_at((*bb).term.switch_targets, k)).v };
                    bce_mark_reach(view(*body), reach, queue, mut_view(q_len), st_v);
                    k = k + 1;
                }
                bce_mark_reach(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.otherwise_bb.v });
            } else if tk == OPT_TERM_CALL || tk == OPT_TERM_ASSERT || tk == OPT_TERM_DROP {
                bce_mark_reach(view(*body), reach, queue, mut_view(q_len), unsafe { (*bb).term.true_bb.v });
                let unw_v = unsafe { (*bb).term.unwind_bb.v };
                if unw_v != OPT_BB_NONE && (unw_v as usize) < body.bb_count {
                    let ubb = unsafe { opt_block_at(body.blocks, unw_v as usize) };
                    if (unsafe { (*ubb).term.kind }) != OPT_TERM_UNREACHABLE || (unsafe { (*ubb).inst_count }) > 0 {
                        bce_mark_reach(view(*body), reach, queue, mut_view(q_len), unw_v);
                    }
                }
            }
        }
    }

    let mut pruned: u32 = 0u32;
    b = 0;
    while b < n {
        if !(unsafe { *opt_bool_at(reach, b) }) {
            let ubb = unsafe { opt_block_at(body.blocks, b) };
            if unsafe { (*ubb).is_reachable } {
                if pm.has_baseline_effects {
                    let u_eff = effect_infer_block_with_table(view(*body), unsafe { view(*ubb) }, 0 as *const EffectCallTable, pm.budget.max_symbolic_steps);
                    pm.baseline_effect_summary.volatile_count = if pm.baseline_effect_summary.volatile_count >= u_eff.volatile_count { pm.baseline_effect_summary.volatile_count - u_eff.volatile_count } else { 0u32 };
                    pm.baseline_effect_summary.atomic_count = if pm.baseline_effect_summary.atomic_count >= u_eff.atomic_count { pm.baseline_effect_summary.atomic_count - u_eff.atomic_count } else { 0u32 };
                    pm.baseline_effect_summary.io_count = if pm.baseline_effect_summary.io_count >= u_eff.io_count { pm.baseline_effect_summary.io_count - u_eff.io_count } else { 0u32 };
                    pm.baseline_effect_summary.drop_count = if pm.baseline_effect_summary.drop_count >= u_eff.drop_count { pm.baseline_effect_summary.drop_count - u_eff.drop_count } else { 0u32 };
                }
                pruned = pruned + 1u32;
            }
            let icnt = unsafe { (*ubb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*ubb).insts, i) };
                unsafe {
                    (*inst).opcode = OPT_INST_NOP;
                    (*inst).sub_op = 0u8;
                    (*inst).flags = 0u16;
                    (*inst).lhs = OptValueId { v: OPT_VALUE_NONE };
                    (*inst).rhs = OptValueId { v: OPT_VALUE_NONE };
                    (*inst).extra_arg_count = 0;
                    (*inst).mem_use = MemSsaId { v: MEM_SSA_NONE };
                    (*inst).mem_def = MemSsaId { v: MEM_SSA_NONE };
                }
                i = i + 1;
            }
            let mut loc = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
            unsafe {
                (*ubb).inst_count = 0;
                (*ubb).phi_count = 0;
                (*ubb).has_mem_phi = false;
                (*ubb).mem_phi_result = MemSsaId { v: MEM_SSA_NONE };
                (*ubb).is_reachable = false;
                mir_span_copy(mut_view(loc), view((*ubb).term.orig_term.location));
                mir_term_reset(mut_view((*ubb).term.orig_term), MIR_TERM_UNREACHABLE, view(loc));
                (*ubb).term.kind = OPT_TERM_UNREACHABLE;
                (*ubb).term.cond = OptValueId { v: OPT_VALUE_NONE };
                (*ubb).term.callee = OptValueId { v: OPT_VALUE_NONE };
                (*ubb).term.call_arg_count = 0;
                (*ubb).term.switch_count = 0;
                (*ubb).term.true_bb = OptBbId { v: OPT_BB_NONE };
                (*ubb).term.false_bb = OptBbId { v: OPT_BB_NONE };
                (*ubb).term.otherwise_bb = OptBbId { v: OPT_BB_NONE };
                (*ubb).term.unwind_bb = OptBbId { v: OPT_BB_NONE };
            }
        }
        b = b + 1;
    }

    optir_compute_cfg(mut_view(*body), mut_view(*arena));
    b = 0;
    while b < n {
        let sbb = unsafe { opt_block_at(body.blocks, b) };
        let new_pcnt = unsafe { (*sbb).pred_count };
        let pcnt = unsafe { (*sbb).phi_count };
        if new_pcnt == 0 {
            unsafe { (*sbb).phi_count = 0; }
        } else if pcnt > 0 {
            let mut pi: usize = 0;
            while pi < pcnt {
                let phi = unsafe { opt_phi_at((*sbb).phis, pi) };
                let old_arity = unsafe { (*phi).arity };
                let old_ib = unsafe { (*phi).incoming_blocks };
                let old_iv = unsafe { (*phi).incoming_values };
                let new_ib = arena_alloc_raw(mut_view(*arena), bce_mul_usize(new_pcnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                let new_iv = arena_alloc_raw(mut_view(*arena), bce_mul_usize(new_pcnt, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
                let mut np: usize = 0;
                while np < new_pcnt {
                    let pb_v = unsafe { (*opt_bbid_at((*sbb).preds, np)).v };
                    let mut matched_val = OptValueId { v: OPT_VALUE_NONE };
                    let mut ok_idx: usize = 0;
                    while ok_idx < old_arity {
                        if (unsafe { (*opt_bbid_at(old_ib, ok_idx)).v }) == pb_v {
                            matched_val = unsafe { *opt_valid_at(old_iv, ok_idx) };
                            break;
                        }
                        ok_idx = ok_idx + 1;
                    }
                    unsafe {
                        *opt_bbid_at(new_ib, np) = OptBbId { v: pb_v };
                        *opt_valid_at(new_iv, np) = matched_val;
                    }
                    np = np + 1;
                }
                unsafe {
                    (*phi).arity = new_pcnt;
                    (*phi).incoming_blocks = new_ib;
                    (*phi).incoming_values = new_iv;
                }
                pi = pi + 1;
            }
        }
        b = b + 1;
    }

    optir_compute_dominators(mut_view(*body), mut_view(*arena));
    optir_compute_dom_frontier(mut_view(*body), mut_view(*arena));
    optir_construct_memssa(mut_view(*body), mut_view(*arena));
    pruned
}

unsafe fn bce_rewrite_assert_to_goto(bb: *mut OptBlock, target_bb: OptBbId) {
    let mut loc = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    mir_span_copy(mut_view(loc), view((*bb).term.orig_term.location));
    mir_term_reset(mut_view((*bb).term.orig_term), MIR_TERM_GOTO, view(loc));
    (*bb).term.orig_term.goto_target = MirBbId { v: target_bb.v };
    (*bb).term.kind = OPT_TERM_GOTO;
    (*bb).term.true_bb = target_bb;
    (*bb).term.false_bb = OptBbId { v: OPT_BB_NONE };
    (*bb).term.otherwise_bb = OptBbId { v: OPT_BB_NONE };
    (*bb).term.unwind_bb = OptBbId { v: OPT_BB_NONE };
    (*bb).term.cond = OptValueId { v: OPT_VALUE_NONE };
    (*bb).term.callee = OptValueId { v: OPT_VALUE_NONE };
    (*bb).term.call_arg_count = 0;
    (*bb).term.switch_count = 0;
}

pub fn opt_bce(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    stats: mut_view<BceStats>,
    out_sites: *mut *mut BceSiteRecord,
    out_site_count: *mut usize
) -> bool {
    if (out_sites as usize) != 0 {
        unsafe { *out_sites = 0 as *mut BceSiteRecord; }
    }
    if (out_site_count as usize) != 0 {
        unsafe { *out_site_count = 0; }
    }
    // Strict -O0 preservation (`REQ-OPT-176`, `AXS-LOOP-001` rule 3)
    if pm.budget.profile == OPT_PROFILE_DEBUG_O0 || body.bb_count == 0 {
        return false;
    }
    stats.pass_runs = stats.pass_runs + 1u32;

    // Canonicalize natural loops first (`AXS-LOOP-003`) so preheaders, single latches, and LCSSA hold
    let ainfo_pre = alias_build_info(view(*body), call_table, mut_view(*arena));
    let mut lp_stats = LoopSimplifyStats {
        pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32, loops_discovered: 0u32,
        irreducible_cycles: 0u32, preheaders_inserted: 0u32, latches_merged: 0u32,
        dedicated_exits_inserted: 0u32, lcssa_phis_inserted: 0u32,
    };
    loops_stats_zero(mut_view(lp_stats));
    let _ = opt_loop_simplify(
        mut_view(*pm),
        mut_view(*body),
        call_table,
        ainfo_pre as *const AliasInfo,
        mut_view(lp_stats),
        mut_view(*arena),
        mut_view(*sink)
    );

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_revs = arena_alloc_raw(mut_view(*arena), bce_mul_usize(ANALYSIS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;
    if (pm.analysis_revs as usize) != 0 {
        let mut ar_i: usize = 0;
        while ar_i < ANALYSIS_COUNT {
            unsafe { *opt_u32_at(pre_revs, ar_i) = *opt_u32_at(pm.analysis_revs, ar_i); }
            ar_i = ar_i + 1;
        }
    }
    let base_eff_backup = pm.baseline_effect_summary;

    let ainfo = alias_build_info(view(*body), call_table, mut_view(*arena));
    let ltree = loops_discover(view(*body), call_table, ainfo as *const AliasInfo, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*ltree) }, view(*body), ainfo as *const AliasInfo, mut_view(*arena));
    let rinfo = range_build_info(view(*body), ltree as *const LoopTree, ainfo as *const AliasInfo, call_table, mut_view(*arena));

    let site_cap = body.bb_count + 1;
    let sites = arena_alloc_raw(mut_view(*arena), bce_mul_usize(site_cap, size_of<BceSiteRecord>()), align_of<BceSiteRecord>()) as *mut BceSiteRecord;
    let mut site_cnt: usize = 0;
    let mut eliminated_now: u32 = 0u32;
    let mut arr_elim: u32 = 0u32;
    let mut slc_elim: u32 = 0u32;
    let mut vec_elim: u32 = 0u32;
    let mut ret_poss: u32 = 0u32;
    let mut ret_unk: u32 = 0u32;
    let mut inspected: u32 = 0u32;

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if (unsafe { (*bb).is_reachable }) && (unsafe { (*bb).has_term }) &&
           (unsafe { (*bb).term.kind }) == OPT_TERM_ASSERT {
            let msg_p = unsafe { (*bb).term.assert_msg_ptr };
            let msg_l = unsafe { (*bb).term.assert_msg_len };
            let is_oob = bce_is_index_oob_msg(msg_p, msg_l);
            let is_arith = bce_is_arith_or_div_msg(msg_p, msg_l);

            if !is_arith {
                let cond_v = unsafe { (*bb).term.cond };
                let exp_b = unsafe { (*bb).term.assert_expected };
                let icnt = unsafe { (*bb).inst_count };
                let mut idx_v = OptValueId { v: OPT_VALUE_NONE };
                let mut len_v = OptValueId { v: OPT_VALUE_NONE };
                let mut lkind: u8 = LEN_KIND_NONE;
                let cert = bce_eval_bounds_cond(
                    unsafe { view(*rinfo) }, view(*body), ainfo as *const AliasInfo, call_table,
                    cond_v, exp_b, OptBbId { v: b as u32 }, icnt as u32,
                    mut_view(idx_v), mut_view(len_v), mut_view(lkind), mut_view(*arena)
                );
                // Classify as bounds-check site iff compiler OOB assert OR container `LengthFact` assert
                let is_bce_site = is_oob || (lkind == LEN_KIND_VEC_LEN || lkind == LEN_KIND_SLICE_VIEW);
                if is_bce_site {
                    inspected = inspected + 1u32;
                    let cond_move_drop = (unsafe { (*bb).term.orig_term.cond.kind }) == MIR_OP_MOVE &&
                                         ((unsafe { (*bb).term.orig_term.cond.place.local.v }) as usize) < body.local_count &&
                                         (body.local_dropped as usize) != 0 &&
                                         (unsafe { *opt_bool_at(body.local_dropped, (*bb).term.orig_term.cond.place.local.v as usize) });
                    let mut dec = BCE_RETAINED_UNKNOWN;
                    if cert == CERTAINTY_PROVEN && !cond_move_drop {
                        dec = BCE_ELIMINATED_PROVEN;
                        let target_bb = unsafe { (*bb).term.true_bb };
                        optir_record_provenance(
                            mut_view(*body), mut_view(*arena),
                            PROP_IN_BOUNDS, CERTAINTY_PROVEN, ANALYSIS_RANGE_INFO,
                            idx_v, len_v, OptBbId { v: b as u32 }, OptInstId { v: OPT_INST_NONE }, PASS_BCE
                        );
                        unsafe { bce_rewrite_assert_to_goto(bb, target_bb); }
                        eliminated_now = eliminated_now + 1u32;
                        if lkind == LEN_KIND_FIXED_ARRAY {
                            arr_elim = arr_elim + 1u32;
                        } else if lkind == LEN_KIND_VEC_LEN {
                            vec_elim = vec_elim + 1u32;
                        } else {
                            slc_elim = slc_elim + 1u32;
                        }
                    } else if cert == CERTAINTY_POSSIBLE || (cert == CERTAINTY_PROVEN && cond_move_drop) {
                        dec = BCE_RETAINED_POSSIBLE;
                        ret_poss = ret_poss + 1u32;
                    } else {
                        dec = BCE_RETAINED_UNKNOWN;
                        ret_unk = ret_unk + 1u32;
                    }

                    if site_cnt < site_cap {
                        unsafe {
                            *bce_site_at(sites, site_cnt) = BceSiteRecord {
                                bb: OptBbId { v: b as u32 },
                                cond_val: cond_v,
                                idx_val: idx_v,
                                len_val: len_v,
                                len_kind: lkind,
                                decision: dec,
                                certainty: cert,
                            };
                        }
                        site_cnt = site_cnt + 1;
                    }
                }
            }
        }
        b = b + 1;
    }

    if (out_sites as usize) != 0 {
        unsafe { *out_sites = sites; }
    }
    if (out_site_count as usize) != 0 {
        unsafe { *out_site_count = site_cnt; }
    }

    if eliminated_now == 0u32 {
        stats.sites_inspected = stats.sites_inspected + inspected;
        stats.checks_retained_possible = stats.checks_retained_possible + ret_poss;
        stats.checks_retained_unknown = stats.checks_retained_unknown + ret_unk;
        return false;
    }

    let pruned = bce_prune_unreachable_and_rebuild_cfg_ssa(mut_view(*pm), mut_view(*body), mut_view(*arena));
    pm.ir_revision = pm.ir_revision + 1u32;
    passmgr_invalidate_analyses(mut_view(*pm), ANALYSIS_MASK_LOOP_INFO | ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_ALIAS_INFO);
    let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                    analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA);
    pm.valid_analyses = pm.valid_analyses | keep_mask;
    loops_stamp_valid_analysis_revs(mut_view(*pm));

    if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
        passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
        pm.ir_revision = pre_rev;
        pm.valid_analyses = pre_valid;
        if (pm.analysis_revs as usize) != 0 {
            let mut ar_j: usize = 0;
            while ar_j < ANALYSIS_COUNT {
                unsafe { *opt_u32_at(pm.analysis_revs, ar_j) = *opt_u32_at(pre_revs, ar_j); }
                ar_j = ar_j + 1;
            }
        }
        pm.baseline_effect_summary = base_eff_backup;
        stats.pass_rollbacks = stats.pass_rollbacks + 1u32;
        if (out_site_count as usize) != 0 {
            unsafe { *out_site_count = 0; }
        }
        return false;
    }

    stats.sites_inspected = stats.sites_inspected + inspected;
    stats.checks_eliminated = stats.checks_eliminated + eliminated_now;
    stats.checks_retained_possible = stats.checks_retained_possible + ret_poss;
    stats.checks_retained_unknown = stats.checks_retained_unknown + ret_unk;
    stats.array_checks_eliminated = stats.array_checks_eliminated + arr_elim;
    stats.slice_checks_eliminated = stats.slice_checks_eliminated + slc_elim;
    stats.vec_checks_eliminated = stats.vec_checks_eliminated + vec_elim;
    stats.blocks_pruned = stats.blocks_pruned + pruned;
    stats.pass_changes = stats.pass_changes + eliminated_now;
    true
}

pub fn bce_optimize_mir_body(
    mir_body: mut_view<MirBody>,
    thir: *const Thir,
    profile: u8,
    verify_each: bool,
    call_table: *const EffectCallTable,
    stats: mut_view<BceStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    fn_item: *const HirItem
) -> bool {
    bce_stats_zero(mut_view(*stats));
    let prev_errs = sink.errors;

    let obody = optir_build_from_mir(view(*mir_body), thir, mut_view(*arena), mut_view(*sink), fn_item);
    if (obody as usize) == 0 || sink.errors != prev_errs {
        return false;
    }

    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, verify_each);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));

    if profile == OPT_PROFILE_DEBUG_O0 {
        if verify_each {
            return loops_verify_pass_postconditions(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink));
        }
        return true;
    }

    let _ = opt_bce(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        call_table,
        mut_view(*arena),
        mut_view(*sink),
        mut_view(*stats),
        0 as *mut *mut BceSiteRecord,
        0 as *mut usize
    );

    let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*obody) }, unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
        return false;
    }
    verify_mir(unsafe { view(*rec_mir) }, thir, mut_view(*sink), fn_item);
    if sink.errors != prev_errs {
        sink.errors = prev_errs;
        stats.pass_rollbacks = stats.pass_rollbacks + 1u32;
        return false;
    }

    unsafe {
        mir_body.sym.v = (*rec_mir).sym.v;
        mir_body.fn_sym.v = (*rec_mir).fn_sym.v;
        mir_body.fn_name.v = (*rec_mir).fn_name.v;
        mir_body.span.file.v = (*rec_mir).span.file.v;
        mir_body.span.start = (*rec_mir).span.start;
        mir_body.span.end = (*rec_mir).span.end;
        mir_body.locals = (*rec_mir).locals;
        mir_body.local_count = (*rec_mir).local_count;
        mir_body.local_cap = (*rec_mir).local_cap;
        mir_body.arg_count = (*rec_mir).arg_count;
        mir_body.bbs = (*rec_mir).bbs;
        mir_body.bb_count = (*rec_mir).bb_count;
        mir_body.bb_cap = (*rec_mir).bb_cap;
        mir_body.drop_flag_count = (*rec_mir).drop_flag_count;
    }
    true
}

// --- Deterministic Inspection Printer: `bce_print` (SPEC-72 §2, 0 string literals) ---

const BCE_STR_DATA: [85]u8 = [
    98u8, 99u8, 101u8, 95u8, 105u8, 110u8, 102u8, 111u8, 32u8, 123u8, 10u8,
    125u8, 10u8,
    32u8, 32u8, 32u8, 32u8, 98u8, 111u8, 117u8, 110u8, 100u8, 115u8, 61u8,
    32u8, 108u8, 101u8, 110u8, 103u8, 116u8, 104u8, 115u8, 61u8,
    32u8, 115u8, 117u8, 98u8, 115u8, 108u8, 105u8, 99u8, 101u8, 115u8, 61u8,
    32u8, 115u8, 105u8, 116u8, 101u8, 115u8, 61u8,
    32u8, 101u8, 108u8, 105u8, 109u8, 61u8,
    32u8, 114u8, 101u8, 116u8, 97u8, 105u8, 110u8, 101u8, 100u8, 61u8,
    32u8, 97u8, 114u8, 114u8, 61u8,
    32u8, 115u8, 108u8, 105u8, 99u8, 101u8, 61u8,
    32u8, 118u8, 101u8, 99u8, 61u8,
    10u8,
];

const BCE_STR_OFF: [13]u32 = [
    0u32, 11u32, 13u32, 24u32, 33u32, 44u32, 51u32, 57u32, 67u32, 72u32, 79u32, 84u32, 85u32,
];

fn bce_push_tok(out: mut_view<DiagBuffer>, tok: usize) {
    let start = BCE_STR_OFF[tok] as usize;
    let end = BCE_STR_OFF[tok + 1] as usize;
    let mut i: usize = start;
    while i < end {
        diag_buf_push_byte(mut_view(*out), BCE_STR_DATA[i]);
        i = i + 1;
    }
}

pub fn bce_print(out: mut_view<DiagBuffer>, ri: view<RangeInfo>, stats: view<BceStats>) {
    bce_push_tok(mut_view(*out), 0); // "bce_info {\n"
    bce_push_tok(mut_view(*out), 2); // "    bounds="
    diag_buf_push_u32(mut_view(*out), ri.bound_count as u32);
    bce_push_tok(mut_view(*out), 3); // " lengths="
    diag_buf_push_u32(mut_view(*out), ri.length_count as u32);
    bce_push_tok(mut_view(*out), 4); // " subslices="
    diag_buf_push_u32(mut_view(*out), ri.subslice_count as u32);
    bce_push_tok(mut_view(*out), 5); // " sites="
    diag_buf_push_u32(mut_view(*out), stats.sites_inspected);
    bce_push_tok(mut_view(*out), 6); // " elim="
    diag_buf_push_u32(mut_view(*out), stats.checks_eliminated);
    bce_push_tok(mut_view(*out), 7); // " retained="
    diag_buf_push_u32(mut_view(*out), stats.checks_retained_possible + stats.checks_retained_unknown);
    bce_push_tok(mut_view(*out), 8); // " arr="
    diag_buf_push_u32(mut_view(*out), stats.array_checks_eliminated);
    bce_push_tok(mut_view(*out), 9); // " slice="
    diag_buf_push_u32(mut_view(*out), stats.slice_checks_eliminated);
    bce_push_tok(mut_view(*out), 10); // " vec="
    diag_buf_push_u32(mut_view(*out), stats.vec_checks_eliminated);
    bce_push_tok(mut_view(*out), 11); // "\n"
    bce_push_tok(mut_view(*out), 1); // "}\n"
}
