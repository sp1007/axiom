@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// --- Pass Identifier & TransformationContract (`SPEC-73 AXS-INL-034.1`) ---

pub const PASS_COPY_MOVE_SROA: u16 = 13u16;

pub fn sroa_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_COPY_MOVE_SROA,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                           ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO |
                           ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ESCAPE_INFO,
        required_proofs: PROP_MASK_NO_ESCAPE | PROP_MASK_NO_ALIAS,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS,
        invalidated_analyses: ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO |
                              ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_REACHABLE | PROP_MASK_NO_ALIAS | PROP_MASK_PURE_CALL,
        postconditions: POSTCOND_ALL,
    }
}

