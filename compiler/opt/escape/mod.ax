    // 0..12   "escape_info "
    101u8, 115u8, 99u8, 97u8, 112u8, 101u8, 95u8, 105u8, 110u8, 102u8, 111u8, 32u8,
    // 12..19  "fn_sym="
    102u8, 110u8, 95u8, 115u8, 121u8, 109u8, 61u8,
    // 19..27  " locals="
    32u8, 108u8, 111u8, 99u8, 97u8, 108u8, 115u8, 61u8,
    // 27..34  " sites="
    32u8, 115u8, 105u8, 116u8, 101u8, 115u8, 61u8,
    // 34..37  " {\n"
    32u8, 123u8, 10u8,
    // 37..46  "  local _"
    32u8, 32u8, 108u8, 111u8, 99u8, 97u8, 108u8, 32u8, 95u8,
    // 46..53  " class="
    32u8, 99u8, 108u8, 97u8, 115u8, 115u8, 61u8,
    // 53..58  " set="
    32u8, 115u8, 101u8, 116u8, 61u8,
    // 58..67  " storage="
    32u8, 115u8, 116u8, 111u8, 114u8, 97u8, 103u8, 101u8, 61u8,
    // 67..75  " reason="
    32u8, 114u8, 101u8, 97u8, 115u8, 111u8, 110u8, 61u8,
    // 75..81  " size="
    32u8, 115u8, 105u8, 122u8, 101u8, 61u8,
    // 81..89  "  site #"
    32u8, 32u8, 115u8, 105u8, 116u8, 101u8, 32u8, 35u8,
    // 89..95  " kind="
    32u8, 107u8, 105u8, 110u8, 100u8, 61u8,
    // 95..100 " bb="
    32u8, 98u8, 98u8, 61u8, 98u8,
    // 100..108 " dest=_"
    32u8, 100u8, 101u8, 115u8, 116u8, 61u8, 95u8, 0u8,
    // 108..118 " promoted="
    32u8, 112u8, 114u8, 111u8, 109u8, 111u8, 116u8, 101u8, 100u8, 61u8,
    // 118..126 "NoEscape"
    78u8, 111u8, 69u8, 115u8, 99u8, 97u8, 112u8, 101u8,
    // 126..135 "ArgEscape"
    65u8, 114u8, 103u8, 69u8, 115u8, 99u8, 97u8, 112u8, 101u8,
    // 135..147 "ReturnEscape"
    82u8, 101u8, 116u8, 117u8, 114u8, 110u8, 69u8, 115u8, 99u8, 97u8, 112u8, 101u8,
    // 147..159 "GlobalEscape"
    71u8, 108u8, 111u8, 98u8, 97u8, 108u8, 69u8, 115u8, 99u8, 97u8, 112u8, 101u8,
    // 159..163 "Elim"
    69u8, 108u8, 105u8, 109u8,
    // 163..169 "SsaReg"
    83u8, 115u8, 97u8, 82u8, 101u8, 103u8,
    // 169..179 "LocalStack"
    76u8, 111u8, 99u8, 97u8, 108u8, 83u8, 116u8, 97u8, 99u8, 107u8,
    // 179..188 "CallerRet"
    67u8, 97u8, 108u8, 108u8, 101u8, 114u8, 82u8, 101u8, 116u8,
    // 188..197 "InlineBuf"
    73u8, 110u8, 108u8, 105u8, 110u8, 101u8, 66u8, 117u8, 102u8,
    // 197..201 "Heap"
    72u8, 101u8, 97u8, 112u8,
    // 201..210 "FixedMmio"
    70u8, 105u8, 120u8, 101u8, 100u8, 77u8, 109u8, 105u8, 111u8,
    // 210..219 "DeviceExt"
    68u8, 101u8, 118u8, 105u8, 99u8, 101u8, 69u8, 120u8, 116u8,
    // 219..236 "escape_promote {\n"
    101u8, 115u8, 99u8, 97u8, 112u8, 101u8, 95u8, 112u8, 114u8, 111u8, 109u8, 111u8, 116u8, 101u8, 32u8, 123u8, 10u8,
];

fn esc_push_tbl(out: mut_view<DiagBuffer>, off: usize, byte_len: usize) {
    let mut i: usize = 0;
    while i < byte_len {
        diag_buf_push_byte(mut_view(*out), ESC_PRINT_DATA[off + i]);
        i = i + 1;
    }
}

fn esc_push_u64(out: mut_view<DiagBuffer>, val: u64) {
    if val <= 0xFFFFFFFFu64 {
        diag_buf_push_u32(mut_view(*out), val as u32);
        return;
    }
    let hi = val / 1000000000u64;
    let lo = (val % 1000000000u64) as u32;
    esc_push_u64(mut_view(*out), hi);
    let mut div: u32 = 100000000u32;
    let mut rem: u32 = lo;
    while div > 0u32 {
        let d = (rem / div) as u8;
        diag_buf_push_byte(mut_view(*out), 48u8 + d);
        rem = rem % div;
        div = div / 10u32;
    }
}

fn esc_push_class_name(out: mut_view<DiagBuffer>, cls: u8) {
    if cls == ESCAPE_NO_ESCAPE {
        esc_push_tbl(mut_view(*out), 118, 8);
    } else if cls == ESCAPE_ARG_ESCAPE {
        esc_push_tbl(mut_view(*out), 126, 9);
    } else if cls == ESCAPE_RETURN_ESCAPE {
        esc_push_tbl(mut_view(*out), 135, 12);
    } else {
        esc_push_tbl(mut_view(*out), 147, 12);
    }
}

fn esc_push_storage_name(out: mut_view<DiagBuffer>, sdec: u8) {
    if sdec == STORAGE_DECISION_ELIMINATED {
        esc_push_tbl(mut_view(*out), 159, 4);
    } else if sdec == STORAGE_DECISION_SSA_REGISTER {
        esc_push_tbl(mut_view(*out), 163, 6);
    } else if sdec == STORAGE_DECISION_LOCAL_STACK {
        esc_push_tbl(mut_view(*out), 169, 10);
    } else if sdec == STORAGE_DECISION_CALLER_RET_SLOT {
        esc_push_tbl(mut_view(*out), 179, 9);
    } else if sdec == STORAGE_DECISION_INLINE_BUFFER {
        esc_push_tbl(mut_view(*out), 188, 9);
    } else if sdec == STORAGE_DECISION_FIXED_MMIO {
        esc_push_tbl(mut_view(*out), 201, 9);
    } else if sdec == STORAGE_DECISION_DEVICE_EXTERNAL {
        esc_push_tbl(mut_view(*out), 210, 9);
    } else {
        esc_push_tbl(mut_view(*out), 197, 4);
    }
}

pub fn escape_print(info: view<EscapeInfo>, out: mut_view<DiagBuffer>) {
    esc_push_tbl(mut_view(*out), 0, 12);
    esc_push_tbl(mut_view(*out), 12, 7);
    diag_buf_push_u32(mut_view(*out), info.fn_sym.v);
    esc_push_tbl(mut_view(*out), 19, 8);
    diag_buf_push_u32(mut_view(*out), info.local_count as u32);
    esc_push_tbl(mut_view(*out), 27, 7);
    diag_buf_push_u32(mut_view(*out), info.site_count as u32);
    esc_push_tbl(mut_view(*out), 34, 3);

    let mut l: usize = 0;
    while l < info.local_count && (info.locals as usize) != 0 {
        let lp = unsafe { escape_local_at(info.locals, l) };
        esc_push_tbl(mut_view(*out), 37, 9);
        diag_buf_push_u32(mut_view(*out), l as u32);
        esc_push_tbl(mut_view(*out), 46, 7);
        esc_push_class_name(mut_view(*out), unsafe { (*lp).escape_class });
        esc_push_tbl(mut_view(*out), 53, 5);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*lp).escape_set }) as u32);
        esc_push_tbl(mut_view(*out), 58, 9);
        esc_push_storage_name(mut_view(*out), unsafe { (*lp).storage_decision });
        esc_push_tbl(mut_view(*out), 67, 8);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*lp).reason }) as u32);
        esc_push_tbl(mut_view(*out), 75, 6);
        esc_push_u64(mut_view(*out), unsafe { (*lp).size_bytes });
        diag_buf_push_byte(mut_view(*out), 10u8);
        l = l + 1;
    }

    let mut s: usize = 0;
    while s < info.site_count && (info.sites as usize) != 0 {
        let sp = unsafe { escape_site_at(info.sites, s) };
        esc_push_tbl(mut_view(*out), 81, 8);
        diag_buf_push_u32(mut_view(*out), s as u32);
        esc_push_tbl(mut_view(*out), 89, 6);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*sp).kind }) as u32);
        esc_push_tbl(mut_view(*out), 95, 5);
        diag_buf_push_byte(mut_view(*out), 98u8);
        diag_buf_push_u32(mut_view(*out), unsafe { (*sp).alloc_bb });
        esc_push_tbl(mut_view(*out), 100, 7);
        diag_buf_push_u32(mut_view(*out), unsafe { (*sp).dest_local });
        esc_push_tbl(mut_view(*out), 46, 7);
        esc_push_class_name(mut_view(*out), unsafe { (*sp).escape_class });
        esc_push_tbl(mut_view(*out), 58, 9);
        esc_push_storage_name(mut_view(*out), unsafe { (*sp).storage_decision });
        esc_push_tbl(mut_view(*out), 67, 8);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*sp).reason }) as u32);
        esc_push_tbl(mut_view(*out), 108, 10);
        diag_buf_push_u32(mut_view(*out), if unsafe { (*sp).promoted } { 1u32 } else { 0u32 });
        diag_buf_push_byte(mut_view(*out), 10u8);
        s = s + 1;
    }

    diag_buf_push_byte(mut_view(*out), 125u8);
    diag_buf_push_byte(mut_view(*out), 10u8);
}

pub fn escape_promote_print(stats: view<EscapePromoteStats>, log: view<EscapePromoteLog>, out: mut_view<DiagBuffer>) {
    esc_push_tbl(mut_view(*out), 219, 17);
    let mut i: usize = 0;
    while i < log.count && (log.records as usize) != 0 {
        let rp = unsafe { escape_record_at(log.records, i) };
        esc_push_tbl(mut_view(*out), 81, 8);
        diag_buf_push_u32(mut_view(*out), i as u32);
        esc_push_tbl(mut_view(*out), 89, 6);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*rp).action }) as u32);
        esc_push_tbl(mut_view(*out), 58, 9);
        esc_push_storage_name(mut_view(*out), unsafe { (*rp).storage_decision });
        esc_push_tbl(mut_view(*out), 67, 8);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*rp).reason }) as u32);
        esc_push_tbl(mut_view(*out), 100, 7);
        diag_buf_push_u32(mut_view(*out), unsafe { (*rp).local_id });
        esc_push_tbl(mut_view(*out), 75, 6);
        esc_push_u64(mut_view(*out), unsafe { (*rp).size_bytes });
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1;
    }
    let _runs = stats.pass_runs;
    diag_buf_push_byte(mut_view(*out), 125u8);
    diag_buf_push_byte(mut_view(*out), 10u8);
}
