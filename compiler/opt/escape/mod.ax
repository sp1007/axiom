// --- Core Escape Analysis, Summary & Promotion Models (`SPEC-71 §§2-4`) ---

pub struct LocalEscapeState {
    pub local_id: u32,
    pub val_escape: u16,
    pub ind_escape: u16,
    pub escape_set: u16,
    pub escape_class: u8,
    pub no_escape_certainty: u8,
    pub storage_decision: u8,
    pub reason: u8,
    pub stable_address: bool,
    pub address_observable: bool,
    pub identity_compared: bool,
    pub is_fixed_mmio: bool,
    pub is_volatile_atomic: bool,
    pub is_zero_copy_pinned: bool,
    pub has_active_view_escape: bool,
    pub crosses_loop_backedge: bool,
    pub has_dynamic_realloc: bool,
    pub has_drop: bool,
    pub is_repr_c_abi: bool,
    pub borrow_taken: bool,
    pub mut_borrow_taken: bool,
    pub known_size: bool,
    pub size_bytes: u64,
    pub align_bytes: u64,
    pub alloc_site_idx: u32,
    pub reuse_partner_local: u32,
}

pub struct AllocSite {
    pub site_id: u32,
    pub kind: u8,
    pub alloc_bb: u32,
    pub alloc_inst: u32,
    pub dest_local: u32,
    pub raw_ptr_local: u32,
    pub payload_ty: TypeId,
    pub elem_ty: TypeId,
    pub elem_cap: u64,
    pub known_size: bool,
    pub size_bytes: u64,
    pub align_bytes: u64,
    pub free_bb: u32,
    pub has_matching_free: bool,
    pub has_realloc: bool,
    pub in_loop: bool,
    pub crosses_backedge: bool,
    pub escape_set: u16,
    pub escape_class: u8,
    pub storage_decision: u8,
    pub reason: u8,
    pub promoted: bool,
    pub promoted_local: u32,
}

@derive(Copy)
pub struct DisjointSlotPair {
    pub local_a: u32,
    pub local_b: u32,
    pub saved_bytes: u64,
}

pub struct FunctionEscapeSummary {
    pub fn_sym: SymbolId,
    pub param_count: usize,
    pub param_escapes: [16]u16,
    pub extra_param_escapes: *mut u16,
    pub extra_escapes_cap: u32,
    pub param_addr_observed_mask: u32,
    pub param_identity_compared_mask: u32,
    pub extra_param_obs_flags: *mut u8,
    pub extra_obs_cap: u32,
    pub returns_fresh_alloc: bool,
    pub ret_aliases_params_mask: u32,
    pub captures_into_global: bool,
    pub spawns_escape: bool,
    pub calls_ffi: bool,
    pub has_unknown_call: bool,
    pub is_alloc_fn: bool,
    pub is_free_fn: bool,
    pub is_realloc_fn: bool,
    pub is_box_new_fn: bool,
    pub is_box_into_raw_fn: bool,
    pub is_vec_with_cap_fn: bool,
    pub is_spawn_fn: bool,
}

pub struct EscapeSummaryEntry {
    pub callee_sym: SymbolId,
    pub summary: FunctionEscapeSummary,
}

pub struct EscapeSummaryTable {
    pub entries: *mut EscapeSummaryEntry,
    pub count: usize,
    pub cap: usize,
}

pub struct EscapeInfo {
    pub fn_sym: SymbolId,
    pub local_count: usize,
    pub locals: *mut LocalEscapeState,
    pub sites: *mut AllocSite,
    pub site_count: usize,
    pub site_cap: usize,
    pub disjoint_pairs: *mut DisjointSlotPair,
    pub disjoint_pair_count: usize,
    pub disjoint_pair_cap: usize,
    pub promoted_stack_bytes: u64,
    pub reused_stack_bytes: u64,
    pub summary: FunctionEscapeSummary,
}

@derive(Copy)
pub struct EscapePromoteRecord {
    pub is_barrier: bool,
    pub action: u8,
    pub storage_decision: u8,
    pub reason: u8,
    pub bb_idx: u32,
    pub local_id: u32,
    pub promoted_local: u32,
    pub size_bytes: u64,
}

@derive(Copy)
pub struct EscapePromoteStats {
    pub pass_runs: u32,
    pub pass_changes: u32,
    pub pass_rollbacks: u32,
    pub box_sroa_promotions: u32,
    pub box_stack_promotions: u32,
    pub closure_env_promotions: u32,
    pub closure_direct_calls: u32,
    pub inline_buffer_promotions: u32,
    pub nrvo_promotions: u32,
    pub disjoint_slot_reuses: u32,
    pub heap_retentions: u32,
    pub promoted_bytes: u64,
}

pub struct EscapePromoteLog {
    pub records: *mut EscapePromoteRecord,
    pub count: usize,
    pub cap: usize,
}

// --- Pointer Indexing Helpers ---

fn esc_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn escape_local_at(base: *mut LocalEscapeState, idx: usize) -> *mut LocalEscapeState {
    let off = esc_mul_usize(idx, size_of<LocalEscapeState>());
    ((base as usize) + off) as *mut LocalEscapeState
}

pub unsafe fn escape_site_at(base: *mut AllocSite, idx: usize) -> *mut AllocSite {
    let off = esc_mul_usize(idx, size_of<AllocSite>());
    ((base as usize) + off) as *mut AllocSite
}

pub unsafe fn escape_pair_at(base: *mut DisjointSlotPair, idx: usize) -> *mut DisjointSlotPair {
    let off = esc_mul_usize(idx, size_of<DisjointSlotPair>());
    ((base as usize) + off) as *mut DisjointSlotPair
}

pub unsafe fn escape_entry_at(base: *mut EscapeSummaryEntry, idx: usize) -> *mut EscapeSummaryEntry {
    let off = esc_mul_usize(idx, size_of<EscapeSummaryEntry>());
    ((base as usize) + off) as *mut EscapeSummaryEntry
}

pub unsafe fn escape_record_at(base: *mut EscapePromoteRecord, idx: usize) -> *mut EscapePromoteRecord {
    let off = esc_mul_usize(idx, size_of<EscapePromoteRecord>());
    ((base as usize) + off) as *mut EscapePromoteRecord
}

unsafe fn esc_u8_at(base: *mut u8, idx: usize) -> *mut u8 {
    ((base as usize) + idx) as *mut u8
}

unsafe fn esc_u16_at(base: *mut u16, idx: usize) -> *mut u16 {
    let off = esc_mul_usize(idx, size_of<u16>());
    ((base as usize) + off) as *mut u16
}

unsafe fn esc_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = esc_mul_usize(idx, size_of<u32>());
    ((base as usize) + off) as *mut u32
}

unsafe fn esc_u64_at(base: *mut u64, idx: usize) -> *mut u64 {
    let off = esc_mul_usize(idx, size_of<u64>());
    ((base as usize) + off) as *mut u64
}

unsafe fn esc_bool_at(base: *mut bool, idx: usize) -> *mut bool {
    let off = esc_mul_usize(idx, size_of<bool>());
    ((base as usize) + off) as *mut bool
}

pub unsafe fn esc_mir_body_ptr_at(base: *mut *mut MirBody, idx: usize) -> *mut *mut MirBody {
    let off = esc_mul_usize(idx, size_of<*mut MirBody>());
    ((base as usize) + off) as *mut *mut MirBody
}

pub fn escape_stats_zero() -> EscapePromoteStats {
    EscapePromoteStats {
        pass_runs: 0u32,
        pass_changes: 0u32,
        pass_rollbacks: 0u32,
        box_sroa_promotions: 0u32,
        box_stack_promotions: 0u32,
        closure_env_promotions: 0u32,
        closure_direct_calls: 0u32,
        inline_buffer_promotions: 0u32,
        nrvo_promotions: 0u32,
        disjoint_slot_reuses: 0u32,
        heap_retentions: 0u32,
        promoted_bytes: 0u64,
    }
}

pub fn escape_log_init(log: mut_view<EscapePromoteLog>, arena: mut_view<Arena>, initial_cap: usize) {
    let cap: usize = if initial_cap == 0 { 16 } else { initial_cap };
    log.records = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(cap, size_of<EscapePromoteRecord>()),
        align_of<EscapePromoteRecord>()
    ) as *mut EscapePromoteRecord;
    log.count = 0;
    log.cap = cap;
}

pub fn escape_log_push(log: *mut EscapePromoteLog, arena: mut_view<Arena>, rec: EscapePromoteRecord) {
    if (log as usize) == 0 {
        return;
    }
    let cnt = unsafe { (*log).count };
    let cap = unsafe { (*log).cap };
    if cnt >= cap {
        let new_cap: usize = if cap == 0 { 16 } else { cap + cap };
        let new_buf = arena_alloc_raw(
            mut_view(*arena),
            esc_mul_usize(new_cap, size_of<EscapePromoteRecord>()),
            align_of<EscapePromoteRecord>()
        ) as *mut EscapePromoteRecord;
        if cnt > 0 && (unsafe { (*log).records as usize }) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<EscapePromoteRecord>(
                    (*log).records as *const EscapePromoteRecord,
                    new_buf,
                    cnt
                );
            }
        }
        unsafe {
            (*log).records = new_buf;
            (*log).cap = new_cap;
        }
    }
    unsafe {
        let dst = escape_record_at((*log).records, cnt);
        *dst = rec;
        (*log).count = cnt + 1;
    }
}

// --- Zero-String-Literal Symbol Byte Patterns ---
// Offsets:
//   0..10  "heap_alloc"         (10)
//  10..19  "heap_free"          (9)
//  19..31  "heap_realloc"       (12)
//  31..38  "box_new"            (7)
//  38..50  "box_into_raw"       (12)
//  50..62  "box_from_raw"       (12)
//  62..79  "vec_with_capacity"  (17)
//  79..90  "vec_reserve"        (11)
//  90..95  "spawn"              (5)
//  95..98  "Box"                (3)
//  98..101 "Vec"                (3)
// 101..103 "at"                 (2)
// 103..107 "repr"               (4)
// 107..108 "C"                  (1)
// 108..119 "transparent"        (11)
// 119..127 "vec_push"           (8)
const ESC_IDENT_BYTES: [127]u8 = [
    104u8, 101u8, 97u8, 112u8, 95u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    104u8, 101u8, 97u8, 112u8, 95u8, 102u8, 114u8, 101u8, 101u8,
    104u8, 101u8, 97u8, 112u8, 95u8, 114u8, 101u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    98u8, 111u8, 120u8, 95u8, 110u8, 101u8, 119u8,
    98u8, 111u8, 120u8, 95u8, 105u8, 110u8, 116u8, 111u8, 95u8, 114u8, 97u8, 119u8,
    98u8, 111u8, 120u8, 95u8, 102u8, 114u8, 111u8, 109u8, 95u8, 114u8, 97u8, 119u8,
    118u8, 101u8, 99u8, 95u8, 119u8, 105u8, 116u8, 104u8, 95u8, 99u8, 97u8, 112u8, 97u8, 99u8, 105u8, 116u8, 121u8,
    118u8, 101u8, 99u8, 95u8, 114u8, 101u8, 115u8, 101u8, 114u8, 118u8, 101u8,
    115u8, 112u8, 97u8, 119u8, 110u8,
    66u8, 111u8, 120u8,
    86u8, 101u8, 99u8,
    97u8, 116u8,
    114u8, 101u8, 112u8, 114u8,
    67u8,
    116u8, 114u8, 97u8, 110u8, 115u8, 112u8, 97u8, 114u8, 101u8, 110u8, 116u8,
    118u8, 101u8, 99u8, 95u8, 112u8, 117u8, 115u8, 104u8,
];

fn esc_sv_matches_ident(sv: StrView, off: usize, byte_len: usize, allow_mono: bool) -> bool {
    if (sv.ptr as usize) == 0 || (sv.len) < byte_len {
        return false;
    }
    let mut i: usize = 0;
    while i < byte_len {
        let b = unsafe { *(sv.ptr + i) };
        if b != ESC_IDENT_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    if sv.len == byte_len {
        return true;
    }
    if !allow_mono {
        return false;
    }
    // Monomorphized instance names from `compiler.traits.mono`: `<name>_I<idx>E`, `<name>_S<sym>E`, or `<name>$...`
    let sep = unsafe { *(sv.ptr + byte_len) };
    if sep == 36u8 {
        return true;
    }
    if sep == 95u8 && sv.len >= byte_len + 3 {
        let tag = unsafe { *(sv.ptr + byte_len + 1) };
        if tag == 73u8 || tag == 83u8 {
            return true;
        }
    }
    false
}

// --- `FunctionEscapeSummary` & `EscapeSummaryTable` Operations (`AXS-ESC-003.1`, `REQ-OPT-043`) ---

pub fn escape_summary_zero(fn_sym: SymbolId, param_count: usize) -> FunctionEscapeSummary {
    FunctionEscapeSummary {
        fn_sym: SymbolId { v: fn_sym.v },
        param_count: param_count,
        param_escapes: [
            0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16,
            0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16,
        ],
        extra_param_escapes: 0 as *mut u16,
        extra_escapes_cap: 0u32,
        param_addr_observed_mask: 0u32,
        param_identity_compared_mask: 0u32,
        extra_param_obs_flags: 0 as *mut u8,
        extra_obs_cap: 0u32,
        returns_fresh_alloc: false,
        ret_aliases_params_mask: 0u32,
        captures_into_global: false,
        spawns_escape: false,
        calls_ffi: false,
        has_unknown_call: false,
        is_alloc_fn: false,
        is_free_fn: false,
        is_realloc_fn: false,
        is_box_new_fn: false,
        is_box_into_raw_fn: false,
        is_vec_with_cap_fn: false,
        is_spawn_fn: false,
    }
}

pub fn escape_summary_init(sum: mut_view<FunctionEscapeSummary>, fn_sym: SymbolId, param_count: usize) {
    *sum = escape_summary_zero(fn_sym, param_count);
}

fn esc_ensure_extra_obs_cap(
    sum: mut_view<FunctionEscapeSummary>,
    arena: mut_view<Arena>,
    needed_extra: usize
) {
    let old_cap = sum.extra_obs_cap as usize;
    if (sum.extra_param_obs_flags as usize) != 0 && needed_extra <= old_cap {
        return;
    }
    let doubled: usize = if old_cap == 0 { 32 } else { esc_mul_usize(old_cap, 2) };
    let new_cap: usize = if doubled >= needed_extra { doubled } else { needed_extra };
    let buf = arena_alloc_raw(mut_view(*arena), new_cap, 1) as *mut u8;
    let mut i: usize = 0;
    if (sum.extra_param_obs_flags as usize) != 0 {
        while i < old_cap {
            unsafe {
                *esc_u8_at(buf, i) = *esc_u8_at(sum.extra_param_obs_flags, i);
            }
            i = i + 1;
        }
    }
    while i < new_cap {
        unsafe {
            *esc_u8_at(buf, i) = 0u8;
        }
        i = i + 1;
    }
    sum.extra_param_obs_flags = buf;
    sum.extra_obs_cap = new_cap as u32;
}

fn esc_ensure_extra_escapes_cap(
    sum: mut_view<FunctionEscapeSummary>,
    arena: mut_view<Arena>,
    needed_extra: usize
) {
    let old_cap = sum.extra_escapes_cap as usize;
    if (sum.extra_param_escapes as usize) != 0 && needed_extra <= old_cap {
        return;
    }
    let doubled: usize = if old_cap == 0 { 16 } else { esc_mul_usize(old_cap, 2) };
    let new_cap: usize = if doubled >= needed_extra { doubled } else { needed_extra };
    let buf = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(new_cap, size_of<u16>()),
        align_of<u16>()
    ) as *mut u16;
    let mut i: usize = 0;
    if (sum.extra_param_escapes as usize) != 0 {
        while i < old_cap {
            unsafe {
                *esc_u16_at(buf, i) = *esc_u16_at(sum.extra_param_escapes, i);
            }
            i = i + 1;
        }
    }
    while i < new_cap {
        unsafe {
            *esc_u16_at(buf, i) = 0u16;
        }
        i = i + 1;
    }
    sum.extra_param_escapes = buf;
    sum.extra_escapes_cap = new_cap as u32;
}

pub fn escape_summary_param_addr_observed(sum: view<FunctionEscapeSummary>, param_idx: usize) -> bool {
    if param_idx >= sum.param_count {
        return false;
    }
    if param_idx < 32 {
        return (sum.param_addr_observed_mask & (1u32 << (param_idx as u32))) != 0u32;
    }
    let extra_idx = param_idx - 32;
    if (sum.extra_param_obs_flags as usize) != 0 && extra_idx < (sum.extra_obs_cap as usize) {
        return ((unsafe { *esc_u8_at(sum.extra_param_obs_flags, extra_idx) }) & 1u8) != 0u8;
    }
    false
}

pub fn escape_summary_param_identity_compared(sum: view<FunctionEscapeSummary>, param_idx: usize) -> bool {
    if param_idx >= sum.param_count {
        return false;
    }
    if param_idx < 32 {
        return (sum.param_identity_compared_mask & (1u32 << (param_idx as u32))) != 0u32;
    }
    let extra_idx = param_idx - 32;
    if (sum.extra_param_obs_flags as usize) != 0 && extra_idx < (sum.extra_obs_cap as usize) {
        return ((unsafe { *esc_u8_at(sum.extra_param_obs_flags, extra_idx) }) & 2u8) != 0u8;
    }
    false
}

pub fn escape_summary_set_param_observability(
    sum: mut_view<FunctionEscapeSummary>,
    arena: mut_view<Arena>,
    param_idx: usize,
    addr_obs: bool,
    ident_cmp: bool
) {
    if !addr_obs && !ident_cmp {
        return;
    }
    if param_idx >= sum.param_count {
        sum.param_count = param_idx + 1;
    }
    if param_idx < 32 {
        let bit = 1u32 << (param_idx as u32);
        if addr_obs {
            sum.param_addr_observed_mask = sum.param_addr_observed_mask | bit;
        }
        if ident_cmp {
            sum.param_identity_compared_mask = sum.param_identity_compared_mask | bit;
        }
        return;
    }
    let extra_idx = param_idx - 32;
    let needed_extra: usize = if sum.param_count - 32 > extra_idx + 1 { sum.param_count - 32 } else { extra_idx + 1 };
    esc_ensure_extra_obs_cap(mut_view(*sum), mut_view(*arena), needed_extra);
    let mut flg: u8 = unsafe { *esc_u8_at(sum.extra_param_obs_flags, extra_idx) };
    if addr_obs { flg = flg | 1u8; }
    if ident_cmp { flg = flg | 2u8; }
    unsafe {
        *esc_u8_at(sum.extra_param_obs_flags, extra_idx) = flg;
    }
}

pub fn escape_summary_param_escape(sum: view<FunctionEscapeSummary>, param_idx: usize) -> u16 {
    if param_idx >= sum.param_count {
        return ESC_UNKNOWN;
    }
    if param_idx < 16 {
        return sum.param_escapes[param_idx];
    }
    let extra_idx = param_idx - 16;
    if (sum.extra_param_escapes as usize) != 0 && extra_idx < (sum.extra_escapes_cap as usize) {
        return unsafe { *esc_u16_at(sum.extra_param_escapes, extra_idx) };
    }
    ESC_NONE
}

pub fn escape_summary_set_param_escape(
    sum: mut_view<FunctionEscapeSummary>,
    arena: mut_view<Arena>,
    param_idx: usize,
    esc: u16
) {
    if param_idx >= sum.param_count {
        sum.param_count = param_idx + 1;
    }
    if param_idx < 16 {
        sum.param_escapes[param_idx] = esc;
        return;
    }
    let extra_idx = param_idx - 16;
    let needed_extra: usize = if sum.param_count - 16 > extra_idx + 1 { sum.param_count - 16 } else { extra_idx + 1 };
    esc_ensure_extra_escapes_cap(mut_view(*sum), mut_view(*arena), needed_extra);
    unsafe {
        *esc_u16_at(sum.extra_param_escapes, extra_idx) = esc;
    }
}

pub fn escape_summary_join(
    dst: mut_view<FunctionEscapeSummary>,
    src: view<FunctionEscapeSummary>,
    arena: mut_view<Arena>
) -> bool {
    let mut changed = false;
    let prev_dst_cnt = dst.param_count;
    let target_cnt: usize = if src.param_count > prev_dst_cnt { src.param_count } else { prev_dst_cnt };
    if target_cnt > prev_dst_cnt {
        dst.param_count = target_cnt;
        changed = true;
    }
    let mut p: usize = 0;
    while p < target_cnt {
        let old_e: u16 = if p < prev_dst_cnt { escape_summary_param_escape(view(*dst), p) } else { ESC_NONE };
        let add_e: u16 = if p < src.param_count { escape_summary_param_escape(src, p) } else { ESC_NONE };
        let joined = escape_set_join(old_e, add_e);
        if joined != old_e {
            escape_summary_set_param_escape(mut_view(*dst), mut_view(*arena), p, joined);
            changed = true;
        }
        let old_obs: bool = if p < prev_dst_cnt { escape_summary_param_addr_observed(view(*dst), p) } else { false };
        let add_obs: bool = if p < src.param_count { escape_summary_param_addr_observed(src, p) } else { false };
        let old_id: bool = if p < prev_dst_cnt { escape_summary_param_identity_compared(view(*dst), p) } else { false };
        let add_id: bool = if p < src.param_count { escape_summary_param_identity_compared(src, p) } else { false };
        if (add_obs && !old_obs) || (add_id && !old_id) {
            escape_summary_set_param_observability(mut_view(*dst), mut_view(*arena), p, old_obs || add_obs, old_id || add_id);
            changed = true;
        }
        p = p + 1;
    }
    if src.returns_fresh_alloc && !dst.returns_fresh_alloc {
        dst.returns_fresh_alloc = true;
        changed = true;
    }
    let new_mask = dst.ret_aliases_params_mask | src.ret_aliases_params_mask;
    if new_mask != dst.ret_aliases_params_mask {
        dst.ret_aliases_params_mask = new_mask;
        changed = true;
    }
    if src.captures_into_global && !dst.captures_into_global {
        dst.captures_into_global = true;
        changed = true;
    }
    if src.spawns_escape && !dst.spawns_escape {
        dst.spawns_escape = true;
        changed = true;
    }
    if src.calls_ffi && !dst.calls_ffi {
        dst.calls_ffi = true;
        changed = true;
    }
    if src.has_unknown_call && !dst.has_unknown_call {
        dst.has_unknown_call = true;
        changed = true;
    }
    if src.is_alloc_fn { dst.is_alloc_fn = true; }
    if src.is_free_fn { dst.is_free_fn = true; }
    if src.is_realloc_fn { dst.is_realloc_fn = true; }
    if src.is_box_new_fn { dst.is_box_new_fn = true; }
    if src.is_box_into_raw_fn { dst.is_box_into_raw_fn = true; }
    if src.is_vec_with_cap_fn { dst.is_vec_with_cap_fn = true; }
    if src.is_spawn_fn { dst.is_spawn_fn = true; }
    changed
}


pub fn escape_summary_table_init(table: mut_view<EscapeSummaryTable>, arena: mut_view<Arena>, initial_cap: usize) {
    let cap: usize = if initial_cap == 0 { 16 } else { initial_cap };
    table.entries = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(cap, size_of<EscapeSummaryEntry>()),
        align_of<EscapeSummaryEntry>()
    ) as *mut EscapeSummaryEntry;
    table.count = 0;
    table.cap = cap;
}

pub fn escape_summary_table_register(
    table: mut_view<EscapeSummaryTable>,
    arena: mut_view<Arena>,
    callee_sym: SymbolId,
    summary: FunctionEscapeSummary
) {
    if callee_sym.v == 0u32 {
        return;
    }
    let mut i: usize = 0;
    while i < table.count {
        let ep = unsafe { escape_entry_at(table.entries, i) };
        if (unsafe { (*ep).callee_sym.v }) == callee_sym.v {
            unsafe { (*ep).summary = summary; }
            return;
        }
        i = i + 1;
    }
    if table.count >= table.cap {
        let new_cap: usize = if table.cap == 0 { 16 } else { table.cap + table.cap };
        let new_buf = arena_alloc_raw(
            mut_view(*arena),
            esc_mul_usize(new_cap, size_of<EscapeSummaryEntry>()),
            align_of<EscapeSummaryEntry>()
        ) as *mut EscapeSummaryEntry;
        if table.count > 0 && (table.entries as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<EscapeSummaryEntry>(
                    table.entries as *const EscapeSummaryEntry,
                    new_buf,
                    table.count
                );
            }
        }
        table.entries = new_buf;
        table.cap = new_cap;
    }
    let dst = unsafe { escape_entry_at(table.entries, table.count) };
    unsafe {
        (*dst).callee_sym = SymbolId { v: callee_sym.v };
        (*dst).summary = summary;
    }
    table.count = table.count + 1;
}

pub fn escape_summary_table_lookup(
    table: *const EscapeSummaryTable,
    callee_sym: SymbolId,
    out_summary: mut_view<FunctionEscapeSummary>
) -> bool {
    if (table as usize) == 0 || callee_sym.v == 0u32 {
        return false;
    }
    let cnt = unsafe { (*table).count };
    let entries = unsafe { (*table).entries };
    let mut i: usize = 0;
    while i < cnt && (entries as usize) != 0 {
        let ep = unsafe { escape_entry_at(entries, i) };
        if (unsafe { (*ep).callee_sym.v }) == callee_sym.v {
            *out_summary = unsafe { (*ep).summary };
            return true;
        }
        i = i + 1;
    }
    false
}

fn esc_count_hir_params(item: *const HirItem) -> usize {
    if (item as usize) == 0 {
        return 0;
    }
    let mut cnt: usize = 0;
    let mut p = unsafe { (*item).params };
    while (p as usize) != 0 {
        cnt = cnt + 1;
        p = unsafe { (*p).next };
    }
    cnt
}

pub fn escape_register_hir_item(
    table: mut_view<EscapeSummaryTable>,
    item: *const HirItem,
    in_extern_block: bool,
    str_in: view<StrInterner>,
    arena: mut_view<Arena>
) {
    if (item as usize) == 0 {
        return;
    }
    let k = unsafe { (*item).kind };
    if k == HIR_ITEM_EXTERN_BLOCK || k == HIR_ITEM_IMPL || k == HIR_ITEM_TRAIT {
        let is_ext = in_extern_block || (k == HIR_ITEM_EXTERN_BLOCK);
        let mut mem = unsafe { (*item).members };
        while (mem as usize) != 0 {
            escape_register_hir_item(mut_view(*table), mem as *const HirItem, is_ext, str_in, mut_view(*arena));
            mem = unsafe { (*mem).next };
        }
        return;
    }
    if k != HIR_ITEM_FN {
        return;
    }
    let sym_v = unsafe { (*item).symbol.v };
    if sym_v == 0u32 {
        return;
    }
    let pcnt = esc_count_hir_params(item);
    let sv = interner_get(str_in, StrId { v: unsafe { (*item).name.v } });

    // Recognize core allocator, Box, Vec, and thread-spawn runtime/stdlib symbols
    if esc_sv_matches_ident(sv, 0, 10, false) {
        // heap_alloc(size, align) -> *mut u8
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, 2);
        s.returns_fresh_alloc = true;
        s.is_alloc_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if esc_sv_matches_ident(sv, 10, 9, false) {
        // heap_free(ptr, size, align) — consumes allocation without escaping it to heap/FFI
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, 3);
        escape_summary_set_param_escape(mut_view(s), mut_view(*arena), 0, ESC_ARGUMENT);
        s.is_free_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if esc_sv_matches_ident(sv, 19, 12, false) {
        // heap_realloc(ptr, old_size, new_size, align) -> *mut u8
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, 4);
        escape_summary_set_param_escape(mut_view(s), mut_view(*arena), 0, ESC_RETURN);
        s.returns_fresh_alloc = true;
        s.ret_aliases_params_mask = 1u32;
        s.is_realloc_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if esc_sv_matches_ident(sv, 31, 7, true) {
        // box_new<T>(val: T) -> Box<T>: moves `val` into returned Box (`ESC_RETURN`)
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, 1);
        escape_summary_set_param_escape(mut_view(s), mut_view(*arena), 0, ESC_RETURN);
        s.returns_fresh_alloc = true;
        s.ret_aliases_params_mask = 1u32;
        s.is_box_new_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if esc_sv_matches_ident(sv, 38, 12, true) {
        // box_into_raw<T>(b: Box<T>) -> *mut T: leaks Box allocation into raw pointer return
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, 1);
        escape_summary_set_param_escape(mut_view(s), mut_view(*arena), 0, ESC_RETURN | ESC_EXTERNAL);
        escape_summary_set_param_observability(mut_view(s), mut_view(*arena), 0, true, false);
        s.ret_aliases_params_mask = 1u32;
        s.is_box_into_raw_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if esc_sv_matches_ident(sv, 62, 17, true) {
        // vec_with_capacity<T>(cap: usize) -> Vec<T>
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, 1);
        s.returns_fresh_alloc = true;
        s.is_vec_with_cap_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if esc_sv_matches_ident(sv, 79, 11, true) {
        // vec_reserve<T>(v: mut_view<Vec<T>>, additional: usize)
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, 2);
        escape_summary_set_param_escape(mut_view(s), mut_view(*arena), 0, ESC_ARGUMENT);
        s.is_realloc_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if esc_sv_matches_ident(sv, 119, 8, true) {
        // vec_push<T>(v: mut_view<Vec<T>>, val: T): may internally reallocate when len == cap
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, 2);
        escape_summary_set_param_escape(mut_view(s), mut_view(*arena), 0, ESC_ARGUMENT);
        escape_summary_set_param_escape(mut_view(s), mut_view(*arena), 1, ESC_HEAP);
        s.is_realloc_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if esc_sv_matches_ident(sv, 90, 5, true) {
        // spawn(...) — crosses thread / async task boundary (`ESC_THREAD`, `AXS-ESC-004` rule 5)
        let arity: usize = if pcnt == 0 { 1 } else { pcnt };
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, arity);
        let mut pi: usize = 0;
        while pi < arity {
            escape_summary_set_param_escape(mut_view(s), mut_view(*arena), pi, ESC_THREAD);
            pi = pi + 1;
        }
        s.spawns_escape = true;
        s.is_spawn_fn = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
        return;
    }
    if in_extern_block {
        // Unannotated `extern` FFI call boundary (`AXS-ESC-004` rule 7, `REQ-OPT-314`): `ESC_EXTERNAL`
        let mut s = escape_summary_zero(SymbolId { v: sym_v }, pcnt);
        let mut pi: usize = 0;
        while pi < pcnt {
            escape_summary_set_param_escape(mut_view(s), mut_view(*arena), pi, ESC_EXTERNAL);
            pi = pi + 1;
        }
        s.calls_ffi = true;
        escape_summary_table_register(mut_view(*table), mut_view(*arena), SymbolId { v: sym_v }, s);
    }
}

pub fn escape_register_hir_file(
    table: mut_view<EscapeSummaryTable>,
    file: *const HirFile,
    str_in: view<StrInterner>,
    arena: mut_view<Arena>
) {
    if (file as usize) == 0 {
        return;
    }
    let mut it = unsafe { (*file).items };
    while (it as usize) != 0 {
        escape_register_hir_item(mut_view(*table), it as *const HirItem, false, str_in, mut_view(*arena));
        it = unsafe { (*it).next };
    }
}

// --- Type Layout, Indirection & Constant Size Evaluation Helpers ---

fn esc_align_up(val: u64, align: u64) -> u64 {
    if align <= 1u64 {
        return val;
    }
    let rem = val % align;
    if rem == 0u64 { val } else { val + (align - rem) }
}

fn esc_type_byte_size_depth(
    thir: *const Thir,
    ty: TypeId,
    depth: u32,
    out_known: mut_view<bool>,
    out_align: mut_view<u64>
) -> u64 {
    *out_known = false;
    *out_align = 1u64;
    let ty_v = ty.v;
    if (thir as usize) == 0 || ty_v == 0u32 || depth > 16u32 {
        return 0u64;
    }
    let tp = type_get(unsafe { view((*thir).interner) }, TypeId { v: ty_v });
    if (tp as usize) == 0 {
        return 0u64;
    }
    let tk = unsafe { (*tp).kind };
    if tk == TY_UNIT || tk == TY_NEVER {
        *out_known = true;
        *out_align = 1u64;
        return 0u64;
    }
    if tk == TY_BOOL || tk == TY_I8 || tk == TY_U8 {
        *out_known = true;
        *out_align = 1u64;
        return 1u64;
    }
    if tk == TY_I16 || tk == TY_U16 {
        *out_known = true;
        *out_align = 2u64;
        return 2u64;
    }
    if tk == TY_CHAR || tk == TY_I32 || tk == TY_U32 {
        *out_known = true;
        *out_align = 4u64;
        return 4u64;
    }
    if tk == TY_I64 || tk == TY_U64 || tk == TY_ISIZE || tk == TY_USIZE || tk == TY_PTR || tk == TY_FN {
        *out_known = true;
        *out_align = 8u64;
        return 8u64;
    }
    if tk == TY_VIEW || tk == TY_MUT_VIEW {
        let pty = TypeId { v: unsafe { (*tp).pointee.v } };
        let ptp = type_get(unsafe { view((*thir).interner) }, pty);
        let ptk: u8 = if (ptp as usize) != 0 { unsafe { (*ptp).kind } } else { 0u8 };
        *out_known = true;
        *out_align = 8u64;
        return if ptk == TY_SLICE || ptk == TY_STR { 16u64 } else { 8u64 };
    }
    if tk == TY_I128 || tk == TY_U128 || tk == TY_STR {
        *out_known = true;
        *out_align = 8u64;
        return 16u64;
    }
    if tk == TY_ARRAY {
        let mut eok = false;
        let mut eal: u64 = 1u64;
        let esz = esc_type_byte_size_depth(thir, TypeId { v: unsafe { (*tp).elem.v } }, depth + 1u32, mut_view(eok), mut_view(eal));
        if eok {
            let alen = unsafe { (*tp).array_len };
            if esz == 0u64 || alen <= (0xFFFFFFFFu64 / esz) {
                *out_known = true;
                *out_align = eal;
                return esz * alen;
            }
        }
        return 0u64;
    }
    if tk == TY_STRUCT || tk == TY_TUPLE {
        let fcnt = unsafe { (*tp).field_count };
        let flds = unsafe { (*tp).fields };
        if fcnt > 0 && (flds as usize) == 0 {
            return 0u64;
        }
        let mut off: u64 = 0u64;
        let mut max_al: u64 = 1u64;
        let mut fi: usize = 0;
        while fi < fcnt {
            let fty = TypeId { v: unsafe { (*typeid_at(flds, fi)).v } };
            let mut fok = false;
            let mut fal: u64 = 1u64;
            let fsz = esc_type_byte_size_depth(thir, fty, depth + 1u32, mut_view(fok), mut_view(fal));
            if !fok {
                return 0u64;
            }
            if fal > max_al {
                max_al = fal;
            }
            off = esc_align_up(off, fal) + fsz;
            fi = fi + 1;
        }
        *out_known = true;
        *out_align = max_al;
        return esc_align_up(off, max_al);
    }
    if tk == TY_CLOSURE {
        // Closure layout: fn pointer (8B) + captured fields
        let ccnt = unsafe { (*tp).capture_count };
        let caps = unsafe { (*tp).captures };
        let mut off: u64 = 8u64;
        let mut max_al: u64 = 8u64;
        let mut ci: usize = 0;
        while ci < ccnt && (caps as usize) != 0 {
            let cp = unsafe { capture_at(caps, ci) };
            let cty = TypeId { v: unsafe { (*cp).ty.v } };
            let mut cok = false;
            let mut cal: u64 = 1u64;
            let csz = esc_type_byte_size_depth(thir, cty, depth + 1u32, mut_view(cok), mut_view(cal));
            if !cok {
                return 0u64;
            }
            if cal > max_al {
                max_al = cal;
            }
            off = esc_align_up(off, cal) + csz;
            ci = ci + 1;
        }
        *out_known = true;
        *out_align = max_al;
        return esc_align_up(off, max_al);
    }
    if tk == TY_ENUM {
        let vcnt = unsafe { (*tp).variant_count };
        let vflds = unsafe { (*tp).variant_fields };
        let vcnts = unsafe { (*tp).variant_field_counts };
        let mut max_payload: u64 = 0u64;
        let mut max_al: u64 = 8u64;
        let mut vi: usize = 0;
        while vi < vcnt && (vflds as usize) != 0 && (vcnts as usize) != 0 {
            let fc = unsafe { *usize_at(vcnts, vi) };
            let fp = unsafe { *typeid_ptr_at(vflds, vi) };
            let mut voff: u64 = 0u64;
            let mut vj: usize = 0;
            while vj < fc && (fp as usize) != 0 {
                let fty = TypeId { v: unsafe { (*typeid_at(fp, vj)).v } };
                let mut fok = false;
                let mut fal: u64 = 1u64;
                let fsz = esc_type_byte_size_depth(thir, fty, depth + 1u32, mut_view(fok), mut_view(fal));
                if !fok {
                    return 0u64;
                }
                if fal > max_al {
                    max_al = fal;
                }
                voff = esc_align_up(voff, fal) + fsz;
                vj = vj + 1;
            }
            if voff > max_payload {
                max_payload = voff;
            }
            vi = vi + 1;
        }
        *out_known = true;
        *out_align = max_al;
        return esc_align_up(8u64 + max_payload, max_al);
    }
    let mut al_ok = false;
    let al_sz = alias_type_byte_size(thir, TypeId { v: ty_v }, mut_view(al_ok));
    if al_ok {
        *out_known = true;
        *out_align = if al_sz >= 8u64 { 8u64 } else if al_sz >= 4u64 { 4u64 } else if al_sz >= 2u64 { 2u64 } else { 1u64 };
        return al_sz;
    }
    0u64
}

pub fn escape_type_byte_size(
    thir: *const Thir,
    ty: TypeId,
    out_known: mut_view<bool>,
    out_align: mut_view<u64>
) -> u64 {
    esc_type_byte_size_depth(thir, ty, 0u32, out_known, out_align)
}

fn esc_type_is_repr_c(thir: *const Thir, ty: TypeId) -> bool {
    if (thir as usize) == 0 || ty.v == 0u32 {
        return false;
    }
    let tp = type_get(unsafe { view((*thir).interner) }, ty);
    if (tp as usize) == 0 {
        return false;
    }
    unsafe { (*tp).is_repr_c }
}

fn esc_type_has_indirection(thir: *const Thir, ty: TypeId, depth: u32) -> bool {
    if (thir as usize) == 0 || ty.v == 0u32 || depth > 12u32 {
        return true;
    }
    let tp = type_get(unsafe { view((*thir).interner) }, ty);
    if (tp as usize) == 0 {
        return true;
    }
    let tk = unsafe { (*tp).kind };
    if tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW || tk == TY_SLICE || tk == TY_STR {
        return true;
    }
    if tk == TY_BOOL || tk == TY_CHAR || tk == TY_UNIT || tk == TY_NEVER || tk == TY_FN ||
       tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_I128 || tk == TY_ISIZE ||
       tk == TY_U8 || tk == TY_U16 || tk == TY_U32 || tk == TY_U64 || tk == TY_U128 || tk == TY_USIZE {
        return false;
    }
    if tk == TY_ARRAY {
        return esc_type_has_indirection(thir, TypeId { v: unsafe { (*tp).elem.v } }, depth + 1u32);
    }
    if tk == TY_STRUCT || tk == TY_TUPLE {
        let fcnt = unsafe { (*tp).field_count };
        let flds = unsafe { (*tp).fields };
        let mut i: usize = 0;
        while i < fcnt && (flds as usize) != 0 {
            let fty = TypeId { v: unsafe { (*typeid_at(flds, i)).v } };
            if esc_type_has_indirection(thir, fty, depth + 1u32) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if tk == TY_CLOSURE {
        // Every closure carries a code pointer + capture environment and is an escape-tracked subject (`AXS-ESC-012`)
        return true;
    }
    true
}

fn esc_callee_env_has_indirection(thir: *const Thir, ty: TypeId) -> bool {
    if (thir as usize) == 0 || ty.v == 0u32 {
        return true;
    }
    let tp = type_get(unsafe { view((*thir).interner) }, ty);
    if (tp as usize) == 0 {
        return true;
    }
    let tk = unsafe { (*tp).kind };
    if tk == TY_FN {
        return false;
    }
    if tk == TY_CLOSURE {
        let ccnt = unsafe { (*tp).capture_count };
        let caps = unsafe { (*tp).captures };
        let mut ci: usize = 0;
        while ci < ccnt && (caps as usize) != 0 {
            let cp = unsafe { capture_at(caps, ci) };
            let cty = TypeId { v: unsafe { (*cp).ty.v } };
            if esc_type_has_indirection(thir, cty, 0u32) {
                return true;
            }
            ci = ci + 1;
        }
        return false;
    }
    esc_type_has_indirection(thir, (TypeId { v: unsafe { (*tp).pointee.v } }), 0u32)
}

fn esc_type_is_box_like(thir: *const Thir, ty: TypeId, out_payload_ty: mut_view<TypeId>) -> bool {
    *out_payload_ty = TypeId { v: 0u32 };
    if (thir as usize) == 0 || ty.v == 0u32 {
        return false;
    }
    let tp = type_get(unsafe { view((*thir).interner) }, ty);
    if (tp as usize) == 0 {
        return false;
    }
    let fcnt = unsafe { (*tp).field_count };
    if (unsafe { (*tp).kind }) != TY_STRUCT || (fcnt != 1 && fcnt != 2) || (unsafe { (*tp).arg_count }) != 1 {
        return false;
    }
    if (unsafe { (*tp).fields as usize }) == 0 || (unsafe { (*tp).args as usize }) == 0 {
        return false;
    }
    if fcnt == 2 {
        let f1 = TypeId { v: unsafe { (*typeid_at((*tp).fields, 1)).v } };
        let mut f1_ok = false;
        let mut f1_al: u64 = 1u64;
        if esc_type_byte_size_depth(thir, f1, 1u32, mut_view(f1_ok), mut_view(f1_al)) != 0u64 || !f1_ok {
            return false;
        }
    }
    let f0 = TypeId { v: unsafe { (*typeid_at((*tp).fields, 0)).v } };
    let a0 = TypeId { v: unsafe { (*typeid_at((*tp).args, 0)).v } };
    let f0p = type_get(unsafe { view((*thir).interner) }, f0);
    if (f0p as usize) == 0 || (unsafe { (*f0p).kind }) != TY_PTR || !(unsafe { (*f0p).is_mut }) {
        return false;
    }
    if (unsafe { (*f0p).pointee.v }) != a0.v {
        return false;
    }
    *out_payload_ty = a0;
    true
}

fn esc_place_projected_type(body: view<OptBody>, pl: view<MirPlace>) -> TypeId {
    let lv = pl.local.v as usize;
    if (body.local_tys as usize) == 0 || lv >= body.local_count {
        return TypeId { v: 0u32 };
    }
    let mut cur_ty_v: u32 = unsafe { (*opt_typeid_at(body.local_tys, lv)).v };
    if pl.proj_count == 0 {
        return TypeId { v: cur_ty_v };
    }
    if (body.thir as usize) == 0 || cur_ty_v == 0u32 || (pl.projs as usize) == 0 {
        return TypeId { v: 0u32 };
    }
    let mut has_downcast = false;
    let mut downcast_var: usize = 0;
    let mut i: usize = 0;
    while i < pl.proj_count {
        if cur_ty_v == 0u32 {
            return TypeId { v: 0u32 };
        }
        let tp = type_get(unsafe { view((*body.thir).interner) }, TypeId { v: cur_ty_v });
        if (tp as usize) == 0 {
            return TypeId { v: 0u32 };
        }
        let tk = unsafe { (*tp).kind };
        let pr = unsafe { mir_proj_at(pl.projs, i) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_DEREF {
            has_downcast = false;
            if tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW {
                cur_ty_v = unsafe { (*tp).pointee.v };
            } else {
                let mut bpty = TypeId { v: 0u32 };
                if esc_type_is_box_like(body.thir, (TypeId { v: cur_ty_v }), mut_view(bpty)) {
                    cur_ty_v = bpty.v;
                } else {
                    return TypeId { v: 0u32 };
                }
            }
        } else if pk == MIR_PROJ_FIELD {
            let fidx = unsafe { (*pr).field_idx } as usize;
            if tk == TY_STRUCT || tk == TY_TUPLE {
                has_downcast = false;
                if fidx < (unsafe { (*tp).field_count }) && (unsafe { (*tp).fields as usize }) != 0 {
                    cur_ty_v = unsafe { (*typeid_at((*tp).fields, fidx)).v };
                } else {
                    return TypeId { v: 0u32 };
                }
            } else if tk == TY_CLOSURE {
                has_downcast = false;
                if fidx == 0 {
                    cur_ty_v = unsafe { (*tp).fn_type.v };
                } else if (fidx - 1) < (unsafe { (*tp).capture_count }) && (unsafe { (*tp).captures as usize }) != 0 {
                    let cp = unsafe { capture_at((*tp).captures, fidx - 1) };
                    cur_ty_v = unsafe { (*cp).ty.v };
                } else {
                    return TypeId { v: 0u32 };
                }
            } else if tk == TY_ENUM && has_downcast {
                has_downcast = false;
                if downcast_var < (unsafe { (*tp).variant_count }) &&
                   (unsafe { (*tp).variant_fields as usize }) != 0 &&
                   (unsafe { (*tp).variant_field_counts as usize }) != 0 {
                    let fc = unsafe { *usize_at((*tp).variant_field_counts, downcast_var) };
                    let fp = unsafe { *typeid_ptr_at((*tp).variant_fields, downcast_var) };
                    if fidx < fc && (fp as usize) != 0 {
                        cur_ty_v = unsafe { (*typeid_at(fp, fidx)).v };
                    } else {
                        return TypeId { v: 0u32 };
                    }
                } else {
                    return TypeId { v: 0u32 };
                }
            } else {
                return TypeId { v: 0u32 };
            }
        } else if pk == MIR_PROJ_INDEX {
            has_downcast = false;
            if tk == TY_ARRAY || tk == TY_SLICE {
                cur_ty_v = unsafe { (*tp).elem.v };
            } else {
                return TypeId { v: 0u32 };
            }
        } else if pk == MIR_PROJ_DOWNCAST {
            has_downcast = true;
            downcast_var = unsafe { (*pr).variant_idx } as usize;
        } else {
            return TypeId { v: 0u32 };
        }
        i = i + 1;
    }
    TypeId { v: cur_ty_v }
}

fn esc_place_projected_has_indirection(body: view<OptBody>, pl: view<MirPlace>) -> bool {
    let pty = esc_place_projected_type(body, pl);
    esc_type_has_indirection(body.thir, pty, 0u32)
}


fn esc_extract_callee_sym(body: view<OptBody>, func_op: view<MirOperand>) -> SymbolId {
    if func_op.kind == MIR_OP_CONST {
        let cv = func_op.constant.val as u32;
        if cv != 0u32 {
            return SymbolId { v: cv };
        }
        if func_op.constant.sym.v != 0u32 {
            return SymbolId { v: func_op.constant.sym.v };
        }
        if (body.thir as usize) != 0 && func_op.constant.ty.v != 0u32 {
            let tp = type_get(unsafe { view((*body.thir).interner) }, TypeId { v: func_op.constant.ty.v });
            if (tp as usize) != 0 && (unsafe { (*tp).fn_sym }) != 0u32 {
                return SymbolId { v: unsafe { (*tp).fn_sym } };
            }
        }
        return SymbolId { v: 0u32 };
    }
    if (func_op.kind == MIR_OP_COPY || func_op.kind == MIR_OP_MOVE) && func_op.place.proj_count == 0 {
        let lv_u32 = func_op.place.local.v;
        let lv = lv_u32 as usize;
        if lv < body.local_count && (body.thir as usize) != 0 && (body.local_tys as usize) != 0 {
            let lty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, lv)).v } };
            let tp = type_get(unsafe { view((*body.thir).interner) }, lty);
            if (tp as usize) != 0 {
                let tk = unsafe { (*tp).kind };
                if (tk == TY_CLOSURE || tk == TY_FN) && (unsafe { (*tp).fn_sym }) != 0u32 {
                    return SymbolId { v: unsafe { (*tp).fn_sym } };
                }
            }
        }
        if lv < body.local_count && alias_count_local_defs(body, lv_u32) == 1u32 {
            let mut b: usize = 0;
            while b < body.bb_count && (body.blocks as usize) != 0 {
                let bb = unsafe { opt_block_at(body.blocks, b) };
                let icnt = unsafe { (*bb).inst_count };
                let mut i: usize = 0;
                while i < icnt {
                    let inst = unsafe { opt_inst_at((*bb).insts, i) };
                    if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                       (unsafe { (*inst).orig_stmt.place.proj_count }) == 0 &&
                       (unsafe { (*inst).orig_stmt.place.local.v }) == lv_u32 &&
                       (unsafe { (*inst).orig_stmt.rvalue.kind }) == MIR_RVALUE_USE &&
                       (unsafe { (*inst).orig_stmt.rvalue.use_op.kind }) == MIR_OP_CONST {
                        let c_val = (unsafe { (*inst).orig_stmt.rvalue.use_op.constant.val }) as u32;
                        if c_val != 0u32 {
                            return SymbolId { v: c_val };
                        }
                        let c_sym = unsafe { (*inst).orig_stmt.rvalue.use_op.constant.sym.v };
                        if c_sym != 0u32 {
                            return SymbolId { v: c_sym };
                        }
                        return SymbolId { v: 0u32 };
                    }
                    i = i + 1;
                }
                b = b + 1;
            }
        }
    }
    SymbolId { v: 0u32 }
}

fn esc_extract_builtin_type_arg(body: view<OptBody>, func_op: view<MirOperand>) -> TypeId {
    if func_op.kind == MIR_OP_CONST {
        return TypeId { v: func_op.constant.sym.v };
    }
    if (func_op.kind == MIR_OP_COPY || func_op.kind == MIR_OP_MOVE) && func_op.place.proj_count == 0 {
        let lv_u32 = func_op.place.local.v;
        if (lv_u32 as usize) < body.local_count && alias_count_local_defs(body, lv_u32) == 1u32 {
            let mut b: usize = 0;
            while b < body.bb_count && (body.blocks as usize) != 0 {
                let bb = unsafe { opt_block_at(body.blocks, b) };
                let icnt = unsafe { (*bb).inst_count };
                let mut i: usize = 0;
                while i < icnt {
                    let inst = unsafe { opt_inst_at((*bb).insts, i) };
                    if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                       (unsafe { (*inst).orig_stmt.place.proj_count }) == 0 &&
                       (unsafe { (*inst).orig_stmt.place.local.v }) == lv_u32 &&
                       (unsafe { (*inst).orig_stmt.rvalue.kind }) == MIR_RVALUE_USE &&
                       (unsafe { (*inst).orig_stmt.rvalue.use_op.kind }) == MIR_OP_CONST {
                        return TypeId { v: unsafe { (*inst).orig_stmt.rvalue.use_op.constant.sym.v } };
                    }
                    i = i + 1;
                }
                b = b + 1;
            }
        }
    }
    TypeId { v: 0u32 }
}

fn esc_callee_builtin_kind(body: view<OptBody>, func_op: view<MirOperand>) -> u8 {
    if (body.thir as usize) == 0 {
        return 0u8;
    }
    let mut fty = TypeId { v: 0u32 };
    if func_op.kind == MIR_OP_CONST {
        fty = TypeId { v: func_op.constant.ty.v };
    } else if (func_op.kind == MIR_OP_COPY || func_op.kind == MIR_OP_MOVE) && func_op.place.proj_count == 0 {
        let lv = func_op.place.local.v as usize;
        if lv < body.local_count && (body.local_tys as usize) != 0 {
            fty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, lv)).v } };
        }
    }
    if fty.v == 0u32 {
        return 0u8;
    }
    let tp = type_get(unsafe { view((*body.thir).interner) }, fty);
    if (tp as usize) == 0 {
        return 0u8;
    }
    unsafe { (*tp).kind }
}

fn esc_eval_operand_const_u64(
    body: view<OptBody>,
    op: view<MirOperand>,
    depth: u32,
    out_ok: mut_view<bool>,
    out_elem_ty: mut_view<TypeId>,
    out_elem_cap: mut_view<u64>
) -> u64 {
    *out_ok = false;
    *out_elem_ty = TypeId { v: 0u32 };
    *out_elem_cap = 0u64;
    if depth > 12u32 {
        return 0u64;
    }
    if op.kind == MIR_OP_CONST {
        if op.constant.kind == MIR_CONST_INT || op.constant.kind == MIR_CONST_BOOL {
            *out_ok = true;
            return op.constant.val;
        }
        return 0u64;
    }
    if (op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE) && op.place.proj_count == 0 {
        return esc_eval_local_const_u64(body, op.place.local.v, depth + 1u32, out_ok, out_elem_ty, out_elem_cap);
    }
    0u64
}

fn esc_eval_local_const_u64(
    body: view<OptBody>,
    loc_v: u32,
    depth: u32,
    out_ok: mut_view<bool>,
    out_elem_ty: mut_view<TypeId>,
    out_elem_cap: mut_view<u64>
) -> u64 {
    *out_ok = false;
    *out_elem_ty = TypeId { v: 0u32 };
    *out_elem_cap = 0u64;
    if depth > 12u32 || (loc_v as usize) >= body.local_count {
        return 0u64;
    }
    if alias_count_local_defs(body, loc_v) != 1u32 {
        return 0u64;
    }
    let mut b: usize = 0;
    while b < body.bb_count && (body.blocks as usize) != 0 {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
               (unsafe { (*inst).orig_stmt.place.proj_count }) == 0 &&
               (unsafe { (*inst).orig_stmt.place.local.v }) == loc_v {
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if rv.kind == MIR_RVALUE_USE || rv.kind == MIR_RVALUE_CAST {
                    return esc_eval_operand_const_u64(body, view(rv.use_op), depth + 1u32, out_ok, out_elem_ty, out_elem_cap);
                }
                if rv.kind == MIR_RVALUE_BINARY_OP {
                    let mut lok = false;
                    let mut lty = TypeId { v: 0u32 };
                    let mut lcap: u64 = 0u64;
                    let lv = esc_eval_operand_const_u64(body, view(rv.lhs), depth + 1u32, mut_view(lok), mut_view(lty), mut_view(lcap));
                    let mut rok = false;
                    let mut rty = TypeId { v: 0u32 };
                    let mut rcap: u64 = 0u64;
                    let rv_u = esc_eval_operand_const_u64(body, view(rv.rhs), depth + 1u32, mut_view(rok), mut_view(rty), mut_view(rcap));
                    if lok && rok {
                        if rv.bin_op == MIR_BINOP_ADD || rv.bin_op == MIR_BINOP_WRAPPING_ADD {
                            *out_ok = true;
                            return lv + rv_u;
                        }
                        if (rv.bin_op == MIR_BINOP_SUB || rv.bin_op == MIR_BINOP_WRAPPING_SUB) && lv >= rv_u {
                            *out_ok = true;
                            return lv - rv_u;
                        }
                        if rv.bin_op == MIR_BINOP_MUL || rv.bin_op == MIR_BINOP_WRAPPING_MUL {
                            if rv_u == 0u64 || lv <= (0xFFFFFFFFu64 / rv_u) {
                                *out_ok = true;
                                if lty.v != 0u32 && rty.v == 0u32 {
                                    *out_elem_ty = lty;
                                    *out_elem_cap = ( if lcap == 0u64 { 1u64 } else { lcap } ) * rv_u;
                                } else if rty.v != 0u32 && lty.v == 0u32 {
                                    *out_elem_ty = rty;
                                    *out_elem_cap = ( if rcap == 0u64 { 1u64 } else { rcap } ) * lv;
                                }
                                return lv * rv_u;
                            }
                        }
                    }
                }
                return 0u64;
            }
            i = i + 1;
        }
        if (unsafe { (*bb).term.kind }) == OPT_TERM_CALL &&
           (unsafe { (*bb).term.has_call_dest }) &&
           (unsafe { (*bb).term.call_dest.proj_count }) == 0 &&
           (unsafe { (*bb).term.call_dest.local.v }) == loc_v {
            let bk = esc_callee_builtin_kind(body, unsafe { view((*bb).term.orig_term.func) });
            let tsym_v = esc_extract_builtin_type_arg(body, unsafe { view((*bb).term.orig_term.func) }).v;
            if bk == TY_BUILTIN_SIZE_OF && tsym_v != 0u32 {
                let mut tok = false;
                let mut tal: u64 = 1u64;
                let tsz = escape_type_byte_size(body.thir, TypeId { v: tsym_v }, mut_view(tok), mut_view(tal));
                if tok {
                    *out_ok = true;
                    *out_elem_ty = TypeId { v: tsym_v };
                    *out_elem_cap = 1u64;
                    return tsz;
                }
            } else if bk == TY_BUILTIN_ALIGN_OF && tsym_v != 0u32 {
                let mut tok = false;
                let mut tal: u64 = 1u64;
                let _tsz = escape_type_byte_size(body.thir, TypeId { v: tsym_v }, mut_view(tok), mut_view(tal));
                if tok {
                    *out_ok = true;
                    return tal;
                }
            }
            return 0u64;
        }
        b = b + 1;
    }
    0u64
}

fn esc_place_uses_local(pl: view<MirPlace>, loc_v: u32) -> bool {
    if pl.local.v == loc_v {
        return true;
    }
    let mut p: usize = 0;
    while p < pl.proj_count && (pl.projs as usize) != 0 {
        let pr = unsafe { mir_proj_at(pl.projs, p) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX && (unsafe { (*pr).index_local.v }) == loc_v {
            return true;
        }
        if pk == MIR_PROJ_SUB_SLICE {
            if (unsafe { (*pr).has_from }) && (unsafe { (*pr).from_local.v }) == loc_v {
                return true;
            }
            if (unsafe { (*pr).has_to }) && (unsafe { (*pr).to_local.v }) == loc_v {
                return true;
            }
        }
        p = p + 1;
    }
    false
}

fn esc_operand_uses_local(op: view<MirOperand>, loc_v: u32) -> bool {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        return esc_place_uses_local(view(op.place), loc_v);
    }
    false
}

fn esc_rvalue_has_use_op(rvk: u8) -> bool {
    rvk == MIR_RVALUE_USE || rvk == MIR_RVALUE_UNARY_OP || rvk == MIR_RVALUE_CAST || rvk == MIR_RVALUE_REPEAT
}

fn esc_rvalue_has_bin_ops(rvk: u8) -> bool {
    rvk == MIR_RVALUE_BINARY_OP || rvk == MIR_RVALUE_OVERFLOWS_BINARY_OP
}

fn esc_rvalue_uses_local(rv: view<MirRvalue>, loc_v: u32) -> bool {
    let rvk = rv.kind;
    if rvk == MIR_RVALUE_REPEAT && (rv.repeat_count_op as usize) != 0 {
        if esc_operand_uses_local(unsafe { view(*rv.repeat_count_op) }, loc_v) {
            return true;
        }
    }
    if esc_rvalue_has_use_op(rvk) {
        return esc_operand_uses_local(view(rv.use_op), loc_v);
    }
    if esc_rvalue_has_bin_ops(rvk) {
        return esc_operand_uses_local(view(rv.lhs), loc_v) || esc_operand_uses_local(view(rv.rhs), loc_v);
    }
    if rvk == MIR_RVALUE_REF || rvk == MIR_RVALUE_LEN || rvk == MIR_RVALUE_DISCRIMINANT {
        return esc_place_uses_local(view(rv.place), loc_v);
    }
    if rvk == MIR_RVALUE_AGGREGATE {
        let mut ao: usize = 0;
        while ao < rv.operand_count && (rv.operands as usize) != 0 {
            let op_p = unsafe { mir_op_at(rv.operands, ao) };
            if esc_operand_uses_local(unsafe { view(*op_p) }, loc_v) {
                return true;
            }
            ao = ao + 1;
        }
    }
    false
}

fn esc_stmt_uses_local(st: view<MirStmt>, loc_v: u32) -> bool {
    let sk = st.kind;
    if sk == MIR_STMT_ASSIGN {
        return esc_place_uses_local(view(st.place), loc_v) || esc_rvalue_uses_local(view(st.rvalue), loc_v);
    }
    if sk == MIR_STMT_DROP {
        return esc_place_uses_local(view(st.place), loc_v);
    }
    if sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD {
        return st.storage_local.v == loc_v;
    }
    false
}

fn esc_term_uses_local(tm: view<MirTerminator>, loc_v: u32) -> bool {
    let tk = tm.kind;
    if tk == MIR_TERM_DROP {
        return esc_place_uses_local(view(tm.drop_place), loc_v);
    }
    if tk == MIR_TERM_SWITCH_INT {
        return esc_operand_uses_local(view(tm.discr), loc_v);
    }
    if tk == MIR_TERM_ASSERT {
        return esc_operand_uses_local(view(tm.cond), loc_v);
    }
    if tk == MIR_TERM_CALL {
        if tm.has_destination && esc_place_uses_local(view(tm.destination), loc_v) {
            return true;
        }
        if esc_operand_uses_local(view(tm.func), loc_v) {
            return true;
        }
        let mut ai: usize = 0;
        while ai < tm.arg_count && (tm.args as usize) != 0 {
            let ap = unsafe { mir_op_at(tm.args, ai) };
            if esc_operand_uses_local(unsafe { view(*ap) }, loc_v) {
                return true;
            }
            ai = ai + 1;
        }
    }
    false
}

fn esc_operand_is_zero_int(op: view<MirOperand>) -> bool {
    op.kind == MIR_OP_CONST && op.constant.kind == MIR_CONST_INT && op.constant.val == 0u64
}

// Returns true when `int_loc` (produced by `p as usize` for non-null checks like `Box::drop` / `Vec::drop`)
// is ONLY compared directly (`proj_count == 0`) against constant `0` via `==` or `!=`, and never stored,
// used in place projections (`arr[int_loc]`), borrowed, returned, passed, or arithmetic-manipulated.
fn esc_local_is_only_null_checked(body: view<OptBody>, int_loc: u32) -> bool {
    if int_loc == 0u32 || (int_loc as usize) <= body.arg_count || alias_count_local_defs(body, int_loc) != 1u32 {
        return false;
    }
    let mut saw_cmp = false;
    let mut b: usize = 0;
    while b < body.bb_count && (body.blocks as usize) != 0 {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            let sk = unsafe { (*inst).orig_stmt.kind };
            if sk == MIR_STMT_ASSIGN {
                let dst = unsafe { view((*inst).orig_stmt.place) };
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if dst.local.v == int_loc && dst.proj_count == 0 {
                    // Single definition itself: reject if `dst` projections or RHS self-reference `int_loc`
                    if esc_rvalue_uses_local(rv, int_loc) {
                        return false;
                    }
                } else {
                    if esc_place_uses_local(dst, int_loc) {
                        return false;
                    }
                    if rv.kind == MIR_RVALUE_BINARY_OP && (rv.bin_op == MIR_BINOP_EQ || rv.bin_op == MIR_BINOP_NE) {
                        let u_l = esc_operand_uses_local(view(rv.lhs), int_loc);
                        let u_r = esc_operand_uses_local(view(rv.rhs), int_loc);
                        if u_l && u_r {
                            return false;
                        }
                        if u_l {
                            if rv.lhs.place.local.v != int_loc || rv.lhs.place.proj_count != 0 ||
                               !esc_operand_is_zero_int(view(rv.rhs)) {
                                return false;
                            }
                            saw_cmp = true;
                        } else if u_r {
                            if rv.rhs.place.local.v != int_loc || rv.rhs.place.proj_count != 0 ||
                               !esc_operand_is_zero_int(view(rv.lhs)) {
                                return false;
                            }
                            saw_cmp = true;
                        }
                    } else {
                        if esc_rvalue_uses_local(rv, int_loc) {
                            return false;
                        }
                    }
                }
            } else if sk == MIR_STMT_DROP {
                if esc_place_uses_local(unsafe { view((*inst).orig_stmt.place) }, int_loc) {
                    return false;
                }
            }
            i = i + 1;
        }
        if (unsafe { (*bb).term.has_call_dest }) && esc_place_uses_local(unsafe { view((*bb).term.call_dest) }, int_loc) {
            return false;
        }
        if esc_term_uses_local(unsafe { view((*bb).term.orig_term) }, int_loc) {
            return false;
        }
        b = b + 1;
    }
    saw_cmp
}

// --- Loop Backedge & CFG Reachability Helpers (`AXS-ESC-004` rule 6, `AXS-ESC-010` step 6) ---

fn esc_bb_reaches_without_killer(
    body: view<OptBody>,
    start_bb: u32,
    target_bb: u32,
    killer_bb: u32,
    scratch_vis: *mut bool,
    scratch_q: *mut u32
) -> bool {
    let bcnt = body.bb_count;
    if (start_bb as usize) >= bcnt || (target_bb as usize) >= bcnt || (body.blocks as usize) == 0 {
        return false;
    }
    let mut z: usize = 0;
    while z < bcnt {
        unsafe { *esc_bool_at(scratch_vis, z) = false; }
        z = z + 1;
    }
    let mut qhead: usize = 0;
    let mut qtail: usize = 0;
    let sb = unsafe { opt_block_at(body.blocks, start_bb as usize) };
    let sc0 = unsafe { (*sb).succ_count };
    let mut s0: usize = 0;
    while s0 < sc0 && (unsafe { (*sb).succs as usize }) != 0 {
        let nxt = unsafe { (*opt_u32_at((*sb).succs as *mut u32, s0)) };
        if (nxt as usize) < bcnt && !unsafe { *esc_bool_at(scratch_vis, nxt as usize) } {
            unsafe {
                *esc_bool_at(scratch_vis, nxt as usize) = true;
                *esc_u32_at(scratch_q, qtail) = nxt;
            }
            qtail = qtail + 1;
        }
        s0 = s0 + 1;
    }
    while qhead < qtail {
        let cur = unsafe { *esc_u32_at(scratch_q, qhead) };
        qhead = qhead + 1;
        if cur == target_bb {
            return true;
        }
        if cur == killer_bb {
            continue;
        }
        let cb = unsafe { opt_block_at(body.blocks, cur as usize) };
        let sc = unsafe { (*cb).succ_count };
        let mut si: usize = 0;
        while si < sc && (unsafe { (*cb).succs as usize }) != 0 {
            let nxt = unsafe { (*opt_u32_at((*cb).succs as *mut u32, si)) };
            if (nxt as usize) < bcnt && !unsafe { *esc_bool_at(scratch_vis, nxt as usize) } {
                unsafe {
                    *esc_bool_at(scratch_vis, nxt as usize) = true;
                    *esc_u32_at(scratch_q, qtail) = nxt;
                }
                qtail = qtail + 1;
            }
            si = si + 1;
        }
    }
    false
}

fn esc_alloc_crosses_loop_backedge(
    body: view<OptBody>,
    alloc_bb: u32,
    free_bb: u32,
    scratch_vis: *mut bool,
    scratch_q: *mut u32
) -> bool {
    let in_loop = esc_bb_reaches_without_killer(body, alloc_bb, alloc_bb, ESC_NONE_IDX, scratch_vis, scratch_q);
    if !in_loop {
        return false;
    }
    // Inside a loop: safe iff `free_bb` kills EVERY cyclic path from `alloc_bb` back to `alloc_bb`
    if free_bb != ESC_NONE_IDX && free_bb != alloc_bb {
        if !esc_bb_reaches_without_killer(body, alloc_bb, alloc_bb, free_bb, scratch_vis, scratch_q) {
            return false;
        }
    }
    true
}


// --- Allocation Site Discovery & Disjoint-Lifetime Slot Reuse (`AXS-ESC-011..013`) ---

fn esc_push_alloc_site(info: mut_view<EscapeInfo>, arena: mut_view<Arena>, site: AllocSite) -> u32 {
    if info.site_count >= info.site_cap {
        let new_cap: usize = if info.site_cap == 0 { 8 } else { info.site_cap + info.site_cap };
        let new_buf = arena_alloc_raw(
            mut_view(*arena),
            esc_mul_usize(new_cap, size_of<AllocSite>()),
            align_of<AllocSite>()
        ) as *mut AllocSite;
        if info.site_count > 0 && (info.sites as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<AllocSite>(
                    info.sites as *const AllocSite,
                    new_buf,
                    info.site_count
                );
            }
        }
        info.sites = new_buf;
        info.site_cap = new_cap;
    }
    let idx = info.site_count;
    let dst = unsafe { escape_site_at(info.sites, idx) };
    unsafe {
        *dst = site;
        (*dst).site_id = idx as u32;
    }
    info.site_count = idx + 1;
    idx as u32
}

fn esc_local_is_ptr_alias_of(body: view<OptBody>, cand_loc: u32, root_raw_loc: u32, depth: u32) -> bool {
    if cand_loc == root_raw_loc {
        return true;
    }
    if depth > 8u32 || alias_count_local_defs(body, cand_loc) != 1u32 {
        return false;
    }
    let mut b: usize = 0;
    while b < body.bb_count && (body.blocks as usize) != 0 {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
               (unsafe { (*inst).orig_stmt.place.proj_count }) == 0 &&
               (unsafe { (*inst).orig_stmt.place.local.v }) == cand_loc {
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if (rv.kind == MIR_RVALUE_USE || (rv.kind == MIR_RVALUE_CAST && rv.cast_kind == MIR_CAST_PTR_TO_PTR)) &&
                   (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) {
                    if rv.use_op.place.proj_count == 0 {
                        return esc_local_is_ptr_alias_of(body, rv.use_op.place.local.v, root_raw_loc, depth + 1u32);
                    }
                    // Reading `box_loc.0` where `box_loc` was constructed from `root_raw_loc`
                    if rv.use_op.place.proj_count == 1 && (rv.use_op.place.projs as usize) != 0 {
                        let pr0 = unsafe { mir_proj_at(rv.use_op.place.projs, 0) };
                        if (unsafe { (*pr0).kind }) == MIR_PROJ_FIELD && (unsafe { (*pr0).field_idx }) == 0u32 {
                            return esc_box_local_wraps_raw(body, rv.use_op.place.local.v, root_raw_loc, depth + 1u32);
                        }
                    }
                }
                return false;
            }
            i = i + 1;
        }
        b = b + 1;
    }
    false
}

fn esc_box_local_wraps_raw(body: view<OptBody>, box_loc: u32, root_raw_loc: u32, depth: u32) -> bool {
    if box_loc == root_raw_loc {
        return true;
    }
    if depth > 8u32 || alias_count_local_defs(body, box_loc) != 1u32 {
        return false;
    }
    let mut b: usize = 0;
    while b < body.bb_count && (body.blocks as usize) != 0 {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
               (unsafe { (*inst).orig_stmt.place.proj_count }) == 0 &&
               (unsafe { (*inst).orig_stmt.place.local.v }) == box_loc {
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if rv.kind == MIR_RVALUE_USE && (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                   rv.use_op.place.proj_count == 0 {
                    return esc_box_local_wraps_raw(body, rv.use_op.place.local.v, root_raw_loc, depth + 1u32);
                }
                if rv.kind == MIR_RVALUE_AGGREGATE && rv.operand_count == 1 && (rv.operands as usize) != 0 {
                    let op0 = unsafe { mir_op_at(rv.operands, 0) };
                    if ((unsafe { (*op0).kind }) == MIR_OP_COPY || (unsafe { (*op0).kind }) == MIR_OP_MOVE) &&
                       (unsafe { (*op0).place.proj_count }) == 0 {
                        return esc_local_is_ptr_alias_of(body, unsafe { (*op0).place.local.v }, root_raw_loc, depth + 1u32);
                    }
                }
                return false;
            }
            i = i + 1;
        }
        b = b + 1;
    }
    false
}

fn esc_find_typed_cast_from_raw(body: view<OptBody>, raw_loc: u32, out_pointee: mut_view<TypeId>) -> u32 {
    *out_pointee = TypeId { v: 0u32 };
    if (body.thir as usize) == 0 || (body.local_tys as usize) == 0 {
        return ESC_NONE_IDX;
    }
    let mut found_loc: u32 = ESC_NONE_IDX;
    let mut b: usize = 0;
    while b < body.bb_count && (body.blocks as usize) != 0 {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
               (unsafe { (*inst).orig_stmt.place.proj_count }) == 0 {
                let dl = unsafe { (*inst).orig_stmt.place.local.v };
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if rv.kind == MIR_RVALUE_CAST && rv.cast_kind == MIR_CAST_PTR_TO_PTR &&
                   (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                   rv.use_op.place.proj_count == 0 && rv.use_op.place.local.v == raw_loc {
                    if (dl as usize) < body.local_count {
                        let dty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, dl as usize)).v } };
                        let tp = type_get(unsafe { view((*body.thir).interner) }, dty);
                        if (tp as usize) != 0 && (unsafe { (*tp).kind }) == TY_PTR {
                            let pty_v = unsafe { (*tp).pointee.v };
                            let ptp = type_get(unsafe { view((*body.thir).interner) }, TypeId { v: pty_v });
                            if (ptp as usize) != 0 && (unsafe { (*ptp).kind }) != TY_U8 {
                                *out_pointee = TypeId { v: pty_v };
                                return dl;
                            }
                            if found_loc == ESC_NONE_IDX {
                                *out_pointee = TypeId { v: pty_v };
                                found_loc = dl;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        b = b + 1;
    }
    found_loc
}

fn esc_free_set_postdominates(
    body: view<OptBody>,
    alloc_bb: u32,
    start_bb: u32,
    in_loop: bool,
    free_set: *mut bool,
    free_cnt: usize,
    scratch_vis: *mut bool,
    scratch_q: *mut u32,
    out_crosses_backedge: mut_view<bool>
) -> bool {
    let bcnt = body.bb_count;
    if free_cnt == 0 || (start_bb as usize) >= bcnt || (body.blocks as usize) == 0 {
        *out_crosses_backedge = in_loop;
        return false;
    }
    if start_bb == alloc_bb {
        *out_crosses_backedge = true;
        return false;
    }
    let sblk = unsafe { opt_block_at(body.blocks, start_bb as usize) };
    if unsafe { (*sblk).is_cleanup } {
        *out_crosses_backedge = in_loop;
        return false;
    }
    let mut z: usize = 0;
    while z < bcnt {
        unsafe { *esc_bool_at(scratch_vis, z) = false; }
        z = z + 1;
    }
    let mut qhead: usize = 0;
    let mut qtail: usize = 0;
    unsafe {
        *esc_bool_at(scratch_vis, start_bb as usize) = true;
        *esc_u32_at(scratch_q, 0) = start_bb;
    }
    qtail = 1;

    let mut saw_unfreed_return = false;
    let mut reaches_alloc = false;
    while qhead < qtail {
        let cur = unsafe { *esc_u32_at(scratch_q, qhead) };
        qhead = qhead + 1;
        if unsafe { *esc_bool_at(free_set, cur as usize) } {
            continue;
        }
        let cb = unsafe { opt_block_at(body.blocks, cur as usize) };
        if (unsafe { (*cb).term.kind }) == OPT_TERM_RETURN {
            saw_unfreed_return = true;
        }
        let sc = unsafe { (*cb).succ_count };
        let mut si: usize = 0;
        while si < sc && (unsafe { (*cb).succs as usize }) != 0 {
            let nxt = unsafe { *opt_u32_at((*cb).succs as *mut u32, si) };
            if nxt == alloc_bb {
                reaches_alloc = true;
            } else if (nxt as usize) < bcnt {
                let nb = unsafe { opt_block_at(body.blocks, nxt as usize) };
                if !(unsafe { (*nb).is_cleanup }) && !(unsafe { *esc_bool_at(scratch_vis, nxt as usize) }) {
                    unsafe {
                        *esc_bool_at(scratch_vis, nxt as usize) = true;
                        *esc_u32_at(scratch_q, qtail) = nxt;
                    }
                    qtail = qtail + 1;
                }
            }
            si = si + 1;
        }
    }
    *out_crosses_backedge = in_loop && reaches_alloc;
    !saw_unfreed_return && !reaches_alloc
}

fn esc_stmt_uses_raw_alloc_family(body: view<OptBody>, st: view<MirStmt>, raw_loc: u32) -> bool {
    let sk = st.kind;
    if sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD {
        return false;
    }
    let mut l: usize = 0;
    while l < body.local_count {
        let lv = l as u32;
        if (esc_local_is_ptr_alias_of(body, lv, raw_loc, 0u32) ||
            esc_box_local_wraps_raw(body, lv, raw_loc, 0u32)) &&
           esc_stmt_uses_local(st, lv) {
            return true;
        }
        l = l + 1;
    }
    false
}

fn esc_term_uses_raw_alloc_family(body: view<OptBody>, tm: view<MirTerminator>, raw_loc: u32) -> bool {
    let mut l: usize = 0;
    while l < body.local_count {
        let lv = l as u32;
        if (esc_local_is_ptr_alias_of(body, lv, raw_loc, 0u32) ||
            esc_box_local_wraps_raw(body, lv, raw_loc, 0u32)) &&
           esc_term_uses_local(tm, lv) {
            return true;
        }
        l = l + 1;
    }
    false
}

fn esc_raw_alloc_post_free_and_alias_safe(
    body: view<OptBody>,
    alloc_bb: u32,
    raw_loc: u32,
    free_set: *mut bool,
    scratch_vis: *mut bool,
    scratch_q: *mut u32
) -> bool {
    let bcnt = body.bb_count;
    if bcnt == 0 || (body.blocks as usize) == 0 {
        return false;
    }
    // Reject if any alias of `raw_loc` is copied/cast into a multi-def local not tracked by `esc_local_is_ptr_alias_of`
    let mut b0: usize = 0;
    while b0 < bcnt {
        let bb0 = unsafe { opt_block_at(body.blocks, b0) };
        if unsafe { (*bb0).is_reachable } {
            let icnt0 = unsafe { (*bb0).inst_count };
            let mut i0: usize = 0;
            while i0 < icnt0 {
                let inst0 = unsafe { opt_inst_at((*bb0).insts, i0) };
                if (unsafe { (*inst0).orig_stmt.kind }) == MIR_STMT_ASSIGN {
                    let dst0 = unsafe { view((*inst0).orig_stmt.place) };
                    let rv0 = unsafe { view((*inst0).orig_stmt.rvalue) };
                    if (rv0.kind == MIR_RVALUE_USE || (rv0.kind == MIR_RVALUE_CAST && rv0.cast_kind == MIR_CAST_PTR_TO_PTR)) &&
                       (rv0.use_op.kind == MIR_OP_COPY || rv0.use_op.kind == MIR_OP_MOVE) &&
                       rv0.use_op.place.proj_count == 0 &&
                       esc_local_is_ptr_alias_of(body, rv0.use_op.place.local.v, raw_loc, 0u32) {
                        if dst0.proj_count == 0 && alias_count_local_defs(body, dst0.local.v) != 1u32 {
                            return false;
                        }
                    }
                }
                i0 = i0 + 1;
            }
        }
        b0 = b0 + 1;
    }

    let mut z: usize = 0;
    while z < bcnt {
        unsafe { *esc_bool_at(scratch_vis, z) = false; }
        z = z + 1;
    }
    let mut qhead: usize = 0;
    let mut qtail: usize = 0;
    let mut fb: usize = 0;
    while fb < bcnt {
        if unsafe { *esc_bool_at(free_set, fb) } {
            let fblk = unsafe { opt_block_at(body.blocks, fb) };
            let after_fb = unsafe { (*fblk).term.orig_term.call_target.v };
            if (after_fb as usize) < bcnt {
                let ablk = unsafe { opt_block_at(body.blocks, after_fb as usize) };
                if !(unsafe { (*ablk).is_cleanup }) && !(unsafe { *esc_bool_at(scratch_vis, after_fb as usize) }) {
                    unsafe {
                        *esc_bool_at(scratch_vis, after_fb as usize) = true;
                        *esc_u32_at(scratch_q, qtail) = after_fb;
                    }
                    qtail = qtail + 1;
                }
            }
        }
        fb = fb + 1;
    }

    while qhead < qtail {
        let cur = unsafe { *esc_u32_at(scratch_q, qhead) };
        qhead = qhead + 1;
        let cb = unsafe { opt_block_at(body.blocks, cur as usize) };
        let icnt = unsafe { (*cb).inst_count };
        let mut ii: usize = 0;
        while ii < icnt {
            let inst = unsafe { opt_inst_at((*cb).insts, ii) };
            if esc_stmt_uses_raw_alloc_family(body, unsafe { view((*inst).orig_stmt) }, raw_loc) {
                return false;
            }
            ii = ii + 1;
        }
        if cur == alloc_bb {
            continue;
        }
        if unsafe { *esc_bool_at(free_set, cur as usize) } {
            return false;
        }
        if esc_term_uses_raw_alloc_family(body, unsafe { view((*cb).term.orig_term) }, raw_loc) {
            return false;
        }
        let sc = unsafe { (*cb).succ_count };
        let mut si: usize = 0;
        while si < sc && (unsafe { (*cb).succs as usize }) != 0 {
            let nxt = unsafe { *opt_u32_at((*cb).succs as *mut u32, si) };
            if (nxt as usize) < bcnt {
                let nb = unsafe { opt_block_at(body.blocks, nxt as usize) };
                if !(unsafe { (*nb).is_cleanup }) && !(unsafe { *esc_bool_at(scratch_vis, nxt as usize) }) {
                    unsafe {
                        *esc_bool_at(scratch_vis, nxt as usize) = true;
                        *esc_u32_at(scratch_q, qtail) = nxt;
                    }
                    qtail = qtail + 1;
                }
            }
            si = si + 1;
        }
    }
    true
}

fn esc_place_has_whole_value_or_index_use(pl: view<MirPlace>, box_loc: u32) -> bool {
    let mut p: usize = 0;
    while p < pl.proj_count && (pl.projs as usize) != 0 {
        let pr = unsafe { mir_proj_at(pl.projs, p) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX && (unsafe { (*pr).index_local.v }) == box_loc {
            return true;
        }
        if pk == MIR_PROJ_SUB_SLICE {
            if (unsafe { (*pr).has_from }) && (unsafe { (*pr).from_local.v }) == box_loc {
                return true;
            }
            if (unsafe { (*pr).has_to }) && (unsafe { (*pr).to_local.v }) == box_loc {
                return true;
            }
        }
        p = p + 1;
    }
    if pl.local.v != box_loc {
        return false;
    }
    pl.proj_count == 0
}

fn esc_operand_transfers_whole_box(op: view<MirOperand>, box_loc: u32) -> bool {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        return esc_place_has_whole_value_or_index_use(view(op.place), box_loc);
    }
    false
}

fn esc_rvalue_transfers_whole_box(rv: view<MirRvalue>, box_loc: u32) -> bool {
    let rvk = rv.kind;
    if esc_rvalue_has_use_op(rvk) {
        return esc_operand_transfers_whole_box(view(rv.use_op), box_loc);
    }
    if esc_rvalue_has_bin_ops(rvk) {
        return esc_operand_transfers_whole_box(view(rv.lhs), box_loc) ||
               esc_operand_transfers_whole_box(view(rv.rhs), box_loc);
    }
    if rvk == MIR_RVALUE_REF {
        if esc_place_uses_local(view(rv.place), box_loc) {
            if rv.place.local.v != box_loc {
                return true;
            }
            if rv.borrow_kind == MIR_BORROW_MUT &&
               esc_place_first_deref_idx(view(rv.place)) == rv.place.proj_count {
                return true;
            }
        }
        return false;
    }
    if rvk == MIR_RVALUE_LEN || rvk == MIR_RVALUE_DISCRIMINANT {
        return esc_place_has_whole_value_or_index_use(view(rv.place), box_loc);
    }
    if rvk == MIR_RVALUE_AGGREGATE {
        let mut ao: usize = 0;
        while ao < rv.operand_count && (rv.operands as usize) != 0 {
            let op_p = unsafe { mir_op_at(rv.operands, ao) };
            if esc_operand_transfers_whole_box(unsafe { view(*op_p) }, box_loc) {
                return true;
            }
            ao = ao + 1;
        }
    }
    false
}

fn esc_opt_box_no_whole_value_transfer(body: view<OptBody>, box_loc: u32, alloc_bb: u32) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count && (body.blocks as usize) != 0 {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            let sk = unsafe { (*inst).orig_stmt.kind };
            if sk == MIR_STMT_ASSIGN {
                let dst = unsafe { view((*inst).orig_stmt.place) };
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if dst.local.v == box_loc && esc_place_first_deref_idx(dst) == dst.proj_count {
                    return false;
                }
                if dst.local.v != box_loc && esc_place_uses_local(dst, box_loc) {
                    return false;
                }
                if esc_rvalue_transfers_whole_box(rv, box_loc) {
                    return false;
                }
            } else if sk == MIR_STMT_DROP {
                let dpl = unsafe { view((*inst).orig_stmt.place) };
                if esc_place_uses_local(dpl, box_loc) && (dpl.local.v != box_loc || dpl.proj_count != 0) {
                    return false;
                }
            }
            i = i + 1;
        }
        let ot = unsafe { view((*bb).term.orig_term) };
        if ot.kind == MIR_TERM_DROP {
            if esc_place_uses_local(view(ot.drop_place), box_loc) &&
               (ot.drop_place.local.v != box_loc || ot.drop_place.proj_count != 0) {
                return false;
            }
        } else if ot.kind == MIR_TERM_SWITCH_INT {
            if esc_operand_transfers_whole_box(view(ot.discr), box_loc) {
                return false;
            }
        } else if ot.kind == MIR_TERM_ASSERT {
            if esc_operand_transfers_whole_box(view(ot.cond), box_loc) {
                return false;
            }
        } else if ot.kind == MIR_TERM_CALL {
            if (b as u32) != alloc_bb {
                if (unsafe { (*bb).term.has_call_dest }) &&
                   esc_place_uses_local(unsafe { view((*bb).term.call_dest) }, box_loc) &&
                   ((unsafe { (*bb).term.call_dest.local.v }) != box_loc ||
                    esc_place_first_deref_idx(unsafe { view((*bb).term.call_dest) }) == (unsafe { (*bb).term.call_dest.proj_count })) {
                    return false;
                }
                if ot.has_destination && esc_place_uses_local(view(ot.destination), box_loc) &&
                   (ot.destination.local.v != box_loc || esc_place_first_deref_idx(view(ot.destination)) == ot.destination.proj_count) {
                    return false;
                }
            }
            if esc_operand_transfers_whole_box(view(ot.func), box_loc) {
                return false;
            }
            let mut ai: usize = 0;
            while ai < ot.arg_count && (ot.args as usize) != 0 {
                let ap = unsafe { mir_op_at(ot.args, ai) };
                if esc_operand_transfers_whole_box(unsafe { view(*ap) }, box_loc) {
                    return false;
                }
                ai = ai + 1;
            }
        }
        b = b + 1;
    }
    true
}

fn esc_box_post_drop_safe(
    body: view<OptBody>,
    alloc_bb: u32,
    box_loc: u32,
    drop_set: *mut bool,
    scratch_vis: *mut bool,
    scratch_q: *mut u32
) -> bool {
    let bcnt = body.bb_count;
    if bcnt == 0 || (body.blocks as usize) == 0 {
        return false;
    }
    let mut z: usize = 0;
    while z < bcnt {
        unsafe { *esc_bool_at(scratch_vis, z) = false; }
        z = z + 1;
    }
    let mut qhead: usize = 0;
    let mut qtail: usize = 0;
    let mut db: usize = 0;
    while db < bcnt {
        if unsafe { *esc_bool_at(drop_set, db) } {
            let dblk = unsafe { opt_block_at(body.blocks, db) };
            // Check statements AFTER any `MIR_STMT_DROP(box_loc)` in `db`, or successors of `OPT_TERM_DROP`
            let icnt_d = unsafe { (*dblk).inst_count };
            let mut saw_stmt_drop = false;
            let mut id: usize = 0;
            while id < icnt_d {
                let inst_d = unsafe { opt_inst_at((*dblk).insts, id) };
                let sk_d = unsafe { (*inst_d).orig_stmt.kind };
                if saw_stmt_drop {
                    if sk_d != MIR_STMT_STORAGE_LIVE && sk_d != MIR_STMT_STORAGE_DEAD &&
                       esc_stmt_uses_local(unsafe { view((*inst_d).orig_stmt) }, box_loc) {
                        return false;
                    }
                } else if sk_d == MIR_STMT_DROP &&
                          (unsafe { (*inst_d).orig_stmt.place.local.v }) == box_loc &&
                          (unsafe { (*inst_d).orig_stmt.place.proj_count }) == 0 {
                    saw_stmt_drop = true;
                }
                id = id + 1;
            }
            if saw_stmt_drop && esc_term_uses_local(unsafe { view((*dblk).term.orig_term) }, box_loc) {
                return false;
            }
            let sc_d = unsafe { (*dblk).succ_count };
            let mut sd: usize = 0;
            while sd < sc_d && (unsafe { (*dblk).succs as usize }) != 0 {
                let nxt = unsafe { *opt_u32_at((*dblk).succs as *mut u32, sd) };
                if (nxt as usize) < bcnt {
                    let nb = unsafe { opt_block_at(body.blocks, nxt as usize) };
                    if !(unsafe { (*nb).is_cleanup }) && !(unsafe { *esc_bool_at(scratch_vis, nxt as usize) }) {
                        unsafe {
                            *esc_bool_at(scratch_vis, nxt as usize) = true;
                            *esc_u32_at(scratch_q, qtail) = nxt;
                        }
                        qtail = qtail + 1;
                    }
                }
                sd = sd + 1;
            }
        }
        db = db + 1;
    }

    while qhead < qtail {
        let cur = unsafe { *esc_u32_at(scratch_q, qhead) };
        qhead = qhead + 1;
        let cb = unsafe { opt_block_at(body.blocks, cur as usize) };
        let icnt = unsafe { (*cb).inst_count };
        let mut ii: usize = 0;
        while ii < icnt {
            let inst = unsafe { opt_inst_at((*cb).insts, ii) };
            let sk = unsafe { (*inst).orig_stmt.kind };
            if sk != MIR_STMT_STORAGE_LIVE && sk != MIR_STMT_STORAGE_DEAD &&
               esc_stmt_uses_local(unsafe { view((*inst).orig_stmt) }, box_loc) {
                return false;
            }
            ii = ii + 1;
        }
        if cur == alloc_bb {
            continue;
        }
        if unsafe { *esc_bool_at(drop_set, cur as usize) } {
            return false;
        }
        if esc_term_uses_local(unsafe { view((*cb).term.orig_term) }, box_loc) {
            return false;
        }
        let sc = unsafe { (*cb).succ_count };
        let mut si: usize = 0;
        while si < sc && (unsafe { (*cb).succs as usize }) != 0 {
            let nxt = unsafe { *opt_u32_at((*cb).succs as *mut u32, si) };
            if (nxt as usize) < bcnt {
                let nb = unsafe { opt_block_at(body.blocks, nxt as usize) };
                if !(unsafe { (*nb).is_cleanup }) && !(unsafe { *esc_bool_at(scratch_vis, nxt as usize) }) {
                    unsafe {
                        *esc_bool_at(scratch_vis, nxt as usize) = true;
                        *esc_u32_at(scratch_q, qtail) = nxt;
                    }
                    qtail = qtail + 1;
                }
            }
            si = si + 1;
        }
    }
    true
}

fn esc_discover_alloc_sites(
    info: mut_view<EscapeInfo>,
    body: view<OptBody>,
    summary_table: *const EscapeSummaryTable,
    scratch_free_set: *mut bool,
    scratch_vis: *mut bool,
    scratch_q: *mut u32,
    arena: mut_view<Arena>
) {
    let bcnt = body.bb_count;
    let lcnt = body.local_count;
    if bcnt == 0 || lcnt == 0 || (body.blocks as usize) == 0 {
        return;
    }

    // 1. Scan basic blocks for closure aggregates and allocator / Box / Vec call terminators
    let mut b: usize = 0;
    while b < bcnt {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if !(unsafe { (*bb).is_reachable }) {
            b = b + 1;
            continue;
        }
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
               (unsafe { (*inst).orig_stmt.place.proj_count }) == 0 {
                let dl = unsafe { (*inst).orig_stmt.place.local.v };
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if rv.kind == MIR_RVALUE_AGGREGATE && (dl as usize) < lcnt &&
                   alias_count_local_defs(body, dl) == 1u32 && (body.thir as usize) != 0 {
                    let lty_v = unsafe { (*opt_typeid_at(body.local_tys, dl as usize)).v };
                    let tp = type_get(unsafe { view((*body.thir).interner) }, TypeId { v: lty_v });
                    if (tp as usize) != 0 && (unsafe { (*tp).kind }) == TY_CLOSURE {
                        let mut cok = false;
                        let mut cal: u64 = 8u64;
                        let csz = escape_type_byte_size(body.thir, TypeId { v: lty_v }, mut_view(cok), mut_view(cal));
                        let in_lp = esc_bb_reaches_without_killer(body, b as u32, b as u32, ESC_NONE_IDX, scratch_vis, scratch_q);
                        let sidx = esc_push_alloc_site(mut_view(*info), mut_view(*arena), AllocSite {
                            site_id: 0u32,
                            kind: ALLOC_KIND_CLOSURE_ENV,
                            alloc_bb: b as u32,
                            alloc_inst: i as u32,
                            dest_local: dl,
                            raw_ptr_local: dl,
                            payload_ty: TypeId { v: lty_v },
                            elem_ty: TypeId { v: 0u32 },
                            elem_cap: 1u64,
                            known_size: cok,
                            size_bytes: csz,
                            align_bytes: cal,
                            free_bb: b as u32,
                            has_matching_free: true,
                            has_realloc: false,
                            in_loop: in_lp,
                            crosses_backedge: false,
                            escape_set: ESC_NONE,
                            escape_class: ESCAPE_NO_ESCAPE,
                            storage_decision: STORAGE_DECISION_LOCAL_STACK,
                            reason: REASON_NONE,
                            promoted: false,
                            promoted_local: ESC_NONE_IDX,
                        });
                        let lp = unsafe { escape_local_at(info.locals, dl as usize) };
                        unsafe { (*lp).alloc_site_idx = sidx; }
                    }
                }
            }
            i = i + 1;
        }

        if (unsafe { (*bb).term.kind }) == OPT_TERM_CALL && (unsafe { (*bb).term.has_call_dest }) &&
           (unsafe { (*bb).term.call_dest.proj_count }) == 0 {
            let dl = unsafe { (*bb).term.call_dest.local.v };
            if (dl as usize) < lcnt && alias_count_local_defs(body, dl) == 1u32 {
                let csym_v = esc_extract_callee_sym(body, unsafe { view((*bb).term.orig_term.func) }).v;
                let mut csum = escape_summary_zero(SymbolId { v: csym_v }, 0);
                if escape_summary_table_lookup(summary_table, (SymbolId { v: csym_v }), mut_view(csum)) {
                    let acnt = unsafe { (*bb).term.orig_term.arg_count };
                    let args = unsafe { (*bb).term.orig_term.args };
                    if csum.is_alloc_fn && acnt >= 2 && (args as usize) != 0 {
                        let a0 = unsafe { mir_op_at(args, 0) };
                        let a1 = unsafe { mir_op_at(args, 1) };
                        let mut sz_ok = false;
                        let mut ety = TypeId { v: 0u32 };
                        let mut ecap: u64 = 0u64;
                        let sz_v = esc_eval_operand_const_u64(body, unsafe { view(*a0) }, 0u32, mut_view(sz_ok), mut_view(ety), mut_view(ecap));
                        let mut al_ok = false;
                        let mut dummy_ty = TypeId { v: 0u32 };
                        let mut dummy_cap: u64 = 0u64;
                        let al_v = esc_eval_operand_const_u64(body, unsafe { view(*a1) }, 0u32, mut_view(al_ok), mut_view(dummy_ty), mut_view(dummy_cap));
                        let mut cast_pty = TypeId { v: 0u32 };
                        let _cast_loc = esc_find_typed_cast_from_raw(body, dl, mut_view(cast_pty));
                        let cast_pty_v = cast_pty.v;
                        if ety.v == 0u32 && cast_pty_v != 0u32 && sz_ok {
                            let mut p_ok = false;
                            let mut p_al: u64 = 1u64;
                            let p_sz = escape_type_byte_size(body.thir, TypeId { v: cast_pty_v }, mut_view(p_ok), mut_view(p_al));
                            if p_ok && p_sz > 0u64 && (sz_v % p_sz) == 0u64 {
                                ety = TypeId { v: cast_pty_v };
                                ecap = sz_v / p_sz;
                            }
                        }
                        let ety_v = ety.v;
                        // Scan for matching `heap_free` and `heap_realloc` on aliases of `dl`, verifying post-dominance & balance
                        let start_bb = unsafe { (*bb).term.orig_term.call_target.v };
                        let mut free_bb: u32 = ESC_NONE_IDX;
                        let mut free_cnt: usize = 0;
                        let mut undom_free = false;
                        let mut has_rea = false;
                        let mut fb: usize = 0;
                        while fb < bcnt {
                            unsafe { *esc_bool_at(scratch_free_set, fb) = false; }
                            let fblk = unsafe { opt_block_at(body.blocks, fb) };
                            if (unsafe { (*fblk).is_reachable }) && (unsafe { (*fblk).term.kind }) == OPT_TERM_CALL {
                                let fsym_v = esc_extract_callee_sym(body, unsafe { view((*fblk).term.orig_term.func) }).v;
                                let mut fsum = escape_summary_zero(SymbolId { v: fsym_v }, 0);
                                if escape_summary_table_lookup(summary_table, (SymbolId { v: fsym_v }), mut_view(fsum)) &&
                                   (unsafe { (*fblk).term.orig_term.arg_count }) >= 1 &&
                                   (unsafe { (*fblk).term.orig_term.args as usize }) != 0 {
                                    let fa0 = unsafe { mir_op_at((*fblk).term.orig_term.args, 0) };
                                    if ((unsafe { (*fa0).kind }) == MIR_OP_COPY || (unsafe { (*fa0).kind }) == MIR_OP_MOVE) &&
                                       (unsafe { (*fa0).place.proj_count }) == 0 &&
                                       esc_local_is_ptr_alias_of(body, unsafe { (*fa0).place.local.v }, dl, 0u32) {
                                        if fsum.is_free_fn {
                                            if !(unsafe { (*fblk).is_cleanup }) {
                                                if opt_dominates(body, (OptBbId { v: b as u32 }), (OptBbId { v: fb as u32 })) {
                                                    unsafe { *esc_bool_at(scratch_free_set, fb) = true; }
                                                    free_bb = fb as u32;
                                                    free_cnt = free_cnt + 1;
                                                } else {
                                                    undom_free = true;
                                                }
                                            }
                                        } else if fsum.is_realloc_fn {
                                            has_rea = true;
                                        }
                                    }
                                }
                            }
                            fb = fb + 1;
                        }
                        let in_lp = esc_bb_reaches_without_killer(body, b as u32, b as u32, ESC_NONE_IDX, scratch_vis, scratch_q);
                        let mut crosses = in_lp;
                        let postdom_ok = !undom_free && esc_free_set_postdominates(
                            body,
                            b as u32,
                            start_bb,
                            in_lp,
                            scratch_free_set,
                            free_cnt,
                            scratch_vis,
                            scratch_q,
                            mut_view(crosses)
                        );
                        let has_free = postdom_ok && esc_raw_alloc_post_free_and_alias_safe(
                            body,
                            b as u32,
                            dl,
                            scratch_free_set,
                            scratch_vis,
                            scratch_q
                        );
                        let akind: u8 = if ecap > 1u64 && ety_v != 0u32 { ALLOC_KIND_BOUNDED_BUF } else { ALLOC_KIND_RAW_HEAP };
                        let sidx = esc_push_alloc_site(mut_view(*info), mut_view(*arena), AllocSite {
                            site_id: 0u32,
                            kind: akind,
                            alloc_bb: b as u32,
                            alloc_inst: ESC_NONE_IDX,
                            dest_local: dl,
                            raw_ptr_local: dl,
                            payload_ty: if ety_v != 0u32 && ecap == 1u64 { TypeId { v: ety_v } } else { TypeId { v: 0u32 } },
                            elem_ty: TypeId { v: ety_v },
                            elem_cap: if ecap == 0u64 { 1u64 } else { ecap },
                            known_size: sz_ok,
                            size_bytes: sz_v,
                            align_bytes: if al_ok && al_v > 0u64 { al_v } else { 8u64 },
                            free_bb: free_bb,
                            has_matching_free: has_free,
                            has_realloc: has_rea,
                            in_loop: in_lp,
                            crosses_backedge: crosses,
                            escape_set: ESC_NONE,
                            escape_class: ESCAPE_NO_ESCAPE,
                            storage_decision: STORAGE_DECISION_HEAP,
                            reason: REASON_NONE,
                            promoted: false,
                            promoted_local: ESC_NONE_IDX,
                        });
                        let lp = unsafe { escape_local_at(info.locals, dl as usize) };
                        unsafe {
                            (*lp).alloc_site_idx = sidx;
                            (*lp).known_size = sz_ok;
                            (*lp).size_bytes = sz_v;
                            (*lp).align_bytes = if al_ok && al_v > 0u64 { al_v } else { 8u64 };
                            (*lp).has_dynamic_realloc = has_rea;
                            (*lp).crosses_loop_backedge = crosses;
                        }
                    } else if csum.is_box_new_fn {
                        let box_ty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, dl as usize)).v } };
                        let mut pty = TypeId { v: 0u32 };
                        if esc_type_is_box_like(body.thir, box_ty, mut_view(pty)) {
                            let pty_v = pty.v;
                            let mut pok = false;
                            let mut pal: u64 = 8u64;
                            let psz = escape_type_byte_size(body.thir, TypeId { v: pty_v }, mut_view(pok), mut_view(pal));
                            let start_bb_box = unsafe { (*bb).term.orig_term.call_target.v };
                            let mut drop_bb: u32 = ESC_NONE_IDX;
                            let mut drop_cnt: usize = 0;
                            let mut undom_drop = false;
                            let mut fb: usize = 0;
                            while fb < bcnt {
                                unsafe { *esc_bool_at(scratch_free_set, fb) = false; }
                                let fblk = unsafe { opt_block_at(body.blocks, fb) };
                                if (unsafe { (*fblk).is_reachable }) && !(unsafe { (*fblk).is_cleanup }) {
                                    let mut blk_drops = (unsafe { (*fblk).term.kind }) == OPT_TERM_DROP &&
                                                        (unsafe { (*fblk).term.drop_place.proj_count }) == 0 &&
                                                        (unsafe { (*fblk).term.drop_place.local.v }) == dl;
                                    let mut is_s: usize = 0;
                                    while !blk_drops && is_s < (unsafe { (*fblk).inst_count }) {
                                        let ds_inst = unsafe { opt_inst_at((*fblk).insts, is_s) };
                                        if (unsafe { (*ds_inst).orig_stmt.kind }) == MIR_STMT_DROP &&
                                           (unsafe { (*ds_inst).orig_stmt.place.proj_count }) == 0 &&
                                           (unsafe { (*ds_inst).orig_stmt.place.local.v }) == dl {
                                            blk_drops = true;
                                        }
                                        is_s = is_s + 1;
                                    }
                                    if blk_drops {
                                        if opt_dominates(body, (OptBbId { v: b as u32 }), (OptBbId { v: fb as u32 })) {
                                            unsafe { *esc_bool_at(scratch_free_set, fb) = true; }
                                            drop_bb = fb as u32;
                                            drop_cnt = drop_cnt + 1;
                                        } else {
                                            undom_drop = true;
                                        }
                                    }
                                }
                                fb = fb + 1;
                            }
                            let in_lp = esc_bb_reaches_without_killer(body, b as u32, b as u32, ESC_NONE_IDX, scratch_vis, scratch_q);
                            let no_whole_xfer = esc_opt_box_no_whole_value_transfer(body, dl, b as u32);
                            let mut crosses = in_lp;
                            let mut has_drp = false;
                            if no_whole_xfer && !undom_drop {
                                if drop_cnt == 0 {
                                    has_drp = !in_lp;
                                } else {
                                    let pdom = esc_free_set_postdominates(
                                        body,
                                        b as u32,
                                        start_bb_box,
                                        in_lp,
                                        scratch_free_set,
                                        drop_cnt,
                                        scratch_vis,
                                        scratch_q,
                                        mut_view(crosses)
                                    );
                                    has_drp = pdom && esc_box_post_drop_safe(body, b as u32, dl, scratch_free_set, scratch_vis, scratch_q);
                                }
                            }
                            let sidx = esc_push_alloc_site(mut_view(*info), mut_view(*arena), AllocSite {
                                site_id: 0u32,
                                kind: ALLOC_KIND_BOX_NEW,
                                alloc_bb: b as u32,
                                alloc_inst: ESC_NONE_IDX,
                                dest_local: dl,
                                raw_ptr_local: dl,
                                payload_ty: TypeId { v: pty_v },
                                elem_ty: TypeId { v: pty_v },
                                elem_cap: 1u64,
                                known_size: pok,
                                size_bytes: psz,
                                align_bytes: pal,
                                free_bb: drop_bb,
                                has_matching_free: has_drp,
                                has_realloc: false,
                                in_loop: in_lp,
                                crosses_backedge: crosses,
                                escape_set: ESC_NONE,
                                escape_class: ESCAPE_NO_ESCAPE,
                                storage_decision: STORAGE_DECISION_HEAP,
                                reason: REASON_NONE,
                                promoted: false,
                                promoted_local: ESC_NONE_IDX,
                            });
                            let lp = unsafe { escape_local_at(info.locals, dl as usize) };
                            unsafe {
                                (*lp).alloc_site_idx = sidx;
                                (*lp).known_size = pok;
                                (*lp).size_bytes = psz;
                                (*lp).align_bytes = pal;
                                (*lp).crosses_loop_backedge = crosses;
                            }
                        }
                    } else if csum.is_vec_with_cap_fn && acnt >= 1 && (args as usize) != 0 {
                        let a0 = unsafe { mir_op_at(args, 0) };
                        let mut cap_ok = false;
                        let mut dty = TypeId { v: 0u32 };
                        let mut dcap: u64 = 0u64;
                        let cap_v = esc_eval_operand_const_u64(body, unsafe { view(*a0) }, 0u32, mut_view(cap_ok), mut_view(dty), mut_view(dcap));
                        let vty_v = unsafe { (*opt_typeid_at(body.local_tys, dl as usize)).v };
                        let vtp = if (body.thir as usize) != 0 { type_get(unsafe { view((*body.thir).interner) }, TypeId { v: vty_v }) } else { 0 as *mut AxType };
                        let ety_v2: u32 = if (vtp as usize) != 0 && (unsafe { (*vtp).arg_count }) >= 1 && (unsafe { (*vtp).args as usize }) != 0 {
                            unsafe { (*typeid_at((*vtp).args, 0)).v }
                        } else {
                            0u32
                        };
                        let mut eok = false;
                        let mut eal: u64 = 8u64;
                        let esz = escape_type_byte_size(body.thir, TypeId { v: ety_v2 }, mut_view(eok), mut_view(eal));
                        let sz_known = cap_ok && eok && (esz == 0u64 || cap_v <= (0xFFFFFFFFu64 / esz));
                        let tot_sz: u64 = if sz_known { cap_v * esz } else { 0u64 };
                        let start_bb_vec = unsafe { (*bb).term.orig_term.call_target.v };
                        let mut drop_bb: u32 = ESC_NONE_IDX;
                        let mut drop_cnt2: usize = 0;
                        let mut undom_drop2 = false;
                        let mut fb: usize = 0;
                        while fb < bcnt {
                            unsafe { *esc_bool_at(scratch_free_set, fb) = false; }
                            let fblk = unsafe { opt_block_at(body.blocks, fb) };
                            if (unsafe { (*fblk).is_reachable }) && !(unsafe { (*fblk).is_cleanup }) {
                                let mut blk_drops2 = (unsafe { (*fblk).term.kind }) == OPT_TERM_DROP &&
                                                     (unsafe { (*fblk).term.drop_place.proj_count }) == 0 &&
                                                     (unsafe { (*fblk).term.drop_place.local.v }) == dl;
                                let mut is_s2: usize = 0;
                                while !blk_drops2 && is_s2 < (unsafe { (*fblk).inst_count }) {
                                    let ds_inst2 = unsafe { opt_inst_at((*fblk).insts, is_s2) };
                                    if (unsafe { (*ds_inst2).orig_stmt.kind }) == MIR_STMT_DROP &&
                                       (unsafe { (*ds_inst2).orig_stmt.place.proj_count }) == 0 &&
                                       (unsafe { (*ds_inst2).orig_stmt.place.local.v }) == dl {
                                        blk_drops2 = true;
                                    }
                                    is_s2 = is_s2 + 1;
                                }
                                if blk_drops2 {
                                    if opt_dominates(body, (OptBbId { v: b as u32 }), (OptBbId { v: fb as u32 })) {
                                        unsafe { *esc_bool_at(scratch_free_set, fb) = true; }
                                        drop_bb = fb as u32;
                                        drop_cnt2 = drop_cnt2 + 1;
                                    } else {
                                        undom_drop2 = true;
                                    }
                                }
                            }
                            fb = fb + 1;
                        }
                        let in_lp = esc_bb_reaches_without_killer(body, b as u32, b as u32, ESC_NONE_IDX, scratch_vis, scratch_q);
                        let no_whole_xfer2 = esc_opt_box_no_whole_value_transfer(body, dl, b as u32);
                        let mut crosses = in_lp;
                        let mut has_drp = false;
                        if no_whole_xfer2 && !undom_drop2 {
                            if drop_cnt2 == 0 {
                                has_drp = !in_lp;
                            } else {
                                let pdom2 = esc_free_set_postdominates(
                                    body,
                                    b as u32,
                                    start_bb_vec,
                                    in_lp,
                                    scratch_free_set,
                                    drop_cnt2,
                                    scratch_vis,
                                    scratch_q,
                                    mut_view(crosses)
                                );
                                has_drp = pdom2 && esc_box_post_drop_safe(body, b as u32, dl, scratch_free_set, scratch_vis, scratch_q);
                            }
                        }
                        let sidx = esc_push_alloc_site(mut_view(*info), mut_view(*arena), AllocSite {
                            site_id: 0u32,
                            kind: ALLOC_KIND_VEC_WITH_CAP,
                            alloc_bb: b as u32,
                            alloc_inst: ESC_NONE_IDX,
                            dest_local: dl,
                            raw_ptr_local: dl,
                            payload_ty: TypeId { v: vty_v },
                            elem_ty: TypeId { v: ety_v2 },
                            elem_cap: cap_v,
                            known_size: sz_known,
                            size_bytes: tot_sz,
                            align_bytes: eal,
                            free_bb: drop_bb,
                            has_matching_free: has_drp,
                            has_realloc: !cap_ok,
                            in_loop: in_lp,
                            crosses_backedge: crosses,
                            escape_set: ESC_NONE,
                            escape_class: ESCAPE_NO_ESCAPE,
                            storage_decision: STORAGE_DECISION_HEAP,
                            reason: REASON_NONE,
                            promoted: false,
                            promoted_local: ESC_NONE_IDX,
                        });
                        let lp = unsafe { escape_local_at(info.locals, dl as usize) };
                        unsafe {
                            (*lp).alloc_site_idx = sidx;
                            (*lp).known_size = sz_known;
                            (*lp).size_bytes = tot_sz;
                            (*lp).align_bytes = eal;
                            (*lp).has_dynamic_realloc = !cap_ok;
                            (*lp).crosses_loop_backedge = crosses;
                        }
                    }
                }
            }
        }
        b = b + 1;
    }
}

fn esc_slot_strictly_confined_to_interval(
    body: view<OptBody>,
    loc_v: u32,
    bba: u32,
    sa: u32,
    ea: u32
) -> bool {
    if (bba as usize) >= body.bb_count || (body.blocks as usize) == 0 || sa >= ea {
        return false;
    }
    let home_bb = unsafe { opt_block_at(body.blocks, bba as usize) };
    if !(unsafe { (*home_bb).is_reachable }) || (unsafe { (*home_bb).is_cleanup }) {
        return false;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let in_range = (b as u32) == bba && (i as u32) >= sa && (i as u32) <= ea;
            if !in_range {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                if esc_stmt_uses_local(unsafe { view((*inst).orig_stmt) }, loc_v) {
                    return false;
                }
            }
            i = i + 1;
        }
        // Block terminator executes AFTER `ea` even in `bba`, so `loc_v` must never appear in any terminator!
        if (unsafe { (*bb).term.has_call_dest }) && esc_place_uses_local(unsafe { view((*bb).term.call_dest) }, loc_v) {
            return false;
        }
        if esc_term_uses_local(unsafe { view((*bb).term.orig_term) }, loc_v) {
            return false;
        }
        b = b + 1;
    }
    true
}

fn esc_slot_candidate_eligible(
    lp: view<LocalEscapeState>,
    body: view<OptBody>,
    loc_v: u32,
    bba: u32,
    sa: u32,
    ea: u32
) -> bool {
    if lp.alloc_site_idx != ESC_NONE_IDX || lp.reuse_partner_local != ESC_NONE_IDX {
        return false;
    }
    if lp.identity_compared || lp.address_observable || lp.has_active_view_escape || lp.crosses_loop_backedge {
        return false;
    }
    if lp.is_fixed_mmio || lp.is_volatile_atomic || lp.is_zero_copy_pinned {
        return false;
    }
    if lp.escape_class > ESCAPE_ARG_ESCAPE {
        return false;
    }
    if !lp.known_size || lp.size_bytes == 0u64 {
        return false;
    }
    esc_slot_strictly_confined_to_interval(body, loc_v, bba, sa, ea)
}

fn esc_compute_disjoint_slot_pairs(info: mut_view<EscapeInfo>, body: view<OptBody>, arena: mut_view<Arena>) {
    let lcnt = info.local_count;
    if lcnt < 2 || body.bb_count == 0 || (body.blocks as usize) == 0 {
        return;
    }
    // Track explicit single-block `[StorageLive(l), StorageDead(l)]` intervals for stack locals (`AXS-ESC-013.2`)
    let live_bb = arena_alloc_raw(mut_view(*arena), esc_mul_usize(lcnt, size_of<u32>()), align_of<u32>()) as *mut u32;
    let live_start = arena_alloc_raw(mut_view(*arena), esc_mul_usize(lcnt, size_of<u32>()), align_of<u32>()) as *mut u32;
    let live_end = arena_alloc_raw(mut_view(*arena), esc_mul_usize(lcnt, size_of<u32>()), align_of<u32>()) as *mut u32;
    let live_cnt = arena_alloc_raw(mut_view(*arena), esc_mul_usize(lcnt, size_of<u32>()), align_of<u32>()) as *mut u32;
    let dead_cnt = arena_alloc_raw(mut_view(*arena), esc_mul_usize(lcnt, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut l: usize = 0;
    while l < lcnt {
        unsafe {
            *esc_u32_at(live_bb, l) = ESC_NONE_IDX;
            *esc_u32_at(live_start, l) = 0u32;
            *esc_u32_at(live_end, l) = 0u32;
            *esc_u32_at(live_cnt, l) = 0u32;
            *esc_u32_at(dead_cnt, l) = 0u32;
        }
        l = l + 1;
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            let sk = unsafe { (*inst).orig_stmt.kind };
            if sk == MIR_STMT_STORAGE_LIVE {
                let lv = unsafe { (*inst).orig_stmt.storage_local.v } as usize;
                if lv > body.arg_count && lv < lcnt {
                    unsafe {
                        *esc_u32_at(live_cnt, lv) = *esc_u32_at(live_cnt, lv) + 1u32;
                        *esc_u32_at(live_bb, lv) = b as u32;
                        *esc_u32_at(live_start, lv) = i as u32;
                    }
                }
            } else if sk == MIR_STMT_STORAGE_DEAD {
                let lv = unsafe { (*inst).orig_stmt.storage_local.v } as usize;
                if lv > body.arg_count && lv < lcnt {
                    unsafe {
                        *esc_u32_at(dead_cnt, lv) = *esc_u32_at(dead_cnt, lv) + 1u32;
                        if *esc_u32_at(live_bb, lv) == (b as u32) {
                            *esc_u32_at(live_end, lv) = i as u32;
                        } else {
                            *esc_u32_at(live_bb, lv) = ESC_NONE_IDX;
                        }
                    }
                }
            }
            i = i + 1;
        }
        b = b + 1;
    }

    let mut a: usize = body.arg_count + 1;
    while a < lcnt {
        let lpa = unsafe { escape_local_at(info.locals, a) };
        if unsafe { *esc_u32_at(live_cnt, a) == 1u32 && *esc_u32_at(dead_cnt, a) == 1u32 &&
                    *esc_u32_at(live_bb, a) != ESC_NONE_IDX } {
            let bba = unsafe { *esc_u32_at(live_bb, a) };
            let sa = unsafe { *esc_u32_at(live_start, a) };
            let ea = unsafe { *esc_u32_at(live_end, a) };
            if esc_slot_candidate_eligible(unsafe { view(*lpa) }, body, a as u32, bba, sa, ea) {
                let mut c: usize = a + 1;
                while c < lcnt {
                    let lpc = unsafe { escape_local_at(info.locals, c) };
                    if unsafe { *esc_u32_at(live_cnt, c) == 1u32 && *esc_u32_at(dead_cnt, c) == 1u32 &&
                                *esc_u32_at(live_bb, c) == bba } {
                        let sc = unsafe { *esc_u32_at(live_start, c) };
                        let ec = unsafe { *esc_u32_at(live_end, c) };
                        if (ea < sc || ec < sa) &&
                           esc_slot_candidate_eligible(unsafe { view(*lpc) }, body, c as u32, bba, sc, ec) {
                            let sza = unsafe { (*lpa).size_bytes };
                            let szc = unsafe { (*lpc).size_bytes };
                            let saved: u64 = if sza <= szc { sza } else { szc };
                            unsafe {
                                (*lpa).reuse_partner_local = c as u32;
                                (*lpc).reuse_partner_local = a as u32;
                            }
                            if info.disjoint_pair_count >= info.disjoint_pair_cap {
                                let ncap: usize = if info.disjoint_pair_cap == 0 { 8 } else { info.disjoint_pair_cap + info.disjoint_pair_cap };
                                let nbuf = arena_alloc_raw(
                                    mut_view(*arena),
                                    esc_mul_usize(ncap, size_of<DisjointSlotPair>()),
                                    align_of<DisjointSlotPair>()
                                ) as *mut DisjointSlotPair;
                                if info.disjoint_pair_count > 0 && (info.disjoint_pairs as usize) != 0 {
                                    unsafe {
                                        ptr_copy_nonoverlapping<DisjointSlotPair>(
                                            info.disjoint_pairs as *const DisjointSlotPair,
                                            nbuf,
                                            info.disjoint_pair_count
                                        );
                                    }
                                }
                                info.disjoint_pairs = nbuf;
                                info.disjoint_pair_cap = ncap;
                            }
                            let pdst = unsafe { escape_pair_at(info.disjoint_pairs, info.disjoint_pair_count) };
                            unsafe {
                                *pdst = DisjointSlotPair {
                                    local_a: a as u32,
                                    local_b: c as u32,
                                    saved_bytes: saved,
                                };
                            }
                            info.disjoint_pair_count = info.disjoint_pair_count + 1;
                            info.reused_stack_bytes = info.reused_stack_bytes + saved;
                            break;
                        }
                    }
                    c = c + 1;
                }
            }
        }
        a = a + 1;
    }
}


// --- Intraprocedural Escape Dataflow & Interprocedural Summary Extraction (`AXS-ESC-002..004`) ---

fn esc_place_first_deref_idx(pl: view<MirPlace>) -> usize {
    let mut i: usize = 0;
    while i < pl.proj_count && (pl.projs as usize) != 0 {
        let pr = unsafe { mir_proj_at(pl.projs, i) };
        if (unsafe { (*pr).kind }) == MIR_PROJ_DEREF {
            return i;
        }
        i = i + 1;
    }
    pl.proj_count
}

fn esc_place_last_deref_idx(pl: view<MirPlace>) -> usize {
    let mut last: usize = pl.proj_count;
    let mut i: usize = 0;
    while i < pl.proj_count && (pl.projs as usize) != 0 {
        let pr = unsafe { mir_proj_at(pl.projs, i) };
        if (unsafe { (*pr).kind }) == MIR_PROJ_DEREF {
            last = i;
        }
        i = i + 1;
    }
    last
}

fn esc_join_val(info: mut_view<EscapeInfo>, loc_v: u32, bits: u16) -> bool {
    if bits == 0u16 || (loc_v as usize) >= info.local_count {
        return false;
    }
    let lp = unsafe { escape_local_at(info.locals, loc_v as usize) };
    let old_v = unsafe { (*lp).val_escape };
    let new_v = old_v | bits;
    if new_v != old_v {
        unsafe { (*lp).val_escape = new_v; }
        return true;
    }
    false
}

fn esc_join_ind(info: mut_view<EscapeInfo>, loc_v: u32, bits: u16) -> bool {
    if bits == 0u16 || (loc_v as usize) >= info.local_count {
        return false;
    }
    let lp = unsafe { escape_local_at(info.locals, loc_v as usize) };
    let old_i = unsafe { (*lp).ind_escape };
    let new_i = old_i | bits;
    if new_i != old_i {
        unsafe { (*lp).ind_escape = new_i; }
        return true;
    }
    false
}

fn esc_mark_stable(info: mut_view<EscapeInfo>, loc_v: u32, obs: bool, ident_cmp: bool) -> bool {
    if (loc_v as usize) >= info.local_count {
        return false;
    }
    let lp = unsafe { escape_local_at(info.locals, loc_v as usize) };
    let mut ch = false;
    if !(unsafe { (*lp).stable_address }) {
        unsafe { (*lp).stable_address = true; }
        ch = true;
    }
    if obs && !(unsafe { (*lp).address_observable }) {
        unsafe { (*lp).address_observable = true; }
        ch = true;
    }
    if ident_cmp && !(unsafe { (*lp).identity_compared }) {
        unsafe { (*lp).identity_compared = true; }
        ch = true;
    }
    ch
}

fn esc_propagate_to_operand(
    info: mut_view<EscapeInfo>,
    body: view<OptBody>,
    op: view<MirOperand>,
    bits: u16,
    force_scalar_val: bool
) -> bool {
    if bits == 0u16 || (op.kind != MIR_OP_COPY && op.kind != MIR_OP_MOVE) {
        return false;
    }
    let lv = op.place.local.v;
    if (lv as usize) >= info.local_count {
        return false;
    }
    let first_d = esc_place_first_deref_idx(view(op.place));
    let mut lty = TypeId { v: 0u32 };
    if (body.local_tys as usize) != 0 {
        lty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, lv as usize)).v } };
    }
    let lp = unsafe { escape_local_at(info.locals, lv as usize) };
    let has_ind = esc_type_has_indirection(body.thir, lty, 0u32) || (unsafe { (*lp).alloc_site_idx }) != ESC_NONE_IDX;

    let mut ch = false;
    if first_d == op.place.proj_count {
        // Direct read from `lv` or `lv.field` (no `MIR_PROJ_DEREF`):
        let proj_has_ind = if op.place.proj_count == 0 {
            has_ind
        } else {
            esc_place_projected_has_indirection(body, view(op.place))
        };
        if proj_has_ind {
            if esc_join_val(mut_view(*info), lv, bits) { ch = true; }
            if esc_join_ind(mut_view(*info), lv, bits) { ch = true; }
        } else if force_scalar_val {
            if esc_join_val(mut_view(*info), lv, bits) { ch = true; }
        }
    } else {
        // Dereferenced read `(*lv)...`: `AESCAPE-26` — scalar value escape does NOT escape `lv`'s allocation,
        // whereas loading an indirection-carrying value (`*mut T`, `Box<T>`, `view<T>`, closure, etc.) DOES
        // propagate `bits` to `lv` and any underlying pointee owner local!
        if esc_place_projected_has_indirection(body, view(op.place)) {
            if esc_join_val(mut_view(*info), lv, bits) { ch = true; }
            if esc_join_ind(mut_view(*info), lv, bits) { ch = true; }
            let owner_loc = esc_find_pointee_owner_local(view(*info), body, lv);
            if owner_loc != ESC_NONE_IDX && (owner_loc as usize) < info.local_count {
                if esc_join_val(mut_view(*info), owner_loc, bits) { ch = true; }
                if esc_join_ind(mut_view(*info), owner_loc, bits) { ch = true; }
            }
        }
    }
    ch
}

fn esc_operand_param_mask(
    info: view<EscapeInfo>,
    body: view<OptBody>,
    op: view<MirOperand>,
    param_masks: *mut u32,
    lcnt: usize
) -> u32 {
    if op.kind != MIR_OP_COPY && op.kind != MIR_OP_MOVE {
        return 0u32;
    }
    let lv = op.place.local.v as usize;
    if lv >= lcnt || !esc_place_projected_has_indirection(body, view(op.place)) {
        return 0u32;
    }
    let mut m = unsafe { *esc_u32_at(param_masks, lv) };
    if esc_place_first_deref_idx(view(op.place)) != op.place.proj_count {
        let owner_loc = esc_find_pointee_owner_local(info, body, lv as u32);
        if owner_loc != ESC_NONE_IDX && (owner_loc as usize) < lcnt {
            m = m | (unsafe { *esc_u32_at(param_masks, owner_loc as usize) });
        }
    }
    m
}

fn esc_find_borrow_base_local_depth(body: view<OptBody>, ref_loc: u32, depth: u32) -> u32 {
    if depth > 8u32 || alias_count_local_defs(body, ref_loc) != 1u32 {
        return ESC_NONE_IDX;
    }
    let mut b: usize = 0;
    while b < body.bb_count && (body.blocks as usize) != 0 {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
               (unsafe { (*inst).orig_stmt.place.proj_count }) == 0 &&
               (unsafe { (*inst).orig_stmt.place.local.v }) == ref_loc {
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if rv.kind == MIR_RVALUE_REF &&
                   esc_place_first_deref_idx(view(rv.place)) == rv.place.proj_count {
                    return rv.place.local.v;
                }
                if (rv.kind == MIR_RVALUE_USE || (rv.kind == MIR_RVALUE_CAST && rv.cast_kind == MIR_CAST_PTR_TO_PTR)) &&
                   (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                   rv.use_op.place.proj_count == 0 {
                    return esc_find_borrow_base_local_depth(body, rv.use_op.place.local.v, depth + 1u32);
                }
                return ESC_NONE_IDX;
            }
            i = i + 1;
        }
        b = b + 1;
    }
    ESC_NONE_IDX
}

fn esc_find_borrow_base_local(body: view<OptBody>, ref_loc: u32) -> u32 {
    esc_find_borrow_base_local_depth(body, ref_loc, 0u32)
}

fn esc_find_pointee_owner_local(info: view<EscapeInfo>, body: view<OptBody>, ptr_loc: u32) -> u32 {
    if (ptr_loc as usize) >= info.local_count {
        return ESC_NONE_IDX;
    }
    let bbase = esc_find_borrow_base_local(body, ptr_loc);
    if bbase != ESC_NONE_IDX {
        if (bbase as usize) > body.arg_count && (bbase as usize) < info.local_count {
            return bbase;
        }
        return ESC_NONE_IDX;
    }
    let lp = unsafe { escape_local_at(info.locals, ptr_loc as usize) };
    if (unsafe { (*lp).alloc_site_idx }) != ESC_NONE_IDX {
        return ptr_loc;
    }
    let mut si: usize = 0;
    while si < info.site_count && (info.sites as usize) != 0 {
        let sp = unsafe { escape_site_at(info.sites, si) };
        let rloc = unsafe { (*sp).raw_ptr_local };
        let dloc = unsafe { (*sp).dest_local };
        if ptr_loc == rloc || ptr_loc == dloc ||
           esc_local_is_ptr_alias_of(body, ptr_loc, rloc, 0u32) ||
           esc_local_is_ptr_alias_of(body, ptr_loc, dloc, 0u32) {
            return dloc;
        }
        si = si + 1;
    }
    ESC_NONE_IDX
}

fn esc_run_escape_dataflow(
    info: mut_view<EscapeInfo>,
    body: view<OptBody>,
    alias_info: view<AliasInfo>,
    call_table: *const EffectCallTable,
    summary_table: *const EscapeSummaryTable,
    arena: mut_view<Arena>
) {
    let lcnt = info.local_count;
    let bcnt = body.bb_count;
    if lcnt == 0 || bcnt == 0 || (body.blocks as usize) == 0 {
        return;
    }

    let param_masks = arena_alloc_raw(mut_view(*arena), esc_mul_usize(lcnt, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut l: usize = 0;
    while l < lcnt {
        let mut pmask: u32 = 0u32;
        if l >= 1 && l <= body.arg_count && (l - 1) < 32 {
            let pty = if (body.local_tys as usize) != 0 {
                TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, l)).v } }
            } else {
                TypeId { v: 0u32 }
            };
            if esc_type_has_indirection(body.thir, pty, 0u32) {
                pmask = 1u32 << ((l - 1) as u32);
            }
        }
        unsafe { *esc_u32_at(param_masks, l) = pmask; }

        let lp = unsafe { escape_local_at(info.locals, l) };
        if l == 0 {
            unsafe {
                (*lp).val_escape = ESC_RETURN;
                (*lp).ind_escape = ESC_RETURN;
            }
        }
        if l < alias_info.local_count && (alias_info.locals as usize) != 0 {
            let alp = unsafe { alias_local_prov_at(alias_info.locals, l) };
            let adom = unsafe { (*alp).domain };
            if (unsafe { (*alp).is_fixed_mmio }) || adom == DOMAIN_FIXED_MMIO {
                unsafe {
                    (*lp).is_fixed_mmio = true;
                    (*lp).stable_address = true;
                    (*lp).address_observable = true;
                }
            }
            if (unsafe { (*alp).is_zero_copy_pinned }) || adom == DOMAIN_DEVICE_DMA ||
               alias_local_is_zero_copy_pinned_at(alias_info, l as u32, ALIAS_PT_WHOLE_START) {
                unsafe {
                    (*lp).is_zero_copy_pinned = true;
                    (*lp).stable_address = true;
                }
            }
            if adom == DOMAIN_GLOBAL_STATIC {
                unsafe {
                    (*lp).val_escape = (*lp).val_escape | ESC_HEAP;
                    (*lp).ind_escape = (*lp).ind_escape | ESC_HEAP;
                }
            }
        }
        l = l + 1;
    }

    // 1. Seed direct hardware/volatile/drop/cast/identity barriers before fixed-point propagation
    let mut b: usize = 0;
    while b < bcnt {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if !(unsafe { (*bb).is_reachable }) {
            b = b + 1;
            continue;
        }
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            let ik = unsafe { (*inst).opcode };
            let pt = alias_make_prog_pt(b as u32, i as u32);
            if ik == OPT_INST_VOLATILE_LOAD || ik == OPT_INST_VOLATILE_STORE ||
               ik == OPT_INST_ATOMIC || ik == OPT_INST_BLACK_BOX || ik == OPT_INST_ZEROIZE {
                let pl_l = unsafe { (*inst).place.local.v } as usize;
                if pl_l < lcnt {
                    let lp1 = unsafe { escape_local_at(info.locals, pl_l) };
                    unsafe {
                        (*lp1).is_volatile_atomic = true;
                        (*lp1).stable_address = true;
                    }
                    if (unsafe { (*inst).place.proj_count }) > 0 {
                        let base_l = esc_find_borrow_base_local(body, pl_l as u32);
                        if (base_l as usize) < lcnt {
                            let blp = unsafe { escape_local_at(info.locals, base_l as usize) };
                            unsafe {
                                (*blp).is_volatile_atomic = true;
                                (*blp).stable_address = true;
                            }
                        }
                    }
                }
                let rpl_l = unsafe { (*inst).rhs_place.local.v } as usize;
                if rpl_l < lcnt && rpl_l != 0 {
                    let lp2 = unsafe { escape_local_at(info.locals, rpl_l) };
                    unsafe {
                        (*lp2).is_volatile_atomic = true;
                        (*lp2).stable_address = true;
                    }
                    if (unsafe { (*inst).rhs_place.proj_count }) > 0 {
                        let rbase_l = esc_find_borrow_base_local(body, rpl_l as u32);
                        if (rbase_l as usize) < lcnt {
                            let rblp = unsafe { escape_local_at(info.locals, rbase_l as usize) };
                            unsafe {
                                (*rblp).is_volatile_atomic = true;
                                (*rblp).stable_address = true;
                            }
                        }
                    }
                }
            }
            let sk = unsafe { (*inst).orig_stmt.kind };
            if sk == MIR_STMT_DROP {
                let dl = unsafe { (*inst).orig_stmt.place.local.v } as usize;
                if dl < lcnt {
                    let dlp = unsafe { escape_local_at(info.locals, dl) };
                    unsafe { (*dlp).has_drop = true; }
                }
            } else if sk == MIR_STMT_ASSIGN {
                let dst = unsafe { view((*inst).orig_stmt.place) };
                let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                if (dst.local.v as usize) < lcnt && alias_local_is_zero_copy_pinned_at(alias_info, dst.local.v, pt) {
                    let zlp = unsafe { escape_local_at(info.locals, dst.local.v as usize) };
                    unsafe {
                        (*zlp).is_zero_copy_pinned = true;
                        (*zlp).stable_address = true;
                    }
                }
                if rv.kind == MIR_RVALUE_REF {
                    let bl = rv.place.local.v as usize;
                    if bl < lcnt && esc_place_first_deref_idx(view(rv.place)) == rv.place.proj_count {
                        let blp = unsafe { escape_local_at(info.locals, bl) };
                        unsafe {
                            (*blp).borrow_taken = true;
                            (*blp).stable_address = true;
                            if rv.borrow_kind == MIR_BORROW_MUT {
                                (*blp).mut_borrow_taken = true;
                            }
                        }
                    }
                } else if rv.kind == MIR_RVALUE_CAST {
                    if rv.cast_kind == MIR_CAST_PTR_TO_INT &&
                       (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) {
                        let plv = rv.use_op.place.local.v;
                        let null_only = dst.proj_count == 0 && esc_local_is_only_null_checked(body, dst.local.v);
                        if !null_only {
                            let _c = esc_mark_stable(mut_view(*info), plv, true, false);
                            if esc_place_first_deref_idx(view(rv.use_op.place)) != rv.use_op.place.proj_count {
                                let pown = esc_find_pointee_owner_local(view(*info), body, plv);
                                if pown != ESC_NONE_IDX {
                                    let _co = esc_mark_stable(mut_view(*info), pown, true, false);
                                }
                            }
                        }
                    } else if rv.cast_kind == MIR_CAST_INT_TO_PTR && dst.proj_count == 0 {
                        let _c1 = esc_mark_stable(mut_view(*info), dst.local.v, true, false);
                        let _c2 = esc_join_val(mut_view(*info), dst.local.v, ESC_EXTERNAL);
                        let _c3 = esc_join_ind(mut_view(*info), dst.local.v, ESC_EXTERNAL);
                    }
                } else if rv.kind == MIR_RVALUE_BINARY_OP && (rv.bin_op == MIR_BINOP_EQ || rv.bin_op == MIR_BINOP_NE) {
                    // Pointer identity comparison `p == q` (`AXS-ESC-004` rule 8)
                    let l_is_var = rv.lhs.kind == MIR_OP_COPY || rv.lhs.kind == MIR_OP_MOVE;
                    let r_is_var = rv.rhs.kind == MIR_OP_COPY || rv.rhs.kind == MIR_OP_MOVE;
                    if l_is_var && r_is_var && (body.thir as usize) != 0 && (body.local_tys as usize) != 0 {
                        let ll = rv.lhs.place.local.v as usize;
                        let rl = rv.rhs.place.local.v as usize;
                        if ll < lcnt && rl < lcnt {
                            let lty = esc_place_projected_type(body, view(rv.lhs.place));
                            let rty = esc_place_projected_type(body, view(rv.rhs.place));
                            let ltp = type_get(unsafe { view((*body.thir).interner) }, lty);
                            let rtp = type_get(unsafe { view((*body.thir).interner) }, rty);
                            if (ltp as usize) != 0 && (rtp as usize) != 0 &&
                               (unsafe { (*ltp).kind }) == TY_PTR && (unsafe { (*rtp).kind }) == TY_PTR {
                                let _m1 = esc_mark_stable(mut_view(*info), ll as u32, true, true);
                                let _m2 = esc_mark_stable(mut_view(*info), rl as u32, true, true);
                                if esc_place_first_deref_idx(view(rv.lhs.place)) != rv.lhs.place.proj_count {
                                    let lown = esc_find_pointee_owner_local(view(*info), body, ll as u32);
                                    if lown != ESC_NONE_IDX {
                                        let _ml = esc_mark_stable(mut_view(*info), lown, true, true);
                                    }
                                }
                                if esc_place_first_deref_idx(view(rv.rhs.place)) != rv.rhs.place.proj_count {
                                    let rown = esc_find_pointee_owner_local(view(*info), body, rl as u32);
                                    if rown != ESC_NONE_IDX {
                                        let _mr = esc_mark_stable(mut_view(*info), rown, true, true);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        if (unsafe { (*bb).term.kind }) == OPT_TERM_DROP {
            let dl = unsafe { (*bb).term.drop_place.local.v } as usize;
            if dl < lcnt {
                let dlp = unsafe { escape_local_at(info.locals, dl) };
                unsafe { (*dlp).has_drop = true; }
            }
        }
        b = b + 1;
    }

    // 2. Monotone fixed-point propagation over CFG instructions & call terminators
    let max_rounds: usize = if lcnt + 8 < 48 { 48 } else { lcnt + 16 };
    let mut round: usize = 0;
    let mut changed = true;
    while changed && round < max_rounds {
        changed = false;
        let mut rb: usize = 0;
        while rb < bcnt {
            let bb = unsafe { opt_block_at(body.blocks, rb) };
            if !(unsafe { (*bb).is_reachable }) {
                rb = rb + 1;
                continue;
            }
            let icnt = unsafe { (*bb).inst_count };
            let mut ii: usize = 0;
            while ii < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, ii) };
                if (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_ASSIGN {
                    let dst = unsafe { view((*inst).orig_stmt.place) };
                    let rv = unsafe { view((*inst).orig_stmt.rvalue) };
                    let dl = dst.local.v;
                    if (dl as usize) < lcnt {
                        let dlp = unsafe { escape_local_at(info.locals, dl as usize) };
                        let dst_bits = unsafe { (*dlp).val_escape | (*dlp).ind_escape };
                        let dst_obs = unsafe { (*dlp).address_observable };
                        let dst_id = unsafe { (*dlp).identity_compared };
                        let dst_st = unsafe { (*dlp).stable_address };
                        let first_d = esc_place_first_deref_idx(dst);
                        let last_d = esc_place_last_deref_idx(dst);

                        // Determine escape bits and observability imposed by writing into `dst`
                        let mut store_bits = dst_bits;
                        let mut eff_obs = dst_obs;
                        let mut eff_id = dst_id;
                        let mut eff_st = dst_st;
                        let mut dst_owner_loc: u32 = ESC_NONE_IDX;
                        if first_d != dst.proj_count {
                            if last_d >= 1 {
                                // Interior deref `*(s.mv) = x` or `(*(*p).q) = x` (`AXS-ESC-004` rule 1)
                                store_bits = store_bits | ESC_HEAP | ESC_ARGUMENT;
                                info.summary.captures_into_global = true;
                            } else {
                                let owner_loc = esc_find_pointee_owner_local(view(*info), body, dl);
                                if owner_loc != ESC_NONE_IDX && (owner_loc as usize) < lcnt {
                                    dst_owner_loc = owner_loc;
                                    let olp = unsafe { escape_local_at(info.locals, owner_loc as usize) };
                                    store_bits = store_bits | (unsafe { (*olp).val_escape | (*olp).ind_escape });
                                    if unsafe { (*olp).address_observable } { eff_obs = true; }
                                    if unsafe { (*olp).identity_compared } { eff_id = true; }
                                    if unsafe { (*olp).stable_address } { eff_st = true; }
                                } else {
                                    let pmask_dl = unsafe { *esc_u32_at(param_masks, dl as usize) };
                                    if pmask_dl != 0u32 || (dl >= 1u32 && (dl as usize) <= body.arg_count) {
                                        store_bits = store_bits | ESC_HEAP | ESC_ARGUMENT;
                                    } else {
                                        store_bits = store_bits | ESC_HEAP;
                                    }
                                    info.summary.captures_into_global = true;
                                }
                            }
                        }

                        if rv.kind == MIR_RVALUE_USE {
                            if esc_propagate_to_operand(mut_view(*info), body, view(rv.use_op), store_bits, dl == 0u32 && dst.proj_count == 0) {
                                changed = true;
                            }
                            if (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                               esc_place_projected_has_indirection(body, view(rv.use_op.place)) {
                                let sl = rv.use_op.place.local.v;
                                let src_has_deref = esc_place_first_deref_idx(view(rv.use_op.place)) != rv.use_op.place.proj_count;
                                let src_own = if src_has_deref { esc_find_pointee_owner_local(view(*info), body, sl) } else { ESC_NONE_IDX };
                                if (sl as usize) < lcnt {
                                    let smask = esc_operand_param_mask(view(*info), body, view(rv.use_op), param_masks, lcnt);
                                    if first_d == dst.proj_count {
                                        let dmask = unsafe { *esc_u32_at(param_masks, dl as usize) };
                                        if (dmask | smask) != dmask {
                                            unsafe { *esc_u32_at(param_masks, dl as usize) = dmask | smask; }
                                            changed = true;
                                        }
                                    } else if dst_owner_loc != ESC_NONE_IDX && (dst_owner_loc as usize) < lcnt {
                                        let omask = unsafe { *esc_u32_at(param_masks, dst_owner_loc as usize) };
                                        if (omask | smask) != omask {
                                            unsafe { *esc_u32_at(param_masks, dst_owner_loc as usize) = omask | smask; }
                                            changed = true;
                                        }
                                    }
                                    // Propagate address observability backward across pointer/Box copies & deref loads (`q = *slot; u = q as usize`)
                                    if eff_obs || eff_id || (first_d == dst.proj_count && eff_st) {
                                        if esc_mark_stable(mut_view(*info), sl, eff_obs, eff_id) {
                                            changed = true;
                                        }
                                        if src_own != ESC_NONE_IDX && esc_mark_stable(mut_view(*info), src_own, eff_obs, eff_id) {
                                            changed = true;
                                        }
                                    }
                                }
                            }
                        } else if rv.kind == MIR_RVALUE_REF {
                            let bl = rv.place.local.v;
                            if (bl as usize) < lcnt {
                                let ref_d = esc_place_first_deref_idx(view(rv.place));
                                if esc_join_ind(mut_view(*info), bl, store_bits) { changed = true; }
                                if ref_d != rv.place.proj_count {
                                    // Re-borrowing `&(*p).f` propagates `store_bits` to pointer/Box `p` as well
                                    if esc_join_val(mut_view(*info), bl, store_bits) { changed = true; }
                                    let ref_own = esc_find_pointee_owner_local(view(*info), body, bl);
                                    if ref_own != ESC_NONE_IDX {
                                        if esc_join_ind(mut_view(*info), ref_own, store_bits) { changed = true; }
                                    }
                                }
                                if (store_bits & (ESC_RETURN | ESC_GLOBAL_MASK)) != 0u16 {
                                    let blp = unsafe { escape_local_at(info.locals, bl as usize) };
                                    if !(unsafe { (*blp).has_active_view_escape }) {
                                        unsafe { (*blp).has_active_view_escape = true; }
                                        changed = true;
                                    }
                                }
                                if eff_obs || eff_id {
                                    if esc_mark_stable(mut_view(*info), bl, eff_obs, eff_id) { changed = true; }
                                    if ref_d != rv.place.proj_count {
                                        let ref_own2 = esc_find_pointee_owner_local(view(*info), body, bl);
                                        if ref_own2 != ESC_NONE_IDX && esc_mark_stable(mut_view(*info), ref_own2, eff_obs, eff_id) {
                                            changed = true;
                                        }
                                    }
                                }
                                let bmask = unsafe { *esc_u32_at(param_masks, bl as usize) };
                                if first_d == dst.proj_count {
                                    let dmask = unsafe { *esc_u32_at(param_masks, dl as usize) };
                                    if (dmask | bmask) != dmask {
                                        unsafe { *esc_u32_at(param_masks, dl as usize) = dmask | bmask; }
                                        changed = true;
                                    }
                                } else if dst_owner_loc != ESC_NONE_IDX && (dst_owner_loc as usize) < lcnt {
                                    let omask = unsafe { *esc_u32_at(param_masks, dst_owner_loc as usize) };
                                    if (omask | bmask) != omask {
                                        unsafe { *esc_u32_at(param_masks, dst_owner_loc as usize) = omask | bmask; }
                                        changed = true;
                                    }
                                }
                            }
                        } else if rv.kind == MIR_RVALUE_CAST {
                            if rv.cast_kind == MIR_CAST_PTR_TO_PTR {
                                if esc_propagate_to_operand(mut_view(*info), body, view(rv.use_op), store_bits, false) {
                                    changed = true;
                                }
                                if (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) {
                                    let sl = rv.use_op.place.local.v;
                                    let src_has_deref = esc_place_first_deref_idx(view(rv.use_op.place)) != rv.use_op.place.proj_count;
                                    let src_own = if src_has_deref { esc_find_pointee_owner_local(view(*info), body, sl) } else { ESC_NONE_IDX };
                                    if eff_obs || eff_id || (first_d == dst.proj_count && eff_st) {
                                        if esc_mark_stable(mut_view(*info), sl, eff_obs, eff_id) { changed = true; }
                                        if src_own != ESC_NONE_IDX && esc_mark_stable(mut_view(*info), src_own, eff_obs, eff_id) {
                                            changed = true;
                                        }
                                    }
                                    if (sl as usize) < lcnt {
                                        let smask = esc_operand_param_mask(view(*info), body, view(rv.use_op), param_masks, lcnt);
                                        if first_d == dst.proj_count {
                                            let dmask = unsafe { *esc_u32_at(param_masks, dl as usize) };
                                            if (dmask | smask) != dmask {
                                                unsafe { *esc_u32_at(param_masks, dl as usize) = dmask | smask; }
                                                changed = true;
                                            }
                                        } else if dst_owner_loc != ESC_NONE_IDX && (dst_owner_loc as usize) < lcnt {
                                            let omask = unsafe { *esc_u32_at(param_masks, dst_owner_loc as usize) };
                                            if (omask | smask) != omask {
                                                unsafe { *esc_u32_at(param_masks, dst_owner_loc as usize) = omask | smask; }
                                                changed = true;
                                            }
                                        }
                                    }
                                }
                            } else if rv.cast_kind == MIR_CAST_PTR_TO_INT {
                                let null_only = dst.proj_count == 0 && esc_local_is_only_null_checked(body, dl);
                                if !null_only && (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) {
                                    let sl = rv.use_op.place.local.v;
                                    if esc_mark_stable(mut_view(*info), sl, true, false) { changed = true; }
                                    if (store_bits & (ESC_RETURN | ESC_GLOBAL_MASK)) != 0u16 {
                                        if esc_join_ind(mut_view(*info), sl, store_bits) { changed = true; }
                                    }
                                    if esc_place_first_deref_idx(view(rv.use_op.place)) != rv.use_op.place.proj_count {
                                        let src_own = esc_find_pointee_owner_local(view(*info), body, sl);
                                        if src_own != ESC_NONE_IDX {
                                            if esc_mark_stable(mut_view(*info), src_own, true, false) { changed = true; }
                                            if (store_bits & (ESC_RETURN | ESC_GLOBAL_MASK)) != 0u16 {
                                                if esc_join_ind(mut_view(*info), src_own, store_bits) { changed = true; }
                                            }
                                        }
                                    }
                                }
                            }
                        } else if rv.kind == MIR_RVALUE_AGGREGATE {
                            let mut ao: usize = 0;
                            while ao < rv.operand_count && (rv.operands as usize) != 0 {
                                let op_p = unsafe { mir_op_at(rv.operands, ao) };
                                if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*op_p) }, store_bits, false) {
                                    changed = true;
                                }
                                if ((unsafe { (*op_p).kind }) == MIR_OP_COPY || (unsafe { (*op_p).kind }) == MIR_OP_MOVE) &&
                                   esc_place_projected_has_indirection(body, unsafe { view((*op_p).place) }) {
                                    let sl = unsafe { (*op_p).place.local.v };
                                    if (sl as usize) < lcnt {
                                        if eff_obs || eff_id {
                                            if esc_mark_stable(mut_view(*info), sl, eff_obs, eff_id) { changed = true; }
                                            if esc_place_first_deref_idx(unsafe { view((*op_p).place) }) != (unsafe { (*op_p).place.proj_count }) {
                                                let src_own = esc_find_pointee_owner_local(view(*info), body, sl);
                                                if src_own != ESC_NONE_IDX && esc_mark_stable(mut_view(*info), src_own, eff_obs, eff_id) {
                                                    changed = true;
                                                }
                                            }
                                        }
                                        let smask = esc_operand_param_mask(view(*info), body, unsafe { view(*op_p) }, param_masks, lcnt);
                                        if first_d == dst.proj_count {
                                            let dmask = unsafe { *esc_u32_at(param_masks, dl as usize) };
                                            if (dmask | smask) != dmask {
                                                unsafe { *esc_u32_at(param_masks, dl as usize) = dmask | smask; }
                                                changed = true;
                                            }
                                        } else if dst_owner_loc != ESC_NONE_IDX && (dst_owner_loc as usize) < lcnt {
                                            let omask = unsafe { *esc_u32_at(param_masks, dst_owner_loc as usize) };
                                            if (omask | smask) != omask {
                                                unsafe { *esc_u32_at(param_masks, dst_owner_loc as usize) = omask | smask; }
                                                changed = true;
                                            }
                                        }
                                    }
                                }
                                ao = ao + 1;
                            }
                        } else if rv.kind == MIR_RVALUE_REPEAT {
                            if esc_propagate_to_operand(mut_view(*info), body, view(rv.use_op), store_bits, false) {
                                changed = true;
                            }
                        }
                    }
                }
                ii = ii + 1;
            }

            // Call terminator escape transfer (`AXS-ESC-003.2`, `AXS-ESC-004` rules 3..7)
            if (unsafe { (*bb).term.kind }) == OPT_TERM_CALL {
                let ot = unsafe { view((*bb).term.orig_term) };
                let acnt = ot.arg_count;
                let args = ot.args;
                let has_dst = unsafe { (*bb).term.has_call_dest };
                let dst_pl = unsafe { view((*bb).term.call_dest) };
                let mut dst_bits: u16 = 0u16;
                let mut dst_obs = false;
                let mut dst_id = false;
                if has_dst && (dst_pl.local.v as usize) < lcnt {
                    let dlp = unsafe { escape_local_at(info.locals, dst_pl.local.v as usize) };
                    dst_bits = unsafe { (*dlp).val_escape | (*dlp).ind_escape };
                    dst_obs = unsafe { (*dlp).address_observable };
                    dst_id = unsafe { (*dlp).identity_compared };
                    if esc_place_first_deref_idx(dst_pl) != dst_pl.proj_count {
                        dst_bits = dst_bits | ESC_HEAP;
                    }
                }

                let bkind = esc_callee_builtin_kind(body, view(ot.func));
                if bkind != 0u8 && bkind != TY_FN && bkind != TY_CLOSURE {
                    if (bkind == TY_BUILTIN_ADDRESS_OF || bkind == TY_BUILTIN_ADDRESS_OF_MUT) && acnt >= 1 && (args as usize) != 0 {
                        let a0 = unsafe { mir_op_at(args, 0) };
                        if (unsafe { (*a0).kind } == MIR_OP_COPY || unsafe { (*a0).kind } == MIR_OP_MOVE) {
                            let alv = unsafe { (*a0).place.local.v };
                            if esc_mark_stable(mut_view(*info), alv, dst_obs, dst_id) { changed = true; }
                            if esc_join_ind(mut_view(*info), alv, dst_bits) { changed = true; }
                            if (dst_bits & (ESC_RETURN | ESC_GLOBAL_MASK)) != 0u16 && (alv as usize) < lcnt {
                                let alp = unsafe { escape_local_at(info.locals, alv as usize) };
                                if !(unsafe { (*alp).has_active_view_escape }) {
                                    unsafe { (*alp).has_active_view_escape = true; }
                                    changed = true;
                                }
                            }
                            if has_dst && dst_pl.proj_count == 0 && (dst_pl.local.v as usize) < lcnt && (alv as usize) < lcnt {
                                let amask = unsafe { *esc_u32_at(param_masks, alv as usize) };
                                let dmask = unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) };
                                if (dmask | amask) != dmask {
                                    unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) = dmask | amask; }
                                    changed = true;
                                }
                            }
                        }
                    } else if (bkind == TY_BUILTIN_PTR_ADD || bkind == TY_BUILTIN_PTR_SUB) && acnt >= 1 && (args as usize) != 0 {
                        let a0 = unsafe { mir_op_at(args, 0) };
                        if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*a0) }, dst_bits, false) {
                            changed = true;
                        }
                        if (unsafe { (*a0).kind } == MIR_OP_COPY || unsafe { (*a0).kind } == MIR_OP_MOVE) {
                            let alv = unsafe { (*a0).place.local.v };
                            if esc_mark_stable(mut_view(*info), alv, dst_obs, dst_id) { changed = true; }
                            if has_dst && dst_pl.proj_count == 0 && (dst_pl.local.v as usize) < lcnt && (alv as usize) < lcnt {
                                let amask = unsafe { *esc_u32_at(param_masks, alv as usize) };
                                let dmask = unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) };
                                if (dmask | amask) != dmask {
                                    unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) = dmask | amask; }
                                    changed = true;
                                }
                            }
                        }
                    } else if bkind == TY_BUILTIN_DROP_IN_PLACE && acnt >= 1 && (args as usize) != 0 {
                        let a0 = unsafe { mir_op_at(args, 0) };
                        if (unsafe { (*a0).kind } == MIR_OP_COPY || unsafe { (*a0).kind } == MIR_OP_MOVE) {
                            let alv = unsafe { (*a0).place.local.v };
                            if (alv as usize) < lcnt {
                                let alp = unsafe { escape_local_at(info.locals, alv as usize) };
                                if !(unsafe { (*alp).has_drop }) {
                                    unsafe { (*alp).has_drop = true; }
                                    changed = true;
                                }
                            }
                            if esc_mark_stable(mut_view(*info), alv, false, false) { changed = true; }
                            if esc_join_ind(mut_view(*info), alv, ESC_ARGUMENT) { changed = true; }
                        }
                    } else if (bkind == TY_BUILTIN_PTR_COPY || bkind == TY_BUILTIN_PTR_COPY_NONOVERLAPPING) &&
                              acnt >= 2 && (args as usize) != 0 {
                        let a0 = unsafe { mir_op_at(args, 0) };
                        let a1 = unsafe { mir_op_at(args, 1) };
                        if (unsafe { (*a0).kind } == MIR_OP_COPY || unsafe { (*a0).kind } == MIR_OP_MOVE) {
                            if esc_mark_stable(mut_view(*info), unsafe { (*a0).place.local.v }, false, false) { changed = true; }
                        }
                        if (unsafe { (*a1).kind } == MIR_OP_COPY || unsafe { (*a1).kind } == MIR_OP_MOVE) {
                            let dlv = unsafe { (*a1).place.local.v };
                            if esc_mark_stable(mut_view(*info), dlv, false, false) { changed = true; }
                            if (dlv as usize) < lcnt {
                                let dlp2 = unsafe { escape_local_at(info.locals, dlv as usize) };
                                let db2 = unsafe { (*dlp2).val_escape | (*dlp2).ind_escape };
                                if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*a0) }, db2, false) {
                                    changed = true;
                                }
                            }
                        }
                    } else if bkind == TY_BUILTIN_FORGET && acnt >= 1 && (args as usize) != 0 {
                        let a0 = unsafe { mir_op_at(args, 0) };
                        if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*a0) }, ESC_HEAP, true) {
                            changed = true;
                        }
                    }
                } else {
                    let csym_v = esc_extract_callee_sym(body, view(ot.func)).v;
                    // If calling a local closure `_clos(args...)`, mark `_clos` only as invoked (not escaped unless passed as arg!)
                    let mut csum = escape_summary_zero(SymbolId { v: csym_v }, 0);
                    let has_sum = escape_summary_table_lookup(summary_table, SymbolId { v: csym_v }, mut_view(csum));
                    if csym_v == 0u32 {
                        // Indirect function pointer or dynamic dispatch -> fail closed `ESC_UNKNOWN` (`AXS-ESC-004` rule 4)
                        info.summary.has_unknown_call = true;
                        let mut ai: usize = 0;
                        while ai < acnt && (args as usize) != 0 {
                            let ap = unsafe { mir_op_at(args, ai) };
                            if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*ap) }, ESC_UNKNOWN, false) {
                                changed = true;
                            }
                            ai = ai + 1;
                        }
                    } else if has_sum {
                        if csum.calls_ffi { info.summary.calls_ffi = true; }
                        if csum.spawns_escape || csum.is_spawn_fn { info.summary.spawns_escape = true; }
                        if csum.captures_into_global { info.summary.captures_into_global = true; }
                        if csum.has_unknown_call { info.summary.has_unknown_call = true; }

                        if csum.is_free_fn {
                            // `heap_free` consumes its pointer without escaping it beyond the deallocation call
                        } else if csum.is_box_new_fn {
                            // `box_new<T>(val)` moves `val` into `dest` (`Box<T>`): `val` escapes iff `dest` escapes!
                            if acnt >= 1 && (args as usize) != 0 {
                                let a0 = unsafe { mir_op_at(args, 0) };
                                if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*a0) }, dst_bits, false) {
                                    changed = true;
                                }
                                if has_dst && dst_pl.proj_count == 0 && (dst_pl.local.v as usize) < lcnt {
                                    let amask = esc_operand_param_mask(view(*info), body, unsafe { view(*a0) }, param_masks, lcnt);
                                    let dmask = unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) };
                                    if (dmask | amask) != dmask {
                                        unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) = dmask | amask; }
                                        changed = true;
                                    }
                                }
                            }
                        } else {
                            let mut clos_cap_cnt: usize = 0;
                            let mut clos_loc: u32 = ESC_NONE_IDX;
                            if (ot.func.kind == MIR_OP_COPY || ot.func.kind == MIR_OP_MOVE) &&
                               ot.func.place.proj_count == 0 && (body.thir as usize) != 0 && (body.local_tys as usize) != 0 {
                                let flv = ot.func.place.local.v as usize;
                                if flv < lcnt {
                                    let flty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, flv)).v } };
                                    let fltp = type_get(unsafe { view((*body.thir).interner) }, flty);
                                    if (fltp as usize) != 0 && (unsafe { (*fltp).kind }) == TY_CLOSURE {
                                        clos_cap_cnt = unsafe { (*fltp).capture_count };
                                        clos_loc = flv as u32;
                                    }
                                }
                            }
                            if clos_loc != ESC_NONE_IDX && clos_cap_cnt > 0 {
                                let mut ci: usize = 0;
                                while ci < clos_cap_cnt {
                                    let cpesc = escape_summary_param_escape(view(csum), ci);
                                    let mut cap_leak: u16 = cpesc & ESC_GLOBAL_MASK;
                                    let cap_aliases_ret = (ci < 32 && (csum.ret_aliases_params_mask & (1u32 << (ci as u32))) != 0u32) ||
                                                          (cpesc & ESC_RETURN) != 0u16;
                                    if cap_aliases_ret {
                                        cap_leak = cap_leak | dst_bits;
                                    }
                                    if cap_leak != 0u16 {
                                        if esc_join_ind(mut_view(*info), clos_loc, cap_leak) { changed = true; }
                                    }
                                    let mut c_obs = escape_summary_param_addr_observed(view(csum), ci);
                                    let mut c_id = escape_summary_param_identity_compared(view(csum), ci);
                                    if cap_aliases_ret {
                                        if dst_obs { c_obs = true; }
                                        if dst_id { c_id = true; }
                                    }
                                    if c_obs || c_id {
                                        if esc_mark_stable(mut_view(*info), clos_loc, c_obs, c_id) { changed = true; }
                                    }
                                    ci = ci + 1;
                                }
                            }
                            let mut ai: usize = 0;
                            while ai < acnt && (args as usize) != 0 {
                                let ap = unsafe { mir_op_at(args, ai) };
                                let pidx = clos_cap_cnt + ai;
                                let pesc = escape_summary_param_escape(view(csum), pidx);
                                let mut eff_bits: u16 = ESC_ARGUMENT | (pesc & ESC_GLOBAL_MASK);
                                let aliases_ret = (pidx < 32 && (csum.ret_aliases_params_mask & (1u32 << (pidx as u32))) != 0u32) ||
                                                  (pesc & ESC_RETURN) != 0u16;
                                let mut p_obs = escape_summary_param_addr_observed(view(csum), pidx);
                                let mut p_id = escape_summary_param_identity_compared(view(csum), pidx);
                                if aliases_ret {
                                    eff_bits = eff_bits | dst_bits;
                                    if dst_obs { p_obs = true; }
                                    if dst_id { p_id = true; }
                                    if has_dst && dst_pl.proj_count == 0 && (dst_pl.local.v as usize) < lcnt {
                                        let amask = esc_operand_param_mask(view(*info), body, unsafe { view(*ap) }, param_masks, lcnt);
                                        let dmask = unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) };
                                        if (dmask | amask) != dmask {
                                            unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) = dmask | amask; }
                                            changed = true;
                                        }
                                    }
                                }
                                if (p_obs || p_id) &&
                                   ((unsafe { (*ap).kind }) == MIR_OP_COPY || (unsafe { (*ap).kind }) == MIR_OP_MOVE) &&
                                   esc_place_projected_has_indirection(body, unsafe { view((*ap).place) }) {
                                    let alv = unsafe { (*ap).place.local.v };
                                    if esc_mark_stable(mut_view(*info), alv, p_obs, p_id) {
                                        changed = true;
                                    }
                                    if esc_place_first_deref_idx(unsafe { view((*ap).place) }) != (unsafe { (*ap).place.proj_count }) {
                                        let a_own = esc_find_pointee_owner_local(view(*info), body, alv);
                                        if a_own != ESC_NONE_IDX && esc_mark_stable(mut_view(*info), a_own, p_obs, p_id) {
                                            changed = true;
                                        }
                                    }
                                }
                                if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*ap) }, eff_bits, false) {
                                    changed = true;
                                }
                                ai = ai + 1;
                            }
                        }
                    } else {
                        // Consult `EffectCallTable` when no explicit `FunctionEscapeSummary` is registered
                        let eff_sum = effect_call_table_lookup(call_table, SymbolId { v: csym_v }, unsafe { (*bb).term.callee });
                        if (eff_sum.flags & EFFECT_FFI) != 0u16 {
                            info.summary.calls_ffi = true;
                            let mut ai: usize = 0;
                            while ai < acnt && (args as usize) != 0 {
                                let ap = unsafe { mir_op_at(args, ai) };
                                if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*ap) }, ESC_EXTERNAL, false) {
                                    changed = true;
                                }
                                ai = ai + 1;
                            }
                        } else if (eff_sum.flags & (EFFECT_UNKNOWN | EFFECT_WRITES_MEM)) == 0u16 {
                            // Proven read-only / pure callee without `FunctionEscapeSummary`: cannot store to globals/heap,
                            // though without a summary we conservatively assume pointer addresses may be observed (`AXS-ESC-004`).
                            let mut ret_has_ind = false;
                            if has_dst && (dst_pl.local.v as usize) < lcnt && (body.local_tys as usize) != 0 {
                                let dty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, dst_pl.local.v as usize)).v } };
                                ret_has_ind = esc_type_has_indirection(body.thir, dty, 0u32);
                            }
                            let call_bits: u16 = if ret_has_ind { ESC_ARGUMENT | dst_bits } else { ESC_ARGUMENT };
                            if (ot.func.kind == MIR_OP_COPY || ot.func.kind == MIR_OP_MOVE) &&
                               ot.func.place.proj_count == 0 && (body.thir as usize) != 0 && (body.local_tys as usize) != 0 {
                                let flv = ot.func.place.local.v as usize;
                                if flv < lcnt {
                                    let flty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, flv)).v } };
                                    if esc_callee_env_has_indirection(body.thir, flty) {
                                        if ret_has_ind && (dst_bits != 0u16) {
                                            if esc_join_ind(mut_view(*info), flv as u32, dst_bits) { changed = true; }
                                        }
                                        if esc_mark_stable(mut_view(*info), flv as u32, true, true) { changed = true; }
                                    }
                                }
                            }
                            let mut ai: usize = 0;
                            while ai < acnt && (args as usize) != 0 {
                                let ap = unsafe { mir_op_at(args, ai) };
                                if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*ap) }, call_bits, false) {
                                    changed = true;
                                }
                                if ((unsafe { (*ap).kind }) == MIR_OP_COPY || (unsafe { (*ap).kind }) == MIR_OP_MOVE) &&
                                   esc_place_projected_has_indirection(body, unsafe { view((*ap).place) }) {
                                    let alv = unsafe { (*ap).place.local.v };
                                    if esc_mark_stable(mut_view(*info), alv, true, true) {
                                        changed = true;
                                    }
                                    if esc_place_first_deref_idx(unsafe { view((*ap).place) }) != (unsafe { (*ap).place.proj_count }) {
                                        let a_own = esc_find_pointee_owner_local(view(*info), body, alv);
                                        if a_own != ESC_NONE_IDX && esc_mark_stable(mut_view(*info), a_own, true, true) {
                                            changed = true;
                                        }
                                    }
                                }
                                if ret_has_ind && has_dst && dst_pl.proj_count == 0 && (dst_pl.local.v as usize) < lcnt {
                                    let amask = esc_operand_param_mask(view(*info), body, unsafe { view(*ap) }, param_masks, lcnt);
                                    let dmask = unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) };
                                    if (dmask | amask) != dmask {
                                        unsafe { *esc_u32_at(param_masks, dst_pl.local.v as usize) = dmask | amask; }
                                        changed = true;
                                    }
                                }
                                ai = ai + 1;
                            }
                        } else {
                            // Unresolved / opaque side-effecting callee -> fail closed `ESC_UNKNOWN` (`REQ-OPT-045`)
                            info.summary.has_unknown_call = true;
                            if (ot.func.kind == MIR_OP_COPY || ot.func.kind == MIR_OP_MOVE) &&
                               ot.func.place.proj_count == 0 && (body.thir as usize) != 0 && (body.local_tys as usize) != 0 {
                                let flv = ot.func.place.local.v as usize;
                                if flv < lcnt {
                                    let flty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, flv)).v } };
                                    if esc_callee_env_has_indirection(body.thir, flty) {
                                        if esc_join_ind(mut_view(*info), flv as u32, ESC_UNKNOWN) { changed = true; }
                                    }
                                }
                            }
                            let mut ai: usize = 0;
                            while ai < acnt && (args as usize) != 0 {
                                let ap = unsafe { mir_op_at(args, ai) };
                                if esc_propagate_to_operand(mut_view(*info), body, unsafe { view(*ap) }, ESC_UNKNOWN, false) {
                                    changed = true;
                                }
                                ai = ai + 1;
                            }
                        }
                    }
                }
            }
            rb = rb + 1;
        }

        // Propagate escape & observability across `AllocSite` <-> pointer aliases (`_typed = _raw as *mut T`, `_box = Box { ptr }`)
        let mut si: usize = 0;
        while si < info.site_count {
            let sp = unsafe { escape_site_at(info.sites, si) };
            let rloc = unsafe { (*sp).raw_ptr_local };
            if (rloc as usize) < lcnt {
                let rlp = unsafe { escape_local_at(info.locals, rloc as usize) };
                let mut rbits = unsafe { (*rlp).val_escape | (*rlp).ind_escape };
                let mut robs = unsafe { (*rlp).address_observable };
                let mut rid = unsafe { (*rlp).identity_compared };
                let mut rdrp = unsafe { (*rlp).has_drop };
                if (unsafe { (*sp).kind }) == ALLOC_KIND_RAW_HEAP || (unsafe { (*sp).kind }) == ALLOC_KIND_BOUNDED_BUF {
                    let mut cl: usize = 0;
                    while cl < lcnt {
                        if cl != (rloc as usize) &&
                           (esc_local_is_ptr_alias_of(body, cl as u32, rloc, 0u32) ||
                            esc_box_local_wraps_raw(body, cl as u32, rloc, 0u32)) {
                            let clp = unsafe { escape_local_at(info.locals, cl) };
                            rbits = rbits | (unsafe { (*clp).val_escape | (*clp).ind_escape });
                            if unsafe { (*clp).address_observable } { robs = true; }
                            if unsafe { (*clp).identity_compared } { rid = true; }
                            if unsafe { (*clp).has_drop } { rdrp = true; }
                        }
                        cl = cl + 1;
                    }
                }
                if esc_join_ind(mut_view(*info), rloc, rbits) { changed = true; }
                if robs || rid {
                    if esc_mark_stable(mut_view(*info), rloc, robs, rid) { changed = true; }
                }
                if rdrp && !(unsafe { (*rlp).has_drop }) {
                    unsafe { (*rlp).has_drop = true; }
                    changed = true;
                }
            }
            si = si + 1;
        }
        round = round + 1;
    }

    // 3. Finalize per-local `escape_set`, `escape_class`, `no_escape_certainty`, and `FunctionEscapeSummary`
    info.summary.param_count = body.arg_count;
    info.summary.ret_aliases_params_mask = unsafe { *esc_u32_at(param_masks, 0) };
    let mut fl: usize = 0;
    while fl < lcnt {
        let lp = unsafe { escape_local_at(info.locals, fl) };
        let lty_v: u32 = if (body.local_tys as usize) != 0 {
            unsafe { (*opt_typeid_at(body.local_tys, fl)).v }
        } else {
            0u32
        };
        let has_ind = esc_type_has_indirection(body.thir, TypeId { v: lty_v }, 0u32) || (unsafe { (*lp).alloc_site_idx }) != ESC_NONE_IDX;
        let mut is_agg = false;
        if (body.thir as usize) != 0 && lty_v != 0u32 {
            let ltp = type_get(unsafe { view((*body.thir).interner) }, TypeId { v: lty_v });
            if (ltp as usize) != 0 {
                let ltk = unsafe { (*ltp).kind };
                is_agg = ltk == TY_STRUCT || ltk == TY_TUPLE || ltk == TY_ARRAY || ltk == TY_ENUM;
            }
        }
        let eset: u16 = if fl == 0 {
            unsafe { (*lp).val_escape | (*lp).ind_escape }
        } else if has_ind {
            unsafe { (*lp).val_escape | (*lp).ind_escape }
        } else if fl > body.arg_count && is_agg && ((unsafe { (*lp).val_escape }) & ESC_RETURN) != 0u16 {
            unsafe { (*lp).ind_escape | ESC_RETURN }
        } else {
            unsafe { (*lp).ind_escape }
        };
        unsafe {
            (*lp).escape_set = eset;
            (*lp).escape_class = escape_class_from_set(eset);
            (*lp).no_escape_certainty = escape_no_escape_certainty(eset);
        }
        if fl >= 1 && fl <= body.arg_count {
            escape_summary_set_param_escape(mut_view(info.summary), mut_view(*arena), fl - 1, eset);
            escape_summary_set_param_observability(
                mut_view(info.summary),
                mut_view(*arena),
                fl - 1,
                unsafe { (*lp).address_observable },
                unsafe { (*lp).identity_compared }
            );
        }
        fl = fl + 1;
    }

    let mut fsi: usize = 0;
    while fsi < info.site_count {
        let sp = unsafe { escape_site_at(info.sites, fsi) };
        let dl = unsafe { (*sp).dest_local } as usize;
        if dl < lcnt {
            let dlp = unsafe { escape_local_at(info.locals, dl) };
            let se = unsafe { (*dlp).escape_set };
            unsafe {
                (*sp).escape_set = se;
                (*sp).escape_class = escape_class_from_set(se);
            }
            if (se & ESC_RETURN) != 0u16 {
                info.summary.returns_fresh_alloc = true;
            }
        }
        fsi = fsi + 1;
    }
}


// --- Mandatory 8-Step `PhysicalStorage` Decision Hierarchy (`SPEC-71 AXS-ESC-010`, `REQ-OPT-044`, `REQ-OPT-046`) ---

pub fn escape_select_storage(
    lp: view<LocalEscapeState>,
    is_alloc_site: bool,
    alloc_kind: u8,
    has_matching_free: bool,
    is_static_const: bool,
    is_aggregate: bool,
    cur_fn_promoted_bytes: u64,
    reused_bytes: u64,
    out_reason: mut_view<u8>
) -> u8 {
    // Step 1: Fixed hardware / MMIO, static/const global, zero-copy/DMA pin, volatile/atomic/zeroize barriers
    if lp.is_fixed_mmio {
        *out_reason = REASON_FIXED_MMIO;
        return STORAGE_DECISION_FIXED_MMIO;
    }
    if is_static_const {
        *out_reason = REASON_STATIC_CONST;
        return STORAGE_DECISION_STATIC_TLS;
    }
    if lp.is_zero_copy_pinned {
        *out_reason = REASON_ZERO_COPY_PINNED;
        return STORAGE_DECISION_DEVICE_EXTERNAL;
    }
    if lp.is_volatile_atomic {
        *out_reason = REASON_VOLATILE_ATOMIC;
        return if is_alloc_site { STORAGE_DECISION_HEAP } else { STORAGE_DECISION_LOCAL_STACK };
    }

    // Step 2: Address observability (`address_of` + `PtrToInt` or pointer identity `p == q`)
    if lp.identity_compared {
        *out_reason = REASON_IDENTITY_COMPARED;
        return if is_alloc_site { STORAGE_DECISION_HEAP } else { STORAGE_DECISION_LOCAL_STACK };
    }
    if lp.address_observable {
        *out_reason = REASON_ADDR_OBSERVABLE;
        return if is_alloc_site { STORAGE_DECISION_HEAP } else { STORAGE_DECISION_LOCAL_STACK };
    }

    // Step 3: `GlobalEscape` (`ESC_HEAP | ESC_THREAD | ESC_EXTERNAL | ESC_UNKNOWN`)
    if lp.escape_class == ESCAPE_GLOBAL_ESCAPE {
        if (lp.escape_set & ESC_THREAD) != 0u16 {
            *out_reason = REASON_THREAD_ESCAPE;
        } else if (lp.escape_set & ESC_EXTERNAL) != 0u16 {
            *out_reason = REASON_FFI_EXTERNAL_ESCAPE;
        } else if (lp.escape_set & ESC_UNKNOWN) != 0u16 {
            *out_reason = REASON_UNKNOWN_CALL_ESCAPE;
        } else {
            *out_reason = REASON_GLOBAL_HEAP_ESCAPE;
        }
        return STORAGE_DECISION_HEAP;
    }

    // Step 4: `ReturnEscape` (`ESC_RETURN`)
    if lp.escape_class == ESCAPE_RETURN_ESCAPE {
        if lp.has_active_view_escape {
            *out_reason = REASON_ACTIVE_VIEW_ESCAPE;
            return STORAGE_DECISION_HEAP;
        }
        if is_alloc_site {
            *out_reason = REASON_RETURN_HEAP_ESCAPE;
            return STORAGE_DECISION_HEAP;
        }
        if is_aggregate && lp.known_size && lp.size_bytes > 0u64 {
            *out_reason = REASON_NRVO_RET_SLOT;
            return STORAGE_DECISION_CALLER_RET_SLOT;
        }
        *out_reason = REASON_RETURN_REGISTER;
        return STORAGE_DECISION_SSA_REGISTER;
    }

    // Step 5: Dynamic unbounded growth (`realloc` / `vec_reserve`), unknown size, or unbalanced raw `heap_alloc`
    if is_alloc_site {
        // Step 5/6: Loop-carried lifetime (`AXS-ESC-004` rule 6, `AXS-ESC-010` step 6), dynamic realloc, or unbalanced raw `heap_alloc`
        if lp.crosses_loop_backedge {
            *out_reason = REASON_LOOP_CARRIED;
            return STORAGE_DECISION_HEAP;
        }
        if lp.has_dynamic_realloc {
            *out_reason = REASON_DYNAMIC_REALLOC;
            return STORAGE_DECISION_HEAP;
        }
        if !lp.known_size {
            *out_reason = REASON_DYNAMIC_REALLOC;
            return STORAGE_DECISION_HEAP;
        }
        if (alloc_kind == ALLOC_KIND_RAW_HEAP || alloc_kind == ALLOC_KIND_BOUNDED_BUF ||
            alloc_kind == ALLOC_KIND_BOX_NEW || alloc_kind == ALLOC_KIND_VEC_WITH_CAP) && !has_matching_free {
            *out_reason = REASON_UNBALANCED_FREE;
            return STORAGE_DECISION_HEAP;
        }

        // Step 7: Stack frame promotion budget (`4096 B` per site, `16384 B` cumulative per function)
        if lp.size_bytes > MAX_STACK_PROMOTE_BYTES {
            *out_reason = REASON_BUDGET_EXCEEDED;
            return STORAGE_DECISION_HEAP;
        }
        let eff_used: u64 = if cur_fn_promoted_bytes > reused_bytes {
            cur_fn_promoted_bytes - reused_bytes
        } else {
            0u64
        };
        if eff_used + lp.size_bytes > MAX_FN_PROMOTED_STACK_BYTES {
            *out_reason = REASON_BUDGET_EXCEEDED;
            return STORAGE_DECISION_HEAP;
        }
    }

    // Step 8: Legal promotion (`NoEscape` or `ArgumentEscape` within bounds & lifetime!)
    if lp.is_repr_c_abi {
        *out_reason = REASON_ABI_REPR_C_STACK;
        return STORAGE_DECISION_LOCAL_STACK;
    }

    if is_alloc_site {
        if alloc_kind == ALLOC_KIND_CLOSURE_ENV {
            if lp.escape_class == ESCAPE_NO_ESCAPE && !lp.stable_address && !lp.has_drop {
                *out_reason = REASON_NO_ESCAPE_ELIMINATED;
                return STORAGE_DECISION_ELIMINATED;
            }
            *out_reason = if lp.escape_class == ESCAPE_NO_ESCAPE { REASON_NO_ESCAPE_STACK } else { REASON_ARG_ESCAPE_STACK };
            return STORAGE_DECISION_LOCAL_STACK;
        }
        if alloc_kind == ALLOC_KIND_BOUNDED_BUF || alloc_kind == ALLOC_KIND_VEC_WITH_CAP {
            *out_reason = REASON_INLINE_BUFFER;
            return STORAGE_DECISION_INLINE_BUFFER;
        }
        if lp.escape_class == ESCAPE_NO_ESCAPE && lp.no_escape_certainty == CERTAINTY_PROVEN &&
           !lp.stable_address && (!lp.has_drop || alloc_kind == ALLOC_KIND_BOX_NEW) && lp.size_bytes <= 64u64 {
            *out_reason = REASON_NO_ESCAPE_SROA;
            return STORAGE_DECISION_SSA_REGISTER;
        }
        *out_reason = if lp.escape_class == ESCAPE_NO_ESCAPE { REASON_NO_ESCAPE_STACK } else { REASON_ARG_ESCAPE_STACK };
        return STORAGE_DECISION_LOCAL_STACK;
    }

    if lp.escape_class == ESCAPE_NO_ESCAPE && !lp.stable_address && !lp.borrow_taken && !lp.has_drop &&
       lp.known_size && lp.size_bytes <= 64u64 {
        *out_reason = REASON_NO_ESCAPE_SROA;
        return STORAGE_DECISION_SSA_REGISTER;
    }
    *out_reason = if lp.escape_class == ESCAPE_NO_ESCAPE { REASON_NO_ESCAPE_STACK } else { REASON_ARG_ESCAPE_STACK };
    STORAGE_DECISION_LOCAL_STACK
}

fn esc_assign_storage_decisions(info: mut_view<EscapeInfo>, body: view<OptBody>, alias_info: view<AliasInfo>) {
    info.promoted_stack_bytes = 0u64;
    // 1. Decide storage for every discovered `AllocSite` first (updating cumulative promoted stack budget)
    let mut si: usize = 0;
    while si < info.site_count {
        let sp = unsafe { escape_site_at(info.sites, si) };
        let dl = unsafe { (*sp).dest_local } as usize;
        if dl < info.local_count {
            let lp = unsafe { escape_local_at(info.locals, dl) };
            let mut rsn = REASON_NONE;
            let sdec = escape_select_storage(
                unsafe { view(*lp) },
                true,
                unsafe { (*sp).kind },
                unsafe { (*sp).has_matching_free },
                false,
                false,
                info.promoted_stack_bytes,
                info.reused_stack_bytes,
                mut_view(rsn)
            );
            unsafe {
                (*sp).storage_decision = sdec;
                (*sp).reason = rsn;
                (*lp).storage_decision = sdec;
                (*lp).reason = rsn;
            }
            if sdec == STORAGE_DECISION_LOCAL_STACK || sdec == STORAGE_DECISION_INLINE_BUFFER {
                info.promoted_stack_bytes = info.promoted_stack_bytes + (unsafe { (*sp).size_bytes });
            }
        }
        si = si + 1;
    }

    // 2. Decide storage for all remaining non-site locals
    let mut l: usize = 0;
    while l < info.local_count {
        let lp = unsafe { escape_local_at(info.locals, l) };
        if (unsafe { (*lp).alloc_site_idx }) == ESC_NONE_IDX {
            let mut is_static = false;
            if l < alias_info.local_count && (alias_info.locals as usize) != 0 {
                let alp = unsafe { alias_local_prov_at(alias_info.locals, l) };
                let adom = unsafe { (*alp).domain };
                if adom == DOMAIN_CONST_RDATA || adom == DOMAIN_GLOBAL_STATIC {
                    is_static = true;
                }
            }
            let mut is_agg = false;
            if (body.thir as usize) != 0 && (body.local_tys as usize) != 0 {
                let lty = TypeId { v: unsafe { (*opt_typeid_at(body.local_tys, l)).v } };
                let tp = type_get(unsafe { view((*body.thir).interner) }, lty);
                if (tp as usize) != 0 {
                    let tk = unsafe { (*tp).kind };
                    is_agg = tk == TY_STRUCT || tk == TY_TUPLE || tk == TY_ARRAY || tk == TY_ENUM;
                }
            }
            let mut rsn = REASON_NONE;
            let sdec = escape_select_storage(
                unsafe { view(*lp) },
                false,
                0u8,
                true,
                is_static,
                is_agg,
                info.promoted_stack_bytes,
                info.reused_stack_bytes,
                mut_view(rsn)
            );
            unsafe {
                (*lp).storage_decision = sdec;
                (*lp).reason = rsn;
            }
        }
        l = l + 1;
    }
}

// --- Public `EscapeInfo` Construction, Queries & Call-Graph Summary Solver ---

pub fn escape_init_info(
    info: mut_view<EscapeInfo>,
    body: view<OptBody>,
    alias_info: view<AliasInfo>,
    call_table: *const EffectCallTable,
    summary_table: *const EscapeSummaryTable,
    arena: mut_view<Arena>
) {
    let lcnt = body.local_count;
    info.fn_sym = SymbolId { v: body.fn_sym.v };
    info.local_count = lcnt;
    info.sites = 0 as *mut AllocSite;
    info.site_count = 0;
    info.site_cap = 0;
    info.disjoint_pairs = 0 as *mut DisjointSlotPair;
    info.disjoint_pair_count = 0;
    info.disjoint_pair_cap = 0;
    info.promoted_stack_bytes = 0u64;
    info.reused_stack_bytes = 0u64;
    info.summary = escape_summary_zero(body.fn_sym, body.arg_count);

    if lcnt == 0 {
        info.locals = 0 as *mut LocalEscapeState;
        return;
    }
    let locs = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(lcnt, size_of<LocalEscapeState>()),
        align_of<LocalEscapeState>()
    ) as *mut LocalEscapeState;
    info.locals = locs;

    let mut l: usize = 0;
    while l < lcnt {
        let lty_v: u32 = if (body.local_tys as usize) != 0 {
            unsafe { (*opt_typeid_at(body.local_tys, l)).v }
        } else {
            0u32
        };
        let mut sz_ok = false;
        let mut sz_al: u64 = 1u64;
        let sz_b = escape_type_byte_size(body.thir, TypeId { v: lty_v }, mut_view(sz_ok), mut_view(sz_al));
        let repr_c = esc_type_is_repr_c(body.thir, TypeId { v: lty_v });
        let lp = unsafe { escape_local_at(locs, l) };
        unsafe {
            *lp = LocalEscapeState {
                local_id: l as u32,
                val_escape: ESC_NONE,
                ind_escape: ESC_NONE,
                escape_set: ESC_NONE,
                escape_class: ESCAPE_NO_ESCAPE,
                no_escape_certainty: CERTAINTY_PROVEN,
                storage_decision: STORAGE_DECISION_LOCAL_STACK,
                reason: REASON_NONE,
                stable_address: false,
                address_observable: false,
                identity_compared: false,
                is_fixed_mmio: false,
                is_volatile_atomic: false,
                is_zero_copy_pinned: false,
                has_active_view_escape: false,
                crosses_loop_backedge: false,
                has_dynamic_realloc: false,
                has_drop: false,
                is_repr_c_abi: repr_c,
                borrow_taken: false,
                mut_borrow_taken: false,
                known_size: sz_ok,
                size_bytes: sz_b,
                align_bytes: sz_al,
                alloc_site_idx: ESC_NONE_IDX,
                reuse_partner_local: ESC_NONE_IDX,
            };
        }
        l = l + 1;
    }

    let bcnt: usize = if body.bb_count == 0 { 1 } else { body.bb_count };
    let fset = arena_alloc_raw(mut_view(*arena), esc_mul_usize(bcnt, size_of<bool>()), align_of<bool>()) as *mut bool;
    let vis = arena_alloc_raw(mut_view(*arena), esc_mul_usize(bcnt, size_of<bool>()), align_of<bool>()) as *mut bool;
    let qbuf = arena_alloc_raw(mut_view(*arena), esc_mul_usize(bcnt, size_of<u32>()), align_of<u32>()) as *mut u32;

    esc_discover_alloc_sites(mut_view(*info), body, summary_table, fset, vis, qbuf, mut_view(*arena));
    esc_run_escape_dataflow(mut_view(*info), body, alias_info, call_table, summary_table, mut_view(*arena));
    esc_compute_disjoint_slot_pairs(mut_view(*info), body, mut_view(*arena));
    esc_assign_storage_decisions(mut_view(*info), body, alias_info);
}

pub fn escape_build_info(
    body: view<OptBody>,
    call_table: *const EffectCallTable,
    summary_table: *const EscapeSummaryTable,
    arena: mut_view<Arena>
) -> *mut EscapeInfo {
    let al_ptr = alias_build_info(body, call_table, mut_view(*arena));
    let info_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeInfo>(), align_of<EscapeInfo>()) as *mut EscapeInfo;
    escape_init_info(
        unsafe { mut_view(*info_ptr) },
        body,
        unsafe { view(*al_ptr) },
        call_table,
        summary_table,
        mut_view(*arena)
    );
    info_ptr
}

pub fn escape_query_local_class(info: view<EscapeInfo>, loc_v: u32) -> u8 {
    if (loc_v as usize) >= info.local_count || (info.locals as usize) == 0 {
        return ESCAPE_GLOBAL_ESCAPE;
    }
    unsafe { (*escape_local_at(info.locals, loc_v as usize)).escape_class }
}

pub fn escape_query_local_set(info: view<EscapeInfo>, loc_v: u32) -> u16 {
    if (loc_v as usize) >= info.local_count || (info.locals as usize) == 0 {
        return ESC_UNKNOWN;
    }
    unsafe { (*escape_local_at(info.locals, loc_v as usize)).escape_set }
}

pub fn escape_query_local_storage(info: view<EscapeInfo>, loc_v: u32) -> u8 {
    if (loc_v as usize) >= info.local_count || (info.locals as usize) == 0 {
        return STORAGE_DECISION_HEAP;
    }
    unsafe { (*escape_local_at(info.locals, loc_v as usize)).storage_decision }
}

pub fn escape_is_no_escape_proven(info: view<EscapeInfo>, loc_v: u32) -> bool {
    if (loc_v as usize) >= info.local_count || (info.locals as usize) == 0 {
        return false;
    }
    let lp = unsafe { escape_local_at(info.locals, loc_v as usize) };
    (unsafe { (*lp).escape_class }) == ESCAPE_NO_ESCAPE &&
    (unsafe { (*lp).no_escape_certainty }) == CERTAINTY_PROVEN
}

pub fn escape_is_stack_promotable(info: view<EscapeInfo>, loc_v: u32) -> bool {
    if (loc_v as usize) >= info.local_count || (info.locals as usize) == 0 {
        return false;
    }
    let sdec = unsafe { (*escape_local_at(info.locals, loc_v as usize)).storage_decision };
    sdec == STORAGE_DECISION_ELIMINATED ||
    sdec == STORAGE_DECISION_SSA_REGISTER ||
    sdec == STORAGE_DECISION_LOCAL_STACK ||
    sdec == STORAGE_DECISION_INLINE_BUFFER ||
    sdec == STORAGE_DECISION_CALLER_RET_SLOT
}

// Multi-body interprocedural call-graph summary solver (`SPEC-71 AXS-ESC-003.3`, `REQ-OPT-043`, `REQ-OPT-357`):
// Solves recursive SCCs from bottom (`NoEscape`) via monotone join until fixed-point convergence.
pub fn escape_solve_call_graph_summaries(
    mir_bodies: *mut *mut MirBody,
    body_count: usize,
    thir: *const Thir,
    call_table: *const EffectCallTable,
    summary_table: mut_view<EscapeSummaryTable>,
    arena: mut_view<Arena>
) -> u32 {
    if body_count == 0 || (mir_bodies as usize) == 0 {
        return 0u32;
    }
    let opt_ptrs = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(body_count, size_of<*mut OptBody>()),
        align_of<*mut OptBody>()
    ) as *mut *mut OptBody;
    let is_special = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(body_count, size_of<bool>()),
        align_of<bool>()
    ) as *mut bool;
    let tab_snap = arena_alloc_raw(
        mut_view(*arena),
        size_of<EscapeSummaryTable>(),
        align_of<EscapeSummaryTable>()
    ) as *mut EscapeSummaryTable;

    let mut bi: usize = 0;
    while bi < body_count {
        let mb = unsafe { *esc_mir_body_ptr_at(mir_bodies, bi) };
        let mut ob_ptr: *mut OptBody = 0 as *mut OptBody;
        let mut spec = false;
        if (mb as usize) != 0 {
            let fn_sym_v = unsafe { (*mb).fn_sym.v };
            let mut existing = escape_summary_zero(SymbolId { v: fn_sym_v }, 0);
            unsafe {
                (*tab_snap).entries = summary_table.entries;
                (*tab_snap).count = summary_table.count;
                (*tab_snap).cap = summary_table.cap;
            }
            if escape_summary_table_lookup(tab_snap as *const EscapeSummaryTable, (SymbolId { v: fn_sym_v }), mut_view(existing)) {
                if existing.is_alloc_fn || existing.is_free_fn || existing.is_realloc_fn ||
                   existing.is_box_new_fn || existing.is_box_into_raw_fn ||
                   existing.is_vec_with_cap_fn || existing.is_spawn_fn || existing.calls_ffi {
                    spec = true;
                }
            } else if fn_sym_v != 0u32 {
                let bot = escape_summary_zero(SymbolId { v: fn_sym_v }, unsafe { (*mb).arg_count });
                escape_summary_table_register(mut_view(*summary_table), mut_view(*arena), SymbolId { v: fn_sym_v }, bot);
            }
            if !spec {
                ob_ptr = optir_build_from_verified_mir(unsafe { view(*mb) }, thir, mut_view(*arena));
            }
        }
        let slot_off = esc_mul_usize(bi, size_of<*mut OptBody>());
        let slot_p = ((opt_ptrs as usize) + slot_off) as *mut *mut OptBody;
        unsafe {
            *slot_p = ob_ptr;
            *esc_bool_at(is_special, bi) = spec;
        }
        bi = bi + 1;
    }

    let max_rounds: u32 = if (body_count as u32) + 8u32 < 24u32 { 24u32 } else { (body_count as u32) * 4u32 + 8u32 };
    let mut rounds: u32 = 0u32;
    let mut changed = true;
    while changed && rounds < max_rounds {
        changed = false;
        let mut k: usize = 0;
        while k < body_count {
            if !(unsafe { *esc_bool_at(is_special, k) }) {
                let slot_off = esc_mul_usize(k, size_of<*mut OptBody>());
                let ob = unsafe { *(((opt_ptrs as usize) + slot_off) as *mut *mut OptBody) };
                if (ob as usize) != 0 {
                    let fn_sym_v2 = unsafe { (*ob).fn_sym.v };
                    if fn_sym_v2 != 0u32 {
                        unsafe {
                            (*tab_snap).entries = summary_table.entries;
                            (*tab_snap).count = summary_table.count;
                            (*tab_snap).cap = summary_table.cap;
                        }
                        let einfo = escape_build_info(
                            unsafe { view(*ob) },
                            call_table,
                            tab_snap as *const EscapeSummaryTable,
                            mut_view(*arena)
                        );
                        let mut cur = escape_summary_zero(SymbolId { v: fn_sym_v2 }, unsafe { (*ob).arg_count });
                        let _had = escape_summary_table_lookup(tab_snap as *const EscapeSummaryTable, SymbolId { v: fn_sym_v2 }, mut_view(cur));
                        if escape_summary_join(mut_view(cur), unsafe { view((*einfo).summary) }, mut_view(*arena)) {
                            escape_summary_table_register(mut_view(*summary_table), mut_view(*arena), SymbolId { v: fn_sym_v2 }, cur);
                            changed = true;
                        }
                    }
                }
            }
            k = k + 1;
        }
        rounds = rounds + 1u32;
    }
    rounds
}


// --- Concrete IR Allocation Promotion Rewrites on `MirBody` (`SPEC-71 §§3.2-3.5`, `AXS-ESC-011..015`) ---

fn esc_strip_leading_deref(src: view<MirPlace>, new_local: u32, arena: mut_view<Arena>) -> MirPlace {
    let mut out = mir_local_place(new_local);
    if src.proj_count <= 1 || (src.projs as usize) == 0 {
        return out;
    }
    let rem = src.proj_count - 1;
    let buf = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(rem, size_of<MirProjection>()),
        align_of<MirProjection>()
    ) as *mut MirProjection;
    let mut i: usize = 0;
    while i < rem {
        let sp = unsafe { mir_proj_at(src.projs, i + 1) };
        let dp = unsafe { mir_proj_at(buf, i) };
        mir_copy_proj(unsafe { mut_view(*dp) }, unsafe { view(*sp) });
        i = i + 1;
    }
    out.projs = buf;
    out.proj_count = rem;
    out
}

fn esc_mir_remove_stmt_at(bb: mut_view<MirBb>, idx: usize) {
    if idx >= bb.stmt_count || (bb.stmts as usize) == 0 {
        return;
    }
    let mut k: usize = idx;
    while k + 1 < bb.stmt_count {
        let dst = unsafe { mir_stmt_at(bb.stmts, k) };
        let src = unsafe { mir_stmt_at(bb.stmts, k + 1) };
        mir_copy_stmt(unsafe { mut_view(*dst) }, unsafe { view(*src) });
        k = k + 1;
    }
    bb.stmt_count = bb.stmt_count - 1;
}

fn esc_place_proj_uses_local(pl: view<MirPlace>, loc_v: u32) -> bool {
    let mut p: usize = 0;
    while p < pl.proj_count && (pl.projs as usize) != 0 {
        let pr = unsafe { mir_proj_at(pl.projs, p) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX && (unsafe { (*pr).index_local.v }) == loc_v {
            return true;
        }
        if pk == MIR_PROJ_SUB_SLICE {
            if (unsafe { (*pr).has_from }) && (unsafe { (*pr).from_local.v }) == loc_v {
                return true;
            }
            if (unsafe { (*pr).has_to }) && (unsafe { (*pr).to_local.v }) == loc_v {
                return true;
            }
        }
        p = p + 1;
    }
    false
}

fn esc_place_only_derefs_ptr(pl: view<MirPlace>, ptr_loc: u32) -> bool {
    if esc_place_proj_uses_local(pl, ptr_loc) {
        return false;
    }
    if pl.local.v != ptr_loc {
        return true;
    }
    pl.proj_count >= 1 && (pl.projs as usize) != 0 &&
        (unsafe { (*mir_proj_at(pl.projs, 0)).kind }) == MIR_PROJ_DEREF
}

fn esc_ptr_temp_only_derefed(mir: view<MirBody>, opt_body: view<OptBody>, ptr_loc: u32) -> bool {
    let mut b: usize = 0;
    while b < mir.bb_count && (mir.bbs as usize) != 0 {
        let bb = unsafe { mir_bb_at(mir.bbs, b) };
        let mut s: usize = 0;
        while s < (unsafe { (*bb).stmt_count }) {
            let st = unsafe { mir_stmt_at((*bb).stmts, s) };
            let sk = unsafe { (*st).kind };
            if sk == MIR_STMT_ASSIGN {
                let dst = unsafe { view((*st).place) };
                let rv = unsafe { view((*st).rvalue) };
                if esc_place_proj_uses_local(dst, ptr_loc) {
                    return false;
                }
                if dst.local.v == ptr_loc {
                    if dst.proj_count == 0 {
                        // Single definition `_ptr = _box.0` handled by caller
                    } else if !esc_place_only_derefs_ptr(dst, ptr_loc) {
                        return false;
                    }
                }
                if rv.kind == MIR_RVALUE_REF {
                    if !esc_place_only_derefs_ptr(view(rv.place), ptr_loc) {
                        return false;
                    }
                } else if rv.kind == MIR_RVALUE_CAST && rv.cast_kind == MIR_CAST_PTR_TO_INT &&
                          (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                          rv.use_op.place.local.v == ptr_loc && rv.use_op.place.proj_count == 0 {
                    if dst.proj_count != 0 || !esc_local_is_only_null_checked(opt_body, dst.local.v) {
                        return false;
                    }
                } else {
                    if esc_rvalue_has_use_op(rv.kind) &&
                       (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                       !esc_place_only_derefs_ptr(view(rv.use_op.place), ptr_loc) {
                        return false;
                    }
                    if esc_rvalue_has_bin_ops(rv.kind) {
                        if (rv.lhs.kind == MIR_OP_COPY || rv.lhs.kind == MIR_OP_MOVE) &&
                           !esc_place_only_derefs_ptr(view(rv.lhs.place), ptr_loc) {
                            return false;
                        }
                        if (rv.rhs.kind == MIR_OP_COPY || rv.rhs.kind == MIR_OP_MOVE) &&
                           !esc_place_only_derefs_ptr(view(rv.rhs.place), ptr_loc) {
                            return false;
                        }
                    }
                    if (rv.kind == MIR_RVALUE_LEN || rv.kind == MIR_RVALUE_DISCRIMINANT) &&
                       !esc_place_only_derefs_ptr(view(rv.place), ptr_loc) {
                        return false;
                    }
                    if rv.kind == MIR_RVALUE_AGGREGATE {
                        let mut ao: usize = 0;
                        while ao < rv.operand_count && (rv.operands as usize) != 0 {
                            let op_p = unsafe { mir_op_at(rv.operands, ao) };
                            if ((unsafe { (*op_p).kind }) == MIR_OP_COPY || (unsafe { (*op_p).kind }) == MIR_OP_MOVE) &&
                               !esc_place_only_derefs_ptr(unsafe { view((*op_p).place) }, ptr_loc) {
                                return false;
                            }
                            ao = ao + 1;
                        }
                    }
                }
            } else if sk == MIR_STMT_DROP && esc_place_uses_local(unsafe { view((*st).place) }, ptr_loc) {
                return false;
            }
            s = s + 1;
        }
        let tm = unsafe { view((*bb).terminator) };
        if tm.kind == MIR_TERM_DROP && esc_place_uses_local(view(tm.drop_place), ptr_loc) {
            return false;
        }
        if tm.kind == MIR_TERM_SWITCH_INT && esc_operand_uses_local(view(tm.discr), ptr_loc) {
            return false;
        }
        if tm.kind == MIR_TERM_ASSERT && esc_operand_uses_local(view(tm.cond), ptr_loc) {
            return false;
        }
        if tm.kind == MIR_TERM_CALL {
            if tm.has_destination && esc_place_uses_local(view(tm.destination), ptr_loc) {
                return false;
            }
            if esc_operand_uses_local(view(tm.func), ptr_loc) {
                return false;
            }
            let mut ai: usize = 0;
            while ai < tm.arg_count && (tm.args as usize) != 0 {
                let ap = unsafe { mir_op_at(tm.args, ai) };
                if ((unsafe { (*ap).kind }) == MIR_OP_COPY || (unsafe { (*ap).kind }) == MIR_OP_MOVE) &&
                   !esc_place_only_derefs_ptr(unsafe { view((*ap).place) }, ptr_loc) {
                    return false;
                }
                ai = ai + 1;
            }
        }
        b = b + 1;
    }
    true
}

fn esc_can_sroa_box_new(mir: view<MirBody>, opt_body: view<OptBody>, box_loc: u32, alloc_bb: u32) -> bool {
    let mut b: usize = 0;
    while b < mir.bb_count && (mir.bbs as usize) != 0 {
        let bb = unsafe { mir_bb_at(mir.bbs, b) };
        let mut s: usize = 0;
        while s < (unsafe { (*bb).stmt_count }) {
            let st = unsafe { mir_stmt_at((*bb).stmts, s) };
            let sk = unsafe { (*st).kind };
            if sk == MIR_STMT_ASSIGN {
                let dst = unsafe { view((*st).place) };
                let rv = unsafe { view((*st).rvalue) };
                if dst.local.v == box_loc {
                    return false;
                }
                // Only legal read of `box_loc` for pure SROA is `_ptr_tmp = copy/move box_loc.0` where `_ptr_tmp` is single-def and only dereferenced
                if rv.kind == MIR_RVALUE_USE && (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                   rv.use_op.place.local.v == box_loc {
                    if dst.proj_count != 0 || rv.use_op.place.proj_count != 1 || (rv.use_op.place.projs as usize) == 0 {
                        return false;
                    }
                    let pr0 = unsafe { mir_proj_at(rv.use_op.place.projs, 0) };
                    if (unsafe { (*pr0).kind }) != MIR_PROJ_FIELD || (unsafe { (*pr0).field_idx }) != 0u32 {
                        return false;
                    }
                    let ptr_tmp = dst.local.v;
                    if alias_count_local_defs(opt_body, ptr_tmp) != 1u32 || !esc_ptr_temp_only_derefed(mir, opt_body, ptr_tmp) {
                        return false;
                    }
                } else {
                    if esc_rvalue_uses_local(rv, box_loc) {
                        return false;
                    }
                }
            } else if sk == MIR_STMT_DROP {
                if (unsafe { (*st).place.local.v }) == box_loc && (unsafe { (*st).place.proj_count }) != 0 {
                    return false;
                }
            }
            s = s + 1;
        }
        let tm = unsafe { view((*bb).terminator) };
        if tm.kind == MIR_TERM_DROP && tm.drop_place.local.v == box_loc && tm.drop_place.proj_count != 0 {
            return false;
        }
        if tm.kind == MIR_TERM_CALL {
            if (b as u32) != alloc_bb {
                if tm.has_destination && tm.destination.local.v == box_loc {
                    return false;
                }
                if esc_operand_uses_local(view(tm.func), box_loc) {
                    return false;
                }
                let mut ai: usize = 0;
                while ai < tm.arg_count && (tm.args as usize) != 0 {
                    let ap = unsafe { mir_op_at(tm.args, ai) };
                    if esc_operand_uses_local(unsafe { view(*ap) }, box_loc) {
                        return false;
                    }
                    ai = ai + 1;
                }
            }
        }
        b = b + 1;
    }
    true
}

fn esc_rewrite_deref_of_ptr_to_slot(mir: mut_view<MirBody>, ptr_loc: u32, slot_loc: u32, arena: mut_view<Arena>) {
    let mut b: usize = 0;
    while b < mir.bb_count && (mir.bbs as usize) != 0 {
        let bb = unsafe { mir_bb_at(mir.bbs, b) };
        let mut s: usize = 0;
        while s < (unsafe { (*bb).stmt_count }) {
            let st = unsafe { mir_stmt_at((*bb).stmts, s) };
            if (unsafe { (*st).kind }) == MIR_STMT_ASSIGN {
                if (unsafe { (*st).place.local.v }) == ptr_loc && (unsafe { (*st).place.proj_count }) >= 1 {
                    let np = esc_strip_leading_deref(unsafe { view((*st).place) }, slot_loc, mut_view(*arena));
                    unsafe { (*st).place = np; }
                }
                let rvk = unsafe { (*st).rvalue.kind };
                if rvk == MIR_RVALUE_REF && (unsafe { (*st).rvalue.place.local.v }) == ptr_loc &&
                   (unsafe { (*st).rvalue.place.proj_count }) >= 1 {
                    let np = esc_strip_leading_deref(unsafe { view((*st).rvalue.place) }, slot_loc, mut_view(*arena));
                    unsafe { (*st).rvalue.place = np; }
                } else if rvk == MIR_RVALUE_CAST && (unsafe { (*st).rvalue.cast_kind }) == MIR_CAST_PTR_TO_INT &&
                          ((unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_MOVE) &&
                          (unsafe { (*st).rvalue.use_op.place.local.v }) == ptr_loc &&
                          (unsafe { (*st).rvalue.use_op.place.proj_count }) == 0 {
                    let dst_lv = unsafe { (*st).place.local.v } as usize;
                    let dst_ty_v: u32 = if dst_lv < mir.local_count {
                        unsafe { (*mir_local_at(mir.locals, dst_lv)).ty.v }
                    } else {
                        0u32
                    };
                    mir_rvalue_reset(unsafe { mut_view((*st).rvalue) }, MIR_RVALUE_USE);
                    unsafe { (*st).rvalue.use_op = mir_op_const_int(dst_ty_v, 1u64); }
                } else {
                    if esc_rvalue_has_use_op(rvk) &&
                       ((unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_MOVE) &&
                       (unsafe { (*st).rvalue.use_op.place.local.v }) == ptr_loc &&
                       (unsafe { (*st).rvalue.use_op.place.proj_count }) >= 1 {
                        let np = esc_strip_leading_deref(unsafe { view((*st).rvalue.use_op.place) }, slot_loc, mut_view(*arena));
                        unsafe { (*st).rvalue.use_op.place = np; }
                    }
                    if esc_rvalue_has_bin_ops(rvk) {
                        if ((unsafe { (*st).rvalue.lhs.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.lhs.kind }) == MIR_OP_MOVE) &&
                           (unsafe { (*st).rvalue.lhs.place.local.v }) == ptr_loc &&
                           (unsafe { (*st).rvalue.lhs.place.proj_count }) >= 1 {
                            let np = esc_strip_leading_deref(unsafe { view((*st).rvalue.lhs.place) }, slot_loc, mut_view(*arena));
                            unsafe { (*st).rvalue.lhs.place = np; }
                        }
                        if ((unsafe { (*st).rvalue.rhs.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.rhs.kind }) == MIR_OP_MOVE) &&
                           (unsafe { (*st).rvalue.rhs.place.local.v }) == ptr_loc &&
                           (unsafe { (*st).rvalue.rhs.place.proj_count }) >= 1 {
                            let np = esc_strip_leading_deref(unsafe { view((*st).rvalue.rhs.place) }, slot_loc, mut_view(*arena));
                            unsafe { (*st).rvalue.rhs.place = np; }
                        }
                    }
                    if (rvk == MIR_RVALUE_LEN || rvk == MIR_RVALUE_DISCRIMINANT) &&
                       (unsafe { (*st).rvalue.place.local.v }) == ptr_loc &&
                       (unsafe { (*st).rvalue.place.proj_count }) >= 1 {
                        let np = esc_strip_leading_deref(unsafe { view((*st).rvalue.place) }, slot_loc, mut_view(*arena));
                        unsafe { (*st).rvalue.place = np; }
                    }
                    if rvk == MIR_RVALUE_AGGREGATE {
                        let mut ao: usize = 0;
                        while ao < (unsafe { (*st).rvalue.operand_count }) && (unsafe { (*st).rvalue.operands as usize }) != 0 {
                            let op_p = unsafe { mir_op_at((*st).rvalue.operands, ao) };
                            if ((unsafe { (*op_p).kind }) == MIR_OP_COPY || (unsafe { (*op_p).kind }) == MIR_OP_MOVE) &&
                               (unsafe { (*op_p).place.local.v }) == ptr_loc &&
                               (unsafe { (*op_p).place.proj_count }) >= 1 {
                                let np = esc_strip_leading_deref(unsafe { view((*op_p).place) }, slot_loc, mut_view(*arena));
                                unsafe { (*op_p).place = np; }
                            }
                            ao = ao + 1;
                        }
                    }
                }
            }
            s = s + 1;
        }
        if (unsafe { (*bb).terminator.kind }) == MIR_TERM_CALL {
            let mut ai: usize = 0;
            while ai < (unsafe { (*bb).terminator.arg_count }) && (unsafe { (*bb).terminator.args as usize }) != 0 {
                let ap = unsafe { mir_op_at((*bb).terminator.args, ai) };
                if ((unsafe { (*ap).kind }) == MIR_OP_COPY || (unsafe { (*ap).kind }) == MIR_OP_MOVE) &&
                   (unsafe { (*ap).place.local.v }) == ptr_loc &&
                   (unsafe { (*ap).place.proj_count }) >= 1 {
                    let np = esc_strip_leading_deref(unsafe { view((*ap).place) }, slot_loc, mut_view(*arena));
                    unsafe { (*ap).place = np; }
                }
                ai = ai + 1;
            }
        }
        b = b + 1;
    }
}

fn esc_emit_unit_assign_if_needed(bb: mut_view<MirBb>, mir: view<MirBody>, arena: mut_view<Arena>) {
    if !bb.terminator.has_destination {
        return;
    }
    let dst_loc = bb.terminator.destination.local.v as usize;
    if dst_loc >= mir.local_count {
        return;
    }
    let dst_ty = TypeId { v: unsafe { (*mir_local_at(mir.locals, dst_loc)).ty.v } };
    let sp = bb.terminator.span;
    let mut st = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
    mir_stmt_reset(mut_view(st), MIR_STMT_ASSIGN, view(sp));
    mir_copy_place(mut_view(st.place), view(bb.terminator.destination));
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_CONST;
    st.rvalue.use_op.constant.ty.v = dst_ty.v;
    st.rvalue.use_op.constant.kind = MIR_CONST_UNIT;
    st.rvalue.use_op.constant.val = 0u64;
    mir_bb_push_stmt(mut_view(*bb), mut_view(*arena), view(st));
}


fn esc_bb_range_has_storage_marker_for(bb: *mut MirBb, start_s: usize, end_s: usize, clv: u32) -> bool {
    let scnt = unsafe { (*bb).stmt_count };
    let lim: usize = if end_s < scnt { end_s } else { scnt };
    let mut s: usize = start_s;
    while s < lim {
        let st = unsafe { mir_stmt_at((*bb).stmts, s) };
        let sk = unsafe { (*st).kind };
        if (sk == MIR_STMT_STORAGE_DEAD || sk == MIR_STMT_STORAGE_LIVE) &&
           (unsafe { (*st).storage_local.v }) == clv {
            return true;
        }
        s = s + 1;
    }
    false
}

fn esc_path_has_storage_marker_for(
    mir: view<MirBody>,
    opt_body: view<OptBody>,
    clv: u32,
    alloc_bb: u32,
    def_stmt_idx: usize,
    use_bb: u32,
    use_idx: usize,
    alloc_in_cycle: bool,
    scratch_vis: *mut bool,
    scratch_q: *mut u32
) -> bool {
    let abb = unsafe { mir_bb_at(mir.bbs, alloc_bb as usize) };
    let ubb = unsafe { mir_bb_at(mir.bbs, use_bb as usize) };
    if use_bb == alloc_bb {
        if use_idx > def_stmt_idx {
            if esc_bb_range_has_storage_marker_for(abb, def_stmt_idx + 1, use_idx, clv) {
                return true;
            }
        } else if !alloc_in_cycle {
            return true;
        }
    }
    if use_bb != alloc_bb || alloc_in_cycle {
        if esc_bb_range_has_storage_marker_for(abb, def_stmt_idx + 1, unsafe { (*abb).stmt_count }, clv) {
            return true;
        }
        if esc_bb_range_has_storage_marker_for(ubb, 0, use_idx, clv) {
            return true;
        }
        let mut mb: usize = 0;
        while mb < mir.bb_count {
            let mb_u32 = mb as u32;
            if esc_bb_reaches_without_killer(opt_body, alloc_bb, mb_u32, ESC_NONE_IDX, scratch_vis, scratch_q) &&
               esc_bb_reaches_without_killer(opt_body, mb_u32, use_bb, ESC_NONE_IDX, scratch_vis, scratch_q) {
                let mblk = unsafe { mir_bb_at(mir.bbs, mb) };
                if esc_bb_range_has_storage_marker_for(mblk, 0, unsafe { (*mblk).stmt_count }, clv) {
                    return true;
                }
            }
            mb = mb + 1;
        }
    }
    false
}

fn esc_mir_capture_safe_to_forward(
    mir: view<MirBody>,
    opt_body: view<OptBody>,
    info: view<EscapeInfo>,
    clv: u32,
    clos_loc: u32,
    alloc_bb: u32,
    def_stmt_idx: usize,
    arena: mut_view<Arena>
) -> bool {
    if clv == 0u32 || (clv as usize) >= mir.local_count || mir.bb_count != opt_body.bb_count {
        return false;
    }
    if (clv as usize) < info.local_count && (info.locals as usize) != 0 {
        let clp = unsafe { escape_local_at(info.locals, clv as usize) };
        if (unsafe { (*clp).mut_borrow_taken }) || (unsafe { (*clp).has_drop }) {
            return false;
        }
    }
    if alias_count_local_defs(opt_body, clv) != 1u32 {
        return false;
    }
    let mut def_cnt: u32 = 0u32;
    let mut def_b: u32 = 0u32;
    let mut def_s: usize = 0;
    let mut b: usize = 0;
    while b < mir.bb_count {
        let bb = unsafe { mir_bb_at(mir.bbs, b) };
        let mut s: usize = 0;
        while s < (unsafe { (*bb).stmt_count }) {
            let st = unsafe { mir_stmt_at((*bb).stmts, s) };
            let sk = unsafe { (*st).kind };
            if sk == MIR_STMT_ASSIGN {
                if (unsafe { (*st).place.local.v }) == clv {
                    if (unsafe { (*st).place.proj_count }) != 0 {
                        return false;
                    }
                    def_cnt = def_cnt + 1u32;
                    def_b = b as u32;
                    def_s = s;
                }
                let rv = unsafe { view((*st).rvalue) };
                if rv.kind == MIR_RVALUE_REF && rv.borrow_kind == MIR_BORROW_MUT && rv.place.local.v == clv {
                    return false;
                }
            } else if sk == MIR_STMT_DROP && esc_place_uses_local(unsafe { view((*st).place) }, clv) {
                return false;
            }
            s = s + 1;
        }
        let tm = unsafe { view((*bb).terminator) };
        if tm.kind == MIR_TERM_DROP && esc_place_uses_local(view(tm.drop_place), clv) {
            return false;
        }
        if tm.kind == MIR_TERM_CALL && tm.has_destination && tm.destination.local.v == clv {
            if tm.destination.proj_count != 0 {
                return false;
            }
            def_cnt = def_cnt + 1u32;
            def_b = b as u32;
            def_s = unsafe { (*bb).stmt_count };
        }
        b = b + 1;
    }
    if (clv as usize) > mir.arg_count {
        if def_cnt != 1u32 || !opt_dominates(opt_body, (OptBbId { v: def_b }), (OptBbId { v: alloc_bb })) {
            return false;
        }
        if def_b == alloc_bb && def_s >= def_stmt_idx {
            return false;
        }
    } else if def_cnt != 0u32 {
        return false;
    }

    let bcnt_alloc: usize = if opt_body.bb_count == 0 { 1 } else { opt_body.bb_count };
    let scratch_vis = arena_alloc_raw(mut_view(*arena), esc_mul_usize(bcnt_alloc, size_of<bool>()), align_of<bool>()) as *mut bool;
    let scratch_q = arena_alloc_raw(mut_view(*arena), esc_mul_usize(bcnt_alloc, size_of<u32>()), align_of<u32>()) as *mut u32;
    let alloc_in_cycle = esc_bb_reaches_without_killer(opt_body, alloc_bb, alloc_bb, ESC_NONE_IDX, scratch_vis, scratch_q);

    let mut ub: usize = 0;
    while ub < mir.bb_count {
        let ubb = unsafe { mir_bb_at(mir.bbs, ub) };
        let mut us: usize = 0;
        while us < (unsafe { (*ubb).stmt_count }) {
            if !(ub == (alloc_bb as usize) && us == def_stmt_idx) {
                let ust = unsafe { mir_stmt_at((*ubb).stmts, us) };
                if (unsafe { (*ust).kind }) != MIR_STMT_STORAGE_LIVE &&
                   (unsafe { (*ust).kind }) != MIR_STMT_STORAGE_DEAD &&
                   esc_stmt_uses_local(unsafe { view(*ust) }, clos_loc) {
                    if esc_path_has_storage_marker_for(mir, opt_body, clv, alloc_bb, def_stmt_idx, ub as u32, us, alloc_in_cycle, scratch_vis, scratch_q) {
                        return false;
                    }
                }
            }
            us = us + 1;
        }
        if esc_term_uses_local(unsafe { view((*ubb).terminator) }, clos_loc) {
            if esc_path_has_storage_marker_for(mir, opt_body, clv, alloc_bb, def_stmt_idx, ub as u32, unsafe { (*ubb).stmt_count }, alloc_in_cycle, scratch_vis, scratch_q) {
                return false;
            }
        }
        ub = ub + 1;
    }
    true
}

fn esc_try_promote_closure_site(
    mir: mut_view<MirBody>,
    opt_body: view<OptBody>,
    info: view<EscapeInfo>,
    clos_loc: u32,
    alloc_bb: u32,
    stats: mut_view<EscapePromoteStats>,
    arena: mut_view<Arena>
) -> bool {
    if (opt_body.thir as usize) == 0 || (clos_loc as usize) >= mir.local_count || (alloc_bb as usize) >= mir.bb_count {
        return false;
    }
    let clos_ty = TypeId { v: unsafe { (*mir_local_at(mir.locals, clos_loc as usize)).ty.v } };
    let ctp = type_get(unsafe { view((*opt_body.thir).interner) }, clos_ty);
    if (ctp as usize) == 0 || (unsafe { (*ctp).kind }) != TY_CLOSURE {
        return false;
    }
    let fn_sym_v = unsafe { (*ctp).fn_sym };
    let fn_ty = TypeId { v: unsafe { (*ctp).fn_type.v } };
    let cap_cnt = unsafe { (*ctp).capture_count };
    if fn_sym_v == 0u32 || fn_ty.v == 0u32 {
        return false;
    }

    // Locate the single `_clos = aggregate([fn_op, cap0, ...])` statement in `alloc_bb`
    let abb = unsafe { mir_bb_at(mir.bbs, alloc_bb as usize) };
    let mut def_stmt_idx: usize = unsafe { (*abb).stmt_count };
    let mut s0: usize = 0;
    while s0 < (unsafe { (*abb).stmt_count }) {
        let st = unsafe { mir_stmt_at((*abb).stmts, s0) };
        if (unsafe { (*st).kind }) == MIR_STMT_ASSIGN &&
           (unsafe { (*st).place.local.v }) == clos_loc &&
           (unsafe { (*st).place.proj_count }) == 0 &&
           (unsafe { (*st).rvalue.kind }) == MIR_RVALUE_AGGREGATE {
            def_stmt_idx = s0;
            break;
        }
        s0 = s0 + 1;
    }
    if def_stmt_idx >= (unsafe { (*abb).stmt_count }) {
        return false;
    }
    let def_st = unsafe { mir_stmt_at((*abb).stmts, def_stmt_idx) };
    if (unsafe { (*def_st).rvalue.operand_count }) != cap_cnt + 1 ||
       (unsafe { (*def_st).rvalue.operands as usize }) == 0 {
        return false;
    }

    // Verify all capture operands are constants or single-def unborrowed locals live until every closure use
    let saved_caps = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(if cap_cnt == 0 { 1 } else { cap_cnt }, size_of<MirOperand>()),
        align_of<MirOperand>()
    ) as *mut MirOperand;
    let mut ci: usize = 0;
    while ci < cap_cnt {
        let cap_op = unsafe { mir_op_at((*def_st).rvalue.operands, ci + 1) };
        let ck = unsafe { (*cap_op).kind };
        if ck == MIR_OP_COPY || ck == MIR_OP_MOVE {
            if (unsafe { (*cap_op).place.proj_count }) != 0 {
                return false;
            }
            let clv = unsafe { (*cap_op).place.local.v };
            if !esc_mir_capture_safe_to_forward(view(*mir), opt_body, info, clv, clos_loc, alloc_bb, def_stmt_idx, mut_view(*arena)) {
                return false;
            }
        } else if ck != MIR_OP_CONST {
            return false;
        }
        let dst_cap = unsafe { mir_op_at(saved_caps, ci) };
        mir_copy_operand(unsafe { mut_view(*dst_cap) }, unsafe { view(*cap_op) });
        if (unsafe { (*dst_cap).kind }) == MIR_OP_MOVE {
            unsafe { (*dst_cap).kind = MIR_OP_COPY; }
        }
        ci = ci + 1;
    }

    // Verify every other reference to `clos_loc` in `mir` is dominated by `alloc_bb` and is ONLY a direct call or `.field` read
    let mut b: usize = 0;
    while b < mir.bb_count {
        let bb = unsafe { mir_bb_at(mir.bbs, b) };
        let mut s: usize = 0;
        while s < (unsafe { (*bb).stmt_count }) {
            if b == (alloc_bb as usize) && s == def_stmt_idx {
                s = s + 1;
                continue;
            }
            let st = unsafe { mir_stmt_at((*bb).stmts, s) };
            let sk = unsafe { (*st).kind };
            if sk == MIR_STMT_ASSIGN {
                if (unsafe { (*st).place.local.v }) == clos_loc {
                    return false;
                }
                let rv = unsafe { view((*st).rvalue) };
                if rv.kind == MIR_RVALUE_USE && (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                   rv.use_op.place.local.v == clos_loc {
                    if rv.use_op.place.proj_count != 1 || (rv.use_op.place.projs as usize) == 0 ||
                       !opt_dominates(opt_body, (OptBbId { v: alloc_bb }), (OptBbId { v: b as u32 })) {
                        return false;
                    }
                    let pr0 = unsafe { mir_proj_at(rv.use_op.place.projs, 0) };
                    let fidx = unsafe { (*pr0).field_idx } as usize;
                    if (unsafe { (*pr0).kind }) != MIR_PROJ_FIELD || fidx < 1 || fidx > cap_cnt {
                        return false;
                    }
                } else {
                    if esc_rvalue_uses_local(rv, clos_loc) {
                        return false;
                    }
                }
            } else if sk == MIR_STMT_DROP && (unsafe { (*st).place.local.v }) == clos_loc {
                return false;
            }
            s = s + 1;
        }
        let tm = unsafe { view((*bb).terminator) };
        if tm.kind == MIR_TERM_DROP && tm.drop_place.local.v == clos_loc {
            return false;
        }
        if tm.kind == MIR_TERM_CALL {
            if tm.has_destination && tm.destination.local.v == clos_loc {
                return false;
            }
            let mut ai: usize = 0;
            while ai < tm.arg_count && (tm.args as usize) != 0 {
                let ap = unsafe { mir_op_at(tm.args, ai) };
                if esc_operand_uses_local(unsafe { view(*ap) }, clos_loc) {
                    return false;
                }
                ai = ai + 1;
            }
            if esc_operand_uses_local(view(tm.func), clos_loc) {
                if (tm.func.kind != MIR_OP_COPY && tm.func.kind != MIR_OP_MOVE) ||
                   tm.func.place.proj_count != 0 ||
                   !opt_dominates(opt_body, (OptBbId { v: alloc_bb }), (OptBbId { v: b as u32 })) {
                    return false;
                }
            }
        }
        b = b + 1;
    }

    // Rewrite capture field reads & devirtualize direct closure calls
    let mut direct_calls: u32 = 0u32;
    let mut rb: usize = 0;
    while rb < mir.bb_count {
        let bb = unsafe { mir_bb_at(mir.bbs, rb) };
        let mut rs: usize = 0;
        while rs < (unsafe { (*bb).stmt_count }) {
            let st = unsafe { mir_stmt_at((*bb).stmts, rs) };
            let sk = unsafe { (*st).kind };
            if (sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD) &&
               (unsafe { (*st).storage_local.v }) == clos_loc {
                esc_mir_remove_stmt_at(unsafe { mut_view(*bb) }, rs);
                if rb == (alloc_bb as usize) && rs < def_stmt_idx {
                    def_stmt_idx = def_stmt_idx - 1;
                }
                continue;
            }
            if rb == (alloc_bb as usize) && rs == def_stmt_idx {
                esc_mir_remove_stmt_at(unsafe { mut_view(*bb) }, rs);
                def_stmt_idx = 0xFFFFFFFFusize;
                continue;
            }
            if sk == MIR_STMT_ASSIGN && (unsafe { (*st).rvalue.kind }) == MIR_RVALUE_USE &&
               ((unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_MOVE) &&
               (unsafe { (*st).rvalue.use_op.place.local.v }) == clos_loc &&
               (unsafe { (*st).rvalue.use_op.place.proj_count }) == 1 {
                let pr0 = unsafe { mir_proj_at((*st).rvalue.use_op.place.projs, 0) };
                let fidx = (unsafe { (*pr0).field_idx } as usize) - 1;
                let cap_src = unsafe { mir_op_at(saved_caps, fidx) };
                mir_copy_operand(unsafe { mut_view((*st).rvalue.use_op) }, unsafe { view(*cap_src) });
            }
            rs = rs + 1;
        }
        if (unsafe { (*bb).terminator.kind }) == MIR_TERM_CALL &&
           ((unsafe { (*bb).terminator.func.kind }) == MIR_OP_COPY || (unsafe { (*bb).terminator.func.kind }) == MIR_OP_MOVE) &&
           (unsafe { (*bb).terminator.func.place.local.v }) == clos_loc &&
           (unsafe { (*bb).terminator.func.place.proj_count }) == 0 {
            let old_acnt = unsafe { (*bb).terminator.arg_count };
            let old_args = unsafe { (*bb).terminator.args };
            let new_acnt = cap_cnt + old_acnt;
            let mut new_args: *mut MirOperand = 0 as *mut MirOperand;
            if new_acnt > 0 {
                new_args = arena_alloc_raw(
                    mut_view(*arena),
                    esc_mul_usize(new_acnt, size_of<MirOperand>()),
                    align_of<MirOperand>()
                ) as *mut MirOperand;
                let mut kc: usize = 0;
                while kc < cap_cnt {
                    let cs = unsafe { mir_op_at(saved_caps, kc) };
                    let cd = unsafe { mir_op_at(new_args, kc) };
                    mir_copy_operand(unsafe { mut_view(*cd) }, unsafe { view(*cs) });
                    kc = kc + 1;
                }
                let mut ka: usize = 0;
                while ka < old_acnt && (old_args as usize) != 0 {
                    let asrc = unsafe { mir_op_at(old_args, ka) };
                    let adst = unsafe { mir_op_at(new_args, cap_cnt + ka) };
                    mir_copy_operand(unsafe { mut_view(*adst) }, unsafe { view(*asrc) });
                    ka = ka + 1;
                }
            }
            unsafe {
                (*bb).terminator.func.kind = MIR_OP_CONST;
                (*bb).terminator.func.place = mir_local_place(0u32);
                (*bb).terminator.func.constant.kind = MIR_CONST_FN;
                (*bb).terminator.func.constant.ty.v = fn_ty.v;
                (*bb).terminator.func.constant.val = fn_sym_v as u64;
                (*bb).terminator.func.constant.sym.v = fn_sym_v;
                (*bb).terminator.args = new_args;
                (*bb).terminator.arg_count = new_acnt;
            }
            direct_calls = direct_calls + 1u32;
        }
        rb = rb + 1;
    }

    stats.closure_env_promotions = stats.closure_env_promotions + 1u32;
    stats.closure_direct_calls = stats.closure_direct_calls + direct_calls;
    true
}

fn esc_rvalue_proj_or_dropflag_uses_local(rv: view<MirRvalue>, loc_v: u32) -> bool {
    let rvk = rv.kind;
    if rvk == MIR_RVALUE_REPEAT && (rv.repeat_count_op as usize) != 0 {
        if esc_operand_uses_local(unsafe { view(*rv.repeat_count_op) }, loc_v) {
            return true;
        }
    }
    if esc_rvalue_has_use_op(rvk) && (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) {
        if esc_place_proj_uses_local(view(rv.use_op.place), loc_v) {
            return true;
        }
        if rv.use_op.place.local.v == loc_v && rv.use_op.place.drop_flag != MIR_DROP_FLAG_NONE {
            return true;
        }
    }
    if esc_rvalue_has_bin_ops(rvk) {
        if (rv.lhs.kind == MIR_OP_COPY || rv.lhs.kind == MIR_OP_MOVE) {
            if esc_place_proj_uses_local(view(rv.lhs.place), loc_v) {
                return true;
            }
            if rv.lhs.place.local.v == loc_v && rv.lhs.place.drop_flag != MIR_DROP_FLAG_NONE {
                return true;
            }
        }
        if (rv.rhs.kind == MIR_OP_COPY || rv.rhs.kind == MIR_OP_MOVE) {
            if esc_place_proj_uses_local(view(rv.rhs.place), loc_v) {
                return true;
            }
            if rv.rhs.place.local.v == loc_v && rv.rhs.place.drop_flag != MIR_DROP_FLAG_NONE {
                return true;
            }
        }
    }
    if rvk == MIR_RVALUE_REF || rvk == MIR_RVALUE_LEN || rvk == MIR_RVALUE_DISCRIMINANT {
        if esc_place_proj_uses_local(view(rv.place), loc_v) {
            return true;
        }
        if rv.place.local.v == loc_v && rv.place.drop_flag != MIR_DROP_FLAG_NONE {
            return true;
        }
    }
    if rvk == MIR_RVALUE_AGGREGATE {
        let mut ao: usize = 0;
        while ao < rv.operand_count && (rv.operands as usize) != 0 {
            let op_p = unsafe { mir_op_at(rv.operands, ao) };
            if ((unsafe { (*op_p).kind }) == MIR_OP_COPY || (unsafe { (*op_p).kind }) == MIR_OP_MOVE) {
                if esc_place_proj_uses_local(unsafe { view((*op_p).place) }, loc_v) {
                    return true;
                }
                if (unsafe { (*op_p).place.local.v }) == loc_v &&
                   (unsafe { (*op_p).place.drop_flag }) != MIR_DROP_FLAG_NONE {
                    return true;
                }
            }
            ao = ao + 1;
        }
    }
    false
}

fn esc_try_promote_nrvo_for_local(
    mir: mut_view<MirBody>,
    cand: u32,
    cand_sz: u64,
    stats: mut_view<EscapePromoteStats>,
    log: *mut EscapePromoteLog,
    arena: mut_view<Arena>
) -> bool {
    // Verify `_0` is assigned ONLY once via `_0 = copy/move cand` in the sole `MIR_TERM_RETURN`
    // block, `_0` is never referenced elsewhere, and every use of `cand` in statements and
    // terminators can be alpha-renamed to `_0` without dangling or uninitialized `cand` reads.
    let mut ret_bb_idx: usize = mir.bb_count;
    let mut ret_stmt_idx: usize = 0;
    let mut ret_defs: u32 = 0u32;
    let mut return_term_count: u32 = 0u32;
    let mut cand_defs: u32 = 0u32;
    let mut b: usize = 0;
    while b < mir.bb_count {
        let bb = unsafe { mir_bb_at(mir.bbs, b) };
        if !(unsafe { (*bb).has_terminator }) {
            return false;
        }
        let mut s: usize = 0;
        while s < (unsafe { (*bb).stmt_count }) {
            let st = unsafe { mir_stmt_at((*bb).stmts, s) };
            let sk = unsafe { (*st).kind };
            if sk == MIR_STMT_ASSIGN {
                let dst = unsafe { view((*st).place) };
                let rv = unsafe { view((*st).rvalue) };
                if esc_place_proj_uses_local(dst, 0u32) || esc_place_proj_uses_local(dst, cand) {
                    return false;
                }
                if (dst.local.v == 0u32 || dst.local.v == cand) && dst.drop_flag != MIR_DROP_FLAG_NONE {
                    return false;
                }
                if dst.local.v == 0u32 {
                    ret_defs = ret_defs + 1u32;
                    let mut trailing_ok = true;
                    let mut ts: usize = s + 1;
                    while ts < (unsafe { (*bb).stmt_count }) {
                        let tst = unsafe { mir_stmt_at((*bb).stmts, ts) };
                        let tsk = unsafe { (*tst).kind };
                        if tsk != MIR_STMT_STORAGE_DEAD || (unsafe { (*tst).storage_local.v }) == 0u32 {
                            trailing_ok = false;
                        }
                        ts = ts + 1;
                    }
                    if dst.proj_count == 0 && rv.kind == MIR_RVALUE_USE &&
                       (rv.use_op.kind == MIR_OP_COPY || rv.use_op.kind == MIR_OP_MOVE) &&
                       rv.use_op.place.local.v == cand && rv.use_op.place.proj_count == 0 &&
                       rv.use_op.place.drop_flag == MIR_DROP_FLAG_NONE &&
                       (unsafe { (*bb).terminator.kind }) == MIR_TERM_RETURN &&
                       trailing_ok {
                        ret_bb_idx = b;
                        ret_stmt_idx = s;
                    } else {
                        return false;
                    }
                } else {
                    if dst.local.v == cand {
                        if dst.proj_count > 0 && (dst.projs as usize) != 0 &&
                           (unsafe { (*mir_proj_at(dst.projs, 0)).kind }) == MIR_PROJ_DEREF {
                            return false;
                        }
                        cand_defs = cand_defs + 1u32;
                    }
                    if esc_rvalue_uses_local(rv, 0u32) {
                        return false;
                    }
                    if rv.kind == MIR_RVALUE_REF && (rv.place.local.v == 0u32 || rv.place.local.v == cand) {
                        return false;
                    }
                    if esc_rvalue_proj_or_dropflag_uses_local(rv, cand) {
                        return false;
                    }
                }
            } else if sk == MIR_STMT_DROP {
                if esc_place_uses_local(unsafe { view((*st).place) }, 0u32) ||
                   esc_place_uses_local(unsafe { view((*st).place) }, cand) {
                    return false;
                }
            } else if sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD {
                if (unsafe { (*st).storage_local.v }) == 0u32 {
                    return false;
                }
            }
            s = s + 1;
        }
        let tm = unsafe { view((*bb).terminator) };
        if tm.kind == MIR_TERM_RETURN {
            return_term_count = return_term_count + 1u32;
        } else if esc_term_uses_local(tm, 0u32) {
            return false;
        }
        if tm.kind == MIR_TERM_DROP {
            if esc_place_uses_local(view(tm.drop_place), cand) {
                return false;
            }
        } else if tm.kind == MIR_TERM_SWITCH_INT {
            if tm.discr.kind == MIR_OP_COPY || tm.discr.kind == MIR_OP_MOVE {
                if esc_place_proj_uses_local(view(tm.discr.place), cand) {
                    return false;
                }
                if tm.discr.place.local.v == cand && tm.discr.place.drop_flag != MIR_DROP_FLAG_NONE {
                    return false;
                }
            }
        } else if tm.kind == MIR_TERM_ASSERT {
            if tm.cond.kind == MIR_OP_COPY || tm.cond.kind == MIR_OP_MOVE {
                if esc_place_proj_uses_local(view(tm.cond.place), cand) {
                    return false;
                }
                if tm.cond.place.local.v == cand && tm.cond.place.drop_flag != MIR_DROP_FLAG_NONE {
                    return false;
                }
            }
        } else if tm.kind == MIR_TERM_CALL {
            if tm.has_destination {
                if esc_place_proj_uses_local(view(tm.destination), cand) {
                    return false;
                }
                if tm.destination.local.v == cand {
                    if tm.destination.drop_flag != MIR_DROP_FLAG_NONE {
                        return false;
                    }
                    if tm.destination.proj_count > 0 && (tm.destination.projs as usize) != 0 &&
                       (unsafe { (*mir_proj_at(tm.destination.projs, 0)).kind }) == MIR_PROJ_DEREF {
                        return false;
                    }
                    cand_defs = cand_defs + 1u32;
                }
            }
            if tm.func.kind == MIR_OP_COPY || tm.func.kind == MIR_OP_MOVE {
                if esc_place_proj_uses_local(view(tm.func.place), cand) {
                    return false;
                }
                if tm.func.place.local.v == cand && tm.func.place.drop_flag != MIR_DROP_FLAG_NONE {
                    return false;
                }
            }
            let mut ai: usize = 0;
            while ai < tm.arg_count && (tm.args as usize) != 0 {
                let ap = unsafe { mir_op_at(tm.args, ai) };
                if esc_operand_uses_local(unsafe { view(*ap) }, cand) {
                    return false;
                }
                ai = ai + 1;
            }
        }
        b = b + 1;
    }
    if ret_defs != 1u32 || return_term_count != 1u32 || cand_defs == 0u32 || ret_bb_idx >= mir.bb_count {
        return false;
    }

    // Remove `_0 = copy/move cand` and rewrite all `cand` places in statements and terminators to `_0`
    let rbb = unsafe { mir_bb_at(mir.bbs, ret_bb_idx) };
    esc_mir_remove_stmt_at(unsafe { mut_view(*rbb) }, ret_stmt_idx);

    let mut wb: usize = 0;
    while wb < mir.bb_count {
        let bb = unsafe { mir_bb_at(mir.bbs, wb) };
        let mut ws: usize = 0;
        while ws < (unsafe { (*bb).stmt_count }) {
            let st = unsafe { mir_stmt_at((*bb).stmts, ws) };
            let sk = unsafe { (*st).kind };
            if (sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD) &&
               (unsafe { (*st).storage_local.v }) == cand {
                esc_mir_remove_stmt_at(unsafe { mut_view(*bb) }, ws);
                continue;
            }
            if sk == MIR_STMT_ASSIGN {
                if (unsafe { (*st).place.local.v }) == cand {
                    unsafe { (*st).place.local.v = 0u32; }
                }
                let rvk = unsafe { (*st).rvalue.kind };
                if esc_rvalue_has_use_op(rvk) &&
                   ((unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_MOVE) &&
                   (unsafe { (*st).rvalue.use_op.place.local.v }) == cand {
                    unsafe { (*st).rvalue.use_op.place.local.v = 0u32; }
                }
                if esc_rvalue_has_bin_ops(rvk) {
                    if ((unsafe { (*st).rvalue.lhs.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.lhs.kind }) == MIR_OP_MOVE) &&
                       (unsafe { (*st).rvalue.lhs.place.local.v }) == cand {
                        unsafe { (*st).rvalue.lhs.place.local.v = 0u32; }
                    }
                    if ((unsafe { (*st).rvalue.rhs.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.rhs.kind }) == MIR_OP_MOVE) &&
                       (unsafe { (*st).rvalue.rhs.place.local.v }) == cand {
                        unsafe { (*st).rvalue.rhs.place.local.v = 0u32; }
                    }
                }
                if (rvk == MIR_RVALUE_LEN || rvk == MIR_RVALUE_DISCRIMINANT) &&
                   (unsafe { (*st).rvalue.place.local.v }) == cand {
                    unsafe { (*st).rvalue.place.local.v = 0u32; }
                }
                if rvk == MIR_RVALUE_AGGREGATE {
                    let mut ao: usize = 0;
                    while ao < (unsafe { (*st).rvalue.operand_count }) && (unsafe { (*st).rvalue.operands as usize }) != 0 {
                        let op_p = unsafe { mir_op_at((*st).rvalue.operands, ao) };
                        if ((unsafe { (*op_p).kind }) == MIR_OP_COPY || (unsafe { (*op_p).kind }) == MIR_OP_MOVE) &&
                           (unsafe { (*op_p).place.local.v }) == cand {
                            unsafe { (*op_p).place.local.v = 0u32; }
                        }
                        ao = ao + 1;
                    }
                }
            }
            ws = ws + 1;
        }
        let wtk = unsafe { (*bb).terminator.kind };
        if wtk == MIR_TERM_SWITCH_INT {
            if ((unsafe { (*bb).terminator.discr.kind }) == MIR_OP_COPY || (unsafe { (*bb).terminator.discr.kind }) == MIR_OP_MOVE) &&
               (unsafe { (*bb).terminator.discr.place.local.v }) == cand {
                unsafe { (*bb).terminator.discr.place.local.v = 0u32; }
            }
        } else if wtk == MIR_TERM_ASSERT {
            if ((unsafe { (*bb).terminator.cond.kind }) == MIR_OP_COPY || (unsafe { (*bb).terminator.cond.kind }) == MIR_OP_MOVE) &&
               (unsafe { (*bb).terminator.cond.place.local.v }) == cand {
                unsafe { (*bb).terminator.cond.place.local.v = 0u32; }
            }
        } else if wtk == MIR_TERM_CALL {
            if ((unsafe { (*bb).terminator.func.kind }) == MIR_OP_COPY || (unsafe { (*bb).terminator.func.kind }) == MIR_OP_MOVE) &&
               (unsafe { (*bb).terminator.func.place.local.v }) == cand {
                unsafe { (*bb).terminator.func.place.local.v = 0u32; }
            }
            if (unsafe { (*bb).terminator.has_destination }) &&
               (unsafe { (*bb).terminator.destination.local.v }) == cand {
                unsafe { (*bb).terminator.destination.local.v = 0u32; }
            }
        }
        wb = wb + 1;
    }

    stats.nrvo_promotions = stats.nrvo_promotions + 1u32;
    escape_log_push(log, mut_view(*arena), EscapePromoteRecord {
        is_barrier: false,
        action: PROMOTE_ACTION_NRVO_SLOT,
        storage_decision: STORAGE_DECISION_CALLER_RET_SLOT,
        reason: REASON_NRVO_RET_SLOT,
        bb_idx: ret_bb_idx as u32,
        local_id: cand,
        promoted_local: 0u32,
        size_bytes: cand_sz,
    });
    true
}

fn esc_try_promote_nrvo(
    mir: mut_view<MirBody>,
    info: view<EscapeInfo>,
    stats: mut_view<EscapePromoteStats>,
    log: *mut EscapePromoteLog,
    arena: mut_view<Arena>
) -> bool {
    if mir.local_count <= mir.arg_count + 1 || mir.bb_count == 0 || (mir.bbs as usize) == 0 || (mir.locals as usize) == 0 {
        return false;
    }
    let ret_ty = TypeId { v: unsafe { (*mir_local_at(mir.locals, 0)).ty.v } };
    let mut l: usize = mir.arg_count + 1;
    while l < mir.local_count && l < info.local_count {
        let lp = unsafe { escape_local_at(info.locals, l) };
        if (unsafe { (*lp).storage_decision }) == STORAGE_DECISION_CALLER_RET_SLOT &&
           !(unsafe { (*lp).borrow_taken }) && !(unsafe { (*lp).has_drop }) &&
           (unsafe { (*mir_local_at(mir.locals, l)).kind }) != MIR_LOCAL_ARG {
            let lty = TypeId { v: unsafe { (*mir_local_at(mir.locals, l)).ty.v } };
            if lty.v == ret_ty.v {
                let cand_sz = unsafe { (*lp).size_bytes };
                if esc_try_promote_nrvo_for_local(mut_view(*mir), l as u32, cand_sz, mut_view(*stats), log, mut_view(*arena)) {
                    return true;
                }
            }
        }
        l = l + 1;
    }
    false
}

fn esc_mir_box_no_whole_value_transfer(mir: view<MirBody>, box_loc: u32, alloc_bb: u32) -> bool {
    let mut b: usize = 0;
    while b < mir.bb_count && (mir.bbs as usize) != 0 {
        let bb = unsafe { mir_bb_at(mir.bbs, b) };
        let mut s: usize = 0;
        while s < (unsafe { (*bb).stmt_count }) {
            let st = unsafe { mir_stmt_at((*bb).stmts, s) };
            let sk = unsafe { (*st).kind };
            if sk == MIR_STMT_ASSIGN {
                let dst = unsafe { view((*st).place) };
                let rv = unsafe { view((*st).rvalue) };
                if dst.local.v == box_loc && esc_place_first_deref_idx(dst) == dst.proj_count {
                    return false;
                }
                if dst.local.v != box_loc && esc_place_uses_local(dst, box_loc) {
                    return false;
                }
                if esc_rvalue_transfers_whole_box(rv, box_loc) {
                    return false;
                }
            } else if sk == MIR_STMT_DROP {
                let dpl = unsafe { view((*st).place) };
                if esc_place_uses_local(dpl, box_loc) && (dpl.local.v != box_loc || dpl.proj_count != 0) {
                    return false;
                }
            }
            s = s + 1;
        }
        let tm = unsafe { view((*bb).terminator) };
        if tm.kind == MIR_TERM_DROP {
            if esc_place_uses_local(view(tm.drop_place), box_loc) &&
               (tm.drop_place.local.v != box_loc || tm.drop_place.proj_count != 0) {
                return false;
            }
        } else if tm.kind == MIR_TERM_SWITCH_INT {
            if esc_operand_transfers_whole_box(view(tm.discr), box_loc) {
                return false;
            }
        } else if tm.kind == MIR_TERM_ASSERT {
            if esc_operand_transfers_whole_box(view(tm.cond), box_loc) {
                return false;
            }
        } else if tm.kind == MIR_TERM_CALL {
            if (b as u32) != alloc_bb && tm.has_destination {
                if tm.destination.local.v == box_loc &&
                   esc_place_first_deref_idx(view(tm.destination)) == tm.destination.proj_count {
                    return false;
                }
                if tm.destination.local.v != box_loc && esc_place_uses_local(view(tm.destination), box_loc) {
                    return false;
                }
            }
            if esc_operand_transfers_whole_box(view(tm.func), box_loc) {
                return false;
            }
            let mut ai: usize = 0;
            while ai < tm.arg_count && (tm.args as usize) != 0 {
                let ap = unsafe { mir_op_at(tm.args, ai) };
                if esc_operand_transfers_whole_box(unsafe { view(*ap) }, box_loc) {
                    return false;
                }
                ai = ai + 1;
            }
        }
        b = b + 1;
    }
    true
}


pub fn escape_promote_mir(
    mir: mut_view<MirBody>,
    opt_body: view<OptBody>,
    info: mut_view<EscapeInfo>,
    summary_table: *const EscapeSummaryTable,
    stats: mut_view<EscapePromoteStats>,
    log: *mut EscapePromoteLog,
    arena: mut_view<Arena>
) -> bool {
    let mut changed = false;
    if info.disjoint_pair_count > 0 {
        stats.disjoint_slot_reuses = stats.disjoint_slot_reuses + (info.disjoint_pair_count as u32);
    }

    let mut si: usize = 0;
    while si < info.site_count {
        let sp = unsafe { escape_site_at(info.sites, si) };
        let akind = unsafe { (*sp).kind };
        let sdec = unsafe { (*sp).storage_decision };
        let rsn = unsafe { (*sp).reason };
        let abb_idx = unsafe { (*sp).alloc_bb };
        let dloc = unsafe { (*sp).dest_local };
        let sz_b = unsafe { (*sp).size_bytes };

        if sdec == STORAGE_DECISION_HEAP || sdec == STORAGE_DECISION_FIXED_MMIO ||
           sdec == STORAGE_DECISION_DEVICE_EXTERNAL || sdec == STORAGE_DECISION_STATIC_TLS {
            stats.heap_retentions = stats.heap_retentions + 1u32;
            escape_log_push(log, mut_view(*arena), EscapePromoteRecord {
                is_barrier: true,
                action: PROMOTE_ACTION_RETAINED_BARRIER,
                storage_decision: sdec,
                reason: rsn,
                bb_idx: abb_idx,
                local_id: dloc,
                promoted_local: ESC_NONE_IDX,
                size_bytes: sz_b,
            });
            si = si + 1;
            continue;
        }

        if (akind == ALLOC_KIND_RAW_HEAP || akind == ALLOC_KIND_BOUNDED_BUF) &&
           (abb_idx as usize) < mir.bb_count && (dloc as usize) < mir.local_count &&
           (opt_body.thir as usize) != 0 && (unsafe { (*sp).has_matching_free }) {
            let abb = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
            if (unsafe { (*abb).terminator.kind }) == MIR_TERM_CALL &&
               (unsafe { (*abb).terminator.has_destination }) &&
               (unsafe { (*abb).terminator.destination.local.v }) == dloc {
                let thir_mut = opt_body.thir as *mut Thir;
                let mut slot_ty = TypeId { v: 0u32 };
                if akind == ALLOC_KIND_RAW_HEAP && (unsafe { (*sp).payload_ty.v }) != 0u32 {
                    slot_ty = TypeId { v: unsafe { (*sp).payload_ty.v } };
                } else if (unsafe { (*sp).elem_ty.v }) != 0u32 && (unsafe { (*sp).elem_cap }) > 0u64 {
                    slot_ty = unsafe {
                        intern_array_ty(
                            mut_view((*thir_mut).interner),
                            TypeId { v: (*sp).elem_ty.v },
                            (*sp).elem_cap
                        )
                    };
                } else if sz_b > 0u64 && (sz_b % 8u64) == 0u64 {
                    let usz_ty_v = unsafe { (*opt_body.thir).interner.t_usize.v };
                    if usz_ty_v != 0u32 {
                        slot_ty = unsafe {
                            intern_array_ty(
                                mut_view((*thir_mut).interner),
                                TypeId { v: usz_ty_v },
                                sz_b / 8u64
                            )
                        };
                    }
                }
                if slot_ty.v == 0u32 && sz_b > 0u64 {
                    let raw_ty = TypeId { v: unsafe { (*mir_local_at(mir.locals, dloc as usize)).ty.v } };
                    let rtp = type_get(unsafe { view((*opt_body.thir).interner) }, raw_ty);
                    if (rtp as usize) != 0 && (unsafe { (*rtp).kind }) == TY_PTR && (unsafe { (*rtp).pointee.v }) != 0u32 {
                        slot_ty = unsafe {
                            intern_array_ty(
                                mut_view((*thir_mut).interner),
                                TypeId { v: (*rtp).pointee.v },
                                sz_b
                            )
                        };
                    }
                }

                if slot_ty.v != 0u32 {
                    let slot_ty_v = slot_ty.v;
                    let sp_loc = unsafe { (*abb).terminator.span };
                    let next_bb = MirBbId { v: unsafe { (*abb).terminator.call_target.v } };
                    let raw_ty_id = TypeId { v: unsafe { (*mir_local_at(mir.locals, dloc as usize)).ty.v } };
                    let rtp_chk = type_get(unsafe { view((*opt_body.thir).interner) }, TypeId { v: raw_ty_id.v });
                    let same_pointee = (rtp_chk as usize) != 0 &&
                                       (unsafe { (*rtp_chk).kind }) == TY_PTR &&
                                       (unsafe { (*rtp_chk).pointee.v }) == slot_ty_v;
                    let promo_id = mir_add_local(
                        mut_view(*mir),
                        mut_view(*arena),
                        TypeId { v: slot_ty_v },
                        MIR_LOCAL_TEMP,
                        true,
                        StrId { v: 0u32 },
                        view(sp_loc)
                    );
                    let pre_abb_stmt_cnt = unsafe { (*mir_bb_at(mir.bbs, abb_idx as usize)).stmt_count };
                    if same_pointee {
                        let abb2 = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                        let mut ref_st = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
                        mir_stmt_reset(mut_view(ref_st), MIR_STMT_ASSIGN, view(sp_loc));
                        mir_copy_place(mut_view(ref_st.place), unsafe { view((*abb2).terminator.destination) });
                        mir_rvalue_reset(mut_view(ref_st.rvalue), MIR_RVALUE_REF);
                        ref_st.rvalue.borrow_kind = MIR_BORROW_MUT;
                        ref_st.rvalue.place = mir_local_place(promo_id.v);
                        mir_bb_push_stmt(unsafe { mut_view(*abb2) }, mut_view(*arena), view(ref_st));
                    } else {
                        let slot_ptr_ty = unsafe {
                            intern_ptr_ty(mut_view((*thir_mut).interner), TypeId { v: slot_ty_v }, true)
                        };
                        let slot_ptr_id = mir_add_local(
                            mut_view(*mir),
                            mut_view(*arena),
                            slot_ptr_ty,
                            MIR_LOCAL_TEMP,
                            true,
                            StrId { v: 0u32 },
                            view(sp_loc)
                        );
                        let abb2 = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                        let mut dst_pl_copy = mir_local_place(dloc);
                        mir_copy_place(mut_view(dst_pl_copy), unsafe { view((*abb2).terminator.destination) });

                        let mut ref_st = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
                        mir_stmt_reset(mut_view(ref_st), MIR_STMT_ASSIGN, view(sp_loc));
                        ref_st.place = mir_local_place(slot_ptr_id.v);
                        mir_rvalue_reset(mut_view(ref_st.rvalue), MIR_RVALUE_REF);
                        ref_st.rvalue.borrow_kind = MIR_BORROW_MUT;
                        ref_st.rvalue.place = mir_local_place(promo_id.v);
                        mir_bb_push_stmt(unsafe { mut_view(*abb2) }, mut_view(*arena), view(ref_st));

                        let abb2_c = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                        let mut cast_st = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
                        mir_stmt_reset(mut_view(cast_st), MIR_STMT_ASSIGN, view(sp_loc));
                        cast_st.place = dst_pl_copy;
                        mir_rvalue_reset(mut_view(cast_st.rvalue), MIR_RVALUE_CAST);
                        cast_st.rvalue.cast_kind = MIR_CAST_PTR_TO_PTR;
                        cast_st.rvalue.use_op = mir_op_move_local(slot_ptr_id.v);
                        cast_st.rvalue.target_ty = TypeId { v: raw_ty_id.v };
                        mir_bb_push_stmt(unsafe { mut_view(*abb2_c) }, mut_view(*arena), view(cast_st));
                    }

                    let abb2_t = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                    mir_term_reset(unsafe { mut_view((*abb2_t).terminator) }, MIR_TERM_GOTO, view(sp_loc));
                    unsafe { (*abb2_t).terminator.goto_target.v = next_bb.v; }

                    // Elide all matching `heap_free` calls on `dloc` or its pointer aliases
                    let mut fb: usize = 0;
                    while fb < mir.bb_count {
                        let fblk = unsafe { mir_bb_at(mir.bbs, fb) };
                        if (unsafe { (*fblk).terminator.kind }) == MIR_TERM_CALL {
                            let fsym_v = esc_extract_callee_sym(opt_body, unsafe { view((*fblk).terminator.func) }).v;
                            let mut fsum = escape_summary_zero(SymbolId { v: fsym_v }, 0);
                            if escape_summary_table_lookup(summary_table, (SymbolId { v: fsym_v }), mut_view(fsum)) && fsum.is_free_fn &&
                               (unsafe { (*fblk).terminator.arg_count }) >= 1 &&
                               (unsafe { (*fblk).terminator.args as usize }) != 0 {
                                let fa0 = unsafe { mir_op_at((*fblk).terminator.args, 0) };
                                if ((unsafe { (*fa0).kind }) == MIR_OP_COPY || (unsafe { (*fa0).kind }) == MIR_OP_MOVE) &&
                                   (unsafe { (*fa0).place.proj_count }) == 0 &&
                                   esc_local_is_ptr_alias_of(opt_body, unsafe { (*fa0).place.local.v }, dloc, 0u32) {
                                    let f_sp = unsafe { (*fblk).terminator.span };
                                    let f_tgt = MirBbId { v: unsafe { (*fblk).terminator.call_target.v } };
                                    esc_emit_unit_assign_if_needed(unsafe { mut_view(*fblk) }, view(*mir), mut_view(*arena));
                                    mir_term_reset(unsafe { mut_view((*fblk).terminator) }, MIR_TERM_GOTO, view(f_sp));
                                    unsafe { (*fblk).terminator.goto_target.v = f_tgt.v; }
                                }
                            }
                        }
                        fb = fb + 1;
                    }

                    // If `STORAGE_DECISION_SSA_REGISTER`, attempt direct SROA deref forwarding (`*p -> promo_id`)
                    let mut did_sroa = false;
                    if akind == ALLOC_KIND_RAW_HEAP && sdec == STORAGE_DECISION_SSA_REGISTER &&
                       (unsafe { (*sp).payload_ty.v }) != 0u32 {
                        let raw_ty2 = TypeId { v: unsafe { (*mir_local_at(mir.locals, dloc as usize)).ty.v } };
                        let rtp2 = type_get(unsafe { view((*opt_body.thir).interner) }, raw_ty2);
                        if (rtp2 as usize) != 0 && (unsafe { (*rtp2).kind }) == TY_PTR &&
                           (unsafe { (*rtp2).pointee.v }) == (unsafe { (*sp).payload_ty.v }) &&
                           esc_ptr_temp_only_derefed(view(*mir), opt_body, dloc) {
                            esc_rewrite_deref_of_ptr_to_slot(mut_view(*mir), dloc, promo_id.v, mut_view(*arena));
                            // Remove the `_raw = &mut promo_id` borrow we just appended so `promo_id` has zero address-taken!
                            let abb3 = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                            unsafe { (*abb3).stmt_count = pre_abb_stmt_cnt; }
                            did_sroa = true;
                        }
                    }

                    unsafe {
                        (*sp).promoted = true;
                        (*sp).promoted_local = promo_id.v;
                    }
                    stats.promoted_bytes = stats.promoted_bytes + sz_b;
                    let act: u8 = if did_sroa {
                        stats.box_sroa_promotions = stats.box_sroa_promotions + 1u32;
                        PROMOTE_ACTION_BOX_SROA
                    } else if akind == ALLOC_KIND_BOUNDED_BUF {
                        stats.inline_buffer_promotions = stats.inline_buffer_promotions + 1u32;
                        PROMOTE_ACTION_INLINE_BUF
                    } else {
                        stats.box_stack_promotions = stats.box_stack_promotions + 1u32;
                        PROMOTE_ACTION_BOX_STACK
                    };
                    escape_log_push(log, mut_view(*arena), EscapePromoteRecord {
                        is_barrier: false,
                        action: act,
                        storage_decision: sdec,
                        reason: rsn,
                        bb_idx: abb_idx,
                        local_id: dloc,
                        promoted_local: promo_id.v,
                        size_bytes: sz_b,
                    });
                    changed = true;
                }
            }
        } else if akind == ALLOC_KIND_BOX_NEW &&
                  (abb_idx as usize) < mir.bb_count && (dloc as usize) < mir.local_count &&
                  (opt_body.thir as usize) != 0 && (unsafe { (*sp).payload_ty.v }) != 0u32 &&
                  (unsafe { (*sp).has_matching_free }) {
            let lp = unsafe { escape_local_at(info.locals, dloc as usize) };
            let abb = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
            if !(unsafe { (*lp).mut_borrow_taken }) &&
               esc_mir_box_no_whole_value_transfer(view(*mir), dloc, abb_idx) &&
               (unsafe { (*abb).terminator.kind }) == MIR_TERM_CALL &&
               (unsafe { (*abb).terminator.has_destination }) &&
               (unsafe { (*abb).terminator.destination.local.v }) == dloc &&
               (unsafe { (*abb).terminator.destination.proj_count }) == 0 &&
               (unsafe { (*abb).terminator.arg_count }) == 1 &&
               (unsafe { (*abb).terminator.args as usize }) != 0 {
                let box_ty = TypeId { v: unsafe { (*mir_local_at(mir.locals, dloc as usize)).ty.v } };
                let btp = type_get(unsafe { view((*opt_body.thir).interner) }, box_ty);
                let b_fcnt: usize = if (btp as usize) != 0 { unsafe { (*btp).field_count } } else { 0 };
                if (btp as usize) != 0 && (b_fcnt == 1 || b_fcnt == 2) && (unsafe { (*btp).fields as usize }) != 0 {
                    let ptr_ty = TypeId { v: unsafe { (*typeid_at((*btp).fields, 0)).v } };
                    let pty = TypeId { v: unsafe { (*sp).payload_ty.v } };
                    let sp_loc = unsafe { (*abb).terminator.span };
                    let next_bb = MirBbId { v: unsafe { (*abb).terminator.call_target.v } };
                    let mut init_val_op = mir_op_const_int(0u32, 0u64);
                    let init_arg0_p = unsafe { mir_op_at((*abb).terminator.args, 0) };
                    unsafe {
                        mir_copy_operand(mut_view(init_val_op), view(*init_arg0_p));
                    }

                    let can_sroa = sdec == STORAGE_DECISION_SSA_REGISTER &&
                                   esc_can_sroa_box_new(view(*mir), opt_body, dloc, abb_idx);

                    let promo_id = mir_add_local(
                        mut_view(*mir),
                        mut_view(*arena),
                        pty,
                        MIR_LOCAL_TEMP,
                        true,
                        StrId { v: 0u32 },
                        view(sp_loc)
                    );

                    // 1. `_promo_slot = use(val_op)`
                    let abb2 = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                    let mut val_st = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
                    mir_stmt_reset(mut_view(val_st), MIR_STMT_ASSIGN, view(sp_loc));
                    val_st.place = mir_local_place(promo_id.v);
                    mir_rvalue_reset(mut_view(val_st.rvalue), MIR_RVALUE_USE);
                    mir_copy_operand(mut_view(val_st.rvalue.use_op), view(init_val_op));
                    mir_bb_push_stmt(unsafe { mut_view(*abb2) }, mut_view(*arena), view(val_st));

                    if can_sroa {
                        mir_term_reset(unsafe { mut_view((*abb2).terminator) }, MIR_TERM_GOTO, view(sp_loc));
                        unsafe { (*abb2).terminator.goto_target.v = next_bb.v; }

                        // Rewrite every `_ptr_tmp = _box.0` + `*_ptr_tmp` directly to `promo_id`!
                        let mut sb: usize = 0;
                        while sb < mir.bb_count {
                            let sblk = unsafe { mir_bb_at(mir.bbs, sb) };
                            let mut ss: usize = 0;
                            while ss < (unsafe { (*sblk).stmt_count }) {
                                let st = unsafe { mir_stmt_at((*sblk).stmts, ss) };
                                if (unsafe { (*st).kind }) == MIR_STMT_ASSIGN &&
                                   (unsafe { (*st).rvalue.kind }) == MIR_RVALUE_USE &&
                                   ((unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_COPY || (unsafe { (*st).rvalue.use_op.kind }) == MIR_OP_MOVE) &&
                                   (unsafe { (*st).rvalue.use_op.place.local.v }) == dloc &&
                                   (unsafe { (*st).rvalue.use_op.place.proj_count }) == 1 {
                                    let ptmp = unsafe { (*st).place.local.v };
                                    esc_mir_remove_stmt_at(unsafe { mut_view(*sblk) }, ss);
                                    esc_rewrite_deref_of_ptr_to_slot(mut_view(*mir), ptmp, promo_id.v, mut_view(*arena));
                                    continue;
                                }
                                ss = ss + 1;
                            }
                            sb = sb + 1;
                        }
                    } else {
                        let ptr_tmp = mir_add_local(
                            mut_view(*mir),
                            mut_view(*arena),
                            ptr_ty,
                            MIR_LOCAL_TEMP,
                            true,
                            StrId { v: 0u32 },
                            view(sp_loc)
                        );
                        let abb3 = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                        // 2. `_ptr_tmp = &mut _promo_slot`
                        let mut ref_st = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
                        mir_stmt_reset(mut_view(ref_st), MIR_STMT_ASSIGN, view(sp_loc));
                        ref_st.place = mir_local_place(ptr_tmp.v);
                        mir_rvalue_reset(mut_view(ref_st.rvalue), MIR_RVALUE_REF);
                        ref_st.rvalue.borrow_kind = MIR_BORROW_MUT;
                        ref_st.rvalue.place = mir_local_place(promo_id.v);
                        mir_bb_push_stmt(unsafe { mut_view(*abb3) }, mut_view(*arena), view(ref_st));

                        // 3. `_box = Box { ptr: move _ptr_tmp[, _glue: zst] }`
                        let agg_ops = arena_alloc_raw(mut_view(*arena), esc_mul_usize(b_fcnt, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
                        unsafe { *mir_op_at(agg_ops, 0) = mir_op_move_local(ptr_tmp.v); }
                        if b_fcnt == 2 {
                            let zst_ty = TypeId { v: unsafe { (*typeid_at((*btp).fields, 1)).v } };
                            let zst_tmp = mir_add_local(
                                mut_view(*mir),
                                mut_view(*arena),
                                zst_ty,
                                MIR_LOCAL_TEMP,
                                true,
                                StrId { v: 0u32 },
                                view(sp_loc)
                            );
                            let abb3_z = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                            let mut zst_st = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
                            mir_stmt_reset(mut_view(zst_st), MIR_STMT_ASSIGN, view(sp_loc));
                            zst_st.place = mir_local_place(zst_tmp.v);
                            mir_rvalue_reset(mut_view(zst_st.rvalue), MIR_RVALUE_AGGREGATE);
                            mir_bb_push_stmt(unsafe { mut_view(*abb3_z) }, mut_view(*arena), view(zst_st));
                            unsafe { *mir_op_at(agg_ops, 1) = mir_op_move_local(zst_tmp.v); }
                        }
                        let abb3_b = unsafe { mir_bb_at(mir.bbs, abb_idx as usize) };
                        let mut box_st = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
                        mir_stmt_reset(mut_view(box_st), MIR_STMT_ASSIGN, view(sp_loc));
                        box_st.place = mir_local_place(dloc);
                        mir_rvalue_reset(mut_view(box_st.rvalue), MIR_RVALUE_AGGREGATE);
                        box_st.rvalue.operands = agg_ops;
                        box_st.rvalue.operand_count = b_fcnt;
                        mir_bb_push_stmt(unsafe { mut_view(*abb3_b) }, mut_view(*arena), view(box_st));

                        mir_term_reset(unsafe { mut_view((*abb3_b).terminator) }, MIR_TERM_GOTO, view(sp_loc));
                        unsafe { (*abb3_b).terminator.goto_target.v = next_bb.v; }
                    }

                    // 4. Redirect ALL `MIR_TERM_DROP(_box)` & `MIR_STMT_DROP(_box)` (normal & unwind!) to `_promo_slot`
                    let mut db: usize = 0;
                    while db < mir.bb_count {
                        let dblk = unsafe { mir_bb_at(mir.bbs, db) };
                        let mut ds: usize = 0;
                        while ds < (unsafe { (*dblk).stmt_count }) {
                            let dst_st = unsafe { mir_stmt_at((*dblk).stmts, ds) };
                            if (unsafe { (*dst_st).kind }) == MIR_STMT_DROP &&
                               (unsafe { (*dst_st).place.local.v }) == dloc &&
                               (unsafe { (*dst_st).place.proj_count }) == 0 {
                                unsafe { (*dst_st).place.local.v = promo_id.v; }
                            }
                            ds = ds + 1;
                        }
                        if (unsafe { (*dblk).terminator.kind }) == MIR_TERM_DROP &&
                           (unsafe { (*dblk).terminator.drop_place.local.v }) == dloc &&
                           (unsafe { (*dblk).terminator.drop_place.proj_count }) == 0 {
                            unsafe { (*dblk).terminator.drop_place.local.v = promo_id.v; }
                        }
                        db = db + 1;
                    }

                    unsafe {
                        (*sp).promoted = true;
                        (*sp).promoted_local = promo_id.v;
                    }
                    stats.promoted_bytes = stats.promoted_bytes + sz_b;
                    let act: u8 = if can_sroa {
                        stats.box_sroa_promotions = stats.box_sroa_promotions + 1u32;
                        PROMOTE_ACTION_BOX_SROA
                    } else {
                        stats.box_stack_promotions = stats.box_stack_promotions + 1u32;
                        PROMOTE_ACTION_BOX_STACK
                    };
                    escape_log_push(log, mut_view(*arena), EscapePromoteRecord {
                        is_barrier: false,
                        action: act,
                        storage_decision: sdec,
                        reason: rsn,
                        bb_idx: abb_idx,
                        local_id: dloc,
                        promoted_local: promo_id.v,
                        size_bytes: sz_b,
                    });
                    changed = true;
                }
            }
        } else if akind == ALLOC_KIND_CLOSURE_ENV && sdec == STORAGE_DECISION_ELIMINATED {
            if esc_try_promote_closure_site(mut_view(*mir), opt_body, view(*info), dloc, abb_idx, mut_view(*stats), mut_view(*arena)) {
                unsafe {
                    (*sp).promoted = true;
                    (*sp).promoted_local = ESC_NONE_IDX;
                }
                stats.promoted_bytes = stats.promoted_bytes + sz_b;
                escape_log_push(log, mut_view(*arena), EscapePromoteRecord {
                    is_barrier: false,
                    action: PROMOTE_ACTION_CLOSURE_ELIM,
                    storage_decision: STORAGE_DECISION_ELIMINATED,
                    reason: rsn,
                    bb_idx: abb_idx,
                    local_id: dloc,
                    promoted_local: ESC_NONE_IDX,
                    size_bytes: sz_b,
                });
                changed = true;
            }
        }
        si = si + 1;
    }

    if esc_try_promote_nrvo(mut_view(*mir), view(*info), mut_view(*stats), log, mut_view(*arena)) {
        changed = true;
    }
    changed
}


// --- `PassManager` Contract-Checked Orchestrator & Pipeline (`SPEC-71 AXS-ESC-016`) ---

fn esc_zero_bytes(ptr: *mut u8, byte_len: usize) {
    let mut i: usize = 0;
    while i < byte_len {
        unsafe {
            *esc_u8_at(ptr, i) = 0u8;
        }
        i = i + 1;
    }
}

fn esc_mir_effective_arg_count(mir: view<MirBody>) -> usize {
    let mut argc = mir.arg_count;
    if argc + 1 > mir.local_count {
        argc = if mir.local_count > 0 { mir.local_count - 1 } else { 0 };
    }
    if (mir.locals as usize) != 0 {
        let mut scan: usize = 0;
        let mut l: usize = 1;
        while l < mir.local_count {
            if (unsafe { (*mir_local_at(mir.locals, l)).kind }) == MIR_LOCAL_ARG {
                scan = l;
                l = l + 1;
            } else {
                break;
            }
        }
        if scan > argc {
            argc = scan;
        }
    }
    argc
}

fn esc_opt_body_has_args(body: view<OptBody>) -> bool {
    if body.arg_count > 0 {
        return true;
    }
    if (body.orig_mir as usize) != 0 {
        return esc_mir_effective_arg_count(unsafe { view(*body.orig_mir) }) > 0;
    }
    false
}

fn esc_ensure_fn_item_for_mir(
    mir: view<MirBody>,
    fn_item: *const HirItem,
    arena: mut_view<Arena>
) -> *const HirItem {
    if (fn_item as usize) != 0 {
        return fn_item;
    }
    let argc = esc_mir_effective_arg_count(mir);
    if argc == 0 {
        return 0 as *const HirItem;
    }
    let item_ptr = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    esc_zero_bytes(item_ptr as *mut u8, size_of<HirItem>());
    let dummy_ty = arena_alloc_raw(mut_view(*arena), size_of<HirType>(), align_of<HirType>()) as *mut HirType;
    esc_zero_bytes(dummy_ty as *mut u8, size_of<HirType>());
    unsafe {
        (*dummy_ty).kind = HIR_TYPE_PATH;
        (*item_ptr).kind = HIR_ITEM_FN;
        (*item_ptr).symbol = SymbolId { v: mir.fn_sym.v };
        (*item_ptr).name = StrId { v: mir.fn_name.v };
        (*item_ptr).span = mir.span;
        (*item_ptr).ret_type = dummy_ty;
    }
    let mut head: *mut HirParam = 0 as *mut HirParam;
    let mut tail: *mut HirParam = 0 as *mut HirParam;
    let mut p: usize = 0;
    while p < argc {
        let param_ptr = arena_alloc_raw(mut_view(*arena), size_of<HirParam>(), align_of<HirParam>()) as *mut HirParam;
        esc_zero_bytes(param_ptr as *mut u8, size_of<HirParam>());
        unsafe {
            (*param_ptr).ty = dummy_ty;
            if (head as usize) == 0 {
                head = param_ptr;
                tail = param_ptr;
            } else {
                (*tail).next = param_ptr;
                tail = param_ptr;
            }
        }
        p = p + 1;
    }
    unsafe {
        (*item_ptr).params = head;
    }
    item_ptr as *const HirItem
}

fn esc_bitset_get(bits: *const u64, bit_idx: usize, local_count: usize) -> bool {
    if (bits as usize) == 0 || bit_idx >= local_count {
        return false;
    }
    let w = bit_idx / 64;
    let sh = (bit_idx % 64) as u64;
    let word = unsafe { *esc_u64_at(bits as *mut u64, w) };
    ((word >> sh) & 1u64) != 0u64
}

fn esc_bitset_set(bits: *mut u64, bit_idx: usize, local_count: usize) {
    if (bits as usize) == 0 || bit_idx >= local_count {
        return;
    }
    let w = bit_idx / 64;
    let sh = (bit_idx % 64) as u64;
    unsafe {
        let wp = esc_u64_at(bits, w);
        *wp = (*wp) | (1u64 << sh);
    }
}

fn esc_prop_bb_bits(
    bb_in: *mut u64,
    cur: *const u64,
    target_v: u32,
    bb_count: usize,
    words: usize
) -> bool {
    if (target_v as usize) >= bb_count || words == 0 {
        return false;
    }
    let mut changed = false;
    let base = esc_mul_usize(target_v as usize, words);
    let mut w: usize = 0;
    while w < words {
        let dp = unsafe { esc_u64_at(bb_in, base + w) };
        let old_v = unsafe { *dp };
        let cur_v = unsafe { *esc_u64_at(cur as *mut u64, w) };
        let new_v = old_v & cur_v;
        if new_v != old_v {
            unsafe {
                *dp = new_v;
            }
            changed = true;
        }
        w = w + 1;
    }
    changed
}

fn esc_mir_return_is_unit_or_error(mir: view<MirBody>, thir: *const Thir) -> bool {
    if mir.local_count == 0 || (mir.locals as usize) == 0 {
        return false;
    }
    if (thir as usize) == 0 {
        return false;
    }
    let loc0_ty = TypeId { v: unsafe { (*mir_local_at(mir.locals, 0)).ty.v } };
    let ret_t = verify_safe_type_get(unsafe { view((*thir).interner) }, loc0_ty);
    if (ret_t as usize) == 0 {
        return true;
    }
    let rk = unsafe { (*ret_t).kind };
    rk == TY_UNIT || rk == TY_ERROR
}

fn esc_check_proj_indices_init(pl: view<MirPlace>, cur: *const u64, local_count: usize) -> bool {
    let mut p: usize = 0;
    while p < pl.proj_count && (pl.projs as usize) != 0 {
        let pr = unsafe { mir_proj_at(pl.projs, p) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX {
            if !esc_bitset_get(cur, (unsafe { (*pr).index_local.v }) as usize, local_count) {
                return false;
            }
        } else if pk == MIR_PROJ_SUB_SLICE {
            if (unsafe { (*pr).has_from }) &&
               !esc_bitset_get(cur, (unsafe { (*pr).from_local.v }) as usize, local_count) {
                return false;
            }
            if (unsafe { (*pr).has_to }) &&
               !esc_bitset_get(cur, (unsafe { (*pr).to_local.v }) as usize, local_count) {
                return false;
            }
        }
        p = p + 1;
    }
    true
}

fn esc_check_op_init(op: view<MirOperand>, cur: *const u64, local_count: usize) -> bool {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        if !esc_bitset_get(cur, op.place.local.v as usize, local_count) {
            return false;
        }
        if !esc_check_proj_indices_init(view(op.place), cur, local_count) {
            return false;
        }
    }
    true
}

fn esc_verify_mir_definite_init(mir: view<MirBody>, thir: *const Thir, arena: mut_view<Arena>) -> bool {
    if mir.bb_count == 0 || mir.local_count == 0 || (mir.bbs as usize) == 0 || (mir.locals as usize) == 0 {
        return true;
    }
    let local_count = mir.local_count;
    let words = (local_count + 63) / 64;
    if words == 0 {
        return true;
    }
    let total_words = esc_mul_usize(mir.bb_count, words);
    let bb_in = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(total_words, size_of<u64>()),
        align_of<u64>()
    ) as *mut u64;
    let bb_out = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(total_words, size_of<u64>()),
        align_of<u64>()
    ) as *mut u64;
    let cur = arena_alloc_raw(
        mut_view(*arena),
        esc_mul_usize(words, size_of<u64>()),
        align_of<u64>()
    ) as *mut u64;

    let mut wi: usize = 0;
    while wi < total_words {
        unsafe {
            *esc_u64_at(bb_in, wi) = 0xFFFFFFFFFFFFFFFFu64;
            *esc_u64_at(bb_out, wi) = 0xFFFFFFFFFFFFFFFFu64;
        }
        wi = wi + 1;
    }
    let mut w0: usize = 0;
    while w0 < words {
        unsafe {
            *esc_u64_at(bb_in, w0) = 0u64;
            *esc_u64_at(cur, w0) = 0u64;
        }
        w0 = w0 + 1;
    }

    let argc = esc_mir_effective_arg_count(mir);
    let mut p: usize = 1;
    while p <= argc && p < local_count {
        esc_bitset_set(bb_in, p, local_count);
        p = p + 1;
    }
    let mut cl: usize = 0;
    while cl < local_count {
        let lk = unsafe { (*mir_local_at(mir.locals, cl)).kind };
        if lk == MIR_LOCAL_CONST || lk == MIR_LOCAL_ARG {
            esc_bitset_set(bb_in, cl, local_count);
        }
        cl = cl + 1;
    }
    if esc_mir_return_is_unit_or_error(mir, thir) {
        esc_bitset_set(bb_in, 0, local_count);
    }

    // Forward intersection fixed-point matching `verify_mir_init_pass`
    let mut changed = true;
    while changed {
        changed = false;
        let mut bi: usize = 0;
        while bi < mir.bb_count {
            let bb = unsafe { mir_bb_at(mir.bbs, bi) };
            let off = esc_mul_usize(bi, words);
            let mut cw: usize = 0;
            while cw < words {
                unsafe {
                    *esc_u64_at(cur, cw) = *esc_u64_at(bb_in, off + cw);
                }
                cw = cw + 1;
            }
            let scnt = unsafe { (*bb).stmt_count };
            let mut si: usize = 0;
            while si < scnt {
                let st = unsafe { mir_stmt_at((*bb).stmts, si) };
                if (unsafe { (*st).kind }) == MIR_STMT_ASSIGN {
                    esc_bitset_set(cur, (unsafe { (*st).place.local.v }) as usize, local_count);
                }
                si = si + 1;
            }
            if (unsafe { (*bb).has_terminator }) && (unsafe { (*bb).terminator.kind }) == MIR_TERM_CALL {
                if (unsafe { (*bb).terminator.has_destination }) || (unsafe { (*bb).terminator.destination.local.v }) != 0u32 {
                    esc_bitset_set(cur, (unsafe { (*bb).terminator.destination.local.v }) as usize, local_count);
                }
            }
            let mut eq = true;
            let mut ew: usize = 0;
            while ew < words {
                if (unsafe { *esc_u64_at(cur, ew) }) != (unsafe { *esc_u64_at(bb_out, off + ew) }) {
                    eq = false;
                }
                ew = ew + 1;
            }
            if !eq {
                let mut sw: usize = 0;
                while sw < words {
                    unsafe {
                        *esc_u64_at(bb_out, off + sw) = *esc_u64_at(cur, sw);
                    }
                    sw = sw + 1;
                }
                changed = true;
            }
            if unsafe { (*bb).has_terminator } {
                let tk = unsafe { (*bb).terminator.kind };
                if tk == MIR_TERM_GOTO {
                    if esc_prop_bb_bits(bb_in, cur as *const u64, unsafe { (*bb).terminator.goto_target.v }, mir.bb_count, words) {
                        changed = true;
                    }
                } else if tk == MIR_TERM_SWITCH_INT {
                    let sc = unsafe { (*bb).terminator.switch_count };
                    let tgts = unsafe { (*bb).terminator.targets };
                    let mut k: usize = 0;
                    while k < sc && (tgts as usize) != 0 {
                        let tid = unsafe { (*mir_bb_id_at(tgts, k)).v };
                        if esc_prop_bb_bits(bb_in, cur as *const u64, tid, mir.bb_count, words) {
                            changed = true;
                        }
                        k = k + 1;
                    }
                    if esc_prop_bb_bits(bb_in, cur as *const u64, unsafe { (*bb).terminator.otherwise.v }, mir.bb_count, words) {
                        changed = true;
                    }
                } else if tk == MIR_TERM_DROP {
                    if esc_prop_bb_bits(bb_in, cur as *const u64, unsafe { (*bb).terminator.drop_target.v }, mir.bb_count, words) {
                        changed = true;
                    }
                    let du = unsafe { (*bb).terminator.drop_unwind.v };
                    if du > 0u32 && esc_prop_bb_bits(bb_in, cur as *const u64, du, mir.bb_count, words) {
                        changed = true;
                    }
                } else if tk == MIR_TERM_CALL {
                    if esc_prop_bb_bits(bb_in, cur as *const u64, unsafe { (*bb).terminator.call_target.v }, mir.bb_count, words) {
                        changed = true;
                    }
                    let cu = unsafe { (*bb).terminator.call_unwind.v };
                    if cu > 0u32 && esc_prop_bb_bits(bb_in, cur as *const u64, cu, mir.bb_count, words) {
                        changed = true;
                    }
                } else if tk == MIR_TERM_ASSERT {
                    if esc_prop_bb_bits(bb_in, cur as *const u64, unsafe { (*bb).terminator.assert_target.v }, mir.bb_count, words) {
                        changed = true;
                    }
                    let au = unsafe { (*bb).terminator.assert_unwind.v };
                    if au > 0u32 && esc_prop_bb_bits(bb_in, cur as *const u64, au, mir.bb_count, words) {
                        changed = true;
                    }
                }
            }
            bi = bi + 1;
        }
    }

    // Check every statement and terminator read against `cur`
    let mut cb: usize = 0;
    while cb < mir.bb_count {
        let bb = unsafe { mir_bb_at(mir.bbs, cb) };
        let off = esc_mul_usize(cb, words);
        let mut cw: usize = 0;
        while cw < words {
            unsafe {
                *esc_u64_at(cur, cw) = *esc_u64_at(bb_in, off + cw);
            }
            cw = cw + 1;
        }
        let scnt = unsafe { (*bb).stmt_count };
        let mut si: usize = 0;
        while si < scnt {
            let st = unsafe { mir_stmt_at((*bb).stmts, si) };
            let sk = unsafe { (*st).kind };
            if sk == MIR_STMT_ASSIGN {
                let dst = unsafe { view((*st).place) };
                if !esc_check_proj_indices_init(dst, cur as *const u64, local_count) {
                    return false;
                }
                if dst.proj_count > 0 && (dst.projs as usize) != 0 &&
                   (unsafe { (*mir_proj_at(dst.projs, 0)).kind }) == MIR_PROJ_DEREF {
                    if !esc_bitset_get(cur as *const u64, dst.local.v as usize, local_count) {
                        return false;
                    }
                }
                let rv = unsafe { view((*st).rvalue) };
                let rvk = rv.kind;
                if rvk == MIR_RVALUE_REPEAT && (rv.repeat_count_op as usize) != 0 {
                    if !esc_check_op_init(unsafe { view(*rv.repeat_count_op) }, cur as *const u64, local_count) {
                        return false;
                    }
                }
                if esc_rvalue_has_use_op(rvk) {
                    if !esc_check_op_init(view(rv.use_op), cur as *const u64, local_count) {
                        return false;
                    }
                } else if esc_rvalue_has_bin_ops(rvk) {
                    if !esc_check_op_init(view(rv.lhs), cur as *const u64, local_count) ||
                       !esc_check_op_init(view(rv.rhs), cur as *const u64, local_count) {
                        return false;
                    }
                } else if rvk == MIR_RVALUE_REF || rvk == MIR_RVALUE_LEN || rvk == MIR_RVALUE_DISCRIMINANT {
                    if !esc_check_proj_indices_init(view(rv.place), cur as *const u64, local_count) {
                        return false;
                    }
                    if rvk == MIR_RVALUE_DISCRIMINANT {
                        if !esc_bitset_get(cur as *const u64, rv.place.local.v as usize, local_count) {
                            return false;
                        }
                    } else if rv.place.proj_count > 0 && (rv.place.projs as usize) != 0 &&
                              (unsafe { (*mir_proj_at(rv.place.projs, 0)).kind }) == MIR_PROJ_DEREF {
                        if !esc_bitset_get(cur as *const u64, rv.place.local.v as usize, local_count) {
                            return false;
                        }
                    }
                } else if rvk == MIR_RVALUE_AGGREGATE {
                    let mut ao: usize = 0;
                    while ao < rv.operand_count && (rv.operands as usize) != 0 {
                        let op_p = unsafe { mir_op_at(rv.operands, ao) };
                        if !esc_check_op_init(unsafe { view(*op_p) }, cur as *const u64, local_count) {
                            return false;
                        }
                        ao = ao + 1;
                    }
                }
                esc_bitset_set(cur, dst.local.v as usize, local_count);
            } else if sk == MIR_STMT_DROP {
                let dpl = unsafe { view((*st).place) };
                if !esc_check_proj_indices_init(dpl, cur as *const u64, local_count) {
                    return false;
                }
                if dpl.drop_flag == MIR_DROP_FLAG_NONE && mir.drop_flag_count == 0 {
                    if !esc_bitset_get(cur as *const u64, dpl.local.v as usize, local_count) {
                        return false;
                    }
                }
            }
            si = si + 1;
        }

        if !(unsafe { (*bb).has_terminator }) {
            return false;
        }
        let tm = unsafe { view((*bb).terminator) };
        if tm.kind == MIR_TERM_SWITCH_INT {
            if !esc_check_op_init(view(tm.discr), cur as *const u64, local_count) {
                return false;
            }
        } else if tm.kind == MIR_TERM_ASSERT {
            if !esc_check_op_init(view(tm.cond), cur as *const u64, local_count) {
                return false;
            }
        } else if tm.kind == MIR_TERM_DROP {
            if !esc_check_proj_indices_init(view(tm.drop_place), cur as *const u64, local_count) {
                return false;
            }
            if tm.drop_flag == MIR_DROP_FLAG_NONE && mir.drop_flag_count == 0 {
                if !esc_bitset_get(cur as *const u64, tm.drop_place.local.v as usize, local_count) {
                    return false;
                }
            }
        } else if tm.kind == MIR_TERM_CALL {
            if !esc_check_op_init(view(tm.func), cur as *const u64, local_count) {
                return false;
            }
            let mut ai: usize = 0;
            while ai < tm.arg_count && (tm.args as usize) != 0 {
                let ap = unsafe { mir_op_at(tm.args, ai) };
                if !esc_check_op_init(unsafe { view(*ap) }, cur as *const u64, local_count) {
                    return false;
                }
                ai = ai + 1;
            }
            if tm.has_destination {
                if !esc_check_proj_indices_init(view(tm.destination), cur as *const u64, local_count) {
                    return false;
                }
                if tm.destination.proj_count > 0 && (tm.destination.projs as usize) != 0 &&
                   (unsafe { (*mir_proj_at(tm.destination.projs, 0)).kind }) == MIR_PROJ_DEREF {
                    if !esc_bitset_get(cur as *const u64, tm.destination.local.v as usize, local_count) {
                        return false;
                    }
                }
            }
        } else if tm.kind == MIR_TERM_RETURN && local_count > 0 {
            if !esc_bitset_get(cur as *const u64, 0, local_count) {
                return false;
            }
        }
        cb = cb + 1;
    }
    true
}

fn esc_verify_mir_body_complete(
    mir: view<MirBody>,
    thir: *const Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let prev_errs = sink.errors;
    let eff_fn = esc_ensure_fn_item_for_mir(mir, 0 as *const HirItem, mut_view(*arena));
    verify_mir(mir, thir, mut_view(*sink), eff_fn);
    if sink.errors != prev_errs {
        return false;
    }
    if (eff_fn as usize) != 0 {
        if !esc_verify_mir_definite_init(mir, thir, mut_view(*arena)) {
            return false;
        }
    }
    true
}

fn esc_verify_body_capabilities(body: view<OptBody>) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count && (body.blocks as usize) != 0 {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let dlv = (unsafe { (*inst).place.local.v }) as usize;
                if dlv < body.local_count && (body.local_tys as usize) != 0 && (body.thir as usize) != 0 {
                    let lty = unsafe { *opt_typeid_at(body.local_tys, dlv) };
                    let lt = verify_safe_type_get(unsafe { view((*body.thir).interner) }, lty);
                    if (lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_VIEW {
                        if (unsafe { (*inst).place.view_kind }) == MIR_VIEW_MUT {
                            return false;
                        }
                        if opc == OPT_INST_STORE && (unsafe { (*inst).place.proj_count }) > 0 {
                            return false;
                        }
                    }
                }
                let rlv = (unsafe { (*inst).rhs_place.local.v }) as usize;
                if rlv < body.local_count && (body.local_tys as usize) != 0 && (body.thir as usize) != 0 {
                    let rty = unsafe { *opt_typeid_at(body.local_tys, rlv) };
                    let rt = verify_safe_type_get(unsafe { view((*body.thir).interner) }, rty);
                    if (rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_VIEW {
                        if (unsafe { (*inst).rhs_place.view_kind }) == MIR_VIEW_MUT {
                            return false;
                        }
                        if opc == OPT_INST_ADDR_OF && (unsafe { (*inst).sub_op }) == MIR_VIEW_MUT {
                            return false;
                        }
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    true
}

fn esc_verify_postconditions_arg_aware(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    pass_id: u16,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> u8 {
    if !esc_opt_body_has_args(view(*body)) {
        let pm_pass: u16 = if pass_id == PASS_ESCAPE_PROMOTE { PASS_GVN_CSE } else { pass_id };
        return passmgr_verify_postconditions(mut_view(*pm), mut_view(*body), pm_pass, mut_view(*arena), mut_view(*sink));
    }
    let contract = if pass_id == PASS_ESCAPE_PROMOTE {
        escape_contract()
    } else {
        passmgr_contract_for_pass(pass_id)
    };
    pm.verify_run_count = pm.verify_run_count + 1u32;

    if (contract.postconditions & (POSTCOND_CFG_VALID | POSTCOND_DOM_VALID | POSTCOND_SSA_VALID | POSTCOND_MEMSSA_VALID)) != 0u32 {
        let inv_mask = contract.invalidated_analyses & (ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA);
        if inv_mask != 0u32 {
            passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), inv_mask);
        }
        if !optir_verify_contract(view(*body)) {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_POSTCOND_CFG_DOM;
            return CONTRACT_ERR_POSTCOND_CFG_DOM;
        }
    }

    if (contract.postconditions & POSTCOND_CAPABILITY_PRESERVED) != 0u32 {
        if !esc_verify_body_capabilities(view(*body)) {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_CAPABILITY_PROMOTION;
            return CONTRACT_ERR_CAPABILITY_PROMOTION;
        }
    }

    if (contract.postconditions & POSTCOND_EFFECTS_PRESERVED) != 0u32 {
        let cur_eff = effect_infer_body(mut_view(*body), mut_view(*arena), pm.budget.max_symbolic_steps);
        pm.last_effect_summary = cur_eff;
        if pm.has_baseline_effects {
            let cur_vol = cur_eff.volatile_count;
            let base_vol = pm.baseline_effect_summary.volatile_count;
            let cur_ato = cur_eff.atomic_count;
            let base_ato = pm.baseline_effect_summary.atomic_count;
            let cur_io = cur_eff.io_count;
            let base_io = pm.baseline_effect_summary.io_count;
            let cur_drp = cur_eff.drop_count;
            let base_drp = pm.baseline_effect_summary.drop_count;
            if cur_vol < base_vol || cur_ato < base_ato || cur_io < base_io || cur_drp < base_drp {
                pm.verify_fail_count = pm.verify_fail_count + 1u32;
                pm.last_verify_status = CONTRACT_ERR_POSTCOND_EFFECTS;
                return CONTRACT_ERR_POSTCOND_EFFECTS;
            }
        }
    }

    if (contract.postconditions & POSTCOND_VERIFIED_MIR) != 0u32 {
        let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
        if !optir_reconstruct_mir(view(*body), unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_POSTCOND_MIR_VERIFY;
            return CONTRACT_ERR_POSTCOND_MIR_VERIFY;
        }
        let prev_errs = sink.errors;
        let ok = esc_verify_mir_body_complete(unsafe { view(*rec_mir) }, body.thir, mut_view(*arena), mut_view(*sink));
        if !ok || sink.errors != prev_errs {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_POSTCOND_MIR_VERIFY;
            return CONTRACT_ERR_POSTCOND_MIR_VERIFY;
        }
    }

    pm.last_verify_status = CONTRACT_OK;
    CONTRACT_OK
}

pub fn escape_run_pass_internal(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    info: mut_view<EscapeInfo>,
    call_table: *const EffectCallTable,
    summary_table: *const EscapeSummaryTable,
    stats: mut_view<EscapePromoteStats>,
    log: *mut EscapePromoteLog,
    force_verify_fail: bool,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let _ct = call_table;
    if pm.budget.profile == OPT_PROFILE_DEBUG_O0 {
        return false;
    }
    let contract = escape_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let pre_body = *body;
    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_base_flags = pm.baseline_effect_summary.flags;
    let pre_has_base = pm.has_baseline_effects;
    let pre_stats = *stats;
    let pre_log_cnt: usize = if (log as usize) != 0 { unsafe { (*log).count } } else { 0 };
    let pre_sink_errs = sink.errors;

    stats.pass_runs = stats.pass_runs + 1u32;

    let work_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(view(*body), unsafe { mut_view(*work_mir) }, mut_view(*arena)) {
        return false;
    }

    let changed = escape_promote_mir(
        unsafe { mut_view(*work_mir) },
        view(*body),
        mut_view(*info),
        summary_table,
        mut_view(*stats),
        log,
        mut_view(*arena)
    );

    if changed {
        let mir_ok = esc_verify_mir_body_complete(
            unsafe { view(*work_mir) },
            body.thir,
            mut_view(*arena),
            mut_view(*sink)
        );
        if !mir_ok || sink.errors != pre_sink_errs {
            sink.errors = pre_sink_errs;
            *body = pre_body;
            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
            pm.ir_revision = pre_rev;
            pm.valid_analyses = pre_valid;
            pm.baseline_effect_summary.flags = pre_base_flags;
            pm.has_baseline_effects = pre_has_base;
            *stats = pre_stats;
            stats.pass_runs = pre_stats.pass_runs + 1u32;
            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
            if (log as usize) != 0 {
                unsafe { (*log).count = pre_log_cnt; }
            }
            return false;
        }

        let new_ob = optir_build_from_verified_mir(unsafe { view(*work_mir) }, body.thir, mut_view(*arena));
        if (new_ob as usize) == 0 {
            *body = pre_body;
            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
            pm.ir_revision = pre_rev;
            pm.valid_analyses = pre_valid;
            *stats = pre_stats;
            stats.pass_runs = pre_stats.pass_runs + 1u32;
            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
            if (log as usize) != 0 {
                unsafe { (*log).count = pre_log_cnt; }
            }
            return false;
        }

        // Preserve prior `ProofProvenance` and record `PROP_NO_ESCAPE` provenance for promoted sites
        let mut pi: usize = 0;
        while pi < pre_body.provenance_count && (pre_body.provenance as usize) != 0 {
            let pp = unsafe { opt_prov_at(pre_body.provenance, pi) };
            optir_record_provenance(
                unsafe { mut_view(*new_ob) },
                mut_view(*arena),
                unsafe { (*pp).prop_kind },
                unsafe { (*pp).certainty },
                unsafe { (*pp).source_analysis },
                unsafe { (*pp).subject_val },
                unsafe { (*pp).aux_val },
                unsafe { (*pp).at_bb },
                unsafe { (*pp).at_inst },
                unsafe { (*pp).pass_id }
            );
            pi = pi + 1;
        }
        let mut psi: usize = 0;
        while psi < info.site_count {
            let sp = unsafe { escape_site_at(info.sites, psi) };
            if unsafe { (*sp).promoted } {
                optir_record_provenance(
                    unsafe { mut_view(*new_ob) },
                    mut_view(*arena),
                    PROP_NO_ESCAPE,
                    CERTAINTY_PROVEN,
                    ANALYSIS_ESCAPE_INFO,
                    OptValueId { v: 0u32 },
                    OptValueId { v: 0u32 },
                    OptBbId { v: unsafe { (*sp).alloc_bb } },
                    OptInstId { v: 0u32 },
                    PASS_ESCAPE_PROMOTE
                );
            }
            psi = psi + 1;
        }

        *body = unsafe { *new_ob };
        pm.ir_revision = pre_rev + 1u32;
        stats.pass_changes = stats.pass_changes + 1u32;
        passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
        let re_mask = ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA;
        passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), re_mask);

        if force_verify_fail && body.bb_count > 0 && (body.blocks as usize) != 0 {
            // Corrupt CFG edge symmetry intentionally when testing `PassManager` rollback semantics
            let bb0 = unsafe { opt_block_at(body.blocks, 0) };
            unsafe { (*bb0).pred_count = 999999; }
        }
    }

    if pm.budget.verify_each {
        let vstatus = esc_verify_postconditions_arg_aware(
            mut_view(*pm),
            mut_view(*body),
            PASS_ESCAPE_PROMOTE,
            mut_view(*arena),
            mut_view(*sink)
        );
        if vstatus != CONTRACT_OK || !optir_verify_contract(view(*body)) {
            sink.errors = pre_sink_errs;
            *body = pre_body;
            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
            pm.ir_revision = pre_rev;
            pm.valid_analyses = pre_valid;
            pm.baseline_effect_summary.flags = pre_base_flags;
            pm.has_baseline_effects = pre_has_base;
            *stats = pre_stats;
            stats.pass_runs = pre_stats.pass_runs + 1u32;
            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
            if (log as usize) != 0 {
                unsafe { (*log).count = pre_log_cnt; }
            }
            return false;
        }
    }

    changed
}

pub fn escape_run_pass_with_info(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    info: mut_view<EscapeInfo>,
    call_table: *const EffectCallTable,
    summary_table: *const EscapeSummaryTable,
    stats: mut_view<EscapePromoteStats>,
    log: *mut EscapePromoteLog,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    escape_run_pass_internal(
        mut_view(*pm),
        mut_view(*body),
        mut_view(*info),
        call_table,
        summary_table,
        mut_view(*stats),
        log,
        false,
        mut_view(*arena),
        mut_view(*sink)
    )
}

pub fn escape_run_pass(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    summary_table: *const EscapeSummaryTable,
    stats: mut_view<EscapePromoteStats>,
    log: *mut EscapePromoteLog,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    if pm.budget.profile == OPT_PROFILE_DEBUG_O0 {
        return false;
    }
    let contract = escape_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);
    let info_ptr = escape_build_info(view(*body), call_table, summary_table, mut_view(*arena));
    escape_run_pass_with_info(
        mut_view(*pm),
        mut_view(*body),
        unsafe { mut_view(*info_ptr) },
        call_table,
        summary_table,
        mut_view(*stats),
        log,
        mut_view(*arena),
        mut_view(*sink)
    )
}

pub fn escape_run_pipeline(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    summary_table: *const EscapeSummaryTable,
    stats: mut_view<EscapePromoteStats>,
    log: *mut EscapePromoteLog,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    passmgr_mark_all_valid_from_lowering(mut_view(*pm), mut_view(*body), mut_view(*arena));

    if pm.budget.profile == OPT_PROFILE_DEBUG_O0 || pm.budget.max_fixedpoint_rounds == 0u32 {
        if pm.budget.verify_each {
            let vst = esc_verify_postconditions_arg_aware(mut_view(*pm), mut_view(*body), PASS_LOWER_MIR, mut_view(*arena), mut_view(*sink));
            return vst == CONTRACT_OK;
        }
        return true;
    }

    let did_promote = escape_run_pass(
        mut_view(*pm),
        mut_view(*body),
        call_table,
        summary_table,
        mut_view(*stats),
        log,
        mut_view(*arena),
        mut_view(*sink)
    );
    if did_promote {
        let mut mstats: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
        memopt_stats_zero(mut_view(mstats));
        if pm.budget.verify_each && esc_opt_body_has_args(view(*body)) {
            let pre_mbody = *body;
            let msnap = passmgr_snapshot_body(view(*body), mut_view(*arena));
            let pre_mrev = pm.ir_revision;
            let pre_mvalid = pm.valid_analyses;
            let pre_mbase_flags = pm.baseline_effect_summary.flags;
            let pre_mhas_base = pm.has_baseline_effects;
            let pre_msink_errs = sink.errors;
            pm.budget.verify_each = false;
            let _m = memopt_run_pass(
                mut_view(*pm),
                mut_view(*body),
                call_table,
                mut_view(mstats),
                0 as *mut MemOptLog,
                mut_view(*arena),
                mut_view(*sink)
            );
            pm.budget.verify_each = true;
            let mvst = esc_verify_postconditions_arg_aware(
                mut_view(*pm),
                mut_view(*body),
                PASS_GVN_CSE,
                mut_view(*arena),
                mut_view(*sink)
            );
            if mvst != CONTRACT_OK || !optir_verify_contract(view(*body)) {
                sink.errors = pre_msink_errs;
                *body = pre_mbody;
                passmgr_rollback_body(mut_view(*body), view(msnap), mut_view(*arena));
                pm.ir_revision = pre_mrev;
                pm.valid_analyses = pre_mvalid;
                pm.baseline_effect_summary.flags = pre_mbase_flags;
                pm.has_baseline_effects = pre_mhas_base;
                pm.last_verify_status = CONTRACT_OK;
            }
        } else {
            let _m = memopt_run_pass(
                mut_view(*pm),
                mut_view(*body),
                call_table,
                mut_view(mstats),
                0 as *mut MemOptLog,
                mut_view(*arena),
                mut_view(*sink)
            );
        }
    }

    let exit_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                    analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA);
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), exit_mask);
    pm.last_verify_status == CONTRACT_OK
}

pub fn escape_optimize_mir_body(
    mir_body: mut_view<MirBody>,
    thir: *const Thir,
    profile: u8,
    verify_each: bool,
    call_table: *const EffectCallTable,
    summary_table: *const EscapeSummaryTable,
    stats: mut_view<EscapePromoteStats>,
    log: *mut EscapePromoteLog,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    fn_item: *const HirItem
) -> bool {
    *stats = escape_stats_zero();
    let prev_errs = sink.errors;

    let eff_fn = esc_ensure_fn_item_for_mir(view(*mir_body), fn_item, mut_view(*arena));
    if (fn_item as usize) == 0 && (eff_fn as usize) != 0 {
        if !esc_verify_mir_definite_init(view(*mir_body), thir, mut_view(*arena)) {
            return false;
        }
    }

    let obody = optir_build_from_mir(view(*mir_body), thir, mut_view(*arena), mut_view(*sink), eff_fn);
    if (obody as usize) == 0 || sink.errors != prev_errs {
        return false;
    }

    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, verify_each);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget, mut_view(*arena));

    if !escape_run_pipeline(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        call_table,
        summary_table,
        mut_view(*stats),
        log,
        mut_view(*arena),
        mut_view(*sink)
    ) {
        return false;
    }

    let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*obody) }, unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
        return false;
    }

    let exit_fn = esc_ensure_fn_item_for_mir(unsafe { view(*rec_mir) }, fn_item, mut_view(*arena));
    verify_mir(unsafe { view(*rec_mir) }, thir, mut_view(*sink), exit_fn);
    if sink.errors != prev_errs {
        return false;
    }
    if (fn_item as usize) == 0 && (exit_fn as usize) != 0 {
        if !esc_verify_mir_definite_init(unsafe { view(*rec_mir) }, thir, mut_view(*arena)) {
            return false;
        }
    }

    unsafe {
        mir_body.sym.v = (*rec_mir).sym.v;
        mir_body.fn_sym.v = (*rec_mir).fn_sym.v;
        mir_body.fn_name.v = (*rec_mir).fn_name.v;
        mir_body.span.file.v = (*rec_mir).span.file.v;
        mir_body.span.start = (*rec_mir).span.start;
        mir_body.span.end = (*rec_mir).span.end;
        mir_body.locals = (*rec_mir).locals;
        mir_body.local_count = (*rec_mir).local_count;
        mir_body.local_cap = (*rec_mir).local_cap;
        mir_body.arg_count = (*rec_mir).arg_count;
        mir_body.bbs = (*rec_mir).bbs;
        mir_body.bb_count = (*rec_mir).bb_count;
        mir_body.bb_cap = (*rec_mir).bb_cap;
        mir_body.drop_flag_count = (*rec_mir).drop_flag_count;
    }
    true
}

// --- Deterministic `--emit=escape` Inspection Printers (`SPEC-71 AXS-ESC-017`) ---

