// --- Pass Identifier & TransformationContract (`SPEC-71 AXS-ESC-016`) ---

pub const PASS_ESCAPE_PROMOTE: u16 = 10u16;

pub fn escape_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_ESCAPE_PROMOTE,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                           ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO |
                           ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ESCAPE_INFO,
        required_proofs: PROP_MASK_NO_ESCAPE,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS,
        invalidated_analyses: ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO |
                              ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_LOOP_INFO,
        preserved_properties: PROP_MASK_REACHABLE | PROP_MASK_NO_ALIAS | PROP_MASK_PURE_CALL,
        postconditions: POSTCOND_ALL,
    }
}

// --- Fine-Grained `EscapeSet` Bitflags & 4-Tier `EscapeClass` Lattice (`AXS-ESC-002`, `REQ-OPT-042`) ---

pub const ESC_NONE: u16 = 0u16;
pub const ESC_ARGUMENT: u16 = 1u16;
pub const ESC_RETURN: u16 = 2u16;
pub const ESC_HEAP: u16 = 4u16;
pub const ESC_THREAD: u16 = 8u16;
pub const ESC_EXTERNAL: u16 = 16u16;
pub const ESC_UNKNOWN: u16 = 32u16;
pub const ESC_GLOBAL_MASK: u16 = 60u16; // ESC_HEAP | ESC_THREAD | ESC_EXTERNAL | ESC_UNKNOWN

pub const ESCAPE_NO_ESCAPE: u8 = 0u8;
pub const ESCAPE_ARG_ESCAPE: u8 = 1u8;
pub const ESCAPE_RETURN_ESCAPE: u8 = 2u8;
pub const ESCAPE_GLOBAL_ESCAPE: u8 = 3u8;

pub fn escape_set_join(a: u16, b: u16) -> u16 {
    a | b
}

pub fn escape_class_from_set(escape_set: u16) -> u8 {
    if (escape_set & ESC_GLOBAL_MASK) != 0u16 {
        return ESCAPE_GLOBAL_ESCAPE;
    }
    if (escape_set & ESC_RETURN) != 0u16 {
        return ESCAPE_RETURN_ESCAPE;
    }
    if (escape_set & ESC_ARGUMENT) != 0u16 {
        return ESCAPE_ARG_ESCAPE;
    }
    ESCAPE_NO_ESCAPE
}

pub fn escape_class_join(a: u8, b: u8) -> u8 {
    if a >= b { a } else { b }
}

pub fn escape_class_at_most(a: u8, b: u8) -> bool {
    a <= b
}

pub fn escape_no_escape_certainty(escape_set: u16) -> u8 {
    if escape_set == ESC_NONE {
        return CERTAINTY_PROVEN;
    }
    if (escape_set & ESC_UNKNOWN) != 0u16 {
        return CERTAINTY_UNKNOWN;
    }
    CERTAINTY_POSSIBLE
}

