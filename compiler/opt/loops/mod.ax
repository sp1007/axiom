// --- Pass Identifier & Loop Sentinels (SPEC-72 §1.1) ---

pub const PASS_LOOP_SIMPLIFY: u16 = 10u16;

@derive(Copy)
pub struct LoopId {
    pub v: u32,
}

pub const LOOP_NONE: u32 = 0xFFFFFFFFu32;
pub const SCEV_IDX_NONE: u32 = 0xFFFFFFFFu32;

// --- Semantic Barrier Bitmask (AXS-LOOP-005, REQ-OPT-143, REQ-OPT-189) ---

pub const BARRIER_NONE: u16 = 0u16;
pub const BARRIER_VOLATILE: u16 = 1u16;
pub const BARRIER_ATOMIC: u16 = 2u16;
pub const BARRIER_IO: u16 = 4u16;
pub const BARRIER_AWAIT: u16 = 8u16;
pub const BARRIER_FFI: u16 = 16u16;
pub const BARRIER_DROP: u16 = 32u16;
pub const BARRIER_STABLE_ADDR: u16 = 64u16;
pub const BARRIER_GPU_DOMAIN: u16 = 128u16;

// --- Arithmetic Overflow Mode (SPEC-72 §1.1, AXS-LOOP-006, REQ-OPT-190) ---

pub const ARITH_CHECKED: u8 = 0u8;
pub const ARITH_WRAPPING: u8 = 1u8;
pub const ARITH_SATURATING: u8 = 2u8;
pub const ARITH_PROVEN_NSW_NUW: u8 = 3u8;

// --- Scalar Evolution Expression Kinds (SPEC-72 §1.1, REQ-OPT-155..158) ---

pub const SCEV_CONST: u8 = 0u8;
pub const SCEV_INVARIANT: u8 = 1u8;
pub const SCEV_ADD_REC: u8 = 2u8;
pub const SCEV_ADD: u8 = 3u8;
pub const SCEV_MUL: u8 = 4u8;
pub const SCEV_MAX: u8 = 5u8;
pub const SCEV_UNKNOWN: u8 = 6u8;

// --- Trip-Count Lattice (SPEC-72 §1.1, AXS-LOOP-006, REQ-OPT-157) ---

pub const TRIP_CONST: u8 = 0u8;
pub const TRIP_SYMBOLIC: u8 = 1u8;
pub const TRIP_UPPER_BOUNDED: u8 = 2u8;
pub const TRIP_INFINITE: u8 = 3u8;
pub const TRIP_UNKNOWN: u8 = 4u8;

// --- Loop-Carried Memory Dependence Lattice (SPEC-72 §3.1, AXS-LOOP-011, REQ-OPT-144..147) ---

pub const DEP_NONE: u8 = 0u8;
pub const DEP_LOOP_INDEPENDENT: u8 = 1u8;
pub const DEP_RAW_FLOW: u8 = 2u8;
pub const DEP_WAR_ANTI: u8 = 3u8;
pub const DEP_WAW_OUTPUT: u8 = 4u8;
pub const DEP_UNKNOWN: u8 = 5u8;

// --- Core Loop & SCEV Data Structures (SPEC-72 §1.1 & §3.1) ---

@derive(Copy)
pub struct ScevExpr {
    pub kind: u8,
    pub ty: TypeId,
    pub loop_id: LoopId,
    pub arith_mode: u8,
    pub const_val: i64,
    pub ssa_val: OptValueId,
    pub lhs_idx: u32,
    pub rhs_idx: u32,
    pub no_wrap_proven: bool,
}

@derive(Copy)
pub struct ScevTripCount {
    pub kind: u8,
    pub const_iters: u64,
    pub sym_expr_idx: u32,
    pub max_iters: u64,
    pub certainty: u8,
}

@derive(Copy)
pub struct InductionVar {
    pub phi_val: OptValueId,
    pub ssa_val: OptValueId,
    pub start_expr: u32,
    pub step_const: i64,
    pub step_expr: u32,
    pub scale_const: i64,
    pub offset_expr: u32,
    pub arith_mode: u8,
    pub is_primary: bool,
    pub no_wrap_proven: bool,
}

@derive(Copy)
pub struct LoopDependence {
    pub kind: u8,
    pub is_constant_dist: bool,
    pub distance: i64,
    pub certainty: u8,
}

pub struct LoopDesc {
    pub id: LoopId,
    pub parent: LoopId,
    pub depth: u32,
    pub header: OptBbId,
    pub preheader: OptBbId,
    pub single_latch: OptBbId,
    pub blocks: *mut OptBbId,
    pub block_count: usize,
    pub latches: *mut OptBbId,
    pub latch_count: usize,
    pub exiting_blocks: *mut OptBbId,
    pub exiting_count: usize,
    pub exit_blocks: *mut OptBbId,
    pub exit_count: usize,
    pub children: *mut LoopId,
    pub child_count: usize,
    pub is_canonical_simplified: bool,
    pub is_lcssa: bool,
    pub is_irreducible: bool,
    pub has_observable_barriers: u16,
    pub trip_count: ScevTripCount,
    pub exit_bound_val: OptValueId,
    pub exit_is_inclusive: bool,
    pub ivs: *mut InductionVar,
    pub iv_count: usize,
}

pub struct LoopTree {
    pub loops: *mut LoopDesc,
    pub loop_count: usize,
    pub root_loops: *mut LoopId,
    pub root_count: usize,
    pub block_loop_map: *mut LoopId,
    pub bb_count: usize,
    pub has_irreducible_cfg: bool,
    pub scev_pool: *mut ScevExpr,
    pub scev_count: usize,
    pub scev_cap: usize,
    pub exec_domain: u8,
}

@derive(Copy)
pub struct LoopSimplifyStats {
    pub pass_runs: u32,
    pub pass_changes: u32,
    pub pass_rollbacks: u32,
    pub loops_discovered: u32,
    pub irreducible_cycles: u32,
    pub preheaders_inserted: u32,
    pub latches_merged: u32,
    pub dedicated_exits_inserted: u32,
    pub lcssa_phis_inserted: u32,
}

// --- Pointer Indexing & Contract Helpers ---

fn lp_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn loop_id_at(base: *mut LoopId, idx: usize) -> *mut LoopId {
    let off = lp_mul_usize(idx, size_of<LoopId>());
    ((base as usize) + off) as *mut LoopId
}

pub unsafe fn loop_desc_at(base: *mut LoopDesc, idx: usize) -> *mut LoopDesc {
    let off = lp_mul_usize(idx, size_of<LoopDesc>());
    ((base as usize) + off) as *mut LoopDesc
}

pub unsafe fn loop_iv_at(base: *mut InductionVar, idx: usize) -> *mut InductionVar {
    let off = lp_mul_usize(idx, size_of<InductionVar>());
    ((base as usize) + off) as *mut InductionVar
}

pub unsafe fn scev_expr_at(base: *mut ScevExpr, idx: usize) -> *mut ScevExpr {
    let off = lp_mul_usize(idx, size_of<ScevExpr>());
    ((base as usize) + off) as *mut ScevExpr
}

pub fn loop_simplify_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_LOOP_SIMPLIFY,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA,
        required_proofs: PROP_MASK_NONE,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                            ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_LOOP_INFO,
        invalidated_analyses: ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_NONE,
        postconditions: POSTCOND_ALL,
    }
}

pub fn loops_stats_zero(stats: mut_view<LoopSimplifyStats>) {
    stats.pass_runs = 0u32;
    stats.pass_changes = 0u32;
    stats.pass_rollbacks = 0u32;
    stats.loops_discovered = 0u32;
    stats.irreducible_cycles = 0u32;
    stats.preheaders_inserted = 0u32;
    stats.latches_merged = 0u32;
    stats.dedicated_exits_inserted = 0u32;
    stats.lcssa_phis_inserted = 0u32;
}

pub fn scev_unknown_expr(ty: TypeId, loop_id: LoopId, val_id: OptValueId) -> ScevExpr {
    ScevExpr {
        kind: SCEV_UNKNOWN,
        ty: ty,
        loop_id: loop_id,
        arith_mode: ARITH_WRAPPING,
        const_val: 0i64,
        ssa_val: val_id,
        lhs_idx: SCEV_IDX_NONE,
        rhs_idx: SCEV_IDX_NONE,
        no_wrap_proven: false,
    }
}

pub fn scev_trip_unknown() -> ScevTripCount {
    ScevTripCount {
        kind: TRIP_UNKNOWN,
        const_iters: 0u64,
        sym_expr_idx: SCEV_IDX_NONE,
        max_iters: 0u64,
        certainty: CERTAINTY_UNKNOWN,
    }
}

pub fn scev_alloc_expr(tree: mut_view<LoopTree>, arena: mut_view<Arena>, expr: ScevExpr) -> u32 {
    if tree.scev_count >= tree.scev_cap {
        let new_cap: usize = if tree.scev_cap == 0 { 32 } else { tree.scev_cap + tree.scev_cap };
        let new_bytes = lp_mul_usize(new_cap, size_of<ScevExpr>());
        let new_arr = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<ScevExpr>()) as *mut ScevExpr;
        if tree.scev_count > 0 && (tree.scev_pool as usize) != 0 {
            let old_bytes = lp_mul_usize(tree.scev_count, size_of<ScevExpr>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(tree.scev_pool as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        tree.scev_pool = new_arr;
        tree.scev_cap = new_cap;
    }
    let idx = tree.scev_count;
    tree.scev_count = idx + 1;
    unsafe { *scev_expr_at(tree.scev_pool, idx) = expr; }
    idx as u32
}

// --- Block-Set & RPO Helpers ---

pub fn lp_block_in_set(arr: *mut OptBbId, cnt: usize, bb_v: u32) -> bool {
    if (arr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < cnt {
        if (unsafe { (*opt_bbid_at(arr, i)).v }) == bb_v {
            return true;
        }
        i = i + 1;
    }
    false
}

fn lp_push_bb_unique(arr: *mut OptBbId, cnt: mut_view<usize>, cap: usize, bb_v: u32) {
    if lp_block_in_set(arr, *cnt, bb_v) || *cnt >= cap {
        return;
    }
    unsafe { *opt_bbid_at(arr, *cnt) = OptBbId { v: bb_v }; }
    *cnt = *cnt + 1;
}

fn lp_sort_bbs_by_rpo(body: view<OptBody>, arr: *mut OptBbId, cnt: usize) {
    if cnt <= 1 {
        return;
    }
    let mut i: usize = 1;
    while i < cnt {
        let key = unsafe { *opt_bbid_at(arr, i) };
        let key_bb = unsafe { opt_block_at(body.blocks, key.v as usize) };
        let key_rpo = unsafe { (*key_bb).rpo_idx };
        let mut j = i;
        while j > 0 {
            let prev = unsafe { *opt_bbid_at(arr, j - 1) };
            let prev_bb = unsafe { opt_block_at(body.blocks, prev.v as usize) };
            let prev_rpo = unsafe { (*prev_bb).rpo_idx };
            if prev_rpo > key_rpo || (prev_rpo == key_rpo && prev.v > key.v) {
                unsafe { *opt_bbid_at(arr, j) = prev; }
                j = j - 1;
            } else {
                break;
            }
        }
        unsafe { *opt_bbid_at(arr, j) = key; }
        i = i + 1;
    }
}

fn lp_is_subset_blocks(sub_arr: *mut OptBbId, sub_cnt: usize, sup_arr: *mut OptBbId, sup_cnt: usize) -> bool {
    if sub_cnt >= sup_cnt {
        return false;
    }
    let mut i: usize = 0;
    while i < sub_cnt {
        let bv = unsafe { (*opt_bbid_at(sub_arr, i)).v };
        if !lp_block_in_set(sup_arr, sup_cnt, bv) {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn loops_is_block_in_loop(lp: view<LoopDesc>, bb_id: OptBbId) -> bool {
    lp_block_in_set(lp.blocks, lp.block_count, bb_id.v)
}

pub fn loops_loop_of_block(tree: view<LoopTree>, bb_id: OptBbId) -> LoopId {
    if (bb_id.v as usize) >= tree.bb_count || (tree.block_loop_map as usize) == 0 {
        return LoopId { v: LOOP_NONE };
    }
    unsafe { *loop_id_at(tree.block_loop_map, bb_id.v as usize) }
}

// --- Semantic Barrier Scanner & LCSSA Verifier (AXS-LOOP-004, AXS-LOOP-005) ---

fn lp_scan_loop_barriers(
    body: view<OptBody>,
    lp_blocks: *mut OptBbId,
    lp_cnt: usize,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    exec_domain: u8
) -> u16 {
    let mut mask: u16 = BARRIER_NONE;
    if exec_domain == EXEC_DOMAIN_KERNEL {
        mask = mask | BARRIER_GPU_DOMAIN;
    }
    let mut k: usize = 0;
    while k < lp_cnt {
        let bid_v = unsafe { (*opt_bbid_at(lp_blocks, k)).v };
        if (bid_v as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bid_v as usize) };
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                let flg = unsafe { (*inst).flags };
                if opc == OPT_INST_VOLATILE_LOAD || opc == OPT_INST_VOLATILE_STORE || opc == OPT_INST_ZEROIZE {
                    mask = mask | BARRIER_VOLATILE;
                } else if opc == OPT_INST_ATOMIC {
                    mask = mask | BARRIER_ATOMIC;
                } else if opc == OPT_INST_DROP_FLAG || (unsafe { (*inst).orig_stmt.kind }) == MIR_STMT_DROP {
                    mask = mask | BARRIER_DROP;
                } else if opc == OPT_INST_ADDR_OF {
                    mask = mask | BARRIER_STABLE_ADDR;
                } else if opc == OPT_INST_BLACK_BOX {
                    mask = mask | BARRIER_VOLATILE | BARRIER_STABLE_ADDR;
                }
                if (flg & OPT_FLAG_BARRIER) != 0u16 && opc != OPT_INST_DROP_FLAG && opc != OPT_INST_ATOMIC &&
                   opc != OPT_INST_VOLATILE_LOAD && opc != OPT_INST_VOLATILE_STORE && opc != OPT_INST_ZEROIZE &&
                   opc != OPT_INST_BLACK_BOX {
                    mask = mask | BARRIER_VOLATILE;
                }
                let eff = effect_infer_inst(body, unsafe { view(*inst) }, 64u32);
                if (eff & EFFECT_VOLATILE) != 0u16 { mask = mask | BARRIER_VOLATILE; }
                if (eff & EFFECT_ATOMIC) != 0u16 { mask = mask | BARRIER_ATOMIC; }
                if (eff & EFFECT_IO) != 0u16 { mask = mask | BARRIER_IO; }
                if (eff & EFFECT_FFI) != 0u16 { mask = mask | BARRIER_FFI; }
                if (alias_info as usize) != 0 {
                    let dlv = (unsafe { (*inst).place.local.v }) as usize;
                    if dlv < (unsafe { (*alias_info).local_count }) {
                        let lp_prov = unsafe { alias_local_prov_at((*alias_info).locals, dlv) };
                        if unsafe { (*lp_prov).is_fixed_mmio } {
                            mask = mask | BARRIER_VOLATILE | BARRIER_STABLE_ADDR;
                        }
                        if (unsafe { (*lp_prov).domain }) == DOMAIN_DEVICE_DMA || (unsafe { (*lp_prov).is_zero_copy_pinned }) {
                            mask = mask | BARRIER_GPU_DOMAIN | BARRIER_STABLE_ADDR;
                        }
                    }
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_DROP {
                    mask = mask | BARRIER_DROP;
                } else if tk == OPT_TERM_CALL {
                    let teff_sum = effect_infer_term_with_table(body, unsafe { view((*bb).term) }, call_table);
                    let teff = teff_sum.flags;
                    if (teff & EFFECT_VOLATILE) != 0u16 { mask = mask | BARRIER_VOLATILE; }
                    if (teff & EFFECT_ATOMIC) != 0u16 { mask = mask | BARRIER_ATOMIC; }
                    if (teff & EFFECT_IO) != 0u16 { mask = mask | BARRIER_IO; }
                    if (teff & EFFECT_FFI) != 0u16 { mask = mask | BARRIER_FFI; }
                    if (teff & EFFECT_NONTERM) != 0u16 { mask = mask | BARRIER_AWAIT; }
                }
            }
        }
        k = k + 1;
    }
    mask
}

fn lp_val_defined_in_loop(body: view<OptBody>, lp_blocks: *mut OptBbId, lp_cnt: usize, val_v: u32) -> bool {
    if val_v == OPT_VALUE_NONE || (val_v as usize) > body.value_count {
        return false;
    }
    let vp = unsafe { opt_val_at(body.values, val_v as usize) };
    let vk = unsafe { (*vp).kind };
    if vk != OPT_VAL_INST && vk != OPT_VAL_PHI {
        return false;
    }
    lp_block_in_set(lp_blocks, lp_cnt, unsafe { (*vp).def_bb.v })
}

pub fn lp_check_is_lcssa(body: view<OptBody>, lp_blocks: *mut OptBbId, lp_cnt: usize) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if (unsafe { (*bb).is_reachable }) && !(unsafe { (*bb).is_cleanup }) &&
           !lp_block_in_set(lp_blocks, lp_cnt, b as u32) {
            // Check OptPhis: an outside-loop OptPhi may only read an in-loop value along an edge from inside the loop
            let pcnt = unsafe { (*bb).phi_count };
            let mut p: usize = 0;
            while p < pcnt {
                let phi = unsafe { opt_phi_at((*bb).phis, p) };
                let ar = unsafe { (*phi).arity };
                let mut k: usize = 0;
                while k < ar {
                    let ib_v = unsafe { (*opt_bbid_at((*phi).incoming_blocks, k)).v };
                    let iv_v = unsafe { (*opt_valid_at((*phi).incoming_values, k)).v };
                    if !lp_block_in_set(lp_blocks, lp_cnt, ib_v) &&
                       lp_val_defined_in_loop(body, lp_blocks, lp_cnt, iv_v) {
                        return false;
                    }
                    k = k + 1;
                }
                p = p + 1;
            }
            // Check instructions in outside-loop block
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                if opc != OPT_INST_NOP {
                    if lp_val_defined_in_loop(body, lp_blocks, lp_cnt, unsafe { (*inst).lhs.v }) ||
                       lp_val_defined_in_loop(body, lp_blocks, lp_cnt, unsafe { (*inst).rhs.v }) {
                        return false;
                    }
                    let eac = unsafe { (*inst).extra_arg_count };
                    let mut ei: usize = 0;
                    while ei < eac {
                        let ev_v = unsafe { (*opt_valid_at((*inst).extra_args, ei)).v };
                        if lp_val_defined_in_loop(body, lp_blocks, lp_cnt, ev_v) {
                            return false;
                        }
                        ei = ei + 1;
                    }
                }
                i = i + 1;
            }
            // Check terminator operands in outside-loop block
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_BRANCH || tk == OPT_TERM_SWITCH_INT || tk == OPT_TERM_ASSERT {
                    if lp_val_defined_in_loop(body, lp_blocks, lp_cnt, unsafe { (*bb).term.cond.v }) {
                        return false;
                    }
                } else if tk == OPT_TERM_CALL {
                    if lp_val_defined_in_loop(body, lp_blocks, lp_cnt, unsafe { (*bb).term.callee.v }) {
                        return false;
                    }
                    let cac = unsafe { (*bb).term.call_arg_count };
                    let mut ci: usize = 0;
                    while ci < cac {
                        let cv_v = unsafe { (*opt_valid_at((*bb).term.call_args, ci)).v };
                        if lp_val_defined_in_loop(body, lp_blocks, lp_cnt, cv_v) {
                            return false;
                        }
                        ci = ci + 1;
                    }
                }
            }
        }
        b = b + 1;
    }
    true
}

// --- Tarjan SCC on Backedge-Stripped CFG for Irreducible Cycle Detection (AXS-LOOP-002) ---

fn lp_tarjan_dfs(
    body: view<OptBody>,
    u: usize,
    next_idx: mut_view<u32>,
    dfn: *mut u32,
    low: *mut u32,
    on_stack: *mut bool,
    stack: *mut u32,
    stack_len: mut_view<usize>,
    scc_id_of: *mut u32,
    scc_sizes: *mut u32,
    scc_count: mut_view<usize>
) {
    let cur_dfn = *next_idx;
    *next_idx = cur_dfn + 1u32;
    unsafe {
        *opt_u32_at(dfn, u) = cur_dfn;
        *opt_u32_at(low, u) = cur_dfn;
        *opt_bool_at(on_stack, u) = true;
        *opt_u32_at(stack, *stack_len) = u as u32;
    }
    *stack_len = *stack_len + 1;

    let ubb = unsafe { opt_block_at(body.blocks, u) };
    let sc = unsafe { (*ubb).succ_count };
    let mut s: usize = 0;
    while s < sc {
        let v_id = unsafe { *opt_bbid_at((*ubb).succs, s) };
        let v = v_id.v as usize;
        if v < body.bb_count {
            let vbb = unsafe { opt_block_at(body.blocks, v) };
            // Strip natural backedges (where target v dominates source u) and cleanup blocks
            let u_bb_id = OptBbId { v: u as u32 };
            if (unsafe { (*vbb).is_reachable }) && !(unsafe { (*vbb).is_cleanup }) &&
               !opt_dominates(body, v_id, u_bb_id) {
                let v_dfn = unsafe { *opt_u32_at(dfn, v) };
                if v_dfn == OPT_BB_NONE {
                    lp_tarjan_dfs(
                        body, v, mut_view(*next_idx), dfn, low, on_stack,
                        stack, mut_view(*stack_len), scc_id_of, scc_sizes, mut_view(*scc_count)
                    );
                    let u_low = unsafe { *opt_u32_at(low, u) };
                    let v_low = unsafe { *opt_u32_at(low, v) };
                    if v_low < u_low {
                        unsafe { *opt_u32_at(low, u) = v_low; }
                    }
                } else if unsafe { *opt_bool_at(on_stack, v) } {
                    let u_low = unsafe { *opt_u32_at(low, u) };
                    if v_dfn < u_low {
                        unsafe { *opt_u32_at(low, u) = v_dfn; }
                    }
                }
            }
        }
        s = s + 1;
    }

    if (unsafe { *opt_u32_at(low, u) }) == cur_dfn {
        let cid = *scc_count;
        *scc_count = cid + 1;
        let mut sz: u32 = 0u32;
        while *stack_len > 0 {
            *stack_len = *stack_len - 1;
            let w = (unsafe { *opt_u32_at(stack, *stack_len) }) as usize;
            unsafe {
                *opt_bool_at(on_stack, w) = false;
                *opt_u32_at(scc_id_of, w) = cid as u32;
            }
            sz = sz + 1u32;
            if w == u {
                break;
            }
        }
        unsafe { *opt_u32_at(scc_sizes, cid) = sz; }
    }
}

fn lp_init_empty_desc(lp: mut_view<LoopDesc>, id_v: u32, hdr_v: u32, is_irred: bool) {
    lp.id = LoopId { v: id_v };
    lp.parent = LoopId { v: LOOP_NONE };
    lp.depth = 0u32;
    lp.header = OptBbId { v: hdr_v };
    lp.preheader = OptBbId { v: OPT_BB_NONE };
    lp.single_latch = OptBbId { v: OPT_BB_NONE };
    lp.blocks = 0 as *mut OptBbId;
    lp.block_count = 0;
    lp.latches = 0 as *mut OptBbId;
    lp.latch_count = 0;
    lp.exiting_blocks = 0 as *mut OptBbId;
    lp.exiting_count = 0;
    lp.exit_blocks = 0 as *mut OptBbId;
    lp.exit_count = 0;
    lp.children = 0 as *mut LoopId;
    lp.child_count = 0;
    lp.is_canonical_simplified = false;
    lp.is_lcssa = false;
    lp.is_irreducible = is_irred;
    lp.has_observable_barriers = BARRIER_NONE;
    lp.trip_count = scev_trip_unknown();
    lp.exit_bound_val = OptValueId { v: OPT_VALUE_NONE };
    lp.exit_is_inclusive = false;
    lp.ivs = 0 as *mut InductionVar;
    lp.iv_count = 0;
}

fn lp_is_abort_stub_block(bb: view<OptBlock>) -> bool {
    bb.inst_count == 0 && bb.phi_count == 0 && bb.has_term && bb.term.kind == OPT_TERM_UNREACHABLE
}

fn lp_populate_exits_and_flags(
    lp: mut_view<LoopDesc>,
    body: view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    exec_domain: u8,
    arena: mut_view<Arena>
) {
    let n = body.bb_count;
    let max_cap: usize = if n == 0 { 1 } else { n };
    let exiting_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(max_cap, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
    let exit_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(max_cap, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
    let mut exiting_cnt: usize = 0;
    let mut exit_cnt: usize = 0;

    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
        let sc = unsafe { (*bb).succ_count };
        let mut s: usize = 0;
        let mut is_exiting = false;
        while s < sc {
            let sv = unsafe { (*opt_bbid_at((*bb).succs, s)).v };
            if (sv as usize) < n {
                let sbb = unsafe { opt_block_at(body.blocks, sv as usize) };
                let is_assert_unwind = (unsafe { (*bb).has_term }) &&
                                       (unsafe { (*bb).term.kind }) == OPT_TERM_ASSERT &&
                                       (unsafe { (*bb).term.unwind_bb.v }) == sv &&
                                       (unsafe { (*bb).term.true_bb.v }) != sv;
                if (unsafe { (*sbb).is_reachable }) && !(unsafe { (*sbb).is_cleanup }) &&
                   !is_assert_unwind && !lp_is_abort_stub_block(unsafe { view(*sbb) }) &&
                   !lp_block_in_set(lp.blocks, lp.block_count, sv) {
                    is_exiting = true;
                    lp_push_bb_unique(exit_arr, mut_view(exit_cnt), max_cap, sv);
                }
            }
            s = s + 1;
        }
        if is_exiting {
            lp_push_bb_unique(exiting_arr, mut_view(exiting_cnt), max_cap, bv);
        }
        k = k + 1;
    }
    lp_sort_bbs_by_rpo(body, exiting_arr, exiting_cnt);
    lp_sort_bbs_by_rpo(body, exit_arr, exit_cnt);
    lp.exiting_blocks = exiting_arr;
    lp.exiting_count = exiting_cnt;
    lp.exit_blocks = exit_arr;
    lp.exit_count = exit_cnt;

    lp.has_observable_barriers = lp_scan_loop_barriers(
        body, lp.blocks, lp.block_count, call_table, alias_info, exec_domain
    );

    if lp.is_irreducible {
        lp.is_lcssa = false;
        lp.is_canonical_simplified = false;
        return;
    }

    // Check unique preheader: exactly 1 reachable non-cleanup outside-loop pred P of header with GOTO -> header
    let hbb = unsafe { opt_block_at(body.blocks, lp.header.v as usize) };
    let h_pcnt = unsafe { (*hbb).pred_count };
    let mut out_pred_cnt: usize = 0;
    let mut single_out_pred: u32 = OPT_BB_NONE;
    let mut p: usize = 0;
    while p < h_pcnt {
        let pv = unsafe { (*opt_bbid_at((*hbb).preds, p)).v };
        if (pv as usize) < n {
            let pbb = unsafe { opt_block_at(body.blocks, pv as usize) };
            if (unsafe { (*pbb).is_reachable }) && !(unsafe { (*pbb).is_cleanup }) &&
               !lp_block_in_set(lp.blocks, lp.block_count, pv) {
                out_pred_cnt = out_pred_cnt + 1;
                single_out_pred = pv;
            }
        }
        p = p + 1;
    }
    if out_pred_cnt == 1 && single_out_pred != OPT_BB_NONE {
        let pbb = unsafe { opt_block_at(body.blocks, single_out_pred as usize) };
        if (unsafe { (*pbb).succ_count }) == 1 && (unsafe { (*pbb).term.kind }) == OPT_TERM_GOTO {
            lp.preheader = OptBbId { v: single_out_pred };
        }
    }

    if lp.latch_count == 1 {
        lp.single_latch = unsafe { *opt_bbid_at(lp.latches, 0) };
    }

    // Check dedicated exit blocks: every reachable non-cleanup predecessor of each exit block lies inside lp
    let mut all_exits_dedicated = true;
    let mut e: usize = 0;
    while e < exit_cnt {
        let ev = unsafe { (*opt_bbid_at(exit_arr, e)).v };
        let ebb = unsafe { opt_block_at(body.blocks, ev as usize) };
        let epcnt = unsafe { (*ebb).pred_count };
        let mut ep: usize = 0;
        while ep < epcnt {
            let epv = unsafe { (*opt_bbid_at((*ebb).preds, ep)).v };
            if (epv as usize) < n {
                let epbb = unsafe { opt_block_at(body.blocks, epv as usize) };
                if (unsafe { (*epbb).is_reachable }) && !(unsafe { (*epbb).is_cleanup }) &&
                   !lp_is_abort_stub_block(unsafe { view(*epbb) }) &&
                   !lp_block_in_set(lp.blocks, lp.block_count, epv) {
                    all_exits_dedicated = false;
                }
            }
            ep = ep + 1;
        }
        e = e + 1;
    }

    lp.is_lcssa = lp_check_is_lcssa(body, lp.blocks, lp.block_count);
    lp.is_canonical_simplified = lp.preheader.v != OPT_BB_NONE &&
                                 lp.single_latch.v != OPT_BB_NONE &&
                                 all_exits_dedicated &&
                                 lp.is_lcssa;
}

// --- Natural Loop Discovery & LoopTree Construction (AXS-LOOP-001..002, REQ-OPT-155, REQ-OPT-189) ---

pub fn loops_discover_with_domain(
    body: view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    exec_domain: u8,
    arena: mut_view<Arena>
) -> *mut LoopTree {
    let tree = arena_alloc_raw(mut_view(*arena), size_of<LoopTree>(), align_of<LoopTree>()) as *mut LoopTree;
    let n = body.bb_count;
    let alloc_n: usize = if n == 0 { 1 } else { n };
    let bmap = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<LoopId>()), align_of<LoopId>()) as *mut LoopId;
    let mut b_init: usize = 0;
    while b_init < alloc_n {
        unsafe { *loop_id_at(bmap, b_init) = LoopId { v: LOOP_NONE }; }
        b_init = b_init + 1;
    }

    unsafe {
        (*tree).loops = 0 as *mut LoopDesc;
        (*tree).loop_count = 0;
        (*tree).root_loops = 0 as *mut LoopId;
        (*tree).root_count = 0;
        (*tree).block_loop_map = bmap;
        (*tree).bb_count = n;
        (*tree).has_irreducible_cfg = false;
        (*tree).scev_pool = 0 as *mut ScevExpr;
        (*tree).scev_count = 0;
        (*tree).scev_cap = 0;
        (*tree).exec_domain = exec_domain;
    }
    if n == 0 || (body.blocks as usize) == 0 {
        return tree;
    }

    // 1. Run Tarjan SCC on backedge-stripped CFG to identify irreducible multi-entry cycles
    let dfn = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let low = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let on_stack = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let stack = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let scc_id_of = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let scc_sizes = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<u32>()), align_of<u32>()) as *mut u32;

    let mut i: usize = 0;
    while i < n {
        unsafe {
            *opt_u32_at(dfn, i) = OPT_BB_NONE;
            *opt_u32_at(low, i) = OPT_BB_NONE;
            *opt_bool_at(on_stack, i) = false;
            *opt_u32_at(scc_id_of, i) = OPT_BB_NONE;
            *opt_u32_at(scc_sizes, i) = 0u32;
        }
        i = i + 1;
    }

    let mut next_dfn: u32 = 0u32;
    let mut stack_len: usize = 0;
    let mut scc_count: usize = 0;
    let mut r: usize = 0;
    while r < body.rpo_count {
        let bv = (unsafe { (*opt_bbid_at(body.rpo_order, r)).v }) as usize;
        if bv < n {
            let bb = unsafe { opt_block_at(body.blocks, bv) };
            if (unsafe { (*bb).is_reachable }) && !(unsafe { (*bb).is_cleanup }) &&
               (unsafe { *opt_u32_at(dfn, bv) }) == OPT_BB_NONE {
                lp_tarjan_dfs(
                    body, bv, mut_view(next_dfn), dfn, low, on_stack,
                    stack, mut_view(stack_len), scc_id_of, scc_sizes, mut_view(scc_count)
                );
            }
        }
        r = r + 1;
    }

    let mut irred_scc_cnt: usize = 0;
    let mut sc_i: usize = 0;
    while sc_i < scc_count {
        if (unsafe { *opt_u32_at(scc_sizes, sc_i) }) >= 2u32 {
            irred_scc_cnt = irred_scc_cnt + 1;
        }
        sc_i = sc_i + 1;
    }
    if irred_scc_cnt > 0 {
        unsafe { (*tree).has_irreducible_cfg = true; }
    }

    // 2. Discover natural loop headers in deterministic RPO order
    let max_loops = n + irred_scc_cnt + 1;
    let loop_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(max_loops, size_of<LoopDesc>()), align_of<LoopDesc>()) as *mut LoopDesc;
    let in_loop_mark = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let work = arena_alloc_raw(mut_view(*arena), lp_mul_usize(alloc_n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut loop_cnt: usize = 0;

    r = 0;
    while r < body.rpo_count {
        let h_id = unsafe { *opt_bbid_at(body.rpo_order, r) };
        let h_v = h_id.v;
        let hbb = unsafe { opt_block_at(body.blocks, h_v as usize) };
        if (unsafe { (*hbb).is_reachable }) && !(unsafe { (*hbb).is_cleanup }) {
            let pcnt = unsafe { (*hbb).pred_count };
            let latch_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(if pcnt == 0 { 1 } else { pcnt }, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
            let mut latch_cnt: usize = 0;
            let mut p: usize = 0;
            while p < pcnt {
                let l_id = unsafe { *opt_bbid_at((*hbb).preds, p) };
                if (l_id.v as usize) < n {
                    let lbb = unsafe { opt_block_at(body.blocks, l_id.v as usize) };
                    if (unsafe { (*lbb).is_reachable }) && !(unsafe { (*lbb).is_cleanup }) &&
                       opt_dominates(body, h_id, l_id) {
                        unsafe { *opt_bbid_at(latch_arr, latch_cnt) = l_id; }
                        latch_cnt = latch_cnt + 1;
                    }
                }
                p = p + 1;
            }

            if latch_cnt > 0 {
                // Backward CFG reachability from all latches stopping at header H
                let mut bi: usize = 0;
                while bi < n {
                    unsafe { *opt_bool_at(in_loop_mark, bi) = false; }
                    bi = bi + 1;
                }
                unsafe { *opt_bool_at(in_loop_mark, h_v as usize) = true; }
                let mut w_len: usize = 0;
                let mut li: usize = 0;
                while li < latch_cnt {
                    let lv = (unsafe { (*opt_bbid_at(latch_arr, li)).v }) as usize;
                    if !(unsafe { *opt_bool_at(in_loop_mark, lv) }) {
                        unsafe {
                            *opt_bool_at(in_loop_mark, lv) = true;
                            *opt_u32_at(work, w_len) = lv as u32;
                        }
                        w_len = w_len + 1;
                    }
                    li = li + 1;
                }
                let mut w_head: usize = 0;
                while w_head < w_len {
                    let cur = (unsafe { *opt_u32_at(work, w_head) }) as usize;
                    w_head = w_head + 1;
                    let cbb = unsafe { opt_block_at(body.blocks, cur) };
                    let c_pcnt = unsafe { (*cbb).pred_count };
                    let mut cp: usize = 0;
                    while cp < c_pcnt {
                        let pv = (unsafe { (*opt_bbid_at((*cbb).preds, cp)).v }) as usize;
                        if pv < n && !(unsafe { *opt_bool_at(in_loop_mark, pv) }) {
                            let pbb = unsafe { opt_block_at(body.blocks, pv) };
                            if (unsafe { (*pbb).is_reachable }) && !(unsafe { (*pbb).is_cleanup }) {
                                unsafe {
                                    *opt_bool_at(in_loop_mark, pv) = true;
                                    *opt_u32_at(work, w_len) = pv as u32;
                                }
                                w_len = w_len + 1;
                            }
                        }
                        cp = cp + 1;
                    }
                }

                let blk_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(n, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                let mut blk_cnt: usize = 0;
                let mut rr: usize = 0;
                while rr < body.rpo_count {
                    let rb_v = unsafe { (*opt_bbid_at(body.rpo_order, rr)).v };
                    if (rb_v as usize) < n && (unsafe { *opt_bool_at(in_loop_mark, rb_v as usize) }) {
                        unsafe { *opt_bbid_at(blk_arr, blk_cnt) = OptBbId { v: rb_v }; }
                        blk_cnt = blk_cnt + 1;
                    }
                    rr = rr + 1;
                }

                let lp = unsafe { loop_desc_at(loop_arr, loop_cnt) };
                lp_init_empty_desc(unsafe { mut_view(*lp) }, loop_cnt as u32, h_v, false);
                unsafe {
                    (*lp).blocks = blk_arr;
                    (*lp).block_count = blk_cnt;
                    (*lp).latches = latch_arr;
                    (*lp).latch_count = latch_cnt;
                }
                lp_populate_exits_and_flags(
                    unsafe { mut_view(*lp) }, body, call_table, alias_info, exec_domain, mut_view(*arena)
                );
                loop_cnt = loop_cnt + 1;
            }
        }
        r = r + 1;
    }

    // 3. Append irreducible multi-entry cycle descriptors in deterministic min-RPO order
    if irred_scc_cnt > 0 {
        let scc_emitted = arena_alloc_raw(mut_view(*arena), lp_mul_usize(scc_count + 1, size_of<bool>()), align_of<bool>()) as *mut bool;
        sc_i = 0;
        while sc_i <= scc_count {
            unsafe { *opt_bool_at(scc_emitted, sc_i) = false; }
            sc_i = sc_i + 1;
        }
        r = 0;
        while r < body.rpo_count {
            let rb_v = (unsafe { (*opt_bbid_at(body.rpo_order, r)).v }) as usize;
            if rb_v < n {
                let cid = (unsafe { *opt_u32_at(scc_id_of, rb_v) }) as usize;
                if cid < scc_count && (unsafe { *opt_u32_at(scc_sizes, cid) }) >= 2u32 &&
                   !(unsafe { *opt_bool_at(scc_emitted, cid) }) {
                    unsafe { *opt_bool_at(scc_emitted, cid) = true; }
                    let blk_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(n, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                    let mut blk_cnt: usize = 0;
                    let mut rr: usize = 0;
                    while rr < body.rpo_count {
                        let cb_v = unsafe { (*opt_bbid_at(body.rpo_order, rr)).v };
                        if (cb_v as usize) < n && (unsafe { *opt_u32_at(scc_id_of, cb_v as usize) }) == (cid as u32) {
                            unsafe { *opt_bbid_at(blk_arr, blk_cnt) = OptBbId { v: cb_v }; }
                            blk_cnt = blk_cnt + 1;
                        }
                        rr = rr + 1;
                    }
                    let lp = unsafe { loop_desc_at(loop_arr, loop_cnt) };
                    lp_init_empty_desc(unsafe { mut_view(*lp) }, loop_cnt as u32, rb_v as u32, true);
                    unsafe {
                        (*lp).blocks = blk_arr;
                        (*lp).block_count = blk_cnt;
                    }
                    lp_populate_exits_and_flags(
                        unsafe { mut_view(*lp) }, body, call_table, alias_info, exec_domain, mut_view(*arena)
                    );
                    loop_cnt = loop_cnt + 1;
                }
            }
            r = r + 1;
        }
    }

    // 4. Construct parent/children/depth LoopTree forest and innermost block_loop_map
    let mut li: usize = 0;
    while li < loop_cnt {
        let lp_i = unsafe { loop_desc_at(loop_arr, li) };
        let mut best_parent: u32 = LOOP_NONE;
        let mut best_size: usize = n + 1;
        let mut lj: usize = 0;
        while lj < loop_cnt {
            if li != lj {
                let lp_j = unsafe { loop_desc_at(loop_arr, lj) };
                if lp_is_subset_blocks(
                    unsafe { (*lp_i).blocks }, unsafe { (*lp_i).block_count },
                    unsafe { (*lp_j).blocks }, unsafe { (*lp_j).block_count }
                ) {
                    let j_sz = unsafe { (*lp_j).block_count };
                    if j_sz < best_size {
                        best_size = j_sz;
                        best_parent = lj as u32;
                    }
                }
            }
            lj = lj + 1;
        }
        unsafe { (*lp_i).parent = LoopId { v: best_parent }; }
        li = li + 1;
    }

    let root_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(if loop_cnt == 0 { 1 } else { loop_cnt }, size_of<LoopId>()), align_of<LoopId>()) as *mut LoopId;
    let mut root_cnt: usize = 0;
    li = 0;
    while li < loop_cnt {
        let lp_i = unsafe { loop_desc_at(loop_arr, li) };
        let mut d: u32 = 1u32;
        let mut cur_p = unsafe { (*lp_i).parent.v };
        let mut guard: usize = 0;
        while cur_p != LOOP_NONE && (cur_p as usize) < loop_cnt && guard <= loop_cnt {
            d = d + 1u32;
            cur_p = unsafe { (*loop_desc_at(loop_arr, cur_p as usize)).parent.v };
            guard = guard + 1;
        }
        unsafe { (*lp_i).depth = d; }
        if (unsafe { (*lp_i).parent.v }) == LOOP_NONE {
            unsafe { *loop_id_at(root_arr, root_cnt) = LoopId { v: li as u32 }; }
            root_cnt = root_cnt + 1;
        }
        let child_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(if loop_cnt == 0 { 1 } else { loop_cnt }, size_of<LoopId>()), align_of<LoopId>()) as *mut LoopId;
        let mut c_cnt: usize = 0;
        let mut lk: usize = 0;
        while lk < loop_cnt {
            if (unsafe { (*loop_desc_at(loop_arr, lk)).parent.v }) == (li as u32) {
                unsafe { *loop_id_at(child_arr, c_cnt) = LoopId { v: lk as u32 }; }
                c_cnt = c_cnt + 1;
            }
            lk = lk + 1;
        }
        unsafe {
            (*lp_i).children = child_arr;
            (*lp_i).child_count = c_cnt;
        }
        li = li + 1;
    }

    // Populate block_loop_map with innermost loop (largest depth / smallest block_count)
    let mut b: usize = 0;
    while b < n {
        let mut best_lid: u32 = LOOP_NONE;
        let mut best_blk_sz: usize = n + 1;
        li = 0;
        while li < loop_cnt {
            let lp_i = unsafe { loop_desc_at(loop_arr, li) };
            let bsz = unsafe { (*lp_i).block_count };
            if lp_block_in_set(unsafe { (*lp_i).blocks }, bsz, b as u32) && bsz < best_blk_sz {
                best_blk_sz = bsz;
                best_lid = li as u32;
            }
            li = li + 1;
        }
        unsafe { *loop_id_at(bmap, b) = LoopId { v: best_lid }; }
        b = b + 1;
    }

    unsafe {
        (*tree).loops = loop_arr;
        (*tree).loop_count = loop_cnt;
        (*tree).root_loops = root_arr;
        (*tree).root_count = root_cnt;
    }
    tree
}

pub fn loops_discover(
    body: view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    arena: mut_view<Arena>
) -> *mut LoopTree {
    loops_discover_with_domain(body, call_table, alias_info, EXEC_DOMAIN_HOST, mut_view(*arena))
}

// --- Loop Canonicalization & LCSSA (`opt_loop_simplify`, AXS-LOOP-003..005, REQ-OPT-189) ---

fn lp_append_goto_block(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    target_bb: OptBbId,
    ref_span: view<Span>
) -> OptBbId {
    let old_cnt = body.bb_count;
    let new_cnt = old_cnt + 1;
    let new_blocks = arena_alloc_raw(
        mut_view(*arena),
        lp_mul_usize(new_cnt, size_of<OptBlock>()),
        align_of<OptBlock>()
    ) as *mut OptBlock;
    if old_cnt > 0 && (body.blocks as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(
                body.blocks as *const u8,
                new_blocks as *mut u8,
                lp_mul_usize(old_cnt, size_of<OptBlock>())
            );
        }
    }
    body.blocks = new_blocks;
    body.bb_count = new_cnt;

    let new_id = OptBbId { v: old_cnt as u32 };
    let nbb = unsafe { opt_block_at(body.blocks, old_cnt) };
    let mut loc = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    mir_span_copy(mut_view(loc), ref_span);

    unsafe {
        (*nbb).id = new_id;
        (*nbb).is_cleanup = false;
        (*nbb).is_reachable = true;
        (*nbb).preds = 0 as *mut OptBbId;
        (*nbb).pred_count = 0;
        (*nbb).succs = 0 as *mut OptBbId;
        (*nbb).succ_count = 0;
        (*nbb).phis = 0 as *mut OptPhi;
        (*nbb).phi_count = 0;
        (*nbb).phi_cap = 0;
        (*nbb).has_mem_phi = false;
        (*nbb).mem_phi_result = MemSsaId { v: MEM_SSA_NONE };
        (*nbb).mem_phi_inputs = 0 as *mut MemSsaId;
        (*nbb).mem_in = MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY };
        (*nbb).mem_out = MemSsaId { v: MEM_SSA_LIVE_ON_ENTRY };
        (*nbb).insts = 0 as *mut OptInst;
        (*nbb).inst_count = 0;
        (*nbb).inst_cap = 0;
        (*nbb).has_term = true;
        (*nbb).idom = OptBbId { v: 0u32 };
        (*nbb).dom_depth = 0u32;
        (*nbb).rpo_idx = 0u32;
        (*nbb).dom_frontier = 0 as *mut OptBbId;
        (*nbb).dom_frontier_count = 0;

        mir_term_reset(mut_view((*nbb).term.orig_term), MIR_TERM_GOTO, view(loc));
        (*nbb).term.orig_term.goto_target = MirBbId { v: target_bb.v };
        (*nbb).term.kind = OPT_TERM_GOTO;
        (*nbb).term.cond = OptValueId { v: OPT_VALUE_NONE };
        (*nbb).term.true_bb = target_bb;
        (*nbb).term.false_bb = OptBbId { v: OPT_BB_NONE };
        (*nbb).term.switch_ty = TypeId { v: 0u32 };
        (*nbb).term.switch_vals = 0 as *mut u64;
        (*nbb).term.switch_targets = 0 as *mut OptBbId;
        (*nbb).term.switch_count = 0;
        (*nbb).term.otherwise_bb = OptBbId { v: OPT_BB_NONE };
        (*nbb).term.callee = OptValueId { v: OPT_VALUE_NONE };
        (*nbb).term.call_args = 0 as *mut OptValueId;
        (*nbb).term.call_arg_count = 0;
        (*nbb).term.call_result = OptValueId { v: OPT_VALUE_NONE };
        (*nbb).term.call_dest = mir_local_place(0u32);
        (*nbb).term.has_call_dest = false;
        (*nbb).term.unwind_bb = OptBbId { v: OPT_BB_NONE };
        (*nbb).term.drop_place = mir_local_place(0u32);
        (*nbb).term.drop_flag = MIR_DROP_FLAG_NONE;
        (*nbb).term.drop_is_explicit = false;
        (*nbb).term.assert_expected = true;
        (*nbb).term.assert_msg_ptr = 0 as *const u8;
        (*nbb).term.assert_msg_len = 0;
        (*nbb).term.mem_use = MemSsaId { v: MEM_SSA_NONE };
        (*nbb).term.mem_def = MemSsaId { v: MEM_SSA_NONE };
        (*nbb).term.origin = OptOrigin {
            span: loc,
            mir_bb: MirBbId { v: new_id.v },
            mir_stmt_idx: 0u32,
            pass_id: PASS_LOOP_SIMPLIFY,
        };
    }
    new_id
}

fn lp_redirect_orig_switch_targets(bb: mut_view<OptBlock>, arena: mut_view<Arena>, old_v: u32, new_v: u32) {
    let sc = bb.term.orig_term.switch_count;
    if sc > 0 && (bb.term.orig_term.targets as usize) != 0 {
        let new_tgts = arena_alloc_raw(
            mut_view(*arena),
            lp_mul_usize(sc, size_of<MirBbId>()),
            align_of<MirBbId>()
        ) as *mut MirBbId;
        let mut k: usize = 0;
        while k < sc {
            let tv = unsafe { (*mir_bb_id_at(bb.term.orig_term.targets, k)).v };
            let repl_v: u32 = if tv == old_v { new_v } else { tv };
            unsafe { *mir_bb_id_at(new_tgts, k) = MirBbId { v: repl_v }; }
            k = k + 1;
        }
        bb.term.orig_term.targets = new_tgts;
    }
    if bb.term.orig_term.otherwise.v == old_v {
        bb.term.orig_term.otherwise = MirBbId { v: new_v };
    }
}

fn lp_redirect_normal_edge(bb: mut_view<OptBlock>, arena: mut_view<Arena>, old_tgt: OptBbId, new_tgt: OptBbId) -> bool {
    if !bb.has_term || bb.is_cleanup {
        return false;
    }
    let old_v = old_tgt.v;
    let new_v = new_tgt.v;
    let mut changed = false;
    let tk = bb.term.kind;
    if tk == OPT_TERM_GOTO {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = new_tgt;
            bb.term.orig_term.goto_target = MirBbId { v: new_v };
            changed = true;
        }
    } else if tk == OPT_TERM_BRANCH {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = new_tgt;
            changed = true;
        }
        if bb.term.false_bb.v == old_v {
            bb.term.false_bb = new_tgt;
            changed = true;
        }
        if changed {
            lp_redirect_orig_switch_targets(mut_view(*bb), mut_view(*arena), old_v, new_v);
        }
    } else if tk == OPT_TERM_SWITCH_INT {
        let swc = bb.term.switch_count;
        if swc > 0 && (bb.term.switch_targets as usize) != 0 {
            let new_sw = arena_alloc_raw(
                mut_view(*arena),
                lp_mul_usize(swc, size_of<OptBbId>()),
                align_of<OptBbId>()
            ) as *mut OptBbId;
            let mut k: usize = 0;
            while k < swc {
                let sv = unsafe { (*opt_bbid_at(bb.term.switch_targets, k)).v };
                if sv == old_v {
                    unsafe { *opt_bbid_at(new_sw, k) = new_tgt; }
                    changed = true;
                } else {
                    unsafe { *opt_bbid_at(new_sw, k) = OptBbId { v: sv }; }
                }
                k = k + 1;
            }
            bb.term.switch_targets = new_sw;
        }
        if bb.term.otherwise_bb.v == old_v {
            bb.term.otherwise_bb = new_tgt;
            changed = true;
        }
        if changed {
            lp_redirect_orig_switch_targets(mut_view(*bb), mut_view(*arena), old_v, new_v);
        }
    } else if tk == OPT_TERM_CALL {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = new_tgt;
            bb.term.orig_term.call_target = MirBbId { v: new_v };
            changed = true;
        }
    } else if tk == OPT_TERM_ASSERT {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = new_tgt;
            bb.term.orig_term.assert_target = MirBbId { v: new_v };
            changed = true;
        }
    } else if tk == OPT_TERM_DROP {
        if bb.term.true_bb.v == old_v {
            bb.term.true_bb = new_tgt;
            bb.term.orig_term.drop_target = MirBbId { v: new_v };
            changed = true;
        }
    }
    changed
}

fn lp_push_phi_to_block(bb: mut_view<OptBlock>, arena: mut_view<Arena>, phi: OptPhi) {
    if bb.phi_count >= bb.phi_cap {
        let new_cap: usize = if bb.phi_cap == 0 { 4 } else { bb.phi_cap + bb.phi_cap };
        let new_phis = arena_alloc_raw(
            mut_view(*arena),
            lp_mul_usize(new_cap, size_of<OptPhi>()),
            align_of<OptPhi>()
        ) as *mut OptPhi;
        if bb.phi_count > 0 && (bb.phis as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    bb.phis as *const u8,
                    new_phis as *mut u8,
                    lp_mul_usize(bb.phi_count, size_of<OptPhi>())
                );
            }
        }
        bb.phis = new_phis;
        bb.phi_cap = new_cap;
    }
    let idx = bb.phi_count;
    bb.phi_count = idx + 1;
    unsafe { *opt_phi_at(bb.phis, idx) = phi; }
}

fn lp_zero_const(ty: TypeId) -> MirConst {
    MirConst {
        ty: ty,
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: SymbolId { v: 0u32 },
    }
}

// Splits incoming edges `sub_preds[0..sub_cnt] -> target_bb` through a fresh GOTO block `mid_bb -> target_bb`,
// updating both OptIR/MIR terminators and splitting `OptPhi` nodes on `target_bb`.
fn lp_split_edge_subset(
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    target_bb: OptBbId,
    sub_preds: *mut OptBbId,
    sub_cnt: usize
) -> OptBbId {
    if sub_cnt == 0 || (target_bb.v as usize) >= body.bb_count {
        return OptBbId { v: OPT_BB_NONE };
    }
    let mut ref_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    let tbb_pre = unsafe { opt_block_at(body.blocks, target_bb.v as usize) };
    mir_span_copy(mut_view(ref_span), unsafe { view((*tbb_pre).term.orig_term.location) });

    let mid_id = lp_append_goto_block(mut_view(*body), mut_view(*arena), target_bb, view(ref_span));

    // Redirect each predecessor in `sub_preds` from `target_bb` to `mid_id`
    let mut s: usize = 0;
    while s < sub_cnt {
        let pv = unsafe { (*opt_bbid_at(sub_preds, s)).v };
        if (pv as usize) < body.bb_count {
            let pbb = unsafe { opt_block_at(body.blocks, pv as usize) };
            let _ = lp_redirect_normal_edge(unsafe { mut_view(*pbb) }, mut_view(*arena), target_bb, mid_id);
        }
        s = s + 1;
    }

    // Split OptPhis on `target_bb`
    let tbb = unsafe { opt_block_at(body.blocks, target_bb.v as usize) };
    let phi_cnt = unsafe { (*tbb).phi_count };
    let mut pi: usize = 0;
    while pi < phi_cnt {
        let phi_ptr = unsafe { opt_phi_at((*tbb).phis, pi) };
        let old_arity = unsafe { (*phi_ptr).arity };
        let old_ib = unsafe { (*phi_ptr).incoming_blocks };
        let old_iv = unsafe { (*phi_ptr).incoming_values };
        let phi_ty_v = unsafe { (*phi_ptr).ty.v };
        let phi_loc_v = unsafe { (*phi_ptr).src_local.v };
        let phi_fld = unsafe { (*phi_ptr).proj_field };
        let phi_slot = unsafe { (*phi_ptr).slot_idx };
        let mut phi_orig = unsafe { (*phi_ptr).origin };
        phi_orig.pass_id = PASS_LOOP_SIMPLIFY;

        let sub_ib = arena_alloc_raw(mut_view(*arena), lp_mul_usize(sub_cnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
        let sub_iv = arena_alloc_raw(mut_view(*arena), lp_mul_usize(sub_cnt, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
        let rem_cap = old_arity + 1;
        let rem_ib = arena_alloc_raw(mut_view(*arena), lp_mul_usize(rem_cap, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
        let rem_iv = arena_alloc_raw(mut_view(*arena), lp_mul_usize(rem_cap, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;

        let mut got_sub: usize = 0;
        let mut got_rem: usize = 0;
        let mut k: usize = 0;
        while k < old_arity {
            let ib_id = unsafe { *opt_bbid_at(old_ib, k) };
            let iv_id = unsafe { *opt_valid_at(old_iv, k) };
            if lp_block_in_set(sub_preds, sub_cnt, ib_id.v) {
                unsafe {
                    *opt_bbid_at(sub_ib, got_sub) = ib_id;
                    *opt_valid_at(sub_iv, got_sub) = iv_id;
                }
                got_sub = got_sub + 1;
            } else {
                unsafe {
                    *opt_bbid_at(rem_ib, got_rem) = ib_id;
                    *opt_valid_at(rem_iv, got_rem) = iv_id;
                }
                got_rem = got_rem + 1;
            }
            k = k + 1;
        }

        if got_sub > 0 {
            let mut mid_val = unsafe { *opt_valid_at(sub_iv, 0) };
            if got_sub >= 2 {
                let zc = lp_zero_const(TypeId { v: phi_ty_v });
                mid_val = optir_alloc_value(
                    mut_view(*body),
                    mut_view(*arena),
                    TypeId { v: phi_ty_v },
                    OPT_VAL_PHI,
                    mid_id,
                    OptInstId { v: OPT_INST_NONE },
                    MirLocalId { v: phi_loc_v },
                    phi_fld,
                    view(zc),
                    view(phi_orig)
                );
                let mid_phi = OptPhi {
                    result: mid_val,
                    ty: TypeId { v: phi_ty_v },
                    src_local: MirLocalId { v: phi_loc_v },
                    proj_field: phi_fld,
                    slot_idx: phi_slot,
                    incoming_values: sub_iv,
                    incoming_blocks: sub_ib,
                    arity: got_sub,
                    origin: phi_orig,
                };
                let mbb = unsafe { opt_block_at(body.blocks, mid_id.v as usize) };
                lp_push_phi_to_block(unsafe { mut_view(*mbb) }, mut_view(*arena), mid_phi);
            }
            // `mid_id.v` is strictly greater than all existing block IDs so appending preserves ascending sort
            let tbb_cur = unsafe { opt_block_at(body.blocks, target_bb.v as usize) };
            let phi_cur = unsafe { opt_phi_at((*tbb_cur).phis, pi) };
            unsafe {
                *opt_bbid_at(rem_ib, got_rem) = mid_id;
                *opt_valid_at(rem_iv, got_rem) = mid_val;
                (*phi_cur).incoming_blocks = rem_ib;
                (*phi_cur).incoming_values = rem_iv;
                (*phi_cur).arity = got_rem + 1;
            }
        }
        pi = pi + 1;
    }

    mid_id
}

// Special handling when `bb0` itself is a loop header: hoist `bb0` contents into `new_hdr`
// so `bb0` becomes an empty `GOTO -> new_hdr` preheader while remaining the function entry block.
fn lp_hoist_bb0_loop_header(body: mut_view<OptBody>, arena: mut_view<Arena>) -> OptBbId {
    let bb0_pre = unsafe { opt_block_at(body.blocks, 0) };
    let mut ref_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    mir_span_copy(mut_view(ref_span), unsafe { view((*bb0_pre).term.orig_term.location) });

    let new_hdr = lp_append_goto_block(mut_view(*body), mut_view(*arena), OptBbId { v: 0u32 }, view(ref_span));
    let bb0 = unsafe { opt_block_at(body.blocks, 0) };
    let nhbb = unsafe { opt_block_at(body.blocks, new_hdr.v as usize) };

    // Move instructions and terminator from bb0 to new_hdr
    unsafe {
        (*nhbb).insts = (*bb0).insts;
        (*nhbb).inst_count = (*bb0).inst_count;
        (*nhbb).inst_cap = (*bb0).inst_cap;
        (*nhbb).term = (*bb0).term;
        (*nhbb).has_term = (*bb0).has_term;
        (*nhbb).phis = (*bb0).phis;
        (*nhbb).phi_count = (*bb0).phi_count;
        (*nhbb).phi_cap = (*bb0).phi_cap;

        (*bb0).insts = 0 as *mut OptInst;
        (*bb0).inst_count = 0;
        (*bb0).inst_cap = 0;
        (*bb0).phis = 0 as *mut OptPhi;
        (*bb0).phi_count = 0;
        (*bb0).phi_cap = 0;
        mir_term_reset(mut_view((*bb0).term.orig_term), MIR_TERM_GOTO, view(ref_span));
        (*bb0).term.orig_term.goto_target = MirBbId { v: new_hdr.v };
        (*bb0).term.kind = OPT_TERM_GOTO;
        (*bb0).term.true_bb = new_hdr;
        (*bb0).term.false_bb = OptBbId { v: OPT_BB_NONE };
        (*bb0).term.otherwise_bb = OptBbId { v: OPT_BB_NONE };
        (*bb0).term.unwind_bb = OptBbId { v: OPT_BB_NONE };
        (*bb0).term.cond = OptValueId { v: OPT_VALUE_NONE };
        (*bb0).term.callee = OptValueId { v: OPT_VALUE_NONE };
        (*bb0).term.call_arg_count = 0;
        (*bb0).term.switch_count = 0;
    }

    // Update def_bb for non-param values originally defined in bb0
    let mut v_idx: usize = 1;
    while v_idx <= body.value_count {
        let vp = unsafe { opt_val_at(body.values, v_idx) };
        let vk = unsafe { (*vp).kind };
        if vk != OPT_VAL_PARAM && (unsafe { (*vp).def_bb.v }) == 0u32 {
            unsafe { (*vp).def_bb = new_hdr; }
        }
        v_idx = v_idx + 1;
    }

    // Redirect all existing normal edges `b -> bb0` (for b >= 1, including new_hdr itself!) to `new_hdr`
    let mut b: usize = 1;
    while b < body.bb_count {
        let bptr = unsafe { opt_block_at(body.blocks, b) };
        let _ = lp_redirect_normal_edge(unsafe { mut_view(*bptr) }, mut_view(*arena), OptBbId { v: 0u32 }, new_hdr);
        b = b + 1;
    }

    // Add incoming `(bb0: entry_val)` at index 0 of each OptPhi moved to `new_hdr`
    let nhbb2 = unsafe { opt_block_at(body.blocks, new_hdr.v as usize) };
    let pcnt = unsafe { (*nhbb2).phi_count };
    let mut pi: usize = 0;
    while pi < pcnt {
        let phi = unsafe { opt_phi_at((*nhbb2).phis, pi) };
        let old_ar = unsafe { (*phi).arity };
        let old_ib = unsafe { (*phi).incoming_blocks };
        let old_iv = unsafe { (*phi).incoming_values };
        let p_ty_v = unsafe { (*phi).ty.v };
        let p_loc = unsafe { (*phi).src_local };
        let p_fld = unsafe { (*phi).proj_field };
        let p_orig = unsafe { (*phi).origin };

        let mut init_val = OptValueId { v: OPT_VALUE_NONE };
        let mut scan_v: usize = 1;
        while scan_v <= body.value_count {
            let sv = unsafe { opt_val_at(body.values, scan_v) };
            if (unsafe { (*sv).kind }) == OPT_VAL_PARAM &&
               (unsafe { (*sv).src_local.v }) == p_loc.v &&
               (unsafe { (*sv).proj_field }) == p_fld {
                init_val = OptValueId { v: scan_v as u32 };
                break;
            }
            scan_v = scan_v + 1;
        }
        if init_val.v == OPT_VALUE_NONE {
            let zc = lp_zero_const(TypeId { v: p_ty_v });
            init_val = optir_alloc_value(
                mut_view(*body), mut_view(*arena), TypeId { v: p_ty_v }, OPT_VAL_CONST,
                OptBbId { v: 0u32 }, OptInstId { v: OPT_INST_NONE },
                MirLocalId { v: 0u32 }, OPT_PROJ_NONE, view(zc), view(p_orig)
            );
        }

        let nhbb3 = unsafe { opt_block_at(body.blocks, new_hdr.v as usize) };
        let phi3 = unsafe { opt_phi_at((*nhbb3).phis, pi) };
        let new_ar = old_ar + 1;
        let new_ib = arena_alloc_raw(mut_view(*arena), lp_mul_usize(new_ar, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
        let new_iv = arena_alloc_raw(mut_view(*arena), lp_mul_usize(new_ar, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
        unsafe {
            *opt_bbid_at(new_ib, 0) = OptBbId { v: 0u32 };
            *opt_valid_at(new_iv, 0) = init_val;
        }
        let mut k: usize = 0;
        while k < old_ar {
            let ib_k = unsafe { *opt_bbid_at(old_ib, k) };
            let fixed_ib: OptBbId = if ib_k.v == 0u32 { new_hdr } else { ib_k };
            unsafe {
                *opt_bbid_at(new_ib, k + 1) = fixed_ib;
                *opt_valid_at(new_iv, k + 1) = *opt_valid_at(old_iv, k);
            }
            k = k + 1;
        }
        unsafe {
            (*phi3).incoming_blocks = new_ib;
            (*phi3).incoming_values = new_iv;
            (*phi3).arity = new_ar;
        }
        pi = pi + 1;
    }

    new_hdr
}

fn lp_rebuild_cfg_dom_memssa(body: mut_view<OptBody>, arena: mut_view<Arena>) {
    optir_compute_cfg(mut_view(*body), mut_view(*arena));

    // Synchronize OptPhi incoming arrays to exact sorted `bb.preds` order
    let n = body.bb_count;
    let mut b: usize = 0;
    while b < n {
        let sbb = unsafe { opt_block_at(body.blocks, b) };
        let new_pcnt = unsafe { (*sbb).pred_count };
        let new_preds = unsafe { (*sbb).preds };
        let pcnt = unsafe { (*sbb).phi_count };
        if new_pcnt == 0 {
            unsafe { (*sbb).phi_count = 0; }
        } else if pcnt > 0 {
            let phis = unsafe { opt_phi_at((*sbb).phis, 0) };
            let _ = phis;
            let mut pi: usize = 0;
            while pi < pcnt {
                let phi = unsafe { opt_phi_at((*sbb).phis, pi) };
                let old_ar = unsafe { (*phi).arity };
                let old_ib = unsafe { (*phi).incoming_blocks };
                let old_iv = unsafe { (*phi).incoming_values };
                let new_ib = arena_alloc_raw(mut_view(*arena), lp_mul_usize(new_pcnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                let new_iv = arena_alloc_raw(mut_view(*arena), lp_mul_usize(new_pcnt, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
                let mut np: usize = 0;
                while np < new_pcnt {
                    let pb_v = unsafe { (*opt_bbid_at(new_preds, np)).v };
                    let mut matched = OptValueId { v: OPT_VALUE_NONE };
                    let mut ok_i: usize = 0;
                    while ok_i < old_ar {
                        if (unsafe { (*opt_bbid_at(old_ib, ok_i)).v }) == pb_v {
                            matched = unsafe { *opt_valid_at(old_iv, ok_i) };
                            break;
                        }
                        ok_i = ok_i + 1;
                    }
                    unsafe {
                        *opt_bbid_at(new_ib, np) = OptBbId { v: pb_v };
                        *opt_valid_at(new_iv, np) = matched;
                    }
                    np = np + 1;
                }
                unsafe {
                    (*phi).arity = new_pcnt;
                    (*phi).incoming_blocks = new_ib;
                    (*phi).incoming_values = new_iv;
                }
                pi = pi + 1;
            }
        }
        b = b + 1;
    }

    optir_compute_dominators(mut_view(*body), mut_view(*arena));
    optir_compute_dom_frontier(mut_view(*body), mut_view(*arena));
    optir_construct_memssa(mut_view(*body), mut_view(*arena));
}

fn lp_val_has_outside_use(body: view<OptBody>, lp_blocks: *mut OptBbId, lp_cnt: usize, val_v: u32) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if (unsafe { (*bb).is_reachable }) && !(unsafe { (*bb).is_cleanup }) &&
           !lp_block_in_set(lp_blocks, lp_cnt, b as u32) {
            let pcnt = unsafe { (*bb).phi_count };
            let mut p: usize = 0;
            while p < pcnt {
                let phi = unsafe { opt_phi_at((*bb).phis, p) };
                let ar = unsafe { (*phi).arity };
                let mut k: usize = 0;
                while k < ar {
                    let ib_v = unsafe { (*opt_bbid_at((*phi).incoming_blocks, k)).v };
                    let iv_v = unsafe { (*opt_valid_at((*phi).incoming_values, k)).v };
                    if iv_v == val_v && !lp_block_in_set(lp_blocks, lp_cnt, ib_v) {
                        return true;
                    }
                    k = k + 1;
                }
                p = p + 1;
            }
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                if (unsafe { (*inst).opcode }) != OPT_INST_NOP {
                    if (unsafe { (*inst).lhs.v }) == val_v || (unsafe { (*inst).rhs.v }) == val_v {
                        return true;
                    }
                    let eac = unsafe { (*inst).extra_arg_count };
                    let mut ei: usize = 0;
                    while ei < eac {
                        if (unsafe { (*opt_valid_at((*inst).extra_args, ei)).v }) == val_v {
                            return true;
                        }
                        ei = ei + 1;
                    }
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_BRANCH || tk == OPT_TERM_SWITCH_INT || tk == OPT_TERM_ASSERT {
                    if (unsafe { (*bb).term.cond.v }) == val_v {
                        return true;
                    }
                } else if tk == OPT_TERM_CALL {
                    if (unsafe { (*bb).term.callee.v }) == val_v {
                        return true;
                    }
                    let cac = unsafe { (*bb).term.call_arg_count };
                    let mut ci: usize = 0;
                    while ci < cac {
                        if (unsafe { (*opt_valid_at((*bb).term.call_args, ci)).v }) == val_v {
                            return true;
                        }
                        ci = ci + 1;
                    }
                }
            }
        }
        b = b + 1;
    }
    false
}

fn lp_rename_outside_uses_dom(
    body: mut_view<OptBody>,
    lp_blocks: *mut OptBbId,
    lp_cnt: usize,
    old_val_v: u32,
    b_idx: usize,
    in_val: OptValueId,
    seed_vals: *mut OptValueId,
    join_phi_idx: *mut u32
) {
    let in_loop = lp_block_in_set(lp_blocks, lp_cnt, b_idx as u32);
    let mut cur_val = in_val;
    if !in_loop {
        let sv = unsafe { (*opt_valid_at(seed_vals, b_idx)).v };
        if sv != OPT_VALUE_NONE {
            cur_val = OptValueId { v: sv };
        }
    }

    let bb = unsafe { opt_block_at(body.blocks, b_idx) };
    if !in_loop && cur_val.v != OPT_VALUE_NONE {
        let icnt = unsafe { (*bb).inst_count };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*bb).insts, i) };
            if (unsafe { (*inst).opcode }) != OPT_INST_NOP {
                if (unsafe { (*inst).lhs.v }) == old_val_v {
                    unsafe { (*inst).lhs = cur_val; }
                }
                if (unsafe { (*inst).rhs.v }) == old_val_v {
                    unsafe { (*inst).rhs = cur_val; }
                }
                let eac = unsafe { (*inst).extra_arg_count };
                let mut ei: usize = 0;
                while ei < eac {
                    if (unsafe { (*opt_valid_at((*inst).extra_args, ei)).v }) == old_val_v {
                        unsafe { *opt_valid_at((*inst).extra_args, ei) = cur_val; }
                    }
                    ei = ei + 1;
                }
            }
            i = i + 1;
        }
        if unsafe { (*bb).has_term } {
            let tk = unsafe { (*bb).term.kind };
            if tk == OPT_TERM_BRANCH || tk == OPT_TERM_SWITCH_INT || tk == OPT_TERM_ASSERT {
                if (unsafe { (*bb).term.cond.v }) == old_val_v {
                    unsafe { (*bb).term.cond = cur_val; }
                }
            } else if tk == OPT_TERM_CALL {
                if (unsafe { (*bb).term.callee.v }) == old_val_v {
                    unsafe { (*bb).term.callee = cur_val; }
                }
                let cac = unsafe { (*bb).term.call_arg_count };
                let mut ci: usize = 0;
                while ci < cac {
                    if (unsafe { (*opt_valid_at((*bb).term.call_args, ci)).v }) == old_val_v {
                        unsafe { *opt_valid_at((*bb).term.call_args, ci) = cur_val; }
                    }
                    ci = ci + 1;
                }
            }
        }

        // Populate incoming operands of both existing outside OptPhis and newly created IDF join OptPhis
        let sc = unsafe { (*bb).succ_count };
        let mut s: usize = 0;
        while s < sc {
            let sid = (unsafe { (*opt_bbid_at((*bb).succs, s)).v }) as usize;
            if sid < body.bb_count && !lp_block_in_set(lp_blocks, lp_cnt, sid as u32) {
                let sbb = unsafe { opt_block_at(body.blocks, sid) };
                let sp_cnt = unsafe { (*sbb).phi_count };
                let j_pidx = unsafe { *opt_u32_at(join_phi_idx, sid) };
                let mut sp: usize = 0;
                while sp < sp_cnt {
                    let sphi = unsafe { opt_phi_at((*sbb).phis, sp) };
                    let ar = unsafe { (*sphi).arity };
                    let mut k: usize = 0;
                    while k < ar {
                        if (unsafe { (*opt_bbid_at((*sphi).incoming_blocks, k)).v }) == (b_idx as u32) {
                            if (sp as u32) == j_pidx || (unsafe { (*opt_valid_at((*sphi).incoming_values, k)).v }) == old_val_v {
                                unsafe { *opt_valid_at((*sphi).incoming_values, k) = cur_val; }
                            }
                        }
                        k = k + 1;
                    }
                    sp = sp + 1;
                }
            }
            s = s + 1;
        }
    }

    let mut c: usize = 0;
    while c < body.bb_count {
        if c != b_idx {
            let cbb = unsafe { opt_block_at(body.blocks, c) };
            if (unsafe { (*cbb).is_reachable }) && !(unsafe { (*cbb).is_cleanup }) &&
               (unsafe { (*cbb).idom.v }) == (b_idx as u32) {
                lp_rename_outside_uses_dom(
                    mut_view(*body), lp_blocks, lp_cnt, old_val_v,
                    c, cur_val, seed_vals, join_phi_idx
                );
            }
        }
        c = c + 1;
    }
}

fn lp_establish_lcssa_for_loop(
    body: mut_view<OptBody>,
    lp: view<LoopDesc>,
    arena: mut_view<Arena>
) -> u32 {
    if lp.is_irreducible || lp.exit_count == 0 {
        return 0u32;
    }
    let n = body.bb_count;
    let orig_vcnt = body.value_count;
    let seed_vals = arena_alloc_raw(mut_view(*arena), lp_mul_usize(n, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
    let join_phi_idx = arena_alloc_raw(mut_view(*arena), lp_mul_usize(n, size_of<u32>()), align_of<u32>()) as *mut u32;
    let in_work = arena_alloc_raw(mut_view(*arena), lp_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let work = arena_alloc_raw(mut_view(*arena), lp_mul_usize(n, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;

    let mut inserted: u32 = 0u32;
    let mut val_i: usize = 1;
    while val_i <= orig_vcnt {
        let vp_chk = unsafe { opt_val_at(body.values, val_i) };
        let vk = unsafe { (*vp_chk).kind };
        let def_bb = unsafe { (*vp_chk).def_bb };
        if (vk == OPT_VAL_INST || vk == OPT_VAL_PHI) &&
           lp_block_in_set(lp.blocks, lp.block_count, def_bb.v) &&
           lp_val_has_outside_use(view(*body), lp.blocks, lp.block_count, val_i as u32) {
            let v_ty_v = unsafe { (*vp_chk).ty.v };
            let v_loc_v = unsafe { (*vp_chk).src_local.v };
            let v_fld = unsafe { (*vp_chk).proj_field };
            let mut v_orig = unsafe { (*vp_chk).origin };
            v_orig.pass_id = PASS_LOOP_SIMPLIFY;

            let mut b: usize = 0;
            while b < n {
                unsafe {
                    *opt_valid_at(seed_vals, b) = OptValueId { v: OPT_VALUE_NONE };
                    *opt_u32_at(join_phi_idx, b) = OPT_INST_NONE;
                    *opt_bool_at(in_work, b) = false;
                }
                b = b + 1;
            }

            // 1. Place LCSSA boundary OptPhi in every dedicated exit block dominated by `def_bb`
            let mut w_len: usize = 0;
            let mut e: usize = 0;
            while e < lp.exit_count {
                let ex_id = unsafe { *opt_bbid_at(lp.exit_blocks, e) };
                let ex_u = ex_id.v as usize;
                if ex_u < n && opt_dominates(view(*body), def_bb, ex_id) {
                    let ebb = unsafe { opt_block_at(body.blocks, ex_u) };
                    let pcnt = unsafe { (*ebb).pred_count };
                    if pcnt > 0 {
                        // Reuse existing identical LCSSA OptPhi if present
                        let mut existing_res = OptValueId { v: OPT_VALUE_NONE };
                        let ep_cnt = unsafe { (*ebb).phi_count };
                        let mut epi: usize = 0;
                        while epi < ep_cnt {
                            let ephi = unsafe { opt_phi_at((*ebb).phis, epi) };
                            if (unsafe { (*ephi).arity }) == pcnt {
                                let mut all_same = true;
                                let mut kk: usize = 0;
                                while kk < pcnt {
                                    if (unsafe { (*opt_valid_at((*ephi).incoming_values, kk)).v }) != (val_i as u32) {
                                        all_same = false;
                                        break;
                                    }
                                    kk = kk + 1;
                                }
                                if all_same {
                                    existing_res = unsafe { (*ephi).result };
                                    break;
                                }
                            }
                            epi = epi + 1;
                        }

                        if existing_res.v == OPT_VALUE_NONE {
                            let zc = lp_zero_const(TypeId { v: v_ty_v });
                            existing_res = optir_alloc_value(
                                mut_view(*body), mut_view(*arena), TypeId { v: v_ty_v }, OPT_VAL_PHI,
                                ex_id, OptInstId { v: OPT_INST_NONE },
                                MirLocalId { v: v_loc_v }, v_fld, view(zc), view(v_orig)
                            );
                            let ebb2 = unsafe { opt_block_at(body.blocks, ex_u) };
                            let ib = arena_alloc_raw(mut_view(*arena), lp_mul_usize(pcnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                            let iv = arena_alloc_raw(mut_view(*arena), lp_mul_usize(pcnt, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
                            let mut kk: usize = 0;
                            while kk < pcnt {
                                unsafe {
                                    *opt_bbid_at(ib, kk) = *opt_bbid_at((*ebb2).preds, kk);
                                    *opt_valid_at(iv, kk) = OptValueId { v: val_i as u32 };
                                }
                                kk = kk + 1;
                            }
                            let lcssa_phi = OptPhi {
                                result: existing_res,
                                ty: TypeId { v: v_ty_v },
                                src_local: MirLocalId { v: v_loc_v },
                                proj_field: v_fld,
                                slot_idx: OPT_PROJ_NONE,
                                incoming_values: iv,
                                incoming_blocks: ib,
                                arity: pcnt,
                                origin: v_orig,
                            };
                            lp_push_phi_to_block(unsafe { mut_view(*ebb2) }, mut_view(*arena), lcssa_phi);
                            inserted = inserted + 1u32;
                        }
                        unsafe {
                            *opt_valid_at(seed_vals, ex_u) = existing_res;
                            *opt_bool_at(in_work, ex_u) = true;
                            *opt_bbid_at(work, w_len) = ex_id;
                        }
                        w_len = w_len + 1;
                    }
                }
                e = e + 1;
            }

            // 2. Place multi-exit join OptPhis on IDF({exit_blocks}) strictly dominated by `def_bb`
            let mut w_idx: usize = 0;
            while w_idx < w_len {
                let x_id = unsafe { *opt_bbid_at(work, w_idx) };
                w_idx = w_idx + 1;
                let xbb = unsafe { opt_block_at(body.blocks, x_id.v as usize) };
                let df_cnt = unsafe { (*xbb).dom_frontier_count };
                let mut di: usize = 0;
                while di < df_cnt {
                    let y_id = unsafe { *opt_bbid_at((*xbb).dom_frontier, di) };
                    let yu = y_id.v as usize;
                    if yu < n && !lp_block_in_set(lp.blocks, lp.block_count, y_id.v) &&
                       (unsafe { (*opt_valid_at(seed_vals, yu)).v }) == OPT_VALUE_NONE &&
                       opt_dominates(view(*body), def_bb, y_id) {
                        let ybb = unsafe { opt_block_at(body.blocks, yu) };
                        let y_pcnt = unsafe { (*ybb).pred_count };
                        if y_pcnt >= 2 && !(unsafe { (*ybb).is_cleanup }) {
                            let zc = lp_zero_const(TypeId { v: v_ty_v });
                            let j_res = optir_alloc_value(
                                mut_view(*body), mut_view(*arena), TypeId { v: v_ty_v }, OPT_VAL_PHI,
                                y_id, OptInstId { v: OPT_INST_NONE },
                                MirLocalId { v: v_loc_v }, v_fld, view(zc), view(v_orig)
                            );
                            let ybb2 = unsafe { opt_block_at(body.blocks, yu) };
                            let jib = arena_alloc_raw(mut_view(*arena), lp_mul_usize(y_pcnt, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                            let jiv = arena_alloc_raw(mut_view(*arena), lp_mul_usize(y_pcnt, size_of<OptValueId>()), align_of<OptValueId>()) as *mut OptValueId;
                            let mut kk: usize = 0;
                            while kk < y_pcnt {
                                unsafe {
                                    *opt_bbid_at(jib, kk) = *opt_bbid_at((*ybb2).preds, kk);
                                    *opt_valid_at(jiv, kk) = j_res;
                                }
                                kk = kk + 1;
                            }
                            let j_pidx = (unsafe { (*ybb2).phi_count }) as u32;
                            let j_phi = OptPhi {
                                result: j_res,
                                ty: TypeId { v: v_ty_v },
                                src_local: MirLocalId { v: v_loc_v },
                                proj_field: v_fld,
                                slot_idx: OPT_PROJ_NONE,
                                incoming_values: jiv,
                                incoming_blocks: jib,
                                arity: y_pcnt,
                                origin: v_orig,
                            };
                            lp_push_phi_to_block(unsafe { mut_view(*ybb2) }, mut_view(*arena), j_phi);
                            inserted = inserted + 1u32;
                            unsafe {
                                *opt_valid_at(seed_vals, yu) = j_res;
                                *opt_u32_at(join_phi_idx, yu) = j_pidx;
                            }
                            if !(unsafe { *opt_bool_at(in_work, yu) }) {
                                unsafe {
                                    *opt_bool_at(in_work, yu) = true;
                                    *opt_bbid_at(work, w_len) = y_id;
                                }
                                w_len = w_len + 1;
                            }
                        }
                    }
                    di = di + 1;
                }
            }

            // 3. Rename outside-loop uses via dominator-tree walk rooted at `def_bb`
            if w_len > 0 {
                lp_rename_outside_uses_dom(
                    mut_view(*body), lp.blocks, lp.block_count, val_i as u32,
                    def_bb.v as usize, OptValueId { v: OPT_VALUE_NONE }, seed_vals, join_phi_idx
                );
            }
        }
        val_i = val_i + 1;
    }

    inserted
}

fn lp_canonicalize_one_step(
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    exec_domain: u8,
    stats: mut_view<LoopSimplifyStats>,
    arena: mut_view<Arena>
) -> bool {
    let tree = loops_discover_with_domain(view(*body), call_table, alias_info, exec_domain, mut_view(*arena));
    let lcnt = unsafe { (*tree).loop_count };
    let mut li: usize = 0;
    while li < lcnt {
        let lp = unsafe { loop_desc_at((*tree).loops, li) };
        if !(unsafe { (*lp).is_irreducible }) {
            let hdr = unsafe { (*lp).header };
            // 1. Ensure unique preheader
            if (unsafe { (*lp).preheader.v }) == OPT_BB_NONE {
                if hdr.v == 0u32 {
                    let _ = lp_hoist_bb0_loop_header(mut_view(*body), mut_view(*arena));
                    stats.preheaders_inserted = stats.preheaders_inserted + 1u32;
                    lp_rebuild_cfg_dom_memssa(mut_view(*body), mut_view(*arena));
                    return true;
                }
                let hbb = unsafe { opt_block_at(body.blocks, hdr.v as usize) };
                let pcnt = unsafe { (*hbb).pred_count };
                let out_preds = arena_alloc_raw(mut_view(*arena), lp_mul_usize(if pcnt == 0 { 1 } else { pcnt }, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                let mut out_cnt: usize = 0;
                let mut p: usize = 0;
                while p < pcnt {
                    let pid = unsafe { *opt_bbid_at((*hbb).preds, p) };
                    if (pid.v as usize) < body.bb_count {
                        let pbb = unsafe { opt_block_at(body.blocks, pid.v as usize) };
                        if (unsafe { (*pbb).is_reachable }) && !(unsafe { (*pbb).is_cleanup }) &&
                           !lp_block_in_set(unsafe { (*lp).blocks }, unsafe { (*lp).block_count }, pid.v) {
                            unsafe { *opt_bbid_at(out_preds, out_cnt) = pid; }
                            out_cnt = out_cnt + 1;
                        }
                    }
                    p = p + 1;
                }
                if out_cnt > 0 {
                    let _ = lp_split_edge_subset(mut_view(*body), mut_view(*arena), hdr, out_preds, out_cnt);
                    stats.preheaders_inserted = stats.preheaders_inserted + 1u32;
                    lp_rebuild_cfg_dom_memssa(mut_view(*body), mut_view(*arena));
                    return true;
                }
            }

            // 2. Ensure single merged latch
            if (unsafe { (*lp).latch_count }) >= 2 {
                let _ = lp_split_edge_subset(
                    mut_view(*body), mut_view(*arena), hdr,
                    unsafe { (*lp).latches }, unsafe { (*lp).latch_count }
                );
                stats.latches_merged = stats.latches_merged + 1u32;
                lp_rebuild_cfg_dom_memssa(mut_view(*body), mut_view(*arena));
                return true;
            }

            // 3. Ensure dedicated exit blocks
            let excnt = unsafe { (*lp).exit_count };
            let mut e: usize = 0;
            while e < excnt {
                let ex_id = unsafe { *opt_bbid_at((*lp).exit_blocks, e) };
                let ebb = unsafe { opt_block_at(body.blocks, ex_id.v as usize) };
                let epcnt = unsafe { (*ebb).pred_count };
                let in_preds = arena_alloc_raw(mut_view(*arena), lp_mul_usize(if epcnt == 0 { 1 } else { epcnt }, size_of<OptBbId>()), align_of<OptBbId>()) as *mut OptBbId;
                let mut in_cnt: usize = 0;
                let mut has_out_pred = false;
                let mut ep: usize = 0;
                while ep < epcnt {
                    let pid = unsafe { *opt_bbid_at((*ebb).preds, ep) };
                    if (pid.v as usize) < body.bb_count {
                        let pbb = unsafe { opt_block_at(body.blocks, pid.v as usize) };
                        if (unsafe { (*pbb).is_reachable }) && !(unsafe { (*pbb).is_cleanup }) &&
                           !lp_is_abort_stub_block(unsafe { view(*pbb) }) {
                            if lp_block_in_set(unsafe { (*lp).blocks }, unsafe { (*lp).block_count }, pid.v) {
                                unsafe { *opt_bbid_at(in_preds, in_cnt) = pid; }
                                in_cnt = in_cnt + 1;
                            } else {
                                has_out_pred = true;
                            }
                        }
                    }
                    ep = ep + 1;
                }
                if has_out_pred && in_cnt > 0 {
                    let _ = lp_split_edge_subset(mut_view(*body), mut_view(*arena), ex_id, in_preds, in_cnt);
                    stats.dedicated_exits_inserted = stats.dedicated_exits_inserted + 1u32;
                    lp_rebuild_cfg_dom_memssa(mut_view(*body), mut_view(*arena));
                    return true;
                }
                e = e + 1;
            }
        }
        li = li + 1;
    }
    false
}

fn lp_type_kind(thir: *const Thir, ty: TypeId) -> u8 {
    let tv = ty.v;
    if (thir as usize) != 0 && tv != 0u32 {
        let node = unsafe { type_get(view((*thir).interner), TypeId { v: tv }) };
        if (node as usize) != 0 {
            return unsafe { (*node).kind };
        }
    }
    0u8
}

fn lp_verify_body_capabilities(body: view<OptBody>) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let insts = unsafe { (*bb).insts };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at(insts, i) };
                let opc = unsafe { (*inst).opcode };
                let dlv = (unsafe { (*inst).place.local.v }) as usize;
                if dlv < body.local_count && (body.local_tys as usize) != 0 {
                    let lty = unsafe { *opt_typeid_at(body.local_tys, dlv) };
                    if lp_type_kind(body.thir, lty) == TY_VIEW {
                        if (unsafe { (*inst).place.view_kind }) == MIR_VIEW_MUT {
                            return false;
                        }
                        if opc == OPT_INST_STORE && (unsafe { (*inst).place.proj_count }) > 0 {
                            return false;
                        }
                    }
                }
                let rlv = (unsafe { (*inst).rhs_place.local.v }) as usize;
                if rlv < body.local_count && (body.local_tys as usize) != 0 {
                    let rty = unsafe { *opt_typeid_at(body.local_tys, rlv) };
                    if lp_type_kind(body.thir, rty) == TY_VIEW {
                        if (unsafe { (*inst).rhs_place.view_kind }) == MIR_VIEW_MUT {
                            return false;
                        }
                        if opc == OPT_INST_ADDR_OF && (unsafe { (*inst).sub_op }) == MIR_VIEW_MUT {
                            return false;
                        }
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    true
}

pub fn loops_stamp_valid_analysis_revs(pm: mut_view<PassManager>) {
    if (pm.analysis_revs as usize) == 0 {
        return;
    }
    let mut a: usize = 0;
    while a < ANALYSIS_COUNT {
        if (pm.valid_analyses & analysis_bit(a as u8)) != 0u32 {
            unsafe { *opt_u32_at(pm.analysis_revs, a) = pm.ir_revision; }
        }
        a = a + 1;
    }
}

pub fn loops_verify_pass_postconditions(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    let prev_errs = sink.errors;
    if body.arg_count == 0 {
        let vst = passmgr_verify_postconditions(mut_view(*pm), mut_view(*body), PASS_GVN_CSE, mut_view(*arena), mut_view(*sink));
        if vst != CONTRACT_OK || !optir_verify_contract(view(*body)) {
            sink.errors = prev_errs;
            return false;
        }
        return true;
    }

    pm.verify_run_count = pm.verify_run_count + 1u32;
    if !optir_verify_contract(view(*body)) {
        pm.verify_fail_count = pm.verify_fail_count + 1u32;
        pm.last_verify_status = CONTRACT_ERR_POSTCOND_CFG_DOM;
        return false;
    }
    if !lp_verify_body_capabilities(view(*body)) {
        pm.verify_fail_count = pm.verify_fail_count + 1u32;
        pm.last_verify_status = CONTRACT_ERR_CAPABILITY_PROMOTION;
        return false;
    }
    let cur_eff = effect_infer_body(mut_view(*body), mut_view(*arena), pm.budget.max_symbolic_steps);
    pm.last_effect_summary = cur_eff;
    if pm.has_baseline_effects {
        let cur_vol = cur_eff.volatile_count;
        let base_vol = pm.baseline_effect_summary.volatile_count;
        let cur_ato = cur_eff.atomic_count;
        let base_ato = pm.baseline_effect_summary.atomic_count;
        let cur_io = cur_eff.io_count;
        let base_io = pm.baseline_effect_summary.io_count;
        let cur_drp = cur_eff.drop_count;
        let base_drp = pm.baseline_effect_summary.drop_count;
        if cur_vol < base_vol || cur_ato < base_ato || cur_io < base_io || cur_drp < base_drp {
            pm.verify_fail_count = pm.verify_fail_count + 1u32;
            pm.last_verify_status = CONTRACT_ERR_POSTCOND_EFFECTS;
            return false;
        }
    }
    let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(view(*body), unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
        pm.verify_fail_count = pm.verify_fail_count + 1u32;
        pm.last_verify_status = CONTRACT_ERR_POSTCOND_MIR_VERIFY;
        return false;
    }
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let dummy_bytes = dummy_fn as *mut u8;
    let mut zi: usize = 0;
    while zi < size_of<HirItem>() {
        unsafe { *opt_u8_at(dummy_bytes, zi) = 0u8; }
        zi = zi + 1;
    }
    verify_mir(unsafe { view(*rec_mir) }, body.thir, mut_view(*sink), dummy_fn as *const HirItem);
    if sink.errors != prev_errs {
        sink.errors = prev_errs;
        pm.verify_fail_count = pm.verify_fail_count + 1u32;
        pm.last_verify_status = CONTRACT_ERR_POSTCOND_MIR_VERIFY;
        return false;
    }
    pm.last_verify_status = CONTRACT_OK;
    true
}

pub fn opt_loop_simplify(
    pm: mut_view<PassManager>,
    body: mut_view<OptBody>,
    call_table: *const EffectCallTable,
    alias_info: *const AliasInfo,
    stats: mut_view<LoopSimplifyStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> bool {
    if pm.budget.profile == OPT_PROFILE_DEBUG_O0 {
        return false;
    }

    let contract = loop_simplify_contract();
    passmgr_ensure_analyses(mut_view(*pm), mut_view(*body), mut_view(*arena), contract.required_analyses);

    let snap = passmgr_snapshot_body(view(*body), mut_view(*arena));
    let pre_rev = pm.ir_revision;
    let pre_valid = pm.valid_analyses;
    let pre_revs = arena_alloc_raw(mut_view(*arena), lp_mul_usize(ANALYSIS_COUNT, size_of<u32>()), align_of<u32>()) as *mut u32;
    if (pm.analysis_revs as usize) != 0 {
        let mut ar_i: usize = 0;
        while ar_i < ANALYSIS_COUNT {
            unsafe { *opt_u32_at(pre_revs, ar_i) = *opt_u32_at(pm.analysis_revs, ar_i); }
            ar_i = ar_i + 1;
        }
    }
    let pre_base_flags = pm.baseline_effect_summary.flags;
    let pre_has_base = pm.has_baseline_effects;
    let pre_stats = *stats;
    stats.pass_runs = stats.pass_runs + 1u32;

    let init_tree = loops_discover(view(*body), call_table, alias_info, mut_view(*arena));
    stats.loops_discovered = stats.loops_discovered + ((unsafe { (*init_tree).loop_count }) as u32);
    let mut irred_c: u32 = 0u32;
    let mut ii: usize = 0;
    while ii < (unsafe { (*init_tree).loop_count }) {
        if unsafe { (*loop_desc_at((*init_tree).loops, ii)).is_irreducible } {
            irred_c = irred_c + 1u32;
        }
        ii = ii + 1;
    }
    stats.irreducible_cycles = stats.irreducible_cycles + irred_c;

    if (unsafe { (*init_tree).loop_count }) == 0 {
        return false;
    }

    let mut changed = false;
    let max_steps: usize = lp_mul_usize(unsafe { (*init_tree).loop_count }, 8) + 8;
    let mut step: usize = 0;
    while step < max_steps {
        if !lp_canonicalize_one_step(mut_view(*body), call_table, alias_info, EXEC_DOMAIN_HOST, mut_view(*stats), mut_view(*arena)) {
            break;
        }
        changed = true;
        step = step + 1;
    }

    // Establish LCSSA from innermost loops (`max_depth`) down to outermost (`1`)
    let post_tree = loops_discover(view(*body), call_table, alias_info, mut_view(*arena));
    let lcnt = unsafe { (*post_tree).loop_count };
    let mut max_d: u32 = 0u32;
    let mut li: usize = 0;
    while li < lcnt {
        let ld = unsafe { (*loop_desc_at((*post_tree).loops, li)).depth };
        if ld > max_d {
            max_d = ld;
        }
        li = li + 1;
    }
    let mut d_iter: u32 = max_d + 1u32;
    let mut lcssa_added: u32 = 0u32;
    while d_iter > 1u32 {
        d_iter = d_iter - 1u32;
        li = 0;
        while li < lcnt {
            let lp = unsafe { loop_desc_at((*post_tree).loops, li) };
            if !(unsafe { (*lp).is_irreducible }) && (unsafe { (*lp).depth }) == d_iter {
                let add_c = lp_establish_lcssa_for_loop(mut_view(*body), unsafe { view(*lp) }, mut_view(*arena));
                lcssa_added = lcssa_added + add_c;
            }
            li = li + 1;
        }
    }
    if lcssa_added > 0u32 {
        stats.lcssa_phis_inserted = stats.lcssa_phis_inserted + lcssa_added;
        optir_construct_memssa(mut_view(*body), mut_view(*arena));
        changed = true;
    }

    if changed {
        pm.ir_revision = pm.ir_revision + 1u32;
        stats.pass_changes = stats.pass_changes + 1u32;
        passmgr_invalidate_analyses(mut_view(*pm), contract.invalidated_analyses);
        if !passmgr_is_analysis_valid(view(*pm), ANALYSIS_RANGE_INFO) {
            body.ranges = 0 as *mut OptRange;
        }
        let keep_mask = analysis_bit(ANALYSIS_CFG) | analysis_bit(ANALYSIS_DOMINATORS) |
                        analysis_bit(ANALYSIS_SSA) | analysis_bit(ANALYSIS_MEMORY_SSA) |
                        analysis_bit(ANALYSIS_LOOP_INFO);
        pm.valid_analyses = pm.valid_analyses | keep_mask;
        loops_stamp_valid_analysis_revs(mut_view(*pm));
    }

    if pm.budget.verify_each {
        if !loops_verify_pass_postconditions(mut_view(*pm), mut_view(*body), mut_view(*arena), mut_view(*sink)) {
            passmgr_rollback_body(mut_view(*body), view(snap), mut_view(*arena));
            pm.ir_revision = pre_rev;
            pm.valid_analyses = pre_valid;
            if (pm.analysis_revs as usize) != 0 {
                let mut ar_j: usize = 0;
                while ar_j < ANALYSIS_COUNT {
                    unsafe { *opt_u32_at(pm.analysis_revs, ar_j) = *opt_u32_at(pre_revs, ar_j); }
                    ar_j = ar_j + 1;
                }
            }
            pm.baseline_effect_summary.flags = pre_base_flags;
            pm.has_baseline_effects = pre_has_base;
            *stats = pre_stats;
            stats.pass_runs = pre_stats.pass_runs + 1u32;
            stats.pass_rollbacks = pre_stats.pass_rollbacks + 1u32;
            return false;
        }
    }

    changed
}

pub fn loops_simplify_mir_body(
    mir_body: mut_view<MirBody>,
    thir: *const Thir,
    profile: u8,
    verify_each: bool,
    call_table: *const EffectCallTable,
    stats: mut_view<LoopSimplifyStats>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    fn_item: *const HirItem
) -> bool {
    loops_stats_zero(mut_view(*stats));
    let prev_errs = sink.errors;

    let obody = optir_build_from_mir(view(*mir_body), thir, mut_view(*arena), mut_view(*sink), fn_item);
    if (obody as usize) == 0 || sink.errors != prev_errs {
        return false;
    }

    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, verify_each);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));

    if profile == OPT_PROFILE_DEBUG_O0 {
        if verify_each {
            return loops_verify_pass_postconditions(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink));
        }
        return true;
    }

    let alias_ptr = alias_build_info(unsafe { view(*obody) }, call_table, mut_view(*arena));
    let _ = opt_loop_simplify(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        call_table,
        alias_ptr as *const AliasInfo,
        mut_view(*stats),
        mut_view(*arena),
        mut_view(*sink)
    );

    let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*obody) }, unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
        return false;
    }
    verify_mir(unsafe { view(*rec_mir) }, thir, mut_view(*sink), fn_item);
    if sink.errors != prev_errs {
        return false;
    }

    unsafe {
        mir_body.sym.v = (*rec_mir).sym.v;
        mir_body.fn_sym.v = (*rec_mir).fn_sym.v;
        mir_body.fn_name.v = (*rec_mir).fn_name.v;
        mir_body.span.file.v = (*rec_mir).span.file.v;
        mir_body.span.start = (*rec_mir).span.start;
        mir_body.span.end = (*rec_mir).span.end;
        mir_body.locals = (*rec_mir).locals;
        mir_body.local_count = (*rec_mir).local_count;
        mir_body.local_cap = (*rec_mir).local_cap;
        mir_body.arg_count = (*rec_mir).arg_count;
        mir_body.bbs = (*rec_mir).bbs;
        mir_body.bb_count = (*rec_mir).bb_count;
        mir_body.bb_cap = (*rec_mir).bb_cap;
        mir_body.drop_flag_count = (*rec_mir).drop_flag_count;
    }
    true
}

// --- MemorySSA / AliasInfo / EffectInfo Loop Invariance & Dependence Queries (AXS-LOOP-010..011, REQ-OPT-143..147) ---

pub fn loops_local_has_indirect_mutation(
    body: view<OptBody>,
    info: *const AliasInfo,
    loc_v: u32
) -> bool {
    let lu = loc_v as usize;
    if (info as usize) == 0 {
        if lu < body.local_count && (body.local_addr_taken as usize) != 0 {
            if unsafe { *opt_bool_at(body.local_addr_taken, lu) } {
                return true;
            }
        }
    }
    if (info as usize) != 0 {
        if lu >= (unsafe { (*info).local_count }) || ((unsafe { (*info).locals }) as usize) == 0 {
            return true;
        }
        let lp_prov = unsafe { alias_local_prov_at((*info).locals, lu) };
        if (unsafe { (*lp_prov).mut_borrow_taken }) ||
           (unsafe { (*lp_prov).raw_addr_exposed }) ||
           (unsafe { (*lp_prov).escaped_external }) ||
           (unsafe { (*lp_prov).is_fixed_mmio }) {
            return true;
        }
    }
    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { opt_block_at(body.blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                if (unsafe { (*inst).opcode }) == OPT_INST_ADDR_OF &&
                   (unsafe { (*inst).rhs_place.local.v }) == loc_v &&
                   ((unsafe { (*inst).orig_stmt.rvalue.borrow_kind }) == MIR_BORROW_MUT ||
                    (unsafe { (*inst).sub_op }) != 0u8) {
                    return true;
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    false
}

pub fn loops_local_written_in_loop(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    loc_v: u32
) -> bool {
    if loops_local_has_indirect_mutation(body, info, loc_v) {
        return true;
    }
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                let flg = unsafe { (*inst).flags };
                if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 &&
                   ((unsafe { (*inst).place.local.v }) == loc_v ||
                    (unsafe { (*inst).orig_stmt.storage_local.v }) == loc_v) {
                    return true;
                }
                let sk = unsafe { (*inst).orig_stmt.kind };
                if opc != OPT_INST_NOP {
                    if opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE {
                        return true;
                    }
                    if (sk == MIR_STMT_ASSIGN || sk == MIR_STMT_DROP) &&
                       (unsafe { (*inst).orig_stmt.place.local.v }) == loc_v {
                        return true;
                    }
                    if (unsafe { (*inst).place.local.v }) == loc_v &&
                       (opc == OPT_INST_STORE || opc == OPT_INST_VOLATILE_STORE ||
                        opc == OPT_INST_INSERT_FIELD || opc == OPT_INST_AGGREGATE ||
                        opc == OPT_INST_DROP_FLAG) {
                        return true;
                    }
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_CALL && (unsafe { (*bb).term.has_call_dest }) &&
                   (unsafe { (*bb).term.call_dest.local.v }) == loc_v {
                    return true;
                }
                if tk == OPT_TERM_DROP && (unsafe { (*bb).term.drop_place.local.v }) == loc_v {
                    return true;
                }
            }
        }
        k = k + 1;
    }
    false
}

pub fn loops_is_val_invariant(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    val_id: OptValueId
) -> bool {
    if lp.is_irreducible || val_id.v == OPT_VALUE_NONE || (val_id.v as usize) > body.value_count {
        return false;
    }
    let vp = unsafe { opt_val_at(body.values, val_id.v as usize) };
    let vk = unsafe { (*vp).kind };
    if vk == OPT_VAL_CONST {
        return true;
    }
    let sloc = unsafe { (*vp).src_local.v };
    if vk == OPT_VAL_PARAM {
        return !loops_local_written_in_loop(lp, body, info, sloc);
    }
    let def_bb_v = unsafe { (*vp).def_bb.v };
    if lp_block_in_set(lp.blocks, lp.block_count, def_bb_v) {
        return false;
    }
    if sloc != 0u32 && loops_local_has_indirect_mutation(body, info, sloc) {
        return false;
    }
    true
}

pub fn loops_region_clobbered_in_loop(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    reg: view<AliasRegion>,
    arena: mut_view<Arena>
) -> bool {
    if lp.is_irreducible || reg.domain == DOMAIN_FIXED_MMIO || reg.cap_mode == CAP_MODE_RAW_PTR {
        return true;
    }
    if (info as usize) == 0 {
        return true;
    }
    let ainfo = unsafe { view(*info) };
    if alias_is_view_readonly_region(ainfo, body, reg) &&
       (lp.has_observable_barriers & (BARRIER_FFI | BARRIER_VOLATILE | BARRIER_ATOMIC)) == 0u16 {
        return false;
    }

    // Check MemorySSA barrier defs inside loop
    let mut md: usize = 1;
    while md < body.mem_ssa_count && (body.mem_defs as usize) != 0 {
        let mnode = unsafe { opt_memdef_at(body.mem_defs, md) };
        if lp_block_in_set(lp.blocks, lp.block_count, unsafe { (*mnode).bb.v }) {
            let meff = unsafe { (*mnode).effect };
            if (unsafe { (*mnode).is_barrier }) &&
               (meff & (EFFECT_VOLATILE | EFFECT_ATOMIC | EFFECT_FFI | EFFECT_UNKNOWN)) != 0u16 {
                return true;
            }
        }
        md = md + 1;
    }

    let mut is_private_stack = false;
    let rlu = reg.base_local.v as usize;
    if reg.domain == 0u8 && rlu < ainfo.local_count && !reg.is_interior_deref {
        let rlp = unsafe { alias_local_prov_at(ainfo.locals, rlu) };
        if !(unsafe { (*rlp).escaped_external }) && !(unsafe { (*rlp).raw_addr_exposed }) {
            is_private_stack = true;
        }
    }

    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                let sk = unsafe { (*inst).orig_stmt.kind };
                let pt = alias_make_prog_pt(bv, i as u32);
                if opc == OPT_INST_VOLATILE_STORE || opc == OPT_INST_ATOMIC ||
                   opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE {
                    return true;
                }
                if opc == OPT_INST_STORE || opc == OPT_INST_DROP_FLAG || sk == MIR_STMT_DROP {
                    let wreg = alias_extract_region(ainfo, body, unsafe { view((*inst).place) }, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
                    let wf = alias_query_regions(ainfo, body, mut_view(*arena), reg, view(wreg), pt);
                    if !alias_is_no_alias_proven(view(wf)) {
                        return true;
                    }
                } else if opc != OPT_INST_NOP && sk == MIR_STMT_ASSIGN {
                    let dpl = unsafe { view((*inst).orig_stmt.place) };
                    let wr_loc: u32 = if dpl.local.v != 0u32 || (unsafe { (*inst).place.local.v }) == 0u32 {
                        dpl.local.v
                    } else {
                        unsafe { (*inst).place.local.v }
                    };
                    let is_proj_write = dpl.proj_count > 0 || (unsafe { (*inst).place.proj_count }) > 0;
                    let is_same_local = wr_loc == reg.base_local.v ||
                                        (reg.has_resolved_place && wr_loc == reg.resolved_place.local.v);
                    let is_mem_or_agg_write = (unsafe { (*inst).mem_def.v }) != MEM_SSA_NONE ||
                                              opc == OPT_INST_AGGREGATE ||
                                              opc == OPT_INST_INSERT_FIELD ||
                                              loops_local_has_indirect_mutation(body, info, wr_loc);
                    if is_proj_write || is_same_local || is_mem_or_agg_write {
                        if dpl.local.v != 0u32 || (unsafe { (*inst).place.local.v }) == 0u32 {
                            let dreg = alias_extract_region(ainfo, body, dpl, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
                            let df = alias_query_regions(ainfo, body, mut_view(*arena), reg, view(dreg), pt);
                            if !alias_is_no_alias_proven(view(df)) {
                                return true;
                            }
                        } else {
                            let dreg = alias_extract_region(ainfo, body, unsafe { view((*inst).place) }, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
                            let df = alias_query_regions(ainfo, body, mut_view(*arena), reg, view(dreg), pt);
                            if !alias_is_no_alias_proven(view(df)) {
                                return true;
                            }
                        }
                    }
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                let tpt = alias_make_prog_pt(bv, icnt as u32);
                if tk == OPT_TERM_DROP {
                    let dreg = alias_extract_region(ainfo, body, unsafe { view((*bb).term.drop_place) }, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
                    let df = alias_query_regions(ainfo, body, mut_view(*arena), reg, view(dreg), tpt);
                    if !alias_is_no_alias_proven(view(df)) {
                        return true;
                    }
                } else if tk == OPT_TERM_CALL {
                    if unsafe { (*bb).term.has_call_dest } {
                        let creg = alias_extract_region(ainfo, body, unsafe { view((*bb).term.call_dest) }, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
                        let cf = alias_query_regions(ainfo, body, mut_view(*arena), reg, view(creg), tpt);
                        if !alias_is_no_alias_proven(view(cf)) {
                            return true;
                        }
                    }
                    let teff_sum = effect_infer_term_with_table(body, unsafe { view((*bb).term) }, call_table);
                    let teff = teff_sum.flags;
                    if (teff & (EFFECT_WRITES_MEM | EFFECT_FFI | EFFECT_VOLATILE | EFFECT_ATOMIC | EFFECT_UNKNOWN)) != 0u16 {
                        if !is_private_stack || (teff & EFFECT_FFI) != 0u16 {
                            return true;
                        }
                        // Even for private stack local, check if any call arg passes a mut_view/borrow derived from it
                        let cac = unsafe { (*bb).term.call_arg_count };
                        let mut ci: usize = 0;
                        while ci < cac {
                            let av = unsafe { (*opt_valid_at((*bb).term.call_args, ci)).v };
                            if av != OPT_VALUE_NONE && (av as usize) <= body.value_count {
                                let avp = unsafe { opt_val_at(body.values, av as usize) };
                                let aloc = (unsafe { (*avp).src_local.v }) as usize;
                                if aloc < ainfo.local_count {
                                    let alp = unsafe { alias_local_prov_at(ainfo.locals, aloc) };
                                    if (unsafe { (*alp).cap_root_local }) == reg.base_local.v ||
                                       aloc == (reg.base_local.v as usize) {
                                        return true;
                                    }
                                }
                            }
                            ci = ci + 1;
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    false
}

fn lp_dominates_all_exits(lp: view<LoopDesc>, body: view<OptBody>, bb_id: OptBbId) -> bool {
    if lp.exiting_count == 0 {
        return false;
    }
    let mut e: usize = 0;
    while e < lp.exiting_count {
        let ex_bb = unsafe { *opt_bbid_at(lp.exiting_blocks, e) };
        if !opt_dominates(body, bb_id, ex_bb) {
            return false;
        }
        e = e + 1;
    }
    let mut k: usize = 0;
    while k < lp.block_count {
        let kb = unsafe { *opt_bbid_at(lp.blocks, k) };
        if kb.v != bb_id.v && opt_dominates(body, kb, bb_id) && (kb.v as usize) < body.bb_count {
            let kbb = unsafe { opt_block_at(body.blocks, kb.v as usize) };
            if unsafe { (*kbb).has_term } {
                let ktk = unsafe { (*kbb).term.kind };
                if ktk == OPT_TERM_ASSERT || ktk == OPT_TERM_CALL {
                    return false;
                }
            }
        }
        k = k + 1;
    }
    true
}

pub fn loops_can_hoist_inst(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    call_table: *const EffectCallTable,
    bb_id: OptBbId,
    inst_idx: usize,
    arena: mut_view<Arena>
) -> bool {
    if lp.is_irreducible || (lp.has_observable_barriers & BARRIER_GPU_DOMAIN) != 0u16 {
        return false;
    }
    if (bb_id.v as usize) >= body.bb_count || !lp_block_in_set(lp.blocks, lp.block_count, bb_id.v) {
        return false;
    }
    let bb = unsafe { opt_block_at(body.blocks, bb_id.v as usize) };
    if inst_idx >= (unsafe { (*bb).inst_count }) {
        return false;
    }
    let inst = unsafe { opt_inst_at((*bb).insts, inst_idx) };
    let opc = unsafe { (*inst).opcode };
    let flg = unsafe { (*inst).flags };
    if opc == OPT_INST_NOP || opc == OPT_INST_STORE || opc == OPT_INST_VOLATILE_LOAD ||
       opc == OPT_INST_VOLATILE_STORE || opc == OPT_INST_ATOMIC || opc == OPT_INST_BLACK_BOX ||
       opc == OPT_INST_ZEROIZE || opc == OPT_INST_DROP_FLAG || opc == OPT_INST_ADDR_OF {
        return false;
    }
    if (flg & (OPT_FLAG_BARRIER | OPT_FLAG_MOVE | OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
        return false;
    }
    if (unsafe { (*inst).lhs.v }) != OPT_VALUE_NONE &&
       !loops_is_val_invariant(lp, body, info, unsafe { (*inst).lhs }) {
        return false;
    }
    if (unsafe { (*inst).rhs.v }) != OPT_VALUE_NONE &&
       !loops_is_val_invariant(lp, body, info, unsafe { (*inst).rhs }) {
        return false;
    }
    let eac = unsafe { (*inst).extra_arg_count };
    let mut ei: usize = 0;
    while ei < eac {
        let ev = unsafe { *opt_valid_at((*inst).extra_args, ei) };
        if ev.v != OPT_VALUE_NONE && !loops_is_val_invariant(lp, body, info, ev) {
            return false;
        }
        ei = ei + 1;
    }

    let dlv = unsafe { (*inst).place.local.v };
    let dpc = unsafe { (*inst).place.proj_count };
    if dpc > 0 || (dlv != 0u32 && loops_local_has_indirect_mutation(body, info, dlv)) {
        return false;
    }

    let eff = effect_infer_inst(body, unsafe { view(*inst) }, 64u32);
    if (eff & (EFFECT_WRITES_MEM | EFFECT_ALLOCATES | EFFECT_IO | EFFECT_ATOMIC |
               EFFECT_VOLATILE | EFFECT_FFI | EFFECT_NONTERM | EFFECT_UNKNOWN)) != 0u16 {
        return false;
    }
    if (eff & EFFECT_MAY_PANIC) != 0u16 {
        let proven_nonzero_trip = lp.trip_count.kind == TRIP_CONST &&
                                  lp.trip_count.const_iters >= 1u64 &&
                                  lp.trip_count.certainty == CERTAINTY_PROVEN;
        if !proven_nonzero_trip || !lp_dominates_all_exits(lp, body, bb_id) ||
           (lp.has_observable_barriers & (BARRIER_IO | BARRIER_VOLATILE | BARRIER_ATOMIC | BARRIER_FFI)) != 0u16 {
            return false;
        }
    }

    if opc == OPT_INST_LOAD || opc == OPT_INST_LEN || opc == OPT_INST_DISCRIMINANT || opc == OPT_INST_EXTRACT_FIELD {
        if (info as usize) == 0 {
            return false;
        }
        let rbase_l = unsafe { (*inst).rhs_place.local.v };
        if rbase_l != 0u32 && loops_local_written_in_loop(lp, body, info, rbase_l) {
            return false;
        }
        let rpcnt = unsafe { (*inst).rhs_place.proj_count };
        let mut rpi: usize = 0;
        while rpi < rpcnt && ((unsafe { (*inst).rhs_place.projs }) as usize) != 0 {
            let rp = unsafe { mir_proj_at((*inst).rhs_place.projs, rpi) };
            let rpk = unsafe { (*rp).kind };
            if rpk == MIR_PROJ_INDEX &&
               loops_local_written_in_loop(lp, body, info, unsafe { (*rp).index_local.v }) {
                return false;
            }
            if rpk == MIR_PROJ_SUB_SLICE {
                if (unsafe { (*rp).has_from }) &&
                   loops_local_written_in_loop(lp, body, info, unsafe { (*rp).from_local.v }) {
                    return false;
                }
                if (unsafe { (*rp).has_to }) &&
                   loops_local_written_in_loop(lp, body, info, unsafe { (*rp).to_local.v }) {
                    return false;
                }
            }
            rpi = rpi + 1;
        }
        let ainfo = unsafe { view(*info) };
        let rreg = alias_extract_region(ainfo, body, unsafe { view((*inst).rhs_place) }, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
        if rreg.cap_mode == CAP_MODE_RAW_PTR {
            let proven_nonzero_trip = lp.trip_count.kind == TRIP_CONST &&
                                      lp.trip_count.const_iters >= 1u64 &&
                                      lp.trip_count.certainty == CERTAINTY_PROVEN;
            if !proven_nonzero_trip || !lp_dominates_all_exits(lp, body, bb_id) {
                return false;
            }
        }
        if loops_region_clobbered_in_loop(lp, body, info, call_table, view(rreg), mut_view(*arena)) {
            return false;
        }
    }
    true
}

// --- SCEV Helpers & Loop-Carried Dependence Solver (AXS-LOOP-006, AXS-LOOP-011) ---

pub fn lp_peel_copy(body: view<OptBody>, val_id: OptValueId) -> OptValueId {
    let mut cur = val_id;
    let mut hops: usize = 0;
    while cur.v != OPT_VALUE_NONE && (cur.v as usize) <= body.value_count && hops < 16 {
        let vp = unsafe { opt_val_at(body.values, cur.v as usize) };
        if (unsafe { (*vp).kind }) != OPT_VAL_INST {
            break;
        }
        let dbb_v = (unsafe { (*vp).def_bb.v }) as usize;
        if dbb_v >= body.bb_count {
            break;
        }
        let dbb = unsafe { opt_block_at(body.blocks, dbb_v) };
        let icnt = unsafe { (*dbb).inst_count };
        let mut found_next = OptValueId { v: OPT_VALUE_NONE };
        let mut i: usize = 0;
        while i < icnt {
            let inst = unsafe { opt_inst_at((*dbb).insts, i) };
            if (unsafe { (*inst).result.v }) == cur.v || (unsafe { (*inst).id.v }) == (unsafe { (*vp).def_inst.v }) {
                if (unsafe { (*inst).opcode }) == OPT_INST_COPY &&
                   ((unsafe { (*inst).flags }) & OPT_FLAG_BARRIER) == 0u16 &&
                   (unsafe { (*inst).lhs.v }) != OPT_VALUE_NONE &&
                   (unsafe { (*inst).lhs.v }) != cur.v {
                    found_next = unsafe { (*inst).lhs };
                }
                break;
            }
            i = i + 1;
        }
        if found_next.v == OPT_VALUE_NONE {
            break;
        }
        cur = found_next;
        hops = hops + 1;
    }
    cur
}

pub fn lp_peel_copy_and_lcssa(body: view<OptBody>, val_id: OptValueId) -> OptValueId {
    let mut cur = val_id;
    let mut hops: usize = 0;
    while cur.v != OPT_VALUE_NONE && (cur.v as usize) <= body.value_count && hops < 24 {
        let vp = unsafe { opt_val_at(body.values, cur.v as usize) };
        let vk = unsafe { (*vp).kind };
        let dbb_v = (unsafe { (*vp).def_bb.v }) as usize;
        if dbb_v >= body.bb_count {
            break;
        }
        let dbb = unsafe { opt_block_at(body.blocks, dbb_v) };
        let mut found_next = OptValueId { v: OPT_VALUE_NONE };
        if vk == OPT_VAL_INST {
            let icnt = unsafe { (*dbb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*dbb).insts, i) };
                if (unsafe { (*inst).result.v }) == cur.v || (unsafe { (*inst).id.v }) == (unsafe { (*vp).def_inst.v }) {
                    if (unsafe { (*inst).opcode }) == OPT_INST_COPY &&
                       ((unsafe { (*inst).flags }) & OPT_FLAG_BARRIER) == 0u16 &&
                       (unsafe { (*inst).lhs.v }) != OPT_VALUE_NONE &&
                       (unsafe { (*inst).lhs.v }) != cur.v {
                        found_next = unsafe { (*inst).lhs };
                    }
                    break;
                }
                i = i + 1;
            }
        } else if vk == OPT_VAL_PHI {
            let pcnt = unsafe { (*dbb).phi_count };
            let mut pi: usize = 0;
            while pi < pcnt {
                let phi = unsafe { opt_phi_at((*dbb).phis, pi) };
                if (unsafe { (*phi).result.v }) == cur.v {
                    if (unsafe { (*phi).arity }) == 1 && ((unsafe { (*phi).incoming_values }) as usize) != 0 {
                        let in0 = unsafe { *opt_valid_at((*phi).incoming_values, 0) };
                        if in0.v != OPT_VALUE_NONE && in0.v != cur.v {
                            found_next = in0;
                        }
                    }
                    break;
                }
                pi = pi + 1;
            }
        } else {
            break;
        }
        if found_next.v == OPT_VALUE_NONE {
            break;
        }
        cur = found_next;
        hops = hops + 1;
    }
    cur
}

pub fn lp_find_def_inst(body: view<OptBody>, val_id: OptValueId) -> *mut OptInst {
    let v = lp_peel_copy(body, val_id);
    if v.v == OPT_VALUE_NONE || (v.v as usize) > body.value_count {
        return 0 as *mut OptInst;
    }
    let vp = unsafe { opt_val_at(body.values, v.v as usize) };
    if (unsafe { (*vp).kind }) != OPT_VAL_INST {
        return 0 as *mut OptInst;
    }
    let dbb_v = (unsafe { (*vp).def_bb.v }) as usize;
    if dbb_v >= body.bb_count {
        return 0 as *mut OptInst;
    }
    let dbb = unsafe { opt_block_at(body.blocks, dbb_v) };
    let icnt = unsafe { (*dbb).inst_count };
    let mut i: usize = 0;
    while i < icnt {
        let inst = unsafe { opt_inst_at((*dbb).insts, i) };
        if (unsafe { (*inst).result.v }) == v.v || (unsafe { (*inst).id.v }) == (unsafe { (*vp).def_inst.v }) {
            return inst;
        }
        i = i + 1;
    }
    0 as *mut OptInst
}

pub fn lp_val_const_int(body: view<OptBody>, val_id: OptValueId, out_u64: mut_view<u64>, out_i64: mut_view<i64>) -> bool {
    let v = lp_peel_copy(body, val_id);
    if v.v == OPT_VALUE_NONE || (v.v as usize) > body.value_count {
        return false;
    }
    let vp = unsafe { opt_val_at(body.values, v.v as usize) };
    if (unsafe { (*vp).kind }) != OPT_VAL_CONST {
        return false;
    }
    let ck = unsafe { (*vp).const_val.kind };
    if ck != MIR_CONST_INT && ck != MIR_CONST_BOOL {
        return false;
    }
    let ty_v = unsafe { (*vp).ty.v };
    let mut bits = opt_type_bits(body.thir, TypeId { v: ty_v });
    if bits == 0u32 {
        bits = 64u32;
    }
    let raw = (unsafe { (*vp).const_val.val }) & opt_bit_mask(bits);
    *out_u64 = raw;
    let is_sig = opt_type_is_signed(body.thir, TypeId { v: ty_v });
    if is_sig {
        *out_i64 = opt_sign_extend_u64(raw, bits) as i64;
    } else {
        *out_i64 = raw as i64;
    }
    true
}

fn lp_same_scalar_operand(body: view<OptBody>, a: OptValueId, b: OptValueId) -> bool {
    let pa = lp_peel_copy(body, a);
    let pb = lp_peel_copy(body, b);
    if pa.v == pb.v && pa.v != OPT_VALUE_NONE {
        return true;
    }
    let mut au: u64 = 0u64;
    let mut ai: i64 = 0i64;
    let mut bu: u64 = 0u64;
    let mut bi: i64 = 0i64;
    if lp_val_const_int(body, pa, mut_view(au), mut_view(ai)) &&
       lp_val_const_int(body, pb, mut_view(bu), mut_view(bi)) {
        return au == bu && ai == bi;
    }
    false
}

fn lp_has_dominating_overflow_guard(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    step_bb: OptBbId,
    bin_op: u8,
    lhs_id: OptValueId,
    rhs_id: OptValueId
) -> bool {
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        let b_id = OptBbId { v: bv };
        if (bv as usize) < body.bb_count && b_id.v != step_bb.v && opt_dominates(body, b_id, step_bb) {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            if (unsafe { (*bb).has_term }) && (unsafe { (*bb).term.kind }) == OPT_TERM_ASSERT {
                let expected = unsafe { (*bb).term.assert_expected };
                let cond_id = lp_peel_copy(body, unsafe { (*bb).term.cond });
                let mut ov_id = OptValueId { v: OPT_VALUE_NONE };
                if !expected {
                    ov_id = cond_id;
                } else {
                    let c_inst = lp_find_def_inst(body, cond_id);
                    if (c_inst as usize) != 0 && (unsafe { (*c_inst).opcode }) == OPT_INST_UNOP &&
                       (unsafe { (*c_inst).sub_op }) == MIR_UNOP_NOT {
                        ov_id = lp_peel_copy(body, unsafe { (*c_inst).lhs });
                    }
                }
                if ov_id.v != OPT_VALUE_NONE {
                    let ov_inst = lp_find_def_inst(body, ov_id);
                    if (ov_inst as usize) != 0 && (unsafe { (*ov_inst).opcode }) == OPT_INST_CHECKED_BINOP &&
                       (unsafe { (*ov_inst).sub_op }) == bin_op {
                        let ol = unsafe { (*ov_inst).lhs };
                        let or_v = unsafe { (*ov_inst).rhs };
                        if lp_same_scalar_operand(body, ol, lhs_id) && lp_same_scalar_operand(body, or_v, rhs_id) {
                            return true;
                        }
                        if (bin_op == MIR_BINOP_ADD || bin_op == MIR_BINOP_MUL) &&
                           lp_same_scalar_operand(body, ol, rhs_id) && lp_same_scalar_operand(body, or_v, lhs_id) {
                            return true;
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    false
}

const LP_DEF_NONE: u8 = 0u8;
const LP_DEF_INST: u8 = 1u8;
const LP_DEF_PHI: u8 = 2u8;
const LP_DEF_CALL: u8 = 3u8;
const LP_DEF_PARAM: u8 = 4u8;

fn lp_place_writes_local_directly(place: view<MirPlace>, loc: u32) -> bool {
    if place.local.v != loc {
        return false;
    }
    if place.proj_count == 0 || (place.projs as usize) == 0 {
        return true;
    }
    let p0 = unsafe { mir_proj_at(place.projs, 0) };
    (unsafe { (*p0).kind }) != MIR_PROJ_DEREF
}

fn lp_inst_clobbers_scalar_local(inst: view<OptInst>, loc: u32) -> bool {
    let flg = inst.flags;
    if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 {
        if inst.place.local.v == loc || inst.orig_stmt.storage_local.v == loc {
            return true;
        }
    }
    let opc = inst.opcode;
    if opc == OPT_INST_NOP {
        return false;
    }
    if opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE {
        return true;
    }
    if opc == OPT_INST_ADDR_OF && lp_place_writes_local_directly(view(inst.rhs_place), loc) {
        return true;
    }
    let sk = inst.orig_stmt.kind;
    if sk == MIR_STMT_DROP && lp_place_writes_local_directly(view(inst.orig_stmt.place), loc) {
        return true;
    }
    if sk == MIR_STMT_ASSIGN &&
       (lp_place_writes_local_directly(view(inst.place), loc) ||
        lp_place_writes_local_directly(view(inst.orig_stmt.place), loc)) {
        return true;
    }
    if (opc == OPT_INST_STORE || opc == OPT_INST_VOLATILE_STORE ||
        opc == OPT_INST_INSERT_FIELD || opc == OPT_INST_AGGREGATE ||
        opc == OPT_INST_DROP_FLAG) &&
       lp_place_writes_local_directly(view(inst.place), loc) {
        return true;
    }
    if inst.result.v != OPT_VALUE_NONE && lp_place_writes_local_directly(view(inst.place), loc) {
        return true;
    }
    false
}

fn lp_term_clobbers_scalar_local(term: view<OptTerminator>, loc: u32) -> bool {
    let tk = term.kind;
    if tk == OPT_TERM_DROP {
        return lp_place_writes_local_directly(view(term.drop_place), loc);
    }
    if tk == OPT_TERM_CALL {
        if term.has_call_dest && lp_place_writes_local_directly(view(term.call_dest), loc) {
            return true;
        }
    }
    false
}

fn lp_block_range_clobbers_scalar_local(bb: view<OptBlock>, lo: usize, hi: usize, loc: u32) -> bool {
    let end: usize = if hi > bb.inst_count { bb.inst_count } else { hi };
    let mut k: usize = lo;
    while k < end {
        let inst_k = unsafe { opt_inst_at(bb.insts, k) };
        if lp_inst_clobbers_scalar_local(unsafe { view(*inst_k) }, loc) {
            return true;
        }
        k = k + 1;
    }
    false
}

fn lp_scalar_local_unclobbered_from_def(
    body: view<OptBody>,
    def_kind: u8,
    def_bb: usize,
    def_i: usize,
    at_bb: usize,
    before_inst: usize,
    loc: u32,
    arena: mut_view<Arena>
) -> bool {
    let n = body.bb_count;
    if def_kind == LP_DEF_NONE || at_bb >= n {
        return false;
    }
    let abb = unsafe { opt_block_at(body.blocks, at_bb) };
    if !(unsafe { (*abb).is_reachable }) || before_inst > (unsafe { (*abb).inst_count }) {
        return false;
    }

    let at_id = OptBbId { v: at_bb as u32 };
    if def_kind == LP_DEF_INST {
        let def_id = OptBbId { v: def_bb as u32 };
        if def_bb >= n || !opt_dominates(body, def_id, at_id) {
            return false;
        }
        if def_bb == at_bb {
            if def_i >= before_inst {
                return false;
            }
            return !lp_block_range_clobbers_scalar_local(unsafe { view(*abb) }, def_i + 1, before_inst, loc);
        }
    } else if def_kind == LP_DEF_PHI {
        let def_id = OptBbId { v: def_bb as u32 };
        if def_bb >= n || !opt_dominates(body, def_id, at_id) {
            return false;
        }
        if def_bb == at_bb {
            return !lp_block_range_clobbers_scalar_local(unsafe { view(*abb) }, 0, before_inst, loc);
        }
    } else if def_kind == LP_DEF_CALL {
        if def_bb >= n || def_bb == at_bb {
            return false;
        }
        let call_bb = unsafe { opt_block_at(body.blocks, def_bb) };
        if !(unsafe { (*call_bb).has_term }) || (unsafe { (*call_bb).term.kind }) != OPT_TERM_CALL {
            return false;
        }
        let cont_v = unsafe { (*call_bb).term.true_bb.v };
        let unwind_v = unsafe { (*call_bb).term.unwind_bb.v };
        if (cont_v as usize) >= n || (cont_v as usize) == def_bb || cont_v == unwind_v {
            return false;
        }
        let def_id = OptBbId { v: def_bb as u32 };
        let cont_id = OptBbId { v: cont_v };
        if !opt_dominates(body, def_id, at_id) || !opt_dominates(body, cont_id, at_id) {
            return false;
        }
    } else if def_kind != LP_DEF_PARAM {
        return false;
    }

    if lp_block_range_clobbers_scalar_local(unsafe { view(*abb) }, 0, before_inst, loc) {
        return false;
    }

    let call_unwind_v: u32 = if def_kind == LP_DEF_CALL {
        let cbb0 = unsafe { opt_block_at(body.blocks, def_bb) };
        unsafe { (*cbb0).term.unwind_bb.v }
    } else {
        OPT_BB_NONE
    };

    let vis = arena_alloc_raw(mut_view(*arena), lp_mul_usize(n, size_of<bool>()), align_of<bool>()) as *mut bool;
    let queue = arena_alloc_raw(mut_view(*arena), lp_mul_usize(n + 2, size_of<u32>()), align_of<u32>()) as *mut u32;
    let mut z: usize = 0;
    while z < n {
        unsafe { *opt_bool_at(vis, z) = false; }
        z = z + 1;
    }

    let mut q_head: usize = 0;
    let mut q_tail: usize = 0;
    let apcnt = unsafe { (*abb).pred_count };
    let mut p: usize = 0;
    while p < apcnt {
        let pv = (unsafe { (*opt_bbid_at((*abb).preds, p)).v }) as usize;
        if pv < n && !(unsafe { *opt_bool_at(vis, pv) }) {
            let pbb = unsafe { opt_block_at(body.blocks, pv) };
            if unsafe { (*pbb).is_reachable } {
                unsafe {
                    *opt_bool_at(vis, pv) = true;
                    *opt_u32_at(queue, q_tail) = pv as u32;
                }
                q_tail = q_tail + 1;
            }
        }
        p = p + 1;
    }

    while q_head < q_tail {
        let b_idx = (unsafe { *opt_u32_at(queue, q_head) }) as usize;
        q_head = q_head + 1;
        let qbb = unsafe { opt_block_at(body.blocks, b_idx) };
        let q_icnt = unsafe { (*qbb).inst_count };

        if def_kind == LP_DEF_CALL && (b_idx as u32) == call_unwind_v {
            return false;
        }

        if def_kind != LP_DEF_PARAM && b_idx == def_bb {
            if def_kind == LP_DEF_INST {
                if def_i + 1 < q_icnt &&
                   lp_block_range_clobbers_scalar_local(unsafe { view(*qbb) }, def_i + 1, q_icnt, loc) {
                    return false;
                }
                if (unsafe { (*qbb).has_term }) && lp_term_clobbers_scalar_local(unsafe { view((*qbb).term) }, loc) {
                    return false;
                }
            } else if def_kind == LP_DEF_PHI {
                if lp_block_range_clobbers_scalar_local(unsafe { view(*qbb) }, 0, q_icnt, loc) {
                    return false;
                }
                if (unsafe { (*qbb).has_term }) && lp_term_clobbers_scalar_local(unsafe { view((*qbb).term) }, loc) {
                    return false;
                }
            }
        } else {
            if lp_block_range_clobbers_scalar_local(unsafe { view(*qbb) }, 0, q_icnt, loc) {
                return false;
            }
            if (unsafe { (*qbb).has_term }) && lp_term_clobbers_scalar_local(unsafe { view((*qbb).term) }, loc) {
                return false;
            }
            let qpcnt = unsafe { (*qbb).pred_count };
            let mut qp: usize = 0;
            while qp < qpcnt {
                let npv = (unsafe { (*opt_bbid_at((*qbb).preds, qp)).v }) as usize;
                if npv < n && !(unsafe { *opt_bool_at(vis, npv) }) {
                    let npbb = unsafe { opt_block_at(body.blocks, npv) };
                    if unsafe { (*npbb).is_reachable } {
                        unsafe {
                            *opt_bool_at(vis, npv) = true;
                            *opt_u32_at(queue, q_tail) = npv as u32;
                        }
                        q_tail = q_tail + 1;
                    }
                }
                qp = qp + 1;
            }
        }
    }
    true
}

// Resolves the exact scalar SSA `OptValueId` live for `loc` immediately before `pt = (bb << 16) | inst`,
// verifying zero clobbers across ALL CFG paths from the candidate definition because pruned SSA omits
// join/header `OptPhi`s when `loc` is only read via `MirProjection.index_local`.
fn lp_resolve_ssa_local_at(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    loc: u32,
    pt: u32,
    arena: mut_view<Arena>
) -> OptValueId {
    let lu = loc as usize;
    if lu >= body.local_count || loops_local_has_indirect_mutation(body, info, loc) {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    if (body.local_addr_taken as usize) == 0 && (info as usize) == 0 {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    if (body.local_addr_taken as usize) != 0 && (unsafe { *opt_bool_at(body.local_addr_taken, lu) }) {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    if (body.local_modes as usize) != 0 && (unsafe { *opt_u8_at(body.local_modes, lu) }) != 0u8 {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    let bb_v = (pt >> 16u32) as usize;
    let inst_v = (pt & 0xFFFFu32) as usize;
    if inst_v >= 0xFFFE || bb_v >= body.bb_count || !lp_block_in_set(lp.blocks, lp.block_count, bb_v as u32) {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    let start_bb = unsafe { opt_block_at(body.blocks, bb_v) };
    if !(unsafe { (*start_bb).is_reachable }) || inst_v > (unsafe { (*start_bb).inst_count }) {
        return OptValueId { v: OPT_VALUE_NONE };
    }

    let mut cand_kind: u8 = LP_DEF_NONE;
    let mut cand_bb: usize = 0;
    let mut cand_i: usize = 0;
    let mut cand_val = OptValueId { v: OPT_VALUE_NONE };

    let mut cur: usize = bb_v;
    let mut first = true;
    let mut hops: usize = 0;
    while cur < body.bb_count && hops <= body.bb_count {
        let cbb = unsafe { opt_block_at(body.blocks, cur) };
        let icnt = unsafe { (*cbb).inst_count };
        if !first && (unsafe { (*cbb).has_term }) {
            let tk = unsafe { (*cbb).term.kind };
            if tk == OPT_TERM_CALL && (unsafe { (*cbb).term.has_call_dest }) &&
               (unsafe { (*cbb).term.call_dest.local.v }) == loc {
                if (unsafe { (*cbb).term.call_dest.proj_count }) == 0 &&
                   (unsafe { (*cbb).term.call_result.v }) != OPT_VALUE_NONE {
                    cand_kind = LP_DEF_CALL;
                    cand_bb = cur;
                    cand_i = icnt;
                    cand_val = unsafe { (*cbb).term.call_result };
                    break;
                }
                return OptValueId { v: OPT_VALUE_NONE };
            }
            if lp_term_clobbers_scalar_local(unsafe { view((*cbb).term) }, loc) {
                return OptValueId { v: OPT_VALUE_NONE };
            }
        }
        let limit: usize = if first { inst_v } else { icnt };
        first = false;
        let mut k: usize = limit;
        let mut hit_inst = false;
        while k > 0 {
            k = k - 1;
            let inst = unsafe { opt_inst_at((*cbb).insts, k) };
            let opc = unsafe { (*inst).opcode };
            let flg = unsafe { (*inst).flags };
            if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) == 0u16 &&
               opc != OPT_INST_NOP && opc != OPT_INST_DROP_FLAG && opc != OPT_INST_STORE &&
               opc != OPT_INST_VOLATILE_STORE && opc != OPT_INST_INSERT_FIELD &&
               opc != OPT_INST_AGGREGATE && opc != OPT_INST_BLACK_BOX && opc != OPT_INST_ZEROIZE &&
               (unsafe { (*inst).place.local.v }) == loc &&
               (unsafe { (*inst).place.proj_count }) == 0 &&
               (unsafe { (*inst).result.v }) != OPT_VALUE_NONE {
                cand_kind = LP_DEF_INST;
                cand_bb = cur;
                cand_i = k;
                cand_val = unsafe { (*inst).result };
                hit_inst = true;
                break;
            }
            if lp_inst_clobbers_scalar_local(unsafe { view(*inst) }, loc) {
                return OptValueId { v: OPT_VALUE_NONE };
            }
        }
        if hit_inst {
            break;
        }
        let pcnt = unsafe { (*cbb).phi_count };
        let mut pi: usize = 0;
        let mut hit_phi = false;
        while pi < pcnt {
            let phi = unsafe { opt_phi_at((*cbb).phis, pi) };
            if (unsafe { (*phi).src_local.v }) == loc &&
               (unsafe { (*phi).proj_field }) == OPT_PROJ_NONE &&
               (unsafe { (*phi).slot_idx }) != OPT_PROJ_NONE &&
               (unsafe { (*phi).result.v }) != OPT_VALUE_NONE {
                cand_kind = LP_DEF_PHI;
                cand_bb = cur;
                cand_i = 0;
                cand_val = unsafe { (*phi).result };
                hit_phi = true;
                break;
            }
            pi = pi + 1;
        }
        if hit_phi {
            break;
        }
        if cur == 0 {
            break;
        }
        let idom_v = unsafe { (*cbb).idom.v };
        if idom_v == OPT_BB_NONE || (idom_v as usize) == cur {
            break;
        }
        cur = idom_v as usize;
        hops = hops + 1;
    }

    if cand_kind == LP_DEF_NONE && loc >= 1u32 && lu <= body.arg_count {
        let mut vi: usize = 1;
        while vi <= body.value_count {
            let vp = unsafe { opt_val_at(body.values, vi) };
            if (unsafe { (*vp).kind }) == OPT_VAL_PARAM &&
               (unsafe { (*vp).src_local.v }) == loc &&
               (unsafe { (*vp).proj_field }) == OPT_PROJ_NONE {
                cand_kind = LP_DEF_PARAM;
                cand_bb = 0;
                cand_i = 0;
                cand_val = OptValueId { v: vi as u32 };
                break;
            }
            vi = vi + 1;
        }
    }

    if cand_kind == LP_DEF_NONE || cand_val.v == OPT_VALUE_NONE {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    if !lp_scalar_local_unclobbered_from_def(body, cand_kind, cand_bb, cand_i, bb_v, inst_v, loc, mut_view(*arena)) {
        return OptValueId { v: OPT_VALUE_NONE };
    }
    lp_peel_copy_and_lcssa(body, cand_val)
}

// Extracts affine form `(iv_phi_v, step, scale, const_off)` for exact SSA `OptValueId` `idx_val`
fn lp_extract_ssa_affine_iv(
    tree: view<LoopTree>,
    lp: view<LoopDesc>,
    body: view<OptBody>,
    idx_val: OptValueId,
    out_phi_v: mut_view<u32>,
    out_step: mut_view<i64>,
    out_scale: mut_view<i64>,
    out_off: mut_view<i64>
) -> bool {
    if lp.iv_count == 0 || (lp.ivs as usize) == 0 {
        return false;
    }
    let pv = lp_peel_copy_and_lcssa(body, idx_val);
    if pv.v == OPT_VALUE_NONE || (pv.v as usize) > body.value_count {
        return false;
    }
    let mut i: usize = 0;
    while i < lp.iv_count {
        let iv = unsafe { loop_iv_at(lp.ivs, i) };
        if unsafe { (*iv).no_wrap_proven } {
            let iv_ssa = lp_peel_copy_and_lcssa(body, unsafe { (*iv).ssa_val });
            if iv_ssa.v != OPT_VALUE_NONE && iv_ssa.v == pv.v {
                let p_phi = unsafe { (*iv).phi_val.v };
                let mut base_step: i64 = unsafe { (*iv).step_const };
                if !(unsafe { (*iv).is_primary }) {
                    let mut j: usize = 0;
                    while j < lp.iv_count {
                        let piv = unsafe { loop_iv_at(lp.ivs, j) };
                        if (unsafe { (*piv).is_primary }) && (unsafe { (*piv).phi_val.v }) == p_phi {
                            base_step = unsafe { (*piv).step_const };
                            break;
                        }
                        j = j + 1;
                    }
                }
                let mut off_c: i64 = 0i64;
                let off_raw = unsafe { (*iv).offset_expr };
                if off_raw != SCEV_IDX_NONE {
                    let off_idx = off_raw as usize;
                    if off_idx >= tree.scev_count || (tree.scev_pool as usize) == 0 {
                        return false;
                    }
                    let oex = unsafe { scev_expr_at(tree.scev_pool, off_idx) };
                    if (unsafe { (*oex).kind }) != SCEV_CONST {
                        return false;
                    }
                    off_c = unsafe { (*oex).const_val };
                }
                *out_phi_v = p_phi;
                *out_step = base_step;
                *out_scale = unsafe { (*iv).scale_const };
                *out_off = off_c;
                return true;
            }
        }
        i = i + 1;
    }
    false
}

fn lp_base_container_stable_in_loop(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    base_loc: u32,
    proj_count: usize
) -> bool {
    if (base_loc as usize) >= body.local_count || loops_local_has_indirect_mutation(body, info, base_loc) {
        return false;
    }
    if proj_count == 2 {
        return !loops_local_written_in_loop(lp, body, info, base_loc);
    }
    if proj_count != 1 {
        return false;
    }
    let mut k: usize = 0;
    while k < lp.block_count {
        let bv = unsafe { (*opt_bbid_at(lp.blocks, k)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            let icnt = unsafe { (*bb).inst_count };
            let mut i: usize = 0;
            while i < icnt {
                let inst = unsafe { opt_inst_at((*bb).insts, i) };
                let opc = unsafe { (*inst).opcode };
                let flg = unsafe { (*inst).flags };
                if (flg & (OPT_FLAG_STORAGE_LIVE | OPT_FLAG_STORAGE_DEAD)) != 0u16 &&
                   ((unsafe { (*inst).place.local.v }) == base_loc ||
                    (unsafe { (*inst).orig_stmt.storage_local.v }) == base_loc) {
                    return false;
                }
                if opc != OPT_INST_NOP {
                    if opc == OPT_INST_BLACK_BOX || opc == OPT_INST_ZEROIZE {
                        return false;
                    }
                    let sk = unsafe { (*inst).orig_stmt.kind };
                    if (sk == MIR_STMT_DROP && (unsafe { (*inst).orig_stmt.place.local.v }) == base_loc) ||
                       (sk == MIR_STMT_ASSIGN && (unsafe { (*inst).orig_stmt.place.local.v }) == base_loc &&
                        (unsafe { (*inst).orig_stmt.place.proj_count }) == 0) {
                        return false;
                    }
                    if (unsafe { (*inst).place.local.v }) == base_loc &&
                       (opc == OPT_INST_DROP_FLAG ||
                        ((opc == OPT_INST_STORE || opc == OPT_INST_VOLATILE_STORE || opc == OPT_INST_AGGREGATE) && (unsafe { (*inst).place.proj_count }) == 0)) {
                        return false;
                    }
                }
                i = i + 1;
            }
            if unsafe { (*bb).has_term } {
                let tk = unsafe { (*bb).term.kind };
                if tk == OPT_TERM_CALL && (unsafe { (*bb).term.has_call_dest }) &&
                   (unsafe { (*bb).term.call_dest.local.v }) == base_loc {
                    return false;
                }
                if tk == OPT_TERM_DROP && (unsafe { (*bb).term.drop_place.local.v }) == base_loc {
                    return false;
                }
            }
        }
        k = k + 1;
    }
    true
}

fn lp_extract_place_index_local(pl: view<MirPlace>, out_idx_loc: mut_view<u32>) -> bool {
    if pl.proj_count == 1 && (pl.projs as usize) != 0 {
        let p0 = unsafe { mir_proj_at(pl.projs, 0) };
        if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX {
            *out_idx_loc = unsafe { (*p0).index_local.v };
            return true;
        }
    } else if pl.proj_count == 2 && (pl.projs as usize) != 0 {
        let p0 = unsafe { mir_proj_at(pl.projs, 0) };
        let p1 = unsafe { mir_proj_at(pl.projs, 1) };
        if (unsafe { (*p0).kind }) == 0u8 && (unsafe { (*p1).kind }) == MIR_PROJ_INDEX {
            *out_idx_loc = unsafe { (*p1).index_local.v };
            return true;
        }
    }
    false
}

pub fn loops_query_dependence(
    tree: view<LoopTree>,
    lp: view<LoopDesc>,
    body: view<OptBody>,
    info: *const AliasInfo,
    place_a: view<MirPlace>,
    pt_a: u32,
    is_write_a: bool,
    place_b: view<MirPlace>,
    pt_b: u32,
    is_write_b: bool,
    arena: mut_view<Arena>
) -> LoopDependence {
    if !is_write_a && !is_write_b {
        return LoopDependence {
            kind: DEP_NONE,
            is_constant_dist: false,
            distance: 0i64,
            certainty: CERTAINTY_PROVEN,
        };
    }
    if lp.is_irreducible || (info as usize) == 0 {
        return LoopDependence {
            kind: DEP_UNKNOWN,
            is_constant_dist: false,
            distance: 0i64,
            certainty: CERTAINTY_UNKNOWN,
        };
    }

    let ainfo = unsafe { view(*info) };
    let reg_a = alias_extract_region(ainfo, body, place_a, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
    let reg_b = alias_extract_region(ainfo, body, place_b, OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
    let qpt: u32 = if pt_a >= pt_b { pt_a } else { pt_b };
    let afact = alias_query_regions(ainfo, body, mut_view(*arena), view(reg_a), view(reg_b), qpt);
    if alias_is_no_alias_proven(view(afact)) {
        return LoopDependence {
            kind: DEP_NONE,
            is_constant_dist: false,
            distance: 0i64,
            certainty: CERTAINTY_PROVEN,
        };
    }

    // Affine index dependence solver on loop-invariant base container (`a[s*i + c1]` vs `a[s*i + c2]`)
    let mut idx_a: u32 = 0u32;
    let mut idx_b: u32 = 0u32;
    if place_a.local.v == place_b.local.v && place_a.proj_count == place_b.proj_count &&
       reg_a.cap_mode != CAP_MODE_RAW_PTR && reg_b.cap_mode != CAP_MODE_RAW_PTR &&
       lp_base_container_stable_in_loop(lp, body, info, place_a.local.v, place_a.proj_count) &&
       lp_extract_place_index_local(place_a, mut_view(idx_a)) &&
       lp_extract_place_index_local(place_b, mut_view(idx_b)) {
        let ssa_a = lp_resolve_ssa_local_at(lp, body, info, idx_a, pt_a, mut_view(*arena));
        let ssa_b = lp_resolve_ssa_local_at(lp, body, info, idx_b, pt_b, mut_view(*arena));
        let mut phi_a: u32 = 0u32;
        let mut step_a: i64 = 0i64;
        let mut scale_a: i64 = 0i64;
        let mut off_a: i64 = 0i64;
        let mut phi_b: u32 = 0u32;
        let mut step_b: i64 = 0i64;
        let mut scale_b: i64 = 0i64;
        let mut off_b: i64 = 0i64;
        if ssa_a.v != OPT_VALUE_NONE && ssa_b.v != OPT_VALUE_NONE &&
           lp_extract_ssa_affine_iv(tree, lp, body, ssa_a, mut_view(phi_a), mut_view(step_a), mut_view(scale_a), mut_view(off_a)) &&
           lp_extract_ssa_affine_iv(tree, lp, body, ssa_b, mut_view(phi_b), mut_view(step_b), mut_view(scale_b), mut_view(off_b)) &&
           phi_a == phi_b && scale_a == scale_b && step_a != 0i64 && scale_a != 0i64 {
            let mut stride_u: u64 = 0u64;
            if !opt_checked_mul_signed(scale_a as u64, step_a as u64, 64u32, mut_view(stride_u)) {
                let stride = stride_u as i64;
                let mut delta_u: u64 = 0u64;
                if stride != 0i64 && !opt_checked_sub_signed(off_a as u64, off_b as u64, 64u32, mut_view(delta_u)) {
                    let delta = delta_u as i64;
                    if delta == 0i64 {
                        return LoopDependence {
                            kind: DEP_LOOP_INDEPENDENT,
                            is_constant_dist: true,
                            distance: 0i64,
                            certainty: CERTAINTY_PROVEN,
                        };
                    }
                    let abs_delta: u64 = if delta < 0i64 { opt_twos_complement_u64(delta as u64) } else { delta as u64 };
                    let abs_stride: u64 = if stride < 0i64 { opt_twos_complement_u64(stride as u64) } else { stride as u64 };
                    let mut rem: u64 = 0u64;
                    let quot = opt_div_rem_u64(abs_delta, abs_stride, mut_view(rem));
                    if rem != 0u64 {
                        return LoopDependence {
                            kind: DEP_NONE,
                            is_constant_dist: false,
                            distance: 0i64,
                            certainty: CERTAINTY_PROVEN,
                        };
                    }
                    let same_sign = (delta > 0i64 && stride > 0i64) || (delta < 0i64 && stride < 0i64);
                    let dist = quot as i64;
                    if same_sign {
                        let dk: u8 = if is_write_a && is_write_b {
                            DEP_WAW_OUTPUT
                        } else if is_write_a {
                            DEP_RAW_FLOW
                        } else {
                            DEP_WAR_ANTI
                        };
                        return LoopDependence {
                            kind: dk,
                            is_constant_dist: true,
                            distance: dist,
                            certainty: CERTAINTY_PROVEN,
                        };
                    } else {
                        let dk2: u8 = if is_write_a && is_write_b {
                            DEP_WAW_OUTPUT
                        } else if is_write_b {
                            DEP_RAW_FLOW
                        } else {
                            DEP_WAR_ANTI
                        };
                        return LoopDependence {
                            kind: dk2,
                            is_constant_dist: true,
                            distance: dist,
                            certainty: CERTAINTY_PROVEN,
                        };
                    }
                }
            }
        }
    }

    if alias_is_must_alias_proven(view(afact)) {
        let dk3: u8 = if is_write_a && is_write_b {
            DEP_WAW_OUTPUT
        } else if is_write_a {
            DEP_RAW_FLOW
        } else {
            DEP_WAR_ANTI
        };
        return LoopDependence {
            kind: dk3,
            is_constant_dist: true,
            distance: 1i64,
            certainty: CERTAINTY_PROVEN,
        };
    }

    LoopDependence {
        kind: DEP_UNKNOWN,
        is_constant_dist: false,
        distance: 0i64,
        certainty: CERTAINTY_UNKNOWN,
    }
}

// --- Overflow-Faithful Scalar Evolution (`SCEV`) & Trip-Count Engine (AXS-LOOP-006, REQ-OPT-155..158, REQ-OPT-190) ---

fn lp_invert_cmp_op(op: u8) -> u8 {
    if op == MIR_BINOP_LT { return MIR_BINOP_GE; }
    if op == MIR_BINOP_LE { return MIR_BINOP_GT; }
    if op == MIR_BINOP_GT { return MIR_BINOP_LE; }
    if op == MIR_BINOP_GE { return MIR_BINOP_LT; }
    if op == MIR_BINOP_EQ { return MIR_BINOP_NE; }
    if op == MIR_BINOP_NE { return MIR_BINOP_EQ; }
    255u8
}

fn lp_commute_cmp_op(op: u8) -> u8 {
    if op == MIR_BINOP_LT { return MIR_BINOP_GT; }
    if op == MIR_BINOP_LE { return MIR_BINOP_GE; }
    if op == MIR_BINOP_GT { return MIR_BINOP_LT; }
    if op == MIR_BINOP_GE { return MIR_BINOP_LE; }
    if op == MIR_BINOP_EQ || op == MIR_BINOP_NE { return op; }
    255u8
}

pub fn loops_extract_bool_branch(
    bb: view<OptBlock>,
    out_cond: mut_view<OptValueId>,
    out_true_bb: mut_view<OptBbId>,
    out_false_bb: mut_view<OptBbId>
) -> bool {
    if !bb.has_term {
        return false;
    }
    let tk = bb.term.kind;
    if tk == OPT_TERM_BRANCH {
        *out_cond = bb.term.cond;
        *out_true_bb = bb.term.true_bb;
        *out_false_bb = bb.term.false_bb;
        return true;
    }
    if tk == OPT_TERM_SWITCH_INT && bb.term.switch_count == 1 &&
       (bb.term.switch_vals as usize) != 0 && (bb.term.switch_targets as usize) != 0 {
        let sv0 = unsafe { *(bb.term.switch_vals) };
        let st0 = unsafe { *opt_bbid_at(bb.term.switch_targets, 0) };
        if sv0 == 1u64 {
            *out_cond = bb.term.cond;
            *out_true_bb = st0;
            *out_false_bb = bb.term.otherwise_bb;
            return true;
        }
        if sv0 == 0u64 {
            *out_cond = bb.term.cond;
            *out_true_bb = bb.term.otherwise_bb;
            *out_false_bb = st0;
            return true;
        }
    }
    false
}

fn lp_extract_header_stay_cond(
    lp: view<LoopDesc>,
    body: view<OptBody>,
    phi_val: OptValueId,
    out_stay_op: mut_view<u8>,
    out_bound_val: mut_view<OptValueId>
) -> bool {
    if (lp.header.v as usize) >= body.bb_count {
        return false;
    }
    let hbb = unsafe { opt_block_at(body.blocks, lp.header.v as usize) };
    let mut raw_cond = OptValueId { v: OPT_VALUE_NONE };
    let mut t_bb = OptBbId { v: OPT_BB_NONE };
    let mut f_bb = OptBbId { v: OPT_BB_NONE };
    if !loops_extract_bool_branch(unsafe { view(*hbb) }, mut_view(raw_cond), mut_view(t_bb), mut_view(f_bb)) {
        return false;
    }
    let t_in = lp_block_in_set(lp.blocks, lp.block_count, t_bb.v);
    let f_in = lp_block_in_set(lp.blocks, lp.block_count, f_bb.v);
    if t_in == f_in {
        return false;
    }
    let mut stay_on_true = t_in;
    let mut cond_v = lp_peel_copy(body, raw_cond);
    let mut hops: usize = 0;
    while hops < 4 {
        let cinst = lp_find_def_inst(body, cond_v);
        if (cinst as usize) != 0 && (unsafe { (*cinst).opcode }) == OPT_INST_UNOP &&
           (unsafe { (*cinst).sub_op }) == MIR_UNOP_NOT {
            stay_on_true = !stay_on_true;
            cond_v = lp_peel_copy(body, unsafe { (*cinst).lhs });
            hops = hops + 1;
        } else {
            break;
        }
    }
    let cmp_inst = lp_find_def_inst(body, cond_v);
    if (cmp_inst as usize) == 0 || (unsafe { (*cmp_inst).opcode }) != OPT_INST_BINOP {
        return false;
    }
    let mut bop = unsafe { (*cmp_inst).sub_op };
    if bop < MIR_BINOP_EQ || bop > MIR_BINOP_GT {
        return false;
    }
    if !stay_on_true {
        bop = lp_invert_cmp_op(bop);
    }
    let lhs = lp_peel_copy(body, unsafe { (*cmp_inst).lhs });
    let rhs = lp_peel_copy(body, unsafe { (*cmp_inst).rhs });
    if lhs.v == phi_val.v && rhs.v != phi_val.v {
        *out_stay_op = bop;
        *out_bound_val = rhs;
        return true;
    }
    if rhs.v == phi_val.v && lhs.v != phi_val.v {
        let cbop = lp_commute_cmp_op(bop);
        if cbop != 255u8 {
            *out_stay_op = cbop;
            *out_bound_val = lhs;
            return true;
        }
    }
    false
}

fn scev_eval_invariant_atom(
    tree: mut_view<LoopTree>,
    lp_id: LoopId,
    body: view<OptBody>,
    val_id: OptValueId,
    arena: mut_view<Arena>
) -> u32 {
    let pv = lp_peel_copy(body, val_id);
    let ty: TypeId = if pv.v != OPT_VALUE_NONE && (pv.v as usize) <= body.value_count {
        unsafe { (*opt_val_at(body.values, pv.v as usize)).ty }
    } else {
        TypeId { v: 0u32 }
    };
    let mut cu: u64 = 0u64;
    let mut ci: i64 = 0i64;
    if lp_val_const_int(body, pv, mut_view(cu), mut_view(ci)) {
        return scev_alloc_expr(mut_view(*tree), mut_view(*arena), ScevExpr {
            kind: SCEV_CONST,
            ty: ty,
            loop_id: lp_id,
            arith_mode: ARITH_PROVEN_NSW_NUW,
            const_val: ci,
            ssa_val: pv,
            lhs_idx: SCEV_IDX_NONE,
            rhs_idx: SCEV_IDX_NONE,
            no_wrap_proven: true,
        });
    }
    scev_alloc_expr(mut_view(*tree), mut_view(*arena), ScevExpr {
        kind: SCEV_INVARIANT,
        ty: ty,
        loop_id: lp_id,
        arith_mode: ARITH_PROVEN_NSW_NUW,
        const_val: 0i64,
        ssa_val: pv,
        lhs_idx: SCEV_IDX_NONE,
        rhs_idx: SCEV_IDX_NONE,
        no_wrap_proven: true,
    })
}

fn lp_prove_const_trip(
    body: view<OptBody>,
    iv_ty: TypeId,
    arith_mode: u8,
    start_u: u64,
    start_i: i64,
    step_const: i64,
    stay_op: u8,
    bound_u: u64,
    bound_i: i64,
    exiting_count: usize,
    out_nowrap: mut_view<bool>
) -> ScevTripCount {
    *out_nowrap = false;
    if arith_mode == ARITH_SATURATING || step_const == 0i64 {
        return scev_trip_unknown();
    }
    let iv_ty_v = iv_ty.v;
    let mut bits = opt_type_bits(body.thir, TypeId { v: iv_ty_v });
    if bits == 0u32 {
        bits = 64u32;
    }
    let is_signed = opt_type_is_signed(body.thir, TypeId { v: iv_ty_v });
    let max_u = opt_bit_mask(bits);
    let max_s_tc = max_u >> 1u64;
    let min_s_tc = opt_sign_extend_u64(opt_sign_bit_mask(bits), bits);
    let start_tc: u64 = if is_signed { opt_sign_extend_u64(start_u, bits) } else { start_u & max_u };
    let bound_tc: u64 = if is_signed { opt_sign_extend_u64(bound_u, bits) } else { bound_u & max_u };

    if step_const > 0i64 {
        let step_u = step_const as u64;
        if stay_op == MIR_BINOP_LT || stay_op == MIR_BINOP_LE || stay_op == MIR_BINOP_NE {
            // Check 0-trip immediate exit
            let init_stays: bool = if stay_op == MIR_BINOP_LT {
                if is_signed { opt_signed_lt(start_tc, bound_tc) } else { start_tc < bound_tc }
            } else if stay_op == MIR_BINOP_LE {
                if is_signed { opt_signed_le(start_tc, bound_tc) } else { start_tc <= bound_tc }
            } else {
                start_tc != bound_tc
            };
            if !init_stays {
                *out_nowrap = true;
                return ScevTripCount {
                    kind: TRIP_CONST,
                    const_iters: 0u64,
                    sym_expr_idx: SCEV_IDX_NONE,
                    max_iters: 0u64,
                    certainty: CERTAINTY_PROVEN,
                };
            }
            if stay_op == MIR_BINOP_NE {
                let ordered = if is_signed { opt_signed_lt(start_tc, bound_tc) } else { start_tc < bound_tc };
                if !ordered {
                    return scev_trip_unknown();
                }
            }
            // If `i <= MAX_T`, `i + step` must cross `MAX_T`
            if stay_op == MIR_BINOP_LE {
                let at_max = if is_signed { bound_tc == max_s_tc } else { bound_tc == max_u };
                if at_max {
                    if arith_mode == ARITH_WRAPPING && !is_signed && start_tc == 0u64 && step_u == 1u64 && exiting_count <= 1 {
                        return ScevTripCount {
                            kind: TRIP_INFINITE,
                            const_iters: 0u64,
                            sym_expr_idx: SCEV_IDX_NONE,
                            max_iters: 0u64,
                            certainty: CERTAINTY_PROVEN,
                        };
                    }
                    return scev_trip_unknown();
                }
            }
            // Unsigned distance `bound - start`
            let neg_start = opt_twos_complement_u64(start_tc);
            let dist: u64 = if is_signed {
                opt_wrapping_add_u64(bound_tc, neg_start)
            } else {
                bound_tc - start_tc
            };
            let mut rem: u64 = 0u64;
            let mut iters: u64 = 0u64;
            if stay_op == MIR_BINOP_NE {
                iters = opt_div_rem_u64(dist, step_u, mut_view(rem));
                if rem != 0u64 {
                    return scev_trip_unknown();
                }
                *out_nowrap = true;
            } else if stay_op == MIR_BINOP_LT {
                iters = opt_div_rem_u64(dist - 1u64, step_u, mut_view(rem)) + 1u64;
            } else {
                iters = opt_div_rem_u64(dist, step_u, mut_view(rem)) + 1u64;
            }
            // Verify `(start + (iters - 1) * step) + step` does not overflow `bits`
            if stay_op != MIR_BINOP_NE && iters > 0u64 {
                let mut prev_delta: u64 = 0u64;
                if opt_checked_mul_u64(iters - 1u64, step_u, 64u32, mut_view(prev_delta)) {
                    return scev_trip_unknown();
                }
                let mut last_in_val: u64 = 0u64;
                let mut after_last: u64 = 0u64;
                if is_signed {
                    if opt_checked_add_signed(start_tc, prev_delta, bits, mut_view(last_in_val)) {
                        return scev_trip_unknown();
                    }
                    let last_tc = opt_sign_extend_u64(last_in_val, bits);
                    if opt_checked_add_signed(last_tc, step_u, bits, mut_view(after_last)) {
                        return scev_trip_unknown();
                    }
                } else {
                    if opt_checked_add_u64(start_tc, prev_delta, bits, mut_view(last_in_val)) {
                        return scev_trip_unknown();
                    }
                    if opt_checked_add_u64(last_in_val, step_u, bits, mut_view(after_last)) {
                        return scev_trip_unknown();
                    }
                }
                *out_nowrap = true;
            }
            let _ = bound_i;
            let _ = start_i;
            let tkind: u8 = if exiting_count <= 1 { TRIP_CONST } else { TRIP_UPPER_BOUNDED };
            return ScevTripCount {
                kind: tkind,
                const_iters: if tkind == TRIP_CONST { iters } else { 0u64 },
                sym_expr_idx: SCEV_IDX_NONE,
                max_iters: iters,
                certainty: CERTAINTY_PROVEN,
            };
        }
    } else if step_const < 0i64 {
        let abs_step = opt_twos_complement_u64(step_const as u64);
        if stay_op == MIR_BINOP_GT || stay_op == MIR_BINOP_GE || stay_op == MIR_BINOP_NE {
            let init_stays2: bool = if stay_op == MIR_BINOP_GT {
                if is_signed { opt_signed_lt(bound_tc, start_tc) } else { start_tc > bound_tc }
            } else if stay_op == MIR_BINOP_GE {
                if is_signed { opt_signed_le(bound_tc, start_tc) } else { start_tc >= bound_tc }
            } else {
                start_tc != bound_tc
            };
            if !init_stays2 {
                *out_nowrap = true;
                return ScevTripCount {
                    kind: TRIP_CONST,
                    const_iters: 0u64,
                    sym_expr_idx: SCEV_IDX_NONE,
                    max_iters: 0u64,
                    certainty: CERTAINTY_PROVEN,
                };
            }
            if stay_op == MIR_BINOP_NE {
                let ordered2 = if is_signed { opt_signed_lt(bound_tc, start_tc) } else { start_tc > bound_tc };
                if !ordered2 {
                    return scev_trip_unknown();
                }
            }
            if stay_op == MIR_BINOP_GE {
                let at_min = if is_signed { bound_tc == min_s_tc } else { bound_tc == 0u64 };
                if at_min {
                    if arith_mode == ARITH_WRAPPING && !is_signed && abs_step == 1u64 && exiting_count <= 1 {
                        return ScevTripCount {
                            kind: TRIP_INFINITE,
                            const_iters: 0u64,
                            sym_expr_idx: SCEV_IDX_NONE,
                            max_iters: 0u64,
                            certainty: CERTAINTY_PROVEN,
                        };
                    }
                    return scev_trip_unknown();
                }
            }
            let neg_bound = opt_twos_complement_u64(bound_tc);
            let dist2: u64 = if is_signed {
                opt_wrapping_add_u64(start_tc, neg_bound)
            } else {
                start_tc - bound_tc
            };
            let mut rem2: u64 = 0u64;
            let mut iters2: u64 = 0u64;
            if stay_op == MIR_BINOP_NE {
                iters2 = opt_div_rem_u64(dist2, abs_step, mut_view(rem2));
                if rem2 != 0u64 {
                    return scev_trip_unknown();
                }
                *out_nowrap = true;
            } else if stay_op == MIR_BINOP_GT {
                iters2 = opt_div_rem_u64(dist2 - 1u64, abs_step, mut_view(rem2)) + 1u64;
            } else {
                iters2 = opt_div_rem_u64(dist2, abs_step, mut_view(rem2)) + 1u64;
            }
            if stay_op != MIR_BINOP_NE && iters2 > 0u64 {
                let mut prev_d2: u64 = 0u64;
                if opt_checked_mul_u64(iters2 - 1u64, abs_step, 64u32, mut_view(prev_d2)) {
                    return scev_trip_unknown();
                }
                let mut last_v2: u64 = 0u64;
                let mut after_v2: u64 = 0u64;
                if is_signed {
                    if opt_checked_sub_signed(start_tc, prev_d2, bits, mut_view(last_v2)) {
                        return scev_trip_unknown();
                    }
                    let last_tc2 = opt_sign_extend_u64(last_v2, bits);
                    if opt_checked_sub_signed(last_tc2, abs_step, bits, mut_view(after_v2)) {
                        return scev_trip_unknown();
                    }
                } else {
                    if opt_checked_sub_u64(start_tc, prev_d2, bits, mut_view(last_v2)) {
                        return scev_trip_unknown();
                    }
                    if opt_checked_sub_u64(last_v2, abs_step, bits, mut_view(after_v2)) {
                        return scev_trip_unknown();
                    }
                }
                *out_nowrap = true;
            }
            let tkind2: u8 = if exiting_count <= 1 { TRIP_CONST } else { TRIP_UPPER_BOUNDED };
            return ScevTripCount {
                kind: tkind2,
                const_iters: if tkind2 == TRIP_CONST { iters2 } else { 0u64 },
                sym_expr_idx: SCEV_IDX_NONE,
                max_iters: iters2,
                certainty: CERTAINTY_PROVEN,
            };
        }
    }
    scev_trip_unknown()
}

pub fn scev_analyze_loop(
    tree: mut_view<LoopTree>,
    loop_idx: usize,
    body: view<OptBody>,
    info: *const AliasInfo,
    arena: mut_view<Arena>
) {
    if loop_idx >= tree.loop_count || (tree.loops as usize) == 0 {
        return;
    }
    let lp_ptr = unsafe { loop_desc_at(tree.loops, loop_idx) };
    if (unsafe { (*lp_ptr).is_irreducible }) || (unsafe { (*lp_ptr).latch_count }) != 1 {
        return;
    }
    let lp_id = unsafe { (*lp_ptr).id };
    let hdr_id = unsafe { (*lp_ptr).header };
    let latch_id = unsafe { *opt_bbid_at((*lp_ptr).latches, 0) };
    if (hdr_id.v as usize) >= body.bb_count {
        return;
    }

    let hbb = unsafe { opt_block_at(body.blocks, hdr_id.v as usize) };
    let phi_cnt = unsafe { (*hbb).phi_count };
    let max_ivs = phi_cnt + 16;
    let iv_arr = arena_alloc_raw(mut_view(*arena), lp_mul_usize(if max_ivs == 0 { 1 } else { max_ivs }, size_of<InductionVar>()), align_of<InductionVar>()) as *mut InductionVar;
    let mut iv_cnt: usize = 0;

    // 1. Discover primary induction variables on header OptPhis
    let mut pi: usize = 0;
    while pi < phi_cnt {
        let phi = unsafe { opt_phi_at((*hbb).phis, pi) };
        let phi_res = unsafe { (*phi).result };
        let phi_ty_v = unsafe { (*phi).ty.v };
        let phi_loc = unsafe { (*phi).src_local.v };
        let ar = unsafe { (*phi).arity };

        if phi_loc == 0u32 || !loops_local_has_indirect_mutation(body, info, phi_loc) {
            let mut start_val = OptValueId { v: OPT_VALUE_NONE };
            let mut latch_val = OptValueId { v: OPT_VALUE_NONE };
            let mut start_ok = true;
            let mut k: usize = 0;
            while k < ar {
                let ib = unsafe { *opt_bbid_at((*phi).incoming_blocks, k) };
                let iv_in = lp_peel_copy(body, unsafe { *opt_valid_at((*phi).incoming_values, k) });
                if ib.v == latch_id.v {
                    latch_val = iv_in;
                } else {
                    if start_val.v == OPT_VALUE_NONE {
                        start_val = iv_in;
                    } else if !lp_same_scalar_operand(body, start_val, iv_in) {
                        start_ok = false;
                    }
                }
                k = k + 1;
            }

            if start_ok && start_val.v != OPT_VALUE_NONE && latch_val.v != OPT_VALUE_NONE &&
               loops_is_val_invariant(unsafe { view(*lp_ptr) }, body, info, start_val) {
                let step_inst = lp_find_def_inst(body, latch_val);
                if (step_inst as usize) != 0 {
                    let step_vp = unsafe { opt_val_at(body.values, latch_val.v as usize) };
                    let step_bb = unsafe { (*step_vp).def_bb };
                    if lp_block_in_set(unsafe { (*lp_ptr).blocks }, unsafe { (*lp_ptr).block_count }, step_bb.v) {
                        let opc = unsafe { (*step_inst).opcode };
                        let bop = unsafe { (*step_inst).sub_op };
                        let slhs = lp_peel_copy(body, unsafe { (*step_inst).lhs });
                        let srhs = lp_peel_copy(body, unsafe { (*step_inst).rhs });

                        let mut is_valid_step = false;
                        let mut is_sub = false;
                        let mut amode: u8 = ARITH_WRAPPING;
                        let mut step_op_val = OptValueId { v: OPT_VALUE_NONE };

                        if opc == OPT_INST_WRAPPING_BINOP && (bop == MIR_BINOP_WRAPPING_ADD || bop == MIR_BINOP_WRAPPING_SUB) {
                            amode = ARITH_WRAPPING;
                            is_sub = bop == MIR_BINOP_WRAPPING_SUB;
                            if slhs.v == phi_res.v && loops_is_val_invariant(unsafe { view(*lp_ptr) }, body, info, srhs) {
                                step_op_val = srhs;
                                is_valid_step = true;
                            } else if !is_sub && srhs.v == phi_res.v && loops_is_val_invariant(unsafe { view(*lp_ptr) }, body, info, slhs) {
                                step_op_val = slhs;
                                is_valid_step = true;
                            }
                        } else if opc == OPT_INST_BINOP && (bop == MIR_BINOP_SAT_ADD || bop == MIR_BINOP_SAT_SUB) {
                            amode = ARITH_SATURATING;
                            is_sub = bop == MIR_BINOP_SAT_SUB;
                            if slhs.v == phi_res.v && loops_is_val_invariant(unsafe { view(*lp_ptr) }, body, info, srhs) {
                                step_op_val = srhs;
                                is_valid_step = true;
                            } else if !is_sub && srhs.v == phi_res.v && loops_is_val_invariant(unsafe { view(*lp_ptr) }, body, info, slhs) {
                                step_op_val = slhs;
                                is_valid_step = true;
                            }
                        } else if opc == OPT_INST_BINOP && (bop == MIR_BINOP_ADD || bop == MIR_BINOP_SUB) {
                            is_sub = bop == MIR_BINOP_SUB;
                            let has_ov = lp_has_dominating_overflow_guard(
                                unsafe { view(*lp_ptr) }, body, step_bb, bop,
                                unsafe { (*step_inst).lhs }, unsafe { (*step_inst).rhs }
                            );
                            amode = if has_ov { ARITH_CHECKED } else { ARITH_WRAPPING };
                            if slhs.v == phi_res.v && loops_is_val_invariant(unsafe { view(*lp_ptr) }, body, info, srhs) {
                                step_op_val = srhs;
                                is_valid_step = true;
                            } else if !is_sub && srhs.v == phi_res.v && loops_is_val_invariant(unsafe { view(*lp_ptr) }, body, info, slhs) {
                                step_op_val = slhs;
                                is_valid_step = true;
                            }
                        }

                        if is_valid_step && iv_cnt < max_ivs {
                            let start_idx = scev_eval_invariant_atom(mut_view(*tree), lp_id, body, start_val, mut_view(*arena));
                            let mut st_u: u64 = 0u64;
                            let mut st_i: i64 = 0i64;
                            let mut step_c: i64 = 0i64;
                            let mut step_idx: u32 = SCEV_IDX_NONE;
                            if lp_val_const_int(body, step_op_val, mut_view(st_u), mut_view(st_i)) {
                                let is_sig = opt_type_is_signed(body.thir, TypeId { v: phi_ty_v });
                                if is_sub {
                                    if !is_sig && st_u <= 0x7FFFFFFFFFFFFFFFu64 {
                                        step_c = opt_twos_complement_u64(st_u) as i64;
                                    } else if is_sig && st_i != (-9223372036854775807i64 - 1i64) {
                                        step_c = 0i64 - st_i;
                                    }
                                } else {
                                    if !is_sig && st_u <= 0x7FFFFFFFFFFFFFFFu64 {
                                        step_c = st_u as i64;
                                    } else if is_sig {
                                        step_c = st_i;
                                    }
                                }
                                step_idx = scev_alloc_expr(mut_view(*tree), mut_view(*arena), ScevExpr {
                                    kind: SCEV_CONST,
                                    ty: TypeId { v: phi_ty_v },
                                    loop_id: lp_id,
                                    arith_mode: amode,
                                    const_val: step_c,
                                    ssa_val: step_op_val,
                                    lhs_idx: SCEV_IDX_NONE,
                                    rhs_idx: SCEV_IDX_NONE,
                                    no_wrap_proven: true,
                                });
                            } else {
                                step_idx = scev_eval_invariant_atom(mut_view(*tree), lp_id, body, step_op_val, mut_view(*arena));
                            }

                            // Prove trip-count and non-wrapping property against header exit test
                            let mut nowrap = false;
                            let mut stay_op: u8 = 255u8;
                            let mut bound_val = OptValueId { v: OPT_VALUE_NONE };
                            if step_c != 0i64 && amode != ARITH_SATURATING &&
                               lp_extract_header_stay_cond(unsafe { view(*lp_ptr) }, body, phi_res, mut_view(stay_op), mut_view(bound_val)) &&
                               loops_is_val_invariant(unsafe { view(*lp_ptr) }, body, info, bound_val) {
                                let mut s_u: u64 = 0u64;
                                let mut s_i: i64 = 0i64;
                                let mut b_u: u64 = 0u64;
                                let mut b_i: i64 = 0i64;
                                let s_const = lp_val_const_int(body, start_val, mut_view(s_u), mut_view(s_i));
                                let b_const = lp_val_const_int(body, bound_val, mut_view(b_u), mut_view(b_i));
                                let ex_cnt = unsafe { (*lp_ptr).exiting_count };

                                if s_const && b_const {
                                    let tc = lp_prove_const_trip(
                                        body, TypeId { v: phi_ty_v }, amode, s_u, s_i, step_c, stay_op, b_u, b_i, ex_cnt, mut_view(nowrap)
                                    );
                                    if tc.kind != TRIP_UNKNOWN && (unsafe { (*lp_ptr).trip_count.kind }) == TRIP_UNKNOWN {
                                        unsafe {
                                            (*lp_ptr).trip_count = tc;
                                            (*lp_ptr).exit_bound_val = bound_val;
                                            (*lp_ptr).exit_is_inclusive = stay_op == MIR_BINOP_LE || stay_op == MIR_BINOP_GE;
                                        }
                                    }
                                } else if step_c == 1i64 && stay_op == MIR_BINOP_LT {
                                    // `i < bound <= MAX_T` guarantees `i + 1 <= MAX_T` without wrap or trap
                                    nowrap = true;
                                    unsafe {
                                        (*lp_ptr).exit_bound_val = bound_val;
                                        (*lp_ptr).exit_is_inclusive = false;
                                    }
                                    if s_const && s_u == 0u64 && ex_cnt <= 1 && (unsafe { (*lp_ptr).trip_count.kind }) == TRIP_UNKNOWN {
                                        let b_idx = scev_eval_invariant_atom(mut_view(*tree), lp_id, body, bound_val, mut_view(*arena));
                                        let mut sym_idx = b_idx;
                                        let phi_sig = opt_type_is_signed(body.thir, TypeId { v: phi_ty_v });
                                        if phi_sig {
                                            let z_idx = scev_alloc_expr(mut_view(*tree), mut_view(*arena), ScevExpr {
                                                kind: SCEV_CONST,
                                                ty: TypeId { v: phi_ty_v },
                                                loop_id: lp_id,
                                                arith_mode: ARITH_PROVEN_NSW_NUW,
                                                const_val: 0i64,
                                                ssa_val: OptValueId { v: OPT_VALUE_NONE },
                                                lhs_idx: SCEV_IDX_NONE,
                                                rhs_idx: SCEV_IDX_NONE,
                                                no_wrap_proven: true,
                                            });
                                            sym_idx = scev_alloc_expr(mut_view(*tree), mut_view(*arena), ScevExpr {
                                                kind: SCEV_MAX,
                                                ty: TypeId { v: phi_ty_v },
                                                loop_id: lp_id,
                                                arith_mode: ARITH_PROVEN_NSW_NUW,
                                                const_val: 0i64,
                                                ssa_val: bound_val,
                                                lhs_idx: z_idx,
                                                rhs_idx: b_idx,
                                                no_wrap_proven: true,
                                            });
                                        }
                                        unsafe {
                                            (*lp_ptr).trip_count = ScevTripCount {
                                                kind: TRIP_SYMBOLIC,
                                                const_iters: 0u64,
                                                sym_expr_idx: sym_idx,
                                                max_iters: 0u64,
                                                certainty: CERTAINTY_PROVEN,
                                            };
                                        }
                                    }
                                } else if step_c == -1i64 && stay_op == MIR_BINOP_GT {
                                    // `i > bound >= MIN_T` guarantees `i - 1 >= MIN_T` without wrap or trap
                                    nowrap = true;
                                    unsafe {
                                        (*lp_ptr).exit_bound_val = bound_val;
                                        (*lp_ptr).exit_is_inclusive = false;
                                    }
                                }
                            }

                            let eff_mode: u8 = if nowrap { ARITH_PROVEN_NSW_NUW } else { amode };
                            let _ = scev_alloc_expr(mut_view(*tree), mut_view(*arena), ScevExpr {
                                kind: SCEV_ADD_REC,
                                ty: TypeId { v: phi_ty_v },
                                loop_id: lp_id,
                                arith_mode: eff_mode,
                                const_val: step_c,
                                ssa_val: phi_res,
                                lhs_idx: start_idx,
                                rhs_idx: step_idx,
                                no_wrap_proven: nowrap,
                            });

                            unsafe {
                                *loop_iv_at(iv_arr, iv_cnt) = InductionVar {
                                    phi_val: phi_res,
                                    ssa_val: phi_res,
                                    start_expr: start_idx,
                                    step_const: step_c,
                                    step_expr: step_idx,
                                    scale_const: 1i64,
                                    offset_expr: SCEV_IDX_NONE,
                                    arith_mode: eff_mode,
                                    is_primary: true,
                                    no_wrap_proven: nowrap,
                                };
                            }
                            iv_cnt = iv_cnt + 1;
                            if nowrap && step_c != 0i64 && step_idx != SCEV_IDX_NONE &&
                               latch_val.v != phi_res.v && iv_cnt < max_ivs {
                                unsafe {
                                    *loop_iv_at(iv_arr, iv_cnt) = InductionVar {
                                        phi_val: phi_res,
                                        ssa_val: latch_val,
                                        start_expr: start_idx,
                                        step_const: step_c,
                                        step_expr: step_idx,
                                        scale_const: 1i64,
                                        offset_expr: step_idx,
                                        arith_mode: eff_mode,
                                        is_primary: false,
                                        no_wrap_proven: true,
                                    };
                                }
                                iv_cnt = iv_cnt + 1;
                            }
                        }
                    }
                }
            }
        }
        pi = pi + 1;
    }

    // 2. Discover affine derived induction variables (`scale * piv + offset`) inside loop blocks
    let mut bk: usize = 0;
    while bk < (unsafe { (*lp_ptr).block_count }) && iv_cnt < max_ivs {
        let bv = unsafe { (*opt_bbid_at((*lp_ptr).blocks, bk)).v };
        if (bv as usize) < body.bb_count {
            let bb = unsafe { opt_block_at(body.blocks, bv as usize) };
            let icnt = unsafe { (*bb).inst_count };
            let mut ii: usize = 0;
            while ii < icnt && iv_cnt < max_ivs {
                let inst = unsafe { opt_inst_at((*bb).insts, ii) };
                let opc = unsafe { (*inst).opcode };
                let bop = unsafe { (*inst).sub_op };
                let res_v = unsafe { (*inst).result };
                if opc == OPT_INST_BINOP && res_v.v != OPT_VALUE_NONE &&
                   (bop == MIR_BINOP_ADD || bop == MIR_BINOP_SUB || bop == MIR_BINOP_MUL) {
                    let res_peel = lp_peel_copy_and_lcssa(body, res_v);
                    let mut already_iv = false;
                    let mut dup_k: usize = 0;
                    while dup_k < iv_cnt {
                        let ex_iv = unsafe { loop_iv_at(iv_arr, dup_k) };
                        if lp_peel_copy_and_lcssa(body, unsafe { (*ex_iv).ssa_val }).v == res_peel.v {
                            already_iv = true;
                            break;
                        }
                        dup_k = dup_k + 1;
                    }
                    let ilhs = lp_peel_copy(body, unsafe { (*inst).lhs });
                    let irhs = lp_peel_copy(body, unsafe { (*inst).rhs });
                    let cur_iv_cnt = iv_cnt;
                    let mut p_idx: usize = if already_iv { cur_iv_cnt } else { 0 };
                    while p_idx < cur_iv_cnt && iv_cnt < max_ivs {
                        let piv = unsafe { loop_iv_at(iv_arr, p_idx) };
                        let p_phi = unsafe { (*piv).phi_val };
                        let p_ssa = unsafe { (*piv).ssa_val };
                        let p_is_prim = unsafe { (*piv).is_primary };
                        let mut c_u: u64 = 0u64;
                        let mut c_i: i64 = 0i64;
                        let has_ov_d = lp_has_dominating_overflow_guard(
                            unsafe { view(*lp_ptr) }, body, OptBbId { v: bv }, bop,
                            unsafe { (*inst).lhs }, unsafe { (*inst).rhs }
                        );
                        if (unsafe { (*piv).no_wrap_proven }) && has_ov_d {
                            if p_is_prim && bop == MIR_BINOP_MUL &&
                               ((ilhs.v == p_phi.v && lp_val_const_int(body, irhs, mut_view(c_u), mut_view(c_i))) ||
                                (irhs.v == p_phi.v && lp_val_const_int(body, ilhs, mut_view(c_u), mut_view(c_i)))) {
                                let sc_c: i64 = if opt_type_is_signed(body.thir, unsafe { (*inst).ty }) { c_i } else { c_u as i64 };
                                let z_off = scev_alloc_expr(mut_view(*tree), mut_view(*arena), ScevExpr {
                                    kind: SCEV_CONST, ty: unsafe { (*inst).ty }, loop_id: lp_id,
                                    arith_mode: ARITH_CHECKED, const_val: 0i64, ssa_val: OptValueId { v: OPT_VALUE_NONE },
                                    lhs_idx: SCEV_IDX_NONE, rhs_idx: SCEV_IDX_NONE, no_wrap_proven: true,
                                });
                                unsafe {
                                    *loop_iv_at(iv_arr, iv_cnt) = InductionVar {
                                        phi_val: p_phi, ssa_val: res_v, start_expr: (*piv).start_expr,
                                        step_const: sc_c, step_expr: (*piv).step_expr, scale_const: sc_c,
                                        offset_expr: z_off, arith_mode: ARITH_CHECKED, is_primary: false, no_wrap_proven: true,
                                    };
                                }
                                iv_cnt = iv_cnt + 1;
                                break;
                            } else if ((bop == MIR_BINOP_ADD || bop == MIR_BINOP_SUB) &&
                                       ilhs.v == p_ssa.v && lp_val_const_int(body, irhs, mut_view(c_u), mut_view(c_i))) ||
                                      (bop == MIR_BINOP_ADD &&
                                       irhs.v == p_ssa.v && lp_val_const_int(body, ilhs, mut_view(c_u), mut_view(c_i))) {
                                let c_op_val = if ilhs.v == p_ssa.v { irhs } else { ilhs };
                                // Allow primary `piv +- c` OR zero-offset scaled `(k * piv) +- c`
                                let mut base_off_zero = p_is_prim;
                                if !base_off_zero {
                                    let boidx = (unsafe { (*piv).offset_expr }) as usize;
                                    if boidx < tree.scev_count && (tree.scev_pool as usize) != 0 {
                                        let boex = unsafe { scev_expr_at(tree.scev_pool, boidx) };
                                        if (unsafe { (*boex).kind }) == SCEV_CONST && (unsafe { (*boex).const_val }) == 0i64 {
                                            base_off_zero = true;
                                        }
                                    }
                                }
                                if base_off_zero {
                                    let raw_c: i64 = if opt_type_is_signed(body.thir, unsafe { (*inst).ty }) { c_i } else { c_u as i64 };
                                    let off_c: i64 = if bop == MIR_BINOP_SUB { 0i64 - raw_c } else { raw_c };
                                    let off_e = scev_alloc_expr(mut_view(*tree), mut_view(*arena), ScevExpr {
                                        kind: SCEV_CONST, ty: unsafe { (*inst).ty }, loop_id: lp_id,
                                        arith_mode: ARITH_CHECKED, const_val: off_c, ssa_val: c_op_val,
                                        lhs_idx: SCEV_IDX_NONE, rhs_idx: SCEV_IDX_NONE, no_wrap_proven: true,
                                    });
                                    unsafe {
                                        *loop_iv_at(iv_arr, iv_cnt) = InductionVar {
                                            phi_val: p_phi, ssa_val: res_v, start_expr: (*piv).start_expr,
                                            step_const: (*piv).step_const, step_expr: (*piv).step_expr, scale_const: (*piv).scale_const,
                                            offset_expr: off_e, arith_mode: ARITH_CHECKED, is_primary: false, no_wrap_proven: true,
                                        };
                                    }
                                    iv_cnt = iv_cnt + 1;
                                    break;
                                }
                            }
                        }
                        p_idx = p_idx + 1;
                    }
                }
                ii = ii + 1;
            }
        }
        bk = bk + 1;
    }

    let lp_fin = unsafe { loop_desc_at(tree.loops, loop_idx) };
    unsafe {
        (*lp_fin).ivs = iv_arr;
        (*lp_fin).iv_count = iv_cnt;
    }
}

pub fn scev_analyze_tree(
    tree: mut_view<LoopTree>,
    body: view<OptBody>,
    info: *const AliasInfo,
    arena: mut_view<Arena>
) {
    let mut i: usize = 0;
    while i < tree.loop_count {
        scev_analyze_loop(mut_view(*tree), i, body, info, mut_view(*arena));
        i = i + 1;
    }
}

pub fn scev_eval_value(
    tree: mut_view<LoopTree>,
    lp_id: LoopId,
    body: view<OptBody>,
    info: *const AliasInfo,
    val_id: OptValueId,
    arena: mut_view<Arena>
) -> ScevExpr {
    let pv = lp_peel_copy(body, val_id);
    let ty: TypeId = if pv.v != OPT_VALUE_NONE && (pv.v as usize) <= body.value_count {
        unsafe { (*opt_val_at(body.values, pv.v as usize)).ty }
    } else {
        TypeId { v: 0u32 }
    };
    let mut i: usize = 0;
    while i < tree.scev_count && (tree.scev_pool as usize) != 0 {
        let ex = unsafe { scev_expr_at(tree.scev_pool, i) };
        if (unsafe { (*ex).loop_id.v }) == lp_id.v && (unsafe { (*ex).ssa_val.v }) == pv.v {
            return unsafe { *ex };
        }
        i = i + 1;
    }
    if (lp_id.v as usize) < tree.loop_count && (tree.loops as usize) != 0 {
        let lp = unsafe { loop_desc_at(tree.loops, lp_id.v as usize) };
        if loops_is_val_invariant(unsafe { view(*lp) }, body, info, pv) {
            let idx = scev_eval_invariant_atom(mut_view(*tree), lp_id, body, pv, mut_view(*arena));
            return unsafe { *scev_expr_at(tree.scev_pool, idx as usize) };
        }
    }
    scev_unknown_expr(ty, lp_id, pv)
}

