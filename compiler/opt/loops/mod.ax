    32u8, 101u8, 120u8, 105u8, 116u8, 115u8, 61u8,
    32u8, 99u8, 97u8, 110u8, 111u8, 110u8, 61u8,
    32u8, 108u8, 99u8, 115u8, 115u8, 97u8, 61u8,
    32u8, 105u8, 114, 114, 101, 100, 61,
    32u8, 98u8, 97u8, 114u8, 114u8, 105u8, 101u8, 114u8, 115u8, 61u8,
    32u8, 116u8, 114u8, 105u8, 112u8, 61u8,
    67u8, 79u8, 78u8, 83u8, 84u8, 58u8,
    83u8, 89u8, 77u8, 66u8, 79u8, 76u8, 73u8, 67u8,
    85u8, 80u8, 80u8, 69u8, 82u8, 58u8,
    73u8, 78u8, 70u8, 73u8, 78u8, 73u8, 84u8, 69u8,
    85u8, 78u8, 75u8, 78u8, 79u8, 87u8, 78u8,
    32u8, 105u8, 118u8, 115u8, 61u8,
    32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 105u8, 118u8, 32u8, 118u8,
    32u8, 115u8, 116u8, 101u8, 112u8, 61u8,
    45u8,
    32u8, 109u8, 111u8, 100u8, 101u8, 61u8,
    67u8, 72u8, 69u8, 67u8, 75u8, 69u8, 68u8,
    87u8, 82u8, 65u8, 80u8, 80u8, 73u8, 78u8, 71u8,
    83u8, 65u8, 84u8, 85u8, 82u8, 65u8, 84u8, 73u8, 78u8, 71u8,
    78u8, 83u8, 87u8, 95u8, 78u8, 85u8, 87u8,
    32u8, 110u8, 111u8, 119u8, 114u8, 97u8, 112u8, 61u8,
    32u8, 112u8, 114u8, 105u8, 109u8, 97u8, 114u8, 121u8, 61u8,
];

const LOOPS_STR_OFF: [37]u32 = [
    0u32, 13u32, 15u32, 35u32, 39u32, 44u32, 45u32, 55u32, 62u32, 69u32,
    77u32, 84u32, 86u32, 90u32, 96u32, 103u32, 110u32, 117u32, 124u32, 134u32,
    140u32, 146u32, 154u32, 160u32, 168u32, 175u32, 180u32, 192u32, 198u32, 199u32,
    205u32, 212u32, 220u32, 230u32, 237u32, 245u32, 254u32,
];

fn lp_push_tok(out: mut_view<DiagBuffer>, tok: usize) {
    let start = LOOPS_STR_OFF[tok] as usize;
    let end = LOOPS_STR_OFF[tok + 1] as usize;
    let mut i: usize = start;
    while i < end {
        diag_buf_push_byte(mut_view(*out), LOOPS_STR_DATA[i]);
        i = i + 1;
    }
}

fn lp_push_bool(out: mut_view<DiagBuffer>, b: bool) {
    if b {
        lp_push_tok(mut_view(*out), 3);
    } else {
        lp_push_tok(mut_view(*out), 4);
    }
}

pub fn loops_print(out: mut_view<DiagBuffer>, tree: view<LoopTree>) {
    lp_push_tok(mut_view(*out), 0); // "loops_info {\n"
    lp_push_tok(mut_view(*out), 2); // "    irreducible_cfg="
    lp_push_bool(mut_view(*out), tree.has_irreducible_cfg);
    lp_push_tok(mut_view(*out), 5); // "\n"

    let mut i: usize = 0;
    while i < tree.loop_count && (tree.loops as usize) != 0 {
        let lp = unsafe { loop_desc_at(tree.loops, i) };
        lp_push_tok(mut_view(*out), 6); // "    loop L"
        diag_buf_push_u32(mut_view(*out), unsafe { (*lp).id.v });
        lp_push_tok(mut_view(*out), 7); // " depth="
        diag_buf_push_u32(mut_view(*out), unsafe { (*lp).depth });
        lp_push_tok(mut_view(*out), 8); // " hdr=bb"
        diag_buf_push_u32(mut_view(*out), unsafe { (*lp).header.v });
        lp_push_tok(mut_view(*out), 9); // " prehdr="
        if (unsafe { (*lp).preheader.v }) == OPT_BB_NONE {
            lp_push_tok(mut_view(*out), 12);
        } else {
            lp_push_tok(mut_view(*out), 11);
            diag_buf_push_u32(mut_view(*out), unsafe { (*lp).preheader.v });
        }
        lp_push_tok(mut_view(*out), 10); // " latch="
        if (unsafe { (*lp).single_latch.v }) == OPT_BB_NONE {
            lp_push_tok(mut_view(*out), 12);
        } else {
            lp_push_tok(mut_view(*out), 11);
            diag_buf_push_u32(mut_view(*out), unsafe { (*lp).single_latch.v });
        }
        lp_push_tok(mut_view(*out), 13); // " blks="
        diag_buf_push_u32(mut_view(*out), (unsafe { (*lp).block_count }) as u32);
        lp_push_tok(mut_view(*out), 14); // " exits="
        diag_buf_push_u32(mut_view(*out), (unsafe { (*lp).exit_count }) as u32);
        lp_push_tok(mut_view(*out), 15); // " canon="
        lp_push_bool(mut_view(*out), unsafe { (*lp).is_canonical_simplified });
        lp_push_tok(mut_view(*out), 16); // " lcssa="
        lp_push_bool(mut_view(*out), unsafe { (*lp).is_lcssa });
        lp_push_tok(mut_view(*out), 17); // " irred="
        lp_push_bool(mut_view(*out), unsafe { (*lp).is_irreducible });
        lp_push_tok(mut_view(*out), 18); // " barriers="
        diag_buf_push_u32(mut_view(*out), (unsafe { (*lp).has_observable_barriers }) as u32);
        lp_push_tok(mut_view(*out), 19); // " trip="
        let tk = unsafe { (*lp).trip_count.kind };
        if tk == TRIP_CONST {
            lp_push_tok(mut_view(*out), 20);
            diag_buf_push_u32(mut_view(*out), (unsafe { (*lp).trip_count.const_iters }) as u32);
        } else if tk == TRIP_SYMBOLIC {
            lp_push_tok(mut_view(*out), 21);
        } else if tk == TRIP_UPPER_BOUNDED {
            lp_push_tok(mut_view(*out), 22);
            diag_buf_push_u32(mut_view(*out), (unsafe { (*lp).trip_count.max_iters }) as u32);
        } else if tk == TRIP_INFINITE {
            lp_push_tok(mut_view(*out), 23);
        } else {
            lp_push_tok(mut_view(*out), 24);
        }
        lp_push_tok(mut_view(*out), 25); // " ivs="
        diag_buf_push_u32(mut_view(*out), (unsafe { (*lp).iv_count }) as u32);
        lp_push_tok(mut_view(*out), 5); // "\n"

        let ivc = unsafe { (*lp).iv_count };
        let mut j: usize = 0;
        while j < ivc && ((unsafe { (*lp).ivs }) as usize) != 0 {
            let iv = unsafe { loop_iv_at((*lp).ivs, j) };
            lp_push_tok(mut_view(*out), 26); // "        iv v"
            diag_buf_push_u32(mut_view(*out), unsafe { (*iv).ssa_val.v });
            lp_push_tok(mut_view(*out), 27); // " step="
            let stc = unsafe { (*iv).step_const };
            if stc < 0i64 {
                lp_push_tok(mut_view(*out), 28); // "-"
                let abs_st = opt_twos_complement_u64(stc as u64);
                diag_buf_push_u32(mut_view(*out), abs_st as u32);
            } else {
                diag_buf_push_u32(mut_view(*out), stc as u32);
            }
            lp_push_tok(mut_view(*out), 29); // " mode="
            let am = unsafe { (*iv).arith_mode };
            let mtok: usize = if am == ARITH_CHECKED {
                30
            } else if am == ARITH_WRAPPING {
                31
            } else if am == ARITH_SATURATING {
                32
            } else {
                33
            };
            lp_push_tok(mut_view(*out), mtok);
            lp_push_tok(mut_view(*out), 34); // " nowrap="
            lp_push_bool(mut_view(*out), unsafe { (*iv).no_wrap_proven });
            lp_push_tok(mut_view(*out), 35); // " primary="
            lp_push_bool(mut_view(*out), unsafe { (*iv).is_primary });
            lp_push_tok(mut_view(*out), 5); // "\n"
            j = j + 1;
        }
        i = i + 1;
    }
    lp_push_tok(mut_view(*out), 1); // "}\n"
}
