    125u8, 10u8,
    32u8, 32u8, 32u8, 32u8, 105u8, 114, 114, 101, 100, 117, 99, 105, 98, 108, 101, 95, 99, 102, 103, 61,
    116u8, 114u8, 117u8, 101u8,
    102u8, 97u8, 108u8, 115u8, 101u8,
    10u8,
    32u8, 32u8, 32u8, 32u8, 108u8, 111u8, 111u8, 112u8, 32u8, 76u8,
    32u8, 100u8, 101u8, 112u8, 116u8, 104u8, 61u8,
    32u8, 104u8, 100u8, 114u8, 61u8, 98u8, 98u8,
    32u8, 112u8, 114u8, 101u8, 104u8, 100u8, 114u8, 61u8,
    32u8, 108u8, 97u8, 116u8, 99u8, 104u8, 61u8,
    98u8, 98u8,
    110u8, 111u8, 110u8, 101u8,
