@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// --- Pass Identifier, Extended Profiles, & TransformationContract (`SPEC-73 §8, AXS-INL-034`) ---

pub const PASS_INLINE: u16 = 14u16;
pub const ANALYSIS_CALL_GRAPH: u8 = 9u8;
pub const ANALYSIS_MASK_CALL_GRAPH: u32 = 512u32;

pub const OPT_PROFILE_MAX_O3: u8 = 4u8;
pub const OPT_PROFILE_MINSIZE_OZ: u8 = 5u8;

pub const INLINE_NONE_IDX: u32 = 0xFFFFFFFFu32;
pub const MAX_SCC_ITERATIONS: u32 = 8u32;
pub const MAX_INLINE_HISTORY: usize = 32;

pub fn inline_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_INLINE,
        required_analyses: ANALYSIS_MASK_CALL_GRAPH | ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS |
                           ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO |
                           ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ESCAPE_INFO,
        required_proofs: PROP_MASK_REACHABLE | PROP_MASK_PURE_CALL | PROP_MASK_NO_ESCAPE | PROP_MASK_NO_ALIAS,
        preserved_analyses: ANALYSIS_MASK_CALL_GRAPH,
        invalidated_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                              ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_EFFECT_INFO |
                              ANALYSIS_MASK_ESCAPE_INFO | ANALYSIS_MASK_LOOP_INFO | ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_REACHABLE | PROP_MASK_NO_ALIAS | PROP_MASK_NO_ESCAPE | PROP_MASK_PURE_CALL,
        postconditions: POSTCOND_ALL,
    }
}

