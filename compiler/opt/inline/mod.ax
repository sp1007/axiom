fn cg_push_tbl(out: mut_view<DiagBuffer>, off: usize, byte_len: usize) {
    let mut i: usize = 0;
    while i < byte_len {
        diag_buf_push_byte(mut_view(*out), CG_PRINT_DATA[off + i]);
        i = i + 1;
    }
}

fn inl_push_tbl(out: mut_view<DiagBuffer>, off: usize, byte_len: usize) {
    let mut i: usize = 0;
    while i < byte_len {
        diag_buf_push_byte(mut_view(*out), INL_PRINT_DATA[off + i]);
        i = i + 1;
    }
}

fn cg_push_dispatch_name(out: mut_view<DiagBuffer>, dk: u8) {
    if dk == DISPATCH_DIRECT {
        cg_push_tbl(mut_view(*out), 178, 6);
    } else if dk == DISPATCH_CLOSURE {
        cg_push_tbl(mut_view(*out), 184, 7);
    } else if dk == DISPATCH_FN_PTR {
        cg_push_tbl(mut_view(*out), 191, 6);
    } else if dk == DISPATCH_DYN_TRAIT {
        cg_push_tbl(mut_view(*out), 197, 9);
    } else if dk == DISPATCH_FFI_EXTERN {
        cg_push_tbl(mut_view(*out), 206, 10);
    } else if dk == DISPATCH_ASYNC_SPAWN {
        cg_push_tbl(mut_view(*out), 216, 11);
    } else {
        cg_push_tbl(mut_view(*out), 227, 10);
    }
}

pub fn callgraph_print(cg: view<CallGraph>, out: mut_view<DiagBuffer>) {
    cg_push_tbl(mut_view(*out), 0, 12);
    let mut si: usize = 0;
    while si < cg.scc_count && (cg.sccs as usize) != 0 {
        let sp = unsafe { cg_scc_at(cg.sccs, si) };
        cg_push_tbl(mut_view(*out), 12, 7);
        diag_buf_push_u32(mut_view(*out), unsafe { (*sp).scc_id });
        cg_push_tbl(mut_view(*out), 19, 11);
        diag_buf_push_u32(mut_view(*out), if unsafe { (*sp).is_recursive } { 1u32 } else { 0u32 });
        cg_push_tbl(mut_view(*out), 30, 9);
        diag_buf_push_u32(mut_view(*out), unsafe { (*sp).member_count });
        cg_push_tbl(mut_view(*out), 39, 7);
        diag_buf_push_u32(mut_view(*out), unsafe { (*sp).fixed_point_iters });
        diag_buf_push_byte(mut_view(*out), 10u8);
        si = si + 1;
    }

    let mut ni: usize = 0;
    while ni < cg.node_count && (cg.nodes as usize) != 0 {
        let np = unsafe { cg_node_at(cg.nodes, ni) };
        cg_push_tbl(mut_view(*out), 46, 10);
        diag_buf_push_u32(mut_view(*out), unsafe { (*np).fn_sym.v });
        cg_push_tbl(mut_view(*out), 56, 6);
        diag_buf_push_u32(mut_view(*out), unsafe { (*np).scc_id });
        cg_push_tbl(mut_view(*out), 62, 7);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*np).reachability }) as u32);
        cg_push_tbl(mut_view(*out), 69, 6);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*np).inline_attr }) as u32);
        cg_push_tbl(mut_view(*out), 75, 12);
        diag_buf_push_u32(mut_view(*out), if unsafe { (*np).address_taken_fn } { 1u32 } else { 0u32 });
        cg_push_tbl(mut_view(*out), 87, 9);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*np).effect_summary.flags }) as u32);
        cg_push_tbl(mut_view(*out), 96, 12);
        diag_buf_push_u32(mut_view(*out), if unsafe { (*np).returns_result_or_option } { 1u32 } else { 0u32 });
        diag_buf_push_byte(mut_view(*out), 10u8);
        ni = ni + 1;
    }

    let mut ei: usize = 0;
    while ei < cg.edge_count && (cg.edges as usize) != 0 {
        let ep = unsafe { cg_edge_at(cg.edges, ei) };
        cg_push_tbl(mut_view(*out), 108, 8);
        diag_buf_push_u32(mut_view(*out), unsafe { (*ep).edge_id });
        cg_push_tbl(mut_view(*out), 116, 11);
        diag_buf_push_u32(mut_view(*out), unsafe { (*ep).caller_sym.v });
        cg_push_tbl(mut_view(*out), 138, 5);
        diag_buf_push_u32(mut_view(*out), unsafe { (*ep).callsite_bb.v });
        cg_push_tbl(mut_view(*out), 143, 10);
        cg_push_dispatch_name(mut_view(*out), unsafe { (*ep).dispatch_kind });
        cg_push_tbl(mut_view(*out), 127, 11);
        diag_buf_push_u32(mut_view(*out), unsafe { (*ep).known_callee.v });
        cg_push_tbl(mut_view(*out), 153, 10);
        diag_buf_push_u32(mut_view(*out), if unsafe { (*ep).targets_complete } { 1u32 } else { 0u32 });
        cg_push_tbl(mut_view(*out), 163, 9);
        diag_buf_push_u32(mut_view(*out), if unsafe { (*ep).is_inlined } { 1u32 } else { 0u32 });
        cg_push_tbl(mut_view(*out), 172, 6);
        diag_buf_push_u32(mut_view(*out), if unsafe { (*ep).is_tail_position } { 1u32 } else { 0u32 });
        diag_buf_push_byte(mut_view(*out), 10u8);
        ei = ei + 1;
    }
    cg_push_tbl(mut_view(*out), 237, 2);
}

pub fn inline_print(
    stats: view<InlineStats>,
    log: view<InlineDecisionLog>,
    sroa_stats: *const SroaStats,
    sroa_log: *const SroaDecisionLog,
    out: mut_view<DiagBuffer>
) {
    inl_push_tbl(mut_view(*out), 0, 19);
    let mut i: usize = 0;
    while i < log.count && (log.records as usize) != 0 {
        let rp = unsafe { inl_record_at(log.records, i) };
        inl_push_tbl(mut_view(*out), 19, 10);
        cg_push_tbl(mut_view(*out), 116, 11);
        diag_buf_push_u32(mut_view(*out), unsafe { (*rp).caller_sym });
        cg_push_tbl(mut_view(*out), 127, 11);
        diag_buf_push_u32(mut_view(*out), unsafe { (*rp).callee_sym });
        cg_push_tbl(mut_view(*out), 138, 5);
        diag_buf_push_u32(mut_view(*out), unsafe { (*rp).callsite_bb });
        cg_push_tbl(mut_view(*out), 69, 6);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*rp).attr }) as u32);
        inl_push_tbl(mut_view(*out), 29, 10);
        if (unsafe { (*rp).legality }) == INLINE_LEGAL {
            inl_push_tbl(mut_view(*out), 39, 5);
        } else {
            inl_push_tbl(mut_view(*out), 44, 7);
        }
        inl_push_tbl(mut_view(*out), 51, 8);
        diag_buf_push_u32(mut_view(*out), (unsafe { (*rp).block_reason }) as u32);
        inl_push_tbl(mut_view(*out), 59, 12);
        diag_buf_push_u32(mut_view(*out), if unsafe { (*rp).profitable } { 1u32 } else { 0u32 });
        inl_push_tbl(mut_view(*out), 71, 10);
        if (unsafe { (*rp).decision }) == INLINE_DECISION_INLINED {
            inl_push_tbl(mut_view(*out), 81, 7);
        } else {
            inl_push_tbl(mut_view(*out), 88, 8);
        }
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1;
    }
    inl_push_tbl(mut_view(*out), 96, 18);
    diag_buf_push_u32(mut_view(*out), stats.callsites_inlined);
    inl_push_tbl(mut_view(*out), 114, 10);
    diag_buf_push_u32(mut_view(*out), stats.callsites_rejected_illegal + stats.callsites_rejected_cost);
    inl_push_tbl(mut_view(*out), 124, 15);
    diag_buf_push_u32(mut_view(*out), stats.post_inline_sroa_cascades);
    inl_push_tbl(mut_view(*out), 139, 11);
    diag_buf_push_u32(mut_view(*out), stats.pass_rollbacks);
    diag_buf_push_byte(mut_view(*out), 10u8);
    inl_push_tbl(mut_view(*out), 150, 2);

    if (sroa_stats as usize) != 0 && (sroa_log as usize) != 0 {
        sroa_print(unsafe { view(*sroa_stats) }, unsafe { view(*sroa_log) }, mut_view(*out));
    }
}
