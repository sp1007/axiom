// --- Core Descriptors & Records (SPEC-74 §4..§10) ---

@derive(Copy)
pub struct TargetSimdCaps {
    pub isa_level: u8,
    pub max_int_vec_bits: u16,
    pub max_fp_vec_bits: u16,
    pub arch_vec_regs: u8,
    pub reg_pressure_budget: u8,
    pub has_fma: bool,
    pub has_masked_mem: bool,
    pub has_blendv: bool,
    pub fp_mode: u8,
}

@derive(Copy)
pub struct VecMemDepResult {
    pub dep_kind: u8,
    pub is_constant_dist: bool,
    pub distance: i64,
    pub certainty: u8,
    pub alias_proof: u8,
    pub is_legal_for_vf: bool,
    pub reject_reason: u8,
}

@derive(Copy)
pub struct LoopVecReduction {
    pub is_valid: bool,
    pub acc_local: MirLocalId,
    pub header_phi_val: OptValueId,
    pub init_val: OptValueId,
    pub step_val: OptValueId,
    pub step_bb: OptBbId,
    pub step_inst_idx: u32,
    pub bin_op: u8,
    pub vreduce_op: u8,
    pub elem_kind: u8,
    pub arith_class: u8,
    pub certainty: u8,
    pub reject_reason: u8,
}

@derive(Copy)
pub struct VectorLegalityResult {
    pub is_legal: bool,
    pub reject_reason: u8,
    pub certainty: u8,
    pub elem_kind: u8,
    pub elem_bits: u16,
    pub candidate_vf: u8,
    pub max_safe_vf: u8,
    pub alias_proof: u8,
    pub has_reduction: bool,
    pub reduction_op: u8,
    pub reduction_arith: u8,
    pub vload_count: u8,
    pub vstore_count: u8,
    pub vsplat_count: u8,
    pub vstep_count: u8,
    pub vbinop_count: u8,
    pub vcmp_count: u8,
    pub vselect_count: u8,
    pub est_live_vec_regs: u8,
}

@derive(Copy)
pub struct VectorCostEstimate {
    pub loop_id: LoopId,
    pub vf: u8,
    pub uf: u8,
    pub elem_kind: u8,
    pub scalar_iter_cost: u32,
    pub vector_iter_cost: u32,
    pub setup_cost: u32,
    pub reduction_cost: u32,
    pub epilogue_cost: u32,
    pub spill_penalty: u32,
    pub total_scalar_cost: u32,
    pub total_vec_cost: u32,
    pub est_vec_regs: u8,
    pub confidence: u8,
    pub profitable: bool,
    pub reject_reason: u8,
}

@derive(Copy)
pub struct LoopVecRecord {
    pub pass_id: u16,
    pub loop_id: LoopId,
    pub header_bb: OptBbId,
    pub vector_loop_bb: OptBbId,
    pub epilogue_loop_bb: OptBbId,
    pub applied: bool,
    pub vf: u8,
    pub uf: u8,
    pub elem_kind: u8,
    pub isa_level: u8,
    pub alias_proof: u8,
    pub reduction_op: u8,
    pub epilogue_kind: u8,
    pub reason: u8,
    pub certainty: u8,
    pub vload_count: u8,
    pub vstore_count: u8,
    pub vsplat_count: u8,
    pub vstep_count: u8,
    pub vbinop_count: u8,
    pub vselect_count: u8,
    pub vreduce_count: u8,
    pub scalar_cost: u32,
    pub vec_cost: u32,
    pub confidence: u8,
}

@derive(Copy)
pub struct LoopVecStats {
    pub pass_runs: u32,
    pub pass_changes: u32,
    pub pass_rollbacks: u32,
    pub loops_analyzed: u32,
    pub loops_vectorized: u32,
    pub loops_rejected: u32,
    pub cap_disjoint_proven: u32,
    pub scev_disjoint_proven: u32,
    pub runtime_alias_guards: u32,
    pub reductions_vectorized: u32,
    pub broadcasts_widened: u32,
    pub step_vectors_widened: u32,
    pub selects_if_converted: u32,
    pub epilogues_emitted: u32,
    pub epilogues_omitted_exact: u32,
    pub rejected_non_counted: u32,
    pub rejected_atomic: u32,
    pub rejected_volatile: u32,
    pub rejected_unknown_alias: u32,
    pub rejected_loop_carried_dep: u32,
    pub rejected_strict_fp: u32,
    pub rejected_checked_overflow: u32,
    pub rejected_unproven_bounds: u32,
    pub rejected_cost: u32,
    pub rejected_size_profile: u32,
    pub records: *mut LoopVecRecord,
    pub record_count: usize,
    pub record_cap: usize,
}

// --- Contract, Target Capability Constructors & Element Type Queries (SPEC-74 §3, §7, §9) ---

pub fn loop_vec_contract() -> TransformationContract {
    TransformationContract {
        pass_id: PASS_LOOP_VEC,
        required_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                           ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_LOOP_INFO |
                           ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_ALIAS_INFO |
                           ANALYSIS_MASK_EFFECT_INFO,
        required_proofs: PROP_MASK_IN_BOUNDS | PROP_MASK_NO_ALIAS | PROP_MASK_NO_OVERFLOW,
        preserved_analyses: ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA |
                            ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_LOOP_INFO,
        invalidated_analyses: ANALYSIS_MASK_RANGE_INFO,
        preserved_properties: PROP_MASK_IN_BOUNDS | PROP_MASK_NO_ALIAS | PROP_MASK_NO_OVERFLOW,
        postconditions: POSTCOND_ALL,
    }
}

pub fn vec_default_target_caps() -> TargetSimdCaps {
    TargetSimdCaps {
        isa_level: TARGET_ISA_SSE2,
        max_int_vec_bits: 128u16,
        max_fp_vec_bits: 128u16,
        arch_vec_regs: 16u8,
        reg_pressure_budget: 14u8,
        has_fma: false,
        has_masked_mem: false,
        has_blendv: false,
        fp_mode: FP_MODE_STRICT,
    }
}

pub fn vec_avx_target_caps() -> TargetSimdCaps {
    TargetSimdCaps {
        isa_level: TARGET_ISA_AVX,
        max_int_vec_bits: 128u16,
        max_fp_vec_bits: 256u16,
        arch_vec_regs: 16u8,
        reg_pressure_budget: 14u8,
        has_fma: false,
        has_masked_mem: true,
        has_blendv: true,
        fp_mode: FP_MODE_STRICT,
    }
}

pub fn vec_avx2_target_caps() -> TargetSimdCaps {
    TargetSimdCaps {
        isa_level: TARGET_ISA_AVX2,
        max_int_vec_bits: 256u16,
        max_fp_vec_bits: 256u16,
        arch_vec_regs: 16u8,
        reg_pressure_budget: 14u8,
        has_fma: true,
        has_masked_mem: true,
        has_blendv: true,
        fp_mode: FP_MODE_STRICT,
    }
}

pub fn vec_neon_target_caps() -> TargetSimdCaps {
    TargetSimdCaps {
        isa_level: TARGET_ISA_NEON,
        max_int_vec_bits: 128u16,
        max_fp_vec_bits: 128u16,
        arch_vec_regs: 32u8,
        reg_pressure_budget: 24u8,
        has_fma: true,
        has_masked_mem: false,
        has_blendv: true,
        fp_mode: FP_MODE_STRICT,
