@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// =============================================================================
// 1. Canonical Source Coordinates, 7-Tuple `PackageIdentity7` & Diagnostics
//    (`AXS-PKG-001`..`003`, `AXS-PKG-020`, `AXS-PKG-050`)
// =============================================================================

pub const PKG_SOURCE_REGISTRY: u8 = 0u8
pub const PKG_SOURCE_VCS_COMMIT: u8 = 1u8
pub const PKG_SOURCE_PATH: u8 = 2u8
pub const PKG_SOURCE_WORKSPACE: u8 = 3u8
pub const PKG_SOURCE_ARCHIVE: u8 = 4u8
pub const PKG_SOURCE_VENDOR: u8 = 5u8

pub fn pkg_source_kind_prefix(kind: u8) -> StrView {
    if kind == PKG_SOURCE_REGISTRY {
        return ux2_sv("registry:")
    }
    if kind == PKG_SOURCE_VCS_COMMIT {
        return ux2_sv("git:")
    }
    if kind == PKG_SOURCE_PATH {
        return ux2_sv("path:")
    }
    if kind == PKG_SOURCE_WORKSPACE {
        return ux2_sv("workspace:")
    }
    if kind == PKG_SOURCE_ARCHIVE {
        return ux2_sv("archive:")
    }
    if kind == PKG_SOURCE_VENDOR {
        return ux2_sv("vendor:")
    }
    ux2_sv("unknown:")
}

fn make_data_str(key: StrView, val: StrView) -> DiagDataEntry {
    DiagDataEntry {
        key: key,
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: val,
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0usize,
        },
    }
}

fn make_data_str_list(
    key: StrView,
    joined_str: StrView,
    items_ptr: *mut StrView,
    count: usize
) -> DiagDataEntry {
    DiagDataEntry {
        key: key,
        value: DiagDataValue {
            kind: DiagDataKind.StringList,
            str_val: joined_str,
            int_val: 0i64,
            bool_val: false,
            list_items: items_ptr,
            list_count: count,
        },
    }
}

pub fn report_version_conflict_diag(
    sink: mut_view<DiagSink>,
    pkg_full_name: StrView,
    joined_chain: StrView,
    steps: mut_view<[8]StrView>,
    step_count: usize
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        ux2_sv("unsatisfiable SemVer 2.0 dependency constraints (`AXS-PKG-011`, `AXS-PKG-012`)")
    )
    let mut entries: [3]DiagDataEntry = [
        make_data_str(ux2_sv("kind"), ux2_sv("version_conflict")),
        make_data_str(ux2_sv("package"), pkg_full_name),
        make_data_str_list(
            ux2_sv("derivation_chain"),
            joined_chain,
            unsafe { address_of_mut((*steps)[0]) },
            step_count
        ),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_type_version_mismatch_diag(
    sink: mut_view<DiagSink>,
    expected_str: StrView,
    found_str: StrView,
    note_str: StrView
) {
    let mut d = diag_new(
        diag_code(AX_TYPE_MISMATCH),
        span_none(),
        ux2_sv("nominal type mismatch across distinct side-by-side package versions (`AXS-PKG-021`)")
    )
    let mut entries: [3]DiagDataEntry = [
        make_data_str(ux2_sv("expected"), expected_str),
        make_data_str(ux2_sv("found"), found_str),
        make_data_str(ux2_sv("reason"), ux2_sv("distinct_package_versions")),
    ]
    let mut notes: [1]StrView = [note_str]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    d.notes = unsafe { address_of_mut(notes[0]) }
    d.note_count = 1usize
    diag_sink_report(mut_view(*sink), view(d))
}

// Checks if `s` contains `..`, `\`, NUL, or leading `/` (`AXS-PKG-002 §1`, `AXS-PKG-032 §3`).
pub fn has_path_traversal_or_invalid_sep(s: StrView) -> bool {
    if s.len == 0usize {
        return false
    }
    if bld_sv_byte(s, 0usize) == 47u8 || bld_sv_byte(s, 0usize) == 92u8 {
        return true
    }
    if s.len >= 2usize && bld_sv_byte(s, 1usize) == 58u8 {
        return true
    }
    let mut i: usize = 0usize
    while i < s.len {
        let b = bld_sv_byte(s, i)
        if b == 0u8 || b == 92u8 {
            return true
        }
        if b == 46u8 && (i + 1usize) < s.len && bld_sv_byte(s, i + 1usize) == 46u8 {
            return true
        }
        i = i + 1usize
    }
    false
}

// Validates a package `namespace` or `name` against `^[a-z][a-z0-9_-]{0,63}$` (`AXS-PKG-002 §1`).
pub fn validate_pkg_namespace_or_name(ident: StrView, allow_default_kw: bool) -> bool {
    if has_path_traversal_or_invalid_sep(ident) {
        return false
    }
    if allow_default_kw && ux2_sv_eq(ident, ux2_sv("default")) {
        return true
    }
    validate_package_name(ident, true)
}

// Splits `"<namespace>/<name>"` or `"<name>"` (defaulting `namespace` to `"default"`).
pub fn split_namespaced_pkg_spec(
    raw_spec: StrView,
    out_namespace: mut_view<StrView>,
    out_name: mut_view<StrView>,
    sink: mut_view<DiagSink>
) -> bool {
    let t = bld_sv_trim(raw_spec)
    if has_path_traversal_or_invalid_sep(t) {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_DRIVER_BAD_MANIFEST,
            "package identifier contains forbidden path traversal or separator (`AXS-PKG-002`)",
            "kind",
            ux2_sv("path_traversal"),
            "entry",
            raw_spec
        )
        return false
    }
    let mut slash_pos: usize = t.len
    let mut slash_count: usize = 0usize
    let mut i: usize = 0usize
    while i < t.len {
        if bld_sv_byte(t, i) == 47u8 {
            if slash_count == 0usize {
                slash_pos = i
            }
            slash_count = slash_count + 1usize
        }
        i = i + 1usize
    }
    if slash_count > 1usize {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_DRIVER_BAD_MANIFEST,
            "package coordinate may contain at most one `<namespace>/<name>` slash (`AXS-PKG-002`)",
            "kind",
            ux2_sv("path_traversal"),
            "entry",
            raw_spec
        )
        return false
    }
    if slash_count == 1usize {
        let ns = bld_sv_slice(t, 0usize, slash_pos)
        let nm = bld_sv_slice(t, slash_pos + 1usize, t.len)
        if !validate_pkg_namespace_or_name(ns, true) || !validate_pkg_namespace_or_name(nm, false) {
            report_manifest_diag_2(
                mut_view(*sink),
                AX_DRIVER_BAD_MANIFEST,
                "invalid package namespace or name (`AXS-PKG-002 §1`)",
                "kind",
                ux2_sv("schema"),
                "package",
                raw_spec
            )
            return false
        }
        *out_namespace = ns
        *out_name = nm
        return true
    }
    if !validate_pkg_namespace_or_name(t, false) {
        report_manifest_diag_2(
            mut_view(*sink),
            AX_DRIVER_BAD_MANIFEST,
            "invalid package name (`AXS-PKG-002 §1`)",
            "kind",
            ux2_sv("schema"),
            "package",
            raw_spec
        )
        return false
    }
    *out_namespace = ux2_sv("default")
    *out_name = t
    true
}

// Strips `user:token@` credentials from a URL so authentication tokens never enter
// `PackageIdentity`, `content_hash`, or `axiom.lock` (`AXS-PKG-002 §2`, `PKG-INV-03`).
pub fn strip_url_credentials(raw_url: StrView) -> StrView {
    let t = bld_sv_trim(raw_url)
    let mut scheme_end: usize = 0usize
    let mut i: usize = 0usize
    while (i + 2usize) < t.len {
        if bld_sv_byte(t, i) == 58u8 && bld_sv_byte(t, i + 1usize) == 47u8 && bld_sv_byte(t, i + 2usize) == 47u8 {
            scheme_end = i + 3usize
            break
        }
        i = i + 1usize
    }
    if scheme_end == 0usize {
        return t
    }
    let mut at_pos: usize = t.len
    let mut slash_pos: usize = t.len
    i = scheme_end
    while i < t.len {
        let b = bld_sv_byte(t, i)
        if b == 47u8 {
            slash_pos = i
            break
        }
        if b == 64u8 && at_pos == t.len {
            at_pos = i
        }
        i = i + 1usize
    }
    if at_pos < slash_pos {
        return bld_sv_slice(t, at_pos + 1usize, t.len)
    }
    t
}

// Checks that `oid` is an immutable 40-hex (SHA-1) or 64-hex (SHA-256) VCS commit revision (`AXS-PKG-003 §2`).
pub fn is_immutable_commit_oid(oid: StrView) -> bool {
    if oid.len != 40usize && oid.len != 64usize {
        return false
    }
    let mut i: usize = 0usize
    while i < oid.len {
        let b = bld_sv_byte(oid, i)
        let is_num = b >= 48u8 && b <= 57u8
        let is_hex_lo = b >= 97u8 && b <= 102u8
        let is_hex_hi = b >= 65u8 && b <= 70u8
        if !is_num && !is_hex_lo && !is_hex_hi {
            return false
        }
        i = i + 1usize
    }
    true
}

// Canonical 7-tuple `PackageIdentity` (`AXS-PKG-002`):
// `(Registry, Namespace, Name, Version, SourceId, ContentHash, SemanticInterfaceFingerprint)`
// plus resolved `CompatTrack`, `BuildEnvClass`, and distinct `CompilerDB` `PackageId`.
@derive(Copy)
pub struct PackageIdentity7 {
    pub registry: StrView,
    pub namespace: StrView,
    pub name: StrView,
    pub version: SemVer2,
    pub source_kind: u8,
    pub source_id: StrView,
    pub content_hash: Digest256,
    pub semantic_interface_fingerprint: Digest256,
    pub compat_track: CompatTrack,
    pub env_class: u8,
    pub target_triple: StrView,
    pub package_id: u32,
    pub identity_digest: Digest256,
}

pub fn package_identity7_empty() -> PackageIdentity7 {
    let e = ux2_sv_empty()
    let z = digest256_zero()
    let v0 = semver2_zero()
    PackageIdentity7 {
        registry: ux2_sv("default"),
        namespace: ux2_sv("default"),
        name: e,
        version: v0,
        source_kind: PKG_SOURCE_REGISTRY,
        source_id: e,
        content_hash: z,
        semantic_interface_fingerprint: z,
        compat_track: semver2_compat_track(view(v0)),
        env_class: ENV_CLASS_TARGET,
        target_triple: e,
        package_id: 0u32,
        identity_digest: z,
    }
}

pub fn compute_pkg_content_hash(
    namespace: StrView,
    name: StrView,
    version: view<SemVer2>,
    source_kind: u8,
    canonical_source_coord: StrView,
    content_seed: u64
) -> Digest256 {
    let mut d = digest256_domain_init(ux2_sv("AXIOM_PKG_CONTENT_SHA256_V1"))
    d = digest256_mix_sv(d, namespace)
    d = digest256_mix_sv(d, name)
    d = digest256_mix_u64(d, version.major)
    d = digest256_mix_u64(d, version.minor)
    d = digest256_mix_u64(d, version.patch)
    d = digest256_mix_sv(d, version.prerelease)
    d = digest256_mix_u64(d, source_kind as u64)
    d = digest256_mix_sv(d, canonical_source_coord)
    d = digest256_mix_u64(d, content_seed)
    d
}

pub fn compute_package_identity_7(
    registry: StrView,
    namespace: StrView,
    name: StrView,
    version: SemVer2,
    source_kind: u8,
    host_workspace_root: StrView,
    raw_source_coord: StrView,
    vcs_rev: StrView,
    content_seed: u64,
    public_api_seed: u64,
    active_features: view<[16]StrView>,
    active_feature_count: usize,
    env_class: u8,
    target_triple: StrView,
    profile: view<ProfileConfig>,
    package_id: u32
) -> PackageIdentity7 {
    let norm_reg = if registry.len == 0usize { ux2_sv("default") } else { registry }
    let norm_ns = if namespace.len == 0usize { ux2_sv("default") } else { namespace }
    let clean_coord = if source_kind == PKG_SOURCE_WORKSPACE || source_kind == PKG_SOURCE_PATH {
        canonicalize_logical_source_path(host_workspace_root, raw_source_coord)
    } else {
        strip_url_credentials(raw_source_coord)
    }

    let c_hash = compute_pkg_content_hash(
        norm_ns,
        name,
        view(version),
        source_kind,
        clean_coord,
        content_seed
    )
    let feat_hash = compute_feature_set_hash(active_features, active_feature_count)
    let abi_salt = compute_abi_salt(target_triple, profile)

    // Base Semantic Interface Fingerprint (`SIF`, `AXS-PKG-002 §4`):
    // Invariant to private function body edits (`private_body_seed` is never mixed here).
    let mut sif = digest256_domain_init(ux2_sv("AXIOM_PKG_SIF_BLAKE3_V1"))
    sif = digest256_mix_sv(sif, norm_reg)
    sif = digest256_mix_sv(sif, norm_ns)
    sif = digest256_mix_sv(sif, name)
    sif = digest256_mix_u64(sif, version.major)
    sif = digest256_mix_u64(sif, version.minor)
    sif = digest256_mix_u64(sif, version.patch)
    sif = digest256_mix_sv(sif, version.prerelease)
    sif = digest256_mix_u64(sif, public_api_seed)
    sif = digest256_combine(sif, feat_hash)
    sif = digest256_mix_u64(sif, env_class as u64)
    sif = digest256_combine(sif, abi_salt)

    let mut id_digest = digest256_domain_init(ux2_sv("AXIOM_PKG_IDENTITY_7TUPLE_V1"))
    id_digest = digest256_mix_sv(id_digest, norm_reg)
    id_digest = digest256_mix_sv(id_digest, norm_ns)
    id_digest = digest256_mix_sv(id_digest, name)
    id_digest = digest256_mix_u64(id_digest, version.major)
    id_digest = digest256_mix_u64(id_digest, version.minor)
    id_digest = digest256_mix_u64(id_digest, version.patch)
    id_digest = digest256_mix_sv(id_digest, version.prerelease)
    id_digest = digest256_mix_u64(id_digest, source_kind as u64)
    id_digest = digest256_mix_sv(id_digest, clean_coord)
    id_digest = digest256_mix_sv(id_digest, vcs_rev)
    id_digest = digest256_combine(id_digest, c_hash)
    id_digest = digest256_combine(id_digest, feat_hash)
    id_digest = digest256_mix_u64(id_digest, env_class as u64)
    id_digest = digest256_mix_sv(id_digest, target_triple)

    PackageIdentity7 {
        registry: norm_reg,
        namespace: norm_ns,
        name: name,
        version: version,
        source_kind: source_kind,
        source_id: clean_coord,
        content_hash: c_hash,
        semantic_interface_fingerprint: sif,
        compat_track: semver2_compat_track(view(version)),
        env_class: env_class,
        target_triple: target_triple,
        package_id: package_id,
        identity_digest: id_digest,
    }
}

fn push_u32_hex8(buf: mut_view<DiagBuffer>, v: u32) {
    let mut shift: u32 = 28u32
    let mut i: usize = 0usize
    while i < 8usize {
        let nib = ((v >> shift) & 0xFu32) as u8
        let ch = if nib < 10u8 { 48u8 + nib } else { 87u8 + nib }
        diag_buf_push_byte(mut_view(*buf), ch)
        if shift >= 4u32 {
            shift = shift - 4u32
        }
        i = i + 1usize
    }
}

// Formats the collision-free symbol mangling prefix for side-by-side versions (`AXS-PKG-020 §2`):
// `_AXP_<pkg_name>_v<major>_<minor>_<patch>_<id_hash8>_`
pub fn format_pkg_versioned_symbol_prefix(id: view<PackageIdentity7>, buf: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*buf), ux2_sv("_AXP_"))
    diag_buf_push_sv(mut_view(*buf), id.name)
    diag_buf_push_sv(mut_view(*buf), ux2_sv("_v"))
    diag_buf_push_u32(mut_view(*buf), id.version.major as u32)
    diag_buf_push_byte(mut_view(*buf), 95u8)
    diag_buf_push_u32(mut_view(*buf), id.version.minor as u32)
    diag_buf_push_byte(mut_view(*buf), 95u8)
    diag_buf_push_u32(mut_view(*buf), id.version.patch as u32)
    diag_buf_push_byte(mut_view(*buf), 95u8)
    let hash8 = ((id.identity_digest.w0 >> 32u64) ^ (id.identity_digest.w0 & 0xFFFFFFFFu64)) as u32
    push_u32_hex8(mut_view(*buf), hash8)
    diag_buf_push_byte(mut_view(*buf), 95u8)
}

pub fn mangle_pkg_item_symbol(
    id: view<PackageIdentity7>,
    module_path: StrView,
    item_name: StrView,
    buf: mut_view<DiagBuffer>
) {
    format_pkg_versioned_symbol_prefix(id, mut_view(*buf))
    if module_path.len > 0usize {
        let mut i: usize = 0usize
        while i < module_path.len {
            let b = bld_sv_byte(module_path, i)
            if b == 46u8 || b == 47u8 {
                diag_buf_push_byte(mut_view(*buf), 95u8)
            } else {
                diag_buf_push_byte(mut_view(*buf), b)
            }
            i = i + 1usize
        }
        diag_buf_push_byte(mut_view(*buf), 95u8)
    }
    diag_buf_push_sv(mut_view(*buf), item_name)
}

// =============================================================================
// 2. Resolver Input Model: Candidates, Dependencies, Lockfile Pins & Policy
//    (`AXS-PKG-010`..`013`, `AXS-PKG-022`..`024`)
// =============================================================================

@derive(Copy)
pub struct PkgDepSpec {
    pub dep_alias: StrView,
    pub target_namespace: StrView,
    pub target_name: StrView,
    pub registry: StrView,
    pub version_req: StrView,
    pub scope: u8,
    pub source_kind: u8,
    pub source_coord: StrView,
    pub vcs_rev: StrView,
    pub archive_sha256: StrView,
    pub optional: bool,
    pub default_features: bool,
    pub is_public: bool,
    pub features: [4]StrView,
    pub feature_count: usize,
    pub has_target_cfg: bool,
    pub target_cfg: StrView,
}

pub fn pkg_dep_spec_empty() -> PkgDepSpec {
    let e = ux2_sv_empty()
    PkgDepSpec {
        dep_alias: e,
        target_namespace: ux2_sv("default"),
        target_name: e,
        registry: ux2_sv("default"),
        version_req: e,
        scope: DEP_SCOPE_NORMAL,
        source_kind: PKG_SOURCE_REGISTRY,
        source_coord: ux2_sv("default"),
        vcs_rev: e,
        archive_sha256: e,
        optional: false,
        default_features: true,
        is_public: false,
        features: [e; 4],
        feature_count: 0usize,
        has_target_cfg: false,
        target_cfg: e,
    }
}

pub fn pkg_dep_spec_new(
    dep_alias: StrView,
    target_namespace: StrView,
    target_name: StrView,
    version_req: StrView,
    scope: u8
) -> PkgDepSpec {
    let mut d = pkg_dep_spec_empty()
    d.dep_alias = dep_alias
    d.target_namespace = if target_namespace.len == 0usize { ux2_sv("default") } else { target_namespace }
    d.target_name = target_name
    d.version_req = version_req
    d.scope = scope
    d
}

@derive(Copy)
pub struct PkgCandidateManifest {
    pub registry: StrView,
    pub namespace: StrView,
    pub name: StrView,
    pub version: SemVer2,
    pub source_kind: u8,
    pub source_coord: StrView,
    pub vcs_rev: StrView,
    pub content_sha256_seed: u64,
    pub public_api_seed: u64,
    pub private_body_seed: u64,
    pub native_links: StrView,
    pub yanked: bool,
    pub is_workspace_root: bool,
    pub features: [12]FeatureDecl,
    pub feature_count: usize,
    pub deps: [12]PkgDepSpec,
    pub dep_count: usize,
}

pub fn pkg_candidate_empty() -> PkgCandidateManifest {
    let e = ux2_sv_empty()
    let fd = feature_decl_empty()
    let dd = pkg_dep_spec_empty()
    PkgCandidateManifest {
        registry: ux2_sv("default"),
        namespace: ux2_sv("default"),
        name: e,
        version: semver2_zero(),
        source_kind: PKG_SOURCE_REGISTRY,
        source_coord: ux2_sv("default"),
        vcs_rev: e,
        content_sha256_seed: 0x1020304050607080u64,
        public_api_seed: 0x1122334455667788u64,
        private_body_seed: 0x99AABBCCDDEEFF00u64,
        native_links: e,
        yanked: false,
        is_workspace_root: false,
        features: [fd; 12],
        feature_count: 0usize,
        deps: [dd; 12],
        dep_count: 0usize,
    }
}

pub fn pkg_candidate_new(
    namespace: StrView,
    name: StrView,
    version: SemVer2,
    source_kind: u8,
    source_coord: StrView,
    is_workspace_root: bool
) -> PkgCandidateManifest {
    let mut c = pkg_candidate_empty()
    c.namespace = if namespace.len == 0usize { ux2_sv("default") } else { namespace }
    c.name = name
    c.version = version
    c.source_kind = source_kind
    c.source_coord = source_coord
    c.is_workspace_root = is_workspace_root
    c
}

pub fn pkg_candidate_add_feature(
    cand: mut_view<PkgCandidateManifest>,
    feat_name: StrView,
    implies_0: StrView,
    implies_1: StrView,
    conflict_0: StrView
) {
    if cand.feature_count >= 12usize {
        return
    }
    let mut fd = feature_decl_empty()
    fd.name = feat_name
    if implies_0.len > 0usize {
        fd.implies[fd.implies_count] = implies_0
        fd.implies_count = fd.implies_count + 1usize
    }
    if implies_1.len > 0usize {
        fd.implies[fd.implies_count] = implies_1
        fd.implies_count = fd.implies_count + 1usize
    }
    if conflict_0.len > 0usize {
        fd.conflicts_with[0] = conflict_0
        fd.conflicts_count = 1usize
    }
    let p = unsafe { address_of_mut(*cand) }
    let fc = unsafe { (*p).feature_count }
    unsafe {
        (*p).features[fc] = fd
        (*p).feature_count = fc + 1usize
    }
}

pub fn pkg_candidate_add_dep(cand: mut_view<PkgCandidateManifest>, dep: PkgDepSpec) {
    if cand.dep_count >= 12usize {
        return
    }
    let p = unsafe { address_of_mut(*cand) }
    let dc = unsafe { (*p).dep_count }
    unsafe {
        (*p).deps[dc] = dep
        (*p).dep_count = dc + 1usize
    }
    if dep.optional {
        // Ensure implicit feature `<dep_alias>` exists (`AXS-PKG-023 §3`)
        let mut found: bool = false
        let mut i: usize = 0usize
        while i < cand.feature_count {
            if ux2_sv_eq(cand.features[i].name, dep.dep_alias) {
                found = true
                break
            }
            i = i + 1usize
        }
        if !found && (cand.feature_count) < 12usize {
            let mut imp = feature_decl_empty()
            imp.name = dep.dep_alias
            imp.is_implicit_optional_dep = true
            let fc2 = unsafe { (*p).feature_count }
            unsafe {
                (*p).features[fc2] = imp
                (*p).feature_count = fc2 + 1usize
            }
        }
    }
}

