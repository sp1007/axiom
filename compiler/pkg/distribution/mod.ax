    BinarySliceDescriptor {
        target_triple: e,
        cpu_variant: e,
        cpu_feature_mask: 0u64,
        lib_rel_path: e,
        abi_fingerprint: AbiFingerprint { lo: 0u64, hi: 0u64 },
