// =============================================================================
// 4. Precompiled Binary Slice Verification & Selection (`AXS-REG-021`..`023`)
// =============================================================================

pub fn popcount_u64(mut v: u64) -> u32 {
    let mut count: u32 = 0u32
    while v > 0u64 {
        count = count + ((v & 1u64) as u32)
        v = v >> 1u32
    }
    count
}

pub fn verify_slice_compatibility(
    slice: view<BinarySliceDescriptor>,
    active_target_triple: StrView,
    active_cpu_features: u64,
    active_abi: view<AbiFingerprint>,
    out_detail: mut_view<BinaryRejectionDetail>
) -> bool {
    // 1. Target triple must match exactly
    if !dist_sv_eq(slice.target_triple, active_target_triple) {
        out_detail.reason = REJECT_TARGET_MISMATCH
        out_detail.expected_val = active_target_triple
        out_detail.found_val = slice.target_triple
        return false
    }

    // 2. CPU feature mask requirement: slice.cpu_feature_mask must be subset of active_cpu_features
    if (slice.cpu_feature_mask & ~active_cpu_features) != 0u64 {
        out_detail.reason = REJECT_TARGET_MISMATCH
        out_detail.expected_val = dist_sv("cpu_feature_mask_subset")
        out_detail.found_val = slice.cpu_variant
        return false
    }

    // 3. AbiFingerprint must match exactly
    if !abi_fingerprint_eq(slice.abi_fingerprint, *active_abi) {
        out_detail.reason = REJECT_ABI_MISMATCH
        out_detail.expected_val = dist_sv("abi_fingerprint_match")
        out_detail.found_val = dist_sv("abi_fingerprint_mismatch")
        return false
    }

    true
}

pub fn select_best_binary_slice(
    catalog: view<BinaryPackageCatalog>,
    active_target_triple: StrView,
    active_cpu_features: u64,
    active_abi: view<AbiFingerprint>,
    out_slice_idx: mut_view<usize>,
    out_detail: mut_view<BinaryRejectionDetail>
) -> bool {
    let mut best_idx: usize = 0usize
    let mut best_popcount: u32 = 0u32
    let mut found_any = false

    let mut i: usize = 0usize
    while i < catalog.slice_count && i < 4usize {
        let sl = catalog.slices[i]
        let mut detail = binary_rejection_detail_empty()
        if verify_slice_compatibility(view(sl), active_target_triple, active_cpu_features, active_abi, mut_view(detail)) {
            let pc = popcount_u64(sl.cpu_feature_mask)
            if !found_any || pc > best_popcount {
                best_idx = i
                best_popcount = pc
                found_any = true
            }
        }
        i = i + 1usize
    }

    if found_any {
        *out_slice_idx = best_idx
        return true
    }

    // Set rejection reason from first slice or fallback to no slices
    if catalog.slice_count > 0usize {
        let sl0 = catalog.slices[0]
        let _ = verify_slice_compatibility(view(sl0), active_target_triple, active_cpu_features, active_abi, out_detail)
    } else {
        out_detail.reason = REJECT_NO_MATCHING_SLICE
        out_detail.expected_val = active_target_triple
        out_detail.found_val = dist_sv("no_slices_available")
    }
    false
}

pub fn decide_package_consumption(
    catalog: view<BinaryPackageCatalog>,
    active_target_triple: StrView,
    active_cpu_features: u64,
    active_abi: view<AbiFingerprint>,
    active_sif: view<SemanticFingerprint>,
    require_binary: bool
) -> ConsumptionDecision {
    // 0. Quarantined package check (`AXS-REG-003 §3`, `AXS-REG-050`)
    if catalog.is_quarantined {
        let mut det = binary_rejection_detail_empty()
        det.reason = REJECT_QUARANTINED
        det.package_spec = catalog.package_name
        det.found_val = dist_sv("quarantined")
        return ConsumptionDecision {
            action: ACTION_REJECT,
            selected_slice_idx: 0usize,
            rejection_reason: REJECT_QUARANTINED,
            rejection_detail: det,
            diag_code: 129u32, // AX_DRIVER_BAD_MANIFEST
            diag_kind: dist_sv("quarantined_package"),
        }
    }

    // 1. Source-only packages
    if catalog.distribution_mode == DIST_MODE_SOURCE {
        return ConsumptionDecision {
            action: ACTION_COMPILE_SOURCE,
            selected_slice_idx: 0usize,
            rejection_reason: REJECT_NONE,
            rejection_detail: binary_rejection_detail_empty(),
            diag_code: 0u32,
            diag_kind: dist_sv_empty(),
        }
    }

    // 2. Precompiled .axmeta interface summary validation
    if !catalog.interface_summary.is_valid {
        let mut det = binary_rejection_detail_empty()
        det.reason = REJECT_SCHEMA_MISMATCH
        det.found_val = dist_sv("invalid_axmeta_summary")
        return ConsumptionDecision {
            action: ACTION_REJECT,
            selected_slice_idx: 0usize,
            rejection_reason: REJECT_SCHEMA_MISMATCH,
            rejection_detail: det,
            diag_code: 115u32, // AX_LINK_BAD_OBJECT / AX_LINK_BAD_ARTIFACT
            diag_kind: dist_sv("bad_interface_container"),
        }
    }

    // SIF check: if SIF is recorded and non-zero, it must match active_sif
    if active_sif.lo != 0u64 || active_sif.hi != 0u64 {
        if !semantic_fingerprint_eq(catalog.interface_summary.semantic_interface_fingerprint, *active_sif) {
            let mut det = binary_rejection_detail_empty()
            det.reason = REJECT_SIF_MISMATCH
            det.expected_val = dist_sv("sif_match")
            det.found_val = dist_sv("sif_mismatch")
            if catalog.distribution_mode == DIST_MODE_HYBRID && !require_binary && catalog.has_source_tree {
                return ConsumptionDecision {
                    action: ACTION_COMPILE_SOURCE,
                    selected_slice_idx: 0usize,
                    rejection_reason: REJECT_SIF_MISMATCH,
                    rejection_detail: det,
                    diag_code: 0u32,
                    diag_kind: dist_sv("hybrid_sif_fallback_source"),
                }
            }
            return ConsumptionDecision {
                action: ACTION_REJECT,
                selected_slice_idx: 0usize,
                rejection_reason: REJECT_SIF_MISMATCH,
                rejection_detail: det,
                diag_code: 129u32,
                diag_kind: dist_sv("sif_mismatch"),
            }
        }
    }

    // 3. Try to select compatible binary slice
    let mut selected_idx: usize = 0usize
    let mut rej_detail = binary_rejection_detail_empty()
    let slice_ok = select_best_binary_slice(
        catalog,
        active_target_triple,
        active_cpu_features,
        active_abi,
        mut_view(selected_idx),
        mut_view(rej_detail)
    )

    if slice_ok {
        // Source-free consumption of precompiled binary package!
        return ConsumptionDecision {
            action: ACTION_USE_BINARY,
            selected_slice_idx: selected_idx,
            rejection_reason: REJECT_NONE,
            rejection_detail: binary_rejection_detail_empty(),
            diag_code: 0u32,
            diag_kind: dist_sv_empty(),
        }
    }

    // 4. Binary slice failed: handle Hybrid vs Binary mode
    if catalog.distribution_mode == DIST_MODE_HYBRID && !require_binary && catalog.has_source_tree {
        // Deterministic fallback to compiling from bundled .ax source tree
        return ConsumptionDecision {
            action: ACTION_COMPILE_SOURCE,
            selected_slice_idx: 0usize,
            rejection_reason: rej_detail.reason,
            rejection_detail: rej_detail,
            diag_code: 0u32,
            diag_kind: dist_sv("hybrid_fallback_to_source"),
        }
    }

    // Binary-only package or --require-binary: MUST reject and fail before linking
    let mut code: u32 = 129u32 // AX_DRIVER_BAD_MANIFEST
    let mut kind = dist_sv("binary_rejection")
    if rej_detail.reason == REJECT_TARGET_MISMATCH {
        code = 124u32 // AX_DRIVER_UNKNOWN_TARGET / AX_LINK_ARTIFACT_TARGET_MISMATCH
        kind = dist_sv("target_mismatch")
    } else if rej_detail.reason == REJECT_ABI_MISMATCH {
        code = 129u32
        kind = dist_sv("abi_mismatch")
    } else if rej_detail.reason == REJECT_NO_MATCHING_SLICE {
        code = 124u32
        kind = dist_sv("no_matching_slice")
    }

    ConsumptionDecision {
        action: ACTION_REJECT,
        selected_slice_idx: 0usize,
        rejection_reason: rej_detail.reason,
        rejection_detail: rej_detail,
        diag_code: code,
        diag_kind: kind,
    }
}

// =============================================================================
// 5. Multi-Repository Priority Routing & Namespace Pinning (`AXS-REG-031`)
// =============================================================================

pub fn routing_table_add_registry(
    table: mut_view<MultiRepoRoutingTable>,
    reg: view<RegistryConfig>,
    out_diag_kind: mut_view<StrView>
) -> bool {
    if table.registry_count >= 4usize {
        return false
    }

    // SPEC-112 §AXS-REG-031 §1:
    // "Duplicate pinned_namespaces claims across two distinct non-mirror registries
    // in the same configuration are rejected upfront with AX_DRIVER_BAD_MANIFEST
    // (data.kind = 'conflicting_namespace_pin')."
    let mut i: usize = 0usize
    while i < table.registry_count {
        let existing = table.registries[i]
        if !dist_sv_eq(existing.id, reg.id) {
            let mut j: usize = 0usize
            while j < reg.pinned_count && j < 4usize {
                let candidate_pin = reg.pinned_namespaces[j]
                let mut k: usize = 0usize
                while k < existing.pinned_count && k < 4usize {
                    if dist_sv_eq(existing.pinned_namespaces[k], candidate_pin) {
                        *out_diag_kind = dist_sv("conflicting_namespace_pin")
                        return false
                    }
                    k = k + 1usize
                }
                j = j + 1usize
            }
        }
        i = i + 1usize
    }

    table.registries[table.registry_count] = *reg
    table.registry_count = table.registry_count + 1usize
    true
}

pub fn check_shadow_defense(
    table: view<MultiRepoRoutingTable>,
    candidate_reg_id: StrView,
    namespace: StrView,
    pkg_name: StrView,
    out_expected_reg: mut_view<StrView>
) -> bool {
    // If `namespace` is in `pinned_namespaces` of any registry R_pin,
    // candidate_reg_id MUST match R_pin.id!
    let mut i: usize = 0usize
    while i < table.registry_count && i < 4usize {
        let reg = table.registries[i]
        let mut j: usize = 0usize
        while j < reg.pinned_count && j < 4usize {
            if dist_sv_eq(reg.pinned_namespaces[j], namespace) {
                if !dist_sv_eq(reg.id, candidate_reg_id) {
                    *out_expected_reg = reg.id
                    return false // SHADOWING BLOCKED! Dependency-confusion defense.
                }
                return true // Candidate is the authorized pinned registry.
            }
            j = j + 1usize
        }
        i = i + 1usize
    }
    // Namespace is unpinned
    true
}

pub fn route_package_lookup(
    table: view<MultiRepoRoutingTable>,
    namespace: StrView,
    pkg_name: StrView
) -> PackageRouteDecision {
    let e = dist_sv_empty()
    // 1. Check if namespace is pinned to any registry
    let mut i: usize = 0usize
    while i < table.registry_count && i < 4usize {
        let reg = table.registries[i]
        let mut j: usize = 0usize
        while j < reg.pinned_count && j < 4usize {
            if dist_sv_eq(reg.pinned_namespaces[j], namespace) {
                return PackageRouteDecision {
                    status: ROUTING_PINNED,
                    target_registry_idx: i,
                    target_registry_id: reg.id,
                    is_pinned: true,
                    shadowing_registry_id: e,
                    expected_registry_id: reg.id,
                }
            }
            j = j + 1usize
        }
        i = i + 1usize
    }

    // 2. Unpinned namespace: route by numeric priority (descending) among registries satisfying trust policy
    let mut best_idx: usize = 0usize
    let mut best_prio: u32 = 0u32
    let mut found_any = false

    i = 0usize
    while i < table.registry_count && i < 4usize {
        let reg = table.registries[i]
        if reg.trust_policy >= TRUST_POLICY_PUBLIC_STANDARD {
            if !found_any || reg.priority > best_prio {
                best_idx = i
                best_prio = reg.priority
                found_any = true
            }
        }
        i = i + 1usize
    }

    if found_any {
        return PackageRouteDecision {
            status: ROUTING_OK,
            target_registry_idx: best_idx,
            target_registry_id: table.registries[best_idx].id,
            is_pinned: false,
            shadowing_registry_id: e,
            expected_registry_id: e,
        }
    }

    // No eligible registry found
    PackageRouteDecision {
        status: ROUTING_NOT_FOUND,
        target_registry_idx: 0usize,
        target_registry_id: e,
        is_pinned: false,
        shadowing_registry_id: e,
        expected_registry_id: e,
    }
}

// =============================================================================
// 6. Diagnostics Reporting Helper (`AXS-REG-050`)
// =============================================================================

fn make_sv_entry(key: StrView, val: StrView) -> DiagDataEntry {
    DiagDataEntry {
        key: key,
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: val,
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0usize,
        },
    }
}

pub fn report_distribution_diag(
    sink: mut_view<DiagSink>,
    code_val: u32,
    msg: str,
    kind_name: str,
    key1: str,
    val1: StrView,
    key2: str,
    val2: StrView
) {
    let mut d = diag_new(diag_code(code_val), span_none(), dist_sv(msg))
    let mut entries: [3]DiagDataEntry = [
        make_sv_entry(dist_sv("kind"), dist_sv(kind_name)),
        make_sv_entry(dist_sv(key1), val1),
        make_sv_entry(dist_sv(key2), val2),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    diag_sink_report(mut_view(*sink), view(d))
}
