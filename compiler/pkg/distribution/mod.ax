@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// =============================================================================
// 1. String-View Helpers & Fingerprints (`AXS-REG-022`)
// =============================================================================

pub fn dist_sv(s: str) -> StrView {
    let lsv = lsv_from_str(s)
    StrView { ptr: lsv.ptr, len: lsv.len }
}

pub fn dist_sv_empty() -> StrView {
    StrView { ptr: 0 as *const u8, len: 0usize }
}

pub fn dist_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false }
    let mut i: usize = 0usize
    while i < a.len {
        let ba = if (a.ptr as usize) != 0usize { unsafe { *(a.ptr + i) } } else { 0u8 }
        let bb = if (b.ptr as usize) != 0usize { unsafe { *(b.ptr + i) } } else { 0u8 }
        if ba != bb { return false }
        i = i + 1usize
    }
    true
}

pub fn dist_sv_starts_with(s: StrView, prefix: StrView) -> bool {
    if prefix.len > s.len { return false }
    let mut i: usize = 0usize
    while i < prefix.len {
        if unsafe { *(s.ptr + i) != *(prefix.ptr + i) } {
            return false
        }
        i = i + 1usize
    }
    true
}

pub fn str_view_to_lsv(sv: StrView) -> LockStrView {
    LockStrView { ptr: sv.ptr, len: sv.len }
}

pub fn lsv_to_str_view(lsv: LockStrView) -> StrView {
    StrView { ptr: lsv.ptr, len: lsv.len }
}

@derive(Copy)
pub struct ApiFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn api_fingerprint_zero() -> ApiFingerprint {
    ApiFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn api_fingerprint_eq(a: ApiFingerprint, b: ApiFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@derive(Copy)
pub struct SemanticFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn semantic_fingerprint_zero() -> SemanticFingerprint {
    SemanticFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn semantic_fingerprint_eq(a: SemanticFingerprint, b: SemanticFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@derive(Copy)
pub struct AbiFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn abi_fingerprint_zero() -> AbiFingerprint {
    AbiFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn abi_fingerprint_eq(a: AbiFingerprint, b: AbiFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

// =============================================================================
// 2. Constants & Enums (`AXS-REG-020`..`023`, `AXS-REG-031`)
// =============================================================================

// Distribution modes per SPEC-112 AXS-REG-020 & SPEC-24 AXS-ART-002
pub const DIST_MODE_SOURCE: u16 = 1u16
pub const DIST_MODE_BINARY: u16 = 2u16
pub const DIST_MODE_HYBRID: u16 = 3u16

// Consumption actions
pub const ACTION_USE_BINARY: u8 = 1u8
pub const ACTION_COMPILE_SOURCE: u8 = 2u8
pub const ACTION_REJECT: u8 = 3u8

// Binary rejection reasons
pub const REJECT_NONE: u8 = 0u8
pub const REJECT_TARGET_MISMATCH: u8 = 1u8
pub const REJECT_ABI_MISMATCH: u8 = 2u8
pub const REJECT_SIF_MISMATCH: u8 = 3u8
pub const REJECT_SCHEMA_MISMATCH: u8 = 4u8
pub const REJECT_DIAMOND_CONFLICT: u8 = 5u8
pub const REJECT_NO_MATCHING_SLICE: u8 = 6u8
pub const REJECT_QUARANTINED: u8 = 7u8
pub const REJECT_DOWNGRADE_BLOCKED: u8 = 8u8

// Trust policy levels (`AXS-REG-031 §2`)
pub const TRUST_POLICY_UNTRUSTED: u8 = 0u8
pub const TRUST_POLICY_PUBLIC_STANDARD: u8 = 1u8
pub const TRUST_POLICY_ENTERPRISE_VERIFIED: u8 = 2u8

// Multi-repo routing result status codes
pub const ROUTING_OK: u32 = 0u32
pub const ROUTING_PINNED: u32 = 1u32
pub const ROUTING_SHADOW_BLOCKED: u32 = 2u32
pub const ROUTING_NOT_FOUND: u32 = 3u32
pub const ROUTING_CONFLICTING_PIN: u32 = 4u32
pub const ROUTING_POLICY_BLOCKED: u32 = 5u32

pub fn dist_mode_name(mode: u16) -> StrView {
    if mode == DIST_MODE_SOURCE { return dist_sv("source") }
    if mode == DIST_MODE_BINARY { return dist_sv("binary") }
    if mode == DIST_MODE_HYBRID { return dist_sv("hybrid") }
    dist_sv("unknown")
}

pub fn parse_dist_mode(s: StrView) -> u16 {
    if dist_sv_eq(s, dist_sv("source")) { return DIST_MODE_SOURCE }
    if dist_sv_eq(s, dist_sv("binary")) { return DIST_MODE_BINARY }
    if dist_sv_eq(s, dist_sv("hybrid")) { return DIST_MODE_HYBRID }
    DIST_MODE_SOURCE
}

pub fn binary_rejection_name(r: u8) -> StrView {
    if r == REJECT_NONE { return dist_sv("none") }
    if r == REJECT_TARGET_MISMATCH { return dist_sv("target_mismatch") }
    if r == REJECT_ABI_MISMATCH { return dist_sv("abi_mismatch") }
    if r == REJECT_SIF_MISMATCH { return dist_sv("sif_mismatch") }
    if r == REJECT_SCHEMA_MISMATCH { return dist_sv("schema_mismatch") }
    if r == REJECT_DIAMOND_CONFLICT { return dist_sv("diamond_conflict") }
    if r == REJECT_NO_MATCHING_SLICE { return dist_sv("no_matching_slice") }
    if r == REJECT_QUARANTINED { return dist_sv("quarantined_package") }
    if r == REJECT_DOWNGRADE_BLOCKED { return dist_sv("policy_blocked_version") }
    dist_sv("unknown_rejection")
}

pub fn trust_policy_name(p: u8) -> StrView {
    if p == TRUST_POLICY_UNTRUSTED { return dist_sv("untrusted") }
    if p == TRUST_POLICY_PUBLIC_STANDARD { return dist_sv("public_standard") }
    if p == TRUST_POLICY_ENTERPRISE_VERIFIED { return dist_sv("enterprise_verified") }
    dist_sv("unknown")
}

pub fn trust_policy_from_str(s: StrView) -> u8 {
    if dist_sv_eq(s, dist_sv("enterprise_verified")) { return TRUST_POLICY_ENTERPRISE_VERIFIED }
    if dist_sv_eq(s, dist_sv("public_standard")) { return TRUST_POLICY_PUBLIC_STANDARD }
    TRUST_POLICY_UNTRUSTED
}

