@derive(Copy)
pub struct PrecompiledInterfaceSummary {
    pub magic: [8]u8,
    pub schema_version: u16,
    pub compiler_semantic_version: StrView,
    pub target_triple: StrView,
    pub api_fingerprint: ApiFingerprint,
    pub semantic_interface_fingerprint: SemanticFingerprint,
    pub abi_fingerprint: AbiFingerprint,
    pub cpu_feature_mask: u64,
    pub is_valid: bool,
}

pub fn precompiled_interface_summary_empty() -> PrecompiledInterfaceSummary {
    PrecompiledInterfaceSummary {
        magic: [65u8, 88u8, 77u8, 69u8, 84u8, 65u8, 48u8, 49u8], // "AXMETA01"
        schema_version: 1u16,
        compiler_semantic_version: dist_sv("0.1.0"),
        target_triple: dist_sv("x86_64-windows"),
        api_fingerprint: ApiFingerprint { lo: 0u64, hi: 0u64 },
        semantic_interface_fingerprint: SemanticFingerprint { lo: 0u64, hi: 0u64 },
        abi_fingerprint: AbiFingerprint { lo: 0u64, hi: 0u64 },
        cpu_feature_mask: 1u64,
        is_valid: true,
    }
}

