}

pub fn binary_package_catalog_empty() -> BinaryPackageCatalog {
    let e = dist_sv_empty()
    let sl: [4]BinarySliceDescriptor = [
        binary_slice_descriptor_empty(),
        binary_slice_descriptor_empty(),
        binary_slice_descriptor_empty(),
        binary_slice_descriptor_empty()
    ]
    BinaryPackageCatalog {
        package_name: e,
        package_version: e,
        distribution_mode: DIST_MODE_SOURCE,
        interface_summary: precompiled_interface_summary_empty(),
        slices: sl,
        slice_count: 0usize,
        has_source_tree: true,
        source_entry_path: dist_sv("src/lib.ax"),
        is_quarantined: false,
    }
}

