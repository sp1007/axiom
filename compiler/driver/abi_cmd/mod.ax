// Axiom Compiler — ABI Compatibility Check & SemVer Diff CLI Driver (compiler/driver/abi_cmd/mod.ax)
// Implements SPEC-114 §5 (AXS-ABI-040..042, AXS-ABI-050; REQ-PKG-022, REQ-PKG-024).

module compiler.driver.abi_cmd

use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_sv
use compiler.diag.format.diag_buf_push_u32
use compiler.diag.json.write_json_string
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_empty
use compiler.diag.ux2.ux2_sv_eq
use compiler.diag.ux2.ux2_sv_contains

use compiler.abi.stability.AX_ABI_BREAKING_CHANGE
use compiler.abi.stability.AX_ABI_SEMVER_MISMATCH
use compiler.abi.stability.abi_diag_code_name

use compiler.abi.compat_diff.COMPAT_CLASS_IDENTICAL
use compiler.abi.compat_diff.COMPAT_CLASS_IMPL_ONLY
use compiler.abi.compat_diff.COMPAT_CLASS_MINOR_ADDITIVE
use compiler.abi.compat_diff.COMPAT_CLASS_MAJOR_BREAKING
use compiler.abi.compat_diff.compat_class_name
use compiler.abi.compat_diff.SEVERITY_COMPATIBLE
use compiler.abi.compat_diff.SEVERITY_ADDITIVE
use compiler.abi.compat_diff.SEVERITY_BREAKING
use compiler.abi.compat_diff.severity_name
use compiler.abi.compat_diff.diff_kind_name
use compiler.abi.compat_diff.ItemDiff
use compiler.abi.compat_diff.InterfaceDiffResult
use compiler.abi.compat_diff.interface_diff_result_empty
use compiler.abi.compat_diff.InterfaceDescriptor
use compiler.abi.compat_diff.diff_interface_descriptors
