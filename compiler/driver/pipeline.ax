@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

unsafe fn ptr_from_mut<T>(v: mut_view<T>) -> *mut T {
    address_of_mut(*v)
}

// =============================================================================
// 1. Constant String Table for Pipeline Stage Names, Panics, and Symbols
// =============================================================================

//   0..6   (6):  "time: "
//   6..16  (10): "source    "
//  16..26  (10): "lex       "
//  26..36  (10): "parse     "
//  36..46  (10): "resolve   "
//  46..56  (10): "hir       "
//  56..66  (10): "typeck    "
//  66..76  (10): "own       "
//  76..86  (10): "run       "
//  86..96  (10): "mono      "
//  96..106 (10): "build     "
// 106..108 (2):  "s\n"
// 108..115 (7):  "panic: "
// 115..119 (4):  "main"
// 119..126 (7):  "ax_main"
// 126..132 (6):  "axiom0"
// 132..137 (5):  ".text"
// 137..143 (6):  ".rdata"
// 143..151 (8):  ".Lpanic."
// 151..162 (11): "axiom_panic"
// 162..178 (16): "assertion failed"
const PIPELINE_STR_TABLE: [178]u8 = [
    // 0..6: "time: "
    116u8, 105u8, 109u8, 101u8, 58u8, 32u8,
    // 6..16: "source    "
    115u8, 111u8, 117u8, 114u8, 99u8, 101u8, 32u8, 32u8, 32u8, 32u8,
    // 16..26: "lex       "
    108u8, 101u8, 120u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 26..36: "parse     "
    112u8, 97u8, 114u8, 115u8, 101u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 36..46: "resolve   "
    114u8, 101u8, 115u8, 111u8, 108u8, 118u8, 101u8, 32u8, 32u8, 32u8,
    // 46..56: "hir       "
    104u8, 105u8, 114u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 56..66: "typeck    "
    116u8, 121u8, 112u8, 101u8, 99u8, 107u8, 32u8, 32u8, 32u8, 32u8,
    // 66..76: "own       "
    111u8, 119u8, 110u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 76..86: "run       "
    114u8, 117u8, 110u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 86..96: "mono      "
    109u8, 111u8, 110u8, 111u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 96..106: "build     "
    98u8, 117u8, 105u8, 108u8, 100u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 106..108: "s\n"
    115u8, 10u8,
    // 108..115: "panic: "
    112u8, 97u8, 110u8, 105u8, 99u8, 58u8, 32u8,
    // 115..119: "main"
    109u8, 97u8, 105u8, 110u8,
    // 119..126: "ax_main"
    97u8, 120u8, 95u8, 109u8, 97u8, 105u8, 110u8,
    // 126..132: "axiom0"
    97u8, 120u8, 105u8, 111u8, 109u8, 48u8,
    // 132..137: ".text"
    46u8, 116u8, 101u8, 120u8, 116u8,
    // 137..143: ".rdata"
    46u8, 114u8, 100u8, 97u8, 116u8, 97u8,
    // 143..151: ".Lpanic." (ADR-0035 section 1)
    46u8, 76u8, 112u8, 97u8, 110u8, 105u8, 99u8, 46u8,
    // 151..162: "axiom_panic"
    97u8, 120u8, 105u8, 111u8, 109u8, 95u8, 112u8, 97u8, 110u8, 105u8, 99u8,
    // 162..178: "assertion failed"
    97u8, 115u8, 115u8, 101u8, 114u8, 116u8, 105u8, 111u8, 110u8, 32u8, 102u8, 97u8, 105u8, 108u8, 101u8, 100u8,
];

fn push_pipe_str(out: mut_view<DiagBuffer>, off: usize, n: usize) {
    let mut i: usize = 0;
    while i < n {
        diag_buf_push_byte(mut_view(*out), PIPELINE_STR_TABLE[off + i]);
        i = i + 1;
    }
}

fn sv_contains_host_str(sv: view<StrView>) -> bool {
    let sv_len = sv.len;
    if sv_len < 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i + 4 <= sv.len {
        let b0 = unsafe { *(sv.ptr + i) };
        let b1 = unsafe { *(sv.ptr + i + 1) };
        let b2 = unsafe { *(sv.ptr + i + 2) };
        let b3 = unsafe { *(sv.ptr + i + 3) };
        if b0 == 104u8 && b1 == 111u8 && b2 == 115u8 && b3 == 116u8 {
            return true;
        }
        i = i + 1;
    }
    false
}

fn clone_lex_strings_to_arena(lex_res: mut_view<LexResult>, dst_arena: mut_view<Arena>) {
    let mut ti: usize = 0;
    while ti < lex_res.token_count {
        let tp = unsafe { lex_token_ptr(lex_res.tokens, ti) };
        let s_ptr = unsafe { (*tp).str_ptr };
        let s_len = unsafe { (*tp).str_len };
        if (s_ptr as usize) != 0 {
            let dst = arena_alloc_raw(mut_view(*dst_arena), s_len + 1, 1);
            let mut bi: usize = 0;
            while bi < s_len {
                unsafe {
                    *(dst + bi) = *(s_ptr + bi);
                }
                bi = bi + 1;
            }
            unsafe {
                *(dst + s_len) = 0u8;
                (*tp).str_ptr = dst as *const u8;
            }
        }
        ti = ti + 1;
    }
}

// Formats `"time: %-10s %.4fs\n"` into `out`, matching `pipeline.c:ax_pipeline_run`.
pub fn format_pass_time(out: mut_view<DiagBuffer>, stage_idx: u32, elapsed_ns: u64) {
    push_pipe_str(mut_view(*out), 0, 6);
    let name_off: usize = 6 + opts_mul_usize(stage_idx as usize, 10);
    push_pipe_str(mut_view(*out), name_off, 10);
    diag_buf_push_byte(mut_view(*out), 32u8);

    // Round nanoseconds to 0.0001s (100,000 ns) units
    let elapsed_i64: i64 = if (elapsed_ns as i64) >= 0i64 { elapsed_ns as i64 } else { 0i64 };
    let tenths_ms: i64 = (elapsed_i64 + 50000i64) / 100000i64;
    let secs: u32 = (tenths_ms / 10000i64) as u32;
    let frac: i32 = (tenths_ms % 10000i64) as i32;

    diag_buf_push_u32(mut_view(*out), secs);
    diag_buf_push_byte(mut_view(*out), 46u8);
    let d3: u8 = (((frac / 1000) % 10) as u8) + 48u8;
    let d2: u8 = (((frac / 100) % 10) as u8) + 48u8;
    let d1: u8 = (((frac / 10) % 10) as u8) + 48u8;
    let d0: u8 = ((frac % 10) as u8) + 48u8;
    diag_buf_push_byte(mut_view(*out), d3);
    diag_buf_push_byte(mut_view(*out), d2);
    diag_buf_push_byte(mut_view(*out), d1);
    diag_buf_push_byte(mut_view(*out), d0);
    push_pipe_str(mut_view(*out), 106, 2);
}

// =============================================================================
// 2. Pipeline Context (`PipelineCtx`) & Stage Execution
// =============================================================================

pub struct PipelineCtx {
    pub sess: CompilerSession,
    pub proj: Project,
    pub main_fid: FileId,
    pub host_fid: FileId,
    pub main_text: StrView,
    pub is_mir_input: bool,
    pub uses_host: bool,
    pub lex_res: LexResult,
    pub lex_res_active: bool,
    pub parse_arena: Arena,
    pub resolve_arena: Arena,
    pub hir_arena: Arena,
    pub mir_arena: Arena,
    pub backend_arena: Arena,
    pub ast: Ast,
    pub rmap: ResolveMap,
    pub hir: HirFile,
    pub has_tls: bool,
    pub thir: Thir,
    pub mono: MonoEngine,
    pub time_ns: [10]u64,
    pub interp_rc: i32,
    pub panic_msg: StrView,
}

pub fn pipeline_ctx_init(ctx: mut_view<PipelineCtx>) {
    session_init(mut_view(ctx.sess));
    project_init(mut_view(ctx.proj));
    ctx.main_fid.v = 0u32;
    ctx.host_fid.v = 0u32;
    sv_clear(mut_view(ctx.main_text));
    ctx.is_mir_input = false;
    ctx.uses_host = false;
    opts_arena_init(mut_view(ctx.lex_res.arena));
    ctx.lex_res.tokens = 0 as *mut Token;
    ctx.lex_res.token_count = 0;
    ctx.lex_res.token_cap = 0;
    ctx.lex_res.comments = 0 as *mut Comment;
    ctx.lex_res.comment_count = 0;
    ctx.lex_res.comment_cap = 0;
    ctx.lex_res_active = true;
    opts_arena_init(mut_view(ctx.parse_arena));
    opts_arena_init(mut_view(ctx.resolve_arena));
    opts_arena_init(mut_view(ctx.hir_arena));
    opts_arena_init(mut_view(ctx.mir_arena));
    opts_arena_init(mut_view(ctx.backend_arena));
    ctx.ast.items = 0 as *mut AstItem;
    ctx.rmap.node_map.keys = 0 as *mut usize;
    ctx.rmap.node_map.vals = 0 as *mut SymbolId;
    ctx.rmap.node_map.states = 0 as *mut u8;
    ctx.rmap.node_map.len = 0;
    ctx.rmap.node_map.cap = 0;
    ctx.rmap.module_access_nodes.keys = 0 as *mut usize;
    ctx.rmap.module_access_nodes.vals = 0 as *mut SymbolId;
    ctx.rmap.module_access_nodes.states = 0 as *mut u8;
    ctx.rmap.module_access_nodes.len = 0;
    ctx.rmap.module_access_nodes.cap = 0;
    ctx.rmap.extern_nodes.keys = 0 as *mut usize;
    ctx.rmap.extern_nodes.vals = 0 as *mut SymbolId;
    ctx.rmap.extern_nodes.states = 0 as *mut u8;
    ctx.rmap.extern_nodes.len = 0;
    ctx.rmap.extern_nodes.cap = 0;
    ctx.rmap.next_symbol_v = 1u32;
    ctx.rmap.next_std_symbol_v = 10000u32;
    ctx.rmap.naming_ctx = 0 as *mut NamingCtx;
    ctx.hir.items = 0 as *mut HirItem;
    ctx.has_tls = false;
    opts_arena_init(mut_view(ctx.thir.interner.arena));
    thir_init(mut_view(ctx.thir));
    let hir_arena_ptr = unsafe { ptr_from_mut(mut_view(ctx.hir_arena)) };
    ctx.mono.arena = hir_arena_ptr;
    ctx.mono.instances_head = 0 as *mut MonoInstance;
    ctx.mono.instances_tail = 0 as *mut MonoInstance;
    ctx.mono.instance_count = 0;
    ctx.mono.work_head = 0 as *mut MonoInstance;
    ctx.mono.work_tail = 0 as *mut MonoInstance;
    ctx.mono.next_counter = 0u32;
    ctx.mono.next_sym_id = 0u32;
    mono_engine_init(mut_view(ctx.mono), hir_arena_ptr);
    let mut i: usize = 0;
    while i < 10 {
        ctx.time_ns[i] = 0u64;
        i = i + 1;
    }
    ctx.interp_rc = 0;
    sv_clear(mut_view(ctx.panic_msg));
}

pub fn pipeline_ctx_free(ctx: mut_view<PipelineCtx>) {
    if ctx.lex_res_active {
        ax_lex_result_free(mut_view(ctx.lex_res));
        ctx.lex_res_active = false;
    }
    resolve_map_free(mut_view(ctx.rmap));
    thir_free(mut_view(ctx.thir));
    arena_destroy(mut_view(ctx.backend_arena));
    arena_destroy(mut_view(ctx.mir_arena));
    arena_destroy(mut_view(ctx.hir_arena));
    arena_destroy(mut_view(ctx.resolve_arena));
    arena_destroy(mut_view(ctx.parse_arena));
    project_free(mut_view(ctx.proj));
    session_free(mut_view(ctx.sess));
}

pub fn pipeline_ctx_alloc() -> *mut PipelineCtx {
    let sz = size_of<PipelineCtx>();
    let p = unsafe { heap_alloc(sz, align_of<PipelineCtx>()) };
    let mut i: usize = 0;
    while i < sz {
        unsafe { *(p + i) = 0u8; }
        i = i + 1;
    }
    let ctx_ptr = p as *mut PipelineCtx;
    pipeline_ctx_init(unsafe { mut_view(*ctx_ptr) });
    ctx_ptr
}

pub fn pipeline_ctx_dealloc(ctx_ptr: *mut PipelineCtx) {
    if (ctx_ptr as usize) == 0 {
        return;
    }
    pipeline_ctx_free(unsafe { mut_view(*ctx_ptr) });
    unsafe {
        heap_free(ctx_ptr as *mut u8, size_of<PipelineCtx>(), align_of<PipelineCtx>());
    }
}

const PIPE_FUT_REL_DATA: [13]u8 = [
    102u8, 117u8, 116u8, 117u8, 114u8, 101u8, 47u8, 109u8, 111u8, 100u8, 46u8, 97u8, 120u8
];
const PIPE_FUT_DISP_DATA: [19]u8 = [
    60u8, 115u8, 116u8, 100u8, 62u8, 47u8, 102u8, 117u8, 116u8, 117u8, 114u8, 101u8, 47u8, 109u8, 111u8, 100u8, 46u8, 97u8, 120u8
];
const PIPE_FUT_MOD_DATA: [10]u8 = [
    115u8, 116u8, 100u8, 46u8, 102u8, 117u8, 116u8, 117u8, 114u8, 101u8
];

const PIPE_BO_REL_DATA: [18]u8 = [
    102u8, 117u8, 116u8, 117u8, 114u8, 101u8, 47u8, 98u8, 108u8, 111u8, 99u8, 107u8, 95u8, 111u8, 110u8, 46u8, 97u8, 120u8
];
const PIPE_BO_DISP_DATA: [24]u8 = [
    60u8, 115u8, 116u8, 100u8, 62u8, 47u8, 102u8, 117u8, 116u8, 117u8, 114u8, 101u8, 47u8, 98u8, 108u8, 111u8, 99u8, 107u8, 95u8, 111u8, 110u8, 46u8, 97u8, 120u8
];
const PIPE_BO_MOD_DATA: [19]u8 = [
    115u8, 116u8, 100u8, 46u8, 102u8, 117u8, 116u8, 117u8, 114u8, 101u8, 46u8, 98u8, 108u8, 111u8, 99u8, 107u8, 95u8, 111u8, 110u8
];

fn pipe_append_std_future_files_if_needed(proj: mut_view<Project>) {
    if proj.std_root.len == 0 {
        return;
    }
    let fut_rel = StrView { ptr: unsafe { address_of(PIPE_FUT_REL_DATA[0]) }, len: 13 };
    let fut_disk = arena_join_path(mut_view(proj.arena), view(proj.std_root), view(fut_rel));
    if host_file_exists(view(fut_disk)) {
        let mut already_has_fut = false;
        let mut i: usize = 0;
        while i < proj.file_count {
            let pf = unsafe { project_file_const_at(proj.files as *const ProjectFile, i) };
            let pf_disk = pf_get_disk_path(pf);
            if sv_eq(view(pf_disk), view(fut_disk)) {
                already_has_fut = true;
                break;
            }
            i = i + 1;
        }
        if !already_has_fut {
            let fut_disp = StrView { ptr: unsafe { address_of(PIPE_FUT_DISP_DATA[0]) }, len: 19 };
            let fut_mod = StrView { ptr: unsafe { address_of(PIPE_FUT_MOD_DATA[0]) }, len: 10 };
            project_add_file(mut_view(*proj), fut_disk, fut_disp, fut_mod, sv_empty(), false, true);
        }
    }

    let bo_rel = StrView { ptr: unsafe { address_of(PIPE_BO_REL_DATA[0]) }, len: 18 };
    let bo_disk = arena_join_path(mut_view(proj.arena), view(proj.std_root), view(bo_rel));
    if host_file_exists(view(bo_disk)) {
        let mut already_has_bo = false;
        let mut j: usize = 0;
        while j < proj.file_count {
            let pf = unsafe { project_file_const_at(proj.files as *const ProjectFile, j) };
            let pf_disk = pf_get_disk_path(pf);
            if sv_eq(view(pf_disk), view(bo_disk)) {
                already_has_bo = true;
                break;
            }
            j = j + 1;
        }
        if !already_has_bo {
            let bo_disp = StrView { ptr: unsafe { address_of(PIPE_BO_DISP_DATA[0]) }, len: 24 };
            let bo_mod = StrView { ptr: unsafe { address_of(PIPE_BO_MOD_DATA[0]) }, len: 19 };
            project_add_file(mut_view(*proj), bo_disk, bo_disp, bo_mod, sv_empty(), false, true);
        }
    }
}

pub fn pipeline_stage_source(ctx: mut_view<PipelineCtx>, dopts: view<DriverOptions>) -> bool {
    if dopts.input_file.len == 0 {
        emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
        return false;
    }

    if sv_ends_with_mir(view(dopts.input_file)) {
        ctx.is_mir_input = true;
        let mut ok: bool = false;
        let ok_ptr = unsafe { ptr_from_mut(mut_view(ok)) };
        let text = host_read_file_in_arena(view(dopts.input_file), mut_view(ctx.proj.arena), ok_ptr);
        if !ok {
            emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
            return false;
        }
        let in_file = StrView { ptr: dopts.input_file.ptr, len: dopts.input_file.len };
        let fid = session_add_virtual_file(mut_view(ctx.sess), in_file, text);
        let fid_v = fid.v;
        ctx.main_fid.v = fid_v;
        let mtxt = session_file_text(view(ctx.sess), FileId { v: fid_v });
        sv_copy_to(mut_view(ctx.main_text), view(mtxt));
        return true;
    }

    if !project_discover(
        view(dopts.input_file),
        view(dopts.std_root),
        mut_view(ctx.proj),
        mut_view(ctx.sess.diag_sink)
    ) {
        return false;
    }

    if dopts.cmd == CMD_BUILD {
        let mut pi: usize = 1;
        while pi < dopts.pos_argc {
            let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi);
            if sv_ends_with_ax(view(arg_sv)) && !sv_eq(view(arg_sv), view(dopts.input_file)) {
                if !project_add_extra_ax_file(mut_view(ctx.proj), view(arg_sv), mut_view(ctx.sess.diag_sink)) {
                    return false;
                }
            }
            pi = pi + 1;
        }
    }

    if ctx.proj.file_count == 0 {
        emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
        return false;
    }

    // Read all non-std user files and check if any references `host`
    let mut uses_host: bool = false;
    let mut i: usize = 0;
    while i < ctx.proj.file_count {
        let pf = unsafe { project_file_at(ctx.proj.files, i) };
        let is_std = pf_is_std(pf as *const ProjectFile);
        if !is_std {
            let mut ok: bool = false;
            let ok_ptr = unsafe { ptr_from_mut(mut_view(ok)) };
            let disk = pf_get_disk_path(pf as *const ProjectFile);
            let txt = host_read_file_in_arena(view(disk), mut_view(ctx.proj.arena), ok_ptr);
            if !ok {
                emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
                return false;
            }
            if !uses_host && sv_contains_host_str(view(txt)) {
                uses_host = true;
            }
            pf_set_text(pf, view(txt));
        }
        i = i + 1;
    }

    ctx.uses_host = uses_host;
    let pre_host_count = ctx.proj.file_count;
    if uses_host {
        project_append_std_host_if_needed(mut_view(ctx.proj), true);
    }
    pipe_append_std_future_files_if_needed(mut_view(ctx.proj));

    // Load all files (user + std) into `ctx.sess.source_db` in project order
    let mut j: usize = 0;
    while j < ctx.proj.file_count {
        let pf = unsafe { project_file_at(ctx.proj.files, j) };
        let init_txt = pf_get_text(pf as *const ProjectFile);
        if (init_txt.ptr as usize) == 0 {
            let mut ok: bool = false;
            let ok_ptr = unsafe { ptr_from_mut(mut_view(ok)) };
            let disk = pf_get_disk_path(pf as *const ProjectFile);
            let read_txt = host_read_file_in_arena(view(disk), mut_view(ctx.proj.arena), ok_ptr);
            if !ok {
                emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
                return false;
            }
            pf_set_text(pf, view(read_txt));
        }
        let txt = pf_get_text(pf as *const ProjectFile);
        let disp = pf_get_display_path(pf as *const ProjectFile);
        let fid = session_add_virtual_file(mut_view(ctx.sess), disp, txt);
        let fid_v = fid.v;
        if session_has_errors(view(ctx.sess)) {
            return false;
        }
        if uses_host && j >= pre_host_count {
            ctx.host_fid.v = fid_v;
        }
        pf_set_fid_v(pf, fid_v);
        if pf_is_main(pf as *const ProjectFile) {
            ctx.main_fid.v = fid_v;
            let mtxt = session_file_text(view(ctx.sess), FileId { v: fid_v });
            sv_copy_to(mut_view(ctx.main_text), view(mtxt));
        }
        j = j + 1;
    }

    if ctx.main_fid.v == 0u32 {
        let mut k: usize = 0;
        while k < ctx.proj.file_count {
            let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, k) };
            if !pf_is_std(pf) {
                let fid_v = pf_get_fid_v(pf);
                ctx.main_fid.v = fid_v;
                let mtxt = session_file_text(view(ctx.sess), FileId { v: fid_v });
                sv_copy_to(mut_view(ctx.main_text), view(mtxt));
                break;
            }
            k = k + 1;
        }
        if ctx.main_fid.v == 0u32 && ctx.proj.file_count > 0 {
            let pf0 = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, 0) };
            let fid0_v = pf_get_fid_v(pf0);
            ctx.main_fid.v = fid0_v;
            let mtxt = session_file_text(view(ctx.sess), FileId { v: fid0_v });
            sv_copy_to(mut_view(ctx.main_text), view(mtxt));
        }
    }

    !session_has_errors(view(ctx.sess))
}

pub fn pipeline_stage_lex(ctx: mut_view<PipelineCtx>) {
    if ctx.is_mir_input {
        return;
    }
    if ctx.main_fid.v != 0u32 {
        session_lex_file(mut_view(ctx.sess), FileId { v: ctx.main_fid.v }, mut_view(ctx.lex_res));
    }
}

pub fn pipeline_stage_parse(ctx: mut_view<PipelineCtx>) {
    if ctx.is_mir_input {
        return;
    }
    if ctx.proj.file_count == 0 {
        clone_lex_strings_to_arena(mut_view(ctx.lex_res), mut_view(ctx.parse_arena));
        let pres = session_parse_tokens(
            mut_view(ctx.sess),
            mut_view(ctx.parse_arena),
            ctx.lex_res.tokens,
            ctx.lex_res.token_count
        );
        ctx.ast.items = pres.ast.items;
        return;
    }

    let mut head_items: *mut AstItem = 0 as *mut AstItem;
    let mut i: usize = 0;
    while i < ctx.proj.file_count {
        let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, i) };
        let fid_v = pf_get_fid_v(pf);
        let fid = FileId { v: fid_v };
        let mod_path = pf_get_module_path(pf);

        let mut file_items: *mut AstItem = 0 as *mut AstItem;
        if fid_v == ctx.main_fid.v && ctx.lex_res_active && (ctx.lex_res.tokens as usize) != 0 {
            clone_lex_strings_to_arena(mut_view(ctx.lex_res), mut_view(ctx.parse_arena));
            let pres = session_parse_tokens(
                mut_view(ctx.sess),
                mut_view(ctx.parse_arena),
                ctx.lex_res.tokens,
                ctx.lex_res.token_count
            );
            file_items = pres.ast.items;
        } else {
            let mut f_lex = LexResult {
                arena: arena_new(),
                tokens: 0 as *mut Token,
                token_count: 0,
                token_cap: 0,
                comments: 0 as *mut Comment,
                comment_count: 0,
                comment_cap: 0,
            };
            session_lex_file(mut_view(ctx.sess), fid, mut_view(f_lex));
            clone_lex_strings_to_arena(mut_view(f_lex), mut_view(ctx.parse_arena));
            let pres = session_parse_tokens(
                mut_view(ctx.sess),
                mut_view(ctx.parse_arena),
                f_lex.tokens,
                f_lex.token_count
            );
            ax_lex_result_free(mut_view(f_lex));
            file_items = pres.ast.items;
        }

        let mut pres_ast = Ast { items: file_items };
        if ctx.proj.is_package && mod_path.len > 0 {
            session_ensure_module_header(
                mut_view(ctx.sess),
                mut_view(ctx.parse_arena),
                mut_view(pres_ast),
                mod_path
            );
        }

        head_items = append_ast_items(head_items, pres_ast.items);
        i = i + 1;
    }

    ctx.ast.items = head_items;
}

pub fn pipeline_stage_resolve(ctx: mut_view<PipelineCtx>) {
    if ctx.is_mir_input {
        return;
    }
    session_resolve_ast_into(
        mut_view(ctx.sess),
        mut_view(ctx.resolve_arena),
        view(ctx.ast),
        mut_view(ctx.rmap)
    );
}

pub fn pipeline_stage_hir(ctx: mut_view<PipelineCtx>) {
    if ctx.is_mir_input {
        return;
    }
    let hf = session_lower_hir(
        mut_view(ctx.sess),
        mut_view(ctx.hir_arena),
        view(ctx.ast),
        view(ctx.rmap)
    );
    ctx.hir.items = hf.items;
    let mut any_tls = false;
    let mut it_scan = hf.items;
    while (it_scan as usize) != 0 {
        if (unsafe { (*it_scan).kind }) == HIR_ITEM_STATIC && (unsafe { (*it_scan).is_tls }) {
            any_tls = true;
            break;
        }
        it_scan = unsafe { (*it_scan).next };
    }
    ctx.has_tls = any_tls;
}

fn pipeline_mask_tls_statics(items: *mut HirItem) {
    let mut it = items;
    while (it as usize) != 0 {
        unsafe {
            if (*it).kind == HIR_ITEM_STATIC && (*it).is_tls {
                (*it).kind = 255u8;
            }
            it = (*it).next;
        }
    }
}

fn pipeline_unmask_tls_statics(items: *mut HirItem) {
    let mut it = items;
    while (it as usize) != 0 {
        unsafe {
            if (*it).kind == 255u8 {
                (*it).kind = HIR_ITEM_STATIC;
            }
            it = (*it).next;
        }
    }
}

pub fn pipeline_stage_typeck(ctx: mut_view<PipelineCtx>, dopts: view<DriverOptions>) {
    let _ = dopts;
    if ctx.is_mir_input || session_has_errors(view(ctx.sess)) {
        return;
    }
    let _ = session_typeck_and_seed_mono(
        mut_view(ctx.sess),
        view(ctx.hir),
        mut_view(ctx.thir),
        mut_view(ctx.hir_arena),
        mut_view(ctx.mono)
    );
    pipe_validate_exports(mut_view(*ctx));
    if session_has_errors(view(ctx.sess)) {
        return;
    }
    let _ = session_unsafe_check(
        mut_view(ctx.sess),
        view(ctx.hir),
        view(ctx.thir)
    );
    if session_has_errors(view(ctx.sess)) {
        return;
    }
    if ctx.has_tls {
        pipeline_mask_tls_statics(ctx.hir.items);
    }
    let _ = session_comptime_check_and_eval(
        mut_view(ctx.sess),
        view(ctx.ast),
        view(ctx.rmap),
        view(ctx.hir),
        mut_view(ctx.thir)
    );
    if ctx.has_tls {
        pipeline_unmask_tls_statics(ctx.hir.items);
    }
}

pub fn pipeline_stage_own(ctx: mut_view<PipelineCtx>) {
    if session_has_errors(view(ctx.sess)) {
        return;
    }
    if ctx.is_mir_input {
        let _ = session_verify_mir_text(
            mut_view(ctx.sess),
            mut_view(ctx.mir_arena),
            FileId { v: ctx.main_fid.v },
            StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
        );
        return;
    }
    let mono_ptr = unsafe { ptr_from_mut(mut_view(ctx.mono)) };
    let filter_fid_v: u32 = if ctx.proj.is_package { 0u32 } else { ctx.main_fid.v };
    let filter_fid = FileId { v: filter_fid_v };
    let _ = session_own_mir_verify_file(
        mut_view(ctx.sess),
        mut_view(ctx.mir_arena),
        view(ctx.hir),
        mut_view(ctx.thir),
        filter_fid,
        mono_ptr,
        true,
        0 as *mut DiagBuffer,
        0 as *mut DiagBuffer
    );
    if !session_has_errors(view(ctx.sess)) {
        pipe_check_spawn_send(ctx);
    }
}

fn pipe_expr_is_spawn(ctx: view<PipelineCtx>, expr: *const HirExpr) -> bool {
    if (expr as usize) == 0 { return false; }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_CALL {
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
            let sp = Span {
                file: FileId { v: unsafe { (*callee).path.span.file.v } },
                start: unsafe { (*callee).path.span.start },
                end: unsafe { (*callee).path.span.end },
            };
            if sp.file.v != 0u32 {
                let sv = source_db_span_text(view(ctx.sess.source_db), sp);
                if sv.len == 5 && unsafe { *(sv.ptr) == 115u8 && *(sv.ptr+1) == 112u8 && *(sv.ptr+2) == 97u8 && *(sv.ptr+3) == 119u8 && *(sv.ptr+4) == 110u8 } {
                    return true;
                }
            }
            let pn_v = unsafe { (*callee).path.name.v };
            if pn_v != 0u32 {
                let sv = interner_get(view(ctx.sess.interner), StrId { v: pn_v });
                if sv.len == 5 && unsafe { *(sv.ptr) == 115u8 && *(sv.ptr+1) == 112u8 && *(sv.ptr+2) == 97u8 && *(sv.ptr+3) == 119u8 && *(sv.ptr+4) == 110u8 } {
                    return true;
                }
            }
        }
    } else if ek == HIR_EXPR_METHOD_CALL {
        let mn_v = unsafe { (*expr).method_name.v };
        if mn_v != 0u32 {
            let sv = interner_get(view(ctx.sess.interner), StrId { v: mn_v });
            if sv.len == 5 && unsafe { *(sv.ptr) == 115u8 && *(sv.ptr+1) == 112u8 && *(sv.ptr+2) == 97u8 && *(sv.ptr+3) == 119u8 && *(sv.ptr+4) == 110u8 } {
                return true;
            }
        }
    }
    false
}

const PIPE_SEND_NAME: [4]u8 = [83u8, 101u8, 110u8, 100u8];

fn pipe_scan_spawn_expr(ctx: mut_view<PipelineCtx>, expr: *const HirExpr) {
    if (expr as usize) == 0 { return; }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_CALL || ek == HIR_EXPR_METHOD_CALL {
        if ek == HIR_EXPR_CALL {
            let callee: *mut HirExpr = unsafe { (*expr).callee };
            if (callee as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), callee); }
        } else {
            let recv: *mut HirExpr = unsafe { (*expr).receiver };
            if (recv as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), recv); }
        }
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while (a as usize) != 0 {
            pipe_scan_spawn_expr(mut_view(*ctx), a);
            a = unsafe { (*a).next };
        }
        if pipe_expr_is_spawn(view(*ctx), expr) {
            let mut arg: *mut HirExpr = unsafe { (*expr).args };
            while (arg as usize) != 0 {
                let at_v = unsafe { thir_get_expr_type(view(ctx.thir), arg).v };
                if at_v != 0u32 {
                    let at = type_get(view(ctx.thir.interner), TypeId { v: at_v });
                    if (at as usize) != 0 && (unsafe { (*at).kind }) == TY_COROUTINE {
                        let send_sv = StrView { ptr: unsafe { address_of(PIPE_SEND_NAME[0]) }, len: 4 };
                        let ok_send = type_satisfies_auto_trait(
                            view(ctx.hir),
                            view(ctx.thir),
                            TypeId { v: at_v },
                            1u8,
                            10007u32,
                            view(send_sv),
                            view(ctx.sess.interner),
                            view(ctx.sess.source_db),
                            0
                        );
                        if !ok_send {
                            let arg_sp = Span {
                                file: FileId { v: unsafe { (*arg).span.file.v } },
                                start: unsafe { (*arg).span.start },
                                end: unsafe { (*arg).span.end },
                            };
                            emit_conc_bound_diag(
                                view(ctx.hir),
                                view(ctx.thir),
                                TypeId { v: at_v },
                                1u8,
                                10007u32,
                                view(send_sv),
                                view(ctx.sess.interner),
                                view(ctx.sess.source_db),
                                mut_view(ctx.sess.diag_sink),
                                arg_sp
                            );
                        }
                    }
                }
                arg = unsafe { (*arg).next };
            }
        }
    } else if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        if (blk as usize) != 0 { pipe_scan_spawn_block(mut_view(*ctx), blk); }
    } else if ek == HIR_EXPR_IF {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
        if (cond_e as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), cond_e); }
        if (blk as usize) != 0 { pipe_scan_spawn_block(mut_view(*ctx), blk); }
        if (else_e as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), else_e); }
    } else if ek == HIR_EXPR_WHILE {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        if (cond_e as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), cond_e); }
        if (blk as usize) != 0 { pipe_scan_spawn_block(mut_view(*ctx), blk); }
    }
}

fn pipe_scan_spawn_block(ctx: mut_view<PipelineCtx>, blk: *const HirBlock) {
    if (blk as usize) == 0 { return; }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while (s as usize) != 0 {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let e: *mut HirExpr = unsafe { (*s).expr };
            let eb: *mut HirBlock = unsafe { (*s).else_block };
            if (e as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), e); }
            if (eb as usize) != 0 { pipe_scan_spawn_block(mut_view(*ctx), eb); }
        } else if sk == HIR_STMT_ASSIGN {
            let l: *mut HirExpr = unsafe { (*s).left };
            let r: *mut HirExpr = unsafe { (*s).right };
            if (l as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), l); }
            if (r as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), r); }
        } else if sk == HIR_STMT_EXPR {
            let e: *mut HirExpr = unsafe { (*s).expr };
            if (e as usize) != 0 { pipe_scan_spawn_expr(mut_view(*ctx), e); }
        }
        s = unsafe { (*s).next };
    }
}

fn pipe_check_spawn_send(ctx: mut_view<PipelineCtx>) {
    let mut it: *mut HirItem = ctx.hir.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_FN {
            let blk: *mut HirBlock = unsafe { (*it).body };
            if (blk as usize) != 0 {
                pipe_scan_spawn_block(mut_view(*ctx), blk);
            }
        } else if ik == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    let blk: *mut HirBlock = unsafe { (*m).body };
                    if (blk as usize) != 0 {
                        pipe_scan_spawn_block(mut_view(*ctx), blk);
                    }
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
}

// Lowers every `async fn` into its state machine before any other body is built (T088).
fn pipe_lower_all_async_functions(ctx: mut_view<PipelineCtx>) {
    let mono_ptr = unsafe { ptr_from_mut(mut_view(ctx.mono)) };
    session_lower_all_async(
        mut_view(ctx.sess),
        mut_view(ctx.mir_arena),
        view(ctx.hir),
        mut_view(ctx.thir),
        mono_ptr
    );
}

pub fn pipeline_stage_interp(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>
) {
    if session_has_errors(view(ctx.sess)) {
        ctx.interp_rc = AX_EXIT_DIAG;
        return;
    }
    pipe_lower_all_async_functions(mut_view(*ctx));
    if session_has_errors(view(ctx.sess)) {
        ctx.interp_rc = AX_EXIT_DIAG;
        return;
    }
    let out_ptr = unsafe { ptr_from_mut(mut_view(*out_buf)) };
    let panic_ptr = unsafe { ptr_from_mut(mut_view(ctx.panic_msg)) };
    if ctx.is_mir_input {
        let rc = session_interp_mir_text(
            mut_view(ctx.sess),
            mut_view(ctx.mir_arena),
            StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len },
            dopts.opt_O1,
            dopts.verify_each,
            dopts.step_limit,
            dopts.max_call_depth,
            out_ptr,
            true,
            panic_ptr
        );
        ctx.interp_rc = rc;
        return;
    }
    let mono_ptr = unsafe { ptr_from_mut(mut_view(ctx.mono)) };
    let filter_fid_v: u32 = if ctx.proj.is_package { 0u32 } else { ctx.main_fid.v };
    let filter_fid = FileId { v: filter_fid_v };
    let rc = session_run_interp_with_args(
        mut_view(ctx.sess),
        mut_view(ctx.mir_arena),
        view(ctx.ast),
        view(ctx.rmap),
        view(ctx.hir),
        mut_view(ctx.thir),
        filter_fid,
        mono_ptr,
        dopts.opt_O1,
        dopts.verify_each,
        dopts.step_limit,
        dopts.max_call_depth,
        out_ptr,
        true,
        panic_ptr,
        StrView { ptr: dopts.input_file.ptr, len: dopts.input_file.len },
        dopts.run_args as *const StrView,
        dopts.run_argc
    );
    ctx.interp_rc = rc;
}

pub fn pipeline_run_stages(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    upto: u32,
    out_buf: mut_view<DiagBuffer>
) -> bool {
    let mut s: u32 = STAGE_SOURCE;
    while s <= upto {
        if s == STAGE_INTERP && upto != STAGE_INTERP {
            s = s + 1u32;
            continue;
        }
        let t0 = monotonic_ns();
        if s == STAGE_SOURCE {
            let _ = pipeline_stage_source(mut_view(*ctx), dopts);
            if dopts.cmd == CMD_RUN && !dopts.has_explicit_kind && ctx.proj.has_manifest && ctx.proj.manifest.kind.len > 0 {
                let mut mk: u32 = ARTIFACT_EXE;
                if !driver_parse_artifact_kind(view(ctx.proj.manifest.kind), mut_view(mk)) {
                    emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_DRIVER_INVALID_ARTIFACT_KIND, 42, 48);
                    return false;
                }
                if mk != ARTIFACT_EXE {
                    return false;
                }
            }
        } else if s == STAGE_LEX {
            pipeline_stage_lex(mut_view(*ctx));
        } else if s == STAGE_PARSE {
            pipeline_stage_parse(mut_view(*ctx));
        } else if s == STAGE_RESOLVE {
            pipeline_stage_resolve(mut_view(*ctx));
        } else if s == STAGE_HIR {
            pipeline_stage_hir(mut_view(*ctx));
        } else if s == STAGE_TYPECK {
            pipeline_stage_typeck(mut_view(*ctx), dopts);
        } else if s == STAGE_OWN {
            if upto != STAGE_INTERP || ctx.is_mir_input {
                pipeline_stage_own(mut_view(*ctx));
            }
        } else if s == STAGE_INTERP {
            pipeline_stage_interp(mut_view(*ctx), dopts, mut_view(*out_buf));
        } else if s == STAGE_MONO {
            // Monomorphization seeding is integrated into stage_typeck; record stage for timing parity.
        }
        let t1 = monotonic_ns();
        let elapsed: u64 = if t1 >= t0 { t1 - t0 } else { 0u64 };
        ctx.time_ns[s as usize] = elapsed;
        if dopts.time_passes {
            format_pass_time(mut_view(*out_buf), s, elapsed);
        }
        if session_has_errors(view(ctx.sess)) {
            return false;
        }
        s = s + 1u32;
    }
    !session_has_errors(view(ctx.sess))
}

const WLIB_INVALID_KIND_CODE_NAME: [31]u8 = [
    65u8, 88u8, 95u8, 68u8, 82u8, 73u8, 86u8, 69u8, 82u8, 95u8, 73u8, 78u8, 86u8, 65u8, 76u8, 73u8,
    68u8, 95u8, 65u8, 82u8, 84u8, 73u8, 70u8, 65u8, 67u8, 84u8, 95u8, 75u8, 73u8, 78u8, 68u8,
];

const WLIB_BAD_ARCHIVE_CODE_NAME: [19]u8 = [
    65u8, 88u8, 95u8, 76u8, 73u8, 78u8, 75u8, 95u8, 66u8, 65u8, 68u8, 95u8, 65u8, 82u8, 67u8, 72u8,
    73u8, 86u8, 69u8,
];

const WLIB_LIB_NOT_FOUND_CODE_NAME: [25]u8 = [
    65u8, 88u8, 95u8, 76u8, 73u8, 78u8, 75u8, 95u8, 76u8, 73u8, 66u8, 82u8, 65u8, 82u8, 89u8, 95u8,
    78u8, 79u8, 84u8, 95u8, 70u8, 79u8, 85u8, 78u8, 68u8,
];

// "AX_LINK_DUPLICATE_EXPORT" (24 bytes)
const WLIB_DUP_EXPORT_CODE_NAME: [24]u8 = [
    65u8, 88u8, 95u8, 76u8, 73u8, 78u8, 75u8, 95u8, 68u8, 85u8, 80u8, 76u8, 73u8, 67u8, 65u8, 84u8,
    69u8, 95u8, 69u8, 88u8, 80u8, 79u8, 82u8, 84u8,
];

// "AX_FFI_GENERIC_EXPORT" (21 bytes)
const WLIB_GEN_EXPORT_CODE_NAME: [21]u8 = [
    65u8, 88u8, 95u8, 70u8, 70u8, 73u8, 95u8, 71u8, 69u8, 78u8, 69u8, 82u8, 73u8, 67u8, 95u8, 69u8,
    88u8, 80u8, 79u8, 82u8, 84u8,
];

// "AX_LINK_ABI_MISMATCH" (20 bytes)
const WLIB_ABI_MISMATCH_CODE_NAME: [20]u8 = [
    65u8, 88u8, 95u8, 76u8, 73u8, 78u8, 75u8, 95u8, 65u8, 66u8,
    73u8, 95u8, 77u8, 73u8, 83u8, 77u8, 65u8, 84u8, 67u8, 72u8,
];

// "AX_LINK_ARTIFACT_TARGET_MISMATCH" (32 bytes)
const WLIB_TARGET_MISMATCH_CODE_NAME: [32]u8 = [
    65u8, 88u8, 95u8, 76u8, 73u8, 78u8, 75u8, 95u8, 65u8, 82u8, 84u8, 73u8, 70u8, 65u8, 67u8, 84u8,
    95u8, 84u8, 65u8, 82u8, 71u8, 69u8, 84u8, 95u8, 77u8, 73u8, 83u8, 77u8, 65u8, 84u8, 67u8, 72u8,
];

fn patch_wlib_diag_buf(sink: view<DiagSink>, buf: mut_view<DiagBuffer>) {
    let blen = buf.len;
    if sink.len == 0 || (sink.diags as usize) == 0 || blen < 9 || (buf.ptr as usize) == 0 {
        return;
    }
    let mut has_wlib_code = false;
    let mut di: usize = 0;
    while di < sink.len {
        let dp = ((sink.diags as usize) + opts_mul_usize(di, size_of<Diagnostic>())) as *const Diagnostic;
        let cv = unsafe { (*dp).code.v };
        if (cv >= 137u32 && cv <= 141u32) || cv == 153u32 || cv == 154u32 {
            has_wlib_code = true;
            break;
        }
        di = di + 1;
    }
    if !has_wlib_code {
        return;
    }
    let mut out = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut i: usize = 0;
    let mut next_di: usize = 0;
    while i < buf.len {
        if i + 9 <= buf.len &&
           unsafe { *(buf.ptr + i + 0) == 60u8 && *(buf.ptr + i + 1) == 117u8 && *(buf.ptr + i + 2) == 110u8 &&
                    *(buf.ptr + i + 3) == 107u8 && *(buf.ptr + i + 4) == 110u8 && *(buf.ptr + i + 5) == 111u8 &&
                    *(buf.ptr + i + 6) == 119u8 && *(buf.ptr + i + 7) == 110u8 && *(buf.ptr + i + 8) == 62u8 } {
            let mut match_cv: u32 = 138u32;
            while next_di < sink.len {
                let dp = ((sink.diags as usize) + opts_mul_usize(next_di, size_of<Diagnostic>())) as *const Diagnostic;
                let cv = unsafe { (*dp).code.v };
                next_di = next_di + 1;
                if (cv >= 137u32 && cv <= 141u32) || cv == 153u32 || cv == 154u32 {
                    match_cv = cv;
                    break;
                }
            }
            if match_cv == 137u32 {
                let mut k: usize = 0;
                while k < 31 {
                    diag_buf_push_byte(mut_view(out), WLIB_INVALID_KIND_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 139u32 {
                let mut k: usize = 0;
                while k < 25 {
                    diag_buf_push_byte(mut_view(out), WLIB_LIB_NOT_FOUND_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 140u32 {
                let mut k: usize = 0;
                while k < 24 {
                    diag_buf_push_byte(mut_view(out), WLIB_DUP_EXPORT_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 141u32 {
                let mut k: usize = 0;
                while k < 21 {
                    diag_buf_push_byte(mut_view(out), WLIB_GEN_EXPORT_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 153u32 {
                let mut k: usize = 0;
                while k < 20 {
                    diag_buf_push_byte(mut_view(out), WLIB_ABI_MISMATCH_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 154u32 {
                let mut k: usize = 0;
                while k < 32 {
                    diag_buf_push_byte(mut_view(out), WLIB_TARGET_MISMATCH_CODE_NAME[k]);
                    k = k + 1;
                }
            } else {
                let mut k: usize = 0;
                while k < 19 {
                    diag_buf_push_byte(mut_view(out), WLIB_BAD_ARCHIVE_CODE_NAME[k]);
                    k = k + 1;
                }
            }
            i = i + 9;
        } else {
            diag_buf_push_byte(mut_view(out), unsafe { *(buf.ptr + i) });
            i = i + 1;
        }
    }
    if buf.cap > 0 && (buf.ptr as usize) != 0 {
        unsafe { heap_free(buf.ptr, buf.cap, 1); }
    }
    buf.ptr = out.ptr;
    buf.len = out.len;
    buf.cap = out.cap;
}

pub fn driver_flush_diagnostics(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) {
    let _ = out_buf;
    if dopts.json {
        session_render_json(mut_view(ctx.sess), mut_view(*err_buf));
        patch_unknown_intrinsic_diag_buf(view(ctx.sess.diag_sink), mut_view(*err_buf));
        patch_wlib_diag_buf(view(ctx.sess.diag_sink), mut_view(*err_buf));
    } else if session_diag_count(view(ctx.sess)) > 0 {
        session_render_human(mut_view(ctx.sess), mut_view(*err_buf));
        patch_unknown_intrinsic_diag_buf(view(ctx.sess.diag_sink), mut_view(*err_buf));
        patch_wlib_diag_buf(view(ctx.sess.diag_sink), mut_view(*err_buf));
    }
}

// =============================================================================
// 3. Command Execution (`inspect`, `check`, `run`, `build`)
// =============================================================================

fn driver_execute_inspect_ctx(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ek = dopts.emit_kind;
    let mut rc: i32 = AX_EXIT_OK;

    if ek == EMIT_TOKENS {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_LEX, mut_view(*out_buf));
        if ctx.main_fid.v != 0u32 {
            session_render_tokens_into(view(ctx.sess), view(ctx.lex_res), mut_view(*out_buf));
        }
        if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_AST {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_PARSE, mut_view(*out_buf));
        if ctx.main_fid.v != 0u32 {
            session_render_ast_into(view(ctx.sess), view(ctx.ast), FileId { v: ctx.main_fid.v }, mut_view(*out_buf));
        }
        if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_RESOLVED {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_RESOLVE, mut_view(*out_buf));
        if ctx.main_fid.v != 0u32 {
            session_render_resolved_into(
                view(ctx.sess),
                view(ctx.ast),
                view(ctx.rmap),
                FileId { v: ctx.main_fid.v },
                mut_view(*out_buf)
            );
        }
        if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_HIR {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_HIR, mut_view(*out_buf));
        if !ok && (ctx.hir.items as usize) == 0 && (ctx.ast.items as usize) != 0 {
            pipeline_stage_hir(mut_view(*ctx));
        }
        if ctx.main_fid.v != 0u32 {
            session_render_hir_into(view(ctx.sess), view(ctx.hir), FileId { v: ctx.main_fid.v }, mut_view(*out_buf));
        }
        if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_THIR {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_OWN, mut_view(*out_buf));
        if ok && ctx.main_fid.v != 0u32 {
            session_render_thir_into(
                view(ctx.sess),
                view(ctx.hir),
                view(ctx.thir),
                FileId { v: ctx.main_fid.v },
                mut_view(*out_buf)
            );
        } else if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_MIR || ek == EMIT_MIR_OPT {
        let want_opt = ek == EMIT_MIR_OPT || dopts.opt_O1;
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else if want_opt {
                if !session_opt_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    mtxt,
                    dopts.verify_each,
                    mut_view(*out_buf)
                ) {
                    rc = AX_EXIT_DIAG;
                }
            } else {
                let _ = session_verify_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    FileId { v: ctx.main_fid.v },
                    StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
                );
                let body = verify_parse_mir(
                    mtxt,
                    mut_view(ctx.thir.interner),
                    mut_view(ctx.mir_arena)
                );
                if (body as usize) == 0 {
                    rc = AX_EXIT_DIAG;
                } else {
                    unsafe {
                        mir_print(mut_view(*out_buf), view(*body));
                    }
                }
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            let mfid = FileId { v: ctx.main_fid.v };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else if want_opt {
                let _ = session_emit_mir_opt(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    view(ctx.hir),
                    mut_view(ctx.thir),
                    mfid,
                    dopts.verify_each,
                    mut_view(*out_buf)
                );
                if session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                }
            } else {
                let _ = session_emit_mir(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    view(ctx.hir),
                    mut_view(ctx.thir),
                    mfid,
                    mut_view(*out_buf)
                );
                if session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                }
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_OPTIR || ek == EMIT_MEMSSA {
        let emit_memssa = ek == EMIT_MEMSSA;
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if !ok || !optir_inspect_mir_text(
                mtxt,
                emit_memssa,
                dopts.verify_each,
                mut_view(*out_buf),
                mut_view(ctx.sess.diag_sink),
                mut_view(ctx.mir_arena)
            ) || session_has_errors(view(ctx.sess)) {
                rc = AX_EXIT_DIAG;
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            if !ok || !driver_emit_optir_file(
                mut_view(*ctx),
                emit_memssa,
                dopts.verify_each,
                mut_view(*out_buf)
            ) || session_has_errors(view(ctx.sess)) {
                rc = AX_EXIT_DIAG;
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_LIR {
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let ti_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir.interner)) };
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if ok {
                let _ = session_verify_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    FileId { v: ctx.main_fid.v },
                    StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
                );
            }
            if !ok || !session_emit_lir_mir_text_opt(
                mut_view(ctx.backend_arena),
                ti_ptr,
                mtxt,
                dopts.opt_O1,
                mut_view(*out_buf)
            ) {
                rc = AX_EXIT_DIAG;
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            let mfid = FileId { v: ctx.main_fid.v };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else {
                let _ = session_emit_lir_hir(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    mut_view(ctx.backend_arena),
                    view(ctx.hir),
                    mut_view(ctx.thir),
                    mfid,
                    true,
                    dopts.opt_O1,
                    mut_view(*out_buf)
                );
                if session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                }
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_MI {
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let ti_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir.interner)) };
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if ok {
                let _ = session_verify_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    FileId { v: ctx.main_fid.v },
                    StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
                );
            }
            if !ok || !session_emit_mi_mir_text_opt(
                mut_view(ctx.backend_arena),
                ti_ptr,
                mtxt,
                dopts.opt_O1,
                mut_view(*out_buf)
            ) {
                rc = AX_EXIT_DIAG;
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            let mfid = FileId { v: ctx.main_fid.v };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else {
                let _ = session_emit_mi_hir(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    mut_view(ctx.backend_arena),
                    view(ctx.hir),
                    mut_view(ctx.thir),
                    mfid,
                    true,
                    dopts.opt_O1,
                    mut_view(*out_buf)
                );
                if session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                }
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_MC {
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let ti_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir.interner)) };
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if ok {
                let _ = session_verify_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    FileId { v: ctx.main_fid.v },
                    StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
                );
            }
            if !ok || !session_emit_mc_mir_text_opt(
                mut_view(ctx.backend_arena),
                ti_ptr,
                mtxt,
                dopts.opt_O1,
                mut_view(*out_buf)
            ) {
                rc = AX_EXIT_DIAG;
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            let mfid = FileId { v: ctx.main_fid.v };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else if !session_emit_mc_hir(
                mut_view(ctx.sess),
                mut_view(ctx.mir_arena),
                mut_view(ctx.backend_arena),
                view(ctx.hir),
                mut_view(ctx.thir),
                mfid,
                true,
                dopts.opt_O1,
                mut_view(*out_buf)
            ) {
                rc = AX_EXIT_ICE;
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_OBJ {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
        if !ok {
            rc = AX_EXIT_DIAG;
        } else {
            let mut obj = objmodel_new();
            let ok_obj = driver_emit_objmodel(mut_view(*ctx), true, dopts.opt_O1, false, mut_view(obj));
            if !ok_obj {
                rc = AX_EXIT_ICE;
            } else {
                let mut coff_buf = coff_buf_with_capacity(1024);
                if coff_write_to_buf(view(obj), mut_view(coff_buf)) {
                    diag_buf_push_bytes(mut_view(*out_buf), coff_buf.ptr as *const u8, coff_buf.len);
                } else {
                    rc = AX_EXIT_DIAG;
                }
                coff_buf_free(mut_view(coff_buf));
            }
            objmodel_free(mut_view(obj));
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    AX_EXIT_USAGE
}

fn driver_emit_optir_file(
    ctx: mut_view<PipelineCtx>,
    emit_memssa: bool,
    verify_each: bool,
    out_buf: mut_view<DiagBuffer>
) -> bool {
    if !session_unsafe_check(mut_view(ctx.sess), view(ctx.hir), view(ctx.thir)) {
        return false;
    }
    let mfid = ctx.main_fid.v;
    let thir_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir)) as *const Thir };
    let mut it: *mut HirItem = ctx.hir.items;
    while (it as usize) != 0 {
        let it_file = unsafe { (*it).span.file.v };
        let it_kind = unsafe { (*it).kind };
        if it_kind == HIR_ITEM_FN && (mfid == 0u32 || it_file == 0u32 || it_file == mfid) {
            let body = session_own_mir_verify_fn(
                mut_view(ctx.sess),
                mut_view(ctx.mir_arena),
                it,
                view(ctx.hir),
                mut_view(ctx.thir),
                0 as *mut MonoEngine,
                true,
                0 as *mut DiagBuffer,
                0 as *mut DiagBuffer
            );
            if (body as usize) == 0 || session_has_errors(view(ctx.sess)) {
                return false;
            }
            let ob = optir_build_from_mir(
                unsafe { view(*body) },
                thir_ptr,
                mut_view(ctx.mir_arena),
                mut_view(ctx.sess.diag_sink),
                it as *const HirItem
            );
            if (ob as usize) == 0 {
                return false;
            }
            if verify_each {
                if !optir_verify_contract(unsafe { view(*ob) }) {
                    return false;
                }
                if !optir_reconstruct_mir(unsafe { view(*ob) }, unsafe { mut_view(*body) }, mut_view(ctx.mir_arena)) {
                    return false;
                }
                verify_mir(unsafe { view(*body) }, thir_ptr, mut_view(ctx.sess.diag_sink), it as *const HirItem);
                if session_has_errors(view(ctx.sess)) {
                    return false;
                }
            }
            if emit_memssa {
                memssa_print(mut_view(*out_buf), unsafe { view(*ob) });
            } else {
                optir_print(mut_view(*out_buf), unsafe { view(*ob) });
            }
        }
        it = unsafe { (*it).next };
    }
    !session_has_errors(view(ctx.sess))
}

fn pipe_str_in_arena(arena: mut_view<Arena>, off: usize, n: usize) -> StrView {
    let buf = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(buf + i) = PIPELINE_STR_TABLE[off + i]; }
        i = i + 1;
    }
    unsafe { *(buf + n) = 0u8; }
    StrView { ptr: buf as *const u8, len: n }
}

fn pipe_sv_is_main(sv: view<StrView>) -> bool {
    if sv.len != 4 {
        return false;
    }
    let mut i: usize = 0;
    while i < 4 {
        if (unsafe { *(sv.ptr + i) }) != PIPELINE_STR_TABLE[115 + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

unsafe fn pipe_hir_item_ptr_at(base: *mut *mut HirItem, idx: usize) -> *mut *mut HirItem {
    let off = opts_mul_usize(idx, size_of<*mut HirItem>());
    ((base as usize) + off) as *mut *mut HirItem
}

unsafe fn pipe_mir_body_ptr_at(base: *mut *mut MirBody, idx: usize) -> *mut *mut MirBody {
    let off = opts_mul_usize(idx, size_of<*mut MirBody>());
    ((base as usize) + off) as *mut *mut MirBody
}

fn pipe_lookup_item_fn_ty(thir: view<Thir>, item: *const HirItem) -> *const AxType {
    let pty = thir_get_item_type(thir, item);
    if (pty as usize) == 0 {
        return 0 as *const AxType;
    }
    let tid_v = unsafe { (*pty).v };
    if tid_v == 0u32 {
        return 0 as *const AxType;
    }
    type_get(view(thir.interner), TypeId { v: tid_v }) as *const AxType
}

struct PipeBranchFixup {
    fixup: u32,
    target: u32,
}

unsafe fn pipe_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = opts_mul_usize(idx, size_of<u32>());
    ((base as *mut u8) + off) as *mut u32
}

unsafe fn pipe_fixup_at(base: *mut PipeBranchFixup, idx: usize) -> *mut PipeBranchFixup {
    let off = opts_mul_usize(idx, size_of<PipeBranchFixup>());
    ((base as *mut u8) + off) as *mut PipeBranchFixup
}

fn pipe_alloc_panic_sym(arena: mut_view<Arena>, id: u32) -> StrView {
    let mut digits: [16]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut dlen: usize = 0;
    if id == 0u32 {
        digits[0] = 48u8;
        dlen = 1;
    } else {
        let mut v = id;
        while v > 0u32 {
            digits[dlen] = (48u32 + (v % 10u32)) as u8;
            v = v / 10u32;
            dlen = dlen + 1;
        }
    }
    let total = 8 + dlen;
    let dst = arena_alloc_raw(mut_view(*arena), total + 1, 1);
    let mut i: usize = 0;
    while i < 8 {
        unsafe { *(dst + i) = PIPELINE_STR_TABLE[143 + i]; }
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < dlen {
        unsafe { *(dst + 8 + j) = digits[dlen - 1 - j]; }
        j = j + 1;
    }
    unsafe { *(dst + total) = 0u8; }
    StrView { ptr: dst as *const u8, len: total }
}

fn x64_mi_is_sub64_atomic(opc: u32) -> bool {
    opc == X64_MI_XCHG || opc == X64_MI_LOCK_XADD || opc == X64_MI_ATOMIC_RMW_LOOP || opc == X64_MI_LOCK_CMPXCHG
}

fn driver_emit_build_mi_body_obj(
    arena: mut_view<Arena>,
    text_sec_id: SectionId,
    rdata_sec_id: SectionId,
    body: view<X64MIBody>,
    layout: view<X64FrameLayout>,
    obj: mut_view<ObjModel>,
    panic_counter: mut_view<u32>
) {
    let text_id_v = text_sec_id.v;
    let rdata_id_v = rdata_sec_id.v;
    let text_sec0 = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
    x64_frame_emit_prologue(unsafe { mut_view(*text_sec0) }, layout);
    if body.bb_count == 0 {
        return;
    }

    let bb_offsets = arena_alloc_raw(
        mut_view(*arena),
        opts_mul_usize(body.bb_count, size_of<u32>()),
        align_of<u32>()
    ) as *mut u32;

    let mut fixup_cap: usize = 16;
    let mut b0: usize = 0;
    while b0 < body.bb_count {
        let mbb0 = unsafe { x64_mi_bb_at(body.bbs, b0) };
        let mut inst0 = unsafe { (*mbb0).first_inst };
        while (inst0 as usize) != 0 {
            let opc0 = unsafe { (*inst0).opcode };
            if opc0 == X64_MI_JMP || opc0 == X64_MI_JCC || opc0 == X64_MI_ASSERT {
                fixup_cap = fixup_cap + 1;
            }
            inst0 = unsafe { (*inst0).next };
        }
        b0 = b0 + 1;
    }

    let fixups = arena_alloc_raw(
        mut_view(*arena),
        opts_mul_usize(fixup_cap, size_of<PipeBranchFixup>()),
        align_of<PipeBranchFixup>()
    ) as *mut PipeBranchFixup;
    let mut num_fixups: usize = 0;

    let mut b: usize = 0;
    while b < body.bb_count {
        let tsec_bb = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
        unsafe {
            *pipe_u32_at(bb_offsets, b) = (*tsec_bb).bytes_len as u32;
        }
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let opc = unsafe { (*inst).opcode };
            let tsec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
            if opc == X64_MI_JMP {
                let tgt = unsafe { (*inst).ops[0usize].imm as u32 };
                let fx_off = unsafe { ((*tsec).bytes_len + 1) as u32 };
                x64_jmp(unsafe { mut_view(*tsec) }, 0);
                let fp = unsafe { pipe_fixup_at(fixups, num_fixups) };
                unsafe {
                    (*fp).fixup = fx_off;
                    (*fp).target = tgt;
                }
                num_fixups = num_fixups + 1;
            } else if opc == X64_MI_JCC {
                let cc = unsafe { (*inst).ops[0usize].imm as u8 };
                let tgt = unsafe { (*inst).ops[1usize].imm as u32 };
                let fx_off = unsafe { ((*tsec).bytes_len + 2) as u32 };
                x64_jcc(unsafe { mut_view(*tsec) }, cc, 0);
                let fp = unsafe { pipe_fixup_at(fixups, num_fixups) };
                unsafe {
                    (*fp).fixup = fx_off;
                    (*fp).target = tgt;
                }
                num_fixups = num_fixups + 1;
            } else if opc == X64_MI_ASSERT {
                let tgt = unsafe { (*inst).ops[0usize].imm as u32 };
                let fx_off = unsafe { ((*tsec).bytes_len + 2) as u32 };
                x64_jcc(unsafe { mut_view(*tsec) }, CC_E, 0);
                let fp = unsafe { pipe_fixup_at(fixups, num_fixups) };
                unsafe {
                    (*fp).fixup = fx_off;
                    (*fp).target = tgt;
                }
                num_fixups = num_fixups + 1;

                let rdata_sec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: rdata_id_v });
                let str_offset = unsafe { (*rdata_sec).bytes_len as u64 };
                let pfx_sv = pipe_str_in_arena(mut_view(*arena), 108, 7);
                unsafe {
                    section_add_bytes(mut_view(*rdata_sec), pfx_sv.ptr, pfx_sv.len);
                }
                let raw_msg = unsafe { (*inst).msg };
                let mut raw_msg_len = unsafe { (*inst).msg_len };
                if (raw_msg as usize) != 0 && raw_msg_len > 0 {
                    unsafe {
                        section_add_bytes(mut_view(*rdata_sec), raw_msg, raw_msg_len);
                    }
                } else {
                    let def_msg = pipe_str_in_arena(mut_view(*arena), 162, 16);
                    raw_msg_len = 16;
                    unsafe {
                        section_add_bytes(mut_view(*rdata_sec), def_msg.ptr, def_msg.len);
                    }
                }
                section_add_byte(unsafe { mut_view(*rdata_sec) }, 10u8);
                let fmt_len = (7 + raw_msg_len + 1) as u32;
                section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);

                let pid = *panic_counter;
                *panic_counter = pid + 1u32;
                let panic_sym_sv = pipe_alloc_panic_sym(mut_view(*arena), pid);
                let str_sym = objmodel_add_symbol_bytes(
                    mut_view(*obj),
                    panic_sym_sv.ptr,
                    panic_sym_sv.len,
                    SectionId { v: rdata_id_v },
                    str_offset,
                    (fmt_len + 1u32) as u64,
                    SYM_LOCAL
                );
                let panic_fn_sv = pipe_str_in_arena(mut_view(*arena), 151, 11);
                let panic_fn_sym = objmodel_add_symbol_bytes(
                    mut_view(*obj),
                    panic_fn_sv.ptr,
                    panic_fn_sv.len,
                    SectionId { v: 0u32 },
                    0u64,
                    0u64,
                    SYM_EXTERNAL
                );
                let tsec2 = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
                x64_emit_panic_sequence(
                    unsafe { mut_view(*tsec2) },
                    str_sym,
                    fmt_len,
                    panic_fn_sym
                );
            } else {
                unsafe {
                    if opc != X64_MI_MOV && opc != X64_MI_CMP && !x64_mi_is_sub64_atomic(opc) {
                        (*inst).size = 8u8;
                    } else if (*inst).size == 0u8 {
                        (*inst).size = 8u8;
                    }
                    x64_encode_mi_inst_obj(mut_view(*tsec), view(*inst), layout, mut_view(*obj));
                }
            }
            inst = unsafe { (*inst).next };
        }
        b = b + 1;
    }

    let tsec_end = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
    let mut f: usize = 0;
    while f < num_fixups {
        let fp = unsafe { pipe_fixup_at(fixups, f) };
        let fx_off = unsafe { (*fp).fixup };
        let tgt_bb = unsafe { (*fp).target as usize };
        if tgt_bb < body.bb_count {
            let tgt_byte_off = unsafe { *pipe_u32_at(bb_offsets, tgt_bb) };
            x64_patch_rel32(unsafe { mut_view(*tsec_end) }, fx_off, tgt_byte_off);
        }
        f = f + 1;
    }
}

// Emits COFF `ObjModel` for either:
// - `is_build_mode == false`: `axiom0 inspect --emit=obj <file>` (`emit_obj.c`), using 8-byte MI operand width.
// - `is_build_mode == true`: `axiom0 build` (`build_native/build.c`), running drop elaboration + optional -O1,
//   emitting incoming parameter ABI moves, branch fixups, panic blocks, and aliasing `main` -> `ax_main`
//   immediately after `main` (`build.c:606`).
// Builds the MIR of one function item for the object writer: MIR build, constant promotion, drop elaboration
// plus ownership re-verification, optional -O1 and call-type resolution. Null when the item has no body.
fn pipe_build_item_body(
    ctx: mut_view<PipelineCtx>,
    run_drop_elab: bool,
    run_opt: bool,
    it: *mut HirItem,
    thir_ptr: *mut Thir,
    hir_ptr: *const HirFile,
    str_in_ptr: *mut StrInterner,
    db_ptr: *mut SourceDatabase
) -> *mut MirBody {
    let pre = mir_prebuilt_get(it as *const HirItem);
    if (pre as usize) != 0 {
        // Lowered `async fn` constructor / synthesized `poll` (T088): shared by several items, so
        // prepared once. Ownership was verified on the source body before lowering.
        if !(unsafe { (*pre).backend_prepared }) {
            unsafe { (*pre).backend_prepared = true; }
            backend_promote_const_aggregates(unsafe { mut_view(*pre) }, view(ctx.thir));
            if run_drop_elab {
                mir_drop_elaborate(
                    unsafe { mut_view(*pre) },
                    mut_view(ctx.thir),
                    view(ctx.hir),
                    db_ptr,
                    view(ctx.sess.interner),
                    mut_view(ctx.mir_arena)
                );
            }
            if run_opt {
                opt_run_in_arena(
                    unsafe { mut_view(*pre) },
                    thir_ptr as *const Thir,
                    mut_view(ctx.mir_arena),
                    mut_view(ctx.sess.diag_sink),
                    false,
                    it as *const HirItem
                );
            }
            backend_resolve_body_call_types(unsafe { mut_view(*pre) }, view(ctx.hir), view(ctx.thir));
        }
        return pre;
    }
    let body = mir_build_fn(
        mut_view(ctx.mir_arena),
        it,
        thir_ptr,
        hir_ptr,
        str_in_ptr,
        db_ptr,
        0 as *mut MonoEngine
    );
    if (body as usize) == 0 {
        return body;
    }
    backend_promote_const_aggregates(unsafe { mut_view(*body) }, view(ctx.thir));
    if run_drop_elab {
        mir_drop_elaborate(
            unsafe { mut_view(*body) },
            mut_view(ctx.thir),
            view(ctx.hir),
            db_ptr,
            view(ctx.sess.interner),
            mut_view(ctx.mir_arena)
        );
        if !session_has_errors(view(ctx.sess)) {
            verify_mir_own(
                unsafe { view(*body) },
                thir_ptr as *const Thir,
                mut_view(ctx.sess.diag_sink),
                it as *const HirItem
            );
        }
    }
    if run_opt {
        opt_run_in_arena(
            unsafe { mut_view(*body) },
            thir_ptr as *const Thir,
            mut_view(ctx.mir_arena),
            mut_view(ctx.sess.diag_sink),
            false,
            it as *const HirItem
        );
    }
    backend_resolve_body_call_types(unsafe { mut_view(*body) }, view(ctx.hir), view(ctx.thir));
    body
}

// True when `m` is a member of a TRAIT item of the file (a default-method body lives there, not in `hir.items`).
fn pipe_is_trait_member(items: *mut HirItem, m: *mut HirItem) -> bool {
    let mut t: *mut HirItem = items;
    while (t as usize) != 0 {
        if (unsafe { (*t).kind }) == HIR_ITEM_TRAIT {
            let mut tm: *mut HirItem = unsafe { (*t).members };
            while (tm as usize) != 0 {
                if (tm as usize) == (m as usize) {
                    return true;
                }
                tm = unsafe { (*tm).next };
            }
        }
        t = unsafe { (*t).next };
    }
    false
}

fn pipe_item_in_buf(buf: *mut *mut HirItem, n: usize, m: *mut HirItem) -> bool {
    let mut i: usize = 0;
    while i < n {
        if (unsafe { *pipe_hir_item_ptr_at(buf, i) }) == m {
            return true;
        }
        i = i + 1;
    }
    false
}

fn pipe_sv_has_dollar(sv: view<StrView>) -> bool {
    let mut i: usize = 0;
    while i < sv.len {
        if (unsafe { *(sv.ptr + i) }) == 36u8 {
            return true;
        }
        i = i + 1;
    }
    false
}

fn pipe_sv_is_link_attr(sv: view<StrView>) -> bool {
    if sv.len != 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 108u8 && *(sv.ptr + 1) == 105u8 &&
        *(sv.ptr + 2) == 110u8 && *(sv.ptr + 3) == 107u8
    }
}

fn pipe_sv_is_export_attr(sv: view<StrView>) -> bool {
    if sv.len != 6 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 101u8 && *(sv.ptr + 1) == 120u8 &&
        *(sv.ptr + 2) == 112u8 && *(sv.ptr + 3) == 111u8 &&
        *(sv.ptr + 4) == 114u8 && *(sv.ptr + 5) == 116u8
    }
}

fn pipe_item_get_link_arg(it: *const HirItem, interner: view<StrInterner>) -> StrView {
    let mut attr: *mut HirAttr = unsafe { (*it).attrs };
    while (attr as usize) != 0 {
        let an = interner_get(interner, unsafe { (*attr).name });
        if pipe_sv_is_link_attr(view(an)) {
            let args: *mut HirAttrArg = unsafe { (*attr).args };
            if (args as usize) != 0 {
                let expr: *mut HirExpr = unsafe { (*args).expr };
                if (expr as usize) != 0 && (unsafe { (*expr).kind }) == HIR_EXPR_LITERAL {
                    let lptr = unsafe { (*expr).literal.str_ptr };
                    let llen = unsafe { (*expr).literal.str_len };
                    if llen > 0 && (lptr as usize) != 0 {
                        return StrView { ptr: lptr, len: llen };
                    }
                }
            }
        }
        attr = unsafe { (*attr).next };
    }
    sv_empty()
}

fn pipe_item_has_link_attr(it: *const HirItem, interner: view<StrInterner>) -> bool {
    let arg = pipe_item_get_link_arg(it, interner);
    arg.len > 0
}

fn pipe_item_get_export_info(
    it: *const HirItem,
    interner: view<StrInterner>,
    has_export: mut_view<bool>
) -> StrView {
    *has_export = false;
    let mut attr: *mut HirAttr = unsafe { (*it).attrs };
    while (attr as usize) != 0 {
        let an = interner_get(interner, unsafe { (*attr).name });
        if pipe_sv_is_export_attr(view(an)) {
            *has_export = true;
            let args: *mut HirAttrArg = unsafe { (*attr).args };
            if (args as usize) != 0 {
                let expr: *mut HirExpr = unsafe { (*args).expr };
                if (expr as usize) != 0 && (unsafe { (*expr).kind }) == HIR_EXPR_LITERAL {
                    let lptr = unsafe { (*expr).literal.str_ptr };
                    let llen = unsafe { (*expr).literal.str_len };
                    if llen > 0 && (lptr as usize) != 0 {
                        return StrView { ptr: lptr, len: llen };
                    }
                }
            }
            return sv_empty();
        }
        attr = unsafe { (*attr).next };
    }
    sv_empty()
}

fn pipe_is_unlinked_extern_c_fn(
    items_head: *mut HirItem,
    interner: view<StrInterner>,
    bare_ptr: *const u8,
    bare_len: usize
) -> bool {
    let bare_sv = StrView { ptr: bare_ptr, len: bare_len };
    let mut it: *mut HirItem = items_head;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN &&
           (unsafe { (*it).abi.v }) != 0u32 &&
           (unsafe { (*it).body as usize }) == 0 {
            let fn_sv = interner_get(interner, unsafe { (*it).name });
            if sv_eq(view(fn_sv), view(bare_sv)) && !pipe_item_has_link_attr(it as *const HirItem, interner) {
                return true;
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

unsafe fn pipe_obj_symbol_at(base: *mut ObjSymbol, idx: usize) -> *mut ObjSymbol {
    ((base as usize) + opts_mul_usize(idx, size_of<ObjSymbol>())) as *mut ObjSymbol
}

// AXS-WLIB-030: `extern "C" fn foo(...)` without `@link` must emit bare `foo` in COFF objects
// so static libraries and short-import libraries can satisfy it directly.
fn pipe_strip_unlinked_extern_c_prefixes(ctx: view<PipelineCtx>, obj: mut_view<ObjModel>) {
    let k32_pfx: [13]u8 = [
        75u8, 69u8, 82u8, 78u8, 69u8, 76u8, 51u8, 50u8, 46u8, 100u8, 108u8, 108u8, 36u8,
    ];
    let mut i: usize = 0;
    while i < obj.symbols_len {
        let sym = unsafe { pipe_obj_symbol_at(obj.symbols, i) };
        let bind = unsafe { (*sym).linkage };
        let nlen = unsafe { (*sym).name_len };
        let nptr = unsafe { (*sym).name as *mut u8 };
        if bind == SYM_EXTERNAL && nlen > 13 && (nptr as usize) != 0 {
            let mut is_k32 = true;
            let mut p: usize = 0;
            while p < 13 {
                if (unsafe { *(nptr + p) }) != k32_pfx[p] {
                    is_k32 = false;
                    break;
                }
                p = p + 1;
            }
            if is_k32 {
                let bare_ptr = unsafe { (nptr as *const u8) + 13 };
                let bare_len = nlen - 13;
                if pipe_is_unlinked_extern_c_fn(ctx.hir.items, view(ctx.sess.interner), bare_ptr, bare_len) {
                    let mut k: usize = 0;
                    while k < bare_len {
                        unsafe { *(nptr + k) = *(nptr + 13 + k); }
                        k = k + 1;
                    }
                    unsafe {
                        *(nptr + bare_len) = 0u8;
                        (*sym).name_len = bare_len;
                    }
                }
            }
        }
        i = i + 1;
    }
}

fn pipe_sv_is_entry_attr(sv: view<StrView>) -> bool {
    if sv.len != 5 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 101u8 && *(sv.ptr + 1) == 110u8 &&
        *(sv.ptr + 2) == 116u8 && *(sv.ptr + 3) == 114u8 &&
        *(sv.ptr + 4) == 121u8
    }
}

fn pipe_item_has_entry_attr(it: *const HirItem, interner: view<StrInterner>) -> bool {
    let mut attr: *mut HirAttr = unsafe { (*it).attrs };
    while (attr as usize) != 0 {
        let an = interner_get(interner, unsafe { (*attr).name });
        if pipe_sv_is_entry_attr(view(an)) {
            return true;
        }
        attr = unsafe { (*attr).next };
    }
    false
}

fn pipe_is_mono_clone(head: *mut MonoInstance, target: *const HirItem) -> bool {
    let mut inst: *mut MonoInstance = head;
    while (inst as usize) != 0 {
        if ((unsafe { (*inst).new_item }) as usize) == (target as usize) &&
           ((unsafe { (*inst).orig_item }) as usize) != (target as usize) {
            return true;
        }
        inst = unsafe { (*inst).next };
    }
    false
}

fn pipe_report_generic_export(sink: mut_view<DiagSink>, sp: Span) {
    // "generic function cannot be exported" (35 bytes)
    let msg: [36]u8 = [
        103u8, 101u8, 110u8, 101u8, 114u8, 105u8, 99u8, 32u8, 102u8, 117u8, 110u8, 99u8,
        116u8, 105u8, 111u8, 110u8, 32u8, 99u8, 97u8, 110u8, 110u8, 111u8, 116u8, 32u8,
        98u8, 101u8, 32u8, 101u8, 120u8, 112u8, 111u8, 114u8, 116u8, 101u8, 100u8, 0u8,
    ];
    let pmsg = unsafe { address_of(msg[0]) };
    let d = Diagnostic {
        code: DiagCode { v: AX_FFI_GENERIC_EXPORT },
        severity: DiagSeverity.Error,
        message: StrView { ptr: pmsg, len: 35 },
        primary: sp,
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(*sink), view(d));
}

fn pipe_report_duplicate_export(sink: mut_view<DiagSink>, sp: Span, sym_sv: view<StrView>) {
    // "duplicate export: " (18 bytes)
    let prefix: [18]u8 = [
        100u8, 117u8, 112u8, 108u8, 105u8, 99u8, 97u8, 116u8, 101u8, 32u8,
        101u8, 120u8, 112u8, 111u8, 114u8, 116u8, 58u8, 32u8,
    ];
    let key_bytes: [7]u8 = [115u8, 121u8, 109u8, 98u8, 111u8, 108u8, 0u8]; // "symbol"
    let p_prefix = unsafe { address_of(prefix[0]) };
    let p_key = unsafe { address_of(key_bytes[0]) };
    let mut buf = coff_buf_with_capacity(18 + sym_sv.len + 1);
    coff_buf_put_bytes(mut_view(buf), p_prefix, 18);
    coff_buf_put_bytes(mut_view(buf), sym_sv.ptr, sym_sv.len);
    let msg_len = buf.len;
    coff_buf_put_u8(mut_view(buf), 0u8);
    let mut entry: [1]DiagDataEntry = [DiagDataEntry {
        key: StrView { ptr: p_key, len: 6 },
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: StrView { ptr: sym_sv.ptr, len: sym_sv.len },
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0,
        },
    }];
    let p_entry = unsafe { address_of(entry[0]) as *mut DiagDataEntry };
    let d = Diagnostic {
        code: DiagCode { v: AX_LINK_DUPLICATE_EXPORT },
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf.ptr as *const u8, len: msg_len },
        primary: sp,
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: p_entry,
        data_count: 1,
    };
    diag_sink_report(mut_view(*sink), view(d));
    coff_buf_free(mut_view(buf));
}

fn pipe_is_impl_member_clone(items_head: *mut HirItem, target: *const HirItem) -> bool {
    if (target as usize) == 0 {
        return false;
    }
    let tk = unsafe { (*target).kind };
    let tsym_v = unsafe { (*target).symbol.v };
    let tsp = unsafe { (*target).span };
    let mut it: *mut HirItem = items_head;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                if (m as usize) != (target as usize) && (unsafe { (*m).kind }) == tk {
                    let msym_v = unsafe { (*m).symbol.v };
                    if tsym_v != 0u32 && msym_v == tsym_v {
                        return true;
                    }
                    if tsym_v == 0u32 && msym_v == 0u32 {
                        let msp = unsafe { (*m).span };
                        if msp.file.v == tsp.file.v && msp.start == tsp.start && msp.end == tsp.end {
                            return true;
                        }
                    }
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

fn pipe_other_fn_uses_name(
    items_buf: *const *mut HirItem,
    fn_count: usize,
    self_item: *const HirItem,
    interner: view<StrInterner>,
    target_sv: view<StrView>
) -> bool {
    let mut i: usize = 0;
    while i < fn_count {
        let other = unsafe { *pipe_hir_item_ptr_at(items_buf as *mut *mut HirItem, i) };
        if (other as usize) != 0 && (other as usize) != (self_item as usize) {
            let oname_v = unsafe { (*other).name.v };
            if oname_v != 0u32 {
                let osv = interner_get(interner, StrId { v: oname_v });
                if sv_eq(view(osv), target_sv) {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    false
}

fn pipe_validate_export_item(
    ctx: mut_view<PipelineCtx>,
    it: *const HirItem,
    in_impl: bool,
    parent_is_generic: bool,
    seen_sv: *mut StrView,
    seen_n: mut_view<usize>,
    cap: usize
) {
    let mut has_export: bool = false;
    let export_sv = pipe_item_get_export_info(
        it,
        view(ctx.sess.interner),
        mut_view(has_export)
    );
    if !has_export {
        return;
    }
    if pipe_is_mono_clone(ctx.mono.instances_head, it) {
        return;
    }
    if !in_impl && pipe_is_impl_member_clone(ctx.hir.items, it) {
        return;
    }
    let gparams = unsafe { (*it).generic_params };
    let item_is_generic: bool = parent_is_generic ||
        ((gparams as usize) != 0 && (unsafe { (*gparams).params as usize }) != 0);
    if item_is_generic {
        pipe_report_generic_export(mut_view(ctx.sess.diag_sink), unsafe { (*it).span });
        return;
    }
    let ext_sv = if export_sv.len > 0 {
        export_sv
    } else {
        interner_get(view(ctx.sess.interner), unsafe { (*it).name })
    };
    if ext_sv.len == 0 {
        return;
    }
    let mut dup: bool = false;
    let mut k: usize = 0;
    while k < *seen_n {
        let prev = sv_slot_get(seen_sv as *const StrView, k);
        if sv_eq(view(prev), view(ext_sv)) {
            dup = true;
            break;
        }
        k = k + 1;
    }
    if dup {
        pipe_report_duplicate_export(
            mut_view(ctx.sess.diag_sink),
            unsafe { (*it).span },
            view(ext_sv)
        );
    } else if *seen_n < cap {
        sv_slot_set(seen_sv, *seen_n, view(ext_sv));
        *seen_n = *seen_n + 1;
    }
}

fn pipe_validate_exports(ctx: mut_view<PipelineCtx>) {
    let mut cap: usize = 0;
    let mut it0: *mut HirItem = ctx.hir.items;
    while (it0 as usize) != 0 {
        cap = cap + 1;
        if (unsafe { (*it0).kind }) == HIR_ITEM_IMPL {
            let mut m0: *mut HirItem = unsafe { (*it0).members };
            while (m0 as usize) != 0 {
                cap = cap + 1;
                m0 = unsafe { (*m0).next };
            }
        }
        it0 = unsafe { (*it0).next };
    }
    if cap == 0 {
        return;
    }
    let seen_sv = arena_alloc_raw(
        mut_view(ctx.hir_arena),
        opts_mul_usize(cap, size_of<StrView>()),
        align_of<StrView>()
    ) as *mut StrView;
    let mut seen_n: usize = 0;

    let mut it: *mut HirItem = ctx.hir.items;
    while (it as usize) != 0 {
        pipe_validate_export_item(mut_view(*ctx), it as *const HirItem, false, false, seen_sv, mut_view(seen_n), cap);
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
            let igp = unsafe { (*it).generic_params };
            let impl_is_gen: bool = (igp as usize) != 0 && (unsafe { (*igp).params as usize }) != 0;
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                pipe_validate_export_item(mut_view(*ctx), m as *const HirItem, true, impl_is_gen, seen_sv, mut_view(seen_n), cap);
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
}

fn pipe_append_drectve_export(
    buf: mut_view<CoffBuf>,
    ext_sv: view<StrView>,
    int_sv: view<StrView>,
    is_data: bool
) {
    if ext_sv.len == 0 || (ext_sv.ptr as usize) == 0 {
        return;
    }
    // " -export:" (9 bytes)
    let pfx: [9]u8 = [32u8, 45u8, 101u8, 120u8, 112u8, 111u8, 114u8, 116u8, 58u8];
    let p_pfx = unsafe { address_of(pfx[0]) };
    coff_buf_put_bytes(mut_view(*buf), p_pfx, 9);
    coff_buf_put_bytes(mut_view(*buf), ext_sv.ptr, ext_sv.len);
    if int_sv.len > 0 && (int_sv.ptr as usize) != 0 && !sv_eq(ext_sv, int_sv) {
        coff_buf_put_u8(mut_view(*buf), 61u8); // '='
        coff_buf_put_bytes(mut_view(*buf), int_sv.ptr, int_sv.len);
    }
    if is_data {
        let sfx: [5]u8 = [44u8, 100u8, 97u8, 116u8, 97u8]; // ",data"
        let p_sfx = unsafe { address_of(sfx[0]) };
        coff_buf_put_bytes(mut_view(*buf), p_sfx, 5);
    }
}

fn pipe_emit_dll_entry_alias(
    arena: mut_view<Arena>,
    fn_ty: *const AxType,
    ti: view<TypeInterner>,
    obj: mut_view<ObjModel>,
    text_sec_id: SectionId,
    func_start: u64,
    func_size: u64
) {
    let is_3arg: bool = (fn_ty as usize) != 0 && (unsafe { (*fn_ty).param_count }) >= 3;
    let mut ret_kind: u32 = 0u32; // 0 = unit, 1 = bool, 2 = i32
    if (fn_ty as usize) != 0 {
        let rt_v = unsafe { (*fn_ty).ret_type.v };
        if rt_v != 0u32 {
            let rty = type_get(ti, TypeId { v: rt_v });
            if (rty as usize) != 0 {
                let rk = unsafe { (*rty).kind };
                if rk == TY_UNIT {
                    ret_kind = 0u32;
                } else if rk == TY_BOOL {
                    ret_kind = 1u32;
                } else {
                    ret_kind = 2u32;
                }
            }
        }
    }
    // "__ax_dll_entry_" (15 bytes)
    let pfx: [15]u8 = [
        95u8, 95u8, 97u8, 120u8, 95u8, 100u8, 108u8, 108u8,
        95u8, 101u8, 110u8, 116u8, 114u8, 121u8, 95u8,
    ];
    let sfx_len: usize = if ret_kind == 2u32 { 3 } else { 4 };
    let total: usize = 17 + sfx_len;
    let dst = arena_alloc_raw(mut_view(*arena), total + 1, 1);
    let mut i: usize = 0;
    while i < 15 {
        unsafe { *(dst + i) = pfx[i]; }
        i = i + 1;
    }
    unsafe {
        *(dst + 15) = if is_3arg { 51u8 } else { 48u8 }; // '3' or '0'
        *(dst + 16) = 95u8; // '_'
        if ret_kind == 0u32 {
            // "unit"
            *(dst + 17) = 117u8;
            *(dst + 18) = 110u8;
            *(dst + 19) = 105u8;
            *(dst + 20) = 116u8;
        } else if ret_kind == 1u32 {
            // "bool"
            *(dst + 17) = 98u8;
            *(dst + 18) = 111u8;
            *(dst + 19) = 111u8;
            *(dst + 20) = 108u8;
        } else {
            // "i32"
            *(dst + 17) = 105u8;
            *(dst + 18) = 51u8;
            *(dst + 19) = 50u8;
        }
        *(dst + total) = 0u8;
    }
    let _ = objmodel_add_symbol_bytes(
        mut_view(*obj),
        dst as *const u8,
        total,
        text_sec_id,
        func_start,
        func_size,
        SYM_GLOBAL
    );
}

fn pipe_alloc_exp_str_sym(arena: mut_view<Arena>, id: u32) -> StrView {
    // ".Lexp_str." (10 bytes) + digits
    let pfx: [10]u8 = [46u8, 76u8, 101u8, 120u8, 112u8, 95u8, 115u8, 116u8, 114u8, 46u8];
    let mut digits: [12]u8 = [0u8; 12];
    let mut dlen: usize = 0;
    if id == 0u32 {
        digits[0] = 48u8;
        dlen = 1;
    } else {
        let mut v = id;
        while v > 0u32 {
            digits[dlen] = (48u32 + (v % 10u32)) as u8;
            v = v / 10u32;
            dlen = dlen + 1;
        }
    }
    let total = 10 + dlen;
    let dst = arena_alloc_raw(mut_view(*arena), total + 1, 1);
    let mut i: usize = 0;
    while i < 10 {
        unsafe { *(dst + i) = pfx[i]; }
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < dlen {
        unsafe { *(dst + 10 + j) = digits[dlen - 1 - j]; }
        j = j + 1;
    }
    unsafe { *(dst + total) = 0u8; }
    StrView { ptr: dst as *const u8, len: total }
}

fn pipe_any_hir_fn_uses_name(
    items_head: *mut HirItem,
    interner: view<StrInterner>,
    target_sv: view<StrView>
) -> bool {
    let mut it: *mut HirItem = items_head;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN {
            let gparams = unsafe { (*it).generic_params };
            let is_gen: bool = (gparams as usize) != 0 && (unsafe { (*gparams).params as usize }) != 0;
            if !is_gen {
                let fn_name_v = unsafe { (*it).name.v };
                if fn_name_v != 0u32 {
                    let fsv = interner_get(interner, StrId { v: fn_name_v });
                    if sv_eq(view(fsv), target_sv) {
                        return true;
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

fn pipe_alloc_exp_const_sym(
    arena: mut_view<Arena>,
    obj: view<ObjModel>,
    ext_sv: view<StrView>
) -> StrView {
    // "__ax_const$" (11 bytes) + ext_sv
    let pfx: [11]u8 = [
        95u8, 95u8, 97u8, 120u8, 95u8,
        99u8, 111u8, 110u8, 115u8, 116u8, 36u8,
    ];
    let ext_len = ext_sv.len;
    let ext_ptr = ext_sv.ptr;
    let base_len: usize = 11 + ext_len;
    let dst = arena_alloc_raw(mut_view(*arena), base_len + 1, 1);
    let mut i: usize = 0;
    while i < 11 {
        unsafe { *(dst + i) = pfx[i]; }
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < ext_len {
        unsafe { *(dst + 11 + j) = *(ext_ptr + j); }
        j = j + 1;
    }
    unsafe { *(dst + base_len) = 0u8; }
    if objmodel_find_symbol_bytes(obj, dst as *const u8, base_len).v == 0u32 {
        return StrView { ptr: dst as *const u8, len: base_len };
    }
    let mut salt: u32 = 1u32;
    while salt < 1000000u32 {
        let mut digits: [12]u8 = [0u8; 12];
        let mut dlen: usize = 0;
        let mut v = salt;
        while v > 0u32 {
            digits[dlen] = (48u32 + (v % 10u32)) as u8;
            v = v / 10u32;
            dlen = dlen + 1;
        }
        let s_total = base_len + 1 + dlen;
        let s_dst = arena_alloc_raw(mut_view(*arena), s_total + 1, 1);
        let mut k: usize = 0;
        while k < base_len {
            unsafe { *(s_dst + k) = *(dst + k); }
            k = k + 1;
        }
        unsafe { *(s_dst + base_len) = 36u8; }
        let mut d: usize = 0;
        while d < dlen {
            unsafe { *(s_dst + base_len + 1 + d) = digits[dlen - 1 - d]; }
            d = d + 1;
        }
        unsafe { *(s_dst + s_total) = 0u8; }
        if objmodel_find_symbol_bytes(obj, s_dst as *const u8, s_total).v == 0u32 {
            return StrView { ptr: s_dst as *const u8, len: s_total };
        }
        salt = salt + 1u32;
    }
    StrView { ptr: dst as *const u8, len: base_len }
}

fn pipe_tls_emit_fn_reloc_at(
    ctx: mut_view<PipelineCtx>,
    obj: mut_view<ObjModel>,
    tls_sec_id_v: u32,
    fn_sym_v: u32,
    reloc_off: u32
) {
    if fn_sym_v == 0u32 || (ctx.hir.items as usize) == 0 { return; }
    let mut cur: *mut HirItem = ctx.hir.items;
    let mut fn_name_id: u32 = 0u32;
    while (cur as usize) != 0 {
        if (unsafe { (*cur).symbol.v }) == fn_sym_v {
            fn_name_id = unsafe { (*cur).name.v };
            break;
        }
        cur = unsafe { (*cur).next };
    }
    if fn_name_id == 0u32 { return; }
    let fname_sv = interner_get(view(ctx.sess.interner), StrId { v: fn_name_id });
    if fname_sv.len == 0 { return; }

    let mut fn_obj_sym = objmodel_find_symbol_bytes(view(*obj), fname_sv.ptr, fname_sv.len);
    if fn_obj_sym.v == 0u32 {
        fn_obj_sym = objmodel_add_symbol_bytes(
            mut_view(*obj),
            fname_sv.ptr,
            fname_sv.len,
            SectionId { v: 0u32 },
            0u64,
            0u64,
            SYM_GLOBAL
        );
    }
    let tls_sec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: tls_sec_id_v });
    section_add_reloc(
        unsafe { mut_view(*tls_sec) },
        reloc_off,
        RELOC_X86_64_64,
        fn_obj_sym,
        0i64
    );
}

fn pipe_tls_emit_fn_reloc(
    ctx: mut_view<PipelineCtx>,
    obj: mut_view<ObjModel>,
    tls_sec_id_v: u32,
    fn_sym_v: u32
) {
    let tls_sec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: tls_sec_id_v });
    let off = unsafe { (*tls_sec).bytes_len as u32 };
    pipe_tls_emit_fn_reloc_at(mut_view(*ctx), mut_view(*obj), tls_sec_id_v, fn_sym_v, off);
}

fn pipe_emit_one_tls_item(
    ctx: mut_view<PipelineCtx>,
    it: *mut HirItem,
    obj: mut_view<ObjModel>,
    tls_sec_id_v: u32
) {
    let sym_v = unsafe { (*it).symbol.v };
    let mut sz: usize = 8;
    let mut al: usize = 8;
    let p_ity = thir_get_item_type(view(ctx.thir), it as *const HirItem);
    if (p_ity as usize) != 0 {
        let ity_v = unsafe { (*p_ity).v };
        sz = type_size(TypeId { v: ity_v }, view(ctx.thir.interner)) as usize;
        al = type_align(TypeId { v: ity_v }, view(ctx.thir.interner)) as usize;
    }
    if sz == 0 { sz = 8; }
    if al == 0 { al = 8; }

    let tls_sec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: tls_sec_id_v });
    while ((unsafe { (*tls_sec).bytes_len }) % al) != 0 {
        section_add_byte(unsafe { mut_view(*tls_sec) }, 0u8);
    }
    let sym_offset = unsafe { (*tls_sec).bytes_len as u64 };

    let cval = sym_constmap_get(view(ctx.thir.symbol_consts), SymbolId { v: sym_v });
    if (cval as usize) != 0 && (unsafe { (*cval).kind }) == CONST_AGGREGATE && (unsafe { (*cval).agg_data as usize }) != 0 {
        let agg_ptr = unsafe { (*cval).agg_data };
        let agg_sz = unsafe { (*cval).agg_size };
        let fn_sym_v = unsafe { (*cval).alloc_id };
        if fn_sym_v != 0u32 {
            pipe_tls_emit_fn_reloc(mut_view(*ctx), mut_view(*obj), tls_sec_id_v, fn_sym_v);
        }
        if agg_sz >= 16 {
            let drop_sym_v = unsafe { *((agg_ptr + 8) as *const u64) as u32 };
            if drop_sym_v != 0u32 {
                pipe_tls_emit_fn_reloc_at(mut_view(*ctx), mut_view(*obj), tls_sec_id_v, drop_sym_v, (sym_offset + 8) as u32);
            }
        }
        section_add_bytes(unsafe { mut_view(*tls_sec) }, agg_ptr as *const u8, agg_sz);
    } else if (cval as usize) != 0 && (unsafe { (*cval).kind }) == CONST_INT {
        let ival = unsafe { (*cval).int_val };
        let to_write = if sz > 8 { 8 } else { sz };
        let mut b_idx: usize = 0;
        while b_idx < to_write {
            let byte_val = ((ival >> ((b_idx as u64) * 8u64)) & 0xFFu64) as u8;
            section_add_byte(unsafe { mut_view(*tls_sec) }, byte_val);
            b_idx = b_idx + 1;
        }
        while b_idx < sz {
            section_add_byte(unsafe { mut_view(*tls_sec) }, 0u8);
            b_idx = b_idx + 1;
        }
    } else {
        let mut zi: usize = 0;
        while zi < sz {
            section_add_byte(unsafe { mut_view(*tls_sec) }, 0u8);
            zi = zi + 1;
        }
    }

    while ((unsafe { (*tls_sec).bytes_len }) % 8) != 0 {
        section_add_byte(unsafe { mut_view(*tls_sec) }, 0u8);
    }

    let name_sv = backend_format_const_sym_name(
        mut_view(ctx.backend_arena),
        unsafe { address_of(ctx.hir) as *const HirFile },
        unsafe { address_of(ctx.sess.interner) as *const StrInterner },
        sym_v
    );
    let _ = objmodel_add_symbol_bytes(
        mut_view(*obj),
        name_sv.ptr,
        name_sv.len,
        SectionId { v: tls_sec_id_v },
        sym_offset,
        sz as u64,
        SYM_GLOBAL
    );

    let raw_name_sv = interner_get(view(ctx.sess.interner), unsafe { (*it).name });
    if raw_name_sv.len > 0 {
        let _ = objmodel_add_symbol_bytes(
            mut_view(*obj),
            raw_name_sv.ptr,
            raw_name_sv.len,
            SectionId { v: tls_sec_id_v },
            sym_offset,
            sz as u64,
            if (unsafe { (*it).vis.kind }) != 0u8 { SYM_GLOBAL } else { SYM_LOCAL }
        );
    }
}

fn pipe_emit_tls_statics(
    ctx: mut_view<PipelineCtx>,
    filter_fid_v: u32,
    obj: mut_view<ObjModel>
) {
    if !ctx.has_tls {
        return;
    }

    // ".tls$" (5 bytes)
    let tls_name_arr: [5]u8 = [46u8, 116u8, 108u8, 115u8, 36u8];
    let tls_name_buf = arena_alloc_raw(mut_view(ctx.backend_arena), 6, 1);
    let mut ni: usize = 0;
    while ni < 5 {
        unsafe { *(tls_name_buf + ni) = tls_name_arr[ni]; }
        ni = ni + 1;
    }
    unsafe { *(tls_name_buf + 5) = 0u8; }

    let tls_sec_id = objmodel_add_section_bytes(
        mut_view(*obj),
        tls_name_buf as *const u8,
        5,
        SEC_TLS,
        SEC_FLAG_READ | SEC_FLAG_WRITE,
        8u32
    );
    let tls_sec_id_v = tls_sec_id.v;

    let mut it2: *mut HirItem = ctx.hir.items;
    while (it2 as usize) != 0 {
        if (unsafe { (*it2).kind }) == HIR_ITEM_STATIC && (unsafe { (*it2).is_tls }) {
            if filter_fid_v == 0u32 || (unsafe { (*it2).span.file.v }) == filter_fid_v {
                pipe_emit_one_tls_item(mut_view(*ctx), it2, mut_view(*obj), tls_sec_id_v);
            }
        }
        it2 = unsafe { (*it2).next };
    }
}

fn pipe_emit_exported_consts(
    ctx: mut_view<PipelineCtx>,
    for_lib: bool,
    for_obj: bool,
    filter_fid_v: u32,
    rdata_sec_id: SectionId,
    obj: mut_view<ObjModel>,
    drectve_buf: mut_view<CoffBuf>
) {
    let rdata_id_v = rdata_sec_id.v;
    let mut exp_str_id: u32 = 0u32;
    let mut cit: *mut HirItem = ctx.hir.items;
    while (cit as usize) != 0 {
        if (unsafe { (*cit).kind }) == HIR_ITEM_CONST &&
           (filter_fid_v == 0u32 || (unsafe { (*cit).span.file.v }) == filter_fid_v) {
            let mut has_export: bool = false;
            let export_sv = pipe_item_get_export_info(
                cit as *const HirItem,
                view(ctx.sess.interner),
                mut_view(has_export)
            );
            if has_export {
                let cname_sv = interner_get(view(ctx.sess.interner), unsafe { (*cit).name });
                let sym_v = unsafe { (*cit).symbol.v };
                let cval = sym_constmap_get(view(ctx.thir.symbol_consts), SymbolId { v: sym_v });
                let mut ty_v: u32 = 0u32;
                if (cval as usize) != 0 {
                    ty_v = unsafe { (*cval).ty.v };
                }
                if ty_v == 0u32 {
                    let p_ity = thir_get_item_type(view(ctx.thir), cit as *const HirItem);
                    if (p_ity as usize) != 0 {
                        ty_v = unsafe { (*p_ity).v };
                    } else {
                        let p_sty = thir_get_sym_type(view(ctx.thir), SymbolId { v: sym_v });
                        if (p_sty as usize) != 0 {
                            ty_v = unsafe { (*p_sty).v };
                        }
                    }
                }
                let rdata_sec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: rdata_id_v });
                let mut const_off: u64 = 0u64;
                let mut const_sz: u64 = 8u64;
                let ckind: u8 = if (cval as usize) != 0 { unsafe { (*cval).kind } } else { CONST_INT };

                if ckind == CONST_STR && (cval as usize) != 0 {
                    let s_ptr = unsafe { (*cval).str_bytes };
                    let s_len = unsafe { (*cval).str_len };
                    let s_off = unsafe { (*rdata_sec).bytes_len as u64 };
                    if (s_ptr as usize) != 0 && s_len > 0 {
                        unsafe {
                            section_add_bytes(mut_view(*rdata_sec), s_ptr, s_len);
                        }
                    }
                    unsafe {
                        section_add_byte(mut_view(*rdata_sec), 0u8);
                        while ((*rdata_sec).bytes_len % 8) != 0 {
                            section_add_byte(mut_view(*rdata_sec), 0u8);
                        }
                    }
                    let es_sv = pipe_alloc_exp_str_sym(mut_view(ctx.backend_arena), exp_str_id);
                    exp_str_id = exp_str_id + 1u32;
                    let str_sym = objmodel_add_symbol_bytes(
                        mut_view(*obj),
                        es_sv.ptr,
                        es_sv.len,
                        SectionId { v: rdata_id_v },
                        s_off,
                        (s_len + 1) as u64,
                        SYM_LOCAL
                    );
                    let rdata_sec2 = objmodel_get_section_mut(mut_view(*obj), SectionId { v: rdata_id_v });
                    const_off = unsafe { (*rdata_sec2).bytes_len as u64 };
                    const_sz = 16u64;
                    let mut z: usize = 0;
                    while z < 8 {
                        section_add_byte(unsafe { mut_view(*rdata_sec2) }, 0u8);
                        z = z + 1;
                    }
                    let slen_u64 = s_len as u64;
                    let mut b: usize = 0;
                    while b < 8 {
                        let shift = (b * 8) as u64;
                        let byte = ((slen_u64 >> shift) & 0xFFu64) as u8;
                        section_add_byte(unsafe { mut_view(*rdata_sec2) }, byte);
                        b = b + 1;
                    }
                    section_add_reloc(
                        unsafe { mut_view(*rdata_sec2) },
                        const_off as u32,
                        RELOC_X86_64_64,
                        str_sym,
                        0i64
                    );
                } else if ckind == CONST_AGGREGATE && (cval as usize) != 0 {
                    let agg_al_raw = unsafe { (*cval).agg_align };
                    let agg_al: usize = if agg_al_raw == 0 { 8 } else { agg_al_raw };
                    let agg_sz = unsafe { (*cval).agg_size };
                    let agg_ptr = unsafe { (*cval).agg_data as *const u8 };
                    unsafe {
                        while ((*rdata_sec).bytes_len % agg_al) != 0 {
                            section_add_byte(mut_view(*rdata_sec), 0u8);
                        }
                        const_off = (*rdata_sec).bytes_len as u64;
                        if agg_sz > 0 && (agg_ptr as usize) != 0 {
                            section_add_bytes(mut_view(*rdata_sec), agg_ptr, agg_sz);
                            const_sz = agg_sz as u64;
                        } else {
                            section_add_byte(mut_view(*rdata_sec), 0u8);
                            const_sz = 1u64;
                        }
                    }
                } else {
                    let raw_sz: u32 = if ty_v != 0u32 {
                        type_size(TypeId { v: ty_v }, view(ctx.thir.interner))
                    } else {
                        8u32
                    };
                    let raw_al: u32 = if ty_v != 0u32 {
                        type_align(TypeId { v: ty_v }, view(ctx.thir.interner))
                    } else {
                        8u32
                    };
                    let sz: usize = if raw_sz == 0u32 { 8 } else { raw_sz as usize };
                    let al: usize = if raw_al == 0u32 { 8 } else { raw_al as usize };
                    let ival: u64 = if (cval as usize) != 0 { unsafe { (*cval).int_val } } else { 0u64 };
                    unsafe {
                        while ((*rdata_sec).bytes_len % al) != 0 {
                            section_add_byte(mut_view(*rdata_sec), 0u8);
                        }
                        const_off = (*rdata_sec).bytes_len as u64;
                    }
                    const_sz = sz as u64;
                    let mut b: usize = 0;
                    while b < sz {
                        let byte: u8 = if b < 8 {
                            let shift = (b * 8) as u64;
                            ((ival >> shift) & 0xFFu64) as u8
                        } else {
                            0u8
                        };
                        section_add_byte(unsafe { mut_view(*rdata_sec) }, byte);
                        b = b + 1;
                    }
                }

                let exp_name_sv = if export_sv.len > 0 { export_sv } else { cname_sv };
                let sym_taken: bool =
                    objmodel_find_symbol_bytes(view(*obj), exp_name_sv.ptr, exp_name_sv.len).v != 0u32 ||
                    pipe_any_hir_fn_uses_name(ctx.hir.items, view(ctx.sess.interner), view(exp_name_sv));
                let use_mangled: bool = if for_lib || for_obj {
                    sym_taken
                } else {
                    sym_taken || export_sv.len > 0 || pipe_is_impl_member_clone(ctx.hir.items, cit as *const HirItem)
                };
                let primary_const_sv = if use_mangled {
                    pipe_alloc_exp_const_sym(mut_view(ctx.backend_arena), view(*obj), view(exp_name_sv))
                } else {
                    exp_name_sv
                };
                let _ = objmodel_add_symbol_bytes(
                    mut_view(*obj),
                    primary_const_sv.ptr,
                    primary_const_sv.len,
                    SectionId { v: rdata_id_v },
                    const_off,
                    const_sz,
                    SYM_GLOBAL
                );
                if !for_lib {
                    pipe_append_drectve_export(mut_view(*drectve_buf), view(exp_name_sv), view(primary_const_sv), true);
                }
            }
        }
        cit = unsafe { (*cit).next };
    }
}

fn pipe_prefix_ends_with_dll(ptr: *const u8, len: usize) -> bool {
    if len < 5 || (ptr as usize) == 0 {
        return false;
    }
    let b0 = unsafe { *(ptr + len - 4) };
    let b1 = unsafe { *(ptr + len - 3) } | 32u8;
    let b2 = unsafe { *(ptr + len - 2) } | 32u8;
    let b3 = unsafe { *(ptr + len - 1) } | 32u8;
    b0 == 46u8 && b1 == 100u8 && b2 == 108u8 && b3 == 108u8
}

fn pipe_is_dll_import_sym(
    items_head: *mut HirItem,
    interner: view<StrInterner>,
    dll_ptr: *const u8,
    dll_len: usize,
    fn_ptr: *const u8,
    fn_len: usize
) -> bool {
    if pipe_prefix_ends_with_dll(dll_ptr, dll_len) {
        return true;
    }
    let dll_sv = StrView { ptr: dll_ptr, len: dll_len };
    let fn_sv = StrView { ptr: fn_ptr, len: fn_len };
    let mut it: *mut HirItem = items_head;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && (unsafe { (*it).abi.v }) != 0u32 {
            let item_fn_sv = interner_get(interner, unsafe { (*it).name });
            if sv_eq(view(item_fn_sv), view(fn_sv)) {
                let link_sv = pipe_item_get_link_arg(it as *const HirItem, interner);
                if link_sv.len > 0 && sv_eq(view(link_sv), view(dll_sv)) {
                    return true;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

// ADR-0034 section 4 OI-07b / SPEC-26 AXS-WLIB-032:
// For standalone COFF object emission (`--emit=obj` / `--kind obj`), lower `<dll>$<FuncName>`
// external symbols into local 6-byte `jmp [rip + __imp_<FuncName>]` stubs in `.text` referencing
// standard PE/COFF `__imp_<FuncName>` external IAT symbols so GNU `ld`, `lld-link`, `link.exe`,
// and `axiomc` can all link the emitted `.obj` directly.
fn pipe_lower_dll_imports_for_obj(
    items_head: *mut HirItem,
    interner: view<StrInterner>,
    arena: mut_view<Arena>,
    text_sec_id: SectionId,
    obj: mut_view<ObjModel>
) {
    let text_id_v = text_sec_id.v;
    let thunk_pfx: [8]u8 = [46u8, 76u8, 116u8, 104u8, 117u8, 110u8, 107u8, 95u8]; // ".Lthunk_"
    let imp_pfx: [6]u8 = [95u8, 95u8, 105u8, 109u8, 112u8, 95u8]; // "__imp_"
    let orig_len = obj.symbols_len;
    let mut si: usize = 0;
    while si < orig_len {
        let sym0 = unsafe { pipe_obj_symbol_at(obj.symbols, si) };
        let bind = unsafe { (*sym0).linkage };
        let sec_v = unsafe { (*sym0).section_id.v };
        let nlen = unsafe { (*sym0).name_len };
        let nptr = unsafe { (*sym0).name };
        if bind == SYM_EXTERNAL && sec_v == 0u32 && nlen > 2 && (nptr as usize) != 0 {
            let mut dollar_pos: usize = nlen;
            let mut k: usize = 0;
            while k < nlen {
                if (unsafe { *(nptr + k) }) == 36u8 { // '$'
                    dollar_pos = k;
                    break;
                }
                k = k + 1;
            }
            if dollar_pos > 0 && (dollar_pos + 1) < nlen {
                let fn_ptr = unsafe { nptr + dollar_pos + 1 };
                let fn_len = nlen - dollar_pos - 1;
                if pipe_is_dll_import_sym(items_head, interner, nptr, dollar_pos, fn_ptr, fn_len) {

                let tlen = 8 + fn_len;
                let tbuf = arena_alloc_raw(mut_view(*arena), tlen + 1, 1);
                let mut ti: usize = 0;
                while ti < 8 {
                    unsafe { *(tbuf + ti) = thunk_pfx[ti]; }
                    ti = ti + 1;
                }
                let mut fi: usize = 0;
                while fi < fn_len {
                    unsafe { *(tbuf + 8 + fi) = *(fn_ptr + fi); }
                    fi = fi + 1;
                }
                unsafe { *(tbuf + tlen) = 0u8; }

                let existing_thunk = objmodel_find_symbol_bytes(view(*obj), tbuf as *const u8, tlen);
                let mut stub_off: u64 = 0u64;
                if existing_thunk.v != 0u32 {
                    let esym = unsafe { pipe_obj_symbol_at(obj.symbols, (existing_thunk.v - 1u32) as usize) };
                    stub_off = unsafe { (*esym).value };
                } else {
                    let ilen = 6 + fn_len;
                    let ibuf = arena_alloc_raw(mut_view(*arena), ilen + 1, 1);
                    let mut ii: usize = 0;
                    while ii < 6 {
                        unsafe { *(ibuf + ii) = imp_pfx[ii]; }
                        ii = ii + 1;
                    }
                    let mut ij: usize = 0;
                    while ij < fn_len {
                        unsafe { *(ibuf + 6 + ij) = *(fn_ptr + ij); }
                        ij = ij + 1;
                    }
                    unsafe { *(ibuf + ilen) = 0u8; }

                    let mut imp_id = objmodel_find_symbol_bytes(view(*obj), ibuf as *const u8, ilen);
                    if imp_id.v == 0u32 {
                        imp_id = objmodel_add_symbol_bytes(
                            mut_view(*obj),
                            ibuf as *const u8,
                            ilen,
                            SectionId { v: 0u32 },
                            0u64,
                            0u64,
                            SYM_EXTERNAL
                        );
                    }
                    let tsec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
                    stub_off = unsafe { (*tsec).bytes_len as u64 };
                    unsafe {
                        section_add_byte(mut_view(*tsec), 0xFFu8);
                        section_add_byte(mut_view(*tsec), 0x25u8);
                        section_add_byte(mut_view(*tsec), 0x00u8);
                        section_add_byte(mut_view(*tsec), 0x00u8);
                        section_add_byte(mut_view(*tsec), 0x00u8);
                        section_add_byte(mut_view(*tsec), 0x00u8);
                        section_add_reloc(
                            mut_view(*tsec),
                            (stub_off as u32) + 2u32,
                            RELOC_X86_64_PC32,
                            imp_id,
                            -4i64
                        );
                    }
                }

                    let sym_after = unsafe { pipe_obj_symbol_at(obj.symbols, si) };
                    unsafe {
                        (*sym_after).name = tbuf as *const u8;
                        (*sym_after).name_len = tlen;
                        (*sym_after).section_id = SectionId { v: text_id_v };
                        (*sym_after).value = stub_off;
                        (*sym_after).size = 6u64;
                        (*sym_after).linkage = SYM_LOCAL;
                    }
                }
            }
        }
        si = si + 1;
    }
}

fn pipe_sv_eq_ascii(sv: view<StrView>, bytes: *const u8, n: usize) -> bool {
    if sv.len != n || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        if (unsafe { *(sv.ptr + i) }) != (unsafe { *(bytes + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn pipe_item_has_weak_attr(it: *const HirItem, interner: view<StrInterner>) -> bool {
    let weak_b: [4]u8 = [119u8, 101u8, 97u8, 107u8]; // "weak"
    let linkonce_b: [8]u8 = [108u8, 105u8, 110u8, 107u8, 111u8, 110u8, 99u8, 101u8]; // "linkonce"
    let mut attr: *mut HirAttr = unsafe { (*it).attrs };
    while (attr as usize) != 0 {
        let an = interner_get(interner, unsafe { (*attr).name });
        if pipe_sv_eq_ascii(view(an), unsafe { address_of(weak_b[0]) }, 4) ||
           pipe_sv_eq_ascii(view(an), unsafe { address_of(linkonce_b[0]) }, 8) {
            return true;
        }
        attr = unsafe { (*attr).next };
    }
    false
}

fn pipe_item_get_call_conv(it: *const HirItem, interner: view<StrInterner>) -> u8 {
    let cc_b: [2]u8 = [99u8, 99u8]; // "cc"
    let callconv_b: [8]u8 = [99u8, 97u8, 108u8, 108u8, 99u8, 111u8, 110u8, 118u8]; // "callconv"
    let sysv_b: [6]u8 = [115u8, 121u8, 115u8, 118u8, 54u8, 52u8]; // "sysv64"
    let fastcall_b: [8]u8 = [102u8, 97u8, 115u8, 116u8, 99u8, 97u8, 108u8, 108u8]; // "fastcall"
    let vectorcall_b: [10]u8 = [118u8, 101u8, 99u8, 116u8, 111u8, 114u8, 99u8, 97u8, 108u8, 108u8]; // "vectorcall"

    let abi_id = unsafe { (*it).abi };
    if abi_id.v != 0u32 {
        let abi_sv = interner_get(interner, abi_id);
        if pipe_sv_eq_ascii(view(abi_sv), unsafe { address_of(sysv_b[0]) }, 6) {
            return SYM_CC_SYSV64;
        }
        if pipe_sv_eq_ascii(view(abi_sv), unsafe { address_of(fastcall_b[0]) }, 8) {
            return SYM_CC_FASTCALL;
        }
        if pipe_sv_eq_ascii(view(abi_sv), unsafe { address_of(vectorcall_b[0]) }, 10) {
            return SYM_CC_VECTORCALL;
        }
    }

    let mut attr: *mut HirAttr = unsafe { (*it).attrs };
    while (attr as usize) != 0 {
        let an = interner_get(interner, unsafe { (*attr).name });
        if pipe_sv_eq_ascii(view(an), unsafe { address_of(cc_b[0]) }, 2) ||
           pipe_sv_eq_ascii(view(an), unsafe { address_of(callconv_b[0]) }, 8) {
            let args: *mut HirAttrArg = unsafe { (*attr).args };
            if (args as usize) != 0 {
                let expr: *mut HirExpr = unsafe { (*args).expr };
                if (expr as usize) != 0 && (unsafe { (*expr).kind }) == HIR_EXPR_LITERAL {
                    let lptr = unsafe { (*expr).literal.str_ptr };
                    let llen = unsafe { (*expr).literal.str_len };
                    let lsv = StrView { ptr: lptr, len: llen };
                    if pipe_sv_eq_ascii(view(lsv), unsafe { address_of(sysv_b[0]) }, 6) {
                        return SYM_CC_SYSV64;
                    }
                    if pipe_sv_eq_ascii(view(lsv), unsafe { address_of(fastcall_b[0]) }, 8) {
                        return SYM_CC_FASTCALL;
                    }
                    if pipe_sv_eq_ascii(view(lsv), unsafe { address_of(vectorcall_b[0]) }, 10) {
                        return SYM_CC_VECTORCALL;
                    }
                }
            }
        }
        attr = unsafe { (*attr).next };
    }
    SYM_CC_WIN64
}

fn pipe_fid_is_std(files: *const ProjectFile, file_count: usize, fid_v: u32) -> bool {
    if fid_v == 0u32 || file_count == 0 || (files as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < file_count {
        let pf = unsafe { project_file_const_at(files, i) };
        if pf_get_fid_v(pf) == fid_v {
            return pf_is_std(pf);
        }
        i = i + 1;
    }
    false
}

fn pipe_append_u64_dec(buf: mut_view<CoffBuf>, val: u64) {
    if val == 0u64 {
        coff_buf_put_u8(mut_view(*buf), 48u8);
        return;
    }
    let mut tmp: [24]u8 = [0u8; 24];
    let mut n: usize = 0;
    let mut v = val;
    while v > 0u64 {
        tmp[n] = (48u64 + (v % 10u64)) as u8;
        v = v / 10u64;
        n = n + 1;
    }
    while n > 0 {
        n = n - 1;
        coff_buf_put_u8(mut_view(*buf), tmp[n]);
    }
}

fn pipe_append_type_sig(
    buf: mut_view<CoffBuf>,
    ty_id: TypeId,
    ti: view<TypeInterner>,
    interner: view<StrInterner>
) {
    if ty_id.v == 0u32 {
        let u_b: [4]u8 = [117u8, 110u8, 105u8, 116u8]; // "unit"
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(u_b[0]) }, 4);
        return;
    }
    let ty = type_get(ti, ty_id);
    if (ty as usize) == 0 {
        let u_b: [4]u8 = [117u8, 110u8, 105u8, 116u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(u_b[0]) }, 4);
        return;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_UNIT {
        let b: [4]u8 = [117u8, 110u8, 105u8, 116u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 4);
    } else if k == TY_NEVER {
        coff_buf_put_u8(mut_view(*buf), 33u8);
    } else if k == TY_BOOL {
        let b: [4]u8 = [98u8, 111u8, 111u8, 108u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 4);
    } else if k == TY_CHAR {
        let b: [4]u8 = [99u8, 104u8, 97u8, 114u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 4);
    } else if k == TY_STR {
        let b: [3]u8 = [115u8, 116u8, 114u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 3);
    } else if k == TY_I8 {
        let b: [2]u8 = [105u8, 56u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 2);
    } else if k == TY_I16 {
        let b: [3]u8 = [105u8, 49u8, 54u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 3);
    } else if k == TY_I32 {
        let b: [3]u8 = [105u8, 51u8, 50u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 3);
    } else if k == TY_I64 {
        let b: [3]u8 = [105u8, 54u8, 52u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 3);
    } else if k == TY_I128 {
        let b: [4]u8 = [105u8, 49u8, 50u8, 56u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 4);
    } else if k == TY_ISIZE {
        let b: [5]u8 = [105u8, 115u8, 105u8, 122u8, 101u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 5);
    } else if k == TY_U8 {
        let b: [2]u8 = [117u8, 56u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 2);
    } else if k == TY_U16 {
        let b: [3]u8 = [117u8, 49u8, 54u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 3);
    } else if k == TY_U32 {
        let b: [3]u8 = [117u8, 51u8, 50u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 3);
    } else if k == TY_U64 {
        let b: [3]u8 = [117u8, 54u8, 52u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 3);
    } else if k == TY_U128 {
        let b: [4]u8 = [117u8, 49u8, 50u8, 56u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 4);
    } else if k == TY_USIZE {
        let b: [5]u8 = [117u8, 115u8, 105u8, 122u8, 101u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 5);
    } else if k == TY_PTR {
        if unsafe { (*ty).is_mut } {
            let b: [5]u8 = [42u8, 109u8, 117u8, 116u8, 32u8]; // "*mut "
            coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 5);
        } else {
            let b: [7]u8 = [42u8, 99u8, 111u8, 110u8, 115u8, 116u8, 32u8]; // "*const "
            coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 7);
        }
        pipe_append_type_sig(mut_view(*buf), unsafe { (*ty).pointee }, ti, interner);
    } else if k == TY_VIEW {
        let b: [5]u8 = [118u8, 105u8, 101u8, 119u8, 60u8]; // "view<"
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 5);
        pipe_append_type_sig(mut_view(*buf), unsafe { (*ty).pointee }, ti, interner);
        coff_buf_put_u8(mut_view(*buf), 62u8);
    } else if k == TY_MUT_VIEW {
        let b: [9]u8 = [109u8, 117u8, 116u8, 95u8, 118u8, 105u8, 101u8, 119u8, 60u8]; // "mut_view<"
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 9);
        pipe_append_type_sig(mut_view(*buf), unsafe { (*ty).pointee }, ti, interner);
        coff_buf_put_u8(mut_view(*buf), 62u8);
    } else if k == TY_SLICE {
        coff_buf_put_u8(mut_view(*buf), 91u8);
        pipe_append_type_sig(mut_view(*buf), unsafe { (*ty).elem }, ti, interner);
        coff_buf_put_u8(mut_view(*buf), 93u8);
    } else if k == TY_ARRAY {
        coff_buf_put_u8(mut_view(*buf), 91u8);
        pipe_append_u64_dec(mut_view(*buf), unsafe { (*ty).array_len });
        coff_buf_put_u8(mut_view(*buf), 93u8);
        pipe_append_type_sig(mut_view(*buf), unsafe { (*ty).elem }, ti, interner);
    } else if k == TY_TUPLE {
        coff_buf_put_u8(mut_view(*buf), 40u8);
        let fc = unsafe { (*ty).field_count };
        let fptr = unsafe { (*ty).fields };
        let mut fi: usize = 0;
        while fi < fc {
            if fi > 0 {
                coff_buf_put_u8(mut_view(*buf), 44u8);
                coff_buf_put_u8(mut_view(*buf), 32u8);
            }
            let f_tid = unsafe { *typeid_at(fptr, fi) };
            pipe_append_type_sig(mut_view(*buf), f_tid, ti, interner);
            fi = fi + 1;
        }
        coff_buf_put_u8(mut_view(*buf), 41u8);
    } else if k == TY_STRUCT || k == TY_ENUM {
        let nm_id = unsafe { (*ty).name };
        if nm_id.v != 0u32 {
            let nm_sv = interner_get(interner, nm_id);
            coff_buf_put_bytes(mut_view(*buf), nm_sv.ptr, nm_sv.len);
        } else {
            let b: [6]u8 = [115u8, 116u8, 114u8, 117u8, 99u8, 116u8];
            coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 6);
        }
        let ac = unsafe { (*ty).arg_count };
        let aptr = unsafe { (*ty).args };
        if ac > 0 && (aptr as usize) != 0 {
            coff_buf_put_u8(mut_view(*buf), 60u8);
            let mut ai: usize = 0;
            while ai < ac {
                if ai > 0 {
                    coff_buf_put_u8(mut_view(*buf), 44u8);
                    coff_buf_put_u8(mut_view(*buf), 32u8);
                }
                let a_tid = unsafe { *typeid_at(aptr, ai) };
                pipe_append_type_sig(mut_view(*buf), a_tid, ti, interner);
                ai = ai + 1;
            }
            coff_buf_put_u8(mut_view(*buf), 62u8);
        }
    } else if k == TY_FN {
        let b: [3]u8 = [102u8, 110u8, 40u8]; // "fn("
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 3);
        let pc = unsafe { (*ty).param_count };
        let pptr = unsafe { (*ty).param_types };
        let mut pi: usize = 0;
        while pi < pc {
            if pi > 0 {
                coff_buf_put_u8(mut_view(*buf), 44u8);
                coff_buf_put_u8(mut_view(*buf), 32u8);
            }
            let p_tid = unsafe { *typeid_at(pptr, pi) };
            pipe_append_type_sig(mut_view(*buf), p_tid, ti, interner);
            pi = pi + 1;
        }
        let arr: [5]u8 = [41u8, 32u8, 45u8, 62u8, 32u8]; // ") -> "
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(arr[0]) }, 5);
        pipe_append_type_sig(mut_view(*buf), unsafe { (*ty).ret_type }, ti, interner);
    } else {
        let b: [1]u8 = [63u8];
        coff_buf_put_bytes(mut_view(*buf), unsafe { address_of(b[0]) }, 1);
    }
}

fn pipe_format_fn_abi_sig(
    arena: mut_view<Arena>,
    fn_ty: *const AxType,
    call_conv: u8,
    ti: view<TypeInterner>,
    interner: view<StrInterner>,
    out_param_count: mut_view<u32>,
    out_ret_size: mut_view<u32>
) -> StrView {
    let mut buf = coff_buf_with_capacity(64);
    let fn_b: [3]u8 = [102u8, 110u8, 40u8]; // "fn("
    coff_buf_put_bytes(mut_view(buf), unsafe { address_of(fn_b[0]) }, 3);
    if (fn_ty as usize) != 0 {
        let pc = unsafe { (*fn_ty).param_count };
        let pptr = unsafe { (*fn_ty).param_types };
        *out_param_count = pc as u32;
        let mut pi: usize = 0;
        while pi < pc {
            if pi > 0 {
                coff_buf_put_u8(mut_view(buf), 44u8);
                coff_buf_put_u8(mut_view(buf), 32u8);
            }
            let p_tid = unsafe { *typeid_at(pptr, pi) };
            pipe_append_type_sig(mut_view(buf), p_tid, ti, interner);
            pi = pi + 1;
        }
        let arr: [5]u8 = [41u8, 32u8, 45u8, 62u8, 32u8]; // ") -> "
        coff_buf_put_bytes(mut_view(buf), unsafe { address_of(arr[0]) }, 5);
        let r_tid_v = unsafe { (*fn_ty).ret_type.v };
        pipe_append_type_sig(mut_view(buf), TypeId { v: r_tid_v }, ti, interner);
        if r_tid_v == 0u32 {
            *out_ret_size = 0u32;
        } else {
            let rty = type_get(ti, TypeId { v: r_tid_v });
            if (rty as usize) != 0 && ((unsafe { (*rty).kind }) == TY_UNIT || (unsafe { (*rty).kind }) == TY_NEVER) {
                *out_ret_size = 0u32;
            } else {
                *out_ret_size = type_size(TypeId { v: r_tid_v }, ti);
            }
        }
    } else {
        *out_param_count = 0xFFFFFFFFu32;
        *out_ret_size = 0xFFFFFFFFu32;
        let close_b: [8]u8 = [41u8, 32u8, 45u8, 62u8, 32u8, 117u8, 110u8, 105u8];
        coff_buf_put_bytes(mut_view(buf), unsafe { address_of(close_b[0]) }, 8);
        coff_buf_put_u8(mut_view(buf), 116u8);
    }
    if call_conv == SYM_CC_SYSV64 {
        let cc_s: [12]u8 = [32u8, 91u8, 99u8, 99u8, 61u8, 115u8, 121u8, 115u8, 118u8, 54u8, 52u8, 93u8]; // " [cc=sysv64]"
        coff_buf_put_bytes(mut_view(buf), unsafe { address_of(cc_s[0]) }, 12);
    } else if call_conv == SYM_CC_FASTCALL {
        let cc_f: [14]u8 = [32u8, 91u8, 99u8, 99u8, 61u8, 102u8, 97u8, 115u8, 116u8, 99u8, 97u8, 108u8, 108u8, 93u8];
        coff_buf_put_bytes(mut_view(buf), unsafe { address_of(cc_f[0]) }, 14);
    } else if call_conv == SYM_CC_VECTORCALL {
        let cc_v: [16]u8 = [32u8, 91u8, 99u8, 99u8, 61u8, 118u8, 101u8, 99u8, 116u8, 111u8, 114u8, 99u8, 97u8, 108u8, 108u8, 93u8];
        coff_buf_put_bytes(mut_view(buf), unsafe { address_of(cc_v[0]) }, 16);
    }
    let slen = buf.len;
    let dst = arena_alloc_raw(mut_view(*arena), slen + 1, 1);
    let mut i: usize = 0;
    while i < slen {
        unsafe { *(dst + i) = *(buf.ptr + i); }
        i = i + 1;
    }
    unsafe { *(dst + slen) = 0u8; }
    coff_buf_free(mut_view(buf));
    StrView { ptr: dst as *const u8, len: slen }
}

fn pipe_find_mono_instance(head: *mut MonoInstance, target: *const HirItem) -> *mut MonoInstance {
    let mut inst: *mut MonoInstance = head;
    while (inst as usize) != 0 {
        if ((unsafe { (*inst).new_item }) as usize) == (target as usize) &&
           ((unsafe { (*inst).orig_item }) as usize) != (target as usize) {
            return inst;
        }
        inst = unsafe { (*inst).next };
    }
    0 as *mut MonoInstance
}

fn pipe_format_demangled_sym(
    ctx: mut_view<PipelineCtx>,
    hir_it: *const HirItem,
    sym_sv: view<StrView>
) -> StrView {
    // 1. If `sym_sv` starts with `_AX1_`, demangle via `pe_demangle_symbol`.
    if sym_sv.len >= 5 && (sym_sv.ptr as usize) != 0 &&
       (unsafe { *(sym_sv.ptr + 0) == 95u8 && *(sym_sv.ptr + 1) == 65u8 &&
                 *(sym_sv.ptr + 2) == 88u8 && *(sym_sv.ptr + 3) == 49u8 &&
                 *(sym_sv.ptr + 4) == 95u8 }) {
        let mut dbuf = coff_buf_with_capacity(sym_sv.len + 16);
        pe_demangle_symbol(sym_sv.ptr, sym_sv.len, mut_view(dbuf));
        let dlen = dbuf.len;
        let dst = arena_alloc_raw(mut_view(ctx.backend_arena), dlen + 1, 1);
        let mut i: usize = 0;
        while i < dlen {
            unsafe { *(dst + i) = *(dbuf.ptr + i); }
            i = i + 1;
        }
        unsafe { *(dst + dlen) = 0u8; }
        coff_buf_free(mut_view(dbuf));
        return StrView { ptr: dst as *const u8, len: dlen };
    }

    // 2. If `hir_it` is a monomorphized generic clone, format `<orig_canonical><<type_args>>`.
    if (hir_it as usize) != 0 {
        let minst = pipe_find_mono_instance(ctx.mono.instances_head, hir_it);
        if (minst as usize) != 0 {
            let orig_it = unsafe { (*minst).orig_item };
            let acount = unsafe { (*minst).args.count };
            let aptr = unsafe { (*minst).args.args };
            if (orig_it as usize) != 0 && acount > 0 && (aptr as usize) != 0 {
                let mut mbuf = coff_buf_with_capacity(64);
                let orig_cn = resolve_symbol_canonical_name(view(ctx.rmap), unsafe { (*orig_it).symbol });
                if orig_cn.len > 0 && (orig_cn.ptr as usize) != 0 {
                    coff_buf_put_bytes(mut_view(mbuf), orig_cn.ptr, orig_cn.len);
                } else {
                    let onm = interner_get(view(ctx.sess.interner), unsafe { (*orig_it).name });
                    coff_buf_put_bytes(mut_view(mbuf), onm.ptr, onm.len);
                }
                coff_buf_put_u8(mut_view(mbuf), 60u8); // '<'
                let mut ai: usize = 0;
                while ai < acount {
                    if ai > 0 {
                        coff_buf_put_u8(mut_view(mbuf), 44u8);
                        coff_buf_put_u8(mut_view(mbuf), 32u8);
                    }
                    let a_tid = unsafe { *typeid_at(aptr, ai) };
                    pipe_append_type_sig(mut_view(mbuf), a_tid, view(ctx.thir.interner), view(ctx.sess.interner));
                    ai = ai + 1;
                }
                coff_buf_put_u8(mut_view(mbuf), 62u8); // '>'
                let mlen = mbuf.len;
                let mdst = arena_alloc_raw(mut_view(ctx.backend_arena), mlen + 1, 1);
                let mut mi: usize = 0;
                while mi < mlen {
                    unsafe { *(mdst + mi) = *(mbuf.ptr + mi); }
                    mi = mi + 1;
                }
                unsafe { *(mdst + mlen) = 0u8; }
                coff_buf_free(mut_view(mbuf));
                return StrView { ptr: mdst as *const u8, len: mlen };
            }
        }
    }

    // 3. If `hir_it` is a non-extern item with a body and no `$`, check `resolve_symbol_canonical_name`.
    if (hir_it as usize) != 0 &&
       ((unsafe { (*hir_it).body }) as usize) != 0 &&
       (unsafe { (*hir_it).abi.v }) == 0u32 &&
       !pipe_sv_has_dollar(sym_sv) {
        let cn = resolve_symbol_canonical_name(view(ctx.rmap), unsafe { (*hir_it).symbol });
        if cn.len > 0 && (cn.ptr as usize) != 0 {
            return cn;
        }
    }

    // 4. Fallback to `pe_demangle_symbol`.
    let mut fbuf = coff_buf_with_capacity(sym_sv.len + 8);
    pe_demangle_symbol(sym_sv.ptr, sym_sv.len, mut_view(fbuf));
    let flen = fbuf.len;
    let fdst = arena_alloc_raw(mut_view(ctx.backend_arena), flen + 1, 1);
    let mut fi: usize = 0;
    while fi < flen {
        unsafe { *(fdst + fi) = *(fbuf.ptr + fi); }
        fi = fi + 1;
    }
    unsafe { *(fdst + flen) = 0u8; }
    coff_buf_free(mut_view(fbuf));
    StrView { ptr: fdst as *const u8, len: flen }
}

fn pipe_find_hir_fn_for_sym(
    items_head: *mut HirItem,
    interner: view<StrInterner>,
    sym_sv: view<StrView>
) -> *mut HirItem {
    let mut best_decl: *mut HirItem = 0 as *mut HirItem;
    let mut it: *mut HirItem = items_head;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN {
            let fn_name_v = unsafe { (*it).name.v };
            if fn_name_v != 0u32 {
                let fsv = interner_get(interner, StrId { v: fn_name_v });
                if sv_eq(view(fsv), sym_sv) {
                    if ((unsafe { (*it).body }) as usize) != 0 {
                        return it;
                    }
                    if (best_decl as usize) == 0 {
                        best_decl = it;
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
    best_decl
}

fn pipe_emit_axmeta_section(
    ctx: mut_view<PipelineCtx>,
    items_buf: *const *mut HirItem,
    bodies_buf: *const *mut MirBody,
    fn_count: usize,
    for_lib: bool,
    for_obj: bool,
    filter_fid_v: u32,
    axmeta_keep_file_id: bool,
    obj: mut_view<ObjModel>
) {
    let mut entry_count: u32 = 0u32;
    let mut entries_buf = coff_buf_with_capacity(512);
    let data_sig_b: [4]u8 = [100u8, 97u8, 116u8, 97u8]; // "data"
    let prel_b: [14]u8 = [
        112u8, 114u8, 101u8, 108u8, 117u8, 100u8, 101u8,
        95u8, 108u8, 111u8, 97u8, 100u8, 101u8, 100u8,
    ];

    // 1. Emit `AXMETA_ENTRY_DEF` for each defined function in `items_buf[0..fn_count]`.
    let mut fi: usize = 0;
    while fi < fn_count {
        let fn_item = unsafe { *pipe_hir_item_ptr_at(items_buf as *mut *mut HirItem, fi) };
        let mir_body = unsafe { *pipe_mir_body_ptr_at(bodies_buf as *mut *mut MirBody, fi) };
        if (fn_item as usize) != 0 {
            let fname_id_v = unsafe { (*fn_item).name.v };
            let fname_sv = if fname_id_v == 0u32 {
                backend_alloc_anon_fn_sym(mut_view(ctx.backend_arena), unsafe { (*fn_item).symbol.v })
            } else {
                interner_get(view(ctx.sess.interner), StrId { v: fname_id_v })
            };
            let orig_name_ptr = thir_get_orig_item_name(view(ctx.thir), fn_item as *const HirItem);
            let orig_fname_sv = if (orig_name_ptr as usize) != 0 && (unsafe { *orig_name_ptr }) != 0u32 {
                interner_get(view(ctx.sess.interner), StrId { v: unsafe { *orig_name_ptr } })
            } else {
                fname_sv
            };
            let mut has_export: bool = false;
            let export_sv = pipe_item_get_export_info(
                fn_item as *const HirItem,
                view(ctx.sess.interner),
                mut_view(has_export)
            );
            let exp_fn_sv = if export_sv.len > 0 { export_sv } else { orig_fname_sv };
            let is_global: bool = !for_lib ||
                (unsafe { (*fn_item).vis.kind }) != 0u8 ||
                has_export ||
                pipe_sv_has_dollar(view(fname_sv));
            if is_global && fname_sv.len > 0 {
                let fn_ty = backend_resolve_item_fn_ty(
                    mut_view(ctx.backend_arena),
                    view(ctx.thir),
                    fn_item as *const HirItem,
                    mir_body as *const MirBody
                );
                let cc = pipe_item_get_call_conv(fn_item as *const HirItem, view(ctx.sess.interner));
                let mut p_cnt: u32 = 0u32;
                let mut r_sz: u32 = 0u32;
                let sig_sv = pipe_format_fn_abi_sig(
                    mut_view(ctx.backend_arena),
                    fn_ty,
                    cc,
                    view(ctx.thir.interner),
                    view(ctx.sess.interner),
                    mut_view(p_cnt),
                    mut_view(r_sz)
                );
                let is_weak: bool =
                    pipe_is_mono_clone(ctx.mono.instances_head, fn_item as *const HirItem) ||
                    pipe_is_trait_member(ctx.hir.items, fn_item) ||
                    tc_is_default_inst(fn_item as *const HirItem) ||
                    pipe_fid_is_std(ctx.proj.files as *const ProjectFile, ctx.proj.file_count, unsafe { (*fn_item).span.file.v }) ||
                    pipe_sv_eq_ascii(view(fname_sv), unsafe { address_of(prel_b[0]) }, 14) ||
                    pipe_sv_has_dollar(view(fname_sv)) ||
                    pipe_item_has_weak_attr(fn_item as *const HirItem, view(ctx.sess.interner));
                let bind: u8 = if is_weak { SYM_BIND_WEAK } else { SYM_BIND_STRONG };
                let dem_sv = pipe_format_demangled_sym(mut_view(*ctx), fn_item as *const HirItem, view(fname_sv));
                let sp = unsafe { (*fn_item).span };
                let fid_out: u32 = if axmeta_keep_file_id { sp.file.v } else { 0u32 };
                axmeta_put_entry(
                    mut_view(entries_buf),
                    fname_sv.ptr,
                    fname_sv.len,
                    dem_sv.ptr,
                    dem_sv.len,
                    sig_sv.ptr,
                    sig_sv.len,
                    0 as *const u8,
                    0,
                    AXMETA_ENTRY_DEF,
                    bind,
                    SYM_ABI_KIND_FUNC,
                    cc,
                    p_cnt,
                    r_sz,
                    fid_out,
                    sp.start,
                    sp.end
                );
                entry_count = entry_count + 1u32;

                if (for_lib || for_obj) && has_export && exp_fn_sv.len > 0 && !sv_eq(view(exp_fn_sv), view(fname_sv)) {
                    if !pipe_other_fn_uses_name(
                        items_buf as *const *mut HirItem,
                        fn_count,
                        fn_item as *const HirItem,
                        view(ctx.sess.interner),
                        view(exp_fn_sv)
                    ) {
                        let exp_dem_sv = pipe_format_demangled_sym(mut_view(*ctx), fn_item as *const HirItem, view(exp_fn_sv));
                        axmeta_put_entry(
                            mut_view(entries_buf),
                            exp_fn_sv.ptr,
                            exp_fn_sv.len,
                            exp_dem_sv.ptr,
                            exp_dem_sv.len,
                            sig_sv.ptr,
                            sig_sv.len,
                            0 as *const u8,
                            0,
                            AXMETA_ENTRY_DEF,
                            bind,
                            SYM_ABI_KIND_FUNC,
                            cc,
                            p_cnt,
                            r_sz,
                            fid_out,
                            sp.start,
                            sp.end
                        );
                        entry_count = entry_count + 1u32;
                    }
                }
            }
        }
        fi = fi + 1;
    }

    // 2. Emit `AXMETA_ENTRY_DEF` for exported `const` items (`SYM_ABI_KIND_DATA`).
    let mut cit: *mut HirItem = ctx.hir.items;
    while (cit as usize) != 0 {
        if (unsafe { (*cit).kind }) == HIR_ITEM_CONST &&
           (filter_fid_v == 0u32 || (unsafe { (*cit).span.file.v }) == filter_fid_v) {
            let mut has_export: bool = false;
            let export_sv = pipe_item_get_export_info(
                cit as *const HirItem,
                view(ctx.sess.interner),
                mut_view(has_export)
            );
            if has_export {
                let cname_sv = interner_get(view(ctx.sess.interner), unsafe { (*cit).name });
                let exp_name_sv = if export_sv.len > 0 { export_sv } else { cname_sv };
                let sym_taken: bool = pipe_any_hir_fn_uses_name(ctx.hir.items, view(ctx.sess.interner), view(exp_name_sv));
                let use_mangled: bool = if for_lib || for_obj {
                    sym_taken
                } else {
                    sym_taken || export_sv.len > 0 || pipe_is_impl_member_clone(ctx.hir.items, cit as *const HirItem)
                };
                if exp_name_sv.len > 0 && !use_mangled {
                    let dem_sv = pipe_format_demangled_sym(mut_view(*ctx), cit as *const HirItem, view(exp_name_sv));
                    let sp = unsafe { (*cit).span };
                    let fid_out: u32 = if axmeta_keep_file_id { sp.file.v } else { 0u32 };
                    let bind: u8 = if pipe_item_has_weak_attr(cit as *const HirItem, view(ctx.sess.interner)) {
                        SYM_BIND_WEAK
                    } else {
                        SYM_BIND_STRONG
                    };
                    axmeta_put_entry(
                        mut_view(entries_buf),
                        exp_name_sv.ptr,
                        exp_name_sv.len,
                        dem_sv.ptr,
                        dem_sv.len,
                        unsafe { address_of(data_sig_b[0]) },
                        4,
                        0 as *const u8,
                        0,
                        AXMETA_ENTRY_DEF,
                        bind,
                        SYM_ABI_KIND_DATA,
                        SYM_CC_WIN64,
                        0u32,
                        8u32,
                        fid_out,
                        sp.start,
                        sp.end
                    );
                    entry_count = entry_count + 1u32;
                }
            }
        }
        cit = unsafe { (*cit).next };
    }

    // 3. Emit `AXMETA_ENTRY_REF` for undefined external symbols in `obj.symbols`.
    let mut si: usize = 0;
    while si < obj.symbols_len {
        let osym = unsafe { pipe_obj_symbol_at(obj.symbols, si) };
        if (unsafe { (*osym).linkage }) == SYM_EXTERNAL && (unsafe { (*osym).section_id.v }) == 0u32 {
            let s_ptr = unsafe { (*osym).name };
            let s_len = unsafe { (*osym).name_len };
            if s_len > 0 && (s_ptr as usize) != 0 {
                let sym_sv = StrView { ptr: s_ptr, len: s_len };
                let hir_fn = pipe_find_hir_fn_for_sym(ctx.hir.items, view(ctx.sess.interner), view(sym_sv));
                if (hir_fn as usize) != 0 {
                    let p_ity = thir_get_item_type(view(ctx.thir), hir_fn as *const HirItem);
                    let mut fn_ty: *const AxType = 0 as *const AxType;
                    if (p_ity as usize) != 0 && (unsafe { (*p_ity).v }) != 0u32 {
                        fn_ty = type_get(view(ctx.thir.interner), TypeId { v: unsafe { (*p_ity).v } }) as *const AxType;
                    }
                    let cc = pipe_item_get_call_conv(hir_fn as *const HirItem, view(ctx.sess.interner));
                    let mut p_cnt: u32 = 0xFFFFFFFFu32;
                    let mut r_sz: u32 = 0xFFFFFFFFu32;
                    let sig_sv = pipe_format_fn_abi_sig(
                        mut_view(ctx.backend_arena),
                        fn_ty,
                        cc,
                        view(ctx.thir.interner),
                        view(ctx.sess.interner),
                        mut_view(p_cnt),
                        mut_view(r_sz)
                    );
                    let dem_sv = pipe_format_demangled_sym(mut_view(*ctx), hir_fn as *const HirItem, view(sym_sv));
                    let sp = unsafe { (*hir_fn).span };
                    let fid_out: u32 = if axmeta_keep_file_id { sp.file.v } else { 0u32 };
                    axmeta_put_entry(
                        mut_view(entries_buf),
                        sym_sv.ptr,
                        sym_sv.len,
                        dem_sv.ptr,
                        dem_sv.len,
                        sig_sv.ptr,
                        sig_sv.len,
                        0 as *const u8,
                        0,
                        AXMETA_ENTRY_REF,
                        SYM_BIND_STRONG,
                        SYM_ABI_KIND_FUNC,
                        cc,
                        p_cnt,
                        r_sz,
                        fid_out,
                        sp.start,
                        sp.end
                    );
                    entry_count = entry_count + 1u32;
                }
            }
        }
        si = si + 1;
    }

    if entry_count > 0u32 {
        // ".axmeta" (7 bytes)
        let axm_arr: [7]u8 = [46u8, 97u8, 120u8, 109u8, 101u8, 116u8, 97u8];
        let axm_buf = arena_alloc_raw(mut_view(ctx.backend_arena), 8, 1);
        let mut ai: usize = 0;
        while ai < 7 {
            unsafe { *(axm_buf + ai) = axm_arr[ai]; }
            ai = ai + 1;
        }
        unsafe { *(axm_buf + 7) = 0u8; }
        let msec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            axm_buf as *const u8,
            7,
            SEC_DIRECTIVE,
            SEC_FLAG_NONE,
            1u32
        );
        let mut full_buf = coff_buf_with_capacity(entries_buf.len + 24);
        axmeta_put_header(
            mut_view(full_buf),
            0x8664u16,
            1u16,
            0 as *const u8,
            0,
            0 as *const u8,
            0,
            entry_count
        );
        coff_buf_put_bytes(mut_view(full_buf), entries_buf.ptr as *const u8, entries_buf.len);
        let msec = objmodel_get_section_mut(mut_view(*obj), msec_id);
        section_add_bytes(unsafe { mut_view(*msec) }, full_buf.ptr as *const u8, full_buf.len);
        coff_buf_free(mut_view(full_buf));
    }
    coff_buf_free(mut_view(entries_buf));
}

fn driver_emit_objmodel_filtered_ex(
    ctx: mut_view<PipelineCtx>,
    run_drop_elab: bool,
    run_opt: bool,
    is_build_mode: bool,
    for_lib: bool,
    for_obj: bool,
    filter_fid_v: u32,
    include_std_weak: bool,
    emit_axmeta: bool,
    axmeta_keep_file_id: bool,
    obj: mut_view<ObjModel>
) -> bool {
    if session_has_errors(view(ctx.sess)) {
        return false;
    }
    pipe_lower_all_async_functions(mut_view(*ctx));
    if session_has_errors(view(ctx.sess)) {
        return false;
    }
    let text_name_sv = pipe_str_in_arena(mut_view(ctx.backend_arena), 132, 5);
    let rdata_name_sv = pipe_str_in_arena(mut_view(ctx.backend_arena), 137, 6);
    let mut text_id_v: u32 = 0u32;
    let mut rdata_id_v: u32 = 0u32;
    if is_build_mode {
        let rdata_sec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            rdata_name_sv.ptr,
            rdata_name_sv.len,
            SEC_RODATA,
            SEC_FLAG_READ,
            16u32
        );
        let text_sec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            text_name_sv.ptr,
            text_name_sv.len,
            SEC_CODE,
            SEC_FLAG_EXEC | SEC_FLAG_READ,
            16u32
        );
        rdata_id_v = rdata_sec_id.v;
        text_id_v = text_sec_id.v;
    } else {
        let text_sec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            text_name_sv.ptr,
            text_name_sv.len,
            SEC_CODE,
            SEC_FLAG_EXEC | SEC_FLAG_READ,
            16u32
        );
        let rdata_sec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            rdata_name_sv.ptr,
            rdata_name_sv.len,
            SEC_RODATA,
            SEC_FLAG_READ,
            16u32
        );
        text_id_v = text_sec_id.v;
        rdata_id_v = rdata_sec_id.v;
    }

    let mut fn_cap: usize = 0;
    let mut it0: *mut HirItem = ctx.hir.items;
    while (it0 as usize) != 0 {
        if (unsafe { (*it0).kind }) == HIR_ITEM_FN {
            fn_cap = fn_cap + 1;
        } else if (unsafe { (*it0).kind }) == HIR_ITEM_TRAIT {
            let mut tm0: *mut HirItem = unsafe { (*it0).members };
            while (tm0 as usize) != 0 {
                fn_cap = fn_cap + 1;
                tm0 = unsafe { (*tm0).next };
            }
        } else if (unsafe { (*it0).kind }) == HIR_ITEM_IMPL {
            // T161: default-method instances live in the impl, not in `hir.items`.
            let mut im0: *mut HirItem = unsafe { (*it0).members };
            while (im0 as usize) != 0 {
                if tc_is_default_inst(im0 as *const HirItem) {
                    fn_cap = fn_cap + 1;
                }
                im0 = unsafe { (*im0).next };
            }
        }
        it0 = unsafe { (*it0).next };
    }
    let alloc_fn_cap: usize = if fn_cap == 0 { 1 } else { fn_cap };

    let items_buf = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(alloc_fn_cap, size_of<*mut HirItem>()),
        align_of<*mut HirItem>()
    ) as *mut *mut HirItem;
    let bodies_buf = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(alloc_fn_cap, size_of<*mut MirBody>()),
        align_of<*mut MirBody>()
    ) as *mut *mut MirBody;
    let mut fn_count: usize = 0;

    backend_populate_hir_const_aggregates(view(ctx.sess), view(ctx.hir), mut_view(ctx.thir));
    let thir_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir)) };
    let hir_ptr = unsafe { address_of(ctx.hir.items) as *const HirFile };
    let str_in_ptr = unsafe { ptr_from_mut(mut_view(ctx.sess.interner)) };
    let db_ptr = unsafe { ptr_from_mut(mut_view(ctx.sess.source_db)) };
    let ti_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir.interner)) };

    let mut it: *mut HirItem = ctx.hir.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN {
            let it_fid_v = unsafe { (*it).span.file.v };
            let include_it: bool = filter_fid_v == 0u32 ||
                it_fid_v == filter_fid_v ||
                (!for_lib && pipe_is_mono_clone(ctx.mono.instances_head, it as *const HirItem)) ||
                (!for_lib && include_std_weak && pipe_fid_is_std(ctx.proj.files as *const ProjectFile, ctx.proj.file_count, it_fid_v));
            if include_it {
                let body = pipe_build_item_body(
                    mut_view(*ctx), run_drop_elab, run_opt, it, thir_ptr, hir_ptr, str_in_ptr, db_ptr
                );
                if (body as usize) != 0 {
                    unsafe {
                        *pipe_hir_item_ptr_at(items_buf, fn_count) = it;
                        *pipe_mir_body_ptr_at(bodies_buf, fn_count) = body;
                    }
                    fn_count = fn_count + 1;
                }
            }
        }
        it = unsafe { (*it).next };
    }

    // T161: the same holds for the instance of a default method for one implementing type (a member typeck adds to
    // the impl, not copied into `hir.items`); its body is the trait member's MIR instantiated for that type.
    // T153 (REQ-TRT-005): axiom0's `build` emits every monomorphization instance (driver/mono.c), and an instance
    // of a trait's default method has the trait member itself as its item - a member of a TRAIT item, which is not
    // in `hir.items` (impl members and generic clones are). Build those bodies too, so the image defines the
    // default method that the impls without an override call.
    if is_build_mode {
        let mut ei: *mut MonoInstance = ctx.mono.instances_head;
        while (ei as usize) != 0 {
            let ni: *mut HirItem = unsafe { (*ei).new_item };
            if (unsafe { (*ei).mir_body }) != 0 && (ni as usize) != 0 && (unsafe { (*ni).kind }) == HIR_ITEM_FN &&
                (filter_fid_v == 0u32 || !for_lib || (unsafe { (*ni).span.file.v }) == filter_fid_v) &&
                (pipe_is_trait_member(ctx.hir.items, ni) || tc_is_default_inst(ni as *const HirItem)) &&
                !pipe_item_in_buf(items_buf, fn_count, ni) {
                let body = pipe_build_item_body(
                    mut_view(*ctx), run_drop_elab, run_opt, ni, thir_ptr, hir_ptr, str_in_ptr, db_ptr
                );
                if (body as usize) != 0 && fn_count < fn_cap {
                    unsafe {
                        *pipe_hir_item_ptr_at(items_buf, fn_count) = ni;
                        *pipe_mir_body_ptr_at(bodies_buf, fn_count) = body;
                    }
                    fn_count = fn_count + 1;
                }
            }
            ei = unsafe { (*ei).next };
        }
    }

    // Emission order. axiom0 writes the instances newest-first (the order of its instance list); the port's
    // engine keeps the same list, so build mode follows it and puts anything the engine does not know last in
    // reverse `hir.items` order. Other modes keep `hir.items` order.
    let order_buf = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(fn_count + 1, size_of<u32>()),
        align_of<u32>()
    ) as *mut u32;
    let used_buf = arena_alloc_raw(mut_view(ctx.backend_arena), fn_count + 1, 1);
    let mut oi: usize = 0;
    while oi < fn_count {
        unsafe { *(used_buf + oi) = 0u8; }
        oi = oi + 1;
    }
    let mut order_n: usize = 0;
    if is_build_mode {
        let mut oinst: *mut MonoInstance = ctx.mono.instances_head;
        while (oinst as usize) != 0 {
            let oni: *mut HirItem = unsafe { (*oinst).new_item };
            let mut e: usize = 0;
            while e < fn_count {
                if (unsafe { *(used_buf + e) }) == 0u8 && (unsafe { *pipe_hir_item_ptr_at(items_buf, e) }) == oni {
                    unsafe {
                        *(used_buf + e) = 1u8;
                        *pipe_u32_at(order_buf, order_n) = e as u32;
                    }
                    order_n = order_n + 1;
                    break;
                }
                e = e + 1;
            }
            oinst = unsafe { (*oinst).next };
        }
        let mut r: usize = fn_count;
        while r > 0 {
            r = r - 1;
            if (unsafe { *(used_buf + r) }) == 0u8 {
                unsafe { *pipe_u32_at(order_buf, order_n) = r as u32; }
                order_n = order_n + 1;
            }
        }
    } else {
        while order_n < fn_count {
            unsafe { *pipe_u32_at(order_buf, order_n) = order_n as u32; }
            order_n = order_n + 1;
        }
    }

    let mut cstr_counter: u32 = 0u32;
    let mut panic_counter: u32 = 0u32;
    let ctable = backend_emit_const_tables(
        mut_view(ctx.backend_arena),
        bodies_buf as *const *mut MirBody,
        fn_count,
        view(ctx.hir),
        view(ctx.thir),
        view(ctx.sess.interner),
        mut_view(*obj),
        SectionId { v: rdata_id_v },
        mut_view(cstr_counter)
    );

    pipe_emit_tls_statics(mut_view(*ctx), filter_fid_v, mut_view(*obj));

    let mut drectve_buf = coff_buf_with_capacity(64);
    let mut fi: usize = 0;
    while fi < fn_count {
        let idx = (unsafe { *pipe_u32_at(order_buf, fi) }) as usize;
        let fn_item = unsafe { *pipe_hir_item_ptr_at(items_buf, idx) };
        let mir_body = unsafe { *pipe_mir_body_ptr_at(bodies_buf, idx) };
        let fn_ty = backend_resolve_item_fn_ty(
            mut_view(ctx.backend_arena),
            view(ctx.thir),
            fn_item as *const HirItem,
            mir_body as *const MirBody
        );
        let lir_fn_ty = fn_ty;

        let mut layout = X64FrameLayout {
            slot_offsets: 0 as *mut i32,
            slot_count: 0u32,
            frame_size: 0u32,
        };
        let mut lir_body: *mut LirBody = 0 as *mut LirBody;
        let mut mi_body: *mut X64MIBody = 0 as *mut X64MIBody;
        let v_err = backend_lower_fn_to_mc_checked_opt(
            mut_view(ctx.backend_arena),
            mir_body,
            hir_ptr,
            ti_ptr,
            str_in_ptr as *const StrInterner,
            ctable as *const LirConstTable,
            lir_fn_ty,
            fn_ty,
            mut_view(lir_body),
            mut_view(mi_body),
            mut_view(layout),
            run_opt
        );
        if v_err != X64_VERIFY_OK {
            coff_buf_free(mut_view(drectve_buf));
            return false;
        }

        backend_emit_fn_strings_rdata(
            mut_view(ctx.backend_arena),
            unsafe { mut_view(*mi_body) },
            mut_view(*obj),
            SectionId { v: rdata_id_v },
            fi as u32
        );

        let text_sec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
        unsafe {
            while ((*text_sec).bytes_len % 16) != 0 {
                x64_nop(mut_view(*text_sec));
            }
        }
        let func_start = unsafe { (*text_sec).bytes_len as u64 };

        if is_build_mode {
            driver_emit_build_mi_body_obj(
                mut_view(ctx.backend_arena),
                SectionId { v: text_id_v },
                SectionId { v: rdata_id_v },
                unsafe { view(*mi_body) },
                view(layout),
                mut_view(*obj),
                mut_view(panic_counter)
            );
        } else {
            x64_frame_emit_prologue(unsafe { mut_view(*text_sec) }, view(layout));
            let mut b: usize = 0;
            let bb_cnt = unsafe { (*mi_body).bb_count };
            while b < bb_cnt {
                let mbb = unsafe { x64_mi_bb_at((*mi_body).bbs, b) };
                let mut inst = unsafe { (*mbb).first_inst };
                while (inst as usize) != 0 {
                    unsafe {
                        let opc = (*inst).opcode;
                        if opc != X64_MI_MOV && opc != X64_MI_CMP && !x64_mi_is_sub64_atomic(opc) {
                            (*inst).size = 8u8;
                        } else if (*inst).size == 0u8 {
                            (*inst).size = 8u8;
                        }
                        x64_encode_mi_inst_obj(mut_view(*text_sec), view(*inst), view(layout), mut_view(*obj));
                        inst = (*inst).next;
                    }
                }
                b = b + 1;
            }
        }

        let text_sec_end = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
        let func_end = unsafe { (*text_sec_end).bytes_len as u64 };
        let func_size = func_end - func_start;
        let fname_id_v = unsafe { (*fn_item).name.v };
        let fname_sv = if fname_id_v == 0u32 {
            backend_alloc_anon_fn_sym(mut_view(ctx.backend_arena), unsafe { (*fn_item).symbol.v })
        } else {
            interner_get(view(ctx.sess.interner), StrId { v: fname_id_v })
        };
        let orig_name_ptr = thir_get_orig_item_name(view(ctx.thir), fn_item as *const HirItem);
        let orig_fname_sv = if (orig_name_ptr as usize) != 0 && (unsafe { *orig_name_ptr }) != 0u32 {
            interner_get(view(ctx.sess.interner), StrId { v: unsafe { *orig_name_ptr } })
        } else {
            fname_sv
        };
        let mut has_export: bool = false;
        let export_sv = pipe_item_get_export_info(
            fn_item as *const HirItem,
            view(ctx.sess.interner),
            mut_view(has_export)
        );
        let exp_fn_sv = if export_sv.len > 0 { export_sv } else { orig_fname_sv };
        let sym_bind: u32 = if !for_lib ||
                               (unsafe { (*fn_item).vis.kind }) != 0u8 ||
                               has_export ||
                               pipe_sv_has_dollar(view(fname_sv)) {
            SYM_GLOBAL
        } else {
            SYM_LOCAL
        };
        let _ = objmodel_add_symbol_bytes(
            mut_view(*obj),
            fname_sv.ptr,
            fname_sv.len,
            SectionId { v: text_id_v },
            func_start,
            func_size,
            sym_bind
        );
        let mut emitted_exp_sym: bool = sv_eq(view(exp_fn_sv), view(fname_sv));
        if (for_lib || for_obj) && has_export && exp_fn_sv.len > 0 && !emitted_exp_sym {
            if objmodel_find_symbol_bytes(view(*obj), exp_fn_sv.ptr, exp_fn_sv.len).v == 0u32 &&
               !pipe_other_fn_uses_name(
                   items_buf as *const *mut HirItem,
                   fn_count,
                   fn_item as *const HirItem,
                   view(ctx.sess.interner),
                   view(exp_fn_sv)
               ) {
                let _ = objmodel_add_symbol_bytes(
                    mut_view(*obj),
                    exp_fn_sv.ptr,
                    exp_fn_sv.len,
                    SectionId { v: text_id_v },
                    func_start,
                    func_size,
                    SYM_GLOBAL
                );
                emitted_exp_sym = true;
            }
        }
        if is_build_mode && !for_lib && has_export {
            let int_fn_sv = if for_obj && emitted_exp_sym { exp_fn_sv } else { fname_sv };
            pipe_append_drectve_export(mut_view(drectve_buf), view(exp_fn_sv), view(int_fn_sv), false);
        }
        if is_build_mode && !for_lib && pipe_item_has_entry_attr(fn_item as *const HirItem, view(ctx.sess.interner)) {
            pipe_emit_dll_entry_alias(
                mut_view(ctx.backend_arena),
                fn_ty,
                view(ctx.thir.interner),
                mut_view(*obj),
                SectionId { v: text_id_v },
                func_start,
                func_size
            );
        }
        if is_build_mode && !for_lib && pipe_sv_is_main(view(fname_sv)) {
            let ax_main_sv = pipe_str_in_arena(mut_view(ctx.backend_arena), 119, 7);
            let _ = objmodel_add_symbol_bytes(
                mut_view(*obj),
                ax_main_sv.ptr,
                ax_main_sv.len,
                SectionId { v: text_id_v },
                func_start,
                func_size,
                SYM_GLOBAL
            );
        }

        fi = fi + 1;
    }

    if is_build_mode {
        pipe_strip_unlinked_extern_c_prefixes(view(*ctx), mut_view(*obj));
        pipe_emit_exported_consts(
            mut_view(*ctx),
            for_lib,
            for_obj,
            filter_fid_v,
            SectionId { v: rdata_id_v },
            mut_view(*obj),
            mut_view(drectve_buf)
        );
        if !for_lib && drectve_buf.len > 0 {
            // ".drectve"
            let dname_arr: [8]u8 = [46u8, 100u8, 114u8, 101u8, 99u8, 116u8, 118u8, 101u8];
            let dname_buf = arena_alloc_raw(mut_view(ctx.backend_arena), 9, 1);
            let mut di: usize = 0;
            while di < 8 {
                unsafe { *(dname_buf + di) = dname_arr[di]; }
                di = di + 1;
            }
            unsafe { *(dname_buf + 8) = 0u8; }
            let dsec_id = objmodel_add_section_bytes(
                mut_view(*obj),
                dname_buf as *const u8,
                8,
                SEC_DIRECTIVE,
                SEC_FLAG_NONE,
                1u32
            );
            let dsec = objmodel_get_section_mut(mut_view(*obj), dsec_id);
            section_add_bytes(unsafe { mut_view(*dsec) }, drectve_buf.ptr as *const u8, drectve_buf.len);
        }
        // SPEC-27 §5.2: Internal compiler temporaries, string literal pools, and anonymous constant
        // tables (`.L*`) must be module-private (`SYM_LOCAL` / `IMAGE_SYM_CLASS_STATIC`) when emitting
        // relocatable `.obj` / `.lib` artifacts or per-module objects, and intra-object references to
        // local symbols must bind directly to the local definition.
        if for_lib || for_obj || filter_fid_v != 0u32 {
            let mut li: usize = 0;
            while li < obj.symbols_len {
                let lsym = unsafe { pipe_obj_symbol_at(obj.symbols, li) };
                if (unsafe { (*lsym).section_id.v }) != 0u32 && (unsafe { (*lsym).name_len }) >= 2 {
                    let lptr = unsafe { (*lsym).name };
                    if (lptr as usize) != 0 && (unsafe { *(lptr + 0) == 46u8 && *(lptr + 1) == 76u8 }) {
                        unsafe {
                            (*lsym).linkage = SYM_LOCAL;
                        }
                    }
                }
                li = li + 1;
            }
            let mut u: usize = 0;
            while u < obj.symbols_len {
                let usym = unsafe { pipe_obj_symbol_at(obj.symbols, u) };
                if (unsafe { (*usym).linkage }) == SYM_EXTERNAL && (unsafe { (*usym).section_id.v }) == 0u32 {
                    let u_sv = StrView { ptr: unsafe { (*usym).name }, len: unsafe { (*usym).name_len } };
                    let mut d: usize = 0;
                    while d < obj.symbols_len {
                        let dsym = unsafe { pipe_obj_symbol_at(obj.symbols, d) };
                        if (unsafe { (*dsym).section_id.v }) != 0u32 &&
                           (for_lib || (unsafe { (*dsym).linkage }) == SYM_LOCAL) {
                            let d_sv = StrView { ptr: unsafe { (*dsym).name }, len: unsafe { (*dsym).name_len } };
                            if sv_eq(view(u_sv), view(d_sv)) {
                                unsafe {
                                    (*usym).section_id = (*dsym).section_id;
                                    (*usym).value = (*dsym).value;
                                    (*usym).size = (*dsym).size;
                                    (*usym).linkage = SYM_LOCAL;
                                }
                                break;
                            }
                        }
                        d = d + 1;
                    }
                }
                u = u + 1;
            }
        }
        if emit_axmeta {
            pipe_emit_axmeta_section(
                mut_view(*ctx),
                items_buf as *const *mut HirItem,
                bodies_buf as *const *mut MirBody,
                fn_count,
                for_lib,
                for_obj,
                filter_fid_v,
                axmeta_keep_file_id,
                mut_view(*obj)
            );
        }
        if for_obj {
            pipe_lower_dll_imports_for_obj(
                ctx.hir.items,
                view(ctx.sess.interner),
                mut_view(ctx.backend_arena),
                SectionId { v: text_id_v },
                mut_view(*obj)
            );
        }
    }

    coff_buf_free(mut_view(drectve_buf));
    true
}

fn driver_emit_objmodel_filtered(
    ctx: mut_view<PipelineCtx>,
    run_drop_elab: bool,
    run_opt: bool,
    is_build_mode: bool,
    for_lib: bool,
    for_obj: bool,
    filter_fid_v: u32,
    obj: mut_view<ObjModel>
) -> bool {
    driver_emit_objmodel_filtered_ex(
        ctx,
        run_drop_elab,
        run_opt,
        is_build_mode,
        for_lib,
        for_obj,
        filter_fid_v,
        false,
        is_build_mode,
        !(for_lib || for_obj),
        obj
    )
}

fn driver_emit_objmodel(
    ctx: mut_view<PipelineCtx>,
    run_drop_elab: bool,
    run_opt: bool,
    is_build_mode: bool,
    obj: mut_view<ObjModel>
) -> bool {
    driver_emit_objmodel_filtered(
        ctx,
        run_drop_elab,
        run_opt,
        is_build_mode,
        false,
        false,
        0u32,
        obj
    )
}

pub fn driver_execute_inspect(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ctx_ptr = pipeline_ctx_alloc();
    let rc = driver_execute_inspect_ctx(unsafe { mut_view(*ctx_ptr) }, dopts, mut_view(*out_buf), mut_view(*err_buf));
    pipeline_ctx_dealloc(ctx_ptr);
    rc
}

fn driver_execute_check_ctx(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_OWN, mut_view(*out_buf));
    driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
    if ok && !session_has_errors(view(ctx.sess)) { AX_EXIT_OK } else { AX_EXIT_DIAG }
}

pub fn driver_execute_check(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ctx_ptr = pipeline_ctx_alloc();
    let rc = driver_execute_check_ctx(unsafe { mut_view(*ctx_ptr) }, dopts, mut_view(*out_buf), mut_view(*err_buf));
    pipeline_ctx_dealloc(ctx_ptr);
    rc
}

fn driver_execute_run_ctx(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_INTERP, mut_view(*out_buf));
    if !dopts.has_explicit_kind && ctx.proj.has_manifest && ctx.proj.manifest.kind.len > 0 {
        let mut mk: u32 = ARTIFACT_EXE;
        if !driver_parse_artifact_kind(view(ctx.proj.manifest.kind), mut_view(mk)) {
            emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_DRIVER_INVALID_ARTIFACT_KIND, 42, 48);
            driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
            return AX_EXIT_USAGE;
        }
        if mk != ARTIFACT_EXE {
            err_run_kind_not_supported(mut_view(*err_buf), view(ctx.proj.manifest.kind));
            return AX_EXIT_USAGE;
        }
    }
    if ctx.panic_msg.len > 0 && (ctx.panic_msg.ptr as usize) != 0 {
        push_pipe_str(mut_view(*err_buf), 108, 7);
        diag_buf_push_bytes(mut_view(*err_buf), ctx.panic_msg.ptr, ctx.panic_msg.len);
        diag_buf_push_byte(mut_view(*err_buf), 10u8);
    }
    driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
    if ctx.interp_rc == 124 || ctx.interp_rc == 125 {
        ctx.interp_rc
    } else if !ok || session_has_errors(view(ctx.sess)) {
        AX_EXIT_DIAG
    } else {
        ctx.interp_rc
    }
}

pub fn driver_execute_run(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ctx_ptr = pipeline_ctx_alloc();
    let rc = driver_execute_run_ctx(unsafe { mut_view(*ctx_ptr) }, dopts, mut_view(*out_buf), mut_view(*err_buf));
    pipeline_ctx_dealloc(ctx_ptr);
    rc
}

unsafe fn pipe_cstr_ptr_at(base: *mut *const u8, idx: usize) -> *mut *const u8 {
    ((base as usize) + opts_mul_usize(idx, size_of<*const u8>())) as *mut *const u8
}

unsafe fn pipe_archive_member_at(base: *mut CoffArchiveMember, idx: usize) -> *mut CoffArchiveMember {
    ((base as usize) + opts_mul_usize(idx, size_of<CoffArchiveMember>())) as *mut CoffArchiveMember
}

fn pipe_sv_to_cstr_in_arena(arena: mut_view<Arena>, sv: view<StrView>) -> *const u8 {
    let dst = arena_alloc_raw(mut_view(*arena), sv.len + 1, 1);
    let mut i: usize = 0;
    while i < sv.len {
        unsafe { *(dst + i) = *(sv.ptr + i); }
        i = i + 1;
    }
    unsafe { *(dst + sv.len) = 0u8; }
    dst as *const u8
}

fn pipe_stem_to_obj_name_in_arena(arena: mut_view<Arena>, path_sv: view<StrView>) -> StrView {
    let stem = derive_file_stem_sv(path_sv);
    let slen = if stem.len > 0 { stem.len } else { 3 };
    let dst = arena_alloc_raw(mut_view(*arena), slen + 5, 1);
    if stem.len > 0 {
        let mut i: usize = 0;
        while i < stem.len {
            unsafe { *(dst + i) = *(stem.ptr + i); }
            i = i + 1;
        }
    } else {
        unsafe {
            *(dst + 0) = 108u8;
            *(dst + 1) = 105u8;
            *(dst + 2) = 98u8;
        }
    }
    unsafe {
        *(dst + slen + 0) = 46u8;
        *(dst + slen + 1) = 111u8;
        *(dst + slen + 2) = 98u8;
        *(dst + slen + 3) = 106u8;
        *(dst + slen + 4) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: slen + 4 }
}

fn pipe_basename_in_arena(arena: mut_view<Arena>, path_sv: view<StrView>) -> StrView {
    if path_sv.len == 0 || (path_sv.ptr as usize) == 0 {
        return sv_empty();
    }
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i < path_sv.len {
        let ch = unsafe { *(path_sv.ptr + i) };
        if ch == 47u8 || ch == 92u8 {
            start = i + 1;
        }
        i = i + 1;
    }
    let blen = path_sv.len - start;
    let sub = StrView { ptr: unsafe { path_sv.ptr + start }, len: blen };
    arena_clone_sv(mut_view(*arena), view(sub))
}

fn pipe_collect_attr_libs(ctx: mut_view<PipelineCtx>, out_count: mut_view<usize>) -> *mut *const u8 {
    *out_count = 0;
    let mut cap: usize = 0;
    let mut it0: *mut HirItem = ctx.hir.items;
    while (it0 as usize) != 0 {
        let ik0 = unsafe { (*it0).kind };
        if ik0 == HIR_ITEM_FN || ik0 == HIR_ITEM_STATIC || ik0 == HIR_ITEM_EXTERN_BLOCK {
            cap = cap + 1;
        }
        it0 = unsafe { (*it0).next };
    }
    if cap == 0 {
        return 0 as *mut *const u8;
    }
    let arr = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(cap, size_of<*const u8>()),
        align_of<*const u8>()
    ) as *mut *const u8;
    let sv_arr = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(cap, size_of<StrView>()),
        align_of<StrView>()
    ) as *mut StrView;
    let mut n: usize = 0;
    let mut it: *mut HirItem = ctx.hir.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_FN || ik == HIR_ITEM_STATIC || ik == HIR_ITEM_EXTERN_BLOCK {
            let larg = pipe_item_get_link_arg(it as *const HirItem, view(ctx.sess.interner));
            if larg.len > 0 {
                let mut dup = false;
                let mut k: usize = 0;
                while k < n {
                    let prev_sv = sv_slot_get(sv_arr as *const StrView, k);
                    if sv_eq(view(prev_sv), view(larg)) {
                        dup = true;
                        break;
                    }
                    k = k + 1;
                }
                if !dup && n < cap {
                    sv_slot_set(sv_arr, n, view(larg));
                    let cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(larg));
                    unsafe { *pipe_cstr_ptr_at(arr, n) = cstr; }
                    n = n + 1;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    *out_count = n;
    arr
}

fn pipe_derive_companion_implib_path(arena: mut_view<Arena>, out_path: view<StrView>) -> StrView {
    if out_path.len == 0 || (out_path.ptr as usize) == 0 {
        let empty_sv = sv_empty();
        return derive_default_output_path(arena, view(empty_sv), ARTIFACT_LIB);
    }
    let mut base_start: usize = 0;
    let mut i: usize = 0;
    while i < out_path.len {
        let ch = unsafe { *(out_path.ptr + i) };
        if ch == 47u8 || ch == 92u8 {
            base_start = i + 1;
        }
        i = i + 1;
    }
    let mut prefix_len: usize = out_path.len;
    let mut j: usize = out_path.len;
    while j > base_start {
        j = j - 1;
        if (unsafe { *(out_path.ptr + j) }) == 46u8 {
            if j > base_start {
                prefix_len = j;
            }
            break;
        }
    }
    let dst = arena_alloc_raw(mut_view(*arena), prefix_len + 5, 1);
    let mut k: usize = 0;
    while k < prefix_len {
        unsafe { *(dst + k) = *(out_path.ptr + k); }
        k = k + 1;
    }
    unsafe {
        *(dst + prefix_len + 0) = 46u8;  // '.'
        *(dst + prefix_len + 1) = 108u8; // 'l'
        *(dst + prefix_len + 2) = 105u8; // 'i'
        *(dst + prefix_len + 3) = 98u8;  // 'b'
        *(dst + prefix_len + 4) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: prefix_len + 4 }
}

unsafe fn pipe_usize_at(base: *mut usize, idx: usize) -> *mut usize {
    ((base as usize) + opts_mul_usize(idx, size_of<usize>())) as *mut usize
}

fn pipe_sv_norm_eq(a: view<StrView>, b: view<StrView>) -> bool {
    if a.len != b.len || (a.ptr as usize) == 0 || (b.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let mut ca = unsafe { *(a.ptr + i) };
        let mut cb = unsafe { *(b.ptr + i) };
        if ca == 92u8 { ca = 47u8; }
        if cb == 92u8 { cb = 47u8; }
        if ca >= 65u8 && ca <= 90u8 { ca = ca + 32u8; }
        if cb >= 65u8 && cb <= 90u8 { cb = cb + 32u8; }
        if ca != cb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn pipe_sv_norm_ends_with(hay: view<StrView>, needle: view<StrView>) -> bool {
    if needle.len == 0 || (hay.len) < (needle.len) || (hay.ptr as usize) == 0 || (needle.ptr as usize) == 0 {
        return false;
    }
    if hay.len == needle.len {
        return pipe_sv_norm_eq(hay, needle);
    }
    let prefix_end = hay.len - needle.len;
    let sep = unsafe { *(hay.ptr + prefix_end - 1) };
    if sep != 47u8 && sep != 92u8 {
        return false;
    }
    let tail = StrView { ptr: unsafe { hay.ptr + prefix_end }, len: needle.len };
    pipe_sv_norm_eq(view(tail), needle)
}

fn pipe_find_target_fid_for_input(files: *const ProjectFile, file_count: usize, input_sv: view<StrView>) -> u32 {
    if !sv_ends_with_ax(input_sv) || file_count == 0 || (files as usize) == 0 {
        return 0u32;
    }
    let mut i: usize = 0;
    while i < file_count {
        let pf = unsafe { project_file_const_at(files, i) };
        if !pf_is_std(pf) {
            let disk = pf_get_disk_path(pf);
            let disp = pf_get_display_path(pf);
            if pipe_sv_norm_eq(view(disk), input_sv) ||
               pipe_sv_norm_eq(view(disp), input_sv) ||
               pipe_sv_norm_ends_with(view(disk), input_sv) ||
               pipe_sv_norm_ends_with(input_sv, view(disp)) {
                return pf_get_fid_v(pf);
            }
        }
        i = i + 1;
    }
    0u32
}

fn driver_execute_build_into_ctx(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>,
    out_artifact: *mut CoffBuf,
    write_to_disk: bool
) -> i32 {
    if dopts.rt_obj.len > 0 {
        let mut rt_buf = coff_buf_with_capacity(1024);
        let ok_rt = pe_build_runtime_coff_obj(mut_view(rt_buf));
        let mut ok_write: bool = ok_rt;
        if ok_rt && write_to_disk {
            ok_write = pe_write_buf_to_path_bytes(view(rt_buf), dopts.rt_obj.ptr, dopts.rt_obj.len);
        }
        if (dopts.pos_argc) < 2 {
            if ok_write && (out_artifact as usize) != 0 {
                coff_buf_put_bytes(unsafe { mut_view(*out_artifact) }, rt_buf.ptr as *const u8, rt_buf.len);
            }
            coff_buf_free(mut_view(rt_buf));
            return if ok_write { AX_EXIT_OK } else { AX_EXIT_DIAG };
        }
        coff_buf_free(mut_view(rt_buf));
        if !ok_write {
            return AX_EXIT_DIAG;
        }
    }

    let mut has_ax_sources: bool = ctx.main_text.len > 0;
    if !has_ax_sources {
        if dopts.pos_argc == 0 && dopts.input_file.len > 0 && !sv_is_obj_or_archive(view(dopts.input_file)) {
            has_ax_sources = true;
        } else {
            let mut pi: usize = 1;
            while pi < dopts.pos_argc {
                let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi);
                if !sv_is_obj_or_archive(view(arg_sv)) {
                    has_ax_sources = true;
                    break;
                }
                pi = pi + 1;
            }
        }
    }

    if has_ax_sources {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_MONO, mut_view(*out_buf));
        if !ok || session_has_errors(view(ctx.sess)) {
            driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
            return AX_EXIT_DIAG;
        }
    }

    let mut manifest_kind: u32 = ARTIFACT_EXE;
    if ctx.proj.has_manifest && ctx.proj.manifest.kind.len > 0 {
        if !driver_parse_artifact_kind(view(ctx.proj.manifest.kind), mut_view(manifest_kind)) {
            emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_DRIVER_INVALID_ARTIFACT_KIND, 42, 48);
            driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
            return AX_EXIT_USAGE;
        }
    }

    let mut eff_kind: u32 = dopts.artifact_kind;
    if dopts.emit_kind == EMIT_OBJ {
        eff_kind = ARTIFACT_OBJ;
    } else if !dopts.has_explicit_kind && ctx.proj.has_manifest && ctx.proj.manifest.kind.len > 0 {
        eff_kind = manifest_kind;
    }

    let mut out_path = StrView { ptr: dopts.output.ptr, len: dopts.output.len };
    if (eff_kind != dopts.artifact_kind && !dopts.has_explicit_kind) ||
       (ctx.proj.has_manifest && ctx.proj.manifest.name.len > 0) {
        let stem = derive_file_stem_sv(view(dopts.input_file));
        let def_from_in = derive_default_output_path(mut_view(ctx.backend_arena), view(stem), dopts.artifact_kind);
        if sv_eq(view(out_path), view(def_from_in)) {
            let mut eff_stem = stem;
            if ctx.proj.has_manifest && ctx.proj.manifest.name.len > 0 {
                eff_stem = ctx.proj.manifest.name;
            }
            out_path = derive_default_output_path(mut_view(ctx.backend_arena), view(eff_stem), eff_kind);
        }
    }

    let t0 = monotonic_ns();
    if has_ax_sources && ctx.host_fid.v != 0u32 {
        let mut hit = ctx.hir.items;
        while (hit as usize) != 0 {
            unsafe {
                if (*hit).span.file.v == ctx.host_fid.v {
                    (*hit).body = 0 as *mut HirBlock;
                }
                hit = (*hit).next;
            }
        }
    }

    let mut rc: i32 = AX_EXIT_OK;

    if eff_kind == ARTIFACT_LIB {
        let mut user_file_count: usize = 0;
        if has_ax_sources {
            if ctx.proj.file_count == 0 {
                user_file_count = 1;
            } else {
                let mut ui: usize = 0;
                while ui < ctx.proj.file_count {
                    let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, ui) };
                    if !pf_is_std(pf) {
                        user_file_count = user_file_count + 1;
                    }
                    ui = ui + 1;
                }
            }
        }
        let mut extra_obj_count: usize = 0;
        let mut pi0: usize = 1;
        while pi0 < dopts.pos_argc {
            let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi0);
            if sv_ends_with_obj(view(arg_sv)) {
                extra_obj_count = extra_obj_count + 1;
            }
            pi0 = pi0 + 1;
        }
        let member_cap = user_file_count + extra_obj_count + 1;
        let members = arena_alloc_raw(
            mut_view(ctx.backend_arena),
            opts_mul_usize(member_cap, size_of<CoffArchiveMember>()),
            align_of<CoffArchiveMember>()
        ) as *mut CoffArchiveMember;
        let mut member_count: usize = 0;

        if has_ax_sources {
            if ctx.proj.file_count == 0 {
                let mut mod_obj = objmodel_new();
                let ok_m = driver_emit_objmodel_filtered(
                    mut_view(*ctx),
                    true,
                    dopts.opt_O1,
                    true,
                    true,
                    false,
                    ctx.main_fid.v,
                    mut_view(mod_obj)
                );
                if !ok_m || session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                } else {
                    let rdata_sec = objmodel_get_section_mut(mut_view(mod_obj), SectionId { v: 1u32 });
                    if (rdata_sec as usize) != 0 && (unsafe { (*rdata_sec).bytes_len }) == 0 {
                        section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);
                    }
                    let mut mbuf = coff_buf_with_capacity(1024);
                    if !coff_write_to_buf(view(mod_obj), mut_view(mbuf)) {
                        rc = AX_EXIT_DIAG;
                    } else {
                        let mbytes = arena_alloc_raw(mut_view(ctx.backend_arena), mbuf.len + 1, 1);
                        let mut bi: usize = 0;
                        while bi < mbuf.len {
                            unsafe { *(mbytes + bi) = *(mbuf.ptr + bi); }
                            bi = bi + 1;
                        }
                        let mname = pipe_stem_to_obj_name_in_arena(mut_view(ctx.backend_arena), view(dopts.input_file));
                        let mslot = unsafe { pipe_archive_member_at(members, member_count) };
                        unsafe {
                            (*mslot).name = mname.ptr;
                            (*mslot).name_len = mname.len;
                            (*mslot).data = mbytes as *const u8;
                            (*mslot).data_len = mbuf.len;
                        }
                        member_count = member_count + 1;
                    }
                    coff_buf_free(mut_view(mbuf));
                }
                objmodel_free(mut_view(mod_obj));
            } else {
                let mut ui: usize = 0;
                while ui < ctx.proj.file_count && rc == AX_EXIT_OK {
                    let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, ui) };
                    if !pf_is_std(pf) {
                        let fid_v = pf_get_fid_v(pf);
                        let disp = pf_get_display_path(pf);
                        let filter_v: u32 = fid_v;
                        let mut mod_obj = objmodel_new();
                        let ok_m = driver_emit_objmodel_filtered(
                            mut_view(*ctx),
                            true,
                            dopts.opt_O1,
                            true,
                            true,
                            false,
                            filter_v,
                            mut_view(mod_obj)
                        );
                        if !ok_m || session_has_errors(view(ctx.sess)) {
                            rc = AX_EXIT_DIAG;
                        } else {
                            let rdata_sec = objmodel_get_section_mut(mut_view(mod_obj), SectionId { v: 1u32 });
                            if (rdata_sec as usize) != 0 && (unsafe { (*rdata_sec).bytes_len }) == 0 {
                                section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);
                            }
                            let mut mbuf = coff_buf_with_capacity(1024);
                            if !coff_write_to_buf(view(mod_obj), mut_view(mbuf)) {
                                rc = AX_EXIT_DIAG;
                            } else {
                                let mbytes = arena_alloc_raw(mut_view(ctx.backend_arena), mbuf.len + 1, 1);
                                let mut bi: usize = 0;
                                while bi < mbuf.len {
                                    unsafe { *(mbytes + bi) = *(mbuf.ptr + bi); }
                                    bi = bi + 1;
                                }
                                let mname = pipe_stem_to_obj_name_in_arena(mut_view(ctx.backend_arena), view(disp));
                                let mslot = unsafe { pipe_archive_member_at(members, member_count) };
                                unsafe {
                                    (*mslot).name = mname.ptr;
                                    (*mslot).name_len = mname.len;
                                    (*mslot).data = mbytes as *const u8;
                                    (*mslot).data_len = mbuf.len;
                                }
                                member_count = member_count + 1;
                            }
                            coff_buf_free(mut_view(mbuf));
                        }
                        objmodel_free(mut_view(mod_obj));
                    }
                    ui = ui + 1;
                }
            }
        }

        let mut pi1: usize = 1;
        while pi1 < dopts.pos_argc && rc == AX_EXIT_OK {
            let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi1);
            if sv_ends_with_obj(view(arg_sv)) {
                let mut ok_read: bool = false;
                let ok_ptr = unsafe { ptr_from_mut(mut_view(ok_read)) };
                let obj_bytes = host_read_file_in_arena(view(arg_sv), mut_view(ctx.backend_arena), ok_ptr);
                if !ok_read {
                    emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
                    rc = AX_EXIT_DIAG;
                } else {
                    let bname = pipe_basename_in_arena(mut_view(ctx.backend_arena), view(arg_sv));
                    let mslot = unsafe { pipe_archive_member_at(members, member_count) };
                    unsafe {
                        (*mslot).name = bname.ptr;
                        (*mslot).name_len = bname.len;
                        (*mslot).data = obj_bytes.ptr;
                        (*mslot).data_len = obj_bytes.len;
                    }
                    member_count = member_count + 1;
                }
            }
            pi1 = pi1 + 1;
        }

        if rc == AX_EXIT_OK {
            let mut lib_buf = coff_buf_with_capacity(4096);
            if !coff_write_archive_to_buf(members as *const CoffArchiveMember, member_count, mut_view(lib_buf)) {
                rc = AX_EXIT_DIAG;
            } else {
                if (out_artifact as usize) != 0 {
                    coff_buf_put_bytes(unsafe { mut_view(*out_artifact) }, lib_buf.ptr as *const u8, lib_buf.len);
                }
                if write_to_disk {
                    if !pe_write_buf_to_path_bytes(view(lib_buf), out_path.ptr, out_path.len) {
                        rc = AX_EXIT_DIAG;
                    }
                }
            }
            coff_buf_free(mut_view(lib_buf));
        }
    } else {
        let mut user_file_count: usize = 0;
        if has_ax_sources {
            if ctx.proj.file_count == 0 {
                user_file_count = 1;
            } else {
                let mut ui0: usize = 0;
                while ui0 < ctx.proj.file_count {
                    let pf0 = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, ui0) };
                    if !pf_is_std(pf0) {
                        user_file_count = user_file_count + 1;
                    }
                    ui0 = ui0 + 1;
                }
            }
        }

        let use_multi_mod_objs: bool = eff_kind != ARTIFACT_OBJ &&
            has_ax_sources &&
            write_to_disk &&
            user_file_count > 1 &&
            user_file_count <= 16;

        let mut obj = objmodel_new();
        let mut ok_obj: bool = true;
        let mut obj_datas: *mut *const u8 = 0 as *mut *const u8;
        let mut obj_lens: *mut usize = 0 as *mut usize;
        let mut obj_names: *mut *const u8 = 0 as *mut *const u8;
        let mut obj_count: usize = 0;

        if has_ax_sources && !use_multi_mod_objs {
            let mut target_fid_v: u32 = 0u32;
            if eff_kind == ARTIFACT_OBJ && user_file_count > 1 {
                target_fid_v = pipe_find_target_fid_for_input(
                    ctx.proj.files as *const ProjectFile,
                    ctx.proj.file_count,
                    view(dopts.input_file)
                );
            }
            ok_obj = driver_emit_objmodel_filtered_ex(
                mut_view(*ctx),
                true,
                dopts.opt_O1,
                true,
                false,
                eff_kind == ARTIFACT_OBJ,
                target_fid_v,
                target_fid_v != 0u32,
                true,
                eff_kind != ARTIFACT_OBJ,
                mut_view(obj)
            );
        } else if use_multi_mod_objs {
            obj_datas = arena_alloc_raw(
                mut_view(ctx.backend_arena),
                opts_mul_usize(user_file_count, size_of<*const u8>()),
                align_of<*const u8>()
            ) as *mut *const u8;
            obj_lens = arena_alloc_raw(
                mut_view(ctx.backend_arena),
                opts_mul_usize(user_file_count, size_of<usize>()),
                align_of<usize>()
            ) as *mut usize;
            obj_names = arena_alloc_raw(
                mut_view(ctx.backend_arena),
                opts_mul_usize(user_file_count, size_of<*const u8>()),
                align_of<*const u8>()
            ) as *mut *const u8;

            let mut ui: usize = 0;
            while ui < ctx.proj.file_count && ok_obj {
                let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, ui) };
                if !pf_is_std(pf) {
                    let fid_v = pf_get_fid_v(pf);
                    let disp = pf_get_display_path(pf);
                    let mut mod_obj = objmodel_new();
                    let ok_m = driver_emit_objmodel_filtered_ex(
                        mut_view(*ctx),
                        true,
                        dopts.opt_O1,
                        true,
                        false,
                        false,
                        fid_v,
                        obj_count == 0,
                        true,
                        true,
                        mut_view(mod_obj)
                    );
                    if !ok_m || session_has_errors(view(ctx.sess)) {
                        ok_obj = false;
                    } else {
                        let rdata_sec = objmodel_get_section_mut(mut_view(mod_obj), SectionId { v: 1u32 });
                        if (rdata_sec as usize) != 0 && (unsafe { (*rdata_sec).bytes_len }) == 0 {
                            section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);
                        }
                        let mut mbuf = coff_buf_with_capacity(1024);
                        if !coff_write_to_buf(view(mod_obj), mut_view(mbuf)) {
                            ok_obj = false;
                        } else {
                            let mbytes = arena_alloc_raw(mut_view(ctx.backend_arena), mbuf.len + 1, 1);
                            let mut bi: usize = 0;
                            while bi < mbuf.len {
                                unsafe { *(mbytes + bi) = *(mbuf.ptr + bi); }
                                bi = bi + 1;
                            }
                            let mname = pipe_stem_to_obj_name_in_arena(mut_view(ctx.backend_arena), view(disp));
                            unsafe {
                                *pipe_cstr_ptr_at(obj_datas, obj_count) = mbytes as *const u8;
                                *pipe_usize_at(obj_lens, obj_count) = mbuf.len;
                                *pipe_cstr_ptr_at(obj_names, obj_count) = mname.ptr;
                            }
                            obj_count = obj_count + 1;
                        }
                        coff_buf_free(mut_view(mbuf));
                    }
                    objmodel_free(mut_view(mod_obj));
                }
                ui = ui + 1;
            }
        }

        if !ok_obj || session_has_errors(view(ctx.sess)) {
            rc = AX_EXIT_DIAG;
        } else {
            if has_ax_sources && !use_multi_mod_objs {
                // Ensure .rdata section (SectionId 1 in build mode) is non-empty, matching build.c:620-622
                let rdata_sec = objmodel_get_section_mut(mut_view(obj), SectionId { v: 1u32 });
                if (rdata_sec as usize) != 0 && (unsafe { (*rdata_sec).bytes_len }) == 0 {
                    section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);
                }
            }

            if eff_kind == ARTIFACT_OBJ {
                if (out_artifact as usize) != 0 {
                    if !coff_write_to_buf(view(obj), unsafe { mut_view(*out_artifact) }) {
                        rc = AX_EXIT_DIAG;
                    }
                }
                if rc == AX_EXIT_OK && write_to_disk {
                    if !coff_write_path_bytes(view(obj), out_path.ptr, out_path.len) {
                        rc = AX_EXIT_DIAG;
                    }
                }
            } else {
                let stack_res: u32 = driver_parse_u32_decimal(view(dopts.stack_reserve), 1048576u32);
                let sink_ptr = unsafe { ptr_from_mut(mut_view(ctx.sess.diag_sink)) };
                let mut pe_buf = coff_buf_with_capacity(4096);

                let mut extra_input_count: usize = 0;
                let mut pi: usize = 1;
                while pi < dopts.pos_argc {
                    let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi);
                    if sv_is_obj_or_archive(view(arg_sv)) {
                        extra_input_count = extra_input_count + 1;
                    }
                    pi = pi + 1;
                }

                let mut attr_lib_count: usize = 0;
                let attr_ptrs = if has_ax_sources {
                    pipe_collect_attr_libs(mut_view(*ctx), mut_view(attr_lib_count))
                } else {
                    0 as *mut *const u8
                };

                if !use_multi_mod_objs && eff_kind == ARTIFACT_EXE && has_ax_sources && extra_input_count == 0 && dopts.lib_dir_count == 0 && dopts.lib_name_count == 0 && attr_lib_count == 0 {
                    if !pe_link_objmodel_to_buf(view(obj), stack_res, mut_view(pe_buf), sink_ptr) {
                        rc = AX_EXIT_DIAG;
                    } else {
                        if (out_artifact as usize) != 0 {
                            coff_buf_put_bytes(unsafe { mut_view(*out_artifact) }, pe_buf.ptr as *const u8, pe_buf.len);
                        }
                        if write_to_disk {
                            if !pe_write_buf_to_path_bytes(view(pe_buf), out_path.ptr, out_path.len) {
                                rc = AX_EXIT_DIAG;
                            }
                        }
                    }
                } else {
                    let mut mem_obj_buf = coff_buf_with_capacity(1024);
                    let mut mem_ok: bool = true;
                    if has_ax_sources && !use_multi_mod_objs {
                        mem_ok = coff_write_to_buf(view(obj), mut_view(mem_obj_buf));
                        if mem_ok {
                            obj_datas = arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                size_of<*const u8>(),
                                align_of<*const u8>()
                            ) as *mut *const u8;
                            obj_lens = arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                size_of<usize>(),
                                align_of<usize>()
                            ) as *mut usize;
                            obj_names = arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                size_of<*const u8>(),
                                align_of<*const u8>()
                            ) as *mut *const u8;
                            let mname = pipe_stem_to_obj_name_in_arena(mut_view(ctx.backend_arena), view(dopts.input_file));
                            unsafe {
                                *pipe_cstr_ptr_at(obj_datas, 0) = mem_obj_buf.ptr as *const u8;
                                *pipe_usize_at(obj_lens, 0) = mem_obj_buf.len;
                                *pipe_cstr_ptr_at(obj_names, 0) = mname.ptr;
                            }
                            obj_count = 1;
                        }
                    }
                    if !mem_ok {
                        rc = AX_EXIT_DIAG;
                    } else {
                        let in_ptrs = if extra_input_count > 0 {
                            arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                opts_mul_usize(extra_input_count, size_of<*const u8>()),
                                align_of<*const u8>()
                            ) as *mut *const u8
                        } else {
                            0 as *mut *const u8
                        };
                        let mut in_idx: usize = 0;
                        let mut pi2: usize = 1;
                        while pi2 < dopts.pos_argc {
                            let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi2);
                            if sv_is_obj_or_archive(view(arg_sv)) {
                                let cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(arg_sv));
                                unsafe { *pipe_cstr_ptr_at(in_ptrs, in_idx) = cstr; }
                                in_idx = in_idx + 1;
                            }
                            pi2 = pi2 + 1;
                        }

                        let dir_ptrs = if dopts.lib_dir_count > 0 {
                            arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                opts_mul_usize(dopts.lib_dir_count, size_of<*const u8>()),
                                align_of<*const u8>()
                            ) as *mut *const u8
                        } else {
                            0 as *mut *const u8
                        };
                        let mut di: usize = 0;
                        while di < dopts.lib_dir_count {
                            let d_sv = sv_slot_get(dopts.lib_dirs as *const StrView, di);
                            let cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(d_sv));
                            unsafe { *pipe_cstr_ptr_at(dir_ptrs, di) = cstr; }
                            di = di + 1;
                        }

                        let lib_ptrs = if dopts.lib_name_count > 0 {
                            arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                opts_mul_usize(dopts.lib_name_count, size_of<*const u8>()),
                                align_of<*const u8>()
                            ) as *mut *const u8
                        } else {
                            0 as *mut *const u8
                        };
                        let mut li: usize = 0;
                        while li < dopts.lib_name_count {
                            let l_sv = sv_slot_get(dopts.lib_names as *const StrView, li);
                            let cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(l_sv));
                            unsafe { *pipe_cstr_ptr_at(lib_ptrs, li) = cstr; }
                            li = li + 1;
                        }

                        if eff_kind == ARTIFACT_DLL {
                            let dll_base_sv = pipe_basename_in_arena(mut_view(ctx.backend_arena), view(out_path));
                            let dll_name_cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(dll_base_sv));
                            let implib_sv = if dopts.implib.len > 0 {
                                dopts.implib
                            } else {
                                pipe_derive_companion_implib_path(mut_view(ctx.backend_arena), view(out_path))
                            };
                            let mut implib_buf = coff_buf_with_capacity(2048);
                            if !pe_link_dll_multi_objs_and_libs_to_buf(
                                obj_datas as *const *const u8,
                                obj_lens as *const usize,
                                obj_names as *const *const u8,
                                obj_count,
                                in_ptrs as *const *const u8,
                                in_idx,
                                dir_ptrs as *const *const u8,
                                dopts.lib_dir_count,
                                lib_ptrs as *const *const u8,
                                dopts.lib_name_count,
                                attr_ptrs as *const *const u8,
                                attr_lib_count,
                                dll_name_cstr,
                                stack_res,
                                mut_view(pe_buf),
                                mut_view(implib_buf),
                                sink_ptr
                            ) {
                                rc = AX_EXIT_DIAG;
                            } else {
                                if (out_artifact as usize) != 0 {
                                    coff_buf_put_bytes(unsafe { mut_view(*out_artifact) }, pe_buf.ptr as *const u8, pe_buf.len);
                                }
                                if write_to_disk {
                                    if !pe_write_buf_to_path_bytes(view(pe_buf), out_path.ptr, out_path.len) {
                                        rc = AX_EXIT_DIAG;
                                    } else if !pe_write_buf_to_path_bytes(view(implib_buf), implib_sv.ptr, implib_sv.len) {
                                        rc = AX_EXIT_DIAG;
                                    }
                                }
                            }
                            coff_buf_free(mut_view(implib_buf));
                        } else {
                            if !pe_link_multi_objs_and_libs_to_buf(
                                obj_datas as *const *const u8,
                                obj_lens as *const usize,
                                obj_names as *const *const u8,
                                obj_count,
                                in_ptrs as *const *const u8,
                                in_idx,
                                dir_ptrs as *const *const u8,
                                dopts.lib_dir_count,
                                lib_ptrs as *const *const u8,
                                dopts.lib_name_count,
                                attr_ptrs as *const *const u8,
                                attr_lib_count,
                                stack_res,
                                mut_view(pe_buf),
                                sink_ptr
                            ) {
                                rc = AX_EXIT_DIAG;
                            } else {
                                if (out_artifact as usize) != 0 {
                                    coff_buf_put_bytes(unsafe { mut_view(*out_artifact) }, pe_buf.ptr as *const u8, pe_buf.len);
                                }
                                if write_to_disk {
                                    if !pe_write_buf_to_path_bytes(view(pe_buf), out_path.ptr, out_path.len) {
                                        rc = AX_EXIT_DIAG;
                                    }
                                }
                            }
                        }
                    }
                    coff_buf_free(mut_view(mem_obj_buf));
                }
                coff_buf_free(mut_view(pe_buf));
            }
        }
        objmodel_free(mut_view(obj));
    }
    let t1 = monotonic_ns();
    if dopts.time_passes {
        let elapsed: u64 = if t1 >= t0 { t1 - t0 } else { 0u64 };
        format_pass_time(mut_view(*out_buf), 9u32, elapsed);
    }

    driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
    if session_has_errors(view(ctx.sess)) {
        rc = AX_EXIT_DIAG;
    }
    rc
}

pub fn driver_execute_build_into(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>,
    out_artifact: *mut CoffBuf,
    write_to_disk: bool
) -> i32 {
    let ctx_ptr = pipeline_ctx_alloc();
    let rc = driver_execute_build_into_ctx(
        unsafe { mut_view(*ctx_ptr) },
        dopts,
        mut_view(*out_buf),
        mut_view(*err_buf),
        out_artifact,
        write_to_disk
    );
    pipeline_ctx_dealloc(ctx_ptr);
    rc
}

pub fn driver_execute_build(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    driver_execute_build_into(dopts, mut_view(*out_buf), mut_view(*err_buf), 0 as *mut CoffBuf, true)
}

// =============================================================================
// 4. Top-Level Driver Entrypoints (`driver_run_args`, `driver_main`)
// =============================================================================

pub fn driver_run_args(
    args: *const StrView,
    argc: usize,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let dopts_ptr = driver_options_alloc();

    let parse_rc = driver_parse_cli(args, argc, unsafe { mut_view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    if parse_rc != AX_EXIT_OK {
        driver_options_dealloc(dopts_ptr);
        return parse_rc;
    }

    let cmd = unsafe { (*dopts_ptr).cmd };
    if cmd == CMD_HELP || cmd == CMD_VERSION || cmd == CMD_FEATURES {
        driver_options_dealloc(dopts_ptr);
        return AX_EXIT_OK;
    }

    let mut rc: i32 = AX_EXIT_USAGE;
    if cmd == CMD_INSPECT {
        rc = driver_execute_inspect(unsafe { view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    } else if cmd == CMD_CHECK {
        rc = driver_execute_check(unsafe { view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    } else if cmd == CMD_RUN {
        rc = driver_execute_run(unsafe { view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    } else if cmd == CMD_BUILD {
        rc = driver_execute_build(unsafe { view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    }

    driver_options_dealloc(dopts_ptr);
    rc
}

fn flush_buf_to_stdio(which: u32, buf: view<DiagBuffer>) {
    if buf.len == 0 || (buf.ptr as usize) == 0 {
        return;
    }
    let h = stdio(which);
    if h < 0i64 {
        return;
    }
    let mut written: usize = 0;
    while written < buf.len {
        let p = unsafe { (buf.ptr as *const u8) + written };
        let wr = unsafe { write(h, p, buf.len - written) };
        if wr <= 0i64 {
            break;
        }
        written = written + (wr as usize);
    }
}

pub fn driver_main() -> i32 {
    let mut arg_arena = arena_new();
    let raw_argc = args_count();
    let argc: usize = if raw_argc == 0 { 1 } else { raw_argc };
    let argv_bytes = opts_mul_usize(argc, size_of<StrView>());
    let argv = unsafe { heap_alloc(argv_bytes, align_of<StrView>()) as *mut StrView };

    if raw_argc == 0 {
        let def_bin = arena_alloc_raw(mut_view(arg_arena), 7, 1);
        let mut k: usize = 0;
        while k < 6 {
            unsafe { *(def_bin + k) = PIPELINE_STR_TABLE[126 + k]; }
            k = k + 1;
        }
        unsafe {
            *(def_bin + 6) = 0u8;
        }
        let s0 = StrView { ptr: def_bin as *const u8, len: 6 };
        sv_slot_set(argv, 0, view(s0));
    } else {
        let mut i: usize = 0;
        while i < raw_argc {
            let need = unsafe { arg(i, 0 as *mut u8, 0) };
            if need <= 0i64 {
                let empty_sv = sv_empty();
                sv_slot_set(argv, i, view(empty_sv));
            } else {
                let ulen = need as usize;
                let abuf = arena_alloc_raw(mut_view(arg_arena), ulen + 1, 1);
                let _ = unsafe { arg(i, abuf, ulen) };
                unsafe {
                    *(abuf + ulen) = 0u8;
                }
                let si = StrView { ptr: abuf as *const u8, len: ulen };
                sv_slot_set(argv, i, view(si));
            }
            i = i + 1;
        }
    }

    let mut out_buf = diag_buf_new();
    let mut err_buf = diag_buf_new();

    let rc = driver_run_args(argv as *const StrView, argc, mut_view(out_buf), mut_view(err_buf));
    flush_buf_to_stdio(1u32, view(out_buf));
    flush_buf_to_stdio(2u32, view(err_buf));

    diag_buf_free(mut_view(out_buf));
    diag_buf_free(mut_view(err_buf));
    unsafe {
        heap_free(argv as *mut u8, argv_bytes, align_of<StrView>());
    }
    arena_destroy(mut_view(arg_arena));
    rc
}
