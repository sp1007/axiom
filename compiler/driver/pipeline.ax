// 1. Constant String Table for Pipeline Stage Names, Panics, and Symbols
// =============================================================================

//   0..6   (6):  "time: "
//   6..16  (10): "source    "
//  16..26  (10): "lex       "
//  26..36  (10): "parse     "
//  36..46  (10): "resolve   "
//  46..56  (10): "hir       "
//  56..66  (10): "typeck    "
//  66..76  (10): "own       "
//  76..86  (10): "run       "
//  86..96  (10): "mono      "
//  96..106 (10): "build     "
// 106..108 (2):  "s\n"
// 108..115 (7):  "panic: "
// 115..119 (4):  "main"
// 119..126 (7):  "ax_main"
// 126..132 (6):  "axiom0"
// 132..137 (5):  ".text"
// 137..143 (6):  ".rdata"
// 143..151 (8):  ".Lpanic."
// 151..162 (11): "axiom_panic"
// 162..178 (16): "assertion failed"
const PIPELINE_STR_TABLE: [178]u8 = [
    // 0..6: "time: "
    116u8, 105u8, 109u8, 101u8, 58u8, 32u8,
    // 6..16: "source    "
    115u8, 111u8, 117u8, 114u8, 99u8, 101u8, 32u8, 32u8, 32u8, 32u8,
    // 16..26: "lex       "
    108u8, 101u8, 120u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 26..36: "parse     "
    112u8, 97u8, 114u8, 115u8, 101u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 36..46: "resolve   "
    114u8, 101u8, 115u8, 111u8, 108u8, 118u8, 101u8, 32u8, 32u8, 32u8,
    // 46..56: "hir       "
    104u8, 105u8, 114u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 56..66: "typeck    "
    116u8, 121u8, 112u8, 101u8, 99u8, 107u8, 32u8, 32u8, 32u8, 32u8,
    // 66..76: "own       "
    111u8, 119u8, 110u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 76..86: "run       "
    114u8, 117u8, 110u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 86..96: "mono      "
    109u8, 111u8, 110u8, 111u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 96..106: "build     "
    98u8, 117u8, 105u8, 108u8, 100u8, 32u8, 32u8, 32u8, 32u8, 32u8,
    // 106..108: "s\n"
    115u8, 10u8,
    // 108..115: "panic: "
    112u8, 97u8, 110u8, 105u8, 99u8, 58u8, 32u8,
    // 115..119: "main"
    109u8, 97u8, 105u8, 110u8,
    // 119..126: "ax_main"
    97u8, 120u8, 95u8, 109u8, 97u8, 105u8, 110u8,
    // 126..132: "axiom0"
    97u8, 120u8, 105u8, 111u8, 109u8, 48u8,
    // 132..137: ".text"
    46u8, 116u8, 101u8, 120u8, 116u8,
    // 137..143: ".rdata"
    46u8, 114u8, 100u8, 97u8, 116u8, 97u8,
    // 143..151: ".Lpanic." (ADR-0035 section 1)
    46u8, 76u8, 112u8, 97u8, 110u8, 105u8, 99u8, 46u8,
    // 151..162: "axiom_panic"
    97u8, 120u8, 105u8, 111u8, 109u8, 95u8, 112u8, 97u8, 110u8, 105u8, 99u8,
    // 162..178: "assertion failed"
    97u8, 115u8, 115u8, 101u8, 114u8, 116u8, 105u8, 111u8, 110u8, 32u8, 102u8, 97u8, 105u8, 108u8, 101u8, 100u8,
];

fn push_pipe_str(out: mut_view<DiagBuffer>, off: usize, n: usize) {
    let mut i: usize = 0;
    while i < n {
        diag_buf_push_byte(mut_view(*out), PIPELINE_STR_TABLE[off + i]);
        i = i + 1;
    }
}

fn sv_contains_host_str(sv: view<StrView>) -> bool {
    let sv_len = sv.len;
    if sv_len < 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i + 4 <= sv.len {
        let b0 = unsafe { *(sv.ptr + i) };
        let b1 = unsafe { *(sv.ptr + i + 1) };
        let b2 = unsafe { *(sv.ptr + i + 2) };
        let b3 = unsafe { *(sv.ptr + i + 3) };
        if b0 == 104u8 && b1 == 111u8 && b2 == 115u8 && b3 == 116u8 {
            return true;
        }
        i = i + 1;
    }
    false
}

fn clone_lex_strings_to_arena(lex_res: mut_view<LexResult>, dst_arena: mut_view<Arena>) {
    let mut ti: usize = 0;
    while ti < lex_res.token_count {
        let tp = unsafe { lex_token_ptr(lex_res.tokens, ti) };
        let s_ptr = unsafe { (*tp).str_ptr };
        let s_len = unsafe { (*tp).str_len };
        if (s_ptr as usize) != 0 {
            let dst = arena_alloc_raw(mut_view(*dst_arena), s_len + 1, 1);
            let mut bi: usize = 0;
            while bi < s_len {
                unsafe {
                    *(dst + bi) = *(s_ptr + bi);
                }
                bi = bi + 1;
            }
            unsafe {
                *(dst + s_len) = 0u8;
                (*tp).str_ptr = dst as *const u8;
            }
        }
        ti = ti + 1;
    }
}

// Formats `"time: %-10s %.4fs\n"` into `out`, matching `pipeline.c:ax_pipeline_run`.
pub fn format_pass_time(out: mut_view<DiagBuffer>, stage_idx: u32, elapsed_ns: u64) {
    push_pipe_str(mut_view(*out), 0, 6);
    let name_off: usize = 6 + opts_mul_usize(stage_idx as usize, 10);
    push_pipe_str(mut_view(*out), name_off, 10);
    diag_buf_push_byte(mut_view(*out), 32u8);

    // Round nanoseconds to 0.0001s (100,000 ns) units
    let elapsed_i64: i64 = if (elapsed_ns as i64) >= 0i64 { elapsed_ns as i64 } else { 0i64 };
    let tenths_ms: i64 = (elapsed_i64 + 50000i64) / 100000i64;
    let secs: u32 = (tenths_ms / 10000i64) as u32;
    let frac: i32 = (tenths_ms % 10000i64) as i32;

    diag_buf_push_u32(mut_view(*out), secs);
    diag_buf_push_byte(mut_view(*out), 46u8);
    let d3: u8 = (((frac / 1000) % 10) as u8) + 48u8;
    let d2: u8 = (((frac / 100) % 10) as u8) + 48u8;
    let d1: u8 = (((frac / 10) % 10) as u8) + 48u8;
    let d0: u8 = ((frac % 10) as u8) + 48u8;
    diag_buf_push_byte(mut_view(*out), d3);
    diag_buf_push_byte(mut_view(*out), d2);
    diag_buf_push_byte(mut_view(*out), d1);
    diag_buf_push_byte(mut_view(*out), d0);
    push_pipe_str(mut_view(*out), 106, 2);
}

// =============================================================================
// 2. Pipeline Context (`PipelineCtx`) & Stage Execution
// =============================================================================

pub struct PipelineCtx {
    pub sess: CompilerSession,
    pub proj: Project,
    pub main_fid: FileId,
    pub host_fid: FileId,
    pub main_text: StrView,
    pub is_mir_input: bool,
    pub uses_host: bool,
    pub lex_res: LexResult,
    pub lex_res_active: bool,
    pub parse_arena: Arena,
    pub resolve_arena: Arena,
    pub hir_arena: Arena,
    pub mir_arena: Arena,
    pub backend_arena: Arena,
    pub ast: Ast,
    pub rmap: ResolveMap,
    pub hir: HirFile,
    pub thir: Thir,
    pub mono: MonoEngine,
    pub time_ns: [10]u64,
    pub interp_rc: i32,
    pub panic_msg: StrView,
}

pub fn pipeline_ctx_init(ctx: mut_view<PipelineCtx>) {
    session_init(mut_view(ctx.sess));
    project_init(mut_view(ctx.proj));
    ctx.main_fid.v = 0u32;
    ctx.host_fid.v = 0u32;
    sv_clear(mut_view(ctx.main_text));
    ctx.is_mir_input = false;
    ctx.uses_host = false;
    opts_arena_init(mut_view(ctx.lex_res.arena));
    ctx.lex_res.tokens = 0 as *mut Token;
    ctx.lex_res.token_count = 0;
    ctx.lex_res.token_cap = 0;
    ctx.lex_res.comments = 0 as *mut Comment;
    ctx.lex_res.comment_count = 0;
    ctx.lex_res.comment_cap = 0;
    ctx.lex_res_active = true;
    opts_arena_init(mut_view(ctx.parse_arena));
    opts_arena_init(mut_view(ctx.resolve_arena));
    opts_arena_init(mut_view(ctx.hir_arena));
    opts_arena_init(mut_view(ctx.mir_arena));
    opts_arena_init(mut_view(ctx.backend_arena));
    ctx.ast.items = 0 as *mut AstItem;
    ctx.rmap.node_map.keys = 0 as *mut usize;
    ctx.rmap.node_map.vals = 0 as *mut SymbolId;
    ctx.rmap.node_map.states = 0 as *mut u8;
    ctx.rmap.node_map.len = 0;
    ctx.rmap.node_map.cap = 0;
    ctx.rmap.module_access_nodes.keys = 0 as *mut usize;
    ctx.rmap.module_access_nodes.vals = 0 as *mut SymbolId;
    ctx.rmap.module_access_nodes.states = 0 as *mut u8;
    ctx.rmap.module_access_nodes.len = 0;
    ctx.rmap.module_access_nodes.cap = 0;
    ctx.rmap.extern_nodes.keys = 0 as *mut usize;
    ctx.rmap.extern_nodes.vals = 0 as *mut SymbolId;
    ctx.rmap.extern_nodes.states = 0 as *mut u8;
    ctx.rmap.extern_nodes.len = 0;
    ctx.rmap.extern_nodes.cap = 0;
    ctx.rmap.next_symbol_v = 1u32;
    ctx.rmap.next_std_symbol_v = 10000u32;
    ctx.rmap.naming_ctx = 0 as *mut NamingCtx;
    ctx.hir.items = 0 as *mut HirItem;
    opts_arena_init(mut_view(ctx.thir.interner.arena));
    thir_init(mut_view(ctx.thir));
    let hir_arena_ptr = unsafe { ptr_from_mut(mut_view(ctx.hir_arena)) };
    ctx.mono.arena = hir_arena_ptr;
    ctx.mono.instances_head = 0 as *mut MonoInstance;
    ctx.mono.instances_tail = 0 as *mut MonoInstance;
    ctx.mono.instance_count = 0;
    ctx.mono.work_head = 0 as *mut MonoInstance;
    ctx.mono.work_tail = 0 as *mut MonoInstance;
    ctx.mono.next_counter = 0u32;
    ctx.mono.next_sym_id = 0u32;
    mono_engine_init(mut_view(ctx.mono), hir_arena_ptr);
    let mut i: usize = 0;
    while i < 10 {
        ctx.time_ns[i] = 0u64;
        i = i + 1;
    }
    ctx.interp_rc = 0;
    sv_clear(mut_view(ctx.panic_msg));
}

pub fn pipeline_ctx_free(ctx: mut_view<PipelineCtx>) {
    if ctx.lex_res_active {
        ax_lex_result_free(mut_view(ctx.lex_res));
        ctx.lex_res_active = false;
    }
    resolve_map_free(mut_view(ctx.rmap));
    thir_free(mut_view(ctx.thir));
    arena_destroy(mut_view(ctx.backend_arena));
    arena_destroy(mut_view(ctx.mir_arena));
    arena_destroy(mut_view(ctx.hir_arena));
    arena_destroy(mut_view(ctx.resolve_arena));
    arena_destroy(mut_view(ctx.parse_arena));
    project_free(mut_view(ctx.proj));
    session_free(mut_view(ctx.sess));
}

pub fn pipeline_ctx_alloc() -> *mut PipelineCtx {
    let sz = size_of<PipelineCtx>();
    let p = unsafe { heap_alloc(sz, align_of<PipelineCtx>()) };
    let mut i: usize = 0;
    while i < sz {
        unsafe { *(p + i) = 0u8; }
        i = i + 1;
    }
    let ctx_ptr = p as *mut PipelineCtx;
    pipeline_ctx_init(unsafe { mut_view(*ctx_ptr) });
    ctx_ptr
}

pub fn pipeline_ctx_dealloc(ctx_ptr: *mut PipelineCtx) {
    if (ctx_ptr as usize) == 0 {
        return;
    }
    pipeline_ctx_free(unsafe { mut_view(*ctx_ptr) });
    unsafe {
        heap_free(ctx_ptr as *mut u8, size_of<PipelineCtx>(), align_of<PipelineCtx>());
    }
}

pub fn pipeline_stage_source(ctx: mut_view<PipelineCtx>, dopts: view<DriverOptions>) -> bool {
    if dopts.input_file.len == 0 {
        emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
        return false;
    }

    if sv_ends_with_mir(view(dopts.input_file)) {
        ctx.is_mir_input = true;
        let mut ok: bool = false;
        let ok_ptr = unsafe { ptr_from_mut(mut_view(ok)) };
        let text = host_read_file_in_arena(view(dopts.input_file), mut_view(ctx.proj.arena), ok_ptr);
        if !ok {
            emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
            return false;
        }
        let in_file = StrView { ptr: dopts.input_file.ptr, len: dopts.input_file.len };
        let fid = session_add_virtual_file(mut_view(ctx.sess), in_file, text);
        let fid_v = fid.v;
        ctx.main_fid.v = fid_v;
        let mtxt = session_file_text(view(ctx.sess), FileId { v: fid_v });
        sv_copy_to(mut_view(ctx.main_text), view(mtxt));
        return true;
    }

    if !project_discover(
        view(dopts.input_file),
        view(dopts.std_root),
        mut_view(ctx.proj),
        mut_view(ctx.sess.diag_sink)
    ) {
        return false;
    }

    if dopts.cmd == CMD_BUILD {
        let mut pi: usize = 1;
        while pi < dopts.pos_argc {
            let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi);
            if sv_ends_with_ax(view(arg_sv)) && !sv_eq(view(arg_sv), view(dopts.input_file)) {
                if !project_add_extra_ax_file(mut_view(ctx.proj), view(arg_sv), mut_view(ctx.sess.diag_sink)) {
                    return false;
                }
            }
            pi = pi + 1;
        }
    }

    if ctx.proj.file_count == 0 {
        emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
        return false;
    }

    // Read all non-std user files and check if any references `host`
    let mut uses_host: bool = false;
    let mut i: usize = 0;
    while i < ctx.proj.file_count {
        let pf = unsafe { project_file_at(ctx.proj.files, i) };
        let is_std = pf_is_std(pf as *const ProjectFile);
        if !is_std {
            let mut ok: bool = false;
            let ok_ptr = unsafe { ptr_from_mut(mut_view(ok)) };
            let disk = pf_get_disk_path(pf as *const ProjectFile);
            let txt = host_read_file_in_arena(view(disk), mut_view(ctx.proj.arena), ok_ptr);
            if !ok {
                emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
                return false;
            }
            if !uses_host && sv_contains_host_str(view(txt)) {
                uses_host = true;
            }
            pf_set_text(pf, view(txt));
        }
        i = i + 1;
    }

    ctx.uses_host = uses_host;
    let pre_host_count = ctx.proj.file_count;
    if uses_host {
        project_append_std_host_if_needed(mut_view(ctx.proj), true);
    }

    // Load all files (user + std) into `ctx.sess.source_db` in project order
    let mut j: usize = 0;
    while j < ctx.proj.file_count {
        let pf = unsafe { project_file_at(ctx.proj.files, j) };
        let init_txt = pf_get_text(pf as *const ProjectFile);
        if (init_txt.ptr as usize) == 0 {
            let mut ok: bool = false;
            let ok_ptr = unsafe { ptr_from_mut(mut_view(ok)) };
            let disk = pf_get_disk_path(pf as *const ProjectFile);
            let read_txt = host_read_file_in_arena(view(disk), mut_view(ctx.proj.arena), ok_ptr);
            if !ok {
                emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
                return false;
            }
            pf_set_text(pf, view(read_txt));
        }
        let txt = pf_get_text(pf as *const ProjectFile);
        let disp = pf_get_display_path(pf as *const ProjectFile);
        let fid = session_add_virtual_file(mut_view(ctx.sess), disp, txt);
        let fid_v = fid.v;
        if session_has_errors(view(ctx.sess)) {
            return false;
        }
        if uses_host && j >= pre_host_count {
            ctx.host_fid.v = fid_v;
        }
        pf_set_fid_v(pf, fid_v);
        if pf_is_main(pf as *const ProjectFile) {
            ctx.main_fid.v = fid_v;
            let mtxt = session_file_text(view(ctx.sess), FileId { v: fid_v });
            sv_copy_to(mut_view(ctx.main_text), view(mtxt));
        }
        j = j + 1;
    }

    if ctx.main_fid.v == 0u32 {
        let mut k: usize = 0;
        while k < ctx.proj.file_count {
            let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, k) };
            if !pf_is_std(pf) {
                let fid_v = pf_get_fid_v(pf);
                ctx.main_fid.v = fid_v;
                let mtxt = session_file_text(view(ctx.sess), FileId { v: fid_v });
                sv_copy_to(mut_view(ctx.main_text), view(mtxt));
                break;
            }
            k = k + 1;
        }
        if ctx.main_fid.v == 0u32 && ctx.proj.file_count > 0 {
            let pf0 = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, 0) };
            let fid0_v = pf_get_fid_v(pf0);
            ctx.main_fid.v = fid0_v;
            let mtxt = session_file_text(view(ctx.sess), FileId { v: fid0_v });
            sv_copy_to(mut_view(ctx.main_text), view(mtxt));
        }
    }

    !session_has_errors(view(ctx.sess))
}

pub fn pipeline_stage_lex(ctx: mut_view<PipelineCtx>) {
    if ctx.is_mir_input {
        return;
    }
    if ctx.main_fid.v != 0u32 {
        session_lex_file(mut_view(ctx.sess), FileId { v: ctx.main_fid.v }, mut_view(ctx.lex_res));
    }
}

pub fn pipeline_stage_parse(ctx: mut_view<PipelineCtx>) {
    if ctx.is_mir_input {
        return;
    }
    if ctx.proj.file_count == 0 {
        clone_lex_strings_to_arena(mut_view(ctx.lex_res), mut_view(ctx.parse_arena));
        let pres = session_parse_tokens(
            mut_view(ctx.sess),
            mut_view(ctx.parse_arena),
            ctx.lex_res.tokens,
            ctx.lex_res.token_count
        );
        ctx.ast.items = pres.ast.items;
        return;
    }

    let mut head_items: *mut AstItem = 0 as *mut AstItem;
    let mut i: usize = 0;
    while i < ctx.proj.file_count {
        let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, i) };
        let fid_v = pf_get_fid_v(pf);
        let fid = FileId { v: fid_v };
        let mod_path = pf_get_module_path(pf);

        let mut file_items: *mut AstItem = 0 as *mut AstItem;
        if fid_v == ctx.main_fid.v && ctx.lex_res_active && (ctx.lex_res.tokens as usize) != 0 {
            clone_lex_strings_to_arena(mut_view(ctx.lex_res), mut_view(ctx.parse_arena));
            let pres = session_parse_tokens(
                mut_view(ctx.sess),
                mut_view(ctx.parse_arena),
                ctx.lex_res.tokens,
                ctx.lex_res.token_count
            );
            file_items = pres.ast.items;
        } else {
            let mut f_lex = LexResult {
                arena: arena_new(),
                tokens: 0 as *mut Token,
                token_count: 0,
                token_cap: 0,
                comments: 0 as *mut Comment,
                comment_count: 0,
                comment_cap: 0,
            };
            session_lex_file(mut_view(ctx.sess), fid, mut_view(f_lex));
            clone_lex_strings_to_arena(mut_view(f_lex), mut_view(ctx.parse_arena));
            let pres = session_parse_tokens(
                mut_view(ctx.sess),
                mut_view(ctx.parse_arena),
                f_lex.tokens,
                f_lex.token_count
            );
            ax_lex_result_free(mut_view(f_lex));
            file_items = pres.ast.items;
        }

        let mut pres_ast = Ast { items: file_items };
        if ctx.proj.is_package && mod_path.len > 0 {
            session_ensure_module_header(
                mut_view(ctx.sess),
                mut_view(ctx.parse_arena),
                mut_view(pres_ast),
                mod_path
            );
        }

        head_items = append_ast_items(head_items, pres_ast.items);
        i = i + 1;
    }

    ctx.ast.items = head_items;
}

pub fn pipeline_stage_resolve(ctx: mut_view<PipelineCtx>) {
    if ctx.is_mir_input {
        return;
    }
    session_resolve_ast_into(
        mut_view(ctx.sess),
        mut_view(ctx.resolve_arena),
        view(ctx.ast),
        mut_view(ctx.rmap)
    );
}

pub fn pipeline_stage_hir(ctx: mut_view<PipelineCtx>) {
    if ctx.is_mir_input {
        return;
    }
    let hf = session_lower_hir(
        mut_view(ctx.sess),
        mut_view(ctx.hir_arena),
        view(ctx.ast),
        view(ctx.rmap)
    );
    ctx.hir.items = hf.items;
}

pub fn pipeline_stage_typeck(ctx: mut_view<PipelineCtx>, dopts: view<DriverOptions>) {
    let _ = dopts;
    if ctx.is_mir_input || session_has_errors(view(ctx.sess)) {
        return;
    }
    let _ = session_typeck_and_seed_mono(
        mut_view(ctx.sess),
        view(ctx.hir),
        mut_view(ctx.thir),
        mut_view(ctx.hir_arena),
        mut_view(ctx.mono)
    );
    if session_has_errors(view(ctx.sess)) {
        return;
    }
    let _ = session_unsafe_check(
        mut_view(ctx.sess),
        view(ctx.hir),
        view(ctx.thir)
    );
    if session_has_errors(view(ctx.sess)) {
        return;
    }
    let _ = session_comptime_check_and_eval(
        mut_view(ctx.sess),
        view(ctx.ast),
        view(ctx.rmap),
        view(ctx.hir),
        mut_view(ctx.thir)
    );
}

pub fn pipeline_stage_own(ctx: mut_view<PipelineCtx>) {
    if session_has_errors(view(ctx.sess)) {
        return;
    }
    if ctx.is_mir_input {
        let _ = session_verify_mir_text(
            mut_view(ctx.sess),
            mut_view(ctx.mir_arena),
            FileId { v: ctx.main_fid.v },
            StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
        );
        return;
    }
    let mono_ptr = unsafe { ptr_from_mut(mut_view(ctx.mono)) };
    let filter_fid_v: u32 = if ctx.proj.is_package { 0u32 } else { ctx.main_fid.v };
    let filter_fid = FileId { v: filter_fid_v };
    let _ = session_own_mir_verify_file(
        mut_view(ctx.sess),
        mut_view(ctx.mir_arena),
        view(ctx.hir),
        mut_view(ctx.thir),
        filter_fid,
        mono_ptr,
        true,
        0 as *mut DiagBuffer,
        0 as *mut DiagBuffer
    );
}

pub fn pipeline_stage_interp(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>
) {
    if session_has_errors(view(ctx.sess)) {
        ctx.interp_rc = AX_EXIT_DIAG;
        return;
    }
    let out_ptr = unsafe { ptr_from_mut(mut_view(*out_buf)) };
    let panic_ptr = unsafe { ptr_from_mut(mut_view(ctx.panic_msg)) };
    if ctx.is_mir_input {
        let rc = session_interp_mir_text(
            mut_view(ctx.sess),
            mut_view(ctx.mir_arena),
            StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len },
            dopts.opt_O1,
            dopts.verify_each,
            dopts.step_limit,
            dopts.max_call_depth,
            out_ptr,
            true,
            panic_ptr
        );
        ctx.interp_rc = rc;
        return;
    }
    let mono_ptr = unsafe { ptr_from_mut(mut_view(ctx.mono)) };
    let filter_fid_v: u32 = if ctx.proj.is_package { 0u32 } else { ctx.main_fid.v };
    let filter_fid = FileId { v: filter_fid_v };
    let rc = session_run_interp_with_args(
        mut_view(ctx.sess),
        mut_view(ctx.mir_arena),
        view(ctx.ast),
        view(ctx.rmap),
        view(ctx.hir),
        mut_view(ctx.thir),
        filter_fid,
        mono_ptr,
        dopts.opt_O1,
        dopts.verify_each,
        dopts.step_limit,
        dopts.max_call_depth,
        out_ptr,
        true,
        panic_ptr,
        StrView { ptr: dopts.input_file.ptr, len: dopts.input_file.len },
        dopts.run_args as *const StrView,
        dopts.run_argc
    );
    ctx.interp_rc = rc;
}

pub fn pipeline_run_stages(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    upto: u32,
    out_buf: mut_view<DiagBuffer>
) -> bool {
    let mut s: u32 = STAGE_SOURCE;
    while s <= upto {
        if s == STAGE_INTERP && upto != STAGE_INTERP {
            s = s + 1u32;
            continue;
        }
        let t0 = monotonic_ns();
        if s == STAGE_SOURCE {
            let _ = pipeline_stage_source(mut_view(*ctx), dopts);
        } else if s == STAGE_LEX {
            pipeline_stage_lex(mut_view(*ctx));
        } else if s == STAGE_PARSE {
            pipeline_stage_parse(mut_view(*ctx));
        } else if s == STAGE_RESOLVE {
            pipeline_stage_resolve(mut_view(*ctx));
        } else if s == STAGE_HIR {
            pipeline_stage_hir(mut_view(*ctx));
        } else if s == STAGE_TYPECK {
            pipeline_stage_typeck(mut_view(*ctx), dopts);
        } else if s == STAGE_OWN {
            if upto != STAGE_INTERP || ctx.is_mir_input {
                pipeline_stage_own(mut_view(*ctx));
            }
        } else if s == STAGE_INTERP {
            pipeline_stage_interp(mut_view(*ctx), dopts, mut_view(*out_buf));
        } else if s == STAGE_MONO {
            // Monomorphization seeding is integrated into stage_typeck; record stage for timing parity.
        }
        let t1 = monotonic_ns();
        let elapsed: u64 = if t1 >= t0 { t1 - t0 } else { 0u64 };
        ctx.time_ns[s as usize] = elapsed;
        if dopts.time_passes {
            format_pass_time(mut_view(*out_buf), s, elapsed);
        }
        if session_has_errors(view(ctx.sess)) {
            return false;
        }
        s = s + 1u32;
    }
    !session_has_errors(view(ctx.sess))
}

const WLIB_INVALID_KIND_CODE_NAME: [31]u8 = [
    65u8, 88u8, 95u8, 68u8, 82u8, 73u8, 86u8, 69u8, 82u8, 95u8, 73u8, 78u8, 86u8, 65u8, 76u8, 73u8,
    68u8, 95u8, 65u8, 82u8, 84u8, 73u8, 70u8, 65u8, 67u8, 84u8, 95u8, 75u8, 73u8, 78u8, 68u8,
];

const WLIB_BAD_ARCHIVE_CODE_NAME: [19]u8 = [
    65u8, 88u8, 95u8, 76u8, 73u8, 78u8, 75u8, 95u8, 66u8, 65u8, 68u8, 95u8, 65u8, 82u8, 67u8, 72u8,
    73u8, 86u8, 69u8,
];

const WLIB_LIB_NOT_FOUND_CODE_NAME: [25]u8 = [
    65u8, 88u8, 95u8, 76u8, 73u8, 78u8, 75u8, 95u8, 76u8, 73u8, 66u8, 82u8, 65u8, 82u8, 89u8, 95u8,
    78u8, 79u8, 84u8, 95u8, 70u8, 79u8, 85u8, 78u8, 68u8,
];

fn patch_wlib_diag_buf(sink: view<DiagSink>, buf: mut_view<DiagBuffer>) {
    let blen = buf.len;
    if sink.len == 0 || (sink.diags as usize) == 0 || blen < 9 || (buf.ptr as usize) == 0 {
        return;
    }
    let mut has_wlib_code = false;
    let mut di: usize = 0;
    while di < sink.len {
        let dp = ((sink.diags as usize) + opts_mul_usize(di, size_of<Diagnostic>())) as *const Diagnostic;
        let cv = unsafe { (*dp).code.v };
        if cv >= 137u32 && cv <= 139u32 {
            has_wlib_code = true;
            break;
        }
        di = di + 1;
    }
    if !has_wlib_code {
        return;
    }
    let mut out = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut i: usize = 0;
    let mut next_di: usize = 0;
    while i < buf.len {
        if i + 9 <= buf.len &&
           unsafe { *(buf.ptr + i + 0) == 60u8 && *(buf.ptr + i + 1) == 117u8 && *(buf.ptr + i + 2) == 110u8 &&
                    *(buf.ptr + i + 3) == 107u8 && *(buf.ptr + i + 4) == 110u8 && *(buf.ptr + i + 5) == 111u8 &&
                    *(buf.ptr + i + 6) == 119u8 && *(buf.ptr + i + 7) == 110u8 && *(buf.ptr + i + 8) == 62u8 } {
            let mut match_cv: u32 = 138u32;
            while next_di < sink.len {
                let dp = ((sink.diags as usize) + opts_mul_usize(next_di, size_of<Diagnostic>())) as *const Diagnostic;
                let cv = unsafe { (*dp).code.v };
                next_di = next_di + 1;
                if cv >= 137u32 && cv <= 139u32 {
                    match_cv = cv;
                    break;
                }
            }
            if match_cv == 137u32 {
                let mut k: usize = 0;
                while k < 31 {
                    diag_buf_push_byte(mut_view(out), WLIB_INVALID_KIND_CODE_NAME[k]);
                    k = k + 1;
                }
            } else if match_cv == 139u32 {
                let mut k: usize = 0;
                while k < 25 {
                    diag_buf_push_byte(mut_view(out), WLIB_LIB_NOT_FOUND_CODE_NAME[k]);
                    k = k + 1;
                }
            } else {
                let mut k: usize = 0;
                while k < 19 {
                    diag_buf_push_byte(mut_view(out), WLIB_BAD_ARCHIVE_CODE_NAME[k]);
                    k = k + 1;
                }
            }
            i = i + 9;
        } else {
            diag_buf_push_byte(mut_view(out), unsafe { *(buf.ptr + i) });
            i = i + 1;
        }
    }
    if buf.cap > 0 && (buf.ptr as usize) != 0 {
        unsafe { heap_free(buf.ptr, buf.cap, 1); }
    }
    buf.ptr = out.ptr;
    buf.len = out.len;
    buf.cap = out.cap;
}

pub fn driver_flush_diagnostics(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) {
    let _ = out_buf;
    if session_diag_count(view(ctx.sess)) > 0 {
        if dopts.json {
            session_render_json(mut_view(ctx.sess), mut_view(*err_buf));
        } else {
            session_render_human(mut_view(ctx.sess), mut_view(*err_buf));
        }
        patch_unknown_intrinsic_diag_buf(view(ctx.sess.diag_sink), mut_view(*err_buf));
        patch_wlib_diag_buf(view(ctx.sess.diag_sink), mut_view(*err_buf));
    }
}

// =============================================================================
// 3. Command Execution (`inspect`, `check`, `run`, `build`)
// =============================================================================

fn driver_execute_inspect_ctx(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ek = dopts.emit_kind;
    let mut rc: i32 = AX_EXIT_OK;

    if ek == EMIT_TOKENS {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_LEX, mut_view(*out_buf));
        if ctx.main_fid.v != 0u32 {
            session_render_tokens_into(view(ctx.sess), view(ctx.lex_res), mut_view(*out_buf));
        }
        if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_AST {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_PARSE, mut_view(*out_buf));
        if ctx.main_fid.v != 0u32 {
            session_render_ast_into(view(ctx.sess), view(ctx.ast), FileId { v: ctx.main_fid.v }, mut_view(*out_buf));
        }
        if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_RESOLVED {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_RESOLVE, mut_view(*out_buf));
        if ctx.main_fid.v != 0u32 {
            session_render_resolved_into(
                view(ctx.sess),
                view(ctx.ast),
                view(ctx.rmap),
                FileId { v: ctx.main_fid.v },
                mut_view(*out_buf)
            );
        }
        if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_HIR {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_HIR, mut_view(*out_buf));
        if !ok && (ctx.hir.items as usize) == 0 && (ctx.ast.items as usize) != 0 {
            pipeline_stage_hir(mut_view(*ctx));
        }
        if ctx.main_fid.v != 0u32 {
            session_render_hir_into(view(ctx.sess), view(ctx.hir), FileId { v: ctx.main_fid.v }, mut_view(*out_buf));
        }
        if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_THIR {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_OWN, mut_view(*out_buf));
        if ok && ctx.main_fid.v != 0u32 {
            session_render_thir_into(
                view(ctx.sess),
                view(ctx.hir),
                view(ctx.thir),
                FileId { v: ctx.main_fid.v },
                mut_view(*out_buf)
            );
        } else if !ok {
            rc = AX_EXIT_DIAG;
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_MIR || ek == EMIT_MIR_OPT {
        let want_opt = ek == EMIT_MIR_OPT || dopts.opt_O1;
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else if want_opt {
                if !session_opt_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    mtxt,
                    dopts.verify_each,
                    mut_view(*out_buf)
                ) {
                    rc = AX_EXIT_DIAG;
                }
            } else {
                let _ = session_verify_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    FileId { v: ctx.main_fid.v },
                    StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
                );
                let body = verify_parse_mir(
                    mtxt,
                    mut_view(ctx.thir.interner),
                    mut_view(ctx.mir_arena)
                );
                if (body as usize) == 0 {
                    rc = AX_EXIT_DIAG;
                } else {
                    unsafe {
                        mir_print(mut_view(*out_buf), view(*body));
                    }
                }
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            let mfid = FileId { v: ctx.main_fid.v };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else if want_opt {
                let _ = session_emit_mir_opt(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    view(ctx.hir),
                    mut_view(ctx.thir),
                    mfid,
                    dopts.verify_each,
                    mut_view(*out_buf)
                );
                if session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                }
            } else {
                let _ = session_emit_mir(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    view(ctx.hir),
                    mut_view(ctx.thir),
                    mfid,
                    mut_view(*out_buf)
                );
                if session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                }
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_OPTIR || ek == EMIT_MEMSSA {
        let emit_memssa = ek == EMIT_MEMSSA;
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if !ok || !optir_inspect_mir_text(
                mtxt,
                emit_memssa,
                dopts.verify_each,
                mut_view(*out_buf),
                mut_view(ctx.sess.diag_sink),
                mut_view(ctx.mir_arena)
            ) || session_has_errors(view(ctx.sess)) {
                rc = AX_EXIT_DIAG;
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            if !ok || !driver_emit_optir_file(
                mut_view(*ctx),
                emit_memssa,
                dopts.verify_each,
                mut_view(*out_buf)
            ) || session_has_errors(view(ctx.sess)) {
                rc = AX_EXIT_DIAG;
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_LIR {
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let ti_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir.interner)) };
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if ok {
                let _ = session_verify_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    FileId { v: ctx.main_fid.v },
                    StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
                );
            }
            if !ok || !session_emit_lir_mir_text_opt(
                mut_view(ctx.backend_arena),
                ti_ptr,
                mtxt,
                dopts.opt_O1,
                mut_view(*out_buf)
            ) {
                rc = AX_EXIT_DIAG;
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            let mfid = FileId { v: ctx.main_fid.v };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else {
                let _ = session_emit_lir_hir(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    mut_view(ctx.backend_arena),
                    view(ctx.hir),
                    mut_view(ctx.thir),
                    mfid,
                    true,
                    dopts.opt_O1,
                    mut_view(*out_buf)
                );
                if session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                }
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_MI {
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let ti_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir.interner)) };
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if ok {
                let _ = session_verify_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    FileId { v: ctx.main_fid.v },
                    StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
                );
            }
            if !ok || !session_emit_mi_mir_text_opt(
                mut_view(ctx.backend_arena),
                ti_ptr,
                mtxt,
                dopts.opt_O1,
                mut_view(*out_buf)
            ) {
                rc = AX_EXIT_DIAG;
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            let mfid = FileId { v: ctx.main_fid.v };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else {
                let _ = session_emit_mi_hir(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    mut_view(ctx.backend_arena),
                    view(ctx.hir),
                    mut_view(ctx.thir),
                    mfid,
                    true,
                    dopts.opt_O1,
                    mut_view(*out_buf)
                );
                if session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                }
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_MC {
        if sv_ends_with_mir(view(dopts.input_file)) {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_SOURCE, mut_view(*out_buf));
            let ti_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir.interner)) };
            let mtxt = StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len };
            if ok {
                let _ = session_verify_mir_text(
                    mut_view(ctx.sess),
                    mut_view(ctx.mir_arena),
                    FileId { v: ctx.main_fid.v },
                    StrView { ptr: ctx.main_text.ptr, len: ctx.main_text.len }
                );
            }
            if !ok || !session_emit_mc_mir_text_opt(
                mut_view(ctx.backend_arena),
                ti_ptr,
                mtxt,
                dopts.opt_O1,
                mut_view(*out_buf)
            ) {
                rc = AX_EXIT_DIAG;
            }
        } else {
            let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
            let mfid = FileId { v: ctx.main_fid.v };
            if !ok {
                rc = AX_EXIT_DIAG;
            } else if !session_emit_mc_hir(
                mut_view(ctx.sess),
                mut_view(ctx.mir_arena),
                mut_view(ctx.backend_arena),
                view(ctx.hir),
                mut_view(ctx.thir),
                mfid,
                true,
                dopts.opt_O1,
                mut_view(*out_buf)
            ) {
                rc = AX_EXIT_ICE;
            }
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    if ek == EMIT_OBJ {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_TYPECK, mut_view(*out_buf));
        if !ok {
            rc = AX_EXIT_DIAG;
        } else {
            let mut obj = objmodel_new();
            let ok_obj = driver_emit_objmodel(mut_view(*ctx), true, dopts.opt_O1, false, mut_view(obj));
            if !ok_obj {
                rc = AX_EXIT_ICE;
            } else {
                let mut coff_buf = coff_buf_with_capacity(1024);
                if coff_write_to_buf(view(obj), mut_view(coff_buf)) {
                    diag_buf_push_bytes(mut_view(*out_buf), coff_buf.ptr as *const u8, coff_buf.len);
                } else {
                    rc = AX_EXIT_DIAG;
                }
                coff_buf_free(mut_view(coff_buf));
            }
            objmodel_free(mut_view(obj));
        }
        driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
        return rc;
    }

    AX_EXIT_USAGE
}

fn driver_emit_optir_file(
    ctx: mut_view<PipelineCtx>,
    emit_memssa: bool,
    verify_each: bool,
    out_buf: mut_view<DiagBuffer>
) -> bool {
    if !session_unsafe_check(mut_view(ctx.sess), view(ctx.hir), view(ctx.thir)) {
        return false;
    }
    let mfid = ctx.main_fid.v;
    let thir_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir)) as *const Thir };
    let mut it: *mut HirItem = ctx.hir.items;
    while (it as usize) != 0 {
        let it_file = unsafe { (*it).span.file.v };
        let it_kind = unsafe { (*it).kind };
        if it_kind == HIR_ITEM_FN && (mfid == 0u32 || it_file == 0u32 || it_file == mfid) {
            let body = session_own_mir_verify_fn(
                mut_view(ctx.sess),
                mut_view(ctx.mir_arena),
                it,
                view(ctx.hir),
                mut_view(ctx.thir),
                0 as *mut MonoEngine,
                true,
                0 as *mut DiagBuffer,
                0 as *mut DiagBuffer
            );
            if (body as usize) == 0 || session_has_errors(view(ctx.sess)) {
                return false;
            }
            let ob = optir_build_from_mir(
                unsafe { view(*body) },
                thir_ptr,
                mut_view(ctx.mir_arena),
                mut_view(ctx.sess.diag_sink),
                it as *const HirItem
            );
            if (ob as usize) == 0 {
                return false;
            }
            if verify_each {
                if !optir_verify_contract(unsafe { view(*ob) }) {
                    return false;
                }
                if !optir_reconstruct_mir(unsafe { view(*ob) }, unsafe { mut_view(*body) }, mut_view(ctx.mir_arena)) {
                    return false;
                }
                verify_mir(unsafe { view(*body) }, thir_ptr, mut_view(ctx.sess.diag_sink), it as *const HirItem);
                if session_has_errors(view(ctx.sess)) {
                    return false;
                }
            }
            if emit_memssa {
                memssa_print(mut_view(*out_buf), unsafe { view(*ob) });
            } else {
                optir_print(mut_view(*out_buf), unsafe { view(*ob) });
            }
        }
        it = unsafe { (*it).next };
    }
    !session_has_errors(view(ctx.sess))
}

fn pipe_str_in_arena(arena: mut_view<Arena>, off: usize, n: usize) -> StrView {
    let buf = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(buf + i) = PIPELINE_STR_TABLE[off + i]; }
        i = i + 1;
    }
    unsafe { *(buf + n) = 0u8; }
    StrView { ptr: buf as *const u8, len: n }
}

fn pipe_sv_is_main(sv: view<StrView>) -> bool {
    if sv.len != 4 {
        return false;
    }
    let mut i: usize = 0;
    while i < 4 {
        if (unsafe { *(sv.ptr + i) }) != PIPELINE_STR_TABLE[115 + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

unsafe fn pipe_hir_item_ptr_at(base: *mut *mut HirItem, idx: usize) -> *mut *mut HirItem {
    let off = opts_mul_usize(idx, size_of<*mut HirItem>());
    ((base as usize) + off) as *mut *mut HirItem
}

unsafe fn pipe_mir_body_ptr_at(base: *mut *mut MirBody, idx: usize) -> *mut *mut MirBody {
    let off = opts_mul_usize(idx, size_of<*mut MirBody>());
    ((base as usize) + off) as *mut *mut MirBody
}

fn pipe_lookup_item_fn_ty(thir: view<Thir>, item: *const HirItem) -> *const AxType {
    let pty = thir_get_item_type(thir, item);
    if (pty as usize) == 0 {
        return 0 as *const AxType;
    }
    let tid_v = unsafe { (*pty).v };
    if tid_v == 0u32 {
        return 0 as *const AxType;
    }
    type_get(view(thir.interner), TypeId { v: tid_v }) as *const AxType
}

struct PipeBranchFixup {
    fixup: u32,
    target: u32,
}

unsafe fn pipe_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = opts_mul_usize(idx, size_of<u32>());
    ((base as *mut u8) + off) as *mut u32
}

unsafe fn pipe_fixup_at(base: *mut PipeBranchFixup, idx: usize) -> *mut PipeBranchFixup {
    let off = opts_mul_usize(idx, size_of<PipeBranchFixup>());
    ((base as *mut u8) + off) as *mut PipeBranchFixup
}

fn pipe_alloc_panic_sym(arena: mut_view<Arena>, id: u32) -> StrView {
    let mut digits: [16]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut dlen: usize = 0;
    if id == 0u32 {
        digits[0] = 48u8;
        dlen = 1;
    } else {
        let mut v = id;
        while v > 0u32 {
            digits[dlen] = (48u32 + (v % 10u32)) as u8;
            v = v / 10u32;
            dlen = dlen + 1;
        }
    }
    let total = 8 + dlen;
    let dst = arena_alloc_raw(mut_view(*arena), total + 1, 1);
    let mut i: usize = 0;
    while i < 8 {
        unsafe { *(dst + i) = PIPELINE_STR_TABLE[143 + i]; }
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < dlen {
        unsafe { *(dst + 8 + j) = digits[dlen - 1 - j]; }
        j = j + 1;
    }
    unsafe { *(dst + total) = 0u8; }
    StrView { ptr: dst as *const u8, len: total }
}

fn driver_emit_build_mi_body_obj(
    arena: mut_view<Arena>,
    text_sec_id: SectionId,
    rdata_sec_id: SectionId,
    body: view<X64MIBody>,
    layout: view<X64FrameLayout>,
    obj: mut_view<ObjModel>,
    panic_counter: mut_view<u32>
) {
    let text_id_v = text_sec_id.v;
    let rdata_id_v = rdata_sec_id.v;
    let text_sec0 = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
    x64_frame_emit_prologue(unsafe { mut_view(*text_sec0) }, layout);
    if body.bb_count == 0 {
        return;
    }

    let bb_offsets = arena_alloc_raw(
        mut_view(*arena),
        opts_mul_usize(body.bb_count, size_of<u32>()),
        align_of<u32>()
    ) as *mut u32;

    let mut fixup_cap: usize = 16;
    let mut b0: usize = 0;
    while b0 < body.bb_count {
        let mbb0 = unsafe { x64_mi_bb_at(body.bbs, b0) };
        let mut inst0 = unsafe { (*mbb0).first_inst };
        while (inst0 as usize) != 0 {
            let opc0 = unsafe { (*inst0).opcode };
            if opc0 == X64_MI_JMP || opc0 == X64_MI_JCC || opc0 == X64_MI_ASSERT {
                fixup_cap = fixup_cap + 1;
            }
            inst0 = unsafe { (*inst0).next };
        }
        b0 = b0 + 1;
    }

    let fixups = arena_alloc_raw(
        mut_view(*arena),
        opts_mul_usize(fixup_cap, size_of<PipeBranchFixup>()),
        align_of<PipeBranchFixup>()
    ) as *mut PipeBranchFixup;
    let mut num_fixups: usize = 0;

    let mut b: usize = 0;
    while b < body.bb_count {
        let tsec_bb = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
        unsafe {
            *pipe_u32_at(bb_offsets, b) = (*tsec_bb).bytes_len as u32;
        }
        let mbb = unsafe { x64_mi_bb_at(body.bbs, b) };
        let mut inst = unsafe { (*mbb).first_inst };
        while (inst as usize) != 0 {
            let opc = unsafe { (*inst).opcode };
            let tsec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
            if opc == X64_MI_JMP {
                let tgt = unsafe { (*inst).ops[0usize].imm as u32 };
                let fx_off = unsafe { ((*tsec).bytes_len + 1) as u32 };
                x64_jmp(unsafe { mut_view(*tsec) }, 0);
                let fp = unsafe { pipe_fixup_at(fixups, num_fixups) };
                unsafe {
                    (*fp).fixup = fx_off;
                    (*fp).target = tgt;
                }
                num_fixups = num_fixups + 1;
            } else if opc == X64_MI_JCC {
                let cc = unsafe { (*inst).ops[0usize].imm as u8 };
                let tgt = unsafe { (*inst).ops[1usize].imm as u32 };
                let fx_off = unsafe { ((*tsec).bytes_len + 2) as u32 };
                x64_jcc(unsafe { mut_view(*tsec) }, cc, 0);
                let fp = unsafe { pipe_fixup_at(fixups, num_fixups) };
                unsafe {
                    (*fp).fixup = fx_off;
                    (*fp).target = tgt;
                }
                num_fixups = num_fixups + 1;
            } else if opc == X64_MI_ASSERT {
                let tgt = unsafe { (*inst).ops[0usize].imm as u32 };
                let fx_off = unsafe { ((*tsec).bytes_len + 2) as u32 };
                x64_jcc(unsafe { mut_view(*tsec) }, CC_E, 0);
                let fp = unsafe { pipe_fixup_at(fixups, num_fixups) };
                unsafe {
                    (*fp).fixup = fx_off;
                    (*fp).target = tgt;
                }
                num_fixups = num_fixups + 1;

                let rdata_sec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: rdata_id_v });
                let str_offset = unsafe { (*rdata_sec).bytes_len as u64 };
                let pfx_sv = pipe_str_in_arena(mut_view(*arena), 108, 7);
                unsafe {
                    section_add_bytes(mut_view(*rdata_sec), pfx_sv.ptr, pfx_sv.len);
                }
                let raw_msg = unsafe { (*inst).msg };
                let mut raw_msg_len = unsafe { (*inst).msg_len };
                if (raw_msg as usize) != 0 && raw_msg_len > 0 {
                    unsafe {
                        section_add_bytes(mut_view(*rdata_sec), raw_msg, raw_msg_len);
                    }
                } else {
                    let def_msg = pipe_str_in_arena(mut_view(*arena), 162, 16);
                    raw_msg_len = 16;
                    unsafe {
                        section_add_bytes(mut_view(*rdata_sec), def_msg.ptr, def_msg.len);
                    }
                }
                section_add_byte(unsafe { mut_view(*rdata_sec) }, 10u8);
                let fmt_len = (7 + raw_msg_len + 1) as u32;
                section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);

                let pid = *panic_counter;
                *panic_counter = pid + 1u32;
                let panic_sym_sv = pipe_alloc_panic_sym(mut_view(*arena), pid);
                let str_sym = objmodel_add_symbol_bytes(
                    mut_view(*obj),
                    panic_sym_sv.ptr,
                    panic_sym_sv.len,
                    SectionId { v: rdata_id_v },
                    str_offset,
                    (fmt_len + 1u32) as u64,
                    SYM_LOCAL
                );
                let panic_fn_sv = pipe_str_in_arena(mut_view(*arena), 151, 11);
                let panic_fn_sym = objmodel_add_symbol_bytes(
                    mut_view(*obj),
                    panic_fn_sv.ptr,
                    panic_fn_sv.len,
                    SectionId { v: 0u32 },
                    0u64,
                    0u64,
                    SYM_EXTERNAL
                );
                let tsec2 = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
                x64_emit_panic_sequence(
                    unsafe { mut_view(*tsec2) },
                    str_sym,
                    fmt_len,
                    panic_fn_sym
                );
            } else {
                unsafe {
                    if opc != X64_MI_MOV && opc != X64_MI_CMP {
                        (*inst).size = 8u8;
                    } else if (*inst).size == 0u8 {
                        (*inst).size = 8u8;
                    }
                    x64_encode_mi_inst_obj(mut_view(*tsec), view(*inst), layout, mut_view(*obj));
                }
            }
            inst = unsafe { (*inst).next };
        }
        b = b + 1;
    }

    let tsec_end = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
    let mut f: usize = 0;
    while f < num_fixups {
        let fp = unsafe { pipe_fixup_at(fixups, f) };
        let fx_off = unsafe { (*fp).fixup };
        let tgt_bb = unsafe { (*fp).target as usize };
        if tgt_bb < body.bb_count {
            let tgt_byte_off = unsafe { *pipe_u32_at(bb_offsets, tgt_bb) };
            x64_patch_rel32(unsafe { mut_view(*tsec_end) }, fx_off, tgt_byte_off);
        }
        f = f + 1;
    }
}

// Emits COFF `ObjModel` for either:
// - `is_build_mode == false`: `axiom0 inspect --emit=obj <file>` (`emit_obj.c`), using 8-byte MI operand width.
// - `is_build_mode == true`: `axiom0 build` (`build_native/build.c`), running drop elaboration + optional -O1,
//   emitting incoming parameter ABI moves, branch fixups, panic blocks, and aliasing `main` -> `ax_main`
//   immediately after `main` (`build.c:606`).
// Builds the MIR of one function item for the object writer: MIR build, constant promotion, drop elaboration
// plus ownership re-verification, optional -O1 and call-type resolution. Null when the item has no body.
fn pipe_build_item_body(
    ctx: mut_view<PipelineCtx>,
    run_drop_elab: bool,
    run_opt: bool,
    it: *mut HirItem,
    thir_ptr: *mut Thir,
    hir_ptr: *const HirFile,
    str_in_ptr: *mut StrInterner,
    db_ptr: *mut SourceDatabase
) -> *mut MirBody {
    let body = mir_build_fn(
        mut_view(ctx.mir_arena),
        it,
        thir_ptr,
        hir_ptr,
        str_in_ptr,
        db_ptr,
        0 as *mut MonoEngine
    );
    if (body as usize) == 0 {
        return body;
    }
    backend_promote_const_aggregates(unsafe { mut_view(*body) }, view(ctx.thir));
    if run_drop_elab {
        mir_drop_elaborate(
            unsafe { mut_view(*body) },
            mut_view(ctx.thir),
            view(ctx.hir),
            db_ptr,
            view(ctx.sess.interner),
            mut_view(ctx.mir_arena)
        );
        if !session_has_errors(view(ctx.sess)) {
            verify_mir_own(
                unsafe { view(*body) },
                thir_ptr as *const Thir,
                mut_view(ctx.sess.diag_sink),
                it as *const HirItem
            );
        }
    }
    if run_opt {
        opt_run_in_arena(
            unsafe { mut_view(*body) },
            thir_ptr as *const Thir,
            mut_view(ctx.mir_arena),
            mut_view(ctx.sess.diag_sink),
            false,
            it as *const HirItem
        );
    }
    backend_resolve_body_call_types(unsafe { mut_view(*body) }, view(ctx.hir), view(ctx.thir));
    body
}

// True when `m` is a member of a TRAIT item of the file (a default-method body lives there, not in `hir.items`).
fn pipe_is_trait_member(items: *mut HirItem, m: *mut HirItem) -> bool {
    let mut t: *mut HirItem = items;
    while (t as usize) != 0 {
        if (unsafe { (*t).kind }) == HIR_ITEM_TRAIT {
            let mut tm: *mut HirItem = unsafe { (*t).members };
            while (tm as usize) != 0 {
                if (tm as usize) == (m as usize) {
                    return true;
                }
                tm = unsafe { (*tm).next };
            }
        }
        t = unsafe { (*t).next };
    }
    false
}

fn pipe_item_in_buf(buf: *mut *mut HirItem, n: usize, m: *mut HirItem) -> bool {
    let mut i: usize = 0;
    while i < n {
        if (unsafe { *pipe_hir_item_ptr_at(buf, i) }) == m {
            return true;
        }
        i = i + 1;
    }
    false
}

fn pipe_sv_has_dollar(sv: view<StrView>) -> bool {
    let mut i: usize = 0;
    while i < sv.len {
        if (unsafe { *(sv.ptr + i) }) == 36u8 {
            return true;
        }
        i = i + 1;
    }
    false
}

fn pipe_sv_is_link_attr(sv: view<StrView>) -> bool {
    if sv.len != 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 108u8 && *(sv.ptr + 1) == 105u8 &&
        *(sv.ptr + 2) == 110u8 && *(sv.ptr + 3) == 107u8
    }
}

fn pipe_sv_is_export_attr(sv: view<StrView>) -> bool {
    if sv.len != 6 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 101u8 && *(sv.ptr + 1) == 120u8 &&
        *(sv.ptr + 2) == 112u8 && *(sv.ptr + 3) == 111u8 &&
        *(sv.ptr + 4) == 114u8 && *(sv.ptr + 5) == 116u8
    }
}

fn pipe_item_get_link_arg(it: *const HirItem, interner: view<StrInterner>) -> StrView {
    let mut attr: *mut HirAttr = unsafe { (*it).attrs };
    while (attr as usize) != 0 {
        let an = interner_get(interner, unsafe { (*attr).name });
        if pipe_sv_is_link_attr(view(an)) {
            let args: *mut HirAttrArg = unsafe { (*attr).args };
            if (args as usize) != 0 {
                let expr: *mut HirExpr = unsafe { (*args).expr };
                if (expr as usize) != 0 && (unsafe { (*expr).kind }) == HIR_EXPR_LITERAL {
                    let lptr = unsafe { (*expr).literal.str_ptr };
                    let llen = unsafe { (*expr).literal.str_len };
                    if llen > 0 && (lptr as usize) != 0 {
                        return StrView { ptr: lptr, len: llen };
                    }
                }
            }
        }
        attr = unsafe { (*attr).next };
    }
    sv_empty()
}

fn pipe_item_has_link_attr(it: *const HirItem, interner: view<StrInterner>) -> bool {
    let arg = pipe_item_get_link_arg(it, interner);
    arg.len > 0
}

fn pipe_item_get_export_info(
    it: *const HirItem,
    interner: view<StrInterner>,
    has_export: mut_view<bool>
) -> StrView {
    *has_export = false;
    let mut attr: *mut HirAttr = unsafe { (*it).attrs };
    while (attr as usize) != 0 {
        let an = interner_get(interner, unsafe { (*attr).name });
        if pipe_sv_is_export_attr(view(an)) {
            *has_export = true;
            let args: *mut HirAttrArg = unsafe { (*attr).args };
            if (args as usize) != 0 {
                let expr: *mut HirExpr = unsafe { (*args).expr };
                if (expr as usize) != 0 && (unsafe { (*expr).kind }) == HIR_EXPR_LITERAL {
                    let lptr = unsafe { (*expr).literal.str_ptr };
                    let llen = unsafe { (*expr).literal.str_len };
                    if llen > 0 && (lptr as usize) != 0 {
                        return StrView { ptr: lptr, len: llen };
                    }
                }
            }
            return sv_empty();
        }
        attr = unsafe { (*attr).next };
    }
    sv_empty()
}

fn pipe_is_unlinked_extern_c_fn(
    items_head: *mut HirItem,
    interner: view<StrInterner>,
    bare_ptr: *const u8,
    bare_len: usize
) -> bool {
    let bare_sv = StrView { ptr: bare_ptr, len: bare_len };
    let mut it: *mut HirItem = items_head;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN &&
           (unsafe { (*it).abi.v }) != 0u32 &&
           (unsafe { (*it).body as usize }) == 0 {
            let fn_sv = interner_get(interner, unsafe { (*it).name });
            if sv_eq(view(fn_sv), view(bare_sv)) && !pipe_item_has_link_attr(it as *const HirItem, interner) {
                return true;
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

unsafe fn pipe_obj_symbol_at(base: *mut ObjSymbol, idx: usize) -> *mut ObjSymbol {
    ((base as usize) + opts_mul_usize(idx, size_of<ObjSymbol>())) as *mut ObjSymbol
}

// AXS-WLIB-030: `extern "C" fn foo(...)` without `@link` must emit bare `foo` in COFF objects
// so static libraries and short-import libraries can satisfy it directly.
fn pipe_strip_unlinked_extern_c_prefixes(ctx: view<PipelineCtx>, obj: mut_view<ObjModel>) {
    let k32_pfx: [13]u8 = [
        75u8, 69u8, 82u8, 78u8, 69u8, 76u8, 51u8, 50u8, 46u8, 100u8, 108u8, 108u8, 36u8,
    ];
    let mut i: usize = 0;
    while i < obj.symbols_len {
        let sym = unsafe { pipe_obj_symbol_at(obj.symbols, i) };
        let bind = unsafe { (*sym).linkage };
        let nlen = unsafe { (*sym).name_len };
        let nptr = unsafe { (*sym).name as *mut u8 };
        if bind == SYM_EXTERNAL && nlen > 13 && (nptr as usize) != 0 {
            let mut is_k32 = true;
            let mut p: usize = 0;
            while p < 13 {
                if (unsafe { *(nptr + p) }) != k32_pfx[p] {
                    is_k32 = false;
                    break;
                }
                p = p + 1;
            }
            if is_k32 {
                let bare_ptr = unsafe { (nptr as *const u8) + 13 };
                let bare_len = nlen - 13;
                if pipe_is_unlinked_extern_c_fn(ctx.hir.items, view(ctx.sess.interner), bare_ptr, bare_len) {
                    let mut k: usize = 0;
                    while k < bare_len {
                        unsafe { *(nptr + k) = *(nptr + 13 + k); }
                        k = k + 1;
                    }
                    unsafe {
                        *(nptr + bare_len) = 0u8;
                        (*sym).name_len = bare_len;
                    }
                }
            }
        }
        i = i + 1;
    }
}

fn driver_emit_objmodel_filtered(
    ctx: mut_view<PipelineCtx>,
    run_drop_elab: bool,
    run_opt: bool,
    is_build_mode: bool,
    for_lib: bool,
    filter_fid_v: u32,
    obj: mut_view<ObjModel>
) -> bool {
    let text_name_sv = pipe_str_in_arena(mut_view(ctx.backend_arena), 132, 5);
    let rdata_name_sv = pipe_str_in_arena(mut_view(ctx.backend_arena), 137, 6);
    let mut text_id_v: u32 = 0u32;
    let mut rdata_id_v: u32 = 0u32;
    if is_build_mode {
        let rdata_sec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            rdata_name_sv.ptr,
            rdata_name_sv.len,
            SEC_RODATA,
            SEC_FLAG_READ,
            16u32
        );
        let text_sec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            text_name_sv.ptr,
            text_name_sv.len,
            SEC_CODE,
            SEC_FLAG_EXEC | SEC_FLAG_READ,
            16u32
        );
        rdata_id_v = rdata_sec_id.v;
        text_id_v = text_sec_id.v;
    } else {
        let text_sec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            text_name_sv.ptr,
            text_name_sv.len,
            SEC_CODE,
            SEC_FLAG_EXEC | SEC_FLAG_READ,
            16u32
        );
        let rdata_sec_id = objmodel_add_section_bytes(
            mut_view(*obj),
            rdata_name_sv.ptr,
            rdata_name_sv.len,
            SEC_RODATA,
            SEC_FLAG_READ,
            16u32
        );
        text_id_v = text_sec_id.v;
        rdata_id_v = rdata_sec_id.v;
    }

    let mut fn_cap: usize = 0;
    let mut it0: *mut HirItem = ctx.hir.items;
    while (it0 as usize) != 0 {
        if (unsafe { (*it0).kind }) == HIR_ITEM_FN {
            fn_cap = fn_cap + 1;
        } else if (unsafe { (*it0).kind }) == HIR_ITEM_TRAIT {
            let mut tm0: *mut HirItem = unsafe { (*it0).members };
            while (tm0 as usize) != 0 {
                fn_cap = fn_cap + 1;
                tm0 = unsafe { (*tm0).next };
            }
        } else if (unsafe { (*it0).kind }) == HIR_ITEM_IMPL {
            // T161: default-method instances live in the impl, not in `hir.items`.
            let mut im0: *mut HirItem = unsafe { (*it0).members };
            while (im0 as usize) != 0 {
                if tc_is_default_inst(im0 as *const HirItem) {
                    fn_cap = fn_cap + 1;
                }
                im0 = unsafe { (*im0).next };
            }
        }
        it0 = unsafe { (*it0).next };
    }
    if fn_cap == 0 {
        return true;
    }

    let items_buf = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(fn_cap, size_of<*mut HirItem>()),
        align_of<*mut HirItem>()
    ) as *mut *mut HirItem;
    let bodies_buf = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(fn_cap, size_of<*mut MirBody>()),
        align_of<*mut MirBody>()
    ) as *mut *mut MirBody;
    let mut fn_count: usize = 0;

    backend_populate_hir_const_aggregates(view(ctx.sess), view(ctx.hir), mut_view(ctx.thir));
    let thir_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir)) };
    let hir_ptr = unsafe { address_of(ctx.hir.items) as *const HirFile };
    let str_in_ptr = unsafe { ptr_from_mut(mut_view(ctx.sess.interner)) };
    let db_ptr = unsafe { ptr_from_mut(mut_view(ctx.sess.source_db)) };
    let ti_ptr = unsafe { ptr_from_mut(mut_view(ctx.thir.interner)) };

    let mut it: *mut HirItem = ctx.hir.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN &&
           (filter_fid_v == 0u32 || (unsafe { (*it).span.file.v }) == filter_fid_v) {
            let body = pipe_build_item_body(
                mut_view(*ctx), run_drop_elab, run_opt, it, thir_ptr, hir_ptr, str_in_ptr, db_ptr
            );
            if (body as usize) != 0 {
                unsafe {
                    *pipe_hir_item_ptr_at(items_buf, fn_count) = it;
                    *pipe_mir_body_ptr_at(bodies_buf, fn_count) = body;
                }
                fn_count = fn_count + 1;
            }
        }
        it = unsafe { (*it).next };
    }

    // T161: the same holds for the instance of a default method for one implementing type (a member typeck adds to
    // the impl, not copied into `hir.items`); its body is the trait member's MIR instantiated for that type.
    // T153 (REQ-TRT-005): axiom0's `build` emits every monomorphization instance (driver/mono.c), and an instance
    // of a trait's default method has the trait member itself as its item - a member of a TRAIT item, which is not
    // in `hir.items` (impl members and generic clones are). Build those bodies too, so the image defines the
    // default method that the impls without an override call.
    if is_build_mode {
        let mut ei: *mut MonoInstance = ctx.mono.instances_head;
        while (ei as usize) != 0 {
            let ni: *mut HirItem = unsafe { (*ei).new_item };
            if (unsafe { (*ei).mir_body }) != 0 && (ni as usize) != 0 && (unsafe { (*ni).kind }) == HIR_ITEM_FN &&
                (filter_fid_v == 0u32 || (unsafe { (*ni).span.file.v }) == filter_fid_v) &&
                (pipe_is_trait_member(ctx.hir.items, ni) || tc_is_default_inst(ni as *const HirItem)) &&
                !pipe_item_in_buf(items_buf, fn_count, ni) {
                let body = pipe_build_item_body(
                    mut_view(*ctx), run_drop_elab, run_opt, ni, thir_ptr, hir_ptr, str_in_ptr, db_ptr
                );
                if (body as usize) != 0 && fn_count < fn_cap {
                    unsafe {
                        *pipe_hir_item_ptr_at(items_buf, fn_count) = ni;
                        *pipe_mir_body_ptr_at(bodies_buf, fn_count) = body;
                    }
                    fn_count = fn_count + 1;
                }
            }
            ei = unsafe { (*ei).next };
        }
    }

    // Emission order. axiom0 writes the instances newest-first (the order of its instance list); the port's
    // engine keeps the same list, so build mode follows it and puts anything the engine does not know last in
    // reverse `hir.items` order. Other modes keep `hir.items` order.
    let order_buf = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(fn_count + 1, size_of<u32>()),
        align_of<u32>()
    ) as *mut u32;
    let used_buf = arena_alloc_raw(mut_view(ctx.backend_arena), fn_count + 1, 1);
    let mut oi: usize = 0;
    while oi < fn_count {
        unsafe { *(used_buf + oi) = 0u8; }
        oi = oi + 1;
    }
    let mut order_n: usize = 0;
    if is_build_mode {
        let mut oinst: *mut MonoInstance = ctx.mono.instances_head;
        while (oinst as usize) != 0 {
            let oni: *mut HirItem = unsafe { (*oinst).new_item };
            let mut e: usize = 0;
            while e < fn_count {
                if (unsafe { *(used_buf + e) }) == 0u8 && (unsafe { *pipe_hir_item_ptr_at(items_buf, e) }) == oni {
                    unsafe {
                        *(used_buf + e) = 1u8;
                        *pipe_u32_at(order_buf, order_n) = e as u32;
                    }
                    order_n = order_n + 1;
                    break;
                }
                e = e + 1;
            }
            oinst = unsafe { (*oinst).next };
        }
        let mut r: usize = fn_count;
        while r > 0 {
            r = r - 1;
            if (unsafe { *(used_buf + r) }) == 0u8 {
                unsafe { *pipe_u32_at(order_buf, order_n) = r as u32; }
                order_n = order_n + 1;
            }
        }
    } else {
        while order_n < fn_count {
            unsafe { *pipe_u32_at(order_buf, order_n) = order_n as u32; }
            order_n = order_n + 1;
        }
    }

    let mut cstr_counter: u32 = 0u32;
    let mut panic_counter: u32 = 0u32;
    let ctable = backend_emit_const_tables(
        mut_view(ctx.backend_arena),
        bodies_buf as *const *mut MirBody,
        fn_count,
        view(ctx.hir),
        view(ctx.thir),
        view(ctx.sess.interner),
        mut_view(*obj),
        SectionId { v: rdata_id_v },
        mut_view(cstr_counter)
    );

    let mut fi: usize = 0;
    while fi < fn_count {
        let idx = (unsafe { *pipe_u32_at(order_buf, fi) }) as usize;
        let fn_item = unsafe { *pipe_hir_item_ptr_at(items_buf, idx) };
        let mir_body = unsafe { *pipe_mir_body_ptr_at(bodies_buf, idx) };
        let fn_ty = backend_resolve_item_fn_ty(
            mut_view(ctx.backend_arena),
            view(ctx.thir),
            fn_item as *const HirItem,
            mir_body as *const MirBody
        );
        let lir_fn_ty = fn_ty;

        let mut layout = X64FrameLayout {
            slot_offsets: 0 as *mut i32,
            slot_count: 0u32,
            frame_size: 0u32,
        };
        let mut lir_body: *mut LirBody = 0 as *mut LirBody;
        let mut mi_body: *mut X64MIBody = 0 as *mut X64MIBody;
        let v_err = backend_lower_fn_to_mc_checked_opt(
            mut_view(ctx.backend_arena),
            mir_body,
            hir_ptr,
            ti_ptr,
            str_in_ptr as *const StrInterner,
            ctable as *const LirConstTable,
            lir_fn_ty,
            fn_ty,
            mut_view(lir_body),
            mut_view(mi_body),
            mut_view(layout),
            run_opt
        );
        if v_err != X64_VERIFY_OK {
            return false;
        }

        backend_emit_fn_strings_rdata(
            mut_view(ctx.backend_arena),
            unsafe { mut_view(*mi_body) },
            mut_view(*obj),
            SectionId { v: rdata_id_v },
            fi as u32
        );

        let text_sec = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
        unsafe {
            while ((*text_sec).bytes_len % 16) != 0 {
                x64_nop(mut_view(*text_sec));
            }
        }
        let func_start = unsafe { (*text_sec).bytes_len as u64 };

        if is_build_mode {
            driver_emit_build_mi_body_obj(
                mut_view(ctx.backend_arena),
                SectionId { v: text_id_v },
                SectionId { v: rdata_id_v },
                unsafe { view(*mi_body) },
                view(layout),
                mut_view(*obj),
                mut_view(panic_counter)
            );
        } else {
            x64_frame_emit_prologue(unsafe { mut_view(*text_sec) }, view(layout));
            let mut b: usize = 0;
            let bb_cnt = unsafe { (*mi_body).bb_count };
            while b < bb_cnt {
                let mbb = unsafe { x64_mi_bb_at((*mi_body).bbs, b) };
                let mut inst = unsafe { (*mbb).first_inst };
                while (inst as usize) != 0 {
                    unsafe {
                        (*inst).size = 8u8;
                        x64_encode_mi_inst_obj(mut_view(*text_sec), view(*inst), view(layout), mut_view(*obj));
                        inst = (*inst).next;
                    }
                }
                b = b + 1;
            }
        }

        let text_sec_end = objmodel_get_section_mut(mut_view(*obj), SectionId { v: text_id_v });
        let func_end = unsafe { (*text_sec_end).bytes_len as u64 };
        let func_size = func_end - func_start;
        let fname_id_v = unsafe { (*fn_item).name.v };
        let fname_sv = if fname_id_v == 0u32 {
            backend_alloc_anon_fn_sym(mut_view(ctx.backend_arena), unsafe { (*fn_item).symbol.v })
        } else {
            interner_get(view(ctx.sess.interner), StrId { v: fname_id_v })
        };
        let mut has_export: bool = false;
        let export_sv = pipe_item_get_export_info(
            fn_item as *const HirItem,
            view(ctx.sess.interner),
            mut_view(has_export)
        );
        let sym_bind: u32 = if !for_lib ||
                               (unsafe { (*fn_item).vis.kind }) != 0u8 ||
                               has_export ||
                               pipe_sv_has_dollar(view(fname_sv)) {
            SYM_GLOBAL
        } else {
            SYM_LOCAL
        };
        let _ = objmodel_add_symbol_bytes(
            mut_view(*obj),
            fname_sv.ptr,
            fname_sv.len,
            SectionId { v: text_id_v },
            func_start,
            func_size,
            sym_bind
        );
        if has_export && export_sv.len > 0 && !sv_eq(view(export_sv), view(fname_sv)) {
            let _ = objmodel_add_symbol_bytes(
                mut_view(*obj),
                export_sv.ptr,
                export_sv.len,
                SectionId { v: text_id_v },
                func_start,
                func_size,
                SYM_GLOBAL
            );
        }
        if is_build_mode && !for_lib && pipe_sv_is_main(view(fname_sv)) {
            let ax_main_sv = pipe_str_in_arena(mut_view(ctx.backend_arena), 119, 7);
            let _ = objmodel_add_symbol_bytes(
                mut_view(*obj),
                ax_main_sv.ptr,
                ax_main_sv.len,
                SectionId { v: text_id_v },
                func_start,
                func_size,
                SYM_GLOBAL
            );
        }

        fi = fi + 1;
    }

    if is_build_mode {
        pipe_strip_unlinked_extern_c_prefixes(view(*ctx), mut_view(*obj));
        if for_lib {
            let mut u: usize = 0;
            while u < obj.symbols_len {
                let usym = unsafe { pipe_obj_symbol_at(obj.symbols, u) };
                if (unsafe { (*usym).linkage }) == SYM_EXTERNAL && (unsafe { (*usym).section_id.v }) == 0u32 {
                    let u_sv = StrView { ptr: unsafe { (*usym).name }, len: unsafe { (*usym).name_len } };
                    let mut d: usize = 0;
                    while d < obj.symbols_len {
                        let dsym = unsafe { pipe_obj_symbol_at(obj.symbols, d) };
                        if (unsafe { (*dsym).section_id.v }) != 0u32 {
                            let d_sv = StrView { ptr: unsafe { (*dsym).name }, len: unsafe { (*dsym).name_len } };
                            if sv_eq(view(u_sv), view(d_sv)) {
                                unsafe {
                                    (*usym).section_id = (*dsym).section_id;
                                    (*usym).value = (*dsym).value;
                                    (*usym).size = (*dsym).size;
                                    (*usym).linkage = SYM_LOCAL;
                                }
                                break;
                            }
                        }
                        d = d + 1;
                    }
                }
                u = u + 1;
            }
        }
    }

    true
}

fn driver_emit_objmodel(
    ctx: mut_view<PipelineCtx>,
    run_drop_elab: bool,
    run_opt: bool,
    is_build_mode: bool,
    obj: mut_view<ObjModel>
) -> bool {
    driver_emit_objmodel_filtered(
        ctx,
        run_drop_elab,
        run_opt,
        is_build_mode,
        false,
        0u32,
        obj
    )
}

pub fn driver_execute_inspect(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ctx_ptr = pipeline_ctx_alloc();
    let rc = driver_execute_inspect_ctx(unsafe { mut_view(*ctx_ptr) }, dopts, mut_view(*out_buf), mut_view(*err_buf));
    pipeline_ctx_dealloc(ctx_ptr);
    rc
}

fn driver_execute_check_ctx(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_OWN, mut_view(*out_buf));
    driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
    if ok && !session_has_errors(view(ctx.sess)) { AX_EXIT_OK } else { AX_EXIT_DIAG }
}

pub fn driver_execute_check(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ctx_ptr = pipeline_ctx_alloc();
    let rc = driver_execute_check_ctx(unsafe { mut_view(*ctx_ptr) }, dopts, mut_view(*out_buf), mut_view(*err_buf));
    pipeline_ctx_dealloc(ctx_ptr);
    rc
}

fn driver_execute_run_ctx(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_INTERP, mut_view(*out_buf));
    if ctx.panic_msg.len > 0 && (ctx.panic_msg.ptr as usize) != 0 {
        push_pipe_str(mut_view(*err_buf), 108, 7);
        diag_buf_push_bytes(mut_view(*err_buf), ctx.panic_msg.ptr, ctx.panic_msg.len);
        diag_buf_push_byte(mut_view(*err_buf), 10u8);
    }
    driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
    if ctx.interp_rc == 124 || ctx.interp_rc == 125 {
        ctx.interp_rc
    } else if !ok || session_has_errors(view(ctx.sess)) {
        AX_EXIT_DIAG
    } else {
        ctx.interp_rc
    }
}

pub fn driver_execute_run(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let ctx_ptr = pipeline_ctx_alloc();
    let rc = driver_execute_run_ctx(unsafe { mut_view(*ctx_ptr) }, dopts, mut_view(*out_buf), mut_view(*err_buf));
    pipeline_ctx_dealloc(ctx_ptr);
    rc
}

unsafe fn pipe_cstr_ptr_at(base: *mut *const u8, idx: usize) -> *mut *const u8 {
    ((base as usize) + opts_mul_usize(idx, size_of<*const u8>())) as *mut *const u8
}

unsafe fn pipe_archive_member_at(base: *mut CoffArchiveMember, idx: usize) -> *mut CoffArchiveMember {
    ((base as usize) + opts_mul_usize(idx, size_of<CoffArchiveMember>())) as *mut CoffArchiveMember
}

fn pipe_sv_to_cstr_in_arena(arena: mut_view<Arena>, sv: view<StrView>) -> *const u8 {
    let dst = arena_alloc_raw(mut_view(*arena), sv.len + 1, 1);
    let mut i: usize = 0;
    while i < sv.len {
        unsafe { *(dst + i) = *(sv.ptr + i); }
        i = i + 1;
    }
    unsafe { *(dst + sv.len) = 0u8; }
    dst as *const u8
}

fn pipe_stem_to_obj_name_in_arena(arena: mut_view<Arena>, path_sv: view<StrView>) -> StrView {
    let stem = derive_file_stem_sv(path_sv);
    let slen = if stem.len > 0 { stem.len } else { 3 };
    let dst = arena_alloc_raw(mut_view(*arena), slen + 5, 1);
    if stem.len > 0 {
        let mut i: usize = 0;
        while i < stem.len {
            unsafe { *(dst + i) = *(stem.ptr + i); }
            i = i + 1;
        }
    } else {
        unsafe {
            *(dst + 0) = 108u8;
            *(dst + 1) = 105u8;
            *(dst + 2) = 98u8;
        }
    }
    unsafe {
        *(dst + slen + 0) = 46u8;
        *(dst + slen + 1) = 111u8;
        *(dst + slen + 2) = 98u8;
        *(dst + slen + 3) = 106u8;
        *(dst + slen + 4) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: slen + 4 }
}

fn pipe_basename_in_arena(arena: mut_view<Arena>, path_sv: view<StrView>) -> StrView {
    if path_sv.len == 0 || (path_sv.ptr as usize) == 0 {
        return sv_empty();
    }
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i < path_sv.len {
        let ch = unsafe { *(path_sv.ptr + i) };
        if ch == 47u8 || ch == 92u8 {
            start = i + 1;
        }
        i = i + 1;
    }
    let blen = path_sv.len - start;
    let sub = StrView { ptr: unsafe { path_sv.ptr + start }, len: blen };
    arena_clone_sv(mut_view(*arena), view(sub))
}

fn pipe_collect_attr_libs(ctx: mut_view<PipelineCtx>, out_count: mut_view<usize>) -> *mut *const u8 {
    *out_count = 0;
    let mut cap: usize = 0;
    let mut it0: *mut HirItem = ctx.hir.items;
    while (it0 as usize) != 0 {
        let ik0 = unsafe { (*it0).kind };
        if ik0 == HIR_ITEM_FN || ik0 == HIR_ITEM_STATIC || ik0 == HIR_ITEM_EXTERN_BLOCK {
            cap = cap + 1;
        }
        it0 = unsafe { (*it0).next };
    }
    if cap == 0 {
        return 0 as *mut *const u8;
    }
    let arr = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(cap, size_of<*const u8>()),
        align_of<*const u8>()
    ) as *mut *const u8;
    let sv_arr = arena_alloc_raw(
        mut_view(ctx.backend_arena),
        opts_mul_usize(cap, size_of<StrView>()),
        align_of<StrView>()
    ) as *mut StrView;
    let mut n: usize = 0;
    let mut it: *mut HirItem = ctx.hir.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_FN || ik == HIR_ITEM_STATIC || ik == HIR_ITEM_EXTERN_BLOCK {
            let larg = pipe_item_get_link_arg(it as *const HirItem, view(ctx.sess.interner));
            if larg.len > 0 {
                let mut dup = false;
                let mut k: usize = 0;
                while k < n {
                    let prev_sv = sv_slot_get(sv_arr as *const StrView, k);
                    if sv_eq(view(prev_sv), view(larg)) {
                        dup = true;
                        break;
                    }
                    k = k + 1;
                }
                if !dup && n < cap {
                    sv_slot_set(sv_arr, n, view(larg));
                    let cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(larg));
                    unsafe { *pipe_cstr_ptr_at(arr, n) = cstr; }
                    n = n + 1;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    *out_count = n;
    arr
}

fn driver_execute_build_into_ctx(
    ctx: mut_view<PipelineCtx>,
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>,
    out_artifact: *mut CoffBuf,
    write_to_disk: bool
) -> i32 {
    let mut has_ax_sources: bool = ctx.main_text.len > 0;
    if !has_ax_sources {
        if dopts.pos_argc == 0 && dopts.input_file.len > 0 && !sv_is_obj_or_archive(view(dopts.input_file)) {
            has_ax_sources = true;
        } else {
            let mut pi: usize = 1;
            while pi < dopts.pos_argc {
                let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi);
                if !sv_is_obj_or_archive(view(arg_sv)) {
                    has_ax_sources = true;
                    break;
                }
                pi = pi + 1;
            }
        }
    }

    if has_ax_sources {
        let ok = pipeline_run_stages(mut_view(*ctx), dopts, STAGE_MONO, mut_view(*out_buf));
        if !ok || session_has_errors(view(ctx.sess)) {
            driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
            return AX_EXIT_DIAG;
        }
    }

    let mut manifest_kind: u32 = ARTIFACT_EXE;
    if ctx.proj.has_manifest && ctx.proj.manifest.kind.len > 0 {
        if !driver_parse_artifact_kind(view(ctx.proj.manifest.kind), mut_view(manifest_kind)) {
            emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_DRIVER_INVALID_ARTIFACT_KIND, 42, 48);
            driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
            return AX_EXIT_USAGE;
        }
    }

    let mut eff_kind: u32 = dopts.artifact_kind;
    if dopts.emit_kind == EMIT_OBJ {
        eff_kind = ARTIFACT_OBJ;
    } else if !dopts.has_explicit_kind && ctx.proj.has_manifest && ctx.proj.manifest.kind.len > 0 {
        eff_kind = manifest_kind;
    }

    let mut out_path = StrView { ptr: dopts.output.ptr, len: dopts.output.len };
    if (eff_kind != dopts.artifact_kind && !dopts.has_explicit_kind) ||
       (ctx.proj.has_manifest && ctx.proj.manifest.name.len > 0) {
        let stem = derive_file_stem_sv(view(dopts.input_file));
        let def_from_in = derive_default_output_path(mut_view(ctx.backend_arena), view(stem), dopts.artifact_kind);
        if sv_eq(view(out_path), view(def_from_in)) {
            let mut eff_stem = stem;
            if ctx.proj.has_manifest && ctx.proj.manifest.name.len > 0 {
                eff_stem = ctx.proj.manifest.name;
            }
            out_path = derive_default_output_path(mut_view(ctx.backend_arena), view(eff_stem), eff_kind);
        }
    }

    let t0 = monotonic_ns();
    if has_ax_sources && ctx.host_fid.v != 0u32 {
        let mut hit = ctx.hir.items;
        while (hit as usize) != 0 {
            unsafe {
                if (*hit).span.file.v == ctx.host_fid.v {
                    (*hit).body = 0 as *mut HirBlock;
                }
                hit = (*hit).next;
            }
        }
    }

    let mut rc: i32 = AX_EXIT_OK;

    if eff_kind == ARTIFACT_LIB {
        let mut user_file_count: usize = 0;
        if has_ax_sources {
            if ctx.proj.file_count == 0 {
                user_file_count = 1;
            } else {
                let mut ui: usize = 0;
                while ui < ctx.proj.file_count {
                    let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, ui) };
                    if !pf_is_std(pf) {
                        user_file_count = user_file_count + 1;
                    }
                    ui = ui + 1;
                }
            }
        }
        let mut extra_obj_count: usize = 0;
        let mut pi0: usize = 1;
        while pi0 < dopts.pos_argc {
            let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi0);
            if sv_ends_with_obj(view(arg_sv)) {
                extra_obj_count = extra_obj_count + 1;
            }
            pi0 = pi0 + 1;
        }
        let member_cap = user_file_count + extra_obj_count + 1;
        let members = arena_alloc_raw(
            mut_view(ctx.backend_arena),
            opts_mul_usize(member_cap, size_of<CoffArchiveMember>()),
            align_of<CoffArchiveMember>()
        ) as *mut CoffArchiveMember;
        let mut member_count: usize = 0;

        if has_ax_sources {
            if ctx.proj.file_count == 0 {
                let mut mod_obj = objmodel_new();
                let ok_m = driver_emit_objmodel_filtered(
                    mut_view(*ctx),
                    true,
                    dopts.opt_O1,
                    true,
                    true,
                    ctx.main_fid.v,
                    mut_view(mod_obj)
                );
                if !ok_m || session_has_errors(view(ctx.sess)) {
                    rc = AX_EXIT_DIAG;
                } else {
                    let rdata_sec = objmodel_get_section_mut(mut_view(mod_obj), SectionId { v: 1u32 });
                    if (rdata_sec as usize) != 0 && (unsafe { (*rdata_sec).bytes_len }) == 0 {
                        section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);
                    }
                    let mut mbuf = coff_buf_with_capacity(1024);
                    if !coff_write_to_buf(view(mod_obj), mut_view(mbuf)) {
                        rc = AX_EXIT_DIAG;
                    } else {
                        let mbytes = arena_alloc_raw(mut_view(ctx.backend_arena), mbuf.len + 1, 1);
                        let mut bi: usize = 0;
                        while bi < mbuf.len {
                            unsafe { *(mbytes + bi) = *(mbuf.ptr + bi); }
                            bi = bi + 1;
                        }
                        let mname = pipe_stem_to_obj_name_in_arena(mut_view(ctx.backend_arena), view(dopts.input_file));
                        let mslot = unsafe { pipe_archive_member_at(members, member_count) };
                        unsafe {
                            (*mslot).name = mname.ptr;
                            (*mslot).name_len = mname.len;
                            (*mslot).data = mbytes as *const u8;
                            (*mslot).data_len = mbuf.len;
                        }
                        member_count = member_count + 1;
                    }
                    coff_buf_free(mut_view(mbuf));
                }
                objmodel_free(mut_view(mod_obj));
            } else {
                let mut ui: usize = 0;
                while ui < ctx.proj.file_count && rc == AX_EXIT_OK {
                    let pf = unsafe { project_file_const_at(ctx.proj.files as *const ProjectFile, ui) };
                    if !pf_is_std(pf) {
                        let fid_v = pf_get_fid_v(pf);
                        let disp = pf_get_display_path(pf);
                        let filter_v: u32 = fid_v;
                        let mut mod_obj = objmodel_new();
                        let ok_m = driver_emit_objmodel_filtered(
                            mut_view(*ctx),
                            true,
                            dopts.opt_O1,
                            true,
                            true,
                            filter_v,
                            mut_view(mod_obj)
                        );
                        if !ok_m || session_has_errors(view(ctx.sess)) {
                            rc = AX_EXIT_DIAG;
                        } else {
                            let rdata_sec = objmodel_get_section_mut(mut_view(mod_obj), SectionId { v: 1u32 });
                            if (rdata_sec as usize) != 0 && (unsafe { (*rdata_sec).bytes_len }) == 0 {
                                section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);
                            }
                            let mut mbuf = coff_buf_with_capacity(1024);
                            if !coff_write_to_buf(view(mod_obj), mut_view(mbuf)) {
                                rc = AX_EXIT_DIAG;
                            } else {
                                let mbytes = arena_alloc_raw(mut_view(ctx.backend_arena), mbuf.len + 1, 1);
                                let mut bi: usize = 0;
                                while bi < mbuf.len {
                                    unsafe { *(mbytes + bi) = *(mbuf.ptr + bi); }
                                    bi = bi + 1;
                                }
                                let mname = pipe_stem_to_obj_name_in_arena(mut_view(ctx.backend_arena), view(disp));
                                let mslot = unsafe { pipe_archive_member_at(members, member_count) };
                                unsafe {
                                    (*mslot).name = mname.ptr;
                                    (*mslot).name_len = mname.len;
                                    (*mslot).data = mbytes as *const u8;
                                    (*mslot).data_len = mbuf.len;
                                }
                                member_count = member_count + 1;
                            }
                            coff_buf_free(mut_view(mbuf));
                        }
                        objmodel_free(mut_view(mod_obj));
                    }
                    ui = ui + 1;
                }
            }
        }

        let mut pi1: usize = 1;
        while pi1 < dopts.pos_argc && rc == AX_EXIT_OK {
            let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi1);
            if sv_ends_with_obj(view(arg_sv)) {
                let mut ok_read: bool = false;
                let ok_ptr = unsafe { ptr_from_mut(mut_view(ok_read)) };
                let obj_bytes = host_read_file_in_arena(view(arg_sv), mut_view(ctx.backend_arena), ok_ptr);
                if !ok_read {
                    emit_driver_diag(mut_view(ctx.sess.diag_sink), AX_IO_FILE_NOT_FOUND, 0, 25);
                    rc = AX_EXIT_DIAG;
                } else {
                    let bname = pipe_basename_in_arena(mut_view(ctx.backend_arena), view(arg_sv));
                    let mslot = unsafe { pipe_archive_member_at(members, member_count) };
                    unsafe {
                        (*mslot).name = bname.ptr;
                        (*mslot).name_len = bname.len;
                        (*mslot).data = obj_bytes.ptr;
                        (*mslot).data_len = obj_bytes.len;
                    }
                    member_count = member_count + 1;
                }
            }
            pi1 = pi1 + 1;
        }

        if rc == AX_EXIT_OK {
            let mut lib_buf = coff_buf_with_capacity(4096);
            if !coff_write_archive_to_buf(members as *const CoffArchiveMember, member_count, mut_view(lib_buf)) {
                rc = AX_EXIT_DIAG;
            } else {
                if (out_artifact as usize) != 0 {
                    coff_buf_put_bytes(unsafe { mut_view(*out_artifact) }, lib_buf.ptr as *const u8, lib_buf.len);
                }
                if write_to_disk {
                    if !pe_write_buf_to_path_bytes(view(lib_buf), out_path.ptr, out_path.len) {
                        rc = AX_EXIT_DIAG;
                    }
                }
            }
            coff_buf_free(mut_view(lib_buf));
        }
    } else {
        let mut obj = objmodel_new();
        let mut ok_obj: bool = true;
        if has_ax_sources {
            ok_obj = driver_emit_objmodel(
                mut_view(*ctx),
                true,
                dopts.opt_O1,
                true,
                mut_view(obj)
            );
        }

        if !ok_obj || session_has_errors(view(ctx.sess)) {
            rc = AX_EXIT_DIAG;
        } else {
            if has_ax_sources {
                // Ensure .rdata section (SectionId 1 in build mode) is non-empty, matching build.c:620-622
                let rdata_sec = objmodel_get_section_mut(mut_view(obj), SectionId { v: 1u32 });
                if (rdata_sec as usize) != 0 && (unsafe { (*rdata_sec).bytes_len }) == 0 {
                    section_add_byte(unsafe { mut_view(*rdata_sec) }, 0u8);
                }
            }

            if eff_kind == ARTIFACT_OBJ {
                if (out_artifact as usize) != 0 {
                    if !coff_write_to_buf(view(obj), unsafe { mut_view(*out_artifact) }) {
                        rc = AX_EXIT_DIAG;
                    }
                }
                if rc == AX_EXIT_OK && write_to_disk {
                    if !coff_write_path_bytes(view(obj), out_path.ptr, out_path.len) {
                        rc = AX_EXIT_DIAG;
                    }
                }
            } else {
                let stack_res: u32 = driver_parse_u32_decimal(view(dopts.stack_reserve), 1048576u32);
                let sink_ptr = unsafe { ptr_from_mut(mut_view(ctx.sess.diag_sink)) };
                let mut pe_buf = coff_buf_with_capacity(4096);

                let mut extra_input_count: usize = 0;
                let mut pi: usize = 1;
                while pi < dopts.pos_argc {
                    let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi);
                    if sv_is_obj_or_archive(view(arg_sv)) {
                        extra_input_count = extra_input_count + 1;
                    }
                    pi = pi + 1;
                }

                let mut attr_lib_count: usize = 0;
                let attr_ptrs = if has_ax_sources {
                    pipe_collect_attr_libs(mut_view(*ctx), mut_view(attr_lib_count))
                } else {
                    0 as *mut *const u8
                };

                if has_ax_sources && extra_input_count == 0 && dopts.lib_dir_count == 0 && dopts.lib_name_count == 0 && attr_lib_count == 0 {
                    if !pe_link_objmodel_to_buf(view(obj), stack_res, mut_view(pe_buf), sink_ptr) {
                        rc = AX_EXIT_DIAG;
                    } else {
                        if (out_artifact as usize) != 0 {
                            coff_buf_put_bytes(unsafe { mut_view(*out_artifact) }, pe_buf.ptr as *const u8, pe_buf.len);
                        }
                        if write_to_disk {
                            if !pe_write_buf_to_path_bytes(view(pe_buf), out_path.ptr, out_path.len) {
                                rc = AX_EXIT_DIAG;
                            }
                        }
                    }
                } else {
                    let mut mem_obj_buf = coff_buf_with_capacity(1024);
                    let mut mem_ok: bool = true;
                    if has_ax_sources {
                        mem_ok = coff_write_to_buf(view(obj), mut_view(mem_obj_buf));
                    }
                    if !mem_ok {
                        rc = AX_EXIT_DIAG;
                    } else {
                        let in_ptrs = if extra_input_count > 0 {
                            arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                opts_mul_usize(extra_input_count, size_of<*const u8>()),
                                align_of<*const u8>()
                            ) as *mut *const u8
                        } else {
                            0 as *mut *const u8
                        };
                        let mut in_idx: usize = 0;
                        let mut pi2: usize = 1;
                        while pi2 < dopts.pos_argc {
                            let arg_sv = sv_slot_get(dopts.pos_args as *const StrView, pi2);
                            if sv_is_obj_or_archive(view(arg_sv)) {
                                let cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(arg_sv));
                                unsafe { *pipe_cstr_ptr_at(in_ptrs, in_idx) = cstr; }
                                in_idx = in_idx + 1;
                            }
                            pi2 = pi2 + 1;
                        }

                        let dir_ptrs = if dopts.lib_dir_count > 0 {
                            arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                opts_mul_usize(dopts.lib_dir_count, size_of<*const u8>()),
                                align_of<*const u8>()
                            ) as *mut *const u8
                        } else {
                            0 as *mut *const u8
                        };
                        let mut di: usize = 0;
                        while di < dopts.lib_dir_count {
                            let d_sv = sv_slot_get(dopts.lib_dirs as *const StrView, di);
                            let cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(d_sv));
                            unsafe { *pipe_cstr_ptr_at(dir_ptrs, di) = cstr; }
                            di = di + 1;
                        }

                        let lib_ptrs = if dopts.lib_name_count > 0 {
                            arena_alloc_raw(
                                mut_view(ctx.backend_arena),
                                opts_mul_usize(dopts.lib_name_count, size_of<*const u8>()),
                                align_of<*const u8>()
                            ) as *mut *const u8
                        } else {
                            0 as *mut *const u8
                        };
                        let mut li: usize = 0;
                        while li < dopts.lib_name_count {
                            let l_sv = sv_slot_get(dopts.lib_names as *const StrView, li);
                            let cstr = pipe_sv_to_cstr_in_arena(mut_view(ctx.backend_arena), view(l_sv));
                            unsafe { *pipe_cstr_ptr_at(lib_ptrs, li) = cstr; }
                            li = li + 1;
                        }

                        if !pe_link_obj_and_libs_to_buf(
                            mem_obj_buf.ptr as *const u8,
                            mem_obj_buf.len,
                            in_ptrs as *const *const u8,
                            in_idx,
                            dir_ptrs as *const *const u8,
                            dopts.lib_dir_count,
                            lib_ptrs as *const *const u8,
                            dopts.lib_name_count,
                            attr_ptrs as *const *const u8,
                            attr_lib_count,
                            stack_res,
                            mut_view(pe_buf),
                            sink_ptr
                        ) {
                            rc = AX_EXIT_DIAG;
                        } else {
                            if (out_artifact as usize) != 0 {
                                coff_buf_put_bytes(unsafe { mut_view(*out_artifact) }, pe_buf.ptr as *const u8, pe_buf.len);
                            }
                            if write_to_disk {
                                if !pe_write_buf_to_path_bytes(view(pe_buf), out_path.ptr, out_path.len) {
                                    rc = AX_EXIT_DIAG;
                                }
                            }
                        }
                    }
                    coff_buf_free(mut_view(mem_obj_buf));
                }
                coff_buf_free(mut_view(pe_buf));
            }
        }
        objmodel_free(mut_view(obj));
    }
    let t1 = monotonic_ns();
    if dopts.time_passes {
        let elapsed: u64 = if t1 >= t0 { t1 - t0 } else { 0u64 };
        format_pass_time(mut_view(*out_buf), 9u32, elapsed);
    }

    driver_flush_diagnostics(mut_view(*ctx), dopts, mut_view(*out_buf), mut_view(*err_buf));
    if session_has_errors(view(ctx.sess)) {
        rc = AX_EXIT_DIAG;
    }
    rc
}

pub fn driver_execute_build_into(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>,
    out_artifact: *mut CoffBuf,
    write_to_disk: bool
) -> i32 {
    let ctx_ptr = pipeline_ctx_alloc();
    let rc = driver_execute_build_into_ctx(
        unsafe { mut_view(*ctx_ptr) },
        dopts,
        mut_view(*out_buf),
        mut_view(*err_buf),
        out_artifact,
        write_to_disk
    );
    pipeline_ctx_dealloc(ctx_ptr);
    rc
}

pub fn driver_execute_build(
    dopts: view<DriverOptions>,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    driver_execute_build_into(dopts, mut_view(*out_buf), mut_view(*err_buf), 0 as *mut CoffBuf, true)
}

// =============================================================================
// 4. Top-Level Driver Entrypoints (`driver_run_args`, `driver_main`)
// =============================================================================

pub fn driver_run_args(
    args: *const StrView,
    argc: usize,
    out_buf: mut_view<DiagBuffer>,
    err_buf: mut_view<DiagBuffer>
) -> i32 {
    let dopts_ptr = driver_options_alloc();

    let parse_rc = driver_parse_cli(args, argc, unsafe { mut_view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    if parse_rc != AX_EXIT_OK {
        driver_options_dealloc(dopts_ptr);
        return parse_rc;
    }

    let cmd = unsafe { (*dopts_ptr).cmd };
    if cmd == CMD_HELP || cmd == CMD_VERSION || cmd == CMD_FEATURES {
        driver_options_dealloc(dopts_ptr);
        return AX_EXIT_OK;
    }

    let mut rc: i32 = AX_EXIT_USAGE;
    if cmd == CMD_INSPECT {
        rc = driver_execute_inspect(unsafe { view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    } else if cmd == CMD_CHECK {
        rc = driver_execute_check(unsafe { view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    } else if cmd == CMD_RUN {
        rc = driver_execute_run(unsafe { view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    } else if cmd == CMD_BUILD {
        rc = driver_execute_build(unsafe { view(*dopts_ptr) }, mut_view(*out_buf), mut_view(*err_buf));
    }

    driver_options_dealloc(dopts_ptr);
    rc
}

fn flush_buf_to_stdio(which: u32, buf: view<DiagBuffer>) {
    if buf.len == 0 || (buf.ptr as usize) == 0 {
        return;
    }
    let h = stdio(which);
    if h < 0i64 {
        return;
    }
    let mut written: usize = 0;
    while written < buf.len {
        let p = unsafe { (buf.ptr as *const u8) + written };
        let wr = unsafe { write(h, p, buf.len - written) };
        if wr <= 0i64 {
            break;
        }
        written = written + (wr as usize);
    }
}

pub fn driver_main() -> i32 {
    let mut arg_arena = arena_new();
    let raw_argc = args_count();
    let argc: usize = if raw_argc == 0 { 1 } else { raw_argc };
    let argv_bytes = opts_mul_usize(argc, size_of<StrView>());
    let argv = unsafe { heap_alloc(argv_bytes, align_of<StrView>()) as *mut StrView };

    if raw_argc == 0 {
        let def_bin = arena_alloc_raw(mut_view(arg_arena), 7, 1);
        let mut k: usize = 0;
        while k < 6 {
            unsafe { *(def_bin + k) = PIPELINE_STR_TABLE[126 + k]; }
            k = k + 1;
        }
        unsafe {
            *(def_bin + 6) = 0u8;
        }
        let s0 = StrView { ptr: def_bin as *const u8, len: 6 };
        sv_slot_set(argv, 0, view(s0));
    } else {
        let mut i: usize = 0;
        while i < raw_argc {
            let need = unsafe { arg(i, 0 as *mut u8, 0) };
            if need <= 0i64 {
                let empty_sv = sv_empty();
                sv_slot_set(argv, i, view(empty_sv));
            } else {
                let ulen = need as usize;
                let abuf = arena_alloc_raw(mut_view(arg_arena), ulen + 1, 1);
                let _ = unsafe { arg(i, abuf, ulen) };
                unsafe {
                    *(abuf + ulen) = 0u8;
                }
                let si = StrView { ptr: abuf as *const u8, len: ulen };
                sv_slot_set(argv, i, view(si));
            }
            i = i + 1;
        }
    }

    let mut out_buf = diag_buf_new();
    let mut err_buf = diag_buf_new();

    let rc = driver_run_args(argv as *const StrView, argc, mut_view(out_buf), mut_view(err_buf));
    flush_buf_to_stdio(1u32, view(out_buf));
    flush_buf_to_stdio(2u32, view(err_buf));

    diag_buf_free(mut_view(out_buf));
    diag_buf_free(mut_view(err_buf));
    unsafe {
        heap_free(argv as *mut u8, argv_bytes, align_of<StrView>());
    }
    arena_destroy(mut_view(arg_arena));
    rc
}
