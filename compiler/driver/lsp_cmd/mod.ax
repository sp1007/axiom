use compiler.lsp.protocol.LSP_ERR_METHOD_NOT_FOUND
use compiler.lsp.protocol.LSP_ERR_SERVER_NOT_INITIALIZED
use compiler.lsp.protocol.LSP_ERR_REQUEST_CANCELLED
