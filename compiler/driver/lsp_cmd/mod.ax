use compiler.lsp.protocol.METHOD_SEMANTIC_TOKENS_DELTA
use compiler.lsp.protocol.METHOD_INLAY_HINT
use compiler.lsp.protocol.lsp_str_view
use compiler.lsp.protocol.lsp_session_new
use compiler.lsp.protocol.lsp_classify_method
use compiler.lsp.protocol.lsp_is_notification_method
