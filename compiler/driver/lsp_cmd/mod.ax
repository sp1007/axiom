use compiler.lsp.protocol.MSG_NOTIFICATION
use compiler.lsp.protocol.METHOD_UNKNOWN
use compiler.lsp.protocol.METHOD_INITIALIZE
use compiler.lsp.protocol.METHOD_INITIALIZED
use compiler.lsp.protocol.METHOD_SHUTDOWN
use compiler.lsp.protocol.METHOD_EXIT
use compiler.lsp.protocol.METHOD_CANCEL_REQUEST
use compiler.lsp.protocol.METHOD_DID_OPEN
use compiler.lsp.protocol.METHOD_DID_CHANGE
use compiler.lsp.protocol.METHOD_DID_SAVE
use compiler.lsp.protocol.METHOD_DID_CLOSE
