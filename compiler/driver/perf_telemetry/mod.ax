const OFF_H_SR_SEC: usize = 1216; const LEN_H_SR_SEC: usize = 10;
const OFF_H_SR_VIRT: usize = 1226; const LEN_H_SR_VIRT: usize = 6;
const OFF_H_SR_STARTUP: usize = 1232; const LEN_H_SR_STARTUP: usize = 9;
const OFF_H_SR_HOT: usize = 1241; const LEN_H_SR_HOT: usize = 5;
const OFF_H_SR_WARM: usize = 1246; const LEN_H_SR_WARM: usize = 6;
const OFF_H_SR_COLD: usize = 1252; const LEN_H_SR_COLD: usize = 6;
const OFF_H_SR_DLLS: usize = 1258; const LEN_H_SR_DLLS: usize = 6;
const OFF_H_SR_SYMS: usize = 1264; const LEN_H_SR_SYMS: usize = 6;
const OFF_H_SR_ATTR: usize = 1270; const LEN_H_SR_ATTR: usize = 22;
const OFF_H_SR_STD: usize = 1292; const LEN_H_SR_STD: usize = 5;
const OFF_H_SR_USER: usize = 1297; const LEN_H_SR_USER: usize = 6;
const OFF_H_SR_GEN: usize = 1303; const LEN_H_SR_GEN: usize = 16;
const OFF_H_SR_GC: usize = 1319; const LEN_H_SR_GC: usize = 15;
const OFF_H_SR_ICF: usize = 1334; const LEN_H_SR_ICF: usize = 11;
const OFF_H_SR_RMERG: usize = 1345; const LEN_H_SR_RMERG: usize = 14;
const OFF_H_SR_SALLOC: usize = 1359; const LEN_H_SR_SALLOC: usize = 16;
const OFF_H_SR_SYM: usize = 1375; const LEN_H_SR_SYM: usize = 13;
const OFF_H_SR_NAME: usize = 1388; const LEN_H_SR_NAME: usize = 6;
const OFF_H_SR_SSEC: usize = 1394; const LEN_H_SR_SSEC: usize = 5;
const OFF_H_SR_SHEAT: usize = 1399; const LEN_H_SR_SHEAT: usize = 6;
const OFF_H_SR_SORIG: usize = 1405; const LEN_H_SR_SORIG: usize = 8;
const OFF_H_SR_SBYTES: usize = 1413; const LEN_H_SR_SBYTES: usize = 7;

fn perf_push_str(out: mut_view<DiagBuffer>, off: usize, len: usize) {
    let mut i: usize = 0;
    while i < len {
        diag_buf_push_byte(mut_view(*out), PERF_STR_DATA[off + i]);
        i = i + 1;
    }
}

pub fn perf_push_u64(out: mut_view<DiagBuffer>, mut val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(out, 48u8);
        return;
    }
    let mut digits: [20]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ];
    let mut count: usize = 0;
    while val > 0u64 {
        digits[count] = ((val % 10u64) as u8) + 48u8;
        val = val / 10u64;
        count = count + 1;
    }
    while count > 0 {
        count = count - 1;
        diag_buf_push_byte(mut_view(*out), digits[count]);
    }
}

fn perf_push_sec_frac6(out: mut_view<DiagBuffer>, elapsed_us: u64) {
    let secs: u64 = elapsed_us / 1000000u64;
    let frac: u64 = elapsed_us % 1000000u64;
    perf_push_u64(mut_view(*out), secs);
    diag_buf_push_byte(mut_view(*out), 46u8);
    let mut div: u64 = 100000u64;
    while div > 0u64 {
        let d: u8 = (((frac / div) % 10u64) as u8) + 48u8;
        diag_buf_push_byte(mut_view(*out), d);
        div = div / 10u64;
    }
}

fn perf_push_profile_name(out: mut_view<DiagBuffer>, opt_profile: u32) {
    if opt_profile == PERF_OPT_O0 {
        perf_push_str(out, OFF_PROF_O0, LEN_PROF_O0);
    } else if opt_profile == PERF_OPT_O1 {
        perf_push_str(out, OFF_PROF_O1, LEN_PROF_O1);
    } else if opt_profile == PERF_OPT_OS {
        perf_push_str(out, OFF_PROF_OS, LEN_PROF_OS);
    } else if opt_profile == PERF_OPT_OZ {
        perf_push_str(out, OFF_PROF_OZ, LEN_PROF_OZ);
    } else {
        perf_push_str(out, OFF_PROF_O2, LEN_PROF_O2);
    }
}

