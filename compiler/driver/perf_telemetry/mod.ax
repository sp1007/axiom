fn perf_push_sec_kind_name(out: mut_view<DiagBuffer>, kind: u8) {
    if kind == SEC_KIND_TEXT || kind == SEC_KIND_IMPORT_THUNK {
        perf_push_str(out, OFF_SEC_TEXT, LEN_SEC_TEXT);
    } else if kind == SEC_KIND_RDATA {
        perf_push_str(out, OFF_SEC_RDATA, LEN_SEC_RDATA);
    } else if kind == SEC_KIND_DATA {
        perf_push_str(out, OFF_SEC_DATA, LEN_SEC_DATA);
    } else if kind == SEC_KIND_BSS {
        perf_push_str(out, OFF_SEC_BSS, LEN_SEC_BSS);
    } else {
        perf_push_str(out, OFF_SEC_PDATA_XDATA, LEN_SEC_PDATA_XDATA);
    }
}

