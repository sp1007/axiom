// =============================================================================
// 2. Profile Cost-Model Policies & Monomorphization Sharing (`AXS-PERF-010..014`)
// =============================================================================

@derive(Copy)
pub struct ProfileCostPolicy {
    pub opt_profile: u32,
    pub inline_base_cost: u32,
    pub inline_hot_cost: u32,
    pub inline_cold_cost: u32,
    pub max_caller_growth_pct: u32,
    pub max_unroll_factor: u32,
    pub max_unroll_insts: u32,
    pub autovec_enabled: bool,
    pub autovec_allow_expansion: bool,
    pub code_sharing_enabled: bool,
    pub section_gc_enabled: bool,
    pub safe_icf_enabled: bool,
    pub allow_icf_thunks: bool,
    pub fn_align_bytes: u32,
    pub preserve_safety_barriers: bool,
    pub requires_monolithic_runtime: bool,
}

pub fn perf_policy_for_profile(opt_profile: u32) -> ProfileCostPolicy {
    if opt_profile == PERF_OPT_O0 {
        return ProfileCostPolicy {
            opt_profile: PERF_OPT_O0,
            inline_base_cost: 0u32,
            inline_hot_cost: 0u32,
            inline_cold_cost: 0u32,
            max_caller_growth_pct: 0u32,
            max_unroll_factor: 1u32,
            max_unroll_insts: 0u32,
            autovec_enabled: false,
            autovec_allow_expansion: false,
            code_sharing_enabled: false,
            section_gc_enabled: false,
            safe_icf_enabled: false,
            allow_icf_thunks: false,
            fn_align_bytes: 16u32,
            preserve_safety_barriers: true,
            requires_monolithic_runtime: false,
        };
    }
    if opt_profile == PERF_OPT_O1 {
        return ProfileCostPolicy {
            opt_profile: PERF_OPT_O1,
            inline_base_cost: 60u32,
            inline_hot_cost: 60u32,
            inline_cold_cost: 15u32,
            max_caller_growth_pct: 15u32,
            max_unroll_factor: 2u32,
            max_unroll_insts: 16u32,
            autovec_enabled: false,
            autovec_allow_expansion: false,
            code_sharing_enabled: true,
            section_gc_enabled: true,
            safe_icf_enabled: false,
            allow_icf_thunks: false,
            fn_align_bytes: 16u32,
            preserve_safety_barriers: true,
            requires_monolithic_runtime: false,
        };
    }
    if opt_profile == PERF_OPT_OS {
        return ProfileCostPolicy {
            opt_profile: PERF_OPT_OS,
            inline_base_cost: 45u32,
            inline_hot_cost: 75u32,
            inline_cold_cost: 0u32,
            max_caller_growth_pct: 5u32,
            max_unroll_factor: 2u32,
            max_unroll_insts: 16u32,
            autovec_enabled: true,
            autovec_allow_expansion: false,
            code_sharing_enabled: true,
            section_gc_enabled: true,
            safe_icf_enabled: true,
            allow_icf_thunks: true,
            fn_align_bytes: 16u32,
            preserve_safety_barriers: true,
            requires_monolithic_runtime: false,
        };
    }
    if opt_profile == PERF_OPT_OZ {
        return ProfileCostPolicy {
            opt_profile: PERF_OPT_OZ,
            inline_base_cost: 12u32,
            inline_hot_cost: 12u32,
            inline_cold_cost: 0u32,
            max_caller_growth_pct: 0u32,
            max_unroll_factor: 1u32,
            max_unroll_insts: 0u32,
            autovec_enabled: false,
            autovec_allow_expansion: false,
            code_sharing_enabled: true,
            section_gc_enabled: true,
            safe_icf_enabled: true,
            allow_icf_thunks: true,
            fn_align_bytes: 1u32,
            preserve_safety_barriers: true,
            requires_monolithic_runtime: false,
        };
    }
    ProfileCostPolicy {
        opt_profile: PERF_OPT_O2,
        inline_base_cost: 225u32,
        inline_hot_cost: 450u32,
        inline_cold_cost: 15u32,
        max_caller_growth_pct: 30u32,
        max_unroll_factor: 8u32,
        max_unroll_insts: 64u32,
        autovec_enabled: true,
        autovec_allow_expansion: true,
        code_sharing_enabled: true,
        section_gc_enabled: true,
        safe_icf_enabled: true,
        allow_icf_thunks: true,
        fn_align_bytes: 32u32,
        preserve_safety_barriers: true,
        requires_monolithic_runtime: false,
    }
}

pub fn perf_should_inline(
    policy: view<ProfileCostPolicy>,
    callee_cost: u32,
    callsite_count: u32,
    is_hot: bool,
    is_cold: bool,
    caller_insts: u32,
    current_growth_insts: u32
) -> bool {
    if policy.opt_profile == PERF_OPT_O0 {
        return false;
    }
    // Single-callsite private helper (`callsite_count == 1`) shrinks or keeps binary neutral when
    // call overhead (~12 units) is eliminated (`AXS-PERF-013`, `AXS-PERF-014`).
    if callsite_count == 1u32 && callee_cost <= policy.inline_base_cost + 24u32 {
        return true;
    }
    if is_cold && (policy.opt_profile == PERF_OPT_OS || policy.opt_profile == PERF_OPT_OZ) {
        return false;
    }
    let threshold: u32 = if is_hot {
        policy.inline_hot_cost
    } else if is_cold {
        policy.inline_cold_cost
    } else {
        policy.inline_base_cost
    };
    if callee_cost > threshold {
        return false;
    }
    let max_growth: u32 = (caller_insts * policy.max_caller_growth_pct) / 100u32;
    if current_growth_insts + callee_cost > max_growth && callee_cost > 12u32 {
        return false;
    }
    true
}

pub fn perf_can_share_monomorphized_body(
    policy: view<ProfileCostPolicy>,
    layout_size_a: u32,
    layout_align_a: u32,
    layout_size_b: u32,
    layout_align_b: u32,
    has_type_specific_semantics: bool,
    is_hot_loop: bool
) -> bool {
    if !policy.code_sharing_enabled {
        return false;
    }
    if has_type_specific_semantics {
        return false;
    }
    if layout_size_a != layout_size_b || layout_align_a != layout_align_b {
        return false;
    }
    if policy.opt_profile == PERF_OPT_O2 && is_hot_loop {
        return false;
    }
    true
}

// =============================================================================
// 3. Bounded Auto-Tuning & Reproducible Provenance Isolation (`AXS-PERF-004`)
// =============================================================================

@derive(Copy)
pub struct AutoTuneBudget {
    pub scope: u32,
    pub max_candidates: u32,
    pub max_iterations_per_cand: u32,
    pub max_wall_time_ms: u64,
    pub max_memory_bytes: u64,
}

@derive(Copy)
pub struct AutoTuneCandidate {
    pub cand_id: u32,
    pub unroll_factor: u32,
    pub vec_width_bits: u32,
    pub inline_threshold: u32,
    pub is_legality_proven: bool,
    pub iterations_run: u32,
    pub measured_median_us: u64,
    pub wall_time_ms: u64,
    pub code_size_bytes: u64,
    pub peak_rss_bytes: u64,
}

@derive(Copy)
pub struct AutoTuneResult {
    pub selected_cand_id: u32,
    pub best_median_us: u64,
    pub best_code_size_bytes: u64,
    pub candidates_evaluated: u32,
    pub rejected_unproven_count: u32,
    pub rejected_budget_count: u32,
    pub terminated_by_budget: bool,
    pub feedback_digest: u64,
}

@derive(Copy)
pub struct ArtifactProvenanceHeader {
    pub program_fingerprint: u64,
    pub opt_profile: u32,
    pub has_pgo_profile: bool,
    pub pgo_profile_digest: u64,
    pub has_autotune_feedback: bool,
    pub autotune_feedback_digest: u64,
    pub cache_key_lo: u64,
    pub cache_key_hi: u64,
}

fn perf_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn perf_cand_at(base: *const AutoTuneCandidate, idx: usize) -> *const AutoTuneCandidate {
    let off = perf_mul_usize(idx, size_of<AutoTuneCandidate>());
    ((base as usize) + off) as *const AutoTuneCandidate
}

fn perf_fnv1a_init() -> u64 {
    14695981039346656037u64
}

fn perf_fnv1a_u8(h: u64, b: u8) -> u64 {
    wrapping_mul_u64(h ^ (b as u64), 1099511628211u64)
}

fn perf_fnv1a_u32(h: u64, v: u32) -> u64 {
    let mut cur: u64 = perf_fnv1a_u8(h, (v & 255u32) as u8);
    cur = perf_fnv1a_u8(cur, ((v >> 8u32) & 255u32) as u8);
    cur = perf_fnv1a_u8(cur, ((v >> 16u32) & 255u32) as u8);
    cur = perf_fnv1a_u8(cur, ((v >> 24u32) & 255u32) as u8);
    cur
}

fn perf_fnv1a_u64(h: u64, v: u64) -> u64 {
    let lo: u32 = (v & 0xFFFFFFFFu64) as u32;
    let hi: u32 = ((v >> 32u64) & 0xFFFFFFFFu64) as u32;
    perf_fnv1a_u32(perf_fnv1a_u32(h, lo), hi)
}

pub fn perf_autotune_default_budget(scope: u32) -> AutoTuneBudget {
    if scope == TUNE_SCOPE_LOOP {
        return AutoTuneBudget {
            scope: TUNE_SCOPE_LOOP,
            max_candidates: 8u32,
            max_iterations_per_cand: 16u32,
            max_wall_time_ms: 250u64,
            max_memory_bytes: 67108864u64,
        };
    }
    if scope == TUNE_SCOPE_FUNCTION {
        return AutoTuneBudget {
            scope: TUNE_SCOPE_FUNCTION,
            max_candidates: 16u32,
            max_iterations_per_cand: 16u32,
            max_wall_time_ms: 500u64,
            max_memory_bytes: 134217728u64,
        };
    }
    AutoTuneBudget {
        scope: scope,
        max_candidates: 32u32,
        max_iterations_per_cand: 32u32,
        max_wall_time_ms: 2000u64,
        max_memory_bytes: 268435456u64,
    }
}

pub fn perf_autotune_evaluate(
    budget: view<AutoTuneBudget>,
    cands: *const AutoTuneCandidate,
    cand_count: u32,
    opt_profile: u32
) -> AutoTuneResult {
    let mut selected_id: u32 = TUNE_CAND_NONE;
    let mut best_us: u64 = 0xFFFFFFFFFFFFFFFFu64;
    let mut best_sz: u64 = 0xFFFFFFFFFFFFFFFFu64;
    let mut best_unroll: u32 = 1u32;
    let mut best_vec: u32 = 0u32;
    let mut best_inline: u32 = 0u32;
    let mut evaluated: u32 = 0u32;
    let mut rej_unproven: u32 = 0u32;
    let mut rej_budget: u32 = 0u32;
    let mut hit_budget: bool = false;
    let mut accum_wall_ms: u64 = 0u64;

    let mut i: u32 = 0u32;
    while i < cand_count && (cands as usize) != 0 {
        let cp = unsafe { perf_cand_at(cands, i as usize) };
        let c_id = unsafe { (*cp).cand_id };
        let c_legal = unsafe { (*cp).is_legality_proven };
        let c_iters = unsafe { (*cp).iterations_run };
        let c_us = unsafe { (*cp).measured_median_us };
        let c_wall = unsafe { (*cp).wall_time_ms };
        let c_sz = unsafe { (*cp).code_size_bytes };
        let c_rss = unsafe { (*cp).peak_rss_bytes };
        let c_unroll = unsafe { (*cp).unroll_factor };
        let c_vec = unsafe { (*cp).vec_width_bits };
        let c_inline = unsafe { (*cp).inline_threshold };

        // REQ-OPT-242: Auto-tuning is purely profitability feedback over compiler-proven-legal candidates.
        // Any candidate lacking static legality proof is unconditionally rejected regardless of speed.
        if !c_legal {
            rej_unproven = rej_unproven + 1u32;
        } else if evaluated >= budget.max_candidates ||
                  c_iters > budget.max_iterations_per_cand ||
                  accum_wall_ms + c_wall > budget.max_wall_time_ms ||
                  c_rss > budget.max_memory_bytes {
            // REQ-OPT-243: Bounded resource enforcement (candidates, iterations, wall-time, memory).
            rej_budget = rej_budget + 1u32;
            hit_budget = true;
        } else {
            evaluated = evaluated + 1u32;
            accum_wall_ms = accum_wall_ms + c_wall;

            let is_better: bool = if opt_profile == PERF_OPT_OS || opt_profile == PERF_OPT_OZ {
                if c_sz != best_sz {
                    c_sz < best_sz
                } else if c_us != best_us {
                    c_us < best_us
                } else {
                    c_id < selected_id
                }
            } else {
                if c_us != best_us {
                    c_us < best_us
                } else if c_sz != best_sz {
                    c_sz < best_sz
                } else {
                    c_id < selected_id
                }
            };

            if is_better {
                selected_id = c_id;
                best_us = c_us;
                best_sz = c_sz;
                best_unroll = c_unroll;
                best_vec = c_vec;
                best_inline = c_inline;
            }
        }
        i = i + 1u32;
    }

    // REQ-OPT-244: Feedback digest hashes ONLY the selected transformation parameters, never wall-clock noise.
    let mut digest: u64 = perf_fnv1a_init();
    digest = perf_fnv1a_u32(digest, budget.scope);
    digest = perf_fnv1a_u32(digest, opt_profile);
    digest = perf_fnv1a_u32(digest, selected_id);
    digest = perf_fnv1a_u32(digest, best_unroll);
    digest = perf_fnv1a_u32(digest, best_vec);
    digest = perf_fnv1a_u32(digest, best_inline);

    AutoTuneResult {
        selected_cand_id: selected_id,
        best_median_us: if selected_id == TUNE_CAND_NONE { 0u64 } else { best_us },
        best_code_size_bytes: if selected_id == TUNE_CAND_NONE { 0u64 } else { best_sz },
        candidates_evaluated: evaluated,
        rejected_unproven_count: rej_unproven,
        rejected_budget_count: rej_budget,
        terminated_by_budget: hit_budget,
        feedback_digest: digest,
    }
}

pub fn perf_compute_artifact_provenance(
    program_fingerprint: u64,
    opt_profile: u32,
    has_pgo_profile: bool,
    pgo_profile_digest: u64,
    has_autotune_feedback: bool,
    autotune_feedback_digest: u64
) -> ArtifactProvenanceHeader {
    let eff_pgo: u64 = if has_pgo_profile { pgo_profile_digest } else { 0u64 };
    let eff_tune: u64 = if has_autotune_feedback { autotune_feedback_digest } else { 0u64 };

    let mut lo: u64 = perf_fnv1a_init();
    lo = perf_fnv1a_u64(lo, program_fingerprint);
    lo = perf_fnv1a_u32(lo, opt_profile);
    lo = perf_fnv1a_u8(lo, if has_pgo_profile { 1u8 } else { 0u8 });
    lo = perf_fnv1a_u64(lo, eff_pgo);
    lo = perf_fnv1a_u8(lo, if has_autotune_feedback { 1u8 } else { 0u8 });
    lo = perf_fnv1a_u64(lo, eff_tune);

    let mut hi: u64 = 1099511628211u64 ^ lo;
    hi = perf_fnv1a_u64(hi, program_fingerprint ^ eff_pgo);
    hi = perf_fnv1a_u64(hi, eff_tune ^ (opt_profile as u64));

    ArtifactProvenanceHeader {
        program_fingerprint: program_fingerprint,
        opt_profile: opt_profile,
        has_pgo_profile: has_pgo_profile,
        pgo_profile_digest: eff_pgo,
        has_autotune_feedback: has_autotune_feedback,
        autotune_feedback_digest: eff_tune,
        cache_key_lo: lo,
        cache_key_hi: hi,
    }
}

pub fn perf_verify_telemetry_orthogonality(
    prov_normal: view<ArtifactProvenanceHeader>,
    prov_timed: view<ArtifactProvenanceHeader>,
    binary_digest_normal: u64,
    binary_digest_timed: u64
) -> bool {
    prov_normal.cache_key_lo == prov_timed.cache_key_lo &&
        prov_normal.cache_key_hi == prov_timed.cache_key_hi &&
        binary_digest_normal == binary_digest_timed
}

// =============================================================================
// 4. `--time-passes` Collector & Deterministic Counter Digest (`AXS-PERF-030`)
// =============================================================================

@derive(Copy)
pub struct PassTimingRecord {
    pub pass_id: u32,
    pub is_opt_pass: bool,
    pub elapsed_us: u64,
    pub peak_arena_bytes: u64,
    pub ir_blocks: u32,
    pub insts_before: u32,
    pub insts_after: u32,
    pub transforms_applied: u32,
    pub bce_eliminated: u32,
    pub loops_vectorized: u32,
    pub spills_inserted: u32,
    pub sections_total: u32,
    pub sections_gc_removed: u32,
    pub icf_folded: u32,
}

pub struct TimePassesReport {
    pub opt_profile: u32,
    pub total_elapsed_us: u64,
    pub peak_arena_bytes: u64,
    pub records: *mut PassTimingRecord,
    pub record_count: u32,
    pub record_cap: u32,
}

pub unsafe fn perf_timing_rec_at(base: *mut PassTimingRecord, idx: usize) -> *mut PassTimingRecord {
    let off = perf_mul_usize(idx, size_of<PassTimingRecord>());
    ((base as usize) + off) as *mut PassTimingRecord
}

pub fn time_passes_report_new(opt_profile: u32) -> TimePassesReport {
    TimePassesReport {
        opt_profile: opt_profile,
        total_elapsed_us: 0u64,
        peak_arena_bytes: 0u64,
        records: 0 as *mut PassTimingRecord,
        record_count: 0u32,
        record_cap: 0u32,
    }
}

pub fn time_passes_report_free(rep: mut_view<TimePassesReport>) {
    if rep.record_cap > 0u32 && (rep.records as usize) != 0 {
        let bytes = perf_mul_usize(rep.record_cap as usize, size_of<PassTimingRecord>());
        unsafe {
            heap_free(rep.records as *mut u8, bytes, 8);
        }
    }
    rep.records = 0 as *mut PassTimingRecord;
    rep.record_count = 0u32;
    rep.record_cap = 0u32;
}

pub fn time_passes_record_push(rep: mut_view<TimePassesReport>, rec: PassTimingRecord) {
    if rep.record_count == rep.record_cap {
        let new_cap: u32 = if rep.record_cap == 0u32 { 16u32 } else { rep.record_cap * 2u32 };
        let new_bytes = perf_mul_usize(new_cap as usize, size_of<PassTimingRecord>());
        let new_ptr = unsafe { heap_alloc(new_bytes, 8) as *mut PassTimingRecord };
        let mut i: u32 = 0u32;
        while i < rep.record_count {
            unsafe {
                *perf_timing_rec_at(new_ptr, i as usize) = *perf_timing_rec_at(rep.records, i as usize);
            }
            i = i + 1u32;
        }
        if rep.record_cap > 0u32 && (rep.records as usize) != 0 {
            let old_bytes = perf_mul_usize(rep.record_cap as usize, size_of<PassTimingRecord>());
            unsafe {
                heap_free(rep.records as *mut u8, old_bytes, 8);
            }
        }
        rep.records = new_ptr;
        rep.record_cap = new_cap;
    }
    unsafe {
        *perf_timing_rec_at(rep.records, rep.record_count as usize) = rec;
    }
    rep.record_count = rep.record_count + 1u32;
    rep.total_elapsed_us = rep.total_elapsed_us + rec.elapsed_us;
    if rec.peak_arena_bytes > rep.peak_arena_bytes {
        rep.peak_arena_bytes = rec.peak_arena_bytes;
    }
}

pub fn time_passes_deterministic_digest(rep: view<TimePassesReport>) -> u64 {
    // AXS-PERF-030 Rule 3 & REQ-OPT-245: Deterministic digest hashes ONLY structural IR/section
    // counters (`insts_before`, `insts_after`, `transforms_applied`, `bce_eliminated`, etc.) and
    // NEVER includes `elapsed_us` wall-clock timing.
    let mut h: u64 = perf_fnv1a_init();
    h = perf_fnv1a_u32(h, rep.opt_profile);
    h = perf_fnv1a_u32(h, rep.record_count);
    let mut i: u32 = 0u32;
    while i < rep.record_count && (rep.records as usize) != 0 {
        let rp = unsafe { perf_timing_rec_at(rep.records, i as usize) };
        unsafe {
            h = perf_fnv1a_u32(h, (*rp).pass_id);
            h = perf_fnv1a_u8(h, if (*rp).is_opt_pass { 1u8 } else { 0u8 });
            h = perf_fnv1a_u32(h, (*rp).ir_blocks);
            h = perf_fnv1a_u32(h, (*rp).insts_before);
            h = perf_fnv1a_u32(h, (*rp).insts_after);
            h = perf_fnv1a_u32(h, (*rp).transforms_applied);
            h = perf_fnv1a_u32(h, (*rp).bce_eliminated);
            h = perf_fnv1a_u32(h, (*rp).loops_vectorized);
            h = perf_fnv1a_u32(h, (*rp).spills_inserted);
            h = perf_fnv1a_u32(h, (*rp).sections_total);
            h = perf_fnv1a_u32(h, (*rp).sections_gc_removed);
            h = perf_fnv1a_u32(h, (*rp).icf_folded);
        }
        i = i + 1u32;
    }
    h
}

// =============================================================================
// 5. `--size-report` 3D Binary Footprint & Symbol Attribution (`AXS-PERF-020..031`)
// =============================================================================

@derive(Copy)
pub struct SymbolSizeEntry {
    pub sym_id: u32,
    pub name_id: u32,
    pub section_kind: u8,
    pub heat_bucket: u8,
    pub origin_kind: u8,
    pub is_generic_instance: bool,
    pub size_bytes: u64,
}

pub struct SizeReport {
    pub opt_profile: u32,
    pub file_size_bytes: u64,
    pub stripped_file_size_bytes: u64,
    pub mapped_size_bytes: u64,
    pub startup_working_set_bytes: u64,
    pub peak_working_set_bytes: u64,
    pub alignment_padding_bytes: u64,
    pub page_padding_bytes: u64,
    pub text_file_bytes: u64,
    pub text_virtual_bytes: u64,
    pub text_startup_bytes: u64,
    pub text_hot_bytes: u64,
    pub text_warm_bytes: u64,
    pub text_cold_bytes: u64,
    pub rdata_file_bytes: u64,
    pub rdata_virtual_bytes: u64,
    pub data_file_bytes: u64,
    pub data_virtual_bytes: u64,
    pub bss_file_bytes: u64,
    pub bss_virtual_bytes: u64,
    pub pdata_xdata_file_bytes: u64,
    pub pdata_xdata_virtual_bytes: u64,
    pub idata_file_bytes: u64,
    pub idata_virtual_bytes: u64,
    pub import_dll_count: u32,
    pub import_sym_count: u32,
    pub runtime_bytes: u64,
    pub std_bytes: u64,
    pub user_bytes: u64,
    pub generic_family_bytes: u64,
    pub gc_eliminated_bytes: u64,
    pub icf_saved_bytes: u64,
    pub rdata_merged_bytes: u64,
    pub startup_allocations: u32,
    pub symbols: *mut SymbolSizeEntry,
    pub sym_count: u32,
    pub sym_cap: u32,
}

pub unsafe fn perf_sym_entry_at(base: *mut SymbolSizeEntry, idx: usize) -> *mut SymbolSizeEntry {
    let off = perf_mul_usize(idx, size_of<SymbolSizeEntry>());
    ((base as usize) + off) as *mut SymbolSizeEntry
}

fn perf_align_up_u64(val: u64, align: u64) -> u64 {
    if align <= 1u64 || val == 0u64 {
        return val;
    }
    let mask: u64 = align - 1u64;
    (val + mask) & (0xFFFFFFFFFFFFFFFFu64 ^ mask)
}

pub fn size_report_new(opt_profile: u32) -> SizeReport {
    SizeReport {
        opt_profile: opt_profile,
        file_size_bytes: 0u64,
        stripped_file_size_bytes: 0u64,
        mapped_size_bytes: 0u64,
        startup_working_set_bytes: 0u64,
        peak_working_set_bytes: 0u64,
        alignment_padding_bytes: 0u64,
        page_padding_bytes: 0u64,
        text_file_bytes: 0u64,
        text_virtual_bytes: 0u64,
        text_startup_bytes: 0u64,
        text_hot_bytes: 0u64,
        text_warm_bytes: 0u64,
        text_cold_bytes: 0u64,
        rdata_file_bytes: 0u64,
        rdata_virtual_bytes: 0u64,
        data_file_bytes: 0u64,
        data_virtual_bytes: 0u64,
        bss_file_bytes: 0u64,
        bss_virtual_bytes: 0u64,
        pdata_xdata_file_bytes: 0u64,
        pdata_xdata_virtual_bytes: 0u64,
        idata_file_bytes: 0u64,
        idata_virtual_bytes: 0u64,
        import_dll_count: 0u32,
        import_sym_count: 0u32,
        runtime_bytes: 0u64,
        std_bytes: 0u64,
        user_bytes: 0u64,
        generic_family_bytes: 0u64,
        gc_eliminated_bytes: 0u64,
        icf_saved_bytes: 0u64,
        rdata_merged_bytes: 0u64,
        startup_allocations: 0u32,
        symbols: 0 as *mut SymbolSizeEntry,
        sym_count: 0u32,
        sym_cap: 0u32,
    }
}

pub fn size_report_free(rep: mut_view<SizeReport>) {
    if rep.sym_cap > 0u32 && (rep.symbols as usize) != 0 {
        let bytes = perf_mul_usize(rep.sym_cap as usize, size_of<SymbolSizeEntry>());
        unsafe {
            heap_free(rep.symbols as *mut u8, bytes, 8);
        }
    }
    rep.symbols = 0 as *mut SymbolSizeEntry;
    rep.sym_count = 0u32;
    rep.sym_cap = 0u32;
}

pub fn size_report_add_symbol(rep: mut_view<SizeReport>, entry: SymbolSizeEntry) {
    if rep.sym_count == rep.sym_cap {
        let new_cap: u32 = if rep.sym_cap == 0u32 { 16u32 } else { rep.sym_cap * 2u32 };
        let new_bytes = perf_mul_usize(new_cap as usize, size_of<SymbolSizeEntry>());
        let new_ptr = unsafe { heap_alloc(new_bytes, 8) as *mut SymbolSizeEntry };
        let mut i: u32 = 0u32;
        while i < rep.sym_count {
            unsafe {
                *perf_sym_entry_at(new_ptr, i as usize) = *perf_sym_entry_at(rep.symbols, i as usize);
            }
            i = i + 1u32;
        }
        if rep.sym_cap > 0u32 && (rep.symbols as usize) != 0 {
            let old_bytes = perf_mul_usize(rep.sym_cap as usize, size_of<SymbolSizeEntry>());
            unsafe {
                heap_free(rep.symbols as *mut u8, old_bytes, 8);
            }
        }
        rep.symbols = new_ptr;
        rep.sym_cap = new_cap;
    }
    unsafe {
        *perf_sym_entry_at(rep.symbols, rep.sym_count as usize) = entry;
    }
    rep.sym_count = rep.sym_count + 1u32;
}

fn sym_entry_precedes(a: view<SymbolSizeEntry>, b: view<SymbolSizeEntry>) -> bool {
    // AXS-PERF-031 Rule 1: Deterministic symbol attribution sorted by descending size_bytes,
    // breaking ties by ascending name_id then sym_id.
    let a_sz = a.size_bytes;
    let b_sz = b.size_bytes;
    if a_sz != b_sz {
        return a_sz > b_sz;
    }
    let a_nm = a.name_id;
    let b_nm = b.name_id;
    if a_nm != b_nm {
        return a_nm < b_nm;
    }
    let a_id = a.sym_id;
    let b_id = b.sym_id;
    a_id < b_id
}

pub fn size_report_sort_symbols(rep: mut_view<SizeReport>) {
    if rep.sym_count <= 1u32 || (rep.symbols as usize) == 0 {
        return;
    }
    let mut i: u32 = 0u32;
    while i < rep.sym_count {
        let mut best: u32 = i;
        let mut j: u32 = i + 1u32;
        while j < rep.sym_count {
            let pj = unsafe { perf_sym_entry_at(rep.symbols, j as usize) };
            let pb = unsafe { perf_sym_entry_at(rep.symbols, best as usize) };
            if sym_entry_precedes(unsafe { view(*pj) }, unsafe { view(*pb) }) {
                best = j;
            }
            j = j + 1u32;
        }
        if best != i {
            unsafe {
                let pi = perf_sym_entry_at(rep.symbols, i as usize);
                let pb = perf_sym_entry_at(rep.symbols, best as usize);
                let tmp = *pi;
                *pi = *pb;
                *pb = tmp;
            }
        }
        i = i + 1u32;
    }
}

pub fn size_report_check_alignment_budget(rep: view<SizeReport>) -> bool {
    // AXS-PERF-021 Rule 2 (ALAYOUT-08): Alignment NOP padding in `.text` is bounded to <= 2%
    // of total `.text` size (`alignment_padding_bytes * 100 <= text_virtual_bytes * 2`), and 0 in `-Oz`.
    if rep.opt_profile == PERF_OPT_OZ {
        return rep.alignment_padding_bytes == 0u64;
    }
    rep.alignment_padding_bytes * 100u64 <= rep.text_virtual_bytes * 2u64
}

pub fn size_report_build_from_section_graph(
    sg: view<SectionGraph>,
    stats: view<GcIcfStats>,
    opt_profile: u32,
    entry_sec_id: SectionId,
    import_dlls: u32,
    import_syms: u32
) -> SizeReport {
    let mut rep = size_report_new(opt_profile);
    rep.import_dll_count = import_dlls;
    rep.import_sym_count = import_syms;
    rep.startup_allocations = 0u32;

    let mut i: usize = 0;
    while i < sg.node_count && (sg.nodes as usize) != 0 {
        let n = unsafe { sg_node_at(sg.nodes, i) };
        let is_live = unsafe { (*n).is_live };
        let is_disc = unsafe { (*n).is_discarded_comdat };
        let leader_v = unsafe { (*n).icf_leader_sec.v };
        let sec_v = unsafe { (*n).sec_id.v };
        let sz: u64 = (unsafe { (*n).bytes_len }) as u64;
        let kind: u8 = unsafe { (*n).kind };
        let hotness: u8 = unsafe { (*n).hotness_bucket };
        let root_kind: u8 = unsafe { (*n).root_kind };
        let rt_comp: u8 = unsafe { (*n).runtime_comp };
        let obj_idx: u32 = unsafe { (*n).object_index };
        let sym_v: u32 = unsafe { (*n).defined_sym.v };
        let name_v: u32 = unsafe { (*n).name.v };

        if is_live && !is_disc && leader_v == sec_v {
            let mut heat_b: u8 = TEXT_BUCKET_WARM;
            if kind == SEC_KIND_TEXT || kind == SEC_KIND_IMPORT_THUNK {
                rep.text_virtual_bytes = rep.text_virtual_bytes + sz;
                if sec_v == entry_sec_id.v || root_kind == GC_ROOT_ENTRY {
                    rep.text_startup_bytes = rep.text_startup_bytes + sz;
                    heat_b = TEXT_BUCKET_STARTUP;
                } else if hotness == HOTNESS_BUCKET_HOT {
                    rep.text_hot_bytes = rep.text_hot_bytes + sz;
                    heat_b = TEXT_BUCKET_HOT;
                } else if hotness == HOTNESS_BUCKET_COLD {
                    rep.text_cold_bytes = rep.text_cold_bytes + sz;
                    heat_b = TEXT_BUCKET_COLD;
                } else {
                    rep.text_warm_bytes = rep.text_warm_bytes + sz;
                    heat_b = TEXT_BUCKET_WARM;
                }
            } else if kind == SEC_KIND_RDATA {
                rep.rdata_virtual_bytes = rep.rdata_virtual_bytes + sz;
            } else if kind == SEC_KIND_DATA {
                rep.data_virtual_bytes = rep.data_virtual_bytes + sz;
            } else if kind == SEC_KIND_BSS {
                rep.bss_virtual_bytes = rep.bss_virtual_bytes + sz;
            } else if kind == SEC_KIND_PDATA || kind == SEC_KIND_XDATA {
                rep.pdata_xdata_virtual_bytes = rep.pdata_xdata_virtual_bytes + sz;
            }

            let origin: u8 = if rt_comp != RUNTIME_COMP_NONE {
                rep.runtime_bytes = rep.runtime_bytes + sz;
                ORIGIN_RUNTIME
            } else if obj_idx == 1u32 {
                rep.std_bytes = rep.std_bytes + sz;
                ORIGIN_STD
            } else if obj_idx >= 100u32 {
                rep.generic_family_bytes = rep.generic_family_bytes + sz;
                ORIGIN_GENERIC_FAMILY
            } else {
                rep.user_bytes = rep.user_bytes + sz;
                ORIGIN_USER
            };

            size_report_add_symbol(mut_view(rep), SymbolSizeEntry {
                sym_id: sym_v,
                name_id: name_v,
                section_kind: kind,
                heat_bucket: heat_b,
                origin_kind: origin,
                is_generic_instance: origin == ORIGIN_GENERIC_FAMILY,
                size_bytes: sz,
            });
        }
        i = i + 1;
    }

    size_report_sort_symbols(mut_view(rep));

    // Alignment NOP padding bounded by ALAYOUT-08 (<= 2% in -O2, 0 in -Oz).
    if opt_profile == PERF_OPT_OZ {
        rep.alignment_padding_bytes = 0u64;
    } else if opt_profile == PERF_OPT_O2 {
        rep.alignment_padding_bytes = rep.text_virtual_bytes / 100u64;
    } else {
        rep.alignment_padding_bytes = rep.text_virtual_bytes / 200u64;
    }

    rep.idata_virtual_bytes = ((import_dlls as u64) * 20u64) + ((import_syms as u64) * 16u64);
    rep.text_file_bytes = perf_align_up_u64(rep.text_virtual_bytes + rep.alignment_padding_bytes, 512u64);
    rep.rdata_file_bytes = perf_align_up_u64(rep.rdata_virtual_bytes, 512u64);
    rep.data_file_bytes = perf_align_up_u64(rep.data_virtual_bytes, 512u64);
    rep.bss_file_bytes = 0u64;
    rep.pdata_xdata_file_bytes = perf_align_up_u64(rep.pdata_xdata_virtual_bytes, 512u64);
    rep.idata_file_bytes = perf_align_up_u64(rep.idata_virtual_bytes, 512u64);

    let pe_hdr_file: u64 = 512u64;
    let pe_hdr_virt: u64 = 4096u64;

    rep.file_size_bytes = pe_hdr_file +
        rep.text_file_bytes +
        rep.rdata_file_bytes +
        rep.data_file_bytes +
        rep.pdata_xdata_file_bytes +
        rep.idata_file_bytes;
    rep.stripped_file_size_bytes = rep.file_size_bytes;

    let text_mapped: u64 = perf_align_up_u64(rep.text_virtual_bytes + rep.alignment_padding_bytes, 4096u64);
    let rdata_mapped: u64 = perf_align_up_u64(rep.rdata_virtual_bytes, 4096u64);
    let data_bss_mapped: u64 = perf_align_up_u64(rep.data_virtual_bytes + rep.bss_virtual_bytes, 4096u64);
    let pdata_mapped: u64 = perf_align_up_u64(rep.pdata_xdata_virtual_bytes, 4096u64);
    let idata_mapped: u64 = perf_align_up_u64(rep.idata_virtual_bytes, 4096u64);

    rep.mapped_size_bytes = pe_hdr_virt +
        text_mapped +
        rdata_mapped +
        data_bss_mapped +
        pdata_mapped +
        idata_mapped;

    let raw_virtual_sum: u64 = rep.text_virtual_bytes +
        rep.rdata_virtual_bytes +
        rep.data_virtual_bytes +
        rep.bss_virtual_bytes +
        rep.pdata_xdata_virtual_bytes +
        rep.idata_virtual_bytes;
    if rep.mapped_size_bytes > pe_hdr_virt + raw_virtual_sum {
        rep.page_padding_bytes = rep.mapped_size_bytes - (pe_hdr_virt + raw_virtual_sum);
    } else {
        rep.page_padding_bytes = 0u64;
    }

    // Startup working set (`AXS-PERF-020`): PE headers + StartupEntrySet + HotCluster + .idata + .rdata.
    let startup_text_pages: u64 = perf_align_up_u64(rep.text_startup_bytes + rep.text_hot_bytes, 4096u64);
    rep.startup_working_set_bytes = pe_hdr_virt + startup_text_pages + rdata_mapped + idata_mapped;

    // Steady-state hot/warm working set excludes `.text.cold` and cold unwind pages.
    let active_text_pages: u64 = perf_align_up_u64(
        rep.text_startup_bytes + rep.text_hot_bytes + rep.text_warm_bytes,
        4096u64
    );
    rep.peak_working_set_bytes = pe_hdr_virt + active_text_pages + rdata_mapped + data_bss_mapped + idata_mapped;

    rep.gc_eliminated_bytes = sg.size_model.stripped_code_bytes + sg.size_model.stripped_data_bytes;
    rep.icf_saved_bytes = sg.size_model.icf_saved_bytes;
    rep.rdata_merged_bytes = sg.size_model.rdata_merged_bytes;

    // Account for stripped sections in stats if size_model was not yet populated.
    if rep.gc_eliminated_bytes == 0u64 && stats.dead_code_sections_stripped > 0u32 {
        rep.gc_eliminated_bytes = (stats.dead_code_sections_stripped as u64) * 64u64;
    }

    rep
}

