    } else if pass_id == PASS_TIMING_MEM2REG {
        perf_push_str(out, OFF_PASS_MEM2REG, LEN_PASS_MEM2REG);
    } else if pass_id == PASS_TIMING_INLINE {
        perf_push_str(out, OFF_PASS_INLINE, LEN_PASS_INLINE);
    } else if pass_id == PASS_TIMING_DEVIRT {
        perf_push_str(out, OFF_PASS_DEVIRT, LEN_PASS_DEVIRT);
