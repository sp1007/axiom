fn json_push_quoted(out: mut_view<DiagBuffer>, off: usize, len: usize) {
    diag_buf_push_byte(mut_view(*out), 34u8);
    perf_push_str(mut_view(*out), off, len);
    diag_buf_push_byte(out, 34u8);
}

fn json_push_key(out: mut_view<DiagBuffer>, comma: bool, off: usize, len: usize) {
    if comma {
        diag_buf_push_byte(mut_view(*out), 44u8);
    }
    json_push_quoted(mut_view(*out), off, len);
    diag_buf_push_byte(out, 58u8);
}

fn json_push_key_u64(out: mut_view<DiagBuffer>, comma: bool, off: usize, len: usize, val: u64) {
    json_push_key(mut_view(*out), comma, off, len);
    perf_push_u64(out, val);
}

fn json_push_key_str(
    out: mut_view<DiagBuffer>,
    comma: bool,
    k_off: usize,
    k_len: usize,
    v_off: usize,
    v_len: usize
) {
    json_push_key(mut_view(*out), comma, k_off, k_len);
    json_push_quoted(out, v_off, v_len);
}

pub fn time_passes_format_human(rep: view<TimePassesReport>, out: mut_view<DiagBuffer>) {
    let mut i: u32 = 0u32;
    while i < rep.record_count && (rep.records as usize) != 0 {
        let rp = unsafe { perf_timing_rec_at(rep.records, i as usize) };
        let pid = unsafe { (*rp).pass_id };
        let el = unsafe { (*rp).elapsed_us };
        let bef = unsafe { (*rp).insts_before };
        let aft = unsafe { (*rp).insts_after };
        let xfm = unsafe { (*rp).transforms_applied };
        let mem = unsafe { (*rp).peak_arena_bytes };

        perf_push_str(mut_view(*out), OFF_H_TIME_PREFIX, LEN_H_TIME_PREFIX);
        perf_push_pass_name(mut_view(*out), pid);
        diag_buf_push_byte(mut_view(*out), 32u8);
        perf_push_sec_frac6(mut_view(*out), el);
        perf_push_str(mut_view(*out), OFF_H_US_OPEN, LEN_H_US_OPEN);
        perf_push_u64(mut_view(*out), el);
        perf_push_str(mut_view(*out), OFF_H_US_INSTS, LEN_H_US_INSTS);
        diag_buf_push_u32(mut_view(*out), bef);
        perf_push_str(mut_view(*out), OFF_H_ARROW, LEN_H_ARROW);
        diag_buf_push_u32(mut_view(*out), aft);
        perf_push_str(mut_view(*out), OFF_H_XFORMS, LEN_H_XFORMS);
        diag_buf_push_u32(mut_view(*out), xfm);
        perf_push_str(mut_view(*out), OFF_H_ARENA, LEN_H_ARENA);
        perf_push_u64(mut_view(*out), mem);
        perf_push_str(mut_view(*out), OFF_H_B_CLOSE, LEN_H_B_CLOSE);
        i = i + 1u32;
    }

    let det_digest = time_passes_deterministic_digest(view(*rep));
    perf_push_str(mut_view(*out), OFF_H_TOTAL_PREFIX, LEN_H_TOTAL_PREFIX);
    perf_push_sec_frac6(mut_view(*out), rep.total_elapsed_us);
    perf_push_str(mut_view(*out), OFF_H_US_OPEN, LEN_H_US_OPEN);
    perf_push_u64(mut_view(*out), rep.total_elapsed_us);
    perf_push_str(mut_view(*out), OFF_H_PEAK_MEM, LEN_H_PEAK_MEM);
    perf_push_u64(mut_view(*out), rep.peak_arena_bytes);
    perf_push_str(mut_view(*out), OFF_H_DET_DIGEST, LEN_H_DET_DIGEST);
    perf_push_u64(mut_view(*out), det_digest);
    diag_buf_push_byte(out, 10u8);
}

pub fn time_passes_format_json(rep: view<TimePassesReport>, out: mut_view<DiagBuffer>) {
    let det_digest = time_passes_deterministic_digest(view(*rep));
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_SCHEMA, LEN_K_SCHEMA, 1u64);
    json_push_key_str(mut_view(*out), true, OFF_K_KIND, LEN_K_KIND, OFF_K_TIME_PASSES, LEN_K_TIME_PASSES);

    json_push_key(mut_view(*out), true, OFF_K_OPT_PROFILE, LEN_K_OPT_PROFILE);
    diag_buf_push_byte(mut_view(*out), 34u8);
    perf_push_profile_name(mut_view(*out), rep.opt_profile);
    diag_buf_push_byte(mut_view(*out), 34u8);

    json_push_key_str(mut_view(*out), true, OFF_K_TARGET, LEN_K_TARGET, OFF_V_TARGET_X64, LEN_V_TARGET_X64);
    json_push_key_u64(mut_view(*out), true, OFF_K_TOTAL_ELAPSED_US, LEN_K_TOTAL_ELAPSED_US, rep.total_elapsed_us);
    json_push_key_u64(mut_view(*out), true, OFF_K_PEAK_ARENA_BYTES, LEN_K_PEAK_ARENA_BYTES, rep.peak_arena_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_DET_DIGEST, LEN_K_DET_DIGEST, det_digest);

    // Emit stages array
    json_push_key(mut_view(*out), true, OFF_K_STAGES, LEN_K_STAGES);
    diag_buf_push_byte(mut_view(*out), 91u8);
    let mut first_stg: bool = true;
    let mut i: u32 = 0u32;
    while i < rep.record_count && (rep.records as usize) != 0 {
        let rp = unsafe { perf_timing_rec_at(rep.records, i as usize) };
        let is_opt = unsafe { (*rp).is_opt_pass };
        if !is_opt {
            if !first_stg {
                diag_buf_push_byte(mut_view(*out), 44u8);
            }
            first_stg = false;
            diag_buf_push_byte(mut_view(*out), 123u8);
            json_push_key(mut_view(*out), false, OFF_K_NAME, LEN_K_NAME);
            diag_buf_push_byte(mut_view(*out), 34u8);
            perf_push_pass_name(mut_view(*out), unsafe { (*rp).pass_id });
            diag_buf_push_byte(mut_view(*out), 34u8);
            json_push_key_u64(mut_view(*out), true, OFF_K_ELAPSED_US, LEN_K_ELAPSED_US, unsafe { (*rp).elapsed_us });
            json_push_key_u64(mut_view(*out), true, OFF_K_PEAK_ARENA_BYTES, LEN_K_PEAK_ARENA_BYTES, unsafe { (*rp).peak_arena_bytes });
            json_push_key_u64(mut_view(*out), true, OFF_K_IR_BLOCKS, LEN_K_IR_BLOCKS, (unsafe { (*rp).ir_blocks }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_INSTS_BEFORE, LEN_K_INSTS_BEFORE, (unsafe { (*rp).insts_before }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_INSTS_AFTER, LEN_K_INSTS_AFTER, (unsafe { (*rp).insts_after }) as u64);
            diag_buf_push_byte(mut_view(*out), 125u8);
        }
        i = i + 1u32;
    }
    diag_buf_push_byte(mut_view(*out), 93u8);

    // Emit opt_passes array
    json_push_key(mut_view(*out), true, OFF_K_OPT_PASSES, LEN_K_OPT_PASSES);
    diag_buf_push_byte(mut_view(*out), 91u8);
    let mut first_opt: bool = true;
    let mut j: u32 = 0u32;
    while j < rep.record_count && (rep.records as usize) != 0 {
        let rp = unsafe { perf_timing_rec_at(rep.records, j as usize) };
        let is_opt = unsafe { (*rp).is_opt_pass };
        if is_opt {
            if !first_opt {
                diag_buf_push_byte(mut_view(*out), 44u8);
            }
            first_opt = false;
            diag_buf_push_byte(mut_view(*out), 123u8);
            json_push_key(mut_view(*out), false, OFF_K_NAME, LEN_K_NAME);
            diag_buf_push_byte(mut_view(*out), 34u8);
            perf_push_pass_name(mut_view(*out), unsafe { (*rp).pass_id });
            diag_buf_push_byte(mut_view(*out), 34u8);
            json_push_key_u64(mut_view(*out), true, OFF_K_ELAPSED_US, LEN_K_ELAPSED_US, unsafe { (*rp).elapsed_us });
            json_push_key_u64(mut_view(*out), true, OFF_K_INSTS_BEFORE, LEN_K_INSTS_BEFORE, (unsafe { (*rp).insts_before }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_INSTS_AFTER, LEN_K_INSTS_AFTER, (unsafe { (*rp).insts_after }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_TRANSFORMS, LEN_K_TRANSFORMS, (unsafe { (*rp).transforms_applied }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_BCE_ELIM, LEN_K_BCE_ELIM, (unsafe { (*rp).bce_eliminated }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_LOOPS_VEC, LEN_K_LOOPS_VEC, (unsafe { (*rp).loops_vectorized }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_SPILLS, LEN_K_SPILLS, (unsafe { (*rp).spills_inserted }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_SEC_TOTAL, LEN_K_SEC_TOTAL, (unsafe { (*rp).sections_total }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_SEC_GC, LEN_K_SEC_GC, (unsafe { (*rp).sections_gc_removed }) as u64);
            json_push_key_u64(mut_view(*out), true, OFF_K_ICF_FOLDED, LEN_K_ICF_FOLDED, (unsafe { (*rp).icf_folded }) as u64);
            diag_buf_push_byte(mut_view(*out), 125u8);
        }
        j = j + 1u32;
    }
    diag_buf_push_byte(mut_view(*out), 93u8);
    diag_buf_push_byte(mut_view(*out), 125u8);
    diag_buf_push_byte(out, 10u8);
}

pub fn size_report_format_human(rep: view<SizeReport>, out: mut_view<DiagBuffer>) {
    perf_push_str(mut_view(*out), OFF_H_SR_HEAD, LEN_H_SR_HEAD);
    perf_push_profile_name(mut_view(*out), rep.opt_profile);
    perf_push_str(mut_view(*out), OFF_H_SR_FILE, LEN_H_SR_FILE);
    perf_push_u64(mut_view(*out), rep.file_size_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_STRIP, LEN_H_SR_STRIP);
    perf_push_u64(mut_view(*out), rep.stripped_file_size_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_MAP, LEN_H_SR_MAP);
    perf_push_u64(mut_view(*out), rep.mapped_size_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_START_WS, LEN_H_SR_START_WS);
    perf_push_u64(mut_view(*out), rep.startup_working_set_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_PEAK_WS, LEN_H_SR_PEAK_WS);
    perf_push_u64(mut_view(*out), rep.peak_working_set_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_ALIGN_PAD, LEN_H_SR_ALIGN_PAD);
    perf_push_u64(mut_view(*out), rep.alignment_padding_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_PAGE_PAD, LEN_H_SR_PAGE_PAD);
    perf_push_u64(mut_view(*out), rep.page_padding_bytes);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // .text
    perf_push_str(mut_view(*out), OFF_H_SR_SEC, LEN_H_SR_SEC);
    perf_push_str(mut_view(*out), OFF_SEC_TEXT, LEN_SEC_TEXT);
    perf_push_str(mut_view(*out), OFF_H_SR_FILE, LEN_H_SR_FILE);
    perf_push_u64(mut_view(*out), rep.text_file_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_VIRT, LEN_H_SR_VIRT);
    perf_push_u64(mut_view(*out), rep.text_virtual_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_STARTUP, LEN_H_SR_STARTUP);
    perf_push_u64(mut_view(*out), rep.text_startup_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_HOT, LEN_H_SR_HOT);
    perf_push_u64(mut_view(*out), rep.text_hot_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_WARM, LEN_H_SR_WARM);
    perf_push_u64(mut_view(*out), rep.text_warm_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_COLD, LEN_H_SR_COLD);
    perf_push_u64(mut_view(*out), rep.text_cold_bytes);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // .rdata
    perf_push_str(mut_view(*out), OFF_H_SR_SEC, LEN_H_SR_SEC);
    perf_push_str(mut_view(*out), OFF_SEC_RDATA, LEN_SEC_RDATA);
    perf_push_str(mut_view(*out), OFF_H_SR_FILE, LEN_H_SR_FILE);
    perf_push_u64(mut_view(*out), rep.rdata_file_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_VIRT, LEN_H_SR_VIRT);
    perf_push_u64(mut_view(*out), rep.rdata_virtual_bytes);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // .data
    perf_push_str(mut_view(*out), OFF_H_SR_SEC, LEN_H_SR_SEC);
    perf_push_str(mut_view(*out), OFF_SEC_DATA, LEN_SEC_DATA);
    perf_push_str(mut_view(*out), OFF_H_SR_FILE, LEN_H_SR_FILE);
    perf_push_u64(mut_view(*out), rep.data_file_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_VIRT, LEN_H_SR_VIRT);
    perf_push_u64(mut_view(*out), rep.data_virtual_bytes);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // .bss
    perf_push_str(mut_view(*out), OFF_H_SR_SEC, LEN_H_SR_SEC);
    perf_push_str(mut_view(*out), OFF_SEC_BSS, LEN_SEC_BSS);
    perf_push_str(mut_view(*out), OFF_H_SR_FILE, LEN_H_SR_FILE);
    perf_push_u64(mut_view(*out), rep.bss_file_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_VIRT, LEN_H_SR_VIRT);
    perf_push_u64(mut_view(*out), rep.bss_virtual_bytes);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // .pdata_xdata
    perf_push_str(mut_view(*out), OFF_H_SR_SEC, LEN_H_SR_SEC);
    perf_push_str(mut_view(*out), OFF_SEC_PDATA_XDATA, LEN_SEC_PDATA_XDATA);
    perf_push_str(mut_view(*out), OFF_H_SR_FILE, LEN_H_SR_FILE);
    perf_push_u64(mut_view(*out), rep.pdata_xdata_file_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_VIRT, LEN_H_SR_VIRT);
    perf_push_u64(mut_view(*out), rep.pdata_xdata_virtual_bytes);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // .idata
    perf_push_str(mut_view(*out), OFF_H_SR_SEC, LEN_H_SR_SEC);
    perf_push_str(mut_view(*out), OFF_SEC_IDATA, LEN_SEC_IDATA);
    perf_push_str(mut_view(*out), OFF_H_SR_FILE, LEN_H_SR_FILE);
    perf_push_u64(mut_view(*out), rep.idata_file_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_VIRT, LEN_H_SR_VIRT);
    perf_push_u64(mut_view(*out), rep.idata_virtual_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_DLLS, LEN_H_SR_DLLS);
    diag_buf_push_u32(mut_view(*out), rep.import_dll_count);
    perf_push_str(mut_view(*out), OFF_H_SR_SYMS, LEN_H_SR_SYMS);
    diag_buf_push_u32(mut_view(*out), rep.import_sym_count);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // Attribution
    perf_push_str(mut_view(*out), OFF_H_SR_ATTR, LEN_H_SR_ATTR);
    perf_push_u64(mut_view(*out), rep.runtime_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_STD, LEN_H_SR_STD);
    perf_push_u64(mut_view(*out), rep.std_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_USER, LEN_H_SR_USER);
    perf_push_u64(mut_view(*out), rep.user_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_GEN, LEN_H_SR_GEN);
    perf_push_u64(mut_view(*out), rep.generic_family_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_GC, LEN_H_SR_GC);
    perf_push_u64(mut_view(*out), rep.gc_eliminated_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_ICF, LEN_H_SR_ICF);
    perf_push_u64(mut_view(*out), rep.icf_saved_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_RMERG, LEN_H_SR_RMERG);
    perf_push_u64(mut_view(*out), rep.rdata_merged_bytes);
    perf_push_str(mut_view(*out), OFF_H_SR_SALLOC, LEN_H_SR_SALLOC);
    diag_buf_push_u32(mut_view(*out), rep.startup_allocations);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // Symbols
    let mut i: u32 = 0u32;
    while i < rep.sym_count && (rep.symbols as usize) != 0 {
        let sp = unsafe { perf_sym_entry_at(rep.symbols, i as usize) };
        perf_push_str(mut_view(*out), OFF_H_SR_SYM, LEN_H_SR_SYM);
        diag_buf_push_u32(mut_view(*out), unsafe { (*sp).sym_id });
        perf_push_str(mut_view(*out), OFF_H_SR_NAME, LEN_H_SR_NAME);
        diag_buf_push_u32(mut_view(*out), unsafe { (*sp).name_id });
        perf_push_str(mut_view(*out), OFF_H_SR_SSEC, LEN_H_SR_SSEC);
        perf_push_sec_kind_name(mut_view(*out), unsafe { (*sp).section_kind });
        perf_push_str(mut_view(*out), OFF_H_SR_SHEAT, LEN_H_SR_SHEAT);
        perf_push_heat_name(mut_view(*out), unsafe { (*sp).heat_bucket });
        perf_push_str(mut_view(*out), OFF_H_SR_SORIG, LEN_H_SR_SORIG);
        perf_push_origin_name(mut_view(*out), unsafe { (*sp).origin_kind });
        perf_push_str(mut_view(*out), OFF_H_SR_SBYTES, LEN_H_SR_SBYTES);
        perf_push_u64(mut_view(*out), unsafe { (*sp).size_bytes });
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1u32;
    }
}

pub fn size_report_format_json(rep: view<SizeReport>, out: mut_view<DiagBuffer>) {
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_SCHEMA, LEN_K_SCHEMA, 1u64);
    json_push_key_str(mut_view(*out), true, OFF_K_KIND, LEN_K_KIND, OFF_K_SIZE_REPORT, LEN_K_SIZE_REPORT);

    json_push_key(mut_view(*out), true, OFF_K_OPT_PROFILE, LEN_K_OPT_PROFILE);
    diag_buf_push_byte(mut_view(*out), 34u8);
    perf_push_profile_name(mut_view(*out), rep.opt_profile);
    diag_buf_push_byte(mut_view(*out), 34u8);

    json_push_key_str(mut_view(*out), true, OFF_K_TARGET, LEN_K_TARGET, OFF_V_TARGET_X64, LEN_V_TARGET_X64);

    // binary_3d object
    json_push_key(mut_view(*out), true, OFF_K_BINARY_3D, LEN_K_BINARY_3D);
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_FILE_SZ, LEN_K_FILE_SZ, rep.file_size_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_STRIP_SZ, LEN_K_STRIP_SZ, rep.stripped_file_size_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_MAP_SZ, LEN_K_MAP_SZ, rep.mapped_size_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_START_WS, LEN_K_START_WS, rep.startup_working_set_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_PEAK_WS, LEN_K_PEAK_WS, rep.peak_working_set_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_ALIGN_PAD, LEN_K_ALIGN_PAD, rep.alignment_padding_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_PAGE_PAD, LEN_K_PAGE_PAD, rep.page_padding_bytes);
    diag_buf_push_byte(mut_view(*out), 125u8);

    // sections object
    json_push_key(mut_view(*out), true, OFF_K_SECTIONS, LEN_K_SECTIONS);
    diag_buf_push_byte(mut_view(*out), 123u8);

    // .text
    json_push_key(mut_view(*out), false, OFF_SEC_TEXT, LEN_SEC_TEXT);
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_FILE_BYTES, LEN_K_FILE_BYTES, rep.text_file_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_VIRT_BYTES, LEN_K_VIRT_BYTES, rep.text_virtual_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_STARTUP_BYTES, LEN_K_STARTUP_BYTES, rep.text_startup_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_HOT_BYTES, LEN_K_HOT_BYTES, rep.text_hot_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_WARM_BYTES, LEN_K_WARM_BYTES, rep.text_warm_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_COLD_BYTES, LEN_K_COLD_BYTES, rep.text_cold_bytes);
    diag_buf_push_byte(mut_view(*out), 125u8);

    // .rdata
    json_push_key(mut_view(*out), true, OFF_SEC_RDATA, LEN_SEC_RDATA);
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_FILE_BYTES, LEN_K_FILE_BYTES, rep.rdata_file_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_VIRT_BYTES, LEN_K_VIRT_BYTES, rep.rdata_virtual_bytes);
    diag_buf_push_byte(mut_view(*out), 125u8);

    // .data
    json_push_key(mut_view(*out), true, OFF_SEC_DATA, LEN_SEC_DATA);
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_FILE_BYTES, LEN_K_FILE_BYTES, rep.data_file_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_VIRT_BYTES, LEN_K_VIRT_BYTES, rep.data_virtual_bytes);
    diag_buf_push_byte(mut_view(*out), 125u8);

    // .bss
    json_push_key(mut_view(*out), true, OFF_SEC_BSS, LEN_SEC_BSS);
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_FILE_BYTES, LEN_K_FILE_BYTES, rep.bss_file_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_VIRT_BYTES, LEN_K_VIRT_BYTES, rep.bss_virtual_bytes);
    diag_buf_push_byte(mut_view(*out), 125u8);

    // .pdata_xdata
    json_push_key(mut_view(*out), true, OFF_SEC_PDATA_XDATA, LEN_SEC_PDATA_XDATA);
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_FILE_BYTES, LEN_K_FILE_BYTES, rep.pdata_xdata_file_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_VIRT_BYTES, LEN_K_VIRT_BYTES, rep.pdata_xdata_virtual_bytes);
    diag_buf_push_byte(mut_view(*out), 125u8);

    // .idata
    json_push_key(mut_view(*out), true, OFF_SEC_IDATA, LEN_SEC_IDATA);
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_FILE_BYTES, LEN_K_FILE_BYTES, rep.idata_file_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_VIRT_BYTES, LEN_K_VIRT_BYTES, rep.idata_virtual_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_DLL_CNT, LEN_K_DLL_CNT, rep.import_dll_count as u64);
    json_push_key_u64(mut_view(*out), true, OFF_K_ISYM_CNT, LEN_K_ISYM_CNT, rep.import_sym_count as u64);
    diag_buf_push_byte(mut_view(*out), 125u8);

    diag_buf_push_byte(mut_view(*out), 125u8);

    // attribution object
    json_push_key(mut_view(*out), true, OFF_K_ATTRIBUTION, LEN_K_ATTRIBUTION);
    diag_buf_push_byte(mut_view(*out), 123u8);
    json_push_key_u64(mut_view(*out), false, OFF_K_RUNTIME_BYTES, LEN_K_RUNTIME_BYTES, rep.runtime_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_STD_BYTES, LEN_K_STD_BYTES, rep.std_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_USER_BYTES, LEN_K_USER_BYTES, rep.user_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_GEN_BYTES, LEN_K_GEN_BYTES, rep.generic_family_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_GC_ELIM_BYTES, LEN_K_GC_ELIM_BYTES, rep.gc_eliminated_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_ICF_SAVED_BYTES, LEN_K_ICF_SAVED_BYTES, rep.icf_saved_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_RDATA_MERG_BYTES, LEN_K_RDATA_MERG_BYTES, rep.rdata_merged_bytes);
    json_push_key_u64(mut_view(*out), true, OFF_K_START_ALLOCS, LEN_K_START_ALLOCS, rep.startup_allocations as u64);
    diag_buf_push_byte(mut_view(*out), 125u8);

    // symbols array
    json_push_key(mut_view(*out), true, OFF_K_SYMBOLS, LEN_K_SYMBOLS);
    diag_buf_push_byte(mut_view(*out), 91u8);
    let mut i: u32 = 0u32;
    while i < rep.sym_count && (rep.symbols as usize) != 0 {
        if i > 0u32 {
            diag_buf_push_byte(mut_view(*out), 44u8);
        }
        let sp = unsafe { perf_sym_entry_at(rep.symbols, i as usize) };
        diag_buf_push_byte(mut_view(*out), 123u8);
        json_push_key_u64(mut_view(*out), false, OFF_K_SYM_ID, LEN_K_SYM_ID, (unsafe { (*sp).sym_id }) as u64);
        json_push_key_u64(mut_view(*out), true, OFF_K_NAME_ID, LEN_K_NAME_ID, (unsafe { (*sp).name_id }) as u64);

        json_push_key(mut_view(*out), true, OFF_K_SECTION, LEN_K_SECTION);
        diag_buf_push_byte(mut_view(*out), 34u8);
        perf_push_sec_kind_name(mut_view(*out), unsafe { (*sp).section_kind });
        diag_buf_push_byte(mut_view(*out), 34u8);

        json_push_key(mut_view(*out), true, OFF_K_HEAT, LEN_K_HEAT);
        diag_buf_push_byte(mut_view(*out), 34u8);
        perf_push_heat_name(mut_view(*out), unsafe { (*sp).heat_bucket });
        diag_buf_push_byte(mut_view(*out), 34u8);

        json_push_key(mut_view(*out), true, OFF_K_ORIGIN, LEN_K_ORIGIN);
        diag_buf_push_byte(mut_view(*out), 34u8);
        perf_push_origin_name(mut_view(*out), unsafe { (*sp).origin_kind });
        diag_buf_push_byte(mut_view(*out), 34u8);

        json_push_key_u64(mut_view(*out), true, OFF_K_SIZE_BYTES, LEN_K_SIZE_BYTES, unsafe { (*sp).size_bytes });
        diag_buf_push_byte(mut_view(*out), 125u8);
        i = i + 1u32;
    }
    diag_buf_push_byte(mut_view(*out), 93u8);
    diag_buf_push_byte(mut_view(*out), 125u8);
    diag_buf_push_byte(out, 10u8);
}
