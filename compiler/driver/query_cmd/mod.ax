// Implements SPEC-103 §§4..7 (AXS-AI-001..021, AXS-DIAG-050;
// REQ-TOOL-004, REQ-TOOL-180..182, REQ-TOOL-185..187, REQ-TOOL-190, INV-DIAG-010).
module compiler.driver.query_cmd

