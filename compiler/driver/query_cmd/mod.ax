use compiler.diag.ux2.ux2_sv_eq

use std.meta_effects.container_contract_empty
use std.meta_effects.meta_lookup_container_contract
use std.meta_effects.api_effect_summary_empty
use std.meta_effects.meta_lookup_api_effect

use compiler.ai_query.TypeLayoutFact
use compiler.ai_query.ai_meta_from_sv
use compiler.ai_query.type_layout_fact_empty
use compiler.ai_query.ai_inspect_type_layout
