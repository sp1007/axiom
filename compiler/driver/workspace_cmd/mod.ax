use compiler.build.manifest.TARGET_UNIT_BENCH
use compiler.build.manifest.TARGET_UNIT_BUILD_TOOL
use compiler.build.manifest.AX_DRIVER_INVALID_PROFILE
use compiler.build.manifest.bld_sv_byte
use compiler.build.manifest.bld_sv_slice
use compiler.build.manifest.bld_sv_starts_with
use compiler.build.manifest.dep_scope_name
use compiler.build.manifest.target_unit_kind_name
