@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// =============================================================================
// 1. Subcommand Constants & CLI Exit Discipline (`AXS-PKG-040`)
// =============================================================================

pub const PKG_CMD_NONE: u8 = 0u8
pub const PKG_CMD_INIT: u8 = 1u8
pub const PKG_CMD_ADD: u8 = 2u8
pub const PKG_CMD_REMOVE: u8 = 3u8
pub const PKG_CMD_UPDATE: u8 = 4u8
pub const PKG_CMD_LOCK: u8 = 5u8
pub const PKG_CMD_TREE: u8 = 6u8
pub const PKG_CMD_VERIFY_LOCK: u8 = 7u8
pub const PKG_CMD_VENDOR: u8 = 8u8

pub const PKG_EXIT_OK: i32 = 0i32
pub const PKG_EXIT_DIAG_ERROR: i32 = 1i32
pub const PKG_EXIT_USAGE_ERROR: i32 = 2i32

pub const TREE_FMT_TEXT: u8 = 0u8
pub const TREE_FMT_JSON: u8 = 1u8

pub fn pkg_subcommand_name(cmd: u8) -> StrView {
    if cmd == PKG_CMD_INIT { return ux2_sv("init") }
    if cmd == PKG_CMD_ADD { return ux2_sv("add") }
    if cmd == PKG_CMD_REMOVE { return ux2_sv("remove") }
    if cmd == PKG_CMD_UPDATE { return ux2_sv("update") }
    if cmd == PKG_CMD_LOCK { return ux2_sv("lock") }
    if cmd == PKG_CMD_TREE { return ux2_sv("tree") }
    if cmd == PKG_CMD_VERIFY_LOCK { return ux2_sv("verify-lock") }
    if cmd == PKG_CMD_VENDOR { return ux2_sv("vendor") }
    ux2_sv("none")
}

// =============================================================================
// 2. Structured Diagnostic Helpers (`AXS-PKG-050`)
// =============================================================================

fn make_sv_entry(key: StrView, val: StrView) -> DiagDataEntry {
    DiagDataEntry {
        key: key,
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: val,
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0usize,
        },
    }
}

pub fn report_pkg_usage_error(
    sink: mut_view<DiagSink>,
    msg: str,
    opt_name: StrView
) {
    let mut d = diag_new(diag_code(AX_DRIVER_USAGE), span_none(), ux2_sv(msg))
    let mut entries: [2]DiagDataEntry = [
        make_sv_entry(ux2_sv("kind"), ux2_sv("usage")),
        make_sv_entry(ux2_sv("option"), opt_name),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 2usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_pkg_bad_manifest_diag(
    sink: mut_view<DiagSink>,
    msg: str,
    kind_name: str,
    detail_key: str,
    detail_val: StrView
) {
    let mut d = diag_new(diag_code(AX_DRIVER_BAD_MANIFEST), span_none(), ux2_sv(msg))
    let mut entries: [2]DiagDataEntry = [
        make_sv_entry(ux2_sv("kind"), ux2_sv(kind_name)),
        make_sv_entry(ux2_sv(detail_key), detail_val),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 2usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_pkg_hash_mismatch(
    sink: mut_view<DiagSink>,
    pkg_name: StrView,
    expected_hex: StrView,
    found_hex: StrView
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        ux2_sv("package content SHA-256 digest does not match axiom.lock (`AXS-PKG-032 §2`)")
    )
    let mut entries: [4]DiagDataEntry = [
        make_sv_entry(ux2_sv("kind"), ux2_sv("hash_mismatch")),
        make_sv_entry(ux2_sv("package"), pkg_name),
        make_sv_entry(ux2_sv("expected_sha256"), expected_hex),
        make_sv_entry(ux2_sv("found_sha256"), found_hex),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 4usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_pkg_offline_missing(
    sink: mut_view<DiagSink>,
    pkg_name: StrView,
    sha256_hex: StrView
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        ux2_sv("required package missing from local cache and vendor/ under --offline (`AXS-PKG-033 §2`)")
    )
    let mut entries: [3]DiagDataEntry = [
        make_sv_entry(ux2_sv("kind"), ux2_sv("offline_missing_package")),
        make_sv_entry(ux2_sv("package"), pkg_name),
        make_sv_entry(ux2_sv("sha256"), sha256_hex),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_pkg_path_traversal(
    sink: mut_view<DiagSink>,
    entry_path: StrView
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        ux2_sv("package path contains forbidden traversal or absolute separator (`AXS-PKG-032 §3`)")
    )
    let mut entries: [2]DiagDataEntry = [
        make_sv_entry(ux2_sv("kind"), ux2_sv("path_traversal")),
        make_sv_entry(ux2_sv("entry"), entry_path),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 2usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_pkg_quota_exceeded(
    sink: mut_view<DiagSink>,
    detail: StrView
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        ux2_sv("package archive exceeds decompression quota (`AXS-PKG-032 §3`)")
    )
    let mut entries: [2]DiagDataEntry = [
        make_sv_entry(ux2_sv("kind"), ux2_sv("archive_quota_exceeded")),
        make_sv_entry(ux2_sv("detail"), detail),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 2usize
    diag_sink_report(mut_view(*sink), view(d))
}

// =============================================================================
// 3. CLI Command Options Struct (`AXS-PKG-040`)
// =============================================================================

@derive(Copy)
pub struct PkgCmdOptions {
    pub subcommand: u8,
    pub name: StrView,
    pub is_lib: bool,
    pub is_bin: bool,
    pub is_workspace: bool,
    pub spec: StrView,
    pub dep_scope: u8,
    pub features: [8]StrView,
    pub feature_count: usize,
    pub no_default_features: bool,
    pub optional: bool,
    pub is_public: bool,
    pub path: StrView,
    pub git_url: StrView,
    pub git_rev: StrView,
    pub minimal_versions: bool,
    pub dry_run: bool,
    pub check_only: bool,
    pub offline: bool,
    pub verify_store: bool,
    pub duplicates: bool,
    pub invert_pkg: StrView,
    pub tree_format: u8,
    pub vendor_dir: StrView,
    pub verify_vendor: bool,
}

pub fn pkg_cmd_options_empty() -> PkgCmdOptions {
    let e = ux2_sv_empty()
    PkgCmdOptions {
        subcommand: PKG_CMD_NONE,
        name: e,
        is_lib: false,
        is_bin: false,
        is_workspace: false,
        spec: e,
        dep_scope: DEP_SCOPE_NORMAL,
        features: [e; 8],
        feature_count: 0usize,
        no_default_features: false,
        optional: false,
        is_public: false,
        path: e,
        git_url: e,
        git_rev: e,
        minimal_versions: false,
        dry_run: false,
        check_only: false,
        offline: false,
        verify_store: false,
        duplicates: false,
        invert_pkg: e,
        tree_format: TREE_FMT_TEXT,
        vendor_dir: ux2_sv("vendor"),
        verify_vendor: false,
    }
}

// Parses string arguments into `PkgCmdOptions` (`AXS-PKG-040`)
pub fn parse_pkg_cmd_args(
    args: view<[16]StrView>,
    arg_count: usize,
    out_opts: mut_view<PkgCmdOptions>,
    sink: mut_view<DiagSink>
) -> bool {
    *out_opts = pkg_cmd_options_empty()
    if arg_count == 0usize {
        report_pkg_usage_error(mut_view(*sink), "missing `axiomc pkg` subcommand (`AXS-PKG-040`)", ux2_sv_empty())
        return false
    }

    let sub_name = (*args)[0]
    if ux2_sv_eq(sub_name, ux2_sv("init")) {
        out_opts.subcommand = PKG_CMD_INIT
    } else if ux2_sv_eq(sub_name, ux2_sv("add")) {
        out_opts.subcommand = PKG_CMD_ADD
    } else if ux2_sv_eq(sub_name, ux2_sv("remove")) {
        out_opts.subcommand = PKG_CMD_REMOVE
    } else if ux2_sv_eq(sub_name, ux2_sv("update")) {
        out_opts.subcommand = PKG_CMD_UPDATE
    } else if ux2_sv_eq(sub_name, ux2_sv("lock")) {
        out_opts.subcommand = PKG_CMD_LOCK
    } else if ux2_sv_eq(sub_name, ux2_sv("tree")) {
        out_opts.subcommand = PKG_CMD_TREE
    } else if ux2_sv_eq(sub_name, ux2_sv("verify-lock")) {
        out_opts.subcommand = PKG_CMD_VERIFY_LOCK
    } else if ux2_sv_eq(sub_name, ux2_sv("vendor")) {
        out_opts.subcommand = PKG_CMD_VENDOR
    } else {
        report_pkg_usage_error(mut_view(*sink), "unknown `axiomc pkg` subcommand (`AXS-PKG-040`)", sub_name)
        return false
    }

    let mut i: usize = 1usize
    while i < arg_count {
        let a = (*args)[i]
        if ux2_sv_eq(a, ux2_sv("--lib")) {
            out_opts.is_lib = true
        } else if ux2_sv_eq(a, ux2_sv("--bin")) {
            out_opts.is_bin = true
        } else if ux2_sv_eq(a, ux2_sv("--workspace")) {
            out_opts.is_workspace = true
        } else if ux2_sv_eq(a, ux2_sv("--dev")) {
            out_opts.dep_scope = DEP_SCOPE_DEV
        } else if ux2_sv_eq(a, ux2_sv("--build")) {
            out_opts.dep_scope = DEP_SCOPE_BUILD
        } else if ux2_sv_eq(a, ux2_sv("--comptime")) {
            out_opts.dep_scope = DEP_SCOPE_COMPTIME
        } else if ux2_sv_eq(a, ux2_sv("--no-default-features")) {
            out_opts.no_default_features = true
        } else if ux2_sv_eq(a, ux2_sv("--optional")) {
            out_opts.optional = true
        } else if ux2_sv_eq(a, ux2_sv("--public")) {
            out_opts.is_public = true
        } else if ux2_sv_eq(a, ux2_sv("--minimal-versions")) {
            out_opts.minimal_versions = true
        } else if ux2_sv_eq(a, ux2_sv("--dry-run")) {
            out_opts.dry_run = true
        } else if ux2_sv_eq(a, ux2_sv("--check")) {
            out_opts.check_only = true
        } else if ux2_sv_eq(a, ux2_sv("--offline")) {
            out_opts.offline = true
        } else if ux2_sv_eq(a, ux2_sv("--verify-store")) {
            out_opts.verify_store = true
        } else if ux2_sv_eq(a, ux2_sv("--duplicates")) {
            out_opts.duplicates = true
        } else if ux2_sv_eq(a, ux2_sv("--verify")) {
            out_opts.verify_vendor = true
        } else if ux2_sv_eq(a, ux2_sv("--format")) && (i + 1usize) < arg_count {
            let fmt_sv = (*args)[i + 1usize]
            if ux2_sv_eq(fmt_sv, ux2_sv("json")) {
                out_opts.tree_format = TREE_FMT_JSON
            } else if ux2_sv_eq(fmt_sv, ux2_sv("text")) {
                out_opts.tree_format = TREE_FMT_TEXT
            } else {
                report_pkg_usage_error(mut_view(*sink), "unknown tree format (expected `text` or `json`)", fmt_sv)
                return false
            }
            i = i + 1usize
        } else if ux2_sv_eq(a, ux2_sv("--name")) && (i + 1usize) < arg_count {
            out_opts.name = (*args)[i + 1usize]
            i = i + 1usize
        } else if ux2_sv_eq(a, ux2_sv("--path")) && (i + 1usize) < arg_count {
            out_opts.path = (*args)[i + 1usize]
            i = i + 1usize
        } else if ux2_sv_eq(a, ux2_sv("--git")) && (i + 1usize) < arg_count {
            out_opts.git_url = (*args)[i + 1usize]
            i = i + 1usize
        } else if ux2_sv_eq(a, ux2_sv("--rev")) && (i + 1usize) < arg_count {
            out_opts.git_rev = (*args)[i + 1usize]
            i = i + 1usize
        } else if ux2_sv_eq(a, ux2_sv("--invert")) && (i + 1usize) < arg_count {
            out_opts.invert_pkg = (*args)[i + 1usize]
            i = i + 1usize
        } else if bld_sv_byte(a, 0usize) != 45u8 {
            // Positional argument
            if out_opts.spec.len == 0usize {
                out_opts.spec = a
            }
        } else {
            report_pkg_usage_error(mut_view(*sink), "unrecognized command-line option (`AXS-PKG-040`)", a)
            return false
        }
        i = i + 1usize
    }

    true
}

// =============================================================================
// 4. `axiomc pkg init` Execution Engine (`AXS-PKG-040 §1`)
// =============================================================================

pub fn execute_pkg_init(
    opts: view<PkgCmdOptions>,
    manifest_exists: bool,
    out_toml: mut_view<DiagBuffer>,
    out_source_code: mut_view<DiagBuffer>,
    sink: mut_view<DiagSink>
) -> i32 {
    if manifest_exists {
        report_pkg_bad_manifest_diag(
            mut_view(*sink),
            "`axiom.toml` already exists in this directory (`AXS-PKG-040 §1`)",
            "schema",
            "detail",
            ux2_sv("manifest_exists")
        )
        return PKG_EXIT_DIAG_ERROR
    }

    let pkg_name = if opts.name.len > 0usize { opts.name } else { ux2_sv("my_project") }
    if !validate_package_name(pkg_name, false) {
        report_pkg_bad_manifest_diag(
            mut_view(*sink),
            "invalid package name for `axiomc pkg init` (`AXS-PKG-002 §1`)",
            "schema",
            "package",
            pkg_name
        )
        return PKG_EXIT_DIAG_ERROR
    }

    if opts.is_workspace {
        // Workspace root manifest
        diag_buf_push_sv(mut_view(*out_toml), ux2_sv("[workspace]\nmembers = [\"crates/*\"]\nresolver = \"1\"\n"))
        return PKG_EXIT_OK
    }

    // Package manifest template
    diag_buf_push_sv(mut_view(*out_toml), ux2_sv("[package]\nname = \""))
    diag_buf_push_sv(mut_view(*out_toml), pkg_name)
    diag_buf_push_sv(mut_view(*out_toml), ux2_sv("\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[dependencies]\n"))

    // Source template in canonical '=' and '.' syntax (`axiom-syntax`)
    if opts.is_lib {
        diag_buf_push_sv(
            mut_view(*out_source_code),
            ux2_sv("module my_project\n\npub fn greeting() -> str {\n    return \"Hello, Axiom!\"\n}\n")
        )
    } else {
        diag_buf_push_sv(
            mut_view(*out_source_code),
            ux2_sv("module main\n\npub fn main() -> i32 {\n    let message = \"Hello, Axiom!\"\n    print(message)\n    return 0\n}\n")
        )
    }

    PKG_EXIT_OK
}

// =============================================================================
// 5. `axiomc pkg add` & `remove` Specification Parser (`AXS-PKG-040 §2..§3`)
// =============================================================================

// Parses `<name>@<constraint>` or `<namespace>/<name>@<constraint>`
pub fn parse_pkg_add_spec(
    spec: StrView,
    out_ns: mut_view<StrView>,
    out_name: mut_view<StrView>,
    out_constraint: mut_view<StrView>,
    sink: mut_view<DiagSink>
) -> bool {
    let t = bld_sv_trim(spec)
    if t.len == 0usize {
        report_pkg_bad_manifest_diag(
            mut_view(*sink),
            "empty package specification passed to `axiomc pkg add`",
            "schema",
            "spec",
            spec
        )
        return false
    }

    let mut at_pos: usize = t.len
    let mut i: usize = 0usize
    while i < t.len {
        if bld_sv_byte(t, i) == 64u8 {
            at_pos = i
            break
        }
        i = i + 1usize
    }

    let coord = if (at_pos < t.len) { bld_sv_slice(t, 0usize, at_pos) } else { t }
    let req = if (at_pos < t.len) { bld_sv_slice(t, at_pos + 1usize, t.len) } else { ux2_sv("*") }

    if !split_namespaced_pkg_spec(coord, mut_view(*out_ns), mut_view(*out_name), mut_view(*sink)) {
        return false
    }

    // Validate version constraint expression
    let mut c = semver_constraint_empty()
    if !semver_constraint_parse(req, mut_view(c)) {
        report_semver_diag(mut_view(*sink), "invalid SemVer 2.0 version constraint (`AXS-PKG-005`)", "constraint", req)
        return false
    }

    *out_constraint = req
    true
}

// =============================================================================
// 6. `axiomc pkg tree` Deterministic Formatting (`AXS-PKG-040 §7`)
// =============================================================================

pub fn render_pkg_tree_text(
    graph: view<ResolvedPackageGraph>,
    duplicates_only: bool,
    invert_target: StrView,
    out_buf: mut_view<DiagBuffer>
) {
    if duplicates_only {
        // Output packages with multiple side-by-side versions (`AXS-PKG-020`)
        let mut i: usize = 0usize
        while i < graph.node_count {
            let p1 = graph.nodes[i].identity
            let mut has_dup = false
            let mut j = i + 1usize
            while j < graph.node_count {
                let p2 = graph.nodes[j].identity
                if ux2_sv_eq(p1.name, p2.name) && p1.version.major != p2.version.major {
                    has_dup = true
                    break
                }
                j = j + 1usize
            }
            if has_dup {
                diag_buf_push_sv(mut_view(*out_buf), ux2_sv("duplicate: "))
                diag_buf_push_sv(mut_view(*out_buf), p1.namespace)
                diag_buf_push_byte(mut_view(*out_buf), 47u8) // '/'
                diag_buf_push_sv(mut_view(*out_buf), p1.name)
                diag_buf_push_byte(mut_view(*out_buf), 64u8) // '@'
                diag_buf_push_sv(mut_view(*out_buf), p1.version.raw)
                diag_buf_push_byte(mut_view(*out_buf), 10u8)
            }
            i = i + 1usize
        }
        return
    }

    // Standard deterministic tree output
    diag_buf_push_sv(mut_view(*out_buf), ux2_sv("Resolved Package Graph:\n"))
    let mut i: usize = 0usize
    while i < graph.node_count {
        let n = graph.nodes[i]
        diag_buf_push_sv(mut_view(*out_buf), ux2_sv("├── "))
        diag_buf_push_sv(mut_view(*out_buf), n.identity.namespace)
        diag_buf_push_byte(mut_view(*out_buf), 47u8) // '/'
        diag_buf_push_sv(mut_view(*out_buf), n.identity.name)
        diag_buf_push_byte(mut_view(*out_buf), 64u8) // '@'
        diag_buf_push_sv(mut_view(*out_buf), n.identity.version.raw)

        diag_buf_push_sv(mut_view(*out_buf), ux2_sv(" ("))
        diag_buf_push_sv(mut_view(*out_buf), pkg_source_kind_prefix(n.identity.source_kind))
        diag_buf_push_sv(mut_view(*out_buf), n.identity.source_id)
        diag_buf_push_sv(mut_view(*out_buf), ux2_sv(") ["))
        diag_buf_push_sv(mut_view(*out_buf), env_class_name(n.identity.env_class))
        diag_buf_push_sv(mut_view(*out_buf), ux2_sv("]\n"))

        if n.active_feature_count > 0usize {
            diag_buf_push_sv(mut_view(*out_buf), ux2_sv("│   features: ["))
            let mut fi: usize = 0usize
            while fi < n.active_feature_count {
                if fi > 0usize {
                    diag_buf_push_sv(mut_view(*out_buf), ux2_sv(", "))
                }
                diag_buf_push_sv(mut_view(*out_buf), n.active_features[fi])
                fi = fi + 1usize
            }
            diag_buf_push_sv(mut_view(*out_buf), ux2_sv("]\n"))
        }

        i = i + 1usize
    }
}

// =============================================================================
// 7. `axiomc pkg verify-lock` & `--locked` Verification Engine (`AXS-PKG-031`)
// =============================================================================

pub fn execute_pkg_verify_lock(
    lockfile_content: StrView,
    graph: view<ResolvedPackageGraph>,
    offline: bool,
    verify_store: bool,
    sink: mut_view<DiagSink>
) -> i32 {
    let mut lock = lockfile_v1_empty()
    let l_content = LockStrView { ptr: lockfile_content.ptr, len: lockfile_content.len }
    let parse_rc = parse_canonical_lockfile_v1(l_content, mut_view(lock))

    if parse_rc == LOCK_STATUS_UNSUPPORTED_VERSION {
        report_pkg_bad_manifest_diag(
            mut_view(*sink),
            "unsupported lock_version in axiom.lock (`AXS-PKG-030`)",
            "lockfile_corrupt",
            "version",
            ux2_sv("invalid_version")
        )
        return PKG_EXIT_DIAG_ERROR
    }

    if parse_rc == LOCK_STATUS_CORRUPT {
        report_pkg_bad_manifest_diag(
            mut_view(*sink),
            "axiom.lock graph_hash tamper check failed (`AXS-PKG-031 §1`)",
            "lockfile_corrupt",
            "detail",
            ux2_sv("tamper_detected")
        )
        return PKG_EXIT_DIAG_ERROR
    }

    // Verify zero drift against active resolved graph
    let mut exp_ns: [16]LockStrView = [lsv_empty(); 16]
    let mut exp_nm: [16]LockStrView = [lsv_empty(); 16]
    let mut exp_ver: [16]LockStrView = [lsv_empty(); 16]
    let mut exp_src: [16]LockStrView = [lsv_empty(); 16]
    let mut exp_env: [16]LockStrView = [lsv_empty(); 16]

    let mut i: usize = 0usize
    while i < graph.node_count && i < 16usize {
        let n = graph.nodes[i]
        exp_ns[i] = LockStrView { ptr: n.identity.namespace.ptr, len: n.identity.namespace.len }
        exp_nm[i] = LockStrView { ptr: n.identity.name.ptr, len: n.identity.name.len }
        exp_ver[i] = LockStrView { ptr: n.identity.version.raw.ptr, len: n.identity.version.raw.len }

        let mut src_buf = lock_buf_new()
        lock_buf_init(mut_view(src_buf))
        let pfx = pkg_source_kind_prefix(n.identity.source_kind)
        lock_buf_push_sv(mut_view(src_buf), LockStrView { ptr: pfx.ptr, len: pfx.len })
        lock_buf_push_sv(mut_view(src_buf), LockStrView { ptr: n.identity.source_id.ptr, len: n.identity.source_id.len })
        exp_src[i] = lock_buf_as_lsv(view(src_buf))

        let env_sv = env_class_name(n.identity.env_class)
        exp_env[i] = LockStrView { ptr: env_sv.ptr, len: env_sv.len }
        i = i + 1usize
    }

    let mut drift_detail = lsv_empty()
    let drift_rc = verify_lockfile_drift_against_nodes(
        view(lock),
        view(exp_ns),
        view(exp_nm),
        view(exp_ver),
        view(exp_src),
        view(exp_env),
        graph.node_count,
        mut_view(drift_detail)
    )

    if drift_rc != LOCK_STATUS_OK {
        let detail_sv = StrView { ptr: drift_detail.ptr, len: drift_detail.len }
        report_pkg_bad_manifest_diag(
            mut_view(*sink),
            "manifest drift detected under --locked / verify-lock (`AXS-PKG-031 §1`)",
            "lockfile_drift",
            "detail",
            detail_sv
        )
        return PKG_EXIT_DIAG_ERROR
    }

    PKG_EXIT_OK
}

// =============================================================================
// 8. `axiomc pkg vendor` Materialization & Verification Engine (`AXS-PKG-033`)
// =============================================================================

pub fn execute_pkg_vendor(
    lockfile_content: StrView,
    vendor_dir: StrView,
    verify_only: bool,
    out_vendor_toml: mut_view<DiagBuffer>,
    sink: mut_view<DiagSink>
) -> i32 {
    let mut lock = lockfile_v1_empty()
    let l_content = LockStrView { ptr: lockfile_content.ptr, len: lockfile_content.len }
    let parse_rc = parse_canonical_lockfile_v1(l_content, mut_view(lock))

    if parse_rc != LOCK_STATUS_OK {
        report_pkg_bad_manifest_diag(
            mut_view(*sink),
            "cannot vendor: invalid or corrupt axiom.lock (`AXS-PKG-030`)",
            "lockfile_corrupt",
            "detail",
            ux2_sv("invalid_lockfile")
        )
        return PKG_EXIT_DIAG_ERROR
    }

    let vdir_lsv = LockStrView { ptr: vendor_dir.ptr, len: vendor_dir.len }
    let mut l_buf = lock_buf_new()
    lock_buf_init(mut_view(l_buf))
    serialize_vendor_manifest(view(lock), vdir_lsv, mut_view(l_buf))

    let toml_sv = lock_buf_as_lsv(view(l_buf))
    diag_buf_push_sv(mut_view(*out_vendor_toml), StrView { ptr: toml_sv.ptr, len: toml_sv.len })
    lock_buf_free(mut_view(l_buf))

    PKG_EXIT_OK
}
