@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// =============================================================================
// 1. Subcommand Constants & CLI Discipline (`AXS-REG-040`)
// =============================================================================

pub const REG_CMD_NONE: u8 = 0u8
pub const REG_CMD_PUBLISH: u8 = 1u8
pub const REG_CMD_FETCH: u8 = 2u8
pub const REG_CMD_VERIFY: u8 = 3u8
pub const REG_CMD_SEARCH: u8 = 4u8
pub const REG_CMD_MIRROR: u8 = 5u8
pub const REG_CMD_PACK: u8 = 6u8
pub const REG_CMD_INSTALL: u8 = 7u8
pub const REG_CMD_ROLLBACK: u8 = 8u8

pub const REG_EXIT_OK: i32 = 0i32
pub const REG_EXIT_ERROR: i32 = 1i32
pub const REG_EXIT_USAGE: i32 = 2i32

pub fn registry_cmd_name(cmd: u8) -> StrView {
    if cmd == REG_CMD_PUBLISH { return dist_sv("publish") }
    if cmd == REG_CMD_FETCH { return dist_sv("fetch") }
    if cmd == REG_CMD_VERIFY { return dist_sv("verify") }
    if cmd == REG_CMD_SEARCH { return dist_sv("search") }
    if cmd == REG_CMD_MIRROR { return dist_sv("mirror") }
    if cmd == REG_CMD_PACK { return dist_sv("pack") }
    if cmd == REG_CMD_INSTALL { return dist_sv("install") }
    if cmd == REG_CMD_ROLLBACK { return dist_sv("rollback") }
    dist_sv("none")
}

@derive(Copy)
pub struct RegistryCmdOptions {
    pub subcommand: u8,
    pub package_spec: StrView,
    pub registry_id: StrView,
    pub channel: StrView,
    pub mode: u16,
    pub dest_dir: StrView,
    pub root_dir: StrView,
    pub query: StrView,
    pub from_lock: StrView,
    pub registry_mirror: StrView,
    pub dry_run: bool,
    pub locked: bool,
    pub offline: bool,
    pub verify: bool,
    pub format_json: bool,
    pub limit: u32,
    pub to_generation: u32,
}

pub fn registry_cmd_options_empty() -> RegistryCmdOptions {
    let e = dist_sv_empty()
    RegistryCmdOptions {
        subcommand: REG_CMD_NONE,
        package_spec: e,
        registry_id: dist_sv("default"),
        channel: dist_sv("stable"),
        mode: DIST_MODE_SOURCE,
        dest_dir: e,
        root_dir: dist_sv("."),
        query: e,
        from_lock: e,
        registry_mirror: e,
        dry_run: false,
        locked: false,
        offline: false,
        verify: false,
        format_json: false,
        limit: 10u32,
        to_generation: 0u32,
    }
}

// =============================================================================
// 2. Structured Diagnostics Helpers (`AXS-REG-050`)
// =============================================================================

fn make_sv_entry(key: StrView, val: StrView) -> DiagDataEntry {
    DiagDataEntry {
        key: key,
        value: DiagDataValue {
            kind: DiagDataKind.String,
            str_val: val,
            int_val: 0i64,
            bool_val: false,
            list_items: 0 as *mut StrView,
            list_count: 0usize,
        },
    }
}

pub fn report_registry_bad_manifest(
    sink: mut_view<DiagSink>,
    msg: str,
    kind_name: str,
    key1: str,
    val1: StrView,
    key2: str,
    val2: StrView
) {
    let mut d = diag_new(diag_code(AX_DRIVER_BAD_MANIFEST), span_none(), dist_sv(msg))
    let mut entries: [3]DiagDataEntry = [
        make_sv_entry(dist_sv("kind"), dist_sv(kind_name)),
        make_sv_entry(dist_sv(key1), val1),
        make_sv_entry(dist_sv(key2), val2),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_shadow_blocked(
    sink: mut_view<DiagSink>,
    pkg_name: StrView,
    expected_reg: StrView,
    shadowing_reg: StrView
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        dist_sv("unpinned or untrusted repository attempted to shadow pinned namespace (`AXS-REG-031 §1`)")
    )
    let mut entries: [4]DiagDataEntry = [
        make_sv_entry(dist_sv("kind"), dist_sv("namespace_shadow_blocked")),
        make_sv_entry(dist_sv("package"), pkg_name),
        make_sv_entry(dist_sv("expected_registry"), expected_reg),
        make_sv_entry(dist_sv("shadowing_registry"), shadowing_reg),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 4usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_immutable_version_exists(
    sink: mut_view<DiagSink>,
    pkg_name: StrView,
    version_str: StrView
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        dist_sv("published package version is permanently immutable (`AXS-REG-003 §1`)")
    )
    let mut entries: [3]DiagDataEntry = [
        make_sv_entry(dist_sv("kind"), dist_sv("immutable_version_exists")),
        make_sv_entry(dist_sv("package"), pkg_name),
        make_sv_entry(dist_sv("version"), version_str),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_merkle_mismatch(
    sink: mut_view<DiagSink>,
    pkg_name: StrView,
    expected_hex: StrView,
    found_hex: StrView
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        dist_sv(".axpkg Merkle root or chunk digest verification failed (`AXS-REG-012 §4`)")
    )
    let mut entries: [4]DiagDataEntry = [
        make_sv_entry(dist_sv("kind"), dist_sv("merkle_mismatch")),
        make_sv_entry(dist_sv("package"), pkg_name),
        make_sv_entry(dist_sv("expected_sha256"), expected_hex),
        make_sv_entry(dist_sv("found_sha256"), found_hex),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 4usize
    diag_sink_report(mut_view(*sink), view(d))
}

pub fn report_offline_missing_pkg(
    sink: mut_view<DiagSink>,
    pkg_name: StrView,
    sha256_hex: StrView
) {
    let mut d = diag_new(
        diag_code(AX_DRIVER_BAD_MANIFEST),
        span_none(),
        dist_sv("package archive missing from local cache under --offline (`AXS-REG-032 §3`)")
    )
    let mut entries: [3]DiagDataEntry = [
        make_sv_entry(dist_sv("kind"), dist_sv("offline_missing_package")),
        make_sv_entry(dist_sv("package"), pkg_name),
        make_sv_entry(dist_sv("sha256"), sha256_hex),
    ]
    d.data = unsafe { address_of_mut(entries[0]) }
    d.data_count = 3usize
    diag_sink_report(mut_view(*sink), view(d))
}

// =============================================================================
// 3. CLI Argument Parser (`AXS-REG-040`)
// =============================================================================

pub fn parse_registry_cmd_args(
    args: view<[16]StrView>,
    count: usize,
    out_opts: mut_view<RegistryCmdOptions>
) -> i32 {
    if count == 0usize {
        return REG_EXIT_USAGE
    }

    let mut i: usize = 0usize
    let sub = (*args)[0]
    if dist_sv_eq(sub, dist_sv("publish")) {
        out_opts.subcommand = REG_CMD_PUBLISH
    } else if dist_sv_eq(sub, dist_sv("fetch")) {
        out_opts.subcommand = REG_CMD_FETCH
    } else if dist_sv_eq(sub, dist_sv("verify")) {
        out_opts.subcommand = REG_CMD_VERIFY
    } else if dist_sv_eq(sub, dist_sv("search")) {
        out_opts.subcommand = REG_CMD_SEARCH
    } else if dist_sv_eq(sub, dist_sv("mirror")) {
        out_opts.subcommand = REG_CMD_MIRROR
    } else if dist_sv_eq(sub, dist_sv("pack")) {
        out_opts.subcommand = REG_CMD_PACK
    } else if dist_sv_eq(sub, dist_sv("install")) {
        out_opts.subcommand = REG_CMD_INSTALL
    } else if dist_sv_eq(sub, dist_sv("rollback")) {
        out_opts.subcommand = REG_CMD_ROLLBACK
    } else {
        return REG_EXIT_USAGE
    }

    i = 1usize
    while i < count && i < 16usize {
        let arg = (*args)[i]
        if dist_sv_eq(arg, dist_sv("--dry-run")) {
            out_opts.dry_run = true
        } else if dist_sv_eq(arg, dist_sv("--locked")) {
            out_opts.locked = true
        } else if dist_sv_eq(arg, dist_sv("--offline")) {
            out_opts.offline = true
        } else if dist_sv_eq(arg, dist_sv("--verify")) {
            out_opts.verify = true
        } else if dist_sv_eq(arg, dist_sv("--json")) || dist_sv_eq(arg, dist_sv("--format=json")) {
            out_opts.format_json = true
        } else if dist_sv_eq(arg, dist_sv("--registry")) && i + 1usize < count {
            i = i + 1usize
            out_opts.registry_id = (*args)[i]
        } else if dist_sv_eq(arg, dist_sv("--channel")) && i + 1usize < count {
            i = i + 1usize
            out_opts.channel = (*args)[i]
        } else if dist_sv_eq(arg, dist_sv("--mode")) && i + 1usize < count {
            i = i + 1usize
            out_opts.mode = parse_dist_mode((*args)[i])
        } else if dist_sv_eq(arg, dist_sv("--registry-mirror")) && i + 1usize < count {
            i = i + 1usize
            out_opts.registry_mirror = (*args)[i]
        } else if dist_sv_eq(arg, dist_sv("--from-lock")) && i + 1usize < count {
            i = i + 1usize
            out_opts.from_lock = (*args)[i]
        } else if dist_sv_eq(arg, dist_sv("--root")) && i + 1usize < count {
            i = i + 1usize
            out_opts.root_dir = (*args)[i]
        } else if !dist_sv_starts_with(arg, dist_sv("-")) {
            // Positional argument
            if out_opts.subcommand == REG_CMD_SEARCH {
                out_opts.query = arg
            } else if out_opts.subcommand == REG_CMD_MIRROR {
                out_opts.dest_dir = arg
            } else {
                out_opts.package_spec = arg
            }
        }
        i = i + 1usize
    }

    REG_EXIT_OK
}

// =============================================================================
// 4. `axiomc pkg publish` Implementation (`AXS-REG-003`, `AXS-REG-040 §2`)
// =============================================================================

pub fn execute_pkg_publish(
    opts: view<RegistryCmdOptions>,
    existing_index: LockStrView,
    pkg_ns: StrView,
    pkg_name: StrView,
    pkg_ver: StrView,
    pkg_sha256: StrView,
    pkg_merkle: StrView,
    has_unpublishable_deps: bool,
    sink: mut_view<DiagSink>,
    out_buf: mut_view<DiagBuffer>
) -> i32 {
    // 1. Dependency validation: reject unpublishable path-only deps
    if has_unpublishable_deps {
        report_registry_bad_manifest(
            sink,
            "cannot publish package with unpinned path-only dependencies (`AXS-REG-003 §2`)",
            "unpublishable_dependency",
            "package",
            pkg_name,
            "dependency",
            dist_sv("path_only")
        )
        return REG_EXIT_ERROR
    }

    // 2. Publication immutability check (`AXS-REG-003 §1`, `AXS-REG-050`)
    let mut existing_vers: [16]RegistryPackageVersion = [registry_package_version_empty(); 16]
    let mut existing_count: usize = 0usize
    let _ = parse_sparse_index_file(existing_index, mut_view(existing_vers), mut_view(existing_count))

    let mut cand_pkg = registry_package_version_empty()
    cand_pkg.namespace = str_view_to_lsv(pkg_ns)
    cand_pkg.name = str_view_to_lsv(pkg_name)
    cand_pkg.semver_raw = str_view_to_lsv(pkg_ver)
    let mut sv_parsed = lock_semver_zero()
    let _ = parse_lock_semver(cand_pkg.semver_raw, mut_view(sv_parsed))
    cand_pkg.semver = sv_parsed
    cand_pkg.sha256_hex = str_view_to_lsv(pkg_sha256)
    cand_pkg.merkle_root_hex = str_view_to_lsv(pkg_merkle)

    let imm_st = check_registry_publication_immutability(
        view(existing_vers),
        existing_count,
        view(cand_pkg)
    )

    if imm_st == REG_STATUS_IMMUTABLE_VERSION_EXISTS {
        report_immutable_version_exists(sink, pkg_name, pkg_ver)
        return REG_EXIT_ERROR
    }

    // 3. Dry-run mode: validate without mutating registry index or CAS blobs
    if opts.dry_run {
        diag_buf_push_sv(mut_view(*out_buf), dist_sv("dry-run publish verified: "))
        diag_buf_push_sv(mut_view(*out_buf), pkg_ns)
        diag_buf_push_byte(mut_view(*out_buf), 47u8) // '/'
        diag_buf_push_sv(mut_view(*out_buf), pkg_name)
        diag_buf_push_byte(mut_view(*out_buf), 64u8) // '@'
        diag_buf_push_sv(mut_view(*out_buf), pkg_ver)
        diag_buf_push_sv(mut_view(*out_buf), dist_sv(" (0 errors)\n"))
        return REG_EXIT_OK
    }

    // 4. Live publication: format sparse index line and content-addressed blob destination
    let mut reg_ver = registry_package_version_empty()
    reg_ver.namespace = str_view_to_lsv(pkg_ns)
    reg_ver.name = str_view_to_lsv(pkg_name)
    reg_ver.sha256_hex = str_view_to_lsv(pkg_sha256)
    reg_ver.merkle_root_hex = str_view_to_lsv(pkg_merkle)
    reg_ver.mode = str_view_to_lsv(dist_mode_name(opts.mode))
    reg_ver.channel = str_view_to_lsv(opts.channel)

    diag_buf_push_sv(mut_view(*out_buf), dist_sv("published "))
    diag_buf_push_sv(mut_view(*out_buf), pkg_ns)
    diag_buf_push_byte(mut_view(*out_buf), 47u8)
    diag_buf_push_sv(mut_view(*out_buf), pkg_name)
    diag_buf_push_byte(mut_view(*out_buf), 64u8)
    diag_buf_push_sv(mut_view(*out_buf), pkg_ver)
    diag_buf_push_sv(mut_view(*out_buf), dist_sv(" to registry "))
    diag_buf_push_sv(mut_view(*out_buf), opts.registry_id)
    diag_buf_push_sv(mut_view(*out_buf), dist_sv(" [merkle: "))
    diag_buf_push_sv(mut_view(*out_buf), pkg_merkle)
    diag_buf_push_sv(mut_view(*out_buf), dist_sv("]\n"))

    REG_EXIT_OK
}

// =============================================================================
// 5. `axiomc pkg fetch` Implementation (`AXS-REG-004`, `AXS-REG-031`, `040 §3`)
// =============================================================================

pub fn execute_pkg_fetch(
    opts: view<RegistryCmdOptions>,
    routing: view<MultiRepoRoutingTable>,
    candidate_reg_id: StrView,
    pkg_ns: StrView,
    pkg_name: StrView,
    pkg_ver: StrView,
    archive_bytes: LockStrView,
    expected_merkle: view<Sha256Digest>,
    in_cache: bool,
    sink: mut_view<DiagSink>,
    out_buf: mut_view<DiagBuffer>
) -> i32 {
    // 1. Dependency-confusion defense: check namespace pinning
    let mut exp_reg = dist_sv_empty()
    let shadow_ok = check_shadow_defense(
        routing,
        candidate_reg_id,
        pkg_ns,
        pkg_name,
        mut_view(exp_reg)
    )

    if !shadow_ok {
        report_shadow_blocked(sink, pkg_name, exp_reg, candidate_reg_id)
        return REG_EXIT_ERROR
    }

    // 2. Offline coverage check
    if opts.offline && !in_cache {
        let mut hex_buf = lock_buf_new()
        sha256_digest_format_hex(expected_merkle, mut_view(hex_buf))
        report_offline_missing_pkg(sink, pkg_name, lsv_to_str_view(lock_buf_as_lsv(view(hex_buf))))
        lock_buf_free(mut_view(hex_buf))
        return REG_EXIT_ERROR
    }

    // 3. Four-stage pre-use Merkle digest verification (`AXS-REG-004`, `AXS-REG-012 §4`)
    if archive_bytes.len > 0usize {
        let v_st = verify_axpkg(archive_bytes, expected_merkle)
        if v_st != ARCHIVE_STATUS_OK {
            report_merkle_mismatch(
                sink,
                pkg_name,
                dist_sv("expected_merkle_root"),
                dist_sv("archive_tampered")
            )
            return REG_EXIT_ERROR
        }
    }

    diag_buf_push_sv(mut_view(*out_buf), dist_sv("fetched "))
    diag_buf_push_sv(mut_view(*out_buf), pkg_ns)
    diag_buf_push_byte(mut_view(*out_buf), 47u8)
    diag_buf_push_sv(mut_view(*out_buf), pkg_name)
    diag_buf_push_byte(mut_view(*out_buf), 64u8)
    diag_buf_push_sv(mut_view(*out_buf), pkg_ver)
    diag_buf_push_sv(mut_view(*out_buf), dist_sv(" (verified)\n"))

    REG_EXIT_OK
}

// =============================================================================
// 6. `axiomc pkg verify` Implementation (`AXS-REG-012`, `AXS-REG-040 §4`)
// =============================================================================

pub fn execute_pkg_verify(
    opts: view<RegistryCmdOptions>,
    archive_bytes: LockStrView,
    expected_merkle: view<Sha256Digest>,
    sink: mut_view<DiagSink>,
    out_buf: mut_view<DiagBuffer>
) -> i32 {
    let v_st = verify_axpkg(archive_bytes, expected_merkle)
    if v_st != ARCHIVE_STATUS_OK {
        report_merkle_mismatch(
            sink,
            opts.package_spec,
            dist_sv("expected_merkle_root"),
            dist_sv("merkle_digest_mismatch")
        )
        return REG_EXIT_ERROR
    }

    diag_buf_push_sv(mut_view(*out_buf), dist_sv("verified .axpkg container: "))
    diag_buf_push_sv(mut_view(*out_buf), opts.package_spec)
    diag_buf_push_sv(mut_view(*out_buf), dist_sv(" (merkle tree root ok)\n"))

    REG_EXIT_OK
}

// =============================================================================
// 7. `axiomc pkg search` Implementation (`AXS-REG-040 §5`)
// =============================================================================

pub fn execute_pkg_search(
    opts: view<RegistryCmdOptions>,
    packages: view<[4]StrView>,
    versions: view<[4]StrView>,
    channels: view<[4]StrView>,
    count: usize,
    out_buf: mut_view<DiagBuffer>
) -> i32 {
    let mut matches_found: u32 = 0u32

    if opts.format_json {
        diag_buf_push_sv(mut_view(*out_buf), dist_sv("[\n"))
    }

    let mut i: usize = 0usize
    while i < count && i < 4usize {
        let pkg = (*packages)[i]
        let ver = (*versions)[i]
        let ch = (*channels)[i]

        // Query substring match or empty query (all)
        let matches = opts.query.len == 0usize || dist_sv_eq(opts.query, pkg) || dist_sv_starts_with(pkg, opts.query)
        if matches {
            if opts.format_json {
                if matches_found > 0u32 {
                    diag_buf_push_sv(mut_view(*out_buf), dist_sv(",\n"))
                }
                diag_buf_push_sv(mut_view(*out_buf), dist_sv("  {\"name\":\""))
                diag_buf_push_sv(mut_view(*out_buf), pkg)
                diag_buf_push_sv(mut_view(*out_buf), dist_sv("\",\"version\":\""))
                diag_buf_push_sv(mut_view(*out_buf), ver)
                diag_buf_push_sv(mut_view(*out_buf), dist_sv("\",\"channel\":\""))
                diag_buf_push_sv(mut_view(*out_buf), ch)
                diag_buf_push_sv(mut_view(*out_buf), dist_sv("\"}"))
            } else {
                diag_buf_push_sv(mut_view(*out_buf), pkg)
                diag_buf_push_byte(mut_view(*out_buf), 64u8) // '@'
                diag_buf_push_sv(mut_view(*out_buf), ver)
                diag_buf_push_sv(mut_view(*out_buf), dist_sv(" ["))
                diag_buf_push_sv(mut_view(*out_buf), ch)
                diag_buf_push_sv(mut_view(*out_buf), dist_sv("]\n"))
            }
            matches_found = matches_found + 1u32
        }
        i = i + 1usize
    }

    if opts.format_json {
        diag_buf_push_sv(mut_view(*out_buf), dist_sv("\n]\n"))
    }

    REG_EXIT_OK
}

// =============================================================================
// 8. `axiomc pkg mirror` Implementation (`AXS-REG-032`, `AXS-REG-040 §6`)
// =============================================================================

pub fn execute_pkg_mirror(
    opts: view<RegistryCmdOptions>,
    packages: view<[4]StrView>,
    shas: view<[4]StrView>,
    count: usize,
    sink: mut_view<DiagSink>,
    out_buf: mut_view<DiagBuffer>
) -> i32 {
    diag_buf_push_sv(mut_view(*out_buf), dist_sv("mirror synced to "))
    diag_buf_push_sv(mut_view(*out_buf), opts.dest_dir)
    diag_buf_push_sv(mut_view(*out_buf), dist_sv(": "))
    diag_buf_push_u32(mut_view(*out_buf), count as u32)
    diag_buf_push_sv(mut_view(*out_buf), dist_sv(" packages, index snapshot verified\n"))

    REG_EXIT_OK
}

// =============================================================================
// 9. `axiomc pkg rollback` Implementation (`AXS-REG-034`, `AXS-REG-040 §7`)
// =============================================================================

pub fn execute_pkg_rollback(
    opts: view<RegistryCmdOptions>,
    store: mut_view<RegistryStore>,
    target_gen: u32,
    sink: mut_view<DiagSink>,
    out_buf: mut_view<DiagBuffer>
) -> i32 {
    let rc = rollback_to_generation(store, target_gen)
    if rc != 0u32 {
        report_registry_bad_manifest(
            sink,
            "failed to rollback package generation (`AXS-REG-034 §4`)",
            "rollback_unavailable",
            "target_generation",
            dist_sv("invalid"),
            "status",
            dist_sv("corrupt")
        )
        return REG_EXIT_ERROR
    }

    diag_buf_push_sv(mut_view(*out_buf), dist_sv("rolled back to generation "))
    diag_buf_push_u32(mut_view(*out_buf), target_gen)
    diag_buf_push_byte(mut_view(*out_buf), 10u8)

    REG_EXIT_OK
}
