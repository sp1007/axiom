fn pcgu_zero_bytes(ptr: *mut u8, count: usize) {
    let mut i: usize = 0;
    while (i + 8) <= count {
        unsafe { *((ptr + i) as *mut u64) = 0u64; }
        i = i + 8;
    }
    while i < count {
        unsafe { *(ptr + i) = 0u8; }
        i = i + 1;
    }
}

fn pcgu_copy_bytes(src: *const u8, dst: *mut u8, count: usize) {
    let mut i: usize = 0;
    while i < count {
        unsafe { *(dst + i) = *(src + i); }
        i = i + 1;
    }
}

fn pcgu_write_le_u16(dst: *mut u8, off: usize, v: u16) {
    unsafe {
        *(dst + off) = (v & 0xFFu16) as u8;
        *(dst + off + 1) = ((v >> 8u16) as u8) & 0xFFu8;
    }
}

fn pcgu_write_le_u32(dst: *mut u8, off: usize, v: u32) {
    unsafe {
        *(dst + off) = (v & 0xFFu32) as u8;
        *(dst + off + 1) = ((v >> 8u32) & 0xFFu32) as u8;
        *(dst + off + 2) = ((v >> 16u32) & 0xFFu32) as u8;
        *(dst + off + 3) = ((v >> 24u32) & 0xFFu32) as u8;
    }
}

fn pcgu_write_le_u64(dst: *mut u8, off: usize, v: u64) {
    pcgu_write_le_u32(dst, off, (v & 0xFFFFFFFFu64) as u32);
    pcgu_write_le_u32(dst, off + 4, ((v >> 32u64) & 0xFFFFFFFFu64) as u32);
}

fn pcgu_buf_push_ascii(out: mut_view<DiagBuffer>, start: usize, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), PAR_CGU_ASCII[start + i]);
        i = i + 1;
    }
}

