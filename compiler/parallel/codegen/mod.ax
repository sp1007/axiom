// ============================================================================
// 1. Constants, Fault Classifications, Promotion Stages & Barrier States
//    (SPEC-23 AXS-PAR-013..015, AXS-PAR-020..024, AXS-PAR-050)
// ============================================================================

pub const PAR_CGU_MAX_UNITS: usize = 32;
pub const PAR_CGU_MAX_ITEMS_PER_UNIT: usize = 16;
pub const PAR_CGU_MAX_WORKERS: usize = 16;
pub const PAR_CGU_MAX_DIAGS: usize = 64;
pub const PAR_CGU_MAX_WORKER_DIAGS: usize = 16;
pub const PAR_CGU_MAX_ARCHIVES: usize = 8;

// Fault classification (SPEC-23 AXS-PAR-015 §2, REQ-LNK-1118..1131)
pub const FAULT_NONE: u8 = 0u8;
pub const FAULT_SOURCE_FAILURE: u8 = 1u8;     // Deterministic user error — never retried (REQ-LNK-1126)
pub const FAULT_WORKER_FAILURE: u8 = 2u8;     // Expired lease / worker crash — retried with backoff (REQ-LNK-1127)
pub const FAULT_RESOURCE_FAILURE: u8 = 3u8;   // Memory pressure / token exhaustion — rescheduled at lower concurrency (REQ-LNK-1128)
pub const FAULT_ARTIFACT_FAILURE: u8 = 4u8;   // Checksum/schema mismatch — rejected & quarantined (REQ-LNK-1130..1131)

// Artifact promotion lifecycle (SPEC-23 AXS-PAR-024 §2, REQ-LNK-1227)
pub const ARTIFACT_STAGE_UNPRODUCED: u8 = 0u8;
pub const ARTIFACT_STAGE_PRODUCED: u8 = 1u8;
pub const ARTIFACT_STAGE_VERIFIED: u8 = 2u8;
pub const ARTIFACT_STAGE_TRUSTED: u8 = 3u8;
pub const ARTIFACT_STAGE_PUBLISHED: u8 = 4u8;
pub const ARTIFACT_STAGE_QUARANTINED: u8 = 5u8;

// Finalization barrier states (SPEC-23 AXS-PAR-024 §2, REQ-LNK-1026..1029, REQ-LNK-1223..1229)
pub const BARRIER_PENDING: u8 = 0u8;
pub const BARRIER_PASSED: u8 = 1u8;
pub const BARRIER_BLOCKED_BY_ERROR: u8 = 2u8;

// Memory pressure governance thresholds (SPEC-23 AXS-PAR-013 §2, REQ-LNK-1181..1183)
pub const MEM_PRESSURE_NORMAL: u8 = 0u8;
pub const MEM_PRESSURE_ELEVATED: u8 = 1u8;
pub const MEM_PRESSURE_CRITICAL: u8 = 2u8;

// Orchestration bottleneck classifications (SPEC-23 AXS-PAR-050 §1, REQ-LNK-1207..1222)
pub const BOTTLENECK_BALANCED: u8 = 0u8;
pub const BOTTLENECK_CRITICAL_PATH: u8 = 1u8;
pub const BOTTLENECK_MEMORY_BOUND: u8 = 2u8;
pub const BOTTLENECK_CACHE_BOUND: u8 = 3u8;

// Diagnostic codes (SPEC-23 AXS-PAR-021 §3, AXS-PAR-050)
pub const DIAG_AX_DRIVER_USAGE: u32 = 9001u32;
pub const DIAG_AX_LINK_CGU_LIMIT: u32 = 9301u32;
pub const DIAG_AX_ICE_PARALLEL_VERIFY: u32 = 9901u32;
pub const DIAG_AX_ICE_OUT_OF_MEMORY: u32 = 9902u32;

