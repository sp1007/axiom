@derive(Copy)
pub struct ParallelCgu {
    pub cgu_index: u32,
    pub module_id: ModuleId,
    pub source_file_id: SourceFileId,
    pub partition_ordinal: u32,
    pub module_partition_count: u32,
    pub primary_key: SemanticKey,
    pub item_def_ids: [16]u32,
    pub item_count: u32,
    pub cgu_fp: Fingerprint128,
    pub interface_fp: Fingerprint128,

    pub state: u8,
    pub priority_tier: u8,
    pub cost: ResourceCostEstimate,
    pub preferred_worker: u32,
    pub executed_by_worker: u32,
    pub stolen_from_worker: u32,
    pub was_stolen: bool,
    pub simulated_delay_ms: u32,
    pub completion_order: u32,

    pub reused_from_cache: bool,
    pub published_to_cache: bool,
    pub has_error: bool,
    pub injected_worker_fault: bool,
    pub injected_resource_fault: bool,
    pub injected_artifact_corrupt: bool,
    pub fault_kind: u8,
    pub retry_count: u32,
