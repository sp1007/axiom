@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct Utf8Dec {
    pub cp: u32,
    pub byte_len: usize,
    pub ok: bool,
}

pub fn ax_utf8_decode(bytes: *const u8, max_len: usize) -> Utf8Dec {
    if max_len == 0 {
        return Utf8Dec { cp: 0xFFFDu32, byte_len: 0, ok: false };
    }
    let b0 = unsafe { *bytes };
    if b0 < 0x80u8 {
        return Utf8Dec { cp: b0 as u32, byte_len: 1, ok: true };
    }
    if (b0 & 0xE0u8) == 0xC0u8 {
        if b0 < 0xC2u8 || max_len < 2 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        let b1 = unsafe { *(bytes + 1) };
        if (b1 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        let cp = (((b0 & 0x1Fu8) as u32) << 6u32) | ((b1 & 0x3Fu8) as u32);
        return Utf8Dec { cp: cp, byte_len: 2, ok: true };
    }
    if (b0 & 0xF0u8) == 0xE0u8 {
        if max_len < 2 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        let b1 = unsafe { *(bytes + 1) };
        if (b1 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        if (b0 == 0xE0u8 && b1 < 0xA0u8) || (b0 == 0xEDu8 && b1 >= 0xA0u8) {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        if max_len < 3 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 2, ok: false };
        }
        let b2 = unsafe { *(bytes + 2) };
        if (b2 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 2, ok: false };
        }
        let cp = (((b0 & 0x0Fu8) as u32) << 12u32) | (((b1 & 0x3Fu8) as u32) << 6u32) | ((b2 & 0x3Fu8) as u32);
        return Utf8Dec { cp: cp, byte_len: 3, ok: true };
    }
    if (b0 & 0xF8u8) == 0xF0u8 {
        if b0 > 0xF4u8 || max_len < 2 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        let b1 = unsafe { *(bytes + 1) };
        if (b1 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        if (b0 == 0xF0u8 && b1 < 0x90u8) || (b0 == 0xF4u8 && b1 >= 0x90u8) {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        if max_len < 3 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 2, ok: false };
        }
        let b2 = unsafe { *(bytes + 2) };
        if (b2 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 2, ok: false };
        }
        if max_len < 4 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 3, ok: false };
        }
        let b3 = unsafe { *(bytes + 3) };
        if (b3 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 3, ok: false };
        }
        let cp = (((b0 & 0x07u8) as u32) << 18u32) | (((b1 & 0x3Fu8) as u32) << 12u32) | (((b2 & 0x3Fu8) as u32) << 6u32) | ((b3 & 0x3Fu8) as u32);
        return Utf8Dec { cp: cp, byte_len: 4, ok: true };
    }
    Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false }
}

pub fn ax_utf8_encode(cp: u32, out: *mut u8) -> usize {
    if cp <= 0x7Fu32 {
        unsafe { *out = cp as u8; }
        return 1;
    }
    if cp <= 0x7FFu32 {
        unsafe {
            *out = (0xC0u32 | (cp >> 6u32)) as u8;
            *(out + 1) = (0x80u32 | (cp & 0x3Fu32)) as u8;
        }
        return 2;
    }
    if cp <= 0xFFFFu32 {
        if cp >= 0xD800u32 && cp <= 0xDFFFu32 { return 0; }
        unsafe {
            *out = (0xE0u32 | (cp >> 12u32)) as u8;
            *(out + 1) = (0x80u32 | ((cp >> 6u32) & 0x3Fu32)) as u8;
            *(out + 2) = (0x80u32 | (cp & 0x3Fu32)) as u8;
        }
        return 3;
    }
    if cp <= 0x10FFFFu32 {
        unsafe {
            *out = (0xF0u32 | (cp >> 18u32)) as u8;
            *(out + 1) = (0x80u32 | ((cp >> 12u32) & 0x3Fu32)) as u8;
            *(out + 2) = (0x80u32 | ((cp >> 6u32) & 0x3Fu32)) as u8;
            *(out + 3) = (0x80u32 | (cp & 0x3Fu32)) as u8;
        }
        return 4;
    }
    0
}

pub fn lex_result_init(res: mut_view<LexResult>) {
    res.arena = arena_new();
    res.tokens = 0 as *mut Token;
    res.token_count = 0;
    res.token_cap = 0;
    res.comments = 0 as *mut Comment;
    res.comment_count = 0;
    res.comment_cap = 0;
}

pub fn ax_lex_result_free(res: mut_view<LexResult>) {
    if res.token_cap > 0 && res.tokens as usize != 0 {
        unsafe { heap_free(res.tokens as *mut u8, (((res.token_cap as isize) * (size_of<Token>() as isize)) as usize), align_of<Token>()); }
    }
    if res.comment_cap > 0 && res.comments as usize != 0 {
        unsafe { heap_free(res.comments as *mut u8, (((res.comment_cap as isize) * (size_of<Comment>() as isize)) as usize), align_of<Comment>()); }
    }
    arena_destroy(mut_view(res.arena));
    res.tokens = 0 as *mut Token;
    res.token_count = 0;
    res.token_cap = 0;
    res.comments = 0 as *mut Comment;
    res.comment_count = 0;
    res.comment_cap = 0;
}

pub fn lex_token_get(res: view<LexResult>, idx: usize) -> Token {
    unsafe {
        let p = lex_token_ptr(res.tokens, idx);
        Token { kind: (*p).kind, suffix: (*p).suffix, flags: (*p).flags, char_val: (*p).char_val, span: Span { file: FileId { v: (*p).span.file.v }, start: (*p).span.start, end: (*p).span.end }, int_val: (*p).int_val, str_ptr: (*p).str_ptr, str_len: (*p).str_len, ident_val: StrId { v: (*p).ident_val.v } }
    }
}
pub fn lex_comment_get(res: view<LexResult>, idx: usize) -> Comment {
    unsafe {
        let p = lex_comment_ptr(res.comments, idx);
        Comment { kind: (*p).kind, span: Span { file: FileId { v: (*p).span.file.v }, start: (*p).span.start, end: (*p).span.end } }
    }
}

fn push_token(res: mut_view<LexResult>, tok: view<Token>) {
    if res.token_count == res.token_cap {
        let new_cap = if res.token_cap == 0 { 64 } else { res.token_cap + res.token_cap };
        let new_mem = unsafe { heap_alloc((((new_cap as isize) * (size_of<Token>() as isize)) as usize), align_of<Token>()) as *mut Token };
        if res.token_count > 0 && res.tokens as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(res.tokens as *const u8, new_mem as *mut u8, (((res.token_count as isize) * (size_of<Token>() as isize)) as usize));
                heap_free(res.tokens as *mut u8, (((res.token_cap as isize) * (size_of<Token>() as isize)) as usize), align_of<Token>());
            }
        }
        res.tokens = new_mem;
        res.token_cap = new_cap;
    }
    unsafe {
        *(lex_token_ptr(res.tokens, res.token_count)) = Token { kind: tok.kind, suffix: tok.suffix, flags: tok.flags, char_val: tok.char_val, span: Span { file: FileId { v: tok.span.file.v }, start: tok.span.start, end: tok.span.end }, int_val: tok.int_val, str_ptr: tok.str_ptr, str_len: tok.str_len, ident_val: StrId { v: tok.ident_val.v } };
    }
    res.token_count = res.token_count + 1;
}

fn push_simple_token(res: mut_view<LexResult>, kind: u8, flags: u16, sp: Span) {
    let tok = Token { kind: kind, suffix: SUFFIX_NONE, flags: flags, char_val: 0u32, span: sp, int_val: 0u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: StrId { v: 0u32 } };
    push_token(res, view(tok));
}

fn push_comment(res: mut_view<LexResult>, kind: u8, sp: Span) {
    if res.comment_count == res.comment_cap {
        let new_cap = if res.comment_cap == 0 { 16 } else { res.comment_cap + res.comment_cap };
        let new_mem = unsafe { heap_alloc((((new_cap as isize) * (size_of<Comment>() as isize)) as usize), align_of<Comment>()) as *mut Comment };
        if res.comment_count > 0 && res.comments as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(res.comments as *const u8, new_mem as *mut u8, (((res.comment_count as isize) * (size_of<Comment>() as isize)) as usize));
                heap_free(res.comments as *mut u8, (((res.comment_cap as isize) * (size_of<Comment>() as isize)) as usize), align_of<Comment>());
            }
        }
        res.comments = new_mem;
        res.comment_cap = new_cap;
    }
    unsafe { *(lex_comment_ptr(res.comments, res.comment_count)) = Comment { kind: kind, span: sp }; }
    res.comment_count = res.comment_count + 1;
}

fn lex_msg_sv(arena: mut_view<Arena>, msg_idx: usize) -> StrView {
    let start = LEX_MSG_OFF[msg_idx] as usize;
    let end = LEX_MSG_OFF[msg_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(arena, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = LEX_MSG_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn emit_lex_diag(sink: mut_view<DiagSink>, code_v: u32, sp: Span) {
    let msg = lex_msg_sv(mut_view(sink.arena), code_v as usize);
    let d = Diagnostic { code: DiagCode { v: code_v }, severity: DiagSeverity.Error, message: msg, primary: sp, labels: 0 as *mut DiagLabel, label_count: 0, notes: 0 as *mut StrView, note_count: 0, helps: 0 as *mut StrView, help_count: 0, fixes: 0 as *mut DiagFix, fix_count: 0, data: 0 as *mut DiagDataEntry, data_count: 0 };
    diag_sink_report(sink, view(d));
}

fn emit_lex_diag_with_fix(sink: mut_view<DiagSink>, code_v: u32, sp: Span, rep_msg_idx: usize) {
    let msg = lex_msg_sv(mut_view(sink.arena), code_v as usize);
    let rep = lex_msg_sv(mut_view(sink.arena), rep_msg_idx);
    let edit_ptr = arena_alloc_raw(mut_view(sink.arena), size_of<DiagEdit>(), align_of<DiagEdit>()) as *mut DiagEdit;
    unsafe { *edit_ptr = DiagEdit { span: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end }, replacement: StrView { ptr: rep.ptr, len: rep.len } }; }
    let fix_ptr = arena_alloc_raw(mut_view(sink.arena), size_of<DiagFix>(), align_of<DiagFix>()) as *mut DiagFix;
    unsafe { *fix_ptr = DiagFix { message: StrView { ptr: rep.ptr, len: rep.len }, applicability: FixApplicability.MachineApplicable, edits: edit_ptr, edit_count: 1 }; }
    let d = Diagnostic { code: DiagCode { v: code_v }, severity: DiagSeverity.Error, message: msg, primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end }, labels: 0 as *mut DiagLabel, label_count: 0, notes: 0 as *mut StrView, note_count: 0, helps: 0 as *mut StrView, help_count: 0, fixes: fix_ptr, fix_count: 1, data: 0 as *mut DiagDataEntry, data_count: 0 };
    diag_sink_report(sink, view(d));
}

fn is_ident_start(c: u8) -> bool { (c >= 97u8 && c <= 122u8) || (c >= 65u8 && c <= 90u8) || c == 95u8 }
fn is_ident_continue(c: u8) -> bool { is_ident_start(c) || (c >= 48u8 && c <= 57u8) }
fn is_dec_digit(c: u8) -> bool { c >= 48u8 && c <= 57u8 }
fn is_hex_digit(c: u8) -> bool { is_dec_digit(c) || (c >= 97u8 && c <= 102u8) || (c >= 65u8 && c <= 70u8) }

fn hex_val(c: u8) -> u32 {
    if c >= 48u8 && c <= 57u8 { return (c - 48u8) as u32; }
    if c >= 97u8 && c <= 102u8 { return (c - 97u8 + 10u8) as u32; }
    if c >= 65u8 && c <= 70u8 { return (c - 65u8 + 10u8) as u32; }
    0u32
}

fn check_keyword(s: *const u8, s_len: usize) -> u8 {
    if s_len == 1 && (unsafe { *s }) == 95u8 { return TOK_UNDERSCORE; }
    if s_len < 2 || s_len > 8 { return TOK_IDENT; }
    let mut idx: usize = 0;
    while idx < 40 {
        let start = KW_OFF[idx] as usize;
        let end = KW_OFF[idx + 1] as usize;
        if end - start == s_len {
            let mut eq = true;
            let mut k: usize = 0;
            while k < s_len {
                if (unsafe { *(s + k) }) != KW_DATA[start + k] {
                    eq = false;
                    break;
                }
                k = k + 1;
            }
            if eq { return TOK_KW_AS + (idx as u8); }
        }
        idx = idx + 1;
    }
    TOK_IDENT
}

struct LexCursor {
    file_v: u32,
    p: *const u8,
    byte_len: usize,
    pos: usize,
    pending_nl: bool,
    had_err: bool,
}

fn scan_suffix(cur: mut_view<LexCursor>, sink: mut_view<DiagSink>) -> u8 {
    let p = cur.p;
    let byte_len = cur.byte_len;
    if cur.pos >= byte_len || !is_ident_start(unsafe { *(p + cur.pos) }) {
        return SUFFIX_NONE;
    }
    let start = cur.pos;
    while (cur.pos) < byte_len && is_ident_continue(unsafe { *(p + cur.pos) }) {
        cur.pos = cur.pos + 1;
    }
    let s_len = cur.pos - start;
    let s = unsafe { p + start };

    let mut idx: usize = 1;
    while idx < 13 {
        let off0 = SUF_NAMES_OFF[idx] as usize;
        let off1 = SUF_NAMES_OFF[idx + 1] as usize;
        if off1 - off0 == s_len {
            let mut eq = true;
            let mut k: usize = 0;
            while k < s_len {
                if (unsafe { *(s + k) }) != SUF_NAMES_DATA[off0 + k] {
                    eq = false;
                    break;
                }
                k = k + 1;
            }
            if eq { return idx as u8; }
        }
        idx = idx + 1;
    }
    emit_lex_diag(sink, AX_LEX_INVALID_SUFFIX, span_new(FileId { v: cur.file_v }, start as u32, cur.pos as u32));
    cur.had_err = true;
    SUFFIX_NONE
}

fn scan_whitespace_and_comments(cur: mut_view<LexCursor>, sink: mut_view<DiagSink>, res: mut_view<LexResult>) {
    let p = cur.p;
    let byte_len = cur.byte_len;
    while (cur.pos) < byte_len {
        let c = unsafe { *(p + cur.pos) };
        if c == 10u8 {
            cur.pending_nl = true;
            cur.pos = cur.pos + 1;
        } else if c == 32u8 || c == 9u8 || c == 13u8 {
            cur.pos = cur.pos + 1;
        } else if cur.pos + 1 < byte_len && c == 47u8 && (unsafe { *(p + cur.pos + 1) }) == 47u8 {
            let start = cur.pos as u32;
            cur.pos = cur.pos + 2;
            let mut is_doc = false;
            if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 47u8 && (cur.pos + 1 == byte_len || (unsafe { *(p + cur.pos + 1) }) != 47u8) {
                is_doc = true;
            }
            while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) != 10u8 {
                cur.pos = cur.pos + 1;
            }
            push_comment(mut_view(*res), if is_doc { COMMENT_DOC } else { COMMENT_LINE }, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        } else if cur.pos + 1 < byte_len && c == 47u8 && (unsafe { *(p + cur.pos + 1) }) == 42u8 {
            let start = cur.pos as u32;
            cur.pos = cur.pos + 2;
            let mut depth: i32 = 1;
            while (cur.pos) < byte_len && depth > 0 {
                let ch = unsafe { *(p + cur.pos) };
                if ch == 10u8 { cur.pending_nl = true; }
                if cur.pos + 1 < byte_len && ch == 47u8 && (unsafe { *(p + cur.pos + 1) }) == 42u8 {
                    depth = depth + 1;
                    cur.pos = cur.pos + 2;
                } else if cur.pos + 1 < byte_len && ch == 42u8 && (unsafe { *(p + cur.pos + 1) }) == 47u8 {
                    depth = depth - 1;
                    cur.pos = cur.pos + 2;
                } else {
                    cur.pos = cur.pos + 1;
                }
            }
            if depth > 0 {
                emit_lex_diag(mut_view(*sink), AX_LEX_UNTERMINATED_COMMENT, span_new(FileId { v: cur.file_v }, start, byte_len as u32));
            }
            push_comment(mut_view(*res), COMMENT_BLOCK, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        } else {
            break;
        }
    }
}

fn scan_string_like(cur: mut_view<LexCursor>, start: u32, is_byte_str: bool, is_raw: bool, flags: u16, sink: mut_view<DiagSink>, res: mut_view<LexResult>) {
    let p = cur.p;
    let byte_len = cur.byte_len;
    let mut buf = diag_buf_new();
    let mut terminated = false;
    let mut err = false;

    while (cur.pos) < byte_len {
        let c0 = unsafe { *(p + cur.pos) };
        if c0 == 34u8 {
            terminated = true;
            cur.pos = cur.pos + 1;
            break;
        }
        if c0 == 10u8 || c0 == 13u8 {
            break;
        }
        if !is_raw && c0 == 92u8 {
            let esc_start = cur.pos as u32;
            cur.pos = cur.pos + 1;
            if cur.pos >= byte_len || (unsafe { *(p + cur.pos) }) == 10u8 || (unsafe { *(p + cur.pos) }) == 13u8 {
                break;
            }
            let c = unsafe { *(p + cur.pos) };
            cur.pos = cur.pos + 1;
            if c == 110u8 { diag_buf_push_byte(mut_view(buf), 10u8); }
            else if c == 114u8 { diag_buf_push_byte(mut_view(buf), 13u8); }
            else if c == 116u8 { diag_buf_push_byte(mut_view(buf), 9u8); }
            else if c == 92u8 { diag_buf_push_byte(mut_view(buf), 92u8); }
            else if c == 48u8 { diag_buf_push_byte(mut_view(buf), 0u8); }
            else if c == 34u8 { diag_buf_push_byte(mut_view(buf), 34u8); }
            else if c == 39u8 { diag_buf_push_byte(mut_view(buf), 39u8); }
            else if c == 120u8 {
                if cur.pos + 1 < byte_len && is_hex_digit(unsafe { *(p + cur.pos) }) && is_hex_digit(unsafe { *(p + cur.pos + 1) }) {
                    let val = (hex_val(unsafe { *(p + cur.pos) }) << 4u32) | hex_val(unsafe { *(p + cur.pos + 1) });
                    cur.pos = cur.pos + 2;
                    if !is_byte_str && val > 0x7Fu32 {
                        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                        err = true;
                    } else {
                        diag_buf_push_byte(mut_view(buf), val as u8);
                    }
                } else {
                    while (cur.pos) < byte_len && (cur.pos - (esc_start as usize)) < 4 && is_hex_digit(unsafe { *(p + cur.pos) }) {
                        cur.pos = cur.pos + 1;
                    }
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                    err = true;
                }
            } else if c == 117u8 {
                if is_byte_str {
                    let mut u_end = cur.pos;
                    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 123u8 {
                        u_end = u_end + 1;
                        while u_end < byte_len && (unsafe { *(p + u_end) }) != 125u8 && (unsafe { *(p + u_end) }) != 34u8 && (unsafe { *(p + u_end) }) != 10u8 && (unsafe { *(p + u_end) }) != 13u8 {
                            u_end = u_end + 1;
                        }
                        if u_end < byte_len && (unsafe { *(p + u_end) }) == 125u8 { u_end = u_end + 1; }
                    }
                    cur.pos = u_end;
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UNICODE_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                    err = true;
                } else {
                    let mut valid = true;
                    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 123u8 {
                        cur.pos = cur.pos + 1;
                        let hex_start = cur.pos;
                        while (cur.pos) < byte_len && is_hex_digit(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
                        let hex_len = cur.pos - hex_start;
                        if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 125u8 {
                            cur.pos = cur.pos + 1;
                            if hex_len > 0 && hex_len <= 6 {
                                let mut val: u32 = 0u32;
                                let mut i = hex_start;
                                while i < hex_start + hex_len {
                                    val = (val << 4u32) | hex_val(unsafe { *(p + i) });
                                    i = i + 1;
                                }
                                if val > 0x10FFFFu32 || (val >= 0xD800u32 && val <= 0xDFFFu32) {
                                    valid = false;
                                } else if val <= 0x7Fu32 {
                                    diag_buf_push_byte(mut_view(buf), val as u8);
                                } else if val <= 0x7FFu32 {
                                    diag_buf_push_byte(mut_view(buf), (0xC0u32 | (val >> 6u32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | (val & 0x3Fu32)) as u8);
                                } else if val <= 0xFFFFu32 {
                                    diag_buf_push_byte(mut_view(buf), (0xE0u32 | (val >> 12u32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | ((val >> 6u32) & 0x3Fu32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | (val & 0x3Fu32)) as u8);
                                } else {
                                    diag_buf_push_byte(mut_view(buf), (0xF0u32 | (val >> 18u32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | ((val >> 12u32) & 0x3Fu32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | ((val >> 6u32) & 0x3Fu32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | (val & 0x3Fu32)) as u8);
                                }
                            } else {
                                valid = false;
                            }
                        } else {
                            while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) != 125u8 && (unsafe { *(p + cur.pos) }) != 34u8 && (unsafe { *(p + cur.pos) }) != 10u8 && (unsafe { *(p + cur.pos) }) != 13u8 {
                                cur.pos = cur.pos + 1;
                            }
                            if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 125u8 { cur.pos = cur.pos + 1; }
                            valid = false;
                        }
                    } else {
                        valid = false;
                    }
                    if !valid {
                        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UNICODE_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                        err = true;
                    }
                }
            } else {
                emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                err = true;
            }
        } else {
            if is_byte_str && c0 >= 0x80u8 {
                let dec = ax_utf8_decode(unsafe { p + cur.pos }, byte_len - cur.pos);
                emit_lex_diag(mut_view(*sink), AX_LEX_NON_ASCII_IN_BYTE_LITERAL, span_new(FileId { v: cur.file_v }, cur.pos as u32, (cur.pos + dec.byte_len) as u32));
                err = true;
                cur.pos = cur.pos + dec.byte_len;
            } else {
                diag_buf_push_byte(mut_view(buf), c0);
                cur.pos = cur.pos + 1;
            }
        }
    }

    if !terminated {
        emit_lex_diag(mut_view(*sink), AX_LEX_UNTERMINATED_STRING, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        err = true;
    }

    let dst = arena_alloc_raw(mut_view(res.arena), buf.len + 1, 1);
    if buf.len > 0 {
        unsafe { ptr_copy_nonoverlapping<u8>(buf.ptr as *const u8, dst, buf.len); }
    }
    unsafe { *(dst + buf.len) = 0u8; }
    let b_len = buf.len;
    diag_buf_free(mut_view(buf));

    let mut tflags = flags;
    if is_raw { tflags = tflags | TOK_FLAG_RAW; }
    if err { tflags = tflags | TOK_FLAG_ERROR; }
    let tok = Token { kind: if is_byte_str { TOK_BYTE_STR } else { TOK_STR }, suffix: SUFFIX_NONE, flags: tflags, char_val: 0u32, span: span_new(FileId { v: cur.file_v }, start, cur.pos as u32), int_val: 0u64, str_ptr: dst as *const u8, str_len: b_len, ident_val: StrId { v: 0u32 } };
    push_token(res, view(tok));
}

fn scan_char_like(cur: mut_view<LexCursor>, start: u32, is_byte: bool, flags: u16, sink: mut_view<DiagSink>, res: mut_view<LexResult>) {
    let p = cur.p;
    let byte_len = cur.byte_len;
    let mut val: u32 = 0u32;
    let mut has_val = false;
    let mut multiple = false;
    let mut terminated = false;
    let mut err = false;

    while (cur.pos) < byte_len {
        let c0 = unsafe { *(p + cur.pos) };
        if c0 == 39u8 {
            terminated = true;
            cur.pos = cur.pos + 1;
            break;
        }
        if c0 == 10u8 || c0 == 13u8 { break; }

        let mut cur_val: u32 = 0u32;
        if c0 == 92u8 {
            let esc_start = cur.pos as u32;
            cur.pos = cur.pos + 1;
            if cur.pos >= byte_len || (unsafe { *(p + cur.pos) }) == 10u8 || (unsafe { *(p + cur.pos) }) == 13u8 { break; }
            let c = unsafe { *(p + cur.pos) };
            cur.pos = cur.pos + 1;
            if c == 110u8 { cur_val = 10u32; }
            else if c == 114u8 { cur_val = 13u32; }
            else if c == 116u8 { cur_val = 9u32; }
            else if c == 92u8 { cur_val = 92u32; }
            else if c == 48u8 { cur_val = 0u32; }
            else if c == 34u8 { cur_val = 34u32; }
            else if c == 39u8 { cur_val = 39u32; }
            else if c == 120u8 {
                if cur.pos + 1 < byte_len && is_hex_digit(unsafe { *(p + cur.pos) }) && is_hex_digit(unsafe { *(p + cur.pos + 1) }) {
                    cur_val = (hex_val(unsafe { *(p + cur.pos) }) << 4u32) | hex_val(unsafe { *(p + cur.pos + 1) });
                    cur.pos = cur.pos + 2;
                    if !is_byte && cur_val > 0x7Fu32 {
                        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                        err = true;
                    }
                } else {
                    while (cur.pos) < byte_len && (cur.pos - (esc_start as usize)) < 4 && is_hex_digit(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                    err = true;
                }
            } else if c == 117u8 {
                if is_byte {
                    let mut u_end = cur.pos;
                    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 123u8 {
                        u_end = u_end + 1;
                        while u_end < byte_len && (unsafe { *(p + u_end) }) != 125u8 && (unsafe { *(p + u_end) }) != 39u8 && (unsafe { *(p + u_end) }) != 10u8 && (unsafe { *(p + u_end) }) != 13u8 { u_end = u_end + 1; }
                        if u_end < byte_len && (unsafe { *(p + u_end) }) == 125u8 { u_end = u_end + 1; }
                    }
                    cur.pos = u_end;
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UNICODE_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                    err = true;
                } else {
                    let mut valid = true;
                    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 123u8 {
                        cur.pos = cur.pos + 1;
                        let hex_start = cur.pos;
                        while (cur.pos) < byte_len && is_hex_digit(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
                        let hex_len = cur.pos - hex_start;
                        if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 125u8 {
                            cur.pos = cur.pos + 1;
                            if hex_len > 0 && hex_len <= 6 {
                                let mut v: u32 = 0u32;
                                let mut i = hex_start;
                                while i < hex_start + hex_len {
                                    v = (v << 4u32) | hex_val(unsafe { *(p + i) });
                                    i = i + 1;
                                }
                                if v > 0x10FFFFu32 || (v >= 0xD800u32 && v <= 0xDFFFu32) { valid = false; } else { cur_val = v; }
                            } else { valid = false; }
                        } else {
                            while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) != 125u8 && (unsafe { *(p + cur.pos) }) != 39u8 && (unsafe { *(p + cur.pos) }) != 10u8 && (unsafe { *(p + cur.pos) }) != 13u8 { cur.pos = cur.pos + 1; }
                            if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 125u8 { cur.pos = cur.pos + 1; }
                            valid = false;
                        }
                    } else { valid = false; }
                    if !valid {
                        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UNICODE_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                        err = true;
                    }
                }
            } else {
                emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                err = true;
            }
        } else if is_byte && c0 >= 0x80u8 {
            let dec = ax_utf8_decode(unsafe { p + cur.pos }, byte_len - cur.pos);
            emit_lex_diag(mut_view(*sink), AX_LEX_NON_ASCII_IN_BYTE_LITERAL, span_new(FileId { v: cur.file_v }, cur.pos as u32, (cur.pos + dec.byte_len) as u32));
            err = true;
            cur.pos = cur.pos + dec.byte_len;
        } else if is_byte {
            cur_val = c0 as u32;
            cur.pos = cur.pos + 1;
        } else {
            let dec = ax_utf8_decode(unsafe { p + cur.pos }, byte_len - cur.pos);
            cur_val = dec.cp;
            cur.pos = cur.pos + dec.byte_len;
        }

        if has_val {
            multiple = true;
        } else {
            val = cur_val;
            has_val = true;
        }
    }

    if !terminated {
        emit_lex_diag(mut_view(*sink), AX_LEX_UNTERMINATED_CHAR, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
    } else if !has_val || multiple {
        emit_lex_diag(mut_view(*sink), AX_LEX_BAD_CHAR_LITERAL, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        err = true;
    }

    let mut tflags = flags;
    if err { tflags = tflags | TOK_FLAG_ERROR; }
    if is_byte {
        let tok = Token { kind: TOK_INT, suffix: SUFFIX_U8, flags: tflags | TOK_FLAG_BYTE_FORM, char_val: 0u32, span: span_new(FileId { v: cur.file_v }, start, cur.pos as u32), int_val: val as u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: StrId { v: 0u32 } };
        push_token(res, view(tok));
    } else {
        let tok = Token { kind: TOK_CHAR, suffix: SUFFIX_NONE, flags: tflags, char_val: val, span: span_new(FileId { v: cur.file_v }, start, cur.pos as u32), int_val: 0u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: StrId { v: 0u32 } };
        push_token(res, view(tok));
    }
}

fn scan_number(cur: mut_view<LexCursor>, start: u32, last_kind: u8, flags: u16, sink: mut_view<DiagSink>, res: mut_view<LexResult>) {
    let p = cur.p;
    let byte_len = cur.byte_len;
    let mut base: u64 = 10u64;
    let mut has_prefix = false;
    let mut digits_start = start as usize;
    let mut err_flags: u16 = 0u16;

    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 48u8 && cur.pos + 1 < byte_len {
        let c = unsafe { *(p + cur.pos + 1) };
        if c == 120u8 || c == 88u8 || c == 111u8 || c == 79u8 || c == 98u8 || c == 66u8 {
            has_prefix = true;
            if c == 88u8 || c == 79u8 || c == 66u8 {
                let rep_idx: usize = if c == 88u8 { 21 } else if c == 79u8 { 22 } else { 23 };
                emit_lex_diag_with_fix(mut_view(*sink), AX_LEX_BAD_BASE_PREFIX, span_new(FileId { v: cur.file_v }, cur.pos as u32, (cur.pos + 2) as u32), rep_idx);
                err_flags = TOK_FLAG_ERROR;
            }
            if c == 120u8 || c == 88u8 { base = 16u64; }
            else if c == 111u8 || c == 79u8 { base = 8u64; }
            else { base = 2u64; }
            cur.pos = cur.pos + 2;
            digits_start = cur.pos;
        }
    }

    let mut val: u64 = 0u64;
    let mut overflow = false;
    let mut missing_digits = true;
    let mut invalid_digit = false;
    let mut bad_sep = false;
    let mut is_float = false;

    while (cur.pos) < byte_len {
        let c = unsafe { *(p + cur.pos) };
        if c == 95u8 {
            let sep_start = cur.pos;
            while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 95u8 { cur.pos = cur.pos + 1; }
            if !bad_sep && (sep_start == digits_start || cur.pos == byte_len || !is_hex_digit(unsafe { *(p + cur.pos) }) || (cur.pos - sep_start) > 1) {
                emit_lex_diag(mut_view(*sink), AX_LEX_BAD_DIGIT_SEPARATOR, span_new(FileId { v: cur.file_v }, sep_start as u32, cur.pos as u32));
                err_flags = TOK_FLAG_ERROR;
                bad_sep = true;
            }
            continue;
        }
        if !is_hex_digit(c) && c != 46u8 && c != 101u8 && c != 69u8 { break; }
        if c == 46u8 || c == 101u8 || c == 69u8 {
            if base != 10u64 {
                if !is_hex_digit(c) { break; }
            } else if c == 46u8 {
                if last_kind == TOK_DOT { break; }
                if cur.pos + 1 < byte_len && !is_dec_digit(unsafe { *(p + cur.pos + 1) }) { break; }
                if cur.pos + 1 == byte_len { break; }
                is_float = true;
            } else {
                if last_kind == TOK_DOT { break; }
                let mut look = cur.pos + 1;
                if look < byte_len && ((unsafe { *(p + look) }) == 43u8 || (unsafe { *(p + look) }) == 45u8) { look = look + 1; }
                if look < byte_len && is_dec_digit(unsafe { *(p + look) }) {
                    is_float = true;
                } else {
                    break;
                }
            }
        }

        if is_float {
            cur.pos = cur.pos + 1;
            while (cur.pos) < byte_len {
                let fc = unsafe { *(p + cur.pos) };
                if fc == 95u8 {
                    let sep_start = cur.pos;
                    while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 95u8 { cur.pos = cur.pos + 1; }
                    if !bad_sep && (cur.pos == byte_len || !is_dec_digit(unsafe { *(p + cur.pos) }) || (cur.pos - sep_start) > 1) {
                        emit_lex_diag(mut_view(*sink), AX_LEX_BAD_DIGIT_SEPARATOR, span_new(FileId { v: cur.file_v }, sep_start as u32, cur.pos as u32));
                        err_flags = TOK_FLAG_ERROR;
                        bad_sep = true;
                    }
                    continue;
                }
                if fc == 101u8 || fc == 69u8 {
                    cur.pos = cur.pos + 1;
                    if (cur.pos) < byte_len && ((unsafe { *(p + cur.pos) }) == 43u8 || (unsafe { *(p + cur.pos) }) == 45u8) {
                        cur.pos = cur.pos + 1;
                    }
                    continue;
                }
                if !is_dec_digit(fc) { break; }
                cur.pos = cur.pos + 1;
            }
            break;
        }

        let mut valid = false;
        if base == 10u64 && is_dec_digit(c) { valid = true; }
        else if base == 16u64 && is_hex_digit(c) { valid = true; }
        else if base == 8u64 && (c >= 48u8 && c <= 55u8) { valid = true; }
        else if base == 2u64 && (c == 48u8 || c == 49u8) { valid = true; }

        if !valid {
            if (base == 2u64 || base == 8u64) && is_dec_digit(c) {
                if !invalid_digit {
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_DIGIT, span_new(FileId { v: cur.file_v }, cur.pos as u32, (cur.pos + 1) as u32));
                    err_flags = TOK_FLAG_ERROR;
                    invalid_digit = true;
                }
                cur.pos = cur.pos + 1;
                continue;
            }
            break;
        } else {
            missing_digits = false;
            let d = hex_val(c) as u64;
            let max_q: u64 = if base == 10u64 { 1844674407370955161u64 } else if base == 16u64 { 0x0FFFFFFFFFFFFFFFu64 } else if base == 8u64 { 0x1FFFFFFFFFFFFFFFu64 } else { 0x7FFFFFFFFFFFFFFFu64 };
            let max_r: u64 = if base == 10u64 { 5u64 } else if base == 16u64 { 15u64 } else if base == 8u64 { 7u64 } else { 1u64 };
            if val > max_q || (val == max_q && d > max_r) {
                overflow = true;
            } else {
                val = val * base + d;
            }
        }
        cur.pos = cur.pos + 1;
    }

    if !bad_sep && cur.pos > digits_start && (unsafe { *(p + cur.pos - 1) }) == 95u8 {
        let mut sep_start = cur.pos - 1;
        while sep_start > digits_start && (unsafe { *(p + sep_start - 1) }) == 95u8 {
            sep_start = sep_start - 1;
        }
        if sep_start > digits_start {
            emit_lex_diag(mut_view(*sink), AX_LEX_BAD_DIGIT_SEPARATOR, span_new(FileId { v: cur.file_v }, sep_start as u32, cur.pos as u32));
            err_flags = TOK_FLAG_ERROR;
        }
    }

    if has_prefix && missing_digits {
        emit_lex_diag(mut_view(*sink), AX_LEX_MISSING_DIGITS, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        err_flags = TOK_FLAG_ERROR;
        val = 0u64;
    }

    cur.had_err = false;
    let mut suf: u8 = SUFFIX_NONE;
    if last_kind != TOK_DOT {
        suf = scan_suffix(mut_view(*cur), mut_view(*sink));
    }
    if cur.had_err { err_flags = TOK_FLAG_ERROR; }

    if !is_float {
        if err_flags == 0u16 && overflow {
            emit_lex_diag(mut_view(*sink), AX_LEX_INT_OVERFLOW, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
            err_flags = TOK_FLAG_ERROR;
            val = 0u64;
        } else if overflow {
            val = 0u64;
        }
    }

    let tok = Token { kind: if is_float { TOK_FLOAT } else { TOK_INT }, suffix: suf, flags: flags | err_flags, char_val: 0u32, span: span_new(FileId { v: cur.file_v }, start, cur.pos as u32), int_val: if is_float { 0u64 } else { val }, str_ptr: 0 as *const u8, str_len: 0, ident_val: StrId { v: 0u32 } };
    push_token(res, view(tok));
}

fn match_punct(c: u8, c2: u8, c3: u8) -> u16 {
    if c == 46u8 && c2 == 46u8 && c3 == 61u8 { return 0x0300u16 | (TOK_DOT_DOT_EQ as u16); }
    if c == 60u8 && c2 == 60u8 && c3 == 61u8 { return 0x0300u16 | (TOK_SHL_EQ as u16); }
    if c == 62u8 && c2 == 62u8 && c3 == 61u8 { return 0x0300u16 | (TOK_SHR_EQ as u16); }
    if c == 46u8 && c2 == 46u8 { return 0x0200u16 | (TOK_DOT_DOT as u16); }
    if c == 45u8 && c2 == 62u8 { return 0x0200u16 | (TOK_ARROW as u16); }
    if c == 61u8 && c2 == 62u8 { return 0x0200u16 | (TOK_FAT_ARROW as u16); }
    if c == 60u8 && c2 == 60u8 { return 0x0200u16 | (TOK_SHL as u16); }
    if c == 62u8 && c2 == 62u8 { return 0x0200u16 | (TOK_SHR as u16); }
    if c == 38u8 && c2 == 38u8 { return 0x0200u16 | (TOK_AMP_AMP as u16); }
    if c == 124u8 && c2 == 124u8 { return 0x0200u16 | (TOK_PIPE_PIPE as u16); }
    if c == 61u8 && c2 == 61u8 { return 0x0200u16 | (TOK_EQ_EQ as u16); }
    if c == 33u8 && c2 == 61u8 { return 0x0200u16 | (TOK_BANG_EQ as u16); }
    if c == 60u8 && c2 == 61u8 { return 0x0200u16 | (TOK_LT_EQ as u16); }
    if c == 62u8 && c2 == 61u8 { return 0x0200u16 | (TOK_GT_EQ as u16); }
    if c == 43u8 && c2 == 61u8 { return 0x0200u16 | (TOK_PLUS_EQ as u16); }
    if c == 45u8 && c2 == 61u8 { return 0x0200u16 | (TOK_MINUS_EQ as u16); }
    if c == 42u8 && c2 == 61u8 { return 0x0200u16 | (TOK_STAR_EQ as u16); }
    if c == 47u8 && c2 == 61u8 { return 0x0200u16 | (TOK_SLASH_EQ as u16); }
    if c == 37u8 && c2 == 61u8 { return 0x0200u16 | (TOK_PERCENT_EQ as u16); }
    if c == 38u8 && c2 == 61u8 { return 0x0200u16 | (TOK_AMP_EQ as u16); }
    if c == 124u8 && c2 == 61u8 { return 0x0200u16 | (TOK_PIPE_EQ as u16); }
    if c == 94u8 && c2 == 61u8 { return 0x0200u16 | (TOK_CARET_EQ as u16); }
    if c == 40u8 { return 0x0100u16 | (TOK_LPAREN as u16); }
    if c == 41u8 { return 0x0100u16 | (TOK_RPAREN as u16); }
    if c == 91u8 { return 0x0100u16 | (TOK_LBRACKET as u16); }
    if c == 93u8 { return 0x0100u16 | (TOK_RBRACKET as u16); }
    if c == 123u8 { return 0x0100u16 | (TOK_LBRACE as u16); }
    if c == 125u8 { return 0x0100u16 | (TOK_RBRACE as u16); }
    if c == 44u8 { return 0x0100u16 | (TOK_COMMA as u16); }
    if c == 59u8 { return 0x0100u16 | (TOK_SEMI as u16); }
    if c == 58u8 { return 0x0100u16 | (TOK_COLON as u16); }
    if c == 46u8 { return 0x0100u16 | (TOK_DOT as u16); }
    if c == 64u8 { return 0x0100u16 | (TOK_AT as u16); }
    if c == 63u8 { return 0x0100u16 | (TOK_QUESTION as u16); }
    if c == 43u8 { return 0x0100u16 | (TOK_PLUS as u16); }
    if c == 45u8 { return 0x0100u16 | (TOK_MINUS as u16); }
    if c == 42u8 { return 0x0100u16 | (TOK_STAR as u16); }
    if c == 47u8 { return 0x0100u16 | (TOK_SLASH as u16); }
    if c == 37u8 { return 0x0100u16 | (TOK_PERCENT as u16); }
    if c == 38u8 { return 0x0100u16 | (TOK_AMP as u16); }
    if c == 124u8 { return 0x0100u16 | (TOK_PIPE as u16); }
    if c == 94u8 { return 0x0100u16 | (TOK_CARET as u16); }
    if c == 126u8 { return 0x0100u16 | (TOK_TILDE as u16); }
    if c == 33u8 { return 0x0100u16 | (TOK_BANG as u16); }
    if c == 60u8 { return 0x0100u16 | (TOK_LT as u16); }
    if c == 62u8 { return 0x0100u16 | (TOK_GT as u16); }
    if c == 61u8 { return 0x0100u16 | (TOK_EQ as u16); }
    0u16
}

pub fn ax_lex_into(file: FileId, text: StrView, sink: mut_view<DiagSink>, interner: mut_view<StrInterner>, out: mut_view<LexResult>) {
    lex_result_init(mut_view(*out));
    let p = text.ptr;
    let byte_len = text.len;
    let mut init_pos: usize = 0;
    if byte_len >= 3 && (unsafe { *p }) == 0xEFu8 && (unsafe { *(p + 1) }) == 0xBBu8 && (unsafe { *(p + 2) }) == 0xBFu8 { init_pos = 3; }
    let mut cur = LexCursor { file_v: file.v, p: p, byte_len: byte_len, pos: init_pos, pending_nl: true, had_err: false };
    let mut last_kind: u8 = TOK_EOF;

    while (cur.pos) < byte_len {
        scan_whitespace_and_comments(mut_view(cur), mut_view(*sink), mut_view(*out));
        if cur.pos >= byte_len { break; }
        let flags: u16 = if cur.pending_nl { TOK_FLAG_NL_BEFORE } else { 0u16 };
        cur.pending_nl = false;
        let start = cur.pos as u32;
        let c = unsafe { *(p + cur.pos) };

        let dec = ax_utf8_decode(unsafe { p + cur.pos }, byte_len - cur.pos);
        if !dec.ok {
            emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UTF8, span_new(FileId { v: file.v }, start, start + (dec.byte_len as u32)));
            push_simple_token(mut_view(*out), TOK_ERROR, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, start + (dec.byte_len as u32)));
            last_kind = TOK_ERROR;
            cur.pos = cur.pos + dec.byte_len;
            continue;
        }

        if is_ident_start(c) {
            if c == 98u8 && cur.pos + 1 < byte_len && ((unsafe { *(p + cur.pos + 1) }) == 34u8 || (unsafe { *(p + cur.pos + 1) }) == 39u8) {
                cur.pos = cur.pos + 1;
                if (unsafe { *(p + cur.pos) }) == 34u8 {
                    cur.pos = cur.pos + 1;
                    scan_string_like(mut_view(cur), start, true, false, flags, mut_view(*sink), mut_view(*out));
                    last_kind = TOK_BYTE_STR;
                } else {
                    cur.pos = cur.pos + 1;
                    scan_char_like(mut_view(cur), start, true, flags, mut_view(*sink), mut_view(*out));
                    last_kind = TOK_INT;
                }
                continue;
            }
            if c == 114u8 && cur.pos + 1 < byte_len && (unsafe { *(p + cur.pos + 1) }) == 34u8 {
                cur.pos = cur.pos + 2;
                scan_string_like(mut_view(cur), start, false, true, flags, mut_view(*sink), mut_view(*out));
                last_kind = TOK_STR;
                continue;
            }
            while (cur.pos) < byte_len && is_ident_continue(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
            let id_len = cur.pos - (start as usize);
            let kw = check_keyword(unsafe { p + (start as usize) }, id_len);
            let mut sid = StrId { v: 0u32 };
            if kw == TOK_IDENT { sid = interner_intern_bytes(mut_view(*interner), unsafe { p + (start as usize) }, id_len); }
            let tok = Token { kind: kw, suffix: SUFFIX_NONE, flags: flags, char_val: 0u32, span: span_new(FileId { v: file.v }, start, cur.pos as u32), int_val: 0u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: sid };
            push_token(mut_view(*out), view(tok));
            last_kind = kw;
            continue;
        }

        if is_dec_digit(c) {
            scan_number(mut_view(cur), start, last_kind, flags, mut_view(*sink), mut_view(*out));
            last_kind = lex_token_get(view(*out), out.token_count - 1).kind;
            continue;
        }

        if c == 34u8 {
            cur.pos = cur.pos + 1;
            scan_string_like(mut_view(cur), start, false, false, flags, mut_view(*sink), mut_view(*out));
            last_kind = TOK_STR;
            continue;
        }

        if c == 39u8 {
            cur.pos = cur.pos + 1;
            if (cur.pos) < byte_len && is_ident_start(unsafe { *(p + cur.pos) }) {
                let word_start = cur.pos;
                while (cur.pos) < byte_len && is_ident_continue(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
                if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 39u8 {
                    cur.pos = (start as usize) + 1;
                    scan_char_like(mut_view(cur), start, false, flags, mut_view(*sink), mut_view(*out));
                    last_kind = TOK_CHAR;
                } else {
                    let sid = interner_intern_bytes(mut_view(*interner), unsafe { p + word_start }, cur.pos - word_start);
                    let tok = Token { kind: TOK_LABEL, suffix: SUFFIX_NONE, flags: flags, char_val: 0u32, span: span_new(FileId { v: file.v }, start, cur.pos as u32), int_val: 0u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: sid };
                    push_token(mut_view(*out), view(tok));
                    last_kind = TOK_LABEL;
                }
            } else {
                scan_char_like(mut_view(cur), start, false, flags, mut_view(*sink), mut_view(*out));
                last_kind = TOK_CHAR;
            }
            continue;
        }

        if c == 58u8 && cur.pos + 1 < byte_len && (unsafe { *(p + cur.pos + 1) }) == 58u8 {
            emit_lex_diag_with_fix(mut_view(*sink), AX_LEX_COLON_COLON, span_new(FileId { v: file.v }, start, start + 2u32), 19);
            push_simple_token(mut_view(*out), TOK_DOT, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, start + 2u32));
            last_kind = TOK_DOT;
            cur.pos = cur.pos + 2;
            continue;
        }
        if c == 58u8 && cur.pos + 1 < byte_len && (unsafe { *(p + cur.pos + 1) }) == 61u8 {
            emit_lex_diag_with_fix(mut_view(*sink), AX_LEX_COLON_EQ, span_new(FileId { v: file.v }, start, start + 2u32), 20);
            push_simple_token(mut_view(*out), TOK_EQ, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, start + 2u32));
            last_kind = TOK_EQ;
            cur.pos = cur.pos + 2;
            continue;
        }

        let c2 = if cur.pos + 1 < byte_len { unsafe { *(p + cur.pos + 1) } } else { 0u8 };
        let c3 = if cur.pos + 2 < byte_len { unsafe { *(p + cur.pos + 2) } } else { 0u8 };

        if c == 46u8 && c2 == 46u8 && c3 == 46u8 {
            let mut dot_end = cur.pos + 3;
            while dot_end < byte_len && (unsafe { *(p + dot_end) }) == 46u8 { dot_end = dot_end + 1; }
            emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_OPERATOR, span_new(FileId { v: file.v }, start, dot_end as u32));
            push_simple_token(mut_view(*out), TOK_ERROR, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, dot_end as u32));
            last_kind = TOK_ERROR;
            cur.pos = dot_end;
            continue;
        }

        let pm = match_punct(c, c2, c3);
        if pm != 0u16 {
            let pkind = (pm & 0xFFu16) as u8;
            let pstep = (pm >> 8u16) as usize;
            cur.pos = cur.pos + pstep;
            push_simple_token(mut_view(*out), pkind, flags, span_new(FileId { v: file.v }, start, cur.pos as u32));
            last_kind = pkind;
            continue;
        }

        if c >= 0x80u8 {
            let mut run_end = cur.pos + dec.byte_len;
            while run_end < byte_len {
                let next_dec = ax_utf8_decode(unsafe { p + run_end }, byte_len - run_end);
                if !next_dec.ok { break; }
                if next_dec.cp == 0xFEFFu32 || next_dec.cp == 0x2000u32 || next_dec.cp == 0x2001u32 || next_dec.cp == 0x2002u32 || next_dec.cp == 0x2003u32 || next_dec.cp == 0x3000u32 { break; }
                if next_dec.cp >= 0x80u32 || is_ident_continue(unsafe { *(p + run_end) }) { run_end = run_end + next_dec.byte_len; } else { break; }
            }
            if dec.cp == 0xFEFFu32 || dec.cp == 0xA0u32 || dec.cp == 0x2000u32 || dec.cp == 0x2001u32 || dec.cp == 0x2002u32 || dec.cp == 0x2003u32 || dec.cp == 0x3000u32 {
                cur.pos = cur.pos + dec.byte_len;
                emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_CHAR, span_new(FileId { v: file.v }, start, cur.pos as u32));
            } else {
                cur.pos = run_end;
                emit_lex_diag(mut_view(*sink), AX_LEX_NON_ASCII_IDENT, span_new(FileId { v: file.v }, start, cur.pos as u32));
            }
            push_simple_token(mut_view(*out), TOK_ERROR, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, cur.pos as u32));
            last_kind = TOK_ERROR;
            continue;
        }

        cur.pos = cur.pos + 1;
        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_CHAR, span_new(FileId { v: file.v }, start, cur.pos as u32));
        push_simple_token(mut_view(*out), TOK_ERROR, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, cur.pos as u32));
        last_kind = TOK_ERROR;
    }

    let eof_flags: u16 = if cur.pending_nl { TOK_FLAG_NL_BEFORE } else { 0u16 };
    push_simple_token(mut_view(*out), TOK_EOF, eof_flags, span_new(FileId { v: file.v }, byte_len as u32, byte_len as u32));
}
