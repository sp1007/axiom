// LSP 3.17 JSON-RPC 2.0 Framing (`Content-Length`), Message Parser & Method Router,
// Server Lifecycle State Machine (`initialize`, `initialized`, `shutdown`, `exit`),
// Cancellation Tokens (`$/cancelRequest` & revision superseding), and Versioned Fact Envelopes (T801 / E19.1).
// Implements SPEC-100 §2.1, §2.2, §2.3 (AXS-LSP-008, AXS-LSP-009, AXS-LSP-010, AXS-LSP-012).
module compiler.lsp.protocol

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

@derive(Copy)
pub struct LspStrView {
    pub ptr: *const u8,
    pub len: usize,
}

pub fn lsp_str_view(s: str) -> LspStrView {
    let raw: LspStrView = unsafe { *(address_of(s) as *const LspStrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw.len;
    let dst = unsafe { heap_alloc(n + 1, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    LspStrView { ptr: dst as *const u8, len: n }
}

pub fn lsp_str_ptr(s: str) -> *const u8 {
    let sv = lsp_str_view(s);
    sv.ptr
}

pub fn lsp_str_len(s: str) -> usize {
    let raw: LspStrView = unsafe { *(address_of(s) as *const LspStrView) };
    raw.len
}

// ============================================================================
// 1. JSON-RPC 2.0 & LSP 3.17 Constants, Error Codes & Lifecycle States
// ============================================================================

pub const LSP_SCHEMA_VERSION_1: u32 = 1u32;

// Framing parse statuses
pub const FRAME_OK: u8 = 0u8;
pub const FRAME_INCOMPLETE: u8 = 1u8;
pub const FRAME_ERR_MALFORMED_HEADER: u8 = 2u8;
pub const FRAME_ERR_INVALID_UTF8: u8 = 3u8;

