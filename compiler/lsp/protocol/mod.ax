@derive(Copy)
pub struct LspFactHeader {
    pub schema_version: u32,
    pub revision: u64,
    pub certainty: u8,
    pub fallback_reason: u8,
}

pub fn lsp_fact_header_new(revision: u64, certainty: u8, fallback_reason: u8) -> LspFactHeader {
    LspFactHeader {
        schema_version: LSP_SCHEMA_VERSION_1,
        revision: revision,
        certainty: certainty,
        fallback_reason: fallback_reason,
    }
}

