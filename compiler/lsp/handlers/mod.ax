    pub entity_id: GenerationalId,
    pub owner_fn: FunctionId,
    pub scope_depth: u16,
    pub sym_kind: u8,
    pub sem_tok_type: u32,
    pub sem_tok_modifiers: u32,
    pub is_declaration: bool,
    pub is_pub: bool,
    pub is_mutable_binding: bool,
    pub is_builtin_or_external: bool,
    pub type_id: LspTypeId,
    pub ownership_class: u8,
    pub capability_class: u8,
    pub moved_at_line: u32,
    pub dispatch_mode: u8,
    pub effect_mask: u32,
    pub is_pure: bool,
    pub name_hash: u64,
    pub name_str: LspStrView,
    pub signature_str: LspStrView,
    pub resolved_type_str: LspStrView,
    pub capability_owner_str: LspStrView,
    pub trait_origin_str: LspStrView,
    pub doc_comment_str: LspStrView,
}

