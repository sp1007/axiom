@derive(Copy)
pub struct LspTypeMeta {
    pub active: bool,
    pub type_id: LspTypeId,
    pub decl_doc_id: u32,
    pub decl_span_start: u32,
    pub decl_span_end: u32,
    pub decl_symbol_id: LspSymbolId,
    pub canonical_name: LspStrView,
    pub repr_kind: u8,
    pub size_bytes: u32,
    pub align_bytes: u32,
    pub is_copy: bool,
    pub is_drop: bool,
    pub is_send: bool,
    pub is_share: bool,
}

@derive(Copy)
pub struct LspSemanticNode {
