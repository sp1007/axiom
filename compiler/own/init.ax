@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// "use of moved value" (18 bytes)
const OWN_MSG_MOVED: [18]u8 = [
    117u8, 115u8, 101u8, 32u8, 111u8, 102u8, 32u8, 109u8, 111u8, 118u8, 101u8, 100u8, 32u8, 118u8, 97u8, 108u8,
    117u8, 101u8
];

// "use of possibly uninitialized value" (35 bytes)
const OWN_MSG_UNINIT: [35]u8 = [
    117u8, 115u8, 101u8, 32u8, 111u8, 102u8, 32u8, 112u8, 111u8, 115u8, 115u8, 105u8, 98u8, 108u8, 121u8, 32u8,
    117u8, 110u8, 105u8, 110u8, 105u8, 116u8, 105u8, 97u8, 108u8, 105u8, 122u8, 101u8, 100u8, 32u8, 118u8, 97u8,
    108u8, 117u8, 101u8
];

// "moved here" (10 bytes)
const OWN_LBL_MOVED_HERE: [10]u8 = [
    109u8, 111u8, 118u8, 101u8, 100u8, 32u8, 104u8, 101u8, 114u8, 101u8
];

pub struct OwnVisitor {
    pub state: *mut OwnStateInfo,
    pub ctx: *const PathCtx,
    pub sink: *mut DiagSink,
    pub report: bool,
    pub body: *const MirBody,
    pub thir: *const Thir,
    pub cap_tracker: *mut MirCapTracker,
    pub cap_arena: *mut Arena,
    // T498b: for the Copy-ness of a value read through an array index (0 when unknown).
    pub str_in: *const StrInterner,
}

unsafe fn own_state_ptr_at_mut(base: *mut *mut OwnStateInfo, idx: usize) -> *mut *mut OwnStateInfo {
    ((base as usize) + mul_usize(idx, size_of<*mut OwnStateInfo>())) as *mut *mut OwnStateInfo
}

unsafe fn closure_cap_at(base: *const ClosureCapture, idx: usize) -> *const ClosureCapture {
    ((base as usize) + mul_usize(idx, size_of<ClosureCapture>())) as *const ClosureCapture
}

fn truncate_at_deref(place: view<MirPlace>, out: mut_view<MirPlace>) -> bool {
    mir_copy_place(mut_view(*out), place);
    let mut i: usize = 0;
    while (i < place.proj_count) {
        let pr = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_DEREF {
            out.proj_count = i;
            return true;
        }
        i = i + 1;
    }
    false
}

fn emit_own_diag(sink: mut_view<DiagSink>, is_uninit: bool, loc: Span, has_move_lbl: bool, move_loc: Span) {
    if sink.errors > 0 {
        return;
    }
    let code_v = if is_uninit { AX_INIT_USE_UNINIT } else { AX_MOVE_USE_AFTER_MOVE };
    let msg_len: usize = if is_uninit { 35 } else { 18 };
    let buf = arena_alloc_raw(mut_view(sink.arena), msg_len + 1, 1);
    let mut i: usize = 0;
    if is_uninit {
        while (i < 35) {
            unsafe { *(buf + i) = OWN_MSG_UNINIT[i]; }
            i = i + 1;
        }
    } else {
        while (i < 18) {
            unsafe { *(buf + i) = OWN_MSG_MOVED[i]; }
            i = i + 1;
        }
    }
    unsafe { *(buf + msg_len) = 0u8; }

    let mut labels_ptr: *mut DiagLabel = 0 as *mut DiagLabel;
    let mut label_cnt: usize = 0;
    if has_move_lbl {
        let lbuf = arena_alloc_raw(mut_view(sink.arena), 11, 1);
        let mut li: usize = 0;
        while (li < 10) {
            unsafe { *(lbuf + li) = OWN_LBL_MOVED_HERE[li]; }
            li = li + 1;
        }
        unsafe { *(lbuf + 10) = 0u8; }
        let lraw = arena_alloc_raw(mut_view(sink.arena), size_of<DiagLabel>(), align_of<DiagLabel>());
        labels_ptr = lraw as *mut DiagLabel;
        unsafe {
            (*labels_ptr).span.file.v = move_loc.file.v;
            (*labels_ptr).span.start = move_loc.start;
            (*labels_ptr).span.end = move_loc.end;
            (*labels_ptr).message.ptr = lbuf as *const u8;
            (*labels_ptr).message.len = 10;
        }
        label_cnt = 1;
    }

    let d = Diagnostic {
        code: DiagCode { v: code_v },
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf as *const u8, len: msg_len },
        primary: Span { file: FileId { v: loc.file.v }, start: loc.start, end: loc.end },
        labels: labels_ptr,
        label_count: label_cnt,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

// T498b: the path-tree node of `place`. Resolution stops at the first INDEX/SUB_SLICE projection:
// array elements are not tracked separately (element-level tracking is post-v1, REQ-OWN-049), so
// `hs[i].f` resolves to the node of `hs` and never to a field node of `hs` (`hs.f`).
fn own_resolve_node(ctx: view<PathCtx>, place: view<MirPlace>) -> u32 {
    let lv = place.local.v as usize;
    if lv >= ctx.local_count {
        return 0u32;
    }
    let mut node = unsafe { *own_u32_at(ctx.local_roots as *const u32, lv) };
    let mut i: usize = 0;
    while i < place.proj_count {
        let pr = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_INDEX || pk == MIR_PROJ_SUB_SLICE || pk == MIR_PROJ_DEREF {
            return node;
        }
        if pk == MIR_PROJ_FIELD || pk == MIR_PROJ_DOWNCAST {
            let f = if pk == MIR_PROJ_DOWNCAST { unsafe { (*pr).variant_idx } } else { unsafe { (*pr).field_idx } };
            node = path_child(ctx, node, pk, f);
        }
        i = i + 1;
    }
    node
}

// T498b: true when `place` reaches an array/slice element (an INDEX or SUB_SLICE projection before
// any DEREF).
fn own_place_indexed(place: view<MirPlace>) -> bool {
    let mut i: usize = 0;
    while i < place.proj_count {
        let pr = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_DEREF {
            return false;
        }
        if pk == MIR_PROJ_INDEX || pk == MIR_PROJ_SUB_SLICE {
            return true;
        }
        i = i + 1;
    }
    false
}

// T498b: the type of `place`, following its projections (as `mir_drop_place_type`); 0 when a step
// is not known.
fn own_place_type(body: view<MirBody>, thir: view<Thir>, place: view<MirPlace>) -> TypeId {
    if (place.local.v as usize) >= body.local_count {
        return TypeId { v: 0u32 };
    }
    let decl = unsafe { mir_local_at(body.locals, place.local.v as usize) };
    let mut cur: u32 = unsafe { (*decl).ty.v };
    let mut i: usize = 0;
    while i < place.proj_count {
        if cur == 0u32 || (cur as usize) > thir.interner.len {
            return TypeId { v: 0u32 };
        }
        let t = type_get(view(thir.interner), TypeId { v: cur });
        if (t as usize) == 0 {
            return TypeId { v: 0u32 };
        }
        let kind = unsafe { (*t).kind };
        let pr = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*pr).kind };
        let mut next: u32 = 0u32;
        if pk == MIR_PROJ_DEREF {
            next = unsafe { (*t).pointee.v };
        } else if pk == MIR_PROJ_FIELD {
            let fi = (unsafe { (*pr).field_idx }) as usize;
            if (kind == TY_STRUCT || kind == TY_TUPLE) && fi < (unsafe { (*t).field_count }) {
                next = unsafe { (*typeid_at((*t).fields, fi)).v };
            }
        } else if pk == MIR_PROJ_INDEX {
            if kind == TY_ARRAY || kind == TY_SLICE {
                next = unsafe { (*t).elem.v };
            }
        } else if pk == MIR_PROJ_SUB_SLICE {
            next = cur;
        } else if pk == MIR_PROJ_DOWNCAST {
            // A downcast keeps the enum; the FIELD that follows reads the variant's payload field.
            if kind == TY_ENUM && i + 1 < place.proj_count {
                let nx = unsafe { mir_proj_at(place.projs, i + 1) };
                if (unsafe { (*nx).kind }) == MIR_PROJ_FIELD {
                    let vi = (unsafe { (*pr).variant_idx }) as usize;
                    let fi = (unsafe { (*nx).field_idx }) as usize;
                    if vi < (unsafe { (*t).variant_count }) && (unsafe { (*t).variant_field_counts as usize }) != 0 {
                        let fc = unsafe { *usize_at((*t).variant_field_counts, vi) };
                        if fi < fc {
                            let vf = unsafe { *typeid_ptr_at((*t).variant_fields, vi) };
                            next = unsafe { (*typeid_at(vf, fi)).v };
                            i = i + 1;
                        }
                    }
                }
            }
        }
        cur = next;
        i = i + 1;
    }
    TypeId { v: cur }
}

// T498b: a COPY/MOVE operand whose place goes through an array index and whose value is Copy
// (`hs[i].f` with `f: i32`, a `fn` pointer, `[2]u8`, a view...) only reads the array: it checks
// that the array is initialised and not moved, and moves nothing. The MIR builder emits COPY for
// every type except `str` and non-Copy arrays (structs are moved with COPY too), so the operand kind
// alone cannot decide; the projected type does. A non-Copy element or field moved out through an
// index still moves (marks) the whole array.
fn own_operand_is_indexed_copy_read(
    body: *const MirBody,
    thir: *const Thir,
    str_in: *const StrInterner,
    op: view<MirOperand>
) -> bool {
    if (body as usize) == 0 || (thir as usize) == 0 || (str_in as usize) == 0 {
        return false;
    }
    if !own_place_indexed(view(op.place)) {
        return false;
    }
    let ty = unsafe { own_place_type(view(*body), view(*thir), view(op.place)) };
    if ty.v == 0u32 {
        return false;
    }
    unsafe { type_is_copy(TypeId { v: ty.v }, view(*thir), view(*str_in)) }
}

pub fn own_check_use(v: mut_view<OwnVisitor>, place: view<MirPlace>, loc: Span) {
    let mut base = mir_place_local(MirLocalId { v: 0u32 });
    truncate_at_deref(place, mut_view(base));
    let node = unsafe { own_resolve_node(view(*v.ctx), view(base)) };
    let st_p = unsafe { own_state_at(v.state as *const OwnStateInfo, node as usize) };
    let st = unsafe { (*st_p).state };
    if st != OWN_OWNED && v.report {
        let m_fv = unsafe { (*st_p).move_loc.file.v };
        let m_st = unsafe { (*st_p).move_loc.start };
        let m_en = unsafe { (*st_p).move_loc.end };
        let is_uninit = (st == OWN_UNINIT) || (st == OWN_PARTIAL && m_fv == 0u32);
        let has_lbl = (st == OWN_MOVED || (st == OWN_PARTIAL && m_fv != 0u32)) && !is_uninit;
        let mloc = Span { file: FileId { v: m_fv }, start: m_st, end: m_en };
        unsafe {
            emit_own_diag(mut_view(*v.sink), is_uninit, loc, has_lbl, mloc);
        }
    }
}

fn own_local_is_static_or_tls(body: *const MirBody, loc_v: u32) -> bool {
    if (body as usize) == 0 || (loc_v as usize) >= (unsafe { (*body).local_count }) {
        return false;
    }
    let lk = unsafe { (*mir_local_at((*body).locals, loc_v as usize)).kind };
    lk == MIR_LOCAL_STATIC || lk == MIR_LOCAL_TLS
}

pub fn own_do_move(v: mut_view<OwnVisitor>, place: view<MirPlace>, loc: Span) {
    let mut base = mir_place_local(MirLocalId { v: 0u32 });
    let had_deref = truncate_at_deref(place, mut_view(base));
    if had_deref {
        own_check_use(v, view(base), loc);
        return;
    }
    let node = unsafe { own_resolve_node(view(*v.ctx), place) };
    let np = unsafe { path_node_at((*v.ctx).nodes as *const PathNode, node as usize) };
    let is_cp = unsafe { (*np).is_copy };
    if !is_cp {
        if own_local_is_static_or_tls(v.body, place.local.v) {
            if v.report {
                let zloc = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
                unsafe {
                    emit_own_diag(mut_view(*v.sink), false, loc, false, zloc);
                }
            }
            return;
        }
        unsafe {
            mark_state(v.state, view(*v.ctx), node, OWN_MOVED, loc);
            update_parent(v.state, view(*v.ctx), node);
        }
    }
}

// T498e (SPEC-10 AXS-OWN-006): a write through an index (`a[i] = v`, `a[i].f = v`, `a[i][j] = v`)
// never reinitialises anything — elements are not tracked (REQ-OWN-049) — so it is checked like a
// read of the array place (moved/partial → AX_MOVE_USE_AFTER_MOVE, uninit → AX_INIT_USE_UNINIT) and
// marks no node. Only a whole assignment `a = [...]` reinitialises the array.
pub fn own_do_assign(v: mut_view<OwnVisitor>, place: view<MirPlace>, loc: Span) {
    let mut base = mir_place_local(MirLocalId { v: 0u32 });
    let had_deref = truncate_at_deref(place, mut_view(base));
    if had_deref || own_place_indexed(place) {
        own_check_use(v, view(base), loc);
        return;
    }
    let node = unsafe { own_resolve_node(view(*v.ctx), place) };
    unsafe {
        mark_state(v.state, view(*v.ctx), node, OWN_OWNED, loc);
        update_parent(v.state, view(*v.ctx), node);
    }
}

// T498e: a non-explicit DROP of a place reached through an index (before any deref). Before drop
// elaboration the MIR builder emits it only for an assignment `a[i] = v` of a type that needs drop
// (SPEC-03 AXS-SEM-043: drop the old value, then store); an explicit `drop(a[i])` still moves the
// element out (and with it the whole array, REQ-OWN-049).
fn own_drop_replaces_element(t: view<MirTerminator>) -> bool {
    !t.drop_is_explicit && own_place_indexed(view(t.drop_place))
}

fn own_span_copy(s: view<Span>) -> Span {
    Span { file: FileId { v: s.file.v }, start: s.start, end: s.end }
}

pub fn own_visit_operand(v: mut_view<OwnVisitor>, op: view<MirOperand>, loc: Span) {
    let op_loc = if op.location.file.v != 0u32 {
        Span { file: FileId { v: op.location.file.v }, start: op.location.start, end: op.location.end }
    } else {
        loc
    };
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        own_check_use(mut_view(*v), view(op.place), own_span_copy(view(op_loc)));
        if own_operand_is_indexed_copy_read(v.body, v.thir, v.str_in, op) {
            return;
        }
        own_do_move(v, view(op.place), op_loc);
    }
}

pub fn own_visit_rvalue(v: mut_view<OwnVisitor>, rv: view<MirRvalue>, loc: Span) {
    let k = rv.kind;
    if k == MIR_RVALUE_USE {
        own_visit_operand(v, view(rv.use_op), loc);
    } else if k == MIR_RVALUE_REPEAT {
        own_visit_operand(v, view(rv.use_op), loc);
    } else if k == MIR_RVALUE_REF {
        own_check_use(mut_view(*v), view(rv.place), loc);
        if (v.cap_tracker as usize) != 0 && (v.cap_arena as usize) != 0 {
            let vk = if rv.borrow_kind == MIR_BORROW_MUT { MIR_VIEW_MUT } else { MIR_VIEW_READ };
            unsafe {
                mir_cap_tracker_add(mut_view(*v.cap_tracker), mut_view(*v.cap_arena), view(rv.place), vk);
            }
        }
    } else if k == MIR_RVALUE_LEN {
        own_check_use(v, view(rv.place), loc);
    } else if k == MIR_RVALUE_CAST {
        own_visit_operand(v, view(rv.use_op), loc);
    } else if k == MIR_RVALUE_BINARY_OP || k == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        own_visit_operand(mut_view(*v), view(rv.lhs), own_span_copy(view(loc)));
        own_visit_operand(v, view(rv.rhs), loc);
    } else if k == MIR_RVALUE_UNARY_OP {
        own_visit_operand(v, view(rv.use_op), loc);
    } else if k == MIR_RVALUE_DISCRIMINANT {
        own_check_use(v, view(rv.place), loc);
    } else if k == MIR_RVALUE_AGGREGATE {
        let mut i: usize = 0;
        while (i < rv.operand_count) {
            let op = unsafe { mir_op_at(rv.operands, i) };
            unsafe {
                own_visit_operand(mut_view(*v), view(*op), own_span_copy(view(loc)));
            }
            i = i + 1;
        }
    }
}

pub fn own_visit_stmt(v: mut_view<OwnVisitor>, stmt: view<MirStmt>) {
    let sk = stmt.kind;
    let loc = Span { file: FileId { v: stmt.location.file.v }, start: stmt.location.start, end: stmt.location.end };
    if sk == MIR_STMT_ASSIGN {
        own_visit_rvalue(mut_view(*v), view(stmt.rvalue), own_span_copy(view(loc)));
        own_do_assign(v, view(stmt.place), loc);
    } else if sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD {
        // handled by assignment/drop
    } else if sk == MIR_STMT_DROP {
        own_check_use(mut_view(*v), view(stmt.place), own_span_copy(view(loc)));
        own_do_move(v, view(stmt.place), loc);
    }
}

pub fn own_visit_bb(v: mut_view<OwnVisitor>, bb: view<MirBb>) {
    let mut i: usize = 0;
    while (i < bb.stmt_count) {
        let st = unsafe { mir_stmt_at(bb.stmts, i) };
        unsafe {
            own_visit_stmt(mut_view(*v), view(*st));
        }
        i = i + 1;
    }
    if !bb.has_terminator {
        return;
    }
    let tk = bb.terminator.kind;
    let loc = Span {
        file: FileId { v: bb.terminator.location.file.v },
        start: bb.terminator.location.start,
        end: bb.terminator.location.end,
    };
    if tk == MIR_TERM_SWITCH_INT {
        own_visit_operand(v, view(bb.terminator.discr), loc);
    } else if tk == MIR_TERM_DROP {
        if own_drop_replaces_element(view(bb.terminator)) {
            // T498e: the drop of the old element before `a[i] = v` replaces it in place; the array
            // must be OWNED and stays OWNED (AXS-OWN-006).
            own_check_use(v, view(bb.terminator.drop_place), loc);
            return;
        }
        if bb.terminator.expected {
            own_check_use(mut_view(*v), view(bb.terminator.drop_place), own_span_copy(view(loc)));
        }
        own_do_move(v, view(bb.terminator.drop_place), loc);
    } else if tk == MIR_TERM_CALL {
        let mut moves_callee = true;
        let fk = bb.terminator.func.kind;
        if fk == MIR_OP_COPY || fk == MIR_OP_MOVE {
            let flocal = bb.terminator.func.place.local.v as usize;
            let body_lcount = unsafe { (*v.body).local_count };
            if flocal < body_lcount && (v.thir as usize) != 0 {
                let ldecl = unsafe { mir_local_at((*v.body).locals, flocal) };
                let cty_v = unsafe { (*ldecl).ty.v };
                let t = unsafe { type_get(view((*v.thir).interner), TypeId { v: cty_v }) };
                if (t as usize) != 0 {
                    let t_kind = unsafe { (*t).kind };
                    if t_kind == TY_CLOSURE {
                        let mut has_move = false;
                        let cap_cnt = unsafe { (*t).capture_count };
                        let caps = unsafe { (*t).captures };
                        let mut ci: usize = 0;
                        while (ci < cap_cnt) {
                            let cp = unsafe { closure_cap_at(caps as *const ClosureCapture, ci) };
                            if (unsafe { (*cp).mode }) == CAP_MOVE {
                                has_move = true;
                                break;
                            }
                            ci = ci + 1;
                        }
                        if !has_move {
                            moves_callee = false;
                        }
                    } else if t_kind == TY_PARAM {
                        moves_callee = false;
                    }
                }
            }
        }
        if moves_callee {
            own_visit_operand(mut_view(*v), view(bb.terminator.func), own_span_copy(view(loc)));
        } else {
            own_check_use(mut_view(*v), view(bb.terminator.func.place), own_span_copy(view(loc)));
        }
        let mut a: usize = 0;
        while (a < bb.terminator.arg_count) {
            let arg_op = unsafe { mir_op_at(bb.terminator.args, a) };
            unsafe {
                own_visit_operand(mut_view(*v), view(*arg_op), own_span_copy(view(loc)));
            }
            a = a + 1;
        }
        own_do_assign(v, view(bb.terminator.destination), loc);
    } else if tk == MIR_TERM_SUSPEND {
        // `.await`: the awaited future (`drop_place`) is consumed, the result lands in `destination`.
        own_check_use(mut_view(*v), view(bb.terminator.drop_place), own_span_copy(view(loc)));
        own_do_move(mut_view(*v), view(bb.terminator.drop_place), own_span_copy(view(loc)));
        own_do_assign(v, view(bb.terminator.destination), loc);
    } else if tk == MIR_TERM_ASSERT {
        own_visit_operand(v, view(bb.terminator.cond), loc);
    } else if tk == MIR_TERM_RETURN {
        let mut needs_check = true;
        let body_lcount = unsafe { (*v.body).local_count };
        if body_lcount > 0 && (v.thir as usize) != 0 {
            let ldecl0 = unsafe { mir_local_at((*v.body).locals, 0) };
            let rty_v = unsafe { (*ldecl0).ty.v };
            let rty = unsafe { type_get(view((*v.thir).interner), TypeId { v: rty_v }) };
            if (rty as usize) != 0 {
                let rtk = unsafe { (*rty).kind };
                if rtk == TY_UNIT || rtk == TY_NEVER {
                    needs_check = false;
                }
            }
        }
        if needs_check {
            let ret_place = mir_place_local(MirLocalId { v: 0u32 });
            own_check_use(v, view(ret_place), loc);
        }
    }
}

fn copy_own_states(dst: *mut OwnStateInfo, src: *const OwnStateInfo, count: usize) {
    unsafe {
        ptr_copy_nonoverlapping<u8>(src as *const u8, dst as *mut u8, mul_usize(count, size_of<OwnStateInfo>()));
    }
}

unsafe fn own_u64_at(base: *const u64, idx: usize) -> *const u64 {
    ((base as usize) + (idx << 3usize)) as *const u64
}

unsafe fn own_u64_at_mut(base: *mut u64, idx: usize) -> *mut u64 {
    ((base as usize) + (idx << 3usize)) as *mut u64
}

fn own_bit_test(bits: *const u64, node: usize) -> bool {
    let w = unsafe { *own_u64_at(bits, node >> 6usize) };
    (w & (1u64 << ((node & 63usize) as u64))) != 0u64
}

fn own_bit_set(bits: *mut u64, node: usize) {
    let wp = unsafe { own_u64_at_mut(bits, node >> 6usize) };
    unsafe { *wp = (*wp) | (1u64 << ((node & 63usize) as u64)); }
}

fn own_bit_clear(bits: *mut u64, node: usize) {
    let wp = unsafe { own_u64_at_mut(bits, node >> 6usize) };
    unsafe { *wp = (*wp) & (~(1u64 << ((node & 63usize) as u64))); }
}

fn own_bits_copy(dst: *mut u64, src: *const u64, words: usize) {
    let mut w: usize = 0;
    while w < words {
        unsafe { *own_u64_at_mut(dst, w) = *own_u64_at(src, w); }
        w = w + 1;
    }
}

fn own_bits_merge(dst: *mut u64, src: *const u64, words: usize) -> bool {
    let mut changed = false;
    let mut w: usize = 0;
    while w < words {
        let dw = unsafe { *own_u64_at(dst as *const u64, w) };
        let sw = unsafe { *own_u64_at(src, w) };
        let nw = dw & sw;
        if nw != dw {
            unsafe { *own_u64_at_mut(dst, w) = nw; }
            changed = true;
        }
        w = w + 1;
    }
    changed
}

fn own_bits_mark(bits: *mut u64, ctx: view<PathCtx>, node: u32, is_owned: bool) {
    if is_owned {
        own_bit_set(bits, node as usize);
    } else {
        own_bit_clear(bits, node as usize);
    }
    let np = unsafe { path_node_at(ctx.nodes as *const PathNode, node as usize) };
    let nchild = unsafe { (*np).num_children };
    if nchild > 0u32 {
        let fchild = unsafe { (*np).first_child };
        let mut i: u32 = 0u32;
        while i < nchild {
            own_bits_mark(bits, ctx, fchild + i, is_owned);
            i = i + 1u32;
        }
    }
}

fn own_bits_update_parent(bits: *mut u64, ctx: view<PathCtx>, node: u32) {
    let mut cur = node;
    while true {
        let np = unsafe { path_node_at(ctx.nodes as *const PathNode, cur as usize) };
        let p = unsafe { (*np).parent };
        if p == OWN_NODE_NONE {
            return;
        }
        let pnp = unsafe { path_node_at(ctx.nodes as *const PathNode, p as usize) };
        let nchild = unsafe { (*pnp).num_children };
        let fchild = unsafe { (*pnp).first_child };
        let mut all_init = true;
        let mut i: u32 = 0u32;
        while i < nchild {
            if !own_bit_test(bits as *const u64, (fchild + i) as usize) {
                all_init = false;
                break;
            }
            i = i + 1u32;
        }
        if all_init {
            own_bit_set(bits, p as usize);
        } else {
            own_bit_clear(bits, p as usize);
        }
        cur = p;
    }
}

fn own_bits_resolve(ctx: view<PathCtx>, place: view<MirPlace>, out_had_deref: mut_view<bool>) -> u32 {
    *out_had_deref = false;
    let lv = place.local.v as usize;
    if lv >= ctx.local_count {
        return 0u32;
    }
    let mut node = unsafe { *own_u32_at(ctx.local_roots as *const u32, lv) };
    if place.proj_count == 0 {
        return node;
    }
    // T498b: after an INDEX/SUB_SLICE the node stays the array's (REQ-OWN-049: no element-level
    // tracking); a later DEREF is still reported through `out_had_deref`.
    let mut indexed = false;
    let mut i: usize = 0;
    while i < place.proj_count {
        let pr = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*pr).kind };
        if pk == MIR_PROJ_DEREF {
            *out_had_deref = true;
            return node;
        }
        if pk == MIR_PROJ_INDEX || pk == MIR_PROJ_SUB_SLICE {
            indexed = true;
        }
        if !indexed && (pk == MIR_PROJ_FIELD || pk == MIR_PROJ_DOWNCAST) {
            let f = if pk == MIR_PROJ_DOWNCAST { unsafe { (*pr).variant_idx } } else { unsafe { (*pr).field_idx } };
            node = path_child(ctx, node, pk, f);
        }
        i = i + 1;
    }
    node
}

fn own_bits_check_use(bits: *const u64, ctx: view<PathCtx>, place: view<MirPlace>, check_errors: bool, found_error: mut_view<bool>) {
    if !check_errors || (*found_error) {
        return;
    }
    let mut had_deref = false;
    let node = own_bits_resolve(ctx, place, mut_view(had_deref));
    if !own_bit_test(bits, node as usize) {
        *found_error = true;
    }
}

fn own_bits_do_move(bits: *mut u64, ctx: view<PathCtx>, body: *const MirBody, place: view<MirPlace>, check_errors: bool, found_error: mut_view<bool>) {
    let mut had_deref = false;
    let node = own_bits_resolve(ctx, place, mut_view(had_deref));
    if had_deref {
        if check_errors && !(*found_error) && !own_bit_test(bits as *const u64, node as usize) {
            *found_error = true;
        }
        return;
    }
    let np = unsafe { path_node_at(ctx.nodes as *const PathNode, node as usize) };
    if !(unsafe { (*np).is_copy }) {
        if own_local_is_static_or_tls(body, place.local.v) {
            if check_errors {
                *found_error = true;
            }
            return;
        }
        own_bits_mark(bits, ctx, node, false);
        if (unsafe { (*np).parent }) != OWN_NODE_NONE {
            own_bits_update_parent(bits, ctx, node);
        }
    }
}

fn own_bits_do_assign(bits: *mut u64, ctx: view<PathCtx>, place: view<MirPlace>, check_errors: bool, found_error: mut_view<bool>) {
    let mut had_deref = false;
    let node = own_bits_resolve(ctx, place, mut_view(had_deref));
    // T498e: an indexed write only reads the array (AXS-OWN-006), as `own_do_assign`.
    if had_deref || own_place_indexed(place) {
        if check_errors && !(*found_error) && !own_bit_test(bits as *const u64, node as usize) {
            *found_error = true;
        }
        return;
    }
    let np = unsafe { path_node_at(ctx.nodes as *const PathNode, node as usize) };
    if (unsafe { (*np).num_children }) == 0u32 && (unsafe { (*np).parent }) == OWN_NODE_NONE {
        own_bit_set(bits, node as usize);
        return;
    }
    own_bits_mark(bits, ctx, node, true);
    if (unsafe { (*np).parent }) != OWN_NODE_NONE {
        own_bits_update_parent(bits, ctx, node);
    }
}

fn own_bits_use_and_move(bits: *mut u64, ctx: view<PathCtx>, body: *const MirBody, place: view<MirPlace>, check_errors: bool, found_error: mut_view<bool>) {
    let mut had_deref = false;
    let node = own_bits_resolve(ctx, place, mut_view(had_deref));
    if check_errors && !(*found_error) && !own_bit_test(bits as *const u64, node as usize) {
        *found_error = true;
    }
    if had_deref {
        return;
    }
    let np = unsafe { path_node_at(ctx.nodes as *const PathNode, node as usize) };
    if !(unsafe { (*np).is_copy }) {
        if own_local_is_static_or_tls(body, place.local.v) {
            if check_errors {
                *found_error = true;
            }
            return;
        }
        own_bits_mark(bits, ctx, node, false);
        if (unsafe { (*np).parent }) != OWN_NODE_NONE {
            own_bits_update_parent(bits, ctx, node);
        }
    }
}

// T498b: what the 1-bit solver needs to type a place read through an array index.
struct OwnTyEnv {
    body: *const MirBody,
    thir: *const Thir,
    str_in: *const StrInterner,
}

fn own_bits_visit_operand(bits: *mut u64, ctx: view<PathCtx>, env: view<OwnTyEnv>, op: view<MirOperand>, check_errors: bool, found_error: mut_view<bool>) {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        if own_operand_is_indexed_copy_read(env.body, env.thir, env.str_in, op) {
            own_bits_check_use(bits as *const u64, ctx, view(op.place), check_errors, found_error);
            return;
        }
        own_bits_use_and_move(bits, ctx, env.body, view(op.place), check_errors, found_error);
    }
}

fn own_bits_visit_rvalue(bits: *mut u64, ctx: view<PathCtx>, env: view<OwnTyEnv>, rv: view<MirRvalue>, check_errors: bool, found_error: mut_view<bool>) {
    let k = rv.kind;
    if k == MIR_RVALUE_USE || k == MIR_RVALUE_REPEAT || k == MIR_RVALUE_CAST || k == MIR_RVALUE_UNARY_OP {
        own_bits_visit_operand(bits, ctx, env, view(rv.use_op), check_errors, found_error);
    } else if k == MIR_RVALUE_REF || k == MIR_RVALUE_LEN || k == MIR_RVALUE_DISCRIMINANT {
        if check_errors {
            own_bits_check_use(bits as *const u64, ctx, view(rv.place), true, found_error);
        }
    } else if k == MIR_RVALUE_BINARY_OP || k == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        own_bits_visit_operand(bits, ctx, env, view(rv.lhs), check_errors, mut_view(*found_error));
        own_bits_visit_operand(bits, ctx, env, view(rv.rhs), check_errors, found_error);
    } else if k == MIR_RVALUE_AGGREGATE {
        let mut i: usize = 0;
        while i < rv.operand_count {
            let op = unsafe { mir_op_at(rv.operands, i) };
            unsafe {
                own_bits_visit_operand(bits, ctx, env, view(*op), check_errors, mut_view(*found_error));
            }
            i = i + 1;
        }
    }
}

fn own_bits_visit_bb(
    bits: *mut u64,
    ctx: view<PathCtx>,
    body: view<MirBody>,
    thir: view<Thir>,
    env: view<OwnTyEnv>,
    bb: view<MirBb>,
    ret_needs_check: bool,
    check_errors: bool,
    found_error: mut_view<bool>
) {
    let mut i: usize = 0;
    while i < bb.stmt_count {
        let st = unsafe { mir_stmt_at(bb.stmts, i) };
        let sk = unsafe { (*st).kind };
        if sk == MIR_STMT_ASSIGN {
            unsafe {
                own_bits_visit_rvalue(bits, ctx, env, view((*st).rvalue), check_errors, mut_view(*found_error));
                own_bits_do_assign(bits, ctx, view((*st).place), check_errors, mut_view(*found_error));
            }
        } else if sk == MIR_STMT_DROP {
            unsafe {
                own_bits_use_and_move(bits, ctx, env.body, view((*st).place), check_errors, mut_view(*found_error));
            }
        }
        i = i + 1;
    }
    if !bb.has_terminator {
        return;
    }
    let tk = bb.terminator.kind;
    if tk == MIR_TERM_SWITCH_INT {
        own_bits_visit_operand(bits, ctx, env, view(bb.terminator.discr), check_errors, found_error);
    } else if tk == MIR_TERM_DROP {
        if own_drop_replaces_element(view(bb.terminator)) {
            own_bits_check_use(bits as *const u64, ctx, view(bb.terminator.drop_place), check_errors, found_error);
        } else if bb.terminator.expected {
            own_bits_use_and_move(bits, ctx, env.body, view(bb.terminator.drop_place), check_errors, found_error);
        } else {
            own_bits_do_move(bits, ctx, env.body, view(bb.terminator.drop_place), check_errors, found_error);
        }
    } else if tk == MIR_TERM_CALL {
        let mut moves_callee = true;
        let fk = bb.terminator.func.kind;
        if fk == MIR_OP_COPY || fk == MIR_OP_MOVE {
            let flocal = bb.terminator.func.place.local.v as usize;
            if flocal < body.local_count {
                let ldecl = unsafe { mir_local_at(body.locals, flocal) };
                let cty_v = unsafe { (*ldecl).ty.v };
                let t = type_get(view(thir.interner), TypeId { v: cty_v });
                if (t as usize) != 0 {
                    let t_kind = unsafe { (*t).kind };
                    if t_kind == TY_CLOSURE {
                        let mut has_move = false;
                        let cap_cnt = unsafe { (*t).capture_count };
                        let caps = unsafe { (*t).captures };
                        let mut ci: usize = 0;
                        while ci < cap_cnt {
                            let cp = unsafe { closure_cap_at(caps as *const ClosureCapture, ci) };
                            if (unsafe { (*cp).mode }) == CAP_MOVE {
                                has_move = true;
                                break;
                            }
                            ci = ci + 1;
                        }
                        if !has_move {
                            moves_callee = false;
                        }
                    } else if t_kind == TY_PARAM {
                        moves_callee = false;
                    }
                }
            }
        }
        if moves_callee {
            own_bits_visit_operand(bits, ctx, env, view(bb.terminator.func), check_errors, mut_view(*found_error));
        } else {
            own_bits_check_use(bits as *const u64, ctx, view(bb.terminator.func.place), check_errors, mut_view(*found_error));
        }
        let mut a: usize = 0;
        while a < bb.terminator.arg_count {
            let arg_op = unsafe { mir_op_at(bb.terminator.args, a) };
            unsafe {
                own_bits_visit_operand(bits, ctx, env, view(*arg_op), check_errors, mut_view(*found_error));
            }
            a = a + 1;
        }
        own_bits_do_assign(bits, ctx, view(bb.terminator.destination), check_errors, found_error);
    } else if tk == MIR_TERM_SUSPEND {
        own_bits_use_and_move(bits, ctx, env.body, view(bb.terminator.drop_place), check_errors, mut_view(*found_error));
        own_bits_do_assign(bits, ctx, view(bb.terminator.destination), check_errors, found_error);
    } else if tk == MIR_TERM_ASSERT {
        own_bits_visit_operand(bits, ctx, env, view(bb.terminator.cond), check_errors, found_error);
    } else if tk == MIR_TERM_RETURN {
        if ret_needs_check && check_errors && !(*found_error) {
            let rnode = if ctx.local_count > 0 {
                unsafe { *own_u32_at(ctx.local_roots as *const u32, 0) }
            } else {
                0u32
            };
            if !own_bit_test(bits as *const u64, rnode as usize) {
                *found_error = true;
            }
        }
    }
}

fn own_term_successors(t: view<MirTerminator>, out: mut_view<[16]u32>) -> usize {
    let tk = t.kind;
    let mut n: usize = 0;
    if tk == MIR_TERM_GOTO {
        (*out)[n] = t.goto_target.v;
        n = n + 1;
    } else if tk == MIR_TERM_SWITCH_INT {
        let mut sj: usize = 0;
        while sj < t.switch_count && n < 15 {
            let tid = unsafe { (*mir_bb_id_at(t.targets, sj)).v };
            (*out)[n] = tid;
            n = n + 1;
            sj = sj + 1;
        }
        if n < 16 {
            (*out)[n] = t.otherwise.v;
            n = n + 1;
        }
    } else if tk == MIR_TERM_DROP {
        (*out)[n] = t.drop_target.v;
        n = n + 1;
    } else if tk == MIR_TERM_CALL {
        (*out)[n] = t.call_target.v;
        n = n + 1;
    } else if tk == MIR_TERM_SUSPEND {
        (*out)[n] = t.call_target.v;
        n = n + 1;
    } else if tk == MIR_TERM_ASSERT {
        (*out)[n] = t.assert_target.v;
        n = n + 1;
    }
    n
}

fn own_compute_rpo(body: view<MirBody>, rpo_post: *mut u32, rpo_pos: *mut u32) -> usize {
    let bb_count = body.bb_count;
    let vis = unsafe { heap_alloc(bb_count, 1) };
    let bb4 = bb_count << 2usize;
    let stack_bb = unsafe { heap_alloc(bb4, 4) } as *mut u32;
    let stack_ei = unsafe { heap_alloc(bb4, 4) } as *mut u32;
    let mut k: usize = 0;
    while k < bb_count {
        unsafe {
            *(vis + k) = 0u8;
            *own_u32_at_mut(rpo_pos, k) = OWN_NODE_NONE;
        }
        k = k + 1;
    }
    unsafe {
        *vis = 1u8;
        *own_u32_at_mut(stack_bb, 0) = 0u32;
        *own_u32_at_mut(stack_ei, 0) = 0u32;
    }
    let mut sp: usize = 1;
    let mut post_len: usize = 0;
    let mut targets: [16]u32 = [0u32; 16];
    while sp > 0 {
        let top = sp - 1;
        let u = (unsafe { *own_u32_at(stack_bb as *const u32, top) }) as usize;
        let ei = (unsafe { *own_u32_at(stack_ei as *const u32, top) }) as usize;
        let bb_p = unsafe { mir_bb_at(body.bbs, u) };
        let tcnt = if unsafe { (*bb_p).has_terminator } {
            unsafe { own_term_successors(view((*bb_p).terminator), mut_view(targets)) }
        } else {
            0
        };
        if ei < tcnt {
            unsafe { *own_u32_at_mut(stack_ei, top) = (ei + 1) as u32; }
            let v = targets[ei] as usize;
            if v < bb_count && (unsafe { *(vis + v) }) == 0u8 {
                unsafe {
                    *(vis + v) = 1u8;
                    *own_u32_at_mut(stack_bb, sp) = v as u32;
                    *own_u32_at_mut(stack_ei, sp) = 0u32;
                }
                sp = sp + 1;
            }
        } else {
            sp = sp - 1;
            unsafe { *own_u32_at_mut(rpo_post, post_len) = u as u32; }
            post_len = post_len + 1;
        }
    }
    k = 0;
    while k < post_len {
        let u = (unsafe { *own_u32_at(rpo_post as *const u32, post_len - 1 - k) }) as usize;
        unsafe { *own_u32_at_mut(rpo_pos, u) = k as u32; }
        k = k + 1;
    }
    unsafe {
        heap_free(vis, bb_count, 1);
        heap_free(stack_bb as *mut u8, bb4, 4);
        heap_free(stack_ei as *mut u8, bb4, 4);
    }
    post_len
}

// Exact full 4-state OwnStateInfo solver (with `move_loc` span tracking), invoked ONLY when the
// 1-bit fast path proves an ownership or definite-init violation exists in `body`.
fn own_check_exact_fallback(
    body: mut_view<MirBody>,
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    ctx: *const PathCtx,
    arg_count: usize,
    rpo_post: *const u32,
    rpo_pos: *const u32,
    rpo_len: usize,
    str_in: *const StrInterner
) {
    let bb_count = body.bb_count;
    let ctx_cnt = unsafe { (*ctx).count };
    let node_count = if ctx_cnt > 0 { ctx_cnt } else { 1 };
    let total_cells = mul_usize(bb_count + 1, node_count);
    let all_bytes = mul_usize(total_cells, size_of<OwnStateInfo>());
    let all_rows = unsafe { heap_alloc(all_bytes, align_of<OwnStateInfo>()) } as *mut OwnStateInfo;

    let mut j: usize = 0;
    while j < ctx_cnt {
        let cell = unsafe { own_state_at_mut(all_rows, j) };
        unsafe {
            (*cell).state = OWN_UNINIT;
            (*cell).move_loc.file.v = 0u32;
            (*cell).move_loc.start = 0u32;
            (*cell).move_loc.end = 0u32;
        }
        j = j + 1;
    }

    let zero_loc = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    let lroots = unsafe { (*ctx).local_roots as *const u32 };
    let mut ai: usize = 0;
    while ai < arg_count {
        if ai + 1 < body.local_count {
            let root_idx = unsafe { *own_u32_at(lroots, ai + 1) };
            unsafe { mark_state(all_rows, view(*ctx), root_idx, OWN_OWNED, own_span_copy(view(zero_loc))); }
        }
        ai = ai + 1;
    }
    ai = 0;
    while ai < body.local_count {
        let ldecl = unsafe { mir_local_at(body.locals, ai) };
        let lk = unsafe { (*ldecl).kind };
        if lk == MIR_LOCAL_ARG || lk == MIR_LOCAL_CONST || lk == MIR_LOCAL_STATIC || lk == MIR_LOCAL_TLS {
            let root_idx = unsafe { *own_u32_at(lroots, ai) };
            unsafe { mark_state(all_rows, view(*ctx), root_idx, OWN_OWNED, own_span_copy(view(zero_loc))); }
        }
        ai = ai + 1;
    }

    let visited = unsafe { heap_alloc(bb_count, 1) };
    let mut vi: usize = 0;
    while vi < bb_count {
        unsafe { *(visited + vi) = 0u8; }
        vi = vi + 1;
    }
    unsafe { *visited = 1u8; }

    let temp = unsafe { own_state_at_mut(all_rows, mul_usize(bb_count, node_count)) };
    let mut v = OwnVisitor {
        state: temp,
        ctx: ctx,
        sink: unsafe { address_of_mut(*sink) },
        report: false,
        body: unsafe { address_of(*body) },
        thir: unsafe { address_of(*thir) },
        cap_tracker: 0 as *mut MirCapTracker,
        cap_arena: 0 as *mut Arena,
        str_in: str_in,
    };
    let mut targets: [16]u32 = [0u32; 16];

    let mut work_pending = true;
    while work_pending {
        work_pending = false;
        let mut rpo_k: usize = 0;
        while rpo_k < rpo_len {
            let b = (unsafe { *own_u32_at(rpo_post, rpo_len - 1 - rpo_k) }) as usize;
            if (unsafe { *(visited + b) }) == 1u8 {
                unsafe { *(visited + b) = 2u8; }
                let row_b = unsafe { own_state_at(all_rows as *const OwnStateInfo, mul_usize(b, node_count)) };
                copy_own_states(temp, row_b, ctx_cnt);
                let bb_p = unsafe { mir_bb_at(body.bbs, b) };
                unsafe { own_visit_bb(mut_view(v), view(*bb_p)); }

                if unsafe { (*bb_p).has_terminator } {
                    let target_count = unsafe { own_term_successors(view((*bb_p).terminator), mut_view(targets)) };
                    let mut tj: usize = 0;
                    while tj < target_count {
                        let tgt_v = targets[tj] as usize;
                        if tgt_v < bb_count {
                            let tgt_row = unsafe { own_state_at_mut(all_rows, mul_usize(tgt_v, node_count)) };
                            let tgt_pos = (unsafe { *own_u32_at(rpo_pos, tgt_v) }) as usize;
                            if (unsafe { *(visited + tgt_v) }) == 0u8 {
                                copy_own_states(tgt_row, temp as *const OwnStateInfo, ctx_cnt);
                                unsafe { *(visited + tgt_v) = 1u8; }
                                if tgt_pos <= rpo_k {
                                    work_pending = true;
                                }
                            } else {
                                let did_merge = merge_states(tgt_row, temp as *const OwnStateInfo, ctx_cnt);
                                if did_merge {
                                    unsafe { *(visited + tgt_v) = 1u8; }
                                    if tgt_pos <= rpo_k {
                                        work_pending = true;
                                    }
                                }
                            }
                        }
                        tj = tj + 1;
                    }
                }
            }
            rpo_k = rpo_k + 1;
        }
    }

    v.report = true;
    let mut rb: usize = 0;
    while rb < bb_count {
        if (unsafe { *(visited + rb) }) != 0u8 {
            let row_b = unsafe { own_state_at(all_rows as *const OwnStateInfo, mul_usize(rb, node_count)) };
            copy_own_states(temp, row_b, ctx_cnt);
            let bb_p = unsafe { mir_bb_at(body.bbs, rb) };
            unsafe { own_visit_bb(mut_view(v), view(*bb_p)); }
        }
        rb = rb + 1;
    }

    unsafe {
        heap_free(visited, bb_count, 1);
        heap_free(all_rows as *mut u8, all_bytes, align_of<OwnStateInfo>());
    }
}

pub fn own_check_init_only(
    it: *const HirItem,
    body: mut_view<MirBody>,
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    str_in: view<StrInterner>
) {
    if body.bb_count == 0 || sink.errors > 0 {
        return;
    }

    let ctx = unsafe { heap_alloc(size_of<PathCtx>(), align_of<PathCtx>()) } as *mut PathCtx;
    unsafe {
        (*ctx).nodes = 0 as *mut PathNode;
        (*ctx).count = 0;
        (*ctx).cap = 0;
        (*ctx).local_roots = 0 as *mut u32;
        (*ctx).local_count = 0;
        path_ctx_init(mut_view(*ctx), view(*body), thir, str_in);
    }

    let bb_count = body.bb_count;
    let ctx_cnt = unsafe { (*ctx).count };
    let node_count = if ctx_cnt > 0 { ctx_cnt } else { 1 };
    let words = (node_count + 63) >> 6usize;

    let mut arg_count: usize = body.arg_count;
    if (it as usize) != 0 && (unsafe { (*it).kind }) == HIR_ITEM_FN {
        let mut p_cnt: usize = 0;
        let mut p = unsafe { (*it).params as *const HirParam };
        while (p as usize) != 0 {
            p_cnt = p_cnt + 1;
            p = unsafe { (*p).next as *const HirParam };
        }
        if p_cnt > arg_count {
            arg_count = p_cnt;
        }
    }

    let mut ret_needs_check = true;
    if body.local_count > 0 {
        let ldecl0 = unsafe { mir_local_at(body.locals, 0) };
        let rty_v = unsafe { (*ldecl0).ty.v };
        let rty = type_get(view(thir.interner), TypeId { v: rty_v });
        if (rty as usize) != 0 {
            let rtk = unsafe { (*rty).kind };
            if rtk == TY_UNIT || rtk == TY_NEVER {
                ret_needs_check = false;
            }
        }
    }

    // 1-bit definite-ownership fast path: 64 path nodes per u64 (128x smaller than OwnStateInfo).
    // Exact homomorphism of the 4-state lattice for `state == OWN_OWNED`; falls back to
    // `own_check_exact_fallback` only if a violation is found so diagnostics/spans are identical.
    let total_words = mul_usize(bb_count + 1, words);
    let bits_bytes = total_words << 3usize;
    let all_bits = unsafe { heap_alloc(bits_bytes, 8) } as *mut u64;

    let mut wi: usize = 0;
    while wi < words {
        unsafe { *own_u64_at_mut(all_bits, wi) = 0u64; }
        wi = wi + 1;
    }

    let lroots = unsafe { (*ctx).local_roots as *const u32 };
    let mut ai: usize = 0;
    while ai < arg_count {
        if ai + 1 < body.local_count {
            let root_idx = unsafe { *own_u32_at(lroots, ai + 1) };
            unsafe { own_bits_mark(all_bits, view(*ctx), root_idx, true); }
        }
        ai = ai + 1;
    }
    ai = 0;
    while ai < body.local_count {
        let ldecl = unsafe { mir_local_at(body.locals, ai) };
        let lk = unsafe { (*ldecl).kind };
        if lk == MIR_LOCAL_ARG || lk == MIR_LOCAL_CONST || lk == MIR_LOCAL_STATIC || lk == MIR_LOCAL_TLS {
            let root_idx = unsafe { *own_u32_at(lroots, ai) };
            unsafe { own_bits_mark(all_bits, view(*ctx), root_idx, true); }
        }
        ai = ai + 1;
    }

    let visited = unsafe { heap_alloc(bb_count, 1) };
    let mut vi: usize = 0;
    while vi < bb_count {
        unsafe { *(visited + vi) = 0u8; }
        vi = vi + 1;
    }
    unsafe { *visited = 1u8; }

    let bb4 = bb_count << 2usize;
    let rpo_post = unsafe { heap_alloc(bb4, 4) } as *mut u32;
    let rpo_pos = unsafe { heap_alloc(bb4, 4) } as *mut u32;
    let rpo_len = own_compute_rpo(view(*body), rpo_post, rpo_pos);

    let temp_bits = unsafe { own_u64_at_mut(all_bits, mul_usize(bb_count, words)) };
    let ty_env = OwnTyEnv {
        body: unsafe { address_of(*body) },
        thir: unsafe { address_of(*thir) },
        str_in: unsafe { address_of(*str_in) },
    };
    let mut targets: [16]u32 = [0u32; 16];
    let mut found_error = false;
    let mut need_recheck = false;
    let mut is_first_pass = true;

    let mut work_pending = true;
    while work_pending && !found_error {
        work_pending = false;
        let check_now = is_first_pass;
        let mut rpo_k: usize = 0;
        while rpo_k < rpo_len && !found_error {
            let b = (unsafe { *own_u32_at(rpo_post as *const u32, rpo_len - 1 - rpo_k) }) as usize;
            if (unsafe { *(visited + b) }) == 1u8 {
                unsafe { *(visited + b) = 2u8; }
                let row_b = unsafe { own_u64_at(all_bits as *const u64, mul_usize(b, words)) };
                own_bits_copy(temp_bits, row_b, words);
                let bb_p = unsafe { mir_bb_at(body.bbs, b) };
                unsafe {
                    own_bits_visit_bb(
                        temp_bits,
                        view(*ctx),
                        view(*body),
                        thir,
                        view(ty_env),
                        view(*bb_p),
                        ret_needs_check,
                        check_now,
                        mut_view(found_error)
                    );
                }
                if found_error {
                    break;
                }
                if unsafe { (*bb_p).has_terminator } {
                    let target_count = unsafe { own_term_successors(view((*bb_p).terminator), mut_view(targets)) };
                    let mut tj: usize = 0;
                    while tj < target_count {
                        let tgt_v = targets[tj] as usize;
                        if tgt_v < bb_count {
                            let tgt_row = unsafe { own_u64_at_mut(all_bits, mul_usize(tgt_v, words)) };
                            let tgt_pos = (unsafe { *own_u32_at(rpo_pos as *const u32, tgt_v) }) as usize;
                            if (unsafe { *(visited + tgt_v) }) == 0u8 {
                                own_bits_copy(tgt_row, temp_bits as *const u64, words);
                                unsafe { *(visited + tgt_v) = 1u8; }
                                if tgt_pos <= rpo_k {
                                    work_pending = true;
                                    need_recheck = true;
                                }
                            } else {
                                let did_merge = own_bits_merge(tgt_row, temp_bits as *const u64, words);
                                if did_merge {
                                    unsafe { *(visited + tgt_v) = 1u8; }
                                    if tgt_pos <= rpo_k {
                                        work_pending = true;
                                        need_recheck = true;
                                    }
                                }
                            }
                        }
                        tj = tj + 1;
                    }
                }
            }
            rpo_k = rpo_k + 1;
        }
        is_first_pass = false;
    }

    if !found_error && need_recheck {
        let mut rpo_k: usize = 0;
        while rpo_k < rpo_len && !found_error {
            let b = (unsafe { *own_u32_at(rpo_post as *const u32, rpo_len - 1 - rpo_k) }) as usize;
            if (unsafe { *(visited + b) }) != 0u8 {
                let row_b = unsafe { own_u64_at(all_bits as *const u64, mul_usize(b, words)) };
                own_bits_copy(temp_bits, row_b, words);
                let bb_p = unsafe { mir_bb_at(body.bbs, b) };
                unsafe {
                    own_bits_visit_bb(
                        temp_bits,
                        view(*ctx),
                        view(*body),
                        thir,
                        view(ty_env),
                        view(*bb_p),
                        ret_needs_check,
                        true,
                        mut_view(found_error)
                    );
                }
            }
            rpo_k = rpo_k + 1;
        }
    }

    unsafe {
        heap_free(visited, bb_count, 1);
        heap_free(all_bits as *mut u8, bits_bytes, 8);
    }

    if found_error {
        own_check_exact_fallback(
            body,
            thir,
            sink,
            ctx as *const PathCtx,
            arg_count,
            rpo_post as *const u32,
            rpo_pos as *const u32,
            rpo_len,
            unsafe { address_of(*str_in) }
        );
    }

    unsafe {
        heap_free(rpo_post as *mut u8, bb4, 4);
        heap_free(rpo_pos as *mut u8, bb4, 4);
        path_ctx_free(mut_view(*ctx));
        heap_free(ctx as *mut u8, size_of<PathCtx>(), align_of<PathCtx>());
    }
}

pub fn own_check(
    it: *const HirItem,
    body: mut_view<MirBody>,
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    str_in: view<StrInterner>
) {
    own_cap_check(view(*body), mut_view(*sink));
    own_check_init_only(it, body, thir, sink, str_in);
}
