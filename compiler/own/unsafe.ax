use compiler.hir.hir.HIR_EXPR_CALL
use compiler.hir.hir.HIR_EXPR_CAST
use compiler.hir.hir.HIR_EXPR_CLOSURE
use compiler.hir.hir.HIR_EXPR_COMPTIME
