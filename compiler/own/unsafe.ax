use compiler.types.types.TY_BUILTIN_PTR_ADD
use compiler.types.types.TY_BUILTIN_PTR_COPY
use compiler.types.types.TY_BUILTIN_PTR_COPY_NONOVERLAPPING
use compiler.types.types.TY_BUILTIN_PTR_SUB
use compiler.types.types.TY_BUILTIN_PTR_WRITE_BYTES
