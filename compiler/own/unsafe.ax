    117u8, 116u8, 101u8, 114u8, 32u8, 98u8, 105u8, 110u8, 100u8, 105u8, 110u8, 103u8, 108u8, 111u8, 99u8, 107u8,
    32u8, 103u8, 117u8, 97u8, 114u8, 100u8, 32u8, 111u8, 114u8, 32u8, 118u8, 105u8, 101u8, 119u8, 32u8, 100u8,
    101u8, 114u8, 105u8, 118u8, 101u8, 100u8, 32u8, 102u8, 114u8, 111u8, 109u8, 32u8, 97u8, 32u8, 103u8, 117u8,
    97u8, 114u8, 100u8, 32u8, 99u8, 97u8, 110u8, 110u8, 111u8, 116u8, 32u8, 101u8, 115u8, 99u8, 97u8, 112u8,
    101u8, 32u8, 105u8, 116u8, 115u8, 32u8, 108u8, 101u8, 120u8, 105u8, 99u8, 97u8, 108u8, 32u8, 108u8, 111u8,
    99u8, 107u8, 32u8, 115u8, 99u8, 111u8, 112u8, 101u8, 108u8, 111u8, 99u8, 107u8, 32u8, 103u8, 117u8, 97u8,
    114u8, 100u8, 32u8, 111u8, 114u8, 32u8, 118u8, 105u8, 101u8, 119u8, 32u8, 100u8, 101u8, 114u8, 105u8, 118u8,
    101u8, 100u8, 32u8, 102u8, 114u8, 111u8, 109u8, 32u8, 97u8, 32u8, 103u8, 117u8, 97u8, 114u8, 100u8, 32u8,
    99u8, 97u8, 110u8, 110u8, 111u8, 116u8, 32u8, 98u8, 101u8, 32u8, 114u8, 101u8, 116u8, 117u8, 114u8, 110u8,
    101u8, 100u8, 32u8, 102u8, 114u8, 111u8, 109u8, 32u8, 97u8, 32u8, 102u8, 117u8, 110u8, 99u8, 116u8, 105u8,
    111u8, 110u8, 116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 95u8, 108u8, 111u8, 99u8, 97u8, 108u8,
    116u8, 104u8, 114u8, 101u8, 97u8, 100u8, 45u8, 108u8, 111u8, 99u8, 97u8, 108u8, 32u8, 98u8, 111u8, 114u8, 114u8, 111u8, 119u8, 32u8, 99u8, 97u8, 110u8, 110u8, 111u8, 116u8, 32u8, 101u8, 115u8, 99u8, 97u8, 112u8, 101u8, 32u8, 102u8, 117u8, 110u8, 99u8, 116u8, 105u8, 111u8, 110u8, 32u8, 111u8, 114u8, 32u8, 116u8, 104u8, 114u8, 101u8, 97u8, 100u8,
];
const CONC_STR_OFF: [94]u32 = [
    0u32, 46u32, 97u32, 147u32, 215u32, 279u32, 341u32, 403u32, 457u32, 525u32, 591u32, 610u32, 696u32, 769u32, 918u32, 924u32,
    934u32, 942u32, 951u32, 960u32, 969u32, 980u32, 988u32, 997u32, 1006u32, 1015u32, 1026u32, 1035u32, 1040u32, 1046u32, 1056u32, 1071u32,
    1087u32, 1096u32, 1105u32, 1115u32, 1119u32, 1126u32, 1136u32, 1143u32, 1145u32, 1152u32, 1163u32, 1168u32, 1172u32, 1175u32, 1179u32, 1183u32,
    1188u32, 1361u32, 1479u32, 1497u32, 1587u32, 1678u32, 1756u32, 1869u32, 1917u32, 1972u32, 2068u32, 2162u32, 2220u32, 2257u32, 2364u32, 2501u32,
    2588u32, 2656u32, 2711u32, 2719u32, 2723u32, 2726u32, 2736u32, 2744u32, 2753u32, 2763u32, 2774u32, 2778u32, 2782u32, 2793u32, 2805u32, 2810u32,
    2822u32, 2828u32, 2838u32, 2848u32, 2868u32, 2883u32, 2888u32, 2899u32, 2902u32, 3004u32, 3080u32, 3154u32, 3166u32, 3217u32,
];

fn conc_sv_eq_lit(sv: view<StrView>, lit_idx: usize) -> bool {
    let start = CONC_STR_OFF[lit_idx] as usize;
    let end = CONC_STR_OFF[lit_idx + 1] as usize;
    let n = end - start;
    if sv.len != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let a = unsafe { *(sv.ptr + i) };
        if a != CONC_STR_DATA[start + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn conc_sv_starts_with(sv: view<StrView>, prefix_idx: usize) -> bool {
    let start = CONC_STR_OFF[prefix_idx] as usize;
    let end = CONC_STR_OFF[prefix_idx + 1] as usize;
    let n = end - start;
    if (sv.len) < n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let a = unsafe { *(sv.ptr + i) };
        if a != CONC_STR_DATA[start + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn conc_alloc_str(c: mut_view<UnsafeChecker>, s_idx: usize) -> StrView {
    if (c.sink as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let start = CONC_STR_OFF[s_idx] as usize;
    let end = CONC_STR_OFF[s_idx + 1] as usize;
    let n = end - start;
    let buf = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), n + 1, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe { *(buf + i) = CONC_STR_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(buf + n) = 0u8; }
    StrView { ptr: buf as *const u8, len: n }
}

fn conc_alloc_concat3(c: mut_view<UnsafeChecker>, a_idx: usize, b: view<StrView>, d_idx: usize) -> StrView {
    if (c.sink as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let a_start = CONC_STR_OFF[a_idx] as usize;
    let a_end = CONC_STR_OFF[a_idx + 1] as usize;
    let a_len = a_end - a_start;
    let d_start = CONC_STR_OFF[d_idx] as usize;
    let d_end = CONC_STR_OFF[d_idx + 1] as usize;
    let d_len = d_end - d_start;
    let total = a_len + b.len + d_len;
    let buf = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), total + 1, 1) };
    let mut pos: usize = 0;
    let mut i: usize = 0;
    while i < a_len {
        unsafe { *(buf + pos) = CONC_STR_DATA[a_start + i]; }
        pos = pos + 1;
        i = i + 1;
    }
    i = 0;
    while i < b.len && (b.ptr as usize) != 0 {
        unsafe { *(buf + pos) = *(b.ptr + i); }
        pos = pos + 1;
        i = i + 1;
    }
    i = 0;
    while i < d_len {
        unsafe { *(buf + pos) = CONC_STR_DATA[d_start + i]; }
        pos = pos + 1;
        i = i + 1;
    }
    unsafe { *(buf + total) = 0u8; }
    StrView { ptr: buf as *const u8, len: total }
}

fn conc_get_name_sv(c: view<UnsafeChecker>, name_v: u32) -> StrView {
    if name_v == 0u32 || (c.interner as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    unsafe { interner_get(view(*c.interner), StrId { v: name_v }) }
}

fn report_unsafe_required(c: mut_view<UnsafeChecker>, span: Span) {
    if (c.sink as usize) == 0 {
        return;
    }
    let buf = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), 47, 1) };
    let mut i: usize = 0;
    while (i < 46) {
        unsafe { *(buf + i) = UNSAFE_REQ_MSG[i]; }
        i = i + 1;
    }
    unsafe { *(buf + 46) = 0u8; }

    let d = Diagnostic {
        code: DiagCode { v: AX_UNSAFE_REQUIRED },
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf as *const u8, len: 46 },
        primary: Span { file: FileId { v: span.file.v }, start: span.start, end: span.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    unsafe {
        diag_sink_report(mut_view(*c.sink), view(d));
    }
}

fn report_conc_diag(
    c: mut_view<UnsafeChecker>,
    code_v: u32,
    span: Span,
    msg: StrView,
    note1: StrView,
    note2: StrView
) {
    if (c.sink as usize) == 0 {
        return;
    }
    let notes = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), mul_usize(2, size_of<StrView>()), align_of<StrView>()) as *mut StrView };
    let mut nc: usize = 0;
    if note1.len > 0 {
        let n0 = unsafe { conc_sv_at(notes, nc) };
        unsafe { *n0 = note1; }
        nc = nc + 1;
    }
    if note2.len > 0 {
        let n1 = unsafe { conc_sv_at(notes, nc) };
        unsafe { *n1 = note2; }
        nc = nc + 1;
    }
    let d = Diagnostic {
        code: DiagCode { v: code_v },
        severity: DiagSeverity.Error,
        message: msg,
        primary: Span { file: FileId { v: span.file.v }, start: span.start, end: span.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: if nc > 0 { notes } else { 0 as *mut StrView },
        note_count: nc,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    unsafe {
        diag_sink_report(mut_view(*c.sink), view(d));
    }
}

fn report_conc_shared_mut_diag(
    c: mut_view<UnsafeChecker>,
    primary_span: Span,
    first_span: Span,
    second_span: Span,
    first_is_write: bool,
    second_is_write: bool,
    root_name_v: u32,
    rel: u8
) {
    if (c.sink as usize) == 0 {
        return;
    }
    let name_sv = conc_get_name_sv(view(*c), root_name_v);
    let kind_str = if first_is_write && second_is_write {
        1usize
    } else {
        2usize
    };
    let tail_str = if rel == CONC_REL_UNKNOWN {
        3usize
    } else if rel == CONC_REL_OVERLAP {
        4usize
    } else {
        5usize
    };
    let msg = conc_alloc_concat3(mut_view(*c), kind_str, view(name_sv), tail_str);

    let labels = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), mul_usize(2, size_of<DiagLabel>()), align_of<DiagLabel>()) as *mut DiagLabel };
    let l0 = unsafe { conc_label_at(labels, 0) };
    let l1 = unsafe { conc_label_at(labels, 1) };
    let l0_msg = if first_is_write {
        conc_alloc_str(mut_view(*c), 6usize)
    } else {
        conc_alloc_str(mut_view(*c), 7usize)
    };
    let l1_msg = if second_is_write {
        conc_alloc_str(mut_view(*c), 8usize)
    } else {
        conc_alloc_str(mut_view(*c), 9usize)
    };
    unsafe {
        (*l0).span = conc_copy_span(view(first_span));
        (*l0).message = l0_msg;
        (*l1).span = conc_copy_span(view(second_span));
        (*l1).message = l1_msg;
    }

    let notes = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), mul_usize(2, size_of<StrView>()), align_of<StrView>()) as *mut StrView };
    let n0 = unsafe { conc_sv_at(notes, 0) };
    let n1 = unsafe { conc_sv_at(notes, 1) };
    let note_rel = if rel == CONC_REL_UNKNOWN {
        conc_alloc_concat3(mut_view(*c), 10usize, view(name_sv), 11usize)
    } else {
        conc_alloc_concat3(mut_view(*c), 10usize, view(name_sv), 12usize)
    };
    let note_sync = conc_alloc_str(mut_view(*c), 13usize);
    unsafe {
        *n0 = note_rel;
        *n1 = note_sync;
    }

    let d = Diagnostic {
        code: DiagCode { v: AX_CONC_SHARED_MUT },
        severity: DiagSeverity.Error,
        message: msg,
        primary: conc_copy_span(view(primary_span)),
        labels: labels,
        label_count: 2,
        notes: notes,
        note_count: 2,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    unsafe {
        diag_sink_report(mut_view(*c.sink), view(d));
    }
}

fn unsafe_get_expr_ty(c: view<UnsafeChecker>, expr: *const HirExpr) -> TypeId {
    if (expr as usize) == 0 || (c.thir as usize) == 0 {
        return TypeId { v: 0u32 };
    }
    let tp = unsafe { thir_get_expr_type(view(*c.thir), expr) };
    if (tp as usize) == 0 {
        return TypeId { v: 0u32 };
    }
    let tv = unsafe { (*tp).v };
    TypeId { v: tv }
}

fn unsafe_get_sym_ty(c: view<UnsafeChecker>, sym_v: u32) -> TypeId {
    if sym_v == 0u32 || (c.thir as usize) == 0 {
        return TypeId { v: 0u32 };
    }
    let tp = unsafe { thir_get_sym_type(view(*c.thir), SymbolId { v: sym_v }) };
    if (tp as usize) == 0 {
        return TypeId { v: 0u32 };
    }
    let tv = unsafe { (*tp).v };
    TypeId { v: tv }
}

fn unsafe_get_item_ty(c: view<UnsafeChecker>, it: *const HirItem) -> TypeId {
    if (it as usize) == 0 || (c.thir as usize) == 0 {
        return TypeId { v: 0u32 };
    }
    let tp = unsafe { thir_get_item_type(view(*c.thir), it) };
    if (tp as usize) == 0 {
        return TypeId { v: 0u32 };
    }
    let tv = unsafe { (*tp).v };
    TypeId { v: tv }
}

fn conc_type_def_name(c: view<UnsafeChecker>, ty: TypeId) -> StrView {
    if ty.v == 0u32 || (c.thir as usize) == 0 || (c.interner as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let t = unsafe { type_get(view((*c.thir).interner), ty) };
    if (t as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_VIEW || tk == TY_MUT_VIEW {
        return conc_type_def_name(c, TypeId { v: unsafe { (*t).pointee.v } });
    }
    if tk == TY_STRUCT || tk == TY_ENUM {
        let def_it = unsafe { (*t).def as *const HirItem };
        if (def_it as usize) != 0 {
            return conc_get_name_sv(c, unsafe { (*def_it).name.v });
        }
        if (unsafe { (*t).name.v }) != 0u32 {
            return conc_get_name_sv(c, unsafe { (*t).name.v });
        }
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

fn conc_sv_is_atomic_name(sv: view<StrView>) -> bool {
    conc_sv_eq_lit(sv, 14usize) ||
    conc_sv_eq_lit(sv, 15usize) ||
    conc_sv_eq_lit(sv, 16usize) ||
    conc_sv_eq_lit(sv, 17usize) ||
    conc_sv_eq_lit(sv, 18usize) ||
    conc_sv_eq_lit(sv, 19usize) ||
    conc_sv_eq_lit(sv, 20usize) ||
    conc_sv_eq_lit(sv, 21usize) ||
    conc_sv_eq_lit(sv, 22usize) ||
    conc_sv_eq_lit(sv, 23usize) ||
    conc_sv_eq_lit(sv, 24usize) ||
    conc_sv_eq_lit(sv, 25usize) ||
    conc_sv_eq_lit(sv, 26usize)
}

fn conc_sv_is_sync_wrapper_name(sv: view<StrView>) -> bool {
    conc_sv_eq_lit(sv, 27usize) ||
    conc_sv_eq_lit(sv, 28usize) ||
    conc_sv_is_atomic_name(sv)
}

fn conc_sv_is_guard_name(sv: view<StrView>) -> bool {
    conc_sv_eq_lit(sv, 29usize) ||
    conc_sv_eq_lit(sv, 30usize) ||
    conc_sv_eq_lit(sv, 31usize) ||
    conc_sv_eq_lit(sv, 32usize) ||
    conc_sv_eq_lit(sv, 33usize) ||
    conc_sv_eq_lit(sv, 34usize)
}

fn conc_sv_is_non_share_cell_name(sv: view<StrView>) -> bool {
    conc_sv_eq_lit(sv, 35usize) ||
    conc_sv_eq_lit(sv, 36usize) ||
    conc_sv_eq_lit(sv, 37usize) ||
    conc_sv_eq_lit(sv, 38usize) ||
    conc_sv_eq_lit(sv, 39usize) ||
    conc_sv_eq_lit(sv, 40usize) ||
    conc_sv_eq_lit(sv, 41usize) ||
    conc_sv_is_guard_name(sv)
}

fn conc_type_is_atomic(c: view<UnsafeChecker>, ty: TypeId) -> bool {
    let sv = conc_type_def_name(c, ty);
    conc_sv_is_atomic_name(view(sv))
}

fn conc_type_is_sync_wrapper(c: view<UnsafeChecker>, ty: TypeId) -> bool {
    let sv = conc_type_def_name(c, ty);
    conc_sv_is_sync_wrapper_name(view(sv))
}

fn conc_type_is_guard(c: view<UnsafeChecker>, ty: TypeId) -> bool {
    if ty.v == 0u32 || (c.thir as usize) == 0 {
        return false;
    }
    let sv = conc_type_def_name(c, TypeId { v: ty.v });
    if conc_sv_is_guard_name(view(sv)) {
        return true;
    }
    let t = unsafe { type_get(view((*c.thir).interner), TypeId { v: ty.v }) };
    if (t as usize) == 0 {
        return false;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_TUPLE || tk == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        while i < fc && (fptr as usize) != 0 {
            let ft = TypeId { v: unsafe { (*typeid_at(fptr, i)).v } };
            if conc_type_is_guard(c, ft) {
                return true;
            }
            i = i + 1;
        }
    }
    false
}

fn conc_check_explicit_auto_impl(c: view<UnsafeChecker>, def_item: *const HirItem, trait_name: usize) -> i32 {
    if (def_item as usize) == 0 || (c.hir as usize) == 0 || (c.interner as usize) == 0 {
        return 0;
    }
    let target_name_v = unsafe { (*def_item).name.v };
    if target_name_v == 0u32 {
        return 0;
    }
    let mut it = unsafe { (*c.hir).items as *const HirItem };
    let mut pos_found = false;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
            let tr: *const HirType = unsafe { (*it).trait_path as *const HirType };
            let tt: *const HirType = unsafe { (*it).self_type as *const HirType };
            if (tr as usize) != 0 && (tt as usize) != 0 {
                if (unsafe { (*tr).kind }) == HIR_TYPE_PATH && (unsafe { (*tt).kind }) == HIR_TYPE_PATH {
                    let tr_sv = conc_get_name_sv(c, unsafe { (*tr).path.name.v });
                    let tt_name_v = unsafe { (*tt).path.name.v };
                    if tt_name_v == target_name_v && conc_sv_eq_lit(view(tr_sv), trait_name) {
                        if unsafe { (*it).is_negative } {
                            return -1;
                        }
                        pos_found = true;
                    }
                }
            }
        }
        it = unsafe { (*it).next as *const HirItem };
    }
    if pos_found { 1 } else { 0 }
}

fn conc_param_has_bound(c: view<UnsafeChecker>, gp: *const HirGenericParam, trait_name: usize) -> bool {
    if (gp as usize) == 0 || (c.interner as usize) == 0 {
        return false;
    }
    let mut b: *const HirType = unsafe { (*gp).bounds as *const HirType };
    while (b as usize) != 0 {
        if (unsafe { (*b).kind }) == HIR_TYPE_PATH {
            let b_sv = conc_get_name_sv(c, unsafe { (*b).path.name.v });
            if conc_sv_eq_lit(view(b_sv), trait_name) {
                return true;
            }
        }
        b = unsafe { (*b).next as *const HirType };
    }
    false
}

fn conc_type_satisfies_auto(c: view<UnsafeChecker>, ty: TypeId, is_share: bool, depth: usize) -> bool {
    if (c.thir as usize) == 0 || ty.v == 0u32 || depth > 16 {
        return true;
    }
    let t = unsafe { type_get(view((*c.thir).interner), TypeId { v: ty.v }) };
    if (t as usize) == 0 {
        return true;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_PTR {
        return false;
    }
    if tk == TY_VIEW {
        return conc_type_satisfies_auto(c, TypeId { v: unsafe { (*t).pointee.v } }, true, depth + 1);
    }
    if tk == TY_MUT_VIEW {
        return conc_type_satisfies_auto(c, TypeId { v: unsafe { (*t).pointee.v } }, is_share, depth + 1);
    }
    if tk == TY_ARRAY || tk == TY_SLICE {
        return conc_type_satisfies_auto(c, TypeId { v: unsafe { (*t).elem.v } }, is_share, depth + 1);
    }
    if tk == TY_TUPLE {
        let fc = unsafe { (*t).field_count };
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        while i < fc && (fptr as usize) != 0 {
            let ft = TypeId { v: unsafe { (*typeid_at(fptr, i)).v } };
            if !conc_type_satisfies_auto(c, ft, is_share, depth + 1) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if tk == TY_CLOSURE {
        let cc = unsafe { (*t).capture_count };
        let cptr = unsafe { (*t).captures };
        let mut i: usize = 0;
        while i < cc && (cptr as usize) != 0 {
            let cap = unsafe { capture_at(cptr, i) };
            let ct = TypeId { v: unsafe { (*cap).ty.v } };
            if !conc_type_satisfies_auto(c, ct, is_share, depth + 1) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if tk == TY_PARAM {
        let gp = unsafe { (*t).def as *const HirGenericParam };
        let tname = if is_share { 42usize } else { 43usize };
        if conc_param_has_bound(c, gp, tname) {
            return true;
        }
        if (c.current_fn as usize) != 0 {
            let gps: *const HirGenericParams = unsafe { (*c.current_fn).generic_params as *const HirGenericParams };
            if (gps as usize) != 0 {
                let p_idx = unsafe { (*t).param_index };
                let mut cur_p: *const HirGenericParam = unsafe { (*gps).params as *const HirGenericParam };
                let mut idx: u32 = 0u32;
                while (cur_p as usize) != 0 {
                    if idx == p_idx && conc_param_has_bound(c, cur_p, tname) {
                        return true;
                    }
                    idx = idx + 1u32;
                    cur_p = unsafe { (*cur_p).next as *const HirGenericParam };
                }
            }
        }
        return false;
    }
    if tk == TY_STRUCT || tk == TY_ENUM {
        let def_it = unsafe { (*t).def as *const HirItem };
        let tname = if is_share { 42usize } else { 43usize };
        let expl = conc_check_explicit_auto_impl(c, def_it, tname);
        if expl < 0 {
            return false;
        }
        if expl > 0 {
            return true;
        }
        let dname = conc_type_def_name(c, ty);
        if is_share && conc_sv_is_non_share_cell_name(view(dname)) {
            return false;
        }
        if !is_share && (conc_sv_eq_lit(view(dname), 39usize) || conc_sv_eq_lit(view(dname), 40usize) || conc_sv_is_guard_name(view(dname))) {
            return false;
        }
        if conc_sv_eq_lit(view(dname), 27usize) {
            let ac = unsafe { (*t).arg_count };
            if ac > 0 && (unsafe { (*t).args as usize }) != 0 {
                let inner = TypeId { v: unsafe { (*typeid_at((*t).args, 0)).v } };
                return conc_type_satisfies_auto(c, inner, false, depth + 1);
            }
            return true;
        }
        if conc_sv_eq_lit(view(dname), 28usize) || conc_sv_eq_lit(view(dname), 44usize) {
            let ac = unsafe { (*t).arg_count };
            if ac > 0 && (unsafe { (*t).args as usize }) != 0 {
                let inner_v = unsafe { (*typeid_at((*t).args, 0)).v };
                return conc_type_satisfies_auto(c, TypeId { v: inner_v }, false, depth + 1) &&
                       conc_type_satisfies_auto(c, TypeId { v: inner_v }, true, depth + 1);
            }
            return true;
        }
        if conc_sv_is_atomic_name(view(dname)) {
            return true;
        }
        if tk == TY_STRUCT {
            let fc = unsafe { (*t).field_count };
            let fptr = unsafe { (*t).fields };
            let mut i: usize = 0;
            while i < fc && (fptr as usize) != 0 {
                let ft = TypeId { v: unsafe { (*typeid_at(fptr, i)).v } };
                if !conc_type_satisfies_auto(c, ft, is_share, depth + 1) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        if tk == TY_ENUM {
            let vc = unsafe { (*t).variant_count };
            let vfc = unsafe { (*t).variant_field_counts };
            let vfptr = unsafe { (*t).variant_fields };
            let mut v: usize = 0;
            while v < vc && (vfc as usize) != 0 && (vfptr as usize) != 0 {
                let fc = unsafe { *usize_at(vfc, v) };
                let row = unsafe { *typeid_ptr_at(vfptr, v) };
                let mut j: usize = 0;
                while j < fc && (row as usize) != 0 {
                    let ft = TypeId { v: unsafe { (*typeid_at(row, j)).v } };
                    if !conc_type_satisfies_auto(c, ft, is_share, depth + 1) {
                        return false;
                    }
                    j = j + 1;
                }
                v = v + 1;
            }
            return true;
        }
    }
    true
}

fn conc_type_is_share(c: view<UnsafeChecker>, ty: TypeId) -> bool {
    conc_type_satisfies_auto(c, ty, true, 0)
}

fn conc_find_static_item(c: view<UnsafeChecker>, sym_v: u32, name_v: u32) -> *const HirItem {
    if (c.hir as usize) == 0 || (sym_v == 0u32 && name_v == 0u32) {
        return 0 as *const HirItem;
    }
    let mut it = unsafe { (*c.hir).items as *const HirItem };
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_STATIC {
            let it_sym = unsafe { (*it).symbol.v };
            let it_name = unsafe { (*it).name.v };
            if (sym_v != 0u32 && it_sym == sym_v) || (sym_v == 0u32 && name_v != 0u32 && it_name == name_v) {
                return it;
            }
        }
        it = unsafe { (*it).next as *const HirItem };
    }
    0 as *const HirItem
}

fn conc_item_has_attr(c: view<UnsafeChecker>, it: *const HirItem, attr_name: usize) -> bool {
    if (it as usize) == 0 || (c.interner as usize) == 0 {
        return false;
    }
    let mut a: *const HirAttr = unsafe { (*it).attrs as *const HirAttr };
    while (a as usize) != 0 {
        let sv = conc_get_name_sv(c, unsafe { (*a).name.v });
        if conc_sv_eq_lit(view(sv), attr_name) {
            return true;
        }
        a = unsafe { (*a).next as *const HirAttr };
    }
    false
}

fn conc_lookup_bind(c: view<UnsafeChecker>, sym_v: u32, name_v: u32) -> *mut ConcBind {
    if (c.binds as usize) == 0 || c.bind_count == 0 {
        return 0 as *mut ConcBind;
    }
    let mut i = c.bind_count;
    while i > 0 {
        i = i - 1;
        let b = unsafe { conc_bind_at(c.binds, i) };
        let b_sym = unsafe { (*b).sym };
        let b_name = unsafe { (*b).name };
        if (sym_v != 0u32 && b_sym == sym_v) || (sym_v == 0u32 && name_v != 0u32 && b_name == name_v) {
            return b;
        }
    }
    0 as *mut ConcBind
}

fn conc_empty_region(c: mut_view<UnsafeChecker>) -> ConcRegion {
    let projs = if (c.sink as usize) != 0 {
        unsafe { arena_alloc_raw(mut_view((*c.sink).arena), mul_usize(4, size_of<ConcProj>()), align_of<ConcProj>()) as *mut ConcProj }
    } else {
        0 as *mut ConcProj
    };
    ConcRegion {
        root_sym: 0u32,
        root_name: 0u32,
        projs: projs,
        proj_count: 0,
        is_valid: false,
        from_unsafe_static: false,
        from_unsafe_ptr: false,
        from_guard: false,
        from_atomic: false,
        is_sync_wrapper: false,
        from_tls: false,
    }
}

fn conc_clone_region(c: mut_view<UnsafeChecker>, src: view<ConcRegion>) -> ConcRegion {
    let mut dst = conc_empty_region(c);
    dst.root_sym = src.root_sym;
    dst.root_name = src.root_name;
    dst.proj_count = src.proj_count;
    dst.is_valid = src.is_valid;
    dst.from_unsafe_static = src.from_unsafe_static;
    dst.from_unsafe_ptr = src.from_unsafe_ptr;
    dst.from_guard = src.from_guard;
    dst.from_atomic = src.from_atomic;
    dst.is_sync_wrapper = src.is_sync_wrapper;
    dst.from_tls = src.from_tls;
    let mut i: usize = 0;
    while i < src.proj_count && i < 4 && (dst.projs as usize) != 0 && (src.projs as usize) != 0 {
        let sp = unsafe { conc_proj_at(src.projs, i) };
        let dp = unsafe { conc_proj_at(dst.projs, i) };
        unsafe {
            (*dp).kind = (*sp).kind;
            (*dp).field_name = (*sp).field_name;
            (*dp).start_const = (*sp).start_const;
            (*dp).end_const = (*sp).end_const;
            (*dp).start_sym = (*sp).start_sym;
            (*dp).end_sym = (*sp).end_sym;
            (*dp).has_start = (*sp).has_start;
            (*dp).has_end = (*sp).has_end;
            (*dp).start_is_const = (*sp).start_is_const;
            (*dp).end_is_const = (*sp).end_is_const;
        }
        i = i + 1;
    }
    dst
}

fn conc_region_push_proj(reg: mut_view<ConcRegion>, proj: view<ConcProj>) {
    if (reg.proj_count) < 4 && (reg.projs as usize) != 0 {
        let dp = unsafe { conc_proj_at(reg.projs, reg.proj_count) };
        unsafe {
            (*dp).kind = proj.kind;
            (*dp).field_name = proj.field_name;
            (*dp).start_const = proj.start_const;
            (*dp).end_const = proj.end_const;
            (*dp).start_sym = proj.start_sym;
            (*dp).end_sym = proj.end_sym;
            (*dp).has_start = proj.has_start;
            (*dp).has_end = proj.has_end;
            (*dp).start_is_const = proj.start_is_const;
            (*dp).end_is_const = proj.end_is_const;
        }
        reg.proj_count = reg.proj_count + 1;
    }
}

fn conc_eval_index_bound(
    c: view<UnsafeChecker>,
    expr: *const HirExpr,
    out_const: mut_view<u64>,
    out_sym: mut_view<u32>
) -> bool {
    *out_const = 0u64;
    *out_sym = 0u32;
    if (expr as usize) == 0 {
        return false;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_LITERAL {
        if (unsafe { (*expr).literal.kind }) == TOK_INT {
            *out_const = unsafe { (*expr).literal.int_val };
            return true;
        }
        return false;
    }
    if ek == HIR_EXPR_CAST {
        return conc_eval_index_bound(c, unsafe { (*expr).inner as *const HirExpr }, out_const, out_sym);
    }
    if ek == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        let name_v = unsafe { (*expr).path.name.v };
        *out_sym = if sym_v != 0u32 { sym_v } else { name_v };
        let b = conc_lookup_bind(c, sym_v, name_v);
        if (b as usize) != 0 && (unsafe { (*b).has_const_int }) {
            *out_const = unsafe { (*b).const_int_val };
            return true;
        }
        return false;
    }
    false
}

fn conc_extract_region(c: mut_view<UnsafeChecker>, expr: *const HirExpr) -> ConcRegion {
    if (expr as usize) == 0 {
        return conc_empty_region(c);
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_BLOCK {
        let blk = unsafe { (*expr).block as *const HirBlock };
        if (blk as usize) != 0 {
            let mut s = unsafe { (*blk).stmts as *const HirStmt };
            let mut last_e: *const HirExpr = 0 as *const HirExpr;
            while (s as usize) != 0 {
                if (unsafe { (*s).kind }) == HIR_STMT_EXPR {
                    last_e = unsafe { (*s).expr as *const HirExpr };
                }
                s = unsafe { (*s).next as *const HirStmt };
            }
            if (last_e as usize) != 0 {
                let mut r = conc_extract_region(c, last_e);
                if ek == HIR_EXPR_UNSAFE {
                    if !r.from_unsafe_static {
                        r.from_unsafe_ptr = true;
                    }
                }
                return r;
            }
        }
        return conc_empty_region(c);
    }
    if ek == HIR_EXPR_VIEW || ek == HIR_EXPR_CAST {
        return conc_extract_region(c, unsafe { (*expr).inner as *const HirExpr });
    }
    if ek == HIR_EXPR_UNARY && (unsafe { (*expr).op }) == UNOP_DEREF {
        let inner = unsafe { (*expr).inner as *const HirExpr };
        let inner_ty = unsafe_get_expr_ty(view(*c), inner);
        let mut r = conc_extract_region(mut_view(*c), inner);
        if inner_ty.v != 0u32 && (c.thir as usize) != 0 {
            let t = unsafe { type_get(view((*c.thir).interner), inner_ty) };
            if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_PTR {
                r.from_unsafe_ptr = true;
            }
        }
        return r;
    }
    if ek == HIR_EXPR_CALL {
        let callee = unsafe { (*expr).callee as *const HirExpr };
        let cty = unsafe_get_expr_ty(view(*c), callee);
        if cty.v != 0u32 && (c.thir as usize) != 0 {
            let ft = unsafe { type_get(view((*c.thir).interner), cty) };
            if (ft as usize) != 0 {
                let fk = unsafe { (*ft).kind };
                if fk == TY_BUILTIN_ADDRESS_OF || fk == TY_BUILTIN_ADDRESS_OF_MUT {
                    let arg0 = unsafe { (*expr).args as *const HirExpr };
                    let mut r = conc_extract_region(c, arg0);
                    r.from_unsafe_ptr = true;
                    return r;
                }
            }
        }
        let arg0 = unsafe { (*expr).args as *const HirExpr };
        if (arg0 as usize) != 0 && (unsafe { (*arg0).next as usize }) == 0 {
            let r0 = conc_extract_region(mut_view(*c), arg0);
            if r0.from_guard {
                return r0;
            }
        }
        return conc_empty_region(c);
    }
    if ek == HIR_EXPR_METHOD_CALL {
        let recv = unsafe { (*expr).receiver as *const HirExpr };
        let mname = conc_get_name_sv(view(*c), unsafe { (*expr).method_name.v });
        let mut r = conc_extract_region(c, recv);
        if conc_sv_eq_lit(view(mname), 45usize) || conc_sv_eq_lit(view(mname), 46usize) || conc_sv_eq_lit(view(mname), 47usize) {
            r.from_guard = true;
        }
        return r;
    }
    if ek == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        let name_v = unsafe { (*expr).path.name.v };
        let b = conc_lookup_bind(view(*c), sym_v, name_v);
        if (b as usize) != 0 {
            let has_reg = unsafe { (*b).region.is_valid };
            if has_reg {
                let mut cr = conc_clone_region(c, unsafe { view((*b).region) });
                if unsafe { (*b).is_tls } {
                    cr.from_tls = true;
                }
                return cr;
            }
        }
        let mut reg = conc_empty_region(mut_view(*c));
        reg.root_sym = if sym_v != 0u32 { sym_v } else { name_v };
        reg.root_name = name_v;
        reg.is_valid = reg.root_sym != 0u32 || reg.root_name != 0u32;
        let st_it = conc_find_static_item(view(*c), sym_v, name_v);
        if (st_it as usize) != 0 {
            if unsafe { (*st_it).is_mut } {
                reg.from_unsafe_static = true;
            }
            if c.has_tls && ((unsafe { (*st_it).is_tls }) || conc_item_has_attr(view(*c), st_it, 91usize)) {
                reg.from_tls = true;
            }
        }
        let ety = unsafe_get_expr_ty(view(*c), expr);
        let sty = if ety.v != 0u32 { ety } else { unsafe_get_sym_ty(view(*c), sym_v) };
        if conc_type_is_atomic(view(*c), (TypeId { v: sty.v })) {
            reg.from_atomic = true;
            reg.is_sync_wrapper = true;
        } else if conc_type_is_sync_wrapper(view(*c), (TypeId { v: sty.v })) {
            reg.is_sync_wrapper = true;
        }
        if conc_type_is_guard(view(*c), (TypeId { v: sty.v })) {
            reg.from_guard = true;
        }
        return reg;
    }
    if ek == HIR_EXPR_FIELD {
        let base = unsafe { (*expr).base as *const HirExpr };
        let mut reg = conc_extract_region(mut_view(*c), base);
        if reg.is_valid {
            let p = ConcProj {
                kind: CONC_PROJ_FIELD,
                field_name: unsafe { (*expr).name.v },
                start_const: 0u64,
                end_const: 0u64,
                start_sym: 0u32,
                end_sym: 0u32,
                has_start: false,
                has_end: false,
                start_is_const: false,
                end_is_const: false,
            };
            conc_region_push_proj(mut_view(reg), view(p));
            let fty = unsafe_get_expr_ty(view(*c), expr);
            if conc_type_is_atomic(view(*c), (TypeId { v: fty.v })) {
                reg.from_atomic = true;
                reg.is_sync_wrapper = true;
            } else if conc_type_is_sync_wrapper(view(*c), (TypeId { v: fty.v })) {
                reg.is_sync_wrapper = true;
            }
        }
        return reg;
    }
    if ek == HIR_EXPR_TUPLE_INDEX {
        let base = unsafe { (*expr).base as *const HirExpr };
        let mut reg = conc_extract_region(c, base);
        if reg.is_valid {
            let p = ConcProj {
                kind: CONC_PROJ_TUPLE,
                field_name: unsafe { (*expr).tuple_index },
                start_const: 0u64,
                end_const: 0u64,
                start_sym: 0u32,
                end_sym: 0u32,
                has_start: false,
                has_end: false,
                start_is_const: false,
                end_is_const: false,
            };
            conc_region_push_proj(mut_view(reg), view(p));
        }
        return reg;
    }
    if ek == HIR_EXPR_INDEX {
        let base = unsafe { (*expr).base as *const HirExpr };
        let idx = unsafe { (*expr).index_arg as *const HirExpr };
        let mut reg = conc_extract_region(mut_view(*c), base);
        if reg.is_valid && (idx as usize) != 0 {
            let ik = unsafe { (*idx).kind };
            if ik == HIR_EXPR_RANGE {
                let se = unsafe { (*idx).start_expr as *const HirExpr };
                let ee = unsafe { (*idx).end_expr as *const HirExpr };
                let has_s = (se as usize) != 0;
                let has_e = (ee as usize) != 0;
                let mut sc: u64 = 0u64;
                let mut ec: u64 = 0u64;
                let mut ssym: u32 = 0u32;
                let mut esym: u32 = 0u32;
                let s_is_c = if has_s { conc_eval_index_bound(view(*c), se, mut_view(sc), mut_view(ssym)) } else { true };
                let e_is_c = if has_e { conc_eval_index_bound(view(*c), ee, mut_view(ec), mut_view(esym)) } else { false };
                let p = ConcProj {
                    kind: CONC_PROJ_SLICE,
                    field_name: 0u32,
                    start_const: sc,
                    end_const: ec,
                    start_sym: ssym,
                    end_sym: esym,
                    has_start: has_s,
                    has_end: has_e,
                    start_is_const: s_is_c,
                    end_is_const: e_is_c,
                };
                conc_region_push_proj(mut_view(reg), view(p));
            } else {
                let mut ic: u64 = 0u64;
                let mut isym: u32 = 0u32;
                let is_c = conc_eval_index_bound(view(*c), idx, mut_view(ic), mut_view(isym));
                let p = ConcProj {
                    kind: if is_c { CONC_PROJ_INDEX_CONST } else { CONC_PROJ_INDEX_DYN },
                    field_name: 0u32,
                    start_const: ic,
                    end_const: 0u64,
                    start_sym: isym,
                    end_sym: 0u32,
                    has_start: true,
                    has_end: false,
                    start_is_const: is_c,
                    end_is_const: false,
                };
                conc_region_push_proj(mut_view(reg), view(p));
            }
        }
        return reg;
    }
    conc_empty_region(c)
}

fn conc_region_relate(a: view<ConcRegion>, b: view<ConcRegion>) -> u8 {
    if !a.is_valid || !b.is_valid {
        return CONC_REL_DISJOINT;
    }
    let same_root = (a.root_sym != 0u32 && a.root_sym == b.root_sym) ||
                    (a.root_name != 0u32 && a.root_name == b.root_name);
    if !same_root {
        return CONC_REL_DISJOINT;
    }
    let min_len = if (a.proj_count) < b.proj_count { a.proj_count } else { b.proj_count };
    let mut i: usize = 0;
    while i < min_len {
        let pa = unsafe { conc_proj_at(a.projs, i) };
        let pb = unsafe { conc_proj_at(b.projs, i) };
        let ka = unsafe { (*pa).kind };
        let kb = unsafe { (*pb).kind };
        if ka == CONC_PROJ_FIELD && kb == CONC_PROJ_FIELD {
            if (unsafe { (*pa).field_name }) != (unsafe { (*pb).field_name }) {
                return CONC_REL_DISJOINT;
            }
        } else if ka == CONC_PROJ_TUPLE && kb == CONC_PROJ_TUPLE {
            if (unsafe { (*pa).field_name }) != (unsafe { (*pb).field_name }) {
                return CONC_REL_DISJOINT;
            }
        } else if ka == CONC_PROJ_INDEX_CONST && kb == CONC_PROJ_INDEX_CONST {
            if (unsafe { (*pa).start_const }) != (unsafe { (*pb).start_const }) {
                return CONC_REL_DISJOINT;
            }
        } else if ka == CONC_PROJ_INDEX_DYN || kb == CONC_PROJ_INDEX_DYN {
            return CONC_REL_UNKNOWN;
        } else if ka == CONC_PROJ_SLICE && kb == CONC_PROJ_SLICE {
            let a_hs = unsafe { (*pa).has_start };
            let a_he = unsafe { (*pa).has_end };
            let b_hs = unsafe { (*pb).has_start };
            let b_he = unsafe { (*pb).has_end };
            let a_ssym = unsafe { (*pa).start_sym };
            let a_esym = unsafe { (*pa).end_sym };
            let b_ssym = unsafe { (*pb).start_sym };
            let b_esym = unsafe { (*pb).end_sym };
            if a_he && b_hs && a_esym != 0u32 && a_esym == b_ssym {
                return CONC_REL_DISJOINT;
            }
            if b_he && a_hs && b_esym != 0u32 && b_esym == a_ssym {
                return CONC_REL_DISJOINT;
            }
            let a_s_ok = !a_hs || (unsafe { (*pa).start_is_const });
            let b_s_ok = !b_hs || (unsafe { (*pb).start_is_const });
            let a_e_ok = a_he && (unsafe { (*pa).end_is_const });
            let b_e_ok = b_he && (unsafe { (*pb).end_is_const });
            let a_s = if a_hs { unsafe { (*pa).start_const } } else { 0u64 };
            let b_s = if b_hs { unsafe { (*pb).start_const } } else { 0u64 };
            let a_e = unsafe { (*pa).end_const };
            let b_e = unsafe { (*pb).end_const };
            if a_e_ok && b_s_ok && a_e <= b_s {
                return CONC_REL_DISJOINT;
            }
            if b_e_ok && a_s_ok && b_e <= a_s {
                return CONC_REL_DISJOINT;
            }
            let same_s = (!a_hs && !b_hs) || (a_s_ok && b_s_ok && a_s == b_s) || (a_hs && b_hs && a_ssym != 0u32 && a_ssym == b_ssym);
            let same_e = (!a_he && !b_he) || (a_e_ok && b_e_ok && a_e == b_e) || (a_he && b_he && a_esym != 0u32 && a_esym == b_esym);
            if same_s && same_e {
                // identical slice range at level i
            } else if a_s_ok && b_s_ok && a_e_ok && b_e_ok {
                let max_s = if a_s > b_s { a_s } else { b_s };
                let min_e = if a_e < b_e { a_e } else { b_e };
                if max_s < min_e {
                    return CONC_REL_OVERLAP;
                }
                return CONC_REL_DISJOINT;
            } else {
                return CONC_REL_UNKNOWN;
            }
        } else {
            return CONC_REL_UNKNOWN;
        }
        i = i + 1;
    }
    if a.proj_count == b.proj_count {
        return CONC_REL_EQUAL;
    }
    CONC_REL_OVERLAP
}

fn conc_register_let_binding(c: mut_view<UnsafeChecker>, stmt: *const HirStmt) {
    if (stmt as usize) == 0 || (c.binds as usize) == 0 || c.bind_count >= c.bind_cap {
        return;
    }
    let pat: *const HirPat = unsafe { (*stmt).pat as *const HirPat };
    let init: *const HirExpr = unsafe { (*stmt).expr as *const HirExpr };
    if (pat as usize) == 0 {
        return;
    }
    let sym_v = unsafe { (*pat).symbol.v };
    let name_v = unsafe { (*pat).path.name.v };
    if sym_v == 0u32 && name_v == 0u32 {
        return;
    }
    let mut ty = unsafe_get_sym_ty(view(*c), sym_v);
    if ty.v == 0u32 && (init as usize) != 0 {
        ty = unsafe_get_expr_ty(view(*c), init);
    }
    let mut is_v = false;
    let mut is_mv = false;
    if ty.v != 0u32 && (c.thir as usize) != 0 {
        let t = unsafe { type_get(view((*c.thir).interner), TypeId { v: ty.v }) };
        if (t as usize) != 0 {
            let tk = unsafe { (*t).kind };
            if tk == TY_VIEW {
                is_v = true;
            } else if tk == TY_MUT_VIEW {
                is_v = true;
                is_mv = true;
            }
        }
    }
    let mut cval: u64 = 0u64;
    let mut dummy_sym: u32 = 0u32;
    let has_c = if (init as usize) != 0 {
        conc_eval_index_bound(view(*c), init, mut_view(cval), mut_view(dummy_sym))
    } else {
        false
    };
    let mut reg = if (init as usize) != 0 {
        conc_extract_region(mut_view(*c), init)
    } else {
        conc_empty_region(mut_view(*c))
    };
    let is_grd = conc_type_is_guard(view(*c), TypeId { v: ty.v }) || reg.from_guard;
    let is_atm = conc_type_is_atomic(view(*c), TypeId { v: ty.v });
    if is_grd {
        reg.from_guard = true;
        if !reg.is_valid {
            reg.root_sym = if sym_v != 0u32 { sym_v } else { name_v };
            reg.root_name = name_v;
            reg.is_valid = true;
        }
    }
    if is_atm && !reg.is_valid {
        reg.root_sym = if sym_v != 0u32 { sym_v } else { name_v };
        reg.root_name = name_v;
        reg.is_valid = true;
        reg.from_atomic = true;
        reg.is_sync_wrapper = true;
    }
    if !reg.is_valid {
        reg.root_sym = if sym_v != 0u32 { sym_v } else { name_v };
        reg.root_name = name_v;
        reg.is_valid = true;
        if conc_type_is_sync_wrapper(view(*c), (TypeId { v: ty.v })) {
            reg.is_sync_wrapper = true;
        }
    }
    let clos_e: *const HirExpr = if (init as usize) != 0 && (unsafe { (*init).kind }) == HIR_EXPR_CLOSURE {
        init
    } else {
        0 as *const HirExpr
    };
    let slot = unsafe { conc_bind_at(c.binds, c.bind_count) };
    unsafe {
        (*slot).sym = sym_v;
        (*slot).name = name_v;
        (*slot).scope_depth = c.block_depth;
        (*slot).ty = ty;
        (*slot).is_view = is_v;
        (*slot).is_mut_view = is_mv;
        (*slot).is_guard = is_grd;
        (*slot).is_atomic = is_atm;
        (*slot).has_const_int = has_c;
        (*slot).const_int_val = cval;
        (*slot).closure_expr = clos_e;
        (*slot).is_tls = reg.from_tls;
        (*slot).region = reg;
    }
    c.bind_count = c.bind_count + 1;
}

fn conc_expr_is_from_tls(c: mut_view<UnsafeChecker>, expr: *const HirExpr) -> bool {
    if !c.has_tls || (expr as usize) == 0 {
        return false;
    }
    let ety = unsafe_get_expr_ty(view(*c), expr);
    if ety.v != 0u32 && (c.thir as usize) != 0 {
        let t = unsafe { type_get(view((*c.thir).interner), ety) };
        if (t as usize) != 0 {
            let tk = unsafe { (*t).kind };
            if tk != TY_VIEW && tk != TY_MUT_VIEW {
                return false;
            }
        }
    }
    let reg = conc_extract_region(mut_view(*c), expr);
    if reg.from_tls {
        return true;
    }
    let b = conc_lookup_bind(view(*c), reg.root_sym, reg.root_name);
    if (b as usize) != 0 && (unsafe { (*b).is_tls }) {
        return true;
    }
    false
}

fn conc_report_tls_escape(c: mut_view<UnsafeChecker>, span: Span) {
    let msg = conc_alloc_str(mut_view(*c), 92usize);
    let empty_sv = StrView { ptr: 0 as *const u8, len: 0 };
    report_conc_diag(c, AX_CONC_TLS_ESCAPE, span, msg, empty_sv, empty_sv);
}

fn conc_expr_is_from_guard(c: mut_view<UnsafeChecker>, expr: *const HirExpr, out_min_scope: mut_view<i32>) -> bool {
    *out_min_scope = 0;
    if (expr as usize) == 0 {
        return false;
    }
    let ety = unsafe_get_expr_ty(view(*c), expr);
    let reg = conc_extract_region(mut_view(*c), expr);
    if !conc_type_is_guard(view(*c), ety) && !reg.from_guard {
        return false;
    }
    let b = conc_lookup_bind(view(*c), reg.root_sym, reg.root_name);
    if (b as usize) != 0 {
        *out_min_scope = unsafe { (*b).scope_depth };
    } else {
        *out_min_scope = c.block_depth;
    }
    true
}

fn conc_report_guard_escape(c: mut_view<UnsafeChecker>, span: Span, detail: usize) {
    let msg = conc_alloc_str(mut_view(*c), detail);
    let n1 = conc_alloc_str(mut_view(*c), 48usize);
    let n2 = conc_alloc_str(mut_view(*c), 49usize);
    report_conc_diag(c, AX_CONC_GUARD_ESCAPE, span, msg, n1, n2);
}

fn conc_report_view_not_share(c: mut_view<UnsafeChecker>, span: Span, name_v: u32) {
    let name_sv = conc_get_name_sv(view(*c), name_v);
    let msg = if name_sv.len > 0 {
        conc_alloc_concat3(mut_view(*c), 50usize, view(name_sv), 51usize)
    } else {
        conc_alloc_str(mut_view(*c), 52usize)
    };
    let n1 = conc_alloc_str(mut_view(*c), 53usize);
    let n2 = conc_alloc_str(mut_view(*c), 54usize);
    report_conc_diag(c, AX_CONC_VIEW_NOT_SHARE, span, msg, n1, n2);
}

fn conc_report_unsync_static(c: mut_view<UnsafeChecker>, span: Span, name_v: u32) {
    let name_sv = conc_get_name_sv(view(*c), name_v);
    let msg = conc_alloc_concat3(mut_view(*c), 55usize, view(name_sv), 56usize);
    let n1 = conc_alloc_str(mut_view(*c), 57usize);
    let n2 = conc_alloc_str(mut_view(*c), 58usize);
    report_conc_diag(c, AX_CONC_UNSYNC_STATIC, span, msg, n1, n2);
}

fn conc_report_atomic_mut_view(c: mut_view<UnsafeChecker>, span: Span, name_v: u32) {
    let name_sv = conc_get_name_sv(view(*c), name_v);
    let msg = conc_alloc_concat3(mut_view(*c), 59usize, view(name_sv), 60usize);
    let n1 = conc_alloc_str(mut_view(*c), 61usize);
    let n2 = conc_alloc_str(mut_view(*c), 62usize);
    report_conc_diag(c, AX_CONC_ATOMIC_MUT_VIEW, span, msg, n1, n2);
}

fn conc_branch_push_access(branch: mut_view<ConcBranch>, is_write: bool, span: Span, reg: view<ConcRegion>, c: mut_view<UnsafeChecker>) {
    if !reg.is_valid || (branch.accesses as usize) == 0 || branch.access_count >= 16 {
        return;
    }
    if reg.is_sync_wrapper && reg.proj_count == 0 && !is_write && !reg.from_unsafe_static && !reg.from_unsafe_ptr {
        return;
    }
    let mut i: usize = 0;
    while i < branch.access_count {
        let ex = unsafe { conc_access_at(branch.accesses, i) };
        let rel = unsafe { conc_region_relate(view((*ex).region), reg) };
        if rel == CONC_REL_EQUAL {
            if is_write && !(unsafe { (*ex).is_write }) {
                unsafe {
                    (*ex).is_write = true;
                    (*ex).span = conc_copy_span(view(span));
                }
            }
            return;
        }
        i = i + 1;
    }
    let slot = unsafe { conc_access_at(branch.accesses, branch.access_count) };
    let cloned = conc_clone_region(c, reg);
    unsafe {
        (*slot).is_write = is_write;
        (*slot).span = conc_copy_span(view(span));
        (*slot).region = cloned;
    }
    branch.access_count = branch.access_count + 1;
}

fn conc_is_local_to_closure(sym_v: u32, local_syms: *mut u32, local_count: usize) -> bool {
    if sym_v == 0u32 || (local_syms as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < local_count {
        let s = unsafe { *((local_syms as usize + mul_usize(i, size_of<u32>())) as *const u32) };
        if s == sym_v {
            return true;
        }
        i = i + 1;
    }
    false
}

fn conc_push_local_sym(sym_v: u32, local_syms: *mut u32, local_count: mut_view<usize>) {
    if sym_v != 0u32 && (local_syms as usize) != 0 && (*local_count) < 32 {
        let p = (local_syms as usize + mul_usize(*local_count, size_of<u32>())) as *mut u32;
        unsafe { *p = sym_v; }
        *local_count = (*local_count) + 1;
    }
}

fn conc_collect_stmt(
    c: mut_view<UnsafeChecker>,
    stmt: *const HirStmt,
    branch: mut_view<ConcBranch>,
    local_syms: *mut u32,
    local_count: mut_view<usize>,
    is_unscoped_spawn: bool
) {
    if (stmt as usize) == 0 {
        return;
    }
    let sk = unsafe { (*stmt).kind };
    if sk == HIR_STMT_LET {
        let pat: *const HirPat = unsafe { (*stmt).pat as *const HirPat };
        if (pat as usize) != 0 {
            let psym = if (unsafe { (*pat).symbol.v }) != 0u32 { unsafe { (*pat).symbol.v } } else { unsafe { (*pat).path.name.v } };
            conc_push_local_sym(psym, local_syms, mut_view(*local_count));
        }
        let ex = unsafe { (*stmt).expr as *const HirExpr };
        if (ex as usize) != 0 {
            conc_collect_expr(mut_view(*c), ex, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
        }
    } else if sk == HIR_STMT_ASSIGN {
        let lex = unsafe { (*stmt).left as *const HirExpr };
        let rex = unsafe { (*stmt).right as *const HirExpr };
        if (lex as usize) != 0 {
            let lreg = conc_extract_region(mut_view(*c), lex);
            if lreg.is_valid && !conc_is_local_to_closure(lreg.root_sym, local_syms, *local_count) {
                let lsp = Span { file: FileId { v: unsafe { (*lex).span.file.v } }, start: unsafe { (*lex).span.start }, end: unsafe { (*lex).span.end } };
                conc_branch_push_access(mut_view(*branch), true, lsp, view(lreg), mut_view(*c));
            }
        }
        if (rex as usize) != 0 {
            conc_collect_expr(c, rex, branch, local_syms, local_count, is_unscoped_spawn);
        }
    } else if sk == HIR_STMT_EXPR {
        let ex = unsafe { (*stmt).expr as *const HirExpr };
        if (ex as usize) != 0 {
            conc_collect_expr(c, ex, branch, local_syms, local_count, is_unscoped_spawn);
        }
    }
}

fn conc_collect_block(
    c: mut_view<UnsafeChecker>,
    blk: *const HirBlock,
    branch: mut_view<ConcBranch>,
    local_syms: *mut u32,
    local_count: mut_view<usize>,
    is_unscoped_spawn: bool
) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s = unsafe { (*blk).stmts as *const HirStmt };
    while (s as usize) != 0 {
        conc_collect_stmt(mut_view(*c), s, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
        s = unsafe { (*s).next as *const HirStmt };
    }
}

fn conc_collect_expr(
    c: mut_view<UnsafeChecker>,
    expr: *const HirExpr,
    branch: mut_view<ConcBranch>,
    local_syms: *mut u32,
    local_count: mut_view<usize>,
    is_unscoped_spawn: bool
) {
    if (expr as usize) == 0 {
        return;
    }
    let ek = unsafe { (*expr).kind };
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_COMPTIME {
        conc_collect_block(c, unsafe { (*expr).block as *const HirBlock }, branch, local_syms, local_count, is_unscoped_spawn);
        return;
    }
    if ek == HIR_EXPR_VIEW {
        let is_m = unsafe { (*expr).is_mut };
        let inner = unsafe { (*expr).inner as *const HirExpr };
        let reg = conc_extract_region(mut_view(*c), inner);
        if reg.is_valid && !conc_is_local_to_closure(reg.root_sym, local_syms, *local_count) {
            if reg.from_guard {
                conc_report_guard_escape(mut_view(*c), conc_copy_span(view(sp)), 63usize);
            }
            if reg.from_tls {
                let st_it = conc_find_static_item(view(*c), reg.root_sym, reg.root_name);
                if (st_it as usize) == 0 {
                    conc_report_tls_escape(mut_view(*c), conc_copy_span(view(sp)));
                }
            }
            if !is_m {
                let ity = unsafe_get_expr_ty(view(*c), inner);
                if !conc_type_is_share(view(*c), ity) {
                    conc_report_view_not_share(mut_view(*c), conc_copy_span(view(sp)), reg.root_name);
                }
            } else if reg.from_atomic {
                conc_report_atomic_mut_view(mut_view(*c), conc_copy_span(view(sp)), reg.root_name);
            }
            conc_branch_push_access(branch, is_m, sp, view(reg), c);
        }
        return;
    }
    if ek == HIR_EXPR_PATH || ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX || ek == HIR_EXPR_INDEX ||
       (ek == HIR_EXPR_UNARY && (unsafe { (*expr).op }) == UNOP_DEREF) {
        if ek == HIR_EXPR_PATH {
            let p_sym_v = unsafe { (*expr).path.symbol.v };
            let p_name_v = unsafe { (*expr).path.name.v };
            let st_it = conc_find_static_item(view(*c), p_sym_v, p_name_v);
            if (st_it as usize) != 0 && ((unsafe { (*st_it).is_tls }) || conc_item_has_attr(view(*c), st_it, 91usize)) {
                return;
            }
        }
        if ek == HIR_EXPR_INDEX {
            let idx = unsafe { (*expr).index_arg as *const HirExpr };
            if (idx as usize) != 0 {
                conc_collect_expr(mut_view(*c), idx, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
            }
        }
        let reg = conc_extract_region(mut_view(*c), expr);
        if reg.is_valid && !conc_is_local_to_closure(reg.root_sym, local_syms, *local_count) {
            if reg.from_guard {
                conc_report_guard_escape(mut_view(*c), conc_copy_span(view(sp)), 64usize);
            }
            if reg.from_tls {
                let st_it = conc_find_static_item(view(*c), reg.root_sym, reg.root_name);
                if (st_it as usize) == 0 {
                    conc_report_tls_escape(mut_view(*c), conc_copy_span(view(sp)));
                }
            }
            let mut is_w = false;
            if ek == HIR_EXPR_PATH {
                let sym_v = unsafe { (*expr).path.symbol.v };
                let name_v = unsafe { (*expr).path.name.v };
                let b = conc_lookup_bind(view(*c), sym_v, name_v);
                if (b as usize) != 0 {
                    if unsafe { (*b).is_mut_view } {
                        is_w = true;
                        if reg.from_atomic {
                            conc_report_atomic_mut_view(mut_view(*c), conc_copy_span(view(sp)), reg.root_name);
                        }
                    } else if unsafe { (*b).is_view } {
                        let bty = unsafe { (*b).ty };
                        if !conc_type_is_share(view(*c), bty) {
                            conc_report_view_not_share(mut_view(*c), conc_copy_span(view(sp)), reg.root_name);
                        }
                    } else if is_unscoped_spawn && !reg.from_unsafe_static && !reg.from_unsafe_ptr {
                        return;
                    }
                } else if is_unscoped_spawn && !reg.from_unsafe_static && !reg.from_unsafe_ptr {
                    return;
                }
            } else if ek == HIR_EXPR_INDEX {
                let base_e = unsafe { (*expr).base as *const HirExpr };
                if (base_e as usize) != 0 && (unsafe { (*base_e).kind }) == HIR_EXPR_PATH {
                    let b = conc_lookup_bind(view(*c), unsafe { (*base_e).path.symbol.v }, unsafe { (*base_e).path.name.v });
                    if (b as usize) != 0 && (unsafe { (*b).is_mut_view }) {
                        is_w = true;
                    }
                }
            }
            let ety = unsafe_get_expr_ty(view(*c), expr);
            if !is_w && !is_unscoped_spawn && !reg.is_sync_wrapper {
                if !conc_type_is_share(view(*c), ety) {
                    conc_report_view_not_share(mut_view(*c), conc_copy_span(view(sp)), reg.root_name);
                }
            }
            conc_branch_push_access(branch, is_w, sp, view(reg), c);
        }
        return;
    }
    if ek == HIR_EXPR_METHOD_CALL {
        let recv = unsafe { (*expr).receiver as *const HirExpr };
        let rreg = conc_extract_region(mut_view(*c), recv);
        if rreg.is_valid && !conc_is_local_to_closure(rreg.root_sym, local_syms, *local_count) {
            if rreg.from_guard {
                conc_report_guard_escape(mut_view(*c), conc_copy_span(view(sp)), 65usize);
            }
            if rreg.from_tls {
                let st_it = conc_find_static_item(view(*c), rreg.root_sym, rreg.root_name);
                if (st_it as usize) == 0 {
                    conc_report_tls_escape(mut_view(*c), conc_copy_span(view(sp)));
                }
            }
            let mut is_mut_method = false;
            if (c.thir as usize) != 0 {
                let mp = unsafe { thir_get_expr_method(view(*c.thir), expr) };
                if (mp as usize) != 0 && (unsafe { *mp as usize }) != 0 {
                    let m_item = unsafe { *mp };
                    let fty = unsafe_get_item_ty(view(*c), m_item);
                    if fty.v != 0u32 {
                        let ft = unsafe { type_get(view((*c.thir).interner), fty) };
                        if (ft as usize) != 0 && (unsafe { (*ft).param_count }) > 0 {
                            let p0 = TypeId { v: unsafe { (*typeid_at((*ft).param_types, 0)).v } };
                            let p0t = unsafe { type_get(view((*c.thir).interner), p0) };
                            if (p0t as usize) != 0 && (unsafe { (*p0t).kind }) == TY_MUT_VIEW {
                                is_mut_method = true;
                            }
                        }
                    }
                }
            }
            if rreg.from_atomic {
                let mut root_reg = conc_empty_region(mut_view(*c));
                root_reg.root_sym = rreg.root_sym;
                root_reg.root_name = rreg.root_name;
                root_reg.is_valid = true;
                root_reg.from_atomic = true;
                root_reg.is_sync_wrapper = true;
                conc_branch_push_access(mut_view(*branch), false, conc_copy_span(view(sp)), view(root_reg), mut_view(*c));
            } else if !rreg.is_sync_wrapper {
                conc_branch_push_access(mut_view(*branch), is_mut_method, conc_copy_span(view(sp)), view(rreg), mut_view(*c));
            }
        }
        let mut arg = unsafe { (*expr).args as *const HirExpr };
        while (arg as usize) != 0 {
            conc_collect_expr(mut_view(*c), arg, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
            arg = unsafe { (*arg).next as *const HirExpr };
        }
        return;
    }
    if ek == HIR_EXPR_CALL {
        let mut arg = unsafe { (*expr).args as *const HirExpr };
        while (arg as usize) != 0 {
            conc_collect_expr(mut_view(*c), arg, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
            arg = unsafe { (*arg).next as *const HirExpr };
        }
        return;
    }
    if ek == HIR_EXPR_BINARY {
        conc_collect_expr(mut_view(*c), unsafe { (*expr).left as *const HirExpr }, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
        conc_collect_expr(c, unsafe { (*expr).right as *const HirExpr }, branch, local_syms, local_count, is_unscoped_spawn);
        return;
    }
    if ek == HIR_EXPR_UNARY || ek == HIR_EXPR_CAST || ek == HIR_EXPR_TRY || ek == HIR_EXPR_AWAIT || ek == HIR_EXPR_JUMP {
        conc_collect_expr(c, unsafe { (*expr).inner as *const HirExpr }, branch, local_syms, local_count, is_unscoped_spawn);
        return;
    }
    if ek == HIR_EXPR_IF {
        conc_collect_expr(mut_view(*c), unsafe { (*expr).cond as *const HirExpr }, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
        conc_collect_block(mut_view(*c), unsafe { (*expr).block as *const HirBlock }, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
        if (unsafe { (*expr).else_branch as usize }) != 0 {
            conc_collect_expr(c, unsafe { (*expr).else_branch as *const HirExpr }, branch, local_syms, local_count, is_unscoped_spawn);
        }
        return;
    }
    if ek == HIR_EXPR_WHILE {
        conc_collect_expr(mut_view(*c), unsafe { (*expr).cond as *const HirExpr }, mut_view(*branch), local_syms, mut_view(*local_count), is_unscoped_spawn);
        conc_collect_block(c, unsafe { (*expr).block as *const HirBlock }, branch, local_syms, local_count, is_unscoped_spawn);
        return;
    }
    if ek == HIR_EXPR_LOOP {
        conc_collect_block(c, unsafe { (*expr).block as *const HirBlock }, branch, local_syms, local_count, is_unscoped_spawn);
        return;
    }
    if ek == HIR_EXPR_CLOSURE {
        let mut p = unsafe { (*expr).params as *const HirParam };
        while (p as usize) != 0 {
            let psym = if (unsafe { (*p).symbol.v }) != 0u32 { unsafe { (*p).symbol.v } } else { unsafe { (*p).name.v } };
            conc_push_local_sym(psym, local_syms, mut_view(*local_count));
            p = unsafe { (*p).next as *const HirParam };
        }
        conc_collect_expr(c, unsafe { (*expr).body as *const HirExpr }, branch, local_syms, local_count, is_unscoped_spawn);
        return;
    }
}

fn conc_init_branch(c: mut_view<UnsafeChecker>, b: mut_view<ConcBranch>, sp: Span) {
    let acc = if (c.sink as usize) != 0 {
        unsafe { arena_alloc_raw(mut_view((*c.sink).arena), mul_usize(16, size_of<ConcAccess>()), align_of<ConcAccess>()) as *mut ConcAccess }
    } else {
        0 as *mut ConcAccess
    };
    b.accesses = acc;
    b.access_count = 0;
    b.branch_span = conc_copy_span(view(sp));
}

fn conc_populate_branch_from_arg(c: mut_view<UnsafeChecker>, arg: *const HirExpr, branch: mut_view<ConcBranch>, is_unscoped_spawn: bool) {
    if (arg as usize) == 0 || (c.sink as usize) == 0 {
        return;
    }
    let local_syms = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), mul_usize(32, size_of<u32>()), align_of<u32>()) as *mut u32 };
    let mut local_count: usize = 0;
    let ak = unsafe { (*arg).kind };
    if ak == HIR_EXPR_PATH {
        let b = conc_lookup_bind(view(*c), unsafe { (*arg).path.symbol.v }, unsafe { (*arg).path.name.v });
        if (b as usize) != 0 && (unsafe { (*b).closure_expr as usize }) != 0 {
            let clos = unsafe { (*b).closure_expr };
            conc_collect_expr(c, clos, branch, local_syms, mut_view(local_count), is_unscoped_spawn);
            return;
        }
    }
    conc_collect_expr(c, arg, branch, local_syms, mut_view(local_count), is_unscoped_spawn);
}

fn conc_compare_branches(c: mut_view<UnsafeChecker>, b1: view<ConcBranch>, b2: view<ConcBranch>, call_span: Span) {
    let mut i: usize = 0;
    while i < b1.access_count {
        let a1 = unsafe { conc_access_at(b1.accesses, i) };
        let w1 = unsafe { (*a1).is_write };
        let mut j: usize = 0;
        while j < b2.access_count {
            let a2 = unsafe { conc_access_at(b2.accesses, j) };
            let w2 = unsafe { (*a2).is_write };
            if (unsafe { (*a1).region.from_tls }) || (unsafe { (*a2).region.from_tls }) {
                j = j + 1;
                continue;
            }
            let same_root = ((unsafe { (*a1).region.root_sym }) != 0u32 && (unsafe { (*a1).region.root_sym }) == (unsafe { (*a2).region.root_sym })) ||
                            ((unsafe { (*a1).region.root_name }) != 0u32 && (unsafe { (*a1).region.root_name }) == (unsafe { (*a2).region.root_name }));
            if same_root && ((unsafe { (*a1).region.from_atomic }) || (unsafe { (*a2).region.from_atomic })) && (w1 || w2) {
                let sp = if w2 { unsafe { conc_copy_span(view((*a2).span)) } } else { unsafe { conc_copy_span(view((*a1).span)) } };
                conc_report_atomic_mut_view(mut_view(*c), sp, unsafe { (*a1).region.root_name });
                return;
            }
            if w1 || w2 {
                let rel = unsafe { conc_region_relate(view((*a1).region), view((*a2).region)) };
                if rel != CONC_REL_DISJOINT {
                    let s1 = unsafe { conc_copy_span(view((*a1).span)) };
                    let s2 = unsafe { conc_copy_span(view((*a2).span)) };
                    let p_sp = if s2.start != 0u32 || s2.end != 0u32 { conc_copy_span(view(s2)) } else { conc_copy_span(view(call_span)) };
                    report_conc_shared_mut_diag(
                        mut_view(*c),
                        p_sp,
                        s1,
                        s2,
                        w1,
                        w2,
                        unsafe { (*a1).region.root_name },
                        rel
                    );
                    return;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn conc_is_multi_branch_call_name(sv: view<StrView>) -> bool {
    conc_sv_eq_lit(sv, 66usize) ||
    conc_sv_eq_lit(sv, 67usize) ||
    conc_sv_eq_lit(sv, 68usize) ||
    conc_sv_eq_lit(sv, 69usize) ||
    conc_sv_eq_lit(sv, 70usize) ||
    conc_sv_eq_lit(sv, 71usize) ||
    conc_sv_eq_lit(sv, 72usize) ||
    conc_sv_eq_lit(sv, 73usize) ||
    conc_sv_eq_lit(sv, 74usize) ||
    conc_sv_starts_with(sv, 75usize) ||
    conc_sv_starts_with(sv, 76usize)
}

fn conc_is_scoped_spawn_call_name(sv: view<StrView>) -> bool {
    conc_sv_eq_lit(sv, 77usize) ||
    conc_sv_eq_lit(sv, 78usize) ||
    conc_sv_eq_lit(sv, 79usize) ||
    conc_sv_eq_lit(sv, 80usize) ||
    conc_sv_eq_lit(sv, 81usize) ||
    conc_sv_eq_lit(sv, 82usize) ||
    conc_sv_eq_lit(sv, 83usize) ||
    conc_sv_eq_lit(sv, 84usize)
}

fn conc_is_unscoped_spawn_call_name(sv: view<StrView>) -> bool {
    conc_sv_eq_lit(sv, 85usize) || conc_sv_eq_lit(sv, 86usize)
}

fn conc_check_call_concurrency(c: mut_view<UnsafeChecker>, expr: *const HirExpr, call_span: Span) {
    if (expr as usize) == 0 || (c.sink as usize) == 0 {
        return;
    }
    let ek = unsafe { (*expr).kind };
    let mut name_sv = StrView { ptr: 0 as *const u8, len: 0 };
    let mut is_method = false;
    if ek == HIR_EXPR_CALL {
        let callee = unsafe { (*expr).callee as *const HirExpr };
        if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
            name_sv = conc_get_name_sv(view(*c), unsafe { (*callee).path.name.v });
        }
    } else if ek == HIR_EXPR_METHOD_CALL {
        is_method = true;
        name_sv = conc_get_name_sv(view(*c), unsafe { (*expr).method_name.v });
    }
    if name_sv.len == 0 {
        return;
    }
    let is_multi = conc_is_multi_branch_call_name(view(name_sv));
    let is_scoped = conc_is_scoped_spawn_call_name(view(name_sv)) ||
                    (is_method && (conc_sv_eq_lit(view(name_sv), 77usize) || conc_sv_eq_lit(view(name_sv), 85usize) || conc_sv_eq_lit(view(name_sv), 87usize)));
    let is_unscoped = !is_method && conc_is_unscoped_spawn_call_name(view(name_sv));
    if !is_multi && !is_scoped && !is_unscoped {
        return;
    }

    let mut argc: usize = 0;
    let mut a = unsafe { (*expr).args as *const HirExpr };
    while (a as usize) != 0 {
        argc = argc + 1;
        a = unsafe { (*a).next as *const HirExpr };
    }
    if argc == 0 {
        return;
    }
    let branches = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), mul_usize(argc, size_of<ConcBranch>()), align_of<ConcBranch>()) as *mut ConcBranch };
    let mut idx: usize = 0;
    a = unsafe { (*expr).args as *const HirExpr };
    while (a as usize) != 0 {
        let asp = Span { file: FileId { v: unsafe { (*a).span.file.v } }, start: unsafe { (*a).span.start }, end: unsafe { (*a).span.end } };
        let br = unsafe { conc_branch_at(branches, idx) };
        unsafe {
            conc_init_branch(mut_view(*c), mut_view(*br), asp);
            conc_populate_branch_from_arg(mut_view(*c), a, mut_view(*br), is_unscoped);
        }
        idx = idx + 1;
        a = unsafe { (*a).next as *const HirExpr };
    }
    if argc >= 2 {
        let mut i: usize = 0;
        while i < argc {
            let mut j = i + 1;
            while j < argc {
                let bi = unsafe { conc_branch_at(branches, i) };
                let bj = unsafe { conc_branch_at(branches, j) };
                unsafe {
                    conc_compare_branches(mut_view(*c), view(*bi), view(*bj), conc_copy_span(view(call_span)));
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }
}

fn is_callee_unsafe(c: view<UnsafeChecker>, callee: *const HirExpr) -> bool {
    if (callee as usize) == 0 {
        return false;
    }
    let cty = unsafe_get_expr_ty(c, callee);
    if cty.v != 0u32 && (c.thir as usize) != 0 {
        let ft = unsafe { type_get(view((*c.thir).interner), cty) };
        if (ft as usize) != 0 {
            let ftk = unsafe { (*ft).kind };
            if ftk == TY_BUILTIN_ADDRESS_OF ||
                ftk == TY_BUILTIN_ADDRESS_OF_MUT ||
                ftk == TY_BUILTIN_PTR_ADD ||
                ftk == TY_BUILTIN_PTR_SUB ||
                ftk == TY_BUILTIN_DROP_IN_PLACE ||
                ftk == TY_BUILTIN_PTR_COPY ||
                ftk == TY_BUILTIN_PTR_COPY_NONOVERLAPPING ||
                ftk == TY_BUILTIN_PTR_WRITE_BYTES {
                return true;
            }
            if ftk == TY_FN && (unsafe { (*ft).is_unsafe }) {
                return true;
            }
        }
    }

    let ck = unsafe { (*callee).kind };
    if ck == HIR_EXPR_PATH && (c.hir as usize) != 0 {
        let name_v = unsafe { (*callee).path.name.v };
        let sym_v = unsafe { (*callee).path.symbol.v };
        if name_v != 0u32 || sym_v != 0u32 {
            let mut it = unsafe { (*c.hir).items as *const HirItem };
            while ((it as usize) != 0) {
                let ik = unsafe { (*it).kind };
                if ik == HIR_ITEM_FN {
                    let it_name = unsafe { (*it).name.v };
                    let it_sym = unsafe { (*it).symbol.v };
                    if (sym_v != 0u32 && it_sym == sym_v) || (name_v != 0u32 && it_name == name_v) {
                        if unsafe { (*it).is_unsafe } {
                            return true;
                        }
                    }
                } else if ik == HIR_ITEM_IMPL {
                    let mut m = unsafe { (*it).members as *const HirItem };
                    while ((m as usize) != 0) {
                        let mk = unsafe { (*m).kind };
                        if mk == HIR_ITEM_FN {
                            let m_name = unsafe { (*m).name.v };
                            let m_sym = unsafe { (*m).symbol.v };
                            if (sym_v != 0u32 && m_sym == sym_v) || (name_v != 0u32 && m_name == name_v) {
                                if unsafe { (*m).is_unsafe } {
                                    return true;
                                }
                            }
                        }
                        m = unsafe { (*m).next as *const HirItem };
                    }
                }
                it = unsafe { (*it).next as *const HirItem };
            }
        }
    }
    false
}

pub fn unsafe_check_stmt(c: mut_view<UnsafeChecker>, stmt: *const HirStmt) {
    if (stmt as usize) == 0 {
        return;
    }
    let sk = unsafe { (*stmt).kind };
    if sk == HIR_STMT_LET {
        let ex = unsafe { (*stmt).expr as *const HirExpr };
        if (ex as usize) != 0 {
            unsafe_check_expr(mut_view(*c), ex);
        }
        conc_register_let_binding(mut_view(*c), stmt);
        let eb = unsafe { (*stmt).else_block as *const HirBlock };
        if (eb as usize) != 0 {
            unsafe_check_block(mut_view(*c), eb);
        }
    } else if sk == HIR_STMT_ASSIGN {
        let rex = unsafe { (*stmt).right as *const HirExpr };
        let lex = unsafe { (*stmt).left as *const HirExpr };
        unsafe_check_expr(mut_view(*c), rex);
        unsafe_check_expr(mut_view(*c), lex);
        if (lex as usize) != 0 && (rex as usize) != 0 && (unsafe { (*lex).kind }) == HIR_EXPR_PATH {
            let mut min_scope: i32 = 0;
            if conc_expr_is_from_guard(mut_view(*c), rex, mut_view(min_scope)) {
                let lb = conc_lookup_bind(view(*c), unsafe { (*lex).path.symbol.v }, unsafe { (*lex).path.name.v });
                if (lb as usize) != 0 && (unsafe { (*lb).scope_depth }) < min_scope {
                    let sp = Span { file: FileId { v: unsafe { (*stmt).span.file.v } }, start: unsafe { (*stmt).span.start }, end: unsafe { (*stmt).span.end } };
                    conc_report_guard_escape(mut_view(*c), sp, 88usize);
                }
            }
            if conc_expr_is_from_tls(mut_view(*c), rex) {
                let lb = conc_lookup_bind(view(*c), unsafe { (*lex).path.symbol.v }, unsafe { (*lex).path.name.v });
                if (lb as usize) != 0 && (unsafe { (*lb).scope_depth }) < c.block_depth {
                    let sp = Span { file: FileId { v: unsafe { (*stmt).span.file.v } }, start: unsafe { (*stmt).span.start }, end: unsafe { (*stmt).span.end } };
                    conc_report_tls_escape(mut_view(*c), sp);
                }
            }
        }
    } else if sk == HIR_STMT_EXPR {
        let ex = unsafe { (*stmt).expr as *const HirExpr };
        unsafe_check_expr(mut_view(*c), ex);
    }
}

fn conc_stmt_extract_spawn_task(c: view<UnsafeChecker>, stmt: *const HirStmt, out_is_unscoped: mut_view<bool>) -> *const HirExpr {
    *out_is_unscoped = false;
    if (stmt as usize) == 0 {
        return 0 as *const HirExpr;
    }
    let sk = unsafe { (*stmt).kind };
    let ex: *const HirExpr = if sk == HIR_STMT_EXPR || sk == HIR_STMT_LET {
        unsafe { (*stmt).expr as *const HirExpr }
    } else {
        0 as *const HirExpr
    };
    if (ex as usize) == 0 {
        return 0 as *const HirExpr;
    }
    let ek = unsafe { (*ex).kind };
    if ek == HIR_EXPR_CALL {
        let callee = unsafe { (*ex).callee as *const HirExpr };
        if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
            let sv = conc_get_name_sv(c, unsafe { (*callee).path.name.v });
            if conc_is_scoped_spawn_call_name(view(sv)) {
                return unsafe { (*ex).args as *const HirExpr };
            }
            if conc_is_unscoped_spawn_call_name(view(sv)) {
                *out_is_unscoped = true;
                return unsafe { (*ex).args as *const HirExpr };
            }
        }
    } else if ek == HIR_EXPR_METHOD_CALL {
        let sv = conc_get_name_sv(c, unsafe { (*ex).method_name.v });
        if conc_sv_eq_lit(view(sv), 77usize) || conc_sv_eq_lit(view(sv), 85usize) || conc_sv_eq_lit(view(sv), 87usize) {
            return unsafe { (*ex).args as *const HirExpr };
        }
    }
    0 as *const HirExpr
}

pub fn unsafe_check_block(c: mut_view<UnsafeChecker>, block: *const HirBlock) {
    if (block as usize) == 0 {
        return;
    }
    let saved_binds = c.bind_count;
    c.block_depth = c.block_depth + 1;
    let cur_depth = c.block_depth;

    let mut s = unsafe { (*block).stmts as *const HirStmt };
    let mut last_stmt: *const HirStmt = 0 as *const HirStmt;
    let mut task_count: usize = 0;
    while ((s as usize) != 0) {
        unsafe_check_stmt(mut_view(*c), s);
        let mut is_unsc = false;
        let t_arg = conc_stmt_extract_spawn_task(view(*c), s, mut_view(is_unsc));
        if (t_arg as usize) != 0 {
            task_count = task_count + 1;
        }
        last_stmt = s;
        s = unsafe { (*s).next as *const HirStmt };
    }

    if task_count >= 2 && (c.sink as usize) != 0 {
        let branches = unsafe { arena_alloc_raw(mut_view((*c.sink).arena), mul_usize(task_count, size_of<ConcBranch>()), align_of<ConcBranch>()) as *mut ConcBranch };
        let mut tidx: usize = 0;
        let mut ts = unsafe { (*block).stmts as *const HirStmt };
        while (ts as usize) != 0 && tidx < task_count {
            let mut is_unsc = false;
            let t_arg = conc_stmt_extract_spawn_task(view(*c), ts, mut_view(is_unsc));
            if (t_arg as usize) != 0 {
                let tsp = Span { file: FileId { v: unsafe { (*t_arg).span.file.v } }, start: unsafe { (*t_arg).span.start }, end: unsafe { (*t_arg).span.end } };
                let br = unsafe { conc_branch_at(branches, tidx) };
                unsafe {
                    conc_init_branch(mut_view(*c), mut_view(*br), tsp);
                    conc_populate_branch_from_arg(mut_view(*c), t_arg, mut_view(*br), is_unsc);
                }
                tidx = tidx + 1;
            }
            ts = unsafe { (*ts).next as *const HirStmt };
        }
        let mut i: usize = 0;
        while i < tidx {
            let mut j = i + 1;
            while j < tidx {
                let bi = unsafe { conc_branch_at(branches, i) };
                let bj = unsafe { conc_branch_at(branches, j) };
                let bsp = unsafe { conc_copy_span(view((*bj).branch_span)) };
                unsafe {
                    conc_compare_branches(mut_view(*c), view(*bi), view(*bj), bsp);
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    if (last_stmt as usize) != 0 && (unsafe { (*last_stmt).kind }) == HIR_STMT_EXPR && !(unsafe { (*last_stmt).has_semi }) {
        let tail_e = unsafe { (*last_stmt).expr as *const HirExpr };
        if (tail_e as usize) != 0 {
            let mut min_scope: i32 = 0;
            if conc_expr_is_from_guard(mut_view(*c), tail_e, mut_view(min_scope)) {
                if min_scope >= cur_depth || cur_depth == 1 {
                    let sp = Span { file: FileId { v: unsafe { (*tail_e).span.file.v } }, start: unsafe { (*tail_e).span.start }, end: unsafe { (*tail_e).span.end } };
                    conc_report_guard_escape(mut_view(*c), sp, 89usize);
                }
            }
            if (cur_depth == 1 || c.block_depth == 1) && conc_expr_is_from_tls(mut_view(*c), tail_e) {
                let sp = Span { file: FileId { v: unsafe { (*tail_e).span.file.v } }, start: unsafe { (*tail_e).span.start }, end: unsafe { (*tail_e).span.end } };
                conc_report_tls_escape(mut_view(*c), sp);
            }
        }
    }

    c.block_depth = c.block_depth - 1;
    c.bind_count = saved_binds;
}

pub fn unsafe_check_expr(c: mut_view<UnsafeChecker>, expr: *const HirExpr) {
    if (expr as usize) == 0 {
        return;
    }
    let ek = unsafe { (*expr).kind };
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };

    if ek == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        let name_v = unsafe { (*expr).path.name.v };
        let st_it = conc_find_static_item(view(*c), sym_v, name_v);
        if (st_it as usize) != 0 {
            if (unsafe { (*st_it).is_mut }) && c.unsafe_depth == 0 && !(unsafe { (*st_it).is_tls }) {
                conc_report_unsync_static(c, sp, unsafe { (*st_it).name.v });
            }
        }
        return;
    }

    if ek == HIR_EXPR_UNSAFE {
        c.unsafe_depth = c.unsafe_depth + 1;
        let blk = unsafe { (*expr).block as *const HirBlock };
        unsafe_check_block(mut_view(*c), blk);
        c.unsafe_depth = c.unsafe_depth - 1;
    } else if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_COMPTIME {
        let blk = unsafe { (*expr).block as *const HirBlock };
        unsafe_check_block(c, blk);
    } else if ek == HIR_EXPR_CLOSURE {
        let saved = c.unsafe_depth;
        c.unsafe_depth = 0;
        let bdy = unsafe { (*expr).body as *const HirExpr };
        unsafe_check_expr(mut_view(*c), bdy);
        c.unsafe_depth = saved;
    } else if ek == HIR_EXPR_UNARY {
        let op = unsafe { (*expr).op };
        let inner = unsafe { (*expr).inner as *const HirExpr };
        if op == UNOP_DEREF {
            let op_ty = unsafe_get_expr_ty(view(*c), inner);
            if op_ty.v != 0u32 && (c.thir as usize) != 0 {
                let t = unsafe { type_get(view((*c.thir).interner), op_ty) };
                if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_PTR {
                    if c.unsafe_depth == 0 {
                        report_unsafe_required(mut_view(*c), sp);
                    }
                }
            }
        }
        unsafe_check_expr(c, inner);
    } else if ek == HIR_EXPR_FIELD {
        let base = unsafe { (*expr).base as *const HirExpr };
        let base_ty = unsafe_get_expr_ty(view(*c), base);
        if base_ty.v != 0u32 && (c.thir as usize) != 0 {
            let t = unsafe { type_get(view((*c.thir).interner), base_ty) };
            if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_PTR {
                if c.unsafe_depth == 0 {
                    report_unsafe_required(mut_view(*c), sp);
                }
            }
        }
        unsafe_check_expr(c, base);
    } else if ek == HIR_EXPR_BINARY {
        let op = unsafe { (*expr).op };
        let left = unsafe { (*expr).left as *const HirExpr };
        let right = unsafe { (*expr).right as *const HirExpr };
        if op == BINOP_ADD || op == BINOP_SUB {
            let lty = unsafe_get_expr_ty(view(*c), left);
            let rty = unsafe_get_expr_ty(view(*c), right);
            let mut is_ptr_arith = false;
            if lty.v != 0u32 && (c.thir as usize) != 0 {
                let lt = unsafe { type_get(view((*c.thir).interner), lty) };
                if (lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_PTR {
                    is_ptr_arith = true;
                }
            }
            if rty.v != 0u32 && (c.thir as usize) != 0 {
                let rt = unsafe { type_get(view((*c.thir).interner), rty) };
                if (rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR {
                    is_ptr_arith = true;
                }
            }
            if is_ptr_arith && c.unsafe_depth == 0 {
                report_unsafe_required(mut_view(*c), sp);
            }
        }
        unsafe_check_expr(mut_view(*c), left);
        unsafe_check_expr(c, right);
    } else if ek == HIR_EXPR_CALL {
        let callee = unsafe { (*expr).callee as *const HirExpr };
        if is_callee_unsafe(view(*c), callee) {
            if c.unsafe_depth == 0 {
                report_unsafe_required(mut_view(*c), conc_copy_span(view(sp)));
            }
        }
        unsafe_check_expr(mut_view(*c), callee);
        let mut arg = unsafe { (*expr).args as *const HirExpr };
        while ((arg as usize) != 0) {
            unsafe_check_expr(mut_view(*c), arg);
            arg = unsafe { (*arg).next as *const HirExpr };
        }
        conc_check_call_concurrency(c, expr, sp);
    } else if ek == HIR_EXPR_METHOD_CALL {
        if (c.thir as usize) != 0 {
            let mp = unsafe { thir_get_expr_method(view(*c.thir), expr) };
            if (mp as usize) != 0 {
                let m_item = unsafe { *mp };
                if (m_item as usize) != 0 && (unsafe { (*m_item).is_unsafe }) {
                    if c.unsafe_depth == 0 {
                        report_unsafe_required(mut_view(*c), conc_copy_span(view(sp)));
                    }
                }
            }
        }
        let recv = unsafe { (*expr).receiver as *const HirExpr };
        unsafe_check_expr(mut_view(*c), recv);
        let mut arg = unsafe { (*expr).args as *const HirExpr };
        while ((arg as usize) != 0) {
            unsafe_check_expr(mut_view(*c), arg);
            arg = unsafe { (*arg).next as *const HirExpr };
        }
        conc_check_call_concurrency(c, expr, sp);
    } else if ek == HIR_EXPR_IF {
        let cond = unsafe { (*expr).cond as *const HirExpr };
        let blk = unsafe { (*expr).block as *const HirBlock };
        let else_br = unsafe { (*expr).else_branch as *const HirExpr };
        unsafe_check_expr(mut_view(*c), cond);
        unsafe_check_block(mut_view(*c), blk);
        if (else_br as usize) != 0 {
            unsafe_check_expr(c, else_br);
        }
    } else if ek == HIR_EXPR_MATCH {
        let cond = unsafe { (*expr).cond as *const HirExpr };
        let inner = unsafe { (*expr).inner as *const HirExpr };
        if (cond as usize) != 0 {
            unsafe_check_expr(mut_view(*c), cond);
        } else if (inner as usize) != 0 {
            unsafe_check_expr(mut_view(*c), inner);
        }
        let mut arm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((arm as usize) != 0) {
            let grd = unsafe { (*arm).guard as *const HirExpr };
            let bdy = unsafe { (*arm).body as *const HirExpr };
            if (grd as usize) != 0 {
                unsafe_check_expr(mut_view(*c), grd);
            }
            unsafe_check_expr(mut_view(*c), bdy);
            arm = unsafe { (*arm).next as *const HirMatchArm };
        }
    } else if ek == HIR_EXPR_LOOP {
        let blk = unsafe { (*expr).block as *const HirBlock };
        unsafe_check_block(c, blk);
    } else if ek == HIR_EXPR_WHILE {
        let cond = unsafe { (*expr).cond as *const HirExpr };
        let blk = unsafe { (*expr).block as *const HirBlock };
        unsafe_check_expr(mut_view(*c), cond);
        unsafe_check_block(c, blk);
    } else if ek == HIR_EXPR_FOR {
        let iter = unsafe { (*expr).iter as *const HirExpr };
        let blk = unsafe { (*expr).block as *const HirBlock };
        unsafe_check_expr(mut_view(*c), iter);
        unsafe_check_block(c, blk);
    } else if ek == HIR_EXPR_TUPLE || ek == HIR_EXPR_ARRAY {
        let mut e = unsafe { (*expr).elems as *const HirExpr };
        while ((e as usize) != 0) {
            unsafe_check_expr(mut_view(*c), e);
            e = unsafe { (*e).next as *const HirExpr };
        }
        let ce = unsafe { (*expr).count_expr as *const HirExpr };
        if (ce as usize) != 0 {
            unsafe_check_expr(c, ce);
        }
    } else if ek == HIR_EXPR_STRUCT {
        let mut f = unsafe { (*expr).fields as *const HirFieldInit };
        while ((f as usize) != 0) {
            let fe = unsafe { (*f).expr as *const HirExpr };
            unsafe_check_expr(mut_view(*c), fe);
            f = unsafe { (*f).next as *const HirFieldInit };
        }
    } else if ek == HIR_EXPR_VIEW {
        let inner = unsafe { (*expr).inner as *const HirExpr };
        if (unsafe { (*expr).is_mut }) && (inner as usize) != 0 && (unsafe { (*inner).kind }) == HIR_EXPR_FIELD {
            let base = unsafe { (*inner).base as *const HirExpr };
            let bty = unsafe_get_expr_ty(view(*c), base);
            if conc_type_is_atomic(view(*c), bty) {
                let breg = conc_extract_region(mut_view(*c), base);
                conc_report_atomic_mut_view(mut_view(*c), conc_copy_span(view(sp)), breg.root_name);
            }
        }
        unsafe_check_expr(c, inner);
    } else if ek == HIR_EXPR_CAST || ek == HIR_EXPR_TRY || ek == HIR_EXPR_AWAIT {
        let inner = unsafe { (*expr).inner as *const HirExpr };
        unsafe_check_expr(c, inner);
    } else if ek == HIR_EXPR_INDEX {
        let base = unsafe { (*expr).base as *const HirExpr };
        let idx = unsafe { (*expr).index_arg as *const HirExpr };
        unsafe_check_expr(mut_view(*c), base);
        unsafe_check_expr(c, idx);
    } else if ek == HIR_EXPR_TUPLE_INDEX {
        let base = unsafe { (*expr).base as *const HirExpr };
        unsafe_check_expr(c, base);
    } else if ek == HIR_EXPR_JUMP {
        let inner = unsafe { (*expr).inner as *const HirExpr };
        if (inner as usize) != 0 {
            if (unsafe { (*expr).jump_kind }) == JUMP_RETURN {
                let mut min_scope: i32 = 0;
                if conc_expr_is_from_guard(mut_view(*c), inner, mut_view(min_scope)) {
                    conc_report_guard_escape(mut_view(*c), conc_copy_span(view(sp)), 90usize);
                }
                if conc_expr_is_from_tls(mut_view(*c), inner) {
                    conc_report_tls_escape(mut_view(*c), conc_copy_span(view(sp)));
                }
            }
            unsafe_check_expr(c, inner);
        }
    } else if ek == HIR_EXPR_RANGE {
        let s = unsafe { (*expr).start_expr as *const HirExpr };
        let e = unsafe { (*expr).end_expr as *const HirExpr };
        if (s as usize) != 0 {
            unsafe_check_expr(mut_view(*c), s);
        }
        if (e as usize) != 0 {
            unsafe_check_expr(c, e);
        }
    }
}

pub fn unsafe_check_item(c: mut_view<UnsafeChecker>, it: *const HirItem) {
    if (it as usize) == 0 {
        return;
    }
    let ik = unsafe { (*it).kind };
    if ik == HIR_ITEM_FN {
        let bdy = unsafe { (*it).body as *const HirBlock };
        if (bdy as usize) != 0 {
            c.current_fn = it;
            c.bind_count = 0;
            c.block_depth = 0;
            c.unsafe_depth = if unsafe { (*it).is_unsafe } { 1 } else { 0 };
            unsafe_check_block(c, bdy);
        }
    } else if ik == HIR_ITEM_IMPL {
        let mut m = unsafe { (*it).members as *const HirItem };
        while ((m as usize) != 0) {
            let mk = unsafe { (*m).kind };
            if mk == HIR_ITEM_FN {
                let mbdy = unsafe { (*m).body as *const HirBlock };
                if (mbdy as usize) != 0 {
                    c.current_fn = m;
                    c.bind_count = 0;
                    c.block_depth = 0;
                    c.unsafe_depth = if unsafe { (*m).is_unsafe } { 1 } else { 0 };
                    unsafe_check_block(mut_view(*c), mbdy);
                }
            }
            m = unsafe { (*m).next as *const HirItem };
        }
    } else if ik == HIR_ITEM_STATIC {
        let ex = unsafe { (*it).expr as *const HirExpr };
        if !(unsafe { (*it).is_mut }) && !(unsafe { (*it).is_tls }) {
            let sty = unsafe_get_item_ty(view(*c), it);
            let st_ty = if sty.v != 0u32 { sty } else { unsafe_get_expr_ty(view(*c), ex) };
            if st_ty.v != 0u32 && !conc_type_is_share(view(*c), st_ty) {
                let sp = Span { file: FileId { v: unsafe { (*it).span.file.v } }, start: unsafe { (*it).span.start }, end: unsafe { (*it).span.end } };
                conc_report_unsync_static(mut_view(*c), sp, unsafe { (*it).name.v });
            }
        }
        if (ex as usize) != 0 {
            c.unsafe_depth = if unsafe { (*it).is_unsafe } { 1 } else { 0 };
            unsafe_check_expr(c, ex);
        }
    } else if ik == HIR_ITEM_CONST {
        let ex = unsafe { (*it).expr as *const HirExpr };
        if (ex as usize) != 0 {
            c.unsafe_depth = 0;
            unsafe_check_expr(c, ex);
        }
    }
}

pub fn unsafe_check(
    hir: view<HirFile>,
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    interner: view<StrInterner>
) {
    let bind_cap: usize = 128;
    let binds = unsafe {
        arena_alloc_raw(mut_view(sink.arena), mul_usize(bind_cap, size_of<ConcBind>()), align_of<ConcBind>()) as *mut ConcBind
    };
    let mut any_tls = false;
    let mut it_scan = hir.items as *const HirItem;
    while ((it_scan as usize) != 0) {
        if (unsafe { (*it_scan).is_tls }) {
            any_tls = true;
            break;
        }
        it_scan = unsafe { (*it_scan).next as *const HirItem };
    }
    let mut c = UnsafeChecker {
        hir: unsafe { address_of(*hir) },
        thir: unsafe { address_of(*thir) },
        sink: unsafe { address_of_mut(*sink) },
        interner: unsafe { address_of(*interner) },
        unsafe_depth: 0,
        block_depth: 0,
        current_fn: 0 as *const HirItem,
        binds: binds,
        bind_count: 0,
        bind_cap: bind_cap,
        has_tls: any_tls,
    };

    let mut it = hir.items as *const HirItem;
    while ((it as usize) != 0) {
        unsafe_check_item(mut_view(c), it);
        it = unsafe { (*it).next as *const HirItem };
    }
}
