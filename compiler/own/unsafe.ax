pub struct ConcProj {
    pub kind: u8,
    pub field_name: u32,
    pub start_const: u64,
    pub end_const: u64,
    pub start_sym: u32,
    pub end_sym: u32,
    pub has_start: bool,
    pub has_end: bool,
    pub start_is_const: bool,
    pub end_is_const: bool,
}

pub struct ConcRegion {
    pub root_sym: u32,
    pub root_name: u32,
    pub projs: *mut ConcProj,
    pub proj_count: usize,
    pub is_valid: bool,
    pub from_unsafe_static: bool,
    pub from_unsafe_ptr: bool,
    pub from_guard: bool,
    pub from_atomic: bool,
    pub is_sync_wrapper: bool,
    pub from_tls: bool,
}

pub struct ConcBind {
    pub sym: u32,
    pub name: u32,
    pub scope_depth: i32,
    pub ty: TypeId,
    pub is_view: bool,
    pub is_mut_view: bool,
    pub is_guard: bool,
    pub is_atomic: bool,
    pub is_tls: bool,
    pub has_const_int: bool,
    pub const_int_val: u64,
    pub closure_expr: *const HirExpr,
    pub region: ConcRegion,
}

pub struct ConcAccess {
    pub is_write: bool,
    pub span: Span,
    pub region: ConcRegion,
}

pub struct ConcBranch {
    pub accesses: *mut ConcAccess,
    pub access_count: usize,
    pub branch_span: Span,
}

pub struct UnsafeChecker {
    pub hir: *const HirFile,
    pub thir: *const Thir,
    pub sink: *mut DiagSink,
    pub interner: *const StrInterner,
    pub unsafe_depth: i32,
    pub block_depth: i32,
    pub current_fn: *const HirItem,
    pub binds: *mut ConcBind,
    pub bind_count: usize,
    pub bind_cap: usize,
    pub has_tls: bool,
}

unsafe fn conc_proj_at(base: *mut ConcProj, idx: usize) -> *mut ConcProj {
    ((base as usize) + mul_usize(idx, size_of<ConcProj>())) as *mut ConcProj
}

unsafe fn conc_bind_at(base: *mut ConcBind, idx: usize) -> *mut ConcBind {
    ((base as usize) + mul_usize(idx, size_of<ConcBind>())) as *mut ConcBind
}

unsafe fn conc_access_at(base: *mut ConcAccess, idx: usize) -> *mut ConcAccess {
    ((base as usize) + mul_usize(idx, size_of<ConcAccess>())) as *mut ConcAccess
}

unsafe fn conc_branch_at(base: *mut ConcBranch, idx: usize) -> *mut ConcBranch {
    ((base as usize) + mul_usize(idx, size_of<ConcBranch>())) as *mut ConcBranch
}

unsafe fn conc_label_at(base: *mut DiagLabel, idx: usize) -> *mut DiagLabel {
    ((base as usize) + mul_usize(idx, size_of<DiagLabel>())) as *mut DiagLabel
}

unsafe fn conc_sv_at(base: *mut StrView, idx: usize) -> *mut StrView {
    ((base as usize) + mul_usize(idx, size_of<StrView>())) as *mut StrView
}

fn conc_copy_span(s: view<Span>) -> Span {
    Span { file: FileId { v: s.file.v }, start: s.start, end: s.end }
}

