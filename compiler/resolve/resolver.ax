const PRELUDE_24_IDX: [24]usize = [
    0, 3, 8, 12, 11, 29, 34, 172, 173, 13, 14, 15, 16, 6, 1, 7, 2, 9, 4, 174, 175, 43, 176, 177,
];


pub struct ResolverEnv {
    pub root_module: *mut Module,
    pub current_module: *mut Module,
    pub prelude_scope: *mut Scope,
    pub modules_list: *mut Module,
    pub alloc_scopes: *mut Scope,
    pub resolved_use_trees: NodeMap,
    pub ast_items: *mut AstItem,
    pub next_extern_symbol_v: u32,
}

unsafe fn res_strid_slot(base: *mut StrId, idx: usize) -> *mut StrId {
    let off = ((idx as isize) * (size_of<StrId>() as isize)) as usize;
    ((base as usize) + off) as *mut StrId
}

unsafe fn res_visited_slot(base: *mut VisitedImport, idx: usize) -> *mut VisitedImport {
    let off = ((idx as isize) * (size_of<VisitedImport>() as isize)) as usize;
    ((base as usize) + off) as *mut VisitedImport
}

fn res_str_in_arena(arena: mut_view<Arena>, idx: usize) -> StrView {
    let start = RESOLVE_OFF[idx] as usize;
    let end = RESOLVE_OFF[idx + 1] as usize;
    let byte_len = end - start;
    let dst = arena_alloc_raw(arena, byte_len + 1, 1);
    let mut i: usize = 0;
    while i < byte_len {
        unsafe { *(dst + i) = RESOLVE_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + byte_len) = 0u8; }
    StrView { ptr: dst as *const u8, len: byte_len }
}

fn res_sv_eq_idx(sv: StrView, idx: usize) -> bool {
    let start = RESOLVE_OFF[idx] as usize;
    let end = RESOLVE_OFF[idx + 1] as usize;
    if sv.len != end - start {
        return false;
    }
    let mut i: usize = 0;
    while i < sv.len {
        if (unsafe { *(sv.ptr + i) }) != RESOLVE_DATA[start + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn res_sv_starts_with_idx(sv: StrView, idx: usize) -> bool {
    let start = RESOLVE_OFF[idx] as usize;
    let end = RESOLVE_OFF[idx + 1] as usize;
    let n = end - start;
    if (sv.len) < n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        if (unsafe { *(sv.ptr + i) }) != RESOLVE_DATA[start + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn is_std_mod(m: *mut Module) -> bool {
    if (m as usize) == 0 {
        return false;
    }
    let fp = unsafe { (*m).full_path };
    if (fp.ptr as usize) == 0 {
        return false;
    }
    res_sv_starts_with_idx((StrView { ptr: fp.ptr, len: fp.len }), 66) || res_sv_eq_idx(fp, 65)
}

fn next_symbol_id(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, node: usize) -> SymbolId {
    let mut v: u32 = 0u32;
    if is_std_mod(env.current_module) {
        if (unsafe { (*rmap).next_std_symbol_v }) == 0u32 {
            unsafe { (*rmap).next_std_symbol_v = 10000u32; }
        }
        v = unsafe { (*rmap).next_std_symbol_v };
        unsafe { (*rmap).next_std_symbol_v = v + 1u32; }
    } else {
        v = unsafe { (*rmap).next_symbol_v };
        unsafe { (*rmap).next_symbol_v = v + 1u32; }
    }
    let id = SymbolId { v: v };
    id
}

fn next_extern_symbol_id(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, node: usize) -> SymbolId {
    if env.next_extern_symbol_v == 0u32 {
        env.next_extern_symbol_v = 30000u32;
    }
    let v = env.next_extern_symbol_v;
    env.next_extern_symbol_v = v + 1u32;
    let id = SymbolId { v: v };
    id
}

fn make_symbol_into(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>,
    name: StrId,
    kind: u8,
    vis: u8,
    is_mut: bool,
    node: usize,
    out_sym: mut_view<Symbol>
) {
    let id = next_symbol_id(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
        node);
    if kind == SYM_FN || kind == SYM_STRUCT || kind == SYM_ENUM || kind == SYM_TRAIT || kind == SYM_CONST ||
        kind == SYM_STATIC || kind == SYM_TYPE_ALIAS {
        let mut mod_sv = StrView { ptr: 0 as *const u8, len: 0 };
        if (env.current_module as usize) != 0 {
            mod_sv = unsafe { (*env.current_module).full_path };
        }
        let mut name_sv = StrView { ptr: 0 as *const u8, len: 0 };
        if name.v != 0u32 {
            name_sv = unsafe { interner_get(view(*interner), StrId { v: name.v }) };
        }
        unsafe { record_symbol_naming(mut_view(*rmap), (SymbolId { v: id.v }), mod_sv, name_sv); }
    }
    out_sym.id.v = id.v;
    out_sym.name.v = name.v;
    out_sym.kind = kind;
    out_sym.vis = vis;
    out_sym.is_mut = is_mut;
    out_sym.def_span.file.v = 0u32;
    out_sym.def_span.start = 0u32;
    out_sym.def_span.end = 0u32;
    out_sym.node = node;
    out_sym.def_module = env.current_module as usize;
}

fn bind_node(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, node: usize, id: SymbolId) {
    if node == 0 {
        return;
    }
    unsafe { nodemap_insert(mut_view((*rmap).node_map), node, id); }
}

fn emit_diag(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, code_val: u32, span: view<Span>) {
    let code = DiagCode { v: code_val };
    let msg_idx = 73 + ((code_val - 44u32) as usize);
    let msg = res_str_in_arena(unsafe { mut_view((*sink).arena) }, msg_idx);
    let d = Diagnostic {
        code: code,
        severity: diag_code_severity(DiagCode { v: code.v }),
        message: msg,
        primary: sp_copy(span),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    unsafe { diag_sink_report(mut_view(*sink), view(d)); }
}

fn sp_copy(s: view<Span>) -> Span {
    Span { file: FileId { v: s.file.v }, start: s.start, end: s.end }
}

fn declare_name_vis(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>,
    scope: *mut Scope,
    name: StrId,
    node: usize,
    span: view<Span>,
    kind: u8,
    vis: u8,
    is_mut: bool
) -> *mut Symbol {
    let mut sym = Symbol {
        id: SymbolId { v: 0u32 },
        name: StrId { v: 0u32 },
        kind: 0u8,
        vis: 0u8,
        is_mut: false,
        def_span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        node: 0,
        def_module: 0,
    };
    make_symbol_into(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
        (StrId { v: name.v }), kind, vis, is_mut, node, mut_view(sym));
    if name.v != 0u32 {
        let is_mod = unsafe { (*scope).is_module_scope };
        if is_mod && (unsafe { symenv_contains(view((*scope).bindings), name.v) }) {
            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                AX_NAME_DUPLICATE, view(*span));
        } else {
            if !is_mod {
                let mut shadowed = false;
                let mut cur_s: *mut Scope = unsafe { (*scope).parent };
                while (cur_s as usize) != 0 && !shadowed {
                    let is_m = unsafe { (*cur_s).is_module_scope };
                    if is_m {
                        let has = unsafe { symenv_contains(view((*cur_s).bindings), name.v) };
                        if has {
                            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                mut_view(*rmap), AX_NAME_SHADOW_MODULE, view(*span));
                            shadowed = true;
                        }
                    }
                    cur_s = unsafe { (*cur_s).parent };
                }
                if !shadowed && (env.current_module as usize) != 0 &&
                    (unsafe { (*env.current_module).name.v }) == name.v {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_SHADOW_MODULE, view(*span));
                    shadowed = true;
                }
                if !shadowed && (env.root_module as usize) != 0 &&
                    (unsafe { symenv_contains(view((*env.root_module).submodules), name.v) }) {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_SHADOW_MODULE, view(*span));
                }
            }
            unsafe { symenv_insert(mut_view((*scope).bindings), name.v, view(sym)); }
        }
    }
    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), node,
        (SymbolId { v: sym.id.v }));
    if name.v != 0u32 {
        unsafe { symenv_get(view((*scope).bindings), name.v) }
    } else {
        0 as *mut Symbol
    }
}

fn declare_name(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>,
    scope: *mut Scope,
    name: StrId,
    node: usize,
    span: view<Span>,
    kind: u8,
    is_mut: bool
) -> *mut Symbol {
    declare_name_vis(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), scope,
        name, node, view(*span), kind, VIS_PRIVATE, is_mut)
}

fn get_or_create_module(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, path: view<AstDottedName>) -> *mut Module {
    if path.count == 0 {
        return env.root_module;
    }
    let mut curr = env.root_module;
    let path_buf = unsafe { arena_alloc_raw(mut_view(*arena), 256, 1) };
    let mut path_len: usize = 0;

    let mut i: usize = 0;
    while i < path.count {
        let seg_id = unsafe { *res_strid_slot(path.segments, i) };
        let seg_sv = unsafe { interner_get(view(*interner), StrId { v: seg_id.v }) };
        if i > 0 && path_len < 255 {
            unsafe { *(path_buf + path_len) = 46u8; }
            path_len = path_len + 1;
        }
        let mut c: usize = 0;
        while c < seg_sv.len && path_len < 255 {
            unsafe { *(path_buf + path_len) = *(seg_sv.ptr + c); }
            path_len = path_len + 1;
            c = c + 1;
        }

        let sub_sym = unsafe { symenv_get(view((*curr).submodules), seg_id.v) };
        if (sub_sym as usize) != 0 {
            curr = (unsafe { (*sub_sym).node }) as *mut Module;
        } else {
            let m = unsafe { arena_alloc_raw(mut_view(*arena), size_of<Module>(),
                align_of<Module>()) as *mut Module };
            let fp_ptr = unsafe { arena_alloc_raw(mut_view(*arena), path_len + 1, 1) };
            let mut k: usize = 0;
            while k < path_len {
                unsafe { *(fp_ptr + k) = *(path_buf + k); }
                k = k + 1;
            }
            unsafe { *(fp_ptr + path_len) = 0u8; }
            let sc = push_scope(unsafe { mut_view(*arena) }, env.prelude_scope, true, false,
                mut_view(env.alloc_scopes));
            unsafe {
                (*m).name.v = seg_id.v;
                (*m).full_path.ptr = fp_ptr as *const u8;
                (*m).full_path.len = path_len;
                (*m).scope = sc;
                symenv_init(mut_view((*m).exports));
                symenv_init(mut_view((*m).submodules));
                (*m).parent = curr;
                (*m).next = env.modules_list;
            }
            env.modules_list = m;

            let saved = env.current_module;
            env.current_module = m;
            let m_id = next_symbol_id(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), m as usize);
            env.current_module = saved;

            let mut m_sym = Symbol {
                id: SymbolId { v: 0u32 },
                name: StrId { v: 0u32 },
                kind: 0u8,
                vis: 0u8,
                is_mut: false,
                def_span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                node: 0,
                def_module: 0,
            };
            m_sym.id.v = m_id.v;
            m_sym.name.v = seg_id.v;
            m_sym.kind = SYM_MODULE;
            m_sym.vis = VIS_PUB;
            m_sym.node = m as usize;
            m_sym.def_module = curr as usize;

            unsafe {
                symenv_insert(mut_view((*curr).submodules), seg_id.v, view(m_sym));
                if (curr as usize) == (env.root_module as usize) {
                    symenv_insert(mut_view((*(*env.root_module).scope).bindings), seg_id.v, view(m_sym));
                }
            }
            curr = m;
        }
        i = i + 1;
    }
    curr
}

fn pkg_prefix_len(sv: view<StrView>) -> usize {
    let mut i: usize = 0;
    while i < sv.len {
        if (unsafe { *(sv.ptr + i) }) == 46u8 {
            return i;
        }
        i = i + 1;
    }
    sv.len
}

fn check_visibility(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, from_mod: *mut Module, sym: *mut Symbol, use_span: view<Span>) -> bool {
    if (sym as usize) == 0 {
        return true;
    }
    let def_mod = (unsafe { (*sym).def_module }) as *mut Module;
    if (def_mod as usize) == 0 || (def_mod as usize) == (from_mod as usize) {
        return true;
    }
    let vis = unsafe { (*sym).vis };
    if vis == VIS_PRIVATE || vis == VIS_PUB_MODULE {
        emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            AX_NAME_PRIVATE, view(*use_span));
        return false;
    }
    if vis == VIS_PUB_PACKAGE {
        if (from_mod as usize) != 0 {
            if is_std_mod(from_mod) != is_std_mod(def_mod) {
                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    AX_NAME_PRIVATE, view(*use_span));
                return false;
            }
            let fp_from = unsafe { (*from_mod).full_path };
            let fp_def = unsafe { (*def_mod).full_path };
            let len_from = pkg_prefix_len(view(fp_from));
            let len_def = pkg_prefix_len(view(fp_def));
            if len_from != len_def {
                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    AX_NAME_PRIVATE, view(*use_span));
                return false;
            }
            let mut i: usize = 0;
            while i < len_from {
                if (unsafe { *(fp_from.ptr + i) }) != (unsafe { *(fp_def.ptr + i) }) {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_PRIVATE, view(*use_span));
                    return false;
                }
                i = i + 1;
            }
        }
    }
    true
}

fn module_submodule(m: *mut Module, key: u32) -> *mut Symbol {
    if (m as usize) == 0 {
        return 0 as *mut Symbol;
    }
    unsafe { symenv_get(view((*m).submodules), key) }
}

fn lookup_name(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, s: *mut Scope, name: StrId) -> *mut Symbol {
    let mut curr = s;
    while (curr as usize) != 0 {
        let sym = unsafe { symenv_get(view((*curr).bindings), name.v) };
        if (sym as usize) != 0 {
            return sym;
        }
        curr = unsafe { (*curr).parent };
    }
    if (env.current_module as usize) != 0 {
        let pmod: *mut Module = unsafe { (*env.current_module).parent };
        let sub = module_submodule(pmod, name.v);
        if (sub as usize) != 0 {
            return sub;
        }
    }
    let root_sub = module_submodule(env.root_module, name.v);
    if (root_sub as usize) != 0 {
        return root_sub;
    }
    if (env.prelude_scope as usize) != 0 {
        let prel = unsafe { symenv_get(view((*env.prelude_scope).bindings), name.v) };
        if (prel as usize) != 0 {
            return prel;
        }
    }
    0 as *mut Symbol
}

fn find_member_in_list(members: *mut AstItem, seg_v: u32) -> *mut AstItem {
    let mut m = members;
    while (m as usize) != 0 {
        let mk = unsafe { (*m).kind };
        if mk == ITEM_FN || mk == ITEM_TYPE_ALIAS || mk == ITEM_CONST {
            if (unsafe { (*m).name.v }) == seg_v {
                return m;
            }
        }
        m = unsafe { (*m).next };
    }
    0 as *mut AstItem
}

fn is_item_sym(k: u8) -> bool {
    k == SYM_FN || k == SYM_STRUCT || k == SYM_ENUM || k == SYM_TRAIT || k == SYM_TYPE_ALIAS ||
        k == SYM_CONST || k == SYM_STATIC
}

fn resolve_path_seg(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, segs: *mut AstTypePathSegment) {
    if (segs as usize) == 0 {
        return;
    }
    let sym = lookup_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
        scope, unsafe { (*segs).name });
    if (sym as usize) == 0 {
        emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            AX_NAME_UNRESOLVED, unsafe { view((*segs).span) });
        return;
    }
    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), segs as usize,
        unsafe { (*sym).id });

    let mut head_node = unsafe { (*sym).node };
    let mut hkind = unsafe { (*sym).kind };
    let mut curr_mod: *mut Module = if hkind == SYM_MODULE { head_node as *mut Module } else { 0 as *mut Module };
    let mut seg: *mut AstTypePathSegment = unsafe { (*segs).next };

    while (seg as usize) != 0 {
        let seg_name = unsafe { (*seg).name };
        let seg_span = unsafe { (*seg).span };
        if hkind == SYM_MODULE && (curr_mod as usize) != 0 {
            let sub = unsafe { symenv_get(view((*curr_mod).submodules), seg_name.v) };
            if (sub as usize) != 0 {
                bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    seg as usize, unsafe { (*sub).id });
                curr_mod = (unsafe { (*sub).node }) as *mut Module;
                head_node = unsafe { (*sub).node };
                hkind = SYM_MODULE;
            } else {
                let exp = unsafe { symenv_get(view((*curr_mod).exports), seg_name.v) };
                if (exp as usize) != 0 {
                    check_visibility(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), env.current_module, exp, view(seg_span));
                    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        seg as usize, unsafe { (*exp).id });
                    head_node = unsafe { (*exp).node };
                    hkind = unsafe { (*exp).kind };
                    curr_mod = 0 as *mut Module;
                } else if unsafe { symenv_contains(view((*(*curr_mod).scope).bindings), seg_name.v) } {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_PRIVATE, view(seg_span));
                    break;
                } else {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_UNRESOLVED, view(seg_span));
                    break;
                }
            }
        } else if is_item_sym(hkind) && head_node != 0 &&
            (unsafe { (*(head_node as *mut AstItem)).kind }) == ITEM_ENUM {
            let en = head_node as *mut AstItem;
            let mut found = false;
            let mut v: *mut AstVariantDecl = unsafe { (*en).variants };
            while (v as usize) != 0 {
                if (unsafe { (*v).name.v }) == seg_name.v {
                    let vid_ptr = unsafe { nodemap_get(view((*rmap).node_map), v as usize) };
                    if (vid_ptr as usize) != 0 && (unsafe { (*vid_ptr).v }) != 0u32 {
                        bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                            mut_view(*rmap), seg as usize, unsafe { *vid_ptr });
                    }
                    head_node = v as usize;
                    hkind = SYM_VARIANT;
                    found = true;
                    break;
                }
                v = unsafe { (*v).next };
            }
            if !found {
                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    AX_NAME_UNRESOLVED, view(seg_span));
                break;
            }
        } else if is_item_sym(hkind) && head_node != 0 {
            let target_item = head_node as *mut AstItem;
            let tk = unsafe { (*target_item).kind };
            let mut found_member: *mut AstItem = 0 as *mut AstItem;
            if tk == ITEM_IMPL {
                found_member = find_member_in_list(unsafe { (*target_item).members }, seg_name.v);
                if (found_member as usize) == 0 && (unsafe { (*target_item).trait_path as usize }) != 0 &&
                    (unsafe { (*(*target_item).trait_path).kind }) == TYPE_PATH &&
                    (unsafe { (*(*target_item).trait_path).segments as usize }) != 0 {
                    let tr_name = unsafe { (*(*(*target_item).trait_path).segments).name };
                    let tr_sym = lookup_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), scope, tr_name);
                    if (tr_sym as usize) != 0 && (unsafe { (*tr_sym).node }) != 0 {
                        let tr = (unsafe { (*tr_sym).node }) as *mut AstItem;
                        if (unsafe { (*tr).kind }) == ITEM_TRAIT {
                            found_member = find_member_in_list(unsafe { (*tr).members }, seg_name.v);
                        }
                    }
                }
            } else if tk == ITEM_TRAIT {
                found_member = find_member_in_list(unsafe { (*target_item).members }, seg_name.v);
            } else if tk == ITEM_STRUCT {
                let sname = unsafe { (*target_item).name };
                let mut it = env.ast_items;
                while (it as usize) != 0 {
                    if (unsafe { (*it).kind }) == ITEM_IMPL && (unsafe { (*it).self_type as usize }) != 0 &&
                        (unsafe { (*(*it).self_type).kind }) == TYPE_PATH &&
                        (unsafe { (*(*it).self_type).segments as usize }) != 0 {
                        if (unsafe { (*(*(*it).self_type).segments).name.v }) == sname.v {
                            found_member = find_member_in_list(unsafe { (*it).members }, seg_name.v);
                            if (found_member as usize) != 0 {
                                break;
                            }
                            if (unsafe { (*it).trait_path as usize }) != 0 &&
                                (unsafe { (*(*it).trait_path).kind }) == TYPE_PATH &&
                                (unsafe { (*(*it).trait_path).segments as usize }) != 0 {
                                let tr_name = unsafe { (*(*(*it).trait_path).segments).name };
                                let tr_sym = lookup_name(mut_view(*env), mut_view(*arena), mut_view(*sink),
                                    mut_view(*interner), mut_view(*rmap), scope, tr_name);
                                if (tr_sym as usize) != 0 && (unsafe { (*tr_sym).node }) != 0 {
                                    let tr = (unsafe { (*tr_sym).node }) as *mut AstItem;
                                    if (unsafe { (*tr).kind }) == ITEM_TRAIT {
                                        found_member = find_member_in_list(unsafe { (*tr).members }, seg_name.v);
                                    }
                                }
                                if (found_member as usize) != 0 {
                                    break;
                                }
                            }
                        }
                    }
                    it = unsafe { (*it).next };
                }
            }

            if (found_member as usize) != 0 {
                let mid = unsafe { nodemap_get(view((*rmap).node_map), found_member as usize) };
                let mut sym_id = SymbolId { v: 0u32 };
                if (mid as usize) != 0 && (unsafe { (*mid).v }) != 0u32 {
                    sym_id.v = unsafe { (*mid).v };
                } else {
                    let nid = next_symbol_id(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), found_member as usize);
                    sym_id.v = nid.v;
                    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        found_member as usize, (SymbolId { v: sym_id.v }));
                }
                bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    seg as usize, (SymbolId { v: sym_id.v }));
                head_node = found_member as usize;
                hkind = SYM_FN;
            } else {
                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    AX_NAME_UNRESOLVED, view(seg_span));
                break;
            }
        } else {
            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                AX_NAME_UNRESOLVED, view(seg_span));
            break;
        }
        seg = unsafe { (*seg).next };
    }
}

fn resolve_type(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, t: *mut AstType) {
    let mut cur = t;
    while (cur as usize) != 0 {
        let next_node: *mut AstType = unsafe { (*cur).next };
        let k = unsafe { (*cur).kind };
        if k == TYPE_PATH {
            resolve_path_seg(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).segments });
        } else if k == TYPE_TUPLE {
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).elem_types });
        } else if k == TYPE_ARRAY {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).count_expr });
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).elem });
        } else if k == TYPE_VIEW || k == TYPE_PTR {
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).elem });
        } else if k == TYPE_FN {
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).param_types });
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).ret_type });
        } else if k == TYPE_DYN {
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).bounds });
        }
        cur = next_node;
    }
}

fn resolve_pat_inner(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, p: *mut AstPat, is_decl: bool,
    pat_env: mut_view<SymEnv>) {
    let mut cur = p;
    while (cur as usize) != 0 {
        let next_node: *mut AstPat = unsafe { (*cur).next };
        let k = unsafe { (*cur).kind };
        if k == PAT_RANGE {
            resolve_pat_inner(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).start_pat }, is_decl, mut_view(*pat_env));
            resolve_pat_inner(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).end_pat }, is_decl, mut_view(*pat_env));
        } else if k == PAT_BINDING {
            let b_name = unsafe { (*cur).name };
            let b_span = unsafe { (*cur).span };
            let b_mut = unsafe { (*cur).is_mut };
            if is_decl {
                if symenv_contains(view(*pat_env), b_name.v) {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_DUPLICATE_BINDING, view(b_span));
                } else {
                    let s = declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), scope, (StrId { v: b_name.v }), cur as usize, view(b_span), SYM_LOCAL, b_mut);
                    if (s as usize) != 0 {
                        unsafe { symenv_insert(mut_view(*pat_env), b_name.v, view(*s)); }
                    }
                }
            } else {
                let sym = lookup_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                    mut_view(*rmap), scope, b_name);
                if (sym as usize) != 0 {
                    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        cur as usize, unsafe { (*sym).id });
                } else {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_UNRESOLVED, view(b_span));
                }
            }
        } else if k == PAT_PATH || k == PAT_STRUCT {
            resolve_path_seg(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).segments });
            if k == PAT_PATH {
                resolve_pat_inner(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                    mut_view(*rmap), scope, unsafe { (*cur).payload }, is_decl, mut_view(*pat_env));
            } else {
                let mut f: *mut AstPatField = unsafe { (*cur).fields };
                while (f as usize) != 0 {
                    let fp = unsafe { (*f).pat };
                    if (fp as usize) != 0 {
                        resolve_pat_inner(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                            mut_view(*rmap), scope, fp, is_decl, mut_view(*pat_env));
                    } else if is_decl {
                        let fname = unsafe { (*f).name };
                        let fspan = unsafe { (*f).span };
                        if symenv_contains(view(*pat_env), fname.v) {
                            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                mut_view(*rmap), AX_NAME_DUPLICATE_BINDING, view(fspan));
                        } else {
                            let s = declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink),
                                mut_view(*interner), mut_view(*rmap), scope, (StrId { v: fname.v }), f as usize,
                                view(fspan), SYM_LOCAL, false);
                            if (s as usize) != 0 {
                                unsafe { symenv_insert(mut_view(*pat_env), fname.v, view(*s)); }
                            }
                        }
                    }
                    f = unsafe { (*f).next };
                }
            }
        } else if k == PAT_TUPLE {
            resolve_pat_inner(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).elems }, is_decl, mut_view(*pat_env));
        } else if k == PAT_OR {
            let mut base_env = SymEnv {
                keys: 0 as *mut u32, vals: 0 as *mut Symbol, states: 0 as *mut u8, len: 0, cap: 0
            };
            symenv_init(mut_view(base_env));
            let or_pats: *mut AstPat = unsafe { (*cur).pats };
            let or_span = unsafe { (*cur).span };
            let first_alt: *mut AstPat = if (or_pats as usize) != 0 {
                unsafe { (*or_pats).next }
            } else {
                0 as *mut AstPat
            };
            resolve_pat_inner(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, or_pats, is_decl, mut_view(base_env));
            if (or_pats as usize) != 0 {
                let mut alt: *mut AstPat = first_alt;
                while (alt as usize) != 0 {
                    let mut alt_env = SymEnv {
                        keys: 0 as *mut u32, vals: 0 as *mut Symbol, states: 0 as *mut u8, len: 0, cap: 0
                    };
                    symenv_init(mut_view(alt_env));
                    let alt_next: *mut AstPat = unsafe { (*alt).next };
                    let alt_span = unsafe { (*alt).span };
                    resolve_pat_inner(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), scope, alt, is_decl, mut_view(alt_env));
                    let mut slot: usize = 0;
                    while slot < base_env.cap {
                        let s1 = symenv_at_slot(view(base_env), slot);
                        if (s1 as usize) != 0 {
                            let key = symenv_key_at_slot(view(base_env), slot);
                            if !symenv_contains(view(alt_env), key) {
                                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                    mut_view(*rmap), AX_NAME_OR_PATTERN_MISMATCH, view(alt_span));
                            }
                        }
                        slot = slot + 1;
                    }
                    slot = 0;
                    while slot < alt_env.cap {
                        let s2 = symenv_at_slot(view(alt_env), slot);
                        if (s2 as usize) != 0 {
                            let key = symenv_key_at_slot(view(alt_env), slot);
                            if !symenv_contains(view(base_env), key) {
                                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                    mut_view(*rmap), AX_NAME_OR_PATTERN_MISMATCH, view(alt_span));
                            }
                        }
                        slot = slot + 1;
                    }
                    symenv_free(mut_view(alt_env));
                    alt = alt_next;
                }
            }
            let mut slot: usize = 0;
            while slot < base_env.cap {
                let s1 = symenv_at_slot(view(base_env), slot);
                if (s1 as usize) != 0 {
                    let key = symenv_key_at_slot(view(base_env), slot);
                    if symenv_contains(view(*pat_env), key) {
                        emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                            mut_view(*rmap), AX_NAME_DUPLICATE_BINDING, view(or_span));
                    } else {
                        symenv_insert(mut_view(*pat_env), key, unsafe { view(*s1) });
                    }
                }
                slot = slot + 1;
            }
            symenv_free(mut_view(base_env));
        }
        cur = next_node;
    }
}

fn resolve_pat(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, p: *mut AstPat, is_decl: bool) {
    let mut pat_env = SymEnv { keys: 0 as *mut u32, vals: 0 as *mut Symbol, states: 0 as *mut u8, len: 0, cap: 0 };
    symenv_init(mut_view(pat_env));
    resolve_pat_inner(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), scope,
        p, is_decl, mut_view(pat_env));
    symenv_free(mut_view(pat_env));
}

fn resolve_block(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, parent_scope: *mut Scope, b: *mut AstBlock) {
    if (b as usize) == 0 {
        return;
    }
    let b_scope = push_scope(unsafe { mut_view(*arena) }, parent_scope, false, true, mut_view(env.alloc_scopes));
    let mut s: *mut AstStmt = unsafe { (*b).stmts };
    while (s as usize) != 0 {
        let sk = unsafe { (*s).kind };
        if sk == STMT_LET {
            if (unsafe { (*s).expr as usize }) != 0 {
                resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    b_scope, unsafe { (*s).expr });
            }
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                b_scope, unsafe { (*s).ty });
            resolve_pat(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                b_scope, unsafe { (*s).pat }, true);
            if (unsafe { (*s).else_block as usize }) != 0 {
                resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    b_scope, unsafe { (*s).else_block });
            }
        } else if sk == STMT_ASSIGN {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                b_scope, unsafe { (*s).left });
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                b_scope, unsafe { (*s).right });
        } else if sk == STMT_EXPR {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                b_scope, unsafe { (*s).expr });
        }
        s = unsafe { (*s).next };
    }
}

fn resolve_expr(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, e: *mut AstExpr) {
    let mut cur = e;
    while (cur as usize) != 0 {
        let next_node: *mut AstExpr = unsafe { (*cur).next };
        let k = unsafe { (*cur).kind };
        if k == EXPR_PATH {
            resolve_path_seg(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).segments });
        } else if k == EXPR_TUPLE {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).elems });
        } else if k == EXPR_PAREN || k == EXPR_VIEW || k == EXPR_UNARY {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).inner });
        } else if k == EXPR_ARRAY {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).elems });
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).count_expr });
        } else if k == EXPR_STRUCT {
            resolve_path_seg(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).segments });
            let mut f: *mut AstFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                if (unsafe { (*f).expr as usize }) != 0 {
                    resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), scope, unsafe { (*f).expr });
                } else {
                    let fsym = lookup_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), scope, unsafe { (*f).name });
                    if (fsym as usize) != 0 {
                        bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                            mut_view(*rmap), f as usize, unsafe { (*fsym).id });
                    } else {
                        emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                            mut_view(*rmap), AX_NAME_UNRESOLVED, unsafe { view((*f).span) });
                    }
                }
                f = unsafe { (*f).next };
            }
        } else if k == EXPR_BLOCK || k == EXPR_UNSAFE || k == EXPR_COMPTIME {
            resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).block });
        } else if k == EXPR_IF {
            if (unsafe { (*cur).let_pat as usize }) != 0 {
                let if_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, true,
                    mut_view(env.alloc_scopes));
                resolve_pat(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    if_scope, unsafe { (*cur).let_pat }, true);
                resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    scope, unsafe { (*cur).cond });
                resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    if_scope, unsafe { (*cur).block });
            } else {
                resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    scope, unsafe { (*cur).cond });
                resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    scope, unsafe { (*cur).block });
            }
            if (unsafe { (*cur).else_branch as usize }) != 0 {
                resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    scope, unsafe { (*cur).else_branch });
            }
        } else if k == EXPR_MATCH {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).cond });
            let mut arm: *mut AstMatchArm = unsafe { (*cur).arms };
            while (arm as usize) != 0 {
                let arm_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, true,
                    mut_view(env.alloc_scopes));
                resolve_pat(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    arm_scope, unsafe { (*arm).pat }, true);
                if (unsafe { (*arm).guard as usize }) != 0 {
                    resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), arm_scope, unsafe { (*arm).guard });
                }
                resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    arm_scope, unsafe { (*arm).body });
                arm = unsafe { (*arm).next };
            }
        } else if k == EXPR_LOOP {
            let l_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, true, mut_view(env.alloc_scopes));
            let lbl = unsafe { (*cur).label };
            if lbl.v != 0u32 {
                declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    l_scope, lbl, cur as usize, unsafe { view((*cur).span) }, SYM_LOCAL, false);
            }
            resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                l_scope, unsafe { (*cur).block });
        } else if k == EXPR_WHILE {
            let l_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, true, mut_view(env.alloc_scopes));
            let lbl = unsafe { (*cur).label };
            if lbl.v != 0u32 {
                declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    l_scope, lbl, cur as usize, unsafe { view((*cur).span) }, SYM_LOCAL, false);
            }
            if (unsafe { (*cur).let_pat as usize }) != 0 {
                let w_scope = push_scope(unsafe { mut_view(*arena) }, l_scope, false, true,
                    mut_view(env.alloc_scopes));
                resolve_pat(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    w_scope, unsafe { (*cur).let_pat }, true);
                resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    l_scope, unsafe { (*cur).cond });
                resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    w_scope, unsafe { (*cur).block });
            } else {
                resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    l_scope, unsafe { (*cur).cond });
                resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    l_scope, unsafe { (*cur).block });
            }
        } else if k == EXPR_FOR {
            let l_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, true, mut_view(env.alloc_scopes));
            let lbl = unsafe { (*cur).label };
            if lbl.v != 0u32 {
                declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    l_scope, lbl, cur as usize, unsafe { view((*cur).span) }, SYM_LOCAL, false);
            }
            let f_scope = push_scope(unsafe { mut_view(*arena) }, l_scope, false, true,
                mut_view(env.alloc_scopes));
            resolve_pat(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                f_scope, unsafe { (*cur).pat }, true);
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                l_scope, unsafe { (*cur).iter });
            resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                f_scope, unsafe { (*cur).block });
        } else if k == EXPR_JUMP {
            let lbl = unsafe { (*cur).label };
            if lbl.v != 0u32 {
                let sym = lookup_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                    mut_view(*rmap), scope, lbl);
                if (sym as usize) != 0 {
                    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        cur as usize, unsafe { (*sym).id });
                } else {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_UNRESOLVED, unsafe { view((*cur).span) });
                }
            }
            if (unsafe { (*cur).inner as usize }) != 0 {
                resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    scope, unsafe { (*cur).inner });
            }
        } else if k == EXPR_CLOSURE {
            let c_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, true, mut_view(env.alloc_scopes));
            let mut p: *mut AstParam = unsafe { (*cur).params };
            while (p as usize) != 0 {
                declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    c_scope, unsafe { (*p).name }, p as usize, unsafe { view((*p).span) },
                    SYM_LOCAL, unsafe { (*p).is_mut });
                resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    scope, unsafe { (*p).ty });
                p = unsafe { (*p).next };
            }
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).ret_type });
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                c_scope, unsafe { (*cur).body });
        } else if k == EXPR_RANGE {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).start_expr });
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).end_expr });
        } else if k == EXPR_BINARY {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).left });
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).right });
        } else if k == EXPR_CAST {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).inner });
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*cur).cast_ty });
        } else if k == EXPR_POSTFIX {
            let head = unsafe { (*cur).head };
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, head);
            let mut head_node: usize = 0;
            let mut hkind: u8 = SYM_LOCAL;
            let mut curr_mod: *mut Module = 0 as *mut Module;

            let head_ptr: *mut AstExpr = unsafe { (*cur).head };
            let mut head_is_path = false;
            if (head_ptr as usize) != 0 {
                let head_kind = unsafe { (*head_ptr).kind };
                let head_segs = unsafe { (*head_ptr).segments as usize };
                if head_kind == EXPR_PATH && head_segs != 0 {
                    head_is_path = true;
                }
            }
            if head_is_path {
                let first_seg: *mut AstTypePathSegment = unsafe { (*head_ptr).segments };
                let bound = nodemap_contains(unsafe { view((*rmap).node_map) }, first_seg as usize);
                if bound {
                    let hsym = lookup_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), scope, unsafe { (*first_seg).name });
                    if (hsym as usize) != 0 {
                        hkind = unsafe { (*hsym).kind };
                        head_node = unsafe { (*hsym).node };
                        if hkind == SYM_MODULE {
                            curr_mod = head_node as *mut Module;
                        }
                    }
                }
            }

            let mut s: *mut AstPostfixSeg = unsafe { (*cur).postfix_segs };
            while (s as usize) != 0 {
                let sk = unsafe { (*s).kind };
                if sk == POSTFIX_FIELD && head_node != 0 {
                    let sname = unsafe { (*s).name };
                    let sspan = unsafe { (*s).span };
                    if hkind == SYM_MODULE && (curr_mod as usize) != 0 {
                        let sub = unsafe { symenv_get(view((*curr_mod).submodules), sname.v) };
                        if (sub as usize) != 0 {
                            bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                mut_view(*rmap), s as usize, unsafe { (*sub).id });
                            curr_mod = (unsafe { (*sub).node }) as *mut Module;
                            head_node = unsafe { (*sub).node };
                            hkind = SYM_MODULE;
                        } else {
                            let exp = unsafe { symenv_get(view((*curr_mod).exports), sname.v) };
                            if (exp as usize) != 0 {
                                check_visibility(mut_view(*env), mut_view(*arena), mut_view(*sink),
                                    mut_view(*interner), mut_view(*rmap), env.current_module, exp, view(sspan));
                                bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                    mut_view(*rmap), s as usize, unsafe { (*exp).id });
                                unsafe { nodemap_insert(mut_view((*rmap).module_access_nodes), s as usize,
                                    (*exp).id); }
                                head_node = unsafe { (*exp).node };
                                hkind = unsafe { (*exp).kind };
                                curr_mod = 0 as *mut Module;
                            } else if unsafe { symenv_contains(view((*(*curr_mod).scope).bindings), sname.v) } {
                                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                    mut_view(*rmap), AX_NAME_PRIVATE, view(sspan));
                                head_node = 0;
                            } else {
                                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                    mut_view(*rmap), AX_NAME_UNRESOLVED, unsafe { view((*cur).span) });
                                head_node = 0;
                            }
                        }
                    } else if is_item_sym(hkind) && (unsafe { (*(head_node as *mut AstItem)).kind }) == ITEM_ENUM {
                        let enum_item = head_node as *mut AstItem;
                        let mut found = false;
                        let mut v: *mut AstVariantDecl = unsafe { (*enum_item).variants };
                        while (v as usize) != 0 {
                            if (unsafe { (*v).name.v }) == sname.v {
                                let vid_ptr = unsafe { nodemap_get(view((*rmap).node_map), v as usize) };
                                if (vid_ptr as usize) != 0 && (unsafe { (*vid_ptr).v }) != 0u32 {
                                    let vid = unsafe { *vid_ptr };
                                    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                        mut_view(*rmap), s as usize, (SymbolId { v: vid.v }));
                                }
                                head_node = v as usize;
                                hkind = SYM_VARIANT;
                                found = true;
                                break;
                            }
                            v = unsafe { (*v).next };
                        }
                        if !found {
                            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                mut_view(*rmap), AX_NAME_UNRESOLVED, unsafe { view((*cur).span) });
                            head_node = 0;
                        }
                    } else {
                        head_node = 0;
                    }
                } else if sk == POSTFIX_CALL {
                    resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), scope, unsafe { (*s).args });
                    head_node = 0;
                } else if sk == POSTFIX_INDEX {
                    resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), scope, unsafe { (*s).index_arg });
                    head_node = 0;
                } else {
                    head_node = 0;
                }
                s = unsafe { (*s).next };
            }
        }
        cur = next_node;
    }
}

fn resolve_generic_params(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, gp: *mut AstGenericParams) {
    if (gp as usize) == 0 {
        return;
    }
    let mut p: *mut AstGenericParam = unsafe { (*gp).params };
    while (p as usize) != 0 {
        declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), scope,
            unsafe { (*p).name }, p as usize, unsafe { view((*p).span) },
            SYM_GENERIC_PARAM, false);
        p = unsafe { (*p).next };
    }
    p = unsafe { (*gp).params };
    while (p as usize) != 0 {
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), scope,
            unsafe { (*p).bounds });
        p = unsafe { (*p).next };
    }
}

fn resolve_where_clause(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, wc: *mut AstWhereClause) {
    if (wc as usize) == 0 {
        return;
    }
    let mut pred: *mut AstWherePred = unsafe { (*wc).preds };
    while (pred as usize) != 0 {
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), scope,
            unsafe { (*pred).ty });
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), scope,
            unsafe { (*pred).bounds });
        pred = unsafe { (*pred).next };
    }
}

fn declare_self_in_scope(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, it: *mut AstItem) {
    let self_sv = res_str_in_arena(unsafe { mut_view(*arena) }, 182);
    let self_id = unsafe { interner_intern_bytes(mut_view(*interner), self_sv.ptr, self_sv.len) };
    declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), scope,
        self_id, it as usize, unsafe { view((*it).span) }, SYM_LOCAL, false);
}

fn resolve_single_item_body(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, scope: *mut Scope, it: *mut AstItem) {
    let k = unsafe { (*it).kind };
    if k == ITEM_FN {
        let fn_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, false, mut_view(env.alloc_scopes));
        resolve_generic_params(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            fn_scope, unsafe { (*it).generic_params });
        resolve_where_clause(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            fn_scope, unsafe { (*it).where_clause });
        let mut p: *mut AstParam = unsafe { (*it).params };
        while (p as usize) != 0 {
            declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                fn_scope, unsafe { (*p).name }, p as usize, unsafe { view((*p).span) },
                SYM_LOCAL, unsafe { (*p).is_mut });
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                fn_scope, unsafe { (*p).ty });
            p = unsafe { (*p).next };
        }
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), fn_scope,
            unsafe { (*it).ret_type });
        if (unsafe { (*it).body as usize }) != 0 {
            resolve_block(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                fn_scope, unsafe { (*it).body });
        }
    } else if k == ITEM_STRUCT {
        let s_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, false, mut_view(env.alloc_scopes));
        resolve_generic_params(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            s_scope, unsafe { (*it).generic_params });
        resolve_where_clause(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            s_scope, unsafe { (*it).where_clause });
        if unsafe { (*it).is_tuple } {
            resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                s_scope, unsafe { (*it).tuple_types });
        } else {
            let mut field_names = SymEnv {
                keys: 0 as *mut u32, vals: 0 as *mut Symbol, states: 0 as *mut u8, len: 0, cap: 0
            };
            symenv_init(mut_view(field_names));
            let mut f: *mut AstFieldDecl = unsafe { (*it).struct_fields };
            while (f as usize) != 0 {
                let fnm = unsafe { (*f).name };
                if symenv_contains(view(field_names), fnm.v) {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_DUPLICATE, unsafe { view((*f).span) });
                } else {
                    let dummy = Symbol {
                        id: SymbolId { v: 0u32 },
                        name: StrId { v: 0u32 },
                        kind: 0u8,
                        vis: 0u8,
                        is_mut: false,
                        def_span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                        node: 0,
                        def_module: 0,
                    };
                    symenv_insert(mut_view(field_names), fnm.v, view(dummy));
                }
                resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    s_scope, unsafe { (*f).ty });
                f = unsafe { (*f).next };
            }
            symenv_free(mut_view(field_names));
        }
    } else if k == ITEM_ENUM {
        let e_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, false, mut_view(env.alloc_scopes));
        resolve_generic_params(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            e_scope, unsafe { (*it).generic_params });
        resolve_where_clause(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            e_scope, unsafe { (*it).where_clause });
        let mut v: *mut AstVariantDecl = unsafe { (*it).variants };
        while (v as usize) != 0 {
            if unsafe { (*v).is_struct } {
                let mut f: *mut AstFieldDecl = unsafe { (*v).struct_fields };
                while (f as usize) != 0 {
                    resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), e_scope, unsafe { (*f).ty });
                    f = unsafe { (*f).next };
                }
            } else {
                resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    e_scope, unsafe { (*v).tuple_types });
            }
            v = unsafe { (*v).next };
        }
    } else if k == ITEM_TRAIT {
        let t_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, false, mut_view(env.alloc_scopes));
        declare_self_in_scope(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            t_scope, it);
        resolve_generic_params(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            t_scope, unsafe { (*it).generic_params });
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), t_scope,
            unsafe { (*it).supertraits });
        resolve_where_clause(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            t_scope, unsafe { (*it).where_clause });
        let mut m: *mut AstItem = unsafe { (*it).members };
        while (m as usize) != 0 {
            let m_next = unsafe { (*m).next };
            resolve_single_item_body(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), t_scope, m);
            m = m_next;
        }
    } else if k == ITEM_IMPL {
        let i_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, false, mut_view(env.alloc_scopes));
        declare_self_in_scope(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            i_scope, it);
        resolve_generic_params(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            i_scope, unsafe { (*it).generic_params });
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), i_scope,
            unsafe { (*it).trait_path });
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), i_scope,
            unsafe { (*it).self_type });
        resolve_where_clause(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            i_scope, unsafe { (*it).where_clause });
        let mut m: *mut AstItem = unsafe { (*it).members };
        while (m as usize) != 0 {
            let m_next = unsafe { (*m).next };
            resolve_single_item_body(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), i_scope, m);
            m = m_next;
        }
    } else if k == ITEM_TYPE_ALIAS {
        let a_scope = push_scope(unsafe { mut_view(*arena) }, scope, false, false, mut_view(env.alloc_scopes));
        resolve_generic_params(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            a_scope, unsafe { (*it).generic_params });
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), a_scope,
            unsafe { (*it).ty });
    } else if k == ITEM_CONST || k == ITEM_STATIC {
        resolve_type(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), scope,
            unsafe { (*it).ty });
        if (unsafe { (*it).expr as usize }) != 0 {
            resolve_expr(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                scope, unsafe { (*it).expr });
        }
    } else if k == ITEM_EXTERN_BLOCK {
        let mut m: *mut AstItem = unsafe { (*it).members };
        while (m as usize) != 0 {
            let m_next = unsafe { (*m).next };
            resolve_single_item_body(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), scope, m);
            m = m_next;
        }
    }
}

fn record_variant_naming(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, vsym: SymbolId, enum_name: StrId, var_name: StrId) {
    let mut mod_sv = StrView { ptr: 0 as *const u8, len: 0 };
    if (env.current_module as usize) != 0 {
        mod_sv = unsafe { (*env.current_module).full_path };
    }
    let en_sv = unsafe { interner_get(view(*interner), enum_name) };
    let vr_sv = unsafe { interner_get(view(*interner), var_name) };
    let comb_len = en_sv.len + 1 + vr_sv.len;
    let buf = unsafe { arena_alloc_raw(mut_view(*arena), comb_len + 1, 1) };
    let mut i: usize = 0;
    while i < en_sv.len {
        unsafe { *(buf + i) = *(en_sv.ptr + i); }
        i = i + 1;
    }
    unsafe { *(buf + en_sv.len) = 46u8; }
    let mut j: usize = 0;
    while j < vr_sv.len {
        unsafe { *(buf + en_sv.len + 1 + j) = *(vr_sv.ptr + j); }
        j = j + 1;
    }
    unsafe { *(buf + comb_len) = 0u8; }
    let item_sv = StrView { ptr: buf as *const u8, len: comb_len };
    unsafe { record_symbol_naming(mut_view(*rmap), vsym, mod_sv, item_sv); }
}

fn collect_top_level_item(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, it: *mut AstItem) {
    let k = unsafe { (*it).kind };
    let vis = unsafe { (*it).vis.kind };
    let sp = unsafe { (*it).span };
    let m_scope = unsafe { (*env.current_module).scope };
    if k == ITEM_FN || k == ITEM_STRUCT || k == ITEM_ENUM || k == ITEM_TRAIT || k == ITEM_TYPE_ALIAS ||
        k == ITEM_CONST || k == ITEM_STATIC {
        let mut skind = SYM_FN;
        if k == ITEM_STRUCT { skind = SYM_STRUCT; }
        else if k == ITEM_ENUM { skind = SYM_ENUM; }
        else if k == ITEM_TRAIT { skind = SYM_TRAIT; }
        else if k == ITEM_TYPE_ALIAS { skind = SYM_TYPE_ALIAS; }
        else if k == ITEM_CONST { skind = SYM_CONST; }
        else if k == ITEM_STATIC { skind = SYM_STATIC; }
        let is_mut = if k == ITEM_STATIC { unsafe { (*it).is_mut } } else { false };
        let name = unsafe { (*it).name };
        if name.v != 0u32 {
            let s_ptr = declare_name_vis(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), m_scope, (StrId { v: name.v }), it as usize, view(sp), skind, vis, is_mut);
            if (s_ptr as usize) != 0 {
                unsafe { symenv_insert(mut_view((*env.current_module).exports), name.v, view(*s_ptr)); }
            }
            if k == ITEM_ENUM {
                let mut v: *mut AstVariantDecl = unsafe { (*it).variants };
                while (v as usize) != 0 {
                    let vsym = next_symbol_id(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), v as usize);
                    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        v as usize, (SymbolId { v: vsym.v }));
                    let v_next: *mut AstVariantDecl = unsafe { (*v).next };
                    record_variant_naming(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), (SymbolId { v: vsym.v }), (StrId { v: name.v }), unsafe { (*v).name });
                    v = v_next;
                }
            }
        }
    } else if k == ITEM_EXTERN_BLOCK {
        let mut m: *mut AstItem = unsafe { (*it).members };
        while (m as usize) != 0 {
            let m_next: *mut AstItem = unsafe { (*m).next };
            let mk = unsafe { (*m).kind };
            if mk == ITEM_FN || mk == ITEM_STATIC {
                let mname = unsafe { (*m).name };
                if mname.v != 0u32 {
                    let mvis = unsafe { (*m).vis.kind };
                    let sym_id = next_extern_symbol_id(mut_view(*env), mut_view(*arena), mut_view(*sink),
                        mut_view(*interner), mut_view(*rmap), m as usize);
                    unsafe { nodemap_insert(mut_view((*rmap).extern_nodes), m as usize,
                        (SymbolId { v: sym_id.v })); }
                    let mut msym = Symbol {
                        id: SymbolId { v: 0u32 },
                        name: StrId { v: 0u32 },
                        kind: 0u8,
                        vis: 0u8,
                        is_mut: false,
                        def_span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                        node: 0,
                        def_module: 0,
                    };
                    msym.id.v = sym_id.v;
                    msym.name.v = mname.v;
                    msym.kind = if mk == ITEM_FN { SYM_FN } else { SYM_STATIC };
                    msym.vis = mvis;
                    msym.node = m as usize;
                    msym.def_module = env.current_module as usize;
                    unsafe {
                        symenv_insert(mut_view((*m_scope).bindings), mname.v, view(msym));
                        symenv_insert(mut_view((*env.current_module).exports), mname.v, view(msym));
                    }
                    let mut mod_sv = StrView { ptr: 0 as *const u8, len: 0 };
                    if (env.current_module as usize) != 0 {
                        mod_sv = unsafe { (*env.current_module).full_path };
                    }
                    let name_sv = unsafe { interner_get(view(*interner), mname) };
                    unsafe { record_symbol_naming(mut_view(*rmap), (SymbolId { v: sym_id.v }),
                        mod_sv, name_sv); }
                }
            }
            m = m_next;
        }
    }
}

fn find_tree_defining_name(tree: *mut AstUseTree, name: StrId) -> *mut AstUseTree {
    let mut t = tree;
    while (t as usize) != 0 {
        let subtrees = unsafe { (*t).subtrees };
        if (subtrees as usize) != 0 {
            let sub = find_tree_defining_name(subtrees, (StrId { v: name.v }));
            if (sub as usize) != 0 {
                return sub;
            }
        }
        let count = unsafe { (*t).path.count };
        let alias = unsafe { (*t).alias };
        let mut bind_name = StrId { v: 0u32 };
        if alias.v != 0u32 {
            bind_name.v = alias.v;
        } else if count > 0 {
            bind_name.v = (unsafe { *res_strid_slot((*t).path.segments, count - 1) }).v;
        }
        if bind_name.v == name.v {
            return t;
        }
        t = unsafe { (*t).next };
    }
    0 as *mut AstUseTree
}

fn find_matching_use_in_module(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>,
    m: *mut Module,
    target_name: StrId,
    out_item: mut_view<*mut AstItem>,
    out_tree: mut_view<*mut AstUseTree>,
    ast: view<Ast>
) -> bool {
    let mut curr_mod = env.root_module;
    let mut it: *mut AstItem = ast.items;
    while (it as usize) != 0 {
        let k = unsafe { (*it).kind };
        if k == ITEM_MODULE {
            curr_mod = get_or_create_module(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), unsafe { view((*it).mod_path) });
        } else if k == ITEM_USE && (curr_mod as usize) == (m as usize) {
            let matching = find_tree_defining_name(unsafe { (*it).use_tree }, (StrId { v: target_name.v }));
            if (matching as usize) != 0 {
                unsafe {
                    *out_item = it;
                    *out_tree = matching;
                }
                return true;
            }
        }
        it = unsafe { (*it).next };
    }
    false
}

fn resolve_use_item(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>,
    ast: view<Ast>,
    in_mod: *mut Module,
    tree: *mut AstUseTree,
    prefix: *mut StrId,
    prefix_len: usize,
    use_item: *mut AstItem,
    visited: *mut VisitedImport,
    vis_count: usize
) -> i32 {
    if (tree as usize) == 0 {
        return 0;
    }
    if nodemap_contains(view(env.resolved_use_trees), tree as usize) {
        return 0;
    }

    let tree_count = unsafe { (*tree).path.count };
    let full_len = prefix_len + tree_count;
    let full_bytes = ((full_len as isize) * (size_of<StrId>() as isize)) as usize;
    let full_segs = unsafe { arena_alloc_raw(mut_view(*arena), full_bytes,
        align_of<StrId>()) as *mut StrId };
    let mut i: usize = 0;
    while i < prefix_len {
        unsafe { (*res_strid_slot(full_segs, i)).v = (*res_strid_slot(prefix, i)).v; }
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < tree_count {
        unsafe { (*res_strid_slot(full_segs, prefix_len + j)).v = (*res_strid_slot((*tree).path.segments, j)).v; }
        j = j + 1;
    }

    if (unsafe { (*tree).subtrees as usize }) != 0 {
        let mut sub: *mut AstUseTree = unsafe { (*tree).subtrees };
        while (sub as usize) != 0 {
            let sub_next = unsafe { (*sub).next };
            resolve_use_item(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                ast, in_mod, sub, full_segs, full_len, use_item, visited, vis_count);
            sub = sub_next;
        }
        unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
        return 0;
    }

    if full_len == 0 {
        return 0;
    }

    let alias_field = unsafe { (*tree).alias };
    let last_seg = unsafe { *res_strid_slot(full_segs, full_len - 1) };
    let target_alias = if alias_field.v != 0u32 { alias_field } else { last_seg };

    let mut v: usize = 0;
    while v < vis_count {
        let vi = unsafe { res_visited_slot(visited, v) };
        if (unsafe { (*vi).mod_ptr as usize }) == (in_mod as usize) &&
            (unsafe { (*vi).tree_ptr }) == (target_alias.v as usize) {
            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                AX_NAME_IMPORT_CYCLE, unsafe { view((*tree).span) });
            unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
            return 2;
        }
        v = v + 1;
    }

    let mut new_vis_count = vis_count;
    if new_vis_count < 64 {
        let slot = unsafe { res_visited_slot(visited, new_vis_count) };
        unsafe {
            (*slot).mod_ptr = in_mod;
            (*slot).tree_ptr = target_alias.v as usize;
        }
        new_vis_count = new_vis_count + 1;
    }

    let saved_mod = env.current_module;
    env.current_module = in_mod;
    let first_seg = unsafe { *res_strid_slot(full_segs, 0) };
    let sym = lookup_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
        unsafe { (*in_mod).scope }, first_seg);
    env.current_module = saved_mod;
    if (sym as usize) == 0 {
        emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            AX_NAME_UNRESOLVED_IMPORT, unsafe { view((*tree).span) });
        unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
        return 1;
    }

    let mut head_node = unsafe { (*sym).node };
    let mut hkind = unsafe { (*sym).kind };
    let mut curr_mod: *mut Module = if hkind == SYM_MODULE { head_node as *mut Module } else { 0 as *mut Module };
    let mut final_sym = Symbol {
        id: SymbolId { v: 0u32 },
        name: StrId { v: 0u32 },
        kind: 0u8,
        vis: 0u8,
        is_mut: false,
        def_span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        node: 0,
        def_module: 0,
    };
    copy_symbol_into(mut_view(final_sym), unsafe { view(*sym) });

    let mut k: usize = 1;
    while k < full_len {
        let seg = unsafe { *res_strid_slot(full_segs, k) };
        if hkind == SYM_MODULE && (curr_mod as usize) != 0 {
            let submod = unsafe { symenv_get(view((*curr_mod).submodules), seg.v) };
            if (submod as usize) != 0 {
                if !check_visibility(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                    mut_view(*rmap), in_mod, submod, unsafe { view((*tree).span) }) {
                    unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
                    return 1;
                }
                curr_mod = (unsafe { (*submod).node }) as *mut Module;
                head_node = unsafe { (*submod).node };
                hkind = SYM_MODULE;
                copy_symbol_into(mut_view(final_sym), unsafe { view(*submod) });
            } else {
                let mut exp = unsafe { symenv_get(view((*curr_mod).exports), seg.v) };
                if (exp as usize) == 0 {
                    let mut target_it: *mut AstItem = 0 as *mut AstItem;
                    let mut target_tree: *mut AstUseTree = 0 as *mut AstUseTree;
                    if find_matching_use_in_module(mut_view(*env), mut_view(*arena), mut_view(*sink),
                        mut_view(*interner), mut_view(*rmap), curr_mod, (StrId { v: seg.v }), mut_view(target_it),
                        mut_view(target_tree), ast) {
                        let mut in_cycle = false;
                        let mut cv: usize = 0;
                        while cv < new_vis_count {
                            let cvi = unsafe { res_visited_slot(visited, cv) };
                            if (unsafe { (*cvi).mod_ptr as usize }) == (curr_mod as usize) &&
                                (unsafe { (*cvi).tree_ptr }) == (seg.v as usize) {
                                in_cycle = true;
                                break;
                            }
                            cv = cv + 1;
                        }
                        if in_cycle {
                            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                mut_view(*rmap), AX_NAME_IMPORT_CYCLE, unsafe { view((*tree).span) });
                            unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize,
                                SymbolId { v: 1u32 }); }
                            return 2;
                        }
                        let sub_res = resolve_use_item(mut_view(*env), mut_view(*arena), mut_view(*sink),
                            mut_view(*interner), mut_view(*rmap), ast, curr_mod, target_tree, 0 as *mut StrId, 0,
                            target_it, visited, new_vis_count);
                        if sub_res == 2 {
                            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                                mut_view(*rmap), AX_NAME_IMPORT_CYCLE, unsafe { view((*tree).span) });
                            unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize,
                                SymbolId { v: 1u32 }); }
                            return 2;
                        }
                        exp = unsafe { symenv_get(view((*curr_mod).exports), seg.v) };
                        if (exp as usize) == 0 {
                            let bnd = unsafe { symenv_get(view((*(*curr_mod).scope).bindings), seg.v) };
                            if (bnd as usize) != 0 {
                                exp = bnd;
                            }
                        }
                    }
                }
                if (exp as usize) != 0 {
                    if !check_visibility(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), in_mod, exp, unsafe { view((*tree).span) }) {
                        unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize,
                            SymbolId { v: 1u32 }); }
                        return 1;
                    }
                    head_node = unsafe { (*exp).node };
                    hkind = unsafe { (*exp).kind };
                    copy_symbol_into(mut_view(final_sym), unsafe { view(*exp) });
                    curr_mod = 0 as *mut Module;
                } else if unsafe { symenv_contains(view((*(*curr_mod).scope).bindings), seg.v) } {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_PRIVATE, unsafe { view((*tree).span) });
                    unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
                    return 1;
                } else {
                    emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                        AX_NAME_UNRESOLVED_IMPORT, unsafe { view((*tree).span) });
                    unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
                    return 1;
                }
            }
        } else if is_item_sym(hkind) && head_node != 0 &&
            (unsafe { (*(head_node as *mut AstItem)).kind }) == ITEM_ENUM {
            let en = head_node as *mut AstItem;
            let mut found = false;
            let mut vd: *mut AstVariantDecl = unsafe { (*en).variants };
            while (vd as usize) != 0 {
                if (unsafe { (*vd).name.v }) == seg.v {
                    let vid_ptr = unsafe { nodemap_get(view((*rmap).node_map), vd as usize) };
                    if (vid_ptr as usize) != 0 {
                        final_sym.id.v = unsafe { (*vid_ptr).v };
                        final_sym.node = vd as usize;
                        final_sym.kind = SYM_VARIANT;
                        final_sym.vis = VIS_PUB;
                        final_sym.def_module = curr_mod as usize;
                    }
                    head_node = vd as usize;
                    hkind = SYM_VARIANT;
                    found = true;
                    break;
                }
                vd = unsafe { (*vd).next };
            }
            if !found {
                emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                    AX_NAME_UNRESOLVED_IMPORT, unsafe { view((*tree).span) });
                unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
                return 1;
            }
        } else {
            emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                AX_NAME_UNRESOLVED_IMPORT, unsafe { view((*tree).span) });
            unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
            return 1;
        }
        k = k + 1;
    }

    if full_len == 1 {
        let fs_ptr = unsafe { arena_alloc_raw(mut_view(*arena), size_of<Symbol>(),
            align_of<Symbol>()) as *mut Symbol };
        unsafe { copy_symbol_into(mut_view(*fs_ptr), view(final_sym)); }
        if !check_visibility(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            in_mod, fs_ptr, unsafe { view((*tree).span) }) {
            unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
            return 1;
        }
    }

    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), tree as usize,
        (SymbolId { v: final_sym.id.v }));
    bind_node(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
        (tree as usize) + 16, (SymbolId { v: final_sym.id.v }));

    if unsafe { symenv_contains(view((*(*in_mod).scope).bindings), target_alias.v) } {
        emit_diag(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
            AX_NAME_DUPLICATE, unsafe { view((*tree).span) });
    } else {
        final_sym.name.v = target_alias.v;
        unsafe { symenv_insert(mut_view((*(*in_mod).scope).bindings), target_alias.v, view(final_sym)); }
        if (use_item as usize) != 0 && (unsafe { (*use_item).vis.kind }) != VIS_PRIVATE {
            let mut reexport = Symbol {
                id: SymbolId { v: 0u32 },
                name: StrId { v: 0u32 },
                kind: 0u8,
                vis: 0u8,
                is_mut: false,
                def_span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                node: 0,
                def_module: 0,
            };
            copy_symbol_into(mut_view(reexport), view(final_sym));
            reexport.vis = unsafe { (*use_item).vis.kind };
            reexport.def_module = in_mod as usize;
            unsafe { symenv_insert(mut_view((*in_mod).exports), target_alias.v, view(reexport)); }
        }
    }

    unsafe { nodemap_insert(mut_view(env.resolved_use_trees), tree as usize, SymbolId { v: 1u32 }); }
    0
}

fn populate_prelude(
    env: mut_view<ResolverEnv>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>, prelude: *mut Scope) {
    let zero_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    let mut i: usize = 0;
    while i < 24 {
        let str_idx = PRELUDE_24_IDX[i];
        let sv = res_str_in_arena(unsafe { mut_view(*arena) }, str_idx);
        let id = unsafe { interner_intern_bytes(mut_view(*interner), sv.ptr, sv.len) };
        declare_name(mut_view(*env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), prelude,
            id, 0, view(zero_span), SYM_PRIMITIVE, false);
        i = i + 1;
    }
    let mut f: usize = 0;
    while f < 4 {
        let sv = res_str_in_arena(unsafe { mut_view(*arena) }, 178 + f);
        let id = unsafe { interner_intern_bytes(mut_view(*interner), sv.ptr, sv.len) };
        let mut s = Symbol {
            id: SymbolId { v: 0u32 },
            name: StrId { v: 0u32 },
            kind: 0u8,
            vis: 0u8,
            is_mut: false,
            def_span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            node: 0,
            def_module: 0,
        };
        s.id.v = 10100u32 + (f as u32);
        s.name.v = id.v;
        s.kind = SYM_TRAIT;
        s.vis = VIS_PUB;
        unsafe { symenv_insert(mut_view((*prelude).bindings), id.v, view(s)); }
        f = f + 1;
    }
}

pub fn resolve_file_into(
    ast: view<Ast>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>,
    rmap: mut_view<ResolveMap>
) {
    resolve_map_init(mut_view(*rmap));

    let mut env = ResolverEnv {
        root_module: 0 as *mut Module,
        current_module: 0 as *mut Module,
        prelude_scope: 0 as *mut Scope,
        modules_list: 0 as *mut Module,
        alloc_scopes: 0 as *mut Scope,
        resolved_use_trees: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8,
            len: 0, cap: 0 },
        ast_items: ast.items,
        next_extern_symbol_v: 30000u32,
    };
    nodemap_init(mut_view(env.resolved_use_trees));

    let prelude = push_scope(unsafe { mut_view(*arena) }, 0 as *mut Scope, true, false,
        mut_view(env.alloc_scopes));
    env.prelude_scope = prelude;
    populate_prelude(mut_view(env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap), prelude);

    let root = unsafe { arena_alloc_raw(mut_view(*arena), size_of<Module>(), align_of<Module>()) as *mut Module };
    let root_sc = push_scope(unsafe { mut_view(*arena) }, prelude, true, false, mut_view(env.alloc_scopes));
    unsafe {
        (*root).name.v = 0u32;
        (*root).full_path.ptr = 0 as *const u8;
        (*root).full_path.len = 0;
        (*root).scope = root_sc;
        symenv_init(mut_view((*root).exports));
        symenv_init(mut_view((*root).submodules));
        (*root).parent = 0 as *mut Module;
        (*root).next = 0 as *mut Module;
    }
    env.root_module = root;
    env.current_module = root;
    env.modules_list = root;

    let mut it: *mut AstItem = ast.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == ITEM_MODULE {
            let cur_m = get_or_create_module(mut_view(env), mut_view(*arena), mut_view(*sink),
                mut_view(*interner), mut_view(*rmap), unsafe { view((*it).mod_path) });
            env.current_module = cur_m;
            let mod_sym = next_symbol_id(mut_view(env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), env.current_module as usize);
            bind_node(mut_view(env), mut_view(*arena), mut_view(*sink), mut_view(*interner), mut_view(*rmap),
                it as usize, (SymbolId { v: mod_sym.v }));
        } else {
            collect_top_level_item(mut_view(env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), it);
        }
        it = unsafe { (*it).next };
    }

    env.current_module = env.root_module;
    it = ast.items;
    let visited_bytes = (64isize * (size_of<VisitedImport>() as isize)) as usize;
    let visited_buf = unsafe { arena_alloc_raw(mut_view(*arena), visited_bytes,
        align_of<VisitedImport>()) as *mut VisitedImport };
    while (it as usize) != 0 {
        let k = unsafe { (*it).kind };
        if k == ITEM_MODULE {
            let cur_m = get_or_create_module(mut_view(env), mut_view(*arena), mut_view(*sink),
                mut_view(*interner), mut_view(*rmap), unsafe { view((*it).mod_path) });
            env.current_module = cur_m;
        } else if k == ITEM_USE {
            let mut tree: *mut AstUseTree = unsafe { (*it).use_tree };
            while (tree as usize) != 0 {
                if !nodemap_contains(view(env.resolved_use_trees), tree as usize) {
                    resolve_use_item(mut_view(env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                        mut_view(*rmap), ast, env.current_module, tree, 0 as *mut StrId, 0, it,
                        visited_buf, 0);
                }
                tree = unsafe { (*tree).next };
            }
        }
        it = unsafe { (*it).next };
    }

    let mut m = env.modules_list;
    while (m as usize) != 0 {
        let fp = unsafe { (*m).full_path };
        if (fp.ptr as usize) != 0 && res_sv_eq_idx(fp, 67) {
            let mut slot: usize = 0;
            let cap = unsafe { (*m).exports.cap };
            while slot < cap {
                let sym_ptr = unsafe { symenv_at_slot(view((*m).exports), slot) };
                if (sym_ptr as usize) != 0 && (unsafe { (*sym_ptr).vis }) == VIS_PUB {
                    let key = unsafe { symenv_key_at_slot(view((*m).exports), slot) };
                    unsafe { symenv_insert(mut_view((*prelude).bindings), key, view(*sym_ptr)); }
                }
                slot = slot + 1;
            }
            break;
        }
        m = unsafe { (*m).next };
    }

    env.current_module = env.root_module;
    it = ast.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == ITEM_MODULE {
            let cur_m = get_or_create_module(mut_view(env), mut_view(*arena), mut_view(*sink),
                mut_view(*interner), mut_view(*rmap), unsafe { view((*it).mod_path) });
            env.current_module = cur_m;
        } else {
            resolve_single_item_body(mut_view(env), mut_view(*arena), mut_view(*sink), mut_view(*interner),
                mut_view(*rmap), unsafe { (*env.current_module).scope }, it);
        }
        it = unsafe { (*it).next };
    }

    nodemap_free(mut_view(env.resolved_use_trees));
    free_allocated_scopes(env.alloc_scopes);
    free_allocated_modules(env.modules_list);
}

pub fn resolve_file(
    ast: view<Ast>,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    interner: mut_view<StrInterner>
) -> ResolveMap {
    let mut rmap = ResolveMap {
        node_map: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        module_access_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        extern_nodes: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };
    resolve_file_into(ast, arena, sink, interner, mut_view(rmap));
    rmap
}

struct ResolvedDumpState {
    indent: i32,
    filter_file: FileId,
}

fn rd_tag(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, idx: usize) {
    let start = RESOLVE_OFF[idx] as usize;
    let end = RESOLVE_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        unsafe { diag_buf_push_byte(mut_view(*buf), RESOLVE_DATA[i]); }
        i = i + 1;
    }
}

fn rd_resolved(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, node: usize) {
    if node == 0 {
        return;
    }
    let sym = unsafe { nodemap_get(view((*rmap).node_map), node) };
    if (sym as usize) != 0 && (unsafe { (*sym).v }) != 0u32 {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 86);
        unsafe { diag_buf_push_u32(mut_view(*buf), (*sym).v); }
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 87);
    }
}

fn rd_nl(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>) {
    unsafe { diag_buf_push_byte(mut_view(*buf), 10u8); }
    let mut i: i32 = 0;
    while i < st.indent {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 88);
        i = i + 1;
    }
}

fn rd_begin(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, tag_idx: usize) {
    unsafe { diag_buf_push_byte(mut_view(*buf), 40u8); }
    rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), tag_idx);
    st.indent = st.indent + 1;
}

fn rd_end(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>) {
    st.indent = st.indent - 1;
    unsafe { diag_buf_push_byte(mut_view(*buf), 41u8); }
}

fn rd_strid(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, id: StrId) {
    if id.v == 0u32 {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 89);
        return;
    }
    let sv = unsafe { interner_get(view(*interner), id) };
    rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 90);
    unsafe {
        diag_buf_push_bytes(mut_view(*buf), sv.ptr, sv.len);
        diag_buf_push_byte(mut_view(*buf), 34u8);
    }
}

fn rd_bool(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, b: bool) {
    if b {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 92);
    } else {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 93);
    }
}

fn rd_u32(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, v: u32) {
    unsafe {
        diag_buf_push_byte(mut_view(*buf), 32u8);
        diag_buf_push_u32(mut_view(*buf), v);
    }
}

fn rd_dotted(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: view<AstDottedName>, node_addr: usize) {
    rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
    rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 98);
    rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), node_addr);
    let mut i: usize = 0;
    let count = n.count;
    let segs = n.segments;
    while i < count {
        rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { *res_strid_slot(segs, i) });
        i = i + 1;
    }
    rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
}

fn rd_vis(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: view<AstVis>) {
    rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
    rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 99);
    let k = n.kind;
    if k == VIS_PRIVATE {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 94);
    } else if k == VIS_PUB {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 95);
    } else if k == VIS_PUB_PACKAGE {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 96);
    } else if k == VIS_PUB_MODULE {
        rd_tag(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 97);
    }
    rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
}

fn rd_attr(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstAttr) {
    let mut cur = n;
    while (cur as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 100);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
        let mut a: *mut AstAttrArg = unsafe { (*cur).args };
        while (a as usize) != 0 {
            rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 101);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).name });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).expr });
            rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
            a = unsafe { (*a).next };
        }
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        cur = unsafe { (*cur).next };
    }
}

fn rd_generic_args(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstGenericArgs) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut AstGenericArg = unsafe { (*n).args };
    while (a as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 102);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), n as usize);
        rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).name });
        rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).ty });
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        a = unsafe { (*a).next };
    }
}

fn rd_generic_params(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstGenericParams) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut AstGenericParam = unsafe { (*n).params };
    while (a as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 103);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), n as usize);
        rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).name });
        rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).bounds });
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        a = unsafe { (*a).next };
    }
}

fn rd_where_clause(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstWhereClause) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut AstWherePred = unsafe { (*n).preds };
    while (a as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 104);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), n as usize);
        rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).ty });
        rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).bounds });
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        a = unsafe { (*a).next };
    }
}

fn rd_path_seg(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstTypePathSegment) {
    let mut cur = n;
    while (cur as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 105);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
        rd_generic_args(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).generic_args });
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        cur = unsafe { (*cur).next };
    }
}

fn rd_block(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstBlock) {
    if (n as usize) == 0 {
        return;
    }
    rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
    rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 106);
    rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), n as usize);
    rd_stmt(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*n).stmts });
    rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
}

fn rd_type(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstType) {
    let mut cur = n;
    while (cur as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        let k = unsafe { (*cur).kind };
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), (107u8 + k) as usize);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        if k == TYPE_PATH {
            rd_path_seg(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).segments });
        } else if k == TYPE_TUPLE {
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).elem_types });
        } else if k == TYPE_ARRAY {
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).count_expr });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).elem });
        } else if k == TYPE_SLICE {
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).elem });
        } else if k == TYPE_VIEW || k == TYPE_PTR {
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_mut });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).elem });
        } else if k == TYPE_FN {
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_unsafe });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).abi });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).param_types });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).ret_type });
        } else if k == TYPE_DYN {
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).bounds });
        }
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        cur = unsafe { (*cur).next };
    }
}

fn rd_pat_field(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstPatField) {
    let mut cur = n;
    while (cur as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 116);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
        rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).pat });
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        cur = unsafe { (*cur).next };
    }
}

fn rd_pat(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstPat) {
    let mut cur = n;
    while (cur as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        let k = unsafe { (*cur).kind };
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), (117u8 + k) as usize);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        if k == PAT_RANGE {
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_inclusive });
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).start_pat });
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).end_pat });
        } else if k == PAT_LITERAL {
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_negated });
        } else if k == PAT_BINDING {
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_mut });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
        } else if k == PAT_PATH {
            rd_path_seg(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).segments });
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).payload });
        } else if k == PAT_TUPLE {
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).elems });
        } else if k == PAT_OR {
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).pats });
        } else if k == PAT_STRUCT {
            rd_path_seg(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).segments });
            rd_pat_field(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).fields });
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).has_rest });
        }
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        cur = unsafe { (*cur).next };
    }
}

fn rd_expr(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstExpr) {
    let mut cur = n;
    while (cur as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        let k = unsafe { (*cur).kind };
        if k == EXPR_ERROR {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 126);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        } else if k == EXPR_LITERAL {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 127);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        } else if k == EXPR_PATH {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 128);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_path_seg(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).segments });
        } else if k == EXPR_PAREN {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 130);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).inner });
        } else if k == EXPR_ARRAY {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 131);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).elems });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).count_expr });
        } else if k == EXPR_TUPLE {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 129);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).elems });
        } else if k == EXPR_STRUCT {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 132);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_path_seg(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).segments });
            let mut f: *mut AstFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 133);
                rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), f as usize);
                rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*f).name });
                rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*f).expr });
                rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                f = unsafe { (*f).next };
            }
        } else if k == EXPR_BLOCK {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 134);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).block });
        } else if k == EXPR_IF {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 135);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).let_pat });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).cond });
            rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).block });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).else_branch });
        } else if k == EXPR_MATCH {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 136);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).cond });
            let mut a: *mut AstMatchArm = unsafe { (*cur).arms };
            while (a as usize) != 0 {
                rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 137);
                rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), a as usize);
                rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).pat });
                rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).guard });
                rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*a).body });
                rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                a = unsafe { (*a).next };
            }
        } else if k == EXPR_LOOP {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 138);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).label });
            rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).block });
        } else if k == EXPR_WHILE {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 139);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).label });
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).let_pat });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).cond });
            rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).block });
        } else if k == EXPR_FOR {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 140);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).label });
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).pat });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).iter });
            rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).block });
        } else if k == EXPR_UNSAFE {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 141);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).block });
        } else if k == EXPR_VIEW {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 142);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_mut });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).inner });
        } else if k == EXPR_COMPTIME {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 143);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).block });
        } else if k == EXPR_JUMP {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 144);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_u32(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), (unsafe { (*cur).jump_kind }) as u32);
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).label });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).inner });
        } else if k == EXPR_CLOSURE {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 145);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            let mut p: *mut AstParam = unsafe { (*cur).params };
            while (p as usize) != 0 {
                rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 146);
                rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), p as usize);
                rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*p).is_mut });
                rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*p).name });
                rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*p).ty });
                rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                p = unsafe { (*p).next };
            }
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).ret_type });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).body });
        } else if k == EXPR_RANGE {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 147);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_inclusive });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).start_expr });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).end_expr });
        } else if k == EXPR_BINARY {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 148);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_u32(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), (unsafe { (*cur).op }) as u32);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).left });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).right });
        } else if k == EXPR_UNARY {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 149);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_u32(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), (unsafe { (*cur).op }) as u32);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).inner });
        } else if k == EXPR_CAST {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 150);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).inner });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).cast_ty });
        } else if k == EXPR_POSTFIX {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 151);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).head });
            let mut s: *mut AstPostfixSeg = unsafe { (*cur).postfix_segs };
            while (s as usize) != 0 {
                rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 152);
                rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), s as usize);
                let sk = unsafe { (*s).kind };
                rd_u32(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), sk as u32);
                if sk == POSTFIX_FIELD {
                    rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*s).name });
                    rd_generic_args(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                        unsafe { (*s).generic_args });
                } else if sk == POSTFIX_TUPLE_INDEX {
                    rd_u32(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*s).tuple_index });
                } else if sk == POSTFIX_CALL {
                    rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*s).args });
                } else if sk == POSTFIX_INDEX {
                    rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*s).index_arg });
                } else if sk == POSTFIX_ARROW {
                    rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*s).name });
                }
                rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                s = unsafe { (*s).next };
            }
        }
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        cur = unsafe { (*cur).next };
    }
}

fn rd_use_tree(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstUseTree) {
    if (n as usize) == 0 {
        return;
    }
    rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
    rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 153);
    rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), n as usize);
    rd_dotted(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*n).path) },
        (n as usize) + 16);
    if (unsafe { (*n).alias.v }) != 0u32 {
        rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*n).alias });
    }
    if (unsafe { (*n).subtrees as usize }) != 0 {
        rd_use_tree(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*n).subtrees });
    }
    rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
    if (unsafe { (*n).next as usize }) != 0 {
        rd_use_tree(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*n).next });
    }
}

fn rd_stmt(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstStmt) {
    let mut cur = n;
    while (cur as usize) != 0 {
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        let k = unsafe { (*cur).kind };
        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), (154u8 + k) as usize);
        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        if k == STMT_LET {
            rd_pat(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).pat });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).ty });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).expr });
            if (unsafe { (*cur).else_block as usize }) != 0 {
                rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).else_block });
            }
        } else if k == STMT_ASSIGN {
            rd_u32(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), (unsafe { (*cur).op }) as u32);
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).left });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).right });
        } else if k == STMT_EXPR {
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).has_semi });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).expr });
        }
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        cur = unsafe { (*cur).next };
    }
}

fn rd_item(
    st: mut_view<ResolvedDumpState>,
    buf: mut_view<DiagBuffer>,
    interner: view<StrInterner>,
    rmap: view<ResolveMap>, n: *mut AstItem) {
    let mut cur = n;
    while (cur as usize) != 0 {
        if st.filter_file.v != 0u32 && (unsafe { (*cur).span.file.v }) != 0u32 &&
            (unsafe { (*cur).span.file.v }) != st.filter_file.v {
            cur = unsafe { (*cur).next };
            continue;
        }
        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        let k = unsafe { (*cur).kind };
        if k == ITEM_ERROR {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 158);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
        } else if k == ITEM_MODULE {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 159);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_dotted(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).mod_path) }, 0);
        } else if k == ITEM_USE {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 160);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_use_tree(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).use_tree });
        } else if k == ITEM_FN {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 161);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_async });
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_comptime });
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_unsafe });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).abi });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
            rd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).generic_params });
            let mut p: *mut AstParam = unsafe { (*cur).params };
            while (p as usize) != 0 {
                rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 146);
                rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), p as usize);
                rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*p).is_mut });
                rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*p).name });
                rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*p).ty });
                rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                p = unsafe { (*p).next };
            }
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).ret_type });
            rd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).where_clause });
            if (unsafe { (*cur).body as usize }) != 0 {
                rd_block(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).body });
            }
        } else if k == ITEM_STRUCT {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 162);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
            rd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).generic_params });
            rd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).where_clause });
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_tuple });
            if unsafe { (*cur).is_tuple } {
                rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).tuple_types });
            } else {
                let mut f: *mut AstFieldDecl = unsafe { (*cur).struct_fields };
                while (f as usize) != 0 {
                    rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                    rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 163);
                    rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), f as usize);
                    rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*f).attrs });
                    rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*f).vis) });
                    rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*f).name });
                    rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*f).ty });
                    rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                    f = unsafe { (*f).next };
                }
            }
        } else if k == ITEM_ENUM {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 164);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
            rd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).generic_params });
            rd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).where_clause });
            let mut v: *mut AstVariantDecl = unsafe { (*cur).variants };
            while (v as usize) != 0 {
                rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 165);
                rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), v as usize);
                rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*v).attrs });
                rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*v).name });
                rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*v).is_struct });
                if unsafe { (*v).is_struct } {
                    let mut f: *mut AstFieldDecl = unsafe { (*v).struct_fields };
                    while (f as usize) != 0 {
                        rd_nl(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                        rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 163);
                        rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), f as usize);
                        rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*f).attrs });
                        rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*f).vis) });
                        rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*f).name });
                        rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*f).ty });
                        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                        f = unsafe { (*f).next };
                    }
                } else {
                    rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*v).tuple_types });
                }
                rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
                v = unsafe { (*v).next };
            }
        } else if k == ITEM_TRAIT {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 166);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
            rd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).generic_params });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).supertraits });
            rd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).where_clause });
            rd_item(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).members });
        } else if k == ITEM_IMPL {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 167);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).generic_params });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).trait_path });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).self_type });
            rd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).where_clause });
            rd_item(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).members });
        } else if k == ITEM_TYPE_ALIAS {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 168);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
            rd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap),
                unsafe { (*cur).generic_params });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).ty });
        } else if k == ITEM_CONST {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 169);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).ty });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).expr });
        } else if k == ITEM_STATIC {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 170);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_unsafe });
            rd_bool(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).is_mut });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).name });
            rd_type(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).ty });
            rd_expr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).expr });
        } else if k == ITEM_EXTERN_BLOCK {
            rd_begin(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), 171);
            rd_resolved(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), cur as usize);
            rd_attr(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).attrs });
            rd_vis(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { view((*cur).vis) });
            rd_strid(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).abi });
            rd_item(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap), unsafe { (*cur).members });
        }
        rd_end(mut_view(*st), mut_view(*buf), view(*interner), view(*rmap));
        cur = unsafe { (*cur).next };
    }
}

pub fn emit_resolved(buf: mut_view<DiagBuffer>, ast: view<Ast>, rmap: view<ResolveMap>,
    interner: view<StrInterner>, filter_file: FileId) {
    let mut st = ResolvedDumpState {
        indent: 0,
        filter_file: FileId { v: filter_file.v },
    };
    rd_item(mut_view(st), mut_view(*buf), view(*interner), view(*rmap), ast.items);
    unsafe { diag_buf_push_byte(buf, 10u8); }
}
