// Lexical scope ribs, loop label ribs, module graph nodes, and import cycle tracking.
// Port of Scope, LabelScope, Module, and VisitedImport in bootstrap/axiom0/src/resolve/resolve.c.
module compiler.resolve.rib

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.StrId
use compiler.kernel.interner.StrView
use compiler.resolve.symtab.SymEnv
use compiler.resolve.symtab.symenv_init
use compiler.resolve.symtab.symenv_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

pub struct LabelScope {
    pub parent: *mut LabelScope,
    pub label: StrId,
}

pub struct Scope {
    pub parent: *mut Scope,
    pub bindings: SymEnv,
    pub is_module_scope: bool,
    pub is_block_scope: bool,
    pub label_scope: *mut LabelScope,
    pub alloc_next: *mut Scope,
}

pub struct Module {
    pub name: StrId,
    pub full_path: StrView,
    pub scope: *mut Scope,
    pub exports: SymEnv,
    pub submodules: SymEnv,
    pub parent: *mut Module,
    pub next: *mut Module,
}

pub struct VisitedImport {
    pub mod_ptr: *mut Module,
    pub tree_ptr: usize,
}

pub fn push_scope(
    arena: mut_view<Arena>,
    parent: *mut Scope,
    is_mod: bool,
    is_blk: bool,
    alloc_head: mut_view<*mut Scope>
) -> *mut Scope {
    let s = arena_alloc_raw(arena, size_of<Scope>(), align_of<Scope>()) as *mut Scope;
    unsafe {
        (*s).parent = parent;
        symenv_init(mut_view((*s).bindings));
        (*s).is_module_scope = is_mod;
        (*s).is_block_scope = is_blk;
        if (parent as usize) != 0 {
            (*s).label_scope = (*parent).label_scope;
        } else {
            (*s).label_scope = 0 as *mut LabelScope;
        }
        (*s).alloc_next = *alloc_head;
        *alloc_head = s;
    }
    s
}

pub fn push_label(arena: mut_view<Arena>, s: *mut Scope, label: StrId) {
    let ls = arena_alloc_raw(arena, size_of<LabelScope>(), align_of<LabelScope>()) as *mut LabelScope;
    unsafe {
        (*ls).parent = (*s).label_scope;
        (*ls).label.v = label.v;
        (*s).label_scope = ls;
    }
}

pub fn find_label_in_scope(s: *mut Scope, label: StrId) -> bool {
    if (s as usize) == 0 {
        return false;
    }
    let mut ls = unsafe { (*s).label_scope };
    while (ls as usize) != 0 {
        if label.v == 0u32 || (unsafe { (*ls).label.v }) == label.v {
            return true;
        }
        ls = unsafe { (*ls).parent };
    }
    false
}

pub fn free_allocated_scopes(head: *mut Scope) {
    let mut cur = head;
    while (cur as usize) != 0 {
        let next = unsafe { (*cur).alloc_next };
        unsafe { symenv_free(mut_view((*cur).bindings)); }
        cur = next;
    }
}

pub fn free_allocated_modules(head: *mut Module) {
    let mut cur = head;
    while (cur as usize) != 0 {
        let next = unsafe { (*cur).next };
        unsafe {
            symenv_free(mut_view((*cur).exports));
            symenv_free(mut_view((*cur).submodules));
        }
        cur = next;
    }
}
