// Session-level Resolver + HIR integration (T080): wires `compiler.parser.session`, `compiler.resolve`,
// and `compiler.hir` over `CompilerSession` so virtual or on-disk files can be parsed (with optional
// std.core.{option,result,prelude,host} prelude injection matching `axiom0`), resolved, lowered to HIR,
// and rendered in canonical `inspect --emit=resolved` and `inspect --emit=hir` S-expression formats.
module compiler.resolve_hir.session

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.FileId
use compiler.kernel.id.StrId
use compiler.kernel.interner.StrView
use compiler.kernel.interner.interner_intern_bytes
use compiler.source.span.Span
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_new
use compiler.diag.format.ax_diag_render_human
use compiler.diag.json.ax_diag_render_json
use compiler.kernel_source_diag.session.CompilerSession
use compiler.kernel_source_diag.session.session_error_count
use compiler.parser.session.session_parse_virtual_file
use compiler.syntax.ast.Ast
use compiler.syntax.ast.AstItem
use compiler.syntax.ast.ITEM_MODULE
use compiler.syntax.ast.VIS_PUB
use compiler.resolve.symtab.ResolveMap
use compiler.resolve.symtab.resolve_map_free
use compiler.resolve.resolver.resolve_file_into
use compiler.resolve.resolver.emit_resolved
use compiler.hir.hir.HirFile
use compiler.hir.hir.emit_hir
use compiler.hir.lower.lower_file

