pub fn lower_ast(arena: mut_view<Arena>, ast: view<Ast>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>) -> HirFile {
    let mut ctx = LowerCtx {
        fake_sym_counter: 2147483648u32,
    };
    let items = lower_item(mut_view(ctx), mut_view(*arena), view(*rmap), mut_view(*sink), ast.items);
    HirFile { items: items }
}

fn sv_eq_cstr4(sv: StrView, c0: u8, c1: u8, c2: u8, c3: u8) -> bool {
    if sv.len != 4 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == c0 && *(sv.ptr + 1) == c1 && *(sv.ptr + 2) == c2 && *(sv.ptr + 3) == c3
    }
}

fn clone_hir_item_shallow(arena: mut_view<Arena>, src: *mut HirItem) -> *mut HirItem {
    let dst = unsafe { hir_alloc_item(arena, (*src).kind, (*src).span) };
    unsafe {
        (*dst).attrs = (*src).attrs;
        hir_copy_vis(mut_view((*dst).vis), (*src).vis.kind, (*src).vis.span);
        hir_copy_dotted(mut_view((*dst).module_path), view((*src).module_path));
        (*dst).next = 0 as *mut HirItem;
        hir_copy_dotted(mut_view((*dst).mod_path), view((*src).mod_path));
        (*dst).use_tree = (*src).use_tree;
        (*dst).is_async = (*src).is_async;
        (*dst).is_comptime = (*src).is_comptime;
        (*dst).is_unsafe = (*src).is_unsafe;
        (*dst).is_mut = (*src).is_mut;
        (*dst).is_tuple = (*src).is_tuple;
        (*dst).abi.v = (*src).abi.v;
        (*dst).name.v = (*src).name.v;
        (*dst).symbol.v = (*src).symbol.v;
        (*dst).generic_params = (*src).generic_params;
        (*dst).params = (*src).params;
        (*dst).ret_type = (*src).ret_type;
        (*dst).where_clause = (*src).where_clause;
        (*dst).body = (*src).body;
        (*dst).struct_fields = (*src).struct_fields;
        (*dst).tuple_types = (*src).tuple_types;
        (*dst).variants = (*src).variants;
        (*dst).supertraits = (*src).supertraits;
        (*dst).trait_path = (*src).trait_path;
        (*dst).self_type = (*src).self_type;
        (*dst).members = (*src).members;
        (*dst).ty = (*src).ty;
        (*dst).expr = (*src).expr;
    }
    dst
}

pub fn hir_postprocess_items(arena: mut_view<Arena>, hf: mut_view<HirFile>, interner: mut_view<StrInterner>) {
    let mut tail: *mut HirItem = hf.items;
    if (tail as usize) == 0 {
        return;
    }
    while (unsafe { (*tail).next as usize }) != 0 {
        tail = unsafe { (*tail).next };
    }
    let orig_tail: *mut HirItem = tail;
    let mut it: *mut HirItem = hf.items;
    while (it as usize) != 0 {
        let is_last = (it as usize) == (orig_tail as usize);
        let k = unsafe { (*it).kind };
        if k == HIR_ITEM_IMPL && (unsafe { (*it).members as usize }) != 0 {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            let st: *mut HirType = unsafe { (*it).self_type };
            if (tp as usize) != 0 && (st as usize) != 0 && (unsafe { (*st).kind }) == HIR_TYPE_PATH && (unsafe { (*tp).kind }) == HIR_TYPE_PATH {
                if (unsafe { (*tp).path.generic_args as usize }) == 0 {
                    let tname = interner_get(view(*interner), unsafe { (*tp).path.name });
                    if sv_eq_cstr4(tname, 68u8, 114u8, 111u8, 112u8) {
                        let sname = interner_get(view(*interner), unsafe { (*st).path.name });
                        let buf = arena_alloc_raw(mut_view(*arena), sname.len + 5, 1);
                        let mut i: usize = 0;
                        while (i < sname.len) {
                            unsafe { *(buf + i) = *(sname.ptr + i); }
                            i = i + 1;
                        }
                        unsafe {
                            *(buf + sname.len + 0) = 95u8;
                            *(buf + sname.len + 1) = 100u8;
                            *(buf + sname.len + 2) = 114u8;
                            *(buf + sname.len + 3) = 111u8;
                            *(buf + sname.len + 4) = 112u8;
                        }
                        let mangled_id = interner_intern_bytes(mut_view(*interner), buf as *const u8, sname.len + 5);
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while (m as usize) != 0 {
                            if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                                let fname = interner_get(view(*interner), unsafe { (*m).name });
                                if sv_eq_cstr4(fname, 100u8, 114u8, 111u8, 112u8) {
                                    unsafe {
                                        (*m).name.v = mangled_id.v;
                                        (*m).symbol.v = mangled_id.v;
                                    }
                                }
                            }
                            m = unsafe { (*m).next };
                        }
                    }
                }
            }
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                let copy = clone_hir_item_shallow(mut_view(*arena), m);
                unsafe { (*tail).next = copy; }
                tail = copy;
                m = unsafe { (*m).next };
            }
        } else if k == HIR_ITEM_EXTERN_BLOCK && (unsafe { (*it).members as usize }) != 0 {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                let copy = clone_hir_item_shallow(mut_view(*arena), m);
                unsafe { (*tail).next = copy; }
                tail = copy;
                m = unsafe { (*m).next };
            }
        }
        if is_last {
            break;
        }
        it = unsafe { (*it).next };
    }
}

pub fn lower_file(arena: mut_view<Arena>, ast: view<Ast>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, interner: mut_view<StrInterner>) -> HirFile {
    let mut hf = lower_ast(mut_view(*arena), ast, rmap, sink);
    hir_postprocess_items(arena, mut_view(hf), interner);
    HirFile { items: hf.items }
}
