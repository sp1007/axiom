const LOWER_NOT_SUPPORTED_MSG: [17]u8 = [
    78u8, 111u8, 116u8, 32u8, 121u8, 101u8, 116u8, 32u8,
    115u8, 117u8, 112u8, 112u8, 111u8, 114u8, 116u8, 101u8, 100u8,
];

struct LowerCtx {
    fake_sym_counter: u32,
}

fn emit_not_supported(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, sp: Span) {
    let code = DiagCode { v: AX_NAME_NOT_YET_SUPPORTED };
    let buf = unsafe { arena_alloc_raw(mut_view((*sink).arena), 18, 1) };
    let mut i: usize = 0;
    while (i < 17) {
        unsafe { *(buf + i) = LOWER_NOT_SUPPORTED_MSG[i]; }
        i = i + 1;
    }
    unsafe { *(buf + 17) = 0u8; }
    let mut d = Diagnostic {
        code: code,
        severity: diag_code_severity(code),
        message: StrView { ptr: buf as *const u8, len: 17 },
        primary: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    hir_set_span(mut_view(d.primary), sp);
    unsafe { diag_sink_report(mut_view(*sink), view(d)); }
}

fn get_symbol(ctx: view<LowerCtx>, rmap: view<ResolveMap>, node: usize) -> SymbolId {
    let sym = unsafe { nodemap_get(view((*rmap).node_map), node) };
    if (sym as usize) != 0 {
        return SymbolId { v: unsafe { (*sym).v } };
    }
    let ext = unsafe { nodemap_get(view((*rmap).extern_nodes), node) };
    if (ext as usize) != 0 {
        return SymbolId { v: unsafe { (*ext).v } };
    }
    SymbolId { v: 0u32 }
}

fn lower_path_into(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, dst: mut_view<HirPath>, seg: *mut AstTypePathSegment) {
    if (seg as usize) == 0 {
        hir_set_span(mut_view(dst.span), Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 });
        dst.symbol.v = 0u32;
        dst.name.v = 0u32;
        dst.generic_args = 0 as *mut HirGenericArgs;
        return;
    }
    hir_set_span(mut_view(dst.span), unsafe { (*seg).span });
    let mut last = seg;
    while (unsafe { (*last).next as usize }) != 0 {
        last = unsafe { (*last).next };
        dst.span.end = unsafe { (*last).span.end };
    }
    let sym = get_symbol(view(*ctx), view(*rmap), last as usize);
    dst.symbol.v = sym.v;
    dst.name.v = unsafe { (*last).name.v };
    let _t1 = lower_generic_args(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), unsafe { (*last).generic_args });
    dst.generic_args = _t1;
}

fn lower_generic_args(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, g: *mut AstGenericArgs) -> *mut HirGenericArgs {
    if (g as usize) == 0 {
        return 0 as *mut HirGenericArgs;
    }
    let hg = unsafe { hir_alloc_generic_args(mut_view(*arena), (*g).span) };
    let mut tail: *mut HirGenericArg = 0 as *mut HirGenericArg;
    let mut a: *mut AstGenericArg = unsafe { (*g).args };
    while (a as usize) != 0 {
        let ha = unsafe { hir_alloc_generic_arg(mut_view(*arena), (*a).span) };
        unsafe {
            (*ha).name.v = (*a).name.v;
            let _t2 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*a).ty);
            (*ha).ty = _t2;
            if (tail as usize) == 0 {
                (*hg).args = ha;
            } else {
                (*tail).next = ha;
            }
        }
        tail = ha;
        a = unsafe { (*a).next };
    }
    hg
}

fn lower_generic_params(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, g: *mut AstGenericParams) -> *mut HirGenericParams {
    if (g as usize) == 0 {
        return 0 as *mut HirGenericParams;
    }
    let hg = unsafe { hir_alloc_generic_params(mut_view(*arena), (*g).span) };
    let mut tail: *mut HirGenericParam = 0 as *mut HirGenericParam;
    let mut a: *mut AstGenericParam = unsafe { (*g).params };
    while (a as usize) != 0 {
        let ha = unsafe { hir_alloc_generic_param(mut_view(*arena), (*a).span) };
        let sym = get_symbol(view(*ctx), view(*rmap), a as usize);
        unsafe {
            (*ha).name.v = (*a).name.v;
            (*ha).symbol.v = sym.v;
            let _t3 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*a).bounds);
            (*ha).bounds = _t3;
            if (tail as usize) == 0 {
                (*hg).params = ha;
            } else {
                (*tail).next = ha;
            }
        }
        tail = ha;
        a = unsafe { (*a).next };
    }
    hg
}

fn lower_where_clause(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, w: *mut AstWhereClause) -> *mut HirWhereClause {
    if (w as usize) == 0 {
        return 0 as *mut HirWhereClause;
    }
    let hw = unsafe { hir_alloc_where_clause(mut_view(*arena), (*w).span) };
    let mut tail: *mut HirWherePred = 0 as *mut HirWherePred;
    let mut p: *mut AstWherePred = unsafe { (*w).preds };
    while (p as usize) != 0 {
        let hp = unsafe { hir_alloc_where_pred(mut_view(*arena), (*p).span) };
        unsafe {
            let _t4 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*p).ty);
            (*hp).ty = _t4;
            let _t5 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*p).bounds);
            (*hp).bounds = _t5;
            if (tail as usize) == 0 {
                (*hw).preds = hp;
            } else {
                (*tail).next = hp;
            }
        }
        tail = hp;
        p = unsafe { (*p).next };
    }
    hw
}

fn lower_attrs(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, a: *mut AstAttr) -> *mut HirAttr {
    let mut head: *mut HirAttr = 0 as *mut HirAttr;
    let mut tail: *mut HirAttr = 0 as *mut HirAttr;
    let mut cur = a;
    while (cur as usize) != 0 {
        let ha = unsafe { hir_alloc_attr(mut_view(*arena), (*cur).span) };
        unsafe { (*ha).name.v = (*cur).name.v; }
        let mut arg_tail: *mut HirAttrArg = 0 as *mut HirAttrArg;
        let mut arg: *mut AstAttrArg = unsafe { (*cur).args };
        while (arg as usize) != 0 {
            let harg = unsafe { hir_alloc_attr_arg(mut_view(*arena), (*arg).span) };
            unsafe {
                (*harg).name.v = (*arg).name.v;
                let _t6 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*arg).expr);
                (*harg).expr = _t6;
                if (arg_tail as usize) == 0 {
                    (*ha).args = harg;
                } else {
                    (*arg_tail).next = harg;
                }
            }
            arg_tail = harg;
            arg = unsafe { (*arg).next };
        }
        if (tail as usize) == 0 {
            head = ha;
        } else {
            unsafe { (*tail).next = ha; }
        }
        tail = ha;
        cur = unsafe { (*cur).next };
    }
    head
}

fn lower_type(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, t: *mut AstType) -> *mut HirType {
    let mut head: *mut HirType = 0 as *mut HirType;
    let mut tail: *mut HirType = 0 as *mut HirType;
    let mut cur = t;
    while (cur as usize) != 0 {
        let k = unsafe { (*cur).kind };
        let ht = unsafe { hir_alloc_type(mut_view(*arena), HIR_TYPE_ERROR, (*cur).span) };
        if k == TYPE_ERROR {
            unsafe { (*ht).kind = HIR_TYPE_ERROR; }
        } else if k == TYPE_PATH {
            unsafe {
                (*ht).kind = HIR_TYPE_PATH;
                lower_path_into(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), mut_view((*ht).path), (*cur).segments);
            }
        } else if k == TYPE_TUPLE {
            unsafe {
                (*ht).kind = HIR_TYPE_TUPLE;
                let _t7 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).elem_types);
                (*ht).elem_types = _t7;
            }
        } else if k == TYPE_ARRAY {
            unsafe {
                (*ht).kind = HIR_TYPE_ARRAY;
                let _t8 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).count_expr);
                (*ht).count_expr = _t8;
                let _t9 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).elem);
                (*ht).elem = _t9;
            }
        } else if k == TYPE_SLICE {
            unsafe {
                (*ht).kind = HIR_TYPE_SLICE;
                let _t10 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).elem);
                (*ht).elem = _t10;
            }
        } else if k == TYPE_VIEW {
            unsafe {
                (*ht).kind = HIR_TYPE_VIEW;
                (*ht).is_mut = (*cur).is_mut;
                let _t11 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).elem);
                (*ht).elem = _t11;
            }
        } else if k == TYPE_PTR {
            unsafe {
                (*ht).kind = HIR_TYPE_PTR;
                (*ht).is_mut = (*cur).is_mut;
                let _t12 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).elem);
                (*ht).elem = _t12;
            }
        } else if k == TYPE_FN {
            unsafe {
                (*ht).kind = HIR_TYPE_FN;
                (*ht).is_unsafe = (*cur).is_unsafe;
                (*ht).abi.v = (*cur).abi.v;
                let _t13 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).param_types);
                (*ht).param_types = _t13;
                let _t14 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).ret_type);
                (*ht).ret_type = _t14;
            }
        } else if k == TYPE_DYN {
            unsafe {
                (*ht).kind = HIR_TYPE_DYN;
                let _t15 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).bounds);
                (*ht).bounds = _t15;
            }
        }
        if (tail as usize) == 0 {
            head = ht;
        } else {
            unsafe { (*tail).next = ht; }
        }
        tail = ht;
        cur = unsafe { (*cur).next };
    }
    head
}

fn lower_pat(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, p: *mut AstPat) -> *mut HirPat {
    let mut head: *mut HirPat = 0 as *mut HirPat;
    let mut tail: *mut HirPat = 0 as *mut HirPat;
    let mut cur = p;
    while (cur as usize) != 0 {
        let k = unsafe { (*cur).kind };
        let hp = unsafe { hir_alloc_pat(mut_view(*arena), HIR_PAT_ERROR, (*cur).span) };
        if k == PAT_ERROR {
            unsafe { (*hp).kind = HIR_PAT_ERROR; }
        } else if k == PAT_WILDCARD {
            unsafe { (*hp).kind = HIR_PAT_WILDCARD; }
        } else if k == PAT_RANGE {
            unsafe {
                (*hp).kind = HIR_PAT_RANGE;
                (*hp).is_inclusive = (*cur).is_inclusive;
                let _t16 = lower_pat(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).start_pat);
                (*hp).start_pat = _t16;
                let _t17 = lower_pat(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).end_pat);
                (*hp).end_pat = _t17;
            }
        } else if k == PAT_LITERAL {
            unsafe {
                (*hp).kind = HIR_PAT_LITERAL;
                hir_copy_token(mut_view((*hp).tok), view((*cur).tok));
                (*hp).is_negated = (*cur).is_negated;
            }
        } else if k == PAT_BINDING {
            let sym = get_symbol(view(*ctx), view(*rmap), cur as usize);
            unsafe {
                (*hp).kind = HIR_PAT_BINDING;
                (*hp).is_mut = (*cur).is_mut;
                (*hp).symbol.v = sym.v;
            }
        } else if k == PAT_PATH {
            unsafe {
                (*hp).kind = HIR_PAT_PATH;
                lower_path_into(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), mut_view((*hp).path), (*cur).segments);
                let _t18 = lower_pat(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).payload);
                (*hp).payload = _t18;
            }
        } else if k == PAT_TUPLE {
            unsafe {
                (*hp).kind = HIR_PAT_TUPLE;
