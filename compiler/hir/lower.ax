            unsafe {
                (*next).kind = HIR_EXPR_INDEX;
                (*next).base = head;
                let _t26 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*seg).index_arg);
                (*next).index_arg = _t26;
            }
        } else if sk == POSTFIX_TRY {
            unsafe {
                (*next).kind = HIR_EXPR_TRY;
                (*next).inner = head;
            }
        } else if sk == POSTFIX_AWAIT || sk == POSTFIX_ARROW {
            emit_not_supported(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), unsafe { (*seg).span });
            unsafe { (*next).kind = HIR_EXPR_ERROR; }
