        let hf = unsafe { hir_alloc_field_decl(mut_view(*arena), (*f).span) };
        unsafe {
            let _t73 = lower_attrs(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*f).attrs);
            (*hf).attrs = _t73;
            hir_copy_vis(mut_view((*hf).vis), (*f).vis.kind, (*f).vis.span);
            (*hf).name.v = (*f).name.v;
            let _t74 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*f).ty);
            (*hf).ty = _t74;
            if (tail as usize) == 0 {
                head = hf;
            } else {
                (*tail).next = hf;
            }
        }
        tail = hf;
        f = unsafe { (*f).next };
    }
    head
}

fn lower_item(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, n: *mut AstItem) -> *mut HirItem {
