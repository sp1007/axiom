                    (*hs).else_block = _t65;
                }
            }
        } else if k == STMT_ASSIGN {
            unsafe {
                (*hs).kind = HIR_STMT_ASSIGN;
                let _t66 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).left);
                (*hs).left = _t66;
                if (*cur).op == ASSIGN_EQ {
                    let _t67 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).right);
                    (*hs).right = _t67;
                } else {
                    let right = hir_alloc_expr(mut_view(*arena), HIR_EXPR_BINARY, (*cur).span);
                    let _t68 = assign_op_to_binop((*cur).op);
                    (*right).op = _t68;
                    let _t69 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).left);
                    (*right).left = _t69;
                    let _t70 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).right);
                    (*right).right = _t70;
                    (*hs).right = right;
                }
            }
        } else if k == STMT_EXPR {
            unsafe {
