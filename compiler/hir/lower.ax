                (*hi).generic_params = _t95;
                let _t96 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).trait_path);
                (*hi).trait_path = _t96;
                let _t97 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).self_type);
                (*hi).self_type = _t97;
                let _t98 = lower_where_clause(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).where_clause);
                (*hi).where_clause = _t98;
                let _t99 = lower_item(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).members);
