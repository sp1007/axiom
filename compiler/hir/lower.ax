fn assign_op_to_binop(op: u8) -> u8 {
    if op == ASSIGN_ADD { return BINOP_ADD; }
    if op == ASSIGN_SUB { return BINOP_SUB; }
    if op == ASSIGN_MUL { return BINOP_MUL; }
    if op == ASSIGN_DIV { return BINOP_DIV; }
    if op == ASSIGN_REM { return BINOP_REM; }
    if op == ASSIGN_BITAND { return BINOP_BITAND; }
    if op == ASSIGN_BITOR { return BINOP_BITOR; }
    if op == ASSIGN_BITXOR { return BINOP_BITXOR; }
    if op == ASSIGN_SHL { return BINOP_SHL; }
    if op == ASSIGN_SHR { return BINOP_SHR; }
    0u8
}

fn lower_stmt(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, s: *mut AstStmt) -> *mut HirStmt {
    let mut head: *mut HirStmt = 0 as *mut HirStmt;
    let mut tail: *mut HirStmt = 0 as *mut HirStmt;
