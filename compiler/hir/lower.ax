}

fn alloc_or_get_sym(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, node: usize) -> u32 {
    let sym = get_symbol(view(*ctx), view(*rmap), node);
    if sym.v != 0u32 {
        return sym.v;
    }
    let v = ctx.fake_sym_counter;
    ctx.fake_sym_counter = v + 1u32;
    v
}

fn lower_field_decls(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, fields: *mut AstFieldDecl) -> *mut HirFieldDecl {
    let mut head: *mut HirFieldDecl = 0 as *mut HirFieldDecl;
    let mut tail: *mut HirFieldDecl = 0 as *mut HirFieldDecl;
