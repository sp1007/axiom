fn lower_postfix(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, e: *mut AstExpr) -> *mut HirExpr {
    let mut head = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), unsafe { (*e).head });
    let mut seg: *mut AstPostfixSeg = unsafe { (*e).postfix_segs };
