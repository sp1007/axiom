@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

fn tval_hasher_write_u8(h: mut_view<AxHasher>, v: u8) {
    ax_hasher_write_u32(h, v as u32);
}

// =================================================================================================
// 1. Five-Tier Observable Semantic Equivalence Hierarchy & TranslationWitness (AXS-PCT-020)
// =================================================================================================

@derive(Copy)
pub enum EquivalenceLevel {
    Level0Structural,
    Level1Value,
    Level2MemoryResource,
    Level3EffectTrap,
    Level4ObservableSemantic,
}

pub const EQ_LEVEL_0_STRUCTURAL: u8 = 0u8;
pub const EQ_LEVEL_1_VALUE: u8 = 1u8;
pub const EQ_LEVEL_2_MEMORY_RESOURCE: u8 = 2u8;
pub const EQ_LEVEL_3_EFFECT_TRAP: u8 = 3u8;
pub const EQ_LEVEL_4_OBSERVABLE_SEMANTIC: u8 = 4u8;
pub const EQ_LEVEL_FAILED: u8 = 255u8;

pub fn eq_level_to_u8(lvl: EquivalenceLevel) -> u8 {
    match lvl {
        EquivalenceLevel.Level0Structural => EQ_LEVEL_0_STRUCTURAL,
        EquivalenceLevel.Level1Value => EQ_LEVEL_1_VALUE,
        EquivalenceLevel.Level2MemoryResource => EQ_LEVEL_2_MEMORY_RESOURCE,
        EquivalenceLevel.Level3EffectTrap => EQ_LEVEL_3_EFFECT_TRAP,
        EquivalenceLevel.Level4ObservableSemantic => EQ_LEVEL_4_OBSERVABLE_SEMANTIC,
    }
}

pub fn eq_level_from_u8(v: u8) -> EquivalenceLevel {
    if v == EQ_LEVEL_0_STRUCTURAL {
        return EquivalenceLevel.Level0Structural;
    }
    if v == EQ_LEVEL_1_VALUE {
        return EquivalenceLevel.Level1Value;
    }
    if v == EQ_LEVEL_2_MEMORY_RESOURCE {
        return EquivalenceLevel.Level2MemoryResource;
    }
    if v == EQ_LEVEL_3_EFFECT_TRAP {
        return EquivalenceLevel.Level3EffectTrap;
    }
    EquivalenceLevel.Level4ObservableSemantic
}

// Evaluate the five-tier semantic equivalence hierarchy (AXS-PCT-020):
//   Level 0 (Structural): Isomorphic IR graph structure (debug/canonicalization check).
//   Level 1 (Value): Identical return values and SSA expression outcomes for all valid inputs.
//   Level 2 (Memory & Resource): Identical observable memory stores, ownership, init, and Drop order.
//   Level 3 (Effect & Trap): Identical ordered sequence of I/O, checked traps, volatile, atomic, FFI.
//   Level 4 (Observable Semantic Equivalence): Conjunction of Levels 1-3 (mandatory across all passes).
pub fn tval_evaluate_equivalence_tier(
    level0_structural_iso: bool,
    level1_value_eq: bool,
    level2_memory_drop_eq: bool,
    level3_effect_trap_eq: bool,
    require_structural_iso: bool
) -> u8 {
    if require_structural_iso && !level0_structural_iso {
        return EQ_LEVEL_FAILED;
    }
    if level1_value_eq && level2_memory_drop_eq && level3_effect_trap_eq {
        return EQ_LEVEL_4_OBSERVABLE_SEMANTIC;
    }
    if !level1_value_eq {
        if level0_structural_iso {
            return EQ_LEVEL_0_STRUCTURAL;
        }
        return EQ_LEVEL_FAILED;
    }
    if !level2_memory_drop_eq {
        return EQ_LEVEL_1_VALUE;
    }
    // Level 1 and Level 2 hold, but Level 3 (Effect & Trap) failed
    EQ_LEVEL_2_MEMORY_RESOURCE
}

pub fn tval_meets_mandatory_criterion(verified_level: u8) -> bool {
    verified_level == EQ_LEVEL_4_OBSERVABLE_SEMANTIC
}

// Canonical Translation Validation failure codes across MIR, OptIR, LIR, RegAlloc, Scheduling, Finalize
pub const TVAL_FAIL_NONE: u8 = 0u8;
pub const TVAL_FAIL_DROPPED_OVERFLOW_TRAP: u8 = 1u8;
pub const TVAL_FAIL_DROPPED_DIV_ZERO_TRAP: u8 = 2u8;
pub const TVAL_FAIL_DROPPED_SHIFT_TRAP: u8 = 3u8;
pub const TVAL_FAIL_DROPPED_BOUNDS_TRAP: u8 = 4u8;
pub const TVAL_FAIL_BITWIDTH_OR_SIGN_MISMATCH: u8 = 5u8;
pub const TVAL_FAIL_IEEE754_NAN_OR_SIGNED_ZERO: u8 = 6u8;
pub const TVAL_FAIL_SCALAR_VALUE_MISMATCH: u8 = 7u8;
pub const TVAL_FAIL_UNPROVEN_UNREACHABLE_EDGE: u8 = 8u8;
pub const TVAL_FAIL_INCOMPLETE_PHI_OR_DOM: u8 = 9u8;
pub const TVAL_FAIL_VOLATILE_OR_ATOMIC_ELIMINATED: u8 = 10u8;
pub const TVAL_FAIL_DROP_OR_CAP_BARRIER_VIOLATED: u8 = 11u8;
pub const TVAL_FAIL_MISSING_MEMORY_ALIAS_PROOF: u8 = 12u8;
pub const TVAL_FAIL_LEGALIZATION_MISMATCH: u8 = 13u8;
pub const TVAL_FAIL_UNRESOLVED_VREG: u8 = 14u8;
pub const TVAL_FAIL_CLOBBERED_LIVE_REGISTER: u8 = 15u8;
pub const TVAL_FAIL_INVALID_SPILL_RELOAD: u8 = 16u8;
pub const TVAL_FAIL_ISA_FIXED_REG_OR_ABI_CLOBBER: u8 = 17u8;
pub const TVAL_FAIL_SCHEDULE_DATA_HAZARD: u8 = 18u8;
pub const TVAL_FAIL_EFLAGS_HAZARD: u8 = 19u8;
pub const TVAL_FAIL_VOLATILE_BARRIER_REORDERED: u8 = 20u8;
pub const TVAL_FAIL_ATOMIC_BARRIER_REORDERED: u8 = 21u8;
pub const TVAL_FAIL_TRAP_OR_CALL_BARRIER_REORDERED: u8 = 22u8;
pub const TVAL_FAIL_ALIASING_MEMORY_REORDERED: u8 = 23u8;
pub const TVAL_FAIL_FINALIZE_PIPELINE_STAGE: u8 = 24u8;
pub const TVAL_FAIL_STACK_ALIGNMENT: u8 = 25u8;
pub const TVAL_FAIL_MISSING_CHKSTK_PROBE: u8 = 26u8;
pub const TVAL_FAIL_SECRET_ZEROIZE_DROPPED: u8 = 27u8;
pub const TVAL_FAIL_UNWIND_METADATA_MISMATCH: u8 = 28u8;

@derive(Copy)
pub struct TranslationWitness {
    pub pass_id: u16,
    pub fn_id: u32,
    pub input_ir: u8,
    pub output_ir: u8,
    pub pre_fingerprint: Fingerprint128,
    pub post_fingerprint: Fingerprint128,
    pub consumed_proofs: u32,
    pub preserved_props: u32,
    pub verified_level: u8,
    pub equivalence_verified: bool,
    pub failure_kind: u8,
    pub failure_subject: u32,
}

pub const TVAL_MAX_WITNESSES: usize = 64;

pub struct TranslationValEngine {
    pub validate_translations: bool,
    pub witnesses: *mut TranslationWitness,
    pub witness_count: usize,
    pub witness_cap: usize,
    pub verified_count: u32,
    pub failed_count: u32,
    pub last_failure_kind: u8,
    pub last_failure_pass_id: u16,
    pub last_failure_subject: u32,
}

unsafe fn tval_witness_at(base: *mut TranslationWitness, idx: usize) -> *mut TranslationWitness {
    let off = ((idx as isize) * (size_of<TranslationWitness>() as isize)) as usize;
    ((base as usize) + off) as *mut TranslationWitness
}

unsafe fn tval_cert_at_const(base: *mut ProofCertificate, idx: usize) -> *const ProofCertificate {
    let off = ((idx as isize) * (size_of<ProofCertificate>() as isize)) as usize;
    ((base as usize) + off) as *const ProofCertificate
}

pub fn tval_engine_init(
    eng: mut_view<TranslationValEngine>,
    arena: mut_view<Arena>,
    validate_translations: bool
) {
    let mem = arena_alloc_raw(
        mut_view(*arena),
        mir_mul_usize(TVAL_MAX_WITNESSES, size_of<TranslationWitness>()),
        align_of<TranslationWitness>()
    ) as *mut TranslationWitness;
    eng.validate_translations = validate_translations;
    eng.witnesses = mem;
    eng.witness_count = 0;
    eng.witness_cap = TVAL_MAX_WITNESSES;
    eng.verified_count = 0u32;
    eng.failed_count = 0u32;
    eng.last_failure_kind = TVAL_FAIL_NONE;
    eng.last_failure_pass_id = 0u16;
    eng.last_failure_subject = 0u32;
}

pub fn tval_compute_stage_fingerprint(
    stage_tag: u32,
    fn_id: u32,
    item_count: u32,
    state_lo: u64,
    state_hi: u64
) -> Fingerprint128 {
    let mut h1 = ax_hasher_new();
    ax_hasher_write_u32(mut_view(h1), stage_tag);
    ax_hasher_write_u32(mut_view(h1), fn_id);
    ax_hasher_write_u32(mut_view(h1), item_count);
    ax_hasher_write_u64(mut_view(h1), state_lo);
    ax_hasher_write_u64(mut_view(h1), state_hi);
    let lo = ax_hasher_finish(view(h1));

    let mut h2 = ax_hasher_new();
    ax_hasher_write_u64(mut_view(h2), 0x7700_BEEF_CAFE_2525u64);
    ax_hasher_write_u64(mut_view(h2), state_hi ^ (stage_tag as u64));
    ax_hasher_write_u64(mut_view(h2), state_lo ^ (fn_id as u64));
    ax_hasher_write_u32(mut_view(h2), item_count);
    let hi = ax_hash_combine(lo, ax_hasher_finish(view(h2)));

    Fingerprint128 { lo: lo, hi: hi }
}

pub fn tval_compute_mir_fingerprint(body: view<MirBody>, ir_revision: u32) -> Fingerprint128 {
    let mut h1 = ax_hasher_new();
    ax_hasher_write_u32(mut_view(h1), ir_revision);
    ax_hasher_write_u32(mut_view(h1), body.local_count as u32);
    ax_hasher_write_u32(mut_view(h1), body.bb_count as u32);

    let mut h2 = ax_hasher_new();
    ax_hasher_write_u64(mut_view(h2), 0x1805_7700_AAAA_5555u64);

    let mut b: usize = 0;
    while b < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, b) };
        let sc = unsafe { (*bb).stmt_count };
        ax_hasher_write_u32(mut_view(h1), sc as u32);
        let stmts = unsafe { (*bb).stmts };
        let mut s: usize = 0;
        while s < sc {
            let st = unsafe { mir_stmt_at(stmts, s) };
            tval_hasher_write_u8(mut_view(h1), unsafe { (*st).kind });
            ax_hasher_write_u32(mut_view(h1), unsafe { (*st).place.local.v });
            tval_hasher_write_u8(mut_view(h1), unsafe { (*st).rvalue.kind });
            ax_hasher_write_u32(mut_view(h2), (unsafe { (*st).place.local.v }) ^ (s as u32));
            s = s + 1;
        }
        if unsafe { (*bb).has_terminator } {
            let tk = unsafe { (*bb).terminator.kind };
            tval_hasher_write_u8(mut_view(h1), tk);
            if tk == MIR_TERM_GOTO {
                ax_hasher_write_u32(mut_view(h2), unsafe { (*bb).terminator.goto_target.v });
            } else if tk == MIR_TERM_SWITCH_INT {
                ax_hasher_write_u32(mut_view(h2), unsafe { (*bb).terminator.otherwise.v });
            } else if tk == MIR_TERM_CALL {
                ax_hasher_write_u32(mut_view(h2), unsafe { (*bb).terminator.call_target.v });
            } else if tk == MIR_TERM_DROP {
                ax_hasher_write_u32(mut_view(h2), unsafe { (*bb).terminator.drop_target.v });
            } else if tk == MIR_TERM_ASSERT {
                ax_hasher_write_u32(mut_view(h2), unsafe { (*bb).terminator.assert_target.v });
            }
        }
        b = b + 1;
    }
    let lo = ax_hasher_finish(view(h1));
    let hi = ax_hash_combine(lo, ax_hasher_finish(view(h2)));
    Fingerprint128 { lo: lo, hi: hi }
}

// Check if `cert_id` in `store` is usable (`Certainty.Proven`, valid at current IR revision)
// AND matches `expected_prop_kind`.
pub fn tval_check_proof_cert_kind(
    store: view<ProofStore>,
    cert_id: u32,
    expected_prop_kind: u8
) -> bool {
    if !proof_store_is_cert_usable(store, cert_id) {
        return false;
    }
    let cp = unsafe { tval_cert_at_const(store.certs, cert_id as usize) };
    (unsafe { (*cp).kind }) == expected_prop_kind
}

