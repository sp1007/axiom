const VERIFY_TEXT_OFF: [149]u32 = [
    0u32, 36u32, 80u32, 122u32, 163u32, 199u32, 236u32, 282u32, 320u32, 356u32, 397u32, 440u32,
    478u32, 521u32, 552u32, 578u32, 620u32, 658u32, 693u32, 732u32, 768u32, 810u32, 853u32, 880u32,
