@derive(Copy)
pub enum IrLevel {
    Hir,
    Thir,
    Mir,
    OptIr,
    Lir,
    MachIr,
}

pub const IR_LEVEL_HIR: u8 = 0u8;
pub const IR_LEVEL_THIR: u8 = 1u8;
pub const IR_LEVEL_MIR: u8 = 2u8;
pub const IR_LEVEL_OPT_IR: u8 = 3u8;
pub const IR_LEVEL_LIR: u8 = 4u8;
pub const IR_LEVEL_MACH_IR: u8 = 5u8;

pub fn ir_level_to_u8(lvl: IrLevel) -> u8 {
    match lvl {
        IrLevel.Hir => IR_LEVEL_HIR,
        IrLevel.Thir => IR_LEVEL_THIR,
        IrLevel.Mir => IR_LEVEL_MIR,
        IrLevel.OptIr => IR_LEVEL_OPT_IR,
        IrLevel.Lir => IR_LEVEL_LIR,
        IrLevel.MachIr => IR_LEVEL_MACH_IR,
    }
}

@derive(Copy)
pub enum AnalysisKind {
    Cfg,
    DominatorTree,
    PostDominatorTree,
    LoopForest,
    SsaDefUse,
    MemorySsa,
    Liveness,
    DefiniteInit,
    MoveState,
    CapabilityLoans,
    RegionOutlives,
    AliasSummary,
    EscapeSummary,
    EffectSummary,
    ValueRange,
    KnownBits,
    Nullability,
    CallGraphScc,
    CostProfile,
}

pub const PCT_ANALYSIS_CFG: u8 = 0u8;
pub const PCT_ANALYSIS_DOM_TREE: u8 = 1u8;
pub const PCT_ANALYSIS_POST_DOM_TREE: u8 = 2u8;
pub const PCT_ANALYSIS_LOOP_FOREST: u8 = 3u8;
pub const PCT_ANALYSIS_SSA_DEF_USE: u8 = 4u8;
pub const PCT_ANALYSIS_MEMORY_SSA: u8 = 5u8;
pub const PCT_ANALYSIS_LIVENESS: u8 = 6u8;
pub const PCT_ANALYSIS_DEFINITE_INIT: u8 = 7u8;
pub const PCT_ANALYSIS_MOVE_STATE: u8 = 8u8;
pub const PCT_ANALYSIS_CAPABILITY_LOANS: u8 = 9u8;
pub const PCT_ANALYSIS_REGION_OUTLIVES: u8 = 10u8;
pub const PCT_ANALYSIS_ALIAS_SUMMARY: u8 = 11u8;
pub const PCT_ANALYSIS_ESCAPE_SUMMARY: u8 = 12u8;
pub const PCT_ANALYSIS_EFFECT_SUMMARY: u8 = 13u8;
pub const PCT_ANALYSIS_VALUE_RANGE: u8 = 14u8;
pub const PCT_ANALYSIS_KNOWN_BITS: u8 = 15u8;
pub const PCT_ANALYSIS_NULLABILITY: u8 = 16u8;
pub const PCT_ANALYSIS_CALL_GRAPH_SCC: u8 = 17u8;
pub const PCT_ANALYSIS_COST_PROFILE: u8 = 18u8;
pub const PCT_ANALYSIS_COUNT: usize = 19;

pub const PCT_MASK_CFG: u32 = 1u32;
pub const PCT_MASK_DOM_TREE: u32 = 2u32;
pub const PCT_MASK_POST_DOM_TREE: u32 = 4u32;
pub const PCT_MASK_LOOP_FOREST: u32 = 8u32;
pub const PCT_MASK_SSA_DEF_USE: u32 = 16u32;
pub const PCT_MASK_MEMORY_SSA: u32 = 32u32;
pub const PCT_MASK_LIVENESS: u32 = 64u32;
pub const PCT_MASK_DEFINITE_INIT: u32 = 128u32;
pub const PCT_MASK_MOVE_STATE: u32 = 256u32;
pub const PCT_MASK_CAPABILITY_LOANS: u32 = 512u32;
pub const PCT_MASK_REGION_OUTLIVES: u32 = 1024u32;
pub const PCT_MASK_ALIAS_SUMMARY: u32 = 2048u32;
pub const PCT_MASK_ESCAPE_SUMMARY: u32 = 4096u32;
pub const PCT_MASK_EFFECT_SUMMARY: u32 = 8192u32;
pub const PCT_MASK_VALUE_RANGE: u32 = 16384u32;
pub const PCT_MASK_KNOWN_BITS: u32 = 32768u32;
pub const PCT_MASK_NULLABILITY: u32 = 65536u32;
pub const PCT_MASK_CALL_GRAPH_SCC: u32 = 131072u32;
pub const PCT_MASK_COST_PROFILE: u32 = 262144u32;
pub const PCT_MASK_ALL_ANALYSES: u32 = 524287u32;

pub fn pct_analysis_bit(kind_id: u8) -> u32 {
    if (kind_id as usize) >= PCT_ANALYSIS_COUNT {
        return 0u32;
    }
    1u32 << (kind_id as u32)
}

pub fn pct_analysis_kind_bit(kind: AnalysisKind) -> u32 {
    match kind {
        AnalysisKind.Cfg => PCT_MASK_CFG,
        AnalysisKind.DominatorTree => PCT_MASK_DOM_TREE,
        AnalysisKind.PostDominatorTree => PCT_MASK_POST_DOM_TREE,
        AnalysisKind.LoopForest => PCT_MASK_LOOP_FOREST,
        AnalysisKind.SsaDefUse => PCT_MASK_SSA_DEF_USE,
        AnalysisKind.MemorySsa => PCT_MASK_MEMORY_SSA,
        AnalysisKind.Liveness => PCT_MASK_LIVENESS,
        AnalysisKind.DefiniteInit => PCT_MASK_DEFINITE_INIT,
        AnalysisKind.MoveState => PCT_MASK_MOVE_STATE,
        AnalysisKind.CapabilityLoans => PCT_MASK_CAPABILITY_LOANS,
        AnalysisKind.RegionOutlives => PCT_MASK_REGION_OUTLIVES,
        AnalysisKind.AliasSummary => PCT_MASK_ALIAS_SUMMARY,
        AnalysisKind.EscapeSummary => PCT_MASK_ESCAPE_SUMMARY,
        AnalysisKind.EffectSummary => PCT_MASK_EFFECT_SUMMARY,
        AnalysisKind.ValueRange => PCT_MASK_VALUE_RANGE,
        AnalysisKind.KnownBits => PCT_MASK_KNOWN_BITS,
        AnalysisKind.Nullability => PCT_MASK_NULLABILITY,
        AnalysisKind.CallGraphScc => PCT_MASK_CALL_GRAPH_SCC,
        AnalysisKind.CostProfile => PCT_MASK_COST_PROFILE,
    }
}

// Topological dependency DAG between analyses:
// CFG -> DomTree/PostDomTree/Liveness/DefiniteInit/MoveState
// DomTree -> LoopForest, SsaDefUse -> MemorySsa -> AliasSummary/EscapeSummary/EffectSummary
// SsaDefUse + DomTree -> ValueRange/KnownBits/Nullability
pub fn pct_analysis_direct_deps(kind_id: u8) -> u32 {
    if kind_id == PCT_ANALYSIS_CFG {
        return 0u32;
    }
    if kind_id == PCT_ANALYSIS_DOM_TREE || kind_id == PCT_ANALYSIS_POST_DOM_TREE ||
       kind_id == PCT_ANALYSIS_LIVENESS || kind_id == PCT_ANALYSIS_DEFINITE_INIT ||
       kind_id == PCT_ANALYSIS_MOVE_STATE {
        return PCT_MASK_CFG;
    }
    if kind_id == PCT_ANALYSIS_LOOP_FOREST {
        return PCT_MASK_CFG | PCT_MASK_DOM_TREE;
    }
    if kind_id == PCT_ANALYSIS_SSA_DEF_USE {
        return PCT_MASK_CFG | PCT_MASK_DOM_TREE;
    }
    if kind_id == PCT_ANALYSIS_MEMORY_SSA {
        return PCT_MASK_CFG | PCT_MASK_DOM_TREE | PCT_MASK_SSA_DEF_USE;
    }
    if kind_id == PCT_ANALYSIS_CAPABILITY_LOANS || kind_id == PCT_ANALYSIS_REGION_OUTLIVES {
        return PCT_MASK_CFG | PCT_MASK_DOM_TREE;
    }
    if kind_id == PCT_ANALYSIS_ALIAS_SUMMARY || kind_id == PCT_ANALYSIS_ESCAPE_SUMMARY {
        return PCT_MASK_CFG | PCT_MASK_DOM_TREE | PCT_MASK_SSA_DEF_USE | PCT_MASK_MEMORY_SSA | PCT_MASK_CAPABILITY_LOANS;
    }
    if kind_id == PCT_ANALYSIS_EFFECT_SUMMARY {
        return PCT_MASK_CFG | PCT_MASK_SSA_DEF_USE | PCT_MASK_MEMORY_SSA | PCT_MASK_ALIAS_SUMMARY;
    }
    if kind_id == PCT_ANALYSIS_VALUE_RANGE || kind_id == PCT_ANALYSIS_KNOWN_BITS || kind_id == PCT_ANALYSIS_NULLABILITY {
        return PCT_MASK_CFG | PCT_MASK_DOM_TREE | PCT_MASK_SSA_DEF_USE;
    }
    if kind_id == PCT_ANALYSIS_COST_PROFILE {
        return PCT_MASK_CFG | PCT_MASK_LOOP_FOREST;
    }
    0u32
}

pub fn pct_analysis_expand_required(mask: u32) -> u32 {
    let mut cur = mask & PCT_MASK_ALL_ANALYSES;
    let mut changed = true;
    while changed {
        changed = false;
        let mut a: u8 = 0u8;
        while (a as usize) < PCT_ANALYSIS_COUNT {
            let bit = pct_analysis_bit(a);
            if (cur & bit) != 0u32 {
                let deps = pct_analysis_direct_deps(a);
                if (cur & deps) != deps {
                    cur = cur | deps;
                    changed = true;
                }
            }
            a = a + 1u8;
        }
    }
    cur
}

pub fn pct_analysis_expand_invalidated(directly_invalidated: u32) -> u32 {
    let mut inv = directly_invalidated & PCT_MASK_ALL_ANALYSES;
    let mut changed = true;
    while changed {
        changed = false;
        let mut a: u8 = 0u8;
        while (a as usize) < PCT_ANALYSIS_COUNT {
            let bit = pct_analysis_bit(a);
            if (inv & bit) == 0u32 {
                let deps = pct_analysis_direct_deps(a);
                if (inv & deps) != 0u32 {
                    inv = inv | bit;
                    changed = true;
                }
            }
            a = a + 1u8;
        }
    }
    inv
}

