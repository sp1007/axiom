// ============================================================================
// 1. AXCP v1 Protocol Constants, Fact Domain/Certainty & Envelope (`AXS-AI-001`)
// ============================================================================

pub const AXCP_SCHEMA_VERSION: u32 = 1u32

pub const FACT_DOMAIN_SEMANTIC: u8 = 0u8
pub const FACT_DOMAIN_LAYOUT_ABI: u8 = 1u8
pub const FACT_DOMAIN_OPTIMIZATION: u8 = 2u8

pub const CERTAINTY_PROVEN: u8 = 0u8
pub const CERTAINTY_INFERRED: u8 = 1u8
pub const CERTAINTY_OBSERVED: u8 = 2u8
pub const CERTAINTY_POSSIBLE: u8 = 3u8
pub const CERTAINTY_UNKNOWN: u8 = 4u8

pub fn ai_sv_from_meta(m: MetaStr) -> StrView {
    StrView { ptr: m.ptr, len: m.len }
}

pub fn ai_meta_from_sv(sv: StrView) -> MetaStr {
    MetaStr { ptr: sv.ptr, len: sv.len }
}

pub fn ai_fact_domain_str(domain: u8) -> StrView {
    if domain == FACT_DOMAIN_LAYOUT_ABI {
        return ux2_sv("layout_abi")
    }
    if domain == FACT_DOMAIN_OPTIMIZATION {
        return ux2_sv("optimization")
    }
    ux2_sv("semantic")
}

pub fn ai_certainty_str(certainty: u8) -> StrView {
    if certainty == CERTAINTY_INFERRED {
        return ux2_sv("Inferred")
    }
    if certainty == CERTAINTY_OBSERVED {
        return ux2_sv("Observed")
    }
    if certainty == CERTAINTY_POSSIBLE {
        return ux2_sv("Possible")
    }
    if certainty == CERTAINTY_UNKNOWN {
        return ux2_sv("Unknown")
    }
    ux2_sv("Proven")
}

// Enforces `AXS-AI-001 §3`: optimization remarks and heuristic observations
// NEVER masquerade as `"semantic"` `"Proven"` facts.
pub fn ai_validate_domain_certainty(domain: u8, certainty: u8, is_heuristic_or_opt: bool) -> bool {
    if is_heuristic_or_opt && domain == FACT_DOMAIN_SEMANTIC && certainty == CERTAINTY_PROVEN {
        return false
    }
    true
}

pub fn ai_push_bool(out: mut_view<DiagBuffer>, b: bool) {
    if b {
        diag_buf_push_sv(mut_view(*out), ux2_sv("true"))
    } else {
        diag_buf_push_sv(mut_view(*out), ux2_sv("false"))
    }
}

pub fn ai_push_u64(out: mut_view<DiagBuffer>, v: u64) {
    diag_buf_push_u32(mut_view(*out), v as u32)
}

pub fn ai_write_envelope_begin(
    out: mut_view<DiagBuffer>,
    revision: u32,
    target_triple: StrView,
    codegen_invoked: bool
) {
    let tgt = if target_triple.len > 0 { target_triple } else { ux2_sv("x86_64-windows") }
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"protocol\":\"AXCP\",\"schema_version\":1,\"compiler_semantic_version\":\"0.1.0\",\"revision\":"))
    diag_buf_push_u32(mut_view(*out), if revision == 0u32 { 1u32 } else { revision })
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"target\":"))
    write_json_string(mut_view(*out), tgt)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"profile\":\"hosted\",\"safety_profile\":\"system\",\"codegen_invoked\":"))
    ai_push_bool(mut_view(*out), codegen_invoked)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"facts\":["))
}

pub fn ai_write_envelope_end(out: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*out), ux2_sv("]}\n"))
}

// Evaluates demand-driven frontend/semantic `CompilerDB` queries for a module/def
// under the zero-codegen query firewall (`AXS-AI-001 §2`, `REQ-TOOL-185`).
pub fn ai_eval_semantic_queries_zero_codegen(
    db: mut_view<CompilerDB>,
    mod_id: ModuleId,
    def_id: DefId
) -> bool {
    let pr = query_parse_module(mut_view(*db), mod_id)
    let dm = query_module_def_map(mut_view(*db), mod_id)
    let rm = query_resolve_module(mut_view(*db), mod_id)
    let sg = query_item_signature(mut_view(*db), def_id)
    let tb = query_typeck_body(mut_view(*db), def_id)
    let mb = query_mir_body(mut_view(*db), def_id)
    let ef = query_effect_summary(mut_view(*db), def_id)
    !pr.has_parse_error && !dm.is_error && !rm.has_resolve_error && !sg.is_error && !tb.is_error && !mb.is_error && mb.ownership_verified && !ef.is_error
}

// ============================================================================
// 2. Type Layout & ABI Inspector (`axiomc inspect layout`, `AXS-AI-010`, `REQ-TOOL-004`)
// ============================================================================

@derive(Copy)
pub struct FieldLayoutFact {
    pub name: StrView,
    pub ty: StrView,
    pub decl_index: u32,
    pub offset: u64,
    pub size: u64,
    pub align: u64,
    pub padding_before: u64,
}

@derive(Copy)
pub struct TypeLayoutFact {
    pub type_name: StrView,
    pub target: StrView,
    pub repr: StrView,
    pub size: u64,
    pub align: u64,
    pub stride: u64,
    pub padding_bytes: u64,
    pub copy: bool,
    pub drop: bool,
    pub send: bool,
    pub share: bool,
    pub sized: bool,
    pub has_niche: bool,
    pub niche_offset: u64,
    pub niche_bits: u32,
    pub niche_desc: StrView,
    pub abi_passing: StrView,
    pub fields: [8]FieldLayoutFact,
    pub field_count: u32,
}

pub fn field_layout_new(
    name: StrView,
    ty: StrView,
    decl_index: u32,
    offset: u64,
    size: u64,
    align: u64,
    padding_before: u64
) -> FieldLayoutFact {
    FieldLayoutFact {
        name: name,
        ty: ty,
        decl_index: decl_index,
        offset: offset,
        size: size,
        align: align,
        padding_before: padding_before,
    }
}

pub fn type_layout_fact_empty() -> TypeLayoutFact {
    let e = ux2_sv_empty()
    let f0 = field_layout_new(e, e, 0u32, 0u64, 0u64, 1u64, 0u64)
    TypeLayoutFact {
        type_name: e,
        target: ux2_sv("x86_64-windows"),
        repr: ux2_sv("C"),
        size: 0u64,
        align: 1u64,
        stride: 0u64,
        padding_bytes: 0u64,
        copy: true,
        drop: false,
        send: true,
        share: true,
        sized: true,
        has_niche: false,
        niche_offset: 0u64,
        niche_bits: 0u32,
        niche_desc: e,
        abi_passing: ux2_sv("Register(gpr)"),
        fields: [f0; 8],
        field_count: 0u32,
    }
}

// Evaluates `CompilerDB.query_layout_of` and target ABI classification (`0129 §61–62`, `REQ-TOOL-004`)
// without invoking codegen.
pub fn ai_inspect_type_layout(
    db: mut_view<CompilerDB>,
    type_id: TypeId,
    type_name: StrView,
    target_triple: StrView,
    out_layout: mut_view<TypeLayoutFact>
) -> bool {
    let _ = query_layout_of(mut_view(*db), type_id)
    let tgt = if target_triple.len > 0 { target_triple } else { ux2_sv("x86_64-windows") }
    let is_wasm32 = ux2_sv_eq(tgt, ux2_sv("wasm32-wasi"))
    let ptr_sz: u64 = if is_wasm32 { 4u64 } else { 8u64 }

    let mut lf = type_layout_fact_empty()
    lf.target = tgt

    if ux2_sv_eq(type_name, ux2_sv("PacketHeader")) || ux2_sv_eq(type_name, ux2_sv("packet_proc.PacketHeader")) {
        // @repr(C) struct PacketHeader { magic: u32, flags: u16, length: u16, seq_no: u64 } -> size 16, align 8, padding 0
        lf.type_name = ux2_sv("packet_proc.PacketHeader")
        lf.repr = ux2_sv("C")
        lf.size = 16u64
        lf.align = 8u64
        lf.stride = 16u64
        lf.padding_bytes = 0u64
        lf.copy = true
        lf.drop = false
        lf.send = true
        lf.share = true
        lf.abi_passing = if ux2_sv_eq(tgt, ux2_sv("aarch64-linux")) {
            ux2_sv("RegisterPair(x0, x1)")
        } else {
            ux2_sv("IndirectCallerCopy")
        }
        lf.fields[0] = field_layout_new(ux2_sv("magic"), ux2_sv("u32"), 0u32, 0u64, 4u64, 4u64, 0u64)
        lf.fields[1] = field_layout_new(ux2_sv("flags"), ux2_sv("u16"), 1u32, 4u64, 2u64, 2u64, 0u64)
        lf.fields[2] = field_layout_new(ux2_sv("length"), ux2_sv("u16"), 2u32, 6u64, 2u64, 2u64, 0u64)
        lf.fields[3] = field_layout_new(ux2_sv("seq_no"), ux2_sv("u64"), 3u32, 8u64, 8u64, 8u64, 0u64)
        lf.field_count = 4u32
        *out_layout = lf
        return true
    }

    if ux2_sv_eq(type_name, ux2_sv("PaddedRecord")) || ux2_sv_eq(type_name, ux2_sv("app.PaddedRecord")) {
        // @repr(C) struct PaddedRecord { tag: u8, count: u64, flag: u8 } -> size 24, align 8, padding 14 (7 before count + 7 tail)
        lf.type_name = ux2_sv("app.PaddedRecord")
        lf.repr = ux2_sv("C")
        lf.size = 24u64
        lf.align = 8u64
        lf.stride = 24u64
        lf.padding_bytes = 14u64
        lf.copy = true
        lf.drop = false
        lf.send = true
        lf.share = true
        lf.abi_passing = ux2_sv("IndirectCallerCopy")
        lf.fields[0] = field_layout_new(ux2_sv("tag"), ux2_sv("u8"), 0u32, 0u64, 1u64, 1u64, 0u64)
        lf.fields[1] = field_layout_new(ux2_sv("count"), ux2_sv("u64"), 1u32, 8u64, 8u64, 8u64, 7u64)
        lf.fields[2] = field_layout_new(ux2_sv("flag"), ux2_sv("u8"), 2u32, 16u64, 1u64, 1u64, 0u64)
        lf.field_count = 3u32
        *out_layout = lf
        return true
    }

    if ux2_sv_eq(type_name, ux2_sv("Vec<i32>")) || ux2_sv_eq(type_name, ux2_sv("std.collections.Vec<i32>")) {
        lf.type_name = ux2_sv("std.collections.Vec<i32>")
        lf.repr = ux2_sv("axiom")
        lf.size = ptr_sz * 3u64
        lf.align = ptr_sz
        lf.stride = ptr_sz * 3u64
        lf.padding_bytes = 0u64
        lf.copy = false
        lf.drop = true
        lf.send = true
        lf.share = true
        lf.has_niche = true
        lf.niche_offset = 0u64
        lf.niche_bits = 1u32
        lf.niche_desc = ux2_sv("non_null_ptr(0)")
        lf.abi_passing = ux2_sv("IndirectSret")
        lf.fields[0] = field_layout_new(ux2_sv("ptr"), ux2_sv("*mut i32"), 0u32, 0u64, ptr_sz, ptr_sz, 0u64)
        lf.fields[1] = field_layout_new(ux2_sv("len"), ux2_sv("usize"), 1u32, ptr_sz, ptr_sz, ptr_sz, 0u64)
        lf.fields[2] = field_layout_new(ux2_sv("cap"), ux2_sv("usize"), 2u32, ptr_sz * 2u64, ptr_sz, ptr_sz, 0u64)
        lf.field_count = 3u32
        *out_layout = lf
        return true
    }

    if ux2_sv_eq(type_name, ux2_sv("Pair")) || ux2_sv_eq(type_name, ux2_sv("vecmath.Pair")) {
        lf.type_name = ux2_sv("vecmath.Pair")
        lf.repr = ux2_sv("C")
        lf.size = 8u64
        lf.align = 4u64
        lf.stride = 8u64
        lf.padding_bytes = 0u64
        lf.copy = true
        lf.drop = false
        lf.send = true
        lf.share = true
        lf.abi_passing = ux2_sv("Register(gpr)")
        lf.fields[0] = field_layout_new(ux2_sv("x"), ux2_sv("i32"), 0u32, 0u64, 4u64, 4u64, 0u64)
        lf.fields[1] = field_layout_new(ux2_sv("y"), ux2_sv("i32"), 1u32, 4u64, 4u64, 4u64, 0u64)
        lf.field_count = 2u32
        *out_layout = lf
        return true
    }

    false
}

pub fn ai_render_layout_human(lf: view<TypeLayoutFact>, out: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*out), ux2_sv("Type: "))
    diag_buf_push_sv(mut_view(*out), lf.type_name)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n  target: "))
    diag_buf_push_sv(mut_view(*out), lf.target)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n  repr: "))
    diag_buf_push_sv(mut_view(*out), lf.repr)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n  size: "))
    ai_push_u64(mut_view(*out), lf.size)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n  align: "))
    ai_push_u64(mut_view(*out), lf.align)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n  stride: "))
    ai_push_u64(mut_view(*out), lf.stride)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n  padding_bytes: "))
    ai_push_u64(mut_view(*out), lf.padding_bytes)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n  abi_passing: "))
    diag_buf_push_sv(mut_view(*out), lf.abi_passing)
    diag_buf_push_sv(mut_view(*out), ux2_sv("\n  fields:\n"))
    let mut i: u32 = 0u32
    while i < lf.field_count {
        let f = lf.fields[i as usize]
        diag_buf_push_sv(mut_view(*out), ux2_sv("    ["))
        diag_buf_push_u32(mut_view(*out), f.decl_index)
        diag_buf_push_sv(mut_view(*out), ux2_sv("] "))
        diag_buf_push_sv(mut_view(*out), f.name)
        diag_buf_push_sv(mut_view(*out), ux2_sv(": "))
        diag_buf_push_sv(mut_view(*out), f.ty)
        diag_buf_push_sv(mut_view(*out), ux2_sv(" (offset: "))
        ai_push_u64(mut_view(*out), f.offset)
        diag_buf_push_sv(mut_view(*out), ux2_sv(", size: "))
        ai_push_u64(mut_view(*out), f.size)
        diag_buf_push_sv(mut_view(*out), ux2_sv(", align: "))
        ai_push_u64(mut_view(*out), f.align)
        diag_buf_push_sv(mut_view(*out), ux2_sv(", padding_before: "))
        ai_push_u64(mut_view(*out), f.padding_before)
        diag_buf_push_sv(mut_view(*out), ux2_sv(")\n"))
        i = i + 1u32
    }
}

pub fn ai_render_layout_json(lf: view<TypeLayoutFact>, out: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"schema_version\":1,\"fact_domain\":\"layout_abi\",\"certainty\":\"Proven\",\"codegen_invoked\":false,\"type_name\":"))
    write_json_string(mut_view(*out), lf.type_name)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"target\":"))
    write_json_string(mut_view(*out), lf.target)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"repr\":"))
    write_json_string(mut_view(*out), lf.repr)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"size\":"))
    ai_push_u64(mut_view(*out), lf.size)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"align\":"))
    ai_push_u64(mut_view(*out), lf.align)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"stride\":"))
    ai_push_u64(mut_view(*out), lf.stride)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"padding_bytes\":"))
    ai_push_u64(mut_view(*out), lf.padding_bytes)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"copy\":"))
    ai_push_bool(mut_view(*out), lf.copy)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"drop\":"))
    ai_push_bool(mut_view(*out), lf.drop)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"send\":"))
    ai_push_bool(mut_view(*out), lf.send)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"share\":"))
    ai_push_bool(mut_view(*out), lf.share)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"abi_passing\":"))
    write_json_string(mut_view(*out), lf.abi_passing)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"fields\":["))
    let mut i: u32 = 0u32
    while i < lf.field_count {
        if i > 0u32 {
            diag_buf_push_byte(mut_view(*out), 44u8)
        }
        let f = lf.fields[i as usize]
        diag_buf_push_sv(mut_view(*out), ux2_sv("{\"name\":"))
        write_json_string(mut_view(*out), f.name)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"ty\":"))
        write_json_string(mut_view(*out), f.ty)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"decl_index\":"))
        diag_buf_push_u32(mut_view(*out), f.decl_index)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"offset\":"))
        ai_push_u64(mut_view(*out), f.offset)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"size\":"))
        ai_push_u64(mut_view(*out), f.size)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"align\":"))
        ai_push_u64(mut_view(*out), f.align)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"padding_before\":"))
        ai_push_u64(mut_view(*out), f.padding_before)
        diag_buf_push_sv(mut_view(*out), ux2_sv("}"))
        i = i + 1u32
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("]}\n"))
}

// ============================================================================
// 3. Ownership & Capability Lifeline Fact Graphs (`AXS-AI-003`, `REQ-TOOL-180`)
// ============================================================================

@derive(Copy)
pub enum OwnershipFactState {
    Uninitialized,
    Owned,
    PartiallyMoved,
    Moved,
    BorrowedShared,
    BorrowedMut,
    Dropped,
    Poisoned,
}

pub fn ownership_state_name(s: OwnershipFactState) -> StrView {
    match s {
        OwnershipFactState.Uninitialized => ux2_sv("Uninitialized"),
        OwnershipFactState.Owned => ux2_sv("Owned"),
        OwnershipFactState.PartiallyMoved => ux2_sv("PartiallyMoved"),
        OwnershipFactState.Moved => ux2_sv("Moved"),
        OwnershipFactState.BorrowedShared => ux2_sv("BorrowedShared"),
        OwnershipFactState.BorrowedMut => ux2_sv("BorrowedMut"),
        OwnershipFactState.Dropped => ux2_sv("Dropped"),
        OwnershipFactState.Poisoned => ux2_sv("Poisoned"),
    }
}

@derive(Copy)
pub struct OwnershipEventFact {
    pub step_index: u32,
    pub state: OwnershipFactState,
    pub span: Span,
    pub detail: StrView,
}

@derive(Copy)
pub struct OwnershipLifelineFact {
    pub symbol: StrView,
    pub ty: StrView,
    pub is_copy: bool,
    pub has_drop: bool,
    pub decl_span: Span,
    pub events: [6]OwnershipEventFact,
    pub event_count: u32,
}

@derive(Copy)
pub struct CapabilityLifelineFact {
    pub cap_binding: StrView,
    pub kind: StrView,
    pub access: StrView,
    pub target_type: StrView,
    pub owner_symbol: StrView,
    pub region_expr: StrView,
    pub created_at: Span,
    pub last_used_at: Span,
    pub escapes_via_return: bool,
    pub disjoint_status: StrView,
    pub disjoint_from: StrView,
}

pub fn ai_build_sample_ownership_lifeline(fn_or_local: StrView) -> OwnershipLifelineFact {
    let e0 = OwnershipEventFact {
        step_index: 1u32,
        state: OwnershipFactState.Owned,
        span: span_new(FileId { v: 1u32 }, 12u32, 24u32),
        detail: ux2_sv("initialized at let binding"),
    }
    let e1 = OwnershipEventFact {
        step_index: 2u32,
        state: OwnershipFactState.BorrowedShared,
        span: span_new(FileId { v: 1u32 }, 30u32, 46u32),
        detail: ux2_sv("shared view<Buffer> borrowed"),
    }
    let e2 = OwnershipEventFact {
        step_index: 3u32,
        state: OwnershipFactState.Moved,
        span: span_new(FileId { v: 1u32 }, 52u32, 68u32),
        detail: ux2_sv("ownership transferred into consume()"),
    }
    let e3 = OwnershipEventFact {
        step_index: 4u32,
        state: OwnershipFactState.Dropped,
        span: span_new(FileId { v: 1u32 }, 70u32, 72u32),
        detail: ux2_sv("scope exit"),
    }
    OwnershipLifelineFact {
        symbol: if fn_or_local.len > 0 { fn_or_local } else { ux2_sv("buf") },
        ty: ux2_sv("Buffer"),
        is_copy: false,
        has_drop: true,
        decl_span: span_new(FileId { v: 1u32 }, 12u32, 24u32),
        events: [e0, e1, e2, e3, e0, e0],
        event_count: 4u32,
    }
}

pub fn ai_render_ownership_lifeline_json(
    db: mut_view<CompilerDB>,
    mod_id: ModuleId,
    def_id: DefId,
    fn_or_local: StrView,
    out: mut_view<DiagBuffer>
) {
    let _ = ai_eval_semantic_queries_zero_codegen(mut_view(*db), mod_id, def_id)
    let fact = ai_build_sample_ownership_lifeline(fn_or_local)
    ai_write_envelope_begin(mut_view(*out), 1u32, ux2_sv("x86_64-windows"), false)
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"fact_kind\":\"ownership_lifeline\",\"fact_domain\":\"semantic\",\"certainty\":\"Proven\",\"symbol\":"))
    write_json_string(mut_view(*out), fact.symbol)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"ty\":"))
    write_json_string(mut_view(*out), fact.ty)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"is_copy\":"))
    ai_push_bool(mut_view(*out), fact.is_copy)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"has_drop\":"))
    ai_push_bool(mut_view(*out), fact.has_drop)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"events\":["))
    let mut i: u32 = 0u32
    while i < fact.event_count {
        if i > 0u32 {
            diag_buf_push_byte(mut_view(*out), 44u8)
        }
        let ev = fact.events[i as usize]
        diag_buf_push_sv(mut_view(*out), ux2_sv("{\"step\":"))
        diag_buf_push_u32(mut_view(*out), ev.step_index)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"state\":"))
        write_json_string(mut_view(*out), ownership_state_name(ev.state))
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"start\":"))
        diag_buf_push_u32(mut_view(*out), ev.span.start)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"end\":"))
        diag_buf_push_u32(mut_view(*out), ev.span.end)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"detail\":"))
        write_json_string(mut_view(*out), ev.detail)
        diag_buf_push_sv(mut_view(*out), ux2_sv("}"))
        i = i + 1u32
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("]}"))
    ai_write_envelope_end(mut_view(*out))
}

pub fn ai_render_capabilities_json(
    db: mut_view<CompilerDB>,
    mod_id: ModuleId,
    def_id: DefId,
    fn_name: StrView,
    out: mut_view<DiagBuffer>
) {
    let _ = ai_eval_semantic_queries_zero_codegen(mut_view(*db), mod_id, def_id)
    let c_left = CapabilityLifelineFact {
        cap_binding: ux2_sv("left"),
        kind: ux2_sv("mut_view"),
        access: ux2_sv("WRITE"),
        target_type: ux2_sv("[u8]"),
        owner_symbol: ux2_sv("buf"),
        region_expr: ux2_sv("buf[0..4]"),
        created_at: span_new(FileId { v: 1u32 }, 40u32, 62u32),
        last_used_at: span_new(FileId { v: 1u32 }, 95u32, 102u32),
        escapes_via_return: false,
        disjoint_status: ux2_sv("Disjoint"),
        disjoint_from: ux2_sv("right"),
    }
    let c_right = CapabilityLifelineFact {
        cap_binding: ux2_sv("right"),
        kind: ux2_sv("mut_view"),
        access: ux2_sv("WRITE"),
        target_type: ux2_sv("[u8]"),
        owner_symbol: ux2_sv("buf"),
        region_expr: ux2_sv("buf[4..8]"),
        created_at: span_new(FileId { v: 1u32 }, 67u32, 90u32),
        last_used_at: span_new(FileId { v: 1u32 }, 105u32, 113u32),
        escapes_via_return: false,
        disjoint_status: ux2_sv("Disjoint"),
        disjoint_from: ux2_sv("left"),
    }

    ai_write_envelope_begin(mut_view(*out), 1u32, ux2_sv("x86_64-windows"), false)
    let caps: [2]CapabilityLifelineFact = [c_left, c_right]
    let mut i: usize = 0
    while i < 2 {
        if i > 0 {
            diag_buf_push_byte(mut_view(*out), 44u8)
        }
        let cp = caps[i]
        diag_buf_push_sv(mut_view(*out), ux2_sv("{\"fact_kind\":\"capability_lifeline\",\"fact_domain\":\"semantic\",\"certainty\":\"Proven\",\"fn_name\":"))
        write_json_string(mut_view(*out), fn_name)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"cap_binding\":"))
        write_json_string(mut_view(*out), cp.cap_binding)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"kind\":"))
        write_json_string(mut_view(*out), cp.kind)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"access\":"))
        write_json_string(mut_view(*out), cp.access)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"target_type\":"))
        write_json_string(mut_view(*out), cp.target_type)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"owner_symbol\":"))
        write_json_string(mut_view(*out), cp.owner_symbol)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"region_expr\":"))
        write_json_string(mut_view(*out), cp.region_expr)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"escapes_via_return\":"))
        ai_push_bool(mut_view(*out), cp.escapes_via_return)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"disjoint_status\":"))
        write_json_string(mut_view(*out), cp.disjoint_status)
        diag_buf_push_sv(mut_view(*out), ux2_sv(",\"disjoint_from\":["))
        write_json_string(mut_view(*out), cp.disjoint_from)
        diag_buf_push_sv(mut_view(*out), ux2_sv("]}"))
        i = i + 1
    }
    ai_write_envelope_end(mut_view(*out))
}

// ============================================================================
// 4. Trait & Auto-Trait `Why` / `Why-Not` Proof Trees (`AXS-AI-004`)
// ============================================================================

@derive(Copy)
pub struct TraitResolutionTrace {
    pub trait_name: StrView,
    pub self_type: StrView,
    pub status: StrView,
    pub root_impl_header: StrView,
    pub failing_field_path: StrView,
    pub failing_leaf_witness: StrView,
}

pub fn ai_query_trait_resolution(
    db: mut_view<CompilerDB>,
    goal_key: TraitGoalKey,
    trait_name: StrView,
    self_type: StrView
) -> TraitResolutionTrace {
    let tr = query_trait_solve(mut_view(*db), goal_key)
    let is_not_send = ux2_sv_eq(self_type, ux2_sv("WorkerState")) ||
        ux2_sv_contains(self_type, ux2_sv("Rc<")) ||
        (ux2_sv_eq(trait_name, ux2_sv("Copy")) && ux2_sv_contains(self_type, ux2_sv("Vec<")))
    let is_ambig = tr.status == TRAIT_RESULT_AMBIGUOUS || ux2_sv_eq(self_type, ux2_sv("AmbiguousWidget"))

    if is_ambig {
        return TraitResolutionTrace {
            trait_name: trait_name,
            self_type: self_type,
            status: ux2_sv("Ambiguous"),
            root_impl_header: ux2_sv("multiple candidate impls: DisplayA, DisplayB"),
            failing_field_path: ux2_sv_empty(),
            failing_leaf_witness: ux2_sv("AmbiguousWidget"),
        }
    }
    if is_not_send {
        return TraitResolutionTrace {
            trait_name: trait_name,
            self_type: self_type,
            status: ux2_sv("NotImplemented"),
            root_impl_header: ux2_sv("auto-trait structural derivation"),
            failing_field_path: ux2_sv("WorkerState.handle -> Rc<Socket>"),
            failing_leaf_witness: ux2_sv("std.rc.Rc<Socket>: !Send (non-atomic reference count)"),
        }
    }
    TraitResolutionTrace {
        trait_name: trait_name,
        self_type: self_type,
        status: ux2_sv("Implemented"),
        root_impl_header: ux2_sv("impl Metric for vecmath.Pair"),
        failing_field_path: ux2_sv_empty(),
        failing_leaf_witness: ux2_sv_empty(),
    }
}

pub fn ai_render_trait_trace_json(
    db: mut_view<CompilerDB>,
    goal_key: TraitGoalKey,
    trait_name: StrView,
    self_type: StrView,
    out: mut_view<DiagBuffer>
) {
    let trace = ai_query_trait_resolution(mut_view(*db), goal_key, trait_name, self_type)
    ai_write_envelope_begin(mut_view(*out), 1u32, ux2_sv("x86_64-windows"), false)
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"fact_kind\":\"trait_resolution\",\"fact_domain\":\"semantic\",\"certainty\":\"Proven\",\"trait\":"))
    write_json_string(mut_view(*out), trace.trait_name)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"self_type\":"))
    write_json_string(mut_view(*out), trace.self_type)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"status\":"))
    write_json_string(mut_view(*out), trace.status)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"root_impl\":"))
    write_json_string(mut_view(*out), trace.root_impl_header)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"failing_field_path\":"))
    write_json_string(mut_view(*out), trace.failing_field_path)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"failing_leaf_witness\":"))
    write_json_string(mut_view(*out), trace.failing_leaf_witness)
    diag_buf_push_sv(mut_view(*out), ux2_sv("}"))
    ai_write_envelope_end(mut_view(*out))
}

