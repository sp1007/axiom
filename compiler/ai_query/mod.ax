    ai_write_envelope_begin(mut_view(*out), 1u32, ux2_sv("x86_64-windows"), false)
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"fact_kind\":\"symbol\",\"fact_domain\":\"semantic\",\"certainty\":\"Proven\",\"symbol\":"))
    write_json_string(mut_view(*out), sym_path)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"kind\":\"fn\",\"visibility\":\"pub\",\"signature\":\"pub fn split_payload(mut buf: [8]u8) -> u8\",\"callers\":[\"packet_proc.main\"],\"callees\":[]}"))
    ai_write_envelope_end(mut_view(*out))
