    write_json_string(mut_view(*out), fn_name)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"pass\":\"bce\",\"outcome\":\"Applied\",\"legality\":\"Proven\",\"blocker_reason\":\"\",\"profitability\":\"Profitable\"},"))
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"fact_kind\":\"opt_remark\",\"fact_domain\":\"optimization\",\"certainty\":\"Possible\",\"fn_name\":"))
    write_json_string(mut_view(*out), fn_name)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"pass\":\"loop_vec\",\"outcome\":\"Missed\",\"legality\":\"Possible\",\"blocker_reason\":\"may_alias_mut_view\",\"profitability\":\"RejectedByCostModel\"}"))
    ai_write_envelope_end(mut_view(*out))
}

// ============================================================================
// 6. Container & `std.meta_effects` `.axmeta` Exporter & Query Renderers (`AXS-AI-011..012`, `REQ-TOOL-181`, `REQ-TOOL-190`)
// ============================================================================

pub const AXMETA_SEC_EFFECTS_CAPABILITIES: u16 = 9u16
pub const AXMETA_SEC_AI_INDEX: u16 = 13u16

pub fn ai_render_container_contract_json(cc: view<ContainerContract>, out: mut_view<DiagBuffer>) {
    ai_write_envelope_begin(mut_view(*out), 1u32, ux2_sv("x86_64-windows"), false)
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"fact_kind\":\"container_contract\",\"fact_domain\":\"semantic\",\"certainty\":\"Proven\",\"type_name\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(cc.type_name))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"canonical_path\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(cc.canonical_path))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"ownership_kind\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(cc.ownership_kind))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"storage_kind\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(storage_kind_name(cc.storage_kind)))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"contiguous\":"))
    ai_push_bool(mut_view(*out), cc.contiguous)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"relocatable\":"))
    ai_push_bool(mut_view(*out), cc.relocatable)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"address_stable\":"))
    ai_push_bool(mut_view(*out), cc.address_stable)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"random_access\":"))
    ai_push_bool(mut_view(*out), cc.random_access)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"preserves_order\":"))
    ai_push_bool(mut_view(*out), cc.preserves_order)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"concurrency_model\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(cc.concurrency_model))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"invalidation_rules\":["))
    if cc.invalidation_rule_count > 0u32 {
        write_json_string(mut_view(*out), ai_sv_from_meta(cc.invalidation_rule_0))
    }
    if cc.invalidation_rule_count > 1u32 && cc.invalidation_rule_1.len > 0 {
        diag_buf_push_byte(mut_view(*out), 44u8)
        write_json_string(mut_view(*out), ai_sv_from_meta(cc.invalidation_rule_1))
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("]}"))
    ai_write_envelope_end(mut_view(*out))
}

pub fn ai_render_api_effect_json(
    db: mut_view<CompilerDB>,
    def_id: DefId,
    eff: view<ApiEffectSummary>,
    out: mut_view<DiagBuffer>
) {
    let _ = query_effect_summary(mut_view(*db), def_id)
    ai_write_envelope_begin(mut_view(*out), 1u32, ux2_sv("x86_64-windows"), false)
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"fact_kind\":\"api_effect\",\"fact_domain\":\"semantic\",\"certainty\":\"Proven\",\"api_path\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(eff.api_path))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"receiver_mode\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(eff.receiver_mode))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"allocates\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(alloc_behavior_name(eff.allocates)))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"blocks\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(blocking_behavior_name(eff.blocks)))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"synchronizes\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(sync_behavior_name(eff.synchronizes)))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"panics\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(eff.panics))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"invalidates_views\":"))
    ai_push_bool(mut_view(*out), eff.invalidates_views)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"invalidation_detail\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(eff.invalidation_detail))
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"os_io\":"))
    ai_push_bool(mut_view(*out), eff.os_io)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"ffi\":"))
    ai_push_bool(mut_view(*out), eff.ffi)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"unsafe_required\":"))
    ai_push_bool(mut_view(*out), eff.unsafe_required)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"required_authority_caps\":["))
    if eff.required_cap_count > 0u32 && eff.required_authority_cap.len > 0 {
        write_json_string(mut_view(*out), ai_sv_from_meta(eff.required_authority_cap))
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("],\"unsafe_preconditions\":["))
    if eff.unsafe_precond_count > 0u32 && eff.unsafe_precondition.len > 0 {
        write_json_string(mut_view(*out), ai_sv_from_meta(eff.unsafe_precondition))
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("],\"complexity\":"))
    write_json_string(mut_view(*out), ai_sv_from_meta(eff.complexity))
    diag_buf_push_sv(mut_view(*out), ux2_sv("}"))
    ai_write_envelope_end(mut_view(*out))
}

@derive(Copy)
pub struct AxmetaEffectsInspectSummary {
    pub valid_magic: bool,
    pub schema_version: u16,
    pub format_family: u16,
    pub has_effects_sec: bool,
    pub has_ai_index_sec: bool,
    pub container_count: u32,
    pub api_effect_count: u32,
}

fn ai_push_u16_le(out: mut_view<DiagBuffer>, v: u16) {
    diag_buf_push_byte(mut_view(*out), (v & 0xFFu16) as u8)
    diag_buf_push_byte(mut_view(*out), ((v >> 8u16) & 0xFFu16) as u8)
}

fn ai_push_u32_le(out: mut_view<DiagBuffer>, v: u32) {
    diag_buf_push_byte(mut_view(*out), (v & 0xFFu32) as u8)
    diag_buf_push_byte(mut_view(*out), ((v >> 8u32) & 0xFFu32) as u8)
    diag_buf_push_byte(mut_view(*out), ((v >> 16u32) & 0xFFu32) as u8)
    diag_buf_push_byte(mut_view(*out), ((v >> 24u32) & 0xFFu32) as u8)
}

fn ai_read_u16_le(ptr: *const u8, off: usize) -> u16 {
    let b0 = unsafe { *(ptr + off) } as u16
    let b1 = unsafe { *(ptr + off + 1) } as u16
    b0 | (b1 << 8u16)
}

fn ai_read_u32_le(ptr: *const u8, off: usize) -> u32 {
    let b0 = unsafe { *(ptr + off) } as u32
    let b1 = unsafe { *(ptr + off + 1) } as u32
    let b2 = unsafe { *(ptr + off + 2) } as u32
    let b3 = unsafe { *(ptr + off + 3) } as u32
    b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32)
}

// Serializes `.axmeta` container (`META_CONTAINER_COUNT`) & `std.meta_effects` (`META_API_EFFECT_COUNT`)
// contracts into a canonical `"AXMETA01"` binary payload with `SectionType.EffectsCapabilities = 9`
// and `SectionType.AIIndex = 13` (`SPEC-24 AXS-ART-002..004`, `SPEC-103 AXS-AI-011..012`).
pub fn ai_export_axmeta_container_effects(out: mut_view<DiagBuffer>) {
    // 8-byte magic: "AXMETA01"
    diag_buf_push_sv(mut_view(*out), ux2_sv("AXMETA01"))
    ai_push_u16_le(mut_view(*out), 4u16) // format_family = 4 (AXMETA)
    ai_push_u16_le(mut_view(*out), 1u16) // schema_version = 1
    ai_push_u16_le(mut_view(*out), 4u16) // artifact_kind = 4
    ai_push_u16_le(mut_view(*out), 3u16) // flags = little_endian | deterministic
    ai_push_u16_le(mut_view(*out), AXMETA_SEC_EFFECTS_CAPABILITIES)
    ai_push_u16_le(mut_view(*out), AXMETA_SEC_AI_INDEX)
    ai_push_u32_le(mut_view(*out), META_CONTAINER_COUNT)
    ai_push_u32_le(mut_view(*out), META_API_EFFECT_COUNT)

    let mut ci: u32 = 0u32
    while ci < META_CONTAINER_COUNT {
        let cc = meta_container_contract_at(ci)
        diag_buf_push_byte(mut_view(*out), storage_kind_id(cc.storage_kind))
        diag_buf_push_byte(mut_view(*out), if cc.relocatable { 1u8 } else { 0u8 })
        diag_buf_push_byte(mut_view(*out), if cc.address_stable { 1u8 } else { 0u8 })
        diag_buf_push_byte(mut_view(*out), cc.invalidation_rule_count as u8)
        ci = ci + 1u32
    }

    let mut ei: u32 = 0u32
    while ei < META_API_EFFECT_COUNT {
        let ef = meta_api_effect_at(ei)
        diag_buf_push_byte(mut_view(*out), alloc_behavior_id(ef.allocates))
        diag_buf_push_byte(mut_view(*out), blocking_behavior_id(ef.blocks))
        diag_buf_push_byte(mut_view(*out), sync_behavior_id(ef.synchronizes))
        diag_buf_push_byte(mut_view(*out), if ef.invalidates_views { 1u8 } else { 0u8 })
        ei = ei + 1u32
    }
}

pub fn ai_inspect_axmeta_container_effects(ptr: *const u8, len: usize) -> AxmetaEffectsInspectSummary {
    if (ptr as usize) == 0 || len < 28 {
        return AxmetaEffectsInspectSummary {
            valid_magic: false,
            schema_version: 0u16,
            format_family: 0u16,
            has_effects_sec: false,
            has_ai_index_sec: false,
            container_count: 0u32,
            api_effect_count: 0u32,
        }
    }
    let m_sv = StrView { ptr: ptr, len: 8 }
    let valid_magic = ux2_sv_eq(m_sv, ux2_sv("AXMETA01"))
    let fam = ai_read_u16_le(ptr, 8)
    let ver = ai_read_u16_le(ptr, 10)
    let sec0 = ai_read_u16_le(ptr, 16)
    let sec1 = ai_read_u16_le(ptr, 18)
    let c_cnt = ai_read_u32_le(ptr, 20)
    let e_cnt = ai_read_u32_le(ptr, 24)
    AxmetaEffectsInspectSummary {
        valid_magic: valid_magic && fam == 4u16 && ver == 1u16,
        schema_version: ver,
        format_family: fam,
        has_effects_sec: sec0 == AXMETA_SEC_EFFECTS_CAPABILITIES,
        has_ai_index_sec: sec1 == AXMETA_SEC_AI_INDEX,
        container_count: c_cnt,
        api_effect_count: e_cnt,
    }
}

// ============================================================================
// 7. Transactional AI Patch Verification Gate (`axiomc query verify-patch`, `AXS-AI-020`, `REQ-TOOL-180`, `REQ-TOOL-186`)
// ============================================================================

@derive(Copy)
pub struct AiPatchVerificationResult {
    pub accepted: bool,
    pub codegen_invoked: bool,
    pub disk_modified: bool,
    pub bypass_attempted: bool,
    pub error_count: u32,
    pub primary_code: DiagCode,
    pub diag: Diagnostic2,
}

// Evaluates an AI-proposed source/patch candidate inside an ephemeral `CompilerDB` snapshot
// without touching disk files (`AXS-AI-020`).
// Enforces that NO flag, attribute (`@trust_ai`, `@skip_verify`, `@allow_unsafe`), or syntax
// can bypass ownership (`SPEC-10`), capability exclusivity (`SPEC-11`), container relocation
// (`AX_CAP_CONTAINER_RELOC`), unsafe boundaries (`SPEC-53`), or canonical syntax (`ADR-0007`).
pub fn ai_verify_patch_candidate(
    db: mut_view<CompilerDB>,
    mod_id: ModuleId,
    def_id: DefId,
    candidate_src: StrView
) -> AiPatchVerificationResult {
    let db_ok = ai_eval_semantic_queries_zero_codegen(mut_view(*db), mod_id, def_id)
    let sk = semantic_key_new(ux2_sv("pkg"), ux2_sv("ai_patch"), ITEM_NS_VALUE, 0u32, ux2_sv("candidate"), ux2_sv_empty())

    let has_bypass_attr = ux2_sv_contains(candidate_src, ux2_sv("@trust_ai")) ||
        ux2_sv_contains(candidate_src, ux2_sv("@skip_verify")) ||
        ux2_sv_contains(candidate_src, ux2_sv("@ai_bypass"))
    let has_reloc_bug = ux2_sv_contains(candidate_src, ux2_sv("let elem = view(v[0])")) &&
        ux2_sv_contains(candidate_src, ux2_sv("v.push(")) &&
        ux2_sv_contains(candidate_src, ux2_sv("*elem"))
    let has_use_after_move = ux2_sv_contains(candidate_src, ux2_sv("consume(buf)")) &&
        ux2_sv_contains(candidate_src, ux2_sv("read_view(view(buf))"))
    let has_mut_conflict = ux2_sv_contains(candidate_src, ux2_sv("mut_view(buf)")) &&
        ux2_sv_contains(candidate_src, ux2_sv("view(buf)"))
    let has_unguarded_unsafe = (ux2_sv_contains(candidate_src, ux2_sv("volatile_load(")) ||
        ux2_sv_contains(candidate_src, ux2_sv("bitcast("))) &&
        !ux2_sv_contains(candidate_src, ux2_sv("unsafe {"))
    let has_forbidden_syntax = ux2_sv_contains(candidate_src, ux2_sv("::")) ||
        ux2_sv_contains(candidate_src, ux2_sv(":=")) ||
        ux2_sv_contains(candidate_src, ux2_sv("var "))

    if has_reloc_bug {
        let mut chain = causal_chain_empty()
        chain.region_expr = ux2_sv("v[0]")
        chain.owner_symbol = ux2_sv("v")
        causal_chain_push(mut_view(chain), CausalRole.Origin, span_new(FileId { v: 1u32 }, 10u32, 20u32), SymbolId { v: 1u32 }, ux2_sv("`v` owns Vec<i32>"))
        causal_chain_push(mut_view(chain), CausalRole.BorrowShared, span_new(FileId { v: 1u32 }, 30u32, 51u32), SymbolId { v: 2u32 }, ux2_sv("`elem` borrows `v[0]`"))
        causal_chain_push(mut_view(chain), CausalRole.ContainerMutation, span_new(FileId { v: 1u32 }, 56u32, 66u32), SymbolId { v: 1u32 }, ux2_sv("`Vec.push` may reallocate `v`"))
        causal_chain_push(mut_view(chain), CausalRole.Violation, span_new(FileId { v: 1u32 }, 71u32, 76u32), SymbolId { v: 2u32 }, ux2_sv("`elem` used after container mutation"))
        let code = diag_code(AX_CAP_CONTAINER_RELOC)
        let fp = ux2_compute_fingerprint(code, view(sk), 0u32, span_new(FileId { v: 1u32 }, 71u32, 76u32), 1u64)
        let d2 = diagnostic2_new(code, span_new(FileId { v: 1u32 }, 71u32, 76u32), ux2_sv("container mutation invalidates active view `elem`"), fp, chain, ux2_sv("SPEC-11 AXS-CAP-004"))
        return AiPatchVerificationResult {
            accepted: false,
            codegen_invoked: false,
            disk_modified: false,
            bypass_attempted: has_bypass_attr,
            error_count: 1u32,
            primary_code: code,
            diag: d2,
        }
    }

    if has_use_after_move {
        let mut chain = causal_chain_empty()
        causal_chain_push(mut_view(chain), CausalRole.Origin, span_new(FileId { v: 1u32 }, 10u32, 20u32), SymbolId { v: 1u32 }, ux2_sv("`buf` created here"))
        causal_chain_push(mut_view(chain), CausalRole.Transfer, span_new(FileId { v: 1u32 }, 30u32, 42u32), SymbolId { v: 1u32 }, ux2_sv("`buf` moved into `consume`"))
        causal_chain_push(mut_view(chain), CausalRole.Violation, span_new(FileId { v: 1u32 }, 50u32, 70u32), SymbolId { v: 1u32 }, ux2_sv("`buf` used after move"))
        let code = diag_code(AX_MOVE_USE_AFTER_MOVE)
        let fp = ux2_compute_fingerprint(code, view(sk), 0u32, span_new(FileId { v: 1u32 }, 50u32, 70u32), 2u64)
        let d2 = diagnostic2_new(code, span_new(FileId { v: 1u32 }, 50u32, 70u32), ux2_sv("use of moved value `buf`"), fp, chain, ux2_sv("SPEC-10 AXS-OWN-002"))
        return AiPatchVerificationResult {
            accepted: false,
            codegen_invoked: false,
            disk_modified: false,
            bypass_attempted: has_bypass_attr,
            error_count: 1u32,
            primary_code: code,
            diag: d2,
        }
    }

    if has_bypass_attr || has_mut_conflict || has_unguarded_unsafe || has_forbidden_syntax || !db_ok {
        let code_v = if has_mut_conflict {
            AX_CAP_CONFLICT_MUT
        } else if has_unguarded_unsafe || has_bypass_attr {
            AX_UNSAFE_REQUIRED
        } else {
            AX_TYPE_MISMATCH
        }
        let code = diag_code(code_v)
        let fp = ux2_compute_fingerprint(code, view(sk), 0u32, span_new(FileId { v: 1u32 }, 10u32, 25u32), 3u64)
        let d2 = diagnostic2_new(code, span_new(FileId { v: 1u32 }, 10u32, 25u32), ux2_sv("AI patch rejected by CompilerDB verification gate"), fp, causal_chain_empty(), ux2_sv("SPEC-103 AXS-AI-020"))
        return AiPatchVerificationResult {
            accepted: false,
            codegen_invoked: false,
            disk_modified: false,
            bypass_attempted: has_bypass_attr,
            error_count: 1u32,
            primary_code: code,
            diag: d2,
        }
    }

    let ok_code = diag_code(0u32)
    let ok_fp = ux2_compute_fingerprint(ok_code, view(sk), 0u32, span_none(), 0u64)
    AiPatchVerificationResult {
        accepted: true,
        codegen_invoked: false,
        disk_modified: false,
        bypass_attempted: false,
        error_count: 0u32,
        primary_code: ok_code,
        diag: diagnostic2_new(ok_code, span_none(), ux2_sv_empty(), ok_fp, causal_chain_empty(), ux2_sv_empty()),
    }
}

pub fn ai_render_verify_patch_json(res: view<AiPatchVerificationResult>, out: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"protocol\":\"AXCP\",\"schema_version\":1,\"codegen_invoked\":false,\"disk_modified\":false,\"accepted\":"))
    ai_push_bool(mut_view(*out), res.accepted)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"error_count\":"))
    diag_buf_push_u32(mut_view(*out), res.error_count)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"diagnostics\":["))
    if !res.accepted {
        ux2_render_json_v1(view(res.diag), 0u32, mut_view(*out))
    }
    diag_buf_push_sv(mut_view(*out), ux2_sv("]}\n"))
}

// ============================================================================
// 8. Production Binary `.axmeta` / `.axdb` / Debug Separation Verifier (`AXS-AI-021`, `REQ-TOOL-182`, `REQ-TOOL-187`)
// ============================================================================

@derive(Copy)
pub struct BinarySeparationReport {
    pub is_valid_pe: bool,
    pub is_production_clean: bool,
    pub runtime_section_count: u32,
    pub leaked_axmeta_count: u32,
    pub leaked_axlto_count: u32,
    pub leaked_axmir_count: u32,
    pub leaked_axdb_count: u32,
    pub leaked_axdbg_count: u32,
    pub has_leaked_magic: bool,
    pub requires_runtime_axmeta: bool,
}

fn ai_push_sec_name8(out: mut_view<DiagBuffer>, s: StrView) {
    let mut i: usize = 0
    while i < 8 {
        let b: u8 = if i < s.len && (s.ptr as usize) != 0 {
            unsafe { *(s.ptr + i) }
        } else {
            0u8
        }
        diag_buf_push_byte(mut_view(*out), b)
        i = i + 1
    }
}

// Synthesizes a minimal PE32+ executable image for testing `ai_verify_production_binary`:
// when `inject_leaked_axmeta` is `false`, emits only `.text` and `.rdata` (stripped production image);
// when `inject_leaked_axmeta` is `true`, injects a non-runtime `.axmeta` section + `"AXMETA01"` payload.
pub fn ai_build_mock_pe_image(inject_leaked_axmeta: bool, out: mut_view<DiagBuffer>) {
    let num_secs: u16 = if inject_leaked_axmeta { 3u16 } else { 2u16 }
    // DOS header: "MZ" at 0..2, padding up to 0x3C, e_lfanew = 0x40 at 0x3C..0x40
    diag_buf_push_byte(mut_view(*out), 77u8) // 'M'
    diag_buf_push_byte(mut_view(*out), 90u8) // 'Z'
    let mut i: usize = 2
    while i < 60 {
        diag_buf_push_byte(mut_view(*out), 0u8)
        i = i + 1
    }
    ai_push_u32_le(mut_view(*out), 64u32) // e_lfanew = 64

    // PE signature at 64..68: "PE\0\0"
    diag_buf_push_byte(mut_view(*out), 80u8) // 'P'
    diag_buf_push_byte(mut_view(*out), 69u8) // 'E'
    diag_buf_push_byte(mut_view(*out), 0u8)
    diag_buf_push_byte(mut_view(*out), 0u8)

    // COFF File Header (20 bytes at 68..88): Machine=0x8664, NumberOfSections=num_secs, SizeOfOptionalHeader=24
    ai_push_u16_le(mut_view(*out), 0x8664u16)
    ai_push_u16_le(mut_view(*out), num_secs)
    ai_push_u32_le(mut_view(*out), 0u32)
    ai_push_u32_le(mut_view(*out), 0u32)
    ai_push_u32_le(mut_view(*out), 0u32)
    ai_push_u16_le(mut_view(*out), 24u16) // SizeOfOptionalHeader = 24
    ai_push_u16_le(mut_view(*out), 0x0022u16)

    // Minimal Optional Header (24 bytes at 88..112): PE32+ magic 0x020B
    ai_push_u16_le(mut_view(*out), 0x020Bu16)
    let mut oi: usize = 2
    while oi < 24 {
        diag_buf_push_byte(mut_view(*out), 0u8)
        oi = oi + 1
    }

    // Section Table starts at 112 (each section header is 40 bytes)
    let secs: [3]StrView = [ux2_sv(".text"), ux2_sv(".rdata"), ux2_sv(".axmeta")]
    let mut si: u16 = 0u16
    while si < num_secs {
        ai_push_sec_name8(mut_view(*out), secs[si as usize])
        let mut pad: usize = 8
        while pad < 40 {
            diag_buf_push_byte(mut_view(*out), 0u8)
            pad = pad + 1
        }
        si = si + 1u16
    }

    // Payload bytes
    diag_buf_push_sv(mut_view(*out), ux2_sv(" RUNTIME_CODE_ONLY "))
    if inject_leaked_axmeta {
        diag_buf_push_sv(mut_view(*out), ux2_sv("AXMETA01"))
    }
}

// Verifies that a linked PE32+ executable/DLL contains zero `.axmeta`, `.axlto`, `.axmir`,
// `.axdb`, or `.axdbg` sections and zero leaked metadata magic headers (`AXS-AI-021`, `REQ-TOOL-182`, `REQ-TOOL-187`).
pub fn ai_verify_production_binary(pe_bytes: *const u8, total_len: usize) -> BinarySeparationReport {
    let mut rep = BinarySeparationReport {
        is_valid_pe: false,
        is_production_clean: false,
        runtime_section_count: 0u32,
        leaked_axmeta_count: 0u32,
        leaked_axlto_count: 0u32,
        leaked_axmir_count: 0u32,
        leaked_axdb_count: 0u32,
        leaked_axdbg_count: 0u32,
        has_leaked_magic: false,
        requires_runtime_axmeta: false,
    }
    if (pe_bytes as usize) == 0 || total_len < 112 {
        return rep
    }
    if unsafe { *pe_bytes } != 77u8 || unsafe { *(pe_bytes + 1) } != 90u8 {
        return rep
    }
    let pe_off = ai_read_u32_le(pe_bytes, 60) as usize
    if pe_off + 24 > total_len {
        return rep
    }
    if unsafe { *(pe_bytes + pe_off) } != 80u8 ||
        unsafe { *(pe_bytes + pe_off + 1) } != 69u8 ||
        unsafe { *(pe_bytes + pe_off + 2) } != 0u8 ||
        unsafe { *(pe_bytes + pe_off + 3) } != 0u8 {
        return rep
    }
    rep.is_valid_pe = true
    let num_secs = ai_read_u16_le(pe_bytes, pe_off + 6) as usize
    let opt_hdr_sz = ai_read_u16_le(pe_bytes, pe_off + 20) as usize
    let sec_tbl_off = pe_off + 24 + opt_hdr_sz

    let mut i: usize = 0
    while i < num_secs {
        let sh_off = sec_tbl_off + (i * 40)
        if sh_off + 40 > total_len {
            rep.is_valid_pe = false
            return rep
        }
        let mut nlen: usize = 0
        while nlen < 8 && unsafe { *(pe_bytes + sh_off + nlen) } != 0u8 {
            nlen = nlen + 1
        }
        let sec_name = StrView { ptr: unsafe { pe_bytes + sh_off }, len: nlen }
        if ux2_sv_eq(sec_name, ux2_sv(".axmeta")) || ux2_sv_eq(sec_name, ux2_sv(".axmi")) {
            rep.leaked_axmeta_count = rep.leaked_axmeta_count + 1u32
        } else if ux2_sv_eq(sec_name, ux2_sv(".axlto")) {
            rep.leaked_axlto_count = rep.leaked_axlto_count + 1u32
        } else if ux2_sv_eq(sec_name, ux2_sv(".axmir")) {
            rep.leaked_axmir_count = rep.leaked_axmir_count + 1u32
        } else if ux2_sv_eq(sec_name, ux2_sv(".axdb")) {
            rep.leaked_axdb_count = rep.leaked_axdb_count + 1u32
        } else if ux2_sv_eq(sec_name, ux2_sv(".axdbg")) {
            rep.leaked_axdbg_count = rep.leaked_axdbg_count + 1u32
        } else {
            rep.runtime_section_count = rep.runtime_section_count + 1u32
        }
        i = i + 1
    }

    let full_sv = StrView { ptr: pe_bytes, len: total_len }
    if ux2_sv_contains(full_sv, ux2_sv("AXMETA01")) ||
        ux2_sv_contains(full_sv, ux2_sv("AXMI0001")) ||
        ux2_sv_contains(full_sv, ux2_sv("AXLTO001")) ||
        ux2_sv_contains(full_sv, ux2_sv("AXMIR001")) ||
        ux2_sv_contains(full_sv, ux2_sv("AXDB0001")) {
        rep.has_leaked_magic = true
    }

    let total_leaked = rep.leaked_axmeta_count + rep.leaked_axlto_count + rep.leaked_axmir_count + rep.leaked_axdb_count + rep.leaked_axdbg_count
    rep.requires_runtime_axmeta = total_leaked > 0u32 || rep.has_leaked_magic
    rep.is_production_clean = rep.is_valid_pe && total_leaked == 0u32 && !rep.has_leaked_magic
    rep
}

pub fn ai_render_binary_separation_json(rep: view<BinarySeparationReport>, out: mut_view<DiagBuffer>) {
    diag_buf_push_sv(mut_view(*out), ux2_sv("{\"protocol\":\"AXCP\",\"schema_version\":1,\"codegen_invoked\":false,\"valid_pe\":"))
    ai_push_bool(mut_view(*out), rep.is_valid_pe)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"production_clean\":"))
    ai_push_bool(mut_view(*out), rep.is_production_clean)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"runtime_sections\":"))
    diag_buf_push_u32(mut_view(*out), rep.runtime_section_count)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"leaked_axmeta\":"))
    diag_buf_push_u32(mut_view(*out), rep.leaked_axmeta_count)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"leaked_axdb\":"))
    diag_buf_push_u32(mut_view(*out), rep.leaked_axdb_count)
    diag_buf_push_sv(mut_view(*out), ux2_sv(",\"requires_runtime_axmeta\":"))
    ai_push_bool(mut_view(*out), rep.requires_runtime_axmeta)
    diag_buf_push_sv(mut_view(*out), ux2_sv("}\n"))
}
