// Session-level Type Checker & THIR Lowering integration (T081d / T081c):
// wires `compiler.parser.session`, `compiler.resolve_hir.session`, and `compiler.types.typeck`
// over `CompilerSession` so virtual or on-disk files can be parsed (with optional std prelude),
// resolved, lowered to HIR, typechecked into THIR (including unsafe checking), and rendered in
// canonical `inspect --emit=thir` S-expression format as well as human/JSON diagnostics.
module compiler.typeck.session

use compiler.kernel.arena.Arena
use compiler.kernel.id.FileId
use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_new
use compiler.diag.format.ax_diag_render_human
use compiler.diag.json.ax_diag_render_json
use compiler.kernel_source_diag.session.CompilerSession
use compiler.kernel_source_diag.session.session_error_count
use compiler.parser.session.session_parse_virtual_file
use compiler.resolve.symtab.ResolveMap
use compiler.resolve.symtab.resolve_map_free
use compiler.hir.hir.HirFile
use compiler.resolve_hir.session.session_append_std_prelude
use compiler.resolve_hir.session.session_resolve_ast_into
use compiler.resolve_hir.session.session_lower_hir
use compiler.types.types.Thir
use compiler.types.typeck.typeck
use compiler.types.typeck.emit_thir

pub fn session_typeck_into(
    sess: mut_view<CompilerSession>,
    hir: view<HirFile>,
    out_thir: mut_view<Thir>
) {
    typeck(
        hir,
        mut_view(sess.diag_sink),
        mut_view(sess.interner),
        view(sess.source_db),
        mut_view(*out_thir)
    );
}

pub fn session_render_thir(
    sess: view<CompilerSession>,
    hir: view<HirFile>,
    thir: view<Thir>,
    filter_file: FileId
) -> DiagBuffer {
    let mut buf = diag_buf_new();
    emit_thir(mut_view(buf), hir, thir, view(sess.interner), (FileId { v: filter_file.v }));
    DiagBuffer { ptr: buf.ptr, len: buf.len, cap: buf.cap }
}

pub fn session_render_thir_into(
    sess: view<CompilerSession>,
    hir: view<HirFile>,
    thir: view<Thir>,
    filter_file: FileId,
    out: mut_view<DiagBuffer>
) {
    emit_thir(out, hir, thir, view(sess.interner), (FileId { v: filter_file.v }));
}

pub fn session_typeck_and_render_human(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir: mut_view<Thir>,
    path: StrView,
    text: StrView,
    load_prelude: bool,
    out_thir_buf: mut_view<DiagBuffer>,
    out_diags: mut_view<DiagBuffer>
) -> usize {
    let mut fid = (FileId { v: 0u32 });
    let text_copy = (StrView { ptr: text.ptr, len: text.len });
    let mut parse_res = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        path,
        text,
        mut_view(fid)
    );
    if load_prelude {
        session_append_std_prelude(mut_view(*sess), mut_view(*parse_arena), mut_view(parse_res.ast), text_copy);
    }
    session_resolve_ast_into(mut_view(*sess), resolve_arena, view(parse_res.ast), mut_view(*rmap));
    let hir = session_lower_hir(mut_view(*sess), hir_arena, view(parse_res.ast), view(*rmap));
    if session_error_count(view(*sess)) == 0 {
        session_typeck_into(mut_view(*sess), view(hir), mut_view(*thir));
        if session_error_count(view(*sess)) == 0 {
            emit_thir(out_thir_buf, view(hir), view(*thir), view(sess.interner), (FileId { v: fid.v }));
        }
    }
    ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), out_diags);
    resolve_map_free(mut_view(*rmap));
    session_error_count(view(*sess))
}

pub fn session_typeck_and_render_json(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir: mut_view<Thir>,
    path: StrView,
    text: StrView,
    load_prelude: bool,
    out_thir_buf: mut_view<DiagBuffer>,
    out_json: mut_view<DiagBuffer>
) -> usize {
    let mut fid = (FileId { v: 0u32 });
    let text_copy = (StrView { ptr: text.ptr, len: text.len });
    let mut parse_res = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        path,
        text,
        mut_view(fid)
    );
    if load_prelude {
        session_append_std_prelude(mut_view(*sess), mut_view(*parse_arena), mut_view(parse_res.ast), text_copy);
    }
    session_resolve_ast_into(mut_view(*sess), resolve_arena, view(parse_res.ast), mut_view(*rmap));
    let hir = session_lower_hir(mut_view(*sess), hir_arena, view(parse_res.ast), view(*rmap));
    if session_error_count(view(*sess)) == 0 {
        session_typeck_into(mut_view(*sess), view(hir), mut_view(*thir));
        if session_error_count(view(*sess)) == 0 {
            emit_thir(out_thir_buf, view(hir), view(*thir), view(sess.interner), (FileId { v: fid.v }));
        }
    }
    ax_diag_render_json(view(sess.diag_sink), view(sess.source_db), out_json);
    resolve_map_free(mut_view(*rmap));
    session_error_count(view(*sess))
}
