@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// AXS-FMT-014: Hard-coded canonical formatter parameters.
pub const FMT_MAX_WIDTH: i32 = 100;
pub const FMT_INDENT_STEP: i32 = 4;

// AXS-FMT-011: Wadler-Lindig Doc algebra node kinds.
pub const DOC_NIL: u8 = 0u8;
pub const DOC_TEXT: u8 = 1u8;
pub const DOC_HARDLINE: u8 = 2u8;
pub const DOC_BLANKLINE: u8 = 3u8;
pub const DOC_LINE: u8 = 4u8;
pub const DOC_SOFTLINE: u8 = 5u8;
pub const DOC_SOFTLINE_EMPTY: u8 = 6u8;
pub const DOC_INDENT: u8 = 7u8;
pub const DOC_GROUP: u8 = 8u8;
pub const DOC_IF_BREAK: u8 = 9u8;
pub const DOC_LINE_SUFFIX: u8 = 10u8;
pub const DOC_CONCAT: u8 = 11u8;

pub const MODE_FLAT: u8 = 0u8;
pub const MODE_BREAK: u8 = 1u8;

pub struct DocNode {
    pub kind: u8,
    pub force_break: bool,
    pub indent_delta: i32,
    pub text_ptr: *const u8,
    pub text_len: usize,
    pub scalar_width: i32,
    pub left: u32,
    pub right: u32,
}

pub struct LayoutCmd {
    pub indent: i32,
    pub mode: u8,
    pub doc_id: u32,
}

pub struct DocEngine {
    pub arena: *mut Arena,
    pub nodes: *mut DocNode,
    pub count: usize,
    pub cap: usize,
}

pub fn doc_node_ptr(base: *mut DocNode, idx: usize) -> *mut DocNode {
    unsafe { base + idx }
}

pub fn layout_cmd_ptr(base: *mut LayoutCmd, idx: usize) -> *mut LayoutCmd {
    unsafe { base + idx }
}

pub fn doc_engine_init(eng: mut_view<DocEngine>, arena: mut_view<Arena>, initial_cap: usize) {
    let cap = if initial_cap < 256 { 256 } else { initial_cap };
    let nodes = arena_alloc_raw(mut_view(*arena), cap * size_of<DocNode>(), align_of<DocNode>()) as *mut DocNode;
    eng.arena = unsafe { address_of_mut<Arena>(*arena) };
    eng.nodes = nodes;
    eng.count = 1; // index 0 is DOC_NIL
    eng.cap = cap;
    let n0 = doc_node_ptr(nodes, 0);
    unsafe {
        (*n0).kind = DOC_NIL;
        (*n0).force_break = false;
        (*n0).indent_delta = 0;
        (*n0).text_ptr = 0 as *const u8;
        (*n0).text_len = 0;
        (*n0).scalar_width = 0;
        (*n0).left = 0u32;
        (*n0).right = 0u32;
    }
}

fn doc_alloc_node(eng: mut_view<DocEngine>, kind: u8) -> u32 {
    if eng.count >= eng.cap {
        let new_cap = eng.cap * 2;
        let new_nodes = arena_alloc_raw(unsafe { mut_view(*eng.arena) }, new_cap * size_of<DocNode>(), align_of<DocNode>()) as *mut DocNode;
        let mut i: usize = 0;
        while i < eng.count {
            let dst_n = doc_node_ptr(new_nodes, i);
            let src_n = doc_node_ptr(eng.nodes, i);
            unsafe {
                (*dst_n).kind = (*src_n).kind;
                (*dst_n).force_break = (*src_n).force_break;
                (*dst_n).indent_delta = (*src_n).indent_delta;
                (*dst_n).text_ptr = (*src_n).text_ptr;
                (*dst_n).text_len = (*src_n).text_len;
                (*dst_n).scalar_width = (*src_n).scalar_width;
                (*dst_n).left = (*src_n).left;
                (*dst_n).right = (*src_n).right;
            }
            i = i + 1;
        }
        eng.nodes = new_nodes;
        eng.cap = new_cap;
    }
    let idx = eng.count;
    eng.count = idx + 1;
    let nd = doc_node_ptr(eng.nodes, idx);
    unsafe {
        (*nd).kind = kind;
        (*nd).force_break = false;
        (*nd).indent_delta = 0;
        (*nd).text_ptr = 0 as *const u8;
        (*nd).text_len = 0;
        (*nd).scalar_width = 0;
        (*nd).left = 0u32;
        (*nd).right = 0u32;
    }
    idx as u32
}

pub fn doc_nil(eng: mut_view<DocEngine>) -> u32 {
    0u32
}

pub fn doc_text(eng: mut_view<DocEngine>, ptr: *const u8, byte_len: usize) -> u32 {
    if byte_len == 0 || (ptr as usize) == 0 {
        return 0u32;
    }
    let id = doc_alloc_node(mut_view(*eng), DOC_TEXT);
    let mut has_nl = false;
    let mut i: usize = 0;
    while i < byte_len {
        if unsafe { *(ptr + i) } == 10u8 {
            has_nl = true;
            break;
        }
        i = i + 1;
    }
    let nd = doc_node_ptr(eng.nodes, id as usize);
    unsafe {
        (*nd).text_ptr = ptr;
        (*nd).text_len = byte_len;
        (*nd).scalar_width = cst_utf8_scalar_len(ptr, byte_len) as i32;
        (*nd).force_break = has_nl;
    }
    id
}

pub fn doc_text_sv(eng: mut_view<DocEngine>, sv: StrView) -> u32 {
    doc_text(mut_view(*eng), sv.ptr, sv.len)
}

pub fn doc_hardline(eng: mut_view<DocEngine>) -> u32 {
    let id = doc_alloc_node(mut_view(*eng), DOC_HARDLINE);
    let nd = doc_node_ptr(eng.nodes, id as usize);
    unsafe { (*nd).force_break = true; }
    id
}

pub fn doc_blankline(eng: mut_view<DocEngine>) -> u32 {
    let id = doc_alloc_node(mut_view(*eng), DOC_BLANKLINE);
    let nd = doc_node_ptr(eng.nodes, id as usize);
    unsafe { (*nd).force_break = true; }
    id
}

pub fn doc_line(eng: mut_view<DocEngine>) -> u32 {
    doc_alloc_node(mut_view(*eng), DOC_LINE)
}

pub fn doc_softline(eng: mut_view<DocEngine>) -> u32 {
    doc_alloc_node(mut_view(*eng), DOC_SOFTLINE)
}

pub fn doc_softline_empty(eng: mut_view<DocEngine>) -> u32 {
    doc_alloc_node(mut_view(*eng), DOC_SOFTLINE_EMPTY)
}

pub fn doc_indent(eng: mut_view<DocEngine>, delta: i32, child: u32) -> u32 {
    if child == 0u32 {
        return 0u32;
    }
    let id: u32 = doc_alloc_node(mut_view(*eng), DOC_INDENT);
    let child_fb: bool = unsafe { (*(doc_node_ptr(eng.nodes, child as usize))).force_break };
    let nd: *mut DocNode = doc_node_ptr(eng.nodes, id as usize);
    unsafe {
        (*nd).indent_delta = delta;
        (*nd).left = child;
        (*nd).force_break = child_fb;
    }
    id
}

pub fn doc_group(eng: mut_view<DocEngine>, child: u32) -> u32 {
    if child == 0u32 {
        return 0u32;
    }
    let id: u32 = doc_alloc_node(mut_view(*eng), DOC_GROUP);
    let child_fb: bool = unsafe { (*(doc_node_ptr(eng.nodes, child as usize))).force_break };
    let nd: *mut DocNode = doc_node_ptr(eng.nodes, id as usize);
    unsafe {
        (*nd).left = child;
        (*nd).force_break = child_fb;
    }
    id
}

pub fn doc_if_break(eng: mut_view<DocEngine>, break_doc: u32, flat_doc: u32) -> u32 {
    let id: u32 = doc_alloc_node(mut_view(*eng), DOC_IF_BREAK);
    let flt_fb: bool = unsafe { (*(doc_node_ptr(eng.nodes, flat_doc as usize))).force_break };
    let nd: *mut DocNode = doc_node_ptr(eng.nodes, id as usize);
    unsafe {
        (*nd).left = break_doc;
        (*nd).right = flat_doc;
        (*nd).force_break = flt_fb;
    }
    id
}

pub fn doc_line_suffix(eng: mut_view<DocEngine>, child: u32) -> u32 {
    if child == 0u32 {
        return 0u32;
    }
    let id: u32 = doc_alloc_node(mut_view(*eng), DOC_LINE_SUFFIX);
    let nd: *mut DocNode = doc_node_ptr(eng.nodes, id as usize);
    unsafe { (*nd).left = child; }
    id
}

pub fn doc_concat(eng: mut_view<DocEngine>, a: u32, b: u32) -> u32 {
    if a == 0u32 {
        return b;
    }
    if b == 0u32 {
        return a;
    }
    let id: u32 = doc_alloc_node(mut_view(*eng), DOC_CONCAT);
    let fb_a: bool = unsafe { (*(doc_node_ptr(eng.nodes, a as usize))).force_break };
    let fb_b: bool = unsafe { (*(doc_node_ptr(eng.nodes, b as usize))).force_break };
    let nd: *mut DocNode = doc_node_ptr(eng.nodes, id as usize);
    unsafe {
        (*nd).left = a;
        (*nd).right = b;
        (*nd).force_break = fb_a || fb_b;
    }
    id
}

// AXS-FMT-012: Bounded O(W) lookahead `fits(remaining_width, stack)` predicate.
pub fn doc_fits(
    eng: view<DocEngine>,
    rem_width: i32,
    base_stack: *const LayoutCmd,
    base_sp: usize,
    top_cmd: LayoutCmd,
    scratch: *mut LayoutCmd,
    scratch_cap: usize
) -> bool {
    let mut w: i32 = rem_width;
    let nd_top: *mut DocNode = doc_node_ptr(eng.nodes, top_cmd.doc_id as usize);
    if unsafe { (*nd_top).force_break } {
        return false;
    }
    let mut sp: usize = 1;
    unsafe { *(layout_cmd_ptr(scratch, 0)) = top_cmd; }
    let mut b_idx: usize = base_sp;

    while w >= 0 {
        let mut cmd: LayoutCmd = LayoutCmd { indent: 0, mode: MODE_FLAT, doc_id: 0u32 };
        if sp > 0 {
            sp = sp - 1;
            cmd = unsafe { *(layout_cmd_ptr(scratch, sp)) };
        } else if b_idx > 0 {
            b_idx = b_idx - 1;
            cmd = unsafe { *((base_stack as *mut LayoutCmd) + b_idx) };
        } else {
            return true;
        }

        if cmd.doc_id == 0u32 {
            continue;
        }
        let nd: *mut DocNode = doc_node_ptr(eng.nodes, cmd.doc_id as usize);
        let k: u8 = unsafe { (*nd).kind };
        if k == DOC_NIL || k == DOC_LINE_SUFFIX {
            continue;
        } else if k == DOC_TEXT {
            if unsafe { (*nd).force_break } {
                return false;
            }
            w = w - unsafe { (*nd).scalar_width };
        } else if k == DOC_HARDLINE || k == DOC_BLANKLINE {
            if cmd.mode == MODE_FLAT {
                return false;
            }
            return true;
        } else if k == DOC_LINE || k == DOC_SOFTLINE {
            if cmd.mode == MODE_FLAT {
                w = w - 1;
            } else {
                return true;
            }
        } else if k == DOC_SOFTLINE_EMPTY {
            if cmd.mode != MODE_FLAT {
                return true;
            }
        } else if k == DOC_INDENT {
            if sp < scratch_cap {
                unsafe {
                    *(layout_cmd_ptr(scratch, sp)) = LayoutCmd {
                        indent: cmd.indent + (*nd).indent_delta,
                        mode: cmd.mode,
                        doc_id: (*nd).left,
                    };
                }
                sp = sp + 1;
            }
        } else if k == DOC_GROUP {
            if unsafe { (*nd).force_break } && cmd.mode == MODE_FLAT {
                return false;
            }
            if sp < scratch_cap {
                unsafe {
                    *(layout_cmd_ptr(scratch, sp)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: MODE_FLAT,
                        doc_id: (*nd).left,
                    };
                }
                sp = sp + 1;
            }
        } else if k == DOC_IF_BREAK {
            let chosen: u32 = if cmd.mode == MODE_BREAK {
                unsafe { (*nd).left }
            } else {
                unsafe { (*nd).right }
            };
            if sp < scratch_cap {
                unsafe {
                    *(layout_cmd_ptr(scratch, sp)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: cmd.mode,
                        doc_id: chosen,
                    };
                }
                sp = sp + 1;
            }
        } else if k == DOC_CONCAT {
            if sp + 2 <= scratch_cap {
                unsafe {
                    *(layout_cmd_ptr(scratch, sp)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: cmd.mode,
                        doc_id: (*nd).right,
                    };
                    *(layout_cmd_ptr(scratch, sp + 1)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: cmd.mode,
                        doc_id: (*nd).left,
                    };
                }
                sp = sp + 2;
            }
        }
    }
    false
}

fn render_strip_trailing_spaces(out: mut_view<DiagBuffer>) {
    while out.len > 0 {
        let last_idx: usize = out.len - 1;
        let last: u8 = unsafe { *(out.ptr + last_idx) };
        if last == 32u8 || last == 9u8 {
            out.len = out.len - 1;
        } else {
            break;
        }
    }
}

fn render_emit_indent(out: mut_view<DiagBuffer>, n: i32) {
    let mut i: i32 = 0;
    while i < n {
        diag_buf_push_byte(mut_view(*out), 32u8);
        i = i + 1;
    }
}

// AXS-FMT-013 / AXS-FMT-014: Deterministic Wadler-Lindig layout renderer.
pub fn doc_render_to_buf(
    eng: view<DocEngine>,
    root_doc: u32,
    max_width: i32,
    out: mut_view<DiagBuffer>
) {
    if root_doc == 0u32 {
        return;
    }
    let stack_cap: usize = eng.count * 2 + 64;
    let stack: *mut LayoutCmd = arena_alloc_raw(unsafe { mut_view(*eng.arena) }, stack_cap * size_of<LayoutCmd>(), align_of<LayoutCmd>()) as *mut LayoutCmd;
    let scratch: *mut LayoutCmd = arena_alloc_raw(unsafe { mut_view(*eng.arena) }, stack_cap * size_of<LayoutCmd>(), align_of<LayoutCmd>()) as *mut LayoutCmd;
    let suffixes: *mut LayoutCmd = arena_alloc_raw(unsafe { mut_view(*eng.arena) }, 256 * size_of<LayoutCmd>(), align_of<LayoutCmd>()) as *mut LayoutCmd;

    let mut sp: usize = 1;
    unsafe {
        *(layout_cmd_ptr(stack, 0)) = LayoutCmd {
            indent: 0,
            mode: MODE_BREAK,
            doc_id: root_doc,
        };
    }

    let mut col: i32 = 0;
    let mut at_line_start: bool = true;
    let mut pending_indent: i32 = 0;
    let mut suffix_cnt: usize = 0;
    let mut flushing_suffixes: bool = false;

    while sp > 0 {
        sp = sp - 1;
        let cmd: LayoutCmd = unsafe { *(layout_cmd_ptr(stack, sp)) };
        if cmd.doc_id == 0u32 {
            continue;
        }
        let nd: *mut DocNode = doc_node_ptr(eng.nodes, cmd.doc_id as usize);
        let k: u8 = unsafe { (*nd).kind };

        if k == DOC_NIL {
            continue;
        } else if k == DOC_TEXT {
            let t_ptr: *const u8 = unsafe { (*nd).text_ptr };
            let t_len: usize = unsafe { (*nd).text_len };
            if t_len > 0 {
                if at_line_start {
                    render_emit_indent(mut_view(*out), pending_indent);
                    col = pending_indent;
                    at_line_start = false;
                }
                diag_buf_push_bytes(mut_view(*out), t_ptr, t_len);
                col = col + unsafe { (*nd).scalar_width };
            }
        } else if k == DOC_LINE_SUFFIX {
            if flushing_suffixes {
                if sp < stack_cap {
                    unsafe {
                        *(layout_cmd_ptr(stack, sp)) = LayoutCmd {
                            indent: cmd.indent,
                            mode: cmd.mode,
                            doc_id: (*nd).left,
                        };
                    }
                    sp = sp + 1;
                }
            } else if suffix_cnt < 256 {
                unsafe {
                    *(layout_cmd_ptr(suffixes, suffix_cnt)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: cmd.mode,
                        doc_id: (*nd).left,
                    };
                }
                suffix_cnt = suffix_cnt + 1;
            }
        } else if k == DOC_HARDLINE || k == DOC_BLANKLINE ||
                ((k == DOC_LINE || k == DOC_SOFTLINE || k == DOC_SOFTLINE_EMPTY) && cmd.mode == MODE_BREAK) {
            if suffix_cnt > 0 && !flushing_suffixes {
                // Re-push this line break and push queued LineSuffix items above it in FIFO order.
                flushing_suffixes = true;
                if sp < stack_cap {
                    unsafe { *(layout_cmd_ptr(stack, sp)) = cmd; }
                    sp = sp + 1;
                }
                let mut si: usize = suffix_cnt;
                while si > 0 {
                    si = si - 1;
                    if sp < stack_cap {
                        unsafe { *(layout_cmd_ptr(stack, sp)) = *(layout_cmd_ptr(suffixes, si)); }
                        sp = sp + 1;
                    }
                }
                suffix_cnt = 0;
                continue;
            }
            flushing_suffixes = false;
            render_strip_trailing_spaces(mut_view(*out));
            diag_buf_push_byte(mut_view(*out), 10u8);
            if k == DOC_BLANKLINE {
                diag_buf_push_byte(mut_view(*out), 10u8);
            }
            at_line_start = true;
            pending_indent = cmd.indent;
            col = cmd.indent;
        } else if k == DOC_LINE || k == DOC_SOFTLINE {
            // MODE_FLAT: emit single space.
            if at_line_start {
                render_emit_indent(mut_view(*out), pending_indent);
                col = pending_indent;
                at_line_start = false;
            }
            diag_buf_push_byte(mut_view(*out), 32u8);
            col = col + 1;
        } else if k == DOC_SOFTLINE_EMPTY {
            // MODE_FLAT: emit nothing.
            continue;
        } else if k == DOC_INDENT {
            if sp < stack_cap {
                unsafe {
                    *(layout_cmd_ptr(stack, sp)) = LayoutCmd {
                        indent: cmd.indent + (*nd).indent_delta,
                        mode: cmd.mode,
                        doc_id: (*nd).left,
                    };
                }
                sp = sp + 1;
            }
        } else if k == DOC_GROUP {
            let child_id: u32 = unsafe { (*nd).left };
            let flat_cmd: LayoutCmd = LayoutCmd {
                indent: cmd.indent,
                mode: MODE_FLAT,
                doc_id: child_id,
            };
            let fits_flat: bool = !unsafe { (*nd).force_break } &&
                doc_fits(eng, max_width - col, stack as *const LayoutCmd, sp, flat_cmd, scratch, stack_cap);
            if sp < stack_cap {
                unsafe {
                    *(layout_cmd_ptr(stack, sp)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: if fits_flat { MODE_FLAT } else { MODE_BREAK },
                        doc_id: child_id,
                    };
                }
                sp = sp + 1;
            }
        } else if k == DOC_IF_BREAK {
            let chosen: u32 = if cmd.mode == MODE_BREAK {
                unsafe { (*nd).left }
            } else {
                unsafe { (*nd).right }
            };
            if sp < stack_cap {
                unsafe {
                    *(layout_cmd_ptr(stack, sp)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: cmd.mode,
                        doc_id: chosen,
                    };
                }
                sp = sp + 1;
            }
        } else if k == DOC_CONCAT {
            if sp + 2 <= stack_cap {
                unsafe {
                    *(layout_cmd_ptr(stack, sp)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: cmd.mode,
                        doc_id: (*nd).right,
                    };
                    *(layout_cmd_ptr(stack, sp + 1)) = LayoutCmd {
                        indent: cmd.indent,
                        mode: cmd.mode,
                        doc_id: (*nd).left,
                    };
                }
                sp = sp + 2;
            }
        }
    }

    // Flush any remaining LineSuffix items at end of document.
    if suffix_cnt > 0 {
        let mut si: usize = suffix_cnt;
        while si > 0 {
            si = si - 1;
            unsafe { *(layout_cmd_ptr(stack, sp)) = *(layout_cmd_ptr(suffixes, si)); }
            sp = sp + 1;
        }
        while sp > 0 {
            sp = sp - 1;
            let cmd: LayoutCmd = unsafe { *(layout_cmd_ptr(stack, sp)) };
            if cmd.doc_id == 0u32 {
                continue;
            }
            let nd: *mut DocNode = doc_node_ptr(eng.nodes, cmd.doc_id as usize);
            let k: u8 = unsafe { (*nd).kind };
            if k == DOC_TEXT {
                let t_ptr: *const u8 = unsafe { (*nd).text_ptr };
                let t_len: usize = unsafe { (*nd).text_len };
                if t_len > 0 {
                    if at_line_start {
                        render_emit_indent(mut_view(*out), pending_indent);
                        at_line_start = false;
                    }
                    diag_buf_push_bytes(mut_view(*out), t_ptr, t_len);
                }
            } else if k == DOC_CONCAT {
                unsafe {
                    *(layout_cmd_ptr(stack, sp)) = LayoutCmd { indent: cmd.indent, mode: cmd.mode, doc_id: (*nd).right };
                    *(layout_cmd_ptr(stack, sp + 1)) = LayoutCmd { indent: cmd.indent, mode: cmd.mode, doc_id: (*nd).left };
                }
                sp = sp + 2;
            }
        }
    }
    render_strip_trailing_spaces(mut_view(*out));
}

pub struct FmtCtx {
    pub arena: *mut Arena,
    pub interner: *const StrInterner,
    pub cst: *mut CstFile,
    pub eng: *mut DocEngine,
}

const FMT_ASCII_TABLE: [256]u8 = [
    // 0: "module " (7)
    109u8, 111u8, 100u8, 117u8, 108u8, 101u8, 32u8,
    // 7: "use " (4)
    117u8, 115u8, 101u8, 32u8,
    // 11: "pub " (4)
    112u8, 117u8, 98u8, 32u8,
    // 15: "pub(package) " (13)
    112u8, 117u8, 98u8, 40u8, 112u8, 97u8, 99u8, 107u8, 97u8, 103u8, 101u8, 41u8, 32u8,
    // 28: "pub(module) " (12)
    112u8, 117u8, 98u8, 40u8, 109u8, 111u8, 100u8, 117u8, 108u8, 101u8, 41u8, 32u8,
    // 40: "async " (6)
    97u8, 115u8, 121u8, 110u8, 99u8, 32u8,
    // 46: "comptime " (9)
    99u8, 111u8, 109u8, 112u8, 116u8, 105u8, 109u8, 101u8, 32u8,
    // 55: "unsafe " (7)
    117u8, 110u8, 115u8, 97u8, 102u8, 101u8, 32u8,
    // 62: "extern " (7)
    101u8, 120u8, 116u8, 101u8, 114u8, 110u8, 32u8,
    // 69: "fn " (3)
    102u8, 110u8, 32u8,
    // 72: "struct " (7)
    115u8, 116u8, 114u8, 117u8, 99u8, 116u8, 32u8,
    // 79: "enum " (5)
    101u8, 110u8, 117u8, 109u8, 32u8,
    // 84: "trait " (6)
    116u8, 114u8, 97u8, 105u8, 116u8, 32u8,
    // 90: "auto " (5)
    97u8, 117u8, 116u8, 111u8, 32u8,
    // 95: "impl" (4)
    105u8, 109u8, 112u8, 108u8,
    // 99: " for " (5)
    32u8, 102u8, 111u8, 114u8, 32u8,
    // 104: "type " (5)
    116u8, 121u8, 112u8, 101u8, 32u8,
    // 109: "const " (6)
    99u8, 111u8, 110u8, 115u8, 116u8, 32u8,
    // 115: "static " (7)
    115u8, 116u8, 97u8, 116u8, 105u8, 99u8, 32u8,
    // 122: "mut " (4)
    109u8, 117u8, 116u8, 32u8,
    // 126: "where" (5)
    119u8, 104u8, 101u8, 114u8, 101u8,
    // 131: " -> " (4)
    32u8, 45u8, 62u8, 32u8,
    // 135: " = " (3)
    32u8, 61u8, 32u8,
    // 138: ": " (2)
    58u8, 32u8,
    // 140: ", " (2)
    44u8, 32u8,
    // 142: " + " (3)
    32u8, 43u8, 32u8,
    // 145: " as " (4)
    32u8, 97u8, 115u8, 32u8,
    // 149: "let " (4)
    108u8, 101u8, 116u8, 32u8,
    // 153: " else " (6)
    32u8, 101u8, 108u8, 115u8, 101u8, 32u8,
    // 159: "if " (3)
    105u8, 102u8, 32u8,
    // 162: "match " (6)
    109u8, 97u8, 116u8, 99u8, 104u8, 32u8,
    // 168: "loop " (5)
    108u8, 111u8, 111u8, 112u8, 32u8,
    // 173: "while " (6)
    119u8, 104u8, 105u8, 108u8, 101u8, 32u8,
    // 179: "for " (4)
    102u8, 111u8, 114u8, 32u8,
    // 183: " in " (4)
    32u8, 105u8, 110u8, 32u8,
    // 187: " => " (4)
    32u8, 61u8, 62u8, 32u8,
    // 191: "view" (4)
    118u8, 105u8, 101u8, 119u8,
    // 195: "mut_view" (8)
    109u8, 117u8, 116u8, 95u8, 118u8, 105u8, 101u8, 119u8,
    // 203: "*mut " (5)
    42u8, 109u8, 117u8, 116u8, 32u8,
    // 208: "*const " (7)
    42u8, 99u8, 111u8, 110u8, 115u8, 116u8, 32u8,
    // 215: "dyn " (4)
    100u8, 121u8, 110u8, 32u8,
    // 219: "return" (6)
    114u8, 101u8, 116u8, 117u8, 114u8, 110u8,
    // 225: "break" (5)
    98u8, 114u8, 101u8, 97u8, 107u8,
    // 230: "continue" (8)
    99u8, 111u8, 110u8, 116u8, 105u8, 110u8, 117u8, 101u8,
    // 238: "true" (4)
    116u8, 114u8, 117u8, 101u8,
    // 242: "false" (5)
    102u8, 97u8, 108u8, 115u8, 101u8,
    // 247: ".await" (6)
    46u8, 97u8, 119u8, 97u8, 105u8, 116u8,
    // 253: "{}" (2) + pad (1)
    123u8, 125u8, 0u8
];

fn fmt_tbl(ctx: view<FmtCtx>, off: usize, byte_len: usize) -> u32 {
    let p = arena_alloc_raw(unsafe { mut_view(*ctx.arena) }, byte_len, 1);
    let mut i: usize = 0;
    while i < byte_len {
        unsafe { *(p + i) = FMT_ASCII_TABLE[off + i]; }
        i = i + 1;
    }
    doc_text(unsafe { mut_view(*ctx.eng) }, p as *const u8, byte_len)
}

fn fmt_byte(ctx: view<FmtCtx>, b: u8) -> u32 {
    let p = arena_alloc_raw(unsafe { mut_view(*ctx.arena) }, 1, 1);
    unsafe { *p = b; }
    doc_text(unsafe { mut_view(*ctx.eng) }, p as *const u8, 1)
}

fn fmt_byte2(ctx: view<FmtCtx>, b0: u8, b1: u8) -> u32 {
    let p = arena_alloc_raw(unsafe { mut_view(*ctx.arena) }, 2, 1);
    unsafe {
        *(p + 0) = b0;
        *(p + 1) = b1;
    }
    doc_text(unsafe { mut_view(*ctx.eng) }, p as *const u8, 2)
}

fn fmt_byte3(ctx: view<FmtCtx>, b0: u8, b1: u8, b2: u8) -> u32 {
    let p = arena_alloc_raw(unsafe { mut_view(*ctx.arena) }, 3, 1);
    unsafe {
        *(p + 0) = b0;
        *(p + 1) = b1;
        *(p + 2) = b2;
    }
    doc_text(unsafe { mut_view(*ctx.eng) }, p as *const u8, 3)
}

fn fmt_strid(ctx: view<FmtCtx>, id: StrId) -> u32 {
    if id.v == 0u32 {
        return 0u32;
    }
    let sv = interner_get(unsafe { view(*ctx.interner) }, id);
    doc_text_sv(unsafe { mut_view(*ctx.eng) }, sv)
}

fn fmt_u32(ctx: view<FmtCtx>, val: u32) -> u32 {
    let mut tmp: [16]u8 = [0u8; 16];
    if val == 0u32 {
        return fmt_byte(ctx, 48u8);
    }
    let mut v = val;
    let mut dlen: usize = 0;
    while v > 0u32 {
        tmp[dlen] = 48u8 + ((v % 10u32) as u8);
        v = v / 10u32;
        dlen = dlen + 1;
    }
    let p = arena_alloc_raw(unsafe { mut_view(*ctx.arena) }, dlen, 1);
    let mut i: usize = 0;
    while i < dlen {
        unsafe { *(p + i) = tmp[dlen - 1 - i]; }
        i = i + 1;
    }
    doc_text(unsafe { mut_view(*ctx.eng) }, p as *const u8, dlen)
}

fn fmt_cat(ctx: view<FmtCtx>, a: u32, b: u32) -> u32 {
    doc_concat(unsafe { mut_view(*ctx.eng) }, a, b)
}

fn fmt_cat3(ctx: view<FmtCtx>, a: u32, b: u32, c: u32) -> u32 {
    let ab = doc_concat(unsafe { mut_view(*ctx.eng) }, a, b);
    doc_concat(unsafe { mut_view(*ctx.eng) }, ab, c)
}

fn fmt_cat4(ctx: view<FmtCtx>, a: u32, b: u32, c: u32, d: u32) -> u32 {
    let abc = fmt_cat3(ctx, a, b, c);
    doc_concat(unsafe { mut_view(*ctx.eng) }, abc, d)
}

fn fmt_cat5(ctx: view<FmtCtx>, a: u32, b: u32, c: u32, d: u32, e: u32) -> u32 {
    let abcd = fmt_cat4(ctx, a, b, c, d);
    doc_concat(unsafe { mut_view(*ctx.eng) }, abcd, e)
}

fn fmt_hl(ctx: view<FmtCtx>) -> u32 {
    doc_hardline(unsafe { mut_view(*ctx.eng) })
}

fn fmt_bl(ctx: view<FmtCtx>) -> u32 {
    doc_blankline(unsafe { mut_view(*ctx.eng) })
}

fn fmt_ln(ctx: view<FmtCtx>) -> u32 {
    doc_line(unsafe { mut_view(*ctx.eng) })
}

fn fmt_sln(ctx: view<FmtCtx>) -> u32 {
    doc_softline(unsafe { mut_view(*ctx.eng) })
}

fn fmt_slne(ctx: view<FmtCtx>) -> u32 {
    doc_softline_empty(unsafe { mut_view(*ctx.eng) })
}

fn fmt_ind(ctx: view<FmtCtx>, child: u32) -> u32 {
    doc_indent(unsafe { mut_view(*ctx.eng) }, FMT_INDENT_STEP, child)
}

fn fmt_grp(ctx: view<FmtCtx>, child: u32) -> u32 {
    doc_group(unsafe { mut_view(*ctx.eng) }, child)
}

fn fmt_if_brk(ctx: view<FmtCtx>, brk: u32, flt: u32) -> u32 {
    doc_if_break(unsafe { mut_view(*ctx.eng) }, brk, flt)
}

// Emits Slot 1 (`SLOT_HEADER`) file-level header trivia.
fn fmt_emit_header_trivia(ctx: view<FmtCtx>) -> u32 {
    let cf: *mut CstFile = ctx.cst;
    let t_cnt: usize = unsafe { (*cf).trivia_count };
    let t_arr: *mut CstTrivia = unsafe { (*cf).trivia };
    let mut doc: u32 = 0u32;
    let mut emitted_any: bool = false;
    let mut i: usize = 0;
    while i < t_cnt {
        let tr: *mut CstTrivia = cst_trivia_ptr(t_arr, i);
        if !unsafe { (*tr).emitted } && unsafe { (*tr).slot } == SLOT_HEADER {
            let t_doc: u32 = doc_text(unsafe { mut_view(*ctx.eng) }, unsafe { (*tr).norm_ptr }, unsafe { (*tr).norm_len });
            if emitted_any {
                let sep: u32 = if unsafe { (*tr).has_blank_before } { fmt_bl(view(*ctx)) } else { fmt_hl(view(*ctx)) };
                doc = fmt_cat3(view(*ctx), doc, sep, t_doc);
            } else {
                doc = t_doc;
                emitted_any = true;
            }
            cst_mark_emitted(unsafe { mut_view(*cf) }, i);
        }
        i = i + 1;
    }
    doc
}

// Emits leading trivia (`SLOT_LEADING`, `SLOT_INLINE`) anchored in `[start_byte, end_byte]`.
// When `include_outer_doc == false`, skips `TRIVIA_OUTER_DOC` so `///` can be emitted right before `@attr`s.
fn fmt_emit_leading_in_range(
    ctx: view<FmtCtx>,
    start_byte: u32,
    end_byte: u32,
    include_non_doc: bool,
    include_outer_doc: bool
) -> u32 {
    let cf: *mut CstFile = ctx.cst;
    let t_cnt: usize = unsafe { (*cf).trivia_count };
    let t_arr: *mut CstTrivia = unsafe { (*cf).trivia };
    let mut doc: u32 = 0u32;
    let mut i: usize = 0;
    while i < t_cnt {
        let tr: *mut CstTrivia = cst_trivia_ptr(t_arr, i);
        if !unsafe { (*tr).emitted } {
            let sl: u8 = unsafe { (*tr).slot };
            let ab: u32 = unsafe { (*tr).anchor_byte };
            let rs: u32 = unsafe { (*tr).raw_span.start };
            let tk: u8 = unsafe { (*tr).kind };
            let in_range: bool = (ab >= start_byte && ab <= end_byte) || (rs >= start_byte && rs <= end_byte);
            if in_range && (sl == SLOT_LEADING || sl == SLOT_INLINE) {
                let is_odoc: bool = tk == TRIVIA_OUTER_DOC;
                if (is_odoc && include_outer_doc) || (!is_odoc && include_non_doc) {
                    let t_doc: u32 = doc_text(unsafe { mut_view(*ctx.eng) }, unsafe { (*tr).norm_ptr }, unsafe { (*tr).norm_len });
                    if sl == SLOT_INLINE {
                        let sp: u32 = fmt_byte(view(*ctx), 32u8);
                        doc = fmt_cat3(view(*ctx), doc, t_doc, sp);
                    } else {
                        let sep: u32 = if unsafe { (*tr).has_blank_after } && !is_odoc {
                            fmt_bl(view(*ctx))
                        } else {
                            fmt_hl(view(*ctx))
                        };
                        doc = fmt_cat3(view(*ctx), doc, t_doc, sep);
                    }
                    cst_mark_emitted(unsafe { mut_view(*cf) }, i);
                }
            }
        }
        i = i + 1;
    }
    doc
}

// Emits `SLOT_TRAILING` same-line comment for `[start_byte, end_byte]` wrapped in `LineSuffix`.
fn fmt_emit_trailing_for_range(ctx: view<FmtCtx>, start_byte: u32, end_byte: u32) -> u32 {
    let idx: i32 = cst_find_trailing_in_range(unsafe { view(*ctx.cst) }, start_byte, end_byte);
    if idx < 0 {
        return 0u32;
    }
    let u_idx: usize = idx as usize;
    let tr: *mut CstTrivia = cst_trivia_ptr(unsafe { (*ctx.cst).trivia }, u_idx);
    cst_mark_emitted(unsafe { mut_view(*ctx.cst) }, u_idx);
    let sp: u32 = fmt_byte(view(*ctx), 32u8);
    let t_doc: u32 = doc_text(unsafe { mut_view(*ctx.eng) }, unsafe { (*tr).norm_ptr }, unsafe { (*tr).norm_len });
    let combined: u32 = fmt_cat(view(*ctx), sp, t_doc);
    doc_line_suffix(unsafe { mut_view(*ctx.eng) }, combined)
}

// Emits `SLOT_DANGLING` (and any remaining unemitted comments) inside a container `[open_byte, close_byte]`.
fn fmt_emit_dangling_in_range(ctx: view<FmtCtx>, open_byte: u32, close_byte: u32) -> u32 {
    let cf: *mut CstFile = ctx.cst;
    let t_cnt: usize = unsafe { (*cf).trivia_count };
    let t_arr: *mut CstTrivia = unsafe { (*cf).trivia };
    let mut doc: u32 = 0u32;
    let mut any: bool = false;
    let mut i: usize = 0;
    while i < t_cnt {
        let tr: *mut CstTrivia = cst_trivia_ptr(t_arr, i);
        if !unsafe { (*tr).emitted } {
            let rs: u32 = unsafe { (*tr).raw_span.start };
            let ab: u32 = unsafe { (*tr).anchor_byte };
            let sl: u8 = unsafe { (*tr).slot };
            let match_dangling: bool = sl == SLOT_DANGLING && ab >= open_byte && ab <= close_byte;
            let match_inside: bool = rs >= open_byte && rs < close_byte;
            if match_dangling || match_inside {
                let t_doc: u32 = doc_text(unsafe { mut_view(*ctx.eng) }, unsafe { (*tr).norm_ptr }, unsafe { (*tr).norm_len });
                if any {
                    let sep: u32 = if unsafe { (*tr).has_blank_before } { fmt_bl(view(*ctx)) } else { fmt_hl(view(*ctx)) };
                    doc = fmt_cat3(view(*ctx), doc, sep, t_doc);
                } else {
                    doc = t_doc;
                    any = true;
                }
                cst_mark_emitted(unsafe { mut_view(*cf) }, i);
            }
        }
        i = i + 1;
    }
    doc
}

// AXS-FMT-029: Preserves exact literal spelling from source span, normalizing `0X`/`0B`/`0O` prefix to lowercase.
fn fmt_print_literal_tok(ctx: view<FmtCtx>, tok: view<Token>) -> u32 {
    if tok.kind == TOK_KW_TRUE {
        return fmt_tbl(view(*ctx), 238, 4);
    }
    if tok.kind == TOK_KW_FALSE {
        return fmt_tbl(view(*ctx), 242, 5);
    }
    let src: StrView = unsafe { (*ctx.cst).src };
    let s: usize = tok.span.start as usize;
    let e: usize = tok.span.end as usize;
    if (src.ptr as usize) != 0 && e > s && e <= src.len {
        let tlen: usize = e - s;
        let ptr: *const u8 = unsafe { src.ptr + s };
        if (tok.kind == TOK_INT || tok.kind == TOK_FLOAT) && tlen >= 2 {
            let b0: u8 = unsafe { *(ptr + 0) };
            let b1: u8 = unsafe { *(ptr + 1) };
            if b0 == 48u8 && (b1 == 88u8 || b1 == 66u8 || b1 == 79u8) {
                let copy: *mut u8 = arena_alloc_raw(unsafe { mut_view(*ctx.arena) }, tlen, 1);
                let mut i: usize = 0;
                while i < tlen {
                    unsafe { *(copy + i) = *(ptr + i); }
                    i = i + 1;
                }
                unsafe { *(copy + 1) = b1 + 32u8; }
                return doc_text(unsafe { mut_view(*ctx.eng) }, copy as *const u8, tlen);
            }
        }
        return doc_text(unsafe { mut_view(*ctx.eng) }, ptr, tlen);
    }
    if tok.kind == TOK_INT {
        return fmt_u32(view(*ctx), tok.int_val as u32);
    }
    if (tok.str_ptr as usize) != 0 && tok.str_len > 0 {
        return doc_text(unsafe { mut_view(*ctx.eng) }, tok.str_ptr, tok.str_len);
    }
    0u32
}

fn fmt_print_dotted_name(ctx: view<FmtCtx>, dn: view<AstDottedName>) -> u32 {
    let mut doc: u32 = 0u32;
    let mut i: usize = 0;
    while i < dn.count {
        let sid: StrId = unsafe { *(cst_strid_ptr(dn.segments, i)) };
        let seg_doc: u32 = fmt_strid(view(*ctx), sid);
        if i == 0 {
            doc = seg_doc;
        } else {
            let dot: u32 = fmt_byte(view(*ctx), 46u8);
            doc = fmt_cat3(view(*ctx), doc, dot, seg_doc);
        }
        i = i + 1;
    }
    doc
}

pub fn fmt_print_type(ctx: view<FmtCtx>, ty: *const AstType) -> u32 {
    if (ty as usize) == 0 {
        return 0u32;
    }
    let lead: u32 = fmt_emit_leading_in_range(
        view(*ctx),
        unsafe { (*ty).span.start },
        unsafe { (*ty).span.start },
        true,
        false
    );
    let k: u8 = unsafe { (*ty).kind & 127u8 };
    let mut core: u32 = 0u32;

    if k == TYPE_PATH {
        core = fmt_print_path_segments(view(*ctx), unsafe { (*ty).segments as *const AstTypePathSegment });
    } else if k == TYPE_TUPLE {
        let mut elems: *const AstType = unsafe { (*ty).elem_types as *const AstType };
        let lp: u32 = fmt_byte(view(*ctx), 40u8);
        let rp: u32 = fmt_byte(view(*ctx), 41u8);
        if (elems as usize) == 0 {
            core = fmt_cat(view(*ctx), lp, rp);
        } else {
            let mut list_doc: u32 = 0u32;
            let mut cnt: usize = 0;
            while (elems as usize) != 0 {
                let ed: u32 = fmt_print_type(view(*ctx), elems);
                if cnt == 0 {
                    list_doc = ed;
                } else {
                    let comma_sp: u32 = fmt_tbl(view(*ctx), 140, 2);
                    list_doc = fmt_cat3(view(*ctx), list_doc, comma_sp, ed);
                }
                cnt = cnt + 1;
                elems = unsafe { (*elems).next as *const AstType };
            }
            if cnt == 1 {
                let comma: u32 = fmt_byte(view(*ctx), 44u8);
                core = fmt_cat4(view(*ctx), lp, list_doc, comma, rp);
            } else {
                core = fmt_cat3(view(*ctx), lp, list_doc, rp);
            }
        }
    } else if k == TYPE_ARRAY {
        let lb: u32 = fmt_byte(view(*ctx), 91u8);
        let rb: u32 = fmt_byte(view(*ctx), 93u8);
        let cnt_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*ty).count_expr as *const AstExpr }, false, 0u32);
        let elem_doc: u32 = fmt_print_type(view(*ctx), unsafe { (*ty).elem as *const AstType });
        // Canonical Axiom array type syntax parsed by `parse_array_or_slice_type` is `[N]T`.
        core = fmt_cat4(view(*ctx), lb, cnt_doc, rb, elem_doc);
    } else if k == TYPE_SLICE {
        let lb: u32 = fmt_byte(view(*ctx), 91u8);
        let rb: u32 = fmt_byte(view(*ctx), 93u8);
        let elem_doc: u32 = fmt_print_type(view(*ctx), unsafe { (*ty).elem as *const AstType });
        core = fmt_cat3(view(*ctx), lb, rb, elem_doc);
    } else if k == TYPE_VIEW {
        let kw: u32 = if unsafe { (*ty).is_mut } {
            fmt_tbl(view(*ctx), 195, 8)
        } else {
            fmt_tbl(view(*ctx), 191, 4)
        };
        let lt: u32 = fmt_byte(view(*ctx), 60u8);
        let gt: u32 = fmt_byte(view(*ctx), 62u8);
        let elem_doc: u32 = fmt_print_type(view(*ctx), unsafe { (*ty).elem as *const AstType });
        core = fmt_cat4(view(*ctx), kw, lt, elem_doc, gt);
    } else if k == TYPE_PTR {
        let kw: u32 = if unsafe { (*ty).is_mut } {
            fmt_tbl(view(*ctx), 203, 5)
        } else {
            fmt_tbl(view(*ctx), 208, 7)
        };
        let elem_doc: u32 = fmt_print_type(view(*ctx), unsafe { (*ty).elem as *const AstType });
        core = fmt_cat(view(*ctx), kw, elem_doc);
    } else if k == TYPE_FN {
        let mut hdr: u32 = 0u32;
        if unsafe { (*ty).is_unsafe } {
            hdr = fmt_cat(view(*ctx), hdr, fmt_tbl(view(*ctx), 55, 7));
        }
        let abi: StrId = unsafe { (*ty).abi };
        if abi.v != 0u32 {
            let ext_kw: u32 = fmt_tbl(view(*ctx), 62, 7);
            let q1: u32 = fmt_byte(view(*ctx), 34u8);
            let q2: u32 = fmt_byte2(view(*ctx), 34u8, 32u8);
            hdr = fmt_cat5(view(*ctx), hdr, ext_kw, q1, fmt_strid(view(*ctx), abi), q2);
        }
        let fn_lp: u32 = fmt_byte3(view(*ctx), 102u8, 110u8, 40u8);
        hdr = fmt_cat(view(*ctx), hdr, fn_lp);
        let mut p: *const AstType = unsafe { (*ty).param_types as *const AstType };
        let mut first: bool = true;
        while (p as usize) != 0 {
            let pd: u32 = fmt_print_type(view(*ctx), p);
            if first {
                hdr = fmt_cat(view(*ctx), hdr, pd);
                first = false;
            } else {
                hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 140, 2), pd);
            }
            p = unsafe { (*p).next as *const AstType };
        }
        hdr = fmt_cat(view(*ctx), hdr, fmt_byte(view(*ctx), 41u8));
        let rt: *const AstType = unsafe { (*ty).ret_type as *const AstType };
        if (rt as usize) != 0 {
            hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 131, 4), fmt_print_type(view(*ctx), rt));
        }
        core = hdr;
    } else if k == TYPE_DYN {
        let dyn_kw: u32 = fmt_tbl(view(*ctx), 215, 4);
        let b_doc: u32 = fmt_print_bounds(view(*ctx), unsafe { (*ty).bounds as *const AstType });
        core = fmt_cat(view(*ctx), dyn_kw, b_doc);
    }
    fmt_cat(view(*ctx), lead, core)
}

fn fmt_print_bounds(ctx: view<FmtCtx>, bounds: *const AstType) -> u32 {
    let mut doc: u32 = 0u32;
    let mut cur: *const AstType = bounds;
    let mut first: bool = true;
    while (cur as usize) != 0 {
        let td: u32 = fmt_print_type(view(*ctx), cur);
        if first {
            doc = td;
            first = false;
        } else {
            let plus: u32 = fmt_tbl(view(*ctx), 142, 3);
            doc = fmt_cat3(view(*ctx), doc, plus, td);
        }
        cur = unsafe { (*cur).next as *const AstType };
    }
    doc
}

fn fmt_print_generic_args(ctx: view<FmtCtx>, ga: *const AstGenericArgs) -> u32 {
    if (ga as usize) == 0 {
        return 0u32;
    }
    let mut cur: *const AstGenericArg = unsafe { (*ga).args as *const AstGenericArg };
    if (cur as usize) == 0 {
        return 0u32;
    }
    let lt: u32 = fmt_byte(view(*ctx), 60u8);
    let gt: u32 = fmt_byte(view(*ctx), 62u8);
    let mut inner: u32 = 0u32;
    let mut first: bool = true;
    while (cur as usize) != 0 {
        let nm: StrId = unsafe { (*cur).name };
        let td: u32 = fmt_print_type(view(*ctx), unsafe { (*cur).ty as *const AstType });
        let arg_doc: u32 = if nm.v != 0u32 {
            fmt_cat3(view(*ctx), fmt_strid(view(*ctx), nm), fmt_tbl(view(*ctx), 135, 3), td)
        } else {
            td
        };
        if first {
            inner = arg_doc;
            first = false;
        } else {
            inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), arg_doc);
        }
        cur = unsafe { (*cur).next as *const AstGenericArg };
    }
    fmt_cat3(view(*ctx), lt, inner, gt)
}

fn fmt_print_path_segments(ctx: view<FmtCtx>, head: *const AstTypePathSegment) -> u32 {
    let mut doc: u32 = 0u32;
    let mut cur: *const AstTypePathSegment = head;
    let mut first: bool = true;
    while (cur as usize) != 0 {
        let nm: u32 = fmt_strid(view(*ctx), unsafe { (*cur).name });
        let ga: u32 = fmt_print_generic_args(view(*ctx), unsafe { (*cur).generic_args as *const AstGenericArgs });
        let seg: u32 = fmt_cat(view(*ctx), nm, ga);
        if first {
            doc = seg;
            first = false;
        } else {
            // AXS-FMT-026: Canonical `.` path separator (never `::`).
            let dot: u32 = fmt_byte(view(*ctx), 46u8);
            doc = fmt_cat3(view(*ctx), doc, dot, seg);
        }
        cur = unsafe { (*cur).next as *const AstTypePathSegment };
    }
    doc
}

fn fmt_print_generic_params(ctx: view<FmtCtx>, gp: *const AstGenericParams) -> u32 {
    if (gp as usize) == 0 {
        return 0u32;
    }
    let mut cur: *const AstGenericParam = unsafe { (*gp).params as *const AstGenericParam };
    if (cur as usize) == 0 {
        return 0u32;
    }
    let lt: u32 = fmt_byte(view(*ctx), 60u8);
    let gt: u32 = fmt_byte(view(*ctx), 62u8);
    let mut inner: u32 = 0u32;
    let mut first: bool = true;
    while (cur as usize) != 0 {
        let nm: u32 = fmt_strid(view(*ctx), unsafe { (*cur).name });
        let bnds: *const AstType = unsafe { (*cur).bounds as *const AstType };
        let p_doc: u32 = if (bnds as usize) != 0 {
            fmt_cat3(view(*ctx), nm, fmt_tbl(view(*ctx), 138, 2), fmt_print_bounds(view(*ctx), bnds))
        } else {
            nm
        };
        if first {
            inner = p_doc;
            first = false;
        } else {
            inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), p_doc);
        }
        cur = unsafe { (*cur).next as *const AstGenericParam };
    }
    fmt_cat3(view(*ctx), lt, inner, gt)
}

fn fmt_print_where_clause(ctx: view<FmtCtx>, wc: *const AstWhereClause) -> u32 {
    if (wc as usize) == 0 {
        return 0u32;
    }
    let mut cur: *const AstWherePred = unsafe { (*wc).preds as *const AstWherePred };
    if (cur as usize) == 0 {
        return 0u32;
    }
    let mut cnt: usize = 0;
    let mut scan: *const AstWherePred = cur;
    while (scan as usize) != 0 {
        cnt = cnt + 1;
        scan = unsafe { (*scan).next as *const AstWherePred };
    }
    let where_kw: u32 = fmt_tbl(view(*ctx), 126, 5);
    if cnt == 1 {
        let ty_doc: u32 = fmt_print_type(view(*ctx), unsafe { (*cur).ty as *const AstType });
        let b_doc: u32 = fmt_print_bounds(view(*ctx), unsafe { (*cur).bounds as *const AstType });
        let pred_doc: u32 = fmt_cat3(view(*ctx), ty_doc, fmt_tbl(view(*ctx), 138, 2), b_doc);
        let sp: u32 = fmt_byte(view(*ctx), 32u8);
        let ln: u32 = fmt_ln(view(*ctx));
        return fmt_grp(view(*ctx), fmt_cat4(view(*ctx), ln, where_kw, sp, pred_doc));
    }
    let mut preds_doc: u32 = 0u32;
    while (cur as usize) != 0 {
        let ty_doc: u32 = fmt_print_type(view(*ctx), unsafe { (*cur).ty as *const AstType });
        let b_doc: u32 = fmt_print_bounds(view(*ctx), unsafe { (*cur).bounds as *const AstType });
        let comma: u32 = fmt_byte(view(*ctx), 44u8);
        let p_line: u32 = fmt_cat5(view(*ctx), fmt_hl(view(*ctx)), ty_doc, fmt_tbl(view(*ctx), 138, 2), b_doc, comma);
        preds_doc = fmt_cat(view(*ctx), preds_doc, p_line);
        cur = unsafe { (*cur).next as *const AstWherePred };
    }
    fmt_cat3(view(*ctx), fmt_hl(view(*ctx)), where_kw, fmt_ind(view(*ctx), preds_doc))
}

pub fn fmt_print_pat(ctx: view<FmtCtx>, pat: *const AstPat) -> u32 {
    if (pat as usize) == 0 {
        return 0u32;
    }
    let k: u8 = unsafe { (*pat).kind };
    if k == PAT_WILDCARD {
        return fmt_byte(view(*ctx), 95u8);
    }
    if k == PAT_LITERAL {
        let neg: u32 = if unsafe { (*pat).is_negated } { fmt_byte(view(*ctx), 45u8) } else { 0u32 };
        let lit: u32 = fmt_print_literal_tok(view(*ctx), unsafe { view((*pat).tok) });
        return fmt_cat(view(*ctx), neg, lit);
    }
    if k == PAT_RANGE {
        let s_doc: u32 = fmt_print_pat(view(*ctx), unsafe { (*pat).start_pat as *const AstPat });
        let e_doc: u32 = fmt_print_pat(view(*ctx), unsafe { (*pat).end_pat as *const AstPat });
        let op: u32 = if unsafe { (*pat).is_inclusive } {
            fmt_byte3(view(*ctx), 46u8, 46u8, 61u8)
        } else {
            fmt_byte2(view(*ctx), 46u8, 46u8)
        };
        return fmt_cat3(view(*ctx), s_doc, op, e_doc);
    }
    if k == PAT_BINDING {
        let m_kw: u32 = if unsafe { (*pat).is_mut } { fmt_tbl(view(*ctx), 122, 4) } else { 0u32 };
        return fmt_cat(view(*ctx), m_kw, fmt_strid(view(*ctx), unsafe { (*pat).name }));
    }
    if k == PAT_PATH {
        let segs: u32 = fmt_print_path_segments(view(*ctx), unsafe { (*pat).segments as *const AstTypePathSegment });
        let pay: *const AstPat = unsafe { (*pat).payload as *const AstPat };
        if (pay as usize) != 0 {
            return fmt_cat(view(*ctx), segs, fmt_print_pat(view(*ctx), pay));
        }
        return segs;
    }
    if k == PAT_TUPLE {
        let lp: u32 = fmt_byte(view(*ctx), 40u8);
        let rp: u32 = fmt_byte(view(*ctx), 41u8);
        let mut el: *const AstPat = unsafe { (*pat).elems as *const AstPat };
        if (el as usize) == 0 {
            return fmt_cat(view(*ctx), lp, rp);
        }
        let mut inner: u32 = 0u32;
        let mut first: bool = true;
        while (el as usize) != 0 {
            let pd: u32 = fmt_print_pat(view(*ctx), el);
            if first {
                inner = pd;
                first = false;
            } else {
                inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), pd);
            }
            el = unsafe { (*el).next as *const AstPat };
        }
        return fmt_cat3(view(*ctx), lp, inner, rp);
    }
    if k == PAT_OR {
        let mut el: *const AstPat = unsafe { (*pat).pats as *const AstPat };
        let mut inner: u32 = 0u32;
        let mut first: bool = true;
        let pipe: u32 = fmt_byte3(view(*ctx), 32u8, 124u8, 32u8);
        while (el as usize) != 0 {
            let pd: u32 = fmt_print_pat(view(*ctx), el);
            if first {
                inner = pd;
                first = false;
            } else {
                inner = fmt_cat3(view(*ctx), inner, pipe, pd);
            }
            el = unsafe { (*el).next as *const AstPat };
        }
        return inner;
    }
    if k == PAT_STRUCT {
        let segs: u32 = fmt_print_path_segments(view(*ctx), unsafe { (*pat).segments as *const AstTypePathSegment });
        let mut f: *const AstPatField = unsafe { (*pat).fields as *const AstPatField };
        let has_rest: bool = unsafe { (*pat).has_rest };
        if (f as usize) == 0 && !has_rest {
            return fmt_cat3(view(*ctx), segs, fmt_byte(view(*ctx), 32u8), fmt_tbl(view(*ctx), 253, 2));
        }
        let open: u32 = fmt_byte3(view(*ctx), 32u8, 123u8, 32u8);
        let close: u32 = fmt_byte2(view(*ctx), 32u8, 125u8);
        let mut inner: u32 = 0u32;
        let mut first: bool = true;
        while (f as usize) != 0 {
            let fnm_v: u32 = unsafe { (*f).name.v };
            let fpat: *const AstPat = unsafe { (*f).pat as *const AstPat };
            let mut f_doc: u32 = fmt_strid(view(*ctx), StrId { v: fnm_v });
            if (fpat as usize) != 0 {
                let is_shorthand: bool = unsafe { (*fpat).kind == PAT_BINDING && (*fpat).name.v == fnm_v };
                if is_shorthand {
                    if unsafe { (*fpat).is_mut } {
                        f_doc = fmt_cat(view(*ctx), fmt_tbl(view(*ctx), 122, 4), f_doc);
                    }
                } else {
                    f_doc = fmt_cat3(view(*ctx), f_doc, fmt_tbl(view(*ctx), 138, 2), fmt_print_pat(view(*ctx), fpat));
                }
            }
            if first {
                inner = f_doc;
                first = false;
            } else {
                inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), f_doc);
            }
            f = unsafe { (*f).next as *const AstPatField };
        }
        if has_rest {
            let dots: u32 = fmt_byte2(view(*ctx), 46u8, 46u8);
            if first {
                inner = dots;
            } else {
                inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), dots);
            }
        }
        return fmt_cat4(view(*ctx), segs, open, inner, close);
    }
    0u32
}

fn fmt_unwrap_paren(expr: *const AstExpr) -> *const AstExpr {
    let mut cur: *const AstExpr = expr;
    while (cur as usize) != 0 && (unsafe { (*cur).kind } & 127u8) == EXPR_PAREN {
        let inner: *const AstExpr = unsafe { (*cur).inner as *const AstExpr };
        if (inner as usize) == 0 {
            break;
        }
        cur = inner;
    }
    cur
}

fn fmt_binop_doc(ctx: view<FmtCtx>, op: u8) -> u32 {
    if op == BINOP_ADD { return fmt_byte(view(*ctx), 43u8); }
    if op == BINOP_SUB { return fmt_byte(view(*ctx), 45u8); }
    if op == BINOP_MUL { return fmt_byte(view(*ctx), 42u8); }
    if op == BINOP_DIV { return fmt_byte(view(*ctx), 47u8); }
    if op == BINOP_REM { return fmt_byte(view(*ctx), 37u8); }
    if op == BINOP_BITAND { return fmt_byte(view(*ctx), 38u8); }
    if op == BINOP_BITOR { return fmt_byte(view(*ctx), 124u8); }
    if op == BINOP_BITXOR { return fmt_byte(view(*ctx), 94u8); }
    if op == BINOP_SHL { return fmt_byte2(view(*ctx), 60u8, 60u8); }
    if op == BINOP_SHR { return fmt_byte2(view(*ctx), 62u8, 62u8); }
    if op == BINOP_EQ { return fmt_byte2(view(*ctx), 61u8, 61u8); }
    if op == BINOP_NE { return fmt_byte2(view(*ctx), 33u8, 61u8); }
    if op == BINOP_LT { return fmt_byte(view(*ctx), 60u8); }
    if op == BINOP_LE { return fmt_byte2(view(*ctx), 60u8, 61u8); }
    if op == BINOP_GT { return fmt_byte(view(*ctx), 62u8); }
    if op == BINOP_GE { return fmt_byte2(view(*ctx), 62u8, 61u8); }
    if op == BINOP_LOGAND { return fmt_byte2(view(*ctx), 38u8, 38u8); }
    if op == BINOP_LOGOR { return fmt_byte2(view(*ctx), 124u8, 124u8); }
    fmt_byte(view(*ctx), 43u8)
}

fn fmt_assign_op_doc(ctx: view<FmtCtx>, op: u8) -> u32 {
    if op == ASSIGN_EQ { return fmt_tbl(view(*ctx), 135, 3); }
    if op == ASSIGN_ADD { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte2(view(*ctx), 43u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_SUB { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte2(view(*ctx), 45u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_MUL { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte2(view(*ctx), 42u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_DIV { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte2(view(*ctx), 47u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_REM { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte2(view(*ctx), 37u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_BITAND { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte2(view(*ctx), 38u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_BITOR { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte2(view(*ctx), 124u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_BITXOR { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte2(view(*ctx), 94u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_SHL { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte3(view(*ctx), 60u8, 60u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    if op == ASSIGN_SHR { return fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_byte3(view(*ctx), 62u8, 62u8, 61u8), fmt_byte(view(*ctx), 32u8)); }
    fmt_tbl(view(*ctx), 135, 3)
}

fn fmt_print_call_args(ctx: view<FmtCtx>, args_head: *const AstExpr) -> u32 {
    let lp: u32 = fmt_byte(view(*ctx), 40u8);
    let rp: u32 = fmt_byte(view(*ctx), 41u8);
    if (args_head as usize) == 0 {
        return fmt_cat(view(*ctx), lp, rp);
    }
    let mut inner: u32 = 0u32;
    let mut cur: *const AstExpr = args_head;
    let mut first: bool = true;
    while (cur as usize) != 0 {
        let ad: u32 = fmt_print_expr(view(*ctx), cur, false, 0u32);
        if first {
            inner = ad;
            first = false;
        } else {
            let sep: u32 = fmt_cat(view(*ctx), fmt_byte(view(*ctx), 44u8), fmt_sln(view(*ctx)));
            inner = fmt_cat3(view(*ctx), inner, sep, ad);
        }
        cur = unsafe { (*cur).next as *const AstExpr };
    }
    let trail_comma: u32 = fmt_if_brk(view(*ctx), fmt_byte(view(*ctx), 44u8), 0u32);
    let body: u32 = fmt_ind(view(*ctx), fmt_cat3(view(*ctx), fmt_slne(view(*ctx)), inner, trail_comma));
    fmt_grp(view(*ctx), fmt_cat4(view(*ctx), lp, body, fmt_slne(view(*ctx)), rp))
}

fn fmt_seg_ptr(base: *mut *const AstPostfixSeg, idx: usize) -> *mut *const AstPostfixSeg {
    unsafe { base + idx }
}

// AXS-FMT-026: Flattens nested `EXPR_POSTFIX` chains and formats multiline `.method(...)` chains.
fn fmt_print_postfix_chain(ctx: view<FmtCtx>, expr: *const AstExpr) -> u32 {
    let mut depth: usize = 0;
    let mut cur: *const AstExpr = expr;
    while (cur as usize) != 0 && (unsafe { (*cur).kind } & 127u8) == EXPR_POSTFIX {
        let mut s: *const AstPostfixSeg = unsafe { (*cur).postfix_segs as *const AstPostfixSeg };
        while (s as usize) != 0 {
            depth = depth + 1;
            s = unsafe { (*s).next as *const AstPostfixSeg };
        }
        cur = unsafe { (*cur).head as *const AstExpr };
    }
    let base_expr: *const AstExpr = cur;
    let seg_arr: *mut *const AstPostfixSeg = arena_alloc_raw(
        unsafe { mut_view(*ctx.arena) },
        (depth + 1) * size_of<*const AstPostfixSeg>(),
        align_of<*const AstPostfixSeg>()
    ) as *mut *const AstPostfixSeg;

    // Collect segments in source order (innermost to outermost).
    let mut write_pos: usize = depth;
    cur = expr;
    while (cur as usize) != 0 && (unsafe { (*cur).kind } & 127u8) == EXPR_POSTFIX {
        let mut s_cnt: usize = 0;
        let mut s: *const AstPostfixSeg = unsafe { (*cur).postfix_segs as *const AstPostfixSeg };
        while (s as usize) != 0 {
            s_cnt = s_cnt + 1;
            s = unsafe { (*s).next as *const AstPostfixSeg };
        }
        write_pos = write_pos - s_cnt;
        let mut k: usize = 0;
        s = unsafe { (*cur).postfix_segs as *const AstPostfixSeg };
        while (s as usize) != 0 {
            unsafe { *(fmt_seg_ptr(seg_arr, write_pos + k)) = s; }
            k = k + 1;
            s = unsafe { (*s).next as *const AstPostfixSeg };
        }
        cur = unsafe { (*cur).head as *const AstExpr };
    }

    let mut head_doc: u32 = fmt_print_expr(view(*ctx), base_expr, false, 0u32);
    let mut i: usize = 0;

    // Attach any non-dot suffixes (`(args)`, `[idx]`, `?`, `->field`) directly to `head_doc`.
    while i < depth {
        let seg: *const AstPostfixSeg = unsafe { *(fmt_seg_ptr(seg_arr, i)) };
        let sk: u8 = unsafe { (*seg).kind };
        if sk == POSTFIX_FIELD || sk == POSTFIX_TUPLE_INDEX || sk == POSTFIX_AWAIT {
            break;
        }
        if sk == POSTFIX_CALL {
            head_doc = fmt_cat(view(*ctx), head_doc, fmt_print_call_args(view(*ctx), unsafe { (*seg).args as *const AstExpr }));
        } else if sk == POSTFIX_INDEX {
            let lb: u32 = fmt_byte(view(*ctx), 91u8);
            let rb: u32 = fmt_byte(view(*ctx), 93u8);
            let idx_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*seg).index_arg as *const AstExpr }, false, 0u32);
            head_doc = fmt_cat4(view(*ctx), head_doc, lb, idx_doc, rb);
        } else if sk == POSTFIX_TRY {
            head_doc = fmt_cat(view(*ctx), head_doc, fmt_byte(view(*ctx), 63u8));
        } else if sk == POSTFIX_ARROW {
            let arr: u32 = fmt_byte2(view(*ctx), 45u8, 62u8);
            head_doc = fmt_cat3(view(*ctx), head_doc, arr, fmt_strid(view(*ctx), unsafe { (*seg).name }));
        }
        i = i + 1;
    }

    if i >= depth {
        return head_doc;
    }

    // Count how many dot steps (`.field`, `.method(...)`, `.await`, `.0`) remain.
    let mut dot_steps: usize = 0;
    let mut scan: usize = i;
    while scan < depth {
        let sk: u8 = unsafe { (*(*(fmt_seg_ptr(seg_arr, scan)))).kind };
        if sk == POSTFIX_FIELD || sk == POSTFIX_TUPLE_INDEX || sk == POSTFIX_AWAIT {
            dot_steps = dot_steps + 1;
        }
        scan = scan + 1;
    }

    let mut chain_tail: u32 = 0u32;
    while i < depth {
        let seg: *const AstPostfixSeg = unsafe { *(fmt_seg_ptr(seg_arr, i)) };
        let sk: u8 = unsafe { (*seg).kind };
        let mut step_doc: u32 = 0u32;
        if sk == POSTFIX_FIELD {
            let dot: u32 = fmt_byte(view(*ctx), 46u8);
            let nm: u32 = fmt_strid(view(*ctx), unsafe { (*seg).name });
            let ga: u32 = fmt_print_generic_args(view(*ctx), unsafe { (*seg).generic_args as *const AstGenericArgs });
            step_doc = fmt_cat3(view(*ctx), dot, nm, ga);
        } else if sk == POSTFIX_TUPLE_INDEX {
            let dot: u32 = fmt_byte(view(*ctx), 46u8);
            step_doc = fmt_cat(view(*ctx), dot, fmt_u32(view(*ctx), unsafe { (*seg).tuple_index }));
        } else if sk == POSTFIX_AWAIT {
            step_doc = fmt_tbl(view(*ctx), 247, 6);
        }
        i = i + 1;

        // Attach immediately following `(args)`, `[idx]`, `?`, `->field` to this dot step.
        while i < depth {
            let nseg: *const AstPostfixSeg = unsafe { *(fmt_seg_ptr(seg_arr, i)) };
            let nsk: u8 = unsafe { (*nseg).kind };
            if nsk == POSTFIX_FIELD || nsk == POSTFIX_TUPLE_INDEX || nsk == POSTFIX_AWAIT {
                break;
            }
            if nsk == POSTFIX_CALL {
                step_doc = fmt_cat(view(*ctx), step_doc, fmt_print_call_args(view(*ctx), unsafe { (*nseg).args as *const AstExpr }));
            } else if nsk == POSTFIX_INDEX {
                let lb: u32 = fmt_byte(view(*ctx), 91u8);
                let rb: u32 = fmt_byte(view(*ctx), 93u8);
                let idx_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*nseg).index_arg as *const AstExpr }, false, 0u32);
                step_doc = fmt_cat4(view(*ctx), step_doc, lb, idx_doc, rb);
            } else if nsk == POSTFIX_TRY {
                step_doc = fmt_cat(view(*ctx), step_doc, fmt_byte(view(*ctx), 63u8));
            } else if nsk == POSTFIX_ARROW {
                let arr: u32 = fmt_byte2(view(*ctx), 45u8, 62u8);
                step_doc = fmt_cat3(view(*ctx), step_doc, arr, fmt_strid(view(*ctx), unsafe { (*nseg).name }));
            }
            i = i + 1;
        }

        if dot_steps >= 2 {
            let grouped_step: u32 = fmt_grp(view(*ctx), step_doc);
            chain_tail = fmt_cat3(view(*ctx), chain_tail, fmt_slne(view(*ctx)), grouped_step);
        } else {
            chain_tail = fmt_cat(view(*ctx), chain_tail, step_doc);
        }
    }

    if dot_steps >= 2 {
        fmt_grp(view(*ctx), fmt_cat(view(*ctx), head_doc, fmt_ind(view(*ctx), chain_tail)))
    } else {
        fmt_cat(view(*ctx), head_doc, chain_tail)
    }
}

fn fmt_is_simple_single_expr_block(ctx: view<FmtCtx>, blk: *const AstBlock) -> *const AstExpr {
    if (blk as usize) == 0 {
        return 0 as *const AstExpr;
    }
    let st: *const AstStmt = unsafe { (*blk).stmts as *const AstStmt };
    if (st as usize) == 0 || (unsafe { (*st).next } as usize) != 0 {
        return 0 as *const AstExpr;
    }
    if unsafe { (*st).kind != STMT_EXPR || (*st).has_semi } {
        return 0 as *const AstExpr;
    }
    let ex: *const AstExpr = unsafe { (*st).expr as *const AstExpr };
    if (ex as usize) == 0 {
        return 0 as *const AstExpr;
    }
    let ek: u8 = unsafe { (*ex).kind & 127u8 };
    if ek == EXPR_BLOCK || ek == EXPR_IF || ek == EXPR_MATCH || ek == EXPR_LOOP || ek == EXPR_WHILE || ek == EXPR_FOR {
        return 0 as *const AstExpr;
    }
    let open_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, unsafe { (*blk).span.start });
    let close_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, open_tok, TOK_LBRACE, unsafe { (*ctx.cst).non_eof_token_count });
    if close_tok < unsafe { (*ctx.cst).non_eof_token_count } {
        let close_b: u32 = unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, close_tok))).span.end };
        if cst_has_newline_between(unsafe { (*ctx.cst).src }, unsafe { (*blk).span.start }, close_b) {
            return 0 as *const AstExpr;
        }
    }
    ex
}

pub fn fmt_print_expr(ctx: view<FmtCtx>, expr: *const AstExpr, is_stmt_pos: bool, limit_byte: u32) -> u32 {
    if (expr as usize) == 0 {
        return 0u32;
    }
    let k: u8 = unsafe { (*expr).kind & 127u8 };
    if k == EXPR_ERROR {
        return 0u32;
    }
    let lead: u32 = fmt_emit_leading_in_range(
        view(*ctx),
        unsafe { (*expr).span.start },
        unsafe { (*expr).span.start },
        true,
        false
    );
    let mut core: u32 = 0u32;

    if k == EXPR_LITERAL {
        core = fmt_print_literal_tok(view(*ctx), unsafe { view((*expr).literal) });
    } else if k == EXPR_PATH {
        core = fmt_print_path_segments(view(*ctx), unsafe { (*expr).segments as *const AstTypePathSegment });
    } else if k == EXPR_PAREN {
        let lp: u32 = fmt_byte(view(*ctx), 40u8);
        let rp: u32 = fmt_byte(view(*ctx), 41u8);
        let inner_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*expr).inner as *const AstExpr }, false, 0u32);
        core = fmt_cat3(view(*ctx), lp, inner_doc, rp);
    } else if k == EXPR_TUPLE {
        let lp: u32 = fmt_byte(view(*ctx), 40u8);
        let rp: u32 = fmt_byte(view(*ctx), 41u8);
        let mut el: *const AstExpr = unsafe { (*expr).elems as *const AstExpr };
        if (el as usize) == 0 {
            core = fmt_cat(view(*ctx), lp, rp);
        } else {
            let mut inner: u32 = 0u32;
            let mut cnt: usize = 0;
            while (el as usize) != 0 {
                let ed: u32 = fmt_print_expr(view(*ctx), el, false, 0u32);
                if cnt == 0 {
                    inner = ed;
                } else {
                    let sep: u32 = fmt_cat(view(*ctx), fmt_byte(view(*ctx), 44u8), fmt_sln(view(*ctx)));
                    inner = fmt_cat3(view(*ctx), inner, sep, ed);
                }
                cnt = cnt + 1;
                el = unsafe { (*el).next as *const AstExpr };
            }
            if cnt == 1 {
                let comma: u32 = fmt_byte(view(*ctx), 44u8);
                core = fmt_cat4(view(*ctx), lp, inner, comma, rp);
            } else {
                let trail_c: u32 = fmt_if_brk(view(*ctx), fmt_byte(view(*ctx), 44u8), 0u32);
                let body: u32 = fmt_ind(view(*ctx), fmt_cat3(view(*ctx), fmt_slne(view(*ctx)), inner, trail_c));
                core = fmt_grp(view(*ctx), fmt_cat4(view(*ctx), lp, body, fmt_slne(view(*ctx)), rp));
            }
        }
    } else if k == EXPR_ARRAY {
        let lb: u32 = fmt_byte(view(*ctx), 91u8);
        let rb: u32 = fmt_byte(view(*ctx), 93u8);
        let mut el: *const AstExpr = unsafe { (*expr).elems as *const AstExpr };
        let cnt_ex: *const AstExpr = unsafe { (*expr).count_expr as *const AstExpr };
        if (el as usize) == 0 {
            core = fmt_cat(view(*ctx), lb, rb);
        } else if (cnt_ex as usize) != 0 {
            let v_doc: u32 = fmt_print_expr(view(*ctx), el, false, 0u32);
            let c_doc: u32 = fmt_print_expr(view(*ctx), cnt_ex, false, 0u32);
            let semi_sp: u32 = fmt_byte2(view(*ctx), 59u8, 32u8);
            core = fmt_cat5(view(*ctx), lb, v_doc, semi_sp, c_doc, rb);
        } else {
            let mut inner: u32 = 0u32;
            let mut first: bool = true;
            while (el as usize) != 0 {
                let ed: u32 = fmt_print_expr(view(*ctx), el, false, 0u32);
                if first {
                    inner = ed;
                    first = false;
                } else {
                    let sep: u32 = fmt_cat(view(*ctx), fmt_byte(view(*ctx), 44u8), fmt_sln(view(*ctx)));
                    inner = fmt_cat3(view(*ctx), inner, sep, ed);
                }
                el = unsafe { (*el).next as *const AstExpr };
            }
            let trail_c: u32 = fmt_if_brk(view(*ctx), fmt_byte(view(*ctx), 44u8), 0u32);
            let body: u32 = fmt_ind(view(*ctx), fmt_cat3(view(*ctx), fmt_slne(view(*ctx)), inner, trail_c));
            core = fmt_grp(view(*ctx), fmt_cat4(view(*ctx), lb, body, fmt_slne(view(*ctx)), rb));
        }
    } else if k == EXPR_STRUCT {
        let path_doc: u32 = fmt_print_path_segments(view(*ctx), unsafe { (*expr).segments as *const AstTypePathSegment });
        let mut f: *const AstFieldInit = unsafe { (*expr).fields as *const AstFieldInit };
        if (f as usize) == 0 {
            core = fmt_cat3(view(*ctx), path_doc, fmt_byte(view(*ctx), 32u8), fmt_tbl(view(*ctx), 253, 2));
        } else {
            let start_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, unsafe { (*expr).span.start });
            let close_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, start_tok, TOK_LBRACE, unsafe { (*ctx.cst).non_eof_token_count });
            let close_byte: u32 = if close_tok < unsafe { (*ctx.cst).non_eof_token_count } {
                unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, close_tok))).span.end }
            } else {
                unsafe { (*expr).span.end }
            };
            let was_multiline: bool = cst_has_newline_between(unsafe { (*ctx.cst).src }, unsafe { (*expr).span.start }, close_byte);
            let mut inner: u32 = 0u32;
            let mut first: bool = true;
            while (f as usize) != 0 {
                let f_lead: u32 = fmt_emit_leading_in_range(
                    view(*ctx),
                    unsafe { (*f).span.start },
                    unsafe { (*f).span.start },
                    true,
                    false
                );
                let fnm: u32 = fmt_strid(view(*ctx), unsafe { (*f).name });
                let fex: *const AstExpr = unsafe { (*f).expr as *const AstExpr };
                let f_core: u32 = if (fex as usize) != 0 {
                    fmt_cat3(view(*ctx), fnm, fmt_tbl(view(*ctx), 138, 2), fmt_print_expr(view(*ctx), fex, false, 0u32))
                } else {
                    fnm
                };
                let f_doc: u32 = fmt_cat(view(*ctx), f_lead, f_core);
                if first {
                    inner = f_doc;
                    first = false;
                } else {
                    let sep: u32 = if was_multiline {
                        fmt_cat(view(*ctx), fmt_byte(view(*ctx), 44u8), fmt_hl(view(*ctx)))
                    } else {
                        fmt_cat(view(*ctx), fmt_byte(view(*ctx), 44u8), fmt_ln(view(*ctx)))
                    };
                    inner = fmt_cat3(view(*ctx), inner, sep, f_doc);
                }
                f = unsafe { (*f).next as *const AstFieldInit };
            }
            let open_br: u32 = fmt_byte2(view(*ctx), 32u8, 123u8);
            let close_br: u32 = fmt_byte(view(*ctx), 125u8);
            if was_multiline {
                let body: u32 = fmt_ind(view(*ctx), fmt_cat3(view(*ctx), fmt_hl(view(*ctx)), inner, fmt_byte(view(*ctx), 44u8)));
                core = fmt_cat5(view(*ctx), path_doc, open_br, body, fmt_hl(view(*ctx)), close_br);
            } else {
                let trail_c: u32 = fmt_if_brk(view(*ctx), fmt_byte(view(*ctx), 44u8), 0u32);
                let body: u32 = fmt_ind(view(*ctx), fmt_cat3(view(*ctx), fmt_ln(view(*ctx)), inner, trail_c));
                core = fmt_grp(view(*ctx), fmt_cat5(view(*ctx), path_doc, open_br, body, fmt_ln(view(*ctx)), close_br));
            }
        }
    } else if k == EXPR_BLOCK {
        core = fmt_print_block(view(*ctx), unsafe { (*expr).block as *const AstBlock }, false);
    } else if k == EXPR_UNSAFE {
        let kw: u32 = fmt_tbl(view(*ctx), 55, 7);
        let blk: u32 = fmt_print_block(view(*ctx), unsafe { (*expr).block as *const AstBlock }, false);
        core = fmt_cat(view(*ctx), kw, blk);
    } else if k == EXPR_COMPTIME {
        let kw: u32 = fmt_tbl(view(*ctx), 46, 9);
        let blk: u32 = fmt_print_block(view(*ctx), unsafe { (*expr).block as *const AstBlock }, false);
        core = fmt_cat(view(*ctx), kw, blk);
    } else if k == EXPR_IF {
        let if_kw: u32 = fmt_tbl(view(*ctx), 159, 3);
        let lpat: *const AstPat = unsafe { (*expr).let_pat as *const AstPat };
        let raw_cond: *const AstExpr = unsafe { (*expr).cond as *const AstExpr };
        let clean_cond: *const AstExpr = fmt_unwrap_paren(raw_cond);
        let cond_doc: u32 = if (lpat as usize) != 0 {
            let pat_doc: u32 = fmt_print_pat(view(*ctx), lpat);
            let rhs_doc: u32 = fmt_print_expr(view(*ctx), clean_cond, false, 0u32);
            fmt_cat4(view(*ctx), fmt_tbl(view(*ctx), 149, 4), pat_doc, fmt_tbl(view(*ctx), 135, 3), rhs_doc)
        } else {
            fmt_print_expr(view(*ctx), clean_cond, false, 0u32)
        };
        let then_blk: *const AstBlock = unsafe { (*expr).block as *const AstBlock };
        let else_br: *const AstExpr = unsafe { (*expr).else_branch as *const AstExpr };

        // Check if short single-line expression `if cond { a } else { b }` applies (AXS-FMT-027).
        let mut can_inline_if: bool = !is_stmt_pos && (lpat as usize) == 0 && (else_br as usize) != 0;
        let mut then_single: *const AstExpr = 0 as *const AstExpr;
        let mut else_single: *const AstExpr = 0 as *const AstExpr;
        if can_inline_if {
            let eb_kind: u8 = unsafe { (*else_br).kind & 127u8 };
            if eb_kind == EXPR_BLOCK {
                then_single = fmt_is_simple_single_expr_block(view(*ctx), then_blk);
                else_single = fmt_is_simple_single_expr_block(view(*ctx), unsafe { (*else_br).block as *const AstBlock });
                can_inline_if = (then_single as usize) != 0 && (else_single as usize) != 0;
            } else {
                can_inline_if = false;
            }
        }
        if can_inline_if {
            let t_doc: u32 = fmt_print_expr(view(*ctx), then_single, false, 0u32);
            let e_doc: u32 = fmt_print_expr(view(*ctx), else_single, false, 0u32);
            let open_b: u32 = fmt_byte2(view(*ctx), 32u8, 123u8);
            let else_b: u32 = fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 125u8), fmt_tbl(view(*ctx), 153, 6), fmt_byte(view(*ctx), 123u8));
            let close_b: u32 = fmt_byte(view(*ctx), 125u8);
            let t_part: u32 = fmt_ind(view(*ctx), fmt_cat(view(*ctx), fmt_ln(view(*ctx)), t_doc));
            let e_part: u32 = fmt_ind(view(*ctx), fmt_cat(view(*ctx), fmt_ln(view(*ctx)), e_doc));
            let p1: u32 = fmt_cat5(view(*ctx), if_kw, cond_doc, open_b, t_part, fmt_ln(view(*ctx)));
            let p2: u32 = fmt_cat4(view(*ctx), else_b, e_part, fmt_ln(view(*ctx)), close_b);
            core = fmt_grp(view(*ctx), fmt_cat(view(*ctx), p1, p2));
        } else {
            let then_doc: u32 = fmt_print_block(view(*ctx), then_blk, true);
            let mut full: u32 = fmt_cat4(view(*ctx), if_kw, cond_doc, fmt_byte(view(*ctx), 32u8), then_doc);
            if (else_br as usize) != 0 {
                let else_kw: u32 = fmt_tbl(view(*ctx), 153, 6);
                let eb_k: u8 = unsafe { (*else_br).kind & 127u8 };
                let eb_doc: u32 = if eb_k == EXPR_IF {
                    fmt_print_expr(view(*ctx), else_br, true, 0u32)
                } else if eb_k == EXPR_BLOCK {
                    fmt_print_block(view(*ctx), unsafe { (*else_br).block as *const AstBlock }, true)
                } else {
                    fmt_print_expr(view(*ctx), else_br, true, 0u32)
                };
                full = fmt_cat3(view(*ctx), full, else_kw, eb_doc);
            }
            core = full;
        }
    } else if k == EXPR_MATCH {
        let m_kw: u32 = fmt_tbl(view(*ctx), 162, 6);
        let cond_doc: u32 = fmt_print_expr(view(*ctx), fmt_unwrap_paren(unsafe { (*expr).cond as *const AstExpr }), false, 0u32);
        let open_b: u32 = fmt_byte2(view(*ctx), 32u8, 123u8);
        let close_b: u32 = fmt_byte(view(*ctx), 125u8);
        let mut arm: *const AstMatchArm = unsafe { (*expr).arms as *const AstMatchArm };
        let start_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, unsafe { (*expr).span.start });
        let close_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, start_tok, TOK_LBRACE, unsafe { (*ctx.cst).non_eof_token_count });
        let close_byte: u32 = if close_tok < unsafe { (*ctx.cst).non_eof_token_count } {
            unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, close_tok))).span.start }
        } else {
            limit_byte
        };
        if (arm as usize) == 0 {
            core = fmt_cat3(view(*ctx), m_kw, cond_doc, fmt_cat(view(*ctx), open_b, close_b));
        } else {
            let mut arms_doc: u32 = 0u32;
            let mut first_arm: bool = true;
            let mut prev_arm_end: u32 = unsafe { (*expr).span.start };
            while (arm as usize) != 0 {
                let next_arm: *const AstMatchArm = unsafe { (*arm).next as *const AstMatchArm };
                let arm_limit_byte: u32 = if (next_arm as usize) != 0 {
                    unsafe { (*next_arm).span.start }
                } else {
                    close_byte
                };
                let has_blank: bool = !first_arm && cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_arm_end, unsafe { (*arm).span.start });
                let a_lead: u32 = fmt_emit_leading_in_range(view(*ctx), prev_arm_end, unsafe { (*arm).span.start }, true, true);
                let pat_doc: u32 = fmt_print_pat(view(*ctx), unsafe { (*arm).pat as *const AstPat });
                let grd: *const AstExpr = unsafe { (*arm).guard as *const AstExpr };
                let grd_doc: u32 = if (grd as usize) != 0 {
                    fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_tbl(view(*ctx), 159, 3), fmt_print_expr(view(*ctx), grd, false, 0u32))
                } else {
                    0u32
                };
                let b_expr: *const AstExpr = unsafe { (*arm).body as *const AstExpr };
                let b_doc: u32 = fmt_print_expr(view(*ctx), b_expr, false, arm_limit_byte);
                let comma: u32 = fmt_byte(view(*ctx), 44u8);
                let trail: u32 = fmt_emit_trailing_for_range(view(*ctx), unsafe { (*arm).span.start }, if arm_limit_byte > 0u32 { arm_limit_byte - 1u32 } else { 0u32 });
                let a_line: u32 = fmt_cat5(view(*ctx), a_lead, pat_doc, grd_doc, fmt_tbl(view(*ctx), 187, 4), fmt_cat3(view(*ctx), b_doc, comma, trail));
                let sep: u32 = if first_arm {
                    fmt_hl(view(*ctx))
                } else if has_blank {
                    fmt_bl(view(*ctx))
                } else {
                    fmt_hl(view(*ctx))
                };
                arms_doc = fmt_cat3(view(*ctx), arms_doc, sep, a_line);
                first_arm = false;
                prev_arm_end = arm_limit_byte;
                arm = next_arm;
            }
            let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), prev_arm_end, close_byte);
            if dang != 0u32 {
                arms_doc = fmt_cat3(view(*ctx), arms_doc, fmt_hl(view(*ctx)), dang);
            }
            core = fmt_cat5(view(*ctx), m_kw, cond_doc, open_b, fmt_ind(view(*ctx), arms_doc), fmt_cat(view(*ctx), fmt_hl(view(*ctx)), close_b));
        }
    } else if k == EXPR_LOOP || k == EXPR_WHILE || k == EXPR_FOR {
        let lbl: StrId = unsafe { (*expr).label };
        let lbl_doc: u32 = if lbl.v != 0u32 {
            fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 39u8), fmt_strid(view(*ctx), lbl), fmt_tbl(view(*ctx), 138, 2))
        } else {
            0u32
        };
        let blk_doc: u32 = fmt_print_block(view(*ctx), unsafe { (*expr).block as *const AstBlock }, true);
        if k == EXPR_LOOP {
            core = fmt_cat3(view(*ctx), lbl_doc, fmt_tbl(view(*ctx), 168, 5), blk_doc);
        } else if k == EXPR_WHILE {
            let lpat: *const AstPat = unsafe { (*expr).let_pat as *const AstPat };
            let c_expr: *const AstExpr = fmt_unwrap_paren(unsafe { (*expr).cond as *const AstExpr });
            let c_doc: u32 = if (lpat as usize) != 0 {
                fmt_cat4(view(*ctx), fmt_tbl(view(*ctx), 149, 4), fmt_print_pat(view(*ctx), lpat), fmt_tbl(view(*ctx), 135, 3), fmt_print_expr(view(*ctx), c_expr, false, 0u32))
            } else {
                fmt_print_expr(view(*ctx), c_expr, false, 0u32)
            };
            core = fmt_cat5(view(*ctx), lbl_doc, fmt_tbl(view(*ctx), 173, 6), c_doc, fmt_byte(view(*ctx), 32u8), blk_doc);
        } else {
            let p_doc: u32 = fmt_print_pat(view(*ctx), unsafe { (*expr).pat as *const AstPat });
            let it_doc: u32 = fmt_print_expr(view(*ctx), fmt_unwrap_paren(unsafe { (*expr).iter as *const AstExpr }), false, 0u32);
            let hdr: u32 = fmt_cat5(view(*ctx), lbl_doc, fmt_tbl(view(*ctx), 179, 4), p_doc, fmt_tbl(view(*ctx), 183, 4), it_doc);
            core = fmt_cat3(view(*ctx), hdr, fmt_byte(view(*ctx), 32u8), blk_doc);
        }
    } else if k == EXPR_VIEW {
        let kw: u32 = if unsafe { (*expr).is_mut } { fmt_tbl(view(*ctx), 195, 8) } else { fmt_tbl(view(*ctx), 191, 4) };
        let lp: u32 = fmt_byte(view(*ctx), 40u8);
        let rp: u32 = fmt_byte(view(*ctx), 41u8);
        let in_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*expr).inner as *const AstExpr }, false, 0u32);
        core = fmt_cat4(view(*ctx), kw, lp, in_doc, rp);
    } else if k == EXPR_JUMP {
        let jk: u8 = unsafe { (*expr).jump_kind };
        let kw: u32 = if jk == JUMP_RETURN {
            fmt_tbl(view(*ctx), 219, 6)
        } else if jk == JUMP_BREAK {
            fmt_tbl(view(*ctx), 225, 5)
        } else {
            fmt_tbl(view(*ctx), 230, 8)
        };
        let mut full: u32 = kw;
        let lbl: StrId = unsafe { (*expr).label };
        if lbl.v != 0u32 {
            full = fmt_cat4(view(*ctx), full, fmt_byte(view(*ctx), 32u8), fmt_byte(view(*ctx), 39u8), fmt_strid(view(*ctx), lbl));
        }
        let in_ex: *const AstExpr = fmt_unwrap_paren(unsafe { (*expr).inner as *const AstExpr });
        if (in_ex as usize) != 0 {
            full = fmt_cat3(view(*ctx), full, fmt_byte(view(*ctx), 32u8), fmt_print_expr(view(*ctx), in_ex, false, 0u32));
        }
        core = full;
    } else if k == EXPR_CLOSURE {
        let mut p: *const AstParam = unsafe { (*expr).params as *const AstParam };
        let mut p_doc: u32 = 0u32;
        if (p as usize) == 0 {
            p_doc = fmt_byte2(view(*ctx), 124u8, 124u8);
        } else {
            let mut inner: u32 = 0u32;
            let mut first: bool = true;
            while (p as usize) != 0 {
                let m_kw: u32 = if unsafe { (*p).is_mut } { fmt_tbl(view(*ctx), 122, 4) } else { 0u32 };
                let nm: u32 = if unsafe { (*p).name.v } != 0u32 { fmt_strid(view(*ctx), unsafe { (*p).name }) } else { fmt_byte(view(*ctx), 95u8) };
                let p_ty: *const AstType = unsafe { (*p).ty as *const AstType };
                let one_p: u32 = if (p_ty as usize) != 0 {
                    fmt_cat4(view(*ctx), m_kw, nm, fmt_tbl(view(*ctx), 138, 2), fmt_print_type(view(*ctx), p_ty))
                } else {
                    fmt_cat(view(*ctx), m_kw, nm)
                };
                if first {
                    inner = one_p;
                    first = false;
                } else {
                    inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), one_p);
                }
                p = unsafe { (*p).next as *const AstParam };
            }
            let pipe: u32 = fmt_byte(view(*ctx), 124u8);
            p_doc = fmt_cat3(view(*ctx), pipe, inner, pipe);
        }
        let rt: *const AstType = unsafe { (*expr).ret_type as *const AstType };
        if (rt as usize) != 0 {
            p_doc = fmt_cat3(view(*ctx), p_doc, fmt_tbl(view(*ctx), 131, 4), fmt_print_type(view(*ctx), rt));
        }
        let b_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*expr).body as *const AstExpr }, false, 0u32);
        core = fmt_cat3(view(*ctx), p_doc, fmt_byte(view(*ctx), 32u8), b_doc);
    } else if k == EXPR_RANGE {
        let s_ex: *const AstExpr = unsafe { (*expr).start_expr as *const AstExpr };
        let e_ex: *const AstExpr = unsafe { (*expr).end_expr as *const AstExpr };
        let s_doc: u32 = if (s_ex as usize) != 0 { fmt_print_expr(view(*ctx), s_ex, false, 0u32) } else { 0u32 };
        let e_doc: u32 = if (e_ex as usize) != 0 { fmt_print_expr(view(*ctx), e_ex, false, 0u32) } else { 0u32 };
        let op: u32 = if unsafe { (*expr).is_inclusive } { fmt_byte3(view(*ctx), 46u8, 46u8, 61u8) } else { fmt_byte2(view(*ctx), 46u8, 46u8) };
        core = fmt_cat3(view(*ctx), s_doc, op, e_doc);
    } else if k == EXPR_UNARY {
        let uop: u8 = unsafe { (*expr).op };
        let op_b: u8 = if uop == UNOP_NEG { 45u8 } else if uop == UNOP_NOT { 33u8 } else if uop == UNOP_BITNOT { 126u8 } else { 42u8 };
        let in_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*expr).inner as *const AstExpr }, false, 0u32);
        core = fmt_cat(view(*ctx), fmt_byte(view(*ctx), op_b), in_doc);
    } else if k == EXPR_CAST {
        let in_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*expr).inner as *const AstExpr }, false, 0u32);
        let ty_doc: u32 = fmt_print_type(view(*ctx), unsafe { (*expr).cast_ty as *const AstType });
        core = fmt_cat3(view(*ctx), in_doc, fmt_tbl(view(*ctx), 145, 4), ty_doc);
    } else if k == EXPR_BINARY {
        // AXS-FMT-026 / NEG-FMT-01: Binary operator stays at the end of the preceding line when wrapping.
        let l_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*expr).left as *const AstExpr }, false, 0u32);
        let op_doc: u32 = fmt_binop_doc(view(*ctx), unsafe { (*expr).op });
        let r_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*expr).right as *const AstExpr }, false, 0u32);
        let sp_op: u32 = fmt_cat(view(*ctx), fmt_byte(view(*ctx), 32u8), op_doc);
        let rhs_part: u32 = fmt_ind(view(*ctx), fmt_cat(view(*ctx), fmt_ln(view(*ctx)), r_doc));
        core = fmt_grp(view(*ctx), fmt_cat3(view(*ctx), l_doc, sp_op, rhs_part));
    } else if k == EXPR_POSTFIX {
        core = fmt_print_postfix_chain(view(*ctx), expr);
    }

    fmt_cat(view(*ctx), lead, core)
}

fn fmt_is_empty_semi_stmt(st: *const AstStmt) -> bool {
    if (st as usize) == 0 {
        return false;
    }
    if unsafe { (*st).kind } != STMT_EXPR {
        return false;
    }
    let ex: *const AstExpr = unsafe { (*st).expr as *const AstExpr };
    if (ex as usize) == 0 {
        return true;
    }
    unsafe { ((*ex).kind & 127u8) == EXPR_ERROR && (*ex).span.start == 0u32 && (*ex).span.end == 0u32 }
}

fn fmt_next_real_stmt(st: *const AstStmt) -> *const AstStmt {
    let mut cur: *const AstStmt = st;
    while (cur as usize) != 0 {
        if !fmt_is_empty_semi_stmt(cur) {
            return cur;
        }
        cur = unsafe { (*cur).next as *const AstStmt };
    }
    0 as *const AstStmt
}

// AXS-FMT-025: Formats a single statement with canonical `=` and semicolon rules S1, S2, S3.
pub fn fmt_print_stmt(
    ctx: view<FmtCtx>,
    stmt: *const AstStmt,
    is_last_in_block: bool,
    prev_end_byte: u32,
    limit_byte: u32
) -> u32 {
    if (stmt as usize) == 0 {
        return 0u32;
    }
    let lead: u32 = fmt_emit_leading_in_range(
        view(*ctx),
        prev_end_byte,
        unsafe { (*stmt).span.start },
        true,
        true
    );
    let k: u8 = unsafe { (*stmt).kind };
    let mut core: u32 = 0u32;

    if k == STMT_LET {
        let let_kw: u32 = fmt_tbl(view(*ctx), 149, 4);
        let pat_doc: u32 = fmt_print_pat(view(*ctx), unsafe { (*stmt).pat as *const AstPat });
        let mut hdr: u32 = fmt_cat(view(*ctx), let_kw, pat_doc);
        let ty: *const AstType = unsafe { (*stmt).ty as *const AstType };
        if (ty as usize) != 0 {
            hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 138, 2), fmt_print_type(view(*ctx), ty));
        }
        let ex: *const AstExpr = unsafe { (*stmt).expr as *const AstExpr };
        if (ex as usize) != 0 {
            let ex_doc: u32 = fmt_print_expr(view(*ctx), ex, false, limit_byte);
            hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 135, 3), ex_doc);
            let eb: *const AstBlock = unsafe { (*stmt).else_block as *const AstBlock };
            if (eb as usize) != 0 {
                let eb_doc: u32 = fmt_print_block(view(*ctx), eb, true);
                hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 153, 6), eb_doc);
            }
        }
        core = hdr;
    } else if k == STMT_ASSIGN {
        let l_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*stmt).left as *const AstExpr }, false, 0u32);
        let op_doc: u32 = fmt_assign_op_doc(view(*ctx), unsafe { (*stmt).op });
        let r_doc: u32 = fmt_print_expr(view(*ctx), unsafe { (*stmt).right as *const AstExpr }, false, limit_byte);
        core = fmt_cat3(view(*ctx), l_doc, op_doc, r_doc);
    } else if k == STMT_EXPR {
        let ex: *const AstExpr = unsafe { (*stmt).expr as *const AstExpr };
        let ex_doc: u32 = fmt_print_expr(view(*ctx), ex, true, limit_byte);
        let ek: u8 = if (ex as usize) != 0 { unsafe { (*ex).kind & 127u8 } } else { EXPR_ERROR };
        // AXS-FMT-025 Rule S1/S2/S3: Preserve `;` ONLY on the final STMT_EXPR of a block
        // when `has_semi == true` and it is not `return`/`break`/`continue` or a block-structured control flow.
        let is_ctrl_or_jump: bool = ek == EXPR_JUMP || ek == EXPR_IF || ek == EXPR_MATCH ||
            ek == EXPR_LOOP || ek == EXPR_WHILE || ek == EXPR_FOR || ek == EXPR_BLOCK;
        if is_last_in_block && unsafe { (*stmt).has_semi } && !is_ctrl_or_jump {
            core = fmt_cat(view(*ctx), ex_doc, fmt_byte(view(*ctx), 59u8));
        } else {
            core = ex_doc;
        }
    }

    let trail_end: u32 = if limit_byte > 0u32 { limit_byte - 1u32 } else { unsafe { (*stmt).span.end } };
    let trail: u32 = fmt_emit_trailing_for_range(view(*ctx), unsafe { (*stmt).span.start }, trail_end);
    fmt_cat3(view(*ctx), lead, core, trail)
}

pub fn fmt_print_block(ctx: view<FmtCtx>, blk: *const AstBlock, force_multiline: bool) -> u32 {
    if (blk as usize) == 0 {
        return fmt_tbl(view(*ctx), 253, 2);
    }
    let open_byte: u32 = unsafe { (*blk).span.start };
    let open_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, open_byte);
    let close_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, open_tok, TOK_LBRACE, unsafe { (*ctx.cst).non_eof_token_count });
    let open_end_byte: u32 = if open_tok < unsafe { (*ctx.cst).non_eof_token_count } {
        unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, open_tok))).span.end }
    } else {
        open_byte + 1u32
    };
    let close_start_byte: u32 = if close_tok < unsafe { (*ctx.cst).non_eof_token_count } {
        unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, close_tok))).span.start }
    } else {
        open_end_byte
    };

    let open_trail: u32 = fmt_emit_trailing_for_range(view(*ctx), open_byte, open_end_byte);
    let mut cur: *const AstStmt = fmt_next_real_stmt(unsafe { (*blk).stmts as *const AstStmt });

    if (cur as usize) == 0 {
        let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), open_end_byte, close_start_byte);
        if dang == 0u32 && open_trail == 0u32 {
            return fmt_tbl(view(*ctx), 253, 2);
        }
        let lb: u32 = fmt_cat(view(*ctx), fmt_byte(view(*ctx), 123u8), open_trail);
        let rb: u32 = fmt_byte(view(*ctx), 125u8);
        let body: u32 = if dang != 0u32 {
            fmt_ind(view(*ctx), fmt_cat(view(*ctx), fmt_hl(view(*ctx)), dang))
        } else {
            0u32
        };
        return fmt_cat4(view(*ctx), lb, body, fmt_hl(view(*ctx)), rb);
    }

    let mut stmts_doc: u32 = 0u32;
    let mut first: bool = true;
    let mut prev_end: u32 = open_end_byte;

    while (cur as usize) != 0 {
        let next_st: *const AstStmt = fmt_next_real_stmt(unsafe { (*cur).next as *const AstStmt });
        let is_last: bool = (next_st as usize) == 0;
        let stmt_limit_byte: u32 = if !is_last {
            unsafe { (*next_st).span.start }
        } else {
            close_start_byte
        };
        let has_blank: bool = !first && cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_end, unsafe { (*cur).span.start });
        let s_doc: u32 = fmt_print_stmt(view(*ctx), cur, is_last, prev_end, stmt_limit_byte);
        let sep: u32 = if first {
            fmt_hl(view(*ctx))
        } else if has_blank {
            fmt_bl(view(*ctx))
        } else {
            fmt_hl(view(*ctx))
        };
        stmts_doc = fmt_cat3(view(*ctx), stmts_doc, sep, s_doc);
        first = false;
        prev_end = stmt_limit_byte;
        cur = next_st;
    }

    let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), prev_end, close_start_byte);
    if dang != 0u32 {
        let has_blank: bool = cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_end, close_start_byte);
        let sep: u32 = if has_blank { fmt_bl(view(*ctx)) } else { fmt_hl(view(*ctx)) };
        stmts_doc = fmt_cat3(view(*ctx), stmts_doc, sep, dang);
    }

    let lb: u32 = fmt_cat(view(*ctx), fmt_byte(view(*ctx), 123u8), open_trail);
    let rb: u32 = fmt_byte(view(*ctx), 125u8);
    let _ = force_multiline;
    fmt_cat4(view(*ctx), lb, fmt_ind(view(*ctx), stmts_doc), fmt_hl(view(*ctx)), rb)
}

fn fmt_is_attr_name(interner: view<StrInterner>, id: StrId, b0: u8, b1: u8, b2: u8, b3: u8, expected_len: usize) -> bool {
    if id.v == 0u32 {
        return false;
    }
    let sv: StrView = interner_get(interner, id);
    if sv.len != expected_len || (sv.len) < 4 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == b0 && *(sv.ptr + 1) == b1 && *(sv.ptr + 2) == b2 && *(sv.ptr + 3) == b3
    }
}

fn fmt_print_single_attr(ctx: view<FmtCtx>, attr: *const AstAttr) -> u32 {
    let at: u32 = fmt_byte(view(*ctx), 64u8);
    let nm: u32 = fmt_strid(view(*ctx), unsafe { (*attr).name });
    let mut a: *const AstAttrArg = unsafe { (*attr).args as *const AstAttrArg };
    if (a as usize) == 0 {
        return fmt_cat(view(*ctx), at, nm);
    }
    let lp: u32 = fmt_byte(view(*ctx), 40u8);
    let rp: u32 = fmt_byte(view(*ctx), 41u8);
    let mut inner: u32 = 0u32;
    let mut first: bool = true;
    while (a as usize) != 0 {
        let anm: StrId = unsafe { (*a).name };
        let aex: u32 = fmt_print_expr(view(*ctx), unsafe { (*a).expr as *const AstExpr }, false, 0u32);
        let arg_doc: u32 = if anm.v != 0u32 {
            fmt_cat3(view(*ctx), fmt_strid(view(*ctx), anm), fmt_tbl(view(*ctx), 135, 3), aex)
        } else {
            aex
        };
        if first {
            inner = arg_doc;
            first = false;
        } else {
            inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), arg_doc);
        }
        a = unsafe { (*a).next as *const AstAttrArg };
    }
    fmt_cat5(view(*ctx), at, nm, lp, inner, rp)
}

// AXS-FMT-022: Prints `@attribute` list, placing `@repr(...)` before `@derive(...)`.
fn fmt_print_attrs(ctx: view<FmtCtx>, head: *const AstAttr, inline_space: bool) -> u32 {
    if (head as usize) == 0 {
        return 0u32;
    }
    let mut doc: u32 = 0u32;
    // Pass 1: non-`@derive` attributes (e.g. `@repr`, `@cfg`, `@intrinsic`, `@inline`).
    let mut cur: *const AstAttr = head;
    while (cur as usize) != 0 {
        let is_derive: bool = fmt_is_attr_name(unsafe { view(*ctx.interner) }, unsafe { (*cur).name }, 100u8, 101u8, 114u8, 105u8, 6);
        if !is_derive {
            let ad: u32 = fmt_print_single_attr(view(*ctx), cur);
            let sep: u32 = if inline_space { fmt_byte(view(*ctx), 32u8) } else { fmt_hl(view(*ctx)) };
            doc = fmt_cat3(view(*ctx), doc, ad, sep);
        }
        cur = unsafe { (*cur).next as *const AstAttr };
    }
    // Pass 2: `@derive` attributes.
    cur = head;
    while (cur as usize) != 0 {
        let is_derive: bool = fmt_is_attr_name(unsafe { view(*ctx.interner) }, unsafe { (*cur).name }, 100u8, 101u8, 114u8, 105u8, 6);
        if is_derive {
            let ad: u32 = fmt_print_single_attr(view(*ctx), cur);
            let sep: u32 = if inline_space { fmt_byte(view(*ctx), 32u8) } else { fmt_hl(view(*ctx)) };
            doc = fmt_cat3(view(*ctx), doc, ad, sep);
        }
        cur = unsafe { (*cur).next as *const AstAttr };
    }
    doc
}

fn fmt_print_vis(ctx: view<FmtCtx>, vis: view<AstVis>) -> u32 {
    if vis.kind == VIS_PUB {
        return fmt_tbl(view(*ctx), 11, 4);
    }
    if vis.kind == VIS_PUB_PACKAGE {
        return fmt_tbl(view(*ctx), 15, 13);
    }
    if vis.kind == VIS_PUB_MODULE {
        return fmt_tbl(view(*ctx), 28, 12);
    }
    0u32
}

fn fmt_strview_eq_c4(sv: StrView, b0: u8, b1: u8, b2: u8, b3: u8) -> bool {
    if sv.len != 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == b0 && *(sv.ptr + 1) == b1 && *(sv.ptr + 2) == b2 && *(sv.ptr + 3) == b3
    }
}

fn fmt_strview_cmp(a: StrView, b: StrView) -> i32 {
    let min_len: usize = if (a.len) < b.len { a.len } else { b.len };
    let mut i: usize = 0;
    while i < min_len {
        let ba: u8 = unsafe { *(a.ptr + i) };
        let bb: u8 = unsafe { *(b.ptr + i) };
        if ba < bb {
            return -1;
        }
        if ba > bb {
            return 1;
        }
        i = i + 1;
    }
    if (a.len) < b.len {
        return -1;
    }
    if a.len > b.len {
        return 1;
    }
    0
}

fn fmt_is_use_tree_self(interner: view<StrInterner>, tree: *const AstUseTree) -> bool {
    if (tree as usize) == 0 {
        return false;
    }
    if unsafe { (*tree).path.count != 1 || ((*tree).subtrees as usize) != 0 } {
        return false;
    }
    let sid: StrId = unsafe { *(cst_strid_ptr((*tree).path.segments, 0)) };
    let sv: StrView = interner_get(interner, sid);
    fmt_strview_eq_c4(sv, 115u8, 101u8, 108u8, 102u8)
}

fn fmt_cmp_use_tree(interner: view<StrInterner>, a: *const AstUseTree, b: *const AstUseTree) -> i32 {
    if (a as usize) == 0 && (b as usize) == 0 {
        return 0;
    }
    if (a as usize) == 0 {
        return -1;
    }
    if (b as usize) == 0 {
        return 1;
    }
    let a_self: bool = fmt_is_use_tree_self(interner, a);
    let b_self: bool = fmt_is_use_tree_self(interner, b);
    if a_self && !b_self {
        return -1;
    }
    if !a_self && b_self {
        return 1;
    }
    let ca: usize = unsafe { (*a).path.count };
    let cb: usize = unsafe { (*b).path.count };
    let min_c: usize = if ca < cb { ca } else { cb };
    let mut i: usize = 0;
    while i < min_c {
        let sa: StrView = interner_get(interner, unsafe { *(cst_strid_ptr((*a).path.segments, i)) });
        let sb: StrView = interner_get(interner, unsafe { *(cst_strid_ptr((*b).path.segments, i)) });
        let c: i32 = fmt_strview_cmp(sa, sb);
        if c != 0 {
            return c;
        }
        i = i + 1;
    }
    if ca < cb {
        return -1;
    }
    if ca > cb {
        return 1;
    }
    fmt_cmp_use_tree(interner, unsafe { (*a).subtrees as *const AstUseTree }, unsafe { (*b).subtrees as *const AstUseTree })
}

// AXS-FMT-021: Canonicalizes a `use` tree (unwraps `{Single}` and sorts `{...}` with `self` first).
fn fmt_canonicalize_use_tree(arena: mut_view<Arena>, interner: view<StrInterner>, tree: *mut AstUseTree) {
    if (tree as usize) == 0 {
        return;
    }
    let mut sub: *mut AstUseTree = unsafe { (*tree).subtrees };
    while (sub as usize) != 0 {
        fmt_canonicalize_use_tree(mut_view(*arena), interner, sub);
        sub = unsafe { (*sub).next };
    }

    // Unwrap single-item brace group `use a.b.{C}` -> `use a.b.C` (unless `self`).
    let first_sub: *mut AstUseTree = unsafe { (*tree).subtrees };
    if (first_sub as usize) != 0 && (unsafe { (*first_sub).next } as usize) == 0 &&
            (unsafe { (*first_sub).subtrees } as usize) == 0 && (unsafe { (*first_sub).path.count }) > 0 &&
            !fmt_is_use_tree_self(interner, first_sub as *const AstUseTree) {
        let c1: usize = unsafe { (*tree).path.count };
        let c2: usize = unsafe { (*first_sub).path.count };
        let new_segs: *mut StrId = arena_alloc_raw(mut_view(*arena), (c1 + c2) * size_of<StrId>(), align_of<StrId>()) as *mut StrId;
        let mut i: usize = 0;
        while i < c1 {
            unsafe { *(cst_strid_ptr(new_segs, i)) = *(cst_strid_ptr((*tree).path.segments, i)); }
            i = i + 1;
        }
        let mut j: usize = 0;
        while j < c2 {
            unsafe { *(cst_strid_ptr(new_segs, c1 + j)) = *(cst_strid_ptr((*first_sub).path.segments, j)); }
            j = j + 1;
        }
        cst_set_dotted_name(unsafe { mut_view((*tree).path) }, new_segs, c1 + c2);
        unsafe {
            (*tree).alias = (*first_sub).alias;
            (*tree).subtrees = 0 as *mut AstUseTree;
        }
        return;
    }

    // Insertion-sort `(*tree).subtrees`.
    let mut sorted: *mut AstUseTree = 0 as *mut AstUseTree;
    let mut cur: *mut AstUseTree = unsafe { (*tree).subtrees };
    while (cur as usize) != 0 {
        let nxt: *mut AstUseTree = unsafe { (*cur).next };
        if (sorted as usize) == 0 || fmt_cmp_use_tree(interner, cur as *const AstUseTree, sorted as *const AstUseTree) <= 0 {
            unsafe { (*cur).next = sorted; }
            sorted = cur;
        } else {
            let mut prev: *mut AstUseTree = sorted;
            while (unsafe { (*prev).next } as usize) != 0 &&
                    fmt_cmp_use_tree(interner, unsafe { (*prev).next as *const AstUseTree }, cur as *const AstUseTree) < 0 {
                prev = unsafe { (*prev).next };
            }
            unsafe {
                (*cur).next = (*prev).next;
                (*prev).next = cur;
            }
        }
        cur = nxt;
    }
    unsafe { (*tree).subtrees = sorted; }
}

fn fmt_print_use_tree(ctx: view<FmtCtx>, tree: *const AstUseTree) -> u32 {
    if (tree as usize) == 0 {
        return 0u32;
    }
    let path_doc: u32 = fmt_print_dotted_name(view(*ctx), unsafe { view((*tree).path) });
    let al: StrId = unsafe { (*tree).alias };
    let sub: *const AstUseTree = unsafe { (*tree).subtrees as *const AstUseTree };
    if (sub as usize) != 0 {
        let dot_lb: u32 = fmt_byte2(view(*ctx), 46u8, 123u8);
        let rb: u32 = fmt_byte(view(*ctx), 125u8);
        let mut inner: u32 = 0u32;
        let mut cur: *const AstUseTree = sub;
        let mut first: bool = true;
        while (cur as usize) != 0 {
            let sd: u32 = fmt_print_use_tree(view(*ctx), cur);
            if first {
                inner = sd;
                first = false;
            } else {
                let sep: u32 = fmt_cat(view(*ctx), fmt_byte(view(*ctx), 44u8), fmt_sln(view(*ctx)));
                inner = fmt_cat3(view(*ctx), inner, sep, sd);
            }
            cur = unsafe { (*cur).next as *const AstUseTree };
        }
        let trail_c: u32 = fmt_if_brk(view(*ctx), fmt_byte(view(*ctx), 44u8), 0u32);
        let body: u32 = fmt_ind(view(*ctx), fmt_cat3(view(*ctx), fmt_slne(view(*ctx)), inner, trail_c));
        return fmt_grp(view(*ctx), fmt_cat5(view(*ctx), path_doc, dot_lb, body, fmt_slne(view(*ctx)), rb));
    }
    if al.v != 0u32 {
        return fmt_cat3(view(*ctx), path_doc, fmt_tbl(view(*ctx), 145, 4), fmt_strid(view(*ctx), al));
    }
    path_doc
}

fn fmt_has_any_trivia_in_range(cf: view<CstFile>, start_byte: u32, end_byte: u32) -> bool {
    let mut i: usize = 0;
    while i < cf.trivia_count {
        let tr: *mut CstTrivia = cst_trivia_ptr(cf.trivia, i);
        if !unsafe { (*tr).emitted } {
            let ab: u32 = unsafe { (*tr).anchor_byte };
            if ab >= start_byte && ab < end_byte {
                return true;
            }
        }
        i = i + 1;
    }
    false
}

fn fmt_starts_with_tight_region_end(cf: view<CstFile>, start_byte: u32, end_byte: u32) -> bool {
    let mut i: usize = 0;
    while i < cf.trivia_count {
        let tr: *mut CstTrivia = cst_trivia_ptr(cf.trivia, i);
        if !unsafe { (*tr).emitted } {
            let rs: u32 = unsafe { (*tr).raw_span.start };
            let ab: u32 = unsafe { (*tr).anchor_byte };
            if (rs >= start_byte && rs <= end_byte) || (ab >= start_byte && ab <= end_byte) {
                return unsafe { (*tr).is_region_end && !(*tr).has_blank_before };
            }
        }
        i = i + 1;
    }
    false
}

fn fmt_print_params(ctx: view<FmtCtx>, head: *const AstParam, open_lp_byte: u32, close_rp_byte: u32) -> u32 {
    let lp: u32 = fmt_byte(view(*ctx), 40u8);
    let rp: u32 = fmt_byte(view(*ctx), 41u8);
    if (head as usize) == 0 {
        let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), open_lp_byte, close_rp_byte);
        if dang != 0u32 {
            return fmt_cat4(view(*ctx), lp, fmt_ind(view(*ctx), fmt_cat(view(*ctx), fmt_hl(view(*ctx)), dang)), fmt_hl(view(*ctx)), rp);
        }
        return fmt_cat(view(*ctx), lp, rp);
    }
    let mut inner: u32 = 0u32;
    let mut cur: *const AstParam = head;
    let mut first: bool = true;
    while (cur as usize) != 0 {
        let p_lead: u32 = fmt_emit_leading_in_range(view(*ctx), unsafe { (*cur).span.start }, unsafe { (*cur).span.start }, true, false);
        let m_kw: u32 = if unsafe { (*cur).is_mut } { fmt_tbl(view(*ctx), 122, 4) } else { 0u32 };
        let nm: u32 = if unsafe { (*cur).name.v } != 0u32 {
            fmt_strid(view(*ctx), unsafe { (*cur).name })
        } else {
            fmt_byte(view(*ctx), 95u8)
        };
        let ty: *const AstType = unsafe { (*cur).ty as *const AstType };
        let p_core: u32 = if (ty as usize) != 0 {
            fmt_cat4(view(*ctx), m_kw, nm, fmt_tbl(view(*ctx), 138, 2), fmt_print_type(view(*ctx), ty))
        } else {
            fmt_cat(view(*ctx), m_kw, nm)
        };
        let p_doc: u32 = fmt_cat(view(*ctx), p_lead, p_core);
        if first {
            inner = p_doc;
            first = false;
        } else {
            let sep: u32 = fmt_cat(view(*ctx), fmt_byte(view(*ctx), 44u8), fmt_sln(view(*ctx)));
            inner = fmt_cat3(view(*ctx), inner, sep, p_doc);
        }
        cur = unsafe { (*cur).next as *const AstParam };
    }
    let trail_c: u32 = fmt_if_brk(view(*ctx), fmt_byte(view(*ctx), 44u8), 0u32);
    let body: u32 = fmt_ind(view(*ctx), fmt_cat3(view(*ctx), fmt_slne(view(*ctx)), inner, trail_c));
    fmt_grp(view(*ctx), fmt_cat4(view(*ctx), lp, body, fmt_slne(view(*ctx)), rp))
}

fn fmt_print_field_decls(ctx: view<FmtCtx>, head: *const AstFieldDecl, open_byte: u32, close_byte: u32) -> u32 {
    let open_br: u32 = fmt_byte2(view(*ctx), 32u8, 123u8);
    let close_br: u32 = fmt_byte(view(*ctx), 125u8);
    if (head as usize) == 0 {
        let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), open_byte, close_byte);
        if dang == 0u32 {
            return fmt_cat(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_tbl(view(*ctx), 253, 2));
        }
        let body: u32 = fmt_ind(view(*ctx), fmt_cat(view(*ctx), fmt_hl(view(*ctx)), dang));
        return fmt_cat4(view(*ctx), open_br, body, fmt_hl(view(*ctx)), close_br);
    }
    let mut fields_doc: u32 = 0u32;
    let mut cur: *const AstFieldDecl = head;
    let mut first: bool = true;
    let mut prev_end: u32 = open_byte;
    while (cur as usize) != 0 {
        let nxt: *const AstFieldDecl = unsafe { (*cur).next as *const AstFieldDecl };
        let f_limit: u32 = if (nxt as usize) != 0 { unsafe { (*nxt).span.start } } else { close_byte };
        let has_blank: bool = !first && cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_end, unsafe { (*cur).span.start });
        let vis_start: u32 = if unsafe { (*cur).vis.span.start } >= unsafe { (*cur).span.start } {
            unsafe { (*cur).vis.span.start }
        } else {
            unsafe { (*cur).span.start }
        };
        let lead_non_doc: u32 = fmt_emit_leading_in_range(view(*ctx), prev_end, vis_start, true, false);
        let lead_odoc: u32 = fmt_emit_leading_in_range(view(*ctx), prev_end, vis_start, false, true);
        let attrs_doc: u32 = fmt_print_attrs(view(*ctx), unsafe { (*cur).attrs as *const AstAttr }, false);
        let vis_doc: u32 = fmt_print_vis(view(*ctx), unsafe { view((*cur).vis) });
        let nm_doc: u32 = fmt_strid(view(*ctx), unsafe { (*cur).name });
        let ty_doc: u32 = fmt_print_type(view(*ctx), unsafe { (*cur).ty as *const AstType });
        let comma: u32 = fmt_byte(view(*ctx), 44u8);
        let trail: u32 = fmt_emit_trailing_for_range(view(*ctx), unsafe { (*cur).span.start }, if f_limit > 0u32 { f_limit - 1u32 } else { 0u32 });
        let decl_line: u32 = fmt_cat5(view(*ctx), vis_doc, nm_doc, fmt_tbl(view(*ctx), 138, 2), ty_doc, fmt_cat(view(*ctx), comma, trail));
        let full_field: u32 = fmt_cat4(view(*ctx), lead_non_doc, lead_odoc, attrs_doc, decl_line);
        let sep: u32 = if first {
            fmt_hl(view(*ctx))
        } else if has_blank {
            fmt_bl(view(*ctx))
        } else {
            fmt_hl(view(*ctx))
        };
        fields_doc = fmt_cat3(view(*ctx), fields_doc, sep, full_field);
        first = false;
        prev_end = f_limit;
        cur = nxt;
    }
    let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), prev_end, close_byte);
    if dang != 0u32 {
        fields_doc = fmt_cat3(view(*ctx), fields_doc, fmt_hl(view(*ctx)), dang);
    }
    fmt_cat4(view(*ctx), open_br, fmt_ind(view(*ctx), fields_doc), fmt_hl(view(*ctx)), close_br)
}

fn fmt_print_variants(ctx: view<FmtCtx>, head: *const AstVariantDecl, open_byte: u32, close_byte: u32) -> u32 {
    let open_br: u32 = fmt_byte2(view(*ctx), 32u8, 123u8);
    let close_br: u32 = fmt_byte(view(*ctx), 125u8);
    if (head as usize) == 0 {
        let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), open_byte, close_byte);
        if dang == 0u32 {
            return fmt_cat(view(*ctx), fmt_byte(view(*ctx), 32u8), fmt_tbl(view(*ctx), 253, 2));
        }
        let body: u32 = fmt_ind(view(*ctx), fmt_cat(view(*ctx), fmt_hl(view(*ctx)), dang));
        return fmt_cat4(view(*ctx), open_br, body, fmt_hl(view(*ctx)), close_br);
    }
    let mut vars_doc: u32 = 0u32;
    let mut cur: *const AstVariantDecl = head;
    let mut first: bool = true;
    let mut prev_end: u32 = open_byte;
    while (cur as usize) != 0 {
        let nxt: *const AstVariantDecl = unsafe { (*cur).next as *const AstVariantDecl };
        let v_limit: u32 = if (nxt as usize) != 0 { unsafe { (*nxt).span.start } } else { close_byte };
        let has_blank: bool = !first && cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_end, unsafe { (*cur).span.start });
        let lead_non_doc: u32 = fmt_emit_leading_in_range(view(*ctx), prev_end, unsafe { (*cur).span.start }, true, false);
        let lead_odoc: u32 = fmt_emit_leading_in_range(view(*ctx), prev_end, unsafe { (*cur).span.start }, false, true);
        let attrs_doc: u32 = fmt_print_attrs(view(*ctx), unsafe { (*cur).attrs as *const AstAttr }, false);
        let nm_doc: u32 = fmt_strid(view(*ctx), unsafe { (*cur).name });
        let mut v_body: u32 = 0u32;
        if unsafe { (*cur).is_struct } {
            let v_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, unsafe { (*cur).span.start });
            let v_close_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, v_tok, TOK_LBRACE, unsafe { (*ctx.cst).non_eof_token_count });
            let v_close_b: u32 = if v_close_tok < unsafe { (*ctx.cst).non_eof_token_count } {
                unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, v_close_tok))).span.start }
            } else {
                v_limit
            };
            v_body = fmt_print_field_decls(view(*ctx), unsafe { (*cur).struct_fields as *const AstFieldDecl }, unsafe { (*cur).span.start }, v_close_b);
        } else {
            let mut tt: *const AstType = unsafe { (*cur).tuple_types as *const AstType };
            if (tt as usize) != 0 {
                let mut inner: u32 = 0u32;
                let mut f_tt: bool = true;
                while (tt as usize) != 0 {
                    let td: u32 = fmt_print_type(view(*ctx), tt);
                    if f_tt {
                        inner = td;
                        f_tt = false;
                    } else {
                        inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), td);
                    }
                    tt = unsafe { (*tt).next as *const AstType };
                }
                v_body = fmt_cat3(view(*ctx), fmt_byte(view(*ctx), 40u8), inner, fmt_byte(view(*ctx), 41u8));
            }
        }
        let comma: u32 = fmt_byte(view(*ctx), 44u8);
        let trail: u32 = fmt_emit_trailing_for_range(view(*ctx), unsafe { (*cur).span.start }, if v_limit > 0u32 { v_limit - 1u32 } else { 0u32 });
        let v_line: u32 = fmt_cat4(view(*ctx), nm_doc, v_body, comma, trail);
        let full_v: u32 = fmt_cat4(view(*ctx), lead_non_doc, lead_odoc, attrs_doc, v_line);
        let sep: u32 = if first {
            fmt_hl(view(*ctx))
        } else if has_blank {
            fmt_bl(view(*ctx))
        } else {
            fmt_hl(view(*ctx))
        };
        vars_doc = fmt_cat3(view(*ctx), vars_doc, sep, full_v);
        first = false;
        prev_end = v_limit;
        cur = nxt;
    }
    let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), prev_end, close_byte);
    if dang != 0u32 {
        vars_doc = fmt_cat3(view(*ctx), vars_doc, fmt_hl(view(*ctx)), dang);
    }
    fmt_cat4(view(*ctx), open_br, fmt_ind(view(*ctx), vars_doc), fmt_hl(view(*ctx)), close_br)
}

pub fn fmt_print_item(ctx: view<FmtCtx>, item: *const AstItem, prev_end_byte: u32, limit_byte: u32) -> u32 {
    if (item as usize) == 0 {
        return 0u32;
    }
    let item_start: u32 = unsafe { (*item).span.start };
    let vis_start: u32 = if unsafe { (*item).vis.span.start } >= item_start {
        unsafe { (*item).vis.span.start }
    } else {
        item_start
    };
    // AXS-FMT-003 Slot 4: Outer doc comments `///` hoisted prior to `@attribute` lines.
    let lead_non_doc: u32 = fmt_emit_leading_in_range(view(*ctx), prev_end_byte, vis_start, true, false);
    let lead_odoc: u32 = fmt_emit_leading_in_range(view(*ctx), prev_end_byte, vis_start, false, true);
    let attrs_doc: u32 = fmt_print_attrs(view(*ctx), unsafe { (*item).attrs as *const AstAttr }, false);
    let vis_doc: u32 = fmt_print_vis(view(*ctx), unsafe { view((*item).vis) });

    let k: u8 = unsafe { (*item).kind };
    let mut core: u32 = 0u32;

    if k == ITEM_MODULE {
        let mod_kw: u32 = fmt_tbl(view(*ctx), 0, 7);
        let p_doc: u32 = fmt_print_dotted_name(view(*ctx), unsafe { view((*item).mod_path) });
        core = fmt_cat(view(*ctx), mod_kw, p_doc);
    } else if k == ITEM_USE {
        let use_kw: u32 = fmt_tbl(view(*ctx), 7, 4);
        let ut: *mut AstUseTree = unsafe { (*item).use_tree };
        fmt_canonicalize_use_tree(unsafe { mut_view(*ctx.arena) }, unsafe { view(*ctx.interner) }, ut);
        let t_doc: u32 = fmt_print_use_tree(view(*ctx), ut as *const AstUseTree);
        core = fmt_cat3(view(*ctx), vis_doc, use_kw, t_doc);
    } else if k == ITEM_CONST {
        let c_kw: u32 = fmt_tbl(view(*ctx), 109, 6);
        let nm: u32 = fmt_strid(view(*ctx), unsafe { (*item).name });
        let ty: u32 = fmt_print_type(view(*ctx), unsafe { (*item).ty as *const AstType });
        let mut hdr: u32 = fmt_cat5(view(*ctx), vis_doc, c_kw, nm, fmt_tbl(view(*ctx), 138, 2), ty);
        let ex: *const AstExpr = unsafe { (*item).expr as *const AstExpr };
        if (ex as usize) != 0 {
            hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 135, 3), fmt_print_expr(view(*ctx), ex, false, limit_byte));
        }
        core = hdr;
    } else if k == ITEM_STATIC {
        let u_kw: u32 = if unsafe { (*item).is_unsafe } { fmt_tbl(view(*ctx), 55, 7) } else { 0u32 };
        let s_kw: u32 = fmt_tbl(view(*ctx), 115, 7);
        let m_kw: u32 = if unsafe { (*item).is_mut } { fmt_tbl(view(*ctx), 122, 4) } else { 0u32 };
        let nm: u32 = fmt_strid(view(*ctx), unsafe { (*item).name });
        let ty: u32 = fmt_print_type(view(*ctx), unsafe { (*item).ty as *const AstType });
        let mut hdr: u32 = fmt_cat5(view(*ctx), vis_doc, u_kw, s_kw, m_kw, nm);
        hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 138, 2), ty);
        let ex: *const AstExpr = unsafe { (*item).expr as *const AstExpr };
        if (ex as usize) != 0 {
            hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 135, 3), fmt_print_expr(view(*ctx), ex, false, limit_byte));
        }
        core = hdr;
    } else if k == ITEM_TYPE_ALIAS {
        let t_kw: u32 = fmt_tbl(view(*ctx), 104, 5);
        let nm: u32 = fmt_strid(view(*ctx), unsafe { (*item).name });
        let gp: u32 = fmt_print_generic_params(view(*ctx), unsafe { (*item).generic_params as *const AstGenericParams });
        let mut hdr: u32 = fmt_cat4(view(*ctx), vis_doc, t_kw, nm, gp);
        let ty: *const AstType = unsafe { (*item).ty as *const AstType };
        if (ty as usize) != 0 {
            hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 135, 3), fmt_print_type(view(*ctx), ty));
        }
        core = hdr;
    } else if k == ITEM_FN {
        let mut hdr: u32 = vis_doc;
        if unsafe { (*item).is_async } {
            hdr = fmt_cat(view(*ctx), hdr, fmt_tbl(view(*ctx), 40, 6));
        }
        if unsafe { (*item).is_comptime } {
            hdr = fmt_cat(view(*ctx), hdr, fmt_tbl(view(*ctx), 46, 9));
        }
        if unsafe { (*item).is_unsafe } {
            hdr = fmt_cat(view(*ctx), hdr, fmt_tbl(view(*ctx), 55, 7));
        }
        let abi: StrId = unsafe { (*item).abi };
        if abi.v != 0u32 {
            let ext_kw: u32 = fmt_tbl(view(*ctx), 62, 7);
            let q1: u32 = fmt_byte(view(*ctx), 34u8);
            let q2: u32 = fmt_byte2(view(*ctx), 34u8, 32u8);
            hdr = fmt_cat5(view(*ctx), hdr, ext_kw, q1, fmt_strid(view(*ctx), abi), q2);
        }
        let fn_kw: u32 = fmt_tbl(view(*ctx), 69, 3);
        let nm: u32 = fmt_strid(view(*ctx), unsafe { (*item).name });
        let gp: u32 = fmt_print_generic_params(view(*ctx), unsafe { (*item).generic_params as *const AstGenericParams });
        let start_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, vis_start);
        let close_rp_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, start_tok, TOK_LPAREN, unsafe { (*ctx.cst).non_eof_token_count });
        let close_rp_byte: u32 = if close_rp_tok < unsafe { (*ctx.cst).non_eof_token_count } {
            unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, close_rp_tok))).span.start }
        } else {
            limit_byte
        };
        let params_doc: u32 = fmt_print_params(view(*ctx), unsafe { (*item).params as *const AstParam }, vis_start, close_rp_byte);
        hdr = fmt_cat5(view(*ctx), hdr, fn_kw, nm, gp, params_doc);
        let rt: *const AstType = unsafe { (*item).ret_type as *const AstType };
        if (rt as usize) != 0 {
            hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 131, 4), fmt_print_type(view(*ctx), rt));
        }
        let wc: u32 = fmt_print_where_clause(view(*ctx), unsafe { (*item).where_clause as *const AstWhereClause });
        hdr = fmt_cat(view(*ctx), hdr, wc);
        let body: *const AstBlock = unsafe { (*item).body as *const AstBlock };
        if (body as usize) != 0 {
            let b_doc: u32 = fmt_print_block(view(*ctx), body, true);
            hdr = fmt_cat3(view(*ctx), hdr, fmt_byte(view(*ctx), 32u8), b_doc);
        }
        core = hdr;
    } else if k == ITEM_STRUCT {
        let s_kw: u32 = fmt_tbl(view(*ctx), 72, 7);
        let nm: u32 = fmt_strid(view(*ctx), unsafe { (*item).name });
        let gp: u32 = fmt_print_generic_params(view(*ctx), unsafe { (*item).generic_params as *const AstGenericParams });
        let wc: u32 = fmt_print_where_clause(view(*ctx), unsafe { (*item).where_clause as *const AstWhereClause });
        let mut hdr: u32 = fmt_cat4(view(*ctx), vis_doc, s_kw, nm, gp);
        if unsafe { (*item).is_tuple } {
            let mut tt: *const AstType = unsafe { (*item).tuple_types as *const AstType };
            let mut inner: u32 = 0u32;
            let mut first: bool = true;
            while (tt as usize) != 0 {
                let td: u32 = fmt_print_type(view(*ctx), tt);
                if first {
                    inner = td;
                    first = false;
                } else {
                    inner = fmt_cat3(view(*ctx), inner, fmt_tbl(view(*ctx), 140, 2), td);
                }
                tt = unsafe { (*tt).next as *const AstType };
            }
            core = fmt_cat5(view(*ctx), hdr, fmt_byte(view(*ctx), 40u8), inner, fmt_byte(view(*ctx), 41u8), wc);
        } else {
            let start_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, vis_start);
            let close_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, start_tok, TOK_LBRACE, unsafe { (*ctx.cst).non_eof_token_count });
            let close_b: u32 = if close_tok < unsafe { (*ctx.cst).non_eof_token_count } {
                unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, close_tok))).span.start }
            } else {
                limit_byte
            };
            let f_doc: u32 = fmt_print_field_decls(view(*ctx), unsafe { (*item).struct_fields as *const AstFieldDecl }, vis_start, close_b);
            core = fmt_cat3(view(*ctx), hdr, wc, f_doc);
        }
    } else if k == ITEM_ENUM {
        let e_kw: u32 = fmt_tbl(view(*ctx), 79, 5);
        let nm: u32 = fmt_strid(view(*ctx), unsafe { (*item).name });
        let gp: u32 = fmt_print_generic_params(view(*ctx), unsafe { (*item).generic_params as *const AstGenericParams });
        let wc: u32 = fmt_print_where_clause(view(*ctx), unsafe { (*item).where_clause as *const AstWhereClause });
        let start_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, vis_start);
        let close_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, start_tok, TOK_LBRACE, unsafe { (*ctx.cst).non_eof_token_count });
        let close_b: u32 = if close_tok < unsafe { (*ctx.cst).non_eof_token_count } {
            unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, close_tok))).span.start }
        } else {
            limit_byte
        };
        let v_doc: u32 = fmt_print_variants(view(*ctx), unsafe { (*item).variants as *const AstVariantDecl }, vis_start, close_b);
        core = fmt_cat5(view(*ctx), vis_doc, e_kw, fmt_cat(view(*ctx), nm, gp), wc, v_doc);
    } else if k == ITEM_TRAIT || k == ITEM_IMPL || k == ITEM_EXTERN_BLOCK {
        let mut hdr: u32 = vis_doc;
        if unsafe { (*item).is_unsafe } {
            hdr = fmt_cat(view(*ctx), hdr, fmt_tbl(view(*ctx), 55, 7));
        }
        if k == ITEM_TRAIT {
            if unsafe { (*item).is_auto } {
                hdr = fmt_cat(view(*ctx), hdr, fmt_tbl(view(*ctx), 90, 5));
            }
            let t_kw: u32 = fmt_tbl(view(*ctx), 84, 6);
            let nm: u32 = fmt_strid(view(*ctx), unsafe { (*item).name });
            let gp: u32 = fmt_print_generic_params(view(*ctx), unsafe { (*item).generic_params as *const AstGenericParams });
            hdr = fmt_cat4(view(*ctx), hdr, t_kw, nm, gp);
            let st: *const AstType = unsafe { (*item).supertraits as *const AstType };
            if (st as usize) != 0 {
                hdr = fmt_cat3(view(*ctx), hdr, fmt_tbl(view(*ctx), 138, 2), fmt_print_bounds(view(*ctx), st));
            }
            hdr = fmt_cat(view(*ctx), hdr, fmt_print_where_clause(view(*ctx), unsafe { (*item).where_clause as *const AstWhereClause }));
        } else if k == ITEM_IMPL {
            let i_kw: u32 = fmt_tbl(view(*ctx), 95, 4);
            let gp: u32 = fmt_print_generic_params(view(*ctx), unsafe { (*item).generic_params as *const AstGenericParams });
            let sp: u32 = fmt_byte(view(*ctx), 32u8);
            let bang: u32 = if unsafe { (*item).is_negative } { fmt_byte(view(*ctx), 33u8) } else { 0u32 };
            hdr = fmt_cat5(view(*ctx), hdr, i_kw, gp, sp, bang);
            let tr_p: *const AstType = unsafe { (*item).trait_path as *const AstType };
            let self_t: *const AstType = unsafe { (*item).self_type as *const AstType };
            if (tr_p as usize) != 0 {
                hdr = fmt_cat4(view(*ctx), hdr, fmt_print_type(view(*ctx), tr_p), fmt_tbl(view(*ctx), 99, 5), fmt_print_type(view(*ctx), self_t));
            } else {
                hdr = fmt_cat(view(*ctx), hdr, fmt_print_type(view(*ctx), self_t));
            }
            hdr = fmt_cat(view(*ctx), hdr, fmt_print_where_clause(view(*ctx), unsafe { (*item).where_clause as *const AstWhereClause }));
        } else {
            let ext_kw: u32 = fmt_tbl(view(*ctx), 62, 7);
            let q1: u32 = fmt_byte(view(*ctx), 34u8);
            let q2: u32 = fmt_byte(view(*ctx), 34u8);
            hdr = fmt_cat5(view(*ctx), hdr, ext_kw, q1, fmt_strid(view(*ctx), unsafe { (*item).abi }), q2);
        }

        let start_tok: usize = cst_find_token_at_or_after(unsafe { view(*ctx.cst) }, vis_start);
        let close_tok: usize = cst_find_container_close_tok(unsafe { view(*ctx.cst) }, start_tok, TOK_LBRACE, unsafe { (*ctx.cst).non_eof_token_count });
        let close_b: u32 = if close_tok < unsafe { (*ctx.cst).non_eof_token_count } {
            unsafe { (*(cst_tok_ptr((*ctx.cst).tokens, close_tok))).span.start }
        } else {
            limit_byte
        };
        let mut m: *const AstItem = unsafe { (*item).members as *const AstItem };
        if (m as usize) == 0 {
            let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), vis_start, close_b);
            if dang == 0u32 {
                core = fmt_cat3(view(*ctx), hdr, fmt_byte(view(*ctx), 32u8), fmt_tbl(view(*ctx), 253, 2));
            } else {
                let open_br: u32 = fmt_byte2(view(*ctx), 32u8, 123u8);
                let close_br: u32 = fmt_byte(view(*ctx), 125u8);
                core = fmt_cat5(view(*ctx), hdr, open_br, fmt_ind(view(*ctx), fmt_cat(view(*ctx), fmt_hl(view(*ctx)), dang)), fmt_hl(view(*ctx)), close_br);
            }
        } else {
            let open_br: u32 = fmt_byte2(view(*ctx), 32u8, 123u8);
            let close_br: u32 = fmt_byte(view(*ctx), 125u8);
            let mut mems_doc: u32 = 0u32;
            let mut first_m: bool = true;
            let mut prev_m_end: u32 = vis_start;
            let mut prev_m_kind: u8 = 0u8;
            let mut prev_m_has_body: bool = false;
            while (m as usize) != 0 {
                let nxt_m: *const AstItem = unsafe { (*m).next as *const AstItem };
                let m_limit: u32 = if (nxt_m as usize) != 0 { unsafe { (*nxt_m).span.start } } else { close_b };
                let m_kind: u8 = unsafe { (*m).kind };
                let m_has_body: bool = m_kind == ITEM_FN && (unsafe { (*m).body } as usize) != 0;
                let has_blank: bool = !first_m && (cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_m_end, unsafe { (*m).span.start }) || prev_m_has_body || m_has_body || prev_m_kind != m_kind);
                let m_doc: u32 = fmt_print_item(view(*ctx), m, prev_m_end, m_limit);
                let sep: u32 = if first_m {
                    fmt_hl(view(*ctx))
                } else if has_blank {
                    fmt_bl(view(*ctx))
                } else {
                    fmt_hl(view(*ctx))
                };
                mems_doc = fmt_cat3(view(*ctx), mems_doc, sep, m_doc);
                first_m = false;
                prev_m_end = m_limit;
                prev_m_kind = m_kind;
                prev_m_has_body = m_has_body;
                m = nxt_m;
            }
            let dang: u32 = fmt_emit_dangling_in_range(view(*ctx), prev_m_end, close_b);
            if dang != 0u32 {
                mems_doc = fmt_cat3(view(*ctx), mems_doc, fmt_hl(view(*ctx)), dang);
            }
            core = fmt_cat5(view(*ctx), hdr, open_br, fmt_ind(view(*ctx), mems_doc), fmt_hl(view(*ctx)), close_br);
        }
    }

    let trail_end: u32 = if limit_byte > 0u32 { limit_byte - 1u32 } else { unsafe { (*item).span.end } };
    let trail: u32 = fmt_emit_trailing_for_range(view(*ctx), item_start, trail_end);
    fmt_cat5(view(*ctx), lead_non_doc, lead_odoc, attrs_doc, core, trail)
}

fn fmt_get_item(base: *mut usize, idx: usize) -> *const AstItem {
    unsafe { (*(base + idx)) as *const AstItem }
}

fn fmt_set_item(base: *mut usize, idx: usize, it: *const AstItem) {
    unsafe { *(base + idx) = it as usize; }
}

fn fmt_cmp_use_item(interner: view<StrInterner>, a: *const AstItem, b: *const AstItem) -> i32 {
    let va: u8 = unsafe { (*a).vis.kind };
    let vb: u8 = unsafe { (*b).vis.kind };
    if va < vb {
        return -1;
    }
    if va > vb {
        return 1;
    }
    fmt_cmp_use_tree(interner, unsafe { (*a).use_tree as *const AstUseTree }, unsafe { (*b).use_tree as *const AstUseTree })
}

// AXS-FMT-020 / AXS-FMT-021: Prints an entire Axiom module AST + CST into a root `DocId`.
pub fn fmt_print_module(ctx: view<FmtCtx>, ast: view<Ast>) -> u32 {
    let mut doc: u32 = fmt_emit_header_trivia(view(*ctx));
    let mut has_output: bool = doc != 0u32;

    // Collect all non-synthetic top-level items.
    let mut count: usize = 0;
    let mut cur: *const AstItem = ast.items as *const AstItem;
    let mut is_first: bool = true;
    while (cur as usize) != 0 {
        if !cst_is_synthetic_item(cur, unsafe { (*ctx.cst).file_id }, is_first) {
            is_first = false;
            count = count + 1;
        }
        cur = unsafe { (*cur).next as *const AstItem };
    }

    let items_arr: *mut usize = arena_alloc_raw(
        unsafe { mut_view(*ctx.arena) },
        (count + 1) * size_of<usize>(),
        align_of<usize>()
    ) as *mut usize;
    let mut w: usize = 0;
    cur = ast.items as *const AstItem;
    is_first = true;
    while (cur as usize) != 0 {
        if !cst_is_synthetic_item(cur, unsafe { (*ctx.cst).file_id }, is_first) {
            is_first = false;
            fmt_set_item(items_arr, w, cur);
            w = w + 1;
        }
        cur = unsafe { (*cur).next as *const AstItem };
    }

    let src_len_u32: u32 = unsafe { (*ctx.cst).src.len as u32 };
    let mut idx: usize = 0;
    let mut prev_end_byte: u32 = 0u32;
    let mut prev_kind: u8 = 0u8;

    while idx < count {
        let it: *const AstItem = fmt_get_item(items_arr, idx);
        let it_kind: u8 = unsafe { (*it).kind };
        let next_start: u32 = if idx + 1 < count {
            let nxt_it: *const AstItem = fmt_get_item(items_arr, idx + 1);
            unsafe { (*nxt_it).span.start }
        } else {
            src_len_u32
        };

        // Check if `it` starts a barrier-free sortable `use` group (AXS-FMT-021).
        if it_kind == ITEM_USE && (unsafe { (*it).attrs } as usize) == 0 {
            let it_start: u32 = unsafe { (*it).span.start };
            let mut pre_use_had_blank_after: bool = false;
            let mut emitted_pre_use_trivia: bool = false;
            // If there is leading trivia before `it` (e.g. `// #region`), emit it before the `use` group.
            if fmt_has_any_trivia_in_range(unsafe { view(*ctx.cst) }, prev_end_byte, it_start + 1u32) {
                let tight_reg: bool = fmt_starts_with_tight_region_end(unsafe { view(*ctx.cst) }, prev_end_byte, it_start);
                let had_blk_before: bool = idx > 0 && cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_end_byte, it_start);
                let mut i_tr: usize = 0;
                while i_tr < unsafe { (*ctx.cst).trivia_count } {
                    let tr: *mut CstTrivia = cst_trivia_ptr(unsafe { (*ctx.cst).trivia }, i_tr);
                    if !unsafe { (*tr).emitted } && unsafe { (*tr).slot } == SLOT_LEADING &&
                            unsafe { (*tr).anchor_byte } >= prev_end_byte && unsafe { (*tr).anchor_byte } <= it_start {
                        pre_use_had_blank_after = unsafe { (*tr).has_blank_after };
                    }
                    i_tr = i_tr + 1;
                }
                let lead_only: u32 = fmt_emit_dangling_in_range(view(*ctx), prev_end_byte, it_start + 1u32);
                if lead_only != 0u32 {
                    if !has_output {
                        doc = lead_only;
                        has_output = true;
                    } else {
                        let l_sep: u32 = if (prev_kind == ITEM_USE && !had_blk_before) || tight_reg {
                            fmt_hl(view(*ctx))
                        } else {
                            fmt_bl(view(*ctx))
                        };
                        doc = fmt_cat3(view(*ctx), doc, l_sep, lead_only);
                    }
                    prev_end_byte = it_start;
                    emitted_pre_use_trivia = true;
                }
            }

            if !fmt_has_any_trivia_in_range(unsafe { view(*ctx.cst) }, prev_end_byte, next_start) {
                let grp_start: usize = idx;
                let mut grp_end: usize = idx + 1;
                let mut g_prev_start: u32 = it_start;
                let mut g_prev_end: u32 = unsafe { (*it).span.end };
                while grp_end < count {
                    let cand: *const AstItem = fmt_get_item(items_arr, grp_end);
                    let cand_start: u32 = unsafe { (*cand).span.start };
                    let cand_next_start: u32 = if grp_end + 1 < count {
                        let cand_nxt: *const AstItem = fmt_get_item(items_arr, grp_end + 1);
                        unsafe { (*cand_nxt).span.start }
                    } else {
                        src_len_u32
                    };
                    if unsafe { (*cand).kind } != ITEM_USE || (unsafe { (*cand).attrs } as usize) != 0 {
                        break;
                    }
                    if cst_has_blank_line_between(unsafe { (*ctx.cst).src }, g_prev_start, cand_start) {
                        break;
                    }
                    if fmt_has_any_trivia_in_range(unsafe { view(*ctx.cst) }, g_prev_end, cand_next_start) {
                        break;
                    }
                    g_prev_start = cand_start;
                    g_prev_end = unsafe { (*cand).span.end };
                    grp_end = grp_end + 1;
                }

                // Canonicalize each `use_tree` in `[grp_start, grp_end)` and insertion-sort the slice.
                let mut gi: usize = grp_start;
                while gi < grp_end {
                    let u_it: *const AstItem = fmt_get_item(items_arr, gi);
                    fmt_canonicalize_use_tree(unsafe { mut_view(*ctx.arena) }, unsafe { view(*ctx.interner) }, unsafe { (*u_it).use_tree });
                    gi = gi + 1;
                }
                gi = grp_start + 1;
                while gi < grp_end {
                    let key_it: *const AstItem = fmt_get_item(items_arr, gi);
                    let mut gj: usize = gi;
                    while gj > grp_start {
                        let prev_it: *const AstItem = fmt_get_item(items_arr, gj - 1);
                        if fmt_cmp_use_item(unsafe { view(*ctx.interner) }, prev_it, key_it) > 0 {
                            fmt_set_item(items_arr, gj, prev_it);
                            gj = gj - 1;
                        } else {
                            break;
                        }
                    }
                    fmt_set_item(items_arr, gj, key_it);
                    gi = gi + 1;
                }

                // Emit sorted `use` group.
                gi = grp_start;
                while gi < grp_end {
                    let u_it: *const AstItem = fmt_get_item(items_arr, gi);
                    let u_vis: u32 = fmt_print_vis(view(*ctx), unsafe { view((*u_it).vis) });
                    let u_kw: u32 = fmt_tbl(view(*ctx), 7, 4);
                    let u_tree: u32 = fmt_print_use_tree(view(*ctx), unsafe { (*u_it).use_tree as *const AstUseTree });
                    let u_doc: u32 = fmt_cat3(view(*ctx), u_vis, u_kw, u_tree);
                    if !has_output {
                        doc = u_doc;
                        has_output = true;
                    } else if gi == grp_start && emitted_pre_use_trivia && !pre_use_had_blank_after {
                        doc = fmt_cat3(view(*ctx), doc, fmt_hl(view(*ctx)), u_doc);
                    } else if gi == grp_start {
                        doc = fmt_cat3(view(*ctx), doc, fmt_bl(view(*ctx)), u_doc);
                    } else {
                        doc = fmt_cat3(view(*ctx), doc, fmt_hl(view(*ctx)), u_doc);
                    }
                    gi = gi + 1;
                }
                prev_end_byte = g_prev_end;
                prev_kind = ITEM_USE;
                idx = grp_end;
                continue;
            }
        }

        let had_blank: bool = idx > 0 && cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_end_byte, unsafe { (*it).span.start });
        let tight_reg_end: bool = fmt_starts_with_tight_region_end(unsafe { view(*ctx.cst) }, prev_end_byte, unsafe { (*it).span.start });
        let it_doc: u32 = fmt_print_item(view(*ctx), it, prev_end_byte, next_start);
        if !has_output {
            doc = it_doc;
            has_output = true;
        } else {
            // AXS-FMT-022: Top-level items separated by 1 blank line, except adjacent `use` or
            // adjacent `const`/`static`/`type` items that had no blank line in source, or tight `#endregion`.
            let same_compact_group: bool = ((it_kind == prev_kind) &&
                (it_kind == ITEM_USE || it_kind == ITEM_CONST || it_kind == ITEM_STATIC || it_kind == ITEM_TYPE_ALIAS) &&
                !had_blank) || tight_reg_end;
            let sep: u32 = if same_compact_group { fmt_hl(view(*ctx)) } else { fmt_bl(view(*ctx)) };
            doc = fmt_cat3(view(*ctx), doc, sep, it_doc);
        }
        prev_end_byte = next_start;
        prev_kind = it_kind;
        idx = idx + 1;
    }

    // Emit any remaining EOF dangling comments (Slot 5 / Conservation invariant).
    let eof_dang: u32 = fmt_emit_dangling_in_range(view(*ctx), 0u32, src_len_u32 + 1u32);
    if eof_dang != 0u32 {
        if !has_output {
            doc = eof_dang;
        } else {
            let sep: u32 = if cst_has_blank_line_between(unsafe { (*ctx.cst).src }, prev_end_byte, src_len_u32) {
                fmt_bl(view(*ctx))
            } else {
                fmt_hl(view(*ctx))
            };
            doc = fmt_cat3(view(*ctx), doc, sep, eof_dang);
        }
    }
    doc
}

// AXS-FMT-032: Formats `src` into `out_buf` (with trailing `\n` for non-empty output, or `""` for empty files).
// Returns `true` if `src` lexed and parsed with 0 errors and all comments were conserved.
pub fn fmt_format_source(src: StrView, out_buf: mut_view<DiagBuffer>) -> bool {
    let mut arena = arena_new();
    let mut interner = interner_new();
    let mut sink: DiagSink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    };
    diag_sink_init(mut_view(sink));
    let mut lex_res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let mut parse_res = ParseResult { ast: Ast { items: 0 as *mut AstItem } };
    let mut cf = cst_parse_and_build(
        mut_view(arena),
        mut_view(interner),
        mut_view(sink),
        FileId { v: 1u32 },
        src,
        mut_view(lex_res),
        mut_view(parse_res)
    );

    if sink.errors > 0 {
        ax_lex_result_free(mut_view(lex_res));
        diag_sink_free(mut_view(sink));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return false;
    }

    let mut eng = DocEngine {
        arena: 0 as *mut Arena,
        nodes: 0 as *mut DocNode,
        count: 0,
        cap: 0,
    };
    doc_engine_init(mut_view(eng), mut_view(arena), 1024);
    let mut ctx = FmtCtx {
        arena: unsafe { address_of_mut<Arena>(arena) },
        interner: unsafe { address_of<StrInterner>(interner) },
        cst: unsafe { address_of_mut<CstFile>(cf) },
        eng: unsafe { address_of_mut<DocEngine>(eng) },
    };

    let root_doc = fmt_print_module(view(ctx), view(parse_res.ast));
    out_buf.len = 0;
    doc_render_to_buf(view(eng), root_doc, FMT_MAX_WIDTH, mut_view(*out_buf));
    if out_buf.len > 0 {
        diag_buf_push_byte(mut_view(*out_buf), 10u8);
    }

    ax_lex_result_free(mut_view(lex_res));
    diag_sink_free(mut_view(sink));
    interner_free(mut_view(interner));
    arena_destroy(mut_view(arena));
    true
}
