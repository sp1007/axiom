pub const FMT_VERIFY_OK: u8 = 0u8
pub const FMT_VERIFY_ERR_SYNTAX: u8 = 1u8
pub const FMT_VERIFY_ERR_REPARSE: u8 = 2u8
pub const FMT_VERIFY_ERR_COMMENTS: u8 = 3u8
pub const FMT_VERIFY_ERR_AST_MISMATCH: u8 = 4u8
pub const FMT_VERIFY_ERR_IDEMPOTENCE: u8 = 5u8

@derive(Copy)
pub struct FmtVerifyStats {
    pub status: u8,
    pub exit_code: i32,
    pub is_already_canonical: bool,
    pub orig_comment_count: u32,
    pub fmt_comment_count: u32,
    pub unemitted_comment_count: u32,
    pub orig_item_count: u32,
    pub fmt_item_count: u32,
    pub comments_conserved: bool,
    pub ast_equivalent: bool,
    pub idempotent: bool,
}

pub fn fmt_verify_stats_empty() -> FmtVerifyStats {
    FmtVerifyStats {
        status: FMT_VERIFY_OK,
        exit_code: 0,
        is_already_canonical: false,
        orig_comment_count: 0u32,
        fmt_comment_count: 0u32,
        unemitted_comment_count: 0u32,
        orig_item_count: 0u32,
        fmt_item_count: 0u32,
        comments_conserved: false,
        ast_equivalent: false,
        idempotent: false,
    }
}

pub fn fmt_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len {
        return false;
    }
    if a.len == 0 {
        return true;
    }
    if (a.ptr as usize) == 0 || (b.ptr as usize) == 0 {
        return (a.ptr as usize) == (b.ptr as usize);
    }
    let mut i: usize = 0;
    while i < a.len {
        if (unsafe { *(a.ptr + i) }) != (unsafe { *(b.ptr + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

struct AstEquivCtx {
    interner_a: *const StrInterner,
    interner_b: *const StrInterner,
    src_a: StrView,
    src_b: StrView,
    file_a: FileId,
    file_b: FileId,
}

fn eq_strid(ctx: view<AstEquivCtx>, a: StrId, b: StrId) -> bool {
    if a.v == 0u32 && b.v == 0u32 {
        return true;
    }
    if a.v == 0u32 || b.v == 0u32 {
        return false;
    }
    if (ctx.interner_a as usize) == (ctx.interner_b as usize) && a.v == b.v {
        return true;
    }
    let sa: StrView = interner_get(unsafe { view(*ctx.interner_a) }, a);
    let sb: StrView = interner_get(unsafe { view(*ctx.interner_b) }, b);
    fmt_sv_eq(sa, sb)
}

fn eq_dotted_name(ctx: view<AstEquivCtx>, a: view<AstDottedName>, b: view<AstDottedName>) -> bool {
    if a.count != b.count {
        return false;
    }
    let mut i: usize = 0;
    while i < a.count {
        let sa: StrId = unsafe { *(cst_strid_ptr(a.segments, i)) };
        let sb: StrId = unsafe { *(cst_strid_ptr(b.segments, i)) };
        if !eq_strid(ctx, sa, sb) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn norm_base_prefix_byte(b0: u8, b1: u8) -> u8 {
    if b0 == 48u8 && (b1 == 88u8 || b1 == 66u8 || b1 == 79u8) {
        return b1 + 32u8;
    }
    b1
}

// AXS-FMT-029: Verifies literal tokens match in kind, suffix, value, and source spelling
// (modulo `0X`/`0B`/`0O` lowercase base prefix normalization).
fn eq_literal_tok(ctx: view<AstEquivCtx>, ta: view<Token>, tb: view<Token>) -> bool {
    if ta.kind != tb.kind || ta.suffix != tb.suffix || ta.int_val != tb.int_val {
        return false;
    }
    let sa_start: usize = ta.span.start as usize;
    let sa_end: usize = ta.span.end as usize;
    let sb_start: usize = tb.span.start as usize;
    let sb_end: usize = tb.span.end as usize;
    if (ctx.src_a.ptr as usize) != 0 && (ctx.src_b.ptr as usize) != 0 &&
            sa_end >= sa_start && sa_end <= ctx.src_a.len &&
            sb_end >= sb_start && sb_end <= ctx.src_b.len {
        let len_a: usize = sa_end - sa_start;
        let len_b: usize = sb_end - sb_start;
        if len_a != len_b {
            return false;
        }
        let is_num: bool = ta.kind == TOK_INT || ta.kind == TOK_FLOAT;
        let b0_a: u8 = if len_a > 0 { unsafe { *(ctx.src_a.ptr + sa_start) } } else { 0u8 };
        let b0_b: u8 = if len_b > 0 { unsafe { *(ctx.src_b.ptr + sb_start) } } else { 0u8 };
        let mut i: usize = 0;
        while i < len_a {
            let mut ba: u8 = unsafe { *(ctx.src_a.ptr + sa_start + i) };
            let mut bb: u8 = unsafe { *(ctx.src_b.ptr + sb_start + i) };
            if is_num && i == 1 {
                ba = norm_base_prefix_byte(b0_a, ba);
                bb = norm_base_prefix_byte(b0_b, bb);
            }
            if ba != bb {
                return false;
            }
            i = i + 1;
        }
    }
    true
}
fn is_derive_attr(interner: *const StrInterner, id: StrId) -> bool {
    if id.v == 0u32 || (interner as usize) == 0 {
        return false;
    }
    let sv: StrView = interner_get(unsafe { view(*interner) }, id);
    if sv.len != 6 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 100u8 && *(sv.ptr + 1) == 101u8 && *(sv.ptr + 2) == 114u8 &&
            *(sv.ptr + 3) == 105u8 && *(sv.ptr + 4) == 118u8 && *(sv.ptr + 5) == 101u8
    }
}

fn next_filtered_attr(interner: *const StrInterner, start: *const AstAttr, want_derive: bool) -> *const AstAttr {
    let mut cur: *const AstAttr = start;
    while (cur as usize) != 0 {
        let is_d: bool = is_derive_attr(interner, unsafe { (*cur).name });
        if is_d == want_derive {
            return cur;
        }
        cur = unsafe { (*cur).next as *const AstAttr };
    }
    0 as *const AstAttr
}

fn eq_single_attr(ctx: view<AstEquivCtx>, a: *const AstAttr, b: *const AstAttr) -> bool {
    if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
        return false;
    }
    let mut aa: *const AstAttrArg = unsafe { (*a).args as *const AstAttrArg };
    let mut ab: *const AstAttrArg = unsafe { (*b).args as *const AstAttrArg };
    while (aa as usize) != 0 && (ab as usize) != 0 {
        if !eq_strid(ctx, unsafe { (*aa).name }, unsafe { (*ab).name }) {
            return false;
        }
        if !eq_expr(ctx, unsafe { (*aa).expr as *const AstExpr }, unsafe { (*ab).expr as *const AstExpr }) {
            return false;
        }
        aa = unsafe { (*aa).next as *const AstAttrArg };
        ab = unsafe { (*ab).next as *const AstAttrArg };
    }
    (aa as usize) == 0 && (ab as usize) == 0
}

// AXS-FMT-022: Compares `@attribute` lists modulo `@repr` before `@derive` canonical ordering.
fn eq_attrs(ctx: view<AstEquivCtx>, head_a: *const AstAttr, head_b: *const AstAttr) -> bool {
    // Pass 1: non-`@derive` attributes.
    let mut ca: *const AstAttr = next_filtered_attr(ctx.interner_a, head_a, false);
    let mut cb: *const AstAttr = next_filtered_attr(ctx.interner_b, head_b, false);
    while (ca as usize) != 0 && (cb as usize) != 0 {
        if !eq_single_attr(ctx, ca, cb) {
            return false;
        }
        ca = next_filtered_attr(ctx.interner_a, unsafe { (*ca).next as *const AstAttr }, false);
        cb = next_filtered_attr(ctx.interner_b, unsafe { (*cb).next as *const AstAttr }, false);
    }
    if (ca as usize) != 0 || (cb as usize) != 0 {
        return false;
    }

    // Pass 2: `@derive` attributes.
    ca = next_filtered_attr(ctx.interner_a, head_a, true);
    cb = next_filtered_attr(ctx.interner_b, head_b, true);
    while (ca as usize) != 0 && (cb as usize) != 0 {
        if !eq_single_attr(ctx, ca, cb) {
            return false;
        }
        ca = next_filtered_attr(ctx.interner_a, unsafe { (*ca).next as *const AstAttr }, true);
        cb = next_filtered_attr(ctx.interner_b, unsafe { (*cb).next as *const AstAttr }, true);
    }
    (ca as usize) == 0 && (cb as usize) == 0
}

fn eq_generic_args(ctx: view<AstEquivCtx>, ga: *const AstGenericArgs, gb: *const AstGenericArgs) -> bool {
    let mut a: *const AstGenericArg = if (ga as usize) != 0 { unsafe { (*ga).args as *const AstGenericArg } } else { 0 as *const AstGenericArg };
    let mut b: *const AstGenericArg = if (gb as usize) != 0 { unsafe { (*gb).args as *const AstGenericArg } } else { 0 as *const AstGenericArg };
    while (a as usize) != 0 && (b as usize) != 0 {
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).ty as *const AstType }, unsafe { (*b).ty as *const AstType }) {
            return false;
        }
        a = unsafe { (*a).next as *const AstGenericArg };
        b = unsafe { (*b).next as *const AstGenericArg };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn eq_generic_params(ctx: view<AstEquivCtx>, gpa: *const AstGenericParams, gpb: *const AstGenericParams) -> bool {
    let mut a: *const AstGenericParam = if (gpa as usize) != 0 { unsafe { (*gpa).params as *const AstGenericParam } } else { 0 as *const AstGenericParam };
    let mut b: *const AstGenericParam = if (gpb as usize) != 0 { unsafe { (*gpb).params as *const AstGenericParam } } else { 0 as *const AstGenericParam };
    while (a as usize) != 0 && (b as usize) != 0 {
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).bounds as *const AstType }, unsafe { (*b).bounds as *const AstType }) {
            return false;
        }
        a = unsafe { (*a).next as *const AstGenericParam };
        b = unsafe { (*b).next as *const AstGenericParam };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn eq_where_clause(ctx: view<AstEquivCtx>, wca: *const AstWhereClause, wcb: *const AstWhereClause) -> bool {
    let mut a: *const AstWherePred = if (wca as usize) != 0 { unsafe { (*wca).preds as *const AstWherePred } } else { 0 as *const AstWherePred };
    let mut b: *const AstWherePred = if (wcb as usize) != 0 { unsafe { (*wcb).preds as *const AstWherePred } } else { 0 as *const AstWherePred };
    while (a as usize) != 0 && (b as usize) != 0 {
        if !eq_type_list(ctx, unsafe { (*a).ty as *const AstType }, unsafe { (*b).ty as *const AstType }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).bounds as *const AstType }, unsafe { (*b).bounds as *const AstType }) {
            return false;
        }
        a = unsafe { (*a).next as *const AstWherePred };
        b = unsafe { (*b).next as *const AstWherePred };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn eq_path_segs(ctx: view<AstEquivCtx>, sa: *const AstTypePathSegment, sb: *const AstTypePathSegment) -> bool {
    let mut a: *const AstTypePathSegment = sa;
    let mut b: *const AstTypePathSegment = sb;
    while (a as usize) != 0 && (b as usize) != 0 {
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_generic_args(ctx, unsafe { (*a).generic_args as *const AstGenericArgs }, unsafe { (*b).generic_args as *const AstGenericArgs }) {
            return false;
        }
        a = unsafe { (*a).next as *const AstTypePathSegment };
        b = unsafe { (*b).next as *const AstTypePathSegment };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn eq_type_list(ctx: view<AstEquivCtx>, ta: *const AstType, tb: *const AstType) -> bool {
    let mut a: *const AstType = ta;
    let mut b: *const AstType = tb;
    while (a as usize) != 0 && (b as usize) != 0 {
        let ka: u8 = unsafe { (*a).kind };
        let kb: u8 = unsafe { (*b).kind };
        if ka != kb {
            return false;
        }
        let k: u8 = ka & 127u8;
        if k == TYPE_PATH {
            if !eq_path_segs(ctx, unsafe { (*a).segments as *const AstTypePathSegment }, unsafe { (*b).segments as *const AstTypePathSegment }) {
                return false;
            }
        } else if k == TYPE_TUPLE {
            if !eq_type_list(ctx, unsafe { (*a).elem_types as *const AstType }, unsafe { (*b).elem_types as *const AstType }) {
                return false;
            }
        } else if k == TYPE_ARRAY {
            if !eq_expr(ctx, unsafe { (*a).count_expr as *const AstExpr }, unsafe { (*b).count_expr as *const AstExpr }) {
                return false;
            }
            if !eq_type_list(ctx, unsafe { (*a).elem as *const AstType }, unsafe { (*b).elem as *const AstType }) {
                return false;
            }
        } else if k == TYPE_SLICE {
            if !eq_type_list(ctx, unsafe { (*a).elem as *const AstType }, unsafe { (*b).elem as *const AstType }) {
                return false;
            }
        } else if k == TYPE_VIEW || k == TYPE_PTR {
            if (unsafe { (*a).is_mut }) != (unsafe { (*b).is_mut }) {
                return false;
            }
            if !eq_type_list(ctx, unsafe { (*a).elem as *const AstType }, unsafe { (*b).elem as *const AstType }) {
                return false;
            }
        } else if k == TYPE_FN {
            if (unsafe { (*a).is_unsafe }) != (unsafe { (*b).is_unsafe }) {
                return false;
            }
            if !eq_strid(ctx, unsafe { (*a).abi }, unsafe { (*b).abi }) {
                return false;
            }
            if !eq_type_list(ctx, unsafe { (*a).param_types as *const AstType }, unsafe { (*b).param_types as *const AstType }) {
                return false;
            }
            if !eq_type_list(ctx, unsafe { (*a).ret_type as *const AstType }, unsafe { (*b).ret_type as *const AstType }) {
                return false;
            }
        } else if k == TYPE_DYN {
            if !eq_type_list(ctx, unsafe { (*a).bounds as *const AstType }, unsafe { (*b).bounds as *const AstType }) {
                return false;
            }
        }
        a = unsafe { (*a).next as *const AstType };
        b = unsafe { (*b).next as *const AstType };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn eq_pat_list(ctx: view<AstEquivCtx>, pa: *const AstPat, pb: *const AstPat) -> bool {
    let mut a: *const AstPat = pa;
    let mut b: *const AstPat = pb;
    while (a as usize) != 0 && (b as usize) != 0 {
        let k: u8 = unsafe { (*a).kind };
        if k != (unsafe { (*b).kind }) {
            return false;
        }
        if k == PAT_RANGE {
            if (unsafe { (*a).is_inclusive }) != (unsafe { (*b).is_inclusive }) {
                return false;
            }
            if !eq_pat_list(ctx, unsafe { (*a).start_pat as *const AstPat }, unsafe { (*b).start_pat as *const AstPat }) {
                return false;
            }
            if !eq_pat_list(ctx, unsafe { (*a).end_pat as *const AstPat }, unsafe { (*b).end_pat as *const AstPat }) {
                return false;
            }
        } else if k == PAT_LITERAL {
            if (unsafe { (*a).is_negated }) != (unsafe { (*b).is_negated }) {
                return false;
            }
            if !eq_literal_tok(ctx, unsafe { view((*a).tok) }, unsafe { view((*b).tok) }) {
                return false;
            }
        } else if k == PAT_BINDING {
            if (unsafe { (*a).is_mut }) != (unsafe { (*b).is_mut }) {
                return false;
            }
            if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
                return false;
            }
        } else if k == PAT_PATH {
            if !eq_path_segs(ctx, unsafe { (*a).segments as *const AstTypePathSegment }, unsafe { (*b).segments as *const AstTypePathSegment }) {
                return false;
            }
            if !eq_pat_list(ctx, unsafe { (*a).payload as *const AstPat }, unsafe { (*b).payload as *const AstPat }) {
                return false;
            }
        } else if k == PAT_TUPLE {
            if !eq_pat_list(ctx, unsafe { (*a).elems as *const AstPat }, unsafe { (*b).elems as *const AstPat }) {
                return false;
            }
        } else if k == PAT_OR {
            if !eq_pat_list(ctx, unsafe { (*a).pats as *const AstPat }, unsafe { (*b).pats as *const AstPat }) {
                return false;
            }
        } else if k == PAT_STRUCT {
            if !eq_path_segs(ctx, unsafe { (*a).segments as *const AstTypePathSegment }, unsafe { (*b).segments as *const AstTypePathSegment }) {
                return false;
            }
            if (unsafe { (*a).has_rest }) != (unsafe { (*b).has_rest }) {
                return false;
            }
            let mut fa: *const AstPatField = unsafe { (*a).fields as *const AstPatField };
            let mut fb: *const AstPatField = unsafe { (*b).fields as *const AstPatField };
            while (fa as usize) != 0 && (fb as usize) != 0 {
                if !eq_strid(ctx, unsafe { (*fa).name }, unsafe { (*fb).name }) {
                    return false;
                }
                if !eq_pat_list(ctx, unsafe { (*fa).pat as *const AstPat }, unsafe { (*fb).pat as *const AstPat }) {
                    return false;
                }
                fa = unsafe { (*fa).next as *const AstPatField };
                fb = unsafe { (*fb).next as *const AstPatField };
            }
            if (fa as usize) != 0 || (fb as usize) != 0 {
                return false;
            }
        }
        a = unsafe { (*a).next as *const AstPat };
        b = unsafe { (*b).next as *const AstPat };
    }
    (a as usize) == 0 && (b as usize) == 0
}
fn eq_params(ctx: view<AstEquivCtx>, pa: *const AstParam, pb: *const AstParam) -> bool {
    let mut a: *const AstParam = pa;
    let mut b: *const AstParam = pb;
    while (a as usize) != 0 && (b as usize) != 0 {
        if (unsafe { (*a).is_mut }) != (unsafe { (*b).is_mut }) {
            return false;
        }
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).ty as *const AstType }, unsafe { (*b).ty as *const AstType }) {
            return false;
        }
        a = unsafe { (*a).next as *const AstParam };
        b = unsafe { (*b).next as *const AstParam };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn eq_field_decls(ctx: view<AstEquivCtx>, fa: *const AstFieldDecl, fb: *const AstFieldDecl) -> bool {
    let mut a: *const AstFieldDecl = fa;
    let mut b: *const AstFieldDecl = fb;
    while (a as usize) != 0 && (b as usize) != 0 {
        if !eq_attrs(ctx, unsafe { (*a).attrs as *const AstAttr }, unsafe { (*b).attrs as *const AstAttr }) {
            return false;
        }
        if (unsafe { (*a).vis.kind }) != (unsafe { (*b).vis.kind }) {
            return false;
        }
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).ty as *const AstType }, unsafe { (*b).ty as *const AstType }) {
            return false;
        }
        a = unsafe { (*a).next as *const AstFieldDecl };
        b = unsafe { (*b).next as *const AstFieldDecl };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn eq_variants(ctx: view<AstEquivCtx>, va: *const AstVariantDecl, vb: *const AstVariantDecl) -> bool {
    let mut a: *const AstVariantDecl = va;
    let mut b: *const AstVariantDecl = vb;
    while (a as usize) != 0 && (b as usize) != 0 {
        if !eq_attrs(ctx, unsafe { (*a).attrs as *const AstAttr }, unsafe { (*b).attrs as *const AstAttr }) {
            return false;
        }
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        let sa: bool = unsafe { (*a).is_struct };
        if sa != (unsafe { (*b).is_struct }) {
            return false;
        }
        if sa {
            if !eq_field_decls(ctx, unsafe { (*a).struct_fields as *const AstFieldDecl }, unsafe { (*b).struct_fields as *const AstFieldDecl }) {
                return false;
            }
        } else {
            if !eq_type_list(ctx, unsafe { (*a).tuple_types as *const AstType }, unsafe { (*b).tuple_types as *const AstType }) {
                return false;
            }
        }
        a = unsafe { (*a).next as *const AstVariantDecl };
        b = unsafe { (*b).next as *const AstVariantDecl };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn unwrap_paren_expr(e: *const AstExpr) -> *const AstExpr {
    let mut cur: *const AstExpr = e;
    while (cur as usize) != 0 && (unsafe { (*cur).kind & 127u8 }) == EXPR_PAREN {
        cur = unsafe { (*cur).inner as *const AstExpr };
    }
    cur
}

fn eq_expr_list(ctx: view<AstEquivCtx>, ea: *const AstExpr, eb: *const AstExpr) -> bool {
    let mut a: *const AstExpr = ea;
    let mut b: *const AstExpr = eb;
    while (a as usize) != 0 && (b as usize) != 0 {
        if !eq_expr(ctx, a, b) {
            return false;
        }
        a = unsafe { (*a).next as *const AstExpr };
        b = unsafe { (*b).next as *const AstExpr };
    }
    (a as usize) == 0 && (b as usize) == 0
}

fn eq_expr(ctx: view<AstEquivCtx>, raw_a: *const AstExpr, raw_b: *const AstExpr) -> bool {
    let a: *const AstExpr = unwrap_paren_expr(raw_a);
    let b: *const AstExpr = unwrap_paren_expr(raw_b);
    if (a as usize) == 0 && (b as usize) == 0 {
        return true;
    }
    if (a as usize) == 0 || (b as usize) == 0 {
        return false;
    }
    let ka_full: u8 = unsafe { (*a).kind };
    let kb_full: u8 = unsafe { (*b).kind };
    if (ka_full & 128u8) != (kb_full & 128u8) {
        return false;
    }
    let k: u8 = ka_full & 127u8;
    if k != (kb_full & 127u8) {
        return false;
    }

    if k == EXPR_LITERAL {
        return eq_literal_tok(ctx, unsafe { view((*a).literal) }, unsafe { view((*b).literal) });
    }
    if k == EXPR_PATH {
        return eq_path_segs(ctx, unsafe { (*a).segments as *const AstTypePathSegment }, unsafe { (*b).segments as *const AstTypePathSegment });
    }
    if k == EXPR_TUPLE {
        return eq_expr_list(ctx, unsafe { (*a).elems as *const AstExpr }, unsafe { (*b).elems as *const AstExpr });
    }
    if k == EXPR_ARRAY {
        if !eq_expr_list(ctx, unsafe { (*a).elems as *const AstExpr }, unsafe { (*b).elems as *const AstExpr }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).count_expr as *const AstExpr }, unsafe { (*b).count_expr as *const AstExpr });
    }
    if k == EXPR_STRUCT {
        if !eq_path_segs(ctx, unsafe { (*a).segments as *const AstTypePathSegment }, unsafe { (*b).segments as *const AstTypePathSegment }) {
            return false;
        }
        let mut fa: *const AstFieldInit = unsafe { (*a).fields as *const AstFieldInit };
        let mut fb: *const AstFieldInit = unsafe { (*b).fields as *const AstFieldInit };
        while (fa as usize) != 0 && (fb as usize) != 0 {
            if !eq_strid(ctx, unsafe { (*fa).name }, unsafe { (*fb).name }) {
                return false;
            }
            if !eq_expr(ctx, unsafe { (*fa).expr as *const AstExpr }, unsafe { (*fb).expr as *const AstExpr }) {
                return false;
            }
            fa = unsafe { (*fa).next as *const AstFieldInit };
            fb = unsafe { (*fb).next as *const AstFieldInit };
        }
        return (fa as usize) == 0 && (fb as usize) == 0;
    }
    if k == EXPR_BLOCK || k == EXPR_UNSAFE || k == EXPR_COMPTIME {
        return eq_block(ctx, unsafe { (*a).block as *const AstBlock }, unsafe { (*b).block as *const AstBlock });
    }
    if k == EXPR_IF {
        if !eq_pat_list(ctx, unsafe { (*a).let_pat as *const AstPat }, unsafe { (*b).let_pat as *const AstPat }) {
            return false;
        }
        if !eq_expr(ctx, unsafe { (*a).cond as *const AstExpr }, unsafe { (*b).cond as *const AstExpr }) {
            return false;
        }
        if !eq_block(ctx, unsafe { (*a).block as *const AstBlock }, unsafe { (*b).block as *const AstBlock }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).else_branch as *const AstExpr }, unsafe { (*b).else_branch as *const AstExpr });
    }
    if k == EXPR_MATCH {
        if !eq_expr(ctx, unsafe { (*a).cond as *const AstExpr }, unsafe { (*b).cond as *const AstExpr }) {
            return false;
        }
        let mut ma: *const AstMatchArm = unsafe { (*a).arms as *const AstMatchArm };
        let mut mb: *const AstMatchArm = unsafe { (*b).arms as *const AstMatchArm };
        while (ma as usize) != 0 && (mb as usize) != 0 {
            if !eq_pat_list(ctx, unsafe { (*ma).pat as *const AstPat }, unsafe { (*mb).pat as *const AstPat }) {
                return false;
            }
            if !eq_expr(ctx, unsafe { (*ma).guard as *const AstExpr }, unsafe { (*mb).guard as *const AstExpr }) {
                return false;
            }
            if !eq_expr(ctx, unsafe { (*ma).body as *const AstExpr }, unsafe { (*mb).body as *const AstExpr }) {
                return false;
            }
            ma = unsafe { (*ma).next as *const AstMatchArm };
            mb = unsafe { (*mb).next as *const AstMatchArm };
        }
        return (ma as usize) == 0 && (mb as usize) == 0;
    }
    if k == EXPR_LOOP {
        if !eq_strid(ctx, unsafe { (*a).label }, unsafe { (*b).label }) {
            return false;
        }
        return eq_block(ctx, unsafe { (*a).block as *const AstBlock }, unsafe { (*b).block as *const AstBlock });
    }
    if k == EXPR_WHILE {
        if !eq_strid(ctx, unsafe { (*a).label }, unsafe { (*b).label }) {
            return false;
        }
        if !eq_pat_list(ctx, unsafe { (*a).let_pat as *const AstPat }, unsafe { (*b).let_pat as *const AstPat }) {
            return false;
        }
        if !eq_expr(ctx, unsafe { (*a).cond as *const AstExpr }, unsafe { (*b).cond as *const AstExpr }) {
            return false;
        }
        return eq_block(ctx, unsafe { (*a).block as *const AstBlock }, unsafe { (*b).block as *const AstBlock });
    }
    if k == EXPR_FOR {
        if !eq_strid(ctx, unsafe { (*a).label }, unsafe { (*b).label }) {
            return false;
        }
        if !eq_pat_list(ctx, unsafe { (*a).pat as *const AstPat }, unsafe { (*b).pat as *const AstPat }) {
            return false;
        }
        if !eq_expr(ctx, unsafe { (*a).iter as *const AstExpr }, unsafe { (*b).iter as *const AstExpr }) {
            return false;
        }
        return eq_block(ctx, unsafe { (*a).block as *const AstBlock }, unsafe { (*b).block as *const AstBlock });
    }
    if k == EXPR_VIEW {
        if (unsafe { (*a).is_mut }) != (unsafe { (*b).is_mut }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).inner as *const AstExpr }, unsafe { (*b).inner as *const AstExpr });
    }
    if k == EXPR_JUMP {
        if (unsafe { (*a).jump_kind }) != (unsafe { (*b).jump_kind }) {
            return false;
        }
        if !eq_strid(ctx, unsafe { (*a).label }, unsafe { (*b).label }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).inner as *const AstExpr }, unsafe { (*b).inner as *const AstExpr });
    }
    if k == EXPR_CLOSURE {
        if !eq_params(ctx, unsafe { (*a).params as *const AstParam }, unsafe { (*b).params as *const AstParam }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).ret_type as *const AstType }, unsafe { (*b).ret_type as *const AstType }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).body as *const AstExpr }, unsafe { (*b).body as *const AstExpr });
    }
    if k == EXPR_RANGE {
        if (unsafe { (*a).is_inclusive }) != (unsafe { (*b).is_inclusive }) {
            return false;
        }
        if !eq_expr(ctx, unsafe { (*a).start_expr as *const AstExpr }, unsafe { (*b).start_expr as *const AstExpr }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).end_expr as *const AstExpr }, unsafe { (*b).end_expr as *const AstExpr });
    }
    if k == EXPR_BINARY {
        if (unsafe { (*a).op }) != (unsafe { (*b).op }) {
            return false;
        }
        if !eq_expr(ctx, unsafe { (*a).left as *const AstExpr }, unsafe { (*b).left as *const AstExpr }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).right as *const AstExpr }, unsafe { (*b).right as *const AstExpr });
    }
    if k == EXPR_UNARY {
        if (unsafe { (*a).op }) != (unsafe { (*b).op }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).inner as *const AstExpr }, unsafe { (*b).inner as *const AstExpr });
    }
    if k == EXPR_CAST {
        if !eq_expr(ctx, unsafe { (*a).inner as *const AstExpr }, unsafe { (*b).inner as *const AstExpr }) {
            return false;
        }
        return eq_type_list(ctx, unsafe { (*a).cast_ty as *const AstType }, unsafe { (*b).cast_ty as *const AstType });
    }
    if k == EXPR_POSTFIX {
        if !eq_expr(ctx, unsafe { (*a).head as *const AstExpr }, unsafe { (*b).head as *const AstExpr }) {
            return false;
        }
        let mut sa: *const AstPostfixSeg = unsafe { (*a).postfix_segs as *const AstPostfixSeg };
        let mut sb: *const AstPostfixSeg = unsafe { (*b).postfix_segs as *const AstPostfixSeg };
        while (sa as usize) != 0 && (sb as usize) != 0 {
            let sk: u8 = unsafe { (*sa).kind };
            if sk != (unsafe { (*sb).kind }) {
                return false;
            }
            if sk == POSTFIX_FIELD {
                if !eq_strid(ctx, unsafe { (*sa).name }, unsafe { (*sb).name }) {
                    return false;
                }
                if !eq_generic_args(ctx, unsafe { (*sa).generic_args as *const AstGenericArgs }, unsafe { (*sb).generic_args as *const AstGenericArgs }) {
                    return false;
                }
            } else if sk == POSTFIX_TUPLE_INDEX {
                if (unsafe { (*sa).tuple_index }) != (unsafe { (*sb).tuple_index }) {
                    return false;
                }
            } else if sk == POSTFIX_CALL {
                if !eq_expr_list(ctx, unsafe { (*sa).args as *const AstExpr }, unsafe { (*sb).args as *const AstExpr }) {
                    return false;
                }
            } else if sk == POSTFIX_INDEX {
                if !eq_expr(ctx, unsafe { (*sa).index_arg as *const AstExpr }, unsafe { (*sb).index_arg as *const AstExpr }) {
                    return false;
                }
            } else if sk == POSTFIX_ARROW {
                if !eq_strid(ctx, unsafe { (*sa).name }, unsafe { (*sb).name }) {
                    return false;
                }
            }
            sa = unsafe { (*sa).next as *const AstPostfixSeg };
            sb = unsafe { (*sb).next as *const AstPostfixSeg };
        }
        return (sa as usize) == 0 && (sb as usize) == 0;
    }
    true
}
fn is_empty_semi_stmt(st: *const AstStmt) -> bool {
    if (st as usize) == 0 {
        return false;
    }
    if (unsafe { (*st).kind }) != STMT_EXPR {
        return false;
    }
    let ex: *const AstExpr = unsafe { (*st).expr as *const AstExpr };
    if (ex as usize) == 0 {
        return true;
    }
    unsafe { ((*ex).kind & 127u8) == EXPR_ERROR && (*ex).span.start == 0u32 && (*ex).span.end == 0u32 }
}

fn next_real_stmt(st: *const AstStmt) -> *const AstStmt {
    let mut cur: *const AstStmt = st;
    while (cur as usize) != 0 {
        if !is_empty_semi_stmt(cur) {
            return cur;
        }
        cur = unsafe { (*cur).next as *const AstStmt };
    }
    0 as *const AstStmt
}

// AXS-FMT-025 & AXS-FMT-031(3): Compares statements and enforces that on the final statement
// of a block, `STMT_EXPR.has_semi` is preserved for all value-producing expressions.
fn eq_stmt(ctx: view<AstEquivCtx>, sa: *const AstStmt, sb: *const AstStmt, is_last_in_block: bool) -> bool {
    let k: u8 = unsafe { (*sa).kind };
    if k != (unsafe { (*sb).kind }) {
        return false;
    }
    if k == STMT_LET {
        if !eq_pat_list(ctx, unsafe { (*sa).pat as *const AstPat }, unsafe { (*sb).pat as *const AstPat }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*sa).ty as *const AstType }, unsafe { (*sb).ty as *const AstType }) {
            return false;
        }
        if !eq_expr(ctx, unsafe { (*sa).expr as *const AstExpr }, unsafe { (*sb).expr as *const AstExpr }) {
            return false;
        }
        return eq_block(ctx, unsafe { (*sa).else_block as *const AstBlock }, unsafe { (*sb).else_block as *const AstBlock });
    }
    if k == STMT_ASSIGN {
        if (unsafe { (*sa).op }) != (unsafe { (*sb).op }) {
            return false;
        }
        if !eq_expr(ctx, unsafe { (*sa).left as *const AstExpr }, unsafe { (*sb).left as *const AstExpr }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*sa).right as *const AstExpr }, unsafe { (*sb).right as *const AstExpr });
    }
    if k == STMT_EXPR {
        let ex_a: *const AstExpr = unwrap_paren_expr(unsafe { (*sa).expr as *const AstExpr });
        let ex_b: *const AstExpr = unwrap_paren_expr(unsafe { (*sb).expr as *const AstExpr });
        if !eq_expr(ctx, ex_a, ex_b) {
            return false;
        }
        if is_last_in_block {
            let ek: u8 = if (ex_a as usize) != 0 { unsafe { (*ex_a).kind & 127u8 } } else { EXPR_ERROR };
            let is_ctrl_or_jump: bool = ek == EXPR_JUMP || ek == EXPR_IF || ek == EXPR_MATCH ||
                ek == EXPR_LOOP || ek == EXPR_WHILE || ek == EXPR_FOR || ek == EXPR_BLOCK;
            if !is_ctrl_or_jump && (unsafe { (*sa).has_semi }) != (unsafe { (*sb).has_semi }) {
                return false;
            }
        }
        return true;
    }
    true
}

fn eq_block(ctx: view<AstEquivCtx>, ba: *const AstBlock, bb: *const AstBlock) -> bool {
    if (ba as usize) == 0 && (bb as usize) == 0 {
        return true;
    }
    if (ba as usize) == 0 || (bb as usize) == 0 {
        return false;
    }
    let mut sa: *const AstStmt = next_real_stmt(unsafe { (*ba).stmts as *const AstStmt });
    let mut sb: *const AstStmt = next_real_stmt(unsafe { (*bb).stmts as *const AstStmt });
    while (sa as usize) != 0 && (sb as usize) != 0 {
        let next_a: *const AstStmt = next_real_stmt(unsafe { (*sa).next as *const AstStmt });
        let next_b: *const AstStmt = next_real_stmt(unsafe { (*sb).next as *const AstStmt });
        let is_last_a: bool = (next_a as usize) == 0;
        let is_last_b: bool = (next_b as usize) == 0;
        if is_last_a != is_last_b {
            return false;
        }
        if !eq_stmt(ctx, sa, sb, is_last_a) {
            return false;
        }
        sa = next_a;
        sb = next_b;
    }
    (sa as usize) == 0 && (sb as usize) == 0
}

struct UseLeaf {
    segs: [16]StrId,
    seg_count: usize,
    alias: StrId,
}

struct UseLeafList {
    leaves: [64]UseLeaf,
    count: usize,
}

fn is_self_strid(interner: *const StrInterner, id: StrId) -> bool {
    if id.v == 0u32 || (interner as usize) == 0 {
        return false;
    }
    let sv: StrView = interner_get(unsafe { view(*interner) }, id);
    if sv.len != 4 || (sv.ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 101u8 && *(sv.ptr + 2) == 108u8 && *(sv.ptr + 3) == 102u8
    }
}

fn collect_use_leaves(
    interner: *const StrInterner,
    tree: *const AstUseTree,
    prefix: view<[16]StrId>,
    prefix_len: usize,
    out: mut_view<UseLeafList>
) {
    if (tree as usize) == 0 || out.count >= 64 {
        return;
    }
    let mut cur_prefix: [16]StrId = [StrId { v: 0u32 }; 16];
    let mut i: usize = 0;
    while i < prefix_len && i < 16 {
        cur_prefix[i] = (*prefix)[i];
        i = i + 1;
    }
    let mut cur_len: usize = prefix_len;
    let p_cnt: usize = unsafe { (*tree).path.count };
    let sub: *const AstUseTree = unsafe { (*tree).subtrees as *const AstUseTree };
    let is_self_leaf: bool = prefix_len > 0 && p_cnt == 1 && (sub as usize) == 0 &&
        is_self_strid(interner, unsafe { *(cst_strid_ptr((*tree).path.segments, 0)) });
    if !is_self_leaf {
        let mut j: usize = 0;
        while j < p_cnt && cur_len < 16 {
            cur_prefix[cur_len] = unsafe { *(cst_strid_ptr((*tree).path.segments, j)) };
            cur_len = cur_len + 1;
            j = j + 1;
        }
    }
    if (sub as usize) == 0 {
        let idx: usize = out.count;
        out.leaves[idx] = UseLeaf {
            segs: cur_prefix,
            seg_count: cur_len,
            alias: unsafe { (*tree).alias },
        };
        out.count = idx + 1;
    } else {
        let mut child: *const AstUseTree = sub;
        while (child as usize) != 0 {
            collect_use_leaves(interner, child, view(cur_prefix), cur_len, mut_view(*out));
            child = unsafe { (*child).next as *const AstUseTree };
        }
    }
}

fn eq_use_leaf(ctx: view<AstEquivCtx>, la: view<UseLeaf>, lb: view<UseLeaf>) -> bool {
    if la.seg_count != lb.seg_count {
        return false;
    }
    if !eq_strid(ctx, la.alias, lb.alias) {
        return false;
    }
    let mut i: usize = 0;
    while i < la.seg_count {
        if !eq_strid(ctx, la.segs[i], lb.segs[i]) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn eq_use_tree(ctx: view<AstEquivCtx>, ta: *const AstUseTree, tb: *const AstUseTree) -> bool {
    let empty_prefix: [16]StrId = [StrId { v: 0u32 }; 16];
    let mut list_a: UseLeafList = UseLeafList {
        leaves: [UseLeaf { segs: [StrId { v: 0u32 }; 16], seg_count: 0, alias: StrId { v: 0u32 } }; 64],
        count: 0,
    };
    let mut list_b: UseLeafList = UseLeafList {
        leaves: [UseLeaf { segs: [StrId { v: 0u32 }; 16], seg_count: 0, alias: StrId { v: 0u32 } }; 64],
        count: 0,
    };
    collect_use_leaves(ctx.interner_a, ta, view(empty_prefix), 0, mut_view(list_a));
    collect_use_leaves(ctx.interner_b, tb, view(empty_prefix), 0, mut_view(list_b));
    if list_a.count != list_b.count {
        return false;
    }
    let mut matched: [64]bool = [false; 64];
    let mut i: usize = 0;
    while i < list_a.count {
        let mut found: bool = false;
        let mut j: usize = 0;
        while j < list_b.count {
            if !matched[j] && eq_use_leaf(ctx, view(list_a.leaves[i]), view(list_b.leaves[j])) {
                matched[j] = true;
                found = true;
                break;
            }
            j = j + 1;
        }
        if !found {
            return false;
        }
        i = i + 1;
    }
    true
}
fn eq_single_item(ctx: view<AstEquivCtx>, a: *const AstItem, b: *const AstItem) -> bool {
    let k: u8 = unsafe { (*a).kind };
    if k != (unsafe { (*b).kind }) {
        return false;
    }
    if k != ITEM_ERROR {
        if !eq_attrs(ctx, unsafe { (*a).attrs as *const AstAttr }, unsafe { (*b).attrs as *const AstAttr }) {
            return false;
        }
        if (unsafe { (*a).vis.kind }) != (unsafe { (*b).vis.kind }) {
            return false;
        }
    }
    if k == ITEM_MODULE {
        return eq_dotted_name(ctx, unsafe { view((*a).mod_path) }, unsafe { view((*b).mod_path) });
    }
    if k == ITEM_USE {
        return eq_use_tree(ctx, unsafe { (*a).use_tree as *const AstUseTree }, unsafe { (*b).use_tree as *const AstUseTree });
    }
    if k == ITEM_FN {
        if (unsafe { (*a).is_async }) != (unsafe { (*b).is_async }) {
            return false;
        }
        if (unsafe { (*a).is_comptime }) != (unsafe { (*b).is_comptime }) {
            return false;
        }
        if (unsafe { (*a).is_unsafe }) != (unsafe { (*b).is_unsafe }) {
            return false;
        }
        if !eq_strid(ctx, unsafe { (*a).abi }, unsafe { (*b).abi }) {
            return false;
        }
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_generic_params(ctx, unsafe { (*a).generic_params as *const AstGenericParams }, unsafe { (*b).generic_params as *const AstGenericParams }) {
            return false;
        }
        if !eq_params(ctx, unsafe { (*a).params as *const AstParam }, unsafe { (*b).params as *const AstParam }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).ret_type as *const AstType }, unsafe { (*b).ret_type as *const AstType }) {
            return false;
        }
        if !eq_where_clause(ctx, unsafe { (*a).where_clause as *const AstWhereClause }, unsafe { (*b).where_clause as *const AstWhereClause }) {
            return false;
        }
        return eq_block(ctx, unsafe { (*a).body as *const AstBlock }, unsafe { (*b).body as *const AstBlock });
    }
    if k == ITEM_STRUCT {
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_generic_params(ctx, unsafe { (*a).generic_params as *const AstGenericParams }, unsafe { (*b).generic_params as *const AstGenericParams }) {
            return false;
        }
        if !eq_where_clause(ctx, unsafe { (*a).where_clause as *const AstWhereClause }, unsafe { (*b).where_clause as *const AstWhereClause }) {
            return false;
        }
        let is_tup: bool = unsafe { (*a).is_tuple };
        if is_tup != (unsafe { (*b).is_tuple }) {
            return false;
        }
        if is_tup {
            return eq_type_list(ctx, unsafe { (*a).tuple_types as *const AstType }, unsafe { (*b).tuple_types as *const AstType });
        }
        return eq_field_decls(ctx, unsafe { (*a).struct_fields as *const AstFieldDecl }, unsafe { (*b).struct_fields as *const AstFieldDecl });
    }
    if k == ITEM_ENUM {
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_generic_params(ctx, unsafe { (*a).generic_params as *const AstGenericParams }, unsafe { (*b).generic_params as *const AstGenericParams }) {
            return false;
        }
        if !eq_where_clause(ctx, unsafe { (*a).where_clause as *const AstWhereClause }, unsafe { (*b).where_clause as *const AstWhereClause }) {
            return false;
        }
        return eq_variants(ctx, unsafe { (*a).variants as *const AstVariantDecl }, unsafe { (*b).variants as *const AstVariantDecl });
    }
    if k == ITEM_TRAIT {
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_generic_params(ctx, unsafe { (*a).generic_params as *const AstGenericParams }, unsafe { (*b).generic_params as *const AstGenericParams }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).supertraits as *const AstType }, unsafe { (*b).supertraits as *const AstType }) {
            return false;
        }
        if !eq_where_clause(ctx, unsafe { (*a).where_clause as *const AstWhereClause }, unsafe { (*b).where_clause as *const AstWhereClause }) {
            return false;
        }
        return eq_item_list(ctx, unsafe { (*a).members as *const AstItem }, unsafe { (*b).members as *const AstItem }, false);
    }
    if k == ITEM_IMPL {
        if (unsafe { (*a).is_unsafe }) != (unsafe { (*b).is_unsafe }) {
            return false;
        }
        if (unsafe { (*a).is_auto }) != (unsafe { (*b).is_auto }) {
            return false;
        }
        if (unsafe { (*a).is_negative }) != (unsafe { (*b).is_negative }) {
            return false;
        }
        if !eq_generic_params(ctx, unsafe { (*a).generic_params as *const AstGenericParams }, unsafe { (*b).generic_params as *const AstGenericParams }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).trait_path as *const AstType }, unsafe { (*b).trait_path as *const AstType }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).self_type as *const AstType }, unsafe { (*b).self_type as *const AstType }) {
            return false;
        }
        if !eq_where_clause(ctx, unsafe { (*a).where_clause as *const AstWhereClause }, unsafe { (*b).where_clause as *const AstWhereClause }) {
            return false;
        }
        return eq_item_list(ctx, unsafe { (*a).members as *const AstItem }, unsafe { (*b).members as *const AstItem }, false);
    }
    if k == ITEM_TYPE_ALIAS {
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_generic_params(ctx, unsafe { (*a).generic_params as *const AstGenericParams }, unsafe { (*b).generic_params as *const AstGenericParams }) {
            return false;
        }
        return eq_type_list(ctx, unsafe { (*a).ty as *const AstType }, unsafe { (*b).ty as *const AstType });
    }
    if k == ITEM_CONST {
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).ty as *const AstType }, unsafe { (*b).ty as *const AstType }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).expr as *const AstExpr }, unsafe { (*b).expr as *const AstExpr });
    }
    if k == ITEM_STATIC {
        if (unsafe { (*a).is_unsafe }) != (unsafe { (*b).is_unsafe }) {
            return false;
        }
        if (unsafe { (*a).is_mut }) != (unsafe { (*b).is_mut }) {
            return false;
        }
        if !eq_strid(ctx, unsafe { (*a).name }, unsafe { (*b).name }) {
            return false;
        }
        if !eq_type_list(ctx, unsafe { (*a).ty as *const AstType }, unsafe { (*b).ty as *const AstType }) {
            return false;
        }
        return eq_expr(ctx, unsafe { (*a).expr as *const AstExpr }, unsafe { (*b).expr as *const AstExpr });
    }
    if k == ITEM_EXTERN_BLOCK {
        if !eq_strid(ctx, unsafe { (*a).abi }, unsafe { (*b).abi }) {
            return false;
        }
        return eq_item_list(ctx, unsafe { (*a).members as *const AstItem }, unsafe { (*b).members as *const AstItem }, false);
    }
    true
}

fn next_real_item(head: *const AstItem, file_id: FileId, is_first: mut_view<bool>, filter_synth: bool) -> *const AstItem {
    let fid_v: u32 = file_id.v;
    let mut cur: *const AstItem = head;
    while (cur as usize) != 0 {
        let fid: FileId = FileId { v: fid_v };
        if !filter_synth || !cst_is_synthetic_item(cur, fid, *is_first) {
            *is_first = false;
            return cur;
        }
        cur = unsafe { (*cur).next as *const AstItem };
    }
    0 as *const AstItem
}

fn eq_item_list(ctx: view<AstEquivCtx>, head_a: *const AstItem, head_b: *const AstItem, filter_synth: bool) -> bool {
    let mut first_a: bool = true;
    let mut first_b: bool = true;
    let mut a: *const AstItem = next_real_item(head_a, FileId { v: ctx.file_a.v }, mut_view(first_a), filter_synth);
    let mut b: *const AstItem = next_real_item(head_b, FileId { v: ctx.file_b.v }, mut_view(first_b), filter_synth);
    while (a as usize) != 0 && (b as usize) != 0 {
        let ka: u8 = unsafe { (*a).kind };
        let kb: u8 = unsafe { (*b).kind };
        if ka == ITEM_USE && kb == ITEM_USE {
            // Collect contiguous `ITEM_USE` run on both sides (up to 128 items) and match as a bijection.
            let mut run_a: [128]usize = [0usize; 128];
            let mut run_b: [128]usize = [0usize; 128];
            let mut cnt_a: usize = 0;
            let mut cnt_b: usize = 0;
            while (a as usize) != 0 && (unsafe { (*a).kind }) == ITEM_USE && cnt_a < 128 {
                run_a[cnt_a] = a as usize;
                cnt_a = cnt_a + 1;
                a = next_real_item(unsafe { (*a).next as *const AstItem }, FileId { v: ctx.file_a.v }, mut_view(first_a), filter_synth);
            }
            while (b as usize) != 0 && (unsafe { (*b).kind }) == ITEM_USE && cnt_b < 128 {
                run_b[cnt_b] = b as usize;
                cnt_b = cnt_b + 1;
                b = next_real_item(unsafe { (*b).next as *const AstItem }, FileId { v: ctx.file_b.v }, mut_view(first_b), filter_synth);
            }
            if cnt_a != cnt_b {
                return false;
            }
            let mut used_b: [128]bool = [false; 128];
            let mut i: usize = 0;
            while i < cnt_a {
                let ia: *const AstItem = run_a[i] as *const AstItem;
                let mut found: bool = false;
                let mut j: usize = 0;
                while j < cnt_b {
                    let ib: *const AstItem = run_b[j] as *const AstItem;
                    if !used_b[j] && eq_single_item(ctx, ia, ib) {
                        used_b[j] = true;
                        found = true;
                        break;
                    }
                    j = j + 1;
                }
                if !found {
                    return false;
                }
                i = i + 1;
            }
        } else {
            if !eq_single_item(ctx, a, b) {
                return false;
            }
            a = next_real_item(unsafe { (*a).next as *const AstItem }, FileId { v: ctx.file_a.v }, mut_view(first_a), filter_synth);
            b = next_real_item(unsafe { (*b).next as *const AstItem }, FileId { v: ctx.file_b.v }, mut_view(first_b), filter_synth);
        }
    }
    (a as usize) == 0 && (b as usize) == 0
}

pub fn fmt_count_non_synthetic_items(ast: view<Ast>, file_id: FileId) -> u32 {
    let fid_v: u32 = file_id.v;
    let mut first: bool = true;
    let mut cur: *const AstItem = next_real_item(ast.items as *const AstItem, FileId { v: fid_v }, mut_view(first), true);
    let mut cnt: u32 = 0u32;
    while (cur as usize) != 0 {
        cnt = cnt + 1u32;
        cur = next_real_item(unsafe { (*cur).next as *const AstItem }, FileId { v: fid_v }, mut_view(first), true);
    }
    cnt
}

// AXS-FMT-031(3): Structural AST equivalence check between `ast_a` and `ast_b`.
pub fn fmt_ast_equiv_module(
    interner_a: view<StrInterner>,
    src_a: StrView,
    ast_a: view<Ast>,
    file_a: FileId,
    interner_b: view<StrInterner>,
    src_b: StrView,
    ast_b: view<Ast>,
    file_b: FileId
) -> bool {
    let ctx: AstEquivCtx = AstEquivCtx {
        interner_a: unsafe { address_of<StrInterner>(*interner_a) },
        interner_b: unsafe { address_of<StrInterner>(*interner_b) },
        src_a: src_a,
        src_b: src_b,
        file_a: file_a,
        file_b: file_b,
    };
    eq_item_list(view(ctx), ast_a.items as *const AstItem, ast_b.items as *const AstItem, true)
}

// AXS-FMT-031(2) & AXS-FMT-004: Verifies every comment token is conserved with identical kind and normalized text.
pub fn fmt_verify_comments_conserved(orig_cst: view<CstFile>, fmt_cst: view<CstFile>) -> bool {
    if orig_cst.trivia_count != fmt_cst.trivia_count {
        return false;
    }
    let mut i: usize = 0;
    while i < orig_cst.trivia_count {
        let ta: *mut CstTrivia = cst_trivia_ptr(orig_cst.trivia, i);
        let tb: *mut CstTrivia = cst_trivia_ptr(fmt_cst.trivia, i);
        if (unsafe { (*ta).kind }) != (unsafe { (*tb).kind }) {
            return false;
        }
        let na: StrView = StrView { ptr: unsafe { (*ta).norm_ptr }, len: unsafe { (*ta).norm_len } };
        let nb: StrView = StrView { ptr: unsafe { (*tb).norm_ptr }, len: unsafe { (*tb).norm_len } };
        if !fmt_sv_eq(na, nb) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_str_to_sv(s: str) -> StrView {
    let raw: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw.len;
    let dst = unsafe { heap_alloc(n + 1, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

// AXS-FMT-031(4): Emits `AX_ICE_INTERNAL` (`data.stage = "fmt_verify"`, `data.detail = detail`).
pub fn fmt_report_ice_verify(sink: mut_view<DiagSink>, detail: StrView) {
    let stage_key: StrView = verify_str_to_sv("stage");
    let stage_val: StrView = verify_str_to_sv("fmt_verify");
    let detail_key: StrView = verify_str_to_sv("detail");
    let mut entries: [2]DiagDataEntry = [
        DiagDataEntry {
            key: stage_key,
            value: DiagDataValue {
                kind: DiagDataKind.String,
                str_val: stage_val,
                int_val: 0i64,
                bool_val: false,
                list_items: 0 as *mut StrView,
                list_count: 0,
            },
        },
        DiagDataEntry {
            key: detail_key,
            value: DiagDataValue {
                kind: DiagDataKind.String,
                str_val: detail,
                int_val: 0i64,
                bool_val: false,
                list_items: 0 as *mut StrView,
                list_count: 0,
            },
        },
    ];
    let mut d: Diagnostic = diag_new(diag_code(AX_ICE_INTERNAL), span_none(), detail);
    d.data = unsafe { address_of_mut<DiagDataEntry>(entries[0]) };
    d.data_count = 2;
    diag_sink_report(sink, view(d));
}
fn make_empty_lex_result() -> LexResult {
    LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    }
}

// AXS-FMT-030..032: Verifies a candidate `(orig_src, fmt_src)` pair for syntax validity,
// comment conservation, structural AST equivalence, and single-step idempotence.
pub fn fmt_verify_formatted_output(
    orig_src: StrView,
    fmt_src: StrView,
    out_stats: mut_view<FmtVerifyStats>,
    out_sink: mut_view<DiagSink>
) -> u8 {
    *out_stats = fmt_verify_stats_empty();
    let mut arena = arena_new();
    let mut interner = interner_new();
    let mut lex_orig: LexResult = make_empty_lex_result();
    let mut parse_orig: ParseResult = ParseResult { ast: Ast { items: 0 as *mut AstItem } };
    let cst_orig: CstFile = cst_parse_and_build(
        mut_view(arena),
        mut_view(interner),
        mut_view(*out_sink),
        FileId { v: 1u32 },
        orig_src,
        mut_view(lex_orig),
        mut_view(parse_orig)
    );
    out_stats.orig_comment_count = cst_orig.trivia_count as u32;
    out_stats.orig_item_count = fmt_count_non_synthetic_items(view(parse_orig.ast), FileId { v: 1u32 });

    if out_sink.errors > 0 {
        out_stats.status = FMT_VERIFY_ERR_SYNTAX;
        out_stats.exit_code = 1;
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_SYNTAX;
    }

    let mut reparse_sink: DiagSink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    };
    diag_sink_init(mut_view(reparse_sink));
    let mut lex_fmt: LexResult = make_empty_lex_result();
    let mut parse_fmt: ParseResult = ParseResult { ast: Ast { items: 0 as *mut AstItem } };
    let cst_fmt: CstFile = cst_parse_and_build(
        mut_view(arena),
        mut_view(interner),
        mut_view(reparse_sink),
        FileId { v: 2u32 },
        fmt_src,
        mut_view(lex_fmt),
        mut_view(parse_fmt)
    );
    out_stats.fmt_comment_count = cst_fmt.trivia_count as u32;
    out_stats.fmt_item_count = fmt_count_non_synthetic_items(view(parse_fmt.ast), FileId { v: 2u32 });

    if reparse_sink.errors > 0 {
        let msg: StrView = verify_str_to_sv("post-format verification failed: formatted output has syntax or lex errors");
        fmt_report_ice_verify(mut_view(*out_sink), msg);
        out_stats.status = FMT_VERIFY_ERR_REPARSE;
        out_stats.exit_code = 3;
        ax_lex_result_free(mut_view(lex_fmt));
        diag_sink_free(mut_view(reparse_sink));
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_REPARSE;
    }

    let comments_ok: bool = fmt_verify_comments_conserved(view(cst_orig), view(cst_fmt));
    out_stats.comments_conserved = comments_ok;
    if !comments_ok {
        let msg: StrView = verify_str_to_sv("post-format verification failed: comment conservation invariant violated");
        fmt_report_ice_verify(mut_view(*out_sink), msg);
        out_stats.status = FMT_VERIFY_ERR_COMMENTS;
        out_stats.exit_code = 3;
        ax_lex_result_free(mut_view(lex_fmt));
        diag_sink_free(mut_view(reparse_sink));
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_COMMENTS;
    }

    let ast_ok: bool = fmt_ast_equiv_module(
        view(interner),
        cst_orig.src,
        view(parse_orig.ast),
        FileId { v: 1u32 },
        view(interner),
        cst_fmt.src,
        view(parse_fmt.ast),
        FileId { v: 2u32 }
    );
    out_stats.ast_equivalent = ast_ok;
    if !ast_ok {
        let msg: StrView = verify_str_to_sv("post-format verification failed: structural AST equivalence invariant violated");
        fmt_report_ice_verify(mut_view(*out_sink), msg);
        out_stats.status = FMT_VERIFY_ERR_AST_MISMATCH;
        out_stats.exit_code = 3;
        ax_lex_result_free(mut_view(lex_fmt));
        diag_sink_free(mut_view(reparse_sink));
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_AST_MISMATCH;
    }

    out_stats.is_already_canonical = fmt_sv_eq(orig_src, fmt_src);
    out_stats.idempotent = true;
    out_stats.status = FMT_VERIFY_OK;
    out_stats.exit_code = 0;

    ax_lex_result_free(mut_view(lex_fmt));
    diag_sink_free(mut_view(reparse_sink));
    ax_lex_result_free(mut_view(lex_orig));
    interner_free(mut_view(interner));
    arena_destroy(mut_view(arena));
    FMT_VERIFY_OK
}

// AXS-FMT-030..032: Formats `src` into `out_buf` and runs the full post-format verification gate
// (re-lex/re-parse, comment conservation, structural AST equivalence, and single-step idempotence).
pub fn fmt_format_and_verify(
    src: StrView,
    out_buf: mut_view<DiagBuffer>,
    out_stats: mut_view<FmtVerifyStats>,
    out_sink: mut_view<DiagSink>
) -> u8 {
    *out_stats = fmt_verify_stats_empty();
    out_buf.len = 0;

    let mut arena = arena_new();
    let mut interner = interner_new();
    let mut lex_orig: LexResult = make_empty_lex_result();
    let mut parse_orig: ParseResult = ParseResult { ast: Ast { items: 0 as *mut AstItem } };
    let mut cst_orig: CstFile = cst_parse_and_build(
        mut_view(arena),
        mut_view(interner),
        mut_view(*out_sink),
        FileId { v: 1u32 },
        src,
        mut_view(lex_orig),
        mut_view(parse_orig)
    );
    out_stats.orig_comment_count = cst_orig.trivia_count as u32;
    out_stats.orig_item_count = fmt_count_non_synthetic_items(view(parse_orig.ast), FileId { v: 1u32 });

    if out_sink.errors > 0 {
        out_stats.status = FMT_VERIFY_ERR_SYNTAX;
        out_stats.exit_code = 1;
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_SYNTAX;
    }

    let mut eng: DocEngine = DocEngine {
        arena: 0 as *mut Arena,
        nodes: 0 as *mut DocNode,
        count: 0,
        cap: 0,
    };
    doc_engine_init(mut_view(eng), mut_view(arena), 1024);
    let ctx: FmtCtx = FmtCtx {
        arena: unsafe { address_of_mut<Arena>(arena) },
        interner: unsafe { address_of<StrInterner>(interner) },
        cst: unsafe { address_of_mut<CstFile>(cst_orig) },
        eng: unsafe { address_of_mut<DocEngine>(eng) },
    };
    let root_doc: u32 = fmt_print_module(view(ctx), view(parse_orig.ast));
    out_buf.len = 0;
    doc_render_to_buf(view(eng), root_doc, FMT_MAX_WIDTH, mut_view(*out_buf));
    if out_buf.len > 0 {
        diag_buf_push_byte(mut_view(*out_buf), 10u8);
    }

    let unemitted: usize = cst_unemitted_count(view(cst_orig));
    out_stats.unemitted_comment_count = unemitted as u32;
    if unemitted > 0 {
        let msg: StrView = verify_str_to_sv("post-format verification failed: unemitted comment tokens in CST");
        fmt_report_ice_verify(mut_view(*out_sink), msg);
        out_stats.status = FMT_VERIFY_ERR_COMMENTS;
        out_stats.exit_code = 3;
        out_buf.len = 0;
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_COMMENTS;
    }

    let fmt_view: StrView = StrView { ptr: out_buf.ptr as *const u8, len: out_buf.len };
    let mut reparse_sink: DiagSink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    };
    diag_sink_init(mut_view(reparse_sink));
    let mut lex_fmt: LexResult = make_empty_lex_result();
    let mut parse_fmt: ParseResult = ParseResult { ast: Ast { items: 0 as *mut AstItem } };
    let mut cst_fmt: CstFile = cst_parse_and_build(
        mut_view(arena),
        mut_view(interner),
        mut_view(reparse_sink),
        FileId { v: 2u32 },
        fmt_view,
        mut_view(lex_fmt),
        mut_view(parse_fmt)
    );
    out_stats.fmt_comment_count = cst_fmt.trivia_count as u32;
    out_stats.fmt_item_count = fmt_count_non_synthetic_items(view(parse_fmt.ast), FileId { v: 2u32 });

    if reparse_sink.errors > 0 {
        let msg: StrView = verify_str_to_sv("post-format verification failed: formatted output failed re-parse");
        fmt_report_ice_verify(mut_view(*out_sink), msg);
        out_stats.status = FMT_VERIFY_ERR_REPARSE;
        out_stats.exit_code = 3;
        out_buf.len = 0;
        ax_lex_result_free(mut_view(lex_fmt));
        diag_sink_free(mut_view(reparse_sink));
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_REPARSE;
    }

    let comments_ok: bool = fmt_verify_comments_conserved(view(cst_orig), view(cst_fmt));
    out_stats.comments_conserved = comments_ok;
    if !comments_ok {
        let msg: StrView = verify_str_to_sv("post-format verification failed: comment conservation check failed");
        fmt_report_ice_verify(mut_view(*out_sink), msg);
        out_stats.status = FMT_VERIFY_ERR_COMMENTS;
        out_stats.exit_code = 3;
        out_buf.len = 0;
        ax_lex_result_free(mut_view(lex_fmt));
        diag_sink_free(mut_view(reparse_sink));
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_COMMENTS;
    }

    let ast_ok: bool = fmt_ast_equiv_module(
        view(interner),
        cst_orig.src,
        view(parse_orig.ast),
        FileId { v: 1u32 },
        view(interner),
        cst_fmt.src,
        view(parse_fmt.ast),
        FileId { v: 2u32 }
    );
    out_stats.ast_equivalent = ast_ok;
    if !ast_ok {
        let msg: StrView = verify_str_to_sv("post-format verification failed: AST equivalence check failed");
        fmt_report_ice_verify(mut_view(*out_sink), msg);
        out_stats.status = FMT_VERIFY_ERR_AST_MISMATCH;
        out_stats.exit_code = 3;
        out_buf.len = 0;
        ax_lex_result_free(mut_view(lex_fmt));
        diag_sink_free(mut_view(reparse_sink));
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_AST_MISMATCH;
    }

    // AXS-FMT-032: Single-step idempotence verification (`fmt(fmt(src)) == fmt(src)`).
    let mut eng2: DocEngine = DocEngine {
        arena: 0 as *mut Arena,
        nodes: 0 as *mut DocNode,
        count: 0,
        cap: 0,
    };
    doc_engine_init(mut_view(eng2), mut_view(arena), 1024);
    let ctx2: FmtCtx = FmtCtx {
        arena: unsafe { address_of_mut<Arena>(arena) },
        interner: unsafe { address_of<StrInterner>(interner) },
        cst: unsafe { address_of_mut<CstFile>(cst_fmt) },
        eng: unsafe { address_of_mut<DocEngine>(eng2) },
    };
    let root_doc2: u32 = fmt_print_module(view(ctx2), view(parse_fmt.ast));
    let mut buf2: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(buf2));
    doc_render_to_buf(view(eng2), root_doc2, FMT_MAX_WIDTH, mut_view(buf2));
    if buf2.len > 0 {
        diag_buf_push_byte(mut_view(buf2), 10u8);
    }
    let fmt2_view: StrView = StrView { ptr: buf2.ptr as *const u8, len: buf2.len };
    let idem_ok: bool = fmt_sv_eq(fmt_view, fmt2_view);
    diag_buf_free(mut_view(buf2));
    out_stats.idempotent = idem_ok;

    if !idem_ok {
        let msg: StrView = verify_str_to_sv("post-format verification failed: single-step idempotence check failed");
        fmt_report_ice_verify(mut_view(*out_sink), msg);
        out_stats.status = FMT_VERIFY_ERR_IDEMPOTENCE;
        out_stats.exit_code = 3;
        out_buf.len = 0;
        ax_lex_result_free(mut_view(lex_fmt));
        diag_sink_free(mut_view(reparse_sink));
        ax_lex_result_free(mut_view(lex_orig));
        interner_free(mut_view(interner));
        arena_destroy(mut_view(arena));
        return FMT_VERIFY_ERR_IDEMPOTENCE;
    }

    out_stats.is_already_canonical = fmt_sv_eq(src, fmt_view);
    out_stats.status = FMT_VERIFY_OK;
    out_stats.exit_code = 0;

    ax_lex_result_free(mut_view(lex_fmt));
    diag_sink_free(mut_view(reparse_sink));
    ax_lex_result_free(mut_view(lex_orig));
    interner_free(mut_view(interner));
    arena_destroy(mut_view(arena));
    FMT_VERIFY_OK
}
