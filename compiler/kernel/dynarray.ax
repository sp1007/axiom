module compiler.kernel.dynarray

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct RawDynArray {
    pub items: *mut u8,
    pub elem_size: usize,
    pub elem_align: usize,
    pub len: usize,
    pub cap: usize,
}

pub fn raw_dynarray_new(elem_size: usize, elem_align: usize) -> RawDynArray {
    raw_dynarray_with_capacity(0, elem_size, elem_align)
}

pub fn raw_dynarray_with_capacity(capacity: usize, elem_size: usize, elem_align: usize) -> RawDynArray {
    let esz = if elem_size == 0 { 1 } else { elem_size };
    let eal = if elem_align == 0 { 1 } else { elem_align };
    if capacity == 0 {
        return RawDynArray {
            items: 0 as *mut u8,
            elem_size: esz,
            elem_align: eal,
            len: 0,
            cap: 0,
        };
    }
    let raw = unsafe { heap_alloc(capacity * esz, eal) };
    RawDynArray {
        items: raw,
        elem_size: esz,
        elem_align: eal,
        len: 0,
        cap: capacity,
    }
}

pub fn raw_dynarray_free(da: mut_view<RawDynArray>) {
    if da.cap > 0 && da.items as usize != 0 {
        unsafe {
            heap_free(da.items, da.cap * da.elem_size, da.elem_align);
        }
    }
    da.items = 0 as *mut u8;
    da.len = 0;
    da.cap = 0;
}

pub fn raw_dynarray_clear(da: mut_view<RawDynArray>) {
    da.len = 0;
}

pub fn raw_dynarray_len(da: view<RawDynArray>) -> usize {
    da.len
}

pub fn raw_dynarray_is_empty(da: view<RawDynArray>) -> bool {
    da.len == 0
}

pub fn raw_dynarray_reserve(da: mut_view<RawDynArray>, additional: usize) {
    let min_cap = da.len + additional;
    if min_cap <= da.cap { return; }
    let mut new_cap = if da.cap == 0 { 4 } else { da.cap + da.cap };
    while new_cap < min_cap {
        new_cap = new_cap + new_cap;
    }
    let new_items = unsafe { heap_alloc(new_cap * da.elem_size, da.elem_align) };
    if da.len > 0 && da.items as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(da.items as *const u8, new_items, da.len * da.elem_size);
            heap_free(da.items, da.cap * da.elem_size, da.elem_align);
        }
    }
    da.items = new_items;
    da.cap = new_cap;
}

pub fn raw_dynarray_push(da: mut_view<RawDynArray>, src: *const u8) {
    if da.len == da.cap {
        let new_cap = if da.cap == 0 { 4 } else { da.cap + da.cap };
        let new_items = unsafe { heap_alloc(new_cap * da.elem_size, da.elem_align) };
        if da.len > 0 && da.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(da.items as *const u8, new_items, da.len * da.elem_size);
                heap_free(da.items, da.cap * da.elem_size, da.elem_align);
            }
        }
        da.items = new_items;
        da.cap = new_cap;
    }
    let dst = (da.items as usize + da.len * da.elem_size) as *mut u8;
    if src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, da.elem_size);
        }
    }
    da.len = da.len + 1;
}

pub fn raw_dynarray_pop(da: mut_view<RawDynArray>, dst: *mut u8) -> bool {
    if da.len == 0 { return false; }
    da.len = da.len - 1;
    if dst as usize != 0 {
        let src = (da.items as usize + da.len * da.elem_size) as *const u8;
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, da.elem_size);
        }
    }
    true
}

pub unsafe fn raw_dynarray_get(da: view<RawDynArray>, index: usize) -> *const u8 {
    (da.items as usize + index * da.elem_size) as *const u8
}

pub unsafe fn raw_dynarray_get_mut(da: mut_view<RawDynArray>, index: usize) -> *mut u8 {
    (da.items as usize + index * da.elem_size) as *mut u8
}

// U32DynArray — Dynamic array storing 32-bit values
pub struct U32DynArray {
    pub raw: RawDynArray,
}

pub fn u32_dynarray_new() -> U32DynArray {
    U32DynArray {
        raw: raw_dynarray_new(4, 4),
    }
}

pub fn u32_dynarray_with_capacity(capacity: usize) -> U32DynArray {
    U32DynArray {
        raw: raw_dynarray_with_capacity(capacity, 4, 4),
    }
}

pub fn u32_dynarray_free(da: mut_view<U32DynArray>) {
    raw_dynarray_free(mut_view(da.raw));
}

pub fn u32_dynarray_clear(da: mut_view<U32DynArray>) {
    raw_dynarray_clear(mut_view(da.raw));
}

pub fn u32_dynarray_len(da: view<U32DynArray>) -> usize {
    da.raw.len
}

pub fn u32_dynarray_is_empty(da: view<U32DynArray>) -> bool {
    da.raw.len == 0
}

pub fn u32_dynarray_push(da: mut_view<U32DynArray>, val: u32) {
    unsafe {
        raw_dynarray_push(mut_view(da.raw), address_of(val) as *const u8);
    }
}

pub fn u32_dynarray_pop(da: mut_view<U32DynArray>) -> u32 {
    let mut val: u32 = 0;
    unsafe {
        if raw_dynarray_pop(mut_view(da.raw), address_of_mut(val) as *mut u8) {
            val
        } else {
            0u32
        }
    }
}

pub fn u32_dynarray_get(da: view<U32DynArray>, index: usize) -> u32 {
    if index >= da.raw.len { return 0u32; }
    unsafe {
        let p = raw_dynarray_get(view(da.raw), index) as *const u32;
        *p
    }
}

pub fn u32_dynarray_set(da: mut_view<U32DynArray>, index: usize, val: u32) -> bool {
    if index >= da.raw.len { return false; }
    unsafe {
        let p = raw_dynarray_get_mut(mut_view(da.raw), index) as *mut u32;
        *p = val;
    }
    true
}
