// RawIdTable — Untyped contiguous ID table backing typed ID tables
pub struct RawIdTable {
    pub items: *mut u8,
    pub elem_size: usize,
    pub elem_align: usize,
    pub len: usize,
    pub cap: usize,
}

pub fn raw_idtable_new(elem_size: usize, elem_align: usize) -> RawIdTable {
    raw_idtable_with_capacity(0, elem_size, elem_align)
}

pub fn raw_idtable_with_capacity(capacity: usize, elem_size: usize, elem_align: usize) -> RawIdTable {
    let esz = if elem_size == 0 { 1 } else { elem_size };
    let eal = if elem_align == 0 { 1 } else { elem_align };
    if capacity == 0 {
        return RawIdTable {
            items: 0 as *mut u8,
            elem_size: esz,
            elem_align: eal,
            len: 0,
            cap: 0,
        };
    }
    let raw = unsafe { heap_alloc(capacity * esz, eal) };
    RawIdTable {
        items: raw,
        elem_size: esz,
        elem_align: eal,
        len: 0,
        cap: capacity,
    }
}

pub fn raw_idtable_free(t: mut_view<RawIdTable>) {
    if t.cap > 0 && t.items as usize != 0 {
        unsafe {
            heap_free(t.items, t.cap * t.elem_size, t.elem_align);
        }
    }
    t.items = 0 as *mut u8;
    t.len = 0;
    t.cap = 0;
}

pub fn raw_idtable_clear(t: mut_view<RawIdTable>) {
    t.len = 0;
}

pub fn raw_idtable_len(t: view<RawIdTable>) -> usize {
    t.len
}

pub fn raw_idtable_is_empty(t: view<RawIdTable>) -> bool {
    t.len == 0
}

pub fn raw_idtable_contains(t: view<RawIdTable>, id_val: u32) -> bool {
    id_val != 0 && (id_val as usize) <= t.len
}

pub fn raw_idtable_push(t: mut_view<RawIdTable>, src: *const u8) -> u32 {
    if t.len == t.cap {
        let new_cap = if t.cap == 0 { 4 } else { t.cap + t.cap };
        let new_items = unsafe { heap_alloc(new_cap * t.elem_size, t.elem_align) };
        if t.len > 0 && t.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(t.items as *const u8, new_items, t.len * t.elem_size);
                heap_free(t.items, t.cap * t.elem_size, t.elem_align);
            }
        }
        t.items = new_items;
        t.cap = new_cap;
    }
    let dst = (t.items as usize + t.len * t.elem_size) as *mut u8;
    if src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, t.elem_size);
        }
    }
    t.len = t.len + 1;
    t.len as u32
}

pub unsafe fn raw_idtable_get_ptr(t: view<RawIdTable>, id_val: u32) -> *const u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *const u8
}

pub unsafe fn raw_idtable_get_mut_ptr(t: mut_view<RawIdTable>, id_val: u32) -> *mut u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *mut u8
}

pub fn raw_idtable_first(t: view<RawIdTable>) -> u32 {
    if t.len == 0 { 0u32 } else { 1u32 }
}

pub fn raw_idtable_after(t: view<RawIdTable>, id_val: u32) -> u32 {
    if (id_val as usize) < t.len { id_val + 1u32 } else { 0u32 }
}

// U32IdTable — Convenient typed ID table storing 32-bit values
pub struct U32IdTable {
    pub raw: RawIdTable,
}

pub fn u32_idtable_new() -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_new(4, 4),
    }
}

pub fn u32_idtable_with_capacity(capacity: usize) -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_with_capacity(capacity, 4, 4),
    }
}

pub fn u32_idtable_free(t: mut_view<U32IdTable>) {
    raw_idtable_free(mut_view(t.raw));
}

pub fn u32_idtable_len(t: view<U32IdTable>) -> usize {
    t.raw.len
}

pub fn u32_idtable_is_empty(t: view<U32IdTable>) -> bool {
    t.raw.len == 0
}

pub fn u32_idtable_contains(t: view<U32IdTable>, id_val: u32) -> bool {
    raw_idtable_contains(view(t.raw), id_val)
}

pub fn u32_idtable_push(t: mut_view<U32IdTable>, val: u32) -> u32 {
    unsafe {
        raw_idtable_push(mut_view(t.raw), address_of(val) as *const u8)
    }
}

pub fn u32_idtable_get(t: view<U32IdTable>, id_val: u32) -> u32 {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return 0u32;
    }
    unsafe {
        let p = raw_idtable_get_ptr(view(t.raw), id_val) as *const u32;
        *p
    }
}

pub fn u32_idtable_set(t: mut_view<U32IdTable>, id_val: u32, val: u32) -> bool {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return false;
    }
    unsafe {
        let p = raw_idtable_get_mut_ptr(mut_view(t.raw), id_val) as *mut u32;
        *p = val;
    }
    true
}

pub fn u32_idtable_first(t: view<U32IdTable>) -> u32 {
    raw_idtable_first(view(t.raw))
}

pub fn u32_idtable_after(t: view<U32IdTable>, id_val: u32) -> u32 {
    raw_idtable_after(view(t.raw), id_val)
}
