@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct LirBuilder {
    pub arena: *mut Arena,
    pub interner: *mut TypeInterner,
    pub mir: *const MirBody,
    pub hir: *const HirFile,
    pub str_in: *const StrInterner,
    pub const_table: *const LirConstTable,
    pub slots: *mut LirStackSlot,
    pub slot_count: usize,
    pub vregs: *mut LirVReg,
    pub vreg_count: usize,
    pub vreg_cap: usize,
    pub bbs: *mut LirBb,
    pub bb_count: usize,
    pub bb_cap: usize,
    pub cur_insts: *mut LirInst,
    pub cur_inst_count: usize,
    pub cur_inst_cap: usize,
}

unsafe fn vreg_id_at(base: *mut LirVRegId, idx: usize) -> *mut LirVRegId {
    let off = lir_mul_usize(idx, size_of<LirVRegId>());
    ((base as usize) + off) as *mut LirVRegId
}

