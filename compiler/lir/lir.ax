pub const LIR_INST_ICMP_UGE: u8 = 23u8;
pub const LIR_INST_LOAD: u8 = 24u8;
pub const LIR_INST_STORE: u8 = 25u8;
pub const LIR_INST_STACK_ADDR: u8 = 26u8;
pub const LIR_INST_OFFSET: u8 = 27u8;
pub const LIR_INST_CONST: u8 = 28u8;
pub const LIR_INST_CONST_STR: u8 = 29u8;
pub const LIR_INST_FN_ADDR: u8 = 30u8;
pub const LIR_INST_SADD_OVERFLOW: u8 = 31u8;
pub const LIR_INST_UADD_OVERFLOW: u8 = 32u8;
