pub const LIR_INST_USUB_OVERFLOW: u8 = 34u8;
pub const LIR_INST_SMUL_OVERFLOW: u8 = 35u8;
pub const LIR_INST_UMUL_OVERFLOW: u8 = 36u8;
pub const LIR_INST_SDIV_OVERFLOW: u8 = 37u8;
pub const LIR_INST_UDIV_OVERFLOW: u8 = 38u8;
pub const LIR_INST_SREM_OVERFLOW: u8 = 39u8;
pub const LIR_INST_UREM_OVERFLOW: u8 = 40u8;
pub const LIR_INST_CALL: u8 = 41u8;
pub const LIR_INST_ABI_ARG: u8 = 42u8;
pub const LIR_INST_ABI_RESULT: u8 = 43u8;
pub const LIR_INST_UDIV: u8 = 44u8;
pub const LIR_INST_UREM: u8 = 45u8;

pub struct LirInst {
    pub kind: u8,
    pub dest: LirVRegId,
    pub lhs: LirVRegId,
    pub rhs: LirVRegId,
    pub operand: LirVRegId,
    pub ptr: LirVRegId,
    pub val: LirVRegId,
    pub offset: LirVRegId,
    pub ty: TypeId,
    pub bit_width: u32,
    pub slot: LirStackSlotId,
    pub const_val: u64,
    pub str_bytes: *const u8,
    pub str_len: usize,
    pub sym_name: *const u8,
    pub sym_len: usize,
    pub callee_ty: TypeId,
    pub dst_addr: LirVRegId,
    pub callee_vreg: LirVRegId,
    pub index: u32,
    pub loc_kind: u32,
    pub loc_reg_or_offset: u32,
}

pub const LIR_TERM_JMP: u8 = 0u8;
pub const LIR_TERM_JCC: u8 = 1u8;
pub const LIR_TERM_SWITCH: u8 = 2u8;
pub const LIR_TERM_RETURN: u8 = 3u8;
pub const LIR_TERM_UNREACHABLE: u8 = 4u8;
pub const LIR_TERM_ASSERT: u8 = 5u8;

pub struct LirSwitchTarget {
    pub val: u64,
    pub target: LirBbId,
}

pub struct LirTerminator {
    pub kind: u8,
    pub jmp_target: LirBbId,
    pub cond: LirVRegId,
    pub then_target: LirBbId,
    pub else_target: LirBbId,
    pub assert_target: LirBbId,
    pub msg_ptr: *const u8,
    pub msg_len: usize,
    pub targets: *mut LirSwitchTarget,
    pub count: usize,
    pub otherwise: LirBbId,
}

pub struct LirBb {
    pub id: LirBbId,
    pub insts: *mut LirInst,
    pub inst_count: usize,
    pub term: LirTerminator,
}

pub struct LirFrameReq {
    pub max_outgoing_args_bytes: u32,
    pub requires_16_byte_alignment: bool,
}

pub struct LirBody {
    pub arena: *mut Arena,
    pub slots: *mut LirStackSlot,
    pub slot_count: usize,
    pub vregs: *mut LirVReg,
    pub vreg_count: usize,
    pub bbs: *mut LirBb,
    pub bb_count: usize,
    pub frame_req: LirFrameReq,
}

pub struct LirConstEntry {
    pub sym_v: u32,
    pub sym_name: *const u8,
    pub sym_len: usize,
}

pub struct LirConstTable {
    pub entries: *const LirConstEntry,
    pub count: usize,
}

// --- Pointer Indexing & Reset Helpers ---

pub unsafe fn lir_slot_at(base: *mut LirStackSlot, idx: usize) -> *mut LirStackSlot {
    let off = lir_mul_usize(idx, size_of<LirStackSlot>());
    ((base as usize) + off) as *mut LirStackSlot
}

pub unsafe fn lir_vreg_at(base: *mut LirVReg, idx: usize) -> *mut LirVReg {
    let off = lir_mul_usize(idx, size_of<LirVReg>());
    ((base as usize) + off) as *mut LirVReg
}

pub unsafe fn lir_bb_at(base: *mut LirBb, idx: usize) -> *mut LirBb {
    let off = lir_mul_usize(idx, size_of<LirBb>());
    ((base as usize) + off) as *mut LirBb
}

pub unsafe fn lir_inst_at(base: *mut LirInst, idx: usize) -> *mut LirInst {
    let off = lir_mul_usize(idx, size_of<LirInst>());
    ((base as usize) + off) as *mut LirInst
}

pub unsafe fn lir_switch_target_at(base: *mut LirSwitchTarget, idx: usize) -> *mut LirSwitchTarget {
    let off = lir_mul_usize(idx, size_of<LirSwitchTarget>());
    ((base as usize) + off) as *mut LirSwitchTarget
}

pub unsafe fn lir_const_entry_at(base: *const LirConstEntry, idx: usize) -> *const LirConstEntry {
    let off = lir_mul_usize(idx, size_of<LirConstEntry>());
    ((base as usize) + off) as *const LirConstEntry
}

pub fn lir_inst_reset(inst: mut_view<LirInst>, kind: u8) {
    inst.kind = kind;
    inst.dest.v = 0u32;
    inst.lhs.v = 0u32;
    inst.rhs.v = 0u32;
    inst.operand.v = 0u32;
    inst.ptr.v = 0u32;
    inst.val.v = 0u32;
    inst.offset.v = 0u32;
    inst.ty.v = 0u32;
    inst.bit_width = 0u32;
    inst.slot.v = 0u32;
    inst.const_val = 0u64;
    inst.str_bytes = 0 as *const u8;
    inst.str_len = 0;
    inst.sym_name = 0 as *const u8;
    inst.sym_len = 0;
    inst.callee_ty.v = 0u32;
    inst.dst_addr.v = LIR_VREG_NONE;
    inst.callee_vreg.v = LIR_VREG_NONE;
    inst.index = 0u32;
    inst.loc_kind = 0u32;
    inst.loc_reg_or_offset = 0u32;
}

pub fn lir_copy_inst(dst: mut_view<LirInst>, src: view<LirInst>) {
    dst.kind = src.kind;
    dst.dest.v = src.dest.v;
    dst.lhs.v = src.lhs.v;
    dst.rhs.v = src.rhs.v;
    dst.operand.v = src.operand.v;
    dst.ptr.v = src.ptr.v;
    dst.val.v = src.val.v;
    dst.offset.v = src.offset.v;
    dst.ty.v = src.ty.v;
    dst.bit_width = src.bit_width;
    dst.slot.v = src.slot.v;
    dst.const_val = src.const_val;
    dst.str_bytes = src.str_bytes;
    dst.str_len = src.str_len;
    dst.sym_name = src.sym_name;
    dst.sym_len = src.sym_len;
    dst.callee_ty.v = src.callee_ty.v;
    dst.dst_addr.v = src.dst_addr.v;
    dst.callee_vreg.v = src.callee_vreg.v;
    dst.index = src.index;
    dst.loc_kind = src.loc_kind;
    dst.loc_reg_or_offset = src.loc_reg_or_offset;
}

pub fn lir_term_reset(term: mut_view<LirTerminator>, kind: u8) {
    term.kind = kind;
    term.jmp_target.v = 0u32;
    term.cond.v = 0u32;
    term.then_target.v = 0u32;
    term.else_target.v = 0u32;
    term.assert_target.v = 0u32;
    term.msg_ptr = 0 as *const u8;
    term.msg_len = 0;
    term.targets = 0 as *mut LirSwitchTarget;
    term.count = 0;
    term.otherwise.v = 0u32;
}

pub fn lir_copy_term(dst: mut_view<LirTerminator>, src: view<LirTerminator>) {
    dst.kind = src.kind;
    dst.jmp_target.v = src.jmp_target.v;
    dst.cond.v = src.cond.v;
    dst.then_target.v = src.then_target.v;
    dst.else_target.v = src.else_target.v;
    dst.assert_target.v = src.assert_target.v;
    dst.msg_ptr = src.msg_ptr;
    dst.msg_len = src.msg_len;
    dst.targets = src.targets;
    dst.count = src.count;
    dst.otherwise.v = src.otherwise.v;
}

pub fn lir_bb_reset(bb: mut_view<LirBb>, id_v: u32) {
    bb.id.v = id_v;
    bb.insts = 0 as *mut LirInst;
    bb.inst_count = 0;
    lir_term_reset(mut_view(bb.term), LIR_TERM_UNREACHABLE);
}

pub fn lir_body_reset(body: mut_view<LirBody>, arena_ptr: *mut Arena) {
    body.arena = arena_ptr;
    body.slots = 0 as *mut LirStackSlot;
    body.slot_count = 0;
    body.vregs = 0 as *mut LirVReg;
    body.vreg_count = 0;
    body.bbs = 0 as *mut LirBb;
    body.bb_count = 0;
    body.frame_req.max_outgoing_args_bytes = 0u32;
    body.frame_req.requires_16_byte_alignment = false;
}

pub fn lir_body_new(arena: mut_view<Arena>) -> *mut LirBody {
    let body = arena_alloc_raw(mut_view(*arena), size_of<LirBody>(), align_of<LirBody>()) as *mut LirBody;
    let arena_ptr = unsafe { address_of_mut(arena.head) as *mut Arena };
    unsafe {
        lir_body_reset(mut_view(*body), arena_ptr);
    }
    body
}

