pub const LIR_INST_NEG: u8 = 11u8;
pub const LIR_INST_NOT: u8 = 12u8;
pub const LIR_INST_BITNOT: u8 = 13u8;
pub const LIR_INST_ICMP_EQ: u8 = 14u8;
pub const LIR_INST_ICMP_NE: u8 = 15u8;
pub const LIR_INST_ICMP_SLT: u8 = 16u8;
pub const LIR_INST_ICMP_SLE: u8 = 17u8;
