// Axiom Compiler — LIR Data Model & Text Printer (compiler/lir/lir.ax)
// Port of bootstrap/axiom0/src/lir/lir.h and bootstrap/axiom0/src/lir/print.c.
module compiler.lir.lir

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.TypeId
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_bytes
use compiler.diag.format.diag_buf_push_u32

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub fn lir_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub const LIR_VREG_NONE: u32 = 0xFFFFFFFFu32;
pub const LIR_SLOT_NONE: u32 = 0xFFFFFFFFu32;
pub const LIR_BB_NONE: u32 = 0xFFFFFFFFu32;

pub struct LirVRegId {
    pub v: u32,
}

pub struct LirStackSlotId {
    pub v: u32,
}

pub struct LirBbId {
    pub v: u32,
}

pub struct LirStackSlot {
    pub ty: TypeId,
    pub is_const: bool,
}

pub struct LirVReg {
    pub ty: TypeId,
}

pub const LIR_INST_ADD: u8 = 0u8;
pub const LIR_INST_SUB: u8 = 1u8;
pub const LIR_INST_MUL: u8 = 2u8;
pub const LIR_INST_DIV: u8 = 3u8;
pub const LIR_INST_REM: u8 = 4u8;
pub const LIR_INST_BIT_XOR: u8 = 5u8;
