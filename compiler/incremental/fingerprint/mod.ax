pub struct FpStream128 {
    pub lo: u64,
    pub hi: u64,
    pub tier: u8,
}

fn fp_mix_word(h: u64, w: u64) -> u64 {
    let m = wrapping_mul_u64(rotate_left_u64(wrapping_mul_u64(w, 0xC2B2AE3D27D4EB4Fu64), 31u32), 0x9E3779B97F4A7C15u64);
    wrapping_add_u64(wrapping_mul_u64(rotate_left_u64(h ^ m, 27u32), 0x9E3779B97F4A7C15u64), 0x165667B19E3779F9u64)
}

fn fp_domain_seed_lo(tier: u8) -> u64 {
    if tier == FP_TIER_SOURCE { return 0x4158494F4D535243u64; }    // "AXIOMSRC"
    if tier == FP_TIER_AST { return 0x4158494F4D415354u64; }       // "AXIOMAST"
    if tier == FP_TIER_INTERFACE { return 0x4158494F4D415049u64; } // "AXIOMAPI"
    if tier == FP_TIER_ABI { return 0x4158494F4D414249u64; }       // "AXIOMABI"
    if tier == FP_TIER_BODY { return 0x4158494F4D424F44u64; }      // "AXIOMBOD"
    if tier == FP_TIER_CODEGEN { return 0x4158494F4D434755u64; }   // "AXIOMCGU"
    0x4158494F4D414354u64                                          // "AXIOMACT"
}

fn fp_domain_seed_hi(tier: u8) -> u64 {
    fp_mix_word(0x27D4EB2F165667C5u64, fp_domain_seed_lo(tier) ^ ((tier as u64) + 0x5631u64))
}

pub fn fp_stream_new(tier: u8) -> FpStream128 {
    FpStream128 {
        lo: fp_mix_word(0x27D4EB2F165667C5u64, fp_domain_seed_lo(tier)),
        hi: fp_domain_seed_hi(tier),
        tier: tier,
    }
}

pub fn fp_stream_init(s: mut_view<FpStream128>, tier: u8) {
    s.lo = fp_mix_word(0x27D4EB2F165667C5u64, fp_domain_seed_lo(tier));
    s.hi = fp_domain_seed_hi(tier);
    s.tier = tier;
}

pub fn fp_stream_write_u8(s: mut_view<FpStream128>, b: u8) {
    s.lo = fp_mix_word(s.lo, (b as u64) | 0x01000000u64);
    s.hi = fp_mix_word(s.hi, ((b ^ 0x5Au8) as u64) | 0x02000000u64);
}

pub fn fp_stream_write_u32(s: mut_view<FpStream128>, v: u32) {
    s.lo = fp_mix_word(s.lo, (v as u64) | 0x0400000000u64);
    s.hi = fp_mix_word(s.hi, ((v ^ 0xA5A55A5Au32) as u64) | 0x0800000000u64);
}

pub fn fp_stream_write_u64(s: mut_view<FpStream128>, v: u64) {
    s.lo = fp_mix_word(s.lo, v);
    s.hi = fp_mix_word(s.hi, v ^ 0x9E3779B97F4A7C15u64);
}

pub fn fp_stream_write_bytes(s: mut_view<FpStream128>, ptr: *const u8, len: usize) {
    fp_stream_write_u64(mut_view(*s), len as u64);
    if len == 0 || ptr as usize == 0 {
        return;
    }
    let mut i: usize = 0;
    while (i + 8) <= len {
        let b0 = unsafe { *(ptr + i) } as u64;
        let b1 = unsafe { *(ptr + i + 1) } as u64;
        let b2 = unsafe { *(ptr + i + 2) } as u64;
        let b3 = unsafe { *(ptr + i + 3) } as u64;
        let b4 = unsafe { *(ptr + i + 4) } as u64;
        let b5 = unsafe { *(ptr + i + 5) } as u64;
        let b6 = unsafe { *(ptr + i + 6) } as u64;
        let b7 = unsafe { *(ptr + i + 7) } as u64;
        let w = b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32) | (b4 << 32u32) | (b5 << 40u32) | (b6 << 48u32) | (b7 << 56u32);
        s.lo = fp_mix_word(s.lo, w);
        s.hi = fp_mix_word(s.hi, w ^ 0xC2B2AE3D27D4EB4Fu64);
        i = i + 8;
    }
    if i < len {
        let mut tail: u64 = 0u64;
        let mut shift: u32 = 0u32;
        while i < len {
            let b = unsafe { *(ptr + i) } as u64;
            tail = tail | (b << shift);
            shift = shift + 8u32;
            i = i + 1;
        }
        s.lo = fp_mix_word(s.lo, tail);
        s.hi = fp_mix_word(s.hi, tail ^ 0x165667B19E3779F9u64);
    }
}

pub fn fp_stream_write_sv(s: mut_view<FpStream128>, sv: StrView) {
    fp_stream_write_bytes(s, sv.ptr, sv.len);
}

pub fn fp_stream_write_fp128(s: mut_view<FpStream128>, fp: Fingerprint128) {
    fp_stream_write_u64(mut_view(*s), fp.lo);
    fp_stream_write_u64(mut_view(*s), fp.hi);
}

pub fn fp_stream_write_semantic_key(s: mut_view<FpStream128>, sk: view<SemanticKey>) {
    fp_stream_write_sv(mut_view(*s), sk.package_name);
    fp_stream_write_sv(mut_view(*s), sk.module_path);
    fp_stream_write_u8(mut_view(*s), sk.item_namespace);
    fp_stream_write_u32(mut_view(*s), sk.disambiguator_index);
    fp_stream_write_sv(mut_view(*s), sk.canonical_name);
    fp_stream_write_sv(mut_view(*s), sk.canonical_type_args);
}

pub fn fp_stream_finish(s: view<FpStream128>) -> Fingerprint128 {
    let lo = fp_mix_word(s.lo, fp_domain_seed_lo(s.tier) ^ 0x9FB21C651E98DF25u64);
    let hi = fp_mix_word(s.hi ^ rotate_left_u64(lo, 19u32), fp_domain_seed_hi(s.tier));
    Fingerprint128 { lo: lo, hi: hi }
}

// ============================================================================
// 2. Multi-Tier Fingerprint Records (AXS-INC-002)
// ============================================================================

@derive(Copy)
pub struct SourceFingerprint {
    pub file_id: SourceFileId,
    pub logical_path: StrView,
    pub normalized_len: u32,
    pub fp: Fingerprint128,
}

@derive(Copy)
pub struct AstItemFingerprint {
    pub def_id: DefId,
    pub module_id: ModuleId,
    pub semantic_key: SemanticKey,
    pub item_kind: u8,
    pub is_pub: bool,
    pub is_inline: bool,
    pub is_generic: bool,
    pub is_comptime: bool,
    pub repr_tag: u8,
    pub explicit_align: u32,
    pub calling_conv: u8,
    pub param_count: u32,
    pub return_type_tag: u32,
    pub generic_param_count: u32,
    pub const_literal_val: i64,
    pub token_count: u32,
    pub header_fp: Fingerprint128,
    pub body_fp: Fingerprint128,
    pub item_fp: Fingerprint128,
}

@derive(Copy)
pub struct AstFingerprint {
    pub module_id: ModuleId,
    pub item_count: u32,
    pub token_count: u32,
    pub fp: Fingerprint128,
}

@derive(Copy)
pub struct InterfaceFingerprint {
    pub owner_id: u32,
    pub is_module: bool,
    pub is_pub: bool,
    pub exported_count: u32,
    pub fp: Fingerprint128,
}

@derive(Copy)
pub struct AbiFingerprint {
    pub owner_id: u32,
    pub repr_tag: u8,
    pub calling_conv: u8,
    pub size_bytes: u32,
    pub align_bytes: u32,
    pub field_count: u32,
    pub fp: Fingerprint128,
}

@derive(Copy)
pub struct BodyFingerprint {
    pub def_id: DefId,
    pub mir_blocks: u32,
    pub mir_locals: u32,
    pub callee_count: u32,
    pub const_dep_count: u32,
    pub layout_dep_count: u32,
    pub ownership_verified: bool,
    pub fp: Fingerprint128,
}

@derive(Copy)
pub struct CodegenFingerprint {
    pub owner_id: u32,
    pub is_module_cgu: bool,
    pub inlined_body_deps: u32,
    pub generic_body_deps: u32,
    pub const_body_deps: u32,
    pub abi_deps: u32,
    pub fp: Fingerprint128,
}

// ============================================================================
// 3. Tier 0 (`SourceFingerprint`) & Tier 1 (`AstFingerprint`) Normalizer
// ============================================================================

// Computes Tier 0 `SourceFingerprint` over normalized LF UTF-8 bytes + logical path.
// Insensitive to OS file `mtime`, physical workspace root path, and CRLF vs LF line endings (AXS-INC-002).
pub fn fp_compute_source_with_meta(
    file_id: SourceFileId,
    _workspace_root_ignored: StrView,
    logical_path: StrView,
    raw_text: StrView,
    _mtime_ns_ignored: u64
) -> SourceFingerprint {
    let mut s = fp_stream_new(FP_TIER_SOURCE);
    fp_stream_write_sv(mut_view(s), logical_path);
    let mut norm_len: u32 = 0u32;
    if raw_text.len > 0 && (raw_text.ptr as usize) != 0 {
        let mut i: usize = 0;
        while i < raw_text.len {
            let b = unsafe { *(raw_text.ptr + i) };
            if b == 13u8 {
                // Normalize CRLF or bare CR to single LF (10u8)
                if (i + 1) < raw_text.len && unsafe { *(raw_text.ptr + i + 1) } == 10u8 {
                    i = i + 1;
                }
                fp_stream_write_u8(mut_view(s), 10u8);
                norm_len = norm_len + 1u32;
            } else {
                fp_stream_write_u8(mut_view(s), b);
                norm_len = norm_len + 1u32;
            }
            i = i + 1;
        }
    }
    fp_stream_write_u32(mut_view(s), norm_len);
    SourceFingerprint {
        file_id: file_id,
        logical_path: logical_path,
        normalized_len: norm_len,
        fp: fp_stream_finish(view(s)),
    }
}

pub fn fp_compute_source(file_id: SourceFileId, logical_path: StrView, raw_text: StrView) -> SourceFingerprint {
    fp_compute_source_with_meta(file_id, qry_sv_empty(), logical_path, raw_text, 0u64)
}

fn fp_is_ws(b: u8) -> bool {
    b == 32u8 || b == 9u8 || b == 10u8 || b == 13u8
}

fn fp_is_ident_start(b: u8) -> bool {
    (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8) || b == 95u8
}

fn fp_is_ident_cont(b: u8) -> bool {
    fp_is_ident_start(b) || (b >= 48u8 && b <= 57u8)
}

fn fp_is_digit(b: u8) -> bool {
    b >= 48u8 && b <= 57u8
}

// Skips whitespace and non-doc comments (`//` not followed by `/`, and nested `/* ... */`) per AXS-INC-002 Tier 1.
fn fp_skip_ws_and_nondoc_comments(ptr: *const u8, len: usize, mut pos: usize) -> usize {
    while pos < len {
        let b = unsafe { *(ptr + pos) };
        if fp_is_ws(b) {
            pos = pos + 1;
        } else if b == 47u8 && (pos + 1) < len && unsafe { *(ptr + pos + 1) } == 47u8 {
            // Check if doc comment `///` (3rd char is `/` and 4th is not `/`)
            let is_doc = (pos + 2) < len && unsafe { *(ptr + pos + 2) } == 47u8 &&
                ((pos + 3) >= len || unsafe { *(ptr + pos + 3) } != 47u8);
            if is_doc {
                return pos;
            }
            pos = pos + 2;
            while pos < len && unsafe { *(ptr + pos) } != 10u8 {
                pos = pos + 1;
            }
        } else if b == 47u8 && (pos + 1) < len && unsafe { *(ptr + pos + 1) } == 42u8 {
            // Nested block comment `/* ... */`
            pos = pos + 2;
            let mut depth: u32 = 1u32;
            while pos < len && depth > 0u32 {
                let c0 = unsafe { *(ptr + pos) };
                if c0 == 47u8 && (pos + 1) < len && unsafe { *(ptr + pos + 1) } == 42u8 {
                    depth = depth + 1u32;
                    pos = pos + 2;
                } else if c0 == 42u8 && (pos + 1) < len && unsafe { *(ptr + pos + 1) } == 47u8 {
                    depth = depth - 1u32;
                    pos = pos + 2;
                } else {
                    pos = pos + 1;
                }
            }
        } else {
            return pos;
        }
    }
    pos
}

// Streams canonical tokens from `ptr[start..end]` into `s`, stripping whitespace, line breaks,
// byte spans, and non-doc comments (`//`, `/* */`). Returns the number of canonical tokens hashed.
pub fn fp_hash_canonical_tokens(s: mut_view<FpStream128>, ptr: *const u8, start: usize, end: usize) -> u32 {
    if ptr as usize == 0 || start >= end {
        return 0u32;
    }
    let mut pos = start;
    let mut tok_count: u32 = 0u32;
    while pos < end {
        pos = fp_skip_ws_and_nondoc_comments(ptr, end, pos);
        if pos >= end {
            break;
        }
        let b = unsafe { *(ptr + pos) };
        if b == 47u8 && (pos + 2) < end && unsafe { *(ptr + pos + 1) } == 47u8 && unsafe { *(ptr + pos + 2) } == 47u8 {
            // Doc comment `/// ...` (trimmed)
            pos = pos + 3;
            while pos < end && (unsafe { *(ptr + pos) } == 32u8 || unsafe { *(ptr + pos) } == 9u8) {
                pos = pos + 1;
            }
            let doc_start = pos;
            while pos < end && unsafe { *(ptr + pos) } != 10u8 && unsafe { *(ptr + pos) } != 13u8 {
                pos = pos + 1;
            }
            let mut doc_end = pos;
            while doc_end > doc_start && (unsafe { *(ptr + doc_end - 1) } == 32u8 || unsafe { *(ptr + doc_end - 1) } == 9u8) {
                doc_end = doc_end - 1;
            }
            fp_stream_write_u8(mut_view(*s), 1u8); // TOK_DOC
            fp_stream_write_bytes(mut_view(*s), unsafe { ptr + doc_start }, doc_end - doc_start);
            tok_count = tok_count + 1u32;
        } else if fp_is_ident_start(b) {
            let id_start = pos;
            pos = pos + 1;
            while pos < end && fp_is_ident_cont(unsafe { *(ptr + pos) }) {
                pos = pos + 1;
            }
            fp_stream_write_u8(mut_view(*s), 2u8); // TOK_IDENT_OR_KW
            fp_stream_write_bytes(mut_view(*s), unsafe { ptr + id_start }, pos - id_start);
            tok_count = tok_count + 1u32;
        } else if fp_is_digit(b) {
            let num_start = pos;
            pos = pos + 1;
            while pos < end && (fp_is_ident_cont(unsafe { *(ptr + pos) }) || unsafe { *(ptr + pos) } == 46u8) {
                pos = pos + 1;
            }
            fp_stream_write_u8(mut_view(*s), 3u8); // TOK_NUMBER
            fp_stream_write_bytes(mut_view(*s), unsafe { ptr + num_start }, pos - num_start);
            tok_count = tok_count + 1u32;
        } else if b == 34u8 || b == 39u8 {
            // String or char literal
            let quote = b;
            let lit_start = pos;
            pos = pos + 1;
            while pos < end {
                let c = unsafe { *(ptr + pos) };
                if c == 92u8 && (pos + 1) < end {
                    pos = pos + 2;
                } else if c == quote {
                    pos = pos + 1;
                    break;
                } else {
                    pos = pos + 1;
                }
            }
            fp_stream_write_u8(mut_view(*s), 4u8); // TOK_STRING_OR_CHAR
            fp_stream_write_bytes(mut_view(*s), unsafe { ptr + lit_start }, pos - lit_start);
            tok_count = tok_count + 1u32;
        } else if b == 59u8 {
            // Optional trailing semicolon `;` is elided in canonical Axiom token stream
            pos = pos + 1;
        } else {
            fp_stream_write_u8(mut_view(*s), 5u8); // TOK_PUNCT
            fp_stream_write_u8(mut_view(*s), b);
            pos = pos + 1;
            tok_count = tok_count + 1u32;
        }
    }
    tok_count
}

// Computes module-level `AstFingerprint` from raw source text (comment/whitespace-insensitive).
pub fn fp_compute_ast_fingerprint(module_id: ModuleId, module_path: StrView, raw_text: StrView, item_count: u32) -> AstFingerprint {
    let mut s = fp_stream_new(FP_TIER_AST);
    fp_stream_write_sv(mut_view(s), module_path);
    let tok_count = fp_hash_canonical_tokens(mut_view(s), raw_text.ptr, 0, raw_text.len);
    fp_stream_write_u32(mut_view(s), item_count);
    AstFingerprint {
        module_id: module_id,
        item_count: item_count,
        token_count: tok_count,
        fp: fp_stream_finish(view(s)),
    }
}

// ============================================================================
// 4. Incremental Item Descriptors, Red-Green Nodes & Typed Dependency Edges
// ============================================================================

pub const INC_MAX_ITEMS: usize = 128;
pub const INC_MAX_MODULES: usize = 32;
pub const INC_MAX_NODES: usize = 512;
pub const INC_MAX_EDGES_PER_NODE: usize = 24;

@derive(Copy)
pub struct TypedDepEdge {
    pub dep_node_idx: u32,
    pub dep_kind: u8,
    pub observed_fp: Fingerprint128,
}

@derive(Copy)
pub struct RedGreenNode {
    pub node_idx: u32,
    pub node_kind: u8,
    pub owner_id: u32,
    pub semantic_key: SemanticKey,
    pub color: u8,
    pub verified_at: RevisionId,
    pub changed_at: RevisionId,
    pub was_backdated: bool,
    pub is_error: bool,
    pub last_miss_reason: u8,
    pub recompute_count: u32,
    pub green_reuse_count: u32,
    pub backdate_count: u32,
    pub fp: Fingerprint128,
    pub aux_fp: Fingerprint128,
    pub edges: [24]TypedDepEdge,
    pub edge_count: u32,
}

@derive(Copy)
pub struct IncItemRecord {
    pub def_id: DefId,
    pub module_id: ModuleId,
    pub semantic_key: SemanticKey,
    pub item_kind: u8,
    pub is_pub: bool,
    pub is_inline: bool,
    pub is_generic: bool,
    pub is_comptime: bool,
    pub has_inferred_return: bool,
    pub has_body_type_error: bool,
    pub repr_tag: u8,
    pub calling_conv: u8,
    pub explicit_align: u32,
    pub size_bytes: u32,
    pub align_bytes: u32,
    pub param_count: u32,
    pub return_type_tag: u32,
    pub generic_param_count: u32,
    pub const_val: i64,
    pub ast_header_fp: Fingerprint128,
    pub ast_body_fp: Fingerprint128,
    pub ast_item_fp: Fingerprint128,
    pub interface_fp: Fingerprint128,
    pub abi_fp: Fingerprint128,
    pub body_fp: Fingerprint128,
    pub codegen_fp: Fingerprint128,
    pub sig_deps: [8]u32,
    pub sig_dep_count: u32,
    pub call_deps: [16]u32,
    pub call_dep_count: u32,
    pub const_deps: [8]u32,
    pub const_dep_count: u32,
    pub layout_deps: [8]u32,
    pub layout_dep_count: u32,
}

@derive(Copy)
pub struct IncModuleRecord {
    pub module_id: ModuleId,
    pub package_id: PackageId,
    pub source_file_id: SourceFileId,
    pub semantic_key: SemanticKey,
    pub logical_path: StrView,
    pub raw_text: StrView,
    pub imported_modules: [8]u32,
    pub imported_module_count: u32,
    pub source_fp: Fingerprint128,
    pub ast_fp: Fingerprint128,
    pub interface_fp: Fingerprint128,
    pub codegen_fp: Fingerprint128,
    pub typechecked_at_rev: RevisionId,
    pub cgu_rebuilt_at_rev: RevisionId,
    pub cgu_reused_at_rev: RevisionId,
}

pub struct IncrementalEngine {
    pub db: CompilerDB,
    pub inc_arena: Arena,
    pub current_revision: RevisionId,
    pub target_config_fp: Fingerprint128,
    pub target_opt_level: u8,
    pub target_feature_flags: u32,
    pub target_pointer_width: u32,

    pub modules: *mut IncModuleRecord,
    pub module_count: u32,
    pub items: *mut IncItemRecord,
    pub item_count: u32,
    pub nodes: *mut RedGreenNode,
    pub node_count: u32,

    // Per-revision & cumulative telemetry counters (AXS-INC-013 §2)
    pub rev_queries_total: u32,
    pub rev_queries_green_reused: u32,
    pub rev_queries_recomputed: u32,
    pub rev_queries_backdated: u32,
    pub rev_modules_typechecked: u32,
    pub rev_cgu_reused: u32,
    pub rev_cgu_rebuilt: u32,

    pub total_queries_green_reused: u32,
    pub total_queries_recomputed: u32,
    pub total_queries_backdated: u32,
}

fn fp_zero_bytes(ptr: *mut u8, count: usize) {
    let mut i: usize = 0;
    while (i + 8) <= count {
        unsafe { *((ptr + i) as *mut u64) = 0u64; }
        i = i + 8;
    }
    while i < count {
        unsafe { *(ptr + i) = 0u8; }
        i = i + 1;
    }
}

pub fn inc_engine_empty() -> IncrementalEngine {
    IncrementalEngine {
        db: query_db_empty(),
        inc_arena: arena_new(),
        current_revision: revision_id_zero(),
        target_config_fp: fingerprint128_zero(),
        target_opt_level: 0u8,
        target_feature_flags: 0u32,
        target_pointer_width: 8u32,
        modules: 0 as *mut IncModuleRecord,
        module_count: 0u32,
        items: 0 as *mut IncItemRecord,
        item_count: 0u32,
        nodes: 0 as *mut RedGreenNode,
        node_count: 0u32,
        rev_queries_total: 0u32,
        rev_queries_green_reused: 0u32,
        rev_queries_recomputed: 0u32,
        rev_queries_backdated: 0u32,
        rev_modules_typechecked: 0u32,
        rev_cgu_reused: 0u32,
        rev_cgu_rebuilt: 0u32,
        total_queries_green_reused: 0u32,
        total_queries_recomputed: 0u32,
        total_queries_backdated: 0u32,
    }
}

pub fn inc_engine_init(eng: mut_view<IncrementalEngine>, session_id: u64) {
    eng.db.session_id = session_id;
    eng.inc_arena = arena_new();
    eng.current_revision = revision_id_new(1u64);
    eng.db.current_revision = revision_id_new(1u64);
    eng.target_opt_level = 2u8;
    eng.target_feature_flags = 0u32;
    eng.target_pointer_width = 8u32;

    let mut cfg_s = fp_stream_new(FP_TIER_ACTION);
    fp_stream_write_u32(mut_view(cfg_s), 2u32);
    fp_stream_write_u32(mut_view(cfg_s), 8u32);
    eng.target_config_fp = fp_stream_finish(view(cfg_s));

    let mod_bytes = INC_MAX_MODULES * size_of<IncModuleRecord>();
    eng.modules = arena_alloc_raw(mut_view(eng.inc_arena), mod_bytes, align_of<IncModuleRecord>()) as *mut IncModuleRecord;
    fp_zero_bytes(eng.modules as *mut u8, size_of<IncModuleRecord>());
    eng.module_count = 0u32;

    let item_bytes = INC_MAX_ITEMS * size_of<IncItemRecord>();
    eng.items = arena_alloc_raw(mut_view(eng.inc_arena), item_bytes, align_of<IncItemRecord>()) as *mut IncItemRecord;
    fp_zero_bytes(eng.items as *mut u8, size_of<IncItemRecord>());
    eng.item_count = 0u32;

    let node_bytes = INC_MAX_NODES * size_of<RedGreenNode>();
    eng.nodes = arena_alloc_raw(mut_view(eng.inc_arena), node_bytes, align_of<RedGreenNode>()) as *mut RedGreenNode;
    fp_zero_bytes(eng.nodes as *mut u8, size_of<RedGreenNode>());
    eng.node_count = 0u32;

    eng.rev_queries_total = 0u32;
    eng.rev_queries_green_reused = 0u32;
    eng.rev_queries_recomputed = 0u32;
    eng.rev_queries_backdated = 0u32;
    eng.rev_modules_typechecked = 0u32;
    eng.rev_cgu_reused = 0u32;
    eng.rev_cgu_rebuilt = 0u32;
    eng.total_queries_green_reused = 0u32;
    eng.total_queries_recomputed = 0u32;
    eng.total_queries_backdated = 0u32;
}

pub fn inc_engine_free(eng: mut_view<IncrementalEngine>) {
    query_db_free(mut_view(eng.db));
    arena_destroy(mut_view(eng.inc_arena));
    eng.modules = 0 as *mut IncModuleRecord;
    eng.items = 0 as *mut IncItemRecord;
    eng.nodes = 0 as *mut RedGreenNode;
}

pub fn inc_engine_reset_rev_stats(eng: mut_view<IncrementalEngine>) {
    eng.rev_queries_total = 0u32;
    eng.rev_queries_green_reused = 0u32;
    eng.rev_queries_recomputed = 0u32;
    eng.rev_queries_backdated = 0u32;
    eng.rev_modules_typechecked = 0u32;
    eng.rev_cgu_reused = 0u32;
    eng.rev_cgu_rebuilt = 0u32;
}

pub fn inc_engine_begin_revision(eng: mut_view<IncrementalEngine>) -> RevisionId {
    let next_r = revision_id_next(eng.current_revision);
    eng.current_revision = next_r;
    eng.db.current_revision = next_r;
    inc_engine_reset_rev_stats(mut_view(*eng));

    // Mark all derived red-green nodes as Unknown(R_prev) for lazy `try_mark_green` verification
    let mut i: u32 = 0u32;
    while i < eng.node_count {
        let np = unsafe { eng.nodes + (i as usize) };
        let nk = unsafe { (*np).node_kind };
        if nk >= INC_NODE_PARSE_MODULE && unsafe { (*np).recompute_count } > 0u32 {
            unsafe {
                (*np).color = NODE_COLOR_UNKNOWN;
                (*np).was_backdated = false;
                (*np).last_miss_reason = MISS_NONE;
            }
        }
        i = i + 1u32;
    }
    next_r
}

fn inc_find_or_create_node(
    eng: mut_view<IncrementalEngine>,
    node_kind: u8,
    owner_id: u32,
    sk: SemanticKey
) -> u32 {
    let mut i: u32 = 0u32;
    while i < eng.node_count {
        let cur = unsafe { *(eng.nodes + (i as usize)) };
        if cur.node_kind == node_kind && cur.owner_id == owner_id {
            return i;
        }
        i = i + 1u32;
    }
    let idx = eng.node_count;
    if (idx as usize) >= INC_MAX_NODES {
        return (INC_MAX_NODES - 1) as u32;
    }
    eng.node_count = idx + 1u32;
    let np = unsafe { eng.nodes + (idx as usize) };
    fp_zero_bytes(np as *mut u8, size_of<RedGreenNode>());
    unsafe {
        (*np).node_idx = idx;
        (*np).node_kind = node_kind;
        (*np).owner_id = owner_id;
        (*np).semantic_key = sk;
        (*np).color = NODE_COLOR_UNKNOWN;
        (*np).verified_at = revision_id_zero();
        (*np).changed_at = revision_id_zero();
        (*np).last_miss_reason = MISS_COLD_CACHE;
        (*np).fp = fingerprint128_zero();
        (*np).aux_fp = fingerprint128_zero();
    }
    idx
}

fn inc_node_clear_edges(eng: mut_view<IncrementalEngine>, node_idx: u32) {
    let np = unsafe { eng.nodes + (node_idx as usize) };
    unsafe { (*np).edge_count = 0u32; }
}

fn inc_node_add_edge(
    eng: mut_view<IncrementalEngine>,
    caller_node_idx: u32,
    dep_node_idx: u32,
    dep_kind: u8,
    observed_fp: Fingerprint128
) {
    let np = unsafe { eng.nodes + (caller_node_idx as usize) };
    let ec = unsafe { (*np).edge_count };
    let mut i: u32 = 0u32;
    while i < ec {
        let ex = unsafe { (*np).edges[i as usize] };
        if ex.dep_node_idx == dep_node_idx && ex.dep_kind == dep_kind {
            unsafe { (*np).edges[i as usize].observed_fp = observed_fp; }
            return;
        }
        i = i + 1u32;
    }
    if (ec as usize) < (INC_MAX_EDGES_PER_NODE) {
        unsafe {
            (*np).edges[ec as usize] = TypedDepEdge {
                dep_node_idx: dep_node_idx,
                dep_kind: dep_kind,
                observed_fp: observed_fp,
            };
            (*np).edge_count = ec + 1u32;
        }
    }
}

pub fn inc_find_module_index(eng: view<IncrementalEngine>, module_id: ModuleId) -> usize {
    let mut i: usize = 0;
    while i < (eng.module_count as usize) {
        let m = unsafe { *(eng.modules + i) };
        if m.module_id.v == module_id.v {
            return i;
        }
        i = i + 1;
    }
    INC_MAX_MODULES
}

pub fn inc_find_item_index(eng: view<IncrementalEngine>, def_id: DefId) -> usize {
    let mut i: usize = 0;
    while i < (eng.item_count as usize) {
        let it = unsafe { *(eng.items + i) };
        if it.def_id.v == def_id.v {
            return i;
        }
        i = i + 1;
    }
    INC_MAX_ITEMS
}

pub fn inc_get_item(eng: view<IncrementalEngine>, def_id: DefId) -> IncItemRecord {
    let idx = inc_find_item_index(eng, def_id);
    if (idx) < (INC_MAX_ITEMS) {
        return unsafe { *(eng.items + idx) };
    }
    unsafe { *eng.items }
}

pub fn inc_get_module(eng: view<IncrementalEngine>, module_id: ModuleId) -> IncModuleRecord {
    let idx = inc_find_module_index(eng, module_id);
    if (idx) < (INC_MAX_MODULES) {
        return unsafe { *(eng.modules + idx) };
    }
    unsafe { *eng.modules }
}

// ============================================================================
// 5. Registration, Source Scanning & Input Mutation APIs
// ============================================================================

pub fn inc_set_target_config(
    eng: mut_view<IncrementalEngine>,
    unit_key: UnitKey,
    target_triple: StrView,
    abi_profile: StrView,
    feature_flags: u32,
    opt_level: u8,
    pointer_width_bytes: u32
) {
    let tt_sv = query_db_intern_sv(mut_view(eng.db), target_triple);
    let ab_sv = query_db_intern_sv(mut_view(eng.db), abi_profile);
    if eng.total_queries_recomputed == 0u32 {
        eng.current_revision = revision_id_new(1u64);
        eng.db.current_revision = revision_id_new(1u64);
    } else {
        let _ = inc_engine_begin_revision(mut_view(*eng));
    }
    eng.target_opt_level = opt_level;
    eng.target_feature_flags = feature_flags;
    eng.target_pointer_width = pointer_width_bytes;

    let mut s = fp_stream_new(FP_TIER_ACTION);
    fp_stream_write_sv(mut_view(s), tt_sv);
    fp_stream_write_sv(mut_view(s), ab_sv);
    fp_stream_write_u32(mut_view(s), feature_flags);
    fp_stream_write_u8(mut_view(s), opt_level);
    fp_stream_write_u32(mut_view(s), pointer_width_bytes);
    let cfg_fp = fp_stream_finish(view(s));
    let old_cfg_fp = eng.target_config_fp;
    eng.target_config_fp = cfg_fp;

    let sk = semantic_key_new(qry_sv_empty(), tt_sv, ITEM_NS_UNIT, 0u32, ab_sv, qry_sv_empty());
    let n_idx = inc_find_or_create_node(mut_view(*eng), INC_NODE_TARGET_CONFIG, unit_key.v, sk);
    let np = unsafe { eng.nodes + (n_idx as usize) };
    let r = eng.current_revision;
    unsafe {
        (*np).verified_at = r;
        if !fingerprint128_eq(old_cfg_fp, cfg_fp) {
            (*np).changed_at = r;
            (*np).color = NODE_COLOR_RED;
        } else {
            (*np).color = NODE_COLOR_GREEN;
        }
        (*np).fp = cfg_fp;
    }
}

pub fn inc_register_module(
    eng: mut_view<IncrementalEngine>,
    module_id: ModuleId,
    package_id: PackageId,
    package_name: StrView,
    module_path: StrView,
    source_file_id: SourceFileId,
    logical_path: StrView,
    raw_text: StrView
) {
    let pkg_sv = query_db_intern_sv(mut_view(eng.db), package_name);
    let mod_sv = query_db_intern_sv(mut_view(eng.db), module_path);
    let path_sv = query_db_intern_sv(mut_view(eng.db), logical_path);
    let text_sv = query_db_intern_sv(mut_view(eng.db), raw_text);

    if eng.total_queries_recomputed == 0u32 {
        eng.current_revision = revision_id_new(1u64);
        eng.db.current_revision = revision_id_new(1u64);
    } else {
        eng.current_revision = eng.db.current_revision;
    }

    let src_fp_rec = fp_compute_source(source_file_id, path_sv, text_sv);
    let mod_sk = semantic_key_new(pkg_sv, mod_sv, ITEM_NS_MODULE, 0u32, mod_sv, qry_sv_empty());

    let mut m_idx = inc_find_module_index(view(*eng), module_id);
    if m_idx >= INC_MAX_MODULES {
        m_idx = eng.module_count as usize;
        eng.module_count = eng.module_count + 1u32;
        let mp = unsafe { eng.modules + m_idx };
        fp_zero_bytes(mp as *mut u8, size_of<IncModuleRecord>());
    }
    let mp = unsafe { eng.modules + m_idx };
    unsafe {
        (*mp).module_id = module_id;
        (*mp).package_id = package_id;
        (*mp).source_file_id = source_file_id;
        (*mp).semantic_key = mod_sk;
        (*mp).logical_path = path_sv;
        (*mp).raw_text = text_sv;
        (*mp).source_fp = src_fp_rec.fp;
    }

    let src_sk = semantic_key_new(qry_sv_empty(), path_sv, ITEM_NS_SOURCE, 0u32, path_sv, qry_sv_empty());
    let src_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_SOURCE_FILE, source_file_id.v, src_sk);
    let snp = unsafe { eng.nodes + (src_node as usize) };
    unsafe {
        (*snp).color = NODE_COLOR_RED;
        (*snp).verified_at = eng.current_revision;
        (*snp).changed_at = eng.current_revision;
        (*snp).fp = src_fp_rec.fp;
    }

    let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_PARSE_MODULE, module_id.v, mod_sk);
    let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_RESOLVE_MODULE, module_id.v, mod_sk);
    let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_MODULE_INTERFACE, module_id.v, mod_sk);
    let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_CODEGEN_UNIT, module_id.v, mod_sk);
}

pub fn inc_add_module_import(eng: mut_view<IncrementalEngine>, importer: ModuleId, imported: ModuleId) {
    let m_idx = inc_find_module_index(view(*eng), importer);
    if m_idx >= INC_MAX_MODULES {
        return;
    }
    let mp = unsafe { eng.modules + m_idx };
    let cnt = unsafe { (*mp).imported_module_count };
    let mut i: u32 = 0u32;
    while i < cnt {
        if unsafe { (*mp).imported_modules[i as usize] } == imported.v {
            return;
        }
        i = i + 1u32;
    }
    if cnt < 8u32 {
        unsafe {
            (*mp).imported_modules[cnt as usize] = imported.v;
            (*mp).imported_module_count = cnt + 1u32;
        }
    }
}

pub fn inc_register_item(
    eng: mut_view<IncrementalEngine>,
    def_id: DefId,
    module_id: ModuleId,
    item_kind: u8,
    is_pub: bool,
    is_inline: bool,
    is_generic: bool,
    param_count: u32,
    return_type_tag: u32,
    canonical_name: StrView,
    canonical_type_args: StrView
) -> DefId {
    let mod_rec = inc_get_module(view(*eng), module_id);
    let name_sv = query_db_intern_sv(mut_view(eng.db), canonical_name);
    let targs_sv = query_db_intern_sv(mut_view(eng.db), canonical_type_args);
    let item_ns = if item_kind == ITEM_KIND_FN {
        ITEM_NS_VALUE
    } else if item_kind == ITEM_KIND_CONST {
        ITEM_NS_CONST
    } else if item_kind == ITEM_KIND_TRAIT {
        ITEM_NS_TRAIT
    } else {
        ITEM_NS_TYPE
    };
    let sk = semantic_key_new(mod_rec.semantic_key.package_name, mod_rec.semantic_key.module_path, item_ns, 0u32, name_sv, targs_sv);

    let mut idx = inc_find_item_index(view(*eng), def_id);
    if idx >= INC_MAX_ITEMS {
        idx = eng.item_count as usize;
        eng.item_count = eng.item_count + 1u32;
        let ip = unsafe { eng.items + idx };
        fp_zero_bytes(ip as *mut u8, size_of<IncItemRecord>());
    }
    let ip = unsafe { eng.items + idx };
    let mut def_hdr = fp_stream_new(FP_TIER_AST);
    fp_stream_write_semantic_key(mut_view(def_hdr), view(sk));
    fp_stream_write_u8(mut_view(def_hdr), item_kind);
    fp_stream_write_u8(mut_view(def_hdr), if is_pub { 1u8 } else { 0u8 });
    fp_stream_write_u32(mut_view(def_hdr), param_count);
    fp_stream_write_u32(mut_view(def_hdr), return_type_tag);
    let init_hdr_fp = fp_stream_finish(view(def_hdr));

    let mut def_bod = fp_stream_new(FP_TIER_AST);
    fp_stream_write_semantic_key(mut_view(def_bod), view(sk));
    fp_stream_write_u32(mut_view(def_bod), def_id.v);
    let init_bod_fp = fp_stream_finish(view(def_bod));

    let mut def_it = fp_stream_new(FP_TIER_AST);
    fp_stream_write_fp128(mut_view(def_it), init_hdr_fp);
    fp_stream_write_fp128(mut_view(def_it), init_bod_fp);
    let init_item_fp = fp_stream_finish(view(def_it));

    unsafe {
        (*ip).def_id = def_id;
        (*ip).module_id = module_id;
        (*ip).semantic_key = sk;
        (*ip).item_kind = item_kind;
        (*ip).is_pub = is_pub;
        (*ip).is_inline = is_inline;
        (*ip).is_generic = is_generic;
        (*ip).is_comptime = false;
        (*ip).has_inferred_return = false;
        (*ip).has_body_type_error = false;
        (*ip).repr_tag = if item_kind == ITEM_KIND_STRUCT { REPR_C } else { REPR_DEFAULT };
        (*ip).calling_conv = ABI_CC_WIN64;
        (*ip).explicit_align = 0u32;
        (*ip).size_bytes = if item_kind == ITEM_KIND_STRUCT { 8u32 } else { 4u32 };
        (*ip).align_bytes = if item_kind == ITEM_KIND_STRUCT { 4u32 } else { 4u32 };
        (*ip).param_count = param_count;
        (*ip).return_type_tag = return_type_tag;
        (*ip).generic_param_count = if is_generic { 1u32 } else { 0u32 };
        (*ip).const_val = 100i64;
        (*ip).ast_header_fp = init_hdr_fp;
        (*ip).ast_body_fp = init_bod_fp;
        (*ip).ast_item_fp = init_item_fp;
    }

    let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_SIGNATURE, def_id.v, sk);
    let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, def_id.v, sk);
    if item_kind == ITEM_KIND_CONST {
        let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_CONST_EVAL, def_id.v, sk);
    }
    if item_kind == ITEM_KIND_FN {
        let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_TYPECK_BODY, def_id.v, sk);
        let _ = inc_find_or_create_node(mut_view(*eng), INC_NODE_MIR_BODY, def_id.v, sk);
    }
    def_id
}

pub fn inc_set_item_abi_layout(
    eng: mut_view<IncrementalEngine>,
    def_id: DefId,
    repr_tag: u8,
    calling_conv: u8,
    size_bytes: u32,
    align_bytes: u32,
    explicit_align: u32
) {
    let idx = inc_find_item_index(view(*eng), def_id);
    if (idx) < (INC_MAX_ITEMS) {
        let ip = unsafe { eng.items + idx };
        unsafe {
            (*ip).repr_tag = repr_tag;
            (*ip).calling_conv = calling_conv;
            (*ip).size_bytes = size_bytes;
            (*ip).align_bytes = align_bytes;
            (*ip).explicit_align = explicit_align;
        }
    }
}

pub fn inc_set_item_const_val(eng: mut_view<IncrementalEngine>, def_id: DefId, const_val: i64) {
    let idx = inc_find_item_index(view(*eng), def_id);
    if (idx) < (INC_MAX_ITEMS) {
        unsafe { (*(eng.items + idx)).const_val = const_val; }
    }
}

pub fn inc_set_item_error_flag(eng: mut_view<IncrementalEngine>, def_id: DefId, has_type_error: bool) {
    let idx = inc_find_item_index(view(*eng), def_id);
    if (idx) < (INC_MAX_ITEMS) {
        unsafe { (*(eng.items + idx)).has_body_type_error = has_type_error; }
    }
}

pub fn inc_add_item_call_dep(eng: mut_view<IncrementalEngine>, caller_id: DefId, callee_id: DefId) {
    let idx = inc_find_item_index(view(*eng), caller_id);
    if (idx) < (INC_MAX_ITEMS) {
        let ip = unsafe { eng.items + idx };
        let c = unsafe { (*ip).call_dep_count };
        let mut i: u32 = 0u32;
        while i < c {
            if unsafe { (*ip).call_deps[i as usize] } == callee_id.v {
                return;
            }
            i = i + 1u32;
        }
        if c < 16u32 {
            unsafe {
                (*ip).call_deps[c as usize] = callee_id.v;
                (*ip).call_dep_count = c + 1u32;
            }
        }
    }
}

pub fn inc_add_item_sig_dep(eng: mut_view<IncrementalEngine>, item_id: DefId, target_id: DefId) {
    let idx = inc_find_item_index(view(*eng), item_id);
    if (idx) < (INC_MAX_ITEMS) {
        let ip = unsafe { eng.items + idx };
        let c = unsafe { (*ip).sig_dep_count };
        if c < 8u32 {
            unsafe {
                (*ip).sig_deps[c as usize] = target_id.v;
                (*ip).sig_dep_count = c + 1u32;
            }
        }
    }
}

pub fn inc_add_item_const_dep(eng: mut_view<IncrementalEngine>, item_id: DefId, const_def_id: DefId) {
    let idx = inc_find_item_index(view(*eng), item_id);
    if (idx) < (INC_MAX_ITEMS) {
        let ip = unsafe { eng.items + idx };
        let c = unsafe { (*ip).const_dep_count };
        if c < 8u32 {
            unsafe {
                (*ip).const_deps[c as usize] = const_def_id.v;
                (*ip).const_dep_count = c + 1u32;
            }
        }
    }
}

pub fn inc_add_item_layout_dep(eng: mut_view<IncrementalEngine>, item_id: DefId, struct_def_id: DefId) {
    let idx = inc_find_item_index(view(*eng), item_id);
    if (idx) < (INC_MAX_ITEMS) {
        let ip = unsafe { eng.items + idx };
        let c = unsafe { (*ip).layout_dep_count };
        if c < 8u32 {
            unsafe {
                (*ip).layout_deps[c as usize] = struct_def_id.v;
                (*ip).layout_dep_count = c + 1u32;
            }
        }
    }
}

// Updates a module's source text at a new revision (or existing revision) and updates `SourceFingerprint`.
pub fn inc_update_module_source(
    eng: mut_view<IncrementalEngine>,
    module_id: ModuleId,
    new_raw_text: StrView
) -> RevisionId {
    let rev = inc_engine_begin_revision(mut_view(*eng));
    let m_idx = inc_find_module_index(view(*eng), module_id);
    if m_idx >= INC_MAX_MODULES {
        return rev;
    }
    let text_sv = query_db_intern_sv(mut_view(eng.db), new_raw_text);
    let mod_rec = unsafe { *(eng.modules + m_idx) };
    let new_src_fp = fp_compute_source(mod_rec.source_file_id, mod_rec.logical_path, text_sv);
    let old_src_fp = mod_rec.source_fp;

    unsafe {
        (*(eng.modules + m_idx)).raw_text = text_sv;
        (*(eng.modules + m_idx)).source_fp = new_src_fp.fp;
    }

    let src_sk = semantic_key_new(qry_sv_empty(), mod_rec.logical_path, ITEM_NS_SOURCE, 0u32, mod_rec.logical_path, qry_sv_empty());
    let src_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_SOURCE_FILE, mod_rec.source_file_id.v, src_sk);
    let snp = unsafe { eng.nodes + (src_node as usize) };
    unsafe {
        (*snp).verified_at = rev;
        if fingerprint128_eq(old_src_fp, new_src_fp.fp) {
            (*snp).color = NODE_COLOR_GREEN;
        } else {
            (*snp).color = NODE_COLOR_RED;
            (*snp).changed_at = rev;
            (*snp).fp = new_src_fp.fp;
        }
    }
    rev
}

fn fp_match_kw2(sv: StrView, b0: u8, b1: u8) -> bool {
    sv.len == 2 && (sv.ptr as usize) != 0 && unsafe { (*sv.ptr) == b0 && (*(sv.ptr + 1)) == b1 }
}

fn fp_match_kw3(sv: StrView, b0: u8, b1: u8, b2: u8) -> bool {
    sv.len == 3 && (sv.ptr as usize) != 0 && unsafe { (*sv.ptr) == b0 && (*(sv.ptr + 1)) == b1 && (*(sv.ptr + 2)) == b2 }
}

fn fp_match_kw4(sv: StrView, b0: u8, b1: u8, b2: u8, b3: u8) -> bool {
    sv.len == 4 && (sv.ptr as usize) != 0 && unsafe {
        (*sv.ptr) == b0 && (*(sv.ptr + 1)) == b1 && (*(sv.ptr + 2)) == b2 && (*(sv.ptr + 3)) == b3
    }
}

fn fp_match_kw5(sv: StrView, b0: u8, b1: u8, b2: u8, b3: u8, b4: u8) -> bool {
    sv.len == 5 && (sv.ptr as usize) != 0 && unsafe {
        (*sv.ptr) == b0 && (*(sv.ptr + 1)) == b1 && (*(sv.ptr + 2)) == b2 && (*(sv.ptr + 3)) == b3 && (*(sv.ptr + 4)) == b4
    }
}

fn fp_match_kw6(sv: StrView, b0: u8, b1: u8, b2: u8, b3: u8, b4: u8, b5: u8) -> bool {
    sv.len == 6 && (sv.ptr as usize) != 0 && unsafe {
        (*sv.ptr) == b0 && (*(sv.ptr + 1)) == b1 && (*(sv.ptr + 2)) == b2 &&
            (*(sv.ptr + 3)) == b3 && (*(sv.ptr + 4)) == b4 && (*(sv.ptr + 5)) == b5
    }
}

// Evaluates simple integer constant expressions (`100`, `60 + 40`, `120 - 20`, `25 * 4`) in `const` bodies
// so `const` body edits that preserve the evaluated `ConstValue` backdate to Green (AXS-INC-013 §1)!
fn fp_eval_const_expr_tokens(ptr: *const u8, start: usize, end: usize, fallback_val: i64) -> i64 {
    if ptr as usize == 0 || start >= end {
        return fallback_val;
    }
    let mut pos = start;
    let mut have_val = false;
    let mut acc: i64 = 0i64;
    let mut pending_op: u8 = 43u8; // '+'
    while pos < end {
        pos = fp_skip_ws_and_nondoc_comments(ptr, end, pos);
        if pos >= end {
            break;
        }
        let b = unsafe { *(ptr + pos) };
        if b == 61u8 {
            // '='
            pos = pos + 1;
            have_val = false;
            acc = 0i64;
            pending_op = 43u8;
        } else if fp_is_digit(b) {
            let mut val: i64 = 0i64;
            while pos < end && fp_is_digit(unsafe { *(ptr + pos) }) {
                val = (val * 10i64) + ((unsafe { *(ptr + pos) } - 48u8) as i64);
                pos = pos + 1;
            }
            while pos < end && fp_is_ident_cont(unsafe { *(ptr + pos) }) {
                pos = pos + 1;
            }
            if !have_val {
                acc = val;
                have_val = true;
            } else if pending_op == 43u8 {
                acc = acc + val;
            } else if pending_op == 45u8 {
                acc = acc - val;
            } else if pending_op == 42u8 {
                acc = acc * val;
            }
        } else if b == 43u8 || b == 45u8 || b == 42u8 {
            pending_op = b;
            pos = pos + 1;
        } else {
            pos = pos + 1;
        }
    }
    if have_val { acc } else { fallback_val }
}

// Parses module source text into comment/whitespace-insensitive per-item AST header & body fingerprints
// (`AstItemFingerprint`) and module `AstFingerprint` (AXS-INC-002 Tier 1).
pub fn inc_scan_module_ast_fingerprints(eng: mut_view<IncrementalEngine>, module_id: ModuleId) -> AstFingerprint {
    let m_idx = inc_find_module_index(view(*eng), module_id);
    if m_idx >= INC_MAX_MODULES {
        return AstFingerprint { module_id: module_id, item_count: 0u32, token_count: 0u32, fp: fingerprint128_zero() };
    }
    let mod_rec = unsafe { *(eng.modules + m_idx) };
    let text = mod_rec.raw_text;
    let ptr = text.ptr;
    let len = text.len;

    let mut pos: usize = 0;
    let mut item_count: u32 = 0u32;
    let mut pending_pub = false;
    let mut pending_inline = false;
    let mut pending_repr_c = false;
    let mut attr_start: usize = 0;
    let mut has_attr_start = false;

    while pos < len {
        pos = fp_skip_ws_and_nondoc_comments(ptr, len, pos);
        if pos >= len {
            break;
        }
        let b = unsafe { *(ptr + pos) };
        if b == 64u8 {
            // '@' attribute (`@inline`, `@repr(C)`, `@align(...)`)
            if !has_attr_start {
                attr_start = pos;
                has_attr_start = true;
            }
            pos = pos + 1;
            let a_start = pos;
            while pos < len && fp_is_ident_cont(unsafe { *(ptr + pos) }) {
                pos = pos + 1;
            }
            let attr_sv = StrView { ptr: unsafe { ptr + a_start }, len: pos - a_start };
            if fp_match_kw6(attr_sv, 105u8, 110u8, 108u8, 105u8, 110u8, 101u8) {
                pending_inline = true;
            } else if fp_match_kw4(attr_sv, 114u8, 101u8, 112u8, 114u8) {
                pending_repr_c = true;
            }
            pos = fp_skip_ws_and_nondoc_comments(ptr, len, pos);
            if pos < len && unsafe { *(ptr + pos) } == 40u8 {
                let mut p_depth: u32 = 1u32;
                pos = pos + 1;
                while pos < len && p_depth > 0u32 {
                    let pc = unsafe { *(ptr + pos) };
                    if pc == 40u8 { p_depth = p_depth + 1u32; }
                    else if pc == 41u8 { p_depth = p_depth - 1u32; }
                    pos = pos + 1;
                }
            }
        } else if fp_is_ident_start(b) {
            let kw_start = pos;
            pos = pos + 1;
            while pos < len && fp_is_ident_cont(unsafe { *(ptr + pos) }) {
                pos = pos + 1;
            }
            let word = StrView { ptr: unsafe { ptr + kw_start }, len: pos - kw_start };
            if fp_match_kw3(word, 112u8, 117u8, 98u8) {
                // "pub"
                if !has_attr_start {
                    attr_start = kw_start;
                    has_attr_start = true;
                }
                pending_pub = true;
            } else if fp_match_kw2(word, 102u8, 110u8) ||
                fp_match_kw5(word, 99u8, 111u8, 110u8, 115u8, 116u8) ||
                fp_match_kw6(word, 115u8, 116u8, 114u8, 117u8, 99u8, 116u8) ||
                fp_match_kw4(word, 116u8, 121u8, 112u8, 101u8) {
                let is_fn = fp_match_kw2(word, 102u8, 110u8);
                let is_const = fp_match_kw5(word, 99u8, 111u8, 110u8, 115u8, 116u8);
                let is_struct = fp_match_kw6(word, 115u8, 116u8, 114u8, 117u8, 99u8, 116u8);
                let hdr_begin = if has_attr_start { attr_start } else { kw_start };

                pos = fp_skip_ws_and_nondoc_comments(ptr, len, pos);
                if pos < len && fp_is_ident_start(unsafe { *(ptr + pos) }) {
                    let name_start = pos;
                    pos = pos + 1;
                    while pos < len && fp_is_ident_cont(unsafe { *(ptr + pos) }) {
                        pos = pos + 1;
                    }
                    let name_sv = StrView { ptr: unsafe { ptr + name_start }, len: pos - name_start };

                    let mut is_generic = false;
                    let after_name = fp_skip_ws_and_nondoc_comments(ptr, len, pos);
                    if after_name < len && unsafe { *(ptr + after_name) } == 60u8 {
                        is_generic = true;
                    }

                    let mut hdr_end = pos;
                    let mut body_start = pos;
                    let mut body_end = pos;

                    if is_fn {
                        while pos < len {
                            pos = fp_skip_ws_and_nondoc_comments(ptr, len, pos);
                            if pos >= len || unsafe { *(ptr + pos) } == 123u8 {
                                break;
                            }
                            pos = pos + 1;
                        }
                        hdr_end = pos;
                        if pos < len && unsafe { *(ptr + pos) } == 123u8 {
                            body_start = pos;
                            let mut b_depth: u32 = 1u32;
                            pos = pos + 1;
                            while pos < len && b_depth > 0u32 {
                                pos = fp_skip_ws_and_nondoc_comments(ptr, len, pos);
                                if pos >= len {
                                    break;
                                }
                                let cb = unsafe { *(ptr + pos) };
                                if cb == 123u8 { b_depth = b_depth + 1u32; }
                                else if cb == 125u8 { b_depth = b_depth - 1u32; }
                                pos = pos + 1;
                            }
                            body_end = pos;
                        }
                    } else if is_struct {
                        while pos < len && unsafe { *(ptr + pos) } != 123u8 {
                            pos = pos + 1;
                        }
                        if pos < len && unsafe { *(ptr + pos) } == 123u8 {
                            let mut b_depth: u32 = 1u32;
                            pos = pos + 1;
                            while pos < len && b_depth > 0u32 {
                                pos = fp_skip_ws_and_nondoc_comments(ptr, len, pos);
                                if pos >= len {
                                    break;
                                }
                                let cb = unsafe { *(ptr + pos) };
                                if cb == 123u8 { b_depth = b_depth + 1u32; }
                                else if cb == 125u8 { b_depth = b_depth - 1u32; }
                                pos = pos + 1;
                            }
                        }
                        hdr_end = pos;
                        body_start = hdr_begin;
                        body_end = hdr_end;
                    } else if is_const {
                        while pos < len && unsafe { *(ptr + pos) } != 61u8 && unsafe { *(ptr + pos) } != 10u8 {
                            pos = pos + 1;
                        }
                        hdr_end = pos;
                        body_start = pos;
                        while pos < len && unsafe { *(ptr + pos) } != 10u8 {
                            pos = pos + 1;
                        }
                        body_end = pos;
                    } else {
                        while pos < len && unsafe { *(ptr + pos) } != 10u8 {
                            pos = pos + 1;
                        }
                        hdr_end = pos;
                        body_start = hdr_begin;
                        body_end = hdr_end;
                    }

                    let mut hs = fp_stream_new(FP_TIER_AST);
                    let _ = fp_hash_canonical_tokens(mut_view(hs), ptr, hdr_begin, hdr_end);
                    let hdr_fp = fp_stream_finish(view(hs));

                    let mut bs = fp_stream_new(FP_TIER_AST);
                    let _ = fp_hash_canonical_tokens(mut_view(bs), ptr, body_start, body_end);
                    let bod_fp = fp_stream_finish(view(bs));

                    let mut is_s = fp_stream_new(FP_TIER_AST);
                    fp_stream_write_fp128(mut_view(is_s), hdr_fp);
                    fp_stream_write_fp128(mut_view(is_s), bod_fp);
                    let it_fp = fp_stream_finish(view(is_s));

                    item_count = item_count + 1u32;

                    // Update matching registered IncItemRecord in `module_id`
                    let mut ii: usize = 0;
                    while ii < (eng.item_count as usize) {
                        let it = unsafe { *(eng.items + ii) };
                        if it.module_id.v == module_id.v && qry_sv_eq(it.semantic_key.canonical_name, name_sv) {
                            let ip = unsafe { eng.items + ii };
                            unsafe {
                                (*ip).is_pub = pending_pub;
                                (*ip).is_inline = pending_inline;
                                (*ip).is_generic = is_generic || (*ip).is_generic;
                                if pending_repr_c {
                                    (*ip).repr_tag = REPR_C;
                                }
                                (*ip).ast_header_fp = hdr_fp;
                                (*ip).ast_body_fp = bod_fp;
                                (*ip).ast_item_fp = it_fp;
                                if is_const {
                                    (*ip).const_val = fp_eval_const_expr_tokens(ptr, body_start, body_end, (*ip).const_val);
                                }
                                if is_struct {
                                    // Derive struct size from canonical token count inside `{ ... }` so adding a field changes ABI size & layout
                                    let mut fs = fp_stream_new(FP_TIER_ABI);
                                    let f_toks = fp_hash_canonical_tokens(mut_view(fs), ptr, hdr_begin, hdr_end);
                                    (*ip).size_bytes = f_toks * 4u32;
                                }
                            }
                        }
                        ii = ii + 1;
                    }
                }
                pending_pub = false;
                pending_inline = false;
                pending_repr_c = false;
                has_attr_start = false;
            } else {
                pending_pub = false;
                pending_inline = false;
                pending_repr_c = false;
                has_attr_start = false;
            }
        } else {
            pos = pos + 1;
        }
    }

    let ast_fp_rec = fp_compute_ast_fingerprint(module_id, mod_rec.semantic_key.module_path, text, item_count);
    unsafe {
        (*(eng.modules + m_idx)).ast_fp = ast_fp_rec.fp;
    }
    ast_fp_rec
}

// ============================================================================
// 6. Multi-Tier Fingerprint Providers & Red-Green `try_mark_green` (AXS-INC-010..013)
// ============================================================================

fn fp_miss_reason_for_dep_kind(dep_kind: u8) -> u8 {
    if dep_kind == DEP_KIND_SOURCE || dep_kind == DEP_KIND_AST {
        return MISS_SOURCE_CHANGED;
    }
    if dep_kind == DEP_KIND_INTERFACE || dep_kind == DEP_KIND_NAME_LOOKUP || dep_kind == DEP_KIND_TRAIT_IMPL {
        return MISS_API_CHANGED;
    }
    if dep_kind == DEP_KIND_ABI || dep_kind == DEP_KIND_LAYOUT {
        return MISS_ABI_CHANGED;
    }
    if dep_kind == DEP_KIND_CONFIG {
        return MISS_CONFIG_CHANGED;
    }
    MISS_BODY_CHANGED
}

fn inc_item_abi_input_fp(it: view<IncItemRecord>) -> Fingerprint128 {
    let layout_word: u64 = ((it.size_bytes as u64) << 32) |
        ((it.align_bytes as u64) << 16) |
        ((it.explicit_align as u64) << 8) |
        ((it.repr_tag as u64) << 4) |
        (it.calling_conv as u64);
    let mut s = fp_stream_new(FP_TIER_ABI);
    fp_stream_write_fp128(mut_view(s), it.ast_header_fp);
    fp_stream_write_u64(mut_view(s), layout_word);
    fp_stream_write_u32(mut_view(s), it.param_count);
    fp_stream_finish(view(s))
}

// Returns the fingerprint of `dep_node` corresponding to `dep_kind` at the current revision.
// For `INC_NODE_PARSE_MODULE`, `DEP_KIND_AST` on a specific item checks that item's header/body AST hash
// when queried via item helpers, or the module `AstFingerprint` for module-level queries.
fn inc_observed_fp_for_node(eng: view<IncrementalEngine>, dep_node_idx: u32, dep_kind: u8, caller_owner_id: u32, caller_kind: u8) -> Fingerprint128 {
    let dep = unsafe { *(eng.nodes + (dep_node_idx as usize)) };
    if dep.node_kind == INC_NODE_PARSE_MODULE && dep_kind == DEP_KIND_AST {
        if caller_kind == INC_NODE_ITEM_SIGNATURE {
            let it = inc_get_item(eng, DefId { v: caller_owner_id });
            return it.ast_header_fp;
        }
        if caller_kind == INC_NODE_ITEM_ABI {
            let it = inc_get_item(eng, DefId { v: caller_owner_id });
            return inc_item_abi_input_fp(view(it));
        }
        if caller_kind == INC_NODE_TYPECK_BODY || caller_kind == INC_NODE_CONST_EVAL {
            let it = inc_get_item(eng, DefId { v: caller_owner_id });
            return it.ast_body_fp;
        }
        if caller_kind == INC_NODE_RESOLVE_MODULE {
            return dep.aux_fp;
        }
    }
    dep.fp
}

// Forward declaration via mutual dispatch: `inc_ensure_node_evaluated` evaluates or marks green `node_idx`.
pub fn inc_try_mark_green(eng: mut_view<IncrementalEngine>, node_idx: u32) -> bool {
    let node = unsafe { *(eng.nodes + (node_idx as usize)) };
    let r_curr = eng.current_revision;

    if (node.node_kind) < (INC_NODE_PARSE_MODULE) {
        return revision_id_lt(node.changed_at, r_curr) || node.color == NODE_COLOR_GREEN;
    }
    if node.recompute_count == 0u32 || node.edge_count == 0u32 {
        unsafe { (*(eng.nodes + (node_idx as usize))).last_miss_reason = MISS_COLD_CACHE; }
        return false;
    }
    if revision_id_eq(node.verified_at, r_curr) && (node.color == NODE_COLOR_GREEN || node.color == NODE_COLOR_RED) {
        return node.color == NODE_COLOR_GREEN && !node.was_backdated;
    }

    // AXS-INC-011 §1-2: Walk recorded dependencies [D_0, ..., D_{k-1}] in deterministic recorded order
    let mut i: u32 = 0u32;
    while i < node.edge_count {
        let edge = node.edges[i as usize];
        let dep_idx = edge.dep_node_idx;
        let dep_before = unsafe { *(eng.nodes + (dep_idx as usize)) };

        if dep_before.node_kind >= INC_NODE_PARSE_MODULE {
            let _ = inc_ensure_node_evaluated(mut_view(*eng), dep_idx);
        }

        let curr_dep_fp = inc_observed_fp_for_node(view(*eng), dep_idx, edge.dep_kind, node.owner_id, node.node_kind);
        if !fingerprint128_eq(curr_dep_fp, edge.observed_fp) {
            // Dependency fingerprint for `edge.dep_kind` changed -> abort early (cannot mark green)
            let reason = fp_miss_reason_for_dep_kind(edge.dep_kind);
            unsafe { (*(eng.nodes + (node_idx as usize))).last_miss_reason = reason; }
            return false;
        }
        i = i + 1u32;
    }

    // AXS-INC-011 §3: All dependencies verified with unchanged fingerprints for their DependencyKind!
    // Mark `node_idx` Green(R_curr) without re-executing its provider!
    let np = unsafe { eng.nodes + (node_idx as usize) };
    unsafe {
        (*np).color = NODE_COLOR_GREEN;
        (*np).verified_at = r_curr;
        (*np).was_backdated = false;
        (*np).last_miss_reason = MISS_NONE;
        (*np).green_reuse_count = (*np).green_reuse_count + 1u32;
    }
    eng.rev_queries_green_reused = eng.rev_queries_green_reused + 1u32;
    eng.total_queries_green_reused = eng.total_queries_green_reused + 1u32;
    eng.db.total_green_reuses = eng.db.total_green_reuses + 1u32;
    eng.db.total_memo_hits = eng.db.total_memo_hits + 1u32;

    if node.node_kind == INC_NODE_CODEGEN_UNIT {
        let m_idx = inc_find_module_index(view(*eng), ModuleId { v: node.owner_id });
        if (m_idx) < (INC_MAX_MODULES) {
            let prev_reused = unsafe { (*(eng.modules + m_idx)).cgu_reused_at_rev };
            if !revision_id_eq(prev_reused, r_curr) {
                unsafe { (*(eng.modules + m_idx)).cgu_reused_at_rev = r_curr; }
                eng.rev_cgu_reused = eng.rev_cgu_reused + 1u32;
            }
        }
    }
    true
}

fn inc_execute_node_provider(eng: mut_view<IncrementalEngine>, node_idx: u32) -> Fingerprint128 {
    let node = unsafe { *(eng.nodes + (node_idx as usize)) };
    let nk = node.node_kind;
    let owner = node.owner_id;
    let r_curr = eng.current_revision;

    inc_node_clear_edges(mut_view(*eng), node_idx);

    if nk == INC_NODE_PARSE_MODULE {
        let mod_id = ModuleId { v: owner };
        let mod_rec = inc_get_module(view(*eng), mod_id);
        let src_sk = semantic_key_new(qry_sv_empty(), mod_rec.logical_path, ITEM_NS_SOURCE, 0u32, mod_rec.logical_path, qry_sv_empty());
        let src_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_SOURCE_FILE, mod_rec.source_file_id.v, src_sk);
        let src_fp = unsafe { (*(eng.nodes + (src_node as usize))).fp };
        inc_node_add_edge(mut_view(*eng), node_idx, src_node, DEP_KIND_SOURCE, src_fp);

        let ast_rec = inc_scan_module_ast_fingerprints(mut_view(*eng), mod_id);

        // Compute module-level name/import lookup digest (`aux_fp`) over sorted item names + imports
        let mut mod_item_idxs: [64]usize = [0; 64];
        let mut mi_count: usize = 0;
        let mut i: usize = 0;
        while i < (eng.item_count as usize) {
            let it = unsafe { *(eng.items + i) };
            if it.module_id.v == mod_id.v && mi_count < 64 {
                mod_item_idxs[mi_count] = i;
                mi_count = mi_count + 1;
            }
            i = i + 1;
        }
        let mut a: usize = 1;
        while a < mi_count {
            let cur_i = mod_item_idxs[a];
            let cur_it = unsafe { *(eng.items + cur_i) };
            let mut b: usize = a;
            while b > 0 {
                let prev_i = mod_item_idxs[b - 1];
                let prev_it = unsafe { *(eng.items + prev_i) };
                if semantic_key_cmp(view(prev_it.semantic_key), view(cur_it.semantic_key)) <= 0i32 {
                    break;
                }
                mod_item_idxs[b] = prev_i;
                b = b - 1;
            }
            mod_item_idxs[b] = cur_i;
            a = a + 1;
        }

        let mut nl_s = fp_stream_new(FP_TIER_AST);
        fp_stream_write_semantic_key(mut_view(nl_s), view(mod_rec.semantic_key));
        let mut k: usize = 0;
        while k < mi_count {
            let it = unsafe { *(eng.items + mod_item_idxs[k]) };
            fp_stream_write_semantic_key(mut_view(nl_s), view(it.semantic_key));
            fp_stream_write_u8(mut_view(nl_s), it.item_kind);
            fp_stream_write_u8(mut_view(nl_s), if it.is_pub { 1u8 } else { 0u8 });
            k = k + 1;
        }
        let nl_fp = fp_stream_finish(view(nl_s));
        unsafe { (*(eng.nodes + (node_idx as usize))).aux_fp = nl_fp; }
        return ast_rec.fp;
    }

    if nk == INC_NODE_ITEM_SIGNATURE {
        let def_id = DefId { v: owner };
        let it_before = inc_get_item(view(*eng), def_id);
        let mod_rec = inc_get_module(view(*eng), it_before.module_id);
        let pm_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_PARSE_MODULE, it_before.module_id.v, mod_rec.semantic_key);
        let _ = inc_ensure_node_evaluated(mut_view(*eng), pm_node);

        let it = inc_get_item(view(*eng), def_id);
        inc_node_add_edge(mut_view(*eng), node_idx, pm_node, DEP_KIND_AST, it.ast_header_fp);

        let mut s = fp_stream_new(FP_TIER_INTERFACE);
        fp_stream_write_semantic_key(mut_view(s), view(it.semantic_key));
        fp_stream_write_u8(mut_view(s), it.item_kind);
        fp_stream_write_u8(mut_view(s), if it.is_pub { 1u8 } else { 0u8 });
        fp_stream_write_u8(mut_view(s), if it.is_inline { 1u8 } else { 0u8 });
        fp_stream_write_u8(mut_view(s), if it.is_generic { 1u8 } else { 0u8 });
        fp_stream_write_u32(mut_view(s), it.param_count);
        fp_stream_write_u32(mut_view(s), it.return_type_tag);
        fp_stream_write_u32(mut_view(s), it.generic_param_count);
        fp_stream_write_fp128(mut_view(s), it.ast_header_fp);

        let mut di: u32 = 0u32;
        while di < it.sig_dep_count {
            let dep_def = DefId { v: it.sig_deps[di as usize] };
            let dep_it = inc_get_item(view(*eng), dep_def);
            let dep_sig_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_SIGNATURE, dep_def.v, dep_it.semantic_key);
            let dep_sig_fp = inc_ensure_node_evaluated(mut_view(*eng), dep_sig_node);
            inc_node_add_edge(mut_view(*eng), node_idx, dep_sig_node, DEP_KIND_INTERFACE, dep_sig_fp);
            fp_stream_write_fp128(mut_view(s), dep_sig_fp);
            di = di + 1u32;
        }

        if it.item_kind == ITEM_KIND_CONST {
            let ce_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_CONST_EVAL, def_id.v, it.semantic_key);
            let ce_fp = inc_ensure_node_evaluated(mut_view(*eng), ce_node);
            inc_node_add_edge(mut_view(*eng), node_idx, ce_node, DEP_KIND_CONST_BODY, ce_fp);
            fp_stream_write_fp128(mut_view(s), ce_fp);
        }

        let api_fp = fp_stream_finish(view(s));
        let idx = inc_find_item_index(view(*eng), def_id);
        if (idx) < (INC_MAX_ITEMS) {
            unsafe { (*(eng.items + idx)).interface_fp = api_fp; }
        }
        return api_fp;
    }

    if nk == INC_NODE_ITEM_ABI {
        let def_id = DefId { v: owner };
        let it_before = inc_get_item(view(*eng), def_id);
        let mod_rec = inc_get_module(view(*eng), it_before.module_id);
        let pm_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_PARSE_MODULE, it_before.module_id.v, mod_rec.semantic_key);
        let _ = inc_ensure_node_evaluated(mut_view(*eng), pm_node);

        let it = inc_get_item(view(*eng), def_id);
        let abi_in_fp = inc_item_abi_input_fp(view(it));
        inc_node_add_edge(mut_view(*eng), node_idx, pm_node, DEP_KIND_AST, abi_in_fp);

        let mut s = fp_stream_new(FP_TIER_ABI);
        fp_stream_write_semantic_key(mut_view(s), view(it.semantic_key));
        fp_stream_write_u8(mut_view(s), it.item_kind);
        fp_stream_write_u8(mut_view(s), it.repr_tag);
        fp_stream_write_u8(mut_view(s), it.calling_conv);
        fp_stream_write_u32(mut_view(s), it.size_bytes);
        fp_stream_write_u32(mut_view(s), it.align_bytes);
        fp_stream_write_u32(mut_view(s), it.explicit_align);
        fp_stream_write_u32(mut_view(s), it.param_count);
        fp_stream_write_u32(mut_view(s), it.return_type_tag);
        fp_stream_write_u32(mut_view(s), eng.target_pointer_width);
        fp_stream_write_fp128(mut_view(s), it.ast_header_fp);

        let mut li: u32 = 0u32;
        while li < it.layout_dep_count {
            let f_def = DefId { v: it.layout_deps[li as usize] };
            if f_def.v != def_id.v {
                let f_it = inc_get_item(view(*eng), f_def);
                let f_abi_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, f_def.v, f_it.semantic_key);
                let f_abi_fp = inc_ensure_node_evaluated(mut_view(*eng), f_abi_node);
                inc_node_add_edge(mut_view(*eng), node_idx, f_abi_node, DEP_KIND_LAYOUT, f_abi_fp);
                fp_stream_write_fp128(mut_view(s), f_abi_fp);
            }
            li = li + 1u32;
        }

        let abi_fp = fp_stream_finish(view(s));
        let idx = inc_find_item_index(view(*eng), def_id);
        if (idx) < (INC_MAX_ITEMS) {
            unsafe {
                (*(eng.items + idx)).abi_fp = abi_fp;
                if it.item_kind != ITEM_KIND_FN && it.item_kind != ITEM_KIND_CONST {
                    (*(eng.items + idx)).body_fp = abi_fp;
                }
            }
        }
        return abi_fp;
    }

    if nk == INC_NODE_CONST_EVAL {
        let def_id = DefId { v: owner };
        let it_before = inc_get_item(view(*eng), def_id);
        let mod_rec = inc_get_module(view(*eng), it_before.module_id);
        let pm_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_PARSE_MODULE, it_before.module_id.v, mod_rec.semantic_key);
        let _ = inc_ensure_node_evaluated(mut_view(*eng), pm_node);

        let it = inc_get_item(view(*eng), def_id);
        inc_node_add_edge(mut_view(*eng), node_idx, pm_node, DEP_KIND_AST, it.ast_body_fp);

        let mut total_val: i64 = it.const_val;
        let mut ci: u32 = 0u32;
        while ci < it.const_dep_count {
            let dep_cdef = DefId { v: it.const_deps[ci as usize] };
            if dep_cdef.v != def_id.v {
                let dep_cit = inc_get_item(view(*eng), dep_cdef);
                let dep_cnode = inc_find_or_create_node(mut_view(*eng), INC_NODE_CONST_EVAL, dep_cdef.v, dep_cit.semantic_key);
                let dep_cfp = inc_ensure_node_evaluated(mut_view(*eng), dep_cnode);
                inc_node_add_edge(mut_view(*eng), node_idx, dep_cnode, DEP_KIND_CONST_BODY, dep_cfp);
                let dep_cit_after = inc_get_item(view(*eng), dep_cdef);
                total_val = total_val + dep_cit_after.const_val;
            }
            ci = ci + 1u32;
        }

        // ConstEval fingerprint depends on the evaluated `ConstValue` (`total_val`) and type tag,
        // so editing `100` to `60 + 40` backdates to the exact same `ConstValue` fingerprint (AXS-INC-013 §1)!
        let mut s = fp_stream_new(FP_TIER_BODY);
        fp_stream_write_semantic_key(mut_view(s), view(it.semantic_key));
        fp_stream_write_u32(mut_view(s), it.return_type_tag);
        fp_stream_write_u64(mut_view(s), total_val as u64);
        let const_fp = fp_stream_finish(view(s));

        let idx = inc_find_item_index(view(*eng), def_id);
        if (idx) < (INC_MAX_ITEMS) {
            unsafe {
                (*(eng.items + idx)).body_fp = const_fp;
                (*(eng.items + idx)).codegen_fp = const_fp;
            }
        }
        return const_fp;
    }

    if nk == INC_NODE_MODULE_INTERFACE {
        // AXS-INC-012 §1: `InterfaceFingerprint(M)` aggregates ONLY exported (`pub`) item signatures,
        // exported `AbiFingerprint`s, and `pub const` values sorted by `SemanticKey`.
        // Private items (`is_pub == false`) and function bodies NEVER enter `InterfaceFingerprint(M)`!
        let mod_id = ModuleId { v: owner };
        let mod_rec = inc_get_module(view(*eng), mod_id);
        let pm_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_PARSE_MODULE, mod_id.v, mod_rec.semantic_key);
        let _ = inc_ensure_node_evaluated(mut_view(*eng), pm_node);

        let mut pub_defs: [64]u32 = [0u32; 64];
        let mut pub_count: usize = 0;
        let mut i: usize = 0;
        while i < (eng.item_count as usize) {
            let it = unsafe { *(eng.items + i) };
            if it.module_id.v == mod_id.v && it.is_pub && pub_count < 64 {
                pub_defs[pub_count] = it.def_id.v;
                pub_count = pub_count + 1;
            }
            i = i + 1;
        }

        // Sort exported items by canonical `SemanticKey`
        let mut a: usize = 1;
        while a < pub_count {
            let cur_id = pub_defs[a];
            let cur_it = inc_get_item(view(*eng), DefId { v: cur_id });
            let mut b: usize = a;
            while b > 0 {
                let prev_id = pub_defs[b - 1];
                let prev_it = inc_get_item(view(*eng), DefId { v: prev_id });
                if semantic_key_cmp(view(prev_it.semantic_key), view(cur_it.semantic_key)) <= 0i32 {
                    break;
                }
                pub_defs[b] = prev_id;
                b = b - 1;
            }
            pub_defs[b] = cur_id;
            a = a + 1;
        }

        let mut s = fp_stream_new(FP_TIER_INTERFACE);
        fp_stream_write_semantic_key(mut_view(s), view(mod_rec.semantic_key));
        fp_stream_write_u32(mut_view(s), pub_count as u32);

        let mut k: usize = 0;
        while k < pub_count {
            let pid = DefId { v: pub_defs[k] };
            let pit = inc_get_item(view(*eng), pid);
            let sig_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_SIGNATURE, pid.v, pit.semantic_key);
            let abi_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, pid.v, pit.semantic_key);
            let sig_fp = inc_ensure_node_evaluated(mut_view(*eng), sig_node);
            let abi_fp = inc_ensure_node_evaluated(mut_view(*eng), abi_node);
            inc_node_add_edge(mut_view(*eng), node_idx, sig_node, DEP_KIND_INTERFACE, sig_fp);
            inc_node_add_edge(mut_view(*eng), node_idx, abi_node, DEP_KIND_ABI, abi_fp);
            fp_stream_write_fp128(mut_view(s), sig_fp);
            fp_stream_write_fp128(mut_view(s), abi_fp);
            k = k + 1;
        }

        let mod_api_fp = fp_stream_finish(view(s));
        let m_idx = inc_find_module_index(view(*eng), mod_id);
        if (m_idx) < (INC_MAX_MODULES) {
            unsafe { (*(eng.modules + m_idx)).interface_fp = mod_api_fp; }
        }
        return mod_api_fp;
    }

    if nk == INC_NODE_RESOLVE_MODULE {
        let mod_id = ModuleId { v: owner };
        let mod_rec = inc_get_module(view(*eng), mod_id);
        let pm_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_PARSE_MODULE, mod_id.v, mod_rec.semantic_key);
        let _ = inc_ensure_node_evaluated(mut_view(*eng), pm_node);
        let nl_fp = unsafe { (*(eng.nodes + (pm_node as usize))).aux_fp };
        inc_node_add_edge(mut_view(*eng), node_idx, pm_node, DEP_KIND_AST, nl_fp);

        let mut s = fp_stream_new(FP_TIER_INTERFACE);
        fp_stream_write_semantic_key(mut_view(s), view(mod_rec.semantic_key));
        fp_stream_write_fp128(mut_view(s), nl_fp);

        let mut im: u32 = 0u32;
        while im < mod_rec.imported_module_count {
            let imp_id = ModuleId { v: mod_rec.imported_modules[im as usize] };
            let imp_rec = inc_get_module(view(*eng), imp_id);
            let imp_api_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_MODULE_INTERFACE, imp_id.v, imp_rec.semantic_key);
            let imp_api_fp = inc_ensure_node_evaluated(mut_view(*eng), imp_api_node);
            inc_node_add_edge(mut_view(*eng), node_idx, imp_api_node, DEP_KIND_INTERFACE, imp_api_fp);
            fp_stream_write_fp128(mut_view(s), imp_api_fp);
            im = im + 1u32;
        }
        return fp_stream_finish(view(s));
    }

    if nk == INC_NODE_TYPECK_BODY {
        let def_id = DefId { v: owner };
        let it_before = inc_get_item(view(*eng), def_id);
        let mod_rec = inc_get_module(view(*eng), it_before.module_id);

        let pm_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_PARSE_MODULE, it_before.module_id.v, mod_rec.semantic_key);
        let _ = inc_ensure_node_evaluated(mut_view(*eng), pm_node);

        let rm_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_RESOLVE_MODULE, it_before.module_id.v, mod_rec.semantic_key);
        let rm_fp = inc_ensure_node_evaluated(mut_view(*eng), rm_node);
        inc_node_add_edge(mut_view(*eng), node_idx, rm_node, DEP_KIND_NAME_LOOKUP, rm_fp);

        let sig_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_SIGNATURE, def_id.v, it_before.semantic_key);
        let sig_fp = inc_ensure_node_evaluated(mut_view(*eng), sig_node);
        inc_node_add_edge(mut_view(*eng), node_idx, sig_node, DEP_KIND_INTERFACE, sig_fp);

        let it = inc_get_item(view(*eng), def_id);
        inc_node_add_edge(mut_view(*eng), node_idx, pm_node, DEP_KIND_AST, it.ast_body_fp);

        // Record that `it.module_id` had at least one `typeck_body` executed at `r_curr`
        let m_idx = inc_find_module_index(view(*eng), it.module_id);
        if (m_idx) < (INC_MAX_MODULES) {
            let prev_tck = unsafe { (*(eng.modules + m_idx)).typechecked_at_rev };
            if !revision_id_eq(prev_tck, r_curr) {
                unsafe { (*(eng.modules + m_idx)).typechecked_at_rev = r_curr; }
                eng.rev_modules_typechecked = eng.rev_modules_typechecked + 1u32;
            }
        }

        let mut s = fp_stream_new(FP_TIER_BODY);
        fp_stream_write_semantic_key(mut_view(s), view(it.semantic_key));
        fp_stream_write_fp128(mut_view(s), sig_fp);
        fp_stream_write_fp128(mut_view(s), it.ast_body_fp);

        // AXS-INC-003 & AXS-INC-012 Private-Body Firewall:
        // `typeck_body(caller)` depends ONLY on `InterfaceFingerprint(callee)` (`DEP_KIND_INTERFACE`),
        // NEVER on `BodyFingerprint(callee)`!
        let mut ci: u32 = 0u32;
        while ci < it.call_dep_count {
            let callee_id = DefId { v: it.call_deps[ci as usize] };
            let callee_it = inc_get_item(view(*eng), callee_id);
            let callee_sig_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_SIGNATURE, callee_id.v, callee_it.semantic_key);
            let callee_sig_fp = inc_ensure_node_evaluated(mut_view(*eng), callee_sig_node);
            inc_node_add_edge(mut_view(*eng), node_idx, callee_sig_node, DEP_KIND_INTERFACE, callee_sig_fp);
            fp_stream_write_semantic_key(mut_view(s), view(callee_it.semantic_key));
            fp_stream_write_fp128(mut_view(s), callee_sig_fp);
            ci = ci + 1u32;
        }

        // Cross-module or local `const` dependencies (`DEP_KIND_CONST_BODY`)
        let mut ki: u32 = 0u32;
        while ki < it.const_dep_count {
            let c_id = DefId { v: it.const_deps[ki as usize] };
            let c_it = inc_get_item(view(*eng), c_id);
            let ce_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_CONST_EVAL, c_id.v, c_it.semantic_key);
            let ce_fp = inc_ensure_node_evaluated(mut_view(*eng), ce_node);
            inc_node_add_edge(mut_view(*eng), node_idx, ce_node, DEP_KIND_CONST_BODY, ce_fp);
            fp_stream_write_fp128(mut_view(s), ce_fp);
            ki = ki + 1u32;
        }

        // Layout / ABI type dependencies (`DEP_KIND_LAYOUT`)
        let mut li: u32 = 0u32;
        while li < it.layout_dep_count {
            let l_id = DefId { v: it.layout_deps[li as usize] };
            let l_it = inc_get_item(view(*eng), l_id);
            let l_abi_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, l_id.v, l_it.semantic_key);
            let l_abi_fp = inc_ensure_node_evaluated(mut_view(*eng), l_abi_node);
            inc_node_add_edge(mut_view(*eng), node_idx, l_abi_node, DEP_KIND_LAYOUT, l_abi_fp);
            fp_stream_write_fp128(mut_view(s), l_abi_fp);
            li = li + 1u32;
        }

        if it.has_body_type_error {
            fp_stream_write_u32(mut_view(s), DIAG_AX_TYP_MISMATCH);
            let err_fp = fp_stream_finish(view(s));
            unsafe { (*(eng.nodes + (node_idx as usize))).is_error = true; }
            return err_fp;
        }
        unsafe { (*(eng.nodes + (node_idx as usize))).is_error = false; }
        return fp_stream_finish(view(s));
    }

    if nk == INC_NODE_MIR_BODY {
        // Tier 3 `BodyFingerprint`: Canonical Verified MIR body (AXS-INC-002 Tier 3)
        let def_id = DefId { v: owner };
        let it = inc_get_item(view(*eng), def_id);
        let tck_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_TYPECK_BODY, def_id.v, it.semantic_key);
        let abi_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, def_id.v, it.semantic_key);
        let tck_fp = inc_ensure_node_evaluated(mut_view(*eng), tck_node);
        let abi_fp = inc_ensure_node_evaluated(mut_view(*eng), abi_node);
        inc_node_add_edge(mut_view(*eng), node_idx, tck_node, DEP_KIND_CODEGEN, tck_fp);
        inc_node_add_edge(mut_view(*eng), node_idx, abi_node, DEP_KIND_ABI, abi_fp);

        let mut s = fp_stream_new(FP_TIER_BODY);
        fp_stream_write_semantic_key(mut_view(s), view(it.semantic_key));
        fp_stream_write_fp128(mut_view(s), tck_fp);
        fp_stream_write_fp128(mut_view(s), abi_fp);
        fp_stream_write_u32(mut_view(s), it.call_dep_count + 1u32); // basic block count
        fp_stream_write_u32(mut_view(s), it.param_count + 2u32);    // local count

        let mut ci: u32 = 0u32;
        while ci < it.call_dep_count {
            let callee_id = DefId { v: it.call_deps[ci as usize] };
            let callee_it = inc_get_item(view(*eng), callee_id);
            let callee_abi_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, callee_id.v, callee_it.semantic_key);
            let callee_abi_fp = inc_ensure_node_evaluated(mut_view(*eng), callee_abi_node);
            inc_node_add_edge(mut_view(*eng), node_idx, callee_abi_node, DEP_KIND_ABI, callee_abi_fp);
            fp_stream_write_fp128(mut_view(s), callee_abi_fp);
            ci = ci + 1u32;
        }

        let body_fp = fp_stream_finish(view(s));
        let idx = inc_find_item_index(view(*eng), def_id);
        if (idx) < (INC_MAX_ITEMS) {
            unsafe { (*(eng.items + idx)).body_fp = body_fp; }
        }
        return body_fp;
    }

    // INC_NODE_CODEGEN_UNIT — Tier 4 `CodegenFingerprint` (AXS-INC-002 Tier 4, AXS-INC-004)
    let mod_id = ModuleId { v: owner };
    let mod_rec = inc_get_module(view(*eng), mod_id);

    // Depend on TargetConfig digest (`DEP_KIND_CONFIG`)
    let cfg_sk = semantic_key_new(qry_sv_empty(), qry_sv_empty(), ITEM_NS_UNIT, 0u32, qry_sv_empty(), qry_sv_empty());
    let cfg_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_TARGET_CONFIG, 1u32, cfg_sk);
    let cfg_fp = unsafe { (*(eng.nodes + (cfg_node as usize))).fp };
    inc_node_add_edge(mut_view(*eng), node_idx, cfg_node, DEP_KIND_CONFIG, cfg_fp);

    // Collect all items in `mod_id` sorted by `SemanticKey`
    let mut mod_items: [64]u32 = [0u32; 64];
    let mut m_count: usize = 0;
    let mut i: usize = 0;
    while i < (eng.item_count as usize) {
        let it = unsafe { *(eng.items + i) };
        if it.module_id.v == mod_id.v && m_count < 64 {
            mod_items[m_count] = it.def_id.v;
            m_count = m_count + 1;
        }
        i = i + 1;
    }
    let mut a: usize = 1;
    while a < m_count {
        let cur_id = mod_items[a];
        let cur_it = inc_get_item(view(*eng), DefId { v: cur_id });
        let mut b: usize = a;
        while b > 0 {
            let prev_id = mod_items[b - 1];
            let prev_it = inc_get_item(view(*eng), DefId { v: prev_id });
            if semantic_key_cmp(view(prev_it.semantic_key), view(cur_it.semantic_key)) <= 0i32 {
                break;
            }
            mod_items[b] = prev_id;
            b = b - 1;
        }
        mod_items[b] = cur_id;
        a = a + 1;
    }

    let mut cgu_s = fp_stream_new(FP_TIER_CODEGEN);
    fp_stream_write_semantic_key(mut_view(cgu_s), view(mod_rec.semantic_key));
    fp_stream_write_fp128(mut_view(cgu_s), cfg_fp);

    let mut k: usize = 0;
    while k < m_count {
        let did = DefId { v: mod_items[k] };
        let dit = inc_get_item(view(*eng), did);
        let abi_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, did.v, dit.semantic_key);
        let abi_fp = inc_ensure_node_evaluated(mut_view(*eng), abi_node);
        inc_node_add_edge(mut_view(*eng), node_idx, abi_node, DEP_KIND_ABI, abi_fp);

        let mut item_cgu_s = fp_stream_new(FP_TIER_CODEGEN);
        fp_stream_write_semantic_key(mut_view(item_cgu_s), view(dit.semantic_key));
        fp_stream_write_fp128(mut_view(item_cgu_s), cfg_fp);
        fp_stream_write_fp128(mut_view(item_cgu_s), abi_fp);

        if dit.item_kind == ITEM_KIND_FN {
            let mir_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_MIR_BODY, did.v, dit.semantic_key);
            let mir_fp = inc_ensure_node_evaluated(mut_view(*eng), mir_node);
            inc_node_add_edge(mut_view(*eng), node_idx, mir_node, DEP_KIND_CODEGEN, mir_fp);
            fp_stream_write_fp128(mut_view(item_cgu_s), mir_fp);

            // AXS-INC-004 §2-3: Cross-module `@inline` and generic instantiations record
            // `DEP_KIND_INLINED_BODY` / `DEP_KIND_GENERIC_BODY` edges on callee's `BodyFingerprint`,
            // whereas non-inlined, non-generic calls depend ONLY on callee's `AbiFingerprint`!
            let mut ci: u32 = 0u32;
            while ci < dit.call_dep_count {
                let callee_id = DefId { v: dit.call_deps[ci as usize] };
                let callee_it = inc_get_item(view(*eng), callee_id);
                let callee_abi_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, callee_id.v, callee_it.semantic_key);
                let callee_abi_fp = inc_ensure_node_evaluated(mut_view(*eng), callee_abi_node);
                inc_node_add_edge(mut_view(*eng), node_idx, callee_abi_node, DEP_KIND_ABI, callee_abi_fp);
                fp_stream_write_fp128(mut_view(item_cgu_s), callee_abi_fp);

                if callee_it.is_inline {
                    let callee_mir_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_MIR_BODY, callee_id.v, callee_it.semantic_key);
                    let callee_mir_fp = inc_ensure_node_evaluated(mut_view(*eng), callee_mir_node);
                    inc_node_add_edge(mut_view(*eng), node_idx, callee_mir_node, DEP_KIND_INLINED_BODY, callee_mir_fp);
                    fp_stream_write_fp128(mut_view(item_cgu_s), callee_mir_fp);
                } else if callee_it.is_generic {
                    let callee_mir_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_MIR_BODY, callee_id.v, callee_it.semantic_key);
                    let callee_mir_fp = inc_ensure_node_evaluated(mut_view(*eng), callee_mir_node);
                    inc_node_add_edge(mut_view(*eng), node_idx, callee_mir_node, DEP_KIND_GENERIC_BODY, callee_mir_fp);
                    fp_stream_write_fp128(mut_view(item_cgu_s), callee_mir_fp);
                }
                ci = ci + 1u32;
            }

            let mut ki: u32 = 0u32;
            while ki < dit.const_dep_count {
                let c_id = DefId { v: dit.const_deps[ki as usize] };
                let c_it = inc_get_item(view(*eng), c_id);
                let ce_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_CONST_EVAL, c_id.v, c_it.semantic_key);
                let ce_fp = inc_ensure_node_evaluated(mut_view(*eng), ce_node);
                inc_node_add_edge(mut_view(*eng), node_idx, ce_node, DEP_KIND_CONST_BODY, ce_fp);
                fp_stream_write_fp128(mut_view(item_cgu_s), ce_fp);
                ki = ki + 1u32;
            }

            let mut li: u32 = 0u32;
            while li < dit.layout_dep_count {
                let l_id = DefId { v: dit.layout_deps[li as usize] };
                let l_it = inc_get_item(view(*eng), l_id);
                let l_abi_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_ITEM_ABI, l_id.v, l_it.semantic_key);
                let l_abi_fp = inc_ensure_node_evaluated(mut_view(*eng), l_abi_node);
                inc_node_add_edge(mut_view(*eng), node_idx, l_abi_node, DEP_KIND_LAYOUT, l_abi_fp);
                fp_stream_write_fp128(mut_view(item_cgu_s), l_abi_fp);
                li = li + 1u32;
            }
        } else if dit.item_kind == ITEM_KIND_CONST {
            let ce_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_CONST_EVAL, did.v, dit.semantic_key);
            let ce_fp = inc_ensure_node_evaluated(mut_view(*eng), ce_node);
            inc_node_add_edge(mut_view(*eng), node_idx, ce_node, DEP_KIND_CONST_BODY, ce_fp);
            fp_stream_write_fp128(mut_view(item_cgu_s), ce_fp);
        }

        let item_cgu_fp = fp_stream_finish(view(item_cgu_s));
        let item_idx = inc_find_item_index(view(*eng), did);
        if (item_idx) < (INC_MAX_ITEMS) {
            unsafe { (*(eng.items + item_idx)).codegen_fp = item_cgu_fp; }
        }
        fp_stream_write_fp128(mut_view(cgu_s), item_cgu_fp);
        k = k + 1;
    }

    let cgu_fp = fp_stream_finish(view(cgu_s));
    let m_idx = inc_find_module_index(view(*eng), mod_id);
    if m_idx < INC_MAX_MODULES {
        unsafe { (*(eng.modules + m_idx)).codegen_fp = cgu_fp; }
    }
    cgu_fp
}

pub fn inc_ensure_node_evaluated(eng: mut_view<IncrementalEngine>, node_idx: u32) -> Fingerprint128 {
    let node = unsafe { *(eng.nodes + (node_idx as usize)) };
    let r_curr = eng.current_revision;

    if (node.node_kind) < (INC_NODE_PARSE_MODULE) {
        return node.fp;
    }
    // Same-revision warm hit
    if revision_id_eq(node.verified_at, r_curr) && (node.color == NODE_COLOR_GREEN || node.color == NODE_COLOR_RED) {
        return node.fp;
    }

    eng.rev_queries_total = eng.rev_queries_total + 1u32;

    // Try Red-Green verification (`try_mark_green`, AXS-INC-011)
    if inc_try_mark_green(mut_view(*eng), node_idx) {
        return unsafe { (*(eng.nodes + (node_idx as usize))).fp };
    }

    // Re-execute provider and apply backdating check (AXS-INC-011 §4)
    let had_previous = node.recompute_count > 0u32;
    let old_fp = node.fp;
    let old_aux_fp = node.aux_fp;
    let old_changed_at = node.changed_at;
    let old_is_err = node.is_error;
    let miss_reason = if !had_previous {
        MISS_COLD_CACHE
    } else {
        let mr = unsafe { (*(eng.nodes + (node_idx as usize))).last_miss_reason };
        if mr == MISS_NONE { MISS_SOURCE_CHANGED } else { mr }
    };

    let new_fp = inc_execute_node_provider(mut_view(*eng), node_idx);
    let np = unsafe { eng.nodes + (node_idx as usize) };
    let new_aux_fp = unsafe { (*np).aux_fp };
    let new_is_err = unsafe { (*np).is_error };

    eng.rev_queries_recomputed = eng.rev_queries_recomputed + 1u32;
    eng.total_queries_recomputed = eng.total_queries_recomputed + 1u32;
    eng.db.total_provider_runs = eng.db.total_provider_runs + 1u32;
    eng.db.total_memo_misses = eng.db.total_memo_misses + 1u32;

    let is_backdated = had_previous &&
        fingerprint128_eq(new_fp, old_fp) &&
        fingerprint128_eq(new_aux_fp, old_aux_fp) &&
        new_is_err == old_is_err;

    if is_backdated {
        unsafe {
            (*np).color = NODE_COLOR_GREEN;
            (*np).verified_at = r_curr;
            (*np).changed_at = old_changed_at;
            (*np).was_backdated = true;
            (*np).last_miss_reason = miss_reason;
            (*np).recompute_count = (*np).recompute_count + 1u32;
            (*np).backdate_count = (*np).backdate_count + 1u32;
            (*np).fp = new_fp;
        }
        eng.rev_queries_backdated = eng.rev_queries_backdated + 1u32;
        eng.total_queries_backdated = eng.total_queries_backdated + 1u32;
        if node.node_kind == INC_NODE_CODEGEN_UNIT {
            let m_idx = inc_find_module_index(view(*eng), ModuleId { v: node.owner_id });
            if (m_idx) < (INC_MAX_MODULES) {
                unsafe { (*(eng.modules + m_idx)).cgu_reused_at_rev = r_curr; }
                eng.rev_cgu_reused = eng.rev_cgu_reused + 1u32;
            }
        }
    } else {
        unsafe {
            (*np).color = NODE_COLOR_RED;
            (*np).verified_at = r_curr;
            (*np).changed_at = r_curr;
            (*np).was_backdated = false;
            (*np).last_miss_reason = miss_reason;
            (*np).recompute_count = (*np).recompute_count + 1u32;
            (*np).fp = new_fp;
        }
        if node.node_kind == INC_NODE_CODEGEN_UNIT {
            let m_idx = inc_find_module_index(view(*eng), ModuleId { v: node.owner_id });
            if (m_idx) < (INC_MAX_MODULES) {
                unsafe { (*(eng.modules + m_idx)).cgu_rebuilt_at_rev = r_curr; }
                eng.rev_cgu_rebuilt = eng.rev_cgu_rebuilt + 1u32;
            }
        }
    }
    new_fp
}

// Evaluates all modules' `module_interface` and `codegen_unit` targets in canonical `SemanticKey` order for a workspace build/check.
pub fn inc_build_workspace(eng: mut_view<IncrementalEngine>) {
    let mut mod_idxs: [32]usize = [0; 32];
    let m_count = eng.module_count as usize;
    let mut i: usize = 0;
    while i < m_count {
        mod_idxs[i] = i;
        i = i + 1;
    }
    let mut a: usize = 1;
    while a < m_count {
        let cur = mod_idxs[a];
        let cur_m = unsafe { *(eng.modules + cur) };
        let mut b: usize = a;
        while b > 0 {
            let prev = mod_idxs[b - 1];
            let prev_m = unsafe { *(eng.modules + prev) };
            if semantic_key_cmp(view(prev_m.semantic_key), view(cur_m.semantic_key)) <= 0i32 {
                break;
            }
            mod_idxs[b] = prev;
            b = b - 1;
        }
        mod_idxs[b] = cur;
        a = a + 1;
    }

    let mut k: usize = 0;
    while k < m_count {
        let m = unsafe { *(eng.modules + mod_idxs[k]) };
        let api_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_MODULE_INTERFACE, m.module_id.v, m.semantic_key);
        let _ = inc_ensure_node_evaluated(mut_view(*eng), api_node);
        let cgu_node = inc_find_or_create_node(mut_view(*eng), INC_NODE_CODEGEN_UNIT, m.module_id.v, m.semantic_key);
        let _ = inc_ensure_node_evaluated(mut_view(*eng), cgu_node);
        k = k + 1;
    }
}

pub fn inc_get_node(eng: view<IncrementalEngine>, node_kind: u8, owner_id: u32) -> RedGreenNode {
    let mut i: u32 = 0u32;
    while i < eng.node_count {
        let n = unsafe { *(eng.nodes + (i as usize)) };
        if n.node_kind == node_kind && n.owner_id == owner_id {
            return n;
        }
        i = i + 1u32;
    }
    unsafe { *eng.nodes }
}

// ============================================================================
// 7. Deterministic `--emit=fingerprints` & `--emit=incremental-stats` (AXS-INC-013 §2)
// ============================================================================

fn fp_buf_push_ascii_slice(out: mut_view<DiagBuffer>, start: usize, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), FP_ASCII_TABLE[start + i]);
        i = i + 1;
    }
}

pub fn fp_buf_push_hex_u64(out: mut_view<DiagBuffer>, v: u64) {
    let mut shift: u32 = 60u32;
    let mut i: usize = 0;
    while i < 16 {
        let nib = ((v >> shift) & 0xFu64) as usize;
        diag_buf_push_byte(mut_view(*out), FP_ASCII_TABLE[311 + nib]);
        if shift >= 4u32 {
            shift = shift - 4u32;
        }
        i = i + 1;
    }
}

pub fn fp_buf_push_fp128_hex(out: mut_view<DiagBuffer>, fp: Fingerprint128) {
    fp_buf_push_hex_u64(mut_view(*out), fp.hi);
    fp_buf_push_hex_u64(mut_view(*out), fp.lo);
}

pub fn fp_buf_push_node_kind_name(out: mut_view<DiagBuffer>, nk: u8) {
    if nk == INC_NODE_PARSE_MODULE { fp_buf_push_ascii_slice(out, 106, 12); return; }
    if nk == INC_NODE_RESOLVE_MODULE { fp_buf_push_ascii_slice(out, 118, 14); return; }
    if nk == INC_NODE_MODULE_INTERFACE { fp_buf_push_ascii_slice(out, 132, 16); return; }
    if nk == INC_NODE_ITEM_SIGNATURE { fp_buf_push_ascii_slice(out, 148, 14); return; }
    if nk == INC_NODE_ITEM_ABI { fp_buf_push_ascii_slice(out, 162, 8); return; }
    if nk == INC_NODE_CONST_EVAL { fp_buf_push_ascii_slice(out, 170, 10); return; }
    if nk == INC_NODE_TYPECK_BODY { fp_buf_push_ascii_slice(out, 180, 11); return; }
    if nk == INC_NODE_MIR_BODY { fp_buf_push_ascii_slice(out, 191, 8); return; }
    if nk == INC_NODE_CODEGEN_UNIT { fp_buf_push_ascii_slice(out, 199, 12); return; }
    fp_buf_push_ascii_slice(out, 106, 12);
}

pub fn fp_buf_push_color_name(out: mut_view<DiagBuffer>, color: u8) {
    if color == NODE_COLOR_GREEN { fp_buf_push_ascii_slice(out, 211, 5); return; }
    if color == NODE_COLOR_RED { fp_buf_push_ascii_slice(out, 216, 3); return; }
    fp_buf_push_ascii_slice(out, 219, 7);
}

pub fn fp_buf_push_miss_reason_name(out: mut_view<DiagBuffer>, reason: u8) {
    if reason == MISS_NONE { fp_buf_push_ascii_slice(out, 226, 4); return; }
    if reason == MISS_COLD_CACHE { fp_buf_push_ascii_slice(out, 230, 10); return; }
    if reason == MISS_SOURCE_CHANGED { fp_buf_push_ascii_slice(out, 240, 14); return; }
    if reason == MISS_API_CHANGED { fp_buf_push_ascii_slice(out, 254, 11); return; }
    if reason == MISS_ABI_CHANGED { fp_buf_push_ascii_slice(out, 265, 11); return; }
    if reason == MISS_BODY_CHANGED { fp_buf_push_ascii_slice(out, 276, 12); return; }
    if reason == MISS_CONFIG_CHANGED { fp_buf_push_ascii_slice(out, 288, 14); return; }
    fp_buf_push_ascii_slice(out, 226, 4);
}

// Emits deterministic `inspect --emit=fingerprints` output sorted by `SemanticKey` (AXS-INC-013 §2):
// Header: `fingerprints revision=R<rev> items=<count>\n`
// Per-item: `item <SemanticKey> ast=<hex32> api=<hex32> abi=<hex32> body=<hex32> cgu=<hex32>\n`
pub fn fp_emit_fingerprints(eng: view<IncrementalEngine>, out: mut_view<DiagBuffer>) {
    let mut sorted_idx: [128]usize = [0; 128];
    let count = eng.item_count as usize;
    let mut i: usize = 0;
    while i < count {
        sorted_idx[i] = i;
        i = i + 1;
    }
    let mut a: usize = 1;
    while a < count {
        let cur = sorted_idx[a];
        let cur_it = unsafe { *(eng.items + cur) };
        let mut b: usize = a;
        while b > 0 {
            let prev = sorted_idx[b - 1];
            let prev_it = unsafe { *(eng.items + prev) };
            if semantic_key_cmp(view(prev_it.semantic_key), view(cur_it.semantic_key)) <= 0i32 {
                break;
            }
            sorted_idx[b] = prev;
            b = b - 1;
        }
        sorted_idx[b] = cur;
        a = a + 1;
    }

    // "fingerprints revision=R"
    diag_buf_push_byte(mut_view(*out), 102u8); // 'f'
    diag_buf_push_byte(mut_view(*out), 105u8); // 'i'
    diag_buf_push_byte(mut_view(*out), 110u8); // 'n'
    diag_buf_push_byte(mut_view(*out), 103u8); // 'g'
    diag_buf_push_byte(mut_view(*out), 101u8); // 'e'
    diag_buf_push_byte(mut_view(*out), 114u8); // 'r'
    diag_buf_push_byte(mut_view(*out), 112u8); // 'p'
    diag_buf_push_byte(mut_view(*out), 114u8); // 'r'
    diag_buf_push_byte(mut_view(*out), 105u8); // 'i'
    diag_buf_push_byte(mut_view(*out), 110u8); // 'n'
    diag_buf_push_byte(mut_view(*out), 116u8); // 't'
    diag_buf_push_byte(mut_view(*out), 115u8); // 's'
    diag_buf_push_byte(mut_view(*out), 32u8);  // ' '
    diag_buf_push_byte(mut_view(*out), 114u8); // 'r'
    diag_buf_push_byte(mut_view(*out), 101u8); // 'e'
    diag_buf_push_byte(mut_view(*out), 118u8); // 'v'
    diag_buf_push_byte(mut_view(*out), 105u8); // 'i'
    diag_buf_push_byte(mut_view(*out), 115u8); // 's'
    diag_buf_push_byte(mut_view(*out), 105u8); // 'i'
    diag_buf_push_byte(mut_view(*out), 111u8); // 'o'
    diag_buf_push_byte(mut_view(*out), 110u8); // 'n'
    diag_buf_push_byte(mut_view(*out), 61u8);  // '='
    diag_buf_push_byte(mut_view(*out), 82u8);  // 'R'
    diag_buf_push_u32(mut_view(*out), eng.current_revision.raw as u32);
    // " items="
    diag_buf_push_byte(mut_view(*out), 32u8);
    diag_buf_push_byte(mut_view(*out), 105u8);
    diag_buf_push_byte(mut_view(*out), 116u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 109u8);
    diag_buf_push_byte(mut_view(*out), 115u8);
    diag_buf_push_byte(mut_view(*out), 61u8);
    diag_buf_push_u32(mut_view(*out), count as u32);
    diag_buf_push_byte(mut_view(*out), 10u8);

    let mut k: usize = 0;
    while k < count {
        let it = unsafe { *(eng.items + sorted_idx[k]) };
        // "item "
        diag_buf_push_byte(mut_view(*out), 105u8);
        diag_buf_push_byte(mut_view(*out), 116u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 109u8);
        diag_buf_push_byte(mut_view(*out), 32u8);
        query_db_push_semantic_key(mut_view(*out), view(it.semantic_key));
        // " ast="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 116u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_fp128_hex(mut_view(*out), it.ast_item_fp);
        // " api="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 112u8);
        diag_buf_push_byte(mut_view(*out), 105u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_fp128_hex(mut_view(*out), it.interface_fp);
        // " abi="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 98u8);
        diag_buf_push_byte(mut_view(*out), 105u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_fp128_hex(mut_view(*out), it.abi_fp);
        // " body="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 98u8);
        diag_buf_push_byte(mut_view(*out), 111u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 121u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_fp128_hex(mut_view(*out), it.body_fp);
        // " cgu="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 99u8);
        diag_buf_push_byte(mut_view(*out), 103u8);
        diag_buf_push_byte(mut_view(*out), 117u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_fp128_hex(mut_view(*out), it.codegen_fp);
        diag_buf_push_byte(mut_view(*out), 10u8);
        k = k + 1;
    }
}

fn inc_node_cmp(a: view<RedGreenNode>, b: view<RedGreenNode>) -> i32 {
    if (a.node_kind) < (b.node_kind) { return -1i32; }
    if (a.node_kind) > (b.node_kind) { return 1i32; }
    semantic_key_cmp(view(a.semantic_key), view(b.semantic_key))
}

// Emits deterministic `inspect --emit=incremental-stats` output (AXS-INC-013 §2):
// Summary line:
// `incremental_stats revision=R<rev> queries_total=<N> queries_green_reused=<G> queries_recomputed=<C> queries_backdated=<B> modules_typechecked=<M> cgu_reused=<U> cgu_rebuilt=<R>\n`
// Per-node lines sorted by `(node_kind, SemanticKey)`:
// `node <kind>(<SemanticKey>) color=<Green|Red> verified_at=R<v> changed_at=R<c> backdated=<true|false> miss_reason=<reason>\n`
pub fn fp_emit_incremental_stats(eng: view<IncrementalEngine>, out: mut_view<DiagBuffer>) {
    // "incremental_stats revision=R"
    diag_buf_push_byte(mut_view(*out), 105u8); // 'i'
    diag_buf_push_byte(mut_view(*out), 110u8); // 'n'
    diag_buf_push_byte(mut_view(*out), 99u8);  // 'c'
    diag_buf_push_byte(mut_view(*out), 114u8); // 'r'
    diag_buf_push_byte(mut_view(*out), 101u8); // 'e'
    diag_buf_push_byte(mut_view(*out), 109u8); // 'm'
    diag_buf_push_byte(mut_view(*out), 101u8); // 'e'
    diag_buf_push_byte(mut_view(*out), 110u8); // 'n'
    diag_buf_push_byte(mut_view(*out), 116u8); // 't'
    diag_buf_push_byte(mut_view(*out), 97u8);  // 'a'
    diag_buf_push_byte(mut_view(*out), 108u8); // 'l'
    diag_buf_push_byte(mut_view(*out), 95u8);  // '_'
    diag_buf_push_byte(mut_view(*out), 115u8); // 's'
    diag_buf_push_byte(mut_view(*out), 116u8); // 't'
    diag_buf_push_byte(mut_view(*out), 97u8);  // 'a'
    diag_buf_push_byte(mut_view(*out), 116u8); // 't'
    diag_buf_push_byte(mut_view(*out), 115u8); // 's'
    diag_buf_push_byte(mut_view(*out), 32u8);  // ' '
    diag_buf_push_byte(mut_view(*out), 114u8); // 'r'
    diag_buf_push_byte(mut_view(*out), 101u8); // 'e'
    diag_buf_push_byte(mut_view(*out), 118u8); // 'v'
    diag_buf_push_byte(mut_view(*out), 105u8); // 'i'
    diag_buf_push_byte(mut_view(*out), 115u8); // 's'
    diag_buf_push_byte(mut_view(*out), 105u8); // 'i'
    diag_buf_push_byte(mut_view(*out), 111u8); // 'o'
    diag_buf_push_byte(mut_view(*out), 110u8); // 'n'
    diag_buf_push_byte(mut_view(*out), 61u8);  // '='
    diag_buf_push_byte(mut_view(*out), 82u8);  // 'R'
    diag_buf_push_u32(mut_view(*out), eng.current_revision.raw as u32);

    // " queries_total="
    diag_buf_push_byte(mut_view(*out), 32u8);
    diag_buf_push_byte(mut_view(*out), 113u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 105u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 115u8);
    diag_buf_push_byte(mut_view(*out), 95u8);
    diag_buf_push_byte(mut_view(*out), 116u8);
    diag_buf_push_byte(mut_view(*out), 111u8);
    diag_buf_push_byte(mut_view(*out), 116u8);
    diag_buf_push_byte(mut_view(*out), 97u8);
    diag_buf_push_byte(mut_view(*out), 108u8);
    diag_buf_push_byte(mut_view(*out), 61u8);
    diag_buf_push_u32(mut_view(*out), eng.rev_queries_total);

    // " queries_green_reused="
    diag_buf_push_byte(mut_view(*out), 32u8);
    diag_buf_push_byte(mut_view(*out), 113u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 105u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 115u8);
    diag_buf_push_byte(mut_view(*out), 95u8);
    diag_buf_push_byte(mut_view(*out), 103u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 110u8);
    diag_buf_push_byte(mut_view(*out), 95u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 115u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 100u8);
    diag_buf_push_byte(mut_view(*out), 61u8);
    diag_buf_push_u32(mut_view(*out), eng.rev_queries_green_reused);

    // " queries_recomputed="
    diag_buf_push_byte(mut_view(*out), 32u8);
    diag_buf_push_byte(mut_view(*out), 113u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 105u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 115u8);
    diag_buf_push_byte(mut_view(*out), 95u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 99u8);
    diag_buf_push_byte(mut_view(*out), 111u8);
    diag_buf_push_byte(mut_view(*out), 109u8);
    diag_buf_push_byte(mut_view(*out), 112u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 116u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 100u8);
    diag_buf_push_byte(mut_view(*out), 61u8);
    diag_buf_push_u32(mut_view(*out), eng.rev_queries_recomputed);

    // " queries_backdated="
    diag_buf_push_byte(mut_view(*out), 32u8);
    diag_buf_push_byte(mut_view(*out), 113u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 105u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 115u8);
    diag_buf_push_byte(mut_view(*out), 95u8);
    diag_buf_push_byte(mut_view(*out), 98u8);
    diag_buf_push_byte(mut_view(*out), 97u8);
    diag_buf_push_byte(mut_view(*out), 99u8);
    diag_buf_push_byte(mut_view(*out), 107u8);
    diag_buf_push_byte(mut_view(*out), 100u8);
    diag_buf_push_byte(mut_view(*out), 97u8);
    diag_buf_push_byte(mut_view(*out), 116u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 100u8);
    diag_buf_push_byte(mut_view(*out), 61u8);
    diag_buf_push_u32(mut_view(*out), eng.rev_queries_backdated);

    // " modules_typechecked="
    diag_buf_push_byte(mut_view(*out), 32u8);
    diag_buf_push_byte(mut_view(*out), 109u8);
    diag_buf_push_byte(mut_view(*out), 111u8);
    diag_buf_push_byte(mut_view(*out), 100u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 108u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 115u8);
    diag_buf_push_byte(mut_view(*out), 95u8);
    diag_buf_push_byte(mut_view(*out), 116u8);
    diag_buf_push_byte(mut_view(*out), 121u8);
    diag_buf_push_byte(mut_view(*out), 112u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 99u8);
    diag_buf_push_byte(mut_view(*out), 104u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 99u8);
    diag_buf_push_byte(mut_view(*out), 107u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 100u8);
    diag_buf_push_byte(mut_view(*out), 61u8);
    diag_buf_push_u32(mut_view(*out), eng.rev_modules_typechecked);

    // " cgu_reused="
    diag_buf_push_byte(mut_view(*out), 32u8);
    diag_buf_push_byte(mut_view(*out), 99u8);
    diag_buf_push_byte(mut_view(*out), 103u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 95u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 115u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 100u8);
    diag_buf_push_byte(mut_view(*out), 61u8);
    diag_buf_push_u32(mut_view(*out), eng.rev_cgu_reused);

    // " cgu_rebuilt="
    diag_buf_push_byte(mut_view(*out), 32u8);
    diag_buf_push_byte(mut_view(*out), 99u8);
    diag_buf_push_byte(mut_view(*out), 103u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 95u8);
    diag_buf_push_byte(mut_view(*out), 114u8);
    diag_buf_push_byte(mut_view(*out), 101u8);
    diag_buf_push_byte(mut_view(*out), 98u8);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 105u8);
    diag_buf_push_byte(mut_view(*out), 108u8);
    diag_buf_push_byte(mut_view(*out), 116u8);
    diag_buf_push_byte(mut_view(*out), 61u8);
    diag_buf_push_u32(mut_view(*out), eng.rev_cgu_rebuilt);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // Collect derived nodes verified at current revision
    let mut sorted_nodes: [512]u32 = [0u32; 512];
    let mut n_count: usize = 0;
    let mut i: u32 = 0u32;
    while i < eng.node_count {
        let n = unsafe { *(eng.nodes + (i as usize)) };
        if n.node_kind >= INC_NODE_PARSE_MODULE && n.recompute_count > 0u32 {
            sorted_nodes[n_count] = i;
            n_count = n_count + 1;
        }
        i = i + 1u32;
    }

    let mut a: usize = 1;
    while a < n_count {
        let cur_idx = sorted_nodes[a];
        let cur_n = unsafe { *(eng.nodes + (cur_idx as usize)) };
        let mut b: usize = a;
        while b > 0 {
            let prev_idx = sorted_nodes[b - 1];
            let prev_n = unsafe { *(eng.nodes + (prev_idx as usize)) };
            if inc_node_cmp(view(prev_n), view(cur_n)) <= 0i32 {
                break;
            }
            sorted_nodes[b] = prev_idx;
            b = b - 1;
        }
        sorted_nodes[b] = cur_idx;
        a = a + 1;
    }

    let mut k: usize = 0;
    while k < n_count {
        let n = unsafe { *(eng.nodes + (sorted_nodes[k] as usize)) };
        // "node "
        diag_buf_push_byte(mut_view(*out), 110u8);
        diag_buf_push_byte(mut_view(*out), 111u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 32u8);
        fp_buf_push_node_kind_name(mut_view(*out), n.node_kind);
        diag_buf_push_byte(mut_view(*out), 40u8); // '('
        query_db_push_semantic_key(mut_view(*out), view(n.semantic_key));
        diag_buf_push_byte(mut_view(*out), 41u8); // ')'

        // " color="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 99u8);
        diag_buf_push_byte(mut_view(*out), 111u8);
        diag_buf_push_byte(mut_view(*out), 108u8);
        diag_buf_push_byte(mut_view(*out), 111u8);
        diag_buf_push_byte(mut_view(*out), 114u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_color_name(mut_view(*out), n.color);

        // " verified_at=R"
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 118u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 114u8);
        diag_buf_push_byte(mut_view(*out), 105u8);
        diag_buf_push_byte(mut_view(*out), 102u8);
        diag_buf_push_byte(mut_view(*out), 105u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 116u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        diag_buf_push_byte(mut_view(*out), 82u8);
        diag_buf_push_u32(mut_view(*out), n.verified_at.raw as u32);

        // " changed_at=R"
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 99u8);
        diag_buf_push_byte(mut_view(*out), 104u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 110u8);
        diag_buf_push_byte(mut_view(*out), 103u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 116u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        diag_buf_push_byte(mut_view(*out), 82u8);
        diag_buf_push_u32(mut_view(*out), n.changed_at.raw as u32);

        // " backdated="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 98u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 99u8);
        diag_buf_push_byte(mut_view(*out), 107u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 116u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        if n.was_backdated {
            fp_buf_push_ascii_slice(mut_view(*out), 302, 4);
        } else {
            fp_buf_push_ascii_slice(mut_view(*out), 306, 5);
        }

        // " miss_reason="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 109u8);
        diag_buf_push_byte(mut_view(*out), 105u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_byte(mut_view(*out), 114u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 97u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 111u8);
        diag_buf_push_byte(mut_view(*out), 110u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_miss_reason_name(mut_view(*out), n.last_miss_reason);
        diag_buf_push_byte(mut_view(*out), 10u8);

        k = k + 1;
    }
}
