    diag_buf_push_byte(mut_view(*out), 61u8);
    fp_buf_push_fp128_hex(mut_view(*out), cache.linked_artifact_fp);
    diag_buf_push_byte(mut_view(*out), 10u8);
}

// Emits a complete deterministic dump of the persistent cache state:
// 1. `cache_stats ...`
// 2. Per-CGU `.obj` lines sorted by `SemanticKey`:
//    `cgu <SemanticKey> cgu_fp=<hex32> obj_digest=<hex32> obj_len=<N> syms=<S> relocs=<R> published=<true|false> reused=<true|false>\n`
// 3. Multi-tier item fingerprints (`fp_emit_fingerprints`)
// 4. Red-green incremental query stats (`fp_emit_incremental_stats`)
// 5. Sorted `AXD-060` diagnostics (`inc_cache_emit_diagnostics`)
pub fn inc_cache_inspect_dump(cache: view<IncrementalCache>, out: mut_view<DiagBuffer>) {
    inc_cache_emit_stats(view(*cache), mut_view(*out));

    let mut sorted_cgu: [32]usize = [0; 32];
    let c_cnt = cache.cgu_count as usize;
    let mut i: usize = 0;
    while i < c_cnt {
        sorted_cgu[i] = i;
        i = i + 1;
    }
    let mut a: usize = 1;
    while a < c_cnt {
        let cur = sorted_cgu[a];
        let cur_c = unsafe { *(cache.cgus + cur) };
        let mut b: usize = a;
        while b > 0 {
            let prev = sorted_cgu[b - 1];
            let prev_c = unsafe { *(cache.cgus + prev) };
            if semantic_key_cmp(view(prev_c.semantic_key), view(cur_c.semantic_key)) <= 0i32 {
                break;
            }
            sorted_cgu[b] = prev;
            b = b - 1;
        }
        sorted_cgu[b] = cur;
        a = a + 1;
    }

    let mut k: usize = 0;
    while k < c_cnt {
        let c = unsafe { *(cache.cgus + sorted_cgu[k]) };
        // "cgu "
        diag_buf_push_byte(mut_view(*out), 99u8);
        diag_buf_push_byte(mut_view(*out), 103u8);
        diag_buf_push_byte(mut_view(*out), 117u8);
        diag_buf_push_byte(mut_view(*out), 32u8);
        query_db_push_semantic_key(mut_view(*out), view(c.semantic_key));

        // " cgu_fp="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 99u8);
        diag_buf_push_byte(mut_view(*out), 103u8);
        diag_buf_push_byte(mut_view(*out), 117u8);
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_byte(mut_view(*out), 102u8);
        diag_buf_push_byte(mut_view(*out), 112u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_fp128_hex(mut_view(*out), c.cgu_fp);

        // " obj_digest="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 111u8);
        diag_buf_push_byte(mut_view(*out), 98u8);
        diag_buf_push_byte(mut_view(*out), 106u8);
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 105u8);
        diag_buf_push_byte(mut_view(*out), 103u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 116u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        fp_buf_push_fp128_hex(mut_view(*out), c.obj_digest);

        // " obj_len="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 111u8);
        diag_buf_push_byte(mut_view(*out), 98u8);
        diag_buf_push_byte(mut_view(*out), 106u8);
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_byte(mut_view(*out), 108u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 110u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        diag_buf_push_u32(mut_view(*out), c.obj_len);

        // " syms="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 121u8);
        diag_buf_push_byte(mut_view(*out), 109u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        diag_buf_push_u32(mut_view(*out), c.symbol_count);

        // " relocs="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 114u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 108u8);
        diag_buf_push_byte(mut_view(*out), 111u8);
        diag_buf_push_byte(mut_view(*out), 99u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        diag_buf_push_u32(mut_view(*out), c.reloc_count);

        // " published="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 112u8);
        diag_buf_push_byte(mut_view(*out), 117u8);
        diag_buf_push_byte(mut_view(*out), 98u8);
        diag_buf_push_byte(mut_view(*out), 108u8);
        diag_buf_push_byte(mut_view(*out), 105u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 104u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        if c.is_published {
            cache_buf_push_ascii(mut_view(*out), 118, 4);
        } else {
            cache_buf_push_ascii(mut_view(*out), 122, 5);
        }

        // " reused="
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 114u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 117u8);
        diag_buf_push_byte(mut_view(*out), 115u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 100u8);
        diag_buf_push_byte(mut_view(*out), 61u8);
        if c.reused_from_cache {
            cache_buf_push_ascii(mut_view(*out), 118, 4);
        } else {
            cache_buf_push_ascii(mut_view(*out), 122, 5);
        }
        diag_buf_push_byte(mut_view(*out), 10u8);
        k = k + 1;
    }

    fp_emit_fingerprints(view(cache.eng), mut_view(*out));
    fp_emit_incremental_stats(view(cache.eng), mut_view(*out));
    inc_cache_emit_diagnostics(view(*cache), mut_view(*out));
}
