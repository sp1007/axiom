];

// ============================================================================
// 2. Domain-Prefixed 128-Bit Artifact Hasher & Checked Binary Buffer
// ============================================================================

pub struct AxmiHasher128 {
    pub lo_hasher: AxHasher,
    pub hi_hasher: AxHasher,
    pub domain_id: u8,
}

fn axmi_domain_slice_start(domain_id: u8) -> usize {
    if domain_id == 0u8 { return 0; }
    if domain_id == 1u8 { return 12; }
    if domain_id == 2u8 { return 28; }
    if domain_id == 3u8 { return 44; }
    if domain_id == 4u8 { return 60; }
    76
}

fn axmi_domain_slice_len(domain_id: u8) -> usize {
    if domain_id == 0u8 { return 12; }
    16
}

pub fn axmi_hasher_new(domain_id: u8) -> AxmiHasher128 {
    let mut h = AxmiHasher128 {
        lo_hasher: ax_hasher_new(),
        hi_hasher: ax_hasher_new(),
        domain_id: domain_id,
    };
    ax_hasher_init(mut_view(h.lo_hasher));
    ax_hasher_init(mut_view(h.hi_hasher));
    ax_hasher_write_u64(mut_view(h.lo_hasher), 0x41584D495F4C4F31u64 ^ (domain_id as u64));
    ax_hasher_write_u64(mut_view(h.hi_hasher), 0x41584D495F484931u64 ^ ax_hash_u64((domain_id as u64) + 77u64));
    let start = axmi_domain_slice_start(domain_id);
    let dlen = axmi_domain_slice_len(domain_id);
    let mut i: usize = 0;
    while i < dlen {
        let b = AXMI_ASCII_TABLE[start + i];
        axmi_hasher_write_u8(mut_view(h), b);
        i = i + 1;
    }
    h
}

pub fn axmi_hasher_write_u8(h: mut_view<AxmiHasher128>, b: u8) {
    ax_hasher_write_u32(mut_view(h.lo_hasher), (b as u32) | 0x01000000u32);
    ax_hasher_write_u32(mut_view(h.hi_hasher), ((b ^ 0xA5u8) as u32) | 0x02000000u32);
}

pub fn axmi_hasher_write_u32(h: mut_view<AxmiHasher128>, v: u32) {
    ax_hasher_write_u32(mut_view(h.lo_hasher), v);
    ax_hasher_write_u32(mut_view(h.hi_hasher), v ^ 0x5A5AA5A5u32);
}

pub fn axmi_hasher_write_u64(h: mut_view<AxmiHasher128>, v: u64) {
    ax_hasher_write_u64(mut_view(h.lo_hasher), v);
    ax_hasher_write_u64(mut_view(h.hi_hasher), v ^ 0x9E3779B97F4A7C15u64);
}

pub fn axmi_hasher_write_bytes(h: mut_view<AxmiHasher128>, ptr: *const u8, len: usize) {
    axmi_hasher_write_u64(mut_view(*h), len as u64);
    if len == 0 || (ptr as usize) == 0 {
        return;
    }
    ax_hasher_write(mut_view(h.lo_hasher), ptr, len);
    ax_hasher_write_u64(mut_view(h.hi_hasher), (len as u64) ^ 0xC2B2AE3D27D4EB4Fu64);
    ax_hasher_write(mut_view(h.hi_hasher), ptr, len);
}

pub fn axmi_hasher_write_sv(h: mut_view<AxmiHasher128>, sv: StrView) {
    axmi_hasher_write_bytes(h, sv.ptr, sv.len);
}

pub fn axmi_hasher_write_fp128(h: mut_view<AxmiHasher128>, fp: Fingerprint128) {
    axmi_hasher_write_u64(mut_view(*h), fp.lo);
    axmi_hasher_write_u64(mut_view(*h), fp.hi);
}

pub fn axmi_hasher_write_semantic_key(h: mut_view<AxmiHasher128>, sk: view<SemanticKey>) {
    axmi_hasher_write_sv(mut_view(*h), sk.package_name);
    axmi_hasher_write_sv(mut_view(*h), sk.module_path);
    axmi_hasher_write_u8(mut_view(*h), sk.item_namespace);
    axmi_hasher_write_u32(mut_view(*h), sk.disambiguator_index);
    axmi_hasher_write_sv(mut_view(*h), sk.canonical_name);
    axmi_hasher_write_sv(mut_view(*h), sk.canonical_type_args);
}

pub fn axmi_hasher_finish(h: view<AxmiHasher128>) -> Fingerprint128 {
    let lo = ax_hasher_finish(view(h.lo_hasher));
    let hi_raw = ax_hasher_finish(view(h.hi_hasher));
    let hi = ax_hash_combine(hi_raw, lo ^ ax_hash_u64((h.domain_id as u64) + 333u64));
    Fingerprint128 { lo: lo, hi: hi }
}

pub fn axmi_compute_target_fingerprint(
    target_triple: StrView,
    abi_profile: StrView,
    pointer_width_bytes: u32,
    little_endian: bool,
    cpu_feature_mask: u32,
    panic_strategy: u8
) -> Fingerprint128 {
    let mut h = axmi_hasher_new(4u8);
    axmi_hasher_write_sv(mut_view(h), target_triple);
    axmi_hasher_write_sv(mut_view(h), abi_profile);
    axmi_hasher_write_u32(mut_view(h), pointer_width_bytes);
    axmi_hasher_write_u8(mut_view(h), if little_endian { 1u8 } else { 0u8 });
    axmi_hasher_write_u32(mut_view(h), cpu_feature_mask);
    axmi_hasher_write_u8(mut_view(h), panic_strategy);
    axmi_hasher_finish(view(h))
}

pub struct AxmiBuffer {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

fn axmi_zero_bytes(ptr: *mut u8, count: usize) {
    let mut i: usize = 0;
    while i < count {
        unsafe { *(ptr + i) = 0u8; }
        i = i + 1;
    }
}

pub fn axmi_buf_empty() -> AxmiBuffer {
    AxmiBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

pub fn axmi_buf_init(buf: mut_view<AxmiBuffer>, init_cap: usize) {
    let c = if init_cap < 256 { 256 } else { init_cap };
    let raw = unsafe { heap_alloc(c, 8) };
    axmi_zero_bytes(raw, c);
    buf.ptr = raw;
    buf.len = 0;
    buf.cap = c;
}

pub fn axmi_buf_free(buf: mut_view<AxmiBuffer>) {
    if (buf.ptr as usize) != 0 && buf.cap > 0 {
        unsafe { heap_free(buf.ptr, buf.cap, 8); }
    }
    buf.ptr = 0 as *mut u8;
    buf.len = 0;
    buf.cap = 0;
}

fn axmi_buf_ensure(buf: mut_view<AxmiBuffer>, extra: usize) {
    let need = buf.len + extra;
    if need <= buf.cap {
        return;
    }
    let mut new_cap = if buf.cap == 0 { 512 } else { buf.cap * 2 };
    while new_cap < need {
        new_cap = new_cap * 2;
    }
    let next_ptr = unsafe { heap_alloc(new_cap, 8) };
    axmi_zero_bytes(next_ptr, new_cap);
    let mut i: usize = 0;
    while i < buf.len {
        unsafe { *(next_ptr + i) = *(buf.ptr + i); }
        i = i + 1;
    }
    if (buf.ptr as usize) != 0 && buf.cap > 0 {
        unsafe { heap_free(buf.ptr, buf.cap, 8); }
    }
    buf.ptr = next_ptr;
    buf.cap = new_cap;
}

pub fn axmi_buf_push_u8(buf: mut_view<AxmiBuffer>, v: u8) {
    axmi_buf_ensure(mut_view(*buf), 1);
    unsafe { *(buf.ptr + buf.len) = v; }
    buf.len = buf.len + 1;
}

pub fn axmi_buf_push_u16_le(buf: mut_view<AxmiBuffer>, v: u16) {
    axmi_buf_ensure(mut_view(*buf), 2);
    let p = buf.len;
    unsafe {
        *(buf.ptr + p) = (v & 0xFFu16) as u8;
        *(buf.ptr + p + 1) = ((v >> 8u16) & 0xFFu16) as u8;
    }
    buf.len = p + 2;
}

pub fn axmi_buf_push_u32_le(buf: mut_view<AxmiBuffer>, v: u32) {
    axmi_buf_ensure(mut_view(*buf), 4);
    let p = buf.len;
    unsafe {
        *(buf.ptr + p) = (v & 0xFFu32) as u8;
        *(buf.ptr + p + 1) = ((v >> 8u32) & 0xFFu32) as u8;
        *(buf.ptr + p + 2) = ((v >> 16u32) & 0xFFu32) as u8;
        *(buf.ptr + p + 3) = ((v >> 24u32) & 0xFFu32) as u8;
    }
    buf.len = p + 4;
}

pub fn axmi_buf_push_u64_le(buf: mut_view<AxmiBuffer>, v: u64) {
    axmi_buf_push_u32_le(mut_view(*buf), (v & 0xFFFFFFFFu64) as u32);
    axmi_buf_push_u32_le(mut_view(*buf), ((v >> 32u64) & 0xFFFFFFFFu64) as u32);
}

pub fn axmi_buf_push_fp128_le(buf: mut_view<AxmiBuffer>, fp: Fingerprint128) {
    axmi_buf_push_u64_le(mut_view(*buf), fp.lo);
    axmi_buf_push_u64_le(mut_view(*buf), fp.hi);
}

pub fn axmi_buf_push_bytes(buf: mut_view<AxmiBuffer>, ptr: *const u8, len: usize) {
    if len == 0 || (ptr as usize) == 0 {
        return;
    }
    axmi_buf_ensure(mut_view(*buf), len);
    let mut i: usize = 0;
    while i < len {
        unsafe { *(buf.ptr + buf.len + i) = *(ptr + i); }
        i = i + 1;
    }
    buf.len = buf.len + len;
}

pub fn axmi_buf_align_to(buf: mut_view<AxmiBuffer>, align: usize) {
    if align <= 1 {
        return;
    }
    while (buf.len % align) != 0 {
        axmi_buf_push_u8(mut_view(*buf), 0u8);
    }
}

pub fn axmi_buf_patch_u32_le(buf: mut_view<AxmiBuffer>, offset: usize, v: u32) {
    if offset + 4 <= buf.len {
        unsafe {
            *(buf.ptr + offset) = (v & 0xFFu32) as u8;
            *(buf.ptr + offset + 1) = ((v >> 8u32) & 0xFFu32) as u8;
            *(buf.ptr + offset + 2) = ((v >> 16u32) & 0xFFu32) as u8;
            *(buf.ptr + offset + 3) = ((v >> 24u32) & 0xFFu32) as u8;
        }
    }
}

pub fn axmi_buf_patch_u64_le(buf: mut_view<AxmiBuffer>, offset: usize, v: u64) {
    axmi_buf_patch_u32_le(mut_view(*buf), offset, (v & 0xFFFFFFFFu64) as u32);
    axmi_buf_patch_u32_le(mut_view(*buf), offset + 4, ((v >> 32u64) & 0xFFFFFFFFu64) as u32);
}

pub fn axmi_buf_patch_fp128_le(buf: mut_view<AxmiBuffer>, offset: usize, fp: Fingerprint128) {
    axmi_buf_patch_u64_le(mut_view(*buf), offset, fp.lo);
    axmi_buf_patch_u64_le(mut_view(*buf), offset + 8, fp.hi);
}

pub fn axmi_buf_eq(a: view<AxmiBuffer>, b: view<AxmiBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

// Checked bounds & little-endian reader helpers (AXS-ART-003 sec.3)
pub fn axmi_check_bounds(offset: u64, size: u64, total_size: u64) -> bool {
    if offset > total_size || size > total_size {
        return false;
    }
    let sum = offset + size;
    if sum < offset || sum > total_size {
        return false;
    }
    true
}

pub fn axmi_is_power_of_two_align(align: u32) -> bool {
    align == 1u32 || align == 2u32 || align == 4u32 || align == 8u32 || align == 16u32
}

pub fn axmi_read_u8(ptr: *const u8, offset: usize) -> u8 {
    unsafe { *(ptr + offset) }
}

pub fn axmi_read_u16_le(ptr: *const u8, offset: usize) -> u16 {
    let b0 = (unsafe { *(ptr + offset) }) as u16;
    let b1 = (unsafe { *(ptr + offset + 1) }) as u16;
    b0 | (b1 << 8u16)
}

pub fn axmi_read_u32_le(ptr: *const u8, offset: usize) -> u32 {
    let b0 = (unsafe { *(ptr + offset) }) as u32;
    let b1 = (unsafe { *(ptr + offset + 1) }) as u32;
    let b2 = (unsafe { *(ptr + offset + 2) }) as u32;
    let b3 = (unsafe { *(ptr + offset + 3) }) as u32;
    b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32)
}

pub fn axmi_read_u64_le(ptr: *const u8, offset: usize) -> u64 {
    let lo = axmi_read_u32_le(ptr, offset) as u64;
    let hi = axmi_read_u32_le(ptr, offset + 4) as u64;
    lo | (hi << 32u64)
}

pub fn axmi_read_fp128_le(ptr: *const u8, offset: usize) -> Fingerprint128 {
    let lo = axmi_read_u64_le(ptr, offset);
    let hi = axmi_read_u64_le(ptr, offset + 8);
    Fingerprint128 { lo: lo, hi: hi }
}

// ============================================================================
// 3. `ArtifactHeader`, `SectionDescriptor` & `.axmi` Semantic Table Records
// ============================================================================

@derive(Copy)
pub struct ArtifactId {
    pub content_hash: Fingerprint128,
    pub schema_id: u16,
    pub schema_version: u16,
}

@derive(Copy)
