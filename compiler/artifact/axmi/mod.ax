    pub format_family: u16,
    pub schema_version: u16,
    pub artifact_kind: u16,
    pub flags: u16,
    pub target_fingerprint: Fingerprint128,
    pub interface_fingerprint: Fingerprint128,
    pub section_count: u32,
    pub producer_version: u32,
    pub payload_offset: u64,
    pub payload_size: u64,
    pub content_hash: Fingerprint128,
}

@derive(Copy)
pub struct SectionDescriptor {
    pub id: u32,
    pub section_type: u16,
    pub flags: u16,
    pub alignment: u32,
    pub offset: u64,
    pub compressed_size: u64,
    pub uncompressed_size: u64,
    pub checksum: Fingerprint128,
}

@derive(Copy)
pub struct AxmiExportedSymbol {
    pub def_id: DefId,
    pub item_kind: u8,
    pub is_pub: bool,
    pub is_generic: bool,
    pub is_inline: bool,
    pub is_comptime: bool,
    pub param_count: u32,
    pub return_type_id: TypeId,
    pub generic_param_count: u32,
    pub calling_conv: u8,
    pub sig_fingerprint: Fingerprint128,
    pub abi_fingerprint: Fingerprint128,
    pub semantic_key: SemanticKey,
}

@derive(Copy)
pub struct AxmiTypeDef {
