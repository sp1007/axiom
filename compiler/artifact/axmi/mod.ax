pub const AXMI_MIR_SCHEMA_VERSION: u16 = 1u16;

pub const AXMI_HEADER_SIZE: usize = 64;
pub const AXMI_SECTION_DESC_SIZE: usize = 48;

// Header flags (AXS-ART-002)
