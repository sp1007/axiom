// ============================================================================
// 1. Canonical `.axmi` Header, Magic, Version, Section & Diagnostic Constants
// ============================================================================

// Magic bytes: "AXMI0001" (little-endian u64 = 0x31303030494D5841)
pub const AXMI_MAGIC: [8]u8 = [65u8, 88u8, 77u8, 73u8, 48u8, 48u8, 48u8, 49u8];
pub const AXMI_MAGIC_U64: u64 = 0x31303030494D5841u64;

