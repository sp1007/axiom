    pub field_type_ids: [8]u32,
    pub is_copy: bool,
    pub is_send: bool,
    pub is_share: bool,
    pub layout_fingerprint: Fingerprint128,
    pub semantic_key: SemanticKey,
}

@derive(Copy)
pub struct AxmiTraitImplEntry {
