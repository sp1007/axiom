{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash",
      "PowerShell",
      "Agent",
      "Skill",
      "SendMessage",
      "ListAgents",
      "TaskStop",
      "ToolSearch",
      "Monitor",
      "CronCreate",
      "CronDelete",
      "CronList"
