# build outputs (per-task build dirs: build-T010, build-qa-T010, build-ci from tools/ci.*, and the
# task snapshot worktrees build-snap-T010 created by `taskctl snapshot`)
build/
build-*/
compile_commands.json
CMakeUserPresets.json
*.exe
*.obj
*.o
*.pdb
*.ilk
# Binary fixtures are allowed only under tests/**/fixtures/ (documented in README.md)
!tests/**/fixtures/**

# large intermediate harness outputs
_workspaces/artifacts/
_workspace_prev/

__pycache__/
# autopilot runtime state (per session, not project history)
_workspaces/autopilot.json
_workspaces/autopilot.json.tmp
_workspaces/logs/
# unblock lock and ADR number reservations (taskctl unblock-begin / adr-next)
_workspaces/locks/
# written by `taskctl stuck --write` when the board cannot make progress
_workspaces/STUCK.md
