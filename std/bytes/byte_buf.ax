module std.bytes.byte_buf

use std.core.option.Option
use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub enum ByteBufError {
    OutOfBounds,
}

pub struct ByteBuf {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl Drop for ByteBuf {
    fn drop(self: mut_view<ByteBuf>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn byte_buf_new() -> ByteBuf {
    ByteBuf {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn byte_buf_with_capacity(capacity: usize) -> ByteBuf {
    if capacity == 0 {
        return byte_buf_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    ByteBuf {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub fn byte_buf_len(b: view<ByteBuf>) -> usize {
    b.len
}

pub fn byte_buf_capacity(b: view<ByteBuf>) -> usize {
    b.cap
}

pub fn byte_buf_is_empty(b: view<ByteBuf>) -> bool {
    b.len == 0
}

pub fn byte_buf_clear(b: mut_view<ByteBuf>) {
    b.len = 0;
}

pub fn byte_buf_reserve(b: mut_view<ByteBuf>, additional: usize) {
    let needed = b.len + additional;
    if needed <= b.cap {
        return;
    }
    let mut new_cap = if b.cap == 0 { 16 } else { b.cap * 2 };
    if new_cap < needed {
        new_cap = needed;
    }
    let raw = unsafe { heap_alloc(new_cap, 8) };
    let new_ptr = raw as *mut u8;
    if b.len > 0 && b.ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, new_ptr, b.len);
            heap_free(b.ptr, b.cap, 8);
        }
    }
    b.ptr = new_ptr;
    b.cap = new_cap;
}

pub fn byte_buf_put_u8(b: mut_view<ByteBuf>, val: u8) {
    if b.len == b.cap {
        byte_buf_reserve(mut_view(*b), 1);
    }
    unsafe {
        *(b.ptr + b.len) = val;
    }
    b.len = b.len + 1;
}

pub fn byte_buf_put_u16(b: mut_view<ByteBuf>, val: u16) {
    if b.len + 2 > b.cap {
        byte_buf_reserve(mut_view(*b), 2);
    }
    unsafe {
        let p = b.ptr + b.len;
        *p = (val & 0xFFu16) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu16) as u8;
    }
    b.len = b.len + 2;
}

pub fn byte_buf_put_u32(b: mut_view<ByteBuf>, val: u32) {
    if b.len + 4 > b.cap {
        byte_buf_reserve(mut_view(*b), 4);
    }
    unsafe {
        let p = b.ptr + b.len;
        *p = (val & 0xFFu32) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu32) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu32) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu32) as u8;
    }
    b.len = b.len + 4;
}

pub fn byte_buf_put_u64(b: mut_view<ByteBuf>, val: u64) {
    if b.len + 8 > b.cap {
        byte_buf_reserve(mut_view(*b), 8);
    }
    unsafe {
        let p = b.ptr + b.len;
        *p = (val & 0xFFu64) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu64) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu64) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu64) as u8;
        *(p + 4) = ((val >> 32) & 0xFFu64) as u8;
        *(p + 5) = ((val >> 40) & 0xFFu64) as u8;
        *(p + 6) = ((val >> 48) & 0xFFu64) as u8;
        *(p + 7) = ((val >> 56) & 0xFFu64) as u8;
    }
    b.len = b.len + 8;
}

pub fn byte_buf_put_i8(b: mut_view<ByteBuf>, val: i8) {
    byte_buf_put_u8(b, val as u8);
}

pub fn byte_buf_put_i16(b: mut_view<ByteBuf>, val: i16) {
    byte_buf_put_u16(b, val as u16);
}

pub fn byte_buf_put_i32(b: mut_view<ByteBuf>, val: i32) {
    byte_buf_put_u32(b, val as u32);
}

pub fn byte_buf_put_i64(b: mut_view<ByteBuf>, val: i64) {
    byte_buf_put_u64(b, val as u64);
}

pub fn byte_buf_put_usize(b: mut_view<ByteBuf>, val: usize) {
    byte_buf_put_u64(b, val as u64);
}

pub fn byte_buf_put_isize(b: mut_view<ByteBuf>, val: isize) {
    byte_buf_put_i64(b, val as i64);
}

pub fn byte_buf_put_bytes(b: mut_view<ByteBuf>, bytes: view<[u8]>) {
    let n = len(bytes);
    if n == 0 {
        return;
    }
    byte_buf_reserve(mut_view(*b), n);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(b.ptr + b.len + i) = bytes[i];
        }
        i = i + 1;
    }
    b.len = b.len + n;
}

pub fn byte_buf_patch_u32_at(b: mut_view<ByteBuf>, offset: usize, val: u32) -> Result<(), ByteBufError> {
    let blen = b.len;
    if blen < 4 || offset > blen - 4 {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    unsafe {
        let p = b.ptr + offset;
        *p = (val & 0xFFu32) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu32) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu32) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu32) as u8;
    }
    Result.Ok(())
}

pub fn byte_buf_patch_u8_at(b: mut_view<ByteBuf>, offset: usize, val: u8) -> Result<(), ByteBufError> {
    if offset >= b.len {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    unsafe {
        *(b.ptr + offset) = val;
    }
    Result.Ok(())
}

pub fn byte_buf_patch_u16_at(b: mut_view<ByteBuf>, offset: usize, val: u16) -> Result<(), ByteBufError> {
    let blen = b.len;
    if blen < 2 || offset > blen - 2 {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    unsafe {
        let p = b.ptr + offset;
        *p = (val & 0xFFu16) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu16) as u8;
    }
    Result.Ok(())
}

pub fn byte_buf_patch_u64_at(b: mut_view<ByteBuf>, offset: usize, val: u64) -> Result<(), ByteBufError> {
    let blen = b.len;
    if blen < 8 || offset > blen - 8 {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    unsafe {
        let p = b.ptr + offset;
        *p = (val & 0xFFu64) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu64) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu64) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu64) as u8;
        *(p + 4) = ((val >> 32) & 0xFFu64) as u8;
        *(p + 5) = ((val >> 40) & 0xFFu64) as u8;
        *(p + 6) = ((val >> 48) & 0xFFu64) as u8;
        *(p + 7) = ((val >> 56) & 0xFFu64) as u8;
    }
    Result.Ok(())
}

pub fn byte_buf_pad_to(b: mut_view<ByteBuf>, align: usize, pad_byte: u8) {
    if align <= 1 {
        return;
    }
    let rem = b.len % align;
    if rem != 0 {
        let mut count = align - rem;
        while count > 0 {
            byte_buf_put_u8(mut_view(*b), pad_byte);
            count = count - 1;
        }
    }
}

pub fn byte_buf_align_to(b: mut_view<ByteBuf>, align: usize) {
    byte_buf_pad_to(b, align, 0u8);
}

pub fn byte_buf_get(b: view<ByteBuf>, index: usize) -> Option<u8> {
    if index >= b.len {
        Option.None
    } else {
        let v = unsafe { *(b.ptr + index) };
        Option.Some(v)
    }
}

pub fn byte_buf_set(b: mut_view<ByteBuf>, index: usize, val: u8) -> Result<(), ByteBufError> {
    if index >= b.len {
        Result.Err(ByteBufError.OutOfBounds)
    } else {
        unsafe {
            *(b.ptr + index) = val;
        }
        Result.Ok(())
    }
}

pub unsafe fn byte_buf_as_ptr(b: view<ByteBuf>) -> *const u8 {
    b.ptr as *const u8
}

pub unsafe fn byte_buf_as_mut_ptr(b: mut_view<ByteBuf>) -> *mut u8 {
    b.ptr
}

pub fn byte_buf_clone(b: view<ByteBuf>) -> ByteBuf {
    if b.len == 0 {
        return byte_buf_new();
    }
    let mut res = byte_buf_with_capacity(b.len);
    unsafe {
        ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, res.ptr, b.len);
    }
    res.len = b.len;
    res
}

pub fn byte_buf_slice(b: view<ByteBuf>, start: usize, end: usize) -> Result<ByteBuf, ByteBufError> {
    let blen = b.len;
    if start > end || end > blen {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    let slice_len = end - start;
    if slice_len == 0 {
        return Result.Ok(byte_buf_new());
    }
    let mut res = byte_buf_with_capacity(slice_len);
    unsafe {
        ptr_copy_nonoverlapping<u8>((b.ptr + start) as *const u8, res.ptr, slice_len);
    }
    res.len = slice_len;
    Result.Ok(res)
}

pub fn byte_buf_eq(a: view<ByteBuf>, b: view<ByteBuf>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

impl ByteBuf {
    pub fn len(self: view<ByteBuf>) -> usize { self.len }
    pub fn capacity(self: view<ByteBuf>) -> usize { self.cap }
    pub fn is_empty(self: view<ByteBuf>) -> bool { self.len == 0 }
    pub fn clear(self: mut_view<ByteBuf>) { byte_buf_clear(self); }
    pub fn reserve(self: mut_view<ByteBuf>, additional: usize) { byte_buf_reserve(self, additional); }
    pub fn put_u8(self: mut_view<ByteBuf>, val: u8) { byte_buf_put_u8(self, val); }
    pub fn put_u16(self: mut_view<ByteBuf>, val: u16) { byte_buf_put_u16(self, val); }
    pub fn put_u32(self: mut_view<ByteBuf>, val: u32) { byte_buf_put_u32(self, val); }
    pub fn put_u64(self: mut_view<ByteBuf>, val: u64) { byte_buf_put_u64(self, val); }
    pub fn put_i8(self: mut_view<ByteBuf>, val: i8) { byte_buf_put_i8(self, val); }
    pub fn put_i16(self: mut_view<ByteBuf>, val: i16) { byte_buf_put_i16(self, val); }
    pub fn put_i32(self: mut_view<ByteBuf>, val: i32) { byte_buf_put_i32(self, val); }
    pub fn put_i64(self: mut_view<ByteBuf>, val: i64) { byte_buf_put_i64(self, val); }
    pub fn put_usize(self: mut_view<ByteBuf>, val: usize) { byte_buf_put_usize(self, val); }
    pub fn put_isize(self: mut_view<ByteBuf>, val: isize) { byte_buf_put_isize(self, val); }
    pub fn put_bytes(self: mut_view<ByteBuf>, bytes: view<[u8]>) { byte_buf_put_bytes(self, bytes); }
    pub fn patch_u32_at(self: mut_view<ByteBuf>, offset: usize, val: u32) -> Result<(), ByteBufError> { byte_buf_patch_u32_at(self, offset, val) }
    pub fn patch_u8_at(self: mut_view<ByteBuf>, offset: usize, val: u8) -> Result<(), ByteBufError> { byte_buf_patch_u8_at(self, offset, val) }
    pub fn patch_u16_at(self: mut_view<ByteBuf>, offset: usize, val: u16) -> Result<(), ByteBufError> { byte_buf_patch_u16_at(self, offset, val) }
    pub fn patch_u64_at(self: mut_view<ByteBuf>, offset: usize, val: u64) -> Result<(), ByteBufError> { byte_buf_patch_u64_at(self, offset, val) }
    pub fn pad_to(self: mut_view<ByteBuf>, align: usize, pad_byte: u8) { byte_buf_pad_to(self, align, pad_byte); }
    pub fn align_to(self: mut_view<ByteBuf>, align: usize) { byte_buf_align_to(self, align); }
    pub fn get(self: view<ByteBuf>, index: usize) -> Option<u8> { byte_buf_get(self, index) }
    pub fn set(self: mut_view<ByteBuf>, index: usize, val: u8) -> Result<(), ByteBufError> { byte_buf_set(self, index, val) }
    pub fn clone(self: view<ByteBuf>) -> ByteBuf { byte_buf_clone(self) }
    pub fn slice(self: view<ByteBuf>, start: usize, end: usize) -> Result<ByteBuf, ByteBufError> { byte_buf_slice(self, start, end) }
    pub fn eq(self: view<ByteBuf>, other: view<ByteBuf>) -> bool { byte_buf_eq(self, other) }
}
