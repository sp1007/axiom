// Standard Library Container Semantic Properties (`ContainerContract`) & API Effect
// Metadata Registry (`ApiEffectSummary`: allocation, blocking, synchronization, panic,
// view invalidation, authority capability, and unsafe precondition contracts) (T814 / E19.4).
// Implements SPEC-103 §5.2 & §5.3 (AXS-AI-011..012, REQ-TOOL-181, REQ-TOOL-190).
module std.meta_effects

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// ============================================================================
// 1. Lightweight String Slice Helpers for Self-Contained `std.meta_effects`
// ============================================================================

@derive(Copy)
pub struct MetaStr {
    pub ptr: *const u8,
    pub len: usize,
}

pub fn meta_str(s: str) -> MetaStr {
    let raw: MetaStr = unsafe { *(address_of(s) as *const MetaStr) }
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) }
    let n = raw.len
    let dst = unsafe { heap_alloc(n + 1, 1) }
    let mut i: usize = 0
    while i < n {
        unsafe { *(dst + i) = bytes[i] }
        i = i + 1
    }
    unsafe { *(dst + n) = 0u8 }
    MetaStr { ptr: dst as *const u8, len: n }
}

pub fn meta_str_empty() -> MetaStr {
    MetaStr { ptr: 0 as *const u8, len: 0 }
}

pub fn meta_str_eq(a: MetaStr, b: MetaStr) -> bool {
    if a.len != b.len {
        return false
    }
    let mut i: usize = 0
    while i < a.len {
        let ba = if (a.ptr as usize) != 0 { unsafe { *(a.ptr + i) } } else { 0u8 }
        let bb = if (b.ptr as usize) != 0 { unsafe { *(b.ptr + i) } } else { 0u8 }
        if ba != bb {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================================
// 2. Container Semantic Properties (`StorageKind`, `ContainerContract`, `AXS-AI-011`)
// ============================================================================

@derive(Copy)
pub enum StorageKind {
    InlineFixed,
    HeapContiguous,
    HeapTable,
    HeapNodeGraph,
    BorrowedContiguous,
    SharedRefCounted,
}

pub const STORAGE_INLINE_FIXED: u8 = 0u8
pub const STORAGE_HEAP_CONTIGUOUS: u8 = 1u8
pub const STORAGE_HEAP_TABLE: u8 = 2u8
pub const STORAGE_HEAP_NODE_GRAPH: u8 = 3u8
pub const STORAGE_BORROWED_CONTIGUOUS: u8 = 4u8
pub const STORAGE_SHARED_REF_COUNTED: u8 = 5u8

pub fn storage_kind_id(k: StorageKind) -> u8 {
    match k {
        StorageKind.InlineFixed => STORAGE_INLINE_FIXED,
        StorageKind.HeapContiguous => STORAGE_HEAP_CONTIGUOUS,
        StorageKind.HeapTable => STORAGE_HEAP_TABLE,
        StorageKind.HeapNodeGraph => STORAGE_HEAP_NODE_GRAPH,
        StorageKind.BorrowedContiguous => STORAGE_BORROWED_CONTIGUOUS,
        StorageKind.SharedRefCounted => STORAGE_SHARED_REF_COUNTED,
    }
}

pub fn storage_kind_name(k: StorageKind) -> MetaStr {
    match k {
        StorageKind.InlineFixed => meta_str("InlineFixed"),
        StorageKind.HeapContiguous => meta_str("HeapContiguous"),
        StorageKind.HeapTable => meta_str("HeapTable"),
        StorageKind.HeapNodeGraph => meta_str("HeapNodeGraph"),
        StorageKind.BorrowedContiguous => meta_str("BorrowedContiguous"),
        StorageKind.SharedRefCounted => meta_str("SharedRefCounted"),
    }
}

@derive(Copy)
pub struct ContainerContract {
    pub type_name: MetaStr,
    pub canonical_path: MetaStr,
    pub ownership_kind: MetaStr,
    pub storage_kind: StorageKind,
    pub contiguous: bool,
    pub relocatable: bool,
    pub address_stable: bool,
    pub random_access: bool,
    pub preserves_order: bool,
    pub concurrency_model: MetaStr,
    pub invalidation_rule_0: MetaStr,
    pub invalidation_rule_1: MetaStr,
    pub invalidation_rule_count: u32,
    pub invalidation_diag_code: MetaStr,
}

pub fn container_contract_empty() -> ContainerContract {
    let e = meta_str_empty()
    ContainerContract {
        type_name: e,
        canonical_path: e,
        ownership_kind: e,
        storage_kind: StorageKind.InlineFixed,
        contiguous: false,
        relocatable: false,
        address_stable: false,
        random_access: false,
        preserves_order: false,
        concurrency_model: e,
        invalidation_rule_0: e,
        invalidation_rule_1: e,
        invalidation_rule_count: 0u32,
        invalidation_diag_code: e,
    }
}

pub const META_CONTAINER_COUNT: u32 = 8u32

pub fn meta_container_contract_at(idx: u32) -> ContainerContract {
    let e = meta_str_empty()
    if idx == 0u32 {
        return ContainerContract {
            type_name: meta_str("Vec"),
            canonical_path: meta_str("std.collections.Vec<T>"),
            ownership_kind: meta_str("owning"),
            storage_kind: StorageKind.HeapContiguous,
            contiguous: true,
            relocatable: true,
            address_stable: false,
            random_access: true,
            preserves_order: true,
            concurrency_model: meta_str("single_owner_send_if_t"),
            invalidation_rule_0: meta_str("push, reserve, insert, remove, truncate, clear invalidate element views (AX_CAP_CONTAINER_RELOC)"),
            invalidation_rule_1: meta_str("moving Vec<T> invalidates all active view<T>/mut_view<T> borrows (AX_CAP_OUTLIVES_OWNER)"),
            invalidation_rule_count: 2u32,
            invalidation_diag_code: meta_str("AX_CAP_CONTAINER_RELOC"),
        }
    }
    if idx == 1u32 {
        return ContainerContract {
            type_name: meta_str("HashMap"),
            canonical_path: meta_str("std.collections.HashMap<K, V>"),
            ownership_kind: meta_str("owning"),
            storage_kind: StorageKind.HeapTable,
            contiguous: false,
            relocatable: true,
            address_stable: false,
            random_access: false,
            preserves_order: true,
            concurrency_model: meta_str("single_owner_send_if_kv"),
            invalidation_rule_0: meta_str("insert, remove, reserve, rehash invalidate entry/value views (AX_CAP_CONTAINER_RELOC)"),
            invalidation_rule_1: meta_str("deterministic insertion order preserved across rehash (INV-KERN-007)"),
            invalidation_rule_count: 2u32,
            invalidation_diag_code: meta_str("AX_CAP_CONTAINER_RELOC"),
        }
    }
    if idx == 2u32 {
        return ContainerContract {
            type_name: meta_str("Slice"),
            canonical_path: meta_str("std.core.Slice<T>"),
            ownership_kind: meta_str("borrowed_view"),
            storage_kind: StorageKind.BorrowedContiguous,
            contiguous: true,
            relocatable: false,
            address_stable: true,
            random_access: true,
            preserves_order: true,
            concurrency_model: meta_str("share_if_t_share"),
            invalidation_rule_0: meta_str("owner mutation or drop forbidden while slice view is live (AX_CAP_CONFLICT_MUT)"),
            invalidation_rule_1: e,
            invalidation_rule_count: 1u32,
            invalidation_diag_code: meta_str("AX_CAP_CONFLICT_MUT"),
        }
    }
    if idx == 3u32 {
        return ContainerContract {
            type_name: meta_str("String"),
            canonical_path: meta_str("std.collections.String"),
            ownership_kind: meta_str("owning"),
            storage_kind: StorageKind.HeapContiguous,
            contiguous: true,
            relocatable: true,
            address_stable: false,
            random_access: true,
            preserves_order: true,
            concurrency_model: meta_str("single_owner_send_share"),
            invalidation_rule_0: meta_str("push_str, reserve, clear invalidate Str/byte views (AX_CAP_CONTAINER_RELOC)"),
            invalidation_rule_1: e,
            invalidation_rule_count: 1u32,
            invalidation_diag_code: meta_str("AX_CAP_CONTAINER_RELOC"),
        }
    }
    if idx == 4u32 {
        return ContainerContract {
            type_name: meta_str("Array"),
            canonical_path: meta_str("[N]T"),
            ownership_kind: meta_str("owning"),
            storage_kind: StorageKind.InlineFixed,
            contiguous: true,
            relocatable: false,
            address_stable: true,
            random_access: true,
            preserves_order: true,
            concurrency_model: meta_str("single_owner_send_if_t"),
            invalidation_rule_0: meta_str("moving array invalidates element views (AX_CAP_OUTLIVES_OWNER)"),
            invalidation_rule_1: e,
            invalidation_rule_count: 1u32,
            invalidation_diag_code: meta_str("AX_CAP_OUTLIVES_OWNER"),
        }
    }
    if idx == 5u32 {
        return ContainerContract {
            type_name: meta_str("Str"),
            canonical_path: meta_str("std.core.Str"),
            ownership_kind: meta_str("borrowed_view"),
            storage_kind: StorageKind.BorrowedContiguous,
            contiguous: true,
            relocatable: false,
            address_stable: true,
            random_access: true,
            preserves_order: true,
            concurrency_model: meta_str("immutable_utf8_view"),
            invalidation_rule_0: meta_str("backing String mutation or reallocation forbidden while Str is live (AX_CAP_CONTAINER_RELOC)"),
            invalidation_rule_1: e,
            invalidation_rule_count: 1u32,
            invalidation_diag_code: meta_str("AX_CAP_CONTAINER_RELOC"),
        }
    }
    if idx == 6u32 {
        return ContainerContract {
            type_name: meta_str("Box"),
            canonical_path: meta_str("std.alloc.Box<T>"),
            ownership_kind: meta_str("owning"),
            storage_kind: StorageKind.HeapContiguous,
            contiguous: true,
            relocatable: false,
            address_stable: true,
            random_access: true,
            preserves_order: true,
            concurrency_model: meta_str("single_owner_send_if_t"),
            invalidation_rule_0: meta_str("moving Box transfers ownership and invalidates derived views (AX_CAP_OUTLIVES_OWNER)"),
            invalidation_rule_1: e,
            invalidation_rule_count: 1u32,
            invalidation_diag_code: meta_str("AX_CAP_OUTLIVES_OWNER"),
        }
    }
    ContainerContract {
        type_name: meta_str("Arc"),
        canonical_path: meta_str("std.sync.Arc<T>"),
        ownership_kind: meta_str("shared_rc"),
        storage_kind: StorageKind.SharedRefCounted,
        contiguous: true,
        relocatable: false,
        address_stable: true,
        random_access: true,
        preserves_order: true,
        concurrency_model: meta_str("atomic_arc"),
        invalidation_rule_0: meta_str("shared read-only view<T>; interior mutation requires Mutex/RwLock/Atomic"),
        invalidation_rule_1: e,
        invalidation_rule_count: 1u32,
        invalidation_diag_code: meta_str("AX_CAP_CONFLICT_MUT"),
    }
}

pub fn meta_lookup_container_contract(query_name: MetaStr, out: mut_view<ContainerContract>) -> bool {
    let mut i: u32 = 0u32
    while i < META_CONTAINER_COUNT {
        let c = meta_container_contract_at(i)
        if meta_str_eq(c.type_name, query_name) || meta_str_eq(c.canonical_path, query_name) {
            *out = c
            return true
        }
        i = i + 1u32
    }
    if meta_str_eq(query_name, meta_str("Vec<T>")) || meta_str_eq(query_name, meta_str("Vec<i32>")) {
        *out = meta_container_contract_at(0u32)
        return true
    }
    if meta_str_eq(query_name, meta_str("HashMap<K, V>")) || meta_str_eq(query_name, meta_str("HashMap<Str, i32>")) {
        *out = meta_container_contract_at(1u32)
        return true
    }
    if meta_str_eq(query_name, meta_str("Slice<T>")) || meta_str_eq(query_name, meta_str("view<[T]>")) || meta_str_eq(query_name, meta_str("[T]")) {
        *out = meta_container_contract_at(2u32)
        return true
    }
    if meta_str_eq(query_name, meta_str("[N]T")) || meta_str_eq(query_name, meta_str("[8]u8")) {
        *out = meta_container_contract_at(4u32)
        return true
    }
    if meta_str_eq(query_name, meta_str("Box<T>")) {
        *out = meta_container_contract_at(6u32)
        return true
    }
    if meta_str_eq(query_name, meta_str("Arc<T>")) {
        *out = meta_container_contract_at(7u32)
        return true
    }
    false
}

// ============================================================================
// 3. `std.meta_effects` API Effect Contracts (`AllocBehavior`, `BlockingBehavior`, `SyncBehavior`, `AXS-AI-012`)
// ============================================================================

@derive(Copy)
pub enum AllocBehavior {
    NeverAllocates,
    MayAllocate,
    AlwaysAllocates,
}

pub const ALLOC_NEVER: u8 = 0u8
pub const ALLOC_MAY: u8 = 1u8
pub const ALLOC_ALWAYS: u8 = 2u8

pub fn alloc_behavior_id(a: AllocBehavior) -> u8 {
    match a {
        AllocBehavior.NeverAllocates => ALLOC_NEVER,
        AllocBehavior.MayAllocate => ALLOC_MAY,
        AllocBehavior.AlwaysAllocates => ALLOC_ALWAYS,
    }
}

pub fn alloc_behavior_name(a: AllocBehavior) -> MetaStr {
    match a {
        AllocBehavior.NeverAllocates => meta_str("NeverAllocates"),
        AllocBehavior.MayAllocate => meta_str("MayAllocate"),
        AllocBehavior.AlwaysAllocates => meta_str("AlwaysAllocates"),
    }
}

@derive(Copy)
pub enum BlockingBehavior {
    NonBlocking,
    MayBlock,
    AsyncSuspends,
}

pub const BLOCK_NON_BLOCKING: u8 = 0u8
pub const BLOCK_MAY_BLOCK: u8 = 1u8
pub const BLOCK_ASYNC_SUSPENDS: u8 = 2u8

pub fn blocking_behavior_id(b: BlockingBehavior) -> u8 {
    match b {
        BlockingBehavior.NonBlocking => BLOCK_NON_BLOCKING,
        BlockingBehavior.MayBlock => BLOCK_MAY_BLOCK,
        BlockingBehavior.AsyncSuspends => BLOCK_ASYNC_SUSPENDS,
    }
}

pub fn blocking_behavior_name(b: BlockingBehavior) -> MetaStr {
    match b {
        BlockingBehavior.NonBlocking => meta_str("NonBlocking"),
        BlockingBehavior.MayBlock => meta_str("MayBlock"),
        BlockingBehavior.AsyncSuspends => meta_str("AsyncSuspends"),
    }
}

@derive(Copy)
pub enum SyncBehavior {
    None,
    AcquireReleaseLock,
    AtomicOrdering,
    ThreadLifecycle,
    AsyncTaskWake,
}

pub const SYNC_NONE: u8 = 0u8
pub const SYNC_ACQUIRE_RELEASE_LOCK: u8 = 1u8
pub const SYNC_ATOMIC_ORDERING: u8 = 2u8
pub const SYNC_THREAD_LIFECYCLE: u8 = 3u8
pub const SYNC_ASYNC_TASK_WAKE: u8 = 4u8

pub fn sync_behavior_id(s: SyncBehavior) -> u8 {
    match s {
        SyncBehavior.None => SYNC_NONE,
        SyncBehavior.AcquireReleaseLock => SYNC_ACQUIRE_RELEASE_LOCK,
        SyncBehavior.AtomicOrdering => SYNC_ATOMIC_ORDERING,
        SyncBehavior.ThreadLifecycle => SYNC_THREAD_LIFECYCLE,
        SyncBehavior.AsyncTaskWake => SYNC_ASYNC_TASK_WAKE,
    }
}

pub fn sync_behavior_name(s: SyncBehavior) -> MetaStr {
    match s {
        SyncBehavior.None => meta_str("None"),
        SyncBehavior.AcquireReleaseLock => meta_str("AcquireReleaseLock"),
        SyncBehavior.AtomicOrdering => meta_str("AtomicOrdering"),
        SyncBehavior.ThreadLifecycle => meta_str("ThreadLifecycle"),
        SyncBehavior.AsyncTaskWake => meta_str("AsyncTaskWake"),
    }
}

@derive(Copy)
pub struct ApiEffectSummary {
    pub api_path: MetaStr,
    pub receiver_mode: MetaStr,
    pub allocates: AllocBehavior,
    pub blocks: BlockingBehavior,
    pub synchronizes: SyncBehavior,
    pub panics: MetaStr,
    pub invalidates_views: bool,
    pub invalidation_detail: MetaStr,
    pub os_io: bool,
    pub ffi: bool,
    pub unsafe_required: bool,
    pub required_authority_cap: MetaStr,
    pub required_cap_count: u32,
    pub unsafe_precondition: MetaStr,
    pub unsafe_precond_count: u32,
    pub complexity: MetaStr,
}

pub fn api_effect_summary_empty() -> ApiEffectSummary {
    let e = meta_str_empty()
    ApiEffectSummary {
        api_path: e,
        receiver_mode: e,
        allocates: AllocBehavior.NeverAllocates,
        blocks: BlockingBehavior.NonBlocking,
        synchronizes: SyncBehavior.None,
        panics: e,
        invalidates_views: false,
        invalidation_detail: e,
        os_io: false,
        ffi: false,
        unsafe_required: false,
        required_authority_cap: e,
        required_cap_count: 0u32,
        unsafe_precondition: e,
        unsafe_precond_count: 0u32,
        complexity: e,
    }
}

