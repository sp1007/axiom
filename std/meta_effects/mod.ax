            required_cap_count: 0u32,
            unsafe_precondition: e,
            unsafe_precond_count: 0u32,
            complexity: meta_str("O(1)"),
        }
    }
    ApiEffectSummary {
        api_path: meta_str("std.collections.String.push_str"),
        receiver_mode: meta_str("mut_view"),
        allocates: AllocBehavior.MayAllocate,
        blocks: BlockingBehavior.NonBlocking,
        synchronizes: SyncBehavior.None,
        panics: meta_str("on_oom"),
        invalidates_views: true,
        invalidation_detail: meta_str("views:on_reallocation"),
        os_io: false,
        ffi: false,
        unsafe_required: false,
        required_authority_cap: e,
        required_cap_count: 0u32,
        unsafe_precondition: e,
        unsafe_precond_count: 0u32,
        complexity: meta_str("amortized O(len)"),
    }
}

pub fn meta_lookup_api_effect(query_path: MetaStr, out: mut_view<ApiEffectSummary>) -> bool {
    let mut i: u32 = 0u32
    while i < META_API_EFFECT_COUNT {
        let eff = meta_api_effect_at(i)
        if meta_str_eq(eff.api_path, query_path) {
            *out = eff
            return true
        }
        i = i + 1u32
    }
    if meta_str_eq(query_path, meta_str("Vec.push")) || meta_str_eq(query_path, meta_str("packet_proc.append_tag")) {
        *out = meta_api_effect_at(2u32)
        if meta_str_eq(query_path, meta_str("packet_proc.append_tag")) {
            out.api_path = meta_str("packet_proc.append_tag")
        }
        return true
    }
    if meta_str_eq(query_path, meta_str("HashMap.insert")) {
        *out = meta_api_effect_at(4u32)
        return true
    }
    if meta_str_eq(query_path, meta_str("Mutex.lock")) {
        *out = meta_api_effect_at(5u32)
        return true
    }
    if meta_str_eq(query_path, meta_str("File.read")) || meta_str_eq(query_path, meta_str("std.fs.read_to_string")) {
        *out = meta_api_effect_at(7u32)
        return true
    }
    if meta_str_eq(query_path, meta_str("volatile_load")) {
        *out = meta_api_effect_at(9u32)
        return true
    }
    false
}
