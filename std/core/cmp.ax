// bool
impl PartialEq for bool {
    fn eq(self: view<bool>, other: view<bool>) -> bool { *self == *other }
}
impl Eq for bool {}
impl Ord for bool {
    fn cmp(self: view<bool>, other: view<bool>) -> Ordering {
        if *self == *other { Ordering.Equal }
        else if !*self && *other { Ordering.Less }
        else { Ordering.Greater }
    }
}

// char
impl PartialEq for char {
    fn eq(self: view<char>, other: view<char>) -> bool { *self == *other }
}
impl Eq for char {}
impl Ord for char {
    fn cmp(self: view<char>, other: view<char>) -> Ordering {
        if *self < *other { Ordering.Less }
        else if *self > *other { Ordering.Greater }
        else { Ordering.Equal }
    }
}

fn compare_item<T: Ord>(a: view<T>, b: view<T>) -> Ordering {
    a.cmp(b)
}

// Tuple implementations (up to arity 4, ADR-0004 §6)

// Arity 2
impl<A: PartialEq, B: PartialEq> PartialEq for (A, B) {
    fn eq(self: view<(A, B)>, other: view<(A, B)>) -> bool {
        let (a1, b1) = *self;
        let (a2, b2) = *other;
        a1 == a2 && b1 == b2
    }
}
impl<A: Eq, B: Eq> Eq for (A, B) {}
impl<A: Ord, B: Ord> Ord for (A, B) {
    fn cmp(self: view<(A, B)>, other: view<(A, B)>) -> Ordering {
        let (a1, b1) = *self;
        let (a2, b2) = *other;
        let c1 = compare_item(view(a1), view(a2));
        match c1 {
            Ordering.Equal => compare_item(view(b1), view(b2)),
            _ => c1,
        }
    }
}

// Arity 3
impl<A: PartialEq, B: PartialEq, C: PartialEq> PartialEq for (A, B, C) {
    fn eq(self: view<(A, B, C)>, other: view<(A, B, C)>) -> bool {
        let (a1, b1, c1) = *self;
        let (a2, b2, c2) = *other;
        a1 == a2 && b1 == b2 && c1 == c2
    }
}
impl<A: Eq, B: Eq, C: Eq> Eq for (A, B, C) {}
impl<A: Ord, B: Ord, C: Ord> Ord for (A, B, C) {
    fn cmp(self: view<(A, B, C)>, other: view<(A, B, C)>) -> Ordering {
        let (a1, b1, c1) = *self;
        let (a2, b2, c2) = *other;
        let ca = compare_item(view(a1), view(a2));
        match ca {
            Ordering.Equal => {
                let cb = compare_item(view(b1), view(b2));
                match cb {
                    Ordering.Equal => compare_item(view(c1), view(c2)),
                    _ => cb,
                }
            },
            _ => ca,
        }
    }
}

// Arity 4
impl<A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq> PartialEq for (A, B, C, D) {
    fn eq(self: view<(A, B, C, D)>, other: view<(A, B, C, D)>) -> bool {
        let (a1, b1, c1, d1) = *self;
        let (a2, b2, c2, d2) = *other;
        a1 == a2 && b1 == b2 && c1 == c2 && d1 == d2
    }
}
impl<A: Eq, B: Eq, C: Eq, D: Eq> Eq for (A, B, C, D) {}
impl<A: Ord, B: Ord, C: Ord, D: Ord> Ord for (A, B, C, D) {
    fn cmp(self: view<(A, B, C, D)>, other: view<(A, B, C, D)>) -> Ordering {
        let (a1, b1, c1, d1) = *self;
        let (a2, b2, c2, d2) = *other;
        let ca = compare_item(view(a1), view(a2));
        match ca {
            Ordering.Equal => {
                let cb = compare_item(view(b1), view(b2));
                match cb {
                    Ordering.Equal => {
                        let cc = compare_item(view(c1), view(c2));
                        match cc {
                            Ordering.Equal => compare_item(view(d1), view(d2)),
                            _ => cc,
                        }
                    },
                    _ => cb,
                }
            },
            _ => ca,
        }
    }
}
