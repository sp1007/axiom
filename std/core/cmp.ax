// isize
impl PartialEq for isize {
    fn eq(self: view<isize>, other: view<isize>) -> bool { *self == *other }
}
impl Eq for isize {}
impl Ord for isize {
    fn cmp(self: view<isize>, other: view<isize>) -> Ordering {
