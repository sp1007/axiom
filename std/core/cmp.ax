module std.core.cmp

@lang("Ordering")
@derive(Copy)
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

@lang("clone")
pub trait Clone {
    fn clone(self: view<Self>) -> Self;
}

pub trait Copy: Clone {}

impl Clone for Ordering {
    fn clone(self: view<Ordering>) -> Ordering {
        *self
    }
}

@lang("eq")
pub trait PartialEq {
    fn eq(self: view<Self>, other: view<Self>) -> bool;
}

pub trait Eq: PartialEq {}

@lang("cmp")
pub trait Ord {
    fn cmp(self: view<Self>, other: view<Self>) -> Ordering;
}

// Implementations for primitives

// u8
impl PartialEq for u8 {
    fn eq(self: view<u8>, other: view<u8>) -> bool { *self == *other }
}
impl Eq for u8 {}
impl Ord for u8 {
    fn cmp(self: view<u8>, other: view<u8>) -> Ordering {
        if *self < *other { Ordering.Less }
        else if *self > *other { Ordering.Greater }
        else { Ordering.Equal }
    }
}

// u16
impl PartialEq for u16 {
    fn eq(self: view<u16>, other: view<u16>) -> bool { *self == *other }
}
impl Eq for u16 {}
impl Ord for u16 {
    fn cmp(self: view<u16>, other: view<u16>) -> Ordering {
        if *self < *other { Ordering.Less }
