// i32
impl PartialEq for i32 {
    fn eq(self: view<i32>, other: view<i32>) -> bool { *self == *other }
}
impl Eq for i32 {}
impl Ord for i32 {
    fn cmp(self: view<i32>, other: view<i32>) -> Ordering {
