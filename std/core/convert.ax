impl i8 {
    pub fn from<S: LosslessToI8>(value: S) -> i8 {
        value.lossless_to_i8()
    }

    pub fn try_from<S: IntValue>(value: S) -> Result<i8, TryFromIntError> {
        let negative: bool = value.int_is_negative();
        let magnitude: u128 = value.int_magnitude();
        if negative {
            if magnitude > (i8.MAX as u128) + 1u128 {
                return Result.Err(TryFromIntError {});
            }
            return Result.Ok((magnitude as i8).wrapping_neg());
        }
        if magnitude > (i8.MAX as u128) {
            return Result.Err(TryFromIntError {});
        }
        Result.Ok(magnitude as i8)
    }
}

