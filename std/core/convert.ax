pub trait From<T> {
    fn from(value: T) -> Self;
}

pub trait Into<T> {
    fn into(self: Self) -> T;
}

pub trait TryFrom<T> {
    type Error;
    fn try_from(value: T) -> Result<Self, Self.Error>;
}

pub trait TryInto<T> {
    type Error;
    fn try_into(self: Self) -> Result<T, Self.Error>;
}

