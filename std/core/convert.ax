        Result.Ok(magnitude as u32)
    }
}

impl u64 {
    pub fn from<S: LosslessToU64>(value: S) -> u64 {
        value.lossless_to_u64()
    }

    pub fn try_from<S: IntValue>(value: S) -> Result<u64, TryFromIntError> {
        let negative: bool = value.int_is_negative();
        let magnitude: u128 = value.int_magnitude();
        if negative {
            return Result.Err(TryFromIntError {});
        }
        if magnitude > (u64.MAX as u128) {
            return Result.Err(TryFromIntError {});
        }
        Result.Ok(magnitude as u64)
    }
}

