module std.core.mem

@intrinsic pub fn size_of<T>() -> usize { 0 }
@intrinsic pub fn align_of<T>() -> usize { 0 }
@intrinsic pub fn needs_drop<T>() -> bool { false }

@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic pub unsafe fn ptr_copy<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic pub unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic pub unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}
@intrinsic pub unsafe fn drop_in_place<T>(p: *mut T) {}

pub unsafe fn swap<T>(a: mut_view<T>, b: mut_view<T>) {
    let pa = address_of_mut(*a);
    let pb = address_of_mut(*b);
    let mut tmp: [1]T = [*a];
    let ptmp = address_of_mut(tmp[0]);
    ptr_copy_nonoverlapping(pa as *const T, ptmp, 1);
    ptr_copy_nonoverlapping(pb as *const T, pa, 1);
    ptr_copy_nonoverlapping(ptmp as *const T, pb, 1);
}

pub unsafe fn replace<T>(dest: mut_view<T>, src: T) -> T {
    let old = *dest;
    *dest = src;
    old
}

pub fn drop<T>(val: T) {
    // Value is moved in and dropped at the end of the scope
}

pub fn forget<T>(val: T) {
    // Prevents running destructor by leaking/forgetting
}
