    pub fn unsigned_abs(self: i16) -> u16 {
        if self < 0i16 {
            (0u16).wrapping_sub(self as u16)
        } else {
            self as u16
        }
    }

    pub fn signum(self: i16) -> i16 {
        if self < 0i16 {
            -1i16
        } else if self > 0i16 {
            1i16
        } else {
            0i16
        }
    }

    pub fn is_positive(self: i16) -> bool {
        self > 0i16
    }

    pub fn is_negative(self: i16) -> bool {
        self < 0i16
    }

    pub fn wrapping_abs(self: i16) -> i16 {
        if self < 0i16 { self.wrapping_neg() } else { self }
    }

    pub fn saturating_neg(self: i16) -> i16 {
        if self == i16.MIN { i16.MAX } else { -self }
    }

    pub fn saturating_abs(self: i16) -> i16 {
        if self == i16.MIN {
            i16.MAX
        } else if self < 0i16 {
            -self
        } else {
            self
        }
    }

    pub fn checked_abs(self: i16) -> Option<i16> {
        if self == i16.MIN {
            Option.None
        } else if self < 0i16 {
            Option.Some(-self)
        } else {
            Option.Some(self)
        }
    }

    pub fn overflowing_abs(self: i16) -> (i16, bool) {
        pair_i16(self.wrapping_abs(), self == i16.MIN)
    }
}

// ================================================================================================
// i32
// ================================================================================================
// Helpers of the overflowing_* methods (private to this module).
fn pair_i32(value: i32, flag: bool) -> (i32, bool) {
    // `(value, flag)` does not compile (tests/std/num/tuple_names_xfail.ax): build the pair field by field.
    let mut result: (i32, bool) = (0i32, false);
    result.0 = value;
    result.1 = flag;
    result
}

fn add_overflows_i32(a: i32, b: i32) -> bool {
    let sum: i32 = a.wrapping_add(b);
    ((a ^ sum) & (b ^ sum)) < 0i32
}

fn sub_overflows_i32(a: i32, b: i32) -> bool {
    let diff: i32 = a.wrapping_sub(b);
    ((a ^ b) & (a ^ diff)) < 0i32
}

fn mul_overflows_i32(a: i32, b: i32) -> bool {
    match a.checked_mul(b) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn pow_overflows_i32(base: i32, exp: u32) -> bool {
    match base.checked_pow(exp) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

impl i32 {
    // ---- ordering helpers --------------------------------------------------------------------
    pub fn min(self: i32, other: i32) -> i32 {
        if self < other { self } else { other }
    }

    pub fn max(self: i32, other: i32) -> i32 {
        if self > other { self } else { other }
    }

    pub fn clamp(self: i32, min_val: i32, max_val: i32) -> i32 {
        assert(min_val <= max_val);
        if self < min_val {
            min_val
        } else if self > max_val {
            max_val
        } else {
            self
        }
    }

    pub fn abs_diff(self: i32, other: i32) -> u32 {
        if self > other {
            (self as u32).wrapping_sub(other as u32)
        } else {
            (other as u32).wrapping_sub(self as u32)
        }
    }

    // ---- wrapping family (AXS-INT-022) -------------------------------------------------------
    pub fn wrapping_div(self: i32, rhs: i32) -> i32 {
        if self == i32.MIN && rhs == -1i32 {
            return self;
        }
        self / rhs
    }

    pub fn wrapping_rem(self: i32, rhs: i32) -> i32 {
        if self == i32.MIN && rhs == -1i32 {
            return 0i32;
        }
        self % rhs
    }

    pub fn wrapping_shl(self: i32, rhs: u32) -> i32 {
        self << (rhs & 31u32)
    }

    pub fn wrapping_shr(self: i32, rhs: u32) -> i32 {
        self >> (rhs & 31u32)
    }

    pub fn wrapping_pow(self: i32, exp: u32) -> i32 {
        let mut result: i32 = 1i32;
        let mut base: i32 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.wrapping_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.wrapping_mul(base);
            }
        }
        result
    }

    // ---- saturating family (AXS-INT-023) -----------------------------------------------------
    pub fn saturating_div(self: i32, rhs: i32) -> i32 {
        if self == i32.MIN && rhs == -1i32 {
            return i32.MAX;
        }
        self / rhs
    }

    pub fn saturating_pow(self: i32, exp: u32) -> i32 {
        let mut result: i32 = 1i32;
        let mut base: i32 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.saturating_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.saturating_mul(base);
            }
        }
        result
    }

    // ---- checked family (AXS-INT-024) --------------------------------------------------------
    pub fn checked_add(self: i32, rhs: i32) -> Option<i32> {
        let sum: i32 = self.wrapping_add(rhs);
        if ((self ^ sum) & (rhs ^ sum)) < 0i32 {
            Option.None
        } else {
            Option.Some(sum)
        }
    }

    pub fn checked_sub(self: i32, rhs: i32) -> Option<i32> {
        let diff: i32 = self.wrapping_sub(rhs);
        if ((self ^ rhs) & (self ^ diff)) < 0i32 {
            Option.None
        } else {
            Option.Some(diff)
        }
    }

    pub fn checked_mul(self: i32, rhs: i32) -> Option<i32> {
        if self == 0i32 || rhs == 0i32 {
            return Option.Some(0i32);
        }
        if (self == -1i32 && rhs == i32.MIN) || (rhs == -1i32 && self == i32.MIN) {
            return Option.None;
        }
        let product: i32 = self.wrapping_mul(rhs);
        if product / rhs != self {
            Option.None
        } else {
            Option.Some(product)
        }
    }

    pub fn checked_div(self: i32, rhs: i32) -> Option<i32> {
        if rhs == 0i32 {
            return Option.None;
        }
        if self == i32.MIN && rhs == -1i32 {
            return Option.None;
        }
        Option.Some(self / rhs)
    }

    pub fn checked_rem(self: i32, rhs: i32) -> Option<i32> {
        if rhs == 0i32 {
            return Option.None;
