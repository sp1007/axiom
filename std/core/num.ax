        let bits: u64 = self as u64;
        [
            (bits & 0xFFu64) as u8,
            ((bits >> 8u32) & 0xFFu64) as u8,
            ((bits >> 16u32) & 0xFFu64) as u8,
            ((bits >> 24u32) & 0xFFu64) as u8,
            ((bits >> 32u32) & 0xFFu64) as u8,
            ((bits >> 40u32) & 0xFFu64) as u8,
            ((bits >> 48u32) & 0xFFu64) as u8,
            ((bits >> 56u32) & 0xFFu64) as u8,
        ]
    }

    pub fn to_be_bytes(self: i64) -> [8]u8 {
        let bits: u64 = self as u64;
        [
            ((bits >> 56u32) & 0xFFu64) as u8,
            ((bits >> 48u32) & 0xFFu64) as u8,
            ((bits >> 40u32) & 0xFFu64) as u8,
            ((bits >> 32u32) & 0xFFu64) as u8,
            ((bits >> 24u32) & 0xFFu64) as u8,
            ((bits >> 16u32) & 0xFFu64) as u8,
            ((bits >> 8u32) & 0xFFu64) as u8,
            (bits & 0xFFu64) as u8,
        ]
    }

    pub fn to_ne_bytes(self: i64) -> [8]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [8]u8) -> i64 {
        let bits: u64 =
        (bytes[0] as u64) |
        ((bytes[1] as u64) << 8u32) |
        ((bytes[2] as u64) << 16u32) |
        ((bytes[3] as u64) << 24u32) |
        ((bytes[4] as u64) << 32u32) |
        ((bytes[5] as u64) << 40u32) |
        ((bytes[6] as u64) << 48u32) |
        ((bytes[7] as u64) << 56u32);
        bits as i64
    }

    pub fn from_be_bytes(bytes: [8]u8) -> i64 {
        let bits: u64 =
        (bytes[7] as u64) |
        ((bytes[6] as u64) << 8u32) |
        ((bytes[5] as u64) << 16u32) |
        ((bytes[4] as u64) << 24u32) |
        ((bytes[3] as u64) << 32u32) |
        ((bytes[2] as u64) << 40u32) |
        ((bytes[1] as u64) << 48u32) |
        ((bytes[0] as u64) << 56u32);
        bits as i64
    }

    pub fn from_ne_bytes(bytes: [8]u8) -> i64 {
        i64.from_le_bytes(bytes)
    }

    // ---- signed-only members (AXS-INT-022/023/024/025/026) -----------------------------------
    pub fn abs(self: i64) -> i64 {
        if self < 0i64 { -self } else { self }
    }

    pub fn unsigned_abs(self: i64) -> u64 {
        if self < 0i64 {
            (0u64).wrapping_sub(self as u64)
        } else {
            self as u64
        }
    }

    pub fn signum(self: i64) -> i64 {
        if self < 0i64 {
            -1i64
        } else if self > 0i64 {
            1i64
        } else {
            0i64
        }
    }

    pub fn is_positive(self: i64) -> bool {
        self > 0i64
    }

    pub fn is_negative(self: i64) -> bool {
        self < 0i64
    }

    pub fn wrapping_abs(self: i64) -> i64 {
        if self < 0i64 { self.wrapping_neg() } else { self }
    }

    pub fn saturating_neg(self: i64) -> i64 {
        if self == i64.MIN { i64.MAX } else { -self }
    }

    pub fn saturating_abs(self: i64) -> i64 {
        if self == i64.MIN {
            i64.MAX
        } else if self < 0i64 {
            -self
        } else {
            self
        }
    }

    pub fn checked_abs(self: i64) -> Option<i64> {
        if self == i64.MIN {
            Option.None
        } else if self < 0i64 {
            Option.Some(-self)
        } else {
            Option.Some(self)
        }
    }

    pub fn overflowing_abs(self: i64) -> (i64, bool) {
        pair_i64(self.wrapping_abs(), self == i64.MIN)
    }
}

// ================================================================================================
// i128
// ================================================================================================
// Helpers of the overflowing_* methods (private to this module).
fn pair_i128(value: i128, flag: bool) -> (i128, bool) {
    // `(value, flag)` does not compile (tests/std/num/tuple_names_xfail.ax): build the pair field by field.
    let mut result: (i128, bool) = (0i128, false);
    result.0 = value;
    result.1 = flag;
    result
}

fn add_overflows_i128(a: i128, b: i128) -> bool {
    let sum: i128 = a.wrapping_add(b);
    ((a ^ sum) & (b ^ sum)) < 0i128
}

fn sub_overflows_i128(a: i128, b: i128) -> bool {
    let diff: i128 = a.wrapping_sub(b);
    ((a ^ b) & (a ^ diff)) < 0i128
}

fn mul_overflows_i128(a: i128, b: i128) -> bool {
    match a.checked_mul(b) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn pow_overflows_i128(base: i128, exp: u32) -> bool {
    match base.checked_pow(exp) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

impl i128 {
    // ---- ordering helpers --------------------------------------------------------------------
    pub fn min(self: i128, other: i128) -> i128 {
        if self < other { self } else { other }
    }

    pub fn max(self: i128, other: i128) -> i128 {
        if self > other { self } else { other }
    }

    pub fn clamp(self: i128, min_val: i128, max_val: i128) -> i128 {
        assert(min_val <= max_val);
        if self < min_val {
            min_val
        } else if self > max_val {
            max_val
        } else {
            self
        }
    }

    pub fn abs_diff(self: i128, other: i128) -> u128 {
        if self > other {
            (self as u128).wrapping_sub(other as u128)
        } else {
            (other as u128).wrapping_sub(self as u128)
        }
    }

    // ---- wrapping family (AXS-INT-022) -------------------------------------------------------
    pub fn wrapping_div(self: i128, rhs: i128) -> i128 {
        if self == i128.MIN && rhs == -1i128 {
            return self;
        }
        self / rhs
    }

    pub fn wrapping_rem(self: i128, rhs: i128) -> i128 {
        if self == i128.MIN && rhs == -1i128 {
            return 0i128;
        }
        self % rhs
    }

    pub fn wrapping_shl(self: i128, rhs: u32) -> i128 {
        self << (rhs & 127u32)
    }

    pub fn wrapping_shr(self: i128, rhs: u32) -> i128 {
        self >> (rhs & 127u32)
    }

    pub fn wrapping_pow(self: i128, exp: u32) -> i128 {
        let mut result: i128 = 1i128;
        let mut base: i128 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.wrapping_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.wrapping_mul(base);
            }
        }
        result
    }

    // ---- saturating family (AXS-INT-023) -----------------------------------------------------
    pub fn saturating_div(self: i128, rhs: i128) -> i128 {
        if self == i128.MIN && rhs == -1i128 {
            return i128.MAX;
        }
        self / rhs
    }

    pub fn saturating_pow(self: i128, exp: u32) -> i128 {
        let mut result: i128 = 1i128;
        let mut base: i128 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.saturating_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.saturating_mul(base);
            }
        }
        result
    }

    // ---- checked family (AXS-INT-024) --------------------------------------------------------
    pub fn checked_add(self: i128, rhs: i128) -> Option<i128> {
        let sum: i128 = self.wrapping_add(rhs);
        if ((self ^ sum) & (rhs ^ sum)) < 0i128 {
            Option.None
        } else {
            Option.Some(sum)
        }
    }

    pub fn checked_sub(self: i128, rhs: i128) -> Option<i128> {
        let diff: i128 = self.wrapping_sub(rhs);
        if ((self ^ rhs) & (self ^ diff)) < 0i128 {
            Option.None
        } else {
            Option.Some(diff)
        }
    }

    pub fn checked_mul(self: i128, rhs: i128) -> Option<i128> {
        if self == 0i128 || rhs == 0i128 {
            return Option.Some(0i128);
        }
        if (self == -1i128 && rhs == i128.MIN) || (rhs == -1i128 && self == i128.MIN) {
            return Option.None;
        }
        let product: i128 = self.wrapping_mul(rhs);
        if product / rhs != self {
            Option.None
        } else {
            Option.Some(product)
        }
    }

    pub fn checked_div(self: i128, rhs: i128) -> Option<i128> {
        if rhs == 0i128 {
            return Option.None;
        }
        if self == i128.MIN && rhs == -1i128 {
            return Option.None;
        }
        Option.Some(self / rhs)
    }

    pub fn checked_rem(self: i128, rhs: i128) -> Option<i128> {
        if rhs == 0i128 {
            return Option.None;
        }
        if self == i128.MIN && rhs == -1i128 {
            return Option.None;
        }
        Option.Some(self % rhs)
    }

    pub fn checked_neg(self: i128) -> Option<i128> {
        if self == i128.MIN {
            Option.None
        } else {
            Option.Some(-self)
        }
    }

    pub fn checked_shl(self: i128, rhs: u32) -> Option<i128> {
        if rhs >= 128u32 {
            Option.None
        } else {
            Option.Some(self << rhs)
        }
    }

    pub fn checked_shr(self: i128, rhs: u32) -> Option<i128> {
        if rhs >= 128u32 {
            Option.None
        } else {
            Option.Some(self >> rhs)
        }
    }

    pub fn checked_pow(self: i128, exp: u32) -> Option<i128> {
        let mut result: i128 = 1i128;
        let mut base: i128 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                match result.checked_mul(base) {
                    Option.Some(value) => {
                        result = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                match base.checked_mul(base) {
                    Option.Some(value) => {
                        base = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
        }
        Option.Some(result)
    }

    // ---- overflowing family (AXS-INT-025) ----------------------------------------------------
    // Tuple expressions that name a variable do not compile (tests/std/num/tuple_names_xfail.ax), so every
    // tuple result is built by the pair_* helper above the impl.
    pub fn overflowing_add(self: i128, rhs: i128) -> (i128, bool) {
        pair_i128(self.wrapping_add(rhs), add_overflows_i128(self, rhs))
    }

    pub fn overflowing_sub(self: i128, rhs: i128) -> (i128, bool) {
        pair_i128(self.wrapping_sub(rhs), sub_overflows_i128(self, rhs))
    }

    pub fn overflowing_mul(self: i128, rhs: i128) -> (i128, bool) {
        pair_i128(self.wrapping_mul(rhs), mul_overflows_i128(self, rhs))
    }

    pub fn overflowing_div(self: i128, rhs: i128) -> (i128, bool) {
        if self == i128.MIN && rhs == -1i128 {
            return pair_i128(i128.MIN, true);
        }
        pair_i128(self / rhs, false)
    }

    pub fn overflowing_rem(self: i128, rhs: i128) -> (i128, bool) {
        if self == i128.MIN && rhs == -1i128 {
            return pair_i128(0i128, true);
        }
        pair_i128(self % rhs, false)
    }

    pub fn overflowing_neg(self: i128) -> (i128, bool) {
        pair_i128(self.wrapping_neg(), self == i128.MIN)
    }

    pub fn overflowing_shl(self: i128, rhs: u32) -> (i128, bool) {
        pair_i128(self.wrapping_shl(rhs), rhs >= 128u32)
    }

    pub fn overflowing_shr(self: i128, rhs: u32) -> (i128, bool) {
        pair_i128(self.wrapping_shr(rhs), rhs >= 128u32)
    }

    pub fn overflowing_pow(self: i128, exp: u32) -> (i128, bool) {
        pair_i128(self.wrapping_pow(exp), pow_overflows_i128(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: i128, exp: u32) -> i128 {
        let mut result: i128 = 1i128;
        let mut base: i128 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: i128) -> u32 {
        128u32 - self.count_ones()
    }

    pub fn leading_ones(self: i128) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: i128) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: i128) -> [16]u8 {
        let bits: u128 = self as u128;
        [
            (bits & 0xFFu128) as u8,
            ((bits >> 8u32) & 0xFFu128) as u8,
            ((bits >> 16u32) & 0xFFu128) as u8,
            ((bits >> 24u32) & 0xFFu128) as u8,
            ((bits >> 32u32) & 0xFFu128) as u8,
            ((bits >> 40u32) & 0xFFu128) as u8,
            ((bits >> 48u32) & 0xFFu128) as u8,
            ((bits >> 56u32) & 0xFFu128) as u8,
            ((bits >> 64u32) & 0xFFu128) as u8,
            ((bits >> 72u32) & 0xFFu128) as u8,
            ((bits >> 80u32) & 0xFFu128) as u8,
            ((bits >> 88u32) & 0xFFu128) as u8,
            ((bits >> 96u32) & 0xFFu128) as u8,
            ((bits >> 104u32) & 0xFFu128) as u8,
            ((bits >> 112u32) & 0xFFu128) as u8,
            ((bits >> 120u32) & 0xFFu128) as u8,
        ]
    }

    pub fn to_be_bytes(self: i128) -> [16]u8 {
        let bits: u128 = self as u128;
        [
            ((bits >> 120u32) & 0xFFu128) as u8,
            ((bits >> 112u32) & 0xFFu128) as u8,
            ((bits >> 104u32) & 0xFFu128) as u8,
            ((bits >> 96u32) & 0xFFu128) as u8,
            ((bits >> 88u32) & 0xFFu128) as u8,
            ((bits >> 80u32) & 0xFFu128) as u8,
            ((bits >> 72u32) & 0xFFu128) as u8,
            ((bits >> 64u32) & 0xFFu128) as u8,
            ((bits >> 56u32) & 0xFFu128) as u8,
            ((bits >> 48u32) & 0xFFu128) as u8,
            ((bits >> 40u32) & 0xFFu128) as u8,
            ((bits >> 32u32) & 0xFFu128) as u8,
            ((bits >> 24u32) & 0xFFu128) as u8,
            ((bits >> 16u32) & 0xFFu128) as u8,
            ((bits >> 8u32) & 0xFFu128) as u8,
            (bits & 0xFFu128) as u8,
        ]
    }

    pub fn to_ne_bytes(self: i128) -> [16]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [16]u8) -> i128 {
        let bits: u128 =
        (bytes[0] as u128) |
        ((bytes[1] as u128) << 8u32) |
        ((bytes[2] as u128) << 16u32) |
        ((bytes[3] as u128) << 24u32) |
        ((bytes[4] as u128) << 32u32) |
        ((bytes[5] as u128) << 40u32) |
        ((bytes[6] as u128) << 48u32) |
        ((bytes[7] as u128) << 56u32) |
        ((bytes[8] as u128) << 64u32) |
        ((bytes[9] as u128) << 72u32) |
        ((bytes[10] as u128) << 80u32) |
        ((bytes[11] as u128) << 88u32) |
        ((bytes[12] as u128) << 96u32) |
        ((bytes[13] as u128) << 104u32) |
        ((bytes[14] as u128) << 112u32) |
        ((bytes[15] as u128) << 120u32);
        bits as i128
    }

    pub fn from_be_bytes(bytes: [16]u8) -> i128 {
        let bits: u128 =
        (bytes[15] as u128) |
        ((bytes[14] as u128) << 8u32) |
        ((bytes[13] as u128) << 16u32) |
        ((bytes[12] as u128) << 24u32) |
        ((bytes[11] as u128) << 32u32) |
        ((bytes[10] as u128) << 40u32) |
        ((bytes[9] as u128) << 48u32) |
        ((bytes[8] as u128) << 56u32) |
        ((bytes[7] as u128) << 64u32) |
        ((bytes[6] as u128) << 72u32) |
        ((bytes[5] as u128) << 80u32) |
        ((bytes[4] as u128) << 88u32) |
        ((bytes[3] as u128) << 96u32) |
        ((bytes[2] as u128) << 104u32) |
        ((bytes[1] as u128) << 112u32) |
        ((bytes[0] as u128) << 120u32);
        bits as i128
    }

    pub fn from_ne_bytes(bytes: [16]u8) -> i128 {
        i128.from_le_bytes(bytes)
    }

    // ---- signed-only members (AXS-INT-022/023/024/025/026) -----------------------------------
    pub fn abs(self: i128) -> i128 {
        if self < 0i128 { -self } else { self }
    }

    pub fn unsigned_abs(self: i128) -> u128 {
        if self < 0i128 {
            (0u128).wrapping_sub(self as u128)
        } else {
            self as u128
        }
    }

    pub fn signum(self: i128) -> i128 {
        if self < 0i128 {
            -1i128
        } else if self > 0i128 {
            1i128
        } else {
            0i128
        }
    }

    pub fn is_positive(self: i128) -> bool {
        self > 0i128
    }

    pub fn is_negative(self: i128) -> bool {
        self < 0i128
    }

    pub fn wrapping_abs(self: i128) -> i128 {
        if self < 0i128 { self.wrapping_neg() } else { self }
    }

    pub fn saturating_neg(self: i128) -> i128 {
        if self == i128.MIN { i128.MAX } else { -self }
    }

    pub fn saturating_abs(self: i128) -> i128 {
        if self == i128.MIN {
            i128.MAX
        } else if self < 0i128 {
            -self
        } else {
            self
        }
    }

    pub fn checked_abs(self: i128) -> Option<i128> {
        if self == i128.MIN {
            Option.None
        } else if self < 0i128 {
            Option.Some(-self)
        } else {
            Option.Some(self)
        }
    }

    pub fn overflowing_abs(self: i128) -> (i128, bool) {
        pair_i128(self.wrapping_abs(), self == i128.MIN)
    }
}

// ================================================================================================
// isize
// ================================================================================================
// Helpers of the overflowing_* methods (private to this module).
fn pair_isize(value: isize, flag: bool) -> (isize, bool) {
    // `(value, flag)` does not compile (tests/std/num/tuple_names_xfail.ax): build the pair field by field.
    let mut result: (isize, bool) = (0isize, false);
    result.0 = value;
    result.1 = flag;
    result
}

fn add_overflows_isize(a: isize, b: isize) -> bool {
    let sum: isize = a.wrapping_add(b);
    ((a ^ sum) & (b ^ sum)) < 0isize
}

fn sub_overflows_isize(a: isize, b: isize) -> bool {
    let diff: isize = a.wrapping_sub(b);
    ((a ^ b) & (a ^ diff)) < 0isize
}

fn mul_overflows_isize(a: isize, b: isize) -> bool {
    match a.checked_mul(b) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn pow_overflows_isize(base: isize, exp: u32) -> bool {
    match base.checked_pow(exp) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

impl isize {
    // ---- ordering helpers --------------------------------------------------------------------
    pub fn min(self: isize, other: isize) -> isize {
        if self < other { self } else { other }
    }

    pub fn max(self: isize, other: isize) -> isize {
        if self > other { self } else { other }
    }

    pub fn clamp(self: isize, min_val: isize, max_val: isize) -> isize {
        assert(min_val <= max_val);
        if self < min_val {
            min_val
        } else if self > max_val {
            max_val
        } else {
            self
        }
    }

    pub fn abs_diff(self: isize, other: isize) -> usize {
        if self > other {
            (self as usize).wrapping_sub(other as usize)
        } else {
            (other as usize).wrapping_sub(self as usize)
        }
    }

    // ---- wrapping family (AXS-INT-022) -------------------------------------------------------
    pub fn wrapping_div(self: isize, rhs: isize) -> isize {
        if self == isize.MIN && rhs == -1isize {
            return self;
        }
        self / rhs
    }

    pub fn wrapping_rem(self: isize, rhs: isize) -> isize {
        if self == isize.MIN && rhs == -1isize {
            return 0isize;
        }
        self % rhs
    }

    pub fn wrapping_shl(self: isize, rhs: u32) -> isize {
        self << (rhs & 63u32)
    }

    pub fn wrapping_shr(self: isize, rhs: u32) -> isize {
        self >> (rhs & 63u32)
    }

    pub fn wrapping_pow(self: isize, exp: u32) -> isize {
        let mut result: isize = 1isize;
        let mut base: isize = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.wrapping_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.wrapping_mul(base);
            }
        }
        result
    }

    // ---- saturating family (AXS-INT-023) -----------------------------------------------------
    pub fn saturating_div(self: isize, rhs: isize) -> isize {
        if self == isize.MIN && rhs == -1isize {
            return isize.MAX;
        }
        self / rhs
    }

    pub fn saturating_pow(self: isize, exp: u32) -> isize {
        let mut result: isize = 1isize;
        let mut base: isize = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.saturating_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.saturating_mul(base);
            }
        }
        result
    }

    // ---- checked family (AXS-INT-024) --------------------------------------------------------
    pub fn checked_add(self: isize, rhs: isize) -> Option<isize> {
        let sum: isize = self.wrapping_add(rhs);
        if ((self ^ sum) & (rhs ^ sum)) < 0isize {
            Option.None
        } else {
            Option.Some(sum)
        }
    }

    pub fn checked_sub(self: isize, rhs: isize) -> Option<isize> {
        let diff: isize = self.wrapping_sub(rhs);
        if ((self ^ rhs) & (self ^ diff)) < 0isize {
            Option.None
        } else {
            Option.Some(diff)
        }
    }

    pub fn checked_mul(self: isize, rhs: isize) -> Option<isize> {
        if self == 0isize || rhs == 0isize {
            return Option.Some(0isize);
        }
        if (self == -1isize && rhs == isize.MIN) || (rhs == -1isize && self == isize.MIN) {
            return Option.None;
        }
        let product: isize = self.wrapping_mul(rhs);
        if product / rhs != self {
            Option.None
        } else {
            Option.Some(product)
        }
    }

    pub fn checked_div(self: isize, rhs: isize) -> Option<isize> {
        if rhs == 0isize {
            return Option.None;
        }
        if self == isize.MIN && rhs == -1isize {
            return Option.None;
        }
        Option.Some(self / rhs)
    }

    pub fn checked_rem(self: isize, rhs: isize) -> Option<isize> {
        if rhs == 0isize {
            return Option.None;
        }
        if self == isize.MIN && rhs == -1isize {
            return Option.None;
        }
        Option.Some(self % rhs)
    }

    pub fn checked_neg(self: isize) -> Option<isize> {
        if self == isize.MIN {
            Option.None
        } else {
            Option.Some(-self)
        }
    }

    pub fn checked_shl(self: isize, rhs: u32) -> Option<isize> {
        if rhs >= 64u32 {
            Option.None
        } else {
            Option.Some(self << rhs)
        }
    }

    pub fn checked_shr(self: isize, rhs: u32) -> Option<isize> {
        if rhs >= 64u32 {
            Option.None
        } else {
            Option.Some(self >> rhs)
        }
    }

    pub fn checked_pow(self: isize, exp: u32) -> Option<isize> {
        let mut result: isize = 1isize;
        let mut base: isize = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                match result.checked_mul(base) {
                    Option.Some(value) => {
                        result = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                match base.checked_mul(base) {
                    Option.Some(value) => {
                        base = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
        }
        Option.Some(result)
    }

    // ---- overflowing family (AXS-INT-025) ----------------------------------------------------
    // Tuple expressions that name a variable do not compile (tests/std/num/tuple_names_xfail.ax), so every
    // tuple result is built by the pair_* helper above the impl.
    pub fn overflowing_add(self: isize, rhs: isize) -> (isize, bool) {
        pair_isize(self.wrapping_add(rhs), add_overflows_isize(self, rhs))
    }

    pub fn overflowing_sub(self: isize, rhs: isize) -> (isize, bool) {
        pair_isize(self.wrapping_sub(rhs), sub_overflows_isize(self, rhs))
    }

    pub fn overflowing_mul(self: isize, rhs: isize) -> (isize, bool) {
        pair_isize(self.wrapping_mul(rhs), mul_overflows_isize(self, rhs))
    }

    pub fn overflowing_div(self: isize, rhs: isize) -> (isize, bool) {
        if self == isize.MIN && rhs == -1isize {
            return pair_isize(isize.MIN, true);
        }
        pair_isize(self / rhs, false)
    }

    pub fn overflowing_rem(self: isize, rhs: isize) -> (isize, bool) {
        if self == isize.MIN && rhs == -1isize {
            return pair_isize(0isize, true);
        }
        pair_isize(self % rhs, false)
    }

    pub fn overflowing_neg(self: isize) -> (isize, bool) {
        pair_isize(self.wrapping_neg(), self == isize.MIN)
    }

    pub fn overflowing_shl(self: isize, rhs: u32) -> (isize, bool) {
        pair_isize(self.wrapping_shl(rhs), rhs >= 64u32)
    }

    pub fn overflowing_shr(self: isize, rhs: u32) -> (isize, bool) {
        pair_isize(self.wrapping_shr(rhs), rhs >= 64u32)
    }

    pub fn overflowing_pow(self: isize, exp: u32) -> (isize, bool) {
        pair_isize(self.wrapping_pow(exp), pow_overflows_isize(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: isize, exp: u32) -> isize {
        let mut result: isize = 1isize;
        let mut base: isize = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: isize) -> u32 {
        64u32 - self.count_ones()
    }

    pub fn leading_ones(self: isize) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: isize) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: isize) -> [8]u8 {
        let bits: usize = self as usize;
        [
            (bits & 0xFFusize) as u8,
            ((bits >> 8u32) & 0xFFusize) as u8,
            ((bits >> 16u32) & 0xFFusize) as u8,
            ((bits >> 24u32) & 0xFFusize) as u8,
            ((bits >> 32u32) & 0xFFusize) as u8,
            ((bits >> 40u32) & 0xFFusize) as u8,
            ((bits >> 48u32) & 0xFFusize) as u8,
            ((bits >> 56u32) & 0xFFusize) as u8,
        ]
    }

    pub fn to_be_bytes(self: isize) -> [8]u8 {
        let bits: usize = self as usize;
        [
            ((bits >> 56u32) & 0xFFusize) as u8,
            ((bits >> 48u32) & 0xFFusize) as u8,
            ((bits >> 40u32) & 0xFFusize) as u8,
            ((bits >> 32u32) & 0xFFusize) as u8,
            ((bits >> 24u32) & 0xFFusize) as u8,
            ((bits >> 16u32) & 0xFFusize) as u8,
            ((bits >> 8u32) & 0xFFusize) as u8,
            (bits & 0xFFusize) as u8,
        ]
    }

    pub fn to_ne_bytes(self: isize) -> [8]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [8]u8) -> isize {
        let bits: usize =
        (bytes[0] as usize) |
        ((bytes[1] as usize) << 8u32) |
        ((bytes[2] as usize) << 16u32) |
        ((bytes[3] as usize) << 24u32) |
        ((bytes[4] as usize) << 32u32) |
        ((bytes[5] as usize) << 40u32) |
        ((bytes[6] as usize) << 48u32) |
        ((bytes[7] as usize) << 56u32);
        bits as isize
    }

    pub fn from_be_bytes(bytes: [8]u8) -> isize {
        let bits: usize =
        (bytes[7] as usize) |
        ((bytes[6] as usize) << 8u32) |
        ((bytes[5] as usize) << 16u32) |
        ((bytes[4] as usize) << 24u32) |
        ((bytes[3] as usize) << 32u32) |
        ((bytes[2] as usize) << 40u32) |
        ((bytes[1] as usize) << 48u32) |
        ((bytes[0] as usize) << 56u32);
        bits as isize
    }

    pub fn from_ne_bytes(bytes: [8]u8) -> isize {
        isize.from_le_bytes(bytes)
    }

    // ---- signed-only members (AXS-INT-022/023/024/025/026) -----------------------------------
    pub fn abs(self: isize) -> isize {
        if self < 0isize { -self } else { self }
    }

    pub fn unsigned_abs(self: isize) -> usize {
        if self < 0isize {
            (0usize).wrapping_sub(self as usize)
        } else {
            self as usize
        }
    }

    pub fn signum(self: isize) -> isize {
        if self < 0isize {
            -1isize
        } else if self > 0isize {
            1isize
        } else {
            0isize
        }
    }

    pub fn is_positive(self: isize) -> bool {
        self > 0isize
    }

    pub fn is_negative(self: isize) -> bool {
        self < 0isize
    }

    pub fn wrapping_abs(self: isize) -> isize {
        if self < 0isize { self.wrapping_neg() } else { self }
    }

    pub fn saturating_neg(self: isize) -> isize {
        if self == isize.MIN { isize.MAX } else { -self }
    }

    pub fn saturating_abs(self: isize) -> isize {
        if self == isize.MIN {
            isize.MAX
        } else if self < 0isize {
            -self
        } else {
            self
        }
    }

    pub fn checked_abs(self: isize) -> Option<isize> {
        if self == isize.MIN {
            Option.None
        } else if self < 0isize {
            Option.Some(-self)
        } else {
            Option.Some(self)
        }
    }

    pub fn overflowing_abs(self: isize) -> (isize, bool) {
        pair_isize(self.wrapping_abs(), self == isize.MIN)
    }
}

// ================================================================================================
// u8
// ================================================================================================
// Helpers of the overflowing_* methods (private to this module).
fn pair_u8(value: u8, flag: bool) -> (u8, bool) {
    // `(value, flag)` does not compile (tests/std/num/tuple_names_xfail.ax): build the pair field by field.
    let mut result: (u8, bool) = (0u8, false);
    result.0 = value;
    result.1 = flag;
    result
}

fn add_overflows_u8(a: u8, b: u8) -> bool {
    let sum: u8 = a.wrapping_add(b);
    sum < a
}

fn sub_overflows_u8(a: u8, b: u8) -> bool {
    let diff: u8 = a.wrapping_sub(b);
    b > a
}

fn mul_overflows_u8(a: u8, b: u8) -> bool {
    match a.checked_mul(b) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn pow_overflows_u8(base: u8, exp: u32) -> bool {
    match base.checked_pow(exp) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

impl u8 {
    // ---- ordering helpers --------------------------------------------------------------------
    pub fn min(self: u8, other: u8) -> u8 {
        if self < other { self } else { other }
    }

    pub fn max(self: u8, other: u8) -> u8 {
        if self > other { self } else { other }
    }

    pub fn clamp(self: u8, min_val: u8, max_val: u8) -> u8 {
        assert(min_val <= max_val);
        if self < min_val {
            min_val
        } else if self > max_val {
            max_val
        } else {
            self
        }
    }

    pub fn abs_diff(self: u8, other: u8) -> u8 {
        if self > other {
            (self as u8).wrapping_sub(other as u8)
        } else {
            (other as u8).wrapping_sub(self as u8)
        }
    }

    // ---- wrapping family (AXS-INT-022) -------------------------------------------------------
    pub fn wrapping_div(self: u8, rhs: u8) -> u8 {
        self / rhs
    }

    pub fn wrapping_rem(self: u8, rhs: u8) -> u8 {
        self % rhs
    }

    pub fn wrapping_shl(self: u8, rhs: u32) -> u8 {
        self << (rhs & 7u32)
    }

    pub fn wrapping_shr(self: u8, rhs: u32) -> u8 {
        self >> (rhs & 7u32)
    }

    pub fn wrapping_pow(self: u8, exp: u32) -> u8 {
        let mut result: u8 = 1u8;
        let mut base: u8 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.wrapping_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.wrapping_mul(base);
            }
        }
        result
    }

    // ---- saturating family (AXS-INT-023) -----------------------------------------------------
    pub fn saturating_div(self: u8, rhs: u8) -> u8 {
        self / rhs
    }

    pub fn saturating_pow(self: u8, exp: u32) -> u8 {
        let mut result: u8 = 1u8;
        let mut base: u8 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.saturating_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.saturating_mul(base);
            }
        }
        result
    }

    // ---- checked family (AXS-INT-024) --------------------------------------------------------
    pub fn checked_add(self: u8, rhs: u8) -> Option<u8> {
        let sum: u8 = self.wrapping_add(rhs);
        if sum < self {
            Option.None
        } else {
            Option.Some(sum)
        }
    }

    pub fn checked_sub(self: u8, rhs: u8) -> Option<u8> {
        if rhs > self {
            Option.None
        } else {
            Option.Some(self - rhs)
        }
    }

    pub fn checked_mul(self: u8, rhs: u8) -> Option<u8> {
        if self == 0u8 || rhs == 0u8 {
            return Option.Some(0u8);
        }
        let product: u8 = self.wrapping_mul(rhs);
        if product / rhs != self {
            Option.None
        } else {
            Option.Some(product)
        }
    }

    pub fn checked_div(self: u8, rhs: u8) -> Option<u8> {
        if rhs == 0u8 {
            return Option.None;
        }
        Option.Some(self / rhs)
    }

    pub fn checked_rem(self: u8, rhs: u8) -> Option<u8> {
        if rhs == 0u8 {
            return Option.None;
        }
        Option.Some(self % rhs)
    }

    pub fn checked_neg(self: u8) -> Option<u8> {
        if self == 0u8 {
            Option.Some(0u8)
        } else {
            Option.None
        }
    }

    pub fn checked_shl(self: u8, rhs: u32) -> Option<u8> {
        if rhs >= 8u32 {
            Option.None
        } else {
            Option.Some(self << rhs)
        }
    }

    pub fn checked_shr(self: u8, rhs: u32) -> Option<u8> {
        if rhs >= 8u32 {
            Option.None
        } else {
            Option.Some(self >> rhs)
        }
    }

    pub fn checked_pow(self: u8, exp: u32) -> Option<u8> {
        let mut result: u8 = 1u8;
        let mut base: u8 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                match result.checked_mul(base) {
                    Option.Some(value) => {
                        result = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                match base.checked_mul(base) {
                    Option.Some(value) => {
                        base = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
        }
        Option.Some(result)
    }

    // ---- overflowing family (AXS-INT-025) ----------------------------------------------------
    // Tuple expressions that name a variable do not compile (tests/std/num/tuple_names_xfail.ax), so every
    // tuple result is built by the pair_* helper above the impl.
    pub fn overflowing_add(self: u8, rhs: u8) -> (u8, bool) {
        pair_u8(self.wrapping_add(rhs), add_overflows_u8(self, rhs))
    }

    pub fn overflowing_sub(self: u8, rhs: u8) -> (u8, bool) {
        pair_u8(self.wrapping_sub(rhs), sub_overflows_u8(self, rhs))
    }

    pub fn overflowing_mul(self: u8, rhs: u8) -> (u8, bool) {
        pair_u8(self.wrapping_mul(rhs), mul_overflows_u8(self, rhs))
    }

    pub fn overflowing_div(self: u8, rhs: u8) -> (u8, bool) {
        pair_u8(self / rhs, false)
    }

    pub fn overflowing_rem(self: u8, rhs: u8) -> (u8, bool) {
        pair_u8(self % rhs, false)
    }

    pub fn overflowing_neg(self: u8) -> (u8, bool) {
        pair_u8(self.wrapping_neg(), self != 0u8)
    }

    pub fn overflowing_shl(self: u8, rhs: u32) -> (u8, bool) {
        pair_u8(self.wrapping_shl(rhs), rhs >= 8u32)
    }

    pub fn overflowing_shr(self: u8, rhs: u32) -> (u8, bool) {
        pair_u8(self.wrapping_shr(rhs), rhs >= 8u32)
    }

    pub fn overflowing_pow(self: u8, exp: u32) -> (u8, bool) {
        pair_u8(self.wrapping_pow(exp), pow_overflows_u8(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: u8, exp: u32) -> u8 {
        let mut result: u8 = 1u8;
        let mut base: u8 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: u8) -> u32 {
        8u32 - self.count_ones()
    }

    pub fn leading_ones(self: u8) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: u8) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: u8) -> [1]u8 {
        let bits: u8 = self as u8;
        [
            (bits & 0xFFu8) as u8,
        ]
    }

    pub fn to_be_bytes(self: u8) -> [1]u8 {
        let bits: u8 = self as u8;
        [
            (bits & 0xFFu8) as u8,
        ]
    }

    pub fn to_ne_bytes(self: u8) -> [1]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [1]u8) -> u8 {
        let bits: u8 =
        (bytes[0] as u8);
        bits as u8
    }

    pub fn from_be_bytes(bytes: [1]u8) -> u8 {
        let bits: u8 =
        (bytes[0] as u8);
        bits as u8
    }

    pub fn from_ne_bytes(bytes: [1]u8) -> u8 {
        u8.from_le_bytes(bytes)
    }

    // ---- unsigned-only members (AXS-INT-031) -------------------------------------------------
    pub fn is_power_of_two(self: u8) -> bool {
        self != 0u8 && (self & (self - 1u8)) == 0u8
    }

    pub fn checked_next_power_of_two(self: u8) -> Option<u8> {
        if self <= 1u8 {
            return Option.Some(1u8);
        }
        let exponent: u32 = 8u32 - (self - 1u8).leading_zeros();
        if exponent >= 8u32 {
            return Option.None;
        }
        Option.Some(1u8 << exponent)
    }

    // Panics with "arithmetic overflow" (default checked `*`) when self > 2^(BITS-1).
    pub fn next_power_of_two(self: u8) -> u8 {
        if self <= 1u8 {
            return 1u8;
        }
        let exponent: u32 = 8u32 - (self - 1u8).leading_zeros();
        let half: u8 = 1u8 << (exponent - 1u32);
        half * 2u8
    }
}

// ================================================================================================
// u16
// ================================================================================================
// Helpers of the overflowing_* methods (private to this module).
fn pair_u16(value: u16, flag: bool) -> (u16, bool) {
    // `(value, flag)` does not compile (tests/std/num/tuple_names_xfail.ax): build the pair field by field.
    let mut result: (u16, bool) = (0u16, false);
    result.0 = value;
    result.1 = flag;
    result
}

fn add_overflows_u16(a: u16, b: u16) -> bool {
    let sum: u16 = a.wrapping_add(b);
    sum < a
}

fn sub_overflows_u16(a: u16, b: u16) -> bool {
    let diff: u16 = a.wrapping_sub(b);
    b > a
}

fn mul_overflows_u16(a: u16, b: u16) -> bool {
    match a.checked_mul(b) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn pow_overflows_u16(base: u16, exp: u32) -> bool {
    match base.checked_pow(exp) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

impl u16 {
    // ---- ordering helpers --------------------------------------------------------------------
    pub fn min(self: u16, other: u16) -> u16 {
        if self < other { self } else { other }
    }

    pub fn max(self: u16, other: u16) -> u16 {
        if self > other { self } else { other }
    }

    pub fn clamp(self: u16, min_val: u16, max_val: u16) -> u16 {
        assert(min_val <= max_val);
        if self < min_val {
            min_val
        } else if self > max_val {
            max_val
        } else {
            self
        }
    }

    pub fn abs_diff(self: u16, other: u16) -> u16 {
        if self > other {
            (self as u16).wrapping_sub(other as u16)
        } else {
            (other as u16).wrapping_sub(self as u16)
        }
    }

    // ---- wrapping family (AXS-INT-022) -------------------------------------------------------
    pub fn wrapping_div(self: u16, rhs: u16) -> u16 {
        self / rhs
    }

    pub fn wrapping_rem(self: u16, rhs: u16) -> u16 {
        self % rhs
    }

    pub fn wrapping_shl(self: u16, rhs: u32) -> u16 {
        self << (rhs & 15u32)
    }

    pub fn wrapping_shr(self: u16, rhs: u32) -> u16 {
        self >> (rhs & 15u32)
    }

    pub fn wrapping_pow(self: u16, exp: u32) -> u16 {
        let mut result: u16 = 1u16;
        let mut base: u16 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.wrapping_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.wrapping_mul(base);
            }
        }
        result
    }

    // ---- saturating family (AXS-INT-023) -----------------------------------------------------
    pub fn saturating_div(self: u16, rhs: u16) -> u16 {
        self / rhs
    }

    pub fn saturating_pow(self: u16, exp: u32) -> u16 {
        let mut result: u16 = 1u16;
        let mut base: u16 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.saturating_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.saturating_mul(base);
            }
        }
        result
    }

    // ---- checked family (AXS-INT-024) --------------------------------------------------------
    pub fn checked_add(self: u16, rhs: u16) -> Option<u16> {
        let sum: u16 = self.wrapping_add(rhs);
        if sum < self {
            Option.None
        } else {
            Option.Some(sum)
        }
    }

    pub fn checked_sub(self: u16, rhs: u16) -> Option<u16> {
        if rhs > self {
            Option.None
        } else {
            Option.Some(self - rhs)
        }
    }

    pub fn checked_mul(self: u16, rhs: u16) -> Option<u16> {
        if self == 0u16 || rhs == 0u16 {
            return Option.Some(0u16);
        }
        let product: u16 = self.wrapping_mul(rhs);
        if product / rhs != self {
            Option.None
        } else {
            Option.Some(product)
        }
    }

    pub fn checked_div(self: u16, rhs: u16) -> Option<u16> {
        if rhs == 0u16 {
            return Option.None;
        }
        Option.Some(self / rhs)
    }

    pub fn checked_rem(self: u16, rhs: u16) -> Option<u16> {
        if rhs == 0u16 {
            return Option.None;
        }
        Option.Some(self % rhs)
    }

    pub fn checked_neg(self: u16) -> Option<u16> {
        if self == 0u16 {
            Option.Some(0u16)
        } else {
            Option.None
        }
    }

    pub fn checked_shl(self: u16, rhs: u32) -> Option<u16> {
        if rhs >= 16u32 {
            Option.None
        } else {
            Option.Some(self << rhs)
        }
    }

    pub fn checked_shr(self: u16, rhs: u32) -> Option<u16> {
        if rhs >= 16u32 {
            Option.None
        } else {
            Option.Some(self >> rhs)
        }
    }

    pub fn checked_pow(self: u16, exp: u32) -> Option<u16> {
        let mut result: u16 = 1u16;
        let mut base: u16 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                match result.checked_mul(base) {
                    Option.Some(value) => {
                        result = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                match base.checked_mul(base) {
                    Option.Some(value) => {
                        base = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
        }
        Option.Some(result)
    }

    // ---- overflowing family (AXS-INT-025) ----------------------------------------------------
    // Tuple expressions that name a variable do not compile (tests/std/num/tuple_names_xfail.ax), so every
    // tuple result is built by the pair_* helper above the impl.
    pub fn overflowing_add(self: u16, rhs: u16) -> (u16, bool) {
        pair_u16(self.wrapping_add(rhs), add_overflows_u16(self, rhs))
    }

    pub fn overflowing_sub(self: u16, rhs: u16) -> (u16, bool) {
        pair_u16(self.wrapping_sub(rhs), sub_overflows_u16(self, rhs))
    }

    pub fn overflowing_mul(self: u16, rhs: u16) -> (u16, bool) {
        pair_u16(self.wrapping_mul(rhs), mul_overflows_u16(self, rhs))
    }

    pub fn overflowing_div(self: u16, rhs: u16) -> (u16, bool) {
        pair_u16(self / rhs, false)
    }

    pub fn overflowing_rem(self: u16, rhs: u16) -> (u16, bool) {
        pair_u16(self % rhs, false)
    }

    pub fn overflowing_neg(self: u16) -> (u16, bool) {
        pair_u16(self.wrapping_neg(), self != 0u16)
    }

    pub fn overflowing_shl(self: u16, rhs: u32) -> (u16, bool) {
        pair_u16(self.wrapping_shl(rhs), rhs >= 16u32)
    }

    pub fn overflowing_shr(self: u16, rhs: u32) -> (u16, bool) {
        pair_u16(self.wrapping_shr(rhs), rhs >= 16u32)
    }

    pub fn overflowing_pow(self: u16, exp: u32) -> (u16, bool) {
        pair_u16(self.wrapping_pow(exp), pow_overflows_u16(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: u16, exp: u32) -> u16 {
        let mut result: u16 = 1u16;
        let mut base: u16 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: u16) -> u32 {
        16u32 - self.count_ones()
    }

    pub fn leading_ones(self: u16) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: u16) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: u16) -> [2]u8 {
        let bits: u16 = self as u16;
        [
            (bits & 0xFFu16) as u8,
            ((bits >> 8u32) & 0xFFu16) as u8,
        ]
    }

    pub fn to_be_bytes(self: u16) -> [2]u8 {
        let bits: u16 = self as u16;
        [
            ((bits >> 8u32) & 0xFFu16) as u8,
            (bits & 0xFFu16) as u8,
        ]
    }

    pub fn to_ne_bytes(self: u16) -> [2]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [2]u8) -> u16 {
        let bits: u16 =
        (bytes[0] as u16) |
        ((bytes[1] as u16) << 8u32);
        bits as u16
    }

    pub fn from_be_bytes(bytes: [2]u8) -> u16 {
        let bits: u16 =
        (bytes[1] as u16) |
        ((bytes[0] as u16) << 8u32);
        bits as u16
    }

    pub fn from_ne_bytes(bytes: [2]u8) -> u16 {
        u16.from_le_bytes(bytes)
    }

    // ---- unsigned-only members (AXS-INT-031) -------------------------------------------------
    pub fn is_power_of_two(self: u16) -> bool {
        self != 0u16 && (self & (self - 1u16)) == 0u16
    }

    pub fn checked_next_power_of_two(self: u16) -> Option<u16> {
        if self <= 1u16 {
            return Option.Some(1u16);
        }
        let exponent: u32 = 16u32 - (self - 1u16).leading_zeros();
        if exponent >= 16u32 {
            return Option.None;
        }
        Option.Some(1u16 << exponent)
    }

    // Panics with "arithmetic overflow" (default checked `*`) when self > 2^(BITS-1).
    pub fn next_power_of_two(self: u16) -> u16 {
        if self <= 1u16 {
            return 1u16;
        }
        let exponent: u32 = 16u32 - (self - 1u16).leading_zeros();
        let half: u16 = 1u16 << (exponent - 1u32);
        half * 2u16
    }
}

// ================================================================================================
// u32
// ================================================================================================
// Helpers of the overflowing_* methods (private to this module).
fn pair_u32(value: u32, flag: bool) -> (u32, bool) {
    // `(value, flag)` does not compile (tests/std/num/tuple_names_xfail.ax): build the pair field by field.
    let mut result: (u32, bool) = (0u32, false);
    result.0 = value;
    result.1 = flag;
    result
}

fn add_overflows_u32(a: u32, b: u32) -> bool {
    let sum: u32 = a.wrapping_add(b);
    sum < a
}

fn sub_overflows_u32(a: u32, b: u32) -> bool {
    let diff: u32 = a.wrapping_sub(b);
    b > a
}

fn mul_overflows_u32(a: u32, b: u32) -> bool {
    match a.checked_mul(b) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn pow_overflows_u32(base: u32, exp: u32) -> bool {
    match base.checked_pow(exp) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

impl u32 {
    // ---- ordering helpers --------------------------------------------------------------------
    pub fn min(self: u32, other: u32) -> u32 {
        if self < other { self } else { other }
    }

    pub fn max(self: u32, other: u32) -> u32 {
        if self > other { self } else { other }
    }

    pub fn clamp(self: u32, min_val: u32, max_val: u32) -> u32 {
        assert(min_val <= max_val);
        if self < min_val {
            min_val
        } else if self > max_val {
            max_val
        } else {
            self
        }
    }

    pub fn abs_diff(self: u32, other: u32) -> u32 {
        if self > other {
            (self as u32).wrapping_sub(other as u32)
        } else {
            (other as u32).wrapping_sub(self as u32)
        }
    }

    // ---- wrapping family (AXS-INT-022) -------------------------------------------------------
    pub fn wrapping_div(self: u32, rhs: u32) -> u32 {
        self / rhs
    }

    pub fn wrapping_rem(self: u32, rhs: u32) -> u32 {
        self % rhs
    }

    pub fn wrapping_shl(self: u32, rhs: u32) -> u32 {
        self << (rhs & 31u32)
    }

    pub fn wrapping_shr(self: u32, rhs: u32) -> u32 {
        self >> (rhs & 31u32)
    }

    pub fn wrapping_pow(self: u32, exp: u32) -> u32 {
        let mut result: u32 = 1u32;
        let mut base: u32 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.wrapping_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.wrapping_mul(base);
            }
        }
        result
    }

    // ---- saturating family (AXS-INT-023) -----------------------------------------------------
    pub fn saturating_div(self: u32, rhs: u32) -> u32 {
        self / rhs
    }

    pub fn saturating_pow(self: u32, exp: u32) -> u32 {
        let mut result: u32 = 1u32;
        let mut base: u32 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.saturating_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.saturating_mul(base);
            }
        }
        result
    }

    // ---- checked family (AXS-INT-024) --------------------------------------------------------
    pub fn checked_add(self: u32, rhs: u32) -> Option<u32> {
        let sum: u32 = self.wrapping_add(rhs);
        if sum < self {
            Option.None
        } else {
            Option.Some(sum)
        }
    }

    pub fn checked_sub(self: u32, rhs: u32) -> Option<u32> {
        if rhs > self {
            Option.None
        } else {
            Option.Some(self - rhs)
        }
    }

    pub fn checked_mul(self: u32, rhs: u32) -> Option<u32> {
        if self == 0u32 || rhs == 0u32 {
            return Option.Some(0u32);
        }
        let product: u32 = self.wrapping_mul(rhs);
        if product / rhs != self {
            Option.None
        } else {
            Option.Some(product)
        }
    }

    pub fn checked_div(self: u32, rhs: u32) -> Option<u32> {
        if rhs == 0u32 {
            return Option.None;
        }
        Option.Some(self / rhs)
    }

    pub fn checked_rem(self: u32, rhs: u32) -> Option<u32> {
        if rhs == 0u32 {
            return Option.None;
        }
        Option.Some(self % rhs)
    }

    pub fn checked_neg(self: u32) -> Option<u32> {
        if self == 0u32 {
            Option.Some(0u32)
        } else {
            Option.None
        }
    }

    pub fn checked_shl(self: u32, rhs: u32) -> Option<u32> {
        if rhs >= 32u32 {
            Option.None
        } else {
            Option.Some(self << rhs)
        }
    }

    pub fn checked_shr(self: u32, rhs: u32) -> Option<u32> {
        if rhs >= 32u32 {
            Option.None
        } else {
            Option.Some(self >> rhs)
        }
    }

    pub fn checked_pow(self: u32, exp: u32) -> Option<u32> {
        let mut result: u32 = 1u32;
        let mut base: u32 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                match result.checked_mul(base) {
                    Option.Some(value) => {
                        result = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                match base.checked_mul(base) {
                    Option.Some(value) => {
                        base = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
        }
        Option.Some(result)
    }

    // ---- overflowing family (AXS-INT-025) ----------------------------------------------------
    // Tuple expressions that name a variable do not compile (tests/std/num/tuple_names_xfail.ax), so every
    // tuple result is built by the pair_* helper above the impl.
    pub fn overflowing_add(self: u32, rhs: u32) -> (u32, bool) {
        pair_u32(self.wrapping_add(rhs), add_overflows_u32(self, rhs))
    }

    pub fn overflowing_sub(self: u32, rhs: u32) -> (u32, bool) {
        pair_u32(self.wrapping_sub(rhs), sub_overflows_u32(self, rhs))
    }

    pub fn overflowing_mul(self: u32, rhs: u32) -> (u32, bool) {
        pair_u32(self.wrapping_mul(rhs), mul_overflows_u32(self, rhs))
    }

    pub fn overflowing_div(self: u32, rhs: u32) -> (u32, bool) {
        pair_u32(self / rhs, false)
    }

    pub fn overflowing_rem(self: u32, rhs: u32) -> (u32, bool) {
        pair_u32(self % rhs, false)
    }

    pub fn overflowing_neg(self: u32) -> (u32, bool) {
        pair_u32(self.wrapping_neg(), self != 0u32)
    }

    pub fn overflowing_shl(self: u32, rhs: u32) -> (u32, bool) {
        pair_u32(self.wrapping_shl(rhs), rhs >= 32u32)
    }

    pub fn overflowing_shr(self: u32, rhs: u32) -> (u32, bool) {
        pair_u32(self.wrapping_shr(rhs), rhs >= 32u32)
    }

    pub fn overflowing_pow(self: u32, exp: u32) -> (u32, bool) {
        pair_u32(self.wrapping_pow(exp), pow_overflows_u32(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: u32, exp: u32) -> u32 {
        let mut result: u32 = 1u32;
        let mut base: u32 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: u32) -> u32 {
        32u32 - self.count_ones()
    }

    pub fn leading_ones(self: u32) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: u32) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: u32) -> [4]u8 {
        let bits: u32 = self as u32;
        [
            (bits & 0xFFu32) as u8,
            ((bits >> 8u32) & 0xFFu32) as u8,
            ((bits >> 16u32) & 0xFFu32) as u8,
            ((bits >> 24u32) & 0xFFu32) as u8,
        ]
    }

    pub fn to_be_bytes(self: u32) -> [4]u8 {
        let bits: u32 = self as u32;
        [
            ((bits >> 24u32) & 0xFFu32) as u8,
            ((bits >> 16u32) & 0xFFu32) as u8,
            ((bits >> 8u32) & 0xFFu32) as u8,
            (bits & 0xFFu32) as u8,
        ]
    }

    pub fn to_ne_bytes(self: u32) -> [4]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [4]u8) -> u32 {
        let bits: u32 =
        (bytes[0] as u32) |
        ((bytes[1] as u32) << 8u32) |
        ((bytes[2] as u32) << 16u32) |
        ((bytes[3] as u32) << 24u32);
        bits as u32
    }

    pub fn from_be_bytes(bytes: [4]u8) -> u32 {
        let bits: u32 =
        (bytes[3] as u32) |
        ((bytes[2] as u32) << 8u32) |
        ((bytes[1] as u32) << 16u32) |
        ((bytes[0] as u32) << 24u32);
        bits as u32
    }

    pub fn from_ne_bytes(bytes: [4]u8) -> u32 {
        u32.from_le_bytes(bytes)
    }

    // ---- unsigned-only members (AXS-INT-031) -------------------------------------------------
    pub fn is_power_of_two(self: u32) -> bool {
        self != 0u32 && (self & (self - 1u32)) == 0u32
    }

    pub fn checked_next_power_of_two(self: u32) -> Option<u32> {
        if self <= 1u32 {
            return Option.Some(1u32);
        }
        let exponent: u32 = 32u32 - (self - 1u32).leading_zeros();
        if exponent >= 32u32 {
            return Option.None;
        }
        Option.Some(1u32 << exponent)
    }

    // Panics with "arithmetic overflow" (default checked `*`) when self > 2^(BITS-1).
    pub fn next_power_of_two(self: u32) -> u32 {
        if self <= 1u32 {
            return 1u32;
        }
        let exponent: u32 = 32u32 - (self - 1u32).leading_zeros();
        let half: u32 = 1u32 << (exponent - 1u32);
        half * 2u32
    }
}

