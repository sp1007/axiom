module std.core.num

use std.core.option.Option;

// Intrinsics for wrapping, rotation, and bit-counting (T034/T037, ADR-0004 §1)

@intrinsic fn wrapping_add_i8(a: i8, b: i8) -> i8 { 0 }
@intrinsic fn wrapping_sub_i8(a: i8, b: i8) -> i8 { 0 }
@intrinsic fn wrapping_mul_i8(a: i8, b: i8) -> i8 { 0 }
@intrinsic fn wrapping_neg_i8(a: i8) -> i8 { 0 }
@intrinsic fn rotate_left_i8(a: i8, b: u32) -> i8 { 0 }
@intrinsic fn rotate_right_i8(a: i8, b: u32) -> i8 { 0 }
@intrinsic fn leading_zeros_i8(a: i8) -> u32 { 0 }
@intrinsic fn trailing_zeros_i8(a: i8) -> u32 { 0 }
@intrinsic fn count_ones_i8(a: i8) -> u32 { 0 }

@intrinsic fn wrapping_add_u8(a: u8, b: u8) -> u8 { 0 }
@intrinsic fn wrapping_sub_u8(a: u8, b: u8) -> u8 { 0 }
@intrinsic fn wrapping_mul_u8(a: u8, b: u8) -> u8 { 0 }
@intrinsic fn wrapping_neg_u8(a: u8) -> u8 { 0 }
@intrinsic fn rotate_left_u8(a: u8, b: u32) -> u8 { 0 }
@intrinsic fn rotate_right_u8(a: u8, b: u32) -> u8 { 0 }
@intrinsic fn leading_zeros_u8(a: u8) -> u32 { 0 }
@intrinsic fn trailing_zeros_u8(a: u8) -> u32 { 0 }
@intrinsic fn count_ones_u8(a: u8) -> u32 { 0 }

