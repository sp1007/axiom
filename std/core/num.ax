// char.from_u32 (ADR-0006 §2)
impl char {
    pub fn from_u32(n: u32) -> Option<char> {
        if n <= 0x10FFFF && !(n >= 0xD800 && n <= 0xDFFF) {
            Option.Some(n as char)
        } else {
            Option.None
        }
    }
}
