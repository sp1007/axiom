    pub fn overflowing_sub(self: u64, rhs: u64) -> (u64, bool) {
        pair_u64(self.wrapping_sub(rhs), sub_overflows_u64(self, rhs))
    }

    pub fn overflowing_mul(self: u64, rhs: u64) -> (u64, bool) {
        pair_u64(self.wrapping_mul(rhs), mul_overflows_u64(self, rhs))
    }

    pub fn overflowing_div(self: u64, rhs: u64) -> (u64, bool) {
        pair_u64(self / rhs, false)
    }

    pub fn overflowing_rem(self: u64, rhs: u64) -> (u64, bool) {
        pair_u64(self % rhs, false)
    }

    pub fn overflowing_neg(self: u64) -> (u64, bool) {
        pair_u64(self.wrapping_neg(), self != 0u64)
    }

    pub fn overflowing_shl(self: u64, rhs: u32) -> (u64, bool) {
        pair_u64(self.wrapping_shl(rhs), rhs >= 64u32)
    }

    pub fn overflowing_shr(self: u64, rhs: u32) -> (u64, bool) {
        pair_u64(self.wrapping_shr(rhs), rhs >= 64u32)
    }

    pub fn overflowing_pow(self: u64, exp: u32) -> (u64, bool) {
        pair_u64(self.wrapping_pow(exp), pow_overflows_u64(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: u64, exp: u32) -> u64 {
        let mut result: u64 = 1u64;
        let mut base: u64 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: u64) -> u32 {
        64u32 - self.count_ones()
    }

    pub fn leading_ones(self: u64) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: u64) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: u64) -> [8]u8 {
        let bits: u64 = self as u64;
        [
            (bits & 0xFFu64) as u8,
            ((bits >> 8u32) & 0xFFu64) as u8,
            ((bits >> 16u32) & 0xFFu64) as u8,
            ((bits >> 24u32) & 0xFFu64) as u8,
            ((bits >> 32u32) & 0xFFu64) as u8,
            ((bits >> 40u32) & 0xFFu64) as u8,
            ((bits >> 48u32) & 0xFFu64) as u8,
            ((bits >> 56u32) & 0xFFu64) as u8,
        ]
    }

    pub fn to_be_bytes(self: u64) -> [8]u8 {
        let bits: u64 = self as u64;
        [
            ((bits >> 56u32) & 0xFFu64) as u8,
            ((bits >> 48u32) & 0xFFu64) as u8,
            ((bits >> 40u32) & 0xFFu64) as u8,
            ((bits >> 32u32) & 0xFFu64) as u8,
            ((bits >> 24u32) & 0xFFu64) as u8,
            ((bits >> 16u32) & 0xFFu64) as u8,
            ((bits >> 8u32) & 0xFFu64) as u8,
            (bits & 0xFFu64) as u8,
        ]
    }

    pub fn to_ne_bytes(self: u64) -> [8]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [8]u8) -> u64 {
        let bits: u64 =
        (bytes[0] as u64) |
        ((bytes[1] as u64) << 8u32) |
        ((bytes[2] as u64) << 16u32) |
        ((bytes[3] as u64) << 24u32) |
        ((bytes[4] as u64) << 32u32) |
        ((bytes[5] as u64) << 40u32) |
        ((bytes[6] as u64) << 48u32) |
        ((bytes[7] as u64) << 56u32);
        bits as u64
    }

    pub fn from_be_bytes(bytes: [8]u8) -> u64 {
        let bits: u64 =
        (bytes[7] as u64) |
        ((bytes[6] as u64) << 8u32) |
        ((bytes[5] as u64) << 16u32) |
        ((bytes[4] as u64) << 24u32) |
        ((bytes[3] as u64) << 32u32) |
        ((bytes[2] as u64) << 40u32) |
        ((bytes[1] as u64) << 48u32) |
        ((bytes[0] as u64) << 56u32);
        bits as u64
    }

    pub fn from_ne_bytes(bytes: [8]u8) -> u64 {
        u64.from_le_bytes(bytes)
    }

    // ---- unsigned-only members (AXS-INT-031) -------------------------------------------------
    pub fn is_power_of_two(self: u64) -> bool {
        self != 0u64 && (self & (self - 1u64)) == 0u64
    }

    pub fn checked_next_power_of_two(self: u64) -> Option<u64> {
        if self <= 1u64 {
            return Option.Some(1u64);
        }
        let exponent: u32 = 64u32 - (self - 1u64).leading_zeros();
        if exponent >= 64u32 {
            return Option.None;
        }
        Option.Some(1u64 << exponent)
    }

    // Panics with "arithmetic overflow" (default checked `*`) when self > 2^(BITS-1).
    pub fn next_power_of_two(self: u64) -> u64 {
        if self <= 1u64 {
            return 1u64;
        }
        let exponent: u32 = 64u32 - (self - 1u64).leading_zeros();
        let half: u64 = 1u64 << (exponent - 1u32);
        half * 2u64
    }
}

// ================================================================================================
// u128
// ================================================================================================
// Helpers of the overflowing_* methods (private to this module).
fn pair_u128(value: u128, flag: bool) -> (u128, bool) {
    // `(value, flag)` does not compile (tests/std/num/tuple_names_xfail.ax): build the pair field by field.
    let mut result: (u128, bool) = (0u128, false);
    result.0 = value;
    result.1 = flag;
    result
}

fn add_overflows_u128(a: u128, b: u128) -> bool {
    let sum: u128 = a.wrapping_add(b);
    sum < a
}

fn sub_overflows_u128(a: u128, b: u128) -> bool {
    let diff: u128 = a.wrapping_sub(b);
    b > a
}

fn mul_overflows_u128(a: u128, b: u128) -> bool {
    match a.checked_mul(b) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn pow_overflows_u128(base: u128, exp: u32) -> bool {
    match base.checked_pow(exp) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

impl u128 {
    // ---- ordering helpers --------------------------------------------------------------------
    pub fn min(self: u128, other: u128) -> u128 {
        if self < other { self } else { other }
    }

    pub fn max(self: u128, other: u128) -> u128 {
        if self > other { self } else { other }
    }

    pub fn clamp(self: u128, min_val: u128, max_val: u128) -> u128 {
        assert(min_val <= max_val);
        if self < min_val {
            min_val
        } else if self > max_val {
            max_val
        } else {
            self
        }
    }

    pub fn abs_diff(self: u128, other: u128) -> u128 {
        if self > other {
            (self as u128).wrapping_sub(other as u128)
        } else {
            (other as u128).wrapping_sub(self as u128)
        }
    }

    // ---- wrapping family (AXS-INT-022) -------------------------------------------------------
    pub fn wrapping_div(self: u128, rhs: u128) -> u128 {
        self / rhs
    }

    pub fn wrapping_rem(self: u128, rhs: u128) -> u128 {
        self % rhs
    }

    pub fn wrapping_shl(self: u128, rhs: u32) -> u128 {
        self << (rhs & 127u32)
    }

    pub fn wrapping_shr(self: u128, rhs: u32) -> u128 {
        self >> (rhs & 127u32)
    }

    pub fn wrapping_pow(self: u128, exp: u32) -> u128 {
        let mut result: u128 = 1u128;
        let mut base: u128 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.wrapping_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.wrapping_mul(base);
            }
        }
        result
    }

    // ---- saturating family (AXS-INT-023) -----------------------------------------------------
    pub fn saturating_div(self: u128, rhs: u128) -> u128 {
        self / rhs
    }

    pub fn saturating_pow(self: u128, exp: u32) -> u128 {
        let mut result: u128 = 1u128;
        let mut base: u128 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.saturating_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.saturating_mul(base);
            }
        }
        result
    }

    // ---- checked family (AXS-INT-024) --------------------------------------------------------
    pub fn checked_add(self: u128, rhs: u128) -> Option<u128> {
        let sum: u128 = self.wrapping_add(rhs);
        if sum < self {
            Option.None
        } else {
            Option.Some(sum)
        }
    }

    pub fn checked_sub(self: u128, rhs: u128) -> Option<u128> {
        if rhs > self {
            Option.None
        } else {
            Option.Some(self - rhs)
        }
    }

    pub fn checked_mul(self: u128, rhs: u128) -> Option<u128> {
        if self == 0u128 || rhs == 0u128 {
            return Option.Some(0u128);
        }
        let product: u128 = self.wrapping_mul(rhs);
        if product / rhs != self {
            Option.None
        } else {
            Option.Some(product)
        }
    }

    pub fn checked_div(self: u128, rhs: u128) -> Option<u128> {
        if rhs == 0u128 {
            return Option.None;
        }
        Option.Some(self / rhs)
    }

    pub fn checked_rem(self: u128, rhs: u128) -> Option<u128> {
        if rhs == 0u128 {
            return Option.None;
        }
        Option.Some(self % rhs)
    }

    pub fn checked_neg(self: u128) -> Option<u128> {
        if self == 0u128 {
            Option.Some(0u128)
        } else {
            Option.None
        }
    }

    pub fn checked_shl(self: u128, rhs: u32) -> Option<u128> {
        if rhs >= 128u32 {
            Option.None
        } else {
            Option.Some(self << rhs)
        }
    }

    pub fn checked_shr(self: u128, rhs: u32) -> Option<u128> {
        if rhs >= 128u32 {
            Option.None
        } else {
            Option.Some(self >> rhs)
        }
    }

    pub fn checked_pow(self: u128, exp: u32) -> Option<u128> {
        let mut result: u128 = 1u128;
        let mut base: u128 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                match result.checked_mul(base) {
                    Option.Some(value) => {
                        result = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                match base.checked_mul(base) {
                    Option.Some(value) => {
                        base = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
        }
        Option.Some(result)
    }

    // ---- overflowing family (AXS-INT-025) ----------------------------------------------------
    // Tuple expressions that name a variable do not compile (tests/std/num/tuple_names_xfail.ax), so every
    // tuple result is built by the pair_* helper above the impl.
    pub fn overflowing_add(self: u128, rhs: u128) -> (u128, bool) {
        pair_u128(self.wrapping_add(rhs), add_overflows_u128(self, rhs))
    }

    pub fn overflowing_sub(self: u128, rhs: u128) -> (u128, bool) {
        pair_u128(self.wrapping_sub(rhs), sub_overflows_u128(self, rhs))
    }

    pub fn overflowing_mul(self: u128, rhs: u128) -> (u128, bool) {
        pair_u128(self.wrapping_mul(rhs), mul_overflows_u128(self, rhs))
    }

    pub fn overflowing_div(self: u128, rhs: u128) -> (u128, bool) {
        pair_u128(self / rhs, false)
    }

    pub fn overflowing_rem(self: u128, rhs: u128) -> (u128, bool) {
        pair_u128(self % rhs, false)
    }

    pub fn overflowing_neg(self: u128) -> (u128, bool) {
        pair_u128(self.wrapping_neg(), self != 0u128)
    }

    pub fn overflowing_shl(self: u128, rhs: u32) -> (u128, bool) {
        pair_u128(self.wrapping_shl(rhs), rhs >= 128u32)
    }

    pub fn overflowing_shr(self: u128, rhs: u32) -> (u128, bool) {
        pair_u128(self.wrapping_shr(rhs), rhs >= 128u32)
    }

    pub fn overflowing_pow(self: u128, exp: u32) -> (u128, bool) {
        pair_u128(self.wrapping_pow(exp), pow_overflows_u128(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: u128, exp: u32) -> u128 {
        let mut result: u128 = 1u128;
        let mut base: u128 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: u128) -> u32 {
        128u32 - self.count_ones()
    }

    pub fn leading_ones(self: u128) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: u128) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: u128) -> [16]u8 {
        let bits: u128 = self as u128;
        [
            (bits & 0xFFu128) as u8,
            ((bits >> 8u32) & 0xFFu128) as u8,
            ((bits >> 16u32) & 0xFFu128) as u8,
            ((bits >> 24u32) & 0xFFu128) as u8,
            ((bits >> 32u32) & 0xFFu128) as u8,
            ((bits >> 40u32) & 0xFFu128) as u8,
            ((bits >> 48u32) & 0xFFu128) as u8,
            ((bits >> 56u32) & 0xFFu128) as u8,
            ((bits >> 64u32) & 0xFFu128) as u8,
            ((bits >> 72u32) & 0xFFu128) as u8,
            ((bits >> 80u32) & 0xFFu128) as u8,
            ((bits >> 88u32) & 0xFFu128) as u8,
            ((bits >> 96u32) & 0xFFu128) as u8,
            ((bits >> 104u32) & 0xFFu128) as u8,
            ((bits >> 112u32) & 0xFFu128) as u8,
            ((bits >> 120u32) & 0xFFu128) as u8,
        ]
    }

    pub fn to_be_bytes(self: u128) -> [16]u8 {
        let bits: u128 = self as u128;
        [
            ((bits >> 120u32) & 0xFFu128) as u8,
            ((bits >> 112u32) & 0xFFu128) as u8,
            ((bits >> 104u32) & 0xFFu128) as u8,
            ((bits >> 96u32) & 0xFFu128) as u8,
            ((bits >> 88u32) & 0xFFu128) as u8,
            ((bits >> 80u32) & 0xFFu128) as u8,
            ((bits >> 72u32) & 0xFFu128) as u8,
            ((bits >> 64u32) & 0xFFu128) as u8,
            ((bits >> 56u32) & 0xFFu128) as u8,
            ((bits >> 48u32) & 0xFFu128) as u8,
            ((bits >> 40u32) & 0xFFu128) as u8,
            ((bits >> 32u32) & 0xFFu128) as u8,
            ((bits >> 24u32) & 0xFFu128) as u8,
            ((bits >> 16u32) & 0xFFu128) as u8,
            ((bits >> 8u32) & 0xFFu128) as u8,
            (bits & 0xFFu128) as u8,
        ]
    }

    pub fn to_ne_bytes(self: u128) -> [16]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [16]u8) -> u128 {
        let bits: u128 =
        (bytes[0] as u128) |
        ((bytes[1] as u128) << 8u32) |
        ((bytes[2] as u128) << 16u32) |
        ((bytes[3] as u128) << 24u32) |
        ((bytes[4] as u128) << 32u32) |
        ((bytes[5] as u128) << 40u32) |
        ((bytes[6] as u128) << 48u32) |
        ((bytes[7] as u128) << 56u32) |
        ((bytes[8] as u128) << 64u32) |
        ((bytes[9] as u128) << 72u32) |
        ((bytes[10] as u128) << 80u32) |
        ((bytes[11] as u128) << 88u32) |
        ((bytes[12] as u128) << 96u32) |
        ((bytes[13] as u128) << 104u32) |
        ((bytes[14] as u128) << 112u32) |
        ((bytes[15] as u128) << 120u32);
        bits as u128
    }

    pub fn from_be_bytes(bytes: [16]u8) -> u128 {
        let bits: u128 =
        (bytes[15] as u128) |
        ((bytes[14] as u128) << 8u32) |
        ((bytes[13] as u128) << 16u32) |
        ((bytes[12] as u128) << 24u32) |
        ((bytes[11] as u128) << 32u32) |
        ((bytes[10] as u128) << 40u32) |
        ((bytes[9] as u128) << 48u32) |
        ((bytes[8] as u128) << 56u32) |
        ((bytes[7] as u128) << 64u32) |
        ((bytes[6] as u128) << 72u32) |
        ((bytes[5] as u128) << 80u32) |
        ((bytes[4] as u128) << 88u32) |
        ((bytes[3] as u128) << 96u32) |
        ((bytes[2] as u128) << 104u32) |
        ((bytes[1] as u128) << 112u32) |
        ((bytes[0] as u128) << 120u32);
        bits as u128
    }

    pub fn from_ne_bytes(bytes: [16]u8) -> u128 {
        u128.from_le_bytes(bytes)
    }

    // ---- unsigned-only members (AXS-INT-031) -------------------------------------------------
    pub fn is_power_of_two(self: u128) -> bool {
        self != 0u128 && (self & (self - 1u128)) == 0u128
    }

    pub fn checked_next_power_of_two(self: u128) -> Option<u128> {
        if self <= 1u128 {
            return Option.Some(1u128);
        }
        let exponent: u32 = 128u32 - (self - 1u128).leading_zeros();
        if exponent >= 128u32 {
            return Option.None;
        }
        Option.Some(1u128 << exponent)
    }

    // Panics with "arithmetic overflow" (default checked `*`) when self > 2^(BITS-1).
    pub fn next_power_of_two(self: u128) -> u128 {
        if self <= 1u128 {
            return 1u128;
        }
        let exponent: u32 = 128u32 - (self - 1u128).leading_zeros();
        let half: u128 = 1u128 << (exponent - 1u32);
        half * 2u128
    }
}

// ================================================================================================
// usize
// ================================================================================================
// Helpers of the overflowing_* methods (private to this module).
fn pair_usize(value: usize, flag: bool) -> (usize, bool) {
    // `(value, flag)` does not compile (tests/std/num/tuple_names_xfail.ax): build the pair field by field.
    let mut result: (usize, bool) = (0usize, false);
    result.0 = value;
    result.1 = flag;
    result
}

fn add_overflows_usize(a: usize, b: usize) -> bool {
    let sum: usize = a.wrapping_add(b);
    sum < a
}

fn sub_overflows_usize(a: usize, b: usize) -> bool {
    let diff: usize = a.wrapping_sub(b);
    b > a
}

fn mul_overflows_usize(a: usize, b: usize) -> bool {
    match a.checked_mul(b) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn pow_overflows_usize(base: usize, exp: u32) -> bool {
    match base.checked_pow(exp) {
        Option.Some(_) => false,
        Option.None => true,
    }
}

impl usize {
    // ---- ordering helpers --------------------------------------------------------------------
    pub fn min(self: usize, other: usize) -> usize {
        if self < other { self } else { other }
    }

    pub fn max(self: usize, other: usize) -> usize {
        if self > other { self } else { other }
    }

    pub fn clamp(self: usize, min_val: usize, max_val: usize) -> usize {
        assert(min_val <= max_val);
        if self < min_val {
            min_val
        } else if self > max_val {
            max_val
        } else {
            self
        }
    }

    pub fn abs_diff(self: usize, other: usize) -> usize {
        if self > other {
            (self as usize).wrapping_sub(other as usize)
        } else {
            (other as usize).wrapping_sub(self as usize)
        }
    }

    // ---- wrapping family (AXS-INT-022) -------------------------------------------------------
    pub fn wrapping_div(self: usize, rhs: usize) -> usize {
        self / rhs
    }

    pub fn wrapping_rem(self: usize, rhs: usize) -> usize {
        self % rhs
    }

    pub fn wrapping_shl(self: usize, rhs: u32) -> usize {
        self << (rhs & 63u32)
    }

    pub fn wrapping_shr(self: usize, rhs: u32) -> usize {
        self >> (rhs & 63u32)
    }

    pub fn wrapping_pow(self: usize, exp: u32) -> usize {
        let mut result: usize = 1usize;
        let mut base: usize = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.wrapping_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.wrapping_mul(base);
            }
        }
        result
    }

    // ---- saturating family (AXS-INT-023) -----------------------------------------------------
    pub fn saturating_div(self: usize, rhs: usize) -> usize {
        self / rhs
    }

    pub fn saturating_pow(self: usize, exp: u32) -> usize {
        let mut result: usize = 1usize;
        let mut base: usize = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result.saturating_mul(base);
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base.saturating_mul(base);
            }
        }
        result
    }

    // ---- checked family (AXS-INT-024) --------------------------------------------------------
    pub fn checked_add(self: usize, rhs: usize) -> Option<usize> {
        let sum: usize = self.wrapping_add(rhs);
        if sum < self {
            Option.None
        } else {
            Option.Some(sum)
        }
    }

    pub fn checked_sub(self: usize, rhs: usize) -> Option<usize> {
        if rhs > self {
            Option.None
        } else {
            Option.Some(self - rhs)
        }
    }

    pub fn checked_mul(self: usize, rhs: usize) -> Option<usize> {
        if self == 0usize || rhs == 0usize {
            return Option.Some(0usize);
        }
        let product: usize = self.wrapping_mul(rhs);
        if product / rhs != self {
            Option.None
        } else {
            Option.Some(product)
        }
    }

    pub fn checked_div(self: usize, rhs: usize) -> Option<usize> {
        if rhs == 0usize {
            return Option.None;
        }
        Option.Some(self / rhs)
    }

    pub fn checked_rem(self: usize, rhs: usize) -> Option<usize> {
        if rhs == 0usize {
            return Option.None;
        }
        Option.Some(self % rhs)
    }

    pub fn checked_neg(self: usize) -> Option<usize> {
        if self == 0usize {
            Option.Some(0usize)
        } else {
            Option.None
        }
    }

    pub fn checked_shl(self: usize, rhs: u32) -> Option<usize> {
        if rhs >= 64u32 {
            Option.None
        } else {
            Option.Some(self << rhs)
        }
    }

    pub fn checked_shr(self: usize, rhs: u32) -> Option<usize> {
        if rhs >= 64u32 {
            Option.None
        } else {
            Option.Some(self >> rhs)
        }
    }

    pub fn checked_pow(self: usize, exp: u32) -> Option<usize> {
        let mut result: usize = 1usize;
        let mut base: usize = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                match result.checked_mul(base) {
                    Option.Some(value) => {
                        result = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                match base.checked_mul(base) {
                    Option.Some(value) => {
                        base = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
        }
        Option.Some(result)
    }

    // ---- overflowing family (AXS-INT-025) ----------------------------------------------------
    // Tuple expressions that name a variable do not compile (tests/std/num/tuple_names_xfail.ax), so every
    // tuple result is built by the pair_* helper above the impl.
    pub fn overflowing_add(self: usize, rhs: usize) -> (usize, bool) {
        pair_usize(self.wrapping_add(rhs), add_overflows_usize(self, rhs))
    }

    pub fn overflowing_sub(self: usize, rhs: usize) -> (usize, bool) {
        pair_usize(self.wrapping_sub(rhs), sub_overflows_usize(self, rhs))
    }

    pub fn overflowing_mul(self: usize, rhs: usize) -> (usize, bool) {
        pair_usize(self.wrapping_mul(rhs), mul_overflows_usize(self, rhs))
    }

    pub fn overflowing_div(self: usize, rhs: usize) -> (usize, bool) {
        pair_usize(self / rhs, false)
    }

    pub fn overflowing_rem(self: usize, rhs: usize) -> (usize, bool) {
        pair_usize(self % rhs, false)
    }

    pub fn overflowing_neg(self: usize) -> (usize, bool) {
        pair_usize(self.wrapping_neg(), self != 0usize)
    }

    pub fn overflowing_shl(self: usize, rhs: u32) -> (usize, bool) {
        pair_usize(self.wrapping_shl(rhs), rhs >= 64u32)
    }

    pub fn overflowing_shr(self: usize, rhs: u32) -> (usize, bool) {
        pair_usize(self.wrapping_shr(rhs), rhs >= 64u32)
    }

    pub fn overflowing_pow(self: usize, exp: u32) -> (usize, bool) {
        pair_usize(self.wrapping_pow(exp), pow_overflows_usize(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: usize, exp: u32) -> usize {
        let mut result: usize = 1usize;
        let mut base: usize = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: usize) -> u32 {
        64u32 - self.count_ones()
    }

    pub fn leading_ones(self: usize) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: usize) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: usize) -> [8]u8 {
        let bits: usize = self as usize;
        [
            (bits & 0xFFusize) as u8,
            ((bits >> 8u32) & 0xFFusize) as u8,
            ((bits >> 16u32) & 0xFFusize) as u8,
            ((bits >> 24u32) & 0xFFusize) as u8,
            ((bits >> 32u32) & 0xFFusize) as u8,
            ((bits >> 40u32) & 0xFFusize) as u8,
            ((bits >> 48u32) & 0xFFusize) as u8,
            ((bits >> 56u32) & 0xFFusize) as u8,
        ]
    }

    pub fn to_be_bytes(self: usize) -> [8]u8 {
        let bits: usize = self as usize;
        [
            ((bits >> 56u32) & 0xFFusize) as u8,
            ((bits >> 48u32) & 0xFFusize) as u8,
            ((bits >> 40u32) & 0xFFusize) as u8,
            ((bits >> 32u32) & 0xFFusize) as u8,
            ((bits >> 24u32) & 0xFFusize) as u8,
            ((bits >> 16u32) & 0xFFusize) as u8,
            ((bits >> 8u32) & 0xFFusize) as u8,
            (bits & 0xFFusize) as u8,
        ]
    }

    pub fn to_ne_bytes(self: usize) -> [8]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [8]u8) -> usize {
        let bits: usize =
        (bytes[0] as usize) |
        ((bytes[1] as usize) << 8u32) |
        ((bytes[2] as usize) << 16u32) |
        ((bytes[3] as usize) << 24u32) |
        ((bytes[4] as usize) << 32u32) |
        ((bytes[5] as usize) << 40u32) |
        ((bytes[6] as usize) << 48u32) |
        ((bytes[7] as usize) << 56u32);
        bits as usize
    }

    pub fn from_be_bytes(bytes: [8]u8) -> usize {
        let bits: usize =
        (bytes[7] as usize) |
        ((bytes[6] as usize) << 8u32) |
        ((bytes[5] as usize) << 16u32) |
        ((bytes[4] as usize) << 24u32) |
        ((bytes[3] as usize) << 32u32) |
        ((bytes[2] as usize) << 40u32) |
        ((bytes[1] as usize) << 48u32) |
        ((bytes[0] as usize) << 56u32);
        bits as usize
    }

    pub fn from_ne_bytes(bytes: [8]u8) -> usize {
        usize.from_le_bytes(bytes)
    }

    // ---- unsigned-only members (AXS-INT-031) -------------------------------------------------
    pub fn is_power_of_two(self: usize) -> bool {
        self != 0usize && (self & (self - 1usize)) == 0usize
    }

    pub fn checked_next_power_of_two(self: usize) -> Option<usize> {
        if self <= 1usize {
            return Option.Some(1usize);
        }
        let exponent: u32 = 64u32 - (self - 1usize).leading_zeros();
        if exponent >= 64u32 {
            return Option.None;
        }
        Option.Some(1usize << exponent)
    }

    // Panics with "arithmetic overflow" (default checked `*`) when self > 2^(BITS-1).
    pub fn next_power_of_two(self: usize) -> usize {
        if self <= 1usize {
            return 1usize;
        }
        let exponent: u32 = 64u32 - (self - 1usize).leading_zeros();
        let half: usize = 1usize << (exponent - 1u32);
        half * 2usize
    }
}

// char.from_u32 (ADR-0006 §2)
impl char {
    pub fn from_u32(n: u32) -> Option<char> {
        if n <= 0x10FFFF && !(n >= 0xD800 && n <= 0xDFFF) {
            Option.Some(n as char)
        } else {
            Option.None
        }
    }
}
