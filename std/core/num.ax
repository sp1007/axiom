    pub fn wrapping_sub(self: u32, rhs: u32) -> u32 { wrapping_sub_u32(self, rhs) }
    pub fn wrapping_mul(self: u32, rhs: u32) -> u32 { wrapping_mul_u32(self, rhs) }
    pub fn rotate_left(self: u32, n: u32) -> u32 { rotate_left_u32(self, n) }
    pub fn rotate_right(self: u32, n: u32) -> u32 { rotate_right_u32(self, n) }
    pub fn leading_zeros(self: u32) -> u32 { leading_zeros_u32(self) }
    pub fn trailing_zeros(self: u32) -> u32 { trailing_zeros_u32(self) }
    pub fn count_ones(self: u32) -> u32 { count_ones_u32(self) }
