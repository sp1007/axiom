@intrinsic fn rotate_right_u16(a: u16, b: u32) -> u16 { 0 }
@intrinsic fn leading_zeros_u16(a: u16) -> u32 { 0 }
@intrinsic fn trailing_zeros_u16(a: u16) -> u32 { 0 }
@intrinsic fn count_ones_u16(a: u16) -> u32 { 0 }

@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_sub_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_neg_i32(a: i32) -> i32 { 0 }
@intrinsic fn rotate_left_i32(a: i32, b: u32) -> i32 { 0 }
@intrinsic fn rotate_right_i32(a: i32, b: u32) -> i32 { 0 }
@intrinsic fn leading_zeros_i32(a: i32) -> u32 { 0 }
@intrinsic fn trailing_zeros_i32(a: i32) -> u32 { 0 }
@intrinsic fn count_ones_i32(a: i32) -> u32 { 0 }

