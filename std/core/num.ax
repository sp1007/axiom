    pub fn checked_neg(self: i32) -> Option<i32> {
        if self == i32.MIN {
            Option.None
        } else {
            Option.Some(-self)
        }
    }

    pub fn checked_shl(self: i32, rhs: u32) -> Option<i32> {
        if rhs >= 32u32 {
            Option.None
        } else {
            Option.Some(self << rhs)
        }
    }

    pub fn checked_shr(self: i32, rhs: u32) -> Option<i32> {
        if rhs >= 32u32 {
            Option.None
        } else {
            Option.Some(self >> rhs)
        }
    }

    pub fn checked_pow(self: i32, exp: u32) -> Option<i32> {
        let mut result: i32 = 1i32;
        let mut base: i32 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                match result.checked_mul(base) {
                    Option.Some(value) => {
                        result = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                match base.checked_mul(base) {
                    Option.Some(value) => {
                        base = value;
                    },
                    Option.None => {
                        return Option.None;
                    },
                }
            }
        }
        Option.Some(result)
    }

    // ---- overflowing family (AXS-INT-025) ----------------------------------------------------
    // Tuple expressions that name a variable do not compile (tests/std/num/tuple_names_xfail.ax), so every
    // tuple result is built by the pair_* helper above the impl.
    pub fn overflowing_add(self: i32, rhs: i32) -> (i32, bool) {
        pair_i32(self.wrapping_add(rhs), add_overflows_i32(self, rhs))
    }

    pub fn overflowing_sub(self: i32, rhs: i32) -> (i32, bool) {
        pair_i32(self.wrapping_sub(rhs), sub_overflows_i32(self, rhs))
    }

    pub fn overflowing_mul(self: i32, rhs: i32) -> (i32, bool) {
        pair_i32(self.wrapping_mul(rhs), mul_overflows_i32(self, rhs))
    }

    pub fn overflowing_div(self: i32, rhs: i32) -> (i32, bool) {
        if self == i32.MIN && rhs == -1i32 {
            return pair_i32(i32.MIN, true);
        }
        pair_i32(self / rhs, false)
    }

    pub fn overflowing_rem(self: i32, rhs: i32) -> (i32, bool) {
        if self == i32.MIN && rhs == -1i32 {
            return pair_i32(0i32, true);
        }
        pair_i32(self % rhs, false)
    }

    pub fn overflowing_neg(self: i32) -> (i32, bool) {
        pair_i32(self.wrapping_neg(), self == i32.MIN)
    }

    pub fn overflowing_shl(self: i32, rhs: u32) -> (i32, bool) {
        pair_i32(self.wrapping_shl(rhs), rhs >= 32u32)
    }

    pub fn overflowing_shr(self: i32, rhs: u32) -> (i32, bool) {
        pair_i32(self.wrapping_shr(rhs), rhs >= 32u32)
    }

    pub fn overflowing_pow(self: i32, exp: u32) -> (i32, bool) {
        pair_i32(self.wrapping_pow(exp), pow_overflows_i32(self, exp))
    }

    // ---- checked exponentiation (AXS-INT-026) ------------------------------------------------
    pub fn pow(self: i32, exp: u32) -> i32 {
        let mut result: i32 = 1i32;
        let mut base: i32 = self;
        let mut remaining: u32 = exp;
        while remaining > 0u32 {
            if (remaining & 1u32) == 1u32 {
                result = result * base;
            }
            remaining = remaining >> 1u32;
            if remaining > 0u32 {
                base = base * base;
            }
        }
        result
    }

    // ---- bit manipulation (AXS-INT-031) ------------------------------------------------------
    pub fn count_zeros(self: i32) -> u32 {
        32u32 - self.count_ones()
    }

    pub fn leading_ones(self: i32) -> u32 {
        (~self).leading_zeros()
    }

    pub fn trailing_ones(self: i32) -> u32 {
        (~self).trailing_zeros()
    }

    // ---- byte conversions (AXS-INT-032) ------------------------------------------------------
    pub fn to_le_bytes(self: i32) -> [4]u8 {
        let bits: u32 = self as u32;
        [
            (bits & 0xFFu32) as u8,
            ((bits >> 8u32) & 0xFFu32) as u8,
            ((bits >> 16u32) & 0xFFu32) as u8,
            ((bits >> 24u32) & 0xFFu32) as u8,
        ]
    }

    pub fn to_be_bytes(self: i32) -> [4]u8 {
        let bits: u32 = self as u32;
        [
            ((bits >> 24u32) & 0xFFu32) as u8,
            ((bits >> 16u32) & 0xFFu32) as u8,
            ((bits >> 8u32) & 0xFFu32) as u8,
            (bits & 0xFFu32) as u8,
        ]
    }

    pub fn to_ne_bytes(self: i32) -> [4]u8 {
        self.to_le_bytes()
    }

    pub fn from_le_bytes(bytes: [4]u8) -> i32 {
        let bits: u32 =
        (bytes[0] as u32) |
        ((bytes[1] as u32) << 8u32) |
        ((bytes[2] as u32) << 16u32) |
        ((bytes[3] as u32) << 24u32);
        bits as i32
    }

    pub fn from_be_bytes(bytes: [4]u8) -> i32 {
        let bits: u32 =
        (bytes[3] as u32) |
        ((bytes[2] as u32) << 8u32) |
        ((bytes[1] as u32) << 16u32) |
        ((bytes[0] as u32) << 24u32);
        bits as i32
    }

    pub fn from_ne_bytes(bytes: [4]u8) -> i32 {
        i32.from_le_bytes(bytes)
    }

    // ---- signed-only members (AXS-INT-022/023/024/025/026) -----------------------------------
    pub fn abs(self: i32) -> i32 {
        if self < 0i32 { -self } else { self }
    }

    pub fn unsigned_abs(self: i32) -> u32 {
        if self < 0i32 {
            (0u32).wrapping_sub(self as u32)
        } else {
            self as u32
        }
    }

    pub fn signum(self: i32) -> i32 {
        if self < 0i32 {
            -1i32
        } else if self > 0i32 {
            1i32
        } else {
            0i32
        }
    }

    pub fn is_positive(self: i32) -> bool {
        self > 0i32
    }

    pub fn is_negative(self: i32) -> bool {
        self < 0i32
    }

    pub fn wrapping_abs(self: i32) -> i32 {
        if self < 0i32 { self.wrapping_neg() } else { self }
    }

    pub fn saturating_neg(self: i32) -> i32 {
        if self == i32.MIN { i32.MAX } else { -self }
    }

    pub fn saturating_abs(self: i32) -> i32 {
        if self == i32.MIN {
            i32.MAX
        } else if self < 0i32 {
            -self
        } else {
            self
        }
    }

    pub fn checked_abs(self: i32) -> Option<i32> {
        if self == i32.MIN {
            Option.None
        } else if self < 0i32 {
            Option.Some(-self)
        } else {
            Option.Some(self)
        }
    }

    pub fn overflowing_abs(self: i32) -> (i32, bool) {
        pair_i32(self.wrapping_abs(), self == i32.MIN)
    }
}

