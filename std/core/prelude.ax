module std.core.prelude

// Marker traits Copy, Drop, Send, and Share (std.core.marker) are pre-populated in the prelude scope.
pub use std.core.option.Option;
pub use std.core.result.Result;

pub fn prelude_loaded() -> bool {
    true
}

@derive(Copy)
pub enum Ordering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

@derive(Copy)
pub struct CasResult<T> {
    pub ok: bool,
    pub val: T,
}

@lang("atomic")
pub struct Atomic<T> {
    pub v: T,
}

impl<T> Atomic<T> {
    pub fn new(v: T) -> Atomic<T> {
        loop {}
    }

    pub fn into_inner(self: Atomic<T>) -> T {
        loop {}
    }

    pub fn is_lock_free() -> bool {
        true
    }

    pub fn load(self: view<Atomic<T>>, order: Ordering) -> T {
        loop {}
    }

    pub fn store(self: view<Atomic<T>>, val: T, order: Ordering) {}

    pub fn swap(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn compare_exchange(
        self: view<Atomic<T>>,
        expected: T,
        desired: T,
        success: Ordering,
        failure: Ordering
    ) -> CasResult<T> {
        loop {}
    }

    pub fn compare_exchange_weak(
        self: view<Atomic<T>>,
        expected: T,
        desired: T,
        success: Ordering,
        failure: Ordering
    ) -> CasResult<T> {
        loop {}
    }

    pub fn fetch_add(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn fetch_sub(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn fetch_and(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn fetch_or(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn fetch_xor(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }
}

pub fn fence(order: Ordering) {}

pub fn compiler_fence(order: Ordering) {}

pub fn spin_loop_hint() {}

pub fn is_lock_free<T>() -> bool {
    true
}

pub type AtomicBool = Atomic<bool>
pub type AtomicI8 = Atomic<i8>
pub type AtomicI16 = Atomic<i16>
pub type AtomicI32 = Atomic<i32>
pub type AtomicI64 = Atomic<i64>
pub type AtomicIsize = Atomic<isize>
pub type AtomicU8 = Atomic<u8>
pub type AtomicU16 = Atomic<u16>
pub type AtomicU32 = Atomic<u32>
pub type AtomicU64 = Atomic<u64>
pub type AtomicUsize = Atomic<usize>

@must_use
@lang("poll")
pub enum Poll<T> {
    Ready(T),
    Pending,
}

impl<T> Poll<T> {
    pub fn is_ready(self: view<Poll<T>>) -> bool {
        true
    }

    pub fn is_pending(self: view<Poll<T>>) -> bool {
        false
    }
}

pub struct RawWaker {
    pub data: *const u8,
    pub vtable: *const RawWakerVTable,
}

pub struct RawWakerVTable {
    pub clone: fn(*const u8) -> RawWaker,
    pub wake: fn(*const u8) -> (),
    pub wake_by_ref: fn(*const u8) -> (),
    pub drop_waker: fn(*const u8) -> (),
}

@lang("waker")
pub struct Waker {
    pub raw: RawWaker,
}

@lang("context")
pub struct Context {
    pub waker_val: Waker,
}

@must_use
@lang("future")
pub trait Future {
    type Output;
    fn poll(self: mut_view<Self>, cx: mut_view<Context>) -> Poll<Self.Output>;
}

