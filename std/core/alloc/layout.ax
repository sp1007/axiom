module std.core.alloc.layout

use std.core.option.Option

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

pub struct Layout {
    pub size: usize,
    pub align: usize,
}

impl Layout {
    pub fn new(size: usize, align: usize) -> Option<Layout> {
        if align == 0 {
            return Option.None;
        }
        if (align & (align - 1)) != 0 {
            return Option.None;
        }
        Option.Some(Layout { size: size, align: align })
    }

    pub fn from_size_align_unchecked(size: usize, align: usize) -> Layout {
        Layout { size: size, align: align }
    }

    pub fn for_type<T>() -> Layout {
        Layout {
            size: size_of<T>(),
            align: align_of<T>(),
        }
    }

    pub fn array<T>(count: usize) -> Option<Layout> {
        let elem_size = size_of<T>();
        let elem_align = align_of<T>();
        if count != 0 {
            let max_usize: usize = (0 as usize) - 1;
            if max_usize / count < elem_size {
                return Option.None;
            }
        }
        Option.Some(Layout {
            size: count * elem_size,
            align: elem_align,
        })
    }
}
