module std.core.alloc.alloc

use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

pub struct Layout {
    pub size: usize,
    pub align: usize,
}

impl Layout {
    pub fn new(size: usize, align: usize) -> Option<Layout> {
        if align == 0 {
            return Option.None;
        }
        if (align & (align - 1)) != 0 {
            return Option.None;
        }
        Option.Some(Layout { size: size, align: align })
    }

    pub fn from_size_align_unchecked(size: usize, align: usize) -> Layout {
        Layout { size: size, align: align }
    }

    pub fn for_type<T>() -> Layout {
        Layout {
            size: size_of<T>(),
            align: align_of<T>(),
        }
    }

    pub fn array<T>(count: usize) -> Option<Layout> {
        let elem_size = size_of<T>();
        let elem_align = align_of<T>();
        if count != 0 {
            let max_usize: usize = (0 as usize) - 1;
            if max_usize / count < elem_size {
                return Option.None;
            }
        }
        Option.Some(Layout {
            size: count * elem_size,
            align: elem_align,
        })
    }
}

pub struct AllocError {}

pub trait Allocator {
    unsafe fn allocate(self: mut_view<Self>, layout: Layout) -> *mut u8;
    unsafe fn deallocate(self: mut_view<Self>, ptr: *mut u8, layout: Layout);
    unsafe fn reallocate(self: mut_view<Self>, ptr: *mut u8, old_layout: Layout, new_size: usize) -> *mut u8;
}

pub struct GlobalAlloc {}

impl Allocator for GlobalAlloc {
    unsafe fn allocate(self: mut_view<GlobalAlloc>, layout: Layout) -> *mut u8 {
        heap_alloc(layout.size, layout.align)
    }

    unsafe fn deallocate(self: mut_view<GlobalAlloc>, ptr: *mut u8, layout: Layout) {
        heap_free(ptr, layout.size, layout.align);
    }

    unsafe fn reallocate(self: mut_view<GlobalAlloc>, ptr: *mut u8, old_layout: Layout, new_size: usize) -> *mut u8 {
        heap_realloc(ptr, old_layout.size, new_size, old_layout.align)
    }
}
