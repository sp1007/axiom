module std.core.iter.adapters.map

use std.core.option.Option

pub struct VecIterI32 {
    pub ptr: *const i32,
    pub len: usize,
    pub idx: usize,
}

pub struct MapI32 {
    pub iter: VecIterI32,
    pub f: fn(i32) -> i32,
}

impl MapI32 {
    pub fn new(iter: VecIterI32, f: fn(i32) -> i32) -> MapI32 {
        MapI32 {
            iter: iter,
            f: f,
        }
    }

    pub fn next(self: mut_view<MapI32>) -> Option<i32> {
        if self.iter.idx >= self.iter.len {
            Option.None
        } else {
            let p = unsafe { self.iter.ptr + self.iter.idx };
            self.iter.idx = self.iter.idx + 1;
            let func = self.f;
            Option.Some(func(unsafe { *p }))
        }
    }
}
