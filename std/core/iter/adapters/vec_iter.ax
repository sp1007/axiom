module std.core.iter.adapters.vec_iter

use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct VecI32 {
    pub ptr: *mut i32,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

pub fn vec_i32_new() -> VecI32 {
    VecI32 {
        ptr: 0 as *mut i32,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn vec_i32_push(v: mut_view<VecI32>, val: i32) {
    if v.len == v.cap {
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        let raw = unsafe { heap_alloc(new_cap * 4, 4) };
        let new_ptr = raw as *mut i32;
        if v.len > 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * 4);
                heap_free(v.ptr as *mut u8, v.cap * 4, 4);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        *(v.ptr + v.len) = val;
    }
    v.len = v.len + 1;
}

pub fn vec_i32_free(v: mut_view<VecI32>) {
    if v.cap > 0 && v.ptr as usize != 0 {
        unsafe {
            heap_free(v.ptr as *mut u8, v.cap * 4, 4);
        }
        v.ptr = 0 as *mut i32;
        v.len = 0;
        v.cap = 0;
    }
}

pub struct VecIterI32 {
    pub ptr: *const i32,
    pub len: usize,
    pub idx: usize,
}

pub fn vec_iter_i32(v: view<VecI32>) -> VecIterI32 {
    VecIterI32 {
        ptr: v.ptr as *const i32,
        len: v.len,
        idx: 0,
    }
}

pub fn vec_iter_next_i32(it: mut_view<VecIterI32>) -> Option<i32> {
    if it.idx >= it.len {
        Option.None
    } else {
        let p = unsafe { it.ptr + it.idx };
        it.idx = it.idx + 1;
        Option.Some(unsafe { *p })
    }
}

pub fn collect_vec_i32(mut it: VecIterI32) -> VecI32 {
    let mut v = vec_i32_new();
    let mut done = false;
    while !done {
        match vec_iter_next_i32(mut_view(it)) {
            Option.Some(val) => {
                vec_i32_push(mut_view(v), val);
            },
            Option.None => {
                done = true;
            }
        }
    }
    v
}
