module std.core.iter

use std.core.option.Option;

@lang("Iterator")
pub trait Iterator {
    type Item;
    fn next(self: mut_view<Self>) -> Option<Self.Item>;
}

@derive(Copy)
pub struct Range<T> {
    pub start: T,
    pub end: T,
}

@derive(Copy)
pub struct RangeInclusive<T> {
    pub start: T,
    pub end: T,
    pub done: bool,
}

impl Iterator for Range<i32> {
    type Item = i32;
    fn next(self: mut_view<Range<i32>>) -> Option<i32> {
        if self.start >= self.end {
            return Option.None;
        }
        let val = self.start;
        self.start = self.start + 1;
        Option.Some(val)
    }
}

impl Iterator for RangeInclusive<i32> {
    type Item = i32;
    fn next(self: mut_view<RangeInclusive<i32>>) -> Option<i32> {
        if self.done {
            return Option.None;
        }
        let val = self.start;
        if self.start >= self.end {
            self.done = true;
        } else {
            self.start = self.start + 1;
        }
        Option.Some(val)
    }
}
