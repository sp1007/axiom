// std.future.block_on - Executor-free synchronous Future driver (SPEC-33-async.md AXS-ASY-014)
module std.future.block_on

fn drop_val<T>(val: T) {}

pub fn block_on<F: Future<Output = T>, T>(mut fut: F) -> T {
    let mut cx = Context {
        waker_val: Waker {
            raw: RawWaker {
                data: 0 as *const u8,
                vtable: 0 as *const RawWakerVTable,
            },
        },
    };
    loop {
        match fut.poll(mut_view(cx)) {
            Poll.Ready(v) => {
                drop_val(fut);
                return v;
            },
            Poll.Pending => {},
        }
    }
}
