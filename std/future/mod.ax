// std.future - Future, Poll, Waker, Context, RawWaker, RawWakerVTable, and block_on (SPEC-33-async.md)
module std.future

pub use std.core.prelude.Poll;
pub use std.core.prelude.RawWaker;
pub use std.core.prelude.RawWakerVTable;
pub use std.core.prelude.Waker;
pub use std.core.prelude.Context;
pub use std.core.prelude.Future;

pub use std.future.block_on.block_on;

// Deterministic Async Lifecycle Trace Verification (SPEC-33 AXS-ASY-050)
pub fn trace_poll(fut: u64, name: str, state: u32) {
    print("POLL fut=");
    print_int(fut as i64);
    print(" fn=");
    print(name);
    print(" state=");
    print_int(state as i64);
    print("\n");
}

pub fn trace_suspend(fut: u64, name: str, sp: u32, state: u32) {
    print("SUSPEND fut=");
    print_int(fut as i64);
    print(" fn=");
    print(name);
    print(" sp=");
    print_int(sp as i64);
    print(" state=");
    print_int(state as i64);
    print("\n");
}

pub fn trace_wake(fut: u64) {
    print("WAKE fut=");
    print_int(fut as i64);
    print("\n");
}

pub fn trace_resume(fut: u64, name: str, sp: u32, state: u32) {
    print("RESUME fut=");
    print_int(fut as i64);
    print(" fn=");
    print(name);
    print(" sp=");
    print_int(sp as i64);
    print(" state=");
    print_int(state as i64);
    print("\n");
}

pub fn trace_complete(fut: u64, name: str) {
    print("COMPLETE fut=");
    print_int(fut as i64);
    print(" fn=");
    print(name);
    print("\n");
}

pub fn trace_cancel_drop(fut: u64, name: str, state: u32) {
    print("CANCEL_DROP fut=");
    print_int(fut as i64);
    print(" fn=");
    print(name);
    print(" state=");
    print_int(state as i64);
    print("\n");
}
