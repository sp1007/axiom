// std.future - Future, Poll, Waker, Context, RawWaker, and RawWakerVTable (SPEC-33-async.md)
module std.future

@must_use
@lang("poll")
pub enum Poll<T> {
    Ready(T),
    Pending,
}

impl<T> Poll<T> {
    pub fn is_ready(self: view<Poll<T>>) -> bool {
        match *self {
            Poll.Ready(_) => true,
            Poll.Pending => false,
        }
    }

    pub fn is_pending(self: view<Poll<T>>) -> bool {
        match *self {
            Poll.Ready(_) => false,
            Poll.Pending => true,
        }
    }
}

pub struct RawWaker {
    pub data: *const u8,
    pub vtable: *const RawWakerVTable,
}

impl RawWaker {
    pub fn new(data: *const u8, vtable: *const RawWakerVTable) -> RawWaker {
        RawWaker { data: data, vtable: vtable }
    }
}

pub struct RawWakerVTable {
    pub clone: fn(*const u8) -> RawWaker,
    pub wake: fn(*const u8) -> (),
    pub wake_by_ref: fn(*const u8) -> (),
    pub drop_waker: fn(*const u8) -> (),
}

impl RawWakerVTable {
    pub fn new(
        clone: fn(*const u8) -> RawWaker,
        wake: fn(*const u8) -> (),
        wake_by_ref: fn(*const u8) -> (),
        drop_waker: fn(*const u8) -> (),
    ) -> RawWakerVTable {
        RawWakerVTable {
            clone: clone,
            wake: wake,
            wake_by_ref: wake_by_ref,
            drop_waker: drop_waker,
        }
    }
}

@lang("waker")
pub struct Waker {
    pub raw: RawWaker,
}

impl Waker {
    pub unsafe fn from_raw(raw: RawWaker) -> Waker {
        Waker { raw: raw }
    }

    pub fn noop() -> Waker {
        Waker {
            raw: RawWaker {
                data: 0 as *const u8,
                vtable: 0 as *const RawWakerVTable,
            },
        }
    }

    pub fn as_raw(self: view<Waker>) -> RawWaker {
        RawWaker {
            data: self.raw.data,
            vtable: self.raw.vtable,
        }
    }

    pub fn wake(self: Waker) {}

    pub fn wake_by_ref(self: view<Waker>) {}

    pub fn clone_waker(self: view<Waker>) -> Waker {
        Waker {
            raw: RawWaker {
                data: self.raw.data,
                vtable: self.raw.vtable,
            },
        }
    }

    pub fn will_wake(self: view<Waker>, other: view<Waker>) -> bool {
        (self.raw.data as usize) == (other.raw.data as usize) &&
            (self.raw.vtable as usize) == (other.raw.vtable as usize)
    }
}

@lang("context")
pub struct Context {
    pub waker_val: Waker,
}

impl Context {
    pub fn from_waker(waker: view<Waker>) -> Context {
        Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: waker.raw.data,
                    vtable: waker.raw.vtable,
                },
            },
        }
    }

    pub fn waker(self: view<Context>) -> Waker {
        Waker {
            raw: RawWaker {
                data: self.waker_val.raw.data,
                vtable: self.waker_val.raw.vtable,
            },
        }
    }
}

@must_use
@lang("future")
pub trait Future {
    type Output;
    fn poll(self: mut_view<Self>, cx: mut_view<Context>) -> Poll<Self.Output>;
}
