@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub enum FsError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidHandle,
    InvalidData,
    Other(i64),
}

pub fn fs_error_from_code(code: i64) -> FsError {
    if code == -1 {
        FsError.NotFound
    } else if code == -2 {
        FsError.PermissionDenied
    } else if code == -3 {
        FsError.AlreadyExists
    } else if code == -4 {
        FsError.InvalidHandle
    } else {
        FsError.Other(code)
    }
}

pub struct Metadata {
    pub kind: u64,
    pub size: u64,
}

pub fn metadata_is_file(m: view<Metadata>) -> bool {
    m.kind == 1u64
}

pub fn metadata_is_dir(m: view<Metadata>) -> bool {
    m.kind == 2u64
}

pub fn metadata_is_symlink(m: view<Metadata>) -> bool {
    m.kind == 3u64
}

pub fn metadata_len(m: view<Metadata>) -> u64 {
    m.size
}

impl Metadata {
    pub fn is_file(self: view<Metadata>) -> bool { metadata_is_file(self) }
    pub fn is_dir(self: view<Metadata>) -> bool { metadata_is_dir(self) }
    pub fn is_symlink(self: view<Metadata>) -> bool { metadata_is_symlink(self) }
    pub fn len(self: view<Metadata>) -> u64 { metadata_len(self) }
}

pub fn metadata(path: Str) -> Result<Metadata, FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let mut out: [2]u64 = [0u64; 2];
    let res = unsafe { metadata(p, plen, address_of_mut(out[0])) };
    if res != 0 {
        Result.Err(fs_error_from_code(res))
    } else {
        Result.Ok(Metadata { kind: out[0], size: out[1] })
    }
}

pub fn exists(path: Str) -> bool {
    match metadata(path) {
        Result.Ok(_) => true,
        Result.Err(_) => false,
    }
}

pub fn is_file(path: Str) -> bool {
    match metadata(path) {
        Result.Ok(m) => m.is_file(),
        Result.Err(_) => false,
    }
}

pub fn is_dir(path: Str) -> bool {
    match metadata(path) {
        Result.Ok(m) => m.is_dir(),
        Result.Err(_) => false,
    }
}

pub fn create_dir(path: Str) -> Result<(), FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let res = unsafe { mkdir(p, plen) };
    if res != 0 {
        Result.Err(fs_error_from_code(res))
    } else {
        Result.Ok(())
    }
}

pub fn create_dir_all(path: Str) -> Result<(), FsError> {
    let plen = len(path);
    if plen == 0 {
        return Result.Ok(());
    }
    if exists(path) {
        let m = match metadata(path) {
            Result.Ok(meta) => meta,
            Result.Err(e) => return Result.Err(e),
        };
        if m.is_dir() {
            return Result.Ok(());
        }
        return Result.Err(FsError.AlreadyExists);
    }
    match parent(path) {
        Option.Some(p) => {
            if len(p) > 0 && len(p) != plen {
                match create_dir_all(p) {
                    Result.Ok(_) => {},
                    Result.Err(e) => return Result.Err(e),
                }
            }
        },
        Option.None => {},
    }
    match create_dir(path) {
        Result.Ok(_) => Result.Ok(()),
        Result.Err(e) => {
            match e {
                FsError.AlreadyExists => {
                    if is_dir(path) { Result.Ok(()) } else { Result.Err(e) }
                },
                _ => Result.Err(e),
            }
        },
    }
}

pub fn remove_file(path: Str) -> Result<(), FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let res = unsafe { remove(p, plen) };
    if res != 0 {
        Result.Err(fs_error_from_code(res))
    } else {
        Result.Ok(())
    }
}

pub fn remove_dir(path: Str) -> Result<(), FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let res = unsafe { remove(p, plen) };
    if res != 0 {
        Result.Err(fs_error_from_code(res))
    } else {
        Result.Ok(())
    }
}

pub struct DirEntry {
    pub name: String,
    pub path: String,
}

impl DirEntry {
    pub fn file_name(self: view<DirEntry>) -> Str { self.name.as_str() }
    pub fn path(self: view<DirEntry>) -> Str { self.path.as_str() }
    pub fn metadata(self: view<DirEntry>) -> Result<Metadata, FsError> { metadata(self.path.as_str()) }
}

fn str_cmp(a: Str, b: Str) -> i32 {
    let na = len(a);
    let nb = len(b);
    let min_len = if na < nb { na } else { nb };
    let mut i: usize = 0;
    while i < min_len {
        let ba = a[i];
        let bb = b[i];
        if ba < bb { return -1; }
        if ba > bb { return 1; }
        i = i + 1;
    }
    if na < nb { return -1; }
    if na > nb { return 1; }
    0
}

pub fn read_dir(path: Str) -> Result<Vec<DirEntry>, FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let dh = unsafe { dir_open(p, plen) };
    if dh < 0 {
        return Result.Err(fs_error_from_code(dh));
    }

    let mut entries = vec_new<DirEntry>();
    let name_buf: *mut u8 = unsafe { heap_alloc(512, 1) };

    loop {
        let n = unsafe { dir_next(dh, name_buf, 512) };
        if n == 0 {
            break;
        }
        if n > 512 {
            break;
        }
        let usize_n = n as usize;
        let mut sname = string_with_capacity(usize_n);
        let mut i: usize = 0;
        while i < usize_n {
            let b = unsafe { *(name_buf + i) };
            string_push_byte(mut_view(sname), b);
            i = i + 1;
        }
        let epath = join(path, sname.as_str());
        let entry = DirEntry { name: sname, path: epath };
        vec_push(mut_view(entries), entry);
    }

    unsafe {
        dir_close(dh);
        heap_free(name_buf, 512, 1);
    }

    let count = vec_len(view(entries));
    if count > 1 {
        let mut i: usize = 0;
        while i < count - 1 {
            let mut min_idx = i;
            let mut j = i + 1;
            while j < count {
                let entry_j = unsafe { *(entries.ptr + j) };
                let entry_min = unsafe { *(entries.ptr + min_idx) };
                if str_cmp(entry_j.name.as_str(), entry_min.name.as_str()) < 0 {
                    min_idx = j;
                }
                j = j + 1;
            }
            if min_idx != i {
                unsafe {
                    let mut tmp_bytes: [64]u8 = [0u8; 64];
                    let pi = (entries.ptr + i) as *mut u8;
                    let pmin = (entries.ptr + min_idx) as *mut u8;
                    let ptmp = address_of_mut(tmp_bytes[0]);
                    ptr_copy_nonoverlapping<u8>(pi, ptmp, 64);
                    ptr_copy_nonoverlapping<u8>(pmin, pi, 64);
                    ptr_copy_nonoverlapping<u8>(ptmp, pmin, 64);
                }
            }
            i = i + 1;
        }
    }

    Result.Ok(entries)
}

pub fn remove_dir_all(path: Str) -> Result<(), FsError> {
    let entries = match read_dir(path) {
        Result.Ok(list) => list,
        Result.Err(e) => return Result.Err(e),
    };
    let n = vec_len(view(entries));
    let mut i: usize = 0;
    while i < n {
        let entry = unsafe { *(entries.ptr + i) };
        let epath = entry.path.as_str();
        if is_dir(epath) {
            match remove_dir_all(epath) {
                Result.Ok(_) => {},
                Result.Err(e) => return Result.Err(e),
            }
        } else {
            match remove_file(epath) {
                Result.Ok(_) => {},
                Result.Err(e) => return Result.Err(e),
            }
        }
        i = i + 1;
    }
    remove_dir(path)
}

pub fn read(path: Str) -> Result<ByteBuf, FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 0u32) };
    if h < 0 {
        return Result.Err(fs_error_from_code(h));
    }
    let sz = file_size(h);
    if sz < 0 {
        close(h);
        return Result.Err(fs_error_from_code(sz));
    }
    let usize_sz = sz as usize;
    let mut buf = byte_buf_with_capacity(usize_sz);
    if usize_sz > 0 {
        let mut total_read: usize = 0;
        while total_read < usize_sz {
            let dst = unsafe { buf.ptr + total_read };
            let remaining = usize_sz - total_read;
            let rd = unsafe { read(h, dst, remaining) };
            if rd <= 0 {
                break;
            }
            total_read = total_read + (rd as usize);
        }
        buf.len = total_read;
    }
    close(h);
    Result.Ok(buf)
}

pub fn write(path: Str, bytes: view<[u8]>) -> Result<(), FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 1u32) };
    if h < 0 {
        return Result.Err(fs_error_from_code(h));
    }
    let n = len(bytes);
    if n > 0 {
        let pbytes = unsafe { *(address_of(bytes) as *const *const u8) };
        let mut total_written: usize = 0;
        while total_written < n {
            let src = unsafe { pbytes + total_written };
            let remaining = n - total_written;
            let wr = unsafe { write(h, src, remaining) };
            if wr <= 0 {
                close(h);
                return Result.Err(FsError.Other(-9));
            }
            total_written = total_written + (wr as usize);
        }
    }
    close(h);
    Result.Ok(())
}

pub fn write_byte_buf(path: Str, buf: view<ByteBuf>) -> Result<(), FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 1u32) };
    if h < 0 {
        return Result.Err(fs_error_from_code(h));
    }
    let n = buf.len;
    if n > 0 && buf.ptr as usize != 0 {
        let mut total_written: usize = 0;
        while total_written < n {
            let src = unsafe { (buf.ptr as *const u8) + total_written };
            let remaining = n - total_written;
            let wr = unsafe { write(h, src, remaining) };
            if wr <= 0 {
                close(h);
                return Result.Err(FsError.Other(-9));
            }
            total_written = total_written + (wr as usize);
        }
    }
    close(h);
    Result.Ok(())
}

pub struct BinaryWriter {
    pub handle: i64,
    pub buf: ByteBuf,
    pub capacity: usize,
    pub is_open: bool,
}

impl Drop for BinaryWriter {
    fn drop(self: mut_view<BinaryWriter>) {
        if self.is_open && self.handle >= 0 {
            let _ = binary_writer_flush(self);
            close(self.handle);
            self.is_open = false;
            self.handle = -1;
        }
    }
}

pub fn binary_writer_create(path: Str) -> Result<BinaryWriter, FsError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 1u32) };
    if h < 0 {
        return Result.Err(fs_error_from_code(h));
    }
    Result.Ok(BinaryWriter {
        handle: h,
        buf: byte_buf_with_capacity(4096),
        capacity: 4096,
        is_open: true,
    })
}

pub fn binary_writer_flush(w: mut_view<BinaryWriter>) -> Result<(), FsError> {
    if !w.is_open || w.handle < 0 {
        return Result.Err(FsError.InvalidHandle);
    }
    let n = w.buf.len;
    if n > 0 && w.buf.ptr as usize != 0 {
        let mut total_written: usize = 0;
        while total_written < n {
            let src = unsafe { (w.buf.ptr as *const u8) + total_written };
            let remaining = n - total_written;
            let wr = unsafe { write(w.handle, src, remaining) };
            if wr <= 0 {
                return Result.Err(FsError.Other(-9));
            }
            total_written = total_written + (wr as usize);
        }
        byte_buf_clear(mut_view(w.buf));
    }
    Result.Ok(())
}

pub fn binary_writer_write_u8(w: mut_view<BinaryWriter>, b: u8) -> Result<(), FsError> {
    if w.buf.len >= w.capacity {
        match binary_writer_flush(w) {
            Result.Ok(_) => {},
            Result.Err(e) => return Result.Err(e),
        }
    }
    byte_buf_put_u8(mut_view(w.buf), b);
    Result.Ok(())
}

pub fn binary_writer_write_bytes(w: mut_view<BinaryWriter>, bytes: view<[u8]>) -> Result<(), FsError> {
    let n = len(bytes);
    let mut i: usize = 0;
    while i < n {
        match binary_writer_write_u8(w, bytes[i]) {
            Result.Ok(_) => {},
            Result.Err(e) => return Result.Err(e),
        }
        i = i + 1;
    }
    Result.Ok(())
}

pub fn binary_writer_write_byte_buf(w: mut_view<BinaryWriter>, buf: view<ByteBuf>) -> Result<(), FsError> {
    let n = buf.len;
    let mut i: usize = 0;
    while i < n {
        let b = unsafe { *(buf.ptr + i) };
        match binary_writer_write_u8(w, b) {
            Result.Ok(_) => {},
            Result.Err(e) => return Result.Err(e),
        }
        i = i + 1;
    }
    Result.Ok(())
}

pub fn binary_writer_close(w: mut_view<BinaryWriter>) -> Result<(), FsError> {
    if !w.is_open || w.handle < 0 {
        return Result.Err(FsError.InvalidHandle);
    }
    let res = binary_writer_flush(w);
    let cl = close(w.handle);
    w.is_open = false;
    w.handle = -1;
    match res {
        Result.Ok(_) => {
            if cl < 0 { Result.Err(fs_error_from_code(cl)) } else { Result.Ok(()) }
        },
        Result.Err(e) => Result.Err(e),
    }
}

impl BinaryWriter {
    pub fn create(path: Str) -> Result<BinaryWriter, FsError> { binary_writer_create(path) }
    pub fn write_u8(self: mut_view<BinaryWriter>, b: u8) -> Result<(), FsError> { binary_writer_write_u8(self, b) }
    pub fn write_bytes(self: mut_view<BinaryWriter>, bytes: view<[u8]>) -> Result<(), FsError> { binary_writer_write_bytes(self, bytes) }
    pub fn write_byte_buf(self: mut_view<BinaryWriter>, buf: view<ByteBuf>) -> Result<(), FsError> { binary_writer_write_byte_buf(self, buf) }
    pub fn flush(self: mut_view<BinaryWriter>) -> Result<(), FsError> { binary_writer_flush(self) }
    pub fn close(self: mut_view<BinaryWriter>) -> Result<(), FsError> { binary_writer_close(self) }
}
