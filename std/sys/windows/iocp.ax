        let mut sa: [16]u8 = [0u8; 16];
        fill_sockaddr_in(address_of_mut(sa[0]), addr_ipv4, port);
        if bind(sock, address_of(sa[0]), 16) != 0 {
            let err = WSAGetLastError() as u32;
            let _ = closesocket(sock);
            return map_win32_error(err);
        }
        let assoc = CreateIoCompletionPort(sock as *mut u8, iocp, 0usize, 0u32);
        if (assoc as usize) == 0 {
            let err = GetLastError();
            let _ = closesocket(sock);
            return map_win32_error(err);
        }
        EnterCriticalSection(cs);
        let hid = win_aio_alloc_handle(rt, HANDLE_KIND_UDP_SOCK, reactor, sock as *mut u8);
        LeaveCriticalSection(cs);
        if hid < 0i64 {
            let _ = closesocket(sock);
        }
        hid
    }
}

pub unsafe fn __ax_host_aio_submit_recv_from(reactor: i64, sock_h: i64, buf: *mut u8, len: usize) -> i64 {
    let rt = win_aio_rt_get();
    if (rt as usize) == 0 || sock_h < 1i64 || (sock_h as usize) > MAX_IOCP_HANDLES {
        return -4i64;
    }
    let cs = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs);
    let iocp = win_aio_get_iocp(rt, reactor);
    let hidx = (sock_h - 1i64) as usize;
    if (iocp as usize) == 0 || (*rt).handles[hidx].in_use == 0u32 || (*rt).handles[hidx].kind != HANDLE_KIND_UDP_SOCK {
        LeaveCriticalSection(cs);
        return -4i64;
    }
    let sock = (*rt).handles[hidx].os_handle as usize;
    let ov = win_aio_alloc_ov(rt, OP_KIND_RECV_FROM, reactor, sock_h, sock as *mut u8);
    LeaveCriticalSection(cs);
    if (ov as usize) == 0 {
        return -9i64;
    }
    (*ov).wsa_buf_len = len as u32;
    (*ov).wsa_buf_ptr = buf;
    (*ov).wsa_flags = 0u32;
    (*ov).from_len = 16;
    let op_id = (*ov).op_id;
    let mut recvd: u32 = 0u32;
    let rc = WSARecvFrom(
        sock,
        address_of_mut((*ov).wsa_buf_len) as *mut u8,
        1u32,
        address_of_mut(recvd),
        address_of_mut((*ov).wsa_flags),
        address_of_mut((*ov).addr_buf[0]),
        address_of_mut((*ov).from_len),
        ov as *mut u8,
        0 as *mut u8
    );
    if rc != 0 {
        let err = WSAGetLastError() as u32;
        if err != 997u32 {
            (*ov).op_kind = OP_KIND_SYNTH;
            (*ov).synth_result = map_win32_error(err);
            let _ = PostQueuedCompletionStatus(iocp, 0u32, KEY_SYNTH, ov as *mut u8);
        }
    }
    op_id as i64
}

pub unsafe fn __ax_host_aio_submit_send_to(
    reactor: i64,
    sock_h: i64,
    buf: *const u8,
    len: usize,
    addr_ipv4: u32,
    port: u16
) -> i64 {
    let rt = win_aio_rt_get();
    if (rt as usize) == 0 || sock_h < 1i64 || (sock_h as usize) > MAX_IOCP_HANDLES {
        return -4i64;
    }
    let cs = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs);
    let iocp = win_aio_get_iocp(rt, reactor);
    let hidx = (sock_h - 1i64) as usize;
    if (iocp as usize) == 0 || (*rt).handles[hidx].in_use == 0u32 || (*rt).handles[hidx].kind != HANDLE_KIND_UDP_SOCK {
        LeaveCriticalSection(cs);
        return -4i64;
    }
    let sock = (*rt).handles[hidx].os_handle as usize;
    let ov = win_aio_alloc_ov(rt, OP_KIND_READ_WRITE, reactor, sock_h, sock as *mut u8);
    LeaveCriticalSection(cs);
    if (ov as usize) == 0 {
        return -9i64;
    }
    (*ov).wsa_buf_len = len as u32;
    (*ov).wsa_buf_ptr = buf as *mut u8;
    fill_sockaddr_in(address_of_mut((*ov).addr_buf[0]), addr_ipv4, port);
    let op_id = (*ov).op_id;
    let mut sent: u32 = 0u32;
    let rc = WSASendTo(
        sock,
        address_of_mut((*ov).wsa_buf_len) as *mut u8,
        1u32,
        address_of_mut(sent),
        0u32,
        address_of((*ov).addr_buf[0]),
        16,
        ov as *mut u8,
        0 as *mut u8
    );
    if rc != 0 {
        let err = WSAGetLastError() as u32;
        if err != 997u32 {
            (*ov).op_kind = OP_KIND_SYNTH;
            (*ov).synth_result = map_win32_error(err);
            let _ = PostQueuedCompletionStatus(iocp, 0u32, KEY_SYNTH, ov as *mut u8);
        }
    }
    op_id as i64
}

pub fn __ax_host_aio_close(reactor: i64, handle: i64) -> i64 {
    unsafe {
        let rt = win_aio_rt_get();
        if (rt as usize) == 0 || handle < 1i64 || (handle as usize) > MAX_IOCP_HANDLES {
            return -4i64;
        }
        let cs = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs);
        let hidx = (handle - 1i64) as usize;
        if (*rt).handles[hidx].in_use == 0u32 {
            LeaveCriticalSection(cs);
            return -4i64;
        }
        let kind = (*rt).handles[hidx].kind;
        let os_h = (*rt).handles[hidx].os_handle;
        (*rt).handles[hidx].in_use = 0u32;
        (*rt).handles[hidx].os_handle = 0 as *mut u8;
        LeaveCriticalSection(cs);

        let _ = reactor;
        if (os_h as usize) != 0 {
            let _ = CancelIoEx(os_h, 0 as *mut u8);
            if kind == HANDLE_KIND_FILE {
                let _ = CloseHandle(os_h);
            } else {
                let _ = closesocket(os_h as usize);
            }
        }
        0i64
    }
}
