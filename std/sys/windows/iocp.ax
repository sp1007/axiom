    }
}

pub fn __ax_host_aio_submit_connect(reactor: i64, addr_ipv4: u32, port: u16) -> i64 {
    unsafe {
        let rt = win_aio_rt_get();
        if (rt as usize) == 0 {
            return -9i64;
        }
        let cs = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs);
        let iocp = win_aio_get_iocp(rt, reactor);
        let wsa_ok = win_aio_ensure_wsa(rt);
        LeaveCriticalSection(cs);
        if (iocp as usize) == 0 {
            return -4i64;
        }
        if !wsa_ok {
            return -9i64;
        }
        let c_sock = WSASocketW(2, 1, 6, 0 as *mut u8, 0u32, 1u32);
        if c_sock == INVALID_SOCKET_VAL {
            return map_win32_error(WSAGetLastError() as u32);
        }
        // ConnectEx requires socket to be bound to local ephemeral port first
        let mut local_sa: [16]u8 = [0u8; 16];
        fill_sockaddr_in(address_of_mut(local_sa[0]), 0u32, 0u16);
        if bind(c_sock, address_of(local_sa[0]), 16) != 0 {
            let err = WSAGetLastError() as u32;
            let _ = closesocket(c_sock);
            return map_win32_error(err);
        }
        let assoc = CreateIoCompletionPort(c_sock as *mut u8, iocp, 0usize, 0u32);
        if (assoc as usize) == 0 {
            let err = GetLastError();
            let _ = closesocket(c_sock);
            return map_win32_error(err);
        }
        EnterCriticalSection(cs);
        win_aio_ensure_ext_fns(rt, c_sock);
        let con_fn_addr = (*rt).connect_ex_fn;
        let c_hid = win_aio_alloc_handle(rt, HANDLE_KIND_TCP_STREAM, reactor, c_sock as *mut u8);
        let ov = if c_hid > 0i64 && con_fn_addr != 0usize {
            win_aio_alloc_ov(rt, OP_KIND_CONNECT, reactor, c_hid, c_sock as *mut u8)
        } else {
            0 as *mut AioOverlapped
        };
        LeaveCriticalSection(cs);
        if (ov as usize) == 0 {
            let _ = closesocket(c_sock);
            return -9i64;
        }
        (*ov).aux_handle_id = c_hid;
        (*ov).aux_socket = c_sock;
        fill_sockaddr_in(address_of_mut((*ov).addr_buf[0]), addr_ipv4, port);
        let op_id = (*ov).op_id;
        let con_fn: fn(usize, *const u8, i32, *mut u8, u32, *mut u32, *mut u8) -> i32 =
            *(address_of(con_fn_addr) as *const fn(usize, *const u8, i32, *mut u8, u32, *mut u32, *mut u8) -> i32);
        let mut sent: u32 = 0u32;
        let ok = con_fn(c_sock, address_of((*ov).addr_buf[0]), 16, 0 as *mut u8, 0u32, address_of_mut(sent), ov as *mut u8);
        if ok == 0 {
            let err = WSAGetLastError() as u32;
            if err != 997u32 {
                (*ov).op_kind = OP_KIND_SYNTH;
                (*ov).synth_result = map_win32_error(err);
                let _ = PostQueuedCompletionStatus(iocp, 0u32, KEY_SYNTH, ov as *mut u8);
            }
        }
        op_id as i64
    }
}

