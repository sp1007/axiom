            return -9i64;
        }
        (*ov).aux_handle_id = a_hid;
        (*ov).aux_socket = a_sock;
        let op_id = (*ov).op_id;
        let acc_fn: fn(usize, usize, *mut u8, u32, u32, u32, *mut u32, *mut u8) -> i32 =
            *(address_of(acc_fn_addr) as *const fn(usize, usize, *mut u8, u32, u32, u32, *mut u32, *mut u8) -> i32);
        let mut bytes_recvd: u32 = 0u32;
        let ok = acc_fn(l_sock, a_sock, address_of_mut((*ov).addr_buf[0]), 0u32, 32u32, 32u32, address_of_mut(bytes_recvd), ov as *mut u8);
        if ok == 0 {
            let err = WSAGetLastError() as u32;
            if err != 997u32 {
                (*ov).op_kind = OP_KIND_SYNTH;
