        }
        let ok = FlushFileBuffers(os_h);
        (*ov).synth_result = if ok != 0 { 0i64 } else { map_win32_error(GetLastError()) };
        let op_id = (*ov).op_id;
        let _ = PostQueuedCompletionStatus(iocp, 0u32, KEY_SYNTH, ov as *mut u8);
