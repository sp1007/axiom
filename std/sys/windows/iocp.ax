            LeaveCriticalSection(cs);
            return -4i64;
        }
        let os_h = (*rt).handles[hidx].os_handle;
        let ov = win_aio_alloc_ov(rt, OP_KIND_SYNTH, reactor, handle, os_h);
        LeaveCriticalSection(cs);
        if (ov as usize) == 0 {
