    }
}

pub fn __ax_host_aio_tcp_bind(reactor: i64, addr_ipv4: u32, port: u16) -> i64 {
    unsafe {
        let rt = win_aio_rt_get();
        if (rt as usize) == 0 {
            return -9i64;
        }
        let cs = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs);
        let iocp = win_aio_get_iocp(rt, reactor);
        let wsa_ok = win_aio_ensure_wsa(rt);
        LeaveCriticalSection(cs);
        if (iocp as usize) == 0 {
            return -4i64;
        }
        if !wsa_ok {
            return -9i64;
        }
        // AF_INET=2, SOCK_STREAM=1, IPPROTO_TCP=6, WSA_FLAG_OVERLAPPED=1
        let sock = WSASocketW(2, 1, 6, 0 as *mut u8, 0u32, 1u32);
        if sock == INVALID_SOCKET_VAL {
            return map_win32_error(WSAGetLastError() as u32);
        }
        let mut sa: [16]u8 = [0u8; 16];
        fill_sockaddr_in(address_of_mut(sa[0]), addr_ipv4, port);
        if bind(sock, address_of(sa[0]), 16) != 0 {
            let err = WSAGetLastError() as u32;
            let _ = closesocket(sock);
            return map_win32_error(err);
        }
        if listen(sock, 128) != 0 {
            let err = WSAGetLastError() as u32;
            let _ = closesocket(sock);
            return map_win32_error(err);
        }
        let assoc = CreateIoCompletionPort(sock as *mut u8, iocp, 0usize, 0u32);
        if (assoc as usize) == 0 {
            let err = GetLastError();
            let _ = closesocket(sock);
            return map_win32_error(err);
        }
        EnterCriticalSection(cs);
        win_aio_ensure_ext_fns(rt, sock);
        let hid = win_aio_alloc_handle(rt, HANDLE_KIND_TCP_LISTENER, reactor, sock as *mut u8);
        LeaveCriticalSection(cs);
        if hid < 0i64 {
            let _ = closesocket(sock);
        }
        hid
    }
}

pub fn __ax_host_aio_socket_local_port(handle: i64) -> i64 {
    unsafe {
        let rt = win_aio_rt_get();
        if (rt as usize) == 0 || handle < 1i64 || (handle as usize) > MAX_IOCP_HANDLES {
            return -4i64;
        }
        let cs = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs);
        let hidx = (handle - 1i64) as usize;
        if (*rt).handles[hidx].in_use == 0u32 {
            LeaveCriticalSection(cs);
            return -4i64;
        }
        let sock = (*rt).handles[hidx].os_handle as usize;
        LeaveCriticalSection(cs);
        let mut sa: [16]u8 = [0u8; 16];
        let mut salen: i32 = 16;
        if getsockname(sock, address_of_mut(sa[0]), address_of_mut(salen)) != 0 {
            return map_win32_error(WSAGetLastError() as u32);
        }
        let p_hi = sa[2] as u64;
        let p_lo = sa[3] as u64;
        ((p_hi << 8u64) | p_lo) as i64
    }
}

