module std.sys.windows.thread

// Native backing of host.thread_* / futex_* on x86_64-windows.
//
// Panic containment (T538, SPEC-32, SPEC-34 AXS-EXEC-055.5): a native panic runs the linker stub
// `axiom_panic`, which writes the message and then calls the process-wide panic hook registered
// through `__ax_panic_hook_set` (a linker-provided setter of the data slot `__ax_panic_hook`) before
// it ends the process with exit code 101. The thread runtime registers win_thread_panic_hook when it is
// created: a panic on a spawned thread marks the slot panicked (join returns Err) and ends only that
// thread; on any other thread the hook returns and the process exits with 101. std/sys/windows/fiber.ax
// replaces the hook with one that first handles a panic on a running user fiber and otherwise calls
// win_thread_panic_contain. The process exit import is never patched, so a user exit code (including 101) always
// ends the process unchanged.

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn CreateThread(
        lpThreadAttributes: *mut u8,
        dwStackSize: usize,
        lpStartAddress: fn(*mut u8) -> u32,
        lpParameter: *mut u8,
        dwCreationFlags: u32,
        lpThreadId: *mut u32
    ) -> *mut u8;
    fn WaitForSingleObject(hHandle: *mut u8, dwMilliseconds: u32) -> u32;
    fn CloseHandle(hObject: *mut u8) -> i32;
    fn GetCurrentThreadId() -> u32;
    fn SwitchToThread() -> i32;
    fn Sleep(dwMilliseconds: u32);
    fn ExitThread(dwExitCode: u32);
    fn InitializeCriticalSection(lpCriticalSection: *mut u8);
    fn EnterCriticalSection(lpCriticalSection: *mut u8);
    fn LeaveCriticalSection(lpCriticalSection: *mut u8);
    fn GetLastError() -> u32;
}

@link("api-ms-win-core-synch-l1-2-0")
extern "system" {
    fn WaitOnAddress(address: *const u8, compareAddress: *const u8, addressSize: usize, dwMilliseconds: u32) -> i32;
    fn WakeByAddressSingle(address: *const u8);
    fn WakeByAddressAll(address: *const u8);
}

// Linker-provided runtime stub (compiler/link/import.ax AXIOM_PANIC_HOOK_SET_CODE): atomically stores
// `hook` (the address of a `fn(*const u8, usize) -> u32`, or 0) into `__ax_panic_hook` and returns the
// previous value. Axiom has no extern data declarations, so the slot is reached through this setter.
extern "C" {
    fn __ax_panic_hook_set(hook: usize) -> usize;
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

@repr(C)
struct WinThreadSlot {
    in_use: u32,
    finished: u32,
    detached: u32,
    joining: u32,
    panicked: u32,
    win_tid: u32,
    generation: u32,
    pad0: u32,
    logical_id: u64,
    os_handle: *mut u8,
    entry: fn(*mut u8) -> i64,
    ctx: *mut u8,
    ret_val: i64,
}

@repr(C)
struct WinThreadRt {
    cs: [6]u64,
    main_win_tid: u32,
    pad0: u32,
    next_logical_id: u64,
    slots: *mut *mut WinThreadSlot,
    slot_cap: usize,
}

// Process-wide thread runtime (T537 process-wide statics); null until the first thread call.
static mut WIN_THREAD_RT: *mut WinThreadRt = 0 as *mut WinThreadRt;

unsafe fn fn_entry_to_addr(f: fn(*mut u8) -> i64) -> usize {
    let tmp: [1]fn(*mut u8) -> i64 = [f];
    *(address_of(tmp[0]) as *const usize)
}

pub unsafe fn win_panic_hook_to_addr(f: fn(*const u8, usize) -> u32) -> usize {
    let tmp: [1]fn(*const u8, usize) -> u32 = [f];
    *(address_of(tmp[0]) as *const usize)
}

// Registers `hook` (address of a `fn(*const u8, usize) -> u32`, 0 to clear; the result is ignored) as the process-wide panic hook
// called by `axiom_panic`; returns the previously registered hook.
pub unsafe fn win_panic_hook_set(hook: usize) -> usize {
    __ax_panic_hook_set(hook)
}

unsafe fn slot_ptr_at(arr: *mut *mut WinThreadSlot, idx: usize) -> *mut *mut WinThreadSlot {
    ((arr as usize) + idx * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot
}

unsafe fn win_rt_peek() -> *mut WinThreadRt {
    WIN_THREAD_RT
}

// Panic containment for spawned threads. Called on the panicking thread by the panic hook: when it is
// a live spawned thread of this runtime, the slot is marked panicked (join returns Err) and the
// thread ends with ExitThread(101). Returns on the main thread or on threads the runtime does not own;
// the caller then lets `axiom_panic` exit the process with 101.
pub unsafe fn win_thread_panic_contain() {
    let rt = WIN_THREAD_RT;
    if (rt as usize) == 0 {
        return;
    }
    let cur_tid = GetCurrentThreadId();
    if cur_tid == (*rt).main_win_tid {
        return;
    }
    let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs_ptr);
    let mut idx: usize = 1;
    while idx < (*rt).slot_cap {
        let s = *slot_ptr_at((*rt).slots, idx);
        if (s as usize) != 0 && (*s).in_use != 0u32 && (*s).finished == 0u32 && (*s).win_tid == cur_tid {
            (*s).panicked = 1u32;
            (*s).ret_val = -101i64;
            (*s).finished = 1u32;
            (*s).win_tid = 0u32;
            if (*s).detached != 0u32 {
                let h = (*s).os_handle;
                (*s).os_handle = 0 as *mut u8;
                (*s).in_use = 0u32;
                LeaveCriticalSection(cs_ptr);
                if (h as usize) != 0 {
                    CloseHandle(h);
                }
            } else {
                let p_ctx = (*s).ctx;
                if (p_ctx as usize) != 0 && *(p_ctx as *const u64) == 0x4158544852504B54u64 {
                    let lw = (p_ctx + 8) as *mut u32;
                    *lw = (*lw) | 1u32;
                }
                LeaveCriticalSection(cs_ptr);
            }
            ExitThread(101u32);
        }
        idx = idx + 1;
    }
    LeaveCriticalSection(cs_ptr);
}

// Panic hook registered by the thread runtime (see the module comment).
fn win_thread_panic_hook(_msg: *const u8, _msg_len: usize) -> u32 {
    unsafe {
        win_thread_panic_contain();
    }
    0u32
}

unsafe fn win_rt_get() -> *mut WinThreadRt {
    let existing = WIN_THREAD_RT;
    if (existing as usize) != 0 {
        return existing;
    }
    let heap = GetProcessHeap();
    if (heap as usize) == 0 {
        return 0 as *mut WinThreadRt;
    }
    let rt = HeapAlloc(heap, 8u32, size_of<WinThreadRt>()) as *mut WinThreadRt;
    if (rt as usize) == 0 {
        return 0 as *mut WinThreadRt;
    }
    let init_cap: usize = 256;
    let slots = HeapAlloc(heap, 8u32, init_cap * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot;
    if (slots as usize) == 0 {
        HeapFree(heap, 0u32, rt as *mut u8);
        return 0 as *mut WinThreadRt;
    }
    InitializeCriticalSection(address_of_mut((*rt).cs[0]) as *mut u8);
    (*rt).main_win_tid = GetCurrentThreadId();
    (*rt).next_logical_id = 2u64;
    (*rt).slots = slots;
    (*rt).slot_cap = init_cap;
    WIN_THREAD_RT = rt;
    // Register the thread hook unless a hook is already set (the fiber hook also covers threads).
    let prev = __ax_panic_hook_set(win_panic_hook_to_addr(win_thread_panic_hook));
    if prev != 0usize {
        let _ = __ax_panic_hook_set(prev);
    }
    rt
}

fn win_thread_trampoline(param: *mut u8) -> u32 {
    unsafe {
        let rt = win_rt_peek();
        let s = param as *mut WinThreadSlot;
        if (rt as usize) == 0 || (s as usize) == 0 {
            return 1u32;
        }
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        (*s).win_tid = GetCurrentThreadId();
        let entry = (*s).entry;
        let ctx = (*s).ctx;
        LeaveCriticalSection(cs_ptr);

        let rv = entry(ctx);

        EnterCriticalSection(cs_ptr);
        (*s).ret_val = rv;
        (*s).finished = 1u32;
        (*s).win_tid = 0u32;
        if (*s).detached != 0u32 {
            let h = (*s).os_handle;
            (*s).os_handle = 0 as *mut u8;
            (*s).in_use = 0u32;
            LeaveCriticalSection(cs_ptr);
            if (h as usize) != 0 {
                CloseHandle(h);
            }
        } else {
            LeaveCriticalSection(cs_ptr);
        }
        0u32
    }
}

unsafe fn win_alloc_slot(rt: *mut WinThreadRt) -> usize {
    let heap = GetProcessHeap();
    let mut idx: usize = 1;
    while idx < (*rt).slot_cap {
        let pp = slot_ptr_at((*rt).slots, idx);
        let mut s = *pp;
        if (s as usize) == 0 {
            s = HeapAlloc(heap, 8u32, size_of<WinThreadSlot>()) as *mut WinThreadSlot;
            if (s as usize) == 0 {
                return 0;
            }
            *pp = s;
            return idx;
        }
        if (*s).in_use == 0u32 {
            return idx;
        }
        idx = idx + 1;
    }
    if (*rt).slot_cap >= 32768 {
        return 0;
    }
    let old_cap = (*rt).slot_cap;
    let new_cap = old_cap * 2;
    let new_arr = HeapAlloc(heap, 8u32, new_cap * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot;
    if (new_arr as usize) == 0 {
        return 0;
    }
    ptr_copy_nonoverlapping<*mut WinThreadSlot>((*rt).slots as *const *mut WinThreadSlot, new_arr, old_cap);
    HeapFree(heap, 0u32, (*rt).slots as *mut u8);
    (*rt).slots = new_arr;
    (*rt).slot_cap = new_cap;
    let s = HeapAlloc(heap, 8u32, size_of<WinThreadSlot>()) as *mut WinThreadSlot;
    if (s as usize) == 0 {
        return 0;
    }
    *slot_ptr_at((*rt).slots, old_cap) = s;
    old_cap
}

pub unsafe fn __ax_host_thread_spawn(entry: fn(*mut u8) -> i64, ctx: *mut u8, stack_size: usize) -> i64 {
    if fn_entry_to_addr(entry) == 0usize {
        return -4i64;
    }
    let rt = win_rt_get();
    if (rt as usize) == 0 {
        return -9i64;
    }
    let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs_ptr);
    let idx = win_alloc_slot(rt);
    if idx == 0 {
        LeaveCriticalSection(cs_ptr);
        return -9i64;
    }
    let s = *slot_ptr_at((*rt).slots, idx);
    let mut gen = (*s).generation + 1u32;
    if gen == 0u32 || gen > 0x7FFFu32 {
        gen = 1u32;
    }
    (*s).in_use = 1u32;
    (*s).finished = 0u32;
    (*s).detached = 0u32;
    (*s).joining = 0u32;
    (*s).panicked = 0u32;
    (*s).win_tid = 0u32;
    (*s).generation = gen;
    (*s).logical_id = (*rt).next_logical_id;
    (*rt).next_logical_id = (*rt).next_logical_id + 1u64;
    (*s).os_handle = 0 as *mut u8;
    (*s).entry = entry;
    (*s).ctx = ctx;
    (*s).ret_val = 0i64;
    if (ctx as usize) != 0 && *(ctx as *const u64) == 0x4158544852504B54u64 {
        *((ctx + 32) as *mut u64) = (*s).logical_id;
    }

    let mut tid: [1]u32 = [0u32];
    let h = CreateThread(0 as *mut u8, stack_size, win_thread_trampoline, s as *mut u8, 0u32, address_of_mut(tid[0]));
    if (h as usize) == 0 {
        (*s).in_use = 0u32;
        LeaveCriticalSection(cs_ptr);
        return -9i64;
    }
    (*s).os_handle = h;
    (*s).win_tid = tid[0];
    let handle_val: i64 = ((gen as i64) << 16) | (idx as i64);
    LeaveCriticalSection(cs_ptr);
    handle_val
}

pub unsafe fn __ax_host_thread_join(h: i64, out_ret: *mut i64) -> i64 {
    if h <= 0i64 {
        return -4i64;
    }
    let rt = win_rt_peek();
    if (rt as usize) == 0 {
        return -4i64;
    }
    let idx = (h & 0xFFFFi64) as usize;
    let gen = ((h >> 16) & 0x7FFFi64) as u32;
    let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs_ptr);
    if idx == 0 || idx >= (*rt).slot_cap {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    let s = *slot_ptr_at((*rt).slots, idx);
    if (s as usize) == 0 || (*s).in_use == 0u32 || (*s).generation != gen || (*s).detached != 0u32 || (*s).joining != 0u32 {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    if (*s).finished == 0u32 && (*s).win_tid == GetCurrentThreadId() {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    (*s).joining = 1u32;
    let os_h = (*s).os_handle;
    LeaveCriticalSection(cs_ptr);

    if (os_h as usize) != 0 {
        WaitForSingleObject(os_h, 0xFFFFFFFFu32);
    }

    EnterCriticalSection(cs_ptr);
    let rv = (*s).ret_val;
    (*s).os_handle = 0 as *mut u8;
    (*s).joining = 0u32;
    (*s).in_use = 0u32;
    LeaveCriticalSection(cs_ptr);

    if (os_h as usize) != 0 {
        CloseHandle(os_h);
    }
    if (out_ret as usize) != 0 {
        *out_ret = rv;
    }
    0i64
}

pub fn __ax_host_thread_detach(h: i64) -> i64 {
    if h <= 0i64 {
        return -4i64;
    }
    unsafe {
        let rt = win_rt_peek();
        if (rt as usize) == 0 {
            return -4i64;
        }
        let idx = (h & 0xFFFFi64) as usize;
        let gen = ((h >> 16) & 0x7FFFi64) as u32;
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        if idx == 0 || idx >= (*rt).slot_cap {
            LeaveCriticalSection(cs_ptr);
            return -4i64;
        }
        let s = *slot_ptr_at((*rt).slots, idx);
        if (s as usize) == 0 || (*s).in_use == 0u32 || (*s).generation != gen || (*s).detached != 0u32 || (*s).joining != 0u32 {
            LeaveCriticalSection(cs_ptr);
            return -4i64;
        }
        if (*s).finished != 0u32 {
            let os_h = (*s).os_handle;
            (*s).os_handle = 0 as *mut u8;
            (*s).in_use = 0u32;
            LeaveCriticalSection(cs_ptr);
            if (os_h as usize) != 0 {
                CloseHandle(os_h);
            }
            return 0i64;
        }
        (*s).detached = 1u32;
        LeaveCriticalSection(cs_ptr);
        0i64
    }
}

pub fn __ax_host_thread_current_id() -> u64 {
    unsafe {
        let cur_tid = GetCurrentThreadId();
        let rt = win_rt_get();
        if (rt as usize) == 0 {
            return if cur_tid == 0u32 { 1u64 } else { cur_tid as u64 };
        }
        if cur_tid == (*rt).main_win_tid {
            return 1u64;
        }
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        let mut idx: usize = 1;
        while idx < (*rt).slot_cap {
            let s = *slot_ptr_at((*rt).slots, idx);
            if (s as usize) != 0 && (*s).in_use != 0u32 && (*s).finished == 0u32 && (*s).win_tid == cur_tid {
                let lid = (*s).logical_id;
                LeaveCriticalSection(cs_ptr);
                return lid;
            }
            idx = idx + 1;
        }
        LeaveCriticalSection(cs_ptr);
        0x8000000000000000u64 | (cur_tid as u64)
    }
}

pub fn __ax_host_thread_yield() {
    unsafe {
        SwitchToThread();
    }
}

pub fn __ax_host_thread_sleep_ns(ns: u64) {
    if ns == 0u64 {
        unsafe { Sleep(0u32); }
        return;
    }
    let mut ms64 = ns / 1_000_000u64;
    if (ns % 1_000_000u64) != 0u64 {
        ms64 = ms64 + 1u64;
    }
    let ms32 = if ms64 >= 0xFFFFFFFEu64 { 0xFFFFFFFEu32 } else { ms64 as u32 };
    unsafe {
        Sleep(ms32);
    }
}

pub unsafe fn __ax_host_futex_wait(addr: *const u32, expected: u32, timeout_ns: u64) -> i64 {
    if (addr as usize) == 0 || ((addr as usize) & 3usize) != 0usize {
        return -4i64;
    }
    let mut timeout_ms: u32 = 0u32;
    if timeout_ns == 0xFFFFFFFFFFFFFFFFu64 {
        timeout_ms = 0xFFFFFFFFu32;
    } else if timeout_ns > 0u64 {
        let mut ms64 = timeout_ns / 1_000_000u64;
        if (timeout_ns % 1_000_000u64) != 0u64 {
            ms64 = ms64 + 1u64;
        }
        timeout_ms = if ms64 >= 0xFFFFFFFEu64 { 0xFFFFFFFEu32 } else { ms64 as u32 };
    }
    let exp_box: [1]u32 = [expected];
    let ok = WaitOnAddress(addr as *const u8, address_of(exp_box[0]) as *const u8, 4usize, timeout_ms);
    if ok != 0 {
        return 0i64;
    }
    if GetLastError() == 1460u32 {
        return -5i64;
    }
    0i64
}

pub unsafe fn __ax_host_futex_wake(addr: *const u32, count: u32) -> i64 {
    if (addr as usize) == 0 || ((addr as usize) & 3usize) != 0usize {
        return -4i64;
    }
    if count == 0u32 {
        return 0i64;
    }
    if count == 1u32 {
        WakeByAddressSingle(addr as *const u8);
        return 1i64;
    }
    WakeByAddressAll(addr as *const u8);
    count as i64
}
