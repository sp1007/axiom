module std.collections.idtable.id_table

use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.arena.arena.Arena
use std.core.arena.arena.arena_new
use std.core.arena.arena.arena_destroy
use std.core.arena.arena.arena_alloc_raw

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// AXH64 v1 deterministic hashing (matching kernel/hash.c and T073)
const AXH_K1: u64 = 0x9E3779B97F4A7C15;
const AXH_K2: u64 = 0xC2B2AE3D27D4EB4F;
const AXH_K3: u64 = 0x165667B19E3779F9;
const AXH_SEED: u64 = 0x27D4EB2F165667C5;
const AXH_M: u64 = 0x9FB21C651E98DF25;

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(a: u64, b: u32) -> u64 { 0 }

fn axh_round(h: u64, w: u64) -> u64 {
    let m = wrapping_mul_u64(rotate_left_u64(wrapping_mul_u64(w, AXH_K2), 31), AXH_K1);
    wrapping_add_u64(wrapping_mul_u64(rotate_left_u64(h ^ m, 27), AXH_K1), AXH_K3)
}

fn axh_fold(h: u64) -> u64 {
    h ^ rotate_left_u64(h, 15) ^ rotate_left_u64(h, 40)
}

fn axh_avalanche(mut h: u64) -> u64 {
    h = wrapping_mul_u64(axh_fold(h), AXH_M);
    h = wrapping_mul_u64(axh_fold(h), AXH_K2);
    axh_fold(h)
}

pub fn ax_hash_u32(v: u32) -> u64 {
    let mut h = AXH_SEED;
    let w = v as u64;
    h = axh_round(h, w);
    h = h ^ (wrapping_mul_u64(4, AXH_K3));
    axh_avalanche(h)
}

pub fn ax_hash_bytes(bytes: *const u8, byte_len: usize) -> u64 {
    let mut h = AXH_SEED;
    let mut offset: usize = 0;
    let mut rem = byte_len;
    while rem >= 8 {
        let mut w: u64 = 0;
        let mut i: usize = 0;
        while i < 8 {
            let b = unsafe { *(bytes + offset + i) } as u64;
            w = w | (b << (8 * i as u32));
            i = i + 1;
        }
        h = axh_round(h, w);
        offset = offset + 8;
        rem = rem - 8;
    }
    if rem > 0 {
        let mut w: u64 = 0;
        let mut i: usize = 0;
        while i < rem {
            let b = unsafe { *(bytes + offset + i) } as u64;
            w = w | (b << (8 * i as u32));
            i = i + 1;
        }
        h = axh_round(h, w);
    }
    h = h ^ (wrapping_mul_u64(byte_len as u64, AXH_K3));
    axh_avalanche(h)
}

// ============================================================================
// Typed ID Newtypes (tasks/0260 ABOOT-54, 0172 AKERNEL-24, 0153 ACKERNEL-20)
// Convention: v == 0 is none / invalid ID; valid ID has v = table_index + 1.
// ============================================================================

pub struct StrId {
    pub v: u32,
}

impl StrId {
    pub fn none() -> StrId { StrId { v: 0 } }
    pub fn is_none(self: view<StrId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<StrId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> StrId { StrId { v: (index + 1) as u32 } }
    pub fn index(self: view<StrId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<StrId>, other: view<StrId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<StrId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> StrId { StrId { v: v } }
}

