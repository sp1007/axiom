module std.io

use std.core.option.Option
use std.core.result.Result
use std.core.host.stdio
use std.core.host.open
use std.core.host.read
use std.core.host.write
use std.core.host.close
use std.core.host.file_size
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub enum IoError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidHandle,
    InvalidData,
    Other(i64),
}

pub fn io_error_from_code(code: i64) -> IoError {
    if code == -1 {
        IoError.NotFound
    } else if code == -2 {
        IoError.PermissionDenied
    } else if code == -3 {
        IoError.AlreadyExists
    } else if code == -4 {
        IoError.InvalidHandle
    } else {
        IoError.Other(code)
    }
}

pub fn print(s: Str) {
    let slen = len(s);
    if slen > 0 {
        let p = unsafe { *(address_of(s) as *const *const u8) };
        let h = stdio(1);
        unsafe {
            write(h, p, slen);
        }
    }
}

pub fn println(s: Str) {
    print(s);
    let nl = "\n";
    let p = unsafe { *(address_of(nl) as *const *const u8) };
    let h = stdio(1);
    unsafe {
        write(h, p, 1);
    }
}

pub fn eprint(s: Str) {
    let slen = len(s);
    if slen > 0 {
        let p = unsafe { *(address_of(s) as *const *const u8) };
        let h = stdio(2);
        unsafe {
            write(h, p, slen);
        }
    }
}

pub fn eprintln(s: Str) {
    eprint(s);
    let nl = "\n";
    let p = unsafe { *(address_of(nl) as *const *const u8) };
    let h = stdio(2);
    unsafe {
        write(h, p, 1);
    }
}

pub struct File {
    pub handle: i64,
    pub is_open: bool,
}

impl Drop for File {
    fn drop(self: mut_view<File>) {
        if self.is_open && (self.handle >= 0) {
            close(self.handle);
            self.is_open = false;
            self.handle = -1;
        }
    }
}

pub fn file_open(path: Str) -> Result<File, IoError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 0u32) };
    if h < 0 {
        Result.Err(io_error_from_code(h))
    } else {
        Result.Ok(File { handle: h, is_open: true })
    }
}

pub fn file_create(path: Str) -> Result<File, IoError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 1u32) };
    if h < 0 {
        Result.Err(io_error_from_code(h))
    } else {
        Result.Ok(File { handle: h, is_open: true })
    }
}

pub fn file_append(path: Str) -> Result<File, IoError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 2u32) };
    if h < 0 {
        Result.Err(io_error_from_code(h))
    } else {
        Result.Ok(File { handle: h, is_open: true })
    }
}

pub fn file_read(f: mut_view<File>, buf: *mut u8, cap: usize) -> Result<usize, IoError> {
    let h = f.handle;
    if !f.is_open || h < 0 {
        return Result.Err(IoError.InvalidHandle);
    }
    let n = unsafe { read(h, buf, cap) };
    if n < 0 {
        Result.Err(io_error_from_code(n))
    } else {
        Result.Ok(n as usize)
    }
}

pub fn file_write(f: mut_view<File>, buf: *const u8, count: usize) -> Result<usize, IoError> {
    let h = f.handle;
    if !f.is_open || h < 0 {
        return Result.Err(IoError.InvalidHandle);
    }
    let n = unsafe { write(h, buf, count) };
    if n < 0 {
        Result.Err(io_error_from_code(n))
    } else {
        Result.Ok(n as usize)
    }
}

pub fn file_size_of(f: view<File>) -> Result<i64, IoError> {
    let h = f.handle;
    if !f.is_open || h < 0 {
        return Result.Err(IoError.InvalidHandle);
    }
    let sz = file_size(h);
    if sz < 0 {
        Result.Err(io_error_from_code(sz))
    } else {
        Result.Ok(sz)
    }
}

pub fn file_close(f: mut_view<File>) -> Result<(), IoError> {
    let h = f.handle;
    if !f.is_open || h < 0 {
        return Result.Err(IoError.InvalidHandle);
    }
    let res = close(h);
    f.is_open = false;
    f.handle = -1;
    if res < 0 {
        Result.Err(io_error_from_code(res))
    } else {
        Result.Ok(())
    }
}

impl File {
    pub fn open(path: Str) -> Result<File, IoError> { file_open(path) }
    pub fn create(path: Str) -> Result<File, IoError> { file_create(path) }
    pub fn append(path: Str) -> Result<File, IoError> { file_append(path) }
    pub fn read(self: mut_view<File>, buf: *mut u8, cap: usize) -> Result<usize, IoError> { file_read(self, buf, cap) }
    pub fn write(self: mut_view<File>, buf: *const u8, count: usize) -> Result<usize, IoError> { file_write(self, buf, count) }
    pub fn file_size(self: view<File>) -> Result<i64, IoError> { file_size_of(self) }
    pub fn close(self: mut_view<File>) -> Result<(), IoError> { file_close(self) }
}

pub fn read_to_string(path: Str) -> Result<String, IoError> {
    let mut f = match file_open(path) {
        Result.Ok(file) => file,
        Result.Err(e) => return Result.Err(e),
    };
    let sz = match file_size_of(view(f)) {
        Result.Ok(s) => s,
        Result.Err(e) => return Result.Err(e),
    };
    if sz <= 0i64 {
        return Result.Ok(string_new());
    }
    let usize_sz = sz as usize;
    let mut s = string_with_capacity(usize_sz);
    let mut total_read: usize = 0;
    while total_read < usize_sz {
        let dst = unsafe { s.ptr + total_read };
        let remaining = usize_sz - total_read;
        let rd = match file_read(mut_view(f), dst, remaining) {
            Result.Ok(n) => n,
            Result.Err(e) => return Result.Err(e),
        };
        if rd == 0 {
            break;
        }
        total_read = total_read + rd;
    }
    s.len = total_read;
    Result.Ok(s)
}

pub fn write_string(path: Str, s: Str) -> Result<(), IoError> {
    let mut f = match file_create(path) {
        Result.Ok(file) => file,
        Result.Err(e) => return Result.Err(e),
    };
    let slen = len(s);
    if slen > 0 {
        let p = unsafe { *(address_of(s) as *const *const u8) };
        let mut total_written: usize = 0;
        while total_written < slen {
            let src = unsafe { p + total_written };
            let remaining = slen - total_written;
            let wr = match file_write(mut_view(f), src, remaining) {
                Result.Ok(n) => n,
                Result.Err(e) => return Result.Err(e),
            };
            if wr == 0 {
                return Result.Err(IoError.Other(-9));
            }
            total_written = total_written + wr;
        }
    }
    Result.Ok(())
}

pub fn write_file(path: Str, bytes: *const u8, count: usize) -> Result<(), IoError> {
    let mut f = match file_create(path) {
        Result.Ok(file) => file,
        Result.Err(e) => return Result.Err(e),
    };
    if count > 0 {
        let mut total_written: usize = 0;
        while total_written < count {
            let src = unsafe { bytes + total_written };
            let remaining = count - total_written;
            let wr = match file_write(mut_view(f), src, remaining) {
                Result.Ok(n) => n,
                Result.Err(e) => return Result.Err(e),
            };
            if wr == 0 {
                return Result.Err(IoError.Other(-9));
            }
            total_written = total_written + wr;
        }
    }
    Result.Ok(())
}
