module std.text.utf8

use std.core.result.Result

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

pub fn utf8_error_position(err: Utf8Error) -> usize {
    match err {
        Utf8Error.InvalidByte(p) => p,
        Utf8Error.Truncated(p) => p,
        Utf8Error.Overlong(p) => p,
        Utf8Error.Surrogate(p) => p,
        Utf8Error.OutOfRange(p) => p,
        Utf8Error.InvalidBoundary(p) => p,
    }
}

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

pub fn char_len_utf8(c: char) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        1
    } else if u <= 0x7FF {
        2
    } else if u <= 0xFFFF {
        3
    } else {
        4
    }
}

pub unsafe fn char_encode_utf8(c: char, dst: *mut u8) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        *dst = u as u8;
        1
    } else if u <= 0x7FF {
        *dst = (0xC0 | (u >> 6)) as u8;
        *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        2
    } else if u <= 0xFFFF {
        *dst = (0xE0 | (u >> 12)) as u8;
        *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        3
    } else {
        *dst = (0xF0 | (u >> 18)) as u8;
        *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        4
    }
}

impl char {
    pub fn len_utf8(self: char) -> usize {
        char_len_utf8(self)
    }

    pub unsafe fn encode_utf8(self: char, dst: *mut u8) -> usize {
        char_encode_utf8(self, dst)
    }
}

pub fn decode_char_at(bytes: view<[u8]>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub fn is_char_boundary(bytes: view<[u8]>, offset: usize) -> bool {
    let n = len(bytes);
    if offset == 0 || offset == n {
        return true;
    }
    if offset > n {
        return false;
    }
    let b = bytes[offset];
    (b & 0xC0) != 0x80
}

pub fn char_count(bytes: view<[u8]>) -> Result<usize, Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    let mut count: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                count = count + 1;
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(count)
}

pub fn validate_utf8(bytes: view<[u8]>) -> Result<(), Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(())
}
