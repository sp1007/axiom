module std.text.utf16

use std.core.result.Result
use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub const REPLACEMENT_CHARACTER: char = '\u{FFFD}';
pub const REPLACEMENT_CODE_UNIT: u16 = 0xFFFDu16;
pub const REPLACEMENT_CODE_POINT: u32 = 0xFFFDu32;

pub enum Utf16Error {
    InvalidUtf8(usize),
    LoneSurrogate(usize),
    Truncated(usize),
}

pub fn utf16_error_position(err: Utf16Error) -> usize {
    match err {
        Utf16Error.InvalidUtf8(p) => p,
        Utf16Error.LoneSurrogate(p) => p,
        Utf16Error.Truncated(p) => p,
    }
}

pub struct DecodeUtf8Result {
    pub ch: char,
    pub len: usize,
}

pub struct DecodeUtf16Result {
    pub ch: char,
    pub len: usize,
}

pub fn is_high_surrogate(u: u16) -> bool {
    u >= 0xD800u16 && u <= 0xDBFFu16
}

pub fn is_low_surrogate(u: u16) -> bool {
    u >= 0xDC00u16 && u <= 0xDFFFu16
}

pub fn is_surrogate(u: u16) -> bool {
    u >= 0xD800u16 && u <= 0xDFFFu16
}

pub fn surrogate_high(cp: u32) -> u16 {
    (0xD800 + ((cp - 0x10000) >> 10)) as u16
}

pub fn surrogate_low(cp: u32) -> u16 {
    (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16
}

pub fn decode_surrogate_pair(high: u16, low: u16) -> char {
    let cp: u32 = 0x10000 + ((((high as u32) - 0xD800) << 10) | (((low as u32) - 0xDC00) & 0x3FF));
    cp as char
}

pub fn char_len_utf16(c: char) -> usize {
    let u = c as u32;
    if u <= 0xFFFF { 1 } else { 2 }
}

pub unsafe fn char_encode_utf16(c: char, dst: *mut u16) -> usize {
    let u = c as u32;
    if u <= 0xFFFF {
        *dst = u as u16;
        1
    } else {
        *dst = surrogate_high(u);
        *(dst + 1) = surrogate_low(u);
        2
    }
}

pub fn char_len_utf8(c: char) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        1
    } else if u <= 0x7FF {
        2
    } else if u <= 0xFFFF {
        3
    } else {
        4
    }
}

pub unsafe fn char_encode_utf8(c: char, dst: *mut u8) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        *dst = u as u8;
        1
    } else if u <= 0x7FF {
        *dst = (0xC0 | (u >> 6)) as u8;
        *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        2
    } else if u <= 0xFFFF {
        *dst = (0xE0 | (u >> 12)) as u8;
        *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        3
    } else {
        *dst = (0xF0 | (u >> 18)) as u8;
        *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        4
    }
}

pub fn decode_utf8_char(bytes: view<[u8]>, offset: usize) -> Result<DecodeUtf8Result, Utf16Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf16Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeUtf8Result { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf16Error.InvalidUtf8(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf16Error.InvalidUtf8(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 4 });
    }
    Result.Err(Utf16Error.InvalidUtf8(offset))
}

pub fn decode_utf16_char(units: view<[u16]>, offset: usize) -> Result<DecodeUtf16Result, Utf16Error> {
    let n = len(units);
    if offset >= n {
        return Result.Err(Utf16Error.Truncated(offset));
    }
    let u0 = units[offset];
    if u0 < 0xD800u16 || u0 > 0xDFFFu16 {
        return Result.Ok(DecodeUtf16Result { ch: u0 as u32 as char, len: 1 });
    }
    if is_high_surrogate(u0) {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
        let u1 = units[offset + 1];
        if is_low_surrogate(u1) {
            let ch = decode_surrogate_pair(u0, u1);
            return Result.Ok(DecodeUtf16Result { ch: ch, len: 2 });
        } else {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
    }
    Result.Err(Utf16Error.LoneSurrogate(offset))
}

pub fn decode_utf16_char_lossy(units: view<[u16]>, offset: usize) -> DecodeUtf16Result {
    let n = len(units);
    if offset >= n {
        return DecodeUtf16Result { ch: '\0', len: 0 };
    }
    let u0 = units[offset];
    if u0 < 0xD800u16 || u0 > 0xDFFFu16 {
        return DecodeUtf16Result { ch: u0 as u32 as char, len: 1 };
    }
    if is_high_surrogate(u0) {
        if offset + 1 < n {
            let u1 = units[offset + 1];
            if is_low_surrogate(u1) {
                return DecodeUtf16Result { ch: decode_surrogate_pair(u0, u1), len: 2 };
            }
        }
        return DecodeUtf16Result { ch: REPLACEMENT_CHARACTER, len: 1 };
    }
    DecodeUtf16Result { ch: REPLACEMENT_CHARACTER, len: 1 }
}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub fn string_free(self: mut_view<String>) {
    if self.ptr as usize != 0 {
        unsafe {
            heap_free(self.ptr, self.cap, 8);
        }
        self.ptr = 0 as *mut u8;
        self.len = 0;
        self.cap = 0;
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = char_len_utf8(c);
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        char_encode_utf8(c, dst);
    }
    s.len = s.len + clen;
}

pub fn string_push_bytes(s: mut_view<String>, bytes: view<[u8]>) {
    let n = len(bytes);
    if n == 0 {
        return;
    }
    let needed = s.len + n;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(s.ptr + s.len + i) = bytes[i];
        }
        i = i + 1;
    }
    s.len = s.len + n;
}

impl String {
    pub fn len(self: view<String>) -> usize { self.len }
    pub fn is_empty(self: view<String>) -> bool { self.len == 0 }
    pub fn as_ptr(self: view<String>) -> *const u8 { self.ptr as *const u8 }
    pub fn push_char(self: mut_view<String>, c: char) { string_push_char(self, c); }
}

pub struct WideString {
    pub ptr: *mut u16,
    pub len: usize,
    pub cap: usize,
}

pub fn wide_string_free(self: mut_view<WideString>) {
    if self.ptr as usize != 0 {
        unsafe {
            heap_free(self.ptr as *mut u8, self.cap * 2, 2);
        }
        self.ptr = 0 as *mut u16;
        self.len = 0;
        self.cap = 0;
    }
}

pub fn wide_string_new() -> WideString {
    WideString {
        ptr: 0 as *mut u16,
        len: 0,
        cap: 0,
    }
}

pub fn wide_string_with_capacity(capacity: usize) -> WideString {
    let alloc_cap = capacity + 1;
    let raw = unsafe { heap_alloc(alloc_cap * 2, 2) };
    let p = raw as *mut u16;
    if p as usize != 0 {
        unsafe {
            *p = 0u16;
        }
    }
    WideString {
        ptr: p,
        len: 0,
        cap: alloc_cap,
    }
}

pub fn wide_string_reserve(s: mut_view<WideString>, additional: usize) {
    let needed = s.len + additional + 1;
    if needed <= s.cap {
        return;
    }
    let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
    if new_cap < needed {
        new_cap = needed;
    }
    let raw = unsafe { heap_alloc(new_cap * 2, 2) };
    let new_ptr = raw as *mut u16;
    if s.len > 0 && s.ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, new_ptr, s.len);
        }
    }
    if s.ptr as usize != 0 {
        unsafe {
            heap_free(s.ptr as *mut u8, s.cap * 2, 2);
        }
    }
    s.ptr = new_ptr;
    s.cap = new_cap;
    if s.ptr as usize != 0 {
        unsafe {
            *(s.ptr + s.len) = 0u16;
        }
    }
}

pub fn wide_string_push(s: mut_view<WideString>, unit: u16) {
    let needed = s.len + 2;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap * 2, 2) };
        let new_ptr = raw as *mut u16;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, new_ptr, s.len);
            }
        }
        if s.ptr as usize != 0 {
            unsafe {
                heap_free(s.ptr as *mut u8, s.cap * 2, 2);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        let p = s.ptr + s.len;
        *p = unit;
        *(p + 1) = 0u16;
    }
    s.len = s.len + 1;
}

pub fn wide_string_push_char(s: mut_view<WideString>, c: char) {
    let u = c as u32;
    let units_needed: usize = if u <= 0xFFFF { 1 } else { 2 };
    let needed = s.len + units_needed + 1;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap * 2, 2) };
        let new_ptr = raw as *mut u16;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, new_ptr, s.len);
            }
        }
        if s.ptr as usize != 0 {
            unsafe {
                heap_free(s.ptr as *mut u8, s.cap * 2, 2);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        let p = s.ptr + s.len;
        if units_needed == 1 {
            *p = u as u16;
            *(p + 1) = 0u16;
        } else {
            *p = surrogate_high(u);
            *(p + 1) = surrogate_low(u);
            *(p + 2) = 0u16;
        }
    }
    s.len = s.len + units_needed;
}

pub fn wide_string_clear(s: mut_view<WideString>) {
    s.len = 0;
    if s.ptr as usize != 0 {
        unsafe {
            *s.ptr = 0u16;
        }
    }
}

pub fn wide_string_get(s: view<WideString>, index: usize) -> Option<u16> {
    if index >= s.len {
        Option.None
    } else {
        let val = unsafe { *(s.ptr + index) };
        Option.Some(val)
    }
}

pub fn wide_string_set_len(s: mut_view<WideString>, new_len: usize) {
    if new_len < s.cap {
        s.len = new_len;
        if s.ptr as usize != 0 {
            unsafe {
                *(s.ptr + new_len) = 0u16;
            }
        }
    }
}

pub fn wide_string_clone(s: view<WideString>) -> WideString {
    if s.len == 0 {
        return wide_string_new();
    }
    let mut res = wide_string_with_capacity(s.len);
    unsafe {
        ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, res.ptr, s.len);
        *(res.ptr + s.len) = 0u16;
    }
    res.len = s.len;
    res
}

pub fn wide_string_eq(a: view<WideString>, b: view<WideString>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ua = unsafe { *(a.ptr + i) };
        let ub = unsafe { *(b.ptr + i) };
        if ua != ub {
            return false;
        }
        i = i + 1;
    }
    true
}

impl WideString {
    pub fn len(self: view<WideString>) -> usize { self.len }
    pub fn capacity(self: view<WideString>) -> usize { self.cap }
    pub fn is_empty(self: view<WideString>) -> bool { self.len == 0 }
    pub fn as_ptr(self: view<WideString>) -> *const u16 { self.ptr as *const u16 }
    pub fn as_mut_ptr(self: mut_view<WideString>) -> *mut u16 { self.ptr }
    pub fn clear(self: mut_view<WideString>) { wide_string_clear(self); }
    pub fn reserve(self: mut_view<WideString>, additional: usize) { wide_string_reserve(self, additional); }
    pub fn push(self: mut_view<WideString>, unit: u16) { wide_string_push(self, unit); }
    pub fn push_char(self: mut_view<WideString>, c: char) { wide_string_push_char(self, c); }
    pub fn get(self: view<WideString>, index: usize) -> Option<u16> { wide_string_get(self, index) }
    pub fn set_len(self: mut_view<WideString>, new_len: usize) { wide_string_set_len(self, new_len); }
    pub fn clone(self: view<WideString>) -> WideString { wide_string_clone(self) }
    pub fn eq(self: view<WideString>, other: view<WideString>) -> bool { wide_string_eq(self, other) }
}

pub fn utf8_to_utf16(bytes: view<[u8]>) -> Result<WideString, Utf16Error> {
    let n = len(bytes);
    let mut ws = wide_string_with_capacity(n);
    let mut offset: usize = 0;
    while offset < n {
        match decode_utf8_char(bytes, offset) {
            Result.Ok(res) => {
                let dec: DecodeUtf8Result = res;
                wide_string_push_char(mut_view(ws), dec.ch);
                offset = offset + dec.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(ws)
}

pub fn utf8_to_utf16_lossy(bytes: view<[u8]>) -> WideString {
    let n = len(bytes);
    let mut ws = wide_string_with_capacity(n);
    let mut offset: usize = 0;
    while offset < n {
        match decode_utf8_char(bytes, offset) {
            Result.Ok(res) => {
                let dec: DecodeUtf8Result = res;
                wide_string_push_char(mut_view(ws), dec.ch);
                offset = offset + dec.len;
            },
            Result.Err(_) => {
                wide_string_push(mut_view(ws), REPLACEMENT_CODE_UNIT);
                offset = offset + 1;
            }
        }
    }
    ws
}



pub fn to_wide_null(bytes: view<[u8]>) -> Result<WideString, Utf16Error> {
    utf8_to_utf16(bytes)
}

pub fn to_wide_null_lossy(bytes: view<[u8]>) -> WideString {
    utf8_to_utf16_lossy(bytes)
}

pub fn utf16_to_utf8(units: view<[u16]>) -> Result<String, Utf16Error> {
    let n = len(units);
    let mut s = string_with_capacity(n * 3);
    let mut offset: usize = 0;
    while offset < n {
        match decode_utf16_char(units, offset) {
            Result.Ok(res) => {
                let dec: DecodeUtf16Result = res;
                string_push_char(mut_view(s), dec.ch);
                offset = offset + dec.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(s)
}

pub fn utf16_to_utf8_lossy(units: view<[u16]>) -> String {
    let n = len(units);
    let mut s = string_with_capacity(n * 3);
    let mut offset: usize = 0;
    while offset < n {
        let res = decode_utf16_char_lossy(units, offset);
        if res.len == 0 {
            break;
        }
        string_push_char(mut_view(s), res.ch);
        offset = offset + res.len;
    }
    s
}

pub unsafe fn utf16_null_len(ptr: *const u16) -> usize {
    if ptr as usize == 0 { return 0; }
    let mut count: usize = 0;
    while *(ptr + count) != 0u16 {
        count = count + 1;
    }
    count
}

pub unsafe fn utf16_ptr_to_utf8(ptr: *const u16, total_len: usize) -> Result<String, Utf16Error> {
    let mut s = string_with_capacity(total_len * 3);
    let mut offset: usize = 0;
    while offset < total_len {
        let u0 = *(ptr + offset);
        if u0 < 0xD800u16 || u0 > 0xDFFFu16 {
            string_push_char(mut_view(s), u0 as u32 as char);
            offset = offset + 1;
        } else if is_high_surrogate(u0) {
            if offset + 1 >= total_len {
                return Result.Err(Utf16Error.LoneSurrogate(offset));
            }
            let u1 = *(ptr + offset + 1);
            if is_low_surrogate(u1) {
                let ch = decode_surrogate_pair(u0, u1);
                string_push_char(mut_view(s), ch);
                offset = offset + 2;
            } else {
                return Result.Err(Utf16Error.LoneSurrogate(offset));
            }
        } else {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
    }
    Result.Ok(s)
}

pub unsafe fn utf16_ptr_to_utf8_lossy(ptr: *const u16, total_len: usize) -> String {
    let mut s = string_with_capacity(total_len * 3);
    let mut offset: usize = 0;
    while offset < total_len {
        let u0 = *(ptr + offset);
        if u0 < 0xD800u16 || u0 > 0xDFFFu16 {
            string_push_char(mut_view(s), u0 as u32 as char);
            offset = offset + 1;
        } else if is_high_surrogate(u0) {
            if offset + 1 < total_len {
                let u1 = *(ptr + offset + 1);
                if is_low_surrogate(u1) {
                    let ch = decode_surrogate_pair(u0, u1);
                    string_push_char(mut_view(s), ch);
                    offset = offset + 2;
                } else {
                    string_push_char(mut_view(s), REPLACEMENT_CHARACTER);
                    offset = offset + 1;
                }
            } else {
                string_push_char(mut_view(s), REPLACEMENT_CHARACTER);
                offset = offset + 1;
            }
        } else {
            string_push_char(mut_view(s), REPLACEMENT_CHARACTER);
            offset = offset + 1;
        }
    }
    s
}

pub unsafe fn utf16_null_to_utf8(ptr: *const u16) -> Result<String, Utf16Error> {
    let n_units = utf16_null_len(ptr);
    utf16_ptr_to_utf8(ptr, n_units)
}

pub unsafe fn utf16_null_to_utf8_lossy(ptr: *const u16) -> String {
    let n_units = utf16_null_len(ptr);
    utf16_ptr_to_utf8_lossy(ptr, n_units)
}
