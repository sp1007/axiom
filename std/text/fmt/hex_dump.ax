module std.text.fmt.hex_dump

use std.text.string.String
use std.text.string.string_new
use std.text.string.string_push_char
use std.text.string.string_push_str
use std.text.fmt.int.format_u64_into

fn hex_nibble(n: u8) -> char {
    if n < 10 {
        (b'0' + n) as char
    } else {
        (b'a' + (n - 10)) as char
    }
}

pub fn write_hex_dump(out: mut_view<String>, bytes: view<[u8]>) {
    let n = len(bytes);
    if n == 0 {
        return;
    }
    let mut offset: usize = 0;
    while offset < n {
        // 8-digit offset
        format_u64_into(mut_view(*out), offset as u64, 16, 8, true);
        string_push_char(mut_view(*out), ' ');
        string_push_char(mut_view(*out), ' ');

        let line_len = if offset + 16 <= n { 16 } else { n - offset };

        // Hex section (16 slots)
        let mut slot: usize = 0;
        while slot < 16 {
            if slot < line_len {
                let b = bytes[offset + slot];
                string_push_char(mut_view(*out), hex_nibble((b >> 4) & 0x0Fu8));
                string_push_char(mut_view(*out), hex_nibble(b & 0x0Fu8));
            } else {
                string_push_char(mut_view(*out), ' ');
                string_push_char(mut_view(*out), ' ');
            }

            if slot < 15 {
                string_push_char(mut_view(*out), ' ');
                if slot == 7 {
                    string_push_char(mut_view(*out), ' ');
                }
            }
            slot = slot + 1;
        }

        string_push_char(mut_view(*out), ' ');
        string_push_char(mut_view(*out), ' ');

        // ASCII section
        string_push_char(mut_view(*out), '|');
        let mut i: usize = 0;
        while i < line_len {
            let b = bytes[offset + i];
            if b >= 0x20u8 && b <= 0x7Eu8 {
                string_push_char(mut_view(*out), b as char);
            } else {
                string_push_char(mut_view(*out), '.');
            }
            i = i + 1;
        }
        string_push_char(mut_view(*out), '|');
        string_push_char(mut_view(*out), '\n');

        offset = offset + 16;
    }
}

pub fn hex_dump(bytes: view<[u8]>) -> String {
    let mut s = string_new();
    write_hex_dump(mut_view(s), bytes);
    s
}
