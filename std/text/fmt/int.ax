pub fn format_u8_dec(val: u8) -> String { format_u8(val) }
pub fn format_u16_dec(val: u16) -> String { format_u16(val) }
pub fn format_u32_dec(val: u32) -> String { format_u32(val) }
pub fn format_u64_dec(val: u64) -> String { format_u64(val) }
