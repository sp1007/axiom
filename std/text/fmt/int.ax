    format_usize_into(mut_view(s), val, 10, 0, false);
    s
}

pub fn format_i8(val: i8) -> String {
    let mut s = string_new();
    format_i8_into(mut_view(s), val, 10, 0, false);
    s
}
pub fn format_i16(val: i16) -> String {
