pub fn format_i8_dec(val: i8) -> String { format_i8(val) }
pub fn format_i16_dec(val: i16) -> String { format_i16(val) }
pub fn format_i32_dec(val: i32) -> String { format_i32(val) }
pub fn format_i64_dec(val: i64) -> String { format_i64(val) }
pub fn format_isize_dec(val: isize) -> String { format_isize(val) }

