module std.text.chars

use std.core.option.Option
use std.core.result.Result

@lang("Iterator")
pub trait Iterator {
    type Item;
    fn next(self: mut_view<Self>) -> Option<Self.Item>;
}

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

fn get_str_len(s: view<Str>) -> usize {
    len(*s)
}

fn get_str_byte(s: view<Str>, idx: usize) -> u8 {
    let raw = *s;
    raw[idx]
}

pub fn decode_str_char_at(s: view<Str>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = get_str_len(s);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = get_str_byte(s, offset);
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = get_str_byte(s, offset + 1);
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = get_str_byte(s, offset + 1);
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = get_str_byte(s, offset + 2);
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = get_str_byte(s, offset + 1);
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = get_str_byte(s, offset + 2);
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = get_str_byte(s, offset + 3);
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub struct Chars {
    pub s: Str,
    pub offset: usize,
}

impl Iterator for Chars {
    type Item = char;
    fn next(self: mut_view<Chars>) -> Option<char> {
        let n = get_str_len(view(self.s));
        if self.offset >= n {
            return Option.None;
        }
        match decode_str_char_at(view(self.s), self.offset) {
            Result.Ok(res) => {
                self.offset = self.offset + res.len;
                Option.Some(res.ch)
            },
            Result.Err(e) => {
                self.offset = self.offset + 1;
                Option.Some('\u{FFFD}')
            }
        }
    }
}

impl Chars {
    pub fn count(self: Chars) -> usize {
        let mut cnt: usize = 0;
        let mut cur = self;
        for c in cur {
            cnt = cnt + 1;
        }
        cnt
    }
}

pub struct CharIndex {
    pub index: usize,
    pub ch: char,
}

pub struct CharIndices {
    pub s: Str,
    pub offset: usize,
}

impl Iterator for CharIndices {
    type Item = CharIndex;
    fn next(self: mut_view<CharIndices>) -> Option<CharIndex> {
        let n = get_str_len(view(self.s));
        if self.offset >= n {
            return Option.None;
        }
        let cur_offset = self.offset;
        match decode_str_char_at(view(self.s), cur_offset) {
            Result.Ok(res) => {
                self.offset = cur_offset + res.len;
                Option.Some(CharIndex { index: cur_offset, ch: res.ch })
            },
            Result.Err(e) => {
                self.offset = cur_offset + 1;
                Option.Some(CharIndex { index: cur_offset, ch: '\u{FFFD}' })
            }
        }
    }
}

impl Str {
    pub fn chars(self: view<Str>) -> Chars {
        Chars { s: *self, offset: 0 }
    }

    pub fn char_indices(self: view<Str>) -> CharIndices {
        CharIndices { s: *self, offset: 0 }
    }
}
