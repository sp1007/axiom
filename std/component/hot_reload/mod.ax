// =============================================================================
// 1. Originating Allocator VTable & ComponentBox<T> (AXS-COMP-021)
// =============================================================================

@repr(C)
pub struct AllocatorVTable {
    pub deallocate: fn(*mut u8, *mut u8, usize, usize) -> (),
    pub reallocate: fn(*mut u8, *mut u8, usize, usize, usize) -> *mut u8,
}

@repr(C)
pub struct ComponentBox<T> {
    pub ptr: *mut T,
    pub allocator_vtable: *const AllocatorVTable,
    pub epoch_token: u64,
}

pub fn component_box_new<T>(val_ptr: *mut T, vt: *const AllocatorVTable, epoch_token: u64) -> ComponentBox<T> {
    ComponentBox {
        ptr: val_ptr,
        allocator_vtable: vt,
        epoch_token: epoch_token,
    }
}

// Drops a ComponentBox through its originating AllocatorVTable (AXS-COMP-021 §3)
// Refuses deallocation if allocator_vtable is null or invalid
pub fn component_box_drop_checked(
    allocator_vtable: *const AllocatorVTable,
    ptr: *mut u8,
    size: usize,
    align: usize
) -> u32 {
    let _ = ptr
    let _ = size
    let _ = align
    if (allocator_vtable as usize) == 0usize {
        return AX_COMP_CROSS_ALLOCATOR_VIOLATION
    }
    0u32
}

// =============================================================================
// 2. Generational Handle Tables & ComponentHandle<T> (AXS-COMP-022, AXS-COMP-041)
// =============================================================================

@repr(C)
@derive(Copy)
pub struct ComponentHandle<T> {
    pub index: u32,
    pub generation: u32,
    pub epoch_id: u32,
}

pub fn component_handle_new<T>(idx: u32, gen: u32, epoch: u32) -> ComponentHandle<T> {
    ComponentHandle {
        index: idx,
        generation: gen,
        epoch_id: epoch,
    }
}

@derive(Copy)
pub struct HandleSlot<T> {
    pub generation: u32,
    pub epoch_id: u32,
    pub is_occupied: bool,
    pub value: T,
}

pub struct ComponentHandleTable<T> {
    pub slots: [16]HandleSlot<T>,
    pub capacity: usize,
    pub count: usize,
    pub current_epoch: u32,
}

pub fn handle_table_new<T>(epoch_id: u32, default_val: T) -> ComponentHandleTable<T> {
    let empty_slot = HandleSlot {
        generation: 1u32,
        epoch_id: epoch_id,
        is_occupied: false,
        value: default_val,
    }
    ComponentHandleTable {
        slots: [empty_slot, empty_slot, empty_slot, empty_slot,
                empty_slot, empty_slot, empty_slot, empty_slot,
                empty_slot, empty_slot, empty_slot, empty_slot,
                empty_slot, empty_slot, empty_slot, empty_slot],
        capacity: 16usize,
        count: 0usize,
        current_epoch: epoch_id,
    }
}

// Inserts an item into the generational handle table, returning a ComponentHandle
pub fn handle_table_insert<T>(tbl: mut_view<ComponentHandleTable<T>>, val: T) -> ComponentHandle<T> {
    let mut target_idx: usize = 16usize
    let mut i: usize = 0usize
    while i < tbl.capacity {
        if !tbl.slots[i].is_occupied {
            target_idx = i
            i = tbl.capacity
        } else {
            i = i + 1usize
        }
    }
    if target_idx >= tbl.capacity {
        return ComponentHandle { index: 0xFFFFFFFFu32, generation: 0u32, epoch_id: 0u32 }
    }

    tbl.slots[target_idx].epoch_id = tbl.current_epoch
    tbl.slots[target_idx].is_occupied = true
    tbl.slots[target_idx].value = val
    tbl.count = tbl.count + 1usize

    ComponentHandle {
        index: target_idx as u32,
        generation: tbl.slots[target_idx].generation,
        epoch_id: tbl.current_epoch,
    }
}

// Retrieves item from slot table with deterministic generation & epoch safety check (AXS-COMP-022 §3)
pub fn handle_table_get<T>(
    tbl: view<ComponentHandleTable<T>>,
    handle: ComponentHandle<T>,
    out_val: mut_view<T>
) -> u32 {
    let idx = handle.index as usize
    if idx >= tbl.capacity {
        return AX_COMP_STALE_HANDLE
    }
    let slot = tbl.slots[idx]
    if !slot.is_occupied {
        return AX_COMP_STALE_HANDLE
    }
    if slot.generation != handle.generation {
        return AX_COMP_STALE_HANDLE
    }
    if slot.epoch_id != handle.epoch_id || handle.epoch_id != tbl.current_epoch {
        return AX_COMP_STALE_HANDLE
    }

    *out_val = slot.value
    0u32
}

// Releases slot and increments generation to invalidate any stale handle references
pub fn handle_table_release<T>(
    tbl: mut_view<ComponentHandleTable<T>>,
    handle: ComponentHandle<T>
) -> u32 {
    let idx = handle.index as usize
    if idx >= tbl.capacity {
        return AX_COMP_STALE_HANDLE
    }
    if !tbl.slots[idx].is_occupied {
        return AX_COMP_STALE_HANDLE
    }
    if tbl.slots[idx].generation != handle.generation || tbl.slots[idx].epoch_id != handle.epoch_id {
        return AX_COMP_STALE_HANDLE
    }

    tbl.slots[idx].is_occupied = false
    tbl.slots[idx].generation = tbl.slots[idx].generation + 1u32
    if tbl.count > 0usize {
        tbl.count = tbl.count - 1usize
    }
    0u32
}

// Advances the handle table's current epoch token and migrates active slots (AXS-COMP-035 §2)
pub fn handle_table_advance_epoch<T>(tbl: mut_view<ComponentHandleTable<T>>, new_epoch: u32) {
    tbl.current_epoch = new_epoch
    let mut i: usize = 0usize
    while i < tbl.capacity {
        if tbl.slots[i].is_occupied {
            tbl.slots[i].epoch_id = new_epoch
        }
        i = i + 1usize
    }
}

// =============================================================================
// 3. Epoch Tracker & Component Lease System (AXS-COMP-023, AXS-COMP-024)
// =============================================================================

pub const LEASE_KIND_BORROW: u32 = 1u32
pub const LEASE_KIND_TASK: u32 = 2u32
pub const LEASE_KIND_CALLBACK: u32 = 3u32
pub const LEASE_KIND_GPU_FENCE: u32 = 4u32

pub const STATUS_ACTIVE: u32 = 1u32
pub const STATUS_QUIESCING: u32 = 2u32
pub const STATUS_RETIRED: u32 = 3u32
pub const STATUS_UNLOADED: u32 = 4u32

@repr(C)
@derive(Copy)
pub struct EpochTracker {
    pub epoch_id: u32,
    pub active_leases: u64,
    pub status: u32,
    pub active_borrows: u32,
    pub active_tasks: u32,
    pub active_callbacks: u32,
    pub active_gpu_fences: u32,
}

pub fn epoch_tracker_new(epoch: u32) -> EpochTracker {
    EpochTracker {
        epoch_id: epoch,
        active_leases: 0u64,
        status: STATUS_ACTIVE,
        active_borrows: 0u32,
        active_tasks: 0u32,
        active_callbacks: 0u32,
        active_gpu_fences: 0u32,
    }
}

@repr(C)
@derive(Copy)
pub struct ComponentLease {
    pub epoch_id: u32,
    pub lease_kind: u32,
    pub lease_id: u64,
}

pub fn component_lease_zero() -> ComponentLease {
    ComponentLease { epoch_id: 0u32, lease_kind: 0u32, lease_id: 0u64 }
}

// Acquires an epoch lease: protects code/data from physical unmapping while active
pub fn epoch_tracker_acquire_lease(
    trk: mut_view<EpochTracker>,
    kind: u32,
    lease_id: u64,
    out_lease: mut_view<ComponentLease>
) -> u32 {
    if trk.status == STATUS_QUIESCING || trk.status == STATUS_RETIRED || trk.status == STATUS_UNLOADED {
        return AX_COMP_COMPONENT_QUIESCING
    }
    trk.active_leases = trk.active_leases + 1u64
    if kind == LEASE_KIND_BORROW {
        trk.active_borrows = trk.active_borrows + 1u32
    } else if kind == LEASE_KIND_TASK {
        trk.active_tasks = trk.active_tasks + 1u32
    } else if kind == LEASE_KIND_CALLBACK {
        trk.active_callbacks = trk.active_callbacks + 1u32
    } else if kind == LEASE_KIND_GPU_FENCE {
        trk.active_gpu_fences = trk.active_gpu_fences + 1u32
    }

    out_lease.epoch_id = trk.epoch_id
    out_lease.lease_kind = kind
    out_lease.lease_id = lease_id
    0u32
}

// Releases an active epoch lease
pub fn epoch_tracker_release_lease(
    trk: mut_view<EpochTracker>,
    lease: ComponentLease
) -> u32 {
    if trk.active_leases > 0u64 {
        trk.active_leases = trk.active_leases - 1u64
    }
    if lease.lease_kind == LEASE_KIND_BORROW && trk.active_borrows > 0u32 {
        trk.active_borrows = trk.active_borrows - 1u32
    } else if lease.lease_kind == LEASE_KIND_TASK && trk.active_tasks > 0u32 {
        trk.active_tasks = trk.active_tasks - 1u32
    } else if lease.lease_kind == LEASE_KIND_CALLBACK && trk.active_callbacks > 0u32 {
        trk.active_callbacks = trk.active_callbacks - 1u32
    } else if lease.lease_kind == LEASE_KIND_GPU_FENCE && trk.active_gpu_fences > 0u32 {
        trk.active_gpu_fences = trk.active_gpu_fences - 1u32
    }
    0u32
}

// Unload safety check: strictly blocks physical unload if active_leases > 0 (AXS-COMP-023 §3)
pub fn epoch_tracker_validate_unload(trk: view<EpochTracker>) -> u32 {
    if trk.active_leases > 0u64 {
        return AX_COMP_UNLOAD_ACTIVE_LEASES
    }
    0u32
}

// Detaches all ephemeral callbacks during Quiesce phase (AXS-COMP-031 §3)
pub fn epoch_tracker_detach_callbacks(trk: mut_view<EpochTracker>) {
    let cb_count = trk.active_callbacks as u64
    if trk.active_leases >= cb_count {
        trk.active_leases = trk.active_leases - cb_count
    } else {
        trk.active_leases = 0u64
    }
    trk.active_callbacks = 0u32
}

// =============================================================================
// 4. Hot-Reload State Snapshot & Migration Engine (AXS-COMP-032, AXS-COMP-034)
// =============================================================================

@repr(C)
@derive(Copy)
pub struct ComponentStateSnapshot {
    pub schema_id: StateSchemaId,
    pub schema_version: u32,
    pub state_val_1: u64,
    pub state_val_2: u64,
    pub payload_size: usize,
}

pub fn component_state_snapshot_new(
    schema_id: StateSchemaId,
    version: u32,
    v1: u64,
    v2: u64,
    sz: usize
) -> ComponentStateSnapshot {
    ComponentStateSnapshot {
        schema_id: schema_id,
        schema_version: version,
        state_val_1: v1,
        state_val_2: v2,
        payload_size: sz,
    }
}

@repr(C)
@derive(Copy)
pub struct MigrationHook {
    pub from_version: u32,
    pub to_version: u32,
    pub is_registered: bool,
    pub should_fail: bool,
}

pub fn migration_hook_default(from_ver: u32, to_ver: u32) -> MigrationHook {
    MigrationHook {
        from_version: from_ver,
        to_version: to_ver,
        is_registered: true,
        should_fail: false,
    }
}

// Evaluates state migration: Zero-Copy Fast-Path vs Registered Schema Migration Hook (AXS-COMP-034)
pub fn migrate_state_snapshot(
    snapshot: ComponentStateSnapshot,
    candidate_schema_id: StateSchemaId,
    candidate_version: u32,
    hook: MigrationHook,
    out_migrated: mut_view<ComponentStateSnapshot>
) -> u32 {
    // 1. Schema Identity Fast Path (AXS-COMP-034 §1): zero copy when StateSchemaId matches exactly
    if state_schema_id_eq(snapshot.schema_id, candidate_schema_id) {
        *out_migrated = snapshot
        return 0u32
    }

    // 2. Schema Evolution: requires valid registered migration hook (AXS-COMP-034 §2)
    if !hook.is_registered || hook.from_version != snapshot.schema_version || hook.to_version != candidate_version {
        return AX_COMP_HOT_RELOAD_SCHEMA_MISMATCH
    }

    // 3. Migration failure simulation (AXS-COMP-034 §3)
    if hook.should_fail {
        return AX_COMP_HOT_RELOAD_MIGRATION_FAILED
    }

    // Successful deterministic migration
    out_migrated.schema_id = candidate_schema_id
    out_migrated.schema_version = candidate_version
    out_migrated.state_val_1 = snapshot.state_val_1
    out_migrated.state_val_2 = snapshot.state_val_2 + 1000u64 // Deterministic transformation
    out_migrated.payload_size = snapshot.payload_size + 8usize

    0u32
}

// =============================================================================
// 5. 5-Phase Transactional HotReloadManager & Rollback Coordinator (AXS-COMP-030..037)
// =============================================================================

pub struct HotReloadCandidate {
    pub epoch_id: u32,
    pub desc: DiscoveredComponent,
    pub schema_id: StateSchemaId,
    pub schema_version: u32,
    pub migration_hook: MigrationHook,
    pub is_staged: bool,
}

pub fn hot_reload_candidate_new(
    epoch: u32,
    desc: DiscoveredComponent,
    schema_id: StateSchemaId,
    ver: u32,
    hook: MigrationHook
) -> HotReloadCandidate {
    HotReloadCandidate {
        epoch_id: epoch,
        desc: desc,
        schema_id: schema_id,
        schema_version: ver,
        migration_hook: hook,
        is_staged: false,
    }
}

@derive(Copy)
pub struct HotReloadManager {
    pub host: ComponentHost,
    pub active_epoch: u32,
    pub active_tracker: EpochTracker,
    pub retired_tracker: EpochTracker,
    pub has_retired_epoch: bool,
    pub current_state: ComponentStateSnapshot,
    pub quiesce_timeout_ms: u64,
    pub reload_history_count: u32,
}

pub fn hot_reload_manager_new(
    host: ComponentHost,
    initial_epoch: u32,
    initial_state: ComponentStateSnapshot
) -> HotReloadManager {
    HotReloadManager {
        host: host,
        active_epoch: initial_epoch,
        active_tracker: epoch_tracker_new(initial_epoch),
        retired_tracker: epoch_tracker_new(0u32),
        has_retired_epoch: false,
        current_state: initial_state,
        quiesce_timeout_ms: 5000u64,
        reload_history_count: 0u32,
    }
}

// 5-Phase Hot-Reload Coordinator with Full Transactional Rollback Guarantee:
// Phase 1: Quiesce (drain active leases, detach callbacks)
// Phase 2: ExportState (capture typed snapshot)
// Phase 3: LoadNewEpoch (stage candidate alongside active epoch, verify manifest)
// Phase 4: MigrateState (zero-copy fast-path or migration hook execution)
// Phase 5: Resume & Atomic Commit (advance active epoch, retire old epoch)
// Any error in Phases 1..4 triggers clean eviction of candidate & zero-state-loss rollback!
pub fn hot_reload_execute_transaction(
    mgr: mut_view<HotReloadManager>,
    candidate: mut_view<HotReloadCandidate>,
    query: view<ComponentQuery>,
    simulated_drain_success: bool
) -> u32 {
    // -------------------------------------------------------------------------
    // Phase 1: Quiescence Protocol (AXS-COMP-031)
    // -------------------------------------------------------------------------
    mgr.active_tracker.status = STATUS_QUIESCING
    if mgr.active_tracker.active_leases > 0u64 {
        if !simulated_drain_success {
            // Leases failed to drain within timeout: abort and resume active epoch
            mgr.active_tracker.status = STATUS_ACTIVE
            return AX_COMP_QUIESCE_TIMEOUT
        }
        // Drain succeeded
        mgr.active_tracker.active_leases = 0u64
        mgr.active_tracker.active_borrows = 0u32
        mgr.active_tracker.active_tasks = 0u32
    }
    // Detach callbacks so they don't fire during migration
    epoch_tracker_detach_callbacks(mut_view(mgr.active_tracker))

    // -------------------------------------------------------------------------
    // Phase 2: State Export (AXS-COMP-032)
    // -------------------------------------------------------------------------
    let exported_snapshot = mgr.current_state

    // -------------------------------------------------------------------------
    // Phase 3: Stage Candidate & Verify Manifest (AXS-COMP-033)
    // -------------------------------------------------------------------------
    candidate.is_staged = true
    let neg_rc = component_host_negotiate(mut_view(mgr.host), view(candidate.desc), query)
    if neg_rc != 0u32 {
        // Validation failed: roll back, un-quiesce active epoch, evict candidate
        candidate.is_staged = false
        mgr.active_tracker.status = STATUS_ACTIVE
        return neg_rc
    }

    // -------------------------------------------------------------------------
    // Phase 4: State Schema Verification & Migration (AXS-COMP-034)
    // -------------------------------------------------------------------------
    let mut new_snapshot = component_state_snapshot_new(
        state_schema_id_zero(), 0u32, 0u64, 0u64, 0usize
    )
    let mig_rc = migrate_state_snapshot(
        exported_snapshot,
        candidate.schema_id,
        candidate.schema_version,
        candidate.migration_hook,
        mut_view(new_snapshot)
    )
    if mig_rc != 0u32 {
        // Migration failed: evict candidate and roll back with zero state loss! (AXS-COMP-036)
        candidate.is_staged = false
        mgr.active_tracker.status = STATUS_ACTIVE
        return mig_rc
    }

    // -------------------------------------------------------------------------
    // Phase 5: Atomic Resume & Activation (AXS-COMP-035)
    // -------------------------------------------------------------------------
    // 1. Commit new migrated state
    mgr.current_state = new_snapshot

    // 2. Transition active epoch to Retired
    mgr.retired_tracker = mgr.active_tracker
    mgr.retired_tracker.status = STATUS_RETIRED
    mgr.has_retired_epoch = true

    // 3. Activate new epoch
    mgr.active_epoch = candidate.epoch_id
    mgr.active_tracker = epoch_tracker_new(candidate.epoch_id)
    mgr.active_tracker.status = STATUS_ACTIVE

    // 4. Candidate is now active; commit complete
    candidate.is_staged = false
    mgr.reload_history_count = mgr.reload_history_count + 1u32

    0u32
}

// Deferred Retirement Unmapping: physically unloads retired epoch once active_leases == 0 (AXS-COMP-037)
pub fn hot_reload_try_unmap_retired(mgr: mut_view<HotReloadManager>) -> u32 {
    if !mgr.has_retired_epoch {
        return 0u32
    }
    let unload_rc = epoch_tracker_validate_unload(view(mgr.retired_tracker))
    if unload_rc != 0u32 {
        return unload_rc // Strictly blocked while active_leases > 0!
    }
    mgr.retired_tracker.status = STATUS_UNLOADED
    mgr.has_retired_epoch = false
    0u32
}
