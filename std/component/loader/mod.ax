// Axiom Standard Library — Dynamic Component Loader, SemVer & Capability Negotiator (std/component/loader/mod.ax)
// Implements SPEC-115 §§1..2 & §5 (AXS-COMP-001..006, AXS-COMP-010..015, AXS-COMP-040; REQ-ECO-8734, INV-COMP-002).

module std.component.loader

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// =============================================================================
// 1. Diagnostic Codes & Component Constants (SPEC-115 §6, AXS-COMP-050)
// =============================================================================

pub const AX_COMP_MISSING_ENTRY_POINT: u32 = 230u32
pub const AX_COMP_MISSING_MANIFEST: u32 = 231u32
pub const AX_COMP_CORRUPT_MANIFEST: u32 = 232u32
pub const AX_COMP_DUPLICATE_REGISTRATION: u32 = 233u32
pub const AX_COMP_TARGET_MISMATCH: u32 = 234u32
pub const AX_COMP_VERSION_INCOMPATIBLE: u32 = 235u32
pub const AX_COMP_ABI_MISMATCH: u32 = 236u32
pub const AX_COMP_CAPABILITY_DENIED: u32 = 237u32
pub const AX_COMP_RAW_POINTER_ESCAPE: u32 = 238u32
pub const AX_COMP_CROSS_ALLOCATOR_VIOLATION: u32 = 239u32
pub const AX_COMP_STALE_HANDLE: u32 = 240u32
pub const AX_COMP_UNLOAD_ACTIVE_LEASES: u32 = 241u32
pub const AX_COMP_QUIESCE_TIMEOUT: u32 = 242u32
pub const AX_COMP_HOT_RELOAD_SCHEMA_MISMATCH: u32 = 243u32
pub const AX_COMP_HOT_RELOAD_MIGRATION_FAILED: u32 = 244u32
pub const AX_COMP_CAPABILITY_REVOKED: u32 = 245u32
pub const AX_COMP_COMPONENT_QUIESCING: u32 = 246u32
pub const AX_COMP_INTERFACE_NOT_FOUND: u32 = 247u32

// Capability bitmask flags (AXS-COMP-013)
pub const CAP_HEAP_ALLOCATION: u32 = 0x0001u32
pub const CAP_FS_READ: u32 = 0x0002u32
pub const CAP_FS_WRITE: u32 = 0x0004u32
pub const CAP_NET_CONNECT: u32 = 0x0008u32
pub const CAP_CONCURRENCY: u32 = 0x0010u32
pub const CAP_GPU: u32 = 0x0020u32

// Component lifecycle status (AXS-COMP-030)
pub const COMPONENT_STATUS_ACTIVE: u32 = 1u32
pub const COMPONENT_STATUS_QUIESCING: u32 = 2u32
pub const COMPONENT_STATUS_RETIRED: u32 = 3u32
pub const COMPONENT_STATUS_UNLOADED: u32 = 4u32

// .axcomp section header constants (AXS-COMP-005)
pub const AXCOMP_MAGIC: u32 = 0x504D4F43u32 // ASCII "COMP" little-endian
pub const AXCOMP_FORMAT_VERSION: u16 = 1u16
pub const AXCOMP_HEADER_SIZE: u16 = 128u16

// =============================================================================
// 2. 128-Bit Cryptographic Digests for Dynamic Components (AXS-COMP-003, AXS-COMP-005)
// =============================================================================

@repr(C)
@derive(Copy)
pub struct InterfaceFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn interface_fingerprint_zero() -> InterfaceFingerprint {
    InterfaceFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn interface_fingerprint_new(lo: u64, hi: u64) -> InterfaceFingerprint {
    InterfaceFingerprint { lo: lo, hi: hi }
}

pub fn interface_fingerprint_eq(a: InterfaceFingerprint, b: InterfaceFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@repr(C)
@derive(Copy)
pub struct TargetTripleFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn target_triple_fingerprint_zero() -> TargetTripleFingerprint {
    TargetTripleFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn target_triple_fingerprint_new(lo: u64, hi: u64) -> TargetTripleFingerprint {
    TargetTripleFingerprint { lo: lo, hi: hi }
}

pub fn target_triple_fingerprint_eq(a: TargetTripleFingerprint, b: TargetTripleFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@repr(C)
@derive(Copy)
pub struct StateSchemaId {
    pub lo: u64,
    pub hi: u64,
}

pub fn state_schema_id_zero() -> StateSchemaId {
    StateSchemaId { lo: 0u64, hi: 0u64 }
}

pub fn state_schema_id_new(lo: u64, hi: u64) -> StateSchemaId {
    StateSchemaId { lo: lo, hi: hi }
}

pub fn state_schema_id_eq(a: StateSchemaId, b: StateSchemaId) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

@repr(C)
@derive(Copy)
pub struct AbiFingerprint {
    pub lo: u64,
    pub hi: u64,
}

pub fn abi_fingerprint_zero() -> AbiFingerprint {
    AbiFingerprint { lo: 0u64, hi: 0u64 }
}

pub fn abi_fingerprint_new(lo: u64, hi: u64) -> AbiFingerprint {
    AbiFingerprint { lo: lo, hi: hi }
}

pub fn abi_fingerprint_eq(a: AbiFingerprint, b: AbiFingerprint) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

// =============================================================================
// 3. Component Identity & Semantic Versioning (AXS-COMP-002, AXS-COMP-011)
// =============================================================================

@repr(C)
@derive(Copy)
pub struct ComponentSemVer {
    pub major: u32,
    pub minor: u32,
    pub patch: u32,
    pub prerelease_len: usize,
    pub prerelease_tag: u32, // Deterministic tag/hash for pre-release comparison
}

pub fn component_semver_new(maj: u32, min: u32, pat: u32) -> ComponentSemVer {
    ComponentSemVer {
        major: maj,
        minor: min,
        patch: pat,
        prerelease_len: 0usize,
        prerelease_tag: 0u32,
    }
}

pub fn component_semver_with_prerelease(maj: u32, min: u32, pat: u32, pre_len: usize, pre_tag: u32) -> ComponentSemVer {
    ComponentSemVer {
        major: maj,
        minor: min,
        patch: pat,
        prerelease_len: pre_len,
        prerelease_tag: pre_tag,
    }
}

pub fn component_semver_eq(a: ComponentSemVer, b: ComponentSemVer) -> bool {
    a.major == b.major && a.minor == b.minor && a.patch == b.patch &&
    a.prerelease_len == b.prerelease_len && a.prerelease_tag == b.prerelease_tag
}

// Evaluates SemVer 2.0 Caret (^) requirement matching (AXS-COMP-011 §2):
// ^2.1.0 matches >=2.1.0, <3.0.0
// ^0.2.1 matches >=0.2.1, <0.3.0
// ^0.0.3 matches ==0.0.3
// Pre-releases strictly isolated unless requirement requests matching pre-release.
pub fn component_semver_matches_caret(req: ComponentSemVer, cand: ComponentSemVer) -> bool {
    if req.prerelease_len == 0usize && cand.prerelease_len > 0usize {
        return false
    }
    if req.prerelease_len > 0usize {
        if req.prerelease_len != cand.prerelease_len || req.prerelease_tag != cand.prerelease_tag {
            return false
        }
    }
    if req.major > 0u32 {
        if cand.major != req.major {
            return false
        }
        if req.minor > cand.minor {
            return false
        }
        if cand.minor == req.minor && (req.patch > cand.patch) {
            return false
        }
        return true
    }
    if req.minor > 0u32 {
        if cand.major != 0u32 || cand.minor != req.minor {
            return false
        }
        return cand.patch >= req.patch
    }
    cand.major == 0u32 && cand.minor == 0u32 && cand.patch == req.patch
}

// Validates ComponentId syntax: "<vendor>.<namespace>.<name>" (AXS-COMP-002 §1)
pub fn validate_component_id_bytes(buf: *const u8, byte_len: usize) -> bool {
    if 5usize > byte_len || (buf as usize) == 0usize {
        return false
    }
    let mut dot_count: u32 = 0u32
    let mut seg_len: u32 = 0u32
    let mut i: usize = 0usize
    while i < byte_len {
        let b = unsafe { *(buf + i) }
        if b == 46u8 { // '.'
            if seg_len == 0u32 {
                return false
            }
            dot_count = dot_count + 1u32
            seg_len = 0u32
        } else {
            let is_alpha = (b >= 97u8 && b <= 122u8) || (b >= 65u8 && b <= 90u8)
            let is_digit = (b >= 48u8 && b <= 57u8)
            let is_special = (b == 95u8 || b == 45u8)
            if !is_alpha && !is_digit && !is_special {
                return false
            }
            seg_len = seg_len + 1u32
        }
        i = i + 1usize
    }
    if seg_len == 0u32 {
        return false
    }
    dot_count >= 2u32
}

// =============================================================================
// 4. Low-Level Little-Endian Helpers & .axcomp Layout (AXS-COMP-005)
// =============================================================================

pub fn write_u16_le(buf: *mut u8, offset: usize, val: u16) {
    unsafe {
        *(buf + offset) = (val & 0xFFu16) as u8
        *(buf + offset + 1usize) = ((val >> 8u16) & 0xFFu16) as u8
    }
}

pub fn write_u32_le(buf: *mut u8, offset: usize, val: u32) {
    unsafe {
        *(buf + offset) = (val & 0xFFu32) as u8
        *(buf + offset + 1usize) = ((val >> 8u32) & 0xFFu32) as u8
        *(buf + offset + 2usize) = ((val >> 16u32) & 0xFFu32) as u8
        *(buf + offset + 3usize) = ((val >> 24u32) & 0xFFu32) as u8
    }
}

pub fn write_u64_le(buf: *mut u8, offset: usize, val: u64) {
    let lo = (val & 0xFFFFFFFFu64) as u32
    let hi = ((val >> 32u64) & 0xFFFFFFFFu64) as u32
    write_u32_le(buf, offset, lo)
    write_u32_le(buf, offset + 4usize, hi)
}

pub fn read_u16_le(buf: *const u8, offset: usize) -> u16 {
    unsafe {
        let b0 = (*(buf + offset)) as u16
        let b1 = (*(buf + offset + 1usize)) as u16
        b0 | (b1 << 8u16)
    }
}

pub fn read_u32_le(buf: *const u8, offset: usize) -> u32 {
    unsafe {
        let b0 = (*(buf + offset)) as u32
        let b1 = (*(buf + offset + 1usize)) as u32
        let b2 = (*(buf + offset + 2usize)) as u32
        let b3 = (*(buf + offset + 3usize)) as u32
        b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32)
    }
}

pub fn read_u64_le(buf: *const u8, offset: usize) -> u64 {
    let lo = read_u32_le(buf, offset) as u64
    let hi = read_u32_le(buf, offset + 4usize) as u64
    lo | (hi << 32u64)
}

@repr(C)
@derive(Copy)
pub struct AxCompHeader {
    pub magic: u32,
    pub format_version: u16,
    pub header_size: u16,
    pub component_id_offset: u32,
    pub component_id_len: u32,
    pub semver_major: u32,
    pub semver_minor: u32,
    pub semver_patch: u32,
    pub semver_prerelease_offset: u32,
    pub abi_fingerprint_lo: u64,
    pub abi_fingerprint_hi: u64,
    pub target_triple_lo: u64,
    pub target_triple_hi: u64,
    pub state_schema_id_lo: u64,
    pub state_schema_id_hi: u64,
    pub capability_count: u32,
    pub capability_table_offset: u32,
    pub exported_iface_count: u32,
    pub exported_iface_table_offset: u32,
}

pub fn axcomp_header_zero() -> AxCompHeader {
    AxCompHeader {
        magic: AXCOMP_MAGIC,
        format_version: AXCOMP_FORMAT_VERSION,
        header_size: AXCOMP_HEADER_SIZE,
        component_id_offset: 0u32,
        component_id_len: 0u32,
        semver_major: 0u32,
        semver_minor: 0u32,
        semver_patch: 0u32,
        semver_prerelease_offset: 0u32,
        abi_fingerprint_lo: 0u64,
        abi_fingerprint_hi: 0u64,
        target_triple_lo: 0u64,
        target_triple_hi: 0u64,
        state_schema_id_lo: 0u64,
        state_schema_id_hi: 0u64,
        capability_count: 0u32,
        capability_table_offset: 0u32,
        exported_iface_count: 0u32,
        exported_iface_table_offset: 0u32,
    }
}

pub fn axcomp_serialize_header(hdr: view<AxCompHeader>, buf: *mut u8, buf_len: usize) -> bool {
    if buf_len < 128usize || (buf as usize) == 0usize {
        return false
    }
    let mut i: usize = 0usize
    while i < 128usize {
        unsafe { *(buf + i) = 0u8 }
        i = i + 1usize
    }

    write_u32_le(buf, 0usize, hdr.magic)
    write_u16_le(buf, 4usize, hdr.format_version)
    write_u16_le(buf, 6usize, hdr.header_size)
    write_u32_le(buf, 8usize, hdr.component_id_offset)
    write_u32_le(buf, 12usize, hdr.component_id_len)
    write_u32_le(buf, 16usize, hdr.semver_major)
    write_u32_le(buf, 20usize, hdr.semver_minor)
    write_u32_le(buf, 24usize, hdr.semver_patch)
    write_u32_le(buf, 28usize, hdr.semver_prerelease_offset)
    write_u64_le(buf, 32usize, hdr.abi_fingerprint_lo)
    write_u64_le(buf, 40usize, hdr.abi_fingerprint_hi)
    write_u64_le(buf, 48usize, hdr.target_triple_lo)
    write_u64_le(buf, 56usize, hdr.target_triple_hi)
    write_u64_le(buf, 64usize, hdr.state_schema_id_lo)
    write_u64_le(buf, 72usize, hdr.state_schema_id_hi)
    write_u32_le(buf, 80usize, hdr.capability_count)
    write_u32_le(buf, 84usize, hdr.capability_table_offset)
    write_u32_le(buf, 88usize, hdr.exported_iface_count)
    write_u32_le(buf, 92usize, hdr.exported_iface_table_offset)

    true
}

pub fn axcomp_parse_header(buf: *const u8, buf_len: usize, out_hdr: mut_view<AxCompHeader>) -> u32 {
    if buf_len < 128usize || (buf as usize) == 0usize {
        return AX_COMP_MISSING_MANIFEST
    }
    let magic = read_u32_le(buf, 0usize)
    if magic != AXCOMP_MAGIC {
        return AX_COMP_CORRUPT_MANIFEST
    }
    let ver = read_u16_le(buf, 4usize)
    if ver != AXCOMP_FORMAT_VERSION {
        return AX_COMP_CORRUPT_MANIFEST
    }
    let hdr_sz = read_u16_le(buf, 6usize)
    if hdr_sz < AXCOMP_HEADER_SIZE {
        return AX_COMP_CORRUPT_MANIFEST
    }

    out_hdr.magic = magic
    out_hdr.format_version = ver
    out_hdr.header_size = hdr_sz
    out_hdr.component_id_offset = read_u32_le(buf, 8usize)
    out_hdr.component_id_len = read_u32_le(buf, 12usize)
    out_hdr.semver_major = read_u32_le(buf, 16usize)
    out_hdr.semver_minor = read_u32_le(buf, 20usize)
    out_hdr.semver_patch = read_u32_le(buf, 24usize)
    out_hdr.semver_prerelease_offset = read_u32_le(buf, 28usize)
    out_hdr.abi_fingerprint_lo = read_u64_le(buf, 32usize)
    out_hdr.abi_fingerprint_hi = read_u64_le(buf, 40usize)
    out_hdr.target_triple_lo = read_u64_le(buf, 48usize)
    out_hdr.target_triple_hi = read_u64_le(buf, 56usize)
    out_hdr.state_schema_id_lo = read_u64_le(buf, 64usize)
    out_hdr.state_schema_id_hi = read_u64_le(buf, 72usize)
    out_hdr.capability_count = read_u32_le(buf, 80usize)
    out_hdr.capability_table_offset = read_u32_le(buf, 84usize)
    out_hdr.exported_iface_count = read_u32_le(buf, 88usize)
    out_hdr.exported_iface_table_offset = read_u32_le(buf, 92usize)

    0u32
}

pub fn axcomp_validate_section(buf: *const u8, buf_len: usize, out_hdr: mut_view<AxCompHeader>) -> u32 {
    let rc = axcomp_parse_header(buf, buf_len, mut_view(*out_hdr))
    if rc != 0u32 {
        return rc
    }

    let cid_end = (out_hdr.component_id_offset as usize) + (out_hdr.component_id_len as usize)
    if cid_end > buf_len || 128u32 > out_hdr.component_id_offset {
        return AX_COMP_CORRUPT_MANIFEST
    }
    let cid_ptr = unsafe { buf + (out_hdr.component_id_offset as usize) }
    if !validate_component_id_bytes(cid_ptr, out_hdr.component_id_len as usize) {
        return AX_COMP_CORRUPT_MANIFEST
    }

    if out_hdr.capability_count > 0u32 {
        let cap_bytes = (out_hdr.capability_count as usize) * 16usize
        let cap_end = (out_hdr.capability_table_offset as usize) + cap_bytes
        if cap_end > buf_len || 128u32 > out_hdr.capability_table_offset {
            return AX_COMP_CORRUPT_MANIFEST
        }
    }

    if out_hdr.exported_iface_count > 0u32 {
        let iface_bytes = (out_hdr.exported_iface_count as usize) * 32usize
        let iface_end = (out_hdr.exported_iface_table_offset as usize) + iface_bytes
        if iface_end > buf_len || 128u32 > out_hdr.exported_iface_table_offset {
            return AX_COMP_CORRUPT_MANIFEST
        }
    }

    0u32
}

// =============================================================================
// 5. Capability Manifest & Security Attenuation / Revocation (AXS-COMP-013, AXS-COMP-014)
// =============================================================================

@repr(C)
@derive(Copy)
pub struct CapabilityManifest {
    pub mask: u32,
    pub entry_count: u32,
}

pub fn capability_manifest_new(mask: u32, count: u32) -> CapabilityManifest {
    CapabilityManifest { mask: mask, entry_count: count }
}

@repr(C)
@derive(Copy)
pub struct CapabilityGrant {
    pub granted_mask: u32,
    pub attenuated_mask: u32,
    pub is_revoked: bool,
}

pub fn capability_grant_new(mask: u32) -> CapabilityGrant {
    CapabilityGrant {
        granted_mask: mask,
        attenuated_mask: 0xFFFFFFFFu32,
        is_revoked: false,
    }
}

pub fn capability_grant_effective_mask(grant: CapabilityGrant) -> u32 {
    if grant.is_revoked {
        return 0u32
    }
    grant.granted_mask & grant.attenuated_mask
}

pub fn capability_grant_satisfies(req: CapabilityManifest, grant: CapabilityGrant) -> bool {
    if grant.is_revoked {
        return req.mask == 0u32
    }
    let effective = grant.granted_mask & grant.attenuated_mask
    let ungranted = req.mask & (~effective)
    ungranted == 0u32
}

// Monotonic attenuation: restriction mask can only reduce granted capabilities, never escalate
pub fn capability_grant_attenuate(grant: mut_view<CapabilityGrant>, restriction_mask: u32) {
    grant.attenuated_mask = grant.attenuated_mask & restriction_mask
}

// Dynamic revocation: immediately disables all capabilities
pub fn capability_grant_revoke(grant: mut_view<CapabilityGrant>) {
    grant.is_revoked = true
}

// Runtime check for capability invocation: returns 0 on success, or diagnostic code
pub fn capability_grant_check_runtime(grant: CapabilityGrant, cap: u32) -> u32 {
    if grant.is_revoked {
        return AX_COMP_CAPABILITY_REVOKED
    }
    let effective = grant.granted_mask & grant.attenuated_mask
    if (effective & cap) == 0u32 {
        return AX_COMP_CAPABILITY_DENIED
    }
    0u32
}

// =============================================================================
// 6. Pre-Flight Discovery, Inspection & Dispatch Table Binding (AXS-COMP-010, AXS-COMP-015)
// =============================================================================

@repr(C)
@derive(Copy)
pub struct ExportedInterfaceEntry {
    pub fingerprint: InterfaceFingerprint,
    pub vtable_ptr: *const (),
    pub vtable_size: u32,
    pub method_count: u32,
}

pub fn exported_interface_entry_zero() -> ExportedInterfaceEntry {
    ExportedInterfaceEntry {
        fingerprint: interface_fingerprint_zero(),
        vtable_ptr: 0 as *const (),
        vtable_size: 0u32,
        method_count: 0u32,
    }
}

@derive(Copy)
pub struct DiscoveredComponent {
    pub id_buf: [48]u8,
    pub id_len: usize,
    pub semver: ComponentSemVer,
    pub abi_fingerprint: AbiFingerprint,
    pub target_triple: TargetTripleFingerprint,
    pub state_schema_id: StateSchemaId,
    pub capability_manifest: CapabilityManifest,
    pub header: AxCompHeader,
    pub is_valid: bool,
}

pub fn discovered_component_zero() -> DiscoveredComponent {
    DiscoveredComponent {
        id_buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        id_len: 0usize,
        semver: component_semver_new(0u32, 0u32, 0u32),
        abi_fingerprint: abi_fingerprint_zero(),
        target_triple: target_triple_fingerprint_zero(),
        state_schema_id: state_schema_id_zero(),
        capability_manifest: capability_manifest_new(0u32, 0u32),
        header: axcomp_header_zero(),
        is_valid: false,
    }
}

// Pre-flight inspection: inspects candidate raw .axcomp binary bytes before loading code (AXS-COMP-010)
pub fn inspect_component_image(buf: *const u8, buf_len: usize, out_cand: mut_view<DiscoveredComponent>) -> u32 {
    let mut hdr = axcomp_header_zero()
    let rc = axcomp_validate_section(buf, buf_len, mut_view(hdr))
    if rc != 0u32 {
        return rc
    }

    out_cand.header = hdr
    out_cand.semver = component_semver_new(hdr.semver_major, hdr.semver_minor, hdr.semver_patch)
    out_cand.abi_fingerprint = abi_fingerprint_new(hdr.abi_fingerprint_lo, hdr.abi_fingerprint_hi)
    out_cand.target_triple = target_triple_fingerprint_new(hdr.target_triple_lo, hdr.target_triple_hi)
    out_cand.state_schema_id = state_schema_id_new(hdr.state_schema_id_lo, hdr.state_schema_id_hi)
    let mut cap_mask: u32 = 0u32
    if hdr.capability_count > 0u32 && hdr.capability_table_offset >= 128u32 {
        let mut i: usize = 0usize
        while i < (hdr.capability_count as usize) {
            let entry_off = (hdr.capability_table_offset as usize) + (i * 16usize)
            if entry_off + 4usize <= buf_len {
                let cap_type = read_u32_le(buf, entry_off)
                cap_mask = cap_mask | cap_type
            }
            i = i + 1usize
        }
    }
    out_cand.capability_manifest = capability_manifest_new(cap_mask, hdr.capability_count)

    let cid_len = hdr.component_id_len as usize
    out_cand.id_len = if cid_len > 48usize { 48usize } else { cid_len }
    let cid_src = unsafe { buf + (hdr.component_id_offset as usize) }
    let mut i: usize = 0usize
    while i < out_cand.id_len {
        out_cand.id_buf[i] = unsafe { *(cid_src + i) }
        i = i + 1usize
    }
    out_cand.is_valid = true

    0u32
}

// =============================================================================
// 7. Host Registry, Negotiation & Loaded Component Binding (AXS-COMP-011..015)
// =============================================================================

@derive(Copy)
pub struct ComponentQuery {
    pub id_buf: [48]u8,
    pub id_len: usize,
    pub version_req: ComponentSemVer,
    pub expected_abi: AbiFingerprint,
    pub expected_target: TargetTripleFingerprint,
}

pub fn component_query_new(
    id_ptr: *const u8,
    id_len: usize,
    req_ver: ComponentSemVer,
    abi: AbiFingerprint,
    target: TargetTripleFingerprint
) -> ComponentQuery {
    let mut q = ComponentQuery {
        id_buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        id_len: if id_len > 48usize { 48usize } else { id_len },
        version_req: req_ver,
        expected_abi: abi,
        expected_target: target,
    }
    let mut i: usize = 0usize
    while i < q.id_len {
        q.id_buf[i] = unsafe { *(id_ptr + i) }
        i = i + 1usize
    }
    q
}

@derive(Copy)
pub struct HostRegisteredComponent {
    pub id_buf: [48]u8,
    pub id_len: usize,
    pub semver: ComponentSemVer,
    pub epoch_id: u32,
    pub is_occupied: bool,
}

pub fn host_registered_component_zero() -> HostRegisteredComponent {
    HostRegisteredComponent {
        id_buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        id_len: 0usize,
        semver: component_semver_new(0u32, 0u32, 0u32),
        epoch_id: 0u32,
        is_occupied: false,
    }
}

pub fn hash_component_identity(buf: *const u8, byte_len: usize, semver: ComponentSemVer) -> u64 {
    let mut h: u64 = 0x504C5547494E4944u64
    let mut i: usize = 0usize
    while i < byte_len {
        let b = unsafe { *(buf + i) } as u64
        h = (h << 7u64) ^ (h >> 3u64) ^ b ^ 0x9E3779B97F4A7C15u64
        i = i + 1usize
    }
    h = h ^ (semver.major as u64 * 1000003u64)
    h = h ^ (semver.minor as u64 * 1009u64)
    h = h ^ (semver.patch as u64)
    h
}

@repr(C)
@derive(Copy)
pub struct ComponentHost {
    pub grant_policy: CapabilityGrant,
    pub expected_abi: AbiFingerprint,
    pub expected_target: TargetTripleFingerprint,
    pub registered_ids: [8]u64,
    pub registered_count: usize,
}

pub fn component_host_new(
    granted_caps_mask: u32,
    abi: AbiFingerprint,
    target: TargetTripleFingerprint
) -> ComponentHost {
    ComponentHost {
        grant_policy: capability_grant_new(granted_caps_mask),
        expected_abi: abi,
        expected_target: target,
        registered_ids: [0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64],
        registered_count: 0usize,
    }
}

fn id_bytes_equal(a_buf: view<[48]u8>, a_len: usize, b_buf: view<[48]u8>, b_len: usize) -> bool {
    if a_len != b_len {
        return false
    }
    let mut i: usize = 0usize
    while i < a_len {
        if (*a_buf)[i] != (*b_buf)[i] {
            return false
        }
        i = i + 1usize
    }
    true
}

// Load-time negotiation: evaluates discovery candidate against query, host policy, and registry
pub fn component_host_negotiate(
    host: mut_view<ComponentHost>,
    cand: view<DiscoveredComponent>,
    query: view<ComponentQuery>
) -> u32 {
    // 1. Identity match check
    if !id_bytes_equal(view(cand.id_buf), cand.id_len, view(query.id_buf), query.id_len) {
        return AX_COMP_CORRUPT_MANIFEST
    }

    // 2. Duplicate registration check (AXS-COMP-002 §4)
    let cid_ptr = unsafe { address_of(cand.id_buf[0]) }
    let ident_hash = hash_component_identity(cid_ptr, cand.id_len, cand.semver)
    let mut i: usize = 0usize
    while i < host.registered_count && i < 8usize {
        if host.registered_ids[i] == ident_hash {
            return AX_COMP_DUPLICATE_REGISTRATION
        }
        i = i + 1usize
    }

    // 3. TargetTriple bit-for-bit validation (AXS-COMP-012 §1)
    if !target_triple_fingerprint_eq(cand.target_triple, host.expected_target) {
        return AX_COMP_TARGET_MISMATCH
    }

    // 4. AbiFingerprint bit-for-bit validation (AXS-COMP-012 §2)
    if !abi_fingerprint_eq(cand.abi_fingerprint, host.expected_abi) {
        return AX_COMP_ABI_MISMATCH
    }

    // 5. SemVer caret requirement negotiation (AXS-COMP-011 §2)
    if !component_semver_matches_caret(query.version_req, cand.semver) {
        return AX_COMP_VERSION_INCOMPATIBLE
    }

    // 6. Capability policy subset validation (AXS-COMP-013 §3)
    if !capability_grant_satisfies(cand.capability_manifest, host.grant_policy) {
        return AX_COMP_CAPABILITY_DENIED
    }

    // Register into host
    if 8usize > host.registered_count {
        let idx = host.registered_count
        host.registered_ids[idx] = ident_hash
        host.registered_count = host.registered_count + 1usize
    }

    0u32
}

// Loaded Component Runtime Representation (AXS-COMP-040)
pub struct Component {
    pub id_buf: [48]u8,
    pub id_len: usize,
    pub semver: ComponentSemVer,
    pub epoch_id: u32,
    pub status: u32,
    pub state_schema_id: StateSchemaId,
    pub interfaces: [8]ExportedInterfaceEntry,
    pub interface_count: usize,
    pub capabilities: CapabilityGrant,
}

pub fn component_new(
    cand: view<DiscoveredComponent>,
    epoch_id: u32,
    caps: CapabilityGrant
) -> Component {
    let empty_iface = exported_interface_entry_zero()
    Component {
        id_buf: cand.id_buf,
        id_len: cand.id_len,
        semver: cand.semver,
        epoch_id: epoch_id,
        status: COMPONENT_STATUS_ACTIVE,
        state_schema_id: cand.state_schema_id,
        interfaces: [empty_iface, empty_iface, empty_iface, empty_iface,
                     empty_iface, empty_iface, empty_iface, empty_iface],
        interface_count: 0usize,
        capabilities: caps,
    }
}

pub fn component_register_interface(
    comp: mut_view<Component>,
    fp: InterfaceFingerprint,
    vtable: *const (),
    vtable_size: u32,
    method_count: u32
) -> bool {
    if comp.interface_count >= 8usize {
        return false
    }
    let idx = comp.interface_count
    comp.interfaces[idx] = ExportedInterfaceEntry {
        fingerprint: fp,
        vtable_ptr: vtable,
        vtable_size: vtable_size,
        method_count: method_count,
    }
    comp.interface_count = comp.interface_count + 1usize
    true
}

// Type-safe acquire_interface dispatch table binding by 128-bit InterfaceFingerprint (AXS-COMP-015)
pub fn component_acquire_interface(
    comp: view<Component>,
    expected_fp: InterfaceFingerprint,
    out_vtable: mut_view<*const ()>
) -> u32 {
    let mut i: usize = 0usize
    while i < comp.interface_count && i < 8usize {
        let it = comp.interfaces[i]
        if interface_fingerprint_eq(it.fingerprint, expected_fp) {
            *out_vtable = it.vtable_ptr
            return 0u32
        }
        i = i + 1usize
    }
    AX_COMP_INTERFACE_NOT_FOUND
}
