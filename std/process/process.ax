module std.process

use std.core.result.Result
use std.core.host.args_count
use std.core.host.arg
use std.core.host.exe_path as host_exe_path
use std.core.host.exit as host_exit
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub struct Vec<T> {
    pub ptr: *mut T,
    pub len: usize,
    pub cap: usize,
}

impl<T> Drop for Vec<T> {
    fn drop(self: mut_view<Vec>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                let mut i: usize = 0;
                while i < self.len {
                    unsafe {
                        drop_in_place<T>(self.ptr + i);
                    }
                    i = i + 1;
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, self.cap * sz, al);
            }
            self.ptr = 0 as *mut T;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn vec_new<T>() -> Vec {
    Vec {
        ptr: 0 as *mut T,
        len: 0,
        cap: 0,
    }
}

pub fn vec_with_capacity<T>(capacity: usize) -> Vec {
    if capacity == 0 {
        return Vec {
            ptr: 0 as *mut T,
            len: 0,
            cap: 0,
        };
    }
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(capacity * sz, al) };
    Vec {
        ptr: raw as *mut T,
        len: 0,
        cap: capacity,
    }
}

pub fn vec_push<T>(v: mut_view<Vec>, val: T) {
    if v.len == v.cap {
        let needed = v.len + 1;
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let sz = size_of<T>();
        let al = align_of<T>();
        let raw = unsafe { heap_alloc(new_cap * sz, al) };
        let new_ptr = raw as *mut T;
        if v.len > 0 && (v.ptr as usize != 0) {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * sz);
                heap_free(v.ptr as *mut u8, v.cap * sz, al);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        let dst = v.ptr + v.len;
        ptr_copy_nonoverlapping<T>(address_of(val), dst, 1);
    }
    v.len = v.len + 1;
}

pub enum ProcessError {
    Other(i64),
}

pub fn exit(code: i32) {
    host_exit(code);
}

pub fn exe_path() -> Result<String, ProcessError> {
    let needed = unsafe { host_exe_path(0 as *mut u8, 0) };
    if needed < 0 {
        return Result.Err(ProcessError.Other(needed));
    }
    if needed == 0 {
        return Result.Ok(string_new());
    }
    let mut s = string_with_capacity(needed as usize);
    let res = unsafe { host_exe_path(s.ptr, needed as usize) };
    if res < 0 {
        return Result.Err(ProcessError.Other(res));
    }
    s.len = res as usize;
    Result.Ok(s)
}

pub fn args() -> Vec<String> {
    let count = args_count();
    let mut v = vec_with_capacity<String>(count);
    let mut i: usize = 0;
    while i < count {
        let needed = unsafe { arg(i, 0 as *mut u8, 0) };
        if needed > 0 {
            let mut s = string_with_capacity(needed as usize);
            let res = unsafe { arg(i, s.ptr, needed as usize) };
            if res > 0 {
                s.len = res as usize;
                vec_push<String>(mut_view(v), s);
            } else {
                vec_push<String>(mut_view(v), string_new());
            }
        } else {
            vec_push<String>(mut_view(v), string_new());
        }
        i = i + 1;
    }
    v
}
