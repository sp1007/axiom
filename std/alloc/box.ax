module std.alloc.box

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct DropGlue {}

pub struct Box<T> {
    pub ptr: *mut T,
    _glue: DropGlue,
}

impl<T> Drop for Box<T> {
    fn drop(self: mut_view<Box>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                unsafe {
                    drop_in_place<T>(self.ptr);
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, sz, al);
            }
            self.ptr = 0 as *mut T;
        }
    }
}

pub fn box_new<T>(val: T) -> Box {
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut T;
    unsafe {
        *p = val;
    }
    Box { ptr: p, _glue: DropGlue {} }
}

pub unsafe fn box_into_raw<T>(b: mut_view<Box>) -> *mut T {
    let p = b.ptr;
    b.ptr = 0 as *mut T;
    p
}

pub unsafe fn box_from_raw<T>(p: *mut T) -> Box {
    Box { ptr: p, _glue: DropGlue {} }
}

pub unsafe fn box_as_ptr<T>(b: view<Box>) -> *const T {
    b.ptr as *const T
}

pub unsafe fn box_as_mut_ptr<T>(b: mut_view<Box>) -> *mut T {
    b.ptr
}
