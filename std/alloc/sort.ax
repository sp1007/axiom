module std.alloc.sort

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub fn sort_slice_by<T, F: Callable>(src: *mut T, n: usize, cmp: F) -> i32 {
    if n <= 1 {
        return 0;
    }
    let sz = size_of<T>();
    let al = align_of<T>();
    let total_bytes = ((n as i64) * (sz as i64)) as usize;
    let raw = unsafe { heap_alloc(total_bytes, al) };
    let tmp = raw as *mut T;

    let mut width: usize = 1;
    while width < n {
        let double_width = width + width;
        let mut i: usize = 0;
        while i < n {
            let start = i;
            let mid = if i + width < n { i + width } else { n };
            let end = if i + double_width < n { i + double_width } else { n };

            let mut left = start;
            let mut right = mid;
            let mut k = start;

            unsafe {
                while left < mid && right < end {
                    let plef = src + left;
                    let prig = src + right;
                    let c = cmp(*plef, *prig);
                    if c <= 0 {
                        *(tmp + k) = *plef;
                        left = left + 1;
                    } else {
                        *(tmp + k) = *prig;
                        right = right + 1;
                    }
                    k = k + 1;
                }
                while left < mid {
                    *(tmp + k) = *(src + left);
                    left = left + 1;
                    k = k + 1;
                }
                while right < end {
                    *(tmp + k) = *(src + right);
                    right = right + 1;
                    k = k + 1;
                }
                let seg_count = end - start;
                let mut cp: usize = 0;
                while cp < seg_count {
                    *(src + (start + cp)) = *(tmp + (start + cp));
                    cp = cp + 1;
                }
            }

            i = i + double_width;
        }
        width = width + width;
    }

    unsafe {
        heap_free(raw, total_bytes, al);
    }
    0
}

pub fn binary_search_by<T, F: Callable>(ptr: *const T, n: usize, f: F) -> i64 {
    let mut low: usize = 0;
    let mut high: usize = n;
    while low < high {
        let mid = low + (high - low) / 2;
        let c = unsafe {
            let p = (ptr + mid) as *const T;
            f(*p)
        };
        if c < 0 {
            low = mid + 1;
        } else if c > 0 {
            high = mid;
        } else {
            return mid as i64;
        }
    }
    // Return negative encoded insertion point: -(low + 1)
    -((low as i64) + 1)
}

pub fn dedup_slice_by<T, F: Callable>(ptr: *mut T, n: usize, same_bucket: F) -> usize {
    if n <= 1 {
        return n;
    }
    let mut write_idx: usize = 1;
    let mut read_idx: usize = 1;
    while read_idx < n {
        let is_dup = unsafe {
            let p_prev = (ptr + (write_idx - 1)) as *const T;
            let p_curr = (ptr + read_idx) as *const T;
            same_bucket(*p_prev, *p_curr)
        };
        if is_dup != 0 {
            if needs_drop<T>() {
                unsafe {
                    drop_in_place<T>(ptr + read_idx);
                }
            }
        } else {
            if write_idx != read_idx {
                unsafe {
                    *(ptr + write_idx) = *(ptr + read_idx);
                }
            }
            write_idx = write_idx + 1;
        }
        read_idx = read_idx + 1;
    }
    write_idx
}
