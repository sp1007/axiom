module std.alloc.vec

use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct Vec<T> {
    pub ptr: *mut T,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl<T> Drop for Vec<T> {
    fn drop(self: mut_view<Vec>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                let mut i: usize = 0;
                while i < self.len {
                    unsafe {
                        drop_in_place<T>(self.ptr + i);
                    }
                    i = i + 1;
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, self.cap * sz, al);
            }
            self.ptr = 0 as *mut T;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn vec_new<T>() -> Vec {
    Vec {
        ptr: 0 as *mut T,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn vec_with_capacity<T>(capacity: usize) -> Vec {
    if capacity == 0 {
        return Vec {
            ptr: 0 as *mut T,
            len: 0,
            cap: 0,
            _glue: DropGlue {},
        };
    }
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(capacity * sz, al) };
    Vec {
        ptr: raw as *mut T,
        len: 0,
        cap: capacity,
        _glue: DropGlue {},
    }
}

pub fn vec_len<T>(v: view<Vec>) -> usize {
    v.len
}

pub fn vec_capacity<T>(v: view<Vec>) -> usize {
    v.cap
}

pub fn vec_is_empty<T>(v: view<Vec>) -> bool {
    v.len == 0
}

pub fn vec_reserve<T>(v: mut_view<Vec>, additional: usize) {
    let needed = v.len + additional;
    if needed <= v.cap {
        return;
    }
    let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
    if new_cap < needed {
        new_cap = needed;
    }
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(new_cap * sz, al) };
    let new_ptr = raw as *mut T;
    if v.len > 0 && v.ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * sz);
            heap_free(v.ptr as *mut u8, v.cap * sz, al);
        }
    }
    v.ptr = new_ptr;
    v.cap = new_cap;
}

pub fn vec_push<T>(v: mut_view<Vec>, val: T) {
    if v.len == v.cap {
        let needed = v.len + 1;
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let sz = size_of<T>();
        let al = align_of<T>();
        let raw = unsafe { heap_alloc(new_cap * sz, al) };
        let new_ptr = raw as *mut T;
        if v.len > 0 && v.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * sz);
                heap_free(v.ptr as *mut u8, v.cap * sz, al);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        let p = v.ptr + v.len;
        *p = val;
    }
    v.len = v.len + 1;
}

pub fn vec_pop<T>(v: mut_view<Vec>) -> Option {
    if v.len == 0 {
        return Option.None;
    }
    v.len = v.len - 1;
    let p = unsafe { v.ptr + v.len };
    let val = unsafe { *p };
    Option.Some(val)
}

pub fn vec_clear<T>(v: mut_view<Vec>) {
    if needs_drop<T>() {
        let mut i: usize = 0;
        while i < v.len {
            unsafe {
                drop_in_place<T>(v.ptr + i);
            }
            i = i + 1;
        }
    }
    v.len = 0;
}

pub unsafe fn vec_get_ptr<T>(v: view<Vec>, index: usize) -> *const T {
    if index >= v.len {
        0 as *const T
    } else {
        (v.ptr + index) as *const T
    }
}

pub unsafe fn vec_get_mut_ptr<T>(v: mut_view<Vec>, index: usize) -> *mut T {
    if index >= v.len {
        0 as *mut T
    } else {
        v.ptr + index
    }
}

pub fn vec_set<T>(v: mut_view<Vec>, index: usize, val: T) -> bool {
    if index >= v.len {
        return false;
    }
    unsafe {
        let p = v.ptr + index;
        if needs_drop<T>() {
            drop_in_place<T>(p);
        }
        *p = val;
    }
    true
}
