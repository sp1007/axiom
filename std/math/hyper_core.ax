module std.math.hyper_core

// std.math.hyper_core (T461, SPEC-41 AXS-FLT-063/064): sinh, cosh, tanh, asinh, acosh, atanh.
//
// The forward functions use e^x - 1 as a double-double (std.math.exp_core): with q = e^|x| - 1 and E = q + 1,
// sinh = (q + q / E) / 2, cosh = (E + 1 / E) / 2 and tanh = q2 / (q2 + 2) for q2 = e^(2|x|) - 1, all sums of terms of
// one sign, so there is no cancellation. The inverse functions are the logarithm of a double-double argument with
// the cancellation-free forms asinh = log1p(|x| + x^2 / (1 + sqrt(x^2 + 1))), acosh = log1p((x - 1) + sqrt((x - 1)
// (x + 1))) and atanh = log1p(2 x / (1 - x)) / 2. Each result is within 0.51 ulp.

use std.core.float.copysign_f64
use std.math.dd.Dd
use std.math.dd.two_sum
use std.math.dd.dd_add
use std.math.dd.dd_add_d
use std.math.dd.dd_mul
use std.math.dd.dd_sqr
use std.math.dd.dd_div
use std.math.dd.dd_sqrt
use std.math.dd.scale2
use std.math.exp_core.exp_parts
use std.math.exp_core.expm1_dd
use std.math.log_core.log_dd
use std.math.log_core.log1p_dd
use std.math.tables.LN2_DD

// sinh and cosh overflow above this.
const MAX_SINH: f64 = 710.4758600739439;
const TINY: f64 = 3.725290298461914e-9;
const BIG: f64 = 268435456.0;

pub fn sinh(x: f64) -> f64 {
    if x != x || x == 0.0 {
        return x + x;
    }
    let ax = x.abs();
    if ax == f64.INFINITY {
        return x;
    }
    if ax < TINY {
        return x;
    }
    if ax > MAX_SINH {
        return copysign_f64(f64.INFINITY, x);
    }
    if ax >= 40.0 {
        let ep = exp_parts(ax);
        let onep = dd_add_d(ep.p, 1.0);
        return copysign_f64(scale2(onep.hi + onep.lo, ep.k - 1), x);
    }
    let q = expm1_dd(ax);
    let e = dd_add_d(q, 1.0);
    let t = dd_div(q, e);
    let s = dd_add(q, t);
    copysign_f64(0.5 * s.hi, x)
}

pub fn cosh(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    let ax = x.abs();
    if ax == f64.INFINITY {
        return f64.INFINITY;
    }
    if ax > MAX_SINH {
        return f64.INFINITY;
    }
    if ax >= 40.0 {
        let ep = exp_parts(ax);
        let onep = dd_add_d(ep.p, 1.0);
        return scale2(onep.hi + onep.lo, ep.k - 1);
    }
    let q = expm1_dd(ax);
    let e = dd_add_d(q, 1.0);
    let inv = dd_div(Dd { hi: 1.0, lo: 0.0 }, e);
    let s = dd_add(e, inv);
    0.5 * s.hi
}

pub fn tanh(x: f64) -> f64 {
    if x != x || x == 0.0 {
        return x + x;
    }
    let ax = x.abs();
    if ax >= 22.0 {
        return copysign_f64(1.0, x);
    }
    if ax < TINY {
        return x;
    }
    let q = expm1_dd(2.0 * ax);
    let t = dd_div(q, dd_add_d(q, 2.0));
    copysign_f64(t.hi, x)
}

pub fn asinh(x: f64) -> f64 {
    if x != x || x == 0.0 {
        return x + x;
    }
    let ax = x.abs();
    if ax == f64.INFINITY {
        return x;
    }
    if ax < TINY {
        return x;
    }
    if ax >= BIG {
        let r = dd_add(log_dd(ax), LN2_DD);
        return copysign_f64(r.hi, x);
    }
    let x2 = dd_sqr(Dd { hi: ax, lo: 0.0 });
    let root = dd_sqrt(dd_add_d(x2, 1.0));
    let u = dd_div(x2, dd_add_d(root, 1.0));
    let s = dd_add_d(u, ax);
    let r = log1p_dd(s);
    copysign_f64(r.hi, x)
}

pub fn acosh(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x < 1.0 {
        return f64.NAN;
    }
    if x == 1.0 {
        return 0.0;
    }
    if x == f64.INFINITY {
        return x;
    }
    if x >= BIG {
        return dd_add(log_dd(x), LN2_DD).hi;
    }
    let a = two_sum(x, -1.0);
    let b = two_sum(x, 1.0);
    let w = dd_sqrt(dd_mul(a, b));
    let s = dd_add(a, w);
    log1p_dd(s).hi
}

pub fn atanh(x: f64) -> f64 {
    if x != x || x == 0.0 {
        return x + x;
    }
    let ax = x.abs();
    if ax > 1.0 {
        return f64.NAN;
    }
    if ax == 1.0 {
        return copysign_f64(f64.INFINITY, x);
    }
    if ax < TINY {
        return x;
    }
    let d = two_sum(1.0, -ax);
    let q = dd_div(Dd { hi: 2.0 * ax, lo: 0.0 }, d);
    let r = log1p_dd(q);
    copysign_f64(0.5 * r.hi, x)
}
