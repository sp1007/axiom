module std.math.atan_core

// std.math.atan_core (T461, SPEC-41 AXS-FLT-063/064): atan, atan2, asin, acos.
//
// All four are the angle of a point (ax, ay) with ax, ay >= 0 given as double-doubles. The ratio of the smaller to
// the larger coordinate q (0 <= q <= 1) is reduced with atan(q) = atan(i/16) + atan(z), z = (q - c) / (1 + q c),
// c = i/16, |z| <= 1/32, and atan(z) is a Taylor series in z^2 (8 terms, double-double). asin(x) and acos(x) feed
// sqrt((1 - x)(1 + x)) as the other coordinate, computed as a double-double. The final angle is assembled by
// double-double additions of pi/2 and pi, so every function is within 0.51 ulp. Signed zeros, infinities and the
// quadrant table of AXS-FLT-064 are handled before the kernel.

use std.core.float.to_bits_f64
use std.core.float.copysign_f64
use std.math.dd.Dd
use std.math.dd.two_sum
use std.math.dd.dd_add
use std.math.dd.dd_add_d
use std.math.dd.dd_neg
use std.math.dd.dd_mul
use std.math.dd.dd_mul_d
use std.math.dd.dd_sqr
use std.math.dd.dd_div
use std.math.dd.dd_sqrt
use std.math.dd.exponent_of
use std.math.dd.scale2
use std.math.tables.ATANC
use std.math.tables.ATANT
use std.math.tables.PI_DD
use std.math.tables.PIO2_DD

// atan(q) for a double-double 0 <= q <= 1.
pub fn atan_unit(q: Dd) -> Dd {
    let i = (q.hi * 16.0 + 0.5).floor() as i32;
    let mut z = q;
    if i != 0 {
        let c = (i as f64) / 16.0;
        let num = dd_add_d(q, -c);
        let den = dd_add_d(dd_mul_d(q, c), 1.0);
        z = dd_div(num, den);
    }
    let w = dd_sqr(z);
    let mut acc = ATANC[7];
    let mut k: i32 = 6;
    while k >= 0 {
        acc = dd_add(dd_mul(acc, w), ATANC[k as usize]);
        k = k - 1;
    }
    let r = dd_mul(acc, z);
    if i == 0 {
        return r;
    }
    dd_add(ATANT[i as usize], r)
}

// Angle in [0, pi/2] of the point (ax, ay), both double-doubles >= 0 and not both zero.
pub fn atan2_core(ay: Dd, ax: Dd) -> Dd {
    if ay.hi > ax.hi {
        let a = atan_unit(dd_div(ax, ay));
        return dd_add(PIO2_DD, dd_neg(a));
    }
    atan_unit(dd_div(ay, ax))
}

// Angle (a double) when min / max = t < 2^-60: atan(t) is t to double-double accuracy.
fn atan_ratio_tiny(ay: f64, ax: f64, xneg: bool, t: f64) -> f64 {
    if ay >= ax {
        if xneg {
            return dd_add_d(PIO2_DD, t).hi;
        }
        return dd_add_d(PIO2_DD, -t).hi;
    }
    if xneg {
        return dd_add_d(PI_DD, -t).hi;
    }
    t
}

pub fn atan2(y: f64, x: f64) -> f64 {
    if x != x || y != y {
        return x + y;
    }
    let mut ay = y.abs();
    let mut ax = x.abs();
    let xneg = (to_bits_f64(x) >> 63u32) != 0u64;
    if y == 0.0 {
        if xneg {
            return copysign_f64(PI_DD.hi, y);
        }
        return y;
    }
    if x == 0.0 {
        return copysign_f64(PIO2_DD.hi, y);
    }
    if ax == f64.INFINITY {
        if ay == f64.INFINITY {
            if xneg {
                return copysign_f64(2.356194490192345, y);
            }
            return copysign_f64(0.7853981633974483, y);
        }
        if xneg {
            return copysign_f64(PI_DD.hi, y);
        }
        return copysign_f64(0.0, y);
    }
    if ay == f64.INFINITY {
        return copysign_f64(PIO2_DD.hi, y);
    }
    let mut hi = ay;
    let mut lo = ax;
    if ax > ay {
        hi = ax;
        lo = ay;
    }
    if lo < hi * 8.673617379884035e-19 {
        let t = lo / hi;
        return copysign_f64(atan_ratio_tiny(ay, ax, xneg, t), y);
    }
    if hi > 1.0e150 || lo < 1.0e-150 {
        let e = exponent_of(hi);
        ay = scale2(ay, -e);
        ax = scale2(ax, -e);
    }
    let mut th = atan2_core(Dd { hi: ay, lo: 0.0 }, Dd { hi: ax, lo: 0.0 });
    if xneg {
        th = dd_add(PI_DD, dd_neg(th));
    }
    copysign_f64(th.hi, y)
}

pub fn atan(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    atan2(x, 1.0)
}

// sqrt((1 - ax) (1 + ax)) as a double-double for 0 <= ax < 1.
fn sqrt_one_minus_sq(ax: f64) -> Dd {
    let a = two_sum(1.0, -ax);
    let b = two_sum(1.0, ax);
    dd_sqrt(dd_mul(a, b))
}

pub fn asin(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    let ax = x.abs();
    if ax > 1.0 {
        return f64.NAN;
    }
    if ax == 1.0 {
        return copysign_f64(PIO2_DD.hi, x);
    }
    if ax < 1.4901161193847656e-8 {
        return x;
    }
    let root = sqrt_one_minus_sq(ax);
    let th = atan2_core(Dd { hi: ax, lo: 0.0 }, root);
    copysign_f64(th.hi, x)
}

pub fn acos(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    let ax = x.abs();
    if ax > 1.0 {
        return f64.NAN;
    }
    if x == 1.0 {
        return 0.0;
    }
    if x == -1.0 {
        return PI_DD.hi;
    }
    if ax == 0.0 {
        return PIO2_DD.hi;
    }
    let root = sqrt_one_minus_sq(ax);
    let mut th = atan2_core(root, Dd { hi: ax, lo: 0.0 });
    if x < 0.0 {
        th = dd_add(PI_DD, dd_neg(th));
    }
    th.hi
}
