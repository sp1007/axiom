        rem_euclid(self, other)
    }

    pub fn atan2(self: f64, x: f64) -> f64 {
        atan2(self, x)
    }

    pub fn powi(self: f64, n: i32) -> f64 {
        powi(self, n)
    }

    pub fn sincos(self: f64) -> (f64, f64) {
        sincos(self)
    }

    pub fn modf(self: f64) -> (f64, f64) {
        modf(self)
    }

    pub fn frexp(self: f64) -> (f64, i32) {
        frexp(self)
    }

    pub fn ldexp(self: f64, n: i32) -> f64 {
        ldexp(self, n)
    }

    pub fn scalbn(self: f64, n: i32) -> f64 {
        scalbn(self, n)
    }

    pub fn lerp(self: f64, b: f64, t: f64) -> f64 {
        lerp(self, b, t)
    }
}

