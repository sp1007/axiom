// ---- sign, decomposition ---------------------------------------------------------------------------------

// 1.0 or -1.0 by the sign bit (also for the zeros); NaN for NaN.
pub fn signum(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    let one: f64 = 1.0;
    one.copysign(x)
}

pub fn signum_f32(x: f32) -> f32 {
    if x != x {
        return x + x;
    }
    let one: f32 = 1.0;
    one.copysign(x)
}

// (trunc(x), fract(x)); both carry the sign of x (the zeros too), NaN gives (NaN, NaN), +-inf gives (+-inf, +-0).
pub fn modf(x: f64) -> (f64, f64) {
    if x != x {
        return (x + x, x + x);
    }
    let i = x.trunc();
    if x.is_infinite() {
        let zero: f64 = 0.0;
        return (i, zero.copysign(x));
    }
    ((i), (x - i).copysign(x))
}

pub fn modf_f32(x: f32) -> (f32, f32) {
    let r = modf(x as f64);
    (r.0 as f32, r.1 as f32)
}

// x = m 2^e with 0.5 <= |m| < 1 for finite nonzero x; (x, 0) for zero, infinity and NaN.
pub fn frexp(x: f64) -> (f64, i32) {
    if x != x || x == 0.0 || x.is_infinite() {
        return (x, 0);
    }
    let mut v = x;
    let mut adjust: i32 = 0;
    if v.abs() < 2.2250738585072014e-308 {
        v = v * 18014398509481984.0;
        adjust = -54;
    }
    let b = to_bits_f64(v);
    let field = ((b >> 52u32) & 0x7FFu64) as i32;
    let m = from_bits_f64((b & 0x800F_FFFF_FFFF_FFFFu64) | 0x3FE0_0000_0000_0000u64);
    (m, field - 1022 + adjust)
}

pub fn frexp_f32(x: f32) -> (f32, i32) {
    let r = frexp(x as f64);
    (r.0 as f32, r.1)
}

// x * 2^n exactly (rounded once on overflow and gradual underflow).
pub fn ldexp(x: f64, n: i32) -> f64 {
    scale2(x, n)
}

pub fn ldexp_f32(x: f32, n: i32) -> f32 {
    scale2(x as f64, n) as f32
}

pub fn scalbn(x: f64, n: i32) -> f64 {
    scale2(x, n)
}

pub fn scalbn_f32(x: f32, n: i32) -> f32 {
    scale2(x as f64, n) as f32
}

// ---- Euclidean division and interpolation -----------------------------------------------------------------

pub fn div_euclid(a: f64, b: f64) -> f64 {
    let q = (a / b).trunc();
    if a % b < 0.0 {
        if b > 0.0 {
            return q - 1.0;
        }
        return q + 1.0;
    }
    q
}

pub fn div_euclid_f32(a: f32, b: f32) -> f32 {
    let q = (a / b).trunc();
    if a % b < 0.0 {
        if b > 0.0 {
            return q - 1.0;
        }
        return q + 1.0;
    }
    q
}

// Non-negative remainder in [0, |b|); NaN for b == 0 and for NaN inputs.
pub fn rem_euclid(a: f64, b: f64) -> f64 {
    let r = a % b;
    if r < 0.0 {
        return r + b.abs();
    }
    r + 0.0
}

pub fn rem_euclid_f32(a: f32, b: f32) -> f32 {
    let r = a % b;
    if r < 0.0 {
        return r + b.abs();
    }
    r + 0.0
}

// a + t (b - a): exact at t == 0 (a) and t == 1 (b), monotonic in t.
pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    if (a <= 0.0 && b >= 0.0) || (a >= 0.0 && b <= 0.0) {
        return t * b + (1.0 - t) * a;
    }
    if t == 1.0 {
        return b;
    }
    let x = a + t * (b - a);
    if (t > 1.0) == (b > a) {
        if b < x {
            return x;
        }
        return b;
    }
    if x < b {
        return x;
    }
    b
}

pub fn lerp_f32(a: f32, b: f32, t: f32) -> f32 {
    if (a <= 0.0 && b >= 0.0) || (a >= 0.0 && b <= 0.0) {
        return t * b + (1.0 - t) * a;
    }
    if t == 1.0 {
        return b;
    }
    let x = a + t * (b - a);
    if (t > 1.0) == (b > a) {
        if b < x {
            return x;
        }
        return b;
    }
    if x < b {
        return x;
    }
    b
}

