    pub fn erfc(self: f64) -> f64 {
        erfc(self)
    }

    pub fn signum(self: f64) -> f64 {
        signum(self)
    }

    pub fn hypot(self: f64, other: f64) -> f64 {
        hypot(self, other)
    }

    pub fn log(self: f64, other: f64) -> f64 {
        log(self, other)
    }

    pub fn powf(self: f64, other: f64) -> f64 {
        powf(self, other)
    }

