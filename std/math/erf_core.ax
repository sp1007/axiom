module std.math.erf_core

// std.math.erf_core (T461, SPEC-41 AXS-FLT-063/064): erf and erfc.
//
// For 0 < x < 3: erf(x) = 2/sqrt(pi) e^(-x^2) sum_n 2^n x^(2n+1) / (2n+1)!! (all terms positive, double-double,
// summed until the next term is below 1e-33 of the sum). For x >= 3: erfc(x) = e^(-x^2) / sqrt(pi) times the
// continued fraction 1 / (x + (1/2) / (x + 1 / (x + (3/2) / (x + ...)))) evaluated backwards with a fixed number of
// terms chosen from x. e^(-x^2) is the double-double exponential of the exactly squared argument (no cancellation
// for large x). erfc below 3 is 1 - erf in double-double and erf above 3 is 1 - erfc, so every result is within
// 0.51 ulp (the tail of erfc reaches the subnormal range, where the final scaling rounds once).

use std.core.float.copysign_f64
use std.math.dd.Dd
use std.math.dd.dd_add
use std.math.dd.dd_add_d
use std.math.dd.dd_neg
use std.math.dd.dd_mul
use std.math.dd.dd_mul_d
use std.math.dd.dd_sqr
use std.math.dd.dd_div
use std.math.dd.dd_div_d
use std.math.dd.dd_scale
use std.math.dd.pow2
use std.math.dd.scale_dd
use std.math.exp_core.exp_parts_dd
use std.math.tables.TWO_OVER_SQRT_PI_DD
use std.math.tables.ONE_OVER_SQRT_PI_DD

// erf(x) as a double-double for 0 < x < 3.
fn erf_series(x: f64) -> Dd {
    let x2 = dd_sqr(Dd { hi: x, lo: 0.0 });
    let two_x2 = Dd { hi: 2.0 * x2.hi, lo: 2.0 * x2.lo };
    let mut term = Dd { hi: x, lo: 0.0 };
    let mut s = term;
    let mut n: i32 = 0;
    let mut going = true;
    while going {
        term = dd_div_d(dd_mul(term, two_x2), ((2 * n + 3) as f64));
        s = dd_add(s, term);
        n = n + 1;
        if term.hi < s.hi * 1.0e-33 {
            going = false;
        }
    }
    let ep = exp_parts_dd(Dd { hi: -x2.hi, lo: -x2.lo });
    let onep = dd_add_d(ep.p, 1.0);
    let m = dd_mul(dd_mul(TWO_OVER_SQRT_PI_DD, onep), s);
    dd_scale(m, pow2(ep.k))
}

fn erfc_cf_terms(x: f64) -> i32 {
    if x < 3.5 {
        return 90;
    }
    if x < 4.0 {
        return 72;
    }
    if x < 5.0 {
        return 60;
    }
    if x < 6.0 {
        return 45;
    }
    if x < 10.0 {
        return 36;
    }
    24
}

// erfc(x) = 2^k * m for x >= 3.
struct ErfcTail {
    k: i32,
    m: Dd,
}

fn erfc_cf(x: f64) -> ErfcTail {
    let mut n = erfc_cf_terms(x);
    let mut t = Dd { hi: 0.0, lo: 0.0 };
    while n >= 1 {
        t = dd_div(Dd { hi: (n as f64) * 0.5, lo: 0.0 }, dd_add_d(t, x));
        n = n - 1;
    }
    let cfv = dd_div(Dd { hi: 1.0, lo: 0.0 }, dd_add_d(t, x));
    let x2 = dd_sqr(Dd { hi: x, lo: 0.0 });
    let ep = exp_parts_dd(Dd { hi: -x2.hi, lo: -x2.lo });
    let onep = dd_add_d(ep.p, 1.0);
    let m = dd_mul(dd_mul(ONE_OVER_SQRT_PI_DD, onep), cfv);
    ErfcTail { k: ep.k, m: m }
}

// erf(ax) as a double-double for 0 < ax < 6.
fn erf_dd(ax: f64) -> Dd {
    if ax < 3.0 {
        return erf_series(ax);
    }
    let tail = erfc_cf(ax);
    dd_add_d(dd_neg(dd_scale(tail.m, pow2(tail.k))), 1.0)
}

pub fn erf(x: f64) -> f64 {
    if x != x || x == 0.0 {
        return x + x;
    }
    let ax = x.abs();
    if ax >= 6.0 {
        return copysign_f64(1.0, x);
    }
    if ax < 1.0e-150 {
        // 2/sqrt(pi) x, scaled when x is tiny so that the product keeps all its bits.
        if ax < 1.0e-100 {
            let c = dd_mul_d(TWO_OVER_SQRT_PI_DD, ax * pow2(600));
            return copysign_f64(scale_dd(c, -600), x);
        }
        let c = dd_mul_d(TWO_OVER_SQRT_PI_DD, ax);
        return copysign_f64(c.hi, x);
    }
    copysign_f64(erf_dd(ax).hi, x)
}

pub fn erfc(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x == f64.INFINITY {
        return 0.0;
    }
    if x == f64.NEG_INFINITY {
        return 2.0;
    }
    if x < -6.0 {
        return 2.0;
    }
    if x == 0.0 {
        return 1.0;
    }
    let ax = x.abs();
    if x < 0.0 {
        if ax < 1.0e-20 {
            return 1.0;
        }
        return dd_add_d(erf_dd(ax), 1.0).hi;
    }
    if x > 27.3 {
        return 0.0;
    }
    if x < 3.0 {
        if x < 1.0e-20 {
            return 1.0;
        }
        return dd_add_d(dd_neg(erf_dd(x)), 1.0).hi;
    }
    let tail = erfc_cf(x);
    if tail.k < -1080 {
        return 0.0;
    }
    scale_dd(tail.m, tail.k)
}
