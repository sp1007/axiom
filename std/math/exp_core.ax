module std.math.exp_core

// std.math.exp_core (T461, SPEC-41 AXS-FLT-063): exp, exp2, expm1 and the double-double exponential kernel the
// other functions (pow, sinh, cosh, tanh, erf) build on.
//
// x = k ln 2 + z with |z| <= 0.35 (Cody-Waite: ln 2 is split in three parts, k * LN2_HI is exact), then
// e^z - 1 by the Taylor series of z/16 in double-double followed by four doublings p -> p (p + 2). The result is
// 2^k (1 + p) rounded once, so every function here is within 0.51 ulp (0.5 + the final scaling for subnormals).

use std.core.float.to_bits_f64
use std.core.float.from_bits_f64
use std.math.dd.Dd
use std.math.dd.two_sum
use std.math.dd.two_prod
use std.math.dd.dd_add
use std.math.dd.dd_add_d
use std.math.dd.dd_mul
use std.math.dd.dd_mul_d
use std.math.dd.dd_scale
use std.math.dd.pow2
use std.math.dd.scale_dd
use std.math.dd.fast_two_sum
use std.math.tables.LN2_HI
use std.math.tables.LN2_MID
use std.math.tables.LN2_LO
use std.math.tables.LN2_DD
use std.math.tables.EXPM1C

// e^x overflows above this and rounds to 0 below the second bound.
const EXP_MAX: f64 = 709.782712893384;
const EXP_MIN: f64 = -745.1332191019412;

// e^x = 2^k * (1 + p).
pub struct ExpParts {
    pub k: i32,
    pub p: Dd,
}

// e^z - 1 as a double-double for |z| <= 0.35.
pub fn expm1_core(z: Dd) -> Dd {
    let w = dd_scale(z, 0.0625);
    let mut acc = EXPM1C[10];
    let mut k: i32 = 9;
    while k >= 0 {
        acc = dd_add(dd_mul(acc, w), EXPM1C[k as usize]);
        k = k - 1;
    }
    let mut p = dd_mul(acc, w);
    let mut i: i32 = 0;
    while i < 4 {
        p = dd_mul(p, dd_add_d(p, 2.0));
        i = i + 1;
    }
    p
}

// x = k ln 2 + z for a double x: returns (k, z), z a double-double.
pub struct Reduced {
    pub k: i32,
    pub z: Dd,
}

pub fn reduce_exp(x: f64) -> Reduced {
    let kf = (x * 1.4426950408889634 + 0.5).floor();
    let a = two_sum(x, -kf * LN2_HI);
    let t1 = two_prod(kf, LN2_MID);
    let z1 = dd_add(a, Dd { hi: -t1.hi, lo: -t1.lo });
    let z = dd_add_d(z1, -(kf * LN2_LO));
    Reduced { k: kf as i32, z: z }
}

// The same for a double-double argument.
pub fn reduce_exp_dd(t: Dd) -> Reduced {
    let kf = (t.hi * 1.4426950408889634 + 0.5).floor();
    let a = two_sum(t.hi, -kf * LN2_HI);
    let z0 = dd_add_d(a, t.lo);
    let t1 = two_prod(kf, LN2_MID);
    let z1 = dd_add(z0, Dd { hi: -t1.hi, lo: -t1.lo });
    let z = dd_add_d(z1, -(kf * LN2_LO));
    Reduced { k: kf as i32, z: z }
}

// 2^k * (1 + p) rounded once to a double.
pub fn exp_finish(k: i32, p: Dd) -> f64 {
    let s = two_sum(1.0, p.hi);
    let e = s.lo + p.lo;
    scale_dd(fast_two_sum(s.hi, e), k)
}

pub fn exp_parts(x: f64) -> ExpParts {
    let r = reduce_exp(x);
    ExpParts { k: r.k, p: expm1_core(r.z) }
}

pub fn exp_parts_dd(t: Dd) -> ExpParts {
    let r = reduce_exp_dd(t);
    ExpParts { k: r.k, p: expm1_core(r.z) }
}

pub fn exp(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x > EXP_MAX {
        return f64.INFINITY;
    }
    if x < EXP_MIN {
        return 0.0;
    }
    let r = reduce_exp(x);
    exp_finish(r.k, expm1_core(r.z))
}

pub fn exp2(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x >= 1024.0 {
        return f64.INFINITY;
    }
    if x < -1080.0 {
        return 0.0;
    }
    let kf = (x + 0.5).floor();
    let f = x - kf;
    let z = dd_mul_d(LN2_DD, f);
    exp_finish(kf as i32, expm1_core(z))
}

// 2^t for a double-double t with |t| below about 1100; the result is a double.
pub fn exp2_dd(t: Dd) -> f64 {
    let kf = (t.hi + 0.5).floor();
    let fh = t.hi - kf;
    let f = two_sum(fh, t.lo);
    let z = dd_mul(f, LN2_DD);
    exp_finish(kf as i32, expm1_core(z))
}

// e^x - 1 as a double-double for -40 <= x <= 45.
pub fn expm1_dd(x: f64) -> Dd {
    let ep = exp_parts(x);
    if ep.k == 0 {
        return ep.p;
    }
    let onep = dd_add_d(ep.p, 1.0);
    let big = dd_scale(onep, pow2(ep.k));
    dd_add_d(big, -1.0)
}

pub fn expm1(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x == 0.0 {
        return x;
    }
    if x.abs() < 5.551115123125783e-17 {
        return x;
    }
    if x > EXP_MAX {
        return f64.INFINITY;
    }
    if x < -40.0 {
        return -1.0;
    }
    if x > 45.0 {
        let ep = exp_parts(x);
        return exp_finish(ep.k, ep.p);
    }
    expm1_dd(x).hi
}
