module std.math.log_core

// std.math.log_core (T461, SPEC-41 AXS-FLT-063): ln, log2, log10, ln_1p, log and the double-double logarithm
// that pow, asinh, acosh and atanh use.
//
// log_dd(x) reduces x = 2^k m with m in [0.6875, 1.375), picks the table entry of the top bits of m (invc,
// logc = -log(invc)), forms r = m * invc - 1 exactly as a double-double and adds k ln 2 + logc + log1p(r). The
// kernel log1p_small(f) = 2 atanh(f / (2 + f)) is a series in s^2 in double-double (|f| <= 0.07). Values close to
// 1 skip the table so that the relative accuracy of the tiny result is kept. About 95 bits, so the rounded results
// are within 0.51 ulp.

use std.core.float.to_bits_f64
use std.core.float.from_bits_f64
use std.math.dd.Dd
use std.math.dd.two_sum
use std.math.dd.two_prod
use std.math.dd.dd_add
use std.math.dd.dd_add_d
use std.math.dd.dd_mul
use std.math.dd.dd_sqr
use std.math.dd.dd_div
use std.math.tables.LN2_HI
use std.math.tables.LN2_MID
use std.math.tables.LN2_LO
use std.math.tables.LN2_DD
use std.math.tables.LOG2E_DD
use std.math.tables.LOG10E_DD
use std.math.tables.ATANHC
use std.math.tables.LOGT

const LOG_OFF: i64 = 0x3FE6_0000_0000_0000i64;

// log(1 + f) as a double-double for a double-double f with |f| <= 0.07.
pub fn log1p_small(f: Dd) -> Dd {
    let den = dd_add_d(f, 2.0);
    let s = dd_div(f, den);
    let t = dd_sqr(s);
    let mut acc = ATANHC[7];
    let mut k: i32 = 6;
    while k >= 0 {
        acc = dd_add(dd_mul(acc, t), ATANHC[k as usize]);
        k = k - 1;
    }
    let r = dd_mul(acc, s);
    Dd { hi: 2.0 * r.hi, lo: 2.0 * r.lo }
}

// log(x) for finite x > 0 as a double-double.
pub fn log_dd(x0: f64) -> Dd {
    let mut x = x0;
    let mut k0: i32 = 0;
    if to_bits_f64(x) < 0x0010_0000_0000_0000u64 {
        x = x * 18014398509481984.0;
        k0 = -54;
    }
    let ix = to_bits_f64(x);
    if ix >= 0x3FEE_0000_0000_0000u64 && ix < 0x3FF1_0000_0000_0000u64 {
        let f = x - 1.0;
        return log1p_small(Dd { hi: f, lo: 0.0 });
    }
    let tmp = (ix as i64) - LOG_OFF;
    let k = (tmp >> 52u32) as i32;
    let i = ((tmp >> 45u32) & 127i64) as usize;
    let iz = (ix as i64) - (k as i64) * 4503599627370496i64;
    let z = from_bits_f64(iz as u64);
    let entry = LOGT[i];
    let ph = two_prod(z, entry.invc);
    let r = two_sum(ph.hi - 1.0, ph.lo);
    let kf = (k + k0) as f64;
    let kl = dd_add(two_prod(kf, LN2_MID), Dd { hi: kf * LN2_LO, lo: 0.0 });
    let base0 = dd_add(Dd { hi: kf * LN2_HI, lo: 0.0 }, kl);
    let base = dd_add(base0, entry.logc);
    dd_add(base, log1p_small(r))
}

// log(1 + s) for a double-double s > -1.
pub fn log1p_dd(s: Dd) -> Dd {
    if s.hi.abs() < 0.0625 {
        return log1p_small(s);
    }
    let u = dd_add_d(s, 1.0);
    let r = log_dd(u.hi);
    dd_add_d(r, u.lo / u.hi)
}

pub fn ln(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x < 0.0 {
        return f64.NAN;
    }
    if x == 0.0 {
        return f64.NEG_INFINITY;
    }
    if x == f64.INFINITY {
        return x;
    }
    log_dd(x).hi
}

pub fn log2(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x < 0.0 {
        return f64.NAN;
    }
    if x == 0.0 {
        return f64.NEG_INFINITY;
    }
    if x == f64.INFINITY {
        return x;
    }
    dd_mul(log_dd(x), LOG2E_DD).hi
}

pub fn log10(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x < 0.0 {
        return f64.NAN;
    }
    if x == 0.0 {
        return f64.NEG_INFINITY;
    }
    if x == f64.INFINITY {
        return x;
    }
    dd_mul(log_dd(x), LOG10E_DD).hi
}

pub fn ln_1p(x: f64) -> f64 {
    if x != x {
        return x + x;
    }
    if x < -1.0 {
        return f64.NAN;
    }
    if x == -1.0 {
        return f64.NEG_INFINITY;
    }
    if x == f64.INFINITY {
        return x;
    }
    if x == 0.0 {
        return x;
    }
    if x.abs() < 5.551115123125783e-17 {
        return x;
    }
    if x.abs() < 0.0625 {
        return log1p_small(Dd { hi: x, lo: 0.0 }).hi;
    }
    let s = two_sum(1.0, x);
    let r = log_dd(s.hi);
    dd_add_d(r, s.lo / s.hi).hi
}

// log_base(x) = ln(x) / ln(base) (the quotient of two double-double logarithms).
pub fn log(x: f64, base: f64) -> f64 {
    if x != x || base != base {
        return x + base;
    }
    if x < 0.0 || base < 0.0 {
        return f64.NAN;
    }
    if base == 1.0 {
        return f64.NAN;
    }
    if x == 0.0 || base == 0.0 || x == f64.INFINITY || base == f64.INFINITY {
        // ln(x) / ln(base) with the infinite or zero logarithms of IEEE division.
        return ln(x) / ln(base);
    }
    dd_div(log_dd(x), log_dd(base)).hi
}
