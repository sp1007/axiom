module std.env

use std.core.option.Option
use std.core.result.Result
use std.core.host.env_get
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub enum EnvError {
    NotFound,
    Other(i64),
}

pub fn get(name: Str) -> Option<String> {
    let nlen = len(name);
    let p = unsafe { *(address_of(name) as *const *const u8) };
    let needed = unsafe { env_get(p, nlen, 0 as *mut u8, 0) };
    if needed < 0 {
        return Option.None;
    }
    if needed == 0 {
        return Option.Some(string_new());
    }
    let mut s = string_with_capacity(needed as usize);
    let res = unsafe { env_get(p, nlen, s.ptr, needed as usize) };
    if res < 0 {
        return Option.None;
    }
    s.len = res as usize;
    Option.Some(s)
}

pub fn var(name: Str) -> Result<String, EnvError> {
    let nlen = len(name);
    let p = unsafe { *(address_of(name) as *const *const u8) };
    let needed = unsafe { env_get(p, nlen, 0 as *mut u8, 0) };
    if needed == -1 {
        return Result.Err(EnvError.NotFound);
    }
    if needed < 0 {
        return Result.Err(EnvError.Other(needed));
    }
    if needed == 0 {
        return Result.Ok(string_new());
    }
    let mut s = string_with_capacity(needed as usize);
    let res = unsafe { env_get(p, nlen, s.ptr, needed as usize) };
    if res < 0 {
        return Result.Err(EnvError.Other(res));
    }
    s.len = res as usize;
    Result.Ok(s)
}
