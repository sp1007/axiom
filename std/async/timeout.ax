// std.asyn.timeout - Deadline, deadline-bounded polling and task timeouts (SPEC-34 AXS-EXEC-024, T422)
//
// A `Deadline` is an absolute monotonic timestamp (`host.monotonic_ns`). It is deliberately a separate
// policy type from cancellation: `Timeout<F, T>` wraps any future and resolves to
// `Err(TimeoutError)` once the deadline has passed while the future is still pending; the future that
// did not finish is dropped (its destructors run) when the `Timeout` is dropped. Wrapping a
// `TaskHandle` therefore cancels the task when the expired `Timeout` goes away (AXS-EXEC-021).
//
// There is no timer driver yet (E11.6 / T426 brings the OS timer queue), so a pending deadline wait
// re-schedules itself with `wake_by_ref` on every poll and observes expiry by polling the clock. The
// executor therefore keeps polling a task that waits on a deadline, which is correct but not idle-free.
module std.asyn.timeout

use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.core.result.Result
use std.core.host.monotonic_ns
// `Context.waker()` is an inherent method defined in std.asyn.waker; importing the module makes it visible.
use std.asyn.waker.waker_leak

const NEVER_NS: u64 = 0xFFFFFFFFFFFFFFFFu64

@derive(Copy)
pub struct Deadline {
    pub deadline_ns: u64,
}

@derive(Copy)
pub struct TimeoutError {
    pub deadline_ns: u64,
}

impl Deadline {
    pub fn at_ns(abs_ns: u64) -> Deadline {
        Deadline { deadline_ns: abs_ns }
    }

    // `now + duration`, saturating at the maximum representable instant.
    pub fn after_ns(duration_ns: u64) -> Deadline {
        let now = monotonic_ns();
        if duration_ns >= NEVER_NS - now {
            return Deadline { deadline_ns: NEVER_NS };
        }
        Deadline { deadline_ns: now + duration_ns }
    }

    pub fn after_ms(duration_ms: u64) -> Deadline {
        if duration_ms >= 18446744073709u64 {
            return Deadline { deadline_ns: NEVER_NS };
        }
        Deadline.after_ns(duration_ms * 1000000u64)
    }

    // A deadline that never expires.
    pub fn never() -> Deadline {
        Deadline { deadline_ns: NEVER_NS }
    }

    pub fn is_expired_at(self: Deadline, now_ns: u64) -> bool {
        now_ns >= self.deadline_ns
    }

    pub fn is_expired(self: Deadline) -> bool {
        monotonic_ns() >= self.deadline_ns
    }

    pub fn remaining_ns_at(self: Deadline, now_ns: u64) -> u64 {
        if now_ns >= self.deadline_ns {
            return 0u64;
        }
        self.deadline_ns - now_ns
    }

    pub fn remaining_ns(self: Deadline) -> u64 {
        self.remaining_ns_at(monotonic_ns())
    }

    // Budget narrowing: the effective deadline of a child operation is the earlier of the two.
    pub fn min(self: Deadline, other: Deadline) -> Deadline {
        if other.deadline_ns < self.deadline_ns {
            return other;
        }
        self
    }

    pub fn max(self: Deadline, other: Deadline) -> Deadline {
        if other.deadline_ns > self.deadline_ns {
            return other;
        }
        self
    }
}

// Deadline adapter over any future (SPEC-34 AXS-EXEC-024). On each poll the inner future is polled
// first: `Ready(v)` gives `Ready(Ok(v))`; `Pending` with the deadline passed gives
// `Ready(Err(TimeoutError))`; otherwise the adapter stays pending (and re-schedules itself, see the
// module comment). The inner future is dropped with the `Timeout`.
//
// Deviation from the spec's `Timeout<F: Future>`: the output type is a second parameter
// (`Timeout<F, T>` with `F: Future<Output = T>`), inferred by `with_deadline` / `with_timeout_*`.
// The compiler cannot yet resolve `F.Output` in signatures, nor the output of a `Future` impl whose
// parameter is fixed only through a bound (`impl<F: Future<Output = T>, T> Future for Timeout<F>`
// leaves `T` unknown at every call site); see the T422c report.
pub struct Timeout<F, T> {
    pub fut: F,
    pub deadline: Deadline,
    // Never read: names `T` in the type so the `Future` impl can state its output.
    pub output_marker: *const T,
}

impl<F: Future<Output = T>, T> Timeout<F, T> {
    pub fn deadline(self: view<Timeout<F, T>>) -> Deadline {
        self.deadline
    }
}

impl<F: Future<Output = T>, T> Future for Timeout<F, T> {
    type Output = Result<T, TimeoutError>;

    fn poll(self: mut_view<Timeout<F, T>>, cx: mut_view<Context>) -> Poll<Result<T, TimeoutError>> {
        match self.fut.poll(mut_view(*cx)) {
            Poll.Ready(val) => {
                return Poll.Ready(Result.Ok(val));
            },
            Poll.Pending => {
                if self.deadline.is_expired() {
                    return Poll.Ready(Result.Err(TimeoutError { deadline_ns: self.deadline.deadline_ns }));
                }
                let w = cx.waker();
                view(w).wake_by_ref();
                return Poll.Pending;
            },
        }
    }
}

pub fn with_deadline<F: Future<Output = T>, T>(deadline: Deadline, fut: F) -> Timeout<F, T> {
    Timeout {
        fut: fut,
        deadline: deadline,
        output_marker: 0 as *const T,
    }
}

pub fn with_timeout_ns<F: Future<Output = T>, T>(duration_ns: u64, fut: F) -> Timeout<F, T> {
    with_deadline(Deadline.after_ns(duration_ns), fut)
}

pub fn with_timeout_ms<F: Future<Output = T>, T>(duration_ms: u64, fut: F) -> Timeout<F, T> {
    with_deadline(Deadline.after_ms(duration_ms), fut)
}
