// std.asyn.group - TaskGroup<T> structured concurrency (SPEC-34 AXS-EXEC-020..022, T422, T422c)
//
// `TaskGroup<T>` owns every child it spawns (`group.spawn(view(exec), fut)`). A child can never
// outlive the group: `join_all` waits for all of them, and `Drop` cancels whatever is still running
// and waits until every child future has been dropped (its destructors have run) before the group's
// memory is released. When a child fails (reports a panic with `task_panic`) the group cancels its
// `CancellationSource` (cooperative siblings observe the token), requests cancellation of every other
// child task, and `join_all` returns the failure deterministically: `Panicked` when any child panicked,
// otherwise `Cancelled` (explicit `cancel_all`, group deadline or parent token); the index of the
// first panicked child is recorded in `failure_index`.
//
// Panic containment: the runtime has no unwinding, so a child cannot be rescued from a real `panic`.
// Containment is cooperative: a child calls `std.asyn.task.task_panic(cx)` and then stops; the task's
// poll function tears the future down and publishes the task as `TASK_PANICKED`, which the group
// reports as `TaskError.Panicked` (T536 replaces this with a real catch).
//
// Handles are stored as raw task headers (`*mut TaskHeader`), so the group needs no `Vec`.
module std.asyn.group

use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.core.option.Option
use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.thread_yield
use std.core.host.monotonic_ns

use std.asyn.waker.TaskHeader
use std.asyn.waker.TASK_COMPLETED
use std.asyn.waker.TASK_CANCELLED
use std.asyn.waker.TASK_PANICKED
use std.asyn.waker.TASK_STATE_MASK
use std.asyn.waker.task_dec_ref
use std.asyn.waker.task_request_cancel

use std.asyn.task.TaskId
use std.asyn.task.TaskError
use std.asyn.task.TaskHandle
use std.asyn.task.task_take_output

use std.asyn.executor.Executor
use std.asyn.cancel.CancellationSource
use std.asyn.cancel.CancellationToken
use std.asyn.timeout.Deadline
use std.asyn.governor.ResourceGovernor
use std.asyn.governor.ResourceKind
use std.asyn.governor.GovInner
use std.asyn.governor.gov_retain
use std.asyn.governor.gov_release_ref
use std.asyn.governor.gov_try_acquire
use std.asyn.governor.gov_release_units

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

// Index of the `Tasks` quota in a governor (see std.asyn.governor.kind_index).
const KIND_TASKS: usize = 0usize

// -----------------------------------------------------------------------------
// Results container
// -----------------------------------------------------------------------------

// Outputs of a fully successful `join_all`, in spawn order. Owns its elements: `Drop` runs their
// destructors and frees the storage.
//
// Deviation from the spec's `Result<Vec<T>, TaskError>`: std has no generic `Vec<T>` with methods
// yet (`std.alloc.vec` is the erased free-function form), so the group returns this dense array.
pub struct GroupResults<T> {
    pub items: *mut T,
    pub count: usize,
    pub cap_units: usize,
}

impl<T> GroupResults<T> {
    pub fn len(self: view<GroupResults<T>>) -> usize {
        self.count
    }

    pub fn is_empty(self: view<GroupResults<T>>) -> bool {
        self.count == 0usize
    }

    // Pointer to element `i` (`i < len()`), valid while the container lives.
    pub fn get_ptr(self: view<GroupResults<T>>, i: usize) -> *const T {
        unsafe { (self.items + i) as *const T }
    }

    // Remove and return the last element.
    pub fn pop(self: mut_view<GroupResults<T>>) -> Option<T> {
        if self.count == 0usize {
            return Option.None;
        }
        self.count = self.count - 1usize;
        let v: T = unsafe { *(self.items + self.count) };
        Option.Some(v)
    }
}

impl<T> Drop for GroupResults<T> {
    fn drop(self: mut_view<GroupResults<T>>) {
        let items = self.items;
        if (items as usize) == 0 {
            return;
        }
        if needs_drop<T>() {
            let mut i: usize = 0usize;
            while i < self.count {
                unsafe {
                    drop_in_place<T>(items + i);
                }
                i = i + 1usize;
            }
        }
        self.count = 0usize;
        self.items = 0 as *mut T;
        unsafe {
            heap_free(items as *mut u8, self.cap_units * size_of<T>(), align_of<T>());
        }
    }
}

// -----------------------------------------------------------------------------
// TaskGroup<T>
// -----------------------------------------------------------------------------

// Why `spawn` refused a child (the future is dropped without being spawned).
pub enum GroupError {
    Cancelled,
    QuotaExceeded(ResourceKind),
}

// Structured-concurrency scope whose children all produce a `T`.
pub struct TaskGroup<T> {
    pub cancel_source: CancellationSource,
    // Heap array of task headers (null = slot already reaped); `used` slots, `cap` capacity. Each
    // non-null entry holds the reference of the child's `TaskHandle<T>`.
    pub tasks: *mut *mut TaskHeader,
    pub used: usize,
    pub cap: usize,
    // Spawned children whose result has not been collected yet.
    pub live: usize,
    pub failed: bool,
    // Index of the first child observed as panicked (valid when `failed`).
    pub failure_index: usize,
    // `*mut GovInner` with one reference held, or null.
    pub governor: *mut GovInner,
    // Absolute monotonic deadline for the whole group (`u64::MAX` = none) and whether it fired.
    pub deadline_ns: u64,
    pub timed_out: bool,
    // Never read: names `T` (the children's output type) in the layout-independent part.
    pub output_marker: *const T,
}

unsafe impl<T: Send> Send for TaskGroup<T> {}
impl<T> !Copy for TaskGroup<T> {}

fn raw_is_terminal(raw: *mut TaskHeader) -> bool {
    let st: u32 = unsafe { (*raw).state.load(Ordering.Acquire) } & TASK_STATE_MASK;
    st >= TASK_COMPLETED
}

// Take the final result of a terminal task and release the group's reference to it.
fn reap_raw<T>(raw: *mut TaskHeader) -> Result<T, TaskError> {
    let st: u32 = unsafe { (*raw).state.load(Ordering.Acquire) } & TASK_STATE_MASK;
    let res: Result<T, TaskError> = if st == TASK_COMPLETED {
        Result.Ok(unsafe { task_take_output<T>(raw) })
    } else if st == TASK_CANCELLED {
        Result.Err(TaskError.Cancelled)
    } else {
        Result.Err(TaskError.Panicked)
    };
    task_dec_ref(raw);
    res
}

fn group_with<T>(source: CancellationSource, governor: *mut GovInner) -> TaskGroup<T> {
    TaskGroup {
        cancel_source: source,
        tasks: 0 as *mut *mut TaskHeader,
        used: 0usize,
        cap: 0usize,
        live: 0usize,
        failed: false,
        failure_index: 0usize,
        governor: governor,
        deadline_ns: 0xFFFFFFFFFFFFFFFFu64,
        timed_out: false,
        output_marker: 0 as *const T,
    }
}

impl<T> TaskGroup<T> {
    pub fn new() -> TaskGroup<T> {
        group_with<T>(CancellationSource.new(), 0 as *mut GovInner)
    }

    // A group whose cancellation source is a child of `parent_token`: cancelling the parent cancels
    // the group's token (and with it the cooperative children).
    pub fn with_cancellation(parent_token: view<CancellationToken>) -> TaskGroup<T> {
        group_with<T>(CancellationSource.child_of(parent_token), 0 as *mut GovInner)
    }

    // Charge one `Tasks` unit to `gov` per live child (released when the child is collected).
    pub fn with_governor(gov: view<ResourceGovernor>) -> TaskGroup<T> {
        gov_retain(gov.inner);
        group_with<T>(CancellationSource.new(), gov.inner)
    }

    // Bound the whole group by `deadline`: once it passes, the group cancels itself (like
    // `cancel_all`) the next time it is polled. Narrowing only: the earlier of the old and the new
    // deadline wins, so a parent budget can be propagated into every group below it.
    pub fn set_deadline(self: mut_view<TaskGroup<T>>, deadline: Deadline) {
        if deadline.deadline_ns < self.deadline_ns {
            self.deadline_ns = deadline.deadline_ns;
        }
    }

    // True once the group deadline cancelled the group.
    pub fn is_timed_out(self: view<TaskGroup<T>>) -> bool {
        self.timed_out
    }

    pub fn cancellation_token(self: view<TaskGroup<T>>) -> CancellationToken {
        self.cancel_source.token()
    }

    pub fn live_count(self: view<TaskGroup<T>>) -> usize {
        self.live
    }

    pub fn is_failed(self: view<TaskGroup<T>>) -> bool {
        self.failed
    }

    pub fn is_cancelled(self: view<TaskGroup<T>>) -> bool {
        self.cancel_source.is_cancelled()
    }

    fn grow(self: mut_view<TaskGroup<T>>) {
        let new_cap = if self.cap == 0usize { 8usize } else { self.cap * 2usize };
        let word = size_of<*mut TaskHeader>();
        let raw = unsafe { heap_alloc(new_cap * word, word) };
        let fresh = raw as *mut *mut TaskHeader;
        let old = self.tasks;
        let mut i: usize = 0usize;
        while i < new_cap {
            unsafe {
                if i < self.used {
                    *(fresh + i) = *(old + i);
                } else {
                    *(fresh + i) = 0 as *mut TaskHeader;
                }
            }
            i = i + 1usize;
        }
        if (old as usize) != 0 {
            unsafe {
                heap_free(old as *mut u8, self.cap * word, word);
            }
        }
        self.tasks = fresh;
        self.cap = new_cap;
    }

    // Spawn `fut` on `exec` as a child of the group (SPEC-34 AXS-EXEC-020). From now on the group
    // joins, cancels and reaps it. Refused (the future is dropped, nothing is spawned) when the group
    // is cancelled, failed or timed out, or the governor's task quota is full. Returns the child's
    // id; the spec's `spawn` returns nothing, the `Result` only adds the refusal reason.
    pub fn spawn<F: Future<Output = T> + Send>(self: mut_view<TaskGroup<T>>, exec: view<Executor>, fut: F) -> Result<TaskId, GroupError> where T: Send {
        if self.failed || self.timed_out || self.cancel_source.is_cancelled() {
            return Result.Err(GroupError.Cancelled);
        }
        if (self.governor as usize) != 0 {
            if !gov_try_acquire(self.governor, KIND_TASKS, 1u64) {
                return Result.Err(GroupError.QuotaExceeded(ResourceKind.Tasks));
            }
        }
        let mut h: TaskHandle<T> = exec.spawn(fut);
        if self.used == self.cap {
            self.grow();
        }
        let raw = h.raw_task;
        let id = h.task_id;
        // The group takes over the handle's reference: neutralise the handle so its Drop is a no-op.
        h.raw_task = 0 as *mut TaskHeader;
        unsafe {
            *(self.tasks + self.used) = raw;
        }
        self.used = self.used + 1usize;
        self.live = self.live + 1usize;
        Result.Ok(id)
    }

    // Request cancellation of the group: signal the token and ask every unfinished child to stop.
    pub fn cancel_all(self: mut_view<TaskGroup<T>>) {
        self.cancel_source.cancel();
        let mut i: usize = 0usize;
        while i < self.used {
            let raw = unsafe { *(self.tasks + i) };
            if (raw as usize) != 0 {
                if !raw_is_terminal(raw) {
                    task_request_cancel(raw);
                }
            }
            i = i + 1usize;
        }
    }

    // Detect the first panicked child and, on detection, cancel the group (fail-fast); also fire the
    // group deadline.
    fn poll_failure(self: mut_view<TaskGroup<T>>) {
        if !self.timed_out && self.live > 0usize {
            if monotonic_ns() >= self.deadline_ns {
                self.timed_out = true;
                self.cancel_all();
            }
        }
        if self.failed {
            return;
        }
        let mut i: usize = 0usize;
        while i < self.used {
            let raw = unsafe { *(self.tasks + i) };
            if (raw as usize) != 0 {
                let st: u32 = unsafe { (*raw).state.load(Ordering.Acquire) } & TASK_STATE_MASK;
                if st == TASK_PANICKED {
                    self.failed = true;
                    self.failure_index = i;
                    self.cancel_all();
                    return;
                }
            }
            i = i + 1usize;
        }
    }

    // Detach slot `i` from the group (accounting included) and return its task header.
    fn take_slot(self: mut_view<TaskGroup<T>>, i: usize) -> *mut TaskHeader {
        let raw = unsafe { *(self.tasks + i) };
        unsafe {
            *(self.tasks + i) = 0 as *mut TaskHeader;
        }
        self.live = self.live - 1usize;
        if (self.governor as usize) != 0 {
            gov_release_units(self.governor, KIND_TASKS, 1u64);
        }
        raw
    }

    // True when every child still in the group has finished.
    fn all_terminal(self: view<TaskGroup<T>>) -> bool {
        let mut i: usize = 0usize;
        while i < self.used {
            let raw = unsafe { *(self.tasks + i) };
            if (raw as usize) != 0 {
                if !raw_is_terminal(raw) {
                    return false;
                }
            }
            i = i + 1usize;
        }
        true
    }

    // Non-blocking: collect the result of the lowest-index finished child, if any.
    pub fn try_next(self: mut_view<TaskGroup<T>>) -> Option<Result<T, TaskError>> {
        self.poll_failure();
        let mut i: usize = 0usize;
        while i < self.used {
            let raw = unsafe { *(self.tasks + i) };
            if (raw as usize) != 0 {
                if raw_is_terminal(raw) {
                    // A child may have panicked after `poll_failure` scanned but before this scan:
                    // record the failure here (and cancel the siblings) before the slot is reaped.
                    let st: u32 = unsafe { (*raw).state.load(Ordering.Acquire) } & TASK_STATE_MASK;
                    if st == TASK_PANICKED && !self.failed {
                        self.failed = true;
                        self.failure_index = i;
                        self.cancel_all();
                    }
                    let taken = self.take_slot(i);
                    return Option.Some(reap_raw<T>(taken));
                }
            }
            i = i + 1usize;
        }
        Option.None
    }

    // Blocking: wait (yielding the OS thread) for the next finished child; `None` when the group is
    // empty. Must not be called from a thread the children need in order to make progress (use
    // `next()` inside a task).
    pub fn next_blocking(self: mut_view<TaskGroup<T>>) -> Option<Result<T, TaskError>> {
        loop {
            if self.live == 0usize {
                return Option.None;
            }
            let r: Option<Result<T, TaskError>> = self.try_next();
            match r {
                Option.Some(v) => {
                    return Option.Some(v);
                },
                Option.None => {
                    unsafe {
                        thread_yield();
                    }
                },
            }
        }
    }

    // Future of the next finished child (SPEC-34 `async fn next`): `Some(Ok(v))`, `Some(Err(e))`,
    // or `None` once the group is empty. The group must outlive the returned future.
    pub fn next(self: mut_view<TaskGroup<T>>) -> GroupNext<T> {
        let p = unsafe { address_of_mut(*self) as *mut TaskGroup<T> };
        GroupNext { group: p }
    }

    // Wait for every child (SPEC-34 `async fn join_all(self)`): `exec.block_on(group.join_all())`
    // or poll it from inside a task. Ok(outputs in spawn order) when all completed. On the first
    // failure the remaining children are cancelled, all of them are awaited (their futures dropped),
    // and the failure is returned: `Panicked` (a child panicked) or else `Cancelled` (explicit
    // `cancel_all`, group deadline, or a parent token).
    pub fn join_all(self: TaskGroup<T>) -> GroupJoinAll<T> {
        GroupJoinAll { group: self }
    }

    // Collect every child once all are terminal (the body of `GroupJoinAll`).
    fn collect_all(self: mut_view<TaskGroup<T>>) -> Result<GroupResults<T>, TaskError> {
        let n = self.live;
        let cap = if n == 0usize { 1usize } else { n };
        let out_raw = unsafe { heap_alloc(cap * size_of<T>(), align_of<T>()) };
        let out = out_raw as *mut T;
        let mut results = GroupResults {
            items: out,
            count: 0usize,
            cap_units: cap,
        };
        let mut saw_panic = false;
        let mut saw_cancel = false;
        let mut i: usize = 0usize;
        while i < self.used {
            let raw = unsafe { *(self.tasks + i) };
            if (raw as usize) != 0 {
                let taken = self.take_slot(i);
                let r: Result<T, TaskError> = reap_raw<T>(taken);
                match r {
                    Result.Ok(v) => {
                        unsafe {
                            *(out + results.count) = v;
                        }
                        results.count = results.count + 1usize;
                    },
                    Result.Err(e) => {
                        match e {
                            TaskError.Cancelled => {
                                saw_cancel = true;
                            },
                            TaskError.Panicked => {
                                saw_panic = true;
                            },
                        }
                    },
                }
            }
            i = i + 1usize;
        }
        if saw_panic {
            // Failure: the collected outputs are dropped with `results`.
            return Result.Err(TaskError.Panicked);
        }
        if saw_cancel {
            return Result.Err(TaskError.Cancelled);
        }
        Result.Ok(results)
    }
}

impl<T> Drop for TaskGroup<T> {
    fn drop(self: mut_view<TaskGroup<T>>) {
        if (self.tasks as usize) == 0 {
            // Never spawned anything (or already torn down).
            gov_release_ref(self.governor);
            self.governor = 0 as *mut GovInner;
            return;
        }
        self.cancel_all();
        // Drain: every child must reach a terminal state (future dropped) before the group goes away.
        // Outputs of children that completed but were never collected are dropped when the last
        // task reference goes (`default_task_drop` through the child's poll function).
        while self.live > 0usize {
            let mut progressed = false;
            let mut i: usize = 0usize;
            while i < self.used {
                let raw = unsafe { *(self.tasks + i) };
                if (raw as usize) != 0 {
                    if raw_is_terminal(raw) {
                        let taken = self.take_slot(i);
                        task_dec_ref(taken);
                        progressed = true;
                    }
                }
                i = i + 1usize;
            }
            if !progressed {
                unsafe {
                    thread_yield();
                }
            }
        }
        let word = size_of<*mut TaskHeader>();
        unsafe {
            heap_free(self.tasks as *mut u8, self.cap * word, word);
        }
        self.tasks = 0 as *mut *mut TaskHeader;
        gov_release_ref(self.governor);
        self.governor = 0 as *mut GovInner;
    }
}

// Future returned by `TaskGroup.next`.
pub struct GroupNext<T> {
    pub group: *mut TaskGroup<T>,
}

impl<T> Future for GroupNext<T> {
    type Output = Option<Result<T, TaskError>>;

    fn poll(self: mut_view<GroupNext<T>>, cx: mut_view<Context>) -> Poll<Option<Result<T, TaskError>>> {
        let g = self.group;
        if unsafe { (*g).live } == 0usize {
            return Poll.Ready(Option.None);
        }
        let r: Option<Result<T, TaskError>> = unsafe { mut_view(*g).try_next() };
        match r {
            Option.Some(v) => {
                return Poll.Ready(Option.Some(v));
            },
            Option.None => {
                // No wait-queue integration for child completion yet: poll again.
                let w = cx.waker();
                view(w).wake_by_ref();
                return Poll.Pending;
            },
        }
    }
}

// Future returned by `TaskGroup.join_all`; owns the group (dropping it early cancels and drains the
// children like dropping the group).
pub struct GroupJoinAll<T> {
    pub group: TaskGroup<T>,
}

impl<T> Future for GroupJoinAll<T> {
    type Output = Result<GroupResults<T>, TaskError>;

    fn poll(self: mut_view<GroupJoinAll<T>>, cx: mut_view<Context>) -> Poll<Result<GroupResults<T>, TaskError>> {
        mut_view(self.group).poll_failure();
        if !view(self.group).all_terminal() {
            // No wait-queue integration for child completion yet: poll again.
            let w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        Poll.Ready(mut_view(self.group).collect_all())
    }
}
