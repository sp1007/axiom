module std.sync.mutex

use std.core.option.Option
use std.core.host.futex_wait
use std.core.host.futex_wake
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@repr(C)
pub struct Mutex<T> {
    pub state: Atomic<u32>,
    pub data: T,
}

unsafe impl<T: Send> Send for Mutex<T> {}
unsafe impl<T: Send> Share for Mutex<T> {}
impl<T> !Copy for Mutex<T> {}

@repr(C)
pub struct MutexGuardImpl<T> {
    pub lock_ptr: *const Atomic<u32>,
    pub data_ptr: *mut T,
}

pub type MutexGuard<T> = MutexGuardImpl<T>

impl<T> !Copy for MutexGuardImpl<T> {}
impl<T> !Send for MutexGuardImpl<T> {}
unsafe impl<T: Share> Share for MutexGuardImpl<T> {}

impl<T> Mutex<T> {
    pub fn new(val: T) -> Mutex<T> {
        Mutex {
            state: Atomic.new(0u32),
            data: val,
        }
    }

    pub fn lock(self: view<Mutex<T>>) -> MutexGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *mut T = unsafe { address_of(self.data) as *mut T };
        let mut c = unsafe { (*p_state).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if !c.ok {
            if c.val != 2u32 {
                c.val = unsafe { (*p_state).swap(2u32, Ordering.Acquire) };
            }
            while c.val != 0u32 {
                unsafe {
                    futex_wait(p_state as *const u32, 2u32, 0xFFFFFFFFFFFFFFFFu64);
                }
                c.val = unsafe { (*p_state).swap(2u32, Ordering.Acquire) };
            }
        }
        MutexGuardImpl {
            lock_ptr: p_state,
            data_ptr: p_data,
        }
    }

    pub fn lock_ptr(p: *const Mutex<T>) -> MutexGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *mut T = unsafe { address_of_mut((*p).data) };
        let mut c = unsafe { (*p_state).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if !c.ok {
            if c.val != 2u32 {
                c.val = unsafe { (*p_state).swap(2u32, Ordering.Acquire) };
            }
            while c.val != 0u32 {
                unsafe {
                    futex_wait(p_state as *const u32, 2u32, 0xFFFFFFFFFFFFFFFFu64);
                }
                c.val = unsafe { (*p_state).swap(2u32, Ordering.Acquire) };
            }
        }
        MutexGuardImpl {
            lock_ptr: p_state,
            data_ptr: p_data,
        }
    }

    pub fn try_lock(self: view<Mutex<T>>) -> Option<MutexGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *mut T = unsafe { address_of(self.data) as *mut T };
        let cas = unsafe { (*p_state).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(MutexGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            })
        } else {
            Option.None
        }
    }

    pub fn try_lock_ptr(p: *const Mutex<T>) -> Option<MutexGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *mut T = unsafe { address_of_mut((*p).data) };
        let cas = unsafe { (*p_state).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(MutexGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            })
        } else {
            Option.None
        }
    }

    pub fn into_inner(self: Mutex<T>) -> T {
        self.data
    }
}

pub fn mutex_new<T>(val: T) -> Mutex<T> {
    Mutex.new(val)
}

impl<T> MutexGuardImpl<T> {
    pub fn as_ptr(self: view<MutexGuardImpl<T>>) -> *const T {
        self.data_ptr as *const T
    }

    pub fn get_ptr(self: view<MutexGuardImpl<T>>) -> *const T {
        self.data_ptr as *const T
    }

    pub fn as_mut_ptr(self: mut_view<MutexGuardImpl<T>>) -> *mut T {
        self.data_ptr
    }

    pub fn get_mut_ptr(self: mut_view<MutexGuardImpl<T>>) -> *mut T {
        self.data_ptr
    }

    pub fn val(self: view<MutexGuardImpl<T>>) -> T where T: Copy {
        unsafe { *self.data_ptr }
    }

    pub fn set(self: mut_view<MutexGuardImpl<T>>, v: T) {
        unsafe { *self.data_ptr = v; }
    }
}

impl<T> Drop for MutexGuardImpl<T> {
    fn drop(self: mut_view<MutexGuardImpl<T>>) {
        if self.lock_ptr as usize != 0 {
            let p_lock = self.lock_ptr;
            self.lock_ptr = 0 as *const Atomic<u32>;
            self.data_ptr = 0 as *mut T;
            let prev = unsafe { (*p_lock).swap(0u32, Ordering.Release) };
            if prev == 2u32 {
                unsafe {
                    futex_wake(p_lock as *const u32, 1u32);
                }
            }
        }
    }
}
