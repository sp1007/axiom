module std.sync.once

use std.core.option.Option
use std.core.result.Result
use std.core.host.futex_wait
use std.core.host.futex_wake
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic fn forget<T>(val: T) {}
@intrinsic fn panic(msg: str) {}

const ONCE_INCOMPLETE: u32 = 0u32;
const ONCE_RUNNING: u32 = 1u32;
const ONCE_COMPLETE: u32 = 2u32;

@repr(C)
pub struct Once {
    pub state: Atomic<u32>,
}

unsafe impl Send for Once {}
unsafe impl Share for Once {}
impl !Copy for Once {}

impl Once {
    pub fn new() -> Once {
        Once {
            state: Atomic.new(ONCE_INCOMPLETE),
        }
    }

    pub fn call_once<F: FnOnce<()>>(self: view<Once>, f: F) {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        if unsafe { (*p_state).load(Ordering.Acquire) } == ONCE_COMPLETE {
            return;
        }
        loop {
            let s = unsafe { (*p_state).load(Ordering.Acquire) };
            if s == ONCE_COMPLETE {
                return;
            }
            if s == ONCE_INCOMPLETE {
                let cas = unsafe { (*p_state).compare_exchange(ONCE_INCOMPLETE, ONCE_RUNNING, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    f();
                    unsafe {
                        (*p_state).store(ONCE_COMPLETE, Ordering.Release);
                        futex_wake(p_state as *const u32, 0x7FFFFFFFu32);
                    }
                    return;
                }
            } else {
                unsafe {
                    futex_wait(p_state as *const u32, ONCE_RUNNING, 0xFFFFFFFFFFFFFFFFu64);
                }
            }
        }
    }

    pub fn call_once_ptr<F: FnOnce<()>>(p_once: *const Once, f: F) {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p_once).state) };
        if unsafe { (*p_state).load(Ordering.Acquire) } == ONCE_COMPLETE {
            return;
        }
        loop {
            let s = unsafe { (*p_state).load(Ordering.Acquire) };
            if s == ONCE_COMPLETE {
                return;
            }
            if s == ONCE_INCOMPLETE {
                let cas = unsafe { (*p_state).compare_exchange(ONCE_INCOMPLETE, ONCE_RUNNING, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    f();
                    unsafe {
                        (*p_state).store(ONCE_COMPLETE, Ordering.Release);
                        futex_wake(p_state as *const u32, 0x7FFFFFFFu32);
                    }
                    return;
                }
            } else {
                unsafe {
                    futex_wait(p_state as *const u32, ONCE_RUNNING, 0xFFFFFFFFFFFFFFFFu64);
                }
            }
        }
    }

    pub fn is_completed(self: view<Once>) -> bool {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        unsafe { (*p_state).load(Ordering.Acquire) == ONCE_COMPLETE }
    }

    pub fn is_completed_ptr(p_once: *const Once) -> bool {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p_once).state) };
        unsafe { (*p_state).load(Ordering.Acquire) == ONCE_COMPLETE }
    }
}

pub fn once_new() -> Once {
    Once.new()
}

@repr(C)
pub struct OnceCell<T> {
    pub once: Once,
    pub ptr: *mut T,
}

unsafe impl<T: Send> Send for OnceCell<T> {}
unsafe impl<T: Send + Share> Share for OnceCell<T> {}
impl<T> !Copy for OnceCell<T> {}

impl<T> OnceCell<T> {
    pub fn new() -> OnceCell<T> {
        OnceCell {
            once: Once.new(),
            ptr: 0 as *mut T,
        }
    }

    pub fn is_initialized(self: view<OnceCell<T>>) -> bool {
        self.once.is_completed() && (self.ptr as usize) != 0
    }

    pub fn is_initialized_ptr(p_cell: *const OnceCell<T>) -> bool {
        Once.is_completed_ptr(unsafe { address_of((*p_cell).once) }) && (unsafe { (*p_cell).ptr } as usize) != 0
    }

    pub fn wait_init(self: view<OnceCell<T>>) {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.once.state) };
        while unsafe { (*p_state).load(Ordering.Acquire) } == ONCE_RUNNING {
            unsafe {
                futex_wait(p_state as *const u32, ONCE_RUNNING, 0xFFFFFFFFFFFFFFFFu64);
            }
        }
    }

    pub fn wait_init_ptr(p_cell: *const OnceCell<T>) {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p_cell).once.state) };
        while unsafe { (*p_state).load(Ordering.Acquire) } == ONCE_RUNNING {
            unsafe {
                futex_wait(p_state as *const u32, ONCE_RUNNING, 0xFFFFFFFFFFFFFFFFu64);
            }
        }
    }

    pub fn as_ptr(self: view<OnceCell<T>>) -> *const T {
        if self.is_initialized() {
            self.ptr as *const T
        } else {
            0 as *const T
        }
    }

    pub fn get_ptr(self: view<OnceCell<T>>) -> *const T {
        self.as_ptr()
    }

    pub fn as_ptr_ptr(p_cell: *const OnceCell<T>) -> *const T {
        if OnceCell.is_initialized_ptr(p_cell) {
            unsafe { (*p_cell).ptr as *const T }
        } else {
            0 as *const T
        }
    }

    pub fn get_ptr_ptr(p_cell: *const OnceCell<T>) -> *const T {
        OnceCell.as_ptr_ptr(p_cell)
    }

    pub fn val(self: view<OnceCell<T>>) -> Option<T> where T: Copy {
        self.wait_init();
        if self.is_initialized() {
            Option.Some(unsafe { *self.ptr })
        } else {
            Option.None
        }
    }

    pub fn val_ptr(p_cell: *const OnceCell<T>) -> Option<T> where T: Copy {
        OnceCell.wait_init_ptr(p_cell);
        if OnceCell.is_initialized_ptr(p_cell) {
            Option.Some(unsafe { *(*p_cell).ptr })
        } else {
            Option.None
        }
    }

    pub fn set(self: view<OnceCell<T>>, val: T) -> Result<(), T> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.once.state) };
        let cas = unsafe {
            (*p_state).compare_exchange(ONCE_INCOMPLETE, ONCE_RUNNING, Ordering.Acquire, Ordering.Relaxed)
        };
        if cas.ok {
            let sz = size_of<T>();
            let al = align_of<T>();
            let alloc_sz = if sz < 128 { 128 } else { sz };
            let raw = unsafe { heap_alloc(alloc_sz, al) };
            if (raw as usize) == 0 {
                panic("OnceCell.set: out of memory");
            }
            let p = raw as *mut T;
            unsafe {
                *p = val;
                let self_p_ptr = address_of(self.ptr) as *mut *mut T;
                *self_p_ptr = p;
                (*p_state).store(ONCE_COMPLETE, Ordering.Release);
                futex_wake(p_state as *const u32, 0x7FFFFFFFu32);
            }
            Result.Ok(())
        } else {
            Result.Err(val)
        }
    }

    pub fn set_from_ptr(p_cell: *const OnceCell<T>, p_val: *const T, bytes: usize) -> bool {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p_cell).once.state) };
        let cas = unsafe {
            (*p_state).compare_exchange(ONCE_INCOMPLETE, ONCE_RUNNING, Ordering.Acquire, Ordering.Relaxed)
        };
        if cas.ok {
            let alloc_sz = if bytes < 128usize { 128usize } else { bytes };
            let raw = unsafe { heap_alloc(alloc_sz, 8usize) };
            if (raw as usize) == 0 {
                panic("OnceCell.set: out of memory");
            }
            let p = raw as *mut T;
            unsafe {
                ptr_copy_nonoverlapping(p_val as *const u8, p as *mut u8, bytes);
                let self_p_ptr = address_of((*p_cell).ptr) as *mut *mut T;
                *self_p_ptr = p;
                (*p_state).store(ONCE_COMPLETE, Ordering.Release);
                futex_wake(p_state as *const u32, 0x7FFFFFFFu32);
            }
            true
        } else {
            false
        }
    }

    pub fn set_ptr(p_cell: *const OnceCell<T>, val: T) -> Result<(), T> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p_cell).once.state) };
        let cas = unsafe {
            (*p_state).compare_exchange(ONCE_INCOMPLETE, ONCE_RUNNING, Ordering.Acquire, Ordering.Relaxed)
        };
        if cas.ok {
            let sz = size_of<T>();
            let al = align_of<T>();
            let alloc_sz = if sz < 128 { 128 } else { sz };
            let raw = unsafe { heap_alloc(alloc_sz, al) };
            if (raw as usize) == 0 {
                panic("OnceCell.set: out of memory");
            }
            let p = raw as *mut T;
            unsafe {
                *p = val;
                let self_p_ptr = address_of((*p_cell).ptr) as *mut *mut T;
                *self_p_ptr = p;
                (*p_state).store(ONCE_COMPLETE, Ordering.Release);
                futex_wake(p_state as *const u32, 0x7FFFFFFFu32);
            }
            Result.Ok(())
        } else {
            Result.Err(val)
        }
    }

    pub fn set_from_ptr(p_cell: *const OnceCell<T>, p_val: *const T, bytes: usize) -> bool {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p_cell).once.state) };
        let cas = unsafe {
            (*p_state).compare_exchange(ONCE_INCOMPLETE, ONCE_RUNNING, Ordering.Acquire, Ordering.Relaxed)
        };
        if cas.ok {
            let alloc_sz = if bytes < 128usize { 128usize } else { bytes };
            let raw = unsafe { heap_alloc(alloc_sz, 8usize) };
            if (raw as usize) == 0 {
                panic("OnceCell.set: out of memory");
            }
            let p = raw as *mut T;
            unsafe {
                ptr_copy_nonoverlapping(p_val as *const u8, p as *mut u8, bytes);
                let self_p_ptr = address_of((*p_cell).ptr) as *mut *mut T;
                *self_p_ptr = p;
                (*p_state).store(ONCE_COMPLETE, Ordering.Release);
                futex_wake(p_state as *const u32, 0x7FFFFFFFu32);
            }
            true
        } else {
            false
        }
    }

    pub fn into_inner(mut self: OnceCell<T>) -> Option<T> {
        if self.is_initialized() {
            let p = self.ptr;
            self.ptr = 0 as *mut T;
            let mut tmp: [1]T = unsafe { [*p] };
            let sz = size_of<T>();
            let al = align_of<T>();
            let alloc_sz = if sz < 128 { 128 } else { sz };
            unsafe {
                heap_free(p as *mut u8, alloc_sz, al);
            }
            Option.Some(tmp[0])
        } else {
            Option.None
        }
    }
}

impl<T> Drop for OnceCell<T> {
    fn drop(self: mut_view<OnceCell<T>>) {
        if self.once.is_completed() && (self.ptr as usize) != 0 {
            let p = self.ptr;
            self.ptr = 0 as *mut T;
            unsafe { drop_in_place<T>(p); }
            let sz = size_of<T>();
            let al = align_of<T>();
            let alloc_sz = if sz < 128 { 128 } else { sz };
            unsafe {
                heap_free(p as *mut u8, alloc_sz, al);
            }
        }
    }
}

pub fn once_cell_new<T>() -> OnceCell<T> {
    OnceCell.new()
}
