module std.sync.barrier

use std.core.host.futex_wait
use std.core.host.futex_wake
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic fn panic(msg: str) {}

@repr(C)
pub struct BarrierWaitResult {
    pub is_leader: bool,
}

impl Copy for BarrierWaitResult {}

impl BarrierWaitResult {
    pub fn is_leader(self: view<BarrierWaitResult>) -> bool {
        self.is_leader
    }
}

@repr(C)
pub struct Barrier {
    pub num_threads: usize,
    pub count: Atomic<usize>,
    pub generation: Atomic<u32>,
}

unsafe impl Send for Barrier {}
unsafe impl Share for Barrier {}
impl !Copy for Barrier {}

impl Barrier {
    pub fn new(count: usize) -> Barrier {
        if count == 0usize {
            panic("Barrier.new: count must be non-zero");
        }
        Barrier {
            num_threads: count,
            count: Atomic.new(0usize),
            generation: Atomic.new(0u32),
        }
    }

    pub fn wait(self: view<Barrier>) -> BarrierWaitResult {
        let p_gen: *const Atomic<u32> = unsafe { address_of(self.generation) };
        let p_count: *const Atomic<usize> = unsafe { address_of(self.count) };
        let local_gen = unsafe { (*p_gen).load(Ordering.Relaxed) };
        let arrived = unsafe { (*p_count).fetch_add(1usize, Ordering.AcqRel) + 1usize };
        if arrived == self.num_threads {
            unsafe {
                (*p_count).store(0usize, Ordering.Relaxed);
                (*p_gen).store(local_gen + 1u32, Ordering.Release);
                futex_wake(p_gen as *const u32, 0x7FFFFFFFu32);
            }
            BarrierWaitResult { is_leader: true }
        } else {
            while unsafe { (*p_gen).load(Ordering.Acquire) } == local_gen {
                unsafe {
                    futex_wait(p_gen as *const u32, local_gen, 0xFFFFFFFFFFFFFFFFu64);
                }
            }
            BarrierWaitResult { is_leader: false }
        }
    }

    pub fn wait_ptr(p_barrier: *const Barrier) -> BarrierWaitResult {
        let p_gen: *const Atomic<u32> = unsafe { address_of((*p_barrier).generation) };
        let p_count: *const Atomic<usize> = unsafe { address_of((*p_barrier).count) };
        let local_gen = unsafe { (*p_gen).load(Ordering.Relaxed) };
        let arrived = unsafe { (*p_count).fetch_add(1usize, Ordering.AcqRel) + 1usize };
        let num = unsafe { (*p_barrier).num_threads };
        if arrived == num {
            unsafe {
                (*p_count).store(0usize, Ordering.Relaxed);
                (*p_gen).store(local_gen + 1u32, Ordering.Release);
                futex_wake(p_gen as *const u32, 0x7FFFFFFFu32);
            }
            BarrierWaitResult { is_leader: true }
        } else {
            while unsafe { (*p_gen).load(Ordering.Acquire) } == local_gen {
                unsafe {
                    futex_wait(p_gen as *const u32, local_gen, 0xFFFFFFFFFFFFFFFFu64);
                }
            }
            BarrierWaitResult { is_leader: false }
        }
    }
}

pub fn barrier_new(count: usize) -> Barrier {
    Barrier.new(count)
}
