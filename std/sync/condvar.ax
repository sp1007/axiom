module std.sync.condvar

use std.core.host.futex_wait
use std.core.host.futex_wake
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.sync.mutex.MutexGuardImpl
use std.sync.mutex.MutexGuard

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@repr(C)
pub struct Condvar {
    pub seq: Atomic<u32>,
}

unsafe impl Send for Condvar {}
unsafe impl Share for Condvar {}
impl !Copy for Condvar {}

@repr(C)
pub struct CondvarWaitResult<T> {
    pub guard: MutexGuard<T>,
    pub timed_out: bool,
}

impl<T> CondvarWaitResult<T> {
    pub fn is_timed_out(self: view<CondvarWaitResult<T>>) -> bool {
        self.timed_out
    }
}

impl Condvar {
    pub fn new() -> Condvar {
        Condvar {
            seq: Atomic.new(0u32),
        }
    }

    pub fn wait<T>(self: view<Condvar>, mut guard: MutexGuard<T>) -> MutexGuard<T> {
        let p_seq: *const Atomic<u32> = unsafe { address_of(self.seq) };
        let seq_val = unsafe { (*p_seq).load(Ordering.Relaxed) };
        let p_lock = guard.lock_ptr;
        let p_data = guard.data_ptr;
        guard.lock_ptr = 0 as *const Atomic<u32>;
        guard.data_ptr = 0 as *mut T;
        let prev = unsafe { (*p_lock).swap(0u32, Ordering.Release) };
        if prev == 2u32 {
            unsafe {
                futex_wake(p_lock as *const u32, 1u32);
            }
        }
        unsafe {
            futex_wait(p_seq as *const u32, seq_val, 0xFFFFFFFFFFFFFFFFu64);
        }
        let mut c = unsafe { (*p_lock).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if !c.ok {
            if c.val != 2u32 {
                c.val = unsafe { (*p_lock).swap(2u32, Ordering.Acquire) };
            }
            while c.val != 0u32 {
                unsafe {
                    futex_wait(p_lock as *const u32, 2u32, 0xFFFFFFFFFFFFFFFFu64);
                }
                c.val = unsafe { (*p_lock).swap(2u32, Ordering.Acquire) };
            }
        }
        MutexGuardImpl {
            lock_ptr: p_lock,
            data_ptr: p_data,
        }
    }

    pub fn wait_timeout_ms<T>(self: view<Condvar>, mut guard: MutexGuard<T>, timeout_ms: u64) -> CondvarWaitResult<T> {
        let p_seq: *const Atomic<u32> = unsafe { address_of(self.seq) };
        let seq_val = unsafe { (*p_seq).load(Ordering.Relaxed) };
        let p_lock = guard.lock_ptr;
        let p_data = guard.data_ptr;
        guard.lock_ptr = 0 as *const Atomic<u32>;
        guard.data_ptr = 0 as *mut T;
        let prev = unsafe { (*p_lock).swap(0u32, Ordering.Release) };
        if prev == 2u32 {
            unsafe {
                futex_wake(p_lock as *const u32, 1u32);
            }
        }
        let timeout_ns = timeout_ms * 1_000_000u64;
        let rc = unsafe {
            futex_wait(p_seq as *const u32, seq_val, timeout_ns)
        };
        let timed_out = rc == -5i64;
        let mut c = unsafe { (*p_lock).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if !c.ok {
            if c.val != 2u32 {
                c.val = unsafe { (*p_lock).swap(2u32, Ordering.Acquire) };
            }
            while c.val != 0u32 {
                unsafe {
                    futex_wait(p_lock as *const u32, 2u32, 0xFFFFFFFFFFFFFFFFu64);
                }
                c.val = unsafe { (*p_lock).swap(2u32, Ordering.Acquire) };
            }
        }
        CondvarWaitResult {
            guard: MutexGuardImpl {
                lock_ptr: p_lock,
                data_ptr: p_data,
            },
            timed_out: timed_out,
        }
    }

    pub fn notify_one(self: view<Condvar>) {
        let p_seq: *const Atomic<u32> = unsafe { address_of(self.seq) };
        unsafe {
            (*p_seq).fetch_add(1u32, Ordering.Release);
            futex_wake(p_seq as *const u32, 1u32);
        }
    }

    pub fn notify_all(self: view<Condvar>) {
        let p_seq: *const Atomic<u32> = unsafe { address_of(self.seq) };
        unsafe {
            (*p_seq).fetch_add(1u32, Ordering.Release);
            futex_wake(p_seq as *const u32, 0x7FFFFFFFu32);
        }
    }

    pub fn wait_ptr<T>(p_cond: *const Condvar, mut guard: MutexGuard<T>) -> MutexGuard<T> {
        let p_seq: *const Atomic<u32> = unsafe { address_of((*p_cond).seq) };
        let seq_val = unsafe { (*p_seq).load(Ordering.Relaxed) };
        let p_lock = guard.lock_ptr;
        let p_data = guard.data_ptr;
        guard.lock_ptr = 0 as *const Atomic<u32>;
        guard.data_ptr = 0 as *mut T;
        let prev = unsafe { (*p_lock).swap(0u32, Ordering.Release) };
        if prev == 2u32 {
            unsafe {
                futex_wake(p_lock as *const u32, 1u32);
            }
        }
        unsafe {
            futex_wait(p_seq as *const u32, seq_val, 0xFFFFFFFFFFFFFFFFu64);
        }
        let mut c = unsafe { (*p_lock).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if !c.ok {
            if c.val != 2u32 {
                c.val = unsafe { (*p_lock).swap(2u32, Ordering.Acquire) };
            }
            while c.val != 0u32 {
                unsafe {
                    futex_wait(p_lock as *const u32, 2u32, 0xFFFFFFFFFFFFFFFFu64);
                }
                c.val = unsafe { (*p_lock).swap(2u32, Ordering.Acquire) };
            }
        }
        MutexGuardImpl {
            lock_ptr: p_lock,
            data_ptr: p_data,
        }
    }

    pub fn wait_timeout_ms_ptr<T>(p_cond: *const Condvar, mut guard: MutexGuard<T>, timeout_ms: u64) -> CondvarWaitResult<T> {
        let p_seq: *const Atomic<u32> = unsafe { address_of((*p_cond).seq) };
        let seq_val = unsafe { (*p_seq).load(Ordering.Relaxed) };
        let p_lock = guard.lock_ptr;
        let p_data = guard.data_ptr;
        guard.lock_ptr = 0 as *const Atomic<u32>;
        guard.data_ptr = 0 as *mut T;
        let prev = unsafe { (*p_lock).swap(0u32, Ordering.Release) };
        if prev == 2u32 {
            unsafe {
                futex_wake(p_lock as *const u32, 1u32);
            }
        }
        let timeout_ns = timeout_ms * 1_000_000u64;
        let rc = unsafe {
            futex_wait(p_seq as *const u32, seq_val, timeout_ns)
        };
        let timed_out = rc == -5i64;
        let mut c = unsafe { (*p_lock).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if !c.ok {
            if c.val != 2u32 {
                c.val = unsafe { (*p_lock).swap(2u32, Ordering.Acquire) };
            }
            while c.val != 0u32 {
                unsafe {
                    futex_wait(p_lock as *const u32, 2u32, 0xFFFFFFFFFFFFFFFFu64);
                }
                c.val = unsafe { (*p_lock).swap(2u32, Ordering.Acquire) };
            }
        }
        CondvarWaitResult {
            guard: MutexGuardImpl {
                lock_ptr: p_lock,
                data_ptr: p_data,
            },
            timed_out: timed_out,
        }
    }

    pub fn notify_one_ptr(p_cond: *const Condvar) {
        let p_seq: *const Atomic<u32> = unsafe { address_of((*p_cond).seq) };
        unsafe {
            (*p_seq).fetch_add(1u32, Ordering.Release);
            futex_wake(p_seq as *const u32, 1u32);
        }
    }

    pub fn notify_all_ptr(p_cond: *const Condvar) {
        let p_seq: *const Atomic<u32> = unsafe { address_of((*p_cond).seq) };
        unsafe {
            (*p_seq).fetch_add(1u32, Ordering.Release);
            futex_wake(p_seq as *const u32, 0x7FFFFFFFu32);
        }
    }
}

pub fn condvar_new() -> Condvar {
    Condvar.new()
}
