module std.sync.rwlock

use std.core.option.Option
use std.core.host.futex_wait
use std.core.host.futex_wake
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

const WRITER_LOCKED: u32 = 0x80000000u32;
const WRITER_WAITING: u32 = 0x40000000u32;
const READER_MASK: u32 = 0x3FFFFFFFu32;

@repr(C)
pub struct RwLock<T> {
    pub state: Atomic<u32>,
    pub data: T,
}

unsafe impl<T: Send> Send for RwLock<T> {}
unsafe impl<T: Send + Share> Share for RwLock<T> {}
impl<T> !Copy for RwLock<T> {}

@repr(C)
pub struct RwLockReadGuardImpl<T> {
    pub lock_ptr: *const Atomic<u32>,
    pub data_ptr: *const T,
}

pub type RwLockReadGuard<T> = RwLockReadGuardImpl<T>

impl<T> !Copy for RwLockReadGuardImpl<T> {}
impl<T> !Send for RwLockReadGuardImpl<T> {}
unsafe impl<T: Share> Share for RwLockReadGuardImpl<T> {}

@repr(C)
pub struct RwLockWriteGuardImpl<T> {
    pub lock_ptr: *const Atomic<u32>,
    pub data_ptr: *mut T,
}

pub type RwLockWriteGuard<T> = RwLockWriteGuardImpl<T>

impl<T> !Copy for RwLockWriteGuardImpl<T> {}
impl<T> !Send for RwLockWriteGuardImpl<T> {}
unsafe impl<T: Share> Share for RwLockWriteGuardImpl<T> {}

impl<T> RwLock<T> {
    pub fn new(val: T) -> RwLock<T> {
        RwLock {
            state: Atomic.new(0u32),
            data: val,
        }
    }

    pub fn read(self: view<RwLock<T>>) -> RwLockReadGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *const T = unsafe { address_of(self.data) };
        loop {
            let s = unsafe { (*p_state).load(Ordering.Relaxed) };
            if (s & (WRITER_LOCKED | WRITER_WAITING)) == 0u32 {
                let cas = unsafe { (*p_state).compare_exchange_weak(s, s + 1u32, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    return RwLockReadGuardImpl {
                        lock_ptr: p_state,
                        data_ptr: p_data,
                    };
                }
            } else {
                unsafe {
                    futex_wait(p_state as *const u32, s, 0xFFFFFFFFFFFFFFFFu64);
                }
            }
        }
    }

    pub fn read_ptr(p: *const RwLock<T>) -> RwLockReadGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *const T = unsafe { address_of((*p).data) };
        loop {
            let s = unsafe { (*p_state).load(Ordering.Relaxed) };
            if (s & (WRITER_LOCKED | WRITER_WAITING)) == 0u32 {
                let cas = unsafe { (*p_state).compare_exchange_weak(s, s + 1u32, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    return RwLockReadGuardImpl {
                        lock_ptr: p_state,
                        data_ptr: p_data,
                    };
                }
            } else {
                unsafe {
                    futex_wait(p_state as *const u32, s, 0xFFFFFFFFFFFFFFFFu64);
                }
            }
        }
    }

    pub fn try_read(self: view<RwLock<T>>) -> Option<RwLockReadGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *const T = unsafe { address_of(self.data) };
        let s = unsafe { (*p_state).load(Ordering.Relaxed) };
        if (s & (WRITER_LOCKED | WRITER_WAITING)) == 0u32 {
            let cas = unsafe { (*p_state).compare_exchange(s, s + 1u32, Ordering.Acquire, Ordering.Relaxed) };
            if cas.ok {
                return Option.Some(RwLockReadGuardImpl {
                    lock_ptr: p_state,
                    data_ptr: p_data,
                });
            }
        }
        Option.None
    }

    pub fn try_read_ptr(p: *const RwLock<T>) -> Option<RwLockReadGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *const T = unsafe { address_of((*p).data) };
        let s = unsafe { (*p_state).load(Ordering.Relaxed) };
        if (s & (WRITER_LOCKED | WRITER_WAITING)) == 0u32 {
            let cas = unsafe { (*p_state).compare_exchange(s, s + 1u32, Ordering.Acquire, Ordering.Relaxed) };
            if cas.ok {
                return Option.Some(RwLockReadGuardImpl {
                    lock_ptr: p_state,
                    data_ptr: p_data,
                });
            }
        }
        Option.None
    }

    pub fn write(self: view<RwLock<T>>) -> RwLockWriteGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *mut T = unsafe { address_of(self.data) as *mut T };
        if unsafe { (*p_state).compare_exchange(0u32, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) }.ok {
            return RwLockWriteGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            };
        }
        loop {
            let s = unsafe { (*p_state).load(Ordering.Relaxed) };
            if s == 0u32 || s == WRITER_WAITING {
                let cas = unsafe { (*p_state).compare_exchange_weak(s, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    return RwLockWriteGuardImpl {
                        lock_ptr: p_state,
                        data_ptr: p_data,
                    };
                }
            } else {
                if (s & WRITER_WAITING) == 0u32 {
                    let _ = unsafe { (*p_state).compare_exchange_weak(s, s | WRITER_WAITING, Ordering.Relaxed, Ordering.Relaxed) };
                } else {
                    unsafe {
                        futex_wait(p_state as *const u32, s, 0xFFFFFFFFFFFFFFFFu64);
                    }
                }
            }
        }
    }

    pub fn write_ptr(p: *const RwLock<T>) -> RwLockWriteGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *mut T = unsafe { address_of_mut((*p).data) };
        if unsafe { (*p_state).compare_exchange(0u32, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) }.ok {
            return RwLockWriteGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            };
        }
        loop {
            let s = unsafe { (*p_state).load(Ordering.Relaxed) };
            if s == 0u32 || s == WRITER_WAITING {
                let cas = unsafe { (*p_state).compare_exchange_weak(s, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    return RwLockWriteGuardImpl {
                        lock_ptr: p_state,
                        data_ptr: p_data,
                    };
                }
            } else {
                if (s & WRITER_WAITING) == 0u32 {
                    let _ = unsafe { (*p_state).compare_exchange_weak(s, s | WRITER_WAITING, Ordering.Relaxed, Ordering.Relaxed) };
                } else {
                    unsafe {
                        futex_wait(p_state as *const u32, s, 0xFFFFFFFFFFFFFFFFu64);
                    }
                }
            }
        }
    }

    pub fn try_write(self: view<RwLock<T>>) -> Option<RwLockWriteGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *mut T = unsafe { address_of(self.data) as *mut T };
        let cas = unsafe { (*p_state).compare_exchange(0u32, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(RwLockWriteGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            })
        } else {
            Option.None
        }
    }

    pub fn try_write_ptr(p: *const RwLock<T>) -> Option<RwLockWriteGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *mut T = unsafe { address_of_mut((*p).data) };
        let cas = unsafe { (*p_state).compare_exchange(0u32, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(RwLockWriteGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            })
        } else {
            Option.None
        }
    }

    pub fn into_inner(self: RwLock<T>) -> T {
        self.data
    }
}

pub fn rwlock_new<T>(val: T) -> RwLock<T> {
    RwLock.new(val)
}

impl<T> RwLockReadGuardImpl<T> {
    pub fn as_ptr(self: view<RwLockReadGuardImpl<T>>) -> *const T {
        self.data_ptr
    }

    pub fn get_ptr(self: view<RwLockReadGuardImpl<T>>) -> *const T {
        self.data_ptr
    }

    pub fn val(self: view<RwLockReadGuardImpl<T>>) -> T where T: Copy {
        unsafe { *self.data_ptr }
    }
}

impl<T> Drop for RwLockReadGuardImpl<T> {
    fn drop(self: mut_view<RwLockReadGuardImpl<T>>) {
        if self.lock_ptr as usize != 0 {
            let p_lock = self.lock_ptr;
            self.lock_ptr = 0 as *const Atomic<u32>;
            self.data_ptr = 0 as *const T;
            let mask_inv = 0xFFFFFFFFu32 ^ READER_MASK;
            loop {
                let s = unsafe { (*p_lock).load(Ordering.Relaxed) };
                let readers = s & READER_MASK;
                if readers == 0u32 {
                    break;
                }
                let new_s = (s & mask_inv) | (readers - 1u32);
                let cas = unsafe { (*p_lock).compare_exchange_weak(s, new_s, Ordering.Release, Ordering.Relaxed) };
                if cas.ok {
                    if readers == 1u32 && (s & WRITER_WAITING) != 0u32 {
                        unsafe {
                            futex_wake(p_lock as *const u32, 1u32);
                        }
                    }
                    break;
                }
            }
        }
    }
}

impl<T> RwLockWriteGuardImpl<T> {
    pub fn as_ptr(self: view<RwLockWriteGuardImpl<T>>) -> *const T {
        self.data_ptr as *const T
    }

    pub fn get_ptr(self: view<RwLockWriteGuardImpl<T>>) -> *const T {
        self.data_ptr as *const T
    }

    pub fn as_mut_ptr(self: mut_view<RwLockWriteGuardImpl<T>>) -> *mut T {
        self.data_ptr
    }

    pub fn get_mut_ptr(self: mut_view<RwLockWriteGuardImpl<T>>) -> *mut T {
        self.data_ptr
    }

    pub fn val(self: view<RwLockWriteGuardImpl<T>>) -> T where T: Copy {
        unsafe { *self.data_ptr }
    }

    pub fn set(self: mut_view<RwLockWriteGuardImpl<T>>, v: T) {
        unsafe { *self.data_ptr = v; }
    }
}

impl<T> Drop for RwLockWriteGuardImpl<T> {
    fn drop(self: mut_view<RwLockWriteGuardImpl<T>>) {
        if self.lock_ptr as usize != 0 {
            let p_lock = self.lock_ptr;
            self.lock_ptr = 0 as *const Atomic<u32>;
            self.data_ptr = 0 as *mut T;
            let _ = unsafe { (*p_lock).swap(0u32, Ordering.Release) };
            unsafe {
                futex_wake(p_lock as *const u32, 0x7FFFFFFFu32);
            }
        }
    }
}
