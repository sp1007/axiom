module std.time

use std.core.host.monotonic_ns

pub struct Duration {
    pub nanos: u64,
}

pub fn duration_from_nanos(nanos: u64) -> Duration {
    Duration { nanos: nanos }
}

pub fn duration_from_millis(millis: u64) -> Duration {
    Duration { nanos: millis * 1_000_000u64 }
}

pub fn duration_from_secs(secs: u64) -> Duration {
    Duration { nanos: secs * 1_000_000_000u64 }
}

pub fn duration_as_nanos(d: view<Duration>) -> u64 {
    d.nanos
}

pub fn duration_as_millis(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000u64
}

pub fn duration_as_secs(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000_000u64
}

impl Duration {
    pub fn from_nanos(nanos: u64) -> Duration { duration_from_nanos(nanos) }
    pub fn from_millis(millis: u64) -> Duration { duration_from_millis(millis) }
    pub fn from_secs(secs: u64) -> Duration { duration_from_secs(secs) }
    pub fn as_nanos(self: view<Duration>) -> u64 { duration_as_nanos(self) }
    pub fn as_millis(self: view<Duration>) -> u64 { duration_as_millis(self) }
    pub fn as_secs(self: view<Duration>) -> u64 { duration_as_secs(self) }
}

pub struct Instant {
    pub nanos: u64,
}

pub fn instant_now() -> Instant {
    let t = monotonic_ns();
    Instant { nanos: t }
}

pub fn instant_duration_since(self: view<Instant>, earlier: view<Instant>) -> Duration {
    if self.nanos >= earlier.nanos {
        Duration { nanos: self.nanos - earlier.nanos }
    } else {
        Duration { nanos: 0u64 }
    }
}

pub fn instant_elapsed(self: view<Instant>) -> Duration {
    let now = instant_now();
    instant_duration_since(view(now), self)
}

pub fn instant_as_nanos(self: view<Instant>) -> u64 {
    self.nanos
}

pub fn instant_as_millis(self: view<Instant>) -> u64 {
    self.nanos / 1_000_000u64
}

pub fn instant_as_secs(self: view<Instant>) -> u64 {
    self.nanos / 1_000_000_000u64
}

impl Instant {
    pub fn now() -> Instant { instant_now() }
    pub fn duration_since(self: view<Instant>, earlier: view<Instant>) -> Duration { instant_duration_since(self, earlier) }
    pub fn elapsed(self: view<Instant>) -> Duration { instant_elapsed(self) }
}
