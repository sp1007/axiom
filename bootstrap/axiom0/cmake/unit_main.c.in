/* GENERATED by CMake (cmake/AxiomTests.cmake) from the AX_TEST(name) markers found in
 * the .c files below tests/unit. Do not edit.
 *
 * usage: axiom0-unit [--list] [test-name...]     exit 0 all passed, 1 a check failed, 2 usage error */
#include <stdarg.h>
#include <stdio.h>
#include <string.h>

#include "driver/driver.h"

static int ax_unit_failure_count;

void ax_unit_failf(const char *file, int line, const char *fmt, ...) {
    va_list ap;
    ++ax_unit_failure_count;
    fprintf(stdout, "  %s:%d: ", file, line);
    va_start(ap, fmt);
    vfprintf(stdout, fmt, ap);
    va_end(ap);
    fputc('\n', stdout);
}

@AX_UNIT_DECLS@
typedef struct UnitCase {
    const char *name;
    void (*fn)(void);
} UnitCase;

static const UnitCase unit_cases[] = {
@AX_UNIT_TABLE@    {NULL, NULL}};

int main(int argc, char **argv) {
    ax_io_set_binary();
    int list_only = 0;
    int selected = 0;
    for (int i = 1; i < argc; ++i) {
        if (strcmp(argv[i], "--list") == 0) {
            list_only = 1;
            continue;
        }
        int known = 0;
        for (const UnitCase *c = unit_cases; c->name != NULL; ++c) {
            known = known || strcmp(c->name, argv[i]) == 0;
        }
        if (!known) {
            fprintf(stderr, "axiom0-unit: unknown test '%s'\n", argv[i]);
            return 2;
        }
        ++selected;
    }

    int run = 0;
    int failed = 0;
    for (const UnitCase *c = unit_cases; c->name != NULL; ++c) {
        if (selected > 0) {
            int wanted = 0;
            for (int i = 1; i < argc; ++i) {
                wanted = wanted || strcmp(c->name, argv[i]) == 0;
            }
            if (!wanted) {
                continue;
            }
        }
        if (list_only) {
            puts(c->name);
            continue;
        }
        int before = ax_unit_failure_count;
        c->fn();
        ++run;
        if (ax_unit_failure_count != before) {
            ++failed;
            printf("FAIL %s\n", c->name);
        } else {
            printf("PASS %s\n", c->name);
        }
    }
    if (list_only) {
        return 0;
    }
    printf("UNIT %d tests, %d failed\n", run, failed);
    fflush(stdout);
    return failed == 0 ? 0 : 1;
}
