# C tests (T004). Nobody lists test files by hand and nobody edits CMakeLists.txt.
#
#   tests/unit/<any>.c          all compiled into `axiom0-unit`; the AX_TEST(name) markers in them
#                               are collected into a generated main() (tests/unit/unit.h)
#   tests/<any>/cdriver_<n>.c   each built into its own executable `ct_<path>` (own main())
#
# Files under a `fixtures` directory are test data, never compiled. With no such files nothing
# is created and the build still succeeds.
#
# ax_add_c_tests(<core-library> <repo-root> <out-dir>)

function(ax_add_c_tests core_lib repo_root generated_dir)
  set(tests_dir "${repo_root}/tests")
  file(GLOB_RECURSE all_tests CONFIGURE_DEPENDS "${tests_dir}/*.c")
  list(SORT all_tests)

  set(unit_sources "")
  set(cdriver_sources "")
  foreach(f IN LISTS all_tests)
    if(f MATCHES "/fixtures/")
      continue()
    endif()
    get_filename_component(base "${f}" NAME)
    if(base MATCHES "^cdriver_")
      list(APPEND cdriver_sources "${f}")
    elseif(f MATCHES "^${tests_dir}/unit/")
      list(APPEND unit_sources "${f}")
    endif()
  endforeach()

  if(unit_sources)
    set(decls "")
    set(table "")
    set(seen "")
    foreach(f IN LISTS unit_sources)
      # Re-run CMake when a unit test file changes: it may have gained or lost an AX_TEST.
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${f}")
      file(STRINGS "${f}" markers REGEX "^AX_TEST\\([A-Za-z0-9_]+\\)")
      foreach(line IN LISTS markers)
        string(REGEX REPLACE "^AX_TEST\\(([A-Za-z0-9_]+)\\).*$" "\\1" name "${line}")
        if(name IN_LIST seen)
          message(FATAL_ERROR "${f}: duplicate unit test name '${name}'")
        endif()
        list(APPEND seen "${name}")
        string(APPEND decls "void axut_${name}(void);\n")
        string(APPEND table "    {\"${name}\", axut_${name}},\n")
      endforeach()
    endforeach()
    set(AX_UNIT_DECLS "${decls}")
    set(AX_UNIT_TABLE "${table}")
    set(unit_main "${generated_dir}/unit_main.c")
    configure_file("${AX_CMAKE_DIR}/unit_main.c.in" "${unit_main}" @ONLY)

    add_executable(axiom0-unit ${unit_sources} "${unit_main}")
    target_include_directories(axiom0-unit PRIVATE "${tests_dir}/unit")
    target_link_libraries(axiom0-unit PRIVATE ${core_lib} ax_flags)
    set_target_properties(axiom0-unit PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
    add_test(NAME axiom0-unit COMMAND axiom0-unit)
  endif()

  foreach(f IN LISTS cdriver_sources)
    file(RELATIVE_PATH rel "${tests_dir}" "${f}")
    string(REGEX REPLACE "\\.c$" "" rel "${rel}")
    string(REGEX REPLACE "[^A-Za-z0-9_]" "_" tname "ct_${rel}")
    if(TARGET ${tname})
      message(FATAL_ERROR "${f}: test executable name '${tname}' is not unique")
    endif()
    add_executable(${tname} "${f}")
    target_include_directories(${tname} PRIVATE "${tests_dir}/unit")
    target_link_libraries(${tname} PRIVATE ${core_lib} ax_flags)
    set_target_properties(${tname} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/tests")
    add_test(NAME ${tname} COMMAND ${tname})
  endforeach()
endfunction()
