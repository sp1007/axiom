AX_DIAG(AX_NAME_UNRESOLVED, ERROR, "name not found in scope")
AX_DIAG(AX_NAME_DUPLICATE, ERROR, "name defined twice in one scope")
AX_DIAG(AX_NAME_NOT_A_VALUE, ERROR, "a module or type used where a value is expected")
AX_DIAG(AX_NAME_NOT_A_TYPE, ERROR, "a value or module used where a type is expected")
AX_DIAG(AX_NAME_UNRESOLVED_IMPORT, ERROR, "use path does not name an existing item or module")
AX_DIAG(AX_NAME_SHADOW_MODULE, WARNING, "a local binding shadows a module name (lookup order still picks the local)")
AX_DIAG(AX_NAME_UNDEFINED_LABEL, ERROR, "break / continue names an unknown label")
AX_DIAG(AX_NAME_BREAK_OUTSIDE_LOOP, ERROR, "break or continue outside a loop")
AX_DIAG(AX_NAME_NOT_YET_SUPPORTED, ERROR, "construct parsed but not lowered by this build yet (AXD-014)")
AX_DIAG(AX_NAME_DUPLICATE_BINDING, ERROR, "duplicate binding in pattern")
AX_DIAG(AX_NAME_OR_PATTERN_MISMATCH, ERROR, "inconsistent or-pattern bindings")
AX_DIAG(AX_NAME_PRIVATE, ERROR, "item or member is private")
AX_DIAG(AX_NAME_IMPORT_CYCLE, ERROR, "cyclic import detected")
