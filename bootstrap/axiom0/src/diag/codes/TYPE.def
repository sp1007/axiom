AX_DIAG(AX_TYPE_MISMATCH, ERROR, "expression type differs from the expected type")
AX_DIAG(AX_TYPE_UNKNOWN, ERROR, "the type cannot be inferred; add an annotation")
AX_DIAG(AX_TYPE_NOT_CALLABLE, ERROR, "callee is not a function")
AX_DIAG(AX_TYPE_ARG_COUNT, ERROR, "wrong number of arguments")
AX_DIAG(AX_TYPE_RETURN, ERROR, "body can reach its end without producing the declared non-unit value")
AX_DIAG(AX_TYPE_OPERATOR, ERROR, "operator not defined for these operand types")
AX_DIAG(AX_TYPE_LITERAL_OUT_OF_RANGE, ERROR, "integer literal does not fit its type")
AX_DIAG(AX_TYPE_NEG_UNSIGNED, ERROR, "unary minus applied to an unsigned type")
AX_DIAG(AX_TYPE_INVALID_CAST, ERROR, "as cast between types SPEC-03 does not allow")
AX_DIAG(AX_TYPE_NEVER_RETURNS, ERROR, "a function declared to return never can return normally")
AX_DIAG(AX_TYPE_MAIN_MISSING, ERROR, "the root file has no fn main (build/run)")
AX_DIAG(AX_TYPE_MAIN_SIGNATURE, ERROR, "main signature not allowed by SPEC-03")
AX_DIAG(AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP, ERROR, "valid Axiom outside the axiom0 subset (AXD-013)")
AX_DIAG(AX_TYPE_ASSIGN_IMMUTABLE, ERROR, "cannot assign twice to immutable variable")
AX_DIAG(AX_TYPE_UNINIT_USE, ERROR, "use of possibly-uninitialized variable")
AX_DIAG(AX_TYPE_UNREACHABLE, WARNING, "unreachable statement")
AX_DIAG(AX_TYPE_UNKNOWN_FIELD, ERROR, "struct has no such field")
AX_DIAG(AX_TYPE_MISSING_FIELD, ERROR, "missing field in struct literal")
AX_DIAG(AX_TYPE_DUPLICATE_FIELD, ERROR, "duplicate field in struct literal")
