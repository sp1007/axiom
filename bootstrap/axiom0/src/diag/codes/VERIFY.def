AX_DIAG(AX_VERIFY_UNINIT_USE, ERROR, "local read before it is definitely assigned")
AX_DIAG(AX_VERIFY_CALL_SIGNATURE, ERROR, "call arguments or destination do not match the callee signature")
AX_DIAG(AX_VERIFY_RETURN_TYPE, ERROR, "the return place type differs from the function's return type")
AX_DIAG(AX_VERIFY_USE_AFTER_MOVE, ERROR, "use of a local after it was moved")
