AX_DIAG(AX_LEX_INVALID_UTF8, ERROR, "invalid UTF-8 byte sequence")
AX_DIAG(AX_LEX_INVALID_CHAR, ERROR, "character that cannot start a token")
AX_DIAG(AX_LEX_NON_ASCII_IDENT, ERROR, "non-ASCII character outside literals and comments")
AX_DIAG(AX_LEX_UNTERMINATED_COMMENT, ERROR, "block comment open at end of file")
AX_DIAG(AX_LEX_UNTERMINATED_STRING, ERROR, "line break or end of file inside a string")
AX_DIAG(AX_LEX_UNTERMINATED_CHAR, ERROR, "character literal without closing quote on the line")
AX_DIAG(AX_LEX_BAD_CHAR_LITERAL, ERROR, "empty or multi-character char/byte literal")
AX_DIAG(AX_LEX_INVALID_ESCAPE, ERROR, "unknown escape or bad \\x")
AX_DIAG(AX_LEX_INVALID_UNICODE_ESCAPE, ERROR, "malformed or non-scalar \\u{...}")
AX_DIAG(AX_LEX_NON_ASCII_IN_BYTE_LITERAL, ERROR, "non-ASCII character in a byte literal")
AX_DIAG(AX_LEX_MISSING_DIGITS, ERROR, "base prefix without digits")
AX_DIAG(AX_LEX_BAD_BASE_PREFIX, ERROR, "upper-case base prefix")
AX_DIAG(AX_LEX_INVALID_DIGIT, ERROR, "digit not valid for the base")
AX_DIAG(AX_LEX_BAD_DIGIT_SEPARATOR, ERROR, "misplaced _ in a number")
AX_DIAG(AX_LEX_INVALID_SUFFIX, ERROR, "unknown or mismatched literal suffix")
AX_DIAG(AX_LEX_INT_OVERFLOW, ERROR, "integer literal above 2^64 - 1")
AX_DIAG(AX_LEX_INVALID_OPERATOR, ERROR, "three or more dots")
AX_DIAG(AX_LEX_COLON_COLON, ERROR, ":: is not a token; paths use .")
AX_DIAG(AX_LEX_COLON_EQ, ERROR, ":= is not a token; bind with =")
