// Minimal repro for T165: axiomc1 `run --interp` segfault (pre-T166 AX0-FIX-11).
// Any MIR binary operation evaluated by the stage-1 interpreter (either at runtime via
// `axiomc1 run --interp` or at compile time via a `const` initializer with a binary op)
// enters `compiler.interp.interp.exec_assign_binop` (1,076 branch fixups).
//
// Pre-T166 axiom0 (`1752d89a94bd`):
//   `bootstrap/axiom0/src/driver/build_native/build.c` had fixed-size stack arrays
//   `uint32_t bb_offsets[1024]` and `fixups[1024]`. The 52 overflowing fixups in
//   `exec_assign_binop` overwrote `bb_offsets[]`, patching 65 intra-function `jmp`/`jcc`
//   instructions to jump to `.text+0x12a..0x3a2` (`ptr_from_mut_*`) instead of the merge
//   blocks inside `exec_assign_binop`, crashing with STATUS_ACCESS_VIOLATION (0xC0000005).
//
// Post-T166 axiom0 (`dbc78f58` / HEAD `eca6645`, AX0-FIX-11):
//   `axiomc1 run --interp` exits cleanly with code 42.

const BASE: i32 = 10 + 20;

fn add_and_check(x: i32, y: i32) -> i32 {
    let sum: i32 = x + y;
    if sum == 12 {
        return BASE + sum;
    }
    0
}

fn main() -> i32 {
    add_and_check(5, 7)
}
