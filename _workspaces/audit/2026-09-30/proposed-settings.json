{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash",
      "PowerShell",
      "Agent",
      "Skill",
      "SendMessage",
      "ListAgents",
      "TaskStop",
      "ToolSearch",
      "Monitor",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "deny": [
      "Edit(docs/**)",
      "Write(docs/**)",
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py\" || exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
