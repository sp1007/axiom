// BENCH-COMPILE-001: Multi-function compilation & optimization throughput workload (`SPEC-76 AXS-PERF-040`).
// Exercises front-end typechecking, MIR construction, SSA optimization, and x86-64 code generation
// for BUDGET-SELF-001, BUDGET-SELF-002, and BUDGET-CTIME-001.

@derive(Copy)
struct TokenSpan {
    kind: u32,
    start: u32,
    len: u32,
}

@derive(Copy)
struct IrNode {
    op: u32,
    lhs: i64,
    rhs: i64,
    cost: u32,
}

fn fold_ir_node(n: IrNode) -> i64 {
    if n.op == 0u32 {
        return n.lhs + n.rhs;
    }
    if n.op == 1u32 {
        return n.lhs - n.rhs;
    }
    if n.op == 2u32 {
        return n.lhs * n.rhs;
    }
    if n.op == 3u32 {
        return n.lhs ^ n.rhs;
    }
    (n.lhs & n.rhs) + (n.cost as i64)
}

fn analyze_span(s: TokenSpan, bias: u32) -> u32 {
    let end_pos: u32 = s.start + s.len;
    let weight: u32 = (s.kind * 4u32) + bias;
    end_pos ^ weight
}

fn simulate_pass_pipeline(rounds: u32) -> i64 {
    let mut total: i64 = 0;
    let mut r: u32 = 0u32;
    while r < rounds {
        let sp = TokenSpan { kind: r & 7u32, start: r * 3u32, len: (r & 15u32) + 1u32 };
        let w: u32 = analyze_span(sp, 11u32);
        let n0 = IrNode { op: r & 3u32, lhs: (w as i64) + 10, rhs: (r as i64) + 5, cost: w & 31u32 };
        let n1 = IrNode { op: (r + 1u32) & 3u32, lhs: fold_ir_node(n0), rhs: 7, cost: 3u32 };
        total = total + (fold_ir_node(n1) & 4095);
        r = r + 1u32;
    }
    total
}

fn main() -> i32 {
    let a: i64 = simulate_pass_pipeline(600u32);
    let b: i64 = simulate_pass_pipeline(600u32);
    if a == b && a > 0 {
        0
    } else {
        1
    }
}
