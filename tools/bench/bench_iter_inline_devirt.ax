// BENCH-IPA-001: Multi-stage iterator/combinator pipelines (`map` -> `filter` -> `fold`) and
// monomorphic/devirtualized helper dispatch (`SPEC-76 AXS-PERF-040`).

@derive(Copy)
struct RangeIter {
    cur: i64,
    end_val: i64,
    step_val: i64,
}

fn iter_new(start_val: i64, end_val: i64, step_val: i64) -> RangeIter {
    RangeIter { cur: start_val, end_val: end_val, step_val: step_val }
}

fn stage_map_linear(x: i64) -> i64 {
    let scale: i64 = (3 + 1) * 2;
    let bias: i64 = (10 + 6) - 9;
    (x * scale) + bias
}

fn stage_map_mix(x: i64) -> i64 {
    let shifted: i64 = (x ^ (x >> 2)) + ((4 * 4) - 16);
    shifted & 4095
}

fn stage_filter_keep(x: i64) -> bool {
    (x & 3) != 0
}

fn stage_fold_combine(acc: i64, item: i64) -> i64 {
    let delta: i64 = (item + (2 * 3)) - 6;
    acc + delta
}

fn run_pipeline(limit: i64) -> i64 {
    let mut it: RangeIter = iter_new(0, limit, 1);
    let end_limit: i64 = it.end_val;
    let step_delta: i64 = it.step_val;
    let mut cur: i64 = it.cur;
    let mut acc: i64 = 0;
    while cur < end_limit {
        let raw: i64 = cur;
        cur = cur + step_delta;
        it.cur = cur;
        let m1: i64 = stage_map_linear(raw);
        let m2: i64 = stage_map_mix(m1);
        if stage_filter_keep(m2) {
            acc = stage_fold_combine(acc, m2);
        }
    }
    acc
}

fn main() -> i32 {
    let r0: i64 = run_pipeline(2000);
    let r1: i64 = run_pipeline(2000);
    if r0 == r1 && r0 > 0 {
        0
    } else {
        1
    }
}
