// BENCH-ALGO-001: Mixed algorithmic workload combining insertion sort, FNV-1a style hashing,
// and integer token accumulation (`SPEC-76 AXS-PERF-040`).

fn hash_step(h: i64, v: i64) -> i64 {
    let mixed: i64 = (h ^ (v & 255)) * 1099511;
    (mixed ^ (mixed >> 16)) & 0x7FFFFFFF
}

fn sort_and_hash_block(seed: i64) -> i64 {
    let mut buf: [16]i64 = [
        (seed * 13 + 7) & 255,
        (seed * 29 + 3) & 255,
        (seed * 17 + 19) & 255,
        (seed * 31 + 11) & 255,
        (seed * 43 + 5) & 255,
        (seed * 19 + 23) & 255,
        (seed * 37 + 2) & 255,
        (seed * 41 + 13) & 255,
        (seed * 53 + 17) & 255,
        (seed * 59 + 29) & 255,
        (seed * 61 + 31) & 255,
        (seed * 67 + 37) & 255,
        (seed * 71 + 41) & 255,
        (seed * 73 + 43) & 255,
        (seed * 79 + 47) & 255,
        (seed * 83 + 53) & 255,
    ];

    let mut i: usize = 1;
    while i < 16 {
        let key: i64 = buf[i];
        let mut j: usize = i;
        while j > 0 && buf[j - 1] > key {
            buf[j] = buf[j - 1];
            j = j - 1;
        }
        buf[j] = key;
        i = i + 1;
    }

    let mut h: i64 = 2166136;
    let mut k: usize = 0;
    while k < 16 {
        h = hash_step(h, buf[k] + (k as i64));
        k = k + 1;
    }
    h
}

fn run_algo_suite(rounds: i64) -> i64 {
    let mut acc: i64 = 0;
    let mut r: i64 = 0;
    while r < rounds {
        acc = (acc + sort_and_hash_block(r + 1)) & 0x7FFFFFFF;
        r = r + 1;
    }
    acc
}

fn main() -> i32 {
    let h0: i64 = run_algo_suite(120);
    let h1: i64 = run_algo_suite(120);
    if h0 == h1 && h0 > 0 {
        0
    } else {
        1
    }
}
