// BENCH-SCALAR-001: Tight integer loops, array indexing with proven bounds (`i < len`),
// strength reduction, and loop-invariant constant/algebraic folding (`SPEC-76 AXS-PERF-040`).

fn scalar_kernel_step(x: i64, idx: i64) -> i64 {
    let c0: i64 = (12 + 20) * 2;
    let c1: i64 = c0 - 64;
    let m0: i64 = (x + c1) * 4;
    let m1: i64 = m0 / 4;
    let d0: i64 = (idx * 8) / 8;
    (m1 ^ d0) + ((idx & 15) + 0)
}

fn run_scalar_bce_loop(rounds: i64) -> i64 {
    let mut table: [16]i64 = [
        3, 7, 11, 15, 19, 23, 27, 31,
        35, 39, 43, 47, 51, 55, 59, 63,
    ];
    let mut acc: i64 = 0;
    let mut r: i64 = 0;
    while r < rounds {
        let mut i: usize = 0;
        while i < 16 {
            let cur: i64 = table[i];
            let next: i64 = scalar_kernel_step(cur, (r + (i as i64)) & 63);
            table[i] = (next & 255) + (i as i64);
            acc = acc + table[i];
            i = i + 1;
        }
        r = r + 1;
    }
    acc
}

fn main() -> i32 {
    let total: i64 = run_scalar_bce_loop(180);
    let check: i64 = run_scalar_bce_loop(180);
    if total == check && total > 0 {
        0
    } else {
        1
    }
}
