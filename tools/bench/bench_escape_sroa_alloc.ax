// BENCH-MEM-001: Non-escaping struct aggregates, nested wrapper records, and scalar replacement
// of aggregates (`SROA` + `Mem2Reg` + stack promotion, `SPEC-76 AXS-PERF-040`).

@derive(Copy)
struct Vec3i {
    x: i64,
    y: i64,
    z: i64,
}

@derive(Copy)
struct RaySample {
    origin: Vec3i,
    dir: Vec3i,
    weight: i64,
}

fn make_sample(seed: i64) -> RaySample {
    let ox: i64 = (seed * 3) + (4 - 4);
    let oy: i64 = (seed * 5) + (8 - 8);
    let oz: i64 = (seed * 7) + (16 - 16);
    RaySample {
        origin: Vec3i { x: ox, y: oy, z: oz },
        dir: Vec3i { x: seed & 7, y: (seed >> 1) & 7, z: (seed >> 2) & 7 },
        weight: (seed & 31) + 1,
    }
}

fn evaluate_sample(s: RaySample) -> i64 {
    let dot: i64 = (s.origin.x * s.dir.x) + (s.origin.y * s.dir.y) + (s.origin.z * s.dir.z);
    let norm: i64 = (s.weight * 2) / 2;
    dot + norm
}

fn run_sroa_workload(iters: i64) -> i64 {
    let mut sum: i64 = 0;
    let mut i: i64 = 0;
    while i < iters {
        let s0: RaySample = make_sample(i & 63);
        let s1: RaySample = make_sample((i + 17) & 63);
        let v0: i64 = evaluate_sample(s0);
        let v1: i64 = evaluate_sample(s1);
        sum = sum + ((v0 ^ v1) & 1023);
        i = i + 1;
    }
    sum
}

fn main() -> i32 {
    let a: i64 = run_sroa_workload(1200);
    let b: i64 = run_sroa_workload(1200);
    if a == b && a > 0 {
        0
    } else {
        1
    }
}
