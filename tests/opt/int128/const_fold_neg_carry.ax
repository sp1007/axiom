// test: helper
// Regression (FU-T452-NEG): negating a 128-bit constant whose low word is 0 must carry into the
// high word. -(2^64) = 2^128 - 2^64 = 340282366920938463444927863358058659840 (hi all ones, lo 0).
// A const item keeps the `-const` unary op in MIR so the -O1 folder (opt_u128_neg_raw) does the work.
const TWO64: i128 = 18446744073709551616i128;
const TWO64_P1: i128 = 18446744073709551617i128;
const FIVE: i128 = 5i128;

fn neg_carry() -> i128 {
    -TWO64
}

// Low word != 0: no carry into the high word. -(2^64 + 1) = 2^128 - 2^64 - 1.
fn neg_nocarry() -> i128 {
    -TWO64_P1
}

fn neg_small() -> i128 {
    -FIVE
}
