// test: helper
// QA (T452): every function below has literal / const-item operands, so -O1 must fold it to exactly the constant the
// independent Python model gives (printed by mir-opt as the unsigned 128-bit pattern).
// Bit intrinsics (rotate/clz/popcount/bswap) are lowered by the MIR builder to shift sequences over temps and are
// not constant folded by the current -O1 pipeline (no propagation through locals): covered by the run tests instead.

const MAX128: i128 = 170141183460469231731687303715884105727i128;
const MIN128: i128 = -170141183460469231731687303715884105727i128 - 1i128;
const NEGMAX128: i128 = -170141183460469231731687303715884105727i128;
const NEG1E23: i128 = -100000000000000000000000i128;

fn qa_wrap_add_carry() -> u128 {
    18446744073709551615u128.wrapping_add(1u128)
}

fn qa_wrap_sub_borrow() -> u128 {
    18446744073709551616u128.wrapping_sub(1u128)
}

fn qa_wrap_sub_under() -> u128 {
    3u128.wrapping_sub(5u128)
}

fn qa_wrap_mul_cross() -> u128 {
    0xFFFFFFFFFFFFFFFFu128.wrapping_mul(0xFFFFFFFFFFFFFFFFu128)
}

fn qa_wrap_mul_ovf() -> u128 {
    18446744073709551616u128.wrapping_mul(18446744073709551616u128)
}

fn qa_wrap_add_i_min() -> i128 {
    MAX128.wrapping_add(1i128)
}

fn qa_sat_add_u() -> u128 {
    0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEu128.saturating_add(7u128)
}

fn qa_sat_sub_u() -> u128 {
    5u128.saturating_sub(1180591620717411303424u128)
}

fn qa_sat_mul_u() -> u128 {
    18446744073709551616u128.saturating_mul(18446744073709551617u128)
}

fn qa_sat_add_i() -> i128 {
    MAX128.saturating_add(1i128)
}

fn qa_sat_sub_i() -> i128 {
    MIN128.saturating_sub(1i128)
}

fn qa_sat_mul_i() -> i128 {
    NEGMAX128.saturating_mul(2i128)
}

fn qa_sat_mul_i_pos() -> i128 {
    MAX128.saturating_mul(3i128)
}

fn qa_div_i_neg() -> i128 {
    NEG1E23 / 7i128
}

fn qa_rem_i_neg() -> i128 {
    NEG1E23 % 7i128
}

fn qa_div_u_big() -> u128 {
    0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128 / 0x10000000000000001u128
}

fn qa_rem_u_big() -> u128 {
    0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128 % 0x10000000000000001u128
}

fn qa_shl_cross() -> u128 {
    1u128 << 100u128
}

fn qa_shl_64() -> u128 {
    0xABCDu128 << 64u128
}

fn qa_shr_u_cross() -> u128 {
    0x80000000000000000000000000000000u128 >> 65u128
}

fn qa_shr_i_arith() -> i128 {
    MIN128 >> 100i128
}

fn qa_and_hi() -> u128 {
    0xFFFF0000FFFF0000FFFF0000FFFF0000u128 & 0xFF00FF00FF00FF00FF00FF00FF00FF00u128
}

fn qa_xor_hi() -> u128 {
    0xFFFF0000FFFF0000FFFF0000FFFF0000u128 ^ 0xFF00FF00FF00FF00FF00FF00FF00FF00u128
}

fn qa_add_carry_chk() -> u128 {
    18446744073709551615u128 + 18446744073709551615u128
}

fn qa_sub_borrow_chk() -> i128 {
    NEGMAX128 - (-1i128)
}

fn qa_mul_cross_chk() -> u128 {
    4294967296u128 * 18446744073709551616u128
}

fn qa_mul_neg_chk() -> i128 {
    NEG1E23 * 1000i128
}
