// test: helper
// QA (T452): operations that must panic at run time must survive -O1 (assert / un-folded rvalue), never fold to a constant.

fn qa_ovf_add_u() -> u128 {
    0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128 + 1u128
}

fn qa_ovf_sub_u() -> u128 {
    0u128 - 1u128
}

fn qa_ovf_mul_u() -> u128 {
    (1u128 << 64u128) * (1u128 << 64u128)
}

fn qa_ovf_div_min() -> i128 {
    (-170141183460469231731687303715884105727i128 - 1i128) / -1i128
}

fn qa_ovf_rem_min() -> i128 {
    (-170141183460469231731687303715884105727i128 - 1i128) % -1i128
}

fn qa_ovf_neg_min() -> i128 {
    -(-170141183460469231731687303715884105727i128 - 1i128)
}

fn qa_div_zero_u() -> u128 {
    5u128 / 0u128
}

fn qa_rem_zero_i() -> i128 {
    5i128 % 0i128
}

fn qa_shl_128() -> u128 {
    1u128 << 128u128
}

fn qa_shr_neg() -> i128 {
    1i128 >> -1i128
}
