// test: helper
// T458 (SPEC-41 AXS-FLT-014): constant float operands are never folded as integer bits at -O1. `0.0 + -0.0` is +0.0 (the
// bit sum 0 + 0x8000.. would be -0.0), a NaN constant is not equal to itself, and integer folding is unchanged.

fn zero_sum() -> f64 {
    0.0 + -0.0
}

fn neg_zero_sum() -> f64 {
    -0.0 + -0.0
}

fn neg_zero_lit() -> f64 {
    -0.0
}

fn nan_self_cmp() -> bool {
    let nan = 0.0 / 0.0;
    nan == nan
}

fn mul_consts() -> f64 {
    0.0 * -1.0
}

fn int_to_float_const() -> f64 {
    let n: i32 = 3;
    n as f64
}

fn float_to_int_const() -> i32 {
    let x: f64 = 1e20;
    x as i32
}

fn narrow_const() -> f32 {
    let x: f64 = 1e40;
    x as f32
}

fn neg_const_var() -> f64 {
    let z: f64 = 0.0;
    -z
}

fn int_cmp_fold() -> bool {
    7 < 9
}

// `main` calls nothing: the golden output must not depend on symbol numbering.
fn main() -> i32 {
    return 0;
}
