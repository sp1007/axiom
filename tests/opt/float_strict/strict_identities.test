cache-inputs: tests/opt/float_strict/strict_identities.ax tests/opt/float_strict/strict_identities.expected.txt
cmd: {compiler} inspect --emit=mir-opt -O1 {test_dir}/strict_identities.ax
exit: 0
stdout-file: strict_identities.expected.txt
# T458 (SPEC-41 AXS-FLT-014): the whole -O1 output is pinned; these are the instructions that an integer-style optimizer would remove.
stdout-contains: _0 = copy _1 + const f64#0000000000000000;
stdout-contains: _0 = copy _1 + const f64#8000000000000000;
stdout-contains: _0 = copy _1 - const f64#0000000000000000;
stdout-contains: _0 = copy _1 * const f64#0000000000000000;
stdout-contains: _0 = const f64#0000000000000000 / copy _1;
stdout-contains: _0 = copy _1 * const f64#3ff0000000000000;
stdout-contains: _0 = copy _1 / const f64#3ff0000000000000;
stdout-contains: _0 = copy _1 - copy _1;
stdout-contains: _0 = copy _1 / copy _1;
stdout-contains: _0 = copy _1 == copy _1;
stdout-contains: _0 = copy _1 != copy _1;
stdout-contains: _0 = copy _1 <= copy _1;
stdout-contains: _0 = copy _1 >= copy _1;
# !(a < b) stays a comparison followed by a logical not, never a >= b.
stdout-contains: _3 = copy _1 < copy _2;
stdout-contains: _0 = !move _3;
# No reassociation and no FMA contraction: both operations and their order are kept.
stdout-contains: _4 = copy _1 + copy _2;
stdout-contains: _0 = move _4 + copy _3;
stdout-contains: _4 = copy _1 * copy _2;
stdout-contains: _0 = move _4 * copy _3;
stdout-contains: _0 = move _4 + copy _3;
stdout-contains: _0 = copy _1 + const f32#00000000;
stdout-contains: _0 = copy _1 - copy _1;
