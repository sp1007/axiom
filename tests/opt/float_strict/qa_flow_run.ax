// test: run
// flags: -O1
// exit: 0
// stdout: ok\n
// T458 QA (round 0): strict IEEE-754 behaviour at -O1 when the identity only appears after constant/copy propagation
// through locals, loops and branches (the engineer's tests use direct operands). Each check compares result bits.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn to_bits(x: f64) -> u64 {
    let v = x;
    unsafe { *(address_of(v) as *const u64) }
}

fn from_bits(b: u64) -> f64 {
    let v = b;
    unsafe { *(address_of(v) as *const f64) }
}

fn to_bits32(x: f32) -> u32 {
    let v = x;
    unsafe { *(address_of(v) as *const u32) }
}

fn from_bits32(b: u32) -> f32 {
    let v = b;
    unsafe { *(address_of(v) as *const f32) }
}

fn chk(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got ");
    print_int(got as i64);
    print(" want ");
    print_int(want as i64);
    print("\n");
    1
}

fn is_nan(x: f64) -> bool {
    x != x
}

// -0.0 + 0.0 = +0.0: an `x + 0.0 -> x` rewrite would return -0.0.
fn add_zero_via_local(x: f64) -> f64 {
    let z: f64 = 0.0;
    let y = z;
    x + y
}

// -0.0 - 0.0 = -0.0 but 0.0 - 0.0 = +0.0; x - (-0.0) = x + 0.0.
fn sub_neg_zero_via_local(x: f64) -> f64 {
    let z: f64 = -0.0;
    x - z
}

// NaN * 0.0 = NaN, -1.0 * 0.0 = -0.0, inf * 0.0 = NaN.
fn mul_zero_via_local(x: f64) -> f64 {
    let z: f64 = 0.0;
    x * z
}

// 0.0 - x is not -x: 0.0 - 0.0 = +0.0 but -(0.0) = -0.0.
fn zero_minus(x: f64) -> f64 {
    let z: f64 = 0.0;
    z - x
}

fn neg_of(x: f64) -> f64 {
    -x
}

// inf - inf = NaN, so x - x must not become 0.0 even when the second operand is a copy.
fn sub_copy(x: f64) -> f64 {
    let y = x;
    x - y
}

fn div_copy(x: f64) -> f64 {
    let y = x;
    x / y
}

// A branch on a self comparison must stay a branch.
fn branch_eq_self(x: f64) -> i32 {
    let y = x;
    if x == y {
        1
    } else {
        2
    }
}

fn branch_not_lt(a: f64, b: f64) -> i32 {
    if !(a < b) {
        1
    } else {
        2
    }
}

fn branch_ge(a: f64, b: f64) -> i32 {
    if a >= b {
        1
    } else {
        2
    }
}

// Left-to-right accumulation: (((0.1 + 0.1) + 0.1) ...) must not be reassociated or turned into 10 * 0.1.
fn sum_loop(n: i32) -> f64 {
    let mut s: f64 = 0.0;
    let step: f64 = 0.1;
    let mut i: i32 = 0;
    while i < n {
        s = s + step;
        i = i + 1;
    }
    s
}

// a*b + c with two roundings, never fused: 0x3FF0000000000001^2 - 1.0 loses the low term.
fn mul_add_unfused(a: f64, b: f64, c: f64) -> f64 {
    let p = a * b;
    p + c
}

// An unused float division by zero is not a panic and is not observable.
fn dead_div(x: f64) -> i32 {
    let _unused = x / 0.0;
    let _unused2 = 1.0 / (x - x);
    7
}

fn narrow_roundtrip(x: f64) -> bool {
    let n = x as f32;
    let w = n as f64;
    w == x
}

fn main() -> i32 {
    let mut f: i32 = 0;
    let neg_zero = from_bits(0x8000000000000000u64);
    let pos_zero = from_bits(0u64);
    let inf = from_bits(0x7FF0000000000000u64);
    let nan = from_bits(0x7FF8000000000000u64);
    let one = from_bits(0x3FF0000000000000u64);

    f = f + chk(1, to_bits(add_zero_via_local(neg_zero)), 0u64);
    f = f + chk(2, to_bits(add_zero_via_local(pos_zero)), 0u64);
    f = f + chk(3, to_bits(add_zero_via_local(one)), 0x3FF0000000000000u64);
    f = f + chk(4, to_bits(sub_neg_zero_via_local(neg_zero)), 0u64);
    f = f + chk(5, to_bits(sub_neg_zero_via_local(pos_zero)), 0u64);
    f = f + chk(6, to_bits(mul_zero_via_local(from_bits(0xBFF0000000000000u64))), 0x8000000000000000u64);
    f = f + chk(7, to_bits(mul_zero_via_local(one)), 0u64);
    f = f + chk(8, if is_nan(mul_zero_via_local(nan)) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(9, if is_nan(mul_zero_via_local(inf)) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(10, to_bits(zero_minus(pos_zero)), 0u64);
    f = f + chk(11, to_bits(neg_of(pos_zero)), 0x8000000000000000u64);
    f = f + chk(12, to_bits(zero_minus(neg_zero)), 0u64);
    f = f + chk(13, to_bits(neg_of(neg_zero)), 0u64);
    f = f + chk(14, if is_nan(sub_copy(inf)) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(15, to_bits(sub_copy(one)), 0u64);
    f = f + chk(16, if is_nan(div_copy(inf)) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(17, if is_nan(div_copy(pos_zero)) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(18, to_bits(div_copy(from_bits(0x4008000000000000u64))), 0x3FF0000000000000u64);
    f = f + chk(19, branch_eq_self(nan) as u64, 2u64);
    f = f + chk(20, branch_eq_self(one) as u64, 1u64);
    f = f + chk(21, branch_eq_self(inf) as u64, 1u64);
    f = f + chk(22, branch_not_lt(nan, one) as u64, 1u64);
    f = f + chk(23, branch_not_lt(one, nan) as u64, 1u64);
    f = f + chk(24, branch_ge(nan, one) as u64, 2u64);
    f = f + chk(25, branch_ge(one, one) as u64, 1u64);
    // 0.1 added 10 times in order = 0.9999999999999999 (0x3FEFFFFFFFFFFFFF); 10 * 0.1 would be 1.0.
    f = f + chk(26, to_bits(sum_loop(10)), 0x3FEFFFFFFFFFFFFFu64);
    f = f + chk(27, to_bits(sum_loop(0)), 0u64);
    f = f + chk(28, to_bits(sum_loop(3)), 0x3FD3333333333334u64);
    // (1 + 2^-52)^2 - 1 with two roundings = 2^-51 (the product rounds to 1 + 2^-51); a fused result is 2^-51 + 2^-104.
    f = f + chk(29, to_bits(mul_add_unfused(from_bits(0x3FF0000000000001u64), from_bits(0x3FF0000000000001u64), from_bits(0xBFF0000000000000u64))), 0x3CC0000000000000u64);
    f = f + chk(30, dead_div(one) as u64, 7u64);
    f = f + chk(31, dead_div(nan) as u64, 7u64);
    f = f + chk(32, if narrow_roundtrip(one) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(33, if narrow_roundtrip(from_bits(0x3FB999999999999Au64)) { 1u64 } else { 0u64 }, 0u64);
    f = f + chk(34, if narrow_roundtrip(nan) { 1u64 } else { 0u64 }, 0u64);
    f = f + chk(35, if narrow_roundtrip(inf) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(36, if narrow_roundtrip(neg_zero) { 1u64 } else { 0u64 }, 1u64);
    if f == 0 {
        print("ok\n");
    }
    f
}
