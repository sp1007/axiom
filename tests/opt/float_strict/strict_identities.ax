// test: helper
// T458 (SPEC-41 AXS-FLT-014): at -O1 the MIR optimizer (const_fold, dce, cfg_simp) keeps every IEEE-754 observable.
// Each function below contains an algebraic identity that holds for integers but is WRONG for floats
// (signed zero, NaN, infinity, single rounding), so the optimizer must leave the operation in place.

fn add_pos_zero(x: f64) -> f64 {
    x + 0.0
}

fn add_neg_zero(x: f64) -> f64 {
    x + -0.0
}

fn sub_pos_zero(x: f64) -> f64 {
    x - 0.0
}

fn mul_zero(x: f64) -> f64 {
    x * 0.0
}

fn zero_div(x: f64) -> f64 {
    0.0 / x
}

fn mul_one(x: f64) -> f64 {
    x * 1.0
}

fn div_one(x: f64) -> f64 {
    x / 1.0
}

fn sub_self(x: f64) -> f64 {
    x - x
}

fn div_self(x: f64) -> f64 {
    x / x
}

fn eq_self(x: f64) -> bool {
    x == x
}

fn ne_self(x: f64) -> bool {
    x != x
}

fn le_self(x: f64) -> bool {
    x <= x
}

fn ge_self(x: f64) -> bool {
    x >= x
}

fn not_lt(a: f64, b: f64) -> bool {
    !(a < b)
}

fn reassoc_add(a: f64, b: f64, c: f64) -> f64 {
    (a + b) + c
}

fn reassoc_mul(a: f64, b: f64, c: f64) -> f64 {
    (a * b) * c
}

fn mul_then_add(a: f64, b: f64, c: f64) -> f64 {
    a * b + c
}

fn f32_add_zero(x: f32) -> f32 {
    x + 0.0f32
}

fn f32_sub_self(x: f32) -> f32 {
    x - x
}

// `main` calls nothing: the golden output must not depend on symbol numbering.
fn main() -> i32 {
    return 0;
}
