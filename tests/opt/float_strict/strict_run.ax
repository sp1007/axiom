// test: run
// flags: -O1
// exit: 0
// stdout: ok\n
// native-after: T458a
// T458 (SPEC-41 AXS-FLT-013/014): behaviour at -O1 is the strict IEEE-754 behaviour. Every identity that is wrong for floats
// (signed zero, NaN, infinity, double rounding, no FMA contraction, no reassociation) keeps its exact result bits.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn to_bits(x: f64) -> u64 {
    let v = x;
    unsafe { *(address_of(v) as *const u64) }
}

fn from_bits(b: u64) -> f64 {
    let v = b;
    unsafe { *(address_of(v) as *const f64) }
}

fn to_bits32(x: f32) -> u32 {
    let v = x;
    unsafe { *(address_of(v) as *const u32) }
}

fn from_bits32(b: u32) -> f32 {
    let v = b;
    unsafe { *(address_of(v) as *const f32) }
}

fn chk(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got ");
    print_int(got as i64);
    print(" want ");
    print_int(want as i64);
    print("\n");
    1
}

// Fresh NaNs are checked as "is a NaN": the sign and payload of an arithmetic NaN are not observable semantics (SPEC-41 AXS-FLT-002).
fn chk_nan(id: i32, got: u64) -> i32 {
    if (got & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 {
        return 0;
    }
    chk(id, got, 0x7FF8000000000000u64)
}

fn chk_nan32(id: i32, got: u32) -> i32 {
    if (got & 0x7FFFFFFFu32) > 0x7F800000u32 {
        return 0;
    }
    chk(id, got as u64, 0x7FC00000u64)
}

fn b2u(b: bool) -> u64 {
    if b { 1u64 } else { 0u64 }
}

fn add_pos_zero(x: f64) -> f64 {
    x + 0.0
}

fn add_neg_zero(x: f64) -> f64 {
    x + -0.0
}

fn sub_pos_zero(x: f64) -> f64 {
    x - 0.0
}

fn mul_zero(x: f64) -> f64 {
    x * 0.0
}

fn zero_div(x: f64) -> f64 {
    0.0 / x
}

fn mul_one(x: f64) -> f64 {
    x * 1.0
}

fn div_one(x: f64) -> f64 {
    x / 1.0
}

fn sub_self(x: f64) -> f64 {
    x - x
}

fn div_self(x: f64) -> f64 {
    x / x
}

fn eq_self(x: f64) -> bool {
    x == x
}

fn ne_self(x: f64) -> bool {
    x != x
}

fn le_self(x: f64) -> bool {
    x <= x
}

fn ge_self(x: f64) -> bool {
    x >= x
}

fn not_lt(a: f64, b: f64) -> bool {
    !(a < b)
}

fn reassoc_add(a: f64, b: f64, c: f64) -> f64 {
    (a + b) + c
}

fn reassoc_mul(a: f64, b: f64, c: f64) -> f64 {
    (a * b) * c
}

fn mul_then_add(a: f64, b: f64, c: f64) -> f64 {
    a * b + c
}

fn f32_add_zero(x: f32) -> f32 {
    x + 0.0f32
}

fn f32_sub_self(x: f32) -> f32 {
    x - x
}

// Constant operands: nothing may be folded as integer bits.
fn const_zero_sum() -> f64 {
    0.0 + -0.0
}

fn const_neg_zero_sum() -> f64 {
    -0.0 + -0.0
}

fn const_self_cmp() -> bool {
    let nan = 0.0 / 0.0;
    nan == nan
}

fn const_int_fold() -> i32 {
    40 + 2
}

fn dead_ops(x: f64) -> f64 {
    let _unused = x / 0.0;
    let _unused2 = -x;
    x
}

// Evaluation order of side-effect-free float operations is the source order.
fn order(a: f64, b: f64) -> f64 {
    let t = a / b;
    let u = b / a;
    t - u
}

fn main() -> i32 {
    let neg_zero = from_bits(0x8000000000000000u64);
    let nan = from_bits(0x7FF8000000000000u64);
    let inf = from_bits(0x7FF0000000000000u64);
    let ninf = from_bits(0xFFF0000000000000u64);
    let one = from_bits(0x3FF0000000000000u64);
    let neg_one = from_bits(0xBFF0000000000000u64);
    let mut f: i32 = 0;

    // x + 0.0 is not x: (-0.0) + (+0.0) = +0.0; x + (-0.0) and x - 0.0 keep -0.0.
    f = f + chk(1, to_bits(add_pos_zero(neg_zero)), 0x0u64);
    f = f + chk(2, to_bits(add_neg_zero(neg_zero)), 0x8000000000000000u64);
    f = f + chk(3, to_bits(sub_pos_zero(neg_zero)), 0x8000000000000000u64);
    // x * 0.0 is not 0.0.
    f = f + chk_nan(4, to_bits(mul_zero(nan)));
    f = f + chk_nan(5, to_bits(mul_zero(inf)));
    f = f + chk(6, to_bits(mul_zero(neg_one)), 0x8000000000000000u64);
    f = f + chk(7, to_bits(mul_zero(one)), 0x0u64);
    f = f + chk(8, to_bits(zero_div(neg_one)), 0x8000000000000000u64);
    f = f + chk_nan(9, to_bits(zero_div(neg_zero)));
    // x * 1.0 and x / 1.0 keep signalling-NaN quietening and sign of zero.
    f = f + chk(10, to_bits(mul_one(neg_zero)), 0x8000000000000000u64);
    f = f + chk(11, to_bits(div_one(ninf)), 0xFFF0000000000000u64);
    // x - x is not 0.0, x / x is not 1.0.
    f = f + chk_nan(12, to_bits(sub_self(inf)));
    f = f + chk_nan(13, to_bits(sub_self(nan)));
    f = f + chk(14, to_bits(sub_self(one)), 0x0u64);
    f = f + chk_nan(15, to_bits(div_self(neg_zero)));
    f = f + chk_nan(16, to_bits(div_self(inf)));
    f = f + chk(17, to_bits(div_self(neg_one)), 0x3FF0000000000000u64);
    // x == x is false for NaN; x != x is true; x <= x and x >= x are false.
    f = f + chk(18, b2u(eq_self(nan)), 0u64);
    f = f + chk(19, b2u(eq_self(one)), 1u64);
    f = f + chk(20, b2u(ne_self(nan)), 1u64);
    f = f + chk(21, b2u(ne_self(one)), 0u64);
    f = f + chk(22, b2u(le_self(nan)), 0u64);
    f = f + chk(23, b2u(ge_self(nan)), 0u64);
    f = f + chk(24, b2u(le_self(neg_zero)), 1u64);
    // !(a < b) is not (a >= b).
    f = f + chk(25, b2u(not_lt(nan, one)), 1u64);
    f = f + chk(26, b2u(not_lt(one, nan)), 1u64);
    f = f + chk(27, b2u(not_lt(one, nan) == (one >= nan)), 0u64);
    f = f + chk(28, b2u(not_lt(neg_zero, from_bits(0x0u64))), 1u64);
    // No reassociation: (1e16 + 1) + 1 is 1e16, a + (b + c) would be 1e16 + 2.
    let big = from_bits(0x4341C37937E08000u64);
    f = f + chk(29, to_bits(reassoc_add(big, one, one)), 0x4341C37937E08000u64);
    f = f + chk(30, to_bits(big + (one + one)), 0x4341C37937E08001u64);
    // (a * b) * c with a * b exact in range but the product rounding differs from a * (b * c).
    let m1 = from_bits(0x3FF0000000000001u64);
    let m2 = from_bits(0x3FEFFFFFFFFFFFFFu64);
    f = f + chk(31, to_bits(reassoc_mul(m1, m1, m2)), to_bits((m1 * m1) * m2));
    // No FMA contraction: a * b rounds to 1 + 2^-26 before the addition, so the sum is exactly 0.0 (a fused result is 2^-54).
    let a27 = from_bits(0x3FF0000002000000u64);
    let c26 = from_bits(0xBFF0000004000000u64);
    f = f + chk(32, to_bits(mul_then_add(a27, a27, c26)), 0x0u64);
    // f32: same rules with binary32 bit patterns.
    f = f + chk(33, to_bits32(f32_add_zero(from_bits32(0x80000000u32))) as u64, 0x0u64);
    f = f + chk_nan32(34, to_bits32(f32_sub_self(from_bits32(0x7F800000u32))));
    // Constant operands.
    f = f + chk(35, to_bits(const_zero_sum()), 0x0u64);
    f = f + chk(36, to_bits(const_neg_zero_sum()), 0x8000000000000000u64);
    f = f + chk(37, b2u(const_self_cmp()), 0u64);
    f = f + chk(38, const_int_fold() as u64, 42u64);
    // Dead float operations are removed or kept without changing the result.
    f = f + chk(39, to_bits(dead_ops(neg_zero)), 0x8000000000000000u64);
    // Evaluation order.
    f = f + chk(40, to_bits(order(one, neg_zero)), 0xFFF0000000000000u64);
    f = f + chk(41, to_bits(order(neg_one, one)), 0x0u64);
    if f == 0 {
        print("ok\n");
    }
    f
}
