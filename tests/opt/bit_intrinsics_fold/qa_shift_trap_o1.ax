// test: run
// flags: -O1
// exit: 101
// stderr-contains: panic:
// T484 QA adversarial: an out-of-range shift fed from a folded bit intrinsic must NOT be silently folded away at -O1.

fn main() -> i32 {
    let sh: u32 = 0i128.leading_zeros();
    let v: u128 = 1u128.reverse_bits() >> sh;
    print_int(v);
    print("\n");
    0
}
