// test: ui
// flags: -O1
// T484: non-dominating constant assignment in one branch must NOT fold `x.count_ones()` at `-O1` and hide `AX_INIT_USE_UNINIT`.

fn probe(cond: bool) -> u32 {
    let x: u32;
    if cond {
        x = 5u32;
    }
    x.count_ones() //~ ERROR AX_INIT_USE_UNINIT
}

fn main() -> i32 {
    let _ = probe(false);
    0
}
