// test: run
// exit: 0
// stdout: 308359719227068236683012351814082162680\n
// stdout: 8\n
// stdout: 8017110128763978870063666260445495812\n
// stdout: 613829471234282423\n
// stdout: 0\n
// stdout: 3\n
// stdout: 4\n
// stdout: 15\n
// T484: chained bit intrinsics, direct @intrinsic fn calls, and soundness checks ensuring
// mutated / multi-def / mut_view-borrowed / loop-updated locals are NEVER constant-folded.

@intrinsic fn rotate_left_u128(a: u128, n: u32) -> u128 { 0u128 }
@intrinsic fn reverse_bits_i64(a: i64) -> i64 { 0i64 }

const K_CHAIN_U128: u128 = 0x0102030405060708090A0B0C0D0E0F10u128;
const BASE_I64: i64 = -0x123456789ABCDEF0i64;

fn fold_chain_1() -> u128 {
    let x: u128 = K_CHAIN_U128;
    let n: u32 = 13u32;
    x.swap_bytes().reverse_bits().rotate_left(n).wrapping_neg()
}

fn fold_chain_2() -> u32 {
    K_CHAIN_U128.swap_bytes().rotate_right(9u32).leading_zeros()
}

fn fold_direct_1() -> u128 {
    rotate_left_u128(K_CHAIN_U128, 17u32)
}

fn fold_direct_2() -> i64 {
    reverse_bits_i64(BASE_I64)
}

fn overwrite_via_mut_view(p: mut_view<u32>) {
    *p = 16u32;
}

fn sound_reassigned_mut() -> u32 {
    let mut m: u64 = 1u64;
    m = 0x8000000000000000u64;
    m.leading_zeros()
}

fn sound_branch_multi_def(cond: bool) -> u32 {
    let x: u32 = if cond {
        1u32
    } else {
        7u32
    };
    let mut y: u32 = 0u32;
    if cond {
        y = 1u32;
    } else {
        y = 7u32;
    }
    if x.count_ones() != y.count_ones() {
        return 99u32;
    }
    x.count_ones()
}

fn sound_mut_view_borrow() -> u32 {
    let mut v: u32 = 1u32;
    overwrite_via_mut_view(mut_view(v));
    v.trailing_zeros()
}

fn sound_loop_accum() -> u32 {
    let mut acc: u32 = 0u32;
    let mut i: u32 = 0u32;
    while i < 4u32 {
        acc = (acc << 1u32) | 1u32;
        i = i + 1u32;
    }
    acc.rotate_left(0u32)
}

fn main() -> i32 {
    let v1: u128 = fold_chain_1();
    print_int(v1);
    print("\n");

    let v2: u32 = fold_chain_2();
    print_int(v2 as u128);
    print("\n");

    let v3: u128 = fold_direct_1();
    print_int(v3);
    print("\n");

    let v4: i64 = fold_direct_2();
    print_int(v4 as i128);
    print("\n");

    let s1: u32 = sound_reassigned_mut();
    if s1 != 0u32 { return 1; }
    print_int(s1 as u128);
    print("\n");

    let s2: u32 = sound_branch_multi_def(false);
    if s2 != 3u32 { return 2; }
    print_int(s2 as u128);
    print("\n");

    let s3: u32 = sound_mut_view_borrow();
    if s3 != 4u32 { return 3; }
    print_int(s3 as u128);
    print("\n");

    let s4: u32 = sound_loop_accum();
    if s4 != 15u32 { return 4; }
    print_int(s4 as u128);
    print("\n");

    0
}
