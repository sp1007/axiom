// T484 QA adversarial: boundary bit-intrinsic values (i8/isize/usize/i128/u128 MIN/MAX,
// rotate counts 0/BITS/BITS+k/u32::MAX, logical rotate_right on negative signed values,
// leading/trailing_zeros(0)), plus soundness against loop-backedge mutation and mut_view mutation.

const QA_I8_MIN: i8 = -128i8;
const QA_ISIZE_MIN: isize = -9223372036854775807isize - 1isize;
const QA_I128_MIN: i128 = -170141183460469231731687303715884105727i128 - 1i128;
const QA_U128_MAX: u128 = 340282366920938463463374607431768211455u128;
const QA_U32_MAX: u32 = 0xFFFFFFFFu32;

fn qa_i8_min_rotr_0() -> i8 { QA_I8_MIN.rotate_right(0u32) }
fn qa_i8_min_rotr_8() -> i8 { QA_I8_MIN.rotate_right(8u32) }
fn qa_i8_min_rotr_9() -> i8 { QA_I8_MIN.rotate_right(9u32) }
fn qa_i8_min_rotr_u32max() -> i8 { QA_I8_MIN.rotate_right(QA_U32_MAX) }

fn qa_i128_min_rotr_1() -> i128 { QA_I128_MIN.rotate_right(1u32) }
fn qa_i128_min_rotr_128() -> i128 { QA_I128_MIN.rotate_right(128u32) }
fn qa_i128_min_rotr_u32max() -> i128 { QA_I128_MIN.rotate_right(QA_U32_MAX) }
fn qa_i128_min_rotl_u32max() -> i128 { QA_I128_MIN.rotate_left(QA_U32_MAX) }
fn qa_i128_min_bitrev() -> i128 { QA_I128_MIN.reverse_bits() }
fn qa_i128_min_bswap() -> i128 { QA_I128_MIN.swap_bytes() }
fn qa_i128_min_wneg() -> i128 { QA_I128_MIN.wrapping_neg() }

fn qa_u128_max_wneg() -> u128 { QA_U128_MAX.wrapping_neg() }
fn qa_u128_max_rotl_u32max() -> u128 { QA_U128_MAX.rotate_left(QA_U32_MAX) }
fn qa_isize_min_bitrev() -> isize { QA_ISIZE_MIN.reverse_bits() }
fn qa_usize_bswap() -> usize { 0x0102030405060708usize.swap_bytes() }
fn qa_zero_clz_i128() -> u32 { 0i128.leading_zeros() }
fn qa_zero_ctz_i128() -> u32 { 0i128.trailing_zeros() }

fn qa_loop_backedge_u128() -> u128 {
    let mut x: u128 = 1u128;
    let mut acc: u128 = 0u128;
    let mut i: u32 = 0u32;
    while i < 4u32 {
        acc = acc ^ x.rotate_left(i);
        x = x.reverse_bits().wrapping_neg();
        i = i + 1u32;
    }
    acc
}

fn mutate_u8(p: mut_view<u8>) {
    *p = 0x80u8;
}

fn mutate_i128(p: mut_view<i128>) {
    *p = QA_I128_MIN;
}

fn qa_mut_view_u8_clz() -> u32 {
    let mut v: u8 = 1u8;
    mutate_u8(mut_view(v));
    v.leading_zeros()
}

fn qa_mut_view_u8_ctz() -> u32 {
    let mut v: u8 = 1u8;
    mutate_u8(mut_view(v));
    v.trailing_zeros()
}

fn qa_mut_view_i128_clz() -> u32 {
    let mut v: i128 = 1i128;
    mutate_i128(mut_view(v));
    v.leading_zeros()
}

fn qa_mut_view_i128_ctz() -> u32 {
    let mut v: i128 = 1i128;
    mutate_i128(mut_view(v));
    v.trailing_zeros()
}

fn main() -> i32 {
    print_int(qa_i8_min_rotr_0() as i128); print("\n");
    print_int(qa_i8_min_rotr_8() as i128); print("\n");
    print_int(qa_i8_min_rotr_9() as i128); print("\n");
    print_int(qa_i8_min_rotr_u32max() as i128); print("\n");

    print_int(qa_i128_min_rotr_1()); print("\n");
    print_int(qa_i128_min_rotr_128()); print("\n");
    print_int(qa_i128_min_rotr_u32max()); print("\n");
    print_int(qa_i128_min_rotl_u32max()); print("\n");
    print_int(qa_i128_min_bitrev()); print("\n");
    print_int(qa_i128_min_bswap()); print("\n");
    print_int(qa_i128_min_wneg()); print("\n");

    print_int(qa_u128_max_wneg()); print("\n");
    print_int(qa_u128_max_rotl_u32max()); print("\n");
    print_int(qa_isize_min_bitrev() as i128); print("\n");
    print_int(qa_usize_bswap() as u128); print("\n");
    print_int(qa_zero_clz_i128() as u128); print("\n");
    print_int(qa_zero_ctz_i128() as u128); print("\n");

    print_int(qa_loop_backedge_u128()); print("\n");
    print_int(qa_mut_view_u8_clz() as u128); print("\n");
    print_int(qa_mut_view_u8_ctz() as u128); print("\n");
    print_int(qa_mut_view_i128_clz() as u128); print("\n");
    print_int(qa_mut_view_i128_ctz() as u128); print("\n");
    0
}
