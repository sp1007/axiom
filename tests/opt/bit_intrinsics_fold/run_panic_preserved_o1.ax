// test: run
// flags: -O1
// exit: 101
// stderr-contains: panic: arithmetic overflow
// T484: under `interp -O1` and `native -O1`, `1u128.wrapping_neg() + 1u128` must still trap with arithmetic overflow.

fn main() -> i32 {
    let r: u128 = 1u128.wrapping_neg() + 1u128;
    print_int(r);
    print("\n");
    0
}
