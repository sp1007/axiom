fn fold_neg_expr_rotl_i128() -> i128 { (-0x123456789ABCDEF0123456789ABCDEF0i128).rotate_left(11u32) }

fn runtime_unfolded_u128(x: u128) -> u128 { x.reverse_bits() }
fn runtime_unfolded_rot_count(n: u32) -> u64 { 0x8123456789ABCDE0u64.rotate_left(n) }
