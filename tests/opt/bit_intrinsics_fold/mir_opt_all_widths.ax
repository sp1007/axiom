fn fold_direct_bswap_u128() -> u128 { swap_bytes_u128(0x0102030405060708090A0B0C0D0E0F10u128) }
fn fold_let_and_chain_u128() -> u128 {
    let x: u128 = K_CHAIN_U128;
    let n: u32 = 13u32;
    x.swap_bytes().reverse_bits().rotate_left(n).wrapping_neg()
}
fn fold_chain_to_u32() -> u32 { 0x0102030405060708090A0B0C0D0E0F10u128.swap_bytes().rotate_right(9u32).leading_zeros() }

fn fold_neg_expr_clz_i32() -> u32 { (-5i32).leading_zeros() }
