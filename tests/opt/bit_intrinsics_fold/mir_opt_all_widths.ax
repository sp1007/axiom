// test: helper
// T484: -O1 constant folding of all 8 bit intrinsics across all 12 integer types (8..128 bits).

@intrinsic fn rotate_left_u128(a: u128, n: u32) -> u128 { 0u128 }
@intrinsic fn reverse_bits_i64(a: i64) -> i64 { 0i64 }
@intrinsic fn wrapping_neg_i128(a: i128) -> i128 { 0i128 }
@intrinsic fn leading_zeros_u8(a: u8) -> u32 { 0u32 }
@intrinsic fn trailing_zeros_u128(a: u128) -> u32 { 0u32 }
@intrinsic fn count_ones_i128(a: i128) -> u32 { 0u32 }
@intrinsic fn swap_bytes_u128(a: u128) -> u128 { 0u128 }

const BASE_I8: i8 = -0x4Ci8;
const BASE_I16: i16 = -0x5CA4i16;
const BASE_I32: i32 = -0x6C5A39E8i32;
const BASE_I64: i64 = -0x123456789ABCDEF0i64;
