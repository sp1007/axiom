fn fold_direct_rotl_u128() -> u128 { rotate_left_u128(0x0102030405060708090A0B0C0D0E0F10u128, 17u32) }
fn fold_direct_bitrev_i64() -> i64 { reverse_bits_i64(BASE_I64) }
