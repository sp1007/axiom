// test: run
// exit: 101
// stderr-contains: panic: arithmetic overflow
// T484: `1u128.wrapping_neg()` folds to `u128.MAX`, and adding `1u128` via checked `+` must still trap at runtime.

fn main() -> i32 {
    let r: u128 = 1u128.wrapping_neg() + 1u128;
    print_int(r);
    print("\n");
    0
}
