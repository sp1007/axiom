    if c64 != d64 { return 65; }
    print_int(c64 as u128);
    print("\n");
    let c65: i16 = cf_i16_neg_bswap();
    let d65: i16 = rt_i16(-0x1234i16).swap_bytes();
    if c65 != d65 { return 66; }
    print_int(c65 as i128);
    print("\n");
    0
}
