// test: run
// flags: -O1

fn main() -> i32 {
    let a = 1;
    let b = a << 30;
    let c = b >> 30;
    
    let neg1 = -1;
    let d = neg1 * neg1;
    
    let x = 100;
    let y = 3;
    let z = x % y;
    
    let w = x / y;
    
    let b_not = !false;
    
    if c + d + z + w == 36 {
        if b_not {
            return 0;
        }
    }
    return 1;
}
