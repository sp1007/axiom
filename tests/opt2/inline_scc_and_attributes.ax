// test: run
// modes: interp native
// exit: 0
// stdout: OPT2_INL_BANNER=Inline_SCC_Attributes_And_Order\nEVAL_ARG=1\nEVAL_ARG=2\nEVAL_ARG=3\nINL_AUTO_HINT=85\nINL_ALWAYS_NEVER=165\nINL_CAP_VIEW=240\nINL_SCC_MUTUAL=8\nINL_SELF_REC=120\nINL_FN_PTR=77\nOPT2_INL_TOTAL=695\n

struct PairCounter {
    left: i32,
    right: i32,
}

fn auto_inline_helper(x: i32, y: i32) -> i32 {
    (x * 3) + (y * 2)
}

@inline
fn hinted_translate_sum(a: i32, b: i32, bias: i32) -> i32 {
    let p = PairCounter { left: a + bias, right: b + bias };
    auto_inline_helper(p.left, p.right)
}

@inline(always)
fn forced_inline_step(v: i32, scale: i32) -> i32 {
    v * scale + 15
}

@inline(never)
fn never_inline_boundary(v: i32) -> i32 {
    v + 50
}

// Left-to-right argument evaluation order (`AXS-INL-024.1`)
fn trace_arg(step_id: i32, val: i32) -> i32 {
    print("EVAL_ARG=");
    print_int(step_id);
    print("\n");
    val + step_id
}

@inline(always)
fn combine_three_inlined(a: i32, b: i32, c: i32) -> i32 {
    a * 10 + b * 5 + c
}

// Capability (`view<T>` and `mut_view<T>`) remapping across inlined calls (`AXS-INL-024.4`)
@inline(always)
fn read_pair_sum(p: view<PairCounter>) -> i32 {
    p.left + p.right
}

@inline(always)
fn bump_pair_in_place(p: mut_view<PairCounter>, dl: i32, dr: i32) {
    p.left = p.left + dl;
    p.right = p.right + dr;
}

fn test_capability_inlining(x: i32, y: i32) -> i32 {
    let mut pc = PairCounter { left: x, right: y };
    bump_pair_in_place(mut_view(pc), 30, 40);
    let s1: i32 = read_pair_sum(view(pc));
    bump_pair_in_place(mut_view(pc), 10, 20);
    s1 + read_pair_sum(view(pc))
}

// Bounded mutually recursive SCC (`AXS-INL-021.3`, `AXS-INL-022.2`):
// `@inline(always)` on a 2-node recursive cycle MUST terminate and preserve exact semantics!
@inline(always)
fn mutual_even_steps(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    mutual_odd_steps(n - 1) + 1
}

@inline(always)
fn mutual_odd_steps(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    mutual_even_steps(n - 1) + 1
}

// Direct self-recursion with `@inline(always)` (`AXS-INL-022.1`)
@inline(always)
fn bounded_fact(n: i32) -> i32 {
    if n <= 1 {
        return 1;
    }
    n * bounded_fact(n - 1)
}

// Function-pointer address taking & indirect call (`AXS-INL-002.3`, `AXS-INL-013.3`, `REQ-OPT-086`)
@inline(always)
fn add_seven(x: i32) -> i32 {
    x + 7
}

fn invoke_fn_ptr(f: fn(i32) -> i32, v: i32) -> i32 {
    f(v)
}

pub fn main() -> i32 {
    print("OPT2_INL_BANNER=Inline_SCC_Attributes_And_Order\n");

    let ord: i32 = combine_three_inlined(
        trace_arg(1, 9),
        trace_arg(2, 8),
        trace_arg(3, 2)
    );
    let v_auto: i32 = hinted_translate_sum(10, 15, 5);
    print("INL_AUTO_HINT=");
    print_int(v_auto);
    print("\n");

    let v_attr: i32 = forced_inline_step(never_inline_boundary(10), 2) + ord - 125;
    print("INL_ALWAYS_NEVER=");
    print_int(v_attr);
    print("\n");

    let v_cap: i32 = test_capability_inlining(15, 20);
    print("INL_CAP_VIEW=");
    print_int(v_cap);
    print("\n");

    let v_scc: i32 = mutual_even_steps(8);
    print("INL_SCC_MUTUAL=");
    print_int(v_scc);
    print("\n");

    let v_rec: i32 = bounded_fact(5);
    print("INL_SELF_REC=");
    print_int(v_rec);
    print("\n");

    let fp: fn(i32) -> i32 = add_seven;
    let v_fp: i32 = invoke_fn_ptr(fp, 70);
    print("INL_FN_PTR=");
    print_int(v_fp);
    print("\n");

    let total: i32 = v_auto + v_attr + v_cap + v_scc + v_rec + v_fp;
    print("OPT2_INL_TOTAL=");
    print_int(total);
    print("\n");
    0
}
