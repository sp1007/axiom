// test: run
// modes: interp native
// exit: 0
// stdout: QA_OPT2_SEAM_BANNER=Inline_SROA_NRVO_Drop_Seam\nSEAM_DROP=101\nSEAM_DROP=102\nSEAM_INL_NRVO=315\nSEAM_DROP=202\nSEAM_DROP=201\nSEAM_SCC_AGG=80\nSEAM_NEVER_ADDR=144\nQA_OPT2_SEAM_TOTAL=539\n

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct SeamDropToken {
    id: i32,
}

impl Drop for SeamDropToken {
    fn drop(self: mut_view<SeamDropToken>) {
        print("SEAM_DROP=");
        print_int(self.id);
        print("\n");
    }
}

struct SeamDropPair {
    first: SeamDropToken,
    second: SeamDropToken,
    accum: i32,
}

@derive(Copy)
struct SeamVec {
    x: i32,
    y: i32,
}

@derive(Copy)
enum SeamTag {
    NoneVal,
    SomePair(SeamVec, i32),
}

// 1. Cross-seam: `@inline(always)` helper with named NRVO + `mut_view` capability mutation + `Drop` fields
@inline(always)
fn bump_seam_pair(p: mut_view<SeamDropPair>, delta: i32) {
    p.accum = p.accum + delta;
}

@inline(always)
fn build_inlined_nrvo_pair(base: i32) -> SeamDropPair {
    let mut out = SeamDropPair {
        first: SeamDropToken { id: 101 },
        second: SeamDropToken { id: 102 },
        accum: base * 2,
    };
    bump_seam_pair(mut_view(out), 15);
    out
}

fn run_inlined_nrvo_and_enum_sroa(seed: i32) -> i32 {
    let pair = build_inlined_nrvo_pair(seed);
    let tag = SeamTag.SomePair(SeamVec { x: pair.accum, y: 50 }, 50);
    match tag {
        SeamTag.NoneVal => 0,
        SeamTag.SomePair(v, extra) => v.x + v.y + extra,
    }
}

// 2. Cross-seam: Mutually recursive `@inline(always)` SCC returning an aggregate `SeamVec`
@inline(always)
fn scc_vec_even(n: i32, acc_x: i32, acc_y: i32) -> SeamVec {
    if n <= 0 {
        return SeamVec { x: acc_x, y: acc_y };
    }
    scc_vec_odd(n - 1, acc_x + n, acc_y + 10)
}

@inline(always)
fn scc_vec_odd(n: i32, acc_x: i32, acc_y: i32) -> SeamVec {
    if n <= 0 {
        return SeamVec { x: acc_x, y: acc_y };
    }
    scc_vec_even(n - 1, acc_x + (n * 2), acc_y + 20)
}

fn run_scc_aggregate_seam() -> i32 {
    let _g1 = SeamDropToken { id: 201 };
    let _g2 = SeamDropToken { id: 202 };
    let v = scc_vec_even(4, 1, 5);
    v.x + v.y
}

// 3. Cross-seam negative barrier: `@inline(never)` + `address_of` on nested struct field blocks SROA
unsafe fn deref_i32_ptr(p: *const i32) -> i32 {
    *p
}

@inline(never)
fn never_inlined_addr_taken_vec(a: i32, b: i32) -> i32 {
    let mut v = SeamVec { x: a, y: b };
    v.x = v.x + 14;
    let py: *const i32 = unsafe { address_of(v.y) };
    let ry: i32 = unsafe { deref_i32_ptr(py) };
    v.x + ry
}

pub fn main() -> i32 {
    print("QA_OPT2_SEAM_BANNER=Inline_SROA_NRVO_Drop_Seam\n");

    let r1: i32 = run_inlined_nrvo_and_enum_sroa(100);
    print("SEAM_INL_NRVO=");
    print_int(r1);
    print("\n");

    let r2: i32 = run_scc_aggregate_seam();
    print("SEAM_SCC_AGG=");
    print_int(r2);
    print("\n");

    let r3: i32 = never_inlined_addr_taken_vec(50, 80);
    print("SEAM_NEVER_ADDR=");
    print_int(r3);
    print("\n");

    let total: i32 = r1 + r2 + r3;
    print("QA_OPT2_SEAM_TOTAL=");
    print_int(total);
    print("\n");
    0
}
