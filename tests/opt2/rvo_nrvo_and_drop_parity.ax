// test: run
// modes: interp native
// exit: 0
// stdout: OPT2_RVO_BANNER=RVO_NRVO_And_Drop_Parity\nRVO_DIRECT=260\nNRVO_SINGLE=340\nNRVO_GUARD_DROP=77\nNRVO_BRANCH=410\nCHAINED_RVO=520\nRVO_DROP_FIELD=10\nRVO_DROP_FIELD=20\nALIAS_SAFE_NRVO=178\nOPT2_RVO_TOTAL=1708\n

struct BigFrame {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
}

struct TrackedResource {
    id: i32,
}

impl Drop for TrackedResource {
    fn drop(self: mut_view<TrackedResource>) {
        print("RVO_DROP_FIELD=");
        print_int(self.id);
        print("\n");
    }
}

struct ResourceBundle {
    r1: TrackedResource,
    r2: TrackedResource,
    checksum: i32,
}

struct EarlyGuard {
    code: i32,
}

impl Drop for EarlyGuard {
    fn drop(self: mut_view<EarlyGuard>) {
        print("NRVO_GUARD_DROP=");
        print_int(self.code);
        print("\n");
    }
}

// 1. Direct unnamed RVO (`AXS-INL-012.1`)
fn make_direct_rvo(base: i64) -> BigFrame {
    BigFrame {
        a: base + 10,
        b: base + 20,
        c: base + 30,
        d: base + 40,
    }
}

// 2. Named NRVO (`AXS-INL-012.2`): named aggregate local mutated and returned on all normal paths
fn make_named_nrvo(base: i64) -> BigFrame {
    let mut res = BigFrame {
        a: base,
        b: base * 2,
        c: base * 3,
        d: base * 4,
    };
    res.a = res.a + 15;
    res.d = res.d + 25;
    res
}

// 3. Multi-branch Named NRVO with scoped Drop guard (`AXS-INL-012.2` rule 4)
fn make_branch_nrvo(mode: i32, base: i64) -> BigFrame {
    let mut out = BigFrame {
        a: base,
        b: base + 5,
        c: base + 10,
        d: base + 15,
    };
    if mode > 0 {
        let g = EarlyGuard { code: 77 };
        out.a = out.a + (g.code as i64);
        out.b = out.b + 103;
        return out;
    }
    out.c = out.c + 50;
    out
}

// 4. Chained return-slot forwarding (`AXS-INL-012.3`: `outer -> middle -> inner`)
fn inner_make_frame(seed: i64) -> BigFrame {
    BigFrame {
        a: seed + 100,
        b: seed + 110,
        c: seed + 120,
        d: seed + 130,
    }
}

fn middle_make_frame(seed: i64) -> BigFrame {
    inner_make_frame(seed + 5)
}

fn outer_make_frame(seed: i64) -> BigFrame {
    middle_make_frame(seed + 10)
}

// 5. RVO with Drop-bearing fields (`AXS-INL-011.3`, `AXS-INL-012`)
fn make_resource_bundle(a: i32, b: i32) -> ResourceBundle {
    ResourceBundle {
        r1: TrackedResource { id: a },
        r2: TrackedResource { id: b },
        checksum: a + b,
    }
}

// 6. Negative NRVO barrier when `mut_view` parameter could alias caller destination (`AXS-INL-012.2` rule 3)
fn update_and_return_frame(dst_view: mut_view<BigFrame>, delta: i64) -> BigFrame {
    let mut local_f = BigFrame {
        a: dst_view.a + delta,
        b: dst_view.b + delta,
        c: dst_view.c + delta,
        d: dst_view.d + delta,
    };
    dst_view.a = 999;
    local_f.a = local_f.a + 10;
    local_f
}

fn sum_frame(f: BigFrame) -> i64 {
    f.a + f.b + f.c + f.d
}

pub fn main() -> i32 {
    print("OPT2_RVO_BANNER=RVO_NRVO_And_Drop_Parity\n");

    let f1 = make_direct_rvo(40);
    let s1: i64 = sum_frame(f1);
    print("RVO_DIRECT=");
    print_int(s1);
    print("\n");

    let f2 = make_named_nrvo(30);
    let s2: i64 = sum_frame(f2);
    print("NRVO_SINGLE=");
    print_int(s2);
    print("\n");

    let f3 = make_branch_nrvo(1, 50);
    let s3: i64 = sum_frame(f3);
    print("NRVO_BRANCH=");
    print_int(s3);
    print("\n");

    let f4 = outer_make_frame(0);
    let s4: i64 = sum_frame(f4);
    print("CHAINED_RVO=");
    print_int(s4);
    print("\n");

    {
        let bundle = make_resource_bundle(10, 20);
        let _ = bundle.checksum;
    }

    let mut aliased = BigFrame { a: 10, b: 20, c: 30, d: 40 };
    aliased = update_and_return_frame(mut_view(aliased), 17);
    let s5: i64 = sum_frame(aliased);
    print("ALIAS_SAFE_NRVO=");
    print_int(s5);
    print("\n");

    let total: i64 = s1 + s2 + s3 + s4 + s5;
    print("OPT2_RVO_TOTAL=");
    print_int(total);
    print("\n");
    0
}
