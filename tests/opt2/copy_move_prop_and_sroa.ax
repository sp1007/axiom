// test: run
// modes: interp native
// exit: 0
// stdout: OPT2_SROA_BANNER=CopyMoveProp_DeepSROA_ClosureErase\nMOVE_CHAIN_DROP=42\nPARTIAL_DROP=20\nDROP_ORDER=1\nDROP_ORDER=2\nCOPY_PROP=140\nDEEP_SROA_STRUCT=360\nSROA_ENUM_RESULT=95\nSROA_SMALL_ARRAY=100\nCLOSURE_ERASE=230\nADDR_BARRIER=77\nOPT2_SROA_TOTAL=1044\n

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct OwnedToken {
    id: i32,
}

impl Drop for OwnedToken {
    fn drop(self: mut_view<OwnedToken>) {
        print("MOVE_CHAIN_DROP=");
        print_int(self.id);
        print("\n");
    }
}

struct OrderedField {
    tag: i32,
}

impl Drop for OrderedField {
    fn drop(self: mut_view<OrderedField>) {
        print("DROP_ORDER=");
        print_int(self.tag);
        print("\n");
    }
}

struct TwoDrops {
    first: OrderedField,
    second: OrderedField,
}

struct PartialField {
    code: i32,
}

impl Drop for PartialField {
    fn drop(self: mut_view<PartialField>) {
        print("PARTIAL_DROP=");
        print_int(self.code);
        print("\n");
    }
}

struct PartialPair {
    moved_out: PartialField,
    kept_for_drop: PartialField,
}

struct Vec2 {
    x: i32,
    y: i32,
}

struct Box2D {
    min_pt: Vec2,
    max_pt: Vec2,
}

@derive(Copy)
enum CalcOutcome {
    OkVal(i32, i32),
    ErrCode(i32),
}

// 1. Copy propagation across dominated statements & branches (`AXS-INL-010.1`)
fn test_copy_propagation(a: i32, b: i32) -> i32 {
    let c1: i32 = a + b;
    let c2: i32 = c1;
    let c3: i32 = c2;
    let k: i32 = 20;
    let k_copy: i32 = k;
    if c3 > 0 {
        let branch_copy: i32 = c3;
        return branch_copy * 2 + k_copy;
    }
    c2 + k_copy
}

// 2. Move propagation & move-chain coalescing with single Drop obligation (`AXS-INL-010.2`)
fn test_move_chain_coalescing(seed: i32) -> i32 {
    let tok0 = OwnedToken { id: seed };
    let tok1 = tok0;
    let tok2 = tok1;
    let tok_final = tok2;
    tok_final.id
}

// 3. Field-order Drop decomposition `(0..k-1)` & partial-move drop skipping (`AXS-INL-011.3`)
fn consume_partial_field(f: PartialField) -> i32 {
    let v: i32 = f.code;
    // `f` is dropped at the end of `consume_partial_field`? Wait: let's test partial move where `moved_out` is forgotten or returned
    v
}

fn test_drop_order_and_partial_move() -> i32 {
    let pair = TwoDrops {
        first: OrderedField { tag: 1 },
        second: OrderedField { tag: 2 },
    };
    let sum_tags: i32 = pair.first.tag + pair.second.tag;
    let part = PartialField { code: 20 };
    sum_tags + part.code
}

// 4. Deep multi-level SROA on nested structs (`Box2D` -> `Vec2` -> scalar `i32` leaves, `AXS-INL-011.1..2`)
fn test_deep_sroa_nested_struct(x0: i32, y0: i32) -> i32 {
    let p_min = Vec2 { x: x0, y: y0 };
    let p_max = Vec2 { x: x0 + 50, y: y0 + 70 };
    let b0 = Box2D { min_pt: p_min, max_pt: p_max };
    let b1 = b0;
    let dx: i32 = b1.max_pt.x - b1.min_pt.x;
    let dy: i32 = b1.max_pt.y - b1.min_pt.y;
    (dx + dy) * 3
}

// 5. Enum / Result SROA (`AXS-INL-011.2`): discriminant + variant payload scalarization
fn make_outcome(v: i32) -> CalcOutcome {
    if v >= 0 {
        return CalcOutcome.OkVal(v + 40, v + 15);
    }
    CalcOutcome.ErrCode(999)
}

fn test_sroa_enum_result(v: i32) -> i32 {
    let out = make_outcome(v);
    match out {
        CalcOutcome.OkVal(a, b) => a + b,
        CalcOutcome.ErrCode(e) => e,
    }
}

// 6. Small fixed-size array SROA with constant indices (`AXS-INL-011.1`)
fn test_sroa_small_array(base: i32) -> i32 {
    let arr: [4]i32 = [base, base + 10, base + 20, base + 30];
    let copy_arr: [4]i32 = arr;
    copy_arr[0] + copy_arr[1] + copy_arr[2] + copy_arr[3]
}

// 7. Closure capture inlining & environment SROA erasure (`AXS-INL-013`)
fn test_closure_capture_sroa(seed: i32) -> i32 {
    let factor: i32 = 2;
    let bias: i32 = 30;
    let step = |v: i32| -> i32 {
        v * factor + bias
    };
    let first: i32 = step(seed);
    step(first)
}

// 8. Negative SROA barrier: `address_of` observable address (`AXS-INL-011.1`, `REQ-OPT-119`)
unsafe fn read_via_raw_ptr(p: *const i32) -> i32 {
    *p
}

fn test_sroa_address_barrier(x: i32, y: i32) -> i32 {
    let v = Vec2 { x: x, y: y };
    let px: *const i32 = unsafe { address_of(v.x) };
    let rx: i32 = unsafe { read_via_raw_ptr(px) };
    rx + v.y
}

pub fn main() -> i32 {
    print("OPT2_SROA_BANNER=CopyMoveProp_DeepSROA_ClosureErase\n");

    let mv: i32 = test_move_chain_coalescing(42);
    let _ = test_drop_order_and_partial_move();
    let cp: i32 = test_copy_propagation(25, 35);
    let ds: i32 = test_deep_sroa_nested_struct(10, 20);
    let er: i32 = test_sroa_enum_result(20);
    let sa: i32 = test_sroa_small_array(10);
    let ce: i32 = test_closure_capture_sroa(35);
    let ab: i32 = test_sroa_address_barrier(30, 47);

    print("COPY_PROP=");
    print_int(cp);
    print("\n");
    print("DEEP_SROA_STRUCT=");
    print_int(ds);
    print("\n");
    print("SROA_ENUM_RESULT=");
    print_int(er);
    print("\n");
    print("SROA_SMALL_ARRAY=");
    print_int(sa);
    print("\n");
    print("CLOSURE_ERASE=");
    print_int(ce);
    print("\n");
    print("ADDR_BARRIER=");
    print_int(ab);
    print("\n");

    let total: i32 = mv + cp + ds + er + sa + ce + ab;
    print("OPT2_SROA_TOTAL=");
    print_int(total);
    print("\n");
    0
}
