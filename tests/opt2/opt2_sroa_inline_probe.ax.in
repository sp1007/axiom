@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@PROBE_MIR_FN@

fn probe_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn empty_node_map() -> NodeMap {
    NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 }
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn probe_init_fe_session(perm_arena: mut_view<Arena>) -> *mut CompilerSession {
    let sess_ptr = arena_alloc_raw(mut_view(*perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let str_bytes_arena = new_arena(262144);
    let str_cap: usize = 2048;
    let str_arr = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(str_cap, size_of<StrView>()), align_of<StrView>()) as *mut StrView;
    let smap_cap: usize = 4096;
    let smap_hashes = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 8), 8) as *mut u64;
    let smap_ids = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 4), 4) as *mut u32;
    unsafe {
        session_init(mut_view(*sess_ptr));
        arena_destroy(mut_view((*sess_ptr).interner.bytes));
        (*sess_ptr).interner.bytes = str_bytes_arena;
        (*sess_ptr).interner.strings = str_arr;
        (*sess_ptr).interner.cap = str_cap;
        (*sess_ptr).interner.map_hashes = smap_hashes;
        (*sess_ptr).interner.map_ids = smap_ids;
        (*sess_ptr).interner.map_cap = smap_cap;
    }
    sess_ptr
}

fn probe_free_fe_session(sess_ptr: *mut CompilerSession) {
    unsafe {
        (*sess_ptr).interner.cap = 0;
        (*sess_ptr).interner.map_cap = 0;
        session_free(mut_view(*sess_ptr));
    }
}

// Section 1: Copy/Move Propagation, Deep SROA, RVO/NRVO, Barriers, Rollback, & Deterministic `sroa_print`
fn probe_sroa_copy_move_and_rvo_nrvo() -> i32 {
    let sc = sroa_contract();
    if sc.pass_id != PASS_COPY_MOVE_SROA || sc.pass_id != 13u16 ||
       sc.preserved_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS) ||
       sc.postconditions != POSTCOND_ALL {
        return 101;
    }

    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(262144);
    let mut res_a = new_arena(262144);
    let mut hir_a = new_arena(262144);
    let mut mir_a = new_arena(524288);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src1_sv = probe_blob(mut_view(perm_a), 1);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src1_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir1 = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir1), mut_view(*thir_fe)); }
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 102;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir1.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 16);
    let esc_tbl = arena_alloc_raw(mut_view(mir_a), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(mir_a), 16);

    let mut total_stats = sroa_stats_zero();
    let slog = sroa_log_new(mut_view(mir_a), 64);
    let mut fn_seen: usize = 0;
    let mut rc: i32 = 0;
    let mut it: *mut HirItem = hir1.items;

    while (it as usize) != 0 && rc == 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
            let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
            if (mbody as usize) != 0 {
                // On function 0, also test `-O0` no-op and `force_verify_fail` rollback
                if fn_seen == 0 {
                    let ob_rb = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                    let pm_rb = arena_alloc_raw(mut_view(mir_a), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
                    passmgr_init(unsafe { mut_view(*pm_rb) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(mir_a));
                    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_rb) }, unsafe { mut_view(*ob_rb) }, mut_view(mir_a));
                    let mut rb_stats = sroa_stats_zero();
                    let mut rb_info: *mut SroaInfo = 0 as *mut SroaInfo;
                    let rb_changed = sroa_run_pass_internal(
                        unsafe { mut_view(*pm_rb) },
                        unsafe { mut_view(*ob_rb) },
                        ct_fe as *const EffectCallTable,
                        esc_tbl as *const EscapeSummaryTable,
                        mut_view(rb_info),
                        mut_view(rb_stats),
                        0 as *mut SroaDecisionLog,
                        true,
                        mut_view(mir_a),
                        unsafe { mut_view(*sink_fe) }
                    );
                    if rb_changed || rb_stats.pass_rollbacks != 1u32 {
                        rc = 103;
                    }
                }

                if rc == 0 {
                    let mut fn_stats = sroa_stats_zero();
                    let ok = sroa_optimize_mir_body(
                        unsafe { mut_view(*mbody) },
                        thir_fe as *const Thir,
                        OPT_PROFILE_SPEED_O2,
                        true,
                        ct_fe as *const EffectCallTable,
                        esc_tbl as *const EscapeSummaryTable,
                        mut_view(fn_stats),
                        slog,
                        mut_view(mir_a),
                        unsafe { mut_view(*sink_fe) },
                        it as *const HirItem
                    );
                    if !ok || fn_stats.pass_rollbacks != 0u32 {
                        rc = 110 + (fn_seen as i32);
                    } else {
                        total_stats.copy_propagations = total_stats.copy_propagations + fn_stats.copy_propagations;
                        total_stats.move_propagations = total_stats.move_propagations + fn_stats.move_propagations;
                        total_stats.move_chains_coalesced = total_stats.move_chains_coalesced + fn_stats.move_chains_coalesced;
                        total_stats.drop_flags_folded = total_stats.drop_flags_folded + fn_stats.drop_flags_folded;
                        total_stats.sroa_aggregates_scalarized = total_stats.sroa_aggregates_scalarized + fn_stats.sroa_aggregates_scalarized;
                        total_stats.sroa_leaves_created = total_stats.sroa_leaves_created + fn_stats.sroa_leaves_created;
                        total_stats.sroa_drops_decomposed = total_stats.sroa_drops_decomposed + fn_stats.sroa_drops_decomposed;
                        total_stats.sroa_blocked_count = total_stats.sroa_blocked_count + fn_stats.sroa_blocked_count;
                        total_stats.rvo_promotions = total_stats.rvo_promotions + fn_stats.rvo_promotions;
                        total_stats.nrvo_promotions = total_stats.nrvo_promotions + fn_stats.nrvo_promotions;

                        verify_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                        verify_mir_own(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                        verify_mir_cap(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) });
                        unsafe {
                            mir_drop_elaborate(mut_view(*mbody), mut_view(*thir_fe), view(hir1), db_ptr, view(*str_in_ptr), mut_view(mir_a));
                        }
                        verify_mir_drop_flags(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                        if (unsafe { (*sink_fe).errors }) != 0 {
                            rc = 130 + (fn_seen as i32);
                        }
                    }
                }
                fn_seen = fn_seen + 1;
            }
        }
        it = unsafe { (*it).next };
    }

    if rc == 0 {
        if fn_seen < 7 {
            rc = 150;
        } else if total_stats.copy_propagations == 0u32 {
            rc = 151;
        } else if total_stats.move_propagations == 0u32 {
            rc = 152;
        } else if (total_stats.sroa_aggregates_scalarized) < 3u32 {
            rc = 153;
        } else if (total_stats.sroa_leaves_created) < 6u32 {
            rc = 154;
        } else if (total_stats.sroa_blocked_count) < 2u32 {
            rc = 155;
        } else if (total_stats.rvo_promotions + total_stats.nrvo_promotions) < 2u32 {
            rc = 156;
        }
    }

    // Verify decision log records & deterministic `sroa_print`
    if rc == 0 {
        let mut saw_scalarized = false;
        let mut saw_blocked_addr = false;
        let mut saw_blocked_dyn_idx = false;
        let mut saw_rvo_or_nrvo = false;
        let lcnt = unsafe { (*slog).count };
        let mut li: usize = 0;
        while li < lcnt {
            let rp = unsafe { sroa_record_at((*slog).records, li) };
            let dec = unsafe { (*rp).decision };
            let br = unsafe { (*rp).block_reason };
            if dec == SROA_DECISION_SCALARIZED {
                saw_scalarized = true;
            } else if dec == SROA_DECISION_BLOCKED {
                if br == SROA_BLOCK_ADDR_OBSERVABLE {
                    saw_blocked_addr = true;
                } else if br == SROA_BLOCK_DYNAMIC_INDEX {
                    saw_blocked_dyn_idx = true;
                }
            } else if dec == SROA_DECISION_RVO || dec == SROA_DECISION_NRVO {
                saw_rvo_or_nrvo = true;
            }
            li = li + 1;
        }
        if !saw_scalarized {
            rc = 160;
        } else if !saw_blocked_addr {
            rc = 161;
        } else if !saw_blocked_dyn_idx {
            rc = 162;
        } else if !saw_rvo_or_nrvo {
            rc = 163;
        } else {
            let mut sb1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            let mut sb2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            diag_buf_init(mut_view(sb1));
            diag_buf_init(mut_view(sb2));
            sroa_print(view(total_stats), unsafe { view(*slog) }, mut_view(sb1));
            sroa_print(view(total_stats), unsafe { view(*slog) }, mut_view(sb2));
            if (sb1.len) < 32 || !diag_buf_eq(view(sb1), view(sb2)) {
                rc = 142;
            }
            diag_buf_free(mut_view(sb1));
            diag_buf_free(mut_view(sb2));
        }
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

// Section 2 & 3 & 4: CallGraph, Tarjan SCCs, Summaries, Legality vs CostModel, Transactional Inlining, & Post-Inline SROA Cascade
fn probe_callgraph_scc_legality_and_inliner() -> i32 {
    let ic = inline_contract();
    if ic.pass_id != PASS_INLINE || ic.pass_id != 14u16 ||
       ic.preserved_analyses != ANALYSIS_MASK_CALL_GRAPH ||
       ic.postconditions != POSTCOND_ALL {
        return 201;
    }

    // Verify `inline_budget_for_profile` ordering across profiles (`-O0` < `-Oz` < `-Os` < `-O1` < `-O2` < `-O3`)
    let b_o0 = inline_budget_for_profile(OPT_PROFILE_DEBUG_O0);
    let b_oz = inline_budget_for_profile(OPT_PROFILE_MINSIZE_OZ);
    let b_os = inline_budget_for_profile(OPT_PROFILE_SIZE_OS);
    let b_o1 = inline_budget_for_profile(OPT_PROFILE_BALANCED_O1);
    let b_o2 = inline_budget_for_profile(OPT_PROFILE_SPEED_O2);
    let b_o3 = inline_budget_for_profile(OPT_PROFILE_MAX_O3);
    if b_o0.max_callee_insts != 0u32 ||
       !((b_oz.base_threshold_insts) < b_os.base_threshold_insts &&
         (b_os.base_threshold_insts) < b_o1.base_threshold_insts &&
         (b_o1.base_threshold_insts) < b_o2.base_threshold_insts &&
         (b_o2.base_threshold_insts) < b_o3.base_threshold_insts) {
        return 202;
    }

    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(262144);
    let mut res_a = new_arena(262144);
    let mut hir_a = new_arena(262144);
    let mut mir_a = new_arena(1048576);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src2_sv = probe_blob(mut_view(perm_a), 2);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src2_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir2 = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir2), mut_view(*thir_fe)); }
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 203;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir2.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 32);
    let esc_tbl = arena_alloc_raw(mut_view(mir_a), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(mir_a), 32);

    let cg = callgraph_new(mut_view(mir_a), thir_fe as *const Thir, true, false);

    // Lower functions in Blob 2 in declaration order:
    //   0: pure_translate_vec
    //   1: result_status_fn (returns enum Outcome, no panic!)
    //   2: never_inline_helper (`INLINE_ATTR_NEVER`)
    //   3: even_rec (`INLINE_ATTR_ALWAYS`, mutual SCC with odd_rec)
    //   4: odd_rec (`INLINE_ATTR_ALWAYS`, mutual SCC with even_rec)
    //   5: self_rec_fn (`INLINE_ATTR_ALWAYS`, direct self recursion)
    //   6: addr_taken_target (`INLINE_ATTR_HINT`)
    //   7: dead_internal_fn (unreferenced in closed world)
    //   8: caller_entry_root (export root calling 0, 1, 2, 3, 5, and taking address of 6)
    let mut fn_idx: usize = 0;
    let mut it: *mut HirItem = hir2.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
            let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
            if (mbody as usize) != 0 {
                let ob = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                let attr: u8 = if fn_idx == 2 {
                    INLINE_ATTR_NEVER
                } else if fn_idx == 3 || fn_idx == 4 || fn_idx == 5 {
                    INLINE_ATTR_ALWAYS
                } else if fn_idx == 0 || fn_idx == 6 {
                    INLINE_ATTR_HINT
                } else {
                    INLINE_ATTR_NONE
                };
                let is_root = fn_idx == 8;
                let _ = callgraph_add_node(
                    unsafe { mut_view(*cg) },
                    mut_view(mir_a),
                    unsafe { (*it).symbol },
                    unsafe { (*it).name },
                    mbody,
                    ob,
                    it as *const HirItem,
                    attr,
                    false,
                    is_root,
                    false,
                    false,
                    DOMAIN_CPU_HOST,
                    false
                );
                fn_idx = fn_idx + 1;
            }
        }
        it = unsafe { (*it).next };
    }

    if fn_idx != 9 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 204;
    }

    // Add synthetic nodes for FFI extern, GPU kernel, and Async `.await` boundary to test all dispatch & legality kinds
    let ffi_node = callgraph_add_node(
        unsafe { mut_view(*cg) }, mut_view(mir_a),
        SymbolId { v: 9001u32 }, StrId { v: 0u32 },
        0 as *mut MirBody, 0 as *mut OptBody, 0 as *const HirItem,
        INLINE_ATTR_ALWAYS, true, false, false, false, DOMAIN_CPU_HOST, false
    );
    let gpu_node = callgraph_add_node(
        unsafe { mut_view(*cg) }, mut_view(mir_a),
        SymbolId { v: 9002u32 }, StrId { v: 0u32 },
        unsafe { (*cg_node_at((*cg).nodes, 0)).mir }, unsafe { (*cg_node_at((*cg).nodes, 0)).opt_body }, 0 as *const HirItem,
        INLINE_ATTR_ALWAYS, false, false, false, false, DOMAIN_GPU_KERNEL, false
    );
    let async_node = callgraph_add_node(
        unsafe { mut_view(*cg) }, mut_view(mir_a),
        SymbolId { v: 9003u32 }, StrId { v: 0u32 },
        unsafe { (*cg_node_at((*cg).nodes, 0)).mir }, unsafe { (*cg_node_at((*cg).nodes, 0)).opt_body }, 0 as *const HirItem,
        INLINE_ATTR_ALWAYS, false, false, false, false, DOMAIN_CPU_HOST, true
    );

    callgraph_finalize(unsafe { mut_view(*cg) }, unsafe { mut_view(*ct_fe) }, unsafe { mut_view(*esc_tbl) }, mut_view(mir_a));

    let mut rc: i32 = 0;
    let n0 = unsafe { cg_node_at((*cg).nodes, 0) };
    let n1 = unsafe { cg_node_at((*cg).nodes, 1) };
    let n3 = unsafe { cg_node_at((*cg).nodes, 3) };
    let n4 = unsafe { cg_node_at((*cg).nodes, 4) };
    let n5 = unsafe { cg_node_at((*cg).nodes, 5) };
    let n6 = unsafe { cg_node_at((*cg).nodes, 6) };
    let n7 = unsafe { cg_node_at((*cg).nodes, 7) };
    let n8 = unsafe { cg_node_at((*cg).nodes, 8) };

    // 1. Verify Pure vs Result<T, E> normal return (`AXS-INL-004.2..3`, `REQ-OPT-067`, `REQ-OPT-068`)
    if (unsafe { (*n0).effect_summary.flags }) != EFFECT_PURE ||
       (unsafe { (*n0).effect_summary.pure_certainty }) != CERTAINTY_PROVEN {
        rc = 210;
    } else if !(unsafe { (*n1).returns_result_or_option }) ||
              ((unsafe { (*n1).effect_summary.flags }) & EFFECT_MAY_PANIC) != 0u16 {
        rc = 211;
    }

    // 2. Verify Tarjan SCCs: `even_rec` (3) and `odd_rec` (4) share a 2-node recursive SCC; `self_rec_fn` (5) is a 1-node recursive SCC
    if rc == 0 {
        let scc_3 = unsafe { (*n3).scc_id };
        let scc_4 = unsafe { (*n4).scc_id };
        let scc_5 = unsafe { (*n5).scc_id };
        let scc_0 = unsafe { (*n0).scc_id };
        let scc_8 = unsafe { (*n8).scc_id };
        if scc_3 != scc_4 || scc_3 >= (unsafe { (*cg).scc_count as u32 }) {
            rc = 212;
        } else {
            let sp_34 = unsafe { cg_scc_at((*cg).sccs, scc_3 as usize) };
            let sp_5 = unsafe { cg_scc_at((*cg).sccs, scc_5 as usize) };
            let sp_0 = unsafe { cg_scc_at((*cg).sccs, scc_0 as usize) };
            // Bottom-up reverse topological order: leaf `n0` has smaller `scc_id` than caller `n8`!
            if !(unsafe { (*sp_34).is_recursive }) || (unsafe { (*sp_34).member_count }) != 2u32 ||
               !(unsafe { (*sp_5).is_recursive }) || (unsafe { (*sp_5).member_count }) != 1u32 ||
               (unsafe { (*sp_0).is_recursive }) || scc_0 >= scc_8 {
                rc = 213;
            }
        }
    }

    // 3. Verify `address_taken_fn` and closed-world reachability (`AXS-INL-002.3`, `AXS-INL-005`, `REQ-OPT-086`)
    if rc == 0 {
        if !(unsafe { (*n6).address_taken_fn }) || (unsafe { (*n6).reachability }) != REACH_ROOT ||
           (unsafe { (*n7).reachability }) != REACH_DEAD_ELIMINATED ||
           (unsafe { (*n8).reachability }) != REACH_ROOT ||
           (unsafe { (*n0).reachability }) != REACH_INTERNAL {
            rc = 214;
        }
    }

    // 4. Verify deterministic `callgraph_print`
    if rc == 0 {
        let mut cb1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
        let mut cb2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
        diag_buf_init(mut_view(cb1));
        diag_buf_init(mut_view(cb2));
        callgraph_print(unsafe { view(*cg) }, mut_view(cb1));
        callgraph_print(unsafe { view(*cg) }, mut_view(cb2));
        if (cb1.len) < 64 || !diag_buf_eq(view(cb1), view(cb2)) {
            rc = 215;
        }
        diag_buf_free(mut_view(cb1));
        diag_buf_free(mut_view(cb2));
    }
    if rc == 0 {
        print("PROBE_CALLGRAPH_SCC_AND_SUMMARIES=OK\n");
    }

    // 5. Verify Stage 1 (`InlineLegality`) vs Stage 2 (`CostModel`) (`AXS-INL-020..023`, `REQ-OPT-071..072`, `REQ-OPT-082`)
    if rc == 0 {
        let hist_root = inline_history_with_root(unsafe { (*n8).fn_sym });

        // 5a. `@inline(never)` (`node 2`) -> `INLINE_ILLEGAL(INLINE_REASON_ATTR_INLINE_NEVER)`
        let e_never = CallEdge {
            edge_id: 0u32, caller_sym: unsafe { (*n8).fn_sym }, caller_node_idx: 8u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DIRECT, known_callee: unsafe { (* cg_node_at((*cg).nodes, 2)).fn_sym },
            callee_node_idx: 2u32, possible_targets: 0 as *mut SymbolId, possible_target_count: 1,
            targets_complete: true, is_inlined: false, is_tail_position: false,
            in_loop_depth: 2u32, is_cold_callsite: false, const_arg_mask: 3u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let dec_never = inline_evaluate_cost(unsafe { view(*cg) }, view(e_never), view(hist_root), view(b_o3));
        if dec_never.legality != INLINE_ILLEGAL || dec_never.block_reason != INLINE_REASON_ATTR_INLINE_NEVER || dec_never.profitable {
            rc = 220;
        }

        // 5b. Foreign FFI (`ffi_node`) with `@inline(always)` -> `INLINE_ILLEGAL(INLINE_REASON_EXTERN_NO_BODY)`
        let e_ffi = CallEdge {
            edge_id: 1u32, caller_sym: unsafe { (*n8).fn_sym }, caller_node_idx: 8u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_FFI_EXTERN, known_callee: SymbolId { v: 9001u32 },
            callee_node_idx: ffi_node, possible_targets: 0 as *mut SymbolId, possible_target_count: 1,
            targets_complete: true, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let dec_ffi = inline_evaluate_cost(unsafe { view(*cg) }, view(e_ffi), view(hist_root), view(b_o3));
        if dec_ffi.legality != INLINE_ILLEGAL || dec_ffi.block_reason != INLINE_REASON_EXTERN_NO_BODY || dec_ffi.profitable {
            rc = 221;
        }

        // 5c. Unproven indirect `DISPATCH_DYN_TRAIT` / `DISPATCH_FN_PTR` -> `INLINE_ILLEGAL(INLINE_REASON_INDIRECT_UNPROVEN)`
        let e_dyn = CallEdge {
            edge_id: 2u32, caller_sym: unsafe { (*n8).fn_sym }, caller_node_idx: 8u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DYN_TRAIT, known_callee: SymbolId { v: 0u32 },
            callee_node_idx: INLINE_NONE_IDX, possible_targets: 0 as *mut SymbolId, possible_target_count: 0,
            targets_complete: false, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let dec_dyn = inline_evaluate_cost(unsafe { view(*cg) }, view(e_dyn), view(hist_root), view(b_o3));
        if dec_dyn.legality != INLINE_ILLEGAL || dec_dyn.block_reason != INLINE_REASON_INDIRECT_UNPROVEN || dec_dyn.profitable {
            rc = 222;
        }

        // 5d. Host-to-GPU launch (`gpu_node`) with `@inline(always)` -> `INLINE_ILLEGAL(INLINE_REASON_DOMAIN_MISMATCH)`
        let e_gpu = CallEdge {
            edge_id: 3u32, caller_sym: unsafe { (*n8).fn_sym }, caller_node_idx: 8u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DIRECT, known_callee: SymbolId { v: 9002u32 },
            callee_node_idx: gpu_node, possible_targets: 0 as *mut SymbolId, possible_target_count: 1,
            targets_complete: true, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let dec_gpu = inline_evaluate_cost(unsafe { view(*cg) }, view(e_gpu), view(hist_root), view(b_o3));
        if dec_gpu.legality != INLINE_ILLEGAL || dec_gpu.block_reason != INLINE_REASON_DOMAIN_MISMATCH || dec_gpu.profitable {
            rc = 223;
        }

        // 5e. Async `.await` suspension (`async_node`) with `@inline(always)` -> `INLINE_ILLEGAL(INLINE_REASON_ASYNC_AWAIT_BOUNDARY)`
        let e_async = CallEdge {
            edge_id: 4u32, caller_sym: unsafe { (*n8).fn_sym }, caller_node_idx: 8u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DIRECT, known_callee: SymbolId { v: 9003u32 },
            callee_node_idx: async_node, possible_targets: 0 as *mut SymbolId, possible_target_count: 1,
            targets_complete: true, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let dec_async = inline_evaluate_cost(unsafe { view(*cg) }, view(e_async), view(hist_root), view(b_o3));
        if dec_async.legality != INLINE_ILLEGAL || dec_async.block_reason != INLINE_REASON_ASYNC_AWAIT_BOUNDARY || dec_async.profitable {
            rc = 224;
        }

        // 5f. Recursive SCC cycle (`even_rec -> odd_rec -> even_rec`) with `@inline(always)`:
        //     First step `even_rec -> odd_rec` is LEGAL & forced by `@inline(always)`,
        //     Back-edge `odd_rec -> even_rec` (when `even_rec` is on `InlineHistoryChain`) is `INLINE_ILLEGAL(INLINE_REASON_RECURSIVE_SCC_LIMIT)`!
        let hist_even = inline_history_with_root(unsafe { (*n3).fn_sym });
        let e_even_to_odd = CallEdge {
            edge_id: 5u32, caller_sym: unsafe { (*n3).fn_sym }, caller_node_idx: 3u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DIRECT, known_callee: unsafe { (*n4).fn_sym },
            callee_node_idx: 4u32, possible_targets: 0 as *mut SymbolId, possible_target_count: 1,
            targets_complete: true, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let dec_step1 = inline_evaluate_cost(unsafe { view(*cg) }, view(e_even_to_odd), view(hist_even), view(b_o2));
        let hist_even_odd = inline_history_push(view(hist_even), unsafe { (*n4).fn_sym });
        let e_odd_to_even = CallEdge {
            edge_id: 6u32, caller_sym: unsafe { (*n4).fn_sym }, caller_node_idx: 4u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DIRECT, known_callee: unsafe { (*n3).fn_sym },
            callee_node_idx: 3u32, possible_targets: 0 as *mut SymbolId, possible_target_count: 1,
            targets_complete: true, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let dec_backedge = inline_evaluate_cost(unsafe { view(*cg) }, view(e_odd_to_even), view(hist_even_odd), view(b_o2));
        if dec_step1.legality != INLINE_LEGAL || !dec_step1.profitable || !dec_step1.forced_by_always ||
           dec_backedge.legality != INLINE_ILLEGAL || dec_backedge.block_reason != INLINE_REASON_RECURSIVE_SCC_LIMIT || dec_backedge.profitable {
            rc = 225;
        }
    }
    if rc == 0 {
        print("PROBE_INLINE_LEGALITY_AND_COST_MODEL=OK\n");
    }

    // 6. Verify transactional rollback on `force_verify_fail = true` and full bottom-up `inline_optimize_callgraph` + post-inline SROA cascade (`AXS-INL-024..026`)
    if rc == 0 {
        let n8_ob = unsafe { (*cg_node_at((*cg).nodes, 8)).opt_body };
        let pm_inl = arena_alloc_raw(mut_view(mir_a), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
        passmgr_init(unsafe { mut_view(*pm_inl) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(mir_a));
        passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_inl) }, unsafe { mut_view(*n8_ob) }, mut_view(mir_a));
        let mut rb_istats = inline_stats_zero();
        let rb_ilog = inline_log_new(mut_view(mir_a), 16);
        let rb_inlined = inline_run_pass_internal(
            unsafe { mut_view(*pm_inl) },
            unsafe { mut_view(*n8_ob) },
            unsafe { mut_view(*cg) },
            ct_fe as *const EffectCallTable,
            esc_tbl as *const EscapeSummaryTable,
            mut_view(rb_istats),
            rb_ilog,
            0 as *mut SroaStats,
            0 as *mut SroaDecisionLog,
            true,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if rb_inlined || rb_istats.pass_rollbacks == 0u32 {
            rc = 230;
        }
    }

    if rc == 0 {
        let mut istats = inline_stats_zero();
        let ilog = inline_log_new(mut_view(mir_a), 64);
        let mut sstats = sroa_stats_zero();
        let slog = sroa_log_new(mut_view(mir_a), 64);
        let changed = inline_optimize_callgraph(
            unsafe { mut_view(*cg) },
            OPT_PROFILE_SPEED_O2,
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(istats),
            ilog,
            unsafe { address_of_mut(sstats) },
            slog,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if !changed {
            rc = 231;
        } else if (istats.callsites_inlined) < 2u32 {
            rc = 232;
        } else if (istats.post_inline_sroa_cascades) < 2u32 {
            rc = 233;
        } else if istats.recursive_scc_bounded == 0u32 {
            rc = 234;
        } else if istats.dead_fns_marked == 0u32 {
            rc = 235;
        } else {
            // Verify all inlined MIR bodies pass full MIR + Ownership + Capability + DropFlag verification
            let mut ni: usize = 0;
            while ni < 9 && rc == 0 {
                let np = unsafe { cg_node_at((*cg).nodes, ni) };
                let mbody = unsafe { (*np).mir };
                let fitem = unsafe { (*np).fn_item };
                verify_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, fitem);
                verify_mir_own(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, fitem);
                verify_mir_cap(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) });
                unsafe {
                    mir_drop_elaborate(mut_view(*mbody), mut_view(*thir_fe), view(hir2), db_ptr, view(*str_in_ptr), mut_view(mir_a));
                }
                verify_mir_drop_flags(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, fitem);
                if (unsafe { (*sink_fe).errors }) != 0 {
                    rc = 240 + (ni as i32);
                }
                ni = ni + 1;
            }
        }

        // Verify deterministic `inline_print` (including embedded `sroa_decisions`)
        if rc == 0 {
            let mut ib1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            let mut ib2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            diag_buf_init(mut_view(ib1));
            diag_buf_init(mut_view(ib2));
            let sstats_ptr = unsafe { address_of(sstats) as *const SroaStats };
            inline_print(view(istats), unsafe { view(*ilog) }, sstats_ptr, slog, mut_view(ib1));
            inline_print(view(istats), unsafe { view(*ilog) }, sstats_ptr, slog, mut_view(ib2));
            if (ib1.len) < 64 || !diag_buf_eq(view(ib1), view(ib2)) {
                rc = 250;
            }
            diag_buf_free(mut_view(ib1));
            diag_buf_free(mut_view(ib2));
        }
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

pub fn main() -> i32 {
    let rc1 = probe_sroa_copy_move_and_rvo_nrvo();
    if rc1 != 0 {
        return rc1;
    }
    print("PROBE_SROA_COPY_MOVE_AND_RVO_NRVO=OK\n");

    let rc2 = probe_callgraph_scc_legality_and_inliner();
    if rc2 != 0 {
        return rc2;
    }
    print("PROBE_TRANSACTIONAL_INLINE_AND_POST_SROA_CASCADE=OK\n");

    print("PROBE_ALL=OK\n");
    0
}
