# All C unit tests (axiom0-unit, generated from the AX_TEST markers under tests/unit). The kernel
# tests (kernel_*) are part of it; the stdout check makes sure they were compiled in.
cmd: {build}/axiom0-unit
exit: 0
stdout-contains: PASS kernel_hash_vectors
stdout-contains: PASS kernel_hashmap_order_after_delete_reinsert
stdout-contains: PASS kernel_interner_identity
stdout-contains: UNIT
requires: axiom0-internal
