# Compile live std/sync modules directly with axiomc compiler (T411).
timeout: 60
cmd: "{compiler}" check --std-root "{root}/std" "{root}/std/sync/atomic.ax" "{root}/std/sync/rc.ax" "{root}/std/sync/arc.ax" "{root}/std/sync/mutex.ax" "{root}/std/sync/rwlock.ax" "{root}/std/sync/condvar.ax" "{root}/std/sync/once.ax" "{root}/std/sync/barrier.ax" "{root}/std/sync/mod.ax"
exit: 0
