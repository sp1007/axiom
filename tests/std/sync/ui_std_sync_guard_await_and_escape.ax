// test: ui
// stderr-contains: synchronous lock guard or @no_suspend_hold value is held across an .await suspension point
// covers: REQ-TST-072

module std.sync.atomic

@derive(Copy)
pub enum Ordering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

@derive(Copy)
pub struct CasResult<T> {
    pub ok: bool,
    pub val: T,
}

@lang("atomic")
pub struct Atomic<T> {
    pub v: T,
}

impl<T> Atomic<T> {
    pub fn new(v: T) -> Atomic<T> {
        loop {}
    }

    pub fn into_inner(self: Atomic<T>) -> T {
        loop {}
    }

    pub fn is_lock_free() -> bool {
        true
    }

    pub fn load(self: view<Atomic<T>>, order: Ordering) -> T {
        loop {}
    }

    pub fn store(self: view<Atomic<T>>, val: T, order: Ordering) {}

    pub fn swap(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn compare_exchange(
        self: view<Atomic<T>>,
        expected: T,
        desired: T,
        success: Ordering,
        failure: Ordering
    ) -> CasResult<T> {
        loop {}
    }

    pub fn compare_exchange_weak(
        self: view<Atomic<T>>,
        expected: T,
        desired: T,
        success: Ordering,
        failure: Ordering
    ) -> CasResult<T> {
        loop {}
    }

    pub fn fetch_add(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn fetch_sub(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn fetch_and(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn fetch_or(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn fetch_xor(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }
}

pub fn fence(order: Ordering) {}

pub fn compiler_fence(order: Ordering) {}

pub fn spin_loop_hint() {}

pub fn is_lock_free<T>() -> bool {
    true
}

pub type AtomicBool = Atomic<bool>
pub type AtomicI8 = Atomic<i8>
pub type AtomicI16 = Atomic<i16>
pub type AtomicI32 = Atomic<i32>
pub type AtomicI64 = Atomic<i64>
pub type AtomicIsize = Atomic<isize>
pub type AtomicU8 = Atomic<u8>
pub type AtomicU16 = Atomic<u16>
pub type AtomicU32 = Atomic<u32>
pub type AtomicU64 = Atomic<u64>
pub type AtomicUsize = Atomic<usize>
pub type AtomicPtr<T> = Atomic<*mut T>

module std.sync.mutex

use std.core.option.Option
use std.core.host.futex_wait
use std.core.host.futex_wake
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@repr(C)
pub struct Mutex<T> {
    pub state: Atomic<u32>,
    pub data: T,
}

unsafe impl<T: Send> Send for Mutex<T> {}
unsafe impl<T: Send> Share for Mutex<T> {}
impl<T> !Copy for Mutex<T> {}

@no_suspend_hold
@repr(C)
pub struct MutexGuardImpl<T> {
    pub lock_ptr: *const Atomic<u32>,
    pub data_ptr: *mut T,
}

pub type MutexGuard<T> = MutexGuardImpl<T>

impl<T> !Copy for MutexGuardImpl<T> {}
impl<T> !Send for MutexGuardImpl<T> {}
unsafe impl<T: Share> Share for MutexGuardImpl<T> {}

impl<T> Mutex<T> {
    pub fn new(val: T) -> Mutex<T> {
        Mutex {
            state: Atomic.new(0u32),
            data: val,
        }
    }

    pub fn lock(self: view<Mutex<T>>) -> MutexGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *mut T = unsafe { address_of(self.data) as *mut T };
        let mut c = unsafe { (*p_state).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if !c.ok {
            if c.val != 2u32 {
                c.val = unsafe { (*p_state).swap(2u32, Ordering.Acquire) };
            }
            while c.val != 0u32 {
                unsafe {
                    futex_wait(p_state as *const u32, 2u32, 0xFFFFFFFFFFFFFFFFu64);
                }
                c.val = unsafe { (*p_state).swap(2u32, Ordering.Acquire) };
            }
        }
        MutexGuardImpl {
            lock_ptr: p_state,
            data_ptr: p_data,
        }
    }

    pub fn lock_ptr(p: *const Mutex<T>) -> MutexGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *mut T = unsafe { address_of_mut((*p).data) };
        let mut c = unsafe { (*p_state).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if !c.ok {
            if c.val != 2u32 {
                c.val = unsafe { (*p_state).swap(2u32, Ordering.Acquire) };
            }
            while c.val != 0u32 {
                unsafe {
                    futex_wait(p_state as *const u32, 2u32, 0xFFFFFFFFFFFFFFFFu64);
                }
                c.val = unsafe { (*p_state).swap(2u32, Ordering.Acquire) };
            }
        }
        MutexGuardImpl {
            lock_ptr: p_state,
            data_ptr: p_data,
        }
    }

    pub fn try_lock(self: view<Mutex<T>>) -> Option<MutexGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *mut T = unsafe { address_of(self.data) as *mut T };
        let cas = unsafe { (*p_state).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(MutexGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            })
        } else {
            Option.None
        }
    }

    pub fn try_lock_ptr(p: *const Mutex<T>) -> Option<MutexGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *mut T = unsafe { address_of_mut((*p).data) };
        let cas = unsafe { (*p_state).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(MutexGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            })
        } else {
            Option.None
        }
    }

    pub fn into_inner(self: Mutex<T>) -> T {
        self.data
    }
}

pub fn mutex_new<T>(val: T) -> Mutex<T> {
    Mutex.new(val)
}

impl<T> MutexGuardImpl<T> {
    pub fn as_ptr(self: view<MutexGuardImpl<T>>) -> *const T {
        self.data_ptr as *const T
    }

    pub fn get_ptr(self: view<MutexGuardImpl<T>>) -> *const T {
        self.data_ptr as *const T
    }

    pub fn as_mut_ptr(self: mut_view<MutexGuardImpl<T>>) -> *mut T {
        self.data_ptr
    }

    pub fn get_mut_ptr(self: mut_view<MutexGuardImpl<T>>) -> *mut T {
        self.data_ptr
    }

    pub fn val(self: view<MutexGuardImpl<T>>) -> T where T: Copy {
        unsafe { *self.data_ptr }
    }

    pub fn set(self: mut_view<MutexGuardImpl<T>>, v: T) {
        unsafe { *self.data_ptr = v; }
    }
}

impl<T> Drop for MutexGuardImpl<T> {
    fn drop(self: mut_view<MutexGuardImpl<T>>) {
        if self.lock_ptr as usize != 0 {
            let p_lock = self.lock_ptr;
            self.lock_ptr = 0 as *const Atomic<u32>;
            self.data_ptr = 0 as *mut T;
            let prev = unsafe { (*p_lock).swap(0u32, Ordering.Release) };
            if prev == 2u32 {
                unsafe {
                    futex_wake(p_lock as *const u32, 1u32);
                }
            }
        }
    }
}

module std.sync.rwlock

use std.core.option.Option
use std.core.host.futex_wait
use std.core.host.futex_wake
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

const WRITER_LOCKED: u32 = 0x80000000u32;
const WRITER_WAITING: u32 = 0x40000000u32;
const READER_MASK: u32 = 0x3FFFFFFFu32;

@repr(C)
pub struct RwLock<T> {
    pub state: Atomic<u32>,
    pub data: T,
}

unsafe impl<T: Send> Send for RwLock<T> {}
unsafe impl<T: Send + Share> Share for RwLock<T> {}
impl<T> !Copy for RwLock<T> {}

@no_suspend_hold
@repr(C)
pub struct RwLockReadGuardImpl<T> {
    pub lock_ptr: *const Atomic<u32>,
    pub data_ptr: *const T,
}

pub type RwLockReadGuard<T> = RwLockReadGuardImpl<T>

impl<T> !Copy for RwLockReadGuardImpl<T> {}
impl<T> !Send for RwLockReadGuardImpl<T> {}
unsafe impl<T: Share> Share for RwLockReadGuardImpl<T> {}

@no_suspend_hold
@repr(C)
pub struct RwLockWriteGuardImpl<T> {
    pub lock_ptr: *const Atomic<u32>,
    pub data_ptr: *mut T,
}

pub type RwLockWriteGuard<T> = RwLockWriteGuardImpl<T>

impl<T> !Copy for RwLockWriteGuardImpl<T> {}
impl<T> !Send for RwLockWriteGuardImpl<T> {}
unsafe impl<T: Share> Share for RwLockWriteGuardImpl<T> {}

impl<T> RwLock<T> {
    pub fn new(val: T) -> RwLock<T> {
        RwLock {
            state: Atomic.new(0u32),
            data: val,
        }
    }

    pub fn read(self: view<RwLock<T>>) -> RwLockReadGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *const T = unsafe { address_of(self.data) };
        loop {
            let s = unsafe { (*p_state).load(Ordering.Relaxed) };
            if (s & (WRITER_LOCKED | WRITER_WAITING)) == 0u32 {
                let cas = unsafe { (*p_state).compare_exchange_weak(s, s + 1u32, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    return RwLockReadGuardImpl {
                        lock_ptr: p_state,
                        data_ptr: p_data,
                    };
                }
            } else {
                unsafe {
                    futex_wait(p_state as *const u32, s, 0xFFFFFFFFFFFFFFFFu64);
                }
            }
        }
    }

    pub fn read_ptr(p: *const RwLock<T>) -> RwLockReadGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *const T = unsafe { address_of((*p).data) };
        loop {
            let s = unsafe { (*p_state).load(Ordering.Relaxed) };
            if (s & (WRITER_LOCKED | WRITER_WAITING)) == 0u32 {
                let cas = unsafe { (*p_state).compare_exchange_weak(s, s + 1u32, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    return RwLockReadGuardImpl {
                        lock_ptr: p_state,
                        data_ptr: p_data,
                    };
                }
            } else {
                unsafe {
                    futex_wait(p_state as *const u32, s, 0xFFFFFFFFFFFFFFFFu64);
                }
            }
        }
    }

    pub fn try_read(self: view<RwLock<T>>) -> Option<RwLockReadGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *const T = unsafe { address_of(self.data) };
        let s = unsafe { (*p_state).load(Ordering.Relaxed) };
        if (s & (WRITER_LOCKED | WRITER_WAITING)) == 0u32 {
            let cas = unsafe { (*p_state).compare_exchange(s, s + 1u32, Ordering.Acquire, Ordering.Relaxed) };
            if cas.ok {
                return Option.Some(RwLockReadGuardImpl {
                    lock_ptr: p_state,
                    data_ptr: p_data,
                });
            }
        }
        Option.None
    }

    pub fn try_read_ptr(p: *const RwLock<T>) -> Option<RwLockReadGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *const T = unsafe { address_of((*p).data) };
        let s = unsafe { (*p_state).load(Ordering.Relaxed) };
        if (s & (WRITER_LOCKED | WRITER_WAITING)) == 0u32 {
            let cas = unsafe { (*p_state).compare_exchange(s, s + 1u32, Ordering.Acquire, Ordering.Relaxed) };
            if cas.ok {
                return Option.Some(RwLockReadGuardImpl {
                    lock_ptr: p_state,
                    data_ptr: p_data,
                });
            }
        }
        Option.None
    }

    pub fn write(self: view<RwLock<T>>) -> RwLockWriteGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *mut T = unsafe { address_of(self.data) as *mut T };
        if unsafe { (*p_state).compare_exchange(0u32, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) }.ok {
            return RwLockWriteGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            };
        }
        loop {
            let s = unsafe { (*p_state).load(Ordering.Relaxed) };
            if s == 0u32 || s == WRITER_WAITING {
                let cas = unsafe { (*p_state).compare_exchange_weak(s, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    return RwLockWriteGuardImpl {
                        lock_ptr: p_state,
                        data_ptr: p_data,
                    };
                }
            } else {
                if (s & WRITER_WAITING) == 0u32 {
                    let _ = unsafe { (*p_state).compare_exchange_weak(s, s | WRITER_WAITING, Ordering.Relaxed, Ordering.Relaxed) };
                } else {
                    unsafe {
                        futex_wait(p_state as *const u32, s, 0xFFFFFFFFFFFFFFFFu64);
                    }
                }
            }
        }
    }

    pub fn write_ptr(p: *const RwLock<T>) -> RwLockWriteGuard<T> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *mut T = unsafe { address_of_mut((*p).data) };
        if unsafe { (*p_state).compare_exchange(0u32, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) }.ok {
            return RwLockWriteGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            };
        }
        loop {
            let s = unsafe { (*p_state).load(Ordering.Relaxed) };
            if s == 0u32 || s == WRITER_WAITING {
                let cas = unsafe { (*p_state).compare_exchange_weak(s, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) };
                if cas.ok {
                    return RwLockWriteGuardImpl {
                        lock_ptr: p_state,
                        data_ptr: p_data,
                    };
                }
            } else {
                if (s & WRITER_WAITING) == 0u32 {
                    let _ = unsafe { (*p_state).compare_exchange_weak(s, s | WRITER_WAITING, Ordering.Relaxed, Ordering.Relaxed) };
                } else {
                    unsafe {
                        futex_wait(p_state as *const u32, s, 0xFFFFFFFFFFFFFFFFu64);
                    }
                }
            }
        }
    }

    pub fn try_write(self: view<RwLock<T>>) -> Option<RwLockWriteGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of(self.state) };
        let p_data: *mut T = unsafe { address_of(self.data) as *mut T };
        let cas = unsafe { (*p_state).compare_exchange(0u32, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(RwLockWriteGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            })
        } else {
            Option.None
        }
    }

    pub fn try_write_ptr(p: *const RwLock<T>) -> Option<RwLockWriteGuard<T>> {
        let p_state: *const Atomic<u32> = unsafe { address_of((*p).state) };
        let p_data: *mut T = unsafe { address_of_mut((*p).data) };
        let cas = unsafe { (*p_state).compare_exchange(0u32, WRITER_LOCKED, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(RwLockWriteGuardImpl {
                lock_ptr: p_state,
                data_ptr: p_data,
            })
        } else {
            Option.None
        }
    }

    pub fn into_inner(self: RwLock<T>) -> T {
        self.data
    }
}

pub fn rwlock_new<T>(val: T) -> RwLock<T> {
    RwLock.new(val)
}

impl<T> RwLockReadGuardImpl<T> {
    pub fn as_ptr(self: view<RwLockReadGuardImpl<T>>) -> *const T {
        self.data_ptr
    }

    pub fn get_ptr(self: view<RwLockReadGuardImpl<T>>) -> *const T {
        self.data_ptr
    }

    pub fn val(self: view<RwLockReadGuardImpl<T>>) -> T where T: Copy {
        unsafe { *self.data_ptr }
    }
}

impl<T> Drop for RwLockReadGuardImpl<T> {
    fn drop(self: mut_view<RwLockReadGuardImpl<T>>) {
        if self.lock_ptr as usize != 0 {
            let p_lock = self.lock_ptr;
            self.lock_ptr = 0 as *const Atomic<u32>;
            self.data_ptr = 0 as *const T;
            let mask_inv = 0xFFFFFFFFu32 ^ READER_MASK;
            loop {
                let s = unsafe { (*p_lock).load(Ordering.Relaxed) };
                let readers = s & READER_MASK;
                if readers == 0u32 {
                    break;
                }
                let new_s = (s & mask_inv) | (readers - 1u32);
                let cas = unsafe { (*p_lock).compare_exchange_weak(s, new_s, Ordering.Release, Ordering.Relaxed) };
                if cas.ok {
                    if readers == 1u32 && (s & WRITER_WAITING) != 0u32 {
                        unsafe {
                            futex_wake(p_lock as *const u32, 1u32);
                        }
                    }
                    break;
                }
            }
        }
    }
}

impl<T> RwLockWriteGuardImpl<T> {
    pub fn as_ptr(self: view<RwLockWriteGuardImpl<T>>) -> *const T {
        self.data_ptr as *const T
    }

    pub fn get_ptr(self: view<RwLockWriteGuardImpl<T>>) -> *const T {
        self.data_ptr as *const T
    }

    pub fn as_mut_ptr(self: mut_view<RwLockWriteGuardImpl<T>>) -> *mut T {
        self.data_ptr
    }

    pub fn get_mut_ptr(self: mut_view<RwLockWriteGuardImpl<T>>) -> *mut T {
        self.data_ptr
    }

    pub fn val(self: view<RwLockWriteGuardImpl<T>>) -> T where T: Copy {
        unsafe { *self.data_ptr }
    }

    pub fn set(self: mut_view<RwLockWriteGuardImpl<T>>, v: T) {
        unsafe { *self.data_ptr = v; }
    }
}

impl<T> Drop for RwLockWriteGuardImpl<T> {
    fn drop(self: mut_view<RwLockWriteGuardImpl<T>>) {
        if self.lock_ptr as usize != 0 {
            let p_lock = self.lock_ptr;
            self.lock_ptr = 0 as *const Atomic<u32>;
            self.data_ptr = 0 as *mut T;
            let _ = unsafe { (*p_lock).swap(0u32, Ordering.Release) };
            unsafe {
                futex_wake(p_lock as *const u32, 0x7FFFFFFFu32);
            }
        }
    }
}

module main

use std.core.option.Option
use std.sync.mutex.Mutex
use std.sync.mutex.MutexGuard
use std.sync.rwlock.RwLock

async fn tick() -> i64 {
    1i64
}

async fn allow_mutex_guard_dropped_before_await() -> i64 {
    let m = Mutex.new(50i64);
    let mut snap = 0i64;
    {
        let g = view(m).lock();
        snap = g.val();
    }
    let t = tick().await;
    snap + t
}

async fn reject_all_std_sync_guards_across_await() -> i64 {
    let m = Mutex.new(10i64);
    let rw = RwLock.new(30i64);
    let mut sum = 0i64;
    {
        let g = view(m).lock();
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + g.val() + t;
    }
    {
        let maybe_g = view(m).try_lock();
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + match maybe_g {
            Option.Some(g) => g.val() + t,
            Option.None => t,
        };
    }
    {
        let rg = view(rw).read();
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + rg.val() + t;
    }
    {
        let mut wg = view(rw).write();
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        wg.set(41i64);
        sum = sum + wg.val() + t;
    }
    sum
}

pub fn main() {}
