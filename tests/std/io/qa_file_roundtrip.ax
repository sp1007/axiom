// test: run
// stdout: OK file roundtrip\n

use std.core.host.open
use std.core.host.read
use std.core.host.write
use std.core.host.close
use std.core.host.file_size
use std.core.host.remove
use std.core.host.stdio
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn GetStdHandle(nStdHandle: u32) -> *mut u8;
    fn GetConsoleMode(hConsoleHandle: *mut u8, lpMode: *mut u32) -> i32;
    fn WriteConsoleW(hConsoleOutput: *mut u8, lpBuffer: *const u16, nNumberOfCharsToWrite: u32, lpNumberOfCharsWritten: *mut u32, lpReserved: *mut u8) -> i32;
    fn WriteFile(hFile: *mut u8, lpBuffer: *const u8, nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: *mut u32, lpOverlapped: *mut u8) -> i32;
    fn ReadFile(hFile: *mut u8, lpBuffer: *mut u8, nNumberOfBytesToRead: u32, lpNumberOfBytesRead: *mut u32, lpOverlapped: *mut u8) -> i32;
    fn CreateFileW(lpFileName: *const u16, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: *mut u8, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: *mut u8) -> *mut u8;
    fn CloseHandle(hObject: *mut u8) -> i32;
    fn GetFileSizeEx(hFile: *mut u8, lpFileSize: *mut i64) -> i32;
    fn SetFilePointer(hFile: *mut u8, lDistanceToMove: i32, lpDistanceToMoveHigh: *mut i32, dwMoveMethod: u32) -> u32;
    fn GetEnvironmentVariableW(lpName: *const u16, lpBuffer: *mut u16, nSize: u32) -> u32;
    fn SetEnvironmentVariableW(lpName: *const u16, lpValue: *const u16) -> i32;
    fn DeleteFileA(lpFileName: *const u8) -> i32;
    fn GetLastError() -> u32;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

unsafe fn get_file_table() -> *mut u8 {
    let mut vname: [6]u16 = [65u16, 88u16, 95u16, 70u16, 84u16, 0u16];
    let pvname = address_of_mut(vname[0]);
    let mut val: [32]u16 = [0u16; 32];
    let pval = address_of_mut(val[0]);
    let vlen = GetEnvironmentVariableW(pvname, pval, 32);
    if vlen > 0 {
        let mut ptr_val: usize = 0;
        let mut idx: usize = 0;
        while idx < vlen as usize {
            let ch = val[idx];
            let mut digit: usize = 0;
            if ch >= 48u16 && ch <= 57u16 {
                digit = (ch - 48u16) as usize;
            } else if ch >= 97u16 && ch <= 102u16 {
                digit = (ch - 97u16 + 10u16) as usize;
            } else if ch >= 65u16 && ch <= 70u16 {
                digit = (ch - 65u16 + 10u16) as usize;
            }
            ptr_val = (ptr_val << 4) | digit;
            idx = idx + 1;
        }
        return ptr_val as *mut u8;
    }

    let tbl = HeapAlloc(GetProcessHeap(), 8u32, 4096);
    if tbl as usize == 0 {
        return 0 as *mut u8;
    }

    let mut sval: [17]u16 = [0u16; 17];
    let mut cur: usize = tbl as usize;
    let mut pos: usize = 16;
    sval[pos] = 0u16;
    while pos > 0 {
        pos = pos - 1;
        let nibble = (cur & 0x0F) as u16;
        if nibble < 10u16 {
            sval[pos] = 48u16 + nibble;
        } else {
            sval[pos] = 97u16 + (nibble - 10u16);
        }
        cur = cur >> 4;
    }
    SetEnvironmentVariableW(pvname, address_of_mut(sval[0]));
    tbl
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

pub fn __ax_host_stdio(which: u32) -> i64 {
    if which <= 2u32 { which as i64 } else { -4i64 }
}

pub unsafe fn __ax_host_open(path: *const u8, path_len: usize, mode: u32) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let mut in_pos: usize = 0;
    let mut out_pos: usize = 0;
    while in_pos < path_len && out_pos + 2 < 1024 {
        let b0 = *(path + in_pos) as u32;
        let mut cp: u32 = 0;
        let mut step: usize = 1;
        if b0 < 0x80 {
            cp = b0;
            step = 1;
        } else if (b0 & 0xE0) == 0xC0 && in_pos + 1 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
            step = 2;
        } else if (b0 & 0xF0) == 0xE0 && in_pos + 2 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            let b2 = *(path + in_pos + 2) as u32;
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            step = 3;
        } else {
            cp = 0xFFFD;
            step = 1;
        }
        in_pos = in_pos + step;
        if cp <= 0xFFFF {
            wpath_buf[out_pos] = cp as u16;
            out_pos = out_pos + 1;
        } else {
            wpath_buf[out_pos] = (0xD800 + ((cp - 0x10000) >> 10)) as u16;
            wpath_buf[out_pos + 1] = (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16;
            out_pos = out_pos + 2;
        }
    }
    wpath_buf[out_pos] = 0u16;

    let mut desired_access: u32 = 0;
    let mut creation_disposition: u32 = 0;
    if mode == 0u32 {
        desired_access = 0x80000000u32;
        creation_disposition = 3u32;
    } else if mode == 1u32 {
        desired_access = 0x40000000u32 | 0x80000000u32;
        creation_disposition = 2u32;
    } else if mode == 2u32 {
        desired_access = 4u32 | 0x80000000u32;
        creation_disposition = 4u32;
    } else {
        return -4;
    }

    let share_mode = 1u32 | 2u32 | 4u32;
    let flags_attr = 0x80u32;
    let pwpath = address_of_mut(wpath_buf[0]);
    let h = CreateFileW(pwpath, desired_access, share_mode, 0 as *mut u8, creation_disposition, flags_attr, 0 as *mut u8);

    if h as usize == 0xFFFFFFFFFFFFFFFF {
        let err = GetLastError();
        if err == 2u32 || err == 3u32 { return -1; }
        if err == 5u32 { return -2; }
        if err == 80u32 || err == 183u32 { return -3; }
        return -9;
    }

    let tbl = get_file_table();
    if tbl as usize == 0 {
        CloseHandle(h);
        return -9;
    }

    let mut slot: usize = 3;
    let mut found_slot: usize = 0;
    while slot < 256 {
        let is_open_ptr = (tbl as usize + slot * 16 + 8) as *mut u32;
        if *is_open_ptr == 0u32 {
            found_slot = slot;
            break;
        }
        slot = slot + 1;
    }

    if found_slot == 0 {
        CloseHandle(h);
        return -9;
    }

    let h_ptr = (tbl as usize + found_slot * 16) as *mut *mut u8;
    let is_open_ptr = (tbl as usize + found_slot * 16 + 8) as *mut u32;
    *h_ptr = h;
    *is_open_ptr = 1u32;

    if mode == 2u32 {
        SetFilePointer(h, 0, 0 as *mut i32, 2u32);
    }

    found_slot as i64
}

pub unsafe fn __ax_host_read(h: i64, buf: *mut u8, cap: usize) -> i64 {
    if cap == 0 { return 0; }
    let mut win_h: *mut u8 = 0 as *mut u8;
    if h == 0 {
        win_h = GetStdHandle(0xFFFFFFF6u32);
    } else if h >= 3 && h < 256 {
        let tbl = get_file_table();
        if tbl as usize == 0 { return -4; }
        let is_open = *((tbl as usize + (h as usize) * 16 + 8) as *mut u32);
        if is_open == 0u32 { return -4; }
        win_h = *((tbl as usize + (h as usize) * 16) as *mut *mut u8);
    } else {
        return -4;
    }

    let mut read_bytes: [1]u32 = [0u32];
    let ok = ReadFile(win_h, buf, cap as u32, address_of_mut(read_bytes[0]), 0 as *mut u8);
    if ok == 0 {
        let err = GetLastError();
        if err == 38u32 || err == 109u32 { return 0; }
        return -9;
    }
    read_bytes[0] as i64
}

pub unsafe fn __ax_host_write(h: i64, p: *const u8, count: usize) -> i64 {
    if count == 0 { return 0; }
    let mut win_h: *mut u8 = 0 as *mut u8;
    if h == 1 {
        win_h = GetStdHandle(0xFFFFFFF5u32);
    } else if h == 2 {
        win_h = GetStdHandle(0xFFFFFFF4u32);
    } else if h == 0 {
        win_h = GetStdHandle(0xFFFFFFF6u32);
    } else if h >= 3 && h < 256 {
        let tbl = get_file_table();
        if tbl as usize == 0 { return -4; }
        let is_open = *((tbl as usize + (h as usize) * 16 + 8) as *mut u32);
        if is_open == 0u32 { return -4; }
        win_h = *((tbl as usize + (h as usize) * 16) as *mut *mut u8);
    } else {
        return -4;
    }

    let mut written: [1]u32 = [0u32];
    let ok = WriteFile(win_h, p, count as u32, address_of_mut(written[0]), 0 as *mut u8);
    if ok == 0 { return -9; }
    written[0] as i64
}

pub fn __ax_host_close(h: i64) -> i64 {
    if h >= 0 && h <= 2 { return 0; }
    if h >= 3 && h < 256 {
        let tbl = unsafe { get_file_table() };
        if tbl as usize == 0 { return -4; }
        let is_open_ptr = (tbl as usize + (h as usize) * 16 + 8) as *mut u32;
        let is_open = unsafe { *is_open_ptr };
        if is_open == 0u32 { return -4; }
        let h_ptr = (tbl as usize + (h as usize) * 16) as *mut *mut u8;
        let win_h = unsafe { *h_ptr };
        unsafe {
            CloseHandle(win_h);
            *is_open_ptr = 0u32;
            *h_ptr = 0 as *mut u8;
        }
        return 0;
    }
    -4
}

pub fn __ax_host_file_size(h: i64) -> i64 {
    if h < 3 || h >= 256 { return -4; }
    let tbl = unsafe { get_file_table() };
    if tbl as usize == 0 { return -4; }
    let is_open = unsafe { *((tbl as usize + (h as usize) * 16 + 8) as *mut u32) };
    if is_open == 0u32 { return -4; }
    let win_h = unsafe { *((tbl as usize + (h as usize) * 16) as *mut *mut u8) };

    let mut sz: [1]i64 = [0i64];
    let ok = unsafe { GetFileSizeEx(win_h, address_of_mut(sz[0])) };
    if ok == 0 { return -9; }
    sz[0]
}

pub unsafe fn __ax_host_remove(path: *const u8, path_len: usize) -> i64 {
    DeleteFileA(path);
    0
}

struct DropGlue {}

struct FileHandle {
    handle: i64,
    is_open: bool,
    _glue: DropGlue,
}

impl Drop for FileHandle {
    fn drop(self: mut_view<FileHandle>) {
        let h = self.handle;
        if self.is_open && h >= 0 {
            close(h);
            self.is_open = false;
            self.handle = -1;
        }
    }
}

fn open_file(path_bytes: view<[u8]>, mode: u32) -> FileHandle {
    let n = len(path_bytes);
    let p = unsafe { heap_alloc(n + 1, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe { *(p + i) = path_bytes[i]; }
        i = i + 1;
    }
    unsafe { *(p + n) = 0u8; }
    let h = unsafe { open(p as *const u8, n, mode) };
    unsafe { heap_free(p, n + 1, 1); }
    if h >= 0 {
        FileHandle { handle: h, is_open: true, _glue: DropGlue {} }
    } else {
        FileHandle { handle: h, is_open: false, _glue: DropGlue {} }
    }
}

fn write_bytes_to_file(f: mut_view<FileHandle>, bytes: view<[u8]>) -> bool {
    let n = len(bytes);
    if n == 0 { return true; }
    let p = unsafe { heap_alloc(n, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe { *(p + i) = bytes[i]; }
        i = i + 1;
    }
    let h = f.handle;
    let written = unsafe { write(h, p as *const u8, n) };
    unsafe { heap_free(p, n, 1); }
    written == n as i64
}

fn read_bytes_from_file(f: mut_view<FileHandle>, count: usize) -> *mut u8 {
    let buf = unsafe { heap_alloc(count, 1) };
    let h = f.handle;
    let rd = unsafe { read(h, buf, count) };
    if rd != count as i64 {
        unsafe { heap_free(buf, count, 1); }
        0 as *mut u8
    } else {
        buf
    }
}

fn remove_file(path_bytes: view<[u8]>) {
    let n = len(path_bytes);
    let p = unsafe { heap_alloc(n + 1, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe { *(p + i) = path_bytes[i]; }
        i = i + 1;
    }
    unsafe {
        *(p + n) = 0u8;
        remove(p as *const u8, n);
        heap_free(p, n + 1, 1);
    }
}

fn main() -> i32 {
    // 1. Text round-trip test: "test_text_roundtrip.txt"
    let txt_path: [23]u8 = [
        116u8, 101u8, 115u8, 116u8, 95u8, 116u8, 101u8, 120u8, 116u8, 95u8,
        114u8, 111u8, 117u8, 110u8, 100u8, 116u8, 114u8, 105u8, 112u8, 46u8,
        116u8, 120u8, 116u8
    ];
    // "Xin chào thế giới!\n" (24 bytes)
    let txt_content: [24]u8 = [
        0x58u8, 0x69u8, 0x6eu8, 0x20u8, 0x63u8, 0x68u8, 0xc3u8, 0xa0u8, 0x6fu8, 0x20u8,
        0x74u8, 0x68u8, 0xe1u8, 0xbau8, 0xbfu8, 0x20u8, 0x67u8, 0x69u8, 0xe1u8, 0xbbu8,
        0x9bu8, 0x69u8, 0x21u8, 0x0au8
    ];

    // Write text file
    let mut fw = open_file(view(txt_path), 1u32);
    let h1 = fw.handle;
    if h1 < 0 { return 1; }
    if !write_bytes_to_file(mut_view(fw), view(txt_content)) { return 2; }
    close(fw.handle);
    fw.is_open = false;

    // Read text file back
    let mut fr = open_file(view(txt_path), 0u32);
    let h2 = fr.handle;
    if h2 < 0 { return 3; }
    let sz = file_size(fr.handle);
    if sz != 24i64 { return 4; }
    let rd_buf = read_bytes_from_file(mut_view(fr), 24);
    if rd_buf as usize == 0 { return 5; }
    let mut idx: usize = 0;
    while idx < 24 {
        let b = unsafe { *(rd_buf + idx) };
        if b != txt_content[idx] { return 6; }
        idx = idx + 1;
    }
    unsafe { heap_free(rd_buf, 24, 1); }
    close(fr.handle);
    fr.is_open = false;

    // 2. Binary round-trip test: "test_bin_roundtrip.bin"
    let bin_path: [22]u8 = [
        116u8, 101u8, 115u8, 116u8, 95u8, 98u8, 105u8, 110u8, 95u8, 114u8,
        111u8, 117u8, 110u8, 100u8, 116u8, 114u8, 105u8, 112u8, 46u8, 98u8,
        105u8, 110u8
    ];
    let bin_content: [16]u8 = [
        0x00u8, 0xFFu8, 0x55u8, 0xAAu8, 0x01u8, 0x02u8, 0x80u8, 0x7Fu8,
        0x10u8, 0x20u8, 0x30u8, 0x40u8, 0xDEu8, 0xADu8, 0xBEu8, 0xEFu8
    ];

    let mut bfw = open_file(view(bin_path), 1u32);
    let h3 = bfw.handle;
    if h3 < 0 { return 7; }
    if !write_bytes_to_file(mut_view(bfw), view(bin_content)) { return 8; }
    close(bfw.handle);
    bfw.is_open = false;

    let mut bfr = open_file(view(bin_path), 0u32);
    let h4 = bfr.handle;
    if h4 < 0 { return 9; }
    let bsz = file_size(bfr.handle);
    if bsz != 16i64 { return 10; }
    let brd_buf = read_bytes_from_file(mut_view(bfr), 16);
    if brd_buf as usize == 0 { return 11; }
    idx = 0;
    while idx < 16 {
        let b = unsafe { *(brd_buf + idx) };
        if b != bin_content[idx] { return 12; }
        idx = idx + 1;
    }
    unsafe { heap_free(brd_buf, 16, 1); }
    close(bfr.handle);
    bfr.is_open = false;

    // Clean up temporary files
    remove_file(view(txt_path));
    remove_file(view(bin_path));

    // Print OK
    let ok_msg: [19]u8 = [
        79u8, 75u8, 32u8, 102u8, 105u8, 108u8, 101u8, 32u8, 114u8, 111u8,
        117u8, 110u8, 100u8, 116u8, 114u8, 105u8, 112u8, 10u8, 0u8
    ];
    let ok_p = unsafe { heap_alloc(18, 1) };
    idx = 0;
    while idx < 18 {
        unsafe { *(ok_p + idx) = ok_msg[idx]; }
        idx = idx + 1;
    }
    unsafe {
        write(stdio(1), ok_p as *const u8, 18);
        heap_free(ok_p, 18, 1);
    }

    0
}
