// test: run
// stdout: OK Utf16WideBuffer\n

use std.core.result.Result
use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub const REPLACEMENT_CHARACTER: char = '\u{FFFD}';
pub const REPLACEMENT_CODE_UNIT: u16 = 0xFFFDu16;

pub enum Utf16Error {
    InvalidUtf8(usize),
    LoneSurrogate(usize),
    Truncated(usize),
}

pub struct DecodeUtf8Result {
    pub ch: char,
    pub len: usize,
}

pub fn is_high_surrogate(u: u16) -> bool {
    u >= 0xD800u16 && u <= 0xDBFFu16
}

pub fn is_low_surrogate(u: u16) -> bool {
    u >= 0xDC00u16 && u <= 0xDFFFu16
}

pub fn surrogate_high(cp: u32) -> u16 {
    (0xD800 + ((cp - 0x10000) >> 10)) as u16
}

pub fn surrogate_low(cp: u32) -> u16 {
    (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16
}

pub fn decode_surrogate_pair(high: u16, low: u16) -> char {
    let cp: u32 = 0x10000 + ((((high as u32) - 0xD800) << 10) | (((low as u32) - 0xDC00) & 0x3FF));
    cp as char
}

pub fn char_len_utf8(c: char) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        1
    } else if u <= 0x7FF {
        2
    } else if u <= 0xFFFF {
        3
    } else {
        4
    }
}

pub unsafe fn char_encode_utf8(c: char, dst: *mut u8) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        *dst = u as u8;
        1
    } else if u <= 0x7FF {
        *dst = (0xC0 | (u >> 6)) as u8;
        *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        2
    } else if u <= 0xFFFF {
        *dst = (0xE0 | (u >> 12)) as u8;
        *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        3
    } else {
        *dst = (0xF0 | (u >> 18)) as u8;
        *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        4
    }
}

pub fn decode_utf8_char(bytes: view<[u8]>, offset: usize) -> Result<DecodeUtf8Result, Utf16Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf16Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeUtf8Result { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf16Error.InvalidUtf8(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf16Error.InvalidUtf8(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 4 });
    }
    Result.Err(Utf16Error.InvalidUtf8(offset))
}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = char_len_utf8(c);
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        char_encode_utf8(c, dst);
    }
    s.len = s.len + clen;
}

pub struct WideString {
    pub ptr: *mut u16,
    pub len: usize,
    pub cap: usize,
}

pub fn wide_string_new() -> WideString {
    WideString {
        ptr: 0 as *mut u16,
        len: 0,
        cap: 0,
    }
}

pub fn wide_string_with_capacity(capacity: usize) -> WideString {
    let alloc_cap = capacity + 1;
    let raw = unsafe { heap_alloc(alloc_cap * 2, 2) };
    let p = raw as *mut u16;
    if p as usize != 0 {
        unsafe {
            *p = 0u16;
        }
    }
    WideString {
        ptr: p,
        len: 0,
        cap: alloc_cap,
    }
}

pub fn wide_string_reserve(s: mut_view<WideString>, additional: usize) {
    let needed = s.len + additional + 1;
    if needed <= s.cap {
        return;
    }
    let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
    if new_cap < needed {
        new_cap = needed;
    }
    let raw = unsafe { heap_alloc(new_cap * 2, 2) };
    let new_ptr = raw as *mut u16;
    if s.len > 0 && s.ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, new_ptr, s.len);
        }
    }
    if s.ptr as usize != 0 {
        unsafe {
            heap_free(s.ptr as *mut u8, s.cap * 2, 2);
        }
    }
    s.ptr = new_ptr;
    s.cap = new_cap;
}

pub fn wide_string_push(s: mut_view<WideString>, unit: u16) {
    let needed = s.len + 2;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap * 2, 2) };
        let new_ptr = raw as *mut u16;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, new_ptr, s.len);
            }
        }
        if s.ptr as usize != 0 {
            unsafe {
                heap_free(s.ptr as *mut u8, s.cap * 2, 2);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        let p = s.ptr + s.len;
        *p = unit;
        *(p + 1) = 0u16;
    }
    s.len = s.len + 1;
}

pub fn wide_string_push_char(s: mut_view<WideString>, c: char) {
    let u = c as u32;
    let units_needed: usize = if u <= 0xFFFF { 1 } else { 2 };
    let needed = s.len + units_needed + 1;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap * 2, 2) };
        let new_ptr = raw as *mut u16;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, new_ptr, s.len);
            }
        }
        if s.ptr as usize != 0 {
            unsafe {
                heap_free(s.ptr as *mut u8, s.cap * 2, 2);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        let p = s.ptr + s.len;
        if units_needed == 1 {
            *p = u as u16;
            *(p + 1) = 0u16;
        } else {
            *p = surrogate_high(u);
            *(p + 1) = surrogate_low(u);
            *(p + 2) = 0u16;
        }
    }
    s.len = s.len + units_needed;
}

pub fn wide_string_get(s: view<WideString>, index: usize) -> Option<u16> {
    if index >= s.len {
        Option.None
    } else {
        let val = unsafe { *(s.ptr + index) };
        Option.Some(val)
    }
}

pub fn utf8_to_utf16(bytes: view<[u8]>) -> Result<WideString, Utf16Error> {
    let n = len(bytes);
    let mut ws = wide_string_with_capacity(n);
    let mut offset: usize = 0;
    while offset < n {
        match decode_utf8_char(bytes, offset) {
            Result.Ok(res) => {
                let dec: DecodeUtf8Result = res;
                wide_string_push_char(mut_view(ws), dec.ch);
                offset = offset + dec.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(ws)
}

pub fn to_wide_null(bytes: view<[u8]>) -> Result<WideString, Utf16Error> {
    utf8_to_utf16(bytes)
}

pub unsafe fn utf16_null_len(ptr: *const u16) -> usize {
    if ptr as usize == 0 { return 0; }
    let mut count: usize = 0;
    while *(ptr + count) != 0u16 {
        count = count + 1;
    }
    count
}

pub unsafe fn utf16_ptr_to_utf8(ptr: *const u16, total_len: usize) -> Result<String, Utf16Error> {
    let mut s = string_with_capacity(total_len * 3);
    let mut offset: usize = 0;
    while offset < total_len {
        let u0 = *(ptr + offset);
        if u0 < 0xD800u16 || u0 > 0xDFFFu16 {
            string_push_char(mut_view(s), u0 as u32 as char);
            offset = offset + 1;
        } else if is_high_surrogate(u0) {
            if offset + 1 >= total_len {
                return Result.Err(Utf16Error.LoneSurrogate(offset));
            }
            let u1 = *(ptr + offset + 1);
            if is_low_surrogate(u1) {
                let ch = decode_surrogate_pair(u0, u1);
                string_push_char(mut_view(s), ch);
                offset = offset + 2;
            } else {
                return Result.Err(Utf16Error.LoneSurrogate(offset));
            }
        } else {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
    }
    Result.Ok(s)
}

pub unsafe fn utf16_ptr_to_utf8_lossy(ptr: *const u16, total_len: usize) -> String {
    let mut s = string_with_capacity(total_len * 3);
    let mut offset: usize = 0;
    while offset < total_len {
        let u0 = *(ptr + offset);
        if u0 < 0xD800u16 || u0 > 0xDFFFu16 {
            string_push_char(mut_view(s), u0 as u32 as char);
            offset = offset + 1;
        } else if is_high_surrogate(u0) {
            if offset + 1 < total_len {
                let u1 = *(ptr + offset + 1);
                if is_low_surrogate(u1) {
                    let ch = decode_surrogate_pair(u0, u1);
                    string_push_char(mut_view(s), ch);
                    offset = offset + 2;
                } else {
                    string_push_char(mut_view(s), REPLACEMENT_CHARACTER);
                    offset = offset + 1;
                }
            } else {
                string_push_char(mut_view(s), REPLACEMENT_CHARACTER);
                offset = offset + 1;
            }
        } else {
            string_push_char(mut_view(s), REPLACEMENT_CHARACTER);
            offset = offset + 1;
        }
    }
    s
}

pub unsafe fn utf16_null_to_utf8(ptr: *const u16) -> Result<String, Utf16Error> {
    let n_units = utf16_null_len(ptr);
    utf16_ptr_to_utf8(ptr, n_units)
}

pub unsafe fn utf16_null_to_utf8_lossy(ptr: *const u16) -> String {
    let n_units = utf16_null_len(ptr);
    utf16_ptr_to_utf8_lossy(ptr, n_units)
}

fn test_wide_string_basics() -> i32 {
    let ws0 = wide_string_new();
    if ws0.len != 0 || ws0.cap != 0 { return 1; }

    let mut ws = wide_string_with_capacity(10);
    if ws.len != 0 { return 2; }
    if 11 > ws.cap { return 3; }
    if unsafe { *ws.ptr } != 0u16 { return 4; }

    wide_string_push(mut_view(ws), 0x0041u16);
    wide_string_push(mut_view(ws), 0x0042u16);
    wide_string_push(mut_view(ws), 0x0043u16);

    if ws.len != 3 { return 5; }
    match wide_string_get(view(ws), 0) {
        Option.Some(v) => { if v != 0x0041u16 { return 6; } },
        Option.None => { return 7; }
    }
    match wide_string_get(view(ws), 1) {
        Option.Some(v) => { if v != 0x0042u16 { return 8; } },
        Option.None => { return 9; }
    }
    match wide_string_get(view(ws), 2) {
        Option.Some(v) => { if v != 0x0043u16 { return 10; } },
        Option.None => { return 11; }
    }
    match wide_string_get(view(ws), 3) {
        Option.Some(_) => { return 12; },
        Option.None => {}
    }

    // Invariant: NUL terminator at ws.ptr + ws.len
    let term = unsafe { *(ws.ptr + ws.len) };
    if term != 0u16 { return 13; }

    0
}

fn test_wide_string_push_char() -> i32 {
    let mut ws = wide_string_with_capacity(4);
    wide_string_push_char(mut_view(ws), 'H');
    wide_string_push_char(mut_view(ws), 'i');

    // Emoji U+1F600 (😀) -> surrogate pair: 0xD83D, 0xDE00
    wide_string_push_char(mut_view(ws), '😀');

    if ws.len != 4 { return 20; }
    if unsafe { *ws.ptr } != 0x0048u16 { return 21; }
    if unsafe { *(ws.ptr + 1) } != 0x0069u16 { return 22; }
    if unsafe { *(ws.ptr + 2) } != 0xD83Du16 { return 23; }
    if unsafe { *(ws.ptr + 3) } != 0xDE00u16 { return 24; }

    // NUL-terminator check
    if unsafe { *(ws.ptr + 4) } != 0u16 { return 25; }

    0
}

fn test_wide_string_growth_and_reserve() -> i32 {
    let mut ws = wide_string_with_capacity(2);
    wide_string_reserve(mut_view(ws), 100);
    if 101 > ws.cap { return 30; }

    let mut i: usize = 0;
    while i < 50 {
        wide_string_push(mut_view(ws), (0x0030 + (i as u16 % 10u16)));
        i = i + 1;
    }

    if ws.len != 50 { return 31; }
    let mut j: usize = 0;
    while j < 50 {
        let expected = 0x0030 + (j as u16 % 10u16);
        match wide_string_get(view(ws), j) {
            Option.Some(val) => { if val != expected { return 32; } },
            Option.None => { return 33; }
        }
        j = j + 1;
    }

    // NUL-terminator check after growth
    if unsafe { *(ws.ptr + 50) } != 0u16 { return 34; }

    0
}

fn test_null_terminated_roundtrip() -> i32 {
    // "Xin chào" UTF-8 bytes:
    // 0x58, 0x69, 0x6e, 0x20, 0x63, 0x68, 0xc3, 0xa0, 0x6f (9 bytes)
    let bytes: [9]u8 = [0x58, 0x69, 0x6e, 0x20, 0x63, 0x68, 0xc3, 0xa0, 0x6f];
    let v_bytes: view<[u8]> = view(bytes);

    let ws: WideString = match to_wide_null(v_bytes) {
        Result.Ok(w) => w,
        Result.Err(_) => { return 40; }
    };

    let raw: *const u16 = ws.ptr as *const u16;
    let n_units = unsafe { utf16_null_len(raw) };
    if n_units != ws.len { return 41; }
    if unsafe { *(raw + n_units) } != 0u16 { return 42; }

    let s: String = match unsafe { utf16_null_to_utf8(raw) } {
        Result.Ok(res) => res,
        Result.Err(_) => { return 43; }
    };

    if s.len != 9 { return 44; }
    let mut i: usize = 0;
    while i < 9 {
        let b = unsafe { *(s.ptr + i) };
        if b != bytes[i] { return 45; }
        i = i + 1;
    }

    // Test lossy conversion with lone surrogate:
    let mut lone_ws = wide_string_with_capacity(2);
    wide_string_push(mut_view(lone_ws), 0xD800u16);
    let lone_ptr = lone_ws.ptr as *const u16;
    let s_lossy = unsafe { utf16_null_to_utf8_lossy(lone_ptr) };
    if s_lossy.len != 3 { return 46; }
    if unsafe { *s_lossy.ptr } != 0xEFu8 || unsafe { *(s_lossy.ptr + 1) } != 0xBFu8 || unsafe { *(s_lossy.ptr + 2) } != 0xBDu8 {
        return 47;
    }

    0
}

fn main() -> i32 {
    let r1 = test_wide_string_basics();
    if r1 != 0 { return r1; }

    let r2 = test_wide_string_push_char();
    if r2 != 0 { return r2; }

    let r3 = test_wide_string_growth_and_reserve();
    if r3 != 0 { return r3; }

    let r4 = test_null_terminated_roundtrip();
    if r4 != 0 { return r4; }

    print("OK Utf16WideBuffer\n");
    0
}
