// test: run
// stdout: OK Utf16Surrogates\n

use std.core.result.Result
use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub const REPLACEMENT_CHARACTER: char = '\u{FFFD}';
pub const REPLACEMENT_CODE_UNIT: u16 = 0xFFFDu16;

pub enum Utf16Error {
    InvalidUtf8(usize),
    LoneSurrogate(usize),
    Truncated(usize),
}

pub struct DecodeUtf8Result {
    pub ch: char,
    pub len: usize,
}

pub struct DecodeUtf16Result {
    pub ch: char,
    pub len: usize,
}

pub fn is_high_surrogate(u: u16) -> bool {
    u >= 0xD800u16 && u <= 0xDBFFu16
}

pub fn is_low_surrogate(u: u16) -> bool {
    u >= 0xDC00u16 && u <= 0xDFFFu16
}

pub fn is_surrogate(u: u16) -> bool {
    u >= 0xD800u16 && u <= 0xDFFFu16
}

pub fn surrogate_high(cp: u32) -> u16 {
    (0xD800 + ((cp - 0x10000) >> 10)) as u16
}

pub fn surrogate_low(cp: u32) -> u16 {
    (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16
}

pub fn decode_surrogate_pair(high: u16, low: u16) -> char {
    let cp: u32 = 0x10000 + ((((high as u32) - 0xD800) << 10) | (((low as u32) - 0xDC00) & 0x3FF));
    cp as char
}

pub fn char_len_utf8(c: char) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        1
    } else if u <= 0x7FF {
        2
    } else if u <= 0xFFFF {
        3
    } else {
        4
    }
}

pub unsafe fn char_encode_utf8(c: char, dst: *mut u8) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        *dst = u as u8;
        1
    } else if u <= 0x7FF {
        *dst = (0xC0 | (u >> 6)) as u8;
        *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        2
    } else if u <= 0xFFFF {
        *dst = (0xE0 | (u >> 12)) as u8;
        *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        3
    } else {
        *dst = (0xF0 | (u >> 18)) as u8;
        *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        4
    }
}

pub fn decode_utf8_char(bytes: view<[u8]>, offset: usize) -> Result<DecodeUtf8Result, Utf16Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf16Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeUtf8Result { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf16Error.InvalidUtf8(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf16Error.InvalidUtf8(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf16Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf16Error.InvalidUtf8(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf16Error.InvalidUtf8(offset));
        }
        return Result.Ok(DecodeUtf8Result { ch: cp as char, len: 4 });
    }
    Result.Err(Utf16Error.InvalidUtf8(offset))
}

pub fn decode_utf16_char(units: view<[u16]>, offset: usize) -> Result<DecodeUtf16Result, Utf16Error> {
    let n = len(units);
    if offset >= n {
        return Result.Err(Utf16Error.Truncated(offset));
    }
    let u0 = units[offset];
    if u0 < 0xD800u16 || u0 > 0xDFFFu16 {
        return Result.Ok(DecodeUtf16Result { ch: u0 as u32 as char, len: 1 });
    }
    if is_high_surrogate(u0) {
        if offset + 1 >= n {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
        let u1 = units[offset + 1];
        if is_low_surrogate(u1) {
            let ch = decode_surrogate_pair(u0, u1);
            return Result.Ok(DecodeUtf16Result { ch: ch, len: 2 });
        } else {
            return Result.Err(Utf16Error.LoneSurrogate(offset));
        }
    }
    Result.Err(Utf16Error.LoneSurrogate(offset))
}

pub fn decode_utf16_char_lossy(units: view<[u16]>, offset: usize) -> DecodeUtf16Result {
    let n = len(units);
    if offset >= n {
        return DecodeUtf16Result { ch: '\0', len: 0 };
    }
    let u0 = units[offset];
    if u0 < 0xD800u16 || u0 > 0xDFFFu16 {
        return DecodeUtf16Result { ch: u0 as u32 as char, len: 1 };
    }
    if is_high_surrogate(u0) {
        if offset + 1 < n {
            let u1 = units[offset + 1];
            if is_low_surrogate(u1) {
                return DecodeUtf16Result { ch: decode_surrogate_pair(u0, u1), len: 2 };
            }
        }
        return DecodeUtf16Result { ch: REPLACEMENT_CHARACTER, len: 1 };
    }
    DecodeUtf16Result { ch: REPLACEMENT_CHARACTER, len: 1 }
}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = char_len_utf8(c);
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        char_encode_utf8(c, dst);
    }
    s.len = s.len + clen;
}

pub struct WideString {
    pub ptr: *mut u16,
    pub len: usize,
    pub cap: usize,
}

pub fn wide_string_new() -> WideString {
    WideString {
        ptr: 0 as *mut u16,
        len: 0,
        cap: 0,
    }
}

pub fn wide_string_with_capacity(capacity: usize) -> WideString {
    let alloc_cap = capacity + 1;
    let raw = unsafe { heap_alloc(alloc_cap * 2, 2) };
    let p = raw as *mut u16;
    if p as usize != 0 {
        unsafe {
            *p = 0u16;
        }
    }
    WideString {
        ptr: p,
        len: 0,
        cap: alloc_cap,
    }
}

pub fn wide_string_push(s: mut_view<WideString>, unit: u16) {
    let needed = s.len + 2;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap * 2, 2) };
        let new_ptr = raw as *mut u16;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, new_ptr, s.len);
            }
        }
        if s.ptr as usize != 0 {
            unsafe {
                heap_free(s.ptr as *mut u8, s.cap * 2, 2);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        let p = s.ptr + s.len;
        *p = unit;
        *(p + 1) = 0u16;
    }
    s.len = s.len + 1;
}

pub fn wide_string_push_char(s: mut_view<WideString>, c: char) {
    let u = c as u32;
    let units_needed: usize = if u <= 0xFFFF { 1 } else { 2 };
    let needed = s.len + units_needed + 1;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap * 2, 2) };
        let new_ptr = raw as *mut u16;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u16>(s.ptr as *const u16, new_ptr, s.len);
            }
        }
        if s.ptr as usize != 0 {
            unsafe {
                heap_free(s.ptr as *mut u8, s.cap * 2, 2);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        let p = s.ptr + s.len;
        if units_needed == 1 {
            *p = u as u16;
            *(p + 1) = 0u16;
        } else {
            *p = surrogate_high(u);
            *(p + 1) = surrogate_low(u);
            *(p + 2) = 0u16;
        }
    }
    s.len = s.len + units_needed;
}

pub fn utf8_to_utf16(bytes: view<[u8]>) -> Result<WideString, Utf16Error> {
    let n = len(bytes);
    let mut ws = wide_string_with_capacity(n);
    let mut offset: usize = 0;
    while offset < n {
        match decode_utf8_char(bytes, offset) {
            Result.Ok(res) => {
                let dec: DecodeUtf8Result = res;
                wide_string_push_char(mut_view(ws), dec.ch);
                offset = offset + dec.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(ws)
}

pub fn utf8_to_utf16_lossy(bytes: view<[u8]>) -> WideString {
    let n = len(bytes);
    let mut ws = wide_string_with_capacity(n);
    let mut offset: usize = 0;
    while offset < n {
        match decode_utf8_char(bytes, offset) {
            Result.Ok(res) => {
                let dec: DecodeUtf8Result = res;
                wide_string_push_char(mut_view(ws), dec.ch);
                offset = offset + dec.len;
            },
            Result.Err(_) => {
                wide_string_push(mut_view(ws), REPLACEMENT_CODE_UNIT);
                offset = offset + 1;
            }
        }
    }
    ws
}

pub fn utf16_to_utf8(units: view<[u16]>) -> Result<String, Utf16Error> {
    let n = len(units);
    let mut s = string_with_capacity(n * 3);
    let mut offset: usize = 0;
    while offset < n {
        match decode_utf16_char(units, offset) {
            Result.Ok(res) => {
                let dec: DecodeUtf16Result = res;
                string_push_char(mut_view(s), dec.ch);
                offset = offset + dec.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(s)
}

pub fn utf16_to_utf8_lossy(units: view<[u16]>) -> String {
    let n = len(units);
    let mut s = string_with_capacity(n * 3);
    let mut offset: usize = 0;
    while offset < n {
        let dec: DecodeUtf16Result = decode_utf16_char_lossy(units, offset);
        if dec.len == 0 {
            offset = offset + 1;
        } else {
            string_push_char(mut_view(s), dec.ch);
            offset = offset + dec.len;
        }
    }
    s
}

fn test_lone_high_surrogate_at_end() -> i32 {
    let units: [1]u16 = [0xD800u16];
    let v_u16: view<[u16]> = view(units);

    let mut ok = false;
    match utf16_to_utf8(v_u16) {
        Result.Err(e) => {
            match e {
                Utf16Error.LoneSurrogate(pos) => {
                    if pos == 0 { ok = true; }
                },
                _ => {}
            }
        },
        Result.Ok(_) => {}
    }
    if !ok { return 1; }

    let s = utf16_to_utf8_lossy(v_u16);
    if s.len != 3 { return 4; }
    let p = s.ptr;
    if unsafe { *p } != 0xEFu8 || unsafe { *(p + 1) } != 0xBFu8 || unsafe { *(p + 2) } != 0xBDu8 {
        return 5;
    }

    0
}

fn test_lone_high_surrogate_before_bmp() -> i32 {
    let units: [2]u16 = [0xD83Du16, 0x0041u16];
    let v_u16: view<[u16]> = view(units);

    let mut ok = false;
    match utf16_to_utf8(v_u16) {
        Result.Err(e) => {
            match e {
                Utf16Error.LoneSurrogate(pos) => {
                    if pos == 0 { ok = true; }
                },
                _ => {}
            }
        },
        Result.Ok(_) => {}
    }
    if !ok { return 10; }

    let s = utf16_to_utf8_lossy(v_u16);
    if s.len != 4 { return 13; }
    let p = s.ptr;
    if unsafe { *p } != 0xEFu8 || unsafe { *(p + 1) } != 0xBFu8 || unsafe { *(p + 2) } != 0xBDu8 {
        return 14;
    }
    if unsafe { *(p + 3) } != 0x41u8 { return 15; }

    0
}

fn test_lone_low_surrogate() -> i32 {
    let units: [1]u16 = [0xDC00u16];
    let v_u16: view<[u16]> = view(units);

    let mut ok = false;
    match utf16_to_utf8(v_u16) {
        Result.Err(e) => {
            match e {
                Utf16Error.LoneSurrogate(pos) => {
                    if pos == 0 { ok = true; }
                },
                _ => {}
            }
        },
        Result.Ok(_) => {}
    }
    if !ok { return 20; }

    let s = utf16_to_utf8_lossy(v_u16);
    if s.len != 3 { return 23; }
    let p = s.ptr;
    if unsafe { *p } != 0xEFu8 || unsafe { *(p + 1) } != 0xBFu8 || unsafe { *(p + 2) } != 0xBDu8 {
        return 24;
    }

    0
}

fn test_surrogate_boundaries() -> i32 {
    let u10000: [2]u16 = [0xD800u16, 0xDC00u16];
    let v1: view<[u16]> = view(u10000);
    let s1: String = match utf16_to_utf8(v1) {
        Result.Ok(res) => res,
        Result.Err(_) => { return 30; }
    };
    if s1.len != 4 { return 31; }
    let p1 = s1.ptr;
    if unsafe { *p1 } != 0xF0u8 || unsafe { *(p1 + 1) } != 0x90u8 || unsafe { *(p1 + 2) } != 0x80u8 || unsafe { *(p1 + 3) } != 0x80u8 {
        return 32;
    }

    let b1_bytes: [4]u8 = [0xF0, 0x90, 0x80, 0x80];
    let v1_bytes: view<[u8]> = view(b1_bytes);
    let ws1: WideString = match utf8_to_utf16(v1_bytes) {
        Result.Ok(w) => w,
        Result.Err(_) => { return 33; }
    };
    if ws1.len != 2 { return 34; }
    if unsafe { *ws1.ptr } != 0xD800u16 || unsafe { *(ws1.ptr + 1) } != 0xDC00u16 {
        return 35;
    }

    let u10ffff: [2]u16 = [0xDBFFu16, 0xDFFFu16];
    let v2: view<[u16]> = view(u10ffff);
    let s2: String = match utf16_to_utf8(v2) {
        Result.Ok(res) => res,
        Result.Err(_) => { return 36; }
    };
    if s2.len != 4 { return 37; }
    let p2 = s2.ptr;
    if unsafe { *p2 } != 0xF4u8 || unsafe { *(p2 + 1) } != 0x8Fu8 || unsafe { *(p2 + 2) } != 0xBFu8 || unsafe { *(p2 + 3) } != 0xBFu8 {
        return 38;
    }

    let b2_bytes: [4]u8 = [0xF4, 0x8F, 0xBF, 0xBF];
    let v2_bytes: view<[u8]> = view(b2_bytes);
    let ws2: WideString = match utf8_to_utf16(v2_bytes) {
        Result.Ok(w) => w,
        Result.Err(_) => { return 39; }
    };
    if ws2.len != 2 { return 40; }
    if unsafe { *ws2.ptr } != 0xDBFFu16 || unsafe { *(ws2.ptr + 1) } != 0xDFFFu16 {
        return 41;
    }

    0
}

fn test_invalid_utf8_to_utf16() -> i32 {
    let b1: [1]u8 = [0x80u8];
    let v1: view<[u8]> = view(b1);
    let mut ok1 = false;
    match utf8_to_utf16(v1) {
        Result.Err(e) => {
            match e {
                Utf16Error.InvalidUtf8(p) => { if p == 0 { ok1 = true; } },
                _ => {}
            }
        },
        Result.Ok(_) => {}
    }
    if !ok1 { return 50; }

    let ws1 = utf8_to_utf16_lossy(v1);
    if ws1.len != 1 { return 53; }
    if unsafe { *ws1.ptr } != REPLACEMENT_CODE_UNIT { return 54; }

    let b2: [3]u8 = [0xEDu8, 0xA0u8, 0x80u8];
    let v2: view<[u8]> = view(b2);
    let mut ok2 = false;
    match utf8_to_utf16(v2) {
        Result.Err(e) => {
            match e {
                Utf16Error.LoneSurrogate(p) => { if p == 0 { ok2 = true; } },
                _ => {}
            }
        },
        Result.Ok(_) => {}
    }
    if !ok2 { return 55; }

    let ws2 = utf8_to_utf16_lossy(v2);
    if ws2.len != 3 { return 58; }
    if unsafe { *ws2.ptr } != REPLACEMENT_CODE_UNIT || unsafe { *(ws2.ptr + 1) } != REPLACEMENT_CODE_UNIT || unsafe { *(ws2.ptr + 2) } != REPLACEMENT_CODE_UNIT { return 59; }

    let b3: [1]u8 = [0xC3u8];
    let v3: view<[u8]> = view(b3);
    let mut ok3 = false;
    match utf8_to_utf16(v3) {
        Result.Err(e) => {
            match e {
                Utf16Error.Truncated(p) => { if p == 0 { ok3 = true; } },
                _ => {}
            }
        },
        Result.Ok(_) => {}
    }
    if !ok3 { return 60; }

    let ws3 = utf8_to_utf16_lossy(v3);
    if ws3.len != 1 { return 63; }
    if unsafe { *ws3.ptr } != REPLACEMENT_CODE_UNIT { return 64; }

    0
}

fn main() -> i32 {
    let r1 = test_lone_high_surrogate_at_end();
    if r1 != 0 { return r1; }

    let r2 = test_lone_high_surrogate_before_bmp();
    if r2 != 0 { return r2; }

    let r3 = test_lone_low_surrogate();
    if r3 != 0 { return r3; }

    let r4 = test_surrogate_boundaries();
    if r4 != 0 { return r4; }

    let r5 = test_invalid_utf8_to_utf16();
    if r5 != 0 { return r5; }

    print("OK Utf16Surrogates\n");
    0
}
