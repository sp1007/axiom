// test: run
// modes: interp native
// xfail: T454 several impls of one generic trait for the same Self cannot be told apart (AX_TRAIT_AMBIGUOUS_METHOD, or the first impl is silently used through a generic bound)
// stdout: 7 5007\n
// Minimal repro found by T454: SPEC-40 wants `From<u8> for u64` and `From<u16> for u64` side by side
// (std.core.convert).  Through a generic bound the compiler picks the first impl for both calls and prints "7 7".

pub trait Mk<T> {
    fn mk(v: T) -> Self;
}

impl Mk<u8> for u64 {
    fn mk(v: u8) -> u64 { v as u64 }
}

impl Mk<u16> for u64 {
    fn mk(v: u16) -> u64 { (v as u64) + 5000u64 }
}

fn convert<S, D: Mk<S>>(x: S) -> D {
    D.mk(x)
}

fn main() -> i32 {
    let a: u64 = convert(7u8);
    let b: u64 = convert(7u16);
    print_int(a as i64);
    print(" ");
    print_int(b as i64);
    print("\n");
    0
}
