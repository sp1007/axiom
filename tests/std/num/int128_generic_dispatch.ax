// test: run
// modes: interp native
// stdout: 12345\n12345\n
// Regression test for T454 (std.core.convert: i128.try_from(x) with a 128-bit source gave wrong results).
// Through a generic bound `S: Tag` the 128-bit types used to fall back to the first impl (the one for i8) because
// prim_kind_matches_name in compiler/traits/solver.ax had no i128/u128 branch; the second line printed 12115.

pub trait Tag {
    fn tag(self: view<Self>) -> i32;
}

impl Tag for i8 { fn tag(self: view<i8>) -> i32 { 1 } }
impl Tag for i64 { fn tag(self: view<i64>) -> i32 { 2 } }
impl Tag for i128 { fn tag(self: view<i128>) -> i32 { 3 } }
impl Tag for u128 { fn tag(self: view<u128>) -> i32 { 4 } }
impl Tag for u64 { fn tag(self: view<u64>) -> i32 { 5 } }

fn tag_of<S: Tag>(v: S) -> i32 {
    v.tag()
}

fn main() -> i32 {
    print_int((5i8).tag() as i64);
    print_int((5i64).tag() as i64);
    print_int((5i128).tag() as i64);
    print_int((5u128).tag() as i64);
    print_int((5u64).tag() as i64);
    print("\n");
    print_int(tag_of(5i8) as i64);
    print_int(tag_of(5i64) as i64);
    print_int(tag_of(5i128) as i64);
    print_int(tag_of(5u128) as i64);
    print_int(tag_of(5u64) as i64);
    print("\n");
    0
}
