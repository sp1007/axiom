// test: run
// modes: interp native
// xfail: T454 a static trait method called through a type parameter (D.mk(..)) always runs the first impl, whatever D is
// stdout: 231\n
// Minimal repro found by T454 (x.into() / x.try_into() choose the destination type from the expected type).
// Expected: mk resolves for D = i16 (2), u8 (3) and i8 (1).  Today every call runs the impl for i8 and prints 111.

pub trait Mk {
    fn mk(x: i32) -> Self;
}

impl Mk for i8 {
    fn mk(x: i32) -> i8 { 1i8 }
}

impl Mk for i16 {
    fn mk(x: i32) -> i16 { 2i16 }
}

impl Mk for u8 {
    fn mk(x: i32) -> u8 { 3u8 }
}

fn make<D: Mk>() -> D {
    D.mk(0)
}

fn main() -> i32 {
    let a: i16 = make();
    let b: u8 = make();
    let c: i8 = make();
    print_int(a as i64);
    print_int(b as i64);
    print_int(c as i64);
    print("\n");
    0
}
