// test: run
// modes: interp native
// xfail: T454 a tuple expression that names a variable does not compile (AX_NAME_UNRESOLVED for a let local)
// stdout: 6T\n
// Minimal repro found by T454 (std.core.num overflowing_* returns (Self, bool)): `(total, flag)` must build the pair.
// Only literals resolve inside a tuple expression today.  With a parameter instead of a local, `(value, flag)`
// makes the compiler itself die with a stack overflow (exit status 3221225725), which axtest reports as CRASH,
// so this repro uses the local form.  std/core/num.ax builds its pairs field by field instead.

fn pair(a: i8, b: i8) -> (i8, bool) {
    let total: i8 = a + b;
    (total, true)
}

fn main() -> i32 {
    let t = pair(5i8, 1i8);
    print_int(t.0 as i64);
    if t.1 {
        print("T");
    }
    print("\n");
    0
}
