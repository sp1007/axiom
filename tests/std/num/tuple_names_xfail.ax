// test: run
// modes: interp native
// stdout: 6T\n
// Minimal repro found by T454 (std.core.num overflowing_* returns (Self, bool)): `(total, flag)` must build the pair.
// Fixed by T499a: the resolver did not walk the elements of a tuple expression, so a let local inside one was
// AX_NAME_UNRESOLVED and a parameter (found by typeck's by-name fallback without a symbol) crashed the compiler.
// std/core/num.ax still builds its pairs field by field (pair_T helpers); removing them is a std follow-up.

fn pair(a: i8, b: i8) -> (i8, bool) {
    let total: i8 = a + b;
    (total, true)
}

fn main() -> i32 {
    let t = pair(5i8, 1i8);
    print_int(t.0 as i64);
    if t.1 {
        print("T");
    }
    print("\n");
    0
}
