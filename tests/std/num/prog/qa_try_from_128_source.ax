// test: helper
// QA finding F1 of T454: try_from with a 128-bit SOURCE silently returns wrong results because trait impl selection
// ignores i128/u128 (the first impl, the one for i8, runs).  Expected: Err for every value that does not fit.
// std: core/num.ax core/convert.ax

use std.core.result.Result
use std.core.convert.TryFromIntError

fn main() -> i32 {
    // 10^20 does not fit in u64 (low byte is 0, so the i8 impl reads 0 and reports Ok(0))
    match u64.try_from(100000000000000000000u128) { Result.Ok(_) => { return 1; }, Result.Err(_) => {}, }
    // 2^64 low byte 0
    match u64.try_from(18446744073709551616u128) { Result.Ok(_) => { return 2; }, Result.Err(_) => {}, }
    match i64.try_from(18446744073709551616i128) { Result.Ok(_) => { return 3; }, Result.Err(_) => {}, }
    match u8.try_from(256u128) { Result.Ok(_) => { return 4; }, Result.Err(_) => {}, }
    print("OK qa_try_from_128_source\n");
    0
}
