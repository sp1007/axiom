fn test_convert_bool() -> i32 {
    if i8.from(true) != 1i8 { return 2390; }
    if i8.from(false) != 0i8 { return 2391; }
    if i16.from(true) != 1i16 { return 2392; }
    if i16.from(false) != 0i16 { return 2393; }
    if i32.from(true) != 1i32 { return 2394; }
    if i32.from(false) != 0i32 { return 2395; }
    if i64.from(true) != 1i64 { return 2396; }
    if i64.from(false) != 0i64 { return 2397; }
    if i128.from(true) != 1i128 { return 2398; }
    if i128.from(false) != 0i128 { return 2399; }
    if isize.from(true) != 1isize { return 2400; }
    if isize.from(false) != 0isize { return 2401; }
    if u8.from(true) != 1u8 { return 2402; }
    if u8.from(false) != 0u8 { return 2403; }
    if u16.from(true) != 1u16 { return 2404; }
    if u16.from(false) != 0u16 { return 2405; }
    if u32.from(true) != 1u32 { return 2406; }
    if u32.from(false) != 0u32 { return 2407; }
    if u64.from(true) != 1u64 { return 2408; }
    if u64.from(false) != 0u64 { return 2409; }
    if u128.from(true) != 1u128 { return 2410; }
    if u128.from(false) != 0u128 { return 2411; }
    if usize.from(true) != 1usize { return 2412; }
    if usize.from(false) != 0usize { return 2413; }
    0
}

fn test_convert_spec_example() -> i32 {
    let total: i64 = 93985;
    let widened: i128 = i128.from(total);
    if widened != 93985i128 { return 2414; }
    let ok_u16: Result<u16, TryFromIntError> = u16.try_from(500i64);
    if !try_u16(ok_u16, true, 500u16) { return 2415; }
    let err_u16: Result<u16, TryFromIntError> = u16.try_from(total);
    if !try_u16(err_u16, false, 0u16) { return 2416; }
    0
}

