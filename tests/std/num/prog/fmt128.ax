    s = format_u128_dec_padded(12345u128, 3, false);
    if !eq_bytes(view(s), view(e212)) { return 212; }
    let e213: [45]u8 = [b'0', b'0', b'0', b'0', b'0', b'0', b'1', b'7', b'0', b'1', b'4', b'1', b'1', b'8', b'3', b'4', b'6', b'0', b'4', b'6', b'9', b'2', b'3', b'1', b'7', b'3', b'1', b'6', b'8', b'7', b'3', b'0', b'3', b'7', b'1', b'5', b'8', b'8', b'4', b'1', b'0', b'5', b'7', b'2', b'8'];
    s = format_u128_dec_padded(170141183460469231731687303715884105728u128, 45, true);
    if !eq_bytes(view(s), view(e213)) { return 213; }
    let e214: [1]u8 = [b'7'];
    s = format_u128_dec_padded(7u128, 0, false);
    if !eq_bytes(view(s), view(e214)) { return 214; }
    let e215: [6]u8 = [b' ', b' ', b' ', b'-', b'4', b'2'];
    s = format_i128_dec_padded(-42i128, 6, false);
    if !eq_bytes(view(s), view(e215)) { return 215; }
    let e216: [6]u8 = [b'-', b'0', b'0', b'0', b'4', b'2'];
