fn test_format_padding() -> i32 {
    let mut s = string_new();
    let e209: [6]u8 = [b' ', b' ', b' ', b' ', b'4', b'2'];
    s = format_u128_dec_padded(42u128, 6, false);
    if !eq_bytes(view(s), view(e209)) { return 209; }
    let e210: [6]u8 = [b'0', b'0', b'0', b'0', b'4', b'2'];
    s = format_u128_dec_padded(42u128, 6, true);
    if !eq_bytes(view(s), view(e210)) { return 210; }
    let e211: [4]u8 = [b'0', b'0', b'0', b'0'];
    s = format_u128_dec_padded(0u128, 4, true);
    if !eq_bytes(view(s), view(e211)) { return 211; }
