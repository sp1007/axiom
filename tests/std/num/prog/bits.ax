fn main() -> i32 {
    let mut r: i32 = 0;
    r = test_bits_count_i8();
    if r != 0 { return r + 100000; }
    r = test_bits_rotate_i8();
    if r != 0 { return r + 200000; }
    r = test_bits_bytes_i8();
    if r != 0 { return r + 300000; }
    r = test_bits_count_i16();
