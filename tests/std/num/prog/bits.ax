fn test_bits_count_u16() -> i32 {
    if (0u16).count_ones() != 0u32 { return 3035; }
    if (0u16).count_zeros() != 16u32 { return 3036; }
    if (0u16).leading_zeros() != 16u32 { return 3037; }
    if (0u16).trailing_zeros() != 16u32 { return 3038; }
    if (0u16).leading_ones() != 0u32 { return 3039; }
    if (0u16).trailing_ones() != 0u32 { return 3040; }
    if (1u16).count_ones() != 1u32 { return 3041; }
    if (1u16).count_zeros() != 15u32 { return 3042; }
    if (1u16).leading_zeros() != 15u32 { return 3043; }
    if (1u16).trailing_zeros() != 0u32 { return 3044; }
    if (1u16).leading_ones() != 0u32 { return 3045; }
    if (1u16).trailing_ones() != 1u32 { return 3046; }
    if (2u16).count_ones() != 1u32 { return 3047; }
    if (2u16).count_zeros() != 15u32 { return 3048; }
    if (2u16).leading_zeros() != 14u32 { return 3049; }
    if (2u16).trailing_zeros() != 1u32 { return 3050; }
    if (2u16).leading_ones() != 0u32 { return 3051; }
    if (2u16).trailing_ones() != 0u32 { return 3052; }
    if (3u16).count_ones() != 2u32 { return 3053; }
    if (3u16).count_zeros() != 14u32 { return 3054; }
    if (3u16).leading_zeros() != 14u32 { return 3055; }
