// test: helper
// QA adversarial edge cases for T454 (hand written).  Expected values are exact integers computed by hand.
// std: core/num.ax core/convert.ax

use std.core.option.Option
use std.core.result.Result
use std.core.convert.TryFromIntError

fn main() -> i32 {
    // shift counts equal to BITS are rejected / masked
    match (1u8).checked_shl(8u32) { Option.Some(_) => { return 1; }, Option.None => {}, }
    match (1u8).checked_shl(7u32) { Option.Some(v) => { if v != 128u8 { return 2; } }, Option.None => { return 3; }, }
    if (1u32).wrapping_shl(33u32) != 2u32 { return 4; }
    match (1u128).checked_shl(128u32) { Option.Some(_) => { return 5; }, Option.None => {}, }
    match (1u128).checked_shl(127u32) { Option.Some(v) => { if v != 170141183460469231731687303715884105728u128 { return 6; } }, Option.None => { return 7; }, }
    // i8.MIN edge cases
    match (-128i8).checked_abs() { Option.Some(_) => { return 8; }, Option.None => {}, }
    match (-128i8).checked_neg() { Option.Some(_) => { return 9; }, Option.None => {}, }
    match (-128i8).checked_div(-1i8) { Option.Some(_) => { return 10; }, Option.None => {}, }
    if (-128i8).wrapping_abs() != -128i8 { return 11; }
    if (-128i8).unsigned_abs() != 128u8 { return 12; }
    if (-128i8).saturating_abs() != 127i8 { return 13; }
    // i128 extremes
    match (-170141183460469231731687303715884105728i128).checked_neg() { Option.Some(_) => { return 14; }, Option.None => {}, }
    if (-170141183460469231731687303715884105728i128).unsigned_abs() != 170141183460469231731687303715884105728u128 { return 15; }
    match (2u128).checked_pow(128u32) { Option.Some(_) => { return 16; }, Option.None => {}, }
    match (2u128).checked_pow(127u32) { Option.Some(v) => { if v != 170141183460469231731687303715884105728u128 { return 17; } }, Option.None => { return 18; }, }
    match (0u32).checked_pow(0u32) { Option.Some(v) => { if v != 1u32 { return 19; } }, Option.None => { return 20; }, }
    // rotate by more than BITS and by zero
    if (0x81u8).rotate_left(9u32) != 0x03u8 { return 21; }
    if (0x81u8).rotate_right(0u32) != 0x81u8 { return 22; }
    // bit counts of zero and all-ones
    if (0u16).leading_zeros() != 16u32 { return 23; }
    if (0u16).trailing_zeros() != 16u32 { return 24; }
    if (0xFFFFu16).leading_ones() != 16u32 { return 25; }
    if (0u128).leading_zeros() != 128u32 { return 26; }
    if (0u64).count_zeros() != 64u32 { return 27; }
    // endian: exact bytes and round trips
    let b: [4]u8 = (0x01020304u32).to_be_bytes();
    if b[0] != 1u8 { return 28; }
    if b[3] != 4u8 { return 29; }
    let l: [4]u8 = (0x01020304u32).to_le_bytes();
    if l[0] != 4u8 { return 30; }
    if u32.from_le_bytes(b) != 0x04030201u32 { return 31; }
    if i16.from_be_bytes((-2i16).to_be_bytes()) != -2i16 { return 32; }
    // try_from edges near 64 bits (source widths <= 64)
    match u8.try_from(256u16) { Result.Ok(_) => { return 33; }, Result.Err(_) => {}, }
    match u8.try_from(255u16) { Result.Ok(v) => { if v != 255u8 { return 34; } }, Result.Err(_) => { return 35; }, }
    match i64.try_from(9223372036854775808u64) { Result.Ok(_) => { return 36; }, Result.Err(_) => {}, }
    match u64.try_from(-1i8) { Result.Ok(_) => { return 37; }, Result.Err(_) => {}, }
    match i8.try_from(-129i16) { Result.Ok(_) => { return 38; }, Result.Err(_) => {}, }
    match i8.try_from(-128i16) { Result.Ok(v) => { if v != -128i8 { return 39; } }, Result.Err(_) => { return 40; }, }
    match u128.try_from(-1i64) { Result.Ok(_) => { return 41; }, Result.Err(_) => {}, }
    match i128.try_from(18446744073709551615u64) { Result.Ok(v) => { if v != 18446744073709551615i128 { return 42; } }, Result.Err(_) => { return 43; }, }
    if i128.from(-5i64) != -5i128 { return 44; }
    if u64.from(true) != 1u64 { return 45; }
    print("OK qa_edges\n");
    0
}
