    if !try_usize(usize.try_from(4294967296u128), true, 4294967296usize) { return 629; }
    if !try_usize(usize.try_from(9223372036854775807u128), true, 9223372036854775807usize) { return 630; }
    if !try_usize(usize.try_from(9223372036854775808u128), true, 9223372036854775808usize) { return 631; }
    if !try_usize(usize.try_from(18446744073709551615u128), true, usize.MAX) { return 632; }
    if !try_usize(usize.try_from(18446744073709551616u128), false, 0usize) { return 633; }
    if !try_usize(usize.try_from(170141183460469231731687303715884105727u128), false, 0usize) { return 634; }
    if !try_usize(usize.try_from(170141183460469231731687303715884105728u128), false, 0usize) { return 635; }
    if !try_usize(usize.try_from(340282366920938463463374607431768211454u128), false, 0usize) { return 636; }
    if !try_usize(usize.try_from(u128.MAX), false, 0usize) { return 637; }
    0
}

