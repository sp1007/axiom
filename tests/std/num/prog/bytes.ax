fn test_bytes_u32() -> i32 {
    let a919: [4]u8 = (0u32).to_le_bytes();
    if a919[0] != 0u8 || a919[1] != 0u8 || a919[2] != 0u8 || a919[3] != 0u8 { return 919; }
