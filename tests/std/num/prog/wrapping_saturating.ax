fn main() -> i32 {
    let mut r: i32 = 0;
    r = test_wrapping_i8();
    if r != 0 { return r + 100000; }
    r = test_saturating_i8();
    if r != 0 { return r + 200000; }
    r = test_wrapping_i16();
    if r != 0 { return r + 300000; }
    r = test_saturating_i16();
    if r != 0 { return r + 400000; }
    r = test_wrapping_i32();
    if r != 0 { return r + 500000; }
    r = test_saturating_i32();
    if r != 0 { return r + 600000; }
    r = test_wrapping_i64();
    if r != 0 { return r + 700000; }
    r = test_saturating_i64();
    if r != 0 { return r + 800000; }
    r = test_wrapping_i128();
    if r != 0 { return r + 900000; }
    r = test_saturating_i128();
    if r != 0 { return r + 1000000; }
    r = test_wrapping_isize();
    if r != 0 { return r + 1100000; }
    r = test_saturating_isize();
    if r != 0 { return r + 1200000; }
    r = test_wrapping_u8();
    if r != 0 { return r + 1300000; }
    r = test_saturating_u8();
    if r != 0 { return r + 1400000; }
    r = test_wrapping_u16();
    if r != 0 { return r + 1500000; }
    r = test_saturating_u16();
    if r != 0 { return r + 1600000; }
    r = test_wrapping_u32();
    if r != 0 { return r + 1700000; }
    r = test_saturating_u32();
    if r != 0 { return r + 1800000; }
    r = test_wrapping_u64();
    if r != 0 { return r + 1900000; }
    r = test_saturating_u64();
    if r != 0 { return r + 2000000; }
    r = test_wrapping_u128();
    if r != 0 { return r + 2100000; }
    r = test_saturating_u128();
    if r != 0 { return r + 2200000; }
    r = test_wrapping_usize();
    if r != 0 { return r + 2300000; }
    r = test_saturating_usize();
    if r != 0 { return r + 2400000; }
    print("OK wrapping_saturating\n");
    0
}
