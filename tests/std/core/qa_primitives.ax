// test: run
// stdout: PRIMITIVES OK\n

impl i32 {
    fn abs(self: i32) -> i32 {
        if self < 0 { -self } else { self }
    }
    fn min(self: i32, other: i32) -> i32 {
        if self < other { self } else { other }
    }
    fn max(self: i32, other: i32) -> i32 {
        if self > other { self } else { other }
    }
}

impl char {
    fn from_u32(n: u32) -> Option<char> {
        if n <= 0x10FFFF && !(n >= 0xD800 && n <= 0xDFFF) {
            Option.Some(n as char)
        } else {
            Option.None
        }
    }
}

fn main() -> i32 {
    // abs, min, max
    let neg = -42i32;
    if neg.abs() != 42 { return 1; }
    if 10i32.min(20i32) != 10 { return 2; }
    if 10i32.max(20i32) != 20 { return 3; }

    // char.from_u32 valid
    let c = char.from_u32(65u32);
    match c {
        Option.Some(ch) => {
            if ch != 'A' { return 4; }
        },
        Option.None => { return 5; },
    }

    // char.from_u32 invalid (surrogate)
    let c_surrogate = char.from_u32(0xD800u32);
    match c_surrogate {
        Option.Some(_) => { return 6; },
        Option.None => {},
    }

    // char.from_u32 invalid (out of bounds)
    let c_oob = char.from_u32(0x110000u32);
    match c_oob {
        Option.Some(_) => { return 7; },
        Option.None => {},
    }

    print("PRIMITIVES OK\n");
    return 0;
}
