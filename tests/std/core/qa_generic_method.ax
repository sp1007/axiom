// test: run
// modes: interp native
// stdout: generic_method_ok\n

// Regression test: inherent methods on generic nominal types resolve and execute cleanly.

enum MyOpt<T> {
    None,
    Some(T),
}

impl<T> MyOpt<T> {
    fn is_some(self: MyOpt<T>) -> bool {
        match self {
            MyOpt.Some(_) => true,
            MyOpt.None => false,
        }
    }
}

fn main() -> i32 {
    let opt_some: MyOpt<i32> = MyOpt.Some(42);
    let opt_none: MyOpt<i32> = MyOpt.None;
    if !opt_some.is_some() {
        return 1;
    }
    if opt_none.is_some() {
        return 2;
    }
    print("generic_method_ok\n");
    0
}
