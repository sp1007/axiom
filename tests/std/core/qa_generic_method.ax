// test: ui
// expected-exit: 1

// Demonstrates compiler limitation: typeck.c:find_method only checks exact TypeId equality
// (self_ty.v == base_ty.v). Inherent methods on generic nominal types cannot be called.

enum MyOpt<T> {
    None,
    Some(T),
}

impl<T> MyOpt<T> {
    fn is_some(self: MyOpt<T>) -> bool {
        match self {
            MyOpt.Some(_) => true,
            MyOpt.None => false,
        }
    }
}

fn main() {
    let opt: MyOpt<i32> = MyOpt.Some(1);
    let _ = opt.is_some(); //~ ERROR AX_TYPE_UNKNOWN_FIELD
}
