// AXH64 v1 algorithm specification (matching kernel/hash.c and tests/unit/kernel/hash_vectors.txt).
// Constants:
const AXH_K1: u64 = 0x9E3779B97F4A7C15;
const AXH_K2: u64 = 0xC2B2AE3D27D4EB4F;
const AXH_K3: u64 = 0x165667B19E3779F9;
const AXH_SEED: u64 = 0x27D4EB2F165667C5;
const AXH_M: u64 = 0x9FB21C651E98DF25;

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(a: u64, b: u32) -> u64 { 0 }

fn axh_round(h: u64, w: u64) -> u64 {
    let m = wrapping_mul_u64(rotate_left_u64(wrapping_mul_u64(w, AXH_K2), 31), AXH_K1);
    wrapping_add_u64(wrapping_mul_u64(rotate_left_u64(h ^ m, 27), AXH_K1), AXH_K3)
}

fn axh_fold(h: u64) -> u64 {
    h ^ rotate_left_u64(h, 15) ^ rotate_left_u64(h, 40)
}

fn axh_avalanche(mut h: u64) -> u64 {
    h = wrapping_mul_u64(axh_fold(h), AXH_M);
    h = wrapping_mul_u64(axh_fold(h), AXH_K2);
    axh_fold(h)
}

pub trait Hasher {
    fn finish(self: view<Self>) -> u64;
    fn write(self: mut_view<Self>, bytes: view<[u8]>);
    fn write_u8(self: mut_view<Self>, i: u8);
    fn write_u16(self: mut_view<Self>, i: u16);
    fn write_u32(self: mut_view<Self>, i: u32);
    fn write_u64(self: mut_view<Self>, i: u64);
    fn write_usize(self: mut_view<Self>, i: usize);
    fn write_i8(self: mut_view<Self>, i: i8);
    fn write_i16(self: mut_view<Self>, i: i16);
    fn write_i32(self: mut_view<Self>, i: i32);
    fn write_i64(self: mut_view<Self>, i: i64);
    fn write_isize(self: mut_view<Self>, i: isize);
}

pub trait Hash {
    fn hash<H: Hasher>(self: view<Self>, state: mut_view<H>);
}

pub struct Axh64Hasher {
    pub h: u64,
    pub total_len: u64,
    pub buf: u64,
    pub buf_len: usize,
}

impl Axh64Hasher {
    pub fn new() -> Axh64Hasher {
        Axh64Hasher {
            h: AXH_SEED,
            total_len: 0,
            buf: 0,
            buf_len: 0,
        }
    }
}

impl Hasher for Axh64Hasher {
    fn finish(self: view<Axh64Hasher>) -> u64 {
        let mut h = self.h;
        if self.buf_len > 0 {
            h = axh_round(h, self.buf);
        }
        h = h ^ (wrapping_mul_u64(self.total_len, AXH_K3));
        axh_avalanche(h)
    }

    fn write(self: mut_view<Axh64Hasher>, bytes: view<[u8]>) {
        let mut byte_len = len(bytes);
        let mut offset: usize = 0;
        self.total_len = wrapping_add_u64(self.total_len, byte_len as u64);
        while byte_len > 0 {
            if self.buf_len == 0 && byte_len >= 8 {
                let mut w: u64 = 0;
                let mut i: usize = 0;
                while i < 8 {
                    let b = bytes[offset + i] as u64;
                    w = w | (b << (8 * i as u32));
                    i = i + 1;
                }
                self.h = axh_round(self.h, w);
                offset = offset + 8;
                byte_len = byte_len - 8;
            } else {
                let b = bytes[offset] as u64;
                self.buf = self.buf | (b << (8 * self.buf_len as u32));
                self.buf_len = self.buf_len + 1;
                offset = offset + 1;
                byte_len = byte_len - 1;
                if self.buf_len == 8 {
                    self.h = axh_round(self.h, self.buf);
                    self.buf = 0;
                    self.buf_len = 0;
                }
            }
        }
    }

    fn write_u8(self: mut_view<Axh64Hasher>, i: u8) {
        let arr: [1]u8 = [i];
        self.write(view(arr));
    }

    fn write_u16(self: mut_view<Axh64Hasher>, i: u16) {
        let arr: [2]u8 = [i as u8, (i >> 8) as u8];
        self.write(view(arr));
    }

    fn write_u32(self: mut_view<Axh64Hasher>, i: u32) {
        let arr: [4]u8 = [
            i as u8,
            (i >> 8) as u8,
            (i >> 16) as u8,
            (i >> 24) as u8,
        ];
        self.write(view(arr));
    }

    fn write_u64(self: mut_view<Axh64Hasher>, i: u64) {
        let arr: [8]u8 = [
            i as u8,
            (i >> 8) as u8,
            (i >> 16) as u8,
            (i >> 24) as u8,
            (i >> 32) as u8,
            (i >> 40) as u8,
            (i >> 48) as u8,
            (i >> 56) as u8,
        ];
        self.write(view(arr));
    }

    fn write_usize(self: mut_view<Axh64Hasher>, i: usize) {
        self.write_u64(i as u64);
    }

    fn write_i8(self: mut_view<Axh64Hasher>, i: i8) {
        self.write_u8(i as u8);
    }

    fn write_i16(self: mut_view<Axh64Hasher>, i: i16) {
        self.write_u16(i as u16);
    }

    fn write_i32(self: mut_view<Axh64Hasher>, i: i32) {
        self.write_u32(i as u32);
    }

    fn write_i64(self: mut_view<Axh64Hasher>, i: i64) {
        self.write_u64(i as u64);
    }

    fn write_isize(self: mut_view<Axh64Hasher>, i: isize) {
        self.write_u64(i as u64);
    }
}

pub fn hash64(bytes: view<[u8]>) -> u64 {
    let mut h = Axh64Hasher.new();
    h.write(bytes);
    h.finish()
}

// Primitive implementations of Hash
impl Hash for u8 {
    fn hash<H: Hasher>(self: view<u8>, state: mut_view<H>) {
        state.write_u8(*self);
    }
}

impl Hash for u16 {
    fn hash<H: Hasher>(self: view<u16>, state: mut_view<H>) {
        state.write_u16(*self);
    }
}

impl Hash for u32 {
    fn hash<H: Hasher>(self: view<u32>, state: mut_view<H>) {
        state.write_u32(*self);
    }
}

impl Hash for u64 {
    fn hash<H: Hasher>(self: view<u64>, state: mut_view<H>) {
        state.write_u64(*self);
    }
}

impl Hash for usize {
    fn hash<H: Hasher>(self: view<usize>, state: mut_view<H>) {
        state.write_usize(*self);
    }
}

impl Hash for i8 {
    fn hash<H: Hasher>(self: view<i8>, state: mut_view<H>) {
        state.write_i8(*self);
    }
}

impl Hash for i16 {
    fn hash<H: Hasher>(self: view<i16>, state: mut_view<H>) {
        state.write_i16(*self);
    }
}

impl Hash for i32 {
    fn hash<H: Hasher>(self: view<i32>, state: mut_view<H>) {
        state.write_i32(*self);
    }
}

impl Hash for i64 {
    fn hash<H: Hasher>(self: view<i64>, state: mut_view<H>) {
        state.write_i64(*self);
    }
}

impl Hash for isize {
    fn hash<H: Hasher>(self: view<isize>, state: mut_view<H>) {
        state.write_isize(*self);
    }
}

impl Hash for bool {
    fn hash<H: Hasher>(self: view<bool>, state: mut_view<H>) {
        state.write_u8(if *self { 1 } else { 0 });
    }
}

impl Hash for char {
    fn hash<H: Hasher>(self: view<char>, state: mut_view<H>) {
        state.write_u32(*self as u32);
    }
}

fn hash_item<T: Hash, H: Hasher>(item: view<T>, state: mut_view<H>) {
    item.hash(state);
}

// Tuple implementations of Hash (up to arity 4, ADR-0004 §6)
impl<A: Hash, B: Hash> Hash for (A, B) {
    fn hash<H: Hasher>(self: view<(A, B)>, state: mut_view<H>) {
        let (a, b) = *self;
        hash_item(view(a), mut_view(*state));
        hash_item(view(b), mut_view(*state));
    }
}

impl<A: Hash, B: Hash, C: Hash> Hash for (A, B, C) {
    fn hash<H: Hasher>(self: view<(A, B, C)>, state: mut_view<H>) {
        let (a, b, c) = *self;
        hash_item(view(a), mut_view(*state));
        hash_item(view(b), mut_view(*state));
        hash_item(view(c), mut_view(*state));
    }
}

impl<A: Hash, B: Hash, C: Hash, D: Hash> Hash for (A, B, C, D) {
    fn hash<H: Hasher>(self: view<(A, B, C, D)>, state: mut_view<H>) {
        let (a, b, c, d) = *self;
        hash_item(view(a), mut_view(*state));
        hash_item(view(b), mut_view(*state));
        hash_item(view(c), mut_view(*state));
        hash_item(view(d), mut_view(*state));
    }
}

