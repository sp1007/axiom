// test: run
// modes: interp
// stdout: AXH64 VECTORS PASS\n

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(a: u64, b: u32) -> u64 { 0 }

impl u64 {
    fn wrapping_add(self: u64, rhs: u64) -> u64 { wrapping_add_u64(self, rhs) }
    fn wrapping_mul(self: u64, rhs: u64) -> u64 { wrapping_mul_u64(self, rhs) }
    fn rotate_left(self: u64, n: u32) -> u64 { rotate_left_u64(self, n) }
}

const AXH_K1: u64 = 0x9E3779B97F4A7C15;
const AXH_K2: u64 = 0xC2B2AE3D27D4EB4F;
const AXH_K3: u64 = 0x165667B19E3779F9;
const AXH_SEED: u64 = 0x27D4EB2F165667C5;
const AXH_M: u64 = 0x9FB21C651E98DF25;

fn axh_round(h: u64, w: u64) -> u64 {
    let m = (w.wrapping_mul(AXH_K2)).rotate_left(31).wrapping_mul(AXH_K1);
    (h ^ m).rotate_left(27).wrapping_mul(AXH_K1).wrapping_add(AXH_K3)
}

fn axh_fold(h: u64) -> u64 {
    h ^ h.rotate_left(15) ^ h.rotate_left(40)
}

fn axh_avalanche(mut h: u64) -> u64 {
    h = axh_fold(h).wrapping_mul(AXH_M);
    h = axh_fold(h).wrapping_mul(AXH_K2);
    axh_fold(h)
}

struct Axh64Hasher {
    h: u64,
    total_len: u64,
    buf: u64,
    buf_len: usize,
}

impl Axh64Hasher {
    fn new() -> Axh64Hasher {
        Axh64Hasher {
            h: AXH_SEED,
            total_len: 0,
            buf: 0,
            buf_len: 0,
        }
    }

    fn write(self: mut_view<Axh64Hasher>, bytes: view<[u8]>) {
        let mut byte_len = len(bytes);
        let mut offset: usize = 0;
        self.total_len = self.total_len.wrapping_add(byte_len as u64);
        while byte_len > 0 {
            if self.buf_len == 0 && byte_len >= 8 {
                let mut w: u64 = 0;
                let mut i: usize = 0;
                while i < 8 {
                    let b = bytes[offset + i] as u64;
                    w = w | (b << (8 * i as u32));
                    i = i + 1;
                }
                self.h = axh_round(self.h, w);
                offset = offset + 8;
                byte_len = byte_len - 8;
            } else {
                let b = bytes[offset] as u64;
                self.buf = self.buf | (b << (8 * self.buf_len as u32));
                self.buf_len = self.buf_len + 1;
                offset = offset + 1;
                byte_len = byte_len - 1;
                if self.buf_len == 8 {
                    self.h = axh_round(self.h, self.buf);
                    self.buf = 0;
                    self.buf_len = 0;
                }
            }
        }
    }

    fn finish(self: view<Axh64Hasher>) -> u64 {
        let mut h = self.h;
        if self.buf_len > 0 {
            h = axh_round(h, self.buf);
        }
        h = h ^ (self.total_len.wrapping_mul(AXH_K3));
        axh_avalanche(h)
    }
}

fn hash_slice(bytes: view<[u8]>) -> u64 {
    let mut h = Axh64Hasher.new();
    h.write(bytes);
    h.finish()
}

fn main() -> i32 {
    // Vector 1: empty string -> d8e728ed68f180e9
    let empty: [0]u8 = [];
    if hash_slice(view(empty)) != 0xd8e728ed68f180e9 { return 1; }

    // Vector 2: 'a' (0x61) -> da2e93eede955e3f
    let a: [1]u8 = [0x61];
    if hash_slice(view(a)) != 0xda2e93eede955e3f { return 2; }

    // Vector 3: "abc" -> 050282dd1361d4b1
    let abc: [3]u8 = [0x61, 0x62, 0x63];
    if hash_slice(view(abc)) != 0x050282dd1361d4b1 { return 3; }

    // Vector 4: "abcdefgh" -> 6652d639d2991029
    let s8: [8]u8 = [0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68];
    if hash_slice(view(s8)) != 0x6652d639d2991029 { return 4; }

    // Vector 5: "abcdefghi" -> 057bbd81aec67a56
    let s9: [9]u8 = [0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69];
    if hash_slice(view(s9)) != 0x057bbd81aec67a56 { return 5; }

    // Vector 6: "abcdefghijklmnop" -> 3f205fb31c065ba4
    let s16: [16]u8 = [0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x6e, 0x6f, 0x70];
    if hash_slice(view(s16)) != 0x3f205fb31c065ba4 { return 6; }

    // Vector 7: "abcdefghijklmnopq" -> 97091c4287d17ae1
    let s17: [17]u8 = [0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x6e, 0x6f, 0x70, 0x71];
    if hash_slice(view(s17)) != 0x97091c4287d17ae1 { return 7; }

    print("AXH64 VECTORS PASS\n");
    return 0;
}
