    250u8, 1u8, 8u8, 15u8, 22u8, 29u8, 36u8, 43u8, 50u8, 57u8, 64u8, 71u8, 78u8, 85u8, 92u8, 99u8, 106u8, 113u8, 120u8, 127u8, 134u8, 141u8, 148u8, 155u8,
    162u8, 169u8, 176u8, 183u8, 190u8, 197u8, 204u8, 211u8, 218u8, 225u8, 232u8, 239u8, 246u8, 253u8, 4u8, 11u8, 18u8, 25u8, 32u8, 39u8, 46u8, 53u8, 60u8, 67u8,
    74u8, 81u8, 88u8, 95u8, 102u8, 109u8, 116u8, 123u8, 130u8, 137u8, 144u8, 151u8, 158u8, 165u8, 172u8, 179u8, 186u8, 193u8, 200u8, 207u8, 214u8, 221u8, 228u8, 235u8,
    242u8, 249u8, 0u8, 7u8, 14u8, 21u8, 28u8, 35u8, 42u8, 49u8, 56u8, 63u8, 70u8, 77u8, 84u8, 91u8, 98u8, 105u8, 112u8, 119u8, 126u8, 133u8, 140u8, 147u8,
    154u8, 161u8, 168u8, 175u8, 182u8, 189u8, 196u8, 203u8, 210u8, 217u8, 224u8, 231u8, 238u8, 245u8, 252u8, 0u8,
];

const OFFS: [47]usize = [
    0, 0, 1, 2, 3, 11, 19, 28, 36, 39, 43, 51, 55, 56, 58, 61,
    65, 70, 76, 83, 91, 100, 115, 131, 148, 170, 172, 175, 179, 192, 210, 253,
    260, 268, 277, 292, 308, 325, 356, 388, 421, 484, 548, 648, 903, 1159, 2159,
];

const LENS: [47]usize = [
    0, 1, 1, 1, 8, 8, 9, 8, 3, 4, 8, 4, 1, 2, 3, 4,
    5, 6, 7, 8, 9, 15, 16, 17, 22, 2, 3, 4, 13, 18, 43, 7,
    8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 100, 255, 256, 1000, 1024,
];

const HASHES: [47]u64 = [
    0xd8e728ed68f180e9u64, 0x9b0aa44703999ce9u64, 0x7bd8c8db00ba159bu64, 0xda2e93eede955e3fu64,
    0x27d47dffbbeb41a6u64, 0x4cca3b46089ed29fu64, 0x5452c40eb3aa4464u64, 0x56a08fc1e2b70901u64,
    0x60a13d49a0eeefbbu64, 0xe63d56126869a740u64, 0x078b539bc05a6987u64, 0x9c51ebe90fbb1bd5u64,
    0xda2e93eede955e3fu64, 0x5199b5958ca5a44bu64, 0x050282dd1361d4b1u64, 0x98655b30fe5d02e0u64,
    0x2a8fbd34ba79cee7u64, 0x2c28603821afc185u64, 0x19bf41d245cdc11fu64, 0x6652d639d2991029u64,
    0x057bbd81aec67a56u64, 0x52ba651b7cbf139cu64, 0x3f205fb31c065ba4u64, 0x97091c4287d17ae1u64,
    0x16eba03f96175a8du64, 0x0efde65d160f7192u64, 0x237abc3c351231e8u64, 0xc659e366791042acu64,
    0x5824b52ecea5b7e7u64, 0xd25ee43a12416513u64, 0x506faa2b66e3f56du64, 0xc8c1b1ddd4146c83u64,
    0x19b354231011b408u64, 0xfbf281c58ca5b263u64, 0x2519c233ce4695bau64, 0x797d67ca4ded94f6u64,
    0x8764e0154edd5486u64, 0xcc5248d20581985eu64, 0x3f902646bc6f0aa5u64, 0x9df0ced747195339u64,
    0x411f38841b94d098u64, 0xee7e7166abb49686u64, 0x5c4db8a51519ed84u64, 0x5cec5e0323f53e92u64,
    0xbcb689d910bf6d0au64, 0x1c7cf9248ed9c79du64, 0xca51dd4ea6620644u64,
];

fn main() -> i32 {
    // view() of a const table is rejected by the capability check, so the keys are copied to a local array
    let keys: [3184]u8 = KEYS;
    let all: view<[u8]> = view(keys);
    let mut i: usize = 0;
    while i < 47 {
        let off = OFFS[i];
        let n = LENS[i];
        let whole = all[off..off + n];
        if hash64(whole) != HASHES[i] { return (i + 1) as i32; }
        // the same key written in two parts, split at every position (short keys only)
        let mut k: usize = 0;
        while n <= 40 && k <= n {
            let first = all[off..off + k];
            let second = all[off + k..off + n];
            let mut h = Axh64Hasher.new();
            h.write(first);
            h.write(second);
            if h.finish() != HASHES[i] { return (100 + i) as i32; }
            k = k + 1;
        }
        i = i + 1;
    }
    // typed writers against the Python reference (little-endian bytes)
    let mut t0 = Axh64Hasher.new();
    t0.write_u8(0x07u8);
    if t0.finish() != 0x0cb80c5180bcae5fu64 { return 201; }
    let mut t1 = Axh64Hasher.new();
    t1.write_u16(0x0201u16);
    if t1.finish() != 0xe4cc4b87d1ee17a2u64 { return 202; }
    let mut t2 = Axh64Hasher.new();
    t2.write_u32(0x04030201u32);
    if t2.finish() != 0xd548b0df69d394f3u64 { return 203; }
    let mut t3 = Axh64Hasher.new();
    t3.write_u64(0x0807060504030201u64);
    if t3.finish() != 0x56a08fc1e2b70901u64 { return 204; }
    let mut t4 = Axh64Hasher.new();
    t4.write_i32(-1i32);
    if t4.finish() != 0x5b820a24adffacbbu64 { return 205; }
    let mut t5 = Axh64Hasher.new();
    t5.write_usize(7usize);
    if t5.finish() != 0x078b539bc05a6987u64 { return 206; }
    print("AXH64 VECTORS PASS\n");
    0
}
