// test: run
// exit: 0
// stdout: hash ok a abc\n
// Was (T069): a pin of the old driver limitation that only option/result/prelude were loaded, so
// `use std.core.hash` reported AX_NAME_UNRESOLVED_IMPORT. Since T423h (ADR-0048) a non-prelude std module is
// loaded on demand from the std root: `use std.core.hash` resolves (module import, then `hash.hash64`).
// Expected hashes come from tests/unit/kernel/hash_vectors.txt (AXH64 v1, generated by gen_hash_vectors.py):
//   da2e93eede955e3f text a      050282dd1361d4b1 text abc
// Runs in the interpreter and natively (-O0 and -O1).

use std.core.hash

fn main() -> i32 {
    let a: [1]u8 = [97u8];
    let abc: [3]u8 = [97u8, 98u8, 99u8];
    let ha: u64 = hash.hash64(a[0..1]);
    let habc: u64 = hash.hash64(abc[0..3]);
    if ha != 0xda2e93eede955e3fu64 {
        return 1;
    }
    if habc != 0x050282dd1361d4b1u64 {
        return 2;
    }
    print("hash ok a abc\n");
    0
}
