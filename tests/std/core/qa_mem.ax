// test: run
// stdout: MEM OK\n

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

unsafe fn swap<T>(a: mut_view<T>, b: mut_view<T>) {
    let pa = address_of_mut(*a);
    let pb = address_of_mut(*b);
    let mut tmp: [1]T = [*a];
    let ptmp = address_of_mut(tmp[0]);
    ptr_copy_nonoverlapping(pa as *const T, ptmp, 1);
    ptr_copy_nonoverlapping(pb as *const T, pa, 1);
    ptr_copy_nonoverlapping(ptmp as *const T, pb, 1);
}

unsafe fn replace<T>(dest: mut_view<T>, src: T) -> T {
    let old = *dest;
    *dest = src;
    old
}

fn main() -> i32 {
    let mut x: i64 = 100;
    let mut y: i64 = 200;
    unsafe {
        swap(mut_view(x), mut_view(y));
    }
    if x != 200 { return 1; }
    if y != 100 { return 2; }

    let old = unsafe { replace(mut_view(x), 999i64) };
    if old != 200 { return 3; }
    if x != 999 { return 4; }

    print("MEM OK\n");
    return 0;
}
