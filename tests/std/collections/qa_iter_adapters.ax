// test: run
// stdout: OK IterAdapters\n

use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct VecI32 {
    pub ptr: *mut i32,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

pub fn vec_i32_new() -> VecI32 {
    VecI32 {
        ptr: 0 as *mut i32,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn vec_i32_push(v: mut_view<VecI32>, val: i32) {
    if v.len == v.cap {
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        let raw = unsafe { heap_alloc(new_cap * 4, 4) };
        let new_ptr = raw as *mut i32;
        if v.len > 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * 4);
                heap_free(v.ptr as *mut u8, v.cap * 4, 4);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        *(v.ptr + v.len) = val;
    }
    v.len = v.len + 1;
}

pub fn vec_i32_free(v: mut_view<VecI32>) {
    if v.cap > 0 && v.ptr as usize != 0 {
        unsafe {
            heap_free(v.ptr as *mut u8, v.cap * 4, 4);
        }
        v.ptr = 0 as *mut i32;
        v.len = 0;
        v.cap = 0;
    }
}

pub struct VecIterI32 {
    pub ptr: *const i32,
    pub len: usize,
    pub idx: usize,
}

pub fn vec_iter_i32(v: view<VecI32>) -> VecIterI32 {
    VecIterI32 {
        ptr: v.ptr as *const i32,
        len: v.len,
        idx: 0,
    }
}

pub fn vec_iter_next_i32(it: mut_view<VecIterI32>) -> Option<i32> {
    if it.idx >= it.len {
        Option.None
    } else {
        let p = unsafe { it.ptr + it.idx };
        it.idx = it.idx + 1;
        Option.Some(unsafe { *p })
    }
}

pub struct MapI32 {
    pub iter: VecIterI32,
    pub f: fn(i32) -> i32,
}

impl MapI32 {
    pub fn next(self: mut_view<MapI32>) -> Option<i32> {
        if self.iter.idx >= self.iter.len {
            Option.None
        } else {
            let p = unsafe { self.iter.ptr + self.iter.idx };
            self.iter.idx = self.iter.idx + 1;
            let func = self.f;
            Option.Some(func(unsafe { *p }))
        }
    }
}

pub struct FilterI32 {
    pub iter: VecIterI32,
    pub pred: fn(i32) -> bool,
}

impl FilterI32 {
    pub fn next(self: mut_view<FilterI32>) -> Option<i32> {
        while self.iter.idx != self.iter.len {
            let p = unsafe { self.iter.ptr + self.iter.idx };
            self.iter.idx = self.iter.idx + 1;
            let val = unsafe { *p };
            let predicate = self.pred;
            if predicate(val) {
                return Option.Some(val);
            }
        }
        Option.None
    }
}

pub struct EnumerateItemI32 {
    pub index: usize,
    pub item: i32,
}

pub struct EnumerateI32 {
    pub iter: VecIterI32,
    pub cur_index: usize,
}

impl EnumerateI32 {
    pub fn next(self: mut_view<EnumerateI32>) -> Option<EnumerateItemI32> {
        if self.iter.idx >= self.iter.len {
            Option.None
        } else {
            let p = unsafe { self.iter.ptr + self.iter.idx };
            self.iter.idx = self.iter.idx + 1;
            let idx = self.cur_index;
            self.cur_index = self.cur_index + 1;
            Option.Some(EnumerateItemI32 {
                index: idx,
                item: unsafe { *p },
            })
        }
    }
}

pub struct ZipItemI32 {
    pub first: i32,
    pub second: i32,
}

pub struct ZipI32 {
    pub a: VecIterI32,
    pub b: VecIterI32,
}

impl ZipI32 {
    pub fn next(self: mut_view<ZipI32>) -> Option<ZipItemI32> {
        if self.a.idx >= self.a.len || self.b.idx >= self.b.len {
            Option.None
        } else {
            let pa = unsafe { self.a.ptr + self.a.idx };
            let pb = unsafe { self.b.ptr + self.b.idx };
            self.a.idx = self.a.idx + 1;
            self.b.idx = self.b.idx + 1;
            Option.Some(ZipItemI32 {
                first: unsafe { *pa },
                second: unsafe { *pb },
            })
        }
    }
}

fn test_vec_iteration() -> i32 {
    let mut v = vec_i32_new();
    vec_i32_push(mut_view(v), 10);
    vec_i32_push(mut_view(v), 20);
    vec_i32_push(mut_view(v), 30);
    vec_i32_push(mut_view(v), 40);

    let mut it = vec_iter_i32(view(v));
    let mut sum: i32 = 0;
    let mut count: usize = 0;

    let mut done = false;
    while !done {
        match vec_iter_next_i32(mut_view(it)) {
            Option.Some(x) => {
                sum = sum + x;
                count = count + 1;
            },
            Option.None => {
                done = true;
            }
        }
    }

    if count != 4 { return 1; }
    if sum != 100 { return 2; }

    vec_i32_free(mut_view(v));
    0
}

fn double_val(x: i32) -> i32 {
    x * 2
}

fn is_gt_25(x: i32) -> bool {
    x > 25
}

fn test_map_and_collect() -> i32 {
    let mut v = vec_i32_new();
    vec_i32_push(mut_view(v), 10);
    vec_i32_push(mut_view(v), 20);
    vec_i32_push(mut_view(v), 30);
    vec_i32_push(mut_view(v), 40);

    let it = vec_iter_i32(view(v));
    let mut m = MapI32 { iter: it, f: double_val };
    let mut mapped = vec_i32_new();
    let mut done = false;
    while !done {
        match m.next() {
            Option.Some(val) => {
                vec_i32_push(mut_view(mapped), val);
            },
            Option.None => {
                done = true;
            }
        }
    }

    if mapped.len != 4 { return 10; }
    if unsafe { *mapped.ptr } != 20 { return 11; }
    if unsafe { *(mapped.ptr + 1) } != 40 { return 12; }
    if unsafe { *(mapped.ptr + 2) } != 60 { return 13; }
    if unsafe { *(mapped.ptr + 3) } != 80 { return 14; }

    vec_i32_free(mut_view(v));
    vec_i32_free(mut_view(mapped));
    0
}

fn test_filter_and_collect() -> i32 {
    let mut v = vec_i32_new();
    vec_i32_push(mut_view(v), 10);
    vec_i32_push(mut_view(v), 20);
    vec_i32_push(mut_view(v), 30);
    vec_i32_push(mut_view(v), 40);

    let it = vec_iter_i32(view(v));
    let mut f = FilterI32 { iter: it, pred: is_gt_25 };
    let mut filtered = vec_i32_new();
    let mut done = false;
    while !done {
        match f.next() {
            Option.Some(val) => {
                vec_i32_push(mut_view(filtered), val);
            },
            Option.None => {
                done = true;
            }
        }
    }

    if filtered.len != 2 { return 20; }
    if unsafe { *filtered.ptr } != 30 { return 21; }
    if unsafe { *(filtered.ptr + 1) } != 40 { return 22; }

    vec_i32_free(mut_view(v));
    vec_i32_free(mut_view(filtered));
    0
}

fn test_enumerate_adapter() -> i32 {
    let mut v = vec_i32_new();
    vec_i32_push(mut_view(v), 10);
    vec_i32_push(mut_view(v), 20);
    vec_i32_push(mut_view(v), 30);

    let it = vec_iter_i32(view(v));
    let mut en = EnumerateI32 { iter: it, cur_index: 0 };

    match en.next() {
        Option.Some(item) => {
            if item.index != 0 || item.item != 10 { return 30; }
        },
        Option.None => { return 31; }
    }
    match en.next() {
        Option.Some(item) => {
            if item.index != 1 || item.item != 20 { return 32; }
        },
        Option.None => { return 33; }
    }
    match en.next() {
        Option.Some(item) => {
            if item.index != 2 || item.item != 30 { return 34; }
        },
        Option.None => { return 35; }
    }
    let last = en.next();
    match last {
        Option.Some(item) => { return 36; },
        Option.None => {
            vec_i32_free(mut_view(v));
            0
        }
    }
}

fn test_zip_adapter() -> i32 {
    let mut va = vec_i32_new();
    vec_i32_push(mut_view(va), 10);
    vec_i32_push(mut_view(va), 20);
    vec_i32_push(mut_view(va), 30);

    let mut vb = vec_i32_new();
    vec_i32_push(mut_view(vb), 1);
    vec_i32_push(mut_view(vb), 2);
    vec_i32_push(mut_view(vb), 3);
    vec_i32_push(mut_view(vb), 4); // vb is longer

    let ita = vec_iter_i32(view(va));
    let itb = vec_iter_i32(view(vb));
    let mut z = ZipI32 { a: ita, b: itb };

    match z.next() {
        Option.Some(pair) => {
            if pair.first != 10 || pair.second != 1 { return 40; }
        },
        Option.None => { return 41; }
    }
    match z.next() {
        Option.Some(pair) => {
            if pair.first != 20 || pair.second != 2 { return 42; }
        },
        Option.None => { return 43; }
    }
    match z.next() {
        Option.Some(pair) => {
            if pair.first != 30 || pair.second != 3 { return 44; }
        },
        Option.None => { return 45; }
    }
    // Must terminate because va has ended
    let last = z.next();
    match last {
        Option.Some(pair) => { return 46; },
        Option.None => {
            vec_i32_free(mut_view(va));
            vec_i32_free(mut_view(vb));
            0
        }
    }
}

fn main() -> i32 {
    let rc1 = test_vec_iteration();
    if rc1 != 0 { return rc1; }

    let rc2 = test_map_and_collect();
    if rc2 != 0 { return rc2; }

    let rc3 = test_filter_and_collect();
    if rc3 != 0 { return rc3; }

    let rc4 = test_enumerate_adapter();
    if rc4 != 0 { return rc4; }

    let rc5 = test_zip_adapter();
    if rc5 != 0 { return rc5; }

    print("OK IterAdapters\n");
    0
}
