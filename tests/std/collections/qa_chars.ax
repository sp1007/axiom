// test: run
// modes: native
// stdout: OK Chars\n

use std.core.option.Option
use std.core.result.Result

@lang("Iterator")
pub trait Iterator {
    type Item;
    fn next(self: mut_view<Self>) -> Option<Self.Item>;
}

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

fn get_str_len(s: view<Str>) -> usize {
    len(*s)
}

@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn get_str_byte(s: view<Str>, idx: usize) -> u8 {
    let p = unsafe { address_of(*s) };
    let bytes_ptr = unsafe { *(p as *const *const u8) };
    unsafe { *(bytes_ptr + idx) }
}

pub fn decode_str_char_at(s: view<Str>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = get_str_len(s);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = get_str_byte(s, offset);
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = get_str_byte(s, offset + 1);
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = get_str_byte(s, offset + 1);
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = get_str_byte(s, offset + 2);
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = get_str_byte(s, offset + 1);
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = get_str_byte(s, offset + 2);
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = get_str_byte(s, offset + 3);
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub struct Chars {
    pub s: Str,
    pub offset: usize,
}

impl Iterator for Chars {
    type Item = char;
    fn next(self: mut_view<Chars>) -> Option<char> {
        let n = get_str_len(view(self.s));
        if self.offset >= n {
            return Option.None;
        }
        match decode_str_char_at(view(self.s), self.offset) {
            Result.Ok(res) => {
                self.offset = self.offset + res.len;
                Option.Some(res.ch)
            },
            Result.Err(e) => {
                self.offset = self.offset + 1;
                Option.Some('\u{FFFD}')
            }
        }
    }
}

impl Chars {
    pub fn count(self: Chars) -> usize {
        let mut cnt: usize = 0;
        let mut cur = self;
        for c in cur {
            cnt = cnt + 1;
        }
        cnt
    }
}

pub struct CharIndex {
    pub index: usize,
    pub ch: char,
}

pub struct CharIndices {
    pub s: Str,
    pub offset: usize,
}

impl Iterator for CharIndices {
    type Item = CharIndex;
    fn next(self: mut_view<CharIndices>) -> Option<CharIndex> {
        let n = get_str_len(view(self.s));
        if self.offset >= n {
            return Option.None;
        }
        let cur_offset = self.offset;
        match decode_str_char_at(view(self.s), cur_offset) {
            Result.Ok(res) => {
                self.offset = cur_offset + res.len;
                Option.Some(CharIndex { index: cur_offset, ch: res.ch })
            },
            Result.Err(e) => {
                self.offset = cur_offset + 1;
                Option.Some(CharIndex { index: cur_offset, ch: '\u{FFFD}' })
            }
        }
    }
}

impl Str {
    pub fn chars(self: view<Str>) -> Chars {
        Chars { s: *self, offset: 0 }
    }

    pub fn char_indices(self: view<Str>) -> CharIndices {
        CharIndices { s: *self, offset: 0 }
    }
}

fn test_chars_count_acceptance() -> i32 {
    let s = "Xin chào thế giới";
    let cnt = s.chars().count();
    if cnt != 17 {
        return 1;
    }
    0
}

fn test_char_indices_boundaries() -> i32 {
    let s = "Xin chào thế giới";
    let mut expected_offsets: [17]usize = [
        0, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12, 15, 16, 17, 18, 21
    ];
    let mut expected_chars: [17]char = [
        'X', 'i', 'n', ' ', 'c', 'h', 'à', 'o', ' ', 't', 'h', 'ế', ' ', 'g', 'i', 'ớ', 'i'
    ];
    let mut idx: usize = 0;
    for ci in s.char_indices() {
        if idx >= 17 {
            return 2;
        }
        if ci.index != expected_offsets[idx] {
            return 3;
        }
        if ci.ch != expected_chars[idx] {
            return 4;
        }
        idx = idx + 1;
    }
    if idx != 17 {
        return 5;
    }
    0
}

fn test_empty_string() -> i32 {
    let s = "";
    if s.chars().count() != 0 {
        return 6;
    }
    let mut idx: usize = 0;
    for ci in s.char_indices() {
        idx = idx + 1;
    }
    if idx != 0 {
        return 7;
    }
    0
}

fn test_ascii_and_multibyte() -> i32 {
    let s = "Axiom 🦀 2026";
    // 'A' (1), 'x' (1), 'i' (1), 'o' (1), 'm' (1), ' ' (1), '🦀' (4), ' ' (1), '2' (1), '0' (1), '2' (1), '6' (1)
    // total chars = 12
    if s.chars().count() != 12 {
        return 8;
    }
    let mut count: usize = 0;
    let mut crab_offset: usize = 0;
    for ci in s.char_indices() {
        if ci.ch == '🦀' {
            crab_offset = ci.index;
        }
        count = count + 1;
    }
    if count != 12 {
        return 9;
    }
    if crab_offset != 6 {
        return 10;
    }
    0
}

fn main() -> i32 {
    let r1 = test_chars_count_acceptance();
    if r1 != 0 { return r1; }

    let r2 = test_char_indices_boundaries();
    if r2 != 0 { return r2; }

    let r3 = test_empty_string();
    if r3 != 0 { return r3; }

    let r4 = test_ascii_and_multibyte();
    if r4 != 0 { return r4; }

    print("OK Chars\n");
    0
}
