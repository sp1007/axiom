// test: run
// stdout: Drop Box: 30\nDrop Box: 20\nDrop Box: 10\nVec dropped\n

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct Box<T> {
    pub ptr: *mut T,
    _glue: DropGlue,
}

impl<T> Drop for Box<T> {
    fn drop(self: mut_view<Box>) {
        if self.ptr as usize != 0 {
            let val = unsafe { *(self.ptr as *mut i32) };
            if val == 10 {
                print("Drop Box: 10\n");
            } else if val == 20 {
                print("Drop Box: 20\n");
            } else if val == 30 {
                print("Drop Box: 30\n");
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, sz, al);
            }
            self.ptr = 0 as *mut T;
        }
    }
}

pub struct Vec<T> {
    pub ptr: *mut T,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl<T> Drop for Vec<T> {
    fn drop(self: mut_view<Vec>) {
        if self.ptr as usize != 0 {
            print("Vec dropped\n");
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, self.cap * sz, al);
            }
            self.ptr = 0 as *mut T;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn make_box(val: i32) -> Box<i32> {
    let sz = size_of<i32>();
    let al = align_of<i32>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut i32;
    unsafe {
        *p = val;
    }
    Box<i32> { ptr: p, _glue: DropGlue {} }
}

pub fn push_box(v: mut_view<Vec<Box<i32>>>, b: Box<i32>) {
    if v.len == v.cap {
        let needed = v.len + 1;
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let sz = size_of<Box<i32>>();
        let al = align_of<Box<i32>>();
        let raw = unsafe { heap_alloc(new_cap * sz, al) };
        let new_ptr = raw as *mut Box<i32>;
        if v.len > 0 && v.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * sz);
                heap_free(v.ptr as *mut u8, v.cap * sz, al);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        let p = v.ptr + v.len;
        *p = b;
    }
    v.len = v.len + 1;
}

pub fn clear_boxes(v: mut_view<Vec<Box<i32>>>) {
    while v.len > 0 {
        v.len = v.len - 1;
        let p = unsafe { v.ptr + v.len };
        let mut b = unsafe { *p };
    }
}

fn test_vec_box() {
    let mut v = Vec<Box<i32>> {
        ptr: 0 as *mut Box<i32>,
        len: 0 as usize,
        cap: 0 as usize,
        _glue: DropGlue {},
    };

    push_box(mut_view(v), make_box(10));
    push_box(mut_view(v), make_box(20));
    push_box(mut_view(v), make_box(30));

    clear_boxes(mut_view(v));
}

fn main() -> i32 {
    test_vec_box();
    return 0;
}
