// test: run
// stdout: OK Vec\n

use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct Vec<T> {
    pub ptr: *mut T,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl<T> Drop for Vec<T> {
    fn drop(self: mut_view<Vec>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                let mut i: usize = 0;
                while i < self.len {
                    unsafe {
                        drop_in_place<T>(self.ptr + i);
                    }
                    i = i + 1;
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, self.cap * sz, al);
            }
            self.ptr = 0 as *mut T;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn vec_new() -> Vec {
    Vec {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn vec_with_capacity(capacity: usize) -> Vec {
    if capacity == 0 {
        return Vec {
            ptr: 0 as *mut u8,
            len: 0,
            cap: 0,
            _glue: DropGlue {},
        };
    }
    let sz = 8;
    let al = 8;
    let raw = unsafe { heap_alloc(capacity * sz, al) };
    Vec {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
        _glue: DropGlue {},
    }
}

pub fn push_i32(v: mut_view<Vec<i32>>, val: i32) {
    if v.len == v.cap {
        let needed = v.len + 1;
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let sz = size_of<i32>();
        let al = align_of<i32>();
        let raw = unsafe { heap_alloc(new_cap * sz, al) };
        let new_ptr = raw as *mut i32;
        if v.len > 0 && v.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * sz);
                heap_free(v.ptr as *mut u8, v.cap * sz, al);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        let p = v.ptr + v.len;
        *p = val;
    }
    v.len = v.len + 1;
}

pub fn pop_i32(v: mut_view<Vec<i32>>) -> Option {
    if v.len == 0 {
        return Option.None;
    }
    v.len = v.len - 1;
    let p = unsafe { v.ptr + v.len };
    let val = unsafe { *p };
    Option.Some(val)
}

pub fn clear_i32(v: mut_view<Vec<i32>>) {
    v.len = 0;
}

fn test_vec_ops() -> i32 {
    let mut v = Vec<i32> { ptr: 0 as *mut i32, len: 0 as usize, cap: 0 as usize, _glue: DropGlue {} };
    if v.len != 0 || v.cap != 0 {
        return 11;
    }

    // Push 10 elements to trigger growth: 0 -> 4 -> 8 -> 16
    let mut i: i32 = 0;
    while i < 10 {
        push_i32(mut_view(v), i * 10);
        i = i + 1;
    }

    if v.len != 10 {
        return 12;
    }
    if 10 > v.cap {
        return 13;
    }

    // Verify elements
    let mut j: usize = 0;
    while j < 10 {
        let expected = (j * 10) as i32;
        let actual = unsafe { *(v.ptr + j) };
        if actual != expected {
            return 14;
        }
        j = j + 1;
    }

    // Mutate an element
    unsafe {
        *(v.ptr + 5) = 999;
    }
    if unsafe { *(v.ptr + 5) } != 999 {
        return 15;
    }

    // Pop elements back
    let last = pop_i32(mut_view(v));
    match last {
        Option.Some(val) => {
            if val != 90 {
                return val;
            }
        }
        Option.None => {
            return 17;
        }
    }

    if v.len != 9 {
        return 18;
    }

    // Clear vector
    clear_i32(mut_view(v));
    if v.len != 0 {
        return 19;
    }

    // With capacity test
    let raw2 = unsafe { heap_alloc(32 * size_of<i32>(), align_of<i32>()) };
    let mut v2 = Vec<i32> { ptr: raw2 as *mut i32, len: 0 as usize, cap: 32 as usize, _glue: DropGlue {} };
    if v2.cap != 32 || v2.len != 0 {
        return 20;
    }
    push_i32(mut_view(v2), 777);
    if v2.len != 1 || unsafe { *v2.ptr } != 777 {
        return 21;
    }

    0
}

fn main() -> i32 {
    let rc = test_vec_ops();
    if rc != 0 {
        return rc;
    }
    print("OK Vec\n");
    return 0;
}
