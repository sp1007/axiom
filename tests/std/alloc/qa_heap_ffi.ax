// test: run
// modes: native
// reason: direct FFI is native-only (ADR-0002)

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

fn main() -> i32 {
    let h = unsafe { GetProcessHeap() };
    if h as usize == 0 {
        return 1;
    }

    let p = unsafe { HeapAlloc(h, 8u32, 64) };
    if p as usize == 0 {
        return 2;
    }

    unsafe {
        let mut i: usize = 0;
        while i < 64 {
            *(p + i) = (i + 10) as u8;
            i = i + 1;
        }
    }

    let p2 = unsafe { HeapReAlloc(h, 8u32, p, 128) };
    if p2 as usize == 0 {
        return 3;
    }

    unsafe {
        let mut i: usize = 0;
        while i < 64 {
            if *(p2 + i) != (i + 10) as u8 {
                return 4;
            }
            i = i + 1;
        }
        HeapFree(h, 0u32, p2);
    }

    return 0;
}
