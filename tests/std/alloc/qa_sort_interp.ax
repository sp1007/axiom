// test: run
// modes: interp
// stdout: OK Stable Sort 2k\n

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct Item {
    key: i32,
    original_idx: i32,
}

fn sort_items(src: *mut Item, n: usize) -> i32 {
    if n <= 1 {
        return 0;
    }
    let sz = size_of<Item>();
    let al = align_of<Item>();
    let raw = unsafe { heap_alloc(n * sz, al) };
    let tmp = raw as *mut Item;

    let mut width: usize = 1;
    while width < n {
        let mut i: usize = 0;
        while i < n {
            let start = i;
            let mid = if i + width < n { i + width } else { n };
            let end = if i + 2 * width < n { i + 2 * width } else { n };

            let mut left = start;
            let mut right = mid;
            let mut k = start;

            unsafe {
                while left < mid && right < end {
                    let plef = src + left;
                    let prig = src + right;
                    if (*plef).key <= (*prig).key {
                        *(tmp + k) = *plef;
                        left = left + 1;
                    } else {
                        *(tmp + k) = *prig;
                        right = right + 1;
                    }
                    k = k + 1;
                }
                while left < mid {
                    *(tmp + k) = *(src + left);
                    left = left + 1;
                    k = k + 1;
                }
                while right < end {
                    *(tmp + k) = *(src + right);
                    right = right + 1;
                    k = k + 1;
                }
                let seg_count = end - start;
                ptr_copy_nonoverlapping<u8>((tmp + start) as *const u8, (src + start) as *mut u8, seg_count * sz);
            }

            i = i + 2 * width;
        }
        width = width * 2;
    }

    unsafe {
        heap_free(raw, n * sz, al);
    }
    0
}

fn main() -> i32 {
    let n: usize = 2000;
    let sz = size_of<Item>();
    let al = align_of<Item>();
    let raw = unsafe { heap_alloc(n * sz, al) };
    let arr = raw as *mut Item;

    // Generate 2000 items with duplicate keys in range [0, 49]
    let mut seed: i64 = 123456789;
    let mut i: usize = 0;
    while i < n {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff;
        let k = (seed % 50) as i32;
        unsafe {
            *(arr + i) = Item {
                key: k,
                original_idx: i as i32,
            };
        }
        i = i + 1;
    }

    sort_items(arr, n);

    // Verify sort correctness and stability
    let mut valid = true;
    let mut idx: usize = 0;
    while idx + 1 < n {
        let cur = unsafe { *(arr + idx) };
        let next = unsafe { *(arr + (idx + 1)) };

        // 1. Sorted order check
        if cur.key > next.key {
            valid = false;
            break;
        }

        // 2. Stability check: if keys are equal, original_idx must be strictly increasing
        if cur.key == next.key && cur.original_idx >= next.original_idx {
            valid = false;
            break;
        }

        idx = idx + 1;
    }

    unsafe {
        heap_free(raw, n * sz, al);
    }

    if !valid {
        return 1;
    }

    print("OK Stable Sort 2k\n");
    return 0;
}
