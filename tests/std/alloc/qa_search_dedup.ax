// test: run
// stdout: OK Search Dedup\n

use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

fn binary_search_by_i64(ptr: *const i64, n: usize, target: i64) -> i64 {
    let mut low: usize = 0;
    let mut high: usize = n;
    while low < high {
        let mid = low + (high - low) / 2;
        let val = unsafe { *(ptr + mid) };
        if val < target {
            low = mid + 1;
        } else if val > target {
            high = mid;
        } else {
            return mid as i64;
        }
    }
    // Return negative encoded insertion point: -(low + 1)
    -((low as i64) + 1)
}

fn dedup_slice_i64(ptr: *mut i64, n: usize) -> usize {
    if n <= 1 {
        return n;
    }
    let mut write_idx: usize = 1;
    let mut read_idx: usize = 1;
    while read_idx < n {
        let prev = unsafe { *(ptr + (write_idx - 1)) };
        let curr = unsafe { *(ptr + read_idx) };
        if prev != curr {
            if write_idx != read_idx {
                unsafe {
                    *(ptr + write_idx) = curr;
                }
            }
            write_idx = write_idx + 1;
        }
        read_idx = read_idx + 1;
    }
    write_idx
}

fn main() -> i32 {
    let sz = size_of<i64>() as i64;
    let al = align_of<i64>();

    // Test 1: Binary Search
    let n_search: usize = 5;
    let raw1 = unsafe { heap_alloc(((n_search as i64) * sz) as usize, al) };
    let arr1 = raw1 as *mut i64;

    unsafe {
        *(arr1 + 0) = 10;
        *(arr1 + 1) = 20;
        *(arr1 + 2) = 30;
        *(arr1 + 3) = 40;
        *(arr1 + 4) = 50;
    }

    // Found cases:
    if binary_search_by_i64(arr1 as *const i64, n_search, 10) != 0 { return 1; }
    if binary_search_by_i64(arr1 as *const i64, n_search, 30) != 2 { return 2; }
    if binary_search_by_i64(arr1 as *const i64, n_search, 50) != 4 { return 3; }

    // Missing cases:
    // 5 -> insert at 0 -> -1
    if binary_search_by_i64(arr1 as *const i64, n_search, 5) != -1 { return 4; }
    // 25 -> insert at 2 -> -3
    if binary_search_by_i64(arr1 as *const i64, n_search, 25) != -3 { return 5; }
    // 60 -> insert at 5 -> -6
    if binary_search_by_i64(arr1 as *const i64, n_search, 60) != -6 { return 6; }

    unsafe {
        heap_free(raw1, ((n_search as i64) * sz) as usize, al);
    }

    // Test 2: Dedup
    let n_dedup: usize = 10;
    let raw2 = unsafe { heap_alloc(((n_dedup as i64) * sz) as usize, al) };
    let arr2 = raw2 as *mut i64;

    // Elements: [10, 10, 20, 30, 30, 30, 40, 50, 50, 60]
    unsafe {
        *(arr2 + 0) = 10;
        *(arr2 + 1) = 10;
        *(arr2 + 2) = 20;
        *(arr2 + 3) = 30;
        *(arr2 + 4) = 30;
        *(arr2 + 5) = 30;
        *(arr2 + 6) = 40;
        *(arr2 + 7) = 50;
        *(arr2 + 8) = 50;
        *(arr2 + 9) = 60;
    }

    let new_len = dedup_slice_i64(arr2, n_dedup);
    if new_len != 6 { return 7; }

    // Check unique elements: [10, 20, 30, 40, 50, 60]
    let e0 = unsafe { *(arr2 + 0) };
    let e1 = unsafe { *(arr2 + 1) };
    let e2 = unsafe { *(arr2 + 2) };
    let e3 = unsafe { *(arr2 + 3) };
    let e4 = unsafe { *(arr2 + 4) };
    let e5 = unsafe { *(arr2 + 5) };

    if e0 != 10 { return 8; }
    if e1 != 20 { return 9; }
    if e2 != 30 { return 10; }
    if e3 != 40 { return 11; }
    if e4 != 50 { return 12; }
    if e5 != 60 { return 13; }

    unsafe {
        heap_free(raw2, ((n_dedup as i64) * sz) as usize, al);
    }

    print("OK Search Dedup\n");
    return 0;
}
