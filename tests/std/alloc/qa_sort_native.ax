// test: run
// modes: native
// reason: heavy test (>= 100k elements) has small interp twin qa_sort_interp.ax
// stdout: OK Stable Sort 100k\n

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

struct Item {
    key: i64,
    original_idx: i64,
}

fn sort_items(h: *mut u8, src: *mut Item, n: usize) -> i32 {
    if n <= 1 {
        return 0;
    }
    let sz = size_of<Item>() as i64;
    let total_bytes = ((n as i64) * sz) as usize;
    let raw = unsafe { HeapAlloc(h, 8u32, total_bytes) };
    let tmp = raw as *mut Item;

    let mut width: usize = 1;
    while width < n {
        let double_width = width + width;
        let mut i: usize = 0;
        while i < n {
            let start = i;
            let mid = if i + width < n { i + width } else { n };
            let end = if i + double_width < n { i + double_width } else { n };

            let mut left = start;
            let mut right = mid;
            let mut k = start;

            unsafe {
                while left < mid && right < end {
                    let plef = src + left;
                    let prig = src + right;
                    if (*plef).key <= (*prig).key {
                        *(tmp + k) = *plef;
                        left = left + 1;
                    } else {
                        *(tmp + k) = *prig;
                        right = right + 1;
                    }
                    k = k + 1;
                }
                while left < mid {
                    *(tmp + k) = *(src + left);
                    left = left + 1;
                    k = k + 1;
                }
                while right < end {
                    *(tmp + k) = *(src + right);
                    right = right + 1;
                    k = k + 1;
                }
                let seg_count = end - start;
                let mut cp: usize = 0;
                while cp < seg_count {
                    *(src + (start + cp)) = *(tmp + (start + cp));
                    cp = cp + 1;
                }
            }

            i = i + double_width;
        }
        width = width + width;
    }

    unsafe {
        HeapFree(h, 0u32, raw);
    }
    0
}

fn main() -> i32 {
    let h = unsafe { GetProcessHeap() };
    if h as usize == 0 {
        return 1;
    }

    let n: usize = 100000;
    let sz = size_of<Item>() as i64;
    let total_bytes = ((n as i64) * sz) as usize;
    let raw = unsafe { HeapAlloc(h, 8u32, total_bytes) };
    if raw as usize == 0 {
        return 2;
    }
    let arr = raw as *mut Item;

    // Generate 100,000 items with duplicate keys in range [0, 999]
    let mut seed: i64 = 987654321;
    let mut i: usize = 0;
    while i < n {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff;
        let k = seed % 1000;
        unsafe {
            *(arr + i) = Item {
                key: k,
                original_idx: i as i64,
            };
        }
        i = i + 1;
    }

    sort_items(h, arr, n);

    // Verify sort correctness and stability
    let mut valid = true;
    let mut idx: usize = 0;
    while idx + 1 < n {
        let cur = unsafe { *(arr + idx) };
        let next = unsafe { *(arr + (idx + 1)) };

        // 1. Sorted order check
        if cur.key > next.key {
            valid = false;
            break;
        }

        // 2. Stability check: if keys are equal, original_idx must be strictly increasing
        if cur.key == next.key && cur.original_idx >= next.original_idx {
            valid = false;
            break;
        }

        idx = idx + 1;
    }

    unsafe {
        HeapFree(h, 0u32, raw);
    }

    if !valid {
        return 3;
    }

    print("OK Stable Sort 100k\n");
    return 0;
}
