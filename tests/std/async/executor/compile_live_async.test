# Compile live std/async modules directly with the axiomc compiler (T421).
timeout: 60
cmd: "{compiler}" check --std-root "{root}/std" "{root}/std/sync/atomic.ax" "{root}/std/async/waker.ax" "{root}/std/async/task.ax" "{root}/std/async/executor.ax" "{root}/std/async/sync.ax" "{root}/std/async/channel.ax" "{root}/std/async/mod.ax"
exit: 0
