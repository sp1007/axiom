// std.asyn.waker - Task Waker Implementation & VTable (SPEC-34 AXS-EXEC-004)
module std.asyn.waker

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

use std.core.host.heap_alloc

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// Task state word: the low nibble is the scheduling state, the bits above it are flags.
//
// The encoding makes a wake a single `fetch_or(TASK_NOTIFIED)` that is harmless in every state:
//   IDLE (0)              not queued, not running   -> NOTIFIED: the waker that made this transition
//                                                      enqueues the task (exactly one does)
//   POLLING (1)           running                   -> POLLING|NOTIFIED (3): sticky wake permit, the
//                                                      poller re-queues the task when its poll ends
//   NOTIFIED (2)          queued                    -> unchanged
//   POLLING|NOTIFIED (3)  running, wake pending     -> unchanged
//   COMPLETED/CANCELLED/PANICKED (0xA/0xB/0xE)      -> unchanged (every terminal value has bit 1 set)
// Terminal states compare >= TASK_COMPLETED after masking with TASK_STATE_MASK.
pub const TASK_IDLE: u32 = 0u32
pub const TASK_POLLING: u32 = 1u32
pub const TASK_NOTIFIED: u32 = 2u32
pub const TASK_COMPLETED: u32 = 0xAu32
pub const TASK_CANCELLED: u32 = 0xBu32
pub const TASK_PANICKED: u32 = 0xEu32
pub const TASK_STATE_MASK: u32 = 0xFu32
pub const TASK_FLAGS_MASK: u32 = 0xFFFFFFF0u32

pub const FLAG_CANCEL_REQUESTED: u32 = 0x100u32
pub const FLAG_DETACHED: u32 = 0x200u32
// Set by `std.asyn.task.task_panic` while the task is being polled; the task's poll function
// (`tcb_poll_fn`) then ends the task as TASK_PANICKED (cooperative containment, SPEC-34 AXS-EXEC-007).
pub const FLAG_PANIC_REQUESTED: u32 = 0x400u32

@repr(C)
pub struct TaskHeader {
    pub vtable: *const RawWakerVTable,
    pub state: Atomic<u32>,
    pub ref_count: Atomic<u32>,
    pub task_id: u64,
    pub owner_thread_id: u64,
    pub queue_next: *mut TaskHeader,
    pub schedule_fn: fn(*mut TaskHeader),
    pub poll_fn: fn(*mut u8, *mut u8) -> u32,
    pub drop_fn: fn(*mut TaskHeader),
    pub schedule_data: *mut u8,
    pub alloc_size: usize,
    pub alloc_align: usize,
}

fn task_waker_clone(data: *const u8) -> RawWaker {
    let raw = data as *mut TaskHeader;
    if (raw as usize) != 0 {
        unsafe {
            (*raw).ref_count.fetch_add(1u32, Ordering.Relaxed);
            return RawWaker {
                data: data,
                vtable: (*raw).vtable,
            };
        }
    }
    RawWaker {
        data: 0 as *const u8,
        vtable: 0 as *const RawWakerVTable,
    }
}

fn task_waker_wake(data: *const u8) {
    let raw = data as *mut TaskHeader;
    if (raw as usize) != 0 {
        task_wake(raw);
        task_dec_ref(raw);
    }
}

fn task_waker_wake_by_ref(data: *const u8) {
    let raw = data as *mut TaskHeader;
    if (raw as usize) != 0 {
        task_wake(raw);
    }
}

fn task_waker_drop(data: *const u8) {
    let raw = data as *mut TaskHeader;
    if (raw as usize) != 0 {
        task_dec_ref(raw);
    }
}

pub fn new_task_waker_vtable() -> *const RawWakerVTable {
    let p = unsafe { heap_alloc(32usize, 8usize) as *mut RawWakerVTable };
    unsafe {
        (*p).clone = task_waker_clone;
        (*p).wake = task_waker_wake;
        (*p).wake_by_ref = task_waker_wake_by_ref;
        (*p).drop_waker = task_waker_drop;
    }
    p as *const RawWakerVTable
}

pub fn init_task_header_vtable(header: *mut TaskHeader, vt: *const RawWakerVTable) {
    if (header as usize) != 0 {
        unsafe {
            (*header).vtable = vt;
        }
    }
}

pub fn make_task_waker(header: *mut TaskHeader) -> Waker {
    if (header as usize) != 0 {
        unsafe {
            (*header).ref_count.fetch_add(1u32, Ordering.Relaxed);
            return Waker {
                raw: RawWaker {
                    data: header as *const u8,
                    vtable: (*header).vtable,
                },
            };
        }
    }
    Waker {
        raw: RawWaker {
            data: 0 as *const u8,
            vtable: 0 as *const RawWakerVTable,
        },
    }
}

pub fn task_wake(raw: *mut TaskHeader) {
    if (raw as usize) == 0 {
        return;
    }
    // Wait-free: one atomic read-modify-write whatever the task does concurrently (a CAS retry loop
    // livelocks against a task that keeps re-waking itself under a deterministic round-robin
    // scheduler). Only the IDLE -> NOTIFIED transition enqueues, so a task is queued at most once.
    let prev: u32 = unsafe { (*raw).state.fetch_or(TASK_NOTIFIED, Ordering.AcqRel) };
    if (prev & TASK_STATE_MASK) == TASK_IDLE {
        task_schedule(raw);
    }
}

// Hand the task to its executor's ready queue (the caller made the IDLE -> NOTIFIED transition).
pub fn task_schedule(raw: *mut TaskHeader) {
    let s_fn = unsafe { (*raw).schedule_fn };
    let s_addr = unsafe { *(address_of<fn(*mut TaskHeader)>(s_fn) as *const usize) };
    if s_addr != 0usize {
        s_fn(raw);
    }
}

// Ask a task to stop: set the cancel flag, then wake it so a poll observes the flag (at the start of
// its next poll). Wait-free; flags already set stay set.
pub fn task_request_cancel(raw: *mut TaskHeader) {
    if (raw as usize) == 0 {
        return;
    }
    unsafe {
        (*raw).state.fetch_or(FLAG_CANCEL_REQUESTED, Ordering.AcqRel);
    }
    task_wake(raw);
}

// Poll protocol for executors' poll functions (`tcb_poll_fn`); every transition
// keeps the flag bits.
//
// A dequeued task is NOTIFIED (it is queued only by the IDLE -> NOTIFIED transition or by the poller
// itself); `task_begin_poll` moves it to POLLING and returns the state word before the transition,
// so the caller sees the flags (cancel request) that were set while the task was queued.
pub fn task_begin_poll(raw: *mut TaskHeader) -> u32 {
    unsafe { (*raw).state.fetch_sub(TASK_NOTIFIED - TASK_POLLING, Ordering.AcqRel) }
}

// End a poll that returned Pending: POLLING -> IDLE, or POLLING|NOTIFIED -> NOTIFIED when a wake
// arrived during the poll, in which case the task is re-queued here. Returns TASK_IDLE or
// TASK_NOTIFIED. A cancel flag set without a wake (it is always paired with one by
// `task_request_cancel`) still gets the task re-queued.
pub fn task_end_poll_pending(raw: *mut TaskHeader) -> u32 {
    let prev: u32 = unsafe { (*raw).state.fetch_sub(TASK_POLLING, Ordering.AcqRel) };
    if (prev & TASK_NOTIFIED) != 0u32 {
        task_schedule(raw);
        return TASK_NOTIFIED;
    }
    if (prev & FLAG_CANCEL_REQUESTED) != 0u32 {
        task_wake(raw);
        return TASK_NOTIFIED;
    }
    TASK_IDLE
}

// Publish a terminal state (TASK_COMPLETED / TASK_CANCELLED / TASK_PANICKED). Later wakes and flag
// requests leave the terminal value intact.
pub fn task_set_terminal(raw: *mut TaskHeader, terminal: u32) {
    unsafe {
        (*raw).state.store(terminal, Ordering.Release);
    }
}

// The scheduling state of a task (low nibble of the state word).
pub fn task_state(raw: *mut TaskHeader) -> u32 {
    unsafe { (*raw).state.load(Ordering.Acquire) & TASK_STATE_MASK }
}

pub fn task_dec_ref(raw: *mut TaskHeader) {
    if (raw as usize) == 0 {
        return;
    }
    let prev = unsafe { (*raw).ref_count.fetch_sub(1u32, Ordering.AcqRel) };
    if prev == 1u32 {
        let df = unsafe { (*raw).drop_fn };
        let df_addr = unsafe { *(address_of<fn(*mut TaskHeader)>(df) as *const usize) };
        if df_addr != 0usize {
            df(raw);
        }
    }
}

// -----------------------------------------------------------------------------
// Waker operations through the vtable
// -----------------------------------------------------------------------------
//
// Wait queues (AsyncMutex, AsyncSemaphore, channels, cancellation, TaskHandle join) keep a `Waker`
// field inside raw heap nodes. A store through a raw pointer (`(*n).waker = w`) writes the bits
// without dropping the previous value, so the queues manage the stored reference explicitly: they
// move the old waker out first (`let old = (*n).waker;`, dropped at the end of its scope) and move it
// out again to wake or release it.
//
// The helpers below are the vtable dispatch used by `Waker` itself:
//   waker_leak             Waker -> RawWaker, transferring the reference (the Waker is neutralised)
//   raw_waker_wake         wake the task and release the reference (consumes it)
//   raw_waker_wake_by_ref  wake the task, keep the reference
//   raw_waker_drop         release the reference without waking

pub fn waker_leak(mut w: Waker) -> RawWaker {
    let rw = RawWaker {
        data: w.raw.data,
        vtable: w.raw.vtable,
    };
    w.raw.data = 0 as *const u8;
    rw
}

// A pair with a null data pointer (or a null vtable) is an empty waker: every operation on it is a
// no-op (the same convention as `Waker.noop()`, SPEC-33 AXS-ASY-011).
fn raw_waker_is_empty(data: *const u8, vt: *const RawWakerVTable) -> bool {
    (data as usize) == 0 || (vt as usize) == 0
}

pub fn raw_waker_wake(data: *const u8, vt: *const RawWakerVTable) {
    if !raw_waker_is_empty(data, vt) {
        unsafe {
            ((*vt).wake)(data);
        }
    }
}

pub fn raw_waker_wake_by_ref(data: *const u8, vt: *const RawWakerVTable) {
    if !raw_waker_is_empty(data, vt) {
        unsafe {
            ((*vt).wake_by_ref)(data);
        }
    }
}

pub fn raw_waker_drop(data: *const u8, vt: *const RawWakerVTable) {
    if !raw_waker_is_empty(data, vt) {
        unsafe {
            ((*vt).drop_waker)(data);
        }
    }
}

// Clone the reference held by a pair through its vtable (`clone` entry).
pub fn raw_waker_clone(data: *const u8, vt: *const RawWakerVTable) -> RawWaker {
    if raw_waker_is_empty(data, vt) {
        return RawWaker {
            data: 0 as *const u8,
            vtable: 0 as *const RawWakerVTable,
        };
    }
    unsafe { ((*vt).clone)(data) }
}

// Every `Waker` operation dispatches through the vtable of its `RawWaker` (SPEC-33 AXS-ASY-011), so
// task wakers and user-defined wakers behave the same; nothing here assumes a task header.
impl Waker {
    // Consumes the waker: the vtable's `wake` takes over its reference, `Drop` does not run again.
    pub fn wake(self: Waker) {
        let rw = waker_leak(self);
        raw_waker_wake(rw.data, rw.vtable);
    }

    pub fn wake_by_ref(self: view<Waker>) {
        raw_waker_wake_by_ref(self.raw.data, self.raw.vtable);
    }

    pub fn clone(self: view<Waker>) -> Waker {
        let rw = raw_waker_clone(self.raw.data, self.raw.vtable);
        Waker {
            raw: RawWaker {
                data: rw.data,
                vtable: rw.vtable,
            },
        }
    }

    pub fn will_wake(self: view<Waker>, other: view<Waker>) -> bool {
        (self.raw.data as usize) == (other.raw.data as usize) && (self.raw.vtable as usize) == (other.raw.vtable as usize)
    }
}

impl Drop for Waker {
    fn drop(self: mut_view<Waker>) {
        let data = self.raw.data;
        if (data as usize) != 0 {
            self.raw.data = 0 as *const u8;
            raw_waker_drop(data, self.raw.vtable);
        }
    }
}

impl Context {
    pub fn waker(self: mut_view<Context>) -> Waker {
        view(self.waker_val).clone()
    }
}

// std.asyn.task - TaskControlBlock, TaskHandle, and Lifecycle Management (SPEC-34 AXS-EXEC-003..007)
module std.asyn.task

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.thread_yield

pub use std.asyn.waker.TaskHeader
pub use std.asyn.waker.TASK_IDLE
pub use std.asyn.waker.TASK_POLLING
pub use std.asyn.waker.TASK_NOTIFIED
pub use std.asyn.waker.TASK_COMPLETED
pub use std.asyn.waker.TASK_CANCELLED
pub use std.asyn.waker.TASK_PANICKED
pub use std.asyn.waker.TASK_STATE_MASK
pub use std.asyn.waker.TASK_FLAGS_MASK
pub use std.asyn.waker.FLAG_CANCEL_REQUESTED
pub use std.asyn.waker.FLAG_DETACHED
pub use std.asyn.waker.FLAG_PANIC_REQUESTED
pub use std.asyn.waker.make_task_waker
pub use std.asyn.waker.task_wake
pub use std.asyn.waker.task_schedule
pub use std.asyn.waker.task_request_cancel
pub use std.asyn.waker.task_begin_poll
pub use std.asyn.waker.task_end_poll_pending
pub use std.asyn.waker.task_set_terminal
pub use std.asyn.waker.task_state
pub use std.asyn.waker.task_dec_ref
pub use std.asyn.waker.init_task_header_vtable
pub use std.asyn.waker.new_task_waker_vtable

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@derive(Copy)
pub struct TaskId {
    pub id: u64,
}

pub struct TaskPanic {
    pub task_id: TaskId,
}

pub enum TaskError {
    Cancelled,
    Panicked,
}

pub enum TaskResult<T> {
    Completed(T),
    Cancelled,
    Panicked,
}

// Join-waker slot state (`TaskSlot.join_state`). The waker field is owned by whoever holds
// JOIN_REGISTERING (the handle, while it installs a waker) or, once JOIN_COMPLETE is set, by the side
// that made the deciding transition:
//   handle     REGISTERING on (only while not COMPLETE) -> replace the waker -> WAKER_SET on and
//              REGISTERING off in one CAS. That CAS fails only when the completer set COMPLETE in
//              between: then the handle drops its own waker and reports completion instead of waiting.
//   completer  fetch_or(COMPLETE): if REGISTERING was set, the handle owns the field (and will see
//              COMPLETE); otherwise, if WAKER_SET was set, the completer takes the waker and wakes it.
//   release    a waker still WAKER_SET when the control block is freed is dropped there.
// The completer publishes the terminal task state before COMPLETE, so a handle that sees COMPLETE
// also sees the terminal state. A wake between "check done" and "register" is never lost, and every
// registered waker is consumed exactly once (woken, replaced, or released).
//
// `join_waker` lives in raw task memory: it is only meaningful while JOIN_WAKER_SET is on. A store
// through the raw pointer does not drop the previous bits, so the old waker is always moved out
// before a new one is stored.
pub const JOIN_REGISTERING: u32 = 1u32
pub const JOIN_WAKER_SET: u32 = 2u32
pub const JOIN_COMPLETE: u32 = 4u32

@repr(C)
pub struct TaskSlot<T> {
    pub header: TaskHeader,
    pub has_output: bool,
    pub join_state: Atomic<u32>,
    pub join_waker: Waker,
    // Last on purpose: the join fields above are reached through `TaskSlot<u8>` casts by type-erased
    // code (`default_task_drop`, join protocol) and must sit at the same offsets for every output T.
    pub output: T,
}

// Task memory: one allocation per spawned task holding the header, the join slot, the output and
// the future. Contract of the per-task poll function (`TaskHeader.poll_fn` = `task_poll_fn<F, T>`):
// called with a Context it polls the task; called with a null Context it drops whatever payload is
// still stored (future, output) and returns. The second form is how type-erased code
// (`default_task_drop`) drops a stored output whose type it does not know.
@repr(C)
pub struct TaskControlBlock<F, T> {
    pub slot: TaskSlot<T>,
    pub future: F,
    pub has_future: bool,
}

pub struct TaskHandle<T> {
    pub raw_task: *mut TaskHeader,
    pub task_id: TaskId,
}

unsafe impl<T: Send> Send for TaskHandle<T> {}
impl<T> !Copy for TaskHandle<T> {}

pub struct LocalTaskHandle<T> {
    pub raw_task: *mut TaskHeader,
    pub task_id: TaskId,
}

impl<T> !Copy for LocalTaskHandle<T> {}
impl<T> !Send for LocalTaskHandle<T> {}

pub unsafe fn task_take_output<T>(raw: *mut TaskHeader) -> T {
    let slot = raw as *mut TaskSlot<T>;
    (*slot).has_output = false;
    (*slot).output
}

// Register `w` to be woken when the task reaches a terminal state, replacing (dropping) a waker
// registered before. Returns false when the task has already completed: `w` is dropped and the caller
// must re-read the task state (terminal by then) instead of waiting. Only the task's single handle
// registers, so registrations never race each other, only the completion.
pub unsafe fn task_register_join_waker(raw: *mut TaskHeader, w: Waker) -> bool {
    let slot = raw as *mut TaskSlot<u8>;
    let mut s: u32 = (*slot).join_state.load(Ordering.Acquire);
    loop {
        if (s & JOIN_COMPLETE) != 0u32 {
            // `w` is dropped on return.
            return false;
        }
        let cas = (*slot).join_state.compare_exchange(s, s | JOIN_REGISTERING, Ordering.AcqRel, Ordering.Acquire);
        if cas.ok {
            break;
        }
        s = cas.val;
    }
    // REGISTERING is held: the waker field is ours.
    if (s & JOIN_WAKER_SET) != 0u32 {
        let replaced: Waker = (*slot).join_waker;
    }
    (*slot).join_waker = w;
    let mut cur: u32 = s | JOIN_REGISTERING;
    loop {
        if (cur & JOIN_COMPLETE) != 0u32 {
            // Completed while we were registering; the completer left the field to us.
            (*slot).join_state.store(JOIN_COMPLETE, Ordering.Release);
            let unused: Waker = (*slot).join_waker;
            return false;
        }
        let published: u32 = (cur & (0xFFFFFFFFu32 - JOIN_REGISTERING)) | JOIN_WAKER_SET;
        let cas = (*slot).join_state.compare_exchange(cur, published, Ordering.AcqRel, Ordering.Acquire);
        if cas.ok {
            return true;
        }
        cur = cas.val;
    }
}

// Completion side of the join-waker protocol: called exactly once per task, after the terminal state
// has been published (see `task_finish`).
pub unsafe fn task_wake_join_waker(raw: *mut TaskHeader) {
    let slot = raw as *mut TaskSlot<u8>;
    let prev: u32 = (*slot).join_state.fetch_or(JOIN_COMPLETE, Ordering.AcqRel);
    if (prev & JOIN_REGISTERING) != 0u32 {
        return;
    }
    if (prev & JOIN_WAKER_SET) != 0u32 {
        let w: Waker = (*slot).join_waker;
        (*slot).join_state.store(JOIN_COMPLETE, Ordering.Release);
        w.wake();
    }
}

// Publish a terminal state (TASK_COMPLETED / TASK_CANCELLED / TASK_PANICKED) and fire the join waker.
pub unsafe fn task_finish(raw: *mut TaskHeader, terminal: u32) {
    task_set_terminal(raw, terminal);
    task_wake_join_waker(raw);
}

// Drop the future stored in the control block, once.
pub unsafe fn tcb_drop_future<F, T>(tcb: *mut TaskControlBlock<F, T>) {
    if (*tcb).has_future {
        (*tcb).has_future = false;
        let mut tmp: [1]F = [*address_of_mut((*tcb).future)];
    }
}

// Drop whatever payload the control block still stores: the future and an output that was never
// taken. Poll functions do this when they are called with a null Context (see TaskControlBlock).
pub unsafe fn tcb_drop_payload<F, T>(tcb: *mut TaskControlBlock<F, T>) {
    tcb_drop_future<F, T>(tcb);
    if (*tcb).slot.has_output {
        (*tcb).slot.has_output = false;
        let mut out: [1]T = [*address_of_mut((*tcb).slot.output)];
    }
}

// -----------------------------------------------------------------------------
// Panic containment (SPEC-34 AXS-EXEC-007, ADR-0042 §2)
// -----------------------------------------------------------------------------

// Report that the task currently being polled has panicked. The calling future should return right
// after (`Poll.Pending` or any value): the task's poll function drops the future and publishes the
// task as `TASK_PANICKED` once the current poll returns, which handles and groups report as
// `Panicked`. Has no effect outside a task. The runtime has no unwinding yet, so containment is
// cooperative; T536 installs a real catch in `tcb_poll_fn`.
pub fn task_panic(cx: mut_view<Context>) {
    let w = cx.waker();
    let raw = w.raw.data as *mut TaskHeader;
    if (raw as usize) != 0 {
        unsafe {
            (*raw).state.fetch_or(FLAG_PANIC_REQUESTED, Ordering.Release);
        }
    }
}

// Poll one task. Flag bits are preserved on every transition; a cancel request is observed at the
// start of a poll (the future is dropped); a task that called `task_panic` during the poll ends as
// TASK_PANICKED (future dropped, an output it produced is discarded).
pub fn tcb_poll_fn<F: Future<Output = T>, T>(tcb: *mut TaskControlBlock<F, T>, cx_raw: *mut u8) -> u32 {
    let raw = tcb as *mut TaskHeader;
    if (cx_raw as usize) == 0 {
        unsafe {
            tcb_drop_payload<F, T>(tcb);
        }
        return task_state(raw);
    }

    // NOTIFIED -> POLLING keeping the flag bits: a plain store would erase a cancel request made
    // while the task was queued.
    let st: u32 = task_begin_poll(raw);
    if (st & FLAG_CANCEL_REQUESTED) != 0u32 {
        unsafe {
            tcb_drop_future<F, T>(tcb);
            task_finish(raw, TASK_CANCELLED);
        }
        return TASK_CANCELLED;
    }

    let p_cx = cx_raw as *mut Context;
    let poll_res = unsafe { (*tcb).future.poll(mut_view(*p_cx)) };
    let after: u32 = unsafe { (*raw).state.load(Ordering.Acquire) };
    let panicked: bool = (after & FLAG_PANIC_REQUESTED) != 0u32;

    match poll_res {
        Poll.Ready(val) => {
            if panicked {
                // The output is discarded (dropped at the end of this arm).
                let discarded = val;
                unsafe {
                    tcb_drop_future<F, T>(tcb);
                    task_finish(raw, TASK_PANICKED);
                }
                return TASK_PANICKED;
            }
            unsafe {
                tcb_drop_future<F, T>(tcb);
                (*tcb).slot.output = val;
                (*tcb).slot.has_output = true;
                task_finish(raw, TASK_COMPLETED);
            }
            TASK_COMPLETED
        },
        Poll.Pending => {
            if panicked {
                unsafe {
                    tcb_drop_future<F, T>(tcb);
                    task_finish(raw, TASK_PANICKED);
                }
                return TASK_PANICKED;
            }
            // POLLING -> IDLE, or back to the queue when a wake (or a cancel request) arrived.
            task_end_poll_pending(raw)
        },
    }
}

// Type-erased form of `tcb_poll_fn<F, T>` stored in `TaskHeader.poll_fn` by `spawn` / `spawn_local`.
pub fn task_poll_fn<F: Future<Output = T>, T>(raw: *mut u8, cx_raw: *mut u8) -> u32 {
    tcb_poll_fn<F, T>(raw as *mut TaskControlBlock<F, T>, cx_raw)
}

// Release a control block whose last reference is gone. A stored output nobody took (detached task,
// handle dropped after completion, group dropped before collecting) is dropped through the task's
// poll function called with a null Context; a join waker that was never consumed is released; then
// the memory is freed.
pub fn default_task_drop(raw: *mut TaskHeader) {
    if (raw as usize) == 0 {
        return;
    }
    let slot = raw as *mut TaskSlot<u8>;
    if unsafe { (*slot).has_output } {
        unsafe {
            ((*raw).poll_fn)(raw as *mut u8, 0 as *mut u8);
        }
    }
    let js: u32 = unsafe { (*slot).join_state.load(Ordering.Acquire) };
    if (js & JOIN_WAKER_SET) != 0u32 {
        unsafe {
            (*slot).join_state.store(JOIN_COMPLETE, Ordering.Release);
            let released: Waker = (*slot).join_waker;
        }
    }
    let sz = unsafe { (*raw).alloc_size };
    let al = unsafe { (*raw).alloc_align };
    unsafe {
        heap_free(raw as *mut u8, sz, al);
    }
}

// -----------------------------------------------------------------------------
// Handle operations shared by TaskHandle / LocalTaskHandle / TaskJoin
// -----------------------------------------------------------------------------

// Request cancellation unless the task is finished or detached; the caller releases its reference.
fn handle_cancel_unless_done(raw: *mut TaskHeader) {
    let st: u32 = unsafe { (*raw).state.load(Ordering.Acquire) };
    if (st & TASK_STATE_MASK) < TASK_COMPLETED && (st & FLAG_DETACHED) == 0u32 {
        task_request_cancel(raw);
    }
}

fn handle_detach(raw: *mut TaskHeader) {
    unsafe {
        (*raw).state.fetch_or(FLAG_DETACHED, Ordering.Release);
    }
    task_dec_ref(raw);
}

// The result of a terminal task; releases the caller's reference.
fn handle_collect<T>(raw: *mut TaskHeader) -> TaskResult<T> {
    let st: u32 = task_state(raw);
    let res: TaskResult<T> = if st == TASK_COMPLETED {
        TaskResult.Completed(unsafe { task_take_output<T>(raw) })
    } else if st == TASK_CANCELLED {
        TaskResult.Cancelled
    } else {
        TaskResult.Panicked
    };
    task_dec_ref(raw);
    res
}

// Poll for the end of the task: Ready with its result once it is terminal (the reference is released
// then), otherwise the join waker is (re-)registered and Pending is returned.
fn handle_poll_result<T>(raw: *mut TaskHeader, cx: mut_view<Context>) -> Poll<TaskResult<T>> {
    loop {
        if task_state(raw) >= TASK_COMPLETED {
            return Poll.Ready(handle_collect<T>(raw));
        }
        if unsafe { task_register_join_waker(raw, cx.waker()) } {
            return Poll.Pending;
        }
        // Completed while registering: the state is terminal now, loop once more to collect it.
    }
}

fn result_of<T>(r: TaskResult<T>) -> Result<T, TaskError> {
    match r {
        TaskResult.Completed(v) => Result.Ok(v),
        TaskResult.Cancelled => Result.Err(TaskError.Cancelled),
        TaskResult.Panicked => Result.Err(TaskError.Panicked),
    }
}

// Blocking join: yield the OS thread until the task is terminal. The caller must not be the thread
// the task needs in order to make progress (use `join()` from inside a task).
fn handle_join_blocking<T>(raw: *mut TaskHeader) -> TaskResult<T> {
    if (raw as usize) == 0 {
        return TaskResult.Cancelled;
    }
    while task_state(raw) < TASK_COMPLETED {
        unsafe {
            thread_yield();
        }
    }
    handle_collect<T>(raw)
}

// Future returned by `TaskHandle.join()` / `LocalTaskHandle.join()` (SPEC-34 `async fn join(self)`):
// resolves to the task's `TaskResult` without blocking the polling thread. Dropping it before it is
// ready behaves like dropping the handle (the task is cancelled).
pub struct TaskJoin<T> {
    pub raw_task: *mut TaskHeader,
}

impl<T> !Copy for TaskJoin<T> {}

impl<T> Future for TaskJoin<T> {
    type Output = TaskResult<T>;

    fn poll(self: mut_view<TaskJoin<T>>, cx: mut_view<Context>) -> Poll<TaskResult<T>> {
        let raw = self.raw_task;
        if (raw as usize) == 0 {
            return Poll.Ready(TaskResult.Cancelled);
        }
        let r: Poll<TaskResult<T>> = handle_poll_result<T>(raw, cx);
        match r {
            Poll.Ready(v) => {
                self.raw_task = 0 as *mut TaskHeader;
                Poll.Ready(v)
            },
            Poll.Pending => Poll.Pending,
        }
    }
}

impl<T> Drop for TaskJoin<T> {
    fn drop(self: mut_view<TaskJoin<T>>) {
        let raw = self.raw_task;
        if (raw as usize) != 0 {
            self.raw_task = 0 as *mut TaskHeader;
            handle_cancel_unless_done(raw);
            task_dec_ref(raw);
        }
    }
}

// -----------------------------------------------------------------------------
// TaskHandle<T>
// -----------------------------------------------------------------------------

impl<T> TaskHandle<T> {
    pub fn id(self: view<TaskHandle<T>>) -> TaskId {
        self.task_id
    }

    pub fn is_finished(self: view<TaskHandle<T>>) -> bool {
        if (self.raw_task as usize) == 0 {
            return true;
        }
        task_state(self.raw_task) >= TASK_COMPLETED
    }

    pub fn cancel(self: view<TaskHandle<T>>) {
        if (self.raw_task as usize) == 0 {
            return;
        }
        task_request_cancel(self.raw_task);
    }

    pub fn detach(mut self: TaskHandle<T>) {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        if (raw as usize) != 0 {
            handle_detach(raw);
        }
    }

    // Await the task's end: `exec.block_on(h.join())`, or poll it from inside another task.
    pub fn join(mut self: TaskHandle<T>) -> TaskJoin<T> {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        TaskJoin { raw_task: raw }
    }

    // Synchronous join for code that is not running inside a task (yields the OS thread).
    pub fn join_blocking(mut self: TaskHandle<T>) -> TaskResult<T> {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        handle_join_blocking<T>(raw)
    }
}

// `let res = handle.await` (SPEC-34 AXS-EXEC-005): Ready(Ok(output)) / Ready(Err(TaskError)).
impl<T> Future for TaskHandle<T> {
    type Output = Result<T, TaskError>;

    fn poll(self: mut_view<TaskHandle<T>>, cx: mut_view<Context>) -> Poll<Result<T, TaskError>> {
        let raw = self.raw_task;
        if (raw as usize) == 0 {
            return Poll.Ready(Result.Err(TaskError.Cancelled));
        }
        let r: Poll<TaskResult<T>> = handle_poll_result<T>(raw, cx);
        match r {
            Poll.Ready(v) => {
                self.raw_task = 0 as *mut TaskHeader;
                Poll.Ready(result_of<T>(v))
            },
            Poll.Pending => Poll.Pending,
        }
    }
}

impl<T> Drop for TaskHandle<T> {
    fn drop(self: mut_view<TaskHandle<T>>) {
        let raw = self.raw_task;
        if (raw as usize) != 0 {
            self.raw_task = 0 as *mut TaskHeader;
            handle_cancel_unless_done(raw);
            task_dec_ref(raw);
        }
    }
}

// -----------------------------------------------------------------------------
// LocalTaskHandle<T>
// -----------------------------------------------------------------------------

impl<T> LocalTaskHandle<T> {
    pub fn id(self: view<LocalTaskHandle<T>>) -> TaskId {
        self.task_id
    }

    pub fn is_finished(self: view<LocalTaskHandle<T>>) -> bool {
        if (self.raw_task as usize) == 0 {
            return true;
        }
        task_state(self.raw_task) >= TASK_COMPLETED
    }

    pub fn cancel(self: view<LocalTaskHandle<T>>) {
        if (self.raw_task as usize) == 0 {
            return;
        }
        task_request_cancel(self.raw_task);
    }

    pub fn detach(mut self: LocalTaskHandle<T>) {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        if (raw as usize) != 0 {
            handle_detach(raw);
        }
    }

    // Await the task's end: `exec.run_until(h.join())`, or poll it from inside another local task.
    pub fn join(mut self: LocalTaskHandle<T>) -> TaskJoin<T> {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        TaskJoin { raw_task: raw }
    }

    // Synchronous join; only valid once the task has finished (or when something else drives the
    // LocalExecutor), because a local task never runs on another thread.
    pub fn join_blocking(mut self: LocalTaskHandle<T>) -> TaskResult<T> {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        handle_join_blocking<T>(raw)
    }
}

impl<T> Future for LocalTaskHandle<T> {
    type Output = Result<T, TaskError>;

    fn poll(self: mut_view<LocalTaskHandle<T>>, cx: mut_view<Context>) -> Poll<Result<T, TaskError>> {
        let raw = self.raw_task;
        if (raw as usize) == 0 {
            return Poll.Ready(Result.Err(TaskError.Cancelled));
        }
        let r: Poll<TaskResult<T>> = handle_poll_result<T>(raw, cx);
        match r {
            Poll.Ready(v) => {
                self.raw_task = 0 as *mut TaskHeader;
                Poll.Ready(result_of<T>(v))
            },
            Poll.Pending => Poll.Pending,
        }
    }
}

impl<T> Drop for LocalTaskHandle<T> {
    fn drop(self: mut_view<LocalTaskHandle<T>>) {
        let raw = self.raw_task;
        if (raw as usize) != 0 {
            self.raw_task = 0 as *mut TaskHeader;
            handle_cancel_unless_done(raw);
            task_dec_ref(raw);
        }
    }
}

module std.io

use std.core.option.Option
use std.core.result.Result
use std.core.host.stdio
use std.core.host.open
use std.core.host.read
use std.core.host.write
use std.core.host.close
use std.core.host.file_size
use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

@derive(Copy)
pub enum IoError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidHandle,
    InvalidData,
    TimedOut,
    Cancelled,
    ConnectionRefused,
    ConnectionReset,
    BrokenPipe,
    AddrInUse,
    UnexpectedEof,
    Other(i64),
}

pub fn io_error_from_code(code: i64) -> IoError {
    if code == -1 {
        IoError.NotFound
    } else if code == -2 {
        IoError.PermissionDenied
    } else if code == -3 {
        IoError.AlreadyExists
    } else if code == -4 {
        IoError.InvalidHandle
    } else if code == -5 {
        IoError.TimedOut
    } else if code == -6 {
        IoError.Cancelled
    } else if code == -7 {
        IoError.ConnectionRefused
    } else if code == -8 {
        IoError.ConnectionReset
    } else if code == -10 {
        IoError.BrokenPipe
    } else if code == -11 {
        IoError.AddrInUse
    } else {
        IoError.Other(code)
    }
}

pub fn print(s: Str) {
    let slen = len(s);
    if slen > 0 {
        let p = unsafe { *(address_of(s) as *const *const u8) };
        let h = stdio(1);
        unsafe {
            write(h, p, slen);
        }
    }
}

pub fn println(s: Str) {
    print(s);
    let nl = "\n";
    let p = unsafe { *(address_of(nl) as *const *const u8) };
    let h = stdio(1);
    unsafe {
        write(h, p, 1);
    }
}

pub fn eprint(s: Str) {
    let slen = len(s);
    if slen > 0 {
        let p = unsafe { *(address_of(s) as *const *const u8) };
        let h = stdio(2);
        unsafe {
            write(h, p, slen);
        }
    }
}

pub fn eprintln(s: Str) {
    eprint(s);
    let nl = "\n";
    let p = unsafe { *(address_of(nl) as *const *const u8) };
    let h = stdio(2);
    unsafe {
        write(h, p, 1);
    }
}

pub struct File {
    pub handle: i64,
    pub is_open: bool,
}

impl Drop for File {
    fn drop(self: mut_view<File>) {
        if self.is_open && (self.handle >= 0) {
            close(self.handle);
            self.is_open = false;
            self.handle = -1;
        }
    }
}

pub fn file_open(path: Str) -> Result<File, IoError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 0u32) };
    if h < 0 {
        Result.Err(io_error_from_code(h))
    } else {
        Result.Ok(File { handle: h, is_open: true })
    }
}

pub fn file_create(path: Str) -> Result<File, IoError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 1u32) };
    if h < 0 {
        Result.Err(io_error_from_code(h))
    } else {
        Result.Ok(File { handle: h, is_open: true })
    }
}

pub fn file_append(path: Str) -> Result<File, IoError> {
    let plen = len(path);
    let p = unsafe { *(address_of(path) as *const *const u8) };
    let h = unsafe { open(p, plen, 2u32) };
    if h < 0 {
        Result.Err(io_error_from_code(h))
    } else {
        Result.Ok(File { handle: h, is_open: true })
    }
}

pub fn file_read(f: mut_view<File>, buf: *mut u8, cap: usize) -> Result<usize, IoError> {
    let h = f.handle;
    if !f.is_open || h < 0 {
        return Result.Err(IoError.InvalidHandle);
    }
    let n = unsafe { read(h, buf, cap) };
    if n < 0 {
        Result.Err(io_error_from_code(n))
    } else {
        Result.Ok(n as usize)
    }
}

pub fn file_write(f: mut_view<File>, buf: *const u8, count: usize) -> Result<usize, IoError> {
    let h = f.handle;
    if !f.is_open || h < 0 {
        return Result.Err(IoError.InvalidHandle);
    }
    let n = unsafe { write(h, buf, count) };
    if n < 0 {
        Result.Err(io_error_from_code(n))
    } else {
        Result.Ok(n as usize)
    }
}

pub fn file_size_of(f: view<File>) -> Result<i64, IoError> {
    let h = f.handle;
    if !f.is_open || h < 0 {
        return Result.Err(IoError.InvalidHandle);
    }
    let sz = file_size(h);
    if sz < 0 {
        Result.Err(io_error_from_code(sz))
    } else {
        Result.Ok(sz)
    }
}

pub fn file_close(f: mut_view<File>) -> Result<(), IoError> {
    let h = f.handle;
    if !f.is_open || h < 0 {
        return Result.Err(IoError.InvalidHandle);
    }
    let res = close(h);
    f.is_open = false;
    f.handle = -1;
    if res < 0 {
        Result.Err(io_error_from_code(res))
    } else {
        Result.Ok(())
    }
}

impl File {
    pub fn open(path: Str) -> Result<File, IoError> { file_open(path) }
    pub fn create(path: Str) -> Result<File, IoError> { file_create(path) }
    pub fn append(path: Str) -> Result<File, IoError> { file_append(path) }
    pub fn read(self: mut_view<File>, buf: *mut u8, cap: usize) -> Result<usize, IoError> { file_read(self, buf, cap) }
    pub fn write(self: mut_view<File>, buf: *const u8, count: usize) -> Result<usize, IoError> { file_write(self, buf, count) }
    pub fn file_size(self: view<File>) -> Result<i64, IoError> { file_size_of(self) }
    pub fn close(self: mut_view<File>) -> Result<(), IoError> { file_close(self) }
}

pub fn read_to_string(path: Str) -> Result<String, IoError> {
    let mut f = match file_open(path) {
        Result.Ok(file) => file,
        Result.Err(e) => return Result.Err(e),
    };
    let sz = match file_size_of(view(f)) {
        Result.Ok(s) => s,
        Result.Err(e) => return Result.Err(e),
    };
    if sz <= 0i64 {
        return Result.Ok(string_new());
    }
    let usize_sz = sz as usize;
    let mut s = string_with_capacity(usize_sz);
    let mut total_read: usize = 0;
    while total_read < usize_sz {
        let dst = unsafe { s.ptr + total_read };
        let remaining = usize_sz - total_read;
        let rd = match file_read(mut_view(f), dst, remaining) {
            Result.Ok(n) => n,
            Result.Err(e) => return Result.Err(e),
        };
        if rd == 0 {
            break;
        }
        total_read = total_read + rd;
    }
    s.len = total_read;
    Result.Ok(s)
}

pub fn write_string(path: Str, s: Str) -> Result<(), IoError> {
    let mut f = match file_create(path) {
        Result.Ok(file) => file,
        Result.Err(e) => return Result.Err(e),
    };
    let slen = len(s);
    if slen > 0 {
        let p = unsafe { *(address_of(s) as *const *const u8) };
        let mut total_written: usize = 0;
        while total_written < slen {
            let src = unsafe { p + total_written };
            let remaining = slen - total_written;
            let wr = match file_write(mut_view(f), src, remaining) {
                Result.Ok(n) => n,
                Result.Err(e) => return Result.Err(e),
            };
            if wr == 0 {
                return Result.Err(IoError.Other(-9));
            }
            total_written = total_written + wr;
        }
    }
    Result.Ok(())
}

pub fn write_file(path: Str, bytes: *const u8, count: usize) -> Result<(), IoError> {
    let mut f = match file_create(path) {
        Result.Ok(file) => file,
        Result.Err(e) => return Result.Err(e),
    };
    if count > 0 {
        let mut total_written: usize = 0;
        while total_written < count {
            let src = unsafe { bytes + total_written };
            let remaining = count - total_written;
            let wr = match file_write(mut_view(f), src, remaining) {
                Result.Ok(n) => n,
                Result.Err(e) => return Result.Err(e),
            };
            if wr == 0 {
                return Result.Err(IoError.Other(-9));
            }
            total_written = total_written + wr;
        }
    }
    Result.Ok(())
}

module std.time

use std.core.host.monotonic_ns

pub struct Duration {
    pub nanos: u64,
}

pub fn duration_from_nanos(nanos: u64) -> Duration {
    Duration { nanos: nanos }
}

pub fn duration_from_millis(millis: u64) -> Duration {
    Duration { nanos: millis * 1_000_000u64 }
}

pub fn duration_from_secs(secs: u64) -> Duration {
    Duration { nanos: secs * 1_000_000_000u64 }
}

pub fn duration_as_nanos(d: view<Duration>) -> u64 {
    d.nanos
}

pub fn duration_as_millis(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000u64
}

pub fn duration_as_secs(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000_000u64
}

impl Duration {
    pub fn from_nanos(nanos: u64) -> Duration { duration_from_nanos(nanos) }
    pub fn from_millis(millis: u64) -> Duration { duration_from_millis(millis) }
    pub fn from_secs(secs: u64) -> Duration { duration_from_secs(secs) }
    pub fn as_nanos(self: view<Duration>) -> u64 { duration_as_nanos(self) }
    pub fn as_millis(self: view<Duration>) -> u64 { duration_as_millis(self) }
    pub fn as_secs(self: view<Duration>) -> u64 { duration_as_secs(self) }
}

pub struct Instant {
    pub nanos: u64,
}

pub fn instant_now() -> Instant {
    let t = monotonic_ns();
    Instant { nanos: t }
}

pub fn instant_duration_since(self: view<Instant>, earlier: view<Instant>) -> Duration {
    if self.nanos >= earlier.nanos {
        Duration { nanos: self.nanos - earlier.nanos }
    } else {
        Duration { nanos: 0u64 }
    }
}

pub fn instant_elapsed(self: view<Instant>) -> Duration {
    let now = instant_now();
    instant_duration_since(view(now), self)
}

pub fn instant_as_nanos(self: view<Instant>) -> u64 {
    self.nanos
}

pub fn instant_as_millis(self: view<Instant>) -> u64 {
    self.nanos / 1_000_000u64
}

pub fn instant_as_secs(self: view<Instant>) -> u64 {
    self.nanos / 1_000_000_000u64
}

impl Instant {
    pub fn now() -> Instant { instant_now() }
    pub fn duration_since(self: view<Instant>, earlier: view<Instant>) -> Duration { instant_duration_since(self, earlier) }
    pub fn elapsed(self: view<Instant>) -> Duration { instant_elapsed(self) }
}

// std.asyn.timeout - Deadline, deadline-bounded polling and task timeouts (SPEC-34 AXS-EXEC-024, T422)
//
// A `Deadline` is an absolute monotonic timestamp (`host.monotonic_ns`). It is deliberately a separate
// policy type from cancellation: `Timeout<F, T>` wraps any future and resolves to
// `Err(TimeoutError)` once the deadline has passed while the future is still pending; the future that
// did not finish is dropped (its destructors run) when the `Timeout` is dropped. Wrapping a
// `TaskHandle` therefore cancels the task when the expired `Timeout` goes away (AXS-EXEC-021).
//
// There is no timer driver yet (E11.6 / T426 brings the OS timer queue), so a pending deadline wait
// re-schedules itself with `wake_by_ref` on every poll and observes expiry by polling the clock. The
// executor therefore keeps polling a task that waits on a deadline, which is correct but not idle-free.
module std.asyn.timeout

use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.core.result.Result
use std.core.host.monotonic_ns
// `Context.waker()` is an inherent method defined in std.asyn.waker; importing the module makes it visible.
use std.asyn.waker.waker_leak

const NEVER_NS: u64 = 0xFFFFFFFFFFFFFFFFu64

@derive(Copy)
pub struct Deadline {
    pub deadline_ns: u64,
}

@derive(Copy)
pub struct TimeoutError {
    pub deadline_ns: u64,
}

impl Deadline {
    pub fn at_ns(abs_ns: u64) -> Deadline {
        Deadline { deadline_ns: abs_ns }
    }

    // `now + duration`, saturating at the maximum representable instant.
    pub fn after_ns(duration_ns: u64) -> Deadline {
        let now = monotonic_ns();
        if duration_ns >= NEVER_NS - now {
            return Deadline { deadline_ns: NEVER_NS };
        }
        Deadline { deadline_ns: now + duration_ns }
    }

    pub fn after_ms(duration_ms: u64) -> Deadline {
        if duration_ms >= 18446744073709u64 {
            return Deadline { deadline_ns: NEVER_NS };
        }
        Deadline.after_ns(duration_ms * 1000000u64)
    }

    // A deadline that never expires.
    pub fn never() -> Deadline {
        Deadline { deadline_ns: NEVER_NS }
    }

    pub fn is_expired_at(self: Deadline, now_ns: u64) -> bool {
        now_ns >= self.deadline_ns
    }

    pub fn is_expired(self: Deadline) -> bool {
        monotonic_ns() >= self.deadline_ns
    }

    pub fn remaining_ns_at(self: Deadline, now_ns: u64) -> u64 {
        if now_ns >= self.deadline_ns {
            return 0u64;
        }
        self.deadline_ns - now_ns
    }

    pub fn remaining_ns(self: Deadline) -> u64 {
        self.remaining_ns_at(monotonic_ns())
    }

    // Budget narrowing: the effective deadline of a child operation is the earlier of the two.
    pub fn min(self: Deadline, other: Deadline) -> Deadline {
        if other.deadline_ns < self.deadline_ns {
            return other;
        }
        self
    }

    pub fn max(self: Deadline, other: Deadline) -> Deadline {
        if other.deadline_ns > self.deadline_ns {
            return other;
        }
        self
    }
}

// Deadline adapter over any future (SPEC-34 AXS-EXEC-024). On each poll the inner future is polled
// first: `Ready(v)` gives `Ready(Ok(v))`; `Pending` with the deadline passed gives
// `Ready(Err(TimeoutError))`; otherwise the adapter stays pending (and re-schedules itself, see the
// module comment). The inner future is dropped with the `Timeout`.
//
// Deviation from the spec's `Timeout<F: Future>`: the output type is a second parameter
// (`Timeout<F, T>` with `F: Future<Output = T>`), inferred by `with_deadline` / `with_timeout_*`.
// The compiler cannot yet resolve `F.Output` in signatures, nor the output of a `Future` impl whose
// parameter is fixed only through a bound (`impl<F: Future<Output = T>, T> Future for Timeout<F>`
// leaves `T` unknown at every call site); see the T422c report.
pub struct Timeout<F, T> {
    pub fut: F,
    pub deadline: Deadline,
    // Never read: names `T` in the type so the `Future` impl can state its output.
    pub output_marker: *const T,
}

impl<F: Future<Output = T>, T> Timeout<F, T> {
    pub fn deadline(self: view<Timeout<F, T>>) -> Deadline {
        self.deadline
    }
}

impl<F: Future<Output = T>, T> Future for Timeout<F, T> {
    type Output = Result<T, TimeoutError>;

    fn poll(self: mut_view<Timeout<F, T>>, cx: mut_view<Context>) -> Poll<Result<T, TimeoutError>> {
        match self.fut.poll(mut_view(*cx)) {
            Poll.Ready(val) => {
                return Poll.Ready(Result.Ok(val));
            },
            Poll.Pending => {
                if self.deadline.is_expired() {
                    return Poll.Ready(Result.Err(TimeoutError { deadline_ns: self.deadline.deadline_ns }));
                }
                let w = cx.waker();
                view(w).wake_by_ref();
                return Poll.Pending;
            },
        }
    }
}

pub fn with_deadline<F: Future<Output = T>, T>(deadline: Deadline, fut: F) -> Timeout<F, T> {
    Timeout {
        fut: fut,
        deadline: deadline,
        output_marker: 0 as *const T,
    }
}

pub fn with_timeout_ns<F: Future<Output = T>, T>(duration_ns: u64, fut: F) -> Timeout<F, T> {
    with_deadline(Deadline.after_ns(duration_ns), fut)
}

pub fn with_timeout_ms<F: Future<Output = T>, T>(duration_ms: u64, fut: F) -> Timeout<F, T> {
    with_deadline(Deadline.after_ms(duration_ms), fut)
}

// std.asyn.timer - Zero-OS-Thread Reactor Timer Wheel, sleep & Interval (SPEC-35 §3, T426)
module std.asyn.timer

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.monotonic_ns
use std.core.host.thread_current_id
use std.core.host.thread_yield
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.time.Duration
use std.asyn.timeout.Deadline
// `Context.waker()` is an inherent method defined in std.asyn.waker; importing the module (through any of
// its items) makes the method visible here even when no executor module is part of the program.
use std.asyn.waker.waker_leak

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

// -----------------------------------------------------------------------------
// TimerWheel (Min-Heap ordered by (deadline_ns, timer_id), SPEC-35 AXS-AIO-020)
// -----------------------------------------------------------------------------

pub struct TimerEntry {
    pub timer_id: u64,
    pub deadline_ns: u64,
    pub waker_data: *const u8,
    pub waker_vtable: *const RawWakerVTable,
    pub cancelled: bool,
}

pub struct TimerWheel {
    pub lock: Atomic<u32>,
    pub entries: *mut TimerEntry,
    pub len: usize,
    pub cap: usize,
    pub active: usize,
    pub next_id: u64,
}

unsafe fn timer_entry_at(base: *mut TimerEntry, idx: usize) -> *mut TimerEntry {
    ((base as usize) + idx * size_of<TimerEntry>()) as *mut TimerEntry
}

fn tw_entry_less(a: *const TimerEntry, b: *const TimerEntry) -> bool {
    let da = unsafe { (*a).deadline_ns };
    let db = unsafe { (*b).deadline_ns };
    if da != db {
        return da < db;
    }
    unsafe { (*a).timer_id < (*b).timer_id }
}

unsafe fn tw_swap(base: *mut TimerEntry, i: usize, j: usize) {
    let pi = timer_entry_at(base, i);
    let pj = timer_entry_at(base, j);
    let tmp = *pi;
    *pi = *pj;
    *pj = tmp;
}

unsafe fn tw_sift_up(base: *mut TimerEntry, mut idx: usize) {
    while idx > 0 {
        let parent = (idx - 1) / 2;
        if tw_entry_less(timer_entry_at(base, idx) as *const TimerEntry, timer_entry_at(base, parent) as *const TimerEntry) {
            tw_swap(base, idx, parent);
            idx = parent;
        } else {
            break;
        }
    }
}

unsafe fn tw_sift_down(base: *mut TimerEntry, n: usize, mut idx: usize) {
    loop {
        let left = idx * 2 + 1;
        let right = left + 1;
        let mut smallest = idx;
        if left < n && tw_entry_less(timer_entry_at(base, left) as *const TimerEntry, timer_entry_at(base, smallest) as *const TimerEntry) {
            smallest = left;
        }
        if right < n && tw_entry_less(timer_entry_at(base, right) as *const TimerEntry, timer_entry_at(base, smallest) as *const TimerEntry) {
            smallest = right;
        }
        if smallest != idx {
            tw_swap(base, idx, smallest);
            idx = smallest;
        } else {
            break;
        }
    }
}

fn tw_lock(tw: mut_view<TimerWheel>) {
    while tw.lock.compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed).val != 0u32 {
        unsafe { thread_yield(); }
    }
}

fn tw_unlock(tw: mut_view<TimerWheel>) {
    tw.lock.store(0u32, Ordering.Release);
}

unsafe fn tw_drop_raw_waker(data: *const u8, vtable: *const RawWakerVTable) {
    if (vtable as usize) != 0 {
        ((*vtable).drop_waker)(data);
    }
}

unsafe fn tw_wake_raw_waker(data: *const u8, vtable: *const RawWakerVTable) {
    if (vtable as usize) != 0 {
        ((*vtable).wake)(data);
    }
}

unsafe fn tw_clone_from_cx(cx: mut_view<Context>) -> RawWaker {
    let vt = cx.waker_val.raw.vtable;
    if (vt as usize) != 0 {
        return ((*vt).clone)(cx.waker_val.raw.data);
    }
    RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable }
}

impl TimerWheel {
    pub fn new() -> TimerWheel {
        TimerWheel {
            lock: Atomic.new(0u32),
            entries: 0 as *mut TimerEntry,
            len: 0,
            cap: 0,
            active: 0,
            next_id: 1u64,
        }
    }

    pub fn is_empty(self: view<TimerWheel>) -> bool {
        self.active == 0
    }

    pub fn active_count(self: view<TimerWheel>) -> usize {
        self.active
    }

    pub fn register_raw(self: mut_view<TimerWheel>, deadline_ns: u64, waker_data: *const u8, waker_vtable: *const RawWakerVTable) -> u64 {
        tw_lock(mut_view(*self));
        if self.len >= self.cap {
            let new_cap: usize = if self.cap == 0 { 64 } else { self.cap * 2 };
            let new_bytes = new_cap * size_of<TimerEntry>();
            let new_arr = unsafe { heap_alloc(new_bytes, align_of<TimerEntry>()) as *mut TimerEntry };
            if (new_arr as usize) == 0 {
                tw_unlock(mut_view(*self));
                unsafe { tw_drop_raw_waker(waker_data, waker_vtable); }
                return 0u64;
            }
            if self.len > 0 && (self.entries as usize) != 0 {
                let mut i: usize = 0;
                while i < self.len {
                    unsafe {
                        *timer_entry_at(new_arr, i) = *timer_entry_at(self.entries, i);
                    }
                    i = i + 1;
                }
                let old_bytes = self.cap * size_of<TimerEntry>();
                unsafe { heap_free(self.entries as *mut u8, old_bytes, align_of<TimerEntry>()); }
            }
            self.entries = new_arr;
            self.cap = new_cap;
        }
        let tid = self.next_id;
        self.next_id = tid + 1u64;
        let idx = self.len;
        unsafe {
            let slot = timer_entry_at(self.entries, idx);
            (*slot).timer_id = tid;
            (*slot).deadline_ns = deadline_ns;
            (*slot).waker_data = waker_data;
            (*slot).waker_vtable = waker_vtable;
            (*slot).cancelled = false;
            self.len = idx + 1;
            self.active = self.active + 1;
            tw_sift_up(self.entries, idx);
        }
        tw_unlock(mut_view(*self));
        tid
    }

    pub fn cancel(self: mut_view<TimerWheel>, timer_id: u64) {
        if timer_id == 0u64 {
            return;
        }
        let mut drop_data: *const u8 = 0 as *const u8;
        let mut drop_vt: *const RawWakerVTable = 0 as *const RawWakerVTable;
        tw_lock(mut_view(*self));
        let mut i: usize = 0;
        while i < self.len {
            let e = unsafe { timer_entry_at(self.entries, i) };
            if unsafe { (*e).timer_id } == timer_id {
                if !(unsafe { (*e).cancelled }) {
                    unsafe {
                        (*e).cancelled = true;
                        drop_data = (*e).waker_data;
                        drop_vt = (*e).waker_vtable;
                        (*e).waker_data = 0 as *const u8;
                        (*e).waker_vtable = 0 as *const RawWakerVTable;
                    }
                    if self.active > 0 {
                        self.active = self.active - 1;
                    }
                }
                break;
            }
            i = i + 1;
        }
        tw_unlock(mut_view(*self));
        unsafe { tw_drop_raw_waker(drop_data, drop_vt); }
    }

    pub fn next_deadline_ns(self: mut_view<TimerWheel>) -> Option<u64> {
        tw_lock(mut_view(*self));
        while self.len > 0 {
            let top = unsafe { timer_entry_at(self.entries, 0) };
            if unsafe { (*top).cancelled } {
                let last = self.len - 1;
                self.len = last;
                if last > 0 {
                    unsafe {
                        *timer_entry_at(self.entries, 0) = *timer_entry_at(self.entries, last);
                        tw_sift_down(self.entries, last, 0);
                    }
                }
            } else {
                let d = unsafe { (*top).deadline_ns };
                tw_unlock(mut_view(*self));
                return Option.Some(d);
            }
        }
        tw_unlock(mut_view(*self));
        Option.None
    }

    pub fn next_expiration_delay_ns(self: mut_view<TimerWheel>) -> Option<u64> {
        match self.next_deadline_ns() {
            Option.None => Option.None,
            Option.Some(d) => {
                let now = monotonic_ns();
                if d <= now {
                    Option.Some(0u64)
                } else {
                    Option.Some(d - now)
                }
            },
        }
    }

    pub fn advance_to(self: mut_view<TimerWheel>, now_ns: u64) -> usize {
        // Collect expired wakers under the lock, then wake them outside the lock.
        let mut woke_total: usize = 0;
        loop {
            let mut batch_data: [32]usize = [0usize; 32];
            let mut batch_vt: [32]usize = [0usize; 32];
            let mut batch_len: usize = 0;

            tw_lock(mut_view(*self));
            while self.len > 0 && batch_len < 32 {
                let top = unsafe { timer_entry_at(self.entries, 0) };
                let cancelled = unsafe { (*top).cancelled };
                let dl = unsafe { (*top).deadline_ns };
                if !cancelled && dl > now_ns {
                    break;
                }
                let wd = unsafe { (*top).waker_data as usize };
                let wv = unsafe { (*top).waker_vtable as usize };
                let last = self.len - 1;
                self.len = last;
                if last > 0 {
                    unsafe {
                        *timer_entry_at(self.entries, 0) = *timer_entry_at(self.entries, last);
                        tw_sift_down(self.entries, last, 0);
                    }
                }
                if !cancelled {
                    if self.active > 0 {
                        self.active = self.active - 1;
                    }
                    batch_data[batch_len] = wd;
                    batch_vt[batch_len] = wv;
                    batch_len = batch_len + 1;
                }
            }
            tw_unlock(mut_view(*self));

            if batch_len == 0 {
                break;
            }
            let mut i: usize = 0;
            while i < batch_len {
                let wd = batch_data[i] as *const u8;
                let wv = batch_vt[i] as *const RawWakerVTable;
                unsafe { tw_wake_raw_waker(wd, wv); }
                woke_total = woke_total + 1;
                i = i + 1;
            }
        }
        woke_total
    }

    pub fn clear(self: mut_view<TimerWheel>) {
        tw_lock(mut_view(*self));
        let mut i: usize = 0;
        while i < self.len {
            let e = unsafe { timer_entry_at(self.entries, i) };
            if !(unsafe { (*e).cancelled }) {
                unsafe { tw_drop_raw_waker((*e).waker_data, (*e).waker_vtable); }
            }
            i = i + 1;
        }
        if (self.entries as usize) != 0 && self.cap > 0 {
            let bytes = self.cap * size_of<TimerEntry>();
            unsafe { heap_free(self.entries as *mut u8, bytes, align_of<TimerEntry>()); }
        }
        self.entries = 0 as *mut TimerEntry;
        self.len = 0;
        self.cap = 0;
        self.active = 0;
        tw_unlock(mut_view(*self));
    }
}

// -----------------------------------------------------------------------------
// Active Thread-Local TimerWheel Context Hook (avoids circular imports with Reactor)
// -----------------------------------------------------------------------------

const MAX_TW_THREADS: usize = 32;

struct TwThreadSlot {
    tid: u64,
    wheel: *mut TimerWheel,
}

static mut TW_CTX_LOCK: Atomic<u32> = Atomic.new(0u32);
static mut TW_CTX_SLOTS: [32]TwThreadSlot = [TwThreadSlot { tid: 0u64, wheel: 0 as *mut TimerWheel }; 32];

fn tw_ctx_lock() {
    while unsafe { TW_CTX_LOCK.compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed).val != 0u32 } {
        unsafe { thread_yield(); }
    }
}

fn tw_ctx_unlock() {
    unsafe { TW_CTX_LOCK.store(0u32, Ordering.Release); }
}

pub fn timer_wheel_enter(tw: *mut TimerWheel) -> *mut TimerWheel {
    let me = unsafe { thread_current_id() };
    tw_ctx_lock();
    let mut prev: *mut TimerWheel = 0 as *mut TimerWheel;
    let mut found_idx: usize = MAX_TW_THREADS;
    let mut free_idx: usize = MAX_TW_THREADS;
    let mut i: usize = 0;
    while i < MAX_TW_THREADS {
        let stid = unsafe { TW_CTX_SLOTS[i].tid };
        if stid == me {
            found_idx = i;
            break;
        }
        if stid == 0u64 && free_idx == MAX_TW_THREADS {
            free_idx = i;
        }
        i = i + 1;
    }
    if found_idx < MAX_TW_THREADS {
        prev = unsafe { TW_CTX_SLOTS[found_idx].wheel };
        unsafe { TW_CTX_SLOTS[found_idx].wheel = tw; }
    } else if free_idx < MAX_TW_THREADS {
        unsafe {
            TW_CTX_SLOTS[free_idx].tid = me;
            TW_CTX_SLOTS[free_idx].wheel = tw;
        }
    }
    tw_ctx_unlock();
    prev
}

pub fn timer_wheel_leave(prev: *mut TimerWheel) {
    let me = unsafe { thread_current_id() };
    tw_ctx_lock();
    let mut i: usize = 0;
    while i < MAX_TW_THREADS {
        if unsafe { TW_CTX_SLOTS[i].tid } == me {
            if (prev as usize) == 0 {
                unsafe {
                    TW_CTX_SLOTS[i].tid = 0u64;
                    TW_CTX_SLOTS[i].wheel = 0 as *mut TimerWheel;
                }
            } else {
                unsafe { TW_CTX_SLOTS[i].wheel = prev; }
            }
            break;
        }
        i = i + 1;
    }
    tw_ctx_unlock();
}

pub fn current_timer_wheel() -> *mut TimerWheel {
    let me = unsafe { thread_current_id() };
    tw_ctx_lock();
    let mut res: *mut TimerWheel = 0 as *mut TimerWheel;
    let mut i: usize = 0;
    while i < MAX_TW_THREADS {
        if unsafe { TW_CTX_SLOTS[i].tid } == me {
            res = unsafe { TW_CTX_SLOTS[i].wheel };
            break;
        }
        i = i + 1;
    }
    tw_ctx_unlock();
    res
}

// -----------------------------------------------------------------------------
// One-Shot Async Timers: SleepFuture, sleep, sleep_ns, sleep_ms, sleep_until (AXS-AIO-021)
// -----------------------------------------------------------------------------

pub struct SleepFuture {
    pub timer_id: u64,
    pub deadline: Deadline,
    pub registered: bool,
    pub completed: bool,
    pub wheel: *mut TimerWheel,
}

impl Future for SleepFuture {
    type Output = ();

    fn poll(self: mut_view<SleepFuture>, cx: mut_view<Context>) -> Poll<()> {
        if self.deadline.is_expired() {
            if self.registered && (self.wheel as usize) != 0 {
                unsafe { (*self.wheel).cancel(self.timer_id); }
                self.registered = false;
            }
            self.completed = true;
            return Poll.Ready(());
        }
        if !self.registered {
            let tw = current_timer_wheel();
            if (tw as usize) != 0 {
                let rw = unsafe { tw_clone_from_cx(mut_view(*cx)) };
                let tid = unsafe { (*tw).register_raw(self.deadline.deadline_ns, rw.data, rw.vtable) };
                self.timer_id = tid;
                self.wheel = tw;
                self.registered = true;
                return Poll.Pending;
            }
            let w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        Poll.Pending
    }
}

impl Drop for SleepFuture {
    fn drop(self: mut_view<SleepFuture>) {
        if self.registered && !self.completed && (self.wheel as usize) != 0 {
            unsafe { (*self.wheel).cancel(self.timer_id); }
            self.registered = false;
        }
    }
}

pub fn sleep_until(deadline: Deadline) -> SleepFuture {
    SleepFuture {
        timer_id: 0u64,
        deadline: deadline,
        registered: false,
        completed: false,
        wheel: 0 as *mut TimerWheel,
    }
}

pub fn sleep_ns(duration_ns: u64) -> SleepFuture {
    sleep_until(Deadline.after_ns(duration_ns))
}

pub fn sleep_ms(duration_ms: u64) -> SleepFuture {
    sleep_until(Deadline.after_ms(duration_ms))
}

pub fn sleep(duration: Duration) -> SleepFuture {
    sleep_ns(duration.nanos)
}

// -----------------------------------------------------------------------------
// Periodic Interval with Explicit Mode & MissedTickBehavior (SPEC-35 AXS-AIO-022, REQ-ASY-159)
// -----------------------------------------------------------------------------

@derive(Copy)
pub enum IntervalMode {
    FixedRate,
    FixedDelay,
}

@derive(Copy)
pub enum MissedTickBehavior {
    Burst,
    Skip,
    Delay,
}

pub struct Interval {
    pub period_ns: u64,
    pub next_tick_ns: u64,
    pub mode: IntervalMode,
    pub missed_policy: MissedTickBehavior,
}

impl Interval {
    pub fn every_ns(period_ns: u64) -> Interval {
        let p = if period_ns == 0u64 { 1u64 } else { period_ns };
        let now = monotonic_ns();
        Interval {
            period_ns: p,
            next_tick_ns: now + p,
            mode: IntervalMode.FixedRate,
            missed_policy: MissedTickBehavior.Burst,
        }
    }

    pub fn every_ms(period_ms: u64) -> Interval {
        Interval.every_ns(period_ms * 1_000_000u64)
    }

    pub fn with_mode(self: Interval, mode: IntervalMode) -> Interval {
        Interval {
            period_ns: self.period_ns,
            next_tick_ns: self.next_tick_ns,
            mode: mode,
            missed_policy: self.missed_policy,
        }
    }

    pub fn with_missed_tick_behavior(self: Interval, policy: MissedTickBehavior) -> Interval {
        Interval {
            period_ns: self.period_ns,
            next_tick_ns: self.next_tick_ns,
            mode: self.mode,
            missed_policy: policy,
        }
    }

    pub fn mode(self: view<Interval>) -> IntervalMode {
        self.mode
    }

    pub fn missed_tick_behavior(self: view<Interval>) -> MissedTickBehavior {
        self.missed_policy
    }

    pub fn next_tick_ns(self: view<Interval>) -> u64 {
        self.next_tick_ns
    }

    pub fn reset(self: mut_view<Interval>) {
        self.next_tick_ns = monotonic_ns() + self.period_ns;
    }

    pub fn tick(self: mut_view<Interval>) -> SleepFuture {
        let now = monotonic_ns();
        let p = self.period_ns;
        let is_fixed_delay = match self.mode {
            IntervalMode.FixedDelay => true,
            IntervalMode.FixedRate => false,
        };
        if is_fixed_delay {
            let target = now + p;
            self.next_tick_ns = target;
            return sleep_until(Deadline.at_ns(target));
        }

        // FixedRate mode
        if now < self.next_tick_ns + p {
            // On time or within current period: fire at next_tick_ns and advance by 1 period.
            let target = self.next_tick_ns;
            self.next_tick_ns = target + p;
            return sleep_until(Deadline.at_ns(target));
        }

        // One or more ticks were missed (now >= next_tick_ns + p)
        match self.missed_policy {
            MissedTickBehavior.Burst => {
                let target = self.next_tick_ns;
                self.next_tick_ns = target + p;
                sleep_until(Deadline.at_ns(target))
            },
            MissedTickBehavior.Skip => {
                let elapsed = now - self.next_tick_ns;
                let steps = (elapsed / p) + 1u64;
                let target = self.next_tick_ns + steps * p;
                self.next_tick_ns = target + p;
                sleep_until(Deadline.at_ns(target))
            },
            MissedTickBehavior.Delay => {
                let target = now + p;
                self.next_tick_ns = target + p;
                sleep_until(Deadline.at_ns(target))
            },
        }
    }
}

// std.asyn.reactor - Unified Completion/Readiness Reactor & Safe Buffer Retention (SPEC-35 §1-2, T426)
module std.asyn.reactor

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.core.prelude.Poll
use std.core.option.Option
use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.monotonic_ns
use std.core.host.thread_yield
use std.core.host.aio_create
use std.core.host.aio_destroy
use std.core.host.aio_wake
use std.core.host.aio_wait
use std.core.host.aio_cancel
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.io.IoError
use std.io.io_error_from_code
use std.asyn.timer.TimerWheel

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@derive(Copy)
pub struct IoOpId {
    pub raw: u64,
}

@derive(Copy)
pub enum IoOpState {
    Submitted,
    Completed,
    CancellingZombie,
    Free,
}

pub struct IoCompletion {
    pub result: i64,
    pub aux: u64,
    pub owned_buf_ptr: *mut u8,
    pub owned_buf_cap: usize,
}

pub struct IoOpSlot {
    pub op_id: u64,
    pub state: IoOpState,
    pub handle: i64,
    pub result: i64,
    pub aux: u64,
    pub waker_data: *const u8,
    pub waker_vtable: *const RawWakerVTable,
    pub owned_buf_ptr: *mut u8,
    pub owned_buf_cap: usize,
    pub user_dst_ptr: *mut u8,
    pub user_dst_len: usize,
    pub free_owned_on_reclaim: bool,
}

pub struct Reactor {
    pub os_handle: i64,
    pub lock: Atomic<u32>,
    pub slots: *mut IoOpSlot,
    pub slot_len: usize,
    pub slot_cap: usize,
    pub timers: TimerWheel,
    pub in_flight_count: usize,
    pub zombie_count: usize,
    pub reclaimed_zombie_count: usize,
    pub is_closed: bool,
}

unsafe fn op_slot_at(base: *mut IoOpSlot, idx: usize) -> *mut IoOpSlot {
    ((base as usize) + idx * size_of<IoOpSlot>()) as *mut IoOpSlot
}

fn reactor_lock(r: mut_view<Reactor>) {
    while r.lock.compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed).val != 0u32 {
        unsafe { thread_yield(); }
    }
}

fn reactor_unlock(r: mut_view<Reactor>) {
    r.lock.store(0u32, Ordering.Release);
}

fn io_state_is_free(st: IoOpState) -> bool {
    match st {
        IoOpState.Free => true,
        _ => false,
    }
}

fn io_state_is_submitted(st: IoOpState) -> bool {
    match st {
        IoOpState.Submitted => true,
        _ => false,
    }
}

fn io_state_is_completed(st: IoOpState) -> bool {
    match st {
        IoOpState.Completed => true,
        _ => false,
    }
}

fn io_state_is_zombie(st: IoOpState) -> bool {
    match st {
        IoOpState.CancellingZombie => true,
        _ => false,
    }
}

unsafe fn reactor_drop_waker(data: *const u8, vtable: *const RawWakerVTable) {
    if (vtable as usize) != 0 {
        ((*vtable).drop_waker)(data);
    }
}

unsafe fn reactor_wake_waker(data: *const u8, vtable: *const RawWakerVTable) {
    if (vtable as usize) != 0 {
        ((*vtable).wake)(data);
    }
}

unsafe fn reactor_clone_cx_waker(cx: mut_view<Context>) -> RawWaker {
    let vt = cx.waker_val.raw.vtable;
    if (vt as usize) != 0 {
        return ((*vt).clone)(cx.waker_val.raw.data);
    }
    RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable }
}

impl Reactor {
    pub fn new() -> Result<Reactor, IoError> {
        let h = aio_create();
        if h < 0i64 {
            return Result.Err(io_error_from_code(h));
        }
        Result.Ok(Reactor {
            os_handle: h,
            lock: Atomic.new(0u32),
            slots: 0 as *mut IoOpSlot,
            slot_len: 0,
            slot_cap: 0,
            timers: TimerWheel.new(),
            in_flight_count: 0,
            zombie_count: 0,
            reclaimed_zombie_count: 0,
            is_closed: false,
        })
    }

    pub fn os_handle(self: view<Reactor>) -> i64 {
        self.os_handle
    }

    pub fn has_pending_work(self: view<Reactor>) -> bool {
        self.in_flight_count > 0 || !view(self.timers).is_empty()
    }

    pub fn in_flight_count(self: view<Reactor>) -> usize {
        self.in_flight_count
    }

    pub fn zombie_count(self: view<Reactor>) -> usize {
        self.zombie_count
    }

    pub fn reclaimed_zombie_count(self: view<Reactor>) -> usize {
        self.reclaimed_zombie_count
    }

    pub fn next_timer_delay_ns(self: mut_view<Reactor>) -> Option<u64> {
        mut_view(self.timers).next_expiration_delay_ns()
    }

    pub fn register_op(
        self: mut_view<Reactor>,
        op_id: u64,
        handle: i64,
        owned_buf_ptr: *mut u8,
        owned_buf_cap: usize,
        user_dst_ptr: *mut u8,
        user_dst_len: usize,
        free_owned_on_reclaim: bool
    ) -> IoOpId {
        reactor_lock(mut_view(*self));
        let mut target_idx: usize = self.slot_len;
        let mut i: usize = 0;
        while i < self.slot_len {
            let s = unsafe { op_slot_at(self.slots, i) };
            if io_state_is_free(unsafe { (*s).state }) {
                target_idx = i;
                break;
            }
            i = i + 1;
        }
        if target_idx == self.slot_len {
            if self.slot_len >= self.slot_cap {
                let new_cap: usize = if self.slot_cap == 0 { 64 } else { self.slot_cap * 2 };
                let new_bytes = new_cap * size_of<IoOpSlot>();
                let new_arr = unsafe { heap_alloc(new_bytes, align_of<IoOpSlot>()) as *mut IoOpSlot };
                if self.slot_len > 0 && (self.slots as usize) != 0 {
                    let mut k: usize = 0;
                    while k < self.slot_len {
                        unsafe { *op_slot_at(new_arr, k) = *op_slot_at(self.slots, k); }
                        k = k + 1;
                    }
                    let old_bytes = self.slot_cap * size_of<IoOpSlot>();
                    unsafe { heap_free(self.slots as *mut u8, old_bytes, align_of<IoOpSlot>()); }
                }
                self.slots = new_arr;
                self.slot_cap = new_cap;
            }
            self.slot_len = self.slot_len + 1;
        }
        let slot = unsafe { op_slot_at(self.slots, target_idx) };
        unsafe {
            (*slot).op_id = op_id;
            (*slot).state = IoOpState.Submitted;
            (*slot).handle = handle;
            (*slot).result = 0i64;
            (*slot).aux = 0u64;
            (*slot).waker_data = 0 as *const u8;
            (*slot).waker_vtable = 0 as *const RawWakerVTable;
            (*slot).owned_buf_ptr = owned_buf_ptr;
            (*slot).owned_buf_cap = owned_buf_cap;
            (*slot).user_dst_ptr = user_dst_ptr;
            (*slot).user_dst_len = user_dst_len;
            (*slot).free_owned_on_reclaim = free_owned_on_reclaim;
        }
        self.in_flight_count = self.in_flight_count + 1;
        reactor_unlock(mut_view(*self));
        IoOpId { raw: op_id }
    }

    pub fn poll_op(self: mut_view<Reactor>, id: IoOpId, cx: mut_view<Context>) -> Poll<IoCompletion> {
        reactor_lock(mut_view(*self));
        let mut i: usize = 0;
        while i < self.slot_len {
            let s = unsafe { op_slot_at(self.slots, i) };
            if unsafe { (*s).op_id } == id.raw {
                let st = unsafe { (*s).state };
                if io_state_is_completed(st) {
                    let out = IoCompletion {
                        result: unsafe { (*s).result },
                        aux: unsafe { (*s).aux },
                        owned_buf_ptr: unsafe { (*s).owned_buf_ptr },
                        owned_buf_cap: unsafe { (*s).owned_buf_cap },
                    };
                    unsafe {
                        (*s).state = IoOpState.Free;
                        (*s).op_id = 0u64;
                        (*s).waker_data = 0 as *const u8;
                        (*s).waker_vtable = 0 as *const RawWakerVTable;
                        (*s).owned_buf_ptr = 0 as *mut u8;
                        (*s).owned_buf_cap = 0;
                        (*s).user_dst_ptr = 0 as *mut u8;
                        (*s).user_dst_len = 0;
                    }
                    reactor_unlock(mut_view(*self));
                    return Poll.Ready(out);
                }
                if io_state_is_submitted(st) {
                    let old_d = unsafe { (*s).waker_data };
                    let old_v = unsafe { (*s).waker_vtable };
                    let rw = unsafe { reactor_clone_cx_waker(mut_view(*cx)) };
                    unsafe {
                        (*s).waker_data = rw.data;
                        (*s).waker_vtable = rw.vtable;
                    }
                    reactor_unlock(mut_view(*self));
                    unsafe { reactor_drop_waker(old_d, old_v); }
                    return Poll.Pending;
                }
                break;
            }
            i = i + 1;
        }
        reactor_unlock(mut_view(*self));
        Poll.Ready(IoCompletion {
            result: -6i64,
            aux: 0u64,
            owned_buf_ptr: 0 as *mut u8,
            owned_buf_cap: 0,
        })
    }

    // Mandatory Drop protocol for in-flight I/O futures (SPEC-35 AXS-AIO-005, REQ-ASY-152, 157, 158):
    // Transitions Submitted -> CancellingZombie, clears waker & user_dst_ptr, retains owned_buf_ptr
    // until OS completion arrives, and calls host.aio_cancel.
    pub fn cancel_op(self: mut_view<Reactor>, id: IoOpId) {
        let mut need_os_cancel = false;
        let mut drop_d: *const u8 = 0 as *const u8;
        let mut drop_v: *const RawWakerVTable = 0 as *const RawWakerVTable;
        let os_h = self.os_handle;
        reactor_lock(mut_view(*self));
        let mut i: usize = 0;
        while i < self.slot_len {
            let s = unsafe { op_slot_at(self.slots, i) };
            if unsafe { (*s).op_id } == id.raw {
                let st = unsafe { (*s).state };
                if io_state_is_submitted(st) {
                    unsafe {
                        drop_d = (*s).waker_data;
                        drop_v = (*s).waker_vtable;
                        (*s).state = IoOpState.CancellingZombie;
                        (*s).waker_data = 0 as *const u8;
                        (*s).waker_vtable = 0 as *const RawWakerVTable;
                        (*s).user_dst_ptr = 0 as *mut u8;
                        (*s).user_dst_len = 0;
                    }
                    self.zombie_count = self.zombie_count + 1;
                    need_os_cancel = true;
                } else if io_state_is_completed(st) {
                    // Kernel already finished; reclaim owned buffer immediately.
                    let bp = unsafe { (*s).owned_buf_ptr };
                    let bc = unsafe { (*s).owned_buf_cap };
                    let do_free = unsafe { (*s).free_owned_on_reclaim };
                    unsafe {
                        drop_d = (*s).waker_data;
                        drop_v = (*s).waker_vtable;
                        (*s).state = IoOpState.Free;
                        (*s).op_id = 0u64;
                        (*s).waker_data = 0 as *const u8;
                        (*s).waker_vtable = 0 as *const RawWakerVTable;
                        (*s).owned_buf_ptr = 0 as *mut u8;
                        (*s).owned_buf_cap = 0;
                        (*s).user_dst_ptr = 0 as *mut u8;
                        (*s).user_dst_len = 0;
                    }
                    if do_free && (bp as usize) != 0 && bc > 0 {
                        unsafe { heap_free(bp, bc, 8); }
                    }
                }
                break;
            }
            i = i + 1;
        }
        reactor_unlock(mut_view(*self));
        unsafe { reactor_drop_waker(drop_d, drop_v); }
        if need_os_cancel {
            let _ = aio_cancel(os_h, id.raw);
        }
    }

    pub fn poll_nonblocking(self: mut_view<Reactor>) -> Result<usize, IoError> {
        self.turn(Option.Some(0u64))
    }

    pub fn turn(self: mut_view<Reactor>, max_wait_ns: Option<u64>) -> Result<usize, IoError> {
        if self.is_closed {
            return Result.Ok(0);
        }
        // Compute effective timeout bounded by the timer wheel's next expiration
        let mut timeout_ns: i64 = match max_wait_ns {
            Option.None => -1i64,
            Option.Some(v) => v as i64,
        };
        match mut_view(self.timers).next_expiration_delay_ns() {
            Option.Some(t_ns) => {
                let ti = t_ns as i64;
                if timeout_ns < 0i64 || ti < timeout_ns {
                    timeout_ns = ti;
                }
            },
            Option.None => {},
        }

        let mut raw_events: [192]u64 = [0u64; 192]; // 64 events * 3 u64s
        let n = unsafe { aio_wait(self.os_handle, address_of_mut(raw_events[0]), 64, timeout_ns) };
        if n < 0i64 {
            return Result.Err(io_error_from_code(n));
        }

        let mut woke_data: [64]usize = [0usize; 64];
        let mut woke_vt: [64]usize = [0usize; 64];
        let mut woke_len: usize = 0;

        if n > 0i64 {
            reactor_lock(mut_view(*self));
            let count = n as usize;
            let mut k: usize = 0;
            while k < count {
                let ev_op = raw_events[k * 3 + 0];
                let ev_res = raw_events[k * 3 + 1] as i64;
                let ev_aux = raw_events[k * 3 + 2];
                let mut i: usize = 0;
                while i < self.slot_len {
                    let s = unsafe { op_slot_at(self.slots, i) };
                    if unsafe { (*s).op_id } == ev_op {
                        let st = unsafe { (*s).state };
                        if io_state_is_submitted(st) {
                            unsafe {
                                (*s).state = IoOpState.Completed;
                                (*s).result = ev_res;
                                (*s).aux = ev_aux;
                            }
                            if self.in_flight_count > 0 {
                                self.in_flight_count = self.in_flight_count - 1;
                            }
                            let wd = unsafe { (*s).waker_data as usize };
                            let wv = unsafe { (*s).waker_vtable as usize };
                            unsafe {
                                (*s).waker_data = 0 as *const u8;
                                (*s).waker_vtable = 0 as *const RawWakerVTable;
                            }
                            if wv != 0usize && woke_len < 64 {
                                woke_data[woke_len] = wd;
                                woke_vt[woke_len] = wv;
                                woke_len = woke_len + 1;
                            }
                        } else if io_state_is_zombie(st) {
                            // Kernel completion arrived for abandoned op: NOW safe to free owned buffer!
                            let bp = unsafe { (*s).owned_buf_ptr };
                            let bc = unsafe { (*s).owned_buf_cap };
                            let do_free = unsafe { (*s).free_owned_on_reclaim };
                            unsafe {
                                (*s).state = IoOpState.Free;
                                (*s).op_id = 0u64;
                                (*s).waker_data = 0 as *const u8;
                                (*s).waker_vtable = 0 as *const RawWakerVTable;
                                (*s).owned_buf_ptr = 0 as *mut u8;
                                (*s).owned_buf_cap = 0;
                                (*s).user_dst_ptr = 0 as *mut u8;
                                (*s).user_dst_len = 0;
                            }
                            if self.in_flight_count > 0 {
                                self.in_flight_count = self.in_flight_count - 1;
                            }
                            if self.zombie_count > 0 {
                                self.zombie_count = self.zombie_count - 1;
                            }
                            self.reclaimed_zombie_count = self.reclaimed_zombie_count + 1;
                            if do_free && (bp as usize) != 0 && bc > 0 {
                                unsafe { heap_free(bp, bc, 8); }
                            }
                        }
                        break;
                    }
                    i = i + 1;
                }
                k = k + 1;
            }
            reactor_unlock(mut_view(*self));
        }

        // Wake I/O waiters outside the reactor lock
        let mut wi: usize = 0;
        while wi < woke_len {
            let wd = woke_data[wi] as *const u8;
            let wv = woke_vt[wi] as *const RawWakerVTable;
            unsafe { reactor_wake_waker(wd, wv); }
            wi = wi + 1;
        }

        // Advance timer wheel to current monotonic time
        let timers_woke = mut_view(self.timers).advance_to(monotonic_ns());
        Result.Ok((n as usize) + timers_woke)
    }

    pub fn wake(self: view<Reactor>) {
        if !self.is_closed && self.os_handle > 0i64 {
            let _ = aio_wake(self.os_handle);
        }
    }

    pub fn shutdown(self: mut_view<Reactor>) {
        if self.is_closed {
            return;
        }
        // Cancel all remaining submitted operations
        reactor_lock(mut_view(*self));
        let mut i: usize = 0;
        while i < self.slot_len {
            let s = unsafe { op_slot_at(self.slots, i) };
            let st = unsafe { (*s).state };
            if io_state_is_submitted(st) {
                let oid = unsafe { (*s).op_id };
                let wd = unsafe { (*s).waker_data };
                let wv = unsafe { (*s).waker_vtable };
                unsafe {
                    (*s).state = IoOpState.CancellingZombie;
                    (*s).waker_data = 0 as *const u8;
                    (*s).waker_vtable = 0 as *const RawWakerVTable;
                    (*s).user_dst_ptr = 0 as *mut u8;
                    (*s).user_dst_len = 0;
                    reactor_drop_waker(wd, wv);
                }
                self.zombie_count = self.zombie_count + 1;
                let _ = aio_cancel(self.os_handle, oid);
            }
            i = i + 1;
        }
        reactor_unlock(mut_view(*self));

        // Drain in-flight / zombie completions (bounded loop so shutdown never hangs)
        let mut drain_iters: usize = 0;
        while self.in_flight_count > 0 && drain_iters < 128 {
            let _ = self.turn(Option.Some(1_000_000u64));
            drain_iters = drain_iters + 1;
        }

        mut_view(self.timers).clear();
        if (self.slots as usize) != 0 && self.slot_cap > 0 {
            let bytes = self.slot_cap * size_of<IoOpSlot>();
            unsafe { heap_free(self.slots as *mut u8, bytes, align_of<IoOpSlot>()); }
        }
        self.slots = 0 as *mut IoOpSlot;
        self.slot_len = 0;
        self.slot_cap = 0;
        let _ = aio_destroy(self.os_handle);
        self.os_handle = 0i64;
        self.is_closed = true;
    }
}

// std.asyn.executor - LocalExecutor & Work-Stealing Multi-Thread Executor (SPEC-34 §2)
module std.asyn.executor

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.core.result.Result
use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.thread_spawn
use std.core.host.thread_join
use std.core.host.thread_current_id
use std.core.host.thread_yield
use std.core.host.futex_wait
use std.core.host.futex_wake

use std.asyn.waker.TaskHeader
use std.asyn.waker.TASK_IDLE
use std.asyn.waker.TASK_POLLING
use std.asyn.waker.TASK_NOTIFIED
use std.asyn.waker.TASK_COMPLETED
use std.asyn.waker.TASK_CANCELLED
use std.asyn.waker.TASK_PANICKED
use std.asyn.waker.FLAG_CANCEL_REQUESTED
use std.asyn.waker.FLAG_DETACHED
use std.asyn.waker.make_task_waker
use std.asyn.waker.task_wake
use std.asyn.waker.task_dec_ref
use std.asyn.waker.init_task_header_vtable
use std.asyn.waker.new_task_waker_vtable

use std.asyn.task.TaskId
use std.asyn.task.TaskHandle
use std.asyn.task.LocalTaskHandle
use std.asyn.task.TaskControlBlock
use std.asyn.task.default_task_drop
use std.asyn.task.task_poll_fn
use std.asyn.reactor.Reactor
use std.asyn.timer.TimerWheel
use std.asyn.timer.timer_wheel_enter
use std.asyn.timer.timer_wheel_leave

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// -----------------------------------------------------------------------------
// Cooperative Task Yield (AXS-EXEC-014)
// -----------------------------------------------------------------------------

pub struct YieldNowFuture {
    pub yielded: bool,
}

impl Future for YieldNowFuture {
    type Output = ();

    fn poll(self: mut_view<YieldNowFuture>, cx: mut_view<Context>) -> Poll<()> {
        if self.yielded {
            return Poll.Ready(());
        }
        self.yielded = true;
        let mut w = cx.waker();
        view(w).wake_by_ref();
        Poll.Pending
    }
}

pub fn yield_now() -> YieldNowFuture {
    YieldNowFuture { yielded: false }
}

// -----------------------------------------------------------------------------
// Single-Threaded LocalExecutor (AXS-EXEC-010)
// -----------------------------------------------------------------------------

pub struct LocalExecutor {
    pub owner_thread: u64,
    pub ready_head: *mut TaskHeader,
    pub ready_tail: *mut TaskHeader,
    pub active_tasks: usize,
    pub next_task_id: u64,
    pub waker_vtable: *const RawWakerVTable,
    pub reactor: *mut Reactor,
    pub poll_ticks: usize,
}

fn local_schedule(task: *mut TaskHeader) {
    if (task as usize) == 0 {
        return;
    }
    let p_exec = unsafe { (*task).schedule_data as *mut LocalExecutor };
    if (p_exec as usize) != 0 {
        local_enqueue(p_exec, task);
    }
}

fn local_enqueue(exec: *mut LocalExecutor, task: *mut TaskHeader) {
    if (exec as usize) == 0 {
        return;
    }
    unsafe {
        (*task).queue_next = 0 as *mut TaskHeader;
        if ((*exec).ready_tail as usize) == 0 {
            (*exec).ready_head = task;
            (*exec).ready_tail = task;
        } else {
            (*(*exec).ready_tail).queue_next = task;
            (*exec).ready_tail = task;
        }
    }
}

fn local_dequeue(exec: *mut LocalExecutor) -> *mut TaskHeader {
    if (exec as usize) == 0 {
        return 0 as *mut TaskHeader;
    }
    let h = unsafe { (*exec).ready_head };
    if (h as usize) == 0 {
        return 0 as *mut TaskHeader;
    }
    unsafe {
        (*exec).ready_head = (*h).queue_next;
        if ((*exec).ready_head as usize) == 0 {
            (*exec).ready_tail = 0 as *mut TaskHeader;
        }
        (*h).queue_next = 0 as *mut TaskHeader;
    }
    h
}

fn alloc_reactor_box() -> *mut Reactor {
    match Reactor.new() {
        Result.Ok(r) => {
            let raw = unsafe { heap_alloc(size_of<Reactor>(), align_of<Reactor>()) as *mut Reactor };
            if (raw as usize) != 0 {
                unsafe { *raw = r; }
            }
            raw
        },
        Result.Err(_) => 0 as *mut Reactor,
    }
}

impl LocalExecutor {
    pub fn new() -> LocalExecutor {
        LocalExecutor {
            owner_thread: unsafe { thread_current_id() },
            ready_head: 0 as *mut TaskHeader,
            ready_tail: 0 as *mut TaskHeader,
            active_tasks: 0,
            next_task_id: 1,
            waker_vtable: new_task_waker_vtable(),
            reactor: alloc_reactor_box(),
            poll_ticks: 0,
        }
    }

    pub fn reactor(self: view<LocalExecutor>) -> *mut Reactor {
        self.reactor
    }

    pub fn reactor_handle(self: view<LocalExecutor>) -> i64 {
        if (self.reactor as usize) == 0 {
            return -4i64;
        }
        unsafe { (*self.reactor).os_handle }
    }

    pub fn shutdown(self: mut_view<LocalExecutor>) {
        if (self.reactor as usize) != 0 {
            unsafe {
                mut_view(*self.reactor).shutdown();
                heap_free(self.reactor as *mut u8, size_of<Reactor>(), align_of<Reactor>());
            }
            self.reactor = 0 as *mut Reactor;
        }
    }

    // Submit `fut` as a task pinned to this executor's thread; no `Send` requirement (AXS-EXEC-010).
    pub fn spawn_local<F: Future<Output = T>, T>(self: mut_view<LocalExecutor>, fut: F) -> LocalTaskHandle<T> {
        let p_self = unsafe { address_of_mut(*self) as *mut LocalExecutor };
        let sz = size_of<TaskControlBlock<F, T>>();
        let al = align_of<TaskControlBlock<F, T>>();
        let raw = unsafe { heap_alloc(sz, al) };
        let tcb = raw as *mut TaskControlBlock<F, T>;
        let tid = TaskId { id: self.next_task_id };
        self.next_task_id = self.next_task_id + 1u64;

        unsafe {
            init_task_header_vtable(raw as *mut TaskHeader, self.waker_vtable);
            (*tcb).slot.header.state = Atomic.new(TASK_NOTIFIED);
            (*tcb).slot.header.ref_count = Atomic.new(2u32);
            (*tcb).slot.header.task_id = tid.id;
            (*tcb).slot.header.owner_thread_id = self.owner_thread;
            (*tcb).slot.header.queue_next = 0 as *mut TaskHeader;
            (*tcb).slot.header.schedule_fn = local_schedule;
            (*tcb).slot.header.poll_fn = task_poll_fn<F, T>;
            (*tcb).slot.header.drop_fn = default_task_drop;
            (*tcb).slot.header.schedule_data = p_self as *mut u8;
            (*tcb).slot.header.alloc_size = sz;
            (*tcb).slot.header.alloc_align = al;
            (*tcb).slot.has_output = false;
            (*tcb).slot.join_state = Atomic.new(0u32);
            (*tcb).future = fut;
            (*tcb).has_future = true;
        }

        local_enqueue(p_self, raw as *mut TaskHeader);
        self.active_tasks = self.active_tasks + 1;

        LocalTaskHandle {
            raw_task: raw as *mut TaskHeader,
            task_id: tid,
        }
    }

    pub fn try_tick(self: mut_view<LocalExecutor>) -> bool {
        self.poll_ticks = self.poll_ticks + 1;
        if (self.reactor as usize) != 0 && ((self.ready_head as usize) == 0 || (self.poll_ticks & 31usize) == 0usize) {
            let _ = unsafe { mut_view(*self.reactor).poll_nonblocking() };
        }
        let p_self = unsafe { address_of_mut(*self) as *mut LocalExecutor };
        let task = local_dequeue(p_self);
        if (task as usize) == 0 {
            return false;
        }
        let prev_tw = if (self.reactor as usize) != 0 {
            timer_wheel_enter(unsafe { address_of_mut((*self.reactor).timers) })
        } else {
            0 as *mut TimerWheel
        };
        let w = make_task_waker(task);
        let mut cx = Context { waker_val: w };
        let st: u32 = unsafe { ((*task).poll_fn)(task as *mut u8, address_of_mut<Context>(cx) as *mut u8) };
        if (self.reactor as usize) != 0 {
            timer_wheel_leave(prev_tw);
        }
        if st >= TASK_COMPLETED {
            if self.active_tasks > 0 {
                self.active_tasks = self.active_tasks - 1;
            }
            task_dec_ref(task);
        }
        true
    }

    pub fn run(self: mut_view<LocalExecutor>) {
        while self.active_tasks > 0 {
            if !self.try_tick() {
                if (self.reactor as usize) != 0 && unsafe { view(*self.reactor).has_pending_work() } {
                    let delay = unsafe { mut_view(*self.reactor).next_timer_delay_ns() };
                    let _ = unsafe { mut_view(*self.reactor).turn(delay) };
                } else {
                    unsafe {
                        thread_yield();
                    }
                }
            }
        }
    }

    pub fn run_until<F: Future<Output = T>, T>(self: mut_view<LocalExecutor>, mut main_fut: F) -> T {
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        loop {
            let prev_tw = if (self.reactor as usize) != 0 {
                timer_wheel_enter(unsafe { address_of_mut((*self.reactor).timers) })
            } else {
                0 as *mut TimerWheel
            };
            let poll_res = main_fut.poll(mut_view(cx));
            if (self.reactor as usize) != 0 {
                timer_wheel_leave(prev_tw);
            }
            match poll_res {
                Poll.Ready(val) => {
                    return val;
                },
                Poll.Pending => {
                    if !self.try_tick() {
                        if (self.reactor as usize) != 0 && unsafe { view(*self.reactor).has_pending_work() } {
                            let delay = unsafe { mut_view(*self.reactor).next_timer_delay_ns() };
                            let _ = unsafe { mut_view(*self.reactor).turn(delay) };
                        } else {
                            unsafe {
                                thread_yield();
                            }
                        }
                    }
                },
            }
        }
    }

    pub fn block_on<F: Future<Output = T>, T>(self: mut_view<LocalExecutor>, fut: F) -> T {
        self.run_until(fut)
    }

    pub fn active_task_count(self: view<LocalExecutor>) -> usize {
        self.active_tasks
    }
}

// -----------------------------------------------------------------------------
// Multi-Threaded Work-Stealing Executor (AXS-EXEC-011..012)
// -----------------------------------------------------------------------------

pub struct ExecutorConfig {
    pub worker_count: usize,
    pub local_queue_capacity: usize,
    pub global_queue_capacity: usize,
}

const LOCAL_QUEUE_CAP: usize = 256;

@repr(C)
pub struct WorkerData {
    pub worker_id: usize,
    pub thread_handle: i64,
    pub head: Atomic<usize>,
    pub tail: Atomic<usize>,
    pub queue: [256]*mut TaskHeader,
    // The owning executor state.
    pub executor: *mut ExecutorInner,
    // OS thread id of the worker (0 until the worker thread has started).
    pub tid: Atomic<u64>,
}

@repr(C)
pub struct ExecutorInner {
    pub worker_count: usize,
    pub workers: *mut WorkerData,
    pub global_head: *mut TaskHeader,
    pub global_tail: *mut TaskHeader,
    pub global_lock: Atomic<u32>,
    pub global_count: Atomic<usize>,
    pub shutdown: Atomic<bool>,
    pub park_word: Atomic<u32>,
    pub active_tasks: Atomic<usize>,
    pub next_task_id: Atomic<u64>,
    pub waker_vtable: *const RawWakerVTable,
    pub steal_count: Atomic<usize>,
    pub reactor: *mut Reactor,
}

// A copyable handle to the shared executor state (like an Arc handle): tasks may hold a copy to spawn
// child tasks. `shutdown` must be called on exactly one handle once all work has completed.
@derive(Copy)
pub struct Executor {
    pub inner: *mut ExecutorInner,
}

fn spin_lock(inner: *mut ExecutorInner) {
    while unsafe { (*inner).global_lock.compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed).val != 0u32 } {
        unsafe {
            thread_yield();
        }
    }
}

fn spin_unlock(inner: *mut ExecutorInner) {
    unsafe {
        (*inner).global_lock.store(0u32, Ordering.Release);
    }
}

fn executor_global_enqueue(inner: *mut ExecutorInner, task: *mut TaskHeader) {
    spin_lock(inner);
    unsafe {
        (*task).queue_next = 0 as *mut TaskHeader;
        if ((*inner).global_tail as usize) == 0 {
            (*inner).global_head = task;
            (*inner).global_tail = task;
        } else {
            (*(*inner).global_tail).queue_next = task;
            (*inner).global_tail = task;
        }
        (*inner).global_count.fetch_add(1usize, Ordering.Release);
        (*inner).park_word.fetch_add(1u32, Ordering.Release);
        futex_wake(address_of((*inner).park_word) as *const u32, 1u32);
    }
    spin_unlock(inner);
}

fn executor_global_dequeue(inner: *mut ExecutorInner) -> *mut TaskHeader {
    spin_lock(inner);
    let h = unsafe { (*inner).global_head };
    if (h as usize) != 0 {
        unsafe {
            (*inner).global_head = (*h).queue_next;
            if ((*inner).global_head as usize) == 0 {
                (*inner).global_tail = 0 as *mut TaskHeader;
            }
            (*h).queue_next = 0 as *mut TaskHeader;
            (*inner).global_count.fetch_sub(1usize, Ordering.Release);
        }
    }
    spin_unlock(inner);
    h
}

fn worker_push_local(w: *mut WorkerData, task: *mut TaskHeader) -> bool {
    let t: usize = unsafe { (*w).tail.load(Ordering.Relaxed) };
    let h: usize = unsafe { (*w).head.load(Ordering.Acquire) };
    if t >= h {
        if (t - h) >= LOCAL_QUEUE_CAP {
            return false;
        }
    }
    let idx = t % LOCAL_QUEUE_CAP;
    unsafe {
        (*w).queue[idx] = task;
        (*w).tail.store(t + 1usize, Ordering.Release);
    }
    true
}

fn worker_pop_local(w: *mut WorkerData) -> *mut TaskHeader {
    let t: usize = unsafe { (*w).tail.load(Ordering.Relaxed) };
    let h: usize = unsafe { (*w).head.load(Ordering.Acquire) };
    if t <= h {
        return 0 as *mut TaskHeader;
    }
    let new_t: usize = t - 1usize;
    unsafe {
        (*w).tail.store(new_t, Ordering.SeqCst);
    }
    let h_now: usize = unsafe { (*w).head.load(Ordering.SeqCst) };
    if h_now <= new_t {
        let idx = new_t % LOCAL_QUEUE_CAP;
        let task = unsafe { (*w).queue[idx] };
        if h_now == new_t {
            let cas = unsafe { (*w).head.compare_exchange(h_now, h_now + 1usize, Ordering.AcqRel, Ordering.Relaxed) };
            unsafe {
                (*w).tail.store(h_now + 1usize, Ordering.Relaxed);
            }
            if !cas.ok {
                return 0 as *mut TaskHeader;
            }
        }
        return task;
    } else {
        unsafe {
            (*w).tail.store(h_now, Ordering.Relaxed);
        }
        return 0 as *mut TaskHeader;
    }
}

fn worker_steal_from(victim: *mut WorkerData) -> *mut TaskHeader {
    let h: usize = unsafe { (*victim).head.load(Ordering.Acquire) };
    let t: usize = unsafe { (*victim).tail.load(Ordering.Acquire) };
    if h >= t {
        return 0 as *mut TaskHeader;
    }
    let idx = h % LOCAL_QUEUE_CAP;
    let task = unsafe { (*victim).queue[idx] };
    let cas = unsafe { (*victim).head.compare_exchange(h, h + 1usize, Ordering.AcqRel, Ordering.Relaxed) };
    if cas.ok {
        task
    } else {
        0 as *mut TaskHeader
    }
}

// Returns the WorkerData of the calling OS thread, or null when the caller is not a worker thread.
fn current_worker(inner: *mut ExecutorInner) -> *mut WorkerData {
    let me: u64 = unsafe { thread_current_id() };
    let n: usize = unsafe { (*inner).worker_count };
    let base: *mut WorkerData = unsafe { (*inner).workers };
    let mut i: usize = 0usize;
    while i < n {
        let w: *mut WorkerData = unsafe { base + i };
        let tid: u64 = unsafe { (*w).tid.load(Ordering.Acquire) };
        if tid == me {
            return w;
        }
        i = i + 1usize;
    }
    0 as *mut WorkerData
}

// A wake issued from a worker thread goes to that worker's local deque (single producer: the owner);
// wakes from other threads, or a full local deque, go to the bounded-order global injection queue.
fn executor_schedule(task: *mut TaskHeader) {
    if (task as usize) == 0 {
        return;
    }
    let inner = unsafe { (*task).schedule_data as *mut ExecutorInner };
    if (inner as usize) != 0 {
        let w = current_worker(inner);
        if (w as usize) != 0 {
            if worker_push_local(w, task) {
                return;
            }
        }
        executor_global_enqueue(inner, task);
    }
}

fn executor_try_help_one(inner: *mut ExecutorInner) -> bool {
    let task = executor_global_dequeue(inner);
    if (task as usize) == 0 {
        return false;
    }
    let w = make_task_waker(task);
    let mut cx = Context { waker_val: w };
    let r = unsafe { (*inner).reactor };
    let prev_tw = if (r as usize) != 0 {
        timer_wheel_enter(unsafe { address_of_mut((*r).timers) })
    } else {
        0 as *mut TimerWheel
    };
    let st: u32 = unsafe { ((*task).poll_fn)(task as *mut u8, address_of_mut<Context>(cx) as *mut u8) };
    if (r as usize) != 0 {
        timer_wheel_leave(prev_tw);
    }
    if st >= TASK_COMPLETED {
        unsafe {
            (*inner).active_tasks.fetch_sub(1usize, Ordering.Release);
        }
        task_dec_ref(task);
    }
    true
}

fn worker_thread_main(ctx: *mut u8) -> i64 {
    let w = ctx as *mut WorkerData;
    let inner = unsafe { (*w).executor };
    unsafe {
        (*w).tid.store(thread_current_id(), Ordering.Release);
    }
    let mut poll_count: usize = 0usize;


    loop {
        let is_shutdown: bool = unsafe { (*inner).shutdown.load(Ordering.Acquire) };
        if is_shutdown {
            let active: usize = unsafe { (*inner).active_tasks.load(Ordering.Acquire) };
            if active == 0usize {
                break;
            }
        }
        poll_count = poll_count + 1usize;
        let mut task: *mut TaskHeader = 0 as *mut TaskHeader;

        // 1. Every 61 polls, check global queue first (fairness tick)
        if (poll_count % 61usize) == 0usize {
            task = executor_global_dequeue(inner);
        }

        // 2. Otherwise pop from local queue
        if (task as usize) == 0 {
            task = worker_pop_local(w);
        }

        // 3. If local empty, check global queue
        if (task as usize) == 0 {
            task = executor_global_dequeue(inner);
        }

        // 4. If global also empty, attempt work stealing
        if (task as usize) == 0 {
            let num_workers: usize = unsafe { (*inner).worker_count };
            let workers_base: *mut WorkerData = unsafe { (*inner).workers };
            let my_id: usize = unsafe { (*w).worker_id };
            let mut i: usize = 0usize;
            while i < num_workers {
                let victim_id: usize = (my_id + 1usize + i) % num_workers;
                if victim_id != my_id {
                    let victim: *mut WorkerData = unsafe { workers_base + victim_id };
                    let stolen = worker_steal_from(victim);
                    if (stolen as usize) != 0 {
                        unsafe {
                            (*inner).steal_count.fetch_add(1usize, Ordering.Relaxed);
                        }
                        task = stolen;
                        break;
                    }
                }
                i = i + 1usize;
            }
        }

        // 5. If task found, execute poll
        let r = unsafe { (*inner).reactor };
        if (task as usize) != 0 {
            let prev_tw = if (r as usize) != 0 {
                timer_wheel_enter(unsafe { address_of_mut((*r).timers) })
            } else {
                0 as *mut TimerWheel
            };
            let task_w = make_task_waker(task);
            let mut cx = Context { waker_val: task_w };
            let st: u32 = unsafe { ((*task).poll_fn)(task as *mut u8, address_of_mut<Context>(cx) as *mut u8) };
            if (r as usize) != 0 {
                timer_wheel_leave(prev_tw);
            }
            if st >= TASK_COMPLETED {
                unsafe {
                    (*inner).active_tasks.fetch_sub(1usize, Ordering.Release);
                }
                task_dec_ref(task);
            }
        } else {
            // No work found across all sources: poll/turn reactor if pending work, else yield
            if (r as usize) != 0 && unsafe { view(*r).has_pending_work() } {
                let _ = unsafe { mut_view(*r).turn(Option.Some(1_000_000u64)) };
            } else {
                unsafe {
                    thread_yield();
                }
            }
        }
    }
    0i64
}

impl Executor {
    pub fn new(worker_count: usize) -> Executor {
        let count = if worker_count == 0 { 1usize } else { worker_count };
        let sz_inner = size_of<ExecutorInner>();
        let al_inner = align_of<ExecutorInner>();
        let raw_inner = unsafe { heap_alloc(sz_inner, al_inner) };
        let inner = raw_inner as *mut ExecutorInner;

        let sz_workers = count * size_of<WorkerData>();
        let al_workers = align_of<WorkerData>();
        let raw_workers = unsafe { heap_alloc(sz_workers, al_workers) };
        let workers = raw_workers as *mut WorkerData;

        unsafe {
            (*inner).worker_count = count;
            (*inner).workers = workers;
            (*inner).global_head = 0 as *mut TaskHeader;
            (*inner).global_tail = 0 as *mut TaskHeader;
            (*inner).global_lock = Atomic.new(0u32);
            (*inner).global_count = Atomic.new(0usize);
            (*inner).shutdown = Atomic.new(false);
            (*inner).park_word = Atomic.new(0u32);
            (*inner).active_tasks = Atomic.new(0usize);
            (*inner).next_task_id = Atomic.new(1u64);
            (*inner).waker_vtable = new_task_waker_vtable();
            (*inner).steal_count = Atomic.new(0usize);
            (*inner).reactor = alloc_reactor_box();

            let mut i: usize = 0usize;
            while i < count {
                let w: *mut WorkerData = workers + i;
                (*w).worker_id = i;
                (*w).thread_handle = 0i64;
                (*w).head = Atomic.new(0usize);
                (*w).tail = Atomic.new(0usize);
                (*w).executor = inner;
                (*w).tid = Atomic.new(0u64);
                let mut k: usize = 0usize;
                while k < LOCAL_QUEUE_CAP {
                    (*w).queue[k] = 0 as *mut TaskHeader;
                    k = k + 1usize;
                }
                i = i + 1usize;
            }

            // Spawn worker OS threads
            let mut j: usize = 0usize;
            while j < count {
                let w: *mut WorkerData = workers + j;
                let th = thread_spawn(worker_thread_main, w as *mut u8, 0usize);
                (*w).thread_handle = th;
                j = j + 1usize;
            }
        }

        Executor { inner: inner }
    }

    // Submit `fut` to the worker pool. The task may migrate between worker threads at every `.await`,
    // so the future and its output must be `Send` (AXS-EXEC-011).
    pub fn spawn<F: Future<Output = T> + Send, T: Send>(self: view<Executor>, fut: F) -> TaskHandle<T> {
        let inner = self.inner;
        let sz = size_of<TaskControlBlock<F, T>>();
        let al = align_of<TaskControlBlock<F, T>>();
        let raw = unsafe { heap_alloc(sz, al) };
        let tcb = raw as *mut TaskControlBlock<F, T>;
        let tid_val = unsafe { (*inner).next_task_id.fetch_add(1u64, Ordering.Relaxed) };
        let tid = TaskId { id: tid_val };

        unsafe {
            init_task_header_vtable(raw as *mut TaskHeader, (*inner).waker_vtable);
            (*tcb).slot.header.state = Atomic.new(TASK_NOTIFIED);
            (*tcb).slot.header.ref_count = Atomic.new(2u32);
            (*tcb).slot.header.task_id = tid.id;
            (*tcb).slot.header.owner_thread_id = 0u64;
            (*tcb).slot.header.queue_next = 0 as *mut TaskHeader;
            (*tcb).slot.header.schedule_fn = executor_schedule;
            (*tcb).slot.header.poll_fn = task_poll_fn<F, T>;
            (*tcb).slot.header.drop_fn = default_task_drop;
            (*tcb).slot.header.schedule_data = inner as *mut u8;
            (*tcb).slot.header.alloc_size = sz;
            (*tcb).slot.header.alloc_align = al;
            (*tcb).slot.has_output = false;
            (*tcb).slot.join_state = Atomic.new(0u32);
            (*tcb).future = fut;
            (*tcb).has_future = true;

            (*inner).active_tasks.fetch_add(1usize, Ordering.Release);
        }

        executor_schedule(raw as *mut TaskHeader);

        TaskHandle {
            raw_task: raw as *mut TaskHeader,
            task_id: tid,
        }
    }

    pub fn block_on<F: Future<Output = T>, T>(self: view<Executor>, mut fut: F) -> T {
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        let r = unsafe { (*self.inner).reactor };
        loop {
            let prev_tw = if (r as usize) != 0 {
                timer_wheel_enter(unsafe { address_of_mut((*r).timers) })
            } else {
                0 as *mut TimerWheel
            };
            let poll_res = fut.poll(mut_view(cx));
            if (r as usize) != 0 {
                timer_wheel_leave(prev_tw);
            }
            match poll_res {
                Poll.Ready(val) => {
                    return val;
                },
                Poll.Pending => {
                    if !executor_try_help_one(self.inner) {
                        if (r as usize) != 0 && unsafe { view(*r).has_pending_work() } {
                            let delay = unsafe { mut_view(*r).next_timer_delay_ns() };
                            let _ = unsafe { mut_view(*r).turn(delay) };
                        } else {
                            unsafe {
                                thread_yield();
                            }
                        }
                    }
                },
            }
        }
    }

    pub fn reactor(self: view<Executor>) -> *mut Reactor {
        unsafe { (*self.inner).reactor }
    }

    pub fn reactor_handle(self: view<Executor>) -> i64 {
        let r = unsafe { (*self.inner).reactor };
        if (r as usize) == 0 {
            return -4i64;
        }
        unsafe { (*r).os_handle }
    }

    pub fn worker_count(self: view<Executor>) -> usize {
        unsafe { (*self.inner).worker_count }
    }

    // Number of tasks that were taken from another worker's local deque (diagnostics / tests).
    pub fn steal_count(self: view<Executor>) -> usize {
        unsafe { (*self.inner).steal_count.load(Ordering.Relaxed) }
    }

    pub fn shutdown(self: view<Executor>) {
        let inner = self.inner;
        if (inner as usize) == 0 {
            return;
        }
        unsafe {
            (*inner).shutdown.store(true, Ordering.Release);
            (*inner).park_word.fetch_add(1u32, Ordering.Release);
            futex_wake(address_of((*inner).park_word) as *const u32, (*inner).worker_count as u32);
            let r = (*inner).reactor;
            if (r as usize) != 0 {
                view(*r).wake();
            }

            let count = (*inner).worker_count;
            let mut i: usize = 0usize;
            while i < count {
                let w: *mut WorkerData = (*inner).workers + i;
                let th = (*w).thread_handle;
                if th > 0i64 {
                    let mut ret: i64 = 0i64;
                    let _ = thread_join(th, address_of_mut(ret));
                    (*w).thread_handle = 0i64;
                }
                i = i + 1usize;
            }
            if (r as usize) != 0 {
                mut_view(*r).shutdown();
                heap_free(r as *mut u8, size_of<Reactor>(), align_of<Reactor>());
                (*inner).reactor = 0 as *mut Reactor;
            }
        }
    }
}

module main

use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.core.option.Option
use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.asyn.waker.TaskHeader
use std.asyn.waker.TASK_POLLING
use std.asyn.waker.TASK_NOTIFIED
use std.asyn.waker.init_task_header_vtable
use std.asyn.waker.new_task_waker_vtable
use std.asyn.waker.task_wake
use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskResult

fn check(cond: bool) {
    if !cond {
        loop {}
    }
}

pub struct RacingFuture {
    pub poll_count: usize,
    pub target_count: usize,
}

impl Future for RacingFuture {
    type Output = usize;

    fn poll(self: mut_view<RacingFuture>, cx: mut_view<Context>) -> Poll<usize> {
        self.poll_count = self.poll_count + 1;
        if self.poll_count >= self.target_count {
            return Poll.Ready(self.poll_count);
        }
        let mut w = cx.waker();
        view(w).wake_by_ref();
        Poll.Pending
    }
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();

    // 1. Direct state-machine invariant test:
    let sz = 128usize;
    let raw = unsafe { heap_alloc(sz, 8usize) } as *mut TaskHeader;
    init_task_header_vtable(raw, new_task_waker_vtable());
    unsafe {
        (*raw).state = Atomic.new(TASK_POLLING);
        (*raw).ref_count = Atomic.new(1u32);
        (*raw).alloc_size = sz;
        (*raw).alloc_align = 8usize;
    }
    task_wake(raw);
    // A wake during a poll leaves a sticky permit: POLLING|NOTIFIED (T421a state encoding), so the
    // poller re-queues the task when the poll ends; the waker itself must not enqueue it.
    let st: u32 = unsafe { (*raw).state.load(Ordering.Acquire) } & 0xFu32;
    check(st == (TASK_POLLING | TASK_NOTIFIED));
    unsafe { heap_free(raw as *mut u8, sz, 8usize); }

    // 2. Full executor test with 50 racing poll/wake iterations
    let h = exec.spawn_local(RacingFuture { poll_count: 0, target_count: 50 });
    while !view(h).is_finished() {
        exec.try_tick();
    }
    let res = match h.join_blocking() {
        TaskResult.Completed(v) => v,
        _ => 0usize,
    };
    check(res == 50usize);

    print("OK lost_wake_prevention ");
    print_int(res as i64);
    print("\n");
    0
}
