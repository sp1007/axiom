    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

@derive(Copy)
pub struct CasResult<T> {
    pub ok: bool,
    pub val: T,
}

@lang("atomic")
pub struct Atomic<T> {
    pub v: T,
}

