    ) -> *mut u8;
    fn WaitForSingleObject(hHandle: *mut u8, dwMilliseconds: u32) -> u32;
    fn CloseHandle(hObject: *mut u8) -> i32;
    fn GetCurrentThreadId() -> u32;
    fn SwitchToThread() -> i32;
    fn Sleep(dwMilliseconds: u32);
