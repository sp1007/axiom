    pub fn is_lock_free() -> bool {
        true
    }

    pub fn load(self: view<Atomic<T>>, order: Ordering) -> T {
        loop {}
    }

    pub fn store(self: view<Atomic<T>>, val: T, order: Ordering) {}

    pub fn swap(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
