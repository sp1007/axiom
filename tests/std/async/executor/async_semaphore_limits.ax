@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

@repr(C)
struct WinThreadSlot {
    in_use: u32,
    finished: u32,
    detached: u32,
    joining: u32,
    panicked: u32,
    win_tid: u32,
    generation: u32,
    pad0: u32,
    logical_id: u64,
    os_handle: *mut u8,
    entry: fn(*mut u8) -> i64,
    ctx: *mut u8,
    ret_val: i64,
}

@repr(C)
struct WinThreadRt {
    cs: [6]u64,
    main_win_tid: u32,
    pad0: u32,
    orig_exit_process: usize,
    next_logical_id: u64,
    slots: *mut *mut WinThreadSlot,
    slot_cap: usize,
}

unsafe fn fn_entry_to_addr(f: fn(*mut u8) -> i64) -> usize {
    let tmp: [1]fn(*mut u8) -> i64 = [f];
    *(address_of(tmp[0]) as *const usize)
}

unsafe fn fn_exit_to_addr(f: fn(u32) -> u32) -> usize {
    let tmp: [1]fn(u32) -> u32 = [f];
    *(address_of(tmp[0]) as *const usize)
}

unsafe fn addr_to_fn_exit(addr: usize) -> fn(u32) -> u32 {
    let tmp: [1]usize = [addr];
    *(address_of(tmp[0]) as *const fn(u32) -> u32)
}

unsafe fn slot_ptr_at(arr: *mut *mut WinThreadSlot, idx: usize) -> *mut *mut WinThreadSlot {
    ((arr as usize) + idx * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot
}

unsafe fn pe_first_import_desc() -> *mut u8 {
    let base = GetModuleHandleA(0 as *const u8);
    if (base as usize) == 0 {
        return 0 as *mut u8;
    }
    if *((base as *const u16)) != 0x5A4Du16 {
        return 0 as *mut u8;
    }
    let lfanew = *((base + 0x3C) as *const u32) as usize;
    let nt = base + lfanew;
    if *((nt as *const u32)) != 0x00004550u32 {
        return 0 as *mut u8;
    }
    let opt = nt + 24;
    if *((opt as *const u16)) != 0x020Bu16 {
        return 0 as *mut u8;
    }
    let imp_rva = *((opt + 120) as *const u32) as usize;
    if imp_rva == 0 {
        return 0 as *mut u8;
    }
    base + imp_rva
}

unsafe fn win_rt_peek() -> *mut WinThreadRt {
    let desc0 = pe_first_import_desc();
    if (desc0 as usize) == 0 {
        return 0 as *mut WinThreadRt;
    }
    let lo = *((desc0 + 4) as *const u32) as usize;
    let hi = *((desc0 + 8) as *const u32) as usize;
    (lo | (hi << 32)) as *mut WinThreadRt
}

fn win_exit_process_hook(code: u32) -> u32 {
    unsafe {
        let rt = win_rt_peek();
        if (rt as usize) != 0 {
            let cur_tid = GetCurrentThreadId();
            if cur_tid != (*rt).main_win_tid && code == 101u32 {
                let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
                EnterCriticalSection(cs_ptr);
                let mut idx: usize = 1;
                while idx < (*rt).slot_cap {
                    let s = *slot_ptr_at((*rt).slots, idx);
                    if (s as usize) != 0 && (*s).in_use != 0u32 && (*s).finished == 0u32 && (*s).win_tid == cur_tid {
                        (*s).panicked = 1u32;
                        (*s).ret_val = -101i64;
                        (*s).finished = 1u32;
                        (*s).win_tid = 0u32;
                        if (*s).detached != 0u32 {
                            let h = (*s).os_handle;
                            (*s).os_handle = 0 as *mut u8;
                            (*s).in_use = 0u32;
                            LeaveCriticalSection(cs_ptr);
                            if (h as usize) != 0 {
                                CloseHandle(h);
                            }
                        } else {
                            let p_ctx = (*s).ctx;
                            if (p_ctx as usize) != 0 && *(p_ctx as *const u64) == 0x4158544852504B54u64 {
                                let lw = (p_ctx + 8) as *mut u32;
                                *lw = (*lw) | 1u32;
                            }
                            LeaveCriticalSection(cs_ptr);
                        }
                        ExitThread(101u32);
                    }
                    idx = idx + 1;
                }
                LeaveCriticalSection(cs_ptr);
            }
            if (*rt).orig_exit_process != 0usize {
                let orig = addr_to_fn_exit((*rt).orig_exit_process);
                orig(code);
            }
        }
        ExitProcess(code);
        0u32
    }
}

unsafe fn win_install_exit_hook(rt: *mut WinThreadRt) {
    let base = GetModuleHandleA(0 as *const u8);
    let desc0 = pe_first_import_desc();
    if (base as usize) == 0 || (desc0 as usize) == 0 {
        return;
    }
    let k32_name: [13]u8 = [107u8, 101u8, 114u8, 110u8, 101u8, 108u8, 51u8, 50u8, 46u8, 100u8, 108u8, 108u8, 0u8];
    let ep_name: [12]u8 = [69u8, 120u8, 105u8, 116u8, 80u8, 114u8, 111u8, 99u8, 101u8, 115u8, 115u8, 0u8];
    let hk32 = GetModuleHandleA(address_of(k32_name[0]));
    if (hk32 as usize) == 0 {
        return;
    }
    let real_ep = GetProcAddress(hk32, address_of(ep_name[0])) as usize;
    if real_ep == 0usize {
        return;
    }
    (*rt).orig_exit_process = real_ep;
    let hook_addr = fn_exit_to_addr(win_exit_process_hook);
    let mut d = desc0;
    while *((d + 16) as *const u32) != 0u32 {
        let ft_rva = *((d + 16) as *const u32) as usize;
        let mut iat = (base + ft_rva) as *mut usize;
        while *iat != 0usize {
            if *iat == real_ep {
                let mut old_prot: [1]u32 = [0u32];
                let ok = VirtualProtect(iat as *mut u8, 8usize, 0x04u32, address_of_mut(old_prot[0]));
                if ok != 0 {
                    *iat = hook_addr;
                    let mut tmp_prot: [1]u32 = [0u32];
                    VirtualProtect(iat as *mut u8, 8usize, old_prot[0], address_of_mut(tmp_prot[0]));
                }
            }
            iat = ((iat as usize) + 8usize) as *mut usize;
        }
        d = d + 20;
    }
}

unsafe fn win_rt_get() -> *mut WinThreadRt {
    let existing = win_rt_peek();
    if (existing as usize) != 0 {
        return existing;
    }
    let desc0 = pe_first_import_desc();
    let heap = GetProcessHeap();
    if (desc0 as usize) == 0 || (heap as usize) == 0 {
        return 0 as *mut WinThreadRt;
    }
    let rt = HeapAlloc(heap, 8u32, size_of<WinThreadRt>()) as *mut WinThreadRt;
    if (rt as usize) == 0 {
        return 0 as *mut WinThreadRt;
    }
    let init_cap: usize = 256;
    let slots = HeapAlloc(heap, 8u32, init_cap * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot;
    if (slots as usize) == 0 {
        HeapFree(heap, 0u32, rt as *mut u8);
        return 0 as *mut WinThreadRt;
    }
    InitializeCriticalSection(address_of_mut((*rt).cs[0]) as *mut u8);
    (*rt).main_win_tid = GetCurrentThreadId();
    (*rt).next_logical_id = 2u64;
    (*rt).slots = slots;
    (*rt).slot_cap = init_cap;
    win_install_exit_hook(rt);

    let mut old_prot: [1]u32 = [0u32];
    if VirtualProtect(desc0, 16usize, 0x04u32, address_of_mut(old_prot[0])) != 0 {
        let addr = rt as usize;
        *((desc0 + 4) as *mut u32) = (addr & 0xFFFFFFFFusize) as u32;
        *((desc0 + 8) as *mut u32) = ((addr >> 32) & 0xFFFFFFFFusize) as u32;
    }
    rt
}

fn win_thread_trampoline(param: *mut u8) -> u32 {
    unsafe {
        let rt = win_rt_peek();
        let s = param as *mut WinThreadSlot;
        if (rt as usize) == 0 || (s as usize) == 0 {
            return 1u32;
        }
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        (*s).win_tid = GetCurrentThreadId();
        let entry = (*s).entry;
        let ctx = (*s).ctx;
        LeaveCriticalSection(cs_ptr);

        let rv = entry(ctx);

        EnterCriticalSection(cs_ptr);
        (*s).ret_val = rv;
        (*s).finished = 1u32;
        (*s).win_tid = 0u32;
        if (*s).detached != 0u32 {
            let h = (*s).os_handle;
            (*s).os_handle = 0 as *mut u8;
            (*s).in_use = 0u32;
            LeaveCriticalSection(cs_ptr);
            if (h as usize) != 0 {
                CloseHandle(h);
            }
        } else {
            LeaveCriticalSection(cs_ptr);
        }
        0u32
    }
}

unsafe fn win_alloc_slot(rt: *mut WinThreadRt) -> usize {
    let heap = GetProcessHeap();
    let mut idx: usize = 1;
    while idx < (*rt).slot_cap {
        let pp = slot_ptr_at((*rt).slots, idx);
        let mut s = *pp;
        if (s as usize) == 0 {
            s = HeapAlloc(heap, 8u32, size_of<WinThreadSlot>()) as *mut WinThreadSlot;
            if (s as usize) == 0 {
                return 0;
            }
            *pp = s;
            return idx;
        }
        if (*s).in_use == 0u32 {
            return idx;
        }
        idx = idx + 1;
    }
    if (*rt).slot_cap >= 32768 {
        return 0;
    }
    let old_cap = (*rt).slot_cap;
    let new_cap = old_cap * 2;
    let new_arr = HeapAlloc(heap, 8u32, new_cap * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot;
    if (new_arr as usize) == 0 {
        return 0;
    }
    ptr_copy_nonoverlapping<*mut WinThreadSlot>((*rt).slots as *const *mut WinThreadSlot, new_arr, old_cap);
    HeapFree(heap, 0u32, (*rt).slots as *mut u8);
    (*rt).slots = new_arr;
    (*rt).slot_cap = new_cap;
    let s = HeapAlloc(heap, 8u32, size_of<WinThreadSlot>()) as *mut WinThreadSlot;
    if (s as usize) == 0 {
        return 0;
    }
    *slot_ptr_at((*rt).slots, old_cap) = s;
    old_cap
}

pub unsafe fn __ax_host_thread_spawn(entry: fn(*mut u8) -> i64, ctx: *mut u8, stack_size: usize) -> i64 {
    if fn_entry_to_addr(entry) == 0usize {
        return -4i64;
    }
    let rt = win_rt_get();
    if (rt as usize) == 0 {
        return -9i64;
    }
    let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs_ptr);
    let idx = win_alloc_slot(rt);
    if idx == 0 {
        LeaveCriticalSection(cs_ptr);
        return -9i64;
    }
    let s = *slot_ptr_at((*rt).slots, idx);
    let mut gen = (*s).generation + 1u32;
    if gen == 0u32 || gen > 0x7FFFu32 {
        gen = 1u32;
    }
    (*s).in_use = 1u32;
    (*s).finished = 0u32;
    (*s).detached = 0u32;
    (*s).joining = 0u32;
    (*s).panicked = 0u32;
    (*s).win_tid = 0u32;
    (*s).generation = gen;
    (*s).logical_id = (*rt).next_logical_id;
    (*rt).next_logical_id = (*rt).next_logical_id + 1u64;
    (*s).os_handle = 0 as *mut u8;
    (*s).entry = entry;
    (*s).ctx = ctx;
    (*s).ret_val = 0i64;
    if (ctx as usize) != 0 && *(ctx as *const u64) == 0x4158544852504B54u64 {
        *((ctx + 32) as *mut u64) = (*s).logical_id;
    }

    let mut tid: [1]u32 = [0u32];
    let h = CreateThread(0 as *mut u8, stack_size, win_thread_trampoline, s as *mut u8, 0u32, address_of_mut(tid[0]));
    if (h as usize) == 0 {
        (*s).in_use = 0u32;
        LeaveCriticalSection(cs_ptr);
        return -9i64;
    }
    (*s).os_handle = h;
    (*s).win_tid = tid[0];
    let handle_val: i64 = ((gen as i64) << 16) | (idx as i64);
    LeaveCriticalSection(cs_ptr);
    handle_val
}

pub unsafe fn __ax_host_thread_join(h: i64, out_ret: *mut i64) -> i64 {
    if h <= 0i64 {
        return -4i64;
    }
    let rt = win_rt_peek();
    if (rt as usize) == 0 {
        return -4i64;
    }
    let idx = (h & 0xFFFFi64) as usize;
    let gen = ((h >> 16) & 0x7FFFi64) as u32;
    let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs_ptr);
    if idx == 0 || idx >= (*rt).slot_cap {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    let s = *slot_ptr_at((*rt).slots, idx);
    if (s as usize) == 0 || (*s).in_use == 0u32 || (*s).generation != gen || (*s).detached != 0u32 || (*s).joining != 0u32 {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    if (*s).finished == 0u32 && (*s).win_tid == GetCurrentThreadId() {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    (*s).joining = 1u32;
    let os_h = (*s).os_handle;
    LeaveCriticalSection(cs_ptr);

    if (os_h as usize) != 0 {
        WaitForSingleObject(os_h, 0xFFFFFFFFu32);
    }

    EnterCriticalSection(cs_ptr);
    let rv = (*s).ret_val;
    (*s).os_handle = 0 as *mut u8;
    (*s).joining = 0u32;
    (*s).in_use = 0u32;
    LeaveCriticalSection(cs_ptr);

    if (os_h as usize) != 0 {
        CloseHandle(os_h);
    }
    if (out_ret as usize) != 0 {
        *out_ret = rv;
    }
    0i64
}

pub fn __ax_host_thread_detach(h: i64) -> i64 {
    if h <= 0i64 {
        return -4i64;
    }
    unsafe {
        let rt = win_rt_peek();
        if (rt as usize) == 0 {
            return -4i64;
        }
        let idx = (h & 0xFFFFi64) as usize;
        let gen = ((h >> 16) & 0x7FFFi64) as u32;
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        if idx == 0 || idx >= (*rt).slot_cap {
            LeaveCriticalSection(cs_ptr);
            return -4i64;
        }
        let s = *slot_ptr_at((*rt).slots, idx);
        if (s as usize) == 0 || (*s).in_use == 0u32 || (*s).generation != gen || (*s).detached != 0u32 || (*s).joining != 0u32 {
            LeaveCriticalSection(cs_ptr);
            return -4i64;
        }
        if (*s).finished != 0u32 {
            let os_h = (*s).os_handle;
            (*s).os_handle = 0 as *mut u8;
            (*s).in_use = 0u32;
            LeaveCriticalSection(cs_ptr);
            if (os_h as usize) != 0 {
                CloseHandle(os_h);
            }
            return 0i64;
        }
        (*s).detached = 1u32;
        LeaveCriticalSection(cs_ptr);
        0i64
    }
}

pub fn __ax_host_thread_current_id() -> u64 {
    unsafe {
        let cur_tid = GetCurrentThreadId();
        let rt = win_rt_get();
        if (rt as usize) == 0 {
            return if cur_tid == 0u32 { 1u64 } else { cur_tid as u64 };
        }
        if cur_tid == (*rt).main_win_tid {
            return 1u64;
        }
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        let mut idx: usize = 1;
        while idx < (*rt).slot_cap {
            let s = *slot_ptr_at((*rt).slots, idx);
            if (s as usize) != 0 && (*s).in_use != 0u32 && (*s).finished == 0u32 && (*s).win_tid == cur_tid {
                let lid = (*s).logical_id;
                LeaveCriticalSection(cs_ptr);
                return lid;
            }
            idx = idx + 1;
        }
        LeaveCriticalSection(cs_ptr);
        0x8000000000000000u64 | (cur_tid as u64)
    }
}

pub fn __ax_host_thread_yield() {
    unsafe {
        SwitchToThread();
    }
}

pub fn __ax_host_thread_sleep_ns(ns: u64) {
    if ns == 0u64 {
        unsafe { Sleep(0u32); }
        return;
    }
    let mut ms64 = ns / 1_000_000u64;
    if (ns % 1_000_000u64) != 0u64 {
        ms64 = ms64 + 1u64;
    }
    let ms32 = if ms64 >= 0xFFFFFFFEu64 { 0xFFFFFFFEu32 } else { ms64 as u32 };
    unsafe {
        Sleep(ms32);
    }
}

pub unsafe fn __ax_host_futex_wait(addr: *const u32, expected: u32, timeout_ns: u64) -> i64 {
    if (addr as usize) == 0 || ((addr as usize) & 3usize) != 0usize {
        return -4i64;
    }
    let mut timeout_ms: u32 = 0u32;
    if timeout_ns == 0xFFFFFFFFFFFFFFFFu64 {
        timeout_ms = 0xFFFFFFFFu32;
    } else if timeout_ns > 0u64 {
        let mut ms64 = timeout_ns / 1_000_000u64;
        if (timeout_ns % 1_000_000u64) != 0u64 {
            ms64 = ms64 + 1u64;
        }
        timeout_ms = if ms64 >= 0xFFFFFFFEu64 { 0xFFFFFFFEu32 } else { ms64 as u32 };
    }
    let exp_box: [1]u32 = [expected];
    let ok = WaitOnAddress(addr as *const u8, address_of(exp_box[0]) as *const u8, 4usize, timeout_ms);
    if ok != 0 {
        return 0i64;
    }
    if GetLastError() == 1460u32 {
        return -5i64;
    }
    0i64
}

pub unsafe fn __ax_host_futex_wake(addr: *const u32, count: u32) -> i64 {
    if (addr as usize) == 0 || ((addr as usize) & 3usize) != 0usize {
        return -4i64;
    }
    if count == 0u32 {
        return 0i64;
    }
    if count == 1u32 {
        WakeByAddressSingle(addr as *const u8);
        return 1i64;
    }
    WakeByAddressAll(addr as *const u8);
    count as i64
}

module std.time

use std.core.host.monotonic_ns

pub struct Duration {
    pub nanos: u64,
}

pub fn duration_from_nanos(nanos: u64) -> Duration {
    Duration { nanos: nanos }
}

pub fn duration_from_millis(millis: u64) -> Duration {
    Duration { nanos: millis * 1_000_000u64 }
}

pub fn duration_from_secs(secs: u64) -> Duration {
    Duration { nanos: secs * 1_000_000_000u64 }
}

pub fn duration_as_nanos(d: view<Duration>) -> u64 {
    d.nanos
}

pub fn duration_as_millis(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000u64
}

pub fn duration_as_secs(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000_000u64
}

impl Duration {
    pub fn from_nanos(nanos: u64) -> Duration { duration_from_nanos(nanos) }
    pub fn from_millis(millis: u64) -> Duration { duration_from_millis(millis) }
    pub fn from_secs(secs: u64) -> Duration { duration_from_secs(secs) }
    pub fn as_nanos(self: view<Duration>) -> u64 { duration_as_nanos(self) }
    pub fn as_millis(self: view<Duration>) -> u64 { duration_as_millis(self) }
    pub fn as_secs(self: view<Duration>) -> u64 { duration_as_secs(self) }
}

pub struct Instant {
    pub nanos: u64,
}

pub fn instant_now() -> Instant {
    let t = monotonic_ns();
    Instant { nanos: t }
}

pub fn instant_duration_since(self: view<Instant>, earlier: view<Instant>) -> Duration {
    if self.nanos >= earlier.nanos {
        Duration { nanos: self.nanos - earlier.nanos }
    } else {
        Duration { nanos: 0u64 }
    }
}

pub fn instant_elapsed(self: view<Instant>) -> Duration {
    let now = instant_now();
    instant_duration_since(view(now), self)
}

pub fn instant_as_nanos(self: view<Instant>) -> u64 {
    self.nanos
}

pub fn instant_as_millis(self: view<Instant>) -> u64 {
    self.nanos / 1_000_000u64
}

pub fn instant_as_secs(self: view<Instant>) -> u64 {
    self.nanos / 1_000_000_000u64
}

impl Instant {
    pub fn now() -> Instant { instant_now() }
    pub fn duration_since(self: view<Instant>, earlier: view<Instant>) -> Duration { instant_duration_since(self, earlier) }
    pub fn elapsed(self: view<Instant>) -> Duration { instant_elapsed(self) }
}

module std.text.utf8

use std.core.result.Result

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

pub fn utf8_error_position(err: Utf8Error) -> usize {
    match err {
        Utf8Error.InvalidByte(p) => p,
        Utf8Error.Truncated(p) => p,
        Utf8Error.Overlong(p) => p,
        Utf8Error.Surrogate(p) => p,
        Utf8Error.OutOfRange(p) => p,
        Utf8Error.InvalidBoundary(p) => p,
    }
}

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

pub fn char_len_utf8(c: char) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        1
    } else if u <= 0x7FF {
        2
    } else if u <= 0xFFFF {
        3
    } else {
        4
    }
}

pub unsafe fn char_encode_utf8(c: char, dst: *mut u8) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        *dst = u as u8;
        1
    } else if u <= 0x7FF {
        *dst = (0xC0 | (u >> 6)) as u8;
        *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        2
    } else if u <= 0xFFFF {
        *dst = (0xE0 | (u >> 12)) as u8;
        *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        3
    } else {
        *dst = (0xF0 | (u >> 18)) as u8;
        *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        4
    }
}

impl char {
    pub fn len_utf8(self: char) -> usize {
        char_len_utf8(self)
    }

    pub unsafe fn encode_utf8(self: char, dst: *mut u8) -> usize {
        char_encode_utf8(self, dst)
    }
}

pub fn decode_char_at(bytes: view<[u8]>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub fn is_char_boundary(bytes: view<[u8]>, offset: usize) -> bool {
    let n = len(bytes);
    if offset == 0 || offset == n {
        return true;
    }
    if offset > n {
        return false;
    }
    let b = bytes[offset];
    (b & 0xC0) != 0x80
}

pub fn char_count(bytes: view<[u8]>) -> Result<usize, Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    let mut count: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                count = count + 1;
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(count)
}

pub fn validate_utf8(bytes: view<[u8]>) -> Result<(), Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(())
}

module std.text.string

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.text.utf8.Utf8Error
use std.text.utf8.char_len_utf8
use std.text.utf8.char_encode_utf8
use std.text.utf8.validate_utf8

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub fn string_len(s: view<String>) -> usize {
    s.len
}

pub fn string_capacity(s: view<String>) -> usize {
    s.cap
}

pub fn string_is_empty(s: view<String>) -> bool {
    s.len == 0
}

pub fn string_clear(s: mut_view<String>) {
    s.len = 0;
}

pub fn string_reserve(s: mut_view<String>, additional: usize) {
    let needed = s.len + additional;
    if needed <= s.cap {
        return;
    }
    let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
    if new_cap < needed {
        new_cap = needed;
    }
    let raw = unsafe { heap_alloc(new_cap, 8) };
    let new_ptr = raw as *mut u8;
    if s.len > 0 && s.ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
            heap_free(s.ptr, s.cap, 8);
        }
    }
    s.ptr = new_ptr;
    s.cap = new_cap;
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = char_len_utf8(c);
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        char_encode_utf8(c, dst);
    }
    s.len = s.len + clen;
}

pub fn string_push_str(s: mut_view<String>, other: view<String>) {
    if other.len == 0 {
        return;
    }
    let needed = s.len + other.len;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        ptr_copy_nonoverlapping<u8>(other.ptr as *const u8, dst, other.len);
    }
    s.len = s.len + other.len;
}

pub fn string_push_bytes(s: mut_view<String>, bytes: view<[u8]>) -> Result<(), Utf8Error> {
    match validate_utf8(bytes) {
        Result.Ok(u) => {
            let n = len(bytes);
            if n == 0 {
                return Result.Ok(());
            }
            let needed = s.len + n;
            if needed > s.cap {
                let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
                if new_cap < needed {
                    new_cap = needed;
                }
                let raw = unsafe { heap_alloc(new_cap, 8) };
                let new_ptr = raw as *mut u8;
                if s.len > 0 && s.ptr as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                        heap_free(s.ptr, s.cap, 8);
                    }
                }
                s.ptr = new_ptr;
                s.cap = new_cap;
            }
            let dst = unsafe { s.ptr + s.len };
            let mut i: usize = 0;
            while i < n {
                unsafe {
                    *(dst + i) = bytes[i];
                }
                i = i + 1;
            }
            s.len = s.len + n;
            Result.Ok(())
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn string_clone(s: view<String>) -> String {
    if s.len == 0 {
        return string_new();
    }
    let mut res = string_with_capacity(s.len);
    unsafe {
        ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, res.ptr, s.len);
    }
    res.len = s.len;
    res
}

pub fn string_concat(a: view<String>, b: view<String>) -> String {
    let total_len = a.len + b.len;
    if total_len == 0 {
        return string_new();
    }
    let mut res = string_with_capacity(total_len);
    if a.len > 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(a.ptr as *const u8, res.ptr, a.len);
        }
    }
    if b.len > 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, res.ptr + a.len, b.len);
        }
    }
    res.len = total_len;
    res
}

pub fn string_eq(a: view<String>, b: view<String>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn string_cmp(a: view<String>, b: view<String>) -> i32 {
    let alen = a.len;
    let blen = b.len;
    let min_len = if alen < blen { alen } else { blen };
    let mut i: usize = 0;
    while i < min_len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba < bb {
            return -1;
        } else if ba > bb {
            return 1;
        }
        i = i + 1;
    }
    if alen < blen {
        -1
    } else if alen > blen {
        1
    } else {
        0
    }
}

pub fn string_is_char_boundary(s: view<String>, offset: usize) -> bool {
    if offset == 0 || offset == s.len {
        return true;
    }
    if offset > s.len {
        return false;
    }
    let b = unsafe { *(s.ptr + offset) };
    (b & 0xC0) != 0x80
}

pub fn string_char_count(s: view<String>) -> usize {
    let mut count: usize = 0;
    let mut i: usize = 0;
    while i < s.len {
        let b = unsafe { *(s.ptr + i) };
        if (b & 0xC0) != 0x80 {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

pub fn string_slice(s: view<String>, start: usize, end: usize) -> Result<String, Utf8Error> {
    if start > end || end > s.len {
        return Result.Err(Utf8Error.InvalidBoundary(start));
    }
    if !string_is_char_boundary(s, start) {
        return Result.Err(Utf8Error.InvalidBoundary(start));
    }
    if !string_is_char_boundary(s, end) {
        return Result.Err(Utf8Error.InvalidBoundary(end));
    }
    let slice_len = end - start;
    if slice_len == 0 {
        return Result.Ok(string_new());
    }
    let mut res = string_with_capacity(slice_len);
    unsafe {
        ptr_copy_nonoverlapping<u8>(s.ptr + start, res.ptr, slice_len);
    }
    res.len = slice_len;
    Result.Ok(res)
}

pub fn string_from_utf8(bytes: view<[u8]>) -> Result<String, Utf8Error> {
    match validate_utf8(bytes) {
        Result.Ok(u) => {
            let n = len(bytes);
            if n == 0 {
                return Result.Ok(string_new());
            }
            let mut s = string_with_capacity(n);
            let mut i: usize = 0;
            while i < n {
                unsafe {
                    *(s.ptr + i) = bytes[i];
                }
                i = i + 1;
            }
            s.len = n;
            Result.Ok(s)
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn string_from_chars(chars: view<[char]>) -> String {
    let n = len(chars);
    let mut total_bytes: usize = 0;
    let mut i: usize = 0;
    while i < n {
        total_bytes = total_bytes + char_len_utf8(chars[i]);
        i = i + 1;
    }
    if total_bytes == 0 {
        return string_new();
    }
    let mut s = string_with_capacity(total_bytes);
    i = 0;
    while i < n {
        string_push_char(mut_view(s), chars[i]);
        i = i + 1;
    }
    s
}

impl String {
    pub fn len(self: view<String>) -> usize { self.len }
    pub fn capacity(self: view<String>) -> usize { self.cap }
    pub fn is_empty(self: view<String>) -> bool { self.len == 0 }
    pub fn clear(self: mut_view<String>) { string_clear(self); }
    pub fn reserve(self: mut_view<String>, additional: usize) { string_reserve(self, additional); }
    pub fn push_char(self: mut_view<String>, c: char) { string_push_char(self, c); }
    pub fn push_str(self: mut_view<String>, other: view<String>) { string_push_str(self, other); }
    pub fn push_bytes(self: mut_view<String>, bytes: view<[u8]>) -> Result<(), Utf8Error> { string_push_bytes(self, bytes) }
    pub fn clone(self: view<String>) -> String { string_clone(self) }
    pub fn concat(self: view<String>, other: view<String>) -> String { string_concat(self, other) }
    pub fn eq(self: view<String>, other: view<String>) -> bool { string_eq(self, other) }
    pub fn cmp(self: view<String>, other: view<String>) -> i32 { string_cmp(self, other) }
    pub fn is_char_boundary(self: view<String>, offset: usize) -> bool { string_is_char_boundary(self, offset) }
    pub fn char_count(self: view<String>) -> usize { string_char_count(self) }
    pub fn slice(self: view<String>, start: usize, end: usize) -> Result<String, Utf8Error> { string_slice(self, start, end) }
}

module std.thread.local

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic fn panic(msg: str) {}

pub fn default_local_drop(ptr: *mut u8) -> () {
    if (ptr as usize) != 0 {
        unsafe {
            heap_free(ptr, 8usize, 8usize);
        }
    }
}

pub struct LocalSlotNode {
    pub slot_id: usize,
    pub val_ptr: *mut u8,
    pub borrow_state: i32,
    pub drop_fn: fn(*mut u8) -> (),
    pub next: *mut LocalSlotNode,
}

@thread_local
static mut LOCAL_SLOTS_HEAD: *mut LocalSlotNode = 0 as *mut LocalSlotNode;

pub struct LocalKey<T> {
    pub init_fn: fn() -> T,
    pub drop_fn: fn(*mut u8) -> (),
    pub slot_id: u32,
}

impl<T> !Send for LocalKey<T> {}
impl<T> !Share for LocalKey<T> {}

pub fn local_key_new<T>(init_fn: fn() -> T) -> LocalKey<T> {
    LocalKey {
        init_fn: init_fn,
        drop_fn: default_local_drop,
        slot_id: 0u32,
    }
}

pub fn local_key_new_with_drop<T>(init_fn: fn() -> T, drop_fn: fn(*mut u8) -> ()) -> LocalKey<T> {
    LocalKey {
        init_fn: init_fn,
        drop_fn: drop_fn,
        slot_id: 0u32,
    }
}

impl<T> LocalKey<T> {
    pub fn new(init_fn: fn() -> T) -> LocalKey<T> {
        LocalKey {
            init_fn: init_fn,
            drop_fn: default_local_drop,
            slot_id: 0u32,
        }
    }

    pub fn new_with_drop(init_fn: fn() -> T, drop_fn: fn(*mut u8) -> ()) -> LocalKey<T> {
        LocalKey {
            init_fn: init_fn,
            drop_fn: drop_fn,
            slot_id: 0u32,
        }
    }

    fn find_or_create_node(self: view<LocalKey<T>>) -> *mut LocalSlotNode {
        let mut target_id: usize = self.slot_id as usize;
        if target_id == 0usize {
            target_id = unsafe { *(address_of(self) as *const usize) };
        }
        let mut cur = unsafe { LOCAL_SLOTS_HEAD };
        while (cur as usize) != 0 {
            if (unsafe { (*cur).slot_id }) == target_id {
                return cur;
            }
            cur = unsafe { (*cur).next };
        }

        let init = self.init_fn;
        let val: T = init();
        let box_sz = if size_of<T>() == 0 { 8 } else { size_of<T>() };
        let box_al = if align_of<T>() < 8 { 8 } else { align_of<T>() };
        let v_raw = unsafe { heap_alloc(box_sz, box_al) };
        if (v_raw as usize) == 0 {
            panic("out of memory allocating LocalKey storage");
        }
        let v_box = v_raw as *mut T;
        unsafe {
            *v_box = val;
        }

        let node_raw = unsafe { heap_alloc(size_of<LocalSlotNode>(), align_of<LocalSlotNode>()) };
        if (node_raw as usize) == 0 {
            panic("out of memory allocating LocalSlotNode");
        }
        let node = node_raw as *mut LocalSlotNode;
        unsafe {
            *node = LocalSlotNode {
                slot_id: target_id,
                val_ptr: v_raw,
                borrow_state: 0i32,
                drop_fn: self.drop_fn,
                next: LOCAL_SLOTS_HEAD,
            };
            LOCAL_SLOTS_HEAD = node;
        }
        node
    }

    pub fn with(self: view<LocalKey<T>>, f: fn(view<T>) -> ()) {
        let node = self.find_or_create_node();
        let st = unsafe { (*node).borrow_state };
        if st < 0 {
            panic("LocalKey: cannot borrow immutably while mutably borrowed");
        }
        let val_raw: *const T = unsafe { (*node).val_ptr as *const T };
        let v: view<T> = unsafe { view(*val_raw) };
        unsafe {
            (*node).borrow_state = st + 1;
        }
        f(v);
        unsafe {
            (*node).borrow_state = (*node).borrow_state - 1;
        }
    }

    pub fn with_mut(self: view<LocalKey<T>>, f: fn(mut_view<T>) -> ()) {
        let node = self.find_or_create_node();
        let st = unsafe { (*node).borrow_state };
        if st != 0 {
            panic("LocalKey: cannot borrow mutably while already borrowed");
        }
        let val_raw: *mut T = unsafe { (*node).val_ptr as *mut T };
        let v: mut_view<T> = unsafe { mut_view(*val_raw) };
        unsafe {
            (*node).borrow_state = -1;
        }
        f(v);
        unsafe {
            (*node).borrow_state = 0;
        }
    }

    pub fn get(self: view<LocalKey<T>>) -> T where T: Copy {
        let node = self.find_or_create_node();
        let st = unsafe { (*node).borrow_state };
        if st < 0 {
            panic("LocalKey: cannot borrow immutably while mutably borrowed");
        }
        let ptr = unsafe { (*node).val_ptr };
        unsafe { *(ptr as *const T) }
    }

    pub fn set(self: view<LocalKey<T>>, val: T) {
        let node = self.find_or_create_node();
        let st = unsafe { (*node).borrow_state };
        if st != 0 {
            panic("LocalKey: cannot borrow mutably while already borrowed");
        }
        let ptr = unsafe { (*node).val_ptr };
        unsafe { *(ptr as *mut T) = val; }
    }
}

pub fn thread_local_cleanup() {
    let mut cur = unsafe { LOCAL_SLOTS_HEAD };
    unsafe {
        LOCAL_SLOTS_HEAD = 0 as *mut LocalSlotNode;
    }
    while (cur as usize) != 0 {
        let next_node = unsafe { (*cur).next };
        let dfn = unsafe { (*cur).drop_fn };
        let vp = unsafe { (*cur).val_ptr };
        let dfn_addr = unsafe { *(address_of(dfn) as *const usize) };
        if dfn_addr != 0usize && (vp as usize) != 0 {
            dfn(vp);
        }
        unsafe {
            heap_free(cur as *mut u8, size_of<LocalSlotNode>(), align_of<LocalSlotNode>());
        }
        cur = next_node;
    }
}

module std.thread

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.thread_spawn
use std.core.host.thread_join
use std.core.host.thread_detach
use std.core.host.thread_current_id
use std.core.host.thread_yield
use std.core.host.thread_sleep_ns
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.sync.atomic.fence
use std.text.string.String
use std.text.string.string_new
use std.text.string.string_with_capacity
use std.text.string.string_clone
use std.time.Duration
pub use std.thread.local.LocalKey
pub use std.thread.local.local_key_new
pub use std.thread.local.local_key_new_with_drop
pub use std.thread.local.thread_local_cleanup

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic fn forget<T>(val: T) {}
@intrinsic fn panic(msg: str) {}

const AX_THREAD_SLOT_MAGIC: u64 = 0x4158544852504B54u64;
const FLAG_CHILD_DONE: u32 = 1u32;
const FLAG_PARENT_DETACHED: u32 = 2u32;

fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    0i64
}

fn str_to_owned_string(s: str) -> String {
    let n = len(s);
    if n == 0 {
        return string_new();
    }
    let bs: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let mut out = string_with_capacity(n);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(out.ptr + i) = bs[i];
        }
        i = i + 1;
    }
    out.len = n;
    out
}

fn string_as_str_slice(s: view<String>) -> str {
    let mut raw_words: [2]usize = [s.ptr as usize, s.len];
    unsafe { *(address_of(raw_words[0]) as *const str) }
}

@derive(Copy)
pub struct ThreadId {
    pub id: u64,
}

impl ThreadId {
    pub fn as_u64(self: view<ThreadId>) -> u64 {
        self.id
    }

    pub fn eq(self: view<ThreadId>, other: view<ThreadId>) -> bool {
        self.id == other.id
    }

    pub fn clone(self: view<ThreadId>) -> ThreadId {
        *self
    }
}

pub struct Thread {
    pub id: ThreadId,
    pub has_name: bool,
    pub name_buf: String,
}

unsafe impl Send for Thread {}
unsafe impl Share for Thread {}

impl Thread {
    pub fn id(self: view<Thread>) -> ThreadId {
        self.id
    }

    pub fn name(self: view<Thread>) -> Option<str> {
        if self.has_name {
            Option.Some(string_as_str_slice(view(self.name_buf)))
        } else {
            Option.None
        }
    }

    pub fn clone(self: view<Thread>) -> Thread {
        Thread {
            id: self.id,
            has_name: self.has_name,
            name_buf: if self.has_name { string_clone(view(self.name_buf)) } else { string_new() },
        }
    }
}

@derive(Copy)
pub enum ThreadError {
    SpawnFailed,
    InvalidConfig,
}

impl ThreadError {
    pub fn eq(self: view<ThreadError>, other: view<ThreadError>) -> bool {
        let a = match *self {
            ThreadError.SpawnFailed => 0u8,
            ThreadError.InvalidConfig => 1u8,
        };
        let b = match *other {
            ThreadError.SpawnFailed => 0u8,
            ThreadError.InvalidConfig => 1u8,
        };
        a == b
    }

    pub fn clone(self: view<ThreadError>) -> ThreadError {
        *self
    }
}

pub struct ThreadPanic {
    pub message: String,
    pub thread_id: ThreadId,
}

unsafe impl Send for ThreadPanic {}
unsafe impl Share for ThreadPanic {}

impl ThreadPanic {
    pub fn message(self: view<ThreadPanic>) -> str {
        string_as_str_slice(view(self.message))
    }

    pub fn thread_id(self: view<ThreadPanic>) -> ThreadId {
        self.thread_id
    }
}

fn make_thread_panic(tid: ThreadId) -> ThreadPanic {
    ThreadPanic {
        message: str_to_owned_string("child thread panicked"),
        thread_id: tid,
    }
}

// Shared heap control slot between parent handle and child trampoline.
// Byte offsets 0 (magic: u64), 8 (lifecycle: Atomic<u32>), and 32 (assigned_tid: u64)
// match the host runtime contract in std/sys/windows/thread.ax and compiler/interp/interp.ax.
@repr(C)
struct SpawnSlot {
    pub magic: u64,
    pub lifecycle: Atomic<u32>,
    pub phase: u32,
    pub stack_size: usize,
    pub raw_handle: i64,
    pub assigned_tid: u64,
    pub closure_ptr: *mut u8,
    pub val_ptr: *mut u8,
    pub cleanup_fn: fn(*mut u8) -> i64,
}

fn box_size(sz: usize) -> usize {
    if sz == 0 { 8 } else { sz }
}

fn box_align(al: usize) -> usize {
    if al < 8 { 8 } else { al }
}

unsafe fn spawn_slot_new(stack_size: usize, closure_ptr: *mut u8) -> *mut SpawnSlot {
    let raw = heap_alloc(size_of<SpawnSlot>(), align_of<SpawnSlot>());
    if (raw as usize) == 0 {
        return 0 as *mut SpawnSlot;
    }
    let s = raw as *mut SpawnSlot;
    (*s).magic = AX_THREAD_SLOT_MAGIC;
    (*s).lifecycle = Atomic.new(0u32);
    (*s).phase = 0u32;
    (*s).stack_size = stack_size;
    (*s).raw_handle = 0i64;
    (*s).assigned_tid = 0u64;
    (*s).closure_ptr = closure_ptr;
    (*s).val_ptr = 0 as *mut u8;
    (*s).cleanup_fn = __ax_thread_self_entry;
    s
}

unsafe fn ax_spawn_trampoline<F: FnOnce<T> + Send, T: Send>(raw_typed: *mut (F, T)) -> i64 {
    let raw = raw_typed as *mut u8;
    let slot = raw as *mut SpawnSlot;
    let ph = (*slot).phase;
    let res_sz = box_size(size_of<Result<T, ThreadPanic>>());
    let res_al = box_align(align_of<Result<T, ThreadPanic>>());
    if ph == 0u32 {
        (*slot).cleanup_fn = __ax_thread_self_entry;
        (*slot).phase = 1u32;
        let h = thread_spawn(__ax_thread_self_entry, raw, (*slot).stack_size);
        (*slot).raw_handle = h;
        return h;
    }
    if ph == 2u32 {
        let c_ptr = (*slot).closure_ptr;
        (*slot).closure_ptr = 0 as *mut u8;
        if (c_ptr as usize) != 0 {
            if needs_drop<F>() {
                drop_in_place<F>(c_ptr as *mut F);
            }
            heap_free(c_ptr, box_size(size_of<F>()), box_align(align_of<F>()));
        }
        let v_ptr = (*slot).val_ptr;
        (*slot).val_ptr = 0 as *mut u8;
        if (v_ptr as usize) != 0 {
            if needs_drop<Result<T, ThreadPanic>>() {
                drop_in_place<Result<T, ThreadPanic>>(v_ptr as *mut Result<T, ThreadPanic>);
            }
            heap_free(v_ptr, res_sz, res_al);
        }
        (*slot).magic = 0u64;
        heap_free(raw, size_of<SpawnSlot>(), align_of<SpawnSlot>());
        return 0i64;
    }
    if ph == 3u32 {
        let c_ptr = (*slot).closure_ptr;
        (*slot).closure_ptr = 0 as *mut u8;
        if (c_ptr as usize) != 0 {
            if needs_drop<F>() {
                drop_in_place<F>(c_ptr as *mut F);
            }
            heap_free(c_ptr, box_size(size_of<F>()), box_align(align_of<F>()));
        }
        let old_v = (*slot).val_ptr;
        (*slot).val_ptr = 0 as *mut u8;
        if (old_v as usize) != 0 {
            if needs_drop<Result<T, ThreadPanic>>() {
                drop_in_place<Result<T, ThreadPanic>>(old_v as *mut Result<T, ThreadPanic>);
            }
            heap_free(old_v, res_sz, res_al);
        }
        let r_raw = heap_alloc(res_sz, res_al);
        thread_local_cleanup();
        let r_box = r_raw as *mut Result<T, ThreadPanic>;
        *r_box = Result.Err(make_thread_panic(ThreadId { id: (*slot).assigned_tid }));
        (*slot).val_ptr = r_raw;
        return 0i64;
    }
    if ph == 4u32 {
        let v_ptr = (*slot).val_ptr;
        (*slot).val_ptr = 0 as *mut u8;
        if (v_ptr as usize) != 0 {
            heap_free(v_ptr, res_sz, res_al);
        }
        (*slot).magic = 0u64;
        heap_free(raw, size_of<SpawnSlot>(), align_of<SpawnSlot>());
        return 0i64;
    }

    let c_ptr = (*slot).closure_ptr;
    (*slot).closure_ptr = 0 as *mut u8;
    let f_box = c_ptr as *mut F;
    let f_val = *f_box;
    heap_free(c_ptr, box_size(size_of<F>()), box_align(align_of<F>()));

    let out_val: T = f_val();
    thread_local_cleanup();
    let v_raw = heap_alloc(res_sz, res_al);
    let v_box = v_raw as *mut Result<T, ThreadPanic>;
    *v_box = Result.Ok(out_val);
    (*slot).val_ptr = v_raw;

    let prev = (*slot).lifecycle.fetch_or(FLAG_CHILD_DONE, Ordering.AcqRel);
    if (prev & FLAG_PARENT_DETACHED) != 0u32 {
        (*slot).val_ptr = 0 as *mut u8;
        if needs_drop<Result<T, ThreadPanic>>() {
            drop_in_place<Result<T, ThreadPanic>>(v_box);
        }
        heap_free(v_raw, res_sz, res_al);
        (*slot).magic = 0u64;
        heap_free(raw, size_of<SpawnSlot>(), align_of<SpawnSlot>());
    }
    0i64
}

unsafe fn spawn_raw_slot<F: FnOnce<T> + Send, T: Send>(f: F, stack_size: usize, _t_tag: *const T) -> *mut SpawnSlot {
    let f_raw = heap_alloc(box_size(size_of<F>()), box_align(align_of<F>()));
    if (f_raw as usize) == 0 {
        return 0 as *mut SpawnSlot;
    }
    let f_box = f_raw as *mut F;
    *f_box = f;
    let slot = spawn_slot_new(stack_size, f_raw);
    if (slot as usize) == 0 {
        if needs_drop<F>() {
            drop_in_place<F>(f_box);
        }
        heap_free(f_raw, box_size(size_of<F>()), box_align(align_of<F>()));
        return 0 as *mut SpawnSlot;
    }
    let h = ax_spawn_trampoline<F, T>(slot as *mut (F, T));
    if h <= 0i64 {
        (*slot).phase = 2u32;
        let cfn = (*slot).cleanup_fn;
        let _ = cfn(slot as *mut u8);
        return 0 as *mut SpawnSlot;
    }
    slot
}

pub struct JoinHandle<T> {
    pub raw_handle: i64,
    pub thread_info: Thread,
    pub slot: *mut u8,
    pub marker: *const T,
}

unsafe impl<T: Send> Send for JoinHandle<T> {}
impl<T> !Share for JoinHandle<T> {}

impl<T> Drop for JoinHandle<T> {
    fn drop(self: mut_view<JoinHandle<T>>) {
        let h = self.raw_handle;
        let raw = self.slot;
        self.raw_handle = 0i64;
        self.slot = 0 as *mut u8;
        if h > 0i64 && (raw as usize) != 0 {
            unsafe {
                let s = raw as *mut SpawnSlot;
                let prev = (*s).lifecycle.fetch_or(FLAG_PARENT_DETACHED, Ordering.AcqRel);
                let _ = thread_detach(h);
                if (prev & FLAG_CHILD_DONE) != 0u32 {
                    (*s).phase = 2u32;
                    let cfn = (*s).cleanup_fn;
                    let _ = cfn(raw);
                }
            }
        }
    }
}

impl<T> JoinHandle<T> {
    pub fn thread(self: view<JoinHandle<T>>) -> Thread {
        self.thread_info.clone()
    }

    pub fn is_finished(self: view<JoinHandle<T>>) -> bool {
        if (self.slot as usize) == 0 {
            return true;
        }
        let s = self.slot as *const SpawnSlot;
        let st = unsafe { (*s).lifecycle.load(Ordering.Acquire) };
        (st & FLAG_CHILD_DONE) != 0u32
    }

    pub fn join(mut self: JoinHandle<T>) -> Result<T, ThreadPanic> {
        let h = self.raw_handle;
        let raw = self.slot;
        let tid = self.thread_info.id;
        self.raw_handle = 0i64;
        self.slot = 0 as *mut u8;
        if h <= 0i64 || (raw as usize) == 0 {
            return Result.Err(make_thread_panic(tid));
        }
        let mut ret_code: i64 = 0i64;
        let rc = unsafe { thread_join(h, address_of_mut(ret_code)) };
        let s = raw as *mut SpawnSlot;
        let cfn = unsafe { (*s).cleanup_fn };
        if rc != 0i64 || ret_code != 0i64 || (unsafe { (*s).val_ptr } as usize) == 0 {
            unsafe {
                (*s).phase = 3u32;
                let _ = cfn(raw);
            }
        }
        let r_raw = unsafe { (*s).val_ptr };
        let out_res = unsafe { *(r_raw as *const Result<T, ThreadPanic>) };
        unsafe {
            (*s).phase = 4u32;
            let _ = cfn(raw);
        }
        out_res
    }

    pub fn detach(mut self: JoinHandle<T>) {
        let h = self.raw_handle;
        let raw = self.slot;
        self.raw_handle = 0i64;
        self.slot = 0 as *mut u8;
        if h > 0i64 && (raw as usize) != 0 {
            unsafe {
                let s = raw as *mut SpawnSlot;
                let prev = (*s).lifecycle.fetch_or(FLAG_PARENT_DETACHED, Ordering.AcqRel);
                let _ = thread_detach(h);
                if (prev & FLAG_CHILD_DONE) != 0u32 {
                    (*s).phase = 2u32;
                    let cfn = (*s).cleanup_fn;
                    let _ = cfn(raw);
                }
            }
        }
    }
}

pub struct Builder {
    pub stack_size: usize,
    pub has_name: bool,
    pub name_buf: String,
}

unsafe impl Send for Builder {}
unsafe impl Share for Builder {}

impl Builder {
    pub fn new() -> Builder {
        Builder {
            stack_size: 0,
            has_name: false,
            name_buf: string_new(),
        }
    }

    pub fn stack_size(mut self: Builder, size: usize) -> Builder {
        self.stack_size = size;
        self
    }

    pub fn name(mut self: Builder, name: str) -> Builder {
        self.has_name = true;
        self.name_buf = str_to_owned_string(name);
        self
    }

    pub fn spawn<F: FnOnce<T> + Send, T: Send>(self: Builder, f: F) -> Result<JoinHandle<T>, ThreadError> {
        let slot = unsafe { spawn_raw_slot<F, T>(f, self.stack_size, 0 as *const T) };
        if (slot as usize) == 0 {
            return Result.Err(ThreadError.SpawnFailed);
        }
        let h = unsafe { (*slot).raw_handle };
        let tid_num = unsafe { (*slot).assigned_tid };
        let t_info = Thread {
            id: ThreadId { id: tid_num },
            has_name: self.has_name,
            name_buf: self.name_buf,
        };
        Result.Ok(JoinHandle {
            raw_handle: h,
            thread_info: t_info,
            slot: slot as *mut u8,
            marker: 0 as *const T,
        })
    }
}

pub fn spawn<F: FnOnce<T> + Send, T: Send>(f: F) -> JoinHandle<T> {
    let slot = unsafe { spawn_raw_slot<F, T>(f, 0, 0 as *const T) };
    if (slot as usize) == 0 {
        panic("failed to spawn OS thread");
    }
    let h = unsafe { (*slot).raw_handle };
    let tid_num = unsafe { (*slot).assigned_tid };
    JoinHandle {
        raw_handle: h,
        thread_info: Thread {
            id: ThreadId { id: tid_num },
            has_name: false,
            name_buf: string_new(),
        },
        slot: slot as *mut u8,
        marker: 0 as *const T,
    }
}

struct ScopeNode {
    pub next: *mut ScopeNode,
    pub slot: *mut SpawnSlot,
    pub raw_handle: i64,
    pub thread_info: Thread,
    pub joined_by_handle: bool,
}

struct ScopeState {
    pub active_count: usize,
    pub has_panic: bool,
    pub first_panic_tid: u64,
    pub handles_head: *mut u8,
}

pub struct Scope {
    pub state_ptr: *mut ScopeState,
}

impl !Share for Scope {}

pub struct ScopedJoinHandle<T> {
    pub raw_handle: i64,
    pub slot: *mut u8,
    pub marker: *const T,
}

unsafe impl<T: Send> Send for ScopedJoinHandle<T> {}
impl<T> !Share for ScopedJoinHandle<T> {}

impl<T> ScopedJoinHandle<T> {
    pub fn thread(self: view<ScopedJoinHandle<T>>) -> Thread {
        let node = self.slot as *const ScopeNode;
        unsafe { view((*node).thread_info).clone() }
    }

    pub fn is_finished(self: view<ScopedJoinHandle<T>>) -> bool {
        if (self.slot as usize) == 0 {
            return true;
        }
        let node = self.slot as *const ScopeNode;
        let sp = unsafe { (*node).slot };
        if (sp as usize) == 0 {
            return true;
        }
        let st = unsafe { (*sp).lifecycle.load(Ordering.Acquire) };
        (st & FLAG_CHILD_DONE) != 0u32
    }

    pub fn join(self: ScopedJoinHandle<T>) -> Result<T, ThreadPanic> {
        let node = self.slot as *mut ScopeNode;
        let h = self.raw_handle;
        let tid = unsafe { (*node).thread_info.id };
        unsafe {
            (*node).joined_by_handle = true;
        }
        let sp = unsafe { (*node).slot };
        unsafe {
            (*node).slot = 0 as *mut SpawnSlot;
        }
        if h <= 0i64 || (sp as usize) == 0 {
            return Result.Err(make_thread_panic(tid));
        }
        let mut ret_code: i64 = 0i64;
        let rc = unsafe { thread_join(h, address_of_mut(ret_code)) };
        let cfn = unsafe { (*sp).cleanup_fn };
        if rc != 0i64 || ret_code != 0i64 || (unsafe { (*sp).val_ptr } as usize) == 0 {
            unsafe {
                (*sp).phase = 3u32;
                let _ = cfn(sp as *mut u8);
            }
        }
        let r_raw = unsafe { (*sp).val_ptr };
        let out_res = unsafe { *(r_raw as *const Result<T, ThreadPanic>) };
        unsafe {
            (*sp).phase = 4u32;
            let _ = cfn(sp as *mut u8);
        }
        out_res
    }
}

fn scope_drain_all_nodes(s: mut_view<Scope>) -> bool {
    let mut had_unjoined_panic = false;
    let st = s.state_ptr;
    if (st as usize) == 0 {
        return false;
    }
    let mut cur = unsafe { (*st).handles_head as *mut ScopeNode };
    unsafe {
        (*st).handles_head = 0 as *mut u8;
        (*st).active_count = 0;
    }
    while (cur as usize) != 0 {
        let next_node = unsafe { (*cur).next };
        let already_joined = unsafe { (*cur).joined_by_handle };
        let sp = unsafe { (*cur).slot };
        let h = unsafe { (*cur).raw_handle };
        let tid = unsafe { (*cur).thread_info.id };
        if !already_joined && h > 0i64 && (sp as usize) != 0 {
            let mut ret_code: i64 = 0i64;
            let rc = unsafe { thread_join(h, address_of_mut(ret_code)) };
            unsafe {
                (*sp).phase = 2u32;
                let cfn = (*sp).cleanup_fn;
                let _ = cfn(sp as *mut u8);
                (*cur).slot = 0 as *mut SpawnSlot;
            }
            if rc != 0i64 || ret_code != 0i64 {
                if !had_unjoined_panic {
                    unsafe {
                        (*st).has_panic = true;
                        (*st).first_panic_tid = tid.id;
                    }
                }
                had_unjoined_panic = true;
            }
        }
        unsafe {
            if needs_drop<ScopeNode>() {
                drop_in_place<ScopeNode>(cur);
            }
            heap_free(cur as *mut u8, size_of<ScopeNode>(), align_of<ScopeNode>());
        }
        cur = next_node;
    }
    had_unjoined_panic
}

impl Drop for Scope {
    fn drop(self: mut_view<Scope>) {
        let _ = scope_drain_all_nodes(self);
    }
}

impl Scope {
    pub fn spawn<F: FnOnce<T> + Send, T: Send>(self: view<Scope>, f: F) -> ScopedJoinHandle<T> {
        let sp = unsafe { spawn_raw_slot<F, T>(f, 0, 0 as *const T) };
        if (sp as usize) == 0 {
            panic("failed to spawn scoped OS thread");
        }
        let h = unsafe { (*sp).raw_handle };
        let tid_num = unsafe { (*sp).assigned_tid };
        let node_raw = unsafe { heap_alloc(size_of<ScopeNode>(), align_of<ScopeNode>()) };
        if (node_raw as usize) == 0 {
            panic("out of memory allocating ScopeNode");
        }
        let st = self.state_ptr;
        let node = node_raw as *mut ScopeNode;
        unsafe {
            *node = ScopeNode {
                next: (*st).handles_head as *mut ScopeNode,
                slot: sp,
                raw_handle: h,
                thread_info: Thread {
                    id: ThreadId { id: tid_num },
                    has_name: false,
                    name_buf: string_new(),
                },
                joined_by_handle: false,
            };
            (*st).handles_head = node_raw;
            (*st).active_count = (*st).active_count + 1;
        }
        ScopedJoinHandle {
            raw_handle: h,
            slot: node_raw,
            marker: 0 as *const T,
        }
    }
}

pub fn scope<F: FnOnce<view<Scope>, R>, R>(f: F) -> R {
    let mut st = ScopeState {
        active_count: 0,
        has_panic: false,
        first_panic_tid: 0u64,
        handles_head: 0 as *mut u8,
    };
    let mut s = Scope {
        state_ptr: unsafe { address_of_mut(st) },
    };
    let out: R = f(view(s));
    let had_panic = scope_drain_all_nodes(mut_view(s));
    if had_panic {
        panic("unjoined scoped thread panicked");
    }
    out
}

pub fn current_id() -> ThreadId {
    ThreadId { id: thread_current_id() }
}

pub fn current() -> Thread {
    Thread {
        id: current_id(),
        has_name: false,
        name_buf: string_new(),
    }
}

pub fn yield_now() {
    thread_yield();
}

pub fn sleep_ns(ns: u64) {
    thread_sleep_ns(ns);
}

pub fn sleep_ms(ms: u64) {
    let ns = if ms > 18446744073709u64 {
        0xFFFFFFFFFFFFFFFFu64
    } else {
        ms * 1_000_000u64
    };
    thread_sleep_ns(ns);
}

pub fn sleep(d: Duration) {
    thread_sleep_ns(d.nanos);
}

struct CancelInner {
    pub refs: Atomic<usize>,
    pub cancelled: Atomic<bool>,
}

unsafe fn cancel_inner_retain(raw: *mut u8) {
    if (raw as usize) != 0 {
        let p = raw as *const CancelInner;
        let _ = (*p).refs.fetch_add(1usize, Ordering.Relaxed);
    }
}

unsafe fn cancel_inner_release(raw: *mut u8) {
    if (raw as usize) != 0 {
        let p = raw as *const CancelInner;
        let prev = (*p).refs.fetch_sub(1usize, Ordering.AcqRel);
        if prev == 1usize {
            fence(Ordering.Acquire);
            heap_free(raw, size_of<CancelInner>(), align_of<CancelInner>());
        }
    }
}

pub struct CancelSource {
    pub inner: *mut u8,
}

unsafe impl Send for CancelSource {}
unsafe impl Share for CancelSource {}

impl Drop for CancelSource {
    fn drop(self: mut_view<CancelSource>) {
        let p = self.inner;
        self.inner = 0 as *mut u8;
        unsafe {
            cancel_inner_release(p);
        }
    }
}

impl CancelSource {
    pub fn new() -> CancelSource {
        let raw = unsafe { heap_alloc(size_of<CancelInner>(), align_of<CancelInner>()) };
        if (raw as usize) == 0 {
            panic("out of memory allocating CancelSource");
        }
        let p = raw as *mut CancelInner;
        unsafe {
            *p = CancelInner {
                refs: Atomic.new(1usize),
                cancelled: Atomic.new(false),
            };
        }
        CancelSource { inner: raw }
    }

    pub fn token(self: view<CancelSource>) -> CancelToken {
        unsafe {
            cancel_inner_retain(self.inner);
        }
        CancelToken { inner: self.inner }
    }

    pub fn cancel(self: view<CancelSource>) {
        if (self.inner as usize) != 0 {
            let p = self.inner as *const CancelInner;
            unsafe {
                (*p).cancelled.store(true, Ordering.Release);
            }
        }
    }

    pub fn is_cancelled(self: view<CancelSource>) -> bool {
        if (self.inner as usize) == 0 {
            return false;
        }
        let p = self.inner as *const CancelInner;
        unsafe { (*p).cancelled.load(Ordering.Acquire) }
    }
}

pub struct CancelToken {
    pub inner: *mut u8,
}

unsafe impl Send for CancelToken {}
unsafe impl Share for CancelToken {}

impl Drop for CancelToken {
    fn drop(self: mut_view<CancelToken>) {
        let p = self.inner;
        self.inner = 0 as *mut u8;
        unsafe {
            cancel_inner_release(p);
        }
    }
}

impl CancelToken {
    pub fn is_cancelled(self: view<CancelToken>) -> bool {
        if (self.inner as usize) == 0 {
            return false;
        }
        let p = self.inner as *const CancelInner;
        unsafe { (*p).cancelled.load(Ordering.Acquire) }
    }

    pub fn clone(self: view<CancelToken>) -> CancelToken {
        unsafe {
            cancel_inner_retain(self.inner);
        }
        CancelToken { inner: self.inner }
    }
}

// std.asyn.waker - Task Waker Implementation & VTable (SPEC-34 AXS-EXEC-004)
module std.asyn.waker

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

use std.core.host.heap_alloc

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// Task state word: the low nibble is the scheduling state, the bits above it are flags.
//
// The encoding makes a wake a single `fetch_or(TASK_NOTIFIED)` that is harmless in every state:
//   IDLE (0)              not queued, not running   -> NOTIFIED: the waker that made this transition
//                                                      enqueues the task (exactly one does)
//   POLLING (1)           running                   -> POLLING|NOTIFIED (3): sticky wake permit, the
//                                                      poller re-queues the task when its poll ends
//   NOTIFIED (2)          queued                    -> unchanged
//   POLLING|NOTIFIED (3)  running, wake pending     -> unchanged
//   COMPLETED/CANCELLED/PANICKED (0xA/0xB/0xE)      -> unchanged (every terminal value has bit 1 set)
// Terminal states compare >= TASK_COMPLETED after masking with TASK_STATE_MASK.
pub const TASK_IDLE: u32 = 0u32
pub const TASK_POLLING: u32 = 1u32
pub const TASK_NOTIFIED: u32 = 2u32
pub const TASK_COMPLETED: u32 = 0xAu32
pub const TASK_CANCELLED: u32 = 0xBu32
pub const TASK_PANICKED: u32 = 0xEu32
pub const TASK_STATE_MASK: u32 = 0xFu32
pub const TASK_FLAGS_MASK: u32 = 0xFFFFFFF0u32

pub const FLAG_CANCEL_REQUESTED: u32 = 0x100u32
pub const FLAG_DETACHED: u32 = 0x200u32

@repr(C)
pub struct TaskHeader {
    pub vtable: *const RawWakerVTable,
    pub state: Atomic<u32>,
    pub ref_count: Atomic<u32>,
    pub task_id: u64,
    pub owner_thread_id: u64,
    pub queue_next: *mut TaskHeader,
    pub schedule_fn: fn(*mut TaskHeader),
    pub poll_fn: fn(*mut u8, *mut u8) -> u32,
    pub drop_fn: fn(*mut TaskHeader),
    pub schedule_data: *mut u8,
    pub alloc_size: usize,
    pub alloc_align: usize,
}

fn task_waker_clone(data: *const u8) -> RawWaker {
    let raw = data as *mut TaskHeader;
    if (raw as usize) != 0 {
        unsafe {
            (*raw).ref_count.fetch_add(1u32, Ordering.Relaxed);
            return RawWaker {
                data: data,
                vtable: (*raw).vtable,
            };
        }
    }
    RawWaker {
        data: 0 as *const u8,
        vtable: 0 as *const RawWakerVTable,
    }
}

fn task_waker_wake(data: *const u8) {
    let raw = data as *mut TaskHeader;
    if (raw as usize) != 0 {
        task_wake(raw);
        task_dec_ref(raw);
    }
}

fn task_waker_wake_by_ref(data: *const u8) {
    let raw = data as *mut TaskHeader;
    if (raw as usize) != 0 {
        task_wake(raw);
    }
}

fn task_waker_drop(data: *const u8) {
    let raw = data as *mut TaskHeader;
    if (raw as usize) != 0 {
        task_dec_ref(raw);
    }
}

pub fn new_task_waker_vtable() -> *const RawWakerVTable {
    let p = unsafe { heap_alloc(32usize, 8usize) as *mut RawWakerVTable };
    unsafe {
        (*p).clone = task_waker_clone;
        (*p).wake = task_waker_wake;
        (*p).wake_by_ref = task_waker_wake_by_ref;
        (*p).drop_waker = task_waker_drop;
    }
    p as *const RawWakerVTable
}

pub fn init_task_header_vtable(header: *mut TaskHeader, vt: *const RawWakerVTable) {
    if (header as usize) != 0 {
        unsafe {
            (*header).vtable = vt;
        }
    }
}

pub fn make_task_waker(header: *mut TaskHeader) -> Waker {
    if (header as usize) != 0 {
        unsafe {
            (*header).ref_count.fetch_add(1u32, Ordering.Relaxed);
            return Waker {
                raw: RawWaker {
                    data: header as *const u8,
                    vtable: (*header).vtable,
                },
            };
        }
    }
    Waker {
        raw: RawWaker {
            data: 0 as *const u8,
            vtable: 0 as *const RawWakerVTable,
        },
    }
}

pub fn task_wake(raw: *mut TaskHeader) {
    if (raw as usize) == 0 {
        return;
    }
    // Wait-free: one atomic read-modify-write whatever the task does concurrently (a CAS retry loop
    // livelocks against a task that keeps re-waking itself under a deterministic round-robin
    // scheduler). Only the IDLE -> NOTIFIED transition enqueues, so a task is queued at most once.
    let prev: u32 = unsafe { (*raw).state.fetch_or(TASK_NOTIFIED, Ordering.AcqRel) };
    if (prev & TASK_STATE_MASK) == TASK_IDLE {
        task_schedule(raw);
    }
}

// Hand the task to its executor's ready queue (the caller made the IDLE -> NOTIFIED transition).
pub fn task_schedule(raw: *mut TaskHeader) {
    let s_fn = unsafe { (*raw).schedule_fn };
    let s_addr = unsafe { *(address_of<fn(*mut TaskHeader)>(s_fn) as *const usize) };
    if s_addr != 0usize {
        s_fn(raw);
    }
}

// Ask a task to stop: set the cancel flag, then wake it so a poll observes the flag (at the start of
// its next poll). Wait-free; flags already set stay set.
pub fn task_request_cancel(raw: *mut TaskHeader) {
    if (raw as usize) == 0 {
        return;
    }
    unsafe {
        (*raw).state.fetch_or(FLAG_CANCEL_REQUESTED, Ordering.AcqRel);
    }
    task_wake(raw);
}

// Poll protocol for executors' poll functions (`tcb_poll_fn`, `group_poll_fn`); every transition
// keeps the flag bits.
//
// A dequeued task is NOTIFIED (it is queued only by the IDLE -> NOTIFIED transition or by the poller
// itself); `task_begin_poll` moves it to POLLING and returns the state word before the transition,
// so the caller sees the flags (cancel request) that were set while the task was queued.
pub fn task_begin_poll(raw: *mut TaskHeader) -> u32 {
    unsafe { (*raw).state.fetch_sub(TASK_NOTIFIED - TASK_POLLING, Ordering.AcqRel) }
}

// End a poll that returned Pending: POLLING -> IDLE, or POLLING|NOTIFIED -> NOTIFIED when a wake
// arrived during the poll, in which case the task is re-queued here. Returns TASK_IDLE or
// TASK_NOTIFIED. A cancel flag set without a wake (it is always paired with one by
// `task_request_cancel`) still gets the task re-queued.
pub fn task_end_poll_pending(raw: *mut TaskHeader) -> u32 {
    let prev: u32 = unsafe { (*raw).state.fetch_sub(TASK_POLLING, Ordering.AcqRel) };
    if (prev & TASK_NOTIFIED) != 0u32 {
        task_schedule(raw);
        return TASK_NOTIFIED;
    }
    if (prev & FLAG_CANCEL_REQUESTED) != 0u32 {
        task_wake(raw);
        return TASK_NOTIFIED;
    }
    TASK_IDLE
}

// Publish a terminal state (TASK_COMPLETED / TASK_CANCELLED / TASK_PANICKED). Later wakes and flag
// requests leave the terminal value intact.
pub fn task_set_terminal(raw: *mut TaskHeader, terminal: u32) {
    unsafe {
        (*raw).state.store(terminal, Ordering.Release);
    }
}

// The scheduling state of a task (low nibble of the state word).
pub fn task_state(raw: *mut TaskHeader) -> u32 {
    unsafe { (*raw).state.load(Ordering.Acquire) & TASK_STATE_MASK }
}

pub fn task_dec_ref(raw: *mut TaskHeader) {
    if (raw as usize) == 0 {
        return;
    }
    let prev = unsafe { (*raw).ref_count.fetch_sub(1u32, Ordering.AcqRel) };
    if prev == 1u32 {
        let df = unsafe { (*raw).drop_fn };
        let df_addr = unsafe { *(address_of<fn(*mut TaskHeader)>(df) as *const usize) };
        if df_addr != 0usize {
            df(raw);
        }
    }
}

// -----------------------------------------------------------------------------
// Detached wakers (reference-owning data/vtable pair with no drop glue)
// -----------------------------------------------------------------------------
//
// Wait queues (AsyncMutex, AsyncSemaphore, channels, TaskHandle join) keep wakers inside raw heap
// nodes. A `Waker` stored there would run its Drop glue when the node memory is overwritten, so the
// queues store the waker as two plain pointer fields (`waker_data`, `waker_vt`) that own exactly one
// reference, and manage that reference explicitly:
//   waker_leak             Waker -> RawWaker, transferring the reference (the Waker is neutralised)
//   raw_waker_wake         wake the task and release the reference (consumes it)
//   raw_waker_wake_by_ref  wake the task, keep the reference
//   raw_waker_drop         release the reference without waking
// The pair is deliberately not stored as a `RawWaker`/`Waker` struct field: such fields read back
// wrong values inside `std.*` modules today (report follow-up FU-3).

pub fn waker_leak(mut w: Waker) -> RawWaker {
    let rw = RawWaker {
        data: w.raw.data,
        vtable: w.raw.vtable,
    };
    w.raw.data = 0 as *const u8;
    rw
}

// A pair with a null data pointer (or a null vtable) is an empty waker: every operation on it is a
// no-op (the same convention as `Waker.noop()`, SPEC-33 AXS-ASY-011).
fn raw_waker_is_empty(data: *const u8, vt: *const RawWakerVTable) -> bool {
    (data as usize) == 0 || (vt as usize) == 0
}

pub fn raw_waker_wake(data: *const u8, vt: *const RawWakerVTable) {
    if !raw_waker_is_empty(data, vt) {
        // Bind the function pointer to a local first: calling a field expression directly is not
        // lowered correctly by the native backend (report follow-up FU-2).
        let f = unsafe { (*vt).wake };
        f(data);
    }
}

pub fn raw_waker_wake_by_ref(data: *const u8, vt: *const RawWakerVTable) {
    if !raw_waker_is_empty(data, vt) {
        let f = unsafe { (*vt).wake_by_ref };
        f(data);
    }
}

pub fn raw_waker_drop(data: *const u8, vt: *const RawWakerVTable) {
    if !raw_waker_is_empty(data, vt) {
        let f = unsafe { (*vt).drop_waker };
        f(data);
    }
}

// Clone the reference held by a pair through its vtable (`clone` entry).
pub fn raw_waker_clone(data: *const u8, vt: *const RawWakerVTable) -> RawWaker {
    if raw_waker_is_empty(data, vt) {
        return RawWaker {
            data: 0 as *const u8,
            vtable: 0 as *const RawWakerVTable,
        };
    }
    let f = unsafe { (*vt).clone };
    f(data)
}

// Every `Waker` operation dispatches through the vtable of its `RawWaker` (SPEC-33 AXS-ASY-011), so
// task wakers and user-defined wakers behave the same; nothing here assumes a task header.
impl Waker {
    // Consumes the waker: the vtable's `wake` takes over its reference, `Drop` does not run again.
    pub fn wake(self: Waker) {
        let rw = waker_leak(self);
        raw_waker_wake(rw.data, rw.vtable);
    }

    pub fn wake_by_ref(self: view<Waker>) {
        raw_waker_wake_by_ref(self.raw.data, self.raw.vtable);
    }

    pub fn clone(self: view<Waker>) -> Waker {
        let rw = raw_waker_clone(self.raw.data, self.raw.vtable);
        Waker {
            raw: RawWaker {
                data: rw.data,
                vtable: rw.vtable,
            },
        }
    }

    pub fn will_wake(self: view<Waker>, other: view<Waker>) -> bool {
        (self.raw.data as usize) == (other.raw.data as usize) && (self.raw.vtable as usize) == (other.raw.vtable as usize)
    }
}

impl Drop for Waker {
    fn drop(self: mut_view<Waker>) {
        let data = self.raw.data;
        if (data as usize) != 0 {
            self.raw.data = 0 as *const u8;
            raw_waker_drop(data, self.raw.vtable);
        }
    }
}

impl Context {
    pub fn waker(self: mut_view<Context>) -> Waker {
        view(self.waker_val).clone()
    }
}

// std.asyn.task - TaskControlBlock, TaskHandle, and Lifecycle Management (SPEC-34 AXS-EXEC-003..007)
module std.asyn.task

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.thread_yield

pub use std.asyn.waker.TaskHeader
pub use std.asyn.waker.TASK_IDLE
pub use std.asyn.waker.TASK_POLLING
pub use std.asyn.waker.TASK_NOTIFIED
pub use std.asyn.waker.TASK_COMPLETED
pub use std.asyn.waker.TASK_CANCELLED
pub use std.asyn.waker.TASK_PANICKED
pub use std.asyn.waker.TASK_STATE_MASK
pub use std.asyn.waker.TASK_FLAGS_MASK
pub use std.asyn.waker.FLAG_CANCEL_REQUESTED
pub use std.asyn.waker.FLAG_DETACHED
pub use std.asyn.waker.make_task_waker
pub use std.asyn.waker.task_wake
pub use std.asyn.waker.task_schedule
pub use std.asyn.waker.task_request_cancel
pub use std.asyn.waker.task_begin_poll
pub use std.asyn.waker.task_end_poll_pending
pub use std.asyn.waker.task_set_terminal
pub use std.asyn.waker.task_state
pub use std.asyn.waker.task_dec_ref
pub use std.asyn.waker.init_task_header_vtable
pub use std.asyn.waker.new_task_waker_vtable
pub use std.asyn.waker.waker_leak
pub use std.asyn.waker.raw_waker_wake
pub use std.asyn.waker.raw_waker_drop

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

@derive(Copy)
pub struct TaskId {
    pub id: u64,
}

pub struct TaskPanic {
    pub task_id: TaskId,
}

pub enum TaskError {
    Cancelled,
    Panicked,
}

pub enum TaskResult<T> {
    Completed(T),
    Cancelled,
    Panicked,
}

// Join-waker slot state (`TaskSlot.join_state`). The two waker fields are owned by whoever holds
// JOIN_REGISTERING (the handle, while it installs a waker) or, once JOIN_COMPLETE is set, by the side
// that made the deciding transition:
//   handle     REGISTERING on (only while not COMPLETE) -> replace the waker -> WAKER_SET on and
//              REGISTERING off in one CAS. That CAS fails only when the completer set COMPLETE in
//              between: then the handle drops its own waker and reports completion instead of waiting.
//   completer  fetch_or(COMPLETE): if REGISTERING was set, the handle owns the fields (and will see
//              COMPLETE); otherwise, if WAKER_SET was set, the completer takes the waker and wakes it.
//   release    a waker still WAKER_SET when the control block is freed is dropped there.
// The completer publishes the terminal task state before COMPLETE, so a handle that sees COMPLETE
// also sees the terminal state. A wake between "check done" and "register" is never lost, and every
// registered waker is consumed exactly once (woken, replaced, or released).
pub const JOIN_REGISTERING: u32 = 1u32
pub const JOIN_WAKER_SET: u32 = 2u32
pub const JOIN_COMPLETE: u32 = 4u32

@repr(C)
pub struct TaskSlot<T> {
    pub header: TaskHeader,
    pub has_output: bool,
    pub join_state: Atomic<u32>,
    pub join_waker_data: *const u8,
    pub join_waker_vt: *const RawWakerVTable,
    // Last on purpose: the join fields above are reached through `TaskSlot<u8>` casts and must sit at
    // the same offsets for every output type T.
    pub output: T,
}

// Task memory. Contract of the per-task poll function (`TaskHeader.poll_fn`, a thin wrapper around
// `tcb_poll_fn<F, T>` or `std.asyn.group.group_poll_fn<F, T>`): called with a Context it polls the
// task; called with a null Context it drops whatever payload is still stored (future, output) and
// returns. The second form is how type-erased code (`default_task_drop`) drops a stored output whose
// type it does not know.
@repr(C)
pub struct TaskControlBlock<F, T> {
    pub slot: TaskSlot<T>,
    pub future: F,
    pub has_future: bool,
}

pub struct TaskHandle<T> {
    pub raw_task: *mut TaskHeader,
    pub task_id: TaskId,
}

unsafe impl<T: Send> Send for TaskHandle<T> {}
impl<T> !Copy for TaskHandle<T> {}

pub struct LocalTaskHandle<T> {
    pub raw_task: *mut TaskHeader,
    pub task_id: TaskId,
}

impl<T> !Copy for LocalTaskHandle<T> {}
impl<T> !Send for LocalTaskHandle<T> {}

pub unsafe fn task_take_output<T>(raw: *mut TaskHeader) -> T {
    let slot = raw as *mut TaskSlot<T>;
    (*slot).has_output = false;
    (*slot).output
}

// Register `w` to be woken when the task reaches a terminal state, replacing (dropping) a waker
// registered before. Returns false when the task has already completed: `w` is dropped and the caller
// must re-read the task state (terminal by then) instead of waiting. Only the task's single handle
// registers, so registrations never race each other, only the completion.
pub unsafe fn task_register_join_waker(raw: *mut TaskHeader, w: Waker) -> bool {
    let slot = raw as *mut TaskSlot<u8>;
    let lw = waker_leak(w);
    let mut s: u32 = (*slot).join_state.load(Ordering.Acquire);
    loop {
        if (s & JOIN_COMPLETE) != 0u32 {
            raw_waker_drop(lw.data, lw.vtable);
            return false;
        }
        let cas = (*slot).join_state.compare_exchange(s, s | JOIN_REGISTERING, Ordering.AcqRel, Ordering.Acquire);
        if cas.ok {
            break;
        }
        s = cas.val;
    }
    // REGISTERING is held: the waker fields are ours.
    if (s & JOIN_WAKER_SET) != 0u32 {
        raw_waker_drop((*slot).join_waker_data, (*slot).join_waker_vt);
    }
    (*slot).join_waker_data = lw.data;
    (*slot).join_waker_vt = lw.vtable;
    let mut cur: u32 = s | JOIN_REGISTERING;
    loop {
        if (cur & JOIN_COMPLETE) != 0u32 {
            // Completed while we were registering; the completer left the fields to us.
            (*slot).join_state.store(JOIN_COMPLETE, Ordering.Release);
            raw_waker_drop(lw.data, lw.vtable);
            return false;
        }
        let published: u32 = (cur & (0xFFFFFFFFu32 - JOIN_REGISTERING)) | JOIN_WAKER_SET;
        let cas = (*slot).join_state.compare_exchange(cur, published, Ordering.AcqRel, Ordering.Acquire);
        if cas.ok {
            return true;
        }
        cur = cas.val;
    }
}

// Completion side of the join-waker protocol: called exactly once per task, after the terminal state
// has been published (see `task_finish`).
pub unsafe fn task_wake_join_waker(raw: *mut TaskHeader) {
    let slot = raw as *mut TaskSlot<u8>;
    let prev: u32 = (*slot).join_state.fetch_or(JOIN_COMPLETE, Ordering.AcqRel);
    if (prev & JOIN_REGISTERING) != 0u32 {
        return;
    }
    if (prev & JOIN_WAKER_SET) != 0u32 {
        let data = (*slot).join_waker_data;
        let vt = (*slot).join_waker_vt;
        (*slot).join_state.store(JOIN_COMPLETE, Ordering.Release);
        raw_waker_wake(data, vt);
    }
}

// Publish a terminal state (TASK_COMPLETED / TASK_CANCELLED / TASK_PANICKED) and fire the join waker.
pub unsafe fn task_finish(raw: *mut TaskHeader, terminal: u32) {
    task_set_terminal(raw, terminal);
    task_wake_join_waker(raw);
}

// Drop the future stored in the control block, once.
pub unsafe fn tcb_drop_future<F, T>(tcb: *mut TaskControlBlock<F, T>) {
    if (*tcb).has_future {
        (*tcb).has_future = false;
        let mut tmp: [1]F = [*address_of_mut((*tcb).future)];
    }
}

// Drop whatever payload the control block still stores: the future and an output that was never
// taken. Poll functions do this when they are called with a null Context (see TaskControlBlock).
pub unsafe fn tcb_drop_payload<F, T>(tcb: *mut TaskControlBlock<F, T>) {
    tcb_drop_future<F, T>(tcb);
    if (*tcb).slot.has_output {
        (*tcb).slot.has_output = false;
        let mut out: [1]T = [*address_of_mut((*tcb).slot.output)];
    }
}

pub fn tcb_poll_fn<F: Future<Output = T>, T>(tcb: *mut TaskControlBlock<F, T>, cx_raw: *mut u8) -> u32 {
    let raw = tcb as *mut TaskHeader;
    if (cx_raw as usize) == 0 {
        unsafe {
            tcb_drop_payload<F, T>(tcb);
        }
        return task_state(raw);
    }

    // NOTIFIED -> POLLING keeping the flag bits: a plain store would erase a cancel request made
    // while the task was queued.
    let st: u32 = task_begin_poll(raw);
    if (st & FLAG_CANCEL_REQUESTED) != 0u32 {
        unsafe {
            tcb_drop_future<F, T>(tcb);
            task_finish(raw, TASK_CANCELLED);
        }
        return TASK_CANCELLED;
    }

    let p_cx = cx_raw as *mut Context;
    let poll_res = unsafe { (*tcb).future.poll(mut_view(*p_cx)) };

    match poll_res {
        Poll.Ready(val) => {
            unsafe {
                tcb_drop_future<F, T>(tcb);
                (*tcb).slot.output = val;
                (*tcb).slot.has_output = true;
                task_finish(raw, TASK_COMPLETED);
            }
            TASK_COMPLETED
        },
        Poll.Pending => {
            // POLLING -> IDLE, or back to the queue when a wake (or a cancel request) arrived.
            task_end_poll_pending(raw)
        },
    }
}

// Release a control block whose last reference is gone. A stored output nobody took (detached task,
// handle dropped after completion, group dropped before collecting) is dropped through the task's
// poll function called with a null Context; a join waker that was never consumed is released; then
// the memory is freed.
pub fn default_task_drop(raw: *mut TaskHeader) {
    if (raw as usize) == 0 {
        return;
    }
    let slot = raw as *mut TaskSlot<u8>;
    if unsafe { (*slot).has_output } {
        let poll_fn = unsafe { (*raw).poll_fn };
        poll_fn(raw as *mut u8, 0 as *mut u8);
    }
    let js: u32 = unsafe { (*slot).join_state.load(Ordering.Acquire) };
    if (js & JOIN_WAKER_SET) != 0u32 {
        unsafe {
            (*slot).join_state.store(JOIN_COMPLETE, Ordering.Release);
            raw_waker_drop((*slot).join_waker_data, (*slot).join_waker_vt);
        }
    }
    let sz = unsafe { (*raw).alloc_size };
    let al = unsafe { (*raw).alloc_align };
    unsafe {
        heap_free(raw as *mut u8, sz, al);
    }
}

// Shared by TaskHandle / LocalTaskHandle: the handle's reference is released by the caller.
fn handle_cancel_unless_done(raw: *mut TaskHeader) {
    let st: u32 = unsafe { (*raw).state.load(Ordering.Acquire) };
    if (st & TASK_STATE_MASK) < TASK_COMPLETED && (st & FLAG_DETACHED) == 0u32 {
        task_request_cancel(raw);
    }
}

fn handle_detach(raw: *mut TaskHeader) {
    unsafe {
        (*raw).state.fetch_or(FLAG_DETACHED, Ordering.Release);
    }
    task_dec_ref(raw);
}

// `Future` side of a handle with output i64: Ready with the result once the task is terminal (the
// handle's reference is released then), otherwise the join waker is (re-)registered.
fn handle_poll_i64(raw: *mut TaskHeader, cx: mut_view<Context>) -> Poll<Result<i64, TaskError>> {
    loop {
        let st: u32 = task_state(raw);
        if st == TASK_COMPLETED {
            let out: i64 = unsafe { task_take_output<i64>(raw) };
            task_dec_ref(raw);
            return Poll.Ready(Result.Ok(out));
        }
        if st == TASK_CANCELLED {
            task_dec_ref(raw);
            return Poll.Ready(Result.Err(TaskError.Cancelled));
        }
        if st == TASK_PANICKED {
            task_dec_ref(raw);
            return Poll.Ready(Result.Err(TaskError.Panicked));
        }
        // `mut_view(*cx)`: a bare `cx.waker()` counts as a move of `cx` (T421 FU-6).
        let w = mut_view(*cx).waker();
        if unsafe { task_register_join_waker(raw, w) } {
            return Poll.Pending;
        }
        // Completed while registering: the state is terminal now, loop once more to collect it.
    }
}

impl<T> TaskHandle<T> {
    pub fn id(self: view<TaskHandle<T>>) -> TaskId {
        self.task_id
    }

    pub fn is_finished(self: view<TaskHandle<T>>) -> bool {
        if (self.raw_task as usize) == 0 {
            return true;
        }
        task_state(self.raw_task) >= TASK_COMPLETED
    }

    pub fn cancel(self: view<TaskHandle<T>>) {
        if (self.raw_task as usize) == 0 {
            return;
        }
        task_request_cancel(self.raw_task);
    }

    pub fn detach(mut self: TaskHandle<T>) {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        if (raw as usize) != 0 {
            handle_detach(raw);
        }
    }

    pub fn join(mut self: TaskHandle<T>) -> TaskResult<T> {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        if (raw as usize) == 0 {
            return TaskResult.Cancelled;
        }
        while task_state(raw) < TASK_COMPLETED {
            unsafe {
                thread_yield();
            }
        }
        let st: u32 = task_state(raw);
        let res = if st == TASK_COMPLETED {
            let slot = raw as *mut TaskSlot<T>;
            let out = unsafe { (*slot).output };
            unsafe { (*slot).has_output = false; }
            TaskResult.Completed(out)
        } else if st == TASK_CANCELLED {
            TaskResult.Cancelled
        } else {
            TaskResult.Panicked
        };
        task_dec_ref(raw);
        res
    }
}

impl Future for TaskHandle<i64> {
    type Output = Result<i64, TaskError>;

    fn poll(self: mut_view<TaskHandle<i64>>, cx: mut_view<Context>) -> Poll<Result<i64, TaskError>> {
        let raw = self.raw_task;
        if (raw as usize) == 0 {
            return Poll.Ready(Result.Err(TaskError.Cancelled));
        }
        let r = handle_poll_i64(raw, mut_view(*cx));
        match r {
            Poll.Ready(v) => {
                self.raw_task = 0 as *mut TaskHeader;
                Poll.Ready(v)
            },
            Poll.Pending => Poll.Pending,
        }
    }
}

impl<T> Drop for TaskHandle<T> {
    fn drop(self: mut_view<TaskHandle<T>>) {
        let raw = self.raw_task;
        if (raw as usize) != 0 {
            self.raw_task = 0 as *mut TaskHeader;
            handle_cancel_unless_done(raw);
            task_dec_ref(raw);
        }
    }
}

impl<T> LocalTaskHandle<T> {
    pub fn id(self: view<LocalTaskHandle<T>>) -> TaskId {
        self.task_id
    }

    pub fn is_finished(self: view<LocalTaskHandle<T>>) -> bool {
        if (self.raw_task as usize) == 0 {
            return true;
        }
        task_state(self.raw_task) >= TASK_COMPLETED
    }

    pub fn cancel(self: view<LocalTaskHandle<T>>) {
        if (self.raw_task as usize) == 0 {
            return;
        }
        task_request_cancel(self.raw_task);
    }

    pub fn detach(mut self: LocalTaskHandle<T>) {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        if (raw as usize) != 0 {
            handle_detach(raw);
        }
    }

    pub fn join(mut self: LocalTaskHandle<T>) -> TaskResult<T> {
        let raw = self.raw_task;
        self.raw_task = 0 as *mut TaskHeader;
        if (raw as usize) == 0 {
            return TaskResult.Cancelled;
        }
        while task_state(raw) < TASK_COMPLETED {
            unsafe {
                thread_yield();
            }
        }
        let st: u32 = task_state(raw);
        let res = if st == TASK_COMPLETED {
            let slot = raw as *mut TaskSlot<T>;
            let out = unsafe { (*slot).output };
            unsafe { (*slot).has_output = false; }
            TaskResult.Completed(out)
        } else if st == TASK_CANCELLED {
            TaskResult.Cancelled
        } else {
            TaskResult.Panicked
        };
        task_dec_ref(raw);
        res
    }
}

impl Future for LocalTaskHandle<i64> {
    type Output = Result<i64, TaskError>;

    fn poll(self: mut_view<LocalTaskHandle<i64>>, cx: mut_view<Context>) -> Poll<Result<i64, TaskError>> {
        let raw = self.raw_task;
        if (raw as usize) == 0 {
            return Poll.Ready(Result.Err(TaskError.Cancelled));
        }
        let r = handle_poll_i64(raw, mut_view(*cx));
        match r {
            Poll.Ready(v) => {
                self.raw_task = 0 as *mut TaskHeader;
                Poll.Ready(v)
            },
            Poll.Pending => Poll.Pending,
        }
    }
}

impl<T> Drop for LocalTaskHandle<T> {
    fn drop(self: mut_view<LocalTaskHandle<T>>) {
        let raw = self.raw_task;
        if (raw as usize) != 0 {
            self.raw_task = 0 as *mut TaskHeader;
            handle_cancel_unless_done(raw);
            task_dec_ref(raw);
        }
    }
}

// std.asyn.executor - LocalExecutor & Work-Stealing Multi-Thread Executor (SPEC-34 §2)
module std.asyn.executor

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.core.result.Result
use std.core.option.Option
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.thread_spawn
use std.core.host.thread_join
use std.core.host.thread_current_id
use std.core.host.thread_yield
use std.core.host.futex_wait
use std.core.host.futex_wake

use std.asyn.waker.TaskHeader
use std.asyn.waker.TASK_IDLE
use std.asyn.waker.TASK_POLLING
use std.asyn.waker.TASK_NOTIFIED
use std.asyn.waker.TASK_COMPLETED
use std.asyn.waker.TASK_CANCELLED
use std.asyn.waker.TASK_PANICKED
use std.asyn.waker.FLAG_CANCEL_REQUESTED
use std.asyn.waker.FLAG_DETACHED
use std.asyn.waker.make_task_waker
use std.asyn.waker.task_wake
use std.asyn.waker.task_dec_ref
use std.asyn.waker.init_task_header_vtable
use std.asyn.waker.new_task_waker_vtable

use std.asyn.task.TaskId
use std.asyn.task.TaskHandle
use std.asyn.task.LocalTaskHandle
use std.asyn.task.TaskControlBlock
use std.asyn.task.default_task_drop

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// -----------------------------------------------------------------------------
// Cooperative Task Yield (AXS-EXEC-014)
// -----------------------------------------------------------------------------

pub struct YieldNowFuture {
    pub yielded: bool,
}

impl Future for YieldNowFuture {
    type Output = ();

    fn poll(self: mut_view<YieldNowFuture>, cx: mut_view<Context>) -> Poll<()> {
        if self.yielded {
            return Poll.Ready(());
        }
        self.yielded = true;
        let mut w = cx.waker();
        view(w).wake_by_ref();
        Poll.Pending
    }
}

pub fn yield_now() -> YieldNowFuture {
    YieldNowFuture { yielded: false }
}

// -----------------------------------------------------------------------------
// Single-Threaded LocalExecutor (AXS-EXEC-010)
// -----------------------------------------------------------------------------

pub struct LocalExecutor {
    pub owner_thread: u64,
    pub ready_head: *mut TaskHeader,
    pub ready_tail: *mut TaskHeader,
    pub active_tasks: usize,
    pub next_task_id: u64,
    pub waker_vtable: *const RawWakerVTable,
}

fn local_schedule(task: *mut TaskHeader) {
    if (task as usize) == 0 {
        return;
    }
    let p_exec = unsafe { (*task).schedule_data as *mut LocalExecutor };
    if (p_exec as usize) != 0 {
        local_enqueue(p_exec, task);
    }
}

fn local_enqueue(exec: *mut LocalExecutor, task: *mut TaskHeader) {
    if (exec as usize) == 0 {
        return;
    }
    unsafe {
        (*task).queue_next = 0 as *mut TaskHeader;
        if ((*exec).ready_tail as usize) == 0 {
            (*exec).ready_head = task;
            (*exec).ready_tail = task;
        } else {
            (*(*exec).ready_tail).queue_next = task;
            (*exec).ready_tail = task;
        }
    }
}

fn local_dequeue(exec: *mut LocalExecutor) -> *mut TaskHeader {
    if (exec as usize) == 0 {
        return 0 as *mut TaskHeader;
    }
    let h = unsafe { (*exec).ready_head };
    if (h as usize) == 0 {
        return 0 as *mut TaskHeader;
    }
    unsafe {
        (*exec).ready_head = (*h).queue_next;
        if ((*exec).ready_head as usize) == 0 {
            (*exec).ready_tail = 0 as *mut TaskHeader;
        }
        (*h).queue_next = 0 as *mut TaskHeader;
    }
    h
}

impl LocalExecutor {
    pub fn new() -> LocalExecutor {
        LocalExecutor {
            owner_thread: unsafe { thread_current_id() },
            ready_head: 0 as *mut TaskHeader,
            ready_tail: 0 as *mut TaskHeader,
            active_tasks: 0,
            next_task_id: 1,
            waker_vtable: new_task_waker_vtable(),
        }
    }

    pub fn spawn_local<F: Future<Output = T>, T>(self: mut_view<LocalExecutor>, fut: F, poll_fn: fn(*mut u8, *mut u8) -> u32) -> LocalTaskHandle<T> {
        let p_self = unsafe { address_of_mut(*self) as *mut LocalExecutor };
        let sz = size_of<TaskControlBlock<F, T>>();
        let al = align_of<TaskControlBlock<F, T>>();
        let raw = unsafe { heap_alloc(sz, al) };
        let tcb = raw as *mut TaskControlBlock<F, T>;
        let tid = TaskId { id: self.next_task_id };
        self.next_task_id = self.next_task_id + 1u64;

        unsafe {
            init_task_header_vtable(raw as *mut TaskHeader, self.waker_vtable);
            (*tcb).slot.header.state = Atomic.new(TASK_NOTIFIED);
            (*tcb).slot.header.ref_count = Atomic.new(2u32);
            (*tcb).slot.header.task_id = tid.id;
            (*tcb).slot.header.owner_thread_id = self.owner_thread;
            (*tcb).slot.header.queue_next = 0 as *mut TaskHeader;
            (*tcb).slot.header.schedule_fn = local_schedule;
            (*tcb).slot.header.poll_fn = poll_fn;
            (*tcb).slot.header.drop_fn = default_task_drop;
            (*tcb).slot.header.schedule_data = p_self as *mut u8;
            (*tcb).slot.header.alloc_size = sz;
            (*tcb).slot.header.alloc_align = al;
            (*tcb).slot.has_output = false;
            (*tcb).slot.join_state = Atomic.new(0u32);
            (*tcb).future = fut;
            (*tcb).has_future = true;
        }

        local_enqueue(p_self, raw as *mut TaskHeader);
        self.active_tasks = self.active_tasks + 1;

        LocalTaskHandle {
            raw_task: raw as *mut TaskHeader,
            task_id: tid,
        }
    }

    pub fn try_tick(self: mut_view<LocalExecutor>) -> bool {
        let p_self = unsafe { address_of_mut(*self) as *mut LocalExecutor };
        let task = local_dequeue(p_self);
        if (task as usize) == 0 {
            return false;
        }
        let w = make_task_waker(task);
        let mut cx = Context { waker_val: w };
        let poll_fn = unsafe { (*task).poll_fn };
        let st: u32 = poll_fn(task as *mut u8, unsafe { address_of_mut<Context>(cx) as *mut u8 });
        if st >= TASK_COMPLETED {
            if self.active_tasks > 0 {
                self.active_tasks = self.active_tasks - 1;
            }
            task_dec_ref(task);
        }
        true
    }

    pub fn run(self: mut_view<LocalExecutor>) {
        while self.active_tasks > 0 {
            if !mut_view(*self).try_tick() {
                unsafe {
                    thread_yield();
                }
            }
        }
    }

    pub fn run_until<F: Future<Output = T>, T>(self: mut_view<LocalExecutor>, mut main_fut: F) -> T {
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        loop {
            match main_fut.poll(mut_view(cx)) {
                Poll.Ready(val) => {
                    return val;
                },
                Poll.Pending => {
                    if !mut_view(*self).try_tick() {
                        unsafe {
                            thread_yield();
                        }
                    }
                },
            }
        }
    }

    pub fn active_task_count(self: view<LocalExecutor>) -> usize {
        self.active_tasks
    }
}

// -----------------------------------------------------------------------------
// Multi-Threaded Work-Stealing Executor (AXS-EXEC-011..012)
// -----------------------------------------------------------------------------

pub struct ExecutorConfig {
    pub worker_count: usize,
    pub local_queue_capacity: usize,
    pub global_queue_capacity: usize,
}

const LOCAL_QUEUE_CAP: usize = 256;

@repr(C)
pub struct WorkerData {
    pub worker_id: usize,
    pub thread_handle: i64,
    pub head: Atomic<usize>,
    pub tail: Atomic<usize>,
    pub queue: [256]*mut TaskHeader,
    // Opaque pointer to the owning ExecutorInner. A field typed `*mut ExecutorInner` here would be a
    // forward reference to a later-declared struct, which currently yields wrong field offsets
    // through the pointer (see T421 report, follow-up FU-1); cast at use instead.
    pub executor: *mut u8,
    // OS thread id of the worker (0 until the worker thread has started).
    pub tid: Atomic<u64>,
}

@repr(C)
pub struct ExecutorInner {
    pub worker_count: usize,
    pub workers: *mut WorkerData,
    pub global_head: *mut TaskHeader,
    pub global_tail: *mut TaskHeader,
    pub global_lock: Atomic<u32>,
    pub global_count: Atomic<usize>,
    pub shutdown: Atomic<bool>,
    pub park_word: Atomic<u32>,
    pub active_tasks: Atomic<usize>,
    pub next_task_id: Atomic<u64>,
    pub waker_vtable: *const RawWakerVTable,
    pub steal_count: Atomic<usize>,
}

// A copyable handle to the shared executor state (like an Arc handle): tasks may hold a copy to spawn
// child tasks. `shutdown` must be called on exactly one handle once all work has completed.
@derive(Copy)
pub struct Executor {
    pub inner: *mut ExecutorInner,
}

fn spin_lock(inner: *mut ExecutorInner) {
    while unsafe { (*inner).global_lock.compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed).val != 0u32 } {
        unsafe {
            thread_yield();
        }
    }
}

fn spin_unlock(inner: *mut ExecutorInner) {
    unsafe {
        (*inner).global_lock.store(0u32, Ordering.Release);
    }
}

fn executor_global_enqueue(inner: *mut ExecutorInner, task: *mut TaskHeader) {
    spin_lock(inner);
    unsafe {
        (*task).queue_next = 0 as *mut TaskHeader;
        if ((*inner).global_tail as usize) == 0 {
            (*inner).global_head = task;
            (*inner).global_tail = task;
        } else {
            (*(*inner).global_tail).queue_next = task;
            (*inner).global_tail = task;
        }
        (*inner).global_count.fetch_add(1usize, Ordering.Release);
        (*inner).park_word.fetch_add(1u32, Ordering.Release);
        futex_wake(address_of((*inner).park_word) as *const u32, 1u32);
    }
    spin_unlock(inner);
}

fn executor_global_dequeue(inner: *mut ExecutorInner) -> *mut TaskHeader {
    spin_lock(inner);
    let h = unsafe { (*inner).global_head };
    if (h as usize) != 0 {
        unsafe {
            (*inner).global_head = (*h).queue_next;
            if ((*inner).global_head as usize) == 0 {
                (*inner).global_tail = 0 as *mut TaskHeader;
            }
            (*h).queue_next = 0 as *mut TaskHeader;
            (*inner).global_count.fetch_sub(1usize, Ordering.Release);
        }
    }
    spin_unlock(inner);
    h
}

fn worker_push_local(w: *mut WorkerData, task: *mut TaskHeader) -> bool {
    let t: usize = unsafe { (*w).tail.load(Ordering.Relaxed) };
    let h: usize = unsafe { (*w).head.load(Ordering.Acquire) };
    if t >= h {
        if (t - h) >= LOCAL_QUEUE_CAP {
            return false;
        }
    }
    let idx = t % LOCAL_QUEUE_CAP;
    unsafe {
        (*w).queue[idx] = task;
        (*w).tail.store(t + 1usize, Ordering.Release);
    }
    true
}

fn worker_pop_local(w: *mut WorkerData) -> *mut TaskHeader {
    let t: usize = unsafe { (*w).tail.load(Ordering.Relaxed) };
    let h: usize = unsafe { (*w).head.load(Ordering.Acquire) };
    if t <= h {
        return 0 as *mut TaskHeader;
    }
    let new_t: usize = t - 1usize;
    unsafe {
        (*w).tail.store(new_t, Ordering.SeqCst);
    }
    let h_now: usize = unsafe { (*w).head.load(Ordering.SeqCst) };
    if h_now <= new_t {
        let idx = new_t % LOCAL_QUEUE_CAP;
        let task = unsafe { (*w).queue[idx] };
        if h_now == new_t {
            let cas = unsafe { (*w).head.compare_exchange(h_now, h_now + 1usize, Ordering.AcqRel, Ordering.Relaxed) };
            unsafe {
                (*w).tail.store(h_now + 1usize, Ordering.Relaxed);
            }
            if !cas.ok {
                return 0 as *mut TaskHeader;
            }
        }
        return task;
    } else {
        unsafe {
            (*w).tail.store(h_now, Ordering.Relaxed);
        }
        return 0 as *mut TaskHeader;
    }
}

fn worker_steal_from(victim: *mut WorkerData) -> *mut TaskHeader {
    let h: usize = unsafe { (*victim).head.load(Ordering.Acquire) };
    let t: usize = unsafe { (*victim).tail.load(Ordering.Acquire) };
    if h >= t {
        return 0 as *mut TaskHeader;
    }
    let idx = h % LOCAL_QUEUE_CAP;
    let task = unsafe { (*victim).queue[idx] };
    let cas = unsafe { (*victim).head.compare_exchange(h, h + 1usize, Ordering.AcqRel, Ordering.Relaxed) };
    if cas.ok {
        task
    } else {
        0 as *mut TaskHeader
    }
}

// Returns the WorkerData of the calling OS thread, or null when the caller is not a worker thread.
fn current_worker(inner: *mut ExecutorInner) -> *mut WorkerData {
    let me: u64 = unsafe { thread_current_id() };
    let n: usize = unsafe { (*inner).worker_count };
    let base: *mut WorkerData = unsafe { (*inner).workers };
    let mut i: usize = 0usize;
    while i < n {
        let w: *mut WorkerData = unsafe { base + i };
        let tid: u64 = unsafe { (*w).tid.load(Ordering.Acquire) };
        if tid == me {
            return w;
        }
        i = i + 1usize;
    }
    0 as *mut WorkerData
}

// A wake issued from a worker thread goes to that worker's local deque (single producer: the owner);
// wakes from other threads, or a full local deque, go to the bounded-order global injection queue.
fn executor_schedule(task: *mut TaskHeader) {
    if (task as usize) == 0 {
        return;
    }
    let inner = unsafe { (*task).schedule_data as *mut ExecutorInner };
    if (inner as usize) != 0 {
        let w = current_worker(inner);
        if (w as usize) != 0 {
            if worker_push_local(w, task) {
                return;
            }
        }
        executor_global_enqueue(inner, task);
    }
}

fn executor_try_help_one(inner: *mut ExecutorInner) -> bool {
    let task = executor_global_dequeue(inner);
    if (task as usize) == 0 {
        return false;
    }
    let w = make_task_waker(task);
    let mut cx = Context { waker_val: w };
    let poll_fn = unsafe { (*task).poll_fn };
    let st: u32 = poll_fn(task as *mut u8, unsafe { address_of_mut<Context>(cx) as *mut u8 });
    if st >= TASK_COMPLETED {
        unsafe {
            (*inner).active_tasks.fetch_sub(1usize, Ordering.Release);
        }
        task_dec_ref(task);
    }
    true
}

fn worker_thread_main(ctx: *mut u8) -> i64 {
    let w = ctx as *mut WorkerData;
    let inner = unsafe { (*w).executor as *mut ExecutorInner };
    unsafe {
        (*w).tid.store(thread_current_id(), Ordering.Release);
    }
    let mut poll_count: usize = 0usize;


    loop {
        let is_shutdown: bool = unsafe { (*inner).shutdown.load(Ordering.Acquire) };
        if is_shutdown {
            let active: usize = unsafe { (*inner).active_tasks.load(Ordering.Acquire) };
            if active == 0usize {
                break;
            }
        }
        poll_count = poll_count + 1usize;
        let mut task: *mut TaskHeader = 0 as *mut TaskHeader;

        // 1. Every 61 polls, check global queue first (fairness tick)
        if (poll_count % 61usize) == 0usize {
            task = executor_global_dequeue(inner);
        }

        // 2. Otherwise pop from local queue
        if (task as usize) == 0 {
            task = worker_pop_local(w);
        }

        // 3. If local empty, check global queue
        if (task as usize) == 0 {
            task = executor_global_dequeue(inner);
        }

        // 4. If global also empty, attempt work stealing
        if (task as usize) == 0 {
            let num_workers: usize = unsafe { (*inner).worker_count };
            let workers_base: *mut WorkerData = unsafe { (*inner).workers };
            let my_id: usize = unsafe { (*w).worker_id };
            let mut i: usize = 0usize;
            while i < num_workers {
                let victim_id: usize = (my_id + 1usize + i) % num_workers;
                if victim_id != my_id {
                    let victim: *mut WorkerData = unsafe { workers_base + victim_id };
                    let stolen = worker_steal_from(victim);
                    if (stolen as usize) != 0 {
                        unsafe {
                            (*inner).steal_count.fetch_add(1usize, Ordering.Relaxed);
                        }
                        task = stolen;
                        break;
                    }
                }
                i = i + 1usize;
            }
        }

        // 5. If task found, execute poll
        if (task as usize) != 0 {
            let task_w = make_task_waker(task);
            let mut cx = Context { waker_val: task_w };
            let poll_fn = unsafe { (*task).poll_fn };
            let st: u32 = poll_fn(task as *mut u8, unsafe { address_of_mut<Context>(cx) as *mut u8 });
            if st >= TASK_COMPLETED {
                unsafe {
                    (*inner).active_tasks.fetch_sub(1usize, Ordering.Release);
                }
                task_dec_ref(task);
            }
        } else {
            // No work found across all sources: yield or wait
            unsafe {
                thread_yield();
            }
        }
    }
    0i64
}

impl Executor {
    pub fn new(worker_count: usize) -> Executor {
        let count = if worker_count == 0 { 1usize } else { worker_count };
        let sz_inner = size_of<ExecutorInner>();
        let al_inner = align_of<ExecutorInner>();
        let raw_inner = unsafe { heap_alloc(sz_inner, al_inner) };
        let inner = raw_inner as *mut ExecutorInner;

        let sz_workers = count * size_of<WorkerData>();
        let al_workers = align_of<WorkerData>();
        let raw_workers = unsafe { heap_alloc(sz_workers, al_workers) };
        let workers = raw_workers as *mut WorkerData;

        unsafe {
            (*inner).worker_count = count;
            (*inner).workers = workers;
            (*inner).global_head = 0 as *mut TaskHeader;
            (*inner).global_tail = 0 as *mut TaskHeader;
            (*inner).global_lock = Atomic.new(0u32);
            (*inner).global_count = Atomic.new(0usize);
            (*inner).shutdown = Atomic.new(false);
            (*inner).park_word = Atomic.new(0u32);
            (*inner).active_tasks = Atomic.new(0usize);
            (*inner).next_task_id = Atomic.new(1u64);
            (*inner).waker_vtable = new_task_waker_vtable();
            (*inner).steal_count = Atomic.new(0usize);

            let mut i: usize = 0usize;
            while i < count {
                let w: *mut WorkerData = workers + i;
                (*w).worker_id = i;
                (*w).thread_handle = 0i64;
                (*w).head = Atomic.new(0usize);
                (*w).tail = Atomic.new(0usize);
                (*w).executor = inner as *mut u8;
                (*w).tid = Atomic.new(0u64);
                let mut k: usize = 0usize;
                while k < LOCAL_QUEUE_CAP {
                    (*w).queue[k] = 0 as *mut TaskHeader;
                    k = k + 1usize;
                }
                i = i + 1usize;
            }

            // Spawn worker OS threads
            let mut j: usize = 0usize;
            while j < count {
                let w: *mut WorkerData = workers + j;
                let th = thread_spawn(worker_thread_main, w as *mut u8, 0usize);
                (*w).thread_handle = th;
                j = j + 1usize;
            }
        }

        Executor { inner: inner }
    }

    pub fn spawn<F: Future<Output = T> + Send, T: Send>(self: view<Executor>, fut: F, poll_fn: fn(*mut u8, *mut u8) -> u32) -> TaskHandle<T> {
        let inner = self.inner;
        let sz = size_of<TaskControlBlock<F, T>>();
        let al = align_of<TaskControlBlock<F, T>>();
        let raw = unsafe { heap_alloc(sz, al) };
        let tcb = raw as *mut TaskControlBlock<F, T>;
        let tid_val = unsafe { (*inner).next_task_id.fetch_add(1u64, Ordering.Relaxed) };
        let tid = TaskId { id: tid_val };

        unsafe {
            init_task_header_vtable(raw as *mut TaskHeader, (*inner).waker_vtable);
            (*tcb).slot.header.state = Atomic.new(TASK_NOTIFIED);
            (*tcb).slot.header.ref_count = Atomic.new(2u32);
            (*tcb).slot.header.task_id = tid.id;
            (*tcb).slot.header.owner_thread_id = 0u64;
            (*tcb).slot.header.queue_next = 0 as *mut TaskHeader;
            (*tcb).slot.header.schedule_fn = executor_schedule;
            (*tcb).slot.header.poll_fn = poll_fn;
            (*tcb).slot.header.drop_fn = default_task_drop;
            (*tcb).slot.header.schedule_data = inner as *mut u8;
            (*tcb).slot.header.alloc_size = sz;
            (*tcb).slot.header.alloc_align = al;
            (*tcb).slot.has_output = false;
            (*tcb).slot.join_state = Atomic.new(0u32);
            (*tcb).future = fut;
            (*tcb).has_future = true;

            (*inner).active_tasks.fetch_add(1usize, Ordering.Release);
        }

        executor_schedule(raw as *mut TaskHeader);

        TaskHandle {
            raw_task: raw as *mut TaskHeader,
            task_id: tid,
        }
    }

    pub fn block_on<F: Future<Output = T>, T>(self: view<Executor>, mut fut: F) -> T {
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        loop {
            match fut.poll(mut_view(cx)) {
                Poll.Ready(val) => {
                    return val;
                },
                Poll.Pending => {
                    if !executor_try_help_one(self.inner) {
                        unsafe {
                            thread_yield();
                        }
                    }
                },
            }
        }
    }

    pub fn worker_count(self: view<Executor>) -> usize {
        unsafe { (*self.inner).worker_count }
    }

    // Number of tasks that were taken from another worker's local deque (diagnostics / tests).
    pub fn steal_count(self: view<Executor>) -> usize {
        unsafe { (*self.inner).steal_count.load(Ordering.Relaxed) }
    }

    pub fn shutdown(self: view<Executor>) {
        let inner = self.inner;
        if (inner as usize) == 0 {
            return;
        }
        unsafe {
            (*inner).shutdown.store(true, Ordering.Release);
            (*inner).park_word.fetch_add(1u32, Ordering.Release);
            futex_wake(address_of((*inner).park_word) as *const u32, (*inner).worker_count as u32);

            let count = (*inner).worker_count;
            let mut i: usize = 0usize;
            while i < count {
                let w: *mut WorkerData = (*inner).workers + i;
                let th = (*w).thread_handle;
                if th > 0i64 {
                    let mut ret: i64 = 0i64;
                    let _ = thread_join(th, address_of_mut(ret));
                    (*w).thread_handle = 0i64;
                }
                i = i + 1usize;
            }
        }
    }
}

// std.asyn.sync - Async-Aware Synchronization Primitives (SPEC-34 §4 AXS-EXEC-030..033)
module std.asyn.sync

use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker
use std.core.prelude.Context
use std.core.prelude.Future
use std.core.prelude.Poll
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.core.option.Option
use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.thread_yield
use std.asyn.waker.waker_leak
use std.asyn.waker.raw_waker_wake
use std.asyn.waker.raw_waker_drop

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn spin_lock(p_lock: *const Atomic<u32>) {
    while unsafe { (*p_lock).compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed).val != 0u32 } {
        unsafe {
            thread_yield();
        }
    }
}

fn spin_unlock(p_lock: *const Atomic<u32>) {
    unsafe {
        (*p_lock).store(0u32, Ordering.Release);
    }
}

// -----------------------------------------------------------------------------
// AsyncMutex<T> (AXS-EXEC-031)
// -----------------------------------------------------------------------------

@repr(C)
pub struct WaiterNode {
    pub waiter_id: u64,
    pub waker_data: *const u8,
    pub waker_vt: *const RawWakerVTable,
    pub granted: Atomic<bool>,
    pub next: *mut WaiterNode,
}

@repr(C)
pub struct AsyncMutexInner<T> {
    pub locked: Atomic<u32>,
    pub waiters_head: *mut WaiterNode,
    pub waiters_tail: *mut WaiterNode,
    pub queue_lock: Atomic<u32>,
    pub next_waiter_id: Atomic<u64>,
    pub data: T,
}

pub struct AsyncMutex<T> {
    pub inner: *mut AsyncMutexInner<T>,
}

unsafe impl<T: Send> Send for AsyncMutex<T> {}
unsafe impl<T: Send> Share for AsyncMutex<T> {}
impl<T> !Copy for AsyncMutex<T> {}

pub struct AsyncMutexGuard<T> {
    pub mutex: *mut AsyncMutexInner<T>,
}

unsafe impl<T: Send> Send for AsyncMutexGuard<T> {}
unsafe impl<T: Share> Share for AsyncMutexGuard<T> {}
impl<T> !Copy for AsyncMutexGuard<T> {}

pub struct AsyncMutexLockFuture<T> {
    pub mutex: *mut AsyncMutexInner<T>,
    pub waiter_id: u64,
    pub node: *mut WaiterNode,
}

impl<T> AsyncMutex<T> {
    pub fn new(val: T) -> AsyncMutex<T> {
        let sz = size_of<AsyncMutexInner<T>>();
        let al = align_of<AsyncMutexInner<T>>();
        let raw = unsafe { heap_alloc(sz, al) };
        let inner = raw as *mut AsyncMutexInner<T>;
        unsafe {
            (*inner).locked = Atomic.new(0u32);
            (*inner).waiters_head = 0 as *mut WaiterNode;
            (*inner).waiters_tail = 0 as *mut WaiterNode;
            (*inner).queue_lock = Atomic.new(0u32);
            (*inner).next_waiter_id = Atomic.new(1u64);
            (*inner).data = val;
        }
        AsyncMutex { inner: inner }
    }

    pub fn lock(self: view<AsyncMutex<T>>) -> AsyncMutexLockFuture<T> {
        self.lock_async()
    }

    pub fn lock_async(self: view<AsyncMutex<T>>) -> AsyncMutexLockFuture<T> {
        let inner = self.inner;
        let w_id = unsafe { (*inner).next_waiter_id.fetch_add(1u64, Ordering.Relaxed) };
        AsyncMutexLockFuture {
            mutex: inner,
            waiter_id: w_id,
            node: 0 as *mut WaiterNode,
        }
    }

    pub fn try_lock(self: view<AsyncMutex<T>>) -> Option<AsyncMutexGuard<T>> {
        let inner = self.inner;
        let cas = unsafe { (*inner).locked.compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            Option.Some(AsyncMutexGuard { mutex: inner })
        } else {
            Option.None
        }
    }
}

impl<T> AsyncMutexGuard<T> {
    pub fn get_ptr(self: view<AsyncMutexGuard<T>>) -> *const T {
        unsafe { address_of<T>((*self.mutex).data) }
    }

    pub fn get_mut_ptr(self: mut_view<AsyncMutexGuard<T>>) -> *mut T {
        unsafe { address_of_mut<T>((*self.mutex).data) }
    }

    pub fn val(self: view<AsyncMutexGuard<T>>) -> T where T: Copy {
        unsafe { (*self.mutex).data }
    }

    pub fn set(self: mut_view<AsyncMutexGuard<T>>, v: T) {
        unsafe { (*self.mutex).data = v; }
    }
}

impl<T> Drop for AsyncMutexGuard<T> {
    fn drop(self: mut_view<AsyncMutexGuard<T>>) {
        let m = self.mutex;
        if (m as usize) == 0 {
            return;
        }
        self.mutex = 0 as *mut AsyncMutexInner<T>;
        let ql: *const Atomic<u32> = unsafe { address_of<Atomic<u32>>((*m).queue_lock) };
        spin_lock(ql);
        let head = unsafe { (*m).waiters_head };
        if (head as usize) != 0 {
            unsafe {
                (*m).waiters_head = (*head).next;
                if ((*m).waiters_head as usize) == 0 {
                    (*m).waiters_tail = 0 as *mut WaiterNode;
                }
                (*head).next = 0 as *mut WaiterNode;
                (*head).granted.store(true, Ordering.Release);
                raw_waker_wake((*head).waker_data, (*head).waker_vt);
            }
        } else {
            unsafe {
                (*m).locked.store(0u32, Ordering.Release);
            }
        }
        spin_unlock(ql);
    }
}

impl<T> AsyncMutexLockFuture<T> {
    pub fn poll_lock(self: mut_view<AsyncMutexLockFuture<T>>, cx: mut_view<Context>) -> Poll<AsyncMutexGuard<T>> {
        let m = self.mutex;
        if (self.node as usize) != 0 {
            // Re-check `granted` under the queue lock: a releasing guard sets it (and consumes the
            // stored waker) under the same lock, so the waker is never replaced after being consumed.
            let ql0: *const Atomic<u32> = unsafe { address_of<Atomic<u32>>((*m).queue_lock) };
            spin_lock(ql0);
            if unsafe { (*self.node).granted.load(Ordering.Acquire) } {
                spin_unlock(ql0);
                unsafe {
                    heap_free(self.node as *mut u8, size_of<WaiterNode>(), align_of<WaiterNode>());
                }
                self.node = 0 as *mut WaiterNode;
                return Poll.Ready(AsyncMutexGuard { mutex: m });
            }
            unsafe {
                raw_waker_drop((*self.node).waker_data, (*self.node).waker_vt);
                let lw = waker_leak(cx.waker());
                (*self.node).waker_data = lw.data;
                (*self.node).waker_vt = lw.vtable;
            }
            spin_unlock(ql0);
            return Poll.Pending;
        }

        let cas = unsafe { (*m).locked.compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if cas.ok {
            return Poll.Ready(AsyncMutexGuard { mutex: m });
        }

        let raw_n = unsafe { heap_alloc(size_of<WaiterNode>(), align_of<WaiterNode>()) };
        let n = raw_n as *mut WaiterNode;
        unsafe {
            (*n).waiter_id = self.waiter_id;
            let lw = waker_leak(cx.waker());
            (*n).waker_data = lw.data;
            (*n).waker_vt = lw.vtable;
            (*n).granted = Atomic.new(false);
            (*n).next = 0 as *mut WaiterNode;
        }
        self.node = n;

        let ql: *const Atomic<u32> = unsafe { address_of<Atomic<u32>>((*m).queue_lock) };
        spin_lock(ql);
        let cas_retry = unsafe { (*m).locked.compare_exchange(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed) };
        if cas_retry.ok {
            spin_unlock(ql);
            unsafe {
                raw_waker_drop((*n).waker_data, (*n).waker_vt);
                heap_free(raw_n, size_of<WaiterNode>(), align_of<WaiterNode>());
            }
            self.node = 0 as *mut WaiterNode;
            return Poll.Ready(AsyncMutexGuard { mutex: m });
        }

        unsafe {
            if ((*m).waiters_tail as usize) == 0 {
                (*m).waiters_head = n;
                (*m).waiters_tail = n;
            } else {
                (*(*m).waiters_tail).next = n;
                (*m).waiters_tail = n;
            }
        }
        spin_unlock(ql);
        Poll.Pending
    }
}

impl Future for AsyncMutexLockFuture<i64> {
    type Output = AsyncMutexGuard<i64>;

    fn poll(self: mut_view<AsyncMutexLockFuture<i64>>, cx: mut_view<Context>) -> Poll<AsyncMutexGuard<i64>> {
        self.poll_lock(cx)
    }
}

impl<T> Drop for AsyncMutexLockFuture<T> {
    fn drop(self: mut_view<AsyncMutexLockFuture<T>>) {
        let n = self.node;
        if (n as usize) == 0 {
            return;
        }
        self.node = 0 as *mut WaiterNode;
        let m = self.mutex;
        let ql: *const Atomic<u32> = unsafe { address_of<Atomic<u32>>((*m).queue_lock) };
        spin_lock(ql);
        let was_granted: bool = unsafe { (*n).granted.load(Ordering.Acquire) };
        if was_granted {
            let head = unsafe { (*m).waiters_head };
            if (head as usize) != 0 {
                unsafe {
                    (*m).waiters_head = (*head).next;
                    if ((*m).waiters_head as usize) == 0 {
                        (*m).waiters_tail = 0 as *mut WaiterNode;
                    }
                    (*head).next = 0 as *mut WaiterNode;
                    (*head).granted.store(true, Ordering.Release);
                    raw_waker_wake((*head).waker_data, (*head).waker_vt);
                }
            } else {
                unsafe {
                    (*m).locked.store(0u32, Ordering.Release);
                }
            }
        } else {
            let mut cur = unsafe { (*m).waiters_head };
            let mut prev: *mut WaiterNode = 0 as *mut WaiterNode;
            while (cur as usize) != 0 {
                if cur == n {
                    if (prev as usize) != 0 {
                        unsafe {
                            (*prev).next = (*cur).next;
                        }
                    } else {
                        unsafe {
                            (*m).waiters_head = (*cur).next;
                        }
                    }
                    if unsafe { (*m).waiters_tail } == cur {
                        unsafe {
                            (*m).waiters_tail = prev;
                        }
                    }
                    break;
                }
                prev = cur;
                cur = unsafe { (*cur).next };
            }
            unsafe {
                raw_waker_drop((*n).waker_data, (*n).waker_vt);
            }
        }
        spin_unlock(ql);
        unsafe {
            heap_free(n as *mut u8, size_of<WaiterNode>(), align_of<WaiterNode>());
        }
    }
}

// -----------------------------------------------------------------------------
// AsyncSemaphore (AXS-EXEC-033)
// -----------------------------------------------------------------------------

@repr(C)
pub struct SemWaiterNode {
    pub waiter_id: u64,
    pub waker_data: *const u8,
    pub waker_vt: *const RawWakerVTable,
    pub granted: Atomic<bool>,
    pub next: *mut SemWaiterNode,
}

@repr(C)
pub struct AsyncSemaphoreInner {
    pub permits: Atomic<usize>,
    pub waiters_head: *mut SemWaiterNode,
    pub waiters_tail: *mut SemWaiterNode,
    pub queue_lock: Atomic<u32>,
    pub next_waiter_id: Atomic<u64>,
}

pub struct AsyncSemaphore {
    pub inner: *mut AsyncSemaphoreInner,
}

unsafe impl Send for AsyncSemaphore {}
unsafe impl Share for AsyncSemaphore {}
impl !Copy for AsyncSemaphore {}

pub struct AsyncSemaphorePermit {
    pub sem: *mut AsyncSemaphoreInner,
}

unsafe impl Send for AsyncSemaphorePermit {}
impl !Copy for AsyncSemaphorePermit {}

pub struct AsyncSemaphoreAcquireFuture {
    pub sem: *mut AsyncSemaphoreInner,
    pub waiter_id: u64,
    pub node: *mut SemWaiterNode,
}

impl AsyncSemaphore {
    pub fn new(permits: usize) -> AsyncSemaphore {
        let sz = size_of<AsyncSemaphoreInner>();
        let al = align_of<AsyncSemaphoreInner>();
        let raw = unsafe { heap_alloc(sz, al) };
        let inner = raw as *mut AsyncSemaphoreInner;
        unsafe {
            (*inner).permits = Atomic.new(permits);
            (*inner).waiters_head = 0 as *mut SemWaiterNode;
            (*inner).waiters_tail = 0 as *mut SemWaiterNode;
            (*inner).queue_lock = Atomic.new(0u32);
            (*inner).next_waiter_id = Atomic.new(1u64);
        }
        AsyncSemaphore { inner: inner }
    }

    pub fn acquire(self: view<AsyncSemaphore>) -> AsyncSemaphoreAcquireFuture {
        let inner = self.inner;
        let w_id = unsafe { (*inner).next_waiter_id.fetch_add(1u64, Ordering.Relaxed) };
        AsyncSemaphoreAcquireFuture {
            sem: inner,
            waiter_id: w_id,
            node: 0 as *mut SemWaiterNode,
        }
    }

    pub fn try_acquire(self: view<AsyncSemaphore>) -> Option<AsyncSemaphorePermit> {
        let inner = self.inner;
        loop {
            let cur: usize = unsafe { (*inner).permits.load(Ordering.Acquire) };
            if cur == 0usize {
                return Option.None;
            }
            let cas = unsafe { (*inner).permits.compare_exchange_weak(cur, cur - 1usize, Ordering.AcqRel, Ordering.Acquire) };
            if cas.ok {
                return Option.Some(AsyncSemaphorePermit { sem: inner });
            }
        }
    }

    pub fn available_permits(self: view<AsyncSemaphore>) -> usize {
        unsafe { (*self.inner).permits.load(Ordering.Acquire) }
    }
}

impl Drop for AsyncSemaphorePermit {
    fn drop(self: mut_view<AsyncSemaphorePermit>) {
        let s = self.sem;
        if (s as usize) == 0 {
            return;
        }
        self.sem = 0 as *mut AsyncSemaphoreInner;
        let ql: *const Atomic<u32> = unsafe { address_of<Atomic<u32>>((*s).queue_lock) };
        spin_lock(ql);
        let head = unsafe { (*s).waiters_head };
        if (head as usize) != 0 {
            unsafe {
                (*s).waiters_head = (*head).next;
                if ((*s).waiters_head as usize) == 0 {
                    (*s).waiters_tail = 0 as *mut SemWaiterNode;
                }
                (*head).next = 0 as *mut SemWaiterNode;
                (*head).granted.store(true, Ordering.Release);
                raw_waker_wake((*head).waker_data, (*head).waker_vt);
            }
        } else {
            unsafe {
                (*s).permits.fetch_add(1usize, Ordering.Release);
            }
        }
        spin_unlock(ql);
    }
}

impl Future for AsyncSemaphoreAcquireFuture {
    type Output = AsyncSemaphorePermit;

    fn poll(self: mut_view<AsyncSemaphoreAcquireFuture>, cx: mut_view<Context>) -> Poll<AsyncSemaphorePermit> {
        let s = self.sem;
        if (self.node as usize) != 0 {
            let ql0: *const Atomic<u32> = unsafe { address_of<Atomic<u32>>((*s).queue_lock) };
            spin_lock(ql0);
            if unsafe { (*self.node).granted.load(Ordering.Acquire) } {
                spin_unlock(ql0);
                unsafe {
                    heap_free(self.node as *mut u8, size_of<SemWaiterNode>(), align_of<SemWaiterNode>());
                }
                self.node = 0 as *mut SemWaiterNode;
                return Poll.Ready(AsyncSemaphorePermit { sem: s });
            }
            unsafe {
                raw_waker_drop((*self.node).waker_data, (*self.node).waker_vt);
                let lw = waker_leak(cx.waker());
                (*self.node).waker_data = lw.data;
                (*self.node).waker_vt = lw.vtable;
            }
            spin_unlock(ql0);
            return Poll.Pending;
        }

        // Fast path: try to acquire permit
        loop {
            let cur: usize = unsafe { (*s).permits.load(Ordering.Acquire) };
            if cur > 0usize {
                let cas = unsafe { (*s).permits.compare_exchange_weak(cur, cur - 1usize, Ordering.AcqRel, Ordering.Acquire) };
                if cas.ok {
                    return Poll.Ready(AsyncSemaphorePermit { sem: s });
                }
            } else {
                break;
            }
        }

        // Enqueue waiter
        let raw_n = unsafe { heap_alloc(size_of<SemWaiterNode>(), align_of<SemWaiterNode>()) };
        let n = raw_n as *mut SemWaiterNode;
        unsafe {
            (*n).waiter_id = self.waiter_id;
            let lw = waker_leak(cx.waker());
            (*n).waker_data = lw.data;
            (*n).waker_vt = lw.vtable;
            (*n).granted = Atomic.new(false);
            (*n).next = 0 as *mut SemWaiterNode;
        }
        self.node = n;

        let ql: *const Atomic<u32> = unsafe { address_of<Atomic<u32>>((*s).queue_lock) };
        spin_lock(ql);
        // Double check permits under lock
        loop {
            let cur: usize = unsafe { (*s).permits.load(Ordering.Acquire) };
            if cur > 0usize {
                let cas = unsafe { (*s).permits.compare_exchange_weak(cur, cur - 1usize, Ordering.AcqRel, Ordering.Acquire) };
                if cas.ok {
                    spin_unlock(ql);
                    unsafe {
                        raw_waker_drop((*n).waker_data, (*n).waker_vt);
                        heap_free(raw_n, size_of<SemWaiterNode>(), align_of<SemWaiterNode>());
                    }
                    self.node = 0 as *mut SemWaiterNode;
                    return Poll.Ready(AsyncSemaphorePermit { sem: s });
                }
            } else {
                break;
            }
        }

        unsafe {
            if ((*s).waiters_tail as usize) == 0 {
                (*s).waiters_head = n;
                (*s).waiters_tail = n;
            } else {
                (*(*s).waiters_tail).next = n;
                (*s).waiters_tail = n;
            }
        }
        spin_unlock(ql);
        Poll.Pending
    }
}

impl Drop for AsyncSemaphoreAcquireFuture {
    fn drop(self: mut_view<AsyncSemaphoreAcquireFuture>) {
        let n = self.node;
        if (n as usize) == 0 {
            return;
        }
        self.node = 0 as *mut SemWaiterNode;
        let s = self.sem;
        let ql: *const Atomic<u32> = unsafe { address_of<Atomic<u32>>((*s).queue_lock) };
        spin_lock(ql);
        let was_granted: bool = unsafe { (*n).granted.load(Ordering.Acquire) };
        if was_granted {
            let head = unsafe { (*s).waiters_head };
            if (head as usize) != 0 {
                unsafe {
                    (*s).waiters_head = (*head).next;
                    if ((*s).waiters_head as usize) == 0 {
                        (*s).waiters_tail = 0 as *mut SemWaiterNode;
                    }
                    (*head).next = 0 as *mut SemWaiterNode;
                    (*head).granted.store(true, Ordering.Release);
                    raw_waker_wake((*head).waker_data, (*head).waker_vt);
                }
            } else {
                unsafe {
                    (*s).permits.fetch_add(1usize, Ordering.Release);
                }
            }
        } else {
            let mut cur = unsafe { (*s).waiters_head };
            let mut prev: *mut SemWaiterNode = 0 as *mut SemWaiterNode;
            while (cur as usize) != 0 {
                if cur == n {
                    if (prev as usize) != 0 {
                        unsafe {
                            (*prev).next = (*cur).next;
                        }
                    } else {
                        unsafe {
                            (*s).waiters_head = (*cur).next;
                        }
                    }
                    if unsafe { (*s).waiters_tail } == cur {
                        unsafe {
                            (*s).waiters_tail = prev;
                        }
                    }
                    break;
                }
                prev = cur;
                cur = unsafe { (*cur).next };
            }
            unsafe {
                raw_waker_drop((*n).waker_data, (*n).waker_vt);
            }
        }
        spin_unlock(ql);
        unsafe {
            heap_free(n as *mut u8, size_of<SemWaiterNode>(), align_of<SemWaiterNode>());
        }
    }
}

module main

use std.core.option.Option
use std.core.result.Result
use std.core.prelude.Future
use std.core.prelude.Poll
use std.core.prelude.Context
use std.asyn.executor.LocalExecutor
use std.asyn.task.LocalTaskHandle
use std.asyn.task.TaskResult
use std.asyn.task.TaskHeader
use std.asyn.task.TaskControlBlock
use std.asyn.task.tcb_poll_fn
use std.asyn.sync.AsyncSemaphore
use std.asyn.sync.AsyncSemaphorePermit
use std.asyn.sync.AsyncSemaphoreAcquireFuture

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn check(cond: bool) {
    if !cond {
        loop {}
    }
}

// Each worker takes one permit, holds it across an await (yield), then releases it. With two permits
// and five workers, at most two workers may ever be inside the critical section at once.
struct SemWorker {
    pub cur: *mut i64,
    pub max_seen: *mut i64,
    pub done: *mut i64,
    pub phase: i32,
    pub acq: AsyncSemaphoreAcquireFuture,
    pub permit: Option<AsyncSemaphorePermit>,
}

impl Future for SemWorker {
    type Output = i64;

    fn poll(self: mut_view<SemWorker>, cx: mut_view<Context>) -> Poll<i64> {
        if self.phase == 0i32 {
            match self.acq.poll(mut_view(*cx)) {
                Poll.Ready(p) => {
                    self.permit = Option.Some(p);
                    self.phase = 1i32;
                },
                Poll.Pending => {
                    return Poll.Pending;
                },
            }
        }
        if self.phase == 1i32 {
            unsafe {
                *self.cur = *self.cur + 1i64;
                if *self.cur > *self.max_seen {
                    *self.max_seen = *self.cur;
                }
            }
            self.phase = 2i32;
            let mut w = mut_view(*cx).waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        unsafe {
            *self.cur = *self.cur - 1i64;
            *self.done = *self.done + 1i64;
        }
        self.permit = Option.None;
        Poll.Ready(1i64)
    }
}

fn poll_sem_worker(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<SemWorker, i64>;
    tcb_poll_fn<SemWorker, i64>(tcb, cx)
}

fn none_permit() -> Option<AsyncSemaphorePermit> {
    Option.None
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let sem = AsyncSemaphore.new(2usize);
    let mut cur: i64 = 0i64;
    let mut max_seen: i64 = 0i64;
    let mut done: i64 = 0i64;
    let p_cur = unsafe { address_of_mut(cur) };
    let p_max = unsafe { address_of_mut(max_seen) };
    let p_done = unsafe { address_of_mut(done) };

    let h1: LocalTaskHandle<i64> = exec.spawn_local(SemWorker { cur: p_cur, max_seen: p_max, done: p_done, phase: 0i32, acq: sem.acquire(), permit: none_permit() }, poll_sem_worker);
    let h2: LocalTaskHandle<i64> = exec.spawn_local(SemWorker { cur: p_cur, max_seen: p_max, done: p_done, phase: 0i32, acq: sem.acquire(), permit: none_permit() }, poll_sem_worker);
    let h3: LocalTaskHandle<i64> = exec.spawn_local(SemWorker { cur: p_cur, max_seen: p_max, done: p_done, phase: 0i32, acq: sem.acquire(), permit: none_permit() }, poll_sem_worker);
    let h4: LocalTaskHandle<i64> = exec.spawn_local(SemWorker { cur: p_cur, max_seen: p_max, done: p_done, phase: 0i32, acq: sem.acquire(), permit: none_permit() }, poll_sem_worker);
    let h5: LocalTaskHandle<i64> = exec.spawn_local(SemWorker { cur: p_cur, max_seen: p_max, done: p_done, phase: 0i32, acq: sem.acquire(), permit: none_permit() }, poll_sem_worker);

    exec.run();

    check(done == 5i64);
    check(max_seen == 2i64);
    check(cur == 0i64);
    let avail = sem.available_permits();
    check(avail == 2usize);

    print("OK async_semaphore_limits ");
    print_int(max_seen);
    print(" ");
    print_int(done);
    print(" ");
    print_int(avail as i64);
    print("\n");
    0
}
