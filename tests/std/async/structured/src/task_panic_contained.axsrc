module main

use std.core.option.Option
use std.core.result.Result
use std.core.prelude.Context
use std.asyn.executor.Executor
use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskHandle
use std.asyn.task.LocalTaskHandle
use std.asyn.task.TaskResult
use std.asyn.task.TaskControlBlock
use std.asyn.group.group_poll_fn
use std.asyn.group.task_panic

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// A child that reports a (contained) panic on its second poll; counts drops.
struct Crasher {
    pub step: i32,
    pub drops: *mut i64,
}

unsafe impl Send for Crasher {}

impl Future for Crasher {
    type Output = i64;
    fn poll(self: mut_view<Crasher>, cx: mut_view<Context>) -> Poll<i64> {
        let st = self.step;
        if st < 1i32 {
            self.step = st + 1i32;
            let mut w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        task_panic(mut_view(*cx));
        // Returning a value after reporting the panic is allowed: the output is discarded.
        Poll.Ready(99i64)
    }
}

impl Drop for Crasher {
    fn drop(self: mut_view<Crasher>) {
        unsafe {
            *self.drops = *self.drops + 1i64;
        }
    }
}

fn poll_crasher(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Crasher, i64>;
    group_poll_fn<Crasher, i64>(tcb, cx)
}

// A well-behaved sibling: yields twice, completes with 7.
struct Steady {
    pub step: i32,
}

unsafe impl Send for Steady {}

impl Future for Steady {
    type Output = i64;
    fn poll(self: mut_view<Steady>, cx: mut_view<Context>) -> Poll<i64> {
        let st = self.step;
        if st < 2i32 {
            self.step = st + 1i32;
            let mut w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        Poll.Ready(7i64)
    }
}

fn poll_steady(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Steady, i64>;
    group_poll_fn<Steady, i64>(tcb, cx)
}

pub fn main() -> i32 {
    let mut drops: i64 = 0i64;
    let p_drops = unsafe { address_of_mut(drops) };

    // 1. Multi-threaded executor: the panic is contained in the task, reported as Panicked by join,
    // the crashed future is dropped, and the sibling is unaffected.
    let exec = Executor.new(2);
    let hp: TaskHandle<i64> = exec.spawn(Crasher { step: 0i32, drops: p_drops }, poll_crasher);
    let hs: TaskHandle<i64> = exec.spawn(Steady { step: 0i32 }, poll_steady);
    let panicked = match hp.join() {
        TaskResult.Panicked => 1i64,
        _ => 0i64,
    };
    let sibling = match hs.join() {
        TaskResult.Completed(v) => v,
        _ => -1i64,
    };
    check(panicked == 1i64);
    check(sibling == 7i64);
    check(drops == 1i64);
    exec.shutdown();

    // 2. Single-threaded executor: same containment; the executor keeps running other tasks.
    let mut local = LocalExecutor.new();
    let lp: LocalTaskHandle<i64> = local.spawn_local(Crasher { step: 0i32, drops: p_drops }, poll_crasher);
    let ls: LocalTaskHandle<i64> = local.spawn_local(Steady { step: 0i32 }, poll_steady);
    local.run();
    check(view(lp).is_finished());
    let lpanic = match lp.join() {
        TaskResult.Panicked => 1i64,
        _ => 0i64,
    };
    let lsib = match ls.join() {
        TaskResult.Completed(v) => v,
        _ => -1i64,
    };
    check(lpanic == 1i64);
    check(lsib == 7i64);
    check(drops == 2i64);

    print("OK task_panic_contained ");
    print_int(panicked);
    print(" ");
    print_int(lpanic);
    print(" ");
    print_int(sibling);
    print("\n");
    0
}
