module main

// SPEC-34 §6.1 (Positive Example 1) in canonical syntax: a `LocalExecutor` runs `!Send` tasks that
// capture `Rc<T>` (`spawn_local(fut)`, no poll function), the tasks hold an `AsyncMutexGuard`
// across an `.await`, and the main future awaits both `LocalTaskHandle<i64>`s.
//
// Differences from the spec text, all forced by the language/library state (see the T422c report):
// - the module is `std.asyn` (`async` is a keyword) and items are imported one per `use` line;
// - `Rc` has no `get_view()` and `Result` no `unwrap_or` yet: the value is read through
//   `Rc.as_ptr()` and the handle results are matched;
// - the spec's `async move { ... }` block is the `async fn sum_both`.

use std.core.result.Result
use std.sync.rc.Rc
use std.asyn.executor.LocalExecutor
use std.asyn.executor.yield_now
use std.asyn.sync.AsyncMutex
use std.asyn.task.LocalTaskHandle

pub async fn increment_local(rc_val: Rc<i64>, lock: Rc<AsyncMutex<i64>>) -> i64 {
    // Acquire the AsyncMutexGuard and hold it across `.await`:
    let m: *const AsyncMutex<i64> = view(lock).as_ptr();
    let mut guard = unsafe { view(*m).lock() }.await;
    let base = unsafe { *view(rc_val).as_ptr() };
    yield_now().await;
    let cur = guard.val();
    guard.set(cur + base);
    let out = guard.val();
    return out;
}

pub async fn sum_both(h1: LocalTaskHandle<i64>, h2: LocalTaskHandle<i64>) -> i64 {
    let a = match h1.await {
        Result.Ok(v) => v,
        Result.Err(e) => 0i64,
    };
    let b = match h2.await {
        Result.Ok(v) => v,
        Result.Err(e) => 0i64,
    };
    return a + b;
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let shared_rc = Rc.new(10i64);
    let shared_lock = Rc.new(AsyncMutex.new(5i64));

    // `spawn_local` accepts `!Send` futures capturing `Rc<T>`:
    let h1 = exec.spawn_local(increment_local(view(shared_rc).clone(), view(shared_lock).clone()));
    let h2 = exec.spawn_local(increment_local(shared_rc, shared_lock));

    let total = exec.run_until(sum_both(h1, h2));
    print("OK spec34_local_executor_example ");
    print_int(total);
    print("\n");
    if total == 40i64 {
        return 0i32;
    }
    return 1i32;
}
