module main

// SPEC-34 §6.2 (Positive Example 2) in canonical syntax: a work-stealing `Executor`, a
// `TaskGroup<i64>` with `group.spawn(view(exec), fut)`, cooperative `CancellationToken`s and
// `join_all().await` inside an `async fn` driven by `block_on`.
//
// Differences from the spec text, all forced by the language/library state (see the T422c report):
// - the module is `std.asyn` (`async` is a keyword) and items are imported one per `use` line;
// - the `async { ... }` block of the spec is the `async fn sum_chunks`;
// - `join_all` yields `GroupResults<i64>` (no generic `Vec<T>` in std yet), read with `get_ptr`;
// - the group's output type is written (`TaskGroup<i64>`): the compiler does not yet infer a
//   generic impl's parameter from a method's `Future<Output = T>` bound (T448 known limit).

use std.core.result.Result
use std.asyn.executor.Executor
use std.asyn.executor.yield_now
use std.asyn.group.TaskGroup
use std.asyn.cancel.CancellationToken

pub async fn compute_chunk(id: i64, token: CancellationToken) -> i64 {
    if token.is_cancelled() {
        return 0i64;
    }
    yield_now().await;
    return id * 10i64;
}

pub async fn sum_chunks(exec: Executor) -> i64 {
    let mut group: TaskGroup<i64> = TaskGroup.new();
    let tok1 = group.cancellation_token();
    let tok2 = group.cancellation_token();

    let s1 = group.spawn(view(exec), compute_chunk(1i64, tok1));
    let s2 = group.spawn(view(exec), compute_chunk(2i64, tok2));
    check(match s1 { Result.Ok(id) => true, Result.Err(e) => false });
    check(match s2 { Result.Ok(id) => true, Result.Err(e) => false });

    let results = group.join_all().await;
    match results {
        Result.Ok(vec) => {
            let a = unsafe { *vec.get_ptr(0usize) };
            let b = unsafe { *vec.get_ptr(1usize) };
            return a + b;
        },
        Result.Err(_) => {
            return -1i64;
        },
    }
}

pub fn main() -> i32 {
    let exec = Executor.new(4);
    let sum = exec.block_on(sum_chunks(exec));
    exec.shutdown();
    print("OK spec34_task_group_example ");
    print_int(sum);
    print("\n");
    if sum == 30i64 {
        return 0i32;
    }
    return 1i32;
}
