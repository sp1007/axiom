module main

use std.core.option.Option
use std.core.result.Result
use std.core.prelude.Context
use std.asyn.executor.LocalExecutor
use std.asyn.task.LocalTaskHandle
use std.asyn.task.TaskResult
use std.asyn.task.TaskControlBlock
use std.asyn.task.tcb_poll_fn

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Never completes; counts drops.
struct Never {
    pub drops: *mut i64,
}

impl Future for Never {
    type Output = i64;
    fn poll(self: mut_view<Never>, cx: mut_view<Context>) -> Poll<i64> {
        Poll.Pending
    }
}

impl Drop for Never {
    fn drop(self: mut_view<Never>) {
        unsafe {
            *self.drops = *self.drops + 1i64;
        }
    }
}

fn poll_never(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Never, i64>;
    tcb_poll_fn<Never, i64>(tcb, cx)
}

// Yields twice, records that it ran, completes with `val`, counts drops.
struct Runner {
    pub val: i64,
    pub step: i32,
    pub ran: *mut i64,
    pub drops: *mut i64,
}

impl Future for Runner {
    type Output = i64;
    fn poll(self: mut_view<Runner>, cx: mut_view<Context>) -> Poll<i64> {
        let st = self.step;
        if st < 2i32 {
            self.step = st + 1i32;
            let mut w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        unsafe {
            *self.ran = *self.ran + 1i64;
        }
        Poll.Ready(self.val)
    }
}

impl Drop for Runner {
    fn drop(self: mut_view<Runner>) {
        unsafe {
            *self.drops = *self.drops + 1i64;
        }
    }
}

fn poll_runner(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Runner, i64>;
    tcb_poll_fn<Runner, i64>(tcb, cx)
}

pub fn main() -> i32 {
    let mut never_drops: i64 = 0i64;
    let mut runner_drops: i64 = 0i64;
    let mut ran: i64 = 0i64;
    let p_never = unsafe { address_of_mut(never_drops) };
    let p_rdrops = unsafe { address_of_mut(runner_drops) };
    let p_ran = unsafe { address_of_mut(ran) };
    let mut exec = LocalExecutor.new();

    // 1. A structured handle that is dropped without join/detach cancels its task: the future is
    // dropped by the executor and the control block is reclaimed.
    {
        let h: LocalTaskHandle<i64> = exec.spawn_local(Never { drops: p_never }, poll_never);
        check(!view(h).is_finished());
    }
    check(never_drops == 0i64);
    exec.run();
    check(never_drops == 1i64);
    check(exec.active_task_count() == 0usize);

    // 2. The same drop on a task that already completed leaves the result alone (nothing to cancel).
    {
        let h: LocalTaskHandle<i64> = exec.spawn_local(Runner { val: 5i64, step: 0i32, ran: p_ran, drops: p_rdrops }, poll_runner);
        exec.run();
        check(view(h).is_finished());
    }
    check(ran == 1i64);
    check(runner_drops == 1i64);

    // 3. An explicit detach releases the handle but not the task: it runs to completion unobserved.
    {
        let h: LocalTaskHandle<i64> = exec.spawn_local(Runner { val: 6i64, step: 0i32, ran: p_ran, drops: p_rdrops }, poll_runner);
        h.detach();
    }
    exec.run();
    check(ran == 2i64);
    check(runner_drops == 2i64);

    // 4. join consumes the handle and returns the output.
    let hj: LocalTaskHandle<i64> = exec.spawn_local(Runner { val: 7i64, step: 0i32, ran: p_ran, drops: p_rdrops }, poll_runner);
    exec.run();
    let joined = match hj.join() {
        TaskResult.Completed(v) => v,
        _ => -1i64,
    };
    check(joined == 7i64);
    check(ran == 3i64);
    check(runner_drops == 3i64);

    // 5. An explicit cancel followed by join reports Cancelled, and the future is dropped once.
    let hc: LocalTaskHandle<i64> = exec.spawn_local(Never { drops: p_never }, poll_never);
    view(hc).cancel();
    exec.run();
    let cancelled = match hc.join() {
        TaskResult.Cancelled => 1i64,
        _ => 0i64,
    };
    check(cancelled == 1i64);
    check(never_drops == 2i64);

    print("OK handle_drop_vs_detach ");
    print_int(never_drops);
    print(" ");
    print_int(ran);
    print(" ");
    print_int(joined);
    print("\n");
    0
}
