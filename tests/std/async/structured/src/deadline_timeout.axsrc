module main

use std.core.option.Option
use std.core.result.Result
use std.core.prelude.Context
use std.core.host.monotonic_ns
use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskError
use std.asyn.timeout.Deadline
use std.asyn.timeout.TimeoutError
use std.asyn.timeout.Timeout
use std.asyn.timeout.with_deadline
use std.asyn.timeout.with_timeout_ms

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Ready with `val` after `n` extra polls (each poll yields once).
struct ReadyAfter {
    pub n: i32,
    pub val: i64,
}

impl Future for ReadyAfter {
    type Output = i64;
    fn poll(self: mut_view<ReadyAfter>, cx: mut_view<Context>) -> Poll<i64> {
        if self.n > 0i32 {
            self.n = self.n - 1i32;
            let mut w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        Poll.Ready(self.val)
    }
}

// Never completes; counts how often it is dropped.
struct Never {
    pub drops: *mut i64,
}

impl Future for Never {
    type Output = i64;
    fn poll(self: mut_view<Never>, cx: mut_view<Context>) -> Poll<i64> {
        Poll.Pending
    }
}

impl Drop for Never {
    fn drop(self: mut_view<Never>) {
        unsafe {
            *self.drops = *self.drops + 1i64;
        }
    }
}

pub fn main() -> i32 {
    let mut drops: i64 = 0i64;
    let p_drops = unsafe { address_of_mut(drops) };
    let mut expired: i64 = 0i64;
    let mut exec = LocalExecutor.new();

    // Pure deadline arithmetic.
    let d10 = Deadline.at_ns(10u64);
    let d20 = Deadline.at_ns(20u64);
    check(d10.min(d20).deadline_ns == 10u64);
    check(d20.min(d10).deadline_ns == 10u64);
    check(d10.max(d20).deadline_ns == 20u64);
    check(Deadline.never().min(d20).deadline_ns == 20u64);
    check(d20.remaining_ns_at(5u64) == 15u64);
    check(d20.remaining_ns_at(25u64) == 0u64);
    check(d20.is_expired_at(20u64));
    check(!d20.is_expired_at(19u64));
    check(!Deadline.never().is_expired());
    check(Deadline.at_ns(0u64).is_expired());
    check(Deadline.after_ns(18446744073709551615u64).deadline_ns == Deadline.never().deadline_ns);

    // 1. A task that finishes within a generous budget is passed through: `Timeout<F, T>` around a
    // `LocalTaskHandle<i64>` resolves to Ok(the handle's own result).
    let h1 = exec.spawn_local(ReadyAfter { n: 3i32, val: 41i64 });
    let t1 = with_deadline(Deadline.after_ms(3600000u64), h1);
    let v1 = match exec.run_until(t1) {
        Result.Ok(inner) => match inner {
            Result.Ok(v) => v,
            Result.Err(e) => -2i64,
        },
        Result.Err(e) => -1i64,
    };
    check(v1 == 41i64);

    // 2. An already expired deadline fails at once. The expired `Timeout` is dropped when `run_until`
    // returns, which drops the handle: the task is cancelled and its future dropped by the executor.
    let h2 = exec.spawn_local(Never { drops: p_drops });
    let t2 = with_deadline(Deadline.after_ns(0u64), h2);
    match exec.run_until(t2) {
        Result.Ok(inner) => { check(false); },
        Result.Err(e) => { expired = expired + 1i64; },
    }
    exec.run();
    check(drops == 1i64);

    // 3. A short real deadline: expires after at least that long, and not absurdly later.
    let start = monotonic_ns();
    let h3 = exec.spawn_local(Never { drops: p_drops });
    let t3 = with_timeout_ms(10u64, h3);
    let r3 = exec.run_until(t3);
    let elapsed = monotonic_ns() - start;
    match r3 {
        Result.Ok(inner) => { check(false); },
        Result.Err(e) => { expired = expired + 1i64; },
    }
    exec.run();
    check(elapsed >= 10000000u64);
    check(elapsed < 30000000000u64);
    check(drops == 2i64);

    // 4. Budget propagation: the effective budget is the minimum of parent and child deadlines.
    let parent = Deadline.after_ms(3600000u64);
    let own = Deadline.after_ms(5u64);
    let effective = parent.min(own);
    check(effective.deadline_ns == own.deadline_ns);
    let h4 = exec.spawn_local(Never { drops: p_drops });
    let t4 = with_deadline(effective, h4);
    check(t4.deadline().deadline_ns == own.deadline_ns);
    match exec.run_until(t4) {
        Result.Ok(inner) => { check(false); },
        Result.Err(e) => {
            expired = expired + 1i64;
            check(e.deadline_ns == own.deadline_ns);
        },
    }
    exec.run();
    check(drops == 3i64);

    // 5. Nested deadlines: the inner (tighter) one fires first; the outer one passes its error on.
    let h5 = exec.spawn_local(Never { drops: p_drops });
    let inner = with_timeout_ms(5u64, h5);
    let t5 = with_deadline(Deadline.after_ms(3600000u64), inner);
    match exec.run_until(t5) {
        Result.Ok(inner_res) => {
            match inner_res {
                Result.Ok(task_res) => { check(false); },
                Result.Err(e) => { expired = expired + 1i64; },
            }
        },
        Result.Err(e) => { check(false); },
    }
    exec.run();
    check(drops == 4i64);

    // 6. `Timeout<F, T>` directly around a user future (no task): expiry drops the future with the
    // adapter.
    let t6 = with_timeout_ms(5u64, Never { drops: p_drops });
    match exec.run_until(t6) {
        Result.Ok(v) => { check(false); },
        Result.Err(e) => { expired = expired + 1i64; },
    }
    check(drops == 5i64);

    // 7. A user future that completes within its budget is passed through unchanged.
    let t7 = with_timeout_ms(3600000u64, ReadyAfter { n: 2i32, val: 7i64 });
    let v7 = match exec.run_until(t7) {
        Result.Ok(v) => v,
        Result.Err(e) => -1i64,
    };
    check(v7 == 7i64);

    print("OK deadline_timeout ");
    print_int(expired);
    print(" ");
    print_int(drops);
    print("\n");
    0
}
