module main

use std.core.option.Option
use std.core.result.Result
use std.core.prelude.Context
use std.core.host.heap_alloc
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.asyn.executor.Executor
use std.asyn.task.TaskControlBlock
use std.asyn.task.TaskError
use std.asyn.task.TaskResult
use std.asyn.task.TaskHandle
use std.asyn.cancel.CancelledFuture
use std.asyn.cancel.CancellationToken
use std.asyn.group.TaskGroup
use std.asyn.group.GroupResults
use std.asyn.group.group_poll_fn
use std.asyn.group.task_panic

// Every child future counts itself in `alive` on creation and out when it is dropped, so after the
// group is gone `alive == 0` proves that each future's destructor ran exactly once.
fn new_counter() -> *mut Atomic<i64> {
    let raw = unsafe { heap_alloc(8, 8) };
    let p = raw as *mut Atomic<i64>;
    unsafe {
        *p = Atomic.new(0i64);
    }
    p
}

fn born(alive: *mut Atomic<i64>) {
    unsafe {
        (*alive).fetch_add(1i64, Ordering.AcqRel);
    }
}

fn died(alive: *mut Atomic<i64>) {
    unsafe {
        (*alive).fetch_sub(1i64, Ordering.AcqRel);
    }
}

// Runs until cancelled: wakes itself on every poll.
struct Looper {
    pub alive: *mut Atomic<i64>,
}

unsafe impl Send for Looper {}

impl Future for Looper {
    type Output = i64;
    fn poll(self: mut_view<Looper>, cx: mut_view<Context>) -> Poll<i64> {
        let mut w = cx.waker();
        view(w).wake_by_ref();
        Poll.Pending
    }
}

impl Drop for Looper {
    fn drop(self: mut_view<Looper>) {
        died(self.alive);
    }
}

fn poll_looper(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Looper, i64>;
    group_poll_fn<Looper, i64>(tcb, cx)
}

// Parks without ever waking itself: only the cancellation wake can make the executor drop it.
struct Sleeper {
    pub alive: *mut Atomic<i64>,
}

unsafe impl Send for Sleeper {}

impl Future for Sleeper {
    type Output = i64;
    fn poll(self: mut_view<Sleeper>, cx: mut_view<Context>) -> Poll<i64> {
        Poll.Pending
    }
}

impl Drop for Sleeper {
    fn drop(self: mut_view<Sleeper>) {
        died(self.alive);
    }
}

fn poll_sleeper(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Sleeper, i64>;
    group_poll_fn<Sleeper, i64>(tcb, cx)
}

// Cooperative child: finishes with 5 as soon as the group's cancellation token fires.
struct Coop {
    pub fut: CancelledFuture,
    pub alive: *mut Atomic<i64>,
}

unsafe impl Send for Coop {}

impl Future for Coop {
    type Output = i64;
    fn poll(self: mut_view<Coop>, cx: mut_view<Context>) -> Poll<i64> {
        match self.fut.poll(mut_view(*cx)) {
            Poll.Ready(u) => Poll.Ready(5i64),
            Poll.Pending => Poll.Pending,
        }
    }
}

impl Drop for Coop {
    fn drop(self: mut_view<Coop>) {
        died(self.alive);
    }
}

fn poll_coop(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Coop, i64>;
    group_poll_fn<Coop, i64>(tcb, cx)
}

// The failing child: after two polls it reports a panic (contained, see std.asyn.group).
struct Failer {
    pub step: i32,
    pub alive: *mut Atomic<i64>,
}

unsafe impl Send for Failer {}

impl Future for Failer {
    type Output = i64;
    fn poll(self: mut_view<Failer>, cx: mut_view<Context>) -> Poll<i64> {
        let st = self.step;
        if st < 2i32 {
            self.step = st + 1i32;
            let mut w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        task_panic(mut_view(*cx));
        Poll.Pending
    }
}

impl Drop for Failer {
    fn drop(self: mut_view<Failer>) {
        died(self.alive);
    }
}

fn poll_failer(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Failer, i64>;
    group_poll_fn<Failer, i64>(tcb, cx)
}

// Fill `group` with the mixed set of children: 3 Loopers, 1 Failer, 2 Coops, 1 Sleeper (7 in all).
fn populate(group: mut_view<TaskGroup>, exec: view<Executor>, alive: *mut Atomic<i64>) {
    let tok = view(*group).cancellation_token();
    let mut k: i32 = 0i32;
    while k < 3i32 {
        born(alive);
        let h: TaskHandle<i64> = exec.spawn(Looper { alive: alive }, poll_looper);
        let r = mut_view(*group).adopt(h);
        check(match r { Result.Ok(id) => true, Result.Err(e) => false });
        k = k + 1i32;
    }
    born(alive);
    let hf: TaskHandle<i64> = exec.spawn(Failer { step: 0i32, alive: alive }, poll_failer);
    let rf = mut_view(*group).adopt(hf);
    check(match rf { Result.Ok(id) => true, Result.Err(e) => false });
    let mut c: i32 = 0i32;
    while c < 2i32 {
        born(alive);
        let hc: TaskHandle<i64> = exec.spawn(Coop { fut: tok.cancelled(), alive: alive }, poll_coop);
        let rc = mut_view(*group).adopt(hc);
        check(match rc { Result.Ok(id) => true, Result.Err(e) => false });
        c = c + 1i32;
    }
    born(alive);
    let hs: TaskHandle<i64> = exec.spawn(Sleeper { alive: alive }, poll_sleeper);
    let rs = mut_view(*group).adopt(hs);
    check(match rs { Result.Ok(id) => true, Result.Err(e) => false });
}

pub fn main() -> i32 {
    let exec = Executor.new(4);
    let alive = new_counter();

    // A. join_all: the panic cancels every sibling, all siblings are awaited and dropped, and the
    // deterministic failure is Panicked.
    {
        let mut group = TaskGroup.new();
        populate(mut_view(group), view(exec), alive);
        check(group.live_count() == 7usize);
        let joined: Result<GroupResults<i64>, TaskError> = group.join_all();
        let ok = match joined {
            Result.Ok(r) => false,
            Result.Err(e) => match e {
                TaskError.Panicked => true,
                TaskError.Cancelled => false,
            },
        };
        check(ok);
    }
    check(unsafe { (*alive).load(Ordering.Acquire) } == 0i64);

    // B. Collect the results one by one: exactly one child panicked, the other six either completed
    // cooperatively (token) or were cancelled; the failure is recorded and the token is cancelled.
    let mut reaped: i64 = 0i64;
    let mut panicked: i64 = 0i64;
    let mut other: i64 = 0i64;
    {
        let mut g2 = TaskGroup.new();
        populate(mut_view(g2), view(exec), alive);
        loop {
            let r: Option<TaskResult<i64>> = g2.next_blocking();
            match r {
                Option.Some(res) => {
                    reaped = reaped + 1i64;
                    match res {
                        TaskResult.Panicked => { panicked = panicked + 1i64; },
                        TaskResult.Completed(v) => {
                            check(v == 5i64);
                            other = other + 1i64;
                        },
                        TaskResult.Cancelled => { other = other + 1i64; },
                    }
                },
                Option.None => { break; },
            }
        }
        check(g2.is_failed());
        check(g2.is_cancelled());
        check(g2.live_count() == 0usize);
    }
    check(reaped == 7i64);
    check(panicked == 1i64);
    check(other == 6i64);
    let a = unsafe { (*alive).load(Ordering.Acquire) };
    check(a == 0i64);

    exec.shutdown();

    print("OK group_sibling_cancel panicked ");
    print_int(reaped);
    print(" ");
    print_int(a);
    print("\n");
    0
}
