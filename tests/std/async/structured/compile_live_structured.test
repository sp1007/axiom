# Compile the live std/async modules of T422 (cancel, timeout, governor, group) with the module root (T422).
timeout: 60
cmd: "{compiler}" check --std-root "{root}/std" "{root}/std/sync/atomic.ax" "{root}/std/async/waker.ax" "{root}/std/async/task.ax" "{root}/std/async/executor.ax" "{root}/std/async/cancel.ax" "{root}/std/async/timeout.ax" "{root}/std/async/governor.ax" "{root}/std/async/group.ax" "{root}/std/async/mod.ax"
exit: 0
