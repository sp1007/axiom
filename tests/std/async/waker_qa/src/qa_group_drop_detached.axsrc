module main

// T421a QA (adversarial): detached tasks and group-owned children torn down while they run.
//
// Each round spawns 8 `Producer` children with `group_poll_fn`: even children are adopted by a
// `TaskGroup`, odd ones are detached right away; every third child reports a panic (`task_panic`)
// in the poll that produces its output, so `group_poll_fn` must discard (drop) that output. The
// group is dropped immediately (cancel + drain), racing the children's completion. Expected: every
// future dropped exactly once (futures 0 = born - dropped) and every produced output dropped exactly
// once (outputs 0 = produced - dropped), whether it was collected by nobody, discarded on panic, or
// left in a detached task's control block.

use std.core.result.Result
use std.core.prelude.Context
use std.core.host.heap_alloc
use std.core.host.thread_yield
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.asyn.executor.Executor
use std.asyn.task.TaskControlBlock
use std.asyn.task.TaskHandle
use std.asyn.group.TaskGroup
use std.asyn.group.group_poll_fn
use std.asyn.group.task_panic

const ROUNDS: i64 = 40i64
const CHILDREN: i64 = 8i64

@repr(C)
struct Counters {
    pub born: Atomic<i64>,
    pub fut_dropped: Atomic<i64>,
    pub produced: Atomic<i64>,
    pub out_dropped: Atomic<i64>,
}

struct Out {
    pub c: *mut Counters,
}

unsafe impl Send for Out {}
unsafe impl Share for Out {}

impl Drop for Out {
    fn drop(self: mut_view<Out>) {
        unsafe {
            (*self.c).out_dropped.fetch_add(1i64, Ordering.AcqRel);
        }
    }
}

struct Producer {
    pub c: *mut Counters,
    pub steps: i64,
    pub panics: bool,
}

unsafe impl Send for Producer {}
unsafe impl Share for Producer {}

impl Future for Producer {
    type Output = Out;
    fn poll(self: mut_view<Producer>, cx: mut_view<Context>) -> Poll<Out> {
        if self.steps > 0i64 {
            self.steps = self.steps - 1i64;
            let mut w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        unsafe {
            (*self.c).produced.fetch_add(1i64, Ordering.AcqRel);
        }
        if self.panics {
            task_panic(mut_view(*cx));
        }
        Poll.Ready(Out { c: self.c })
    }
}

impl Drop for Producer {
    fn drop(self: mut_view<Producer>) {
        unsafe {
            (*self.c).fut_dropped.fetch_add(1i64, Ordering.AcqRel);
        }
    }
}

fn poll_producer(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Producer, Out>;
    group_poll_fn<Producer, Out>(tcb, cx)
}

pub fn main() -> i32 {
    let exec = Executor.new(2);
    let c = unsafe { heap_alloc(32usize, 8usize) as *mut Counters };
    unsafe {
        (*c).born = Atomic.new(0i64);
        (*c).fut_dropped = Atomic.new(0i64);
        (*c).produced = Atomic.new(0i64);
        (*c).out_dropped = Atomic.new(0i64);
    }

    let mut r: i64 = 0i64;
    while r < ROUNDS {
        {
            let mut g = TaskGroup.new();
            let mut k: i64 = 0i64;
            while k < CHILDREN {
                let n = r * CHILDREN + k;
                unsafe {
                    (*c).born.fetch_add(1i64, Ordering.AcqRel);
                }
                let h: TaskHandle<Out> = exec.spawn(Producer { c: c, steps: n % 4i64, panics: (n % 3i64) == 0i64 }, poll_producer);
                if (k % 2i64) == 0i64 {
                    let adopted = g.adopt(h);
                    check(match adopted { Result.Ok(_) => true, Result.Err(_) => false });
                } else {
                    h.detach();
                }
                k = k + 1i64;
            }
            let mut pause: i64 = 0i64;
            while pause < (r % 5i64) {
                thread_yield();
                pause = pause + 1i64;
            }
        }
        r = r + 1i64;
    }
    exec.shutdown();

    let born = unsafe { (*c).born.load(Ordering.Acquire) };
    let fut_dropped = unsafe { (*c).fut_dropped.load(Ordering.Acquire) };
    let produced = unsafe { (*c).produced.load(Ordering.Acquire) };
    let out_dropped = unsafe { (*c).out_dropped.load(Ordering.Acquire) };
    check(born == ROUNDS * CHILDREN);

    print("OK qa_group_drop_detached ");
    print_int(ROUNDS);
    print(" futures ");
    print_int(born - fut_dropped);
    print(" outputs ");
    print_int(produced - out_dropped);
    print("\n");
    0
}
