// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-154
// stdout: OK timer_import_without_executor 127.0.0.1:8080 1\n

// Regression: std.asyn.timer and std.asyn.timeout call the inherent method `Context.waker()` that is
// defined in std.asyn.waker. A program that reaches them only through std.net / std.io.async_io (no
// executor import anywhere in the user module) used to fail inside std with AX_TYPE_UNKNOWN_FIELD
// because those two std modules never imported the waker module themselves.

module test.timer_import_without_executor

use std.net.AsyncTcpStream
use std.net.SocketAddr

pub fn main() -> i32 {
    let addr = SocketAddr.localhost(8080u16);
    let o = addr.ip.octets;
    print("OK timer_import_without_executor ");
    print_int(o[0] as i64);
    print(".");
    print_int(o[1] as i64);
    print(".");
    print_int(o[2] as i64);
    print(".");
    print_int(o[3] as i64);
    print(":");
    print_int(addr.port as i64);
    print(" ");
    print_int(1i64);
    print("\n");
    0i32
}
