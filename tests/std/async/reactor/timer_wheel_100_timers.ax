// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-154
// stdout: OK timer_wheel_100_timers 120 1 1 0\n

module test.timer_wheel_100_timers

use std.core.prelude.Future
use std.core.prelude.Poll
use std.core.prelude.Context
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.monotonic_ns
use std.core.host.thread_current_id
use std.asyn.executor.LocalExecutor
use std.asyn.timeout.Deadline
use std.asyn.timer.SleepFuture
use std.asyn.timer.sleep_until
use std.asyn.timer.sleep_ns

pub struct OrderLog {
    pub order: *mut u64,
    pub count: usize,
    pub expected_tid: u64,
    pub same_thread_all: bool,
}

pub struct TimedTask {
    pub rank: u64,
    pub sleep_fut: SleepFuture,
    pub log: *mut OrderLog,
}

impl Future for TimedTask {
    type Output = u64;

    fn poll(self: mut_view<TimedTask>, cx: mut_view<Context>) -> Poll<u64> {
        match mut_view(self.sleep_fut).poll(mut_view(*cx)) {
            Poll.Pending => Poll.Pending,
            Poll.Ready(_) => {
                let tid = unsafe { thread_current_id() };
                unsafe {
                    if tid != (*self.log).expected_tid {
                        (*self.log).same_thread_all = false;
                    }
                    let idx = (*self.log).count;
                    *((*self.log).order + idx) = self.rank;
                    (*self.log).count = idx + 1;
                }
                Poll.Ready(self.rank)
            },
        }
    }
}

pub struct Outcome {
    pub setup_ok: bool,
    pub completed: usize,
    pub ordered_ok: bool,
    pub same_thread: bool,
    pub remaining_timers: usize,
}

// One run of the scenario. The ordering property only holds when every task has registered its timer
// before the earliest deadline fires, so the setup is verified explicitly instead of being assumed from a
// wall-clock margin: the executor is driven by hand until its ready queue is empty (every task has been
// polled once and parked on the wheel), then `setup_ok` records that all `total` timers are registered
// and none has completed. A run whose setup was disturbed (a stalled machine) is still run to completion
// and reported with `setup_ok = false` so the caller can repeat it with a longer lead time.
fn run_scenario(lead_ns: u64) -> Outcome {
    let mut exec = LocalExecutor.new();
    let main_tid = unsafe { thread_current_id() };
    let total: usize = 120;

    let order_buf = unsafe { heap_alloc(total * 8usize, 8usize) as *mut u64 };
    let log = unsafe { heap_alloc(32usize, 8usize) as *mut OrderLog };
    unsafe {
        (*log).order = order_buf;
        (*log).count = 0;
        (*log).expected_tid = main_tid;
        (*log).same_thread_all = true;
    }

    // Spawn 120 concurrent timers with distinct deadlines 100us apart (reverse-shuffled: the spawn order is
    // permuted with the coprime step 37 mod 120, so insertion order differs from deadline order).
    let base_ns = monotonic_ns() + lead_ns;
    let mut i: usize = 0;
    while i < total {
        let rank: usize = (i * 37) % total;
        let dl = Deadline.at_ns(base_ns + ((rank as u64) + 1u64) * 100_000u64);
        let task = TimedTask {
            rank: rank as u64,
            sleep_fut: sleep_until(dl),
            log: log,
        };
        let h = mut_view(exec).spawn_local(task);
        h.detach();
        i = i + 1;
    }

    // Registration sweep: poll every task once (each registers on the wheel and returns Pending) until the
    // ready queue is empty. No timer can complete before this ends unless the machine stalled for `lead_ns`.
    while mut_view(exec).try_tick() {
    }
    let registered = unsafe { view((*exec.reactor).timers).active_count() };
    let completed_early = unsafe { (*log).count };
    let setup_ok = registered == total && completed_early == 0;

    // Also verify early Drop cancellation of a long-lived SleepFuture leaves 0 dangling timers
    {
        let mut cancel_fut = sleep_ns(60_000_000_000u64); // 60 seconds
        let _ = mut_view(exec).try_tick();
        // Manually register & drop by leaving scope
        let _ = cancel_fut;
    }

    mut_view(exec).run();

    let completed = unsafe { (*log).count };
    let same_thread = unsafe { (*log).same_thread_all };
    let remaining_timers = unsafe { view((*exec.reactor).timers).active_count() };

    // Verify all 120 timers fired in strictly increasing rank order (0..119)
    let mut ordered_ok = completed == total;
    let mut k: usize = 0;
    while k < completed {
        let got = unsafe { *(order_buf + k) };
        if got != (k as u64) {
            ordered_ok = false;
        }
        k = k + 1;
    }

    unsafe {
        heap_free(order_buf as *mut u8, total * 8usize, 8usize);
        heap_free(log as *mut u8, 32usize, 8usize);
    }
    mut_view(exec).shutdown();

    Outcome {
        setup_ok: setup_ok,
        completed: completed,
        ordered_ok: ordered_ok,
        same_thread: same_thread,
        remaining_timers: remaining_timers,
    }
}

pub fn main() -> i32 {
    // Lead time 1s, doubled after every disturbed setup (up to 1+2+4+8+16 s).
    let mut lead_ns: u64 = 1_000_000_000u64;
    let mut attempt: usize = 0;
    let mut out = run_scenario(lead_ns);
    while !out.setup_ok && attempt < 4 {
        lead_ns = lead_ns * 2u64;
        attempt = attempt + 1;
        out = run_scenario(lead_ns);
    }
    if !out.setup_ok {
        print("FAIL timer_wheel_100_timers setup never completed before the first deadline\n");
        return 1i32;
    }

    print("OK timer_wheel_100_timers ");
    print_int(out.completed as i64);
    print(" ");
    print_int(if out.ordered_ok { 1i64 } else { 0i64 });
    print(" ");
    print_int(if out.same_thread { 1i64 } else { 0i64 });
    print(" ");
    print_int(out.remaining_timers as i64);
    print("\n");
    0i32
}
