// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-159
// stdout: OK interval_missed_ticks 1 1 1 1\n

module test.interval_missed_ticks

use std.core.host.monotonic_ns
use std.asyn.executor.LocalExecutor
use std.asyn.timer.Interval
use std.asyn.timer.IntervalMode
use std.asyn.timer.MissedTickBehavior
use std.asyn.timer.sleep_ns

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let period: u64 = 2_000_000u64; // 2ms

    // 1. MissedTickBehavior.Burst: after sleeping 3.5 periods, next 3 ticks fire immediately (0 wait)
    let mut iv_burst = Interval.every_ns(period).with_missed_tick_behavior(MissedTickBehavior.Burst);
    mut_view(exec).block_on(sleep_ns(period * 3u64 + 1_000_000u64));
    let t_before_burst = monotonic_ns();
    let b1 = mut_view(iv_burst).tick();
    let b2 = mut_view(iv_burst).tick();
    let b3 = mut_view(iv_burst).tick();
    let burst_ok = b1.deadline.is_expired_at(t_before_burst) &&
                   b2.deadline.is_expired_at(t_before_burst) &&
                   b3.deadline.is_expired_at(t_before_burst) &&
                   b1.deadline.deadline_ns < b2.deadline.deadline_ns &&
                   b2.deadline.deadline_ns < b3.deadline.deadline_ns;
    mut_view(exec).block_on(b1);
    mut_view(exec).block_on(b2);
    mut_view(exec).block_on(b3);

    // 2. MissedTickBehavior.Skip: skips missed ticks and aligns to next future phase multiple (> now)
    let mut iv_skip = Interval.every_ns(period).with_missed_tick_behavior(MissedTickBehavior.Skip);
    let skip_origin = view(iv_skip).next_tick_ns();
    mut_view(exec).block_on(sleep_ns(period * 3u64 + 500_000u64));
    let now_skip = monotonic_ns();
    let s1 = mut_view(iv_skip).tick();
    let skip_dl = s1.deadline.deadline_ns;
    // Must be strictly in the future and phase-aligned with (skip_origin + k * period)
    let skip_ok = skip_dl > now_skip && ((skip_dl - skip_origin) % period) == 0u64;
    mut_view(exec).block_on(s1);

    // 3. MissedTickBehavior.Delay: shifts phase origin to `now`, scheduling at `now + period`
    let mut iv_delay = Interval.every_ns(period).with_missed_tick_behavior(MissedTickBehavior.Delay);
    mut_view(exec).block_on(sleep_ns(period * 3u64 + 500_000u64));
    let now_delay = monotonic_ns();
    let d1 = mut_view(iv_delay).tick();
    let delay_dl = d1.deadline.deadline_ns;
    let delay_ok = delay_dl >= now_delay + period;
    mut_view(exec).block_on(d1);

    // 4. IntervalMode.FixedDelay: always waits a full period from when tick() is called
    let mut iv_fdelay = Interval.every_ns(period).with_mode(IntervalMode.FixedDelay);
    let now_fd = monotonic_ns();
    let fd1 = mut_view(iv_fdelay).tick();
    let fd_mode_ok = match view(iv_fdelay).mode() {
        IntervalMode.FixedDelay => true,
        IntervalMode.FixedRate => false,
    };
    let fd_ok = fd1.deadline.deadline_ns >= now_fd + period && fd_mode_ok;
    mut_view(exec).block_on(fd1);

    mut_view(exec).shutdown();

    print("OK interval_missed_ticks ");
    print_int(if burst_ok { 1i64 } else { 0i64 });
    print(" ");
    print_int(if skip_ok { 1i64 } else { 0i64 });
    print(" ");
    print_int(if delay_ok { 1i64 } else { 0i64 });
    print(" ");
    print_int(if fd_ok { 1i64 } else { 0i64 });
    print("\n");
    0i32
}
