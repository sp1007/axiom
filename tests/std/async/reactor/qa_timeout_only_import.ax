// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-154
// stdout: OK qa_timeout_only_import 1 0 5 0 1 40 1 0 1\n

// QA (T449a): a program that imports only std.asyn.timeout (no timer, executor, reactor or net). Before the
// fix the module did not compile on its own: `Timeout.poll` calls the inherent method `Context.waker()` of
// std.asyn.waker without importing it. Pure `Deadline` arithmetic with explicit instants (`*_at`), so the
// output does not depend on the wall clock.

module test.qa_timeout_only_import

use std.asyn.timeout.Deadline
use std.asyn.timeout.TimeoutError

fn b(v: bool) -> i64 {
    if v { 1i64 } else { 0i64 }
}

pub fn main() -> i32 {
    let d = Deadline.at_ns(100u64);
    let expired_before = d.is_expired_at(99u64);
    let remaining_at_95 = d.remaining_ns_at(95u64);
    let remaining_after = d.remaining_ns_at(500u64);
    let expired_at = d.is_expired_at(100u64);
    let m = d.min(Deadline.at_ns(60u64));
    let mx = d.max(Deadline.at_ns(140u64));
    let never_expired = Deadline.never().is_expired_at(0xFFFFFFFFFFFFFFFEu64);
    let e = TimeoutError { deadline_ns: 7u64 };
    print("OK qa_timeout_only_import ");
    print_int(b(!expired_before));
    print(" ");
    print_int(b(expired_before));
    print(" ");
    print_int(remaining_at_95 as i64);
    print(" ");
    print_int(remaining_after as i64);
    print(" ");
    print_int(b(expired_at));
    print(" ");
    print_int((m.deadline_ns - 20u64) as i64);
    print(" ");
    print_int(b(mx.deadline_ns == 140u64));
    print(" ");
    print_int(b(never_expired));
    print(" ");
    print_int(b(e.deadline_ns == 7u64));
    print("\n");
    0i32
}
