// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-154
// stdout: OK qa_timer_only_import 5 10 2 30 3 1 0\n

// QA (T449a): a program that reaches std.asyn.timer without any executor, reactor or net module (the
// `Context.waker()` import fix) and drives the wheel with a virtual clock only: no wall-clock lookups, so
// the result is the same on every run and every machine. Deadlines are registered out of order; the wheel
// must fire them by deadline (10, 20 first, then 30, 50; 40 is cancelled) and report `next_deadline_ns`.

module test.qa_timer_only_import

use std.core.option.Option
use std.core.prelude.RawWakerVTable
use std.asyn.timer.TimerWheel

fn reg(tw: mut_view<TimerWheel>, dl: u64) -> u64 {
    tw.register_raw(dl, 0 as *const u8, 0 as *const RawWakerVTable)
}

pub fn main() -> i32 {
    let mut tw = TimerWheel.new();
    let _a = reg(mut_view(tw), 50u64);
    let _b = reg(mut_view(tw), 10u64);
    let _c = reg(mut_view(tw), 30u64);
    let _d = reg(mut_view(tw), 20u64);
    let e = reg(mut_view(tw), 40u64);
    let registered = view(tw).active_count();
    let first = match mut_view(tw).next_deadline_ns() {
        Option.Some(d) => d,
        Option.None => 0u64,
    };
    // Nothing is due before 10.
    let none_due = mut_view(tw).advance_to(9u64);
    // 10 and 20 are due at 25, not 30.
    let fired_25 = mut_view(tw).advance_to(25u64);
    let next_after = match mut_view(tw).next_deadline_ns() {
        Option.Some(d) => d,
        Option.None => 0u64,
    };
    // Cancel 40, then the rest fires at 1000: 30 and 50 only.
    mut_view(tw).cancel(e);
    let fired_rest = mut_view(tw).advance_to(1000u64);
    let drained = if view(tw).is_empty() { 1i64 } else { 0i64 };
    print("OK qa_timer_only_import ");
    print_int(registered as i64);
    print(" ");
    print_int(first as i64);
    print(" ");
    print_int(fired_25 as i64);
    print(" ");
    print_int(next_after as i64);
    print(" ");
    print_int((fired_rest + 1usize) as i64);
    print(" ");
    print_int(drained);
    print(" ");
    print_int(none_due as i64);
    print("\n");
    0i32
}
