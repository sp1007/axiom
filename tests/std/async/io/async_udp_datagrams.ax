// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-152, REQ-ASY-157
// stdout: OK async_udp_datagrams 5 9 4 1\n

module test.async_udp_datagrams

use std.core.result.Result
use std.asyn.executor.LocalExecutor
use std.net.SocketAddr
use std.net.AsyncUdpSocket

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let r = view(exec).reactor();

    let sock_a = match AsyncUdpSocket.bind(r, SocketAddr.localhost(0u16)) {
        Result.Ok(s) => s,
        Result.Err(_) => return 1i32,
    };
    let sock_b = match AsyncUdpSocket.bind(r, SocketAddr.localhost(0u16)) {
        Result.Ok(s) => s,
        Result.Err(_) => return 2i32,
    };

    let addr_a = view(sock_a).local_addr();
    let addr_b = view(sock_b).local_addr();

    // Send two discrete datagrams from A -> B ("ALPHA", "BETA-1234")
    let d1: [5]u8 = [65u8, 76u8, 80u8, 72u8, 65u8];
    let d2: [9]u8 = [66u8, 69u8, 84u8, 65u8, 45u8, 49u8, 50u8, 51u8, 52u8];
    let reply: [4]u8 = [69u8, 67u8, 72u8, 79u8]; // "ECHO"

    let mut rbuf1: [32]u8 = [0u8; 32];
    let mut rbuf2: [32]u8 = [0u8; 32];

    // Submit recv_from on B, send d1 from A -> B
    let rf1 = view(sock_b).recv_from(unsafe { address_of_mut(rbuf1[0]) }, 32usize);
    let sf1 = view(sock_a).send_to(unsafe { address_of(d1[0]) }, 5usize, addr_b);
    let _ = match mut_view(exec).block_on(sf1) {
        Result.Ok(n) => n,
        Result.Err(_) => return 3i32,
    };
    let (n1, from1) = match mut_view(exec).block_on(rf1) {
        Result.Ok(pair) => pair,
        Result.Err(_) => return 4i32,
    };

    // Submit recv_from on B, send d2 from A -> B (verifies discrete datagram boundaries)
    let rf2 = view(sock_b).recv_from(unsafe { address_of_mut(rbuf2[0]) }, 32usize);
    let sf2 = view(sock_a).send_to(unsafe { address_of(d2[0]) }, 9usize, addr_b);
    let _ = match mut_view(exec).block_on(sf2) {
        Result.Ok(n) => n,
        Result.Err(_) => return 5i32,
    };
    let (n2, from2) = match mut_view(exec).block_on(rf2) {
        Result.Ok(pair) => pair,
        Result.Err(_) => return 6i32,
    };

    // Echo reply from B -> from1 (A's address)
    let mut abuf: [16]u8 = [0u8; 16];
    let rfa = view(sock_a).recv_from(unsafe { address_of_mut(abuf[0]) }, 16usize);
    let sfb = view(sock_b).send_to(unsafe { address_of(reply[0]) }, 4usize, from1);
    let _ = match mut_view(exec).block_on(sfb) {
        Result.Ok(n) => n,
        Result.Err(_) => return 7i32,
    };
    let (n3, from3) = match mut_view(exec).block_on(rfa) {
        Result.Ok(pair) => pair,
        Result.Err(_) => return 8i32,
    };

    let mut ok = true;
    if n1 != 5usize || n2 != 9usize || n3 != 4usize {
        ok = false;
    }
    if from1.port != addr_a.port || from2.port != addr_a.port || from3.port != addr_b.port {
        ok = false;
    }
    let mut i: usize = 0;
    while i < 5usize {
        if rbuf1[i] != d1[i] { ok = false; }
        i = i + 1;
    }
    i = 0;
    while i < 9usize {
        if rbuf2[i] != d2[i] { ok = false; }
        i = i + 1;
    }
    i = 0;
    while i < 4usize {
        if abuf[i] != reply[i] { ok = false; }
        i = i + 1;
    }

    let _ = sock_a.close();
    let _ = sock_b.close();
    mut_view(exec).shutdown();

    let ok_flag: i64 = if ok { 1i64 } else { 0i64 };
    print("OK async_udp_datagrams ");
    print_int(n1 as i64);
    print(" ");
    print_int(n2 as i64);
    print(" ");
    print_int(n3 as i64);
    print(" ");
    print_int(ok_flag);
    print("\n");
    0i32
}
