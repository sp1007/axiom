// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-152, REQ-ASY-157
// stdout: OK async_tcp_loopback 1 4 4 PONG\n

module test.async_tcp_loopback

use std.core.result.Result
use std.core.option.Option
use std.asyn.executor.LocalExecutor
use std.io.async_io.IoBuf
use std.net.SocketAddr
use std.net.ShutdownMode
use std.net.AsyncTcpListener
use std.net.AsyncTcpStream

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let r = view(exec).reactor();

    let listener = match AsyncTcpListener.bind(r, SocketAddr.localhost(0u16)) {
        Result.Ok(l) => l,
        Result.Err(_) => {
            print("ERR bind\n");
            return 1i32;
        },
    };
    let bind_addr = view(listener).local_addr();
    let port_ok: i64 = if bind_addr.port > 0u16 { 1i64 } else { 0i64 };

    // Submit accept before connect so both oracle and native IOCP pair deterministically
    let accept_fut = view(listener).accept();
    let connect_fut = AsyncTcpStream.connect(r, bind_addr);

    let mut client = match mut_view(exec).block_on(connect_fut) {
        Result.Ok(s) => s,
        Result.Err(_) => {
            print("ERR connect\n");
            return 2i32;
        },
    };

    let mut server = match mut_view(exec).block_on(accept_fut) {
        Result.Ok(pair) => pair.0,
        Result.Err(_) => {
            print("ERR accept\n");
            return 3i32;
        },
    };

    // Client sends "PING" using IoBuf hand-off
    let ping: [4]u8 = [80u8, 73u8, 78u8, 71u8];
    let pong: [4]u8 = [80u8, 79u8, 78u8, 71u8];

    let req_out = mut_view(exec).block_on(mut_view(client).write_buf(IoBuf.from_slice(view(ping))));
    let req_n = match req_out.res {
        Result.Ok(n) => n,
        Result.Err(_) => return 4i32,
    };

    // Server reads "PING" using read_exact
    let mut srv_buf: [4]u8 = [0u8; 4];
    match mut_view(exec).block_on(mut_view(server).read_exact(unsafe { address_of_mut(srv_buf[0]) }, 4usize)) {
        Result.Ok(_) => {},
        Result.Err(_) => return 5i32,
    }
    if srv_buf[0] != 80u8 || srv_buf[1] != 73u8 || srv_buf[2] != 78u8 || srv_buf[3] != 71u8 {
        print("ERR req_mismatch\n");
        return 6i32;
    }

    // Server replies "PONG" using write_all, then half-closes write side
    match mut_view(exec).block_on(mut_view(server).write_all(unsafe { address_of(pong[0]) }, 4usize)) {
        Result.Ok(_) => {},
        Result.Err(_) => return 7i32,
    }
    let _ = view(server).shutdown(ShutdownMode.Write);

    // Client reads "PONG" using IoBuf hand-off
    let resp_out = mut_view(exec).block_on(mut_view(client).read_buf(IoBuf.with_capacity(16usize)));
    let resp_n = match resp_out.res {
        Result.Ok(n) => n,
        Result.Err(_) => return 8i32,
    };
    let mut ok = resp_n == 4usize && view(resp_out.buf).len() == 4usize;
    let mut i: usize = 0;
    while i < 4usize {
        match view(resp_out.buf).get(i) {
            Option.Some(b) => {
                if b != pong[i] { ok = false; }
            },
            Option.None => { ok = false; },
        }
        i = i + 1;
    }

    let _ = client.close();
    let _ = server.close();
    let _ = listener.close();
    mut_view(exec).shutdown();

    if !ok {
        print("ERR resp_mismatch\n");
        return 9i32;
    }

    print("OK async_tcp_loopback ");
    print_int(port_ok);
    print(" ");
    print_int(req_n as i64);
    print(" ");
    print_int(resp_n as i64);
    print(" PONG\n");
    0i32
}
