// test: run
// modes: interp native
// timeout: 300
// covers: REQ-SIMD-189, REQ-SIMD-142, REQ-SIMD-143
// flags: --step-limit 4000000000
// stdout: ok math methods\n


// T461: the inherent methods that std.math adds to f64 and f32 (x.sin(), y.atan2(x), x.powi(n), ...) return exactly the bits
// of the corresponding free functions.

module test.math_methods

use std.math

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

fn same64(a: f64, b: f64) -> bool {
    a.to_bits() == b.to_bits()
}

fn same32(a: f32, b: f32) -> bool {
    a.to_bits() == b.to_bits()
}

fn t_f64() -> i32 {
    let mut f: i32 = 0;
    let x1: f64 = 0.75;
    f = f + chk(same64(x1.exp(), std.math.exp(x1)), 1);
    let x2: f64 = 0.75;
    f = f + chk(same64(x2.exp2(), std.math.exp2(x2)), 2);
    let x3: f64 = 0.75;
    f = f + chk(same64(x3.expm1(), std.math.expm1(x3)), 3);
    let x4: f64 = 2.5;
    f = f + chk(same64(x4.ln(), std.math.ln(x4)), 4);
    let x5: f64 = 2.5;
    f = f + chk(same64(x5.log2(), std.math.log2(x5)), 5);
    let x6: f64 = 2.5;
    f = f + chk(same64(x6.log10(), std.math.log10(x6)), 6);
    let x7: f64 = 0.75;
    f = f + chk(same64(x7.ln_1p(), std.math.ln_1p(x7)), 7);
    let x8: f64 = 0.75;
    f = f + chk(same64(x8.sin(), std.math.sin(x8)), 8);
    let x9: f64 = 0.75;
    f = f + chk(same64(x9.cos(), std.math.cos(x9)), 9);
    let x10: f64 = 0.75;
    f = f + chk(same64(x10.tan(), std.math.tan(x10)), 10);
    let x11: f64 = 0.75;
    f = f + chk(same64(x11.atan(), std.math.atan(x11)), 11);
    let x12: f64 = 0.3;
    f = f + chk(same64(x12.asin(), std.math.asin(x12)), 12);
    let x13: f64 = 0.3;
    f = f + chk(same64(x13.acos(), std.math.acos(x13)), 13);
    let x14: f64 = 0.75;
    f = f + chk(same64(x14.sinh(), std.math.sinh(x14)), 14);
    let x15: f64 = 0.75;
    f = f + chk(same64(x15.cosh(), std.math.cosh(x15)), 15);
    let x16: f64 = 0.75;
    f = f + chk(same64(x16.tanh(), std.math.tanh(x16)), 16);
    let x17: f64 = 0.75;
    f = f + chk(same64(x17.asinh(), std.math.asinh(x17)), 17);
    let x18: f64 = 2.5;
    f = f + chk(same64(x18.acosh(), std.math.acosh(x18)), 18);
    let x19: f64 = 0.3;
    f = f + chk(same64(x19.atanh(), std.math.atanh(x19)), 19);
    let x20: f64 = 0.75;
    f = f + chk(same64(x20.cbrt(), std.math.cbrt(x20)), 20);
    let x21: f64 = 0.75;
    f = f + chk(same64(x21.erf(), std.math.erf(x21)), 21);
    let x22: f64 = 0.75;
    f = f + chk(same64(x22.erfc(), std.math.erfc(x22)), 22);
    let x23: f64 = 0.75;
    f = f + chk(same64(x23.signum(), std.math.signum(x23)), 23);
    let a24: f64 = 7.5;
    let b24: f64 = 2.25;
    f = f + chk(same64(a24.hypot(b24), std.math.hypot(a24, b24)), 24);
    let a25: f64 = 7.5;
    let b25: f64 = 2.25;
    f = f + chk(same64(a25.log(b25), std.math.log(a25, b25)), 25);
    let a26: f64 = 7.5;
    let b26: f64 = 2.25;
    f = f + chk(same64(a26.powf(b26), std.math.powf(a26, b26)), 26);
    let a27: f64 = 7.5;
    let b27: f64 = 2.25;
    f = f + chk(same64(a27.div_euclid(b27), std.math.div_euclid(a27, b27)), 27);
    let a28: f64 = 7.5;
    let b28: f64 = 2.25;
    f = f + chk(same64(a28.rem_euclid(b28), std.math.rem_euclid(a28, b28)), 28);
    let p: f64 = 1.25;
    let q: f64 = -0.75;
    f = f + chk(same64(p.atan2(q), std.math.atan2(p, q)), 29);
    f = f + chk(same64(p.powi(-3), std.math.powi(p, -3)), 30);
    let sc = p.sincos();
    let sc2 = std.math.sincos(p);
    f = f + chk(same64(sc.0, sc2.0) && same64(sc.1, sc2.1), 31);
    let mf = q.modf();
    let mf2 = std.math.modf(q);
    f = f + chk(same64(mf.0, mf2.0) && same64(mf.1, mf2.1), 32);
    let fr = p.frexp();
    let fr2 = std.math.frexp(p);
    f = f + chk(same64(fr.0, fr2.0) && fr.1 == fr2.1, 33);
    f = f + chk(same64(p.ldexp(5), std.math.ldexp(p, 5)), 34);
    f = f + chk(same64(p.scalbn(-3), std.math.scalbn(p, -3)), 35);
    f = f + chk(same64(p.lerp(q, 0.5), std.math.lerp(p, q, 0.5)), 36);
    f
}

fn t_f32() -> i32 {
    let mut f: i32 = 0;
    let x100: f32 = 0.75;
    f = f + chk(same32(x100.exp(), std.math.exp_f32(x100)), 100);
    let x101: f32 = 0.75;
    f = f + chk(same32(x101.exp2(), std.math.exp2_f32(x101)), 101);
    let x102: f32 = 0.75;
    f = f + chk(same32(x102.expm1(), std.math.expm1_f32(x102)), 102);
    let x103: f32 = 2.5;
    f = f + chk(same32(x103.ln(), std.math.ln_f32(x103)), 103);
    let x104: f32 = 2.5;
    f = f + chk(same32(x104.log2(), std.math.log2_f32(x104)), 104);
    let x105: f32 = 2.5;
    f = f + chk(same32(x105.log10(), std.math.log10_f32(x105)), 105);
    let x106: f32 = 0.75;
    f = f + chk(same32(x106.ln_1p(), std.math.ln_1p_f32(x106)), 106);
    let x107: f32 = 0.75;
    f = f + chk(same32(x107.sin(), std.math.sin_f32(x107)), 107);
    let x108: f32 = 0.75;
    f = f + chk(same32(x108.cos(), std.math.cos_f32(x108)), 108);
    let x109: f32 = 0.75;
    f = f + chk(same32(x109.tan(), std.math.tan_f32(x109)), 109);
    let x110: f32 = 0.75;
    f = f + chk(same32(x110.atan(), std.math.atan_f32(x110)), 110);
    let x111: f32 = 0.3;
    f = f + chk(same32(x111.asin(), std.math.asin_f32(x111)), 111);
    let x112: f32 = 0.3;
    f = f + chk(same32(x112.acos(), std.math.acos_f32(x112)), 112);
    let x113: f32 = 0.75;
    f = f + chk(same32(x113.sinh(), std.math.sinh_f32(x113)), 113);
    let x114: f32 = 0.75;
    f = f + chk(same32(x114.cosh(), std.math.cosh_f32(x114)), 114);
    let x115: f32 = 0.75;
    f = f + chk(same32(x115.tanh(), std.math.tanh_f32(x115)), 115);
    let x116: f32 = 0.75;
    f = f + chk(same32(x116.asinh(), std.math.asinh_f32(x116)), 116);
    let x117: f32 = 2.5;
    f = f + chk(same32(x117.acosh(), std.math.acosh_f32(x117)), 117);
    let x118: f32 = 0.3;
    f = f + chk(same32(x118.atanh(), std.math.atanh_f32(x118)), 118);
    let x119: f32 = 0.75;
    f = f + chk(same32(x119.cbrt(), std.math.cbrt_f32(x119)), 119);
    let x120: f32 = 0.75;
    f = f + chk(same32(x120.erf(), std.math.erf_f32(x120)), 120);
    let x121: f32 = 0.75;
    f = f + chk(same32(x121.erfc(), std.math.erfc_f32(x121)), 121);
    let x122: f32 = 0.75;
    f = f + chk(same32(x122.signum(), std.math.signum_f32(x122)), 122);
    let a123: f32 = 7.5;
    let b123: f32 = 2.25;
    f = f + chk(same32(a123.hypot(b123), std.math.hypot_f32(a123, b123)), 123);
    let a124: f32 = 7.5;
    let b124: f32 = 2.25;
    f = f + chk(same32(a124.log(b124), std.math.log_f32(a124, b124)), 124);
    let a125: f32 = 7.5;
    let b125: f32 = 2.25;
    f = f + chk(same32(a125.powf(b125), std.math.powf_f32(a125, b125)), 125);
    let a126: f32 = 7.5;
    let b126: f32 = 2.25;
    f = f + chk(same32(a126.div_euclid(b126), std.math.div_euclid_f32(a126, b126)), 126);
    let a127: f32 = 7.5;
    let b127: f32 = 2.25;
    f = f + chk(same32(a127.rem_euclid(b127), std.math.rem_euclid_f32(a127, b127)), 127);
    let p: f32 = 1.25;
    let q: f32 = -0.75;
    f = f + chk(same32(p.atan2(q), std.math.atan2_f32(p, q)), 128);
    f = f + chk(same32(p.powi(-3), std.math.powi_f32(p, -3)), 129);
    let sc = p.sincos();
    let sc2 = std.math.sincos_f32(p);
    f = f + chk(same32(sc.0, sc2.0) && same32(sc.1, sc2.1), 130);
    let mf = q.modf();
    let mf2 = std.math.modf_f32(q);
    f = f + chk(same32(mf.0, mf2.0) && same32(mf.1, mf2.1), 131);
    let fr = p.frexp();
    let fr2 = std.math.frexp_f32(p);
    f = f + chk(same32(fr.0, fr2.0) && fr.1 == fr2.1, 132);
    f = f + chk(same32(p.ldexp(5), std.math.ldexp_f32(p, 5)), 133);
    f = f + chk(same32(p.scalbn(-3), std.math.scalbn_f32(p, -3)), 134);
    f = f + chk(same32(p.lerp(q, 0.5), std.math.lerp_f32(p, q, 0.5)), 135);
    f
}

fn main() -> i32 {
    let bad = t_f64() + t_f32();
    if bad == 0 {
        print("ok math methods\n");
        return 0;
    }
    1
}
