fn run_atanh() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 264 {
        let x = f64.from_bits(T_ATANH[2 * i]);
        let got = std.math.atanh(x).to_bits();
        if !near64(got, T_ATANH[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL atanh ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = run_sinh() + run_cosh() + run_tanh() + run_asinh() + run_acosh() + run_atanh();
    if bad == 0 {
        print("ok math stress_hyper_f64\n");
        return 0;
    }
    1
}
