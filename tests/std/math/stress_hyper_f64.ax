fn run_asinh() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 341 {
        let x = f64.from_bits(T_ASINH[2 * i]);
        let got = std.math.asinh(x).to_bits();
        if !near64(got, T_ASINH[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL asinh ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

