fn run_erf() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 344 {
        let x = f64.from_bits(T_ERF[2 * i]);
        let got = std.math.erf(x).to_bits();
        if !near64(got, T_ERF[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL erf ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

