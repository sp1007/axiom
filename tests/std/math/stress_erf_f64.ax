fn run_erfc() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 419 {
        let x = f64.from_bits(T_ERFC[2 * i]);
        let got = std.math.erfc(x).to_bits();
        if !near64(got, T_ERFC[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL erfc ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = run_erf() + run_erfc();
    if bad == 0 {
        print("ok math stress_erf_f64\n");
        return 0;
    }
    1
}
