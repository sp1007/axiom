        let got = std.math.sinh(x).to_bits();
        if !near64(got, T_SINH[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL sinh ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

