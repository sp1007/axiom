fn main() -> i32 {
    let bad = run_sinh() + run_cosh() + run_tanh() + run_asinh() + run_acosh() + run_atanh();
    if bad == 0 {
        print("ok math vec_hyper_f64\n");
        return 0;
    }
    1
}
