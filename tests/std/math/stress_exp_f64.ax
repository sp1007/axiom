fn run_expm1() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 342 {
        let x = f64.from_bits(T_EXPM1[2 * i]);
        let got = std.math.expm1(x).to_bits();
        if !near64(got, T_EXPM1[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL expm1 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = run_exp() + run_exp2() + run_expm1();
    if bad == 0 {
        print("ok math stress_exp_f64\n");
        return 0;
    }
    1
}
