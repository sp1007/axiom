fn run_exp2() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 306 {
        let x = f64.from_bits(T_EXP2[2 * i]);
        let got = std.math.exp2(x).to_bits();
        if !near64(got, T_EXP2[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL exp2 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

