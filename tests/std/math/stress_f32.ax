fn run_atan2() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 157 {
        let x = f32.from_bits(T_ATAN2[3 * i] as u32);
        let y = f32.from_bits(T_ATAN2[3 * i + 1] as u32);
        let got = std.math.atan2_f32(x, y).to_bits();
        if !near32(got, T_ATAN2[3 * i + 2] as u32) {
            bad = bad + 1;
            print("FAIL atan2_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

