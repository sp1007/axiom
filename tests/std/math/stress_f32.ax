fn run_expm1() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 230 {
        let x = f32.from_bits(T_EXPM1[2 * i] as u32);
        let got = std.math.expm1_f32(x).to_bits();
        if !near32(got, T_EXPM1[2 * i + 1] as u32) {
            bad = bad + 1;
            print("FAIL expm1_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

