fn run_powi() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 232 {
        let x = f32.from_bits(T_POWI[3 * i] as u32);
        let n = (T_POWI[3 * i + 1] as u32) as i32;
        let got = std.math.powi_f32(x, n).to_bits();
        if !near32(got, T_POWI[3 * i + 2] as u32) {
            bad = bad + 1;
            print("FAIL powi_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

