fn run_ln_1p() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 287 {
        let x = f32.from_bits(T_LN_1P[2 * i] as u32);
        let got = std.math.ln_1p_f32(x).to_bits();
        if !near32(got, T_LN_1P[2 * i + 1] as u32) {
            bad = bad + 1;
            print("FAIL ln_1p_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

