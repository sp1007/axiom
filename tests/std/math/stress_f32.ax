fn run_hypot() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 104 {
        let x = f32.from_bits(T_HYPOT[3 * i] as u32);
        let y = f32.from_bits(T_HYPOT[3 * i + 1] as u32);
        let got = std.math.hypot_f32(x, y).to_bits();
        if !near32(got, T_HYPOT[3 * i + 2] as u32) {
            bad = bad + 1;
            print("FAIL hypot_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

