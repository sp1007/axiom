fn run_erfc() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 282 {
        let x = f32.from_bits(T_ERFC[2 * i] as u32);
        let got = std.math.erfc_f32(x).to_bits();
        if !near32(got, T_ERFC[2 * i + 1] as u32) {
            bad = bad + 1;
            print("FAIL erfc_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = run_exp() + run_exp2() + run_expm1() + run_ln() + run_log2() + run_log10() + run_ln_1p() + run_log() + run_sin() + run_cos() + run_tan() + run_atan() + run_atan2() + run_asin() + run_acos() + run_sinh() + run_cosh() + run_tanh() + run_asinh() + run_acosh() + run_atanh() + run_powf() + run_powi() + run_cbrt() + run_hypot() + run_erf() + run_erfc();
    if bad == 0 {
        print("ok math stress_f32\n");
        return 0;
    }
    1
}
