fn run_asin() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 178 {
        let x = f32.from_bits(T_ASIN[2 * i] as u32);
        let got = std.math.asin_f32(x).to_bits();
        if !near32(got, T_ASIN[2 * i + 1] as u32) {
            bad = bad + 1;
            print("FAIL asin_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

