fn run_cbrt() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 124 {
        let x = f32.from_bits(T_CBRT[2 * i] as u32);
        let got = std.math.cbrt_f32(x).to_bits();
        if !near32(got, T_CBRT[2 * i + 1] as u32) {
            bad = bad + 1;
            print("FAIL cbrt_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

