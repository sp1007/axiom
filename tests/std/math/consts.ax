// test: run
// modes: interp native
// timeout: 120
// covers: REQ-SIMD-189, REQ-SIMD-142
// stdout: ok math consts\n

// T461: the mathematical constants of std.math and std.math.f32.consts have exactly the bit patterns of the table of
// SPEC-41 AXS-FLT-061 (the correctly rounded values), and std.math.f64.consts is the same set as std.math.

module test.math_consts

use std.math
use std.math.f32.consts

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

fn t_f64() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(std.math.PI.to_bits() == 0x4009_21FB_5444_2D18u64, 1);
    f = f + chk(std.math.TAU.to_bits() == 0x4019_21FB_5444_2D18u64, 2);
    f = f + chk(std.math.FRAC_PI_2.to_bits() == 0x3FF9_21FB_5444_2D18u64, 3);
    f = f + chk(std.math.FRAC_PI_3.to_bits() == 0x3FF0_C152_382D_7366u64, 4);
    f = f + chk(std.math.FRAC_PI_4.to_bits() == 0x3FE9_21FB_5444_2D18u64, 5);
    f = f + chk(std.math.FRAC_PI_6.to_bits() == 0x3FE0_C152_382D_7366u64, 6);
    f = f + chk(std.math.FRAC_PI_8.to_bits() == 0x3FD9_21FB_5444_2D18u64, 7);
    f = f + chk(std.math.FRAC_1_PI.to_bits() == 0x3FD4_5F30_6DC9_C883u64, 8);
    f = f + chk(std.math.FRAC_2_PI.to_bits() == 0x3FE4_5F30_6DC9_C883u64, 9);
    f = f + chk(std.math.FRAC_2_SQRT_PI.to_bits() == 0x3FF2_0DD7_5042_9B6Du64, 10);
    f = f + chk(std.math.E.to_bits() == 0x4005_BF0A_8B14_5769u64, 11);
    f = f + chk(std.math.LOG2_E.to_bits() == 0x3FF7_1547_652B_82FEu64, 12);
    f = f + chk(std.math.LOG10_E.to_bits() == 0x3FDB_CB7B_1526_E50Eu64, 13);
    f = f + chk(std.math.LN_2.to_bits() == 0x3FE6_2E42_FEFA_39EFu64, 14);
    f = f + chk(std.math.LN_10.to_bits() == 0x4002_6BB1_BBB5_5516u64, 15);
    f = f + chk(std.math.SQRT_2.to_bits() == 0x3FF6_A09E_667F_3BCDu64, 16);
    f = f + chk(std.math.FRAC_1_SQRT_2.to_bits() == 0x3FE6_A09E_667F_3BCDu64, 17);
    // std.math.f64.consts is the same set
    f = f + chk(std.math.f64.consts.PI.to_bits() == std.math.PI.to_bits(), 20);
    f = f + chk(std.math.f64.consts.LN_10.to_bits() == std.math.LN_10.to_bits(), 21);
    f = f + chk(std.math.f64.consts.FRAC_2_SQRT_PI.to_bits() == std.math.FRAC_2_SQRT_PI.to_bits(), 22);
    // relations that hold for the rounded values as well
    f = f + chk(std.math.TAU == 2.0 * std.math.PI, 23);
    f = f + chk(std.math.FRAC_PI_2 * 2.0 == std.math.PI, 24);
    f = f + chk(std.math.FRAC_PI_4 * 4.0 == std.math.PI, 25);
    f = f + chk(std.math.FRAC_PI_8 * 8.0 == std.math.PI, 26);
    f
}

fn t_f32() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(std.math.f32.consts.PI.to_bits() == 0x4049_0FDBu32, 31);
    f = f + chk(std.math.f32.consts.TAU.to_bits() == 0x40C9_0FDBu32, 32);
    f = f + chk(std.math.f32.consts.FRAC_PI_2.to_bits() == 0x3FC9_0FDBu32, 33);
    f = f + chk(std.math.f32.consts.FRAC_PI_3.to_bits() == 0x3F86_0A92u32, 34);
    f = f + chk(std.math.f32.consts.FRAC_PI_4.to_bits() == 0x3F49_0FDBu32, 35);
    f = f + chk(std.math.f32.consts.FRAC_PI_6.to_bits() == 0x3F06_0A92u32, 36);
    f = f + chk(std.math.f32.consts.FRAC_PI_8.to_bits() == 0x3EC9_0FDBu32, 37);
    f = f + chk(std.math.f32.consts.FRAC_1_PI.to_bits() == 0x3EA2_F983u32, 38);
    f = f + chk(std.math.f32.consts.FRAC_2_PI.to_bits() == 0x3F22_F983u32, 39);
    f = f + chk(std.math.f32.consts.FRAC_2_SQRT_PI.to_bits() == 0x3F90_6EBBu32, 40);
    f = f + chk(std.math.f32.consts.E.to_bits() == 0x402D_F854u32, 41);
    f = f + chk(std.math.f32.consts.LOG2_E.to_bits() == 0x3FB8_AA3Bu32, 42);
    f = f + chk(std.math.f32.consts.LOG10_E.to_bits() == 0x3EDE_5BD9u32, 43);
    f = f + chk(std.math.f32.consts.LN_2.to_bits() == 0x3F31_7218u32, 44);
    f = f + chk(std.math.f32.consts.LN_10.to_bits() == 0x4013_5D8Eu32, 45);
    f = f + chk(std.math.f32.consts.SQRT_2.to_bits() == 0x3FB5_04F3u32, 46);
    f = f + chk(std.math.f32.consts.FRAC_1_SQRT_2.to_bits() == 0x3F35_04F3u32, 47);
    f
}

fn main() -> i32 {
    let bad = t_f64() + t_f32();
    if bad == 0 {
        print("ok math consts\n");
        return 0;
    }
    1
}
