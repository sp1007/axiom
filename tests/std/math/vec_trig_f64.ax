fn run_tan() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 79 {
        let x = f64.from_bits(T_TAN[2 * i]);
        let got = std.math.tan(x).to_bits();
        if !near64(got, T_TAN[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL tan ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = run_sin() + run_cos() + run_tan();
    if bad == 0 {
        print("ok math vec_trig_f64\n");
        return 0;
    }
    1
}
