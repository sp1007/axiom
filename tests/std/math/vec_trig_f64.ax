fn run_cos() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 79 {
        let x = f64.from_bits(T_COS[2 * i]);
        let got = std.math.cos(x).to_bits();
        if !near64(got, T_COS[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL cos ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

