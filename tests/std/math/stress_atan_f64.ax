fn run_acos() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 264 {
        let x = f64.from_bits(T_ACOS[2 * i]);
        let got = std.math.acos(x).to_bits();
        if !near64(got, T_ACOS[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL acos ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = run_atan() + run_atan2() + run_asin() + run_acos();
    if bad == 0 {
        print("ok math stress_atan_f64\n");
        return 0;
    }
    1
}
