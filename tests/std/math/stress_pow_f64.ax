fn run_powf() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 606 {
        let x = f64.from_bits(T_POWF[3 * i]);
        let y = f64.from_bits(T_POWF[3 * i + 1]);
        let got = std.math.powf(x, y).to_bits();
        if !near64(got, T_POWF[3 * i + 2]) {
            bad = bad + 1;
            print("FAIL powf ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

