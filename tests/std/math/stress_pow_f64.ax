fn run_powi() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 346 {
        let x = f64.from_bits(T_POWI[3 * i]);
        let n = (T_POWI[3 * i + 1] as u32) as i32;
        let got = std.math.powi(x, n).to_bits();
        if !near64(got, T_POWI[3 * i + 2]) {
            bad = bad + 1;
            print("FAIL powi ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

