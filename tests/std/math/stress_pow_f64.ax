fn run_hypot() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 306 {
        let x = f64.from_bits(T_HYPOT[3 * i]);
        let y = f64.from_bits(T_HYPOT[3 * i + 1]);
        let got = std.math.hypot(x, y).to_bits();
        if !near64(got, T_HYPOT[3 * i + 2]) {
            bad = bad + 1;
            print("FAIL hypot ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = run_powf() + run_powi() + run_cbrt() + run_hypot();
    if bad == 0 {
        print("ok math stress_pow_f64\n");
        return 0;
    }
    1
}
