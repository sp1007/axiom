fn run_log() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 156 {
        let x = f64.from_bits(T_LOG[3 * i]);
        let y = f64.from_bits(T_LOG[3 * i + 1]);
        let got = std.math.log(x, y).to_bits();
        if !near64(got, T_LOG[3 * i + 2]) {
            bad = bad + 1;
            print("FAIL log ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = run_ln() + run_log2() + run_log10() + run_ln_1p() + run_log();
    if bad == 0 {
        print("ok math stress_log_f64\n");
        return 0;
    }
    1
}
