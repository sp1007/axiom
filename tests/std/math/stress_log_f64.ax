fn run_ln_1p() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 491 {
        let x = f64.from_bits(T_LN_1P[2 * i]);
        let got = std.math.ln_1p(x).to_bits();
        if !near64(got, T_LN_1P[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL ln_1p ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

