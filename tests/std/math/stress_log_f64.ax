fn run_ln() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 567 {
        let x = f64.from_bits(T_LN[2 * i]);
        let got = std.math.ln(x).to_bits();
        if !near64(got, T_LN[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL ln ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

