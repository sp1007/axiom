fn run_log10() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 567 {
        let x = f64.from_bits(T_LOG10[2 * i]);
        let got = std.math.log10(x).to_bits();
        if !near64(got, T_LOG10[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL log10 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

