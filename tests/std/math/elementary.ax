// test: run
// modes: interp native
// timeout: 300
// covers: REQ-SIMD-142, REQ-SIMD-143, REQ-SIMD-304, REQ-SIMD-305, REQ-SIMD-186, REQ-SIMD-187, REQ-SIMD-189, REQ-SIMD-163
// stdout: ok math elementary\n

// T461: the exact elementary operations of std.math (SPEC-41 AXS-FLT-062): the thin wrappers of std.core.float,
// signum, modf, frexp, ldexp / scalbn with single rounding, div_euclid / rem_euclid, lerp, for f64 and f32.
// Every result is compared bit for bit.

module test.math_elementary

use std.math
use std.math.f32.consts

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

fn eq64(x: f64, bits: u64) -> bool {
    x.to_bits() == bits
}

fn eq32(x: f32, bits: u32) -> bool {
    x.to_bits() == bits
}

fn t_wrappers_f64() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(eq64(std.math.floor(-2.5), 0xC008_0000_0000_0000u64), 1);
    f = f + chk(eq64(std.math.ceil(-2.5), 0xC000_0000_0000_0000u64), 2);
    f = f + chk(eq64(std.math.trunc(-2.5), 0xC000_0000_0000_0000u64), 3);
    f = f + chk(eq64(std.math.round(-2.5), 0xC008_0000_0000_0000u64), 4);
    f = f + chk(eq64(std.math.round(2.5), 0x4008_0000_0000_0000u64), 5);
    f = f + chk(eq64(std.math.round_ties_even(2.5), 0x4000_0000_0000_0000u64), 6);
    f = f + chk(eq64(std.math.round_ties_even(3.5), 0x4010_0000_0000_0000u64), 7);
    f = f + chk(eq64(std.math.fract(-2.5), 0xBFE0_0000_0000_0000u64), 8);
    f = f + chk(eq64(std.math.trunc(-0.4), 0x8000_0000_0000_0000u64), 9);
    f = f + chk(eq64(std.math.abs(-0.0), 0u64), 10);
    f = f + chk(eq64(std.math.abs(-3.5), 0x400C_0000_0000_0000u64), 11);
    f = f + chk(eq64(std.math.copysign(3.0, -0.0), 0xC008_0000_0000_0000u64), 12);
    f = f + chk(eq64(std.math.sqrt(2.0), 0x3FF6_A09E_667F_3BCDu64), 13);
    f = f + chk(eq64(std.math.sqrt(-0.0), 0x8000_0000_0000_0000u64), 14);
    f = f + chk(std.math.sqrt(-1.0) != std.math.sqrt(-1.0), 15);
    f = f + chk(eq64(std.math.min(-0.0, 0.0), 0x8000_0000_0000_0000u64), 16);
    f = f + chk(eq64(std.math.max(-0.0, 0.0), 0u64), 17);
    f = f + chk(eq64(std.math.min(f64.NAN, 1.0), 0x3FF0_0000_0000_0000u64), 18);
    f = f + chk(eq64(std.math.max(2.0, f64.NAN), 0x4000_0000_0000_0000u64), 19);
    f = f + chk(eq64(std.math.clamp(5.0, 1.0, 3.0), 0x4008_0000_0000_0000u64), 20);
    f = f + chk(eq64(std.math.clamp(-5.0, 1.0, 3.0), 0x3FF0_0000_0000_0000u64), 21);
    f = f + chk(eq64(std.math.clamp(2.0, 1.0, 3.0), 0x4000_0000_0000_0000u64), 22);
    f = f + chk(eq64(std.math.fma(2.0, 3.0, 4.0), 0x4024_0000_0000_0000u64), 23);
    // a single rounding: 0.1 * 10 - 1 is exactly 2^-54, the unfused product rounds to 1.0
    f = f + chk(eq64(std.math.fma(0.1, 10.0, -1.0), 0x3C90_0000_0000_0000u64), 24);
    f = f + chk(eq64(std.math.mul_add(0.1, 10.0, -1.0), 0x3C90_0000_0000_0000u64), 25);
    f = f + chk(eq64(std.math.to_degrees(std.math.PI), 0x4066_8000_0000_0000u64), 26);
    f = f + chk(eq64(std.math.to_radians(180.0), 0x4009_21FB_5444_2D18u64), 27);
    f = f + chk(eq64(std.math.next_up(1.0), 0x3FF0_0000_0000_0001u64), 28);
    f = f + chk(eq64(std.math.next_down(1.0), 0x3FEF_FFFF_FFFF_FFFFu64), 29);
    f
}

fn t_wrappers_f32() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(eq32(std.math.floor_f32(-2.5), 0xC040_0000u32), 41);
    f = f + chk(eq32(std.math.ceil_f32(-2.5), 0xC000_0000u32), 42);
    f = f + chk(eq32(std.math.trunc_f32(-2.5), 0xC000_0000u32), 43);
    f = f + chk(eq32(std.math.round_f32(-2.5), 0xC040_0000u32), 44);
    f = f + chk(eq32(std.math.round_ties_even_f32(2.5), 0x4000_0000u32), 45);
    f = f + chk(eq32(std.math.fract_f32(-2.5), 0xBF00_0000u32), 46);
    f = f + chk(eq32(std.math.abs_f32(-0.0), 0u32), 47);
    f = f + chk(eq32(std.math.copysign_f32(3.0, -0.0), 0xC040_0000u32), 48);
    f = f + chk(eq32(std.math.sqrt_f32(2.0), 0x3FB5_04F3u32), 49);
    f = f + chk(eq32(std.math.min_f32(-0.0, 0.0), 0x8000_0000u32), 50);
    f = f + chk(eq32(std.math.max_f32(f32.NAN, 1.0), 0x3F80_0000u32), 51);
    f = f + chk(eq32(std.math.clamp_f32(5.0, 1.0, 3.0), 0x4040_0000u32), 52);
    f = f + chk(eq32(std.math.fma_f32(2.0, 3.0, 4.0), 0x4120_0000u32), 53);
    f = f + chk(eq32(std.math.to_degrees_f32(std.math.f32.consts.PI), 0x4334_0000u32), 54);
    f = f + chk(eq32(std.math.next_up_f32(1.0), 0x3F80_0001u32), 55);
    f
}

fn t_signum_modf_frexp() -> i32 {
    let mut f: i32 = 0;
    let nan = f64.NAN;
    let inf = f64.INFINITY;
    f = f + chk(eq64(std.math.signum(5.0), 0x3FF0_0000_0000_0000u64), 61);
    f = f + chk(eq64(std.math.signum(-5.0), 0xBFF0_0000_0000_0000u64), 62);
    f = f + chk(eq64(std.math.signum(0.0), 0x3FF0_0000_0000_0000u64), 63);
    f = f + chk(eq64(std.math.signum(-0.0), 0xBFF0_0000_0000_0000u64), 64);
    f = f + chk(eq64(std.math.signum(inf), 0x3FF0_0000_0000_0000u64), 65);
    f = f + chk(eq64(std.math.signum(-inf), 0xBFF0_0000_0000_0000u64), 66);
    f = f + chk(std.math.signum(nan) != std.math.signum(nan), 67);
    f = f + chk(eq32(std.math.signum_f32(-2.0), 0xBF80_0000u32), 68);
    let a = std.math.modf(3.75);
    f = f + chk(eq64(a.0, 0x4008_0000_0000_0000u64) && eq64(a.1, 0x3FE8_0000_0000_0000u64), 70);
    let b = std.math.modf(-3.75);
    f = f + chk(eq64(b.0, 0xC008_0000_0000_0000u64) && eq64(b.1, 0xBFE8_0000_0000_0000u64), 71);
    let c = std.math.modf(-3.0);
    f = f + chk(eq64(c.0, 0xC008_0000_0000_0000u64) && eq64(c.1, 0x8000_0000_0000_0000u64), 72);
    let d = std.math.modf(-0.5);
    f = f + chk(eq64(d.0, 0x8000_0000_0000_0000u64) && eq64(d.1, 0xBFE0_0000_0000_0000u64), 73);
    let e = std.math.modf(inf);
    f = f + chk(eq64(e.0, 0x7FF0_0000_0000_0000u64) && eq64(e.1, 0u64), 74);
    let g = std.math.modf(-inf);
    f = f + chk(eq64(g.0, 0xFFF0_0000_0000_0000u64) && eq64(g.1, 0x8000_0000_0000_0000u64), 75);
    let h = std.math.modf(nan);
    f = f + chk(h.0 != h.0 && h.1 != h.1, 76);
    let m32 = std.math.modf_f32(-2.25);
    f = f + chk(eq32(m32.0, 0xC000_0000u32) && eq32(m32.1, 0xBE80_0000u32), 77);
    // frexp
    let r1 = std.math.frexp(8.0);
    f = f + chk(eq64(r1.0, 0x3FE0_0000_0000_0000u64) && r1.1 == 4, 80);
    let r2 = std.math.frexp(-0.75);
    f = f + chk(eq64(r2.0, 0xBFE8_0000_0000_0000u64) && r2.1 == 0, 81);
    let r3 = std.math.frexp(5.0e-324);
    f = f + chk(eq64(r3.0, 0x3FE0_0000_0000_0000u64) && r3.1 == -1073, 82);
    let r4 = std.math.frexp(1.0);
    f = f + chk(eq64(r4.0, 0x3FE0_0000_0000_0000u64) && r4.1 == 1, 83);
    let r5 = std.math.frexp(0.0);
    f = f + chk(eq64(r5.0, 0u64) && r5.1 == 0, 84);
    let r6 = std.math.frexp(-0.0);
    f = f + chk(eq64(r6.0, 0x8000_0000_0000_0000u64) && r6.1 == 0, 85);
    let r7 = std.math.frexp(inf);
    f = f + chk(eq64(r7.0, 0x7FF0_0000_0000_0000u64) && r7.1 == 0, 86);
    let r8 = std.math.frexp(1.7976931348623157e308);
    f = f + chk(eq64(r8.0, 0x3FEF_FFFF_FFFF_FFFFu64) && r8.1 == 1024, 87);
    let r9 = std.math.frexp(nan);
    f = f + chk(r9.0 != r9.0 && r9.1 == 0, 88);
    let r10 = std.math.frexp(2.2250738585072014e-308);
    f = f + chk(eq64(r10.0, 0x3FE0_0000_0000_0000u64) && r10.1 == -1021, 89);
    let r11 = std.math.frexp_f32(-12.0);
    f = f + chk(eq32(r11.0, 0xBF40_0000u32) && r11.1 == 4, 90);
    let r12 = std.math.frexp_f32(1.4e-45);
    f = f + chk(eq32(r12.0, 0x3F00_0000u32) && r12.1 == -148, 91);
    f
}

fn t_ldexp() -> i32 {
    let mut f: i32 = 0;
    let inf = f64.INFINITY;
    f = f + chk(eq64(std.math.ldexp(1.0, 10), 0x4090_0000_0000_0000u64), 101);
    f = f + chk(eq64(std.math.ldexp(1.0, -1074), 0x0000_0000_0000_0001u64), 102);
    f = f + chk(eq64(std.math.ldexp(1.0, -1075), 0u64), 103);
    f = f + chk(eq64(std.math.ldexp(3.0, -1075), 0x0000_0000_0000_0002u64), 104);
    f = f + chk(eq64(std.math.ldexp(1.0, 1024), 0x7FF0_0000_0000_0000u64), 105);
    f = f + chk(eq64(std.math.ldexp(0.5, 1024), 0x7FE0_0000_0000_0000u64), 106);
    f = f + chk(eq64(std.math.ldexp(-0.0, 5), 0x8000_0000_0000_0000u64), 107);
    f = f + chk(eq64(std.math.ldexp(inf, -5), 0x7FF0_0000_0000_0000u64), 108);
    f = f + chk(eq64(std.math.ldexp(1.5, 2147483647), 0x7FF0_0000_0000_0000u64), 109);
    f = f + chk(eq64(std.math.ldexp(1.5, -2147483647), 0u64), 110);
    f = f + chk(eq64(std.math.ldexp(-1.5, -2147483647), 0x8000_0000_0000_0000u64), 111);
    f = f + chk(eq64(std.math.ldexp(5.0e-324, 1074), 0x3FF0_0000_0000_0000u64), 112);
    f = f + chk(eq64(std.math.ldexp(f64.from_bits(0x000F_FFFF_FFFF_FFFFu64), -1), 0x0008_0000_0000_0000u64), 113);
    // single rounding on the way into the subnormal range (no double rounding)
    f = f + chk(eq64(std.math.ldexp(f64.from_bits(0x3FF8_0000_0000_0001u64), -1074), 0x0000_0000_0000_0002u64), 114);
    f = f + chk(eq64(std.math.ldexp(f64.from_bits(0x3FF7_FFFF_FFFF_FFFFu64), -1074), 0x0000_0000_0000_0001u64), 115);
    f = f + chk(eq64(std.math.scalbn(1.0, 10), 0x4090_0000_0000_0000u64), 116);
    f = f + chk(eq64(std.math.scalbn(3.0, -1075), 0x0000_0000_0000_0002u64), 117);
    f = f + chk(eq32(std.math.ldexp_f32(1.0, -149), 0x0000_0001u32), 118);
    f = f + chk(eq32(std.math.ldexp_f32(1.0, -150), 0u32), 119);
    f = f + chk(eq32(std.math.ldexp_f32(3.0, -150), 0x0000_0002u32), 120);
    f = f + chk(eq32(std.math.ldexp_f32(1.0, 128), 0x7F80_0000u32), 121);
    f = f + chk(eq32(std.math.scalbn_f32(0.75, 3), 0x40C0_0000u32), 122);
    f
}

fn t_euclid_lerp() -> i32 {
    let mut f: i32 = 0;
    let nan = f64.NAN;
    f = f + chk(eq64(std.math.div_euclid(7.0, 2.0), 0x4008_0000_0000_0000u64), 141);
    f = f + chk(eq64(std.math.rem_euclid(7.0, 2.0), 0x3FF0_0000_0000_0000u64), 142);
    f = f + chk(eq64(std.math.div_euclid(-7.0, 2.0), 0xC010_0000_0000_0000u64), 143);
    f = f + chk(eq64(std.math.rem_euclid(-7.0, 2.0), 0x3FF0_0000_0000_0000u64), 144);
    f = f + chk(eq64(std.math.div_euclid(7.0, -2.0), 0xC008_0000_0000_0000u64), 145);
    f = f + chk(eq64(std.math.rem_euclid(7.0, -2.0), 0x3FF0_0000_0000_0000u64), 146);
    f = f + chk(eq64(std.math.div_euclid(-7.0, -2.0), 0x4010_0000_0000_0000u64), 147);
    f = f + chk(eq64(std.math.rem_euclid(-7.0, -2.0), 0x3FF0_0000_0000_0000u64), 148);
    f = f + chk(eq64(std.math.rem_euclid(-7.5, 2.0), 0x3FE0_0000_0000_0000u64), 149);
    f = f + chk(std.math.rem_euclid(5.0, 0.0) != std.math.rem_euclid(5.0, 0.0), 150);
    f = f + chk(std.math.rem_euclid(nan, 2.0) != std.math.rem_euclid(nan, 2.0), 151);
    f = f + chk(std.math.rem_euclid(f64.INFINITY, 2.0) != std.math.rem_euclid(f64.INFINITY, 2.0), 152);
    f = f + chk(eq64(std.math.rem_euclid(-0.0, 3.0), 0u64), 153);
    f = f + chk(eq64(std.math.rem_euclid(-6.0, 3.0), 0u64), 154);
    f = f + chk(eq32(std.math.rem_euclid_f32(-7.0, 2.0), 0x3F80_0000u32), 155);
    f = f + chk(eq32(std.math.div_euclid_f32(-7.0, 2.0), 0xC080_0000u32), 156);
    f = f + chk(eq64(std.math.lerp(0.0, 10.0, 0.5), 0x4014_0000_0000_0000u64), 160);
    f = f + chk(eq64(std.math.lerp(2.0, 4.0, 0.0), 0x4000_0000_0000_0000u64), 161);
    f = f + chk(eq64(std.math.lerp(2.0, 4.0, 1.0), 0x4010_0000_0000_0000u64), 162);
    f = f + chk(eq64(std.math.lerp(1.0, 2.0, 1.0), 0x4000_0000_0000_0000u64), 163);
    f = f + chk(eq64(std.math.lerp(-1.0, 1.0, 0.25), 0xBFE0_0000_0000_0000u64), 164);
    f = f + chk(eq64(std.math.lerp(0.0, 1.0, 2.0), 0x4000_0000_0000_0000u64), 165);
    f = f + chk(eq64(std.math.lerp(3.0, 3.0, 0.7), 0x4008_0000_0000_0000u64), 166);
    f = f + chk(eq32(std.math.lerp_f32(2.0, 4.0, 1.0), 0x4080_0000u32), 167);
    f = f + chk(eq32(std.math.lerp_f32(-1.0, 1.0, 0.5), 0u32), 168);
    f
}

fn main() -> i32 {
    let bad = t_wrappers_f64() + t_wrappers_f32() + t_signum_modf_frexp() + t_ldexp() + t_euclid_lerp();
    if bad == 0 {
        print("ok math elementary\n");
        return 0;
    }
    1
}
