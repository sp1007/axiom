// test: run
// modes: interp native
// timeout: 900
// covers: REQ-SIMD-142, REQ-SIMD-143, REQ-SIMD-304, REQ-SIMD-305, REQ-SIMD-186, REQ-SIMD-187, REQ-SIMD-189
// flags: --step-limit 4000000000
// stdout: ok math vec_f32\n

// T461: std.math f32 variants of every transcendental function. Inputs come from a portable splitmix64 generator, the expected values are the correctly rounded
// results of 300-bit mpmath references (tests/std/math/make_vectors.py); a result passes within 1 ulp (SPEC-41
// AXS-FLT-063). GENERATED, do not edit.

module test.math_vec_f32

use std.math

fn near64(got: u64, want: u64) -> bool {
    if got == want {
        return true;
    }
    let g = f64.from_bits(got);
    let w = f64.from_bits(want);
    if g != g && w != w {
        return true;
    }
    if g != g || w != w {
        return false;
    }
    if (got >> 63u32) != (want >> 63u32) {
        return false;
    }
    let d = if got > want { got - want } else { want - got };
    d <= 1u64
}

fn near32(got: u32, want: u32) -> bool {
    if got == want {
        return true;
    }
    let g = f32.from_bits(got);
    let w = f32.from_bits(want);
    if g != g && w != w {
        return true;
    }
    if g != g || w != w {
        return false;
    }
    if (got >> 31u32) != (want >> 31u32) {
        return false;
    }
    let d = if got > want { got - want } else { want - got };
    d <= 1u32
}

const T_EXP: [38]u64 = [
    0xC4317D89u64, 0x00000000u64, 0x4268D111u64, 0x697AE1AAu64, 0xC421F049u64, 0x00000000u64,
    0x4207AB49u64, 0x57F442C0u64, 0x43E49047u64, 0x7F800000u64, 0xBF1389F2u64, 0x3F0FDCA6u64,
    0x3FFAD3B4u64, 0x40E31598u64, 0x4028848Au64, 0x415EAACDu64, 0x401B4231u64, 0x4135004Fu64,
    0xBF3E6F0Eu64, 0x3EF355FAu64, 0x3A16094Eu64, 0x3F8012C3u64, 0x442F8027u64, 0x7F800000u64,
    0x44312660u64, 0x7F800000u64, 0xC43A4666u64, 0x00000000u64, 0xC4312000u64, 0x00000000u64,
    0x443171ECu64, 0x7F800000u64, 0x3F800000u64, 0x402DF854u64, 0xBF800000u64, 0x3EBC5AB2u64,
    0x3F000000u64, 0x3FD3094Cu64,
];

fn run_exp() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 19 {
        let x = f32.from_bits(T_EXP[2 * i] as u32);
        let got = std.math.exp_f32(x).to_bits();
        if !near32(got, T_EXP[2 * i + 1] as u32) {
            bad = bad + 1;
            print("FAIL exp_f32 ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

