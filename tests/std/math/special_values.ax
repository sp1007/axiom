// test: run
// modes: interp native
// timeout: 600
// covers: REQ-SIMD-142, REQ-SIMD-143, REQ-SIMD-304, REQ-SIMD-305, REQ-SIMD-186, REQ-SIMD-187, REQ-SIMD-189
// flags: --step-limit 4000000000
// stdout: ok math special_values\n

// T461: the IEEE-754 special-value table of SPEC-41 AXS-FLT-064 for every std.math function, f64 and f32: NaN
// propagation, signed zeros, infinities, domain errors and overflow / underflow thresholds. Results are compared bit
// for bit (a NaN result matches any NaN).

module test.math_special_values

use std.math

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

fn is_nan64(x: f64) -> bool {
    x != x
}

fn is_nan32(x: f32) -> bool {
    x != x
}

// bit pattern checks
fn eq64(x: f64, bits: u64) -> bool {
    x.to_bits() == bits
}

fn eq32(x: f32, bits: u32) -> bool {
    x.to_bits() == bits
}

const PZ: u64 = 0x0000_0000_0000_0000u64;
const NZ: u64 = 0x8000_0000_0000_0000u64;
const P1: u64 = 0x3FF0_0000_0000_0000u64;
const N1: u64 = 0xBFF0_0000_0000_0000u64;
const PINF: u64 = 0x7FF0_0000_0000_0000u64;
const NINF: u64 = 0xFFF0_0000_0000_0000u64;
const HALF_PI: u64 = 0x3FF9_21FB_5444_2D18u64;
const PI_BITS: u64 = 0x4009_21FB_5444_2D18u64;
const QUARTER_PI: u64 = 0x3FE9_21FB_5444_2D18u64;
const THREE_QUARTER_PI: u64 = 0x4002_D97C_7F33_21D2u64;

const PZ32: u32 = 0x0000_0000u32;
const NZ32: u32 = 0x8000_0000u32;
const P132: u32 = 0x3F80_0000u32;
const N132: u32 = 0xBF80_0000u32;
const PINF32: u32 = 0x7F80_0000u32;
const NINF32: u32 = 0xFF80_0000u32;

fn t_exp_log() -> i32 {
    let mut f: i32 = 0;
    let nan = f64.NAN;
    let inf = f64.INFINITY;
    let pz: f64 = 0.0;
    let nz: f64 = -0.0;
    f = f + chk(eq64(std.math.exp(pz), P1), 1);
    f = f + chk(eq64(std.math.exp(nz), P1), 2);
    f = f + chk(eq64(std.math.exp(inf), PINF), 3);
    f = f + chk(eq64(std.math.exp(-inf), PZ), 4);
    f = f + chk(is_nan64(std.math.exp(nan)), 5);
    f = f + chk(eq64(std.math.exp(709.79), PINF), 6);
    f = f + chk(eq64(std.math.exp(-746.0), PZ), 7);
    f = f + chk(eq64(std.math.exp(1.0), 0x4005_BF0A_8B14_5769u64), 8);
    f = f + chk(eq64(std.math.exp(-745.0), 0x0000_0000_0000_0001u64), 9);
    f = f + chk(eq64(std.math.exp(709.78), 0x7FEF_E9CE_5C4C_52B4u64), 10);
    f = f + chk(eq64(std.math.exp2(pz), P1), 11);
    f = f + chk(eq64(std.math.exp2(nz), P1), 12);
    f = f + chk(eq64(std.math.exp2(inf), PINF), 13);
    f = f + chk(eq64(std.math.exp2(-inf), PZ), 14);
    f = f + chk(eq64(std.math.exp2(1024.0), PINF), 15);
    f = f + chk(eq64(std.math.exp2(1023.0), 0x7FE0_0000_0000_0000u64), 16);
    f = f + chk(eq64(std.math.exp2(-1074.0), 0x0000_0000_0000_0001u64), 17);
    f = f + chk(eq64(std.math.exp2(-1075.0), PZ), 18);
    f = f + chk(eq64(std.math.exp2(10.0), 0x4090_0000_0000_0000u64), 19);
    f = f + chk(eq64(std.math.exp2(-3.0), 0x3FC0_0000_0000_0000u64), 20);
    f = f + chk(is_nan64(std.math.exp2(nan)), 21);
    f = f + chk(eq64(std.math.expm1(pz), PZ), 22);
    f = f + chk(eq64(std.math.expm1(nz), NZ), 23);
    f = f + chk(eq64(std.math.expm1(inf), PINF), 24);
    f = f + chk(eq64(std.math.expm1(-inf), N1), 25);
    f = f + chk(eq64(std.math.expm1(710.0), PINF), 26);
    f = f + chk(eq64(std.math.expm1(-50.0), N1), 27);
    f = f + chk(eq64(std.math.expm1(1.0e-300), 0x01A5_6E1F_C2F8_F359u64), 28);
    f = f + chk(is_nan64(std.math.expm1(nan)), 29);
    // logarithms
    f = f + chk(eq64(std.math.ln(1.0), PZ), 30);
    f = f + chk(eq64(std.math.ln(pz), NINF), 31);
    f = f + chk(eq64(std.math.ln(nz), NINF), 32);
    f = f + chk(is_nan64(std.math.ln(-1.0)), 33);
    f = f + chk(eq64(std.math.ln(inf), PINF), 34);
    f = f + chk(is_nan64(std.math.ln(nan)), 35);
    f = f + chk(is_nan64(std.math.ln(-inf)), 36);
    f = f + chk(eq64(std.math.log2(1.0), PZ), 37);
    f = f + chk(eq64(std.math.log2(pz), NINF), 38);
    f = f + chk(is_nan64(std.math.log2(-0.5)), 39);
    f = f + chk(eq64(std.math.log2(inf), PINF), 40);
    f = f + chk(eq64(std.math.log2(8.0), 0x4008_0000_0000_0000u64), 41);
    f = f + chk(eq64(std.math.log2(0.25), 0xC000_0000_0000_0000u64), 42);
    f = f + chk(eq64(std.math.log2(5.0e-324), 0xC090_C800_0000_0000u64), 43);
    f = f + chk(eq64(std.math.log10(1.0), PZ), 44);
    f = f + chk(eq64(std.math.log10(nz), NINF), 45);
    f = f + chk(is_nan64(std.math.log10(-3.0)), 46);
    f = f + chk(eq64(std.math.log10(inf), PINF), 47);
    f = f + chk(eq64(std.math.log10(1000.0), 0x4008_0000_0000_0000u64), 48);
    f = f + chk(eq64(std.math.log10(1.0e-5), 0xC014_0000_0000_0000u64), 49);
    f = f + chk(eq64(std.math.ln_1p(pz), PZ), 50);
    f = f + chk(eq64(std.math.ln_1p(nz), NZ), 51);
    f = f + chk(eq64(std.math.ln_1p(-1.0), NINF), 52);
    f = f + chk(is_nan64(std.math.ln_1p(-1.5)), 53);
    f = f + chk(eq64(std.math.ln_1p(inf), PINF), 54);
    f = f + chk(is_nan64(std.math.ln_1p(nan)), 55);
    f = f + chk(eq64(std.math.ln_1p(1.0e-300), 0x01A5_6E1F_C2F8_F359u64), 56);
    f = f + chk(eq64(std.math.log(8.0, 2.0), 0x4008_0000_0000_0000u64), 57);
    f = f + chk(eq64(std.math.log(1000.0, 10.0), 0x4008_0000_0000_0000u64), 58);
    f = f + chk(is_nan64(std.math.log(-1.0, 2.0)), 59);
    f = f + chk(is_nan64(std.math.log(2.0, -1.0)), 60);
    f = f + chk(eq64(std.math.log(2.0, 2.0), P1), 61);
    f
}

fn t_pow() -> i32 {
    let mut f: i32 = 0;
    let nan = f64.NAN;
    let inf = f64.INFINITY;
    let pz: f64 = 0.0;
    let nz: f64 = -0.0;
    // y == 0 and x == 1
    f = f + chk(eq64(std.math.powf(2.0, pz), P1), 101);
    f = f + chk(eq64(std.math.powf(nan, pz), P1), 102);
    f = f + chk(eq64(std.math.powf(inf, nz), P1), 103);
    f = f + chk(eq64(std.math.powf(pz, pz), P1), 104);
    f = f + chk(eq64(std.math.powf(1.0, nan), P1), 105);
    f = f + chk(eq64(std.math.powf(1.0, inf), P1), 106);
    f = f + chk(eq64(std.math.powf(-1.0, inf), P1), 107);
    f = f + chk(eq64(std.math.powf(-1.0, -inf), P1), 108);
    f = f + chk(is_nan64(std.math.powf(nan, 2.0)), 109);
    f = f + chk(is_nan64(std.math.powf(2.0, nan)), 110);
    // zero base
    f = f + chk(eq64(std.math.powf(pz, -1.0), PINF), 111);
    f = f + chk(eq64(std.math.powf(nz, -1.0), NINF), 112);
    f = f + chk(eq64(std.math.powf(nz, -2.0), PINF), 113);
    f = f + chk(eq64(std.math.powf(pz, -0.5), PINF), 114);
    f = f + chk(eq64(std.math.powf(nz, 3.0), NZ), 115);
    f = f + chk(eq64(std.math.powf(nz, 2.0), PZ), 116);
    f = f + chk(eq64(std.math.powf(pz, 0.5), PZ), 117);
    f = f + chk(eq64(std.math.powf(nz, 0.5), PZ), 118);
    // infinite base
    f = f + chk(eq64(std.math.powf(inf, 2.0), PINF), 119);
    f = f + chk(eq64(std.math.powf(inf, -2.0), PZ), 120);
    f = f + chk(eq64(std.math.powf(-inf, 3.0), NINF), 121);
    f = f + chk(eq64(std.math.powf(-inf, 2.0), PINF), 122);
    f = f + chk(eq64(std.math.powf(-inf, -3.0), NZ), 123);
    f = f + chk(eq64(std.math.powf(-inf, -2.0), PZ), 124);
    f = f + chk(eq64(std.math.powf(-inf, 0.5), PINF), 125);
    // infinite exponent
    f = f + chk(eq64(std.math.powf(2.0, inf), PINF), 126);
    f = f + chk(eq64(std.math.powf(0.5, inf), PZ), 127);
    f = f + chk(eq64(std.math.powf(2.0, -inf), PZ), 128);
    f = f + chk(eq64(std.math.powf(0.5, -inf), PINF), 129);
    f = f + chk(eq64(std.math.powf(-2.0, inf), PINF), 130);
    f = f + chk(eq64(std.math.powf(-0.5, inf), PZ), 131);
    // negative base
    f = f + chk(is_nan64(std.math.powf(-8.0, 0.5)), 132);
    f = f + chk(is_nan64(std.math.powf(-2.0, 1.5)), 133);
    f = f + chk(eq64(std.math.powf(-2.0, 3.0), 0xC020_0000_0000_0000u64), 134);
    f = f + chk(eq64(std.math.powf(-2.0, 2.0), 0x4010_0000_0000_0000u64), 135);
    f = f + chk(eq64(std.math.powf(-2.0, -3.0), 0xBFC0_0000_0000_0000u64), 136);
    f = f + chk(eq64(std.math.powf(-3.0, 9007199254740992.0), PINF), 137);
    // exact results
    f = f + chk(eq64(std.math.powf(2.0, 10.0), 0x4090_0000_0000_0000u64), 138);
    f = f + chk(eq64(std.math.powf(10.0, 2.0), 0x4059_0000_0000_0000u64), 139);
    f = f + chk(eq64(std.math.powf(3.0, 4.0), 0x4054_4000_0000_0000u64), 140);
    f = f + chk(eq64(std.math.powf(2.0, 0.5), 0x3FF6_A09E_667F_3BCDu64), 141);
    f = f + chk(eq64(std.math.powf(4.0, 0.5), 0x4000_0000_0000_0000u64), 142);
    f = f + chk(eq64(std.math.powf(2.0, 1024.0), PINF), 143);
    f = f + chk(eq64(std.math.powf(2.0, -1074.0), 0x0000_0000_0000_0001u64), 144);
    f = f + chk(eq64(std.math.powf(2.0, -1076.0), PZ), 145);
    f = f + chk(eq64(std.math.powf(1.0e200, 2.0), PINF), 146);
    f = f + chk(eq64(std.math.powf(1.0e-200, 2.0), PZ), 147);
    f = f + chk(eq64(std.math.powf(5.0, 1.0e19), PINF), 148);
    f = f + chk(eq64(std.math.powf(0.5, 1.0e19), PZ), 149);
    // powi
    f = f + chk(eq64(std.math.powi(nan, 0), P1), 150);
    f = f + chk(is_nan64(std.math.powi(nan, 3)), 151);
    f = f + chk(eq64(std.math.powi(2.0, 10), 0x4090_0000_0000_0000u64), 152);
    f = f + chk(eq64(std.math.powi(2.0, -2), 0x3FD0_0000_0000_0000u64), 153);
    f = f + chk(eq64(std.math.powi(pz, -1), PINF), 154);
    f = f + chk(eq64(std.math.powi(nz, -3), NINF), 155);
    f = f + chk(eq64(std.math.powi(nz, -2), PINF), 156);
    f = f + chk(eq64(std.math.powi(nz, 3), NZ), 157);
    f = f + chk(eq64(std.math.powi(pz, 4), PZ), 158);
    f = f + chk(eq64(std.math.powi(-2.0, 3), 0xC020_0000_0000_0000u64), 159);
    f = f + chk(eq64(std.math.powi(-2.0, -3), 0xBFC0_0000_0000_0000u64), 160);
    f = f + chk(eq64(std.math.powi(inf, -1), PZ), 161);
    f = f + chk(eq64(std.math.powi(-inf, 3), NINF), 162);
    f = f + chk(eq64(std.math.powi(-inf, -3), NZ), 163);
    f = f + chk(eq64(std.math.powi(2.0, 1023), 0x7FE0_0000_0000_0000u64), 164);
    f = f + chk(eq64(std.math.powi(2.0, 1024), PINF), 165);
    f = f + chk(eq64(std.math.powi(2.0, -1074), 0x0000_0000_0000_0001u64), 166);
    f = f + chk(eq64(std.math.powi(2.0, -1075), PZ), 167);
    f = f + chk(eq64(std.math.powi(10.0, 22), 0x4480_F0CF_064D_D592u64), 168);
    f = f + chk(eq64(std.math.powi(10.0, 23), 0x44B5_2D02_C7E1_4AF6u64), 169);
    f = f + chk(eq64(std.math.powi(10.0, -5), 0x3EE4_F8B5_88E3_68F1u64), 170);
    f = f + chk(eq64(std.math.powi(1.0000001, 2147483647), 0x534C_2D02_4509_ADD1u64), 171);
    f = f + chk(eq64(std.math.powi(0.5, -2147483647), PINF), 172);
    f = f + chk(eq64(std.math.powi(2.0, -2147483647), PZ), 173);
    f = f + chk(eq64(std.math.powi(1.0, -2147483647), P1), 174);
    f = f + chk(eq64(std.math.powi(-1.0, -2147483647), N1), 175);
    f = f + chk(eq64(std.math.powi(5.0e-324, -1), PINF), 176);
    f = f + chk(eq64(std.math.powi(1.7976931348623157e308, -1), 0x0004_0000_0000_0000u64), 177);
    f
}

fn t_roots() -> i32 {
    let mut f: i32 = 0;
    let nan = f64.NAN;
    let inf = f64.INFINITY;
    let pz: f64 = 0.0;
    let nz: f64 = -0.0;
    f = f + chk(eq64(std.math.cbrt(pz), PZ), 201);
    f = f + chk(eq64(std.math.cbrt(nz), NZ), 202);
    f = f + chk(eq64(std.math.cbrt(inf), PINF), 203);
    f = f + chk(eq64(std.math.cbrt(-inf), NINF), 204);
    f = f + chk(is_nan64(std.math.cbrt(nan)), 205);
    f = f + chk(eq64(std.math.cbrt(27.0), 0x4008_0000_0000_0000u64), 206);
    f = f + chk(eq64(std.math.cbrt(-27.0), 0xC008_0000_0000_0000u64), 207);
    f = f + chk(eq64(std.math.cbrt(-8.0), 0xC000_0000_0000_0000u64), 208);
    f = f + chk(eq64(std.math.cbrt(1000.0), 0x4024_0000_0000_0000u64), 209);
    f = f + chk(eq64(std.math.cbrt(0.001), 0x3FB9_9999_9999_999Au64), 210);
    f = f + chk(eq64(std.math.cbrt(5.0e-324), 0x2990_0000_0000_0000u64), 211);
    f = f + chk(eq64(std.math.cbrt(1.0e300), 0x54B2_49AD_2594_C37Du64), 212);
    f = f + chk(eq64(std.math.hypot(inf, nan), PINF), 213);
    f = f + chk(eq64(std.math.hypot(nan, -inf), PINF), 214);
    f = f + chk(eq64(std.math.hypot(-inf, 3.0), PINF), 215);
    f = f + chk(eq64(std.math.hypot(pz, nz), PZ), 216);
    f = f + chk(eq64(std.math.hypot(nz, nz), PZ), 217);
    f = f + chk(eq64(std.math.hypot(3.0, 4.0), 0x4014_0000_0000_0000u64), 218);
    f = f + chk(eq64(std.math.hypot(-3.0, -4.0), 0x4014_0000_0000_0000u64), 219);
    f = f + chk(eq64(std.math.hypot(4.0, 3.0), 0x4014_0000_0000_0000u64), 220);
    f = f + chk(eq64(std.math.hypot(5.0, pz), 0x4014_0000_0000_0000u64), 221);
    f = f + chk(is_nan64(std.math.hypot(nan, 1.0)), 222);
    f = f + chk(eq64(std.math.hypot(1.0e308, 1.0e308), 0x7FE9_2C80_954C_51F5u64), 223);
    f = f + chk(eq64(std.math.hypot(1.0e300, 1.0e300), 0x7E40_E4D5_0F99_B211u64), 224);
    f = f + chk(eq64(std.math.hypot(5.0e-324, 5.0e-324), 0x0000_0000_0000_0001u64), 225);
    f = f + chk(eq64(std.math.hypot(1.0, 1.0e-30), P1), 226);
    f
}

fn t_trig() -> i32 {
    let mut f: i32 = 0;
    let nan = f64.NAN;
    let inf = f64.INFINITY;
    let pz: f64 = 0.0;
    let nz: f64 = -0.0;
    f = f + chk(eq64(std.math.sin(pz), PZ), 301);
    f = f + chk(eq64(std.math.sin(nz), NZ), 302);
    f = f + chk(is_nan64(std.math.sin(inf)), 303);
    f = f + chk(is_nan64(std.math.sin(-inf)), 304);
    f = f + chk(is_nan64(std.math.sin(nan)), 305);
    f = f + chk(eq64(std.math.cos(pz), P1), 306);
    f = f + chk(eq64(std.math.cos(nz), P1), 307);
    f = f + chk(is_nan64(std.math.cos(inf)), 308);
    f = f + chk(is_nan64(std.math.cos(nan)), 309);
    f = f + chk(eq64(std.math.tan(pz), PZ), 310);
    f = f + chk(eq64(std.math.tan(nz), NZ), 311);
    f = f + chk(is_nan64(std.math.tan(inf)), 312);
    f = f + chk(is_nan64(std.math.tan(nan)), 313);
    // exactly representable consequences
    f = f + chk(eq64(std.math.sin(1.0e-300), 0x01A5_6E1F_C2F8_F359u64), 314);
    f = f + chk(eq64(std.math.sin(5.0e-324), 0x0000_0000_0000_0001u64), 315);
    f = f + chk(eq64(std.math.cos(1.0e-300), P1), 316);
    f = f + chk(eq64(std.math.tan(5.0e-324), 0x0000_0000_0000_0001u64), 317);
    f = f + chk(eq64(std.math.sin(std.math.PI), 0x3CA1_A626_3314_5C07u64), 318);
    f = f + chk(eq64(std.math.cos(std.math.FRAC_PI_2), 0x3C91_A626_3314_5C07u64), 319);
    f = f + chk(eq64(std.math.cos(std.math.PI), N1), 320);
    f = f + chk(eq64(std.math.tan(std.math.FRAC_PI_4), 0x3FEF_FFFF_FFFF_FFFFu64), 321);
    f = f + chk(eq64(std.math.sin(1.0e22), 0xBFEB_453A_B76B_F397u64), 322);
    f = f + chk(eq64(std.math.cos(1.0e22), 0x3FE0_BE2C_EF01_C8F4u64), 323);
    f = f + chk(eq64(std.math.sin(1.7976931348623157e308), 0x3F74_52FC_98B3_4E97u64), 324);
    let sc = std.math.sincos(0.5);
    f = f + chk(eq64(sc.0, 0x3FDE_AEE8_744B_05F0u64), 325);
    f = f + chk(eq64(sc.1, 0x3FEC_1528_065B_7D50u64), 326);
    let sc0 = std.math.sincos(nz);
    f = f + chk(eq64(sc0.0, NZ), 327);
    f = f + chk(eq64(sc0.1, P1), 328);
    let scn = std.math.sincos(inf);
    f = f + chk(is_nan64(scn.0) && is_nan64(scn.1), 329);
    // inverse functions
    f = f + chk(eq64(std.math.asin(pz), PZ), 330);
    f = f + chk(eq64(std.math.asin(nz), NZ), 331);
    f = f + chk(is_nan64(std.math.asin(1.0000000000000002)), 332);
    f = f + chk(is_nan64(std.math.asin(-2.0)), 333);
    f = f + chk(is_nan64(std.math.asin(nan)), 334);
    f = f + chk(eq64(std.math.asin(1.0), HALF_PI), 335);
    f = f + chk(eq64(std.math.asin(-1.0), HALF_PI | NZ), 336);
    f = f + chk(eq64(std.math.acos(1.0), PZ), 337);
    f = f + chk(eq64(std.math.acos(-1.0), PI_BITS), 338);
    f = f + chk(eq64(std.math.acos(pz), HALF_PI), 339);
    f = f + chk(eq64(std.math.acos(nz), HALF_PI), 340);
    f = f + chk(is_nan64(std.math.acos(1.5)), 341);
    f = f + chk(is_nan64(std.math.acos(nan)), 342);
    f = f + chk(eq64(std.math.atan(pz), PZ), 343);
    f = f + chk(eq64(std.math.atan(nz), NZ), 344);
    f = f + chk(eq64(std.math.atan(inf), HALF_PI), 345);
    f = f + chk(eq64(std.math.atan(-inf), HALF_PI | NZ), 346);
    f = f + chk(is_nan64(std.math.atan(nan)), 347);
    f = f + chk(eq64(std.math.atan(1.0), QUARTER_PI), 348);
    f = f + chk(eq64(std.math.atan(5.0e-324), 0x0000_0000_0000_0001u64), 349);
    f = f + chk(eq64(std.math.asin(5.0e-324), 0x0000_0000_0000_0001u64), 350);
    f = f + chk(eq64(std.math.asin(0.5), 0x3FE0_C152_382D_7366u64), 351);
    f = f + chk(eq64(std.math.acos(0.5), 0x3FF0_C152_382D_7366u64), 352);
    f = f + chk(eq64(std.math.acos(-0.5), 0x4000_C152_382D_7366u64), 353);
    f = f + chk(eq64(std.math.atan(1.0e300), HALF_PI), 354);
    f
}

fn t_atan2() -> i32 {
    let mut f: i32 = 0;
    let nan = f64.NAN;
    let inf = f64.INFINITY;
    let pz: f64 = 0.0;
    let nz: f64 = -0.0;
    f = f + chk(eq64(std.math.atan2(pz, pz), PZ), 401);
    f = f + chk(eq64(std.math.atan2(nz, pz), NZ), 402);
    f = f + chk(eq64(std.math.atan2(pz, nz), PI_BITS), 403);
    f = f + chk(eq64(std.math.atan2(nz, nz), PI_BITS | NZ), 404);
    f = f + chk(eq64(std.math.atan2(pz, -1.0), PI_BITS), 405);
    f = f + chk(eq64(std.math.atan2(nz, -1.0), PI_BITS | NZ), 406);
    f = f + chk(eq64(std.math.atan2(pz, 1.0), PZ), 407);
    f = f + chk(eq64(std.math.atan2(nz, 1.0), NZ), 408);
    f = f + chk(eq64(std.math.atan2(1.0, pz), HALF_PI), 409);
    f = f + chk(eq64(std.math.atan2(1.0, nz), HALF_PI), 410);
    f = f + chk(eq64(std.math.atan2(-1.0, pz), HALF_PI | NZ), 411);
    f = f + chk(eq64(std.math.atan2(-1.0, nz), HALF_PI | NZ), 412);
    f = f + chk(eq64(std.math.atan2(inf, inf), QUARTER_PI), 413);
    f = f + chk(eq64(std.math.atan2(-inf, inf), QUARTER_PI | NZ), 414);
    f = f + chk(eq64(std.math.atan2(inf, -inf), THREE_QUARTER_PI), 415);
    f = f + chk(eq64(std.math.atan2(-inf, -inf), THREE_QUARTER_PI | NZ), 416);
    f = f + chk(eq64(std.math.atan2(inf, 1.0), HALF_PI), 417);
    f = f + chk(eq64(std.math.atan2(-inf, -1.0), HALF_PI | NZ), 418);
    f = f + chk(eq64(std.math.atan2(1.0, inf), PZ), 419);
    f = f + chk(eq64(std.math.atan2(-1.0, inf), NZ), 420);
    f = f + chk(eq64(std.math.atan2(1.0, -inf), PI_BITS), 421);
    f = f + chk(eq64(std.math.atan2(-1.0, -inf), PI_BITS | NZ), 422);
    f = f + chk(is_nan64(std.math.atan2(nan, 1.0)), 423);
    f = f + chk(is_nan64(std.math.atan2(1.0, nan)), 424);
    f = f + chk(eq64(std.math.atan2(1.0, 1.0), QUARTER_PI), 425);
    f = f + chk(eq64(std.math.atan2(1.0, -1.0), THREE_QUARTER_PI), 426);
    f = f + chk(eq64(std.math.atan2(-1.0, -1.0), THREE_QUARTER_PI | NZ), 427);
    f = f + chk(eq64(std.math.atan2(-1.0, 1.0), QUARTER_PI | NZ), 428);
    f = f + chk(eq64(std.math.atan2(5.0e-324, 1.0), 0x0000_0000_0000_0001u64), 429);
    f = f + chk(eq64(std.math.atan2(5.0e-324, -1.0), PI_BITS), 430);
    f = f + chk(eq64(std.math.atan2(1.0, 5.0e-324), HALF_PI), 431);
    f = f + chk(eq64(std.math.atan2(1.0e-300, 1.0e300), PZ), 432);
    f = f + chk(eq64(std.math.atan2(1.0e300, 1.0e300), QUARTER_PI), 433);
    f = f + chk(eq64(std.math.atan2(1.0e-310, 1.0e-310), QUARTER_PI), 434);
    f
}

fn t_hyper() -> i32 {
    let mut f: i32 = 0;
    let nan = f64.NAN;
    let inf = f64.INFINITY;
    let pz: f64 = 0.0;
    let nz: f64 = -0.0;
    f = f + chk(eq64(std.math.sinh(pz), PZ), 501);
    f = f + chk(eq64(std.math.sinh(nz), NZ), 502);
    f = f + chk(eq64(std.math.sinh(inf), PINF), 503);
    f = f + chk(eq64(std.math.sinh(-inf), NINF), 504);
    f = f + chk(is_nan64(std.math.sinh(nan)), 505);
    f = f + chk(eq64(std.math.sinh(711.0), PINF), 506);
    f = f + chk(eq64(std.math.sinh(-711.0), NINF), 507);
    f = f + chk(eq64(std.math.sinh(710.4), 0x7FED_A98A_7371_610Bu64), 508);
    f = f + chk(eq64(std.math.cosh(pz), P1), 509);
    f = f + chk(eq64(std.math.cosh(nz), P1), 510);
    f = f + chk(eq64(std.math.cosh(inf), PINF), 511);
    f = f + chk(eq64(std.math.cosh(-inf), PINF), 512);
    f = f + chk(is_nan64(std.math.cosh(nan)), 513);
    f = f + chk(eq64(std.math.cosh(711.0), PINF), 514);
    f = f + chk(eq64(std.math.tanh(pz), PZ), 515);
    f = f + chk(eq64(std.math.tanh(nz), NZ), 516);
    f = f + chk(eq64(std.math.tanh(inf), P1), 517);
    f = f + chk(eq64(std.math.tanh(-inf), N1), 518);
    f = f + chk(is_nan64(std.math.tanh(nan)), 519);
    f = f + chk(eq64(std.math.tanh(30.0), P1), 520);
    f = f + chk(eq64(std.math.tanh(-30.0), N1), 521);
    f = f + chk(eq64(std.math.asinh(pz), PZ), 522);
    f = f + chk(eq64(std.math.asinh(nz), NZ), 523);
    f = f + chk(eq64(std.math.asinh(inf), PINF), 524);
    f = f + chk(eq64(std.math.asinh(-inf), NINF), 525);
    f = f + chk(is_nan64(std.math.asinh(nan)), 526);
    f = f + chk(eq64(std.math.acosh(1.0), PZ), 527);
    f = f + chk(is_nan64(std.math.acosh(0.5)), 528);
    f = f + chk(is_nan64(std.math.acosh(-inf)), 529);
    f = f + chk(eq64(std.math.acosh(inf), PINF), 530);
    f = f + chk(is_nan64(std.math.acosh(nan)), 531);
    f = f + chk(eq64(std.math.atanh(pz), PZ), 532);
    f = f + chk(eq64(std.math.atanh(nz), NZ), 533);
    f = f + chk(eq64(std.math.atanh(1.0), PINF), 534);
    f = f + chk(eq64(std.math.atanh(-1.0), NINF), 535);
    f = f + chk(is_nan64(std.math.atanh(1.5)), 536);
    f = f + chk(is_nan64(std.math.atanh(-inf)), 537);
    f = f + chk(is_nan64(std.math.atanh(nan)), 538);
    f = f + chk(eq64(std.math.erf(pz), PZ), 539);
    f = f + chk(eq64(std.math.erf(nz), NZ), 540);
    f = f + chk(eq64(std.math.erf(inf), P1), 541);
    f = f + chk(eq64(std.math.erf(-inf), N1), 542);
    f = f + chk(is_nan64(std.math.erf(nan)), 543);
    f = f + chk(eq64(std.math.erf(7.0), P1), 544);
    f = f + chk(eq64(std.math.erf(1.0e-310), 0x0000_14C5_8989_77C4u64), 545);
    f = f + chk(eq64(std.math.erfc(inf), PZ), 546);
    f = f + chk(eq64(std.math.erfc(-inf), 0x4000_0000_0000_0000u64), 547);
    f = f + chk(is_nan64(std.math.erfc(nan)), 548);
    f = f + chk(eq64(std.math.erfc(pz), P1), 549);
    f = f + chk(eq64(std.math.erfc(nz), P1), 550);
    f = f + chk(eq64(std.math.erfc(28.0), PZ), 551);
    f = f + chk(eq64(std.math.erfc(-7.0), 0x4000_0000_0000_0000u64), 552);
    f = f + chk(eq64(std.math.erfc(26.0), 0x02A2_84BF_E1CD_EA24u64), 553);
    f
}

fn main() -> i32 {
    let bad = t_exp_log() + t_pow() + t_roots() + t_trig() + t_atan2() + t_hyper();
    if bad == 0 {
        print("ok math special_values\n");
        return 0;
    }
    1
}
