// test: run
// modes: interp native
// timeout: 600
// covers: REQ-SIMD-142, REQ-SIMD-143, REQ-SIMD-304, REQ-SIMD-305, REQ-SIMD-186, REQ-SIMD-187, REQ-SIMD-189
// flags: --step-limit 4000000000
// stdout: ok math f32_special\n

// T461: the f32 variants of std.math: special values (SPEC-41 AXS-FLT-064), overflow and underflow thresholds of f32
// and exact reference results (correctly rounded mpmath values converted to f32) for named arguments. Bit for bit.

module test.math_f32_special

use std.math

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

fn eq(x: f32, bits: u32) -> bool {
    x.to_bits() == bits
}

fn nan(x: f32) -> bool {
    x != x
}

fn t_specials() -> i32 {
    let mut f: i32 = 0;
    let inf = f32.INFINITY;
    let qnan = f32.NAN;
    let pz: f32 = 0.0;
    let nz: f32 = -0.0;
    f = f + chk(eq(std.math.exp_f32(pz), 0x3F80_0000u32), 1);
    f = f + chk(eq(std.math.exp_f32(inf), 0x7F80_0000u32), 2);
    f = f + chk(eq(std.math.exp_f32(-inf), 0u32), 3);
    f = f + chk(nan(std.math.exp_f32(qnan)), 4);
    f = f + chk(eq(std.math.exp_f32(89.0), 0x7F80_0000u32), 5);
    f = f + chk(eq(std.math.exp_f32(-104.0), 0u32), 6);
    f = f + chk(eq(std.math.exp2_f32(128.0), 0x7F80_0000u32), 7);
    f = f + chk(eq(std.math.exp2_f32(-149.0), 0x0000_0001u32), 8);
    f = f + chk(eq(std.math.exp2_f32(-150.0), 0u32), 9);
    f = f + chk(eq(std.math.expm1_f32(nz), 0x8000_0000u32), 10);
    f = f + chk(eq(std.math.expm1_f32(-inf), 0xBF80_0000u32), 11);
    f = f + chk(eq(std.math.ln_f32(1.0), 0u32), 12);
    f = f + chk(eq(std.math.ln_f32(pz), 0xFF80_0000u32), 13);
    f = f + chk(nan(std.math.ln_f32(-1.0)), 14);
    f = f + chk(eq(std.math.ln_f32(inf), 0x7F80_0000u32), 15);
    f = f + chk(eq(std.math.log2_f32(1.4e-45), 0xC315_0000u32), 16);
    f = f + chk(eq(std.math.log10_f32(1000.0), 0x4040_0000u32), 17);
    f = f + chk(eq(std.math.ln_1p_f32(nz), 0x8000_0000u32), 18);
    f = f + chk(eq(std.math.ln_1p_f32(-1.0), 0xFF80_0000u32), 19);
    f = f + chk(nan(std.math.ln_1p_f32(-2.0)), 20);
    f = f + chk(eq(std.math.log_f32(81.0, 3.0), 0x4080_0000u32), 21);
    f = f + chk(eq(std.math.sin_f32(nz), 0x8000_0000u32), 22);
    f = f + chk(nan(std.math.sin_f32(inf)), 23);
    f = f + chk(eq(std.math.cos_f32(pz), 0x3F80_0000u32), 24);
    f = f + chk(nan(std.math.cos_f32(-inf)), 25);
    f = f + chk(eq(std.math.tan_f32(nz), 0x8000_0000u32), 26);
    f = f + chk(nan(std.math.tan_f32(qnan)), 27);
    f = f + chk(eq(std.math.asin_f32(nz), 0x8000_0000u32), 28);
    f = f + chk(nan(std.math.asin_f32(1.5)), 29);
    f = f + chk(eq(std.math.acos_f32(1.0), 0u32), 30);
    f = f + chk(nan(std.math.acos_f32(-1.5)), 31);
    f = f + chk(eq(std.math.atan_f32(inf), 0x3FC9_0FDBu32), 32);
    f = f + chk(eq(std.math.atan_f32(-inf), 0xBFC9_0FDBu32), 33);
    f = f + chk(eq(std.math.atan2_f32(pz, -1.0), 0x4049_0FDBu32), 34);
    f = f + chk(eq(std.math.atan2_f32(nz, -1.0), 0xC049_0FDBu32), 35);
    f = f + chk(eq(std.math.atan2_f32(1.0, pz), 0x3FC9_0FDBu32), 36);
    f = f + chk(eq(std.math.atan2_f32(inf, inf), 0x3F49_0FDBu32), 37);
    f = f + chk(eq(std.math.atan2_f32(-inf, -inf), 0xC016_CBE4u32), 38);
    f = f + chk(eq(std.math.sinh_f32(nz), 0x8000_0000u32), 39);
    f = f + chk(eq(std.math.sinh_f32(inf), 0x7F80_0000u32), 40);
    f = f + chk(eq(std.math.cosh_f32(-inf), 0x7F80_0000u32), 41);
    f = f + chk(eq(std.math.cosh_f32(89.0), 0x7F28_E166u32), 42);
    f = f + chk(eq(std.math.cosh_f32(90.0), 0x7F80_0000u32), 43);
    f = f + chk(eq(std.math.tanh_f32(-inf), 0xBF80_0000u32), 44);
    f = f + chk(eq(std.math.asinh_f32(nz), 0x8000_0000u32), 45);
    f = f + chk(eq(std.math.acosh_f32(1.0), 0u32), 46);
    f = f + chk(nan(std.math.acosh_f32(0.5)), 47);
    f = f + chk(eq(std.math.atanh_f32(1.0), 0x7F80_0000u32), 48);
    f = f + chk(nan(std.math.atanh_f32(1.5)), 49);
    f = f + chk(eq(std.math.erf_f32(-inf), 0xBF80_0000u32), 50);
    f = f + chk(eq(std.math.erfc_f32(inf), 0u32), 51);
    f = f + chk(eq(std.math.erfc_f32(-inf), 0x4000_0000u32), 52);
    f = f + chk(eq(std.math.cbrt_f32(nz), 0x8000_0000u32), 53);
    f = f + chk(eq(std.math.cbrt_f32(-27.0), 0xC040_0000u32), 54);
    f = f + chk(eq(std.math.hypot_f32(inf, qnan), 0x7F80_0000u32), 55);
    f = f + chk(eq(std.math.hypot_f32(3.0, 4.0), 0x40A0_0000u32), 56);
    f = f + chk(eq(std.math.hypot_f32(3.0e38, 3.0e38), 0x7F80_0000u32), 57);
    f = f + chk(eq(std.math.powf_f32(qnan, pz), 0x3F80_0000u32), 58);
    f = f + chk(eq(std.math.powf_f32(1.0, qnan), 0x3F80_0000u32), 59);
    f = f + chk(eq(std.math.powf_f32(nz, -3.0), 0xFF80_0000u32), 60);
    f = f + chk(nan(std.math.powf_f32(-8.0, 0.5)), 61);
    f = f + chk(eq(std.math.powf_f32(2.0, 128.0), 0x7F80_0000u32), 62);
    f = f + chk(eq(std.math.powf_f32(2.0, -149.0), 0x0000_0001u32), 63);
    f = f + chk(eq(std.math.powf_f32(-2.0, 3.0), 0xC100_0000u32), 64);
    f = f + chk(eq(std.math.powi_f32(qnan, 0), 0x3F80_0000u32), 65);
    f = f + chk(eq(std.math.powi_f32(2.0, -3), 0x3E00_0000u32), 66);
    f = f + chk(eq(std.math.powi_f32(10.0, 38), 0x7E96_7699u32), 67);
    f = f + chk(eq(std.math.powi_f32(10.0, 39), 0x7F80_0000u32), 68);
    f
}

fn t_references() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(eq(std.math.exp_f32(88.0), 0x7EF8_82B7u32), 101);
    f = f + chk(eq(std.math.exp_f32(-87.0), 0x00B3_3687u32), 102);
    f = f + chk(eq(std.math.exp_f32(-103.0), 0x0000_0001u32), 103);
    f = f + chk(eq(std.math.exp_f32(1.0), 0x402D_F854u32), 104);
    f = f + chk(eq(std.math.ln_f32(2.0), 0x3F31_7218u32), 105);
    f = f + chk(eq(std.math.sin_f32(1.0), 0x3F57_6AA4u32), 106);
    f = f + chk(eq(std.math.cos_f32(1.0), 0x3F0A_5140u32), 107);
    f = f + chk(eq(std.math.tan_f32(1.0), 0x3FC7_5923u32), 108);
    f = f + chk(eq(std.math.sin_f32(3.4028234663852886e38), 0xBF05_99B3u32), 109);
    f = f + chk(eq(std.math.cos_f32(3.4028234663852886e38), 0x3F5A_5F96u32), 110);
    f = f + chk(eq(std.math.atan_f32(1.0), 0x3F49_0FDBu32), 111);
    f = f + chk(eq(std.math.atan2_f32(1.0, -1.0), 0x4016_CBE4u32), 112);
    f = f + chk(eq(std.math.asin_f32(0.5), 0x3F06_0A92u32), 113);
    f = f + chk(eq(std.math.acos_f32(0.5), 0x3F86_0A92u32), 114);
    f = f + chk(eq(std.math.sinh_f32(1.0), 0x3F96_6CFEu32), 115);
    f = f + chk(eq(std.math.tanh_f32(0.5), 0x3EEC_9A9Fu32), 116);
    f = f + chk(eq(std.math.asinh_f32(1.0), 0x3F61_A1B3u32), 117);
    f = f + chk(eq(std.math.acosh_f32(2.0), 0x3FA8_9214u32), 118);
    f = f + chk(eq(std.math.atanh_f32(0.5), 0x3F0C_9F54u32), 119);
    f = f + chk(eq(std.math.erf_f32(1.0), 0x3F57_BB3Du32), 120);
    f = f + chk(eq(std.math.erfc_f32(1.0), 0x3E21_130Bu32), 121);
    f = f + chk(eq(std.math.erfc_f32(10.0), 0x0000_0001u32), 122);
    f = f + chk(eq(std.math.cbrt_f32(2.0), 0x3FA1_4518u32), 123);
    f = f + chk(eq(std.math.powf_f32(2.0, 0.5), 0x3FB5_04F3u32), 124);
    f = f + chk(eq(std.math.powi_f32(1.1, 10), 0x4025_FFE3u32), 125);
    f = f + chk(eq(std.math.expm1_f32(1.0e-3), 0x3A83_2337u32), 126);
    f = f + chk(eq(std.math.ln_1p_f32(1.0e-3), 0x3A83_01ABu32), 127);
    f
}

fn main() -> i32 {
    let bad = t_specials() + t_references();
    if bad == 0 {
        print("ok math f32_special\n");
        return 0;
    }
    1
}
