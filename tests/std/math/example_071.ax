// test: run
// modes: interp native
// timeout: 120
// covers: REQ-SIMD-189, REQ-SIMD-186, REQ-SIMD-187, REQ-SIMD-142
// stdout: ok math example_071\n

// T461: the canonical positive example AXS-FLT-071 of SPEC-41 (mixed integer / f32 / f64 promotion, saturating
// casts, signed zero and NaN, and std.math through the `use std.math` import), with every claim of its comments
// checked at run time.

module test.math_example_071

use std.math
use std.core.cmp.Ordering

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

// `==` on the enum Ordering needs the PartialEq impl of a user enum (T460 follow-up 1): match instead.
fn is_greater(o: Ordering) -> bool {
    match o {
        Ordering.Less => false,
        Ordering.Equal => false,
        Ordering.Greater => true,
    }
}

pub fn demo_ieee754_and_mixed_promotion(i: i32, k: i16) -> f64 {
    // 1. Concrete integer and unsuffixed literals promote to float peer in binary expressions (AXS-FLT-031..032)
    let x: f64 = 1.5
    let y = x + i * k - 1

    // 2. f32 -> f64 widening promotion in binary expression (AXS-FLT-031)
    let a: f32 = 0.5f32
    let z = (a + 0.5) + y

    // 3. Saturating FloatToInt cast (AXS-FLT-022)
    let sat_max: u8 = 999.9f64 as u8
    let sat_nan: i32 = f64.NAN as i32
    let sat_neg: u32 = (-42.0f64) as u32

    // 4. Signed zero and NaN behavior (AXS-FLT-012, AXS-FLT-013, AXS-FLT-020, AXS-FLT-021)
    let neg_zero = -0.0f64
    let mut bad: i32 = 0
    bad = bad + chk(neg_zero == 0.0f64, 1)
    bad = bad + chk((1.0 / neg_zero) == f64.NEG_INFINITY, 2)
    bad = bad + chk(f64.NAN != f64.NAN, 3)
    bad = bad + chk(is_greater(f64.NAN.total_cmp(1.0)), 4)
    bad = bad + chk(sat_max == 255u8, 5)
    bad = bad + chk(sat_nan == 0, 6)
    bad = bad + chk(sat_neg == 0u32, 7)
    bad = bad + chk(z == 7.5, 8)

    // 5. Deterministic std.math (AXS-FLT-060..064)
    let angle = std.math.FRAC_PI_4
    let h = std.math.hypot(3.0, 4.0)
    let c = std.math.cos(angle) * std.math.SQRT_2
    bad = bad + chk(h == 5.0, 9)
    bad = bad + chk((c - 1.0).abs() < 4.0e-16, 10)
    bad = bad + chk((std.math.cos(angle) - std.math.sin(angle)).abs() < 2.0e-16, 11)

    if bad != 0 {
        return -1.0
    }
    z + (sat_max as f64) + (sat_nan as f64) + (sat_neg as f64) + h + c
}

fn main() -> i32 {
    let r = demo_ieee754_and_mixed_promotion(2, 3);
    // 7.5 + 255 + 0 + 0 + 5 + c, with c = 1.0000000000000002
    if (r - 268.5).abs() < 1.0e-12 {
        print("ok math example_071\n");
        return 0;
    }
    print("FAIL result ");
    print_int((r * 1000.0) as i64);
    print("\n");
    1
}
