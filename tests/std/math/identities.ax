// test: run
// modes: interp native
// timeout: 900
// covers: REQ-SIMD-142, REQ-SIMD-143, REQ-SIMD-304, REQ-SIMD-305, REQ-SIMD-186, REQ-SIMD-187, REQ-SIMD-189
// flags: --step-limit 4000000000
// stdout: ok math identities\n

// T461: mathematical identities of std.math on a deterministic input grid, f64 and f32: the odd / even symmetries
// of SPEC-41 AXS-FLT-064 hold bit for bit, inverse pairs and Pythagorean-type relations hold within a few ulp,
// monotonicity holds on a fine grid, and the exact cases (powers of two, powers of ten, squares) are exact.

module test.math_identities

use std.math

fn fail(id: i32, i: usize) -> i32 {
    print("FAIL ");
    print_int(id as i64);
    print(" #");
    print_int(i as i64);
    print("\n");
    1
}

// Distance in ulps of two finite doubles of the same sign (bit pattern difference).
fn ulps(a: f64, b: f64) -> u64 {
    let x = a.to_bits();
    let y = b.to_bits();
    if (x >> 63u32) != (y >> 63u32) {
        return 1000000000000u64;
    }
    if x > y { x - y } else { y - x }
}

fn ulps32(a: f32, b: f32) -> u32 {
    let x = a.to_bits();
    let y = b.to_bits();
    if (x >> 31u32) != (y >> 31u32) {
        return 1000000000u32;
    }
    if x > y { x - y } else { y - x }
}

// Linear congruential generator over 31 bits, and a uniform value in [lo, hi).
fn next(s: u64) -> u64 {
    (s * 1103515245u64 + 12345u64) % 2147483648u64
}

fn uni(s: u64, lo: f64, hi: f64) -> f64 {
    lo + (hi - lo) * ((s as f64) / 2147483648.0)
}

fn neg_eq(a: f64, b: f64) -> bool {
    // a == -b bit for bit (NaN matches NaN)
    if a != a && b != b {
        return true;
    }
    a.to_bits() == (-b).to_bits()
}

fn same(a: f64, b: f64) -> bool {
    if a != a && b != b {
        return true;
    }
    a.to_bits() == b.to_bits()
}

fn t_symmetry() -> i32 {
    let mut bad: i32 = 0;
    let mut s: u64 = 12345u64;
    let mut i: usize = 0;
    while i < 40 {
        s = next(s);
        let x = uni(s, 0.0, 8.0);
        s = next(s);
        let u = uni(s, 0.0, 1.0);
        let w = uni(s, 1.0, 1000.0);
        if !neg_eq(std.math.sin(x), std.math.sin(-x)) { bad = bad + fail(1, i); }
        if !same(std.math.cos(x), std.math.cos(-x)) { bad = bad + fail(2, i); }
        if !neg_eq(std.math.tan(x), std.math.tan(-x)) { bad = bad + fail(3, i); }
        if !neg_eq(std.math.atan(x), std.math.atan(-x)) { bad = bad + fail(4, i); }
        if !neg_eq(std.math.asin(u), std.math.asin(-u)) { bad = bad + fail(5, i); }
        if !neg_eq(std.math.sinh(x), std.math.sinh(-x)) { bad = bad + fail(6, i); }
        if !same(std.math.cosh(x), std.math.cosh(-x)) { bad = bad + fail(7, i); }
        if !neg_eq(std.math.tanh(x), std.math.tanh(-x)) { bad = bad + fail(8, i); }
        if !neg_eq(std.math.asinh(x), std.math.asinh(-x)) { bad = bad + fail(9, i); }
        if !neg_eq(std.math.atanh(u), std.math.atanh(-u)) { bad = bad + fail(10, i); }
        if !neg_eq(std.math.erf(x), std.math.erf(-x)) { bad = bad + fail(11, i); }
        if !neg_eq(std.math.cbrt(w), std.math.cbrt(-w)) { bad = bad + fail(12, i); }
        if !neg_eq(std.math.atan2(x, w), std.math.atan2(-x, w)) { bad = bad + fail(13, i); }
        if !same(std.math.atan2(x, w), std.math.atan2(x, w)) { bad = bad + fail(14, i); }
        if !same(std.math.hypot(x, w), std.math.hypot(w, x)) { bad = bad + fail(15, i); }
        if !same(std.math.hypot(x, w), std.math.hypot(-x, -w)) { bad = bad + fail(16, i); }
        i = i + 1;
    }
    bad
}

fn t_inverse_pairs() -> i32 {
    let mut bad: i32 = 0;
    let mut s: u64 = 777u64;
    let mut i: usize = 0;
    while i < 16 {
        s = next(s);
        let x = uni(s, 0.001, 700.0);
        s = next(s);
        let y = uni(s, -5.0, 5.0);
        s = next(s);
        let u = uni(s, 0.01, 0.99);
        // exp(ln x) and ln(exp y)
        if ulps(std.math.exp(std.math.ln(x)), x) > 8u64 { bad = bad + fail(21, i); }
        let l = std.math.ln(std.math.exp(y));
        if (l - y).abs() > 4.0e-16 * (1.0 + y.abs()) { bad = bad + fail(22, i); }
        // exp2 / log2, exp10 through powf
        if (std.math.log2(std.math.exp2(y)) - y).abs() > 4.0e-16 * (1.0 + y.abs()) { bad = bad + fail(23, i); }
        // sin^2 + cos^2 = 1
        let sc = std.math.sincos(x);
        if (sc.0 * sc.0 + sc.1 * sc.1 - 1.0).abs() > 3.0e-16 { bad = bad + fail(24, i); }
        if !same(sc.0, std.math.sin(x)) || !same(sc.1, std.math.cos(x)) { bad = bad + fail(25, i); }
        // tan = sin / cos
        if ulps(std.math.tan(x), sc.0 / sc.1) > 3u64 { bad = bad + fail(26, i); }
        // asin(sin) / acos(cos) / atan(tan) on the principal range
        if (std.math.asin(std.math.sin(u)) - u).abs() > 3.0e-16 { bad = bad + fail(27, i); }
        if (std.math.acos(std.math.cos(u)) - u).abs() > 3.0e-16 / std.math.sin(u) { bad = bad + fail(28, i); }
        if (std.math.atan(std.math.tan(u)) - u).abs() > 3.0e-16 { bad = bad + fail(29, i); }
        // asin + acos = pi / 2
        if (std.math.asin(u) + std.math.acos(u) - std.math.FRAC_PI_2).abs() > 3.0e-16 { bad = bad + fail(30, i); }
        // sinh / cosh / tanh
        let ch = std.math.cosh(y);
        let sh = std.math.sinh(y);
        if (ch * ch - sh * sh - 1.0).abs() > 1.0e-13 * ch * ch { bad = bad + fail(31, i); }
        if ulps(std.math.tanh(y), sh / ch) > 4u64 { bad = bad + fail(32, i); }
        if (std.math.asinh(sh) - y).abs() > 1.0e-15 * (1.0 + y.abs()) { bad = bad + fail(33, i); }
        if (std.math.acosh(ch) - y.abs()).abs() > 1.0e-7 { bad = bad + fail(34, i); }
        if (std.math.atanh(std.math.tanh(u)) - u).abs() > 1.0e-15 { bad = bad + fail(35, i); }
        // expm1 / ln_1p
        if ulps(std.math.ln_1p(std.math.expm1(u)), u) > 4u64 { bad = bad + fail(36, i); }
        if ulps(std.math.expm1(std.math.ln_1p(u)), u) > 4u64 { bad = bad + fail(37, i); }
        // erf + erfc = 1
        if (std.math.erf(y) + std.math.erfc(y) - 1.0).abs() > 3.0e-16 { bad = bad + fail(38, i); }
        if (std.math.erfc(y) + std.math.erfc(-y) - 2.0).abs() > 3.0e-16 { bad = bad + fail(39, i); }
        // cbrt
        if ulps(std.math.cbrt(x * x * x), x) > 3u64 { bad = bad + fail(40, i); }
        // log of any base
        if (std.math.log(x, 7.0) - std.math.ln(x) / std.math.ln(7.0)).abs() > 1.0e-15 * (1.0 + std.math.ln(x).abs()) { bad = bad + fail(41, i); }
        i = i + 1;
    }
    bad
}

fn t_exact() -> i32 {
    let mut bad: i32 = 0;
    // powers of two: exp2, log2, powi, powf and ldexp agree exactly over the whole range
    let mut n: i32 = -1074;
    while n <= 1023 {
        let p = std.math.ldexp(1.0, n);
        if !same(std.math.exp2(n as f64), p) { bad = bad + fail(51, n as usize); }
        if !same(std.math.log2(p), n as f64) { bad = bad + fail(52, n as usize); }
        if !same(std.math.powi(2.0, n), p) { bad = bad + fail(53, n as usize); }
        if !same(std.math.powf(2.0, n as f64), p) { bad = bad + fail(54, n as usize); }
        n = n + 37;
    }
    // powers of ten up to 22 are exact, 10^23 is the nearest double
    let mut k: i32 = 0;
    let mut t: f64 = 1.0;
    while k <= 22 {
        if !same(std.math.powi(10.0, k), t) { bad = bad + fail(55, k as usize); }
        if !same(std.math.powf(10.0, k as f64), t) { bad = bad + fail(56, k as usize); }
        if !same(std.math.log10(t), k as f64) { bad = bad + fail(57, k as usize); }
        t = t * 10.0;
        k = k + 1;
    }
    // squares, square roots and cubes of small integers
    let mut j: i32 = 1;
    while j <= 40 {
        let x = j as f64;
        if !same(std.math.powf(x, 2.0), x * x) { bad = bad + fail(58, j as usize); }
        if !same(std.math.powi(x, 3), x * x * x) { bad = bad + fail(59, j as usize); }
        if !same(std.math.cbrt(x * x * x), x) { bad = bad + fail(60, j as usize); }
        if !same(std.math.powf(x * x, 0.5), x) { bad = bad + fail(61, j as usize); }
        if !same(std.math.hypot(3.0 * x, 4.0 * x), 5.0 * x) { bad = bad + fail(62, j as usize); }
        j = j + 1;
    }
    bad
}

fn t_monotonic() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    let mut pe = std.math.exp(-30.0);
    let mut pl = std.math.ln(0.001);
    let mut pa = std.math.atan(-20.0);
    let mut ph = std.math.erf(-5.0);
    let mut pt = std.math.tanh(-10.0);
    while i < 400 {
        let x = -30.0 + 0.15 * (i as f64);
        let e = std.math.exp(x);
        if e < pe { bad = bad + fail(71, i); }
        pe = e;
        let y = 0.001 + 0.05 * (i as f64);
        let l = std.math.ln(y);
        if l < pl { bad = bad + fail(72, i); }
        pl = l;
        let z = -20.0 + 0.1 * (i as f64);
        let a = std.math.atan(z);
        if a < pa { bad = bad + fail(73, i); }
        pa = a;
        let w = -5.0 + 0.025 * (i as f64);
        let h = std.math.erf(w);
        if h < ph { bad = bad + fail(74, i); }
        ph = h;
        let v = -10.0 + 0.05 * (i as f64);
        let tt = std.math.tanh(v);
        if tt < pt { bad = bad + fail(75, i); }
        pt = tt;
        i = i + 1;
    }
    bad
}

fn t_f32() -> i32 {
    let mut bad: i32 = 0;
    let mut s: u64 = 4242u64;
    let mut i: usize = 0;
    while i < 30 {
        s = next(s);
        let x = uni(s, 0.01, 20.0) as f32;
        s = next(s);
        let y = uni(s, -3.0, 3.0) as f32;
        // odd and even symmetry
        if std.math.sin_f32(-x).to_bits() != (-std.math.sin_f32(x)).to_bits() { bad = bad + fail(81, i); }
        if std.math.cos_f32(-x).to_bits() != std.math.cos_f32(x).to_bits() { bad = bad + fail(82, i); }
        if std.math.tanh_f32(-y).to_bits() != (-std.math.tanh_f32(y)).to_bits() { bad = bad + fail(83, i); }
        // f32 results are the f64 results rounded once
        if std.math.exp_f32(y).to_bits() != (std.math.exp(y as f64) as f32).to_bits() { bad = bad + fail(84, i); }
        if std.math.sin_f32(x).to_bits() != (std.math.sin(x as f64) as f32).to_bits() { bad = bad + fail(85, i); }
        if std.math.powf_f32(x, y).to_bits() != (std.math.powf(x as f64, y as f64) as f32).to_bits() { bad = bad + fail(86, i); }
        // inverse pairs
        if ulps32(std.math.exp_f32(std.math.ln_f32(x)), x) > 2u32 { bad = bad + fail(87, i); }
        let sc = std.math.sincos_f32(x);
        if (sc.0 * sc.0 + sc.1 * sc.1 - 1.0).abs() > 4.0e-7 { bad = bad + fail(88, i); }
        if ulps32(std.math.cbrt_f32(x * x * x), x) > 3u32 { bad = bad + fail(89, i); }
        if std.math.hypot_f32(3.0, 4.0).to_bits() != 0x40A0_0000u32 { bad = bad + fail(90, i); }
        if std.math.powi_f32(x, 2).to_bits() != (x * x).to_bits() { bad = bad + fail(91, i); }
        i = i + 1;
    }
    bad
}

fn main() -> i32 {
    let bad = t_symmetry() + t_inverse_pairs() + t_exact() + t_monotonic() + t_f32();
    if bad == 0 {
        print("ok math identities\n");
        return 0;
    }
    1
}
