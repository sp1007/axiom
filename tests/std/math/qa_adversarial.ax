// test: run
// modes: interp native
// timeout: 600
// covers: REQ-SIMD-142, REQ-SIMD-143, REQ-SIMD-304, REQ-SIMD-305
// flags: --step-limit 4000000000
// stdout: ok math qa_adversarial\n

// T461 QA (gate round 0): adversarial inputs chosen independently of the engineer's generator: trigonometric arguments
// in [2^52, 2^54) (the Payne-Hanek out-of-bounds fix), near multiples of pi/2, huge arguments, the classic worst case
// 6381956970095103 * 2^797, subnormal and near-overflow arguments of the exponential / logarithm family, f32 rounding
// seams and C99 Annex F special values. Expected bits are correctly rounded 400-bit mpmath results (generated by the
// QA script, values in hex); a result passes within 1 ulp (SPEC-41 AXS-FLT-063), exact-match lists are marked.

module test.math_qa_adversarial

use std.math

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

fn dist(a: u64, b: u64) -> u64 {
    if a >= b {
        return a - b;
    }
    b - a
}

// within 1 ulp (same sign, bit patterns at most 1 apart); NaN matches NaN
fn near(got: f64, want: u64) -> bool {
    let wf = f64.from_bits(want);
    if wf != wf {
        return got != got;
    }
    if got != got {
        return false;
    }
    let g = got.to_bits();
    if g == want {
        return true;
    }
    if (g >> 63u32) != (want >> 63u32) {
        return false;
    }
    dist(g, want) <= 1u64
}

fn exact(got: f64, want: u64) -> bool {
    got.to_bits() == want
}

fn near32(got: f32, want: u32) -> bool {
    let g = got.to_bits();
    if g == want {
        return true;
    }
    if (g >> 31u32) != (want >> 31u32) {
        return false;
    }
    let a = g & 0x7FFF_FFFFu32;
    let b = want & 0x7FFF_FFFFu32;
    if a >= b {
        return a - b <= 1u32;
    }
    b - a <= 1u32
}

