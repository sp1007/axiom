// test: run
// modes: interp native
// timeout: 900
// covers: REQ-SIMD-142, REQ-SIMD-143, REQ-SIMD-304, REQ-SIMD-305, REQ-SIMD-186, REQ-SIMD-187, REQ-SIMD-189
// flags: --step-limit 4000000000
// stdout: ok math vec_log_f64\n

// T461: std.math log functions, f64. Inputs come from a portable splitmix64 generator, the expected values are the correctly rounded
// results of 300-bit mpmath references (tests/std/math/make_vectors.py); a result passes within 1 ulp (SPEC-41
// AXS-FLT-063). GENERATED, do not edit.

module test.math_vec_log_f64

use std.math

fn near64(got: u64, want: u64) -> bool {
    if got == want {
        return true;
    }
    let g = f64.from_bits(got);
    let w = f64.from_bits(want);
    if g != g && w != w {
        return true;
    }
    if g != g || w != w {
        return false;
    }
    if (got >> 63u32) != (want >> 63u32) {
        return false;
    }
    let d = if got > want { got - want } else { want - got };
    d <= 1u64
}

fn near32(got: u32, want: u32) -> bool {
    if got == want {
        return true;
    }
    let g = f32.from_bits(got);
    let w = f32.from_bits(want);
    if g != g && w != w {
        return true;
    }
    if g != g || w != w {
        return false;
    }
    if (got >> 31u32) != (want >> 31u32) {
        return false;
    }
    let d = if got > want { got - want } else { want - got };
    d <= 1u32
}

