fn run_sin() -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while i < 555 {
        let x = f64.from_bits(T_SIN[2 * i]);
        let got = std.math.sin(x).to_bits();
        if !near64(got, T_SIN[2 * i + 1]) {
            bad = bad + 1;
            print("FAIL sin ");
            print_int(i as i64);
            print("\n");
        }
        i = i + 1;
    }
    bad
}

