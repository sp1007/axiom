// test: run
// modes: interp native
// timeout: 300
// covers: REQ-SIMD-142, REQ-SIMD-189
// stdout: ok math tables_bits\n

// T461: every f64 literal of the generated tables std/math/tables.ax is read by the compiler as the exact double
// (rotate-xor checksum of the bit patterns against mathtables.py, which rounds mpmath values). GENERATED.

module test.math_tables_bits

use std.math.dd.Dd
use std.math.tables.SINC
use std.math.tables.COSC
use std.math.tables.EXPM1C
use std.math.tables.ATANC
use std.math.tables.ATANHC
use std.math.tables.ATANT
use std.math.tables.LOGT
use std.math.tables.TWO_OVER_PI
use std.math.tables.LN2_HI
use std.math.tables.LN2_MID
use std.math.tables.LN2_LO
use std.math.tables.PI_DD
use std.math.tables.PIO2_DD
use std.math.tables.LN2_DD
use std.math.tables.LOG2E_DD
use std.math.tables.LOG10E_DD
use std.math.tables.LN10_DD
use std.math.tables.TWO_OVER_SQRT_PI_DD
use std.math.tables.ONE_OVER_SQRT_PI_DD

fn mix(h: u64, v: u64) -> u64 {
    ((h << 1u32) | (h >> 63u32)) ^ v
}

fn chk(name: str, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print(name);
    print("\n");
    1
}

fn sum_sinc() -> u64 {
    let mut h: u64 = 0u64;
    let mut i: usize = 0;
    while i < 14 {
        h = mix(h, SINC[i].hi.to_bits());
        h = mix(h, SINC[i].lo.to_bits());
        i = i + 1;
    }
    h
}

fn sum_cosc() -> u64 {
    let mut h: u64 = 0u64;
    let mut i: usize = 0;
    while i < 15 {
        h = mix(h, COSC[i].hi.to_bits());
        h = mix(h, COSC[i].lo.to_bits());
        i = i + 1;
    }
    h
}

fn sum_expm1c() -> u64 {
    let mut h: u64 = 0u64;
    let mut i: usize = 0;
    while i < 11 {
        h = mix(h, EXPM1C[i].hi.to_bits());
        h = mix(h, EXPM1C[i].lo.to_bits());
        i = i + 1;
    }
    h
}

fn sum_atanc() -> u64 {
    let mut h: u64 = 0u64;
    let mut i: usize = 0;
    while i < 8 {
        h = mix(h, ATANC[i].hi.to_bits());
        h = mix(h, ATANC[i].lo.to_bits());
        i = i + 1;
    }
    h
}

fn sum_atanhc() -> u64 {
    let mut h: u64 = 0u64;
    let mut i: usize = 0;
    while i < 8 {
        h = mix(h, ATANHC[i].hi.to_bits());
        h = mix(h, ATANHC[i].lo.to_bits());
        i = i + 1;
    }
    h
}

fn sum_atant() -> u64 {
    let mut h: u64 = 0u64;
    let mut i: usize = 0;
    while i < 17 {
        h = mix(h, ATANT[i].hi.to_bits());
        h = mix(h, ATANT[i].lo.to_bits());
        i = i + 1;
    }
    h
}

fn sum_logt() -> u64 {
    let mut h: u64 = 0u64;
    let mut i: usize = 0;
    while i < 128 {
        h = mix(h, LOGT[i].invc.to_bits());
        h = mix(h, LOGT[i].logc.hi.to_bits());
        h = mix(h, LOGT[i].logc.lo.to_bits());
        i = i + 1;
    }
    h
}

fn sum_two_over_pi() -> u64 {
    let mut h: u64 = 0u64;
    let mut i: usize = 0;
    while i < 21 {
        h = mix(h, TWO_OVER_PI[i]);
        i = i + 1;
    }
    h
}

fn sum_scalars() -> u64 {
    let mut h: u64 = 0u64;
    h = mix(h, LN2_HI.to_bits());
    h = mix(h, LN2_MID.to_bits());
    h = mix(h, LN2_LO.to_bits());
    h = mix(h, PI_DD.hi.to_bits());
    h = mix(h, PI_DD.lo.to_bits());
    h = mix(h, PIO2_DD.hi.to_bits());
    h = mix(h, PIO2_DD.lo.to_bits());
    h = mix(h, LN2_DD.hi.to_bits());
    h = mix(h, LN2_DD.lo.to_bits());
    h = mix(h, LOG2E_DD.hi.to_bits());
    h = mix(h, LOG2E_DD.lo.to_bits());
    h = mix(h, LOG10E_DD.hi.to_bits());
    h = mix(h, LOG10E_DD.lo.to_bits());
    h = mix(h, LN10_DD.hi.to_bits());
    h = mix(h, LN10_DD.lo.to_bits());
    h = mix(h, TWO_OVER_SQRT_PI_DD.hi.to_bits());
    h = mix(h, TWO_OVER_SQRT_PI_DD.lo.to_bits());
    h = mix(h, ONE_OVER_SQRT_PI_DD.hi.to_bits());
    h = mix(h, ONE_OVER_SQRT_PI_DD.lo.to_bits());
    h
}

fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + chk("SINC", sum_sinc(), 0x92EE0433647AB0E3u64);
    f = f + chk("COSC", sum_cosc(), 0x58D0A8956858D2CEu64);
    f = f + chk("EXPM1C", sum_expm1c(), 0x0597E689F5004519u64);
    f = f + chk("ATANC", sum_atanc(), 0xC7B6339484A72D6Cu64);
    f = f + chk("ATANHC", sum_atanhc(), 0x47B6339484A734F5u64);
    f = f + chk("ATANT", sum_atant(), 0xA7BAE62BD4708DF8u64);
    f = f + chk("LOGT", sum_logt(), 0xA406299F185AB918u64);
    f = f + chk("TWO_OVER_PI", sum_two_over_pi(), 0x2B039FEA2B5EF91Fu64);
    f = f + chk("scalars", sum_scalars(), 0x5DE55E4180346360u64);
    if f == 0 {
        print("ok math tables_bits\n");
        return 0;
    }
    1
}
