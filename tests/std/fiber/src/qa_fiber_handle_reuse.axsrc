module main

use std.core.host.fiber_create
use std.core.host.fiber_resume
use std.core.host.fiber_yield
use std.core.host.fiber_destroy

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn entry_done(ctx: *mut u8) -> i64 {
    7i64
}

fn entry_yield(ctx: *mut u8) -> i64 {
    let _a = fiber_yield(5i64);
    9i64
}

// QA (T423 round 1): slot/handle reuse after destroy. Every destroyed handle is dead at once (-4 for
// resume and destroy), the next fiber in the recycled slot gets a different handle, and the generation
// counter can wrap without a failure. Even rounds finish the fiber first, odd rounds destroy it suspended.
pub fn main() -> i32 {
    let mut out: i64 = 0i64;
    let mut i: i64 = 0i64;
    let mut prev: i64 = 0i64;
    let mut distinct: i64 = 0i64;
    let mut stale: i64 = 0i64;
    let mut done: i64 = 0i64;
    let mut suspended: i64 = 0i64;
    while i < 300i64 {
        let even = (i % 2i64) == 0i64;
        let h = unsafe { if even { fiber_create(entry_done, 0 as *mut u8, 0, 0) } else { fiber_create(entry_yield, 0 as *mut u8, 0, 0) } };
        check(h > 0i64);
        if h != prev {
            distinct = distinct + 1i64;
        }
        prev = h;
        let rc = unsafe { fiber_resume(h, 0i64, address_of_mut(out)) };
        if even {
            check(rc == 1i64);
            check(out == 7i64);
            done = done + 1i64;
        } else {
            check(rc == 0i64);
            check(out == 5i64);
            suspended = suspended + 1i64;
        }
        check(fiber_destroy(h) == 0i64);
        let r1 = unsafe { fiber_resume(h, 0i64, address_of_mut(out)) };
        let r2 = fiber_destroy(h);
        if r1 == -4i64 && r2 == -4i64 {
            stale = stale + 1i64;
        }
        i = i + 1i64;
    }
    check(distinct == 300i64);
    check(stale == 300i64);

    print("OK qa_fiber_handle_reuse ");
    print_int(distinct);
    print(" ");
    print_int(stale);
    print(" ");
    print_int(done);
    print(" ");
    print_int(suspended);
    print("\n");
    0
}
