module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.FiberScheduler
use std.fiber.yield_now
use std.fiber.yield_val

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// QA (T423): ownership of values crossing the fiber boundary. Every Guard must be dropped exactly once.
struct Guard {
    pub id: i64,
    pub log: *mut i64,
    pub n: *mut i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        unsafe {
            *(self.log + (*self.n as usize)) = self.id;
            *self.n = *self.n + 1i64;
        }
    }
}

fn consume(g: Guard) -> i64 {
    g.id
}

pub fn main() -> i32 {
    let mut slots: [32]i64 = [0i64; 32];
    let mut count: i64 = 0i64;
    let log: *mut i64 = unsafe { address_of_mut(slots[0]) };
    let n: *mut i64 = unsafe { address_of_mut(count) };

    // 1. A never-started fiber that captured a Guard: dropping the fiber drops the capture exactly once.
    {
        let g = Guard { id: 1i64, log: log, n: n };
        let _f: Fiber<(), i64> = Fiber.new(|| -> i64 { consume(g) });
        check(count == 0i64);
    }
    check(count == 1i64);
    check(slots[0] == 1i64);

    // 2. A Guard yielded to the resumer is dropped once, in the resumer (the transfer cell is not dropped).
    {
        let mut f: Fiber<Guard, i64> = Fiber.new(|| -> i64 {
            yield_val<Guard>(Guard { id: 2i64, log: log, n: n });
            0i64
        });
        match f.resume() {
            FiberState.Yielded(_g) => { check(count == 1i64); },
            FiberState.Completed(_r) => { check(false); },
            FiberState.Panicked => { check(false); },
        }
        match f.resume() {
            FiberState.Yielded(_g) => { check(false); },
            FiberState.Completed(_r) => {},
            FiberState.Panicked => { check(false); },
        }
    }
    check(count == 2i64);

    // 3. A Guard returned as the fiber result is dropped once, by the resumer.
    {
        let mut f: Fiber<(), Guard> = Fiber.new(|| -> Guard {
            yield_now();
            Guard { id: 3i64, log: log, n: n }
        });
        match f.resume() {
            FiberState.Yielded(_u) => {},
            FiberState.Completed(_r) => { check(false); },
            FiberState.Panicked => { check(false); },
        }
        check(count == 2i64);
        match f.resume() {
            FiberState.Yielded(_u) => { check(false); },
            FiberState.Completed(_g) => { check(count == 2i64); },
            FiberState.Panicked => { check(false); },
        }
    }
    check(count == 3i64);

    // 4. A scheduler dropped before it ran: both unstarted closures drop their captured Guard once.
    {
        let g1 = Guard { id: 4i64, log: log, n: n };
        let g2 = Guard { id: 5i64, log: log, n: n };
        let mut sched = FiberScheduler.new();
        sched.spawn(|| { let _x = consume(g1); });
        sched.spawn(|| { let _x = consume(g2); });
        check(count == 3i64);
    }
    check(count == 5i64);

    // 5. A completed fiber whose locals live across yields: reverse order at completion, once.
    {
        let mut f: Fiber<(), i64> = Fiber.new(|| -> i64 {
            let _a = Guard { id: 6i64, log: log, n: n };
            yield_now();
            let _b = Guard { id: 7i64, log: log, n: n };
            yield_now();
            0i64
        });
        match f.resume() { FiberState.Yielded(_u) => {}, FiberState.Completed(_r) => { check(false); }, FiberState.Panicked => { check(false); } }
        match f.resume() { FiberState.Yielded(_u) => {}, FiberState.Completed(_r) => { check(false); }, FiberState.Panicked => { check(false); } }
        check(count == 5i64);
        match f.resume() { FiberState.Yielded(_u) => { check(false); }, FiberState.Completed(_r) => {}, FiberState.Panicked => { check(false); } }
        check(count == 7i64);
    }
    check(count == 7i64);

    print("OK qa_fiber_drop ");
    let mut i: usize = 0;
    while i < 7 {
        print_int(slots[i]);
        i = i + 1;
    }
    print("\n");
    0
}
