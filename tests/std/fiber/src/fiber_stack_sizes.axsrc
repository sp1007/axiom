module main

use std.fiber.Fiber
use std.fiber.FiberBuilder
use std.fiber.FiberState
use std.fiber.yield_val

fn sum_to(n: i64) -> i64 {
    if n == 0i64 {
        return 0i64;
    }
    n + sum_to(n - 1i64)
}

// Recursion that yields at every level on the way back up.
fn climb(n: i64) -> i64 {
    if n == 0i64 {
        return 0i64;
    }
    let r = climb(n - 1i64);
    yield_val(n);
    r + n
}

pub fn main() -> i32 {
    // Explicit budget: 32 KiB committed, 1 MiB reserved.
    let mut big: Fiber<i64, i64> = FiberBuilder.new().stack_size(32768, 1048576).spawn(|| -> i64 {
        sum_to(150i64)
    });
    let mut big_total: i64 = 0i64;
    match big.resume() {
        FiberState.Completed(r) => {
            big_total = r;
        },
        FiberState.Yielded(_v) => {
            check(false);
        },
        FiberState.Panicked => {
            check(false);
        },
    }
    check(view(big).is_completed());

    // Zero means "platform default" (64 KiB / 256 KiB).
    let mut dflt: Fiber<i64, i64> = FiberBuilder.new().stack_size(0, 0).spawn(|| -> i64 {
        climb(100i64)
    });
    let mut yielded_sum: i64 = 0i64;
    let mut result: i64 = 0i64;
    let mut going = true;
    while going {
        match dflt.resume() {
            FiberState.Yielded(v) => {
                yielded_sum = yielded_sum + v;
            },
            FiberState.Completed(r) => {
                result = r;
                going = false;
            },
            FiberState.Panicked => {
                check(false);
                going = false;
            },
        }
    }
    check(result == 5050i64);

    print("OK fiber_stack_sizes ");
    print_int(big_total);
    print(" ");
    print_int(yielded_sum);
    print(" ");
    print_int(result);
    print("\n");
    0
}
