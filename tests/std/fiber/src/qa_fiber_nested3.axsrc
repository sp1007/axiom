module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_val
use std.fiber.yield_now

@thread_local
static mut TLS_VALUE: i64 = 0i64;

fn pull(f: mut_view<Fiber<i64, i64>>) -> i64 {
    match f.resume() {
        FiberState.Yielded(v) => v,
        FiberState.Completed(r) => r + 1000i64,
        FiberState.Panicked => -1i64,
    }
}

pub fn main() -> i32 {
    // Three levels: root -> mid -> inner. A yield returns to the *direct* resumer only.
    let mut inner: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(1i64);
        yield_val<i64>(2i64);
        3i64
    });
    // `shared` is created by the root, first resumed by the root, later resumed by a fiber:
    // the host must re-record the caller on every resume.
    let mut shared: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(10i64);
        yield_val<i64>(20i64);
        yield_val<i64>(30i64);
        40i64
    });
    let first = pull(mut_view(shared));
    let mut mid: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        // resumed from inside `mid`; its yield comes back here, not to the root
        let a = pull(mut_view(shared));
        let b = pull(mut_view(inner));
        yield_val<i64>(a * 100i64 + b);
        let c = pull(mut_view(inner));
        let d = pull(mut_view(inner));
        c * 10i64 + d
    });
    let m1 = pull(mut_view(mid));
    // back on the root: shared is still suspended and resumable from the root again
    let again = pull(mut_view(shared));
    let m2 = pull(mut_view(mid));
    check(view(mid).is_completed());

    // Thread-local storage is shared by every fiber of the thread (AFIBER-39).
    unsafe { TLS_VALUE = 5i64; }
    let mut t: Fiber<(), i64> = Fiber.new(|| -> i64 {
        let seen = unsafe { TLS_VALUE };
        unsafe { TLS_VALUE = seen + 1i64; }
        yield_now();
        unsafe { TLS_VALUE = TLS_VALUE * 10i64; }
        seen
    });
    match t.resume() { FiberState.Yielded(_u) => {}, FiberState.Completed(_r) => { check(false); }, FiberState.Panicked => { check(false); } }
    let tls_mid = unsafe { TLS_VALUE };
    let mut tseen: i64 = 0i64;
    match t.resume() { FiberState.Yielded(_u) => { check(false); }, FiberState.Completed(r) => { tseen = r; }, FiberState.Panicked => { check(false); } }
    let tls_end = unsafe { TLS_VALUE };

    print("OK qa_fiber_nested3 ");
    print_int(first);
    print(" ");
    print_int(m1);
    print(" ");
    print_int(again);
    print(" ");
    print_int(m2);
    print(" ");
    print_int(tls_mid);
    print(" ");
    print_int(tseen);
    print(" ");
    print_int(tls_end);
    print("\n");
    0
}
