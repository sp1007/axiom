module main

use std.core.host.fiber_create
use std.core.host.fiber_resume
use std.core.host.fiber_yield
use std.core.host.fiber_destroy

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Yields 11, then (resume argument + 1), then returns twice the last resume argument.
fn entry_args(ctx: *mut u8) -> i64 {
    let a = fiber_yield(11i64);
    let b = fiber_yield(a + 1i64);
    b * 2i64
}

// Tries to destroy and to resume its own (running) handle; both must be rejected with -4.
fn entry_self(ctx: *mut u8) -> i64 {
    let h = unsafe { *(ctx as *mut i64) };
    let d = fiber_destroy(h);
    let mut sink: i64 = 0i64;
    let r = unsafe { fiber_resume(h, 0i64, address_of_mut(sink)) };
    if d == -4i64 && r == -4i64 { 1i64 } else { 0i64 }
}

pub fn main() -> i32 {
    // Outside a fiber there is nothing to yield from.
    check(fiber_yield(5i64) == -4i64);

    // Invalid handles are rejected.
    let mut out: i64 = 0i64;
    check(unsafe { fiber_resume(0i64, 0i64, address_of_mut(out)) } == -4i64);
    check(unsafe { fiber_resume(-1i64, 0i64, address_of_mut(out)) } == -4i64);
    check(fiber_destroy(0i64) == -4i64);
    check(fiber_destroy(123456i64) == -4i64);

    // Yield values and resume arguments cross the boundary unchanged.
    let h = unsafe { fiber_create(entry_args, 0 as *mut u8, 0, 0) };
    check(h > 0i64);
    check(unsafe { fiber_resume(h, 5i64, address_of_mut(out)) } == 0i64);
    let y1 = out;
    check(unsafe { fiber_resume(h, 20i64, address_of_mut(out)) } == 0i64);
    let y2 = out;
    check(unsafe { fiber_resume(h, 30i64, address_of_mut(out)) } == 1i64);
    let y3 = out;
    // A completed fiber cannot be resumed again, but its handle can be destroyed exactly once.
    let again = unsafe { fiber_resume(h, 0i64, address_of_mut(out)) };
    check(fiber_destroy(h) == 0i64);
    let twice = fiber_destroy(h);
    check(unsafe { fiber_resume(h, 0i64, address_of_mut(out)) } == -4i64);

    // A running fiber can neither be destroyed nor resumed.
    let mut self_h: i64 = 0i64;
    let hs = unsafe { fiber_create(entry_self, address_of_mut(self_h) as *mut u8, 65536, 262144) };
    check(hs > 0i64);
    self_h = hs;
    check(unsafe { fiber_resume(hs, 0i64, address_of_mut(out)) } == 1i64);
    check(out == 1i64);
    check(fiber_destroy(hs) == 0i64);

    // A suspended (yielded) fiber can be destroyed; the handle is then dead.
    let hy = unsafe { fiber_create(entry_args, 0 as *mut u8, 0, 0) };
    check(unsafe { fiber_resume(hy, 0i64, address_of_mut(out)) } == 0i64);
    let destroy_suspended = fiber_destroy(hy);
    check(unsafe { fiber_resume(hy, 0i64, address_of_mut(out)) } == -4i64);

    print("OK fiber_host_contract ");
    print_int(y1);
    print(" ");
    print_int(y2);
    print(" ");
    print_int(y3);
    print(" ");
    print_int(again);
    print(" ");
    print_int(twice);
    print(" ");
    print_int(destroy_suspended);
    print(" ");
    print_int(fiber_destroy(hy));
    print("\n");
    0
}
