module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_val

// QA (T423): yield values and results of every size class cross the i64 host interface by move.
struct Big {
    pub a: i64,
    pub b: i64,
    pub c: i64,
}

pub fn main() -> i32 {
    // 1 byte yield, bool result.
    let mut f8: Fiber<u8, bool> = Fiber.new(|| -> bool {
        yield_val<u8>(200u8);
        yield_val<u8>(7u8);
        true
    });
    let mut s8: i64 = 0i64;
    match f8.resume() {
        FiberState.Yielded(v) => { s8 = s8 + (v as i64); },
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }
    match f8.resume() {
        FiberState.Yielded(v) => { s8 = s8 + (v as i64); },
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }
    let mut rb: bool = false;
    match f8.resume() {
        FiberState.Yielded(_v) => { check(false); },
        FiberState.Completed(r) => { rb = r; },
        FiberState.Panicked => { check(false); },
    }
    check(s8 == 207i64);
    check(rb);

    // 24-byte struct yield and result.
    let mut fb: Fiber<Big, Big> = Fiber.new(|| -> Big {
        yield_val<Big>(Big { a: 1i64, b: -2i64, c: 3i64 });
        Big { a: 10i64, b: 20i64, c: -30i64 }
    });
    let mut big_sum: i64 = 0i64;
    match fb.resume() {
        FiberState.Yielded(v) => { big_sum = v.a * 100i64 + v.b * 10i64 + v.c; },
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }
    let mut big_res: i64 = 0i64;
    match fb.resume() {
        FiberState.Yielded(_v) => { check(false); },
        FiberState.Completed(r) => { big_res = r.a + r.b + r.c; },
        FiberState.Panicked => { check(false); },
    }
    check(big_sum == 83i64);
    check(big_res == 0i64);

    // 128-bit yield and result (16-byte aligned class).
    let mut f128: Fiber<u128, i128> = Fiber.new(|| -> i128 {
        yield_val<u128>(18446744073709551615u128 * 1000u128 + 7u128);
        -5i128
    });
    let mut lo: i64 = 0i64;
    let mut hi_ok: bool = false;
    match f128.resume() {
        FiberState.Yielded(v) => {
            lo = (v % 1000u128) as i64;
            hi_ok = (v / 1000u128) == 18446744073709551615u128;
        },
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }
    let mut r128: i64 = 0i64;
    match f128.resume() {
        FiberState.Yielded(_v) => { check(false); },
        FiberState.Completed(r) => { r128 = r as i64; },
        FiberState.Panicked => { check(false); },
    }
    check(hi_ok);

    // Fixed array yield (copy type, 24 bytes).
    let mut fa: Fiber<[3]i64, i64> = Fiber.new(|| -> i64 {
        let arr: [3]i64 = [4i64, 5i64, 6i64];
        yield_val<[3]i64>(arr);
        0i64
    });
    let mut asum: i64 = 0i64;
    match fa.resume() {
        FiberState.Yielded(v) => { asum = v[0] * 100i64 + v[1] * 10i64 + v[2]; },
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }

    // Zero-sized yield/result (unit) after a value yield.
    let mut fu: Fiber<(), ()> = Fiber.new(|| {
        yield_val<()>(());
    });
    match fu.resume() {
        FiberState.Yielded(_u) => {},
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }
    match fu.resume() {
        FiberState.Yielded(_u) => { check(false); },
        FiberState.Completed(_r) => {},
        FiberState.Panicked => { check(false); },
    }

    print("OK qa_fiber_values ");
    print_int(s8);
    print(" ");
    print_int(big_sum);
    print(" ");
    print_int(big_res);
    print(" ");
    print_int(lo);
    print(" ");
    print_int(r128);
    print(" ");
    print_int(asum);
    print("\n");
    0
}
