module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now

@intrinsic fn panic(msg: str) {}

pub fn main() -> i32 {
    // A panic inside a fiber is contained: the resumer observes FiberState.Panicked, the fiber is
    // finished, and the resumer's own stack and the other fibers are untouched.
    let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
        yield_now();
        panic("fiber boom");
        1i64
    });
    let mut good: Fiber<(), i64> = Fiber.new(|| -> i64 {
        yield_now();
        42i64
    });

    match bad.resume() {
        FiberState.Yielded(_u) => {},
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }
    let mut panicked: i64 = 0i64;
    match bad.resume() {
        FiberState.Yielded(_u) => { check(false); },
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { panicked = 1i64; },
    }
    check(view(bad).is_completed());

    match good.resume() {
        FiberState.Yielded(_u) => {},
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }
    let mut survivor: i64 = 0i64;
    match good.resume() {
        FiberState.Yielded(_u) => { check(false); },
        FiberState.Completed(r) => { survivor = r; },
        FiberState.Panicked => { check(false); },
    }

    print("OK fiber_panic_contained ");
    print_int(panicked);
    print(" ");
    print_int(survivor);
    print("\n");
    0
}
