module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Records its id in the shared log when dropped.
struct Guard {
    pub id: i64,
    pub log: *mut i64,
    pub n: *mut i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        unsafe {
            *(self.log + (*self.n as usize)) = self.id;
            *self.n = *self.n + 1i64;
        }
    }
}

pub fn main() -> i32 {
    let mut slots: [16]i64 = [0i64; 16];
    let mut count: i64 = 0i64;
    let log: *mut i64 = unsafe { address_of_mut(slots[0]) };
    let n: *mut i64 = unsafe { address_of_mut(count) };

    // 1. Locals of a fiber are dropped, in reverse declaration order, when its closure returns.
    let mut f: Fiber<(), i64> = Fiber.new(|| -> i64 {
        let _g1 = Guard { id: 1i64, log: log, n: n };
        let _g2 = Guard { id: 2i64, log: log, n: n };
        yield_now();
        7i64
    });
    match f.resume() {
        FiberState.Yielded(_u) => {},
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }
    check(count == 0i64);
    let mut result: i64 = 0i64;
    match f.resume() {
        FiberState.Yielded(_u) => { check(false); },
        FiberState.Completed(r) => { result = r; },
        FiberState.Panicked => { check(false); },
    }
    check(count == 2i64);
    check(slots[0] == 2i64);
    check(slots[1] == 1i64);

    // 2. A fiber that never started never runs its closure.
    {
        let _unstarted: Fiber<(), i64> = Fiber.new(|| -> i64 {
            let _g = Guard { id: 3i64, log: log, n: n };
            0i64
        });
    }
    check(count == 2i64);

    // 3. A fiber destroyed while suspended releases its stack without running the Drop of its
    //    live locals (the Win32 stack is simply deleted; the oracle frees the frames).
    {
        let mut s: Fiber<(), i64> = Fiber.new(|| -> i64 {
            let _g = Guard { id: 4i64, log: log, n: n };
            yield_now();
            0i64
        });
        match s.resume() {
            FiberState.Yielded(_u) => {},
            FiberState.Completed(_r) => { check(false); },
            FiberState.Panicked => { check(false); },
        }
    }
    check(count == 2i64);

    print("OK fiber_drop_cleanup ");
    print_int(slots[0]);
    print(" ");
    print_int(slots[1]);
    print(" ");
    print_int(slots[2]);
    print(" ");
    print_int(result);
    print("\n");
    0
}
