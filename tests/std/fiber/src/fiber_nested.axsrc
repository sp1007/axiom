module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_val

fn step(f: mut_view<Fiber<i64, i64>>) -> i64 {
    match f.resume() {
        FiberState.Yielded(v) => v,
        FiberState.Completed(r) => r,
        FiberState.Panicked => -1i64,
    }
}

pub fn main() -> i32 {
    // The outer fiber resumes an inner fiber from its own stack and forwards what it yields.
    let mut outer: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        let mut inner: Fiber<i64, i64> = Fiber.new(|| -> i64 {
            yield_val<i64>(1i64);
            yield_val<i64>(2i64);
            3i64
        });
        let mut acc: i64 = 0i64;
        let mut going = true;
        while going {
            match inner.resume() {
                FiberState.Yielded(v) => {
                    acc = acc * 10i64 + v;
                    yield_val<i64>(100i64 + v);
                },
                FiberState.Completed(r) => {
                    acc = acc * 10i64 + r;
                    going = false;
                },
                FiberState.Panicked => {
                    going = false;
                },
            }
        }
        acc
    });

    let o1 = step(mut_view(outer));
    let o2 = step(mut_view(outer));
    check(!view(outer).is_completed());
    let o3 = step(mut_view(outer));
    check(view(outer).is_completed());

    print("OK fiber_nested ");
    print_int(o1);
    print(" ");
    print_int(o2);
    print(" ");
    print_int(o3);
    print("\n");
    0
}
