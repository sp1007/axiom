module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_val

// Suspends from the bottom of a chain of ordinary (non-async) helper calls; the sum of the
// depths is only right if every intermediate frame survives the suspension.
fn descend(depth: i64, tag: i64) -> i64 {
    if depth == 0i64 {
        yield_val(tag);
        return 0i64;
    }
    let below = descend(depth - 1i64, tag);
    below + depth
}

fn step(f: mut_view<Fiber<i64, i64>>) -> i64 {
    match f.resume() {
        FiberState.Yielded(v) => v,
        FiberState.Completed(r) => r,
        FiberState.Panicked => -1i64,
    }
}

pub fn main() -> i32 {
    let mut a: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        let total = descend(20i64, 7i64);
        yield_val<i64>(total);
        total
    });
    let mut b: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        descend(5i64, 9i64)
    });

    // a and b are suspended at depth 20 and depth 5 at the same time, on separate stacks.
    let a1 = step(mut_view(a));
    let b1 = step(mut_view(b));
    check(!view(a).is_completed());
    check(!view(b).is_completed());
    let a2 = step(mut_view(a));
    let b2 = step(mut_view(b));
    check(!view(a).is_completed());
    check(view(b).is_completed());
    let a3 = step(mut_view(a));
    check(view(a).is_completed());

    print("OK fiber_deep_stack ");
    print_int(a1);
    print(" ");
    print_int(a2);
    print(" ");
    print_int(a3);
    print(" ");
    print_int(b1);
    print(" ");
    print_int(b2);
    print("\n");
    0
}
