module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_val

// QA (T423): resuming a fiber that already completed is a deterministic panic (exit 101) in both modes.
pub fn main() -> i32 {
    let mut f: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(1i64);
        2i64
    });
    match f.resume() { FiberState.Yielded(_v) => {}, FiberState.Completed(_r) => { check(false); }, FiberState.Panicked => { check(false); } }
    match f.resume() { FiberState.Yielded(_v) => { check(false); }, FiberState.Completed(_r) => {}, FiberState.Panicked => { check(false); } }
    print("before\n");
    let _again = f.resume();
    print("unreachable\n");
    0
}
