module main

use std.core.host.fiber_resume
use std.core.host.fiber_destroy
use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now
use std.thread.spawn

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// QA (T423, AXS-EXEC-054): a handle of a fiber owned by thread A must be rejected with -4 on thread B
// even when thread B owns a fiber of its own (handle numbers are per-thread slot indices natively,
// so the two handles can be numerically equal).
pub fn main() -> i32 {
    let mut f: Fiber<(), i64> = Fiber.new(|| -> i64 {
        yield_now();
        77i64
    });
    match f.resume() { FiberState.Yielded(_u) => {}, FiberState.Completed(_r) => { check(false); }, FiberState.Panicked => { check(false); } }
    let h: i64 = f.raw_handle;

    let t_resume = spawn(|| -> i64 {
        let mut own: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            5i64
        });
        match own.resume() { FiberState.Yielded(_u) => {}, FiberState.Completed(_r) => {}, FiberState.Panicked => {} }
        let mut out: i64 = 0i64;
        let rc = unsafe { fiber_resume(h, 0i64, address_of_mut<i64>(out)) };
        let mut own_res: i64 = -100i64;
        match own.resume() { FiberState.Yielded(_u) => {}, FiberState.Completed(r) => { own_res = r; }, FiberState.Panicked => {} }
        (rc + 10i64) * 1000i64 + own_res
    });
    let t_destroy = spawn(|| -> i64 {
        let mut own: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            6i64
        });
        match own.resume() { FiberState.Yielded(_u) => {}, FiberState.Completed(_r) => {}, FiberState.Panicked => {} }
        let rc = fiber_destroy(h);
        let mut own_res: i64 = -100i64;
        match own.resume() { FiberState.Yielded(_u) => {}, FiberState.Completed(r) => { own_res = r; }, FiberState.Panicked => {} }
        (rc + 10i64) * 1000i64 + own_res
    });
    let r1 = match t_resume.join() { Result.Ok(x) => x, Result.Err(_e) => -1i64 };
    let r2 = match t_destroy.join() { Result.Ok(x) => x, Result.Err(_e) => -1i64 };

    let mut fin: i64 = 0i64;
    match f.resume() { FiberState.Yielded(_u) => { check(false); }, FiberState.Completed(r) => { fin = r; }, FiberState.Panicked => { check(false); } }

    print("OK qa_fiber_foreign_collision ");
    print_int(r1);
    print(" ");
    print_int(r2);
    print(" ");
    print_int(fin);
    print("\n");
    0
}
