module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_val

pub fn main() -> i32 {
    // 1. One fiber: three yields, then a result.
    let mut f: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(1i64);
        yield_val<i64>(2i64);
        yield_val<i64>(3i64);
        100i64
    });
    check(!view(f).is_completed());
    let mut sum: i64 = 0i64;
    let mut steps: i64 = 0i64;
    let mut done: i64 = 0i64;
    let mut going = true;
    while going {
        match f.resume() {
            FiberState.Yielded(v) => {
                sum = sum + v;
                steps = steps + 1i64;
            },
            FiberState.Completed(r) => {
                done = r;
                going = false;
            },
            FiberState.Panicked => {
                check(false);
                going = false;
            },
        }
    }
    check(view(f).is_completed());

    // 2. Two fibers interleaved by the resumer: every fiber keeps its own stack and position.
    let mut a: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(1i64);
        yield_val<i64>(2i64);
        5i64
    });
    let mut b: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(3i64);
        yield_val<i64>(4i64);
        6i64
    });
    check(view(a).id().id != view(b).id().id);
    let mut acc: i64 = 0i64;
    let mut round: i64 = 0i64;
    while round < 3i64 {
        let ra = match a.resume() {
            FiberState.Yielded(v) => v,
            FiberState.Completed(r) => r,
            FiberState.Panicked => -1i64,
        };
        acc = acc * 10i64 + ra;
        let rb = match b.resume() {
            FiberState.Yielded(v) => v,
            FiberState.Completed(r) => r,
            FiberState.Panicked => -1i64,
        };
        acc = acc * 10i64 + rb;
        round = round + 1i64;
    }
    check(view(a).is_completed());
    check(view(b).is_completed());

    print("OK fiber_ping_pong ");
    print_int(sum);
    print(" ");
    print_int(steps);
    print(" ");
    print_int(done);
    print(" ");
    print_int(acc);
    print(" ");
    print_int(if view(f).is_completed() { 1i64 } else { 0i64 });
    print("\n");
    0
}
