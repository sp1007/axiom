module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.FiberScheduler
use std.fiber.yield_now
use std.fiber.yield_val

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn bump(counter: *mut i64) {
    unsafe {
        *counter = *counter + 1i64;
    }
}

pub fn main() -> i32 {
    let mut counter: i64 = 0i64;
    let cp: *mut i64 = unsafe { address_of_mut(counter) };

    // 1. Create/finish/drop 300 fibers one after the other: slots and Win32 fibers are recycled,
    //    handles do not leak (a leak of the 256 KiB reservations would exhaust the address space
    //    or the slot table long before 300 iterations).
    let mut i: i64 = 0i64;
    let mut total: i64 = 0i64;
    while i < 300i64 {
        let mut f: Fiber<i64, i64> = Fiber.new(|| -> i64 {
            yield_val<i64>(i);
            i * 2i64
        });
        match f.resume() {
            FiberState.Yielded(v) => { total = total + v; },
            FiberState.Completed(_r) => { check(false); },
            FiberState.Panicked => { check(false); },
        }
        match f.resume() {
            FiberState.Yielded(_v) => { check(false); },
            FiberState.Completed(r) => { total = total + r; },
            FiberState.Panicked => { check(false); },
        }
        i = i + 1i64;
    }
    // sum over i of 3 * i = 3 * (299 * 300 / 2)
    check(total == 134550i64);

    // 2. Create/suspend/drop 200 fibers (destroyed while suspended): the host stack is released on drop.
    let mut j: i64 = 0i64;
    while j < 200i64 {
        let mut g: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            1i64
        });
        match g.resume() {
            FiberState.Yielded(_u) => {},
            FiberState.Completed(_r) => { check(false); },
            FiberState.Panicked => { check(false); },
        }
        j = j + 1i64;
    }

    // 3. 60 fibers alive at once under one scheduler (queue grows 4 -> 8 -> ... -> 64 and moves the
    //    Fiber records), each yielding 3 times.
    let mut sched = FiberScheduler.new();
    let mut k: i64 = 0i64;
    while k < 60i64 {
        sched.spawn(|| {
            yield_now();
            bump(cp);
            yield_now();
            bump(cp);
            yield_now();
            bump(cp);
        });
        k = k + 1i64;
    }
    check(view(sched).pending() == 60);
    sched.run();
    check(view(sched).pending() == 0);
    check(counter == 180i64);

    print("OK qa_fiber_many ");
    print_int(total);
    print(" ");
    print_int(counter);
    print("\n");
    0
}
