module main

use std.core.host.thread_current_id
use std.core.host.fiber_resume
use std.core.host.fiber_destroy
use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now
use std.thread.spawn

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn main() -> i32 {
    // A fiber runs on the thread that created it: the thread id seen inside is the creator's.
    let creator: u64 = thread_current_id();
    let mut f: Fiber<(), i64> = Fiber.new(|| -> i64 {
        let inside: u64 = thread_current_id();
        yield_now();
        if inside == creator { 1i64 } else { 0i64 }
    });
    let h: i64 = f.raw_handle;
    let owner: u64 = f.owner_thread;
    check(owner == creator);
    match f.resume() {
        FiberState.Yielded(_u) => {},
        FiberState.Completed(_r) => { check(false); },
        FiberState.Panicked => { check(false); },
    }

    // Another OS thread can neither resume nor destroy the suspended fiber (REQ-CONC-151/189).
    let t_resume = spawn(|| -> i64 {
        let mut out: i64 = 0i64;
        unsafe { fiber_resume(h, 0i64, address_of_mut<i64>(out)) }
    });
    let t_destroy = spawn(|| -> i64 {
        fiber_destroy(h)
    });
    let foreign_resume = match t_resume.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };
    let foreign_destroy = match t_destroy.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };

    // The fiber is untouched by the failed attempts and finishes on the creator thread.
    let mut same_thread: i64 = 0i64;
    match f.resume() {
        FiberState.Yielded(_u) => { check(false); },
        FiberState.Completed(r) => { same_thread = r; },
        FiberState.Panicked => { check(false); },
    }

    print("OK fiber_affinity ");
    print_int(same_thread);
    print(" ");
    print_int(foreign_resume);
    print(" ");
    print_int(foreign_destroy);
    print("\n");
    0
}
