// test: run
// modes: interp native
// stdout: 7\n
// Minimal repro found by T423 (impl<Y, R> Fiber<Y, R> { fn new<F: FnOnce<R>>(f: F) }).
// R in the method bound refers to the impl parameter, as it does in the return type and the parameters.

struct W<R> {
    pub v: i64,
}

impl<R> W<R> {
    pub fn mk<F: FnOnce<R>>(f: F) -> i64 {
        7i64
    }
}

pub fn main() -> i32 {
    let r: i64 = W<i64>.mk(|| -> i64 { 1i64 });
    print_int(r);
    print("\n");
    0
}
