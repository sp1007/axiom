// test: run
// modes: interp native
// xfail: T423d a method-level bound that names an impl-level generic parameter (F: FnOnce<R> with impl<R>) is rejected with AX_NAME_UNRESOLVED
// stdout: 7\n
// Minimal repro found by T423 (impl<Y, R> Fiber<Y, R> { fn new<F: FnOnce<R>>(f: F) } cannot state its bound,
// so std.fiber declares Fiber.new<F> without the FnOnce bound).
// Expected: R in the bound refers to the impl parameter, as it does in the return type and the parameters.

struct W<R> {
    pub v: i64,
}

impl<R> W<R> {
    pub fn mk<F: FnOnce<R>>(f: F) -> i64 {
        7i64
    }
}

pub fn main() -> i32 {
    let r: i64 = W<i64>.mk(|| -> i64 { 1i64 });
    print_int(r);
    0
}
