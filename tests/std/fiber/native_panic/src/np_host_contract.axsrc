module main

use std.core.host.fiber_create
use std.core.host.fiber_resume
use std.core.host.fiber_yield
use std.core.host.fiber_destroy

@intrinsic fn panic(msg: str) {}
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Yields 9; panics when resumed with 1, otherwise returns the resume argument.
fn entry_boom(ctx: *mut u8) -> i64 {
    let a = fiber_yield(9i64);
    if a == 1i64 {
        panic("np_host_contract boom");
    }
    a
}

pub fn main() -> i32 {
    // host.fiber_resume returns 2 for a panicked fiber and writes 0 to *out_val; the handle then
    // behaves as a finished fiber: resume is rejected (-4), destroy succeeds exactly once.
    let mut out: i64 = 0i64;
    let h = unsafe { fiber_create(entry_boom, 0 as *mut u8, 0, 0) };
    check(h > 0i64);
    let r1 = unsafe { fiber_resume(h, 0i64, address_of_mut(out)) };
    let y1 = out;
    out = 77i64;
    let r2 = unsafe { fiber_resume(h, 1i64, address_of_mut(out)) };
    let o2 = out;
    let r3 = unsafe { fiber_resume(h, 0i64, address_of_mut(out)) };
    let d1 = fiber_destroy(h);
    let d2 = fiber_destroy(h);

    // A second fiber on the same thread is unaffected and completes.
    let h2 = unsafe { fiber_create(entry_boom, 0 as *mut u8, 0, 0) };
    check(unsafe { fiber_resume(h2, 0i64, address_of_mut(out)) } == 0i64);
    let r4 = unsafe { fiber_resume(h2, 5i64, address_of_mut(out)) };
    let o4 = out;
    check(fiber_destroy(h2) == 0i64);

    print("OK np_host_contract ");
    print_int(r1);
    print(" ");
    print_int(y1);
    print(" ");
    print_int(r2);
    print(" ");
    print_int(o2);
    print(" ");
    print_int(r3);
    print(" ");
    print_int(d1);
    print(" ");
    print_int(d2);
    print(" ");
    print_int(r4);
    print(" ");
    print_int(o4);
    print("\n");
    0
}
