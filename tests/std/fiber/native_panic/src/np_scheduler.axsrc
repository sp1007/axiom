module main

use std.fiber.FiberScheduler
use std.fiber.yield_now

@intrinsic fn panic(msg: str) {}
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Appends `id * 10 + round` to the shared log, then lets the other fibers run.
fn worker(id: i64, rounds: i64, log: *mut i64, n: *mut i64) {
    let mut r: i64 = 0i64;
    while r < rounds {
        unsafe {
            *(log + (*n as usize)) = id * 10i64 + r;
            *n = *n + 1i64;
        }
        yield_now();
        r = r + 1i64;
    }
}

// Logs once, yields, then panics on its second resume.
fn bad_worker(log: *mut i64, n: *mut i64) {
    unsafe {
        *(log + (*n as usize)) = 90i64;
        *n = *n + 1i64;
    }
    yield_now();
    panic("np_scheduler boom");
    unsafe {
        *(log + (*n as usize)) = 99i64;
        *n = *n + 1i64;
    }
}

pub fn main() -> i32 {
    let mut slots: [16]i64 = [0i64; 16];
    let mut count: i64 = 0i64;
    let log: *mut i64 = unsafe { address_of_mut(slots[0]) };
    let n: *mut i64 = unsafe { address_of_mut(count) };

    // FiberScheduler.run completes the other fibers when one of them panics.
    let mut sched = FiberScheduler.new();
    sched.spawn(|| {
        worker(1i64, 3i64, log, n);
    });
    sched.spawn(|| {
        bad_worker(log, n);
    });
    sched.spawn(|| {
        worker(3i64, 2i64, log, n);
    });
    check(view(sched).pending() == 3);
    sched.run();
    check(view(sched).pending() == 0);

    // The scheduler is still usable after a run with a panicked fiber.
    sched.spawn(|| {
        worker(4i64, 1i64, log, n);
    });
    sched.run();

    print("OK np_scheduler ");
    print_int(count);
    let mut i: usize = 0;
    while i < (count as usize) {
        print(" ");
        print_int(slots[i]);
        i = i + 1;
    }
    print("\n");
    0
}
