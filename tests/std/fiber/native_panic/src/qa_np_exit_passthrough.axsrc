module main

use std.fiber.Fiber
use std.fiber.FiberState

@intrinsic fn panic(msg: str) {}

// Direct FFI: this test is native-only (ADR-0002). The import shares the IAT entry the hooks sit on.
@link("kernel32")
extern "system" {
    fn ExitProcess(uExitCode: u32);
}

pub fn main() -> i32 {
    // Install the hook with a contained panic first.
    let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
        panic("qa_np_exit_passthrough boom");
        1i64
    });
    match bad.resume() {
        FiberState.Yielded(_u) => { print("yielded\n"); },
        FiberState.Completed(_r) => { print("completed\n"); },
        FiberState.Panicked => { print("panicked\n"); },
    }
    // An exit code other than 101 from inside a fiber ends the process unchanged.
    let mut ex: Fiber<(), i64> = Fiber.new(|| -> i64 {
        print("in fiber\n");
        unsafe { ExitProcess(3u32); }
        1i64
    });
    match ex.resume() {
        FiberState.Yielded(_u) => { print("yielded\n"); },
        FiberState.Completed(_r) => { print("completed\n"); },
        FiberState.Panicked => { print("panicked\n"); },
    }
    print("not reached\n");
    0
}
