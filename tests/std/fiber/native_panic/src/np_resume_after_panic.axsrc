module main

use std.fiber.Fiber
use std.fiber.FiberState

@intrinsic fn panic(msg: str) {}

pub fn main() -> i32 {
    // Resuming a fiber that already panicked is a deterministic panic of the resumer (exit 101).
    let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
        panic("np_resume_after_panic first boom");
        1i64
    });
    match bad.resume() {
        FiberState.Yielded(_u) => { print("yielded\n"); },
        FiberState.Completed(_r) => { print("completed\n"); },
        FiberState.Panicked => { print("panicked\n"); },
    }
    print("before\n");
    match bad.resume() {
        FiberState.Yielded(_u) => { print("yielded\n"); },
        FiberState.Completed(_r) => { print("completed\n"); },
        FiberState.Panicked => { print("panicked again\n"); },
    }
    print("after\n");
    0
}
