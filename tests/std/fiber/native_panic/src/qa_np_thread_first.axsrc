module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now
use std.thread.spawn

@intrinsic fn panic(msg: str) {}

// 0 yielded, 2 panicked, 1000 + r completed with r.
fn code_of(st: FiberState<(), i64>) -> i64 {
    match st {
        FiberState.Yielded(_u) => 0i64,
        FiberState.Completed(r) => 1000i64 + r,
        FiberState.Panicked => 2i64,
    }
}

// Many panicking fibers on one spawned thread. The main thread never resumed a fiber before, so the exit
// hook is first installed by whichever worker resumes first (the workers race on the installation).
fn worker(n: i64) -> i64 {
    let mut total: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 40i64 {
        let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            panic("qa_np_thread_first boom");
            1i64
        });
        let a = code_of(bad.resume());
        let c = code_of(bad.resume());
        total = total + a + c * 10i64;
        i = i + 1i64;
    }
    total + n
}

pub fn main() -> i32 {
    let t1 = spawn(|| -> i64 { worker(1i64) });
    let t2 = spawn(|| -> i64 { worker(2i64) });
    let t3 = spawn(|| -> i64 { worker(3i64) });
    let t4 = spawn(|| -> i64 { worker(4i64) });
    let v1 = match t1.join() { Result.Ok(x) => x, Result.Err(_e) => -1i64, };
    let v2 = match t2.join() { Result.Ok(x) => x, Result.Err(_e) => -1i64, };
    let v3 = match t3.join() { Result.Ok(x) => x, Result.Err(_e) => -1i64, };
    let v4 = match t4.join() { Result.Ok(x) => x, Result.Err(_e) => -1i64, };

    // A fiber panic inside a spawned thread, then a plain panic outside any fiber on the same thread:
    // the first is contained, the second still makes join return Err.
    let t5 = spawn(|| -> i64 {
        let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
            panic("qa_np_thread_first contained");
            1i64
        });
        let c = code_of(bad.resume());
        if c == 2i64 {
            panic("qa_np_thread_first thread plain");
        }
        77i64
    });
    let v5 = match t5.join() { Result.Ok(x) => x, Result.Err(_e) => -1i64, };

    // The main thread still contains its own fiber panics.
    let mut m: Fiber<(), i64> = Fiber.new(|| -> i64 {
        panic("qa_np_thread_first main fiber");
        1i64
    });
    let mc = code_of(m.resume());

    print("OK qa_np_thread_first ");
    print_int(v1);
    print(" ");
    print_int(v2);
    print(" ");
    print_int(v3);
    print(" ");
    print_int(v4);
    print(" ");
    print_int(v5);
    print(" ");
    print_int(mc);
    print("\n");
    0
}
