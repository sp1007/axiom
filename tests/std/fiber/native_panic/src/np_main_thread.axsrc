module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now

@intrinsic fn panic(msg: str) {}

// 0 yielded, 2 panicked, 1000 + r completed with r.
fn code_of(st: FiberState<(), i64>) -> i64 {
    match st {
        FiberState.Yielded(_u) => 0i64,
        FiberState.Completed(r) => 1000i64 + r,
        FiberState.Panicked => 2i64,
    }
}

pub fn main() -> i32 {
    // A fiber on the main thread panics on its first resume; the main thread and the other fibers
    // keep running and the program exits 0 (AXS-EXEC-055.5).
    let mut a: Fiber<(), i64> = Fiber.new(|| -> i64 {
        yield_now();
        10i64
    });
    let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
        panic("np_main_thread boom");
        1i64
    });
    let mut c: Fiber<(), i64> = Fiber.new(|| -> i64 {
        yield_now();
        yield_now();
        30i64
    });

    let r1 = code_of(a.resume());
    let r2 = code_of(bad.resume());
    check(view(bad).is_completed());
    let r3 = code_of(c.resume());
    let r4 = code_of(a.resume());
    let r5 = code_of(c.resume());
    let r6 = code_of(c.resume());

    // A fiber created after the panic runs normally.
    let mut d: Fiber<(), i64> = Fiber.new(|| -> i64 {
        40i64
    });
    let r7 = code_of(d.resume());

    print("OK np_main_thread ");
    print_int(r1);
    print(" ");
    print_int(r2);
    print(" ");
    print_int(r3);
    print(" ");
    print_int(r4);
    print(" ");
    print_int(r5);
    print(" ");
    print_int(r6);
    print(" ");
    print_int(r7);
    print("\n");
    0
}
