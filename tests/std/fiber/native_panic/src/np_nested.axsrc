module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now

@intrinsic fn panic(msg: str) {}

// 0 yielded, 2 panicked, 1000 + r completed with r.
fn code_of(st: FiberState<(), i64>) -> i64 {
    match st {
        FiberState.Yielded(_u) => 0i64,
        FiberState.Completed(r) => 1000i64 + r,
        FiberState.Panicked => 2i64,
    }
}

pub fn main() -> i32 {
    // A fiber resumes a nested fiber that panics: only the direct resumer (the outer fiber) sees
    // Panicked; the outer fiber keeps running, yields to main and completes normally.
    let mut outer: Fiber<(), i64> = Fiber.new(|| -> i64 {
        let mut inner: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            panic("np_nested inner boom");
            1i64
        });
        let a = code_of(inner.resume());
        yield_now();
        let b = code_of(inner.resume());
        check(view(inner).is_completed());
        let mut inner2: Fiber<(), i64> = Fiber.new(|| -> i64 {
            5i64
        });
        let c = code_of(inner2.resume());
        a * 1000000i64 + b * 10000i64 + c
    });

    let r1 = code_of(outer.resume());
    let r2 = code_of(outer.resume());
    check(view(outer).is_completed());

    print("OK np_nested ");
    print_int(r1);
    print(" ");
    print_int(r2);
    print("\n");
    0
}
