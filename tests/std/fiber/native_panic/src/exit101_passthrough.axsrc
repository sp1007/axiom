module main

use std.fiber.Fiber
use std.fiber.FiberState

@intrinsic fn panic(msg: str) {}

// Direct FFI: this test is native-only (ADR-0002).
@link("kernel32")
extern "system" {
    fn ExitProcess(uExitCode: u32);
}

// T538: a panic on a fiber is contained by the registered panic hook, but a user ExitProcess(101)
// inside a fiber is a plain process exit (no ExitProcess hook any more): the process ends with 101 and
// nothing after the exit runs.
pub fn main() -> i32 {
    // Register the fiber panic hook with a contained panic first.
    let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
        panic("exit101_passthrough boom");
        1i64
    });
    match bad.resume() {
        FiberState.Yielded(_u) => { print("yielded\n"); },
        FiberState.Completed(_r) => { print("completed\n"); },
        FiberState.Panicked => { print("panicked\n"); },
    }
    let mut ex: Fiber<(), i64> = Fiber.new(|| -> i64 {
        print("in fiber\n");
        unsafe { ExitProcess(101u32); }
        1i64
    });
    match ex.resume() {
        FiberState.Yielded(_u) => { print("yielded\n"); },
        FiberState.Completed(_r) => { print("completed\n"); },
        FiberState.Panicked => { print("contained\n"); },
    }
    print("not reached\n");
    0
}
