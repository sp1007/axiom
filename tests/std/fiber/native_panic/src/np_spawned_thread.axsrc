module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now
use std.thread.spawn

@intrinsic fn panic(msg: str) {}

// 0 yielded, 2 panicked, 1000 + r completed with r.
fn code_of(st: FiberState<(), i64>) -> i64 {
    match st {
        FiberState.Yielded(_u) => 0i64,
        FiberState.Completed(r) => 1000i64 + r,
        FiberState.Panicked => 2i64,
    }
}

pub fn main() -> i32 {
    // A fiber on the main thread panics first (the exit hooks are installed on the main thread).
    let mut m: Fiber<(), i64> = Fiber.new(|| -> i64 {
        panic("np_spawned_thread main fiber boom");
        1i64
    });
    let m_code = code_of(m.resume());

    // A fiber on a spawned thread panics: the thread keeps running and joins Ok.
    let t = spawn(|| -> i64 {
        let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            panic("np_spawned_thread fiber boom");
            1i64
        });
        let mut good: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            7i64
        });
        let a = code_of(bad.resume());
        let b = code_of(good.resume());
        let c = code_of(bad.resume());
        let d = code_of(good.resume());
        a + b * 10i64 + c * 100i64 + d * 1000i64
    });
    let t_val = match t.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };

    // A panic outside any fiber on a spawned thread keeps today's behaviour: join returns Err.
    let plain = spawn(|| -> i64 {
        panic("np_spawned_thread plain thread boom");
        5i64
    });
    let plain_val = match plain.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };

    print("OK np_spawned_thread ");
    print_int(m_code);
    print(" ");
    print_int(t_val);
    print(" ");
    print_int(plain_val);
    print("\n");
    0
}
