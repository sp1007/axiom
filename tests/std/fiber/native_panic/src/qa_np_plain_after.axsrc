module main

use std.fiber.Fiber
use std.fiber.FiberState

@intrinsic fn panic(msg: str) {}

pub fn main() -> i32 {
    // A contained fiber panic must not change what a panic outside any fiber does: exit 101.
    let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
        panic("qa_np_plain_after fiber boom");
        1i64
    });
    match bad.resume() {
        FiberState.Yielded(_u) => { print("yielded\n"); },
        FiberState.Completed(_r) => { print("completed\n"); },
        FiberState.Panicked => { print("contained\n"); },
    }
    panic("qa_np_plain_after plain boom");
    print("not reached\n");
    0
}
