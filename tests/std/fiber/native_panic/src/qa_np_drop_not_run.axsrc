module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic fn panic(msg: str) {}

struct Guard {
    pub n: *mut i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        unsafe {
            *self.n = *self.n + 1i64;
        }
    }
}

pub fn main() -> i32 {
    let mut count: i64 = 0i64;
    let n: *mut i64 = unsafe { address_of_mut(count) };

    // The live locals of a panicking fiber are not dropped (AXS-EXEC-053.2), also not when its handle is
    // destroyed afterwards.
    {
        let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
            let _g = Guard { n: n };
            yield_now();
            panic("qa_np_drop_not_run boom");
            1i64
        });
        match bad.resume() {
            FiberState.Yielded(_u) => {},
            FiberState.Completed(_r) => {},
            FiberState.Panicked => {},
        }
        match bad.resume() {
            FiberState.Yielded(_u) => {},
            FiberState.Completed(_r) => {},
            FiberState.Panicked => {},
        }
    }
    let after_panic = count;

    // A fiber that completes normally does drop them.
    {
        let mut ok: Fiber<(), i64> = Fiber.new(|| -> i64 {
            let _g = Guard { n: n };
            3i64
        });
        match ok.resume() {
            FiberState.Yielded(_u) => {},
            FiberState.Completed(_r) => {},
            FiberState.Panicked => {},
        }
    }
    print("OK qa_np_drop_not_run ");
    print_int(after_panic);
    print(" ");
    print_int(count);
    print("\n");
    0
}
