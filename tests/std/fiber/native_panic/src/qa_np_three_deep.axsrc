module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now

@intrinsic fn panic(msg: str) {}

// 0 yielded, 2 panicked, 1000 + r completed with r.
fn code_of(st: FiberState<(), i64>) -> i64 {
    match st {
        FiberState.Yielded(_u) => 0i64,
        FiberState.Completed(r) => 1000i64 + r,
        FiberState.Panicked => 2i64,
    }
}

pub fn main() -> i32 {
    // A resumes B resumes C. C panics: B sees Panicked and itself panics: A sees Panicked and finishes.
    let mut a: Fiber<(), i64> = Fiber.new(|| -> i64 {
        let mut b: Fiber<(), i64> = Fiber.new(|| -> i64 {
            let mut c: Fiber<(), i64> = Fiber.new(|| -> i64 {
                yield_now();
                panic("qa_np_three_deep C boom");
                1i64
            });
            let c1 = code_of(c.resume());
            let c2 = code_of(c.resume());
            if c2 == 2i64 {
                panic("qa_np_three_deep B boom");
            }
            c1 * 100i64 + c2
        });
        let b1 = code_of(b.resume());
        // B panicked after C panicked: A is the only one still alive.
        yield_now();
        b1 + 500i64
    });
    let a1 = code_of(a.resume());
    let a2 = code_of(a.resume());
    print("OK qa_np_three_deep ");
    print_int(a1);
    print(" ");
    print_int(a2);
    print("\n");
    0
}
