module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_val

@intrinsic fn panic(msg: str) {}

pub fn main() -> i32 {
    // The fiber yields four values and then panics; every yielded value reaches the resumer and the
    // fifth resume reports Panicked.
    let mut f: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        let mut i: i64 = 1i64;
        while i <= 4i64 {
            yield_val<i64>(i * 11i64);
            i = i + 1i64;
        }
        panic("np_after_yields boom");
        0i64
    });

    let mut yields: i64 = 0i64;
    let mut sum: i64 = 0i64;
    let mut end_code: i64 = -1i64;
    let mut resumes: i64 = 0i64;
    while end_code < 0i64 && resumes < 10i64 {
        resumes = resumes + 1i64;
        match f.resume() {
            FiberState.Yielded(v) => {
                yields = yields + 1i64;
                sum = sum + v;
            },
            FiberState.Completed(_r) => {
                end_code = 1i64;
            },
            FiberState.Panicked => {
                end_code = 2i64;
            },
        }
    }
    check(view(f).is_completed());

    print("OK np_after_yields ");
    print_int(yields);
    print(" ");
    print_int(sum);
    print(" ");
    print_int(end_code);
    print(" ");
    print_int(resumes);
    print("\n");
    0
}
