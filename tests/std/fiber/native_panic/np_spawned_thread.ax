module std.sys.windows.heap

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    if size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    if p as usize == 0 {
        return __ax_host_heap_alloc(new_size, align);
    }
    if new_size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

module std.sys.windows.time

@link("kernel32")
extern "system" {
    fn QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> i32;
    fn QueryPerformanceFrequency(lpFrequency: *mut i64) -> i32;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn __ax_host_monotonic_ns() -> u64 {
    let mut count: [1]i64 = [0i64];
    let mut freq: [1]i64 = [0i64];
    let ok1 = unsafe { QueryPerformanceCounter(address_of_mut(count[0])) };
    let ok2 = unsafe { QueryPerformanceFrequency(address_of_mut(freq[0])) };
    if ok1 == 0 || ok2 == 0 {
        return 0u64;
    }
    let f = freq[0] as u64;
    let c = count[0] as u64;
    if f == 0u64 {
        return 0u64;
    }
    let s = c / f;
    let rem = c % f;
    s * 1_000_000_000u64 + (rem * 1_000_000_000u64) / f
}

module std.sys.windows.thread

// Native backing of host.thread_* / futex_* on x86_64-windows.
//
// Panic containment (T538, SPEC-32, SPEC-34 AXS-EXEC-055.5): a native panic runs the linker stub
// `axiom_panic`, which writes the message and then calls the process-wide panic hook registered
// through `__ax_panic_hook_set` (a linker-provided setter of the data slot `__ax_panic_hook`) before
// it ends the process with exit code 101. The thread runtime registers win_thread_panic_hook when it is
// created: a panic on a spawned thread marks the slot panicked (join returns Err) and ends only that
// thread; on any other thread the hook returns and the process exits with 101. std/sys/windows/fiber.ax
// replaces the hook with one that first handles a panic on a running user fiber and otherwise calls
// win_thread_panic_contain. The process exit import is never patched, so a user exit code (including 101) always
// ends the process unchanged.

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn CreateThread(
        lpThreadAttributes: *mut u8,
        dwStackSize: usize,
        lpStartAddress: fn(*mut u8) -> u32,
        lpParameter: *mut u8,
        dwCreationFlags: u32,
        lpThreadId: *mut u32
    ) -> *mut u8;
    fn WaitForSingleObject(hHandle: *mut u8, dwMilliseconds: u32) -> u32;
    fn CloseHandle(hObject: *mut u8) -> i32;
    fn GetCurrentThreadId() -> u32;
    fn SwitchToThread() -> i32;
    fn Sleep(dwMilliseconds: u32);
    fn ExitThread(dwExitCode: u32);
    fn InitializeCriticalSection(lpCriticalSection: *mut u8);
    fn EnterCriticalSection(lpCriticalSection: *mut u8);
    fn LeaveCriticalSection(lpCriticalSection: *mut u8);
    fn GetLastError() -> u32;
}

@link("api-ms-win-core-synch-l1-2-0")
extern "system" {
    fn WaitOnAddress(address: *const u8, compareAddress: *const u8, addressSize: usize, dwMilliseconds: u32) -> i32;
    fn WakeByAddressSingle(address: *const u8);
    fn WakeByAddressAll(address: *const u8);
}

// Linker-provided runtime stub (compiler/link/import.ax AXIOM_PANIC_HOOK_SET_CODE): atomically stores
// `hook` (the address of a `fn(*const u8, usize) -> u32`, or 0) into `__ax_panic_hook` and returns the
// previous value. Axiom has no extern data declarations, so the slot is reached through this setter.
extern "C" {
    fn __ax_panic_hook_set(hook: usize) -> usize;
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

@repr(C)
struct WinThreadSlot {
    in_use: u32,
    finished: u32,
    detached: u32,
    joining: u32,
    panicked: u32,
    win_tid: u32,
    generation: u32,
    pad0: u32,
    logical_id: u64,
    os_handle: *mut u8,
    entry: fn(*mut u8) -> i64,
    ctx: *mut u8,
    ret_val: i64,
}

@repr(C)
struct WinThreadRt {
    cs: [6]u64,
    main_win_tid: u32,
    pad0: u32,
    next_logical_id: u64,
    slots: *mut *mut WinThreadSlot,
    slot_cap: usize,
}

// Process-wide thread runtime (T537 process-wide statics); null until the first thread call.
static mut WIN_THREAD_RT: *mut WinThreadRt = 0 as *mut WinThreadRt;

unsafe fn fn_entry_to_addr(f: fn(*mut u8) -> i64) -> usize {
    let tmp: [1]fn(*mut u8) -> i64 = [f];
    *(address_of(tmp[0]) as *const usize)
}

pub unsafe fn win_panic_hook_to_addr(f: fn(*const u8, usize) -> u32) -> usize {
    let tmp: [1]fn(*const u8, usize) -> u32 = [f];
    *(address_of(tmp[0]) as *const usize)
}

// Registers `hook` (address of a `fn(*const u8, usize) -> u32`, 0 to clear; the result is ignored) as the process-wide panic hook
// called by `axiom_panic`; returns the previously registered hook.
pub unsafe fn win_panic_hook_set(hook: usize) -> usize {
    __ax_panic_hook_set(hook)
}

unsafe fn slot_ptr_at(arr: *mut *mut WinThreadSlot, idx: usize) -> *mut *mut WinThreadSlot {
    ((arr as usize) + idx * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot
}

unsafe fn win_rt_peek() -> *mut WinThreadRt {
    WIN_THREAD_RT
}

// Panic containment for spawned threads. Called on the panicking thread by the panic hook: when it is
// a live spawned thread of this runtime, the slot is marked panicked (join returns Err) and the
// thread ends with ExitThread(101). Returns on the main thread or on threads the runtime does not own;
// the caller then lets `axiom_panic` exit the process with 101.
pub unsafe fn win_thread_panic_contain() {
    let rt = WIN_THREAD_RT;
    if (rt as usize) == 0 {
        return;
    }
    let cur_tid = GetCurrentThreadId();
    if cur_tid == (*rt).main_win_tid {
        return;
    }
    let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs_ptr);
    let mut idx: usize = 1;
    while idx < (*rt).slot_cap {
        let s = *slot_ptr_at((*rt).slots, idx);
        if (s as usize) != 0 && (*s).in_use != 0u32 && (*s).finished == 0u32 && (*s).win_tid == cur_tid {
            (*s).panicked = 1u32;
            (*s).ret_val = -101i64;
            (*s).finished = 1u32;
            (*s).win_tid = 0u32;
            if (*s).detached != 0u32 {
                let h = (*s).os_handle;
                (*s).os_handle = 0 as *mut u8;
                (*s).in_use = 0u32;
                LeaveCriticalSection(cs_ptr);
                if (h as usize) != 0 {
                    CloseHandle(h);
                }
            } else {
                let p_ctx = (*s).ctx;
                if (p_ctx as usize) != 0 && *(p_ctx as *const u64) == 0x4158544852504B54u64 {
                    let lw = (p_ctx + 8) as *mut u32;
                    *lw = (*lw) | 1u32;
                }
                LeaveCriticalSection(cs_ptr);
            }
            ExitThread(101u32);
        }
        idx = idx + 1;
    }
    LeaveCriticalSection(cs_ptr);
}

// Panic hook registered by the thread runtime (see the module comment).
fn win_thread_panic_hook(_msg: *const u8, _msg_len: usize) -> u32 {
    unsafe {
        win_thread_panic_contain();
    }
    0u32
}

unsafe fn win_rt_get() -> *mut WinThreadRt {
    let existing = WIN_THREAD_RT;
    if (existing as usize) != 0 {
        return existing;
    }
    let heap = GetProcessHeap();
    if (heap as usize) == 0 {
        return 0 as *mut WinThreadRt;
    }
    let rt = HeapAlloc(heap, 8u32, size_of<WinThreadRt>()) as *mut WinThreadRt;
    if (rt as usize) == 0 {
        return 0 as *mut WinThreadRt;
    }
    let init_cap: usize = 256;
    let slots = HeapAlloc(heap, 8u32, init_cap * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot;
    if (slots as usize) == 0 {
        HeapFree(heap, 0u32, rt as *mut u8);
        return 0 as *mut WinThreadRt;
    }
    InitializeCriticalSection(address_of_mut((*rt).cs[0]) as *mut u8);
    (*rt).main_win_tid = GetCurrentThreadId();
    (*rt).next_logical_id = 2u64;
    (*rt).slots = slots;
    (*rt).slot_cap = init_cap;
    WIN_THREAD_RT = rt;
    // Register the thread hook unless a hook is already set (the fiber hook also covers threads).
    let prev = __ax_panic_hook_set(win_panic_hook_to_addr(win_thread_panic_hook));
    if prev != 0usize {
        let _ = __ax_panic_hook_set(prev);
    }
    rt
}

fn win_thread_trampoline(param: *mut u8) -> u32 {
    unsafe {
        let rt = win_rt_peek();
        let s = param as *mut WinThreadSlot;
        if (rt as usize) == 0 || (s as usize) == 0 {
            return 1u32;
        }
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        (*s).win_tid = GetCurrentThreadId();
        let entry = (*s).entry;
        let ctx = (*s).ctx;
        LeaveCriticalSection(cs_ptr);

        let rv = entry(ctx);

        EnterCriticalSection(cs_ptr);
        (*s).ret_val = rv;
        (*s).finished = 1u32;
        (*s).win_tid = 0u32;
        if (*s).detached != 0u32 {
            let h = (*s).os_handle;
            (*s).os_handle = 0 as *mut u8;
            (*s).in_use = 0u32;
            LeaveCriticalSection(cs_ptr);
            if (h as usize) != 0 {
                CloseHandle(h);
            }
        } else {
            LeaveCriticalSection(cs_ptr);
        }
        0u32
    }
}

unsafe fn win_alloc_slot(rt: *mut WinThreadRt) -> usize {
    let heap = GetProcessHeap();
    let mut idx: usize = 1;
    while idx < (*rt).slot_cap {
        let pp = slot_ptr_at((*rt).slots, idx);
        let mut s = *pp;
        if (s as usize) == 0 {
            s = HeapAlloc(heap, 8u32, size_of<WinThreadSlot>()) as *mut WinThreadSlot;
            if (s as usize) == 0 {
                return 0;
            }
            *pp = s;
            return idx;
        }
        if (*s).in_use == 0u32 {
            return idx;
        }
        idx = idx + 1;
    }
    if (*rt).slot_cap >= 32768 {
        return 0;
    }
    let old_cap = (*rt).slot_cap;
    let new_cap = old_cap * 2;
    let new_arr = HeapAlloc(heap, 8u32, new_cap * size_of<*mut WinThreadSlot>()) as *mut *mut WinThreadSlot;
    if (new_arr as usize) == 0 {
        return 0;
    }
    ptr_copy_nonoverlapping<*mut WinThreadSlot>((*rt).slots as *const *mut WinThreadSlot, new_arr, old_cap);
    HeapFree(heap, 0u32, (*rt).slots as *mut u8);
    (*rt).slots = new_arr;
    (*rt).slot_cap = new_cap;
    let s = HeapAlloc(heap, 8u32, size_of<WinThreadSlot>()) as *mut WinThreadSlot;
    if (s as usize) == 0 {
        return 0;
    }
    *slot_ptr_at((*rt).slots, old_cap) = s;
    old_cap
}

pub unsafe fn __ax_host_thread_spawn(entry: fn(*mut u8) -> i64, ctx: *mut u8, stack_size: usize) -> i64 {
    if fn_entry_to_addr(entry) == 0usize {
        return -4i64;
    }
    let rt = win_rt_get();
    if (rt as usize) == 0 {
        return -9i64;
    }
    let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs_ptr);
    let idx = win_alloc_slot(rt);
    if idx == 0 {
        LeaveCriticalSection(cs_ptr);
        return -9i64;
    }
    let s = *slot_ptr_at((*rt).slots, idx);
    let mut gen = (*s).generation + 1u32;
    if gen == 0u32 || gen > 0x7FFFu32 {
        gen = 1u32;
    }
    (*s).in_use = 1u32;
    (*s).finished = 0u32;
    (*s).detached = 0u32;
    (*s).joining = 0u32;
    (*s).panicked = 0u32;
    (*s).win_tid = 0u32;
    (*s).generation = gen;
    (*s).logical_id = (*rt).next_logical_id;
    (*rt).next_logical_id = (*rt).next_logical_id + 1u64;
    (*s).os_handle = 0 as *mut u8;
    (*s).entry = entry;
    (*s).ctx = ctx;
    (*s).ret_val = 0i64;
    if (ctx as usize) != 0 && *(ctx as *const u64) == 0x4158544852504B54u64 {
        *((ctx + 32) as *mut u64) = (*s).logical_id;
    }

    let mut tid: [1]u32 = [0u32];
    let h = CreateThread(0 as *mut u8, stack_size, win_thread_trampoline, s as *mut u8, 0u32, address_of_mut(tid[0]));
    if (h as usize) == 0 {
        (*s).in_use = 0u32;
        LeaveCriticalSection(cs_ptr);
        return -9i64;
    }
    (*s).os_handle = h;
    (*s).win_tid = tid[0];
    let handle_val: i64 = ((gen as i64) << 16) | (idx as i64);
    LeaveCriticalSection(cs_ptr);
    handle_val
}

pub unsafe fn __ax_host_thread_join(h: i64, out_ret: *mut i64) -> i64 {
    if h <= 0i64 {
        return -4i64;
    }
    let rt = win_rt_peek();
    if (rt as usize) == 0 {
        return -4i64;
    }
    let idx = (h & 0xFFFFi64) as usize;
    let gen = ((h >> 16) & 0x7FFFi64) as u32;
    let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
    EnterCriticalSection(cs_ptr);
    if idx == 0 || idx >= (*rt).slot_cap {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    let s = *slot_ptr_at((*rt).slots, idx);
    if (s as usize) == 0 || (*s).in_use == 0u32 || (*s).generation != gen || (*s).detached != 0u32 || (*s).joining != 0u32 {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    if (*s).finished == 0u32 && (*s).win_tid == GetCurrentThreadId() {
        LeaveCriticalSection(cs_ptr);
        return -4i64;
    }
    (*s).joining = 1u32;
    let os_h = (*s).os_handle;
    LeaveCriticalSection(cs_ptr);

    if (os_h as usize) != 0 {
        WaitForSingleObject(os_h, 0xFFFFFFFFu32);
    }

    EnterCriticalSection(cs_ptr);
    let rv = (*s).ret_val;
    (*s).os_handle = 0 as *mut u8;
    (*s).joining = 0u32;
    (*s).in_use = 0u32;
    LeaveCriticalSection(cs_ptr);

    if (os_h as usize) != 0 {
        CloseHandle(os_h);
    }
    if (out_ret as usize) != 0 {
        *out_ret = rv;
    }
    0i64
}

pub fn __ax_host_thread_detach(h: i64) -> i64 {
    if h <= 0i64 {
        return -4i64;
    }
    unsafe {
        let rt = win_rt_peek();
        if (rt as usize) == 0 {
            return -4i64;
        }
        let idx = (h & 0xFFFFi64) as usize;
        let gen = ((h >> 16) & 0x7FFFi64) as u32;
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        if idx == 0 || idx >= (*rt).slot_cap {
            LeaveCriticalSection(cs_ptr);
            return -4i64;
        }
        let s = *slot_ptr_at((*rt).slots, idx);
        if (s as usize) == 0 || (*s).in_use == 0u32 || (*s).generation != gen || (*s).detached != 0u32 || (*s).joining != 0u32 {
            LeaveCriticalSection(cs_ptr);
            return -4i64;
        }
        if (*s).finished != 0u32 {
            let os_h = (*s).os_handle;
            (*s).os_handle = 0 as *mut u8;
            (*s).in_use = 0u32;
            LeaveCriticalSection(cs_ptr);
            if (os_h as usize) != 0 {
                CloseHandle(os_h);
            }
            return 0i64;
        }
        (*s).detached = 1u32;
        LeaveCriticalSection(cs_ptr);
        0i64
    }
}

pub fn __ax_host_thread_current_id() -> u64 {
    unsafe {
        let cur_tid = GetCurrentThreadId();
        let rt = win_rt_get();
        if (rt as usize) == 0 {
            return if cur_tid == 0u32 { 1u64 } else { cur_tid as u64 };
        }
        if cur_tid == (*rt).main_win_tid {
            return 1u64;
        }
        let cs_ptr = address_of_mut((*rt).cs[0]) as *mut u8;
        EnterCriticalSection(cs_ptr);
        let mut idx: usize = 1;
        while idx < (*rt).slot_cap {
            let s = *slot_ptr_at((*rt).slots, idx);
            if (s as usize) != 0 && (*s).in_use != 0u32 && (*s).finished == 0u32 && (*s).win_tid == cur_tid {
                let lid = (*s).logical_id;
                LeaveCriticalSection(cs_ptr);
                return lid;
            }
            idx = idx + 1;
        }
        LeaveCriticalSection(cs_ptr);
        0x8000000000000000u64 | (cur_tid as u64)
    }
}

pub fn __ax_host_thread_yield() {
    unsafe {
        SwitchToThread();
    }
}

pub fn __ax_host_thread_sleep_ns(ns: u64) {
    if ns == 0u64 {
        unsafe { Sleep(0u32); }
        return;
    }
    let mut ms64 = ns / 1_000_000u64;
    if (ns % 1_000_000u64) != 0u64 {
        ms64 = ms64 + 1u64;
    }
    let ms32 = if ms64 >= 0xFFFFFFFEu64 { 0xFFFFFFFEu32 } else { ms64 as u32 };
    unsafe {
        Sleep(ms32);
    }
}

pub unsafe fn __ax_host_futex_wait(addr: *const u32, expected: u32, timeout_ns: u64) -> i64 {
    if (addr as usize) == 0 || ((addr as usize) & 3usize) != 0usize {
        return -4i64;
    }
    let mut timeout_ms: u32 = 0u32;
    if timeout_ns == 0xFFFFFFFFFFFFFFFFu64 {
        timeout_ms = 0xFFFFFFFFu32;
    } else if timeout_ns > 0u64 {
        let mut ms64 = timeout_ns / 1_000_000u64;
        if (timeout_ns % 1_000_000u64) != 0u64 {
            ms64 = ms64 + 1u64;
        }
        timeout_ms = if ms64 >= 0xFFFFFFFEu64 { 0xFFFFFFFEu32 } else { ms64 as u32 };
    }
    let exp_box: [1]u32 = [expected];
    let ok = WaitOnAddress(addr as *const u8, address_of(exp_box[0]) as *const u8, 4usize, timeout_ms);
    if ok != 0 {
        return 0i64;
    }
    if GetLastError() == 1460u32 {
        return -5i64;
    }
    0i64
}

pub unsafe fn __ax_host_futex_wake(addr: *const u32, count: u32) -> i64 {
    if (addr as usize) == 0 || ((addr as usize) & 3usize) != 0usize {
        return -4i64;
    }
    if count == 0u32 {
        return 0i64;
    }
    if count == 1u32 {
        WakeByAddressSingle(addr as *const u8);
        return 1i64;
    }
    WakeByAddressAll(addr as *const u8);
    count as i64
}

module std.sys.windows.fiber

// Native backing of host.fiber_create / fiber_resume / fiber_yield / fiber_destroy on x86_64-windows
// (SPEC-34 AXS-EXEC-055): Win32 fibers (ConvertThreadToFiberEx, CreateFiberEx, SwitchToFiber,
// DeleteFiber). Win32 gives no exported way to read the current fiber, so all bookkeeping lives in a
// per-thread table (@thread_local) that also supplies the handle validation required by the host contract.
//
// Panic containment (T423b, T538, AXS-EXEC-055.5): a native panic runs the linker stub `axiom_panic`,
// which writes the message and then calls the process-wide panic hook (std/sys/windows/thread.ax,
// win_panic_hook_set). On the first resume the fiber layer registers win_fiber_panic_hook: when the
// panicking thread is running a user fiber, the hook marks the slot Panicked and switches back to the
// resumer, whose fiber_resume returns 2. The fiber's stack is abandoned without running drops
// (AXS-EXEC-053.2) and is released by fiber_destroy. Otherwise the hook defers to the thread runtime
// (win_thread_panic_contain: a spawned thread ends and its join returns Err) and then returns, so
// `axiom_panic` exits the process with 101. The process exit import is not patched: a user exit code,
// including 101, called inside a fiber ends the process unchanged.

use std.sys.windows.thread.__ax_host_thread_current_id
use std.sys.windows.thread.win_panic_hook_set
use std.sys.windows.thread.win_panic_hook_to_addr
use std.sys.windows.thread.win_thread_panic_contain

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn GetCurrentThreadId() -> u32;
    fn IsThreadAFiber() -> i32;
    fn ConvertThreadToFiberEx(lpParameter: *mut u8, dwFlags: u32) -> *mut u8;
    fn CreateFiberEx(
        dwStackCommitSize: usize,
        dwStackReserveSize: usize,
        dwFlags: u32,
        lpStartAddress: fn(*mut u8) -> u32,
        lpParameter: *mut u8
    ) -> *mut u8;
    fn SwitchToFiber(lpFiber: *mut u8);
    fn DeleteFiber(lpFiber: *mut u8);
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

const FIBER_ST_SUSPENDED: u32 = 0u32;
const FIBER_ST_RUNNING: u32 = 1u32;
const FIBER_ST_COMPLETED: u32 = 2u32;
const FIBER_ST_PANICKED: u32 = 3u32;

const DEFAULT_STACK_COMMIT: usize = 65536;
const DEFAULT_STACK_RESERVE: usize = 262144;
const HEAP_ZERO_MEMORY: u32 = 8u32;

@repr(C)
struct WinFiberSlot {
    in_use: u32,
    status: u32,
    generation: u32,
    owner_tid: u32,
    entry: fn(*mut u8) -> i64,
    ctx: *mut u8,
    win_fiber: *mut u8,
    caller_fiber: *mut u8,
    prev_cur: *mut WinFiberSlot,
    yield_or_ret: i64,
    resume_arg: i64,
}

// Per-thread state: slot table, the fiber currently running on this thread (null on the root
// context) and the Win32 fiber the thread was converted into.
@thread_local
static mut FIBER_TABLE: *mut *mut WinFiberSlot = 0 as *mut *mut WinFiberSlot;
@thread_local
static mut FIBER_TABLE_CAP: usize = 0;
@thread_local
static mut FIBER_CUR: *mut WinFiberSlot = 0 as *mut WinFiberSlot;
@thread_local
static mut FIBER_ROOT: *mut u8 = 0 as *mut u8;

// Set once the fiber panic hook is registered (process-wide; racing first resumes register the same hook).
static mut FIBER_PANIC_HOOK_SET: u32 = 0u32;

unsafe fn fn_entry_to_addr(f: fn(*mut u8) -> i64) -> usize {
    let tmp: [1]fn(*mut u8) -> i64 = [f];
    *(address_of(tmp[0]) as *const usize)
}

unsafe fn table_at(arr: *mut *mut WinFiberSlot, idx: usize) -> *mut *mut WinFiberSlot {
    ((arr as usize) + idx * size_of<*mut WinFiberSlot>()) as *mut *mut WinFiberSlot
}

unsafe fn lookup_slot(h: i64) -> *mut WinFiberSlot {
    if h <= 0i64 {
        return 0 as *mut WinFiberSlot;
    }
    // handle = (owner thread id << 31) | (generation << 16) | (slot index + 1): unique in the process,
    // so a handle of another thread never resolves to a slot of the calling thread.
    let idx1 = ((h as u64) & 0xFFFFu64) as usize;
    let gen = (((h as u64) >> 16u64) & 0x7FFFu64) as u32;
    let htid = ((h as u64) >> 31u64) as u32;
    if htid != GetCurrentThreadId() {
        return 0 as *mut WinFiberSlot;
    }
    if idx1 == 0 || idx1 > FIBER_TABLE_CAP {
        return 0 as *mut WinFiberSlot;
    }
    let s = *table_at(FIBER_TABLE, idx1 - 1);
    if (s as usize) == 0 || (*s).in_use == 0u32 || (*s).generation != gen || (*s).owner_tid != GetCurrentThreadId() {
        return 0 as *mut WinFiberSlot;
    }
    s
}

// Panic hook (see the module comment). Runs on the stack of the panicking code.
fn win_fiber_panic_hook(_msg: *const u8, _msg_len: usize) -> u32 {
    unsafe {
        let s = FIBER_CUR;
        if (s as usize) != 0 && (*s).status == FIBER_ST_RUNNING {
            // A panic on a user fiber stack: finish the fiber as Panicked and return to its resumer.
            // The slot never becomes Suspended again, so this stack is never switched back to.
            (*s).yield_or_ret = 0i64;
            (*s).status = FIBER_ST_PANICKED;
            SwitchToFiber((*s).caller_fiber);
        }
        // Not on a user fiber: a spawned thread ends here; otherwise return and let the process exit.
        win_thread_panic_contain();
    }
    0u32
}

// Registers win_fiber_panic_hook as the process-wide panic hook (once per process).
unsafe fn win_fiber_register_panic_hook() {
    if FIBER_PANIC_HOOK_SET != 0u32 {
        return;
    }
    // Create the thread runtime first: it registers its own hook only when none is set, so the fiber
    // hook (which also covers spawned threads) is never replaced by it.
    let _ = __ax_host_thread_current_id();
    let _ = win_panic_hook_set(win_panic_hook_to_addr(win_fiber_panic_hook));
    FIBER_PANIC_HOOK_SET = 1u32;
}

// Returns the 0-based index of a free slot (creating it) or 0xFFFFFFFF on allocation failure.
unsafe fn alloc_slot_index() -> usize {
    let heap = GetProcessHeap();
    if (heap as usize) == 0 {
        return 0xFFFFFFFFusize;
    }
    let mut i: usize = 0;
    while i < FIBER_TABLE_CAP {
        let pp = table_at(FIBER_TABLE, i);
        let s = *pp;
        if (s as usize) == 0 {
            let ns = HeapAlloc(heap, HEAP_ZERO_MEMORY, size_of<WinFiberSlot>()) as *mut WinFiberSlot;
            if (ns as usize) == 0 {
                return 0xFFFFFFFFusize;
            }
            *pp = ns;
            return i;
        }
        if (*s).in_use == 0u32 {
            return i;
        }
        i = i + 1;
    }
    let old_cap = FIBER_TABLE_CAP;
    let new_cap: usize = if old_cap == 0 { 16 } else { old_cap * 2 };
    let new_tbl = HeapAlloc(heap, HEAP_ZERO_MEMORY, new_cap * size_of<*mut WinFiberSlot>()) as *mut *mut WinFiberSlot;
    if (new_tbl as usize) == 0 {
        return 0xFFFFFFFFusize;
    }
    if old_cap > 0 {
        ptr_copy_nonoverlapping<*mut WinFiberSlot>(FIBER_TABLE as *const *mut WinFiberSlot, new_tbl, old_cap);
        HeapFree(heap, 0u32, FIBER_TABLE as *mut u8);
    }
    FIBER_TABLE = new_tbl;
    FIBER_TABLE_CAP = new_cap;
    let ns = HeapAlloc(heap, HEAP_ZERO_MEMORY, size_of<WinFiberSlot>()) as *mut WinFiberSlot;
    if (ns as usize) == 0 {
        return 0xFFFFFFFFusize;
    }
    *table_at(FIBER_TABLE, old_cap) = ns;
    old_cap
}

// Win32 fiber start routine. It must never return: when the entry function is done it records the
// result and switches back to whoever resumed the fiber; the resumer then deletes the fiber.
fn win_fiber_trampoline(param: *mut u8) -> u32 {
    unsafe {
        let slot = param as *mut WinFiberSlot;
        let entry = (*slot).entry;
        let ctx = (*slot).ctx;
        let rv = entry(ctx);
        (*slot).yield_or_ret = rv;
        (*slot).status = FIBER_ST_COMPLETED;
        SwitchToFiber((*slot).caller_fiber);
    }
    // Unreachable: a completed fiber is never switched to again.
    0u32
}

pub unsafe fn __ax_host_fiber_create(entry: fn(*mut u8) -> i64, ctx: *mut u8, stack_commit: usize, stack_reserve: usize) -> i64 {
    if fn_entry_to_addr(entry) == 0usize {
        return -4i64;
    }
    let idx = alloc_slot_index();
    if idx == 0xFFFFFFFFusize || idx >= 0xFFFFusize {
        return -9i64;
    }
    let s = *table_at(FIBER_TABLE, idx);
    let mut gen = (*s).generation + 1u32;
    if gen == 0u32 || gen > 0x7FFFu32 {
        gen = 1u32;
    }
    let commit: usize = if stack_commit == 0 { DEFAULT_STACK_COMMIT } else { stack_commit };
    let reserve: usize = if stack_reserve == 0 { DEFAULT_STACK_RESERVE } else { stack_reserve };
    (*s).in_use = 1u32;
    (*s).status = FIBER_ST_SUSPENDED;
    (*s).generation = gen;
    (*s).owner_tid = GetCurrentThreadId();
    (*s).entry = entry;
    (*s).ctx = ctx;
    (*s).caller_fiber = 0 as *mut u8;
    (*s).prev_cur = 0 as *mut WinFiberSlot;
    (*s).yield_or_ret = 0i64;
    (*s).resume_arg = 0i64;
    let wf = CreateFiberEx(commit, reserve, 0u32, win_fiber_trampoline, s as *mut u8);
    if (wf as usize) == 0 {
        (*s).in_use = 0u32;
        return -9i64;
    }
    (*s).win_fiber = wf;
    (((GetCurrentThreadId() as u64) << 31u64) | ((gen as u64) << 16u64) | ((idx + 1) as u64)) as i64
}

pub unsafe fn __ax_host_fiber_resume(h: i64, arg: i64, out_val: *mut i64) -> i64 {
    let s = lookup_slot(h);
    if (s as usize) == 0 || (*s).status != FIBER_ST_SUSPENDED {
        return -4i64;
    }
    win_fiber_register_panic_hook();
    let mut caller: *mut u8 = 0 as *mut u8;
    if (FIBER_CUR as usize) != 0 {
        caller = (*FIBER_CUR).win_fiber;
    } else {
        if (FIBER_ROOT as usize) == 0 {
            if IsThreadAFiber() != 0 {
                // The thread already runs as a fiber we do not own: its root cannot be recovered.
                return -9i64;
            }
            let root = ConvertThreadToFiberEx(0 as *mut u8, 0u32);
            if (root as usize) == 0 {
                return -9i64;
            }
            FIBER_ROOT = root;
        }
        caller = FIBER_ROOT;
    }
    (*s).caller_fiber = caller;
    (*s).prev_cur = FIBER_CUR;
    (*s).resume_arg = arg;
    (*s).status = FIBER_ST_RUNNING;
    FIBER_CUR = s;
    SwitchToFiber((*s).win_fiber);
    // Back on the resumer's stack: the fiber yielded or finished.
    FIBER_CUR = (*s).prev_cur;
    if (out_val as usize) != 0 {
        *out_val = (*s).yield_or_ret;
    }
    if (*s).status == FIBER_ST_COMPLETED {
        return 1i64;
    }
    if (*s).status == FIBER_ST_PANICKED {
        return 2i64;
    }
    0i64
}

pub unsafe fn __ax_host_fiber_yield(val: i64) -> i64 {
    let s = FIBER_CUR;
    if (s as usize) == 0 {
        return -4i64;
    }
    (*s).yield_or_ret = val;
    (*s).status = FIBER_ST_SUSPENDED;
    SwitchToFiber((*s).caller_fiber);
    // Resumed again.
    (*s).resume_arg
}

pub unsafe fn __ax_host_fiber_destroy(h: i64) -> i64 {
    let s = lookup_slot(h);
    if (s as usize) == 0 || (*s).status == FIBER_ST_RUNNING {
        return -4i64;
    }
    DeleteFiber((*s).win_fiber);
    (*s).win_fiber = 0 as *mut u8;
    (*s).in_use = 0u32;
    0i64
}

module std.time

use std.core.host.monotonic_ns

pub struct Duration {
    pub nanos: u64,
}

pub fn duration_from_nanos(nanos: u64) -> Duration {
    Duration { nanos: nanos }
}

pub fn duration_from_millis(millis: u64) -> Duration {
    Duration { nanos: millis * 1_000_000u64 }
}

pub fn duration_from_secs(secs: u64) -> Duration {
    Duration { nanos: secs * 1_000_000_000u64 }
}

pub fn duration_as_nanos(d: view<Duration>) -> u64 {
    d.nanos
}

pub fn duration_as_millis(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000u64
}

pub fn duration_as_secs(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000_000u64
}

impl Duration {
    pub fn from_nanos(nanos: u64) -> Duration { duration_from_nanos(nanos) }
    pub fn from_millis(millis: u64) -> Duration { duration_from_millis(millis) }
    pub fn from_secs(secs: u64) -> Duration { duration_from_secs(secs) }
    pub fn as_nanos(self: view<Duration>) -> u64 { duration_as_nanos(self) }
    pub fn as_millis(self: view<Duration>) -> u64 { duration_as_millis(self) }
    pub fn as_secs(self: view<Duration>) -> u64 { duration_as_secs(self) }
}

pub struct Instant {
    pub nanos: u64,
}

pub fn instant_now() -> Instant {
    let t = monotonic_ns();
    Instant { nanos: t }
}

pub fn instant_duration_since(self: view<Instant>, earlier: view<Instant>) -> Duration {
    if self.nanos >= earlier.nanos {
        Duration { nanos: self.nanos - earlier.nanos }
    } else {
        Duration { nanos: 0u64 }
    }
}

pub fn instant_elapsed(self: view<Instant>) -> Duration {
    let now = instant_now();
    instant_duration_since(view(now), self)
}

pub fn instant_as_nanos(self: view<Instant>) -> u64 {
    self.nanos
}

pub fn instant_as_millis(self: view<Instant>) -> u64 {
    self.nanos / 1_000_000u64
}

pub fn instant_as_secs(self: view<Instant>) -> u64 {
    self.nanos / 1_000_000_000u64
}

impl Instant {
    pub fn now() -> Instant { instant_now() }
    pub fn duration_since(self: view<Instant>, earlier: view<Instant>) -> Duration { instant_duration_since(self, earlier) }
    pub fn elapsed(self: view<Instant>) -> Duration { instant_elapsed(self) }
}

module std.text.utf8

use std.core.result.Result

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

pub fn utf8_error_position(err: Utf8Error) -> usize {
    match err {
        Utf8Error.InvalidByte(p) => p,
        Utf8Error.Truncated(p) => p,
        Utf8Error.Overlong(p) => p,
        Utf8Error.Surrogate(p) => p,
        Utf8Error.OutOfRange(p) => p,
        Utf8Error.InvalidBoundary(p) => p,
    }
}

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

pub fn char_len_utf8(c: char) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        1
    } else if u <= 0x7FF {
        2
    } else if u <= 0xFFFF {
        3
    } else {
        4
    }
}

pub unsafe fn char_encode_utf8(c: char, dst: *mut u8) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        *dst = u as u8;
        1
    } else if u <= 0x7FF {
        *dst = (0xC0 | (u >> 6)) as u8;
        *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        2
    } else if u <= 0xFFFF {
        *dst = (0xE0 | (u >> 12)) as u8;
        *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        3
    } else {
        *dst = (0xF0 | (u >> 18)) as u8;
        *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        4
    }
}

impl char {
    pub fn len_utf8(self: char) -> usize {
        char_len_utf8(self)
    }

    pub unsafe fn encode_utf8(self: char, dst: *mut u8) -> usize {
        char_encode_utf8(self, dst)
    }
}

pub fn decode_char_at(bytes: view<[u8]>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub fn is_char_boundary(bytes: view<[u8]>, offset: usize) -> bool {
    let n = len(bytes);
    if offset == 0 || offset == n {
        return true;
    }
    if offset > n {
        return false;
    }
    let b = bytes[offset];
    (b & 0xC0) != 0x80
}

pub fn char_count(bytes: view<[u8]>) -> Result<usize, Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    let mut count: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                count = count + 1;
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(count)
}

pub fn validate_utf8(bytes: view<[u8]>) -> Result<(), Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(())
}

module std.text.string

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.text.utf8.Utf8Error
use std.text.utf8.char_len_utf8
use std.text.utf8.char_encode_utf8
use std.text.utf8.validate_utf8

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
    }
}

pub fn string_len(s: view<String>) -> usize {
    s.len
}

pub fn string_capacity(s: view<String>) -> usize {
    s.cap
}

pub fn string_is_empty(s: view<String>) -> bool {
    s.len == 0
}

pub fn string_clear(s: mut_view<String>) {
    s.len = 0;
}

pub fn string_reserve(s: mut_view<String>, additional: usize) {
    let needed = s.len + additional;
    if needed <= s.cap {
        return;
    }
    let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
    if new_cap < needed {
        new_cap = needed;
    }
    let raw = unsafe { heap_alloc(new_cap, 8) };
    let new_ptr = raw as *mut u8;
    if s.len > 0 && s.ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
            heap_free(s.ptr, s.cap, 8);
        }
    }
    s.ptr = new_ptr;
    s.cap = new_cap;
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = char_len_utf8(c);
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        char_encode_utf8(c, dst);
    }
    s.len = s.len + clen;
}

pub fn string_push_str(s: mut_view<String>, other: view<String>) {
    if other.len == 0 {
        return;
    }
    let needed = s.len + other.len;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        ptr_copy_nonoverlapping<u8>(other.ptr as *const u8, dst, other.len);
    }
    s.len = s.len + other.len;
}

pub fn string_push_bytes(s: mut_view<String>, bytes: view<[u8]>) -> Result<(), Utf8Error> {
    match validate_utf8(bytes) {
        Result.Ok(u) => {
            let n = len(bytes);
            if n == 0 {
                return Result.Ok(());
            }
            let needed = s.len + n;
            if needed > s.cap {
                let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
                if new_cap < needed {
                    new_cap = needed;
                }
                let raw = unsafe { heap_alloc(new_cap, 8) };
                let new_ptr = raw as *mut u8;
                if s.len > 0 && s.ptr as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                        heap_free(s.ptr, s.cap, 8);
                    }
                }
                s.ptr = new_ptr;
                s.cap = new_cap;
            }
            let dst = unsafe { s.ptr + s.len };
            let mut i: usize = 0;
            while i < n {
                unsafe {
                    *(dst + i) = bytes[i];
                }
                i = i + 1;
            }
            s.len = s.len + n;
            Result.Ok(())
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn string_clone(s: view<String>) -> String {
    if s.len == 0 {
        return string_new();
    }
    let mut res = string_with_capacity(s.len);
    unsafe {
        ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, res.ptr, s.len);
    }
    res.len = s.len;
    res
}

pub fn string_concat(a: view<String>, b: view<String>) -> String {
    let total_len = a.len + b.len;
    if total_len == 0 {
        return string_new();
    }
    let mut res = string_with_capacity(total_len);
    if a.len > 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(a.ptr as *const u8, res.ptr, a.len);
        }
    }
    if b.len > 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, res.ptr + a.len, b.len);
        }
    }
    res.len = total_len;
    res
}

pub fn string_eq(a: view<String>, b: view<String>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn string_cmp(a: view<String>, b: view<String>) -> i32 {
    let alen = a.len;
    let blen = b.len;
    let min_len = if alen < blen { alen } else { blen };
    let mut i: usize = 0;
    while i < min_len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba < bb {
            return -1;
        } else if ba > bb {
            return 1;
        }
        i = i + 1;
    }
    if alen < blen {
        -1
    } else if alen > blen {
        1
    } else {
        0
    }
}

pub fn string_is_char_boundary(s: view<String>, offset: usize) -> bool {
    if offset == 0 || offset == s.len {
        return true;
    }
    if offset > s.len {
        return false;
    }
    let b = unsafe { *(s.ptr + offset) };
    (b & 0xC0) != 0x80
}

pub fn string_char_count(s: view<String>) -> usize {
    let mut count: usize = 0;
    let mut i: usize = 0;
    while i < s.len {
        let b = unsafe { *(s.ptr + i) };
        if (b & 0xC0) != 0x80 {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

pub fn string_slice(s: view<String>, start: usize, end: usize) -> Result<String, Utf8Error> {
    if start > end || end > s.len {
        return Result.Err(Utf8Error.InvalidBoundary(start));
    }
    if !string_is_char_boundary(s, start) {
        return Result.Err(Utf8Error.InvalidBoundary(start));
    }
    if !string_is_char_boundary(s, end) {
        return Result.Err(Utf8Error.InvalidBoundary(end));
    }
    let slice_len = end - start;
    if slice_len == 0 {
        return Result.Ok(string_new());
    }
    let mut res = string_with_capacity(slice_len);
    unsafe {
        ptr_copy_nonoverlapping<u8>(s.ptr + start, res.ptr, slice_len);
    }
    res.len = slice_len;
    Result.Ok(res)
}

pub fn string_from_utf8(bytes: view<[u8]>) -> Result<String, Utf8Error> {
    match validate_utf8(bytes) {
        Result.Ok(u) => {
            let n = len(bytes);
            if n == 0 {
                return Result.Ok(string_new());
            }
            let mut s = string_with_capacity(n);
            let mut i: usize = 0;
            while i < n {
                unsafe {
                    *(s.ptr + i) = bytes[i];
                }
                i = i + 1;
            }
            s.len = n;
            Result.Ok(s)
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn string_from_chars(chars: view<[char]>) -> String {
    let n = len(chars);
    let mut total_bytes: usize = 0;
    let mut i: usize = 0;
    while i < n {
        total_bytes = total_bytes + char_len_utf8(chars[i]);
        i = i + 1;
    }
    if total_bytes == 0 {
        return string_new();
    }
    let mut s = string_with_capacity(total_bytes);
    i = 0;
    while i < n {
        string_push_char(mut_view(s), chars[i]);
        i = i + 1;
    }
    s
}

impl String {
    pub fn len(self: view<String>) -> usize { self.len }
    pub fn capacity(self: view<String>) -> usize { self.cap }
    pub fn is_empty(self: view<String>) -> bool { self.len == 0 }
    pub fn clear(self: mut_view<String>) { string_clear(self); }
    pub fn reserve(self: mut_view<String>, additional: usize) { string_reserve(self, additional); }
    pub fn push_char(self: mut_view<String>, c: char) { string_push_char(self, c); }
    pub fn push_str(self: mut_view<String>, other: view<String>) { string_push_str(self, other); }
    pub fn push_bytes(self: mut_view<String>, bytes: view<[u8]>) -> Result<(), Utf8Error> { string_push_bytes(self, bytes) }
    pub fn clone(self: view<String>) -> String { string_clone(self) }
    pub fn concat(self: view<String>, other: view<String>) -> String { string_concat(self, other) }
    pub fn eq(self: view<String>, other: view<String>) -> bool { string_eq(self, other) }
    pub fn cmp(self: view<String>, other: view<String>) -> i32 { string_cmp(self, other) }
    pub fn is_char_boundary(self: view<String>, offset: usize) -> bool { string_is_char_boundary(self, offset) }
    pub fn char_count(self: view<String>) -> usize { string_char_count(self) }
    pub fn slice(self: view<String>, start: usize, end: usize) -> Result<String, Utf8Error> { string_slice(self, start, end) }
}

module std.thread.local

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic fn panic(msg: str) {}

pub fn default_local_drop(ptr: *mut u8) -> () {
    if (ptr as usize) != 0 {
        unsafe {
            heap_free(ptr, 8usize, 8usize);
        }
    }
}

pub struct LocalSlotNode {
    pub slot_id: usize,
    pub val_ptr: *mut u8,
    pub borrow_state: i32,
    pub drop_fn: fn(*mut u8) -> (),
    pub next: *mut LocalSlotNode,
}

@thread_local
static mut LOCAL_SLOTS_HEAD: *mut LocalSlotNode = 0 as *mut LocalSlotNode;

pub struct LocalKey<T> {
    pub init_fn: fn() -> T,
    pub drop_fn: fn(*mut u8) -> (),
    pub slot_id: u32,
}

impl<T> !Send for LocalKey<T> {}
impl<T> !Share for LocalKey<T> {}

pub fn local_key_new<T>(init_fn: fn() -> T) -> LocalKey<T> {
    LocalKey {
        init_fn: init_fn,
        drop_fn: default_local_drop,
        slot_id: 0u32,
    }
}

pub fn local_key_new_with_drop<T>(init_fn: fn() -> T, drop_fn: fn(*mut u8) -> ()) -> LocalKey<T> {
    LocalKey {
        init_fn: init_fn,
        drop_fn: drop_fn,
        slot_id: 0u32,
    }
}

impl<T> LocalKey<T> {
    pub fn new(init_fn: fn() -> T) -> LocalKey<T> {
        LocalKey {
            init_fn: init_fn,
            drop_fn: default_local_drop,
            slot_id: 0u32,
        }
    }

    pub fn new_with_drop(init_fn: fn() -> T, drop_fn: fn(*mut u8) -> ()) -> LocalKey<T> {
        LocalKey {
            init_fn: init_fn,
            drop_fn: drop_fn,
            slot_id: 0u32,
        }
    }

    fn find_or_create_node(self: view<LocalKey<T>>) -> *mut LocalSlotNode {
        let mut target_id: usize = self.slot_id as usize;
        if target_id == 0usize {
            target_id = unsafe { *(address_of(self) as *const usize) };
        }
        let mut cur = unsafe { LOCAL_SLOTS_HEAD };
        while (cur as usize) != 0 {
            if (unsafe { (*cur).slot_id }) == target_id {
                return cur;
            }
            cur = unsafe { (*cur).next };
        }

        let init = self.init_fn;
        let val: T = init();
        let box_sz = if size_of<T>() == 0 { 8 } else { size_of<T>() };
        let box_al = if align_of<T>() < 8 { 8 } else { align_of<T>() };
        let v_raw = unsafe { heap_alloc(box_sz, box_al) };
        if (v_raw as usize) == 0 {
            panic("out of memory allocating LocalKey storage");
        }
        let v_box = v_raw as *mut T;
        unsafe {
            *v_box = val;
        }

        let node_raw = unsafe { heap_alloc(size_of<LocalSlotNode>(), align_of<LocalSlotNode>()) };
        if (node_raw as usize) == 0 {
            panic("out of memory allocating LocalSlotNode");
        }
        let node = node_raw as *mut LocalSlotNode;
        unsafe {
            *node = LocalSlotNode {
                slot_id: target_id,
                val_ptr: v_raw,
                borrow_state: 0i32,
                drop_fn: self.drop_fn,
                next: LOCAL_SLOTS_HEAD,
            };
            LOCAL_SLOTS_HEAD = node;
        }
        node
    }

    pub fn with(self: view<LocalKey<T>>, f: fn(view<T>) -> ()) {
        let node = self.find_or_create_node();
        let st = unsafe { (*node).borrow_state };
        if st < 0 {
            panic("LocalKey: cannot borrow immutably while mutably borrowed");
        }
        let val_raw: *const T = unsafe { (*node).val_ptr as *const T };
        let v: view<T> = unsafe { view(*val_raw) };
        unsafe {
            (*node).borrow_state = st + 1;
        }
        f(v);
        unsafe {
            (*node).borrow_state = (*node).borrow_state - 1;
        }
    }

    pub fn with_mut(self: view<LocalKey<T>>, f: fn(mut_view<T>) -> ()) {
        let node = self.find_or_create_node();
        let st = unsafe { (*node).borrow_state };
        if st != 0 {
            panic("LocalKey: cannot borrow mutably while already borrowed");
        }
        let val_raw: *mut T = unsafe { (*node).val_ptr as *mut T };
        let v: mut_view<T> = unsafe { mut_view(*val_raw) };
        unsafe {
            (*node).borrow_state = -1;
        }
        f(v);
        unsafe {
            (*node).borrow_state = 0;
        }
    }

    pub fn get(self: view<LocalKey<T>>) -> T where T: Copy {
        let node = self.find_or_create_node();
        let st = unsafe { (*node).borrow_state };
        if st < 0 {
            panic("LocalKey: cannot borrow immutably while mutably borrowed");
        }
        let ptr = unsafe { (*node).val_ptr };
        unsafe { *(ptr as *const T) }
    }

    pub fn set(self: view<LocalKey<T>>, val: T) {
        let node = self.find_or_create_node();
        let st = unsafe { (*node).borrow_state };
        if st != 0 {
            panic("LocalKey: cannot borrow mutably while already borrowed");
        }
        let ptr = unsafe { (*node).val_ptr };
        unsafe { *(ptr as *mut T) = val; }
    }
}

pub fn thread_local_cleanup() {
    let mut cur = unsafe { LOCAL_SLOTS_HEAD };
    unsafe {
        LOCAL_SLOTS_HEAD = 0 as *mut LocalSlotNode;
    }
    while (cur as usize) != 0 {
        let next_node = unsafe { (*cur).next };
        let dfn = unsafe { (*cur).drop_fn };
        let vp = unsafe { (*cur).val_ptr };
        let dfn_addr = unsafe { *(address_of(dfn) as *const usize) };
        if dfn_addr != 0usize && (vp as usize) != 0 {
            dfn(vp);
        }
        unsafe {
            heap_free(cur as *mut u8, size_of<LocalSlotNode>(), align_of<LocalSlotNode>());
        }
        cur = next_node;
    }
}

module std.thread

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.thread_spawn
use std.core.host.thread_join
use std.core.host.thread_detach
use std.core.host.thread_current_id
use std.core.host.thread_yield
use std.core.host.thread_sleep_ns
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.sync.atomic.fence
use std.text.string.String
use std.text.string.string_new
use std.text.string.string_with_capacity
use std.text.string.string_clone
use std.time.Duration
pub use std.thread.local.LocalKey
pub use std.thread.local.local_key_new
pub use std.thread.local.local_key_new_with_drop
pub use std.thread.local.thread_local_cleanup

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic fn forget<T>(val: T) {}
@intrinsic fn panic(msg: str) {}

const AX_THREAD_SLOT_MAGIC: u64 = 0x4158544852504B54u64;
const FLAG_CHILD_DONE: u32 = 1u32;
const FLAG_PARENT_DETACHED: u32 = 2u32;

@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    0i64
}

fn str_to_owned_string(s: str) -> String {
    let n = len(s);
    if n == 0 {
        return string_new();
    }
    let bs: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let mut out = string_with_capacity(n);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(out.ptr + i) = bs[i];
        }
        i = i + 1;
    }
    out.len = n;
    out
}

fn string_as_str_slice(s: view<String>) -> str {
    let mut raw_words: [2]usize = [s.ptr as usize, s.len];
    unsafe { *(address_of(raw_words[0]) as *const str) }
}

@derive(Copy)
pub struct ThreadId {
    pub id: u64,
}

impl ThreadId {
    pub fn as_u64(self: view<ThreadId>) -> u64 {
        self.id
    }

    pub fn eq(self: view<ThreadId>, other: view<ThreadId>) -> bool {
        self.id == other.id
    }

    pub fn clone(self: view<ThreadId>) -> ThreadId {
        *self
    }
}

pub struct Thread {
    pub id: ThreadId,
    pub has_name: bool,
    pub name_buf: String,
}

unsafe impl Send for Thread {}
unsafe impl Share for Thread {}

impl Thread {
    pub fn id(self: view<Thread>) -> ThreadId {
        self.id
    }

    pub fn name(self: view<Thread>) -> Option<str> {
        if self.has_name {
            Option.Some(string_as_str_slice(view(self.name_buf)))
        } else {
            Option.None
        }
    }

    pub fn clone(self: view<Thread>) -> Thread {
        Thread {
            id: self.id,
            has_name: self.has_name,
            name_buf: if self.has_name { string_clone(view(self.name_buf)) } else { string_new() },
        }
    }
}

@derive(Copy)
pub enum ThreadError {
    SpawnFailed,
    InvalidConfig,
}

impl ThreadError {
    pub fn eq(self: view<ThreadError>, other: view<ThreadError>) -> bool {
        let a = match *self {
            ThreadError.SpawnFailed => 0u8,
            ThreadError.InvalidConfig => 1u8,
        };
        let b = match *other {
            ThreadError.SpawnFailed => 0u8,
            ThreadError.InvalidConfig => 1u8,
        };
        a == b
    }

    pub fn clone(self: view<ThreadError>) -> ThreadError {
        *self
    }
}

pub struct ThreadPanic {
    pub message: String,
    pub thread_id: ThreadId,
}

unsafe impl Send for ThreadPanic {}
unsafe impl Share for ThreadPanic {}

impl ThreadPanic {
    pub fn message(self: view<ThreadPanic>) -> str {
        string_as_str_slice(view(self.message))
    }

    pub fn thread_id(self: view<ThreadPanic>) -> ThreadId {
        self.thread_id
    }
}

fn make_thread_panic(tid: ThreadId) -> ThreadPanic {
    ThreadPanic {
        message: str_to_owned_string("child thread panicked"),
        thread_id: tid,
    }
}

// Shared heap control slot between parent handle and child trampoline.
// Byte offsets 0 (magic: u64), 8 (lifecycle: Atomic<u32>), and 32 (assigned_tid: u64)
// match the host runtime contract in std/sys/windows/thread.ax and compiler/interp/interp.ax.
@repr(C)
struct SpawnSlot {
    pub magic: u64,
    pub lifecycle: Atomic<u32>,
    pub phase: u32,
    pub stack_size: usize,
    pub raw_handle: i64,
    pub assigned_tid: u64,
    pub closure_ptr: *mut u8,
    pub val_ptr: *mut u8,
    pub cleanup_fn: fn(*mut u8) -> i64,
}

fn box_size(sz: usize) -> usize {
    if sz == 0 { 8 } else { sz }
}

fn box_align(al: usize) -> usize {
    if al < 8 { 8 } else { al }
}

unsafe fn spawn_slot_new(stack_size: usize, closure_ptr: *mut u8) -> *mut SpawnSlot {
    let raw = heap_alloc(size_of<SpawnSlot>(), align_of<SpawnSlot>());
    if (raw as usize) == 0 {
        return 0 as *mut SpawnSlot;
    }
    let s = raw as *mut SpawnSlot;
    (*s).magic = AX_THREAD_SLOT_MAGIC;
    (*s).lifecycle = Atomic.new(0u32);
    (*s).phase = 0u32;
    (*s).stack_size = stack_size;
    (*s).raw_handle = 0i64;
    (*s).assigned_tid = 0u64;
    (*s).closure_ptr = closure_ptr;
    (*s).val_ptr = 0 as *mut u8;
    (*s).cleanup_fn = __ax_thread_self_entry;
    s
}

unsafe fn ax_spawn_trampoline<F: FnOnce<T> + Send, T: Send>(raw_typed: *mut (F, T)) -> i64 {
    let raw = raw_typed as *mut u8;
    let slot = raw as *mut SpawnSlot;
    let ph = (*slot).phase;
    let res_sz = box_size(size_of<Result<T, ThreadPanic>>());
    let res_al = box_align(align_of<Result<T, ThreadPanic>>());
    if ph == 0u32 {
        (*slot).cleanup_fn = __ax_thread_self_entry;
        (*slot).phase = 1u32;
        let h = thread_spawn(__ax_thread_self_entry, raw, (*slot).stack_size);
        (*slot).raw_handle = h;
        return h;
    }
    if ph == 2u32 {
        let c_ptr = (*slot).closure_ptr;
        (*slot).closure_ptr = 0 as *mut u8;
        if (c_ptr as usize) != 0 {
            if needs_drop<F>() {
                drop_in_place<F>(c_ptr as *mut F);
            }
            heap_free(c_ptr, box_size(size_of<F>()), box_align(align_of<F>()));
        }
        let v_ptr = (*slot).val_ptr;
        (*slot).val_ptr = 0 as *mut u8;
        if (v_ptr as usize) != 0 {
            if needs_drop<Result<T, ThreadPanic>>() {
                drop_in_place<Result<T, ThreadPanic>>(v_ptr as *mut Result<T, ThreadPanic>);
            }
            heap_free(v_ptr, res_sz, res_al);
        }
        (*slot).magic = 0u64;
        heap_free(raw, size_of<SpawnSlot>(), align_of<SpawnSlot>());
        return 0i64;
    }
    if ph == 3u32 {
        let c_ptr = (*slot).closure_ptr;
        (*slot).closure_ptr = 0 as *mut u8;
        if (c_ptr as usize) != 0 {
            if needs_drop<F>() {
                drop_in_place<F>(c_ptr as *mut F);
            }
            heap_free(c_ptr, box_size(size_of<F>()), box_align(align_of<F>()));
        }
        let old_v = (*slot).val_ptr;
        (*slot).val_ptr = 0 as *mut u8;
        if (old_v as usize) != 0 {
            if needs_drop<Result<T, ThreadPanic>>() {
                drop_in_place<Result<T, ThreadPanic>>(old_v as *mut Result<T, ThreadPanic>);
            }
            heap_free(old_v, res_sz, res_al);
        }
        let r_raw = heap_alloc(res_sz, res_al);
        thread_local_cleanup();
        let r_box = r_raw as *mut Result<T, ThreadPanic>;
        *r_box = Result.Err(make_thread_panic(ThreadId { id: (*slot).assigned_tid }));
        (*slot).val_ptr = r_raw;
        return 0i64;
    }
    if ph == 4u32 {
        let v_ptr = (*slot).val_ptr;
        (*slot).val_ptr = 0 as *mut u8;
        if (v_ptr as usize) != 0 {
            heap_free(v_ptr, res_sz, res_al);
        }
        (*slot).magic = 0u64;
        heap_free(raw, size_of<SpawnSlot>(), align_of<SpawnSlot>());
        return 0i64;
    }

    let c_ptr = (*slot).closure_ptr;
    (*slot).closure_ptr = 0 as *mut u8;
    let f_box = c_ptr as *mut F;
    let f_val = *f_box;
    heap_free(c_ptr, box_size(size_of<F>()), box_align(align_of<F>()));

    let out_val: T = f_val();
    thread_local_cleanup();
    let v_raw = heap_alloc(res_sz, res_al);
    let v_box = v_raw as *mut Result<T, ThreadPanic>;
    *v_box = Result.Ok(out_val);
    (*slot).val_ptr = v_raw;

    let prev = (*slot).lifecycle.fetch_or(FLAG_CHILD_DONE, Ordering.AcqRel);
    if (prev & FLAG_PARENT_DETACHED) != 0u32 {
        (*slot).val_ptr = 0 as *mut u8;
        if needs_drop<Result<T, ThreadPanic>>() {
            drop_in_place<Result<T, ThreadPanic>>(v_box);
        }
        heap_free(v_raw, res_sz, res_al);
        (*slot).magic = 0u64;
        heap_free(raw, size_of<SpawnSlot>(), align_of<SpawnSlot>());
    }
    0i64
}

unsafe fn spawn_raw_slot<F: FnOnce<T> + Send, T: Send>(f: F, stack_size: usize, _t_tag: *const T) -> *mut SpawnSlot {
    let f_raw = heap_alloc(box_size(size_of<F>()), box_align(align_of<F>()));
    if (f_raw as usize) == 0 {
        return 0 as *mut SpawnSlot;
    }
    let f_box = f_raw as *mut F;
    *f_box = f;
    let slot = spawn_slot_new(stack_size, f_raw);
    if (slot as usize) == 0 {
        if needs_drop<F>() {
            drop_in_place<F>(f_box);
        }
        heap_free(f_raw, box_size(size_of<F>()), box_align(align_of<F>()));
        return 0 as *mut SpawnSlot;
    }
    let h = ax_spawn_trampoline<F, T>(slot as *mut (F, T));
    if h <= 0i64 {
        (*slot).phase = 2u32;
        let cfn = (*slot).cleanup_fn;
        let _ = cfn(slot as *mut u8);
        return 0 as *mut SpawnSlot;
    }
    slot
}

pub struct JoinHandle<T> {
    pub raw_handle: i64,
    pub thread_info: Thread,
    pub slot: *mut u8,
    pub marker: *const T,
}

unsafe impl<T: Send> Send for JoinHandle<T> {}
impl<T> !Share for JoinHandle<T> {}

impl<T> Drop for JoinHandle<T> {
    fn drop(self: mut_view<JoinHandle<T>>) {
        let h = self.raw_handle;
        let raw = self.slot;
        self.raw_handle = 0i64;
        self.slot = 0 as *mut u8;
        if h > 0i64 && (raw as usize) != 0 {
            unsafe {
                let s = raw as *mut SpawnSlot;
                let prev = (*s).lifecycle.fetch_or(FLAG_PARENT_DETACHED, Ordering.AcqRel);
                let _ = thread_detach(h);
                if (prev & FLAG_CHILD_DONE) != 0u32 {
                    (*s).phase = 2u32;
                    let cfn = (*s).cleanup_fn;
                    let _ = cfn(raw);
                }
            }
        }
    }
}

impl<T> JoinHandle<T> {
    pub fn thread(self: view<JoinHandle<T>>) -> Thread {
        self.thread_info.clone()
    }

    pub fn is_finished(self: view<JoinHandle<T>>) -> bool {
        if (self.slot as usize) == 0 {
            return true;
        }
        let s = self.slot as *const SpawnSlot;
        let st = unsafe { (*s).lifecycle.load(Ordering.Acquire) };
        (st & FLAG_CHILD_DONE) != 0u32
    }

    pub fn join(mut self: JoinHandle<T>) -> Result<T, ThreadPanic> {
        let h = self.raw_handle;
        let raw = self.slot;
        let tid = self.thread_info.id;
        self.raw_handle = 0i64;
        self.slot = 0 as *mut u8;
        if h <= 0i64 || (raw as usize) == 0 {
            return Result.Err(make_thread_panic(tid));
        }
        let mut ret_code: i64 = 0i64;
        let rc = unsafe { thread_join(h, address_of_mut(ret_code)) };
        let s = raw as *mut SpawnSlot;
        let cfn = unsafe { (*s).cleanup_fn };
        if rc != 0i64 || ret_code != 0i64 || (unsafe { (*s).val_ptr } as usize) == 0 {
            unsafe {
                (*s).phase = 3u32;
                let _ = cfn(raw);
            }
        }
        let r_raw = unsafe { (*s).val_ptr };
        let out_res = unsafe { *(r_raw as *const Result<T, ThreadPanic>) };
        unsafe {
            (*s).phase = 4u32;
            let _ = cfn(raw);
        }
        out_res
    }

    pub fn detach(mut self: JoinHandle<T>) {
        let h = self.raw_handle;
        let raw = self.slot;
        self.raw_handle = 0i64;
        self.slot = 0 as *mut u8;
        if h > 0i64 && (raw as usize) != 0 {
            unsafe {
                let s = raw as *mut SpawnSlot;
                let prev = (*s).lifecycle.fetch_or(FLAG_PARENT_DETACHED, Ordering.AcqRel);
                let _ = thread_detach(h);
                if (prev & FLAG_CHILD_DONE) != 0u32 {
                    (*s).phase = 2u32;
                    let cfn = (*s).cleanup_fn;
                    let _ = cfn(raw);
                }
            }
        }
    }
}

pub struct Builder {
    pub stack_size: usize,
    pub has_name: bool,
    pub name_buf: String,
}

unsafe impl Send for Builder {}
unsafe impl Share for Builder {}

impl Builder {
    pub fn new() -> Builder {
        Builder {
            stack_size: 0,
            has_name: false,
            name_buf: string_new(),
        }
    }

    pub fn stack_size(mut self: Builder, size: usize) -> Builder {
        self.stack_size = size;
        self
    }

    pub fn name(mut self: Builder, name: str) -> Builder {
        self.has_name = true;
        self.name_buf = str_to_owned_string(name);
        self
    }

    pub fn spawn<F: FnOnce<T> + Send, T: Send>(self: Builder, f: F) -> Result<JoinHandle<T>, ThreadError> {
        let slot = unsafe { spawn_raw_slot<F, T>(f, self.stack_size, 0 as *const T) };
        if (slot as usize) == 0 {
            return Result.Err(ThreadError.SpawnFailed);
        }
        let h = unsafe { (*slot).raw_handle };
        let tid_num = unsafe { (*slot).assigned_tid };
        let t_info = Thread {
            id: ThreadId { id: tid_num },
            has_name: self.has_name,
            name_buf: self.name_buf,
        };
        Result.Ok(JoinHandle {
            raw_handle: h,
            thread_info: t_info,
            slot: slot as *mut u8,
            marker: 0 as *const T,
        })
    }
}

pub fn spawn<F: FnOnce<T> + Send, T: Send>(f: F) -> JoinHandle<T> {
    let slot = unsafe { spawn_raw_slot<F, T>(f, 0, 0 as *const T) };
    if (slot as usize) == 0 {
        panic("failed to spawn OS thread");
    }
    let h = unsafe { (*slot).raw_handle };
    let tid_num = unsafe { (*slot).assigned_tid };
    JoinHandle {
        raw_handle: h,
        thread_info: Thread {
            id: ThreadId { id: tid_num },
            has_name: false,
            name_buf: string_new(),
        },
        slot: slot as *mut u8,
        marker: 0 as *const T,
    }
}

struct ScopeNode {
    pub next: *mut ScopeNode,
    pub slot: *mut SpawnSlot,
    pub raw_handle: i64,
    pub thread_info: Thread,
    pub joined_by_handle: bool,
}

struct ScopeState {
    pub active_count: usize,
    pub has_panic: bool,
    pub first_panic_tid: u64,
    pub handles_head: *mut u8,
}

pub struct Scope {
    pub state_ptr: *mut ScopeState,
}

impl !Share for Scope {}

pub struct ScopedJoinHandle<T> {
    pub raw_handle: i64,
    pub slot: *mut u8,
    pub marker: *const T,
}

unsafe impl<T: Send> Send for ScopedJoinHandle<T> {}
impl<T> !Share for ScopedJoinHandle<T> {}

impl<T> ScopedJoinHandle<T> {
    pub fn thread(self: view<ScopedJoinHandle<T>>) -> Thread {
        let node = self.slot as *const ScopeNode;
        unsafe { view((*node).thread_info).clone() }
    }

    pub fn is_finished(self: view<ScopedJoinHandle<T>>) -> bool {
        if (self.slot as usize) == 0 {
            return true;
        }
        let node = self.slot as *const ScopeNode;
        let sp = unsafe { (*node).slot };
        if (sp as usize) == 0 {
            return true;
        }
        let st = unsafe { (*sp).lifecycle.load(Ordering.Acquire) };
        (st & FLAG_CHILD_DONE) != 0u32
    }

    pub fn join(self: ScopedJoinHandle<T>) -> Result<T, ThreadPanic> {
        let node = self.slot as *mut ScopeNode;
        let h = self.raw_handle;
        let tid = unsafe { (*node).thread_info.id };
        unsafe {
            (*node).joined_by_handle = true;
        }
        let sp = unsafe { (*node).slot };
        unsafe {
            (*node).slot = 0 as *mut SpawnSlot;
        }
        if h <= 0i64 || (sp as usize) == 0 {
            return Result.Err(make_thread_panic(tid));
        }
        let mut ret_code: i64 = 0i64;
        let rc = unsafe { thread_join(h, address_of_mut(ret_code)) };
        let cfn = unsafe { (*sp).cleanup_fn };
        if rc != 0i64 || ret_code != 0i64 || (unsafe { (*sp).val_ptr } as usize) == 0 {
            unsafe {
                (*sp).phase = 3u32;
                let _ = cfn(sp as *mut u8);
            }
        }
        let r_raw = unsafe { (*sp).val_ptr };
        let out_res = unsafe { *(r_raw as *const Result<T, ThreadPanic>) };
        unsafe {
            (*sp).phase = 4u32;
            let _ = cfn(sp as *mut u8);
        }
        out_res
    }
}

fn scope_drain_all_nodes(s: mut_view<Scope>) -> bool {
    let mut had_unjoined_panic = false;
    let st = s.state_ptr;
    if (st as usize) == 0 {
        return false;
    }
    let mut cur = unsafe { (*st).handles_head as *mut ScopeNode };
    unsafe {
        (*st).handles_head = 0 as *mut u8;
        (*st).active_count = 0;
    }
    while (cur as usize) != 0 {
        let next_node = unsafe { (*cur).next };
        let already_joined = unsafe { (*cur).joined_by_handle };
        let sp = unsafe { (*cur).slot };
        let h = unsafe { (*cur).raw_handle };
        let tid = unsafe { (*cur).thread_info.id };
        if !already_joined && h > 0i64 && (sp as usize) != 0 {
            let mut ret_code: i64 = 0i64;
            let rc = unsafe { thread_join(h, address_of_mut(ret_code)) };
            unsafe {
                (*sp).phase = 2u32;
                let cfn = (*sp).cleanup_fn;
                let _ = cfn(sp as *mut u8);
                (*cur).slot = 0 as *mut SpawnSlot;
            }
            if rc != 0i64 || ret_code != 0i64 {
                if !had_unjoined_panic {
                    unsafe {
                        (*st).has_panic = true;
                        (*st).first_panic_tid = tid.id;
                    }
                }
                had_unjoined_panic = true;
            }
        }
        unsafe {
            if needs_drop<ScopeNode>() {
                drop_in_place<ScopeNode>(cur);
            }
            heap_free(cur as *mut u8, size_of<ScopeNode>(), align_of<ScopeNode>());
        }
        cur = next_node;
    }
    had_unjoined_panic
}

impl Drop for Scope {
    fn drop(self: mut_view<Scope>) {
        let _ = scope_drain_all_nodes(self);
    }
}

impl Scope {
    pub fn spawn<F: FnOnce<T> + Send, T: Send>(self: view<Scope>, f: F) -> ScopedJoinHandle<T> {
        let sp = unsafe { spawn_raw_slot<F, T>(f, 0, 0 as *const T) };
        if (sp as usize) == 0 {
            panic("failed to spawn scoped OS thread");
        }
        let h = unsafe { (*sp).raw_handle };
        let tid_num = unsafe { (*sp).assigned_tid };
        let node_raw = unsafe { heap_alloc(size_of<ScopeNode>(), align_of<ScopeNode>()) };
        if (node_raw as usize) == 0 {
            panic("out of memory allocating ScopeNode");
        }
        let st = self.state_ptr;
        let node = node_raw as *mut ScopeNode;
        unsafe {
            *node = ScopeNode {
                next: (*st).handles_head as *mut ScopeNode,
                slot: sp,
                raw_handle: h,
                thread_info: Thread {
                    id: ThreadId { id: tid_num },
                    has_name: false,
                    name_buf: string_new(),
                },
                joined_by_handle: false,
            };
            (*st).handles_head = node_raw;
            (*st).active_count = (*st).active_count + 1;
        }
        ScopedJoinHandle {
            raw_handle: h,
            slot: node_raw,
            marker: 0 as *const T,
        }
    }
}

pub fn scope<F: FnOnce<view<Scope>, R>, R>(f: F) -> R {
    let mut st = ScopeState {
        active_count: 0,
        has_panic: false,
        first_panic_tid: 0u64,
        handles_head: 0 as *mut u8,
    };
    let mut s = Scope {
        state_ptr: unsafe { address_of_mut(st) },
    };
    let out: R = f(view(s));
    let had_panic = scope_drain_all_nodes(mut_view(s));
    if had_panic {
        panic("unjoined scoped thread panicked");
    }
    out
}

pub fn current_id() -> ThreadId {
    ThreadId { id: thread_current_id() }
}

pub fn current() -> Thread {
    Thread {
        id: current_id(),
        has_name: false,
        name_buf: string_new(),
    }
}

pub fn yield_now() {
    thread_yield();
}

pub fn sleep_ns(ns: u64) {
    thread_sleep_ns(ns);
}

pub fn sleep_ms(ms: u64) {
    let ns = if ms > 18446744073709u64 {
        0xFFFFFFFFFFFFFFFFu64
    } else {
        ms * 1_000_000u64
    };
    thread_sleep_ns(ns);
}

pub fn sleep(d: Duration) {
    thread_sleep_ns(d.nanos);
}

struct CancelInner {
    pub refs: Atomic<usize>,
    pub cancelled: Atomic<bool>,
}

unsafe fn cancel_inner_retain(raw: *mut u8) {
    if (raw as usize) != 0 {
        let p = raw as *const CancelInner;
        let _ = (*p).refs.fetch_add(1usize, Ordering.Relaxed);
    }
}

unsafe fn cancel_inner_release(raw: *mut u8) {
    if (raw as usize) != 0 {
        let p = raw as *const CancelInner;
        let prev = (*p).refs.fetch_sub(1usize, Ordering.AcqRel);
        if prev == 1usize {
            fence(Ordering.Acquire);
            heap_free(raw, size_of<CancelInner>(), align_of<CancelInner>());
        }
    }
}

pub struct CancelSource {
    pub inner: *mut u8,
}

unsafe impl Send for CancelSource {}
unsafe impl Share for CancelSource {}

impl Drop for CancelSource {
    fn drop(self: mut_view<CancelSource>) {
        let p = self.inner;
        self.inner = 0 as *mut u8;
        unsafe {
            cancel_inner_release(p);
        }
    }
}

impl CancelSource {
    pub fn new() -> CancelSource {
        let raw = unsafe { heap_alloc(size_of<CancelInner>(), align_of<CancelInner>()) };
        if (raw as usize) == 0 {
            panic("out of memory allocating CancelSource");
        }
        let p = raw as *mut CancelInner;
        unsafe {
            *p = CancelInner {
                refs: Atomic.new(1usize),
                cancelled: Atomic.new(false),
            };
        }
        CancelSource { inner: raw }
    }

    pub fn token(self: view<CancelSource>) -> CancelToken {
        unsafe {
            cancel_inner_retain(self.inner);
        }
        CancelToken { inner: self.inner }
    }

    pub fn cancel(self: view<CancelSource>) {
        if (self.inner as usize) != 0 {
            let p = self.inner as *const CancelInner;
            unsafe {
                (*p).cancelled.store(true, Ordering.Release);
            }
        }
    }

    pub fn is_cancelled(self: view<CancelSource>) -> bool {
        if (self.inner as usize) == 0 {
            return false;
        }
        let p = self.inner as *const CancelInner;
        unsafe { (*p).cancelled.load(Ordering.Acquire) }
    }
}

pub struct CancelToken {
    pub inner: *mut u8,
}

unsafe impl Send for CancelToken {}
unsafe impl Share for CancelToken {}

impl Drop for CancelToken {
    fn drop(self: mut_view<CancelToken>) {
        let p = self.inner;
        self.inner = 0 as *mut u8;
        unsafe {
            cancel_inner_release(p);
        }
    }
}

impl CancelToken {
    pub fn is_cancelled(self: view<CancelToken>) -> bool {
        if (self.inner as usize) == 0 {
            return false;
        }
        let p = self.inner as *const CancelInner;
        unsafe { (*p).cancelled.load(Ordering.Acquire) }
    }

    pub fn clone(self: view<CancelToken>) -> CancelToken {
        unsafe {
            cancel_inner_retain(self.inner);
        }
        CancelToken { inner: self.inner }
    }
}

// std.fiber - Stackful Fiber<Y, R>, FiberBuilder & cooperative FiberScheduler (SPEC-34 §5, AXS-EXEC-050..056)
module std.fiber

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.fiber_create
use std.core.host.fiber_resume
use std.core.host.fiber_yield
use std.core.host.fiber_destroy
use std.core.host.thread_current_id

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic fn panic(msg: str) {}

// Default stack budget (SPEC-34 AXS-EXEC-051): 64 KiB committed, 256 KiB reserved.
const FIBER_DEFAULT_STACK_COMMIT: usize = 65536;
const FIBER_DEFAULT_STACK_RESERVE: usize = 262144;

// Placeholder marked `@lang("self_entry")` so the compiler rewrites its value, inside a generic
// function, to that enclosing function's symbol (keyed by item identity, not by function name).
@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    0i64
}

// Per-thread counter that makes FiberId unique: the id is (thread id << 32) | counter.
@thread_local
static mut FIBER_ID_COUNTER: u64 = 0u64;

@derive(Copy)
pub struct FiberId {
    pub id: u64,
}

impl FiberId {
    pub fn as_u64(self: view<FiberId>) -> u64 {
        self.id
    }

    pub fn eq(self: view<FiberId>, other: view<FiberId>) -> bool {
        self.id == other.id
    }

    pub fn clone(self: view<FiberId>) -> FiberId {
        *self
    }
}

pub enum FiberState<Y, R> {
    Yielded(Y),
    Completed(R),
    Panicked,
}

pub struct FiberBuilder {
    pub stack_commit: usize,
    pub stack_reserve: usize,
}

// Heap control slot shared by the Fiber handle and the monomorphic trampoline.
// phase 0 = create the host fiber, phase 1 = fiber entry (runs the closure), phase 2 = dispose the
// closure of a fiber that never started.
@repr(C)
struct FiberSlot {
    pub phase: u32,
    pub pad0: u32,
    pub stack_commit: usize,
    pub stack_reserve: usize,
    pub raw_handle: i64,
    pub closure_ptr: *mut u8,
    pub result_ptr: *mut u8,
    pub cleanup_fn: fn(*mut u8) -> i64,
}

pub struct Fiber<Y, R> {
    pub raw_handle: i64,
    pub id: FiberId,
    pub slot: *mut u8,
    pub owner_thread: u64,
    pub completed: bool,
}

// A fiber keeps thread-local references and stack views alive: it never migrates between OS threads.
impl<Y, R> !Send for Fiber<Y, R> {}
impl<Y, R> !Share for Fiber<Y, R> {}

fn box_size(sz: usize) -> usize {
    if sz == 0 { 8 } else { sz }
}

fn box_align(al: usize) -> usize {
    if al < 8 { 8 } else { al }
}

unsafe fn fiber_trampoline<F: FnOnce<R>, R>(raw_typed: *mut (F, R)) -> i64 {
    let raw = raw_typed as *mut u8;
    let slot = raw as *mut FiberSlot;
    let ph = (*slot).phase;
    if ph == 0u32 {
        (*slot).cleanup_fn = __ax_thread_self_entry;
        (*slot).phase = 1u32;
        let h = fiber_create(__ax_thread_self_entry, raw, (*slot).stack_commit, (*slot).stack_reserve);
        (*slot).raw_handle = h;
        return h;
    }
    if ph == 2u32 {
        let c_ptr = (*slot).closure_ptr;
        (*slot).closure_ptr = 0 as *mut u8;
        if (c_ptr as usize) != 0 {
            // Move the closure into a local so that its captures are dropped at the end of the block
            // (drop_in_place on a closure type is a no-op), then free the box.
            {
                let _dead: F = *(c_ptr as *mut F);
            }
            heap_free(c_ptr, box_size(size_of<F>()), box_align(align_of<F>()));
        }
        return 0i64;
    }

    // Fiber entry: runs on the fiber's own stack.
    let c_ptr = (*slot).closure_ptr;
    (*slot).closure_ptr = 0 as *mut u8;
    let f_box = c_ptr as *mut F;
    let f_val = *f_box;
    heap_free(c_ptr, box_size(size_of<F>()), box_align(align_of<F>()));

    let out_val: R = f_val();
    let r_raw = heap_alloc(box_size(size_of<R>()), box_align(align_of<R>()));
    let r_box = r_raw as *mut R;
    *r_box = out_val;
    (*slot).result_ptr = r_raw;
    0i64
}

unsafe fn spawn_raw_slot<F: FnOnce<R>, R>(f: F, commit: usize, reserve: usize) -> *mut FiberSlot {
    let f_raw = heap_alloc(box_size(size_of<F>()), box_align(align_of<F>()));
    if (f_raw as usize) == 0 {
        return 0 as *mut FiberSlot;
    }
    let f_box = f_raw as *mut F;
    *f_box = f;
    let s_raw = heap_alloc(size_of<FiberSlot>(), align_of<FiberSlot>());
    if (s_raw as usize) == 0 {
        {
            let _dead: F = *f_box;
        }
        heap_free(f_raw, box_size(size_of<F>()), box_align(align_of<F>()));
        return 0 as *mut FiberSlot;
    }
    let slot = s_raw as *mut FiberSlot;
    (*slot).phase = 0u32;
    (*slot).pad0 = 0u32;
    (*slot).stack_commit = commit;
    (*slot).stack_reserve = reserve;
    (*slot).raw_handle = 0i64;
    (*slot).closure_ptr = f_raw;
    (*slot).result_ptr = 0 as *mut u8;
    (*slot).cleanup_fn = __ax_thread_self_entry;
    let h = fiber_trampoline<F, R>(slot as *mut (F, R));
    if h <= 0i64 {
        (*slot).phase = 2u32;
        let cfn = (*slot).cleanup_fn;
        let _ = cfn(s_raw);
        heap_free(s_raw, size_of<FiberSlot>(), align_of<FiberSlot>());
        return 0 as *mut FiberSlot;
    }
    slot
}

unsafe fn next_fiber_id() -> FiberId {
    FIBER_ID_COUNTER = FIBER_ID_COUNTER + 1u64;
    FiberId { id: (thread_current_id() << 32u64) | FIBER_ID_COUNTER }
}

impl FiberBuilder {
    pub fn new() -> FiberBuilder {
        FiberBuilder {
            stack_commit: FIBER_DEFAULT_STACK_COMMIT,
            stack_reserve: FIBER_DEFAULT_STACK_RESERVE,
        }
    }

    pub fn stack_size(mut self: FiberBuilder, commit: usize, reserve: usize) -> FiberBuilder {
        self.stack_commit = commit;
        self.stack_reserve = reserve;
        self
    }

    pub fn spawn<F: FnOnce<R>, Y, R>(self: FiberBuilder, f: F) -> Fiber<Y, R> {
        let slot = unsafe { spawn_raw_slot<F, R>(f, self.stack_commit, self.stack_reserve) };
        if (slot as usize) == 0 {
            panic("failed to create fiber");
        }
        let h = unsafe { (*slot).raw_handle };
        Fiber {
            raw_handle: h,
            id: unsafe { next_fiber_id() },
            slot: slot as *mut u8,
            owner_thread: thread_current_id(),
            completed: false,
        }
    }
}

impl<Y, R> Fiber<Y, R> {
    pub fn new<F: FnOnce<R>>(f: F) -> Fiber<Y, R> {
        FiberBuilder.new().spawn<F, Y, R>(f)
    }

    pub fn spawn<F: FnOnce<R>>(f: F) -> Fiber<Y, R> {
        FiberBuilder.new().spawn<F, Y, R>(f)
    }

    pub fn id(self: view<Fiber<Y, R>>) -> FiberId {
        self.id
    }

    pub fn is_completed(self: view<Fiber<Y, R>>) -> bool {
        self.completed
    }

    pub fn resume(self: mut_view<Fiber<Y, R>>) -> FiberState<Y, R> {
        if self.completed || self.raw_handle <= 0i64 {
            panic("fiber resumed after it completed");
            return FiberState.Panicked;
        }
        let mut out: i64 = 0i64;
        let rc = unsafe { fiber_resume(self.raw_handle, 0i64, address_of_mut(out)) };
        if rc == 0i64 {
            // yield_val moved a heap cell holding the yielded Y; take it over.
            let cell = (out as usize) as *mut Y;
            let y: Y = unsafe { *cell };
            unsafe {
                heap_free(cell as *mut u8, box_size(size_of<Y>()), box_align(align_of<Y>()));
            }
            return FiberState.Yielded(y);
        }
        if rc == 1i64 {
            let slot = self.slot as *mut FiberSlot;
            let r_raw = unsafe { (*slot).result_ptr };
            unsafe {
                (*slot).result_ptr = 0 as *mut u8;
            }
            let r: R = unsafe { *(r_raw as *mut R) };
            unsafe {
                heap_free(r_raw, box_size(size_of<R>()), box_align(align_of<R>()));
            }
            self.finish_host();
            return FiberState.Completed(r);
        }
        if rc == 2i64 {
            self.finish_host();
            return FiberState.Panicked;
        }
        panic("fiber resume rejected (wrong OS thread, already running or destroyed)");
        FiberState.Panicked
    }

    // The fiber reached a terminal state: release its host stack now.
    fn finish_host(self: mut_view<Fiber<Y, R>>) {
        let h = self.raw_handle;
        self.raw_handle = 0i64;
        self.completed = true;
        if h > 0i64 {
            let _ = fiber_destroy(h);
        }
    }
}

impl<Y, R> Drop for Fiber<Y, R> {
    fn drop(self: mut_view<Fiber<Y, R>>) {
        let slot_raw = self.slot;
        if (slot_raw as usize) == 0 {
            return;
        }
        self.slot = 0 as *mut u8;
        let h = self.raw_handle;
        self.raw_handle = 0i64;
        if h > 0i64 {
            // A suspended fiber's stack is released without unwinding it (live locals are leaked,
            // like Win32 DeleteFiber); a running fiber or a foreign thread is rejected (AFIBER-31, AFIBER-45).
            let rc = fiber_destroy(h);
            if rc != 0i64 {
                panic("cannot destroy a running fiber or a fiber owned by another thread");
            }
        }
        let slot = slot_raw as *mut FiberSlot;
        unsafe {
            if ((*slot).closure_ptr as usize) != 0 {
                (*slot).phase = 2u32;
                let cfn = (*slot).cleanup_fn;
                let _ = cfn(slot_raw);
            }
            let r_raw = (*slot).result_ptr;
            (*slot).result_ptr = 0 as *mut u8;
            if (r_raw as usize) != 0 {
                if needs_drop<R>() {
                    drop_in_place<R>(r_raw as *mut R);
                }
                heap_free(r_raw, box_size(size_of<R>()), box_align(align_of<R>()));
            }
            heap_free(slot_raw, size_of<FiberSlot>(), align_of<FiberSlot>());
        }
    }
}

// Suspends the active fiber, handing `val` to the code that resumed it.
pub fn yield_val<Y>(val: Y) {
    unsafe {
        let cell = heap_alloc(box_size(size_of<Y>()), box_align(align_of<Y>()));
        let cell_y = cell as *mut Y;
        *cell_y = val;
        let rc = fiber_yield((cell as usize) as i64);
        if rc < 0i64 {
            // Not running inside a fiber: take the value back so nothing leaks.
            let _back: Y = *cell_y;
            heap_free(cell, box_size(size_of<Y>()), box_align(align_of<Y>()));
            panic("yield_val called outside of a fiber");
        }
    }
}

pub fn yield_now() {
    yield_val(());
}

// Cooperative round-robin scheduler for Fiber<(), ()> on the current thread (FIFO order).
pub struct FiberScheduler {
    pub queue: *mut Fiber<(), ()>,
    pub len: usize,
    pub cap: usize,
}

impl !Send for FiberScheduler {}
impl !Share for FiberScheduler {}

impl FiberScheduler {
    pub fn new() -> FiberScheduler {
        FiberScheduler {
            queue: 0 as *mut Fiber<(), ()>,
            len: 0,
            cap: 0,
        }
    }

    pub fn spawn<F: FnOnce<()>>(self: mut_view<FiberScheduler>, f: F) {
        let fb: Fiber<(), ()> = FiberBuilder.new().spawn<F, (), ()>(f);
        unsafe {
            if self.len == self.cap {
                let new_cap: usize = if self.cap == 0 { 4 } else { self.cap * 2 };
                let sz = size_of<Fiber<(), ()>>();
                let raw = heap_alloc(new_cap * sz, align_of<Fiber<(), ()>>());
                let new_q = raw as *mut Fiber<(), ()>;
                if self.len > 0 {
                    ptr_copy_nonoverlapping<u8>(self.queue as *const u8, new_q as *mut u8, self.len * sz);
                    heap_free(self.queue as *mut u8, self.cap * sz, align_of<Fiber<(), ()>>());
                }
                self.queue = new_q;
                self.cap = new_cap;
            }
            let dst = self.queue + self.len;
            *dst = fb;
        }
        self.len = self.len + 1;
    }

    pub fn pending(self: view<FiberScheduler>) -> usize {
        let mut n: usize = 0;
        let mut i: usize = 0;
        while i < self.len {
            let p = unsafe { self.queue + i };
            if !unsafe { (*p).completed } {
                n = n + 1;
            }
            i = i + 1;
        }
        n
    }

    // Drives every queued fiber, one resume per round, until all of them completed.
    pub fn run(self: mut_view<FiberScheduler>) {
        let mut remaining: usize = self.pending();
        while remaining > 0 {
            let mut i: usize = 0;
            while i < self.len {
                let p = unsafe { self.queue + i };
                if !unsafe { (*p).completed } {
                    let st = unsafe { (*p).resume() };
                    match st {
                        FiberState.Yielded(_u) => {}
                        FiberState.Completed(_u) => {
                            remaining = remaining - 1;
                        }
                        FiberState.Panicked => {
                            remaining = remaining - 1;
                        }
                    }
                }
                i = i + 1;
            }
        }
        self.release_all();
    }

    fn release_all(self: mut_view<FiberScheduler>) {
        let mut i: usize = 0;
        while i < self.len {
            unsafe {
                drop_in_place<Fiber<(), ()>>(self.queue + i);
            }
            i = i + 1;
        }
        self.len = 0;
    }
}

impl Drop for FiberScheduler {
    fn drop(self: mut_view<FiberScheduler>) {
        self.release_all();
        if (self.queue as usize) != 0 {
            let sz = size_of<Fiber<(), ()>>();
            unsafe {
                heap_free(self.queue as *mut u8, self.cap * sz, align_of<Fiber<(), ()>>());
            }
            self.queue = 0 as *mut Fiber<(), ()>;
            self.cap = 0;
        }
    }
}

module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_now
use std.thread.spawn

@intrinsic fn panic(msg: str) {}

// 0 yielded, 2 panicked, 1000 + r completed with r.
fn code_of(st: FiberState<(), i64>) -> i64 {
    match st {
        FiberState.Yielded(_u) => 0i64,
        FiberState.Completed(r) => 1000i64 + r,
        FiberState.Panicked => 2i64,
    }
}

pub fn main() -> i32 {
    // A fiber on the main thread panics first (the exit hooks are installed on the main thread).
    let mut m: Fiber<(), i64> = Fiber.new(|| -> i64 {
        panic("np_spawned_thread main fiber boom");
        1i64
    });
    let m_code = code_of(m.resume());

    // A fiber on a spawned thread panics: the thread keeps running and joins Ok.
    let t = spawn(|| -> i64 {
        let mut bad: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            panic("np_spawned_thread fiber boom");
            1i64
        });
        let mut good: Fiber<(), i64> = Fiber.new(|| -> i64 {
            yield_now();
            7i64
        });
        let a = code_of(bad.resume());
        let b = code_of(good.resume());
        let c = code_of(bad.resume());
        let d = code_of(good.resume());
        a + b * 10i64 + c * 100i64 + d * 1000i64
    });
    let t_val = match t.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };

    // A panic outside any fiber on a spawned thread keeps today's behaviour: join returns Err.
    let plain = spawn(|| -> i64 {
        panic("np_spawned_thread plain thread boom");
        5i64
    });
    let plain_val = match plain.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };

    print("OK np_spawned_thread ");
    print_int(m_code);
    print(" ");
    print_int(t_val);
    print(" ");
    print_int(plain_val);
    print("\n");
    0
}

// Failure reporting: `check(cond)` in src/<name>.axsrc is rewritten to `check_at(<source line>, cond)`,
// so a failing assertion prints its line before the (timeout-bounded) spin. Not `assert()`: the
// stdout comparison is the evidence in native mode (standing rule T134).
fn check_at(line: i32, cond: bool) {
    if !cond {
        print("FAIL line ");
        print_int(line as i64);
        print("\n");
        loop {}
    }
}
