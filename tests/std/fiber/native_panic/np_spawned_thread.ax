// test: run
// modes: interp native
// timeout: 60
// covers: REQ-CONC-189, REQ-TST-072
// stdout: OK np_spawned_thread 2 1007200 -1\n

module std.sync.atomic

@derive(Copy)
pub enum Ordering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

@derive(Copy)
pub struct CasResult<T> {
    pub ok: bool,
    pub val: T,
}

@lang("atomic")
pub struct Atomic<T> {
    pub v: T,
}

impl<T> Atomic<T> {
    pub fn new(v: T) -> Atomic<T> {
        loop {}
    }

    pub fn into_inner(self: Atomic<T>) -> T {
        loop {}
    }

    pub fn is_lock_free() -> bool {
        true
    }

    pub fn load(self: view<Atomic<T>>, order: Ordering) -> T {
        loop {}
    }

    pub fn store(self: view<Atomic<T>>, val: T, order: Ordering) {}

    pub fn swap(self: view<Atomic<T>>, val: T, order: Ordering) -> T {
        loop {}
    }

    pub fn compare_exchange(
        self: view<Atomic<T>>,
        expected: T,
        desired: T,
        success: Ordering,
        failure: Ordering
    ) -> CasResult<T> {
        loop {}
