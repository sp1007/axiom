// test: run
// modes: interp native
// xfail: T423c a call of a generic fn without type arguments inside a closure body is rejected (AX_TYPE_UNKNOWN); g<i64>(..) is accepted
// stdout: 5\n
// Minimal repro found by T423 (std.fiber closures call yield_val(x) and need yield_val<T>(x) today).
// Expected: g(1i64) infers T = i64 inside the closure exactly as it does in a plain function.

fn g<T>(v: T) {}

fn run_it<F: FnOnce<i64>>(f: F) -> i64 {
    f()
}

pub fn main() -> i32 {
    let r = run_it(|| -> i64 {
        g(1i64);
        5i64
    });
    print_int(r);
    0
}
