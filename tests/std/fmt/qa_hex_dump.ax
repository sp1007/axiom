// test: run
// stdout: OK HexDump\n

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = 1usize;
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 16 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        *(s.ptr + s.len) = (c as u32) as u8;
    }
    s.len = s.len + 1;
}

pub fn format_u64_into(out: mut_view<String>, val: u64, radix: u32, width: usize, zero_pad: bool) {
    let rad = if radix < 2 || radix > 36 { 10u32 } else { radix };
    let w = width;
    let pad = zero_pad;
    let v = val;
    if v == 0 {
        let pad_count = if w > 1 { w - 1 } else { 0 };
        let pad_c = if pad { '0' } else { ' ' };
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), pad_c);
            p = p + 1;
        }
        string_push_char(mut_view(*out), '0');
        return;
    }
    let mut rem = v;
    let mut buf: [65]u8 = [0u8; 65];
    let mut count: usize = 0;
    let r64 = rad as u64;
    while rem > 0 {
        let mut q: u64 = 0;
        let mut digit: u32 = 0;
        if (rem as i64) >= 0 {
            q = rem / r64;
            digit = (rem % r64) as u32;
        } else {
            let half = rem >> 1;
            let q_half = half / r64;
            let r_half = half % r64;
            let mut q_sub = q_half + q_half;
            let mut r_sub = r_half + r_half + (rem & 1u64);
            if r_sub >= r64 {
                q_sub = q_sub + 1;
                r_sub = r_sub - r64;
            }
            q = q_sub;
            digit = r_sub as u32;
        }
        let c: u8 = if digit < 10 {
            b'0' + digit as u8
        } else {
            b'a' + (digit - 10) as u8
        };
        buf[count] = c;
        rem = q;
        count = count + 1;
    }
    let needed = count;
    let pad_count = if w > needed { w - needed } else { 0 };
    let pad_c = if pad { '0' } else { ' ' };
    let mut p: usize = 0;
    while p < pad_count {
        string_push_char(mut_view(*out), pad_c);
        p = p + 1;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        string_push_char(mut_view(*out), buf[i] as char);
    }
}

fn hex_nibble(n: u8) -> char {
    if n < 10 {
        (b'0' + n) as char
    } else {
        (b'a' + (n - 10)) as char
    }
}

pub fn write_hex_dump(out: mut_view<String>, bytes: view<[u8]>) {
    let n = len(bytes);
    if n == 0 {
        return;
    }
    let mut offset: usize = 0;
    while offset < n {
        format_u64_into(mut_view(*out), offset as u64, 16, 8, true);
        string_push_char(mut_view(*out), ' ');
        string_push_char(mut_view(*out), ' ');

        let line_len = if offset + 16 <= n { 16 } else { n - offset };

        let mut slot: usize = 0;
        while slot < 16 {
            if slot < line_len {
                let b = bytes[offset + slot];
                string_push_char(mut_view(*out), hex_nibble((b >> 4) & 0x0Fu8));
                string_push_char(mut_view(*out), hex_nibble(b & 0x0Fu8));
            } else {
                string_push_char(mut_view(*out), ' ');
                string_push_char(mut_view(*out), ' ');
            }

            if slot < 15 {
                string_push_char(mut_view(*out), ' ');
                if slot == 7 {
                    string_push_char(mut_view(*out), ' ');
                }
            }
            slot = slot + 1;
        }

        string_push_char(mut_view(*out), ' ');
        string_push_char(mut_view(*out), ' ');

        string_push_char(mut_view(*out), '|');
        let mut i: usize = 0;
        while i < line_len {
            let b = bytes[offset + i];
            if b >= 0x20u8 && b <= 0x7Eu8 {
                string_push_char(mut_view(*out), b as char);
            } else {
                string_push_char(mut_view(*out), '.');
            }
            i = i + 1;
        }
        string_push_char(mut_view(*out), '|');
        string_push_char(mut_view(*out), '\n');

        offset = offset + 16;
    }
}

fn eq_bytes(s: view<String>, expected: view<[u8]>) -> bool {
    let elen = len(expected);
    if s.len != elen { return false; }
    let mut i: usize = 0;
    while i < elen {
        let sc = unsafe { *(s.ptr + i) };
        if sc != expected[i] { return false; }
        i = i + 1;
    }
    true
}

fn test_hex_dump_empty() -> i32 {
    let mut s = string_new();
    let b: [0]u8 = [];
    write_hex_dump(mut_view(s), view(b));
    if s.len != 0 { return 1; }
    0
}

fn test_hex_dump_short() -> i32 {
    let mut s = string_new();
    let b: [5]u8 = [b'H', b'e', b'l', b'l', b'o'];
    write_hex_dump(mut_view(s), view(b));
    // Line:
    // Offset: "00000000  " (10 chars)
    // Hex:
    // slot 0..4: "48 65 6c 6c 6f " (5 * 3 = 15)
    // slot 5..7: "   " (3 * 3 = 9)
    // extra space after slot 7: " " (1)
    // slot 8..15: "   " for slot 8..14 (7 * 3 = 21) + "  " for slot 15 (2)
    // Total hex width: 8*3 + 1 + 8*3 - 1 = 24 + 1 + 23 = 48 chars!
    // Spacing before ASCII: "  " (2 chars)
    // ASCII: "|Hello|\n" (8 chars)
    // Total line: 10 + 48 + 2 + 8 = 68 chars!
    let expected: [68]u8 = [
        b'0', b'0', b'0', b'0', b'0', b'0', b'0', b'0', b' ', b' ',
        b'4', b'8', b' ', b'6', b'5', b' ', b'6', b'c', b' ', b'6',
        b'c', b' ', b'6', b'f', b' ', b' ', b' ', b' ', b' ', b' ',
        b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ',
        b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ',
        b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ', b' ',
        b'|', b'H', b'e', b'l', b'l', b'o', b'|', b'\n'
    ];
    if !eq_bytes(view(s), view(expected)) {
        return 2;
    }
    0
}

fn test_hex_dump_multiline() -> i32 {
    let mut s = string_new();
    // 33 bytes = 2 full lines (16 bytes each) + 1 byte on 3rd line
    let mut b: [33]u8 = [0u8; 33];
    let mut i: usize = 0;
    while i < 33 {
        b[i] = (i as u8) + 1u8;
        i = i + 1;
    }
    write_hex_dump(mut_view(s), view(b));
    // Each line is 68 chars + newline -> 68 * 3 = 204 bytes
    if s.len != 222 {
        return 3;
    }
    0
}

fn main() -> i32 {
    let r1 = test_hex_dump_empty();
    if r1 != 0 { return r1; }

    let r2 = test_hex_dump_short();
    if r2 != 0 { return r2; }

    let r3 = test_hex_dump_multiline();
    if r3 != 0 { return r3; }

    print("OK HexDump\n");
    0
}
