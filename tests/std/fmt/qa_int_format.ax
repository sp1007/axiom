// test: run
// stdout: OK IntFormat\n

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = 1usize;
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 16 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        *(s.ptr + s.len) = (c as u32) as u8;
    }
    s.len = s.len + 1;
}

fn u8_to_u64(val: u8) -> u64 { (val as u64) & 0xFFu64 }
fn u16_to_u64(val: u16) -> u64 { (val as u64) & 0xFFFFu64 }
fn u32_to_u64(val: u32) -> u64 { (val as u64) & 0xFFFF_FFFFu64 }
fn usize_to_u64(val: usize) -> u64 { val as u64 }

fn i8_to_i64(val: i8) -> i64 {
    let u = (val as u64) & 0xFFu64;
    if (u & 0x80u64) != 0u64 {
        ((u & 0x7Fu64) as i64) - 128i64
    } else {
        u as i64
    }
}

fn i16_to_i64(val: i16) -> i64 {
    let u = (val as u64) & 0xFFFFu64;
    if (u & 0x8000u64) != 0u64 {
        ((u & 0x7FFFu64) as i64) - 32768i64
    } else {
        u as i64
    }
}

fn i32_to_i64(val: i32) -> i64 {
    let u = (val as u64) & 0xFFFF_FFFFu64;
    if (u & 0x8000_0000u64) != 0u64 {
        ((u & 0x7FFF_FFFFu64) as i64) - 2147483648i64
    } else {
        u as i64
    }
}

fn isize_to_i64(val: isize) -> i64 { val as i64 }

pub fn format_u64_into(out: mut_view<String>, val: u64, mut radix: u32, width: usize, zero_pad: bool) {
    let pad = zero_pad;
    let w = width;
    let v = val;
    let mut rad = radix;
    if rad < 2 || rad > 36 {
        rad = 10;
    }
    if v == 0 {
        let pad_count = if w > 1 { w - 1 } else { 0 };
        let pad_c = if pad { '0' } else { ' ' };
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), pad_c);
            p = p + 1;
        }
        string_push_char(mut_view(*out), '0');
        return;
    }
    let mut rem = v;
    let mut buf: [65]u8 = [0u8; 65];
    let mut count: usize = 0;
    let r64 = rad as u64;
    while rem > 0 {
        let mut q: u64 = 0;
        let mut digit: u32 = 0;
        if (rem as i64) >= 0 {
            q = rem / r64;
            digit = (rem % r64) as u32;
        } else {
            let half = rem >> 1;
            let q_half = half / r64;
            let r_half = half % r64;
            let mut q_sub = q_half + q_half;
            let mut r_sub = r_half + r_half + (rem & 1u64);
            if r_sub >= r64 {
                q_sub = q_sub + 1;
                r_sub = r_sub - r64;
            }
            q = q_sub;
            digit = r_sub as u32;
        }
        let c: u8 = if digit < 10 {
            b'0' + digit as u8
        } else {
            b'a' + (digit - 10) as u8
        };
        buf[count] = c;
        rem = q;
        count = count + 1;
    }
    let pad_count = if w > count { w - count } else { 0 };
    let pad_c = if pad { '0' } else { ' ' };
    let mut p: usize = 0;
    while p < pad_count {
        string_push_char(mut_view(*out), pad_c);
        p = p + 1;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        string_push_char(mut_view(*out), buf[i] as char);
    }
}

pub fn format_i64_into(out: mut_view<String>, val: i64, mut radix: u32, width: usize, zero_pad: bool) {
    let pad = zero_pad;
    let w = width;
    let v = val;
    let mut rad = radix;
    if rad < 2 || rad > 36 {
        rad = 10;
    }
    if v >= 0 {
        format_u64_into(mut_view(*out), v as u64, rad, w, pad);
        return;
    }
    let mag: u64 = (~(v as u64)) + 1u64;
    let mut rem = mag;
    let mut buf: [65]u8 = [0u8; 65];
    let mut count: usize = 0;
    let r64 = rad as u64;
    while rem > 0 {
        let mut q: u64 = 0;
        let mut digit: u32 = 0;
        if (rem as i64) >= 0 {
            q = rem / r64;
            digit = (rem % r64) as u32;
        } else {
            let half = rem >> 1;
            let q_half = half / r64;
            let r_half = half % r64;
            let mut q_sub = q_half + q_half;
            let mut r_sub = r_half + r_half + (rem & 1u64);
            if r_sub >= r64 {
                q_sub = q_sub + 1;
                r_sub = r_sub - r64;
            }
            q = q_sub;
            digit = r_sub as u32;
        }
        let c: u8 = if digit < 10 {
            b'0' + digit as u8
        } else {
            b'a' + (digit - 10) as u8
        };
        buf[count] = c;
        rem = q;
        count = count + 1;
    }
    let needed = 1 + count;
    let pad_count = if w > needed { w - needed } else { 0 };
    if pad {
        string_push_char(mut_view(*out), '-');
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), '0');
            p = p + 1;
        }
    } else {
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), ' ');
            p = p + 1;
        }
        string_push_char(mut_view(*out), '-');
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        string_push_char(mut_view(*out), buf[i] as char);
    }
}

pub fn format_u8_into(out: mut_view<String>, val: u8, radix: u32, width: usize, zero_pad: bool) {
    format_u64_into(out, u8_to_u64(val), radix, width, zero_pad);
}
pub fn format_u16_into(out: mut_view<String>, val: u16, radix: u32, width: usize, zero_pad: bool) {
    format_u64_into(out, u16_to_u64(val), radix, width, zero_pad);
}
pub fn format_u32_into(out: mut_view<String>, val: u32, radix: u32, width: usize, zero_pad: bool) {
    format_u64_into(out, u32_to_u64(val), radix, width, zero_pad);
}
pub fn format_usize_into(out: mut_view<String>, val: usize, radix: u32, width: usize, zero_pad: bool) {
    format_u64_into(out, usize_to_u64(val), radix, width, zero_pad);
}

pub fn format_i8_into(out: mut_view<String>, val: i8, radix: u32, width: usize, zero_pad: bool) {
    format_i64_into(out, i8_to_i64(val), radix, width, zero_pad);
}
pub fn format_i16_into(out: mut_view<String>, val: i16, radix: u32, width: usize, zero_pad: bool) {
    format_i64_into(out, i16_to_i64(val), radix, width, zero_pad);
}
pub fn format_i32_into(out: mut_view<String>, val: i32, radix: u32, width: usize, zero_pad: bool) {
    format_i64_into(out, i32_to_i64(val), radix, width, zero_pad);
}
pub fn format_isize_into(out: mut_view<String>, val: isize, radix: u32, width: usize, zero_pad: bool) {
    format_i64_into(out, isize_to_i64(val), radix, width, zero_pad);
}

fn eq_bytes(s: view<String>, expected: view<[u8]>) -> bool {
    let elen = len(expected);
    if s.len != elen { return false; }
    let mut i: usize = 0;
    while i < elen {
        let sc = unsafe { *(s.ptr + i) };
        if sc != expected[i] { return false; }
        i = i + 1;
    }
    true
}

fn test_unsigned_min_max() -> i32 {
    let mut s = string_new();

    format_u8_into(mut_view(s), 0u8, 10, 0, false);
    let e0: [1]u8 = [b'0'];
    if !eq_bytes(view(s), view(e0)) { return 1; }

    s.len = 0;
    format_u8_into(mut_view(s), 255u8, 10, 0, false);
    let e_u8_max: [3]u8 = [b'2', b'5', b'5'];
    if !eq_bytes(view(s), view(e_u8_max)) { return 2; }

    s.len = 0;
    format_u16_into(mut_view(s), 65535u16, 10, 0, false);
    let e_u16_max: [5]u8 = [b'6', b'5', b'5', b'3', b'5'];
    if !eq_bytes(view(s), view(e_u16_max)) { return 3; }

    s.len = 0;
    format_u32_into(mut_view(s), 4294967295u32, 10, 0, false);
    let e_u32_max: [10]u8 = [b'4', b'2', b'9', b'4', b'9', b'6', b'7', b'2', b'9', b'5'];
    if !eq_bytes(view(s), view(e_u32_max)) { return 4; }

    s.len = 0;
    format_u64_into(mut_view(s), 0xFFFF_FFFF_FFFF_FFFFu64, 10, 0, false);
    let e_u64_max: [20]u8 = [b'1', b'8', b'4', b'4', b'6', b'7', b'4', b'4', b'0', b'7', b'3', b'7', b'0', b'9', b'5', b'5', b'1', b'6', b'1', b'5'];
    if !eq_bytes(view(s), view(e_u64_max)) { return 5; }

    s.len = 0;
    format_usize_into(mut_view(s), 0xFFFF_FFFF_FFFF_FFFFusize, 10, 0, false);
    let e_usize_max: [20]u8 = [b'1', b'8', b'4', b'4', b'6', b'7', b'4', b'4', b'0', b'7', b'3', b'7', b'0', b'9', b'5', b'5', b'1', b'6', b'1', b'5'];
    if !eq_bytes(view(s), view(e_usize_max)) { return 6; }

    0
}

fn test_signed_min_max() -> i32 {
    let mut s = string_new();

    format_i8_into(mut_view(s), -128i8, 10, 0, false);
    let e_neg128: [4]u8 = [b'-', b'1', b'2', b'8'];
    if !eq_bytes(view(s), view(e_neg128)) { return 11; }

    s.len = 0;
    format_i8_into(mut_view(s), 127i8, 10, 0, false);
    let e_pos127: [3]u8 = [b'1', b'2', b'7'];
    if !eq_bytes(view(s), view(e_pos127)) { return 12; }

    s.len = 0;
    format_i16_into(mut_view(s), -32768i16, 10, 0, false);
    let e_neg32768: [6]u8 = [b'-', b'3', b'2', b'7', b'6', b'8'];
    if !eq_bytes(view(s), view(e_neg32768)) { return 13; }

    s.len = 0;
    format_i16_into(mut_view(s), 32767i16, 10, 0, false);
    let e_pos32767: [5]u8 = [b'3', b'2', b'7', b'6', b'7'];
    if !eq_bytes(view(s), view(e_pos32767)) { return 14; }

    s.len = 0;
    format_i32_into(mut_view(s), -2147483648i32, 10, 0, false);
    let e_neg2b: [11]u8 = [b'-', b'2', b'1', b'4', b'7', b'4', b'8', b'3', b'6', b'4', b'8'];
    if !eq_bytes(view(s), view(e_neg2b)) { return 15; }

    s.len = 0;
    format_i32_into(mut_view(s), 2147483647i32, 10, 0, false);
    let e_pos2b: [10]u8 = [b'2', b'1', b'4', b'7', b'4', b'8', b'3', b'6', b'4', b'7'];
    if !eq_bytes(view(s), view(e_pos2b)) { return 16; }

    s.len = 0;
    format_i64_into(mut_view(s), -9223372036854775807i64 - 1i64, 10, 0, false);
    let e_neg9q: [20]u8 = [b'-', b'9', b'2', b'2', b'3', b'3', b'7', b'2', b'0', b'3', b'6', b'8', b'5', b'4', b'7', b'7', b'5', b'8', b'0', b'8'];
    if !eq_bytes(view(s), view(e_neg9q)) { return 17; }

    s.len = 0;
    format_i64_into(mut_view(s), 9223372036854775807i64, 10, 0, false);
    let e_pos9q: [19]u8 = [b'9', b'2', b'2', b'3', b'3', b'7', b'2', b'0', b'3', b'6', b'8', b'5', b'4', b'7', b'7', b'5', b'8', b'0', b'7'];
    if !eq_bytes(view(s), view(e_pos9q)) { return 18; }

    s.len = 0;
    format_isize_into(mut_view(s), -9223372036854775807isize - 1isize, 10, 0, false);
    let e_neg9q_isize: [20]u8 = [b'-', b'9', b'2', b'2', b'3', b'3', b'7', b'2', b'0', b'3', b'6', b'8', b'5', b'4', b'7', b'7', b'5', b'8', b'0', b'8'];
    if !eq_bytes(view(s), view(e_neg9q_isize)) { return 19; }

    s.len = 0;
    format_isize_into(mut_view(s), 9223372036854775807isize, 10, 0, false);
    let e_pos9q_isize: [19]u8 = [b'9', b'2', b'2', b'3', b'3', b'7', b'2', b'0', b'3', b'6', b'8', b'5', b'4', b'7', b'7', b'5', b'8', b'0', b'7'];
    if !eq_bytes(view(s), view(e_pos9q_isize)) { return 20; }

    0
}

fn test_hex_and_bin_formatting() -> i32 {
    let mut s = string_new();

    format_u8_into(mut_view(s), 255u8, 16, 0, false);
    let e_ff: [2]u8 = [b'f', b'f'];
    if !eq_bytes(view(s), view(e_ff)) { return 31; }

    s.len = 0;
    format_u16_into(mut_view(s), 0xABCDu16, 16, 0, false);
    let e_abcd: [4]u8 = [b'a', b'b', b'c', b'd'];
    if !eq_bytes(view(s), view(e_abcd)) { return 32; }

    s.len = 0;
    format_u32_into(mut_view(s), 0x12345678u32, 16, 0, false);
    let e_1234: [8]u8 = [b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8'];
    if !eq_bytes(view(s), view(e_1234)) { return 33; }

    s.len = 0;
    format_u64_into(mut_view(s), 0x0123456789ABCDEFu64, 16, 16, true);
    let e_hex64: [16]u8 = [b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f'];
    if !eq_bytes(view(s), view(e_hex64)) { return 34; }

    s.len = 0;
    format_u8_into(mut_view(s), 5u8, 2, 8, true);
    let e_bin1: [8]u8 = [b'0', b'0', b'0', b'0', b'0', b'1', b'0', b'1'];
    if !eq_bytes(view(s), view(e_bin1)) { return 35; }

    s.len = 0;
    format_u8_into(mut_view(s), 255u8, 2, 0, false);
    let e_bin2: [8]u8 = [b'1', b'1', b'1', b'1', b'1', b'1', b'1', b'1'];
    if !eq_bytes(view(s), view(e_bin2)) { return 36; }

    s.len = 0;
    format_u16_into(mut_view(s), 0x55AAu16, 2, 16, true);
    let e_bin3: [16]u8 = [b'0', b'1', b'0', b'1', b'0', b'1', b'0', b'1', b'1', b'0', b'1', b'0', b'1', b'0', b'1', b'0'];
    if !eq_bytes(view(s), view(e_bin3)) { return 37; }

    s.len = 0;
    format_u64_into(mut_view(s), 255u64, 8, 0, false);
    let e_377: [3]u8 = [b'3', b'7', b'7'];
    if !eq_bytes(view(s), view(e_377)) { return 38; }

    s.len = 0;
    format_u64_into(mut_view(s), 35u64, 36, 0, false);
    let e_z: [1]u8 = [b'z'];
    if !eq_bytes(view(s), view(e_z)) { return 39; }

    0
}

fn test_width_and_padding() -> i32 {
    let mut s = string_new();

    format_u32_into(mut_view(s), 42u32, 10, 5, true);
    let e_pad1: [5]u8 = [b'0', b'0', b'0', b'4', b'2'];
    if !eq_bytes(view(s), view(e_pad1)) { return 41; }

    s.len = 0;
    format_u32_into(mut_view(s), 42u32, 10, 5, false);
    let e_pad2: [5]u8 = [b' ', b' ', b' ', b'4', b'2'];
    if !eq_bytes(view(s), view(e_pad2)) { return 42; }

    s.len = 0;
    format_i32_into(mut_view(s), -42i32, 10, 5, true);
    let e_pad3: [5]u8 = [b'-', b'0', b'0', b'4', b'2'];
    if !eq_bytes(view(s), view(e_pad3)) { return 43; }

    s.len = 0;
    format_i32_into(mut_view(s), -42i32, 10, 5, false);
    let e_pad4: [5]u8 = [b' ', b' ', b'-', b'4', b'2'];
    if !eq_bytes(view(s), view(e_pad4)) { return 44; }

    s.len = 0;
    format_u32_into(mut_view(s), 12345u32, 10, 3, true);
    let e_pad5: [5]u8 = [b'1', b'2', b'3', b'4', b'5'];
    if !eq_bytes(view(s), view(e_pad5)) { return 45; }

    s.len = 0;
    format_u32_into(mut_view(s), 0u32, 10, 4, true);
    let e_pad6: [4]u8 = [b'0', b'0', b'0', b'0'];
    if !eq_bytes(view(s), view(e_pad6)) { return 46; }

    s.len = 0;
    format_u32_into(mut_view(s), 0u32, 10, 4, false);
    let e_pad7: [4]u8 = [b' ', b' ', b' ', b'0'];
    if !eq_bytes(view(s), view(e_pad7)) { return 47; }

    0
}

fn main() -> i32 {
    let r1 = test_unsigned_min_max();
    if r1 != 0 { return r1; }

    let r2 = test_signed_min_max();
    if r2 != 0 { return r2; }

    let r3 = test_hex_and_bin_formatting();
    if r3 != 0 { return r3; }

    let r4 = test_width_and_padding();
    if r4 != 0 { return r4; }

    print("OK IntFormat\n");
    return 0;
}
