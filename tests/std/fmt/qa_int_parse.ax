// test: run
// stdout: OK IntParse\n

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = 1usize;
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 16 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        *(s.ptr + s.len) = (c as u32) as u8;
    }
    s.len = s.len + 1;
}

pub fn format_u64_into(out: mut_view<String>, val: u64, radix: u32, width: usize, zero_pad: bool) {
    let rad = if radix < 2 || radix > 36 { 10u32 } else { radix };
    let w = width;
    let pad = zero_pad;
    let v = val;
    if v == 0 {
        let pad_count = if w > 1 { w - 1 } else { 0 };
        let pad_c = if pad { '0' } else { ' ' };
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), pad_c);
            p = p + 1;
        }
        string_push_char(mut_view(*out), '0');
        return;
    }
    let mut rem = v;
    let mut buf: [65]u8 = [0u8; 65];
    let mut count: usize = 0;
    let r64 = rad as u64;
    while rem > 0 {
        let mut q: u64 = 0;
        let mut digit: u32 = 0;
        if (rem as i64) >= 0 {
            q = rem / r64;
            digit = (rem % r64) as u32;
        } else {
            let half = rem >> 1;
            let q_half = half / r64;
            let r_half = half % r64;
            let mut q_sub = q_half + q_half;
            let mut r_sub = r_half + r_half + (rem & 1u64);
            if r_sub >= r64 {
                q_sub = q_sub + 1;
                r_sub = r_sub - r64;
            }
            q = q_sub;
            digit = r_sub as u32;
        }
        let c: u8 = if digit < 10 {
            b'0' + digit as u8
        } else {
            b'a' + (digit - 10) as u8
        };
        buf[count] = c;
        rem = q;
        count = count + 1;
    }
    let needed = count;
    let pad_count = if w > needed { w - needed } else { 0 };
    let pad_c = if pad { '0' } else { ' ' };
    let mut p: usize = 0;
    while p < pad_count {
        string_push_char(mut_view(*out), pad_c);
        p = p + 1;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        string_push_char(mut_view(*out), buf[i] as char);
    }
}

pub fn format_i64_into(out: mut_view<String>, val: i64, radix: u32, width: usize, zero_pad: bool) {
    let rad = if radix < 2 || radix > 36 { 10u32 } else { radix };
    let w = width;
    let pad = zero_pad;
    let v = val;
    if v >= 0 {
        format_u64_into(out, v as u64, rad, w, pad);
        return;
    }
    let mag: u64 = (~(v as u64)) + 1u64;
    let mut rem = mag;
    let mut buf: [65]u8 = [0u8; 65];
    let mut count: usize = 0;
    let r64 = rad as u64;
    while rem > 0 {
        let mut q: u64 = 0;
        let mut digit: u32 = 0;
        if (rem as i64) >= 0 {
            q = rem / r64;
            digit = (rem % r64) as u32;
        } else {
            let half = rem >> 1;
            let q_half = half / r64;
            let r_half = half % r64;
            let mut q_sub = q_half + q_half;
            let mut r_sub = r_half + r_half + (rem & 1u64);
            if r_sub >= r64 {
                q_sub = q_sub + 1;
                r_sub = r_sub - r64;
            }
            q = q_sub;
            digit = r_sub as u32;
        }
        let c: u8 = if digit < 10 {
            b'0' + digit as u8
        } else {
            b'a' + (digit - 10) as u8
        };
        buf[count] = c;
        rem = q;
        count = count + 1;
    }
    let needed = 1 + count;
    let pad_count = if w > needed { w - needed } else { 0 };
    if pad {
        string_push_char(mut_view(*out), '-');
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), '0');
            p = p + 1;
        }
    } else {
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), ' ');
            p = p + 1;
        }
        string_push_char(mut_view(*out), '-');
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        string_push_char(mut_view(*out), buf[i] as char);
    }
}

pub enum ParseIntError {
    Empty,
    InvalidDigit,
    Overflow,
}

fn char_to_digit(c: u8, radix: u32) -> i32 {
    let mut d: u32 = 999;
    if c >= b'0' && c <= b'9' {
        d = (c - b'0') as u32;
    } else if c >= b'a' && c <= b'z' {
        d = (c - b'a') as u32 + 10;
    } else if c >= b'A' && c <= b'Z' {
        d = (c - b'A') as u32 + 10;
    }
    if d < radix {
        d as i32
    } else {
        -1
    }
}

fn u64_div_u32(n: u64, d: u32) -> u64 {
    let d64 = (d as u64) & 0xFFFF_FFFFu64;
    let high = (n >> 32) & 0xFFFF_FFFFu64;
    let low = n & 0xFFFF_FFFFu64;
    let q_high = high / d64;
    let r_high = high % d64;
    let rem_shifted = r_high << 32;
    let combined = rem_shifted | low;
    let q_low = combined / d64;
    (q_high << 32) | q_low
}

pub fn parse_u64_radix(bytes: view<[u8]>, radix: u32) -> Result<u64, ParseIntError> {
    if radix < 2 || radix > 36 {
        return Result.Err(ParseIntError.InvalidDigit);
    }
    let n = len(bytes);
    if n == 0 {
        return Result.Err(ParseIntError.Empty);
    }
    let mut i: usize = 0;
    if bytes[i] == b'+' {
        i = i + 1;
    }
    if i == n {
        return Result.Err(ParseIntError.Empty);
    }
    if radix == 16 && i + 2 <= n && bytes[i] == b'0' && (bytes[i + 1] == b'x' || bytes[i + 1] == b'X') {
        i = i + 2;
        if i == n {
            return Result.Err(ParseIntError.Empty);
        }
    } else if radix == 2 && i + 2 <= n && bytes[i] == b'0' && (bytes[i + 1] == b'b' || bytes[i + 1] == b'B') {
        i = i + 2;
        if i == n {
            return Result.Err(ParseIntError.Empty);
        }
    } else if radix == 8 && i + 2 <= n && bytes[i] == b'0' && (bytes[i + 1] == b'o' || bytes[i + 1] == b'O') {
        i = i + 2;
        if i == n {
            return Result.Err(ParseIntError.Empty);
        }
    }
    let mut acc: u64 = 0;
    let r64 = (radix as u64) & 0xFFFF_FFFFu64;
    let max_u64 = 0xFFFF_FFFF_FFFF_FFFFu64;
    let max_before = u64_div_u32(max_u64, radix);
    let max_rem = max_u64 - (max_before * r64);
    while i < n {
        let c = bytes[i];
        let digit = char_to_digit(c, radix);
        if digit < 0 {
            return Result.Err(ParseIntError.InvalidDigit);
        }
        let d64 = (digit as u64) & 0xFFFF_FFFFu64;
        if acc > max_before || (acc == max_before && d64 > max_rem) {
            return Result.Err(ParseIntError.Overflow);
        }
        acc = acc * r64 + d64;
        i = i + 1;
    }
    Result.Ok(acc)
}

pub fn parse_i64_radix(bytes: view<[u8]>, radix: u32) -> Result<i64, ParseIntError> {
    if radix < 2 || radix > 36 {
        return Result.Err(ParseIntError.InvalidDigit);
    }
    let n = len(bytes);
    if n == 0 {
        return Result.Err(ParseIntError.Empty);
    }
    let mut i: usize = 0;
    let mut is_neg = false;
    if bytes[i] == b'-' {
        is_neg = true;
        i = i + 1;
    } else if bytes[i] == b'+' {
        i = i + 1;
    }
    if i == n {
        return Result.Err(ParseIntError.Empty);
    }
    if radix == 16 && i + 2 <= n && bytes[i] == b'0' && (bytes[i + 1] == b'x' || bytes[i + 1] == b'X') {
        i = i + 2;
        if i == n {
            return Result.Err(ParseIntError.Empty);
        }
    } else if radix == 2 && i + 2 <= n && bytes[i] == b'0' && (bytes[i + 1] == b'b' || bytes[i + 1] == b'B') {
        i = i + 2;
        if i == n {
            return Result.Err(ParseIntError.Empty);
        }
    } else if radix == 8 && i + 2 <= n && bytes[i] == b'0' && (bytes[i + 1] == b'o' || bytes[i + 1] == b'O') {
        i = i + 2;
        if i == n {
            return Result.Err(ParseIntError.Empty);
        }
    }
    let limit: u64 = if is_neg { 0x8000_0000_0000_0000u64 } else { 0x7FFF_FFFF_FFFF_FFFFu64 };
    let mut acc: u64 = 0;
    let r64 = (radix as u64) & 0xFFFF_FFFFu64;
    let max_before = u64_div_u32(limit, radix);
    let max_rem = limit - (max_before * r64);
    while i < n {
        let c = bytes[i];
        let digit = char_to_digit(c, radix);
        if digit < 0 {
            return Result.Err(ParseIntError.InvalidDigit);
        }
        let d64 = (digit as u64) & 0xFFFF_FFFFu64;
        if acc > max_before || (acc == max_before && d64 > max_rem) {
            return Result.Err(ParseIntError.Overflow);
        }
        acc = acc * r64 + d64;
        i = i + 1;
    }
    if is_neg {
        if acc == 0x8000_0000_0000_0000u64 {
            Result.Ok(-9223372036854775807i64 - 1i64)
        } else {
            Result.Ok(- (acc as i64))
        }
    } else {
        Result.Ok(acc as i64)
    }
}

pub fn parse_u8_radix(bytes: view<[u8]>, radix: u32) -> Result<u8, ParseIntError> {
    match parse_u64_radix(bytes, radix) {
        Result.Ok(v) => {
            if v > 255u64 { Result.Err(ParseIntError.Overflow) }
            else { Result.Ok(v as u8) }
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn parse_u16_radix(bytes: view<[u8]>, radix: u32) -> Result<u16, ParseIntError> {
    match parse_u64_radix(bytes, radix) {
        Result.Ok(v) => {
            if v > 65535u64 { Result.Err(ParseIntError.Overflow) }
            else { Result.Ok(v as u16) }
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn parse_u32_radix(bytes: view<[u8]>, radix: u32) -> Result<u32, ParseIntError> {
    match parse_u64_radix(bytes, radix) {
        Result.Ok(v) => {
            if v > 4294967295u64 { Result.Err(ParseIntError.Overflow) }
            else { Result.Ok(v as u32) }
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn parse_usize_radix(bytes: view<[u8]>, radix: u32) -> Result<usize, ParseIntError> {
    match parse_u64_radix(bytes, radix) {
        Result.Ok(v) => Result.Ok(v as usize),
        Result.Err(e) => Result.Err(e),
    }
}

pub fn parse_i8_radix(bytes: view<[u8]>, radix: u32) -> Result<i8, ParseIntError> {
    match parse_i64_radix(bytes, radix) {
        Result.Ok(v) => {
            if v < -128i64 || v > 127i64 { Result.Err(ParseIntError.Overflow) }
            else { Result.Ok(v as i8) }
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn parse_i16_radix(bytes: view<[u8]>, radix: u32) -> Result<i16, ParseIntError> {
    match parse_i64_radix(bytes, radix) {
        Result.Ok(v) => {
            if v < -32768i64 || v > 32767i64 { Result.Err(ParseIntError.Overflow) }
            else { Result.Ok(v as i16) }
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn parse_i32_radix(bytes: view<[u8]>, radix: u32) -> Result<i32, ParseIntError> {
    match parse_i64_radix(bytes, radix) {
        Result.Ok(v) => {
            if v < -2147483648i64 || v > 2147483647i64 { Result.Err(ParseIntError.Overflow) }
            else { Result.Ok(v as i32) }
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn parse_isize_radix(bytes: view<[u8]>, radix: u32) -> Result<isize, ParseIntError> {
    match parse_i64_radix(bytes, radix) {
        Result.Ok(v) => Result.Ok(v as isize),
        Result.Err(e) => Result.Err(e),
    }
}

pub fn parse_u8(bytes: view<[u8]>) -> Result<u8, ParseIntError> { parse_u8_radix(bytes, 10) }
pub fn parse_u16(bytes: view<[u8]>) -> Result<u16, ParseIntError> { parse_u16_radix(bytes, 10) }
pub fn parse_u32(bytes: view<[u8]>) -> Result<u32, ParseIntError> { parse_u32_radix(bytes, 10) }
pub fn parse_u64(bytes: view<[u8]>) -> Result<u64, ParseIntError> { parse_u64_radix(bytes, 10) }
pub fn parse_usize(bytes: view<[u8]>) -> Result<usize, ParseIntError> { parse_usize_radix(bytes, 10) }

pub fn parse_i8(bytes: view<[u8]>) -> Result<i8, ParseIntError> { parse_i8_radix(bytes, 10) }
pub fn parse_i16(bytes: view<[u8]>) -> Result<i16, ParseIntError> { parse_i16_radix(bytes, 10) }
pub fn parse_i32(bytes: view<[u8]>) -> Result<i32, ParseIntError> { parse_i32_radix(bytes, 10) }
pub fn parse_i64(bytes: view<[u8]>) -> Result<i64, ParseIntError> { parse_i64_radix(bytes, 10) }
pub fn parse_isize(bytes: view<[u8]>) -> Result<isize, ParseIntError> { parse_isize_radix(bytes, 10) }

fn check_u8(bytes: view<[u8]>, expected: u8) -> bool {
    match parse_u8(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_u16(bytes: view<[u8]>, expected: u16) -> bool {
    match parse_u16(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_u32(bytes: view<[u8]>, expected: u32) -> bool {
    match parse_u32(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_u64(bytes: view<[u8]>, expected: u64) -> bool {
    match parse_u64(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_usize(bytes: view<[u8]>, expected: usize) -> bool {
    match parse_usize(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}

fn check_i8(bytes: view<[u8]>, expected: i8) -> bool {
    match parse_i8(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_i16(bytes: view<[u8]>, expected: i16) -> bool {
    match parse_i16(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_i32(bytes: view<[u8]>, expected: i32) -> bool {
    match parse_i32(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_i64(bytes: view<[u8]>, expected: i64) -> bool {
    match parse_i64(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_isize(bytes: view<[u8]>, expected: isize) -> bool {
    match parse_isize(bytes) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}

fn check_u32_radix(bytes: view<[u8]>, radix: u32, expected: u32) -> bool {
    match parse_u32_radix(bytes, radix) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}
fn check_u64_radix(bytes: view<[u8]>, radix: u32, expected: u64) -> bool {
    match parse_u64_radix(bytes, radix) { Result.Ok(v) => v == expected, Result.Err(_) => false }
}

fn check_u64_err_empty(bytes: view<[u8]>) -> bool {
    match parse_u64(bytes) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.Empty => true, _ => false } }
}
fn check_i64_err_empty(bytes: view<[u8]>) -> bool {
    match parse_i64(bytes) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.Empty => true, _ => false } }
}
fn check_u64_radix_err_empty(bytes: view<[u8]>, radix: u32) -> bool {
    match parse_u64_radix(bytes, radix) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.Empty => true, _ => false } }
}

fn check_u64_err_invalid(bytes: view<[u8]>) -> bool {
    match parse_u64(bytes) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.InvalidDigit => true, _ => false } }
}
fn check_u64_radix_err_invalid(bytes: view<[u8]>, radix: u32) -> bool {
    match parse_u64_radix(bytes, radix) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.InvalidDigit => true, _ => false } }
}

fn check_u8_err_overflow(bytes: view<[u8]>) -> bool {
    match parse_u8(bytes) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.Overflow => true, _ => false } }
}
fn check_i8_err_overflow(bytes: view<[u8]>) -> bool {
    match parse_i8(bytes) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.Overflow => true, _ => false } }
}
fn check_u16_err_overflow(bytes: view<[u8]>) -> bool {
    match parse_u16(bytes) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.Overflow => true, _ => false } }
}
fn check_u32_err_overflow(bytes: view<[u8]>) -> bool {
    match parse_u32(bytes) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.Overflow => true, _ => false } }
}
fn check_u64_err_overflow(bytes: view<[u8]>) -> bool {
    match parse_u64(bytes) { Result.Ok(_) => false, Result.Err(e) => match e { ParseIntError.Overflow => true, _ => false } }
}

fn test_parse_unsigned_min_max() -> i32 {
    let b0: [1]u8 = [b'0'];
    let b255: [3]u8 = [b'2', b'5', b'5'];
    if !check_u8(view(b0), 0u8) { return 1; }
    if !check_u8(view(b255), 255u8) { return 2; }

    let b65535: [5]u8 = [b'6', b'5', b'5', b'3', b'5'];
    if !check_u16(view(b0), 0u16) { return 3; }
    if !check_u16(view(b65535), 65535u16) { return 4; }

    let b4294967295: [10]u8 = [b'4', b'2', b'9', b'4', b'9', b'6', b'7', b'2', b'9', b'5'];
    if !check_u32(view(b0), 0u32) { return 5; }
    if !check_u32(view(b4294967295), 4294967295u32) { return 6; }

    let b_max64: [20]u8 = [
        b'1', b'8', b'4', b'4', b'6', b'7', b'4', b'4', b'0', b'7',
        b'3', b'7', b'0', b'9', b'5', b'5', b'1', b'6', b'1', b'5'
    ];
    if !check_u64(view(b0), 0u64) { return 7; }
    if !check_u64(view(b_max64), 0xFFFF_FFFF_FFFF_FFFFu64) { return 8; }

    if !check_usize(view(b0), 0usize) { return 9; }
    if !check_usize(view(b_max64), 0xFFFF_FFFF_FFFF_FFFFusize) { return 10; }

    0
}

fn test_parse_signed_min_max() -> i32 {
    let b_min_i8: [4]u8 = [b'-', b'1', b'2', b'8'];
    let b_max_i8: [3]u8 = [b'1', b'2', b'7'];
    if !check_i8(view(b_min_i8), -128i8) { return 21; }
    if !check_i8(view(b_max_i8), 127i8) { return 22; }

    let b_min_i16: [6]u8 = [b'-', b'3', b'2', b'7', b'6', b'8'];
    let b_max_i16: [5]u8 = [b'3', b'2', b'7', b'6', b'7'];
    if !check_i16(view(b_min_i16), -32768i16) { return 23; }
    if !check_i16(view(b_max_i16), 32767i16) { return 24; }

    let b_min_i32: [11]u8 = [b'-', b'2', b'1', b'4', b'7', b'4', b'8', b'3', b'6', b'4', b'8'];
    let b_max_i32: [10]u8 = [b'2', b'1', b'4', b'7', b'4', b'8', b'3', b'6', b'4', b'7'];
    if !check_i32(view(b_min_i32), -2147483648i32) { return 25; }
    if !check_i32(view(b_max_i32), 2147483647i32) { return 26; }

    let b_min_i64: [20]u8 = [
        b'-', b'9', b'2', b'2', b'3', b'3', b'7', b'2', b'0', b'3',
        b'6', b'8', b'5', b'4', b'7', b'7', b'5', b'8', b'0', b'8'
    ];
    let b_max_i64: [19]u8 = [
        b'9', b'2', b'2', b'3', b'3', b'7', b'2', b'0', b'3',
        b'6', b'8', b'5', b'4', b'7', b'7', b'5', b'8', b'0', b'7'
    ];
    let min_i64 = -9223372036854775807i64 - 1i64;
    if !check_i64(view(b_min_i64), min_i64) { return 27; }
    if !check_i64(view(b_max_i64), 9223372036854775807i64) { return 28; }

    let min_isize = -9223372036854775807isize - 1isize;
    if !check_isize(view(b_min_i64), min_isize) { return 29; }
    if !check_isize(view(b_max_i64), 9223372036854775807isize) { return 30; }

    0
}

fn test_parse_prefixes_and_radix() -> i32 {
    let b_hex1: [4]u8 = [b'0', b'x', b'1', b'0'];
    if !check_u32_radix(view(b_hex1), 16, 16u32) { return 41; }

    let b_hex2: [4]u8 = [b'0', b'X', b'F', b'F'];
    if !check_u32_radix(view(b_hex2), 16, 255u32) { return 42; }

    let b_hex3: [4]u8 = [b'a', b'b', b'c', b'd'];
    if !check_u32_radix(view(b_hex3), 16, 0xABCDu32) { return 43; }

    let b_bin1: [5]u8 = [b'0', b'b', b'1', b'0', b'1'];
    if !check_u32_radix(view(b_bin1), 2, 5u32) { return 44; }

    let b_bin2: [6]u8 = [b'0', b'B', b'1', b'1', b'1', b'1'];
    if !check_u32_radix(view(b_bin2), 2, 15u32) { return 45; }

    let b_oct1: [4]u8 = [b'0', b'o', b'7', b'7'];
    if !check_u32_radix(view(b_oct1), 8, 63u32) { return 46; }

    let b_oct2: [4]u8 = [b'0', b'O', b'1', b'0'];
    if !check_u32_radix(view(b_oct2), 8, 8u32) { return 47; }

    let b_plus: [3]u8 = [b'+', b'4', b'2'];
    match parse_i32(view(b_plus)) { Result.Ok(v) => { if v != 42i32 { return 48; } }, Result.Err(_) => { return 49; } }
    match parse_u32(view(b_plus)) { Result.Ok(v) => { if v != 42u32 { return 50; } }, Result.Err(_) => { return 51; } }

    let b_minus: [3]u8 = [b'-', b'4', b'2'];
    match parse_i32(view(b_minus)) { Result.Ok(v) => { if v != -42i32 { return 52; } }, Result.Err(_) => { return 53; } }

    let b_z: [1]u8 = [b'z'];
    if !check_u64_radix(view(b_z), 36, 35u64) { return 54; }

    let b_base36: [2]u8 = [b'1', b'0'];
    if !check_u64_radix(view(b_base36), 36, 36u64) { return 55; }

    0
}

fn test_parse_errors() -> i32 {
    let b_empty: [0]u8 = [];
    if !check_u64_err_empty(view(b_empty)) { return 71; }

    let b_plus_only: [1]u8 = [b'+'];
    if !check_u64_err_empty(view(b_plus_only)) { return 74; }

    let b_minus_only: [1]u8 = [b'-'];
    if !check_i64_err_empty(view(b_minus_only)) { return 77; }

    let b_hex_prefix_only: [2]u8 = [b'0', b'x'];
    if !check_u64_radix_err_empty(view(b_hex_prefix_only), 16) { return 80; }

    let b_inv_digit: [4]u8 = [b'1', b'2', b'3', b'a'];
    if !check_u64_err_invalid(view(b_inv_digit)) { return 83; }

    let b_ten: [2]u8 = [b'1', b'0'];
    if !check_u64_radix_err_invalid(view(b_ten), 1) { return 86; }

    let b_ovf_u8: [3]u8 = [b'2', b'5', b'6'];
    if !check_u8_err_overflow(view(b_ovf_u8)) { return 89; }

    let b_ovf_i8_pos: [3]u8 = [b'1', b'2', b'8'];
    if !check_i8_err_overflow(view(b_ovf_i8_pos)) { return 92; }

    let b_ovf_i8_neg: [4]u8 = [b'-', b'1', b'2', b'9'];
    if !check_i8_err_overflow(view(b_ovf_i8_neg)) { return 95; }

    let b_ovf_u16: [5]u8 = [b'6', b'5', b'5', b'3', b'6'];
    if !check_u16_err_overflow(view(b_ovf_u16)) { return 98; }

    let b_ovf_u32: [10]u8 = [b'4', b'2', b'9', b'4', b'9', b'6', b'7', b'2', b'9', b'6'];
    if !check_u32_err_overflow(view(b_ovf_u32)) { return 101; }

    let b_ovf_u64: [20]u8 = [
        b'1', b'8', b'4', b'4', b'6', b'7', b'4', b'4', b'0', b'7',
        b'3', b'7', b'0', b'9', b'5', b'5', b'1', b'6', b'1', b'6'
    ];
    if !check_u64_err_overflow(view(b_ovf_u64)) { return 104; }

    0
}

fn test_round_trip() -> i32 {
    let mut s = string_new();
    let mut buf: [32]u8 = [0u8; 32];

    // Round-trip u64 MAX
    let u64_max = 0xFFFF_FFFF_FFFF_FFFFu64;
    s.len = 0;
    format_u64_into(mut_view(s), u64_max, 10, 0, false);
    let mut i: usize = 0;
    while i < s.len {
        buf[i] = unsafe { *(s.ptr + i) };
        i = i + 1;
    }
    let v_buf: view<[u8]> = view(buf); let sub = v_buf[..s.len];
    if !check_u64(sub, u64_max) { return 111; }

    // Round-trip i64 MIN
    let min_i64 = -9223372036854775807i64 - 1i64;
    s.len = 0;
    format_i64_into(mut_view(s), min_i64, 10, 0, false);
    i = 0;
    while i < s.len {
        buf[i] = unsafe { *(s.ptr + i) };
        i = i + 1;
    }
    let v_buf2: view<[u8]> = view(buf); let sub2 = v_buf2[..s.len];
    if !check_i64(sub2, min_i64) { return 113; }

    // Round-trip hex u32
    let val_hex = 0xDEADBEEFu64;
    s.len = 0;
    format_u64_into(mut_view(s), val_hex, 16, 0, false);
    i = 0;
    while i < s.len {
        buf[i] = unsafe { *(s.ptr + i) };
        i = i + 1;
    }
    let v_buf3: view<[u8]> = view(buf); let sub3 = v_buf3[..s.len];
    if !check_u64_radix(sub3, 16, val_hex) { return 115; }

    0
}

fn main() -> i32 {
    let r1 = test_parse_unsigned_min_max();
    if r1 != 0 { return r1; }

    let r2 = test_parse_signed_min_max();
    if r2 != 0 { return r2; }

    let r3 = test_parse_prefixes_and_radix();
    if r3 != 0 { return r3; }

    let r4 = test_parse_errors();
    if r4 != 0 { return r4; }

    let r5 = test_round_trip();
    if r5 != 0 { return r5; }

    print("OK IntParse\n");
    return 0;
}
