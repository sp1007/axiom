// test: run
// stdout: OK FmtHelpers\n

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let clen = 1usize;
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 16 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    unsafe {
        *(s.ptr + s.len) = (c as u32) as u8;
    }
    s.len = s.len + 1;
}

pub fn format_u64_into(out: mut_view<String>, val: u64, radix: u32, width: usize, zero_pad: bool) {
    let rad = if radix < 2 || radix > 36 { 10u32 } else { radix };
    let w = width;
    let pad = zero_pad;
    let v = val;
    if v == 0 {
        let pad_count = if w > 1 { w - 1 } else { 0 };
        let pad_c = if pad { '0' } else { ' ' };
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), pad_c);
            p = p + 1;
        }
        string_push_char(mut_view(*out), '0');
        return;
    }
    let mut rem = v;
    let mut buf: [65]u8 = [0u8; 65];
    let mut count: usize = 0;
    let r64 = rad as u64;
    while rem > 0 {
        let mut q: u64 = 0;
        let mut digit: u32 = 0;
        if (rem as i64) >= 0 {
            q = rem / r64;
            digit = (rem % r64) as u32;
        } else {
            let half = rem >> 1;
            let q_half = half / r64;
            let r_half = half % r64;
            let mut q_sub = q_half + q_half;
            let mut r_sub = r_half + r_half + (rem & 1u64);
            if r_sub >= r64 {
                q_sub = q_sub + 1;
                r_sub = r_sub - r64;
            }
            q = q_sub;
            digit = r_sub as u32;
        }
        let c: u8 = if digit < 10 {
            b'0' + digit as u8
        } else {
            b'a' + (digit - 10) as u8
        };
        buf[count] = c;
        rem = q;
        count = count + 1;
    }
    let needed = count;
    let pad_count = if w > needed { w - needed } else { 0 };
    let pad_c = if pad { '0' } else { ' ' };
    let mut p: usize = 0;
    while p < pad_count {
        string_push_char(mut_view(*out), pad_c);
        p = p + 1;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        string_push_char(mut_view(*out), buf[i] as char);
    }
}

pub fn format_i64_into(out: mut_view<String>, val: i64, radix: u32, width: usize, zero_pad: bool) {
    let rad = if radix < 2 || radix > 36 { 10u32 } else { radix };
    let w = width;
    let pad = zero_pad;
    let v = val;
    if v >= 0 {
        format_u64_into(out, v as u64, rad, w, pad);
        return;
    }
    let mag: u64 = (~(v as u64)) + 1u64;
    let mut rem = mag;
    let mut buf: [65]u8 = [0u8; 65];
    let mut count: usize = 0;
    let r64 = rad as u64;
    while rem > 0 {
        let mut q: u64 = 0;
        let mut digit: u32 = 0;
        if (rem as i64) >= 0 {
            q = rem / r64;
            digit = (rem % r64) as u32;
        } else {
            let half = rem >> 1;
            let q_half = half / r64;
            let r_half = half % r64;
            let mut q_sub = q_half + q_half;
            let mut r_sub = r_half + r_half + (rem & 1u64);
            if r_sub >= r64 {
                q_sub = q_sub + 1;
                r_sub = r_sub - r64;
            }
            q = q_sub;
            digit = r_sub as u32;
        }
        let c: u8 = if digit < 10 {
            b'0' + digit as u8
        } else {
            b'a' + (digit - 10) as u8
        };
        buf[count] = c;
        rem = q;
        count = count + 1;
    }
    let needed = 1 + count;
    let pad_count = if w > needed { w - needed } else { 0 };
    if pad {
        string_push_char(mut_view(*out), '-');
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), '0');
            p = p + 1;
        }
    } else {
        let mut p: usize = 0;
        while p < pad_count {
            string_push_char(mut_view(*out), ' ');
            p = p + 1;
        }
        string_push_char(mut_view(*out), '-');
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        string_push_char(mut_view(*out), buf[i] as char);
    }
}

pub fn format_into_bool(out: mut_view<String>, b: bool) {
    if b {
        string_push_char(mut_view(*out), 't');
        string_push_char(mut_view(*out), 'r');
        string_push_char(mut_view(*out), 'u');
        string_push_char(mut_view(*out), 'e');
    } else {
        string_push_char(mut_view(*out), 'f');
        string_push_char(mut_view(*out), 'a');
        string_push_char(mut_view(*out), 'l');
        string_push_char(mut_view(*out), 's');
        string_push_char(mut_view(*out), 'e');
    }
}

pub fn format_into_char(out: mut_view<String>, c: char) {
    string_push_char(out, c);
}

pub fn format_into_bytes(out: mut_view<String>, bytes: view<[u8]>) {
    let n = len(bytes);
    let mut i: usize = 0;
    while i < n {
        string_push_char(mut_view(*out), bytes[i] as char);
        i = i + 1;
    }
}

pub fn format_into_int(out: mut_view<String>, val: i64) {
    format_i64_into(out, val, 10, 0, false);
}

pub fn format_into_uint(out: mut_view<String>, val: u64) {
    format_u64_into(out, val, 10, 0, false);
}

pub fn format_into_hex(out: mut_view<String>, val: u64, width: usize, zero_pad: bool) {
    format_u64_into(out, val, 16, width, zero_pad);
}

pub fn format_into_bin(out: mut_view<String>, val: u64, width: usize, zero_pad: bool) {
    format_u64_into(out, val, 2, width, zero_pad);
}

pub fn repeat_char_into(out: mut_view<String>, c: char, count: usize) {
    let mut i: usize = 0;
    while i < count {
        string_push_char(mut_view(*out), c);
        i = i + 1;
    }
}

pub fn pad_left_into(out: mut_view<String>, s: view<String>, width: usize, pad_char: char) {
    if s.len >= width {
        let mut i: usize = 0;
        while i < s.len {
            let sc = unsafe { *(s.ptr + i) };
            string_push_char(mut_view(*out), sc as char);
            i = i + 1;
        }
        return;
    }
    let pad_count = width - s.len;
    let mut i: usize = 0;
    while i < pad_count {
        string_push_char(mut_view(*out), pad_char);
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < s.len {
        let sc = unsafe { *(s.ptr + j) };
        string_push_char(mut_view(*out), sc as char);
        j = j + 1;
    }
}

pub fn pad_right_into(out: mut_view<String>, s: view<String>, width: usize, pad_char: char) {
    let mut j: usize = 0;
    while j < s.len {
        let sc = unsafe { *(s.ptr + j) };
        string_push_char(mut_view(*out), sc as char);
        j = j + 1;
    }
    if s.len >= width {
        return;
    }
    let pad_count = width - s.len;
    let mut i: usize = 0;
    while i < pad_count {
        string_push_char(mut_view(*out), pad_char);
        i = i + 1;
    }
}

fn eq_bytes(s: view<String>, expected: view<[u8]>) -> bool {
    let elen = len(expected);
    if s.len != elen { return false; }
    let mut i: usize = 0;
    while i < elen {
        let sc = unsafe { *(s.ptr + i) };
        if sc != expected[i] { return false; }
        i = i + 1;
    }
    true
}

fn test_format_helpers() -> i32 {
    let mut s = string_new();
    let mut out = string_new();

    // 1. bool true
    s.len = 0;
    format_into_bool(mut_view(s), true);
    let exp_true: [4]u8 = [b't', b'r', b'u', b'e'];
    if !eq_bytes(view(s), view(exp_true)) { return 1; }

    // 2. bool false
    s.len = 0;
    format_into_bool(mut_view(s), false);
    let exp_false: [5]u8 = [b'f', b'a', b'l', b's', b'e'];
    if !eq_bytes(view(s), view(exp_false)) { return 2; }

    // 3. char
    s.len = 0;
    format_into_char(mut_view(s), 'X');
    let exp_char: [1]u8 = [b'X'];
    if !eq_bytes(view(s), view(exp_char)) { return 3; }

    // 4. bytes
    s.len = 0;
    let b: [5]u8 = [b'h', b'e', b'l', b'l', b'o'];
    format_into_bytes(mut_view(s), view(b));
    if !eq_bytes(view(s), view(b)) { return 4; }

    // 5. int
    s.len = 0;
    format_into_int(mut_view(s), -123i64);
    let exp_int: [4]u8 = [b'-', b'1', b'2', b'3'];
    if !eq_bytes(view(s), view(exp_int)) { return 5; }

    // 6. uint
    s.len = 0;
    format_into_uint(mut_view(s), 456u64);
    let exp_uint: [3]u8 = [b'4', b'5', b'6'];
    if !eq_bytes(view(s), view(exp_uint)) { return 6; }

    // 7. hex
    s.len = 0;
    format_into_hex(mut_view(s), 255u64, 4, true);
    let exp_hex: [4]u8 = [b'0', b'0', b'f', b'f'];
    if !eq_bytes(view(s), view(exp_hex)) { return 7; }

    // 8. bin
    s.len = 0;
    format_into_bin(mut_view(s), 5u64, 4, true);
    let exp_bin: [4]u8 = [b'0', b'1', b'0', b'1'];
    if !eq_bytes(view(s), view(exp_bin)) { return 8; }

    // 9. repeat_char
    s.len = 0;
    repeat_char_into(mut_view(s), '=', 5);
    let exp_rep: [5]u8 = [b'=', b'=', b'=', b'=', b'='];
    if !eq_bytes(view(s), view(exp_rep)) { return 9; }

    // 10. pad_left
    s.len = 0;
    format_into_int(mut_view(s), 42i64);
    out.len = 0;
    pad_left_into(mut_view(out), view(s), 5, ' ');
    let exp_pl: [5]u8 = [b' ', b' ', b' ', b'4', b'2'];
    if !eq_bytes(view(out), view(exp_pl)) { return 10; }

    // 11. pad_right
    out.len = 0;
    pad_right_into(mut_view(out), view(s), 5, '.');
    let exp_pr: [5]u8 = [b'4', b'2', b'.', b'.', b'.'];
    if !eq_bytes(view(out), view(exp_pr)) { return 11; }

    0
}

fn main() -> i32 {
    let r = test_format_helpers();
    if r != 0 { return r; }
    print("OK FmtHelpers\n");
    0
}
