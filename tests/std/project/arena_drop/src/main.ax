// test: exec
// cmd: python {test_dir}/arena_drop_oracle.py interp {compiler} {test_dir}/arena_drop {std_root} {tmp}
// exit: 0
// stdout: 42\n2\n0\n2\n0\n66\n3\n0\n3\n0\n2\n2\n4\n0\n77\n1\n0\n

// T160: Project test exercising implicit drop of `std.core.arena.arena.Arena`
// across function scope exit, struct field drop order, early-return cleanup,
// and move-into-struct non-drop of moved source (SPEC-12 AXS-DROP-001..003).

use std.core.arena.arena.Arena
use std.core.arena.arena.arena_with_chunk_size
use std.core.arena.arena.arena_alloc_raw
use std.core.arena.arena.arena_reset
use std.core.arena.arena.arena_chunk_count
use std.core.arena.arena.arena_chunks_freed
use std.core.arena.arena.arena_chunks_in_use

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let _ = align
    if size == 0 {
        return 0 as *mut u8
    }
    let h: *mut u8 = GetProcessHeap()
    if (h as usize) == 0 {
        return 0 as *mut u8
    }
    let alloc_bytes: usize = if size < 16 { 16 } else { size }
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    let _ = size
    let _ = align
    if (p as usize) != 0 {
        let h: *mut u8 = GetProcessHeap()
        if (h as usize) != 0 {
            let _ = HeapFree(h, 0u32, p)
        }
    }
}

unsafe fn ptr_from_view(v: view<Arena>) -> *const Arena {
    address_of(*v)
}

fn emit_num(n: i64) {
    if n == 0 {
        print("0\n")
    } else if n == 1 {
        print("1\n")
    } else if n == 2 {
        print("2\n")
    } else if n == 3 {
        print("3\n")
    } else if n == 4 {
        print("4\n")
    } else if n == 42 {
        print("42\n")
    } else if n == 66 {
        print("66\n")
    } else if n == 77 {
        print("77\n")
    } else {
        print("unexpected\n")
    }
}

// Companion drop-observer that reads `Arena` counters after `Arena.drop` runs.
struct ArenaProbe {
    pub arena_ptr: *const Arena,
}

impl Drop for ArenaProbe {
    fn drop(self: mut_view<ArenaProbe>) {
        if (self.arena_ptr as usize) != 0 {
            let freed: usize = unsafe { (*self.arena_ptr).chunks_freed }
            let remaining: usize = unsafe { (*self.arena_ptr).chunk_count }
            emit_num(freed as i64)
            emit_num(remaining as i64)
        }
    }
}

// 1. Allocate from `Arena` in a function and observe implicit drop at scope exit.
// By SPEC-12 AXS-DROP-002, locals drop in reverse declaration order:
// `probe` is declared first, `a` is declared second -> `a` drops first,
// freeing its 2 chunks (`chunks_freed = 2`, `chunk_count = 0`), then `probe`
// drops second and observes those post-drop counters.
fn run_in_fn() -> i32 {
    let mut probe = ArenaProbe { arena_ptr: 0 as *const Arena }
    let mut a: Arena = arena_with_chunk_size(64)
    let p1: *mut u8 = arena_alloc_raw(mut_view(a), 48, 8)
    let p2: *mut u8 = arena_alloc_raw(mut_view(a), 48, 8)
    if (p1 as usize) == 0 || (p2 as usize) == 0 {
        return 1
    }
    unsafe {
        *p1 = 10u8
        *p2 = 32u8
        let sum: i64 = (*p1 as i64) + (*p2 as i64)
        emit_num(sum)
    }
    probe.arena_ptr = unsafe { ptr_from_view(view(a)) }
    emit_num(arena_chunks_in_use(view(a)) as i64)
    emit_num(arena_chunks_freed(view(a)) as i64)
    0
}

// Struct that owns an `Arena` alongside a companion `ArenaProbe`.
// By SPEC-12 AXS-DROP-002, struct fields drop in declaration order:
// field 0 (`arena`) drops first, freeing its 3 chunks (`chunks_freed = 3`,
// `chunk_count = 0`), then field 1 (`probe`) drops second and observes the
// post-drop state of `arena`.
struct WorkCtx {
    pub arena: Arena,
    pub probe: ArenaProbe,
}

// 2. Allocate from `Arena` owned by a struct and observe implicit drop when
// the struct goes out of scope.
fn run_in_struct() -> i32 {
    let mut ctx = WorkCtx {
        arena: arena_with_chunk_size(64),
        probe: ArenaProbe { arena_ptr: 0 as *const Arena },
    }
    let q1: *mut u8 = arena_alloc_raw(mut_view(ctx.arena), 48, 8)
    let q2: *mut u8 = arena_alloc_raw(mut_view(ctx.arena), 48, 8)
    let q3: *mut u8 = arena_alloc_raw(mut_view(ctx.arena), 48, 8)
    if (q1 as usize) == 0 || (q2 as usize) == 0 || (q3 as usize) == 0 {
        return 2
    }
    unsafe {
        *q1 = 11u8
        *q2 = 22u8
        *q3 = 33u8
        let total: i64 = (*q1 as i64) + (*q2 as i64) + (*q3 as i64)
        emit_num(total)
    }
    ctx.probe.arena_ptr = unsafe { ptr_from_view(view(ctx.arena)) }
    emit_num(arena_chunk_count(view(ctx.arena)) as i64)
    emit_num(arena_chunks_freed(view(ctx.arena)) as i64)
    0
}

// 3. Early-return cleanup after `arena_reset` (SPEC-12 AXS-DROP-001):
// Allocates 3 chunks, resets the arena (freeing 2 chunks, retaining head),
// allocates 2 more blocks (reusing head + 1 new chunk -> 2 live chunks, 2 freed),
// and takes an early `return 0` inside a branch. `a` drops on the early-return
// edge before `probe`, bringing `chunks_freed` to 4 and `chunk_count` to 0.
fn run_early_return(take_early: bool) -> i32 {
    let mut probe = ArenaProbe { arena_ptr: 0 as *const Arena }
    let mut a: Arena = arena_with_chunk_size(64)
    let r1: *mut u8 = arena_alloc_raw(mut_view(a), 48, 8)
    let r2: *mut u8 = arena_alloc_raw(mut_view(a), 48, 8)
    let r3: *mut u8 = arena_alloc_raw(mut_view(a), 48, 8)
    if (r1 as usize) == 0 || (r2 as usize) == 0 || (r3 as usize) == 0 {
        return 3
    }
    arena_reset(mut_view(a))
    let r4: *mut u8 = arena_alloc_raw(mut_view(a), 48, 8)
    let r5: *mut u8 = arena_alloc_raw(mut_view(a), 48, 8)
    if (r4 as usize) == 0 || (r5 as usize) == 0 {
        return 4
    }
    probe.arena_ptr = unsafe { ptr_from_view(view(a)) }
    emit_num(arena_chunk_count(view(a)) as i64)
    emit_num(arena_chunks_freed(view(a)) as i64)
    if take_early {
        return 0
    }
    emit_num(99)
    5
}

// 4. Moving an `Arena` into an owning struct does not double-drop the moved
// local at scope exit (SPEC-12 AXS-DROP-003).
fn run_moved_arena() -> i32 {
    let mut a: Arena = arena_with_chunk_size(64)
    let m1: *mut u8 = arena_alloc_raw(mut_view(a), 48, 8)
    if (m1 as usize) == 0 {
        return 6
    }
    unsafe {
        *m1 = 77u8
        emit_num(*m1 as i64)
    }
    let mut ctx = WorkCtx {
        arena: a,
        probe: ArenaProbe { arena_ptr: 0 as *const Arena },
    }
    ctx.probe.arena_ptr = unsafe { ptr_from_view(view(ctx.arena)) }
    0
}

fn main() -> i32 {
    let r1: i32 = run_in_fn()
    if r1 != 0 {
        return r1
    }
    let r2: i32 = run_in_struct()
    if r2 != 0 {
        return r2
    }
    let r3: i32 = run_early_return(true)
    if r3 != 0 {
        return r3
    }
    let r4: i32 = run_moved_arena()
    if r4 != 0 {
        return r4
    }
    0
}
