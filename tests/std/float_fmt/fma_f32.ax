fn t_fma_f32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 1576 {
        f = f + chkf32(260000 + (i as i32), to_bits_f32(fma_f32(from_bits_f32(FMA_F32[i * 4] as u32), from_bits_f32(FMA_F32[i * 4 + 1] as u32), from_bits_f32(FMA_F32[i * 4 + 2] as u32))) as u64, FMA_F32[i * 4 + 3]);
        i = i + 1;
    }
    f
}

pub fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_fma_f32();
    if f == 0 {
        print("ok float_fmt fma_f32\n");
    }
    f
}
