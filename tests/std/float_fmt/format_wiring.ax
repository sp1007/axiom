// test: run
// modes: interp native
// timeout: 120
// covers: REQ-SIMD-189
// stdout: ok float_fmt format_wiring\n

// T460: std.text.fmt.float is reachable through std.text.fmt.format (format_into_* and the re-exports), the
// special values print canonically, and every float format function appends to an existing String.

module test.float_format_wiring

use std.core.result.Result
use std.text.string.String
use std.text.string.string_new
use std.text.fmt.format.format_into_f64
use std.text.fmt.format.format_into_f32
use std.text.fmt.format.format_into_f64_fixed
use std.text.fmt.format.format_into_f32_fixed
use std.text.fmt.format.format_into_f64_exp
use std.text.fmt.format.format_into_f32_exp
use std.text.fmt.format.format_f64
use std.text.fmt.format.format_f32
use std.text.fmt.format.format_f64_fixed
use std.text.fmt.format.format_f64_exp
use std.text.fmt.format.parse_f64
use std.text.fmt.format.parse_f32
use std.text.fmt.format.ParseFloatError

fn eq(s: view<String>, e: view<[u8]>) -> bool {
    if s.len != len(e) {
        return false;
    }
    let mut i: usize = 0;
    while i < s.len {
        let c = unsafe { *(s.ptr + i) };
        if c != e[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn eq64(x: f64, e: view<[u8]>) -> bool {
    let s = format_f64(x);
    eq(view(s), e)
}

fn eq32(x: f32, e: view<[u8]>) -> bool {
    let s = format_f32(x);
    eq(view(s), e)
}

fn eq64_fixed(x: f64, precision: usize, e: view<[u8]>) -> bool {
    let s = format_f64_fixed(x, precision);
    eq(view(s), e)
}

fn eq64_exp(x: f64, precision: usize, e: view<[u8]>) -> bool {
    let s = format_f64_exp(x, precision);
    eq(view(s), e)
}

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

pub fn main() -> i32 {
    let mut f: i32 = 0;
    // "v=" then 2.5 then ","
    let mut s = string_new();
    let head: [2]u8 = [b'v', b'='];
    let mut k: usize = 0;
    while k < 2 {
        s.push_char(head[k] as char);
        k = k + 1;
    }
    format_into_f64(mut_view(s), 2.5f64);
    format_into_f32(mut_view(s), 0.1f32);
    let want1: [8]u8 = [b'v', b'=', b'2', b'.', b'5', b'0', b'.', b'1'];
    f = f + chk(eq(view(s), view(want1)), 1);

    let mut t = string_new();
    format_into_f64_fixed(mut_view(t), 3.14159f64, 2);
    format_into_f32_fixed(mut_view(t), 2.0f32, 1);
    let want2: [7]u8 = [b'3', b'.', b'1', b'4', b'2', b'.', b'0'];
    f = f + chk(eq(view(t), view(want2)), 2);

    let mut u = string_new();
    format_into_f64_exp(mut_view(u), 12345.678f64, 2);
    format_into_f32_exp(mut_view(u), 0.5f32, 0);
    let want3: [13]u8 = [b'1', b'.', b'2', b'3', b'e', b'+', b'0', b'4', b'5', b'e', b'-', b'0', b'1'];
    f = f + chk(eq(view(u), view(want3)), 3);

    // specials
    let nan_text: [3]u8 = [b'N', b'a', b'N'];
    let inf_text: [3]u8 = [b'i', b'n', b'f'];
    let ninf_text: [4]u8 = [b'-', b'i', b'n', b'f'];
    let zero_text: [3]u8 = [b'0', b'.', b'0'];
    let nzero_text: [4]u8 = [b'-', b'0', b'.', b'0'];
    f = f + chk(eq64(f64.NAN, view(nan_text)), 10);
    f = f + chk(eq64(f64.from_bits(0xFFF8000000000123u64), view(nan_text)), 11);
    f = f + chk(eq32(f32.from_bits(0xFFC00001u32), view(nan_text)), 12);
    f = f + chk(eq64(f64.INFINITY, view(inf_text)), 13);
    f = f + chk(eq64(f64.NEG_INFINITY, view(ninf_text)), 14);
    f = f + chk(eq32(f32.NEG_INFINITY, view(ninf_text)), 15);
    f = f + chk(eq64(0.0f64, view(zero_text)), 16);
    f = f + chk(eq64(f64.from_bits(0x8000000000000000u64), view(nzero_text)), 17);
    f = f + chk(eq32(f32.from_bits(0x80000000u32), view(nzero_text)), 18);
    f = f + chk(eq64_fixed(f64.NAN, 3, view(nan_text)), 19);
    f = f + chk(eq64_exp(f64.INFINITY, 3, view(inf_text)), 20);
    f = f + chk(eq64_fixed(f64.NEG_INFINITY, 0, view(ninf_text)), 21);

    // parse_* through the re-exports
    let one_half: [3]u8 = [b'0', b'.', b'5'];
    let r64 = parse_f64(view(one_half));
    let ok64 = match r64 {
        Result.Ok(x) => x.to_bits() == 0x3FE0000000000000u64,
        Result.Err(_) => false,
    };
    f = f + chk(ok64, 30);
    let r32 = parse_f32(view(one_half));
    let ok32 = match r32 {
        Result.Ok(x) => x.to_bits() == 0x3F000000u32,
        Result.Err(_) => false,
    };
    f = f + chk(ok32, 31);
    let bad: [2]u8 = [b'1', b'x'];
    let rb = parse_f64(view(bad));
    let okb = match rb {
        Result.Ok(_) => false,
        Result.Err(e) => match e {
            ParseFloatError.Empty => false,
            ParseFloatError.InvalidSyntax => true,
        },
    };
    f = f + chk(okb, 32);
    if f == 0 {
        print("ok float_fmt format_wiring\n");
    }
    f
}
