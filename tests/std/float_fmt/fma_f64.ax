fn t_fma_f64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 1576 {
        f = f + chkf64(120000 + (i as i32), to_bits_f64(fma_f64(from_bits_f64(FMA_F64[i * 4]), from_bits_f64(FMA_F64[i * 4 + 1]), from_bits_f64(FMA_F64[i * 4 + 2]))), FMA_F64[i * 4 + 3]);
        i = i + 1;
    }
    f
}

pub fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_fma_f64();
    if f == 0 {
        print("ok float_fmt fma_f64\n");
    }
    f
}
