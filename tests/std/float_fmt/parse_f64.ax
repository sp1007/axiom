fn show_failure(kind: i32, index: usize) {
    print("FAIL ");
    print_int(kind as i64);
    print(" #");
    print_int(index as i64);
    print("\n");
}

pub fn main() -> i32 {
    let mut failures: i32 = 0;
    let mut i: usize = 0;
    while i < 895 {
        let n = LEN[i] as usize;
        let start = START[i] as usize;
        let mut got: Result<f64, ParseFloatError> = Result.Err(ParseFloatError.Empty);
        if n == 0 {
            got = unsafe { parse_f64_raw(address_of(TEXT[0]), 0) };
        } else {
            got = unsafe { parse_f64_raw(address_of(TEXT[start]), n) };
        }
        let status = STATUS[i];
        match got {
            Result.Ok(x) => {
                if status == 3u32 {
                    if !x.is_nan() {
                        show_failure(1, i);
                        failures = failures + 1;
                    }
                } else if status != 0u32 {
                    show_failure(2, i);
                    failures = failures + 1;
                } else if x.to_bits() != WANT[i] {
                    show_failure(3, i);
                    failures = failures + 1;
                }
            },
            Result.Err(e) => {
                let code: u32 = match e {
                    ParseFloatError.Empty => 1u32,
                    ParseFloatError.InvalidSyntax => 2u32,
                };
                if code != status {
                    show_failure(4, i);
                    failures = failures + 1;
                }
            },
        }
        i = i + 1;
    }

    if failures == 0 {
        print("ok float_fmt parse_f64\n");
    }
    failures
}
