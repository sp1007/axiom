fn t_min_f64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 484 {
        f = f + chkf64(100000 + (i as i32), to_bits_f64(min_f64(from_bits_f64(MIN_F64[i * 3]), from_bits_f64(MIN_F64[i * 3 + 1]))), MIN_F64[i * 3 + 2]);
        i = i + 1;
    }
    f
}

