// test: run
// modes: interp native
// timeout: 600
// covers: REQ-SIMD-160, REQ-SIMD-272, REQ-SIMD-322
// stdout: ok float_fmt derived_f64\n


// T460: the vectors of the ten derived float operations (ADR-0049 section 4), run over the library functions
// of std.core.float. Promoted from the former helper tests/mir/float_interp/intrinsics.ax. Every result is
// compared bit for bit; a NaN result matches any NaN (SPEC-41 AXS-FLT-002).

module test.float_derived_f64

use std.core.float.FpCategory

fn to_bits_f64(x: f64) -> u64 { x.to_bits() }
fn from_bits_f64(v: u64) -> f64 { f64.from_bits(v) }
fn floor_f64(x: f64) -> f64 { x.floor() }
fn ceil_f64(x: f64) -> f64 { x.ceil() }
fn trunc_f64(x: f64) -> f64 { x.trunc() }
fn round_f64(x: f64) -> f64 { x.round() }
fn round_ties_even_f64(x: f64) -> f64 { x.round_ties_even() }
fn next_up_f64(x: f64) -> f64 { x.next_up() }
fn next_down_f64(x: f64) -> f64 { x.next_down() }
fn min_f64(x: f64, y: f64) -> f64 { x.min(y) }
fn max_f64(x: f64, y: f64) -> f64 { x.max(y) }
fn fma_f64(x: f64, y: f64, z: f64) -> f64 { x.mul_add(y, z) }

fn chk(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got ");
    print_int(got as i64);
    print(" want ");
    print_int(want as i64);
    print("\n");
    1
}

// A fresh NaN is equal to any NaN: the sign and payload of an arithmetic NaN are not observable (SPEC-41 AXS-FLT-002).
fn chkf64(id: i32, got: u64, want: u64) -> i32 {
    if (got & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 && (want & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 {
        return 0;
    }
    chk(id, got, want)
}

fn chkf32(id: i32, got: u64, want: u64) -> i32 {
    if (got & 0x7FFFFFFFu64) > 0x7F800000u64 && (want & 0x7FFFFFFFu64) > 0x7F800000u64 {
        return 0;
    }
    chk(id, got, want)
}

