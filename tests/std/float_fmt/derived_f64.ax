    0x4340000000000000u64, 0x7FF0000000000001u64, 0x4340000000000000u64, 0x4340000000000000u64, 0xFFF8000000000000u64, 0x4340000000000000u64,
    0x4340000000000000u64, 0x3FD5555555555555u64, 0x4340000000000000u64, 0x4340000000000000u64, 0x3FB999999999999Au64, 0x4340000000000000u64,
    0x4340000000000000u64, 0x400921FB54442D18u64, 0x4340000000000000u64, 0x4340000000000000u64, 0x4340000000000000u64, 0x4340000000000000u64,
];

fn t_max_f64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 484 {
        f = f + chkf64(110000 + (i as i32), to_bits_f64(max_f64(from_bits_f64(MAX_F64[i * 3]), from_bits_f64(MAX_F64[i * 3 + 1]))), MAX_F64[i * 3 + 2]);
        i = i + 1;
    }
    f
}

pub fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_floor_f64();
    f = f + t_ceil_f64();
    f = f + t_trunc_f64();
    f = f + t_round_f64();
    f = f + t_round_ties_even_f64();
    f = f + t_next_up_f64();
    f = f + t_next_down_f64();
    f = f + t_min_f64();
    f = f + t_max_f64();
    if f == 0 {
        print("ok float_fmt derived_f64\n");
    }
    f
}
