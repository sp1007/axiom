fn show_failure(kind: i32, index: usize) {
    print("FAIL ");
    print_int(kind as i64);
    print(" #");
    print_int(index as i64);
    print("\n");
}

// true when `s` holds exactly TEXT[start .. start + n]
fn same_text(s: view<String>, start: usize, n: usize) -> bool {
    if s.len != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let c = unsafe { *(s.ptr + i) };
        if c != TEXT[start + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn main() -> i32 {
    let mut failures: i32 = 0;
    let mut i: usize = 0;
    while i < 150 {
        let x = f32.from_bits(BITS[i]);
        let s = format_f32(x);
        if !same_text(view(s), START[i] as usize, LEN[i] as usize) {
            show_failure(1, i);
            failures = failures + 1;
        }
        let back = unsafe { parse_f32_raw(s.ptr as *const u8, s.len) };
        match back {
            Result.Ok(y) => {
                if y.to_bits() != BITS[i] {
                    show_failure(2, i);
                    failures = failures + 1;
                }
            },
            Result.Err(_) => {
                show_failure(3, i);
                failures = failures + 1;
            },
        }
        i = i + 1;
    }

    if failures == 0 {
        print("ok float_fmt fmt_shortest_f32\n");
    }
    failures
}
