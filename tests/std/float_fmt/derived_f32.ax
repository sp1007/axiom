fn t_max_f32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 484 {
        f = f + chkf32(250000 + (i as i32), to_bits_f32(max_f32(from_bits_f32(MAX_F32[i * 3] as u32), from_bits_f32(MAX_F32[i * 3 + 1] as u32))) as u64, MAX_F32[i * 3 + 2]);
        i = i + 1;
    }
    f
}

pub fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_floor_f32();
    f = f + t_ceil_f32();
    f = f + t_trunc_f32();
    f = f + t_round_f32();
    f = f + t_round_ties_even_f32();
    f = f + t_next_up_f32();
    f = f + t_next_down_f32();
    f = f + t_min_f32();
    f = f + t_max_f32();
    if f == 0 {
        print("ok float_fmt derived_f32\n");
    }
    f
}
