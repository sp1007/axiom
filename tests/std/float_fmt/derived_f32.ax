fn t_floor_f32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 82 {
        f = f + chkf32(160000 + (i as i32), to_bits_f32(floor_f32(from_bits_f32(FLOOR_F32[i * 2] as u32))) as u64, FLOOR_F32[i * 2 + 1]);
        i = i + 1;
    }
    f
}

