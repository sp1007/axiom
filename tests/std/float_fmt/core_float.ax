// test: run
// modes: interp native
// timeout: 120
// covers: REQ-SIMD-160, REQ-SIMD-272, REQ-SIMD-322, REQ-SIMD-186, REQ-SIMD-187
// stdout: ok float_fmt core_float\n

// T460: std.core.float for f32 and f64 (SPEC-41 AXS-FLT-004, 015, 016, 021, 026, 062): associated constants,
// classification, total_cmp, min/max/clamp, rounding, neighbours, mul_add with a single rounding, wrappers.
// Every result is compared bit for bit.

module test.float_core_float

use std.core.float.FpCategory
use std.core.cmp.Ordering

fn chk(ok: bool, id: i32) -> i32 {
    if ok {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print("\n");
    1
}

fn ord(o: Ordering) -> i32 {
    match o {
        Ordering.Less => -1,
        Ordering.Equal => 0,
        Ordering.Greater => 1,
    }
}

fn cat(c: FpCategory) -> i32 {
    match c {
        FpCategory.Nan => 0,
        FpCategory.Infinite => 1,
        FpCategory.Zero => 2,
        FpCategory.Subnormal => 3,
        FpCategory.Normal => 4,
    }
}

fn b64(x: f64) -> u64 {
    x.to_bits()
}

fn b32(x: f32) -> u32 {
    x.to_bits()
}

fn t_consts_f64() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(f64.INFINITY.to_bits() == 0x7FF0000000000000u64, 1);
    f = f + chk(f64.NEG_INFINITY.to_bits() == 0xFFF0000000000000u64, 2);
    f = f + chk(f64.NAN.to_bits() == 0x7FF8000000000000u64, 3);
    f = f + chk(f64.EPSILON.to_bits() == 0x3CB0000000000000u64, 4);
    f = f + chk(f64.MIN.to_bits() == 0xFFEFFFFFFFFFFFFFu64, 5);
    f = f + chk(f64.MAX.to_bits() == 0x7FEFFFFFFFFFFFFFu64, 6);
    f = f + chk(f64.MIN_POSITIVE.to_bits() == 0x0010000000000000u64, 7);
    f = f + chk(f64.MIN_POSITIVE_SUBNORMAL.to_bits() == 1u64, 8);
    f = f + chk(f64.MANTISSA_DIGITS == 53u32, 9);
    f = f + chk(f64.DIGITS == 15u32, 10);
    f = f + chk(f64.RADIX == 2u32, 11);
    f = f + chk(f64.MIN_EXP == -1021, 12);
    f = f + chk(f64.MAX_EXP == 1024, 13);
    f = f + chk(f64.MIN_10_EXP == -307, 14);
    f = f + chk(f64.MAX_10_EXP == 308, 15);
    f
}

fn t_consts_f32() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(f32.INFINITY.to_bits() == 0x7F800000u32, 21);
    f = f + chk(f32.NEG_INFINITY.to_bits() == 0xFF800000u32, 22);
    f = f + chk(f32.NAN.to_bits() == 0x7FC00000u32, 23);
    f = f + chk(f32.EPSILON.to_bits() == 0x34000000u32, 24);
    f = f + chk(f32.MIN.to_bits() == 0xFF7FFFFFu32, 25);
    f = f + chk(f32.MAX.to_bits() == 0x7F7FFFFFu32, 26);
    f = f + chk(f32.MIN_POSITIVE.to_bits() == 0x00800000u32, 27);
    f = f + chk(f32.MIN_POSITIVE_SUBNORMAL.to_bits() == 1u32, 28);
    f = f + chk(f32.MANTISSA_DIGITS == 24u32, 29);
    f = f + chk(f32.DIGITS == 6u32, 30);
    f = f + chk(f32.RADIX == 2u32, 31);
    f = f + chk(f32.MIN_EXP == -125, 32);
    f = f + chk(f32.MAX_EXP == 128, 33);
    f = f + chk(f32.MIN_10_EXP == -37, 34);
    f = f + chk(f32.MAX_10_EXP == 38, 35);
    f
}

fn t_classify_f64() -> i32 {
    let mut f: i32 = 0;
    // Nan, Infinite, Zero, Subnormal, Normal
    f = f + chk(cat(f64.from_bits(0x7FF8000000000000u64).classify()) == 0, 100);
    f = f + chk(cat(f64.from_bits(0x7FF0000000000001u64).classify()) == 0, 101);
    f = f + chk(cat(f64.from_bits(0xFFFFFFFFFFFFFFFFu64).classify()) == 0, 102);
    f = f + chk(cat(f64.INFINITY.classify()) == 1, 103);
    f = f + chk(cat(f64.NEG_INFINITY.classify()) == 1, 104);
    f = f + chk(cat((0.0f64).classify()) == 2, 105);
    f = f + chk(cat(f64.from_bits(0x8000000000000000u64).classify()) == 2, 106);
    f = f + chk(cat(f64.from_bits(1u64).classify()) == 3, 107);
    f = f + chk(cat(f64.from_bits(0x000FFFFFFFFFFFFFu64).classify()) == 3, 108);
    f = f + chk(cat(f64.from_bits(0x800FFFFFFFFFFFFFu64).classify()) == 3, 109);
    f = f + chk(cat(f64.MIN_POSITIVE.classify()) == 4, 110);
    f = f + chk(cat(f64.MAX.classify()) == 4, 111);
    f = f + chk(cat((1.0f64).classify()) == 4, 112);
    f = f + chk(cat((-3.5f64).classify()) == 4, 113);
    // predicates
    let nan = f64.NAN;
    let sub = f64.from_bits(5u64);
    f = f + chk(nan.is_nan() && !nan.is_infinite() && !nan.is_finite() && !nan.is_normal() && !nan.is_subnormal(), 120);
    f = f + chk(f64.INFINITY.is_infinite() && !f64.INFINITY.is_nan() && !f64.INFINITY.is_finite(), 121);
    f = f + chk(f64.NEG_INFINITY.is_infinite() && f64.NEG_INFINITY.is_sign_negative(), 122);
    f = f + chk(sub.is_subnormal() && sub.is_finite() && !sub.is_normal() && !sub.is_nan(), 123);
    f = f + chk((1.5f64).is_normal() && (1.5f64).is_finite() && !(1.5f64).is_subnormal(), 124);
    f = f + chk((0.0f64).is_finite() && !(0.0f64).is_normal() && !(0.0f64).is_subnormal(), 125);
    f = f + chk((0.0f64).is_sign_positive() && !(0.0f64).is_sign_negative(), 126);
    f = f + chk(f64.from_bits(0x8000000000000000u64).is_sign_negative(), 127);
    f = f + chk(f64.from_bits(0xFFF8000000000000u64).is_sign_negative() && f64.from_bits(0xFFF8000000000000u64).is_nan(), 128);
    f = f + chk(f64.from_bits(0x7FF8000000000000u64).is_sign_positive(), 129);
    f
}

fn t_classify_f32() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(cat(f32.from_bits(0x7FC00000u32).classify()) == 0, 140);
    f = f + chk(cat(f32.from_bits(0x7F800001u32).classify()) == 0, 141);
    f = f + chk(cat(f32.INFINITY.classify()) == 1, 142);
    f = f + chk(cat(f32.NEG_INFINITY.classify()) == 1, 143);
    f = f + chk(cat((0.0f32).classify()) == 2, 144);
    f = f + chk(cat(f32.from_bits(0x80000000u32).classify()) == 2, 145);
    f = f + chk(cat(f32.from_bits(1u32).classify()) == 3, 146);
    f = f + chk(cat(f32.from_bits(0x007FFFFFu32).classify()) == 3, 147);
    f = f + chk(cat(f32.MIN_POSITIVE.classify()) == 4, 148);
    f = f + chk(cat(f32.MAX.classify()) == 4, 149);
    f = f + chk(f32.NAN.is_nan() && !f32.NAN.is_finite(), 150);
    f = f + chk(f32.INFINITY.is_infinite() && f32.INFINITY.is_sign_positive(), 151);
    f = f + chk(f32.from_bits(3u32).is_subnormal() && f32.from_bits(3u32).is_finite(), 152);
    f = f + chk((2.5f32).is_normal(), 153);
    f = f + chk(f32.from_bits(0x80000000u32).is_sign_negative() && (0.0f32).is_sign_positive(), 154);
    f = f + chk(f32.from_bits(0xFFC00000u32).is_sign_negative() && f32.from_bits(0xFFC00000u32).is_nan(), 155);
    f
}

fn t_total_cmp() -> i32 {
    let mut f: i32 = 0;
    // -qNaN < -sNaN < -inf < -1 < -subnormal < -0 < +0 < subnormal < 1 < +inf < +sNaN < +qNaN
    let mut v: [11]u64 = [0u64; 11];
    v[0] = 0xFFF8000000000000u64;
    v[1] = 0xFFF0000000000001u64;
    v[2] = 0xFFF0000000000000u64;
    v[3] = 0xBFF0000000000000u64;
    v[4] = 0x8000000000000001u64;
    v[5] = 0x8000000000000000u64;
    v[6] = 0x0000000000000000u64;
    v[7] = 0x0000000000000001u64;
    v[8] = 0x3FF0000000000000u64;
    v[9] = 0x7FF0000000000000u64;
    v[10] = 0x7FF8000000000000u64;
    let mut i: usize = 0;
    while i < 11 {
        let mut j: usize = 0;
        while j < 11 {
            let want = if i < j { -1 } else if i > j { 1 } else { 0 };
            let got = ord(f64.from_bits(v[i]).total_cmp(f64.from_bits(v[j])));
            f = f + chk(got == want, 200 + (i as i32) * 11 + (j as i32));
            j = j + 1;
        }
        i = i + 1;
    }
    f = f + chk(ord(f64.from_bits(0x7FF0000000000001u64).total_cmp(f64.from_bits(0x7FF8000000000000u64))) == -1, 330);
    f = f + chk(ord(f64.from_bits(0x7FF8000000000002u64).total_cmp(f64.from_bits(0x7FF8000000000001u64))) == 1, 331);
    // f32
    let mut w: [11]u32 = [0u32; 11];
    w[0] = 0xFFC00000u32;
    w[1] = 0xFF800001u32;
    w[2] = 0xFF800000u32;
    w[3] = 0xBF800000u32;
    w[4] = 0x80000001u32;
    w[5] = 0x80000000u32;
    w[6] = 0x00000000u32;
    w[7] = 0x00000001u32;
    w[8] = 0x3F800000u32;
    w[9] = 0x7F800000u32;
    w[10] = 0x7FC00000u32;
    let mut a: usize = 0;
    while a < 11 {
        let mut c: usize = 0;
        while c < 11 {
            let want = if a < c { -1 } else if a > c { 1 } else { 0 };
            let got = ord(f32.from_bits(w[a]).total_cmp(f32.from_bits(w[c])));
            f = f + chk(got == want, 400 + (a as i32) * 11 + (c as i32));
            c = c + 1;
        }
        a = a + 1;
    }
    f
}

fn t_min_max_clamp() -> i32 {
    let mut f: i32 = 0;
    let pz = 0.0f64;
    let nz = f64.from_bits(0x8000000000000000u64);
    f = f + chk(b64(nz.min(pz)) == 0x8000000000000000u64, 500);
    f = f + chk(b64(pz.min(nz)) == 0x8000000000000000u64, 501);
    f = f + chk(b64(nz.max(pz)) == 0u64, 502);
    f = f + chk(b64(pz.max(nz)) == 0u64, 503);
    f = f + chk(b64((1.0f64).min(f64.NAN)) == b64(1.0f64), 504);
    f = f + chk(b64(f64.NAN.min(1.0f64)) == b64(1.0f64), 505);
    f = f + chk(b64((2.0f64).max(f64.NAN)) == b64(2.0f64), 506);
    f = f + chk(b64(f64.NAN.max(2.0f64)) == b64(2.0f64), 507);
    f = f + chk(f64.NAN.min(f64.NAN).is_nan() && f64.NAN.max(f64.NAN).is_nan(), 508);
    f = f + chk(b64((3.0f64).min(4.0f64)) == b64(3.0f64) && b64((3.0f64).max(4.0f64)) == b64(4.0f64), 509);
    f = f + chk(b64((-1.0f64).min(f64.NEG_INFINITY)) == b64(f64.NEG_INFINITY), 510);
    // clamp
    f = f + chk(b64((5.0f64).clamp(0.0, 3.0)) == b64(3.0f64), 520);
    f = f + chk(b64((-5.0f64).clamp(0.0, 3.0)) == b64(0.0f64), 521);
    f = f + chk(b64((2.0f64).clamp(0.0, 3.0)) == b64(2.0f64), 522);
    f = f + chk(f64.NAN.clamp(0.0, 3.0).is_nan(), 523);
    f = f + chk(b64(nz.clamp(0.0, 1.0)) == 0x8000000000000000u64, 524);
    f = f + chk(b64((1.0f64).clamp(1.0, 1.0)) == b64(1.0f64), 525);
    // f32
    let pz32 = 0.0f32;
    let nz32 = f32.from_bits(0x80000000u32);
    f = f + chk(b32(nz32.min(pz32)) == 0x80000000u32 && b32(pz32.min(nz32)) == 0x80000000u32, 530);
    f = f + chk(b32(nz32.max(pz32)) == 0u32 && b32(pz32.max(nz32)) == 0u32, 531);
    f = f + chk(b32((1.0f32).min(f32.NAN)) == b32(1.0f32) && b32(f32.NAN.max(7.0f32)) == b32(7.0f32), 532);
    f = f + chk(b32((9.0f32).clamp(1.0, 4.0)) == b32(4.0f32) && b32((0.5f32).clamp(1.0, 4.0)) == b32(1.0f32), 533);
    f = f + chk(f32.NAN.clamp(1.0, 4.0).is_nan(), 534);
    f
}

fn t_rounding() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(b64((2.5f64).round()) == b64(3.0f64), 600);
    f = f + chk(b64((-2.5f64).round()) == b64(-3.0f64), 601);
    f = f + chk(b64((2.5f64).round_ties_even()) == b64(2.0f64), 602);
    f = f + chk(b64((3.5f64).round_ties_even()) == b64(4.0f64), 603);
    f = f + chk(b64((-2.5f64).round_ties_even()) == b64(-2.0f64), 604);
    f = f + chk(b64((-0.4f64).round()) == 0x8000000000000000u64, 605);
    f = f + chk(b64((-0.5f64).floor()) == b64(-1.0f64), 606);
    f = f + chk(b64((-0.0f64).floor()) == 0x8000000000000000u64, 607);
    f = f + chk(b64((-0.5f64).ceil()) == 0x8000000000000000u64, 608);
    f = f + chk(b64((-0.5f64).trunc()) == 0x8000000000000000u64, 609);
    f = f + chk(b64((1.9f64).trunc()) == b64(1.0f64) && b64((-1.9f64).trunc()) == b64(-1.0f64), 610);
    f = f + chk(b64((1.1f64).ceil()) == b64(2.0f64) && b64((-1.1f64).floor()) == b64(-2.0f64), 611);
    f = f + chk(b64(f64.INFINITY.floor()) == b64(f64.INFINITY) && f64.NAN.ceil().is_nan(), 612);
    f = f + chk(b64((4503599627370497.0f64).round()) == b64(4503599627370497.0f64), 613);
    f = f + chk(b64((0.49999999999999994f64).round()) == 0u64, 614);
    f = f + chk(b64((1.5f64).fract()) == b64(0.5f64) && b64((-1.5f64).fract()) == b64(-0.5f64), 615);
    f = f + chk(f64.INFINITY.fract().is_nan() && f64.NAN.fract().is_nan(), 616);
    f = f + chk(b64((100.0f64).fract()) == 0u64, 617);
    // f32
    f = f + chk(b32((2.5f32).round()) == b32(3.0f32) && b32((2.5f32).round_ties_even()) == b32(2.0f32), 620);
    f = f + chk(b32((-0.4f32).round()) == 0x80000000u32 && b32((-0.5f32).floor()) == b32(-1.0f32), 621);
    f = f + chk(b32((-0.5f32).ceil()) == 0x80000000u32 && b32((7.9f32).trunc()) == b32(7.0f32), 622);
    f = f + chk(b32((8388609.0f32).floor()) == b32(8388609.0f32), 623);
    f = f + chk(b32((1.25f32).fract()) == b32(0.25f32), 624);
    f
}

fn t_neighbours() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(b64((0.0f64).next_up()) == 1u64 && b64(f64.from_bits(0x8000000000000000u64).next_up()) == 1u64, 700);
    f = f + chk(b64((0.0f64).next_down()) == 0x8000000000000001u64, 701);
    f = f + chk(b64(f64.NEG_INFINITY.next_up()) == b64(f64.MIN), 702);
    f = f + chk(b64(f64.MAX.next_up()) == b64(f64.INFINITY) && b64(f64.INFINITY.next_up()) == b64(f64.INFINITY), 703);
    f = f + chk(b64(f64.INFINITY.next_down()) == b64(f64.MAX), 704);
    f = f + chk(b64(f64.MIN.next_down()) == b64(f64.NEG_INFINITY), 705);
    f = f + chk(f64.NAN.next_up().is_nan() && f64.NAN.next_down().is_nan(), 706);
    f = f + chk(b64((1.0f64).next_up()) == 0x3FF0000000000001u64 && b64((1.0f64).next_down()) == 0x3FEFFFFFFFFFFFFFu64, 707);
    f = f + chk(b64((-1.0f64).next_up()) == 0xBFEFFFFFFFFFFFFFu64 && b64((-1.0f64).next_down()) == 0xBFF0000000000001u64, 708);
    f = f + chk(b32((0.0f32).next_up()) == 1u32 && b32((0.0f32).next_down()) == 0x80000001u32, 710);
    f = f + chk(b32(f32.MAX.next_up()) == b32(f32.INFINITY) && b32(f32.MIN.next_down()) == b32(f32.NEG_INFINITY), 711);
    f = f + chk(b32((1.0f32).next_up()) == 0x3F800001u32 && b32((1.0f32).next_down()) == 0x3F7FFFFFu32, 712);
    f
}

fn t_mul_add() -> i32 {
    let mut f: i32 = 0;
    // a * b rounds to 1.0, so the separate multiply and add lose the whole result; mul_add keeps it (REQ-SIMD-272).
    let a = f64.from_bits(0x3FF0000002000000u64);
    let b = f64.from_bits(0x3FEFFFFFFC000000u64);
    let plain = a * b + (-1.0f64);
    let fused = a.mul_add(b, -1.0f64);
    f = f + chk(b64(plain) == 0u64, 800);
    f = f + chk(b64(fused) == 0xBC90000000000000u64, 801);
    f = f + chk(b64(plain) != b64(fused), 802);
    let a32 = f32.from_bits(0x3F800400u32);
    let b32v = f32.from_bits(0x3F7FF800u32);
    let plain32 = a32 * b32v + (-1.0f32);
    let fused32 = a32.mul_add(b32v, -1.0f32);
    f = f + chk(b32(plain32) == 0u32, 803);
    f = f + chk(b32(fused32) == 0xB2800000u32, 804);
    // overflow in the product only: the exact sum is finite
    f = f + chk(b64(f64.MAX.mul_add(2.0, -f64.MAX)) == b64(f64.MAX), 805);
    f = f + chk(b64((f64.MAX * 2.0) + (-f64.MAX)) == b64(f64.INFINITY), 806);
    // underflow: the exact result is below the smallest subnormal
    f = f + chk(b64(f64.MIN_POSITIVE_SUBNORMAL.mul_add(0.25, 0.0)) == 0u64, 807);
    f = f + chk(b64(f64.MIN_POSITIVE_SUBNORMAL.mul_add(0.75, 0.0)) == 1u64, 808);
    f = f + chk(b64(f64.MIN_POSITIVE_SUBNORMAL.mul_add(0.5, 0.0)) == 0u64, 809);
    f = f + chk(b64(f64.MIN_POSITIVE_SUBNORMAL.mul_add(-0.25, 0.0)) == 0x8000000000000000u64, 810);
    // exact cancellation gives +0, special operands follow IEEE-754
    f = f + chk(b64((3.0f64).mul_add(2.0, -6.0)) == 0u64, 811);
    f = f + chk((0.0f64).mul_add(f64.INFINITY, 1.0).is_nan(), 812);
    f = f + chk(b64((2.0f64).mul_add(f64.INFINITY, 1.0)) == b64(f64.INFINITY), 813);
    f = f + chk(b64((2.0f64).mul_add(3.0, f64.NEG_INFINITY)) == b64(f64.NEG_INFINITY), 814);
    f = f + chk(f64.NAN.mul_add(1.0, 1.0).is_nan() && (1.0f64).mul_add(1.0, f64.NAN).is_nan(), 815);
    f = f + chk(b64(f64.from_bits(0x8000000000000000u64).mul_add(1.0, 0.0)) == 0u64, 816);
    f = f + chk(b64((1.5f64).mul_add(2.0, 0.25)) == b64(3.25f64), 817);
    f
}

fn t_wrappers() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(b64((2.0f64).sqrt()) == 0x3FF6A09E667F3BCDu64, 900);
    f = f + chk(b64((-4.0f64).sqrt()) == b64(f64.NAN) || (-4.0f64).sqrt().is_nan(), 901);
    f = f + chk(b64(f64.from_bits(0x8000000000000000u64).sqrt()) == 0x8000000000000000u64, 902);
    f = f + chk(b64((-0.0f64).abs()) == 0u64 && b64((-3.5f64).abs()) == b64(3.5f64), 903);
    f = f + chk(b64((3.0f64).copysign(-0.0)) == b64(-3.0f64) && b64((-3.0f64).copysign(1.0)) == b64(3.0f64), 904);
    f = f + chk(b32((2.0f32).sqrt()) == 0x3FB504F3u32 && b32((-2.5f32).abs()) == b32(2.5f32), 905);
    f = f + chk(b32((1.0f32).copysign(-5.0)) == b32(-1.0f32), 906);
    // angles
    f = f + chk(b64((3.141592653589793f64).to_degrees()) == b64(180.0f64), 910);
    f = f + chk(b64((180.0f64).to_radians()) == b64(3.141592653589793f64), 911);
    f = f + chk(b32((180.0f32).to_radians()) == b32(3.1415927f32), 912);
    f = f + chk(b32((3.1415927f32).to_degrees()) == b32(180.0f32), 913);
    f = f + chk(b64((90.0f64).to_radians()) == b64(1.5707963267948966f64), 914);
    // f64.from_bits / to_bits round trip of a signalling NaN keeps the payload
    f = f + chk(b64(f64.from_bits(0x7FF0000000000001u64)) == 0x7FF0000000000001u64, 920);
    f = f + chk(b32(f32.from_bits(0x7F800001u32)) == 0x7F800001u32, 921);
    f
}

fn t_bytes() -> i32 {
    let mut f: i32 = 0;
    let one = (1.0f64).to_le_bytes();
    f = f + chk(one[0] == 0u8 && one[5] == 0u8 && one[6] == 0xF0u8 && one[7] == 0x3Fu8, 950);
    let be = (1.0f64).to_be_bytes();
    f = f + chk(be[0] == 0x3Fu8 && be[1] == 0xF0u8 && be[7] == 0u8, 951);
    let ne = (-2.0f64).to_ne_bytes();
    f = f + chk(ne[7] == 0xC0u8 && ne[6] == 0u8, 952);
    f = f + chk(b64(f64.from_le_bytes(one)) == b64(1.0f64), 953);
    f = f + chk(b64(f64.from_be_bytes(be)) == b64(1.0f64), 954);
    f = f + chk(b64(f64.from_ne_bytes(ne)) == b64(-2.0f64), 955);
    let snan = f64.from_bits(0x7FF0000000000001u64).to_le_bytes();
    f = f + chk(snan[0] == 1u8 && snan[7] == 0x7Fu8 && b64(f64.from_le_bytes(snan)) == 0x7FF0000000000001u64, 956);
    let h = (1.5f32).to_le_bytes();
    f = f + chk(h[0] == 0u8 && h[1] == 0u8 && h[2] == 0xC0u8 && h[3] == 0x3Fu8, 960);
    let hb = (1.5f32).to_be_bytes();
    f = f + chk(hb[0] == 0x3Fu8 && hb[1] == 0xC0u8 && hb[3] == 0u8, 961);
    f = f + chk(b32(f32.from_le_bytes(h)) == b32(1.5f32) && b32(f32.from_be_bytes(hb)) == b32(1.5f32), 962);
    f = f + chk(b32(f32.from_ne_bytes((-0.0f32).to_ne_bytes())) == 0x80000000u32, 963);
    f
}

pub fn main() -> i32 {
    let mut failures: i32 = 0;
    failures = failures + t_bytes();
    failures = failures + t_consts_f64();
    failures = failures + t_consts_f32();
    failures = failures + t_classify_f64();
    failures = failures + t_classify_f32();
    failures = failures + t_total_cmp();
    failures = failures + t_min_max_clamp();
    failures = failures + t_rounding();
    failures = failures + t_neighbours();
    failures = failures + t_mul_add();
    failures = failures + t_wrappers();
    if failures == 0 {
        print("ok float_fmt core_float\n");
    }
    failures
}
