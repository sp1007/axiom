// test: run
// modes: interp native
// covers: REQ-SIMD-160
// exit: 101
// stdout: before\n
// stderr: panic: explicit panic\n

// T460: clamp with min_val > max_val panics (SPEC-41 AXS-FLT-016 item 3).

module test.float_clamp_panic

use std.core.float.FpCategory

pub fn main() -> i32 {
    print("before\n");
    let lo = 2.0f64;
    let hi = 1.0f64;
    let x = (1.5f64).clamp(lo, hi);
    print("not reached\n");
    if x > 0.0 {
        return 1;
    }
    0
}
