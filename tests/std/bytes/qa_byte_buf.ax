// test: run
// stdout: OK ByteBuf\n

use std.core.option.Option
use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub enum ByteBufError {
    OutOfBounds,
}

pub struct ByteBuf {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl Drop for ByteBuf {
    fn drop(self: mut_view<ByteBuf>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn byte_buf_new() -> ByteBuf {
    ByteBuf {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn byte_buf_with_capacity(capacity: usize) -> ByteBuf {
    if capacity == 0 {
        return byte_buf_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    ByteBuf {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
        _glue: DropGlue {},
    }
}

pub fn byte_buf_len(b: view<ByteBuf>) -> usize {
    b.len
}

pub fn byte_buf_capacity(b: view<ByteBuf>) -> usize {
    b.cap
}

pub fn byte_buf_is_empty(b: view<ByteBuf>) -> bool {
    b.len == 0
}

pub fn byte_buf_clear(b: mut_view<ByteBuf>) {
    b.len = 0;
}

pub fn byte_buf_reserve(b: mut_view<ByteBuf>, additional: usize) {
    let needed = b.len + additional;
    if needed <= b.cap {
        return;
    }
    let mut new_cap = if b.cap == 0 { 16 } else { b.cap * 2 };
    if new_cap < needed {
        new_cap = needed;
    }
    let raw = unsafe { heap_alloc(new_cap, 8) };
    let new_ptr = raw as *mut u8;
    if b.len > 0 && b.ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, new_ptr, b.len);
            heap_free(b.ptr, b.cap, 8);
        }
    }
    b.ptr = new_ptr;
    b.cap = new_cap;
}

pub fn byte_buf_put_u8(b: mut_view<ByteBuf>, val: u8) {
    if b.len == b.cap {
        byte_buf_reserve(mut_view(*b), 1);
    }
    unsafe {
        *(b.ptr + b.len) = val;
    }
    b.len = b.len + 1;
}

pub fn byte_buf_put_u16(b: mut_view<ByteBuf>, val: u16) {
    if b.len + 2 > b.cap {
        byte_buf_reserve(mut_view(*b), 2);
    }
    unsafe {
        let p = b.ptr + b.len;
        *p = (val & 0xFFu16) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu16) as u8;
    }
    b.len = b.len + 2;
}

pub fn byte_buf_put_u32(b: mut_view<ByteBuf>, val: u32) {
    if b.len + 4 > b.cap {
        byte_buf_reserve(mut_view(*b), 4);
    }
    unsafe {
        let p = b.ptr + b.len;
        *p = (val & 0xFFu32) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu32) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu32) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu32) as u8;
    }
    b.len = b.len + 4;
}

pub fn byte_buf_put_u64(b: mut_view<ByteBuf>, val: u64) {
    if b.len + 8 > b.cap {
        byte_buf_reserve(mut_view(*b), 8);
    }
    unsafe {
        let p = b.ptr + b.len;
        *p = (val & 0xFFu64) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu64) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu64) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu64) as u8;
        *(p + 4) = ((val >> 32) & 0xFFu64) as u8;
        *(p + 5) = ((val >> 40) & 0xFFu64) as u8;
        *(p + 6) = ((val >> 48) & 0xFFu64) as u8;
        *(p + 7) = ((val >> 56) & 0xFFu64) as u8;
    }
    b.len = b.len + 8;
}

pub fn byte_buf_put_i8(b: mut_view<ByteBuf>, val: i8) {
    byte_buf_put_u8(b, val as u8);
}

pub fn byte_buf_put_i16(b: mut_view<ByteBuf>, val: i16) {
    byte_buf_put_u16(b, val as u16);
}

pub fn byte_buf_put_i32(b: mut_view<ByteBuf>, val: i32) {
    byte_buf_put_u32(b, val as u32);
}

pub fn byte_buf_put_i64(b: mut_view<ByteBuf>, val: i64) {
    byte_buf_put_u64(b, val as u64);
}

pub fn byte_buf_put_usize(b: mut_view<ByteBuf>, val: usize) {
    byte_buf_put_u64(b, val as u64);
}

pub fn byte_buf_put_isize(b: mut_view<ByteBuf>, val: isize) {
    byte_buf_put_i64(b, val as i64);
}

pub fn byte_buf_put_bytes(b: mut_view<ByteBuf>, bytes: view<[u8]>) {
    let n = len(bytes);
    if n == 0 {
        return;
    }
    byte_buf_reserve(mut_view(*b), n);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(b.ptr + b.len + i) = bytes[i];
        }
        i = i + 1;
    }
    b.len = b.len + n;
}

pub fn byte_buf_patch_u32_at(b: mut_view<ByteBuf>, offset: usize, val: u32) -> Result<(), ByteBufError> {
    let blen = b.len;
    if blen < 4 || offset > blen - 4 {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    unsafe {
        let p = b.ptr + offset;
        *p = (val & 0xFFu32) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu32) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu32) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu32) as u8;
    }
    Result.Ok(())
}

pub fn byte_buf_patch_u8_at(b: mut_view<ByteBuf>, offset: usize, val: u8) -> Result<(), ByteBufError> {
    if offset >= b.len {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    unsafe {
        *(b.ptr + offset) = val;
    }
    Result.Ok(())
}

pub fn byte_buf_patch_u16_at(b: mut_view<ByteBuf>, offset: usize, val: u16) -> Result<(), ByteBufError> {
    let blen = b.len;
    if blen < 2 || offset > blen - 2 {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    unsafe {
        let p = b.ptr + offset;
        *p = (val & 0xFFu16) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu16) as u8;
    }
    Result.Ok(())
}

pub fn byte_buf_patch_u64_at(b: mut_view<ByteBuf>, offset: usize, val: u64) -> Result<(), ByteBufError> {
    let blen = b.len;
    if blen < 8 || offset > blen - 8 {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    unsafe {
        let p = b.ptr + offset;
        *p = (val & 0xFFu64) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu64) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu64) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu64) as u8;
        *(p + 4) = ((val >> 32) & 0xFFu64) as u8;
        *(p + 5) = ((val >> 40) & 0xFFu64) as u8;
        *(p + 6) = ((val >> 48) & 0xFFu64) as u8;
        *(p + 7) = ((val >> 56) & 0xFFu64) as u8;
    }
    Result.Ok(())
}

pub fn byte_buf_pad_to(b: mut_view<ByteBuf>, align: usize, pad_byte: u8) {
    if align <= 1 {
        return;
    }
    let rem = b.len % align;
    if rem != 0 {
        let mut count = align - rem;
        while count > 0 {
            byte_buf_put_u8(mut_view(*b), pad_byte);
            count = count - 1;
        }
    }
}

pub fn byte_buf_align_to(b: mut_view<ByteBuf>, align: usize) {
    byte_buf_pad_to(b, align, 0u8);
}

pub fn byte_buf_get(b: view<ByteBuf>, index: usize) -> Option<u8> {
    if index >= b.len {
        Option.None
    } else {
        let v = unsafe { *(b.ptr + index) };
        Option.Some(v)
    }
}

pub fn byte_buf_set(b: mut_view<ByteBuf>, index: usize, val: u8) -> Result<(), ByteBufError> {
    if index >= b.len {
        Result.Err(ByteBufError.OutOfBounds)
    } else {
        unsafe {
            *(b.ptr + index) = val;
        }
        Result.Ok(())
    }
}

pub fn byte_buf_clone(b: view<ByteBuf>) -> ByteBuf {
    if b.len == 0 {
        return byte_buf_new();
    }
    let mut res = byte_buf_with_capacity(b.len);
    unsafe {
        ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, res.ptr, b.len);
    }
    res.len = b.len;
    res
}

pub fn byte_buf_slice(b: view<ByteBuf>, start: usize, end: usize) -> Result<ByteBuf, ByteBufError> {
    let blen = b.len;
    if start > end || end > blen {
        return Result.Err(ByteBufError.OutOfBounds);
    }
    let slice_len = end - start;
    if slice_len == 0 {
        return Result.Ok(byte_buf_new());
    }
    let mut res = byte_buf_with_capacity(slice_len);
    unsafe {
        ptr_copy_nonoverlapping<u8>((b.ptr + start) as *const u8, res.ptr, slice_len);
    }
    res.len = slice_len;
    Result.Ok(res)
}

pub fn byte_buf_eq(a: view<ByteBuf>, b: view<ByteBuf>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

impl ByteBuf {
    pub fn len(self: view<ByteBuf>) -> usize { self.len }
    pub fn capacity(self: view<ByteBuf>) -> usize { self.cap }
    pub fn is_empty(self: view<ByteBuf>) -> bool { self.len == 0 }
    pub fn clear(self: mut_view<ByteBuf>) { byte_buf_clear(self); }
    pub fn reserve(self: mut_view<ByteBuf>, additional: usize) { byte_buf_reserve(self, additional); }
    pub fn put_u8(self: mut_view<ByteBuf>, val: u8) { byte_buf_put_u8(self, val); }
    pub fn put_u16(self: mut_view<ByteBuf>, val: u16) { byte_buf_put_u16(self, val); }
    pub fn put_u32(self: mut_view<ByteBuf>, val: u32) { byte_buf_put_u32(self, val); }
    pub fn put_u64(self: mut_view<ByteBuf>, val: u64) { byte_buf_put_u64(self, val); }
    pub fn put_i8(self: mut_view<ByteBuf>, val: i8) { byte_buf_put_i8(self, val); }
    pub fn put_i16(self: mut_view<ByteBuf>, val: i16) { byte_buf_put_i16(self, val); }
    pub fn put_i32(self: mut_view<ByteBuf>, val: i32) { byte_buf_put_i32(self, val); }
    pub fn put_i64(self: mut_view<ByteBuf>, val: i64) { byte_buf_put_i64(self, val); }
    pub fn put_bytes(self: mut_view<ByteBuf>, bytes: view<[u8]>) { byte_buf_put_bytes(self, bytes); }
    pub fn patch_u32_at(self: mut_view<ByteBuf>, offset: usize, val: u32) -> Result<(), ByteBufError> { byte_buf_patch_u32_at(self, offset, val) }
    pub fn pad_to(self: mut_view<ByteBuf>, align: usize, pad_byte: u8) { byte_buf_pad_to(self, align, pad_byte); }
    pub fn align_to(self: mut_view<ByteBuf>, align: usize) { byte_buf_align_to(self, align); }
    pub fn get(self: view<ByteBuf>, index: usize) -> Option<u8> { byte_buf_get(self, index) }
    pub fn set(self: mut_view<ByteBuf>, index: usize, val: u8) -> Result<(), ByteBufError> { byte_buf_set(self, index, val) }
    pub fn clone(self: view<ByteBuf>) -> ByteBuf { byte_buf_clone(self) }
    pub fn slice(self: view<ByteBuf>, start: usize, end: usize) -> Result<ByteBuf, ByteBufError> { byte_buf_slice(self, start, end) }
    pub fn eq(self: view<ByteBuf>, other: view<ByteBuf>) -> bool { byte_buf_eq(self, other) }
}

fn test_basic_construction() -> i32 {
    let mut b = byte_buf_new();
    if b.len() != 0 { return 1; }
    if b.capacity() != 0 { return 2; }
    if !b.is_empty() { return 3; }

    let mut b2 = byte_buf_with_capacity(32);
    if b2.len() != 0 { return 4; }
    if b2.capacity() < 32 { return 5; }
    if !b2.is_empty() { return 6; }
    0
}

fn test_le_writers_golden() -> i32 {
    let mut b = byte_buf_new();
    b.put_u8(0x01u8);
    b.put_u16(0x0302u16);
    b.put_u32(0x07060504u32);
    b.put_u64(0x0F0E0D0C0B0A0908u64);
    b.put_i8(-1i8);
    b.put_i16(-2i16);
    b.put_i32(-1i32);
    b.put_i64(-2i64);

    let raw_arr: [3]u8 = [0xAAu8, 0xBBu8, 0xCCu8];
    b.put_bytes(view(raw_arr));

    // Expected total length: 1 + 2 + 4 + 8 + 1 + 2 + 4 + 8 + 3 = 33
    if b.len() != 33 { return 10; }

    // Check golden byte sequence
    let expected: [33]u8 = [
        0x01u8,
        0x02u8, 0x03u8,
        0x04u8, 0x05u8, 0x06u8, 0x07u8,
        0x08u8, 0x09u8, 0x0Au8, 0x0Bu8, 0x0Cu8, 0x0Du8, 0x0Eu8, 0x0Fu8,
        0xFFu8,
        0xFEu8, 0xFFu8,
        0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
        0xFEu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
        0xAAu8, 0xBBu8, 0xCCu8
    ];

    let mut i: usize = 0;
    while i < 33 {
        match b.get(i) {
            Option.Some(v) => {
                if v != expected[i] { return 100 + i as i32; }
            },
            Option.None => { return 11; },
        }
        i = i + 1;
    }
    0
}

fn test_patch_u32() -> i32 {
    let mut b = byte_buf_new();
    b.put_u32(0x11111111u32);
    b.put_u32(0x22222222u32);
    b.put_u32(0x33333333u32);

    if b.len() != 12 { return 20; }

    // In-bounds patch at offset 4 (replaces 0x22222222 with 0xAABBCCDD)
    match b.patch_u32_at(4, 0xAABBCCDDu32) {
        Result.Ok(u) => {},
        Result.Err(e) => { return 21; },
    }

    match b.get(4) { Option.Some(v) => { if v != 0xDDu8 { return 22; } }, Option.None => { return 23; } }
    match b.get(5) { Option.Some(v) => { if v != 0xCCu8 { return 24; } }, Option.None => { return 25; } }
    match b.get(6) { Option.Some(v) => { if v != 0xBBu8 { return 26; } }, Option.None => { return 27; } }
    match b.get(7) { Option.Some(v) => { if v != 0xAAu8 { return 28; } }, Option.None => { return 29; } }

    // Out-of-bounds patch at offset 9 (9 + 4 = 13 > 12)
    let mut ok9 = false;
    let mut err9 = false;
    match b.patch_u32_at(9, 0x12345678u32) {
        Result.Ok(u) => { ok9 = true; },
        Result.Err(e) => { err9 = true; },
    }
    if ok9 || !err9 { return 30; }

    // Verify offset 9, 10, 11 were unmodified
    match b.get(9) { Option.Some(v) => { if v != 0x33u8 { return 31; } }, Option.None => { return 32; } }
    match b.get(10) { Option.Some(v) => { if v != 0x33u8 { return 33; } }, Option.None => { return 34; } }
    match b.get(11) { Option.Some(v) => { if v != 0x33u8 { return 35; } }, Option.None => { return 36; } }

    // Out-of-bounds patch at offset 12 and beyond
    let mut ok12 = false;
    let mut err12 = false;
    match b.patch_u32_at(12, 0x12345678u32) {
        Result.Ok(u) => { ok12 = true; },
        Result.Err(e) => { err12 = true; },
    }
    if ok12 || !err12 { return 37; }

    let mut ok100 = false;
    let mut err100 = false;
    match b.patch_u32_at(100, 0x12345678u32) {
        Result.Ok(u) => { ok100 = true; },
        Result.Err(e) => { err100 = true; },
    }
    if ok100 || !err100 { return 38; }

    0
}

fn test_alignment_padding() -> i32 {
    let mut b = byte_buf_new();
    b.put_u8(0x01u8);
    b.put_u8(0x02u8);
    b.put_u8(0x03u8);
    if b.len() != 3 { return 40; }

    b.align_to(4);
    if b.len() != 4 { return 41; }
    match b.get(3) { Option.Some(v) => { if v != 0x00u8 { return 42; } }, Option.None => { return 43; } }

    b.align_to(4); // already aligned
    if b.len() != 4 { return 44; }

    b.pad_to(16, 0x90u8);
    if b.len() != 16 { return 45; }
    let mut i: usize = 4;
    while i < 16 {
        match b.get(i) { Option.Some(v) => { if v != 0x90u8 { return 46; } }, Option.None => { return 47; } }
        i = i + 1;
    }

    b.align_to(8); // 16 is already a multiple of 8
    if b.len() != 16 { return 48; }

    b.align_to(0); // 0 does nothing
    if b.len() != 16 { return 49; }

    b.align_to(1); // 1 does nothing
    if b.len() != 16 { return 50; }
    0
}

fn test_slice_and_clone() -> i32 {
    let mut b = byte_buf_new();
    let mut i: usize = 0;
    while i < 10 {
        b.put_u8(i as u8);
        i = i + 1;
    }

    let b_clone = b.clone();
    if !b.eq(view(b_clone)) { return 60; }
    if b_clone.len() != 10 { return 61; }

    let mut sl = byte_buf_new();
    let mut sl_ok = false;
    match b.slice(2, 6) {
        Result.Ok(res) => {
            sl = res;
            sl_ok = true;
        },
        Result.Err(e) => {},
    }
    if !sl_ok { return 62; }
    if sl.len() != 4 { return 63; }
    match sl.get(0) { Option.Some(v) => { if v != 2u8 { return 64; } }, Option.None => { return 65; } }
    match sl.get(3) { Option.Some(v) => { if v != 5u8 { return 66; } }, Option.None => { return 67; } }

    // Out of bounds slice
    let mut ok_sl1 = false;
    let mut err_sl1 = false;
    match b.slice(5, 12) {
        Result.Ok(res) => { ok_sl1 = true; },
        Result.Err(e) => { err_sl1 = true; },
    }
    if ok_sl1 || !err_sl1 { return 68; }

    let mut ok_sl2 = false;
    let mut err_sl2 = false;
    match b.slice(8, 4) {
        Result.Ok(res) => { ok_sl2 = true; },
        Result.Err(e) => { err_sl2 = true; },
    }
    if ok_sl2 || !err_sl2 { return 69; }

    0
}

fn main() -> i32 {
    let r1 = test_basic_construction();
    if r1 != 0 { return r1; }

    let r2 = test_le_writers_golden();
    if r2 != 0 { return r2; }

    let r3 = test_patch_u32();
    if r3 != 0 { return r3; }

    let r4 = test_alignment_padding();
    if r4 != 0 { return r4; }

    let r5 = test_slice_and_clone();
    if r5 != 0 { return r5; }

    print("OK ByteBuf\n");
    return 0;
}
