// test: ui
// covers: REQ-CONC-007 REQ-CONC-104 REQ-CONC-186

module test_ui_channel_send_bounds

pub struct Rc<T> {
    pub ptr: *mut u8,
}
impl<T> !Send for Rc<T> {}
impl<T> !Share for Rc<T> {}

pub struct Sender<T> {
    pub inner: *mut u8,
}
unsafe impl<T: Send> Send for Sender<T> {}
unsafe impl<T: Send> Share for Sender<T> {}
impl<T> !Copy for Sender<T> {}

pub struct Receiver<T> {
    pub inner: *mut u8,
}
unsafe impl<T: Send> Send for Receiver<T> {}
unsafe impl<T: Send> Share for Receiver<T> {}
impl<T> !Copy for Receiver<T> {}

pub struct UnboundedSender<T> {
    pub inner: *mut u8,
}
unsafe impl<T: Send> Send for UnboundedSender<T> {}
unsafe impl<T: Send> Share for UnboundedSender<T> {}
impl<T> !Copy for UnboundedSender<T> {}

pub struct UnboundedReceiver<T> {
    pub inner: *mut u8,
}
unsafe impl<T: Send> Send for UnboundedReceiver<T> {}
unsafe impl<T: Send> Share for UnboundedReceiver<T> {}
impl<T> !Copy for UnboundedReceiver<T> {}

fn require_send<T: Send>(_x: T) {}
fn require_share<T: Share>(_x: T) {}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

pub fn main() {
    let tx: Sender<Rc<i32>> = Sender { inner: 0 as *mut u8 };
    require_send(tx); //~ ERROR AX_CONC_NOT_SEND
    require_share(tx); //~ ERROR AX_CONC_NOT_SHARE

    let rx: Receiver<Rc<i32>> = Receiver { inner: 0 as *mut u8 };
    require_send(rx); //~ ERROR AX_CONC_NOT_SEND
    require_share(rx); //~ ERROR AX_CONC_NOT_SHARE

    let utx: UnboundedSender<Rc<i32>> = UnboundedSender { inner: 0 as *mut u8 };
    require_send(utx); //~ ERROR AX_CONC_NOT_SEND
    require_share(utx); //~ ERROR AX_CONC_NOT_SHARE

    let urx: UnboundedReceiver<Rc<i32>> = UnboundedReceiver { inner: 0 as *mut u8 };
    require_send(urx); //~ ERROR AX_CONC_NOT_SEND
    require_share(urx); //~ ERROR AX_CONC_NOT_SHARE

    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = tx.inner;
        1
    });

    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = rx.inner;
        2
    });
}
