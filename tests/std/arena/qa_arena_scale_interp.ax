// test: run
// modes: interp
// timeout: 200
// stdout: OK ArenaScaleInterp\n

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }

pub const AX_ARENA_DEFAULT_CHUNK: usize = 65536;
pub const AX_ARENA_MAX_ALIGN: usize = 4096;

pub struct ArenaChunk {
    pub next: *mut ArenaChunk,
    pub cap: usize,
    pub used: usize,
    pub data: *mut u8,
}

pub struct Arena {
    pub head: *mut ArenaChunk,
    pub current: *mut ArenaChunk,
    pub chunk_size: usize,
    pub bytes_requested: usize,
    pub chunk_count: usize,
    pub chunks_allocated: usize,
    pub chunks_freed: usize,
}

pub fn arena_new() -> Arena {
    arena_with_chunk_size(AX_ARENA_DEFAULT_CHUNK)
}

pub fn arena_with_chunk_size(chunk_size: usize) -> Arena {
    let sz = if chunk_size == 0 { AX_ARENA_DEFAULT_CHUNK } else { chunk_size };
    Arena {
        head: null_mut<ArenaChunk>(),
        current: null_mut<ArenaChunk>(),
        chunk_size: sz,
        bytes_requested: 0,
        chunk_count: 0,
        chunks_allocated: 0,
        chunks_freed: 0,
    }
}

pub fn arena_alloc_raw(a: mut_view<Arena>, size: usize, align: usize) -> *mut u8 {
    let mut al = align;
    if al == 0 { al = 1; }
    if al > AX_ARENA_MAX_ALIGN { al = AX_ARENA_MAX_ALIGN; }
    let mask: usize = al - 1;
    a.bytes_requested = a.bytes_requested + size;

    let cur: *mut ArenaChunk = a.current;
    if cur as usize != 0 {
        unsafe {
            let u: usize = (*cur).used;
            let off: usize = (u + mask) & ~mask;
            let cap: usize = (*cur).cap;
            if cap >= off {
                if cap - off >= size {
                    (*cur).used = off + size;
                    let ptr: *mut u8 = (*cur).data + off;
                    return ptr;
                }
            }
        }
    }

    let need: usize = size + (al - 1);
    let payload: usize = if need > a.chunk_size { need } else { a.chunk_size };
    let raw: *mut u8 = unsafe { heap_alloc(payload, 16) };
    let hdr: *mut ArenaChunk = unsafe { heap_alloc(size_of<ArenaChunk>(), align_of<ArenaChunk>()) as *mut ArenaChunk };
    unsafe {
        (*hdr).next = null_mut<ArenaChunk>();
        (*hdr).cap = payload;
        (*hdr).used = size;
        (*hdr).data = raw;
    }

    if a.head as usize == 0 {
        a.head = hdr;
    } else {
        unsafe {
            (*a.current).next = hdr;
        }
    }
    a.current = hdr;
    a.chunk_count = a.chunk_count + 1;
    a.chunks_allocated = a.chunks_allocated + 1;

    raw
}

pub fn arena_reset(a: mut_view<Arena>) {
    if a.head as usize == 0 {
        a.bytes_requested = 0;
        return;
    }
    let mut c: *mut ArenaChunk = unsafe { (*a.head).next };
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    unsafe {
        (*a.head).next = null_mut<ArenaChunk>();
        (*a.head).used = 0;
    }
    a.current = a.head;
    a.chunk_count = 1;
    a.bytes_requested = 0;
}

pub fn arena_destroy(a: mut_view<Arena>) {
    let mut c: *mut ArenaChunk = a.head;
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    a.head = null_mut<ArenaChunk>();
    a.current = null_mut<ArenaChunk>();
    a.chunk_count = 0;
    a.bytes_requested = 0;
}

pub fn arena_chunks_in_use(a: view<Arena>) -> usize {
    a.chunks_allocated - a.chunks_freed
}

fn test_scale_interp() -> i32 {
    let mut a = arena_new();

    // 1: Allocate 10,000 items in the arena (16 bytes each, aligned to 8)
    let total_allocs: usize = 10000;
    let mut i: usize = 0;
    while total_allocs > i {
        let p = arena_alloc_raw(mut_view(a), 16, 8);
        if p as usize == 0 { return 1; }
        // Periodically verify pattern
        if (i & 0x03FF) == 0 {
            unsafe {
                *(p as *mut u32) = (i + 7) as u32;
            }
            if unsafe { *(p as *mut u32) } != ((i + 7) as u32) {
                return 2;
            }
        }
        i = i + 1;
    }

    // Verify arena metrics: 10,000 * 16 = 160,000 bytes
    if a.bytes_requested != 160000 { return 3; }
    if 1 >= a.chunk_count { return 4; }
    if a.chunks_allocated != a.chunk_count { return 5; }
    if arena_chunks_in_use(view(a)) != a.chunk_count { return 6; }

    // 2: Test Reset reuses memory
    arena_reset(mut_view(a));
    if a.chunk_count != 1 { return 7; }
    if a.bytes_requested != 0 { return 8; }
    if arena_chunks_in_use(view(a)) != 1 { return 9; }

    // Allocate 1,000 items into the reset arena
    let mut j: usize = 0;
    while 1000 > j {
        let p = arena_alloc_raw(mut_view(a), 16, 8);
        if p as usize == 0 { return 10; }
        if (j & 0x7F) == 0 {
            unsafe {
                *(p as *mut u32) = (j + 99) as u32;
            }
            if unsafe { *(p as *mut u32) } != ((j + 99) as u32) {
                return 11;
            }
        }
        j = j + 1;
    }

    if a.bytes_requested != 16000 { return 12; }
    // 16,000 bytes easily fit within the reused first chunk (65,536 bytes)
    if a.chunk_count != 1 { return 13; }

    // 3: Drop / Destroy arena frees everything, allocator counters back to zero
    arena_destroy(mut_view(a));
    if a.chunk_count != 0 { return 14; }
    if a.bytes_requested != 0 { return 15; }
    if a.chunks_allocated != a.chunks_freed { return 16; }
    if arena_chunks_in_use(view(a)) != 0 { return 17; }

    0
}

fn main() -> i32 {
    let rc = test_scale_interp();
    if rc != 0 {
        return rc;
    }
    print("OK ArenaScaleInterp\n");
    0
}
