// test: run
// timeout: 30
// stdout: OK AstArena\n

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }

pub struct ArenaChunk {
    pub next: *mut ArenaChunk,
    pub cap: usize,
    pub used: usize,
    pub data: *mut u8,
}

pub struct Arena {
    pub head: *mut ArenaChunk,
    pub current: *mut ArenaChunk,
    pub chunk_size: usize,
    pub bytes_requested: usize,
    pub chunk_count: usize,
    pub chunks_allocated: usize,
    pub chunks_freed: usize,
}

pub fn arena_new() -> Arena {
    Arena {
        head: null_mut<ArenaChunk>(),
        current: null_mut<ArenaChunk>(),
        chunk_size: 4096,
        bytes_requested: 0,
        chunk_count: 0,
        chunks_allocated: 0,
        chunks_freed: 0,
    }
}

pub fn arena_alloc_raw(a: mut_view<Arena>, size: usize, align: usize) -> *mut u8 {
    let mut al = align;
    if al == 0 { al = 1; }
    let mask: usize = al - 1;
    a.bytes_requested = a.bytes_requested + size;

    if a.current as usize != 0 {
        let cur: *mut ArenaChunk = a.current;
        let c_addr: usize = unsafe { (*cur).data as usize };
        let u: usize = unsafe { (*cur).used };
        let cur_addr: usize = c_addr + u;
        let al_addr: usize = (cur_addr + mask) & ~mask;
        let off: usize = al_addr - c_addr;
        let cap: usize = unsafe { (*cur).cap };
        if cap >= off {
            let rem_cap: usize = cap - off;
            if rem_cap >= size {
                unsafe {
                    (*cur).used = off + size;
                }
                let ptr: *mut u8 = (c_addr + off) as *mut u8;
                return ptr;
            }
        }
    }

    let need: usize = size + (al - 1);
    let payload: usize = if need > a.chunk_size { need } else { a.chunk_size };
    let raw: *mut u8 = unsafe { heap_alloc(payload, 16) };
    let hdr: *mut ArenaChunk = unsafe { heap_alloc(size_of<ArenaChunk>(), align_of<ArenaChunk>()) as *mut ArenaChunk };
    unsafe {
        (*hdr).next = null_mut<ArenaChunk>();
        (*hdr).cap = payload;
        (*hdr).used = 0;
        (*hdr).data = raw;
    }

    if a.head as usize == 0 {
        a.head = hdr;
    } else {
        unsafe {
            (*a.current).next = hdr;
        }
    }
    a.current = hdr;
    a.chunk_count = a.chunk_count + 1;
    a.chunks_allocated = a.chunks_allocated + 1;

    let c_addr: usize = raw as usize;
    let al_addr: usize = (c_addr + mask) & ~mask;
    let off: usize = al_addr - c_addr;
    unsafe {
        (*hdr).used = off + size;
    }
    let ptr: *mut u8 = (c_addr + off) as *mut u8;
    ptr
}

pub fn arena_reset(a: mut_view<Arena>) {
    if a.head as usize == 0 {
        a.bytes_requested = 0;
        return;
    }
    let mut c: *mut ArenaChunk = unsafe { (*a.head).next };
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    unsafe {
        (*a.head).next = null_mut<ArenaChunk>();
        (*a.head).used = 0;
    }
    a.current = a.head;
    a.chunk_count = 1;
    a.bytes_requested = 0;
}

pub fn arena_destroy(a: mut_view<Arena>) {
    let mut c: *mut ArenaChunk = a.head;
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    a.head = null_mut<ArenaChunk>();
    a.current = null_mut<ArenaChunk>();
    a.chunk_count = 0;
    a.bytes_requested = 0;
}

// AST Nodes allocated directly in the arena
const AST_LIT: u32 = 1;
const AST_ADD: u32 = 2;
const AST_SUB: u32 = 3;
const AST_MUL: u32 = 4;
const AST_NEG: u32 = 5;

pub struct AstNode {
    pub kind: u32,
    pub val: i32,
    pub left: *mut AstNode,
    pub right: *mut AstNode,
}

fn alloc_node(a: mut_view<Arena>, kind: u32, val: i32, left: *mut AstNode, right: *mut AstNode) -> *mut AstNode {
    let sz = size_of<AstNode>();
    let p = arena_alloc_raw(a, sz, 8) as *mut AstNode;
    unsafe {
        (*p).kind = kind;
        (*p).val = val;
        (*p).left = left;
        (*p).right = right;
    }
    p
}

fn make_lit(a: mut_view<Arena>, val: i32) -> *mut AstNode {
    alloc_node(a, AST_LIT, val, null_mut<AstNode>(), null_mut<AstNode>())
}

fn make_bin(a: mut_view<Arena>, kind: u32, left: *mut AstNode, right: *mut AstNode) -> *mut AstNode {
    alloc_node(a, kind, 0, left, right)
}

fn make_neg(a: mut_view<Arena>, operand: *mut AstNode) -> *mut AstNode {
    alloc_node(a, AST_NEG, 0, operand, null_mut<AstNode>())
}

fn eval_ast(node: *mut AstNode) -> i32 {
    if node as usize == 0 { return 0; }
    unsafe {
        let k = (*node).kind;
        if k == AST_LIT {
            return (*node).val;
        }
        if k == AST_NEG {
            return 0 - eval_ast((*node).left);
        }
        let l_val = eval_ast((*node).left);
        let r_val = eval_ast((*node).right);
        if k == AST_ADD { return l_val + r_val; }
        if k == AST_SUB { return l_val - r_val; }
        if k == AST_MUL { return l_val * r_val; }
    }
    0
}

fn count_nodes(node: *mut AstNode) -> usize {
    if node as usize == 0 { return 0; }
    unsafe {
        1 + count_nodes((*node).left) + count_nodes((*node).right)
    }
}

fn main() -> i32 {
    let mut arena = arena_new();

    // 1: Build expression: (10 + 20) * (50 - 30) + (-5)
    let lit10 = make_lit(mut_view(arena), 10);
    let lit20 = make_lit(mut_view(arena), 20);
    let l1 = make_bin(mut_view(arena), AST_ADD, lit10, lit20);

    let lit50 = make_lit(mut_view(arena), 50);
    let lit30 = make_lit(mut_view(arena), 30);
    let r1 = make_bin(mut_view(arena), AST_SUB, lit50, lit30);

    let mul1 = make_bin(mut_view(arena), AST_MUL, l1, r1);

    let lit5 = make_lit(mut_view(arena), 5);
    let neg1 = make_neg(mut_view(arena), lit5);

    let root1 = make_bin(mut_view(arena), AST_ADD, mul1, neg1);

    // Verify count and evaluation
    let count1 = count_nodes(root1);
    if count1 != 10 { return 1; }

    let res1 = eval_ast(root1);
    if res1 != 595 { return 2; }

    // 2: Reset arena and build another AST to verify memory reuse
    arena_reset(mut_view(arena));
    if arena.chunk_count != 1 { return 3; }
    if arena.bytes_requested != 0 { return 4; }

    // Expression 2: (7 * 8) + (100 - 1) = 56 + 99 = 155
    let lit7 = make_lit(mut_view(arena), 7);
    let lit8 = make_lit(mut_view(arena), 8);
    let mul2 = make_bin(mut_view(arena), AST_MUL, lit7, lit8);

    let lit100 = make_lit(mut_view(arena), 100);
    let lit1 = make_lit(mut_view(arena), 1);
    let sub2 = make_bin(mut_view(arena), AST_SUB, lit100, lit1);

    let root2 = make_bin(mut_view(arena), AST_ADD, mul2, sub2);

    let count2 = count_nodes(root2);
    if count2 != 7 { return 5; }

    let res2 = eval_ast(root2);
    if res2 != 155 { return 6; }

    // Reused single chunk
    if arena.chunk_count != 1 { return 7; }

    // 3: Destroy arena and verify clean teardown
    arena_destroy(mut_view(arena));
    if arena.chunk_count != 0 { return 8; }
    if arena.chunks_allocated != arena.chunks_freed { return 9; }

    print("OK AstArena\n");
    0
}
