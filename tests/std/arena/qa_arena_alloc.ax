// test: run
// stdout: OK ArenaAlloc\n

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub const AX_ARENA_DEFAULT_CHUNK: usize = 65536;
pub const AX_ARENA_MAX_ALIGN: usize = 4096;

pub struct ArenaChunk {
    pub next: *mut ArenaChunk,
    pub cap: usize,
    pub used: usize,
    pub data: *mut u8,
}

pub struct Arena {
    pub head: *mut ArenaChunk,
    pub current: *mut ArenaChunk,
    pub chunk_size: usize,
    pub bytes_requested: usize,
    pub chunk_count: usize,
    pub chunks_allocated: usize,
    pub chunks_freed: usize,
}

fn zero_mem(ptr: *mut u8, size: usize) {
    let mut offset: usize = 0;
    let mut rem: usize = size;
    while rem >= 8 {
        unsafe {
            let p_u64: *mut u64 = (ptr + offset) as *mut u64;
            *p_u64 = 0u64;
        }
        offset = offset + 8;
        rem = rem - 8;
    }
    while rem > 0 {
        unsafe {
            *(ptr + offset) = 0u8;
        }
        offset = offset + 1;
        rem = rem - 1;
    }
}

pub fn arena_new() -> Arena {
    arena_with_chunk_size(AX_ARENA_DEFAULT_CHUNK)
}

pub fn arena_with_chunk_size(chunk_size: usize) -> Arena {
    let sz = if chunk_size == 0 { AX_ARENA_DEFAULT_CHUNK } else { chunk_size };
    Arena {
        head: null_mut<ArenaChunk>(),
        current: null_mut<ArenaChunk>(),
        chunk_size: sz,
        bytes_requested: 0,
        chunk_count: 0,
        chunks_allocated: 0,
        chunks_freed: 0,
    }
}

pub fn arena_alloc_raw(a: mut_view<Arena>, size: usize, align: usize) -> *mut u8 {
    let mut al = align;
    if al == 0 { al = 1; }
    if al > AX_ARENA_MAX_ALIGN { al = AX_ARENA_MAX_ALIGN; }
    let mask: usize = al - 1;
    a.bytes_requested = a.bytes_requested + size;

    if a.current as usize != 0 {
        let cur: *mut ArenaChunk = a.current;
        let c_addr: usize = unsafe { (*cur).data as usize };
        let u: usize = unsafe { (*cur).used };
        let cur_addr: usize = c_addr + u;
        let al_addr: usize = (cur_addr + mask) & ~mask;
        let off: usize = al_addr - c_addr;
        let cap: usize = unsafe { (*cur).cap };
        if cap >= off {
            let rem_cap: usize = cap - off;
            if rem_cap >= size {
                unsafe {
                    (*cur).used = off + size;
                }
                let ptr: *mut u8 = (c_addr + off) as *mut u8;
                zero_mem(ptr, size);
                return ptr;
            }
        }
    }

    let need: usize = size + (al - 1);
    let payload: usize = if need > a.chunk_size { need } else { a.chunk_size };
    let raw: *mut u8 = unsafe { heap_alloc(payload, 16) };
    let hdr: *mut ArenaChunk = unsafe { heap_alloc(size_of<ArenaChunk>(), align_of<ArenaChunk>()) as *mut ArenaChunk };
    unsafe {
        (*hdr).next = null_mut<ArenaChunk>();
        (*hdr).cap = payload;
        (*hdr).used = 0;
        (*hdr).data = raw;
    }

    if a.head as usize == 0 {
        a.head = hdr;
    } else {
        unsafe {
            (*a.current).next = hdr;
        }
    }
    a.current = hdr;
    a.chunk_count = a.chunk_count + 1;
    a.chunks_allocated = a.chunks_allocated + 1;

    let c_addr: usize = raw as usize;
    let al_addr: usize = (c_addr + mask) & ~mask;
    let off: usize = al_addr - c_addr;
    unsafe {
        (*hdr).used = off + size;
    }
    let ptr: *mut u8 = (c_addr + off) as *mut u8;
    zero_mem(ptr, size);
    ptr
}

pub fn arena_reset(a: mut_view<Arena>) {
    if a.head as usize == 0 {
        a.bytes_requested = 0;
        return;
    }
    let mut c: *mut ArenaChunk = unsafe { (*a.head).next };
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    unsafe {
        (*a.head).next = null_mut<ArenaChunk>();
        (*a.head).used = 0;
    }
    a.current = a.head;
    a.chunk_count = 1;
    a.bytes_requested = 0;
}

pub fn arena_destroy(a: mut_view<Arena>) {
    let mut c: *mut ArenaChunk = a.head;
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    a.head = null_mut<ArenaChunk>();
    a.current = null_mut<ArenaChunk>();
    a.chunk_count = 0;
    a.bytes_requested = 0;
}

pub fn test_arena_allocations() -> i32 {
    let mut a = arena_new();
    if a.chunk_count != 0 || a.bytes_requested != 0 {
        return 1;
    }

    // Test 1: Single byte allocation
    let p1 = arena_alloc_raw(mut_view(a), 1, 1);
    if p1 as usize == 0 { return 2; }
    if a.chunk_count != 1 || a.bytes_requested != 1 { return 3; }
    if unsafe { *p1 } != 0u8 { return 4; }

    // Test 2: Alignments: 2, 4, 8, 16, 32, 64, 128
    let mut align: usize = 2;
    while 128 >= align {
        let p = arena_alloc_raw(mut_view(a), align, align);
        if p as usize == 0 { return 5; }
        let al_mask: usize = align - 1;
        if ((p as usize) & al_mask) != 0 { return 6; }
        // Verify zeroed
        let mut i: usize = 0;
        while align > i {
            let byte_val = unsafe { *(p + i) };
            if byte_val != 0u8 { return 7; }
            i = i + 1;
        }
        align = align + align;
    }

    // Test 3: Chunk growth (default chunk is 65536)
    // Allocate 100 blocks of 1000 bytes = 100,000 bytes > 65536
    let mut k: usize = 0;
    while 100 > k {
        let p = arena_alloc_raw(mut_view(a), 1000, 8);
        if p as usize == 0 { return 8; }
        // Write pattern to verify no corruption
        unsafe {
            *(p as *mut u32) = (k + 100) as u32;
        }
        k = k + 1;
    }
    if 1 >= a.chunk_count { return 9; }
    if 100000 > a.bytes_requested { return 10; }

    // Test 4: Reset reuses first chunk and frees subsequent chunks
    let initial_allocated = a.chunks_allocated;
    arena_reset(mut_view(a));
    if a.chunk_count != 1 { return 11; }
    if a.bytes_requested != 0 { return 12; }
    if a.chunks_freed == 0 { return 13; }

    // Allocating after reset should start using the preserved head chunk
    let p_reused = arena_alloc_raw(mut_view(a), 256, 16);
    if p_reused as usize == 0 { return 14; }
    if a.chunk_count != 1 { return 15; }
    if a.bytes_requested != 256 { return 16; }

    // Test 5: Destroy frees all chunks
    arena_destroy(mut_view(a));
    if a.chunk_count != 0 { return 17; }
    if a.head as usize != 0 || a.current as usize != 0 { return 18; }
    if a.chunks_allocated != a.chunks_freed { return 19; }

    0
}

fn main() -> i32 {
    let rc = test_arena_allocations();
    if rc != 0 {
        return rc;
    }
    print("OK ArenaAlloc\n");
    0
}
