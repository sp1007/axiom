// RawIdTable
pub struct RawIdTable {
    pub items: *mut u8,
    pub elem_size: usize,
    pub elem_align: usize,
    pub len: usize,
    pub cap: usize,
}

pub fn raw_idtable_new(elem_size: usize, elem_align: usize) -> RawIdTable {
    let esz = if elem_size == 0 { 1 } else { elem_size };
    let eal = if elem_align == 0 { 1 } else { elem_align };
    RawIdTable {
        items: 0 as *mut u8,
        elem_size: esz,
        elem_align: eal,
        len: 0,
        cap: 0,
    }
}

pub fn raw_idtable_free(t: mut_view<RawIdTable>) {
    if t.cap > 0 && t.items as usize != 0 {
        unsafe {
            heap_free(t.items, t.cap * t.elem_size, t.elem_align);
        }
    }
    t.items = 0 as *mut u8;
    t.len = 0;
    t.cap = 0;
}

pub fn raw_idtable_clear(t: mut_view<RawIdTable>) {
    t.len = 0;
}

pub fn raw_idtable_len(t: view<RawIdTable>) -> usize {
    t.len
}

pub fn raw_idtable_is_empty(t: view<RawIdTable>) -> bool {
    t.len == 0
}

pub fn raw_idtable_contains(t: view<RawIdTable>, id_val: u32) -> bool {
    id_val != 0 && (id_val as usize) <= t.len
}

pub fn raw_idtable_push(t: mut_view<RawIdTable>, src: *const u8) -> u32 {
    if t.len == t.cap {
        let mut new_cap = if t.cap == 0 { 4 } else { t.cap + t.cap };
        let new_items = unsafe { heap_alloc(new_cap * t.elem_size, t.elem_align) };
        if t.len > 0 && t.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(t.items as *const u8, new_items, t.len * t.elem_size);
                heap_free(t.items, t.cap * t.elem_size, t.elem_align);
            }
        }
        t.items = new_items;
        t.cap = new_cap;
    }
    let dst = (t.items as usize + t.len * t.elem_size) as *mut u8;
    if src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, t.elem_size);
        }
    }
    t.len = t.len + 1;
    t.len as u32
}

pub unsafe fn raw_idtable_get_ptr(t: view<RawIdTable>, id_val: u32) -> *const u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *const u8
}

pub unsafe fn raw_idtable_get_mut_ptr(t: mut_view<RawIdTable>, id_val: u32) -> *mut u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *mut u8
}

pub fn raw_idtable_first(t: view<RawIdTable>) -> u32 {
    if t.len == 0 { 0u32 } else { 1u32 }
}

pub fn raw_idtable_after(t: view<RawIdTable>, id_val: u32) -> u32 {
    if (id_val as usize) < t.len { id_val + 1u32 } else { 0u32 }
}

// U32IdTable
pub struct U32IdTable {
    pub raw: RawIdTable,
}

pub fn u32_idtable_new() -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_new(4, 4),
    }
}

pub fn u32_idtable_free(t: mut_view<U32IdTable>) {
    raw_idtable_free(mut_view(t.raw));
}

pub fn u32_idtable_len(t: view<U32IdTable>) -> usize {
    t.raw.len
}

pub fn u32_idtable_is_empty(t: view<U32IdTable>) -> bool {
    t.raw.len == 0
}

pub fn u32_idtable_contains(t: view<U32IdTable>, id_val: u32) -> bool {
    raw_idtable_contains(view(t.raw), id_val)
}

pub fn u32_idtable_push(t: mut_view<U32IdTable>, val: u32) -> u32 {
    unsafe {
        raw_idtable_push(mut_view(t.raw), address_of(val) as *const u8)
    }
}

pub fn u32_idtable_get(t: view<U32IdTable>, id_val: u32) -> u32 {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return 0u32;
    }
    unsafe {
        let p = raw_idtable_get_ptr(view(t.raw), id_val) as *const u32;
        *p
    }
}

pub fn u32_idtable_set(t: mut_view<U32IdTable>, id_val: u32, val: u32) -> bool {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return false;
    }
    unsafe {
        let p = raw_idtable_get_mut_ptr(mut_view(t.raw), id_val) as *mut u32;
        *p = val;
    }
    true
}

pub fn u32_idtable_first(t: view<U32IdTable>) -> u32 {
    raw_idtable_first(view(t.raw))
}

pub fn u32_idtable_after(t: view<U32IdTable>, id_val: u32) -> u32 {
    raw_idtable_after(view(t.raw), id_val)
}

fn test_typed_ids() -> i32 {
    // StrId
    let s_none = StrId.none();
    if !s_none.is_none() { return 1; }
    if s_none.is_some() { return 2; }
    if s_none.to_raw() != 0 { return 3; }

    let s1 = StrId.from_index(0);
    if s1.is_none() { return 4; }
    if !s1.is_some() { return 5; }
    if s1.index() != 0 { return 6; }
    if s1.to_raw() != 1 { return 7; }
    let s_raw1 = StrId.from_raw(1);
    if !s1.eq(view(s_raw1)) { return 8; }
    if s1.eq(view(s_none)) { return 9; }

    // FileId
    let f_none = FileId.none();
    if !f_none.is_none() { return 10; }
    let f10 = FileId.from_index(9);
    if f10.to_raw() != 10 { return 11; }
    if f10.index() != 9 { return 12; }

    // NodeId
    let n_none = NodeId.none();
    if !n_none.is_none() { return 13; }
    let n42 = NodeId.from_index(41);
    if n42.to_raw() != 42 { return 14; }
    if n42.index() != 41 { return 15; }

    // SymbolId
    let sym_none = SymbolId.none();
    if !sym_none.is_none() { return 16; }
    let sym7 = SymbolId.from_index(6);
    if sym7.to_raw() != 7 { return 17; }
    if sym7.index() != 6 { return 18; }

    // TypeId
    let t_none = TypeId.none();
    if !t_none.is_none() { return 19; }
    let t99 = TypeId.from_index(98);
    if t99.to_raw() != 99 { return 20; }
    if t99.index() != 98 { return 21; }

    0
}

fn test_raw_idtable() -> i32 {
    let mut t = raw_idtable_new(8, 8);
    if !raw_idtable_is_empty(view(t)) { return 30; }
    if raw_idtable_len(view(t)) != 0 { return 31; }
    if raw_idtable_contains(view(t), 0) { return 32; }
    if raw_idtable_first(view(t)) != 0 { return 33; }

    let v1: u64 = 100u64;
    let v2: u64 = 200u64;
    let v3: u64 = 300u64;
    let v4: u64 = 400u64;
    let v5: u64 = 500u64;

    let id1 = raw_idtable_push(mut_view(t), unsafe { address_of(v1) as *const u8 });
    let id2 = raw_idtable_push(mut_view(t), unsafe { address_of(v2) as *const u8 });
    let id3 = raw_idtable_push(mut_view(t), unsafe { address_of(v3) as *const u8 });
    let id4 = raw_idtable_push(mut_view(t), unsafe { address_of(v4) as *const u8 });
    let id5 = raw_idtable_push(mut_view(t), unsafe { address_of(v5) as *const u8 });

    if id1 != 1 { return 34; }
    if id2 != 2 { return 35; }
    if id3 != 3 { return 36; }
    if id4 != 4 { return 37; }
    if id5 != 5 { return 38; }

    if raw_idtable_len(view(t)) != 5 { return 39; }
    if raw_idtable_is_empty(view(t)) { return 40; }

    if !raw_idtable_contains(view(t), 1) { return 41; }
    if !raw_idtable_contains(view(t), 5) { return 42; }
    if raw_idtable_contains(view(t), 0) { return 43; }
    if raw_idtable_contains(view(t), 6) { return 44; }

    // Read values
    unsafe {
        let p1 = raw_idtable_get_ptr(view(t), 1) as *const u64;
        let p3 = raw_idtable_get_ptr(view(t), 3) as *const u64;
        let p5 = raw_idtable_get_ptr(view(t), 5) as *const u64;
        if *p1 != 100u64 { return 45; }
        if *p3 != 300u64 { return 46; }
        if *p5 != 500u64 { return 47; }
    }

    // Mutate value
    unsafe {
        let p3_mut = raw_idtable_get_mut_ptr(mut_view(t), 3) as *mut u64;
        *p3_mut = 999u64;
        let p3_read = raw_idtable_get_ptr(view(t), 3) as *const u64;
        if *p3_read != 999u64 { return 48; }
    }

    // Insertion-order iteration
    let mut cur = raw_idtable_first(view(t));
    if cur != 1 { return 49; }
    cur = raw_idtable_after(view(t), cur);
    if cur != 2 { return 50; }
    cur = raw_idtable_after(view(t), cur);
    if cur != 3 { return 51; }
    cur = raw_idtable_after(view(t), cur);
    if cur != 4 { return 52; }
    cur = raw_idtable_after(view(t), cur);
    if cur != 5 { return 53; }
    cur = raw_idtable_after(view(t), cur);
    if cur != 0 { return 54; }

    // Clear
    raw_idtable_clear(mut_view(t));
    if raw_idtable_len(view(t)) != 0 { return 55; }
    if !raw_idtable_is_empty(view(t)) { return 56; }
    if raw_idtable_first(view(t)) != 0 { return 57; }

    raw_idtable_free(mut_view(t));
    0
}

fn test_u32_idtable() -> i32 {
    let mut t = u32_idtable_new();
    if !u32_idtable_is_empty(view(t)) { return 60; }
    if u32_idtable_len(view(t)) != 0 { return 61; }

    // Push 100 items
    let mut i: u32 = 0;
    while 100 > i {
        let val = (i * 10) + 7;
        let id = u32_idtable_push(mut_view(t), val);
        if id != (i + 1) { return 62; }
        i = i + 1;
    }

    if u32_idtable_len(view(t)) != 100 { return 63; }
    if u32_idtable_is_empty(view(t)) { return 64; }

    // Verify all items
    let mut j: u32 = 0;
    while 100 > j {
        let expected = (j * 10) + 7;
        let id = j + 1;
        if u32_idtable_get(view(t), id) != expected { return 65; }
        j = j + 1;
    }

    // Mutate item at id 50
    let ok = u32_idtable_set(mut_view(t), 50, 12345u32);
    if !ok { return 66; }
    if u32_idtable_get(view(t), 50) != 12345u32 { return 67; }

    // Verify invalid id handling
    if u32_idtable_contains(view(t), 0) { return 68; }
    if u32_idtable_contains(view(t), 101) { return 69; }
    if u32_idtable_get(view(t), 0) != 0 { return 70; }
    if u32_idtable_get(view(t), 101) != 0 { return 71; }
    if u32_idtable_set(mut_view(t), 0, 99) { return 72; }
    if u32_idtable_set(mut_view(t), 101, 99) { return 73; }

    // Iterate in insertion order
    let mut iter_id = u32_idtable_first(view(t));
    let mut count: u32 = 0;
    while iter_id != 0 {
        count = count + 1;
        if iter_id != count { return 74; }
        iter_id = u32_idtable_after(view(t), iter_id);
    }
    if count != 100 { return 75; }

    u32_idtable_free(mut_view(t));
    0
}

fn main() -> i32 {
    let rc1 = test_typed_ids();
    if rc1 != 0 { return rc1; }

    let rc2 = test_raw_idtable();
    if rc2 != 0 { return rc2; }

    let rc3 = test_u32_idtable();
    if rc3 != 0 { return rc3; }

    print("OK IdTable\n");
    0
}
