// test: run
// stdout: OK StringBuilder\n

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String { ptr: 0 as *mut u8, len: 0, cap: 0, _glue: DropGlue {} }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String { ptr: raw, len: 0, cap: capacity, _glue: DropGlue {} }
}

pub fn string_reserve(s: mut_view<String>, additional: usize) {
    let needed = s.len + additional;
    if needed <= s.cap {
        return;
    }
    let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
    if new_cap < needed {
        new_cap = needed;
    }
    let raw = unsafe { heap_alloc(new_cap, 8) };
    let new_ptr = raw as *mut u8;
    if s.len > 0 && s.ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
            heap_free(s.ptr, s.cap, 8);
        }
    }
    s.ptr = new_ptr;
    s.cap = new_cap;
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let u = c as u32;
    let clen: usize = if u <= 0x7F { 1 } else if u <= 0x7FF { 2 } else if u <= 0xFFFF { 3 } else { 4 };
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    if clen == 1 {
        unsafe { *dst = u as u8; }
    } else if clen == 2 {
        unsafe {
            *dst = (0xC0 | (u >> 6)) as u8;
            *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        }
    } else if clen == 3 {
        unsafe {
            *dst = (0xE0 | (u >> 12)) as u8;
            *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
            *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        }
    } else {
        unsafe {
            *dst = (0xF0 | (u >> 18)) as u8;
            *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
            *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
            *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        }
    }
    s.len = s.len + clen;
}

pub fn string_push_str(s: mut_view<String>, other: view<String>) {
    if other.len == 0 {
        return;
    }
    let needed = s.len + other.len;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(other.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        ptr_copy_nonoverlapping<u8>(other.ptr as *const u8, dst, other.len);
    }
    s.len = s.len + other.len;
}

pub fn decode_char_at(bytes: view<[u8]>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub fn validate_utf8(bytes: view<[u8]>) -> Result<(), Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(())
}

pub fn string_push_bytes(s: mut_view<String>, bytes: view<[u8]>) -> Result<(), Utf8Error> {
    match validate_utf8(bytes) {
        Result.Ok(u) => {
            let n = len(bytes);
            if n == 0 {
                return Result.Ok(());
            }
            let needed = s.len + n;
            if needed > s.cap {
                let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
                if new_cap < needed {
                    new_cap = needed;
                }
                let raw = unsafe { heap_alloc(new_cap, 8) };
                let new_ptr = raw as *mut u8;
                if s.len > 0 && s.ptr as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                        heap_free(s.ptr, s.cap, 8);
                    }
                }
                s.ptr = new_ptr;
                s.cap = new_cap;
            }
            let dst = unsafe { s.ptr + s.len };
            let mut i: usize = 0;
            while i < n {
                unsafe {
                    *(dst + i) = bytes[i];
                }
                i = i + 1;
            }
            s.len = s.len + n;
            Result.Ok(())
        },
        Result.Err(e) => Result.Err(e),
    }
}

pub fn string_clone(s: view<String>) -> String {
    if s.len == 0 {
        return string_new();
    }
    let mut res = string_with_capacity(s.len);
    unsafe {
        ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, res.ptr, s.len);
    }
    res.len = s.len;
    res
}

pub fn string_concat(a: view<String>, b: view<String>) -> String {
    let total_len = a.len + b.len;
    if total_len == 0 {
        return string_new();
    }
    let mut res = string_with_capacity(total_len);
    if a.len > 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(a.ptr as *const u8, res.ptr, a.len);
        }
    }
    if b.len > 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, res.ptr + a.len, b.len);
        }
    }
    res.len = total_len;
    res
}

pub fn string_eq(a: view<String>, b: view<String>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn string_cmp(a: view<String>, b: view<String>) -> i32 {
    let alen = a.len;
    let blen = b.len;
    let min_len = if alen < blen { alen } else { blen };
    let mut i: usize = 0;
    while i < min_len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba < bb {
            return -1;
        } else if ba > bb {
            return 1;
        }
        i = i + 1;
    }
    if alen < blen {
        -1
    } else if alen > blen {
        1
    } else {
        0
    }
}

impl String {
    pub fn len(self: view<String>) -> usize { self.len }
    pub fn capacity(self: view<String>) -> usize { self.cap }
    pub fn is_empty(self: view<String>) -> bool { self.len == 0 }
    pub fn clear(self: mut_view<String>) { self.len = 0; }
    pub fn reserve(self: mut_view<String>, additional: usize) { string_reserve(self, additional); }
    pub fn push_char(self: mut_view<String>, c: char) { string_push_char(self, c); }
    pub fn push_str(self: mut_view<String>, other: view<String>) { string_push_str(self, other); }
    pub fn push_bytes(self: mut_view<String>, bytes: view<[u8]>) -> Result<(), Utf8Error> { string_push_bytes(self, bytes) }
    pub fn clone(self: view<String>) -> String { string_clone(self) }
    pub fn concat(self: view<String>, other: view<String>) -> String { string_concat(self, other) }
    pub fn eq(self: view<String>, other: view<String>) -> bool { string_eq(self, other) }
    pub fn cmp(self: view<String>, other: view<String>) -> i32 { string_cmp(self, other) }
}

fn test_allocation_and_growth() -> i32 {
    let mut s = string_new();
    if !s.is_empty() { return 1; }
    if s.len() != 0 { return 2; }
    if s.capacity() != 0 { return 3; }

    s.reserve(10);
    if s.capacity() < 10 { return 4; }

    s.push_char('A');
    s.push_char('B');
    s.push_char('C');
    if s.len() != 3 { return 5; }

    let mut other = string_with_capacity(16);
    other.push_char('D');
    other.push_char('E');
    s.push_str(view(other));
    if s.len() != 5 { return 6; }

    s.clear();
    if !s.is_empty() { return 7; }
    if s.len() != 0 { return 8; }
    if s.capacity() < 10 { return 9; } // capacity preserved after clear

    0
}

fn test_push_bytes_validation() -> i32 {
    let mut s = string_new();
    let valid_bytes: [4]u8 = [0x54, 0x65, 0x73, 0x74]; // "Test"
    match s.push_bytes(view(valid_bytes)) {
        Result.Ok(u) => {
            if s.len() != 4 { return 20; }
        },
        Result.Err(e) => { return 21; }
    }

    // Try pushing invalid lone continuation byte
    let invalid_bytes: [2]u8 = [0x80, 0x81];
    match s.push_bytes(view(invalid_bytes)) {
        Result.Ok(u) => { return 22; },
        Result.Err(e) => {
            if s.len() != 4 { return 23; } // string length unmodified on error
        }
    }

    0
}

fn test_clone_and_concat() -> i32 {
    let mut s1 = string_new();
    s1.push_char('F');
    s1.push_char('o');
    s1.push_char('o');

    let s2 = s1.clone();
    if s2.len() != 3 { return 30; }
    if !s1.eq(view(s2)) { return 31; }

    let mut s3 = string_new();
    s3.push_char('B');
    s3.push_char('a');
    s3.push_char('r');

    let s4 = s1.concat(view(s3));
    if s4.len() != 6 { return 32; }

    0
}

fn test_cmp() -> i32 {
    let mut a = string_new();
    a.push_char('a');
    a.push_char('p');
    a.push_char('p');
    a.push_char('l');
    a.push_char('e');

    let mut b = string_new();
    b.push_char('a');
    b.push_char('p');
    b.push_char('p');
    b.push_char('l');
    b.push_char('y');

    if a.cmp(view(b)) >= 0 { return 40; } // apple < apply
    if b.cmp(view(a)) <= 0 { return 41; } // apply > apple
    if a.cmp(view(a)) != 0 { return 42; } // apple == apple

    let mut prefix = string_new();
    prefix.push_char('a');
    prefix.push_char('p');
    prefix.push_char('p');

    if prefix.cmp(view(a)) >= 0 { return 43; } // app < apple
    if a.cmp(view(prefix)) <= 0 { return 44; } // apple > app

    0
}

fn main() -> i32 {
    let r1 = test_allocation_and_growth();
    if r1 != 0 { return r1; }

    let r2 = test_push_bytes_validation();
    if r2 != 0 { return r2; }

    let r3 = test_clone_and_concat();
    if r3 != 0 { return r3; }

    let r4 = test_cmp();
    if r4 != 0 { return r4; }

    print("OK StringBuilder\n");
    return 0;
}
