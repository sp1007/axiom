// test: run
// stdout: OK CharPrimitives\n

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

pub fn char_len_utf8(c: char) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        1
    } else if u <= 0x7FF {
        2
    } else if u <= 0xFFFF {
        3
    } else {
        4
    }
}

pub unsafe fn char_encode_utf8(c: char, dst: *mut u8) -> usize {
    let u = c as u32;
    if u <= 0x7F {
        *dst = u as u8;
        1
    } else if u <= 0x7FF {
        *dst = (0xC0 | (u >> 6)) as u8;
        *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        2
    } else if u <= 0xFFFF {
        *dst = (0xE0 | (u >> 12)) as u8;
        *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        3
    } else {
        *dst = (0xF0 | (u >> 18)) as u8;
        *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
        *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
        *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        4
    }
}

impl char {
    pub fn len_utf8(self: char) -> usize {
        char_len_utf8(self)
    }

    pub unsafe fn encode_utf8(self: char, dst: *mut u8) -> usize {
        char_encode_utf8(self, dst)
    }
}

pub fn decode_char_at(bytes: view<[u8]>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub fn is_char_boundary(bytes: view<[u8]>, offset: usize) -> bool {
    let n = len(bytes);
    if offset == 0 || offset == n {
        return true;
    }
    if offset > n {
        return false;
    }
    let b = bytes[offset];
    (b & 0xC0) != 0x80
}

pub fn char_count(bytes: view<[u8]>) -> Result<usize, Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    let mut count: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                count = count + 1;
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(count)
}

fn test_len_utf8() -> i32 {
    let c1: char = 'A';
    if c1.len_utf8() != 1 { return 1; }

    let c2: char = 'é';
    if c2.len_utf8() != 2 { return 2; }

    let c3: char = 'ế';
    if c3.len_utf8() != 3 { return 3; }

    let c4: char = 0x1F600u32 as char; // '😀'
    if c4.len_utf8() != 4 { return 4; }

    0
}

fn test_encode_utf8() -> i32 {
    let raw = unsafe { heap_alloc(16, 8) };
    let p = raw as *mut u8;

    // 1-byte encode: 'Z' (0x5A)
    let n1 = unsafe { ('Z').encode_utf8(p) };
    if n1 != 1 { return 10; }
    let b0 = unsafe { *p };
    if b0 != 0x5A { return 11; }

    // 2-byte encode: 'é' (0xC3, 0xA9)
    let n2 = unsafe { ('é').encode_utf8(p + 1) };
    if n2 != 2 { return 12; }
    let b1 = unsafe { *(p + 1) };
    let b2 = unsafe { *(p + 2) };
    if b1 != 0xC3 || b2 != 0xA9 { return 13; }

    // 3-byte encode: 'ế' (0xE1, 0xBA, 0xBF)
    let n3 = unsafe { ('ế').encode_utf8(p + 3) };
    if n3 != 3 { return 14; }
    let b3 = unsafe { *(p + 3) };
    let b4 = unsafe { *(p + 4) };
    let b5 = unsafe { *(p + 5) };
    if b3 != 0xE1 || b4 != 0xBA || b5 != 0xBF { return 15; }

    // 4-byte encode: 0x1F600u32 ('😀' -> 0xF0, 0x9F, 0x98, 0x80)
    let n4 = unsafe { (0x1F600u32 as char).encode_utf8(p + 6) };
    if n4 != 4 { return 16; }
    let b6 = unsafe { *(p + 6) };
    let b7 = unsafe { *(p + 7) };
    let b8 = unsafe { *(p + 8) };
    let b9 = unsafe { *(p + 9) };
    if b6 != 0xF0 || b7 != 0x9F || b8 != 0x98 || b9 != 0x80 { return 17; }

    unsafe { heap_free(p, 16, 8); }
    0
}

fn test_decode_and_count() -> i32 {
    // Buffer contains: 'Z', 'é', 'ế', '😀' (total 10 bytes, 4 chars)
    let data: [10]u8 = [
        0x5A,                   // 1 byte: 'Z'
        0xC3, 0xA9,             // 2 bytes: 'é'
        0xE1, 0xBA, 0xBF,       // 3 bytes: 'ế'
        0xF0, 0x9F, 0x98, 0x80  // 4 bytes: '😀'
    ];
    let v: view<[u8]> = view(data);

    // Decode 'Z' at offset 0
    match decode_char_at(v, 0) {
        Result.Ok(res) => {
            if res.len != 1 { return 20; }
            if (res.ch as u32) != 0x5A { return 21; }
        },
        Result.Err(e) => { return 22; }
    }

    // Decode 'é' at offset 1
    match decode_char_at(v, 1) {
        Result.Ok(res) => {
            if res.len != 2 { return 23; }
            if (res.ch as u32) != 0x00E9 { return 24; }
        },
        Result.Err(e) => { return 25; }
    }

    // Decode 'ế' at offset 3
    match decode_char_at(v, 3) {
        Result.Ok(res) => {
            if res.len != 3 { return 26; }
            if (res.ch as u32) != 0x1EBF { return 27; }
        },
        Result.Err(e) => { return 28; }
    }

    // Decode '😀' at offset 6
    match decode_char_at(v, 6) {
        Result.Ok(res) => {
            if res.len != 4 { return 29; }
            if (res.ch as u32) != 0x1F600 { return 30; }
        },
        Result.Err(e) => { return 31; }
    }

    // Test char boundaries
    if !is_char_boundary(v, 0) { return 32; }
    if !is_char_boundary(v, 1) { return 33; }
    if is_char_boundary(v, 2) { return 34; } // inside 'é'
    if !is_char_boundary(v, 3) { return 35; }
    if is_char_boundary(v, 4) { return 36; } // inside 'ế'
    if is_char_boundary(v, 5) { return 37; } // inside 'ế'
    if !is_char_boundary(v, 6) { return 38; }
    if is_char_boundary(v, 7) { return 39; } // inside '😀'
    if is_char_boundary(v, 8) { return 40; } // inside '😀'
    if is_char_boundary(v, 9) { return 41; } // inside '😀'
    if !is_char_boundary(v, 10) { return 42; } // end boundary

    // Test char count
    match char_count(v) {
        Result.Ok(cnt) => {
            if cnt != 4 { return 43; }
        },
        Result.Err(e) => { return 44; }
    }

    0
}

fn main() -> i32 {
    let r1 = test_len_utf8();
    if r1 != 0 { return r1; }

    let r2 = test_encode_utf8();
    if r2 != 0 { return r2; }

    let r3 = test_decode_and_count();
    if r3 != 0 { return r3; }

    print("OK CharPrimitives\n");
    return 0;
}
