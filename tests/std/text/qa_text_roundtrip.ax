// test: run
// stdout: OK TextRoundtrip\n

use std.core.result.Result
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String { ptr: 0 as *mut u8, len: 0, cap: 0, _glue: DropGlue {} }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String { ptr: raw, len: 0, cap: capacity, _glue: DropGlue {} }
}

pub fn string_push_char(s: mut_view<String>, c: char) {
    let u = c as u32;
    let clen: usize = if u <= 0x7F { 1 } else if u <= 0x7FF { 2 } else if u <= 0xFFFF { 3 } else { 4 };
    let needed = s.len + clen;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(s.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    if clen == 1 {
        unsafe { *dst = u as u8; }
    } else if clen == 2 {
        unsafe {
            *dst = (0xC0 | (u >> 6)) as u8;
            *(dst + 1) = (0x80 | (u & 0x3F)) as u8;
        }
    } else if clen == 3 {
        unsafe {
            *dst = (0xE0 | (u >> 12)) as u8;
            *(dst + 1) = (0x80 | ((u >> 6) & 0x3F)) as u8;
            *(dst + 2) = (0x80 | (u & 0x3F)) as u8;
        }
    } else {
        unsafe {
            *dst = (0xF0 | (u >> 18)) as u8;
            *(dst + 1) = (0x80 | ((u >> 12) & 0x3F)) as u8;
            *(dst + 2) = (0x80 | ((u >> 6) & 0x3F)) as u8;
            *(dst + 3) = (0x80 | (u & 0x3F)) as u8;
        }
    }
    s.len = s.len + clen;
}

pub fn string_push_str(s: mut_view<String>, other: view<String>) {
    if other.len == 0 {
        return;
    }
    let needed = s.len + other.len;
    if needed > s.cap {
        let mut new_cap = if s.cap == 0 { 8 } else { s.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let raw = unsafe { heap_alloc(new_cap, 8) };
        let new_ptr = raw as *mut u8;
        if s.len > 0 && s.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(other.ptr as *const u8, new_ptr, s.len);
                heap_free(s.ptr, s.cap, 8);
            }
        }
        s.ptr = new_ptr;
        s.cap = new_cap;
    }
    let dst = unsafe { s.ptr + s.len };
    unsafe {
        ptr_copy_nonoverlapping<u8>(other.ptr as *const u8, dst, other.len);
    }
    s.len = s.len + other.len;
}

pub fn string_is_char_boundary(s: view<String>, offset: usize) -> bool {
    if offset == 0 || offset == s.len {
        return true;
    }
    if offset > s.len {
        return false;
    }
    let b = unsafe { *(s.ptr + offset) };
    (b & 0xC0) != 0x80
}

pub fn string_slice(s: view<String>, start: usize, end: usize) -> Result<String, Utf8Error> {
    if start > end || end > s.len {
        return Result.Err(Utf8Error.InvalidBoundary(start));
    }
    if !string_is_char_boundary(s, start) {
        return Result.Err(Utf8Error.InvalidBoundary(start));
    }
    if !string_is_char_boundary(s, end) {
        return Result.Err(Utf8Error.InvalidBoundary(end));
    }
    let slice_len = end - start;
    if slice_len == 0 {
        return Result.Ok(string_new());
    }
    let mut res = string_with_capacity(slice_len);
    unsafe {
        ptr_copy_nonoverlapping<u8>(s.ptr + start, res.ptr, slice_len);
    }
    res.len = slice_len;
    Result.Ok(res)
}

impl String {
    pub fn len(self: view<String>) -> usize { self.len }
    pub fn is_empty(self: view<String>) -> bool { self.len == 0 }
    pub fn push_char(self: mut_view<String>, c: char) { string_push_char(self, c); }
    pub fn push_str(self: mut_view<String>, other: view<String>) { string_push_str(self, other); }
    pub fn slice(self: view<String>, start: usize, end: usize) -> Result<String, Utf8Error> {
        string_slice(self, start, end)
    }
}

pub fn decode_char_at(bytes: view<[u8]>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub fn is_char_boundary(bytes: view<[u8]>, offset: usize) -> bool {
    let n = len(bytes);
    if offset == 0 || offset == n {
        return true;
    }
    if offset > n {
        return false;
    }
    let b = bytes[offset];
    (b & 0xC0) != 0x80
}

pub fn char_count(bytes: view<[u8]>) -> Result<usize, Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    let mut count: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                count = count + 1;
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(count)
}

pub fn validate_utf8(bytes: view<[u8]>) -> Result<(), Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(())
}

fn test_xin_chao_roundtrip() -> i32 {
    let mut text = string_new();
    text.push_char('X');
    text.push_char('i');
    text.push_char('n');
    text.push_char(' ');
    text.push_char('c');
    text.push_char('h');
    text.push_char('à');
    text.push_char('o');
    text.push_char(' ');
    text.push_char('t');
    text.push_char('h');
    text.push_char('ế');
    text.push_char(' ');
    text.push_char('g');
    text.push_char('i');
    text.push_char('ớ');
    text.push_char('i');

    if text.len != 22 { return 1; }

    let expected_bytes: [22]u8 = [
        0x58, 0x69, 0x6e, 0x20, 0x63, 0x68, 0xc3, 0xa0,
        0x6f, 0x20, 0x74, 0x68, 0xe1, 0xba, 0xbf, 0x20,
        0x67, 0x69, 0xe1, 0xbb, 0x9b, 0x69
    ];
    let mut i: usize = 0;
    while i < 22 {
        let b = unsafe { *(text.ptr + i) };
        if b != expected_bytes[i] { return 2; }
        i = i + 1;
    }

    let v: view<[u8]> = view(expected_bytes);
    match validate_utf8(v) {
        Result.Ok(u) => {},
        Result.Err(e) => { return 3; }
    }

    match char_count(v) {
        Result.Ok(cnt) => {
            if cnt != 17 { return 4; }
        },
        Result.Err(e) => { return 5; }
    }
    0
}

fn test_char_boundaries() -> i32 {
    let expected_bytes: [22]u8 = [
        0x58, 0x69, 0x6e, 0x20, 0x63, 0x68, 0xc3, 0xa0,
        0x6f, 0x20, 0x74, 0x68, 0xe1, 0xba, 0xbf, 0x20,
        0x67, 0x69, 0xe1, 0xbb, 0x9b, 0x69
    ];
    let v: view<[u8]> = view(expected_bytes);

    if !is_char_boundary(v, 0) { return 10; }
    if !is_char_boundary(v, 6) { return 11; }  // start of 'à'
    if is_char_boundary(v, 7) { return 12; }   // continuation byte of 'à'
    if !is_char_boundary(v, 8) { return 13; }  // 'o'
    if !is_char_boundary(v, 12) { return 14; } // start of 'ế'
    if is_char_boundary(v, 13) { return 15; }  // continuation byte 1 of 'ế'
    if is_char_boundary(v, 14) { return 16; }  // continuation byte 2 of 'ế'
    if !is_char_boundary(v, 15) { return 17; } // ' '
    if !is_char_boundary(v, 18) { return 18; } // start of 'ớ'
    if is_char_boundary(v, 19) { return 19; }  // continuation byte 1 of 'ớ'
    if is_char_boundary(v, 20) { return 20; }  // continuation byte 2 of 'ớ'
    if !is_char_boundary(v, 21) { return 21; } // 'i'
    if !is_char_boundary(v, 22) { return 22; } // end boundary
    if is_char_boundary(v, 23) { return 23; }  // out of bounds
    0
}

fn test_slicing() -> i32 {
    let mut text = string_new();
    text.push_char('X');
    text.push_char('i');
    text.push_char('n');
    text.push_char(' ');
    text.push_char('c');
    text.push_char('h');
    text.push_char('à');
    text.push_char('o');
    text.push_char(' ');
    text.push_char('t');
    text.push_char('h');
    text.push_char('ế');
    text.push_char(' ');
    text.push_char('g');
    text.push_char('i');
    text.push_char('ớ');
    text.push_char('i');

    match text.slice(0, 4) {
        Result.Ok(xin) => {
            if xin.len != 4 { return 30; }
        },
        Result.Err(e) => { return 31; }
    }
    match text.slice(4, 9) {
        Result.Ok(chao) => {
            if chao.len != 5 { return 32; }
        },
        Result.Err(e) => { return 33; }
    }
    match text.slice(10, 15) {
        Result.Ok(the) => {
            if the.len != 5 { return 34; }
        },
        Result.Err(e) => { return 35; }
    }
    match text.slice(16, 22) {
        Result.Ok(gioi) => {
            if gioi.len != 6 { return 36; }
        },
        Result.Err(e) => { return 37; }
    }

    // Invalid slice boundaries
    match text.slice(0, 7) {
        Result.Ok(bad) => { return 40; },
        Result.Err(e) => {}
    }
    match text.slice(13, 15) {
        Result.Ok(bad) => { return 43; },
        Result.Err(e) => {}
    }
    match text.slice(16, 20) {
        Result.Ok(bad) => { return 46; },
        Result.Err(e) => {}
    }
    0
}

fn test_invalid_rejection() -> i32 {
    // Lone continuation byte (0x80)
    let lone_cont: [1]u8 = [0x80];
    match validate_utf8(view(lone_cont)) {
        Result.Ok(u) => { return 50; },
        Result.Err(e) => {}
    }

    // Overlong 2-byte sequence (0xC0, 0x80)
    let overlong2: [2]u8 = [0xC0, 0x80];
    match validate_utf8(view(overlong2)) {
        Result.Ok(u) => { return 53; },
        Result.Err(e) => {}
    }

    // Surrogate code point 0xD800 (0xED, 0xA0, 0x80)
    let surrogate: [3]u8 = [0xED, 0xA0, 0x80];
    match validate_utf8(view(surrogate)) {
        Result.Ok(u) => { return 56; },
        Result.Err(e) => {}
    }

    // Truncated 3-byte sequence (missing 3rd byte)
    let truncated: [2]u8 = [0xE1, 0xBA];
    match validate_utf8(view(truncated)) {
        Result.Ok(u) => { return 59; },
        Result.Err(e) => {}
    }

    // Out-of-range code point (0xF5, 0x80, 0x80, 0x80)
    let out_of_range: [4]u8 = [0xF5, 0x80, 0x80, 0x80];
    match validate_utf8(view(out_of_range)) {
        Result.Ok(u) => { return 62; },
        Result.Err(e) => {}
    }
    0
}

fn main() -> i32 {
    let r1 = test_xin_chao_roundtrip();
    if r1 != 0 { return r1; }

    let r2 = test_char_boundaries();
    if r2 != 0 { return r2; }

    let r3 = test_slicing();
    if r3 != 0 { return r3; }

    let r4 = test_invalid_rejection();
    if r4 != 0 { return r4; }

    print("OK TextRoundtrip\n");
    return 0;
}
