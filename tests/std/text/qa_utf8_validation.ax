// test: run
// stdout: OK Utf8Validation\n

use std.core.result.Result

pub struct DecodeResult {
    pub ch: char,
    pub len: usize,
}

pub enum Utf8Error {
    InvalidByte(usize),
    Truncated(usize),
    Overlong(usize),
    Surrogate(usize),
    OutOfRange(usize),
    InvalidBoundary(usize),
}

pub fn decode_char_at(bytes: view<[u8]>, offset: usize) -> Result<DecodeResult, Utf8Error> {
    let n = len(bytes);
    if offset >= n {
        return Result.Err(Utf8Error.Truncated(offset));
    }
    let b0 = bytes[offset];
    if (b0 & 0x80) == 0 {
        return Result.Ok(DecodeResult { ch: b0 as u32 as char, len: 1 });
    }
    if (b0 & 0xC0) == 0x80 {
        return Result.Err(Utf8Error.InvalidByte(offset));
    }
    if b0 <= 0xC1 {
        return Result.Err(Utf8Error.Overlong(offset));
    }
    if b0 <= 0xDF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        let cp = (((b0 as u32) & 0x1F) << 6) | ((b1 as u32) & 0x3F);
        return Result.Ok(DecodeResult { ch: cp as char, len: 2 });
    }
    if b0 <= 0xEF {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        let cp = (((b0 as u32) & 0x0F) << 12) | (((b1 as u32) & 0x3F) << 6) | ((b2 as u32) & 0x3F);
        if cp < 0x800 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return Result.Err(Utf8Error.Surrogate(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 3 });
    }
    if b0 <= 0xF4 {
        if offset + 1 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b1 = bytes[offset + 1];
        if (b1 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 1));
        }
        if offset + 2 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b2 = bytes[offset + 2];
        if (b2 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 2));
        }
        if offset + 3 >= n {
            return Result.Err(Utf8Error.Truncated(offset));
        }
        let b3 = bytes[offset + 3];
        if (b3 & 0xC0) != 0x80 {
            return Result.Err(Utf8Error.InvalidByte(offset + 3));
        }
        let cp = (((b0 as u32) & 0x07) << 18) | (((b1 as u32) & 0x3F) << 12) | (((b2 as u32) & 0x3F) << 6) | ((b3 as u32) & 0x3F);
        if cp < 0x10000 {
            return Result.Err(Utf8Error.Overlong(offset));
        }
        if cp > 0x10FFFF {
            return Result.Err(Utf8Error.OutOfRange(offset));
        }
        return Result.Ok(DecodeResult { ch: cp as char, len: 4 });
    }
    return Result.Err(Utf8Error.OutOfRange(offset));
}

pub fn validate_utf8(bytes: view<[u8]>) -> Result<(), Utf8Error> {
    let n = len(bytes);
    let mut offset: usize = 0;
    while offset < n {
        match decode_char_at(bytes, offset) {
            Result.Ok(res) => {
                offset = offset + res.len;
            },
            Result.Err(e) => {
                return Result.Err(e);
            }
        }
    }
    Result.Ok(())
}

fn test_valid_boundaries() -> i32 {
    // ASCII boundaries: 0x00, 0x7F
    let ascii: [2]u8 = [0x00, 0x7F];
    match validate_utf8(view(ascii)) {
        Result.Ok(u) => {},
        Result.Err(e) => { return 1; }
    }

    // 2-byte boundaries: 0x80 (C2 80) and 0x7FF (DF BF)
    let two_byte: [4]u8 = [0xC2, 0x80, 0xDF, 0xBF];
    match validate_utf8(view(two_byte)) {
        Result.Ok(u) => {},
        Result.Err(e) => { return 2; }
    }

    // 3-byte boundaries: 0x800 (E0 A0 80) and 0xFFFF (EF BF BF)
    let three_byte: [6]u8 = [0xE0, 0xA0, 0x80, 0xEF, 0xBF, 0xBF];
    match validate_utf8(view(three_byte)) {
        Result.Ok(u) => {},
        Result.Err(e) => { return 3; }
    }

    // 4-byte boundaries: 0x10000 (F0 90 80 80) and max 0x10FFFF (F4 8F BF BF)
    let four_byte: [8]u8 = [0xF0, 0x90, 0x80, 0x80, 0xF4, 0x8F, 0xBF, 0xBF];
    match validate_utf8(view(four_byte)) {
        Result.Ok(u) => {},
        Result.Err(e) => { return 4; }
    }

    0
}

fn test_overlong_sequences() -> i32 {
    // 2-byte overlong: C0 AF
    let c0: [2]u8 = [0xC0, 0xAF];
    match validate_utf8(view(c0)) {
        Result.Ok(u) => { return 10; },
        Result.Err(e) => {}
    }

    // 2-byte overlong: C1 BF
    let c1: [2]u8 = [0xC1, 0xBF];
    match validate_utf8(view(c1)) {
        Result.Ok(u) => { return 11; },
        Result.Err(e) => {}
    }

    // 3-byte overlong: E0 80 AF
    let e0_1: [3]u8 = [0xE0, 0x80, 0xAF];
    match validate_utf8(view(e0_1)) {
        Result.Ok(u) => { return 12; },
        Result.Err(e) => {}
    }

    // 3-byte overlong: E0 9F BF
    let e0_2: [3]u8 = [0xE0, 0x9F, 0xBF];
    match validate_utf8(view(e0_2)) {
        Result.Ok(u) => { return 13; },
        Result.Err(e) => {}
    }

    // 4-byte overlong: F0 80 80 AF
    let f0_1: [4]u8 = [0xF0, 0x80, 0x80, 0xAF];
    match validate_utf8(view(f0_1)) {
        Result.Ok(u) => { return 14; },
        Result.Err(e) => {}
    }

    // 4-byte overlong: F0 8F BF BF
    let f0_2: [4]u8 = [0xF0, 0x8F, 0xBF, 0xBF];
    match validate_utf8(view(f0_2)) {
        Result.Ok(u) => { return 15; },
        Result.Err(e) => {}
    }

    0
}

fn test_surrogates() -> i32 {
    // 0xD800: ED A0 80
    let d800: [3]u8 = [0xED, 0xA0, 0x80];
    match validate_utf8(view(d800)) {
        Result.Ok(u) => { return 20; },
        Result.Err(e) => {}
    }

    // 0xDBFF: ED AF BF
    let dbff: [3]u8 = [0xED, 0xAF, 0xBF];
    match validate_utf8(view(dbff)) {
        Result.Ok(u) => { return 21; },
        Result.Err(e) => {}
    }

    // 0xDC00: ED B0 80
    let dc00: [3]u8 = [0xED, 0xB0, 0x80];
    match validate_utf8(view(dc00)) {
        Result.Ok(u) => { return 22; },
        Result.Err(e) => {}
    }

    // 0xDFFF: ED BF BF
    let dfff: [3]u8 = [0xED, 0xBF, 0xBF];
    match validate_utf8(view(dfff)) {
        Result.Ok(u) => { return 23; },
        Result.Err(e) => {}
    }

    0
}

fn test_out_of_range_and_truncated() -> i32 {
    // Out of range: 0x110000 -> F4 90 80 80
    let f4_oor: [4]u8 = [0xF4, 0x90, 0x80, 0x80];
    match validate_utf8(view(f4_oor)) {
        Result.Ok(u) => { return 30; },
        Result.Err(e) => {}
    }

    // Invalid prefix byte: F5
    let f5: [1]u8 = [0xF5];
    match validate_utf8(view(f5)) {
        Result.Ok(u) => { return 31; },
        Result.Err(e) => {}
    }

    // Truncated 2-byte: C2
    let trunc2: [1]u8 = [0xC2];
    match validate_utf8(view(trunc2)) {
        Result.Ok(u) => { return 32; },
        Result.Err(e) => {}
    }

    // Truncated 3-byte: E1 80
    let trunc3: [2]u8 = [0xE1, 0x80];
    match validate_utf8(view(trunc3)) {
        Result.Ok(u) => { return 33; },
        Result.Err(e) => {}
    }

    // Truncated 4-byte: F0 90 80
    let trunc4: [3]u8 = [0xF0, 0x90, 0x80];
    match validate_utf8(view(trunc4)) {
        Result.Ok(u) => { return 34; },
        Result.Err(e) => {}
    }

    // Lone continuation byte: 0x90
    let lone: [1]u8 = [0x90];
    match validate_utf8(view(lone)) {
        Result.Ok(u) => { return 35; },
        Result.Err(e) => {}
    }

    0
}

fn main() -> i32 {
    let r1 = test_valid_boundaries();
    if r1 != 0 { return r1; }

    let r2 = test_overlong_sequences();
    if r2 != 0 { return r2; }

    let r3 = test_surrogates();
    if r3 != 0 { return r3; }

    let r4 = test_out_of_range_and_truncated();
    if r4 != 0 { return r4; }

    print("OK Utf8Validation\n");
    return 0;
}
