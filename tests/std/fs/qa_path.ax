// test: run
// timeout: 30
// stdout: OK Path\n

use std.core.option.Option;
use std.core.host.heap_alloc;
use std.core.host.heap_free;

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    HeapAlloc(h, 8u32, size)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

struct DropGlue {}

pub struct String {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl Drop for String {
    fn drop(self: mut_view<String>) {
        if self.ptr as usize != 0 {
            unsafe {
                heap_free(self.ptr, self.cap, 8);
            }
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn string_new() -> String {
    String {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
        _glue: DropGlue {},
    }
}

pub fn string_with_capacity(capacity: usize) -> String {
    if capacity == 0 {
        return string_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    String {
        ptr: raw as *mut u8,
        len: 0,
        cap: capacity,
        _glue: DropGlue {},
    }
}

pub fn string_from_bytes(bytes: view<[u8]>) -> String {
    let n = len(bytes);
    if n == 0 {
        return string_new();
    }
    let mut s = string_with_capacity(n);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(s.ptr + i) = bytes[i];
        }
        i = i + 1;
    }
    s.len = n;
    s
}

fn is_separator(c: u8) -> bool {
    c == 47u8 || c == 92u8
}

fn has_root(p: view<[u8]>) -> bool {
    let n = len(p);
    if n == 0 { return false; }
    if is_separator(p[0]) { return true; }
    if n >= 3 && p[1] == 58u8 && is_separator(p[2]) { return true; }
    false
}

fn is_absolute(p: view<[u8]>) -> bool {
    has_root(p)
}

fn is_relative(p: view<[u8]>) -> bool {
    !has_root(p)
}

fn file_name(path: view<[u8]>) -> Option<String> {
    let n = len(path);
    if n == 0 { return Option.None; }
    let mut end = n;
    while end > 0 && is_separator(path[end - 1]) {
        end = end - 1;
    }
    if end == 0 { return Option.None; }
    if end == 2 && path[1] == 58u8 { return Option.None; }
    let mut i = end;
    while i > 0 {
        i = i - 1;
        if is_separator(path[i]) {
            return Option.Some(string_from_bytes(path[(i + 1)..end]));
        }
    }
    Option.Some(string_from_bytes(path[0..end]))
}

fn parent(path: view<[u8]>) -> Option<String> {
    let n = len(path);
    if n == 0 { return Option.None; }
    let mut end = n;
    while end > 0 && is_separator(path[end - 1]) {
        end = end - 1;
    }
    if end == 0 { return Option.None; }
    if end == 2 && path[1] == 58u8 { return Option.None; }
    let mut i = end;
    let mut found = false;
    let mut sep_pos: usize = 0;
    while i > 0 {
        i = i - 1;
        if is_separator(path[i]) {
            sep_pos = i;
            found = true;
            break;
        }
    }
    if !found {
        return Option.None;
    }
    if sep_pos == 0 {
        return Option.Some(string_from_bytes(path[0..1]));
    }
    if sep_pos == 2 && path[1] == 58u8 {
        return Option.Some(string_from_bytes(path[0..3]));
    }
    let mut p_end = sep_pos;
    while p_end > 0 && is_separator(path[p_end - 1]) {
        p_end = p_end - 1;
    }
    if p_end == 0 {
        return Option.Some(string_from_bytes(path[0..1]));
    }
    Option.Some(string_from_bytes(path[0..p_end]))
}

fn extension(path: view<[u8]>) -> Option<String> {
    let fname = match file_name(path) {
        Option.Some(name) => name,
        Option.None => return Option.None,
    };
    let flen = fname.len;
    if flen == 0 { return Option.None; }
    let mut i = flen;
    let mut dot_idx: usize = 0;
    let mut found_dot = false;
    while i > 0 {
        i = i - 1;
        let b = unsafe { *(fname.ptr + i) };
        if b == 46u8 { // '.'
            dot_idx = i;
            found_dot = true;
            break;
        }
    }
    if !found_dot || dot_idx == 0 || dot_idx == flen - 1 {
        return Option.None;
    }
    let mut ext = string_with_capacity(flen - (dot_idx + 1));
    let mut j = dot_idx + 1;
    while j < flen {
        let b = unsafe { *(fname.ptr + j) };
        unsafe { *(ext.ptr + (j - (dot_idx + 1))) = b; }
        j = j + 1;
    }
    ext.len = flen - (dot_idx + 1);
    Option.Some(ext)
}

fn join(base: view<[u8]>, next: view<[u8]>) -> String {
    let blen = len(base);
    let nlen = len(next);
    if blen == 0 {
        return string_from_bytes(next);
    }
    if nlen == 0 {
        return string_from_bytes(base);
    }
    if is_absolute(next) {
        return string_from_bytes(next);
    }
    let mut add_sep = false;
    if !is_separator(base[blen - 1]) {
        add_sep = true;
    }
    let mut extra: usize = 0;
    if add_sep {
        extra = 1;
    }
    let mut res = string_with_capacity(blen + extra + nlen);
    let mut i: usize = 0;
    while i < blen {
        unsafe { *(res.ptr + i) = base[i]; }
        i = i + 1;
    }
    if add_sep {
        unsafe { *(res.ptr + i) = 92u8; } // '\\'
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < nlen {
        unsafe { *(res.ptr + i + j) = next[j]; }
        j = j + 1;
    }
    res.len = blen + extra + nlen;
    res
}

fn normalize(path: view<[u8]>) -> String {
    let n = len(path);
    if n == 0 {
        return string_new();
    }
    let mut res = string_with_capacity(n);
    let mut i: usize = 0;
    let mut out_len: usize = 0;
    let mut last_was_sep = false;
    while i < n {
        let b = path[i];
        if is_separator(b) {
            if !last_was_sep {
                unsafe { *(res.ptr + out_len) = 92u8; }
                out_len = out_len + 1;
                last_was_sep = true;
            }
        } else {
            unsafe { *(res.ptr + out_len) = b; }
            out_len = out_len + 1;
            last_was_sep = false;
        }
        i = i + 1;
    }
    res.len = out_len;
    res
}

fn string_eq_bytes(s: view<String>, b: view<[u8]>) -> bool {
    if s.len != len(b) { return false; }
    let mut i: usize = 0;
    while i < s.len {
        let bs = unsafe { *(s.ptr + i) };
        if bs != b[i] { return false; }
        i = i + 1;
    }
    true
}

fn is_some_eq(opt: Option<String>, expected: view<[u8]>) -> bool {
    match opt {
        Option.Some(s) => string_eq_bytes(view(s), expected),
        Option.None => false,
    }
}

fn is_none(opt: Option<String>) -> bool {
    match opt {
        Option.Some(_) => false,
        Option.None => true,
    }
}

fn main() -> i32 {
    // 1. Separators
    if !is_separator(47u8) { return 1; }
    if !is_separator(92u8) { return 2; }
    if is_separator(97u8) { return 3; }

    // 2. has_root, is_absolute, is_relative
    let p_c_foo: [10]u8 = [67u8, 58u8, 92u8, 102u8, 111u8, 111u8, 92u8, 98u8, 97u8, 114u8]; // "C:\foo\bar"
    if !has_root(view(p_c_foo)) { return 4; }
    let p_c_slash: [10]u8 = [67u8, 58u8, 47u8, 102u8, 111u8, 111u8, 47u8, 98u8, 97u8, 114u8]; // "C:/foo/bar"
    if !has_root(view(p_c_slash)) { return 5; }
    let p_unc: [15]u8 = [92u8, 92u8, 115u8, 101u8, 114u8, 118u8, 101u8, 114u8, 92u8, 115u8, 104u8, 97u8, 114u8, 101u8, 0u8];
    if !has_root(view(p_unc)) { return 6; }
    let p_lin: [11]u8 = [47u8, 108u8, 105u8, 110u8, 117u8, 120u8, 47u8, 114u8, 111u8, 111u8, 116u8]; // "/linux/root"
    if !has_root(view(p_lin)) { return 7; }
    let p_rel: [13]u8 = [114u8, 101u8, 108u8, 97u8, 116u8, 105u8, 118u8, 101u8, 92u8, 112u8, 97u8, 116u8, 104u8]; // "relative\path"
    if has_root(view(p_rel)) { return 8; }
    let p_rel2: [13]u8 = [114u8, 101u8, 108u8, 97u8, 116u8, 105u8, 118u8, 101u8, 47u8, 112u8, 97u8, 116u8, 104u8]; // "relative/path"
    if has_root(view(p_rel2)) { return 9; }
    let p_crel: [10]u8 = [67u8, 58u8, 114u8, 101u8, 108u8, 97u8, 116u8, 105u8, 118u8, 101u8]; // "C:relative"
    if has_root(view(p_crel)) { return 10; }
    let p_empty: [0]u8 = [];
    if has_root(view(p_empty)) { return 11; }

    let p_abs: [20]u8 = [67u8, 58u8, 92u8, 119u8, 105u8, 110u8, 100u8, 111u8, 119u8, 115u8, 92u8, 115u8, 121u8, 115u8, 116u8, 101u8, 109u8, 51u8, 50u8, 0u8];
    if !is_absolute(view(p_abs)) { return 12; }
    if is_relative(view(p_abs)) { return 13; }
    if is_absolute(view(p_rel)) { return 14; }
    if !is_relative(view(p_rel)) { return 15; }

    // 3. file_name
    let p_file: [14]u8 = [67u8, 58u8, 92u8, 102u8, 111u8, 111u8, 92u8, 98u8, 97u8, 114u8, 46u8, 116u8, 120u8, 116u8]; // "C:\foo\bar.txt"
    let exp_bar: [7]u8 = [98u8, 97u8, 114u8, 46u8, 116u8, 120u8, 116u8]; // "bar.txt"
    if !is_some_eq(file_name(view(p_file)), view(exp_bar)) { return 16; }

    let p_trailing: [6]u8 = [97u8, 92u8, 98u8, 92u8, 99u8, 92u8]; // "a\b\c\"
    let exp_c: [1]u8 = [99u8]; // "c"
    if !is_some_eq(file_name(view(p_trailing)), view(exp_c)) { return 19; }

    let p_root: [3]u8 = [67u8, 58u8, 92u8]; // "C:\"
    if !is_none(file_name(view(p_root))) { return 20; }
    if !is_none(file_name(view(p_empty))) { return 21; }

    // 4. parent
    let exp_parent: [6]u8 = [67u8, 58u8, 92u8, 102u8, 111u8, 111u8]; // "C:\foo"
    if !is_some_eq(parent(view(p_file)), view(exp_parent)) { return 22; }

    let p_c_trailing: [7]u8 = [67u8, 58u8, 92u8, 102u8, 111u8, 111u8, 92u8]; // "C:\foo\"
    if !is_some_eq(parent(view(p_c_trailing)), view(p_root)) { return 24; }
    if !is_none(parent(view(p_empty))) { return 26; }

    // 5. extension
    let exp_txt: [3]u8 = [116u8, 120u8, 116u8]; // "txt"
    if !is_some_eq(extension(view(p_file)), view(exp_txt)) { return 27; }

    let p_tar_gz: [14]u8 = [97u8, 114u8, 99u8, 104u8, 105u8, 118u8, 101u8, 46u8, 116u8, 97u8, 114u8, 46u8, 103u8, 122u8]; // "archive.tar.gz"
    let exp_gz: [2]u8 = [103u8, 122u8]; // "gz"
    if !is_some_eq(extension(view(p_tar_gz)), view(exp_gz)) { return 28; }

    let p_no_ext: [6]u8 = [110u8, 111u8, 95u8, 101u8, 120u8, 116u8]; // "no_ext"
    if !is_none(extension(view(p_no_ext))) { return 29; }

    let p_dotgit: [10]u8 = [46u8, 103u8, 105u8, 116u8, 105u8, 103u8, 110u8, 111u8, 114u8, 101u8]; // ".gitignore"
    if !is_none(extension(view(p_dotgit))) { return 30; }

    // 6. join
    let j_base: [6]u8 = [67u8, 58u8, 92u8, 102u8, 111u8, 111u8]; // "C:\foo"
    let j_next: [7]u8 = [98u8, 97u8, 114u8, 46u8, 116u8, 120u8, 116u8]; // "bar.txt"
    let j_res1 = join(view(j_base), view(j_next));
    if j_res1.len != 14 { return 35; }
    if !string_eq_bytes(view(j_res1), view(p_file)) {
        let b0 = unsafe { *(j_res1.ptr) };
        if b0 != 67u8 { return 36; }
        let b6 = unsafe { *(j_res1.ptr + 6) };
        if b6 != 92u8 { return 37; }
        return 31;
    }

    let j_res2 = join(view(p_c_trailing), view(j_next));
    if !string_eq_bytes(view(j_res2), view(p_file)) { return 32; }

    let j_res3 = join(view(j_base), view(p_file)); // abs next replaces base
    if !string_eq_bytes(view(j_res3), view(p_file)) { return 33; }

    // 7. normalize
    let n_mixed: [11]u8 = [102u8, 111u8, 111u8, 47u8, 98u8, 97u8, 114u8, 92u8, 98u8, 97u8, 122u8]; // "foo/bar\baz"
    let n_exp: [11]u8 = [102u8, 111u8, 111u8, 92u8, 98u8, 97u8, 114u8, 92u8, 98u8, 97u8, 122u8]; // "foo\bar\baz"
    let n_res = normalize(view(n_mixed));
    if !string_eq_bytes(view(n_res), view(n_exp)) { return 34; }

    print("OK Path\n");
    return 0;
}
