// test: run
// timeout: 30
// stdout: OK TimeClock\n

use std.core.host.monotonic_ns;

@link("kernel32")
extern "system" {
    fn QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> i32;
    fn QueryPerformanceFrequency(lpFrequency: *mut i64) -> i32;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn __ax_host_monotonic_ns() -> u64 {
    let mut count: [1]i64 = [0i64];
    let mut freq: [1]i64 = [0i64];
    let ok1 = unsafe { QueryPerformanceCounter(address_of_mut(count[0])) };
    let ok2 = unsafe { QueryPerformanceFrequency(address_of_mut(freq[0])) };
    if ok1 == 0 || ok2 == 0 {
        return 0u64;
    }
    let f = freq[0] as u64;
    let c = count[0] as u64;
    if f == 0u64 {
        return 0u64;
    }
    let s = c / f;
    let rem = c % f;
    s * 1_000_000_000u64 + (rem * 1_000_000_000u64) / f
}

struct Duration {
    nanos: u64,
}

fn duration_from_nanos(nanos: u64) -> Duration {
    Duration { nanos: nanos }
}

fn duration_from_millis(millis: u64) -> Duration {
    Duration { nanos: millis * 1_000_000u64 }
}

fn duration_from_secs(secs: u64) -> Duration {
    Duration { nanos: secs * 1_000_000_000u64 }
}

fn duration_as_nanos(d: view<Duration>) -> u64 {
    d.nanos
}

fn duration_as_millis(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000u64
}

fn duration_as_secs(d: view<Duration>) -> u64 {
    d.nanos / 1_000_000_000u64
}

struct Instant {
    nanos: u64,
}

fn instant_now() -> Instant {
    let t: u64 = monotonic_ns();
    Instant { nanos: t }
}

fn instant_duration_since(a: view<Instant>, earlier: view<Instant>) -> Duration {
    if a.nanos >= earlier.nanos {
        Duration { nanos: a.nanos - earlier.nanos }
    } else {
        Duration { nanos: 0u64 }
    }
}

fn instant_elapsed(a: view<Instant>) -> Duration {
    let now = instant_now();
    instant_duration_since(view(now), a)
}

fn main() -> i32 {
    let t1 = instant_now();
    let mut i: usize = 0;
    let mut dummy: u64 = 0;
    while i < 10000 {
        dummy = dummy + 1;
        i = i + 1;
    }
    let t2 = instant_now();

    // Verify non-negative differences
    if t1.nanos > t2.nanos {
        return 1;
    }
    let diff = instant_duration_since(view(t2), view(t1));
    if duration_as_nanos(view(diff)) > 100_000_000_000u64 {
        return 2;
    }

    // Test Duration helpers
    let d_100ms = duration_from_millis(100u64);
    if duration_as_millis(view(d_100ms)) != 100u64 {
        return 3;
    }
    if duration_as_nanos(view(d_100ms)) != 100_000_000u64 {
        return 4;
    }

    let d_2s = duration_from_secs(2u64);
    if duration_as_secs(view(d_2s)) != 2u64 {
        return 5;
    }
    if duration_as_millis(view(d_2s)) != 2000u64 {
        return 6;
    }

    // 50 ms busy loop measuring between 20 and 2000 ms
    let start = instant_now();
    let mut dummy2: u64 = 0;
    let mut now = instant_now();
    while 50_000_000u64 > now.nanos - start.nanos {
        dummy2 = dummy2 + 1;
        now = instant_now();
    }
    let elapsed = instant_duration_since(view(now), view(start));
    let elapsed_ms = duration_as_millis(view(elapsed));
    if 20u64 > elapsed_ms || elapsed_ms > 2000u64 {
        return 7;
    }

    print("OK TimeClock\n");
    return 0;
}
