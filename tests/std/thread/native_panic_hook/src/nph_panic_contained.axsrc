module main

use std.thread.spawn

@intrinsic fn panic(msg: str) {}

// T538: with the panic hook registered by the thread runtime, a panic on a spawned thread still makes
// join return Err (twice, so the hook stays registered after the first contained panic), a healthy
// thread still joins Ok, and a panic on the main thread still ends the process with exit code 101.
pub fn main() -> i32 {
    let a = spawn(|| -> i64 {
        panic("nph_panic_contained first");
        1i64
    });
    let av = match a.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };
    let g = spawn(|| -> i64 { 4i64 + 5i64 });
    let gv = match g.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -2i64,
    };
    let b = spawn(|| -> i64 {
        panic("nph_panic_contained second");
        2i64
    });
    let bv = match b.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };
    print("OK nph_panic_contained ");
    print_int(av);
    print(" ");
    print_int(gv);
    print(" ");
    print_int(bv);
    print("\n");
    panic("nph_panic_contained main");
    0
}
