module main

use std.thread.spawn

@intrinsic fn panic(msg: str) {}

// Direct FFI: this test is native-only (ADR-0002).
@link("kernel32")
extern "system" {
    fn ExitProcess(uExitCode: u32);
}

// T538: a panic on a spawned thread is contained by the thread runtime's panic hook (join returns
// Err), but a user ExitProcess(101) on a spawned thread is a plain process exit: the process ends with
// 101 while the main thread is still in join, so "not reached" is never printed.
pub fn main() -> i32 {
    let p = spawn(|| -> i64 {
        panic("nph_exit101_thread boom");
        5i64
    });
    let pv = match p.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };
    print("contained ");
    print_int(pv);
    print("\n");
    let ex = spawn(|| -> i64 {
        unsafe { ExitProcess(101u32); }
        7i64
    });
    let ev = match ex.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };
    print("not reached ");
    print_int(ev);
    print("\n");
    0
}
