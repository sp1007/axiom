// test: run
// exit: 0
// stdout: abi=ok\nxmm_live=ok\ncmp=ok\nf2i=ok\ni2f=ok\nfrem=ok\nALL OK\n

// T459 QA adversarial three-mode (interp == native -O0 == native -O1) parity test:
// - Win64 mixed GPR+XMM positional args (0..3 in RCX/XMM0..R9/XMM3, stack args >= 4), XMM0 return
// - XMM6..XMM15 callee-saved values live across nested calls at -O1
// - UCOMISS/UCOMISD unordered NaN (PF=1) for all 6 comparisons and -0.0 vs +0.0
// - Saturating FloatToInt across i8..i128, u8..u128, isize, usize (NaN, +-inf, out-of-range)
// - Unsigned u64/u128 & signed i128 -> f32/f64 round-to-nearest-even (high-bit >= 2^63, ties-to-even)
// - Large-quotient % (FPREM C2=1 multi-iteration loop for f64 and f32, signed-zero & special cases)

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn to_bits64(x: f64) -> u64 {
    let v = x;
    unsafe { *(address_of(v) as *const u64) }
}

fn from_bits64(b: u64) -> f64 {
    let v = b;
    unsafe { *(address_of(v) as *const f64) }
}

fn to_bits32(x: f32) -> u32 {
    let v = x;
    unsafe { *(address_of(v) as *const u32) }
}

fn from_bits32(b: u32) -> f32 {
    let v = b;
    unsafe { *(address_of(v) as *const f32) }
}

fn chk64(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got=");
    print_int(got as i64);
    print(" want=");
    print_int(want as i64);
    print("\n");
    1
}

fn chk_bool(id: i32, got: bool, want: bool) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL_BOOL ");
    print_int(id as i64);
    print("\n");
    1
}

// Mixed GPR+XMM positional args (0..3 in RCX, XMM1, R8, XMM3; 4..7 on stack).
fn mix8(a: i32, b: f64, c: u16, d: f32, e: f64, f: f32, g: i64, h: f64) -> f64 {
    (a as f64) * 100.0 + b * 10.0 + (c as f64) + (d as f64) * 0.5 + e * 2.0 + (f as f64) * 4.0 + (g as f64) * 8.0 + h * 16.0
}

fn mix_ret32(a: f32, b: i32, c: f32, d: i64, e: f32, f: f64) -> f32 {
    a + (b as f32) * 2.0f32 + c * 4.0f32 + (d as f32) * 8.0f32 + e * 16.0f32 + (f as f32) * 32.0f32
}

// Nested callee that touches many floats and stack args to pressure XMM registers.
fn clobber_inner(n: i32, seed: f64) -> f64 {
    if n <= 0 {
        return mix8(1, seed, 2u16, 0.5f32, 1.25, -0.25f32, 3i64, 0.125);
    }
    let t0 = seed + 1.5;
    let t1 = seed * 0.5;
    let t2 = mix_ret32(1.0f32, n, 0.5f32, 2i64, 0.25f32, t0) as f64;
    let sub = clobber_inner(n - 1, t1);
    sub + t0 - t1 + t2 * 0.125
}

// Keep 12 live float values (10 f64 + 2 f32) across multiple nested calls.
fn test_xmm_live_across_calls(base: f64) -> i32 {
    let v0 = base + 1.0;
    let v1 = base + 2.0;
    let v2 = base + 3.0;
    let v3 = base + 4.0;
    let v4 = base + 5.0;
    let v5 = base + 6.0;
    let v6 = base + 7.0;
    let v7 = base + 8.0;
    let v8 = base + 9.0;
    let v9 = base + 10.0;
    let s0 = (base as f32) + 0.5f32;
    let s1 = (base as f32) - 0.25f32;

    let r1 = clobber_inner(3, v0);
    let r2 = clobber_inner(2, v5);
    let r3 = mix_ret32(s0, 4, s1, 5i64, 0.75f32, v9);

    let mut f = 0;
    f = f + chk64(201, to_bits64(v0), to_bits64(base + 1.0));
    f = f + chk64(202, to_bits64(v1), to_bits64(base + 2.0));
    f = f + chk64(203, to_bits64(v2), to_bits64(base + 3.0));
    f = f + chk64(204, to_bits64(v3), to_bits64(base + 4.0));
    f = f + chk64(205, to_bits64(v4), to_bits64(base + 5.0));
    f = f + chk64(206, to_bits64(v5), to_bits64(base + 6.0));
    f = f + chk64(207, to_bits64(v6), to_bits64(base + 7.0));
    f = f + chk64(208, to_bits64(v7), to_bits64(base + 8.0));
    f = f + chk64(209, to_bits64(v8), to_bits64(base + 9.0));
    f = f + chk64(210, to_bits64(v9), to_bits64(base + 10.0));
    f = f + chk64(211, to_bits32(s0) as u64, to_bits32((base as f32) + 0.5f32) as u64);
    f = f + chk64(212, to_bits32(s1) as u64, to_bits32((base as f32) - 0.25f32) as u64);
    // Ensure r1, r2, r3 are observed and finite.
    f = f + chk_bool(213, r1 == r1 && r2 == r2 && r3 == r3, true);
    f
}

fn test_abi() -> i32 {
    let mut f = 0;
    // 2*100 + 3.5*10 + 4 + 2.0*0.5 + 1.5*2 + (-0.5)*4 + 1*8 + 0.25*16 = 200+35+4+1+3-2+8+4 = 253.0
    let a = mix8(2, 3.5, 4u16, 2.0f32, 1.5, -0.5f32, 1i64, 0.25);
    f = f + chk64(101, to_bits64(a), to_bits64(253.0));
    // Indirect function pointer call with mixed GPR+XMM+stack args
    let fp: fn(i32, f64, u16, f32, f64, f32, i64, f64) -> f64 = mix8;
    let b = fp(2, 3.5, 4u16, 2.0f32, 1.5, -0.5f32, 1i64, 0.25);
    f = f + chk64(102, to_bits64(b), to_bits64(253.0));
    // 1.0 + 2*2 + 0.5*4 + 1*8 + 0.25*16 + 0.125*32 = 1+4+2+8+4+4 = 23.0f32
    let c = mix_ret32(1.0f32, 2, 0.5f32, 1i64, 0.25f32, 0.125);
    f = f + chk64(103, to_bits32(c) as u64, to_bits32(23.0f32) as u64);
    f
}

fn test_cmp() -> i32 {
    let mut f = 0;
    let nan64 = from_bits64(0x7FF8000000000000u64);
    let pzero64 = from_bits64(0x0000000000000000u64);
    let nzero64 = from_bits64(0x8000000000000000u64);
    let one64 = 1.0;

    // f64 NaN unordered: all 6 predicates
    f = f + chk_bool(301, nan64 == one64, false);
    f = f + chk_bool(302, nan64 != one64, true);
    f = f + chk_bool(303, nan64 < one64, false);
    f = f + chk_bool(304, nan64 <= one64, false);
    f = f + chk_bool(305, nan64 > one64, false);
    f = f + chk_bool(306, nan64 >= one64, false);
    f = f + chk_bool(307, one64 == nan64, false);
    f = f + chk_bool(308, one64 != nan64, true);
    f = f + chk_bool(309, one64 < nan64, false);
    f = f + chk_bool(310, one64 <= nan64, false);
    f = f + chk_bool(311, one64 > nan64, false);
    f = f + chk_bool(312, one64 >= nan64, false);
    f = f + chk_bool(313, nan64 == nan64, false);
    f = f + chk_bool(314, nan64 != nan64, true);
    f = f + chk_bool(315, nan64 < nan64, false);
    f = f + chk_bool(316, nan64 <= nan64, false);
    f = f + chk_bool(317, nan64 > nan64, false);
    f = f + chk_bool(318, nan64 >= nan64, false);

    // f64 -0.0 vs +0.0
    f = f + chk_bool(319, nzero64 == pzero64, true);
    f = f + chk_bool(320, nzero64 != pzero64, false);
    f = f + chk_bool(321, nzero64 < pzero64, false);
    f = f + chk_bool(322, nzero64 <= pzero64, true);
    f = f + chk_bool(323, nzero64 > pzero64, false);
    f = f + chk_bool(324, nzero64 >= pzero64, true);

    // f32 NaN unordered and -0.0 vs +0.0
    let nan32 = from_bits32(0x7FC00000u32);
    let pzero32 = from_bits32(0x00000000u32);
    let nzero32 = from_bits32(0x80000000u32);
    let one32 = 1.0f32;

    f = f + chk_bool(331, nan32 == one32, false);
    f = f + chk_bool(332, nan32 != one32, true);
    f = f + chk_bool(333, nan32 < one32, false);
    f = f + chk_bool(334, nan32 <= one32, false);
    f = f + chk_bool(335, nan32 > one32, false);
    f = f + chk_bool(336, nan32 >= one32, false);
    f = f + chk_bool(337, nan32 == nan32, false);
    f = f + chk_bool(338, nan32 != nan32, true);
    f = f + chk_bool(339, nzero32 == pzero32, true);
    f = f + chk_bool(340, nzero32 != pzero32, false);
    f = f + chk_bool(341, nzero32 < pzero32, false);
    f = f + chk_bool(342, nzero32 <= pzero32, true);
    f = f + chk_bool(343, nzero32 > pzero32, false);
    f = f + chk_bool(344, nzero32 >= pzero32, true);
    f
}

fn test_float_to_int() -> i32 {
    let mut f = 0;
    let nan64 = from_bits64(0x7FF8000000000000u64);
    let pinf64 = from_bits64(0x7FF0000000000000u64);
    let ninf64 = from_bits64(0xFFF0000000000000u64);
    let p2_63_64 = from_bits64(0x43E0000000000000u64); // 2^63
    let n2_63_64 = from_bits64(0xC3E0000000000000u64); // -2^63
    let p2_64_64 = from_bits64(0x43F0000000000000u64); // 2^64
    let near_u64 = from_bits64(0x43EFFFFFFFFFFFFFu64); // 2^64 - 2048
    let p2_127_64 = from_bits64(0x47E0000000000000u64); // 2^127
    let n2_127_64 = from_bits64(0xC7E0000000000000u64); // -2^127
    let p2_128_64 = from_bits64(0x47F0000000000000u64); // 2^128

    // NaN -> 0 across widths
    f = f + chk64(401, (nan64 as i8) as i64 as u64, 0u64);
    f = f + chk64(402, (nan64 as u8) as u64, 0u64);
    f = f + chk64(403, (nan64 as i16) as i64 as u64, 0u64);
    f = f + chk64(404, (nan64 as u16) as u64, 0u64);
    f = f + chk64(405, (nan64 as i32) as i64 as u64, 0u64);
    f = f + chk64(406, (nan64 as u32) as u64, 0u64);
    f = f + chk64(407, (nan64 as i64) as u64, 0u64);
    f = f + chk64(408, nan64 as u64, 0u64);
    f = f + chk64(409, (nan64 as isize) as i64 as u64, 0u64);
    f = f + chk64(410, (nan64 as usize) as u64, 0u64);
    f = f + chk_bool(411, (nan64 as i128) == 0i128, true);
    f = f + chk_bool(412, (nan64 as u128) == 0u128, true);

    // +-inf saturation
    f = f + chk64(421, (pinf64 as i8) as i64 as u64, 127u64);
    f = f + chk64(422, (ninf64 as i8) as i64 as u64, (-128i64) as u64);
    f = f + chk64(423, (pinf64 as u8) as u64, 255u64);
    f = f + chk64(424, (ninf64 as u8) as u64, 0u64);
    f = f + chk64(425, (pinf64 as i32) as i64 as u64, 2147483647u64);
    f = f + chk64(426, (ninf64 as i32) as i64 as u64, (-2147483648i64) as u64);
    f = f + chk64(427, (pinf64 as u32) as u64, 4294967295u64);
    f = f + chk64(428, (ninf64 as u32) as u64, 0u64);
    f = f + chk64(429, (pinf64 as i64) as u64, 0x7FFFFFFFFFFFFFFFu64);
    f = f + chk64(430, (ninf64 as i64) as u64, 0x8000000000000000u64);
    f = f + chk64(431, pinf64 as u64, 0xFFFFFFFFFFFFFFFFu64);
    f = f + chk64(432, ninf64 as u64, 0u64);
    f = f + chk64(433, (pinf64 as isize) as i64 as u64, 0x7FFFFFFFFFFFFFFFu64);
    f = f + chk64(434, (pinf64 as usize) as u64, 0xFFFFFFFFFFFFFFFFu64);

    // Exact boundary values for i64 / u64
    f = f + chk64(441, (p2_63_64 as i64) as u64, 0x7FFFFFFFFFFFFFFFu64);
    f = f + chk64(442, (n2_63_64 as i64) as u64, 0x8000000000000000u64);
    f = f + chk64(443, p2_63_64 as u64, 0x8000000000000000u64);
    f = f + chk64(444, near_u64 as u64, 0xFFFFFFFFFFFFF800u64);
    f = f + chk64(445, p2_64_64 as u64, 0xFFFFFFFFFFFFFFFFu64);
    f = f + chk64(446, (-0.5) as u64, 0u64);
    f = f + chk64(447, (1e12) as u32 as u64, 4294967295u64);

    // i128 / u128 boundaries (f64 and f32)
    let i128_max: i128 = ((1u128 << 127) - 1u128) as i128;
    let i128_min: i128 = (1u128 << 127) as i128;
    let u128_max: u128 = ((1u128 << 127) - 1u128) | (1u128 << 127);
    f = f + chk_bool(451, (p2_127_64 as i128) == i128_max, true);
    f = f + chk_bool(452, (n2_127_64 as i128) == i128_min, true);
    f = f + chk_bool(453, (p2_127_64 as u128) == (1u128 << 127), true);
    f = f + chk_bool(454, (p2_128_64 as u128) == u128_max, true);
    f = f + chk_bool(455, (n2_63_64 as i128) == (-9223372036854775808i128), true);
    f = f + chk_bool(456, (0.99 as u128) == 0u128, true);

    let f32_max = from_bits32(0x7F7FFFFFu32);
    let f32_pinf = from_bits32(0x7F800000u32);
    let f32_nan = from_bits32(0x7FC00000u32);
    let want_f32_max_u128: u128 = (0xFFFFFF0000000000u64 as u128) << 64;
    f = f + chk_bool(461, (f32_max as u128) == want_f32_max_u128, true);
    f = f + chk_bool(462, (f32_pinf as u128) == u128_max, true);
    f = f + chk_bool(463, (f32_nan as u128) == 0u128, true);
    f = f + chk_bool(464, (f32_nan as i128) == 0i128, true);
    f
}

fn test_int_to_float() -> i32 {
    let mut f = 0;
    // u64 >= 2^63 round-to-nearest-even ties
    let u_base: u64 = 0x8000000000000000u64;
    let u_tie0: u64 = 0x8000000000000400u64; // exact tie -> even (2^63)
    let u_tie1: u64 = 0x8000000000000401u64; // above tie -> up (2^63 + 2048)
    let u_tie2: u64 = 0x8000000000000C00u64; // exact tie -> even (2^63 + 4096)
    let u_max: u64 = 0xFFFFFFFFFFFFFFFFu64;

    f = f + chk64(501, to_bits64(u_base as f64), 0x43E0000000000000u64);
    f = f + chk64(502, to_bits64(u_tie0 as f64), 0x43E0000000000000u64);
    f = f + chk64(503, to_bits64(u_tie1 as f64), 0x43E0000000000001u64);
    f = f + chk64(504, to_bits64(u_tie2 as f64), 0x43E0000000000002u64);
    f = f + chk64(505, to_bits64(u_max as f64), 0x43F0000000000000u64);
    f = f + chk64(506, to_bits32(u_max as f32) as u64, 0x5F800000u64);

    // u128 / i128 -> f32 / f64
    let u128_max: u128 = ((1u128 << 127) - 1u128) | (1u128 << 127);
    let i128_min: i128 = (1u128 << 127) as i128;
    f = f + chk64(511, to_bits32(u128_max as f32) as u64, 0x7F800000u64); // +inf
    f = f + chk64(512, to_bits64(u128_max as f64), 0x47F0000000000000u64); // 2^128
    f = f + chk64(513, to_bits32(i128_min as f32) as u64, 0xFF000000u64); // -2^127
    f = f + chk64(514, to_bits64(i128_min as f64), 0xC7E0000000000000u64); // -2^127
    f
}

fn test_frem() -> i32 {
    let mut f = 0;
    // Large-quotient % forcing x87 FPREM C2=1 multi-iteration loop
    let r1 = 1e20 % 3.0;
    let r2 = (-1e20) % 3.0;
    let r3 = 1e100 % 7.0;
    let r4 = 1e30f32 % 7.0f32;
    let r5 = (-4.0) % 2.0; // -0.0 sign preserved
    let pinf64 = from_bits64(0x7FF0000000000000u64);
    let r6 = 1.5 % pinf64;
    let r7 = 1.5 % 0.0;
    let r8 = pinf64 % 2.0;

    f = f + chk64(601, to_bits64(r1), 0x3FF0000000000000u64);
    f = f + chk64(602, to_bits64(r2), 0xBFF0000000000000u64);
    f = f + chk64(603, to_bits64(r3), 0x4000000000000000u64);
    f = f + chk64(604, to_bits32(r4) as u64, 0x3F800000u64);
    f = f + chk64(605, to_bits64(r5), 0x8000000000000000u64);
    f = f + chk64(606, to_bits64(r6), to_bits64(1.5));
    f = f + chk_bool(607, r7 != r7, true);
    f = f + chk_bool(608, r8 != r8, true);
    f
}

fn main() -> i32 {
    let mut total = 0;
    let a = test_abi();
    if a == 0 { print("abi=ok\n"); }
    total = total + a;

    let b = test_xmm_live_across_calls(12.25);
    if b == 0 { print("xmm_live=ok\n"); }
    total = total + b;

    let c = test_cmp();
    if c == 0 { print("cmp=ok\n"); }
    total = total + c;

    let d = test_float_to_int();
    if d == 0 { print("f2i=ok\n"); }
    total = total + d;

    let e = test_int_to_float();
    if e == 0 { print("i2f=ok\n"); }
    total = total + e;

    let g = test_frem();
    if g == 0 { print("frem=ok\n"); }
    total = total + g;

    if total == 0 {
        print("ALL OK\n");
    }
    total
}
