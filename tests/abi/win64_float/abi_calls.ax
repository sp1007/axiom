// test: helper
// T459: Windows x64 floating-point calling convention (SPEC-41 AXS-FLT-041, SPEC-04 AXS-EXT-052).
// Positional XMM0..XMM3 / RCX..R9 slots, f32/f64 stack arguments (8-byte slots, f32 in the low half),
// XMM0 returns, function pointers, by-value aggregates holding floats, recursion, and float values kept
// live across calls. Expected output: abi_calls.txt (computed by gen_expected.py, Python IEEE-754).
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn show64(x: f64) {
    print_int(unsafe { *(address_of(x) as *const i64) });
    print("\n");
}

fn show32(x: f32) {
    print_int((unsafe { *(address_of(x) as *const i32) }) as i64);
    print("\n");
}

// a -> ECX, b -> XMM1, c -> R8W, d -> XMM3, e -> [rsp+32]
fn mix(a: i32, b: f64, c: u16, d: f32, e: f64) -> f64 {
    (a as f64) * 1000.0 + b * 100.0 + (c as f64) * 10.0 + (d as f64) + e / 8.0
}

fn first_f32(x: f32, y: f32, z: f32, w: f32) -> f32 {
    x * 4.0f32 + y * 2.0f32 + z - w
}

// 10 arguments: f64/i64/f32/i32 in registers, the rest on the stack (f32 and u8 in 8-byte slots).
fn many(a: f64, b: i64, c: f32, d: i32, e: f64, f: f32, g: i64, h: f64, i: f32, j: u8) -> f64 {
    a + (b as f64) * 2.0 + (c as f64) * 3.0 + (d as f64) * 5.0 + e * 7.0 + (f as f64) * 11.0 +
        (g as f64) * 13.0 + h * 17.0 + (i as f64) * 19.0 + (j as f64) * 23.0
}

fn only_stack_floats(a: i64, b: i64, c: i64, d: i64, e: f32, f: f64, g: f32) -> f32 {
    (a + b + c + d) as f32 + e * 2.0f32 + (f as f32) * 4.0f32 + g * 8.0f32
}

fn fsum(n: i32, acc: f64) -> f64 {
    if n == 0 {
        return acc;
    }
    fsum(n - 1, acc + (n as f64) * 0.5)
}

struct Pt {
    x: f64,
    y: f32,
    tag: i32,
}

struct Pair32 {
    a: f32,
    b: f32,
}

fn scale_pt(p: Pt, k: f64) -> Pt {
    Pt { x: p.x * k, y: p.y * (k as f32), tag: p.tag + 1 }
}

fn swap_pair(p: Pair32) -> Pair32 {
    Pair32 { a: p.b, b: p.a }
}

fn negate(x: f64) -> f64 {
    -x
}

fn apply(f: fn(f64) -> f64, v: f64) -> f64 {
    f(v) + 1.0
}

fn churn(x: f64) -> f64 {
    let mut acc = x;
    let mut i = 0;
    while i < 10 {
        acc = acc * 1.5 - 0.25;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    show64(mix(3, 1.5, 7u16, 0.25f32, 0.5));
    show64(mix(-2, -0.125, 65535u16, -3.5f32, 1024.0));
    show32(first_f32(1.5f32, -2.25f32, 0.125f32, 8.0f32));
    show64(many(1.0, 2i64, 3.5f32, -4, 5.25, 6.5f32, -7i64, 8.125, 9.75f32, 200u8));
    show32(only_stack_floats(1i64, 2i64, 3i64, 4i64, 0.5f32, 0.75, -1.25f32));
    show64(fsum(40, 0.0));
    let p = scale_pt(Pt { x: 1.25, y: -0.5f32, tag: 41 }, 4.0);
    show64(p.x);
    show32(p.y);
    print_int(p.tag as i64);
    print("\n");
    let q = swap_pair(Pair32 { a: 1.5f32, b: -2.5f32 });
    show32(q.a);
    show32(q.b);
    let fp: fn(i32, f64, u16, f32, f64) -> f64 = mix;
    show64(fp(1, 2.0, 3u16, 4.0f32, 8.0));
    show64(apply(negate, 2.5));
    // Values live across calls must survive (XMM0..XMM5 are volatile; float vregs live in slots/GPRs).
    let keep_a = 3.75;
    let keep_b = -0.5f32;
    let c1 = churn(1.0);
    let c2 = churn(keep_a);
    show64(c1);
    show64(c2);
    show64(keep_a);
    show32(keep_b);
    show64(keep_a + (keep_b as f64) + c1);
    0
}
