// test: helper
// T459: Axiom side of the C <-> Axiom Windows x64 floating-point ABI oracle (xmm_interop_oracle.py).

@export
pub fn ax_mix(a: i32, b: f64, c: u16, d: f32, e: f64) -> f64 {
    (a as f64) * 1000.0 + b * 100.0 + (c as f64) * 10.0 + (d as f64) + e / 8.0
}

@export
pub fn ax_stack(a: f32, b: i64, c: f64, d: f32, e: f32, f: i32, g: f64, h: f32) -> f32 {
    a + (b as f32) * 2.0f32 + (c as f32) * 3.0f32 + d * 5.0f32 + e * 7.0f32 + (f as f32) * 11.0f32 +
        (g as f32) * 13.0f32 + h * 17.0f32
}

@export
pub fn ax_call_mix(cb: extern "C" fn(i32, f64, u16, f32, f64) -> f64) -> f64 {
    cb(3, 1.5, 7u16, 0.25f32, 0.5) + 1.0
}

@export
pub fn ax_call_f32(cb: extern "C" fn(f32, f32, i32, f32, f32, f64) -> f32, x: f32) -> f32 {
    cb(x, x + 1.0f32, 9, x * 2.0f32, x - 0.5f32, 6.25) * 2.0f32
}

// Many float values around a callback that clobbers every volatile XMM register.
@export
pub fn ax_live(cb: extern "C" fn(f64) -> f64, x: f64) -> f64 {
    let a = x + 1.0;
    let b = x * 2.0;
    let c = x - 3.0;
    let d = x / 4.0;
    (a * b - c * d) + (a + b) * (c + d) - ((a - d) * (b - c) + cb(x)) * ((a + c) - (b * d) + cb(a))
}

// Many float temporaries in one expression tree.
@export
pub fn ax_pressure(x: f64, y: f64) -> f64 {
    ((x + y) * (x - y) + ((x * y) - (x / y)) * ((x + 1.0) * (y + 2.0) - ((x - 3.0) * (y - 4.0) +
        ((x + 5.0) / (y + 6.0)) * ((x * 7.0) - (y * 8.0) * ((x + 9.0) - (y / 10.0))))))
}
