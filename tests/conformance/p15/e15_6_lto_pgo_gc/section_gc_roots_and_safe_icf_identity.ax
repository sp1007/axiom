// test: diff
// flags: --verify-each
// exit: 0
// stdout: 328\n369\n401\n

// E15.6 Conformance: Section GC dead stripping vs @export/table roots, Safe ICF
// distinct function-pointer identity under address comparison, and mutable/.bss
// static no-fold barrier (SPEC-75 §§5-7, AXS-PGO-009..012, REQ-OPT-246..250).

const LIVE_TABLE: [6]i64 = [11, 22, 33, 44, 55, 66];
const DEAD_TABLE: [4]i64 = [901, 902, 903, 904];

fn dead_unreferenced_helper(x: i64) -> i64 {
    DEAD_TABLE[(x & 3) as usize] + 777
}

@export
pub fn exported_abi_entry(a: i64, b: i64) -> i64 {
    a * 7 + b * 3
}

fn run_section_roots_and_export() -> i64 {
    let mut sum: i64 = 0;
    let mut i: usize = 0;
    while i < 6 {
        sum = sum + LIVE_TABLE[i];
        i = i + 1;
    }
    sum + exported_abi_entry(10, 9)
}

fn icf_fold_a(x: i64) -> i64 {
    (x * 5 + 17) ^ 3
}

fn icf_fold_b(x: i64) -> i64 {
    (x * 5 + 17) ^ 3
}

fn icf_addr_1(x: i64) -> i64 {
    (x + 19) * 3
}

fn icf_addr_2(x: i64) -> i64 {
    (x + 19) * 3
}

fn icf_addr_3(x: i64) -> i64 {
    (x + 19) * 3
}

fn invoke_addr_triple(
    p1: fn(i64) -> i64,
    p2: fn(i64) -> i64,
    p3: fn(i64) -> i64,
    a: i64,
    b: i64,
    c: i64
) -> i64 {
    p1(a) + p2(b) + p3(c) + 65
}

fn run_safe_icf_identity() -> i64 {
    let v_fold = icf_fold_a(6) + icf_fold_b(6);
    let p1: fn(i64) -> i64 = icf_addr_1;
    let p2: fn(i64) -> i64 = icf_addr_2;
    let p3: fn(i64) -> i64 = icf_addr_3;
    v_fold + invoke_addr_triple(p1, p2, p3, 4, 5, 6)
}

fn update_distinct_bss_pair(a: mut_view<i64>, b: mut_view<i64>) -> i64 {
    *a = 140;
    *b = 260;
    let distinct: i64 = if (*a) != (*b) { 1 } else { 0 };
    (*a) + (*b) + distinct
}

fn run_bss_mutable_barrier() -> i64 {
    let mut bss_counter_a: i64 = 0;
    let mut bss_counter_b: i64 = 0;
    update_distinct_bss_pair(mut_view(bss_counter_a), mut_view(bss_counter_b))
}

pub fn main() -> i32 {
    print_int(run_section_roots_and_export());
    print("\n");
    print_int(run_safe_icf_identity());
    print("\n");
    print_int(run_bss_mutable_barrier());
    print("\n");
    0
}
