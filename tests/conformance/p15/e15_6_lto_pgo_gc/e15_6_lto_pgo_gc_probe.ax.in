@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@PROBE_MIR_FN@

fn probe_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn make_bytes_8(arena: mut_view<Arena>, b0: u8, b1: u8, b2: u8, b3: u8, b4: u8, b5: u8, b6: u8, b7: u8) -> *mut u8 {
    let p = arena_alloc_raw(mut_view(*arena), 8, 1);
    unsafe {
        *gc_byte_at(p, 0) = b0;
        *gc_byte_at(p, 1) = b1;
        *gc_byte_at(p, 2) = b2;
        *gc_byte_at(p, 3) = b3;
        *gc_byte_at(p, 4) = b4;
        *gc_byte_at(p, 5) = b5;
        *gc_byte_at(p, 6) = b6;
        *gc_byte_at(p, 7) = b7;
    }
    p
}

fn probe_make_fn_item(arena: mut_view<Arena>, param_count: usize) -> *const HirItem {
    let it = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 });
    let mut head: *mut HirParam = 0 as *mut HirParam;
    let mut i: usize = 0;
    while i < param_count {
        let p = hir_alloc_param(mut_view(*arena), Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 });
        unsafe { (*p).next = head; }
        head = p;
        i = i + 1;
    }
    unsafe { (*it).params = head; }
    it as *const HirItem
}

// =============================================================================
// 1. LTO Contract, .axmeta Serialization Round-Trip & ThinLTO Digest Invalidation
// =============================================================================
fn probe_lto_contract_and_axmeta_summary() -> i32 {
    let c = lto_contract();
    if c.pass_id != PASS_LTO || c.pass_id != 18u16 ||
       c.preserved_analyses != ANALYSIS_MASK_CALL_GRAPH ||
       c.postconditions != POSTCOND_ALL ||
       LTO_MODE_OFF != 0u8 || LTO_MODE_THIN != 1u8 || LTO_MODE_FAT != 2u8 || LTO_MODE_FULL != 2u8 ||
       WORLD_CLOSED != 0u8 || WORLD_PARTIAL != 1u8 || WORLD_OPEN != 2u8 {
        return 101;
    }

    let mut arena = new_arena(131072);
    let ms1 = lto_module_summary_new(mut_view(arena), 7u32, StrId { v: 1u32 });
    let f30 = lto_fn_summary_default(SymbolId { v: 30u32 }, StrId { v: 30u32 }, 7u32, LTO_VIS_PUB);
    let f10 = lto_fn_summary_default(SymbolId { v: 10u32 }, StrId { v: 10u32 }, 7u32, LTO_VIS_EXPORTED);
    let f20 = lto_fn_summary_default(SymbolId { v: 20u32 }, StrId { v: 20u32 }, 7u32, LTO_VIS_PRIVATE);
    lto_module_summary_add_fn(unsafe { mut_view(*ms1) }, mut_view(arena), f30);
    lto_module_summary_add_fn(unsafe { mut_view(*ms1) }, mut_view(arena), f10);
    lto_module_summary_add_fn(unsafe { mut_view(*ms1) }, mut_view(arena), f20);

    let mut st1 = lto_static_summary_default(SymbolId { v: 90u32 }, 7u32, LTO_VIS_PUB);
    st1.has_const_init = true;
    st1.init_const_val = 0xCAFEBABEu64;
    lto_module_summary_add_static(unsafe { mut_view(*ms1) }, mut_view(arena), st1);

    let tr1 = LtoTraitImplRecord {
        trait_id: 3u32,
        concrete_type_id: 14u32,
        vtable_sym: SymbolId { v: 500u32 },
        method_sym: SymbolId { v: 20u32 },
        module_id: 7u32,
        is_coerced_to_dyn: true,
        is_live_vtable: true,
    };
    lto_module_summary_add_trait_impl(unsafe { mut_view(*ms1) }, mut_view(arena), tr1);

    let s0 = unsafe { (*lto_fn_at((*ms1).fns, 0)).fn_sym.v };
    let s1 = unsafe { (*lto_fn_at((*ms1).fns, 1)).fn_sym.v };
    let s2 = unsafe { (*lto_fn_at((*ms1).fns, 2)).fn_sym.v };
    let d1 = lto_compute_module_digest(unsafe { mut_view(*ms1) });
    if s0 != 10u32 || s1 != 20u32 || s2 != 30u32 || d1.lo == 0u64 || d1.hi == 0u64 || (unsafe { (*ms1).digest_64 }) != d1.lo {
        arena_destroy(mut_view(arena));
        return 102;
    }

    let mut byte_len: usize = 0;
    let bytes = lto_serialize_module_summary(unsafe { view(*ms1) }, mut_view(arena), mut_view(byte_len));
    if (bytes as usize) == 0 || byte_len <= 44 || (unsafe { *lto_u8_at(bytes, 0) }) != AXMETA_MAGIC_0 {
        arena_destroy(mut_view(arena));
        return 103;
    }

    let ms_rt = lto_deserialize_module_summary(bytes as *const u8, byte_len, mut_view(arena));
    if (ms_rt as usize) == 0 {
        arena_destroy(mut_view(arena));
        return 104;
    }
    let rt_d = unsafe { (*ms_rt).digest_128 };
    if !lto_digest128_eq(view(d1), view(rt_d)) ||
       (unsafe { (*ms_rt).fn_count }) != 3 ||
       (unsafe { (*ms_rt).static_count }) != 1 ||
       (unsafe { (*ms_rt).trait_impl_count }) != 1 ||
       (unsafe { (*lto_fn_at((*ms_rt).fns, 1)).fn_sym.v }) != 20u32 {
        arena_destroy(mut_view(arena));
        return 105;
    }

    unsafe { *lto_u8_at(bytes, 16) = (*lto_u8_at(bytes, 16)) ^ 0xFFu8; }
    let ms_tampered = lto_deserialize_module_summary(bytes as *const u8, byte_len, mut_view(arena));
    unsafe { *lto_u8_at(bytes, 0) = 0u8; }
    let ms_bad_magic = lto_deserialize_module_summary(bytes as *const u8, byte_len, mut_view(arena));
    if (ms_tampered as usize) != 0 || (ms_bad_magic as usize) != 0 {
        arena_destroy(mut_view(arena));
        return 106;
    }

    let d_same = LtoDigest128 { lo: d1.lo, hi: d1.hi };
    let d_diff_hi = LtoDigest128 { lo: d1.lo, hi: d1.hi ^ 1u64 };
    if lto_thin_partition_needs_rebuild(view(d1), view(d_same), 0x1234u64, 0x1234u64) ||
       !lto_thin_partition_needs_rebuild(view(d1), view(d_diff_hi), 0x1234u64, 0x1234u64) ||
       !lto_thin_partition_needs_rebuild(view(d1), view(d_same), 0x1234u64, 0x5678u64) {
        arena_destroy(mut_view(arena));
        return 107;
    }
    print("PROBE_E15_6_LTO_AXMETA_AND_THIN_DIGESTS=OK\n");
    arena_destroy(mut_view(arena));
    0
}

// =============================================================================
// 2. Closed-World Reachability, Cross-Module OptIR Optimization & Generic Dedup
// =============================================================================
fn probe_lto_reachability_cross_mod_and_dedup() -> i32 {
    let mut arena = new_arena(1048576);
    let mut stats = lto_stats_zero();

    // 2a. Open-world keeps `pub` symbols global (`ALTO-22`, `REQ-OPT-266`)
    let wpo_open = lto_wpo_new(mut_view(arena), 0 as *mut CallGraph, LTO_MODE_THIN, WORLD_OPEN);
    let ms_open = lto_module_summary_new(mut_view(arena), 1u32, StrId { v: 1u32 });
    lto_module_summary_add_fn(
        unsafe { mut_view(*ms_open) },
        mut_view(arena),
        lto_fn_summary_default(SymbolId { v: 11u32 }, StrId { v: 11u32 }, 1u32, LTO_VIS_PUB)
    );
    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo_open) }, ms_open, mut_view(arena), mut_view(stats));
    let open_int = lto_internalize_symbols(unsafe { mut_view(*wpo_open) }, mut_view(stats));
    let open_link = unsafe { (*lto_fn_at((*wpo_open).fns, 0)).linkage };
    if open_int != 0u32 || open_link != LTO_LINKAGE_GLOBAL {
        arena_destroy(mut_view(arena));
        return 201;
    }

    // 2b. Closed-world reachability, roots (`Entry`, `@export`, `FfiCallback`, `Reflection`, `PinnedAt`), and dead pruning
    let mut stats_closed = lto_stats_zero();
    let wpo_reach = lto_wpo_new(mut_view(arena), 0 as *mut CallGraph, LTO_MODE_FAT, WORLD_CLOSED);
    let mod1 = lto_module_summary_new(mut_view(arena), 1u32, StrId { v: 1u32 });
    let mod2 = lto_module_summary_new(mut_view(arena), 2u32, StrId { v: 1u32 });

    lto_module_summary_add_fn(unsafe { mut_view(*mod1) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 1u32 }, StrId { v: 1u32 }, 1u32, LTO_VIS_PUB));
    lto_module_summary_add_fn(unsafe { mut_view(*mod1) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 2u32 }, StrId { v: 2u32 }, 1u32, LTO_VIS_EXPORTED));
    lto_module_summary_add_fn(unsafe { mut_view(*mod1) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 3u32 }, StrId { v: 3u32 }, 1u32, LTO_VIS_PRIVATE));
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 4u32 }, StrId { v: 4u32 }, 2u32, LTO_VIS_PUB));
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 5u32 }, StrId { v: 5u32 }, 2u32, LTO_VIS_PUB));
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 6u32 }, StrId { v: 6u32 }, 2u32, LTO_VIS_PUB));
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 7u32 }, StrId { v: 7u32 }, 2u32, LTO_VIS_PUB));

    let mut st_mmio = lto_static_summary_default(SymbolId { v: 101u32 }, 1u32, LTO_VIS_PUB);
    st_mmio.is_volatile_or_pinned_at = true;
    st_mmio.referenced_fn_sym = SymbolId { v: 6u32 };
    lto_module_summary_add_static(unsafe { mut_view(*mod1) }, mut_view(arena), st_mmio);
    let st_dead = lto_static_summary_default(SymbolId { v: 102u32 }, 2u32, LTO_VIS_PUB);
    lto_module_summary_add_static(unsafe { mut_view(*mod2) }, mut_view(arena), st_dead);

    lto_module_summary_add_trait_impl(unsafe { mut_view(*mod2) }, mut_view(arena), LtoTraitImplRecord {
        trait_id: 9u32,
        concrete_type_id: 42u32,
        vtable_sym: SymbolId { v: 900u32 },
        method_sym: SymbolId { v: 7u32 },
        module_id: 2u32,
        is_coerced_to_dyn: true,
        is_live_vtable: true,
    });

    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo_reach) }, mod1, mut_view(arena), mut_view(stats_closed));
    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo_reach) }, mod2, mut_view(arena), mut_view(stats_closed));
    let _ = lto_mark_root_symbol(unsafe { mut_view(*wpo_reach) }, SymbolId { v: 1u32 }, LTO_ROOT_ENTRY);
    let _ = lto_mark_root_symbol(unsafe { mut_view(*wpo_reach) }, SymbolId { v: 4u32 }, LTO_ROOT_FFI_CALLBACK);
    let _ = lto_mark_root_symbol(unsafe { mut_view(*wpo_reach) }, SymbolId { v: 5u32 }, LTO_ROOT_REFLECTION);
    let int_cnt = lto_internalize_symbols(unsafe { mut_view(*wpo_reach) }, mut_view(stats_closed));
    let dead_cnt = lto_compute_reachability(unsafe { mut_view(*wpo_reach) }, mut_view(arena), mut_view(stats_closed));
    let pruned_cnt = lto_prune_unreachable(unsafe { mut_view(*wpo_reach) }, mut_view(stats_closed));
    if int_cnt != 3u32 || dead_cnt != 2u32 || pruned_cnt != 4u32 ||
       stats_closed.dead_fns_eliminated != 2u32 ||
       stats_closed.dead_statics_eliminated != 1u32 ||
       stats_closed.dead_vtables_eliminated != 1u32 {
        arena_destroy(mut_view(arena));
        return 202;
    }

    // 2c. Cross-module OptIR optimization (`lto_run_cross_module_opt`), `UnknownAlias` / `atomic` / `volatile` barriers, and generic dedup
    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(arena));
    let sink_fe = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    diag_sink_init(unsafe { mut_view(*sink_fe) });

    let ct_fe = arena_alloc_raw(mut_view(arena), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(arena), 32);
    let esc_tbl = arena_alloc_raw(mut_view(arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(arena), 32);

    let cg = callgraph_new(mut_view(arena), thir_ptr as *const Thir, true, false);
    let wpo = lto_wpo_new(mut_view(arena), cg, LTO_MODE_FAT, WORLD_CLOSED);
    let mod_a = lto_module_summary_new(mut_view(arena), 1u32, StrId { v: 1u32 });
    let mod_b = lto_module_summary_new(mut_view(arena), 2u32, StrId { v: 1u32 });

    let fn_sym_vs: [5]u32 = [501u32, 502u32, 503u32, 504u32, 505u32];
    let mut rc: i32 = 0;
    let mut fn_idx: usize = 0;
    while fn_idx < 5 {
        let blob_sv = probe_blob(mut_view(arena), fn_idx);
        let mbody: *mut MirBody = verify_parse_mir(
            blob_sv,
            unsafe { mut_view((*thir_ptr).interner) },
            mut_view(arena)
        );
        if (mbody as usize) == 0 {
            rc = 203;
            break;
        }
        let sym_v = fn_sym_vs[fn_idx];
        unsafe {
            (*mbody).sym = SymbolId { v: sym_v };
            (*mbody).fn_sym = SymbolId { v: sym_v };
            (*mbody).fn_name = StrId { v: sym_v };
        }
        if fn_idx == 3 {
            let bb0 = unsafe { mir_bb_at((*mbody).bbs, 0) };
            let bb1 = unsafe { mir_bb_at((*mbody).bbs, 1) };
            unsafe {
                (*bb0).terminator.func.constant.kind = MIR_CONST_FN;
                (*bb0).terminator.func.constant.sym = SymbolId { v: fn_sym_vs[0] };
                (*bb0).terminator.func.constant.val = fn_sym_vs[0] as u64;

                (*bb1).terminator.func.constant.kind = MIR_CONST_FN;
                (*bb1).terminator.func.constant.sym = SymbolId { v: fn_sym_vs[1] };
                (*bb1).terminator.func.constant.val = fn_sym_vs[1] as u64;
            }
        }
        let ob = optir_build_from_verified_mir(unsafe { view(*mbody) }, thir_ptr as *const Thir, mut_view(arena));
        if (ob as usize) == 0 {
            rc = 204;
            break;
        }
        unsafe { (*ob).fn_sym = SymbolId { v: sym_v }; }
        let fn_item_p = probe_make_fn_item(mut_view(arena), unsafe { (*mbody).arg_count });
        let _ = callgraph_add_node(
            unsafe { mut_view(*cg) },
            mut_view(arena),
            SymbolId { v: sym_v },
            StrId { v: sym_v },
            mbody,
            ob,
            fn_item_p,
            INLINE_ATTR_NONE,
            false,
            fn_idx == 3,
            false,
            false,
            DOMAIN_CPU_HOST,
            false
        );
        let mod_id: u32 = if fn_idx == 3 { 1u32 } else { 2u32 };
        let mut fsum = lto_fn_summary_default(SymbolId { v: sym_v }, StrId { v: sym_v }, mod_id, LTO_VIS_PUB);
        if fn_idx == 0 {
            fsum.has_atomic_ops = true;
            fsum.has_volatile_ops = true;
        } else if fn_idx == 4 {
            fsum.has_raw_ptr_or_ffi_alias = true;
        }
        if mod_id == 1u32 {
            lto_module_summary_add_fn(unsafe { mut_view(*mod_a) }, mut_view(arena), fsum);
        } else {
            lto_module_summary_add_fn(unsafe { mut_view(*mod_b) }, mut_view(arena), fsum);
        }
        fn_idx = fn_idx + 1;
    }

    if rc == 0 {
        lto_module_summary_add_trait_impl(unsafe { mut_view(*mod_b) }, mut_view(arena), LtoTraitImplRecord {
            trait_id: 1u32,
            concrete_type_id: 10u32,
            vtable_sym: SymbolId { v: 700u32 },
            method_sym: SymbolId { v: fn_sym_vs[2] },
            module_id: 2u32,
            is_coerced_to_dyn: true,
            is_live_vtable: true,
        });

        let mut opt_stats = lto_stats_zero();
        let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod_a, mut_view(arena), mut_view(opt_stats));
        let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod_b, mut_view(arena), mut_view(opt_stats));
        let _ = lto_mark_root_symbol(unsafe { mut_view(*wpo) }, SymbolId { v: fn_sym_vs[3] }, LTO_ROOT_ENTRY);

        lto_propagate_cross_module_summaries(
            unsafe { mut_view(*wpo) },
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(opt_stats),
            mut_view(arena)
        );
        let f0_idx = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: fn_sym_vs[0] }) as usize;
        let f4_idx = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: fn_sym_vs[4] }) as usize;
        let f0_eff = unsafe { (*lto_fn_at((*wpo).fns, f0_idx)).effect_flags };
        let f0_alias = unsafe { (*lto_fn_at((*wpo).fns, f0_idx)).alias_state };
        let f4_alias = unsafe { (*lto_fn_at((*wpo).fns, f4_idx)).alias_state };
        if (f0_eff & EFFECT_ATOMIC) == 0u16 ||
           (f0_eff & EFFECT_VOLATILE) == 0u16 ||
           f0_alias != LTO_ALIAS_NO_ALIAS ||
           f4_alias != LTO_ALIAS_UNKNOWN_ALIAS ||
           opt_stats.unknown_alias_barriers == 0u32 {
            rc = 205;
        }

        if rc == 0 {
            callgraph_finalize(unsafe { mut_view(*cg) }, unsafe { mut_view(*ct_fe) }, unsafe { mut_view(*esc_tbl) }, mut_view(arena));
            let entry_ob = unsafe { (*cg_node_at((*cg).nodes, 3)).opt_body };
            let pm_lto = arena_alloc_raw(mut_view(arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
            passmgr_init(unsafe { mut_view(*pm_lto) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(arena));
            passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_lto) }, unsafe { mut_view(*entry_ob) }, mut_view(arena));
            let mut rb_stats = lto_stats_zero();
            let rb_chg = lto_run_pass_internal(
                unsafe { mut_view(*pm_lto) },
                unsafe { mut_view(*entry_ob) },
                unsafe { mut_view(*wpo) },
                unsafe { mut_view(*ct_fe) },
                unsafe { mut_view(*esc_tbl) },
                mut_view(rb_stats),
                true,
                mut_view(arena),
                unsafe { mut_view(*sink_fe) }
            );
            if rb_chg || rb_stats.pass_rollbacks != 1u32 {
                rc = 206;
            }
        }

        if rc == 0 {
            let inl_log = inline_log_new(mut_view(arena), 32);
            let sp_log = ipa_spec_log_new(mut_view(arena), 32);
            let dv_log = devirt_log_new(mut_view(arena), 32);
            let mut sr_stats = sroa_stats_zero();
            let sr_log = sroa_log_new(mut_view(arena), 32);
            let changed = lto_run_cross_module_opt(
                unsafe { mut_view(*wpo) },
                OPT_PROFILE_SPEED_O2,
                unsafe { mut_view(*ct_fe) },
                unsafe { mut_view(*esc_tbl) },
                mut_view(opt_stats),
                inl_log,
                sp_log,
                dv_log,
                unsafe { address_of_mut(sr_stats) },
                sr_log,
                mut_view(arena),
                unsafe { mut_view(*sink_fe) }
            );
            if !changed ||
               opt_stats.cross_module_devirt_exact == 0u32 ||
               opt_stats.cross_module_specialized == 0u32 ||
               opt_stats.cross_module_inlined == 0u32 ||
               opt_stats.dead_fns_eliminated == 0u32 {
                rc = 207;
            }
        }
    }

    // 2d. Generic monomorphization deduplication (`LTO_DEDUP_EXACT_INSTANCE`, `LTO_DEDUP_REP_EQUIV_SHARED`, `LTO_DEDUP_KEPT_ADDRESS_TAKEN`, `LTO_DEDUP_KEPT_CUSTOM_DROP`)
    if rc == 0 {
        let mut dedup_stats = lto_stats_zero();
        let wpo_g = lto_wpo_new(mut_view(arena), 0 as *mut CallGraph, LTO_MODE_FAT, WORLD_CLOSED);
        let mg1 = lto_module_summary_new(mut_view(arena), 1u32, StrId { v: 1u32 });
        let mg2 = lto_module_summary_new(mut_view(arena), 2u32, StrId { v: 1u32 });
        let mg3 = lto_module_summary_new(mut_view(arena), 3u32, StrId { v: 1u32 });

        let mut g1 = lto_fn_summary_default(SymbolId { v: 201u32 }, StrId { v: 201u32 }, 1u32, LTO_VIS_PUB);
        g1.generic_def_id = 50u32;
        g1.canonical_type_arg_hash = 0xAAA00001u64;
        g1.body_fingerprint = 0x7777888899990000u64;
        g1.rep_type_size = 8u32;
        g1.rep_type_align = 8u32;
        g1.rep_abi_class = 1u8;
        g1.reachability = REACH_INTERNAL;

        let mut g2 = lto_fn_summary_default(SymbolId { v: 202u32 }, StrId { v: 202u32 }, 2u32, LTO_VIS_PUB);
        g2.generic_def_id = 50u32;
        g2.canonical_type_arg_hash = 0xAAA00001u64;
        g2.body_fingerprint = 0x7777888899990000u64;
        g2.rep_type_size = 8u32;
        g2.rep_type_align = 8u32;
        g2.rep_abi_class = 1u8;
        g2.reachability = REACH_INTERNAL;

        let mut g3 = lto_fn_summary_default(SymbolId { v: 203u32 }, StrId { v: 203u32 }, 2u32, LTO_VIS_PUB);
        g3.generic_def_id = 50u32;
        g3.canonical_type_arg_hash = 0xBBB00002u64;
        g3.body_fingerprint = 0x7777888899990000u64;
        g3.rep_type_size = 8u32;
        g3.rep_type_align = 8u32;
        g3.rep_abi_class = 1u8;
        g3.address_taken_fn = false;
        g3.has_custom_drop = false;
        g3.reachability = REACH_INTERNAL;

        let mut g4 = lto_fn_summary_default(SymbolId { v: 204u32 }, StrId { v: 204u32 }, 3u32, LTO_VIS_PUB);
        g4.generic_def_id = 50u32;
        g4.canonical_type_arg_hash = 0xCCC00003u64;
        g4.body_fingerprint = 0x7777888899990000u64;
        g4.rep_type_size = 8u32;
        g4.rep_type_align = 8u32;
        g4.rep_abi_class = 1u8;
        g4.address_taken_fn = true;
        g4.reachability = REACH_INTERNAL;

        let mut g5 = lto_fn_summary_default(SymbolId { v: 205u32 }, StrId { v: 205u32 }, 3u32, LTO_VIS_PUB);
        g5.generic_def_id = 50u32;
        g5.canonical_type_arg_hash = 0xDDD00004u64;
        g5.body_fingerprint = 0x7777888899990000u64;
        g5.rep_type_size = 8u32;
        g5.rep_type_align = 8u32;
        g5.rep_abi_class = 1u8;
        g5.has_custom_drop = true;
        g5.reachability = REACH_INTERNAL;

        lto_module_summary_add_fn(unsafe { mut_view(*mg1) }, mut_view(arena), g1);
        lto_module_summary_add_fn(unsafe { mut_view(*mg2) }, mut_view(arena), g2);
        lto_module_summary_add_fn(unsafe { mut_view(*mg2) }, mut_view(arena), g3);
        lto_module_summary_add_fn(unsafe { mut_view(*mg3) }, mut_view(arena), g4);
        lto_module_summary_add_fn(unsafe { mut_view(*mg3) }, mut_view(arena), g5);
        let _ = lto_wpo_import_module(unsafe { mut_view(*wpo_g) }, mg1, mut_view(arena), mut_view(dedup_stats));
        let _ = lto_wpo_import_module(unsafe { mut_view(*wpo_g) }, mg2, mut_view(arena), mut_view(dedup_stats));
        let _ = lto_wpo_import_module(unsafe { mut_view(*wpo_g) }, mg3, mut_view(arena), mut_view(dedup_stats));

        let merged = lto_deduplicate_generics(unsafe { mut_view(*wpo_g) }, mut_view(arena), mut_view(dedup_stats));
        if merged != 2u32 ||
           dedup_stats.generics_dedup_exact != 1u32 ||
           dedup_stats.generics_rep_shared != 1u32 ||
           dedup_stats.generics_kept_addr_taken != 1u32 ||
           dedup_stats.generics_kept_custom_drop != 1u32 {
            rc = 208;
        } else {
            let mut b1: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            let mut b2: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            diag_buf_init(mut_view(b1));
            diag_buf_init(mut_view(b2));
            lto_print(unsafe { view(*wpo_g) }, view(dedup_stats), mut_view(b1));
            lto_print(unsafe { view(*wpo_g) }, view(dedup_stats), mut_view(b2));
            let eq = diag_buf_eq(view(b1), view(b2)) && b1.len > 80;
            diag_buf_free(mut_view(b1));
            diag_buf_free(mut_view(b2));
            if !eq {
                rc = 209;
            }
        }
    }

    diag_sink_free(unsafe { mut_view(*sink_fe) });
    opt_free_minimal_thir(thir_ptr);
    arena_destroy(mut_view(arena));
    if rc == 0 {
        print("PROBE_E15_6_LTO_REACHABILITY_AND_CROSS_MOD_OPT=OK\n");
    }
    rc
}

// =============================================================================
// 3. Linker Section GC, COMDAT Resolution, Dead Stripping & Formal Root Set
// =============================================================================
fn probe_section_gc_dead_strip_and_roots() -> i32 {
    let mut arena = new_arena(262144);
    let sg = section_graph_new(mut_view(arena), LINK_PROFILE_SPEED, false);
    let mut stats = gc_icf_stats_zero();

    let code_a = make_bytes_8(mut_view(arena), 72u8, 137u8, 192u8, 195u8, 144u8, 144u8, 144u8, 144u8);
    let code_b = make_bytes_8(mut_view(arena), 72u8, 49u8, 192u8, 195u8, 144u8, 144u8, 144u8, 144u8);

    let n_main = section_node_default(SectionId { v: 0u32 }, 1u32, StrId { v: 100u32 }, SEC_KIND_TEXT, SymbolId { v: 100u32 });
    let sec_main_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_main).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_main_v }, code_a, 8);
    let _ = section_graph_mark_root(unsafe { mut_view(*sg) }, SectionId { v: sec_main_v }, GC_ROOT_ENTRY);

    let mut n_comdat_hi = section_node_default(SectionId { v: 1u32 }, 5u32, StrId { v: 101u32 }, SEC_KIND_TEXT, SymbolId { v: 101u32 });
    n_comdat_hi.comdat_selection = COMDAT_ANY;
    let sec_comdat_hi_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_comdat_hi).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_comdat_hi_v }, code_a, 8);

    let mut n_comdat_lo = section_node_default(SectionId { v: 2u32 }, 2u32, StrId { v: 101u32 }, SEC_KIND_TEXT, SymbolId { v: 101u32 });
    n_comdat_lo.comdat_selection = COMDAT_ANY;
    let sec_comdat_lo_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_comdat_lo).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_comdat_lo_v }, code_a, 8);

    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_main_v }, 2u32, 4u32, SymbolId { v: 101u32 }, SectionId { v: sec_comdat_hi_v }, 0i64, true);

    let mut n_pdata_live = section_node_default(SectionId { v: 3u32 }, 1u32, StrId { v: 102u32 }, SEC_KIND_PDATA, SymbolId { v: 102u32 });
    n_pdata_live.comdat_selection = COMDAT_ASSOC;
    n_pdata_live.assoc_leader_sec = SectionId { v: sec_main_v };
    let sec_pdata_live_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_pdata_live).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_pdata_live_v }, code_a, 8);

    let mut n_mmio = section_node_default(SectionId { v: 4u32 }, 1u32, StrId { v: 103u32 }, SEC_KIND_DATA, SymbolId { v: 103u32 });
    n_mmio.has_pinned_vma = true;
    n_mmio.pinned_vma = 0x40001000u64;
    let sec_mmio_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_mmio).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_mmio_v }, code_b, 8);

    let n_ffi_cb = section_node_default(SectionId { v: 5u32 }, 1u32, StrId { v: 104u32 }, SEC_KIND_TEXT, SymbolId { v: 104u32 });
    let sec_ffi_cb_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_ffi_cb).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_ffi_cb_v }, code_b, 8);
    let _ = section_graph_mark_root(unsafe { mut_view(*sg) }, SectionId { v: sec_ffi_cb_v }, GC_ROOT_FFI_CALLBACK);

    let n_dead_fn = section_node_default(SectionId { v: 6u32 }, 3u32, StrId { v: 105u32 }, SEC_KIND_TEXT, SymbolId { v: 105u32 });
    let sec_dead_fn_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_dead_fn).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_dead_fn_v }, code_b, 8);

    let mut n_pdata_dead = section_node_default(SectionId { v: 7u32 }, 3u32, StrId { v: 106u32 }, SEC_KIND_PDATA, SymbolId { v: 106u32 });
    n_pdata_dead.comdat_selection = COMDAT_ASSOC;
    n_pdata_dead.assoc_leader_sec = SectionId { v: sec_dead_fn_v };
    let sec_pdata_dead_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_pdata_dead).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: sec_pdata_dead_v }, code_a, 8);

    let n_dead_data = section_node_default(SectionId { v: 8u32 }, 3u32, StrId { v: 107u32 }, SEC_KIND_RDATA, SymbolId { v: 107u32 });
    let sec_dead_data = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_dead_data);
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), sec_dead_data, code_b, 8);

    let n_dead_imp = section_node_default(SectionId { v: 9u32 }, 3u32, StrId { v: 108u32 }, SEC_KIND_IMPORT_THUNK, SymbolId { v: 108u32 });
    let sec_dead_imp = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_dead_imp);
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), sec_dead_imp, code_a, 8);

    let mut n_dead_rt = section_node_default(SectionId { v: 10u32 }, 4u32, StrId { v: 109u32 }, SEC_KIND_TEXT, SymbolId { v: 109u32 });
    n_dead_rt.runtime_comp = RUNTIME_COMP_HEAP;
    let sec_dead_rt = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_dead_rt);
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), sec_dead_rt, code_b, 8);

    let ok = link_run_gc_icf_pipeline(unsafe { mut_view(*sg) }, mut_view(arena), mut_view(stats));
    let p_hi = unsafe { sg_node_at((*sg).nodes, sec_comdat_hi_v as usize) };
    let p_lo = unsafe { sg_node_at((*sg).nodes, sec_comdat_lo_v as usize) };
    let p_pd_live = unsafe { sg_node_at((*sg).nodes, sec_pdata_live_v as usize) };
    let p_pd_dead = unsafe { sg_node_at((*sg).nodes, sec_pdata_dead_v as usize) };
    let p_mmio = unsafe { sg_node_at((*sg).nodes, sec_mmio_v as usize) };

    if !ok ||
       stats.comdat_groups_resolved != 1u32 ||
       stats.comdat_duplicates_discarded != 1u32 ||
       stats.live_sections_kept != 5u32 ||
       stats.dead_code_sections_stripped != 2u32 ||
       stats.dead_data_sections_stripped != 1u32 ||
       stats.dead_assoc_sections_stripped != 1u32 ||
       stats.unused_imports_stripped != 1u32 ||
       stats.unused_runtime_stripped != 1u32 ||
       (unsafe { (*p_hi).retention_reason }) != RETENTION_DISCARDED_COMDAT ||
       (unsafe { (*p_lo).retention_reason }) != RETENTION_REFERENCED ||
       (unsafe { (*p_pd_live).retention_reason }) != RETENTION_ASSOC_LEADER ||
       (unsafe { (*p_pd_dead).retention_reason }) != RETENTION_DEAD_STRIPPED ||
       (unsafe { (*p_mmio).retention_reason }) != RETENTION_ROOT {
        arena_destroy(mut_view(arena));
        return 301;
    }

    arena_destroy(mut_view(arena));
    print("PROBE_E15_6_SECTION_GC_DEAD_STRIP_AND_ROOTS=OK\n");
    0
}

// =============================================================================
// 4. Safe ICF, .rdata Pooling, .bss Promotion & 3D Size Model
// =============================================================================
fn probe_safe_icf_rodata_bss_and_size_model() -> i32 {
    let mut arena = new_arena(262144);
    let sg = section_graph_new(mut_view(arena), LINK_PROFILE_SIZE, true);
    let mut stats = gc_icf_stats_zero();

    let fn_bytes = make_bytes_8(mut_view(arena), 72u8, 137u8, 248u8, 72u8, 131u8, 192u8, 5u8, 195u8);
    let entry_bytes = make_bytes_8(mut_view(arena), 85u8, 72u8, 137u8, 229u8, 93u8, 195u8, 144u8, 144u8);
    let ro_bytes = make_bytes_8(mut_view(arena), 10u8, 20u8, 30u8, 40u8, 50u8, 60u8, 70u8, 80u8);
    let str_bytes = make_bytes_8(mut_view(arena), 97u8, 120u8, 105u8, 111u8, 109u8, 0u8, 0u8, 0u8);
    let zero_bytes = make_bytes_8(mut_view(arena), 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8);

    let mut n_entry = section_node_default(SectionId { v: 0u32 }, 1u32, StrId { v: 200u32 }, SEC_KIND_TEXT, SymbolId { v: 200u32 });
    n_entry.hotness_bucket = HOTNESS_BUCKET_HOT;
    let s_entry_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_entry).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, entry_bytes, 8);
    let _ = section_graph_mark_root(unsafe { mut_view(*sg) }, SectionId { v: s_entry_v }, GC_ROOT_ENTRY);

    let n_icf_1 = section_node_default(SectionId { v: 1u32 }, 1u32, StrId { v: 201u32 }, SEC_KIND_TEXT, SymbolId { v: 201u32 });
    let s_icf_1_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_icf_1).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_icf_1_v }, fn_bytes, 8);

    let n_icf_2 = section_node_default(SectionId { v: 2u32 }, 2u32, StrId { v: 202u32 }, SEC_KIND_TEXT, SymbolId { v: 202u32 });
    let s_icf_2_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_icf_2).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_icf_2_v }, fn_bytes, 8);

    let mut n_icf_3 = section_node_default(SectionId { v: 3u32 }, 3u32, StrId { v: 203u32 }, SEC_KIND_TEXT, SymbolId { v: 203u32 });
    n_icf_3.address_taken = true;
    let s_icf_3_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_icf_3).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_icf_3_v }, fn_bytes, 8);

    let n_ro_1 = section_node_default(SectionId { v: 4u32 }, 1u32, StrId { v: 204u32 }, SEC_KIND_RDATA, SymbolId { v: 204u32 });
    let s_ro_1_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_ro_1).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_ro_1_v }, ro_bytes, 8);

    let n_ro_2 = section_node_default(SectionId { v: 5u32 }, 2u32, StrId { v: 205u32 }, SEC_KIND_RDATA, SymbolId { v: 205u32 });
    let s_ro_2_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_ro_2).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_ro_2_v }, ro_bytes, 8);

    let mut n_str_1 = section_node_default(SectionId { v: 6u32 }, 1u32, StrId { v: 206u32 }, SEC_KIND_RDATA, SymbolId { v: 206u32 });
    n_str_1.is_string_literal = true;
    let s_str_1_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_str_1).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_str_1_v }, str_bytes, 8);

    let mut n_str_2 = section_node_default(SectionId { v: 7u32 }, 2u32, StrId { v: 207u32 }, SEC_KIND_RDATA, SymbolId { v: 207u32 });
    n_str_2.is_string_literal = true;
    let s_str_2_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_str_2).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_str_2_v }, str_bytes, 8);

    let n_mut_1 = section_node_default(SectionId { v: 8u32 }, 1u32, StrId { v: 208u32 }, SEC_KIND_DATA, SymbolId { v: 208u32 });
    let s_mut_1_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_mut_1).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_mut_1_v }, ro_bytes, 8);

    let n_mut_2 = section_node_default(SectionId { v: 9u32 }, 2u32, StrId { v: 209u32 }, SEC_KIND_DATA, SymbolId { v: 209u32 });
    let s_mut_2_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_mut_2).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_mut_2_v }, ro_bytes, 8);

    let n_zero = section_node_default(SectionId { v: 10u32 }, 1u32, StrId { v: 210u32 }, SEC_KIND_DATA, SymbolId { v: 210u32 });
    let s_zero_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_zero).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_zero_v }, zero_bytes, 8);

    let mut n_cold = section_node_default(SectionId { v: 11u32 }, 1u32, StrId { v: 211u32 }, SEC_KIND_TEXT, SymbolId { v: 211u32 });
    n_cold.hotness_bucket = HOTNESS_BUCKET_COLD;
    let s_cold_v = section_graph_add_node(unsafe { mut_view(*sg) }, mut_view(arena), n_cold).v;
    section_graph_set_bytes(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_cold_v }, entry_bytes, 8);

    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 0u32, 4u32, SymbolId { v: 201u32 }, SectionId { v: s_icf_1_v }, 0i64, true);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 1u32, 4u32, SymbolId { v: 202u32 }, SectionId { v: s_icf_2_v }, 0i64, true);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 2u32, 4u32, SymbolId { v: 203u32 }, SectionId { v: s_icf_3_v }, 0i64, false);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 3u32, 4u32, SymbolId { v: 204u32 }, SectionId { v: s_ro_1_v }, 0i64, false);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 4u32, 4u32, SymbolId { v: 205u32 }, SectionId { v: s_ro_2_v }, 0i64, false);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 5u32, 4u32, SymbolId { v: 206u32 }, SectionId { v: s_str_1_v }, 0i64, false);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 6u32, 4u32, SymbolId { v: 207u32 }, SectionId { v: s_str_2_v }, 0i64, false);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 7u32, 4u32, SymbolId { v: 208u32 }, SectionId { v: s_mut_1_v }, 0i64, false);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 8u32, 4u32, SymbolId { v: 209u32 }, SectionId { v: s_mut_2_v }, 0i64, false);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 9u32, 4u32, SymbolId { v: 210u32 }, SectionId { v: s_zero_v }, 0i64, false);
    section_graph_add_reloc(unsafe { mut_view(*sg) }, mut_view(arena), SectionId { v: s_entry_v }, 10u32, 4u32, SymbolId { v: 211u32 }, SectionId { v: s_cold_v }, 0i64, true);

    let ok = link_run_gc_icf_pipeline(unsafe { mut_view(*sg) }, mut_view(arena), mut_view(stats));
    let p_fold = unsafe { sg_node_at((*sg).nodes, s_icf_2_v as usize) };
    let p_thunk = unsafe { sg_node_at((*sg).nodes, s_icf_3_v as usize) };
    let p_ro2 = unsafe { sg_node_at((*sg).nodes, s_ro_2_v as usize) };
    let p_str2 = unsafe { sg_node_at((*sg).nodes, s_str_2_v as usize) };
    let p_mut2 = unsafe { sg_node_at((*sg).nodes, s_mut_2_v as usize) };
    let p_zero = unsafe { sg_node_at((*sg).nodes, s_zero_v as usize) };

    if !ok ||
       (unsafe { (*p_fold).icf_decision }) != ICF_DECISION_FOLDED ||
       (unsafe { (*p_thunk).icf_decision }) != ICF_DECISION_THUNKED_ADDR_TAKEN ||
       (unsafe { (*p_thunk).bytes_len }) != ICF_THUNK_SIZE ||
       (unsafe { *gc_byte_at((*p_thunk).bytes, 0) }) != 233u8 ||
       (unsafe { (*p_ro2).icf_decision }) != ICF_DECISION_RDATA_MERGED ||
       (unsafe { (*p_str2).icf_decision }) != ICF_DECISION_STRING_POOLED ||
       (unsafe { (*p_mut2).icf_decision }) != ICF_DECISION_KEPT_MUTABLE_OR_PINNED ||
       (unsafe { (*p_zero).kind }) != SEC_KIND_BSS ||
       (unsafe { (*p_zero).icf_decision }) != ICF_DECISION_BSS_PROMOTED {
        arena_destroy(mut_view(arena));
        return 401;
    }

    let sm = unsafe { (*sg).size_model };
    let cid1 = link_compute_cache_identity(unsafe { view(*sg) }, 1u32, StrId { v: 1u32 }, 2u8, 2u8, 0x12345678u64);
    let cid2 = link_compute_cache_identity(unsafe { view(*sg) }, 1u32, StrId { v: 1u32 }, 2u8, 2u8, 0x12345678u64);
    if sm.file_size_bytes == 0u64 || sm.mapped_size_bytes <= sm.file_size_bytes ||
       cid1.cache_key_lo != cid2.cache_key_lo || cid1.cache_key_hi != cid2.cache_key_hi {
        arena_destroy(mut_view(arena));
        return 402;
    }

    let mut b1: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut b2: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(b1));
    diag_buf_init(mut_view(b2));
    section_gc_print(unsafe { view(*sg) }, view(stats), mut_view(b1));
    section_gc_print(unsafe { view(*sg) }, view(stats), mut_view(b2));
    let eq = diag_buf_eq(view(b1), view(b2)) && b1.len > 80;
    diag_buf_free(mut_view(b1));
    diag_buf_free(mut_view(b2));
    arena_destroy(mut_view(arena));
    if !eq {
        return 403;
    }
    print("PROBE_E15_6_SAFE_ICF_RODATA_BSS_AND_SIZE_MODEL=OK\n");
    0
}

// =============================================================================
// 5. PGO `--pgo-gen` -> Merge -> `.axprof` Round-Trip -> `--pgo-use` & Stale Fallback
// =============================================================================
fn probe_pgo_roundtrip_and_stale_resilience() -> i32 {
    let c = pgo_contract();
    if c.pass_id != PASS_PGO || c.pass_id != 19u16 || c.postconditions != POSTCOND_ALL {
        return 501;
    }

    let mut arena = new_arena(262144);
    let mut stats = pgo_stats_zero();
    let prof1 = pgo_profile_new(mut_view(arena), StrId { v: 1u32 }, 0xABCDEF01u64, PGO_PROV_INSTRUMENTED_AOT);

    let mut f_cold = pgo_fn_profile_new(mut_view(arena), SymbolId { v: 40u32 }, StrId { v: 40u32 }, 0x1111u64, 0x2222u64, 2u32, 0u64);
    pgo_fn_set_block_count(mut_view(f_cold), 0, 0u64);
    pgo_fn_set_block_count(mut_view(f_cold), 1, 0u64);
    pgo_fn_add_loop(mut_view(f_cold), mut_view(arena), OptBbId { v: 1u32 }, 0u64, 0u64);

    let mut f_hot = pgo_fn_profile_new(mut_view(arena), SymbolId { v: 10u32 }, StrId { v: 10u32 }, 0xAAAAu64, 0xBBBBu64, 3u32, 2000u64);
    pgo_fn_set_block_count(mut_view(f_hot), 0, 2000u64);
    pgo_fn_set_block_count(mut_view(f_hot), 1, 1900u64);
    pgo_fn_set_block_count(mut_view(f_hot), 2, 0u64);
    pgo_fn_add_branch(mut_view(f_hot), mut_view(arena), OptBbId { v: 0u32 }, 1900u64, 100u64);
    pgo_fn_add_branch(mut_view(f_hot), mut_view(arena), OptBbId { v: 1u32 }, 500u64, 500u64);
    pgo_fn_add_call(mut_view(f_hot), mut_view(arena), 1u32, OptBbId { v: 0u32 }, SymbolId { v: 77u32 }, 1800u64, SymbolId { v: 88u32 }, 200u64, 0u64);
    pgo_fn_add_loop(mut_view(f_hot), mut_view(arena), OptBbId { v: 1u32 }, 2000u64, 32000u64);
    pgo_fn_add_value(mut_view(f_hot), mut_view(arena), 1u32, 1i64, 1850u64, 4i64, 150u64, 0u64);

    pgo_profile_add_fn(unsafe { mut_view(*prof1) }, mut_view(arena), f_cold);
    pgo_profile_add_fn(unsafe { mut_view(*prof1) }, mut_view(arena), f_hot);

    let mut blob_len: usize = 0;
    let blob = pgo_serialize_profile(unsafe { mut_view(*prof1) }, mut_view(arena), mut_view(blob_len));
    if (blob as usize) == 0 || blob_len < 64 || (unsafe { *pgo_u8_at(blob, 0) }) != AXPROF_MAGIC_0 {
        arena_destroy(mut_view(arena));
        return 502;
    }
    let decoded = pgo_deserialize_profile(blob as *const u8, blob_len, StrId { v: 1u32 }, mut_view(arena), mut_view(stats));
    if (decoded as usize) == 0 ||
       (unsafe { (*decoded).fn_count }) != 2 ||
       (unsafe { (*decoded).profile_digest }) != (unsafe { (*prof1).profile_digest }) {
        arena_destroy(mut_view(arena));
        return 503;
    }

    // Tampered / incompatible `.axprof` rejection
    let bad_target = pgo_deserialize_profile(blob as *const u8, blob_len, StrId { v: 99u32 }, mut_view(arena), mut_view(stats));
    unsafe { *pgo_u8_at(blob, blob_len - 1) = (*pgo_u8_at(blob, blob_len - 1)) ^ 1u8; }
    let bad_digest = pgo_deserialize_profile(blob as *const u8, blob_len, StrId { v: 1u32 }, mut_view(arena), mut_view(stats));
    if (bad_target as usize) != 0 || (bad_digest as usize) != 0 || stats.incompatible_profiles_rejected != 2u32 {
        arena_destroy(mut_view(arena));
        return 504;
    }

    // Weighted merge + 4-level compatibility & stale fallback
    let merge_ok = pgo_merge_profiles(unsafe { mut_view(*decoded) }, unsafe { view(*prof1) }, 2u32, mut_view(arena), mut_view(stats));
    let fn10_merged = pgo_profile_find_fn(unsafe { view(*decoded) }, SymbolId { v: 10u32 });
    if !merge_ok || (unsafe { (*decoded).provenance_kind }) != PGO_PROV_MERGED || (unsafe { (*fn10_merged).entry_count }) != 6000u64 {
        arena_destroy(mut_view(arena));
        return 505;
    }

    let c_exact = pgo_classify_and_bind_function(unsafe { view(*decoded) }, unsafe { mut_view(*fn10_merged) }, StrId { v: 1u32 }, 0xAAAAu64, 0xBBBBu64, 3u32, true, mut_view(stats));
    let c_compat = pgo_classify_and_bind_function(unsafe { view(*decoded) }, unsafe { mut_view(*fn10_merged) }, StrId { v: 1u32 }, 0xAAAAu64, 0xBBBBu64, 4u32, true, mut_view(stats));
    let c_stale = pgo_classify_and_bind_function(unsafe { view(*decoded) }, unsafe { mut_view(*fn10_merged) }, StrId { v: 1u32 }, 0xAAAAu64, 0xDEADCAFEu64, 5u32, true, mut_view(stats));
    if c_exact != PGO_COMPAT_EXACT || c_compat != PGO_COMPAT_COMPATIBLE || c_stale != PGO_COMPAT_STALE ||
       stats.stale_fn_fallbacks != 1u32 || (unsafe { (*fn10_merged).confidence }) > 250u32 {
        arena_destroy(mut_view(arena));
        return 506;
    }

    arena_destroy(mut_view(arena));
    print("PROBE_E15_6_PGO_ROUNDTRIP_AND_STALE_RESILIENCE=OK\n");
    0
}

// =============================================================================
// 6. PGO Epistemic Safety Law (`REQ-OPT-246..250`), Security Barriers & WPO Pipeline
// =============================================================================
fn probe_pgo_safety_contracts_and_wpo_pipeline() -> i32 {
    let mut arena = new_arena(524288);
    let mut stats = pgo_stats_zero();

    // 6a. Epistemic separation law (`AXS-PGO-002`, `REQ-OPT-246..250`):
    // Even at 100% observed probability (`10000` bp) and max confidence (`1000`),
    // `CERTAINTY_UNKNOWN` and `CERTAINTY_POSSIBLE` are NEVER upgraded to `CERTAINTY_PROVEN`.
    let cert_u = pgo_verify_epistemic_law(CERTAINTY_UNKNOWN, 10000u32, 1000u32, mut_view(stats));
    let cert_p = pgo_verify_epistemic_law(CERTAINTY_POSSIBLE, 10000u32, 1000u32, mut_view(stats));
    let cert_ok = pgo_verify_epistemic_law(CERTAINTY_PROVEN, 10000u32, 1000u32, mut_view(stats));
    if cert_u != CERTAINTY_UNKNOWN || cert_p != CERTAINTY_POSSIBLE || cert_ok != CERTAINTY_PROVEN ||
       stats.forbidden_proof_upgrades_blocked != 2u32 {
        arena_destroy(mut_view(arena));
        return 601;
    }

    // 6b. Cost-model guidance + constant-time secret (`zeroize` / `black_box`) + `atomic` / `volatile` + `@repr(C)` barriers
    let mut f_hot = pgo_fn_profile_new(mut_view(arena), SymbolId { v: 10u32 }, StrId { v: 10u32 }, 0xAAAAu64, 0xBBBBu64, 3u32, 5000u64);
    pgo_fn_set_block_count(mut_view(f_hot), 0, 5000u64);
    pgo_fn_set_block_count(mut_view(f_hot), 1, 4800u64);
    pgo_fn_set_block_count(mut_view(f_hot), 2, 0u64);
    pgo_fn_add_branch(mut_view(f_hot), mut_view(arena), OptBbId { v: 0u32 }, 4800u64, 200u64);
    pgo_fn_add_branch(mut_view(f_hot), mut_view(arena), OptBbId { v: 1u32 }, 2400u64, 2400u64);
    pgo_fn_add_call(mut_view(f_hot), mut_view(arena), 1u32, OptBbId { v: 0u32 }, SymbolId { v: 77u32 }, 4500u64, SymbolId { v: 88u32 }, 500u64, 0u64);
    pgo_fn_add_loop(mut_view(f_hot), mut_view(arena), OptBbId { v: 1u32 }, 5000u64, 80000u64);
    pgo_fn_add_value(mut_view(f_hot), mut_view(arena), 1u32, 1i64, 4600u64, 2i64, 400u64, 0u64);

    let g_hot = pgo_compute_cost_guidance(view(f_hot), OPT_PROFILE_SPEED_O2, false, false, mut_view(stats));
    let g_repr_c = pgo_compute_cost_guidance(view(f_hot), OPT_PROFILE_SPEED_O2, true, false, mut_view(stats));
    if g_hot.epistemic_kind != EPISTEMIC_OBSERVED ||
       !g_hot.has_guarded_devirt || !g_hot.requires_runtime_devirt_guard ||
       !g_hot.allow_data_layout_opt || g_repr_c.allow_data_layout_opt {
        arena_destroy(mut_view(arena));
        return 602;
    }

    let mut f_secret = f_hot;
    f_secret.is_constant_time_secret = true;
    f_secret.has_atomic_or_volatile = true;
    let g_secret = pgo_compute_cost_guidance(view(f_secret), OPT_PROFILE_SPEED_O2, false, false, mut_view(stats));
    if g_secret.allow_specialization || g_secret.has_value_guard_spec || g_secret.has_guarded_devirt ||
       stats.secret_constant_time_barriers == 0u32 || stats.atomic_volatile_barriers == 0u32 {
        arena_destroy(mut_view(arena));
        return 603;
    }

    // 6c. End-to-end `--pgo-gen` instrumentation, `pgo_apply_to_callgraph`, `pgo_run_pass_internal` rollback & `--emit=pgo`
    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(arena));
    let sink = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    diag_sink_init(unsafe { mut_view(*sink) });

    let blob_sv = probe_blob(mut_view(arena), 0);
    let mbody: *mut MirBody = verify_parse_mir(
        blob_sv,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(arena)
    );
    if (mbody as usize) == 0 {
        diag_sink_free(unsafe { mut_view(*sink) });
        opt_free_minimal_thir(thir_ptr);
        arena_destroy(mut_view(arena));
        return 604;
    }
    unsafe {
        (*mbody).sym = SymbolId { v: 601u32 };
        (*mbody).fn_sym = SymbolId { v: 601u32 };
        (*mbody).fn_name = StrId { v: 601u32 };
    }
    let ob = optir_build_from_verified_mir(unsafe { view(*mbody) }, thir_ptr as *const Thir, mut_view(arena));
    unsafe { (*ob).fn_sym = SymbolId { v: 601u32 }; }

    let plan = pgo_instrument_body(unsafe { view(*ob) }, StrId { v: 700u32 }, true, mut_view(stats));
    let expected_fp = pgo_compute_cfg_fingerprint(unsafe { view(*ob) });
    if plan.cfg_fingerprint != expected_fp || plan.num_counters == 0u32 {
        diag_sink_free(unsafe { mut_view(*sink) });
        opt_free_minimal_thir(thir_ptr);
        arena_destroy(mut_view(arena));
        return 605;
    }

    let prof_live = pgo_profile_new(mut_view(arena), StrId { v: 1u32 }, 0x5555u64, PGO_PROV_INSTRUMENTED_AOT);
    let mut f_601 = pgo_fn_profile_new(
        mut_view(arena),
        SymbolId { v: 601u32 },
        StrId { v: 601u32 },
        0x9999u64,
        expected_fp,
        unsafe { (*ob).bb_count as u32 },
        2u64
    );
    f_601.hotness_class = PGO_HOTNESS_COLD;
    pgo_profile_add_fn(unsafe { mut_view(*prof_live) }, mut_view(arena), f_601);

    let cg = callgraph_new(mut_view(arena), thir_ptr as *const Thir, true, false);
    let fn_item_p = probe_make_fn_item(mut_view(arena), unsafe { (*mbody).arg_count });
    let _ = callgraph_add_node(
        unsafe { mut_view(*cg) },
        mut_view(arena),
        SymbolId { v: 601u32 },
        StrId { v: 601u32 },
        mbody,
        ob,
        fn_item_p,
        INLINE_ATTR_NONE,
        false,
        true,
        false,
        false,
        DOMAIN_CPU_HOST,
        false
    );
    let cg_updated = pgo_apply_to_callgraph(unsafe { mut_view(*cg) }, unsafe { view(*prof_live) }, mut_view(stats));
    if cg_updated != 1u32 || !(unsafe { (*cg_node_at((*cg).nodes, 0)).is_cold_fn }) {
        diag_sink_free(unsafe { mut_view(*sink) });
        opt_free_minimal_thir(thir_ptr);
        arena_destroy(mut_view(arena));
        return 606;
    }

    let pm = arena_alloc_raw(mut_view(arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm) }, unsafe { mut_view(*ob) }, mut_view(arena));

    let rb_chg = pgo_run_pass_internal(
        unsafe { mut_view(*pm) },
        unsafe { mut_view(*ob) },
        unsafe { view(*prof_live) },
        mut_view(stats),
        true,
        mut_view(arena),
        unsafe { mut_view(*sink) }
    );
    let ok_chg = pgo_run_pass_internal(
        unsafe { mut_view(*pm) },
        unsafe { mut_view(*ob) },
        unsafe { view(*prof_live) },
        mut_view(stats),
        false,
        mut_view(arena),
        unsafe { mut_view(*sink) }
    );
    if rb_chg || !ok_chg || stats.pass_rollbacks != 1u32 || stats.pass_changes == 0u32 {
        diag_sink_free(unsafe { mut_view(*sink) });
        opt_free_minimal_thir(thir_ptr);
        arena_destroy(mut_view(arena));
        return 607;
    }

    let mut b1: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut b2: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(b1));
    diag_buf_init(mut_view(b2));
    pgo_print(unsafe { view(*prof_live) }, view(stats), mut_view(b1));
    pgo_print(unsafe { view(*prof_live) }, view(stats), mut_view(b2));
    let eq = diag_buf_eq(view(b1), view(b2)) && b1.len > 80;
    diag_buf_free(mut_view(b1));
    diag_buf_free(mut_view(b2));
    diag_sink_free(unsafe { mut_view(*sink) });
    opt_free_minimal_thir(thir_ptr);
    arena_destroy(mut_view(arena));
    if !eq {
        return 608;
    }
    print("PROBE_E15_6_PGO_SAFETY_CONTRACTS_AND_WPO_PIPELINE=OK\n");
    0
}

