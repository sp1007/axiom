// test: diff
// flags: --verify-each
// exit: 0
// stdout: 452\n318\n399\n852\n

// E15.6 Conformance: Whole-program LTO cross-boundary inlining, constant
// specialization, closed-world RTA devirtualization, generic monomorphization
// deduplication, function-pointer identity preservation, and LIFO Drop order
// (SPEC-75 §§1-4, AXS-LTO-001..024, REQ-OPT-246..250).

trait LtoStage {
    fn apply(self: view<Self>, x: i64) -> i64;
}

struct LinearStage {
    factor: i64,
    offset: i64,
}

struct XorMixStage {
    mask: i64,
    addend: i64,
}

impl LtoStage for LinearStage {
    fn apply(self: view<LinearStage>, x: i64) -> i64 {
        x * self.factor + self.offset
    }
}

impl LtoStage for XorMixStage {
    fn apply(self: view<XorMixStage>, x: i64) -> i64 {
        (x ^ self.mask) + self.addend
    }
}

struct Wrap<T> {
    v: T,
}

fn unwrap_val<T>(w: Wrap<T>) -> T {
    w.v
}

fn cross_mod_affine(x: i64, scale: i64, bias: i64) -> i64 {
    if scale == 0 {
        return bias;
    }
    if scale == 1 {
        return x + bias;
    }
    x * scale + bias
}

fn run_cross_mod_inline_and_spec() -> i64 {
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 8 {
        let a = cross_mod_affine(i * 5, 1, 7);
        let b = cross_mod_affine(i * 99, 0, 13);
        let c = cross_mod_affine(i + 2, 4, -3);
        acc = acc + a + b + c;
        i = i + 1;
    }
    acc
}

fn dispatch_lin(stage: view<LinearStage>, x: i64) -> i64 {
    stage.apply(x)
}

fn dispatch_mix(stage: view<XorMixStage>, x: i64) -> i64 {
    stage.apply(x)
}

fn run_closed_world_devirt() -> i64 {
    let lin = LinearStage { factor: 3, offset: 11 };
    let mix = XorMixStage { mask: 5, addend: 19 };
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 6 {
        if (i & 1) == 0 {
            acc = acc + dispatch_lin(view(lin), i * 4);
        } else {
            acc = acc + dispatch_mix(view(mix), i * 4);
        }
        acc = acc + dispatch_lin(view(lin), i + 1);
        i = i + 1;
    }
    acc
}

fn fn_alpha(x: u64) -> u64 {
    (x ^ 85u64) + 9u64
}

fn fn_beta(x: u64) -> u64 {
    (x ^ 85u64) + 9u64
}

fn invoke_fn_pair(fa: fn(u64) -> u64, fb: fn(u64) -> u64, arg: u64) -> u64 {
    fa(arg) + fb(arg) + 1u64
}

fn run_generic_dedup_and_fn_identity() -> u64 {
    let u1 = unwrap_val<u64>(Wrap<u64> { v: 120u64 });
    let u2 = unwrap_val<usize>(Wrap<usize> { v: 85usize }) as u64;
    let u3 = unwrap_val<i64>(Wrap<i64> { v: 45i64 }) as u64;
    let fp_a: fn(u64) -> u64 = fn_alpha;
    let fp_b: fn(u64) -> u64 = fn_beta;
    u1 + u2 + u3 + invoke_fn_pair(fp_a, fp_b, 20u64)
}

struct ScopedGuard {
    tag: i64,
}

impl Drop for ScopedGuard {
    fn drop(self: mut_view<ScopedGuard>) {
        print_int(self.tag);
    }
}

fn run_inlined_drop_scope() {
    {
        let _g1 = ScopedGuard { tag: 2 };
        let _g2 = ScopedGuard { tag: 5 };
        let _g3 = ScopedGuard { tag: 8 };
    }
    print("\n");
}

pub fn main() -> i32 {
    print_int(run_cross_mod_inline_and_spec());
    print("\n");
    print_int(run_closed_world_devirt());
    print("\n");
    print_int(run_generic_dedup_and_fn_identity() as i64);
    print("\n");
    run_inlined_drop_scope();
    0
}
