// test: diff
// flags: --verify-each
// exit: 0
// stdout: 347\n600\n349910\n

// E15.6 Conformance: PGO round-trip determinism, speculative devirtualization
// guard fallback, zero-count cold branch preservation, constant-time secret
// zeroize barrier, and ordered MMIO/sequence contracts (SPEC-75 §11,
// AXS-PGO-001..008, REQ-OPT-246..250).

trait PgoReceiver {
    fn eval(self: view<Self>, x: i64) -> i64;
}

struct HotTarget {
    scale: i64,
}

struct ColdFallbackTarget {
    bias: i64,
}

impl PgoReceiver for HotTarget {
    fn eval(self: view<HotTarget>, x: i64) -> i64 {
        x * self.scale + 5
    }
}

impl PgoReceiver for ColdFallbackTarget {
    fn eval(self: view<ColdFallbackTarget>, x: i64) -> i64 {
        x + self.bias
    }
}

fn pgo_speculative_hot(r: view<HotTarget>, x: i64) -> i64 {
    if x >= 0 {
        return r.eval(x) + 3;
    }
    r.eval(-x) + 100
}

fn pgo_speculative_cold(r: view<ColdFallbackTarget>, x: i64) -> i64 {
    if x >= 0 {
        return r.eval(x) + 3;
    }
    r.eval(-x) + 100
}

fn run_pgo_speculative_and_cold_path() -> i64 {
    let hot = HotTarget { scale: 4 };
    let cold = ColdFallbackTarget { bias: 50 };
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 6 {
        acc = acc + pgo_speculative_hot(view(hot), i + 1);
        i = i + 1;
    }
    let cold_branch = pgo_speculative_cold(view(cold), -7);
    let guard_miss = pgo_speculative_cold(view(cold), 5);
    acc + cold_branch + guard_miss
}

fn ct_select_u64(cond_bit: u64, a: u64, b: u64) -> u64 {
    let bit = cond_bit & 1u64;
    let inv_bit = bit ^ 1u64;
    (a * bit) + (b * inv_bit)
}

fn zeroize_secret_word(slot: mut_view<u64>) {
    *slot = 0u64;
}

fn run_constant_time_and_zeroize_barrier() -> i64 {
    let s1 = ct_select_u64(1u64, 310u64, 999u64);
    let s2 = ct_select_u64(0u64, 310u64, 190u64);
    let mut w0: u64 = 10u64;
    let mut w1: u64 = 20u64;
    let mut w2: u64 = 30u64;
    let mut w3: u64 = 40u64;
    let pre_sum = w0 + w1 + w2 + w3;
    zeroize_secret_word(mut_view(w0));
    zeroize_secret_word(mut_view(w1));
    zeroize_secret_word(mut_view(w2));
    zeroize_secret_word(mut_view(w3));
    let post_sum = w0 + w1 + w2 + w3;
    (s1 + s2 + pre_sum + post_sum) as i64
}

fn mmio_ordered_write(reg: mut_view<i64>, trace_hash: mut_view<i64>, val: i64) {
    *reg = val;
    let observed = *reg;
    *trace_hash = (*trace_hash) * 31 + observed;
}

fn run_ordered_mmio_sequence() -> i64 {
    let mut mmio_trace_hash: i64 = 0;
    let mut mmio_last_reg: i64 = 0;
    mmio_ordered_write(mut_view(mmio_last_reg), mut_view(mmio_trace_hash), 11);
    mmio_ordered_write(mut_view(mmio_last_reg), mut_view(mmio_trace_hash), 22);
    mmio_ordered_write(mut_view(mmio_last_reg), mut_view(mmio_trace_hash), 33);
    mmio_ordered_write(mut_view(mmio_last_reg), mut_view(mmio_trace_hash), 44);
    mmio_trace_hash
}

pub fn main() -> i32 {
    print_int(run_pgo_speculative_and_cold_path());
    print("\n");
    print_int(run_constant_time_and_zeroize_barrier());
    print("\n");
    print_int(run_ordered_mmio_sequence());
    print("\n");
    0
}
