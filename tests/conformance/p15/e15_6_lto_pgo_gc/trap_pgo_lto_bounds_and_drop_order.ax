// test: run
// modes: interp native
// exit: 101
// stdout: 60\n414141\n

// E15.6 Conformance: PGO/LTO epistemic safety invariant — 100%-taken hot in-bounds
// paths never elide cold panic/bounds traps, and LIFO Drop ordering before the trap
// is preserved identically across --interp and -O0/-O1/-O2 (SPEC-75 §11.2,
// AXS-PGO-002, REQ-OPT-224, REQ-OPT-246..250).

@intrinsic fn panic() {}

struct StepGuard {
    id: i64,
}

impl Drop for StepGuard {
    fn drop(self: mut_view<StepGuard>) {
        print_int(self.id);
    }
}

fn hot_guarded_lookup(idx: usize) -> i64 {
    let arr: [6]i64 = [10, 20, 30, 40, 50, 60];
    if idx >= 6 {
        panic();
    }
    arr[idx]
}

fn run_drop_trace_step() {
    let _g_outer = StepGuard { id: 1 };
    let _g_inner = StepGuard { id: 4 };
}

pub fn main() -> i32 {
    let v0 = hot_guarded_lookup(0);
    let v1 = hot_guarded_lookup(1);
    let v2 = hot_guarded_lookup(2);
    print_int(v0 + v1 + v2);
    print("\n");
    run_drop_trace_step();
    run_drop_trace_step();
    run_drop_trace_step();
    print("\n");
    let boom = hot_guarded_lookup(6);
    print_int(boom);
    print("\n");
    0
}
