// test: diff
// flags: --verify-each
// stdout: CFG_MEMPHI=1293\nSCCP_PRUNE=135\nGVN_ALIAS=464\nCFG_TOTAL=1892\n

// E15.1 Conformance (REQ-OPT-037..041, REQ-OPT-343):
// Complex diamond + nested-loop + multi-arm SwitchInt CFGs exercising OptIR SSA phi
// placement, MemorySSA MemoryPhi joins, loop-backedge clobber hazards, SCCP unreachable
// branch pruning with trap hazards on dead edges, dominator-scoped commutative GVN/CSE,
// and NoAlias view/mut_view forwarding vs UnknownAlias raw-pointer reloads.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn add_view_into(dst: mut_view<i32>, src: view<i32>) {
    *dst = *dst + *src;
}

fn forward_across_disjoint_mut_view(dst: mut_view<i32>, ro: view<i32>) -> i32 {
    let r1: i32 = *ro;
    *dst = 65;
    let r2: i32 = *ro;
    let d1: i32 = *dst;
    r1 + r2 + d1
}

fn diamond_loop_memphi(rounds: i32, seed: i32) -> i32 {
    let mut acc: i32 = seed;
    let mut mem_slot_a: i32 = 3;
    let mut mem_slot_b: i32 = 7;
    let mut outer: i32 = 0;

    while outer < rounds {
        let mut branch_phi: i32 = 0;
        if (outer % 2) == 0 {
            add_view_into(mut_view(mem_slot_a), view(mem_slot_b));
            branch_phi = 11;
        } else {
            add_view_into(mut_view(mem_slot_b), view(mem_slot_a));
            branch_phi = 23;
        }

        // Loop-backedge clobber hazard: `clob` is mutated inside inner loop,
        // so `post_sum` must not reuse `pre_sum` across the loop header phi.
        let mut clob: i32 = branch_phi + outer;
        let pre_sum: i32 = clob + 5;
        let mut inner: i32 = 0;
        while inner < 2 {
            clob = clob + 3;
            inner = inner + 1;
        }
        let post_sum: i32 = clob + 5;

        let match_val: i32 = match outer {
            0 => 100,
            1 => 200,
            2 => 300,
            _ => 400,
        };

        acc = acc + pre_sum + post_sum + match_val;
        outer = outer + 1;
    }

    acc + mem_slot_a + mem_slot_b
}

fn sccp_dead_edges_with_traps() -> i32 {
    let k1: i32 = 14;
    let k2: i32 = 28;
    let sum_k: i32 = k1 + k2;
    let tag: i32 = if sum_k == 42 {
        2
    } else {
        100 / (k2 - 28)
    };

    let res: i32 = match tag {
        0 => 2147483647 + (tag + 1),
        1 => (-2147483647 - 1) / (tag - 2),
        2 => (sum_k * 3) + 9,
        _ => 999 / (tag - 2),
    };
    res
}

fn dominator_gvn_and_alias_forwarding(a: i32, b: i32, take_left: bool) -> i32 {
    let sum1: i32 = a + b;
    let xor1: i32 = a ^ b;

    let sib: i32 = if take_left {
        (b + a) + 10
    } else {
        (b + a) + 20
    };

    let sum2: i32 = b + a;
    let xor2: i32 = b ^ a;

    let mut slot_x: i32 = 50;
    let mut slot_y: i32 = 80;
    let fwd_noalias: i32 = forward_across_disjoint_mut_view(mut_view(slot_x), view(slot_y));

    let mut raw_cell: i32 = 30;
    let pr: *const i32 = unsafe { address_of(raw_cell) };
    let pw: *mut i32 = unsafe { address_of_mut(raw_cell) };
    let before: i32 = unsafe { *pr };
    unsafe {
        *pw = 45;
    }
    let after: i32 = unsafe { *pr };
    let raw_sum: i32 = before + after;

    sum1 + sum2 + xor1 + xor2 + sib + fwd_noalias + raw_sum
}

fn main() -> i32 {
    let cfg_memphi: i32 = diamond_loop_memphi(4, 10);
    print("CFG_MEMPHI=");
    print_int(cfg_memphi);
    print("\n");

    let sccp_prune: i32 = sccp_dead_edges_with_traps();
    print("SCCP_PRUNE=");
    print_int(sccp_prune);
    print("\n");

    let gvn_alias: i32 = dominator_gvn_and_alias_forwarding(19, 27, true);
    print("GVN_ALIAS=");
    print_int(gvn_alias);
    print("\n");

    let total: i32 = cfg_memphi + sccp_prune + gvn_alias;
    print("CFG_TOTAL=");
    print_int(total);
    print("\n");

    if cfg_memphi != 1293 || sccp_prune != 135 || gvn_alias != 464 || total != 1892 {
        return 1;
    }
    0
}
