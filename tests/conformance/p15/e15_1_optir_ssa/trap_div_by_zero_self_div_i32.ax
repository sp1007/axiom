// test: diff
// flags: --verify-each
// exit: 101

// E15.1 Conformance (REQ-OPT-041, REQ-OPT-343):
// Self-division `z / z` without `Proven` `NonZero` must NOT fold to `1`;
// when `z == 0` at runtime, it must panic with exit code 101.

fn runtime_zero_i32(steps: i32) -> i32 {
    let mut v: i32 = steps;
    let mut i: i32 = 0;
    while i < steps {
        v = v - 1;
        i = i + 1;
    }
    v
}

fn main() -> i32 {
    let z: i32 = runtime_zero_i32(4);
    let q: i32 = z / z;
    q
}
