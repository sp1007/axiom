// test: diff
// flags: --verify-each
// stdout: GREETING=Xin chào thế giới\nCLONE=1\nCLONE=2\nCLONE=3\nDROP=32\nDROP=31\nIO_STEP=1\nIO_STEP=2\nZEROIZE_CHECK=0\nDROP=22\nDROP=21\nDROP=40\nDROP=41\nIO_STEP=3\nDROP=10\nEFFECTS_DONE=69\n

// E15.1 Conformance (REQ-OPT-037..041, REQ-OPT-343):
// Verifies strict preservation of observable effects: UTF-8 I/O ordering, deterministic
// reverse-declaration Drop ordering across nested scopes / early returns / loops,
// explicit Clone side-effect retention (both unused and back-to-back calls),
// raw-pointer read-modify-write barrier ordering, and secret-buffer zeroization.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

struct ScopeGuard {
    id: i32,
}

impl Drop for ScopeGuard {
    fn drop(self: mut_view<ScopeGuard>) {
        print("DROP=");
        print_int(self.id);
        print("\n");
    }
}

struct AuditRecord {
    val: i32,
}

struct SecretBuf8 {
    b0: u8,
    b1: u8,
    b2: u8,
    b3: u8,
    b4: u8,
    b5: u8,
    b6: u8,
    b7: u8,
}

fn clone_record(src: view<AuditRecord>, seq: mut_view<i32>) -> AuditRecord {
    *seq = *seq + 1;
    print("CLONE=");
    print_int(*seq);
    print("\n");
    AuditRecord { val: (*src).val }
}

fn early_return_guards(trigger_early: bool) -> i32 {
    let g31 = ScopeGuard { id: 31 };
    let g32 = ScopeGuard { id: 32 };
    if trigger_early {
        let _ = g31.id + g32.id;
        return 7;
    }
    g31.id + g32.id
}

fn run_effects_suite() -> i32 {
    print("GREETING=Xin chào thế giới\n");
    let g_outer = ScopeGuard { id: 10 };

    let mut clone_seq: i32 = 0;
    let base_rec = AuditRecord { val: 14 };

    // Unused explicit clone must NOT be eliminated by DCE.
    let unused_c1 = clone_record(view(base_rec), mut_view(clone_seq));
    let _ = unused_c1.val;

    // Back-to-back explicit clones must NOT be merged by GVN/CSE.
    let c2 = clone_record(view(base_rec), mut_view(clone_seq));
    let c3 = clone_record(view(base_rec), mut_view(clone_seq));

    let early_v: i32 = early_return_guards(true);

    let mut raw_out: i32 = 0;
    let mut zero_sum: i32 = 99;
    {
        let g21 = ScopeGuard { id: 21 };
        let g22 = ScopeGuard { id: 22 };
        print("IO_STEP=1\n");

        let mut raw_barrier_cell: i32 = 20;
        let p_mut: *mut i32 = unsafe { address_of_mut(raw_barrier_cell) };
        let p_ro: *const i32 = unsafe { address_of(raw_barrier_cell) };
        unsafe {
            *p_mut = *p_ro + 5;
        }
        print("IO_STEP=2\n");
        unsafe {
            *p_mut = *p_ro + 6;
        }
        raw_out = unsafe { *p_ro };

        let mut secret = SecretBuf8 {
            b0: 161u8,
            b1: 162u8,
            b2: 163u8,
            b3: 164u8,
            b4: 165u8,
            b5: 166u8,
            b6: 167u8,
            b7: 168u8,
        };
        unsafe {
            let wipe_ptr: *mut u8 = address_of_mut(secret) as *mut u8;
            ptr_write_bytes<u8>(wipe_ptr, 0u8, 8);
        }
        let rd_ptr: *const u8 = unsafe { address_of(secret) as *const u8 };
        let mut idx: usize = 0;
        let mut sum_bytes: i32 = 0;
        while idx < 8 {
            let b: i32 = unsafe { (*(rd_ptr + idx)) as i32 };
            sum_bytes = sum_bytes + b;
            idx = idx + 1;
        }
        zero_sum = sum_bytes;
        print("ZEROIZE_CHECK=");
        print_int(zero_sum);
        print("\n");
        let _ = g21.id + g22.id;
    }

    let mut loop_k: i32 = 0;
    while loop_k < 2 {
        let gl = ScopeGuard { id: 40 + loop_k };
        let _ = gl.id;
        loop_k = loop_k + 1;
    }

    print("IO_STEP=3\n");
    let _ = g_outer.id;
    c2.val + c3.val + clone_seq + early_v + raw_out + zero_sum
}

fn main() -> i32 {
    let res: i32 = run_effects_suite();
    print("EFFECTS_DONE=");
    print_int(res);
    print("\n");
    if res != 69 {
        return 1;
    }
    0
}
