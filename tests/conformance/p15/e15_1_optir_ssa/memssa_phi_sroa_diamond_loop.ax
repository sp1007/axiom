// test: diff
// flags: --verify-each
// stdout: MEMSSA_SROA_CFG=368\n

// E15.1 Conformance (REQ-OPT-037..041, REQ-OPT-343):
// Pure monomorphic CFG exercising OptIR SSA phi placement, MemorySSA LiveOnEntry /
// MemoryPhi / MemoryDef / MemoryUse chains across diamond + loop + match edges,
// 4-field SROA scalar replacement, NoAlias view/mut_view borrows, and ProofProvenance.

struct Vec4 {
    x: i32,
    y: i32,
    z: i32,
    w: i32,
}

struct AccumPair {
    left: i32,
    right: i32,
}

fn read_pair_sum(p: view<AccumPair>) -> i32 {
    (*p).left + (*p).right
}

fn bump_left(p: mut_view<AccumPair>, delta: view<i32>) {
    (*p).left = (*p).left + *delta;
}

fn bump_right(p: mut_view<AccumPair>, delta: view<i32>) {
    (*p).right = (*p).right + *delta;
}

fn run_memssa_sroa_cfg(rounds: i32) -> i32 {
    let mut v = Vec4 { x: 2, y: 4, z: 6, w: 8 };
    v.x = v.x + 3;
    v.w = v.y + v.z;
    let sroa_base: i32 = v.x + v.y + v.z + v.w;

    let mut pair = AccumPair { left: 10, right: 20 };
    let d_even: i32 = 7;
    let d_odd: i32 = 13;
    let mut acc: i32 = sroa_base;
    let mut i: i32 = 0;

    while i < rounds {
        let mut phi_step: i32 = 0;
        if (i % 2) == 0 {
            bump_left(mut_view(pair), view(d_even));
            phi_step = 5;
        } else {
            bump_right(mut_view(pair), view(d_odd));
            phi_step = 9;
        }

        let tag_bonus: i32 = match i {
            0 => 10,
            1 => 20,
            2 => 30,
            _ => 40,
        };

        acc = acc + phi_step + tag_bonus + read_pair_sum(view(pair));
        i = i + 1;
    }

    let nz: i32 = read_pair_sum(view(pair));
    let prov_one: i32 = if nz > 0 {
        70 / nz
    } else {
        0
    };
    acc + prov_one
}

fn main() -> i32 {
    let res: i32 = run_memssa_sroa_cfg(4);
    print("MEMSSA_SROA_CFG=");
    print_int(res);
    print("\n");
    if res != 368 {
        return 1;
    }
    0
}
