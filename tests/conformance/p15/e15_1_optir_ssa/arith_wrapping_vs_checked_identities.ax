// test: diff
// flags: --verify-each
// stdout: SIGNED_WRAP=15\nUNSIGNED_WRAP=15\nCHECKED_SAFE=230\nARITH_TOTAL=260\n

// E15.1 Conformance (REQ-OPT-041, REQ-OPT-343):
// Verifies wrapping modular arithmetic identities across all 8 integer widths
// (i8, i16, i32, i64, u8, u16, u32, u64), bit-manipulation intrinsics, checked
// safe discrete identities, Proven NonZero self-division, and subword safe signed divisions.

@intrinsic fn wrapping_add_i8(a: i8, b: i8) -> i8 { 0i8 }
@intrinsic fn wrapping_sub_i8(a: i8, b: i8) -> i8 { 0i8 }
@intrinsic fn wrapping_mul_i8(a: i8, b: i8) -> i8 { 0i8 }
@intrinsic fn wrapping_neg_i8(a: i8) -> i8 { 0i8 }

@intrinsic fn wrapping_add_i16(a: i16, b: i16) -> i16 { 0i16 }
@intrinsic fn wrapping_sub_i16(a: i16, b: i16) -> i16 { 0i16 }
@intrinsic fn wrapping_mul_i16(a: i16, b: i16) -> i16 { 0i16 }
@intrinsic fn wrapping_neg_i16(a: i16) -> i16 { 0i16 }

@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_sub_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_neg_i32(a: i32) -> i32 { 0 }

@intrinsic fn wrapping_add_i64(a: i64, b: i64) -> i64 { 0i64 }
@intrinsic fn wrapping_sub_i64(a: i64, b: i64) -> i64 { 0i64 }
@intrinsic fn wrapping_mul_i64(a: i64, b: i64) -> i64 { 0i64 }
@intrinsic fn wrapping_neg_i64(a: i64) -> i64 { 0i64 }

@intrinsic fn wrapping_add_u8(a: u8, b: u8) -> u8 { 0u8 }
@intrinsic fn wrapping_sub_u8(a: u8, b: u8) -> u8 { 0u8 }
@intrinsic fn wrapping_mul_u8(a: u8, b: u8) -> u8 { 0u8 }
@intrinsic fn rotate_left_u8(a: u8, n: u32) -> u8 { 0u8 }
@intrinsic fn count_ones_u8(a: u8) -> u32 { 0u32 }

@intrinsic fn wrapping_add_u16(a: u16, b: u16) -> u16 { 0u16 }
@intrinsic fn wrapping_sub_u16(a: u16, b: u16) -> u16 { 0u16 }
@intrinsic fn wrapping_mul_u16(a: u16, b: u16) -> u16 { 0u16 }
@intrinsic fn leading_zeros_u16(a: u16) -> u32 { 0u32 }
@intrinsic fn trailing_zeros_u16(a: u16) -> u32 { 0u32 }

@intrinsic fn wrapping_add_u32(a: u32, b: u32) -> u32 { 0u32 }
@intrinsic fn wrapping_sub_u32(a: u32, b: u32) -> u32 { 0u32 }
@intrinsic fn rotate_right_u32(a: u32, n: u32) -> u32 { 0u32 }

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0u64 }
@intrinsic fn wrapping_sub_u64(a: u64, b: u64) -> u64 { 0u64 }

fn test_signed_wrapping_all_widths() -> i32 {
    let mut score: i32 = 0;

    let max8: i8 = 127i8;
    let min8: i8 = -128i8;
    if wrapping_add_i8(max8, 1i8) == min8 &&
       wrapping_sub_i8(min8, 1i8) == max8 &&
       wrapping_mul_i8(64i8, 2i8) == min8 &&
       wrapping_neg_i8(min8) == min8 &&
       wrapping_sub_i8(wrapping_add_i8(max8, 55i8), 55i8) == max8 {
        score = score + 1;
    }

    let max16: i16 = 32767i16;
    let min16: i16 = -32767i16 - 1i16;
    if wrapping_add_i16(max16, 1i16) == min16 &&
       wrapping_sub_i16(min16, 1i16) == max16 &&
       wrapping_mul_i16(16384i16, 2i16) == min16 &&
       wrapping_neg_i16(min16) == min16 &&
       wrapping_sub_i16(wrapping_add_i16(max16, 1234i16), 1234i16) == max16 {
        score = score + 2;
    }

    let max32: i32 = 2147483647;
    let min32: i32 = -2147483647 - 1;
    let reassoc32: i32 = wrapping_add_i32(wrapping_add_i32(300000000, 2000000000), 2000000000);
    if wrapping_add_i32(max32, 1) == min32 &&
       wrapping_sub_i32(min32, 1) == max32 &&
       wrapping_mul_i32(1073741824, 2) == min32 &&
       wrapping_neg_i32(min32) == min32 &&
       wrapping_sub_i32(wrapping_add_i32(max32, 999999), 999999) == max32 &&
       reassoc32 == 5032704 {
        score = score + 4;
    }

    let max64: i64 = 9223372036854775807i64;
    let min64: i64 = -9223372036854775807i64 - 1i64;
    if wrapping_add_i64(max64, 1i64) == min64 &&
       wrapping_sub_i64(min64, 1i64) == max64 &&
       wrapping_mul_i64(4611686018427387904i64, 2i64) == min64 &&
       wrapping_neg_i64(min64) == min64 &&
       wrapping_sub_i64(wrapping_add_i64(max64, 7777777i64), 7777777i64) == max64 {
        score = score + 8;
    }

    score
}

fn test_unsigned_wrapping_and_bits() -> i32 {
    let mut score: i32 = 0;

    if wrapping_add_u8(255u8, 1u8) == 0u8 &&
       wrapping_sub_u8(0u8, 1u8) == 255u8 &&
       wrapping_mul_u8(128u8, 2u8) == 0u8 &&
       rotate_left_u8(129u8, 1u32) == 3u8 &&
       count_ones_u8(170u8) == 4u32 {
        score = score + 1;
    }

    if wrapping_add_u16(65535u16, 1u16) == 0u16 &&
       wrapping_sub_u16(0u16, 1u16) == 65535u16 &&
       wrapping_mul_u16(32768u16, 2u16) == 0u16 &&
       leading_zeros_u16(256u16) == 7u32 &&
       trailing_zeros_u16(256u16) == 8u32 {
        score = score + 2;
    }

    let max_u32: u32 = 4294967295u32;
    if wrapping_add_u32(max_u32, 1u32) == 0u32 &&
       wrapping_sub_u32(0u32, 1u32) == max_u32 &&
       wrapping_sub_u32(wrapping_add_u32(max_u32, 42u32), 42u32) == max_u32 &&
       rotate_right_u32(1u32, 1u32) == 2147483648u32 {
        score = score + 4;
    }

    let max_u64: u64 = 18446744073709551615u64;
    if wrapping_add_u64(max_u64, 1u64) == 0u64 &&
       wrapping_sub_u64(0u64, 1u64) == max_u64 &&
       wrapping_sub_u64(wrapping_add_u64(max_u64, 99u64), 99u64) == max_u64 {
        score = score + 8;
    }

    score
}

fn test_checked_safe_identities(x: i32, nz: i32, flag: bool) -> i32 {
    let id1: i32 = (0 + x) + (x + 0) + (x - 0);
    let id2: i32 = (x * 1) + (1 * x) + (x / 1);
    let zeros: i32 = (x * 0) + (0 * x) + (x % 1) + (x - x) + (x ^ x);
    let bit_id: i32 = (((x & x) | x) ^ 0) + (~(~x));
    let keep_flag: bool = !(!flag);
    let nz_part: i32 = if nz != 0 && keep_flag {
        ((nz / nz) * 30) + (nz % nz)
    } else {
        0
    };

    let min16: i16 = -32767i16 - 1i16;
    let sw_ok: i32 = if ((-128i8) / 2i8 == -64i8) &&
                        ((-127i8) / (-1i8) == 127i8) &&
                        ((min16 / 2i16) == -16384i16) &&
                        ((-32767i16) / (-1i16) == 32767i16) {
        16
    } else {
        0
    };

    id1 + id2 + zeros + bit_id + nz_part + sw_ok
}

fn main() -> i32 {
    let s_wrap: i32 = test_signed_wrapping_all_widths();
    print("SIGNED_WRAP=");
    print_int(s_wrap);
    print("\n");

    let u_wrap: i32 = test_unsigned_wrapping_and_bits();
    print("UNSIGNED_WRAP=");
    print_int(u_wrap);
    print("\n");

    let c_safe: i32 = test_checked_safe_identities(23, -41, true);
    print("CHECKED_SAFE=");
    print_int(c_safe);
    print("\n");

    let total: i32 = s_wrap + u_wrap + c_safe;
    print("ARITH_TOTAL=");
    print_int(total);
    print("\n");

    if s_wrap != 15 || u_wrap != 15 || c_safe != 230 || total != 260 {
        return 1;
    }
    0
}
