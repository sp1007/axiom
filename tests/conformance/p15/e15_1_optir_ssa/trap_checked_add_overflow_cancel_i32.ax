// test: diff
// flags: --verify-each
// exit: 101

// E15.1 Conformance (REQ-OPT-041, REQ-OPT-343):
// Checked `(x + 1) - 1` at `i32::MAX` must NOT be cancelled to `x` by InstCombine;
// must trap with exit code 101 across --interp, -O0, -O1, and -O2 --verify-each.

fn runtime_i32_max(steps: i32) -> i32 {
    let mut base: i32 = 2147483644;
    let mut i: i32 = 0;
    while i < steps {
        base = base + 1;
        i = i + 1;
    }
    base
}

fn main() -> i32 {
    let x: i32 = runtime_i32_max(3);
    let r: i32 = (x + 1) - 1;
    if r == x {
        return 0;
    }
    1
}
