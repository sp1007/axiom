@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@PROBE_MIR_FN@

fn probe_mir_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn diag_buffers_equal(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len || a.len == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba: u8 = unsafe { *(a.ptr + i) };
        let bb: u8 = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn make_zero_stats() -> ScalarOptStats {
    ScalarOptStats {
        sccp_consts_folded: 0u32,
        sccp_branches_folded: 0u32,
        sccp_blocks_pruned: 0u32,
        inst_combine_rewrites: 0u32,
        gvn_cse_eliminated: 0u32,
        gvn_loads_forwarded: 0u32,
        gvn_pure_calls_eliminated: 0u32,
        dce_insts_eliminated: 0u32,
        dce_dead_stores_eliminated: 0u32,
        dce_move_copy_elided: 0u32,
        cfg_edges_simplified: 0u32,
        rejected_candidates: 0u32,
    }
}

// Stage 1: OptIR SSA, MemorySSA, Dominators, Alias Lattice, Deterministic Printer, and Verified-MIR Gate
fn verify_stage_optir_memssa(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let in5 = probe_mir_blob(mut_view(*arena), 5);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m5 = verify_parse_mir(in5, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m5 as usize) == 0 {
        return 101;
    }
    let ob5 = optir_build_from_mir(unsafe { view(*m5) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (ob5 as usize) == 0 || sink.errors != 0 || !optir_verify_contract(unsafe { view(*ob5) }) {
        return 102;
    }
    if (unsafe { (*ob5).bb_count }) < 4 || (unsafe { (*ob5).mem_ssa_count }) < 2 {
        return 103;
    }

    // Alias lattice & certainty mapping
    let p_loc2 = mir_local_place(2u32);
    let p_loc3 = mir_local_place(3u32);
    let reg2 = optir_extract_memory_region(unsafe { view(*ob5) }, view(p_loc2));
    let reg3 = optir_extract_memory_region(unsafe { view(*ob5) }, view(p_loc3));
    let aq_disjoint = optir_alias_query(unsafe { view(*ob5) }, view(reg2), view(reg3));
    let aq_same = optir_alias_query(unsafe { view(*ob5) }, view(reg2), view(reg2));
    if reg2.domain != STORAGE_STACK_LOCAL ||
       aq_disjoint != ALIAS_NO_ALIAS ||
       aq_same != ALIAS_MUST_ALIAS ||
       optir_alias_certainty(ALIAS_NO_ALIAS) != CERTAINTY_PROVEN ||
       optir_alias_certainty(ALIAS_MUST_ALIAS) != CERTAINTY_PROVEN ||
       optir_alias_certainty(ALIAS_MAY_ALIAS) != CERTAINTY_POSSIBLE ||
       optir_alias_certainty(ALIAS_UNKNOWN) != CERTAINTY_UNKNOWN {
        return 104;
    }

    // Deterministic optir_print and memssa_print across repeated invocations
    let mut b_opt1 = diag_buf_new();
    let mut b_opt2 = diag_buf_new();
    optir_print(mut_view(b_opt1), unsafe { view(*ob5) });
    optir_print(mut_view(b_opt2), unsafe { view(*ob5) });
    let opt_eq = diag_buffers_equal(view(b_opt1), view(b_opt2));
    diag_buf_free(mut_view(b_opt1));
    diag_buf_free(mut_view(b_opt2));
    if !opt_eq {
        return 105;
    }

    let mut b_mem1 = diag_buf_new();
    let mut b_mem2 = diag_buf_new();
    memssa_print(mut_view(b_mem1), unsafe { view(*ob5) });
    memssa_print(mut_view(b_mem2), unsafe { view(*ob5) });
    let mem_eq = diag_buffers_equal(view(b_mem1), view(b_mem2));
    diag_buf_free(mut_view(b_mem1));
    diag_buf_free(mut_view(b_mem2));
    if !mem_eq {
        return 106;
    }

    // AXS-OPT-001 Entry Gate: unverified MIR (Blob 6: uninitialized _1 read) must fail closed
    let in6 = probe_mir_blob(mut_view(*arena), 6);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let mut bad_out = diag_buf_new();
    let inspect_ok = optir_inspect_mir_text(in6, false, true, mut_view(bad_out), mut_view(*sink), mut_view(*arena));
    let bad_len = bad_out.len;
    diag_buf_free(mut_view(bad_out));
    if inspect_ok || bad_len != 0 || sink.errors == 0 {
        return 107;
    }

    print("E15_1_STAGE_OPTIR_MEMSSA=OK\n");
    0
}

// Stage 2: EffectInfo Lattice, Execution Domains, >64-node Tarjan SCC CallGraph, and EffectCallTable
fn verify_stage_effects_and_callgraph(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    if !effect_is_pure(EFFECT_PURE) ||
       effect_is_pure(EFFECT_UNKNOWN) ||
       effect_pure_certainty(EFFECT_PURE) != CERTAINTY_PROVEN ||
       effect_pure_certainty(EFFECT_UNKNOWN) != CERTAINTY_UNKNOWN ||
       effect_for_call_kind(CALL_KIND_PURE_INTRINSIC) != EFFECT_PURE ||
       (effect_for_call_kind(CALL_KIND_HOST_IO) & (EFFECT_IO | EFFECT_MAY_PANIC)) != (EFFECT_IO | EFFECT_MAY_PANIC) ||
       (effect_for_call_kind(CALL_KIND_VOLATILE_INTRINSIC) & EFFECT_VOLATILE) == 0u16 ||
       (effect_for_call_kind(CALL_KIND_ATOMIC_INTRINSIC) & EFFECT_ATOMIC) == 0u16 ||
       (effect_for_call_kind(CALL_KIND_INDIRECT_UNKNOWN) & EFFECT_UNKNOWN) == 0u16 {
        return 111;
    }

    if !effect_can_dce(EFFECT_PURE) ||
       !effect_can_dce(EFFECT_READS_MEM) ||
       effect_can_dce(EFFECT_IO) ||
       effect_can_dce(EFFECT_ATOMIC) ||
       effect_can_dce(EFFECT_VOLATILE) ||
       effect_can_dce(EFFECT_MAY_PANIC) ||
       effect_can_reorder(EFFECT_IO, EFFECT_ATOMIC, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_MAY_PANIC, EFFECT_WRITES_MEM, ALIAS_NO_ALIAS) ||
       !effect_can_reorder(EFFECT_WRITES_MEM, EFFECT_READS_MEM, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_WRITES_MEM, EFFECT_READS_MEM, ALIAS_MAY_ALIAS) {
        return 112;
    }

    let io_sum = effect_summary_from_flags(SymbolId { v: 1u32 }, EFFECT_IO);
    let alloc_sum = effect_summary_from_flags(SymbolId { v: 2u32 }, EFFECT_ALLOCATES);
    if !effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_HOST) ||
       effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_COMPTIME) ||
       effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_KERNEL) ||
       !effect_verify_execution_domain(view(alloc_sum), EXEC_DOMAIN_COMPTIME) ||
       effect_verify_execution_domain(view(alloc_sum), EXEC_DOMAIN_KERNEL) {
        return 113;
    }

    let cg = arena_alloc_raw(mut_view(*arena), size_of<EffectCallGraph>(), align_of<EffectCallGraph>()) as *mut EffectCallGraph;
    effect_call_graph_init(unsafe { mut_view(*cg) }, mut_view(*arena), 80, 32);
    let mut k: usize = 0;
    while k < 80 {
        let loc_eff: u16 = if k == 71 {
            EFFECT_IO | EFFECT_MAY_PANIC
        } else if k == 73 {
            EFFECT_VOLATILE
        } else {
            EFFECT_PURE
        };
        let added = effect_call_graph_add_node(unsafe { mut_view(*cg) }, SymbolId { v: (300 + k) as u32 }, loc_eff, false);
        if added != (k as u32) {
            return 114;
        }
        k = k + 1;
    }
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 0u32, 70u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 70u32, 71u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 71u32, 70u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 1u32, 72u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 72u32, 72u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 2u32, 73u32);
    if effect_call_graph_propagate(unsafe { mut_view(*cg) }) == 0u32 {
        return 115;
    }
    let s0 = effect_call_graph_node_summary(unsafe { view(*cg) }, 0u32);
    let s1 = effect_call_graph_node_summary(unsafe { view(*cg) }, 1u32);
    let s2 = effect_call_graph_node_summary(unsafe { view(*cg) }, 2u32);
    if (s0.flags & (EFFECT_IO | EFFECT_MAY_PANIC | EFFECT_NONTERM)) != (EFFECT_IO | EFFECT_MAY_PANIC | EFFECT_NONTERM) ||
       (s1.flags & EFFECT_NONTERM) == 0u16 ||
       (s2.flags & EFFECT_VOLATILE) == 0u16 {
        return 116;
    }
    if effect_call_graph_update_node_local(unsafe { mut_view(*cg) }, 70u32, EFFECT_IO, false) != 0u32 {
        return 117;
    }
    let reeval = effect_call_graph_update_node_local(unsafe { mut_view(*cg) }, 71u32, EFFECT_IO | EFFECT_MAY_PANIC | EFFECT_ATOMIC, false);
    let s0_after = effect_call_graph_node_summary(unsafe { view(*cg) }, 0u32);
    if reeval != 3u32 || (s0_after.flags & EFFECT_ATOMIC) == 0u16 {
        return 118;
    }

    // EffectCallTable integration on Blob 3 (PureCall vs explicit Clone)
    let in3 = probe_mir_blob(mut_view(*arena), 3);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m3 = verify_parse_mir(in3, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m3 as usize) == 0 {
        return 119;
    }
    let o3 = optir_build_from_mir(unsafe { view(*m3) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o3 as usize) == 0 || sink.errors != 0 {
        return 120;
    }
    let bb0 = unsafe { opt_block_at((*o3).blocks, 0) };
    let bb2 = unsafe { opt_block_at((*o3).blocks, 2) };
    let pure_callee = (OptValueId { v: unsafe { (*bb0).term.callee.v } });
    let clone_callee = (OptValueId { v: unsafe { (*bb2).term.callee.v } });
    let ctab = arena_alloc_raw(mut_view(*arena), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ctab) }, mut_view(*arena), 8);
    effect_call_table_register(unsafe { mut_view(*ctab) }, mut_view(*arena), (SymbolId { v: 801u32 }), pure_callee, effect_summary_empty(SymbolId { v: 801u32 }));
    effect_call_table_register(unsafe { mut_view(*ctab) }, mut_view(*arena), (SymbolId { v: 802u32 }), clone_callee, effect_summary_from_flags(SymbolId { v: 802u32 }, EFFECT_ALLOCATES | EFFECT_READS_MEM | EFFECT_WRITES_MEM));
    let body_sum = effect_infer_body_with_table(unsafe { mut_view(*o3) }, mut_view(*arena), ctab as *const EffectCallTable, 64u32);
    if (body_sum.flags & EFFECT_ALLOCATES) == 0u16 || (body_sum.flags & EFFECT_UNKNOWN) != 0u16 {
        return 121;
    }

    print("E15_1_STAGE_EFFECTS_CALLGRAPH=OK\n");
    0
}

// Stage 3: PassManager Analysis DAG, CandidateVerifier, Fault-Injection Rollback + Post-Rollback Scalar Optimization
fn verify_stage_passmgr_and_rollback(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let in5 = probe_mir_blob(mut_view(*arena), 5);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m5 = verify_parse_mir(in5, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m5 as usize) == 0 {
        return 131;
    }
    let ob = optir_build_from_mir(unsafe { view(*m5) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (ob as usize) == 0 || sink.errors != 0 {
        return 132;
    }

    let loc2_place = mir_local_place(2u32);
    let reg_loc2 = optir_extract_memory_region(unsafe { view(*ob) }, view(loc2_place));
    if effect_call_clobbers_region(EFFECT_WRITES_MEM | EFFECT_UNKNOWN, view(reg_loc2), false) ||
       !effect_call_clobbers_region(EFFECT_WRITES_MEM | EFFECT_UNKNOWN, view(reg_loc2), true) {
        return 133;
    }

    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget_o0 = opt_budget_for_profile(OPT_PROFILE_DEBUG_O0, true);
    let budget_o1 = opt_budget_for_profile(OPT_PROFILE_BALANCED_O1, true);
    let budget_o2 = opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, mut_view(*arena));

    // Transitive invalidation & lazy recomputation
    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_SSA);
    if !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_CFG) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_DOMINATORS) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_LOOP_INFO) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_EFFECT_INFO) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_RANGE_INFO) ||
       passmgr_get_analysis_invalidation_count(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) != 1u32 {
        return 134;
    }
    passmgr_ensure_analyses(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, mut_view(*arena), ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_EFFECT_INFO);
    if passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_CFG) != 1u32 ||
       passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) != 2u32 {
        return 135;
    }

    // Two-stage CandidateRewrite legality & profitability gate
    let cur_rev = unsafe { (*pm_ptr).ir_revision };
    let cand_ok = CandidateRewrite {
        pass_id: PASS_SCCP,
        required_prop: PROP_NO_OVERFLOW,
        proof_certainty: CERTAINTY_PROVEN,
        proof_source_analysis: ANALYSIS_RANGE_INFO,
        proof_revision: cur_rev,
        target_effect_flags: EFFECT_PURE,
        src_view_kind: MIR_VIEW_READ,
        dst_view_kind: MIR_VIEW_READ,
        is_removing_inst: false,
        cost_delta: -4i32,
    };
    let mut cand_poss = cand_ok;
    cand_poss.proof_certainty = CERTAINTY_POSSIBLE;
    cand_poss.cost_delta = -200i32;
    let mut cand_unk = cand_ok;
    cand_unk.proof_certainty = CERTAINTY_UNKNOWN;
    let mut cand_stale = cand_ok;
    cand_stale.proof_revision = cur_rev + 3u32;
    let mut cand_cap = cand_ok;
    cand_cap.dst_view_kind = MIR_VIEW_MUT;
    let mut cand_rm_vol = cand_ok;
    cand_rm_vol.is_removing_inst = true;
    cand_rm_vol.target_effect_flags = EFFECT_VOLATILE;
    let mut cand_cost = cand_ok;
    cand_cost.cost_delta = 10i32;

    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_ok)) != CONTRACT_OK ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_poss)) != CONTRACT_ERR_NON_PROVEN_CERTAINTY ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_unk)) != CONTRACT_ERR_NON_PROVEN_CERTAINTY ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_stale)) != CONTRACT_ERR_STALE_PROOF_REVISION ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_cap)) != CONTRACT_ERR_CAPABILITY_PROMOTION ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_rm_vol)) != CONTRACT_ERR_OBSERVABLE_EFFECT_LOSS ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_cost)) != CONTRACT_ERR_COST_UNPROFITABLE {
        return 136;
    }

    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_EFFECT_INFO);
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_ok)) != CONTRACT_ERR_MISSING_ANALYSIS {
        return 137;
    }
    passmgr_ensure_analyses(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, mut_view(*arena), ANALYSIS_MASK_EFFECT_INFO);

    // Fault-injection rollback across IDOM, VOLATILE, ATOMIC, and VIEW->MUT capability promotion
    if passmgr_inject_fault_and_verify(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, PASS_SCCP, FAULT_CORRUPT_IDOM, mut_view(*arena), mut_view(*sink)) != CONTRACT_ERR_POSTCOND_CFG_DOM ||
       passmgr_get_pass_rollback_count(unsafe { view(*pm_ptr) }, PASS_SCCP) != 1u32 ||
       !optir_verify_contract(unsafe { view(*ob) }) {
        return 138;
    }

    let bb0_p = unsafe { opt_block_at((*ob).blocks, 0) };
    let inst0_p = unsafe { opt_inst_at((*bb0_p).insts, 0) };
    let saved_opc = unsafe { (*inst0_p).opcode };

    unsafe {
        (*inst0_p).opcode = OPT_INST_VOLATILE_STORE;
        (*pm_ptr).has_baseline_effects = false;
    }
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, mut_view(*arena));
    if passmgr_inject_fault_and_verify(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, PASS_DCE, FAULT_DROP_VOLATILE_INST, mut_view(*arena), mut_view(*sink)) != CONTRACT_ERR_POSTCOND_EFFECTS ||
       (unsafe { (*inst0_p).opcode }) != OPT_INST_VOLATILE_STORE {
        unsafe { (*inst0_p).opcode = saved_opc; }
        return 139;
    }

    unsafe {
        (*inst0_p).opcode = OPT_INST_ATOMIC;
        (*pm_ptr).has_baseline_effects = false;
    }
    let ato_ieff = effect_infer_inst(unsafe { view(*ob) }, unsafe { view(*inst0_p) }, 64u32);
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, mut_view(*arena));
    if (ato_ieff & EFFECT_ATOMIC) == 0u16 ||
       passmgr_inject_fault_and_verify(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, PASS_DCE, FAULT_DROP_ATOMIC_INST, mut_view(*arena), mut_view(*sink)) != CONTRACT_ERR_POSTCOND_EFFECTS ||
       (unsafe { (*inst0_p).opcode }) != OPT_INST_ATOMIC {
        unsafe { (*inst0_p).opcode = saved_opc; }
        return 140;
    }
    unsafe {
        (*inst0_p).opcode = saved_opc;
        (*pm_ptr).has_baseline_effects = false;
    }

    let view_ty_ptr = arena_alloc_raw(mut_view(*arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    let slot16 = (((unsafe { (*thir_ptr).interner.types }) as usize) + 16 * size_of<*mut AxType>()) as *mut *mut AxType;
    let inst6_p = unsafe { opt_inst_at((*bb0_p).insts, 6) };
    let saved_ty7 = unsafe { *opt_typeid_at((*ob).local_tys, 7) };
    let saved_len = unsafe { (*thir_ptr).interner.len };
    unsafe {
        ax_type_reset(mut_view(*view_ty_ptr), TY_VIEW);
        *slot16 = view_ty_ptr;
        (*thir_ptr).interner.len = 17;
        *opt_typeid_at((*ob).local_tys, 7) = TypeId { v: 17u32 };
    }
    let st_cap = passmgr_inject_fault_and_verify(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*ob) }, PASS_INST_COMBINE, FAULT_PROMOTE_VIEW_TO_MUT, mut_view(*arena), mut_view(*sink));
    let restored_vk = unsafe { (*inst6_p).place.view_kind };
    unsafe {
        *opt_typeid_at((*ob).local_tys, 7) = saved_ty7;
        (*thir_ptr).interner.len = saved_len;
    }
    if st_cap != CONTRACT_ERR_CAPABILITY_PROMOTION || restored_vk == MIR_VIEW_MUT {
        return 141;
    }

    // Verify rolled-back OptBody cleanly runs full E15.1 scalar_run_pipeline + MIR reconstruction + verify_mir!
    let facts = passmgr_collect_body_facts(unsafe { view(*ob) });
    if passmgr_should_schedule_pass(PASS_SCCP, view(budget_o0), view(facts)) ||
       !passmgr_should_schedule_pass(PASS_SCCP, view(budget_o1), view(facts)) ||
       !passmgr_should_schedule_pass(PASS_SCCP, view(budget_o2), view(facts)) {
        return 142;
    }

    let mut stats = make_zero_stats();
    scalar_stats_zero(mut_view(stats));
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    if !scalar_run_pipeline(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*ob) },
        0 as *const EffectCallTable,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    ) || (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        return 143;
    }
    let rec_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*ob) }, unsafe { mut_view(*rec_mir) }, mut_view(*arena)) {
        return 144;
    }
    verify_mir(unsafe { view(*rec_mir) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    if sink.errors != 0 {
        return 145;
    }

    print("E15_1_STAGE_PASSMGR_ROLLBACK=OK\n");
    0
}

// Stage 4: End-to-End Scalar Optimization (SCCP, InstCombine, GVN/CSE, DCE, CFGSimplify),
// Abstraction Erasure (REQ-OPT-039..040), Hazard Rejection, and All-5-Barriers Pipeline Retention (REQ-OPT-041)
fn verify_stage_scalar_and_barriers(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget_o2 = opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true);
    let mut stats = make_zero_stats();

    // 4A. Blob 0: SCCP Wegman-Zadeck dead-branch pruning + black_box barrier + non-folding of trapping consts
    let in0 = probe_mir_blob(mut_view(*arena), 0);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m0 = verify_parse_mir(in0, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m0 as usize) == 0 {
        return 151;
    }
    let o0 = optir_build_from_mir(unsafe { view(*m0) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o0 as usize) == 0 || sink.errors != 0 {
        return 152;
    }
    let bb0_0 = unsafe { opt_block_at((*o0).blocks, 0) };
    let inst_bb0 = unsafe { opt_inst_at((*bb0_0).insts, 3) };
    unsafe {
        (*inst_bb0).opcode = OPT_INST_BLACK_BOX;
        (*inst_bb0).flags = (*inst_bb0).flags | OPT_FLAG_BARRIER;
    }
    optir_construct_memssa(unsafe { mut_view(*o0) }, mut_view(*arena));
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o0) }, mut_view(*arena));
    scalar_stats_zero(mut_view(stats));
    if !scalar_run_pass(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*o0) },
        PASS_SCCP,
        0 as *const EffectCallTable,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    ) || (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        return 153;
    }
    let inst_ovf0 = unsafe { opt_inst_at((*bb0_0).insts, 1) };
    let inst_divz0 = unsafe { opt_inst_at((*bb0_0).insts, 2) };
    // SCCP must refuse to fold both 127i8 + 1i8 (overflow) and 10i8 / 0i8 (div-by-zero), and keep black_box
    if (unsafe { (*inst_ovf0).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*inst_divz0).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*inst_bb0).opcode }) != OPT_INST_BLACK_BOX {
        return 154;
    }
    // Full pipeline must prune dead branches bb2/bb5 while keeping MayTrap div-by-zero & black_box barrier!
    if !scalar_run_pipeline(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*o0) },
        0 as *const EffectCallTable,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    ) || (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        return 154;
    }
    let bb2_0 = unsafe { opt_block_at((*o0).blocks, 2) };
    let bb5_0 = unsafe { opt_block_at((*o0).blocks, 5) };
    if (unsafe { (*bb2_0).is_reachable }) ||
       (unsafe { (*bb2_0).term.kind }) != OPT_TERM_UNREACHABLE ||
       (unsafe { (*bb5_0).is_reachable }) ||
       (unsafe { (*bb5_0).term.kind }) != OPT_TERM_UNREACHABLE ||
       (unsafe { (*inst_divz0).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*inst_bb0).opcode }) != OPT_INST_BLACK_BOX {
        return 154;
    }

    // 4B. Blob 1: InstCombine wrapping rewrites + NonZero self-div vs checked/unbounded/FP-hazard rejection
    let in1 = probe_mir_blob(mut_view(*arena), 1);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m1 = verify_parse_mir(in1, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m1 as usize) == 0 {
        return 155;
    }
    let o1 = optir_build_from_mir(unsafe { view(*m1) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o1 as usize) == 0 || sink.errors != 0 {
        return 156;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o1) }, mut_view(*arena));
    let bb3_1 = unsafe { opt_block_at((*o1).blocks, 3) };
    let inst_wrap1 = unsafe { opt_inst_at((*bb3_1).insts, 1) };
    if scalar_classify_inst_intrinsic(unsafe { view(*inst_wrap1) }) != INTRINSIC_SEM_WRAPPING_ARITH {
        return 157;
    }
    let inst_nz_div = unsafe { opt_inst_at((*bb3_1).insts, 6) };
    let nz_rng = unsafe { opt_range_at((*o1).ranges, (*inst_nz_div).lhs.v as usize) };
    unsafe {
        (*nz_rng).has_range = true;
        (*nz_rng).non_zero_certainty = CERTAINTY_PROVEN;
        (*nz_rng).lo = 5u64;
        (*nz_rng).hi = 10u64;
    }
    let inst_fp = unsafe { opt_inst_at((*bb3_1).insts, 9) };
    let fp_rng = unsafe { opt_range_at((*o1).ranges, (*inst_fp).lhs.v as usize) };
    unsafe {
        (*fp_rng).has_range = true;
        (*fp_rng).has_fp_hazard = true;
    }
    scalar_stats_zero(mut_view(stats));
    if !scalar_run_inst_combine(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o1) }, mut_view(stats), mut_view(*arena)) ||
       passmgr_verify_postconditions(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o1) }, PASS_INST_COMBINE, mut_view(*arena), mut_view(*sink)) != CONTRACT_OK {
        return 158;
    }
    let i_canon_add0 = unsafe { opt_inst_at((*bb3_1).insts, 0) };
    let i_wrap_cancel = unsafe { opt_inst_at((*bb3_1).insts, 2) };
    let i_chk_cancel = unsafe { opt_inst_at((*bb3_1).insts, 4) };
    let i_unk_div = unsafe { opt_inst_at((*bb3_1).insts, 5) };
    let i_prov_div = unsafe { opt_inst_at((*bb3_1).insts, 6) };
    let i_wrap_reassoc = unsafe { opt_inst_at((*bb3_1).insts, 8) };
    if (unsafe { (*i_canon_add0).opcode }) != OPT_INST_COPY ||
       (unsafe { (*i_wrap_cancel).opcode }) != OPT_INST_COPY ||
       (unsafe { (*i_prov_div).opcode }) != OPT_INST_CONST ||
       (unsafe { (*i_wrap_reassoc).opcode }) != OPT_INST_WRAPPING_BINOP ||
       (unsafe { (*i_wrap_reassoc).sub_op }) != MIR_BINOP_WRAPPING_ADD ||
       (unsafe { (*i_chk_cancel).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*i_unk_div).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*inst_fp).opcode }) != OPT_INST_BINOP ||
       (stats.rejected_candidates) < 3u32 {
        return 159;
    }

    // 4C. Blob 2 & Blob 3: Dominator GVN/CSE, NoAlias store-to-load forwarding, and PureCall vs explicit Clone
    let in2 = probe_mir_blob(mut_view(*arena), 2);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m2 = verify_parse_mir(in2, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m2 as usize) == 0 {
        return 160;
    }
    let o2 = optir_build_from_mir(unsafe { view(*m2) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o2 as usize) == 0 || sink.errors != 0 {
        return 161;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o2) }, mut_view(*arena));
    scalar_stats_zero(mut_view(stats));
    if !scalar_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o2) }, PASS_GVN_CSE, 0 as *const EffectCallTable, mut_view(stats), mut_view(*arena), mut_view(*sink)) ||
       (stats.gvn_cse_eliminated) < 1u32 ||
       stats.gvn_loads_forwarded != 1u32 {
        return 162;
    }
    let bb3_2 = unsafe { opt_block_at((*o2).blocks, 3) };
    let i_clob_or = unsafe { opt_inst_at((*bb3_2).insts, 2) };
    let i_comm_xor = unsafe { opt_inst_at((*bb3_2).insts, 4) };
    let i_fwd_ld = unsafe { opt_inst_at((*bb3_2).insts, 7) };
    let fwd_val = unsafe { opt_val_at((*o2).values, (*i_fwd_ld).result.v as usize) };
    if (unsafe { (*i_clob_or).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*i_comm_xor).opcode }) != OPT_INST_COPY ||
       (unsafe { (*i_fwd_ld).opcode }) != OPT_INST_CONST ||
       (unsafe { (*fwd_val).const_val.val }) != 77u64 {
        return 163;
    }

    let in3 = probe_mir_blob(mut_view(*arena), 3);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m3 = verify_parse_mir(in3, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m3 as usize) == 0 {
        return 164;
    }
    let o3 = optir_build_from_mir(unsafe { view(*m3) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o3 as usize) == 0 || sink.errors != 0 {
        return 165;
    }
    let bb0_3 = unsafe { opt_block_at((*o3).blocks, 0) };
    let bb2_3 = unsafe { opt_block_at((*o3).blocks, 2) };
    let pure_cal = (OptValueId { v: unsafe { (*bb0_3).term.callee.v } });
    let clone_cal = (OptValueId { v: unsafe { (*bb2_3).term.callee.v } });
    let ctab3 = arena_alloc_raw(mut_view(*arena), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ctab3) }, mut_view(*arena), 8);
    effect_call_table_register(unsafe { mut_view(*ctab3) }, mut_view(*arena), (SymbolId { v: 901u32 }), pure_cal, effect_summary_empty(SymbolId { v: 901u32 }));
    effect_call_table_register(unsafe { mut_view(*ctab3) }, mut_view(*arena), (SymbolId { v: 902u32 }), clone_cal, effect_summary_from_flags(SymbolId { v: 902u32 }, EFFECT_ALLOCATES | EFFECT_READS_MEM | EFFECT_WRITES_MEM));
    if scalar_classify_call_intrinsic(unsafe { view(*o3) }, unsafe { view((*bb0_3).term) }, ctab3 as *const EffectCallTable) != INTRINSIC_SEM_PURE_CALL ||
       scalar_classify_call_intrinsic(unsafe { view(*o3) }, unsafe { view((*bb2_3).term) }, ctab3 as *const EffectCallTable) != INTRINSIC_SEM_EXPLICIT_CLONE_OR_IMPURE {
        return 166;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    scalar_stats_zero(mut_view(stats));
    if !scalar_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o3) }, ctab3 as *const EffectCallTable, mut_view(stats), mut_view(*arena), mut_view(*sink)) ||
       stats.gvn_pure_calls_eliminated != 1u32 {
        return 167;
    }
    let bb1_3 = unsafe { opt_block_at((*o3).blocks, 1) };
    let bb3_3 = unsafe { opt_block_at((*o3).blocks, 3) };
    if (unsafe { (*bb1_3).term.kind }) != OPT_TERM_GOTO ||
       (unsafe { (*bb2_3).term.kind }) != OPT_TERM_CALL ||
       (unsafe { (*bb3_3).term.kind }) != OPT_TERM_CALL {
        return 168;
    }

    // 4D. Blob 4: Full multi-pass -O2 --verify-each pipeline erasing unobservable Move/Copy/dead-store
    // abstractions (REQ-OPT-039..040) while preserving all 5 barriers (black_box, zeroize, volatile_load,
    // volatile_store, atomic) + reconstructing verified MIR!
    let in4 = probe_mir_blob(mut_view(*arena), 4);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m4 = verify_parse_mir(in4, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m4 as usize) == 0 {
        return 169;
    }
    let o4 = optir_build_from_mir(unsafe { view(*m4) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o4 as usize) == 0 || sink.errors != 0 {
        return 170;
    }
    let bb3_4 = unsafe { opt_block_at((*o4).blocks, 3) };
    let i_bbox = unsafe { opt_inst_at((*bb3_4).insts, 9) };
    let i_zero = unsafe { opt_inst_at((*bb3_4).insts, 10) };
    let i_vld = unsafe { opt_inst_at((*bb3_4).insts, 11) };
    let i_vst = unsafe { opt_inst_at((*bb3_4).insts, 12) };
    let i_ato = unsafe { opt_inst_at((*bb3_4).insts, 13) };
    unsafe {
        (*i_bbox).opcode = OPT_INST_BLACK_BOX;
        (*i_bbox).flags = (*i_bbox).flags | OPT_FLAG_BARRIER;
        (*i_zero).opcode = OPT_INST_ZEROIZE;
        (*i_zero).flags = (*i_zero).flags | OPT_FLAG_BARRIER;
        (*i_vld).opcode = OPT_INST_VOLATILE_LOAD;
        (*i_vld).flags = (*i_vld).flags | OPT_FLAG_BARRIER;
        (*i_vst).opcode = OPT_INST_VOLATILE_STORE;
        (*i_vst).flags = (*i_vst).flags | OPT_FLAG_BARRIER;
        (*i_ato).opcode = OPT_INST_ATOMIC;
        (*i_ato).flags = (*i_ato).flags | OPT_FLAG_BARRIER;
    }
    optir_construct_memssa(unsafe { mut_view(*o4) }, mut_view(*arena));
    if scalar_classify_inst_intrinsic(unsafe { view(*i_bbox) }) != INTRINSIC_SEM_BLACK_BOX ||
       scalar_classify_inst_intrinsic(unsafe { view(*i_zero) }) != INTRINSIC_SEM_ZEROIZE ||
       scalar_classify_inst_intrinsic(unsafe { view(*i_vld) }) != INTRINSIC_SEM_VOLATILE_LOAD ||
       scalar_classify_inst_intrinsic(unsafe { view(*i_vst) }) != INTRINSIC_SEM_VOLATILE_STORE ||
       scalar_classify_inst_intrinsic(unsafe { view(*i_ato) }) != INTRINSIC_SEM_ATOMIC {
        return 171;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    scalar_stats_zero(mut_view(stats));
    if !scalar_run_pipeline(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*o4) },
        0 as *const EffectCallTable,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    ) || (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        return 172;
    }
    let i_dead_store = unsafe { opt_inst_at((*bb3_4).insts, 5) };
    let i_live_store = unsafe { opt_inst_at((*bb3_4).insts, 6) };
    if (stats.dce_insts_eliminated) < 5u32 ||
       (stats.dce_dead_stores_eliminated) < 1u32 ||
       (stats.dce_move_copy_elided) < 2u32 ||
       (unsafe { (*i_dead_store).opcode }) != OPT_INST_NOP ||
       (unsafe { (*i_live_store).opcode }) != OPT_INST_STORE ||
       (unsafe { (*i_bbox).opcode }) != OPT_INST_BLACK_BOX ||
       (unsafe { (*i_zero).opcode }) != OPT_INST_ZEROIZE ||
       (unsafe { (*i_vld).opcode }) != OPT_INST_VOLATILE_LOAD ||
       (unsafe { (*i_vst).opcode }) != OPT_INST_VOLATILE_STORE ||
       (unsafe { (*i_ato).opcode }) != OPT_INST_ATOMIC {
        return 173;
    }
    let rec4 = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*o4) }, unsafe { mut_view(*rec4) }, mut_view(*arena)) {
        return 174;
    }
    verify_mir(unsafe { view(*rec4) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    if sink.errors != 0 {
        return 175;
    }

    // 4E. Blobs 5..11: End-to-end MirBody optimization across -O0/-O1/-O2 + subword MIN/-1, backedge clobber, & DSE guards
    let mut prof_idx: usize = 0;
    while prof_idx < 3 {
        let prof: u8 = if prof_idx == 0 {
            OPT_PROFILE_DEBUG_O0
        } else if prof_idx == 1 {
            OPT_PROFILE_BALANCED_O1
        } else {
            OPT_PROFILE_SPEED_O2
        };
        let in5_p = probe_mir_blob(mut_view(*arena), 5);
        diag_sink_free(mut_view(*sink));
        diag_sink_init(mut_view(*sink));
        let m5_p = verify_parse_mir(in5_p, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
        if (m5_p as usize) == 0 {
            return 176;
        }
        if !scalar_optimize_mir_body(
            unsafe { mut_view(*m5_p) },
            thir_ptr as *const Thir,
            prof,
            true,
            0 as *const EffectCallTable,
            mut_view(stats),
            mut_view(*arena),
            mut_view(*sink),
            0 as *const HirItem
        ) || sink.errors != 0 {
            return (177 + prof_idx) as i32;
        }
        prof_idx = prof_idx + 1;
    }

    // Blob 7: subword MIN / -1 and MIN % -1 trap preservation
    let in7 = probe_mir_blob(mut_view(*arena), 7);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m7 = verify_parse_mir(in7, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m7 as usize) == 0 {
        return 180;
    }
    let o7 = optir_build_from_mir(unsafe { view(*m7) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o7 as usize) == 0 || sink.errors != 0 {
        return 181;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    scalar_stats_zero(mut_view(stats));
    if !scalar_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o7) }, 0 as *const EffectCallTable, mut_view(stats), mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        return 182;
    }
    let b7_2 = unsafe { opt_block_at((*o7).blocks, 2) };
    let b7_3 = unsafe { opt_block_at((*o7).blocks, 3) };
    if (unsafe { (*opt_inst_at((*b7_2).insts, 1)).opcode }) != OPT_INST_CHECKED_BINOP ||
       (unsafe { (*opt_inst_at((*b7_2).insts, 3)).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*opt_inst_at((*b7_2).insts, 5)).opcode }) != OPT_INST_CHECKED_BINOP ||
       (unsafe { (*opt_inst_at((*b7_2).insts, 6)).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*b7_2).term.kind }) != OPT_TERM_ASSERT ||
       !(unsafe { (*b7_3).is_reachable }) ||
       (unsafe { (*b7_3).term.kind }) != OPT_TERM_ASSERT {
        return 183;
    }

    // Blob 10: unvalidated PROP_DEAD_STORE across &_2 deref must NOT delete store!
    let in10 = probe_mir_blob(mut_view(*arena), 10);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m10 = verify_parse_mir(in10, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m10 as usize) == 0 {
        return 184;
    }
    let o10 = optir_build_from_mir(unsafe { view(*m10) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o10 as usize) == 0 || sink.errors != 0 {
        return 185;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o10) }, mut_view(*arena));
    let b10_1 = unsafe { opt_block_at((*o10).blocks, 1) };
    let i10_st0 = unsafe { opt_inst_at((*b10_1).insts, 0) };
    optir_record_provenance(
        unsafe { mut_view(*o10) },
        mut_view(*arena),
        PROP_DEAD_STORE,
        CERTAINTY_PROVEN,
        ANALYSIS_MEMORY_SSA,
        (OptValueId { v: OPT_VALUE_NONE }),
        (OptValueId { v: OPT_VALUE_NONE }),
        (OptBbId { v: 1u32 }),
        (OptInstId { v: unsafe { (*i10_st0).id.v } }),
        PASS_DCE
    );
    scalar_stats_zero(mut_view(stats));
    let _ = scalar_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o10) }, PASS_DCE, 0 as *const EffectCallTable, mut_view(stats), mut_view(*arena), mut_view(*sink));
    if (unsafe { (*i10_st0).opcode }) != OPT_INST_STORE ||
       (unsafe { (*opt_inst_at((*b10_1).insts, 2)).opcode }) != OPT_INST_WRAPPING_BINOP ||
       (unsafe { (*opt_inst_at((*b10_1).insts, 3)).opcode }) != OPT_INST_LOAD {
        return 186;
    }

    // Verify scalar_optimize_mir_body across blobs 7..11
    let mut b_idx: usize = 7;
    while b_idx <= 11 {
        let in_b = probe_mir_blob(mut_view(*arena), b_idx);
        diag_sink_free(mut_view(*sink));
        diag_sink_init(mut_view(*sink));
        let m_b = verify_parse_mir(in_b, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
        if (m_b as usize) == 0 {
            return (187 + (b_idx - 7)) as i32;
        }
        if !scalar_optimize_mir_body(
            unsafe { mut_view(*m_b) },
            thir_ptr as *const Thir,
            OPT_PROFILE_SPEED_O2,
            true,
            0 as *const EffectCallTable,
            mut_view(stats),
            mut_view(*arena),
            mut_view(*sink),
            0 as *const HirItem
        ) || sink.errors != 0 {
            return (192 + (b_idx - 7)) as i32;
        }
        b_idx = b_idx + 1;
    }

    print("E15_1_STAGE_SCALAR_BARRIERS=OK\n");
    0
}

fn main() -> i32 {
    let mut arena = arena_new();
    let mut sink: DiagSink = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *const DiagSink) };
    diag_sink_init(mut_view(sink));

    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(arena));

    let r1 = verify_stage_optir_memssa(thir_ptr, mut_view(arena), mut_view(sink));
    if r1 != 0 {
        opt_free_minimal_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r1;
    }

    let r2 = verify_stage_effects_and_callgraph(thir_ptr, mut_view(arena), mut_view(sink));
    if r2 != 0 {
        opt_free_minimal_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r2;
    }

    let r3 = verify_stage_passmgr_and_rollback(thir_ptr, mut_view(arena), mut_view(sink));
    if r3 != 0 {
        opt_free_minimal_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r3;
    }

    let r4 = verify_stage_scalar_and_barriers(thir_ptr, mut_view(arena), mut_view(sink));
    if r4 != 0 {
        opt_free_minimal_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r4;
    }

    opt_free_minimal_thir(thir_ptr);
    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(arena));
    print("E15_1_PROBE_ALL=OK\n");
    0
}
