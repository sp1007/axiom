// test: diff
// flags: --verify-each
// exit: 101

// E15.1 Conformance (REQ-OPT-041, REQ-OPT-343):
// Subword signed `(-128i8) / (-1i8)` overflows `i8` and must trap (exit 101)
// even when its result is unused.

fn runtime_i8_min(steps: i32) -> i8 {
    let mut v: i8 = -126i8;
    let mut i: i32 = 0;
    while i < steps {
        v = v - 1i8;
        i = i + 1;
    }
    v
}

fn runtime_i8_neg1(steps: i32) -> i8 {
    let mut v: i8 = 1i8;
    let mut i: i32 = 0;
    while i < steps {
        v = v - 1i8;
        i = i + 1;
    }
    v
}

fn main() -> i32 {
    let min8: i8 = runtime_i8_min(2);
    let neg1: i8 = runtime_i8_neg1(2);
    let unused_q: i8 = min8 / neg1;
    let _ = unused_q;
    0
}
