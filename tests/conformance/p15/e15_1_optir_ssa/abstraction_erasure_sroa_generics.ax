// test: diff
// flags: --verify-each
// stdout: SROA_AFFINE=73\nGENERIC_ERASE=172\nENUM_LOOP=100\nABSTRACTION_TOTAL=345\n

// E15.1 Conformance (REQ-OPT-037, REQ-OPT-038, REQ-OPT-039, REQ-OPT-040, REQ-OPT-041, REQ-OPT-343):
// Verifies zero-cost unobservable abstraction erasure across nested non-address-taken structs
// (SROA), generic pure wrappers, enum tag matching, read/write view capabilities, and
// temporary Move/Copy chains under AOT native compilation vs MIR interpreter.

struct Point2D {
    x: i32,
    y: i32,
}

struct Affine2D {
    sx: i32,
    sy: i32,
    tx: i32,
    ty: i32,
}

struct Envelope<T> {
    val: T,
    weight: i32,
}

enum StepOutcome {
    KeepGoing(i32),
    Finish(i32),
}

fn translate_in_place(pt: mut_view<Point2D>, dx: i32, dy: i32) {
    (*pt).x = (*pt).x + dx;
    (*pt).y = (*pt).y + dy;
}

fn apply_affine(xf: view<Affine2D>, pt: view<Point2D>) -> Point2D {
    Point2D {
        x: ((*xf).sx * (*pt).x) + (*xf).tx,
        y: ((*xf).sy * (*pt).y) + (*xf).ty,
    }
}

fn wrap_envelope<T>(val: T, weight: i32) -> Envelope<T> {
    Envelope<T> { val: val, weight: weight }
}

fn unwrap_envelope<T>(env: Envelope<T>) -> T {
    env.val
}

fn select_by_flag<T>(choose_first: bool, first: T, second: T) -> T {
    if choose_first {
        return first;
    }
    second
}

fn sroa_affine_pipeline(px: i32, py: i32) -> i32 {
    let mut pt = Point2D { x: px, y: py };
    let xf = Affine2D { sx: 3, sy: 4, tx: 10, ty: -6 };
    translate_in_place(mut_view(pt), 2, 3);
    let out_pt = apply_affine(view(xf), view(pt));

    // Unobservable local Move/Copy chain eligible for SROA + DCE elision.
    let m1 = out_pt;
    let m2 = m1;
    let dead_pt = Point2D { x: m2.x + 100, y: m2.y + 200 };
    let _ = dead_pt.x;
    m2.x + m2.y
}

fn generic_envelope_erasure(base: i32) -> i32 {
    let e1: Envelope<i32> = wrap_envelope<i32>(base + 5, 1);
    let e2: Envelope<i32> = wrap_envelope<i32>(base * 2, 2);
    let picked: Envelope<i32> = select_by_flag<Envelope<i32>>(true, e2, e1);
    let picked_w: i32 = picked.weight;
    let picked_v: i32 = unwrap_envelope<i32>(picked);
    let v_i64: Envelope<i64> = wrap_envelope<i64>(120i64, 3);
    let wide_v: i32 = unwrap_envelope<i64>(v_i64) as i32;
    picked_v + picked_w + wide_v
}

fn make_step(idx: i32) -> StepOutcome {
    if idx < 3 {
        return StepOutcome.KeepGoing((idx + 1) * 10);
    }
    StepOutcome.Finish((idx + 1) * 10)
}

fn enum_abstraction_loop(limit: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut i: i32 = 0;
    while i < limit {
        let outcome = make_step(i);
        let delta: i32 = match outcome {
            StepOutcome.KeepGoing(v) => v,
            StepOutcome.Finish(v) => v,
        };
        acc = acc + delta;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let sroa_v: i32 = sroa_affine_pipeline(5, 9);
    print("SROA_AFFINE=");
    print_int(sroa_v);
    print("\n");

    let gen_v: i32 = generic_envelope_erasure(25);
    print("GENERIC_ERASE=");
    print_int(gen_v);
    print("\n");

    let enum_v: i32 = enum_abstraction_loop(4);
    print("ENUM_LOOP=");
    print_int(enum_v);
    print("\n");

    let total: i32 = sroa_v + gen_v + enum_v;
    print("ABSTRACTION_TOTAL=");
    print_int(total);
    print("\n");

    if sroa_v != 73 || gen_v != 172 || enum_v != 100 || total != 345 {
        return 1;
    }
    0
}
