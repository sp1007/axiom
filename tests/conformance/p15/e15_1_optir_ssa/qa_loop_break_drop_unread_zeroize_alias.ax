// test: diff
// flags: --verify-each
// stdout: GREETING=Xin chào thế giới\nDROP=106\nDROP=105\nDROP=110\nDROP=111\nDROP=122\nDROP=121\nDROP=112\nDROP=100\nQA_ADVERSARIAL_DONE=202\n

// E15.1 QA Boundary Conformance (REQ-OPT-037..041, REQ-OPT-343):
// Exercises move-flag single-drop elision, composite field Drop, while-loop continue and
// nested-scope break Drop cleanup ordering, loop-backedge pure-call destination clobber,
// address-taken wrapping_add write + raw-pointer load vs NoAlias view/mut_view forwarding,
// unread-at-scope-exit ptr_write_bytes zeroization, and wrapping/checked boundary widths.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}
@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_add_u8(a: u8, b: u8) -> u8 { 0u8 }

struct ScopeGuard {
    id: i32,
}

impl Drop for ScopeGuard {
    fn drop(self: mut_view<ScopeGuard>) {
        print("DROP=");
        print_int(self.id);
        print("\n");
    }
}

struct GuardBox {
    inner: ScopeGuard,
}

struct SecretBlock8 {
    b0: u8,
    b1: u8,
    b2: u8,
    b3: u8,
    b4: u8,
    b5: u8,
    b6: u8,
    b7: u8,
}

fn pure_weight(x: i32) -> i32 {
    (x * 3) + 2
}

fn bump_noalias(dst: mut_view<i32>, src: view<i32>) -> i32 {
    let s1: i32 = *src;
    *dst = *dst + s1;
    let s2: i32 = *src;
    *dst + s2
}

fn run_qa_adversarial(seed: i32) -> i32 {
    print("GREETING=Xin chào thế giới\n");
    let outer_g = ScopeGuard { id: 100 };

    {
        let g_src = ScopeGuard { id: 105 };
        let g_moved = g_src;
        let g_box = GuardBox {
            inner: ScopeGuard { id: 106 },
        };
        let _ = g_moved.id + g_box.inner.id;
    }

    let mut cached: i32 = pure_weight(seed + 4);
    let mut step: i32 = 0;
    let mut loop_acc: i32 = 0;

    while step < 5 {
        let g_iter = ScopeGuard { id: 110 + step };
        if step == 1 {
            step = step + 1;
            loop_acc = loop_acc + 20;
            continue;
        }
        if step == 2 {
            let g_brk_a = ScopeGuard { id: 121 };
            let g_brk_b = ScopeGuard { id: 122 };
            let _ = g_brk_a.id + g_brk_b.id;
            loop_acc = loop_acc + 40;
            break;
        }
        cached = 900;
        loop_acc = loop_acc + 10;
        step = step + 1;
        let _ = g_iter.id;
    }

    let fresh: i32 = pure_weight(seed + 4);

    let mut mem_slot: i32 = 10;
    let p_ro: *const i32 = unsafe { address_of(mem_slot) };
    mem_slot = wrapping_add_i32(mem_slot, seed + 11);
    let alias_read: i32 = unsafe { *p_ro };

    let mut noalias_dst: i32 = 5;
    let na_res: i32 = bump_noalias(mut_view(noalias_dst), view(mem_slot));

    {
        let mut dead_secret = SecretBlock8 {
            b0: 201u8,
            b1: 202u8,
            b2: 203u8,
            b3: 204u8,
            b4: 205u8,
            b5: 206u8,
            b6: 207u8,
            b7: 208u8,
        };
        unsafe {
            let wipe_p: *mut u8 = address_of_mut(dead_secret) as *mut u8;
            ptr_write_bytes<u8>(wipe_p, 0u8, 8);
        }
    }

    let w_u8: i32 = wrapping_add_u8(254u8 + (seed as u8), 2u8) as i32;
    let safe_i16: i32 = (((32765i16 + (seed as i16)) + 1i16) - 32760i16) as i32;
    let _ = outer_g.id;

    loop_acc + fresh + (cached / 100) + alias_read + na_res + noalias_dst + w_u8 + safe_i16
}

fn main() -> i32 {
    let res: i32 = run_qa_adversarial(1);
    print("QA_ADVERSARIAL_DONE=");
    print_int(res);
    print("\n");
    if res != 202 {
        return 1;
    }
    0
}
