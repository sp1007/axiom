// test: diff
// flags: --verify-each
// exit: 101

// E15.1 Conformance (REQ-OPT-041, REQ-OPT-343):
// Subword checked `i16` multiplication overflow (`20000i16 * 2i16`) must trap (exit 101).

fn runtime_i16_val(seed: i16, steps: i32) -> i16 {
    let mut v: i16 = seed;
    let mut i: i32 = 0;
    while i < steps {
        v = v + 1000i16;
        i = i + 1;
    }
    v
}

fn main() -> i32 {
    let a: i16 = runtime_i16_val(18000i16, 2);
    let prod: i16 = a * 2i16;
    prod as i32
}
