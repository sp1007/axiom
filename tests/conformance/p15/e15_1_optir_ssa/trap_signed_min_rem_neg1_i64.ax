// test: diff
// flags: --verify-each
// exit: 101

// E15.1 Conformance (REQ-OPT-041, REQ-OPT-343):
// Signed `i64::MIN % -1i64` must trap with exit code 101 across all modes.

fn runtime_i64_min(steps: i32) -> i64 {
    let mut v: i64 = -9223372036854775806i64;
    let mut i: i32 = 0;
    while i < steps {
        v = v - 1i64;
        i = i + 1;
    }
    v
}

fn runtime_i64_neg1(steps: i32) -> i64 {
    let mut v: i64 = 1i64;
    let mut i: i32 = 0;
    while i < steps {
        v = v - 1i64;
        i = i + 1;
    }
    v
}

fn main() -> i32 {
    let min64: i64 = runtime_i64_min(2);
    let neg1: i64 = runtime_i64_neg1(2);
    let r: i64 = min64 % neg1;
    r as i32
}
