// test: diff
// flags: --verify-each
// exit: 101

// E15.1 Conformance (REQ-OPT-041, REQ-OPT-343):
// Checked `(z - 1u64) + 1u64` at `0u64` must trap on unsigned underflow (exit 101).

fn runtime_u64_zero(steps: i32) -> u64 {
    let mut v: u64 = steps as u64;
    let mut i: i32 = 0;
    while i < steps {
        v = v - 1u64;
        i = i + 1;
    }
    v
}

fn main() -> i32 {
    let z: u64 = runtime_u64_zero(3);
    let r: u64 = (z - 1u64) + 1u64;
    if r == 0u64 {
        return 0;
    }
    1
}
