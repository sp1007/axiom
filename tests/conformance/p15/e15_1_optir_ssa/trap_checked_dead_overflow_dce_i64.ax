// test: diff
// flags: --verify-each
// exit: 101

// E15.1 Conformance (REQ-OPT-041, REQ-OPT-343):
// Unused checked `i64::MAX + 1i64` carries `MayPanic` and must NOT be eliminated by DCE.

fn runtime_i64_max(steps: i32) -> i64 {
    let mut base: i64 = 9223372036854775805i64;
    let mut i: i32 = 0;
    while i < steps {
        base = base + 1i64;
        i = i + 1;
    }
    base
}

fn main() -> i32 {
    let x: i64 = runtime_i64_max(2);
    let dead_ovf: i64 = x + 1i64;
    let _ = dead_ovf;
    0
}
