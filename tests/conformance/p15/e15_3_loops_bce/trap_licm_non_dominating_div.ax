// test: diff
// exit: 101
// stdout: 40\n0\n

// Non-dominating trapping `100 / d` inside loop must not hoist across zero-trip or untaken branch,
// and must trap when actually executed with `d == 0` (`AXS-LOOP-007`, `REQ-OPT-181`).
fn run_loop(take_div: bool, n: usize, d: i32) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < n {
        if take_div {
            let q: i32 = 100 / d;
            acc = acc + q;
        } else {
            acc = acc + 10;
        }
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    print_int(run_loop(false, 4, 0));
    print("\n");
    print_int(run_loop(true, 0, 0));
    print("\n");
    print_int(run_loop(true, 3, 0));
    print("\n");
    0
}
