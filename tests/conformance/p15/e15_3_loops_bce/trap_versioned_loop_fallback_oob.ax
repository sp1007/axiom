// test: diff
// exit: 101
// stdout: 10\n20\n30\n10\n20\n30\n40\n

// Loop versioning must route `n > len(arr)` to the checked fallback loop,
// executing valid iterations `0..3` and panicking on `i == 4` (`REQ-OPT-186`).
fn sum_prefix(n: usize) -> i32 {
    let arr: [4]i32 = [10, 20, 30, 40];
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < n {
        let v: i32 = arr[i];
        print_int(v);
        print("\n");
        acc = acc + v;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    print_int(sum_prefix(2));
    print("\n");
    let _ = sum_prefix(6);
    0
}
