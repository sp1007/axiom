// test: diff
// exit: 0
// stdout-file: licm_sr_peel_unroll_version_fusion.stdout

fn println_i32(x: i32) {
    print_int(x);
    print("\n");
}

fn test_licm_scalar_and_readonly_load(a: i32, b: i32) -> i32 {
    let weights: [4]i32 = [2, 4, 6, 8];
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 4 {
        let inv: i32 = (a + b) * 3 + weights[1];
        acc = acc + inv + weights[i];
        i = i + 1;
    }
    acc
}

fn test_zero_trip_div_no_hoist(n: usize, d: i32) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 77;
    while i < n {
        let q: i32 = 100 / d;
        acc = acc + q;
        i = i + 1;
    }
    acc
}

fn test_iv_strength_reduction() -> i32 {
    let arr: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 8 {
        let step4: usize = i * 4;
        let step6: usize = i * 6 + 3;
        acc = acc + (step4 as i32) + (step6 as i32) + arr[i];
        i = i + 1;
    }
    acc
}

fn test_peel_first_iteration() -> i32 {
    let arr: [6]i32 = [10, 20, 30, 40, 50, 60];
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 6 {
        if i == 0 {
            acc = acc + 5;
        } else {
            acc = acc + arr[i - 1];
        }
        i = i + 1;
    }
    acc
}

fn test_peel_short_bounds(n: usize) -> i32 {
    let arr: [4]i32 = [5, 15, 25, 35];
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < n {
        if i == 0 {
            acc = acc + 10;
        } else {
            acc = acc + arr[i - 1];
        }
        i = i + 1;
    }
    acc
}

fn test_unswitch_invariant_branch(flag: bool, n: usize) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < n {
        if flag {
            acc = acc + 5;
        } else {
            acc = acc + 2;
        }
        i = i + 1;
    }
    acc
}

fn test_full_and_partial_unroll() -> i32 {
    let mut i: usize = 0;
    let mut small_sum: i32 = 0;
    while i < 4 {
        small_sum = small_sum + ((i as i32) + 1) * 10;
        i = i + 1;
    }

    let mut j: usize = 0;
    let mut large_sum: i32 = 0;
    while j < 16 {
        large_sum = large_sum + ((j as i32) * 2) + 1;
        j = j + 1;
    }
    small_sum + large_sum
}

fn test_versioned_loop_fast_path(n: usize) -> i32 {
    let arr: [8]i32 = [2, 4, 6, 8, 10, 12, 14, 16];
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < n {
        acc = acc + arr[i] + ((i as i32) * 2);
        i = i + 1;
    }
    acc
}

fn test_fuse_and_buffer_forwarding() -> i32 {
    let src: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let mut tmp: [8]i32 = [0, 0, 0, 0, 0, 0, 0, 0];
    let mut i: usize = 0;
    while i < 8 {
        tmp[i] = src[i] * 2 + 1;
        i = i + 1;
    }

    let mut j: usize = 0;
    let mut acc: i32 = 0;
    while j < 8 {
        acc = acc + tmp[j];
        j = j + 1;
    }
    acc
}

fn test_negative_dep_no_fuse() -> i32 {
    let mut a: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let mut dst: [8]i32 = [0, 0, 0, 0, 0, 0, 0, 0];
    let mut i: usize = 0;
    while i < 7 {
        a[i] = (i as i32 + 1) * 10;
        i = i + 1;
    }

    let mut j: usize = 0;
    let mut sum: i32 = 0;
    while j < 6 {
        dst[j] = a[j + 1];
        sum = sum + dst[j];
        j = j + 1;
    }
    sum + a[6]
}

fn test_intervening_clobber_no_forward() -> i32 {
    let src: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let mut tmp: [8]i32 = [0, 0, 0, 0, 0, 0, 0, 0];
    let mut i: usize = 0;
    while i < 8 {
        tmp[i] = src[i] * 2;
        i = i + 1;
    }

    tmp[3] = 999;

    let mut j: usize = 0;
    let mut acc: i32 = 0;
    while j < 8 {
        acc = acc + tmp[j];
        j = j + 1;
    }
    acc - tmp[6]
}

fn main() -> i32 {
    println_i32(test_licm_scalar_and_readonly_load(3, 4));
    println_i32(test_zero_trip_div_no_hoist(0, 0));
    println_i32(test_iv_strength_reduction());
    println_i32(test_peel_first_iteration());
    println_i32(test_peel_short_bounds(0));
    println_i32(test_peel_short_bounds(1));
    println_i32(test_peel_short_bounds(2));
    println_i32(test_unswitch_invariant_branch(true, 8));
    println_i32(test_unswitch_invariant_branch(false, 8));
    println_i32(test_unswitch_invariant_branch(true, 0));
    println_i32(test_full_and_partial_unroll());
    println_i32(test_versioned_loop_fast_path(5));
    println_i32(test_versioned_loop_fast_path(0));
    println_i32(test_fuse_and_buffer_forwarding());
    println_i32(test_negative_dep_no_fuse());
    println_i32(test_intervening_clobber_no_forward());
    0
}
