// test: diff
// exit: 101
// stdout: 11\n22\n

@intrinsic fn assert(c: bool) {}
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Vec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

fn vec_shrink_one(v: mut_view<Vec<i32>>) {
    if v.len > 0 {
        v.len = v.len - 1;
    }
}

// `vec_shrink_one` inside loop mutates `v.len`, so BCE must NOT trust the initial `saved_n = v.len` bound (`AXS-BCE-002` rule 2).
fn shrink_vec_in_loop(v: mut_view<Vec<i32>>) -> i32 {
    let saved_n: usize = v.len;
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < saved_n {
        vec_shrink_one(mut_view(*v));
        assert(i < v.len);
        let x: i32 = unsafe { *(v.ptr + i) };
        print_int(x);
        print("\n");
        acc = acc + x;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let mut backing: [4]i32 = [11, 22, 33, 44];
    let mut v = Vec<i32> {
        ptr: unsafe { address_of_mut(backing) as *mut i32 },
        len: 4,
        cap: 4,
    };
    let _ = shrink_vec_in_loop(mut_view(v));
    0
}
