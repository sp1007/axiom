// test: diff
// exit: 101
// stdout-file: oob_and_overflow_trap_preservation.stdout

@intrinsic fn wrapping_add_usize(a: usize, b: usize) -> usize { 0 }
@intrinsic fn wrapping_mul_usize(a: usize, b: usize) -> usize { 0 }

fn println_i32(x: i32) {
    print_int(x);
    print("\n");
}

// 1. Zero-trip loop with potentially trapping `100 / d` (`d == 0`) must not hoist division (`AXS-LOOP-007`)
fn zero_trip_div_preserved(n: usize, d: i32) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 77;
    while i < n {
        let q: i32 = 100 / d;
        acc = acc + q;
        i = i + 1;
    }
    acc
}

// 2. Non-dominating branch-gated division inside loop must not hoist when `take_div == false` (`AXS-LOOP-007`)
fn gated_div_preserved(take_div: bool, n: usize, d: i32) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 40;
    while i < n {
        if take_div {
            let q: i32 = 100 / d;
            acc = acc + q;
        } else {
            acc = acc + 1;
        }
        i = i + 1;
    }
    acc
}

// 3. Checked `i32` multiplication by induction variable within safe range `0..3` (`AXS-LOOP-006`)
fn checked_iv_mul_in_range(n: i32) -> i32 {
    let mut i: i32 = 0;
    let mut last: i32 = 0;
    while i < n {
        let prod: i32 = i * 1000000000;
        last = prod;
        i = i + 1;
    }
    last - 1999999000
}

// 4. Negative-distance loop-carried dependence (`a[j + 1]` read after `a[i]` write) must not fuse (`AXS-LOOP-011`)
fn negative_distance_dep_soundness() -> i32 {
    let mut a: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let mut dst: [8]i32 = [0, 0, 0, 0, 0, 0, 0, 0];
    let mut i: usize = 0;
    while i < 7 {
        a[i] = (i as i32 + 1) * 10;
        i = i + 1;
    }

    let mut j: usize = 0;
    let mut sum: i32 = 0;
    while j < 6 {
        dst[j] = a[j + 1];
        sum = sum + dst[j];
        j = j + 1;
    }
    sum + a[6]
}

// 5. Dynamic wrapping stride slice access must retain bounds check and panic at `i == 3` (`idx == 6 >= 5`) (`AXS-BCE-003`)
fn sum_wrapping_stride_until_oob(s: view<[i32]>, steps: usize) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < steps {
        let idx: usize = wrapping_mul_usize(i, 2usize);
        let v: i32 = s[idx];
        println_i32(v);
        acc = acc + v;
        i = wrapping_add_usize(i, 1usize);
    }
    acc
}

fn main() -> i32 {
    println_i32(zero_trip_div_preserved(0, 0));
    println_i32(gated_div_preserved(false, 4, 0));
    println_i32(checked_iv_mul_in_range(3));
    println_i32(negative_distance_dep_soundness());

    let data: [5]i32 = [10, 15, 20, 25, 30];
    let _ = sum_wrapping_stride_until_oob(view(data), 4);
    0
}
