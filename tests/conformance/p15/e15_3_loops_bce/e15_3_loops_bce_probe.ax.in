@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@PROBE_MIR_FN@

fn probe_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn empty_node_map() -> NodeMap {
    NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 }
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn probe_set_ty_slot(types_arr: *mut *mut AxType, idx: usize, ptr: *mut AxType) {
    let slot = ((types_arr as usize) + mir_mul_usize(idx, size_of<*mut AxType>())) as *mut *mut AxType;
    unsafe { *slot = ptr; }
}

// Synthetic `Thir` (`TypeId.v` is 1-based):
//   type#2 = unit, type#4 = bool, type#8 = i32, type#15 = usize
//   type#17 = view<i32>, type#18 = mut_view<i32>, type#19 = *mut i32, type#20 = [4]i32, type#21 = fn(i32)->i32
fn probe_init_synth_thir(thir_ptr: *mut Thir, arena: mut_view<Arena>) {
    let types_arr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(32, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType;
    let pool = arena_alloc_raw(mut_view(*arena), mir_mul_usize(28, size_of<AxType>()), align_of<AxType>());
    let ty_sz = size_of<AxType>();

    let mut k: usize = 0;
    while k < 16 {
        let tp = ((pool as usize) + mir_mul_usize(k, ty_sz)) as *mut AxType;
        let tk: u8 = if k < 9 { k as u8 }
            else if k == 9 { TY_ISIZE }
            else if k == 10 { TY_U8 }
            else if k == 11 { TY_U16 }
            else if k == 12 { TY_U32 }
            else if k == 13 { TY_U64 }
            else if k == 14 { TY_USIZE }
            else { TY_STR };
        unsafe { ax_type_reset(mut_view(*tp), tk); }
        probe_set_ty_slot(types_arr, k, tp);
        k = k + 1;
    }

    let mut c: usize = 16;
    while c < 21 {
        let cp = ((pool as usize) + mir_mul_usize(c, ty_sz)) as *mut AxType;
        unsafe { ax_type_reset(mut_view(*cp), 0u8); }
        probe_set_ty_slot(types_arr, c, cp);
        c = c + 1;
    }

    let t17 = ((pool as usize) + mir_mul_usize(16, ty_sz)) as *mut AxType;
    let t18 = ((pool as usize) + mir_mul_usize(17, ty_sz)) as *mut AxType;
    let t19 = ((pool as usize) + mir_mul_usize(18, ty_sz)) as *mut AxType;
    let t20 = ((pool as usize) + mir_mul_usize(19, ty_sz)) as *mut AxType;
    let t21 = ((pool as usize) + mir_mul_usize(20, ty_sz)) as *mut AxType;
    let scratch_ty = ((pool as usize) + mir_mul_usize(22, ty_sz)) as *mut AxType;
    let fn_params = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;

    unsafe {
        *opt_typeid_at(fn_params, 0) = TypeId { v: 8u32 };
        ax_type_reset(mut_view(*scratch_ty), 0u8);

        (*t17).kind = TY_VIEW;
        (*t17).pointee = TypeId { v: 8u32 };

        (*t18).kind = TY_MUT_VIEW;
        (*t18).is_mut = true;
        (*t18).pointee = TypeId { v: 8u32 };

        (*t19).kind = TY_PTR;
        (*t19).is_mut = true;
        (*t19).pointee = TypeId { v: 8u32 };

        (*t20).kind = TY_ARRAY;
        (*t20).elem = TypeId { v: 8u32 };
        (*t20).array_len = 4u64;

        (*t21).kind = TY_FN;
        (*t21).param_types = fn_params;
        (*t21).param_count = 1;
        (*t21).ret_type = TypeId { v: 8u32 };

        (*thir_ptr).interner.arena = arena_new();
        (*thir_ptr).interner.map.keys = 0 as *mut *mut AxType;
        (*thir_ptr).interner.map.vals = 0 as *mut TypeId;
        (*thir_ptr).interner.map.states = 0 as *mut u8;
        (*thir_ptr).interner.map.len = 0;
        (*thir_ptr).interner.map.cap = 0;
        (*thir_ptr).interner.types = types_arr;
        (*thir_ptr).interner.len = 21;
        (*thir_ptr).interner.cap = 32;
        (*thir_ptr).interner.next_int_var = 1u32;
        (*thir_ptr).interner.scratch = scratch_ty;
        (*thir_ptr).interner.t_error.v = 1u32;
        (*thir_ptr).interner.t_unit.v = 2u32;
        (*thir_ptr).interner.t_never.v = 3u32;
        (*thir_ptr).interner.t_bool.v = 4u32;
        (*thir_ptr).interner.t_char.v = 5u32;
        (*thir_ptr).interner.t_i8.v = 6u32;
        (*thir_ptr).interner.t_i16.v = 7u32;
        (*thir_ptr).interner.t_i32.v = 8u32;
        (*thir_ptr).interner.t_i64.v = 9u32;
        (*thir_ptr).interner.t_isize.v = 10u32;
        (*thir_ptr).interner.t_u8.v = 11u32;
        (*thir_ptr).interner.t_u16.v = 12u32;
        (*thir_ptr).interner.t_u32.v = 13u32;
        (*thir_ptr).interner.t_u64.v = 14u32;
        (*thir_ptr).interner.t_usize.v = 15u32;
        (*thir_ptr).interner.t_str.v = 16u32;
        (*thir_ptr).interner.t_i128.v = 0x3FFF0128u32;
        (*thir_ptr).interner.t_u128.v = 0x3FFF0129u32;
        (*thir_ptr).item_types.keys = 0 as *mut usize;
        (*thir_ptr).item_types.vals = 0 as *mut TypeId;
        (*thir_ptr).item_types.states = 0 as *mut u8;
        (*thir_ptr).item_types.len = 0;
        (*thir_ptr).item_types.cap = 0;
        (*thir_ptr).expr_types.keys = 0 as *mut usize;
        (*thir_ptr).expr_types.vals = 0 as *mut TypeId;
        (*thir_ptr).expr_types.states = 0 as *mut u8;
        (*thir_ptr).expr_types.len = 0;
        (*thir_ptr).expr_types.cap = 0;
    }
}

fn probe_free_synth_thir(thir_ptr: *mut Thir) {
    unsafe {
        typemap_free(mut_view((*thir_ptr).interner.map));
        arena_destroy(mut_view((*thir_ptr).interner.arena));
    }
}

fn make_deref_pl(loc: u32, arena: mut_view<Arena>) -> MirPlace {
    let pr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        (*pr).kind = MIR_PROJ_DEREF;
        (*pr).field_idx = 0u32;
        (*pr).index_local = MirLocalId { v: 0u32 };
        (*pr).from_local = MirLocalId { v: 0u32 };
        (*pr).to_local = MirLocalId { v: 0u32 };
        (*pr).has_from = false;
        (*pr).has_to = false;
        (*pr).variant_idx = 0u32;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = pr;
    pl.proj_count = 1;
    pl
}

fn make_index_pl(loc: u32, idx_loc: u32, arena: mut_view<Arena>) -> MirPlace {
    let pr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        (*pr).kind = MIR_PROJ_INDEX;
        (*pr).field_idx = 0u32;
        (*pr).index_local = MirLocalId { v: idx_loc };
        (*pr).from_local = MirLocalId { v: 0u32 };
        (*pr).to_local = MirLocalId { v: 0u32 };
        (*pr).has_from = false;
        (*pr).has_to = false;
        (*pr).variant_idx = 0u32;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = pr;
    pl.proj_count = 1;
    pl
}

fn make_deref_subslice_pl(loc: u32, from_loc: u32, to_loc: u32, arena: mut_view<Arena>) -> MirPlace {
    let prs = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<MirProjection>()), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(prs, 0) };
    let p1 = unsafe { mir_proj_at(prs, 1) };
    unsafe {
        (*p0).kind = MIR_PROJ_DEREF;
        (*p0).field_idx = 0u32;
        (*p0).index_local = MirLocalId { v: 0u32 };
        (*p0).from_local = MirLocalId { v: 0u32 };
        (*p0).to_local = MirLocalId { v: 0u32 };
        (*p0).has_from = false;
        (*p0).has_to = false;
        (*p0).variant_idx = 0u32;

        (*p1).kind = MIR_PROJ_SUB_SLICE;
        (*p1).field_idx = 0u32;
        (*p1).index_local = MirLocalId { v: 0u32 };
        (*p1).from_local = MirLocalId { v: from_loc };
        (*p1).to_local = MirLocalId { v: to_loc };
        (*p1).has_from = true;
        (*p1).has_to = true;
        (*p1).variant_idx = 0u32;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = prs;
    pl.proj_count = 2;
    pl
}

// Section 1: Natural Loop Discovery, Canonical Simplification, LCSSA, bb0 Header & Irreducible SCC
fn probe_loop_discovery_and_simplify() -> i32 {
    if loop_simplify_contract().pass_id != PASS_LOOP_SIMPLIFY {
        return 101;
    }
    if bce_contract().pass_id != PASS_BCE {
        return 102;
    }

    let mut arena = arena_new();
    let sink_ptr = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }
    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    probe_init_synth_thir(thir_ptr, mut_view(arena));
    let ct_ptr = arena_alloc_raw(mut_view(arena), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_ptr) }, mut_view(arena), 8);

    // 1A. Blob 3: multi-preheader + multi-latch + shared-exit + LCSSA canonicalization
    let sv3 = probe_blob(mut_view(arena), 3);
    let mir3 = verify_parse_mir(sv3, unsafe { mut_view((*thir_ptr).interner) }, mut_view(arena));
    if (mir3 as usize) == 0 || (unsafe { (*sink_ptr).errors }) != 0 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 103;
    }
    let ob3 = optir_build_from_mir(unsafe { view(*mir3) }, thir_ptr as *const Thir, mut_view(arena), unsafe { mut_view(*sink_ptr) }, 0 as *const HirItem);
    if (ob3 as usize) == 0 || (unsafe { (*sink_ptr).errors }) != 0 || !optir_verify_contract(unsafe { view(*ob3) }) {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 104;
    }

    // Strict -O0 no-op check (`AXS-LOOP-001` rule 3)
    let pm_o0 = arena_alloc_raw(mut_view(arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm_o0) }, opt_budget_for_profile(OPT_PROFILE_DEBUG_O0, true), mut_view(arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_o0) }, unsafe { mut_view(*ob3) }, mut_view(arena));
    let mut st_o0 = LoopSimplifyStats {
        pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32, loops_discovered: 0u32,
        irreducible_cycles: 0u32, preheaders_inserted: 0u32, latches_merged: 0u32,
        dedicated_exits_inserted: 0u32, lcssa_phis_inserted: 0u32,
    };
    loops_stats_zero(mut_view(st_o0));
    let ainfo3_pre = alias_build_info(unsafe { view(*ob3) }, ct_ptr as *const EffectCallTable, mut_view(arena));
    if opt_loop_simplify(
        unsafe { mut_view(*pm_o0) }, unsafe { mut_view(*ob3) }, ct_ptr as *const EffectCallTable,
        ainfo3_pre as *const AliasInfo, mut_view(st_o0), mut_view(arena), unsafe { mut_view(*sink_ptr) }
    ) || st_o0.pass_runs != 0u32 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 105;
    }

    // Run `opt_loop_simplify` under `-O2` (`verify_each = true`)
    let pm_o2 = arena_alloc_raw(mut_view(arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm_o2) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_o2) }, unsafe { mut_view(*ob3) }, mut_view(arena));
    let mut st3 = st_o0;
    loops_stats_zero(mut_view(st3));
    let changed3 = opt_loop_simplify(
        unsafe { mut_view(*pm_o2) }, unsafe { mut_view(*ob3) }, ct_ptr as *const EffectCallTable,
        ainfo3_pre as *const AliasInfo, mut_view(st3), mut_view(arena), unsafe { mut_view(*sink_ptr) }
    );
    if !changed3 || st3.pass_rollbacks != 0u32 || (unsafe { (*sink_ptr).errors }) != 0 ||
       st3.preheaders_inserted == 0u32 || st3.latches_merged == 0u32 ||
       st3.dedicated_exits_inserted == 0u32 || st3.lcssa_phis_inserted == 0u32 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 106;
    }
    if !optir_verify_contract(unsafe { view(*ob3) }) {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 107;
    }
    let ainfo3_post = alias_build_info(unsafe { view(*ob3) }, ct_ptr as *const EffectCallTable, mut_view(arena));
    let tree3 = loops_discover(unsafe { view(*ob3) }, ct_ptr as *const EffectCallTable, ainfo3_post as *const AliasInfo, mut_view(arena));
    if (unsafe { (*tree3).loop_count }) != 1 || (unsafe { (*tree3).has_irreducible_cfg }) {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 108;
    }
    let lp3 = unsafe { loop_desc_at((*tree3).loops, 0) };
    if (unsafe { (*lp3).depth }) != 1u32 || !(unsafe { (*lp3).is_canonical_simplified }) || !(unsafe { (*lp3).is_lcssa }) ||
       (unsafe { (*lp3).preheader.v }) == OPT_BB_NONE || (unsafe { (*lp3).single_latch.v }) == OPT_BB_NONE {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 109;
    }

    // Deterministic `loops_print` check
    let mut db1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut db2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(db1));
    diag_buf_init(mut_view(db2));
    loops_print(mut_view(db1), unsafe { view(*tree3) });
    loops_print(mut_view(db2), unsafe { view(*tree3) });
    let print_ok = db1.len > 16 && diag_buf_eq(view(db1), view(db2));
    diag_buf_free(mut_view(db1));
    diag_buf_free(mut_view(db2));
    if !print_ok {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 110;
    }

    // 1B. Blob 4: `bb0` entry loop header hoisted cleanly by `loops_simplify_mir_body`
    let sv4 = probe_blob(mut_view(arena), 4);
    let mir4 = verify_parse_mir(sv4, unsafe { mut_view((*thir_ptr).interner) }, mut_view(arena));
    if (mir4 as usize) == 0 || (unsafe { (*sink_ptr).errors }) != 0 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 111;
    }
    let mut st4 = st_o0;
    loops_stats_zero(mut_view(st4));
    if !loops_simplify_mir_body(
        unsafe { mut_view(*mir4) }, thir_ptr as *const Thir, OPT_PROFILE_SPEED_O2, true,
        ct_ptr as *const EffectCallTable, mut_view(st4), mut_view(arena), unsafe { mut_view(*sink_ptr) }, 0 as *const HirItem
    ) || st4.preheaders_inserted == 0u32 || st4.pass_rollbacks != 0u32 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 112;
    }
    let ob4 = optir_build_from_mir(unsafe { view(*mir4) }, thir_ptr as *const Thir, mut_view(arena), unsafe { mut_view(*sink_ptr) }, 0 as *const HirItem);
    let ainfo4 = alias_build_info(unsafe { view(*ob4) }, ct_ptr as *const EffectCallTable, mut_view(arena));
    let tree4 = loops_discover(unsafe { view(*ob4) }, ct_ptr as *const EffectCallTable, ainfo4 as *const AliasInfo, mut_view(arena));
    if (unsafe { (*tree4).loop_count }) != 1 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 113;
    }
    let lp4 = unsafe { loop_desc_at((*tree4).loops, 0) };
    if (unsafe { (*lp4).header.v }) == 0u32 || !(unsafe { (*lp4).is_canonical_simplified }) {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 114;
    }

    // 1C. Blob 5: Tarjan SCC irreducible multi-entry cycle (`AXS-LOOP-002`)
    let sv5 = probe_blob(mut_view(arena), 5);
    let mir5 = verify_parse_mir(sv5, unsafe { mut_view((*thir_ptr).interner) }, mut_view(arena));
    let ob5 = optir_build_from_mir(unsafe { view(*mir5) }, thir_ptr as *const Thir, mut_view(arena), unsafe { mut_view(*sink_ptr) }, 0 as *const HirItem);
    if (ob5 as usize) == 0 || (unsafe { (*sink_ptr).errors }) != 0 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 115;
    }
    let ainfo5 = alias_build_info(unsafe { view(*ob5) }, ct_ptr as *const EffectCallTable, mut_view(arena));
    let tree5 = loops_discover(unsafe { view(*ob5) }, ct_ptr as *const EffectCallTable, ainfo5 as *const AliasInfo, mut_view(arena));
    if !(unsafe { (*tree5).has_irreducible_cfg }) || (unsafe { (*tree5).loop_count }) != 1 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 116;
    }
    let lp5 = unsafe { loop_desc_at((*tree5).loops, 0) };
    if !(unsafe { (*lp5).is_irreducible }) || (unsafe { (*lp5).is_canonical_simplified }) {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 117;
    }
    let pm5 = arena_alloc_raw(mut_view(arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm5) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm5) }, unsafe { mut_view(*ob5) }, mut_view(arena));
    let mut st5 = st_o0;
    loops_stats_zero(mut_view(st5));
    let changed5 = opt_loop_simplify(
        unsafe { mut_view(*pm5) }, unsafe { mut_view(*ob5) }, ct_ptr as *const EffectCallTable,
        ainfo5 as *const AliasInfo, mut_view(st5), mut_view(arena), unsafe { mut_view(*sink_ptr) }
    );
    if changed5 || st5.irreducible_cycles != 1u32 || st5.pass_rollbacks != 0u32 {
        probe_free_synth_thir(thir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        return 118;
    }

    probe_free_synth_thir(thir_ptr);
    unsafe { diag_sink_free(mut_view(*sink_ptr)); }
    arena_destroy(mut_view(arena));
    0
}

fn probe_init_fe_session(perm_arena: mut_view<Arena>) -> *mut CompilerSession {
    let sess_ptr = arena_alloc_raw(mut_view(*perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let str_bytes_arena = new_arena(262144);
    let str_cap: usize = 2048;
    let str_arr = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(str_cap, size_of<StrView>()), align_of<StrView>()) as *mut StrView;
    let smap_cap: usize = 4096;
    let smap_hashes = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 8), 8) as *mut u64;
    let smap_ids = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 4), 4) as *mut u32;
    unsafe {
        session_init(mut_view(*sess_ptr));
        arena_destroy(mut_view((*sess_ptr).interner.bytes));
        (*sess_ptr).interner.bytes = str_bytes_arena;
        (*sess_ptr).interner.strings = str_arr;
        (*sess_ptr).interner.cap = str_cap;
        (*sess_ptr).interner.map_hashes = smap_hashes;
        (*sess_ptr).interner.map_ids = smap_ids;
        (*sess_ptr).interner.map_cap = smap_cap;
    }
    sess_ptr
}

fn probe_free_fe_session(sess_ptr: *mut CompilerSession) {
    unsafe {
        (*sess_ptr).interner.cap = 0;
        (*sess_ptr).interner.map_cap = 0;
        session_free(mut_view(*sess_ptr));
    }
}

fn probe_verify_rebound_subslice_may_alias(
    ob: *mut OptBody,
    ri: *mut RangeInfo,
    ai: *mut AliasInfo,
    ct: *mut EffectCallTable,
    arena: mut_view<Arena>
) -> bool {
    let mut sub_prev_loc: u32 = 0u32;
    let mut sub_last_loc: u32 = 0u32;
    let mut sub_last_bb = OptBbId { v: 0u32 };
    let mut sub_last_ii: u32 = 0u32;
    let mut sub_seen: usize = 0;

    let mut st0_pl = mir_local_place(0u32);
    let mut st1_pl = mir_local_place(0u32);
    let mut st_bb = OptBbId { v: 0u32 };
    let mut st_ii: u32 = 0u32;
    let mut st_cnt: usize = 0;

    let mut bb_i: usize = 0;
    while bb_i < (unsafe { (*ob).bb_count }) {
        let bbp = unsafe { opt_block_at((*ob).blocks, bb_i) };
        if unsafe { (*bbp).is_reachable } {
            let ic = unsafe { (*bbp).inst_count };
            let mut k: usize = 0;
            while k < ic {
                let ins = unsafe { opt_inst_at((*bbp).insts, k) };
                let opc = unsafe { (*ins).opcode };
                if opc == OPT_INST_ADDR_OF && (unsafe { (*ins).place.proj_count }) == 0 {
                    let rpc = unsafe { (*ins).rhs_place.proj_count };
                    if rpc > 0 && ((unsafe { (*ins).rhs_place.projs }) as usize) != 0 {
                        let lp = unsafe { mir_proj_at((*ins).rhs_place.projs, rpc - 1) };
                        if (unsafe { (*lp).kind }) == MIR_PROJ_SUB_SLICE {
                            sub_prev_loc = sub_last_loc;
                            sub_last_loc = unsafe { (*ins).place.local.v };
                            sub_last_bb = OptBbId { v: bb_i as u32 };
                            sub_last_ii = k as u32;
                            sub_seen = sub_seen + 1;
                        }
                    }
                } else if opc != OPT_INST_NOP &&
                          (unsafe { (*ins).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                          (unsafe { (*ins).place.proj_count }) == 2 {
                    let p0 = unsafe { mir_proj_at((*ins).place.projs, 0) };
                    let p1 = unsafe { mir_proj_at((*ins).place.projs, 1) };
                    if (unsafe { (*p0).kind }) == MIR_PROJ_DEREF && (unsafe { (*p1).kind }) == MIR_PROJ_INDEX {
                        if st_cnt == 0 {
                            mir_copy_place(mut_view(st0_pl), unsafe { view((*ins).place) });
                            st_cnt = 1;
                        } else if st_cnt == 1 {
                            mir_copy_place(mut_view(st1_pl), unsafe { view((*ins).place) });
                            st_bb = OptBbId { v: bb_i as u32 };
                            st_ii = k as u32;
                            st_cnt = 2;
                        }
                    }
                }
                k = k + 1;
            }
        }
        bb_i = bb_i + 1;
    }
    if sub_seen < 2 || st_cnt != 2 {
        return false;
    }
    let pl_sub_l = mir_local_place(sub_prev_loc);
    let pl_sub_r = mir_local_place(sub_last_loc);
    let af_sub = bce_prove_subrange_disjoint(
        unsafe { view(*ri) }, unsafe { view(*ob) }, ai as *const AliasInfo,
        ct as *const EffectCallTable, view(pl_sub_l), view(pl_sub_r), sub_last_bb, sub_last_ii + 1u32, mut_view(*arena)
    );
    if af_sub.result != ALIAS_MAY_ALIAS {
        return false;
    }
    let pl_st_l = mir_local_place(st0_pl.local.v);
    let pl_st_r = mir_local_place(st1_pl.local.v);
    let af_st_slice = bce_prove_subrange_disjoint(
        unsafe { view(*ri) }, unsafe { view(*ob) }, ai as *const AliasInfo,
        ct as *const EffectCallTable, view(pl_st_l), view(pl_st_r), st_bb, st_ii, mut_view(*arena)
    );
    if af_st_slice.result != ALIAS_MAY_ALIAS {
        return false;
    }
    let af_elem = bce_prove_subrange_disjoint(
        unsafe { view(*ri) }, unsafe { view(*ob) }, ai as *const AliasInfo,
        ct as *const EffectCallTable, view(st0_pl), view(st1_pl), st_bb, st_ii, mut_view(*arena)
    );
    af_elem.result == ALIAS_MAY_ALIAS
}

// Section 2: SCEV, Trip Counts, Loop Invariance (`loops_can_hoist_inst`) & Dependence (`loops_query_dependence`)
fn probe_scev_invariance_and_dependence() -> i32 {
    // 2A. Synthetic Blob 6: hoisting invariance, zero-trip trap safety, GPU/volatile/atomic barriers & raw/cap dep
    let mut s_arena = arena_new();
    let sink_ptr = arena_alloc_raw(mut_view(s_arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }
    let sthir_ptr = arena_alloc_raw(mut_view(s_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    probe_init_synth_thir(sthir_ptr, mut_view(s_arena));
    let ct_ptr = arena_alloc_raw(mut_view(s_arena), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_ptr) }, mut_view(s_arena), 8);

    let sv6 = probe_blob(mut_view(s_arena), 6);
    let mir6 = verify_parse_mir(sv6, unsafe { mut_view((*sthir_ptr).interner) }, mut_view(s_arena));
    if (mir6 as usize) == 0 || (unsafe { (*sink_ptr).errors }) != 0 {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 201;
    }
    let ob6 = optir_build_from_mir(unsafe { view(*mir6) }, sthir_ptr as *const Thir, mut_view(s_arena), unsafe { mut_view(*sink_ptr) }, 0 as *const HirItem);
    let pm6 = arena_alloc_raw(mut_view(s_arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm6) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(s_arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm6) }, unsafe { mut_view(*ob6) }, mut_view(s_arena));
    let mut st6 = LoopSimplifyStats {
        pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32, loops_discovered: 0u32,
        irreducible_cycles: 0u32, preheaders_inserted: 0u32, latches_merged: 0u32,
        dedicated_exits_inserted: 0u32, lcssa_phis_inserted: 0u32,
    };
    loops_stats_zero(mut_view(st6));
    let ainfo6_pre = alias_build_info(unsafe { view(*ob6) }, ct_ptr as *const EffectCallTable, mut_view(s_arena));
    let _ = opt_loop_simplify(
        unsafe { mut_view(*pm6) }, unsafe { mut_view(*ob6) }, ct_ptr as *const EffectCallTable,
        ainfo6_pre as *const AliasInfo, mut_view(st6), mut_view(s_arena), unsafe { mut_view(*sink_ptr) }
    );
    let ainfo6 = alias_build_info(unsafe { view(*ob6) }, ct_ptr as *const EffectCallTable, mut_view(s_arena));
    let tree6 = loops_discover(unsafe { view(*ob6) }, ct_ptr as *const EffectCallTable, ainfo6 as *const AliasInfo, mut_view(s_arena));
    scev_analyze_tree(unsafe { mut_view(*tree6) }, unsafe { view(*ob6) }, ainfo6 as *const AliasInfo, mut_view(s_arena));
    if (unsafe { (*tree6).loop_count }) != 1 {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 202;
    }
    let lp6 = unsafe { loop_desc_at((*tree6).loops, 0) };

    let mut saw_hoist_pure = false;
    let mut saw_hoist_view = false;
    let mut saw_block_mut_load = false;
    let mut saw_block_div_trap = false;
    let mut saw_hoist_disc_view = false;
    let mut saw_block_disc_mut = false;
    let mut saw_block_disc_raw = false;
    let mut saw_block_disc_loc = false;
    let mut load_bb_v: u32 = OPT_BB_NONE;
    let mut load_inst_idx: usize = 0;

    let mut b: usize = 0;
    while b < (unsafe { (*ob6).bb_count }) {
        let bb = unsafe { opt_block_at((*ob6).blocks, b) };
        if unsafe { (*bb).is_reachable } {
            let ic = unsafe { (*bb).inst_count };
            let mut ii: usize = 0;
            while ii < ic {
                let inst = unsafe { opt_inst_at((*bb).insts, ii) };
                let opc = unsafe { (*inst).opcode };
                let sop = unsafe { (*inst).sub_op };
                let dst_l = unsafe { (*inst).place.local.v };
                let can_h = loops_can_hoist_inst(
                    unsafe { view(*lp6) }, unsafe { view(*ob6) }, ainfo6 as *const AliasInfo,
                    ct_ptr as *const EffectCallTable, OptBbId { v: b as u32 }, ii, mut_view(s_arena)
                );
                if opc == OPT_INST_WRAPPING_BINOP && dst_l == 7u32 {
                    if !can_h {
                        probe_free_synth_thir(sthir_ptr);
                        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
                        arena_destroy(mut_view(s_arena));
                        return 203;
                    }
                    saw_hoist_pure = true;
                } else if opc == OPT_INST_LOAD && dst_l == 8u32 {
                    if !can_h {
                        probe_free_synth_thir(sthir_ptr);
                        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
                        arena_destroy(mut_view(s_arena));
                        return 204;
                    }
                    saw_hoist_view = true;
                    load_bb_v = b as u32;
                    load_inst_idx = ii;
                } else if opc == OPT_INST_LOAD && dst_l == 9u32 {
                    if can_h {
                        probe_free_synth_thir(sthir_ptr);
                        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
                        arena_destroy(mut_view(s_arena));
                        return 205;
                    }
                    saw_block_mut_load = true;
                } else if opc == OPT_INST_BINOP && sop == MIR_BINOP_DIV && dst_l == 10u32 {
                    if can_h {
                        probe_free_synth_thir(sthir_ptr);
                        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
                        arena_destroy(mut_view(s_arena));
                        return 206;
                    }
                    saw_block_div_trap = true;
                } else if opc == OPT_INST_DISCRIMINANT && dst_l == 13u32 {
                    if !can_h {
                        probe_free_synth_thir(sthir_ptr);
                        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
                        arena_destroy(mut_view(s_arena));
                        return 250;
                    }
                    saw_hoist_disc_view = true;
                } else if opc == OPT_INST_DISCRIMINANT && dst_l == 14u32 {
                    if can_h {
                        probe_free_synth_thir(sthir_ptr);
                        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
                        arena_destroy(mut_view(s_arena));
                        return 251;
                    }
                    saw_block_disc_mut = true;
                } else if opc == OPT_INST_DISCRIMINANT && dst_l == 15u32 {
                    if can_h {
                        probe_free_synth_thir(sthir_ptr);
                        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
                        arena_destroy(mut_view(s_arena));
                        return 252;
                    }
                    saw_block_disc_raw = true;
                } else if opc == OPT_INST_DISCRIMINANT && dst_l == 16u32 {
                    if can_h {
                        probe_free_synth_thir(sthir_ptr);
                        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
                        arena_destroy(mut_view(s_arena));
                        return 253;
                    }
                    saw_block_disc_loc = true;
                }
                ii = ii + 1;
            }
        }
        b = b + 1;
    }
    if !saw_hoist_pure || !saw_hoist_view || !saw_block_mut_load || !saw_block_div_trap ||
       !saw_hoist_disc_view || !saw_block_disc_mut || !saw_block_disc_raw || !saw_block_disc_loc ||
       load_bb_v == OPT_BB_NONE {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 207;
    }

    let pl_view = make_deref_pl(2u32, mut_view(s_arena));
    let pl_mutv = make_deref_pl(1u32, mut_view(s_arena));
    let pl_rawp = make_deref_pl(4u32, mut_view(s_arena));
    let qpt6 = alias_make_prog_pt(load_bb_v, load_inst_idx as u32);
    let dep_cap = loops_query_dependence(
        unsafe { view(*tree6) }, unsafe { view(*lp6) }, unsafe { view(*ob6) }, ainfo6 as *const AliasInfo,
        view(pl_mutv), qpt6, true, view(pl_view), qpt6, false, mut_view(s_arena)
    );
    let dep_raw = loops_query_dependence(
        unsafe { view(*tree6) }, unsafe { view(*lp6) }, unsafe { view(*ob6) }, ainfo6 as *const AliasInfo,
        view(pl_rawp), qpt6, true, view(pl_mutv), qpt6, true, mut_view(s_arena)
    );
    if dep_cap.kind != DEP_NONE || dep_cap.certainty != CERTAINTY_PROVEN || dep_raw.kind != DEP_UNKNOWN {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 208;
    }

    let lbb_ptr = unsafe { opt_block_at((*ob6).blocks, load_bb_v as usize) };
    let linst_ptr = unsafe { opt_inst_at((*lbb_ptr).insts, load_inst_idx) };
    unsafe { (*linst_ptr).opcode = OPT_INST_VOLATILE_LOAD; }
    let tree_vol = loops_discover(unsafe { view(*ob6) }, ct_ptr as *const EffectCallTable, ainfo6 as *const AliasInfo, mut_view(s_arena));
    let lp_vol = unsafe { loop_desc_at((*tree_vol).loops, 0) };
    let hoist_vol = loops_can_hoist_inst(
        unsafe { view(*lp_vol) }, unsafe { view(*ob6) }, ainfo6 as *const AliasInfo,
        ct_ptr as *const EffectCallTable, OptBbId { v: load_bb_v }, load_inst_idx, mut_view(s_arena)
    );
    if ((unsafe { (*lp_vol).has_observable_barriers }) & BARRIER_VOLATILE) == 0u16 || hoist_vol {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 209;
    }
    unsafe { (*linst_ptr).opcode = OPT_INST_ATOMIC; }
    let tree_gpu = loops_discover_with_domain(
        unsafe { view(*ob6) }, ct_ptr as *const EffectCallTable, ainfo6 as *const AliasInfo, EXEC_DOMAIN_KERNEL, mut_view(s_arena)
    );
    let lp_gpu = unsafe { loop_desc_at((*tree_gpu).loops, 0) };
    if (unsafe { (*tree_gpu).exec_domain }) != EXEC_DOMAIN_KERNEL ||
       ((unsafe { (*lp_gpu).has_observable_barriers }) & BARRIER_ATOMIC) == 0u16 ||
       ((unsafe { (*lp_gpu).has_observable_barriers }) & BARRIER_GPU_DOMAIN) == 0u16 {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 210;
    }

    // 2A2. Synthetic Blob 8: pruned-SSA diamond rebind of `index_local` (`bb4.phi_count == 0`)
    let sv8 = probe_blob(mut_view(s_arena), 8);
    let mir8 = verify_parse_mir(sv8, unsafe { mut_view((*sthir_ptr).interner) }, mut_view(s_arena));
    if (mir8 as usize) == 0 || (unsafe { (*sink_ptr).errors }) != 0 {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 230;
    }
    let ob8 = optir_build_from_mir(unsafe { view(*mir8) }, sthir_ptr as *const Thir, mut_view(s_arena), unsafe { mut_view(*sink_ptr) }, 0 as *const HirItem);
    if (ob8 as usize) == 0 || (unsafe { (*sink_ptr).errors }) != 0 {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 230;
    }
    let ainfo8 = alias_build_info(unsafe { view(*ob8) }, ct_ptr as *const EffectCallTable, mut_view(s_arena));
    let tree8 = loops_discover(unsafe { view(*ob8) }, ct_ptr as *const EffectCallTable, ainfo8 as *const AliasInfo, mut_view(s_arena));
    scev_analyze_tree(unsafe { mut_view(*tree8) }, unsafe { view(*ob8) }, ainfo8 as *const AliasInfo, mut_view(s_arena));
    if (unsafe { (*tree8).loop_count }) != 1 {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 231;
    }
    let lp8 = unsafe { loop_desc_at((*tree8).loops, 0) };
    let mut wr8_pl = mir_local_place(0u32);
    let mut wr8_pt: u32 = 0u32;
    let mut has_wr8 = false;
    let mut rd8_pl = mir_local_place(0u32);
    let mut rd8_pt: u32 = 0u32;
    let mut rd8_bb: usize = 0;
    let mut has_rd8 = false;
    let mut b8: usize = 0;
    while b8 < (unsafe { (*ob8).bb_count }) {
        let bb8 = unsafe { opt_block_at((*ob8).blocks, b8) };
        if unsafe { (*bb8).is_reachable } {
            let ic8 = unsafe { (*bb8).inst_count };
            let mut k8: usize = 0;
            while k8 < ic8 {
                let ins8 = unsafe { opt_inst_at((*bb8).insts, k8) };
                let opc8 = unsafe { (*ins8).opcode };
                if opc8 != OPT_INST_NOP && (unsafe { (*ins8).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                   (unsafe { (*ins8).place.proj_count }) == 1 {
                    let p0 = unsafe { mir_proj_at((*ins8).place.projs, 0) };
                    if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX && !has_wr8 {
                        mir_copy_place(mut_view(wr8_pl), unsafe { view((*ins8).place) });
                        wr8_pt = alias_make_prog_pt(b8 as u32, k8 as u32);
                        has_wr8 = true;
                    }
                } else if opc8 == OPT_INST_LOAD && (unsafe { (*ins8).rhs_place.proj_count }) == 1 {
                    let p0 = unsafe { mir_proj_at((*ins8).rhs_place.projs, 0) };
                    if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX && !has_rd8 {
                        mir_copy_place(mut_view(rd8_pl), unsafe { view((*ins8).rhs_place) });
                        rd8_pt = alias_make_prog_pt(b8 as u32, k8 as u32);
                        rd8_bb = b8;
                        has_rd8 = true;
                    }
                }
                k8 = k8 + 1;
            }
        }
        b8 = b8 + 1;
    }
    if !has_wr8 || !has_rd8 {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 232;
    }
    let rd8_bb_ptr = unsafe { opt_block_at((*ob8).blocks, rd8_bb) };
    if (unsafe { (*rd8_bb_ptr).phi_count }) != 0 {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 233;
    }
    let dep8 = loops_query_dependence(
        unsafe { view(*tree8) }, unsafe { view(*lp8) }, unsafe { view(*ob8) }, ainfo8 as *const AliasInfo,
        view(wr8_pl), wr8_pt, true, view(rd8_pl), rd8_pt, false, mut_view(s_arena)
    );
    if dep8.kind != DEP_UNKNOWN || dep8.certainty != CERTAINTY_UNKNOWN {
        probe_free_synth_thir(sthir_ptr);
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(s_arena));
        return 234;
    }

    probe_free_synth_thir(sthir_ptr);
    unsafe { diag_sink_free(mut_view(*sink_ptr)); }
    arena_destroy(mut_view(s_arena));

    probe_scev_fe_blob7()
}

fn probe_check_blob7_r2_fn(
    fn_seen: usize,
    ob: *mut OptBody,
    tr: *mut LoopTree,
    ai: *mut AliasInfo,
    ct_fe: *mut EffectCallTable,
    arena: mut_view<Arena>
) -> i32 {
    if (unsafe { (*tr).loop_count }) != 1 {
        return 254;
    }
    let lp_a = unsafe { loop_desc_at((*tr).loops, 0) };
    let mut saw_target = false;
    let mut target_hoist = false;
    let mut scrut_src_pl = mir_local_place(0u32);
    let mut has_scrut_src = false;
    let mut bb_i: usize = 0;
    while bb_i < (unsafe { (*ob).bb_count }) {
        let bbp = unsafe { opt_block_at((*ob).blocks, bb_i) };
        let bb_lp = loops_loop_of_block(unsafe { view(*tr) }, OptBbId { v: bb_i as u32 });
        if (unsafe { (*bbp).is_reachable }) && bb_lp.v == (unsafe { (*lp_a).id.v }) {
            let ic = unsafe { (*bbp).inst_count };
            let mut k: usize = 0;
            while k < ic {
                let ins = unsafe { opt_inst_at((*bbp).insts, k) };
                let opc = unsafe { (*ins).opcode };
                if (fn_seen == 14 || fn_seen == 15) &&
                   opc == OPT_INST_LOAD && (unsafe { (*ins).rhs_place.proj_count }) >= 2 {
                    saw_target = true;
                    target_hoist = loops_can_hoist_inst(
                        unsafe { view(*lp_a) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                        ct_fe as *const EffectCallTable, OptBbId { v: bb_i as u32 }, k, mut_view(*arena)
                    );
                } else if fn_seen >= 16 && fn_seen <= 19 {
                    if (opc == OPT_INST_LOAD || opc == OPT_INST_STORE) &&
                       (unsafe { (*ins).rhs_place.proj_count }) == 1 && !has_scrut_src {
                        mir_copy_place(mut_view(scrut_src_pl), unsafe { view((*ins).rhs_place) });
                        has_scrut_src = true;
                    } else if opc == OPT_INST_DISCRIMINANT && !saw_target {
                        let raw_h = loops_can_hoist_inst(
                            unsafe { view(*lp_a) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                            ct_fe as *const EffectCallTable, OptBbId { v: bb_i as u32 }, k, mut_view(*arena)
                        );
                        if raw_h {
                            return 275 + ((fn_seen - 16) as i32);
                        }
                        if has_scrut_src {
                            mir_copy_place(unsafe { mut_view((*ins).rhs_place) }, view(scrut_src_pl));
                        }
                        saw_target = true;
                        target_hoist = loops_can_hoist_inst(
                            unsafe { view(*lp_a) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                            ct_fe as *const EffectCallTable, OptBbId { v: bb_i as u32 }, k, mut_view(*arena)
                        );
                    }
                }
                k = k + 1;
            }
        }
        bb_i = bb_i + 1;
    }
    if !saw_target {
        return 255 + ((fn_seen - 14) as i32);
    }
    let want_hoist = fn_seen == 16;
    if target_hoist != want_hoist {
        return 265 + ((fn_seen - 14) as i32);
    }
    0
}

fn probe_scev_fe_blob7() -> i32 {
    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(262144);
    let mut res_a = new_arena(262144);
    let mut hir_a = new_arena(262144);
    let mut mir_a = new_arena(524288);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };
    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src7_sv = probe_blob(mut_view(perm_a), 7);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src7_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir7 = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir7), mut_view(*thir_fe)); }
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 211;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir7.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 8);

    let mut fn_seen: usize = 0;
    let mut rc7: i32 = 0;
    let mut it: *mut HirItem = hir7.items;
    while (it as usize) != 0 && rc7 == 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
            let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
            if (mbody as usize) != 0 {
                let mut lstats = LoopSimplifyStats {
                    pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32, loops_discovered: 0u32,
                    irreducible_cycles: 0u32, preheaders_inserted: 0u32, latches_merged: 0u32,
                    dedicated_exits_inserted: 0u32, lcssa_phis_inserted: 0u32,
                };
                loops_stats_zero(mut_view(lstats));
                let _ = loops_simplify_mir_body(
                    unsafe { mut_view(*mbody) }, thir_fe as *const Thir, OPT_PROFILE_SPEED_O2, true,
                    ct_fe as *const EffectCallTable, mut_view(lstats), mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem
                );
                let ob = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                let ai = alias_build_info(unsafe { view(*ob) }, ct_fe as *const EffectCallTable, mut_view(mir_a));
                let tr = loops_discover(unsafe { view(*ob) }, ct_fe as *const EffectCallTable, ai as *const AliasInfo, mut_view(mir_a));
                scev_analyze_tree(unsafe { mut_view(*tr) }, unsafe { view(*ob) }, ai as *const AliasInfo, mut_view(mir_a));

                if fn_seen == 0 {
                    if (unsafe { (*tr).loop_count }) != 2 || (unsafe { (*tr).root_count }) != 1 {
                        rc7 = 212;
                    } else {
                        let root_id = unsafe { (*loop_id_at((*tr).root_loops, 0)).v };
                        let outer_lp = unsafe { loop_desc_at((*tr).loops, root_id as usize) };
                        let inner_id = if root_id == 0u32 { 1usize } else { 0usize };
                        let inner_lp = unsafe { loop_desc_at((*tr).loops, inner_id) };
                        let mapped_inner = loops_loop_of_block(unsafe { view(*tr) }, unsafe { (*inner_lp).header });
                        if (unsafe { (*outer_lp).depth }) != 1u32 || (unsafe { (*outer_lp).child_count }) != 1 ||
                           (unsafe { (*inner_lp).depth }) != 2u32 || mapped_inner.v != (unsafe { (*inner_lp).id.v }) ||
                           (unsafe { (*outer_lp).trip_count.kind }) != TRIP_CONST || (unsafe { (*outer_lp).trip_count.const_iters }) != 4u64 ||
                           (unsafe { (*inner_lp).trip_count.kind }) != TRIP_CONST || (unsafe { (*inner_lp).trip_count.const_iters }) != 10u64 ||
                           (unsafe { (*inner_lp).iv_count }) < 3 {
                            rc7 = 213;
                        } else {
                            let piv0 = unsafe { loop_iv_at((*inner_lp).ivs, 0) };
                            let ev_expr = scev_eval_value(
                                unsafe { mut_view(*tr) }, unsafe { (*inner_lp).id }, unsafe { view(*ob) },
                                ai as *const AliasInfo, unsafe { (*piv0).phi_val }, mut_view(mir_a)
                            );
                            if ev_expr.kind != SCEV_ADD_REC || !ev_expr.no_wrap_proven ||
                               (unsafe { (*piv0).arith_mode }) != ARITH_PROVEN_NSW_NUW {
                                rc7 = 214;
                            }
                        }
                    }
                } else if fn_seen == 1 {
                    let lp = unsafe { loop_desc_at((*tr).loops, 0) };
                    if (unsafe { (*tr).loop_count }) != 1 || (unsafe { (*lp).depth }) != 1u32 ||
                       (unsafe { (*lp).trip_count.kind }) != TRIP_SYMBOLIC {
                        rc7 = 215;
                    }
                } else if fn_seen == 2 {
                    let lp = unsafe { loop_desc_at((*tr).loops, 0) };
                    if (unsafe { (*tr).loop_count }) != 1 ||
                       (unsafe { (*lp).trip_count.kind }) != TRIP_UPPER_BOUNDED ||
                       (unsafe { (*lp).trip_count.max_iters }) != 8u64 {
                        rc7 = 216;
                    }
                } else if fn_seen == 3 {
                    let lp = unsafe { loop_desc_at((*tr).loops, 0) };
                    if (unsafe { (*tr).loop_count }) != 1 || (unsafe { (*lp).trip_count.kind }) != TRIP_INFINITE ||
                       (unsafe { (*lp).iv_count }) == 0 {
                        rc7 = 217;
                    } else {
                        let piv3 = unsafe { loop_iv_at((*lp).ivs, 0) };
                        if (unsafe { (*piv3).arith_mode }) != ARITH_WRAPPING || (unsafe { (*piv3).no_wrap_proven }) {
                            rc7 = 217;
                        }
                    }
                } else if fn_seen == 4 {
                    let lp = unsafe { loop_desc_at((*tr).loops, 0) };
                    if (unsafe { (*tr).loop_count }) != 1 || (unsafe { (*lp).trip_count.kind }) != TRIP_UNKNOWN {
                        rc7 = 218;
                    }
                } else if fn_seen == 5 {
                    let lp = unsafe { loop_desc_at((*tr).loops, 0) };
                    let mut saw_eo_disjoint = false;
                    let mut saw_raw_dist1 = false;
                    let mut bb_i: usize = 0;
                    let mut eo_pl0 = mir_local_place(0u32);
                    let mut eo_pt0: u32 = 0u32;
                    let mut eo_cnt: usize = 0;
                    let mut dep_wr_pl = mir_local_place(0u32);
                    let mut dep_wr_pt: u32 = 0u32;
                    let mut has_dep_wr = false;
                    let mut dep_rd_pl = mir_local_place(0u32);
                    let mut dep_rd_pt: u32 = 0u32;
                    let mut has_dep_rd = false;
                    while bb_i < (unsafe { (*ob).bb_count }) {
                        let bbp = unsafe { opt_block_at((*ob).blocks, bb_i) };
                        let cur_bb_id = OptBbId { v: bb_i as u32 };
                        let bb_lp = loops_loop_of_block(unsafe { view(*tr) }, cur_bb_id);
                        if (unsafe { (*bbp).is_reachable }) && bb_lp.v == (unsafe { (*lp).id.v }) {
                            let ic = unsafe { (*bbp).inst_count };
                            let mut k: usize = 0;
                            while k < ic {
                                let ins = unsafe { opt_inst_at((*bbp).insts, k) };
                                let opc = unsafe { (*ins).opcode };
                                let ins_sk = unsafe { (*ins).orig_stmt.kind };
                                let ins_pc = unsafe { (*ins).place.proj_count };
                                if opc != OPT_INST_NOP && ins_sk == MIR_STMT_ASSIGN && ins_pc == 1 {
                                    let p0 = unsafe { mir_proj_at((*ins).place.projs, 0) };
                                    if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX {
                                        if eo_cnt == 0 {
                                            mir_copy_place(mut_view(eo_pl0), unsafe { view((*ins).place) });
                                            eo_pt0 = alias_make_prog_pt(bb_i as u32, k as u32);
                                            eo_cnt = 1;
                                        } else if eo_cnt == 1 && (unsafe { (*ins).place.local.v }) == eo_pl0.local.v {
                                            let d_eo = loops_query_dependence(
                                                unsafe { view(*tr) }, unsafe { view(*lp) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                                                view(eo_pl0), eo_pt0, true, unsafe { view((*ins).place) }, alias_make_prog_pt(bb_i as u32, k as u32), true, mut_view(mir_a)
                                            );
                                            if d_eo.kind == DEP_NONE && d_eo.certainty == CERTAINTY_PROVEN {
                                                saw_eo_disjoint = true;
                                            }
                                            eo_cnt = 2;
                                        } else if (unsafe { (*ins).place.local.v }) != eo_pl0.local.v {
                                            mir_copy_place(mut_view(dep_wr_pl), unsafe { view((*ins).place) });
                                            dep_wr_pt = alias_make_prog_pt(bb_i as u32, k as u32);
                                            has_dep_wr = true;
                                        }
                                    }
                                } else if opc == OPT_INST_LOAD && (unsafe { (*ins).rhs_place.proj_count }) == 1 {
                                    let p0 = unsafe { mir_proj_at((*ins).rhs_place.projs, 0) };
                                    if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX {
                                        mir_copy_place(mut_view(dep_rd_pl), unsafe { view((*ins).rhs_place) });
                                        dep_rd_pt = alias_make_prog_pt(bb_i as u32, k as u32);
                                        has_dep_rd = true;
                                    }
                                }
                                k = k + 1;
                            }
                        }
                        bb_i = bb_i + 1;
                    }
                    if has_dep_wr && has_dep_rd {
                        let d_flow = loops_query_dependence(
                            unsafe { view(*tr) }, unsafe { view(*lp) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                            view(dep_wr_pl), dep_wr_pt, true, view(dep_rd_pl), dep_rd_pt, false, mut_view(mir_a)
                        );
                        if d_flow.kind == DEP_RAW_FLOW && d_flow.is_constant_dist && d_flow.distance == 1i64 && d_flow.certainty == CERTAINTY_PROVEN {
                            saw_raw_dist1 = true;
                        }
                    }
                    if !saw_eo_disjoint || !saw_raw_dist1 {
                        rc7 = 219;
                    }
                } else if fn_seen == 6 {
                    let lp = unsafe { loop_desc_at((*tr).loops, 0) };
                    let mut wr3a_pl = mir_local_place(0u32);
                    let mut wr3a_pt: u32 = 0u32;
                    let mut has_wr3a = false;
                    let mut rd3a_pl = mir_local_place(0u32);
                    let mut rd3a_pt: u32 = 0u32;
                    let mut has_rd3a = false;
                    let mut bb_i: usize = 0;
                    while bb_i < (unsafe { (*ob).bb_count }) {
                        let bbp = unsafe { opt_block_at((*ob).blocks, bb_i) };
                        let bb_lp = loops_loop_of_block(unsafe { view(*tr) }, OptBbId { v: bb_i as u32 });
                        if (unsafe { (*bbp).is_reachable }) && bb_lp.v == (unsafe { (*lp).id.v }) {
                            let ic = unsafe { (*bbp).inst_count };
                            let mut k: usize = 0;
                            while k < ic {
                                let ins = unsafe { opt_inst_at((*bbp).insts, k) };
                                let opc = unsafe { (*ins).opcode };
                                if opc != OPT_INST_NOP && (unsafe { (*ins).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                                   (unsafe { (*ins).place.proj_count }) == 1 {
                                    let p0 = unsafe { mir_proj_at((*ins).place.projs, 0) };
                                    if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX && !has_wr3a {
                                        mir_copy_place(mut_view(wr3a_pl), unsafe { view((*ins).place) });
                                        wr3a_pt = alias_make_prog_pt(bb_i as u32, k as u32);
                                        has_wr3a = true;
                                    }
                                } else if opc == OPT_INST_LOAD && (unsafe { (*ins).rhs_place.proj_count }) == 1 {
                                    let p0 = unsafe { mir_proj_at((*ins).rhs_place.projs, 0) };
                                    if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX && !has_rd3a {
                                        mir_copy_place(mut_view(rd3a_pl), unsafe { view((*ins).rhs_place) });
                                        rd3a_pt = alias_make_prog_pt(bb_i as u32, k as u32);
                                        has_rd3a = true;
                                    }
                                }
                                k = k + 1;
                            }
                        }
                        bb_i = bb_i + 1;
                    }
                    if !has_wr3a || !has_rd3a {
                        rc7 = 221;
                    } else {
                        let d_3a = loops_query_dependence(
                            unsafe { view(*tr) }, unsafe { view(*lp) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                            view(wr3a_pl), wr3a_pt, true, view(rd3a_pl), rd3a_pt, false, mut_view(mir_a)
                        );
                        if d_3a.kind != DEP_WAR_ANTI || !d_3a.is_constant_dist ||
                           d_3a.distance != 1i64 || d_3a.certainty != CERTAINTY_PROVEN {
                            rc7 = 222;
                        }
                    }
                } else if fn_seen == 7 {
                    let lp = unsafe { loop_desc_at((*tr).loops, 0) };
                    let mut wr0_pl = mir_local_place(0u32);
                    let mut wr0_pt: u32 = 0u32;
                    let mut wr1_pl = mir_local_place(0u32);
                    let mut wr1_pt: u32 = 0u32;
                    let mut wr_cnt: usize = 0;
                    let mut bb_i: usize = 0;
                    while bb_i < (unsafe { (*ob).bb_count }) {
                        let bbp = unsafe { opt_block_at((*ob).blocks, bb_i) };
                        let bb_lp = loops_loop_of_block(unsafe { view(*tr) }, OptBbId { v: bb_i as u32 });
                        if (unsafe { (*bbp).is_reachable }) && bb_lp.v == (unsafe { (*lp).id.v }) {
                            let ic = unsafe { (*bbp).inst_count };
                            let mut k: usize = 0;
                            while k < ic {
                                let ins = unsafe { opt_inst_at((*bbp).insts, k) };
                                let opc = unsafe { (*ins).opcode };
                                if opc != OPT_INST_NOP && (unsafe { (*ins).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                                   (unsafe { (*ins).place.proj_count }) == 2 {
                                    let p0 = unsafe { mir_proj_at((*ins).place.projs, 0) };
                                    let p1 = unsafe { mir_proj_at((*ins).place.projs, 1) };
                                    if (unsafe { (*p0).kind }) == MIR_PROJ_DEREF && (unsafe { (*p1).kind }) == MIR_PROJ_INDEX {
                                        if wr_cnt == 0 {
                                            mir_copy_place(mut_view(wr0_pl), unsafe { view((*ins).place) });
                                            wr0_pt = alias_make_prog_pt(bb_i as u32, k as u32);
                                            wr_cnt = 1;
                                        } else if wr_cnt == 1 {
                                            mir_copy_place(mut_view(wr1_pl), unsafe { view((*ins).place) });
                                            wr1_pt = alias_make_prog_pt(bb_i as u32, k as u32);
                                            wr_cnt = 2;
                                        }
                                    }
                                }
                                k = k + 1;
                            }
                        }
                        bb_i = bb_i + 1;
                    }
                    if wr_cnt != 2 {
                        rc7 = 223;
                    } else {
                        let d_3b = loops_query_dependence(
                            unsafe { view(*tr) }, unsafe { view(*lp) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                            view(wr0_pl), wr0_pt, true, view(wr1_pl), wr1_pt, true, mut_view(mir_a)
                        );
                        if d_3b.kind != DEP_UNKNOWN {
                            rc7 = 224;
                        }
                    }
                } else if fn_seen == 8 {
                    let ri2 = range_build_info(unsafe { view(*ob) }, tr as *const LoopTree, ai as *const AliasInfo, ct_fe as *const EffectCallTable, mut_view(mir_a));
                    let sc2 = unsafe { (*ri2).subslice_count };
                    if sc2 < 2 {
                        rc7 = 225;
                    } else {
                        let sf_l = unsafe { bce_subslice_at((*ri2).subslices, sc2 - 2) };
                        let sf_r = unsafe { bce_subslice_at((*ri2).subslices, sc2 - 1) };
                        let pl_l = mir_local_place(unsafe { (*sf_l).slice_local });
                        let pl_r = mir_local_place(unsafe { (*sf_r).slice_local });
                        let qbb2 = unsafe { (*sf_r).def_bb };
                        let qinst2 = (unsafe { (*sf_r).def_inst_idx }) + 1u32;
                        let af_reb = bce_prove_subrange_disjoint(
                            unsafe { view(*ri2) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                            ct_fe as *const EffectCallTable, view(pl_l), view(pl_r), qbb2, qinst2, mut_view(mir_a)
                        );
                        if af_reb.result != ALIAS_MAY_ALIAS {
                            rc7 = 226;
                        } else {
                            let mut st0_pl = mir_local_place(0u32);
                            let mut st1_pl = mir_local_place(0u32);
                            let mut st_bb = OptBbId { v: 0u32 };
                            let mut st_ii: u32 = 0u32;
                            let mut st_cnt: usize = 0;
                            let mut bb_i: usize = 0;
                            while bb_i < (unsafe { (*ob).bb_count }) {
                                let bbp = unsafe { opt_block_at((*ob).blocks, bb_i) };
                                if unsafe { (*bbp).is_reachable } {
                                    let ic = unsafe { (*bbp).inst_count };
                                    let mut k: usize = 0;
                                    while k < ic {
                                        let ins = unsafe { opt_inst_at((*bbp).insts, k) };
                                        if (unsafe { (*ins).opcode }) != OPT_INST_NOP &&
                                           (unsafe { (*ins).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                                           (unsafe { (*ins).place.proj_count }) == 2 {
                                            let p0 = unsafe { mir_proj_at((*ins).place.projs, 0) };
                                            let p1 = unsafe { mir_proj_at((*ins).place.projs, 1) };
                                            if (unsafe { (*p0).kind }) == MIR_PROJ_DEREF && (unsafe { (*p1).kind }) == MIR_PROJ_INDEX {
                                                if st_cnt == 0 {
                                                    mir_copy_place(mut_view(st0_pl), unsafe { view((*ins).place) });
                                                    st_cnt = 1;
                                                } else if st_cnt == 1 {
                                                    mir_copy_place(mut_view(st1_pl), unsafe { view((*ins).place) });
                                                    st_bb = OptBbId { v: bb_i as u32 };
                                                    st_ii = k as u32;
                                                    st_cnt = 2;
                                                }
                                            }
                                        }
                                        k = k + 1;
                                    }
                                }
                                bb_i = bb_i + 1;
                            }
                            if st_cnt != 2 {
                                rc7 = 227;
                            } else {
                                let af_elem = bce_prove_subrange_disjoint(
                                    unsafe { view(*ri2) }, unsafe { view(*ob) }, ai as *const AliasInfo,
                                    ct_fe as *const EffectCallTable, view(st0_pl), view(st1_pl), st_bb, st_ii, mut_view(mir_a)
                                );
                                if af_elem.result != ALIAS_MAY_ALIAS {
                                    rc7 = 228;
                                }
                            }
                        }
                    }
                } else if fn_seen >= 9 && fn_seen <= 12 {
                    let ri_r1 = range_build_info(unsafe { view(*ob) }, tr as *const LoopTree, ai as *const AliasInfo, ct_fe as *const EffectCallTable, mut_view(mir_a));
                    if !probe_verify_rebound_subslice_may_alias(ob, ri_r1, ai, ct_fe, mut_view(mir_a)) {
                        rc7 = 240 + ((fn_seen - 9) as i32);
                    }
                } else if fn_seen == 13 {
                    let mut pass_k: usize = 0;
                    while pass_k < 2 && rc7 == 0 {
                        let mut cur_ob = ob;
                        let mut cur_ai = ai;
                        let mut cur_tr = tr;
                        if pass_k == 1 {
                            let mut bstats = BceStats {
                                pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32, sites_inspected: 0u32,
                                checks_eliminated: 0u32, checks_retained_possible: 0u32, checks_retained_unknown: 0u32,
                                array_checks_eliminated: 0u32, slice_checks_eliminated: 0u32, vec_checks_eliminated: 0u32,
                                blocks_pruned: 0u32,
                            };
                            bce_stats_zero(mut_view(bstats));
                            let ok_bce = bce_optimize_mir_body(
                                unsafe { mut_view(*mbody) }, thir_fe as *const Thir, OPT_PROFILE_SPEED_O2, true,
                                ct_fe as *const EffectCallTable, mut_view(bstats), mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem
                            );
                            if !ok_bce || (unsafe { (*sink_fe).errors }) != 0 {
                                rc7 = 245;
                            } else {
                                cur_ob = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                                cur_ai = alias_build_info(unsafe { view(*cur_ob) }, ct_fe as *const EffectCallTable, mut_view(mir_a));
                                cur_tr = loops_discover(unsafe { view(*cur_ob) }, ct_fe as *const EffectCallTable, cur_ai as *const AliasInfo, mut_view(mir_a));
                                scev_analyze_tree(unsafe { mut_view(*cur_tr) }, unsafe { view(*cur_ob) }, cur_ai as *const AliasInfo, mut_view(mir_a));
                            }
                        }
                        if rc7 == 0 {
                            let lp_c = unsafe { loop_desc_at((*cur_tr).loops, 0) };
                            let mut wrc_pl = mir_local_place(0u32);
                            let mut wrc_pt: u32 = 0u32;
                            let mut has_wrc = false;
                            let mut rdc_pl = mir_local_place(0u32);
                            let mut rdc_pt: u32 = 0u32;
                            let mut has_rdc = false;
                            let mut bb_i: usize = 0;
                            while bb_i < (unsafe { (*cur_ob).bb_count }) {
                                let bbp = unsafe { opt_block_at((*cur_ob).blocks, bb_i) };
                                let bb_lp = loops_loop_of_block(unsafe { view(*cur_tr) }, OptBbId { v: bb_i as u32 });
                                if (unsafe { (*bbp).is_reachable }) && bb_lp.v == (unsafe { (*lp_c).id.v }) {
                                    let ic = unsafe { (*bbp).inst_count };
                                    let mut k: usize = 0;
                                    while k < ic {
                                        let ins = unsafe { opt_inst_at((*bbp).insts, k) };
                                        let opc = unsafe { (*ins).opcode };
                                        if opc != OPT_INST_NOP && (unsafe { (*ins).orig_stmt.kind }) == MIR_STMT_ASSIGN &&
                                           (unsafe { (*ins).place.proj_count }) == 1 {
                                            let p0 = unsafe { mir_proj_at((*ins).place.projs, 0) };
                                            if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX && !has_wrc {
                                                mir_copy_place(mut_view(wrc_pl), unsafe { view((*ins).place) });
                                                wrc_pt = alias_make_prog_pt(bb_i as u32, k as u32);
                                                has_wrc = true;
                                            }
                                        } else if opc == OPT_INST_LOAD && (unsafe { (*ins).rhs_place.proj_count }) == 1 {
                                            let p0 = unsafe { mir_proj_at((*ins).rhs_place.projs, 0) };
                                            if (unsafe { (*p0).kind }) == MIR_PROJ_INDEX && !has_rdc {
                                                mir_copy_place(mut_view(rdc_pl), unsafe { view((*ins).rhs_place) });
                                                rdc_pt = alias_make_prog_pt(bb_i as u32, k as u32);
                                                has_rdc = true;
                                            }
                                        }
                                        k = k + 1;
                                    }
                                }
                                bb_i = bb_i + 1;
                            }
                            if !has_wrc || !has_rdc {
                                rc7 = 246 + (pass_k as i32);
                            } else {
                                let d_c = loops_query_dependence(
                                    unsafe { view(*cur_tr) }, unsafe { view(*lp_c) }, unsafe { view(*cur_ob) }, cur_ai as *const AliasInfo,
                                    view(wrc_pl), wrc_pt, true, view(rdc_pl), rdc_pt, false, mut_view(mir_a)
                                );
                                if d_c.kind != DEP_UNKNOWN {
                                    rc7 = 248 + (pass_k as i32);
                                }
                            }
                        }
                        pass_k = pass_k + 1;
                    }
                } else if fn_seen >= 14 && fn_seen <= 19 {
                    rc7 = probe_check_blob7_r2_fn(fn_seen, ob, tr, ai, ct_fe, mut_view(mir_a));
                }
                fn_seen = fn_seen + 1;
            }
        }
        it = unsafe { (*it).next };
    }
    if rc7 == 0 && fn_seen != 20 {
        rc7 = 220;
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc7
}

// Section 3: Frontend-Lowered Positive BCE, ProofProvenance, Subrange Disjointness & Ownership/Drop Verification
fn probe_frontend_lowered_bce_positive() -> i32 {
    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(131072);
    let mut res_a = new_arena(131072);
    let mut hir_a = new_arena(131072);
    let mut mir_a = new_arena(524288);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src1_sv = probe_blob(mut_view(perm_a), 1);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src1_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir1 = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir1), mut_view(*thir_fe)); }
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 301;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir1.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 8);

    let mut fn_idx: usize = 0;
    let mut rc: i32 = 0;
    let mut it: *mut HirItem = hir1.items;
    while (it as usize) != 0 && rc == 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
            let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
            if (mbody as usize) != 0 {
                let mut bstats = BceStats {
                    pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32, sites_inspected: 0u32,
                    checks_eliminated: 0u32, checks_retained_possible: 0u32, checks_retained_unknown: 0u32,
                    array_checks_eliminated: 0u32, slice_checks_eliminated: 0u32, vec_checks_eliminated: 0u32,
                    blocks_pruned: 0u32,
                };

                if fn_idx == 1 {
                    bce_stats_zero(mut_view(bstats));
                    if !bce_optimize_mir_body(
                        unsafe { mut_view(*mbody) }, thir_fe as *const Thir, OPT_PROFILE_DEBUG_O0, true,
                        ct_fe as *const EffectCallTable, mut_view(bstats), mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem
                    ) || bstats.checks_eliminated != 0u32 || bstats.pass_runs != 0u32 {
                        rc = 302;
                    }
                }

                if rc == 0 && fn_idx == 6 {
                    let ob6 = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                    let pm6 = arena_alloc_raw(mut_view(mir_a), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
                    passmgr_init(unsafe { mut_view(*pm6) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(mir_a));
                    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm6) }, unsafe { mut_view(*ob6) }, mut_view(mir_a));

                    let ai6_a = alias_build_info(unsafe { view(*ob6) }, ct_fe as *const EffectCallTable, mut_view(mir_a));
                    let mut ls6 = LoopSimplifyStats {
                        pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32, loops_discovered: 0u32,
                        irreducible_cycles: 0u32, preheaders_inserted: 0u32, latches_merged: 0u32,
                        dedicated_exits_inserted: 0u32, lcssa_phis_inserted: 0u32,
                    };
                    loops_stats_zero(mut_view(ls6));
                    let _ = opt_loop_simplify(
                        unsafe { mut_view(*pm6) }, unsafe { mut_view(*ob6) }, ct_fe as *const EffectCallTable,
                        ai6_a as *const AliasInfo, mut_view(ls6), mut_view(mir_a), unsafe { mut_view(*sink_fe) }
                    );
                    let ai6 = alias_build_info(unsafe { view(*ob6) }, ct_fe as *const EffectCallTable, mut_view(mir_a));
                    let lt6 = loops_discover(unsafe { view(*ob6) }, ct_fe as *const EffectCallTable, ai6 as *const AliasInfo, mut_view(mir_a));
                    scev_analyze_tree(unsafe { mut_view(*lt6) }, unsafe { view(*ob6) }, ai6 as *const AliasInfo, mut_view(mir_a));
                    let ri6 = range_build_info(unsafe { view(*ob6) }, lt6 as *const LoopTree, ai6 as *const AliasInfo, ct_fe as *const EffectCallTable, mut_view(mir_a));

                    if (unsafe { (*ri6).subslice_count }) < 2 {
                        rc = 303;
                    } else {
                        let sf0 = unsafe { bce_subslice_at((*ri6).subslices, 0) };
                        let sf1 = unsafe { bce_subslice_at((*ri6).subslices, 1) };
                        let pl_s0 = mir_local_place(unsafe { (*sf0).slice_local });
                        let pl_s1 = mir_local_place(unsafe { (*sf1).slice_local });
                        let qbb6 = unsafe { (*sf1).def_bb };
                        let af_disj = bce_prove_subrange_disjoint(
                            unsafe { view(*ri6) }, unsafe { view(*ob6) }, ai6 as *const AliasInfo,
                            ct_fe as *const EffectCallTable, view(pl_s0), view(pl_s1), qbb6, 0u32, mut_view(mir_a)
                        );
                        let af_same = bce_prove_subrange_disjoint(
                            unsafe { view(*ri6) }, unsafe { view(*ob6) }, ai6 as *const AliasInfo,
                            ct_fe as *const EffectCallTable, view(pl_s0), view(pl_s0), qbb6, 0u32, mut_view(mir_a)
                        );
                        if af_disj.result != ALIAS_NO_ALIAS || af_disj.relation != REGION_DISJOINT ||
                           af_disj.certainty != CERTAINTY_PROVEN || af_disj.reason != ALIAS_REASON_RANGE_DISJOINT ||
                           af_same.result != ALIAS_MAY_ALIAS {
                            rc = 304;
                        }
                    }

                    if rc == 0 {
                        let mut st6_dir = bstats;
                        bce_stats_zero(mut_view(st6_dir));
                        let mut sites_ptr: *mut BceSiteRecord = 0 as *mut BceSiteRecord;
                        let mut site_cnt: usize = 0;
                        let ch6 = opt_bce(
                            unsafe { mut_view(*pm6) }, unsafe { mut_view(*ob6) }, ct_fe as *const EffectCallTable,
                            mut_view(mir_a), unsafe { mut_view(*sink_fe) }, mut_view(st6_dir),
                            unsafe { address_of_mut(sites_ptr) }, unsafe { address_of_mut(site_cnt) }
                        );
                        if !ch6 || site_cnt == 0 || (unsafe { (*ob6).provenance_count }) == 0 {
                            rc = 305;
                        } else {
                            let mut saw_elim_site = false;
                            let mut si: usize = 0;
                            while si < site_cnt {
                                let sr = unsafe { bce_site_at(sites_ptr, si) };
                                if (unsafe { (*sr).decision }) == BCE_ELIMINATED_PROVEN {
                                    saw_elim_site = true;
                                }
                                si = si + 1;
                            }
                            let mut saw_bce_prov = false;
                            let pcnt6 = unsafe { (*ob6).provenance_count };
                            let mut pi: usize = 0;
                            while pi < pcnt6 {
                                let prp = unsafe { opt_prov_at((*ob6).provenance, pi) };
                                if (unsafe { (*prp).prop_kind }) == PROP_IN_BOUNDS &&
                                   (unsafe { (*prp).certainty }) == CERTAINTY_PROVEN &&
                                   (unsafe { (*prp).pass_id }) == PASS_BCE {
                                    saw_bce_prov = true;
                                }
                                pi = pi + 1;
                            }
                            if !saw_elim_site || !saw_bce_prov {
                                rc = 306;
                            }
                        }

                        if rc == 0 {
                            let mut bp1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
                            let mut bp2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
                            diag_buf_init(mut_view(bp1));
                            diag_buf_init(mut_view(bp2));
                            bce_print(mut_view(bp1), unsafe { view(*ri6) }, view(st6_dir));
                            bce_print(mut_view(bp2), unsafe { view(*ri6) }, view(st6_dir));
                            let bprint_ok = bp1.len > 16 && diag_buf_eq(view(bp1), view(bp2));
                            diag_buf_free(mut_view(bp1));
                            diag_buf_free(mut_view(bp2));
                            if !bprint_ok {
                                rc = 307;
                            }
                        }
                    }
                }

                if rc == 0 {
                    bce_stats_zero(mut_view(bstats));
                    let ok = bce_optimize_mir_body(
                        unsafe { mut_view(*mbody) }, thir_fe as *const Thir, OPT_PROFILE_SPEED_O2, true,
                        ct_fe as *const EffectCallTable, mut_view(bstats), mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem
                    );
                    if !ok || bstats.pass_rollbacks != 0u32 || (unsafe { (*sink_fe).errors }) != 0 {
                        rc = 308;
                    } else if fn_idx == 0 && !(bstats.array_checks_eliminated >= 2u32) {
                        rc = 309;
                    } else if fn_idx == 1 && (bstats.slice_checks_eliminated == 0u32 || bstats.checks_retained_possible != 0u32 || bstats.checks_retained_unknown != 0u32) {
                        rc = 310;
                    } else if fn_idx == 2 && !(bstats.slice_checks_eliminated >= 3u32) {
                        rc = 311;
                    } else if fn_idx == 3 && bstats.vec_checks_eliminated == 0u32 {
                        rc = 312;
                    } else if fn_idx == 4 && bstats.slice_checks_eliminated == 0u32 {
                        rc = 313;
                    } else if fn_idx == 5 && bstats.slice_checks_eliminated == 0u32 {
                        rc = 314;
                    } else if fn_idx == 6 && !(bstats.checks_eliminated >= 4u32) {
                        rc = 315;
                    } else if fn_idx == 7 && bstats.vec_checks_eliminated == 0u32 {
                        rc = 319;
                    }
                }

                if rc == 0 {
                    verify_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                    verify_mir_own(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                    verify_mir_cap(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) });
                    unsafe {
                        mir_drop_elaborate(
                            mut_view(*mbody), mut_view(*thir_fe), view(hir1), db_ptr, view(*str_in_ptr), mut_view(mir_a)
                        );
                    }
                    verify_mir_drop_flags(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                    if (unsafe { (*sink_fe).errors }) != 0 {
                        rc = 316;
                    }
                }
                fn_idx = fn_idx + 1;
            }
        }
        it = unsafe { (*it).next };
    }

    if rc == 0 {
        let mut s_arena = arena_new();
        let sink_s = arena_alloc_raw(mut_view(s_arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
        unsafe { diag_sink_init(mut_view(*sink_s)); }
        let sthir = arena_alloc_raw(mut_view(s_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
        probe_init_synth_thir(sthir, mut_view(s_arena));
        let sv6 = probe_blob(mut_view(s_arena), 6);
        let mir_r = verify_parse_mir(sv6, unsafe { mut_view((*sthir).interner) }, mut_view(s_arena));
        let ob_r = optir_build_from_mir(unsafe { view(*mir_r) }, sthir as *const Thir, mut_view(s_arena), unsafe { mut_view(*sink_s) }, 0 as *const HirItem);
        let ai_r = alias_build_info(unsafe { view(*ob_r) }, ct_fe as *const EffectCallTable, mut_view(s_arena));
        let lt_r = loops_discover(unsafe { view(*ob_r) }, ct_fe as *const EffectCallTable, ai_r as *const AliasInfo, mut_view(s_arena));
        let ri_r = range_build_info(unsafe { view(*ob_r) }, lt_r as *const LoopTree, ai_r as *const AliasInfo, ct_fe as *const EffectCallTable, mut_view(s_arena));
        let pl_raw = make_deref_pl(4u32, mut_view(s_arena));
        let pl_mv = make_deref_pl(1u32, mut_view(s_arena));
        let af_raw = bce_prove_subrange_disjoint(
            unsafe { view(*ri_r) }, unsafe { view(*ob_r) }, ai_r as *const AliasInfo,
            ct_fe as *const EffectCallTable, view(pl_raw), view(pl_mv), OptBbId { v: 0u32 }, 0u32, mut_view(s_arena)
        );
        if af_raw.result != ALIAS_UNKNOWN || af_raw.reason != ALIAS_REASON_RAW_PTR_PROVENANCE {
            rc = 317;
        }
        probe_free_synth_thir(sthir);
        unsafe { diag_sink_free(mut_view(*sink_s)); }
        arena_destroy(mut_view(s_arena));
    }

    if rc == 0 && fn_idx != 8 {
        rc = 318;
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

// Section 4: Frontend-Lowered Negative BCE — ZERO False-Positive Eliminations Allowed!
fn probe_frontend_lowered_bce_negative() -> i32 {
    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(131072);
    let mut res_a = new_arena(131072);
    let mut hir_a = new_arena(131072);
    let mut mir_a = new_arena(524288);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src2_sv = probe_blob(mut_view(perm_a), 2);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src2_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir2 = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir2), mut_view(*thir_fe)); }
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 401;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir2.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 8);

    let mut neg_checked: usize = 0;
    let mut rc: i32 = 0;
    let mut it: *mut HirItem = hir2.items;
    while (it as usize) != 0 && rc == 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
            let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
            if (mbody as usize) != 0 {
                let mut bstats = BceStats {
                    pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32, sites_inspected: 0u32,
                    checks_eliminated: 0u32, checks_retained_possible: 0u32, checks_retained_unknown: 0u32,
                    array_checks_eliminated: 0u32, slice_checks_eliminated: 0u32, vec_checks_eliminated: 0u32,
                    blocks_pruned: 0u32,
                };
                bce_stats_zero(mut_view(bstats));
                let ok = bce_optimize_mir_body(
                    unsafe { mut_view(*mbody) }, thir_fe as *const Thir, OPT_PROFILE_SPEED_O2, true,
                    ct_fe as *const EffectCallTable, mut_view(bstats), mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem
                );
                let bad_elim: bool = if neg_checked == 10 {
                    bstats.vec_checks_eliminated != 0u32 ||
                    bstats.slice_checks_eliminated != 0u32 ||
                    (bstats.checks_retained_possible + bstats.checks_retained_unknown) == 0u32
                } else {
                    bstats.checks_eliminated != 0u32
                };
                if !ok || bstats.pass_rollbacks != 0u32 || bstats.sites_inspected == 0u32 || bad_elim {
                    rc = 410 + (neg_checked as i32);
                } else {
                    verify_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                    verify_mir_own(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                    verify_mir_cap(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) });
                    unsafe {
                        mir_drop_elaborate(
                            mut_view(*mbody), mut_view(*thir_fe), view(hir2), db_ptr, view(*str_in_ptr), mut_view(mir_a)
                        );
                    }
                    verify_mir_drop_flags(unsafe { view(*mbody) }, thir_fe as *const Thir, unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                    if (unsafe { (*sink_fe).errors }) != 0 {
                        rc = 430 + (neg_checked as i32);
                    }
                }
                neg_checked = neg_checked + 1;
            }
        }
        it = unsafe { (*it).next };
    }
    if rc == 0 && neg_checked != 11 {
        rc = 402;
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

// Section 5: Loop Transformations (`LICM`, `IV Strength Reduction`, `Peel`, `Unswitch`, `Unroll`, `Version`, `Fuse`)
struct ProbeTypes {
    thir: *mut Thir,
    ty_i32: u32,
    ty_usize: u32,
    ty_bool: u32,
    ty_f64: u32,
    ty_arr8_i32: u32,
}

fn pb_init_types(arena: mut_view<Arena>) -> ProbeTypes {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let types_arr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(32, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType;
    let pool = arena_alloc_raw(mut_view(*arena), mir_mul_usize(28, size_of<AxType>()), align_of<AxType>());
    let ty_sz = size_of<AxType>();

    let mut k: usize = 0;
    while k < 16 {
        let tp = ((pool as usize) + mir_mul_usize(k, ty_sz)) as *mut AxType;
        let tk: u8 = if k < 9 { k as u8 }
            else if k == 9 { TY_ISIZE }
            else if k == 10 { TY_U8 }
            else if k == 11 { TY_U16 }
            else if k == 12 { TY_U32 }
            else if k == 13 { TY_U64 }
            else if k == 14 { TY_USIZE }
            else { TY_STR };
        unsafe { ax_type_reset(mut_view(*tp), tk); }
        probe_set_ty_slot(types_arr, k, tp);
        k = k + 1;
    }

    let mut c: usize = 16;
    while c < 22 {
        let cp = ((pool as usize) + mir_mul_usize(c, ty_sz)) as *mut AxType;
        unsafe { ax_type_reset(mut_view(*cp), 0u8); }
        probe_set_ty_slot(types_arr, c, cp);
        c = c + 1;
    }

    let t17 = ((pool as usize) + mir_mul_usize(16, ty_sz)) as *mut AxType;
    let t18 = ((pool as usize) + mir_mul_usize(17, ty_sz)) as *mut AxType;
    let t19 = ((pool as usize) + mir_mul_usize(18, ty_sz)) as *mut AxType;
    let t20 = ((pool as usize) + mir_mul_usize(19, ty_sz)) as *mut AxType;
    let t21 = ((pool as usize) + mir_mul_usize(20, ty_sz)) as *mut AxType;
    let t22 = ((pool as usize) + mir_mul_usize(21, ty_sz)) as *mut AxType;
    let scratch_ty = ((pool as usize) + mir_mul_usize(22, ty_sz)) as *mut AxType;
    let fn_params = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;

    unsafe {
        *opt_typeid_at(fn_params, 0) = TypeId { v: 8u32 };
        ax_type_reset(mut_view(*scratch_ty), 0u8);

        (*t17).kind = TY_VIEW;
        (*t17).pointee = TypeId { v: 8u32 };

        (*t18).kind = TY_MUT_VIEW;
        (*t18).is_mut = true;
        (*t18).pointee = TypeId { v: 8u32 };

        (*t19).kind = TY_PTR;
        (*t19).is_mut = true;
        (*t19).pointee = TypeId { v: 8u32 };

        (*t20).kind = TY_ARRAY;
        (*t20).elem = TypeId { v: 8u32 };
        (*t20).array_len = 8u64;

        (*t21).kind = TY_FN;
        (*t21).param_types = fn_params;
        (*t21).param_count = 1;
        (*t21).ret_type = TypeId { v: 8u32 };

        (*t22).kind = LXF_TY_F64;

        (*thir_ptr).interner.arena = arena_new();
        (*thir_ptr).interner.map.keys = 0 as *mut *mut AxType;
        (*thir_ptr).interner.map.vals = 0 as *mut TypeId;
        (*thir_ptr).interner.map.states = 0 as *mut u8;
        (*thir_ptr).interner.map.len = 0;
        (*thir_ptr).interner.map.cap = 0;
        (*thir_ptr).interner.types = types_arr;
        (*thir_ptr).interner.len = 22;
        (*thir_ptr).interner.cap = 32;
        (*thir_ptr).interner.next_int_var = 1u32;
        (*thir_ptr).interner.scratch = scratch_ty;
        (*thir_ptr).interner.t_error.v = 1u32;
        (*thir_ptr).interner.t_unit.v = 2u32;
        (*thir_ptr).interner.t_never.v = 3u32;
        (*thir_ptr).interner.t_bool.v = 4u32;
        (*thir_ptr).interner.t_char.v = 5u32;
        (*thir_ptr).interner.t_i8.v = 6u32;
        (*thir_ptr).interner.t_i16.v = 7u32;
        (*thir_ptr).interner.t_i32.v = 8u32;
        (*thir_ptr).interner.t_i64.v = 9u32;
        (*thir_ptr).interner.t_isize.v = 10u32;
        (*thir_ptr).interner.t_u8.v = 11u32;
        (*thir_ptr).interner.t_u16.v = 12u32;
        (*thir_ptr).interner.t_u32.v = 13u32;
        (*thir_ptr).interner.t_u64.v = 14u32;
        (*thir_ptr).interner.t_usize.v = 15u32;
        (*thir_ptr).interner.t_str.v = 16u32;
        (*thir_ptr).interner.t_i128.v = 0x3FFF0128u32;
        (*thir_ptr).interner.t_u128.v = 0x3FFF0129u32;
        (*thir_ptr).item_types.keys = 0 as *mut usize;
        (*thir_ptr).item_types.vals = 0 as *mut TypeId;
        (*thir_ptr).item_types.states = 0 as *mut u8;
        (*thir_ptr).item_types.len = 0;
        (*thir_ptr).item_types.cap = 0;
        (*thir_ptr).expr_types.keys = 0 as *mut usize;
        (*thir_ptr).expr_types.vals = 0 as *mut TypeId;
        (*thir_ptr).expr_types.states = 0 as *mut u8;
        (*thir_ptr).expr_types.len = 0;
        (*thir_ptr).expr_types.cap = 0;
    }

    ProbeTypes {
        thir: thir_ptr,
        ty_i32: 8u32,
        ty_usize: 15u32,
        ty_bool: 4u32,
        ty_f64: 22u32,
        ty_arr8_i32: 20u32,
    }
}

fn pb_span() -> Span {
    Span { file: FileId { v: 1u32 }, start: 1u32, end: 10u32 }
}

fn pb_new_mir_body(arena: mut_view<Arena>, ret_ty: u32, arg_count: usize) -> *mut MirBody {
    let mb = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    unsafe {
        mir_body_reset(mut_view(*mb));
        (*mb).arg_count = arg_count;
    }
    let sp = pb_span();
    let _ = unsafe { mir_add_local(mut_view(*mb), mut_view(*arena), TypeId { v: ret_ty }, 0u8, true, StrId { v: 0u32 }, view(sp)) };
    mb
}

fn pb_add_local(mb: mut_view<MirBody>, arena: mut_view<Arena>, ty: u32, is_arg: bool) -> u32 {
    let sp = pb_span();
    let kind: u8 = if is_arg { MIR_LOCAL_ARG } else { 0u8 };
    mir_add_local(mut_view(*mb), mut_view(*arena), TypeId { v: ty }, kind, true, StrId { v: 0u32 }, view(sp)).v
}

fn pb_add_bb(mb: mut_view<MirBody>, arena: mut_view<Arena>) -> u32 {
    mir_add_bb(mut_view(*mb), mut_view(*arena), false).v
}

fn pb_op_const(ty: u32, val: u64) -> MirOperand {
    mir_op_const_int(ty, val)
}

fn pb_op_copy(loc: u32) -> MirOperand {
    mir_op_copy_local(loc)
}

fn pb_place_index(arena: mut_view<Arena>, base: u32, idx_loc: u32) -> MirPlace {
    let parr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(parr, 0) };
    unsafe {
        mir_proj_reset(mut_view(*p0), MIR_PROJ_INDEX);
        (*p0).index_local = MirLocalId { v: idx_loc };
    }
    let mut pl = mir_local_place(base);
    pl.projs = parr;
    pl.proj_count = 1;
    pl
}

fn pb_blank_stmt(arena: mut_view<Arena>) -> MirStmt {
    let mut st: MirStmt = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
    mir_stmt_zero(mut_view(st), MIR_STMT_ASSIGN);
    st.span = pb_span();
    st.location = pb_span();
    st
}

fn pb_push_const(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, ty: u32, val: u64) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = pb_op_const(ty, val);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_copy(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, src: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = pb_op_copy(src);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_binop(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, op: u8, lhs: MirOperand, rhs: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_BINARY_OP);
    st.rvalue.bin_op = op;
    st.rvalue.lhs = lhs;
    st.rvalue.rhs = rhs;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_load_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, base: u32, idx_loc: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_COPY;
    st.rvalue.use_op.place = pb_place_index(mut_view(*arena), base, idx_loc);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_store_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, base: u32, idx_loc: u32, src_op: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = pb_place_index(mut_view(*arena), base, idx_loc);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = src_op;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_len(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, container: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_LEN);
    st.rvalue.place = mir_local_place(container);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_set_goto(mb: mut_view<MirBody>, bb: u32, target: u32) {
    let sp = pb_span();
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_GOTO, view(sp));
        (*bptr).terminator.goto_target = MirBbId { v: target };
        (*bptr).has_terminator = true;
    }
}

fn pb_set_return(mb: mut_view<MirBody>, bb: u32) {
    let sp = pb_span();
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_RETURN, view(sp));
        (*bptr).has_terminator = true;
    }
}

fn pb_set_branch(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, cond_loc: u32, true_bb: u32, false_bb: u32) {
    let sp = pb_span();
    let svals = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
    let stgts = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        *svals = 0u64;
        *stgts = MirBbId { v: false_bb };
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_SWITCH_INT, view(sp));
        (*bptr).terminator.discr = pb_op_copy(cond_loc);
        (*bptr).terminator.values = svals;
        (*bptr).terminator.targets = stgts;
        (*bptr).terminator.switch_count = 1;
        (*bptr).terminator.otherwise = MirBbId { v: true_bb };
        (*bptr).has_terminator = true;
    }
}

fn pb_set_assert(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, cond_loc: u32, expected: bool, ok_bb: u32) {
    let sp = pb_span();
    let unw_bb = mir_add_bb(mut_view(*mb), mut_view(*arena), true);
    let uptr = unsafe { mir_bb_at(mb.bbs, unw_bb.v as usize) };
    unsafe {
        mir_term_reset(mut_view((*uptr).terminator), MIR_TERM_UNREACHABLE, view(sp));
        (*uptr).has_terminator = true;
    }
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_ASSERT, view(sp));
        (*bptr).terminator.cond = pb_op_copy(cond_loc);
        (*bptr).terminator.expected = expected;
        (*bptr).terminator.assert_target = MirBbId { v: ok_bb };
        (*bptr).terminator.assert_unwind = unw_bb;
        (*bptr).has_terminator = true;
    }
}

fn pb_prepare_opt_body(
    mb: view<MirBody>,
    pt: view<ProbeTypes>,
    profile: u8,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    out_pm: mut_view<*mut PassManager>,
    out_alias: mut_view<*const AliasInfo>
) -> *mut OptBody {
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let db = dummy_fn as *mut u8;
    let mut z: usize = 0;
    while z < size_of<HirItem>() {
        unsafe { *opt_u8_at(db, z) = 0u8; }
        z = z + 1;
    }
    let obody = optir_build_from_mir(mb, pt.thir as *const Thir, mut_view(*arena), mut_view(*sink), dummy_fn as *const HirItem);
    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, true);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));

    let alias_ptr = alias_build_info(unsafe { view(*obody) }, 0 as *const EffectCallTable, mut_view(*arena)) as *const AliasInfo;
    let mut simp_stats = LoopSimplifyStats {
        pass_runs: 0u32,
        pass_changes: 0u32,
        pass_rollbacks: 0u32,
        loops_discovered: 0u32,
        irreducible_cycles: 0u32,
        preheaders_inserted: 0u32,
        latches_merged: 0u32,
        dedicated_exits_inserted: 0u32,
        lcssa_phis_inserted: 0u32,
    };
    loops_stats_zero(mut_view(simp_stats));
    let _ = opt_loop_simplify(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(simp_stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    *out_pm = pm_ptr;
    *out_alias = alias_build_info(unsafe { view(*obody) }, 0 as *const EffectCallTable, mut_view(*arena)) as *const AliasInfo;
    obody
}

fn pb_zero_stats() -> LoopXformStats {
    let mut stats = LoopXformStats {
        pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32,
        licm_hoisted_scalars: 0u32, licm_hoisted_loads: 0u32, licm_hoisted_guards: 0u32,
        licm_blocked_traps: 0u32, licm_blocked_clobbers: 0u32, licm_blocked_barriers: 0u32,
        iv_strength_reduced: 0u32, iv_addr_evolutions: 0u32, iv_blocked_overflow: 0u32,
        loops_peeled: 0u32, loops_unswitched: 0u32, loops_unrolled_full: 0u32,
        loops_unrolled_partial: 0u32, loops_versioned: 0u32, loops_fused: 0u32,
        iter_buffers_forwarded: 0u32, fusion_blocked_dep: 0u32, fusion_blocked_barriers: 0u32,
        bce_eliminated_after_xform: 0u32, records: 0 as *mut LoopXformRecord,
        record_count: 0, record_cap: 0,
    };
    loop_xform_stats_zero(mut_view(stats));
    stats
}

fn test_case1a_licm_pos_and_guards(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 3);
    let arg_a = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, true);
    let arg_b = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, true);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_inv1 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_inv2 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_len = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_g = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_g, MIR_BINOP_EQ, pb_op_copy(arg_a), pb_op_copy(arg_b));
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 4u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb4);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_inv1, MIR_BINOP_WRAPPING_ADD, pb_op_copy(arg_a), pb_op_copy(arg_b));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_inv2, MIR_BINOP_WRAPPING_MUL, pb_op_copy(loc_inv1), pb_op_const(pt.ty_i32, 3u64));
    pb_push_len(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_len, arg_arr);
    pb_set_assert(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_g, true, bb3);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_copy(loc_inv2));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb4);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed = opt_licm(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    changed && stats.pass_rollbacks == 0u32 &&
        stats.licm_hoisted_scalars >= 2u32 &&
        stats.licm_hoisted_loads >= 1u32 &&
        stats.licm_hoisted_guards >= 1u32
}

fn test_case1b_licm_neg_gates(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 3);
    let arg_n = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, true);
    let arg_d = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, true);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_z = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_div = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_clob = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_vol = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_g = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_z, pt.ty_usize, 0u64);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_g, MIR_BINOP_EQ, pb_op_copy(arg_d), pb_op_const(pt.ty_i32, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_copy(arg_n));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb4);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_div, MIR_BINOP_DIV, pb_op_const(pt.ty_i32, 100u64), pb_op_copy(arg_d));
    pb_push_store_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, arg_arr, loc_i, pb_op_const(pt.ty_i32, 9u64));
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_clob, arg_arr, loc_z);
    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_vol, arg_d);
    pb_set_assert(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_g, true, bb3);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb1);

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, 0u32, pt.ty_i32, 0u64);
    pb_set_return(unsafe { mut_view(*mb) }, bb4);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let b2_opt = unsafe { opt_block_at((*obody).blocks, bb2 as usize) };
    let vol_inst = unsafe { opt_inst_at((*b2_opt).insts, 3) };
    unsafe {
        (*vol_inst).opcode = OPT_INST_VOLATILE_LOAD;
        (*vol_inst).flags = OPT_FLAG_BARRIER;
    }

    let mut stats = pb_zero_stats();
    let changed = opt_licm(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    !changed &&
        stats.licm_hoisted_scalars == 0u32 &&
        stats.licm_hoisted_loads == 0u32 &&
        stats.licm_hoisted_guards == 0u32 &&
        stats.licm_blocked_traps >= 2u32 &&
        stats.licm_blocked_clobbers >= 1u32 &&
        stats.licm_blocked_barriers >= 1u32
}

fn test_case2_iv_sr_and_overflow_gate(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_mul_ok = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_mul_wrap = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_elem = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb3);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_mul_ok, MIR_BINOP_MUL, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 4u64));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_mul_wrap, MIR_BINOP_WRAPPING_MUL, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 6u64));
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_elem, arg_arr, loc_i);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb2, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, 0u32, loc_elem);
    pb_set_return(unsafe { mut_view(*mb) }, bb3);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed_pos = opt_iv_strength_reduce(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let sr_cnt = stats.iv_strength_reduced;
    let addr_cnt = stats.iv_addr_evolutions;
    if !changed_pos || sr_cnt < 2u32 || addr_cnt < 1u32 {
        return false;
    }

    let mb_neg = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let ni = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_i32, false);
    let ncnd = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_bool, false);
    let nbad = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_i32, false);
    let nbb0 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let nbb1 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let nbb2 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let nbb3 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb0, ni, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_neg) }, nbb0, nbb1);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb1, ncnd, MIR_BINOP_LT, pb_op_copy(ni), pb_op_const(pt.ty_i32, 4u64));
    pb_set_branch(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb1, ncnd, nbb2, nbb3);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb2, nbad, MIR_BINOP_MUL, pb_op_copy(ni), pb_op_const(pt.ty_i32, 1000000000u64));
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb2, ni, MIR_BINOP_ADD, pb_op_copy(ni), pb_op_const(pt.ty_i32, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_neg) }, nbb2, nbb1);
    pb_push_copy(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb3, 0u32, nbad);
    pb_set_return(unsafe { mut_view(*mb_neg) }, nbb3);

    let mut npm = 0 as *mut PassManager;
    let mut nalias = 0 as *const AliasInfo;
    let nob = pb_prepare_opt_body(unsafe { view(*mb_neg) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(npm), mut_view(nalias));
    let ntree = loops_discover(unsafe { view(*nob) }, 0 as *const EffectCallTable, nalias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*ntree) }, unsafe { view(*nob) }, nalias, mut_view(*arena));
    let nlp = unsafe { loop_desc_at((*ntree).loops, 0) };
    let mut saw_valid_iv_mode = false;
    let mut k_iv: usize = 0;
    while k_iv < (unsafe { (*nlp).iv_count }) {
        let ivp = unsafe { loop_iv_at((*nlp).ivs, k_iv) };
        if (unsafe { (*ivp).arith_mode }) == ARITH_PROVEN_NSW_NUW || (unsafe { (*ivp).arith_mode }) == ARITH_CHECKED {
            saw_valid_iv_mode = true;
        }
        k_iv = k_iv + 1;
    }
    let mut nstats = pb_zero_stats();
    let changed_neg = opt_iv_strength_reduce(
        unsafe { mut_view(*npm) },
        unsafe { mut_view(*nob) },
        0 as *const EffectCallTable,
        nalias,
        mut_view(nstats),
        mut_view(*arena),
        mut_view(*sink)
    );
    saw_valid_iv_mode && !changed_neg && nstats.iv_strength_reduced == 0u32 && nstats.iv_blocked_overflow >= 1u32
}

fn test_case3_loop_peel(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_is0 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_im1 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb5 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb6 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 6u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb6);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_is0, MIR_BINOP_EQ, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 0u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_is0, bb3, bb4);

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_acc, pt.ty_i32, 10u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb5);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_im1, MIR_BINOP_SUB, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_acc, arg_arr, loc_im1);
    pb_set_goto(unsafe { mut_view(*mb) }, bb4, bb5);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb5, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb6, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb6);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed = opt_loop_peel(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    changed && stats.pass_rollbacks == 0u32 && stats.loops_peeled == 1u32
}

fn test_case4_loop_unswitch(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_flag = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb5 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb6 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb6);

    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, arg_flag, bb3, bb4);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_const(pt.ty_i32, 5u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb5);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_const(pt.ty_i32, 2u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb4, bb5);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb5, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb6, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb6);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed = opt_loop_unswitch(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let post_tree = loops_discover(unsafe { view(*obody) }, 0 as *const EffectCallTable, alias_ptr, mut_view(*arena));
    changed && stats.pass_rollbacks == 0u32 && stats.loops_unswitched == 1u32 &&
        (unsafe { (*post_tree).loop_count }) == 2
}

fn test_case5_loop_unroll(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb_full = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let fi = pb_add_local(unsafe { mut_view(*mb_full) }, mut_view(*arena), pt.ty_usize, false);
    let fcnd = pb_add_local(unsafe { mut_view(*mb_full) }, mut_view(*arena), pt.ty_bool, false);
    let facc = pb_add_local(unsafe { mut_view(*mb_full) }, mut_view(*arena), pt.ty_i32, false);
    let fbb0 = pb_add_bb(unsafe { mut_view(*mb_full) }, mut_view(*arena));
    let fbb1 = pb_add_bb(unsafe { mut_view(*mb_full) }, mut_view(*arena));
    let fbb2 = pb_add_bb(unsafe { mut_view(*mb_full) }, mut_view(*arena));
    let fbb3 = pb_add_bb(unsafe { mut_view(*mb_full) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb0, fi, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb0, facc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_full) }, fbb0, fbb1);
    pb_push_binop(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb1, fcnd, MIR_BINOP_LT, pb_op_copy(fi), pb_op_const(pt.ty_usize, 4u64));
    pb_set_branch(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb1, fcnd, fbb2, fbb3);
    pb_push_binop(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb2, facc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(facc), pb_op_const(pt.ty_i32, 7u64));
    pb_push_binop(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb2, fi, MIR_BINOP_ADD, pb_op_copy(fi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_full) }, fbb2, fbb1);
    pb_push_copy(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb3, 0u32, facc);
    pb_set_return(unsafe { mut_view(*mb_full) }, fbb3);

    let mut fpm = 0 as *mut PassManager;
    let mut falias = 0 as *const AliasInfo;
    let fob = pb_prepare_opt_body(unsafe { view(*mb_full) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(fpm), mut_view(falias));
    let mut fstats = pb_zero_stats();
    let c_full = opt_loop_unroll(
        unsafe { mut_view(*fpm) },
        unsafe { mut_view(*fob) },
        0 as *const EffectCallTable,
        falias,
        mut_view(fstats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let ftree_after = loops_discover(unsafe { view(*fob) }, 0 as *const EffectCallTable, falias, mut_view(*arena));
    if !c_full || fstats.loops_unrolled_full != 1u32 || (unsafe { (*ftree_after).loop_count }) != 0 {
        return false;
    }

    let mb_part = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let pi = pb_add_local(unsafe { mut_view(*mb_part) }, mut_view(*arena), pt.ty_usize, false);
    let pcnd = pb_add_local(unsafe { mut_view(*mb_part) }, mut_view(*arena), pt.ty_bool, false);
    let pacc = pb_add_local(unsafe { mut_view(*mb_part) }, mut_view(*arena), pt.ty_i32, false);
    let pbb0 = pb_add_bb(unsafe { mut_view(*mb_part) }, mut_view(*arena));
    let pbb1 = pb_add_bb(unsafe { mut_view(*mb_part) }, mut_view(*arena));
    let pbb2 = pb_add_bb(unsafe { mut_view(*mb_part) }, mut_view(*arena));
    let pbb3 = pb_add_bb(unsafe { mut_view(*mb_part) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb0, pi, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb0, pacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_part) }, pbb0, pbb1);
    pb_push_binop(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb1, pcnd, MIR_BINOP_LT, pb_op_copy(pi), pb_op_const(pt.ty_usize, 32u64));
    pb_set_branch(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb1, pcnd, pbb2, pbb3);
    pb_push_binop(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb2, pacc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(pacc), pb_op_const(pt.ty_i32, 3u64));
    pb_push_binop(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb2, pi, MIR_BINOP_ADD, pb_op_copy(pi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_part) }, pbb2, pbb1);
    pb_push_copy(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb3, 0u32, pacc);
    pb_set_return(unsafe { mut_view(*mb_part) }, pbb3);

    let mut ppm = 0 as *mut PassManager;
    let mut palias = 0 as *const AliasInfo;
    let pob = pb_prepare_opt_body(unsafe { view(*mb_part) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(ppm), mut_view(palias));
    let mut pstats = pb_zero_stats();
    let c_part = opt_loop_unroll(
        unsafe { mut_view(*ppm) },
        unsafe { mut_view(*pob) },
        0 as *const EffectCallTable,
        palias,
        mut_view(pstats),
        mut_view(*arena),
        mut_view(*sink)
    );
    c_part && pstats.loops_unrolled_partial == 1u32
}

fn test_case6_loop_version(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 2);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let arg_n = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_len = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_inb = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_elem = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_copy(arg_n));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb4);

    pb_push_len(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_len, arg_arr);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_inb, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_copy(loc_len));
    pb_set_assert(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_inb, true, bb3);

    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_elem, arg_arr, loc_i);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_copy(loc_elem));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb4);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed = opt_loop_version(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let post_tree = loops_discover(unsafe { view(*obody) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(*arena));
    changed && stats.pass_rollbacks == 0u32 &&
        stats.loops_versioned == 1u32 &&
        stats.bce_eliminated_after_xform == 1u32 &&
        (unsafe { (*post_tree).loop_count }) == 2
}

fn test_case7_loop_fuse_and_iter_forward(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_src = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_tmp = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, false);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_j = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_c1 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_c2 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_v = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_x = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb5 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb6 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_c1, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_c1, bb2, bb3);
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_v, arg_src, loc_i);
    pb_push_store_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_tmp, loc_i, pb_op_copy(loc_v));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb2, bb1);

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_j, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb4);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_c2, MIR_BINOP_LT, pb_op_copy(loc_j), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_c2, bb5, bb6);
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_x, loc_tmp, loc_j);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_copy(loc_x));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_j, MIR_BINOP_ADD, pb_op_copy(loc_j), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb5, bb4);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb6, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb6);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let c_fuse = opt_loop_fuse(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let post_tree = loops_discover(unsafe { view(*obody) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(*arena));
    if !c_fuse || stats.loops_fused != 1u32 || stats.iter_buffers_forwarded != 1u32 ||
       (unsafe { (*post_tree).loop_count }) != 1 {
        return false;
    }

    let mb_neg = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let n_arr = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let ni = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_usize, false);
    let nj = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_usize, false);
    let njp1 = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_usize, false);
    let nc1 = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_bool, false);
    let nc2 = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_bool, false);
    let nx = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_i32, false);

    let n0 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n1 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n2 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n3 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n4 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n5 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n6 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n0, ni, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_neg) }, n0, n1);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n1, nc1, MIR_BINOP_LT, pb_op_copy(ni), pb_op_const(pt.ty_usize, 6u64));
    pb_set_branch(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n1, nc1, n2, n3);
    pb_push_store_idx(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n2, n_arr, ni, pb_op_const(pt.ty_i32, 42u64));
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n2, ni, MIR_BINOP_ADD, pb_op_copy(ni), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_neg) }, n2, n1);

    pb_push_const(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n3, nj, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_neg) }, n3, n4);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n4, nc2, MIR_BINOP_LT, pb_op_copy(nj), pb_op_const(pt.ty_usize, 6u64));
    pb_set_branch(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n4, nc2, n5, n6);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n5, njp1, MIR_BINOP_ADD, pb_op_copy(nj), pb_op_const(pt.ty_usize, 1u64));
    pb_push_load_idx(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n5, nx, n_arr, njp1);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n5, nj, MIR_BINOP_ADD, pb_op_copy(nj), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_neg) }, n5, n4);
    pb_push_copy(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n6, 0u32, nx);
    pb_set_return(unsafe { mut_view(*mb_neg) }, n6);

    let mut npm = 0 as *mut PassManager;
    let mut nalias = 0 as *const AliasInfo;
    let nob = pb_prepare_opt_body(unsafe { view(*mb_neg) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(npm), mut_view(nalias));
    let mut nstats = pb_zero_stats();
    let c_neg = opt_loop_fuse(
        unsafe { mut_view(*npm) },
        unsafe { mut_view(*nob) },
        0 as *const EffectCallTable,
        nalias,
        mut_view(nstats),
        mut_view(*arena),
        mut_view(*sink)
    );
    !c_neg && nstats.loops_fused == 0u32 && nstats.fusion_blocked_dep == 1u32
}

fn test_case8_reduction_legality_and_print(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let c_licm = licm_contract();
    let c_sr = iv_strength_reduce_contract();
    let c_unsw = loop_unswitch_contract();
    let c_pu = loop_peel_unroll_contract();
    let c_ver = loop_version_contract();
    let c_fuse = loop_fuse_contract();
    if c_licm.pass_id != PASS_LICM || c_sr.pass_id != PASS_IV_STRENGTH_REDUCE ||
       c_unsw.pass_id != PASS_LOOP_UNSWITCH || c_pu.pass_id != PASS_LOOP_PEEL_UNROLL ||
       c_ver.pass_id != PASS_LOOP_VERSION || c_fuse.pass_id != PASS_LOOP_FUSE {
        return false;
    }

    let b_o0 = loop_cost_budget_for_profile(OPT_PROFILE_DEBUG_O0);
    let b_os = loop_cost_budget_for_profile(OPT_PROFILE_SIZE_OS);
    let b_o1 = loop_cost_budget_for_profile(OPT_PROFILE_BALANCED_O1);
    let b_o2 = loop_cost_budget_for_profile(OPT_PROFILE_SPEED_O2);
    if b_o0.allow_licm || !b_os.allow_licm || b_os.allow_full_unroll ||
       !b_o1.allow_full_unroll || b_o1.allow_partial_unroll || !b_o2.allow_partial_unroll || !b_o2.allow_versioning {
        return false;
    }

    let mb_int = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let ii = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_usize, false);
    let icnd = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_bool, false);
    let iacc = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_i32, false);
    let ib0 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib1 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib2 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib3 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib0, ii, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib0, iacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_int) }, ib0, ib1);
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib1, icnd, MIR_BINOP_LT, pb_op_copy(ii), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib1, icnd, ib2, ib3);
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib2, iacc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(iacc), pb_op_const(pt.ty_i32, 3u64));
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib2, ii, MIR_BINOP_ADD, pb_op_copy(ii), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_int) }, ib2, ib1);
    pb_push_copy(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib3, 0u32, iacc);
    pb_set_return(unsafe { mut_view(*mb_int) }, ib3);

    let mut ipm = 0 as *mut PassManager;
    let mut ialias = 0 as *const AliasInfo;
    let iob = pb_prepare_opt_body(unsafe { view(*mb_int) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(ipm), mut_view(ialias));
    let itree = loops_discover(unsafe { view(*iob) }, 0 as *const EffectCallTable, ialias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*itree) }, unsafe { view(*iob) }, ialias, mut_view(*arena));
    let ilp = unsafe { loop_desc_at((*itree).loops, 0) };
    let ired = loop_xform_recognize_reduction(unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias);
    if !ired.valid || !ired.reassoc_legal || ired.is_float {
        return false;
    }
    if !loop_xform_can_distribute(unsafe { view(*itree) }, unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias, mut_view(*arena)) ||
       !loop_xform_can_vectorize_or_parallelize(unsafe { view(*itree) }, unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias, mut_view(*arena)) {
        return false;
    }

    let mb_flt = pb_new_mir_body(mut_view(*arena), pt.ty_f64, 1);
    let fstep = pb_add_local(unsafe { mut_view(*mb_flt) }, mut_view(*arena), pt.ty_f64, true);
    let fi = pb_add_local(unsafe { mut_view(*mb_flt) }, mut_view(*arena), pt.ty_usize, false);
    let fcnd = pb_add_local(unsafe { mut_view(*mb_flt) }, mut_view(*arena), pt.ty_bool, false);
    let facc = pb_add_local(unsafe { mut_view(*mb_flt) }, mut_view(*arena), pt.ty_f64, false);
    let fb0 = pb_add_bb(unsafe { mut_view(*mb_flt) }, mut_view(*arena));
    let fb1 = pb_add_bb(unsafe { mut_view(*mb_flt) }, mut_view(*arena));
    let fb2 = pb_add_bb(unsafe { mut_view(*mb_flt) }, mut_view(*arena));
    let fb3 = pb_add_bb(unsafe { mut_view(*mb_flt) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb0, fi, pt.ty_usize, 0u64);
    pb_push_copy(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb0, facc, fstep);
    pb_set_goto(unsafe { mut_view(*mb_flt) }, fb0, fb1);
    pb_push_binop(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb1, fcnd, MIR_BINOP_LT, pb_op_copy(fi), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb1, fcnd, fb2, fb3);
    pb_push_binop(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb2, facc, MIR_BINOP_ADD, pb_op_copy(facc), pb_op_copy(fstep));
    pb_push_binop(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb2, fi, MIR_BINOP_ADD, pb_op_copy(fi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_flt) }, fb2, fb1);
    pb_push_copy(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb3, 0u32, facc);
    pb_set_return(unsafe { mut_view(*mb_flt) }, fb3);

    let mut fpm = 0 as *mut PassManager;
    let mut falias = 0 as *const AliasInfo;
    let fob = pb_prepare_opt_body(unsafe { view(*mb_flt) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(fpm), mut_view(falias));
    let ftree = loops_discover(unsafe { view(*fob) }, 0 as *const EffectCallTable, falias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*ftree) }, unsafe { view(*fob) }, falias, mut_view(*arena));
    let flp = unsafe { loop_desc_at((*ftree).loops, 0) };
    let fred = loop_xform_recognize_reduction(unsafe { view(*flp) }, unsafe { view(*fob) }, falias);
    if !fred.valid || fred.reassoc_legal || !fred.is_float {
        return false;
    }

    let mut stats = pb_zero_stats();
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let db = dummy_fn as *mut u8;
    let mut z: usize = 0;
    while z < size_of<HirItem>() {
        unsafe { *opt_u8_at(db, z) = 0u8; }
        z = z + 1;
    }
    let ok_e2e = loop_xform_optimize_mir_body(
        unsafe { mut_view(*mb_int) },
        pt.thir as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink),
        dummy_fn as *const HirItem
    );
    if !ok_e2e || stats.loops_unrolled_full != 1u32 {
        return false;
    }

    let mut dbuf1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut dbuf2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dbuf1));
    diag_buf_init(mut_view(dbuf2));
    loop_xform_print(view(stats), mut_view(dbuf1));
    loop_xform_print(view(stats), mut_view(dbuf2));
    let lprint_ok = dbuf1.len > 120 &&
        (unsafe { *(dbuf1.ptr) }) == 108u8 &&
        (unsafe { *opt_u8_at(dbuf1.ptr, 1) }) == 111u8 &&
        diag_buf_eq(view(dbuf1), view(dbuf2));
    diag_buf_free(mut_view(dbuf1));
    diag_buf_free(mut_view(dbuf2));
    lprint_ok
}

fn probe_loop_xform_all() -> i32 {
    let mut arena = arena_with_chunk_size(4194304);
    let _ = arena_alloc_raw(mut_view(arena), 16, 8);
    let sink_ptr = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }
    let pt = pb_init_types(mut_view(arena));

    if !test_case1a_licm_pos_and_guards(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 501;
    }
    print("CASE1_LICM_POS_AND_GUARDS: OK\n");

    if !test_case1b_licm_neg_gates(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 502;
    }
    print("CASE1B_LICM_NEG_TRAP_CLOBBER_BARRIER: OK\n");

    if !test_case2_iv_sr_and_overflow_gate(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 503;
    }
    print("CASE2_IV_SR_AND_OVERFLOW_GATE: OK\n");

    if !test_case3_loop_peel(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 504;
    }
    print("CASE3_LOOP_PEEL_FIRST_ITER: OK\n");

    if !test_case4_loop_unswitch(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 505;
    }
    print("CASE4_LOOP_UNSWITCH_INVARIANT: OK\n");

    if !test_case5_loop_unroll(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 506;
    }
    print("CASE5_LOOP_UNROLL_FULL_AND_PARTIAL: OK\n");

    if !test_case6_loop_version(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 507;
    }
    print("CASE6_LOOP_VERSION_FAST_AND_FALLBACK: OK\n");

    if !test_case7_loop_fuse_and_iter_forward(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 508;
    }
    print("CASE7_LOOP_FUSE_AND_ITER_FORWARD: OK\n");

    if !test_case8_reduction_legality_and_print(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        return 509;
    }
    print("CASE8_REDUCTION_LEGALITY_AND_PRINT: OK\n");

    probe_free_synth_thir(pt.thir);
    unsafe { diag_sink_free(mut_view(*sink_ptr)); }
    arena_destroy(mut_view(arena));
    0
}

pub fn main() -> i32 {
    let rc1 = probe_loop_discovery_and_simplify();
    if rc1 != 0 {
        return rc1;
    }
    print("PROBE_LOOP_DISCOVERY_AND_SIMPLIFY=OK\n");

    let rc2 = probe_scev_invariance_and_dependence();
    if rc2 != 0 {
        return rc2;
    }
    print("PROBE_SCEV_INVARIANCE_AND_DEPENDENCE=OK\n");

    let rc3 = probe_frontend_lowered_bce_positive();
    if rc3 != 0 {
        return rc3;
    }
    print("PROBE_FRONTEND_LOWERED_BCE_POSITIVE=OK\n");

    let rc4 = probe_frontend_lowered_bce_negative();
    if rc4 != 0 {
        return rc4;
    }
    print("PROBE_FRONTEND_LOWERED_BCE_NEGATIVE=OK\n");

    let rc5 = probe_loop_xform_all();
    if rc5 != 0 {
        return rc5;
    }
    print("PROBE_LOOP_XFORM_ALL=OK\n");

    print("E15.3-PROBE: ALL-OK\n");
    0
}
