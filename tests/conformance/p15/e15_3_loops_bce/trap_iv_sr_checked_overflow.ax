// test: diff
// exit: 101
// stdout: 0\n1000000000\n2000000000\n

// Checked `i32` multiplication by induction variable (`i * 1000000000`) overflows on iteration `i == 3`.
// IV strength reduction must NOT replace checked multiply with wrapping addition (`AXS-LOOP-006`, `REQ-OPT-182`).
fn run_checked_iv_mul(n: i32) -> i32 {
    let mut i: i32 = 0;
    let mut last: i32 = 0;
    while i < n {
        let prod: i32 = i * 1000000000;
        print_int(prod);
        print("\n");
        last = prod;
        i = i + 1;
    }
    last
}

fn main() -> i32 {
    let _ = run_checked_iv_mul(4);
    0
}
