// test: ui

struct OwnedBuffer {
    tag: i64,
}

fn consume_owned(b: OwnedBuffer) -> i64 {
    b.tag
}

fn main() {
    let buf = OwnedBuffer { tag: 99 };
    let move_closure = || -> i64 {
        consume_owned(buf)
    };
    let illegal_second_use = buf; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    let _ = move_closure();
    let _ = illegal_second_use;
}
