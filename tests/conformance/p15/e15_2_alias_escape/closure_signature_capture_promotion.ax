// test: diff
// flags: --verify-each
// stdout: Xin chào E15.2 closure_signature_capture_promotion\nnoncap_and_copy=380\nview_capture=294\nmut_view_capture=515\nmove_capture=427\nchecksum=1616\n

fn emit_metric(label: str, val: i64) {
    print(label);
    print_int(val as i32);
    print("\n");
}

struct SensorConfig {
    gain: i64,
    offset: i64,
    threshold: i64,
}

struct OwnedToken {
    id: i64,
    weight: i64,
}

fn invoke_fn_twice<F: Fn>(f: F, a: i64, b: i64) -> i64 {
    f(a) + f(b)
}

fn invoke_fn_mut_three<F: FnMut>(mut f: F, s1: i64, s2: i64, s3: i64) -> i64 {
    let r1 = f(s1);
    let r2 = f(s2);
    let r3 = f(s3);
    r1 + r2 + r3
}

fn consume_token(tok: OwnedToken, bonus: i64) -> i64 {
    tok.id * 3 + tok.weight + bonus
}

fn kernel_noncap_and_copy_closures(base: i64) -> i64 {
    // Explicit parameter and return type signatures (REQ-OPT-385)
    let linear = |x: i64, slope: i64| -> i64 {
        x * slope + 12
    };
    let d1 = linear(15, 4); // 72
    let d2 = linear(20, 3); // 72

    // Copy capture (CAP_COPY) of scalar locals
    let k_scale: i64 = base + 5; // 25
    let k_bias: i64 = 18;
    let scale_add = |v: i64| -> i64 {
        v * k_scale + k_bias
    };
    // Direct calls + generic Fn trait dispatch; original k_scale & k_bias remain accessible
    let c_direct = scale_add(4); // 118
    let c_trait = invoke_fn_twice(scale_add, 1, 2); // (25+18) + (50+18) = 43 + 68 = 111
    d1 + d2 + c_direct + c_trait + k_scale - 18
}

fn kernel_view_capture_non_copy(seed: i64) -> i64 {
    let cfg = SensorConfig {
        gain: seed,
        offset: 34,
        threshold: 100,
    };
    // Read-only view capture (CAP_VIEW) of non-Copy aggregate
    let eval_sensor = |sample: i64| -> i64 {
        let raw = sample * cfg.gain + cfg.offset;
        if raw > cfg.threshold {
            raw - 10
        } else {
            raw + 5
        }
    };
    let s1 = eval_sensor(8);  // 8*12 + 34 = 130 > 100 -> 120
    let s2 = eval_sensor(5);  // 5*12 + 34 = 94 <= 100 -> 99
    // Owner read remains legal alongside shared CAP_VIEW capture (REQ-OPT-386)
    s1 + s2 + cfg.gain + cfg.offset + 29
}

fn kernel_mut_view_capture_sequential(init_acc: i64) -> i64 {
    let mut acc: i64 = init_acc;
    let mut step_count: i64 = 0;

    // Exclusive mut_view capture (CAP_MUT_VIEW) in Phase 1
    {
        let mut accumulate = |delta: i64| -> i64 {
            acc = acc + delta * 2;
            step_count = step_count + 1;
            acc + step_count
        };
        let p1 = accumulate(10); // acc=50, step=1 -> 51
        let p2 = accumulate(15); // acc=80, step=2 -> 82
        let p3 = accumulate(20); // acc=120, step=3 -> 123
        acc = acc + (p1 + p2 + p3) - 256; // acc = 120 + 256 - 256 = 120
    }

    // After Phase 1 closure ends its lifetime, owner can be read and re-captured mutably in Phase 2
    let mid_snapshot: i64 = acc + step_count; // 123
    let mut phase2 = |mult: i64| -> i64 {
        acc = acc + mult * 5;
        acc
    };
    let t_sum = invoke_fn_mut_three(phase2, 2, 3, 4);
    mid_snapshot + t_sum - 48
}

fn kernel_move_capture_owned(id: i64, weight: i64) -> i64 {
    let tok1 = OwnedToken { id: id, weight: weight };
    let tok2 = OwnedToken { id: id + 7, weight: weight + 13 };
    let bonus: i64 = 25;

    // By-value CAP_MOVE capture of non-Copy OwnedToken
    let consume_first = || -> i64 {
        consume_token(tok1, bonus)
    };
    let consume_second = || -> i64 {
        consume_token(tok2, bonus + 10)
    };
    consume_first() + consume_second()
}

fn main() -> i32 {
    print("Xin chào E15.2 closure_signature_capture_promotion\n");

    let m1 = kernel_noncap_and_copy_closures(20);
    emit_metric("noncap_and_copy=", m1);
    if m1 != 380 { return 1; }

    let m2 = kernel_view_capture_non_copy(12);
    emit_metric("view_capture=", m2);
    if m2 != 294 { return 2; }

    let m3 = kernel_mut_view_capture_sequential(30);
    emit_metric("mut_view_capture=", m3);
    if m3 != 515 { return 3; }

    let m4 = kernel_move_capture_owned(40, 50);
    let m4_adj = m4 - 7;
    emit_metric("move_capture=", m4_adj);
    if m4_adj != 427 { return 4; }

    let total = m1 + m2 + m3 + m4_adj;
    emit_metric("checksum=", total);
    if total != 1616 { return 5; }
    0
}
