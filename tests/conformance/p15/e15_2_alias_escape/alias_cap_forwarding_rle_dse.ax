// test: diff
// flags: --verify-each
// stdout: Xin chào E15.2 alias_cap_forwarding_rle_dse\nmut_forward_rle=245\nfield_const_dyn=605\nseq_reborrow=173\nloop_backedge=385\nraw_ptr_alias=910\nchecksum=2318\n

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct TelemetryFrame {
    hdr: i64,
    payload: i64,
    crc: i64,
    flags: i64,
}

fn emit_metric(label: str, val: i64) {
    print(label);
    print_int(val as i32);
    print("\n");
}

fn kernel_mut_forward_and_view_rle(
    a: mut_view<i64>,
    b: mut_view<i64>,
    ro: view<i64>,
    seed: i64
) -> i64 {
    // Dead stores to local_dead (NoEscape, never read)
    let mut local_dead: i64 = seed + 999;
    local_dead = local_dead * 3;
    let _ = local_dead;

    // Overwritten store to *a followed by live store
    *a = seed + 100;
    let r0: i64 = *ro;
    *b = r0 + 15;
    *a = seed + 30;

    // Store-to-load forwarding on *a and *b, plus RLE on *ro across disjoint writes
    let a_val: i64 = *a;
    let b_val: i64 = *b;
    let r1: i64 = *ro;
    a_val + b_val + r0 + r1
}

fn kernel_field_const_and_dyn_index(dyn_idx: usize, delta: i64) -> i64 {
    let mut frame = TelemetryFrame {
        hdr: 10,
        payload: 20,
        crc: 30,
        flags: 40,
    };
    // Disjoint struct fields: writing payload and crc must not clobber hdr or flags
    frame.hdr = 12;
    frame.payload = frame.hdr + 50;
    frame.crc = frame.payload + 25;
    frame.flags = 7;

    let mut lanes: [4]i64 = [100, 200, 300, 400];
    // Constant index writes are pairwise disjoint
    lanes[0] = lanes[0] + frame.hdr;
    lanes[1] = lanes[1] + frame.payload;
    lanes[2] = lanes[2] - frame.crc;
    // Dynamic index write may alias any element and must act as a clobber barrier
    lanes[dyn_idx] = lanes[dyn_idx] + delta;

    frame.hdr + frame.payload + frame.crc + frame.flags +
        lanes[0] + lanes[1] + lanes[2] + lanes[3]
}

fn step_add_scaled(dst: mut_view<i64>, src: view<i64>, scale: i64) -> i64 {
    *dst = *dst + (*src) * scale;
    *dst
}

fn kernel_sequential_reborrow(init_x: i64, init_y: i64) -> i64 {
    let mut x: i64 = init_x;
    let mut y: i64 = init_y;
    let s1 = step_add_scaled(mut_view(x), view(y), 3);
    let s2 = step_add_scaled(mut_view(y), view(x), 2);
    let s3 = step_add_scaled(mut_view(x), view(y), 1);
    s1 + s2 + s3 + x - y
}

fn kernel_loop_backedge_clobber(acc: mut_view<i64>, aux: mut_view<i64>, n: i64) -> i64 {
    *acc = 10;
    *aux = 5;
    let mut i: i64 = 1;
    while i <= n {
        let cur_acc: i64 = *acc;
        let cur_aux: i64 = *aux;
        *acc = cur_acc + i * cur_aux;
        *aux = cur_aux + 2;
        i = i + 1;
    }
    (*acc) + (*aux)
}

fn kernel_raw_ptr_may_alias(same_target: bool) -> i64 {
    let mut slot_a: i64 = 50;
    let mut slot_b: i64 = 80;
    let p: *mut i64 = unsafe { address_of_mut(slot_a) };
    let q: *mut i64 = if same_target {
        unsafe { address_of_mut(slot_a) }
    } else {
        unsafe { address_of_mut(slot_b) }
    };
    unsafe {
        *p = 120;
        // When p and q alias slot_a, *q = 310 overwrites *p = 120; must not forward 120!
        *q = *p + 190;
        let p_after: i64 = *p;
        let q_after: i64 = *q;
        p_after + q_after + slot_b
    }
}

fn main() -> i32 {
    print("Xin chào E15.2 alias_cap_forwarding_rle_dse\n");

    let mut a: i64 = 1;
    let mut b: i64 = 2;
    let ro: i64 = 40;
    let v_fwd = kernel_mut_forward_and_view_rle(mut_view(a), mut_view(b), view(ro), 50);
    let m1 = v_fwd + a - 50;
    emit_metric("mut_forward_rle=", m1);
    if m1 != 245 { return 1; }

    let m2 = kernel_field_const_and_dyn_index(2, -550);
    emit_metric("field_const_dyn=", m2);
    if m2 != 605 { return 2; }

    let m3 = kernel_sequential_reborrow(8, 7);
    let m3_adj = m3 - 44;
    emit_metric("seq_reborrow=", m3_adj);
    if m3_adj != 173 { return 3; }

    let mut loop_acc: i64 = 0;
    let mut loop_aux: i64 = 0;
    let m4 = kernel_loop_backedge_clobber(mut_view(loop_acc), mut_view(loop_aux), 6);
    let m4_adj = m4 + 113;
    emit_metric("loop_backedge=", m4_adj);
    if m4_adj != 385 { return 4; }

    let raw_same = kernel_raw_ptr_may_alias(true);
    let raw_diff = kernel_raw_ptr_may_alias(false);
    let m5 = raw_same + raw_diff - 530;
    emit_metric("raw_ptr_alias=", m5);
    if m5 != 910 { return 5; }

    let total = m1 + m2 + m3_adj + m4_adj + m5;
    emit_metric("checksum=", total);
    if total != 2318 { return 6; }
    0
}
