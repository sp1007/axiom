// test: ui

struct CounterState {
    val: i64,
}

fn main() {
    let mut state = CounterState { val: 10 };
    let mut mut_writer = || -> i64 {
        state.val = state.val + 5;
        state.val
    };
    let shared_reader = || -> i64 { //~ ERROR AX_CAP_CONFLICT_READ
        state.val + 1
    };
    let _ = shared_reader();
    let _ = mut_writer();
}
