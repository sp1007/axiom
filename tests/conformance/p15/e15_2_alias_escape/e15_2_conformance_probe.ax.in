fn probe_zero_bytes(ptr: *mut u8, byte_len: usize) {
    let mut i: usize = 0;
    while i < byte_len {
        unsafe { *(ptr + i) = 0u8; }
        i = i + 1;
    }
}

fn probe_make_fn_1arg(arena: mut_view<Arena>) -> *const HirItem {
    let fn_it = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let p0 = arena_alloc_raw(mut_view(*arena), size_of<HirParam>(), align_of<HirParam>()) as *mut HirParam;
    probe_zero_bytes(fn_it as *mut u8, size_of<HirItem>());
    probe_zero_bytes(p0 as *mut u8, size_of<HirParam>());
    unsafe {
        (*p0).next = 0 as *mut HirParam;
        (*fn_it).kind = HIR_ITEM_FN;
        (*fn_it).params = p0;
    }
    fn_it as *const HirItem
}

fn probe_make_fn_2arg(arena: mut_view<Arena>) -> *const HirItem {
    let fn_it = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let p0 = arena_alloc_raw(mut_view(*arena), size_of<HirParam>(), align_of<HirParam>()) as *mut HirParam;
    let p1 = arena_alloc_raw(mut_view(*arena), size_of<HirParam>(), align_of<HirParam>()) as *mut HirParam;
    probe_zero_bytes(fn_it as *mut u8, size_of<HirItem>());
    probe_zero_bytes(p0 as *mut u8, size_of<HirParam>());
    probe_zero_bytes(p1 as *mut u8, size_of<HirParam>());
    unsafe {
        (*p0).next = p1;
        (*p1).next = 0 as *mut HirParam;
        (*fn_it).kind = HIR_ITEM_FN;
        (*fn_it).params = p0;
    }
    fn_it as *const HirItem
}

unsafe fn probe_u16_at(base: *mut u16, idx: usize) -> *mut u16 {
    let off = mir_mul_usize(idx, size_of<u16>());
    ((base as usize) + off) as *mut u16
}

fn verify_e15_2_alias_and_memopt(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let mc = memopt_contract();
    if mc.pass_id != PASS_ALIAS_MEM || mc.postconditions == 0u32 {
        return 10;
    }

    // 1. Blob 33: AliasInfo lattice, RegionRelation, AliasReason, and MemDependence
    let b33 = probe_mir_blob(mut_view(*arena), 33);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m33 = verify_parse_mir(b33, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m33 as usize) == 0 {
        return 11;
    }
    let o33 = optir_build_from_mir(unsafe { view(*m33) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o33 as usize) == 0 || sink.errors != 0 {
        return 12;
    }
    let info33 = alias_build_info(unsafe { view(*o33) }, 0 as *const EffectCallTable, mut_view(*arena));
    let pt0 = alias_make_prog_pt(0u32, 0u32);

    let p_mv1 = make_deref_pl(1u32, mut_view(*arena));
    let p_mv2 = make_deref_pl(2u32, mut_view(*arena));
    let f_mut = alias_query_places(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_mv1), view(p_mv2), pt0);
    if f_mut.result != ALIAS_NO_ALIAS || f_mut.relation != REGION_DISJOINT ||
       f_mut.certainty != CERTAINTY_PROVEN || f_mut.reason != ALIAS_REASON_CAP_MUT_DISJOINT {
        return 13;
    }

    let p_vp = make_deref_pl(3u32, mut_view(*arena));
    let p_mvp = make_deref_pl(4u32, mut_view(*arena));
    let f_vrw = alias_query_places(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_vp), view(p_mvp), pt0);
    if f_vrw.result != ALIAS_NO_ALIAS || f_vrw.relation != REGION_DISJOINT ||
       f_vrw.certainty != CERTAINTY_PROVEN || f_vrw.reason != ALIAS_REASON_CAP_VIEW_READONLY {
        return 14;
    }

    let p_f0 = make_field_pl(6u32, 0u32, mut_view(*arena));
    let p_f1 = make_field_pl(6u32, 1u32, mut_view(*arena));
    let p_whole = mir_local_place(6u32);
    let f_fld = alias_query_places(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_f0), view(p_f1), pt0);
    let f_sub = alias_query_places(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_whole), view(p_f0), pt0);
    if f_fld.result != ALIAS_NO_ALIAS || f_fld.certainty != CERTAINTY_PROVEN || f_fld.reason != ALIAS_REASON_FIELD_DISJOINT ||
       f_sub.result != ALIAS_PARTIAL_ALIAS || f_sub.relation != REGION_CONTAINS {
        return 15;
    }

    let p_i0 = make_index_pl(7u32, 8u32, mut_view(*arena));
    let p_i2 = make_index_pl(7u32, 9u32, mut_view(*arena));
    let p_idyn = make_index_pl(7u32, 5u32, mut_view(*arena));
    let f_cidx = alias_query_places(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_i0), view(p_i2), pt0);
    let f_didx = alias_query_places(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_i0), view(p_idyn), pt0);
    if f_cidx.result != ALIAS_NO_ALIAS || f_cidx.certainty != CERTAINTY_PROVEN || f_cidx.reason != ALIAS_REASON_CONST_INDEX ||
       f_didx.result != ALIAS_MAY_ALIAS || f_didx.certainty != CERTAINTY_POSSIBLE || f_didx.reason != ALIAS_REASON_DYNAMIC_INDEX {
        return 16;
    }

    let p_raw_unk = make_deref_pl(10u32, mut_view(*arena));
    let f_runk = alias_query_places(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_raw_unk), view(p_mv1), pt0);
    alias_mark_shared_owner(unsafe { mut_view(*info33) }, 11u32);
    alias_mark_shared_owner(unsafe { mut_view(*info33) }, 12u32);
    let p_sh1 = make_deref_pl(11u32, mut_view(*arena));
    let p_sh2 = make_deref_pl(12u32, mut_view(*arena));
    let f_sh = alias_query_places(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_sh1), view(p_sh2), pt0);
    if f_runk.result != ALIAS_UNKNOWN || f_runk.certainty != CERTAINTY_UNKNOWN || f_runk.reason != ALIAS_REASON_RAW_PTR_PROVENANCE ||
       f_sh.result != ALIAS_MAY_ALIAS || f_sh.certainty != CERTAINTY_POSSIBLE || f_sh.reason != ALIAS_REASON_SHARED_OWNER {
        return 17;
    }

    let d_no = memopt_query_dependence(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_mv1), MEM_ACCESS_STORE, view(p_mv2), MEM_ACCESS_LOAD, pt0);
    let d_must = memopt_query_dependence(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_mv1), MEM_ACCESS_STORE, view(p_mv1), MEM_ACCESS_LOAD, pt0);
    let d_vol = memopt_query_dependence(unsafe { view(*info33) }, unsafe { view(*o33) }, mut_view(*arena), view(p_mv1), MEM_ACCESS_VOLATILE_STORE, view(p_mv2), MEM_ACCESS_LOAD, pt0);
    if d_no != MEM_DEP_NO_DEPEND || d_must != MEM_DEP_MUST_DEPEND || d_vol != MEM_DEP_UNKNOWN_DEPEND {
        return 18;
    }

    alias_populate_all_facts(unsafe { mut_view(*info33) }, unsafe { view(*o33) }, mut_view(*arena));
    let mut abuf1: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut abuf2: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    diag_buf_init(mut_view(abuf1));
    diag_buf_init(mut_view(abuf2));
    alias_print(mut_view(abuf1), unsafe { view(*info33) });
    alias_print(mut_view(abuf2), unsafe { view(*info33) });
    let aeq = abuf1.len > 32 && diag_buf_equals(view(abuf1), view(abuf2));
    diag_buf_free(mut_view(abuf1));
    diag_buf_free(mut_view(abuf2));
    if !aeq {
        return 19;
    }

    // 2. Blob 34: Store-to-load forwarding, RLE, overwrite DSE, dead-local DSE, and deterministic `memopt_print`
    let b34 = probe_mir_blob(mut_view(*arena), 34);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m34 = verify_parse_mir(b34, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m34 as usize) == 0 {
        return 20;
    }
    let mut stats_o0: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    memopt_stats_zero(mut_view(stats_o0));
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m34) },
        thir_ptr as *const Thir,
        OPT_PROFILE_DEBUG_O0,
        true,
        0 as *const EffectCallTable,
        mut_view(stats_o0),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || stats_o0.pass_runs != 0u32 || sink.errors != 0 {
        return 21;
    }

    let mut stats_o2: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    let log_ptr = arena_alloc_raw(mut_view(*arena), size_of<MemOptLog>(), align_of<MemOptLog>()) as *mut MemOptLog;
    memopt_log_init(unsafe { mut_view(*log_ptr) }, mut_view(*arena));
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m34) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats_o2),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 ||
       (stats_o2.forwarded_loads) < 1u32 ||
       (stats_o2.eliminated_redundant_loads) < 1u32 ||
       (stats_o2.eliminated_dead_stores) < 2u32 ||
       stats_o2.pass_rollbacks != 0u32 {
        return 22;
    }

    let mut mbuf1: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut mbuf2: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    diag_buf_init(mut_view(mbuf1));
    diag_buf_init(mut_view(mbuf2));
    memopt_print(mut_view(mbuf1), unsafe { view(*log_ptr) });
    memopt_print(mut_view(mbuf2), unsafe { view(*log_ptr) });
    let meq = mbuf1.len > 24 && diag_buf_equals(view(mbuf1), view(mbuf2));
    diag_buf_free(mut_view(mbuf1));
    diag_buf_free(mut_view(mbuf2));
    if !meq {
        return 23;
    }

    // 3. Blob 35: Volatile, Atomic, Zeroize, BlackBox, FFI Call, and ZeroCopyPin barriers (`REQ-OPT-308`, `REQ-OPT-312..314`, `REQ-OPT-347`)
    let b35 = probe_mir_blob(mut_view(*arena), 35);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m35 = verify_parse_mir(b35, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o35 = optir_build_from_mir(unsafe { view(*m35) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (m35 as usize) == 0 || (o35 as usize) == 0 || sink.errors != 0 {
        return 24;
    }
    let bb0 = unsafe { opt_block_at((*o35).blocks, 0) };
    let i0 = unsafe { opt_inst_at((*bb0).insts, 0) };
    let i1 = unsafe { opt_inst_at((*bb0).insts, 1) };
    let i2 = unsafe { opt_inst_at((*bb0).insts, 2) };
    let i3 = unsafe { opt_inst_at((*bb0).insts, 3) };
    let i4 = unsafe { opt_inst_at((*bb0).insts, 4) };
    let i5 = unsafe { opt_inst_at((*bb0).insts, 5) };
    let i6 = unsafe { opt_inst_at((*bb0).insts, 6) };
    unsafe {
        (*i0).opcode = OPT_INST_VOLATILE_STORE;
        (*i0).flags = (*i0).flags | OPT_FLAG_BARRIER;
        (*i1).opcode = OPT_INST_VOLATILE_LOAD;
        (*i1).flags = (*i1).flags | OPT_FLAG_BARRIER;
        (*i2).opcode = OPT_INST_ATOMIC;
        (*i2).sub_op = 1u8;
        (*i2).flags = (*i2).flags | OPT_FLAG_BARRIER;
        (*i3).opcode = OPT_INST_ATOMIC;
        (*i3).sub_op = 0u8;
        (*i3).flags = (*i3).flags | OPT_FLAG_BARRIER;
        (*i4).opcode = OPT_INST_ATOMIC;
        (*i4).sub_op = 2u8;
        (*i4).flags = (*i4).flags | OPT_FLAG_BARRIER;
        (*i5).opcode = OPT_INST_ZEROIZE;
        (*i5).flags = (*i5).flags | OPT_FLAG_BARRIER;
        (*i6).opcode = OPT_INST_BLACK_BOX;
        (*i6).flags = (*i6).flags | OPT_FLAG_BARRIER;
    }
    optir_construct_memssa(unsafe { mut_view(*o35) }, mut_view(*arena));
    let ctab = arena_alloc_raw(mut_view(*arena), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ctab) }, mut_view(*arena), 8);
    let bb0_callee = OptValueId { v: unsafe { (*opt_block_at((*o35).blocks, 0)).term.callee.v } };
    effect_call_table_register(
        unsafe { mut_view(*ctab) },
        mut_view(*arena),
        SymbolId { v: 1u32 },
        bb0_callee,
        effect_summary_from_flags(SymbolId { v: 1u32 }, EFFECT_FFI | EFFECT_READS_MEM | EFFECT_WRITES_MEM)
    );
    let info35 = alias_build_info(unsafe { view(*o35) }, ctab as *const EffectCallTable, mut_view(*arena));
    alias_mark_fixed_mmio(unsafe { mut_view(*info35) }, 1u32, 0u32);
    if memopt_classify_inst(unsafe { view(*info35) }, unsafe { view(*o35) }, unsafe { view(*i0) }) != MEM_ACCESS_VOLATILE_STORE ||
       memopt_classify_inst(unsafe { view(*info35) }, unsafe { view(*o35) }, unsafe { view(*i1) }) != MEM_ACCESS_VOLATILE_LOAD ||
       memopt_classify_inst(unsafe { view(*info35) }, unsafe { view(*o35) }, unsafe { view(*i2) }) != MEM_ACCESS_ATOMIC_STORE ||
       memopt_classify_inst(unsafe { view(*info35) }, unsafe { view(*o35) }, unsafe { view(*i3) }) != MEM_ACCESS_ATOMIC_LOAD ||
       memopt_classify_inst(unsafe { view(*info35) }, unsafe { view(*o35) }, unsafe { view(*i4) }) != MEM_ACCESS_ATOMIC_RMW ||
       memopt_classify_inst(unsafe { view(*info35) }, unsafe { view(*o35) }, unsafe { view(*i5) }) != MEM_ACCESS_MEMSET ||
       memopt_classify_inst(unsafe { view(*info35) }, unsafe { view(*o35) }, unsafe { view(*i6) }) != MEM_ACCESS_BARRIER {
        return 25;
    }

    alias_register_zero_copy_pin(unsafe { mut_view(*info35) }, mut_view(*arena), 3u32, 3u32, ALIAS_PT_WHOLE_START, ALIAS_PT_WHOLE_END);
    let zp_mut3 = make_deref_pl(3u32, mut_view(*arena));
    let zp_mmio1 = make_deref_pl(1u32, mut_view(*arena));
    let zp_ro4 = make_deref_pl(4u32, mut_view(*arena));
    let zp_dst2 = make_deref_pl(2u32, mut_view(*arena));
    let zpt_after_4 = alias_make_prog_pt(0u32, 10u32);
    if alias_verify_zero_copy_path(unsafe { view(*info35) }, unsafe { view(*o35) }, mut_view(*arena), view(zp_mut3), view(zp_dst2), ALIAS_PT_WHOLE_START, ALIAS_PT_WHOLE_END) ||
       alias_verify_zero_copy_path(unsafe { view(*info35) }, unsafe { view(*o35) }, mut_view(*arena), view(zp_ro4), view(zp_mmio1), ALIAS_PT_WHOLE_START, ALIAS_PT_WHOLE_END) ||
       !alias_verify_zero_copy_path(unsafe { view(*info35) }, unsafe { view(*o35) }, mut_view(*arena), view(zp_ro4), view(zp_mut3), zpt_after_4, ALIAS_PT_WHOLE_END) {
        return 26;
    }

    let pm35 = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm35) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm35) }, unsafe { mut_view(*o35) }, mut_view(*arena));
    let mut stats35: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    memopt_stats_zero(mut_view(stats35));
    let _ = memopt_run_pass_with_info(
        unsafe { mut_view(*pm35) },
        unsafe { mut_view(*o35) },
        unsafe { mut_view(*info35) },
        ctab as *const EffectCallTable,
        mut_view(stats35),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink)
    );
    if stats35.eliminated_dead_stores != 0u32 ||
       stats35.forwarded_loads != 0u32 ||
       (stats35.volatile_barriers) < 1u32 ||
       (stats35.atomic_barriers) < 1u32 ||
       (stats35.ffi_barriers) < 1u32 ||
       (stats35.zero_copy_barriers) < 1u32 {
        return 27;
    }

    // 4. Blob 36: `ptr_copy` (`memmove`) -> `ptr_copy_nonoverlapping` (`memcpy`) + `ptr_write_bytes` (`memset`)
    let b36 = probe_mir_blob(mut_view(*arena), 36);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m36 = verify_parse_mir(b36, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o36_pre = optir_build_from_mir(unsafe { view(*m36) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (m36 as usize) == 0 || (o36_pre as usize) == 0 || sink.errors != 0 {
        return 28;
    }
    let b36_bb2 = unsafe { opt_block_at((*o36_pre).blocks, 2) };
    if memopt_classify_term(unsafe { view(*o36_pre) }, unsafe { view((*b36_bb2).term) }, 0 as *const EffectCallTable) != MEM_ACCESS_MEMMOVE {
        return 29;
    }
    let mut stats36: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m36) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats36),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats36.memmove_to_memcpy_rewrites != 1u32 || (stats36.memset_zero_inits) < 1u32 {
        return 30;
    }
    let o36_post = optir_build_from_mir(unsafe { view(*m36) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let b36_bb2_post = unsafe { opt_block_at((*o36_post).blocks, 2) };
    if memopt_classify_term(unsafe { view(*o36_post) }, unsafe { view((*b36_bb2_post).term) }, 0 as *const EffectCallTable) != MEM_ACCESS_MEMCPY {
        return 31;
    }

    // 5. Blob 37: Loop backedge clobber (`bb0 -> bb1 -> bb2 -> bb1`) blocks forwarding!
    let b37 = probe_mir_blob(mut_view(*arena), 37);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m37 = verify_parse_mir(b37, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut stats37: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    if (m37 as usize) == 0 || !memopt_optimize_mir_body(
        unsafe { mut_view(*m37) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats37),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats37.forwarded_loads != 0u32 || stats37.eliminated_dead_stores != 0u32 {
        return 32;
    }

    print("PROBE_E15_2_ALIAS_AND_MEMOPT=OK\n");
    0
}

fn verify_e15_2_closure_signature_and_cap(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    // 1. REQ-OPT-385: Explicit semantic signature and attributes for closures stored without ambiguous inference
    // Construct a closure type with explicit (param_types: [i32, i64], ret_type: i64, fn_sym: 301, fn_type: type#36)
    // and 4 explicit ClosureCapture entries covering CAP_COPY, CAP_VIEW, CAP_MUT_VIEW, and CAP_MOVE.
    let c_params = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let c_caps = arena_alloc_raw(mut_view(*arena), mir_mul_usize(4, size_of<ClosureCapture>()), align_of<ClosureCapture>()) as *mut ClosureCapture;
    unsafe {
        *opt_typeid_at(c_params, 0) = TypeId { v: 8u32 }; // i32
        *opt_typeid_at(c_params, 1) = TypeId { v: 9u32 }; // i64

        let cap0 = capture_at(c_caps, 0);
        (*cap0).sym = SymbolId { v: 10u32 };
        (*cap0).mode = CAP_COPY;
        (*cap0).ty = TypeId { v: 8u32 };

        let cap1 = capture_at(c_caps, 1);
        (*cap1).sym = SymbolId { v: 11u32 };
        (*cap1).mode = CAP_VIEW;
        (*cap1).ty = TypeId { v: 22u32 };

        let cap2 = capture_at(c_caps, 2);
        (*cap2).sym = SymbolId { v: 12u32 };
        (*cap2).mode = CAP_MUT_VIEW;
        (*cap2).ty = TypeId { v: 18u32 };

        let cap3 = capture_at(c_caps, 3);
        (*cap3).sym = SymbolId { v: 13u32 };
        (*cap3).mode = CAP_MOVE;
        (*cap3).ty = TypeId { v: 20u32 };
    }

    let raw_clos_a = arena_alloc_raw(mut_view(*arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    let raw_clos_b = arena_alloc_raw(mut_view(*arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    let raw_clos_diff_sym = arena_alloc_raw(mut_view(*arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    unsafe {
        ax_type_reset(mut_view(*raw_clos_a), TY_CLOSURE);
        (*raw_clos_a).closure_id = 301u32;
        (*raw_clos_a).fn_sym = 301u32;
        (*raw_clos_a).fn_type = TypeId { v: 36u32 };
        (*raw_clos_a).param_types = c_params;
        (*raw_clos_a).param_count = 2;
        (*raw_clos_a).ret_type = TypeId { v: 9u32 };
        (*raw_clos_a).captures = c_caps;
        (*raw_clos_a).capture_count = 4;

        ax_type_reset(mut_view(*raw_clos_b), TY_CLOSURE);
        (*raw_clos_b).closure_id = 301u32;
        (*raw_clos_b).fn_sym = 301u32;
        (*raw_clos_b).fn_type = TypeId { v: 36u32 };
        (*raw_clos_b).param_types = c_params;
        (*raw_clos_b).param_count = 2;
        (*raw_clos_b).ret_type = TypeId { v: 9u32 };
        (*raw_clos_b).captures = c_caps;
        (*raw_clos_b).capture_count = 4;

        ax_type_reset(mut_view(*raw_clos_diff_sym), TY_CLOSURE);
        (*raw_clos_diff_sym).closure_id = 302u32;
        (*raw_clos_diff_sym).fn_sym = 302u32;
        (*raw_clos_diff_sym).fn_type = TypeId { v: 36u32 };
        (*raw_clos_diff_sym).param_types = c_params;
        (*raw_clos_diff_sym).param_count = 2;
        (*raw_clos_diff_sym).ret_type = TypeId { v: 9u32 };
        (*raw_clos_diff_sym).captures = c_caps;
        (*raw_clos_diff_sym).capture_count = 4;
    }

    let tid_a = intern_type(unsafe { mut_view((*thir_ptr).interner) }, unsafe { view(*raw_clos_a) });
    let tid_b = intern_type(unsafe { mut_view((*thir_ptr).interner) }, unsafe { view(*raw_clos_b) });
    let tid_diff = intern_type(unsafe { mut_view((*thir_ptr).interner) }, unsafe { view(*raw_clos_diff_sym) });
    if tid_a.v == 0u32 || tid_a.v != tid_b.v || tid_a.v == tid_diff.v {
        return 40;
    }

    let interned_clos = type_get(unsafe { view((*thir_ptr).interner) }, tid_a);
    if (interned_clos as usize) == 0 ||
       (unsafe { (*interned_clos).kind }) != TY_CLOSURE ||
       (unsafe { (*interned_clos).fn_sym }) != 301u32 ||
       (unsafe { (*interned_clos).fn_type.v }) != 36u32 ||
       (unsafe { (*interned_clos).param_count }) != 2 ||
       (unsafe { (*interned_clos).ret_type.v }) != 9u32 ||
       (unsafe { (*interned_clos).capture_count }) != 4 ||
       (unsafe { (*interned_clos).param_types }) == c_params ||
       (unsafe { (*interned_clos).captures }) == c_caps {
        return 41;
    }
    let ic0 = unsafe { capture_at((*interned_clos).captures, 0) };
    let ic1 = unsafe { capture_at((*interned_clos).captures, 1) };
    let ic2 = unsafe { capture_at((*interned_clos).captures, 2) };
    let ic3 = unsafe { capture_at((*interned_clos).captures, 3) };
    if (unsafe { (*ic0).sym.v }) != 10u32 || (unsafe { (*ic0).mode }) != CAP_COPY || (unsafe { (*ic0).ty.v }) != 8u32 ||
       (unsafe { (*ic1).sym.v }) != 11u32 || (unsafe { (*ic1).mode }) != CAP_VIEW || (unsafe { (*ic1).ty.v }) != 22u32 ||
       (unsafe { (*ic2).sym.v }) != 12u32 || (unsafe { (*ic2).mode }) != CAP_MUT_VIEW || (unsafe { (*ic2).ty.v }) != 18u32 ||
       (unsafe { (*ic3).sym.v }) != 13u32 || (unsafe { (*ic3).mode }) != CAP_MOVE || (unsafe { (*ic3).ty.v }) != 20u32 {
        return 42;
    }

    // 2. REQ-OPT-386: Closure capability tracker & `own_cap_check` conflict detection
    let tracker = mir_cap_tracker_new(mut_view(*arena));
    let pl_pair = mir_local_place(6u32);
    let pl_f0 = make_field_pl(6u32, 0u32, mut_view(*arena));
    let pl_f1 = make_field_pl(6u32, 1u32, mut_view(*arena));
    mir_cap_tracker_add(unsafe { mut_view(*tracker) }, mut_view(*arena), view(pl_f0), MIR_VIEW_READ);
    // Shared view on _6.0 does NOT conflict with another shared view on _6.0 or mut_view on disjoint _6.1,
    // but DOES conflict with mut_view on _6.0 or whole _6!
    if mir_cap_tracker_check_conflict(unsafe { view(*tracker) }, view(pl_f0), MIR_VIEW_READ) ||
       mir_cap_tracker_check_conflict(unsafe { view(*tracker) }, view(pl_f1), MIR_VIEW_MUT) ||
       !mir_cap_tracker_check_conflict(unsafe { view(*tracker) }, view(pl_f0), MIR_VIEW_MUT) ||
       !mir_cap_tracker_check_conflict(unsafe { view(*tracker) }, view(pl_pair), MIR_VIEW_MUT) {
        return 43;
    }

    // Blob 38: Closure capturing `&mut _1` while shared view `_2 = &_1` is still live -> `AX_CAP_CONFLICT_MUT`
    let m38 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 38), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m38 as usize) == 0 {
        return 44;
    }
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    own_cap_check(unsafe { view(*m38) }, mut_view(*sink));
    let d38 = sink.diags;
    if sink.errors != 1 || (unsafe { (*d38).code.v }) != AX_CAP_CONFLICT_MUT {
        return 45;
    }

    // Blob 39: Closure capturing `&_1` while mutable view `_2 = &mut _1` is still live -> `AX_CAP_CONFLICT_READ`
    let m39 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 39), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m39 as usize) == 0 {
        return 46;
    }
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    own_cap_check(unsafe { view(*m39) }, mut_view(*sink));
    let d39 = sink.diags;
    if sink.errors != 1 || (unsafe { (*d39).code.v }) != AX_CAP_CONFLICT_READ {
        return 47;
    }

    // Blob 40: Sequential non-overlapping closure capture borrows -> `sink.errors == 0`
    let m40 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 40), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m40 as usize) == 0 || AX_CAP_OUTLIVES_OWNER == 0u32 {
        return 48;
    }
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    own_cap_check(unsafe { view(*m40) }, mut_view(*sink));
    if sink.errors != 0 {
        return 49;
    }

    print("PROBE_E15_2_CLOSURE_SIGNATURE_AND_CAP=OK\n");
    0
}

fn verify_e15_2_escape_lattice_scc_and_barriers(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let fn_1arg = probe_make_fn_1arg(mut_view(*arena));
    let contract = escape_contract();
    if contract.pass_id != PASS_ESCAPE_PROMOTE || contract.postconditions == 0u32 {
        return 50;
    }

    if escape_class_from_set(ESC_NONE) != ESCAPE_NO_ESCAPE ||
       escape_class_from_set(ESC_ARGUMENT) != ESCAPE_ARG_ESCAPE ||
       escape_class_from_set(ESC_RETURN) != ESCAPE_RETURN_ESCAPE ||
       escape_class_from_set(ESC_ARGUMENT | ESC_RETURN) != ESCAPE_RETURN_ESCAPE ||
       escape_class_from_set(ESC_HEAP) != ESCAPE_GLOBAL_ESCAPE ||
       escape_class_from_set(ESC_THREAD) != ESCAPE_GLOBAL_ESCAPE ||
       escape_class_from_set(ESC_EXTERNAL) != ESCAPE_GLOBAL_ESCAPE ||
       escape_class_from_set(ESC_UNKNOWN) != ESCAPE_GLOBAL_ESCAPE ||
       escape_class_join(ESCAPE_NO_ESCAPE, ESCAPE_ARG_ESCAPE) != ESCAPE_ARG_ESCAPE ||
       escape_class_join(ESCAPE_ARG_ESCAPE, ESCAPE_RETURN_ESCAPE) != ESCAPE_RETURN_ESCAPE ||
       escape_class_join(ESCAPE_RETURN_ESCAPE, ESCAPE_GLOBAL_ESCAPE) != ESCAPE_GLOBAL_ESCAPE ||
       !escape_class_at_most(ESCAPE_ARG_ESCAPE, ESCAPE_RETURN_ESCAPE) ||
       escape_class_at_most(ESCAPE_GLOBAL_ESCAPE, ESCAPE_RETURN_ESCAPE) {
        return 51;
    }

    let stab_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    probe_seed_runtime_summaries(unsafe { mut_view(*stab_ptr) }, mut_view(*arena));

    // Blob 0: `AESCAPE-26` + `p as usize != 0` non-null check (`REQ-OPT-307`)
    let m0 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 0), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o0 = optir_build_from_mir(unsafe { view(*m0) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (m0 as usize) == 0 || (o0 as usize) == 0 || sink.errors != 0 {
        return 52;
    }
    optir_construct_memssa(unsafe { mut_view(*o0) }, mut_view(*arena));
    let info0 = escape_build_info(unsafe { view(*o0) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let lp0_1 = unsafe { escape_local_at((*info0).locals, 1) };
    if escape_query_local_class(unsafe { view(*info0) }, 1u32) != ESCAPE_NO_ESCAPE ||
       escape_query_local_set(unsafe { view(*info0) }, 1u32) != ESC_NONE ||
       !escape_is_no_escape_proven(unsafe { view(*info0) }, 1u32) ||
       escape_query_local_storage(unsafe { view(*info0) }, 1u32) != STORAGE_DECISION_SSA_REGISTER ||
       !escape_is_stack_promotable(unsafe { view(*info0) }, 1u32) ||
       (unsafe { (*lp0_1).address_observable }) ||
       (unsafe { (*lp0_1).reason }) != REASON_NO_ESCAPE_SROA {
        return 53;
    }

    // Blob 1: All 10 escape & stable-address barriers (`REQ-OPT-307`, `REQ-OPT-308`)
    let m1 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 1), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o1 = optir_build_from_mir(unsafe { view(*m1) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), fn_1arg);
    if (m1 as usize) == 0 || (o1 as usize) == 0 || sink.errors != 0 {
        return 54;
    }
    let bb7 = unsafe { opt_block_at((*o1).blocks, 7) };
    let mut ii: usize = 0;
    while ii < (unsafe { (*bb7).inst_count }) {
        let ip = unsafe { opt_inst_at((*bb7).insts, ii) };
        if (unsafe { (*ip).orig_stmt.place.local.v }) == 33u32 && (unsafe { (*ip).orig_stmt.place.proj_count }) == 1 {
            unsafe {
                (*ip).opcode = OPT_INST_VOLATILE_STORE;
                (*ip).flags = (*ip).flags | OPT_FLAG_BARRIER;
            }
        }
        ii = ii + 1;
    }
    optir_construct_memssa(unsafe { mut_view(*o1) }, mut_view(*arena));
    let ainfo1 = alias_build_info(unsafe { view(*o1) }, 0 as *const EffectCallTable, mut_view(*arena));
    alias_mark_fixed_mmio(unsafe { mut_view(*ainfo1) }, 10u32, 1u32);
    alias_register_zero_copy_pin(unsafe { mut_view(*ainfo1) }, mut_view(*arena), 32u32, 11u32, ALIAS_PT_WHOLE_START, ALIAS_PT_WHOLE_END);

    let info1 = arena_alloc_raw(mut_view(*arena), size_of<EscapeInfo>(), align_of<EscapeInfo>()) as *mut EscapeInfo;
    escape_init_info(
        unsafe { mut_view(*info1) },
        unsafe { view(*o1) },
        unsafe { view(*ainfo1) },
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(*arena)
    );
    let l1_2 = unsafe { escape_local_at((*info1).locals, 2) };
    let l1_3 = unsafe { escape_local_at((*info1).locals, 3) };
    let l1_4 = unsafe { escape_local_at((*info1).locals, 4) };
    let l1_5 = unsafe { escape_local_at((*info1).locals, 5) };
    let l1_6 = unsafe { escape_local_at((*info1).locals, 6) };
    let l1_7 = unsafe { escape_local_at((*info1).locals, 7) };
    let l1_9 = unsafe { escape_local_at((*info1).locals, 9) };
    let l1_10 = unsafe { escape_local_at((*info1).locals, 10) };
    let l1_11 = unsafe { escape_local_at((*info1).locals, 11) };
    let l1_12 = unsafe { escape_local_at((*info1).locals, 12) };
    let l1_13 = unsafe { escape_local_at((*info1).locals, 13) };

    if !(unsafe { (*l1_2).address_observable }) || (unsafe { (*l1_2).reason }) != REASON_ADDR_OBSERVABLE ||
       !(unsafe { (*l1_3).identity_compared }) || !(unsafe { (*l1_4).identity_compared }) ||
       (unsafe { (*l1_3).reason }) != REASON_IDENTITY_COMPARED ||
       (unsafe { (*l1_5).reason }) != REASON_THREAD_ESCAPE ||
       (unsafe { (*l1_6).reason }) != REASON_FFI_EXTERNAL_ESCAPE ||
       (unsafe { (*l1_7).no_escape_certainty }) != CERTAINTY_UNKNOWN || (unsafe { (*l1_7).reason }) != REASON_UNKNOWN_CALL_ESCAPE ||
       (unsafe { (*l1_9).size_bytes }) != 8192u64 || (unsafe { (*l1_9).reason }) != REASON_BUDGET_EXCEEDED ||
       (unsafe { (*l1_10).storage_decision }) != STORAGE_DECISION_FIXED_MMIO || (unsafe { (*l1_10).reason }) != REASON_FIXED_MMIO ||
       (unsafe { (*l1_11).storage_decision }) != STORAGE_DECISION_DEVICE_EXTERNAL || (unsafe { (*l1_11).reason }) != REASON_ZERO_COPY_PINNED ||
       (unsafe { (*l1_12).reason }) != REASON_VOLATILE_ATOMIC ||
       (unsafe { (*l1_13).reason }) != REASON_GLOBAL_HEAP_ESCAPE {
        return 55;
    }

    // Interprocedural SCC fixed-point summaries (`rec_a <-> rec_b`, `leak_a <-> leak_b`, `passthrough_view`)
    let m_rec_a = verify_parse_mir(probe_mir_blob(mut_view(*arena), 2), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m_rec_b = verify_parse_mir(probe_mir_blob(mut_view(*arena), 3), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m_leak_a = verify_parse_mir(probe_mir_blob(mut_view(*arena), 4), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m_leak_b = verify_parse_mir(probe_mir_blob(mut_view(*arena), 5), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m_pass = verify_parse_mir(probe_mir_blob(mut_view(*arena), 6), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    unsafe {
        (*m_rec_a).fn_sym = SymbolId { v: 110u32 };
        (*m_rec_b).fn_sym = SymbolId { v: 111u32 };
        (*m_leak_a).fn_sym = SymbolId { v: 112u32 };
        (*m_leak_b).fn_sym = SymbolId { v: 113u32 };
        (*m_pass).fn_sym = SymbolId { v: 108u32 };
    }
    let bodies = arena_alloc_raw(mut_view(*arena), mir_mul_usize(5, size_of<*mut MirBody>()), align_of<*mut MirBody>()) as *mut *mut MirBody;
    unsafe {
        *(((bodies as usize) + mir_mul_usize(0, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_rec_a;
        *(((bodies as usize) + mir_mul_usize(1, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_rec_b;
        *(((bodies as usize) + mir_mul_usize(2, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_leak_a;
        *(((bodies as usize) + mir_mul_usize(3, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_leak_b;
        *(((bodies as usize) + mir_mul_usize(4, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_pass;
    }
    let rounds = escape_solve_call_graph_summaries(
        bodies,
        5,
        thir_ptr as *const Thir,
        0 as *const EffectCallTable,
        unsafe { mut_view(*stab_ptr) },
        mut_view(*arena)
    );
    if rounds == 0u32 {
        return 56;
    }
    let mut s110 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s112 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s108 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    if !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 110u32 }), mut_view(s110)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 112u32 }), mut_view(s112)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 108u32 }), mut_view(s108)) ||
       escape_summary_param_escape(view(s110), 0) != ESC_ARGUMENT ||
       (escape_summary_param_escape(view(s112), 0) & ESC_EXTERNAL) == 0u16 ||
       (escape_summary_param_escape(view(s108), 0) & ESC_RETURN) == 0u16 ||
       s108.ret_aliases_params_mask != 1u32 {
        return 57;
    }

    // Contextual callers (Blob 7 & Blob 8)
    let m7 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 7), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o7 = optir_build_from_mir(unsafe { view(*m7) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    optir_construct_memssa(unsafe { mut_view(*o7) }, mut_view(*arena));
    let info7 = escape_build_info(unsafe { view(*o7) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let m8 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 8), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o8 = optir_build_from_mir(unsafe { view(*m8) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    optir_construct_memssa(unsafe { mut_view(*o8) }, mut_view(*arena));
    let info8 = escape_build_info(unsafe { view(*o8) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let l8_1 = unsafe { escape_local_at((*info8).locals, 1) };
    if escape_query_local_class(unsafe { view(*info7) }, 1u32) != ESCAPE_ARG_ESCAPE ||
       !escape_is_stack_promotable(unsafe { view(*info7) }, 1u32) ||
       escape_query_local_class(unsafe { view(*info8) }, 1u32) != ESCAPE_RETURN_ESCAPE ||
       (unsafe { (*l8_1).reason }) != REASON_ACTIVE_VIEW_ESCAPE {
        return 58;
    }

    print("PROBE_E15_2_ESCAPE_LATTICE_SCC_AND_BARRIERS=OK\n");
    0
}

fn verify_e15_2_promotions_nrvo_and_rollback(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let fn_1arg = probe_make_fn_1arg(mut_view(*arena));
    let fn_2arg = probe_make_fn_2arg(mut_view(*arena));
    let stab_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    probe_seed_runtime_summaries(unsafe { mut_view(*stab_ptr) }, mut_view(*arena));
    let log_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapePromoteLog>(), align_of<EscapePromoteLog>()) as *mut EscapePromoteLog;
    escape_log_init(unsafe { mut_view(*log_ptr) }, mut_view(*arena), 64);

    // 1. Blob 9 (loop-carried heap) vs Blob 10 (iteration-local inline buffer + disjoint stack slot reuse)
    let m9 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 9), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o9 = optir_build_from_mir(unsafe { view(*m9) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), fn_1arg);
    let info9 = escape_build_info(unsafe { view(*o9) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let sp9 = unsafe { escape_site_at((*info9).sites, 0) };
    let m10 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 10), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o10 = optir_build_from_mir(unsafe { view(*m10) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), fn_1arg);
    let info10 = escape_build_info(unsafe { view(*o10) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let sp10 = unsafe { escape_site_at((*info10).sites, 0) };
    if !(unsafe { (*sp9).crosses_backedge }) || (unsafe { (*sp9).reason }) != REASON_LOOP_CARRIED ||
       (unsafe { (*sp10).crosses_backedge }) || (unsafe { (*sp10).kind }) != ALLOC_KIND_BOUNDED_BUF ||
       (unsafe { (*sp10).storage_decision }) != STORAGE_DECISION_INLINE_BUFFER ||
       (unsafe { (*sp10).reason }) != REASON_INLINE_BUFFER ||
       (unsafe { (*info10).disjoint_pair_count }) < 1 ||
       (unsafe { (*info10).reused_stack_bytes }) < 8u64 {
        return 60;
    }

    // 2. Concrete promotions: Box SROA (Blob 0), Box ArgumentEscape stack (Blob 11),
    // Closure capture + devirtualization (Blob 12), Inline buffer + NRVO (Blob 13),
    // and combined 2-arg function (Blob 27)
    let m0 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 0), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut stats0 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m0) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats0),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats0.box_sroa_promotions != 1u32 ||
       (unsafe { (*mir_bb_at((*m0).bbs, 0)).terminator.kind }) != MIR_TERM_GOTO ||
       (unsafe { (*mir_bb_at((*m0).bbs, 1)).terminator.kind }) != MIR_TERM_DROP {
        return 61;
    }

    let m11 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 11), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut stats11 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m11) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats11),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats11.box_stack_promotions != 1u32 {
        return 62;
    }

    let m12 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 12), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut stats12 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m12) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats12),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats12.closure_env_promotions != 1u32 || stats12.closure_direct_calls != 1u32 ||
       (unsafe { (*mir_bb_at((*m12).bbs, 0)).terminator.func.kind }) != MIR_OP_CONST ||
       (unsafe { (*mir_bb_at((*m12).bbs, 0)).terminator.func.constant.val }) != 200u64 {
        return 63;
    }

    let m13 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 13), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut stats13 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m13) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats13),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats13.inline_buffer_promotions != 1u32 || stats13.nrvo_promotions != 1u32 {
        return 64;
    }

    let m27 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 27), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut st27 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m27) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st27),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        fn_2arg
    ) || sink.errors != 0 || st27.pass_rollbacks != 0u32 ||
       st27.box_sroa_promotions != 1u32 || st27.closure_env_promotions != 1u32 ||
       st27.inline_buffer_promotions != 1u32 || st27.nrvo_promotions != 1u32 {
        return 65;
    }

    // 3. NRVO terminator rewrites (`switchInt` on Blob 30, `MIR_TERM_ASSERT` on Blob 31) and multi-return rejection (Blob 32)
    let m30 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 30), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut st30 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m30) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st30),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st30.nrvo_promotions != 1u32 ||
       (unsafe { (*mir_bb_at((*m30).bbs, 1)).terminator.kind }) != MIR_TERM_SWITCH_INT ||
       (unsafe { (*mir_bb_at((*m30).bbs, 1)).terminator.discr.place.local.v }) != 0u32 {
        return 66;
    }

    let m31 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 31), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m31_bb1_pre = unsafe { mir_bb_at((*m31).bbs, 1) };
    let proj_f0 = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        (*proj_f0).kind = MIR_PROJ_FIELD;
        (*proj_f0).field_idx = 0u32;
        (*proj_f0).index_local = MirLocalId { v: 0u32 };
        (*proj_f0).from_local = MirLocalId { v: 0u32 };
        (*proj_f0).to_local = MirLocalId { v: 0u32 };
        (*proj_f0).has_from = false;
        (*proj_f0).has_to = false;
        (*proj_f0).variant_idx = 0u32;
        let sp = (*m31_bb1_pre).terminator.span;
        mir_term_reset(mut_view((*m31_bb1_pre).terminator), MIR_TERM_ASSERT, view(sp));
        (*m31_bb1_pre).terminator.cond = mir_op_copy_local(5u32);
        (*m31_bb1_pre).terminator.cond.place.projs = proj_f0;
        (*m31_bb1_pre).terminator.cond.place.proj_count = 1;
        (*m31_bb1_pre).terminator.expected = true;
        (*m31_bb1_pre).terminator.assert_target = MirBbId { v: 2u32 };
        (*m31_bb1_pre).terminator.assert_unwind = MirBbId { v: 4u32 };
    }
    let mut st31 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m31) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st31),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st31.nrvo_promotions != 1u32 ||
       (unsafe { (*mir_bb_at((*m31).bbs, 1)).terminator.cond.place.local.v }) != 0u32 {
        return 67;
    }

    let m32 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 32), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut st32 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m32) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st32),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st32.box_sroa_promotions != 1u32 || st32.nrvo_promotions != 0u32 {
        return 68;
    }

    // 4. Negative soundness guards (Blobs 18, 19, 20, 24, 25, 26) + PassManager rollback + deterministic printers
    let m18 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 18), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o18 = optir_build_from_mir(unsafe { view(*m18) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let info18 = escape_build_info(unsafe { view(*o18) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let sp18 = unsafe { escape_site_at((*info18).sites, 0) };
    let m20 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 20), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o20 = optir_build_from_mir(unsafe { view(*m20) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let info20 = escape_build_info(unsafe { view(*o20) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let m24 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 24), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut st24 = escape_stats_zero();
    let _ = escape_optimize_mir_body(
        unsafe { mut_view(*m24) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st24),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    );
    let m26 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 26), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o26 = optir_build_from_mir(unsafe { view(*m26) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let info26 = escape_build_info(unsafe { view(*o26) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let l26_1 = unsafe { escape_local_at((*info26).locals, 1) };
    if (unsafe { (*sp18).has_matching_free }) || (unsafe { (*sp18).reason }) != REASON_UNBALANCED_FREE ||
       (unsafe { (*info20).disjoint_pair_count }) != 0 ||
       st24.closure_env_promotions != 0u32 ||
       !(unsafe { (*l26_1).address_observable }) || (unsafe { (*l26_1).reason }) != REASON_ADDR_OBSERVABLE {
        return 69;
    }

    // Atomic PassManager rollback on postcondition fault
    let m0_rb = verify_parse_mir(probe_mir_blob(mut_view(*arena), 0), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o0_rb = optir_build_from_mir(unsafe { view(*m0_rb) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let pm_rb = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm_rb) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_rb) }, unsafe { mut_view(*o0_rb) }, mut_view(*arena));
    let pre_rev = unsafe { (*pm_rb).ir_revision };
    let info_rb = escape_build_info(unsafe { view(*o0_rb) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let mut stats_rb = escape_stats_zero();
    if escape_run_pass_internal(
        unsafe { mut_view(*pm_rb) },
        unsafe { mut_view(*o0_rb) },
        unsafe { mut_view(*info_rb) },
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats_rb),
        log_ptr,
        true,
        mut_view(*arena),
        mut_view(*sink)
    ) || stats_rb.pass_rollbacks != 1u32 || (unsafe { (*pm_rb).ir_revision }) != pre_rev || sink.errors != 0 {
        return 70;
    }

    // Deterministic `escape_print` and `escape_promote_print`
    let mut db1: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut db2: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut db3: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut db4: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    diag_buf_init(mut_view(db1));
    diag_buf_init(mut_view(db2));
    diag_buf_init(mut_view(db3));
    diag_buf_init(mut_view(db4));
    escape_print(unsafe { view(*info_rb) }, mut_view(db1));
    escape_print(unsafe { view(*info_rb) }, mut_view(db2));
    escape_promote_print(view(stats13), unsafe { view(*log_ptr) }, mut_view(db3));
    escape_promote_print(view(stats13), unsafe { view(*log_ptr) }, mut_view(db4));
    let det_ok = db1.len > 0 && diag_buf_equals(view(db1), view(db2)) &&
                 db3.len > 0 && diag_buf_equals(view(db3), view(db4));
    diag_buf_free(mut_view(db1));
    diag_buf_free(mut_view(db2));
    diag_buf_free(mut_view(db3));
    diag_buf_free(mut_view(db4));
    if !det_ok {
        return 71;
    }

    print("PROBE_E15_2_PROMOTIONS_NRVO_AND_ROLLBACK=OK\n");
    0
}

fn main() -> i32 {
    let mut arena = arena_new();
    let mut sink: DiagSink = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *const DiagSink) };
    diag_sink_init(mut_view(sink));

    let alias_thir = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    probe_init_alias_thir(alias_thir, mut_view(arena));
    let r1 = verify_e15_2_alias_and_memopt(alias_thir, mut_view(arena), mut_view(sink));
    probe_free_thir(alias_thir);
    if r1 != 0 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r1;
    }

    let esc_thir = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    probe_init_escape_thir(esc_thir, mut_view(arena));

    let r2 = verify_e15_2_closure_signature_and_cap(esc_thir, mut_view(arena), mut_view(sink));
    if r2 != 0 {
        probe_free_thir(esc_thir);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r2;
    }

    let r3 = verify_e15_2_escape_lattice_scc_and_barriers(esc_thir, mut_view(arena), mut_view(sink));
    if r3 != 0 {
        probe_free_thir(esc_thir);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r3;
    }

    let r4 = verify_e15_2_promotions_nrvo_and_rollback(esc_thir, mut_view(arena), mut_view(sink));
    if r4 != 0 {
        probe_free_thir(esc_thir);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r4;
    }

    probe_free_thir(esc_thir);
    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(arena));
    print("PROBE_E15_2_ALL=OK\n");
    0
}
