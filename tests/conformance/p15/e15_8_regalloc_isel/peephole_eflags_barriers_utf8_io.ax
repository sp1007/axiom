// test: diff
// flags: --verify-each
// stdout: GREETING=Xin chào thế giới\nDROP=22\nDROP=21\nPEEPHOLE_EFLAGS=255\nPEEPHOLE_BARRIERS=468\nPEEPHOLE_TOTAL=723\nDROP=10\n

// E15.8 Conformance (SPEC-77, REQ-OPT-371, REQ-OPT-372, AXS-MCOPT-020..026):
// Post-RA machine peephole conformance: EFLAGS liveness across fallthrough blocks and
// variable `cl` shifts (`mov r, 0` must NOT rewrite to `xor r, r` when flags are live),
// `cmp r, 0 -> test r, r` across signed/equality conditions on MIN..-1..0..1..MAX,
// raw-pointer alias and `CALL` barriers on frame-slot store-to-load forwarding,
// jump-threading / branch-inversion control-flow peepholes, deterministic `Drop`
// ordering, and canonical UTF-8 `"Xin chào thế giới"` stdout preservation.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct PeepDrop {
    tag: i32,
}

impl Drop for PeepDrop {
    fn drop(self: mut_view<PeepDrop>) {
        print("DROP=");
        print_int(self.tag);
        print("\n");
    }
}

fn select_zero_with_var_shift(a: i64, b: i64, v: i64, sh: u32) -> i64 {
    let shifted: i64 = v << sh;
    let pick: i64 = if a < b { 0 } else { shifted };
    pick
}

fn select_zero_fallthrough_sar(a: i64, b: i64, c: i64, sh: u32) -> i64 {
    let mut res: i64 = 0;
    if a < b {
        res = c >> sh;
    } else {
        res = 0;
    }
    if res == 0 {
        7
    } else {
        res
    }
}

fn cmp_zero_to_test_all_cc(x: i64) -> i64 {
    let v: i64 = (((x + 0) - 0) | 0) ^ 0;
    let w: i64 = (v << 0u32) >> 0u32;
    let b_eq: i64 = if w == 0 { 1 } else { 0 };
    let b_ne: i64 = if w != 0 { 2 } else { 0 };
    let b_lt: i64 = if w < 0 { 4 } else { 0 };
    let b_le: i64 = if w <= 0 { 8 } else { 0 };
    let b_gt: i64 = if w > 0 { 16 } else { 0 };
    let b_ge: i64 = if w >= 0 { 32 } else { 0 };
    b_eq + b_ne + b_lt + b_le + b_gt + b_ge
}

fn eflags_fallthrough_cl_and_test_suite() -> i64 {
    let s1: i64 = select_zero_with_var_shift(3, 10, 99, 0u32) +
        select_zero_with_var_shift(10, 3, 99, 0u32) +
        select_zero_with_var_shift(10, 3, 5, 2u32);
    let s2: i64 = select_zero_fallthrough_sar(2, 8, -32, 0u32) +
        select_zero_fallthrough_sar(8, 2, -32, 0u32) +
        select_zero_fallthrough_sar(2, 8, -32, 2u32);

    let min64: i64 = (-9223372036854775807i64) - 1i64;
    let max64: i64 = 9223372036854775807i64;
    let s3: i64 = cmp_zero_to_test_all_cc(min64) +
        cmp_zero_to_test_all_cc(-1) +
        cmp_zero_to_test_all_cc(0) +
        cmp_zero_to_test_all_cc(1) +
        cmp_zero_to_test_all_cc(max64);

    if s1 != 119 || s2 != -33 || s3 != 169 {
        return -500001;
    }
    s1 + s2 + s3
}

fn mutate_slot_across_call(s: mut_view<i64>, delta: i64) {
    *s = (*s) * 2 + delta;
}

fn cfg_thread_classify(k: i64) -> i64 {
    if k == 0 {
        11
    } else if k == 1 {
        22
    } else if k == 2 {
        33
    } else {
        match k {
            3 => 44,
            4 => 55,
            _ => 66,
        }
    }
}

fn barriers_and_cfg_threading_suite() -> i64 {
    let mut cell: i64 = 10;
    unsafe {
        let p: *mut i64 = address_of_mut(cell);
        cell = 20;
        *p = 77;
    }
    let after_raw: i64 = cell;

    unsafe {
        let pr: *const i64 = address_of(cell);
        let pw: *mut i64 = address_of_mut(cell);
        *pw = (*pr) + 8;
    }
    let rmw_raw: i64 = cell;

    let mut slot: i64 = 15;
    slot = 30;
    mutate_slot_across_call(mut_view(slot), 12);
    let after_call: i64 = slot;

    let mut dead: i64 = 1;
    dead = 2;
    dead = 3;

    let mut cfg_sum: i64 = 0;
    let mut k: i64 = 0;
    while k < 6 {
        cfg_sum = cfg_sum + cfg_thread_classify(k);
        k = k + 1;
    }

    if after_raw != 77 || rmw_raw != 85 || after_call != 72 || dead != 3 || cfg_sum != 231 {
        return -500002;
    }
    after_raw + rmw_raw + after_call + dead + cfg_sum
}

fn run_peephole_suite() -> i64 {
    print("GREETING=Xin chào thế giới\n");
    let g10 = PeepDrop { tag: 10 };
    {
        let g21 = PeepDrop { tag: 21 };
        let g22 = PeepDrop { tag: 22 };
        let _ = g21.tag + g22.tag;
    }

    let ef: i64 = eflags_fallthrough_cl_and_test_suite();
    print("PEEPHOLE_EFLAGS=");
    print_int(ef as i32);
    print("\n");

    let bar: i64 = barriers_and_cfg_threading_suite();
    print("PEEPHOLE_BARRIERS=");
    print_int(bar as i32);
    print("\n");

    let total: i64 = ef + bar + ((g10.tag - 10) as i64);
    print("PEEPHOLE_TOTAL=");
    print_int(total as i32);
    print("\n");
    total
}

fn main() -> i32 {
    let total: i64 = run_peephole_suite();
    if total != 723 {
        return 1;
    }
    0
}
