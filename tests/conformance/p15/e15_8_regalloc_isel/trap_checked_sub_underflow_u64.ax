// test: diff
// flags: --verify-each
// exit: 101

// E15.8 Conformance (SPEC-77 AXS-MCOPT-021, REQ-OPT-371):
// Checked unsigned `u64` subtraction underflow (`5u64 - 6u64`) interleaved with
// zero-constant initialization (`0u64`) must preserve `CF`/`jb` overflow assertion
// without peephole `xor r, r` clobbering EFLAGS.

fn opaque_u64(v: u64) -> u64 {
    v
}

fn checked_sub_u64_with_zero(a: u64, b: u64) -> u64 {
    let z: u64 = 0u64;
    let diff: u64 = a - b;
    diff + z
}

fn main() -> i32 {
    let a: u64 = opaque_u64(5u64);
    let b: u64 = opaque_u64(6u64);
    let r: u64 = checked_sub_u64_with_zero(a, b);
    (r & 1u64) as i32
}
