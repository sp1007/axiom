// test: diff
// flags: --verify-each
// stdout: IFCONV_CMOV_SETCC=32821\nIFCONV_XOR1_BOOL=396\nIFCONV_NOSPEC=2045\nIFCONV_TOTAL=35262\n

// E15.8 Conformance (SPEC-77, REQ-OPT-371, REQ-OPT-372, AXS-MCOPT-013):
// Pure scalar diamond conversion to branchless `cmovcc` and `setcc` (including sub-word
// i8..u32 selections and signed vs unsigned condition codes), strict distinction between
// TY_BOOL `!b` and non-boolean integer `x ^ 1` / `~x` switches, and non-speculation of
// trapping (`div`/`rem` by 0, `MIN / -1`, checked overflow, bounds checks) or
// side-effecting (`mut_view` store) diamond arms.

fn clamp_i64(v: i64, lo: i64, hi: i64) -> i64 {
    let t: i64 = if v < lo { lo } else { v };
    if t > hi { hi } else { t }
}

fn setcc_signed_unsigned(a: i64, b: i64) -> i64 {
    let s_lt: i64 = if a < b { 1 } else { 0 };
    let s_ge: i64 = if a >= b { 1 } else { 0 };
    let u_gt: i64 = if (a as u64) > (b as u64) { 1 } else { 0 };
    s_lt + s_ge * 2 + u_gt * 4
}

fn sw_i8(sel: bool, a: i8, b: i8) -> i64 {
    let r: i8 = if !sel { a } else { b };
    r as i64
}

fn sw_u8(cond: i64, a: u8, b: u8) -> i64 {
    let r: u8 = if cond < 0 { a } else { b };
    r as i64
}

fn sw_i16_u16(cond: i64) -> i64 {
    let s: i16 = if cond <= 0 { -30000i16 } else { -7i16 };
    let u: u16 = if cond <= 0 { 60000u16 } else { 40000u16 };
    (s as i64) + (u as i64)
}

fn sw_i32_u32(cond: i64) -> i64 {
    let s: i32 = if cond == 0 { -2000000000 } else { -400 };
    let u: u32 = if cond == 0 { 4000000000u32 } else { 3000u32 };
    (s as i64) + (u as i64)
}

fn cmov_setcc_diamonds_suite() -> i64 {
    let cl: i64 = clamp_i64(-25, -10, 50) + clamp_i64(33, -10, 50) + clamp_i64(99, -10, 50);
    let sc: i64 = setcc_signed_unsigned(-5, 3) + setcc_signed_unsigned(8, 3);
    let sub: i64 = sw_i8(false, -120i8, 100i8) +
        sw_i8(true, -120i8, -5i8) +
        sw_u8(-1, 250u8, 12u8) +
        sw_u8(1, 250u8, 12u8) +
        sw_i16_u16(0) +
        sw_i32_u32(1);
    if cl != 73 || sc != 11 || sub != 32737 {
        return -600001;
    }
    cl + sc + sub
}

fn bool_inv(b: bool) -> i64 {
    if !b { 41 } else { 19 }
}

fn xor1_if(x: i64) -> i64 {
    let y: i64 = x ^ 1;
    if y == 0 { 10 } else { 25 }
}

fn xor1_match(x: i64) -> i64 {
    let y: i64 = x ^ 1;
    match y {
        0 => 7,
        _ => 13,
    }
}

fn bitnot_match(x: i64) -> i64 {
    let y: i64 = ~x;
    match y {
        0 => 30,
        _ => 50,
    }
}

fn bool_vs_nonbool_xor1_suite() -> i64 {
    let b_sum: i64 = bool_inv(false) + bool_inv(true);
    let x_if: i64 = xor1_if(0) + xor1_if(1) + xor1_if(2) + xor1_if(3) + xor1_if(-1);
    let x_m: i64 = xor1_match(0) + xor1_match(1) + xor1_match(2) + xor1_match(-1);
    let bn_m: i64 = bitnot_match(-1) + bitnot_match(0) + bitnot_match(1) + bitnot_match(2);
    if b_sum != 60 || x_if != 110 || x_m != 46 || bn_m != 180 {
        return -600002;
    }
    b_sum + x_if + x_m + bn_m
}

fn safe_div(x: i64, d: i64) -> i64 {
    if d != 0 {
        x / d
    } else {
        900
    }
}

fn safe_srem_min(x: i64, d: i64) -> i64 {
    let min64: i64 = (-9223372036854775807i64) - 1i64;
    if d == 0 || (x == min64 && d == -1) {
        700
    } else {
        x % d
    }
}

fn safe_checked_add(x: i32, ok: bool) -> i64 {
    if ok {
        (x + 100) as i64
    } else {
        55
    }
}

fn safe_arr_get(idx: usize) -> i64 {
    let xs: [4]i64 = [10, 20, 30, 40];
    if idx < 4usize {
        xs[idx]
    } else {
        88
    }
}

fn cond_side_effect(do_it: bool, cnt: mut_view<i64>) -> i64 {
    if do_it {
        *cnt = *cnt + 100;
        11
    } else {
        22
    }
}

fn nospeculate_traps_and_effects_suite() -> i64 {
    let min64: i64 = (-9223372036854775807i64) - 1i64;
    let d0: i64 = safe_div(85, 0) + safe_div(85, 5);
    let dm: i64 = safe_srem_min(min64, -1) + safe_srem_min(-23, 5);
    let ca: i64 = safe_checked_add(2147483640, false) + safe_checked_add(20, true);
    let ag: i64 = safe_arr_get(99usize) + safe_arr_get(2usize);

    let mut cnt: i64 = 5;
    let e1: i64 = cond_side_effect(false, mut_view(cnt));
    if cnt != 5 {
        return -600003;
    }
    let e2: i64 = cond_side_effect(true, mut_view(cnt));
    if cnt != 105 {
        return -600004;
    }
    let eff: i64 = e1 + e2 + cnt;

    if d0 != 917 || dm != 697 || ca != 175 || ag != 118 || eff != 138 {
        return -600005;
    }
    d0 + dm + ca + ag + eff
}

fn main() -> i32 {
    let cmov_sc: i64 = cmov_setcc_diamonds_suite();
    print("IFCONV_CMOV_SETCC=");
    print_int(cmov_sc as i32);
    print("\n");

    let xor1_b: i64 = bool_vs_nonbool_xor1_suite();
    print("IFCONV_XOR1_BOOL=");
    print_int(xor1_b as i32);
    print("\n");

    let nospec: i64 = nospeculate_traps_and_effects_suite();
    print("IFCONV_NOSPEC=");
    print_int(nospec as i32);
    print("\n");

    let total: i64 = cmov_sc + xor1_b + nospec;
    print("IFCONV_TOTAL=");
    print_int(total as i32);
    print("\n");

    if cmov_sc != 32821 || xor1_b != 396 || nospec != 2045 || total != 35262 {
        return 1;
    }
    0
}
