// test: diff
// flags: --verify-each
// stdout: ISEL_LEA_MUL=1229\nISEL_CONST_DIV=6823\nISEL_CASTS=65886\nISEL_TOTAL=73938\n

// E15.8 Conformance (SPEC-77, REQ-OPT-371, REQ-OPT-372, AXS-MCOPT-010..012, AXS-MCOPT-016):
// Scaled-index `lea` addressing (`base + index * {1,2,4,8} + disp`, out-of-disp32 64-bit
// offsets, wrapping overflow wraparound, multi-width array indexing), constant multiply
// strength reduction, signed/unsigned constant division & modulo magic multipliers across
// i8..i64 and u8..u64 (including MIN/MAX and high-bit u64), and integer cast chains.

@intrinsic fn wrapping_add_i64(a: i64, b: i64) -> i64 { 0i64 }
@intrinsic fn wrapping_sub_i64(a: i64, b: i64) -> i64 { 0i64 }
@intrinsic fn wrapping_mul_i64(a: i64, b: i64) -> i64 { 0i64 }

fn id_i8(v: i8) -> i8 { v }
fn id_u8(v: u8) -> u8 { v }
fn id_i16(v: i16) -> i16 { v }
fn id_u16(v: u16) -> u16 { v }
fn id_i32(v: i32) -> i32 { v }
fn id_u32(v: u32) -> u32 { v }
fn id_i64(v: i64) -> i64 { v }

fn lea_and_mul_strength_suite(x: i64, y: i64, idx: usize) -> i64 {
    // Single-BB wrapping trees lowered to 3-component `lea [base + index*{1,2,4,8} + disp]`.
    let l1: i64 = wrapping_add_i64(wrapping_add_i64(x, y), 10);
    let l2: i64 = wrapping_add_i64(wrapping_add_i64(x, wrapping_mul_i64(y, 2)), -6);
    let l4: i64 = wrapping_add_i64(wrapping_add_i64(x, wrapping_mul_i64(y, 4)), 24);
    let l8: i64 = wrapping_sub_i64(wrapping_add_i64(y, wrapping_mul_i64(x, 8)), 16);
    let l_shl: i64 = wrapping_add_i64(wrapping_add_i64(x, y << 2u32), 5);

    // Out-of-disp32 64-bit displacement must NOT be truncated to 32-bit `disp32`.
    let big_disp: i64 = 0x1_0000_0005i64;
    let l_big: i64 = wrapping_sub_i64(wrapping_add_i64(x, big_disp), 0x1_0000_0000i64);
    if (l_big >> 32u32) != 0i64 {
        return -900001;
    }

    // Wrapping signed overflow wraparound via `lea`.
    let near_max: i64 = 0x7FFF_FFFF_FFFF_FFF0i64;
    let wrap_hi: i64 = wrapping_add_i64(near_max, wrapping_mul_i64(x, 4));
    let wrap_delta: i64 = wrapping_sub_i64(wrap_hi, near_max);
    if wrap_hi >= 0i64 || wrap_delta != 48i64 {
        return -900002;
    }

    let lea_sum: i64 = l1 + l2 + l4 + l8 + l_shl + l_big + wrap_delta;

    // Constant multiplication strength reduction (`0, 1, -1, 2, 3, 4, 5, 8, 9, 16, -3, -9`).
    let m0: i64 = x * 0;
    let m1: i64 = x * 1;
    let mn1: i64 = y * -1;
    let m2: i64 = x * 2;
    let m3: i64 = x * 3;
    let m4: i64 = y * 4;
    let m5: i64 = y * 5;
    let m8: i64 = y * 8;
    let m9: i64 = x * 9;
    let m16: i64 = y * 16;
    let mn3: i64 = y * -3;
    let mn9: i64 = y * -9;
    if m0 != 0 || m1 != 12 || mn1 != -7 || m2 != 24 || m3 != 36 || m4 != 28 ||
       m5 != 35 || m8 != 56 || m9 != 108 || m16 != 112 || mn3 != -21 || mn9 != -63 {
        return -900003;
    }
    let m_sum: i64 = m0 + m1 + mn1 + m2 + m3 + m4 + m5 + m8 + m9 + m16 + mn3 + mn9;

    // Multi-width indexed array accesses (`scale = 1, 2, 4, 8`).
    let a8: [5]u8 = [10u8, 20u8, 30u8, 40u8, 50u8];
    let a16: [5]i16 = [100i16, 200i16, -300i16, 400i16, 500i16];
    let mut a32: [5]i32 = [100, 200, 300, 400, 500];
    let a64: [5]i64 = [11, 22, 33, 44, 55];
    a32[idx] = a32[idx] + 15;
    let arr_sum: i64 = (a8[idx] as i64) +
        ((a16[idx - 1usize] + a16[idx]) as i64) +
        (a32[idx] as i64) +
        a64[idx];

    lea_sum + m_sum + arr_sum
}

fn const_div_mod_all_widths_suite(neg_x: i64, pos_y: i64, hi_u: u64) -> i64 {
    let q2: i64 = neg_x / 2;
    let r2: i64 = neg_x % 2;
    let q4: i64 = neg_x / 4;
    let r4: i64 = neg_x % 4;
    let q8: i64 = neg_x / 8;
    let r8: i64 = neg_x % 8;
    let qn4: i64 = neg_x / -4;
    let rn4: i64 = neg_x % -4;
    let q3: i64 = neg_x / 3;
    let r3: i64 = neg_x % 3;
    let q5: i64 = neg_x / 5;
    let r5: i64 = neg_x % 5;
    let q7: i64 = neg_x / 7;
    let r7: i64 = neg_x % 7;
    let q10: i64 = neg_x / 10;
    let r10: i64 = neg_x % 10;
    let qn7: i64 = neg_x / -7;
    let rn7: i64 = neg_x % -7;

    if q2 * 2 + r2 != neg_x || q4 * 4 + r4 != neg_x || q8 * 8 + r8 != neg_x ||
       qn4 * -4 + rn4 != neg_x || q3 * 3 + r3 != neg_x || q5 * 5 + r5 != neg_x ||
       q7 * 7 + r7 != neg_x || q10 * 10 + r10 != neg_x || qn7 * -7 + rn7 != neg_x {
        return -800001;
    }
    let s64_sum: i64 = q2 + r2 + q4 + r4 + q8 + r8 + qn4 + rn4 +
        q3 + r3 + q5 + r5 + q7 + r7 + q10 + r10 + qn7 + rn7;

    // Signed MIN boundaries across i8, i16, i32, i64.
    let min8: i8 = id_i8(-128i8);
    let min16: i16 = id_i16(-32768i16);
    let min32: i32 = id_i32(-2147483647 - 1);
    let min64: i64 = id_i64((-9223372036854775807i64) - 1i64);

    let b8: i64 = ((min8 / 3i8) as i64) + ((min8 % 3i8) as i64) +
        ((min8 / -4i8) as i64) + ((min8 % -4i8) as i64);
    let b16: i64 = ((min16 / 7i16) as i64) + ((min16 % 7i16) as i64);
    let b32_rem: i64 = (min32 % 10) as i64;
    if (min32 / 10) + 214748364 != 0 {
        return -800002;
    }
    let b64_rem: i64 = min64 % 3;
    if (min64 / 3) * 3 + b64_rem != min64 || (min64 % -8) != 0 {
        return -800003;
    }
    let bound_score: i64 = b8 + b16 + b32_rem + b64_rem + 5000;

    // Unsigned u8..u64 constant division/modulo including high-bit u64 (add_flag magic path).
    let q_hi3: u64 = hi_u / 3u64;
    let r_hi3: u64 = hi_u % 3u64;
    let q_hi7: u64 = hi_u / 7u64;
    let r_hi7: u64 = hi_u % 7u64;
    if q_hi3 != 0x5555_5555_5555_5554u64 || r_hi3 != 2u64 ||
       q_hi7 * 7u64 + r_hi7 != hi_u || r_hi7 != 0u64 {
        return -800004;
    }

    let u8_v: u8 = id_u8(250u8);
    let u16_v: u16 = id_u16(65530u16);
    let u32_v: u32 = id_u32(4000000009u32);
    if (u32_v / 10u32) != 400000000u32 {
        return -800005;
    }
    let uy: u64 = pos_y as u64;
    let u_sum: i64 = (r_hi3 as i64) +
        (r_hi7 as i64) +
        ((u8_v / 7u8) as i64) +
        ((u8_v % 7u8) as i64) +
        ((u16_v / 10u16) as i64) +
        ((u16_v % 10u16) as i64) +
        ((u32_v % 10u32) as i64) +
        ((uy / 5u64) as i64) +
        ((uy % 5u64) as i64) +
        ((uy / 16u64) as i64) +
        ((uy % 16u64) as i64);

    s64_sum + bound_score + u_sum
}

fn integer_casts_matrix_suite(rt_neg: i64, rt_u32: u32) -> i64 {
    let c1: i64 = ((-300i64) as u8) as i64;
    let c2: i64 = (rt_neg as u8) as i64;
    let c3: i64 = (250u8 as i8) as i64;
    let c4: i64 = (-1i8 as u16) as i64;
    let c5: i64 = (0x1_FF80u32 as i8) as i64;
    let c6: i64 = ((rt_u32 as i32) as i64) + 2147483648i64;
    let c7: i64 = ((rt_u32 as u64) >> 31u32) as i64;
    let c8: i64 = (65500u16 as i16) as i64;
    let c9: i64 = ((true as u8) as i64) + ((false as u8) as i64) + (('Z' as u32) as i64);

    if c1 != 212 || c2 != 212 || c3 != -6 || c4 != 65535 || c5 != -128 ||
       c6 != 5 || c7 != 1 || c8 != -36 || c9 != 91 {
        return -700001;
    }
    c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9
}

fn main() -> i32 {
    let lea_mul: i64 = lea_and_mul_strength_suite(12, 7, 3usize);
    print("ISEL_LEA_MUL=");
    print_int(lea_mul as i32);
    print("\n");

    let cdiv: i64 = const_div_mod_all_widths_suite(-103, 253, 0xFFFF_FFFF_FFFF_FFFEu64);
    print("ISEL_CONST_DIV=");
    print_int(cdiv as i32);
    print("\n");

    let casts: i64 = integer_casts_matrix_suite(-300, 0x8000_0005u32);
    print("ISEL_CASTS=");
    print_int(casts as i32);
    print("\n");

    let total: i64 = lea_mul + cdiv + casts;
    print("ISEL_TOTAL=");
    print_int(total as i32);
    print("\n");

    if lea_mul != 1229 || cdiv != 6823 || casts != 65886 || total != 73938 {
        return 1;
    }
    0
}
