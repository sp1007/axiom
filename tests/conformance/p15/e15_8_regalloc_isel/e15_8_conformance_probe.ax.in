@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

unsafe fn bb_has_opcode(mbb: *mut X64MIBb, opc: u32) -> bool {
    let mut cur = (*mbb).first_inst;
    while (cur as usize) != 0 {
        if (*cur).opcode == opc {
            return true;
        }
        cur = (*cur).next;
    }
    false
}

unsafe fn body_has_frame_op(body: view<X64MIBody>) -> bool {
    let mut b: usize = 0;
    while b < body.bb_count {
        let mbb = x64_mi_bb_at(body.bbs, b);
        let mut cur = (*mbb).first_inst;
        while (cur as usize) != 0 {
            let mut k: u8 = 0u8;
            while k < (*cur).op_count {
                if (*cur).ops[k as usize].kind == X64_OP_FRAME {
                    return true;
                }
                k = k + 1u8;
            }
            cur = (*cur).next;
        }
        b = b + 1;
    }
    false
}

fn buf_contains_frame_tok(buf: view<DiagBuffer>) -> bool {
    // Reject literal "[frame#" (ASCII: 91, 102, 114, 97, 109, 101, 35) in post-RA MI dump.
    let blen = buf.len;
    if blen < 7 {
        return false;
    }
    let mut i: usize = 0;
    while i + 7 <= buf.len {
        let b0 = unsafe { *(buf.ptr + i) };
        let b1 = unsafe { *(buf.ptr + i + 1) };
        let b2 = unsafe { *(buf.ptr + i + 2) };
        let b3 = unsafe { *(buf.ptr + i + 3) };
        let b4 = unsafe { *(buf.ptr + i + 4) };
        let b5 = unsafe { *(buf.ptr + i + 5) };
        let b6 = unsafe { *(buf.ptr + i + 6) };
        if b0 == 91u8 && b1 == 102u8 && b2 == 114u8 && b3 == 97u8 &&
           b4 == 109u8 && b5 == 101u8 && b6 == 35u8 {
            return true;
        }
        i = i + 1;
    }
    false
}

// =============================================================================
// Stage 1: Linear-Scan RA Pressure (> 32 simultaneously live GPRs across loop +
// call), Spill-Slot Lifetime Coloring, Disjoint Source/Spill Slots & Parallel-Copy
// Cycle Breaking (AXS-RA-020..027)
// =============================================================================

fn stage_regalloc_pressure(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let td = x64_target_desc_win64();
    if td.gpr_count != 14u8 || td.xmm_count != 16u8 {
        return 101;
    }
    if x64_loop_weight_multiplier(0u32) != 1u64 ||
       x64_loop_weight_multiplier(1u32) != 10u64 ||
       x64_loop_weight_multiplier(2u32) != 100u64 ||
       x64_loop_weight_multiplier(3u32) != 1000u64 {
        return 102;
    }

    // 1a. Stack-slot lifetime coloring: two disjoint intervals [2, 10) and [14, 22)
    //     share colored slot 0, while overlapping [6, 18) receives distinct slot 1.
    let mut alloc = X64StackSlotAllocator {
        slots: 0 as *mut X64ColoredSpillSlot,
        slot_count: 0u32,
        slot_cap: 0u32,
    };
    let ivs = arena_alloc_raw(mut_view(*a), 3 * size_of<X64LiveInterval>(), align_of<X64LiveInterval>()) as *mut X64LiveInterval;
    let iv0 = ivs;
    let iv1 = ((ivs as usize) + size_of<X64LiveInterval>()) as *mut X64LiveInterval;
    let iv2 = ((ivs as usize) + 2 * size_of<X64LiveInterval>()) as *mut X64LiveInterval;
    unsafe {
        x64_interval_reset(mut_view(*iv0), 0u32, REG_CLASS_GPR);
        x64_interval_add_range(mut_view(*a), mut_view(*iv0), 2u32, 10u32);
        x64_interval_reset(mut_view(*iv1), 1u32, REG_CLASS_GPR);
        x64_interval_add_range(mut_view(*a), mut_view(*iv1), 14u32, 22u32);
        x64_interval_reset(mut_view(*iv2), 2u32, REG_CLASS_GPR);
        x64_interval_add_range(mut_view(*a), mut_view(*iv2), 6u32, 18u32);
    }
    let s0 = x64_stack_slot_alloc_for_interval(mut_view(*a), mut_view(alloc), unsafe { view(*iv0) }, 8u32, 8u32);
    let s1 = x64_stack_slot_alloc_for_interval(mut_view(*a), mut_view(alloc), unsafe { view(*iv1) }, 8u32, 8u32);
    let s2 = x64_stack_slot_alloc_for_interval(mut_view(*a), mut_view(alloc), unsafe { view(*iv2) }, 8u32, 8u32);
    if s0 != 0u32 || s1 != 0u32 || s2 != 1u32 || alloc.slot_count != 2u32 {
        return 103;
    }

    // 1b. Parallel-copy cycle breaking: 3-cycle (RCX <- RDX, RDX <- R8, R8 <- RCX)
    //     emits 4 MOVs via dedicated scratch register R11.
    let b_pc = x64_mi_body_new(mut_view(*a), 1);
    let mbb_pc = unsafe { x64_mi_bb_at((*b_pc).bbs, 0) };
    let copies = arena_alloc_raw(
        mut_view(*a), 3 * size_of<X64ParallelCopy>(), align_of<X64ParallelCopy>()
    ) as *mut X64ParallelCopy;
    let emitted = unsafe {
        let c0 = x64_parallel_copy_at(copies, 0);
        let c1 = x64_parallel_copy_at(copies, 1);
        let c2 = x64_parallel_copy_at(copies, 2);
        (*c0).dst_reg = REG_RCX;
        (*c0).src_reg = REG_RDX;
        (*c0).size = 8u8;
        (*c1).dst_reg = REG_RDX;
        (*c1).src_reg = REG_R8;
        (*c1).size = 8u8;
        (*c2).dst_reg = REG_R8;
        (*c2).src_reg = REG_RCX;
        (*c2).size = 8u8;
        x64_emit_parallel_copies_in_arena(mut_view(*a), mut_view(*b_pc), mut_view(*mbb_pc), copies, 3, REG_R11)
    };
    if emitted != 4u32 {
        return 104;
    }

    // 1c. Build a 38-vreg LIR body with 2 source stack slots, 34 simultaneously live
    //     non-rematerializable GPR values across a loop back-edge (`bb1 -> bb1 / bb2`)
    //     and a Win64 `CALL`, verifying RA spilling, callee-saved preservation, disjoint
    //     source vs spill slot offsets, and 16-byte Win64 stack alignment.
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let bool_v = unsafe { (*ti_ptr).t_bool.v };
    let mut ext_name: [12]u8 = [101u8, 120u8, 116u8, 95u8, 99u8, 97u8, 108u8, 108u8, 0u8, 0u8, 0u8, 0u8];

    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), 2 * size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let vregs = arena_alloc_raw(mut_view(*a), 38 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let bbs = arena_alloc_raw(mut_view(*a), 3 * size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let insts0 = arena_alloc_raw(mut_view(*a), 36 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    let insts1 = arena_alloc_raw(mut_view(*a), 36 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    let insts2 = arena_alloc_raw(mut_view(*a), 2 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    unsafe {
        (*lir).is_opt = true;
        (*lir).frame_req.max_outgoing_args_bytes = 48u32;
        (*lir).frame_req.requires_16_byte_alignment = true;

        (*lir_slot_at(slots, 0)).ty.v = i64_v;
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir_slot_at(slots, 1)).ty.v = i64_v;
        (*lir_slot_at(slots, 1)).is_const = false;
        (*lir).slots = slots;
        (*lir).slot_count = 2;

        let mut v: usize = 0;
        while v < 37 {
            (*lir_vreg_at(vregs, v)).ty.v = i64_v;
            v = v + 1;
        }
        (*lir_vreg_at(vregs, 37)).ty.v = bool_v;
        (*lir).vregs = vregs;
        (*lir).vreg_count = 38;

        // bb0: v0 = arg0(RCX); v1 = const 3; v2..v35 = progressive ADD chain (34 live GPRs -> bb1)
        let b0_i0 = lir_inst_at(insts0, 0);
        lir_inst_reset(mut_view(*b0_i0), LIR_INST_ABI_ARG);
        (*b0_i0).dest.v = 0u32;
        (*b0_i0).loc_kind = ABI_LOC_REG;
        (*b0_i0).loc_reg_or_offset = REG_RCX as u32;

        let b0_i1 = lir_inst_at(insts0, 1);
        lir_inst_reset(mut_view(*b0_i1), LIR_INST_CONST);
        (*b0_i1).dest.v = 1u32;
        (*b0_i1).ty.v = i64_v;
        (*b0_i1).const_val = 3u64;

        let mut k: usize = 0;
        while k < 34 {
            let ins = lir_inst_at(insts0, 2 + k);
            lir_inst_reset(mut_view(*ins), LIR_INST_ADD);
            (*ins).dest.v = (2 + k) as u32;
            (*ins).lhs.v = (1 + k) as u32;
            (*ins).rhs.v = 0u32;
            k = k + 1;
        }

        // bb1 (loop depth 1): CALL ext_call, then fold all 34 live vregs (v2..v35) into v36, loop cond v37 = v36 < v1
        let b1_call = lir_inst_at(insts1, 0);
        lir_inst_reset(mut_view(*b1_call), LIR_INST_CALL);
        (*b1_call).sym_name = address_of_mut(ext_name[0]) as *const u8;
        (*b1_call).sym_len = 8;

        let b1_init = lir_inst_at(insts1, 1);
        lir_inst_reset(mut_view(*b1_init), LIR_INST_ADD);
        (*b1_init).dest.v = 36u32;
        (*b1_init).lhs.v = 2u32;
        (*b1_init).rhs.v = 3u32;

        let mut m: usize = 0;
        while m < 32 {
            let ins = lir_inst_at(insts1, 2 + m);
            lir_inst_reset(mut_view(*ins), LIR_INST_ADD);
            (*ins).dest.v = 36u32;
            (*ins).lhs.v = 36u32;
            (*ins).rhs.v = (4 + m) as u32;
            m = m + 1;
        }

        let b1_cmp = lir_inst_at(insts1, 34);
        lir_inst_reset(mut_view(*b1_cmp), LIR_INST_ICMP_SLT);
        (*b1_cmp).dest.v = 37u32;
        (*b1_cmp).lhs.v = 36u32;
        (*b1_cmp).rhs.v = 1u32;

        let b1_upd = lir_inst_at(insts1, 35);
        lir_inst_reset(mut_view(*b1_upd), LIR_INST_ADD);
        (*b1_upd).dest.v = 2u32;
        (*b1_upd).lhs.v = 2u32;
        (*b1_upd).rhs.v = 1u32;

        // bb2: store v36 into source slot 0 and return
        let b2_sa = lir_inst_at(insts2, 0);
        lir_inst_reset(mut_view(*b2_sa), LIR_INST_STACK_ADDR);
        (*b2_sa).dest.v = 0u32;
        (*b2_sa).slot.v = 0u32;

        let b2_st = lir_inst_at(insts2, 1);
        lir_inst_reset(mut_view(*b2_st), LIR_INST_STORE);
        (*b2_st).ptr.v = 0u32;
        (*b2_st).val.v = 36u32;

        let bb0 = lir_bb_at(bbs, 0);
        lir_bb_reset(mut_view(*bb0), 0u32);
        (*bb0).insts = insts0;
        (*bb0).inst_count = 36;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_JMP);
        (*bb0).term.jmp_target.v = 1u32;

        let bb1 = lir_bb_at(bbs, 1);
        lir_bb_reset(mut_view(*bb1), 1u32);
        (*bb1).insts = insts1;
        (*bb1).inst_count = 36;
        lir_term_reset(mut_view((*bb1).term), LIR_TERM_JCC);
        (*bb1).term.cond.v = 37u32;
        (*bb1).term.then_target.v = 1u32;
        (*bb1).term.else_target.v = 2u32;

        let bb2 = lir_bb_at(bbs, 2);
        lir_bb_reset(mut_view(*bb2), 2u32);
        (*bb2).insts = insts2;
        (*bb2).inst_count = 2;
        lir_term_reset(mut_view((*bb2).term), LIR_TERM_RETURN);

        (*lir).bbs = bbs;
        (*lir).bb_count = 3;
    }

    let mi_ra = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir) }, unsafe { view(*ti_ptr) }, true);
    let lv = x64_compute_liveness_in_arena(mut_view(*a), unsafe { view(*lir) }, unsafe { view(*mi_ra) });
    if x64_liveness_loop_depth(view(lv), 1) < 1u32 {
        return 105;
    }
    let ra = x64_regalloc_in_arena(
        mut_view(*a), unsafe { mut_view(*mi_ra) }, unsafe { view(*lir) }, unsafe { view(*ti_ptr) }
    );
    if ra.spilled_vreg_count == 0u32 || ra.used_callee_saved_mask == 0u32 {
        return 106;
    }

    let mi_opt = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir) }, unsafe { view(*ti_ptr) }, true);
    let lay_opt = x64_frame_lower_opt_in_arena(
        mut_view(*a), unsafe { mut_view(*mi_opt) }, unsafe { view(*lir) }, unsafe { view(*ti_ptr) }, 2u8
    );
    if x64_verify_checked(unsafe { view(*mi_opt) }, view(lay_opt)) != X64_VERIFY_OK {
        return 107;
    }
    if x64_frame_callee_saved_mask(view(lay_opt)) == 0u32 {
        return 108;
    }
    let cs_bytes = x64_frame_callee_saved_bytes(view(lay_opt));
    if ((lay_opt.frame_size + cs_bytes) % 16u32) != 0u32 || (unsafe { (*mi_opt).shadow_space }) < 48u32 {
        return 109;
    }

    // Disjoint source stack slots (0, 1) vs spill slots: source slots must have negative RBP offsets
    // distinct from every spill slot offset.
    let src0_off = x64_frame_slot_offset(view(lay_opt), 0u32);
    let src1_off = x64_frame_slot_offset(view(lay_opt), 1u32);
    if src0_off >= 0 || src1_off >= 0 || src0_off == src1_off {
        return 110;
    }

    arena_reset(mut_view(*a));
    0
}

// =============================================================================
// Stage 2: Target-Specific Instruction Selection & Non-Speculative If-Conversion
// (`REQ-OPT-371`, `AXS-MCOPT-010..016`)
// =============================================================================

fn stage_isel_ifconv(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let u64_v = unsafe { (*ti_ptr).t_u64.v };
    let bool_v = unsafe { (*ti_ptr).t_bool.v };

    // 2a. `base + idx * 8 + 16` stored to return slot 0 in one BB:
    //     `-O0` (`is_opt = false`) emits `X64_MI_IMUL` + `X64_MI_ADD` (no scaled `LEA`),
    //     whereas `-O1/-O2` (`is_opt = true`) folds `base + idx * 8 + 16` into a single
    //     `X64_MI_LEA` (`scale=8, disp=16`) and sweeps the dead multiply (`zero X64_MI_IMUL`).
    let lir_alu = lir_body_new(mut_view(*a));
    let alu_slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let alu_vregs = arena_alloc_raw(mut_view(*a), 8 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let alu_bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let alu_insts = arena_alloc_raw(mut_view(*a), 9 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    unsafe {
        (*lir_alu).is_opt = true;
        (*lir_slot_at(alu_slots, 0)).ty.v = i64_v;
        (*lir_slot_at(alu_slots, 0)).is_const = false;
        (*lir_alu).slots = alu_slots;
        (*lir_alu).slot_count = 1;

        let mut v: usize = 0;
        while v < 8 {
            (*lir_vreg_at(alu_vregs, v)).ty.v = i64_v;
            v = v + 1;
        }
        (*lir_alu).vregs = alu_vregs;
        (*lir_alu).vreg_count = 8;

        // v0 = arg0(RCX), v1 = arg1(RDX), v2 = 8, v3 = v1 * 8, v4 = v0 + v3, v5 = 16, v6 = v4 + v5, store [slot 0] = v6
        let i0 = lir_inst_at(alu_insts, 0);
        lir_inst_reset(mut_view(*i0), LIR_INST_ABI_ARG);
        (*i0).dest.v = 0u32;
        (*i0).loc_kind = ABI_LOC_REG;
        (*i0).loc_reg_or_offset = REG_RCX as u32;

        let i1 = lir_inst_at(alu_insts, 1);
        lir_inst_reset(mut_view(*i1), LIR_INST_ABI_ARG);
        (*i1).dest.v = 1u32;
        (*i1).loc_kind = ABI_LOC_REG;
        (*i1).loc_reg_or_offset = REG_RDX as u32;

        let i2 = lir_inst_at(alu_insts, 2);
        lir_inst_reset(mut_view(*i2), LIR_INST_CONST);
        (*i2).dest.v = 2u32;
        (*i2).ty.v = i64_v;
        (*i2).const_val = 8u64;

        let i3 = lir_inst_at(alu_insts, 3);
        lir_inst_reset(mut_view(*i3), LIR_INST_MUL);
        (*i3).dest.v = 3u32;
        (*i3).lhs.v = 1u32;
        (*i3).rhs.v = 2u32;

        let i4 = lir_inst_at(alu_insts, 4);
        lir_inst_reset(mut_view(*i4), LIR_INST_ADD);
        (*i4).dest.v = 4u32;
        (*i4).lhs.v = 0u32;
        (*i4).rhs.v = 3u32;

        let i5 = lir_inst_at(alu_insts, 5);
        lir_inst_reset(mut_view(*i5), LIR_INST_CONST);
        (*i5).dest.v = 5u32;
        (*i5).ty.v = i64_v;
        (*i5).const_val = 16u64;

        let i6 = lir_inst_at(alu_insts, 6);
        lir_inst_reset(mut_view(*i6), LIR_INST_ADD);
        (*i6).dest.v = 6u32;
        (*i6).lhs.v = 4u32;
        (*i6).rhs.v = 5u32;

        let i7 = lir_inst_at(alu_insts, 7);
        lir_inst_reset(mut_view(*i7), LIR_INST_STACK_ADDR);
        (*i7).dest.v = 7u32;
        (*i7).slot.v = 0u32;

        let i8 = lir_inst_at(alu_insts, 8);
        lir_inst_reset(mut_view(*i8), LIR_INST_STORE);
        (*i8).ptr.v = 7u32;
        (*i8).val.v = 6u32;

        let bb0 = lir_bb_at(alu_bbs, 0);
        lir_bb_reset(mut_view(*bb0), 0u32);
        (*bb0).insts = alu_insts;
        (*bb0).inst_count = 9;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
        (*lir_alu).bbs = alu_bbs;
        (*lir_alu).bb_count = 1;
    }

    let mi_alu_o0 = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_alu) }, unsafe { view(*ti_ptr) }, false);
    let mbb_alu_o0 = unsafe { x64_mi_bb_at((*mi_alu_o0).bbs, 0) };
    let mut o0_scaled_lea = false;
    unsafe {
        let mut cur = (*mbb_alu_o0).first_inst;
        while (cur as usize) != 0 {
            if (*cur).opcode == X64_MI_LEA && (*cur).ops[1usize].kind == X64_OP_MEM {
                if (*cur).ops[1usize].mem.scale == 8u8 && (*cur).ops[1usize].mem.disp == 16 {
                    o0_scaled_lea = true;
                }
            }
            cur = (*cur).next;
        }
    }
    if !(unsafe { bb_has_opcode(mbb_alu_o0, X64_MI_IMUL) }) || o0_scaled_lea {
        return 201;
    }

    let mi_alu_opt = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_alu) }, unsafe { view(*ti_ptr) }, true);
    let mbb_alu_opt = unsafe { x64_mi_bb_at((*mi_alu_opt).bbs, 0) };
    let mut found_scaled_lea = false;
    unsafe {
        let mut cur = (*mbb_alu_opt).first_inst;
        while (cur as usize) != 0 {
            if (*cur).opcode == X64_MI_LEA && (*cur).ops[1usize].kind == X64_OP_MEM {
                if (*cur).ops[1usize].mem.scale == 8u8 && (*cur).ops[1usize].mem.disp == 16 {
                    found_scaled_lea = true;
                }
            }
            cur = (*cur).next;
        }
    }
    if !found_scaled_lea || (unsafe { bb_has_opcode(mbb_alu_opt, X64_MI_IMUL) }) {
        return 202;
    }

    // 2b. Constant signed division by 7 (`LIR_INST_DIV`) + unsigned division by 7 (`LIR_INST_UDIV`):
    //     `-O0` emits `X64_MI_IDIV`, `-O1/-O2` emits magic multiply (`X64_MI_MUL`) with zero `X64_MI_IDIV`.
    let lir_div = lir_body_new(mut_view(*a));
    let div_slots = arena_alloc_raw(mut_view(*a), 2 * size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let div_vregs = arena_alloc_raw(mut_view(*a), 7 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let div_bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let div_insts = arena_alloc_raw(mut_view(*a), 9 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    unsafe {
        (*lir_div).is_opt = true;
        (*lir_slot_at(div_slots, 0)).ty.v = i64_v;
        (*lir_slot_at(div_slots, 0)).is_const = false;
        (*lir_slot_at(div_slots, 1)).ty.v = u64_v;
        (*lir_slot_at(div_slots, 1)).is_const = false;
        (*lir_div).slots = div_slots;
        (*lir_div).slot_count = 2;

        (*lir_vreg_at(div_vregs, 0)).ty.v = i64_v;
        (*lir_vreg_at(div_vregs, 1)).ty.v = i64_v;
        (*lir_vreg_at(div_vregs, 2)).ty.v = i64_v;
        (*lir_vreg_at(div_vregs, 3)).ty.v = i64_v;
        (*lir_vreg_at(div_vregs, 4)).ty.v = u64_v;
        (*lir_vreg_at(div_vregs, 5)).ty.v = u64_v;
        (*lir_vreg_at(div_vregs, 6)).ty.v = i64_v;
        (*lir_div).vregs = div_vregs;
        (*lir_div).vreg_count = 7;

        let di0 = lir_inst_at(div_insts, 0);
        lir_inst_reset(mut_view(*di0), LIR_INST_ABI_ARG);
        (*di0).dest.v = 0u32;
        (*di0).loc_kind = ABI_LOC_REG;
        (*di0).loc_reg_or_offset = REG_RCX as u32;

        let di1 = lir_inst_at(div_insts, 1);
        lir_inst_reset(mut_view(*di1), LIR_INST_CONST);
        (*di1).dest.v = 1u32;
        (*di1).ty.v = i64_v;
        (*di1).const_val = 7u64;

        let di2 = lir_inst_at(div_insts, 2);
        lir_inst_reset(mut_view(*di2), LIR_INST_DIV);
        (*di2).dest.v = 2u32;
        (*di2).lhs.v = 0u32;
        (*di2).rhs.v = 1u32;

        let di3 = lir_inst_at(div_insts, 3);
        lir_inst_reset(mut_view(*di3), LIR_INST_STACK_ADDR);
        (*di3).dest.v = 3u32;
        (*di3).slot.v = 0u32;

        let di4 = lir_inst_at(div_insts, 4);
        lir_inst_reset(mut_view(*di4), LIR_INST_STORE);
        (*di4).ptr.v = 3u32;
        (*di4).val.v = 2u32;

        let di5 = lir_inst_at(div_insts, 5);
        lir_inst_reset(mut_view(*di5), LIR_INST_ABI_ARG);
        (*di5).dest.v = 4u32;
        (*di5).loc_kind = ABI_LOC_REG;
        (*di5).loc_reg_or_offset = REG_RDX as u32;

        let di6 = lir_inst_at(div_insts, 6);
        lir_inst_reset(mut_view(*di6), LIR_INST_UDIV);
        (*di6).dest.v = 5u32;
        (*di6).lhs.v = 4u32;
        (*di6).rhs.v = 1u32;

        let di7 = lir_inst_at(div_insts, 7);
        lir_inst_reset(mut_view(*di7), LIR_INST_STACK_ADDR);
        (*di7).dest.v = 6u32;
        (*di7).slot.v = 1u32;

        let di8 = lir_inst_at(div_insts, 8);
        lir_inst_reset(mut_view(*di8), LIR_INST_STORE);
        (*di8).ptr.v = 6u32;
        (*di8).val.v = 5u32;

        let dbb0 = lir_bb_at(div_bbs, 0);
        lir_bb_reset(mut_view(*dbb0), 0u32);
        (*dbb0).insts = div_insts;
        (*dbb0).inst_count = 9;
        lir_term_reset(mut_view((*dbb0).term), LIR_TERM_RETURN);
        (*lir_div).bbs = div_bbs;
        (*lir_div).bb_count = 1;
    }
    let mi_div_o0 = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_div) }, unsafe { view(*ti_ptr) }, false);
    let mi_div_opt = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_div) }, unsafe { view(*ti_ptr) }, true);
    let mbb_div_o0 = unsafe { x64_mi_bb_at((*mi_div_o0).bbs, 0) };
    let mbb_div_opt = unsafe { x64_mi_bb_at((*mi_div_opt).bbs, 0) };
    if !(unsafe { bb_has_opcode(mbb_div_o0, X64_MI_IDIV) }) {
        return 203;
    }
    if (unsafe { bb_has_opcode(mbb_div_opt, X64_MI_IDIV) }) || !(unsafe { bb_has_opcode(mbb_div_opt, X64_MI_MUL) }) {
        return 204;
    }

    // 2c. Pure scalar diamond -> `X64_MI_CMOVCC` at `-O1/-O2` (`is_opt = true`) vs `X64_MI_JCC` at `-O0`,
    //     and `{1, 0}` diamond -> `X64_MI_SETCC`, whereas trapping `LIR_INST_DIV` arm MUST NOT speculate!
    let lir_dm = lir_body_new(mut_view(*a));
    let dm_slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let dm_vregs = arena_alloc_raw(mut_view(*a), 8 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let dm_bbs = arena_alloc_raw(mut_view(*a), 4 * size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let dm_i0 = arena_alloc_raw(mut_view(*a), 3 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    let dm_i1 = arena_alloc_raw(mut_view(*a), 3 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    let dm_i2 = arena_alloc_raw(mut_view(*a), 3 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    unsafe {
        (*lir_dm).is_opt = true;
        (*lir_slot_at(dm_slots, 0)).ty.v = i64_v;
        (*lir_slot_at(dm_slots, 0)).is_const = false;
        (*lir_dm).slots = dm_slots;
        (*lir_dm).slot_count = 1;

        (*lir_vreg_at(dm_vregs, 0)).ty.v = i64_v;
        (*lir_vreg_at(dm_vregs, 1)).ty.v = i64_v;
        (*lir_vreg_at(dm_vregs, 2)).ty.v = bool_v;
        (*lir_vreg_at(dm_vregs, 3)).ty.v = i64_v;
        (*lir_vreg_at(dm_vregs, 4)).ty.v = i64_v;
        (*lir_vreg_at(dm_vregs, 5)).ty.v = i64_v;
        (*lir_vreg_at(dm_vregs, 6)).ty.v = i64_v;
        (*lir_vreg_at(dm_vregs, 7)).ty.v = i64_v;
        (*lir_dm).vregs = dm_vregs;
        (*lir_dm).vreg_count = 8;

        // bb0: v0 = arg0(RCX), v1 = arg1(RDX), v2 = (v0 < v1), jcc v2 ? bb1 : bb2
        let p0 = lir_inst_at(dm_i0, 0);
        lir_inst_reset(mut_view(*p0), LIR_INST_ABI_ARG);
        (*p0).dest.v = 0u32;
        (*p0).loc_kind = ABI_LOC_REG;
        (*p0).loc_reg_or_offset = REG_RCX as u32;

        let p1 = lir_inst_at(dm_i0, 1);
        lir_inst_reset(mut_view(*p1), LIR_INST_ABI_ARG);
        (*p1).dest.v = 1u32;
        (*p1).loc_kind = ABI_LOC_REG;
        (*p1).loc_reg_or_offset = REG_RDX as u32;

        let p2 = lir_inst_at(dm_i0, 2);
        lir_inst_reset(mut_view(*p2), LIR_INST_ICMP_SLT);
        (*p2).dest.v = 2u32;
        (*p2).lhs.v = 0u32;
        (*p2).rhs.v = 1u32;

        // bb1 (then): v3 = stack_addr(0), v4 = v0 + v1, store [v3] = v4, jmp bb3
        let t0 = lir_inst_at(dm_i1, 0);
        lir_inst_reset(mut_view(*t0), LIR_INST_STACK_ADDR);
        (*t0).dest.v = 3u32;
        (*t0).slot.v = 0u32;

        let t1 = lir_inst_at(dm_i1, 1);
        lir_inst_reset(mut_view(*t1), LIR_INST_ADD);
        (*t1).dest.v = 4u32;
        (*t1).lhs.v = 0u32;
        (*t1).rhs.v = 1u32;

        let t2 = lir_inst_at(dm_i1, 2);
        lir_inst_reset(mut_view(*t2), LIR_INST_STORE);
        (*t2).ptr.v = 3u32;
        (*t2).val.v = 4u32;

        // bb2 (else): v5 = stack_addr(0), v6 = const 99, store [v5] = v6, jmp bb3
        let e0 = lir_inst_at(dm_i2, 0);
        lir_inst_reset(mut_view(*e0), LIR_INST_STACK_ADDR);
        (*e0).dest.v = 5u32;
        (*e0).slot.v = 0u32;

        let e1 = lir_inst_at(dm_i2, 1);
        lir_inst_reset(mut_view(*e1), LIR_INST_CONST);
        (*e1).dest.v = 6u32;
        (*e1).ty.v = i64_v;
        (*e1).const_val = 99u64;

        let e2 = lir_inst_at(dm_i2, 2);
        lir_inst_reset(mut_view(*e2), LIR_INST_STORE);
        (*e2).ptr.v = 5u32;
        (*e2).val.v = 6u32;

        let d_bb0 = lir_bb_at(dm_bbs, 0);
        let d_bb1 = lir_bb_at(dm_bbs, 1);
        let d_bb2 = lir_bb_at(dm_bbs, 2);
        let d_bb3 = lir_bb_at(dm_bbs, 3);

        lir_bb_reset(mut_view(*d_bb0), 0u32);
        (*d_bb0).insts = dm_i0;
        (*d_bb0).inst_count = 3;
        lir_term_reset(mut_view((*d_bb0).term), LIR_TERM_JCC);
        (*d_bb0).term.cond.v = 2u32;
        (*d_bb0).term.then_target.v = 1u32;
        (*d_bb0).term.else_target.v = 2u32;

        lir_bb_reset(mut_view(*d_bb1), 1u32);
        (*d_bb1).insts = dm_i1;
        (*d_bb1).inst_count = 3;
        lir_term_reset(mut_view((*d_bb1).term), LIR_TERM_JMP);
        (*d_bb1).term.jmp_target.v = 3u32;

        lir_bb_reset(mut_view(*d_bb2), 2u32);
        (*d_bb2).insts = dm_i2;
        (*d_bb2).inst_count = 3;
        lir_term_reset(mut_view((*d_bb2).term), LIR_TERM_JMP);
        (*d_bb2).term.jmp_target.v = 3u32;

        lir_bb_reset(mut_view(*d_bb3), 3u32);
        lir_term_reset(mut_view((*d_bb3).term), LIR_TERM_RETURN);

        (*lir_dm).bbs = dm_bbs;
        (*lir_dm).bb_count = 4;
    }

    let mi_dm_o0 = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_dm) }, unsafe { view(*ti_ptr) }, false);
    let mi_dm_opt = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_dm) }, unsafe { view(*ti_ptr) }, true);
    let mbb_dm_o0 = unsafe { x64_mi_bb_at((*mi_dm_o0).bbs, 0) };
    let mbb_dm_opt = unsafe { x64_mi_bb_at((*mi_dm_opt).bbs, 0) };
    if !(unsafe { bb_has_opcode(mbb_dm_o0, X64_MI_JCC) }) || (unsafe { bb_has_opcode(mbb_dm_o0, X64_MI_CMOVCC) }) {
        return 205;
    }
    if !(unsafe { bb_has_opcode(mbb_dm_opt, X64_MI_CMOVCC) }) || (unsafe { bb_has_opcode(mbb_dm_opt, X64_MI_JCC) }) {
        return 206;
    }

    // Mutate `then` arm from pure `LIR_INST_ADD` to potentially trapping `LIR_INST_DIV` (`v0 / v1`):
    // `is_opt = true` MUST refuse `CMOVCC` and preserve `X64_MI_JCC` (`AXS-MCOPT-014`).
    unsafe {
        let t1 = lir_inst_at(dm_i1, 1);
        (*t1).kind = LIR_INST_DIV;
    }
    let mi_dm_trap = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_dm) }, unsafe { view(*ti_ptr) }, true);
    let mbb_dm_trap0 = unsafe { x64_mi_bb_at((*mi_dm_trap).bbs, 0) };
    let mbb_dm_trap1 = unsafe { x64_mi_bb_at((*mi_dm_trap).bbs, 1) };
    if (unsafe { bb_has_opcode(mbb_dm_trap0, X64_MI_CMOVCC) }) ||
       !(unsafe { bb_has_opcode(mbb_dm_trap0, X64_MI_JCC) }) ||
       !(unsafe { bb_has_opcode(mbb_dm_trap1, X64_MI_IDIV) }) {
        return 207;
    }

    // 2d. Non-bool `i64` `xor v, 1` switch preserves `X64_MI_XOR`, whereas `bool` `xor v, 1` folds into `X64_MI_TEST`.
    let lir_sw = lir_body_new(mut_view(*a));
    let sw_slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let sw_vregs = arena_alloc_raw(mut_view(*a), 3 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let sw_bbs = arena_alloc_raw(mut_view(*a), 3 * size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let sw_insts = arena_alloc_raw(mut_view(*a), 3 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    let sw_tgts = arena_alloc_raw(mut_view(*a), size_of<LirSwitchTarget>(), align_of<LirSwitchTarget>()) as *mut LirSwitchTarget;
    unsafe {
        (*lir_sw).is_opt = true;
        (*lir_slot_at(sw_slots, 0)).ty.v = i64_v;
        (*lir_slot_at(sw_slots, 0)).is_const = false;
        (*lir_sw).slots = sw_slots;
        (*lir_sw).slot_count = 1;

        (*lir_vreg_at(sw_vregs, 0)).ty.v = i64_v;
        (*lir_vreg_at(sw_vregs, 1)).ty.v = i64_v;
        (*lir_vreg_at(sw_vregs, 2)).ty.v = i64_v;
        (*lir_sw).vregs = sw_vregs;
        (*lir_sw).vreg_count = 3;

        let si0 = lir_inst_at(sw_insts, 0);
        lir_inst_reset(mut_view(*si0), LIR_INST_ABI_ARG);
        (*si0).dest.v = 0u32;
        (*si0).loc_kind = ABI_LOC_REG;
        (*si0).loc_reg_or_offset = REG_RCX as u32;

        let si1 = lir_inst_at(sw_insts, 1);
        lir_inst_reset(mut_view(*si1), LIR_INST_CONST);
        (*si1).dest.v = 1u32;
        (*si1).ty.v = i64_v;
        (*si1).const_val = 1u64;

        let si2 = lir_inst_at(sw_insts, 2);
        lir_inst_reset(mut_view(*si2), LIR_INST_BIT_XOR);
        (*si2).dest.v = 2u32;
        (*si2).lhs.v = 0u32;
        (*si2).rhs.v = 1u32;

        (*lir_switch_target_at(sw_tgts, 0)).val = 0u64;
        (*lir_switch_target_at(sw_tgts, 0)).target.v = 1u32;

        let sbb0 = lir_bb_at(sw_bbs, 0);
        let sbb1 = lir_bb_at(sw_bbs, 1);
        let sbb2 = lir_bb_at(sw_bbs, 2);
        lir_bb_reset(mut_view(*sbb0), 0u32);
        (*sbb0).insts = sw_insts;
        (*sbb0).inst_count = 3;
        lir_term_reset(mut_view((*sbb0).term), LIR_TERM_SWITCH);
        (*sbb0).term.cond.v = 2u32;
        (*sbb0).term.targets = sw_tgts;
        (*sbb0).term.count = 1;
        (*sbb0).term.otherwise.v = 2u32;

        lir_bb_reset(mut_view(*sbb1), 1u32);
        lir_term_reset(mut_view((*sbb1).term), LIR_TERM_RETURN);
        lir_bb_reset(mut_view(*sbb2), 2u32);
        lir_term_reset(mut_view((*sbb2).term), LIR_TERM_RETURN);

        (*lir_sw).bbs = sw_bbs;
        (*lir_sw).bb_count = 3;
    }
    let mi_sw_i64 = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_sw) }, unsafe { view(*ti_ptr) }, true);
    let mbb_sw_i64 = unsafe { x64_mi_bb_at((*mi_sw_i64).bbs, 0) };
    if !(unsafe { bb_has_opcode(mbb_sw_i64, X64_MI_XOR) }) {
        return 208;
    }
    unsafe {
        (*lir_vreg_at(sw_vregs, 0)).ty.v = bool_v;
        (*lir_vreg_at(sw_vregs, 1)).ty.v = bool_v;
        (*lir_vreg_at(sw_vregs, 2)).ty.v = bool_v;
        (*lir_inst_at(sw_insts, 1)).ty.v = bool_v;
    }
    let mi_sw_bool = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir_sw) }, unsafe { view(*ti_ptr) }, true);
    let mbb_sw_bool = unsafe { x64_mi_bb_at((*mi_sw_bool).bbs, 0) };
    if (unsafe { bb_has_opcode(mbb_sw_bool, X64_MI_XOR) }) || !(unsafe { bb_has_opcode(mbb_sw_bool, X64_MI_TEST) }) {
        return 209;
    }

    arena_reset(mut_view(*a));
    0
}

// =============================================================================
// Stage 3: Post-RA Inspectable Machine IR Contract (`REQ-OPT-372`) & Post-RA
// Peephole EFLAGS / Alias / Call Barriers (`AXS-MCOPT-020..026`)
// =============================================================================

fn stage_postra_peephole_ir(a: mut_view<Arena>, ti_ptr: *mut TypeInterner, out: mut_view<DiagBuffer>) -> i32 {
    let i64_v = unsafe { (*ti_ptr).t_i64.v };

    // 3a. REQ-OPT-372: Post-RA Machine IR remains a structured, printable, verifiable IR
    //     with physical registers and concrete `[rbp - disp]` memory operands BEFORE byte encoding!
    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let vregs = arena_alloc_raw(mut_view(*a), 4 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let insts = arena_alloc_raw(mut_view(*a), 5 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    unsafe {
        (*lir).is_opt = true;
        (*lir_slot_at(slots, 0)).ty.v = i64_v;
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir).slots = slots;
        (*lir).slot_count = 1;

        let mut v: usize = 0;
        while v < 4 {
            (*lir_vreg_at(vregs, v)).ty.v = i64_v;
            v = v + 1;
        }
        (*lir).vregs = vregs;
        (*lir).vreg_count = 4;

        let i0 = lir_inst_at(insts, 0);
        lir_inst_reset(mut_view(*i0), LIR_INST_ABI_ARG);
        (*i0).dest.v = 0u32;
        (*i0).loc_kind = ABI_LOC_REG;
        (*i0).loc_reg_or_offset = REG_RCX as u32;

        let i1 = lir_inst_at(insts, 1);
        lir_inst_reset(mut_view(*i1), LIR_INST_CONST);
        (*i1).dest.v = 1u32;
        (*i1).ty.v = i64_v;
        (*i1).const_val = 5u64;

        let i2 = lir_inst_at(insts, 2);
        lir_inst_reset(mut_view(*i2), LIR_INST_MUL);
        (*i2).dest.v = 2u32;
        (*i2).lhs.v = 0u32;
        (*i2).rhs.v = 1u32;

        let i3 = lir_inst_at(insts, 3);
        lir_inst_reset(mut_view(*i3), LIR_INST_STACK_ADDR);
        (*i3).dest.v = 3u32;
        (*i3).slot.v = 0u32;

        let i4 = lir_inst_at(insts, 4);
        lir_inst_reset(mut_view(*i4), LIR_INST_STORE);
        (*i4).ptr.v = 3u32;
        (*i4).val.v = 2u32;

        let bb0 = lir_bb_at(bbs, 0);
        lir_bb_reset(mut_view(*bb0), 0u32);
        (*bb0).insts = insts;
        (*bb0).inst_count = 5;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
        (*lir).bbs = bbs;
        (*lir).bb_count = 1;
    }

    let mi = x64_isel_opt_in_arena(mut_view(*a), unsafe { view(*lir) }, unsafe { view(*ti_ptr) }, true);
    // Pre-RA Machine IR still contains abstract `X64_OP_FRAME` slots:
    if !(unsafe { body_has_frame_op(view(*mi)) }) {
        return 301;
    }

    // Run RA + frame lowering + post-RA peephole (`opt_level = 2`):
    let lay = x64_frame_lower_opt_in_arena(
        mut_view(*a), unsafe { mut_view(*mi) }, unsafe { view(*lir) }, unsafe { view(*ti_ptr) }, 2u8
    );

    // Post-RA Machine IR (`X64MIBody`) has zero abstract `X64_OP_FRAME` operands, prints cleanly
    // via `x64_mi_print`, and passes `x64_verify_checked` PRIOR to any COFF byte encoding!
    if unsafe { body_has_frame_op(view(*mi)) } {
        return 302;
    }
    out.len = 0;
    x64_mi_print(unsafe { view(*mi) }, mut_view(*out));
    if out.len == 0 || buf_contains_frame_tok(view(*out)) {
        return 303;
    }
    if x64_verify_checked(unsafe { view(*mi) }, view(lay)) != X64_VERIFY_OK {
        return 304;
    }

    // Only AFTER Post-RA IR inspection & verification do we encode machine bytes into `.text`:
    let mut obj = objmodel_new();
    let sid = objmodel_add_section_str(mut_view(obj), ".text", SEC_CODE, SEC_FLAG_EXEC | SEC_FLAG_READ, 16u32);
    let sec = objmodel_get_section_mut(mut_view(obj), sid);
    x64_emit_mi_body_obj(unsafe { mut_view(*sec) }, unsafe { view(*mi) }, view(lay), mut_view(obj));
    if (unsafe { (*sec).bytes_len }) == 0 {
        objmodel_free(mut_view(obj));
        return 305;
    }
    objmodel_free(mut_view(obj));

    // 3b. EFLAGS liveness: fallthrough `bb0: cmp rcx, rdx; mov rax, 0; jmp 1` -> `bb1: cmovcc CC_L, rax, r8; ret`
    //     removes redundant fallthrough `jmp` AND preserves `mov rax, 0` (does NOT clobber EFLAGS with `xor`).
    let mi_ft = x64_mi_body_new(mut_view(*a), 2);
    let ft_bb0 = unsafe { x64_mi_bb_at((*mi_ft).bbs, 0) };
    let ft_bb1 = unsafe { x64_mi_bb_at((*mi_ft).bbs, 1) };
    let mut ft_mov: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        x64_mi_emit(mut_view(*mi_ft), mut_view(*ft_bb0), X64_MI_CMP, x64_op_reg(REG_RCX), x64_op_reg(REG_RDX));
        ft_mov = x64_mi_emit(mut_view(*mi_ft), mut_view(*ft_bb0), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi_ft), mut_view(*ft_bb0), X64_MI_JMP, x64_op_imm(1i64), x64_op_none());
        x64_mi_emit_cmovcc(mut_view(*mi_ft), mut_view(*ft_bb1), CC_L, x64_op_reg(REG_RAX), x64_op_reg(REG_R8));
        let ft_ret = x64_mi_emit(mut_view(*mi_ft), mut_view(*ft_bb1), X64_MI_RET, x64_op_none(), x64_op_none());
        if x64_mi_flags_effect(view(*ft_ret)) != FLAGS_KILL {
            return 306;
        }
    }
    if x64_flags_are_dead_after(ft_mov) {
        return 307;
    }
    let _ = x64_peephole_opt_in_arena(mut_view(*a), unsafe { mut_view(*mi_ft) });
    if (unsafe { bb_has_opcode(ft_bb0, X64_MI_JMP) }) || (unsafe { (*ft_mov).opcode }) != X64_MI_MOV {
        return 308;
    }

    // 3c. Variable shift `shl r8, rcx` (CL may be 0 at runtime) does NOT prove EFLAGS dead;
    //     non-zero immediate shift `shl r8, 3` DOES prove EFLAGS dead (`mov rax, 0 -> xor rax, rax`);
    //     `cmp rcx, 0; jcc CC_E, 1` rewrites `cmp` -> `test rcx, rcx`.
    let mi_cl = x64_mi_body_new(mut_view(*a), 1);
    let cl_bb0 = unsafe { x64_mi_bb_at((*mi_cl).bbs, 0) };
    let mut cl_mov: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        x64_mi_emit(mut_view(*mi_cl), mut_view(*cl_bb0), X64_MI_CMP, x64_op_reg(REG_RCX), x64_op_reg(REG_RDX));
        cl_mov = x64_mi_emit(mut_view(*mi_cl), mut_view(*cl_bb0), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi_cl), mut_view(*cl_bb0), X64_MI_SHL, x64_op_reg(REG_R8), x64_op_reg(REG_RCX));
        x64_mi_emit_cmovcc(mut_view(*mi_cl), mut_view(*cl_bb0), CC_L, x64_op_reg(REG_RAX), x64_op_reg(REG_R9));
        x64_mi_emit(mut_view(*mi_cl), mut_view(*cl_bb0), X64_MI_RET, x64_op_none(), x64_op_none());
    }
    let _ = x64_peephole_opt_in_arena(mut_view(*a), unsafe { mut_view(*mi_cl) });
    if (unsafe { (*cl_mov).opcode }) != X64_MI_MOV {
        return 309;
    }

    let mi_idiom = x64_mi_body_new(mut_view(*a), 2);
    let id_bb0 = unsafe { x64_mi_bb_at((*mi_idiom).bbs, 0) };
    let id_bb1 = unsafe { x64_mi_bb_at((*mi_idiom).bbs, 1) };
    let mut id_mov: *mut X64MI = 0 as *mut X64MI;
    let mut id_cmp: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        id_mov = x64_mi_emit(mut_view(*mi_idiom), mut_view(*id_bb0), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi_idiom), mut_view(*id_bb0), X64_MI_SHL, x64_op_reg(REG_R8), x64_op_imm(3i64));
        id_cmp = x64_mi_emit(mut_view(*mi_idiom), mut_view(*id_bb0), X64_MI_CMP, x64_op_reg(REG_RCX), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi_idiom), mut_view(*id_bb0), X64_MI_JCC, x64_op_imm(CC_E as i64), x64_op_imm(1i64));
        x64_mi_emit(mut_view(*mi_idiom), mut_view(*id_bb0), X64_MI_RET, x64_op_none(), x64_op_none());
        let as_mi = x64_mi_emit(mut_view(*mi_idiom), mut_view(*id_bb1), X64_MI_ASSERT, x64_op_imm(0i64), x64_op_none());
        x64_mi_emit(mut_view(*mi_idiom), mut_view(*id_bb1), X64_MI_RET, x64_op_none(), x64_op_none());
        if x64_mi_flags_effect(view(*as_mi)) != FLAGS_USE {
            return 310;
        }
    }
    let _ = x64_peephole_opt_in_arena(mut_view(*a), unsafe { mut_view(*mi_idiom) });
    if (unsafe { (*id_mov).opcode }) != X64_MI_XOR || (unsafe { (*id_cmp).opcode }) != X64_MI_TEST {
        return 311;
    }

    // 3d. Stack-slot store-to-load forwarding vs indirect-store alias barrier & CALL barrier:
    let slot_mem = x64_op_mem(REG_RBP, REG_NONE, 1u8, -64, false);
    let ind_mem = x64_op_mem(REG_RDX, REG_NONE, 1u8, 0, false);

    // Direct forwarding: `mov [rbp-64], rcx; mov rax, [rbp-64]; ret` -> `mov rax, rcx`
    let mi_fwd = x64_mi_body_new(mut_view(*a), 1);
    let fwd_bb = unsafe { x64_mi_bb_at((*mi_fwd).bbs, 0) };
    let mut fwd_ld: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        x64_mi_emit(mut_view(*mi_fwd), mut_view(*fwd_bb), X64_MI_MOV, slot_mem, x64_op_reg(REG_RCX));
        fwd_ld = x64_mi_emit(mut_view(*mi_fwd), mut_view(*fwd_bb), X64_MI_MOV, x64_op_reg(REG_RAX), slot_mem);
        x64_mi_emit(mut_view(*mi_fwd), mut_view(*fwd_bb), X64_MI_RET, x64_op_none(), x64_op_none());
    }
    let _ = x64_peephole_opt_in_arena(mut_view(*a), unsafe { mut_view(*mi_fwd) });
    if (unsafe { (*fwd_ld).ops[1usize].kind }) != X64_OP_REG || (unsafe { (*fwd_ld).ops[1usize].reg }) != REG_RCX {
        return 312;
    }

    // Indirect pointer store barrier: `mov [rbp-64], rcx; mov [rdx], r8; mov rax, [rbp-64]; ret`
    // MUST NOT forward stale `rcx` across `mov [rdx], r8`!
    let mi_alias = x64_mi_body_new(mut_view(*a), 1);
    let al_bb = unsafe { x64_mi_bb_at((*mi_alias).bbs, 0) };
    let mut al_ld: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        x64_mi_emit(mut_view(*mi_alias), mut_view(*al_bb), X64_MI_MOV, slot_mem, x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*mi_alias), mut_view(*al_bb), X64_MI_MOV, ind_mem, x64_op_reg(REG_R8));
        al_ld = x64_mi_emit(mut_view(*mi_alias), mut_view(*al_bb), X64_MI_MOV, x64_op_reg(REG_RAX), slot_mem);
        x64_mi_emit(mut_view(*mi_alias), mut_view(*al_bb), X64_MI_RET, x64_op_none(), x64_op_none());
    }
    let _ = x64_peephole_opt_in_arena(mut_view(*a), unsafe { mut_view(*mi_alias) });
    if (unsafe { (*al_ld).ops[1usize].kind }) != X64_OP_MEM {
        return 313;
    }

    // CALL barrier: `mov [rbp-64], rbx; call ...; mov rax, [rbp-64]; ret` MUST NOT forward across `CALL`!
    let mi_callb = x64_mi_body_new(mut_view(*a), 1);
    let cb_bb = unsafe { x64_mi_bb_at((*mi_callb).bbs, 0) };
    let mut cb_ld: *mut X64MI = 0 as *mut X64MI;
    unsafe {
        x64_mi_emit(mut_view(*mi_callb), mut_view(*cb_bb), X64_MI_MOV, slot_mem, x64_op_reg(REG_RBX));
        x64_mi_emit(mut_view(*mi_callb), mut_view(*cb_bb), X64_MI_CALL, x64_op_none(), x64_op_none());
        cb_ld = x64_mi_emit(mut_view(*mi_callb), mut_view(*cb_bb), X64_MI_MOV, x64_op_reg(REG_RAX), slot_mem);
        x64_mi_emit(mut_view(*mi_callb), mut_view(*cb_bb), X64_MI_RET, x64_op_none(), x64_op_none());
    }
    let _ = x64_peephole_opt_in_arena(mut_view(*a), unsafe { mut_view(*mi_callb) });
    if (unsafe { (*cb_ld).ops[1usize].kind }) != X64_OP_MEM {
        return 314;
    }

    arena_reset(mut_view(*a));
    0
}

// =============================================================================
// Stage 4: Pre-Encoding Machine Verifier Gate (`x64_verify_checked`)
// =============================================================================

fn stage_verifier_gate(a: mut_view<Arena>) -> i32 {
    let b_ok = x64_mi_body_new(mut_view(*a), 1);
    let mbb_ok = unsafe { x64_mi_bb_at((*b_ok).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_SHL, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_IDIV, x64_op_reg(REG_RDX), x64_op_none());
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_RET, x64_op_none(), x64_op_none());
    }
    let lay_ok = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_ok) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_ok) }, view(lay_ok)) != X64_VERIFY_OK {
        return 401;
    }

    unsafe { (*b_ok).shadow_space = 16u32; }
    if x64_verify_checked(unsafe { view(*b_ok) }, view(lay_ok)) != X64_VERIFY_ERR_SHADOW_SPACE {
        return 402;
    }
    unsafe { (*b_ok).shadow_space = 32u32; }

    let lay_mis = X64FrameLayout { slot_offsets: lay_ok.slot_offsets, slot_count: 1u32, frame_size: 48u32 };
    if x64_verify_checked(unsafe { view(*b_ok) }, view(lay_mis)) != X64_VERIFY_ERR_ALIGNMENT {
        return 403;
    }

    unsafe { (*b_ok).shadow_space = 72u32; }
    let lay_small = X64FrameLayout { slot_offsets: lay_ok.slot_offsets, slot_count: 1u32, frame_size: 40u32 };
    if x64_verify_checked(unsafe { view(*b_ok) }, view(lay_small)) != X64_VERIFY_ERR_FRAME_SIZE {
        return 404;
    }

    let b_mm = x64_mi_body_new(mut_view(*a), 1);
    let mbb_mm = unsafe { x64_mi_bb_at((*b_mm).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_mm), mut_view(*mbb_mm), X64_MI_MOV, x64_op_frame(0u32, 0), x64_op_frame(1u32, 0));
    }
    let lay_mm = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_mm) }, 2u32);
    if x64_verify_checked(unsafe { view(*b_mm) }, view(lay_mm)) != X64_VERIFY_ERR_MEM_MEM {
        return 405;
    }

    let b_of = x64_mi_body_new(mut_view(*a), 1);
    let mbb_of = unsafe { x64_mi_bb_at((*b_of).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_of), mut_view(*mbb_of), X64_MI_ADD, x64_op_imm(1i64), x64_op_reg(REG_RAX));
    }
    let lay_of = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_of) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_of) }, view(lay_of)) != X64_VERIFY_ERR_OPERAND_FORM {
        return 406;
    }

    let b_im = x64_mi_body_new(mut_view(*a), 1);
    let mbb_im = unsafe { x64_mi_bb_at((*b_im).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_im), mut_view(*mbb_im), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_imm(3i64));
    }
    let lay_im = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_im) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_im) }, view(lay_im)) != X64_VERIFY_ERR_IMUL_FORM {
        return 407;
    }

    let b_lea = x64_mi_body_new(mut_view(*a), 1);
    let mbb_lea = unsafe { x64_mi_bb_at((*b_lea).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_lea), mut_view(*mbb_lea), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
    }
    let lay_lea = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_lea) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_lea) }, view(lay_lea)) != X64_VERIFY_ERR_LEA_FORM {
        return 408;
    }

    let b_shc = x64_mi_body_new(mut_view(*a), 1);
    let mbb_shc = unsafe { x64_mi_bb_at((*b_shc).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_shc), mut_view(*mbb_shc), X64_MI_SHL, x64_op_reg(REG_RAX), x64_op_reg(REG_RBX));
    }
    let lay_shc = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_shc) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_shc) }, view(lay_shc)) != X64_VERIFY_ERR_SHIFT_REG_CLASS {
        return 409;
    }

    let b_shf = x64_mi_body_new(mut_view(*a), 1);
    let mbb_shf = unsafe { x64_mi_bb_at((*b_shf).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_shf), mut_view(*mbb_shf), X64_MI_SHR, x64_op_imm(1i64), x64_op_reg(REG_RCX));
    }
    let lay_shf = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_shf) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_shf) }, view(lay_shf)) != X64_VERIFY_ERR_SHIFT_FORM {
        return 410;
    }

    let b_idiv = x64_mi_body_new(mut_view(*a), 1);
    let mbb_idiv = unsafe { x64_mi_bb_at((*b_idiv).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_idiv), mut_view(*mbb_idiv), X64_MI_IDIV, x64_op_imm(2i64), x64_op_none());
    }
    let lay_idiv = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_idiv) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_idiv) }, view(lay_idiv)) != X64_VERIFY_ERR_IDIV_FORM {
        return 411;
    }

    arena_reset(mut_view(*a));
    0
}

pub fn main() -> i32 {
    let mut perm = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(perm), 16, 8);
    let mut a = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);

    let ti_ptr = arena_alloc_raw(mut_view(perm), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe { type_interner_init(mut_view(*ti_ptr)); }

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm), 32768, 1);
    out.cap = 32768;

    let rc1 = stage_regalloc_pressure(mut_view(a), ti_ptr);
    if rc1 != 0 {
        return rc1;
    }
    print("E15_8_STAGE_REGALLOC_PRESSURE=OK\n");

    let rc2 = stage_isel_ifconv(mut_view(a), ti_ptr);
    if rc2 != 0 {
        return rc2;
    }
    print("E15_8_STAGE_ISEL_IFCONV=OK\n");

    let rc3 = stage_postra_peephole_ir(mut_view(a), ti_ptr, mut_view(out));
    if rc3 != 0 {
        return rc3;
    }
    print("E15_8_STAGE_POSTRA_PEEPHOLE_IR=OK\n");

    let rc4 = stage_verifier_gate(mut_view(a));
    if rc4 != 0 {
        return rc4;
    }
    print("E15_8_STAGE_VERIFIER_GATE=OK\n");

    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_destroy(mut_view(a));
    arena_destroy(mut_view(perm));
    print("E15_8_PROBE_ALL=OK\n");
    0
}
