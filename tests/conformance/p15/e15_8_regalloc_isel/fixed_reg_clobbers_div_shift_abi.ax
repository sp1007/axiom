// test: diff
// flags: --verify-each
// stdout: FIXED_DIV_SHIFT=645\nPARALLEL_COPY=2460\nSUBWORD_DIV=7336\nFIXED_TOTAL=10441\n

// E15.8 Conformance (SPEC-77, REQ-OPT-371, REQ-OPT-372, AXS-RA-022..024):
// Fixed-register precoloring and clobber eviction for RDX:RAX (signed/unsigned div/rem)
// and RCX/CL (variable shl/shr/sar) interleaved with live Win64 ABI registers
// (RCX, RDX, R8, R9, RAX), parallel-copy cycle breaking via scratch R11, and
// sub-word i8/u8/i16/u32 signed vs unsigned division/remainder semantics.

fn ret_in_rax(a: i64, b: i64, c: i64, d: i64) -> i64 {
    a * 2 + b * 3 + c - d
}

fn get_shift_in_rax(amt: u32) -> u32 {
    amt
}

fn interleaved_div_rem_shift(a: i64, b: i64, c: i64, d: i64) -> i64 {
    // `a` in RCX, `b` in RDX, `c` in R8, `d` in R9; `rax_live` returned in RAX.
    let rax_live: i64 = ret_in_rax(a, b, c, d);

    // Variable signed div/rem clobbering RDX:RAX while a, b, c, d, rax_live stay live.
    let q_s: i64 = a / b;
    let r_s: i64 = a % b;

    // Variable unsigned u64 div/rem on high-bit value (>= 2^63) clobbering RDX:RAX.
    let big_u: u64 = 0x8000_0000_0000_0019u64;
    let div_u: u64 = (d as u64) + 3u64;
    let q_u_hi: u64 = big_u / div_u;
    let r_u_hi: u64 = big_u % div_u;
    let q_u2: u64 = (c as u64) / (d as u64);
    let r_u2: u64 = (c as u64) % (d as u64);

    // Variable shifts where shift count arrives in RAX and must move into CL (RCX)
    // without clobbering live `a` (originally RCX) or `rax_live`.
    let sh_amt1: u32 = get_shift_in_rax(3u32);
    let sh_l: i64 = rax_live << sh_amt1;

    let sh_amt2: u32 = (d - 11) as u32;
    let sh_sar: i64 = a >> sh_amt2;

    let sh_amt3: u32 = get_shift_in_rax(60u32);
    let sh_shr_hi: i64 = (0xF000_0000_0000_0000u64 >> sh_amt3) as i64;

    let sh_amt0: u32 = get_shift_in_rax(0u32);
    let sh_zero: i64 = (c << sh_amt0) - c;

    let orig_sum: i64 = a + b + c + d + rax_live;
    let sdiv_sum: i64 = q_s + r_s;
    let udiv_sum: i64 = ((q_u_hi >> 56u32) as i64) +
        ((q_u_hi & 0xFFu64) as i64) +
        (r_u_hi as i64) +
        (q_u2 as i64) +
        (r_u2 as i64);
    let shift_sum: i64 = sh_l + sh_sar + sh_shr_hi + sh_zero;

    orig_sum + sdiv_sum + udiv_sum + shift_sum
}

fn weighted4(p0: i64, p1: i64, p2: i64, p3: i64) -> i64 {
    p0 + p1 * 2 + p2 * 3 + p3 * 4
}

fn parallel_copy_abi_cycles(x0: i64, x1: i64, x2: i64, x3: i64, rounds: i64) -> i64 {
    let mut p0: i64 = x0;
    let mut p1: i64 = x1;
    let mut p2: i64 = x2;
    let mut p3: i64 = x3;
    let mut acc: i64 = 0;
    let mut i: i64 = 0;

    while i < rounds {
        // 4-cycle on (RCX, RDX, R8, R9) <- (RDX, R8, R9, RCX)
        let w_rot: i64 = weighted4(p1, p2, p3, p0);
        // Paired 2-cycles (RCX <-> R9) and (RDX <-> R8)
        let w_rev: i64 = weighted4(p3, p2, p1, p0);
        acc = acc + w_rot + w_rev;

        // Loop-carried 4-cycle permutation across backedge
        let t0: i64 = p0;
        p0 = p1 + 1;
        p1 = p2 + 1;
        p2 = p3 + 1;
        p3 = t0 + 1;
        i = i + 1;
    }

    acc + weighted4(p0, p1, p2, p3)
}

fn subword_div_rem_shifts(
    s8: i8,
    d8: i8,
    u8v: u8,
    u8d: u8,
    s16: i16,
    d16: i16,
    u32v: u32,
    u32d: u32
) -> i64 {
    let q8: i64 = (s8 / d8) as i64;
    let r8: i64 = (s8 % d8) as i64;
    let qu8: i64 = (u8v / u8d) as i64;
    let ru8: i64 = (u8v % u8d) as i64;
    let q16: i64 = (s16 / d16) as i64;
    let r16: i64 = (s16 % d16) as i64;
    let qu32: i64 = (u32v / u32d) as i64;
    let ru32: i64 = (u32v % u32d) as i64;
    q8 + r8 + qu8 + ru8 + q16 + r16 + qu32 + ru32
}

fn main() -> i32 {
    let fds: i64 = interleaved_div_rem_shift(-103, 7, 250, 13);
    print("FIXED_DIV_SHIFT=");
    print_int(fds as i32);
    print("\n");

    let pcopy: i64 = parallel_copy_abi_cycles(10, 20, 30, 40, 4);
    print("PARALLEL_COPY=");
    print_int(pcopy as i32);
    print("\n");

    let sdiv: i64 = subword_div_rem_shifts(
        -100i8,
        7i8,
        250u8,
        13u8,
        -30000i16,
        -9i16,
        4000000000u32,
        1000000u32
    );
    print("SUBWORD_DIV=");
    print_int(sdiv as i32);
    print("\n");

    let total: i64 = fds + pcopy + sdiv;
    print("FIXED_TOTAL=");
    print_int(total as i32);
    print("\n");

    if fds != 645 || pcopy != 2460 || sdiv != 7336 || total != 10441 {
        return 1;
    }
    0
}
