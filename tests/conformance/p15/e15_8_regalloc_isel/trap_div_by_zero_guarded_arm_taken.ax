// test: diff
// flags: --verify-each
// exit: 101

// E15.8 Conformance (SPEC-77 AXS-MCOPT-013, REQ-OPT-371):
// When a diamond's trapping division arm IS dynamically selected (`take_div == true`
// and `den == 0`), execution MUST trap deterministically with `exit: 101`.

fn opaque_bool(b: bool) -> bool {
    b
}

fn opaque_i64(v: i64) -> i64 {
    v
}

fn cond_div(take_div: bool, num: i64, den: i64) -> i64 {
    if take_div {
        num / den
    } else {
        42
    }
}

fn main() -> i32 {
    let r: i64 = cond_div(opaque_bool(true), opaque_i64(100), opaque_i64(0));
    (r & 1) as i32
}
