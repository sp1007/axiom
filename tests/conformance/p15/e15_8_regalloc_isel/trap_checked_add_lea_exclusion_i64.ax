// test: diff
// flags: --verify-each
// exit: 101

// E15.8 Conformance (SPEC-77 AXS-MCOPT-010 §3, REQ-OPT-371):
// Checked `a + b * 4 + 8` overflowing `i64.MAX` MUST preserve the signed overflow
// trap (`exit: 101`) and never be silently folded into flagless `lea`.

fn opaque_i64(v: i64) -> i64 {
    v
}

fn checked_scaled_add(a: i64, b: i64) -> i64 {
    (a + b * 4) + 8
}

fn main() -> i32 {
    let near_max: i64 = opaque_i64(9223372036854775800i64);
    let idx: i64 = opaque_i64(2);
    let r: i64 = checked_scaled_add(near_max, idx);
    (r & 1) as i32
}
