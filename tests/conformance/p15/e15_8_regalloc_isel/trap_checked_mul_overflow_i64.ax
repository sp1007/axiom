// test: diff
// flags: --verify-each
// exit: 101

// E15.8 Conformance (SPEC-77 AXS-MCOPT-010 §3, REQ-OPT-371):
// Checked `x * 9` overflowing `i64` MUST trap (`exit: 101`) even though `* 9` is
// a 3-component `lea [r + r*8]` strength-reduction target for wrapping multiply.

fn opaque_i64(v: i64) -> i64 {
    v
}

fn checked_mul9_under_pressure(x: i64, seed: i64) -> i64 {
    let l0: i64 = seed + 1;
    let l1: i64 = seed + 2;
    let l2: i64 = seed + 3;
    let l3: i64 = seed + 4;
    let prod: i64 = x * 9;
    prod + l0 + l1 + l2 + l3
}

fn main() -> i32 {
    let big: i64 = opaque_i64(2000000000000000000i64);
    let r: i64 = checked_mul9_under_pressure(big, opaque_i64(3));
    (r & 1) as i32
}
