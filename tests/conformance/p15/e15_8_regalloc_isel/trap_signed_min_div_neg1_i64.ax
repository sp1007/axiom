// test: diff
// flags: --verify-each
// exit: 101

// E15.8 Conformance (SPEC-77 AXS-RA-022, AXS-MCOPT-012, REQ-OPT-371):
// Runtime signed `i64.MIN / -1` under live RDX:RAX / GPR pressure MUST trap
// deterministically with `exit: 101` across `--interp`, `-O0`, `-O1`, and `-O2`.

fn opaque_i64(v: i64) -> i64 {
    v
}

fn div_under_live_regs(num: i64, den: i64, extra: i64) -> i64 {
    let keep_a: i64 = extra + 11;
    let keep_b: i64 = extra + 22;
    let q: i64 = num / den;
    q + keep_a + keep_b
}

fn main() -> i32 {
    let min64: i64 = opaque_i64((-9223372036854775807i64) - 1i64);
    let neg1: i64 = opaque_i64(-1);
    let r: i64 = div_under_live_regs(min64, neg1, opaque_i64(5));
    (r & 1) as i32
}
