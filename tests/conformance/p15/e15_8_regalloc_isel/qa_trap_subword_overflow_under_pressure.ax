// test: diff
// flags: --verify-each
// exit: 101

// E15.8 Adversarial QA Trap Conformance (SPEC-77 AXS-MCOPT-013, AXS-MCOPT-021, REQ-OPT-371):
// Sub-word `i16` signed overflow (`30000i16 + 5000i16`) fed by a branchless `cmovcc`
// selection while 20 `i64` locals remain live across a helper call and a zero constant
// sits adjacent MUST preserve 16-bit `OF` (`exit: 101`) across `--interp`, `-O0`, and `-O2`.

fn qa_opaque_i16(v: i16) -> i16 {
    v
}

fn qa_opaque_i64(v: i64) -> i64 {
    v
}

fn qa_overflow_i16_under_pressure(seed: i64, cond: i64, base16: i16) -> i64 {
    let p0: i64 = seed + 1;
    let p1: i64 = seed + 2;
    let p2: i64 = seed + 3;
    let p3: i64 = seed + 4;
    let p4: i64 = seed + 5;
    let p5: i64 = seed + 6;
    let p6: i64 = seed + 7;
    let p7: i64 = seed + 8;
    let p8: i64 = seed + 9;
    let p9: i64 = seed + 10;
    let p10: i64 = seed + 11;
    let p11: i64 = seed + 12;
    let p12: i64 = seed + 13;
    let p13: i64 = seed + 14;
    let p14: i64 = seed + 15;
    let p15: i64 = seed + 16;
    let p16: i64 = seed + 17;
    let p17: i64 = seed + 18;
    let p18: i64 = seed + 19;
    let p19: i64 = seed + 20;

    let c: i64 = qa_opaque_i64(cond);
    let delta: i16 = if c > 0 { 5000i16 } else { 10i16 };
    let z: i64 = 0;
    let sum16: i16 = base16 + delta;

    (sum16 as i64) + z + p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 +
        p10 + p11 + p12 + p13 + p14 + p15 + p16 + p17 + p18 + p19
}

fn main() -> i32 {
    let r: i64 = qa_overflow_i16_under_pressure(
        qa_opaque_i64(2),
        qa_opaque_i64(1),
        qa_opaque_i16(30000i16)
    );
    (r & 1) as i32
}
