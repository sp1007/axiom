// test: diff
// flags: --verify-each
// stdout: RA_PRESSURE_36=9644\nRA_SPILL_COLOR=5536\nRA_CALLEE_SAVED=2551\nRA_TOTAL=17731\n

// E15.8 Conformance (SPEC-77, REQ-OPT-371, REQ-OPT-372, AXS-RA-020..027):
// Extreme GPR register pressure (> 32 simultaneous live locals across 3-level nested
// loops, conditional diamonds, and 10-argument Win64 calls with outgoing stack args),
// disjoint-lifetime spill-slot coloring, strict isolation of spill slots from
// address-taken source stack locals, and 3-level callee-saved GPR preservation.

fn leaf_bump(x: i64) -> i64 {
    x * 3 + 7
}

fn mix8_stack_abi(
    anc: mut_view<i64>,
    arr: view<[4]i64>,
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    a4: i64,
    a5: i64,
    a6: i64,
    a7: i64
) -> i64 {
    *anc = *anc + 2;
    let pin_sum: i64 = (*arr)[0] + (*arr)[1] + (*arr)[2] + (*arr)[3];
    let pos: i64 = a0 + a4 * 2 + a5 * 3 + a6 * 4 + a7 * 5;
    let neg: i64 = a1 + a2 * 2 + a3 * 3;
    (pos - neg) + (pin_sum - 1010)
}

fn extreme_gpr_pressure_36_locals(seed: i64) -> i64 {
    let pinned: [4]i64 = [101, 202, 303, 404];
    let mut anchor: i64 = 777;

    let mut v0: i64 = seed + 1;
    let mut v1: i64 = seed + 2;
    let mut v2: i64 = seed + 3;
    let mut v3: i64 = seed + 4;
    let mut v4: i64 = seed + 5;
    let mut v5: i64 = seed + 6;
    let mut v6: i64 = seed + 7;
    let mut v7: i64 = seed + 8;
    let mut v8: i64 = seed + 9;
    let mut v9: i64 = seed + 10;
    let mut v10: i64 = seed + 11;
    let mut v11: i64 = seed + 12;
    let mut v12: i64 = seed + 13;
    let mut v13: i64 = seed + 14;
    let mut v14: i64 = seed + 15;
    let mut v15: i64 = seed + 16;
    let mut v16: i64 = seed + 17;
    let mut v17: i64 = seed + 18;
    let mut v18: i64 = seed + 19;
    let mut v19: i64 = seed + 20;
    let mut v20: i64 = seed + 21;
    let mut v21: i64 = seed + 22;
    let mut v22: i64 = seed + 23;
    let mut v23: i64 = seed + 24;
    let mut v24: i64 = seed + 25;
    let mut v25: i64 = seed + 26;
    let mut v26: i64 = seed + 27;
    let mut v27: i64 = seed + 28;
    let mut v28: i64 = seed + 29;
    let mut v29: i64 = seed + 30;
    let mut v30: i64 = seed + 31;
    let mut v31: i64 = seed + 32;
    let mut v32: i64 = seed + 33;
    let mut v33: i64 = seed + 34;
    let mut v34: i64 = seed + 35;
    let mut v35: i64 = seed + 36;

    let mut call_acc: i64 = 0;
    let mut outer: i64 = 0;
    while outer < 2 {
        let mut mid: i64 = 0;
        while mid < 2 {
            let mut inner: i64 = 0;
            while inner < 3 {
                let m: i64 = mix8_stack_abi(
                    mut_view(anchor),
                    view(pinned),
                    v0,
                    v5,
                    v10,
                    v15,
                    v20,
                    v25,
                    v30,
                    v35
                );
                call_acc = call_acc + m;

                if ((outer + mid + inner) & 1) == 0 {
                    v0 = v0 + 1;
                    v1 = v1 + 1;
                    v2 = v2 + 1;
                    v3 = v3 + 1;
                    v4 = v4 + 1;
                    v5 = v5 + 1;
                    v6 = v6 + 1;
                    v7 = v7 + 1;
                    v8 = v8 + 1;
                    v9 = v9 + 1;
                    v10 = v10 + 1;
                    v11 = v11 + 1;
                    v12 = v12 + 1;
                    v13 = v13 + 1;
                    v14 = v14 + 1;
                    v15 = v15 + 1;
                    v16 = v16 + 1;
                    v17 = v17 + 1;
                    v18 = v18 + 1;
                    v19 = v19 + 1;
                    v20 = v20 + 1;
                    v21 = v21 + 1;
                    v22 = v22 + 1;
                    v23 = v23 + 1;
                    v24 = v24 + 1;
                    v25 = v25 + 1;
                    v26 = v26 + 1;
                    v27 = v27 + 1;
                    v28 = v28 + 1;
                    v29 = v29 + 1;
                    v30 = v30 + 1;
                    v31 = v31 + 1;
                    v32 = v32 + 1;
                    v33 = v33 + 1;
                    v34 = v34 + 1;
                    v35 = v35 + 1;
                } else {
                    v0 = v0 + 2;
                    v1 = v1 + 2;
                    v2 = v2 + 2;
                    v3 = v3 + 2;
                    v4 = v4 + 2;
                    v5 = v5 + 2;
                    v6 = v6 + 2;
                    v7 = v7 + 2;
                    v8 = v8 + 2;
                    v9 = v9 + 2;
                    v10 = v10 + 2;
                    v11 = v11 + 2;
                    v12 = v12 + 2;
                    v13 = v13 + 2;
                    v14 = v14 + 2;
                    v15 = v15 + 2;
                    v16 = v16 + 2;
                    v17 = v17 + 2;
                    v18 = v18 + 2;
                    v19 = v19 + 2;
                    v20 = v20 + 2;
                    v21 = v21 + 2;
                    v22 = v22 + 2;
                    v23 = v23 + 2;
                    v24 = v24 + 2;
                    v25 = v25 + 2;
                    v26 = v26 + 2;
                    v27 = v27 + 2;
                    v28 = v28 + 2;
                    v29 = v29 + 2;
                    v30 = v30 + 2;
                    v31 = v31 + 2;
                    v32 = v32 + 2;
                    v33 = v33 + 2;
                    v34 = v34 + 2;
                    v35 = v35 + 2;
                }
                inner = inner + 1;
            }
            mid = mid + 1;
        }
        outer = outer + 1;
    }

    let sum_lo: i64 = v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 +
        v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17;
    let sum_hi: i64 = v18 + v19 + v20 + v21 + v22 + v23 + v24 + v25 + v26 + v27 +
        v28 + v29 + v30 + v31 + v32 + v33 + v34 + v35;
    let pin_after: i64 = pinned[0] + pinned[1] + pinned[2] + pinned[3];
    call_acc + sum_lo + sum_hi + anchor + pin_after
}

fn clobber_regs_helper(x: i64) -> i64 {
    let c0: i64 = x + 1;
    let c1: i64 = x + 2;
    let c2: i64 = x + 3;
    let c3: i64 = x + 4;
    let c4: i64 = x + 5;
    let c5: i64 = x + 6;
    let c6: i64 = x + 7;
    let c7: i64 = x + 8;
    let c8: i64 = x + 9;
    let c9: i64 = x + 10;
    let c10: i64 = x + 11;
    let c11: i64 = x + 12;
    let c12: i64 = x + 13;
    let c13: i64 = x + 14;
    let c14: i64 = x + 15;
    let c15: i64 = x + 16;
    let b: i64 = leaf_bump(x);
    c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + b
}

fn disjoint_phase_spill_coloring(seed: i64) -> i64 {
    let guard_slot: i64 = 4321;
    let gp: view<i64> = view(guard_slot);

    // Phase A: 20 simultaneous live locals across a clobbering call, then all die.
    let a0: i64 = seed + 1;
    let a1: i64 = seed + 2;
    let a2: i64 = seed + 3;
    let a3: i64 = seed + 4;
    let a4: i64 = seed + 5;
    let a5: i64 = seed + 6;
    let a6: i64 = seed + 7;
    let a7: i64 = seed + 8;
    let a8: i64 = seed + 9;
    let a9: i64 = seed + 10;
    let a10: i64 = seed + 11;
    let a11: i64 = seed + 12;
    let a12: i64 = seed + 13;
    let a13: i64 = seed + 14;
    let a14: i64 = seed + 15;
    let a15: i64 = seed + 16;
    let a16: i64 = seed + 17;
    let a17: i64 = seed + 18;
    let a18: i64 = seed + 19;
    let a19: i64 = seed + 20;
    let ca: i64 = clobber_regs_helper(seed);
    let sum_a: i64 = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 +
        a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + ca;

    // Phase B: 20 fresh live locals reusing colored spill slots after Phase A dies.
    let base_b: i64 = seed * 2;
    let b0: i64 = base_b + 1;
    let b1: i64 = base_b + 2;
    let b2: i64 = base_b + 3;
    let b3: i64 = base_b + 4;
    let b4: i64 = base_b + 5;
    let b5: i64 = base_b + 6;
    let b6: i64 = base_b + 7;
    let b7: i64 = base_b + 8;
    let b8: i64 = base_b + 9;
    let b9: i64 = base_b + 10;
    let b10: i64 = base_b + 11;
    let b11: i64 = base_b + 12;
    let b12: i64 = base_b + 13;
    let b13: i64 = base_b + 14;
    let b14: i64 = base_b + 15;
    let b15: i64 = base_b + 16;
    let b16: i64 = base_b + 17;
    let b17: i64 = base_b + 18;
    let b18: i64 = base_b + 19;
    let b19: i64 = base_b + 20;
    let cb: i64 = clobber_regs_helper(seed + 1);
    let sum_b: i64 = b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 +
        b10 + b11 + b12 + b13 + b14 + b15 + b16 + b17 + b18 + b19 + cb;

    sum_a + sum_b + *gp
}

fn level3_saved(z: i64) -> i64 {
    let t0: i64 = z + 1;
    let t1: i64 = z + 2;
    let t2: i64 = z + 3;
    let t3: i64 = z + 4;
    let t4: i64 = z + 5;
    let t5: i64 = z + 6;
    let t6: i64 = z + 7;
    let t7: i64 = z + 8;
    let t8: i64 = z + 9;
    let t9: i64 = z + 10;
    let t10: i64 = z + 11;
    let t11: i64 = z + 12;
    let t12: i64 = z + 13;
    let t13: i64 = z + 14;
    let t14: i64 = z + 15;
    let t15: i64 = z + 16;
    let t16: i64 = z + 17;
    let t17: i64 = z + 18;
    let lb: i64 = leaf_bump(z);
    t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 +
        t10 + t11 + t12 + t13 + t14 + t15 + t16 + t17 + lb
}

fn level2_saved(y: i64) -> i64 {
    let m0: i64 = y + 1;
    let m1: i64 = y + 2;
    let m2: i64 = y + 3;
    let m3: i64 = y + 4;
    let m4: i64 = y + 5;
    let m5: i64 = y + 6;
    let m6: i64 = y + 7;
    let m7: i64 = y + 8;
    let m8: i64 = y + 9;
    let m9: i64 = y + 10;
    let m10: i64 = y + 11;
    let m11: i64 = y + 12;
    let m12: i64 = y + 13;
    let m13: i64 = y + 14;
    let m14: i64 = y + 15;
    let m15: i64 = y + 16;
    let m16: i64 = y + 17;
    let m17: i64 = y + 18;
    let r1: i64 = level3_saved(y + 3);
    let r2: i64 = level3_saved(y + 4);
    m0 + m1 + m2 + m3 + m4 + m5 + m6 + m7 + m8 + m9 +
        m10 + m11 + m12 + m13 + m14 + m15 + m16 + m17 + r1 + r2
}

fn level1_saved(x: i64) -> i64 {
    let s0: i64 = x + 1;
    let s1: i64 = x + 2;
    let s2: i64 = x + 3;
    let s3: i64 = x + 4;
    let s4: i64 = x + 5;
    let s5: i64 = x + 6;
    let s6: i64 = x + 7;
    let s7: i64 = x + 8;
    let s8: i64 = x + 9;
    let s9: i64 = x + 10;
    let s10: i64 = x + 11;
    let s11: i64 = x + 12;
    let s12: i64 = x + 13;
    let s13: i64 = x + 14;
    let s14: i64 = x + 15;
    let s15: i64 = x + 16;
    let s16: i64 = x + 17;
    let s17: i64 = x + 18;
    let q1: i64 = level2_saved(x + 3);
    let q2: i64 = level2_saved(x + 5);
    s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 +
        s10 + s11 + s12 + s13 + s14 + s15 + s16 + s17 + q1 + q2
}

fn main() -> i32 {
    let p36: i64 = extreme_gpr_pressure_36_locals(10);
    print("RA_PRESSURE_36=");
    print_int(p36 as i32);
    print("\n");

    let scolor: i64 = disjoint_phase_spill_coloring(5);
    print("RA_SPILL_COLOR=");
    print_int(scolor as i32);
    print("\n");

    let csaved: i64 = level1_saved(4);
    print("RA_CALLEE_SAVED=");
    print_int(csaved as i32);
    print("\n");

    let total: i64 = p36 + scolor + csaved;
    print("RA_TOTAL=");
    print_int(total as i32);
    print("\n");

    if p36 != 9644 || scolor != 5536 || csaved != 2551 || total != 17731 {
        return 1;
    }
    0
}
