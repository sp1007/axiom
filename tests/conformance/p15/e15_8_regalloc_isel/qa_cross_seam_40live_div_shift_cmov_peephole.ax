// test: diff
// flags: --verify-each
// stdout: QA_UTF8=Xin chào thế giới\nQA_DROP=2\nQA_DROP=1\nQA_CROSS_ACC=6489\nQA_CALL_CELL=518\nQA_LIVE40_SUM=1580\nQA_TOTAL=8697\nQA_DROP=0\n

// E15.8 Adversarial QA Cross-Seam Conformance (SPEC-77, REQ-OPT-371, REQ-OPT-372):
// Simultaneously exercises in a single nested-loop kernel:
//   1. 40 simultaneous live `i64` locals (`l0..l39`) across 2-level nested loops (`d = 2`)
//   2. 9-argument Win64 ABI call with outgoing stack args + `mut_view` stack-slot mutation
//   3. Runtime signed & high-bit unsigned `div`/`rem` (`RDX:RAX` clobbers under spill pressure)
//   4. Runtime variable shifts (`<<`, `>>` arithmetic & logical, `sh == 0..3` in `RCX`/`CL`)
//   5. Branchless `cmovcc` zero-selection & `{1, 0}` `setcc` diamonds + non-speculated `idiv` arm
//   6. Scaled-index `lea` (`base + index*8 - 12`), constant `* 9` / `/ 7` / `% 7`, raw-pointer
//      alias barrier, deterministic `Drop` reverse order, and UTF-8 `"Xin chào thế giới"`.

@intrinsic fn wrapping_add_i64(a: i64, b: i64) -> i64 { 0i64 }
@intrinsic fn wrapping_mul_i64(a: i64, b: i64) -> i64 { 0i64 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct QaScopeGuard {
    id: i32,
}

impl Drop for QaScopeGuard {
    fn drop(self: mut_view<QaScopeGuard>) {
        print("QA_DROP=");
        print_int(self.id);
        print("\n");
    }
}

fn qa_abi9_step(
    cell: mut_view<i64>,
    arr: view<[4]i64>,
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    a4: i64,
    a5: i64,
    a6: i64
) -> i64 {
    *cell = *cell + 3;
    let pin_sum: i64 = (*arr)[0] + (*arr)[1] + (*arr)[2] + (*arr)[3];
    let pos: i64 = a0 + a3 * 2 + a4 * 3 + a5 * 4 + a6 * 5;
    let neg: i64 = a1 + a2 * 2;
    (pos - neg) + (pin_sum - 110)
}

fn qa_cross_seam_kernel(seed: i64) -> i64 {
    print("QA_UTF8=Xin chào thế giới\n");
    let g0 = QaScopeGuard { id: 0 };
    {
        let g1 = QaScopeGuard { id: 1 };
        let g2 = QaScopeGuard { id: 2 };
        let _ = g1.id + g2.id;
    }

    let pin_arr: [4]i64 = [11, 22, 33, 44];
    let mut call_cell: i64 = 500;

    let mut l0: i64 = seed + 1;
    let mut l1: i64 = seed + 2;
    let mut l2: i64 = seed + 3;
    let mut l3: i64 = seed + 4;
    let mut l4: i64 = seed + 5;
    let mut l5: i64 = seed + 6;
    let mut l6: i64 = seed + 7;
    let mut l7: i64 = seed + 8;
    let mut l8: i64 = seed + 9;
    let mut l9: i64 = seed + 10;
    let mut l10: i64 = seed + 11;
    let mut l11: i64 = seed + 12;
    let mut l12: i64 = seed + 13;
    let mut l13: i64 = seed + 14;
    let mut l14: i64 = seed + 15;
    let mut l15: i64 = seed + 16;
    let mut l16: i64 = seed + 17;
    let mut l17: i64 = seed + 18;
    let mut l18: i64 = seed + 19;
    let mut l19: i64 = seed + 20;
    let mut l20: i64 = seed + 21;
    let mut l21: i64 = seed + 22;
    let mut l22: i64 = seed + 23;
    let mut l23: i64 = seed + 24;
    let mut l24: i64 = seed + 25;
    let mut l25: i64 = seed + 26;
    let mut l26: i64 = seed + 27;
    let mut l27: i64 = seed + 28;
    let mut l28: i64 = seed + 29;
    let mut l29: i64 = seed + 30;
    let mut l30: i64 = seed + 31;
    let mut l31: i64 = seed + 32;
    let mut l32: i64 = seed + 33;
    let mut l33: i64 = seed + 34;
    let mut l34: i64 = seed + 35;
    let mut l35: i64 = seed + 36;
    let mut l36: i64 = seed + 37;
    let mut l37: i64 = seed + 38;
    let mut l38: i64 = seed + 39;
    let mut l39: i64 = seed + 40;

    let mut acc: i64 = 0;
    let mut outer: i64 = 0;
    while outer < 2 {
        let mut inner: i64 = 0;
        while inner < 3 {
            let c_ret: i64 = qa_abi9_step(
                mut_view(call_cell),
                view(pin_arr),
                l0,
                l6,
                l12,
                l18,
                l24,
                l30,
                l39
            );

            let den_s: i64 = if ((outer + inner) & 1) == 0 { -7 } else { 9 };
            let q_s: i64 = (l1 - l38) / den_s;
            let r_s: i64 = (l2 - l37) % den_s;

            let big_u: u64 = ((l3 & 0xFF) as u64) + 0x8000_0000_0000_0013u64;
            let den_u: u64 = (inner as u64) + 5u64;
            let q_u_lo: i64 = ((big_u / den_u) & 0xFFu64) as i64;
            let r_u: i64 = (big_u % den_u) as i64;

            let sh: u32 = ((outer + inner) & 3) as u32;
            let shifted_shl: i64 = l5 << sh;
            let cmov_z: i64 = if l4 < l35 { 0 } else { shifted_shl };
            let cmov_nz: i64 = if l4 < l35 { shifted_shl } else { 0 };
            let sar_v: i64 = (-64 - l13) >> sh;
            let shr_v: i64 = (((0x8000_0000_0000_00F0u64 >> sh) >> 56u32) & 0xFFu64) as i64;
            let set_u: i64 = if (l7 as u64) >= (l33 as u64) { 1 } else { 0 };
            let set_u2: i64 = if (l33 as u64) >= (l7 as u64) { 1 } else { 0 };

            let maybe_zero: i64 = inner - 1;
            let guard_q: i64 = if maybe_zero != 0 { l8 / maybe_zero } else { 91 };

            let lea_v: i64 = wrapping_add_i64(
                wrapping_add_i64(l9, wrapping_mul_i64(l10, 8)),
                -12
            );
            let cmul_cdiv: i64 = (l11 * 9) / 7 + (l11 % 7);

            let mut alias_cell: i64 = 1;
            unsafe {
                let p: *mut i64 = address_of_mut(alias_cell);
                alias_cell = 13;
                *p = alias_cell + 29;
            }
            let alias_after: i64 = alias_cell;

            acc = acc + c_ret + q_s + r_s + q_u_lo + r_u + cmov_z + cmov_nz +
                sar_v + shr_v + set_u + set_u2 + guard_q + lea_v + cmul_cdiv + alias_after;

            if ((outer + inner) & 1) == 0 {
                l0 = l0 + 1; l1 = l1 + 1; l2 = l2 + 1; l3 = l3 + 1; l4 = l4 + 1;
                l5 = l5 + 1; l6 = l6 + 1; l7 = l7 + 1; l8 = l8 + 1; l9 = l9 + 1;
                l10 = l10 + 1; l11 = l11 + 1; l12 = l12 + 1; l13 = l13 + 1; l14 = l14 + 1;
                l15 = l15 + 1; l16 = l16 + 1; l17 = l17 + 1; l18 = l18 + 1; l19 = l19 + 1;
                l20 = l20 + 1; l21 = l21 + 1; l22 = l22 + 1; l23 = l23 + 1; l24 = l24 + 1;
                l25 = l25 + 1; l26 = l26 + 1; l27 = l27 + 1; l28 = l28 + 1; l29 = l29 + 1;
                l30 = l30 + 1; l31 = l31 + 1; l32 = l32 + 1; l33 = l33 + 1; l34 = l34 + 1;
                l35 = l35 + 1; l36 = l36 + 1; l37 = l37 + 1; l38 = l38 + 1; l39 = l39 + 1;
            } else {
                l0 = l0 + 2; l1 = l1 + 2; l2 = l2 + 2; l3 = l3 + 2; l4 = l4 + 2;
                l5 = l5 + 2; l6 = l6 + 2; l7 = l7 + 2; l8 = l8 + 2; l9 = l9 + 2;
                l10 = l10 + 2; l11 = l11 + 2; l12 = l12 + 2; l13 = l13 + 2; l14 = l14 + 2;
                l15 = l15 + 2; l16 = l16 + 2; l17 = l17 + 2; l18 = l18 + 2; l19 = l19 + 2;
                l20 = l20 + 2; l21 = l21 + 2; l22 = l22 + 2; l23 = l23 + 2; l24 = l24 + 2;
                l25 = l25 + 2; l26 = l26 + 2; l27 = l27 + 2; l28 = l28 + 2; l29 = l29 + 2;
                l30 = l30 + 2; l31 = l31 + 2; l32 = l32 + 2; l33 = l33 + 2; l34 = l34 + 2;
                l35 = l35 + 2; l36 = l36 + 2; l37 = l37 + 2; l38 = l38 + 2; l39 = l39 + 2;
            }

            inner = inner + 1;
        }
        outer = outer + 1;
    }

    let sum_lo: i64 = l0 + l1 + l2 + l3 + l4 + l5 + l6 + l7 + l8 + l9 +
        l10 + l11 + l12 + l13 + l14 + l15 + l16 + l17 + l18 + l19;
    let sum_hi: i64 = l20 + l21 + l22 + l23 + l24 + l25 + l26 + l27 + l28 + l29 +
        l30 + l31 + l32 + l33 + l34 + l35 + l36 + l37 + l38 + l39;
    let sum_all: i64 = sum_lo + sum_hi;
    let pin_total: i64 = pin_arr[0] + pin_arr[1] + pin_arr[2] + pin_arr[3];
    let total: i64 = acc + call_cell + sum_all + pin_total + (g0.id as i64);

    print("QA_CROSS_ACC=");
    print_int(acc as i32);
    print("\n");
    print("QA_CALL_CELL=");
    print_int(call_cell as i32);
    print("\n");
    print("QA_LIVE40_SUM=");
    print_int(sum_all as i32);
    print("\n");
    print("QA_TOTAL=");
    print_int(total as i32);
    print("\n");

    if acc != 6489 || call_cell != 518 || sum_all != 1580 || total != 8697 {
        return -1;
    }
    total
}

fn main() -> i32 {
    let t: i64 = qa_cross_seam_kernel(10);
    if t != 8697 {
        return 1;
    }
    0
}
