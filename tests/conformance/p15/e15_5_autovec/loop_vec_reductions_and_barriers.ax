// test: diff
// exit: 0
// stdout-file: loop_vec_reductions_and_barriers.stdout

@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { 0 }

fn reduce_wrapping_add(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < len(s) {
        acc = wrapping_add_i32(acc, s[i]);
        i = i + 1;
    }
    acc
}

fn reduce_wrapping_mul(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 1;
    while i < len(s) {
        acc = wrapping_mul_i32(acc, s[i]);
        i = i + 1;
    }
    acc
}

fn reduce_bit_xor(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < len(s) {
        acc = acc ^ s[i];
        i = i + 1;
    }
    acc
}

fn reduce_bit_or(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < len(s) {
        acc = acc | s[i];
        i = i + 1;
    }
    acc
}

fn reduce_bit_and(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 63;
    while i < len(s) {
        acc = acc & s[i];
        i = i + 1;
    }
    acc
}

fn reduce_min_max(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut lo: i32 = 1000;
    let mut hi: i32 = -1000;
    while i < len(s) {
        let v: i32 = s[i];
        lo = if v < lo { v } else { lo };
        hi = if v > hi { v } else { hi };
        i = i + 1;
    }
    lo + hi
}

fn recurrence_distance_one() -> i32 {
    let mut a: [7]i32 = [1, 0, 0, 0, 0, 0, 0];
    let mut i: usize = 0;
    while i < 6 {
        let prev: i32 = a[i];
        a[i + 1] = prev * 2 + 1;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < 7 {
        sum = sum + a[k];
        k = k + 1;
    }
    sum
}

fn recurrence_distance_two() -> i32 {
    let mut a: [9]i32 = [2, 5, 0, 0, 0, 0, 0, 0, 0];
    let mut i: usize = 0;
    while i < 7 {
        let prev2: i32 = a[i];
        a[i + 2] = prev2 + 3;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < 9 {
        sum = sum + a[k];
        k = k + 1;
    }
    sum
}

fn backward_anti_dependence() -> i32 {
    let mut b: [6]i32 = [0, 6, 7, 9, 11, 10];
    let mut i: usize = 0;
    while i < 5 {
        let next_val: i32 = b[i + 1];
        b[i] = next_val + 2;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < 6 {
        sum = sum + b[k];
        k = k + 1;
    }
    sum
}

fn overlapping_slice_recurrence(mv: mut_view<[i32]>) -> i32 {
    let mut i: usize = 0;
    while i + 1 < len(mv) {
        let cur: i32 = mv[i];
        mv[i + 1] = cur + 4;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < len(mv) {
        sum = sum + mv[k];
        k = k + 1;
    }
    sum
}

fn non_associative_div_rem_loop() -> i32 {
    let vals: [9]i32 = [144, 96, 72, 60, 48, 36, 24, 18, 12];
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 9 {
        acc = acc + (vals[i] / 6) + (vals[i] % 5);
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let add_arr: [13]i32 = [5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65];
    let mul_arr: [9]i32 = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    let xor_arr: [9]i32 = [3, 7, 12, 5, 9, 14, 3, 7, 29];
    let or_arr: [9]i32 = [1, 2, 4, 8, 16, 32, 3, 12, 48];
    let and_arr: [9]i32 = [63, 31, 15, 7, 3, 1, 62, 30, 14];
    let mm_arr: [11]i32 = [42, 17, 88, 5, 63, 92, 11, 29, 74, 8, 51];
    let mut buf: [8]i32 = [3, 0, 0, 0, 0, 0, 0, 0];

    print("WRAP_ADD=");
    print_int(reduce_wrapping_add(view(add_arr)));
    print("\nWRAP_MUL=");
    print_int(reduce_wrapping_mul(view(mul_arr)));
    print("\nBIT_XOR=");
    print_int(reduce_bit_xor(view(xor_arr)));
    print("\nBIT_OR=");
    print_int(reduce_bit_or(view(or_arr)));
    print("\nBIT_AND=");
    print_int(reduce_bit_and(view(and_arr)));
    print("\nMIN_MAX=");
    print_int(reduce_min_max(view(mm_arr)));
    print("\nRECUR_D1=");
    print_int(recurrence_distance_one());
    print("\nRECUR_D2=");
    print_int(recurrence_distance_two());
    print("\nBACK_ANTI=");
    print_int(backward_anti_dependence());
    print("\nOVERLAP_ALIAS=");
    print_int(overlapping_slice_recurrence(mut_view(buf)));
    print("\nDIV_REM_LOOP=");
    print_int(non_associative_div_rem_loop());
    print("\n");
    0
}
