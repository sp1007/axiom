// test: diff
// exit: 101
// stdout: 44\n

fn unguarded_epilogue_tail_must_trap(dst: mut_view<[i32]>, src: view<[i32]>, n: usize) -> i32 {
    print_int(src[0] + src[1] + 14);
    print("\n");
    let mut i: usize = 0;
    while i < n {
        dst[i] = src[i] + 1;
        i = i + 1;
    }
    dst[0]
}

fn main() -> i32 {
    let src_arr: [6]i32 = [10, 20, 30, 40, 50, 60];
    let mut dst_arr: [8]i32 = [0, 0, 0, 0, 0, 0, 0, 0];
    let v: i32 = unguarded_epilogue_tail_must_trap(mut_view(dst_arr), view(src_arr), 7);
    print_int(v);
    0
}
