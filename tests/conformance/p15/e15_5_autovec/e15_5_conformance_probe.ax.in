@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

struct ProbeTypes {
    thir: *mut Thir,
    ty_i32: u32,
    ty_usize: u32,
    ty_bool: u32,
    ty_f64: u32,
    ty_view_i32: u32,
    ty_mut_view_i32: u32,
    ty_ptr_i32: u32,
    ty_arr16_i32: u32,
    ty_arr16_f64: u32,
    ty_vec4_i32: u32,
}

fn probe_set_ty_slot(types_arr: *mut *mut AxType, idx: usize, ptr: *mut AxType) {
    let slot = ((types_arr as usize) + mir_mul_usize(idx, size_of<*mut AxType>())) as *mut *mut AxType;
    unsafe { *slot = ptr; }
}

fn pb_init_types(arena: mut_view<Arena>) -> ProbeTypes {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let types_arr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(32, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType;
    let pool = arena_alloc_raw(mut_view(*arena), mir_mul_usize(28, size_of<AxType>()), align_of<AxType>());
    let ty_sz = size_of<AxType>();

    let mut k: usize = 0;
    while k < 16 {
        let tp = ((pool as usize) + mir_mul_usize(k, ty_sz)) as *mut AxType;
        let tk: u8 = if k < 9 { k as u8 }
            else if k == 9 { TY_ISIZE }
            else if k == 10 { TY_U8 }
            else if k == 11 { TY_U16 }
            else if k == 12 { TY_U32 }
            else if k == 13 { TY_U64 }
            else if k == 14 { TY_USIZE }
            else { TY_STR };
        unsafe { ax_type_reset(mut_view(*tp), tk); }
        probe_set_ty_slot(types_arr, k, tp);
        k = k + 1;
    }

    let mut c: usize = 16;
    while c < 26 {
        let cp = ((pool as usize) + mir_mul_usize(c, ty_sz)) as *mut AxType;
        unsafe { ax_type_reset(mut_view(*cp), 0u8); }
        probe_set_ty_slot(types_arr, c, cp);
        c = c + 1;
    }

    let t17 = ((pool as usize) + mir_mul_usize(16, ty_sz)) as *mut AxType;
    let t18 = ((pool as usize) + mir_mul_usize(17, ty_sz)) as *mut AxType;
    let t19 = ((pool as usize) + mir_mul_usize(18, ty_sz)) as *mut AxType;
    let t20 = ((pool as usize) + mir_mul_usize(19, ty_sz)) as *mut AxType;
    let t21 = ((pool as usize) + mir_mul_usize(20, ty_sz)) as *mut AxType;
    let t22 = ((pool as usize) + mir_mul_usize(21, ty_sz)) as *mut AxType;
    let t23 = ((pool as usize) + mir_mul_usize(22, ty_sz)) as *mut AxType;
    let t24 = ((pool as usize) + mir_mul_usize(23, ty_sz)) as *mut AxType;
    let scratch_ty = ((pool as usize) + mir_mul_usize(24, ty_sz)) as *mut AxType;
    let vec4_flds = arena_alloc_raw(mut_view(*arena), mir_mul_usize(4, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;

    unsafe {
        ax_type_reset(mut_view(*scratch_ty), 0u8);
        (*t17).kind = TY_VIEW;
        (*t17).pointee = TypeId { v: 23u32 };
        (*t18).kind = TY_MUT_VIEW;
        (*t18).is_mut = true;
        (*t18).pointee = TypeId { v: 23u32 };
        (*t19).kind = TY_PTR;
        (*t19).is_mut = true;
        (*t19).pointee = TypeId { v: 20u32 };
        (*t20).kind = TY_ARRAY;
        (*t20).elem = TypeId { v: 8u32 };
        (*t20).array_len = 16u64;
        (*t21).kind = VEC_TY_F64;
        (*t22).kind = TY_ARRAY;
        (*t22).elem = TypeId { v: 21u32 };
        (*t22).array_len = 16u64;
        (*t23).kind = TY_SLICE;
        (*t23).elem = TypeId { v: 8u32 };

        *(((vec4_flds as usize) + 0 * size_of<TypeId>()) as *mut TypeId) = TypeId { v: 8u32 };
        *(((vec4_flds as usize) + 1 * size_of<TypeId>()) as *mut TypeId) = TypeId { v: 8u32 };
        *(((vec4_flds as usize) + 2 * size_of<TypeId>()) as *mut TypeId) = TypeId { v: 8u32 };
        *(((vec4_flds as usize) + 3 * size_of<TypeId>()) as *mut TypeId) = TypeId { v: 8u32 };
        (*t24).kind = TY_STRUCT;
        (*t24).fields = vec4_flds;
        (*t24).field_count = 4;

        (*thir_ptr).interner.arena = arena_new();
        (*thir_ptr).interner.map.keys = 0 as *mut *mut AxType;
        (*thir_ptr).interner.map.vals = 0 as *mut TypeId;
        (*thir_ptr).interner.map.states = 0 as *mut u8;
        (*thir_ptr).interner.map.len = 0;
        (*thir_ptr).interner.map.cap = 0;
        (*thir_ptr).interner.types = types_arr;
        (*thir_ptr).interner.len = 24;
        (*thir_ptr).interner.cap = 32;
        (*thir_ptr).interner.next_int_var = 1u32;
        (*thir_ptr).interner.scratch = scratch_ty;
        (*thir_ptr).interner.t_error.v = 1u32;
        (*thir_ptr).interner.t_unit.v = 2u32;
        (*thir_ptr).interner.t_never.v = 3u32;
        (*thir_ptr).interner.t_bool.v = 4u32;
        (*thir_ptr).interner.t_char.v = 5u32;
        (*thir_ptr).interner.t_i8.v = 6u32;
        (*thir_ptr).interner.t_i16.v = 7u32;
        (*thir_ptr).interner.t_i32.v = 8u32;
        (*thir_ptr).interner.t_i64.v = 9u32;
        (*thir_ptr).interner.t_isize.v = 10u32;
        (*thir_ptr).interner.t_u8.v = 11u32;
        (*thir_ptr).interner.t_u16.v = 12u32;
        (*thir_ptr).interner.t_u32.v = 13u32;
        (*thir_ptr).interner.t_u64.v = 14u32;
        (*thir_ptr).interner.t_usize.v = 15u32;
        (*thir_ptr).interner.t_str.v = 16u32;
        (*thir_ptr).interner.t_i128.v = 0x3FFF0128u32;
        (*thir_ptr).interner.t_u128.v = 0x3FFF0129u32;
        (*thir_ptr).item_types.keys = 0 as *mut usize;
        (*thir_ptr).item_types.vals = 0 as *mut TypeId;
        (*thir_ptr).item_types.states = 0 as *mut u8;
        (*thir_ptr).item_types.len = 0;
        (*thir_ptr).item_types.cap = 0;
        (*thir_ptr).expr_types.keys = 0 as *mut usize;
        (*thir_ptr).expr_types.vals = 0 as *mut TypeId;
        (*thir_ptr).expr_types.states = 0 as *mut u8;
        (*thir_ptr).expr_types.len = 0;
        (*thir_ptr).expr_types.cap = 0;
    }

    ProbeTypes {
        thir: thir_ptr,
        ty_i32: 8u32,
        ty_usize: 15u32,
        ty_bool: 4u32,
        ty_f64: 21u32,
        ty_view_i32: 17u32,
        ty_mut_view_i32: 18u32,
        ty_ptr_i32: 19u32,
        ty_arr16_i32: 20u32,
        ty_arr16_f64: 22u32,
        ty_vec4_i32: 24u32,
    }
}

fn pb_span() -> Span {
    Span { file: FileId { v: 1u32 }, start: 1u32, end: 10u32 }
}

fn pb_new_mir_body(arena: mut_view<Arena>, ret_ty: u32, arg_count: usize) -> *mut MirBody {
    let mb = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    unsafe {
        mir_body_reset(mut_view(*mb));
        (*mb).arg_count = arg_count;
    }
    let sp = pb_span();
    let _ = unsafe { mir_add_local(mut_view(*mb), mut_view(*arena), TypeId { v: ret_ty }, 0u8, true, StrId { v: 0u32 }, view(sp)) };
    mb
}

fn pb_add_local(mb: mut_view<MirBody>, arena: mut_view<Arena>, ty: u32, is_arg: bool) -> u32 {
    let sp = pb_span();
    let kind: u8 = if is_arg { MIR_LOCAL_ARG } else { 0u8 };
    mir_add_local(mut_view(*mb), mut_view(*arena), TypeId { v: ty }, kind, true, StrId { v: 0u32 }, view(sp)).v
}

fn pb_add_bb(mb: mut_view<MirBody>, arena: mut_view<Arena>) -> u32 {
    mir_add_bb(mut_view(*mb), mut_view(*arena), false).v
}

fn pb_op_const(ty: u32, val: u64) -> MirOperand {
    mir_op_const_int(ty, val)
}

fn pb_op_copy(loc: u32) -> MirOperand {
    mir_op_copy_local(loc)
}

fn pb_place_field(arena: mut_view<Arena>, base: u32, field_idx: u32) -> MirPlace {
    let parr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(parr, 0) };
    unsafe {
        mir_proj_reset(mut_view(*p0), MIR_PROJ_FIELD);
        (*p0).field_idx = field_idx;
    }
    let mut pl = mir_local_place(base);
    pl.projs = parr;
    pl.proj_count = 1;
    pl
}

fn pb_place_index(arena: mut_view<Arena>, base: u32, idx_loc: u32) -> MirPlace {
    let parr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(parr, 0) };
    unsafe {
        mir_proj_reset(mut_view(*p0), MIR_PROJ_INDEX);
        (*p0).index_local = MirLocalId { v: idx_loc };
    }
    let mut pl = mir_local_place(base);
    pl.projs = parr;
    pl.proj_count = 1;
    pl
}

fn pb_place_deref_index(arena: mut_view<Arena>, base: u32, idx_loc: u32) -> MirPlace {
    let parr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<MirProjection>()), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(parr, 0) };
    let p1 = unsafe { mir_proj_at(parr, 1) };
    unsafe {
        mir_proj_reset(mut_view(*p0), MIR_PROJ_DEREF);
        mir_proj_reset(mut_view(*p1), MIR_PROJ_INDEX);
        (*p1).index_local = MirLocalId { v: idx_loc };
    }
    let mut pl = mir_local_place(base);
    pl.projs = parr;
    pl.proj_count = 2;
    pl
}

fn pb_blank_stmt(arena: mut_view<Arena>) -> MirStmt {
    let mut st: MirStmt = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
    mir_stmt_zero(mut_view(st), MIR_STMT_ASSIGN);
    st.span = pb_span();
    st.location = pb_span();
    st
}

fn pb_push_const(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, ty: u32, val: u64) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = pb_op_const(ty, val);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_copy(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, src: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = pb_op_copy(src);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_binop(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, op: u8, lhs: MirOperand, rhs: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_BINARY_OP);
    st.rvalue.bin_op = op;
    st.rvalue.lhs = lhs;
    st.rvalue.rhs = rhs;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_load_field(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, base: u32, field_idx: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_COPY;
    st.rvalue.use_op.place = pb_place_field(mut_view(*arena), base, field_idx);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_store_field(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, base: u32, field_idx: u32, src_op: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = pb_place_field(mut_view(*arena), base, field_idx);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = src_op;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_load_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, base: u32, idx_loc: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_COPY;
    st.rvalue.use_op.place = pb_place_index(mut_view(*arena), base, idx_loc);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_store_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, base: u32, idx_loc: u32, src_op: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = pb_place_index(mut_view(*arena), base, idx_loc);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = src_op;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_load_deref_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, base: u32, idx_loc: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_COPY;
    st.rvalue.use_op.place = pb_place_deref_index(mut_view(*arena), base, idx_loc);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_store_deref_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, base: u32, idx_loc: u32, src_op: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = pb_place_deref_index(mut_view(*arena), base, idx_loc);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = src_op;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_set_goto(mb: mut_view<MirBody>, bb: u32, target: u32) {
    let sp = pb_span();
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_GOTO, view(sp));
        (*bptr).terminator.goto_target = MirBbId { v: target };
        (*bptr).has_terminator = true;
    }
}

fn pb_set_return(mb: mut_view<MirBody>, bb: u32) {
    let sp = pb_span();
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_RETURN, view(sp));
        (*bptr).has_terminator = true;
    }
}

fn pb_set_branch(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, cond_loc: u32, true_bb: u32, false_bb: u32) {
    let sp = pb_span();
    let svals = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
    let stgts = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        *svals = 0u64;
        *stgts = MirBbId { v: false_bb };
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_SWITCH_INT, view(sp));
        (*bptr).terminator.discr = pb_op_copy(cond_loc);
        (*bptr).terminator.values = svals;
        (*bptr).terminator.targets = stgts;
        (*bptr).terminator.switch_count = 1;
        (*bptr).terminator.otherwise = MirBbId { v: true_bb };
        (*bptr).has_terminator = true;
    }
}

fn pb_prepare_opt_body(
    mb: view<MirBody>,
    pt: view<ProbeTypes>,
    profile: u8,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    out_pm: mut_view<*mut PassManager>,
    out_alias: mut_view<*const AliasInfo>
) -> *mut OptBody {
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let db = dummy_fn as *mut u8;
    let mut z: usize = 0;
    while z < size_of<HirItem>() {
        unsafe { *opt_u8_at(db, z) = 0u8; }
        z = z + 1;
    }
    let obody = optir_build_from_mir(mb, pt.thir as *const Thir, mut_view(*arena), mut_view(*sink), dummy_fn as *const HirItem);
    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, true);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));

    let alias_ptr = alias_build_info(unsafe { view(*obody) }, 0 as *const EffectCallTable, mut_view(*arena)) as *const AliasInfo;
    let mut simp_stats = LoopSimplifyStats {
        pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32,
        loops_discovered: 0u32, irreducible_cycles: 0u32, preheaders_inserted: 0u32,
        latches_merged: 0u32, dedicated_exits_inserted: 0u32, lcssa_phis_inserted: 0u32,
    };
    loops_stats_zero(mut_view(simp_stats));
    let _ = opt_loop_simplify(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(simp_stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    *out_pm = pm_ptr;
    *out_alias = alias_build_info(unsafe { view(*obody) }, 0 as *const EffectCallTable, mut_view(*arena)) as *const AliasInfo;
    obody
}

fn pb_zero_vec_stats() -> LoopVecStats {
    let mut st = LoopVecStats {
        pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32,
        loops_analyzed: 0u32, loops_vectorized: 0u32, loops_rejected: 0u32,
        cap_disjoint_proven: 0u32, scev_disjoint_proven: 0u32, runtime_alias_guards: 0u32,
        reductions_vectorized: 0u32, broadcasts_widened: 0u32, step_vectors_widened: 0u32,
        selects_if_converted: 0u32, epilogues_emitted: 0u32, epilogues_omitted_exact: 0u32,
        rejected_non_counted: 0u32, rejected_atomic: 0u32, rejected_volatile: 0u32,
        rejected_unknown_alias: 0u32, rejected_loop_carried_dep: 0u32, rejected_strict_fp: 0u32,
        rejected_checked_overflow: 0u32, rejected_unproven_bounds: 0u32, rejected_cost: 0u32,
        rejected_size_profile: 0u32, records: 0 as *mut LoopVecRecord, record_count: 0, record_cap: 0,
    };
    loop_vec_stats_zero(mut_view(st));
    st
}

fn pb_init_pm(arena: mut_view<Arena>, obody: mut_view<OptBody>, profile: u8, verify_each: bool) -> *mut PassManager {
    let pm = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, verify_each);
    passmgr_init(unsafe { mut_view(*pm) }, budget, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm) }, mut_view(*obody), mut_view(*arena));
    pm
}

fn pb_build_opt_body(mb: view<MirBody>, pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> *mut OptBody {
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut u8;
    let mut z: usize = 0;
    while z < size_of<HirItem>() {
        unsafe { *(((dummy_fn as usize) + z) as *mut u8) = 0u8; }
        z = z + 1;
    }
    optir_build_from_mir(mb, pt.thir, mut_view(*arena), mut_view(*sink), dummy_fn as *const HirItem)
}

fn probe_loop_vec_cap_scev_and_guards(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let caps = vec_default_target_caps();

    // 1a. `out: mut_view<i32>`, `a: view<i32>`, `b: view<i32>` -> `VEC_ALIAS_CAP_DISJOINT`
    let mb_cap = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 3);
    let p_out = pb_add_local(unsafe { mut_view(*mb_cap) }, mut_view(*arena), pt.ty_mut_view_i32, true);
    let p_a = pb_add_local(unsafe { mut_view(*mb_cap) }, mut_view(*arena), pt.ty_view_i32, true);
    let p_b = pb_add_local(unsafe { mut_view(*mb_cap) }, mut_view(*arena), pt.ty_view_i32, true);
    let ci = pb_add_local(unsafe { mut_view(*mb_cap) }, mut_view(*arena), pt.ty_usize, false);
    let ccnd = pb_add_local(unsafe { mut_view(*mb_cap) }, mut_view(*arena), pt.ty_bool, false);
    let cva = pb_add_local(unsafe { mut_view(*mb_cap) }, mut_view(*arena), pt.ty_i32, false);
    let cvb = pb_add_local(unsafe { mut_view(*mb_cap) }, mut_view(*arena), pt.ty_i32, false);
    let csum = pb_add_local(unsafe { mut_view(*mb_cap) }, mut_view(*arena), pt.ty_i32, false);
    let cb0 = pb_add_bb(unsafe { mut_view(*mb_cap) }, mut_view(*arena));
    let cb1 = pb_add_bb(unsafe { mut_view(*mb_cap) }, mut_view(*arena));
    let cb2 = pb_add_bb(unsafe { mut_view(*mb_cap) }, mut_view(*arena));
    let cb3 = pb_add_bb(unsafe { mut_view(*mb_cap) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb0, ci, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_cap) }, cb0, cb1);
    pb_push_binop(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb1, ccnd, MIR_BINOP_LT, pb_op_copy(ci), pb_op_const(pt.ty_usize, 16u64));
    pb_set_branch(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb1, ccnd, cb2, cb3);
    pb_push_load_deref_idx(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb2, cva, p_a, ci);
    pb_push_load_deref_idx(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb2, cvb, p_b, ci);
    pb_push_binop(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb2, csum, MIR_BINOP_WRAPPING_ADD, pb_op_copy(cva), pb_op_copy(cvb));
    pb_push_store_deref_idx(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb2, p_out, ci, pb_op_copy(csum));
    pb_push_binop(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb2, ci, MIR_BINOP_ADD, pb_op_copy(ci), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_cap) }, cb2, cb1);
    pb_push_const(unsafe { mut_view(*mb_cap) }, mut_view(*arena), cb3, 0u32, pt.ty_i32, 0u64);
    pb_set_return(unsafe { mut_view(*mb_cap) }, cb3);

    let mut cpm = 0 as *mut PassManager;
    let mut calias = 0 as *const AliasInfo;
    let cob = pb_prepare_opt_body(unsafe { view(*mb_cap) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(cpm), mut_view(calias));
    let ctree = loops_discover(unsafe { view(*cob) }, 0 as *const EffectCallTable, calias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*ctree) }, unsafe { view(*cob) }, calias, mut_view(*arena));
    let clp = unsafe { loop_desc_at((*ctree).loops, 0) };
    let cleg = vec_analyze_loop_legality(unsafe { view(*ctree) }, unsafe { view(*clp) }, unsafe { view(*cob) }, calias, 0 as *const RangeInfo, view(caps), false, mut_view(*arena));
    if !cleg.is_legal || cleg.alias_proof != VEC_ALIAS_CAP_DISJOINT || cleg.candidate_vf != 4u8 {
        return false;
    }

    // 1b. Forward recurrence `arr[i] = arr[i - 1]` (`d = 1 < 4`) -> rejected `REASON_LOOP_CARRIED_DEP`
    let mb_rec = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let r_arr = pb_add_local(unsafe { mut_view(*mb_rec) }, mut_view(*arena), pt.ty_arr16_i32, true);
    let ri = pb_add_local(unsafe { mut_view(*mb_rec) }, mut_view(*arena), pt.ty_usize, false);
    let rcnd = pb_add_local(unsafe { mut_view(*mb_rec) }, mut_view(*arena), pt.ty_bool, false);
    let rim1 = pb_add_local(unsafe { mut_view(*mb_rec) }, mut_view(*arena), pt.ty_usize, false);
    let rval = pb_add_local(unsafe { mut_view(*mb_rec) }, mut_view(*arena), pt.ty_i32, false);
    let rb0 = pb_add_bb(unsafe { mut_view(*mb_rec) }, mut_view(*arena));
    let rb1 = pb_add_bb(unsafe { mut_view(*mb_rec) }, mut_view(*arena));
    let rb2 = pb_add_bb(unsafe { mut_view(*mb_rec) }, mut_view(*arena));
    let rb3 = pb_add_bb(unsafe { mut_view(*mb_rec) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_rec) }, mut_view(*arena), rb0, ri, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_rec) }, rb0, rb1);
    pb_push_binop(unsafe { mut_view(*mb_rec) }, mut_view(*arena), rb1, rcnd, MIR_BINOP_LT, pb_op_copy(ri), pb_op_const(pt.ty_usize, 12u64));
    pb_set_branch(unsafe { mut_view(*mb_rec) }, mut_view(*arena), rb1, rcnd, rb2, rb3);
    pb_push_binop(unsafe { mut_view(*mb_rec) }, mut_view(*arena), rb2, rim1, MIR_BINOP_SUB, pb_op_copy(ri), pb_op_const(pt.ty_usize, 1u64));
    pb_push_load_idx(unsafe { mut_view(*mb_rec) }, mut_view(*arena), rb2, rval, r_arr, rim1);
    pb_push_store_idx(unsafe { mut_view(*mb_rec) }, mut_view(*arena), rb2, r_arr, ri, pb_op_copy(rval));
    pb_push_binop(unsafe { mut_view(*mb_rec) }, mut_view(*arena), rb2, ri, MIR_BINOP_ADD, pb_op_copy(ri), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_rec) }, rb2, rb1);
    pb_push_const(unsafe { mut_view(*mb_rec) }, mut_view(*arena), rb3, 0u32, pt.ty_i32, 0u64);
    pb_set_return(unsafe { mut_view(*mb_rec) }, rb3);

    let mut rpm = 0 as *mut PassManager;
    let mut ralias = 0 as *const AliasInfo;
    let rob = pb_prepare_opt_body(unsafe { view(*mb_rec) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(rpm), mut_view(ralias));
    let rtree = loops_discover(unsafe { view(*rob) }, 0 as *const EffectCallTable, ralias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*rtree) }, unsafe { view(*rob) }, ralias, mut_view(*arena));
    let rlp = unsafe { loop_desc_at((*rtree).loops, 0) };
    let rleg = vec_analyze_loop_legality(unsafe { view(*rtree) }, unsafe { view(*rlp) }, unsafe { view(*rob) }, ralias, 0 as *const RangeInfo, view(caps), false, mut_view(*arena));
    if rleg.is_legal || rleg.reject_reason != REASON_LOOP_CARRIED_DEP {
        return false;
    }

    // 1c. Backward anti-dependence `arr[i] = arr[i + 1]` (`d = -1 < 0`) -> legal `VEC_ALIAS_SCEV_DISJOINT`
    let mb_anti = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let a_arr = pb_add_local(unsafe { mut_view(*mb_anti) }, mut_view(*arena), pt.ty_arr16_i32, true);
    let ai = pb_add_local(unsafe { mut_view(*mb_anti) }, mut_view(*arena), pt.ty_usize, false);
    let acnd = pb_add_local(unsafe { mut_view(*mb_anti) }, mut_view(*arena), pt.ty_bool, false);
    let aip1 = pb_add_local(unsafe { mut_view(*mb_anti) }, mut_view(*arena), pt.ty_usize, false);
    let aval = pb_add_local(unsafe { mut_view(*mb_anti) }, mut_view(*arena), pt.ty_i32, false);
    let ab0 = pb_add_bb(unsafe { mut_view(*mb_anti) }, mut_view(*arena));
    let ab1 = pb_add_bb(unsafe { mut_view(*mb_anti) }, mut_view(*arena));
    let ab2 = pb_add_bb(unsafe { mut_view(*mb_anti) }, mut_view(*arena));
    let ab3 = pb_add_bb(unsafe { mut_view(*mb_anti) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_anti) }, mut_view(*arena), ab0, ai, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_anti) }, ab0, ab1);
    pb_push_binop(unsafe { mut_view(*mb_anti) }, mut_view(*arena), ab1, acnd, MIR_BINOP_LT, pb_op_copy(ai), pb_op_const(pt.ty_usize, 12u64));
    pb_set_branch(unsafe { mut_view(*mb_anti) }, mut_view(*arena), ab1, acnd, ab2, ab3);
    pb_push_binop(unsafe { mut_view(*mb_anti) }, mut_view(*arena), ab2, aip1, MIR_BINOP_ADD, pb_op_copy(ai), pb_op_const(pt.ty_usize, 1u64));
    pb_push_load_idx(unsafe { mut_view(*mb_anti) }, mut_view(*arena), ab2, aval, a_arr, aip1);
    pb_push_store_idx(unsafe { mut_view(*mb_anti) }, mut_view(*arena), ab2, a_arr, ai, pb_op_copy(aval));
    pb_push_binop(unsafe { mut_view(*mb_anti) }, mut_view(*arena), ab2, ai, MIR_BINOP_ADD, pb_op_copy(ai), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_anti) }, ab2, ab1);
    pb_push_const(unsafe { mut_view(*mb_anti) }, mut_view(*arena), ab3, 0u32, pt.ty_i32, 0u64);
    pb_set_return(unsafe { mut_view(*mb_anti) }, ab3);

    let mut apm = 0 as *mut PassManager;
    let mut aalias = 0 as *const AliasInfo;
    let aob = pb_prepare_opt_body(unsafe { view(*mb_anti) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(apm), mut_view(aalias));
    let atree = loops_discover(unsafe { view(*aob) }, 0 as *const EffectCallTable, aalias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*atree) }, unsafe { view(*aob) }, aalias, mut_view(*arena));
    let alp = unsafe { loop_desc_at((*atree).loops, 0) };
    let aleg = vec_analyze_loop_legality(unsafe { view(*atree) }, unsafe { view(*alp) }, unsafe { view(*aob) }, aalias, 0 as *const RangeInfo, view(caps), false, mut_view(*arena));
    if !aleg.is_legal || aleg.alias_proof != VEC_ALIAS_SCEV_DISJOINT {
        return false;
    }

    // 1d. Raw pointers `*mut i32` -> rejected (`REASON_UNKNOWN_ALIAS`) without runtime guard, accepted (`VEC_ALIAS_RUNTIME_GUARD`) with guard
    let mb_raw = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 2);
    let raw_dst = pb_add_local(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pt.ty_ptr_i32, true);
    let raw_src = pb_add_local(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pt.ty_ptr_i32, true);
    let pi = pb_add_local(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pt.ty_usize, false);
    let pcnd = pb_add_local(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pt.ty_bool, false);
    let pval = pb_add_local(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pt.ty_i32, false);
    let pb0 = pb_add_bb(unsafe { mut_view(*mb_raw) }, mut_view(*arena));
    let pb1 = pb_add_bb(unsafe { mut_view(*mb_raw) }, mut_view(*arena));
    let pb2 = pb_add_bb(unsafe { mut_view(*mb_raw) }, mut_view(*arena));
    let pb3 = pb_add_bb(unsafe { mut_view(*mb_raw) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pb0, pi, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_raw) }, pb0, pb1);
    pb_push_binop(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pb1, pcnd, MIR_BINOP_LT, pb_op_copy(pi), pb_op_const(pt.ty_usize, 16u64));
    pb_set_branch(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pb1, pcnd, pb2, pb3);
    pb_push_load_deref_idx(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pb2, pval, raw_src, pi);
    pb_push_store_deref_idx(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pb2, raw_dst, pi, pb_op_copy(pval));
    pb_push_binop(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pb2, pi, MIR_BINOP_ADD, pb_op_copy(pi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_raw) }, pb2, pb1);
    pb_push_const(unsafe { mut_view(*mb_raw) }, mut_view(*arena), pb3, 0u32, pt.ty_i32, 0u64);
    pb_set_return(unsafe { mut_view(*mb_raw) }, pb3);

    let mut ppm = 0 as *mut PassManager;
    let mut palias = 0 as *const AliasInfo;
    let pob = pb_prepare_opt_body(unsafe { view(*mb_raw) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(ppm), mut_view(palias));
    let ptree = loops_discover(unsafe { view(*pob) }, 0 as *const EffectCallTable, palias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*ptree) }, unsafe { view(*pob) }, palias, mut_view(*arena));
    let plp = unsafe { loop_desc_at((*ptree).loops, 0) };
    let pleg_no_guard = vec_analyze_loop_legality(unsafe { view(*ptree) }, unsafe { view(*plp) }, unsafe { view(*pob) }, palias, 0 as *const RangeInfo, view(caps), false, mut_view(*arena));
    let pleg_with_guard = vec_analyze_loop_legality(unsafe { view(*ptree) }, unsafe { view(*plp) }, unsafe { view(*pob) }, palias, 0 as *const RangeInfo, view(caps), true, mut_view(*arena));
    if !(!pleg_no_guard.is_legal && pleg_no_guard.reject_reason == REASON_UNKNOWN_ALIAS &&
         pleg_with_guard.is_legal && pleg_with_guard.alias_proof == VEC_ALIAS_RUNTIME_GUARD) {
        return false;
    }
    true
}

fn probe_loop_vec_reductions_and_fp_legality(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let caps_strict = vec_default_target_caps();
    let mut caps_relaxed = vec_default_target_caps();
    caps_relaxed.fp_mode = FP_MODE_RELAXED;

    // 2a. Wrapping integer `wrapping_add` reduction
    let mb_int = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let i_arr = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_arr16_i32, true);
    let ii = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_usize, false);
    let icnd = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_bool, false);
    let iacc = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_i32, false);
    let ival = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_i32, false);
    let ib0 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib1 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib2 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib3 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib0, ii, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib0, iacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_int) }, ib0, ib1);
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib1, icnd, MIR_BINOP_LT, pb_op_copy(ii), pb_op_const(pt.ty_usize, 12u64));
    pb_set_branch(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib1, icnd, ib2, ib3);
    pb_push_load_idx(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib2, ival, i_arr, ii);
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib2, iacc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(iacc), pb_op_copy(ival));
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib2, ii, MIR_BINOP_ADD, pb_op_copy(ii), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_int) }, ib2, ib1);
    pb_push_copy(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib3, 0u32, iacc);
    pb_set_return(unsafe { mut_view(*mb_int) }, ib3);

    let mut ipm = 0 as *mut PassManager;
    let mut ialias = 0 as *const AliasInfo;
    let iob = pb_prepare_opt_body(unsafe { view(*mb_int) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(ipm), mut_view(ialias));
    let itree = loops_discover(unsafe { view(*iob) }, 0 as *const EffectCallTable, ialias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*itree) }, unsafe { view(*iob) }, ialias, mut_view(*arena));
    let ilp = unsafe { loop_desc_at((*itree).loops, 0) };
    let ired = vec_recognize_reduction(unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias, 0 as *const RangeInfo, view(caps_strict), VEC_ELEM_I32);
    if !ired.is_valid || ired.vreduce_op != VREDUCE_ADD || ired.arith_class != ARITH_WRAPPING || ired.certainty != CERTAINTY_PROVEN {
        return false;
    }

    // 2b. Checked integer `+` reduction with proven `NoOverflow`
    let mb_nsw = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let ni = pb_add_local(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), pt.ty_usize, false);
    let ncnd = pb_add_local(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), pt.ty_bool, false);
    let nacc = pb_add_local(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), pt.ty_i32, false);
    let nb0 = pb_add_bb(unsafe { mut_view(*mb_nsw) }, mut_view(*arena));
    let nb1 = pb_add_bb(unsafe { mut_view(*mb_nsw) }, mut_view(*arena));
    let nb2 = pb_add_bb(unsafe { mut_view(*mb_nsw) }, mut_view(*arena));
    let nb3 = pb_add_bb(unsafe { mut_view(*mb_nsw) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), nb0, ni, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), nb0, nacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_nsw) }, nb0, nb1);
    pb_push_binop(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), nb1, ncnd, MIR_BINOP_LT, pb_op_copy(ni), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), nb1, ncnd, nb2, nb3);
    pb_push_binop(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), nb2, nacc, MIR_BINOP_ADD, pb_op_copy(nacc), pb_op_const(pt.ty_i32, 3u64));
    pb_push_binop(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), nb2, ni, MIR_BINOP_ADD, pb_op_copy(ni), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_nsw) }, nb2, nb1);
    pb_push_copy(unsafe { mut_view(*mb_nsw) }, mut_view(*arena), nb3, 0u32, nacc);
    pb_set_return(unsafe { mut_view(*mb_nsw) }, nb3);

    let mut npm = 0 as *mut PassManager;
    let mut nalias = 0 as *const AliasInfo;
    let nob = pb_prepare_opt_body(unsafe { view(*mb_nsw) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(npm), mut_view(nalias));
    let ntree = loops_discover(unsafe { view(*nob) }, 0 as *const EffectCallTable, nalias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*ntree) }, unsafe { view(*nob) }, nalias, mut_view(*arena));
    let nrinfo = range_build_info(unsafe { view(*nob) }, ntree as *const LoopTree, nalias, 0 as *const EffectCallTable, mut_view(*arena)) as *const RangeInfo;
    let nlp = unsafe { loop_desc_at((*ntree).loops, 0) };
    let nred = vec_recognize_reduction(unsafe { view(*nlp) }, unsafe { view(*nob) }, nalias, nrinfo, view(caps_strict), VEC_ELEM_I32);
    if !nred.is_valid || nred.arith_class != ARITH_PROVEN_NSW_NUW {
        return false;
    }

    // 2c. Floating-point `f64` reduction: rejected under `FP_MODE_STRICT` (`REASON_STRICT_FP_REDUCTION`), allowed under `FP_MODE_RELAXED`
    let fred_strict = vec_recognize_reduction(unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias, 0 as *const RangeInfo, view(caps_strict), VEC_ELEM_F64);
    let fred_relax = vec_recognize_reduction(unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias, 0 as *const RangeInfo, view(caps_relaxed), VEC_ELEM_F64);
    if !(!fred_strict.is_valid && fred_strict.reject_reason == REASON_STRICT_FP_REDUCTION &&
         fred_relax.is_valid && fred_relax.vreduce_op == VREDUCE_ADD && fred_relax.elem_kind == VEC_ELEM_F64) {
        return false;
    }

    // 2d. Pure diamond conditional inside loop if-converted to `VSelect` + broadcast scalar
    let mb_sel = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 2);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb_sel) }, mut_view(*arena), pt.ty_arr16_i32, true);
    let arg_scale = pb_add_local(unsafe { mut_view(*mb_sel) }, mut_view(*arena), pt.ty_i32, true);
    let li = pb_add_local(unsafe { mut_view(*mb_sel) }, mut_view(*arena), pt.ty_usize, false);
    let lcnd = pb_add_local(unsafe { mut_view(*mb_sel) }, mut_view(*arena), pt.ty_bool, false);
    let lpred = pb_add_local(unsafe { mut_view(*mb_sel) }, mut_view(*arena), pt.ty_bool, false);
    let lv = pb_add_local(unsafe { mut_view(*mb_sel) }, mut_view(*arena), pt.ty_i32, false);
    let lsel = pb_add_local(unsafe { mut_view(*mb_sel) }, mut_view(*arena), pt.ty_i32, false);
    let lacc = pb_add_local(unsafe { mut_view(*mb_sel) }, mut_view(*arena), pt.ty_i32, false);
    let b0 = pb_add_bb(unsafe { mut_view(*mb_sel) }, mut_view(*arena));
    let b1 = pb_add_bb(unsafe { mut_view(*mb_sel) }, mut_view(*arena));
    let b2 = pb_add_bb(unsafe { mut_view(*mb_sel) }, mut_view(*arena));
    let b3 = pb_add_bb(unsafe { mut_view(*mb_sel) }, mut_view(*arena));
    let b4 = pb_add_bb(unsafe { mut_view(*mb_sel) }, mut_view(*arena));
    let b5 = pb_add_bb(unsafe { mut_view(*mb_sel) }, mut_view(*arena));
    let b6 = pb_add_bb(unsafe { mut_view(*mb_sel) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b0, li, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b0, lacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_sel) }, b0, b1);
    pb_push_binop(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b1, lcnd, MIR_BINOP_LT, pb_op_copy(li), pb_op_const(pt.ty_usize, 12u64));
    pb_set_branch(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b1, lcnd, b2, b6);
    pb_push_load_idx(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b2, lv, arg_arr, li);
    pb_push_binop(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b2, lpred, MIR_BINOP_GT, pb_op_copy(lv), pb_op_const(pt.ty_i32, 0u64));
    pb_set_branch(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b2, lpred, b3, b4);
    pb_push_binop(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b3, lsel, MIR_BINOP_WRAPPING_MUL, pb_op_copy(lv), pb_op_copy(arg_scale));
    pb_set_goto(unsafe { mut_view(*mb_sel) }, b3, b5);
    pb_push_binop(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b4, lsel, MIR_BINOP_WRAPPING_ADD, pb_op_copy(lv), pb_op_copy(arg_scale));
    pb_set_goto(unsafe { mut_view(*mb_sel) }, b4, b5);
    pb_push_binop(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b5, lacc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(lacc), pb_op_copy(lsel));
    pb_push_binop(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b5, li, MIR_BINOP_ADD, pb_op_copy(li), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_sel) }, b5, b1);
    pb_push_copy(unsafe { mut_view(*mb_sel) }, mut_view(*arena), b6, 0u32, lacc);
    pb_set_return(unsafe { mut_view(*mb_sel) }, b6);

    let mut spm = 0 as *mut PassManager;
    let mut salias = 0 as *const AliasInfo;
    let sob = pb_prepare_opt_body(unsafe { view(*mb_sel) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(spm), mut_view(salias));
    let stree = loops_discover(unsafe { view(*sob) }, 0 as *const EffectCallTable, salias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*stree) }, unsafe { view(*sob) }, salias, mut_view(*arena));
    let slp_desc = unsafe { loop_desc_at((*stree).loops, 0) };
    let sleg = vec_analyze_loop_legality(unsafe { view(*stree) }, unsafe { view(*slp_desc) }, unsafe { view(*sob) }, salias, 0 as *const RangeInfo, view(caps_strict), false, mut_view(*arena));
    sleg.is_legal && sleg.vselect_count == 1u8 && sleg.vsplat_count >= 1u8 && sleg.has_reduction
}

fn probe_loop_vec_widths_epilogues_and_provenance(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let c_sse2 = vec_default_target_caps();
    let c_avx = vec_avx_target_caps();
    let c_avx2 = vec_avx2_target_caps();

    // 3a. SSE2 128-bit baseline widths (`u8x16`, `i16x8`, `i32x4`, `i64x2`, `f64x2`) + AVX1/AVX2 widths
    if vec_select_lane_width(view(c_sse2), VEC_ELEM_U8, false, 0u64, 4u8, 4u8) != 16u8 ||
       vec_select_lane_width(view(c_sse2), VEC_ELEM_I16, false, 0u64, 4u8, 4u8) != 8u8 ||
       vec_select_lane_width(view(c_sse2), VEC_ELEM_I32, false, 0u64, 4u8, 4u8) != 4u8 ||
       vec_select_lane_width(view(c_sse2), VEC_ELEM_I64, false, 0u64, 4u8, 4u8) != 2u8 ||
       vec_select_lane_width(view(c_sse2), VEC_ELEM_F64, false, 0u64, 4u8, 4u8) != 2u8 ||
       vec_select_lane_width(view(c_avx), VEC_ELEM_F32, false, 0u64, 4u8, 6u8) != 8u8 ||
       vec_select_lane_width(view(c_avx), VEC_ELEM_I32, false, 0u64, 4u8, 6u8) != 4u8 ||
       vec_select_lane_width(view(c_avx2), VEC_ELEM_I32, false, 0u64, 6u8, 8u8) != 8u8 ||
       vec_select_lane_width(view(c_avx2), VEC_ELEM_I32, false, 0u64, 10u8, 16u8) != 4u8 ||
       vec_select_lane_width(view(c_avx2), VEC_ELEM_I32, true, 6u64, 4u8, 6u8) != 4u8 {
        return false;
    }

    // 3b. Non-multiple trip count (`N = 10`, `VF = 4`) -> `-Os` rejects (`REASON_SIZE_PROFILE_GROWTH`), `-O2` emits scalar epilogue (`EPILOGUE_SCALAR_REMAINDER`)
    let mb_epi = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let e_arr = pb_add_local(unsafe { mut_view(*mb_epi) }, mut_view(*arena), pt.ty_arr16_i32, true);
    let ei = pb_add_local(unsafe { mut_view(*mb_epi) }, mut_view(*arena), pt.ty_usize, false);
    let ecnd = pb_add_local(unsafe { mut_view(*mb_epi) }, mut_view(*arena), pt.ty_bool, false);
    let eval = pb_add_local(unsafe { mut_view(*mb_epi) }, mut_view(*arena), pt.ty_i32, false);
    let eacc = pb_add_local(unsafe { mut_view(*mb_epi) }, mut_view(*arena), pt.ty_i32, false);
    let eb0 = pb_add_bb(unsafe { mut_view(*mb_epi) }, mut_view(*arena));
    let eb1 = pb_add_bb(unsafe { mut_view(*mb_epi) }, mut_view(*arena));
    let eb2 = pb_add_bb(unsafe { mut_view(*mb_epi) }, mut_view(*arena));
    let eb3 = pb_add_bb(unsafe { mut_view(*mb_epi) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_epi) }, mut_view(*arena), eb0, ei, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_epi) }, mut_view(*arena), eb0, eacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_epi) }, eb0, eb1);
    pb_push_binop(unsafe { mut_view(*mb_epi) }, mut_view(*arena), eb1, ecnd, MIR_BINOP_LT, pb_op_copy(ei), pb_op_const(pt.ty_usize, 10u64));
    pb_set_branch(unsafe { mut_view(*mb_epi) }, mut_view(*arena), eb1, ecnd, eb2, eb3);
    pb_push_load_idx(unsafe { mut_view(*mb_epi) }, mut_view(*arena), eb2, eval, e_arr, ei);
    pb_push_binop(unsafe { mut_view(*mb_epi) }, mut_view(*arena), eb2, eacc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(eacc), pb_op_copy(eval));
    pb_push_binop(unsafe { mut_view(*mb_epi) }, mut_view(*arena), eb2, ei, MIR_BINOP_ADD, pb_op_copy(ei), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_epi) }, eb2, eb1);
    pb_push_copy(unsafe { mut_view(*mb_epi) }, mut_view(*arena), eb3, 0u32, eacc);
    pb_set_return(unsafe { mut_view(*mb_epi) }, eb3);

    let mut os_pm = 0 as *mut PassManager;
    let mut os_alias = 0 as *const AliasInfo;
    let os_ob = pb_prepare_opt_body(unsafe { view(*mb_epi) }, pt, OPT_PROFILE_SIZE_OS, mut_view(*arena), mut_view(*sink), mut_view(os_pm), mut_view(os_alias));
    let mut os_stats = pb_zero_vec_stats();
    let os_changed = opt_loop_vec(unsafe { mut_view(*os_pm) }, unsafe { mut_view(*os_ob) }, 0 as *const EffectCallTable, os_alias, mut_view(os_stats), mut_view(*arena), mut_view(*sink));
    if os_changed || os_stats.rejected_size_profile != 1u32 {
        return false;
    }

    let mut epm = 0 as *mut PassManager;
    let mut ealias = 0 as *const AliasInfo;
    let eob = pb_prepare_opt_body(unsafe { view(*mb_epi) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(epm), mut_view(ealias));
    let mut estats = pb_zero_vec_stats();
    let echanged = opt_loop_vec(unsafe { mut_view(*epm) }, unsafe { mut_view(*eob) }, 0 as *const EffectCallTable, ealias, mut_view(estats), mut_view(*arena), mut_view(*sink));
    let etree_after = loops_discover(unsafe { view(*eob) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(*arena));
    if !echanged || estats.pass_rollbacks != 0u32 || estats.loops_vectorized != 1u32 ||
       estats.epilogues_emitted != 1u32 || (unsafe { (*etree_after).loop_count }) != 2 ||
       (unsafe { (*eob).provenance_count }) == 0 {
        return false;
    }
    let rec0 = unsafe { loop_vec_record_at(estats.records, 0) };
    if (unsafe { (*rec0).epilogue_kind }) != EPILOGUE_SCALAR_REMAINDER || (unsafe { (*rec0).vf }) != 4u8 {
        return false;
    }

    // 3c. Exact-multiple trip count (`N = 8`, `VF = 4`) -> omits unreachable epilogue (`EPILOGUE_NONE_EXACT_MULTIPLE`)
    let mb_ex = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let x_arr = pb_add_local(unsafe { mut_view(*mb_ex) }, mut_view(*arena), pt.ty_arr16_i32, true);
    let xi = pb_add_local(unsafe { mut_view(*mb_ex) }, mut_view(*arena), pt.ty_usize, false);
    let xcnd = pb_add_local(unsafe { mut_view(*mb_ex) }, mut_view(*arena), pt.ty_bool, false);
    let xval = pb_add_local(unsafe { mut_view(*mb_ex) }, mut_view(*arena), pt.ty_i32, false);
    let xacc = pb_add_local(unsafe { mut_view(*mb_ex) }, mut_view(*arena), pt.ty_i32, false);
    let xb0 = pb_add_bb(unsafe { mut_view(*mb_ex) }, mut_view(*arena));
    let xb1 = pb_add_bb(unsafe { mut_view(*mb_ex) }, mut_view(*arena));
    let xb2 = pb_add_bb(unsafe { mut_view(*mb_ex) }, mut_view(*arena));
    let xb3 = pb_add_bb(unsafe { mut_view(*mb_ex) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_ex) }, mut_view(*arena), xb0, xi, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_ex) }, mut_view(*arena), xb0, xacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_ex) }, xb0, xb1);
    pb_push_binop(unsafe { mut_view(*mb_ex) }, mut_view(*arena), xb1, xcnd, MIR_BINOP_LT, pb_op_copy(xi), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb_ex) }, mut_view(*arena), xb1, xcnd, xb2, xb3);
    pb_push_load_idx(unsafe { mut_view(*mb_ex) }, mut_view(*arena), xb2, xval, x_arr, xi);
    pb_push_binop(unsafe { mut_view(*mb_ex) }, mut_view(*arena), xb2, xacc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(xacc), pb_op_copy(xval));
    pb_push_binop(unsafe { mut_view(*mb_ex) }, mut_view(*arena), xb2, xi, MIR_BINOP_ADD, pb_op_copy(xi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_ex) }, xb2, xb1);
    pb_push_copy(unsafe { mut_view(*mb_ex) }, mut_view(*arena), xb3, 0u32, xacc);
    pb_set_return(unsafe { mut_view(*mb_ex) }, xb3);

    let mut xpm = 0 as *mut PassManager;
    let mut xalias = 0 as *const AliasInfo;
    let xob = pb_prepare_opt_body(unsafe { view(*mb_ex) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(xpm), mut_view(xalias));
    let mut xstats = pb_zero_vec_stats();
    let xchanged = opt_loop_vec(unsafe { mut_view(*xpm) }, unsafe { mut_view(*xob) }, 0 as *const EffectCallTable, xalias, mut_view(xstats), mut_view(*arena), mut_view(*sink));
    let xtree_after = loops_discover(unsafe { view(*xob) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(*arena));
    if !xchanged || xstats.epilogues_omitted_exact != 1u32 || (unsafe { (*xtree_after).loop_count }) != 1 {
        return false;
    }

    // 3d. End-to-end `loop_vec_optimize_mir_body` on symbolic trip count `i < n` + contract check
    let mb_sym = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 2);
    let s_arr = pb_add_local(unsafe { mut_view(*mb_sym) }, mut_view(*arena), pt.ty_arr16_i32, true);
    let s_n = pb_add_local(unsafe { mut_view(*mb_sym) }, mut_view(*arena), pt.ty_usize, true);
    let si = pb_add_local(unsafe { mut_view(*mb_sym) }, mut_view(*arena), pt.ty_usize, false);
    let scnd = pb_add_local(unsafe { mut_view(*mb_sym) }, mut_view(*arena), pt.ty_bool, false);
    let sval = pb_add_local(unsafe { mut_view(*mb_sym) }, mut_view(*arena), pt.ty_i32, false);
    let sacc = pb_add_local(unsafe { mut_view(*mb_sym) }, mut_view(*arena), pt.ty_i32, false);
    let sb0 = pb_add_bb(unsafe { mut_view(*mb_sym) }, mut_view(*arena));
    let sb1 = pb_add_bb(unsafe { mut_view(*mb_sym) }, mut_view(*arena));
    let sb2 = pb_add_bb(unsafe { mut_view(*mb_sym) }, mut_view(*arena));
    let sb3 = pb_add_bb(unsafe { mut_view(*mb_sym) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_sym) }, mut_view(*arena), sb0, si, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_sym) }, mut_view(*arena), sb0, sacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_sym) }, sb0, sb1);
    pb_push_binop(unsafe { mut_view(*mb_sym) }, mut_view(*arena), sb1, scnd, MIR_BINOP_LT, pb_op_copy(si), pb_op_copy(s_n));
    pb_set_branch(unsafe { mut_view(*mb_sym) }, mut_view(*arena), sb1, scnd, sb2, sb3);
    pb_push_load_idx(unsafe { mut_view(*mb_sym) }, mut_view(*arena), sb2, sval, s_arr, si);
    pb_push_binop(unsafe { mut_view(*mb_sym) }, mut_view(*arena), sb2, sacc, MIR_BINOP_BIT_XOR, pb_op_copy(sacc), pb_op_copy(sval));
    pb_push_binop(unsafe { mut_view(*mb_sym) }, mut_view(*arena), sb2, si, MIR_BINOP_ADD, pb_op_copy(si), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_sym) }, sb2, sb1);
    pb_push_copy(unsafe { mut_view(*mb_sym) }, mut_view(*arena), sb3, 0u32, sacc);
    pb_set_return(unsafe { mut_view(*mb_sym) }, sb3);

    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let db = dummy_fn as *mut u8;
    let mut z: usize = 0;
    while z < size_of<HirItem>() {
        unsafe { *opt_u8_at(db, z) = 0u8; }
        z = z + 1;
    }
    let mut sstats = pb_zero_vec_stats();
    let ok_e2e = loop_vec_optimize_mir_body(
        unsafe { mut_view(*mb_sym) },
        pt.thir as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        view(c_sse2),
        mut_view(sstats),
        mut_view(*arena),
        mut_view(*sink),
        dummy_fn as *const HirItem
    );
    let contract = loop_vec_contract();
    ok_e2e && sstats.loops_vectorized == 1u32 && sstats.epilogues_emitted == 1u32 && contract.pass_id == PASS_LOOP_VEC
}

fn probe_slp_pack_trees_reductions_and_barriers(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mut stats: SlpVecStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<SlpVecStats>(), align_of<SlpVecStats>()) as *mut SlpVecStats) };

    // 4a. 4-lane struct field SLP (descending field order + commuted lane 1) + 8-lane AVX2 array SLP
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 3);
    let a_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let b_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let out_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let mut f: u32 = 0u32;
    let mut sum_locs: [4]u32 = [0u32, 0u32, 0u32, 0u32];
    while f < 4u32 {
        let la = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
        let ls = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
        pb_push_load_field(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, la, a_loc, f);
        pb_push_load_field(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, lb, b_loc, f);
        if f == 1u32 {
            pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(lb), pb_op_copy(la));
        } else {
            pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(la), pb_op_copy(lb));
        }
        sum_locs[f as usize] = ls;
        f = f + 1u32;
    }
    pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, out_loc, 3u32, pb_op_copy(sum_locs[3]));
    pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, out_loc, 2u32, pb_op_copy(sum_locs[2]));
    pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, out_loc, 1u32, pb_op_copy(sum_locs[1]));
    pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, out_loc, 0u32, pb_op_copy(sum_locs[0]));
    pb_set_return(unsafe { mut_view(*mb) }, bb0);

    let obody = pb_build_opt_body(unsafe { view(*mb) }, pt, mut_view(*arena), mut_view(*sink));
    let pm = pb_init_pm(mut_view(*arena), unsafe { mut_view(*obody) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let changed = opt_slp_vec(unsafe { mut_view(*pm) }, unsafe { mut_view(*obody) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(*arena), mut_view(*sink));
    if !changed || stats.trees_vectorized != 1u32 || stats.lanes_packed_total != 4u32 || (unsafe { (*obody).provenance_count }) == 0 {
        return false;
    }
    let rec0 = unsafe { slp_vec_record_at(stats.records, 0) };
    if (unsafe { (*rec0).seed_kind }) != SLP_SEED_ADJACENT_STORES || (unsafe { (*rec0).lane_count }) != 4u8 {
        return false;
    }

    // 4b. Unprofitable non-contiguous gather pack rejected (`REASON_COST_NOT_PROFITABLE`)
    let mb_g = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 2);
    let src_arr = pb_add_local(unsafe { mut_view(*mb_g) }, mut_view(*arena), pt.ty_view_i32, true);
    let dst_vec = pb_add_local(unsafe { mut_view(*mb_g) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let bbg = pb_add_bb(unsafe { mut_view(*mb_g) }, mut_view(*arena));
    let g_indices: [4]u64 = [0u64, 5u64, 11u64, 14u64];
    f = 0u32;
    while f < 4u32 {
        let il = pb_add_local(unsafe { mut_view(*mb_g) }, mut_view(*arena), pt.ty_usize, false);
        let vl = pb_add_local(unsafe { mut_view(*mb_g) }, mut_view(*arena), pt.ty_i32, false);
        pb_push_const(unsafe { mut_view(*mb_g) }, mut_view(*arena), bbg, il, pt.ty_usize, g_indices[f as usize]);
        pb_push_load_deref_idx(unsafe { mut_view(*mb_g) }, mut_view(*arena), bbg, vl, src_arr, il);
        pb_push_store_field(unsafe { mut_view(*mb_g) }, mut_view(*arena), bbg, dst_vec, f, pb_op_copy(vl));
        f = f + 1u32;
    }
    pb_set_return(unsafe { mut_view(*mb_g) }, bbg);

    let ob_g = pb_build_opt_body(unsafe { view(*mb_g) }, pt, mut_view(*arena), mut_view(*sink));
    let pm_g = pb_init_pm(mut_view(*arena), unsafe { mut_view(*ob_g) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_g = opt_slp_vec(unsafe { mut_view(*pm_g) }, unsafe { mut_view(*ob_g) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(*arena), mut_view(*sink));
    if ch_g || stats.trees_vectorized != 0u32 || stats.rejected_cost == 0u32 {
        return false;
    }
    true
}

fn probe_slp_horiz_and_safety_barriers(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mut stats: SlpVecStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<SlpVecStats>(), align_of<SlpVecStats>()) as *mut SlpVecStats) };

    // 4c. 4-lane horizontal dot-product reduction `(a.x*b.x + a.y*b.y) + (a.z*b.z + a.w*b.w)`
    let mb_r = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 2);
    let a_loc = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let b_loc = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let bbr = pb_add_bb(unsafe { mut_view(*mb_r) }, mut_view(*arena));
    let mut prods: [4]u32 = [0u32, 0u32, 0u32, 0u32];
    let mut f: u32 = 0u32;
    while f < 4u32 {
        let la = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(*arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(*arena), pt.ty_i32, false);
        let lp = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(*arena), pt.ty_i32, false);
        pb_push_load_field(unsafe { mut_view(*mb_r) }, mut_view(*arena), bbr, la, a_loc, f);
        pb_push_load_field(unsafe { mut_view(*mb_r) }, mut_view(*arena), bbr, lb, b_loc, f);
        pb_push_binop(unsafe { mut_view(*mb_r) }, mut_view(*arena), bbr, lp, MIR_BINOP_WRAPPING_MUL, pb_op_copy(la), pb_op_copy(lb));
        prods[f as usize] = lp;
        f = f + 1u32;
    }
    let s01 = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(*arena), pt.ty_i32, false);
    let s23 = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(*arena), pt.ty_i32, false);
    pb_push_binop(unsafe { mut_view(*mb_r) }, mut_view(*arena), bbr, s01, MIR_BINOP_WRAPPING_ADD, pb_op_copy(prods[0]), pb_op_copy(prods[1]));
    pb_push_binop(unsafe { mut_view(*mb_r) }, mut_view(*arena), bbr, s23, MIR_BINOP_WRAPPING_ADD, pb_op_copy(prods[2]), pb_op_copy(prods[3]));
    pb_push_binop(unsafe { mut_view(*mb_r) }, mut_view(*arena), bbr, 0u32, MIR_BINOP_WRAPPING_ADD, pb_op_copy(s01), pb_op_copy(s23));
    pb_set_return(unsafe { mut_view(*mb_r) }, bbr);

    let ob_r = pb_build_opt_body(unsafe { view(*mb_r) }, pt, mut_view(*arena), mut_view(*sink));
    let pm_r = pb_init_pm(mut_view(*arena), unsafe { mut_view(*ob_r) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_r = opt_slp_vec(unsafe { mut_view(*pm_r) }, unsafe { mut_view(*ob_r) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(*arena), mut_view(*sink));
    if !ch_r || stats.reductions_vectorized != 1u32 || stats.lanes_packed_total != 4u32 {
        return false;
    }
    let rec_r = unsafe { slp_vec_record_at(stats.records, 0) };
    if (unsafe { (*rec_r).seed_kind }) != SLP_SEED_HORIZ_REDUCTION || (unsafe { (*rec_r).reduction_op }) != VREDUCE_ADD {
        return false;
    }

    // 4d. Strict FP horizontal reduction rejected (`REASON_STRICT_FP_REDUCTION`), accepted under `FP_MODE_RELAXED`
    let mb_fp = pb_new_mir_body(mut_view(*arena), pt.ty_f64, 1);
    let arr_fp = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(*arena), pt.ty_arr16_f64, true);
    let bbfp = pb_add_bb(unsafe { mut_view(*mb_fp) }, mut_view(*arena));
    let mut fp_vals: [4]u32 = [0u32, 0u32, 0u32, 0u32];
    f = 0u32;
    while f < 4u32 {
        let il = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(*arena), pt.ty_usize, false);
        let vl = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(*arena), pt.ty_f64, false);
        pb_push_const(unsafe { mut_view(*mb_fp) }, mut_view(*arena), bbfp, il, pt.ty_usize, f as u64);
        pb_push_load_idx(unsafe { mut_view(*mb_fp) }, mut_view(*arena), bbfp, vl, arr_fp, il);
        fp_vals[f as usize] = vl;
        f = f + 1u32;
    }
    let fp01 = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(*arena), pt.ty_f64, false);
    let fp23 = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(*arena), pt.ty_f64, false);
    pb_push_binop(unsafe { mut_view(*mb_fp) }, mut_view(*arena), bbfp, fp01, MIR_BINOP_ADD, pb_op_copy(fp_vals[0]), pb_op_copy(fp_vals[1]));
    pb_push_binop(unsafe { mut_view(*mb_fp) }, mut_view(*arena), bbfp, fp23, MIR_BINOP_ADD, pb_op_copy(fp_vals[2]), pb_op_copy(fp_vals[3]));
    pb_push_binop(unsafe { mut_view(*mb_fp) }, mut_view(*arena), bbfp, 0u32, MIR_BINOP_ADD, pb_op_copy(fp01), pb_op_copy(fp23));
    pb_set_return(unsafe { mut_view(*mb_fp) }, bbfp);

    let ob_fp = pb_build_opt_body(unsafe { view(*mb_fp) }, pt, mut_view(*arena), mut_view(*sink));
    let mut strict_caps = vec_avx2_target_caps();
    strict_caps.fp_mode = FP_MODE_STRICT;
    let ob_fp_bb0 = unsafe { opt_block_at((*ob_fp).blocks, 0) };
    let root_fp_idx = (unsafe { (*ob_fp_bb0).inst_count }) - 1;
    let strict_tree = slp_build_reduction_seed_tree(unsafe { view(*ob_fp) }, unsafe { view(*ob_fp_bb0) }, 0 as *const AliasInfo, view(strict_caps), OPT_PROFILE_SPEED_O2, root_fp_idx, mut_view(*arena));
    let mut relaxed_caps = vec_avx2_target_caps();
    relaxed_caps.fp_mode = FP_MODE_RELAXED;
    let relaxed_tree = slp_build_reduction_seed_tree(unsafe { view(*ob_fp) }, unsafe { view(*ob_fp_bb0) }, 0 as *const AliasInfo, view(relaxed_caps), OPT_PROFILE_SPEED_O2, root_fp_idx, mut_view(*arena));
    if strict_tree.is_valid || strict_tree.reject_reason != REASON_STRICT_FP_REDUCTION || !relaxed_tree.is_valid || !relaxed_tree.cost.profitable {
        return false;
    }

    // 4e. Unproven checked overflow in lane arithmetic -> `REASON_CHECKED_OVERFLOW_TRAP` + volatile barrier -> `REASON_VOLATILE_BARRIER`
    let mb_ov = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 3);
    let va_loc = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let vb_loc = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let vout_loc = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(*arena), pt.ty_vec4_i32, true);
    let bbov = pb_add_bb(unsafe { mut_view(*mb_ov) }, mut_view(*arena));
    f = 0u32;
    while f < 4u32 {
        let la = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(*arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(*arena), pt.ty_i32, false);
        let ls = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(*arena), pt.ty_i32, false);
        pb_push_load_field(unsafe { mut_view(*mb_ov) }, mut_view(*arena), bbov, la, va_loc, f);
        pb_push_load_field(unsafe { mut_view(*mb_ov) }, mut_view(*arena), bbov, lb, vb_loc, f);
        pb_push_binop(unsafe { mut_view(*mb_ov) }, mut_view(*arena), bbov, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(la), pb_op_copy(lb));
        pb_push_store_field(unsafe { mut_view(*mb_ov) }, mut_view(*arena), bbov, vout_loc, f, pb_op_copy(ls));
        f = f + 1u32;
    }
    pb_set_return(unsafe { mut_view(*mb_ov) }, bbov);

    let ob_ov = pb_build_opt_body(unsafe { view(*mb_ov) }, pt, mut_view(*arena), mut_view(*sink));
    let bb_ov0 = unsafe { opt_block_at((*ob_ov).blocks, 0) };
    unsafe {
        (*opt_inst_at((*bb_ov0).insts, 2)).opcode = OPT_INST_CHECKED_BINOP;
        (*opt_inst_at((*bb_ov0).insts, 6)).opcode = OPT_INST_CHECKED_BINOP;
        (*opt_inst_at((*bb_ov0).insts, 10)).opcode = OPT_INST_CHECKED_BINOP;
        (*opt_inst_at((*bb_ov0).insts, 14)).opcode = OPT_INST_CHECKED_BINOP;
    }
    let pm_ov = pb_init_pm(mut_view(*arena), unsafe { mut_view(*ob_ov) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_ov = opt_slp_vec(unsafe { mut_view(*pm_ov) }, unsafe { mut_view(*ob_ov) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(*arena), mut_view(*sink));
    if ch_ov || stats.rejected_checked_overflow == 0u32 {
        return false;
    }
    let contract = slp_vec_contract();
    contract.pass_id == PASS_SLP_VEC
}

fn probe_lir_vec_lower_128_256_movq_and_vzeroupper(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let sse2_caps = vec_default_target_caps();
    let avx2_caps = vec_avx2_target_caps();

    // 5a. Type legalization (`64-bit -> Vec128 MOVQ`, `128-bit -> Vec128`, `256-bit -> Vec256` on AVX2 vs `2xVec128` split on SSE2)
    let ty_64 = vec_lower_legalize_type(view(sse2_caps), VEC_ELEM_I32, 2u8);
    let ty_128 = vec_lower_legalize_type(view(sse2_caps), VEC_ELEM_I32, 4u8);
    let ty_256_avx2 = vec_lower_legalize_type(view(avx2_caps), VEC_ELEM_I32, 8u8);
    let ty_256_sse2 = vec_lower_legalize_type(view(sse2_caps), VEC_ELEM_I32, 8u8);
    if ty_64.vec_kind != LIR_VEC_TY_V128 || ty_64.total_bits != 64u16 || ty_64.alloc_bits != 128u16 ||
       ty_128.vec_kind != LIR_VEC_TY_V128 || ty_128.total_bits != 128u16 ||
       ty_256_avx2.vec_kind != LIR_VEC_TY_V256 || ty_256_avx2.reg_class != REG_CLASS_VEC256 ||
       ty_256_sse2.vec_kind != LIR_VEC_TY_V128 || ty_256_sse2.split_count != 2u8 {
        return false;
    }

    // 5b. Alignment flag selection (`ALIGN_KNOWN_ALIGNED` vs `ALIGN_UNKNOWN` / `ALIGN_KNOWN_UNALIGNED`)
    let mf_aligned = vec_lower_select_mem_flags(ALIGN_KNOWN_ALIGNED, 32u16, view(ty_256_avx2), false, false);
    let mf_unknown = vec_lower_select_mem_flags(ALIGN_UNKNOWN, 32u16, view(ty_256_avx2), false, false);
    let mf_unaligned = vec_lower_select_mem_flags(ALIGN_KNOWN_UNALIGNED, 8u16, view(ty_128), false, false);
    if (mf_aligned & LIR_MEM_FLAG_ALIGNED) == 0u8 || (mf_unknown & LIR_MEM_FLAG_ALIGNED) != 0u8 || (mf_unaligned & LIR_MEM_FLAG_ALIGNED) != 0u8 {
        return false;
    }

    // 5c. 64-bit MOVQ lowering + 256->2x128 splitting on SSE2 + integer DIV lane scalarization
    let mut vbody64: LirVecBody = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<LirVecBody>(), align_of<LirVecBody>()) as *mut LirVecBody) };
    let mut vstats64: VecLowerStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<VecLowerStats>(), align_of<VecLowerStats>()) as *mut VecLowerStats) };
    vec_lower_body_init(mut_view(vbody64), SymbolId { v: 1u32 }, sse2_caps.isa_level);
    vec_lower_stats_zero(mut_view(vstats64));
    let vr_a64 = vec_lower_emit_load(mut_view(vbody64), view(sse2_caps), VEC_ELEM_I32, 2u8, 1u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats64), mut_view(*arena));
    let vr_b64 = vec_lower_emit_load(mut_view(vbody64), view(sse2_caps), VEC_ELEM_I32, 2u8, 2u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats64), mut_view(*arena));
    let vr_s64 = vec_lower_emit_binop(mut_view(vbody64), view(sse2_caps), VEC_ELEM_I32, 2u8, MIR_BINOP_ADD, vr_a64, vr_b64, mut_view(vstats64), mut_view(*arena));
    vec_lower_emit_store(mut_view(vbody64), view(sse2_caps), VEC_ELEM_I32, 2u8, vr_s64, 3u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats64), mut_view(*arena));
    if vstats64.narrow_64_movq_emitted != 3u32 || !vec_lower_verify_body(view(vbody64), view(sse2_caps), mut_view(vstats64)) {
        return false;
    }

    let mut vbody_split: LirVecBody = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<LirVecBody>(), align_of<LirVecBody>()) as *mut LirVecBody) };
    let mut vstats_split: VecLowerStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<VecLowerStats>(), align_of<VecLowerStats>()) as *mut VecLowerStats) };
    vec_lower_body_init(mut_view(vbody_split), SymbolId { v: 2u32 }, sse2_caps.isa_level);
    vec_lower_stats_zero(mut_view(vstats_split));
    let vr_lo = vec_lower_emit_load(mut_view(vbody_split), view(sse2_caps), VEC_ELEM_I32, 8u8, 1u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats_split), mut_view(*arena));
    let vr_sum = vec_lower_emit_binop(mut_view(vbody_split), view(sse2_caps), VEC_ELEM_I32, 8u8, MIR_BINOP_ADD, vr_lo, vr_lo, mut_view(vstats_split), mut_view(*arena));
    vec_lower_emit_store(mut_view(vbody_split), view(sse2_caps), VEC_ELEM_I32, 8u8, vr_sum, 2u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats_split), mut_view(*arena));
    let _ = vec_lower_emit_binop(mut_view(vbody_split), view(sse2_caps), VEC_ELEM_I32, 4u8, MIR_BINOP_DIV, vr_lo, vr_lo, mut_view(vstats_split), mut_view(*arena));
    if vstats_split.split_256_to_128_pairs != 3u32 || vstats_split.scalarized_ops_emitted != 4u32 ||
       vbody_split.frame.uses_ymm || !vec_lower_verify_body(view(vbody_split), view(sse2_caps), mut_view(vstats_split)) {
        return false;
    }

    // 5d. End-to-end 8-lane AVX2 SLP + OptBody -> LirVecBody with YMM 32-byte frame alignment and VZEROUPPER before RET
    let mb8 = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 3);
    let a_loc = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(*arena), pt.ty_view_i32, true);
    let b_loc = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(*arena), pt.ty_view_i32, true);
    let out_loc = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(*arena), pt.ty_mut_view_i32, true);
    let bb8 = pb_add_bb(unsafe { mut_view(*mb8) }, mut_view(*arena));
    let mut k: u64 = 0u64;
    while k < 8u64 {
        let il = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(*arena), pt.ty_usize, false);
        let la = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(*arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(*arena), pt.ty_i32, false);
        let ls = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(*arena), pt.ty_i32, false);
        pb_push_const(unsafe { mut_view(*mb8) }, mut_view(*arena), bb8, il, pt.ty_usize, k);
        pb_push_load_deref_idx(unsafe { mut_view(*mb8) }, mut_view(*arena), bb8, la, a_loc, il);
        pb_push_load_deref_idx(unsafe { mut_view(*mb8) }, mut_view(*arena), bb8, lb, b_loc, il);
        pb_push_binop(unsafe { mut_view(*mb8) }, mut_view(*arena), bb8, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(la), pb_op_copy(lb));
        pb_push_store_deref_idx(unsafe { mut_view(*mb8) }, mut_view(*arena), bb8, out_loc, il, pb_op_copy(ls));
        k = k + 1u64;
    }
    pb_set_return(unsafe { mut_view(*mb8) }, bb8);

    let ob8 = pb_build_opt_body(unsafe { view(*mb8) }, pt, mut_view(*arena), mut_view(*sink));
    let bb_ob8 = unsafe { opt_block_at((*ob8).blocks, 0) };
    unsafe {
        (*opt_inst_at((*bb_ob8).insts, 1)).opcode = OPT_INST_VLOAD;
        (*opt_inst_at((*bb_ob8).insts, 2)).opcode = OPT_INST_VLOAD;
        (*opt_inst_at((*bb_ob8).insts, 3)).opcode = OPT_INST_VBINOP;
        (*opt_inst_at((*bb_ob8).insts, 4)).opcode = OPT_INST_VSTORE;
    }
    let mut vbody_avx2: LirVecBody = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<LirVecBody>(), align_of<LirVecBody>()) as *mut LirVecBody) };
    let mut vstats_avx2: VecLowerStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<VecLowerStats>(), align_of<VecLowerStats>()) as *mut VecLowerStats) };
    vec_lower_stats_zero(mut_view(vstats_avx2));
    if !vec_lower_opt_body(unsafe { view(*ob8) }, view(avx2_caps), 8u8, ALIGN_KNOWN_ALIGNED, 32u16, mut_view(vbody_avx2), mut_view(vstats_avx2), mut_view(*arena)) {
        return false;
    }
    vbody_avx2.frame.uses_ymm && vbody_avx2.frame.requires_32_byte_alignment &&
        vbody_avx2.frame.vzeroupper_before_ret && vstats_avx2.vzeroupper_emitted >= 1u32 &&
        vec_lower_verify_body(view(vbody_avx2), view(avx2_caps), mut_view(vstats_avx2))
}

fn probe_vector_remarks_and_emit_determinism(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let caps = vec_default_target_caps();
    let avx2_caps = vec_avx2_target_caps();

    // 6a. Loop volatile barrier rejection + `loop_vec_print` and `loop_vec_cost_print`
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr16_i32, true);
    let vi = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let vcnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let vval = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let vb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let vb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let vb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let vb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), vb0, vi, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, vb0, vb1);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), vb1, vcnd, MIR_BINOP_LT, pb_op_copy(vi), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), vb1, vcnd, vb2, vb3);
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), vb2, vval, arg_arr, vi);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), vb2, vi, MIR_BINOP_ADD, pb_op_copy(vi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, vb2, vb1);
    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), vb3, 0u32, vval);
    pb_set_return(unsafe { mut_view(*mb) }, vb3);

    let mut vpm = 0 as *mut PassManager;
    let mut valias = 0 as *const AliasInfo;
    let vob = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(vpm), mut_view(valias));
    let b2_opt = unsafe { opt_block_at((*vob).blocks, vb2 as usize) };
    let vinst = unsafe { opt_inst_at((*b2_opt).insts, 0) };
    unsafe {
        (*vinst).opcode = OPT_INST_VOLATILE_LOAD;
        (*vinst).flags = OPT_FLAG_BARRIER;
    }

    let mut vstats = pb_zero_vec_stats();
    let vchanged = opt_loop_vec(unsafe { mut_view(*vpm) }, unsafe { mut_view(*vob) }, 0 as *const EffectCallTable, valias, mut_view(vstats), mut_view(*arena), mut_view(*sink));
    if vchanged || vstats.rejected_volatile != 1u32 {
        return false;
    }

    let mut dbuf1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dbuf1));
    loop_vec_print(view(vstats), mut_view(dbuf1));

    let vtree = loops_discover(unsafe { view(*vob) }, 0 as *const EffectCallTable, valias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*vtree) }, unsafe { view(*vob) }, valias, mut_view(*arena));
    let vlp = unsafe { loop_desc_at((*vtree).loops, 0) };
    let vleg = vec_analyze_loop_legality(unsafe { view(*vtree) }, unsafe { view(*vlp) }, unsafe { view(*vob) }, valias, 0 as *const RangeInfo, view(caps), false, mut_view(*arena));
    let vcost = vec_estimate_cost(unsafe { view(*vlp) }, view(vleg), view(caps), OPT_PROFILE_SPEED_O2);
    let mut dbuf2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dbuf2));
    loop_vec_cost_print(view(vcost), mut_view(dbuf2));

    // 6b. `slp_vec_print` and `vec_lower_print` deterministic output
    let mut slp_stats: SlpVecStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<SlpVecStats>(), align_of<SlpVecStats>()) as *mut SlpVecStats) };
    slp_vec_stats_zero(mut_view(slp_stats));
    let mut vbody: LirVecBody = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<LirVecBody>(), align_of<LirVecBody>()) as *mut LirVecBody) };
    let mut lstats: VecLowerStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<VecLowerStats>(), align_of<VecLowerStats>()) as *mut VecLowerStats) };
    vec_lower_body_init(mut_view(vbody), SymbolId { v: 9u32 }, avx2_caps.isa_level);
    vec_lower_stats_zero(mut_view(lstats));
    let _ = vec_lower_emit_load(mut_view(vbody), view(avx2_caps), VEC_ELEM_I32, 8u8, 1u32, 0i32, ALIGN_KNOWN_ALIGNED, 32u16, mut_view(lstats), mut_view(*arena));

    let mut dbuf3 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dbuf3));
    slp_vec_print(view(slp_stats), mut_view(dbuf3));
    vec_lower_print(view(vbody), view(lstats), mut_view(dbuf3));

    dbuf1.len > 80 && dbuf2.len > 40 && dbuf3.len > 60
}

pub fn main() -> i32 {
    let mut arena = arena_with_chunk_size(4194304);
    let _ = arena_alloc_raw(mut_view(arena), 16, 8);
    let sink_ptr = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }
    let pt = pb_init_types(mut_view(arena));

    if !probe_loop_vec_cap_scev_and_guards(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("PROBE_LOOP_VEC_CAP_SCEV_AND_GUARDS=FAIL\n");
        return 1;
    }
    print("PROBE_LOOP_VEC_CAP_SCEV_AND_GUARDS=OK\n");

    if !probe_loop_vec_reductions_and_fp_legality(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("PROBE_LOOP_VEC_REDUCTIONS_AND_FP_LEGALITY=FAIL\n");
        return 2;
    }
    print("PROBE_LOOP_VEC_REDUCTIONS_AND_FP_LEGALITY=OK\n");

    if !probe_loop_vec_widths_epilogues_and_provenance(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("PROBE_LOOP_VEC_WIDTHS_EPILOGUES_AND_PROVENANCE=FAIL\n");
        return 3;
    }
    print("PROBE_LOOP_VEC_WIDTHS_EPILOGUES_AND_PROVENANCE=OK\n");

    if !probe_slp_pack_trees_reductions_and_barriers(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("PROBE_SLP_PACK_TREES_REDUCTIONS_AND_BARRIERS=FAIL\n");
        return 4;
    }
    print("PROBE_SLP_PACK_TREES_REDUCTIONS_AND_BARRIERS=OK\n");

    if !probe_slp_horiz_and_safety_barriers(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("PROBE_SLP_HORIZ_AND_SAFETY_BARRIERS=FAIL\n");
        return 5;
    }
    print("PROBE_SLP_HORIZ_AND_SAFETY_BARRIERS=OK\n");

    if !probe_lir_vec_lower_128_256_movq_and_vzeroupper(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("PROBE_LIR_VEC_LOWER_128_256_MOVQ_AND_VZEROUPPER=FAIL\n");
        return 6;
    }
    print("PROBE_LIR_VEC_LOWER_128_256_MOVQ_AND_VZEROUPPER=OK\n");

    if !probe_vector_remarks_and_emit_determinism(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("PROBE_VECTOR_REMARKS_AND_EMIT_DETERMINISM=FAIL\n");
        return 7;
    }
    print("PROBE_VECTOR_REMARKS_AND_EMIT_DETERMINISM=OK\n");

    print("E15.5-PROBE: ALL-OK\n");
    0
}
