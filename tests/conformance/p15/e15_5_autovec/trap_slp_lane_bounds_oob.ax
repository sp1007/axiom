// test: diff
// exit: 101
// stdout: 11\n22\n33\n

fn slp_lane_oob_must_trap(dst: mut_view<[i32]>, src: view<[i32]>) -> i32 {
    dst[0] = src[0] + 1;
    print_int(dst[0]);
    print("\n");
    dst[1] = src[1] + 2;
    print_int(dst[1]);
    print("\n");
    dst[2] = src[2] + 3;
    print_int(dst[2]);
    print("\n");
    dst[3] = src[3] + 4;
    dst[0] + dst[1] + dst[2] + dst[3]
}

fn main() -> i32 {
    let src: [3]i32 = [10, 20, 30];
    let mut dst: [4]i32 = [0; 4];
    let v: i32 = slp_lane_oob_must_trap(mut_view(dst), view(src));
    print_int(v);
    0
}
