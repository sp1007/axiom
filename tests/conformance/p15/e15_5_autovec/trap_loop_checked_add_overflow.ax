// test: diff
// exit: 101
// stdout: 100\n200\n

fn checked_loop_sum_must_trap(s: view<[i32]>) -> i32 {
    let p0: i32 = 100;
    let p1: i32 = 200;
    print_int(p0);
    print("\n");
    print_int(p1);
    print("\n");
    let mut i: usize = 0;
    let mut acc: i32 = 2000000000;
    while i < len(s) {
        acc = acc + s[i];
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let arr: [6]i32 = [50000000, 50000000, 50000000, 50000000, 50000000, 50000000];
    let v: i32 = checked_loop_sum_must_trap(view(arr));
    print_int(v);
    0
}
