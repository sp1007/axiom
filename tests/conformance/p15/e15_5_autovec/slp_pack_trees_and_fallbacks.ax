// test: diff
// exit: 0
// stdout-file: slp_pack_trees_and_fallbacks.stdout

struct SlpGuard {
    id: i32,
}

impl Drop for SlpGuard {
    fn drop(self: mut_view<SlpGuard>) {
        print("DROP_SLP_GUARD=");
        print_int(self.id);
        print("\n");
    }
}

@derive(Copy)
struct Vec2i {
    x: i32,
    y: i32,
}

@derive(Copy)
struct Vec2i64 {
    x: i64,
    y: i64,
}

@derive(Copy)
struct Vec4i {
    x: i32,
    y: i32,
    z: i32,
    w: i32,
}

fn kernel_vec2_slp(a: view<Vec2i>, b: view<Vec2i>) -> i32 {
    let mut out = Vec2i { x: 0, y: 0 };
    out.x = a.x * 2 + b.x;
    out.y = a.y * 2 + b.y;
    out.x + out.y
}

fn kernel_vec2_i64_slp(a: view<Vec2i64>, b: view<Vec2i64>) -> i32 {
    let mut out = Vec2i64 { x: 0i64, y: 0i64 };
    out.x = a.x * 2i64 + b.x;
    out.y = a.y * 2i64 + b.y;
    (out.x + out.y) as i32
}

fn kernel_vec4_slp(a: view<Vec4i>, b: view<Vec4i>, scale: i32) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.w = a.w * scale + b.w;
    out.z = a.z * scale + b.z;
    out.y = a.y * scale + b.y;
    out.x = a.x * scale + b.x;
    out.x + out.y + out.z + out.w
}

fn kernel_arr8_slp(dst: mut_view<[i32]>, a: view<[i32]>, b: view<[i32]>) -> i32 {
    dst[0] = a[0] * 2 + b[0];
    dst[1] = a[1] * 2 + b[1];
    dst[2] = a[2] * 2 + b[2];
    dst[3] = a[3] * 2 + b[3];
    dst[4] = a[4] * 2 + b[4];
    dst[5] = a[5] * 2 + b[5];
    dst[6] = a[6] * 2 + b[6];
    dst[7] = a[7] * 2 + b[7];
    dst[0] + dst[1] + dst[2] + dst[3] + dst[4] + dst[5] + dst[6] + dst[7]
}

fn kernel_commute4_slp(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.x = a.x + b.x;
    out.y = b.y + a.y;
    out.z = a.z + b.z;
    out.w = b.w + a.w;
    out.x + out.y + out.z + out.w
}

fn kernel_unrolled_stride4(dst: mut_view<[i32]>, a: view<[i32]>, b: view<[i32]>, base: usize) -> i32 {
    let i0: usize = base;
    let i1: usize = base + 1;
    let i2: usize = base + 2;
    let i3: usize = base + 3;
    dst[i0] = a[i0] * 2 + b[i0];
    dst[i1] = a[i1] * 2 + b[i1];
    dst[i2] = a[i2] * 2 + b[i2];
    dst[i3] = a[i3] * 2 + b[i3];
    dst[i0] + dst[i1] + dst[i2] + dst[i3]
}

fn kernel_horiz_dot(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let p0: i32 = a.x * b.x;
    let p1: i32 = a.y * b.y;
    let p2: i32 = a.z * b.z;
    let p3: i32 = a.w * b.w;
    (p0 + p1) + (p2 + p3)
}

fn kernel_horiz_xor(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let x0: i32 = a.x ^ b.x;
    let x1: i32 = a.y ^ b.y;
    let x2: i32 = a.z ^ b.z;
    let x3: i32 = a.w ^ b.w;
    (x0 ^ x1) ^ (x2 ^ x3)
}

fn kernel_ext_extract_use(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let s0: i32 = a.x * 2 + b.x;
    let s1: i32 = a.y * 2 + b.y;
    let s2: i32 = a.z * 2 + b.z;
    let s3: i32 = a.w * 2 + b.w;
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.x = s0;
    out.y = s1;
    out.z = s2;
    out.w = s3;
    let ext_bonus: i32 = s1 * 2 + s0 + 14;
    (out.x + out.y + out.z + out.w) + ext_bonus
}

fn kernel_scatter_gather(src: view<[i32]>) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.x = src[7] + 2;
    out.y = src[2] - 3;
    out.z = src[5] / 2;
    out.w = src[1] - 2;
    out.x + out.y + out.z + out.w
}

fn kernel_alias_interleave(buf: mut_view<[i32]>) -> i32 {
    buf[0] = buf[0] + 5;
    buf[1] = buf[0] + 7;
    buf[2] = buf[1] + 3;
    buf[3] = buf[2] + 1;
    buf[0] + buf[1] + buf[2] + buf[3]
}

fn kernel_dep_chain(seed: i32) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    let t0: i32 = seed;
    let t1: i32 = t0 * 2;
    let t2: i32 = t1 + 25;
    let t3: i32 = t2 + 40;
    out.x = t0;
    out.y = t1;
    out.z = t2;
    out.w = t3;
    out.x + out.y + out.z + out.w
}

fn run_slp_suite() -> [12]i32 {
    let g = SlpGuard { id: 91 };
    let v2a = Vec2i { x: 10, y: 10 };
    let v2b = Vec2i { x: 3, y: 11 };
    let r2: i32 = kernel_vec2_slp(view(v2a), view(v2b));

    let i2a = Vec2i64 { x: 7i64, y: 13i64 };
    let i2b = Vec2i64 { x: 2i64, y: 6i64 };
    let ri2: i32 = kernel_vec2_i64_slp(view(i2a), view(i2b));

    let v4a = Vec4i { x: 10, y: 20, z: 30, w: 40 };
    let v4b = Vec4i { x: 10, y: 20, z: 30, w: -20 };
    let r4: i32 = kernel_vec4_slp(view(v4a), view(v4b), 3);

    let a8: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let b8: [8]i32 = [5, 10, 15, 20, 25, 30, 35, -80];
    let mut dst8: [8]i32 = [0; 8];
    let r8: i32 = kernel_arr8_slp(mut_view(dst8), view(a8), view(b8));

    let ca = Vec4i { x: 15, y: 25, z: 35, w: 45 };
    let cb = Vec4i { x: 5, y: 15, z: 25, w: 55 };
    let rc: i32 = kernel_commute4_slp(view(ca), view(cb));

    let ua: [8]i32 = [10, 20, 30, 40, 25, 35, 45, 55];
    let ub: [8]i32 = [5, 10, 15, 20, 30, 40, 60, 70];
    let mut udst: [8]i32 = [0; 8];
    let u4: i32 = kernel_unrolled_stride4(mut_view(udst), view(ua), view(ub), 4);

    let da = Vec4i { x: 3, y: 5, z: 7, w: 9 };
    let db = Vec4i { x: 4, y: 6, z: 8, w: 12 };
    let hadd: i32 = kernel_horiz_dot(view(da), view(db));

    let xa = Vec4i { x: 1, y: 2, z: 4, w: 8 };
    let xb = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    let hxor: i32 = kernel_horiz_xor(view(xa), view(xb));

    let ea = Vec4i { x: 10, y: 20, z: 30, w: 40 };
    let eb = Vec4i { x: 5, y: 10, z: 15, w: 20 };
    let ext: i32 = kernel_ext_extract_use(view(ea), view(eb));

    let src: [8]i32 = [11, 22, 33, 44, 55, 66, 77, 88];
    let sg: i32 = kernel_scatter_gather(view(src));

    let mut buf: [4]i32 = [10, 20, 30, 40];
    let al: i32 = kernel_alias_interleave(mut_view(buf));

    let dc: i32 = kernel_dep_chain(15);
    let _ = g.id;
    [r2, ri2, r4, r8, rc, u4, hadd, hxor, ext, sg, al, dc]
}

fn main() -> i32 {
    print("E15_5_SLP_BANNER=Xin chào kiểm thử đóng gói SLP E15.5\n");
    let res: [12]i32 = run_slp_suite();
    print("VEC2=");
    print_int(res[0]);
    print("\nVEC2_I64=");
    print_int(res[1]);
    print("\nVEC4=");
    print_int(res[2]);
    print("\nARR8=");
    print_int(res[3]);
    print("\nCOMMUTE4=");
    print_int(res[4]);
    print("\nUNROLL4=");
    print_int(res[5]);
    print("\nHORIZ_ADD=");
    print_int(res[6]);
    print("\nHORIZ_XOR=");
    print_int(res[7]);
    print("\nEXT_USE=");
    print_int(res[8]);
    print("\nSCATTER_GATHER=");
    print_int(res[9]);
    print("\nALIAS_INTERLEAVE=");
    print_int(res[10]);
    print("\nDEP_CHAIN=");
    print_int(res[11]);
    print("\n");
    0
}
