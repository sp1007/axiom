// test: diff
// exit: 0
// stdout-file: loop_vec_all_widths_and_epilogues.stdout

struct VecGuard {
    id: i32,
}

impl Drop for VecGuard {
    fn drop(self: mut_view<VecGuard>) {
        print("DROP_VEC_GUARD=");
        print_int(self.id);
        print("\n");
    }
}

fn fill_i32_inputs(a: mut_view<[i32]>, b: mut_view<[i32]>) {
    let mut i: usize = 0;
    while i < len(a) && i < len(b) {
        let iv: i32 = i as i32;
        a[i] = iv + 2;
        b[i] = iv * 2 + 5;
        i = i + 1;
    }
}

fn kernel_cap_disjoint_i32(dst: mut_view<[i32]>, a: view<[i32]>, b: view<[i32]>, scale: i32, bias: i32, n: usize) -> i32 {
    let mut i: usize = 0;
    while i < n && i < len(dst) && i < len(a) && i < len(b) {
        dst[i] = a[i] * scale + b[i] + bias;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < n && k < len(dst) {
        sum = sum + dst[k];
        k = k + 1;
    }
    sum
}

fn kernel_predicated_blend_i32(dst: mut_view<[i32]>, a: view<[i32]>, b: view<[i32]>, n: usize) -> i32 {
    let mut i: usize = 0;
    while i < n && i < len(dst) && i < len(a) && i < len(b) {
        let av: i32 = a[i];
        let bv: i32 = b[i];
        let picked: i32 = if av > 6 { av + 10 } else { bv + 1 };
        dst[i] = picked;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut acc: i32 = 0;
    while k < n && k < len(dst) {
        acc = acc + dst[k];
        k = k + 1;
    }
    acc
}

fn kernel_widths_i8_u8(n: usize) -> i32 {
    let mut a8: [20]i8 = [0i8; 20];
    let mut b8: [20]i8 = [0i8; 20];
    let mut d8: [20]i8 = [0i8; 20];
    let mut au8: [20]u8 = [0u8; 20];
    let mut bu8: [20]u8 = [0u8; 20];
    let mut du8: [20]u8 = [0u8; 20];
    let mut i: usize = 0;
    while i < n && i < 20 {
        a8[i] = (i as i8) + 1i8;
        b8[i] = 2i8;
        au8[i] = (i as u8) + 3u8;
        bu8[i] = 4u8;
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < n && j < 20 {
        d8[j] = a8[j] + b8[j];
        du8[j] = au8[j] + bu8[j];
        j = j + 1;
    }
    let mut k: usize = 0;
    let mut total: i32 = 0;
    while k < n && k < 20 {
        total = total + (d8[k] as i32) + (du8[k] as i32);
        k = k + 1;
    }
    total
}

fn kernel_widths_i16_u16(n: usize) -> i32 {
    let mut a16: [16]i16 = [0i16; 16];
    let mut b16: [16]i16 = [0i16; 16];
    let mut d16: [16]i16 = [0i16; 16];
    let mut au16: [16]u16 = [0u16; 16];
    let mut bu16: [16]u16 = [0u16; 16];
    let mut du16: [16]u16 = [0u16; 16];
    let mut i: usize = 0;
    while i < n && i < 16 {
        a16[i] = (i as i16) * 2i16 + 1i16;
        b16[i] = 5i16;
        au16[i] = (i as u16) * 3u16 + 2u16;
        bu16[i] = 7u16;
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < n && j < 16 {
        d16[j] = a16[j] + b16[j];
        du16[j] = au16[j] + bu16[j];
        j = j + 1;
    }
    let mut k: usize = 0;
    let mut total: i32 = 0;
    while k < n && k < 16 {
        total = total + (d16[k] as i32) + (du16[k] as i32);
        k = k + 1;
    }
    total
}

fn kernel_widths_u32(n: usize) -> i32 {
    let mut au32: [16]u32 = [0u32; 16];
    let mut bu32: [16]u32 = [0u32; 16];
    let mut du32: [16]u32 = [0u32; 16];
    let mut i: usize = 0;
    while i < n && i < 16 {
        au32[i] = (i as u32) * 3u32 + 4u32;
        bu32[i] = 6u32;
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < n && j < 16 {
        du32[j] = au32[j] * 2u32 + bu32[j];
        j = j + 1;
    }
    let mut k: usize = 0;
    let mut total: u32 = 0u32;
    while k < n && k < 16 {
        total = total + du32[k];
        k = k + 1;
    }
    total as i32
}

fn kernel_widths_i64_u64(n: usize) -> i64 {
    let mut a64: [12]i64 = [0i64; 12];
    let mut b64: [12]i64 = [0i64; 12];
    let mut d64: [12]i64 = [0i64; 12];
    let mut au64: [12]u64 = [0u64; 12];
    let mut bu64: [12]u64 = [0u64; 12];
    let mut du64: [12]u64 = [0u64; 12];
    let mut i: usize = 0;
    while i < n && i < 12 {
        a64[i] = (i as i64) * 10i64 + 3i64;
        b64[i] = 7i64;
        au64[i] = (i as u64) * 5u64 + 1u64;
        bu64[i] = 9u64;
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < n && j < 12 {
        d64[j] = a64[j] + b64[j];
        du64[j] = au64[j] + bu64[j];
        j = j + 1;
    }
    let mut k: usize = 0;
    let mut total: i64 = 0i64;
    while k < n && k < 12 {
        total = total + d64[k] + (du64[k] as i64);
        k = k + 1;
    }
    total
}

fn run_all_width_kernels() -> [12]i32 {
    let g = VecGuard { id: 77 };
    let mut a: [32]i32 = [0; 32];
    let mut b: [32]i32 = [0; 32];
    let mut dst: [32]i32 = [0; 32];
    fill_i32_inputs(mut_view(a), mut_view(b));

    let s0: i32 = kernel_cap_disjoint_i32(mut_view(dst), view(a), view(b), 2, 10, 0);
    let s1: i32 = kernel_cap_disjoint_i32(mut_view(dst), view(a), view(b), 2, 10, 1);
    let s3: i32 = kernel_cap_disjoint_i32(mut_view(dst), view(a), view(b), 2, 10, 3);
    let s4: i32 = kernel_cap_disjoint_i32(mut_view(dst), view(a), view(b), 2, 10, 4);
    let s7: i32 = kernel_cap_disjoint_i32(mut_view(dst), view(a), view(b), 2, 10, 7);
    let s8: i32 = kernel_cap_disjoint_i32(mut_view(dst), view(a), view(b), 2, 10, 8);
    let s19: i32 = kernel_cap_disjoint_i32(mut_view(dst), view(a), view(b), 2, 10, 19);
    let s31: i32 = kernel_cap_disjoint_i32(mut_view(dst), view(a), view(b), 2, 10, 31);
    let blend: i32 = kernel_predicated_blend_i32(mut_view(dst), view(a), view(b), 11);
    let w8: i32 = kernel_widths_i8_u8(19);
    let w16: i32 = kernel_widths_i16_u16(13);
    let w32_64: i32 = kernel_widths_u32(9) + (kernel_widths_i64_u64(11) as i32);
    let _ = g.id;
    [s0, s1, s3, s4, s7, s8, s19, s31, blend, w8, w16, w32_64]
}

fn main() -> i32 {
    print("E15_5_LOOP_BANNER=Xin chào kiểm thử tương đương vector hóa E15.5\n");
    let res: [12]i32 = run_all_width_kernels();
    print("N0=");
    print_int(res[0]);
    print("\nN1=");
    print_int(res[1]);
    print("\nN3=");
    print_int(res[2]);
    print("\nN4=");
    print_int(res[3]);
    print("\nN7=");
    print_int(res[4]);
    print("\nN8=");
    print_int(res[5]);
    print("\nN19=");
    print_int(res[6]);
    print("\nN31=");
    print_int(res[7]);
    print("\nBLEND=");
    print_int(res[8]);
    print("\nW8_U8=");
    print_int(res[9]);
    print("\nW16_U16=");
    print_int(res[10]);
    print("\nW32_64=");
    print_int(res[11]);
    print("\n");
    0
}
