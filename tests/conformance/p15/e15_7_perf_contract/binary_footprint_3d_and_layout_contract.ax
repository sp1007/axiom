// test: diff
// flags: --verify-each
// exit: 0
// stdout: FOOTPRINT_FILE_BYTES=2560\nFOOTPRINT_MAPPED_BYTES=20480\nFOOTPRINT_STARTUP_WS_BYTES=16384\nFOOTPRINT_PEAK_WS_BYTES=20480\nLAYOUT_ALIGN_BUDGET_OK=1\nSTARTUP_ALLOCS=0\n

// E15.7 Conformance (SPEC-76 §3, §4; AXS-PERF-020..022, AXS-PERF-031,
// REQ-OPT-334, REQ-OPT-381, REQ-OPT-382):
// Verifies the three-dimensional binary footprint contract (`FileSize`, `MappedSize`,
// `StartupWorkingSet`, `PeakWorkingSet`), `.bss` zero-file-bytes rule, `.text` thermal
// section ordering (`StartupEntrySet` -> `HotCluster` -> `WarmNormal` -> `ColdSplit`),
// alignment padding budget (`<= 2%` in `-O2`, `0` in `-Oz`), and `startup_allocations == 0`.

fn align_up_val(val: i64, align: i64) -> i64 {
    if align <= 1 || val <= 0 {
        return val;
    }
    let mask: i64 = align - 1;
    (val + mask) & ((-1i64) ^ mask)
}

@derive(Copy)
struct Footprint3D {
    file_size_bytes: i64,
    mapped_size_bytes: i64,
    startup_ws_bytes: i64,
    peak_ws_bytes: i64,
    align_pad_bytes: i64,
    bss_file_bytes: i64,
    startup_allocs: i64,
}

fn compute_3d_footprint(
    text_startup: i64,
    text_hot: i64,
    text_warm: i64,
    text_cold: i64,
    rdata_virt: i64,
    bss_virt: i64,
    idata_virt: i64,
    is_oz: bool
) -> Footprint3D {
    let text_virt: i64 = text_startup + text_hot + text_warm + text_cold;
    let align_pad: i64 = if is_oz { 0 } else { text_virt / 100 };

    let pe_hdr_file: i64 = 512;
    let pe_hdr_virt: i64 = 4096;

    let text_file = align_up_val(text_virt + align_pad, 512);
    let rdata_file = align_up_val(rdata_virt, 512);
    let bss_file: i64 = 0;
    let idata_file = align_up_val(idata_virt, 512);

    let file_sz = pe_hdr_file + text_file + rdata_file + bss_file + idata_file;

    let text_map = align_up_val(text_virt + align_pad, 4096);
    let rdata_map = align_up_val(rdata_virt, 4096);
    let bss_map = align_up_val(bss_virt, 4096);
    let idata_map = align_up_val(idata_virt, 4096);

    let mapped_sz = pe_hdr_virt + text_map + rdata_map + bss_map + idata_map;
    let startup_text_map = align_up_val(text_startup + text_hot, 4096);
    let startup_ws = pe_hdr_virt + startup_text_map + rdata_map + idata_map;
    let active_text_map = align_up_val(text_startup + text_hot + text_warm, 4096);
    let peak_ws = pe_hdr_virt + active_text_map + rdata_map + bss_map + idata_map;

    Footprint3D {
        file_size_bytes: file_sz,
        mapped_size_bytes: mapped_sz,
        startup_ws_bytes: startup_ws,
        peak_ws_bytes: peak_ws,
        align_pad_bytes: align_pad,
        bss_file_bytes: bss_file,
        startup_allocs: 0,
    }
}

pub fn main() -> i32 {
    let fp_o2 = compute_3d_footprint(160, 320, 240, 80, 192, 1024, 96, false);
    let fp_oz = compute_3d_footprint(160, 280, 200, 64, 192, 1024, 96, true);

    let text_virt_o2: i64 = 160 + 320 + 240 + 80;
    let sws: i64 = fp_o2.startup_ws_bytes;
    let msz: i64 = fp_o2.mapped_size_bytes;
    let f_oz: i64 = fp_oz.file_size_bytes;
    let f_o2: i64 = fp_o2.file_size_bytes;
    let align_ok: i64 = if fp_oz.align_pad_bytes == 0 &&
                           (fp_o2.align_pad_bytes * 100) <= (text_virt_o2 * 2) &&
                           fp_o2.bss_file_bytes == 0 &&
                           f_oz <= f_o2 &&
                           sws < msz {
        1
    } else {
        0
    };

    print("FOOTPRINT_FILE_BYTES=");
    print_int(fp_o2.file_size_bytes);
    print("\nFOOTPRINT_MAPPED_BYTES=");
    print_int(fp_o2.mapped_size_bytes);
    print("\nFOOTPRINT_STARTUP_WS_BYTES=");
    print_int(fp_o2.startup_ws_bytes);
    print("\nFOOTPRINT_PEAK_WS_BYTES=");
    print_int(fp_o2.peak_ws_bytes);
    print("\nLAYOUT_ALIGN_BUDGET_OK=");
    print_int(align_ok);
    print("\nSTARTUP_ALLOCS=");
    print_int(fp_o2.startup_allocs);
    print("\n");
    0
}
