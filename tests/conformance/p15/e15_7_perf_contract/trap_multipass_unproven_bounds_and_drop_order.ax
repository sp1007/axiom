// test: diff
// flags: --verify-each
// exit: 101
// stdout: PRE_TRAP_HOT_SUM=100\nTRACE_DROP_LIFO=321321\n

// E15.7 Conformance (SPEC-76 §§1, 6.3; AXS-PERF-001..003, REQ-OPT-252, REQ-OPT-256, REQ-OPT-295):
// Even when prior hot iterations satisfy `0 <= idx < len` and `SROA` / `BCE` / `LICM` optimize
// the hot loop, an unproven dynamic index (`idx == 5` on `[5]i64`) MUST retain its bounds check
// and trap with exit code 101 after flushing deterministic LIFO `Drop` side effects.

struct TraceGuard {
    id: i64,
}

impl Drop for TraceGuard {
    fn drop(self: mut_view<TraceGuard>) {
        print_int(self.id);
    }
}

fn run_scoped_lifo_guards() {
    let _g1 = TraceGuard { id: 1 };
    let _g2 = TraceGuard { id: 2 };
    let _g3 = TraceGuard { id: 3 };
}

fn checked_lookup_entry(idx: usize, bias: i64) -> i64 {
    let xs: [5]i64 = [10, 20, 30, 40, 50];
    xs[idx] + bias
}

pub fn main() -> i32 {
    let mut hot_sum: i64 = 0;
    let mut i: usize = 0;
    while i < 4 {
        hot_sum = hot_sum + checked_lookup_entry(i, 0);
        i = i + 1;
    }
    print("PRE_TRAP_HOT_SUM=");
    print_int(hot_sum);
    print("\nTRACE_DROP_LIFO=");
    run_scoped_lifo_guards();
    run_scoped_lifo_guards();
    print("\n");

    // Unconstrained index 5 is out-of-bounds for `[5]i64` -> must trap with exit 101!
    let oob_val = checked_lookup_entry(5, 7);
    print_int(oob_val);
    0
}
