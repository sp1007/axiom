// test: diff
// flags: --verify-each
// exit: 101
// stdout: VERIFIED_MIR_FAST_PATH=120\n

// E15.7 Conformance (SPEC-76 §§1, 2; AXS-PERF-001, AXS-PERF-003, AXS-PERF-004,
// REQ-OPT-242, REQ-OPT-251, REQ-OPT-252, REQ-OPT-256):
// Neither PGO (`--pgo-use`), auto-tuning feedback, nor `-O2` loop/if-conversion passes may
// weaken the `Verified MIR` boundary or erase a cold division-by-zero / panic trap when
// 100% of prior training iterations took the fast non-zero divisor path.

fn guarded_kernel_step(numer: i64, denom: i64) -> i64 {
    // When `denom == 0`, checked division MUST trap with exit 101 across all profiles.
    (numer * 3) / denom
}

pub fn main() -> i32 {
    let denoms: [5]i64 = [2, 3, 6, 9, 0];
    let mut sum: i64 = 0;
    let mut i: usize = 0;
    while i < 4 {
        sum = sum + guarded_kernel_step(36, denoms[i]);
        i = i + 1;
    }
    print("VERIFIED_MIR_FAST_PATH=");
    print_int(sum);
    print("\n");

    // 5th element has `denoms[4] == 0` -> must trap with exit 101!
    let trap_val = guarded_kernel_step(36, denoms[4]);
    print_int(trap_val);
    0
}
