// test: diff
// flags: --verify-each
// exit: 101
// stdout: SAFE_ARITH_PREFIX=90\n

// E15.7 Conformance (SPEC-76 §§1, 2, 6.3; AXS-PERF-001, AXS-PERF-003, REQ-OPT-295):
// Switching between `--interp`, `-O0`, `-O1`, `-O2`, and `-Oz` MUST NEVER disable checked
// integer overflow traps or treat signed overflow as C-style undefined behavior.

fn accumulate_safe_prefix() -> i32 {
    let mut acc: i32 = 0;
    let mut i: i32 = 1;
    while i <= 6 {
        acc = acc + (i * 4) + 1;
        i = i + 1;
    }
    acc
}

fn step_to_i32_max(steps: i32) -> i32 {
    let mut v: i32 = 2147483643;
    let mut i: i32 = 0;
    while i < steps {
        v = v + 1;
        i = i + 1;
    }
    v
}

pub fn main() -> i32 {
    let prefix = accumulate_safe_prefix();
    print("SAFE_ARITH_PREFIX=");
    print_int(prefix as i64);
    print("\n");

    let near_max = step_to_i32_max(4);
    // `near_max == 2147483647` (`i32.MAX`); checked `+ 1` MUST trap even if followed by `- 1`!
    let overflowed = (near_max + 1) - 1;
    if overflowed == near_max {
        return 0;
    }
    1
}
