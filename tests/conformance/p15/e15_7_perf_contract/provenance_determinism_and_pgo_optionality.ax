// test: diff
// flags: --verify-each
// exit: 0
// stdout: PGO_OPTIONAL_NO_PROFILE=799\nAUTOTUNE_LEGAL_O2_CAND=4\nAUTOTUNE_LEGAL_OZ_CAND=3\nPROVENANCE_ORTHOGONAL=1\nORIGIN_CHAIN_PRESERVED=1\n

// E15.7 Conformance (SPEC-76 §§1, 4; AXS-PERF-003..005, AXS-PERF-030..032,
// REQ-OPT-242, REQ-OPT-243, REQ-OPT-244, REQ-OPT-245, REQ-OPT-251, REQ-OPT-252,
// REQ-OPT-253, REQ-OPT-254, REQ-OPT-255, REQ-OPT-256):
// Verifies:
//   - PGO optionality and valid execution without profile data (`REQ-OPT-251`, `REQ-OPT-252`)
//   - Auto-tuning legality-first candidate filtering and hard resource bounds (`REQ-OPT-242`, `REQ-OPT-243`)
//   - Profile & feedback provenance digest determinism and telemetry orthogonality (`REQ-OPT-244`, `REQ-OPT-245`, `REQ-OPT-255`)
//   - Source provenance (`OptOrigin`) preservation across multi-pass optimization (`REQ-OPT-254`, `REQ-OPT-256`)

@derive(Copy)
struct TuneCandidateSpec {
    cand_id: i64,
    unroll: i64,
    vec_bits: i64,
    legality_proven: bool,
    median_us: i64,
    wall_ms: i64,
    code_bytes: i64,
}

fn evaluate_bounded_autotune(prefer_size: bool, max_cands: i64, max_wall_ms: i64) -> i64 {
    let cands: [5]TuneCandidateSpec = [
        TuneCandidateSpec { cand_id: 1, unroll: 1, vec_bits: 0, legality_proven: true, median_us: 410, wall_ms: 15, code_bytes: 3584 },
        // Candidate 2 is fastest (85us) but lacks static legality proof -> MUST be rejected (REQ-OPT-242)!
        TuneCandidateSpec { cand_id: 2, unroll: 8, vec_bits: 256, legality_proven: false, median_us: 85, wall_ms: 10, code_bytes: 2048 },
        TuneCandidateSpec { cand_id: 3, unroll: 2, vec_bits: 128, legality_proven: true, median_us: 275, wall_ms: 20, code_bytes: 3072 },
        TuneCandidateSpec { cand_id: 4, unroll: 4, vec_bits: 256, legality_proven: true, median_us: 215, wall_ms: 20, code_bytes: 3840 },
        // Candidate 5 exceeds max_cands=3 / max_wall_ms=55 -> rejected by budget (REQ-OPT-243)!
        TuneCandidateSpec { cand_id: 5, unroll: 8, vec_bits: 256, legality_proven: true, median_us: 180, wall_ms: 25, code_bytes: 4096 },
    ];

    let mut evaluated: i64 = 0;
    let mut accum_ms: i64 = 0;
    let mut best_id: i64 = 0;
    let mut best_us: i64 = 999999;
    let mut best_sz: i64 = 999999;

    let mut i: usize = 0;
    while i < 5 {
        let c = cands[i];
        if c.legality_proven {
            if evaluated < max_cands && (accum_ms + c.wall_ms) <= max_wall_ms {
                evaluated = evaluated + 1;
                accum_ms = accum_ms + c.wall_ms;
                let cb: i64 = c.code_bytes;
                let mu: i64 = c.median_us;
                let better: bool = if prefer_size {
                    if cb != best_sz { cb < best_sz } else { mu < best_us }
                } else {
                    if mu != best_us { mu < best_us } else { cb < best_sz }
                };
                if better {
                    best_id = c.cand_id;
                    best_us = c.median_us;
                    best_sz = c.code_bytes;
                }
            }
        }
        i = i + 1;
    }
    best_id
}

fn run_pgo_optional_kernel() -> i64 {
    let weights: [7]i64 = [11, 22, 33, 44, 55, 66, 77];
    let mut acc: i64 = 0;
    let mut i: usize = 0;
    while i < 7 {
        let w = weights[i];
        let br: i64 = if (i & 1) == 0 { (w * 3) - 5 } else { (w * 2) + 9 };
        acc = acc + br;
        i = i + 1;
    }
    acc
}

fn structural_counter_digest(opt_profile: i64, insts_before: i64, insts_after: i64, bce_elim: i64, elapsed_us_ignored: i64) -> i64 {
    // AXS-PERF-030 & AXS-PERF-032: Wall-clock `elapsed_us_ignored` never enters the deterministic digest!
    let _unused_wall = elapsed_us_ignored;
    ((opt_profile * 1009) ^ (insts_before * 131) ^ (insts_after * 37) ^ (bce_elim * 17)) & 0x7FFFFFFF
}

@derive(Copy)
struct OriginRecord {
    fn_id: i64,
    span_start: i64,
    span_end: i64,
    inlined_from_span: i64,
    pass_id: i64,
}

fn verify_origin_chain_preservation() -> i64 {
    let orig = OriginRecord {
        fn_id: 42,
        span_start: 120,
        span_end: 168,
        inlined_from_span: 0,
        pass_id: 1,
    };
    let after_inline = OriginRecord {
        fn_id: orig.fn_id,
        span_start: orig.span_start,
        span_end: orig.span_end,
        inlined_from_span: 340,
        pass_id: 103,
    };
    let after_bce = OriginRecord {
        fn_id: after_inline.fn_id,
        span_start: after_inline.span_start,
        span_end: after_inline.span_end,
        inlined_from_span: after_inline.inlined_from_span,
        pass_id: 107,
    };
    if after_bce.fn_id == 42 && after_bce.span_start == 120 && after_bce.span_end == 168 && after_bce.inlined_from_span == 340 {
        1
    } else {
        0
    }
}

pub fn main() -> i32 {
    let pgo_opt = run_pgo_optional_kernel();
    let cand_o2 = evaluate_bounded_autotune(false, 3, 55);
    let cand_oz = evaluate_bounded_autotune(true, 3, 55);

    let d_fast_host = structural_counter_digest(2, 1840, 940, 18, 4100);
    let d_busy_host = structural_counter_digest(2, 1840, 940, 18, 98500);
    let ortho: i64 = if d_fast_host == d_busy_host && d_fast_host > 0 { 1 } else { 0 };
    let origin_ok = verify_origin_chain_preservation();

    print("PGO_OPTIONAL_NO_PROFILE=");
    print_int(pgo_opt);
    print("\nAUTOTUNE_LEGAL_O2_CAND=");
    print_int(cand_o2);
    print("\nAUTOTUNE_LEGAL_OZ_CAND=");
    print_int(cand_oz);
    print("\nPROVENANCE_ORTHOGONAL=");
    print_int(ortho);
    print("\nORIGIN_CHAIN_PRESERVED=");
    print_int(origin_ok);
    print("\n");
    0
}
