// test: diff
// flags: --verify-each
// exit: 0
// stdout: ZERO_COST_KERNEL=324\nSIZE_VS_SPEED_FOLD=12114\nGENERIC_BODY_SHARE=495\nLIFO_DROP=302010\n

// E15.7 Conformance (SPEC-76 §§2, 6.1, 6.2; AXS-PERF-002..003, AXS-PERF-010..014,
// REQ-OPT-292, REQ-OPT-293, REQ-OPT-294, REQ-OPT-295, REQ-OPT-334):
// Verifies zero-cost abstraction erasure (`WeightKernel` devirtualization, `Accumulator` SROA,
// proven BCE), `-O2` specialization vs `-Oz` shared code folding (`fold_window`), generic
// representation sharing (`SharedSlot<T>`), zero monolithic runtime dependency, and deterministic
// LIFO Drop order across `--interp`, `-O0`, `-O1`, `-O2`, and `-Oz`.

trait WeightKernel {
    fn scale(self: view<Self>, x: i64) -> i64;
}

struct AffineKernel {
    factor: i64,
    bias: i64,
}

impl WeightKernel for AffineKernel {
    fn scale(self: view<AffineKernel>, x: i64) -> i64 {
        (x * self.factor) + self.bias
    }
}

struct Accumulator {
    total: i64,
    count: i64,
}

fn run_zero_cost_kernel() -> i64 {
    let arr: [4]i64 = [10, 20, 30, 40];
    let kern = AffineKernel { factor: 3, bias: 5 };
    let mut acc = Accumulator { total: 0, count: 0 };
    let mut i: usize = 0;
    while i < 4 {
        let v: i64 = arr[i];
        acc.total = acc.total + kern.scale(v);
        acc.count = acc.count + 1;
        i = i + 1;
    }
    acc.total + acc.count
}

fn fold_window_3(a0: i64, a1: i64, a2: i64, step: i64) -> i64 {
    let mut acc: i64 = 0;
    let xs: [3]i64 = [a0, a1, a2];
    let mut i: usize = 0;
    while i < 3 {
        acc = (acc * 31) + (xs[i] + step);
        i = i + 1;
    }
    acc
}

fn compute_size_vs_speed_fold() -> i64 {
    let a = fold_window_3(2, 4, 6, 1);
    let b = fold_window_3(2, 4, 6, 2);
    let c = fold_window_3(2, 4, 6, 3);
    a + b + c
}

struct SharedSlot<T> {
    v: T,
}

fn extract_slot<T>(s: SharedSlot<T>) -> T {
    s.v
}

fn run_generic_sharing() -> i64 {
    let s_i64 = extract_slot<i64>(SharedSlot<i64> { v: 210 });
    let s_u64 = extract_slot<u64>(SharedSlot<u64> { v: 165u64 }) as i64;
    let s_usz = extract_slot<usize>(SharedSlot<usize> { v: 120usize }) as i64;
    s_i64 + s_u64 + s_usz
}

struct ProfileGuard {
    id: i64,
}

impl Drop for ProfileGuard {
    fn drop(self: mut_view<ProfileGuard>) {
        print_int(self.id);
    }
}

fn run_drop_order_check() {
    print("LIFO_DROP=");
    {
        let _g1 = ProfileGuard { id: 10 };
        let _g2 = ProfileGuard { id: 20 };
        let _g3 = ProfileGuard { id: 30 };
    }
    print("\n");
}

pub fn main() -> i32 {
    let zc = run_zero_cost_kernel();
    let fw = compute_size_vs_speed_fold();
    let gs = run_generic_sharing();

    print("ZERO_COST_KERNEL=");
    print_int(zc);
    print("\nSIZE_VS_SPEED_FOLD=");
    print_int(fw);
    print("\nGENERIC_BODY_SHARE=");
    print_int(gs);
    print("\n");
    run_drop_order_check();
    0
}
