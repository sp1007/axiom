                    rc = 507;
                }
                diag_buf_free(mut_view(tb1));
                diag_buf_free(mut_view(tb2));
            }
        }
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        if rc != 0 {
            return rc;
        }
    }
    print("PROBE_TCO_ATTR_DIAG_AND_EMIT=OK\n");
    0
}

