// test: diff
// flags: --verify-each
// exit: 0
// stdout: E15_4_ERASURE_BANNER=SROA_RVO_NRVO_Closure_Inline_Specialize\nERASURE_MOVE_DROP=55\nERASURE_FIELD_DROP=11\nERASURE_FIELD_DROP=22\nERASURE_SROA_CLOSURE=480\nERASURE_NRVO_GUARD=33\nERASURE_RVO_NRVO=1065\nERASURE_ARG_ORDER=1\nERASURE_ARG_ORDER=2\nERASURE_ARG_ORDER=3\nERASURE_INL_SPEC=428\nERASURE_ADDR_BARRIER=100\nE15_4_ERASURE_TOTAL=2168\n

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct OwnedHandle {
    id: i32,
}

impl Drop for OwnedHandle {
    fn drop(self: mut_view<OwnedHandle>) {
        print("ERASURE_MOVE_DROP=");
        print_int(self.id);
        print("\n");
    }
}

struct FieldGuard {
    tag: i32,
}

impl Drop for FieldGuard {
    fn drop(self: mut_view<FieldGuard>) {
        print("ERASURE_FIELD_DROP=");
        print_int(self.tag);
        print("\n");
    }
}

struct FieldDropPair {
    first: FieldGuard,
    second: FieldGuard,
    weight: i32,
}

struct NrvoScopeGuard {
    code: i32,
}

impl Drop for NrvoScopeGuard {
    fn drop(self: mut_view<NrvoScopeGuard>) {
        print("ERASURE_NRVO_GUARD=");
        print_int(self.code);
        print("\n");
    }
}

struct Vec2 {
    x: i32,
    y: i32,
}

struct TransformBox {
    lo: Vec2,
    hi: Vec2,
}

@derive(Copy)
enum StageOutcome {
    Empty,
    Ready(i32, i32),
}

struct BigFrame {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
}

struct PairState {
    left: i32,
    right: i32,
}

@derive(Copy)
enum SpecMode {
    ScaleAdd(i32, i32),
    ClampHi(i32),
}

// 1. Move-chain coalescing & field-order Drop decomposition (`AXS-INL-010.2`, `AXS-INL-011.3`)
fn test_move_chain_and_drop_order(seed: i32) -> i32 {
    let tok0 = OwnedHandle { id: seed };
    let tok1 = tok0;
    let tok2 = tok1;
    let tok3 = tok2;
    tok3.id
}

fn test_field_drop_order_and_sroa() -> i32 {
    let pair = FieldDropPair {
        first: FieldGuard { tag: 11 },
        second: FieldGuard { tag: 22 },
        weight: 7,
    };
    pair.first.tag + pair.second.tag + pair.weight
}

// 2. Copy propagation + deep nested struct/enum/array SROA + closure capture erasure (`AXS-INL-010..011`, `AXS-INL-013`)
@inline
fn make_stage_outcome(v: i32) -> StageOutcome {
    if v > 0 {
        return StageOutcome.Ready(v + 15, 25);
    }
    StageOutcome.Empty
}

fn test_deep_sroa_and_closure_pipeline(x0: i32, y0: i32) -> i32 {
    let c0: i32 = x0 + y0;
    let c1: i32 = c0;
    let c2: i32 = c1;

    let v_min = Vec2 { x: x0, y: y0 };
    let v_max = Vec2 { x: x0 + c2, y: y0 + c2 };
    let tb0 = TransformBox { lo: v_min, hi: v_max };
    let tb1 = tb0;
    let span_sum: i32 = (tb1.hi.x - tb1.lo.x) + (tb1.hi.y - tb1.lo.y);

    let out = make_stage_outcome(span_sum);
    let enum_val: i32 = match out {
        StageOutcome.Empty => 0,
        StageOutcome.Ready(a, b) => a + b,
    };

    let lanes: [4]i32 = [10, 20, 30, 40];
    let lanes_copy: [4]i32 = lanes;
    let arr_val: i32 = lanes_copy[0] + lanes_copy[1] + lanes_copy[2] + lanes_copy[3];

    let scale: i32 = 3;
    let offset: i32 = 10;
    let step = |v: i32| -> i32 {
        (v * scale) + offset
    };
    let s1: i32 = step(20);
    let s2: i32 = step(s1);

    span_sum + enum_val + arr_val + s2
}

// 3. Direct RVO, Multi-Branch Named NRVO with Drop Guard, Chained RVO, & Alias-Safe NRVO (`AXS-INL-012`)
fn make_direct_rvo(base: i64) -> BigFrame {
    BigFrame {
        a: base + 10,
        b: base + 20,
        c: base + 30,
        d: base + 40,
    }
}

fn make_branch_nrvo(mode: i32, base: i64) -> BigFrame {
    let mut out = BigFrame {
        a: base,
        b: base + 5,
        c: base + 10,
        d: base + 15,
    };
    if mode > 0 {
        let g = NrvoScopeGuard { code: 33 };
        out.a = out.a + (g.code as i64);
        out.b = out.b + 47;
        return out;
    }
    out.c = out.c + 100;
    out
}

fn inner_chained_rvo(seed: i64) -> BigFrame {
    BigFrame {
        a: seed + 100,
        b: seed + 110,
        c: seed + 120,
        d: seed + 130,
    }
}

fn middle_chained_rvo(seed: i64) -> BigFrame {
    inner_chained_rvo(seed + 5)
}

fn outer_chained_rvo(seed: i64) -> BigFrame {
    middle_chained_rvo(seed + 10)
}

fn update_aliased_frame(dst_view: mut_view<BigFrame>, delta: i64) -> BigFrame {
    let mut local_f = BigFrame {
        a: dst_view.a + delta,
        b: dst_view.b + delta,
        c: dst_view.c + delta,
        d: dst_view.d + delta,
    };
    dst_view.a = 777;
    local_f.a = local_f.a + 5;
    local_f
}

fn sum_big_frame(f: BigFrame) -> i32 {
    (f.a + f.b + f.c + f.d) as i32
}

// 4. Left-to-right arg evaluation order, capability remapping, & call-site specialization (`AXS-INL-024`, `AXS-INL-030`)
fn trace_eval_arg(step_id: i32, val: i32) -> i32 {
    print("ERASURE_ARG_ORDER=");
    print_int(step_id);
    print("\n");
    val + step_id
}

@inline(always)
fn combine_inlined_args(a: i32, b: i32, c: i32) -> i32 {
    (a * 10) + (b * 5) + c
}

@inline(always)
fn bump_counter_mut(p: mut_view<PairState>, dl: i32, dr: i32) {
    p.left = p.left + dl;
    p.right = p.right + dr;
}

@inline(always)
fn read_counter_view(p: view<PairState>) -> i32 {
    p.left + p.right
}

fn spec_kernel(mode: SpecMode, fast: bool, x: i32) -> i32 {
    if fast {
        match mode {
            SpecMode.ScaleAdd(k, b) => (x * k) + b,
            SpecMode.ClampHi(hi) => if x > hi { hi } else { x },
        }
    } else {
        match mode {
            SpecMode.ScaleAdd(k, b) => (x + b) * k,
            SpecMode.ClampHi(hi) => if x > hi { hi } else { x },
        }
    }
}

fn test_inlining_and_specialization() -> i32 {
    let v_ord: i32 = combine_inlined_args(
        trace_eval_arg(1, 10),
        trace_eval_arg(2, 20),
        trace_eval_arg(3, 30)
    );
    let mut st = PairState { left: 10, right: 20 };
    bump_counter_mut(mut_view(st), 15, 25);
    let v_cap: i32 = read_counter_view(view(st));
    let v_spec: i32 = spec_kernel(SpecMode.ScaleAdd(4, 7), true, 12) +
                      spec_kernel(SpecMode.ClampHi(50), false, 80);
    v_ord + v_cap + v_spec
}

// 5. Negative SROA barrier: `address_of` observable address (`REQ-OPT-119`)
unsafe fn read_raw_i32(p: *const i32) -> i32 {
    *p
}

fn test_addr_observable_barrier(x: i32, y: i32) -> i32 {
    let v = Vec2 { x: x, y: y };
    let px: *const i32 = unsafe { address_of(v.x) };
    let rx: i32 = unsafe { read_raw_i32(px) };
    rx + v.y
}

pub fn main() -> i32 {
    print("E15_4_ERASURE_BANNER=SROA_RVO_NRVO_Closure_Inline_Specialize\n");

    let v_mv: i32 = test_move_chain_and_drop_order(55);
    let v_fd: i32 = test_field_drop_order_and_sroa();

    let v_sroa: i32 = test_deep_sroa_and_closure_pipeline(10, 20);
    print("ERASURE_SROA_CLOSURE=");
    print_int(v_sroa);
    print("\n");

    let r1: i32 = sum_big_frame(make_direct_rvo(20));
    let r2: i32 = sum_big_frame(make_branch_nrvo(1, 30));
    let r3: i32 = sum_big_frame(outer_chained_rvo(10));
    let mut aliased = BigFrame { a: 5, b: 10, c: 15, d: 20 };
    aliased = update_aliased_frame(mut_view(aliased), 10);
    let r4: i32 = sum_big_frame(aliased);
    let v_rvo: i32 = r1 + r2 + r3 + r4;
    print("ERASURE_RVO_NRVO=");
    print_int(v_rvo);
    print("\n");

    let v_inl: i32 = test_inlining_and_specialization();
    print("ERASURE_INL_SPEC=");
    print_int(v_inl);
    print("\n");

    let v_addr: i32 = test_addr_observable_barrier(44, 56);
    print("ERASURE_ADDR_BARRIER=");
    print_int(v_addr);
    print("\n");

    let total: i32 = v_mv + v_fd + v_sroa + v_rvo + v_inl + v_addr;
    print("E15_4_ERASURE_TOTAL=");
    print_int(total);
    print("\n");

    if total != 2168 {
        return 1;
    }
    0
}
