// test: diff
// flags: --verify-each
// exit: 0
// stdout: E15_4_DEVIRT_BANNER=Devirt_Three_Tier_And_Open_World_Boundaries\nDEVIRT_STATIC_TRAIT=140\nDEVIRT_TIER1_EXACT_INLINE=130\nDEVIRT_TIER2_GUARDED=175\nDEVIRT_TIER3_DYNAMIC=107\nDEVIRT_OPEN_WORLD_BOUNDARY=130\nE15_4_DEVIRT_TOTAL=682\n

trait SignalFilter {
    fn apply_filter(self: view<Self>, x: i32) -> i32;
}

struct GainFilter {
    gain: i32,
    bias: i32,
}

impl SignalFilter for GainFilter {
    fn apply_filter(self: view<GainFilter>, x: i32) -> i32 {
        (x * self.gain) + self.bias
    }
}

struct PolyFilter {
    a: i32,
    b: i32,
    c: i32,
}

impl SignalFilter for PolyFilter {
    fn apply_filter(self: view<PolyFilter>, x: i32) -> i32 {
        (self.a * x * x) + (self.b * x) + self.c
    }
}

// 1. Static trait dispatch + SROA scalarization (`REQ-OPT-103`, `REQ-OPT-112`, `REQ-TYP-005..006`)
fn test_static_trait_erasure() -> i32 {
    let g = GainFilter { gain: 5, bias: 12 };
    let p = PolyFilter { a: 2, b: 4, c: 8 };
    g.apply_filter(10) + p.apply_filter(5)
}

// 2. Tier 1 (`DEVIRT_EXACT`): concrete receiver & fn-ptr devirtualization + post-devirt inlining + SROA (`REQ-OPT-105`, `REQ-OPT-112`, `REQ-OPT-315`)
@inline
fn exact_fn_mul4_sub3(x: i32) -> i32 {
    (x * 4) - 3
}

@inline
fn vtable_linear_impl(slope: i32, offset: i32, x: i32) -> i32 {
    (slope * x) + offset
}

struct TraitObjVtable {
    slope: i32,
    offset: i32,
    eval_fn: fn(i32, i32, i32) -> i32,
}

fn test_tier1_exact_devirt_and_inline(x: i32, y: i32) -> i32 {
    let fp: fn(i32) -> i32 = exact_fn_mul4_sub3;
    let obj = TraitObjVtable {
        slope: 6,
        offset: 13,
        eval_fn: vtable_linear_impl,
    };
    let vf: fn(i32, i32, i32) -> i32 = obj.eval_fn;
    fp(x) + vf(obj.slope, obj.offset, y)
}

// 3. Tier 2 (`DEVIRT_GUARDED`): finite 2-target and 3-target guarded speculative dispatch (`REQ-OPT-106`, `REQ-OPT-113`)
@inline
fn guard_target_0(x: i32) -> i32 {
    x + 15
}

@inline
fn guard_target_1(x: i32) -> i32 {
    x * 3
}

@inline
fn guard_target_2(x: i32) -> i32 {
    (x * 2) + 5
}

fn dispatch_two_guarded(sel: i32, x: i32) -> i32 {
    let f: fn(i32) -> i32 = if sel == 0 {
        guard_target_0
    } else {
        guard_target_1
    };
    f(x)
}

fn dispatch_three_guarded(sel: i32, x: i32) -> i32 {
    let f: fn(i32) -> i32 = if sel == 0 {
        guard_target_0
    } else if sel == 1 {
        guard_target_1
    } else {
        guard_target_2
    };
    f(x)
}

fn test_tier2_guarded_dispatch() -> i32 {
    let d2: i32 = dispatch_two_guarded(0, 20) + dispatch_two_guarded(1, 20);
    let d3: i32 = dispatch_three_guarded(0, 10) +
                  dispatch_three_guarded(1, 10) +
                  dispatch_three_guarded(2, 10);
    d2 + d3
}

// 4. Tier 3 (`DEVIRT_RETAINED_DYNAMIC`): 5-target (`> MAX_GUARDED_TARGETS = 4`) fail-closed dynamic dispatch (`REQ-OPT-107`, `REQ-OPT-113`)
fn dyn_target_sub_20(x: i32) -> i32 {
    x - 20
}

fn dispatch_five_dynamic(idx: i32, x: i32) -> i32 {
    let f: fn(i32) -> i32 = if idx == 0 {
        guard_target_0
    } else if idx == 1 {
        guard_target_1
    } else if idx == 2 {
        guard_target_2
    } else if idx == 3 {
        exact_fn_mul4_sub3
    } else {
        dyn_target_sub_20
    };
    f(x)
}

fn test_tier3_retained_dynamic() -> i32 {
    let mut sum: i32 = 0;
    let mut i: i32 = 0;
    while i < 5 {
        sum = sum + dispatch_five_dynamic(i, 10);
        i = i + 1;
    }
    sum
}

// 5. Open-world, `@export` ABI boundary, and representation-equivalent function-pointer identity (`REQ-OPT-081`, `REQ-OPT-086`, `REQ-OPT-098..099`, `REQ-OPT-108..111`)
fn rep_ident_alpha(v: i32) -> i32 {
    v + 25
}

fn rep_ident_beta(v: i32) -> i32 {
    v + 25
}

@export
pub fn exported_open_world_entry(cb: fn(i32) -> i32, x: i32) -> i32 {
    cb(x) + 5
}

fn test_open_world_and_fn_identity() -> i32 {
    let fa: fn(i32) -> i32 = rep_ident_alpha;
    let fb: fn(i32) -> i32 = rep_ident_beta;
    exported_open_world_entry(fa, 30) + exported_open_world_entry(fb, 40)
}

pub fn main() -> i32 {
    print("E15_4_DEVIRT_BANNER=Devirt_Three_Tier_And_Open_World_Boundaries\n");

    let v_static: i32 = test_static_trait_erasure();
    print("DEVIRT_STATIC_TRAIT=");
    print_int(v_static);
    print("\n");

    let v_tier1: i32 = test_tier1_exact_devirt_and_inline(15, 10);
    print("DEVIRT_TIER1_EXACT_INLINE=");
    print_int(v_tier1);
    print("\n");

    let v_tier2: i32 = test_tier2_guarded_dispatch();
    print("DEVIRT_TIER2_GUARDED=");
    print_int(v_tier2);
    print("\n");

    let v_tier3: i32 = test_tier3_retained_dynamic();
    print("DEVIRT_TIER3_DYNAMIC=");
    print_int(v_tier3);
    print("\n");

    let v_open: i32 = test_open_world_and_fn_identity();
    print("DEVIRT_OPEN_WORLD_BOUNDARY=");
    print_int(v_open);
    print("\n");

    let total: i32 = v_static + v_tier1 + v_tier2 + v_tier3 + v_open;
    print("E15_4_DEVIRT_TOTAL=");
    print_int(total);
    print("\n");

    if total != 682 {
        return 1;
    }
    0
}
