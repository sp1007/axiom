// test: diff
// flags: --verify-each
// exit: 0
// stdout: E15_4_TCO_BANNER=TailCall_ConstantStack_InlineAttrs_And_DropGuards\nTCO_DEEP_SUM=180300\nTCO_PARALLEL_CYCLIC=200\nTCO_ATTRS_AND_SCC=300\nTCO_GUARD_DROP=1\nTCO_GUARD_DROP=2\nTCO_GUARD_DROP=3\nTCO_DROP_AND_VIEW_GUARDS=170\nE15_4_TCO_TOTAL=180970\n

struct TcoDropGuard {
    depth: i32,
}

impl Drop for TcoDropGuard {
    fn drop(self: mut_view<TcoDropGuard>) {
        print("TCO_GUARD_DROP=");
        print_int(self.depth);
        print("\n");
    }
}

struct StackCell {
    v: i32,
}

// 1. Deep self-tail-recursion lowered to an O(1)-stack loop at `-O1`/`-O2` (`AXS-INL-033.1`, `REQ-OPT-002..003`)
fn deep_sum_tail(n: i32, acc: i32) -> i32 {
    if n <= 0 {
        return acc;
    }
    deep_sum_tail(n - 1, acc + n)
}

fn gcd_tail(a: i32, b: i32) -> i32 {
    if b == 0 {
        return a;
    }
    gcd_tail(b, a % b)
}

fn fib_tail(n: i32, a: i32, b: i32) -> i32 {
    if n <= 0 {
        return a;
    }
    fib_tail(n - 1, b, a + b)
}

fn cyclic_tribonacci_tail(n: i32, a: i32, b: i32, c: i32) -> i32 {
    if n <= 0 {
        return a;
    }
    cyclic_tribonacci_tail(n - 1, b, c, (a + b) - c)
}

// 2. `@inline(always)`, `@inline(never)`, bounded recursive SCCs, & sibling tail calls (`REQ-OPT-006`, `REQ-OPT-074..075`, `REQ-OPT-082..083`)
@inline(always)
fn always_inline_affine(v: i32, m: i32, b: i32) -> i32 {
    (v * m) + b
}

@inline(never)
fn never_inline_gate(v: i32) -> i32 {
    v + 30
}

@inline(always)
fn scc_mutual_even(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    scc_mutual_odd(n - 1) + 1
}

@inline(always)
fn scc_mutual_odd(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    scc_mutual_even(n - 1) + 1
}

@inline(always)
fn self_rec_bounded(n: i32) -> i32 {
    if n <= 1 {
        return 1;
    }
    n * self_rec_bounded(n - 1)
}

fn mutual_tail_even(n: i32) -> i32 {
    if n == 0 {
        return 1;
    }
    mutual_tail_odd(n - 1)
}

fn mutual_tail_odd(n: i32) -> i32 {
    if n == 0 {
        return 0;
    }
    mutual_tail_even(n - 1)
}

fn test_attrs_and_scc() -> i32 {
    let v_inl: i32 = always_inline_affine(never_inline_gate(10), 2, 10);
    let v_scc: i32 = scc_mutual_even(10);
    let v_rec: i32 = self_rec_bounded(5);
    let v_sib: i32 = (mutual_tail_even(24) * 40) + (mutual_tail_odd(25) * 40);
    v_inl + v_scc + v_rec + v_sib
}

// 3. Negative TCO safety guards: live Drop after call & stack-borrowed `view`/`mut_view` (`AXS-INL-033` Preconditions 1 & 2)
fn rec_with_scope_drop_guard(n: i32, acc: i32) -> i32 {
    if n <= 0 {
        return acc;
    }
    let mut next_acc: i32 = 0;
    {
        let g = TcoDropGuard { depth: n };
        next_acc = rec_with_scope_drop_guard(g.depth - 1, acc + (g.depth * 10));
    }
    next_acc
}

fn callee_read_cell(c: view<StackCell>, scale: i32) -> i32 {
    c.v * scale
}

fn caller_with_stack_view(seed: i32) -> i32 {
    let local_cell = StackCell { v: seed };
    callee_read_cell(view(local_cell), 3)
}

fn callee_bump_cell(c: mut_view<StackCell>, delta: i32) -> i32 {
    c.v = c.v + delta;
    c.v * 2
}

fn caller_with_stack_mut_view(seed: i32) -> i32 {
    let mut local_cell = StackCell { v: seed };
    callee_bump_cell(mut_view(local_cell), 5)
}

pub fn main() -> i32 {
    print("E15_4_TCO_BANNER=TailCall_ConstantStack_InlineAttrs_And_DropGuards\n");

    let v_sum: i32 = deep_sum_tail(600, 0);
    print("TCO_DEEP_SUM=");
    print_int(v_sum);
    print("\n");

    let v_par: i32 = cyclic_tribonacci_tail(6, 2, 5, 3) +
                     cyclic_tribonacci_tail(5, 10, 20, 5) +
                     gcd_tail(1071, 462) +
                     fib_tail(12, 0, 1);
    print("TCO_PARALLEL_CYCLIC=");
    print_int(v_par);
    print("\n");

    let v_attr: i32 = test_attrs_and_scc();
    print("TCO_ATTRS_AND_SCC=");
    print_int(v_attr);
    print("\n");

    let v_drop: i32 = rec_with_scope_drop_guard(3, 10);
    let v_view: i32 = caller_with_stack_view(20) + caller_with_stack_mut_view(15);
    let v_guards: i32 = v_drop + v_view;
    print("TCO_DROP_AND_VIEW_GUARDS=");
    print_int(v_guards);
    print("\n");

    let total: i32 = v_sum + v_par + v_attr + v_guards;
    print("E15_4_TCO_TOTAL=");
    print_int(total);
    print("\n");

    if total != 180970 {
        return 1;
    }
    0
}
