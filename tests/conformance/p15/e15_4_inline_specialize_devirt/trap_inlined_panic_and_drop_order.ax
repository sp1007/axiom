// test: run
// modes: interp native
// exit: 101
// stdout: arg0\narg1\ndrop=30\ndrop=20\ninlined-pre-panic=50\n
// E15.4 (T615): Panic and Drop-Ordering Fidelity across Nested Inlining & Specialization (`SPEC-73` §11.3, `REQ-OPT-068`, `REQ-OPT-069`, `REQ-OPT-075`).
// Verifies that:
// 1. Call-site argument evaluation order is strictly left-to-right before entering the inlined body (`arg0`, `arg1`).
// 2. Inner scoped `Drop` guards inside an inlined helper execute in exact reverse declaration (LIFO) order (`drop=30`, `drop=20`) before the panic trap triggers.
// 3. The panic inside a specialized/inlined generic helper terminates with exit code 101 without executing any post-panic statements.

@intrinsic fn panic() {}

struct TraceGuard {
    id: i64,
}

impl Drop for TraceGuard {
    fn drop(self: mut_view<TraceGuard>) {
        print("drop=");
        print_int(self.id);
        print("\n");
    }
}

fn eval_arg0(x: i64) -> i64 {
    print("arg0\n");
    x + 10
}

fn eval_arg1(y: i64) -> i64 {
    print("arg1\n");
    y + 20
}

fn nested_inlined_trap(a: i64, b: i64, should_trap: bool) -> i64 {
    {
        let g_outer = TraceGuard { id: 20 };
        let g_inner = TraceGuard { id: 30 };
        let _ = g_outer.id + g_inner.id;
    }
    print("inlined-pre-panic=");
    print_int(a + b);
    print("\n");
    if should_trap {
        panic();
    }
    print("unreachable-after-panic\n");
    a + b
}

pub fn main() -> i32 {
    let v = nested_inlined_trap(eval_arg0(5), eval_arg1(15), true);
    print("unreachable-caller=");
    print_int(v);
    print("\n");
    0
}
