// test: run
// stdout: 11 12\n
struct Point { x: i32, y: i32 }
fn mutate(b: mut_view<i32>) {
    *b = *b + 10;
}
fn main() -> i32 {
    let mut p = Point { x: 1, y: 2 };
    let a = mut_view(p.x);
    let b = mut_view(p.y);
    mutate(a);
    mutate(b);
    print_int(p.x as i64);
    print(" ");
    print_int(p.y as i64);
    print("\n");
    if p.x == 11 && p.y == 12 {
        return 0;
    } else {
        return 1;
    }
}
