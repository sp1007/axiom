// test: diff
// exit: 0

fn test_range_sum() -> i32 {
    let mut sum: i32 = 0;
    for i in 0..10 {
        sum = sum + i;
    }
    sum
}

fn test_range_break_continue() -> i32 {
    let mut sum: i32 = 0;
    for i in 0..20 {
        if i % 2 == 1 {
            continue;
        }
        if i >= 10 {
            break;
        }
        sum = sum + i;
    }
    sum
}

fn test_nested_loops() -> i32 {
    let mut count: i32 = 0;
    for i in 0..5 {
        for j in 0..5 {
            count = count + 1;
        }
    }
    count
}

fn main() -> i32 {
    // 0 + 1 + ... + 9 = 45
    let s1 = test_range_sum();
    if s1 != 45 {
        return 1;
    }

    // evens < 10: 0 + 2 + 4 + 6 + 8 = 20
    let s2 = test_range_break_continue();
    if s2 != 20 {
        return 2;
    }

    // 5 * 5 = 25
    let s3 = test_nested_loops();
    if s3 != 25 {
        return 3;
    }

    0
}
