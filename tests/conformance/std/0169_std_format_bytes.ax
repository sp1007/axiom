// test: diff
// exit: 0

fn format_u32(buf: mut_view<[u8]>, offset: usize, mut val: u32) -> usize {
    if val == 0 {
        buf[offset] = 48u8;
        return 1;
    }
    let mut tmp: [10]u8 = [0; 10];
    let mut digits: usize = 0;
    while val > 0 {
        tmp[digits] = ((val % 10) as u8) + 48u8;
        val = val / 10;
        digits = digits + 1;
    }
    let mut i: usize = 0;
    while i < digits {
        buf[offset + i] = tmp[digits - 1 - i];
        i = i + 1;
    }
    digits
}

fn append_bytes(dst: mut_view<[u8]>, dst_offset: usize, src: view<[u8]>) -> usize {
    let src_len = len(src);
    let mut i: usize = 0;
    while i < src_len {
        dst[dst_offset + i] = src[i];
        i = i + 1;
    }
    dst_offset + src_len
}

fn main() -> i32 {
    let mut buffer: [32]u8 = [0; 32];
    let prefix: [5]u8 = [118u8, 97u8, 108u8, 58u8, 32u8];
    let off1 = append_bytes(mut_view(buffer), 0, view(prefix));
    if off1 != 5 {
        return 1;
    }

    let digits_written = format_u32(mut_view(buffer), 5, 2026);
    if digits_written != 4 {
        return 2;
    }

    let total_len = off1 + digits_written;
    if total_len != 9 {
        return 3;
    }

    // Check buffer contents: "val: 2026"
    if buffer[0] != 118u8 || buffer[1] != 97u8 || buffer[2] != 108u8 || buffer[3] != 58u8 || buffer[4] != 32u8 {
        return 4;
    }
    if buffer[5] != 50u8 || buffer[6] != 48u8 || buffer[7] != 50u8 || buffer[8] != 54u8 {
        return 5;
    }

    0
}
