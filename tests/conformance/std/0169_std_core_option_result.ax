// test: diff
// exit: 0

fn test_option(flag: bool, v: i32) -> Option<i32> {
    if flag {
        Option.Some(v)
    } else {
        Option.None
    }
}

fn test_result(x: i32) -> Result<i32, i32> {
    if x >= 0 {
        Result.Ok(x * 10)
    } else {
        Result.Err(-x)
    }
}

fn main() -> i32 {
    let o1 = test_option(true, 100);
    let mut sum: i32 = 0;
    match o1 {
        Option.Some(val) => { sum = sum + val; },
        Option.None => { return 1; },
    }

    let o2 = test_option(false, 50);
    match o2 {
        Option.Some(val) => { return 2; },
        Option.None => { sum = sum + 5; },
    }

    let r1 = test_result(7);
    match r1 {
        Result.Ok(val) => { sum = sum + val; },
        Result.Err(e) => { return 3; },
    }

    let r2 = test_result(-15);
    match r2 {
        Result.Ok(val) => { return 4; },
        Result.Err(e) => { sum = sum + e; },
    }

    // Expected sum: 100 + 5 + 70 + 15 = 190
    if sum != 190 {
        return 5;
    }
    return 0;
}
