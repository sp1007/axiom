// test: diff
// exit: 0

fn main() -> i32 {
    let empty: Str = "";
    if len(empty) != 0 {
        return 1;
    }

    let ascii: Str = "Hello Axiom!";
    if len(ascii) != 12 {
        return 2;
    }

    let vn: Str = "Xin chào thế giới";
    // 22 UTF-8 bytes: 'à' is 2 bytes (C3 A0), 'ế' is 3 bytes (E1 BA BF), 'ớ' is 3 bytes (E1 BB 9B)
    if len(vn) != 22 {
        return 3;
    }

    let b_str: Str = b"binary bytes";
    if len(b_str) != 12 {
        return 4;
    }

    0
}
