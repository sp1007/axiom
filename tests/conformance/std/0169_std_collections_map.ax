// test: diff
// exit: 0

const CAPACITY: usize = 16;

struct IntMap {
    keys: [16]i32,
    vals: [16]i32,
    occupied: [16]bool,
    len: usize,
}

fn map_new() -> IntMap {
    IntMap {
        keys: [0; 16],
        vals: [0; 16],
        occupied: [false; 16],
        len: 0,
    }
}

fn hash_key(k: i32) -> usize {
    let u = if k >= 0 { k as usize } else { (-k) as usize };
    (u * 2654435761) & 15
}

fn map_insert(m: mut_view<IntMap>, k: i32, v: i32) -> bool {
    let mut idx = hash_key(k);
    let mut step: usize = 0;
    while step < 16 {
        if !m.occupied[idx] {
            m.occupied[idx] = true;
            m.keys[idx] = k;
            m.vals[idx] = v;
            m.len = m.len + 1;
            return true;
        } else if m.keys[idx] == k {
            m.vals[idx] = v;
            return false;
        }
        idx = (idx + 1) & 15;
        step = step + 1;
    }
    false
}

fn map_get(m: view<IntMap>, k: i32) -> Option<i32> {
    let mut idx = hash_key(k);
    let mut step: usize = 0;
    while step < 16 {
        if !m.occupied[idx] {
            return Option.None;
        } else if m.keys[idx] == k {
            return Option.Some(m.vals[idx]);
        }
        idx = (idx + 1) & 15;
        step = step + 1;
    }
    Option.None
}

fn main() -> i32 {
    let mut m = map_new();
    map_insert(mut_view(m), 10, 100);
    map_insert(mut_view(m), 26, 260); // collides with 10 on & 15
    map_insert(mut_view(m), 42, 420); // collides with 10 and 26 on & 15
    map_insert(mut_view(m), 7, 70);

    if m.len != 4 {
        return 1;
    }

    match map_get(view(m), 10) {
        Option.Some(v) => { if v != 100 { return 2; } },
        Option.None => { return 3; },
    }

    match map_get(view(m), 26) {
        Option.Some(v) => { if v != 260 { return 4; } },
        Option.None => { return 5; },
    }

    match map_get(view(m), 42) {
        Option.Some(v) => { if v != 420 { return 6; } },
        Option.None => { return 7; },
    }

    match map_get(view(m), 99) {
        Option.Some(v) => { return 8; },
        Option.None => {},
    }

    // Overwrite existing key
    map_insert(mut_view(m), 10, 999);
    if m.len != 4 {
        return 9;
    }
    match map_get(view(m), 10) {
        Option.Some(v) => { if v != 999 { return 10; } },
        Option.None => { return 11; },
    }

    0
}
