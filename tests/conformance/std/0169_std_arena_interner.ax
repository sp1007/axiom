// test: diff
// exit: 0

fn arena_alloc(buf_len: usize, cur_offset: usize, size: usize, align: usize) -> usize {
    let aligned = ((cur_offset + align - 1) / align) * align;
    if aligned + size > buf_len {
        return 0; // OOM
    }
    aligned + size
}

fn table_intern(hashes: mut_view<[u64]>, ids: mut_view<[u32]>, count: usize, hash: u64) -> u32 {
    let mut i: usize = 0;
    while i < count {
        if hashes[i] == hash {
            return ids[i];
        }
        i = i + 1;
    }
    let max_len = len(hashes);
    if count < max_len {
        let new_id = (count as u32) + 1;
        hashes[count] = hash;
        ids[count] = new_id;
        new_id
    } else {
        0
    }
}

fn main() -> i32 {
    let buf_len: usize = 128;
    let mut off: usize = 0;

    let off1 = arena_alloc(buf_len, off, 16, 8);
    if off1 != 16 { return 1; }
    off = off1;

    let off2 = arena_alloc(buf_len, off, 24, 8);
    if off2 != 40 { return 2; }
    off = off2;

    let off3 = arena_alloc(buf_len, off, 8, 8);
    if off3 != 48 { return 3; }
    off = off3;

    let mut hashes: [8]u64 = [0; 8];
    let mut ids: [8]u32 = [0; 8];
    let mut count: usize = 0;

    let id_a1 = table_intern(mut_view(hashes), mut_view(ids), count, 0x12345678);
    if id_a1 != 1 { return 4; }
    count = count + 1;

    let id_b1 = table_intern(mut_view(hashes), mut_view(ids), count, 0xABCDEF00);
    if id_b1 != 2 { return 5; }
    count = count + 1;

    // Must deduplicate and return existing ID
    let id_a2 = table_intern(mut_view(hashes), mut_view(ids), count, 0x12345678);
    if id_a2 != 1 { return 6; }

    let id_c1 = table_intern(mut_view(hashes), mut_view(ids), count, 0x99999999);
    if id_c1 != 3 { return 7; }
    count = count + 1;

    if count != 3 { return 8; }

    0
}
