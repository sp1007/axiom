// test: run
// exit: 42
// T146 QA: `@derive(Hash)` generates one `self.<field>.hash(..);` call per field on a single line. Before the
// AXS-GRM-011 fix only the first call survived parsing, so only the first field was hashed. This test uses an
// order-sensitive hasher (h = h * 31 + v) and a struct with three fields, so dropping any field call, or
// hashing the fields in a different order, gives a different value.
//
// Expected values, by hand (u32 arithmetic, no overflow):
//   P3 { a: 1, b: 2, c: 3 }: ((0 * 31 + 1) * 31 + 2) * 31 + 3 = 961 + 62 + 3 = 1026
//   P3 { a: 3, b: 2, c: 1 }: ((0 * 31 + 3) * 31 + 2) * 31 + 1 = 2883 + 62 + 1 = 2946
//   P1 { v: 9 }:             0 * 31 + 9 = 9
// Only the first field (the old behaviour) would give 1, 3 and 9.
//
// Kept outside tests/run (the axiomc_e2e corpus): axiomc still rejects derived generic `hash<H>` impls for
// two types (AX_LINK_DUPLICATE_SYMBOL `hash`), the gap already registered for tests/run/trait2/test_derive.ax
// in known_divergent.txt; this test checks axiom0's derive expansion, not that gap.

trait Hasher {
    fn write_u32(self: mut_view<Self>, i: u32);
}

trait Hash {
    fn hash<H: Hasher>(self: view<Self>, state: mut_view<H>);
}

impl Hash for u32 {
    fn hash<H: Hasher>(self: view<u32>, state: mut_view<H>) {
        state.write_u32(*self);
    }
}

struct PolyHasher {
    h: u32,
}

impl Hasher for PolyHasher {
    fn write_u32(self: mut_view<PolyHasher>, i: u32) {
        self.h = self.h * 31 + i;
    }
}

@derive(Hash)
struct P3 {
    a: u32,
    b: u32,
    c: u32,
}

@derive(Hash)
struct P1 {
    v: u32,
}

fn hash3(p: view<P3>) -> u32 {
    let mut st = PolyHasher { h: 0 }
    p.hash(mut_view(st))
    st.h
}

fn hash1(p: view<P1>) -> u32 {
    let mut st = PolyHasher { h: 0 }
    p.hash(mut_view(st))
    st.h
}

fn main() -> i32 {
    let x = P3 { a: 1, b: 2, c: 3 }
    let y = P3 { a: 3, b: 2, c: 1 }
    let z = P1 { v: 9 }
    if hash3(view(x)) != 1026 {
        return 1
    }
    if hash3(view(y)) != 2946 {
        return 2
    }
    if hash1(view(z)) != 9 {
        return 3
    }
    42
}
