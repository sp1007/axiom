// test: diff
// exit: 0

struct Data {
    val: i32,
}

fn id<T>(x: T) -> T {
    return x;
}

fn main() -> i32 {
    let a: i32 = id(100);
    let b: bool = id(true);
    let d: Data = id(Data { val: 42 });
    
    if a != 100 {
        return 1;
    }
    if !b {
        return 2;
    }
    if d.val != 42 {
        return 3;
    }
    return 0;
}
