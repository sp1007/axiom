// test: diff
// exit: 0

struct Pair<T> {
    first: T,
    second: T,
}

fn sum_pair(p: Pair<i32>) -> i32 {
    return p.first + p.second;
}

fn main() -> i32 {
    let p1 = Pair<i32> { first: 17, second: 25 };
    let s = sum_pair(p1);
    
    let p2 = Pair<bool> { first: true, second: false };
    if !p2.first {
        return 1;
    }
    if p2.second {
        return 2;
    }
    if s != 42 {
        return 3;
    }
    return 0;
}
