// test: diff
// exit: 0

trait Calculator {
    fn compute(self: view<Self>, val: i32) -> i32;
}

struct Multiplier {
    factor: i32,
}

impl Calculator for Multiplier {
    fn compute(self: view<Multiplier>, val: i32) -> i32 {
        return self.factor * val;
    }
}

fn run_calc<C: Calculator>(c: view<C>, val: i32) -> i32 {
    return c.compute(val);
}

fn main() -> i32 {
    let m = Multiplier { factor: 3 };
    let r1 = run_calc<Multiplier>(view(m), 14);
    if r1 != 42 {
        return 1;
    }
    return 0;
}
