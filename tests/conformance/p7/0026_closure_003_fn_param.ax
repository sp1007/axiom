// test: diff
// exit: 0

fn apply(x: i32, f: fn(i32) -> i32) -> i32 {
    return f(x);
}

fn add_five(x: i32) -> i32 {
    return x + 5;
}

fn main() -> i32 {
    let r1 = apply(10, add_five);
    let r2 = apply(20, |x: i32| x * 2);
    
    if r1 != 15 {
        return 1;
    }
    if r2 != 40 {
        return 2;
    }
    return 0;
}
