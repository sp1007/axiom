// test: diff
// exit: 0

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Node {
    val: i32,
    offset: i32,
}

fn main() -> i32 {
    let mut n = Node { val: 10, offset: 32 };
    unsafe {
        let p: *mut Node = address_of_mut(n);
        p.val = 42;
        p.offset = 99;
    }
    if n.val != 42 || n.offset != 99 {
        return 1;
    }
    return 0;
}
