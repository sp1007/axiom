// test: diff
// exit: 0

fn get_val(flag: bool) -> Option<i32> {
    if flag {
        return Option.Some(42);
    }
    return Option.None;
}

fn check_result(x: i32) -> Result<i32, i32> {
    if x > 0 {
        return Result.Ok(x * 2);
    }
    return Result.Err(0);
}

fn main() -> i32 {
    let opt = get_val(true);
    let mut sum = 0;
    if let Option.Some(v) = opt {
        sum = sum + v;
    }
    
    let res = check_result(5);
    if let Result.Ok(r) = res {
        sum = sum + r;
    }
    
    // 42 + 10 = 52
    if sum != 52 {
        return 1;
    }
    return 0;
}
