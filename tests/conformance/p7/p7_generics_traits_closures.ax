// test: diff
// exit: 0

trait Summarizable {
    fn summary(self: view<Self>) -> i32;
}

struct Meter {
    reading: i32,
}

impl Summarizable for Meter {
    fn summary(self: view<Meter>) -> i32 {
        return self.reading;
    }
}

fn map_summary<T: Summarizable>(item: view<T>, transform: fn(i32) -> i32) -> i32 {
    let s = item.summary();
    return transform(s);
}

fn main() -> i32 {
    let m = Meter { reading: 20 };
    let doubled = map_summary(view(m), |x: i32| x * 2 + 2);
    if doubled != 42 {
        return 1;
    }
    return 0;
}
