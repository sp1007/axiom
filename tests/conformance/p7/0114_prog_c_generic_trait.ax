// test: diff
// exit: 0

trait Incrementor {
    fn inc(self: view<Self>) -> i32;
}

struct Value {
    v: i32,
}

impl Incrementor for Value {
    fn inc(self: view<Value>) -> i32 {
        return self.v + 1;
    }
}

fn apply_inc<T: Incrementor>(item: view<T>) -> i32 {
    return item.inc();
}

fn main() -> i32 {
    let val = Value { v: 41 };
    let res = apply_inc(view(val));
    if res != 42 {
        return 1;
    }
    return 0;
}
