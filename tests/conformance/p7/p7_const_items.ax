// test: diff
// exit: 0

const BASE: i32 = 40;
const OFFSET: i32 = 2;
const TOTAL: i32 = BASE + OFFSET;

struct Config {
    multiplier: i32,
    threshold: i32,
}

const CFG: Config = Config {
    multiplier: 3,
    threshold: 100,
};

fn evaluate(input: i32) -> i32 {
    return input * CFG.multiplier;
}

fn main() -> i32 {
    if TOTAL != 42 {
        return 1;
    }
    let res = evaluate(10);
    if res != 30 {
        return 2;
    }
    return 0;
}
