// test: diff
// exit: 0

trait Drawable {
    fn draw(self: view<Self>) -> i32;
}

struct Circle {
    radius: i32,
}

impl Drawable for Circle {
    fn draw(self: view<Circle>) -> i32 {
        return self.radius * 2;
    }
}

fn main() -> i32 {
    let c = Circle { radius: 21 };
    let val = c.draw();
    if val != 42 {
        return 1;
    }
    return 0;
}
