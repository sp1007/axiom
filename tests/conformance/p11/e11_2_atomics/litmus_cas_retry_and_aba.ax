// test: run
// modes: interp native
// stdout: strong_cas_no_spurious:ok\nweak_cas_retry_loop:ok\nconcurrent_cas_affine:ok\nraw_aba_unmitigated:ok\ntagged_aba_prevented:ok\n
// Covers: AXS-ATM-008, AXS-ATM-014, AXS-ATM-018, AXS-ATM-024, AXS-ATM-026, AXS-ATM-045
// Covers: AXS-ATM-050, AXS-ATM-054, AXS-ATM-066
// Covers: INV-CONC-006, INV-CONC-007, INV-ATM-003, INV-ATM-004, INV-ATM-005, INV-ORACLE-002
// Covers: REQ-CONC-076, REQ-CONC-079, REQ-ATM-030
// E11.2 conformance litmus 5: compare_exchange (strong, never spuriously fails) vs
// compare_exchange_weak (retry loop under oracle deterministic spurious failure),
// unmitigated raw-value ABA behavior (REQ-CONC-076, REQ-ATM-030), and packed
// (tag: u32, index: u32) ABA prevention in Atomic<u64> (REQ-CONC-079, AXS-ATM-066).

fn oracle_set_seed(seed: u64) {
    let _ = seed;
}

fn oracle_join_all() {}

fn test_strong_cas_never_fails_spuriously() -> bool {
    // Strong compare_exchange on matching expected value must succeed on the very first attempt
    let a8 = AtomicU8.new(7u8);
    let r8 = a8.compare_exchange(7u8, 14u8, Ordering.SeqCst, Ordering.SeqCst);
    if !r8.ok || r8.val != 7u8 || a8.load(Ordering.SeqCst) != 14u8 { return false; }

    let a16 = AtomicU16.new(300u16);
    let r16 = a16.compare_exchange(300u16, 600u16, Ordering.AcqRel, Ordering.Acquire);
    if !r16.ok || r16.val != 300u16 || a16.load(Ordering.Acquire) != 600u16 { return false; }

    let a32 = AtomicU32.new(1000u32);
    let r32 = a32.compare_exchange(1000u32, 2000u32, Ordering.Release, Ordering.Relaxed);
    if !r32.ok || r32.val != 1000u32 || a32.load(Ordering.Relaxed) != 2000u32 { return false; }

    let a64 = AtomicU64.new(5000u64);
    let mut i: u64 = 0u64;
    while i < 16u64 {
        let exp = 5000u64 + i;
        let des = exp + 1u64;
        let res = a64.compare_exchange(exp, des, Ordering.AcqRel, Ordering.Acquire);
        if !res.ok || res.val != exp {
            return false;
        }
        i = i + 1u64;
    }
    a64.load(Ordering.SeqCst) == 5016u64
}

fn test_weak_cas_retry_loop_liveness() -> bool {
    // Weak CAS loop transforming state -> state * 2 + 1 across 12 steps:
    // 0 -> 1 -> 3 -> 7 -> 15 -> 31 -> 63 -> 127 -> 255 -> 511 -> 1023 -> 2047 -> 4095
    let state = AtomicU64.new(0u64);
    let mut step: u32 = 0u32;
    let mut total_attempts: u32 = 0u32;
    while step < 12u32 {
        let mut cur = state.load(Ordering.Relaxed);
        while true {
            total_attempts = total_attempts + 1u32;
            let next = cur * 2u64 + 1u64;
            let res = state.compare_exchange_weak(
                cur,
                next,
                Ordering.AcqRel,
                Ordering.Acquire
            );
            if res.ok {
                break;
            }
            cur = res.val;
            spin_loop_hint();
        }
        step = step + 1u32;
    }
    state.load(Ordering.SeqCst) == 4095u64 && total_attempts >= 12u32
}

fn cas_add_loop(slot: view<AtomicU64>, delta: u64) {
    let mut cur = slot.load(Ordering.Relaxed);
    while true {
        let next = cur + delta;
        let res = slot.compare_exchange_weak(cur, next, Ordering.AcqRel, Ordering.Acquire);
        if res.ok {
            break;
        }
        cur = res.val;
        spin_loop_hint();
    }
}

fn thread_0_cas(slot: view<AtomicU64>) {
    cas_add_loop(slot, 10u64);
    cas_add_loop(slot, 20u64);
    cas_add_loop(slot, 30u64);
}

fn thread_1_cas(slot: view<AtomicU64>) {
    cas_add_loop(slot, 100u64);
    cas_add_loop(slot, 200u64);
    cas_add_loop(slot, 300u64);
}

fn test_concurrent_cas_retry_loops() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 12u64 {
        oracle_set_seed(seed);
        let slot = AtomicU64.new(5u64);
        thread_0_cas(view(slot));
        thread_1_cas(view(slot));
        oracle_join_all();
        if slot.load(Ordering.SeqCst) != 665u64 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

fn test_raw_aba_unmitigated_by_primitive_cas() -> bool {
    // REQ-CONC-076 & REQ-ATM-030: Primitive CAS compares bit patterns only and does NOT
    // implicitly detect or prevent an A -> B -> A transition on raw values/indices.
    let head_idx = AtomicU64.new(10u64);
    let snapshot_a = head_idx.load(Ordering.Acquire);

    // Intervening transitions: 10 (A) -> 20 (B) -> 10 (A)
    let r1 = head_idx.compare_exchange(10u64, 20u64, Ordering.AcqRel, Ordering.Acquire);
    let r2 = head_idx.compare_exchange(20u64, 10u64, Ordering.AcqRel, Ordering.Acquire);
    if !r1.ok || !r2.ok {
        return false;
    }

    // Because primitive CAS only compares the bit pattern (10 == 10), it succeeds on snapshot_a:
    let r_aba = head_idx.compare_exchange(snapshot_a, 30u64, Ordering.AcqRel, Ordering.Acquire);
    r_aba.ok && r_aba.val == 10u64 && head_idx.load(Ordering.SeqCst) == 30u64
}

fn pack_tagged_head(tag: u32, idx: u32) -> u64 {
    ((tag as u64) << 32u64) | (idx as u64)
}

fn unpack_tag(word: u64) -> u32 {
    (word >> 32u64) as u32
}

fn unpack_idx(word: u64) -> u32 {
    (word & 0xFFFFFFFFu64) as u32
}

fn test_tagged_state_aba_prevention() -> bool {
    // REQ-CONC-079 & AXS-ATM-066 Part B: Packing (tag: u32, head_idx: u32) into Atomic<u64>
    // detects A -> B -> A reuse and forces the stale reader to reload the updated generation.
    let head = AtomicU64.new(pack_tagged_head(1u32, 10u32));
    let stale_observed = head.load(Ordering.Acquire);

    // Intervening thread pops A (10 -> 20, tag 1 -> 2), then pushes A back (20 -> 10, tag 2 -> 3)
    let step1 = head.compare_exchange(
        pack_tagged_head(1u32, 10u32),
        pack_tagged_head(2u32, 20u32),
        Ordering.AcqRel,
        Ordering.Acquire
    );
    let step2 = head.compare_exchange(
        pack_tagged_head(2u32, 20u32),
        pack_tagged_head(3u32, 10u32),
        Ordering.AcqRel,
        Ordering.Acquire
    );
    if !step1.ok || !step2.ok {
        return false;
    }

    // Stale thread attempts CAS expecting (tag=1, idx=10) -> MUST FAIL with val=(tag=3, idx=10)
    let stale_attempt = head.compare_exchange(
        stale_observed,
        pack_tagged_head(2u32, 99u32),
        Ordering.AcqRel,
        Ordering.Acquire
    );
    if stale_attempt.ok {
        return false;
    }
    if unpack_tag(stale_attempt.val) != 3u32 || unpack_idx(stale_attempt.val) != 10u32 {
        return false;
    }

    // Retry with reloaded (tag=3, idx=10) succeeds and advances tag to 4
    let retry_attempt = head.compare_exchange(
        stale_attempt.val,
        pack_tagged_head(unpack_tag(stale_attempt.val) + 1u32, 99u32),
        Ordering.AcqRel,
        Ordering.Acquire
    );
    retry_attempt.ok && head.load(Ordering.SeqCst) == pack_tagged_head(4u32, 99u32)
}

pub fn main() -> i32 {
    if !test_strong_cas_never_fails_spuriously() { return 1; }
    print("strong_cas_no_spurious:ok\n");
    if !test_weak_cas_retry_loop_liveness() { return 2; }
    print("weak_cas_retry_loop:ok\n");
    if !test_concurrent_cas_retry_loops() { return 3; }
    print("concurrent_cas_affine:ok\n");
    if !test_raw_aba_unmitigated_by_primitive_cas() { return 4; }
    print("raw_aba_unmitigated:ok\n");
    if !test_tagged_state_aba_prevention() { return 5; }
    print("tagged_aba_prevented:ok\n");
    0
}
