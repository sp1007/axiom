// test: run
// modes: interp native
// stdout: rmw_counter:ok\nrmw_wrapping:ok\nrmw_bitwise_swap:ok\nrmw_spinlock:ok\nrmw_lock_free:ok\n
// Covers: AXS-ATM-007, AXS-ATM-010, AXS-ATM-011, AXS-ATM-012, AXS-ATM-013, AXS-ATM-014
// Covers: AXS-ATM-015, AXS-ATM-017, AXS-ATM-019, AXS-ATM-024, AXS-ATM-040, AXS-ATM-041
// Covers: AXS-ATM-043, AXS-ATM-044, AXS-ATM-046, AXS-ATM-047, AXS-ATM-050, AXS-ATM-051
// Covers: AXS-ATM-065, INV-CONC-005, INV-CONC-006, INV-CONC-007, INV-ATM-001, INV-ATM-003, INV-ATM-004, INV-ORACLE-002
// Covers: REQ-CONC-078, REQ-ATM-029
// E11.2 conformance litmus 4: Read-Modify-Write (RMW) lossless concurrent counter,
// distinct old-value bitmask verification, wrapping two's-complement arithmetic across
// signed/unsigned widths, bitwise RMW (fetch_and/or/xor) + swap, and Spinlock exclusion.

fn oracle_set_seed(seed: u64) {
    let _ = seed;
}

fn oracle_join_all() {}

fn thread_0_rmw_inc(counter: view<AtomicU64>, mask_acc: view<AtomicU64>) {
    let mut i: u32 = 0u32;
    while i < 8u32 {
        let old = counter.fetch_add(1u64, Ordering.Relaxed);
        let bit = 1u64 << old;
        let _ = mask_acc.fetch_or(bit, Ordering.Relaxed);
        i = i + 1u32;
    }
}

fn thread_1_rmw_inc(counter: view<AtomicU64>, mask_acc: view<AtomicU64>) {
    let mut i: u32 = 0u32;
    while i < 8u32 {
        let old = counter.fetch_add(1u64, Ordering.Relaxed);
        let bit = 1u64 << old;
        let _ = mask_acc.fetch_or(bit, Ordering.Relaxed);
        i = i + 1u32;
    }
}

fn test_rmw_lossless_counter() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 12u64 {
        oracle_set_seed(seed);
        let counter = AtomicU64.new(0u64);
        let mask_acc = AtomicU64.new(0u64);
        thread_0_rmw_inc(view(counter), view(mask_acc));
        thread_1_rmw_inc(view(counter), view(mask_acc));
        oracle_join_all();
        // 16 increments total: final value == 16, and every old value in 0..15 was returned exactly once
        if counter.load(Ordering.SeqCst) != 16u64 {
            return false;
        }
        if mask_acc.load(Ordering.SeqCst) != 0xFFFFu64 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

fn test_rmw_wrapping_all_widths() -> bool {
    // Unsigned wrapping: u8, u16, u32, u64, usize
    let u8_a = AtomicU8.new(255u8);
    if u8_a.fetch_add(1u8, Ordering.SeqCst) != 255u8 { return false; }
    if u8_a.load(Ordering.Relaxed) != 0u8 { return false; }
    if u8_a.fetch_sub(1u8, Ordering.AcqRel) != 0u8 { return false; }
    if u8_a.into_inner() != 255u8 { return false; }

    let u16_a = AtomicU16.new(65535u16);
    if u16_a.fetch_add(1u16, Ordering.Acquire) != 65535u16 { return false; }
    if u16_a.fetch_sub(1u16, Ordering.Release) != 0u16 { return false; }
    if u16_a.into_inner() != 65535u16 { return false; }

    let u32_a = AtomicU32.new(0xFFFFFFFFu32);
    if u32_a.fetch_add(1u32, Ordering.SeqCst) != 0xFFFFFFFFu32 { return false; }
    if u32_a.fetch_sub(1u32, Ordering.SeqCst) != 0u32 { return false; }
    if u32_a.into_inner() != 0xFFFFFFFFu32 { return false; }

    let u64_a = AtomicU64.new(0xFFFFFFFFFFFFFFFFu64);
    if u64_a.fetch_add(1u64, Ordering.SeqCst) != 0xFFFFFFFFFFFFFFFFu64 { return false; }
    if u64_a.fetch_sub(1u64, Ordering.SeqCst) != 0u64 { return false; }
    if u64_a.into_inner() != 0xFFFFFFFFFFFFFFFFu64 { return false; }

    let usz_a = AtomicUsize.new(0usize);
    if usz_a.fetch_sub(1usize, Ordering.SeqCst) != 0usize { return false; }
    if usz_a.fetch_add(1usize, Ordering.SeqCst) != 0xFFFFFFFFFFFFFFFFusize { return false; }
    if usz_a.into_inner() != 0usize { return false; }

    // Signed two's-complement wrapping: i8, i16, i32, i64, isize
    let i8_a = AtomicI8.new(127i8);
    if i8_a.fetch_add(1i8, Ordering.SeqCst) != 127i8 { return false; }
    if i8_a.load(Ordering.Relaxed) != -128i8 { return false; }
    if i8_a.fetch_sub(1i8, Ordering.SeqCst) != -128i8 { return false; }
    if i8_a.into_inner() != 127i8 { return false; }

    let i16_a = AtomicI16.new(32767i16);
    if i16_a.fetch_add(1i16, Ordering.SeqCst) != 32767i16 { return false; }
    if i16_a.fetch_sub(1i16, Ordering.SeqCst) != -32768i16 { return false; }
    if i16_a.into_inner() != 32767i16 { return false; }

    let i32_a = AtomicI32.new(2147483647i32);
    let i32_min: i32 = -2147483647i32 - 1i32;
    if i32_a.fetch_add(1i32, Ordering.SeqCst) != 2147483647i32 { return false; }
    if i32_a.fetch_sub(1i32, Ordering.SeqCst) != i32_min { return false; }
    if i32_a.into_inner() != 2147483647i32 { return false; }

    let i64_a = AtomicI64.new(9223372036854775807i64);
    let i64_min: i64 = -9223372036854775807i64 - 1i64;
    if i64_a.fetch_add(1i64, Ordering.SeqCst) != 9223372036854775807i64 { return false; }
    if i64_a.fetch_sub(1i64, Ordering.SeqCst) != i64_min { return false; }
    if i64_a.into_inner() != 9223372036854775807i64 { return false; }

    let isz_a = AtomicIsize.new(-10isize);
    if isz_a.fetch_add(25isize, Ordering.AcqRel) != -10isize { return false; }
    isz_a.into_inner() == 15isize
}

fn test_rmw_bitwise_and_swap() -> bool {
    let ab = AtomicBool.new(false);
    if ab.fetch_or(true, Ordering.AcqRel) { return false; }
    if !ab.load(Ordering.Acquire) { return false; }
    if !ab.fetch_xor(true, Ordering.SeqCst) { return false; }
    if ab.load(Ordering.Relaxed) { return false; }
    if ab.swap(true, Ordering.SeqCst) { return false; }
    if !ab.fetch_and(false, Ordering.Release) { return false; }
    if ab.into_inner() { return false; }

    let a32 = AtomicU32.new(0xF0F00F0Fu32);
    if a32.fetch_and(0x00FFFF00u32, Ordering.AcqRel) != 0xF0F00F0Fu32 { return false; }
    if a32.fetch_or(0xAA000055u32, Ordering.Release) != 0x00F00F00u32 { return false; }
    if a32.fetch_xor(0xFFFFFFFFu32, Ordering.SeqCst) != 0xAAF00F55u32 { return false; }
    if a32.swap(42u32, Ordering.AcqRel) != 0x550FF0AAu32 { return false; }
    a32.into_inner() == 42u32
}

struct SpinProtected {
    pub balance: i64,
    pub tx_count: u64,
}

fn thread_0_spinlock(s: mut_view<SpinProtected>, locked: view<AtomicBool>) {
    let mut k: u32 = 0u32;
    while k < 4u32 {
        while !locked.compare_exchange_weak(false, true, Ordering.Acquire, Ordering.Relaxed).ok {
            spin_loop_hint();
        }
        s.balance = s.balance + 25i64;
        s.tx_count = s.tx_count + 1u64;
        locked.store(false, Ordering.Release);
        k = k + 1u32;
    }
}

fn thread_1_spinlock(s: mut_view<SpinProtected>, locked: view<AtomicBool>) {
    let mut k: u32 = 0u32;
    while k < 4u32 {
        while !locked.compare_exchange_weak(false, true, Ordering.Acquire, Ordering.Relaxed).ok {
            spin_loop_hint();
        }
        s.balance = s.balance + 50i64;
        s.tx_count = s.tx_count + 1u64;
        locked.store(false, Ordering.Release);
        k = k + 1u32;
    }
}

fn test_rmw_spinlock_mutual_exclusion() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 12u64 {
        oracle_set_seed(seed);
        let mut s = SpinProtected {
            balance: 100i64,
            tx_count: 0u64,
        };
        let locked = AtomicBool.new(false);
        thread_0_spinlock(mut_view(s), view(locked));
        thread_1_spinlock(mut_view(s), view(locked));
        oracle_join_all();
        if s.balance != 400i64 || s.tx_count != 8u64 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

fn test_lock_free_queries() -> bool {
    is_lock_free<bool>() &&
    is_lock_free<u8>() &&
    is_lock_free<u16>() &&
    is_lock_free<u32>() &&
    is_lock_free<u64>() &&
    is_lock_free<usize>() &&
    is_lock_free<i8>() &&
    is_lock_free<i16>() &&
    is_lock_free<i32>() &&
    is_lock_free<i64>() &&
    is_lock_free<isize>() &&
    is_lock_free<*mut u64>()
}

pub fn main() -> i32 {
    if !test_rmw_lossless_counter() { return 1; }
    print("rmw_counter:ok\n");
    if !test_rmw_wrapping_all_widths() { return 2; }
    print("rmw_wrapping:ok\n");
    if !test_rmw_bitwise_and_swap() { return 3; }
    print("rmw_bitwise_swap:ok\n");
    if !test_rmw_spinlock_mutual_exclusion() { return 4; }
    print("rmw_spinlock:ok\n");
    if !test_lock_free_queries() { return 5; }
    print("rmw_lock_free:ok\n");
    0
}
