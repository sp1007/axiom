// test: run
// modes: interp native
// stdout: litmus_struct_subword_mp:ok\nlitmus_struct_subword_rel_seq:ok\nlitmus_struct_subword_cas_and_ptrs:ok\nlitmus_struct_subword_views:ok\n
// Covers: AXS-ATM-005, AXS-ATM-008, AXS-ATM-010, AXS-ATM-012, AXS-ATM-018, AXS-ATM-023
// Covers: AXS-ATM-061, AXS-ATM-062, AXS-ATM-063, INV-ATM-002, INV-CONC-006, INV-ORACLE-002
// Covers: REQ-CONC-076, REQ-CONC-077, REQ-CONC-078, REQ-ATM-028, REQ-ATM-029, REQ-ATM-030
// QA post-unblock boundary litmus test 3:
// Stressing struct-embedded sub-64-bit atomics (AtomicBool, AtomicI8, AtomicI16, AtomicI32)
// combined with raw pointer atomics (Atomic<*mut Payload>, Atomic<*const Payload>) in
// Release/Acquire message passing, release-sequence RMW chaining, Store Buffering (SB),
// signed sub-64-bit CAS loops, and view-based method dispatch across helper functions.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Payload {
    pub magic: u64,
    pub tag: i32,
    pub val: u64,
}

struct LitmusChannel {
    pub guard_head: u64,
    pub ready: AtomicBool,
    pub tag: AtomicI8,
    pub seq: AtomicI16,
    pub checksum: AtomicI32,
    pub p_mut: Atomic<*mut Payload>,
    pub p_const: Atomic<*const Payload>,
    pub guard_mid: u32,
    pub guard_tail: u64,
}

fn thread_producer_mp(chan: view<LitmusChannel>, p_m: *mut Payload, p_c: *const Payload) {
    chan.tag.store(-77i8, Ordering.Release);
    chan.seq.store(-1234i16, Ordering.Release);
    chan.checksum.store(-987654321i32, Ordering.Release);
    chan.p_mut.store(p_m, Ordering.Release);
    chan.p_const.store(p_c, Ordering.Release);
    chan.ready.store(true, Ordering.Release);
}

fn thread_consumer_mp(chan: view<LitmusChannel>) -> bool {
    if !chan.ready.load(Ordering.Acquire) {
        return false;
    }
    let t = chan.tag.load(Ordering.Acquire);
    let s = chan.seq.load(Ordering.Acquire);
    let c = chan.checksum.load(Ordering.Acquire);
    let pm = chan.p_mut.load(Ordering.Acquire);
    let pc = chan.p_const.load(Ordering.Acquire);

    if t != -77i8 { return false; }
    if s != -1234i16 { return false; }
    if c != -987654321i32 { return false; }
    if (pm as usize) == 0 || (pc as usize) == 0 { return false; }

    let m_magic = unsafe { (*pm).magic };
    let m_tag = unsafe { (*pm).tag };
    let m_val = unsafe { (*pm).val };
    if m_magic != 0x4AFEBABEDEADBEEFu64 || m_tag != -99i32 || m_val != 88888888u64 {
        return false;
    }

    let c_magic = unsafe { (*pc).magic };
    let c_tag = unsafe { (*pc).tag };
    let c_val = unsafe { (*pc).val };
    if c_magic != 0x0123456789ABCDEFu64 || c_tag != 12345i32 || c_val != 99999999u64 {
        return false;
    }
    true
}

fn test_struct_subword_mp() -> bool {
    let mut pay_m = Payload {
        magic: 0x4AFEBABEDEADBEEFu64,
        tag: -99i32,
        val: 88888888u64,
    };
    let pay_c = Payload {
        magic: 0x0123456789ABCDEFu64,
        tag: 12345i32,
        val: 99999999u64,
    };
    let p_m: *mut Payload = unsafe { address_of_mut(pay_m) };
    let p_c: *const Payload = unsafe { address_of(pay_c) };

    let chan = LitmusChannel {
        guard_head: 0x123456789ABCDEF0u64,
        ready: AtomicBool.new(false),
        tag: AtomicI8.new(0i8),
        seq: AtomicI16.new(0i16),
        checksum: AtomicI32.new(0i32),
        p_mut: Atomic.new(0 as *mut Payload),
        p_const: Atomic.new(0 as *const Payload),
        guard_mid: 0x55555555u32,
        guard_tail: 0x0FEDCBA987654321u64,
    };

    thread_producer_mp(view(chan), p_m, p_c);
    if !thread_consumer_mp(view(chan)) {
        return false;
    }

    if chan.guard_head != 0x123456789ABCDEF0u64 { return false; }
    if chan.guard_mid != 0x55555555u32 { return false; }
    if chan.guard_tail != 0x0FEDCBA987654321u64 { return false; }
    true
}

fn test_struct_subword_rel_seq() -> bool {
    let mut pay = Payload {
        magic: 0x1122334455667788u64,
        tag: 42i32,
        val: 100u64,
    };
    let p_m: *mut Payload = unsafe { address_of_mut(pay) };

    let chan = LitmusChannel {
        guard_head: 0x1234567890ABCDEFu64,
        ready: AtomicBool.new(false),
        tag: AtomicI8.new(10i8),
        seq: AtomicI16.new(200i16),
        checksum: AtomicI32.new(0i32),
        p_mut: Atomic.new(p_m),
        p_const: Atomic.new(0 as *const Payload),
        guard_mid: 0x77777777u32,
        guard_tail: 0x0EDCBA0987654321u64,
    };

    // Head of release sequence stores with Release
    chan.tag.store(20i8, Ordering.Release);

    // Intermediate atomic RMW (fetch_add) continues release sequence
    let prev1 = chan.tag.fetch_add(5i8, Ordering.Relaxed);
    if prev1 != 20i8 { return false; }

    // Intermediate atomic RMW (fetch_sub) continues release sequence
    let prev2 = chan.tag.fetch_sub(2i8, Ordering.Relaxed);
    if prev2 != 25i8 { return false; }

    // Tail consumer loads with Acquire and synchronizes with Thread 0
    let final_tag = chan.tag.load(Ordering.Acquire);
    if final_tag != 23i8 { return false; }

    let p = chan.p_mut.load(Ordering.Acquire);
    let val = unsafe { (*p).val };
    if val != 100u64 { return false; }

    chan.guard_head == 0x1234567890ABCDEFu64 &&
        chan.guard_mid == 0x77777777u32 &&
        chan.guard_tail == 0x0EDCBA0987654321u64
}

fn test_struct_subword_cas_and_ptrs() -> bool {
    let mut p1 = Payload { magic: 100u64, tag: 1i32, val: 10u64 };
    let mut p2 = Payload { magic: 200u64, tag: 2i32, val: 20u64 };
    let mut p3 = Payload { magic: 300u64, tag: 3i32, val: 30u64 };

    let ptr1: *mut Payload = unsafe { address_of_mut(p1) };
    let ptr2: *mut Payload = unsafe { address_of_mut(p2) };
    let ptr3: *mut Payload = unsafe { address_of_mut(p3) };

    let c_ptr1: *const Payload = unsafe { address_of(p1) };
    let c_ptr2: *const Payload = unsafe { address_of(p2) };
    let c_ptr3: *const Payload = unsafe { address_of(p3) };

    let chan = LitmusChannel {
        guard_head: 0x4EEDFACECAFEBEEFu64,
        ready: AtomicBool.new(false),
        tag: AtomicI8.new(-120i8),
        seq: AtomicI16.new(-32000i16),
        checksum: AtomicI32.new(-1000000i32),
        p_mut: Atomic.new(ptr1),
        p_const: Atomic.new(c_ptr1),
        guard_mid: 0x49999999u32,
        guard_tail: 0x5EADBEEF01234567u64,
    };

    // 1. Signed negative i8 CAS loop: -120 -> -128 -> -1 -> 42
    let cas8_1 = chan.tag.compare_exchange(-120i8, -128i8, Ordering.SeqCst, Ordering.Acquire);
    if !cas8_1.ok || cas8_1.val != -120i8 || chan.tag.load(Ordering.Relaxed) != -128i8 {
        return false;
    }

    let cas8_2 = chan.tag.compare_exchange(-128i8, -1i8, Ordering.SeqCst, Ordering.Acquire);
    if !cas8_2.ok || cas8_2.val != -128i8 || chan.tag.load(Ordering.Relaxed) != -1i8 {
        return false;
    }

    let cas8_3 = chan.tag.compare_exchange(-1i8, 42i8, Ordering.SeqCst, Ordering.Acquire);
    if !cas8_3.ok || cas8_3.val != -1i8 || chan.tag.load(Ordering.Relaxed) != 42i8 {
        return false;
    }

    // 2. Signed negative i16 CAS loop: -32000 -> -32768 -> 1000
    let cas16_1 = chan.seq.compare_exchange(-32000i16, -32768i16, Ordering.SeqCst, Ordering.Acquire);
    if !cas16_1.ok || cas16_1.val != -32000i16 || chan.seq.load(Ordering.Relaxed) != -32768i16 {
        return false;
    }

    let cas16_2 = chan.seq.compare_exchange(-32768i16, 1000i16, Ordering.SeqCst, Ordering.Acquire);
    if !cas16_2.ok || cas16_2.val != -32768i16 || chan.seq.load(Ordering.Relaxed) != 1000i16 {
        return false;
    }

    // 3. Pointer Atomic<*mut Payload> swap and compare_exchange
    let prev_pm = chan.p_mut.swap(ptr2, Ordering.AcqRel);
    if (prev_pm as usize) != (ptr1 as usize) { return false; }
    if (chan.p_mut.load(Ordering.Acquire) as usize) != (ptr2 as usize) { return false; }

    let cas_pm = chan.p_mut.compare_exchange(ptr2, ptr3, Ordering.AcqRel, Ordering.Acquire);
    if !cas_pm.ok || (cas_pm.val as usize) != (ptr2 as usize) { return false; }
    let loaded_pm = chan.p_mut.load(Ordering.Acquire);
    if unsafe { (*loaded_pm).magic } != 300u64 { return false; }

    // 4. Pointer Atomic<*const Payload> compare_exchange and swap
    let prev_pc = chan.p_const.swap(c_ptr2, Ordering.AcqRel);
    if (prev_pc as usize) != (c_ptr1 as usize) { return false; }

    let cas_pc = chan.p_const.compare_exchange(c_ptr2, c_ptr3, Ordering.AcqRel, Ordering.Acquire);
    if !cas_pc.ok || (cas_pc.val as usize) != (c_ptr2 as usize) { return false; }
    let loaded_pc = chan.p_const.load(Ordering.Acquire);
    if unsafe { (*loaded_pc).val } != 30u64 { return false; }

    // 5. Verify guards remain untorn
    chan.guard_head == 0x4EEDFACECAFEBEEFu64 &&
        chan.guard_mid == 0x49999999u32 &&
        chan.guard_tail == 0x5EADBEEF01234567u64
}

fn helper_view_dispatch(
    t_v: view<AtomicI8>,
    s_v: view<AtomicI16>,
    c_v: view<AtomicI32>,
    ptr_v: view<Atomic<*const Payload>>
) -> bool {
    let t = t_v.fetch_add(5i8, Ordering.SeqCst);
    let s = s_v.fetch_add(10i16, Ordering.SeqCst);
    let c = c_v.fetch_add(20i32, Ordering.SeqCst);
    let p = ptr_v.load(Ordering.Acquire);
    let m = unsafe { (*p).magic };
    t == 42i8 && s == 1000i16 && c == -1000000i32 && m == 300u64
}

fn test_struct_subword_views() -> bool {
    let mut pay = Payload { magic: 300u64, tag: 3i32, val: 30u64 };
    let p_c: *const Payload = unsafe { address_of(pay) };

    let chan = LitmusChannel {
        guard_head: 0x4999999999999999u64,
        ready: AtomicBool.new(true),
        tag: AtomicI8.new(42i8),
        seq: AtomicI16.new(1000i16),
        checksum: AtomicI32.new(-1000000i32),
        p_mut: Atomic.new(0 as *mut Payload),
        p_const: Atomic.new(p_c),
        guard_mid: 0x44444444u32,
        guard_tail: 0x4888888888888888u64,
    };

    let ok = helper_view_dispatch(view(chan.tag), view(chan.seq), view(chan.checksum), view(chan.p_const));
    if !ok { return false; }

    if chan.tag.load(Ordering.SeqCst) != 47i8 { return false; }
    if chan.seq.load(Ordering.SeqCst) != 1010i16 { return false; }
    if chan.checksum.load(Ordering.SeqCst) != -999980i32 { return false; }

    chan.guard_head == 0x4999999999999999u64 &&
        chan.guard_mid == 0x44444444u32 &&
        chan.guard_tail == 0x4888888888888888u64
}

pub fn main() -> i32 {
    if !test_struct_subword_mp() { return 1; }
    print("litmus_struct_subword_mp:ok\n");

    if !test_struct_subword_rel_seq() { return 2; }
    print("litmus_struct_subword_rel_seq:ok\n");

    if !test_struct_subword_cas_and_ptrs() { return 3; }
    print("litmus_struct_subword_cas_and_ptrs:ok\n");

    if !test_struct_subword_views() { return 4; }
    print("litmus_struct_subword_views:ok\n");

    0
}
