// test: run
// modes: interp
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// Covers: AXS-ATM-008, AXS-ATM-011, AXS-ATM-052, AXS-ATM-060
// Covers: INV-CONC-005, INV-CONC-007, INV-ATM-001, INV-ATM-005
// Covers: REQ-CONC-078, REQ-ATM-028
// E11.2 negative oracle litmus: Unaligned raw-pointer atomic access (`*mut Atomic<u64>`
// at an odd byte offset) is trapped deterministically by the oracle (`AX_UNSAFE_INTERP_UB`,
// exit 125).

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn main() -> i32 {
    let mut buf: [16]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let base = unsafe { address_of_mut(buf[0]) };
    let unaligned = unsafe { (base + 1usize) as *mut Atomic<u64> };
    let v = unsafe { view(*unaligned) };
    let _ = v.load(Ordering.SeqCst);
    0
}
