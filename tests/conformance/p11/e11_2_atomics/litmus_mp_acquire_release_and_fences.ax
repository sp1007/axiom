// test: run
// modes: interp native
// stdout: mp_acq_rel:ok\nmp_fence_rel_acq:ok\nmp_fence_to_atomic:ok\nmp_atomic_to_fence:ok\nmp_rel_seq:ok\n
// Covers: AXS-ATM-001, AXS-ATM-002, AXS-ATM-003, AXS-ATM-014, AXS-ATM-016, AXS-ATM-019
// Covers: AXS-ATM-020, AXS-ATM-023, AXS-ATM-027, AXS-ATM-050, AXS-ATM-051, AXS-ATM-053
// Covers: AXS-ATM-061, AXS-ATM-062, INV-CONC-007, INV-ATM-001, INV-ATM-002, INV-ORACLE-002
// Covers: REQ-CONC-077, REQ-ATM-028
// E11.2 conformance litmus 1: Message Passing (MP) with Acquire/Release, Fence-to-Fence,
// Fence-to-Atomic, Atomic-to-Fence, compiler_fence, and Release-Sequence RMW chains.

struct MpState {
    pub data: u64,
    pub saw_ready: u32,
    pub observed: u64,
}

fn thread_0_mp_rel(s: mut_view<MpState>, ready: view<AtomicBool>) {
    s.data = 42u64;
    ready.store(true, Ordering.Release);
}

fn thread_1_mp_acq(s: mut_view<MpState>, ready: view<AtomicBool>) {
    if ready.load(Ordering.Acquire) {
        s.saw_ready = 1u32;
        s.observed = s.data;
    }
}

fn test_mp_acquire_release() -> bool {
    let mut iter: u32 = 0u32;
    let mut observed_count: u32 = 0u32;
    while iter < 32u32 {
        let mut s = MpState {
            data: 0u64,
            saw_ready: 0u32,
            observed: 0u64,
        };
        let ready = AtomicBool.new(false);
        thread_0_mp_rel(mut_view(s), view(ready));
        thread_1_mp_acq(mut_view(s), view(ready));
        if s.saw_ready == 1u32 {
            if s.observed != 42u64 {
                return false;
            }
            observed_count = observed_count + 1u32;
        }
        iter = iter + 1u32;
    }
    observed_count > 0u32
}

fn thread_0_mp_fence_both(s: mut_view<MpState>, ready: view<AtomicU32>) {
    s.data = 99u64;
    fence(Ordering.Release);
    ready.store(1u32, Ordering.Relaxed);
}

fn thread_1_mp_fence_both(s: mut_view<MpState>, ready: view<AtomicU32>) {
    let flag = ready.load(Ordering.Relaxed);
    if flag == 1u32 {
        fence(Ordering.Acquire);
        s.saw_ready = 1u32;
        s.observed = s.data;
    }
}

fn test_mp_fence_rel_acq() -> bool {
    let mut iter: u32 = 0u32;
    let mut observed_count: u32 = 0u32;
    while iter < 32u32 {
        let mut s = MpState {
            data: 0u64,
            saw_ready: 0u32,
            observed: 0u64,
        };
        let ready = AtomicU32.new(0u32);
        thread_0_mp_fence_both(mut_view(s), view(ready));
        thread_1_mp_fence_both(mut_view(s), view(ready));
        if s.saw_ready == 1u32 {
            if s.observed != 99u64 {
                return false;
            }
            observed_count = observed_count + 1u32;
        }
        iter = iter + 1u32;
    }
    observed_count > 0u32
}

fn thread_0_fence_to_atomic(s: mut_view<MpState>, ready: view<AtomicU32>) {
    s.data = 314u64;
    fence(Ordering.Release);
    ready.store(1u32, Ordering.Relaxed);
}

fn thread_1_fence_to_atomic(s: mut_view<MpState>, ready: view<AtomicU32>) {
    if ready.load(Ordering.Acquire) == 1u32 {
        s.saw_ready = 1u32;
        s.observed = s.data;
    }
}

fn test_mp_fence_to_atomic() -> bool {
    let mut iter: u32 = 0u32;
    let mut observed_count: u32 = 0u32;
    while iter < 32u32 {
        let mut s = MpState {
            data: 0u64,
            saw_ready: 0u32,
            observed: 0u64,
        };
        let ready = AtomicU32.new(0u32);
        thread_0_fence_to_atomic(mut_view(s), view(ready));
        thread_1_fence_to_atomic(mut_view(s), view(ready));
        if s.saw_ready == 1u32 {
            if s.observed != 314u64 {
                return false;
            }
            observed_count = observed_count + 1u32;
        }
        iter = iter + 1u32;
    }
    observed_count > 0u32
}

fn thread_0_atomic_to_fence(s: mut_view<MpState>, ready: view<AtomicU32>) {
    s.data = 700u64;
    ready.store(1u32, Ordering.Release);
}

fn thread_1_atomic_to_fence(s: mut_view<MpState>, ready: view<AtomicU32>) {
    if ready.load(Ordering.Relaxed) == 1u32 {
        fence(Ordering.Acquire);
        compiler_fence(Ordering.Acquire);
        s.saw_ready = 1u32;
        s.observed = s.data;
    }
}

fn test_mp_atomic_to_fence() -> bool {
    let mut iter: u32 = 0u32;
    let mut observed_count: u32 = 0u32;
    while iter < 32u32 {
        let mut s = MpState {
            data: 0u64,
            saw_ready: 0u32,
            observed: 0u64,
        };
        let ready = AtomicU32.new(0u32);
        thread_0_atomic_to_fence(mut_view(s), view(ready));
        thread_1_atomic_to_fence(mut_view(s), view(ready));
        if s.saw_ready == 1u32 {
            if s.observed != 700u64 {
                return false;
            }
            observed_count = observed_count + 1u32;
        }
        iter = iter + 1u32;
    }
    observed_count > 0u32
}

fn thread_0_rel_seq(s: mut_view<MpState>, seq: view<AtomicU32>) {
    s.data = 1234u64;
    seq.store(1u32, Ordering.Release);
}

fn thread_1_rel_seq_rmw(seq: view<AtomicU32>) {
    if seq.load(Ordering.Relaxed) == 1u32 {
        let _ = seq.fetch_add(1u32, Ordering.Relaxed);
    }
}

fn thread_2_rel_seq_acq(s: mut_view<MpState>, seq: view<AtomicU32>) {
    let v = seq.load(Ordering.Acquire);
    if v >= 1u32 {
        s.saw_ready = v;
        s.observed = s.data;
    }
}

fn test_mp_release_sequence() -> bool {
    let mut iter: u32 = 0u32;
    let mut observed_count: u32 = 0u32;
    while iter < 32u32 {
        let mut s = MpState {
            data: 0u64,
            saw_ready: 0u32,
            observed: 0u64,
        };
        let seq = AtomicU32.new(0u32);
        thread_0_rel_seq(mut_view(s), view(seq));
        thread_1_rel_seq_rmw(view(seq));
        thread_2_rel_seq_acq(mut_view(s), view(seq));
        if s.saw_ready >= 1u32 {
            if s.observed != 1234u64 {
                return false;
            }
            observed_count = observed_count + 1u32;
        }
        iter = iter + 1u32;
    }
    observed_count > 0u32
}

pub fn main() -> i32 {
    if !test_mp_acquire_release() { return 1; }
    print("mp_acq_rel:ok\n");
    if !test_mp_fence_rel_acq() { return 2; }
    print("mp_fence_rel_acq:ok\n");
    if !test_mp_fence_to_atomic() { return 3; }
    print("mp_fence_to_atomic:ok\n");
    if !test_mp_atomic_to_fence() { return 4; }
    print("mp_atomic_to_fence:ok\n");
    if !test_mp_release_sequence() { return 5; }
    print("mp_rel_seq:ok\n");
    0
}
