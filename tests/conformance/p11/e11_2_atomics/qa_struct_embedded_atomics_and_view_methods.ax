// test: run
// modes: interp native
// stdout: struct_embedded_atomics:ok\nstruct_view_methods:ok\n
// Covers: AXS-ATM-002, AXS-ATM-005, AXS-ATM-008, AXS-ATM-010, AXS-ATM-012, AXS-ATM-013, AXS-ATM-014
// Covers: AXS-ATM-015, AXS-ATM-017, AXS-ATM-018, AXS-ATM-042, AXS-ATM-043, AXS-ATM-044
// Covers: INV-CONC-006, INV-ATM-001, INV-ATM-002, INV-ORACLE-002
// Covers: REQ-CONC-078, REQ-ATM-028, REQ-ATM-029
// QA boundary test 2: embedding Atomic<T> and prelude atomic type aliases as fields inside a
// user struct (SPEC-31 §4.3 AXS-ATM-010 / AXS-ATM-012) while also passing view<AtomicU32> /
// view<AtomicBool> to helper functions in the same translation unit.

@intrinsic unsafe fn address_of_mut<T>(x: T) -> *mut T { 0 as *mut T }

struct EmbeddedAtomics {
    pub b0: AtomicBool,
    pub u1: AtomicU8,
    pub s2: AtomicU16,
    pub w4: AtomicU32,
    pub g8: Atomic<u64>,
    pub ptr_slot: Atomic<*mut u64>,
    pub guard_tail: u64,
}

fn bump_via_views(flag: view<AtomicBool>, counter: view<AtomicU32>) -> u32 {
    flag.store(true, Ordering.Release);
    counter.fetch_add(10u32, Ordering.AcqRel)
}

fn test_struct_embedded_fields() -> bool {
    let mut target: u64 = 9001u64;
    let p_target: *mut u64 = unsafe { address_of_mut(target) };
    let s = EmbeddedAtomics {
        b0: AtomicBool.new(false),
        u1: AtomicU8.new(0x5Au8),
        s2: AtomicU16.new(0xBEEFu16),
        w4: AtomicU32.new(100u32),
        g8: Atomic.new(5000u64),
        ptr_slot: Atomic.new(p_target),
        guard_tail: 0x0123456789ABCDEFu64,
    };

    // Direct method dispatch on struct-embedded Atomic<T> fields without clobbering neighbors
    s.b0.store(true, Ordering.SeqCst);
    if s.u1.load(Ordering.SeqCst) != 0x5Au8 { return false; }
    if s.u1.fetch_add(6u8, Ordering.SeqCst) != 0x5Au8 { return false; }
    if s.s2.load(Ordering.SeqCst) != 0xBEEFu16 { return false; }

    let c16 = s.s2.compare_exchange(0xBEEFu16, 0x1234u16, Ordering.SeqCst, Ordering.Acquire);
    if !c16.ok || c16.val != 0xBEEFu16 { return false; }
    if s.w4.load(Ordering.SeqCst) != 100u32 { return false; }

    let prev_g8 = s.g8.fetch_add(42u64, Ordering.AcqRel);
    if prev_g8 != 5000u64 || s.g8.load(Ordering.Acquire) != 5042u64 { return false; }

    let loaded_ptr = s.ptr_slot.load(Ordering.Acquire);
    if unsafe { *loaded_ptr } != 9001u64 { return false; }
    if s.guard_tail != 0x0123456789ABCDEFu64 { return false; }

    // View-based method dispatch on the same AtomicBool / AtomicU32 aliases after struct definition
    s.b0.store(false, Ordering.Release);
    let prev_w4 = bump_via_views(view(s.b0), view(s.w4));
    prev_w4 == 100u32 &&
        s.b0.load(Ordering.Acquire) &&
        s.u1.load(Ordering.Relaxed) == 0x60u8 &&
        s.s2.load(Ordering.Relaxed) == 0x1234u16 &&
        s.w4.load(Ordering.Acquire) == 110u32 &&
        s.guard_tail == 0x0123456789ABCDEFu64
}

pub fn main() -> i32 {
    if !test_struct_embedded_fields() { return 1; }
    print("struct_embedded_atomics:ok\n");
    let stand_b = AtomicBool.new(false);
    let stand_w = AtomicU32.new(32u32);
    if bump_via_views(view(stand_b), view(stand_w)) != 32u32 { return 2; }
    if !stand_b.load(Ordering.Acquire) || stand_w.into_inner() != 42u32 { return 3; }
    print("struct_view_methods:ok\n");
    0
}
