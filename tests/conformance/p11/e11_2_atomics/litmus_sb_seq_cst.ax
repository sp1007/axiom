// test: run
// modes: interp native
// stdout: sb_seq_cst_32:ok\nsb_seq_cst_64:ok\nsb_seq_cst_fence:ok\nsb_dekker_exclusion:ok\n
// Covers: AXS-ATM-020, AXS-ATM-025, AXS-ATM-027, AXS-ATM-042, AXS-ATM-043, AXS-ATM-046
// Covers: AXS-ATM-050, AXS-ATM-051, AXS-ATM-053, AXS-ATM-063
// Covers: INV-CONC-006, INV-CONC-007, INV-ATM-002, INV-ATM-003, INV-ORACLE-002
// Covers: REQ-CONC-076, REQ-ATM-028
// E11.2 conformance litmus 2: Store Buffering (SB) with SeqCst stores/loads and
// SeqCst fences, verifying that the weak-memory outcome (r0 == 0 && r1 == 0) is
// strictly forbidden across all oracle schedules and native x86-64 executions.

fn oracle_set_seed(seed: u64) {
    let _ = seed;
}

fn oracle_join_all() {}

struct SbResult32 {
    pub r0: u32,
    pub r1: u32,
}

fn thread_0_sb32(res: mut_view<SbResult32>, x: view<AtomicU32>, y: view<AtomicU32>) {
    x.store(1u32, Ordering.SeqCst);
    res.r0 = y.load(Ordering.SeqCst);
}

fn thread_1_sb32(res: mut_view<SbResult32>, x: view<AtomicU32>, y: view<AtomicU32>) {
    y.store(1u32, Ordering.SeqCst);
    res.r1 = x.load(Ordering.SeqCst);
}

fn test_sb_seq_cst_32() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 32u64 {
        oracle_set_seed(seed);
        let mut res = SbResult32 {
            r0: 0u32,
            r1: 0u32,
        };
        let x = AtomicU32.new(0u32);
        let y = AtomicU32.new(0u32);
        thread_0_sb32(mut_view(res), view(x), view(y));
        thread_1_sb32(mut_view(res), view(x), view(y));
        oracle_join_all();
        if res.r0 == 0u32 && res.r1 == 0u32 {
            return false;
        }
        if (res.r0 + res.r1) < 1u32 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

struct SbResult64 {
    pub r0: i64,
    pub r1: i64,
}

fn thread_0_sb64(res: mut_view<SbResult64>, x: view<AtomicI64>, y: view<AtomicI64>) {
    x.store(1i64, Ordering.SeqCst);
    res.r0 = y.load(Ordering.SeqCst);
}

fn thread_1_sb64(res: mut_view<SbResult64>, x: view<AtomicI64>, y: view<AtomicI64>) {
    y.store(1i64, Ordering.SeqCst);
    res.r1 = x.load(Ordering.SeqCst);
}

fn test_sb_seq_cst_64() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 32u64 {
        oracle_set_seed(seed);
        let mut res = SbResult64 {
            r0: 0i64,
            r1: 0i64,
        };
        let x = AtomicI64.new(0i64);
        let y = AtomicI64.new(0i64);
        thread_0_sb64(mut_view(res), view(x), view(y));
        thread_1_sb64(mut_view(res), view(x), view(y));
        oracle_join_all();
        if res.r0 == 0i64 && res.r1 == 0i64 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

fn thread_0_sb_fence(res: mut_view<SbResult32>, x: view<AtomicU32>, y: view<AtomicU32>) {
    x.store(1u32, Ordering.Relaxed);
    fence(Ordering.SeqCst);
    res.r0 = y.load(Ordering.Relaxed);
}

fn thread_1_sb_fence(res: mut_view<SbResult32>, x: view<AtomicU32>, y: view<AtomicU32>) {
    y.store(1u32, Ordering.Relaxed);
    fence(Ordering.SeqCst);
    res.r1 = x.load(Ordering.Relaxed);
}

fn test_sb_seq_cst_fence() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 32u64 {
        oracle_set_seed(seed);
        let mut res = SbResult32 {
            r0: 0u32,
            r1: 0u32,
        };
        let x = AtomicU32.new(0u32);
        let y = AtomicU32.new(0u32);
        thread_0_sb_fence(mut_view(res), view(x), view(y));
        thread_1_sb_fence(mut_view(res), view(x), view(y));
        oracle_join_all();
        if res.r0 == 0u32 && res.r1 == 0u32 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

struct DekkerState {
    pub entered_0: bool,
    pub entered_1: bool,
}

fn thread_0_dekker(s: mut_view<DekkerState>, flag0: view<AtomicBool>, flag1: view<AtomicBool>) {
    flag0.store(true, Ordering.SeqCst);
    if !flag1.load(Ordering.SeqCst) {
        s.entered_0 = true;
    }
}

fn thread_1_dekker(s: mut_view<DekkerState>, flag0: view<AtomicBool>, flag1: view<AtomicBool>) {
    flag1.store(true, Ordering.SeqCst);
    if !flag0.load(Ordering.SeqCst) {
        s.entered_1 = true;
    }
}

fn test_dekker_exclusion() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 32u64 {
        oracle_set_seed(seed);
        let mut s = DekkerState {
            entered_0: false,
            entered_1: false,
        };
        let flag0 = AtomicBool.new(false);
        let flag1 = AtomicBool.new(false);
        thread_0_dekker(mut_view(s), view(flag0), view(flag1));
        thread_1_dekker(mut_view(s), view(flag0), view(flag1));
        oracle_join_all();
        // Under SeqCst, both threads cannot simultaneously see the other flag as false
        if s.entered_0 && s.entered_1 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

pub fn main() -> i32 {
    if !test_sb_seq_cst_32() { return 1; }
    print("sb_seq_cst_32:ok\n");
    if !test_sb_seq_cst_64() { return 2; }
    print("sb_seq_cst_64:ok\n");
    if !test_sb_seq_cst_fence() { return 3; }
    print("sb_seq_cst_fence:ok\n");
    if !test_dekker_exclusion() { return 4; }
    print("sb_dekker_exclusion:ok\n");
    0
}
