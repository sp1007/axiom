// test: run
// modes: interp
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// Covers: AXS-ATM-001, AXS-ATM-002, AXS-ATM-005, AXS-ATM-052, AXS-ATM-060
// Covers: INV-CONC-007, INV-ATM-001, INV-ATM-005
// E11.2 negative oracle litmus: Concurrent mixed atomic (`Atomic<u64>.store`) and
// non-atomic (`*raw = ...`) access to the same memory location is trapped deterministically
// by the oracle (`AX_UNSAFE_INTERP_UB`, exit 125).

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn thread_0_atomic_writer(slot: view<AtomicU64>) {
    slot.store(100u64, Ordering.Relaxed);
}

fn thread_1_ordinary_writer(raw: *mut u64) {
    unsafe {
        *raw = 200u64;
    }
}

pub fn main() -> i32 {
    let mut slot = AtomicU64.new(0u64);
    let p_slot: *mut Atomic<u64> = unsafe { address_of_mut(slot) };
    let raw: *mut u64 = p_slot as *mut u64;
    thread_0_atomic_writer(view(slot));
    thread_1_ordinary_writer(raw);
    0
}
