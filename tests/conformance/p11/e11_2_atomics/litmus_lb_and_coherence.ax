// test: run
// modes: interp native
// stdout: lb_acq_rel:ok\nlb_relaxed:ok\ncorr:ok\ncowr:ok\ncoww:ok\ncorw:ok\n
// Covers: AXS-ATM-021, AXS-ATM-022, AXS-ATM-023, AXS-ATM-050, AXS-ATM-051, AXS-ATM-053, AXS-ATM-064
// Covers: INV-CONC-007, INV-ATM-002, INV-ATM-003, INV-ORACLE-002
// Covers: REQ-ATM-028
// E11.2 conformance litmus 3: Load Buffering (LB) no-out-of-thin-air (OOTA) and
// per-location modification-order coherence (CoRR, CoWR, CoWW, CoRW).

fn oracle_set_seed(seed: u64) {
    let _ = seed;
}

fn oracle_join_all() {}

struct LbState {
    pub r0: u32,
    pub r1: u32,
}

fn thread_0_lb_acq_rel(s: mut_view<LbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    let v = x.load(Ordering.Acquire);
    s.r0 = v;
    y.store(v, Ordering.Release);
}

fn thread_1_lb_acq_rel(s: mut_view<LbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    let v = y.load(Ordering.Acquire);
    s.r1 = v;
    x.store(v, Ordering.Release);
}

fn test_lb_acq_rel() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 24u64 {
        oracle_set_seed(seed);
        let mut s = LbState {
            r0: 99u32,
            r1: 99u32,
        };
        let x = AtomicU32.new(0u32);
        let y = AtomicU32.new(0u32);
        thread_0_lb_acq_rel(mut_view(s), view(x), view(y));
        thread_1_lb_acq_rel(mut_view(s), view(x), view(y));
        oracle_join_all();
        if s.r0 != 0u32 || s.r1 != 0u32 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

fn thread_0_lb_relaxed(s: mut_view<LbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    let v = x.load(Ordering.Relaxed);
    s.r0 = v;
    if v == 1u32 {
        y.store(1u32, Ordering.Relaxed);
    } else {
        y.store(0u32, Ordering.Relaxed);
    }
}

fn thread_1_lb_relaxed(s: mut_view<LbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    let v = y.load(Ordering.Relaxed);
    s.r1 = v;
    if v == 1u32 {
        x.store(1u32, Ordering.Relaxed);
    } else {
        x.store(0u32, Ordering.Relaxed);
    }
}

fn test_lb_relaxed_no_oota() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 24u64 {
        oracle_set_seed(seed);
        let mut s = LbState {
            r0: 99u32,
            r1: 99u32,
        };
        let x = AtomicU32.new(0u32);
        let y = AtomicU32.new(0u32);
        thread_0_lb_relaxed(mut_view(s), view(x), view(y));
        thread_1_lb_relaxed(mut_view(s), view(x), view(y));
        oracle_join_all();
        // Out-of-thin-air (r0 == 1 || r1 == 1) is forbidden when neither variable was ever written 1
        if s.r0 != 0u32 || s.r1 != 0u32 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

struct CorrState {
    pub r1: u32,
    pub r2: u32,
    pub r3: u32,
}

fn thread_0_corr(x: view<AtomicU32>) {
    x.store(1u32, Ordering.Relaxed);
    x.store(2u32, Ordering.Relaxed);
    x.store(3u32, Ordering.Relaxed);
}

fn thread_1_corr(s: mut_view<CorrState>, x: view<AtomicU32>) {
    s.r1 = x.load(Ordering.Relaxed);
    s.r2 = x.load(Ordering.Relaxed);
    s.r3 = x.load(Ordering.Relaxed);
}

fn test_corr_coherence() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 24u64 {
        oracle_set_seed(seed);
        let mut s = CorrState {
            r1: 0u32,
            r2: 0u32,
            r3: 0u32,
        };
        let x = AtomicU32.new(0u32);
        thread_0_corr(view(x));
        thread_1_corr(mut_view(s), view(x));
        oracle_join_all();
        // Read-Read coherence: later reads on the same thread cannot observe earlier stores in mo
        if s.r1 > s.r2 || s.r2 > s.r3 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

fn test_cowr_coherence() -> bool {
    // Write-Read coherence (CoWR): a read after a write on the same thread (or happens-before path)
    // cannot observe an earlier overwritten value.
    let x = AtomicU32.new(0u32);
    x.store(10u32, Ordering.Relaxed);
    let r1 = x.load(Ordering.Relaxed);
    x.store(20u32, Ordering.Relaxed);
    let r2 = x.load(Ordering.Relaxed);
    r1 == 10u32 && r2 == 20u32
}

fn thread_0_coww(x: view<AtomicU32>, gate: view<AtomicBool>) {
    x.store(10u32, Ordering.Relaxed);
    gate.store(true, Ordering.Release);
}

fn thread_1_coww(x: view<AtomicU32>, gate: view<AtomicBool>) {
    if gate.load(Ordering.Acquire) {
        x.store(20u32, Ordering.Relaxed);
    }
}

fn test_coww_coherence() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 16u64 {
        oracle_set_seed(seed);
        let x = AtomicU32.new(0u32);
        let gate = AtomicBool.new(false);
        thread_0_coww(view(x), view(gate));
        thread_1_coww(view(x), view(gate));
        oracle_join_all();
        let final_v = x.load(Ordering.SeqCst);
        if final_v != 10u32 && final_v != 20u32 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

struct CorwState {
    pub r_before: u32,
}

fn thread_0_corw(s: mut_view<CorwState>, x: view<AtomicU32>) {
    s.r_before = x.load(Ordering.Relaxed);
    x.store(2u32, Ordering.Relaxed);
}

fn thread_1_corw(x: view<AtomicU32>) {
    x.store(1u32, Ordering.Relaxed);
}

fn test_corw_coherence() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 16u64 {
        oracle_set_seed(seed);
        let mut s = CorwState { r_before: 0u32 };
        let x = AtomicU32.new(0u32);
        thread_0_corw(mut_view(s), view(x));
        thread_1_corw(view(x));
        oracle_join_all();
        // r_before on thread 0 sequenced-before x.store(2) can never observe 2
        if s.r_before == 2u32 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

pub fn main() -> i32 {
    if !test_lb_acq_rel() { return 1; }
    print("lb_acq_rel:ok\n");
    if !test_lb_relaxed_no_oota() { return 2; }
    print("lb_relaxed:ok\n");
    if !test_corr_coherence() { return 3; }
    print("corr:ok\n");
    if !test_cowr_coherence() { return 4; }
    print("cowr:ok\n");
    if !test_coww_coherence() { return 5; }
    print("coww:ok\n");
    if !test_corw_coherence() { return 6; }
    print("corw:ok\n");
    0
}
