// test: helper
// Covers: AXS-ATM-028, AXS-ATM-030, AXS-ATM-031, AXS-ATM-032, AXS-ATM-033, AXS-ATM-034
// Covers: INV-CONC-005, INV-ATM-004

fn preserve_all_atomic_mir_ops(a: view<AtomicI64>, p: view<Atomic<*mut i64>>, raw: *mut i64) -> i64 {
    let v0 = a.load(Ordering.Acquire);
    a.store(v0 + 1i64, Ordering.Release);
    let v1 = a.swap(10i64, Ordering.AcqRel);
    let v2 = a.fetch_add(2i64, Ordering.SeqCst);
    let v3 = a.fetch_sub(1i64, Ordering.Relaxed);
    let v4 = a.fetch_and(0xFFi64, Ordering.AcqRel);
    let v5 = a.fetch_or(0x10i64, Ordering.Release);
    let v6 = a.fetch_xor(0x01i64, Ordering.Acquire);
    let c_strong = a.compare_exchange(v6, 99i64, Ordering.SeqCst, Ordering.Acquire);
    let c_weak = a.compare_exchange_weak(99i64, 100i64, Ordering.AcqRel, Ordering.Relaxed);
    let _old_p = p.swap(raw, Ordering.SeqCst);
    fence(Ordering.SeqCst);
    compiler_fence(Ordering.AcqRel);
    spin_loop_hint();
    if c_strong.ok || c_weak.ok {
        v1 + v2 + v3 + v4 + v5
    } else {
        c_strong.val
    }
}

fn main() {
    let a = AtomicI64.new(0i64);
    let null_p: *mut i64 = 0 as *mut i64;
    let p: Atomic<*mut i64> = Atomic.new(null_p);
    let _ = preserve_all_atomic_mir_ops(view(a), view(p), null_p);
}
