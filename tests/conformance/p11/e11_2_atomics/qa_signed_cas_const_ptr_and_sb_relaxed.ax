// test: run
// modes: interp native
// stdout: adjacent_narrow_widths:ok\nsigned_cas_rmw_widths:ok\nconst_ptr_and_alias:ok\nsb_relaxed_and_acq_rel:ok\nowned_move_into_inner:ok\n
// Covers: AXS-ATM-005, AXS-ATM-008, AXS-ATM-010, AXS-ATM-012, AXS-ATM-013, AXS-ATM-014, AXS-ATM-017, AXS-ATM-018
// Covers: AXS-ATM-022, AXS-ATM-042, AXS-ATM-043, AXS-ATM-044, AXS-ATM-045, AXS-ATM-051, AXS-ATM-053, AXS-ATM-063
// Covers: INV-CONC-006, INV-CONC-007, INV-ATM-001, INV-ATM-002, INV-ATM-003, INV-ATM-005, INV-ORACLE-002
// Covers: REQ-CONC-076, REQ-CONC-077, REQ-CONC-078, REQ-ATM-028, REQ-ATM-030
// QA boundary test 1: width-exact sub-64-bit atomics in contiguous arrays (verifying
// SeqCst XCHG, LOCK XADD, bitwise RMW loop, and LOCK CMPXCHG do not over-read/clobber
// neighboring 1/2/4-byte elements), signed negative bit-pattern CAS & bitwise RMW across
// 8/16/32/64-bit widths, Atomic<*const T> operations, LITMUS-SB under Relaxed (AXS-ATM-063(2)),
// and owned Atomic<T> move + into_inner semantics (AXS-ATM-012(2)).

@intrinsic unsafe fn address_of<T>(x: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(x: T) -> *mut T { 0 as *mut T }

fn oracle_set_seed(seed: u64) {
    let _ = seed;
}

fn oracle_join_all() {}

fn test_adjacent_narrow_atomics_no_clobber() -> bool {
    // Contiguous 1-byte atomics (8 bytes total): 64-bit XCHG/XADD/CMPXCHG on [0] would clobber [1..7]
    let b_arr: [8]AtomicBool = [
        AtomicBool.new(false),
        AtomicBool.new(true),
        AtomicBool.new(false),
        AtomicBool.new(true),
        AtomicBool.new(true),
        AtomicBool.new(false),
        AtomicBool.new(true),
        AtomicBool.new(false),
    ];
    b_arr[0usize].store(true, Ordering.SeqCst);
    if !b_arr[1usize].load(Ordering.SeqCst) || b_arr[2usize].load(Ordering.SeqCst) || !b_arr[3usize].load(Ordering.SeqCst) {
        return false;
    }
    let cb = b_arr[0usize].compare_exchange(true, false, Ordering.SeqCst, Ordering.Acquire);
    if !cb.ok || !cb.val || b_arr[0usize].load(Ordering.Acquire) {
        return false;
    }
    if !b_arr[1usize].load(Ordering.SeqCst) || !b_arr[4usize].load(Ordering.SeqCst) {
        return false;
    }

    // Contiguous u8 atomics (8 bytes total): 1-byte LOCK XADD, bitwise RMW loop, and LOCK CMPXCHG
    let u8_arr: [8]AtomicU8 = [
        AtomicU8.new(0x5Au8),
        AtomicU8.new(0xA5u8),
        AtomicU8.new(0x3Cu8),
        AtomicU8.new(0xC3u8),
        AtomicU8.new(0x11u8),
        AtomicU8.new(0x22u8),
        AtomicU8.new(0x33u8),
        AtomicU8.new(0x44u8),
    ];
    if u8_arr[0usize].fetch_add(5u8, Ordering.SeqCst) != 0x5Au8 { return false; }
    if u8_arr[1usize].load(Ordering.SeqCst) != 0xA5u8 { return false; }
    if u8_arr[0usize].fetch_or(0x80u8, Ordering.AcqRel) != 0x5Fu8 { return false; }
    if u8_arr[1usize].load(Ordering.SeqCst) != 0xA5u8 { return false; }
    let cu8 = u8_arr[0usize].compare_exchange(0xDFu8, 0x7Eu8, Ordering.AcqRel, Ordering.Acquire);
    if !cu8.ok || cu8.val != 0xDFu8 { return false; }
    if u8_arr[1usize].load(Ordering.SeqCst) != 0xA5u8 || u8_arr[2usize].load(Ordering.SeqCst) != 0x3Cu8 {
        return false;
    }

    // Contiguous u16 atomics (8 bytes total): 2-byte LOCK XADD & LOCK CMPXCHG must not clobber [1..3]
    let u16_arr: [4]AtomicU16 = [
        AtomicU16.new(0xBEEFu16),
        AtomicU16.new(0xCAFEu16),
        AtomicU16.new(0x1357u16),
        AtomicU16.new(0x2468u16),
    ];
    if u16_arr[0usize].fetch_sub(0x0EEFu16, Ordering.SeqCst) != 0xBEEFu16 { return false; }
    if u16_arr[1usize].load(Ordering.SeqCst) != 0xCAFEu16 { return false; }
    let cu16 = u16_arr[0usize].compare_exchange(0xB000u16, 0x1234u16, Ordering.SeqCst, Ordering.Relaxed);
    if !cu16.ok || cu16.val != 0xB000u16 { return false; }
    if u16_arr[1usize].load(Ordering.SeqCst) != 0xCAFEu16 || u16_arr[2usize].load(Ordering.SeqCst) != 0x1357u16 {
        return false;
    }

    // Contiguous u32 atomics (8 bytes total): 4-byte SeqCst XCHG, RMW & CAS on [0] must not clobber [1]
    let u32_arr: [2]AtomicU32 = [
        AtomicU32.new(0xCAFEBABEu32),
        AtomicU32.new(0xDEADBEEFu32),
    ];
    u32_arr[0usize].store(0x11223344u32, Ordering.SeqCst);
    if u32_arr[1usize].load(Ordering.SeqCst) != 0xDEADBEEFu32 { return false; }
    if u32_arr[0usize].fetch_xor(0x00FF00FFu32, Ordering.SeqCst) != 0x11223344u32 { return false; }
    if u32_arr[1usize].load(Ordering.SeqCst) != 0xDEADBEEFu32 { return false; }
    let cu32 = u32_arr[0usize].compare_exchange(0x11DD33BBu32, 0x778899AAu32, Ordering.SeqCst, Ordering.Acquire);
    cu32.ok && cu32.val == 0x11DD33BBu32 &&
        u32_arr[0usize].load(Ordering.Relaxed) == 0x778899AAu32 &&
        u32_arr[1usize].load(Ordering.Relaxed) == 0xDEADBEEFu32
}

fn test_signed_cas_and_bitwise_rmw_widths() -> bool {
    // 8-bit signed negative CAS & bitwise RMW (sign-extension / width hazard check on AL)
    let a8 = AtomicI8.new(-1i8);
    let c8_fail = a8.compare_exchange(-2i8, 42i8, Ordering.SeqCst, Ordering.Acquire);
    if c8_fail.ok || c8_fail.val != -1i8 { return false; }
    let c8_ok = a8.compare_exchange(-1i8, -128i8, Ordering.AcqRel, Ordering.Acquire);
    if !c8_ok.ok || c8_ok.val != -1i8 || a8.load(Ordering.SeqCst) != -128i8 { return false; }
    if a8.fetch_or(1i8, Ordering.AcqRel) != -128i8 { return false; }
    if a8.load(Ordering.Relaxed) != -127i8 { return false; }
    if a8.swap(127i8, Ordering.SeqCst) != -127i8 { return false; }
    if a8.into_inner() != 127i8 { return false; }

    // 16-bit signed negative CAS & bitwise RMW (sign-extension / width hazard check on AX)
    let a16 = AtomicI16.new(-32768i16);
    let c16_fail = a16.compare_exchange(-1i16, 100i16, Ordering.SeqCst, Ordering.Relaxed);
    if c16_fail.ok || c16_fail.val != -32768i16 { return false; }
    let c16_ok = a16.compare_exchange(-32768i16, -1i16, Ordering.SeqCst, Ordering.SeqCst);
    if !c16_ok.ok || c16_ok.val != -32768i16 { return false; }
    if a16.fetch_xor(-1i16, Ordering.SeqCst) != -1i16 { return false; }
    if a16.into_inner() != 0i16 { return false; }

    // 32-bit signed negative CAS & bitwise RMW (sign-extension / width hazard check on EAX)
    let i32_min: i32 = -2147483647i32 - 1i32;
    let a32 = AtomicI32.new(-1i32);
    let c32_ok = a32.compare_exchange(-1i32, i32_min, Ordering.AcqRel, Ordering.Acquire);
    if !c32_ok.ok || c32_ok.val != -1i32 { return false; }
    if a32.fetch_and(i32_min, Ordering.SeqCst) != i32_min { return false; }
    if a32.into_inner() != i32_min { return false; }

    // 64-bit signed & isize negative weak CAS retry loop
    let a64 = AtomicI64.new(-500i64);
    let mut cur = a64.load(Ordering.Relaxed);
    while true {
        let r = a64.compare_exchange_weak(cur, cur - 500i64, Ordering.AcqRel, Ordering.Acquire);
        if r.ok {
            break;
        }
        cur = r.val;
        spin_loop_hint();
    }
    let aisz = AtomicIsize.new(-99isize);
    let r_isz = aisz.compare_exchange(-99isize, 99isize, Ordering.SeqCst, Ordering.SeqCst);
    r_isz.ok && r_isz.val == -99isize && a64.into_inner() == -1000i64 && aisz.into_inner() == 99isize
}

fn test_const_ptr_and_atomic_ptr_alias() -> bool {
    let x1: u64 = 1111u64;
    let x2: u64 = 2222u64;
    let p1: *const u64 = unsafe { address_of(x1) };
    let p2: *const u64 = unsafe { address_of(x2) };

    let cslot: Atomic<*const u64> = Atomic.new(p1);
    if !is_lock_free<*const u64>() { return false; }
    let loaded = cslot.load(Ordering.Acquire);
    if (loaded as usize) != (p1 as usize) { return false; }
    if unsafe { *loaded } != 1111u64 { return false; }

    let cas_res = cslot.compare_exchange(p1, p2, Ordering.AcqRel, Ordering.Acquire);
    if !cas_res.ok || (cas_res.val as usize) != (p1 as usize) { return false; }
    if unsafe { *cslot.into_inner() } != 2222u64 { return false; }

    let mut m1: u32 = 77u32;
    let mp1: *mut u32 = unsafe { address_of_mut(m1) };
    let mut_slot: Atomic<*mut u32> = Atomic.new(mp1);
    mut_slot.store(mp1, Ordering.Release);
    let m_loaded = mut_slot.load(Ordering.Acquire);
    unsafe { *m_loaded == 77u32 }
}

struct SbRelaxedRes {
    pub r0: u32,
    pub r1: u32,
}

fn thread_0_sb_rel(res: mut_view<SbRelaxedRes>, x: view<AtomicU32>, y: view<AtomicU32>) {
    x.store(1u32, Ordering.Relaxed);
    res.r0 = y.load(Ordering.Relaxed);
}

fn thread_1_sb_rel(res: mut_view<SbRelaxedRes>, x: view<AtomicU32>, y: view<AtomicU32>) {
    y.store(1u32, Ordering.Relaxed);
    res.r1 = x.load(Ordering.Relaxed);
}

fn test_sb_relaxed_and_acq_rel_permitted() -> bool {
    // AXS-ATM-063(2): Under Relaxed (or Release/Acquire), Store Buffering does not trap with UB;
    // any outcome in {(0,0), (0,1), (1,0), (1,1)} is valid, and final stores settle to 1.
    let mut seed: u64 = 1u64;
    while seed <= 16u64 {
        oracle_set_seed(seed);
        let mut res = SbRelaxedRes { r0: 99u32, r1: 99u32 };
        let x = AtomicU32.new(0u32);
        let y = AtomicU32.new(0u32);
        thread_0_sb_rel(mut_view(res), view(x), view(y));
        thread_1_sb_rel(mut_view(res), view(x), view(y));
        oracle_join_all();
        if res.r0 > 1u32 || res.r1 > 1u32 {
            return false;
        }
        if x.load(Ordering.SeqCst) != 1u32 || y.load(Ordering.SeqCst) != 1u32 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

fn test_owned_move_and_into_inner() -> bool {
    // AXS-ATM-012(2): Uniquely owned Atomic<T> can be moved by value and consumed via into_inner()
    let first = AtomicU64.new(100u64);
    let _ = first.fetch_add(50u64, Ordering.Relaxed);
    let moved = first;
    let _ = moved.fetch_sub(25u64, Ordering.Relaxed);
    moved.into_inner() == 125u64
}

pub fn main() -> i32 {
    if !test_adjacent_narrow_atomics_no_clobber() { return 10; }
    print("adjacent_narrow_widths:ok\n");
    if !test_signed_cas_and_bitwise_rmw_widths() { return 1; }
    print("signed_cas_rmw_widths:ok\n");
    if !test_const_ptr_and_atomic_ptr_alias() { return 2; }
    print("const_ptr_and_alias:ok\n");
    if !test_sb_relaxed_and_acq_rel_permitted() { return 3; }
    print("sb_relaxed_and_acq_rel:ok\n");
    if !test_owned_move_and_into_inner() { return 4; }
    print("owned_move_into_inner:ok\n");
    0
}
