// test: run
// modes: interp
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// Covers: AXS-ATM-003, AXS-ATM-022, AXS-ATM-051, AXS-ATM-052, AXS-ATM-060, AXS-ATM-061
// Covers: INV-CONC-007, INV-ATM-002, INV-ATM-005
// E11.2 negative oracle litmus: Message Passing (MP) with Relaxed store/load fails to
// establish Synchronizes-With, so concurrent read of ordinary `payload` is trapped
// deterministically as a data race (`AX_UNSAFE_INTERP_UB`, exit 125).

struct RelaxedMpState {
    pub payload: u64,
    pub observed: u64,
}

fn thread_0_relaxed_producer(s: mut_view<RelaxedMpState>, ready: view<AtomicU32>) {
    s.payload = 42u64;
    ready.store(1u32, Ordering.Relaxed);
}

fn thread_1_relaxed_consumer(s: mut_view<RelaxedMpState>, ready: view<AtomicU32>) {
    let _ = ready.load(Ordering.Relaxed);
    s.observed = s.payload;
}

pub fn main() -> i32 {
    let mut s = RelaxedMpState {
        payload: 0u64,
        observed: 0u64,
    };
    let ready = AtomicU32.new(0u32);
    thread_0_relaxed_producer(mut_view(s), view(ready));
    thread_1_relaxed_consumer(mut_view(s), view(ready));
    0
}
