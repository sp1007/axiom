cmd: {compiler} inspect --emit=mir-opt -O1 --std-root {std_root} {test_dir}/mir_atomic_opt_and_lowering.ax
stdout-contains: atomic_load Acquire
stdout-contains: atomic_store Release
stdout-contains: atomic_rmw xchg AcqRel
stdout-contains: atomic_rmw add SeqCst
stdout-contains: atomic_rmw sub Relaxed
stdout-contains: atomic_rmw and AcqRel
stdout-contains: atomic_rmw or Release
stdout-contains: atomic_rmw xor Acquire
stdout-contains: atomic_cmpxchg SeqCst Acquire
stdout-contains: atomic_cmpxchg_weak AcqRel Relaxed
stdout-contains: atomic_fence SeqCst
stdout-contains: compiler_fence AcqRel
stdout-contains: spin_loop_hint
