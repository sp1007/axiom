// test: ui
// Covers: AXS-ATM-002, AXS-ATM-004, AXS-ATM-005, AXS-ATM-008, AXS-ATM-010, AXS-ATM-011
// Covers: AXS-ATM-015, AXS-ATM-017, AXS-ATM-020, AXS-ATM-026, AXS-ATM-032, AXS-ATM-060
// Covers: INV-CONC-005, INV-ATM-001, INV-ATM-002
// Covers: REQ-CONC-078, REQ-ATM-028
// E11.2 negative UI conformance: compile-time rejection of unsupported Atomic<T> element
// types (`AX_CONC_INVALID_ATOMIC_TYPE`), arithmetic/bitwise RMW on raw pointers or bool,
// packed/under-aligned Atomic<T> fields (`AX_CONC_INVALID_ATOMIC_ALIGNMENT`), inner
// `mut_view` or private `.v` projection (`AX_CONC_ATOMIC_MUT_VIEW`), and illegal or
// non-constant memory orderings (`AX_CONC_INVALID_ATOMIC_ORDERING`).

struct NonAtomicPayload {
    x: i64,
    y: i64,
}

@repr(packed)
struct PackedAtomic {
    pad: u8,
    counter: AtomicU64, //~ ERROR AX_CONC_INVALID_ATOMIC_ALIGNMENT
}

@align(2)
struct UnderAlignedAtomic {
    counter: AtomicU64, //~ ERROR AX_CONC_INVALID_ATOMIC_ALIGNMENT
}

fn reject_invalid_types_and_rmw(
    _bad_struct: Atomic<NonAtomicPayload>, //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    _bad_tuple: Atomic<(i32, i32)>, //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    _bad_u128: Atomic<u128>, //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    ab: view<AtomicBool>,
    aptr: view<Atomic<*mut i64>>,
    raw: *mut i64,
) {
    let _ = ab.fetch_add(true, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    let _ = aptr.fetch_add(raw, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    let _ = is_lock_free<u128>(); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
}

fn reject_mut_view_and_invalid_orderings(a: view<AtomicI64>, dyn_ord: Ordering) {
    let mut owned_atom = AtomicI64.new(0i64);
    let _mv = mut_view(owned_atom); //~ ERROR AX_CONC_ATOMIC_MUT_VIEW
    let _field = a.v; //~ ERROR AX_CONC_ATOMIC_MUT_VIEW

    let _ = a.load(Ordering.Release); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.load(Ordering.AcqRel); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    a.store(1i64, Ordering.Acquire); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    a.store(1i64, Ordering.AcqRel); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange(0i64, 1i64, Ordering.Release, Ordering.Acquire); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange(0i64, 1i64, Ordering.Acquire, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange_weak(0i64, 1i64, Ordering.Relaxed, Ordering.Release); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    fence(Ordering.Relaxed); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    compiler_fence(Ordering.Relaxed); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.load(dyn_ord); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
}

fn main() {}
