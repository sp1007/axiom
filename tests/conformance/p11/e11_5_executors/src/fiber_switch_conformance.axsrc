module main

use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.FiberScheduler
use std.fiber.yield_val
use std.fiber.yield_now

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Context-switching conformance for stackful fibers (AXS-EXEC-050..053, REQ-CONC-151):
//  A. Every resume/yield pair is an exact switch: 1000 resumes of one fiber give the yields in order,
//     the fiber's stack-resident accumulator (an array local) survives all 1000 switches.
//  B. Three fibers rotated by the resumer keep independent stacks and positions; the log is exact.
//  C. Recursion 40 frames deep suspends at the bottom and the frames above survive the switch.
//  D. A suspended fiber dropped without being finished does not disturb the fibers created after it.
//  E. FiberScheduler runs fibers round-robin: strict interleave.

fn step(f: mut_view<Fiber<i64, i64>>) -> i64 {
    match f.resume() {
        FiberState.Yielded(v) => v,
        FiberState.Completed(r) => r + 1000000i64,
        FiberState.Panicked => -1i64,
    }
}

fn dive(n: i64) -> i64 {
    if n == 0i64 {
        yield_val<i64>(777i64);
        return 0i64;
    }
    let below = dive(n - 1i64);
    below + 1i64
}

fn worker(id: i64, rounds: i64, log: *mut i64, n: *mut i64) {
    let mut r: i64 = 0i64;
    while r < rounds {
        unsafe {
            *(log + (*n as usize)) = id * 10i64 + r;
            *n = *n + 1i64;
        }
        yield_now();
        r = r + 1i64;
    }
}

pub fn main() -> i32 {
    // A
    let mut fa: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        let mut acc: [4]i64 = [0i64; 4];
        let mut i: i64 = 0i64;
        while i < 1000i64 {
            acc[(i % 4i64) as usize] = acc[(i % 4i64) as usize] + i;
            yield_val<i64>(i * 2i64);
            i = i + 1i64;
        }
        acc[0] + acc[1] + acc[2] + acc[3]
    });
    let mut a_ok: i64 = 1i64;
    let mut i: i64 = 0i64;
    while i < 1000i64 {
        let v = step(mut_view(fa));
        if v != i * 2i64 {
            a_ok = 0i64;
        }
        i = i + 1i64;
    }
    check(!view(fa).is_completed());
    let a_final = step(mut_view(fa));
    check(view(fa).is_completed());
    check(a_final == 1000000i64 + 499500i64);

    // B
    let mut f1: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(1i64);
        yield_val<i64>(2i64);
        3i64
    });
    let mut f2: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(4i64);
        5i64
    });
    let mut f3: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        6i64
    });
    let mut b_log: i64 = 0i64;
    let mut round: i64 = 0i64;
    while round < 3i64 {
        if !view(f1).is_completed() { b_log = b_log * 1000i64 + 100i64 + step(mut_view(f1)) % 1000000i64; }
        if !view(f2).is_completed() { b_log = b_log * 1000i64 + 200i64 + step(mut_view(f2)) % 1000000i64; }
        if !view(f3).is_completed() { b_log = b_log * 1000i64 + 300i64 + step(mut_view(f3)) % 1000000i64; }
        round = round + 1i64;
    }
    check(view(f1).is_completed() && view(f2).is_completed() && view(f3).is_completed());

    // C
    let mut fc: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        dive(40i64)
    });
    let c1 = step(mut_view(fc));
    let c2 = step(mut_view(fc));
    check(c1 == 777i64);
    check(c2 == 1000000i64 + 40i64);

    // D
    {
        let mut fd: Fiber<i64, i64> = Fiber.new(|| -> i64 {
            yield_val<i64>(1i64);
            yield_val<i64>(2i64);
            3i64
        });
        let d1 = step(mut_view(fd));
        check(d1 == 1i64);
    }
    let mut fe: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        yield_val<i64>(41i64);
        42i64
    });
    let e1 = step(mut_view(fe));
    let e2 = step(mut_view(fe));
    check(e1 == 41i64);
    check(e2 == 1000042i64);

    // E
    let mut slots: [16]i64 = [0i64; 16];
    let mut count: i64 = 0i64;
    let log: *mut i64 = unsafe { address_of_mut(slots[0]) };
    let n: *mut i64 = unsafe { address_of_mut(count) };
    let mut sched = FiberScheduler.new();
    sched.spawn(|| { worker(1i64, 3i64, log, n); });
    sched.spawn(|| { worker(2i64, 3i64, log, n); });
    sched.spawn(|| { worker(3i64, 2i64, log, n); });
    sched.run();
    check(count == 8i64);
    let mut e_log: i64 = 0i64;
    let mut k: usize = 0usize;
    while k < 8usize {
        e_log = e_log * 100i64 + slots[k];
        k = k + 1i64 as usize;
    }

    print("OK fiber_switch_conformance ");
    print_int(a_ok);
    print(" ");
    print_int(b_log);
    print(" ");
    print_int(c2 - 1000000i64);
    print(" ");
    print_int(e_log);
    print("\n");
    0
}
