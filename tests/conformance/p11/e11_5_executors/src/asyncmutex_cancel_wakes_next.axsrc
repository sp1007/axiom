module main

use std.core.option.Option
use std.core.result.Result
use std.core.prelude.Context
use std.core.host.heap_alloc
use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskResult
use std.asyn.task.LocalTaskHandle
use std.asyn.sync.AsyncMutex
use std.asyn.sync.AsyncMutexGuard
use std.asyn.sync.AsyncMutexLockFuture

// AsyncMutex cancellation safety (AXS-EXEC-031), driven end to end through a deterministic
// LocalExecutor and real task cancellation (LocalTaskHandle.cancel): whenever a waiter or a
// holder is cancelled, the lock must reach the next waiter in FIFO order -- never stay locked,
// never be skipped, never be granted twice. `log` collects the ids of the tasks in the order in
// which they acquired the lock (decimal digits).
//  S1: a queued waiter is cancelled while the guard is held by the main thread.
//  S2: the lock was already handed to a waiter (granted, not yet re-polled) when that waiter, and
//      then another queued one, are cancelled.
//  S3: the holder is a task that keeps the guard across several `.await`s; a queued waiter is
//      cancelled mid-hold.
//  S4: the holding task itself is cancelled while it holds the guard: dropping its future releases
//      the guard and hands the lock on.

struct Waiter {
    pub fut: AsyncMutexLockFuture<i64>,
    pub id: i64,
    pub log: *mut i64,
    pub hold: i64,
    pub step: i64,
    pub got: Option<AsyncMutexGuard<i64>>,
}

impl Future for Waiter {
    type Output = i64;
    fn poll(self: mut_view<Waiter>, cx: mut_view<Context>) -> Poll<i64> {
        if self.step == 0i64 {
            match self.fut.poll_lock(mut_view(*cx)) {
                Poll.Ready(g) => {
                    unsafe {
                        *self.log = *self.log * 10i64 + self.id;
                    }
                    self.got = Option.Some(g);
                    self.step = 1i64;
                },
                Poll.Pending => {
                    return Poll.Pending;
                },
            }
        }
        // Holding the guard across suspension points for `hold` more polls.
        if self.step <= self.hold {
            self.step = self.step + 1i64;
            let mut w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        self.got = Option.None;
        Poll.Ready(self.id)
    }
}

fn mk(m: view<AsyncMutex<i64>>, id: i64, hold: i64, log: *mut i64) -> Waiter {
    Waiter { fut: m.lock_async(), id: id, log: log, hold: hold, step: 0i64, got: Option.None }
}

fn tick_n(exec: mut_view<LocalExecutor>, n: i32) {
    let mut k: i32 = 0i32;
    while k < n {
        let more = mut_view(*exec).try_tick();
        k = k + 1i32;
    }
}

fn is_free(m: view<AsyncMutex<i64>>) -> bool {
    match m.try_lock() {
        Option.Some(_g) => true,
        Option.None => false,
    }
}

fn new_log() -> *mut i64 {
    let raw = unsafe { heap_alloc(8, 8) };
    let p = raw as *mut i64;
    unsafe {
        *p = 0i64;
    }
    p
}

// 1 = completed, 2 = cancelled, 3 = panicked.
fn kind(r: TaskResult<i64>) -> i64 {
    match r {
        TaskResult.Completed(v) => 1i64,
        TaskResult.Cancelled => 2i64,
        TaskResult.Panicked => 3i64,
    }
}

pub fn main() -> i32 {
    let mut kinds: i64 = 0i64;

    // S1
    let m1 = AsyncMutex.new(0i64);
    let log1 = new_log();
    {
        let mut exec = LocalExecutor.new();
        let g0 = m1.try_lock();
        let h1 = exec.spawn_local(mk(view(m1), 1i64, 0i64, log1));
        let h2 = exec.spawn_local(mk(view(m1), 2i64, 0i64, log1));
        let h3 = exec.spawn_local(mk(view(m1), 3i64, 0i64, log1));
        tick_n(mut_view(exec), 3i32);
        check(unsafe { *log1 } == 0i64);
        h1.cancel();
        tick_n(mut_view(exec), 1i32);
        check(exec.active_task_count() == 2usize);
        check(!is_free(view(m1)));
        {
            let released = g0;
        }
        exec.run();
        kinds = kinds * 10i64 + kind(h1.join_blocking());
        kinds = kinds * 10i64 + kind(h2.join_blocking());
        kinds = kinds * 10i64 + kind(h3.join_blocking());
    }
    check(unsafe { *log1 } == 23i64);
    check(is_free(view(m1)));

    // S2
    let m2 = AsyncMutex.new(0i64);
    let log2 = new_log();
    {
        let mut exec = LocalExecutor.new();
        let g0 = m2.try_lock();
        let h1 = exec.spawn_local(mk(view(m2), 1i64, 0i64, log2));
        let h2 = exec.spawn_local(mk(view(m2), 2i64, 0i64, log2));
        let h3 = exec.spawn_local(mk(view(m2), 3i64, 0i64, log2));
        let h4 = exec.spawn_local(mk(view(m2), 4i64, 0i64, log2));
        tick_n(mut_view(exec), 4i32);
        {
            let released = g0;
        }
        // The release granted the lock to waiter 1 (not yet re-polled): cancel it, and also queued waiter 2.
        check(!is_free(view(m2)));
        h1.cancel();
        h2.cancel();
        exec.run();
        kinds = kinds * 10i64 + kind(h1.join_blocking());
        kinds = kinds * 10i64 + kind(h2.join_blocking());
        kinds = kinds * 10i64 + kind(h3.join_blocking());
        kinds = kinds * 10i64 + kind(h4.join_blocking());
    }
    check(unsafe { *log2 } == 34i64);
    check(is_free(view(m2)));

    // S3
    let m3 = AsyncMutex.new(0i64);
    let log3 = new_log();
    {
        let mut exec = LocalExecutor.new();
        let h1 = exec.spawn_local(mk(view(m3), 1i64, 4i64, log3));
        let h2 = exec.spawn_local(mk(view(m3), 2i64, 0i64, log3));
        let h3 = exec.spawn_local(mk(view(m3), 3i64, 0i64, log3));
        let h4 = exec.spawn_local(mk(view(m3), 4i64, 0i64, log3));
        tick_n(mut_view(exec), 6i32);
        check(unsafe { *log3 } == 1i64);
        h2.cancel();
        exec.run();
        kinds = kinds * 10i64 + kind(h1.join_blocking());
        kinds = kinds * 10i64 + kind(h2.join_blocking());
        kinds = kinds * 10i64 + kind(h3.join_blocking());
        kinds = kinds * 10i64 + kind(h4.join_blocking());
    }
    check(unsafe { *log3 } == 134i64);
    check(is_free(view(m3)));

    // S4
    let m4 = AsyncMutex.new(0i64);
    let log4 = new_log();
    {
        let mut exec = LocalExecutor.new();
        let h1 = exec.spawn_local(mk(view(m4), 1i64, 50i64, log4));
        let h2 = exec.spawn_local(mk(view(m4), 2i64, 0i64, log4));
        let h3 = exec.spawn_local(mk(view(m4), 3i64, 0i64, log4));
        tick_n(mut_view(exec), 6i32);
        check(unsafe { *log4 } == 1i64);
        check(!is_free(view(m4)));
        h1.cancel();
        exec.run();
        kinds = kinds * 10i64 + kind(h1.join_blocking());
        kinds = kinds * 10i64 + kind(h2.join_blocking());
        kinds = kinds * 10i64 + kind(h3.join_blocking());
    }
    check(unsafe { *log4 } == 123i64);
    check(is_free(view(m4)));

    print("OK asyncmutex_cancel_wakes_next ");
    print_int(unsafe { *log1 });
    print(" ");
    print_int(unsafe { *log2 });
    print(" ");
    print_int(unsafe { *log3 });
    print(" ");
    print_int(unsafe { *log4 });
    print(" ");
    print_int(kinds);
    print("\n");
    0
}
