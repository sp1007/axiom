module main

use std.core.option.Option
use std.core.result.Result
use std.core.prelude.Context
use std.core.host.heap_alloc
use std.core.host.thread_yield
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.asyn.executor.Executor
use std.asyn.task.TaskHandle
use std.asyn.task.TaskId
use std.asyn.cancel.CancelledFuture
use std.asyn.cancel.CancellationToken
use std.asyn.task.TaskError
use std.asyn.group.TaskGroup
use std.asyn.group.GroupError

// Structured cancellation tree on the 4-worker work-stealing Executor (AXS-EXEC-020, -022, -023).
//
//   root ---- 1 coop
//     |--- g1 ---- 2 coop + 1 looper
//     `--- g2 ---- 1 coop + 1 looper
//            `--- g2a ---- 2 coop
//
// Every group's token is a child of its parent's token. Cancellation flows down the tree only, it is
// cooperative (a token never kills a task that does not look at it) and `cancel_all` / `Drop` of a
// group are what stop non-cooperative children. `alive` counts constructed minus dropped futures:
// 0 at the end proves every future of the tree was dropped exactly once.

fn cell() -> *mut i64 {
    let raw = unsafe { heap_alloc(32, 8) };
    let p = raw as *mut i64;
    unsafe {
        *p = 0i64;
        *(p + 1usize) = 0i64;
        *(p + 2usize) = 0i64;
        *(p + 3usize) = 0i64;
    }
    p
}

fn new_counter() -> *mut Atomic<i64> {
    let raw = unsafe { heap_alloc(8, 8) };
    let p = raw as *mut Atomic<i64>;
    unsafe {
        *p = Atomic.new(0i64);
    }
    p
}

fn born(alive: *mut Atomic<i64>) {
    unsafe {
        (*alive).fetch_add(1i64, Ordering.AcqRel);
    }
}

fn died(alive: *mut Atomic<i64>) {
    unsafe {
        (*alive).fetch_sub(1i64, Ordering.AcqRel);
    }
}

// Finishes with 5 as soon as its group's token is cancelled.
struct Coop {
    pub fut: CancelledFuture,
    pub alive: *mut Atomic<i64>,
}

unsafe impl Send for Coop {}

impl Future for Coop {
    type Output = i64;
    fn poll(self: mut_view<Coop>, cx: mut_view<Context>) -> Poll<i64> {
        match self.fut.poll(mut_view(*cx)) {
            Poll.Ready(u) => Poll.Ready(5i64),
            Poll.Pending => Poll.Pending,
        }
    }
}

impl Drop for Coop {
    fn drop(self: mut_view<Coop>) {
        died(self.alive);
    }
}

// Ignores its token and runs (re-waking itself) until the executor drops it.
struct Looper {
    pub alive: *mut Atomic<i64>,
}

unsafe impl Send for Looper {}

impl Future for Looper {
    type Output = i64;
    fn poll(self: mut_view<Looper>, cx: mut_view<Context>) -> Poll<i64> {
        let mut w = cx.waker();
        view(w).wake_by_ref();
        Poll.Pending
    }
}

impl Drop for Looper {
    fn drop(self: mut_view<Looper>) {
        died(self.alive);
    }
}

fn is_ok(r: Result<TaskId, GroupError>) -> bool {
    match r {
        Result.Ok(id) => true,
        Result.Err(e) => false,
    }
}

fn add_coop(group: mut_view<TaskGroup<i64>>, exec: view<Executor>, alive: *mut Atomic<i64>) {
    let tok = view(*group).cancellation_token();
    born(alive);
    check(is_ok(group.spawn(exec, Coop { fut: tok.cancelled(), alive: alive })));
}

fn add_looper(group: mut_view<TaskGroup<i64>>, exec: view<Executor>, alive: *mut Atomic<i64>) {
    born(alive);
    check(is_ok(group.spawn(exec, Looper { alive: alive })));
}

fn settle() {
    let mut k: i32 = 0i32;
    while k < 300i32 {
        unsafe {
            thread_yield();
        }
        k = k + 1i32;
    }
}

// Collect exactly `n` results of `group` into the tally: [0] completed, [1] sum of values,
// [2] cancelled, [3] panicked.
fn reap(group: mut_view<TaskGroup<i64>>, n: i32, tally: *mut i64) {
    let mut k: i32 = 0i32;
    while k < n {
        let r: Option<Result<i64, TaskError>> = group.next_blocking();
        match r {
            Option.Some(res) => match res {
                Result.Ok(v) => unsafe {
                    *tally = *tally + 1i64;
                    *(tally + 1usize) = *(tally + 1usize) + v;
                },
                Result.Err(e) => match e {
                    TaskError.Cancelled => unsafe {
                        *(tally + 2usize) = *(tally + 2usize) + 1i64;
                    },
                    TaskError.Panicked => unsafe {
                        *(tally + 3usize) = *(tally + 3usize) + 1i64;
                    },
                },
            },
            Option.None => {
                check(false);
            },
        }
        k = k + 1i32;
    }
}

fn none_finished(group: mut_view<TaskGroup<i64>>) -> bool {
    let r: Option<Result<i64, TaskError>> = group.try_next();
    match r {
        Option.Some(res) => false,
        Option.None => true,
    }
}

pub fn main() -> i32 {
    let exec = Executor.new(4);
    let alive = new_counter();
    let tally = cell();

    {
        let mut root = TaskGroup.new();
        let root_tok = root.cancellation_token();
        let mut g1 = TaskGroup.with_cancellation(view(root_tok));
        let mut g2 = TaskGroup.with_cancellation(view(root_tok));
        let g2_tok = g2.cancellation_token();
        let mut g2a = TaskGroup.with_cancellation(view(g2_tok));

        add_coop(mut_view(root), view(exec), alive);
        add_coop(mut_view(g1), view(exec), alive);
        add_coop(mut_view(g1), view(exec), alive);
        add_looper(mut_view(g1), view(exec), alive);
        add_coop(mut_view(g2), view(exec), alive);
        add_looper(mut_view(g2), view(exec), alive);
        add_coop(mut_view(g2a), view(exec), alive);
        add_coop(mut_view(g2a), view(exec), alive);
        check(unsafe { (*alive).load(Ordering.Acquire) } == 8i64);

        // Nothing cancelled yet: every task is still pending.
        settle();
        check(!root.is_cancelled() && !g1.is_cancelled() && !g2.is_cancelled() && !g2a.is_cancelled());
        check(none_finished(mut_view(root)));
        check(none_finished(mut_view(g1)));
        check(none_finished(mut_view(g2)));
        check(none_finished(mut_view(g2a)));

        // Cancel the middle group's token: it flows down to g2a, never up or sideways.
        g2.cancel_source.cancel();
        check(g2.is_cancelled());
        check(g2a.is_cancelled());
        check(!root.is_cancelled());
        check(!g1.is_cancelled());
        reap(mut_view(g2a), 2i32, tally);
        reap(mut_view(g2), 1i32, tally);
        check(g2a.live_count() == 0usize);
        check(g2.live_count() == 1usize);
        // The non-cooperative looper of g2 ignores the token and keeps running.
        settle();
        check(none_finished(mut_view(g2)));
        check(none_finished(mut_view(g1)));
        check(none_finished(mut_view(root)));
        check(root.live_count() == 1usize);
        check(g1.live_count() == 3usize);

        // Cancel the root token: every remaining cooperative task finishes, the looper of g1 survives.
        root.cancel_source.cancel();
        check(g1.is_cancelled());
        reap(mut_view(root), 1i32, tally);
        reap(mut_view(g1), 2i32, tally);
        settle();
        check(none_finished(mut_view(g1)));
        check(g1.live_count() == 1usize);
        check(!g1.is_failed() && !g2.is_failed() && !root.is_failed());

        // cancel_all is the cooperative-or-forced end of the loopers: g1 explicitly ...
        mut_view(g1).cancel_all();
        reap(mut_view(g1), 1i32, tally);
        check(g1.live_count() == 0usize);
        // ... g2 by dropping the group while its looper is still running (REQ-CONC-155).
        check(g2.live_count() == 1usize);
    }
    let a = unsafe { (*alive).load(Ordering.Acquire) };
    check(a == 0i64);

    exec.shutdown();

    let completed = unsafe { *tally };
    let sum = unsafe { *(tally + 1usize) };
    let cancelled = unsafe { *(tally + 2usize) };
    let panicked = unsafe { *(tally + 3usize) };
    check(panicked == 0i64);
    print("OK cancel_tree_groups ");
    print_int(completed);
    print(" ");
    print_int(sum);
    print(" ");
    print_int(cancelled);
    print(" ");
    print_int(a);
    print("\n");
    0
}
