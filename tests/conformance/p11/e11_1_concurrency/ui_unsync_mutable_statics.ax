// test: ui
// Covers: AXS-CONC-004, AXS-CONC-034, AXS-CONC-037
// Covers: ACONC-20, ACONCUR-177, ACONCUR-178
// Covers: REQ-CONC-018, REQ-CONC-086, REQ-CONC-089, REQ-CONC-160, REQ-CONC-164, REQ-CONC-193
// E11.1 negative UI conformance: process-global immutable `static` items with
// `!Share` types (`Cell`, `RefCell`, explicit `!Share`) rejected with
// `AX_CONC_UNSYNC_STATIC`; `@thread_local` static permitted without `Share`;
// reading or writing `static mut` in safe code rejected with `AX_CONC_UNSYNC_STATIC`;
// re-wrapping `static mut` into concurrent `mut_view`s inside `unsafe` rejected
// with `AX_CONC_SHARED_MUT`.

module test_ui_unsync_mutable_statics

struct Cell {
    pub val: i32,
}

struct RefCell {
    pub val: i32,
}

struct UnsyncGlobalState {
    pub code: i32,
}

impl !Share for UnsyncGlobalState {}

// 1. Process-global immutable statics must satisfy `T: Share` (AXS-CONC-004, AXS-CONC-034).
static BAD_STATIC_CELL: Cell = Cell { val: 10 }; //~ ERROR AX_CONC_UNSYNC_STATIC
static BAD_STATIC_REFCELL: RefCell = RefCell { val: 20 }; //~ ERROR AX_CONC_UNSYNC_STATIC
static BAD_STATIC_UNSYNC: UnsyncGlobalState = UnsyncGlobalState { code: 30 }; //~ ERROR AX_CONC_UNSYNC_STATIC

// 2. `@thread_local` statics are per-OS-thread and do NOT require `Share` (AXS-CONC-004, AXS-CONC-034).
@thread_local
static OK_TLS_CELL: Cell = Cell { val: 99 };

// 3. Process-global immutable static of `Share` type is valid.
static OK_IMMUT_LIMIT: i32 = 1024;

// 4. Mutable global static requires `unsafe` for every read or write (AXS-CONC-034, ACONCUR-177).
static mut GLOBAL_COUNTER: i32 = 0;

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    left() + right()
}

pub fn reject_safe_access_to_static_mut() -> i32 {
    let a: i32 = GLOBAL_COUNTER; //~ ERROR AX_CONC_UNSYNC_STATIC
    GLOBAL_COUNTER = a + 1; //~ ERROR AX_CONC_UNSYNC_STATIC
    OK_IMMUT_LIMIT + OK_TLS_CELL.val
}

pub fn reject_unsafe_concurrent_mut_view_on_static_mut() -> i32 {
    let p: *mut i32 = unsafe { address_of_mut(GLOBAL_COUNTER) };
    let mv1: mut_view<i32> = unsafe { mut_view(*p) };
    let mv2: mut_view<i32> = unsafe { mut_view(*p) };
    // Re-establishing concurrent mut_views to `static mut` inside `unsafe` triggers race check (AXS-CONC-037).
    par_join(
        || -> i32 { *mv1 = 1; *mv1 },
        || -> i32 { *mv2 = 2; *mv2 } //~ ERROR AX_CONC_SHARED_MUT
    )
}

pub fn main() {}
