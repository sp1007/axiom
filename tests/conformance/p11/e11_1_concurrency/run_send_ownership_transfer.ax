// test: run
// modes: interp native
// stdout: 735\n
// Covers: AXS-CONC-001, AXS-CONC-002, AXS-CONC-003, AXS-CONC-005, AXS-CONC-006, AXS-CONC-007
// Covers: AXS-CONC-010, AXS-CONC-011, AXS-CONC-014, AXS-CONC-016, AXS-CONC-017, AXS-CONC-018
// Covers: AXS-CONC-020, AXS-CONC-021, AXS-CONC-022, AXS-CONC-024, AXS-CONC-025
// Covers: ACONC-21, ACONC-24, ACONC-28, ACONCUR-141, ACONCUR-179
// Covers: REQ-CONC-016, REQ-CONC-085, REQ-CONC-159, REQ-CONC-197
// E11.1 positive runtime conformance: Send ownership transfer across `spawn`,
// Copy capture retention in parent, uncaptured !Send locals in enclosing scope,
// Send + !Share transfer, !Send local task execution via `spawn_local`,
// and cooperative cancellation vs panic lifecycle state separation.

module test_run_send_ownership_transfer

struct OwnedPacket {
    pub id: i32,
    pub payload: i32,
}

@derive(Copy)
struct CopyConfig {
    pub scale: i32,
    pub offset: i32,
}

struct Rc {
    pub count: i32,
}

impl !Send for Rc {}

struct ExclusiveHandle {
    pub fd: i32,
}

// Send + !Share: may be moved across threads via `spawn`, but never shared by view.
impl !Share for ExclusiveHandle {}

struct LocalOnlyTask {
    pub slot: i32,
}

// !Send: pinned to the current thread, valid in `spawn_local`.
impl !Send for LocalOnlyTask {}

struct CustomSyncBox<T> {
    pub inner: T,
}

unsafe impl<T: Send> Send for CustomSyncBox<T> {}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

fn spawn_local<F: FnOnce>(f: F) -> i32 {
    f()
}

fn run_send_share<F: FnOnce + Send + Share>(f: F) -> i32 {
    f()
}

fn test_owned_move_and_copy_in_spawn() -> i32 {
    let mut pkt = OwnedPacket { id: 10, payload: 32 };
    let cfg = CopyConfig { scale: 2, offset: 5 };

    // Uncaptured !Send locals (*mut i32 and Rc) in enclosing scope do NOT taint the closure (AXS-CONC-021).
    let _uncaptured_ptr: *mut i32 = 0 as *mut i32;
    let _uncaptured_rc = Rc { count: 1 };

    // `pkt` moves into `spawn`; `cfg` is Copy and remains usable in parent (AXS-CONC-022).
    let r1 = spawn(|| -> i32 {
        (pkt.id + pkt.payload) * cfg.scale + cfg.offset
    });

    let parent_cfg_check = run_send_share(|| -> i32 {
        cfg.scale + cfg.offset
    });

    // Re-initializing `pkt` allows moving the new value into a second `spawn`.
    pkt = OwnedPacket { id: 3, payload: 4 };
    let boxed = CustomSyncBox<OwnedPacket> { inner: pkt };
    let r2 = spawn(|| -> i32 {
        boxed.inner.id * 10 + boxed.inner.payload
    });

    r1 + parent_cfg_check + r2
}

fn test_send_not_share_and_spawn_local() -> i32 {
    // Send + !Share type can be captured by move into `spawn` (AXS-CONC-020, AXS-CONC-024).
    let h_in = ExclusiveHandle { fd: 25 };
    let h_out_fd = spawn(|| -> i32 {
        h_in.fd + 15
    });

    // !Send type can be captured by move in thread-local `spawn_local` (AXS-CONC-025).
    let local_task = LocalOnlyTask { slot: 60 };
    let local_res = spawn_local(|| -> i32 {
        local_task.slot + 5
    });

    h_out_fd + local_res
}

// Task lifecycle states per AXS-CONC-005, AXS-CONC-006, AXS-CONC-007, ACONCUR-179:
// 1 = Spawned, 2 = Running, 3 = Completed, 4 = Cancelled, 5 = Panicked.
struct TaskOutcome {
    pub final_state: i32,
    pub cleaned_bytes: i32,
    pub result_val: i32,
}

fn run_task_with_cancel_checkpoint(cancel_requested: bool, owned_bytes: i32, work_val: i32) -> TaskOutcome {
    let mut state: i32 = 1; // Spawned
    state = 2; // Running
    if cancel_requested {
        // Cooperative cancellation at explicit checkpoint: transitions to Cancelled (4),
        // distinct from Panicked (5), and deterministically releases owned resources.
        state = 4;
        return TaskOutcome {
            final_state: state,
            cleaned_bytes: owned_bytes,
            result_val: 0,
        };
    }
    state = 3; // Completed
    TaskOutcome {
        final_state: state,
        cleaned_bytes: owned_bytes,
        result_val: work_val,
    }
}

fn test_cancel_vs_panic_and_cleanup() -> i32 {
    let t_cancelled_score = spawn(|| -> i32 {
        let out = run_task_with_cancel_checkpoint(true, 64, 999);
        out.final_state * 100 + out.cleaned_bytes
    });
    let t_completed_score = spawn(|| -> i32 {
        let out = run_task_with_cancel_checkpoint(false, 0, 36);
        out.result_val
    });
    t_cancelled_score + t_completed_score
}

pub fn main() -> i32 {
    let a = test_owned_move_and_copy_in_spawn();
    let b = test_send_not_share_and_spawn_local();
    let c = test_cancel_vs_panic_and_cleanup();
    print_int(a + b + c);
    print("\n");
    0
}
