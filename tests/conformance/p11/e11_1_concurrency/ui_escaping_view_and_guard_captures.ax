// test: ui
// Covers: AXS-CONC-023, AXS-CONC-025, AXS-CONC-026
// Covers: ACONC-29, ACONCUR-174
// Covers: REQ-CONC-192, REQ-CONC-197
// E11.1 negative UI conformance: non-static `view<T>`, `mut_view<T>`, and implicit
// mutable stack borrows rejected in `spawn`, `spawn_local`, and returned views
// (`AX_CONC_ESCAPING_VIEW`).

module test_ui_escaping_view_and_guard_captures

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

fn spawn_local<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn reject_escaping_views_in_spawn() {
    let stack_val: i32 = 100;
    let v: view<i32> = view(stack_val);

    // 1. Capturing non-static view<T> into unscoped `spawn` is prohibited (AXS-CONC-023).
    let _a = spawn(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *v
    });

    // 2. Capturing non-static mut_view<T> into unscoped `spawn` is prohibited (AXS-CONC-023).
    let mut slot: i32 = 200;
    let mv: mut_view<i32> = mut_view(slot);
    let _b = spawn(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *mv
    });

    // 3. Implicit mutable borrow of outer stack binding in `spawn` is prohibited (AXS-CONC-023).
    let mut counter: i32 = 0;
    let _c = spawn(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        counter = counter + 1;
        counter
    });

    // 4. `spawn_local` relaxes `Send`, NOT view lifetime bounds (AXS-CONC-023, AXS-CONC-025).
    let local_val: i32 = 300;
    let lv: view<i32> = view(local_val);
    let _d = spawn_local(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *lv
    });

    let mut local_mut: i32 = 400;
    let lmv: mut_view<i32> = mut_view(local_mut);
    let _e = spawn_local(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *lmv
    });

    // 5. Spawned closure returning a non-static view<i32> is prohibited (ACONC-29).
    let _f = spawn(|| -> view<i32> { //~ ERROR AX_CONC_ESCAPING_VIEW
        let inner: i32 = 77;
        view(inner)
    });
}

pub fn main() {}
