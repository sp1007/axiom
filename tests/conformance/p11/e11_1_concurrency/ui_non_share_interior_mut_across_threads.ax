// test: ui
// Covers: AXS-CONC-012, AXS-CONC-015, AXS-CONC-016, AXS-CONC-031
// Covers: ACONC-22, ACONC-23, ACONCUR-142, ACONCUR-143, ACONCUR-144
// Covers: REQ-CONC-086, REQ-CONC-160, REQ-CONC-162
// E11.1 negative UI conformance: !Share interior-mutable types (Cell, RefCell,
// UnsafeCell, CellBox), Rc, ThreadLocal, raw-pointer wrappers, Arc<Cell>, and
// explicit !Share types rejected when shared via `view<T>` across threads.

module test_ui_non_share_interior_mut_across_threads

struct Cell {
    pub val: i32,
}

struct RefCell {
    pub val: i32,
    pub borrow_flag: i32,
}

struct UnsafeCell {
    pub val: i32,
}

struct CellBox {
    pub slot: i32,
}

struct Rc {
    pub strong: i32,
}

struct ThreadLocal {
    pub key: i32,
}

struct RawCache {
    pub ptr: *mut i32,
}

struct Arc<T> {
    pub inner: T,
}

struct UnsyncedCounter {
    pub count: i32,
}

impl !Share for UnsyncedCounter {}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    left() + right()
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

fn share_view<T>(_v: view<T>) -> i32 {
    0
}

pub fn reject_interior_mut_views_in_par_join() {
    let c = Cell { val: 1 };
    let rc_cell = RefCell { val: 2, borrow_flag: 0 };
    let uc = UnsafeCell { val: 3 };
    let cb = CellBox { slot: 4 };

    let vc = view(c);
    let vrc = view(rc_cell);
    let vuc = view(uc);
    let vcb = view(cb);

    // 1. Cell view captured across par_join branches (AXS-CONC-015, AXS-CONC-031).
    let _a = par_join(
        || -> i32 { let _ = *vc; 1 }, //~ ERROR AX_CONC_VIEW_NOT_SHARE
        || -> i32 { let _ = *vc; 2 } //~ ERROR AX_CONC_VIEW_NOT_SHARE
    );

    // 2. RefCell and UnsafeCell views captured across par_join branches.
    let _b = par_join(
        || -> i32 { let _ = *vrc; 1 }, //~ ERROR AX_CONC_VIEW_NOT_SHARE
        || -> i32 { let _ = *vuc; 2 } //~ ERROR AX_CONC_VIEW_NOT_SHARE
    );

    // 3. CellBox view captured in spawn_scoped.
    let _d = spawn_scoped(|| -> i32 {
        let _ = *vcb; //~ ERROR AX_CONC_VIEW_NOT_SHARE
        1
    });
}

pub fn reject_rc_view_in_spawn_scoped() {
    // 4. Rc view cannot cross spawn_scoped (AXS-CONC-015).
    let rc = Rc { strong: 1 };
    let v_rc = view(rc);
    let _a = spawn_scoped(|| -> i32 {
        let _ = *v_rc; //~ ERROR AX_CONC_VIEW_NOT_SHARE
        1
    });
}

pub fn reject_thread_local_view_in_share_view() {
    // 5. ThreadLocal view cannot cross share_view (AXS-CONC-015).
    let tl = ThreadLocal { key: 2 };
    let _b = share_view(view(tl)); //~ ERROR AX_CONC_VIEW_NOT_SHARE
}

pub fn reject_raw_cache_view_in_share_view() {
    // 6. Struct containing raw pointer (*mut i32) is !Share (AXS-CONC-014, AXS-CONC-015).
    let raw = RawCache { ptr: 0 as *mut i32 };
    let _c = share_view(view(raw)); //~ ERROR AX_CONC_VIEW_NOT_SHARE
}

pub fn reject_arc_cell_view_in_spawn_scoped() {
    // 7. Arc<Cell> is !Share because Cell: !Share (AXS-CONC-016).
    let arc_cell = Arc { inner: Cell { val: 5 } };
    let v_arc_cell = view(arc_cell);
    let _d = spawn_scoped(|| -> i32 {
        let _ = (*v_arc_cell).inner; //~ ERROR AX_CONC_VIEW_NOT_SHARE
        1
    });
}

pub fn reject_explicit_not_share_in_share_view() {
    // 8. Explicit `impl !Share` type rejected across share_view.
    let unsync = UnsyncedCounter { count: 9 };
    let _e = share_view(view(unsync)); //~ ERROR AX_CONC_VIEW_NOT_SHARE
}

pub fn main() {}
