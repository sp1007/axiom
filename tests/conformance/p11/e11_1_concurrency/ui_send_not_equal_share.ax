// test: ui
// Covers: AXS-CONC-010, AXS-CONC-011, AXS-CONC-012, AXS-CONC-013, AXS-CONC-014, AXS-CONC-015, AXS-CONC-016, AXS-CONC-017, AXS-CONC-018
// Covers: ACONC-21, ACONC-22, ACONC-23, ACONCUR-140, ACONCUR-141, ACONCUR-142, ACONCUR-143, ACONCUR-144, ACONCUR-145, ACONCUR-146
// Covers: REQ-CONC-085, REQ-CONC-086, REQ-CONC-087, REQ-CONC-158, REQ-CONC-159, REQ-CONC-160, REQ-CONC-161, REQ-CONC-162, REQ-CONC-163
// E11.1 negative UI conformance: Send != Share orthogonality, view/mut_view rules,
// sync wrapper trait bounds, structural derivation, generic boundary checks,
// and unsafe-only positive impls.

module test_ui_send_not_equal_share

struct OwnedHandle {
    pub fd: i32,
}

// Negative !Share impl is safe: OwnedHandle is Send + !Share.
impl !Share for OwnedHandle {}

struct ThreadPinned {
    pub slot: i32,
}

// Negative !Send impl is safe; positive Share impl requires unsafe: ThreadPinned is !Send + Share.
impl !Send for ThreadPinned {}
unsafe impl Share for ThreadPinned {}

struct Arc<T> {
    pub ptr: *mut T,
}

unsafe impl<T: Send + Share> Send for Arc<T> {}
unsafe impl<T: Send + Share> Share for Arc<T> {}

struct Mutex<T> {
    pub ptr: *mut T,
}

unsafe impl<T: Send> Send for Mutex<T> {}
unsafe impl<T: Send> Share for Mutex<T> {}

struct RwLock<T> {
    pub ptr: *mut T,
}

unsafe impl<T: Send> Send for RwLock<T> {}
unsafe impl<T: Send + Share> Share for RwLock<T> {}

struct Envelope {
    pub tag: i32,
    pub handle: OwnedHandle,
}

enum TaskMsg {
    Ready(i32),
    Pinned(ThreadPinned),
}

struct SafeAttempt {
    pub ptr: *mut i32,
}

// Positive Send/Share impls without `unsafe` are compile errors (AXS-CONC-017, ACONCUR-146).
impl Send for SafeAttempt {} //~ ERROR AX_CONC_SAFE_SEND_SHARE_IMPL
impl Share for SafeAttempt {} //~ ERROR AX_CONC_SAFE_SEND_SHARE_IMPL

struct ConflictMarker {
    pub v: i32,
}

unsafe impl Send for ConflictMarker {}
impl !Send for ConflictMarker {} //~ ERROR AX_TRAIT_OVERLAP

fn require_send<T: Send>(_val: T) {}
fn require_share<T: Share>(_val: T) {}

// Generic functions never assume Send or Share without explicit bounds (AXS-CONC-018).
fn generic_unconstrained<T>(val: T) {
    require_send(val); //~ ERROR AX_CONC_NOT_SEND
}

fn generic_send_is_not_share<T: Send>(val: T) {
    require_share(val); //~ ERROR AX_CONC_NOT_SHARE
}

fn test_orthogonality_and_views(
    v_handle: view<OwnedHandle>,
    mv_int: mut_view<i32>,
    mv_pinned: mut_view<ThreadPinned>,
) {
    // 1. Send + !Share satisfies Send, fails Share.
    require_send(OwnedHandle { fd: 3 });
    require_share(OwnedHandle { fd: 3 }); //~ ERROR AX_CONC_NOT_SHARE

    // 2. !Send + Share satisfies Share, fails Send.
    require_share(ThreadPinned { slot: 1 });
    require_send(ThreadPinned { slot: 1 }); //~ ERROR AX_CONC_NOT_SEND

    // 3. view<T> is Send iff T: Share, and Share iff T: Share (AXS-CONC-013).
    require_send(v_handle); //~ ERROR AX_CONC_NOT_SEND
    require_share(v_handle); //~ ERROR AX_CONC_NOT_SHARE

    // 4. mut_view<T> is Send iff T: Send, and NEVER Share (AXS-CONC-013).
    require_share(mv_int); //~ ERROR AX_CONC_NOT_SHARE
    require_send(mv_pinned); //~ ERROR AX_CONC_NOT_SEND
}

fn test_wrappers_and_aggregates() {
    // 5. Arc<T> requires T: Send + Share for both Send and Share (AXS-CONC-016).
    require_send(Arc<OwnedHandle> { ptr: 0 as *mut OwnedHandle }); //~ ERROR AX_CONC_NOT_SEND
    require_share(Arc<OwnedHandle> { ptr: 0 as *mut OwnedHandle }); //~ ERROR AX_CONC_NOT_SHARE

    // 6. RwLock<T> requires T: Send + Share for Share, and T: Send for Send (AXS-CONC-016).
    require_send(RwLock<OwnedHandle> { ptr: 0 as *mut OwnedHandle });
    require_share(RwLock<OwnedHandle> { ptr: 0 as *mut OwnedHandle }); //~ ERROR AX_CONC_NOT_SHARE

    // 7. Mutex<T> requires T: Send for both Send and Share (AXS-CONC-016).
    require_send(Mutex<ThreadPinned> { ptr: 0 as *mut ThreadPinned }); //~ ERROR AX_CONC_NOT_SEND
    require_share(Mutex<ThreadPinned> { ptr: 0 as *mut ThreadPinned }); //~ ERROR AX_CONC_NOT_SHARE

    // 8. Structural propagation through structs, enums, tuples, and fixed-size arrays (AXS-CONC-014).
    require_share(Envelope { tag: 10, handle: OwnedHandle { fd: 6 } }); //~ ERROR AX_CONC_NOT_SHARE
    require_send(TaskMsg.Pinned(ThreadPinned { slot: 7 })); //~ ERROR AX_CONC_NOT_SEND
    let tup: (i32, OwnedHandle) = (1, OwnedHandle { fd: 8 });
    require_share(tup); //~ ERROR AX_CONC_NOT_SHARE
    let arr: [2]ThreadPinned = [ThreadPinned { slot: 1 }, ThreadPinned { slot: 2 }];
    require_send(arr); //~ ERROR AX_CONC_NOT_SEND
}

pub fn main() {}
