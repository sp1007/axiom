// test: ui
// Covers: AXS-CONC-035, AXS-CONC-036
// Covers: ACONC-26, ACONC-27, ACONCUR-163, ACONCUR-164, ACONCUR-165, ACONCUR-175
// Covers: REQ-CONC-181, REQ-CONC-182, REQ-CONC-183
// E11.1 negative UI conformance: lock guards (`MutexGuard`, `RwLockReadGuard`,
// `RwLockWriteGuard`) and guard-derived views rejected when escaping function return,
// inner lexical block scope, or concurrency boundaries (`AX_CONC_GUARD_ESCAPE`);
// unsynchronized `mut_view` into `AtomicI32` rejected (`AX_CONC_ATOMIC_MUT_VIEW`).

module test_ui_lock_guard_escape

struct MutexGuard {
    pub data: i32,
}

struct RwLockReadGuard {
    pub data: i32,
}

struct RwLockWriteGuard {
    pub data: i32,
}

struct AtomicI32 {
    pub v: i32,
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    left() + right()
}

pub fn reject_return_mutex_guard() -> MutexGuard {
    let g = MutexGuard { data: 11 };
    // 1. Returning a MutexGuard directly from a function is rejected (AXS-CONC-035).
    return g; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn reject_return_rwlock_read_guard() -> RwLockReadGuard {
    let rg = RwLockReadGuard { data: 22 };
    // 2. Returning an RwLockReadGuard from a function is rejected (AXS-CONC-035).
    return rg; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn reject_guard_derived_view_escaping_inner_block() {
    let mut base: i32 = 0;
    let mut escaped: view<i32> = view(base);
    {
        let g = MutexGuard { data: 55 };
        // 3. Guard-derived view cannot outlive the inner lexical block where `g` is dropped (AXS-CONC-035).
        escaped = view(g.data); //~ ERROR AX_CONC_GUARD_ESCAPE
    }
    let _ = *escaped;
}

pub fn reject_guards_across_concurrency_boundaries() {
    let g = MutexGuard { data: 88 };
    let vg = view(g.data);
    let wg = RwLockWriteGuard { data: 99 };
    let vwg = view(wg.data);

    // 4. Lock guards and guard-derived views cannot escape across spawn_scoped or par_join (AXS-CONC-035).
    let _a = spawn_scoped(|| -> i32 {
        *vg //~ ERROR AX_CONC_GUARD_ESCAPE
    });

    let _b = par_join(
        || -> i32 { *vwg }, //~ ERROR AX_CONC_GUARD_ESCAPE
        || -> i32 { 1 }
    );
}

pub fn reject_atomic_interior_mut_view() {
    let mut atom = AtomicI32 { v: 1 };
    // 5. Taking an unsynchronized `mut_view` into an `AtomicI32` interior field (AXS-CONC-036, ACONCUR-175):
    let m_inner = mut_view(atom.v); //~ ERROR AX_CONC_ATOMIC_MUT_VIEW
    *m_inner = 2;

    // 6. Mixing `mut_view<AtomicI32>` with concurrent shared access across par_join:
    let mut atom2 = AtomicI32 { v: 10 };
    let ma = mut_view(atom2);
    let va = view(atom2);
    let _c = par_join(
        || -> i32 { (*ma).v = 20; 0 }, //~ ERROR AX_CONC_ATOMIC_MUT_VIEW
        || -> i32 { (*va).v }
    );
}

pub fn main() {}
