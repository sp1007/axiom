// test: ui
// Covers: AXS-CONC-036, AXS-CONC-040, AXS-CONC-041, AXS-CONC-042, AXS-CONC-043, AXS-CONC-044
// Covers: ACONCUR-175, ACONCUR-184, ACONCUR-185, ACONCUR-186, ACONCUR-187, ACONCUR-188, ACONCUR-189, ACONCUR-192, ACONCUR-193, ACONCUR-194
// Covers: REQ-CONC-176, REQ-CONC-183, REQ-CONC-202, REQ-CONC-203, REQ-CONC-204, REQ-CONC-205, REQ-CONC-206, REQ-CONC-207
// E11.1 negative UI conformance: atomic type restrictions (`AX_CONC_INVALID_ATOMIC_TYPE`),
// natural alignment requirements (`AX_CONC_INVALID_ATOMIC_ALIGNMENT`), non-atomic
// `mut_view` / private backing field access (`AX_CONC_ATOMIC_MUT_VIEW`), and invalid
// memory orderings (`AX_CONC_INVALID_ATOMIC_ORDERING`).

struct NonAtomicStruct {
    a: i32,
    b: i32,
}

@repr(packed)
struct PackedAtomicHolder {
    tag: u8,
    slot: AtomicU64, //~ ERROR AX_CONC_INVALID_ATOMIC_ALIGNMENT
}

@align(2)
struct UnderAlignedAtomicHolder {
    slot: AtomicU64, //~ ERROR AX_CONC_INVALID_ATOMIC_ALIGNMENT
}

fn reject_invalid_atomic_types(
    _s: Atomic<NonAtomicStruct>, //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    _t: Atomic<(i32, i32)>, //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    _u: Atomic<u128>, //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    b: view<AtomicBool>,
    p: view<Atomic<*mut i32>>,
    raw: *mut i32,
) {
    let _ = b.fetch_add(true, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    let _ = p.fetch_add(raw, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    let _ = is_lock_free<u128>(); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
}

fn reject_atomic_mut_view_and_orderings(a: view<AtomicI32>, dyn_ord: Ordering) {
    let mut local_atom = AtomicI32.new(0i32);
    let _mv = mut_view(local_atom); //~ ERROR AX_CONC_ATOMIC_MUT_VIEW
    let _priv = a.v; //~ ERROR AX_CONC_ATOMIC_MUT_VIEW

    let _ = a.load(Ordering.Release); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.load(Ordering.AcqRel); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    a.store(1i32, Ordering.Acquire); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    a.store(1i32, Ordering.AcqRel); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange(0i32, 1i32, Ordering.Release, Ordering.Acquire); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange(0i32, 1i32, Ordering.Acquire, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange_weak(0i32, 1i32, Ordering.Relaxed, Ordering.Release); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    fence(Ordering.Relaxed); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    compiler_fence(Ordering.Relaxed); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.load(dyn_ord); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
}

fn main() {}
