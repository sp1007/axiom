// test: helper
// Covers: AXS-CONC-019, AXS-CONC-041, AXS-CONC-044, AXS-CONC-045
// Covers: ACONC-27, ACONC-76, ACONCUR-190, ACONCUR-191, ACONCUR-195
// Covers: REQ-CONC-087, REQ-CONC-161, REQ-CONC-176, REQ-CONC-202, REQ-CONC-203, REQ-CONC-204, REQ-CONC-205, REQ-CONC-206, REQ-CONC-207
// E11.1 MIR/OptIR (-O1) conformance: zero-cost Send/Share marker erasure (zero
// witness parameters or vtables) and happens-before barrier preservation across
// Release/Acquire atomic operations, RMW, cmpxchg, fence, and compiler_fence at -O1.

struct Message {
    pub tag: i32,
    pub payload: i32,
}

fn erase_send_bound<T: Send>(val: T) -> T {
    val
}

fn erase_share_bound<T: Share>(_v: view<T>) -> i32 {
    1i32
}

fn preserve_happens_before_barriers_o1(flag: view<AtomicI32>, slot: mut_view<i32>) -> i32 {
    let local_folded = 40i32 + 2i32;

    *slot = 100i32;
    flag.store(1i32, Ordering.Release);

    let _pre_barrier_read = *slot;
    fence(Ordering.Acquire);

    let prev = flag.fetch_add(1i32, Ordering.AcqRel);
    let _cas = flag.compare_exchange(prev + 1i32, 99i32, Ordering.AcqRel, Ordering.Acquire);
    spin_loop_hint();

    let observed_flag = flag.load(Ordering.Acquire);
    compiler_fence(Ordering.SeqCst);
    let post_barrier_read = *slot;

    local_folded + observed_flag + post_barrier_read
}

fn main() {
    let m = Message { tag: 7i32, payload: 35i32 };
    let m2 = erase_send_bound<Message>(m);
    let _ok = erase_share_bound<Message>(view(m2));
    let flag = AtomicI32.new(0i32);
    let mut payload: i32 = 0i32;
    let _ = preserve_happens_before_barriers_o1(view(flag), mut_view(payload));
}
