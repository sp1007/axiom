// test: run
// modes: interp native
// stdout: 240\n
// Covers: AXS-CONC-008, AXS-CONC-010, AXS-CONC-012, AXS-CONC-013, AXS-CONC-014, AXS-CONC-016
// Covers: AXS-CONC-026, AXS-CONC-031, AXS-CONC-034, AXS-CONC-035
// Covers: ACONC-22, ACONC-23, ACONC-30, ACONCUR-140, ACONCUR-142, ACONCUR-143, ACONCUR-144, ACONCUR-145, ACONCUR-149, ACONCUR-163, ACONCUR-164
// Covers: REQ-CONC-018, REQ-CONC-086, REQ-CONC-087, REQ-CONC-089, REQ-CONC-094, REQ-CONC-158, REQ-CONC-160, REQ-CONC-161, REQ-CONC-162, REQ-CONC-163, REQ-CONC-181, REQ-CONC-182
// E11.1 positive runtime conformance: concurrent read-only `view<T>` (`READ/READ`)
// across `par_join` and sibling `spawn_scoped` tasks, structural `Share` derivation,
// sync wrapper marker rules (`Mutex<T>: Share` when `T: Send`, `RwLock<T>: Share`
// when `T: Send + Share`, `Arc<T>: Send + Share` when `T: Send + Share`), and
// non-escaping lexical lock guard scopes.

module test_run_share_concurrent_read_views

struct Point3D {
    pub x: i32,
    pub y: i32,
    pub z: i32,
}

struct OwnedToken {
    pub secret: i32,
}

// Send + !Share: Mutex<OwnedToken> is still Send + Share because Mutex serializes access (AXS-CONC-016).
impl !Share for OwnedToken {}

struct Arc<T> {
    pub inner: T,
}

unsafe impl<T: Send + Share> Send for Arc<T> {}
unsafe impl<T: Send + Share> Share for Arc<T> {}

struct Mutex<T> {
    pub inner: T,
}

unsafe impl<T: Send> Send for Mutex<T> {}
unsafe impl<T: Send> Share for Mutex<T> {}

struct RwLock<T> {
    pub inner: T,
}

unsafe impl<T: Send> Send for RwLock<T> {}
unsafe impl<T: Send + Share> Share for RwLock<T> {}

struct MutexGuard {
    pub data: i32,
}

struct RwLockReadGuard {
    pub data: i32,
}

fn require_send<T: Send>(_val: T) {}
fn require_share<T: Share>(_val: T) {}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    left() + right()
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

fn read_under_mutex(m: view<Mutex<OwnedToken>>) -> i32 {
    let g = MutexGuard { data: (*m).inner.secret };
    let vg = view(g.data);
    let val: i32 = (*vg) + 0;
    val
}

fn read_under_rwlock(rw: view<RwLock<Point3D>>) -> i32 {
    let rg = RwLockReadGuard { data: (*rw).inner.x + (*rw).inner.y + (*rw).inner.z };
    let vrg = view(rg.data);
    let val: i32 = (*vrg) + 0;
    val
}

fn test_concurrent_read_views() -> i32 {
    let pt = Point3D { x: 10, y: 20, z: 30 };
    let vp: view<Point3D> = view(pt);

    // view<T> is both Send and Share when T: Share (AXS-CONC-013).
    require_send(vp);
    require_share(vp);

    // READ/READ on the same `view<Point3D>` across par_join branches is race-free (AXS-CONC-031, ACONCUR-149).
    let join_sum = par_join(
        || -> i32 { (*vp).x + (*vp).y },
        || -> i32 { (*vp).y + (*vp).z }
    );

    // Sibling `spawn_scoped` tasks sharing `view<Point3D>` and `view<[i32]>` concurrently (AXS-CONC-026, AXS-CONC-031).
    let arr: [4]i32 = [2, 4, 6, 8];
    let v_arr: view<[i32]> = view(arr);
    let s1 = spawn_scoped(|| -> i32 {
        (*vp).x + v_arr[0] + v_arr[1]
    });
    let s2 = spawn_scoped(|| -> i32 {
        (*vp).z + v_arr[2] + v_arr[3]
    });

    join_sum + s1 + s2
}

fn test_sync_wrappers_and_scoped_guards() -> i32 {
    // Arc<T> is Send + Share when T: Send + Share.
    require_send(Arc<Point3D> { inner: Point3D { x: 1, y: 2, z: 3 } });
    require_share(Arc<Point3D> { inner: Point3D { x: 1, y: 2, z: 3 } });

    // Mutex<T> is Send + Share when T: Send (even though OwnedToken: !Share) (AXS-CONC-016).
    let m = Mutex<OwnedToken> { inner: OwnedToken { secret: 45 } };
    require_send(Mutex<OwnedToken> { inner: OwnedToken { secret: 1 } });
    require_share(Mutex<OwnedToken> { inner: OwnedToken { secret: 2 } });

    // RwLock<T> is Send + Share when T: Send + Share.
    let rw = RwLock<Point3D> { inner: Point3D { x: 15, y: 20, z: 20 } };
    require_send(RwLock<Point3D> { inner: Point3D { x: 1, y: 2, z: 3 } });
    require_share(RwLock<Point3D> { inner: Point3D { x: 1, y: 2, z: 3 } });

    // AtomicI32 is unconditionally Send + Share.
    let atom = AtomicI32.new(7i32);
    require_send(atom);
    require_share(AtomicI32.new(8i32));

    // Lexical lock guard usage within helper scope without escaping (AXS-CONC-035, ACONCUR-165).
    let from_mutex = read_under_mutex(view(m));
    let from_rwlock = read_under_rwlock(view(rw));

    from_mutex + from_rwlock
}

pub fn main() -> i32 {
    let a = test_concurrent_read_views();
    let b = test_sync_wrappers_and_scoped_guards();
    print_int(a + b);
    print("\n");
    0
}
