// test: ui
// Covers: AXS-CONC-015, AXS-CONC-020, AXS-CONC-021, AXS-CONC-024, AXS-CONC-038
// Covers: ACONC-20, ACONC-21, ACONC-24, ACONCUR-141, ACONCUR-143
// Covers: REQ-CONC-016, REQ-CONC-085, REQ-CONC-159, REQ-CONC-197
// E11.1 negative UI conformance: !Send raw pointers, FFI opaque handles, Rc/LocalRc,
// and explicit !Send types rejected across `spawn` captures and return values.

module test_ui_non_send_across_spawn

struct NonSendToken {
    pub id: i32,
}

impl !Send for NonSendToken {}

struct Rc {
    pub count: i32,
}

impl !Send for Rc {}
impl !Share for Rc {}

struct LocalRc {
    pub count: i32,
}

impl !Send for LocalRc {}
impl !Share for LocalRc {}

// FFI opaque handle wrapping a raw pointer is !Send and !Share by default (AXS-CONC-015, AXS-CONC-038).
struct FfiDeviceHandle {
    pub raw_handle: *mut u8,
}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

pub fn reject_non_send_captures(raw_mut: *mut i32, raw_const: *const u8) {
    // 1. Capturing *mut T across spawn is rejected (AXS-CONC-015, AXS-CONC-020, AXS-CONC-021).
    let _a = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _p = raw_mut;
        0
    });

    // 2. Capturing *const T across spawn is rejected (AXS-CONC-015, AXS-CONC-020).
    let _b = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _p = raw_const;
        0
    });

    // 3. Capturing explicit !Send type across spawn is rejected.
    let tok = NonSendToken { id: 7 };
    let _c = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        tok.id
    });

    // 4. Capturing non-atomic reference-counted Rc and LocalRc across spawn is rejected (AXS-CONC-015).
    let rc = Rc { count: 1 };
    let _d = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        rc.count
    });

    let lrc = LocalRc { count: 2 };
    let _e = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        lrc.count
    });

    // 5. Capturing FFI opaque handle containing raw pointer across spawn is rejected (AXS-CONC-038).
    let ffi_dev = FfiDeviceHandle { raw_handle: 0 as *mut u8 };
    let _f = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _h = ffi_dev.raw_handle;
        0
    });

    // 6. Returning a !Send result R across spawn JoinHandle is rejected (AXS-CONC-020, AXS-CONC-024).
    let _g = spawn(|| -> NonSendToken { //~ ERROR AX_CONC_NOT_SEND
        NonSendToken { id: 42 }
    });
}

pub fn main() {}
