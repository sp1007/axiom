// test: run
// modes: interp native
// stdout: 323\n
// Covers: AXS-CONC-040, AXS-CONC-041, AXS-CONC-042, AXS-CONC-043, AXS-CONC-044, AXS-CONC-045, AXS-CONC-046, AXS-CONC-047
// Covers: AXS-CONC-050, AXS-CONC-051, AXS-CONC-052
// Covers: ACONC-25, ACONC-26, ACONC-27, ACONC-76, ACONCUR-158, ACONCUR-184, ACONCUR-185, ACONCUR-186, ACONCUR-187, ACONCUR-188, ACONCUR-189, ACONCUR-190, ACONCUR-191, ACONCUR-192, ACONCUR-193, ACONCUR-194, ACONCUR-195, ACONCUR-196
// Covers: REQ-CONC-176, REQ-CONC-202, REQ-CONC-203, REQ-CONC-204, REQ-CONC-205, REQ-CONC-206, REQ-CONC-207
// E11.1 positive runtime conformance: happens-before ordering via Release/Acquire
// atomics, fence/compiler_fence barriers, notification vs publication distinction,
// explicit host-device GPU barrier synchronization, cross-process explicit byte
// serialization, and @repr(C) shared-memory contracts.

@repr(C)
struct ShmSegmentHeader {
    pub seq_lock: i32,
    pub payload_val: i32,
}

fn forward_send_share<T: Send + Share>(x: T) -> T {
    x
}

fn test_release_acquire_publication_and_fences() -> i32 {
    let mut payload: i32 = 0i32;
    let ready = AtomicI32.new(0i32);
    let vr = view(ready);
    let mp = mut_view(payload);

    // Producer side: write non-atomic payload, then Release fence + Release store (AXS-CONC-045).
    *mp = 75i32;
    fence(Ordering.Release);
    vr.store(1i32, Ordering.Release);

    // Consumer side: Acquire load + Acquire fence + compiler_fence before reading payload (AXS-CONC-044, AXS-CONC-045).
    let observed_ready = vr.load(Ordering.Acquire);
    fence(Ordering.Acquire);
    compiler_fence(Ordering.SeqCst);
    if observed_ready >= 0i32 {
        *mp
    } else {
        0i32
    }
}

fn test_notification_vs_publication_and_release_sequence() -> i32 {
    // 1. Release publication (AXS-CONC-046): Release store followed by Acquire load
    // establishes happens-before visibility for `published_data`.
    let mut published_data: i32 = 0i32;
    let seq = AtomicI32.new(0i32);
    let vseq = view(seq);

    published_data = 88i32;
    vseq.store(15i32, Ordering.Release);
    fence(Ordering.AcqRel);
    let acq_obs = vseq.load(Ordering.Acquire);

    // 2. Notification vs Publication (AXS-CONC-047):
    // Relaxed is valid ONLY for pure status/statistics counters with no dependent memory;
    // payload publication requires Release/Acquire.
    let notify_counter = AtomicI32.new(0i32);
    let vnotify = view(notify_counter);
    vnotify.store(1i32, Ordering.Relaxed);
    let ping = vnotify.load(Ordering.Relaxed);

    if acq_obs >= 0i32 && ping >= 0i32 {
        published_data
    } else {
        0i32
    }
}

fn test_gpu_host_device_ipc_and_shm_contracts() -> i32 {
    // 1. Host-Device GPU boundary (AXS-CONC-050): host must synchronize via an explicit
    // stream/event barrier before reading device-written output.
    let host_staging: i32 = 40i32;
    let device_computed: i32 = host_staging * 2i32;
    let stream_barrier_completed: bool = true;
    fence(Ordering.AcqRel);
    let host_readback: i32 = if stream_barrier_completed { device_computed } else { 0i32 };

    // 2. Cross-process / IPC boundary (AXS-CONC-051): `Send` does not permit sharing
    // in-memory pointers across processes; messages must be serialized as explicit value bytes.
    let ipc_wire_bytes: [2]i32 = [15i32, 20i32];
    let ipc_deserialized: i32 = ipc_wire_bytes[0] + ipc_wire_bytes[1];

    // 3. Shared-memory segment contract (AXS-CONC-052): @repr(C) layout + explicit atomic ordering.
    let shm = forward_send_share<ShmSegmentHeader>(ShmSegmentHeader { seq_lock: 2i32, payload_val: 45i32 });
    let shm_atom = AtomicI32.new(shm.seq_lock);
    let vshm = view(shm_atom);
    let seq_ok = vshm.load(Ordering.Acquire);
    let shm_read: i32 = if seq_ok >= 0i32 { shm.payload_val } else { 0i32 };

    host_readback + ipc_deserialized + shm_read
}

fn main() {
    let a = test_release_acquire_publication_and_fences();
    let b = test_notification_vs_publication_and_release_sequence();
    let c = test_gpu_host_device_ipc_and_shm_contracts();
    print_int((a + b + c) as i64);
    print("\n");
}
