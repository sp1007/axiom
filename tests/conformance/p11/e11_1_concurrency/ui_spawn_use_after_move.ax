// test: ui
// Covers: AXS-CONC-020, AXS-CONC-022, AXS-CONC-025
// Covers: ACONC-21, ACONC-24, ACONC-28
// Covers: REQ-CONC-016, REQ-CONC-197
// E11.1 negative UI conformance: owned !Copy captures move into `spawn` and
// `spawn_local`; any subsequent use or second `spawn` capture in the parent scope
// without re-initialization is rejected with `AX_MOVE_USE_AFTER_MOVE`.

module test_ui_spawn_use_after_move

struct OwnedPayload {
    pub id: i32,
    pub size: i32,
}

struct LocalPinnedTicket {
    pub raw: *mut u8,
    pub seq: i32,
}

impl !Send for LocalPinnedTicket {}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

fn spawn_local<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn main() {
    // 1. Owned !Copy capture moves into `spawn`; parent cannot read it afterwards (AXS-CONC-022).
    let p1 = OwnedPayload { id: 10, size: 64 };
    let _h1 = spawn(|| -> i32 {
        p1.id + p1.size
    });
    let _use1 = p1.id; //~ ERROR AX_MOVE_USE_AFTER_MOVE

    // 2. Owned !Copy !Send capture moves into `spawn_local`; parent cannot read it afterwards (AXS-CONC-022, AXS-CONC-025).
    let p2 = LocalPinnedTicket { raw: 0 as *mut u8, seq: 11 };
    let _h2 = spawn_local(|| -> i32 {
        p2.seq
    });
    let _use2 = p2.seq; //~ ERROR AX_MOVE_USE_AFTER_MOVE

    // 3. Second `spawn` attempting to capture a variable already moved into a prior `spawn`:
    let p3 = OwnedPayload { id: 30, size: 128 };
    let _h3a = spawn(|| -> i32 {
        p3.id
    });
    let _h3b = spawn(|| -> i32 { //~ ERROR AX_MOVE_USE_AFTER_MOVE
        p3.size
    });
}
