cmd: {compiler} inspect --emit=mir-opt -O1 --std-root {std_root} {test_dir}/mir_happens_before_and_zero_cost_erasure.ax
stdout-contains: _0 = copy _1;
stdout-contains: _0 = const 1;
stdout-contains: (*_2) = const 100;
stdout-contains: atomic_store Release copy _1, const 1;
stdout-contains: atomic_fence Acquire;
stdout-contains: atomic_rmw add AcqRel copy _1, const 1;
stdout-contains: atomic_cmpxchg AcqRel Acquire
stdout-contains: spin_loop_hint;
stdout-contains: atomic_load Acquire copy _1;
stdout-contains: compiler_fence SeqCst;
