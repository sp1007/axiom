// test: run
// modes: interp native
// stdout: 549\n
// Covers: AXS-CONC-030, AXS-CONC-032, AXS-CONC-033
// Covers: ACONC-28, ACONC-30, ACONCUR-147, ACONCUR-150, ACONCUR-152, ACONCUR-153, ACONCUR-176
// Covers: REQ-CONC-018, REQ-CONC-089, REQ-CONC-094, REQ-CONC-164, REQ-CONC-193
// E11.1 positive runtime conformance: concurrent `mut_view` mutation of statically
// disjoint struct fields (`p.a` vs `p.b`), nested disjoint struct paths
// (`tree.left.a` vs `tree.right.b`), 3-way disjoint fields, disjoint tuple fields
// (`.0` vs `.1`), disjoint constant array indices (`arr[0]` vs `arr[3]`), and
// non-overlapping constant slice ranges (`ms0[0..2]` vs `ms0[2..4]`, `ms[..mid]` vs `ms[mid..]`).

module test_run_disjoint_struct_and_slice_mutation

struct Pair {
    pub a: i32,
    pub b: i32,
}

struct DualPair {
    pub left: Pair,
    pub right: Pair,
}

struct Triple {
    pub x: i32,
    pub y: i32,
    pub z: i32,
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    let l = left();
    let r = right();
    l + r
}

fn par_join3<A: FnOnce, B: FnOnce, C: FnOnce>(f: A, g: B, h: C) -> i32 {
    let a = f();
    let b = g();
    let c = h();
    a + b + c
}

fn test_disjoint_struct_and_nested_fields() -> i32 {
    let mut p = Pair { a: 10, b: 20 };
    let mva = mut_view(p.a);
    let mvb = mut_view(p.b);

    // Parallel mutation of disjoint struct fields `p.a` and `p.b` (AXS-CONC-032).
    let r1 = par_join(
        || -> i32 {
            *mva = *mva + 5;
            *mva
        },
        || -> i32 {
            *mvb = *mvb + 15;
            *mvb
        }
    );

    // Post-join parent read of both mutated fields (ACONC-25, ACONC-28).
    let post_join = p.a + p.b;

    // Parallel mutation of nested disjoint struct paths `tree.left.a` and `tree.right.b`.
    let mut tree = DualPair {
        left: Pair { a: 3, b: 4 },
        right: Pair { a: 7, b: 8 },
    };
    let mvl = mut_view(tree.left.a);
    let mvr = mut_view(tree.right.b);
    let r2 = par_join(
        || -> i32 {
            *mvl = *mvl * 10;
            *mvl
        },
        || -> i32 {
            *mvr = *mvr * 10;
            *mvr
        }
    );

    r1 + post_join + r2
}

fn test_disjoint_three_fields_and_tuples() -> i32 {
    let mut tri = Triple { x: 10, y: 20, z: 30 };
    let mvx = mut_view(tri.x);
    let mvy = mut_view(tri.y);
    let vz = view(tri.z);

    // 3-way disjoint struct field access (two writes + one read).
    let r_tri = par_join3(
        || -> i32 {
            *mvx = *mvx + 1;
            *mvx
        },
        || -> i32 {
            *mvy = *mvy + 2;
            *mvy
        },
        || -> i32 { *vz }
    );

    // Disjoint tuple field projection `.0` vs `.1` (AXS-CONC-032).
    let mut tup = (14, 26);
    let mvt0 = mut_view(tup.0);
    let vt1 = view(tup.1);
    let r_tup = par_join(
        || -> i32 {
            *mvt0 = *mvt0 + 6;
            *mvt0
        },
        || -> i32 { *vt1 }
    );

    r_tri + r_tup
}

fn test_disjoint_array_indices_and_slices() -> i32 {
    let mut arr: [4]i32 = [10, 20, 30, 40];

    // Disjoint constant array indices `arr[0]` and `arr[3]` (AXS-CONC-033, ACONCUR-153).
    let mv0 = mut_view(arr[0]);
    let mv3 = mut_view(arr[3]);
    let r1 = par_join(
        || -> i32 {
            *mv0 = *mv0 + 5;
            *mv0
        },
        || -> i32 {
            *mv3 = *mv3 + 5;
            *mv3
        }
    );

    // Disjoint constant slice ranges `ms0[0..2]` and `ms0[2..4]` (AXS-CONC-033).
    let mut arr2: [4]i32 = [15, 20, 30, 45];
    let ms0: mut_view<[i32]> = mut_view(arr2);
    let mut s_lo = ms0[0..2];
    let mut s_hi = ms0[2..4];
    let r2 = par_join(
        || -> i32 { s_lo[0] + s_lo[1] },
        || -> i32 { s_hi[0] + s_hi[1] }
    );

    // Complementary split slices `ms[..mid]` and `ms[mid..]` (AXS-CONC-033, ACONCUR-176).
    let mut arr3: [4]i32 = [15, 20, 30, 45];
    let ms: mut_view<[i32]> = mut_view(arr3);
    let mid: usize = 2;
    let mut sp_lo = ms[..mid];
    let mut sp_hi = ms[mid..];
    let r3 = par_join(
        || -> i32 { sp_lo[0] },
        || -> i32 { sp_hi[1] }
    );

    r1 + r2 + r3
}

pub fn main() -> i32 {
    let a = test_disjoint_struct_and_nested_fields();
    let b = test_disjoint_three_fields_and_tuples();
    let c = test_disjoint_array_indices_and_slices();
    print_int(a + b + c);
    print("\n");
    0
}
