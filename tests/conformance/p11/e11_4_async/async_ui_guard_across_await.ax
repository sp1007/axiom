// test: ui
// covers: REQ-ASY-070 REQ-ASY-142

struct MutexGuard {
    dummy: i32,
}

async fn tick() -> i32 {
    1i32
}

async fn test_mutex_guard_across_await() -> i32 {
    let g = MutexGuard { dummy: 1 };
    let _ = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
    let _ = g.dummy;
    0i32
}

pub fn main() {}
