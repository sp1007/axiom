// test: run
// modes: interp native
// stdout: leaf_drop\ninner_local_drop\ninner_param_drop\nouter_local_drop\nouter_param_drop\nasync_cancellation_drop_order: PASS\n
// covers: REQ-ASY-011 REQ-ASY-079 REQ-ASY-080

use std.future.Context;
use std.future.Waker;
use std.future.RawWaker;
use std.future.RawWakerVTable;

struct OuterParam {
    id: i32,
}

impl Drop for OuterParam {
    fn drop(self: mut_view<OuterParam>) {
        print("outer_param_drop\n");
    }
}

struct OuterLocal {
    id: i32,
}

impl Drop for OuterLocal {
    fn drop(self: mut_view<OuterLocal>) {
        print("outer_local_drop\n");
    }
}

struct InnerParam {
    id: i32,
}

impl Drop for InnerParam {
    fn drop(self: mut_view<InnerParam>) {
        print("inner_param_drop\n");
    }
}

struct InnerLocal {
    id: i32,
}

impl Drop for InnerLocal {
    fn drop(self: mut_view<InnerLocal>) {
        print("inner_local_drop\n");
    }
}

struct PendingLeaf {
    id: i32,
}

impl Drop for PendingLeaf {
    fn drop(self: mut_view<PendingLeaf>) {
        print("leaf_drop\n");
    }
}

impl Future for PendingLeaf {
    type Output = i32;

    fn poll(self: mut_view<PendingLeaf>, cx: mut_view<Context>) -> Poll<i32> {
        Poll.Pending
    }
}

async fn inner_task(ip: InnerParam) -> i32 {
    let il = InnerLocal { id: 2i32 };
    let leaf = PendingLeaf { id: 3i32 };
    let res = leaf.await;
    let _ = il.id + ip.id + res;
    res
}

async fn outer_task(op: OuterParam) -> i32 {
    let ol = OuterLocal { id: 10i32 };
    let ip = InnerParam { id: 20i32 };
    let res = inner_task(ip).await;
    let _ = ol.id + op.id + res;
    res
}

fn main() -> i32 {
    let mut exit_code: i32 = 0i32;
    {
        let op = OuterParam { id: 100i32 };
        let mut fut = outer_task(op);
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        let p = fut.poll(mut_view(cx));
        match p {
            Poll.Pending => {},
            Poll.Ready(_) => {
                exit_code = 1i32;
            },
        }
        // At block exit, `fut` is dropped while suspended in `PendingLeaf`.
        // Deterministic drop glue executes in order:
        // 1. leaf_drop (active child sub-future dropped first)
        // 2. inner_local_drop
        // 3. inner_param_drop
        // 4. outer_local_drop
        // 5. outer_param_drop
    }
    if exit_code != 0i32 {
        return exit_code;
    }
    print("async_cancellation_drop_order: PASS\n");
    return 0i32;
}
