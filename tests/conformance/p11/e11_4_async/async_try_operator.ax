// test: run
// modes: interp native
// stdout: drop_tracker=101\nsuccess=60\ndrop_tracker=102\nerr=-7\nasync_try_operator: PASS\n
// covers: REQ-ASY-070 REQ-ASY-079 REQ-ASY-080 REQ-ASY-142

use std.future.block_on.block_on;

struct DropTracker {
    id: i32,
}

impl Drop for DropTracker {
    fn drop(self: mut_view<DropTracker>) {
        print("drop_tracker=");
        print_int(self.id as i64);
        print("\n");
    }
}

async fn validate_input(val: i32) -> Result<i32, i32> {
    if val < 0i32 {
        return Result.Err(val);
    }
    Result.Ok(val * 2i32)
}

async fn compute_with_try(tracker_id: i32, a: i32, b: i32) -> Result<i32, i32> {
    let _tracker = DropTracker { id: tracker_id };
    let v1 = validate_input(a).await?;
    let v2 = validate_input(b).await?;
    Result.Ok(v1 + v2)
}

fn main() -> i32 {
    // 1. Success path: validate_input(10) -> 20; validate_input(20) -> 40; sum = 60
    let r1 = block_on(compute_with_try(101i32, 10i32, 20i32));
    match r1 {
        Result.Ok(val) => {
            print("success=");
            print_int(val as i64);
            print("\n");
            if val != 60i32 {
                return 1i32;
            }
        },
        Result.Err(_) => return 2i32,
    }

    // 2. Early exit path: validate_input(-7) -> Err(-7), tracker dropped immediately
    let r2 = block_on(compute_with_try(102i32, -7i32, 20i32));
    match r2 {
        Result.Ok(_) => return 3i32,
        Result.Err(e) => {
            print("err=");
            print_int(e as i64);
            print("\n");
            if e != -7i32 {
                return 4i32;
            }
        },
    }

    print("async_try_operator: PASS\n");
    return 0i32;
}
