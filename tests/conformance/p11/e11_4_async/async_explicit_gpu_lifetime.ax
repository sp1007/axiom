// test: run
// modes: interp native
// stdout: gpu_result=1024\nasync_explicit_gpu_lifetime: PASS\n
// covers: REQ-ASY-134

use std.future.block_on.block_on;

struct GpuDeviceBuffer {
    id: i32,
    capacity: i64,
}

struct GpuKernelEvent {
    buffer: GpuDeviceBuffer,
    step: i32,
}

impl Future for GpuKernelEvent {
    type Output = i64;

    fn poll(self: mut_view<GpuKernelEvent>, cx: mut_view<Context>) -> Poll<i64> {
        let cur = self.step;
        if cur == 0i32 {
            self.step = 1i32;
            return Poll.Pending;
        }
        return Poll.Ready(self.buffer.capacity * 2i64);
    }
}

fn launch_kernel(buf: GpuDeviceBuffer) -> GpuKernelEvent {
    GpuKernelEvent {
        buffer: buf,
        step: 0i32,
    }
}

async fn run_gpu_pipeline() -> i64 {
    let buf = GpuDeviceBuffer { id: 1i32, capacity: 512i64 };
    let event = launch_kernel(buf);
    let result = event.await;
    result
}

fn main() -> i32 {
    let res = block_on(run_gpu_pipeline());
    print("gpu_result=");
    print_int(res);
    print("\n");
    if res != 1024i64 {
        return 1i32;
    }

    print("async_explicit_gpu_lifetime: PASS\n");
    return 0i32;
}
