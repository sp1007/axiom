// test: ui
// covers: REQ-ASY-075

fn spawn<Fut: Future + Send>(_fut: Fut) -> i32 {
    0i32
}

async fn tick() -> i32 {
    1i32
}

async fn bad_ptr_across_await() -> i32 {
    let p: *const u8 = 0 as *const u8;
    let _ = tick().await;
    let _ = p;
    0i32
}

pub fn main() {
    let _ = spawn(bad_ptr_across_await()); //~ ERROR AX_ASYNC_FUTURE_NOT_SEND
}
