// test: run
// modes: interp native
// stdout: chain=55\nbranch=42\nloop=40\nasync_control_flow: PASS\n
// covers: REQ-ASY-064 REQ-ASY-065 REQ-ASY-070 REQ-ASY-079 REQ-ASY-142

use std.future.block_on.block_on;

async fn add_five(x: i32) -> i32 {
    x + 5i32
}

async fn mult_two(x: i32) -> i32 {
    x * 2i32
}

async fn sub_three(x: i32) -> i32 {
    x - 3i32
}

async fn test_chain(init: i32) -> i32 {
    let a = add_five(init).await;
    let b = mult_two(a).await;
    let c = sub_three(b).await;
    let d = mult_two(c).await;
    d + 1i32
}

async fn branch_even(x: i32) -> i32 {
    x / 2i32
}

async fn branch_odd(x: i32) -> i32 {
    x * 3i32 + 1i32
}

async fn test_branch(x: i32) -> i32 {
    let mut res: i32 = 0i32;
    if (x % 2i32) == 0i32 {
        let v = branch_even(x).await;
        res = v;
    } else {
        let v = branch_odd(x).await;
        res = v;
    }
    res
}

async fn test_loop(mut count: i32) -> i32 {
    let mut sum: i32 = 0i32;
    while count > 0i32 {
        let added = add_five(count).await;
        sum = sum + added;
        count = count - 1i32;
    }
    sum
}

fn main() -> i32 {
    // test_chain(10): a=15, b=30, c=27, d=54, +1 = 55
    let c = block_on(test_chain(10i32));
    print("chain=");
    print_int(c as i64);
    print("\n");
    if c != 55i32 {
        return 1i32;
    }

    // test_branch(84): even -> 84 / 2 = 42
    let b = block_on(test_branch(84i32));
    print("branch=");
    print_int(b as i64);
    print("\n");
    if b != 42i32 {
        return 2i32;
    }

    // test_loop(5):
    // count 5: 5+5=10
    // count 4: 4+5=9
    // count 3: 3+5=8
    // count 2: 2+5=7
    // count 1: 1+5=6
    // sum = 10 + 9 + 8 + 7 + 6 = 40
    let l = block_on(test_loop(5i32));
    print("loop=");
    print_int(l as i64);
    print("\n");
    if l != 40i32 {
        return 3i32;
    }

    print("async_control_flow: PASS\n");
    return 0i32;
}
