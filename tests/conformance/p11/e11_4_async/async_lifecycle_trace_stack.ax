// test: run
// modes: interp native
// stdout: POLL fut=1 fn=lifecycle_task state=0\nPOLL fut=2 fn=yield_step state=0\nSUSPEND fut=2 fn=yield_step sp=0 state=1\nSUSPEND fut=1 fn=lifecycle_task sp=0 state=1\nWAKE fut=1\nRESUME fut=1 fn=lifecycle_task sp=0 state=1\nPOLL fut=2 fn=yield_step state=1\nRESUME fut=2 fn=yield_step sp=0 state=1\nCOMPLETE fut=2 fn=yield_step\nPOLL fut=3 fn=yield_step state=0\nSUSPEND fut=3 fn=yield_step sp=0 state=1\nSUSPEND fut=1 fn=lifecycle_task sp=1 state=2\nWAKE fut=1\nRESUME fut=1 fn=lifecycle_task sp=1 state=2\nPOLL fut=3 fn=yield_step state=1\nRESUME fut=3 fn=yield_step sp=0 state=1\nCOMPLETE fut=3 fn=yield_step\nCOMPLETE fut=1 fn=lifecycle_task\nresult=52\nasync_lifecycle_trace_stack: PASS\n
// covers: REQ-ASY-010 REQ-ASY-064 REQ-ASY-082 REQ-ASY-083 REQ-ASY-133

use std.future.Context;
use std.future.Future;
use std.future.Poll;
use std.future.RawWaker;
use std.future.RawWakerVTable;
use std.future.Waker;
use std.future.trace_complete;
use std.future.trace_poll;
use std.future.trace_resume;
use std.future.trace_suspend;
use std.future.trace_wake;

struct YieldStep {
    fut_id: u64,
    val: i32,
    polled: bool,
}

impl Future for YieldStep {
    type Output = i32;

    fn poll(self: mut_view<YieldStep>, cx: mut_view<Context>) -> Poll<i32> {
        if !self.polled {
            self.polled = true;
            trace_poll(self.fut_id, "yield_step", 0u32);
            trace_suspend(self.fut_id, "yield_step", 0u32, 1u32);
            Poll.Pending
        } else {
            trace_poll(self.fut_id, "yield_step", 1u32);
            trace_resume(self.fut_id, "yield_step", 0u32, 1u32);
            trace_complete(self.fut_id, "yield_step");
            Poll.Ready(self.val)
        }
    }
}

async fn lifecycle_task(init: i32) -> i32 {
    let y1 = YieldStep { fut_id: 2u64, val: 20i32, polled: false };
    let r1 = y1.await;
    let y2 = YieldStep { fut_id: 3u64, val: 22i32, polled: false };
    let r2 = y2.await;
    init + r1 + r2
}

fn main() -> i32 {
    let mut fut = lifecycle_task(10i32);
    let mut cx = Context {
        waker_val: Waker {
            raw: RawWaker {
                data: 0 as *const u8,
                vtable: 0 as *const RawWakerVTable,
            },
        },
    };

    trace_poll(1u64, "lifecycle_task", 0u32);
    let p1 = fut.poll(mut_view(cx));
    match p1 {
        Poll.Pending => {
            trace_suspend(1u64, "lifecycle_task", 0u32, 1u32);
        },
        Poll.Ready(_) => return 1i32,
    }

    trace_wake(1u64);

    trace_resume(1u64, "lifecycle_task", 0u32, 1u32);
    let p2 = fut.poll(mut_view(cx));
    match p2 {
        Poll.Pending => {
            trace_suspend(1u64, "lifecycle_task", 1u32, 2u32);
        },
        Poll.Ready(_) => return 2i32,
    }

    trace_wake(1u64);

    trace_resume(1u64, "lifecycle_task", 1u32, 2u32);
    let p3 = fut.poll(mut_view(cx));
    match p3 {
        Poll.Pending => return 3i32,
        Poll.Ready(val) => {
            trace_complete(1u64, "lifecycle_task");
            print("result=");
            print_int(val as i64);
            print("\n");
            if val != 52i32 {
                return 4i32;
            }
        },
    }

    print("async_lifecycle_trace_stack: PASS\n");
    return 0i32;
}
