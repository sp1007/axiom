// test: ui
// covers: REQ-ASY-142

struct NotAFuture {
    x: i32,
}

async fn bad_await_non_future() -> i32 {
    let a = (123i32).await; //~ ERROR AX_ASYNC_NOT_A_FUTURE
    let s = NotAFuture { x: a };
    let _ = s.await; //~ ERROR AX_ASYNC_NOT_A_FUTURE
    0i32
}

pub fn main() {
    let _ = bad_await_non_future();
}
