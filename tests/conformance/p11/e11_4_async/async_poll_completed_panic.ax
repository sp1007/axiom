// test: run
// modes: interp native
// exit: 101
// stdout: pre_panic_completed_poll\n
// stderr-contains: polling a completed Future state machine
// covers: REQ-ASY-081

use std.future.Context;
use std.future.Future;
use std.future.Poll;
use std.future.RawWaker;
use std.future.RawWakerVTable;
use std.future.Waker;

async fn simple_task() -> i32 {
    42i32
}

fn main() -> i32 {
    let mut fut = simple_task();
    let mut cx = Context {
        waker_val: Waker {
            raw: RawWaker {
                data: 0 as *const u8,
                vtable: 0 as *const RawWakerVTable,
            },
        },
    };

    // First poll completes the future to STATE_COMPLETED:
    let p1 = fut.poll(mut_view(cx));
    match p1 {
        Poll.Ready(_) => {},
        Poll.Pending => return 1i32,
    }

    print("pre_panic_completed_poll\n");

    // Polling after completion must panic deterministically with exit code 101:
    let _ = fut.poll(mut_view(cx));
    0i32
}
