// test: run
// modes: interp native
// exit: 101
// stdout: pre_panic_cancelled_poll\n
// stderr-contains: polling a completed Future state machine
// covers: REQ-ASY-081

use std.future.Context;
use std.future.Future;
use std.future.Poll;
use std.future.RawWaker;
use std.future.RawWakerVTable;
use std.future.Waker;

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct PendingSubFut {}

impl Future for PendingSubFut {
    type Output = i32;

    fn poll(self: mut_view<PendingSubFut>, cx: mut_view<Context>) -> Poll<i32> {
        Poll.Pending
    }
}

async fn suspended_task() -> i32 {
    let sub = PendingSubFut {};
    sub.await
}

fn main() -> i32 {
    let mut fut = suspended_task();
    let mut cx = Context {
        waker_val: Waker {
            raw: RawWaker {
                data: 0 as *const u8,
                vtable: 0 as *const RawWakerVTable,
            },
        },
    };

    // First poll suspends the future in state 1:
    let p1 = fut.poll(mut_view(cx));
    match p1 {
        Poll.Pending => {},
        Poll.Ready(_) => return 1i32,
    }

    // Transition state to cancelled/panicked (0xFFFFFFFEu32):
    unsafe {
        let p = address_of_mut(fut) as *mut u32;
        *p = 0xFFFFFFFEu32;
    }

    print("pre_panic_cancelled_poll\n");

    // Polling a cancelled future must panic deterministically with exit code 101:
    let _ = fut.poll(mut_view(cx));
    0i32
}
