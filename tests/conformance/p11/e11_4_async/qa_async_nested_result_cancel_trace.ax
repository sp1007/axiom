// test: run
// modes: interp native
// stdout: qa_part1_start\ndrop_tag=11\ndrop_tag=10\npart1_err=-99\nqa_part2_start\nPOLL fut=1 fn=outer_cancel_pipeline state=0\nPOLL fut=3 fn=step_leaf state=0\nSUSPEND fut=3 fn=step_leaf sp=0 state=1\nSUSPEND fut=1 fn=outer_cancel_pipeline sp=0 state=1\ndrop_leaf=300\ndrop_tag=22\ndrop_tag=21\ndrop_tag=20\ndrop_tag=102\ndrop_tag=101\ndrop_tag=100\nqa_async_nested_result_cancel_trace: PASS\n
// covers: REQ-ASY-011 REQ-ASY-070 REQ-ASY-079 REQ-ASY-080 REQ-ASY-082 REQ-ASY-142

use std.future.Context;
use std.future.Future;
use std.future.Poll;
use std.future.RawWaker;
use std.future.RawWakerVTable;
use std.future.Waker;
use std.future.block_on.block_on;
use std.future.trace_poll;
use std.future.trace_suspend;

struct TaggedDrop {
    id: i32,
}

impl Drop for TaggedDrop {
    fn drop(self: mut_view<TaggedDrop>) {
        print("drop_tag=");
        print_int(self.id as i64);
        print("\n");
    }
}

async fn fallible_step(x: i32) -> Result<i32, i32> {
    if x < 0i32 {
        Result.Err(x)
    } else {
        Result.Ok(x + 10i32)
    }
}

async fn try_nested_pipeline(param_id: i32, in_val: i32) -> Result<i32, i32> {
    let p_tag = TaggedDrop { id: param_id };
    let v1 = fallible_step(in_val).await?;
    let local_tag = TaggedDrop { id: param_id + 1i32 };
    let v2 = fallible_step(-99i32).await?;
    let _ = p_tag.id + local_tag.id + v1 + v2;
    Result.Ok(v1 + v2)
}

struct LeafFut {
    fut_id: u64,
    leaf_id: i32,
}

impl Drop for LeafFut {
    fn drop(self: mut_view<LeafFut>) {
        print("drop_leaf=");
        print_int(self.leaf_id as i64);
        print("\n");
    }
}

impl Future for LeafFut {
    type Output = Result<i32, i32>;

    fn poll(self: mut_view<LeafFut>, cx: mut_view<Context>) -> Poll<Result<i32, i32>> {
        trace_poll(self.fut_id, "step_leaf", 0u32);
        trace_suspend(self.fut_id, "step_leaf", 0u32, 1u32);
        Poll.Pending
    }
}

async fn inner_cancel_pipeline(p1: TaggedDrop, p2: TaggedDrop) -> Result<i32, i32> {
    let local_inner = TaggedDrop { id: 22i32 };
    let leaf = LeafFut { fut_id: 3u64, leaf_id: 300i32 };
    let res = leaf.await?;
    let _ = p1.id + p2.id + local_inner.id + res;
    Result.Ok(res)
}

async fn outer_cancel_pipeline(op1: TaggedDrop, op2: TaggedDrop) -> Result<i32, i32> {
    let local_outer = TaggedDrop { id: 102i32 };
    let ip1 = TaggedDrop { id: 20i32 };
    let ip2 = TaggedDrop { id: 21i32 };
    let res = inner_cancel_pipeline(ip1, ip2).await?;
    let _ = op1.id + op2.id + local_outer.id + res;
    Result.Ok(res)
}

fn main() -> i32 {
    // -------------------------------------------------------------
    // Part 1: Try operator `?` across nested async fn early exit drop order
    // -------------------------------------------------------------
    print("qa_part1_start\n");
    let r1 = block_on(try_nested_pipeline(10i32, 5i32));
    match r1 {
        Result.Ok(_) => return 1i32,
        Result.Err(e) => {
            print("part1_err=");
            print_int(e as i64);
            print("\n");
            if e != -99i32 {
                return 2i32;
            }
        },
    }

    // -------------------------------------------------------------
    // Part 2: Mid-flight cancellation drop order across nested async fn
    // -------------------------------------------------------------
    print("qa_part2_start\n");
    {
        let op1 = TaggedDrop { id: 100i32 };
        let op2 = TaggedDrop { id: 101i32 };
        let mut fut = outer_cancel_pipeline(op1, op2);
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };

        trace_poll(1u64, "outer_cancel_pipeline", 0u32);
        let p = fut.poll(mut_view(cx));
        match p {
            Poll.Pending => {
                trace_suspend(1u64, "outer_cancel_pipeline", 0u32, 1u32);
            },
            Poll.Ready(_) => return 3i32,
        }
        // fut is dropped at block exit while suspended inside LeafFut inside inner_cancel_pipeline
    }

    print("qa_async_nested_result_cancel_trace: PASS\n");
    return 0i32;
}
