// test: run
// modes: interp native
// stdout: custom_future=107\ngeneric_runner=107\nasync_generic_custom_future: PASS\n
// covers: REQ-ASY-011 REQ-ASY-070 REQ-ASY-079 REQ-ASY-142

use std.future.block_on.block_on;

struct YieldTwice {
    pub count: i32,
    pub target: i32,
}

impl Future for YieldTwice {
    type Output = i32;

    fn poll(self: mut_view<YieldTwice>, cx: mut_view<Context>) -> Poll<i32> {
        let cur = self.count;
        if cur < 2i32 {
            self.count = self.count + 1i32;
            return Poll.Pending;
        }
        return Poll.Ready(self.target);
    }
}

struct MultiStepFuture {
    pub step: i32,
    pub val: i32,
}

impl Future for MultiStepFuture {
    type Output = i32;

    fn poll(self: mut_view<MultiStepFuture>, cx: mut_view<Context>) -> Poll<i32> {
        let cur = self.step;
        if cur == 0i32 {
            self.step = 1i32;
            return Poll.Pending;
        }
        if cur == 1i32 {
            self.step = 2i32;
            return Poll.Pending;
        }
        return Poll.Ready(self.val * 3i32);
    }
}

async fn test_custom_futures() -> i32 {
    let mut y = YieldTwice { count: 0i32, target: 77i32 };
    let a = y.await;
    let mut ms = MultiStepFuture { step: 0i32, val: 10i32 };
    let b = ms.await;
    a + b
}

fn generic_block_runner<F: Future<Output = T>, T>(fut: F) -> T {
    block_on(fut)
}

fn main() -> i32 {
    // 77 + 30 = 107
    let cf = block_on(test_custom_futures());
    print("custom_future=");
    print_int(cf as i64);
    print("\n");
    if cf != 107i32 {
        return 1i32;
    }

    let gr = generic_block_runner(test_custom_futures());
    print("generic_runner=");
    print_int(gr as i64);
    print("\n");
    if gr != 107i32 {
        return 2i32;
    }

    print("async_generic_custom_future: PASS\n");
    return 0i32;
}
