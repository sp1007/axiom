// test: ui
// covers: REQ-CONC-036 REQ-CONC-037 REQ-CONC-038 REQ-CONC-039

module test_sync_negative_conformance

pub struct Rc<T> {
    pub ptr: *mut u8,
}
impl<T> !Send for Rc<T> {}
impl<T> !Share for Rc<T> {}

pub struct MutexGuard<T> {
    pub lock_ptr: *const u32,
    pub data_ptr: *mut T,
}
impl<T> !Copy for MutexGuard<T> {}
impl<T> !Send for MutexGuard<T> {}

pub struct RwLockWriteGuard<T> {
    pub lock_ptr: *const u32,
    pub data_ptr: *mut T,
}
impl<T> !Copy for RwLockWriteGuard<T> {}
impl<T> !Send for RwLockWriteGuard<T> {}

pub struct LocalKey<T> {
    pub slot_id: u32,
}
impl<T> !Send for LocalKey<T> {}
impl<T> !Share for LocalKey<T> {}

fn require_send<T: Send>(_x: T) {}
fn require_share<T: Share>(_x: T) {}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

@thread_local //~ ERROR AX_TYPE_INVALID_TLS_DECL
fn bad_tls_fn() {}

fn compute() -> i32 { 42 }

@thread_local
static mut BAD_INIT: i32 = compute(); //~ ERROR AX_TYPE_INVALID_TLS_DECL

@thread_local static mut TLS_VAL: i32 = 10;

pub fn main() {
    let rc: Rc<i32> = Rc { ptr: 0 as *mut u8 };
    require_send(rc); //~ ERROR AX_CONC_NOT_SEND
    require_share(rc); //~ ERROR AX_CONC_NOT_SHARE

    let mg: MutexGuard<i32> = MutexGuard { lock_ptr: 0 as *const u32, data_ptr: 0 as *mut i32 };
    require_send(mg); //~ ERROR AX_CONC_NOT_SEND

    let wg: RwLockWriteGuard<i32> = RwLockWriteGuard { lock_ptr: 0 as *const u32, data_ptr: 0 as *mut i32 };
    require_send(wg); //~ ERROR AX_CONC_NOT_SEND

    let lk: LocalKey<i32> = LocalKey { slot_id: 0u32 };
    require_send(lk); //~ ERROR AX_CONC_NOT_SEND
    require_share(lk); //~ ERROR AX_CONC_NOT_SHARE

    // 1. Capturing !Send types across spawn closure
    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = rc.ptr;
        1
    });

    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = mg.lock_ptr;
        2
    });

    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = wg.lock_ptr;
        3
    });

    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = lk.slot_id;
        4
    });

    // 2. Non-static view escaping into spawn
    let stack_val: i32 = 42;
    let v: view<i32> = view(stack_val);
    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *v
    });
}
