// AXS-AIO-040..043 with SPEC-34 structured concurrency: async socket I/O inside a `TaskGroup` on the `Executor`
// (its worker thread drives the IOCP reactor). One group holds three children: an echo server task that serves three
// connections one after another, a client task that opens those three connections in sequence (sends 5/9/13 bytes,
// reads the echo, half-closes and sees EOF), and a straggler task blocked in a UDP `recv_from` that is never
// answered. The server and the client complete with their values; `cancel_all` then cancels the straggler: its
// in-flight read is dropped (zombie op), the destination buffer is never written and the group reports exactly one
// `Cancelled` child.
//
// Two defects of the current std shape the test (see the report): the reactor counters are plain fields that every
// worker updates and the idle loop reads without the reactor lock, which the oracle's race detector reports with two
// workers (F4), so the executor has ONE worker and `main` never touches the reactor while the group runs; and the
// oracle listener has no backlog (F2), so the server posts the next accept immediately after closing a connection
// (before the client can observe the EOF on a single worker) and the client connects sequentially.

module main

use std.core.result.Result
use std.core.option.Option
use std.asyn.executor.Executor
use std.asyn.task.TaskError
use std.asyn.group.TaskGroup
use std.asyn.reactor.Reactor
use std.io.async_io.IoBuf
use std.net.SocketAddr
use std.net.ShutdownMode
use std.net.AsyncTcpListener
use std.net.AcceptFuture
use std.net.AsyncTcpStream
use std.net.AsyncUdpSocket

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn msg_byte(idx: u64, k: usize) -> u8 {
    (idx * 41u64 + (k as u64) * 5u64 + 3u64) as u8
}

// Raw pointers are `!Send`, so task parameters carry addresses as `usize` and the task casts them back at the point
// of use (a raw-pointer local living across `.await` would make the future `!Send`).

// Helpers that turn the `usize` addresses carried by the tasks back into pointers outside of any `async fn`
// (a raw-pointer local living across `.await` would make the future `!Send`).
fn accept_on(l: usize) -> AcceptFuture {
    let p = l as *const AsyncTcpListener;
    unsafe { view(*p).accept() }
}

// Serve `n` connections one after another; returns 1000 + the number of echoed bytes.
//
// The server spawned first posts accept #1 before the client task runs its first poll (FIFO, one worker).
async fn echo_server(l: usize, n: usize) -> i64 {
    let mut total: i64 = 0i64;
    let mut c: usize = 0;
    while c < n {
        let acc = accept_on(l);
        let mut s = match acc.await {
            Result.Ok(p) => p.0,
            Result.Err(_) => return -1i64,
        };
        loop {
            let mut out = mut_view(s).read_buf(IoBuf.with_capacity(64usize)).await;
            let b = mut_view(out).take_buf();
            match out.res {
                Result.Ok(k) => {
                    if k == 0usize {
                        break;
                    }
                    let w = mut_view(s).write_buf(b).await;
                    match w.res {
                        Result.Ok(wn) => { total = total + (wn as i64); },
                        Result.Err(_) => return -2i64,
                    }
                },
                Result.Err(_) => return -3i64,
            }
        }
        let _ = s.close();
        c = c + 1;
    }
    total + 1000i64
}

fn make_msg(idx: u64, n: usize) -> IoBuf {
    let mut b = IoBuf.with_capacity(n);
    mut_view(b).set_len(n);
    let mut k: usize = 0;
    while k < n {
        let _ = mut_view(b).set(k, msg_byte(idx, k));
        k = k + 1;
    }
    b
}

fn byte_is(b: view<IoBuf>, idx: usize, want: u8) -> bool {
    match b.get(idx) {
        Option.Some(v) => v == want,
        Option.None => false,
    }
}

// `SocketAddr` is not `Send` for the native checker, so tasks receive the port and build the address themselves.
// Tasks that own their stream use the owned-buffer `read_buf`/`write_buf` path (slice `read_exact`/`write_all` keep a
// pointer to the stream, which is not stable across `.await` for an `async fn` local; SPEC-33).
async fn client_task(r: usize, port: u16, idx: u64) -> i64 {
    let mut s = match AsyncTcpStream.connect(r as *mut Reactor, SocketAddr.localhost(port)).await {
        Result.Ok(s) => s,
        Result.Err(_) => return -1i64,
    };
    let n = 5usize + (idx as usize) * 4usize;
    let w = mut_view(s).write_buf(make_msg(idx, n)).await;
    match w.res {
        Result.Ok(wn) => {
            if wn != n {
                return -2i64;
            }
        },
        Result.Err(_) => return -2i64,
    }
    // read the echo back in as many pieces as TCP delivers it
    let mut got: usize = 0;
    while got < n {
        let mut out = mut_view(s).read_buf(IoBuf.with_capacity(n - got)).await;
        let b = mut_view(out).take_buf();
        match out.res {
            Result.Ok(k) => {
                if k == 0usize {
                    return -3i64;
                }
                let mut i: usize = 0;
                while i < k {
                    if !byte_is(view(b), i, msg_byte(idx, got + i)) {
                        return -4i64;
                    }
                    i = i + 1;
                }
                got = got + k;
            },
            Result.Err(_) => return -3i64,
        }
    }
    let _ = view(s).shutdown(ShutdownMode.Write);
    let eof = mut_view(s).read_buf(IoBuf.with_capacity(4usize)).await;
    match eof.res {
        Result.Ok(k) => {
            if k != 0usize {
                return -5i64;
            }
        },
        Result.Err(_) => return -6i64,
    }
    let _ = s.close();
    n as i64
}

async fn client_driver(r: usize, port: u16) -> i64 {
    let mut total: i64 = 0i64;
    let mut idx: u64 = 0u64;
    while idx < 3u64 {
        let v = client_task(r, port, idx).await;
        if v < 0i64 {
            return v;
        }
        total = total + v;
        idx = idx + 1u64;
    }
    total
}

// Blocks forever in a UDP `recv_from` nobody ever answers; only cancellation ends it. `dst` addresses 32 bytes owned
// by `main`.
async fn straggler(r: usize, dst: usize) -> i64 {
    let sock = match AsyncUdpSocket.bind(r as *mut Reactor, SocketAddr.localhost(0u16)) {
        Result.Ok(s) => s,
        Result.Err(_) => return -1i64,
    };
    let out = view(sock).recv_from(dst as *mut u8, 32usize).await;
    match out {
        Result.Ok(_) => 777i64,
        Result.Err(_) => 778i64,
    }
}

pub fn main() -> i32 {
    let exec = Executor.new(1);
    let r = view(exec).reactor();

    let listener = match AsyncTcpListener.bind(r, SocketAddr.localhost(0u16)) {
        Result.Ok(l) => l,
        Result.Err(_) => return 1i32,
    };
    let addr = view(listener).local_addr();
    let port = addr.port;

    let mut group: TaskGroup<i64> = TaskGroup.new();
    let lp = (unsafe { address_of(listener) }) as usize;
    let mut sdst: [32]u8 = [0u8; 32];
    let sdp = (unsafe { address_of_mut(sdst[0]) }) as usize;
    let rp = r as usize;
    let _ = mut_view(group).spawn(view(exec), echo_server(lp, 3usize));
    let _ = mut_view(group).spawn(view(exec), client_driver(rp, port));
    let _ = mut_view(group).spawn(view(exec), straggler(rp, sdp));

    // Collect the two children that complete on their own.
    let mut completed: i64 = 0i64;
    let mut sum: i64 = 0i64;
    let mut server_total: i64 = 0i64;
    let mut bad: i64 = 0i64;
    while completed < 2i64 {
        let nx: Option<Result<i64, TaskError>> = mut_view(group).next_blocking();
        match nx {
            Option.Some(res) => match res {
                Result.Ok(v) => {
                    if v == 27i64 {
                        sum = sum + v;
                    } else if v == 1027i64 {
                        server_total = v - 1000i64;
                    } else {
                        bad = bad + 1i64;
                    }
                    completed = completed + 1i64;
                },
                Result.Err(_) => {
                    bad = bad + 1i64;
                    completed = completed + 1i64;
                },
            },
            Option.None => { break; },
        }
    }
    let live_before = group.live_count() as i64;

    // Cancel the straggler (and the group).
    mut_view(group).cancel_all();
    let mut cancelled: i64 = 0i64;
    loop {
        let nx: Option<Result<i64, TaskError>> = mut_view(group).next_blocking();
        match nx {
            Option.Some(res) => match res {
                Result.Ok(_) => { bad = bad + 1i64; },
                Result.Err(e) => match e {
                    TaskError.Cancelled => { cancelled = cancelled + 1i64; },
                    TaskError.Panicked => { bad = bad + 1i64; },
                },
            },
            Option.None => { break; },
        }
    }

    // The reactor belongs to the worker thread; `main` only inspects memory the cancelled read must never touch.
    let mut untouched = true;
    let mut q: usize = 0;
    while q < 32usize {
        if sdst[q] != 0u8 {
            untouched = false;
        }
        q = q + 1;
    }

    let _ = listener.close();
    view(exec).shutdown();

    if bad != 0i64 || live_before != 1i64 {
        print("ERR bad=");
        print_int(bad);
        print(" live=");
        print_int(live_before);
        print("\n");
        return 10i32;
    }
    // clients: 5 + 9 + 13 = 27 bytes; the server echoed the same 27 bytes
    print("OK taskgroup_async_io completed=");
    print_int(completed);
    print(" clients=");
    print_int(sum);
    print(" server=");
    print_int(server_total);
    print(" cancelled=");
    print_int(cancelled);
    print(" untouched=");
    print_int(if untouched { 1i64 } else { 0i64 });
    print("\n");
    0i32
}
