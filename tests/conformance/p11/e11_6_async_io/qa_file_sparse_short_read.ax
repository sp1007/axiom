// test: run
// modes: interp native
// timeout: 90
// covers: REQ-ASY-155 REQ-ASY-152
// stdout: QA file_sparse_short_read size=104 short=6 gap=1 tail=1 eof=0 again=104\n

// QA adversarial (T428 gate, round 0), AXS-AIO-010/011/033: an AsyncFile positional write far beyond the end of the
// file extends it (size == offset + len), a read that straddles the end returns the short count (not an error and not
// the requested length), the extension reads back as zero bytes, and a read exactly at the end completes with 0 bytes.

module test.qa_file_sparse_short_read

use std.core.result.Result
use std.core.option.Option
use std.core.host.remove
use std.asyn.executor.LocalExecutor
use std.io.async_io.IoBuf
use std.fs.async_file.AsyncFile

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn byte_is(b: view<IoBuf>, idx: usize, want: u8) -> bool {
    match b.get(idx) {
        Option.Some(v) => v == want,
        Option.None => false,
    }
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let r = view(exec).reactor();

    // "build/t428_qa_sparse.bin" (24)
    let path: [24]u8 = [
        98u8, 117u8, 105u8, 108u8, 100u8, 47u8,
        116u8, 52u8, 50u8, 56u8, 95u8,
        113u8, 97u8, 95u8,
        115u8, 112u8, 97u8, 114u8, 115u8, 101u8,
        46u8, 98u8, 105u8, 110u8
    ];
    let f = match AsyncFile.create_bytes(r, view(path)) {
        Result.Ok(f) => f,
        Result.Err(_) => return 1i32,
    };
    let data: [4]u8 = [11u8, 22u8, 33u8, 44u8];
    match mut_view(exec).block_on(view(f).write_buf_at(100u64, IoBuf.from_slice(view(data)))).res {
        Result.Ok(n) => {
            if n != 4usize {
                return 2i32;
            }
        },
        Result.Err(_) => return 3i32,
    }
    match mut_view(exec).block_on(view(f).flush()) {
        Result.Ok(_) => {},
        Result.Err(_) => return 4i32,
    }
    let size: i64 = match view(f).file_size() {
        Result.Ok(s) => s as i64,
        Result.Err(_) => -1i64,
    };

    // straddling read: bytes 98..104 -> 2 zero bytes of extension + the 4 written bytes
    let rd = mut_view(exec).block_on(view(f).read_buf_at(98u64, IoBuf.with_capacity(16usize)));
    let short: i64 = match rd.res {
        Result.Ok(n) => n as i64,
        Result.Err(_) => -1i64,
    };
    let gap_ok = byte_is(view(rd.buf), 0usize, 0u8) && byte_is(view(rd.buf), 1usize, 0u8);
    let tail_ok = byte_is(view(rd.buf), 2usize, 11u8) && byte_is(view(rd.buf), 5usize, 44u8);

    // read exactly at the end of the file
    let at_end = mut_view(exec).block_on(view(f).read_buf_at(104u64, IoBuf.with_capacity(8usize)));
    let eof: i64 = match at_end.res {
        Result.Ok(n) => n as i64,
        Result.Err(_) => -1i64,
    };

    // the size is unchanged by the reads
    let again: i64 = match view(f).file_size() {
        Result.Ok(s) => s as i64,
        Result.Err(_) => -1i64,
    };

    match mut_view(exec).block_on(f.close()) {
        Result.Ok(_) => {},
        Result.Err(_) => return 5i32,
    }
    let _ = unsafe { remove(address_of(path[0]), 24usize) };
    mut_view(exec).shutdown();

    print("QA file_sparse_short_read size=");
    print_int(size);
    print(" short=");
    print_int(short);
    print(" gap=");
    print_int(if gap_ok { 1i64 } else { 0i64 });
    print(" tail=");
    print_int(if tail_ok { 1i64 } else { 0i64 });
    print(" eof=");
    print_int(eof);
    print(" again=");
    print_int(again);
    print("\n");
    0i32
}
