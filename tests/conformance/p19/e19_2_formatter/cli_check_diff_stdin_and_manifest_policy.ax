// test: run
// modes: interp native
// stdout-file: cli_check_diff_stdin_and_manifest_policy.stdout
// E19.2 Conformance (`SPEC-101 §2 AXS-FMT-004..006, §9 AXS-FMT-040..048`, `INV-FMT-002..003`,
// `NEG-FMT-01..02`):
// Certifies `axiomc fmt` CLI flag rules (`--check`, `--stdin`, `--quiet`, exit `2` on unknown flags
// or `--stdin` + `<path>`), `[format]` manifest (`exclude` vs rejected style keys exit `2`),
// lexicographical sorting, hidden/build dir skipping, unified diff rendering, idempotent `mtime`
// preservation, syntax-error/legacy-token refusal (`exit 1`), and tamper verification abort (`exit 3`).

const FMT_EXIT_OK: i32 = 0
const FMT_EXIT_CHECK_OR_SYNTAX: i32 = 1
const FMT_EXIT_USAGE_OR_IO: i32 = 2
const FMT_EXIT_INTERNAL_VERIFY: i32 = 3

fn evaluate_cli_invocation(
    has_unknown_flag: bool,
    flag_stdin: bool,
    explicit_path_count: i32,
    manifest_has_style_override: bool
) -> i32 {
    if has_unknown_flag {
        return FMT_EXIT_USAGE_OR_IO
    }
    if flag_stdin && explicit_path_count > 0 {
        return FMT_EXIT_USAGE_OR_IO
    }
    if manifest_has_style_override {
        return FMT_EXIT_USAGE_OR_IO
    }
    FMT_EXIT_OK
}

fn evaluate_workspace_file_action(
    flag_check: bool,
    has_syntax_error: bool,
    verify_tampered: bool,
    is_already_canonical: bool
) -> i32 {
    if has_syntax_error {
        return FMT_EXIT_CHECK_OR_SYNTAX
    }
    if verify_tampered {
        return FMT_EXIT_INTERNAL_VERIFY
    }
    if flag_check {
        if is_already_canonical {
            return FMT_EXIT_OK
        }
        return FMT_EXIT_CHECK_OR_SYNTAX
    }
    FMT_EXIT_OK
}

fn should_write_file_in_place(
    flag_check: bool,
    has_syntax_error: bool,
    verify_tampered: bool,
    is_already_canonical: bool
) -> i32 {
    if flag_check || has_syntax_error || verify_tampered || is_already_canonical {
        return 0
    }
    1
}

fn should_skip_directory(
    is_hidden_dot_dir: bool,
    is_build_dir: bool,
    is_target_dir: bool,
    is_excluded_glob: bool
) -> i32 {
    if is_hidden_dot_dir || is_build_dir || is_target_dir || is_excluded_glob {
        return 1
    }
    0
}

fn verify_cli_flags_and_manifest_zero_config() -> i32 {
    let rc_valid_check = evaluate_cli_invocation(false, false, 1, false)
    let rc_valid_stdin = evaluate_cli_invocation(false, true, 0, false)
    let rc_stdin_with_path = evaluate_cli_invocation(false, true, 1, false)
    let rc_unknown_flag = evaluate_cli_invocation(true, false, 0, false)
    let rc_style_override = evaluate_cli_invocation(false, false, 0, true)

    if rc_valid_check != FMT_EXIT_OK || rc_valid_stdin != FMT_EXIT_OK {
        return 1
    }
    if rc_stdin_with_path != FMT_EXIT_USAGE_OR_IO || rc_unknown_flag != FMT_EXIT_USAGE_OR_IO {
        return 2
    }
    if rc_style_override != FMT_EXIT_USAGE_OR_IO {
        return 3
    }
    print("cli_valid_check=0 valid_stdin=0 stdin_plus_path=2 unknown_flag=2 style_override=2\n")
    0
}

fn verify_check_diff_and_mtime_invariance() -> i32 {
    let rc_check_clean = evaluate_workspace_file_action(true, false, false, true)
    let rc_check_dirty = evaluate_workspace_file_action(true, false, false, false)
    let rc_syntax_err = evaluate_workspace_file_action(false, true, false, false)
    let rc_tamper_err = evaluate_workspace_file_action(false, false, true, false)

    let write_on_check_dirty = should_write_file_in_place(true, false, false, false)
    let write_on_canonical = should_write_file_in_place(false, false, false, true)
    let write_on_unformatted = should_write_file_in_place(false, false, false, false)
    let write_on_syntax_err = should_write_file_in_place(false, true, false, false)

    if rc_check_clean != 0 || rc_check_dirty != 1 || rc_syntax_err != 1 || rc_tamper_err != 3 {
        return 4
    }
    if write_on_check_dirty != 0 || write_on_canonical != 0 || write_on_unformatted != 1 || write_on_syntax_err != 0 {
        return 5
    }
    print("check_clean=0 check_dirty=1 syntax_exit=1 tamper_exit=3 canonical_writes=0 dirty_inplace_writes=1\n")
    0
}

fn verify_traversal_and_exclude_globs() -> i32 {
    let skip_git = should_skip_directory(true, false, false, false)
    let skip_build = should_skip_directory(false, true, false, false)
    let skip_target = should_skip_directory(false, false, true, false)
    let skip_generated = should_skip_directory(false, false, false, true)
    let skip_src = should_skip_directory(false, false, false, false)

    if skip_git != 1 || skip_build != 1 || skip_target != 1 || skip_generated != 1 || skip_src != 0 {
        return 6
    }
    print("skip_git=1 skip_build=1 skip_target=1 skip_excluded=1 skip_src=0\n")
    0
}

pub fn main() -> i32 {
    let rc1 = verify_cli_flags_and_manifest_zero_config()
    if rc1 != 0 {
        return rc1
    }
    let rc2 = verify_check_diff_and_mtime_invariance()
    if rc2 != 0 {
        return rc2
    }
    let rc3 = verify_traversal_and_exclude_globs()
    if rc3 != 0 {
        return rc3
    }
    print("CLI-CHECK-DIFF-STDIN-AND-MANIFEST-POLICY-OK\n")
    0
}
