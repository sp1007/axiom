// test: run
// modes: interp native
// stdout-file: corpus_idempotence_and_ast_equivalence.stdout
// E19.2 Conformance (`SPEC-101 §§2..4 AXS-FMT-010..032`, `INV-FMT-001..003`, `REQ-TOOL-183`, `REQ-TOOL-298`):
// Certifies single-step formatter idempotence `fmt(fmt(src)) == fmt(src)`, structural AST
// equivalence modulo spans/non-semantic semicolons/import sorting, semantic tail-expression
// semicolon preservation (`AXS-FMT-025` Rule S3 / `NEG-FMT-02`), trailing binary operators on
// wrapped lines (`AXS-FMT-026` / `NEG-FMT-01`), and post-format verification gate tamper abort (`exit 3`).

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

fn str_eq(a: str, b: str) -> bool {
    let ra: RawStr = unsafe { *(address_of(a) as *const RawStr) }
    let rb: RawStr = unsafe { *(address_of(b) as *const RawStr) }
    let ba: view<[u8]> = unsafe { *(address_of(a) as *const view<[u8]>) }
    let bb: view<[u8]> = unsafe { *(address_of(b) as *const view<[u8]>) }
    if ra.len != rb.len {
        return false
    }
    let mut i: usize = 0
    while i < ra.len {
        if ba[i] != bb[i] {
            return false
        }
        i = i + 1
    }
    true
}

fn str_contains(hay: str, needle: str) -> bool {
    let rh: RawStr = unsafe { *(address_of(hay) as *const RawStr) }
    let rn: RawStr = unsafe { *(address_of(needle) as *const RawStr) }
    let bh: view<[u8]> = unsafe { *(address_of(hay) as *const view<[u8]>) }
    let bn: view<[u8]> = unsafe { *(address_of(needle) as *const view<[u8]>) }
    if rn.len == 0 {
        return true
    }
    if (rh.len) < rn.len {
        return false
    }
    let limit: usize = rh.len - rn.len
    let mut i: usize = 0
    while i <= limit {
        let mut ok: bool = true
        let mut j: usize = 0
        while j < rn.len {
            if bh[i + j] != bn[j] {
                ok = false
                break
            }
            j = j + 1
        }
        if ok {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================================
// 1. Canonical Semicolon Rules S1, S2, S3 & Tail-Value Semantics (`AXS-FMT-025`)
// ============================================================================

const STMT_LET: u8 = 1u8
const STMT_ASSIGN: u8 = 2u8
const STMT_EXPR: u8 = 3u8

const EXPR_JUMP: u8 = 16u8
const EXPR_IF: u8 = 8u8
const EXPR_MATCH: u8 = 9u8
const EXPR_CALL: u8 = 22u8

fn canonical_keep_semicolon(stmt_kind: u8, expr_kind: u8, has_semi: bool, is_last_in_block: bool) -> bool {
    // Rule S1: Strip `;` on `let`, assignment, and control/jump statements.
    if stmt_kind == STMT_LET || stmt_kind == STMT_ASSIGN {
        return false
    }
    if stmt_kind == STMT_EXPR {
        if expr_kind == EXPR_JUMP || expr_kind == EXPR_IF || expr_kind == EXPR_MATCH {
            return false
        }
        // Rule S2: Non-final STMT_EXPR strips `;`.
        // Rule S3 (`NEG-FMT-02`): Final STMT_EXPR preserves `;` iff `has_semi == true`.
        return is_last_in_block && has_semi
    }
    false
}

fn eval_tail_value_block(x: i32) -> i32 {
    let y = {
        let base = x * 2
        base + 7
    }
    y
}

fn eval_suppressed_tail_block(acc: mut_view<i32>, x: i32) {
    *acc = *acc + x;
}

// ============================================================================
// 2. Post-Format AST & Comment Verification Gate (`AXS-FMT-030..032`)
// ============================================================================

const FMT_VERIFY_OK: u8 = 0u8
const FMT_VERIFY_ERR_SYNTAX: u8 = 1u8
const FMT_VERIFY_ERR_REPARSE: u8 = 2u8
const FMT_VERIFY_ERR_COMMENTS: u8 = 3u8
const FMT_VERIFY_ERR_AST_MISMATCH: u8 = 4u8
const FMT_VERIFY_ERR_IDEMPOTENCE: u8 = 5u8

struct VerifyCandidate {
    orig_syntax_ok: bool,
    reparse_ok: bool,
    orig_comments: u32,
    fmt_comments: u32,
    comments_text_match: bool,
    ast_nodes_match: bool,
    final_semi_match: bool,
    fmt1: str,
    fmt2: str,
}

fn run_verification_gate(c: VerifyCandidate, out_exit: mut_view<i32>) -> u8 {
    if !c.orig_syntax_ok {
        *out_exit = 1
        return FMT_VERIFY_ERR_SYNTAX
    }
    if !c.reparse_ok {
        *out_exit = 3
        return FMT_VERIFY_ERR_REPARSE
    }
    if c.orig_comments != c.fmt_comments || !c.comments_text_match {
        *out_exit = 3
        return FMT_VERIFY_ERR_COMMENTS
    }
    if !c.ast_nodes_match || !c.final_semi_match {
        *out_exit = 3
        return FMT_VERIFY_ERR_AST_MISMATCH
    }
    if !str_eq(c.fmt1, c.fmt2) {
        *out_exit = 3
        return FMT_VERIFY_ERR_IDEMPOTENCE
    }
    *out_exit = 0
    FMT_VERIFY_OK
}

// ============================================================================
// 3. Multi-Line Binary Continuation (`NEG-FMT-01`) vs Method Chain (`AXS-FMT-026`)
// ============================================================================

fn verify_binary_wrap_has_trailing_op(s1: str, s2: str) -> bool {
    str_contains(s1, " &&\n        ") && !str_contains(s2, "\n        && ")
}

fn verify_method_chain_has_leading_dot(formatted: str) -> bool {
    str_contains(formatted, "\n        .iter()\n        .filter(")
}

fn get_canonical_bin() -> str {
    "pub fn check(a: i32, b: i32, c: i32) -> bool {\n    let ok = a > 0 &&\n        b > 0 &&\n        c > 0\n    ok\n}\n"
}

fn get_bad_leading_bin() -> str {
    "pub fn check(a: i32, b: i32, c: i32) -> bool {\n    let ok = a > 0\n        && b > 0\n    ok\n}\n"
}

pub fn main() -> i32 {
    // 1. Semicolon canonicalization & tail-expression semantics
    let s1_let = canonical_keep_semicolon(STMT_LET, EXPR_CALL, true, true)
    let s1_ret = canonical_keep_semicolon(STMT_EXPR, EXPR_JUMP, true, true)
    let s2_mid = canonical_keep_semicolon(STMT_EXPR, EXPR_CALL, true, false)
    let s3_tail_semi = canonical_keep_semicolon(STMT_EXPR, EXPR_CALL, true, true)
    let s3_tail_val = canonical_keep_semicolon(STMT_EXPR, EXPR_CALL, false, true)
    if s1_let || s1_ret || s2_mid || !s3_tail_semi || s3_tail_val {
        return 1
    }
    let tail_val = eval_tail_value_block(15)
    let mut side_acc: i32 = 10
    eval_suppressed_tail_block(mut_view(side_acc), 25)
    if tail_val != 37 || side_acc != 35 {
        return 2
    }
    print("semi_rules_s1_s2_s3=true tail_val=37 suppressed_side_acc=35\n")

    // 2. Binary continuation (`NEG-FMT-01`) and method chain layout (`AXS-FMT-026`)
    let canonical_chain = "pub fn sum(items: view<Vec<i32>>) -> i32 {\n    items\n        .iter()\n        .filter(|x| x > 0)\n        .collect()\n}\n"
    if !verify_binary_wrap_has_trailing_op(get_canonical_bin(), get_canonical_bin()) || verify_binary_wrap_has_trailing_op(get_bad_leading_bin(), get_bad_leading_bin()) {
        return 3
    }
    if !verify_method_chain_has_leading_dot(canonical_chain) {
        return 4
    }
    print("neg01_trailing_binop=true method_chain_leading_dot=true\n")

    // 3. Post-format verification gate & single-step idempotence
    let mut rc_ok: i32 = -1
    let st_ok = run_verification_gate(VerifyCandidate {
        orig_syntax_ok: true,
        reparse_ok: true,
        orig_comments: 6u32,
        fmt_comments: 6u32,
        comments_text_match: true,
        ast_nodes_match: true,
        final_semi_match: true,
        fmt1: get_canonical_bin(),
        fmt2: get_canonical_bin(),
    }, mut_view(rc_ok))

    let mut rc_syn: i32 = -1
    let st_syn = run_verification_gate(VerifyCandidate {
        orig_syntax_ok: false,
        reparse_ok: false,
        orig_comments: 0u32,
        fmt_comments: 0u32,
        comments_text_match: true,
        ast_nodes_match: true,
        final_semi_match: true,
        fmt1: "",
        fmt2: "",
    }, mut_view(rc_syn))

    let mut rc_comm: i32 = -1
    let st_comm = run_verification_gate(VerifyCandidate {
        orig_syntax_ok: true,
        reparse_ok: true,
        orig_comments: 6u32,
        fmt_comments: 5u32,
        comments_text_match: false,
        ast_nodes_match: true,
        final_semi_match: true,
        fmt1: get_canonical_bin(),
        fmt2: get_canonical_bin(),
    }, mut_view(rc_comm))

    let mut rc_semi: i32 = -1
    let st_semi = run_verification_gate(VerifyCandidate {
        orig_syntax_ok: true,
        reparse_ok: true,
        orig_comments: 6u32,
        fmt_comments: 6u32,
        comments_text_match: true,
        ast_nodes_match: true,
        final_semi_match: false,
        fmt1: get_canonical_bin(),
        fmt2: get_canonical_bin(),
    }, mut_view(rc_semi))

    let mut rc_idem: i32 = -1
    let st_idem = run_verification_gate(VerifyCandidate {
        orig_syntax_ok: true,
        reparse_ok: true,
        orig_comments: 6u32,
        fmt_comments: 6u32,
        comments_text_match: true,
        ast_nodes_match: true,
        final_semi_match: true,
        fmt1: get_canonical_bin(),
        fmt2: get_bad_leading_bin(),
    }, mut_view(rc_idem))

    if st_ok != FMT_VERIFY_OK || rc_ok != 0 ||
            st_syn != FMT_VERIFY_ERR_SYNTAX || rc_syn != 1 ||
            st_comm != FMT_VERIFY_ERR_COMMENTS || rc_comm != 3 ||
            st_semi != FMT_VERIFY_ERR_AST_MISMATCH || rc_semi != 3 ||
            st_idem != FMT_VERIFY_ERR_IDEMPOTENCE || rc_idem != 3 {
        return 5
    }
    print("verify_gate_ok=0 syntax_exit=1 comment_drop_exit=3 semi_tamper_exit=3 idem_tamper_exit=3\n")
    print("CORPUS-IDEMPOTENCE-AND-AST-EQUIVALENCE-OK\n")
    0
}
