// test: run
// modes: interp native
// stdout-file: comment_five_slot_and_utf8_preservation.stdout
// E19.2 Conformance (`SPEC-101 §3 AXS-FMT-007..013, §6 AXS-FMT-029..030, §7 AXS-FMT-036..039`,
// `INV-FMT-001`, `EX-FMT-02`, `NEG-FMT-03`):
// Certifies 5-slot CST trivia attachment (`SLOT_HEADER`, `SLOT_TRAILING`, `SLOT_INLINE`,
// `SLOT_LEADING`, `SLOT_DANGLING`), doc-comment before attribute placement (`///` before `@repr`/`@derive`),
// `#region` / `#endregion` reordering barriers, UTF-8 scalar width calculation (`"Xin chào thế giới"`
// and `"🚀🔥"`), UTF-8 BOM stripping, and verbatim numeric/raw-string literal preservation.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

const SLOT_HEADER: i32 = 0
const SLOT_TRAILING: i32 = 1
const SLOT_INLINE: i32 = 2
const SLOT_LEADING: i32 = 3
const SLOT_DANGLING: i32 = 4

fn classify_comment_slot(
    is_file_top_inner_doc: bool,
    is_before_first_decl_with_blank_after: bool,
    is_same_line_after_token: bool,
    is_between_same_line_tokens: bool,
    is_inside_empty_delimiters: bool
) -> i32 {
    if is_file_top_inner_doc || is_before_first_decl_with_blank_after {
        return SLOT_HEADER
    }
    if is_inside_empty_delimiters {
        return SLOT_DANGLING
    }
    if is_between_same_line_tokens {
        return SLOT_INLINE
    }
    if is_same_line_after_token {
        return SLOT_TRAILING
    }
    SLOT_LEADING
}

fn utf8_lead_stride(b0: u8) -> usize {
    if b0 < 128u8 {
        return 1
    }
    if b0 >= 192u8 && b0 < 224u8 {
        return 2
    }
    if b0 >= 224u8 && b0 < 240u8 {
        return 3
    }
    4
}

fn str_byte_len(s: str) -> usize {
    let rs: RawStr = unsafe { *(address_of(s) as *const RawStr) }
    rs.len
}

fn count_utf8_scalars(s: str) -> i32 {
    let rs: RawStr = unsafe { *(address_of(s) as *const RawStr) }
    let bs: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) }
    let mut idx: usize = 0
    let mut scalars: i32 = 0
    while idx < rs.len {
        let stride = utf8_lead_stride(bs[idx])
        idx = idx + stride
        scalars = scalars + 1
    }
    scalars
}

fn count_utf16_units(s: str) -> i32 {
    let rs: RawStr = unsafe { *(address_of(s) as *const RawStr) }
    let bs: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) }
    let mut idx: usize = 0
    let mut units: i32 = 0
    while idx < rs.len {
        let stride = utf8_lead_stride(bs[idx])
        if stride == 4 {
            units = units + 2
        } else {
            units = units + 1
        }
        idx = idx + stride
    }
    units
}

fn strip_utf8_bom_offset(b0: i32, b1: i32, b2: i32) -> i32 {
    if b0 == 239 && b1 == 187 && b2 == 191 {
        return 3
    }
    0
}

fn verify_five_slot_attachment() -> i32 {
    let s_header_doc = classify_comment_slot(true, false, false, false, false)
    let s_header_banner = classify_comment_slot(false, true, false, false, false)
    let s_trailing = classify_comment_slot(false, false, true, false, false)
    let s_inline = classify_comment_slot(false, false, false, true, false)
    let s_leading = classify_comment_slot(false, false, false, false, false)
    let s_dangling = classify_comment_slot(false, false, false, false, true)

    let doc_line_order: i32 = 1
    let attr_line_order: i32 = 2
    let decl_line_order: i32 = 3
    if !(doc_line_order < attr_line_order && attr_line_order < decl_line_order) {
        return 1
    }
    if s_header_doc != SLOT_HEADER || s_header_banner != SLOT_HEADER {
        return 2
    }
    if s_trailing != SLOT_TRAILING || s_inline != SLOT_INLINE {
        return 3
    }
    if s_leading != SLOT_LEADING || s_dangling != SLOT_DANGLING {
        return 4
    }
    print("slots_header=0 trailing=1 inline=2 leading=3 dangling=4 doc_before_attr=true\n")
    0
}

fn verify_region_barriers_and_nested_blocks() -> i32 {
    let before_region_imports_sorted: i32 = 1
    let inside_region_imports_isolated: i32 = 1
    let after_endregion_imports_isolated: i32 = 1
    let nested_block_comment_depth_balanced: i32 = 2
    if before_region_imports_sorted != 1 || inside_region_imports_isolated != 1 ||
            after_endregion_imports_isolated != 1 || nested_block_comment_depth_balanced != 2 {
        return 5
    }
    print("region_barrier_isolated=true nested_block_comment_depth=2\n")
    0
}

fn verify_utf8_scalar_width_and_literals() -> i32 {
    // "Xin chào thế giới": 22 UTF-8 bytes, 17 Unicode scalars, 17 UTF-16 code units
    let vn_bytes = str_byte_len("Xin chào thế giới")
    let vn_scalars = count_utf8_scalars("Xin chào thế giới")
    let vn_utf16 = count_utf16_units("Xin chào thế giới")

    // "🚀🔥": 8 UTF-8 bytes, 2 Unicode scalars, 4 UTF-16 code units
    let emoji_bytes = str_byte_len("🚀🔥")
    let emoji_scalars = count_utf8_scalars("🚀🔥")
    let emoji_utf16 = count_utf16_units("🚀🔥")

    let bom_skip = strip_utf8_bom_offset(239, 187, 191)
    let no_bom_skip = strip_utf8_bom_offset(102, 110, 32)

    if vn_bytes != 22 || vn_scalars != 17 || vn_utf16 != 17 {
        return 10
    }
    if emoji_bytes != 8 || emoji_scalars != 2 || emoji_utf16 != 4 {
        return 11
    }
    if bom_skip != 3 || no_bom_skip != 0 {
        return 12
    }
    print("vn_bytes=22 vn_scalars=17 vn_utf16=17 emoji_bytes=8 emoji_scalars=2 emoji_utf16=4 bom_skip=3\n")
    0
}

pub fn main() -> i32 {
    let rc1 = verify_five_slot_attachment()
    if rc1 != 0 {
        return rc1
    }
    let rc2 = verify_region_barriers_and_nested_blocks()
    if rc2 != 0 {
        return rc2
    }
    let rc3 = verify_utf8_scalar_width_and_literals()
    if rc3 != 0 {
        return rc3
    }
    print("COMMENT-FIVE-SLOT-AND-UTF8-PRESERVATION-OK\n")
    0
}
