@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn out_u32(v: u32) {
    let mut buf: [16]u8 = [0u8; 16]
    if v == 0u32 {
        buf[0] = 48u8
        let _ = unsafe { write(stdio(1), address_of<u8>(buf[0]), 1) }
        return
    }
    let mut x = v
    let mut n: usize = 0
    while x > 0u32 {
        buf[15 - n] = 48u8 + ((x % 10u32) as u8)
        x = x / 10u32
        n = n + 1
    }
    let _ = unsafe { write(stdio(1), address_of<u8>(buf[16 - n]), n) }
}

fn mk_span(fv: u32, st: u32, en: u32) -> Span {
    span_new(FileId { v: fv }, st, en)
}

fn setup_conformance_db(db: mut_view<CompilerDB>) {
    query_db_init(mut_view(*db), 1u64)
    let src = ux2_sv("pub fn split_payload(mut buf: [8]u8) -> u8 { buf[0] }\n")
    let sf_id = SourceFileId { v: 1u32 }
    let mod_id = ModuleId { v: 1u32 }
    let def_id = DefId { v: 1u32 }
    let sk = semantic_key_new(ux2_sv("pkg"), ux2_sv("packet_proc"), ITEM_NS_VALUE, 0u32, ux2_sv("split_payload"), ux2_sv_empty())
    let _ = query_db_set_source_file_input(mut_view(*db), sf_id, ux2_sv("packet.ax"), src, DURABILITY_LOW)
    let _ = query_db_set_module_tree_input(mut_view(*db), mod_id, PackageId { v: 1u32 }, ModuleId { v: 0u32 }, ux2_sv("packet_proc"), sf_id, DURABILITY_LOW)
    let _ = query_db_register_def(mut_view(*db), def_id, mod_id, ITEM_KIND_FN, true, 0u32, 1u32, sk)
}

fn probe_ux2_causal_fp_and_taint() -> bool {
    let src_text = ux2_sv("pub fn bad(b: Buffer) -> i32 {\n    let buf = b\n    let a = consume(buf)\n    read_view(view(buf))\n}\n")
    let mut sdb = ux2_source_db_new()
    let fid = ux2_source_db_add_memory(mut_view(sdb), ux2_sv("bad_move.ax"), src_text)
    let fv = fid.v

    let mut move_chain = causal_chain_empty()
    causal_chain_push(mut_view(move_chain), CausalRole.Origin, mk_span(fv, 35u32, 42u32), SymbolId { v: 1u32 }, ux2_sv("`buf` declared as owning `Buffer`"))
    causal_chain_push(mut_view(move_chain), CausalRole.Transfer, mk_span(fv, 59u32, 71u32), SymbolId { v: 1u32 }, ux2_sv("ownership moved into `consume`"))
    causal_chain_push(mut_view(move_chain), CausalRole.Violation, mk_span(fv, 86u32, 95u32), SymbolId { v: 1u32 }, ux2_sv("`buf` used after move"))
    let move_ok = ux2_verify_causal_completeness(diag_code(AX_MOVE_USE_AFTER_MOVE), view(move_chain))

    let mut cap_chain = causal_chain_empty()
    cap_chain.region_expr = ux2_sv("v[0]")
    cap_chain.owner_symbol = ux2_sv("v")
    causal_chain_push(mut_view(cap_chain), CausalRole.Origin, mk_span(fv, 10u32, 14u32), SymbolId { v: 2u32 }, ux2_sv("`v` owns Vec<i32>"))
    causal_chain_push(mut_view(cap_chain), CausalRole.BorrowShared, mk_span(fv, 35u32, 42u32), SymbolId { v: 3u32 }, ux2_sv("`elem` borrows `v[0]`"))
    causal_chain_push(mut_view(cap_chain), CausalRole.ContainerMutation, mk_span(fv, 59u32, 71u32), SymbolId { v: 2u32 }, ux2_sv("`Vec.push` may reallocate `v`"))
    causal_chain_push(mut_view(cap_chain), CausalRole.Violation, mk_span(fv, 86u32, 95u32), SymbolId { v: 3u32 }, ux2_sv("`elem` dereferenced after relocation"))
    let cap_ok = ux2_verify_causal_completeness(diag_code(AX_CAP_CONTAINER_RELOC), view(cap_chain))

    let mut conc_chain = causal_chain_empty()
    conc_chain.derivation_path = ux2_sv("WorkerState -> handle: Rc<Socket>")
    causal_chain_push(mut_view(conc_chain), CausalRole.ObligationOrigin, mk_span(fv, 10u32, 20u32), SymbolId { v: 4u32 }, ux2_sv("required by `Thread.spawn`"))
    causal_chain_push(mut_view(conc_chain), CausalRole.Violation, mk_span(fv, 59u32, 71u32), SymbolId { v: 4u32 }, ux2_sv("`Rc<Socket>` is `!Send`"))
    let conc_ok = ux2_verify_causal_completeness(diag_code(AX_CONC_NOT_SEND), view(conc_chain))

    let mut async_chain = causal_chain_empty()
    causal_chain_push(mut_view(async_chain), CausalRole.BorrowShared, mk_span(fv, 10u32, 20u32), SymbolId { v: 5u32 }, ux2_sv("`view` borrowed here"))
    causal_chain_push(mut_view(async_chain), CausalRole.SuspensionPoint, mk_span(fv, 35u32, 42u32), SymbolId { v: 5u32 }, ux2_sv("suspended across `.await`"))
    causal_chain_push(mut_view(async_chain), CausalRole.Violation, mk_span(fv, 59u32, 71u32), SymbolId { v: 5u32 }, ux2_sv("`view` used after `.await`"))
    let async_ok = ux2_verify_causal_completeness(diag_code(AX_ASYNC_VIEW_ACROSS_AWAIT), view(async_chain))

    let sk = semantic_key_new(ux2_sv("pkg"), ux2_sv("bad_move"), ITEM_NS_VALUE, 0u32, ux2_sv("bad"), ux2_sv_empty())
    let fp1 = ux2_compute_fingerprint(diag_code(AX_MOVE_USE_AFTER_MOVE), view(sk), 0u32, mk_span(fv, 86u32, 95u32), 42u64)
    let fp2 = ux2_compute_fingerprint(diag_code(AX_MOVE_USE_AFTER_MOVE), view(sk), 200u32, mk_span(fv, 286u32, 295u32), 42u64)
    let fp_stable = fingerprint128_eq(fp1, fp2) && (fp1.lo != 0u64 || fp1.hi != 0u64)

    let mut d2 = diagnostic2_new(
        diag_code(AX_MOVE_USE_AFTER_MOVE),
        mk_span(fv, 86u32, 95u32),
        ux2_sv("use of moved value `buf`"),
        fp1,
        move_chain,
        ux2_sv("SPEC-10 AXS-OWN-002")
    )
    d2.fix = ux2_fix_move_pass_view(mk_span(fv, 67u32, 70u32), ux2_sv("view(buf)"), true)
    d2.has_fix = true

    let mut term_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut json_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(term_buf))
    diag_buf_init(mut_view(json_buf))
    ux2_render_terminal(view(d2), view(sdb), mut_view(term_buf))
    ux2_render_json_v1(view(d2), 0u32, mut_view(json_buf))
    let term_sv = diag_buf_as_str_view(view(term_buf))
    let json_sv = diag_buf_as_str_view(view(json_buf))
    let render_ok = ux2_sv_contains(term_sv, ux2_sv("[1] created here")) &&
        ux2_sv_contains(term_sv, ux2_sv("[2] moved here")) &&
        ux2_sv_contains(term_sv, ux2_sv("[3] used here")) &&
        ux2_sv_contains(json_sv, ux2_sv("\"causal_steps\":3")) &&
        ux2_sv_contains(json_sv, ux2_sv("\"applicability\":\"machine-applicable\"")) &&
        ux2_check_no_internal_id_leak(term_sv, false) &&
        !ux2_check_no_internal_id_leak(ux2_sv("TypeId(1847)"), false)

    let vn = ux2_sv("Xin chào")
    let vn_cols = ux2_utf8_display_cols(vn.ptr, vn.len)

    let mut tracker = ux2_tracker_new()
    let d_root = diagnostic2_new(diag_code(AX_NAME_UNRESOLVED), mk_span(fv, 10u32, 18u32), ux2_sv("unresolved"), fp1, causal_chain_empty(), ux2_sv_empty())
    let d_dep = diagnostic2_new(diag_code(AX_TYPE_MISMATCH), mk_span(fv, 20u32, 28u32), ux2_sv("dep"), ux2_compute_fingerprint(diag_code(AX_TYPE_MISMATCH), view(sk), 0u32, mk_span(fv, 20u32, 28u32), 2u64), causal_chain_empty(), ux2_sv_empty())
    let d_sib = diagnostic2_new(diag_code(AX_TYPE_MISMATCH), mk_span(fv, 30u32, 38u32), ux2_sv("sib"), ux2_compute_fingerprint(diag_code(AX_TYPE_MISMATCH), view(sk), 0u32, mk_span(fv, 30u32, 38u32), 3u64), causal_chain_empty(), ux2_sv_empty())
    let d_m1 = diagnostic2_new(diag_code(AX_MOVE_USE_AFTER_MOVE), mk_span(fv, 40u32, 48u32), ux2_sv("m1"), ux2_compute_fingerprint(diag_code(AX_MOVE_USE_AFTER_MOVE), view(sk), 0u32, mk_span(fv, 40u32, 48u32), 4u64), causal_chain_empty(), ux2_sv_empty())
    let d_m2 = diagnostic2_new(diag_code(AX_MOVE_USE_AFTER_MOVE), mk_span(fv, 50u32, 58u32), ux2_sv("m2"), ux2_compute_fingerprint(diag_code(AX_MOVE_USE_AFTER_MOVE), view(sk), 0u32, mk_span(fv, 50u32, 58u32), 5u64), causal_chain_empty(), ux2_sv_empty())
    let d_m3 = diagnostic2_new(diag_code(AX_MOVE_USE_AFTER_MOVE), mk_span(fv, 60u32, 68u32), ux2_sv("m3"), ux2_compute_fingerprint(diag_code(AX_MOVE_USE_AFTER_MOVE), view(sk), 0u32, mk_span(fv, 60u32, 68u32), 6u64), causal_chain_empty(), ux2_sv_empty())

    let _ = ux2_emit_root_error_and_taint(mut_view(tracker), 1u32, TAINT_TYPE_NAME, d_root)
    let _ = ux2_try_emit_dependent_diag(mut_view(tracker), 1u32, d_dep)
    let _ = ux2_try_emit_dependent_diag(mut_view(tracker), 1u32, d_dep)
    let _ = ux2_try_emit_dependent_diag(mut_view(tracker), 2u32, d_sib)
    let m1 = ux2_try_emit_ownership_violation(mut_view(tracker), 5u32, d_m1)
    let m2 = ux2_try_emit_ownership_violation(mut_view(tracker), 5u32, d_m2)
    ux2_reinitialize_local(mut_view(tracker), 5u32)
    let m3 = ux2_try_emit_ownership_violation(mut_view(tracker), 5u32, d_m3)
    let reinit_ok = m1 && !m2 && m3 && tracker.diag_count == 4u32 && tracker.suppressed_cascade_count == 3u32

    out_str("probe[ux2_causal_fp_taint] move_ok=")
    out_bool(move_ok)
    out_str(" cap_ok=")
    out_bool(cap_ok)
    out_str(" conc_ok=")
    out_bool(conc_ok)
    out_str(" async_ok=")
    out_bool(async_ok)
    out_str(" fp_stable=")
    out_bool(fp_stable)
    out_str(" render_ok=")
    out_bool(render_ok)
    out_str(" vn_cols=")
    out_u32(vn_cols)
    out_str(" emitted=")
    out_u32(tracker.diag_count)
    out_str(" suppressed=")
    out_u32(tracker.suppressed_cascade_count)
    out_str(" reinit_ok=")
    out_bool(reinit_ok)
    out_str("\n")

    diag_buf_free(mut_view(json_buf))
    diag_buf_free(mut_view(term_buf))
    source_db_free(mut_view(sdb))
    move_ok && cap_ok && conc_ok && async_ok && fp_stable && render_ok && vn_cols == 8u32 && reinit_ok
}

fn probe_fix_and_explain(db: mut_view<CompilerDB>) -> bool {
    let mod_id = ModuleId { v: 1u32 }
    let def_id = DefId { v: 1u32 }
    let fv: u32 = 1u32
    let src = ux2_sv("pub fn inc() -> i32 {\n    let count = 0\n    count = count + 1\n    count\n}\n")
    let sk = semantic_key_new(ux2_sv("pkg"), ux2_sv("fix_me"), ITEM_NS_VALUE, 0u32, ux2_sv("inc"), ux2_sv_empty())

    let unsafe_fix = ux2_fix_single(ux2_sv("wrap in unsafe"), Ux2Applicability.MachineApplicable, mk_span(fv, 26u32, 29u32), ux2_sv("unsafe { }"), true)
    let mut_fix = ux2_fix_assign_immutable(mk_span(fv, 26u32, 29u32), ux2_sv("let mut"))
    let rm_unsafe = ux2_fix_unnecessary_unsafe_impl(mk_span(fv, 0u32, 7u32))
    let match_fix = ux2_fix_nonexhaustive_match(mk_span(fv, 26u32, 26u32), ux2_sv("Option.None => 0"))
    let safety_ok = !ux2_validate_fix_safety(view(unsafe_fix), src) &&
        ux2_validate_fix_safety(view(mut_fix), src) &&
        ux2_validate_fix_safety(view(rm_unsafe), src) &&
        ux2_validate_fix_safety(view(match_fix), src)

    let cand = Ux2FixCandidate {
        code: diag_code(AX_TYPE_ASSIGN_IMMUTABLE),
        fingerprint: ux2_compute_fingerprint(diag_code(AX_TYPE_ASSIGN_IMMUTABLE), view(sk), 0u32, mk_span(fv, 26u32, 29u32), 1u64),
        fix: mut_fix,
        resolves_on_iteration: 1u32,
        introduces_new_error: false,
    }
    let mut final_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut out_stdout = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut out_stderr = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(final_buf))
    diag_buf_init(mut_view(out_stdout))
    diag_buf_init(mut_view(out_stderr))

    let mut fcfg = fix_cli_default()
    let _ = fix_cmd_parse_arg(mut_view(fcfg), ux2_sv("--json"))
    let rc_fix = fix_cmd_execute(
        mut_view(*db), mod_id, def_id, view(fcfg), src,
        unsafe { address_of<Ux2FixCandidate>(cand) }, 1u32, 0u32,
        mut_view(final_buf), mut_view(out_stdout), mut_view(out_stderr)
    )
    let converged_ok = rc_fix == 0i32 &&
        ux2_sv_contains(diag_buf_as_str_view(view(final_buf)), ux2_sv("let mut count = 0")) &&
        ux2_sv_contains(diag_buf_as_str_view(view(out_stdout)), ux2_sv("\"applied_fixes\":1"))

    let bad_cand = Ux2FixCandidate {
        code: diag_code(AX_TYPE_ASSIGN_IMMUTABLE),
        fingerprint: cand.fingerprint,
        fix: mut_fix,
        resolves_on_iteration: 1u32,
        introduces_new_error: true,
    }
    let mut rb_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(rb_buf))
    let rb_rep = ux2_apply_fixes_transactional(
        mut_view(*db), mod_id, def_id, view(fcfg.engine), src,
        unsafe { address_of<Ux2FixCandidate>(bad_cand) }, 1u32, 0u32, mut_view(rb_buf)
    )
    let rollback_ok = rb_rep.status == FIX_STATUS_ROLLED_BACK && rb_rep.rolled_back_count == 1u32

    let areas_ok = explain_verify_all_areas_covered()
    let entries = explain_entry_count()
    let mut e_alias = explain_entry_empty()
    let alias_ok = explain_lookup_code(ux2_sv("E_USE_AFTER_MOVE"), mut_view(e_alias)) &&
        ux2_sv_eq(e_alias.code, ux2_sv("AX_MOVE_USE_AFTER_MOVE"))

    out_stdout.len = 0
    out_stderr.len = 0
    let mut ecfg_bad = explain_cli_default()
    let _ = explain_cmd_parse_arg(mut_view(ecfg_bad), ux2_sv("AX_UNKNOWN_CODE_999"))
    let rc_bad = explain_cmd_execute(view(ecfg_bad), mut_view(out_stdout), mut_view(out_stderr))
    let unknown_exit2 = rc_bad == 2i32 && ux2_sv_contains(diag_buf_as_str_view(view(out_stderr)), ux2_sv("AX_DRIVER_USAGE"))

    out_str("probe[fix_and_explain] safety_ok=")
    out_bool(safety_ok)
    out_str(" converged_ok=")
    out_bool(converged_ok)
    out_str(" rollback_ok=")
    out_bool(rollback_ok)
    out_str(" codegen_invoked=")
    out_bool(rb_rep.codegen_invoked)
    out_str(" areas_ok=")
    out_bool(areas_ok)
    out_str(" entries=")
    out_u32(entries)
    out_str(" alias_ok=")
    out_bool(alias_ok)
    out_str(" unknown_exit2=")
    out_bool(unknown_exit2)
    out_str("\n")

    diag_buf_free(mut_view(rb_buf))
    diag_buf_free(mut_view(out_stderr))
    diag_buf_free(mut_view(out_stdout))
    diag_buf_free(mut_view(final_buf))
    safety_ok && converged_ok && rollback_ok && !rb_rep.codegen_invoked && areas_ok && entries == 37u32 && alias_ok && unknown_exit2
}

fn probe_layout_and_meta(db: mut_view<CompilerDB>) -> bool {
    let domain_ok = ai_validate_domain_certainty(FACT_DOMAIN_SEMANTIC, CERTAINTY_PROVEN, false) &&
        ai_validate_domain_certainty(FACT_DOMAIN_SEMANTIC, CERTAINTY_INFERRED, false) &&
        !ai_validate_domain_certainty(FACT_DOMAIN_SEMANTIC, CERTAINTY_PROVEN, true) &&
        ai_validate_domain_certainty(FACT_DOMAIN_LAYOUT_ABI, CERTAINTY_PROVEN, false) &&
        ai_validate_domain_certainty(FACT_DOMAIN_OPTIMIZATION, CERTAINTY_POSSIBLE, true)

    let t0 = TypeId { v: 1u32 }
    let mut out_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut err_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(out_buf))
    diag_buf_init(mut_view(err_buf))

    let mut icfg1 = inspect_layout_cli_default()
    let _ = inspect_layout_parse_arg(mut_view(icfg1), ux2_sv("layout"))
    let _ = inspect_layout_parse_arg(mut_view(icfg1), ux2_sv("PacketHeader"))
    let _ = inspect_layout_parse_arg(mut_view(icfg1), ux2_sv("packet.ax"))
    let rc1 = inspect_layout_execute(mut_view(*db), t0, view(icfg1), mut_view(out_buf), mut_view(err_buf))
    let sv1 = diag_buf_as_str_view(view(out_buf))
    let layout_human = rc1 == 0i32 &&
        ux2_sv_contains(sv1, ux2_sv("Type: packet_proc.PacketHeader")) &&
        ux2_sv_contains(sv1, ux2_sv("size: 16")) &&
        ux2_sv_contains(sv1, ux2_sv("abi_passing: IndirectCallerCopy"))

    out_buf.len = 0
    err_buf.len = 0
    let mut icfg2 = inspect_layout_cli_default()
    let _ = inspect_layout_parse_arg(mut_view(icfg2), ux2_sv("layout"))
    let _ = inspect_layout_parse_arg(mut_view(icfg2), ux2_sv("PaddedRecord"))
    let _ = inspect_layout_parse_arg(mut_view(icfg2), ux2_sv("packet.ax"))
    let _ = inspect_layout_parse_arg(mut_view(icfg2), ux2_sv("--json"))
    let rc2 = inspect_layout_execute(mut_view(*db), t0, view(icfg2), mut_view(out_buf), mut_view(err_buf))
    let sv2 = diag_buf_as_str_view(view(out_buf))
    let layout_json = rc2 == 0i32 &&
        ux2_sv_contains(sv2, ux2_sv("\"codegen_invoked\":false")) &&
        ux2_sv_contains(sv2, ux2_sv("\"fact_domain\":\"layout_abi\"")) &&
        ux2_sv_contains(sv2, ux2_sv("\"padding_bytes\":14"))

    out_buf.len = 0
    err_buf.len = 0
    let mut icfg3 = inspect_layout_cli_default()
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("layout"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("Vec<i32>"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("packet.ax"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("--target"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("wasm32-wasi"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("--json"))
    let rc3 = inspect_layout_execute(mut_view(*db), t0, view(icfg3), mut_view(out_buf), mut_view(err_buf))
    let sv3 = diag_buf_as_str_view(view(out_buf))
    let layout_wasm = rc3 == 0i32 &&
        ux2_sv_contains(sv3, ux2_sv("\"target\":\"wasm32-wasi\"")) &&
        ux2_sv_contains(sv3, ux2_sv("\"size\":12,\"align\":4"))

    let mut axmeta_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(axmeta_buf))
    ai_export_axmeta_container_effects(mut_view(axmeta_buf))
    let meta_sum = ai_inspect_axmeta_container_effects(axmeta_buf.ptr as *const u8, axmeta_buf.len)
    let axmeta_ok = meta_sum.valid_magic && meta_sum.has_effects_sec && meta_sum.has_ai_index_sec &&
        meta_sum.container_count == META_CONTAINER_COUNT &&
        meta_sum.api_effect_count == META_API_EFFECT_COUNT

    out_str("probe[layout_and_meta] domain_ok=")
    out_bool(domain_ok)
    out_str(" layout_human=")
    out_bool(layout_human)
    out_str(" layout_json=")
    out_bool(layout_json)
    out_str(" layout_wasm=")
    out_bool(layout_wasm)
    out_str(" containers=")
    out_u32(meta_sum.container_count)
    out_str(" effects=")
    out_u32(meta_sum.api_effect_count)
    out_str(" axmeta_ok=")
    out_bool(axmeta_ok)
    out_str("\n")

    diag_buf_free(mut_view(axmeta_buf))
    diag_buf_free(mut_view(err_buf))
    diag_buf_free(mut_view(out_buf))
    domain_ok && layout_human && layout_json && layout_wasm && axmeta_ok
}

fn check_single_query(
    db: mut_view<CompilerDB>,
    subcmd: StrView,
    arg0: StrView,
    arg1: StrView,
    expected_substr: StrView
) -> bool {
    let m0 = ModuleId { v: 1u32 }
    let d0 = DefId { v: 1u32 }
    let t0 = TypeId { v: 1u32 }
    let gk = TraitGoalKey { v: 1u32 }
    let mut cfg = query_cli_default()
    let _ = query_cmd_parse_arg(mut_view(cfg), subcmd)
    if arg0.len > 0 {
        let _ = query_cmd_parse_arg(mut_view(cfg), arg0)
    }
    if arg1.len > 0 {
        let _ = query_cmd_parse_arg(mut_view(cfg), arg1)
    }
    let mut out_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut err_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(out_buf))
    diag_buf_init(mut_view(err_buf))
    let rc = query_cmd_execute(
        mut_view(*db), m0, d0, t0, gk, view(cfg),
        0 as *const u8, 0usize,
        mut_view(out_buf), mut_view(err_buf)
    )
    let sv = diag_buf_as_str_view(view(out_buf))
    let ok = rc == 0i32 && ux2_sv_contains(sv, expected_substr) &&
        ux2_sv_contains(sv, ux2_sv("\"codegen_invoked\":false"))
    diag_buf_free(mut_view(err_buf))
    diag_buf_free(mut_view(out_buf))
    ok
}

fn probe_ai_queries_and_gates(db: mut_view<CompilerDB>) -> bool {
    let m0 = ModuleId { v: 1u32 }
    let d0 = DefId { v: 1u32 }
    let empty = ux2_sv("")

    let queries_ok =
        check_single_query(mut_view(*db), ux2_sv("symbol"), ux2_sv("packet_proc.split_payload"), empty, ux2_sv("\"fact_kind\":\"symbol\"")) &&
        check_single_query(mut_view(*db), ux2_sv("type"), ux2_sv("PacketHeader"), empty, ux2_sv("\"copy\":true")) &&
        check_single_query(mut_view(*db), ux2_sv("ownership"), ux2_sv("split_payload"), empty, ux2_sv("\"fact_kind\":\"ownership_lifeline\"")) &&
        check_single_query(mut_view(*db), ux2_sv("capabilities"), ux2_sv("split_payload"), empty, ux2_sv("\"disjoint_status\":\"Disjoint\"")) &&
        check_single_query(mut_view(*db), ux2_sv("trait"), ux2_sv("Metric"), ux2_sv("Pair"), ux2_sv("\"status\":\"Implemented\"")) &&
        check_single_query(mut_view(*db), ux2_sv("trait"), ux2_sv("Send"), ux2_sv("WorkerState"), ux2_sv("\"status\":\"NotImplemented\"")) &&
        check_single_query(mut_view(*db), ux2_sv("container"), ux2_sv("Vec"), empty, ux2_sv("\"storage_kind\":\"HeapContiguous\"")) &&
        check_single_query(mut_view(*db), ux2_sv("container"), ux2_sv("HashMap"), empty, ux2_sv("\"storage_kind\":\"HeapTable\"")) &&
        check_single_query(mut_view(*db), ux2_sv("effects"), ux2_sv("std.collections.Vec.push"), empty, ux2_sv("\"allocates\":\"MayAllocate\"")) &&
        check_single_query(mut_view(*db), ux2_sv("effects"), ux2_sv("std.fs.read_to_string"), empty, ux2_sv("\"FsCap\"")) &&
        check_single_query(mut_view(*db), ux2_sv("effects"), ux2_sv("std.mem.volatile_load"), empty, ux2_sv("\"unsafe_required\":true")) &&
        check_single_query(mut_view(*db), ux2_sv("unsafe-map"), ux2_sv("packet.ax"), empty, ux2_sv("\"fact_kind\":\"unsafe_boundary\"")) &&
        check_single_query(mut_view(*db), ux2_sv("deps"), empty, empty, ux2_sv("\"fact_kind\":\"module_deps\"")) &&
        check_single_query(mut_view(*db), ux2_sv("context"), ux2_sv("packet_proc.split_payload"), empty, ux2_sv("\"fact_kind\":\"ai_context_bundle\"")) &&
        check_single_query(mut_view(*db), ux2_sv("facts"), ux2_sv("packet.ax"), empty, ux2_sv("\"fact_kind\":\"capability_lifeline\"")) &&
        check_single_query(mut_view(*db), ux2_sv("opt-remarks"), ux2_sv("hot_loop"), empty, ux2_sv("\"fact_domain\":\"optimization\""))

    let res_reloc = ai_verify_patch_candidate(mut_view(*db), m0, d0, ux2_sv("fn bad() { let elem = view(v[0]); v.push(4); let x = *elem; }"))
    let res_bypass = ai_verify_patch_candidate(mut_view(*db), m0, d0, ux2_sv("@trust_ai fn hack() { volatile_load(ptr) }"))
    let res_uam = ai_verify_patch_candidate(mut_view(*db), m0, d0, ux2_sv("fn uam() { consume(buf); read_view(view(buf)); }"))
    let res_clean = ai_verify_patch_candidate(mut_view(*db), m0, d0, ux2_sv("pub fn add_pair(a: i32, b: i32) -> i32 { let sum = a + b\n sum }"))

    let patch_reloc_rej = !res_reloc.accepted && res_reloc.primary_code.v == AX_CAP_CONTAINER_RELOC && res_reloc.diag.causal_chain.step_count == 4u32
    let patch_bypass_rej = !res_bypass.accepted && res_bypass.bypass_attempted && res_bypass.primary_code.v == AX_UNSAFE_REQUIRED
    let patch_uam_rej = !res_uam.accepted && res_uam.primary_code.v == AX_MOVE_USE_AFTER_MOVE
    let patch_clean_ok = res_clean.accepted && !res_clean.codegen_invoked && !res_clean.disk_modified && res_clean.error_count == 0u32

    let mut clean_pe = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(clean_pe))
    ai_build_mock_pe_image(false, mut_view(clean_pe))
    let rep_clean = ai_verify_production_binary(clean_pe.ptr as *const u8, clean_pe.len)
    diag_buf_free(mut_view(clean_pe))

    let mut dirty_pe = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(dirty_pe))
    ai_build_mock_pe_image(true, mut_view(dirty_pe))
    let rep_dirty = ai_verify_production_binary(dirty_pe.ptr as *const u8, dirty_pe.len)
    diag_buf_free(mut_view(dirty_pe))

    let pe_clean_ok = rep_clean.is_valid_pe && rep_clean.is_production_clean && rep_clean.leaked_axmeta_count == 0u32 && !rep_clean.requires_runtime_axmeta
    let pe_dirty_rej = rep_dirty.is_valid_pe && !rep_dirty.is_production_clean && rep_dirty.leaked_axmeta_count == 1u32 && rep_dirty.has_leaked_magic && rep_dirty.requires_runtime_axmeta

    out_str("probe[ai_queries_and_gates] queries_ok=")
    out_bool(queries_ok)
    out_str(" patch_reloc_rej=")
    out_bool(patch_reloc_rej)
    out_str(" patch_bypass_rej=")
    out_bool(patch_bypass_rej)
    out_str(" patch_uam_rej=")
    out_bool(patch_uam_rej)
    out_str(" patch_clean_ok=")
    out_bool(patch_clean_ok)
    out_str(" pe_clean_ok=")
    out_bool(pe_clean_ok)
    out_str(" pe_dirty_rej=")
    out_bool(pe_dirty_rej)
    out_str("\n")

    queries_ok && patch_reloc_rej && patch_bypass_rej && patch_uam_rej && patch_clean_ok && pe_clean_ok && pe_dirty_rej
}

pub fn main() -> i32 {
    let mut db = query_db_empty()
    setup_conformance_db(mut_view(db))

    let ok1 = probe_ux2_causal_fp_and_taint()
    let ok2 = probe_fix_and_explain(mut_view(db))
    let ok3 = probe_layout_and_meta(mut_view(db))
    let ok4 = probe_ai_queries_and_gates(mut_view(db))

    query_db_free(mut_view(db))

    if !ok1 || !ok2 || !ok3 || !ok4 {
        return 1
    }
    out_str("E19-4-DIAGNOSTICS-AI-CONFORMANCE-PROBE-PASS\n")
    0
}
