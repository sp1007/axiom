@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn out_u32(v: u32) {
    let mut buf: [16]u8 = [0u8; 16]
    if v == 0u32 {
        buf[0] = 48u8
        let _ = unsafe { write(stdio(1), address_of<u8>(buf[0]), 1) }
        return
    }
    let mut x = v
    let mut n: usize = 0
    while x > 0u32 {
        buf[15 - n] = 48u8 + ((x % 10u32) as u8)
        x = x / 10u32
        n = n + 1
    }
    let _ = unsafe { write(stdio(1), address_of<u8>(buf[16 - n]), n) }
}

fn setup_e19_5_db(db: mut_view<CompilerDB>, src_with_docs: StrView) {
    query_db_init(mut_view(*db), 1u64)
    let sf_id = SourceFileId { v: 1u32 }
    let mod_id = ModuleId { v: 1u32 }
    let st_def = DefId { v: 1u32 }
    let fn_def = DefId { v: 2u32 }
    let _ = query_db_set_source_file_input(
        mut_view(*db),
        sf_id,
        ux2_sv("src/metrics/ring.ax"),
        src_with_docs,
        DURABILITY_LOW
    )
    let _ = query_db_set_module_tree_input(
        mut_view(*db),
        mod_id,
        PackageId { v: 1u32 },
        ModuleId { v: 0u32 },
        ux2_sv("metrics.ring"),
        sf_id,
        DURABILITY_LOW
    )
    let _ = query_db_register_def(
        mut_view(*db),
        st_def,
        mod_id,
        ITEM_KIND_STRUCT,
        true,
        0u32,
        1u32,
        doc_sem_key(ITEM_NS_TYPE, ux2_sv("metrics.ring"), ux2_sv("RingCounter"), ux2_sv("struct"))
    )
    let _ = query_db_register_def(
        mut_view(*db),
        fn_def,
        mod_id,
        ITEM_KIND_FN,
        true,
        1u32,
        2u32,
        doc_sem_key(ITEM_NS_VALUE, ux2_sv("metrics.ring"), ux2_sv("average"), ux2_sv("fn(view<RingCounter>)->i64"))
    )
}

fn probe_docgen_html_json_and_links(db: mut_view<CompilerDB>, src_with_docs: StrView) -> bool {
    let mod_id = ModuleId { v: 1u32 }
    let st_def = DefId { v: 1u32 }
    let fn_def = DefId { v: 2u32 }

    let trace = docgen_eval_semantic_queries_zero_codegen(mut_view(*db), mod_id, fn_def, st_def)
    let zero_codegen = !trace.codegen_invoked &&
        !trace.linker_invoked &&
        trace.parse_module_evaluated == 1u32 &&
        trace.item_signature_evaluated == 2u32 &&
        trace.memoized_hits >= 2u32

    let mut b_in: DiagBuffer = diag_buf_new()
    let mut b_out: DiagBuffer = diag_buf_new()
    let mut b_strip: DiagBuffer = diag_buf_new()
    docgen_extract_inner_doc(src_with_docs, mut_view(b_in))
    docgen_extract_outer_doc(src_with_docs, mut_view(b_out))
    let sv_in = diag_buf_as_str_view(view(b_in))
    let sv_out = diag_buf_as_str_view(view(b_out))
    let sum_in = docgen_split_summary_and_body(sv_in)
    let sum_out = docgen_split_summary_and_body(sv_out)
    let had_hidden = docgen_strip_hidden_setup_lines(
        ux2_sv("# let seed: i64 = 10\nlet c = ring_counter_new()\nassert_eq(seed, 10)"),
        mut_view(b_strip)
    )
    let sv_strip = diag_buf_as_str_view(view(b_strip))
    let extract_ok = ux2_sv_eq(sum_in, ux2_sv("Bounded ring-buffer counters.")) &&
        ux2_sv_contains(sv_in, ux2_sv("Extra module details.")) &&
        ux2_sv_eq(sum_out, ux2_sv("Fixed-capacity ring counter.")) &&
        !ux2_sv_contains(sv_out, ux2_sv("four-slash")) &&
        !ux2_sv_contains(sv_out, ux2_sv("ordinary comment")) &&
        had_hidden &&
        !ux2_sv_contains(sv_strip, ux2_sv("# let seed")) &&
        ux2_sv_contains(sv_strip, ux2_sv("let c = ring_counter_new()"))
    diag_buf_free(mut_view(b_strip))
    diag_buf_free(mut_view(b_out))
    diag_buf_free(mut_view(b_in))

    let mut g = docgen_build_metrics_ring_package(FileId { v: 1u32 })
    let mut sink: DiagSink = diag_sink_new()
    let broken = docgen_resolve_intra_doc_links(mut_view(g), false, mut_view(sink))
    let links_ok = broken == 0u32 &&
        sink.errors == 0usize &&
        sink.warnings == 0usize &&
        g.item_0.kind == DOC_KIND_STRUCT &&
        ux2_sv_eq(g.item_0.name, ux2_sv("RingCounter")) &&
        g.item_1.kind == DOC_KIND_TRAIT &&
        g.item_2.kind == DOC_KIND_FN &&
        g.item_0.has_container_contract &&
        g.item_2.has_effect_summary &&
        g.item_5.param_0.passing_mode == DOC_PASS_MUT_VIEW &&
        g.item_5.param_1.passing_mode == DOC_PASS_COPY &&
        g.item_2.param_0.passing_mode == DOC_PASS_VIEW &&
        g.item_0.link_0.is_resolved &&
        ux2_sv_eq(g.item_0.link_0.resolved_href, ux2_sv("struct.RingCounter.html#method.push_sample"))
    diag_sink_free(mut_view(sink))

    let mut bad_g = docgen_build_negative_doc_package(FileId { v: 2u32 })
    let mut sink_err: DiagSink = diag_sink_new()
    let broken_err = docgen_resolve_intra_doc_links(mut_view(bad_g), true, mut_view(sink_err))
    let mut b_diag: DiagBuffer = diag_buf_new()
    docgen_write_broken_link_diag_json(mut_view(b_diag), ux2_sv("NonExistentType.missing_method"), true)
    let sv_diag = diag_buf_as_str_view(view(b_diag))
    let neg_link_rej = broken_err == 1u32 &&
        sink_err.errors == 1usize &&
        ux2_sv_contains(sv_diag, ux2_sv("\"code_name\":\"AX_NAME_UNRESOLVED\"")) &&
        ux2_sv_contains(sv_diag, ux2_sv("\"context\":\"doc_link\""))
    diag_buf_free(mut_view(b_diag))
    diag_sink_free(mut_view(sink_err))

    let mut html_a: DiagBuffer = diag_buf_new()
    let mut html_b: DiagBuffer = diag_buf_new()
    let mut html_all: DiagBuffer = diag_buf_new()
    docgen_render_html_site(view(g), false, false, mut_view(html_a))
    docgen_render_html_site(view(g), false, false, mut_view(html_b))
    docgen_render_html_site(view(g), true, true, mut_view(html_all))
    let sv_ha = diag_buf_as_str_view(view(html_a))
    let sv_hb = diag_buf_as_str_view(view(html_b))
    let sv_hall = diag_buf_as_str_view(view(html_all))
    let html_det_ok = ux2_sv_eq(sv_ha, sv_hb) &&
        !ux2_sv_contains(sv_ha, ux2_sv("http://")) &&
        !ux2_sv_contains(sv_ha, ux2_sv("https://")) &&
        !ux2_sv_contains(sv_ha, ux2_sv("# let seed")) &&
        !ux2_sv_contains(sv_ha, ux2_sv("internal_slot_index")) &&
        !ux2_sv_contains(sv_ha, ux2_sv("debug_raw_slot")) &&
        ux2_sv_contains(sv_hall, ux2_sv("internal_slot_index")) &&
        ux2_sv_contains(sv_hall, ux2_sv("debug_raw_slot"))
    diag_buf_free(mut_view(html_all))
    diag_buf_free(mut_view(html_b))
    diag_buf_free(mut_view(html_a))

    let mut s_buf: DiagBuffer = diag_buf_new()
    let mut j_buf1: DiagBuffer = diag_buf_new()
    let mut j_buf2: DiagBuffer = diag_buf_new()
    docgen_render_search_index_json(view(g), false, false, mut_view(s_buf))
    docgen_render_doc_graph_json(view(g), false, false, mut_view(j_buf1))
    docgen_render_doc_graph_json(view(g), false, false, mut_view(j_buf2))
    let sv_s = diag_buf_as_str_view(view(s_buf))
    let sv_j1 = diag_buf_as_str_view(view(j_buf1))
    let sv_j2 = diag_buf_as_str_view(view(j_buf2))
    let json_det_ok = ux2_sv_eq(sv_j1, sv_j2) &&
        ux2_sv_contains(sv_s, ux2_sv("\"format\":\"AXDOC_SEARCH\",\"schema_version\":1")) &&
        ux2_sv_contains(sv_j1, ux2_sv("\"format\":\"AXDOC\",\"schema_version\":1")) &&
        ux2_sv_contains(sv_j1, ux2_sv("\"container_contract\":{\"storage_kind\":\"HeapContiguous\"")) &&
        ux2_sv_contains(sv_j1, ux2_sv("\"passing_mode\":\"mut_view\""))
    diag_buf_free(mut_view(j_buf2))
    diag_buf_free(mut_view(j_buf1))
    diag_buf_free(mut_view(s_buf))

    out_str("probe[docgen_html_json_links] zero_codegen=")
    out_bool(zero_codegen)
    out_str(" extract_ok=")
    out_bool(extract_ok)
    out_str(" links_ok=")
    out_bool(links_ok)
    out_str(" neg_link_rej=")
    out_bool(neg_link_rej)
    out_str(" html_det_ok=")
    out_bool(html_det_ok)
    out_str(" json_det_ok=")
    out_bool(json_det_ok)
    out_str("\n")

    zero_codegen && extract_ok && links_ok && neg_link_rej && html_det_ok && json_det_ok
}


fn probe_doctest_and_doc_invariance(
    db: mut_view<CompilerDB>,
    src_with_docs: StrView,
    src_without_docs: StrView,
) -> bool {
    let fn_def = DefId { v: 2u32 }

    let non_sem_inv = docgen_verify_non_semantic_invariance(src_with_docs, src_without_docs)
    let feat_inv = docgen_verify_build_feature_invariance(mut_view(*db), fn_def)

    let mut blk: DocTestBlock = doc_test_block_empty()
    let fence_non_ax = !docgen_parse_fence_info(ux2_sv("json"), mut_view(blk))
    let fence_cf = docgen_parse_fence_info(ux2_sv("axiom,compile_fail(AX_CAP_CONFLICT_MUT)"), mut_view(blk)) &&
        blk.mode == DOC_TEST_COMPILE_FAIL &&
        blk.expected_diag_code == AX_CAP_CONFLICT_MUT
    let fence_sp = docgen_parse_fence_info(ux2_sv("axiom,should_panic(expected = \"empty ring\")"), mut_view(blk)) &&
        blk.mode == DOC_TEST_SHOULD_PANIC &&
        ux2_sv_eq(blk.expected_panic_substr, ux2_sv("empty ring"))

    let mut g = docgen_build_metrics_ring_package(FileId { v: 1u32 })
    let mut h_buf: DiagBuffer = diag_buf_new()
    docgen_synthesize_doctest_harness(ux2_sv("metrics.ring"), g.item_0.doctest_0, mut_view(h_buf))
    let sv_h = diag_buf_as_str_view(view(h_buf))
    let harness_ok = fence_non_ax &&
        fence_cf &&
        fence_sp &&
        ux2_sv_contains(sv_h, ux2_sv("use metrics.ring.*")) &&
        ux2_sv_contains(sv_h, ux2_sv("let seed: i64 = 10")) &&
        !ux2_sv_contains(sv_h, ux2_sv("# let seed"))
    diag_buf_free(mut_view(h_buf))

    let remapped = docgen_remap_doctest_span(g.item_5.doctest_0, 3u32, 10u32)
    let span_remap_ok = remapped.source_line == 38u32 && remapped.source_col == 14u32

    let suite = docgen_run_package_doctests(view(g), false)
    let bad_g = docgen_build_negative_doc_package(FileId { v: 2u32 })
    let bad_suite = docgen_run_package_doctests(view(bad_g), false)

    let mut sink: DiagSink = diag_sink_new()
    let args_ok: [8]StrView = [
        ux2_sv("--out-dir"),
        ux2_sv("build/docs"),
        ux2_sv("--json"),
        ux2_sv("--test"),
        ux2_sv("src/metrics/ring.ax"),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty()
    ]
    let opts_ok = doc_parse_cli_args(view(args_ok), 5usize, mut_view(sink))
    let mut hb: DiagBuffer = diag_buf_new()
    let mut sb: DiagBuffer = diag_buf_new()
    let mut jb: DiagBuffer = diag_buf_new()
    let res_ok = doc_cmd_execute(
        opts_ok,
        mut_view(g),
        mut_view(hb),
        mut_view(sb),
        mut_view(jb),
        mut_view(sink)
    )
    diag_buf_free(mut_view(jb))
    diag_buf_free(mut_view(sb))
    diag_buf_free(mut_view(hb))

    let args_bad: [8]StrView = [
        ux2_sv("--bogus-doc-flag"),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty()
    ]
    let opts_bad = doc_parse_cli_args(view(args_bad), 1usize, mut_view(sink))
    diag_sink_free(mut_view(sink))

    let doc_cli_ok = !opts_ok.has_usage_error &&
        opts_ok.emit_json &&
        opts_ok.run_doctests &&
        res_ok.exit_code == DOC_EXIT_OK &&
        res_ok.emitted_doc_graph_json &&
        res_ok.doctest_passed == 4u32 &&
        opts_bad.has_usage_error &&
        opts_bad.exit_code == DOC_EXIT_USAGE

    out_str("probe[doctest_and_invariance] non_sem_inv=")
    out_bool(non_sem_inv)
    out_str(" feat_inv=")
    out_bool(feat_inv)
    out_str(" harness_ok=")
    out_bool(harness_ok)
    out_str(" span_remap_ok=")
    out_bool(span_remap_ok)
    out_str(" doctests_passed=")
    out_u32(suite.passed_count)
    out_str(" doctests_ignored=")
    out_u32(suite.ignored_count)
    out_str(" neg_cf_failed=")
    out_u32(bad_suite.failed_count)
    out_str(" doc_cli_ok=")
    out_bool(doc_cli_ok)
    out_str("\n")

    non_sem_inv && feat_inv && harness_ok && span_remap_ok &&
        suite.total_blocks == 5u32 && suite.passed_count == 4u32 &&
        suite.ignored_count == 1u32 && suite.failed_count == 0u32 &&
        bad_suite.failed_count == 1u32 && doc_cli_ok
}

fn probe_test_runner_diff_and_bisect(db: mut_view<CompilerDB>) -> bool {
    let mod_id = ModuleId { v: 1u32 }
    let fn_def = DefId { v: 2u32 }
    let iso = test_runner_verify_binary_isolation_and_feature_invariance(mut_view(*db), mod_id, fn_def)
    let tid1 = test_runner_compute_test_id(ux2_sv("metrics.ring"), ux2_sv("ring counter"))
    let tid2 = test_runner_compute_test_id(ux2_sv("metrics.ring"), ux2_sv("ring counter"))
    let tid3 = test_runner_compute_test_id(ux2_sv("metrics.math"), ux2_sv("ring counter"))
    let mut tmp_buf: DiagBuffer = diag_buf_new()
    test_runner_format_tempdir(tid1, mut_view(tmp_buf))
    let tmp_sv = diag_buf_as_str_view(view(tmp_buf))
    let isolation_ok = !iso.prod_binary_has_test_blocks &&
        !iso.prod_binary_has_test_harness &&
        !iso.prod_binary_has_test_strings &&
        !iso.core_semantics_altered_by_features &&
        iso.ownership_rules_identical &&
        iso.view_cap_rules_identical &&
        iso.overflow_semantics_identical &&
        iso.drop_order_identical &&
        iso.send_share_rules_identical &&
        iso.ast_body_abi_fingerprints_identical &&
        !iso.debug_assert_creates_ub_hint &&
        fingerprint128_eq(tid1, tid2) &&
        !fingerprint128_eq(tid1, tid3) &&
        ux2_sv_contains(tmp_sv, ux2_sv("target/test-tmp/")) &&
        tmp_sv.len == 49usize
    diag_buf_free(mut_view(tmp_buf))

    let cases_a: [8]DiscoveredTestCase = test_runner_build_demo_cases(FileId { v: 1u32 })
    let mut cases_b: [8]DiscoveredTestCase = test_runner_build_demo_cases(FileId { v: 1u32 })
    let swap_tmp = cases_b[0]
    cases_b[0] = cases_b[3]
    cases_b[3] = swap_tmp
    let suite_j1 = test_runner_execute_suite(view(cases_a), 4usize, ux2_sv_empty(), 12345u64, 1u32, false)
    let suite_j4 = test_runner_execute_suite(view(cases_b), 4usize, ux2_sv_empty(), 12345u64, 4u32, false)
    let suite_filt = test_runner_execute_suite(view(cases_a), 4usize, ux2_sv("metrics.math"), 12345u64, 1u32, false)
    let mut json_a: DiagBuffer = diag_buf_new()
    let mut json_b: DiagBuffer = diag_buf_new()
    test_runner_render_suite_json(view(suite_j1), mut_view(json_a))
    test_runner_render_suite_json(view(suite_j4), mut_view(json_b))
    let parallel_det_ok = ux2_sv_eq(diag_buf_as_str_view(view(json_a)), diag_buf_as_str_view(view(json_b))) &&
        suite_j1.passed_count == 3u32 &&
        suite_j1.ignored_count == 1u32 &&
        suite_j1.failed_count == 0u32 &&
        suite_filt.matched_filter_count == 2u32 &&
        suite_filt.passed_count == 2u32
    diag_buf_free(mut_view(json_b))
    diag_buf_free(mut_view(json_a))

    let mut o_interp: ObservableOutcome = observable_outcome_empty()
    o_interp.exit_code = 0i32
    o_interp.return_value = 20i64
    o_interp.stdout_bytes = ux2_sv("avg=20\n")
    o_interp.drop_sequence = ux2_sv("drop(c)->drop(b)->drop(a)")
    let o_native_o0: ObservableOutcome = o_interp
    let o_native_o2_ok: ObservableOutcome = o_interp
    let mut o_native_o2_bad: ObservableOutcome = o_interp
    o_native_o2_bad.exit_code = 42i32
    o_native_o2_bad.return_value = 42i64
    let d_ok = test_runner_compare_differential(
        ux2_sv("metrics.ring.average"),
        ux2_sv("-O2"),
        view(o_interp),
        view(o_native_o0),
        view(o_native_o2_ok)
    )
    let d_div = test_runner_compare_differential(
        ux2_sv("bisect_demo.compute_window"),
        ux2_sv("-O2"),
        view(o_interp),
        view(o_native_o0),
        view(o_native_o2_bad)
    )
    let diff_ok = d_ok.equivalent &&
        !d_ok.handoff_to_opt_bisect &&
        !d_div.equivalent &&
        d_div.handoff_to_opt_bisect &&
        ux2_sv_eq(d_div.mismatch_field, ux2_sv("exit_code")) &&
        test_runner_verify_zero_oracle_runtime_overhead(ux2_sv("sections=[.text,.rdata,.pdata,.xdata]")) &&
        !test_runner_verify_zero_oracle_runtime_overhead(ux2_sv("sections=[.text,.axmir,__ax_interp_eval]")) &&
        !d_ok.prod_embeds_interp_or_oracle &&
        !d_ok.prod_requires_axmir_or_sidecar

    let pipe = opt_bisect_build_seeded_demo_pipeline(FileId { v: 2u32 })
    let cfg5 = opt_bisect_config_with_limit(5u32)
    let out5 = opt_bisect_eval_pipeline_at_limit(view(pipe), view(cfg5))
    let cfg6 = opt_bisect_config_with_limit(6u32)
    let out6 = opt_bisect_eval_pipeline_at_limit(view(pipe), view(cfg6))
    let rep = opt_bisect_run_binary_search(view(pipe), ux2_sv("target/opt-bisect/bisect_demo.replay.json"))
    let manifest = opt_replay_from_bisect_report(view(pipe), view(rep))
    let mut m_buf: DiagBuffer = diag_buf_new()
    let mut err_buf: DiagBuffer = diag_buf_new()
    opt_replay_export_manifest_json(view(manifest), mut_view(m_buf))
    let r_res = opt_replay_execute(view(manifest), view(pipe), true, mut_view(err_buf))
    let mut bad_manifest = manifest
    bad_manifest.inject_unverified_ir_fault = true
    let r_ice = opt_replay_execute(view(bad_manifest), view(pipe), true, mut_view(err_buf))
    let replay_ok = out5.matches_oracle &&
        !out6.matches_oracle &&
        rep.found_culprit &&
        rep.culprit_step_id == 6u32 &&
        rep.evaluations_run == 4u32 &&
        ux2_sv_eq(rep.culprit_pass_name, ux2_sv("gvn")) &&
        r_res.reproduced_divergence &&
        r_res.matches_oracle_at_prev_step &&
        r_res.post_pass_contracts_verified &&
        r_res.workspace_files_accessed == 0u32
    let ice_verify_ok = r_ice.exit_code == BISECT_EXIT_ICE_VERIFY &&
        ux2_sv_contains(diag_buf_as_str_view(view(err_buf)), ux2_sv("AX_ICE_MIR_VERIFY"))
    diag_buf_free(mut_view(err_buf))
    diag_buf_free(mut_view(m_buf))

    out_str("probe[test_diff_and_bisect] isolation_ok=")
    out_bool(isolation_ok)
    out_str(" parallel_det_ok=")
    out_bool(parallel_det_ok)
    out_str(" diff_ok=")
    out_bool(diff_ok)
    out_str(" handoff_bisect=")
    out_bool(d_div.handoff_to_opt_bisect)
    out_str(" culprit_step=")
    out_u32(rep.culprit_step_id)
    out_str(" evals=")
    out_u32(rep.evaluations_run)
    out_str(" replay_ok=")
    out_bool(replay_ok)
    out_str(" ice_verify_ok=")
    out_bool(ice_verify_ok)
    out_str("\n")

    isolation_ok && parallel_det_ok && diff_ok && replay_ok && ice_verify_ok
}

fn probe_debug_trace_and_test_cli() -> bool {
    let o0_mod = test_runner_build_o0_debug_model(FileId { v: 1u32 })
    let o2_mod = test_runner_build_o2_inlined_debug_model(FileId { v: 1u32 })
    let dis_tr = test_runner_build_disabled_trace_audit()
    let ena_tr = test_runner_build_enabled_trace_audit()
    let audit = test_runner_audit_debug_and_trace(view(o0_mod), view(o2_mod), view(dis_tr), view(ena_tr))

    let mut sec_pe: DiagBuffer = diag_buf_new()
    let mut sec_elf: DiagBuffer = diag_buf_new()
    let mut sec_macho: DiagBuffer = diag_buf_new()
    test_runner_project_debug_container_sections(ux2_sv("x86_64-windows"), DEBUG_TIER_LINE_TABLES_O0, mut_view(sec_pe))
    test_runner_project_debug_container_sections(ux2_sv("x86_64-linux"), DEBUG_TIER_FULL_DWARF, mut_view(sec_elf))
    test_runner_project_debug_container_sections(ux2_sv("aarch64-macos"), DEBUG_TIER_LINE_TABLES_O0, mut_view(sec_macho))
    let target_indep = audit.semantic_model_target_independent &&
        ux2_sv_contains(diag_buf_as_str_view(view(sec_pe)), ux2_sv(".debug_line")) &&
        ux2_sv_contains(diag_buf_as_str_view(view(sec_elf)), ux2_sv(".debug_info")) &&
        ux2_sv_contains(diag_buf_as_str_view(view(sec_macho)), ux2_sv("__DWARF.__debug_line"))
    diag_buf_free(mut_view(sec_macho))
    diag_buf_free(mut_view(sec_elf))
    diag_buf_free(mut_view(sec_pe))

    let mut sink: DiagSink = diag_sink_new()
    let args_ok: [8]StrView = [
        ux2_sv("--diff"),
        ux2_sv("--audit-debug"),
        ux2_sv("--jobs=4"),
        ux2_sv("--seed=999"),
        ux2_sv("--format=json"),
        ux2_sv("metrics.ring"),
        ux2_sv_empty(),
        ux2_sv_empty()
    ]
    let opts_ok = test_parse_cli_args(view(args_ok), 6usize, mut_view(sink))
    let cases = test_runner_build_demo_cases(FileId { v: 1u32 })
    let pipe = opt_bisect_build_seeded_demo_pipeline(FileId { v: 2u32 })
    let brep = opt_bisect_run_binary_search(view(pipe), ux2_sv("target/opt-bisect/bisect_demo.replay.json"))
    let rman = opt_replay_from_bisect_report(view(pipe), view(brep))
    let mut out_stdout: DiagBuffer = diag_buf_new()
    let mut out_stderr: DiagBuffer = diag_buf_new()
    let cmd_res = test_cmd_execute(
        view(opts_ok),
        view(cases),
        4usize,
        view(pipe),
        view(rman),
        view(o0_mod),
        view(o2_mod),
        view(dis_tr),
        view(ena_tr),
        mut_view(out_stdout),
        mut_view(out_stderr)
    )
    let args_bad: [8]StrView = [
        ux2_sv("--unknown-test-flag"),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty()
    ]
    let opts_bad = test_parse_cli_args(view(args_bad), 1usize, mut_view(sink))
    diag_buf_free(mut_view(out_stderr))
    diag_buf_free(mut_view(out_stdout))
    diag_sink_free(mut_view(sink))

    let test_cli_ok = cmd_res.exit_code == TEST_EXIT_OK &&
        cmd_res.tests_passed == 1u32 &&
        cmd_res.debug_audit_ran &&
        cmd_res.debug_audit_passed &&
        opts_bad.has_usage_error &&
        opts_bad.exit_code == TEST_EXIT_USAGE

    out_str("probe[debug_trace_and_cli] target_indep=")
    out_bool(target_indep)
    out_str(" o0_line_ok=")
    out_bool(audit.o0_debug_line_complete_and_monotonic)
    out_str(" tiered_dwarf_ok=")
    out_bool(audit.tiered_dwarf_sections_valid && audit.logical_inline_frames_accurate)
    out_str(" inline_frames=")
    out_u32(o2_mod.logical_frame_count)
    out_str(" opt_out_honest=")
    out_bool(audit.optimized_out_honest_zero_codegen_drift)
    out_str(" trace_zero_cost=")
    out_bool(audit.disabled_trace_zero_cost && audit.enabled_trace_deterministic)
    out_str(" test_cli_ok=")
    out_bool(test_cli_ok)
    out_str("\n")

    audit.all_passed && target_indep && test_cli_ok
}

pub fn main() -> i32 {
    let src_with_docs = ux2_sv("//! Bounded ring-buffer counters.\n//!\n//! Extra module details.\n//// four-slash comment\n/// Fixed-capacity ring counter.\n///\n/// Tracks rolling samples.\n// ordinary comment\npub struct RingCounter { pub sum: i64 }\npub fn average(c: view<RingCounter>) -> i64 { c.sum }\n")
    let src_without_docs = ux2_sv("pub struct RingCounter { pub sum: i64 }\npub fn average(c: view<RingCounter>) -> i64 { c.sum }\n")

    let mut db: CompilerDB = query_db_empty()
    setup_e19_5_db(mut_view(db), src_with_docs)

    let ok1 = probe_docgen_html_json_and_links(mut_view(db), src_with_docs)
    let ok2 = probe_doctest_and_doc_invariance(mut_view(db), src_with_docs, src_without_docs)
    let ok3 = probe_test_runner_diff_and_bisect(mut_view(db))
    let ok4 = probe_debug_trace_and_test_cli()
    query_db_free(mut_view(db))

    if !ok1 || !ok2 || !ok3 || !ok4 {
        return 1
    }
    out_str("E19-5-DOCGEN-TEST-UX-CONFORMANCE-PROBE-PASS\n")
    0
}
