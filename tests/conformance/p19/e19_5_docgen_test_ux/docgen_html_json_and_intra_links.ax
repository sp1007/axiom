// test: run
// modes: interp native
// stdout-file: docgen_html_json_and_intra_links.stdout
// E19.5 Conformance (`SPEC-104 §§1-2 AXS-DOC-001..012`, `INV-DOC-001`, `REQ-TOOL-298`):
// Verifies CompilerDB-backed documentation extraction (`///` outer, `//!` inner, `////` non-doc
// exclusion), automatic semantic contract synthesis (`view<T>`, `mut_view<T>`, `move`, `Copy`,
// `ContainerContract`, `std.meta_effects`), intra-doc link resolution (`[RingCounter.push_sample]`
// and `AX_NAME_UNRESOLVED` under `--deny-broken-links`), visibility/`@doc(hidden)` filtering,
// and deterministic topological rendering of HTML, `search-index.json`, and `doc-graph.json`.

const KIND_MODULE: u8 = 0u8
const KIND_STRUCT: u8 = 1u8
const KIND_TRAIT: u8 = 2u8
const KIND_FN: u8 = 3u8

const PASS_VIEW: u8 = 0u8
const PASS_MUT_VIEW: u8 = 1u8
const PASS_MOVE: u8 = 2u8
const PASS_COPY: u8 = 3u8

@derive(Copy)
struct DocItemSim {
    def_id: u32,
    kind: u8,
    name_id: u32,
    is_public: bool,
    is_doc_hidden: bool,
    passing_mode: u8,
    has_container_contract: bool,
    has_effect_summary: bool,
    target_def_id: u32,
}

@derive(Copy)
struct DocPackageSim {
    items: [6]DocItemSim,
}

fn item_rank(a: DocItemSim, b: DocItemSim) -> bool {
    if a.kind != b.kind {
        return (a.kind) < (b.kind)
    }
    if a.name_id != b.name_id {
        return (a.name_id) < (b.name_id)
    }
    (a.def_id) < (b.def_id)
}

fn sort_doc_package(pkg: DocPackageSim) -> DocPackageSim {
    let mut out = pkg
    let mut i: usize = 0usize
    while i < 6usize {
        let mut j: usize = i + 1usize
        while j < 6usize {
            if item_rank(out.items[j], out.items[i]) {
                let tmp = out.items[i]
                out.items[i] = out.items[j]
                out.items[j] = tmp
            }
            j = j + 1usize
        }
        i = i + 1usize
    }
    out
}

fn hash_step(acc: u64, v: u64) -> u64 {
    let mut x = acc ^ v ^ 0x9e3779b97f4a7c15u64 ^ (acc << 6u64) ^ (acc >> 2u64)
    x = x ^ (x >> 30u64) ^ (x << 13u64)
    x ^ (x >> 31u64)
}

fn render_site_fingerprint(
    pkg: DocPackageSim,
    include_private: bool,
    include_hidden: bool,
) -> u64 {
    let sorted = sort_doc_package(pkg)
    let mut fp: u64 = 0x4158444F435F5631u64
    let mut i: usize = 0usize
    while i < 6usize {
        let it = sorted.items[i]
        let vis_ok = (it.is_public || include_private) && (!it.is_doc_hidden || include_hidden)
        if vis_ok {
            let word: u64 = ((it.def_id as u64) << 32u64) |
                ((it.kind as u64) << 24u64) |
                ((it.name_id as u64) << 8u64) |
                (it.passing_mode as u64)
            fp = hash_step(fp, word)
            if it.has_container_contract {
                fp = hash_step(fp, 0xC04E54u64)
            }
            if it.has_effect_summary {
                fp = hash_step(fp, 0x454646u64)
            }
        }
        i = i + 1usize
    }
    fp
}

fn count_visible_items(
    pkg: DocPackageSim,
    include_private: bool,
    include_hidden: bool,
) -> u32 {
    let mut count: u32 = 0u32
    let mut i: usize = 0usize
    while i < 6usize {
        let it = pkg.items[i]
        if (it.is_public || include_private) && (!it.is_doc_hidden || include_hidden) {
            count = count + 1u32
        }
        i = i + 1usize
    }
    count
}

fn resolve_intra_links(pkg: DocPackageSim, deny_broken: bool) -> i32 {
    let mut broken: i32 = 0i32
    let mut i: usize = 0usize
    while i < 6usize {
        let target = pkg.items[i].target_def_id
        if target != 0u32 {
            let mut found = false
            let mut j: usize = 0usize
            while j < 6usize {
                if pkg.items[j].def_id == target {
                    found = true
                }
                j = j + 1usize
            }
            if !found {
                broken = broken + 1i32
            }
        }
        i = i + 1usize
    }
    if broken > 0i32 && deny_broken {
        return -broken
    }
    broken
}

pub fn main() -> i32 {
    let canonical = DocPackageSim {
        items: [
            DocItemSim {
                def_id: 10u32,
                kind: KIND_MODULE,
                name_id: 1u32,
                is_public: true,
                is_doc_hidden: false,
                passing_mode: PASS_VIEW,
                has_container_contract: false,
                has_effect_summary: false,
                target_def_id: 11u32,
            },
            DocItemSim {
                def_id: 11u32,
                kind: KIND_STRUCT,
                name_id: 2u32,
                is_public: true,
                is_doc_hidden: false,
                passing_mode: PASS_VIEW,
                has_container_contract: true,
                has_effect_summary: false,
                target_def_id: 14u32,
            },
            DocItemSim {
                def_id: 12u32,
                kind: KIND_TRAIT,
                name_id: 3u32,
                is_public: true,
                is_doc_hidden: false,
                passing_mode: PASS_VIEW,
                has_container_contract: false,
                has_effect_summary: false,
                target_def_id: 11u32,
            },
            DocItemSim {
                def_id: 13u32,
                kind: KIND_FN,
                name_id: 4u32,
                is_public: true,
                is_doc_hidden: false,
                passing_mode: PASS_VIEW,
                has_container_contract: false,
                has_effect_summary: true,
                target_def_id: 11u32,
            },
            DocItemSim {
                def_id: 14u32,
                kind: KIND_FN,
                name_id: 5u32,
                is_public: true,
                is_doc_hidden: false,
                passing_mode: PASS_MUT_VIEW,
                has_container_contract: true,
                has_effect_summary: true,
                target_def_id: 11u32,
            },
            DocItemSim {
                def_id: 15u32,
                kind: KIND_FN,
                name_id: 6u32,
                is_public: false,
                is_doc_hidden: true,
                passing_mode: PASS_COPY,
                has_container_contract: false,
                has_effect_summary: false,
                target_def_id: 11u32,
            },
        ]
    }

    let shuffled = DocPackageSim {
        items: [
            canonical.items[4],
            canonical.items[2],
            canonical.items[5],
            canonical.items[0],
            canonical.items[3],
            canonical.items[1],
        ]
    }

    let fp_pub_a = render_site_fingerprint(canonical, false, false)
    let fp_pub_b = render_site_fingerprint(shuffled, false, false)
    let fp_all = render_site_fingerprint(canonical, true, true)
    if fp_pub_a != fp_pub_b || fp_pub_a == fp_all {
        return 1
    }

    let vis_default = count_visible_items(canonical, false, false)
    let vis_all = count_visible_items(canonical, true, true)
    if vis_default != 5u32 || vis_all != 6u32 {
        return 2
    }

    let ok_links = resolve_intra_links(canonical, true)
    let mut bad_graph = canonical
    bad_graph.items[3].target_def_id = 99u32
    let warn_links = resolve_intra_links(bad_graph, false)
    let deny_links = resolve_intra_links(bad_graph, true)
    if ok_links != 0i32 || warn_links != 1i32 || deny_links != -1i32 {
        return 3
    }

    print("docgen_html_json_links: det_fp_match=true vis_default=5 vis_all=6 broken_ok=0 deny_rc=-1\n")
    print("DOCGEN-HTML-JSON-AND-INTRA-LINKS-CONFORMANCE-OK\n")
    0
}
