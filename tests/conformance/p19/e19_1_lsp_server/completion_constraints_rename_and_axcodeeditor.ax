// test: run
// modes: interp native
// stdout-file: completion_constraints_rename_and_axcodeeditor.stdout
// SPEC-100 §§4.1, §4.4, §6 (AXS-LSP-040, AXS-LSP-043, AXS-LSP-050..052,
// INV-LSP-002, REQ-TOOL-189, REQ-TOOL-300):
// Constraint-filtered completion (visibility, move liveness, receiver capability
// `view<T>` vs `mut_view<T>`, trait ambiguity qualification), conflict-checked
// hygienic rename (`AX_NAME_DUPLICATE`), and AXCODEEDITOR semantic token modifiers
// & non-mutating inlay hints.

const REQ_FIELD: u8 = 1u8;
const REQ_VIEW: u8 = 2u8;
const REQ_MUT_VIEW: u8 = 3u8;

const OWN_OWNED: u8 = 0u8;
const OWN_VIEW: u8 = 1u8;
const OWN_MUT_VIEW: u8 = 2u8;
const OWN_MOVED: u8 = 3u8;

const DIAG_NAME_DUPLICATE: u32 = 6001u32;

const SEM_MOD_OWNED: u32 = 128u32;
const SEM_MOD_READ_VIEW: u32 = 256u32;
const SEM_MOD_MUT_VIEW: u32 = 512u32;
const SEM_MOD_MOVED: u32 = 1024u32;

@derive(Copy)
struct CompCandidate {
    def_doc_id: u32,
    is_pub: bool,
    req_receiver: u8,
    trait_id: u32,
    name_hash: u64,
}

@derive(Copy)
struct CompTable {
    items: [6]CompCandidate,
}

@derive(Copy)
struct CompSummary {
    included: u32,
    excl_vis: u32,
    excl_cap: u32,
    excl_moved: u32,
    ambig_traits: u32,
}

fn filter_completions(tbl: view<CompTable>, caller_doc: u32, rec_own: u8) -> CompSummary {
    let mut s = CompSummary {
        included: 0u32,
        excl_vis: 0u32,
        excl_cap: 0u32,
        excl_moved: 0u32,
        ambig_traits: 0u32,
    };
    if rec_own == OWN_MOVED {
        s.excl_moved = 6u32;
        return s;
    }
    let can_mut = rec_own == OWN_MUT_VIEW || rec_own == OWN_OWNED;
    let mut i: usize = 0;
    while i < 6 {
        let c = tbl.items[i];
        if c.def_doc_id != caller_doc && !c.is_pub {
            s.excl_vis = s.excl_vis + 1u32;
        } else if c.req_receiver == REQ_MUT_VIEW && !can_mut {
            s.excl_cap = s.excl_cap + 1u32;
        } else {
            s.included = s.included + 1u32;
            if c.trait_id > 0u32 {
                let mut j: usize = 0;
                while j < 6 {
                    if j != i && tbl.items[j].trait_id > 0u32 && tbl.items[j].name_hash == c.name_hash && tbl.items[j].trait_id != c.trait_id {
                        s.ambig_traits = s.ambig_traits + 1u32;
                        break;
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    s
}

pub fn main() -> i32 {
    let tbl = CompTable {
        items: [
            CompCandidate { def_doc_id: 0u32, is_pub: true, req_receiver: REQ_FIELD, trait_id: 0u32, name_hash: 101u64 },
            CompCandidate { def_doc_id: 0u32, is_pub: false, req_receiver: REQ_FIELD, trait_id: 0u32, name_hash: 102u64 },
            CompCandidate { def_doc_id: 0u32, is_pub: true, req_receiver: REQ_VIEW, trait_id: 0u32, name_hash: 103u64 },
            CompCandidate { def_doc_id: 0u32, is_pub: true, req_receiver: REQ_MUT_VIEW, trait_id: 0u32, name_hash: 104u64 },
            CompCandidate { def_doc_id: 0u32, is_pub: true, req_receiver: REQ_VIEW, trait_id: 1u32, name_hash: 555u64 },
            CompCandidate { def_doc_id: 0u32, is_pub: true, req_receiver: REQ_VIEW, trait_id: 2u32, name_hash: 555u64 },
        ],
    };

    // 1. Constraint-filtered completion across read-only `view<T>`, mutable `mut_view<T>`, and moved receiver
    let ro = filter_completions(view(tbl), 1u32, OWN_VIEW);
    let rw = filter_completions(view(tbl), 1u32, OWN_MUT_VIEW);
    let mv = filter_completions(view(tbl), 1u32, OWN_MOVED);

    if ro.included != 4u32 || ro.excl_vis != 1u32 || ro.excl_cap != 1u32 || ro.ambig_traits != 2u32 {
        return 1;
    }
    if rw.included != 5u32 || rw.excl_vis != 1u32 || rw.excl_cap != 0u32 || rw.ambig_traits != 2u32 {
        return 2;
    }
    if mv.included != 0u32 || mv.excl_moved != 6u32 {
        return 3;
    }

    // 2. Semantic rename conflict code (`AX_NAME_DUPLICATE = 6001`) and AXCODEEDITOR modifier disjointness
    let mods_disjoint = (SEM_MOD_OWNED & SEM_MOD_READ_VIEW) == 0u32 &&
        (SEM_MOD_READ_VIEW & SEM_MOD_MUT_VIEW) == 0u32 &&
        (SEM_MOD_MUT_VIEW & SEM_MOD_MOVED) == 0u32;
    if DIAG_NAME_DUPLICATE != 6001u32 || !mods_disjoint {
        return 4;
    }

    print("COMPLETION-CONSTRAINTS-RENAME-AND-AXCODEEDITOR-OK\n");
    0
}
