// test: run
// modes: interp native
// stdout-file: end_to_end_lsp_session_and_zero_codegen.stdout
// SPEC-100 §§1..2, §4.2..4.3, §7..8 (AXS-LSP-001, AXS-LSP-004, AXS-LSP-010..011,
// AXS-LSP-041..042, AXS-LSP-060..063, INV-LSP-001..003, REQ-TOOL-183, REQ-TOOL-185,
// REQ-TOOL-297..298):
// End-to-end LSP 3.17 JSON-RPC session lifecycle (`initialize` -> `initialized` ->
// `didOpen` -> `didChange` -> `hover` -> `definition` -> `typeDefinition` ->
// `implementation` -> `references` -> `documentSymbol` -> `workspace/symbol` ->
// `$/cancelRequest` -> `shutdown` -> `exit`) and the zero-backend-codegen firewall.

const STATE_UNINITIALIZED: u8 = 0u8;
const STATE_INITIALIZING: u8 = 1u8;
const STATE_RUNNING: u8 = 2u8;
const STATE_SHUTTING_DOWN: u8 = 3u8;
const STATE_EXITED: u8 = 4u8;

const ERR_NONE: i32 = 0i32;
const ERR_PARSE_ERROR: i32 = -32700i32;
const ERR_INVALID_REQUEST: i32 = -32600i32;
const ERR_SERVER_NOT_INITIALIZED: i32 = -32002i32;
const ERR_REQUEST_CANCELLED: i32 = -32800i32;

@derive(Copy)
struct InflightQuery {
    active: bool,
    cancelled: bool,
    superseded: bool,
    req_id: i64,
    bound_revision: u64,
}

@derive(Copy)
struct SemanticNode {
    doc_id: u32,
    start_byte: u32,
    end_byte: u32,
    symbol_id: u32,
    type_id: u32,
    is_decl: bool,
    size_bytes: u32,
    align_bytes: u32,
    dispatch_mode: u8,
}

struct SessionHarness {
    state: u8,
    revision: u64,
    exit_code: i32,
    codegen_invocations: u32,
    queries_served: u32,
    inflight: [8]InflightQuery,
    nodes: [5]SemanticNode,
}

fn dispatch_read_query(s: mut_view<SessionHarness>, req_id: i64, slot: usize) -> i32 {
    if s.state == STATE_UNINITIALIZED {
        return ERR_SERVER_NOT_INITIALIZED;
    }
    if s.state == STATE_SHUTTING_DOWN || s.state == STATE_EXITED {
        return ERR_INVALID_REQUEST;
    }
    s.inflight[slot] = InflightQuery {
        active: true,
        cancelled: false,
        superseded: false,
        req_id: req_id,
        bound_revision: s.revision,
    };
    s.queries_served = s.queries_served + 1u32;
    ERR_NONE
}

fn apply_did_change(s: mut_view<SessionHarness>) {
    s.revision = s.revision + 1u64;
    let mut i: usize = 0;
    while i < 8 {
        if s.inflight[i].active && (s.inflight[i].bound_revision) < (s.revision) {
            s.inflight[i].superseded = true;
        }
        i = i + 1;
    }
}

fn cancel_inflight(s: mut_view<SessionHarness>, target_id: i64) {
    let mut i: usize = 0;
    while i < 8 {
        if s.inflight[i].active && s.inflight[i].req_id == target_id {
            s.inflight[i].cancelled = true;
        }
        i = i + 1;
    }
}

fn complete_read_query(s: view<SessionHarness>, slot: usize) -> i32 {
    if s.inflight[slot].cancelled || s.inflight[slot].superseded {
        return ERR_REQUEST_CANCELLED;
    }
    ERR_NONE
}

fn resolve_definition_doc(s: view<SessionHarness>, use_idx: usize) -> u32 {
    let sym = s.nodes[use_idx].symbol_id;
    let mut i: usize = 0;
    while i < 5 {
        if s.nodes[i].is_decl && s.nodes[i].symbol_id == sym {
            return s.nodes[i].doc_id;
        }
        i = i + 1;
    }
    99u32
}

fn count_references(s: view<SessionHarness>, sym: u32, include_decl: bool) -> u32 {
    let mut cnt: u32 = 0u32;
    let mut i: usize = 0;
    while i < 5 {
        if s.nodes[i].symbol_id == sym && (include_decl || !s.nodes[i].is_decl) {
            cnt = cnt + 1u32;
        }
        i = i + 1;
    }
    cnt
}

pub fn main() -> i32 {
    let mut s = SessionHarness {
        state: STATE_UNINITIALIZED,
        revision: 1u64,
        exit_code: -1i32,
        codegen_invocations: 0u32,
        queries_served: 0u32,
        inflight: [InflightQuery {
            active: false,
            cancelled: false,
            superseded: false,
            req_id: 0i64,
            bound_revision: 0u64,
        }; 8],
        nodes: [
            SemanticNode { doc_id: 0u32, start_byte: 15u32, end_byte: 21u32, symbol_id: 10u32, type_id: 100u32, is_decl: true, size_bytes: 24u32, align_bytes: 8u32, dispatch_mode: 0u8 },
            SemanticNode { doc_id: 0u32, start_byte: 59u32, end_byte: 63u32, symbol_id: 20u32, type_id: 200u32, is_decl: true, size_bytes: 8u32, align_bytes: 8u32, dispatch_mode: 1u8 },
            SemanticNode { doc_id: 1u32, start_byte: 8u32, end_byte: 14u32, symbol_id: 10u32, type_id: 100u32, is_decl: false, size_bytes: 24u32, align_bytes: 8u32, dispatch_mode: 0u8 },
            SemanticNode { doc_id: 1u32, start_byte: 39u32, end_byte: 42u32, symbol_id: 30u32, type_id: 100u32, is_decl: true, size_bytes: 24u32, align_bytes: 8u32, dispatch_mode: 0u8 },
            SemanticNode { doc_id: 1u32, start_byte: 56u32, end_byte: 60u32, symbol_id: 20u32, type_id: 200u32, is_decl: false, size_bytes: 8u32, align_bytes: 8u32, dispatch_mode: 1u8 },
        ],
    };

    // 1. Pre-initialize request rejected with -32002 (`ServerNotInitialized`)
    if dispatch_read_query(mut_view(s), 1i64, 0) != ERR_SERVER_NOT_INITIALIZED {
        return 1;
    }

    // 2. Transition `initialize` -> `initialized` -> `RUNNING`
    s.state = STATE_INITIALIZING;
    s.state = STATE_RUNNING;

    // 3. Cross-module `hover`, `definition`, and `references`
    if dispatch_read_query(mut_view(s), 2i64, 0) != ERR_NONE || complete_read_query(view(s), 0) != ERR_NONE {
        return 2;
    }
    if s.nodes[3].size_bytes != 24u32 || s.nodes[3].align_bytes != 8u32 || s.nodes[4].dispatch_mode != 1u8 {
        return 3;
    }
    if resolve_definition_doc(view(s), 4) != 0u32 || count_references(view(s), 10u32, true) != 2u32 || count_references(view(s), 10u32, false) != 1u32 {
        return 4;
    }

    // 4. Explicit cancellation (`$/cancelRequest`) and revision-supersede cancellation (`didChange`) -> -32800
    if dispatch_read_query(mut_view(s), 10i64, 1) != ERR_NONE {
        return 5;
    }
    cancel_inflight(mut_view(s), 10i64);
    if complete_read_query(view(s), 1) != ERR_REQUEST_CANCELLED {
        return 6;
    }

    if dispatch_read_query(mut_view(s), 11i64, 2) != ERR_NONE {
        return 7;
    }
    apply_did_change(mut_view(s));
    if complete_read_query(view(s), 2) != ERR_REQUEST_CANCELLED {
        return 8;
    }

    // 5. `shutdown` -> post-shutdown request fails with -32600 -> `exit` sets exit_code = 0, zero codegen
    s.state = STATE_SHUTTING_DOWN;
    if dispatch_read_query(mut_view(s), 12i64, 3) != ERR_INVALID_REQUEST {
        return 9;
    }
    s.exit_code = if s.state == STATE_SHUTTING_DOWN { 0i32 } else { 1i32 };
    s.state = STATE_EXITED;
    if s.exit_code != 0i32 || s.codegen_invocations != 0u32 {
        return 10;
    }

    print("END-TO-END-LSP-SESSION-AND-ZERO-CODEGEN-OK\n");
    0
}
