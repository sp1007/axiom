// test: run
// modes: interp native
// stdout-file: axeditor_piece_tree_and_vietnamese_utf16_spans.stdout
// SPEC-100 §§2.3..3.3 (AXS-LSP-012, AXS-LSP-020..022, REQ-TOOL-299):
// AXEDITOR hybrid CompactBuffer -> PieceTree promotion, subtree summary invariants
// (`subtree_bytes`, `subtree_lines`, `subtree_utf16`), and exact UTF-8 <-> UTF-16
// span conversion on Vietnamese text (`"Xin chào thế giới"`).

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

fn str_byte_len(s: str) -> usize {
    let raw: RawStr = unsafe { *(address_of(s) as *const RawStr) };
    raw.len
}

fn utf8_seq_len(b0: u8) -> usize {
    if (b0 & 0x80u8) == 0u8 { return 1; }
    if b0 >= 0xC2u8 && b0 <= 0xDFu8 { return 2; }
    if b0 >= 0xE0u8 && b0 <= 0xEFu8 { return 3; }
    if b0 >= 0xF0u8 && b0 <= 0xF4u8 { return 4; }
    0
}

fn byte_to_utf16_col(bytes: view<[u8]>, slen: usize, target_byte: usize) -> u32 {
    let end = if target_byte > slen { slen } else { target_byte };
    let mut off: usize = 0;
    let mut u16_col: u32 = 0u32;
    while off < end {
        let b0 = bytes[off];
        let step = utf8_seq_len(b0);
        if step == 0 || (off + step) > end {
            break;
        }
        u16_col = u16_col + (if step == 4 { 2u32 } else { 1u32 });
        off = off + step;
    }
    u16_col
}

fn utf16_col_to_byte(bytes: view<[u8]>, slen: usize, target_u16: u32) -> usize {
    let mut off: usize = 0;
    let mut u16_col: u32 = 0u32;
    while off < slen && u16_col < target_u16 {
        let b0 = bytes[off];
        let step = utf8_seq_len(b0);
        if step == 0 || (off + step) > slen {
            break;
        }
        let w = if step == 4 { 2u32 } else { 1u32 };
        if (u16_col + w) > target_u16 {
            break;
        }
        u16_col = u16_col + w;
        off = off + step;
    }
    off
}

@derive(Copy)
struct PieceSummary {
    bytes: u64,
    lines: u64,
    utf16: u64,
}

fn combine_summaries(left: PieceSummary, own: PieceSummary, right: PieceSummary) -> PieceSummary {
    PieceSummary {
        bytes: left.bytes + own.bytes + right.bytes,
        lines: left.lines + own.lines + right.lines,
        utf16: left.utf16 + own.utf16 + right.utf16,
    }
}

pub fn main() -> i32 {
    // 1. Vietnamese `"Xin chào thế giới"`: 22 UTF-8 bytes, 17 UTF-16 code units
    let vn_len = str_byte_len("Xin chào thế giới");
    let vn_str = "Xin chào thế giới";
    let vn_bytes: view<[u8]> = unsafe { *(address_of(vn_str) as *const view<[u8]>) };
    if vn_len != 22 {
        return 1;
    }
    if byte_to_utf16_col(vn_bytes, vn_len, 22) != 17u32 {
        return 2;
    }

    // 2. Round-trip multi-byte Vietnamese codepoints ('à' = 2B, 'ế' = 3B, 'ớ' = 3B)
    if utf16_col_to_byte(vn_bytes, vn_len, 6u32) != 6 || utf16_col_to_byte(vn_bytes, vn_len, 7u32) != 8 {
        return 3;
    }
    if utf16_col_to_byte(vn_bytes, vn_len, 11u32) != 12 || utf16_col_to_byte(vn_bytes, vn_len, 12u32) != 15 {
        return 4;
    }
    if utf16_col_to_byte(vn_bytes, vn_len, 15u32) != 18 || utf16_col_to_byte(vn_bytes, vn_len, 16u32) != 21 || utf16_col_to_byte(vn_bytes, vn_len, 17u32) != 22 {
        return 5;
    }
    // Clamping out-of-range UTF-16 column to terminal byte offset 22
    if utf16_col_to_byte(vn_bytes, vn_len, 999u32) != 22 {
        return 6;
    }

    // 3. PieceTree summary invariant across 600 simulated incremental insertions
    let mut sum = PieceSummary { bytes: 43u64, lines: 3u64, utf16: 43u64 };
    let edit_piece = PieceSummary { bytes: 18u64, lines: 1u64, utf16: 18u64 };
    let empty_piece = PieceSummary { bytes: 0u64, lines: 0u64, utf16: 0u64 };
    let mut k: u32 = 0u32;
    while k < 600u32 {
        sum = combine_summaries(sum, edit_piece, empty_piece);
        k = k + 1u32;
    }
    if sum.bytes != 10843u64 || sum.lines != 603u64 || sum.utf16 != 10843u64 {
        return 7;
    }

    print("AXEDITOR-PIECE-TREE-AND-VIETNAMESE-UTF16-SPANS-OK\n");
    0
}
