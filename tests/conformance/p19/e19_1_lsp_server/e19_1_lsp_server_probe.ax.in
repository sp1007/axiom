@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn probe_print_str(s: str) {
    let sv = lsp_str_view(s);
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) };
}

fn probe_print_bool(b: bool) {
    if b {
        probe_print_str("true");
    } else {
        probe_print_str("false");
    }
}

fn probe_print_i64(v: i64) {
    if v == 0i64 {
        probe_print_str("0");
        return;
    }
    let mut n = v;
    if n < 0i64 {
        probe_print_str("-");
        n = -n;
    }
    let mut buf: [24]u8 = [0u8; 24];
    let mut dlen: usize = 0;
    while n > 0i64 {
        buf[dlen] = (48i64 + (n % 10i64)) as u8;
        dlen = dlen + 1;
        n = n / 10i64;
    }
    while dlen > 0 {
        dlen = dlen - 1;
        let ch = buf[dlen];
        let _ = unsafe { write(stdio(1), address_of(ch), 1) };
    }
}

fn setup_e19_1_workspace(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>) -> u32 {
    let doc_net: u32 = 0u32;
    let doc_app: u32 = 1u32;

    let net_src = "module net\npub struct Packet {\n    pub len: usize\n}\npub fn push(p: mut_view<Packet>, b: u8) {}\n";
    let net_sv = lsp_str_view(net_src);
    let _ = vfs_did_open(
        mut_view(*ws),
        doc_net,
        vfs_hash_str("file:///workspace/net.ax"),
        1i64,
        net_sv.ptr,
        net_sv.len,
        0x1111u64,
        0x2222u64
    );

    let app_src = "use net.Packet\nfn main() {\n    let mut pkt = Packet\n    push(pkt, 1)\n    pkt.\n}\n";
    let app_sv = lsp_str_view(app_src);
    let _ = vfs_did_open(
        mut_view(*ws),
        doc_app,
        vfs_hash_str("file:///workspace/app.ax"),
        1i64,
        app_sv.ptr,
        app_sv.len,
        0x3333u64,
        0x4444u64
    );

    // Intern generational entities in VFS arena (`AXS-LSP-002`)
    let ty_packet = vfs_intern_type(mut_view(*ws), doc_net, "net.Packet", 15u32, 21u32);
    let ty_usize = vfs_intern_type(mut_view(*ws), doc_net, "usize", 43u32, 48u32);
    let sym_packet = vfs_intern_symbol(mut_view(*ws), doc_net, "net.Packet", ty_packet, 15u32, 21u32);
    let sym_push = vfs_intern_symbol(mut_view(*ws), doc_net, "net.push", ty_usize, 59u32, 63u32);
    let sym_checksum = vfs_intern_symbol(mut_view(*ws), doc_net, "net.checksum", ty_usize, 64u32, 72u32);
    let sym_trait_ser = vfs_intern_symbol(mut_view(*ws), doc_net, "net.Serializable", ty_usize, 1u32, 5u32);
    let sym_trait_dbg = vfs_intern_symbol(mut_view(*ws), doc_net, "net.DebugFormat", ty_usize, 6u32, 10u32);
    let fn_main = vfs_intern_function(mut_view(*ws), doc_app, "app.main", ty_usize, 18u32, 22u32);
    let loc_pkt = vfs_intern_local(mut_view(*ws), doc_app, fn_main, 1u16, "pkt", 0u16, ty_packet, OWNERSHIP_OWNED, CAP_NONE, 39u32, 42u32);
    let loc_ro = vfs_intern_local(mut_view(*ws), doc_app, fn_main, 1u16, "existing_local", 1u16, ty_packet, OWNERSHIP_VIEW, CAP_READ_ONLY, 27u32, 30u32);

    lsp_register_type_meta(
        mut_view(*eng),
        mut_view(*ws),
        ty_packet,
        doc_net,
        15u32,
        21u32,
        sym_packet,
        "net.Packet",
        REPR_C,
        24u32,
        8u32,
        false,
        true,
        true,
        true
    );

    // `Packet` declaration in `net.ax` (bytes 15..21)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_net,
        15u32,
        21u32,
        sym_packet,
        sym_packet.raw,
        FunctionId { raw: gen_id_new(0u32, 0u32) },
        0u16,
        SYM_KIND_STRUCT,
        SEM_TOK_STRUCT,
        0u32,
        true,
        true,
        false,
        false,
        ty_packet,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "Packet",
        "pub struct Packet",
        "net.Packet",
        "",
        "",
        "Network packet buffer with deterministic layout."
    );

    // `push` declaration in `net.ax` (bytes 59..63)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_net,
        59u32,
        63u32,
        sym_push,
        sym_push.raw,
        FunctionId { raw: gen_id_new(0u32, 0u32) },
        0u16,
        SYM_KIND_FUNCTION,
        SEM_TOK_FUNCTION,
        0u32,
        true,
        true,
        false,
        false,
        ty_usize,
        OWNERSHIP_MUT_VIEW,
        CAP_READ_WRITE,
        DISPATCH_INHERENT,
        "push",
        "pub fn push(p: mut_view<Packet>, b: u8) -> usize",
        "fn(mut_view<net.Packet>, u8) -> usize",
        "p",
        "impl net.Packet",
        "Appends a byte into the mutable packet view."
    );

    // Built-in `usize` in `net.ax` (bytes 43..48) for `prepareRename` rejection
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_net,
        43u32,
        48u32,
        LspSymbolId { raw: ty_usize.raw },
        ty_usize.raw,
        FunctionId { raw: gen_id_new(0u32, 0u32) },
        0u16,
        SYM_KIND_STRUCT,
        SEM_TOK_TYPE,
        0u32,
        false,
        true,
        false,
        true,
        ty_usize,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "usize",
        "primitive type usize",
        "usize",
        "",
        "",
        ""
    );

    // Node 0 in `app.ax`: `Packet` in `use net.Packet` (bytes 8..14)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        8u32,
        14u32,
        sym_packet,
        sym_packet.raw,
        FunctionId { raw: gen_id_new(0u32, 0u32) },
        0u16,
        SYM_KIND_STRUCT,
        SEM_TOK_STRUCT,
        0u32,
        false,
        true,
        false,
        false,
        ty_packet,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "Packet",
        "pub struct Packet",
        "net.Packet",
        "",
        "",
        "Network packet buffer with deterministic layout."
    );

    // Node 1 in `app.ax`: `existing_local` (bytes 27..30, `OWNERSHIP_VIEW`, `CAP_READ_ONLY`)
    let sym_existing = LspSymbolId { raw: loc_ro.raw };
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        27u32,
        30u32,
        sym_existing,
        loc_ro.raw,
        fn_main,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        true,
        false,
        false,
        false,
        ty_packet,
        OWNERSHIP_VIEW,
        CAP_READ_ONLY,
        DISPATCH_NONE,
        "existing_local",
        "let existing_local: view<net.Packet>",
        "view<net.Packet>",
        "pkt",
        "",
        ""
    );

    // Node 2 in `app.ax`: `pkt` local binding (bytes 39..42, `OWNERSHIP_OWNED`)
    let sym_pkt_local = LspSymbolId { raw: loc_pkt.raw };
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        39u32,
        42u32,
        sym_pkt_local,
        loc_pkt.raw,
        fn_main,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        true,
        false,
        true,
        false,
        ty_packet,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "pkt",
        "let mut pkt: net.Packet",
        "net.Packet",
        "pkt",
        "",
        "Local mutable packet instance."
    );

    // Node 3 in `app.ax`: `push` call site (bytes 56..60)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        56u32,
        60u32,
        sym_push,
        sym_push.raw,
        fn_main,
        1u16,
        SYM_KIND_FUNCTION,
        SEM_TOK_FUNCTION,
        0u32,
        false,
        true,
        false,
        false,
        ty_usize,
        OWNERSHIP_MUT_VIEW,
        CAP_READ_WRITE,
        DISPATCH_INHERENT,
        "push",
        "pub fn push(p: mut_view<Packet>, b: u8) -> usize",
        "fn(mut_view<net.Packet>, u8) -> usize",
        "pkt",
        "impl net.Packet",
        "Appends a byte into the mutable packet view."
    );

    // Node 4 in `app.ax`: `pkt` argument at `push(pkt, 1)` (bytes 61..64, `OWNERSHIP_MUT_VIEW`)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        61u32,
        64u32,
        sym_pkt_local,
        loc_pkt.raw,
        fn_main,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        false,
        false,
        true,
        false,
        ty_packet,
        OWNERSHIP_MUT_VIEW,
        CAP_READ_WRITE,
        DISPATCH_NONE,
        "pkt",
        "let mut pkt: net.Packet",
        "mut_view<net.Packet>",
        "pkt",
        "",
        ""
    );

    // Node 5 in `app.ax`: `pkt` receiver at `pkt.` (bytes 73..76, `OWNERSHIP_MUT_VIEW`)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        73u32,
        76u32,
        sym_pkt_local,
        loc_pkt.raw,
        fn_main,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        false,
        false,
        true,
        false,
        ty_packet,
        OWNERSHIP_MUT_VIEW,
        CAP_READ_WRITE,
        DISPATCH_NONE,
        "pkt",
        "let mut pkt: net.Packet",
        "mut_view<net.Packet>",
        "pkt",
        "",
        ""
    );

    // Register trait implementation associated with `sym_packet`
    lsp_register_trait_impl(
        mut_view(*eng),
        mut_view(*ws),
        sym_packet,
        ty_packet,
        doc_net,
        11u32,
        51u32,
        sym_packet,
        "net.Serializable.for.net.Packet"
    );

    // Register member completion candidates on `Packet`
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_FIELD,
        COMP_KIND_FIELD,
        sym_packet,
        LspSymbolId { raw: gen_id_new(0u32, 0u32) },
        "len",
        "len",
        "pub len: usize"
    );
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        false,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_FIELD,
        COMP_KIND_FIELD,
        sym_packet,
        LspSymbolId { raw: gen_id_new(0u32, 0u32) },
        "secret_tag",
        "secret_tag",
        "secret_tag: u32"
    );
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_VIEW,
        COMP_KIND_METHOD,
        sym_checksum,
        LspSymbolId { raw: gen_id_new(0u32, 0u32) },
        "checksum",
        "checksum",
        "pub fn checksum(self: view<Packet>) -> usize"
    );
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_MUT_VIEW,
        COMP_KIND_METHOD,
        sym_push,
        LspSymbolId { raw: gen_id_new(0u32, 0u32) },
        "push",
        "push",
        "pub fn push(self: mut_view<Packet>, b: u8) -> usize"
    );
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_VIEW,
        COMP_KIND_METHOD,
        sym_trait_ser,
        sym_trait_ser,
        "format",
        "Serializable.format",
        "trait net.Serializable.format(view<Packet>)"
    );
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_VIEW,
        COMP_KIND_METHOD,
        sym_trait_dbg,
        sym_trait_dbg,
        "format",
        "DebugFormat.format",
        "trait net.DebugFormat.format(view<Packet>)"
    );

    lsp_register_scope_candidate(
        mut_view(*eng),
        doc_app,
        fn_main,
        1u16,
        false,
        true,
        ty_packet,
        COMP_KIND_VARIABLE,
        loc_pkt,
        sym_pkt_local,
        "pkt",
        "let mut pkt: net.Packet"
    );

    // Record partial-program `IncompleteMemberAccess` at `pkt.` (dot at byte 76)
    let _ = vfs_record_incomplete_member_access(mut_view(*ws), doc_app, fn_main, loc_pkt, 76u32);

    // Register 5 AXCODEEDITOR inlay sites in `app.ax` (`AXS-LSP-051`, `REQ-TOOL-300`)
    lsp_register_inlay_site(mut_view(*eng), doc_app, 42u32, INLAY_KIND_INFERRED_TYPE, INLAY_SUBKIND_NONE, REGION_REL_NONE, 0u16, 0u16, ": net.Packet");
    lsp_register_inlay_site(mut_view(*eng), doc_app, 61u32, INLAY_KIND_PARAMETER_NAME, INLAY_SUBKIND_NONE, REGION_REL_NONE, 0u16, 0u16, "p:");
    lsp_register_inlay_site(mut_view(*eng), doc_app, 64u32, INLAY_KIND_OWNERSHIP_FLOW, INLAY_SUBKIND_MUT_VIEW, REGION_REL_SAME, 0u16, 0u16, "/* mut_view pkt */");
    lsp_register_inlay_site(mut_view(*eng), doc_app, 78u32, INLAY_KIND_OWNERSHIP_FLOW, INLAY_SUBKIND_DROP, REGION_REL_NONE, 0u16, 0u16, "/* drop pkt */");
    lsp_register_inlay_site(mut_view(*eng), doc_app, 70u32, INLAY_KIND_ASYNC_SUSPEND, INLAY_SUBKIND_AWAIT_STATE, REGION_REL_CONTAINS, 1u16, 2u16, "/* await #1 (2 live) */");

    doc_app
}

fn run_section_1_session_lifecycle(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) -> bool {
    let mut cli = lsp_default_cli_config();
    let _ = lsp_parse_cli_arg(mut_view(cli), "--stdio");
    let _ = lsp_parse_cli_arg(mut_view(cli), "--position-encoding=utf-16");
    let _ = lsp_parse_cli_arg(mut_view(cli), "--inlay-types=true");
    let _ = lsp_parse_cli_arg(mut_view(cli), "--inlay-params=true");
    let _ = lsp_parse_cli_arg(mut_view(cli), "--inlay-ownership=true");
    let _ = lsp_parse_cli_arg(mut_view(cli), "--inlay-async=true");

    let mut drv = lsp_driver_new(cli);
    lsp_driver_apply_cli(view(drv), mut_view(*ws), mut_view(*eng));
    let mut wire_buf: [512]u8 = [0u8; 512];
    let wp = unsafe { address_of(wire_buf[0]) as *mut u8 };

    // Request before `initialize` -> `-32002` (`LSP_ERR_SERVER_NOT_INITIALIZED`)
    let pre_init = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 9i64, "textDocument/hover", doc_app, "file:///workspace/app.ax", 1i64, "", lsp_pos_new(2u32, 13u32), wp, 512);

    let rc_init = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 1i64, "initialize", doc_app, "", 0i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let rc_inited = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 0i64, "initialized", doc_app, "", 0i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let init_ok = rc_init == LSP_ERR_NONE && rc_inited == LSP_ERR_NONE && drv.session.state == LSP_STATE_RUNNING;

    // Open a scratch doc 2 and apply an incremental range change at EOF of `doc_app` (preserving offsets 0..78)
    let rc_open = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 0i64, "textDocument/didOpen", 2u32, "file:///workspace/scratch.ax", 1i64, "fn scratch() {}\n", lsp_pos_new(0u32, 0u32), wp, 512);
    let open_ok = rc_open == LSP_ERR_NONE;

    let tail_sv = lsp_str_view("\n");
    let eof_range = lsp_range_new(lsp_pos_new(6u32, 0u32), lsp_pos_new(6u32, 0u32));
    let change_ok = vfs_did_change_range(mut_view(*ws), doc_app, 2i64, eof_range, tail_sv.ptr, tail_sv.len, 0x3333u64, 0x4445u64);

    let fn_main = FunctionId { raw: gen_id_new(8u32, 1u32) };
    let ty_usize = LspTypeId { raw: gen_id_new(2u32, 1u32) };
    let loc_pkt = LocalId { raw: gen_id_new(9u32, 1u32) };
    let loc_ro = LocalId { raw: gen_id_new(10u32, 1u32) };
    let _ = vfs_record_incomplete_member_access(mut_view(*ws), doc_app, fn_main, loc_pkt, 76u32);

    let pub_diag = lsp_handle_publish_diagnostics(mut_view(*eng), mut_view(*ws), doc_app);
    let h_pkt = lsp_handle_hover(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 13u32));
    let h_push = lsp_handle_hover(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(3u32, 5u32));
    let hover_ok = h_pkt.found && h_pkt.layout_size_bytes == 24u32 && h_pkt.layout_align_bytes == 8u32 && h_push.found && h_push.dispatch_mode == DISPATCH_INHERENT;

    let def_push = lsp_handle_definition(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(3u32, 5u32));
    let tdef_pkt = lsp_handle_type_definition(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 13u32));
    let impl_res = lsp_handle_implementation(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(0u32, 10u32));
    let refs_all = lsp_handle_references(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(0u32, 10u32), true);
    let dsyms = lsp_handle_document_symbol(mut_view(*eng), mut_view(*ws), 0u32);
    let wsyms = lsp_handle_workspace_symbol(mut_view(*eng), mut_view(*ws), "Packet");

    // Read-only member completion at `loc_ro.` (recorded at byte 79, line 5 char 1) -> 4 items (`len`, `checksum`, 2 ambiguous `format`)
    let _ = vfs_record_incomplete_member_access(mut_view(*ws), doc_app, fn_main, loc_ro, 79u32);
    let c_ro = lsp_handle_completion(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(5u32, 1u32), fn_main, 1u16, ty_usize);

    let prep_push = lsp_handle_prepare_rename(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(3u32, 5u32));
    let ren_push = lsp_handle_rename(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(3u32, 5u32), "append_byte");
    let sem_toks = lsp_handle_semantic_tokens_full(mut_view(*eng), mut_view(*ws), doc_app);
    let full_range = lsp_range_new(lsp_pos_new(0u32, 0u32), lsp_pos_new(10u32, 0u32));
    let inlays = lsp_handle_inlay_hints(mut_view(*eng), mut_view(*ws), doc_app, full_range);

    // Explicit `$/cancelRequest` & revision-supersede cancellation (`-32800`)
    let hover_sv = lsp_str_view("{\"jsonrpc\":\"2.0\",\"id\":40,\"method\":\"textDocument/hover\",\"params\":{}}");
    let hover_msg = lsp_parse_jsonrpc_message(hover_sv.ptr, hover_sv.len);
    let _ = lsp_dispatch_message(mut_view(drv.session), hover_msg);
    let cancel_sv = lsp_str_view("{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{\"id\":40}}");
    let cancel_msg = lsp_parse_jsonrpc_message(cancel_sv.ptr, cancel_sv.len);
    let _ = lsp_dispatch_message(mut_view(drv.session), cancel_msg);
    let cancel_err = lsp_complete_request(mut_view(drv.session), 40i64);

    let def_sv = lsp_str_view("{\"jsonrpc\":\"2.0\",\"id\":41,\"method\":\"textDocument/definition\",\"params\":{}}");
    let def_msg = lsp_parse_jsonrpc_message(def_sv.ptr, def_sv.len);
    let _ = lsp_dispatch_message(mut_view(drv.session), def_msg);
    let chg_sv = lsp_str_view("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"version\":3}}}");
    let chg_msg = lsp_parse_jsonrpc_message(chg_sv.ptr, chg_sv.len);
    let _ = lsp_dispatch_message(mut_view(drv.session), chg_msg);
    let supersede_err = lsp_check_cancellation(view(drv.session), 41i64);

    // `shutdown` -> illegal request (`-32600`) -> `exit` (`0`)
    let _ = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 50i64, "shutdown", doc_app, "", 0i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let post_shut = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 51i64, "textDocument/hover", doc_app, "file:///workspace/app.ax", 2i64, "", lsp_pos_new(2u32, 13u32), wp, 512);
    let _ = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 0i64, "exit", doc_app, "", 0i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let exit_code = drv.session.exit_code;
    let zero_cg = lsp_driver_verify_zero_codegen(view(drv), view(*ws));

    probe_print_str("probe[session_lifecycle] pre_init=");
    probe_print_i64(pre_init as i64);
    probe_print_str(" init_ok=");
    probe_print_bool(init_ok);
    probe_print_str(" open_ok=");
    probe_print_bool(open_ok);
    probe_print_str(" change_ok=");
    probe_print_bool(change_ok);
    probe_print_str(" diag_cnt=");
    probe_print_i64(pub_diag.diagnostic_count as i64);
    probe_print_str(" hover_ok=");
    probe_print_bool(hover_ok);
    probe_print_str(" def_doc=");
    probe_print_i64(def_push.location.doc_id as i64);
    probe_print_str(" tdef_doc=");
    probe_print_i64(tdef_pkt.location.doc_id as i64);
    probe_print_str(" impl_cnt=");
    probe_print_i64(impl_res.count as i64);
    probe_print_str(" refs_cnt=");
    probe_print_i64(refs_all.count as i64);
    probe_print_str(" dsym_cnt=");
    probe_print_i64(dsyms.count as i64);
    probe_print_str(" wsym_cnt=");
    probe_print_i64(wsyms.count as i64);
    probe_print_str(" comp_cnt=");
    probe_print_i64(c_ro.count as i64);
    probe_print_str(" prep_ok=");
    probe_print_bool(prep_push.can_rename);
    probe_print_str(" rename_edits=");
    probe_print_i64(ren_push.edit_count as i64);
    probe_print_str(" sem_toks=");
    probe_print_i64(sem_toks.token_count as i64);
    probe_print_str(" inlays=");
    probe_print_i64(inlays.count as i64);
    probe_print_str(" post_shut=");
    probe_print_i64(post_shut as i64);
    probe_print_str(" exit_code=");
    probe_print_i64(exit_code as i64);
    probe_print_str(" cancel_err=");
    probe_print_i64(cancel_err as i64);
    probe_print_str(" supersede_err=");
    probe_print_i64(supersede_err as i64);
    probe_print_str(" zero_codegen=");
    probe_print_bool(zero_cg);
    probe_print_str("\n");

    pre_init == LSP_ERR_SERVER_NOT_INITIALIZED &&
        init_ok && open_ok && change_ok &&
        pub_diag.diagnostic_count == 1u32 &&
        hover_ok &&
        def_push.location.doc_id == 0u32 &&
        tdef_pkt.location.doc_id == 0u32 &&
        impl_res.count == 1u32 &&
        refs_all.count == 2u32 &&
        dsyms.count == 2u32 &&
        wsyms.count == 1u32 &&
        c_ro.count == 4u32 &&
        prep_push.can_rename &&
        ren_push.edit_count == 2u32 &&
        sem_toks.token_count == 6u32 &&
        inlays.count == 5u32 &&
        post_shut == LSP_ERR_INVALID_REQUEST &&
        exit_code == 0i32 &&
        cancel_err == LSP_ERR_REQUEST_CANCELLED &&
        supersede_err == LSP_ERR_REQUEST_CANCELLED &&
        zero_cg
}

fn run_section_2_axeditor_unicode_piece_tree() -> bool {
    let init_sv = lsp_str_view("fn alpha() -> i32 {\n    let x = 10;\n    x\n}");
    let mut doc = editor_doc_empty();
    let _ = editor_doc_init_with_threshold(mut_view(doc), 10u32, init_sv.ptr, init_sv.len, 128);
    if doc.repr_kind != REPR_COMPACT {
        editor_doc_free(mut_view(doc));
        return false;
    }

    let ins_sv = lsp_str_view("\n    let step = 1;");
    let mut k: u32 = 0u32;
    while k < 600u32 {
        let mid = doc.total_bytes - 2u64;
        if !editor_apply_edit(mut_view(doc), mid, mid, ins_sv.ptr, ins_sv.len) {
            editor_doc_free(mut_view(doc));
            return false;
        }
        k = k + 1u32;
    }
    let promoted = doc.repr_kind == REPR_PIECE_TREE && doc.promotion_count == 1u32;
    let tree_valid = editor_verify_tree_invariants(view(doc));
    editor_doc_free(mut_view(doc));

    // Vietnamese UTF-8 / UTF-16 test: "Xin chào thế giới" (22 UTF-8 bytes, 17 UTF-16 code units)
    let vn_sv = lsp_str_view("let s = \"Xin chào thế giới\";\nlet y = 42;\n");
    let mut vdoc = editor_doc_empty();
    let _ = editor_doc_init_with_threshold(mut_view(vdoc), 1u32, vn_sv.ptr, vn_sv.len, 64);

    let start_pos = editor_byte_offset_to_lsp_pos(view(vdoc), 9u64, POS_ENCODING_UTF16);
    let end_pos = editor_byte_offset_to_lsp_pos(view(vdoc), 31u64, POS_ENCODING_UTF16);
    let after_semi_pos = editor_byte_offset_to_lsp_pos(view(vdoc), 33u64, POS_ENCODING_UTF16);
    let vn_bytes = 31u64 - 9u64;
    let vn_utf16 = (end_pos.character - start_pos.character) as u64;
    let vn_after_col = after_semi_pos.character;

    let roundtrip_start = editor_lsp_pos_to_byte_offset(view(vdoc), start_pos, POS_ENCODING_UTF16);
    let roundtrip_end = editor_lsp_pos_to_byte_offset(view(vdoc), end_pos, POS_ENCODING_UTF16);
    let clamped_eol = editor_lsp_pos_to_byte_offset(view(vdoc), lsp_pos_new(0u32, 999u32), POS_ENCODING_UTF16);
    let clamp_ok = roundtrip_start == 9u64 && roundtrip_end == 31u64 && clamped_eol == 33u64;
    editor_doc_free(mut_view(vdoc));

    // Astral emoji `"a😀b"` (6 UTF-8 bytes, 4 UTF-16 units)
    let emoji_bytes_arr: [6]u8 = [97u8, 0xF0u8, 0x9Fu8, 0x98u8, 0x80u8, 98u8];
    let mut edoc = editor_doc_empty();
    let _ = editor_doc_init_with_threshold(mut_view(edoc), 2u32, unsafe { address_of(emoji_bytes_arr[0]) }, 6, 64);
    let emoji_end_u16 = editor_byte_offset_to_lsp_pos(view(edoc), 6u64, POS_ENCODING_UTF16);
    let b_off = editor_lsp_pos_to_byte_offset(view(edoc), lsp_pos_new(0u32, 3u32), POS_ENCODING_UTF16);
    let emoji_ok = edoc.total_bytes == 6u64 && emoji_end_u16.character == 4u32 && b_off == 5u64;
    editor_doc_free(mut_view(edoc));

    // UAX #29 grapheme cluster motion on `"a\r\ne\u{0301}x"`
    let g_arr: [7]u8 = [97u8, 13u8, 10u8, 101u8, 0xCCu8, 0x81u8, 120u8];
    let mut gdoc = editor_doc_empty();
    let _ = editor_doc_init_with_threshold(mut_view(gdoc), 3u32, unsafe { address_of(g_arr[0]) }, 7, 64);
    let mut cur: u64 = 0u64;
    let mut fwd_steps: u32 = 0u32;
    while cur < (gdoc.total_bytes) {
        cur = editor_next_grapheme_offset(view(gdoc), cur);
        fwd_steps = fwd_steps + 1u32;
    }
    let mut bwd_steps: u32 = 0u32;
    while cur > 0u64 {
        cur = editor_prev_grapheme_offset(view(gdoc), cur);
        bwd_steps = bwd_steps + 1u32;
    }
    editor_doc_free(mut_view(gdoc));

    // Atomic EditTransaction commit, rollback on overlapping ranges, SelectionSet normalization, Undo/Redo
    let tx_sv = lsp_str_view("let a = 1;\nlet b = 2;\nlet c = 3;\n");
    let mut tdoc = editor_doc_empty();
    let _ = editor_doc_init_with_threshold(mut_view(tdoc), 11u32, tx_sv.ptr, tx_sv.len, 16);
    let mut sels: [3]Selection = [
        selection_range(11u64, 15u64),
        selection_range(0u64, 5u64),
        selection_range(3u64, 8u64)
    ];
    editor_set_selections(mut_view(tdoc), unsafe { address_of(sels[0]) }, 3u32);
    let sel_norm_ok = tdoc.selection_count == 2u32;

    let rep1_sv = lsp_str_view("100");
    let rep2_sv = lsp_str_view("200");
    let mut valid_batch: [2]TextEdit = [
        text_edit_new(8u64, 9u64, rep1_sv.ptr, 3),
        text_edit_new(19u64, 20u64, rep2_sv.ptr, 3)
    ];
    let tx_commit = editor_apply_transaction(mut_view(tdoc), unsafe { address_of(valid_batch[0]) }, 2u32);
    let bytes_after_commit = tdoc.total_bytes;

    let mut bad_batch: [2]TextEdit = [
        text_edit_new(0u64, 6u64, rep1_sv.ptr, 3),
        text_edit_new(4u64, 10u64, rep2_sv.ptr, 3)
    ];
    let bad_ok = !editor_apply_transaction(mut_view(tdoc), unsafe { address_of(bad_batch[0]) }, 2u32);
    let tx_rollback = bad_ok && tdoc.total_bytes == bytes_after_commit && tdoc.tx_rollback_count == 1u32;

    let rep3_sv = lsp_str_view("300");
    let _ = editor_apply_edit(mut_view(tdoc), 32u64, 33u64, rep3_sv.ptr, 3);
    let len_after_edit = tdoc.total_bytes;
    let u_ok = editor_undo(mut_view(tdoc)) && tdoc.total_bytes == bytes_after_commit;
    let r_ok = editor_redo(mut_view(tdoc)) && tdoc.total_bytes == len_after_edit;
    let undo_redo_ok = u_ok && r_ok && sel_norm_ok && editor_verify_tree_invariants(view(tdoc));
    let _ = editor_snapshot(view(tdoc));
    editor_doc_free(mut_view(tdoc));

    probe_print_str("probe[axeditor_unicode_piece_tree] promoted=");
    probe_print_bool(promoted);
    probe_print_str(" tree_valid=");
    probe_print_bool(tree_valid);
    probe_print_str(" edits=");
    probe_print_i64(600i64);
    probe_print_str(" vn_bytes=");
    probe_print_i64(vn_bytes as i64);
    probe_print_str(" vn_utf16=");
    probe_print_i64(vn_utf16 as i64);
    probe_print_str(" vn_after_col=");
    probe_print_i64(vn_after_col as i64);
    probe_print_str(" emoji_utf16=");
    probe_print_i64(emoji_end_u16.character as i64);
    probe_print_str(" clamp_ok=");
    probe_print_bool(clamp_ok && emoji_ok);
    probe_print_str(" grapheme_fwd=");
    probe_print_i64(fwd_steps as i64);
    probe_print_str(" grapheme_bwd=");
    probe_print_i64(bwd_steps as i64);
    probe_print_str(" tx_commit=");
    probe_print_bool(tx_commit);
    probe_print_str(" tx_rollback=");
    probe_print_bool(tx_rollback);
    probe_print_str(" undo_redo_ok=");
    probe_print_bool(undo_redo_ok);
    probe_print_str("\n");

    promoted && tree_valid &&
        vn_bytes == 22u64 && vn_utf16 == 17u64 && vn_after_col == 28u32 &&
        clamp_ok && emoji_ok &&
        fwd_steps == 4u32 && bwd_steps == 4u32 &&
        tx_commit && tx_rollback && undo_redo_ok
}

fn run_section_3_generational_ids_and_recovery() -> bool {
    let mut ws = vfs_workspace_new();
    let src0_sv = lsp_str_view("pub fn compute(x: i32) -> i32 {\n    let local_a = x + 1;\n    local_a\n}\n");
    let src1_sv = lsp_str_view("use m0.compute\npub fn caller() -> i32 { compute(5) }\n");

    let _ = vfs_did_open(mut_view(ws), 0u32, vfs_hash_str("file:///m0.ax"), 1i64, src0_sv.ptr, src0_sv.len, 0x1111u64, 0x2222u64);
    let _ = vfs_did_open(mut_view(ws), 1u32, vfs_hash_str("file:///m1.ax"), 1i64, src1_sv.ptr, src1_sv.len, 0x3333u64, 0x4444u64);
    vfs_register_import_dep(mut_view(ws), 1u32, 0u32);
    let _ = vfs_recompute_dependent_module(mut_view(ws), 1u32);

    let ty_i32 = vfs_intern_type(mut_view(ws), 0u32, "i32", 18u32, 21u32);
    let fn_compute = vfs_intern_function(mut_view(ws), 0u32, "compute", ty_i32, 0u32, 70u32);
    let sym_compute = vfs_intern_symbol(mut_view(ws), 0u32, "compute", ty_i32, 7u32, 14u32);
    let loc_a = vfs_intern_local(mut_view(ws), 0u32, fn_compute, 1u16, "local_a", 0u16, ty_i32, OWNERSHIP_VIEW, CAP_NONE, 40u32, 47u32);
    let place_a = vfs_intern_place(mut_view(ws), 0u32, fn_compute, 1u16, "local_a", 0u16, ty_i32, OWNERSHIP_VIEW, CAP_NONE, 40u32, 47u32);

    // Prepend 32-byte comment line (shifting byte offsets by +32 without altering `interface_hash`)
    let hdr_sv = lsp_str_view("// 32-byte header comment line!\n");
    let ins_range = lsp_range_new(lsp_pos_new(0u32, 0u32), lsp_pos_new(0u32, 0u32));
    let _ = vfs_did_change_range(mut_view(ws), 0u32, 2i64, ins_range, hdr_sv.ptr, hdr_sv.len, 0x1111u64, 0x9999u64);

    let ty_i32_after = vfs_intern_type(mut_view(ws), 0u32, "i32", 50u32, 53u32);
    let fn_compute_after = vfs_intern_function(mut_view(ws), 0u32, "compute", ty_i32_after, 32u32, 102u32);
    let sym_compute_after = vfs_intern_symbol(mut_view(ws), 0u32, "compute", ty_i32_after, 39u32, 46u32);
    let loc_a_after = vfs_intern_local(mut_view(ws), 0u32, fn_compute_after, 1u16, "local_a", 0u16, ty_i32_after, OWNERSHIP_VIEW, CAP_NONE, 72u32, 79u32);
    let place_a_after = vfs_intern_place(mut_view(ws), 0u32, fn_compute_after, 1u16, "local_a", 0u16, ty_i32_after, OWNERSHIP_VIEW, CAP_NONE, 72u32, 79u32);

    let id_stable = lsp_type_id_eq(ty_i32, ty_i32_after) &&
        function_id_eq(fn_compute, fn_compute_after) &&
        lsp_symbol_id_eq(sym_compute, sym_compute_after) &&
        local_id_eq(loc_a, loc_a_after) &&
        place_id_eq(place_a, place_a_after);

    let downstream_recomputed = vfs_recompute_dependent_module(mut_view(ws), 1u32);
    let backdated = !downstream_recomputed;

    let temp_sym = vfs_intern_symbol(mut_view(ws), 0u32, "obsolete_helper", ty_i32, 80u32, 95u32);
    let _ = vfs_retire_entity(mut_view(ws), 0u32, temp_sym.raw);
    let stale_lk = vfs_lookup_entity(view(ws), temp_sym.raw);
    let reused_sym = vfs_intern_symbol(mut_view(ws), 0u32, "new_helper", ty_i32, 80u32, 90u32);

    // Partial-program recovery in `doc 2` (`REQ-TOOL-188`)
    let partial_sv = lsp_str_view("pub fn broken(pkt: mut_view<Packet>, ro: ReadOnly<SensorRegs>) {\n    pkt.\n    ro.\n    let x = ;\n    let y: = 42;\n}\npub fn healthy() -> i32 { true }\n");
    let _ = vfs_did_open(mut_view(ws), 2u32, vfs_hash_str("file:///partial.ax"), 1i64, partial_sv.ptr, partial_sv.len, 0x5555u64, 0x6666u64);

    let ty_packet = vfs_intern_type(mut_view(ws), 2u32, "Packet", 28u32, 34u32);
    let ty_sensor = vfs_intern_type(mut_view(ws), 2u32, "SensorRegs", 50u32, 60u32);
    let fn_broken = vfs_intern_function(mut_view(ws), 2u32, "broken", ty_i32, 0u32, 114u32);
    let fn_healthy = vfs_intern_function(mut_view(ws), 2u32, "healthy", ty_i32, 115u32, 148u32);

    let loc_pkt = vfs_intern_local(mut_view(ws), 2u32, fn_broken, 1u16, "pkt", 0u16, ty_packet, OWNERSHIP_MUT_VIEW, CAP_NONE, 14u32, 17u32);
    let loc_ro = vfs_intern_local(mut_view(ws), 2u32, fn_broken, 1u16, "ro", 1u16, ty_sensor, OWNERSHIP_VIEW, CAP_READ_ONLY, 37u32, 39u32);
    let loc_x = vfs_intern_local(mut_view(ws), 2u32, fn_broken, 1u16, "x", 2u16, ty_i32, OWNERSHIP_VIEW, CAP_NONE, 90u32, 91u32);
    let loc_y = vfs_intern_local(mut_view(ws), 2u32, fn_broken, 1u16, "y", 3u16, ty_i32, OWNERSHIP_VIEW, CAP_NONE, 104u32, 105u32);

    let rec_pkt_idx = vfs_record_incomplete_member_access(mut_view(ws), 2u32, fn_broken, loc_pkt, 72u32);
    let _ = vfs_record_incomplete_member_access(mut_view(ws), 2u32, fn_broken, loc_ro, 81u32);
    let _ = vfs_record_incomplete_expr(mut_view(ws), 2u32, fn_broken, loc_x, ty_i32, 94u32, 95u32);
    let _ = vfs_record_incomplete_type(mut_view(ws), 2u32, fn_broken, loc_y, ty_i32, 106u32, 107u32);
    let _ = vfs_record_missing_token(mut_view(ws), 2u32, fn_broken, EXPECTED_TOK_SEMI, 112u32);

    let root_diags = unsafe { (*vfs_doc_ptr(view(ws), 2u32)).diagnostic_count };
    let cascade1 = vfs_typecheck_local_use(mut_view(ws), 2u32, loc_x, true, 96u32, 97u32);
    let cascade2 = vfs_typecheck_local_use(mut_view(ws), 2u32, loc_y, true, 108u32, 109u32);
    let suppressed = unsafe { (*vfs_doc_ptr(view(ws), 2u32)).cascaded_errors_suppressed };
    let indep_err = vfs_typecheck_independent_fn(mut_view(ws), 2u32, fn_healthy, true, 142u32, 146u32);
    let can_cg = vfs_can_codegen(view(ws), 2u32);
    let rec_pkt = unsafe { *(ws.recovery_nodes + (rec_pkt_idx as usize)) };

    probe_print_str("probe[generational_ids_and_recovery] id_stable=");
    probe_print_bool(id_stable);
    probe_print_str(" backdated=");
    probe_print_bool(backdated);
    probe_print_str(" stale_status=");
    probe_print_i64(stale_lk.status as i64);
    probe_print_str(" expected_gen=");
    probe_print_i64(stale_lk.expected_gen as i64);
    probe_print_str(" actual_gen=");
    probe_print_i64(stale_lk.actual_gen as i64);
    probe_print_str(" reused_gen=");
    probe_print_i64(reused_sym.raw.generation as i64);
    probe_print_str(" root_diags=");
    probe_print_i64(root_diags as i64);
    probe_print_str(" cascades_suppressed=");
    probe_print_i64(suppressed as i64);
    probe_print_str(" indep_fn_err=");
    probe_print_bool(indep_err);
    probe_print_str(" can_codegen=");
    probe_print_bool(can_cg);
    probe_print_str("\n");

    let ok = id_stable && backdated &&
        stale_lk.status == LOOKUP_STALE &&
        stale_lk.expected_gen == 1u32 &&
        stale_lk.actual_gen == 2u32 &&
        reused_sym.raw.generation == 2u32 &&
        rec_pkt.kind == RECOVERY_INCOMPLETE_MEMBER_ACCESS &&
        root_diags == 5u32 &&
        !cascade1 && !cascade2 &&
        suppressed == 2u32 &&
        indep_err && !can_cg;

    vfs_workspace_free(mut_view(ws));
    ok
}

fn run_section_4_constraints_rename_and_axcodeeditor(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) -> bool {
    let fn_main = FunctionId { raw: gen_id_new(8u32, 1u32) };
    let ty_usize = LspTypeId { raw: gen_id_new(2u32, 1u32) };
    let loc_pkt = LocalId { raw: gen_id_new(9u32, 1u32) };
    let loc_ro = LocalId { raw: gen_id_new(10u32, 1u32) };

    // 1. Mutable receiver `pkt.` at line 4 char 8 (dot byte 76) -> 5 candidates (`len`, `checksum`, `push`, 2 `format`), 1 excluded by visibility
    let c_rw = lsp_handle_completion(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(4u32, 8u32), fn_main, 1u16, ty_usize);

    // 2. Read-only receiver `loc_ro.` at line 5 char 1 (dot byte 79) -> 4 candidates (`push` excluded by capability, `secret_tag` excluded by visibility)
    let _ = vfs_record_incomplete_member_access(mut_view(*ws), doc_app, fn_main, loc_ro, 79u32);
    let c_ro = lsp_handle_completion(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(5u32, 1u32), fn_main, 1u16, ty_usize);

    // 3. Semantic token modifiers before move (`READ_VIEW` on token 1, `OWNED_VALUE` on token 2, `MUT_VIEW` on token 4)
    let toks_before = lsp_handle_semantic_tokens_full(mut_view(*eng), mut_view(*ws), doc_app);

    // 4. Mark `pkt` as moved at line 14 -> 0 candidates, 6 excluded by move; token 5 acquires `SEM_MOD_MOVED_VALUE`
    lsp_mark_local_moved(mut_view(*eng), mut_view(*ws), loc_pkt, 14u32);
    let c_moved = lsp_handle_completion(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(4u32, 8u32), fn_main, 1u16, ty_usize);
    let toks_after = lsp_handle_semantic_tokens_full(mut_view(*eng), mut_view(*ws), doc_app);

    let tok_mods_ok = (toks_before.tokens[1].token_modifiers & SEM_MOD_READ_VIEW) != 0u32 &&
        (toks_before.tokens[2].token_modifiers & SEM_MOD_OWNED_VALUE) != 0u32 &&
        (toks_before.tokens[4].token_modifiers & SEM_MOD_MUT_VIEW) != 0u32 &&
        (toks_after.tokens[5].token_modifiers & SEM_MOD_MOVED_VALUE) != 0u32;

    // 5. Hygienic rename checks (`AXS-LSP-043`)
    let prep_builtin = lsp_handle_prepare_rename(mut_view(*eng), mut_view(*ws), 0u32, lsp_pos_new(2u32, 14u32));
    let ren_kw = lsp_handle_rename(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 13u32), "let");
    let ren_conflict = lsp_handle_rename(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 13u32), "existing_local");

    // 6. Inlay hints non-mutation & revision-tagged presentation span checks (`AXS-LSP-050..051`)
    let full_range = lsp_range_new(lsp_pos_new(0u32, 0u32), lsp_pos_new(10u32, 0u32));
    let inlays = lsp_handle_inlay_hints(mut_view(*eng), mut_view(*ws), doc_app, full_range);
    let valid_span = LspPresentationSpan {
        doc_id: doc_app,
        revision: ws.revision,
        layer: HIGHLIGHT_LAYER_SEMANTIC_TOKEN,
        start_byte: 8u32,
        end_byte: 14u32,
    };
    let stale_span = LspPresentationSpan {
        doc_id: doc_app,
        revision: ws.revision - 1u64,
        layer: HIGHLIGHT_LAYER_SEMANTIC_TOKEN,
        start_byte: 8u32,
        end_byte: 14u32,
    };
    let span_valid = lsp_verify_presentation_span(view(*ws), valid_span);
    let span_stale = lsp_verify_presentation_span(view(*ws), stale_span);

    probe_print_str("probe[constraints_rename_and_axcodeeditor] ro_cnt=");
    probe_print_i64(c_ro.count as i64);
    probe_print_str(" ro_excl_vis=");
    probe_print_i64(c_ro.excluded_visibility_count as i64);
    probe_print_str(" ro_excl_cap=");
    probe_print_i64(c_ro.excluded_capability_count as i64);
    probe_print_str(" rw_cnt=");
    probe_print_i64(c_rw.count as i64);
    probe_print_str(" ambig_cnt=");
    probe_print_i64(c_rw.ambiguous_trait_count as i64);
    probe_print_str(" moved_cnt=");
    probe_print_i64(c_moved.count as i64);
    probe_print_str(" moved_excl=");
    probe_print_i64(c_moved.excluded_moved_count as i64);
    probe_print_str(" builtin_rename=");
    probe_print_bool(prep_builtin.can_rename);
    probe_print_str(" kw_rename=");
    probe_print_bool(ren_kw.accepted);
    probe_print_str(" conflict_code=");
    probe_print_i64(ren_conflict.conflict_diag_code as i64);
    probe_print_str(" tok_mods_ok=");
    probe_print_bool(tok_mods_ok);
    probe_print_str(" inlay_mutated=");
    probe_print_bool(inlays.buffer_mutated);
    probe_print_str(" span_valid=");
    probe_print_bool(span_valid);
    probe_print_str(" span_stale=");
    probe_print_bool(span_stale);
    probe_print_str("\n");

    c_ro.count == 4u32 &&
        c_ro.excluded_visibility_count == 1u32 &&
        c_ro.excluded_capability_count == 1u32 &&
        c_rw.count == 5u32 &&
        c_rw.ambiguous_trait_count == 2u32 &&
        c_rw.items[0].tier == COMP_TIER_INHERENT_TYPE_MATCH &&
        c_moved.count == 0u32 &&
        c_moved.excluded_moved_count == 6u32 &&
        !prep_builtin.can_rename &&
        prep_builtin.error_code == LSP_ERR_INVALID_PARAMS &&
        !ren_kw.accepted &&
        !ren_conflict.accepted &&
        ren_conflict.conflict_diag_code == DIAG_NAME_DUPLICATE &&
        tok_mods_ok &&
        !inlays.buffer_mutated &&
        span_valid &&
        !span_stale &&
        ws.codegen_invocations == 0u32
}

pub fn main() -> i32 {
    let mut ws = vfs_workspace_new();
    let mut eng = lsp_engine_new();
    let doc_app = setup_e19_1_workspace(mut_view(ws), mut_view(eng));

    if !run_section_1_session_lifecycle(mut_view(ws), mut_view(eng), doc_app) {
        lsp_driver_free(mut_view(ws), mut_view(eng));
        return 1;
    }
    if !run_section_2_axeditor_unicode_piece_tree() {
        lsp_driver_free(mut_view(ws), mut_view(eng));
        return 2;
    }
    if !run_section_3_generational_ids_and_recovery() {
        lsp_driver_free(mut_view(ws), mut_view(eng));
        return 3;
    }
    if !run_section_4_constraints_rename_and_axcodeeditor(mut_view(ws), mut_view(eng), doc_app) {
        lsp_driver_free(mut_view(ws), mut_view(eng));
        return 4;
    }

    lsp_driver_free(mut_view(ws), mut_view(eng));
    probe_print_str("E19-1-LSP-SERVER-CONFORMANCE-PROBE-PASS\n");
    0
}
