fn main() -> i32 {
    let mut ws = vfs_workspace_new();
    let mut eng = lsp_engine_new();

    let caps = semantic_vcs_capabilities_query();
    if !caps.compiler_db_verified || !caps.zero_codegen_firewall || caps.axdiff_schema != 1u32 {
        return 10;
    }

    let doc0: u32 = 0u32;
    let doc1: u32 = 1u32;
    let src0 = "module pkg.engine\nuse std.io.Write\nuse std.io.Read\npub fn compute(x: i32) -> i32 {\n    let y = x + 1\n    return y * 2\n}\n";
    let sv0 = lsp_str_view(src0);
    let _ = vfs_did_open(
        mut_view(ws),
        doc0,
        vfs_hash_str("file:///workspace/src/engine.ax"),
        1i64,
        sv0.ptr,
        sv0.len,
        0x1111u64,
        0x2222u64
    );

    let src1 = "module pkg.helper\npub fn assist(v: i32) -> i32 {\n    return v\n}\n";
    let sv1 = lsp_str_view(src1);
    let _ = vfs_did_open(
        mut_view(ws),
        doc1,
        vfs_hash_str("file:///workspace/src/helper.ax"),
        1i64,
        sv1.ptr,
        sv1.len,
        0x3333u64,
        0x4444u64
    );

    let ty_i32 = vfs_intern_type(mut_view(ws), doc0, "i32", 72u32, 75u32);
    let fn_compute = vfs_intern_function(mut_view(ws), doc0, "pkg.engine.compute", ty_i32, 58u32, 65u32);
    let sym_compute = vfs_intern_symbol(mut_view(ws), doc0, "pkg.engine.compute", ty_i32, 58u32, 65u32);
    let sym_y = vfs_intern_symbol(mut_view(ws), doc0, "y", ty_i32, 91u32, 92u32);
    let local_y = vfs_intern_local(mut_view(ws), doc0, fn_compute, 1u16, "y", 0u16, ty_i32, OWNERSHIP_OWNED, CAP_NONE, 91u32, 92u32);

    let _ = lsp_register_node(
        mut_view(eng),
        mut_view(ws),
        doc0,
        58u32,
        65u32,
        sym_compute,
        sym_compute.raw,
        fn_compute,
        0u16,
        SYM_KIND_FUNCTION,
        SEM_TOK_FUNCTION,
        0u32,
        true,
        true,
        false,
        false,
        ty_i32,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "compute",
        "pub fn compute(x: i32) -> i32",
        "fn(i32) -> i32",
        "",
        "",
        "Compute engine value."
    );
    let _ = lsp_register_node(
        mut_view(eng),
        mut_view(ws),
        doc0,
        91u32,
        92u32,
        sym_y,
        local_y.raw,
        fn_compute,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        true,
        false,
        false,
        false,
        ty_i32,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "y",
        "let y: i32",
        "i32",
        "",
        "",
        "Immutable local binding."
    );

    // ========================================================================
    // Phase 1: Semantic Refactoring Transforms (`SPEC-102 §2 AXS-REF-010..014`)
    // ========================================================================
    let dummy_cap = extract_capture_var_new(local_y, "", "", true, false, false, false, false, false, false, false, false, false, false);
    let cap_copy = extract_capture_var_new(local_y, "count", "u32", true, false, false, false, true, false, false, true, false, false, false);
    let cap_rview = extract_capture_var_new(local_y, "buf", "Buffer", false, false, false, false, true, false, false, true, false, false, false);
    let cap_mview = extract_capture_var_new(local_y, "acc", "State", false, true, false, false, true, true, false, true, false, false, false);
    let cap_ret = extract_capture_var_new(local_y, "step_out", "u32", true, false, false, false, false, false, false, true, false, true, false);

    let ext_req_ok = ExtractFunctionRequest {
        doc_id: doc0,
        enclosing_fn: fn_compute,
        selection_start: 87u32,
        selection_end: 100u32,
        helper_insert_offset: 51u32,
        new_fn_name_str: lsp_str_view("run_step"),
        is_enclosing_async: true,
        has_await_in_selection: true,
        has_yield_in_selection: false,
        has_unstructured_loop_exit: false,
        has_non_tail_early_return: false,
        has_incomplete_syntax: false,
        error_effect_type_str: lsp_str_view("IoError"),
        generic_params_str: lsp_str_view(""),
        body_text_str: lsp_str_view("    let step_out = count + 1u32"),
        captures: [cap_copy, cap_rview, cap_mview, cap_ret, dummy_cap, dummy_cap, dummy_cap, dummy_cap],
        capture_count: 4u32,
    };
    let ext_res_ok = refactor_extract_function(mut_view(eng), mut_view(ws), view(ext_req_ok));
    if ext_res_ok.status != REFACTOR_OK || ext_res_ok.param_count != 3u32 || ext_res_ok.return_var_count != 1u32 ||
        ext_res_ok.params[0].param_mode != PARAM_MODE_BY_COPY ||
        ext_res_ok.params[1].param_mode != PARAM_MODE_READ_VIEW ||
        ext_res_ok.params[2].param_mode != PARAM_MODE_MUT_VIEW ||
        !ext_res_ok.is_async_helper || !ext_res_ok.has_error_effect {
        return 11;
    }

    let cap_bad_move = extract_capture_var_new(local_y, "owned_pkt", "Packet", false, false, false, false, true, false, true, true, false, false, false);
    let mut ext_req_bad_move = ext_req_ok;
    ext_req_bad_move.captures[0] = cap_bad_move;
    ext_req_bad_move.capture_count = 1u32;
    let ext_res_bad_move = refactor_extract_function(mut_view(eng), mut_view(ws), view(ext_req_bad_move));

    let cap_bad_view = extract_capture_var_new(local_y, "local_slice", "view<u8>", false, false, true, false, false, false, false, true, false, true, true);
    let mut ext_req_bad_view = ext_req_ok;
    ext_req_bad_view.captures[0] = cap_bad_view;
    ext_req_bad_view.capture_count = 1u32;
    let ext_res_bad_view = refactor_extract_function(mut_view(eng), mut_view(ws), view(ext_req_bad_view));
    if ext_res_bad_move.status != REFACTOR_OWNERSHIP_CONFLICT || ext_res_bad_move.diag_code != DIAG_MOVE_USE_AFTER_MOVE ||
        ext_res_bad_view.status != REFACTOR_CAPABILITY_CONFLICT || ext_res_bad_view.diag_code != DIAG_CAP_OUTLIVES_OWNER {
        return 12;
    }

    let ev_req_ok = ExtractVariableRequest {
        doc_id: doc0,
        enclosing_fn: fn_compute,
        stmt_insert_offset: 83u32,
        expr_start: 95u32,
        expr_end: 100u32,
        var_name_str: lsp_str_view("incremented"),
        expr_text_str: lsp_str_view("x + 1"),
        expr_type_str: lsp_str_view("i32"),
        indent_spaces: 4u32,
        is_unit_or_never: false,
        is_lhs_place: false,
        is_expr_pure: true,
        is_expr_copy: true,
        prior_stmt_aliases_expr: false,
        occurrence_count: 2u32,
        second_expr_start: 112u32,
        second_expr_end: 117u32,
        mutated_between_occurrences: false,
    };
    let ev_res_ok = refactor_extract_variable(mut_view(eng), mut_view(ws), view(ev_req_ok));
    let mut ev_req_dup = ev_req_ok;
    ev_req_dup.var_name_str = lsp_str_view("y");
    let ev_res_dup = refactor_extract_variable(mut_view(eng), mut_view(ws), view(ev_req_dup));
    if ev_res_ok.status != REFACTOR_OK || ev_res_ok.replaced_occurrences != 2u32 ||
        ev_res_dup.status != REFACTOR_NAME_COLLISION || ev_res_dup.diag_code != DIAG_NAME_DUPLICATE {
        return 13;
    }

    let inl_req_ok = InlineVariableRequest {
        doc_id: doc0,
        local_id: local_y,
        let_stmt_start: 83u32,
        let_stmt_end: 101u32,
        init_text_str: lsp_str_view("x + 1"),
        is_mutable_binding: false,
        has_definite_init: true,
        is_init_pure: true,
        is_type_copy: true,
        has_observable_drop: false,
        interferes_before_use: false,
        init_precedence: 10u8,
        use_count: 1u32,
        use_starts: [112u32, 0u32, 0u32, 0u32],
        use_ends: [113u32, 0u32, 0u32, 0u32],
        use_context_precedences: [20u8, 0u8, 0u8, 0u8],
    };
    let inl_res_ok = refactor_inline_variable(mut_view(eng), mut_view(ws), view(inl_req_ok));
    let mut inl_req_mut = inl_req_ok;
    inl_req_mut.is_mutable_binding = true;
    let inl_res_mut = refactor_inline_variable(mut_view(eng), mut_view(ws), view(inl_req_mut));
    if inl_res_ok.status != REFACTOR_OK || inl_res_ok.parenthesized_count != 1u32 ||
        !refactor_sv_eq(inl_res_ok.replacement_texts[0], lsp_str_view("(x + 1)")) ||
        inl_res_mut.status != REFACTOR_PRECONDITION_FAILED {
        return 14;
    }

    let v_idle = match_variant_spec_new("Idle", VARIANT_UNIT, "", true);
    let v_pay = match_variant_spec_new("Payload", VARIANT_TUPLE, "v0", false);
    let v_done = match_variant_spec_new("Completed", VARIANT_STRUCT, "bytes, ok", false);
    let pm_req = PopulateMatchArmsRequest {
        doc_id: doc0,
        scrutinee_type_id: ty_i32,
        scrutinee_kind: SCRUTINEE_ENUM,
        enum_path_prefix_str: lsp_str_view("State"),
        variants_imported_unqualified: true,
        insert_offset: 100u32,
        indent_spaces: 8u32,
        bool_true_covered: false,
        bool_false_covered: false,
        has_wildcard_arm: false,
        variants: [v_idle, v_pay, v_done, v_idle, v_idle, v_idle, v_idle, v_idle],
        variant_count: 3u32,
    };
    let pm_res = refactor_populate_match_arms(mut_view(eng), mut_view(ws), view(pm_req));

    let sym_read = LspSymbolId { raw: gen_id_new(10u32, 1u32) };
    let sym_write = LspSymbolId { raw: gen_id_new(11u32, 1u32) };
    let sym_debug = LspSymbolId { raw: gen_id_new(12u32, 1u32) };
    let sym_assist = LspSymbolId { raw: gen_id_new(13u32, 1u32) };
    let imp_dummy = import_entry_spec_new(sym_read, "", "", "", false, false, 0u8, 0u32);
    let imp_w = import_entry_spec_new(sym_write, "std.io", "Write", "", false, false, 0u8, 2u32);
    let imp_r1 = import_entry_spec_new(sym_read, "std.io", "Read", "", false, false, 0u8, 4u32);
    let imp_r2 = import_entry_spec_new(sym_read, "std.io", "Read", "", false, false, 0u8, 4u32);
    let imp_unused = import_entry_spec_new(sym_debug, "std.fmt", "Debug", "", false, false, 0u8, 0u32);
    let imp_pub = import_entry_spec_new(sym_assist, "pkg.helper", "assist", "", true, false, 1u8, 0u32);
    let org_req = OrganizeImportsRequest {
        doc_id: doc0,
        import_block_start: 18u32,
        import_block_end: 50u32,
        entries: [imp_w, imp_r1, imp_r2, imp_unused, imp_pub, imp_dummy, imp_dummy, imp_dummy, imp_dummy, imp_dummy, imp_dummy, imp_dummy],
        entry_count: 5u32,
    };
    let org_res = refactor_organize_imports(mut_view(eng), mut_view(ws), view(org_req));
    if pm_res.status != REFACTOR_OK || pm_res.added_arm_count != 2u32 ||
        org_res.status != REFACTOR_OK || org_res.kept_count != 3u32 ||
        org_res.pruned_unused_count != 1u32 || org_res.merged_group_count != 1u32 {
        return 15;
    }

    let empty_sv = lsp_str_view("");
    let cs_req = ChangeSignatureRequest {
        decl_doc_id: doc0,
        fn_symbol_id: sym_compute,
        decl_span_start: 51u32,
        decl_span_end: 80u32,
        new_decl_sig_str: lsp_str_view("pub fn compute(x: i32, scale: i32) -> i32"),
        removed_param_used_in_body: false,
        removed_arg_is_impure: false,
        added_param_has_placeholder: true,
        call_site_count: 1u32,
        call_doc_ids: [doc1, 0u32, 0u32, 0u32],
        call_starts: [45u32, 0u32, 0u32, 0u32],
        call_ends: [52u32, 0u32, 0u32, 0u32],
        call_new_texts: [lsp_str_view("compute(v, todo())"), empty_sv, empty_sv, empty_sv],
    };
    let cs_res = refactor_change_signature(mut_view(eng), mut_view(ws), view(cs_req));
    let mv_req = MoveItemRequest {
        item_symbol_id: sym_compute,
        src_doc_id: doc0,
        src_item_start: 51u32,
        src_item_end: 120u32,
        src_import_insert_offset: 18u32,
        dst_doc_id: doc1,
        dst_insert_offset: 60u32,
        item_text_str: lsp_str_view("pub fn compute(x: i32) -> i32 { return x }\n"),
        reimport_use_str: lsp_str_view("use pkg.helper.compute\n"),
        violates_orphan_coherence: false,
