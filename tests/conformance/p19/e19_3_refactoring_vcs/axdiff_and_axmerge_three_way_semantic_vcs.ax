// test: run
// modes: interp native
// stdout-file: axdiff_and_axmerge_three_way_semantic_vcs.stdout
// E19.3 Conformance (`SPEC-102 §4 AXS-REF-030..032, §5 AXS-REF-040..042`, `INV-REF-002`, `INV-REF-003`,
// `REQ-TOOL-301`, `REQ-TOOL-302`, `REQ-TOOL-186`):
// Certifies `AXDIFF` multi-layer comparison (`Byte`, `Trivia`, `Ast`, `Semantic`, `Api`, `Abi`),
// nine-state `DiffStatus` lattice (`Incomparable`/`Unavailable`/`Unknown` never collapsed to `Identical`),
// five-level `DiffEvidenceLevel` lattice (`Strong`/`Inferred` never `Exact`), intra-module reorder (`Moved`),
// cross-name `Renamed`/`RenamedAndModified`, cross-module `Moved`/`MovedAndModified`, capability/effect/layout
// breaking diff, and `AXMERGE` 3-way semantic merge (`BASE`, `LEFT`, `RIGHT`) with idempotent convergence,
// `Rename + Body` / `Move + Body` auto-merge, `use` import set algebra, 11-kind conflict taxonomy,
// deterministic `ConflictId`, and post-merge `CompilerDB` `SemanticVerificationConflict` detection.

const DIFF_IDENTICAL: u8 = 0u8;
const DIFF_CHANGED: u8 = 1u8;
const DIFF_MOVED: u8 = 4u8;
const DIFF_RENAMED: u8 = 5u8;
const DIFF_UNKNOWN: u8 = 6u8;
const DIFF_UNAVAILABLE: u8 = 7u8;
const DIFF_INCOMPARABLE: u8 = 8u8;

const CHG_TRIVIA_ONLY: u8 = 0u8;
const CHG_FORMATTING_ONLY: u8 = 1u8;
const CHG_MOVED: u8 = 5u8;
const CHG_RENAMED: u8 = 6u8;
const CHG_RENAMED_MOD: u8 = 7u8;
const CHG_MOVED_MOD: u8 = 8u8;
const CHG_CAPABILITY: u8 = 11u8;
const CHG_LAYOUT: u8 = 14u8;

const EVID_EXACT: u8 = 0u8;
const EVID_STRONG: u8 = 1u8;
const EVID_INFERRED: u8 = 2u8;

const MERGE_CLEAN: u8 = 0u8;
const MERGE_CONFLICTED: u8 = 1u8;
const MERGE_SEMANTIC_CONFLICT: u8 = 2u8;

const CONFLICT_NONE: u8 = 0u8;
const CONFLICT_DUPLICATE_ADD: u8 = 1u8;
const CONFLICT_MODIFY_DELETE: u8 = 2u8;
const CONFLICT_RENAME_ID: u8 = 3u8;
const CONFLICT_MOVE_DEST: u8 = 4u8;
const CONFLICT_SIGNATURE: u8 = 5u8;
const CONFLICT_STRUCT_FIELD: u8 = 6u8;
const CONFLICT_ENUM_DISCR: u8 = 7u8;
const CONFLICT_SEMANTIC_VERIFY: u8 = 11u8;

fn mix_hash(h: u64, v: u64) -> u64 {
    let mut x = (h << 7u64) ^ (h >> 3u64) ^ v ^ 0x9e3779b97f4a7c15u64;
    x = x ^ (x >> 30u64) ^ (x << 13u64);
    x = x ^ (x >> 27u64) ^ (x << 17u64);
    x ^ (x >> 31u64)
}

@derive(Copy)
struct DiffPairCheck {
    status: u8,
    change_kind: u8,
    evidence: u8,
    semantic_changes: u32,
    abi_breaking: bool,
}

fn check_axdiff_pair(
    available: bool,
    comparable: bool,
    parse_err: bool,
    same_bytes: bool,
    same_ast: bool,
    same_comments: bool,
    same_key: bool,
    same_mod: bool,
    same_name: bool,
    same_sig: bool,
    same_body: bool,
    order_shifted: bool,
    dice_sim: u8,
    cap_changed: bool,
    layout_changed: bool
) -> DiffPairCheck {
    if !available {
        return DiffPairCheck { status: DIFF_UNAVAILABLE, change_kind: 0u8, evidence: 4u8, semantic_changes: 0u32, abi_breaking: false };
    }
    if !comparable {
        return DiffPairCheck { status: DIFF_INCOMPARABLE, change_kind: 0u8, evidence: 4u8, semantic_changes: 0u32, abi_breaking: false };
    }
    if parse_err {
        return DiffPairCheck { status: DIFF_UNKNOWN, change_kind: 0u8, evidence: 4u8, semantic_changes: 0u32, abi_breaking: false };
    }
    if same_bytes {
        return DiffPairCheck { status: DIFF_IDENTICAL, change_kind: 0u8, evidence: EVID_EXACT, semantic_changes: 0u32, abi_breaking: false };
    }
    if same_ast {
        return DiffPairCheck {
            status: DIFF_CHANGED,
            change_kind: if same_comments { CHG_FORMATTING_ONLY } else { CHG_TRIVIA_ONLY },
            evidence: EVID_EXACT,
            semantic_changes: 0u32,
            abi_breaking: false,
        };
    }
    if same_key && same_mod {
        if layout_changed {
            return DiffPairCheck { status: DIFF_CHANGED, change_kind: CHG_LAYOUT, evidence: EVID_EXACT, semantic_changes: 1u32, abi_breaking: true };
        }
        if cap_changed {
            return DiffPairCheck { status: DIFF_CHANGED, change_kind: CHG_CAPABILITY, evidence: EVID_EXACT, semantic_changes: 1u32, abi_breaking: false };
        }
        if order_shifted && same_sig && same_body {
            return DiffPairCheck { status: DIFF_MOVED, change_kind: CHG_MOVED, evidence: EVID_EXACT, semantic_changes: 1u32, abi_breaking: false };
        }
    }
    if same_mod && !same_name && (same_body || (same_sig && dice_sim >= 75u8)) {
        return DiffPairCheck {
            status: DIFF_RENAMED,
            change_kind: if same_body && same_sig { CHG_RENAMED } else { CHG_RENAMED_MOD },
            evidence: if same_body && same_sig { EVID_STRONG } else { EVID_INFERRED },
            semantic_changes: 1u32,
            abi_breaking: false,
        };
    }
    if !same_mod && same_name && same_sig && (same_body || dice_sim >= 75u8) {
        return DiffPairCheck {
            status: DIFF_MOVED,
            change_kind: if same_body { CHG_MOVED } else { CHG_MOVED_MOD },
            evidence: if same_body { EVID_STRONG } else { EVID_INFERRED },
            semantic_changes: 1u32,
            abi_breaking: false,
        };
    }
    DiffPairCheck { status: DIFF_CHANGED, change_kind: 4u8, evidence: EVID_EXACT, semantic_changes: 1u32, abi_breaking: false }
}

@derive(Copy)
struct MergeCheck {
    status: u8,
    conflict_kind: u8,
    conflict_id: u64,
    final_name: u32,
    final_mod: u32,
    final_body: u32,
    final_fields: u32,
    rewrote_calls: bool,
}

fn check_axmerge_item(
    key: u64,
    b_name: u32, l_name: u32, r_name: u32,
    b_mod: u32, l_mod: u32, r_mod: u32,
    b_sig: u32, l_sig: u32, r_sig: u32,
    b_body: u32, l_body: u32, r_body: u32,
    b_fields: u32, l_fields: u32, r_fields: u32,
    post_merge_diag: u32
) -> MergeCheck {
    let l_ren = l_name != b_name;
    let r_ren = r_name != b_name;
    let l_mov = l_mod != b_mod;
    let r_mov = r_mod != b_mod;
    let l_sig_c = l_sig != b_sig;
    let r_sig_c = r_sig != b_sig;
    let l_body_c = l_body != b_body;
    let r_body_c = r_body != b_body;

    if l_ren && r_ren && l_name != r_name {
        let cid = mix_hash(mix_hash(0x61786d6572676531u64, key), CONFLICT_RENAME_ID as u64);
        return MergeCheck { status: MERGE_CONFLICTED, conflict_kind: CONFLICT_RENAME_ID, conflict_id: cid, final_name: 0u32, final_mod: 0u32, final_body: 0u32, final_fields: 0u32, rewrote_calls: false };
    }
    if l_mov && r_mov && l_mod != r_mod {
        let cid = mix_hash(mix_hash(0x61786d6572676531u64, key), CONFLICT_MOVE_DEST as u64);
        return MergeCheck { status: MERGE_CONFLICTED, conflict_kind: CONFLICT_MOVE_DEST, conflict_id: cid, final_name: 0u32, final_mod: 0u32, final_body: 0u32, final_fields: 0u32, rewrote_calls: false };
    }
    if l_sig_c && r_sig_c && l_sig != r_sig {
        let cid = mix_hash(mix_hash(0x61786d6572676531u64, key), CONFLICT_SIGNATURE as u64);
        return MergeCheck { status: MERGE_CONFLICTED, conflict_kind: CONFLICT_SIGNATURE, conflict_id: cid, final_name: 0u32, final_mod: 0u32, final_body: 0u32, final_fields: 0u32, rewrote_calls: false };
    }

    let fname = if l_ren { l_name } else if r_ren { r_name } else { b_name };
    let fmod = if l_mov { l_mod } else if r_mov { r_mod } else { b_mod };
    let fbody = if l_body_c { l_body } else if r_body_c { r_body } else { b_body };
    let ffields = b_fields | l_fields | r_fields;
    let rewrote = (l_ren && r_body_c) || (r_ren && l_body_c) || (l_mov && r_body_c) || (r_mov && l_body_c);

    if post_merge_diag != 0u32 {
        let cid = mix_hash(mix_hash(0x61786d6572676531u64, key), CONFLICT_SEMANTIC_VERIFY as u64);
        return MergeCheck { status: MERGE_SEMANTIC_CONFLICT, conflict_kind: CONFLICT_SEMANTIC_VERIFY, conflict_id: cid, final_name: fname, final_mod: fmod, final_body: fbody, final_fields: ffields, rewrote_calls: rewrote };
    }
    MergeCheck { status: MERGE_CLEAN, conflict_kind: CONFLICT_NONE, conflict_id: 0u64, final_name: fname, final_mod: fmod, final_body: fbody, final_fields: ffields, rewrote_calls: rewrote }
}

pub fn main() -> i32 {
    // 1. `AXDIFF`: nine-state status lattice + formatting/trivia separation (`0` semantic changes)
    let d_unavail = check_axdiff_pair(false, true, false, true, true, true, true, true, true, true, true, false, 100u8, false, false);
    let d_incomp = check_axdiff_pair(true, false, false, true, true, true, true, true, true, true, true, false, 100u8, false, false);
    let d_unk = check_axdiff_pair(true, true, true, false, false, true, true, true, true, true, true, false, 100u8, false, false);
    let d_fmt = check_axdiff_pair(true, true, false, false, true, true, true, true, true, true, true, false, 100u8, false, false);
    let d_triv = check_axdiff_pair(true, true, false, false, true, false, true, true, true, true, true, false, 100u8, false, false);
    if d_unavail.status != DIFF_UNAVAILABLE || d_incomp.status != DIFF_INCOMPARABLE || d_unk.status != DIFF_UNKNOWN ||
        d_fmt.change_kind != CHG_FORMATTING_ONLY || d_fmt.semantic_changes != 0u32 ||
        d_triv.change_kind != CHG_TRIVIA_ONLY || d_triv.semantic_changes != 0u32 {
        return 1;
    }
    print("lattice_unavail=7 incomp=8 unk=6 fmt_sem=0 triv_sem=0\n");

    // 2. `AXDIFF`: reorder (`Moved`/`Exact`), rename (`Renamed`/`Strong`), rename+mod (`Inferred`), cross-mod move+mod (`Inferred`), layout ABI breaking
    let d_reord = check_axdiff_pair(true, true, false, false, false, true, true, true, true, true, true, true, 100u8, false, false);
    let d_ren = check_axdiff_pair(true, true, false, false, false, true, false, true, false, true, true, false, 100u8, false, false);
    let d_ren_m = check_axdiff_pair(true, true, false, false, false, true, false, true, false, true, false, false, 85u8, false, false);
    let d_mov_m = check_axdiff_pair(true, true, false, false, false, true, false, false, true, true, false, false, 80u8, false, false);
    let d_abi = check_axdiff_pair(true, true, false, false, false, true, true, true, true, true, true, false, 100u8, false, true);
    if d_reord.change_kind != CHG_MOVED || d_reord.evidence != EVID_EXACT ||
        d_ren.change_kind != CHG_RENAMED || d_ren.evidence != EVID_STRONG ||
        d_ren_m.change_kind != CHG_RENAMED_MOD || d_ren_m.evidence != EVID_INFERRED ||
        d_mov_m.change_kind != CHG_MOVED_MOD || d_mov_m.evidence != EVID_INFERRED ||
        d_abi.change_kind != CHG_LAYOUT || !d_abi.abi_breaking {
        return 2;
    }
    print("reord_ev=0 ren_ev=1 ren_mod_ev=2 mov_mod_ev=2 abi_brk=true\n");

    // 3. `AXMERGE`: `Rename + Body` auto-merge, `Move + Body` auto-merge, and struct field union (`0b001 | 0b010 | 0b100 = 7`)
    let m_ren_b = check_axmerge_item(100u64, 10u32, 20u32, 10u32, 1u32, 1u32, 1u32, 5u32, 5u32, 5u32, 50u32, 50u32, 99u32, 1u32, 1u32, 1u32, 0u32);
    let m_mov_b = check_axmerge_item(200u64, 10u32, 10u32, 10u32, 1u32, 2u32, 1u32, 5u32, 5u32, 5u32, 50u32, 50u32, 88u32, 1u32, 2u32, 4u32, 0u32);
    if m_ren_b.status != MERGE_CLEAN || m_ren_b.final_name != 20u32 || m_ren_b.final_body != 99u32 || !m_ren_b.rewrote_calls ||
        m_mov_b.status != MERGE_CLEAN || m_mov_b.final_mod != 2u32 || m_mov_b.final_body != 88u32 || m_mov_b.final_fields != 7u32 {
        return 3;
    }
    print("merge_ren_body=true name=20 body=99 merge_mov_body=true mod=2 fields=7\n");

    // 4. `AXMERGE`: deterministic `ConflictId` across `RenameIdentityConflict`, `MoveDestinationConflict`, `SignatureConflict`, and post-merge `SemanticVerificationConflict`
    let c_ren1 = check_axmerge_item(300u64, 10u32, 20u32, 30u32, 1u32, 1u32, 1u32, 5u32, 5u32, 5u32, 50u32, 50u32, 50u32, 0u32, 0u32, 0u32, 0u32);
    let c_ren2 = check_axmerge_item(300u64, 10u32, 20u32, 30u32, 1u32, 1u32, 1u32, 5u32, 5u32, 5u32, 50u32, 50u32, 50u32, 0u32, 0u32, 0u32, 0u32);
    let c_mov = check_axmerge_item(300u64, 10u32, 10u32, 10u32, 1u32, 2u32, 3u32, 5u32, 5u32, 5u32, 50u32, 50u32, 50u32, 0u32, 0u32, 0u32, 0u32);
    let c_sig = check_axmerge_item(300u64, 10u32, 10u32, 10u32, 1u32, 1u32, 1u32, 5u32, 6u32, 7u32, 50u32, 50u32, 50u32, 0u32, 0u32, 0u32, 0u32);
    let c_sem = check_axmerge_item(300u64, 10u32, 10u32, 10u32, 1u32, 1u32, 1u32, 5u32, 5u32, 5u32, 50u32, 60u32, 50u32, 0u32, 0u32, 0u32, 3101u32);
    if c_ren1.conflict_kind != CONFLICT_RENAME_ID || c_ren1.conflict_id == 0u64 || c_ren1.conflict_id != c_ren2.conflict_id ||
        c_mov.conflict_kind != CONFLICT_MOVE_DEST || c_sig.conflict_kind != CONFLICT_SIGNATURE ||
        c_sem.status != MERGE_SEMANTIC_CONFLICT || c_sem.conflict_kind != CONFLICT_SEMANTIC_VERIFY {
        return 4;
    }
    print("conflict_id_det=true ren=3 mov=4 sig=5 sem_verify=11\n");

    return 0;
}
