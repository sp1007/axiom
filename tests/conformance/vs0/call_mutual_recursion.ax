// test: run
// exit: 17
// stderr:
// native-after: T033
// F-CALL: mutual recursion (is_odd(7)).
fn is_even(n: i32) -> bool {
    if n == 0 {
        return true
    }
    return is_odd(n - 1)
}

fn is_odd(n: i32) -> bool {
    if n == 0 {
        return false
    }
    return is_even(n - 1)
}

fn main() -> i32 {
    if is_odd(7) {
        return 17
    }
    return 0
}
