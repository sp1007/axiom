// xfail: T117 panic format
// test: run
// exit: 0
// stderr:
// native-after: T037
// AXS-SEM-034: >> on unsigned is logical; << discards bits (no overflow check).
fn main() -> i32 {
    let x: u8 = 128
    if x >> 7 != 1u8 {
        return 1
    }
    if x << 1 != 0u8 {
        return 2
    }
    let y: i32 = 1
    if y << 31 != -2147483648 {
        return 3
    }
    return 0
}
