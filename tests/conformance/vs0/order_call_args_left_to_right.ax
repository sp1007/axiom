fn pick(a: i32, b: i32) -> i32 {
    return a
}

fn shl(n: i32) -> i32 {
    return 1 << n
}

fn div(a: i32, b: i32) -> i32 {
    return a / b
}

fn main() -> i32 {
    return pick(shl(40), div(1, 0))
}
