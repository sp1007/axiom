// test: run
// exit: 0
// stderr:
// AXS-SEM-033: & | ^ ~ act on bit patterns.
fn main() -> i32 {
    let a = 12
    let b = 10
    if a & b != 8 {
        return 1
    }
    if a | b != 14 {
        return 2
    }
    if a ^ b != 6 {
        return 3
    }
    if ~0 != -1 {
        return 4
    }
    if ~0u8 != 255u8 {
        return 5
    }
    return 0
}
