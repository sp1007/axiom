// test: run
// exit: 101
// stderr: panic: division by zero\n
// native-after: T033
// AXS-SEM-040: the left operand panics (division) before the right one (overflow) is evaluated.
fn div(a: i32, b: i32) -> i32 {
    return a / b
}

fn ovf(a: i32) -> i32 {
    return a + 2147483647
}

fn main() -> i32 {
    return div(1, 0) + ovf(1)
}
