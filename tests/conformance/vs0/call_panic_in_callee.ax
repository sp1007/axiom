// xfail: T117 panic format
// test: run
// exit: 101
// stderr: panic: division by zero\n
// native-after: T033
// F-PANIC: a panic deep in the call stack terminates with 101.
fn deep(n: i32) -> i32 {
    if n == 0 {
        let z = 0
        return 1 / z
    }
    return deep(n - 1)
}

fn main() -> i32 {
    return deep(20)
}
