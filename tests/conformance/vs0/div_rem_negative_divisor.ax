// exit: 0
// stderr:
// AXS-SEM-032: 7 % -3 == 1, 7 / -3 == -2, identity a == (a/b)*b + a%b.
fn main() -> i32 {
    let a = 7
    let b = -3
    if a % b != 1 {
        return 1
    }
    if a / b != -2 {
        return 2
    }
    if (a / b) * b + a % b != a {
        return 3
    }
    return 0
}