// test: diff
// exit: 121

enum Result { Ok(i32), Err(i32) }

fn process(val: i32) -> Result {
    if val < 0 {
        return Result.Err(100);
    }
    return Result.Ok(val * 2);
}

fn wrapper(val: i32) -> Result {
    let x = process(val)?;
    return Result.Ok(x + 1);
}

fn main() -> i32 {
    let mut sum = 0;
    
    let r1 = wrapper(10);
    if let Result.Ok(v) = r1 {
        sum = sum + v; // 21
    }
    
    let r2 = wrapper(-5);
    if let Result.Err(e) = r2 {
        sum = sum + e; // 21 + 100 = 121
    }
    
    return sum;
}
