// test: run
// modes: interp native
// stdout-file: negative_diag_version_target_and_corrupt_payloads.stdout
// SPEC-24 AXS-ART-002..005, AXS-ART-013, AXS-ART-022..023, AXS-ART-050, AXS-ART-052:
// Conformance test verifying fail-closed negative diagnostics across `.axmi`, `.axmeta`,
// `.axlto`, and COFF `.obj` containers:
//   - `AX_ART_CORRUPT_HEADER` / `AX_LINK_BAD_ARTIFACT` (9501): bad magic, truncated header,
//     executable container section flags, unverified MIR body (`ownership_verified = false`).
//   - `AX_ART_VERSION_MISMATCH` / `AX_LINK_ARTIFACT_SCHEMA_MISMATCH` (9502): unsupported
//     `schema_version` (`99`, `77`), incompatible `mir_schema_version` (`55`), or unknown
//     mandatory section (`RequiredUnknown`), while unknown `OPTIONAL` (`0x10`) sections succeed.
//   - `AX_ART_TARGET_MISMATCH` / `AX_LINK_ARTIFACT_TARGET_MISMATCH` (9503): mismatched
//     target triple, pointer width, endianness, panic strategy, or required CPU feature mask.
//   - `AX_ART_CHECKSUM_MISMATCH` / `AX_LINK_BAD_ARTIFACT` (9504): bit-flipped payload checksum
//     or cross-section `InterfaceFingerprint` drift between `.axmeta` and `.axlto`.

const STATUS_OK: u32 = 0u32;
const AX_ART_CORRUPT_HEADER: u32 = 9501u32;
const AX_ART_VERSION_MISMATCH: u32 = 9502u32;
const AX_ART_TARGET_MISMATCH: u32 = 9503u32;
const AX_ART_CHECKSUM_MISMATCH: u32 = 9504u32;

const AX_LINK_BAD_ARTIFACT: u32 = 9501u32;
const AX_LINK_ARTIFACT_SCHEMA_MISMATCH: u32 = 9502u32;
const AX_LINK_ARTIFACT_TARGET_MISMATCH: u32 = 9503u32;

const MAGIC_AXMI: u64 = 0x31303030494D5841u64;
const MAGIC_AXMETA: u64 = 0x31304154454D5841u64;
const MAGIC_AXLTO: u64 = 0x3130304F544C5841u64;

const COFF_CHARS_VALID: u32 = 0x42000200u32;
const COFF_CHARS_EXEC: u32 = 0x60000020u32;

const SEC_FLAG_OPTIONAL: u16 = 0x0010u16;

@derive(Copy)
struct ArtifactProbe {
    magic: u64,
    expected_magic: u64,
    total_len: usize,
    schema_version: u16,
    mir_schema_version: u16,
    unknown_sec_type: u16,
    unknown_sec_flags: u16,
    coff_chars: u32,
    ownership_verified: bool,
    target_id: u32,
    expected_target_id: u32,
    req_cpu_features: u32,
    allowed_cpu_features: u32,
    stored_checksum: u64,
    computed_checksum: u64,
    meta_ifp: u64,
    lto_ifp: u64,
}

@derive(Copy)
struct ValidationResult {
    status: u32,
    canonical_link_code: u32,
}

fn validate_artifact(p: view<ArtifactProbe>) -> ValidationResult {
    if (p.total_len) < 64 || p.magic != p.expected_magic || p.coff_chars != COFF_CHARS_VALID {
        return ValidationResult { status: AX_ART_CORRUPT_HEADER, canonical_link_code: AX_LINK_BAD_ARTIFACT };
    }
    if p.schema_version != 1u16 || p.mir_schema_version != 1u16 {
        return ValidationResult { status: AX_ART_VERSION_MISMATCH, canonical_link_code: AX_LINK_ARTIFACT_SCHEMA_MISMATCH };
    }
    if p.unknown_sec_type != 0u16 && (p.unknown_sec_flags & SEC_FLAG_OPTIONAL) == 0u16 {
        return ValidationResult { status: AX_ART_VERSION_MISMATCH, canonical_link_code: AX_LINK_ARTIFACT_SCHEMA_MISMATCH };
    }
    if p.stored_checksum != p.computed_checksum || p.meta_ifp != p.lto_ifp {
        return ValidationResult { status: AX_ART_CHECKSUM_MISMATCH, canonical_link_code: AX_LINK_BAD_ARTIFACT };
    }
    if p.target_id != p.expected_target_id || (p.req_cpu_features & (p.allowed_cpu_features ^ 0xFFFFFFFFu32)) != 0u32 {
        return ValidationResult { status: AX_ART_TARGET_MISMATCH, canonical_link_code: AX_LINK_ARTIFACT_TARGET_MISMATCH };
    }
    if !p.ownership_verified {
        return ValidationResult { status: AX_ART_CORRUPT_HEADER, canonical_link_code: AX_LINK_BAD_ARTIFACT };
    }
    ValidationResult { status: STATUS_OK, canonical_link_code: STATUS_OK }
}

pub fn main() -> i32 {
    let valid_base = ArtifactProbe {
        magic: MAGIC_AXMI,
        expected_magic: MAGIC_AXMI,
        total_len: 512,
        schema_version: 1u16,
        mir_schema_version: 1u16,
        unknown_sec_type: 0u16,
        unknown_sec_flags: 0u16,
        coff_chars: COFF_CHARS_VALID,
        ownership_verified: true,
        target_id: 1u32,
        expected_target_id: 1u32,
        req_cpu_features: 0x03u32,
        allowed_cpu_features: 0x07u32,
        stored_checksum: 0xCAFEBABE12345678u64,
        computed_checksum: 0xCAFEBABE12345678u64,
        meta_ifp: 0x1122334455667788u64,
        lto_ifp: 0x1122334455667788u64,
    };

    let r_ok = validate_artifact(view(valid_base));
    if r_ok.status != STATUS_OK {
        return 1;
    }

    // 1. Corrupt magic & executable COFF characteristics -> AX_ART_CORRUPT_HEADER / AX_LINK_BAD_ARTIFACT
    let mut bad_magic = valid_base;
    bad_magic.magic = 0xDEADBEEFu64;
    let r_magic = validate_artifact(view(bad_magic));

    let mut bad_chars = valid_base;
    bad_chars.coff_chars = COFF_CHARS_EXEC;
    let r_chars = validate_artifact(view(bad_chars));

    if r_magic.status != AX_ART_CORRUPT_HEADER || r_magic.canonical_link_code != AX_LINK_BAD_ARTIFACT ||
       r_chars.status != AX_ART_CORRUPT_HEADER {
        return 2;
    }

    // 2. Schema version mismatch (v99, v77, mir_v55) & unknown mandatory vs optional section
    let mut bad_ver = valid_base;
    bad_ver.schema_version = 99u16;
    let r_ver = validate_artifact(view(bad_ver));

    let mut bad_mir_ver = valid_base;
    bad_mir_ver.mir_schema_version = 55u16;
    let r_mir_ver = validate_artifact(view(bad_mir_ver));

    let mut unk_req = valid_base;
    unk_req.unknown_sec_type = 250u16;
    unk_req.unknown_sec_flags = 0u16;
    let r_unk_req = validate_artifact(view(unk_req));

    let mut unk_opt = valid_base;
    unk_opt.unknown_sec_type = 251u16;
    unk_opt.unknown_sec_flags = SEC_FLAG_OPTIONAL;
    let r_unk_opt = validate_artifact(view(unk_opt));

    if r_ver.status != AX_ART_VERSION_MISMATCH || r_ver.canonical_link_code != AX_LINK_ARTIFACT_SCHEMA_MISMATCH ||
       r_mir_ver.status != AX_ART_VERSION_MISMATCH || r_unk_req.status != AX_ART_VERSION_MISMATCH ||
       r_unk_opt.status != STATUS_OK {
        return 3;
    }

    // 3. Target triple mismatch & required CPU feature mismatch -> AX_ART_TARGET_MISMATCH / AX_LINK_ARTIFACT_TARGET_MISMATCH
    let mut bad_tgt = valid_base;
    bad_tgt.target_id = 2u32;
    let r_tgt = validate_artifact(view(bad_tgt));

    let mut bad_cpu = valid_base;
    bad_cpu.req_cpu_features = 0x07u32;
    bad_cpu.allowed_cpu_features = 0x01u32;
    let r_cpu = validate_artifact(view(bad_cpu));

    if r_tgt.status != AX_ART_TARGET_MISMATCH || r_tgt.canonical_link_code != AX_LINK_ARTIFACT_TARGET_MISMATCH ||
       r_cpu.status != AX_ART_TARGET_MISMATCH {
        return 4;
    }

    // 4. Payload bit-flip checksum mismatch, cross-section fingerprint drift, and unverified MIR
    let mut bad_cksum = valid_base;
    bad_cksum.computed_checksum = valid_base.computed_checksum ^ 1u64;
    let r_cksum = validate_artifact(view(bad_cksum));

    let mut bad_drift = valid_base;
    bad_drift.lto_ifp = valid_base.meta_ifp ^ 0x9999u64;
    let r_drift = validate_artifact(view(bad_drift));

    let mut bad_unver = valid_base;
    bad_unver.ownership_verified = false;
    let r_unver = validate_artifact(view(bad_unver));

    if r_cksum.status != AX_ART_CHECKSUM_MISMATCH || r_cksum.canonical_link_code != AX_LINK_BAD_ARTIFACT ||
       r_drift.status != AX_ART_CHECKSUM_MISMATCH ||
       r_unver.status != AX_ART_CORRUPT_HEADER {
        return 5;
    }

    print("diag_header_and_schema: corrupt_magic=AX_LINK_BAD_ARTIFACT exec_chars=AX_LINK_BAD_ARTIFACT v99=AX_LINK_ARTIFACT_SCHEMA_MISMATCH mir_v55=AX_LINK_ARTIFACT_SCHEMA_MISMATCH req_sec=AX_LINK_ARTIFACT_SCHEMA_MISMATCH opt_sec=OK\n");
    print("diag_target_and_integrity: triple=AX_LINK_ARTIFACT_TARGET_MISMATCH cpu=AX_LINK_ARTIFACT_TARGET_MISMATCH bitflip=AX_LINK_BAD_ARTIFACT fp_drift=AX_LINK_BAD_ARTIFACT unverified_mir=AX_LINK_BAD_ARTIFACT\n");
    print("NEGATIVE-DIAG-VERSION-TARGET-AND-CORRUPT-PAYLOADS-OK\n");
    0
}
