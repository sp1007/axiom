const PROBE_IDENT_TABLE: [183]u8 = [
    99u8, 111u8, 114u8, 101u8, 95u8, 109u8, 97u8, 116u8, 104u8, 99u8, 111u8, 114u8, 101u8, 95u8, 109u8, 97u8, 116u8, 104u8, 46u8, 118u8, 101u8, 99u8, 120u8, 56u8, 54u8, 95u8, 54u8, 52u8, 45u8, 112u8, 99u8, 45u8, 119u8, 105u8, 110u8, 100u8, 111u8, 119u8, 115u8, 45u8, 109u8, 115u8, 118u8, 99u8, 119u8, 105u8, 110u8, 54u8, 52u8, 45u8, 97u8, 98u8, 105u8, 45u8, 118u8, 49u8, 86u8, 101u8, 99u8, 50u8, 100u8, 111u8, 116u8, 95u8, 118u8, 101u8, 99u8, 50u8, 115u8, 99u8, 97u8, 108u8, 101u8, 95u8, 118u8, 101u8, 99u8, 50u8, 104u8, 101u8, 108u8, 112u8, 101u8, 114u8, 95u8, 112u8, 114u8, 105u8, 118u8, 84u8, 77u8, 65u8, 88u8, 95u8, 68u8, 73u8, 77u8, 97u8, 112u8, 112u8, 95u8, 114u8, 101u8, 110u8, 100u8, 101u8, 114u8, 97u8, 112u8, 112u8, 95u8, 114u8, 101u8, 110u8, 100u8, 101u8, 114u8, 46u8, 115u8, 99u8, 101u8, 110u8, 101u8, 114u8, 101u8, 110u8, 100u8, 101u8, 114u8, 95u8, 102u8, 114u8, 97u8, 109u8, 101u8, 115u8, 104u8, 97u8, 100u8, 101u8, 95u8, 112u8, 105u8, 120u8, 101u8, 108u8, 120u8, 56u8, 54u8, 95u8, 54u8, 52u8, 45u8, 117u8, 110u8, 107u8, 110u8, 111u8, 119u8, 110u8, 45u8, 108u8, 105u8, 110u8, 117u8, 120u8, 45u8, 103u8, 110u8, 117u8, 115u8, 121u8, 115u8, 118u8, 54u8, 52u8, 45u8, 97u8, 98u8, 105u8, 45u8, 118u8, 49u8
];

fn init_probe_ascii_buf(abuf: mut_view<AxmiBuffer>) {
    axmi_buf_init(mut_view(*abuf), 256);
    let mut i: usize = 0;
    while i < 183 {
        axmi_buf_push_u8(mut_view(*abuf), PROBE_IDENT_TABLE[i]);
        i = i + 1;
    }
    axmi_buf_push_u8(mut_view(*abuf), 0u8); // index 183
    // opcodes_dot at 184..188
    axmi_buf_push_u8(mut_view(*abuf), 0x10u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x20u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x31u8);
    axmi_buf_push_u8(mut_view(*abuf), 0xFFu8);
    // opcodes_scale at 188..193
    axmi_buf_push_u8(mut_view(*abuf), 0x11u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x22u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x44u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x55u8);
    axmi_buf_push_u8(mut_view(*abuf), 0xFFu8);
    // ops_render at 193..197
    axmi_buf_push_u8(mut_view(*abuf), 0x40u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x41u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x42u8);
    axmi_buf_push_u8(mut_view(*abuf), 0xFFu8);
    // Extra trait/cap identifiers at 197..207: "Metric" (6), "Unbd" (4)
    axmi_buf_push_u8(mut_view(*abuf), 77u8);  // 'M' (197)
    axmi_buf_push_u8(mut_view(*abuf), 101u8); // 'e'
    axmi_buf_push_u8(mut_view(*abuf), 116u8); // 't'
    axmi_buf_push_u8(mut_view(*abuf), 114u8); // 'r'
    axmi_buf_push_u8(mut_view(*abuf), 105u8); // 'i'
    axmi_buf_push_u8(mut_view(*abuf), 99u8);  // 'c' (202)
    axmi_buf_push_u8(mut_view(*abuf), 85u8);  // 'U' (203)
    axmi_buf_push_u8(mut_view(*abuf), 110u8); // 'n'
    axmi_buf_push_u8(mut_view(*abuf), 98u8);  // 'b'
    axmi_buf_push_u8(mut_view(*abuf), 100u8); // 'd' (206)
}

fn probe_sv(abuf: view<AxmiBuffer>, start: usize, count: usize) -> StrView {
    StrView {
        ptr: unsafe { (abuf.ptr as *const u8) + start },
        len: count,
    }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < (a.len) {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn populate_math_unit_full(
    abuf: view<AxmiBuffer>,
    iface: mut_view<AxmiModuleInterface>,
    lto: mut_view<AxLtoContainer>,
    reverse_order: bool,
    max_dim_val: i64
) -> bool {
    let pkg = probe_sv(abuf, 0, 9);     // "core_math"
    let modp = probe_sv(abuf, 9, 13);   // "core_math.vec"
    let trp = probe_sv(abuf, 22, 22);   // "x86_64-pc-windows-msvc"
    let abi = probe_sv(abuf, 44, 12);   // "win64-abi-v1"
    let empty_sv = probe_sv(abuf, 0, 0);

    axmi_set_module_identity(
        mut_view(*iface),
        pkg,
        modp,
        trp,
        abi,
        8u32,
        true,
        0x03u32,
        AXMI_PANIC_NO_PANIC
    );

    let sk_vec2 = semantic_key_new(pkg, modp, ITEM_NS_TYPE, 0u32, probe_sv(abuf, 56, 4), empty_sv);
    let sk_dot = semantic_key_new(pkg, modp, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 60, 8), empty_sv);
    let sk_scale = semantic_key_new(pkg, modp, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 68, 10), probe_sv(abuf, 89, 1));
    let sk_priv = semantic_key_new(pkg, modp, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 78, 11), empty_sv);
    let sk_max = semantic_key_new(pkg, modp, ITEM_NS_CONST, 0u32, probe_sv(abuf, 90, 7), empty_sv);
    let sk_mtr = semantic_key_new(pkg, modp, ITEM_NS_TRAIT, 0u32, probe_sv(abuf, 197, 6), empty_sv);
    let sk_imp = semantic_key_new(pkg, modp, ITEM_NS_TRAIT, 1u32, probe_sv(abuf, 197, 6), probe_sv(abuf, 56, 4));

    let opcodes_dot_ptr = unsafe { (abuf.ptr as *const u8) + 184 };
    let opcodes_scale_ptr = unsafe { (abuf.ptr as *const u8) + 188 };

    if !reverse_order {
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 10u32 }, ITEM_KIND_STRUCT, true, false, false, false, 0u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_vec2);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 11u32 }, ITEM_KIND_FN, true, false, true, false, 2u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_dot);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 12u32 }, ITEM_KIND_FN, true, true, true, false, 2u32, TypeId { v: 1u32 }, 1u32, 1u8, sk_scale);
        let kept_priv = axmi_add_symbol(mut_view(*iface), DefId { v: 13u32 }, ITEM_KIND_FN, false, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_priv);
        if kept_priv {
            return false;
        }
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 14u32 }, ITEM_KIND_CONST, true, false, false, true, 0u32, TypeId { v: 2u32 }, 0u32, 0u8, sk_max);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 15u32 }, ITEM_KIND_TRAIT, true, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 0u8, sk_mtr);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 16u32 }, ITEM_KIND_IMPL, true, false, false, false, 1u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_imp);

        axlto_add_fn_summary(mut_view(*lto), DefId { v: 11u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_EXPORTED, AXMI_PANIC_NO_PANIC, true, 6u32, 12u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 3u32, 3u32, 0x1001u64, 0xAA01u64, sk_dot);
        axlto_add_fn_summary(mut_view(*lto), DefId { v: 12u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_EXPORTED, AXMI_PANIC_NO_PANIC, true, 9u32, 18u32, AXMI_EFF_READS_MEM, AXMI_CAP_NONE, 1u32, 1u32, 0x1002u64, 0xAA02u64, sk_scale);
        axlto_add_fn_summary(mut_view(*lto), DefId { v: 13u32 }, AXLTO_LINK_INTERNAL, AXLTO_ROOT_NONE, AXMI_PANIC_NO_PANIC, false, 4u32, 5u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x1003u64, 0xAA03u64, sk_priv);

        axlto_add_mir_body(mut_view(*lto), DefId { v: 11u32 }, MirBodyId { v: 1u32 }, AXMI_MIR_SCHEMA_VERSION, false, true, false, true, 2u32, 2u32, 4u32, 6u32, opcodes_dot_ptr, 4u32, sk_dot);
        axlto_add_mir_body(mut_view(*lto), DefId { v: 12u32 }, MirBodyId { v: 2u32 }, AXMI_MIR_SCHEMA_VERSION, true, true, false, true, 2u32, 3u32, 5u32, 9u32, opcodes_scale_ptr, 5u32, sk_scale);
    } else {
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 16u32 }, ITEM_KIND_IMPL, true, false, false, false, 1u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_imp);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 15u32 }, ITEM_KIND_TRAIT, true, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 0u8, sk_mtr);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 14u32 }, ITEM_KIND_CONST, true, false, false, true, 0u32, TypeId { v: 2u32 }, 0u32, 0u8, sk_max);
        let kept_priv = axmi_add_symbol(mut_view(*iface), DefId { v: 13u32 }, ITEM_KIND_FN, false, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_priv);
        if kept_priv {
            return false;
        }
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 12u32 }, ITEM_KIND_FN, true, true, true, false, 2u32, TypeId { v: 1u32 }, 1u32, 1u8, sk_scale);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 11u32 }, ITEM_KIND_FN, true, false, true, false, 2u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_dot);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 10u32 }, ITEM_KIND_STRUCT, true, false, false, false, 0u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_vec2);

        axlto_add_fn_summary(mut_view(*lto), DefId { v: 13u32 }, AXLTO_LINK_INTERNAL, AXLTO_ROOT_NONE, AXMI_PANIC_NO_PANIC, false, 4u32, 5u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x1003u64, 0xAA03u64, sk_priv);
        axlto_add_fn_summary(mut_view(*lto), DefId { v: 12u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_EXPORTED, AXMI_PANIC_NO_PANIC, true, 9u32, 18u32, AXMI_EFF_READS_MEM, AXMI_CAP_NONE, 1u32, 1u32, 0x1002u64, 0xAA02u64, sk_scale);
        axlto_add_fn_summary(mut_view(*lto), DefId { v: 11u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_EXPORTED, AXMI_PANIC_NO_PANIC, true, 6u32, 12u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 3u32, 3u32, 0x1001u64, 0xAA01u64, sk_dot);

        axlto_add_mir_body(mut_view(*lto), DefId { v: 12u32 }, MirBodyId { v: 2u32 }, AXMI_MIR_SCHEMA_VERSION, true, true, false, true, 2u32, 3u32, 5u32, 9u32, opcodes_scale_ptr, 5u32, sk_scale);
        axlto_add_mir_body(mut_view(*lto), DefId { v: 11u32 }, MirBodyId { v: 1u32 }, AXMI_MIR_SCHEMA_VERSION, false, true, false, true, 2u32, 2u32, 4u32, 6u32, opcodes_dot_ptr, 4u32, sk_dot);
    }

    axmi_add_type_def(mut_view(*iface), TypeId { v: 1u32 }, DefId { v: 10u32 }, AXMI_ADT_STRUCT, AXMI_REPR_C, 16u32, 8u32, true, true, true, sk_vec2);
    axmi_add_type_field(mut_view(*iface), TypeId { v: 1u32 }, TypeId { v: 2u32 });
    axmi_add_type_field(mut_view(*iface), TypeId { v: 1u32 }, TypeId { v: 2u32 });

    axmi_add_trait_impl(mut_view(*iface), TraitGoalKey { v: 1u32 }, DefId { v: 15u32 }, TypeId { v: 1u32 }, DefId { v: 16u32 }, 1u32, true, 0u32, sk_imp);

    axmi_add_fn_contract(mut_view(*iface), DefId { v: 11u32 }, 2u32, 0u32, 3u32, AXMI_EFF_PURE, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_dot);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 11u32 }, 0u32, AXMI_PASS_COPY);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 11u32 }, 1u32, AXMI_PASS_COPY);

    axmi_add_fn_contract(mut_view(*iface), DefId { v: 12u32 }, 2u32, 1u32, 1u32, AXMI_EFF_READS_MEM, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_scale);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 12u32 }, 0u32, AXMI_PASS_VIEW);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 12u32 }, 1u32, AXMI_PASS_COPY);

    axmi_add_const_val(mut_view(*iface), ConstEvalKey { v: 1u32 }, DefId { v: 14u32 }, TypeId { v: 2u32 }, AXMI_CONST_INT, max_dim_val, 0u64, empty_sv, sk_max);
    let ok_mir = axmi_add_mir_template(mut_view(*iface), DefId { v: 12u32 }, MirBodyId { v: 2u32 }, AXMI_MIR_SCHEMA_VERSION, true, true, false, 1u32, 2u32, 3u32, 5u32, 9u32, true, ConstEvalKey { v: 1u32 }, DefId { v: 15u32 }, 0xAA02u64, sk_scale);
    if !ok_mir {
        return false;
    }

    // Reject unverified MIR template (INV-PIPE-002)
    let bad_mir = axmi_add_mir_template(mut_view(*iface), DefId { v: 13u32 }, MirBodyId { v: 99u32 }, AXMI_MIR_SCHEMA_VERSION, false, true, false, 0u32, 1u32, 1u32, 1u32, 2u32, false, ConstEvalKey { v: 0u32 }, DefId { v: 0u32 }, 0x9999u64, sk_priv);
    if bad_mir {
        return false;
    }

    axlto_add_call_edge(mut_view(*lto), DefId { v: 12u32 }, DefId { v: 11u32 }, 2u32, 90u32, true, true, sk_dot);
    true
}

fn verify_multimodule_and_byte_identical_emission(abuf: view<AxmiBuffer>) -> bool {
    let mut iface_a = axmi_interface_empty();
    let mut lto_a = axlto_container_empty();
    let mut iface_b = axmi_interface_empty();
    let mut lto_b = axlto_container_empty();
    axmi_interface_init(mut_view(iface_a));
    axlto_container_init(mut_view(lto_a));
    axmi_interface_init(mut_view(iface_b));
    axlto_container_init(mut_view(lto_b));

    if !populate_math_unit_full(abuf, mut_view(iface_a), mut_view(lto_a), false, 256i64) ||
       !populate_math_unit_full(abuf, mut_view(iface_b), mut_view(lto_b), true, 256i64) {
        axmi_interface_free(mut_view(iface_a));
        axlto_container_free(mut_view(lto_a));
        axmi_interface_free(mut_view(iface_b));
        axlto_container_free(mut_view(lto_b));
        return false;
    }

    // 1. Byte-identical `.axmi` serialization across forward vs reverse registration order & repeated runs
    let mut axmi_a = axmi_buf_empty();
    let mut axmi_b = axmi_buf_empty();
    let mut axmi_repeat = axmi_buf_empty();
    axmi_buf_init(mut_view(axmi_a), 2048);
    axmi_buf_init(mut_view(axmi_b), 2048);
    axmi_buf_init(mut_view(axmi_repeat), 2048);

    let aid_a = axmi_serialize(mut_view(iface_a), mut_view(axmi_a));
    let aid_b = axmi_serialize(mut_view(iface_b), mut_view(axmi_b));
    let aid_rep = axmi_serialize(mut_view(iface_a), mut_view(axmi_repeat));

    if !axmi_buf_eq(view(axmi_a), view(axmi_b)) ||
       !axmi_buf_eq(view(axmi_a), view(axmi_repeat)) ||
       !fingerprint128_eq(aid_a.content_hash, aid_b.content_hash) ||
       !fingerprint128_eq(aid_a.content_hash, aid_rep.content_hash) {
        axmi_buf_free(mut_view(axmi_repeat));
        axmi_buf_free(mut_view(axmi_b));
        axmi_buf_free(mut_view(axmi_a));
        axmi_interface_free(mut_view(iface_a));
        axlto_container_free(mut_view(lto_a));
        axmi_interface_free(mut_view(iface_b));
        axlto_container_free(mut_view(lto_b));
        return false;
    }

    // Verify private helper `helper_priv` was stripped from `.axmi` (`REQ-LNK-540`)
    if axmi_has_symbol_named(view(iface_a), probe_sv(abuf, 78, 11)) || iface_a.stripped_private_count != 1u32 {
        axmi_buf_free(mut_view(axmi_repeat));
        axmi_buf_free(mut_view(axmi_b));
        axmi_buf_free(mut_view(axmi_a));
        axmi_interface_free(mut_view(iface_a));
        axlto_container_free(mut_view(lto_a));
        axmi_interface_free(mut_view(iface_b));
        axlto_container_free(mut_view(lto_b));
        return false;
    }

    // 2. Byte-identical COFF `.obj` emission with embedded `.axmeta`, `.axlto`, `.axmir`
    let mut obj_a = axmi_buf_empty();
    let mut obj_b = axmi_buf_empty();
    axmi_buf_init(mut_view(obj_a), 2048);
    axmi_buf_init(mut_view(obj_b), 2048);
    container_write_axiom_coff_obj(mut_view(iface_a), mut_view(lto_a), true, 64, 32, mut_view(obj_a));
    container_write_axiom_coff_obj(mut_view(iface_b), mut_view(lto_b), true, 64, 32, mut_view(obj_b));

    if !axmi_buf_eq(view(obj_a), view(obj_b)) {
        axmi_buf_free(mut_view(obj_b));
        axmi_buf_free(mut_view(obj_a));
        axmi_buf_free(mut_view(axmi_repeat));
        axmi_buf_free(mut_view(axmi_b));
        axmi_buf_free(mut_view(axmi_a));
        axmi_interface_free(mut_view(iface_a));
        axlto_container_free(mut_view(lto_a));
        axmi_interface_free(mut_view(iface_b));
        axlto_container_free(mut_view(lto_b));
        return false;
    }

    // 3. Round-trip extract `.axmeta` and `.axlto` from COFF `.obj` and ingest into source-free `CompilerDB`
    let exp_tgt = axmi_target_expectation_new(probe_sv(abuf, 22, 22), probe_sv(abuf, 44, 12), 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);
    let mut loaded_meta = axmi_interface_empty();
    let mut loaded_lto = axlto_container_empty();
    axmi_interface_init(mut_view(loaded_meta));
    axlto_container_init(mut_view(loaded_lto));

    let eres = container_extract_coff_obj(
        obj_a.ptr as *const u8,
        obj_a.len,
        view(exp_tgt),
        mut_view(loaded_meta),
        mut_view(loaded_lto)
    );
    if eres.status != AXMI_STATUS_OK || !eres.has_axmeta || !eres.has_axlto || !eres.has_axmir {
        axmi_interface_free(mut_view(loaded_meta));
        axlto_container_free(mut_view(loaded_lto));
        axmi_buf_free(mut_view(obj_b));
        axmi_buf_free(mut_view(obj_a));
        axmi_buf_free(mut_view(axmi_repeat));
        axmi_buf_free(mut_view(axmi_b));
        axmi_buf_free(mut_view(axmi_a));
        axmi_interface_free(mut_view(iface_a));
        axlto_container_free(mut_view(lto_a));
        axmi_interface_free(mut_view(iface_b));
        axlto_container_free(mut_view(lto_b));
        return false;
    }

    // Verify `inspect --axmi` dump is byte-identical before and after round-trip
    let mut dump_a = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut dump_b = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dump_a));
    diag_buf_init(mut_view(dump_b));
    axmi_inspect_dump(view(iface_a), mut_view(dump_a));
    axmi_inspect_dump(view(loaded_meta), mut_view(dump_b));
    let dumps_match = diag_buf_eq(view(dump_a), view(dump_b));
    diag_buf_free(mut_view(dump_a));
    diag_buf_free(mut_view(dump_b));
    if !dumps_match {
        axmi_interface_free(mut_view(loaded_meta));
        axlto_container_free(mut_view(loaded_lto));
        axmi_buf_free(mut_view(obj_b));
        axmi_buf_free(mut_view(obj_a));
        axmi_buf_free(mut_view(axmi_repeat));
        axmi_buf_free(mut_view(axmi_b));
        axmi_buf_free(mut_view(axmi_a));
        axmi_interface_free(mut_view(iface_a));
        axlto_container_free(mut_view(lto_a));
        axmi_interface_free(mut_view(iface_b));
        axlto_container_free(mut_view(lto_b));
        return false;
    }

    // Ingest into `CompilerDB` and verify all queries across generics, traits, capabilities, and consts
    let mut db = query_db_empty();
    query_db_init(mut_view(db), 767u64);
    let ing_ok = axmi_populate_compiler_db(mut_view(db), view(loaded_meta), ModuleId { v: 2u32 }, PackageId { v: 1u32 }, UnitKey { v: 1u32 });
    let pm = query_parse_module(mut_view(db), ModuleId { v: 2u32 });
    let dm = query_module_def_map(mut_view(db), ModuleId { v: 2u32 });
    let rm = query_resolve_module(mut_view(db), ModuleId { v: 2u32 });
    let sig_dot = query_item_signature(mut_view(db), DefId { v: 11u32 });
    let lay_vec = query_layout_of(mut_view(db), TypeId { v: 1u32 });
    let tr_vec = query_trait_solve(mut_view(db), TraitGoalKey { v: 1u32 });
    let eff_scl = query_effect_summary(mut_view(db), DefId { v: 12u32 });
    let cst_max = query_const_eval(mut_view(db), ConstEvalKey { v: 1u32 });
    let mir_scl = query_mir_body(mut_view(db), DefId { v: 12u32 });
    let cap_con = axmi_find_contract_by_def(view(loaded_meta), DefId { v: 12u32 });

    let queries_ok = ing_ok &&
        !pm.has_parse_error &&
        dm.exported_count == 6u32 &&
        !rm.has_resolve_error &&
        sig_dot.param_count == 2u32 &&
        lay_vec.size_bytes == 16u32 &&
        lay_vec.align_bytes == 8u32 &&
        tr_vec.status == TRAIT_RESULT_IMPLEMENTED &&
        tr_vec.impl_def_id.v == 16u32 &&
        eff_scl.effect_mask == AXMI_EFF_READS_MEM &&
        !eff_scl.is_pure &&
        cst_max.int_val == 256i64 &&
        mir_scl.ownership_verified &&
        mir_scl.block_count == 3u32 &&
        cap_con.param_modes[0] == AXMI_PASS_VIEW &&
        cap_con.return_borrows_from_mask == 1u32 &&
        cap_con.no_escape_mask == 1u32 &&
        db.total_provider_runs == 0u32 &&
        db.total_memo_hits == 9u32;

    if !queries_ok {
        query_db_free(mut_view(db));
        axmi_interface_free(mut_view(loaded_meta));
        axlto_container_free(mut_view(loaded_lto));
        axmi_buf_free(mut_view(obj_b));
        axmi_buf_free(mut_view(obj_a));
        axmi_buf_free(mut_view(axmi_repeat));
        axmi_buf_free(mut_view(axmi_b));
        axmi_buf_free(mut_view(axmi_a));
        axmi_interface_free(mut_view(iface_a));
        axlto_container_free(mut_view(lto_a));
        axmi_interface_free(mut_view(iface_b));
        axlto_container_free(mut_view(lto_b));
        return false;
    }

    // Instantiate generic `scale_vec2<Vec2>` across module boundary using `impl Metric for Vec2`
    let inst_ok = axmi_instantiate_generic_mir(
        mut_view(db),
        view(loaded_meta),
        probe_sv(abuf, 68, 10),
        TypeId { v: 1u32 },
        probe_sv(abuf, 56, 4),
        ModuleId { v: 3u32 },
        DefId { v: 30u32 }
    );
    // Unbounded type `TypeId { v: 99 }` without `impl Metric` fails closed
    let inst_bad = axmi_instantiate_generic_mir(
        mut_view(db),
        view(loaded_meta),
        probe_sv(abuf, 68, 10),
        TypeId { v: 99u32 },
        probe_sv(abuf, 203, 4),
        ModuleId { v: 3u32 },
        DefId { v: 31u32 }
    );
    query_db_free(mut_view(db));

    if inst_ok.is_error || !inst_ok.ownership_verified || inst_ok.block_count != 3u32 || !inst_bad.is_error {
        axmi_interface_free(mut_view(loaded_meta));
        axlto_container_free(mut_view(loaded_lto));
        axmi_buf_free(mut_view(obj_b));
        axmi_buf_free(mut_view(obj_a));
        axmi_buf_free(mut_view(axmi_repeat));
        axmi_buf_free(mut_view(axmi_b));
        axmi_buf_free(mut_view(axmi_a));
        axmi_interface_free(mut_view(iface_a));
        axlto_container_free(mut_view(lto_a));
        axmi_interface_free(mut_view(iface_b));
        axlto_container_free(mut_view(lto_b));
        return false;
    }

    // 4. Standalone `.axpkg` round-trip
    let mut pkg_buf_a = axmi_buf_empty();
    let mut pkg_buf_b = axmi_buf_empty();
    axmi_buf_init(mut_view(pkg_buf_a), 4096);
    axmi_buf_init(mut_view(pkg_buf_b), 4096);
    let _ = axpkg_serialize(mut_view(iface_a), mut_view(lto_a), obj_a.ptr as *const u8, obj_a.len, mut_view(pkg_buf_a));
    let _ = axpkg_serialize(mut_view(iface_b), mut_view(lto_b), obj_b.ptr as *const u8, obj_b.len, mut_view(pkg_buf_b));

    let mut pkg_meta = axmi_interface_empty();
    let mut pkg_lto = axlto_container_empty();
    axmi_interface_init(mut_view(pkg_meta));
    axlto_container_init(mut_view(pkg_lto));
    let pres = axpkg_deserialize(pkg_buf_a.ptr as *const u8, pkg_buf_a.len, view(exp_tgt), mut_view(pkg_meta), mut_view(pkg_lto));
    let pkg_ok = axmi_buf_eq(view(pkg_buf_a), view(pkg_buf_b)) && pres.status == AXMI_STATUS_OK && pres.coff_obj_size == (obj_a.len as u32);

    // 5. Freshness & semantic diff verification (`AXS-ART-014`)
    let mut iface_const_mod = axmi_interface_empty();
    let mut lto_const_mod = axlto_container_empty();
    let mut axmi_const_mod = axmi_buf_empty();
    axmi_interface_init(mut_view(iface_const_mod));
    axlto_container_init(mut_view(lto_const_mod));
    axmi_buf_init(mut_view(axmi_const_mod), 2048);
    let _ = populate_math_unit_full(abuf, mut_view(iface_const_mod), mut_view(lto_const_mod), false, 512i64);
    let _ = axmi_serialize(mut_view(iface_const_mod), mut_view(axmi_const_mod));

    let diff_same = axmi_diff_interfaces(view(loaded_meta), view(iface_b));
    let fresh_same = axmi_check_freshness(view(loaded_meta), view(exp_tgt), iface_b.interface_fingerprint, iface_b.abi_fingerprint);
    let diff_const = axmi_diff_interfaces(view(loaded_meta), view(iface_const_mod));
    let fresh_const = axmi_check_freshness(view(loaded_meta), view(exp_tgt), iface_const_mod.interface_fingerprint, iface_const_mod.abi_fingerprint);
    let fresh_unk = axmi_check_freshness(view(loaded_meta), view(exp_tgt), fingerprint128_new(0u64, 0u64), loaded_meta.abi_fingerprint);
    let linux_tgt = axmi_target_expectation_new(probe_sv(abuf, 146, 24), probe_sv(abuf, 170, 13), 8u32, true, 0x07u32, AXMI_PANIC_NO_PANIC);
    let fresh_inv = axmi_check_freshness(view(loaded_meta), view(linux_tgt), loaded_meta.interface_fingerprint, loaded_meta.abi_fingerprint);

    let fresh_ok = !diff_same.api_changed && !diff_same.abi_changed && fresh_same == AXMI_FRESHNESS_FRESH &&
        diff_const.api_changed && diff_const.const_changed && fresh_const == AXMI_FRESHNESS_STALE &&
        fresh_unk == AXMI_FRESHNESS_UNKNOWN && fresh_inv == AXMI_FRESHNESS_INVALID;

    axmi_buf_free(mut_view(axmi_const_mod));
    axmi_interface_free(mut_view(iface_const_mod));
    axlto_container_free(mut_view(lto_const_mod));
    axmi_interface_free(mut_view(pkg_meta));
    axlto_container_free(mut_view(pkg_lto));
    axmi_buf_free(mut_view(pkg_buf_b));
    axmi_buf_free(mut_view(pkg_buf_a));
    axmi_interface_free(mut_view(loaded_meta));
    axlto_container_free(mut_view(loaded_lto));
    axmi_buf_free(mut_view(obj_b));
    axmi_buf_free(mut_view(obj_a));
    axmi_buf_free(mut_view(axmi_repeat));
    axmi_buf_free(mut_view(axmi_b));
    axmi_buf_free(mut_view(axmi_a));
    axmi_interface_free(mut_view(iface_a));
    axlto_container_free(mut_view(lto_a));
    axmi_interface_free(mut_view(iface_b));
    axlto_container_free(mut_view(lto_b));

    pkg_ok && fresh_ok
}

fn verify_lto_archive_and_pe_stripping(abuf: view<AxmiBuffer>) -> bool {
    let mut math_iface = axmi_interface_empty();
    let mut math_lto = axlto_container_empty();
    axmi_interface_init(mut_view(math_iface));
    axlto_container_init(mut_view(math_lto));
    let _ = populate_math_unit_full(abuf, mut_view(math_iface), mut_view(math_lto), false, 256i64);
    axmi_recompute_fingerprints(mut_view(math_iface));

    let mut app_iface = axmi_interface_empty();
    let mut app_lto = axlto_container_empty();
    axmi_interface_init(mut_view(app_iface));
    axlto_container_init(mut_view(app_lto));

    let app_pkg = probe_sv(abuf, 97, 10);
    let app_mod = probe_sv(abuf, 107, 16);
    let trp = probe_sv(abuf, 22, 22);
    let abi = probe_sv(abuf, 44, 12);
    let empty_sv = probe_sv(abuf, 0, 0);

    axmi_set_module_identity(mut_view(app_iface), app_pkg, app_mod, trp, abi, 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);
    let sk_render = semantic_key_new(app_pkg, app_mod, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 123, 12), empty_sv);
    let sk_shade = semantic_key_new(app_pkg, app_mod, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 135, 11), empty_sv);
    let sk_dot = semantic_key_new(probe_sv(abuf, 0, 9), probe_sv(abuf, 9, 13), ITEM_NS_VALUE, 0u32, probe_sv(abuf, 60, 8), empty_sv);

    let _ = axmi_add_symbol(mut_view(app_iface), DefId { v: 20u32 }, ITEM_KIND_FN, true, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_render);
    axmi_add_dependency(mut_view(app_iface), AXMI_DEP_SEMANTIC_INPUT, probe_sv(abuf, 9, 13), math_iface.interface_fingerprint, math_iface.abi_fingerprint);

    let ops_render_ptr = unsafe { (abuf.ptr as *const u8) + 193 };
    axlto_add_fn_summary(mut_view(app_lto), DefId { v: 20u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_ENTRY, AXMI_PANIC_NO_PANIC, false, 14u32, 25u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x2001u64, 0xBB01u64, sk_render);
    axlto_add_fn_summary(mut_view(app_lto), DefId { v: 21u32 }, AXLTO_LINK_INTERNAL, AXLTO_ROOT_NONE, AXMI_PANIC_NO_PANIC, true, 5u32, 8u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x2002u64, 0xBB02u64, sk_shade);
    axlto_add_call_edge(mut_view(app_lto), DefId { v: 20u32 }, DefId { v: 11u32 }, 3u32, 120u32, true, true, sk_dot);
    axlto_add_call_edge(mut_view(app_lto), DefId { v: 20u32 }, DefId { v: 21u32 }, 1u32, 40u32, true, true, sk_shade);
    axlto_add_mir_body(mut_view(app_lto), DefId { v: 20u32 }, MirBodyId { v: 10u32 }, AXMI_MIR_SCHEMA_VERSION, false, false, false, true, 1u32, 2u32, 3u32, 14u32, ops_render_ptr, 4u32, sk_render);

    let mut obj_math = axmi_buf_empty();
    let mut obj_app = axmi_buf_empty();
    let mut obj_foreign = axmi_buf_empty();
    axmi_buf_init(mut_view(obj_math), 2048);
    axmi_buf_init(mut_view(obj_app), 2048);
    axmi_buf_init(mut_view(obj_foreign), 512);
    container_write_axiom_coff_obj(mut_view(math_iface), mut_view(math_lto), true, 96, 48, mut_view(obj_math));
    container_write_axiom_coff_obj(mut_view(app_iface), mut_view(app_lto), false, 128, 32, mut_view(obj_app));
    container_write_foreign_coff_obj(48, 16, 2u32, mut_view(obj_foreign));

    let exp_tgt = axmi_target_expectation_new(trp, abi, 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);

    // 1. Link `obj_math` + `obj_app` into PE32+ `.exe` and `.dll`
    let mut sess_exe = container_link_session_new(exp_tgt);
    let _ = container_link_add_coff_obj(mut_view(sess_exe), obj_math.ptr as *const u8, obj_math.len);
    let _ = container_link_add_coff_obj(mut_view(sess_exe), obj_app.ptr as *const u8, obj_app.len);
    let mut pe_exe = axmi_buf_empty();
    axmi_buf_init(mut_view(pe_exe), 4096);
    let res_exe = container_link_finalize_pe_image(mut_view(sess_exe), PE_IMAGE_KIND_EXE, mut_view(pe_exe));
    container_link_session_free(mut_view(sess_exe));

    let mut sess_dll = container_link_session_new(exp_tgt);
    let _ = container_link_add_coff_obj(mut_view(sess_dll), obj_math.ptr as *const u8, obj_math.len);
    let _ = container_link_add_coff_obj(mut_view(sess_dll), obj_app.ptr as *const u8, obj_app.len);
    let mut pe_dll = axmi_buf_empty();
    axmi_buf_init(mut_view(pe_dll), 4096);
    let res_dll = container_link_finalize_pe_image(mut_view(sess_dll), PE_IMAGE_KIND_DLL, mut_view(pe_dll));
    container_link_session_free(mut_view(sess_dll));

    // 2. Build mixed COFF `.lib` archive (`obj_math` + `obj_foreign`) and link to `.exe`
    let mut ar_buf = axmi_buf_empty();
    axmi_buf_init(mut_view(ar_buf), 4096);
    container_write_coff_archive_begin(mut_view(ar_buf));
    container_write_coff_archive_add_member(mut_view(ar_buf), 0, obj_math.ptr as *const u8, obj_math.len);
    container_write_coff_archive_add_member(mut_view(ar_buf), 1, obj_foreign.ptr as *const u8, obj_foreign.len);
    let ares = container_extract_coff_archive(ar_buf.ptr as *const u8, ar_buf.len, view(exp_tgt));

    let mut sess_ar = container_link_session_new(exp_tgt);
    let _ = container_link_add_coff_archive(mut_view(sess_ar), ar_buf.ptr as *const u8, ar_buf.len);
    let mut pe_ar = axmi_buf_empty();
    axmi_buf_init(mut_view(pe_ar), 4096);
    let res_ar = container_link_finalize_pe_image(mut_view(sess_ar), PE_IMAGE_KIND_EXE, mut_view(pe_ar));
    container_link_session_free(mut_view(sess_ar));

    // 3. Verify PE stripper rejects injected `.axmeta` section name or `"AXMETA01"` magic in `.text`
    let mut bad_pe = axmi_buf_empty();
    axmi_buf_init(mut_view(bad_pe), 4096);
    axmi_buf_push_bytes(mut_view(bad_pe), pe_exe.ptr as *const u8, pe_exe.len);
    unsafe {
        *(bad_pe.ptr + 328 + 0) = 46u8;
        *(bad_pe.ptr + 328 + 1) = 97u8;
        *(bad_pe.ptr + 328 + 2) = 120u8;
        *(bad_pe.ptr + 328 + 3) = 109u8;
        *(bad_pe.ptr + 328 + 4) = 101u8;
        *(bad_pe.ptr + 328 + 5) = 116u8;
        *(bad_pe.ptr + 328 + 6) = 97u8;
        *(bad_pe.ptr + 328 + 7) = 0u8;
    }
    let v_bad_sec = container_verify_pe_image_stripped(bad_pe.ptr as *const u8, bad_pe.len);

    bad_pe.len = 0;
    axmi_buf_push_bytes(mut_view(bad_pe), pe_exe.ptr as *const u8, pe_exe.len);
    let mut mi: usize = 0;
    while mi < 8 {
        unsafe { *(bad_pe.ptr + 520 + mi) = AXMETA_MAGIC[mi]; }
        mi = mi + 1;
    }
    let v_bad_magic = container_verify_pe_image_stripped(bad_pe.ptr as *const u8, bad_pe.len);

    let ok = res_exe.status == AXMI_STATUS_OK &&
        res_exe.pe_clean_verified &&
        res_exe.stripped_container_sections == 5u32 &&
        res_exe.merged_runtime_sections == 2u32 &&
        res_exe.lto_total_functions == 5u32 &&
        res_exe.lto_inlined_calls == 6u32 &&
        res_exe.lto_dead_stripped_functions == 2u32 &&
        res_dll.status == AXMI_STATUS_OK &&
        res_dll.pe_clean_verified &&
        ares.status == AXMI_STATUS_OK &&
        ares.member_count == 2u32 &&
        ares.axiom_member_count == 1u32 &&
        ares.foreign_member_count == 1u32 &&
        res_ar.status == AXMI_STATUS_OK &&
        res_ar.pe_clean_verified &&
        !v_bad_sec.is_stripped_clean &&
        v_bad_sec.has_axmeta_section &&
        !v_bad_magic.is_stripped_clean &&
        v_bad_magic.leaked_magic_count == 1u32;

    axmi_buf_free(mut_view(bad_pe));
    axmi_buf_free(mut_view(pe_ar));
    axmi_buf_free(mut_view(ar_buf));
    axmi_buf_free(mut_view(pe_dll));
    axmi_buf_free(mut_view(pe_exe));
    axmi_buf_free(mut_view(obj_foreign));
    axmi_buf_free(mut_view(obj_app));
    axmi_buf_free(mut_view(obj_math));
    axmi_interface_free(mut_view(app_iface));
    axlto_container_free(mut_view(app_lto));
    axmi_interface_free(mut_view(math_iface));
    axlto_container_free(mut_view(math_lto));
    ok
}

fn verify_negative_diagnostics(abuf: view<AxmiBuffer>) -> bool {
    let mut iface = axmi_interface_empty();
    let mut lto = axlto_container_empty();
    axmi_interface_init(mut_view(iface));
    axlto_container_init(mut_view(lto));
    let _ = populate_math_unit_full(abuf, mut_view(iface), mut_view(lto), false, 256i64);

    let mut axmi_buf = axmi_buf_empty();
    let mut meta_buf = axmi_buf_empty();
    let mut lto_buf = axmi_buf_empty();
    axmi_buf_init(mut_view(axmi_buf), 2048);
    axmi_buf_init(mut_view(meta_buf), 2048);
    axmi_buf_init(mut_view(lto_buf), 2048);
    let _ = axmi_serialize(mut_view(iface), mut_view(axmi_buf));
    let _ = axmeta_serialize(mut_view(iface), mut_view(meta_buf));
    axlto_bind_to_interface(mut_view(lto), view(iface));
    let _ = axlto_serialize(mut_view(lto), mut_view(lto_buf));

    let win_tgt = axmi_target_expectation_new(probe_sv(abuf, 22, 22), probe_sv(abuf, 44, 12), 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);
    let linux_tgt = axmi_target_expectation_new(probe_sv(abuf, 146, 24), probe_sv(abuf, 170, 13), 8u32, true, 0x07u32, AXMI_PANIC_NO_PANIC);
    let weak_cpu_tgt = axmi_target_expectation_new(probe_sv(abuf, 22, 22), probe_sv(abuf, 44, 12), 8u32, true, 0x01u32, AXMI_PANIC_NO_PANIC);
    let any_tgt = axmi_target_expectation_any();

    let mut out_m = axmi_interface_empty();
    let mut out_l = axlto_container_empty();
    axmi_interface_init(mut_view(out_m));
    axlto_container_init(mut_view(out_l));

    // 1. `.axmi` corrupt magic, schema_version=99, target mismatch, and payload bit-flip
    unsafe { *(axmi_buf.ptr + 0) = 88u8; }
    let r_axmi_magic = axmi_deserialize(axmi_buf.ptr as *const u8, axmi_buf.len, view(win_tgt), mut_view(out_m));
    unsafe { *(axmi_buf.ptr + 0) = 65u8; }

    unsafe { *(axmi_buf.ptr + 10) = 99u8; }
    let r_axmi_ver = axmi_deserialize(axmi_buf.ptr as *const u8, axmi_buf.len, view(win_tgt), mut_view(out_m));
    unsafe { *(axmi_buf.ptr + 10) = (AXMI_FORMAT_VERSION & 0xFFu16) as u8; }

    let r_axmi_tgt = axmi_deserialize(axmi_buf.ptr as *const u8, axmi_buf.len, view(linux_tgt), mut_view(out_m));
    let r_axmi_cpu = axmi_deserialize(axmi_buf.ptr as *const u8, axmi_buf.len, view(weak_cpu_tgt), mut_view(out_m));

    let flip_idx = axmi_buf.len - 8;
    let orig_b = unsafe { *(axmi_buf.ptr + flip_idx) };
    unsafe { *(axmi_buf.ptr + flip_idx) = orig_b ^ 0xFFu8; }
    let r_axmi_cksum = axmi_deserialize(axmi_buf.ptr as *const u8, axmi_buf.len, view(win_tgt), mut_view(out_m));
    unsafe { *(axmi_buf.ptr + flip_idx) = orig_b; }

    // 2. Embedded `.axmeta` & `.axlto` inside COFF `.obj`: corrupt magic, version mismatch, target mismatch, checksum mismatch, executable section flags, and MIR schema mismatch
    let mut bad_meta = axmi_buf_empty();
    let mut bad_lto = axmi_buf_empty();
    let mut obj_buf = axmi_buf_empty();
    axmi_buf_init(mut_view(bad_meta), 2048);
    axmi_buf_init(mut_view(bad_lto), 2048);
    axmi_buf_init(mut_view(obj_buf), 4096);

    axmi_buf_push_bytes(mut_view(bad_meta), meta_buf.ptr as *const u8, meta_buf.len);
    unsafe { *(bad_meta.ptr + 10) = 99u8; }
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, bad_meta.ptr as *const u8, bad_meta.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r_meta_ver = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));

    bad_meta.len = 0;
    axmi_buf_push_bytes(mut_view(bad_meta), meta_buf.ptr as *const u8, meta_buf.len);
    let m_flip = bad_meta.len - 8;
    unsafe { *(bad_meta.ptr + m_flip) = (*(bad_meta.ptr + m_flip)) ^ 0xAAu8; }
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, bad_meta.ptr as *const u8, bad_meta.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r_meta_cksum = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));

    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, meta_buf.ptr as *const u8, meta_buf.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r_obj_tgt = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(linux_tgt), mut_view(out_m), mut_view(out_l));

    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, meta_buf.ptr as *const u8, meta_buf.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_TEXT_CHARS, 1u32, mut_view(obj_buf));
    let r_exec_chars = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));

    // 3. Unknown mandatory vs unknown optional section in `.axlto`
    let mut lto_mand = axlto_container_empty();
    axlto_container_init(mut_view(lto_mand));
    let _ = populate_math_unit_full(abuf, mut_view(iface), mut_view(lto_mand), false, 256i64);
    axlto_bind_to_interface(mut_view(lto_mand), view(iface));
    axlto_add_custom_section(mut_view(lto_mand), 90u32, 250u16, AXMI_SEC_DEFAULT_FLAGS, 0xCAFEu64);
    bad_lto.len = 0;
    let _ = axlto_serialize(mut_view(lto_mand), mut_view(bad_lto));
    let r_mand = axlto_deserialize(bad_lto.ptr as *const u8, bad_lto.len, view(any_tgt), mut_view(out_l));
    axlto_container_free(mut_view(lto_mand));

    let mut lto_opt = axlto_container_empty();
    axlto_container_init(mut_view(lto_opt));
    let _ = populate_math_unit_full(abuf, mut_view(iface), mut_view(lto_opt), false, 256i64);
    axlto_bind_to_interface(mut_view(lto_opt), view(iface));
    axlto_add_custom_section(mut_view(lto_opt), 91u32, 251u16, AXMI_SEC_DEFAULT_FLAGS | AXMI_SEC_FLAG_OPTIONAL, 0xBEEFu64);
    bad_lto.len = 0;
    let _ = axlto_serialize(mut_view(lto_opt), mut_view(bad_lto));
    let r_opt = axlto_deserialize(bad_lto.ptr as *const u8, bad_lto.len, view(any_tgt), mut_view(out_l));
    axlto_container_free(mut_view(lto_opt));

    // 4. Bounds overflow checks (`AXS-ART-003`)
    let bounds_ok = !axmi_check_bounds(0xFFFFFFFFFFFFFFF0u64, 0x20u64, 1024u64) &&
        !axmi_check_bounds(600u64, 500u64, 1024u64) &&
        axmi_check_bounds(128u64, 256u64, 1024u64);

    let all_ok = r_axmi_magic.status == AX_ART_CORRUPT_HEADER &&
        r_axmi_magic.canonical_diag_code == AX_LINK_BAD_ARTIFACT &&
        r_axmi_ver.status == AX_ART_VERSION_MISMATCH &&
        r_axmi_ver.canonical_diag_code == AX_LINK_ARTIFACT_SCHEMA_MISMATCH &&
        r_axmi_ver.found_version == 99u16 &&
        r_axmi_tgt.status == AX_ART_TARGET_MISMATCH &&
        r_axmi_tgt.canonical_diag_code == AX_LINK_ARTIFACT_TARGET_MISMATCH &&
        r_axmi_cpu.status == AX_ART_TARGET_MISMATCH &&
        r_axmi_cksum.status == AX_ART_CHECKSUM_MISMATCH &&
        r_axmi_cksum.canonical_diag_code == AX_LINK_BAD_ARTIFACT &&
        r_meta_ver.status == AX_ART_VERSION_MISMATCH &&
        r_meta_ver.canonical_diag_code == AX_LINK_ARTIFACT_SCHEMA_MISMATCH &&
        r_meta_cksum.status == AX_ART_CHECKSUM_MISMATCH &&
        r_meta_cksum.canonical_diag_code == AX_LINK_BAD_ARTIFACT &&
        r_obj_tgt.status == AX_ART_TARGET_MISMATCH &&
        r_obj_tgt.canonical_diag_code == AX_LINK_ARTIFACT_TARGET_MISMATCH &&
        r_exec_chars.status == AX_ART_CORRUPT_HEADER &&
        r_mand.status == AX_ART_VERSION_MISMATCH &&
        r_opt.status == AXMI_STATUS_OK &&
        bounds_ok;

    axmi_buf_free(mut_view(obj_buf));
    axmi_buf_free(mut_view(bad_lto));
    axmi_buf_free(mut_view(bad_meta));
    axmi_interface_free(mut_view(out_m));
    axlto_container_free(mut_view(out_l));
    axmi_buf_free(mut_view(lto_buf));
    axmi_buf_free(mut_view(meta_buf));
    axmi_buf_free(mut_view(axmi_buf));
    axmi_interface_free(mut_view(iface));
    axlto_container_free(mut_view(lto));
    all_ok
}

pub fn main() -> i32 {
    let mut abuf = axmi_buf_empty();
    init_probe_ascii_buf(mut_view(abuf));

    if !verify_multimodule_and_byte_identical_emission(view(abuf)) {
        axmi_buf_free(mut_view(abuf));
        return 1;
    }
    print("axmi_and_axmeta_multimodule_generics_traits_caps_consts_ok=true\n");
    print("byte_identical_axmi_obj_lib_and_pkg_emission_ok=true\n");
    print("freshness_early_cutoff_and_semantic_diff_ok=true\n");

    if !verify_lto_archive_and_pe_stripping(view(abuf)) {
        axmi_buf_free(mut_view(abuf));
        return 2;
    }
    print("lto_mir_roundtrip_archive_and_pe_exe_dll_stripping_ok=true\n");

    if !verify_negative_diagnostics(view(abuf)) {
        axmi_buf_free(mut_view(abuf));
        return 3;
    }
    print("negative_diagnostics_corrupt_version_and_target_mismatch_ok=true\n");

    axmi_buf_free(mut_view(abuf));
    print("E18-4-ARTIFACTS-AXMI-LTO-CONFORMANCE-PASS\n");
    0
}
