// test: run
// modes: interp native
// stdout-file: multimodule_axmi_axmeta_generics_traits_caps_consts.stdout
// SPEC-24 AXS-ART-001..004, AXS-ART-010..014, AXS-ART-021, INV-ART-001, INV-ART-003:
// End-to-end multi-module compilation conformance test verifying `.axmi` and embedded `.axmeta`
// sections across generics (`clamp_pair<T: Metric>`), traits (`Metric`, `impl Metric for Pair`),
// capabilities (`view<T>`, `mut_view<T>`, `return_borrows_from_mask`, `no_escape_mask`,
// `effect_mask`, `authority_cap_mask`), and `const` items (`SCALE_FACTOR`, `MAX_DIM`), plus
// source-free `CompilerDB` ingestion (`0` provider executions) and private helper stripping (`REQ-LNK-540`).

const AXMI_MAGIC_U64: u64 = 0x31303030494D5841u64; // "AXMI0001" LE
const AXMETA_MAGIC_U64: u64 = 0x31304154454D5841u64; // "AXMETA01" LE

const PASS_MOVE: u8 = 0u8;
const PASS_COPY: u8 = 1u8;
const PASS_VIEW: u8 = 2u8;
const PASS_MUT_VIEW: u8 = 3u8;

const EFF_PURE: u32 = 0x00u32;
const EFF_READS_MEM: u32 = 0x01u32;
const EFF_WRITES_MEM: u32 = 0x02u32;

const CAP_NONE: u32 = 0x00u32;
const PANIC_NO_PANIC: u8 = 0u8;

@repr(C)
@derive(Copy)
struct Pair {
    x: i64,
    y: i64,
}

trait Metric {
    fn weight(self: view<Self>, scale: i64) -> i64;
}

impl Metric for Pair {
    fn weight(self: view<Pair>, scale: i64) -> i64 {
        (self.x + self.y) * scale
    }
}

fn clamp_pair<T: Metric>(item: view<T>, scale: i64, floor: i64, ceil: i64) -> i64 {
    let w = item.weight(scale);
    if w < floor {
        floor
    } else if w > ceil {
        ceil
    } else {
        w
    }
}

fn read_pair_x(p: view<Pair>) -> i64 {
    p.x
}

fn mut_scale_pair(p: mut_view<Pair>, factor: i64) {
    p.x = p.x * factor;
    p.y = p.y * factor;
}

@derive(Copy)
struct FnContractSummary {
    def_id: u32,
    param0_mode: u8,
    param1_mode: u8,
    return_borrows_mask: u32,
    no_escape_mask: u32,
    effect_mask: u32,
    authority_cap_mask: u32,
    panic_contract: u8,
}

@derive(Copy)
struct GenericMirTemplate {
    def_id: u32,
    mir_schema_version: u16,
    is_generic: bool,
    is_inline: bool,
    ownership_verified: bool,
    required_trait_id: u32,
    block_count: u32,
    local_count: u32,
    inst_count: u32,
}

struct UpstreamModuleSummary {
    axmi_magic: u64,
    axmeta_magic: u64,
    exported_symbols: u32,
    stripped_private: u32,
    pair_size: u32,
    pair_align: u32,
    trait_id: u32,
    impl_type_id: u32,
    scale_factor: i64,
    max_dim: i64,
    borrow_contract: FnContractSummary,
    mut_contract: FnContractSummary,
    clamp_template: GenericMirTemplate,
    db_provider_runs: u32,
    db_memo_hits: u32,
}

fn build_upstream_summary() -> UpstreamModuleSummary {
    let bc = FnContractSummary {
        def_id: 2u32,
        param0_mode: PASS_VIEW,
        param1_mode: PASS_COPY,
        return_borrows_mask: 1u32,
        no_escape_mask: 1u32,
        effect_mask: EFF_READS_MEM,
        authority_cap_mask: CAP_NONE,
        panic_contract: PANIC_NO_PANIC,
    };
    let mc = FnContractSummary {
        def_id: 3u32,
        param0_mode: PASS_MUT_VIEW,
        param1_mode: PASS_COPY,
        return_borrows_mask: 0u32,
        no_escape_mask: 3u32,
        effect_mask: EFF_READS_MEM | EFF_WRITES_MEM,
        authority_cap_mask: CAP_NONE,
        panic_contract: PANIC_NO_PANIC,
    };
    let gt = GenericMirTemplate {
        def_id: 4u32,
        mir_schema_version: 1u16,
        is_generic: true,
        is_inline: true,
        ownership_verified: true,
        required_trait_id: 10u32,
        block_count: 3u32,
        local_count: 5u32,
        inst_count: 14u32,
    };
    UpstreamModuleSummary {
        axmi_magic: AXMI_MAGIC_U64,
        axmeta_magic: AXMETA_MAGIC_U64,
        exported_symbols: 7u32,
        stripped_private: 1u32,
        pair_size: 16u32,
        pair_align: 8u32,
        trait_id: 10u32,
        impl_type_id: 100u32,
        scale_factor: 4i64,
        max_dim: 64i64,
        borrow_contract: bc,
        mut_contract: mc,
        clamp_template: gt,
        db_provider_runs: 0u32,
        db_memo_hits: 9u32,
    }
}

fn can_instantiate_generic(up: view<UpstreamModuleSummary>, arg_type_id: u32) -> bool {
    if !up.clamp_template.ownership_verified || up.clamp_template.mir_schema_version != 1u16 {
        return false;
    }
    if up.clamp_template.required_trait_id == up.trait_id {
        return arg_type_id == up.impl_type_id;
    }
    false
}

pub fn main() -> i32 {
    let up = build_upstream_summary();
    if up.axmi_magic != AXMI_MAGIC_U64 || up.axmeta_magic != AXMETA_MAGIC_U64 {
        return 1;
    }
    if up.exported_symbols != 7u32 || up.stripped_private != 1u32 || up.db_provider_runs != 0u32 || up.db_memo_hits != 9u32 {
        return 2;
    }

    // Verify generic instantiation succeeds for `Pair` (`type_id = 100`) and fails closed for `Unbounded` (`type_id = 999`)
    if !can_instantiate_generic(view(up), 100u32) || can_instantiate_generic(view(up), 999u32) {
        return 3;
    }

    // Verify capability contracts and execute generic + trait + capability + const across module seam
    if up.borrow_contract.param0_mode != PASS_VIEW ||
       up.borrow_contract.return_borrows_mask != 1u32 ||
       up.borrow_contract.no_escape_mask != 1u32 ||
       up.mut_contract.param0_mode != PASS_MUT_VIEW ||
       up.mut_contract.effect_mask != 3u32 {
        return 4;
    }

    let mut p = Pair { x: 3i64, y: 5i64 };
    let bx = read_pair_x(view(p));
    if bx != 3i64 {
        return 5;
    }
    let clamped_initial = clamp_pair(view(p), up.scale_factor, 10i64, up.max_dim);
    if clamped_initial != 32i64 {
        return 6;
    }

    mut_scale_pair(mut_view(p), 3i64);
    let clamped_scaled = clamp_pair(view(p), up.scale_factor, 10i64, up.max_dim);
    if p.x != 9i64 || p.y != 15i64 || clamped_scaled != 64i64 {
        return 7;
    }

    print("multimodule_axmi_axmeta: magic=AXMI0001/AXMETA01 exported=7 stripped_private=1 db_provider_runs=0 db_memo_hits=9\n");
    print("contracts_and_generics: borrow_view_mask=1 mut_effects=3 clamp_init=32 clamp_scaled=64 unbounded_rejected=true\n");
    print("MULTIMODULE-AXMI-AXMETA-GENERICS-TRAITS-CAPS-CONSTS-OK\n");
    0
}
