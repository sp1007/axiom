@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

unsafe fn probe_data_entry_at(base: *mut DiagDataEntry, idx: usize) -> *const DiagDataEntry {
    let off = ((idx as isize) * (size_of<DiagDataEntry>() as isize)) as usize;
    ((base as usize) + off) as *const DiagDataEntry
}

unsafe fn probe_interval_at(base: *mut LiveRangeAllocEntry, idx: usize) -> *mut LiveRangeAllocEntry {
    let off = ((idx as isize) * (size_of<LiveRangeAllocEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut LiveRangeAllocEntry
}

unsafe fn probe_spill_at(base: *mut SpillSlotEntry, idx: usize) -> *mut SpillSlotEntry {
    let off = ((idx as isize) * (size_of<SpillSlotEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut SpillSlotEntry
}

unsafe fn probe_sched_node_at(base: *mut ScheduleNodeEntry, idx: usize) -> *mut ScheduleNodeEntry {
    let off = ((idx as isize) * (size_of<ScheduleNodeEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut ScheduleNodeEntry
}

unsafe fn probe_sched_edge_at(base: *mut ScheduleDepEdge, idx: usize) -> *mut ScheduleDepEdge {
    let off = ((idx as isize) * (size_of<ScheduleDepEdge>() as isize)) as usize;
    ((base as usize) + off) as *mut ScheduleDepEdge
}

fn build_sample_mir_body(arena: mut_view<Arena>, with_drop_stmt: bool) -> MirBody {
    let sp = Span { file: FileId { v: 1u32 }, start: 0u32, end: 10u32 };
    let body_p = mir_body_new(mut_view(*arena));
    let mut body = unsafe { *body_p };

    let _l0 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_RETURN, true, StrId { v: 0u32 }, view(sp));
    let _l1 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_ARG, false, StrId { v: 0u32 }, view(sp));
    let _l2 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_USER, true, StrId { v: 0u32 }, view(sp));

    let b0 = mir_add_bb(mut_view(body), mut_view(*arena), false);
    let b1 = mir_add_bb(mut_view(body), mut_view(*arena), false);

    let bb0_p = unsafe { mir_bb_at(body.bbs, b0.v as usize) };
    let st_scratch = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*st_scratch), MIR_STMT_ASSIGN);
        mir_place_reset_u32(mut_view((*st_scratch).place), 0u32);
        (*st_scratch).rvalue.kind = MIR_RVALUE_USE;
        (*st_scratch).rvalue.use_op.kind = MIR_OP_CONST;
        (*st_scratch).rvalue.use_op.constant.kind = MIR_CONST_INT;
        (*st_scratch).rvalue.use_op.constant.val = 42u64;
        mir_bb_push_stmt(mut_view(*bb0_p), mut_view(*arena), view(*st_scratch));

        if with_drop_stmt {
            mir_stmt_zero(mut_view(*st_scratch), MIR_STMT_DROP);
            mir_place_reset_u32(mut_view((*st_scratch).place), 2u32);
            mir_bb_push_stmt(mut_view(*bb0_p), mut_view(*arena), view(*st_scratch));
        }

        mir_term_zero(mut_view((*bb0_p).terminator), MIR_TERM_GOTO);
        (*bb0_p).terminator.goto_target.v = b1.v;
        (*bb0_p).has_terminator = true;
    }

    let bb1_p = unsafe { mir_bb_at(body.bbs, b1.v as usize) };
    unsafe {
        mir_term_zero(mut_view((*bb1_p).terminator), MIR_TERM_RETURN);
        (*bb1_p).has_terminator = true;
    }
    body
}

// =================================================================================================
// Stage 1: PassContract Registry, 3-Valued Certainty, Semantic Firewall & ProofStore DAG (AXS-PCT-001..011, 015)
// =================================================================================================
fn probe_e18_5_pipeline_contracts_and_certainty(arena: mut_view<Arena>) -> bool {
    if ir_level_to_u8(IrLevel.Hir) != IR_LEVEL_HIR ||
       ir_level_to_u8(IrLevel.Mir) != IR_LEVEL_MIR ||
       ir_level_to_u8(IrLevel.OptIr) != IR_LEVEL_OPT_IR ||
       ir_level_to_u8(IrLevel.MachIr) != IR_LEVEL_MACH_IR {
        return false;
    }
    if pct_analysis_kind_bit(AnalysisKind.Cfg) != PCT_MASK_CFG ||
       pct_analysis_kind_bit(AnalysisKind.EffectSummary) != PCT_MASK_EFFECT_SUMMARY {
        return false;
    }

    let req_eff = pct_analysis_expand_required(PCT_MASK_EFFECT_SUMMARY);
    let expected_deps = PCT_MASK_CFG | PCT_MASK_DOM_TREE | PCT_MASK_SSA_DEF_USE | PCT_MASK_MEMORY_SSA | PCT_MASK_ALIAS_SUMMARY | PCT_MASK_EFFECT_SUMMARY;
    if (req_eff & expected_deps) != expected_deps {
        return false;
    }
    let inv_cfg = pct_analysis_expand_invalidated(PCT_MASK_CFG);
    if (inv_cfg & expected_deps) != expected_deps || (inv_cfg & PCT_MASK_VALUE_RANGE) == 0u32 {
        return false;
    }

    let mut pid: u16 = 0u16;
    while (pid as usize) < PCT_CANONICAL_PASS_COUNT {
        let c = pct_canonical_contract(pid);
        if !pct_validate_contract_declaration(view(c)) {
            return false;
        }
        pid = pid + 1u16;
    }

    let mut bad1 = pct_canonical_contract(PCT_PASS_OPT_BCE);
    bad1.invalidated_analyses = bad1.invalidated_analyses | PCT_MASK_CFG;
    let mut bad2 = pct_canonical_contract(PCT_PASS_OPT_BCE);
    bad2.preserved_properties = SEM_PROP_CFG_WELL_FORMED;
    if pct_validate_contract_declaration(view(bad1)) || pct_validate_contract_declaration(view(bad2)) {
        return false;
    }

    if certainty_to_u8(certainty_from_u8(CERTAINTY_PROVEN)) != CERTAINTY_PROVEN ||
       certainty_to_u8(certainty_from_u8(CERTAINTY_POSSIBLE)) != CERTAINTY_POSSIBLE ||
       certainty_to_u8(certainty_from_u8(CERTAINTY_UNKNOWN)) != CERTAINTY_UNKNOWN {
        return false;
    }
    if certainty_and(CERTAINTY_PROVEN, CERTAINTY_PROVEN) != CERTAINTY_PROVEN ||
       certainty_and(CERTAINTY_PROVEN, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE ||
       certainty_and(CERTAINTY_POSSIBLE, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN ||
       certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_UNKNOWN) != CERTAINTY_POSSIBLE ||
       certainty_degrade_on_boundary(CERTAINTY_PROVEN, true, false, false, false) != CERTAINTY_UNKNOWN ||
       certainty_degrade_on_boundary(CERTAINTY_PROVEN, false, true, false, false) != CERTAINTY_UNKNOWN ||
       certainty_degrade_on_boundary(CERTAINTY_PROVEN, false, false, true, false) != CERTAINTY_UNKNOWN ||
       certainty_degrade_on_boundary(CERTAINTY_PROVEN, false, false, false, true) != CERTAINTY_POSSIBLE {
        return false;
    }

    let high_profit = ProfitabilityFact { estimated_benefit: 10000i32, threshold: 5i32, hotness_weight: 1000u32 };
    let low_profit = ProfitabilityFact { estimated_benefit: 1i32, threshold: 50i32, hotness_weight: 1u32 };
    if !pct_semantic_firewall_gate(CERTAINTY_PROVEN, view(high_profit)) ||
       pct_semantic_firewall_gate(CERTAINTY_PROVEN, view(low_profit)) ||
       pct_semantic_firewall_gate(CERTAINTY_POSSIBLE, view(high_profit)) ||
       pct_semantic_firewall_gate(CERTAINTY_UNKNOWN, view(high_profit)) {
        return false;
    }

    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 0u32,
        current_snapshot_revision: 0u32,
        allow_trusted_boundaries: true,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(*arena), 1u32, true);

    let c0 = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        10u32,
        20u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_CFG,
        0u64,
        0u32,
        SymbolId { v: 10u32 }
    );
    let c0_comm = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        20u32,
        10u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_CFG,
        0u64,
        0u32,
        SymbolId { v: 10u32 }
    );
    if c0 != 0u32 || c0_comm != c0 || store.cache_hits != 1u32 || store.cert_count != 1 {
        return false;
    }

    let c1 = proof_store_issue(
        mut_view(store),
        PROP_LOOP_INVARIANT,
        CERTAINTY_PROVEN,
        30u32,
        0u32,
        2u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_DOM_TREE,
        1u64 << (c0 as u64),
        0u32,
        SymbolId { v: 10u32 }
    );
    let c2 = proof_store_issue(
        mut_view(store),
        PROP_DEAD_STORE,
        CERTAINTY_PROVEN,
        40u32,
        0u32,
        3u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_VALUE_RANGE,
        1u64 << (c1 as u64),
        0u32,
        SymbolId { v: 10u32 }
    );
    if !proof_store_is_cert_usable(view(store), c1) || !proof_store_is_cert_usable(view(store), c2) {
        return false;
    }
    proof_store_invalidate_cert(mut_view(store), c0);
    if proof_store_is_cert_usable(view(store), c0) ||
       proof_store_is_cert_usable(view(store), c1) ||
       proof_store_is_cert_usable(view(store), c2) ||
       proof_store_get_cert_certainty(view(store), c2) != CERTAINTY_UNKNOWN {
        return false;
    }

    let c3 = proof_store_issue(
        mut_view(store),
        PROP_IN_BOUNDS,
        CERTAINTY_PROVEN,
        50u32,
        60u32,
        4u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_DOM_TREE,
        0u64,
        0u32,
        SymbolId { v: 10u32 }
    );
    proof_store_invalidate_by_analyses(mut_view(store), PCT_MASK_CFG);
    if proof_store_is_cert_usable(view(store), c3) {
        return false;
    }

    let c_untrusted = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        70u32,
        71u32,
        6u32,
        FACT_ORIGIN_TRUSTED_BOUNDARY,
        PCT_ANALYSIS_CFG,
        0u64,
        0u32,
        SymbolId { v: 10u32 }
    );
    let c_trusted = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        72u32,
        73u32,
        7u32,
        FACT_ORIGIN_TRUSTED_BOUNDARY,
        PCT_ANALYSIS_CFG,
        0u64,
        99u32,
        SymbolId { v: 10u32 }
    );
    if proof_store_is_cert_usable(view(store), c_untrusted) ||
       !proof_store_is_cert_usable(view(store), c_trusted) ||
       store.audit_count != 1 {
        return false;
    }
    proof_store_notify_ir_mutation(mut_view(store), 72u32, PCT_MASK_SSA_DEF_USE);
    !proof_store_is_cert_usable(view(store), c_trusted)
}

// =================================================================================================
// Stage 2: Shared Dataflow Fixed-Point, Multi-Category Effects & Symbolic Domains (AXS-PCT-012..014)
// =================================================================================================
fn probe_e18_5_dataflow_effects_and_symbolic() -> bool {
    let gen_masks: [3]u64 = [1u64, 2u64, 4u64];
    let kill_masks: [3]u64 = [0u64, 0u64, 0u64];
    let p_gen = unsafe { address_of(gen_masks[0]) };
    let p_kill = unsafe { address_of(kill_masks[0]) };

    let fp_fwd = pct_solve_monotone_fixpoint(PCT_DATAFLOW_FORWARD, p_gen, p_kill, 3, 0u64, 8u32);
    let fp_bwd = pct_solve_monotone_fixpoint(PCT_DATAFLOW_BACKWARD, p_gen, p_kill, 3, 0u64, 8u32);
    let fp_exh = pct_solve_monotone_fixpoint(PCT_DATAFLOW_FORWARD, p_gen, p_kill, 3, 0u64, 1u32);
    if !fp_fwd.converged || fp_fwd.certainty != CERTAINTY_PROVEN || fp_fwd.final_state != 7u64 ||
       !fp_bwd.converged || fp_bwd.certainty != CERTAINTY_PROVEN || fp_bwd.final_state != 7u64 ||
       fp_exh.converged || fp_exh.certainty != CERTAINTY_UNKNOWN {
        return false;
    }

    let eff_pure = pct_effect_summary_pure();
    let eff_unk = pct_effect_summary_unknown();
    let eff_joined = pct_effect_summary_join(view(eff_pure), view(eff_unk));
    let eff_drop = pct_effect_summary_with_implicit_drop(view(eff_pure), view(eff_pure));
    let mut eff_trace = pct_effect_summary_pure();
    eff_trace.has_debug_profile_trace = true;
    let mut eff_entropy = pct_effect_summary_pure();
    eff_entropy.reads_entropy_or_clock = true;

    if !pct_effect_can_dce_or_hoist(view(eff_pure)) ||
       !pct_effect_can_memoize_comptime(view(eff_pure)) ||
       pct_effect_can_dce_or_hoist(view(eff_unk)) ||
       eff_joined.memory != MEM_EFF_UNKNOWN ||
       eff_drop.resource != RES_EFF_RELEASES_OR_DROPS ||
       pct_effect_can_dce_or_hoist(view(eff_drop)) ||
       !pct_effect_can_dce_or_hoist(view(eff_trace)) ||
       pct_effect_can_dce_or_hoist(view(eff_entropy)) ||
       pct_effect_can_memoize_comptime(view(eff_entropy)) {
        return false;
    }

    let mut cb_read = pct_effect_summary_pure();
    cb_read.memory = MEM_EFF_READS_ONLY;
    let mut bound_local = pct_effect_summary_pure();
    bound_local.memory = MEM_EFF_WRITES_LOCAL_ONLY;
    let mut cb_ffi = pct_effect_summary_pure();
    cb_ffi.memory = MEM_EFF_WRITES_GLOBAL_OR_HEAP;
    cb_ffi.external = EXT_EFF_FFI_BOUNDARY;
    let eff_scc = pct_effect_propagate_scc(view(eff_pure), view(cb_read), true);
    let mut bad_schema = pct_effect_summary_pure();
    bad_schema.schema_version = 99u32;

    if !pct_effect_callback_within_bound(view(cb_read), view(bound_local)) ||
       pct_effect_callback_within_bound(view(cb_ffi), view(bound_local)) ||
       eff_scc.control != CTRL_EFF_MAY_DIVERGE ||
       pct_effect_can_dce_or_hoist(view(bad_schema)) {
        return false;
    }

    let dom_pos = sym_domain_range(64u8, false, 1u64, 100u64);
    let dom_maybe_zero = sym_domain_range(64u8, false, 0u64, 100u64);
    let mut dom_congr = sym_domain_top(64u8, false);
    dom_congr.stride = 4u64;
    dom_congr.offset = 2u64;
    if sym_prove_non_zero(view(dom_pos), 16u32) != CERTAINTY_PROVEN ||
       sym_prove_non_zero(view(dom_congr), 16u32) != CERTAINTY_PROVEN ||
       sym_prove_non_zero(view(dom_maybe_zero), 16u32) != CERTAINTY_POSSIBLE ||
       sym_prove_non_zero(view(dom_pos), 0u32) != CERTAINTY_UNKNOWN {
        return false;
    }

    let dom_sh_ok = sym_domain_range(64u8, false, 0u64, 63u64);
    let dom_sh_bad = sym_domain_const(64u8, false, 64u64);
    let mut dom_sh_mask = sym_domain_top(64u8, false);
    dom_sh_mask.known_zeros = 0xFFFFFFFF_FFFFFFC0u64;
    if sym_prove_shift_in_range(view(dom_sh_ok), 64u8, 16u32) != CERTAINTY_PROVEN ||
       sym_prove_shift_in_range(view(dom_sh_mask), 64u8, 16u32) != CERTAINTY_PROVEN ||
       sym_prove_shift_in_range(view(dom_sh_bad), 64u8, 16u32) != CERTAINTY_UNKNOWN {
        return false;
    }

    let mut idx_byte = sym_domain_range(64u8, false, 0u64, 7u64);
    idx_byte.is_utf8_byte_len = true;
    let mut len_byte = sym_domain_range(64u8, false, 8u64, 16u64);
    len_byte.is_utf8_byte_len = true;
    let mut len_scalar = sym_domain_range(64u8, false, 8u64, 16u64);
    len_scalar.is_utf8_byte_len = false;
    if sym_prove_in_bounds(view(idx_byte), view(len_byte), true, 16u32) != CERTAINTY_PROVEN ||
       sym_prove_in_bounds(view(idx_byte), view(len_scalar), true, 16u32) != CERTAINTY_UNKNOWN {
        return false;
    }

    let max_lhs = sym_domain_range(64u8, false, 10u64, 0xFFFFFFFF_FFFFFFF5u64);
    let max_rhs_ok = sym_domain_range(64u8, false, 0u64, 10u64);
    let max_rhs_poss = sym_domain_range(64u8, false, 0u64, 11u64);
    let refined = sym_domain_refine_range(view(dom_maybe_zero), 5u64, 20u64);
    let contrad = sym_domain_refine_range(view(refined), 30u64, 40u64);

    sym_prove_no_unsigned_add_overflow(view(max_lhs), view(max_rhs_ok), 64u8, 16u32) == CERTAINTY_PROVEN &&
    sym_prove_no_unsigned_add_overflow(view(max_lhs), view(max_rhs_poss), 64u8, 16u32) == CERTAINTY_POSSIBLE &&
    !refined.is_contradiction && refined.nullability == NULLABILITY_NON_NULL &&
    contrad.is_contradiction
}

// =================================================================================================
// Stage 3: Fail-Closed Rollback & Middle-End Translation Validation (AXS-PCT-004, 020..021)
// =================================================================================================
fn probe_e18_5_fail_closed_and_middle_end_witness(arena: mut_view<Arena>) -> bool {
    if eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_0_STRUCTURAL)) != EQ_LEVEL_0_STRUCTURAL ||
       eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_1_VALUE)) != EQ_LEVEL_1_VALUE ||
       eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_2_MEMORY_RESOURCE)) != EQ_LEVEL_2_MEMORY_RESOURCE ||
       eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_3_EFFECT_TRAP)) != EQ_LEVEL_3_EFFECT_TRAP ||
       eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_4_OBSERVABLE_SEMANTIC)) != EQ_LEVEL_4_OBSERVABLE_SEMANTIC {
        return false;
    }
    let t4 = tval_evaluate_equivalence_tier(false, true, true, true, false);
    if t4 != EQ_LEVEL_4_OBSERVABLE_SEMANTIC || !tval_meets_mandatory_criterion(t4) ||
       tval_evaluate_equivalence_tier(false, true, true, true, true) != EQ_LEVEL_FAILED {
        return false;
    }

    let mut body = build_sample_mir_body(mut_view(*arena), true);
    let mut pct_eng = PassContractEngine {
        current_level: IR_LEVEL_OPT_IR,
        ir_revision: 1u32,
        valid_analyses: 0u32,
        analysis_digests: 0 as *mut u64,
        active_properties: SEM_PROP_MANDATORY_INTRA_LEVEL,
        verify_pass_contracts: true,
        verify_each: true,
        observable_effect_count: 0u32,
        baseline_observable_effects: 0u32,
        pass_run_count: 0u32,
        pass_commit_count: 0u32,
        pass_rollback_count: 0u32,
        verify_trap_count: 0u32,
        last_trap_kind: 0u8,
        last_trap_pass_id: 0u16,
    };
    pct_engine_init(mut_view(pct_eng), mut_view(*arena), IR_LEVEL_OPT_IR, true);
    pct_eng.observable_effect_count = pct_count_mir_observable_effects(view(body));
    pct_eng.baseline_observable_effects = pct_eng.observable_effect_count;

    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 1u32,
        current_snapshot_revision: 1u32,
        allow_trusted_boundaries: false,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(*arena), 1u32, false);

    let mut tval_eng = TranslationValEngine {
        validate_translations: true,
        witnesses: 0 as *mut TranslationWitness,
        witness_count: 0,
        witness_cap: 0,
        verified_count: 0u32,
        failed_count: 0u32,
        last_failure_kind: 0u8,
        last_failure_pass_id: 0u16,
        last_failure_subject: 0u32,
    };
    tval_engine_init(mut_view(tval_eng), mut_view(*arena), true);
    let mut sink = diag_sink_new();

    // 1. Commit a Proven BCE pass and verify automatic proof invalidation on SsaDefUse mutation
    let bce_contract = pct_canonical_contract(PCT_PASS_OPT_BCE);
    pct_engine_ensure_analyses(mut_view(pct_eng), view(body), bce_contract.required_analyses);
    let cert_bce0 = proof_store_issue(
        mut_view(store),
        PROP_IN_BOUNDS,
        CERTAINTY_PROVEN,
        1u32,
        2u32,
        0u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_SSA_DEF_USE,
        0u64,
        0u32,
        SymbolId { v: 1u32 }
    );
    let ckpt1 = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    let res1 = pct_engine_finish_pass(
        mut_view(pct_eng),
        view(bce_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt1),
        true,
        cert_bce0,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if res1 != PCT_EXEC_COMMITTED || pct_eng.ir_revision != 2u32 ||
       proof_store_is_cert_usable(view(store), cert_bce0) || sink.errors != 0 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // 2. Fail-closed rollback on Unknown & Possible obligations (0 user diagnostics!)
    let licm_contract = pct_canonical_contract(PCT_PASS_OPT_LICM);
    pct_engine_ensure_analyses(mut_view(pct_eng), view(body), licm_contract.required_analyses);
    let ckpt2 = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    unsafe {
        (*mir_stmt_at((*mir_bb_at(body.bbs, 0)).stmts, 0)).rvalue.use_op.constant.val = 999u64;
    }
    let res2 = pct_engine_finish_pass(
        mut_view(pct_eng),
        view(licm_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt2),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_UNKNOWN,
        mut_view(sink)
    );
    let restored_val = unsafe { (*mir_stmt_at((*mir_bb_at(body.bbs, 0)).stmts, 0)).rvalue.use_op.constant.val };
    if res2 != PCT_EXEC_ROLLED_BACK_OBLIGATION || restored_val != 42u64 ||
       pct_eng.pass_rollback_count != 1u32 || sink.errors != 0 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // 3. Issue Proven certificates at ir_revision = 2 and validate middle-end Scalar, CFG, and Memory/Loop witnesses
    let cert_nsw = proof_store_issue(mut_view(store), PROP_NO_SIGNED_OVERFLOW, CERTAINTY_PROVEN, 10u32, 0u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_VALUE_RANGE, 0u64, 0u32, SymbolId { v: 1u32 });
    let cert_nz = proof_store_issue(mut_view(store), PROP_NON_ZERO, CERTAINTY_PROVEN, 11u32, 0u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_VALUE_RANGE, 0u64, 0u32, SymbolId { v: 1u32 });
    let cert_sh = proof_store_issue(mut_view(store), PROP_SHIFT_IN_RANGE, CERTAINTY_PROVEN, 12u32, 0u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_VALUE_RANGE, 0u64, 0u32, SymbolId { v: 1u32 });
    let cert_ib = proof_store_issue(mut_view(store), PROP_IN_BOUNDS, CERTAINTY_PROVEN, 13u32, 0u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_VALUE_RANGE, 0u64, 0u32, SymbolId { v: 1u32 });
    let cert_dead = proof_store_issue(mut_view(store), PROP_DEAD_STORE, CERTAINTY_PROVEN, 20u32, 0u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_SSA_DEF_USE, 0u64, 0u32, SymbolId { v: 1u32 });
    let cert_noalias = proof_store_issue(mut_view(store), PROP_NO_ALIAS, CERTAINTY_PROVEN, 20u32, 21u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_SSA_DEF_USE, 0u64, 0u32, SymbolId { v: 1u32 });
    let cert_must = proof_store_issue(mut_view(store), PROP_MUST_ALIAS, CERTAINTY_PROVEN, 22u32, 23u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_SSA_DEF_USE, 0u64, 0u32, SymbolId { v: 1u32 });
    let cert_noesc = proof_store_issue(mut_view(store), PROP_NO_ESCAPE, CERTAINTY_PROVEN, 24u32, 0u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_SSA_DEF_USE, 0u64, 0u32, SymbolId { v: 1u32 });
    let cert_licm = proof_store_issue(mut_view(store), PROP_LOOP_INVARIANT, CERTAINTY_PROVEN, 25u32, 1u32, 1u32, FACT_ORIGIN_DATAFLOW_ENGINE, PCT_ANALYSIS_SSA_DEF_USE, 0u64, 0u32, SymbolId { v: 1u32 });

    let ok_scalar = ScalarRewriteWitnessDesc {
        pass_id: PCT_PASS_OPT_INSTCOMBINE,
        fn_id: 1u32,
        inst_id: 100u32,
        pre_bit_width: 64u8,
        post_bit_width: 64u8,
        pre_is_signed: true,
        post_is_signed: true,
        is_comparison_or_div_or_shift: true,
        is_float: false,
        rewrote_fp_identity_or_reassoc: false,
        fp_nan_safe: true,
        fp_signed_zero_safe: true,
        pre_has_overflow_trap: true,
        post_has_overflow_trap: false,
        overflow_cert_id: cert_nsw,
        pre_has_div_zero_trap: true,
        post_has_div_zero_trap: false,
        non_zero_cert_id: cert_nz,
        pre_has_shift_trap: true,
        post_has_shift_trap: false,
        shift_cert_id: cert_sh,
        pre_has_bounds_trap: true,
        post_has_bounds_trap: false,
        bounds_cert_id: cert_ib,
        pre_sample_out_0: 42u64,
        post_sample_out_0: 42u64,
        pre_sample_out_1: 99u64,
        post_sample_out_1: 99u64,
    };
    let w_sc = tval_validate_scalar_rewrite(mut_view(tval_eng), view(store), view(ok_scalar), mut_view(sink));

    let cfg_ok = CfgTransformWitnessDesc {
        pass_id: PCT_PASS_OPT_CFG_SIMPLIFY,
        fn_id: 1u32,
        removed_edges_or_blocks: 1u32,
        branch_cond_certainty: CERTAINTY_PROVEN,
        join_pred_count: 2u32,
        phi_input_count: 2u32,
        memory_phi_complete: true,
        dom_tree_valid: true,
    };
    let w_cfg = tval_validate_cfg_transform(mut_view(tval_eng), view(body), view(body), view(cfg_ok), mut_view(sink));

    let dse_ok = MemoryLoopTransformWitnessDesc {
        pass_id: PCT_PASS_OPT_DSE,
        fn_id: 1u32,
        xform_kind: TVAL_MEM_XFORM_DSE,
        subject_inst: 20u32,
        primary_cert_id: cert_dead,
        secondary_cert_id: cert_noalias,
        touches_volatile_or_mmio: false,
        touches_atomic_sync: false,
        alters_drop_order: false,
        violates_capability_exclusivity: false,
        hoisted_op_may_trap_on_empty_loop: false,
    };
    let mut fwd_ok = dse_ok;
    fwd_ok.xform_kind = TVAL_MEM_XFORM_LOAD_FWD;
    fwd_ok.primary_cert_id = cert_must;
    let mut sroa_ok = dse_ok;
    sroa_ok.pass_id = PCT_PASS_OPT_SROA;
    sroa_ok.xform_kind = TVAL_MEM_XFORM_SROA;
    sroa_ok.primary_cert_id = cert_noesc;
    let mut licm_ok = dse_ok;
    licm_ok.pass_id = PCT_PASS_OPT_LICM;
    licm_ok.xform_kind = TVAL_MEM_XFORM_LICM;
    licm_ok.primary_cert_id = cert_licm;
    let mut bce_ok = dse_ok;
    bce_ok.pass_id = PCT_PASS_OPT_BCE;
    bce_ok.xform_kind = TVAL_MEM_XFORM_BCE;
    bce_ok.primary_cert_id = cert_ib;

    let w_dse = tval_validate_memory_loop_transform(mut_view(tval_eng), view(store), view(dse_ok), mut_view(sink));
    let w_fwd = tval_validate_memory_loop_transform(mut_view(tval_eng), view(store), view(fwd_ok), mut_view(sink));
    let w_sroa = tval_validate_memory_loop_transform(mut_view(tval_eng), view(store), view(sroa_ok), mut_view(sink));
    let w_licm = tval_validate_memory_loop_transform(mut_view(tval_eng), view(store), view(licm_ok), mut_view(sink));
    let w_bce = tval_validate_memory_loop_transform(mut_view(tval_eng), view(store), view(bce_ok), mut_view(sink));

    let all_ok = w_sc.equivalence_verified && w_sc.consumed_proofs == 4u32 &&
                 w_cfg.equivalence_verified && w_dse.equivalence_verified &&
                 w_fwd.equivalence_verified && w_sroa.equivalence_verified &&
                 w_licm.equivalence_verified && w_bce.equivalence_verified &&
                 sink.errors == 0;
    diag_sink_free(mut_view(sink));
    all_ok
}

// =================================================================================================
// Stage 4: Backend Legalization, RegAlloc, Scheduling & Finalization Gate (AXS-PCT-022..024, REQ-LNK-3384..3433)
// =================================================================================================
fn probe_e18_5_backend_legalize_ra_sched_finalize(arena: mut_view<Arena>) -> bool {
    if tval_phys_reg_unit(REG_ENC_RAX) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_EAX) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_AX) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_AL) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_AH) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_XMM0) != PHYS_UNIT_XMM0 ||
       tval_phys_reg_unit(REG_ENC_YMM0) != PHYS_UNIT_XMM0 {
        return false;
    }

    let mut sink = diag_sink_new();
    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 1u32,
        current_snapshot_revision: 1u32,
        allow_trusted_boundaries: false,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(*arena), 1u32, false);
    let cert_noalias = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        50u32,
        51u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_CFG,
        0u64,
        0u32,
        SymbolId { v: 4u32 }
    );

    let mut eng = TranslationValEngine {
        validate_translations: true,
        witnesses: 0 as *mut TranslationWitness,
        witness_count: 0,
        witness_cap: 0,
        verified_count: 0u32,
        failed_count: 0u32,
        last_failure_kind: 0u8,
        last_failure_pass_id: 0u16,
        last_failure_subject: 0u32,
    };
    tval_engine_init(mut_view(eng), mut_view(*arena), true);

    // 1. Target Legalization (8->64 narrow promote, i128 pair split, SIMD 256->2x128 split)
    let leg_i128 = TargetLegalizationWitnessDesc {
        pass_id: PCT_PASS_LIR_LOWER,
        fn_id: 2u32,
        legalize_kind: TVAL_LEGALIZE_I128_PAIR_SPLIT,
        inst_id: 300u32,
        pre_total_bits: 128u16,
        post_lane_bits: 64u16,
        post_lane_count: 2u16,
        extension_matches_signedness: true,
        preserves_carry_borrow_chain: true,
        preserves_lane_order: true,
        preserves_trap_semantics: true,
    };
    let mut leg_narrow = leg_i128;
    leg_narrow.legalize_kind = TVAL_LEGALIZE_NARROW_INT_PROMOTE;
    leg_narrow.pre_total_bits = 64u16;
    leg_narrow.post_lane_bits = 64u16;
    leg_narrow.post_lane_count = 1u16;
    let mut leg_simd = leg_i128;
    leg_simd.legalize_kind = TVAL_LEGALIZE_SIMD_VECTOR_SPLIT;
    leg_simd.pre_total_bits = 256u16;
    leg_simd.post_lane_bits = 128u16;
    leg_simd.post_lane_count = 2u16;

    let w_leg1 = tval_validate_target_legalization(mut_view(eng), view(leg_i128), mut_view(sink));
    let w_leg2 = tval_validate_target_legalization(mut_view(eng), view(leg_narrow), mut_view(sink));
    let w_leg3 = tval_validate_target_legalization(mut_view(eng), view(leg_simd), mut_view(sink));

    // 2. Register Allocation & Spill/Reload Witness
    let ivs = arena_alloc_raw(mut_view(*arena), mir_mul_usize(3, size_of<LiveRangeAllocEntry>()), align_of<LiveRangeAllocEntry>()) as *mut LiveRangeAllocEntry;
    let sps = arena_alloc_raw(mut_view(*arena), mir_mul_usize(1, size_of<SpillSlotEntry>()), align_of<SpillSlotEntry>()) as *mut SpillSlotEntry;
    unsafe {
        *probe_interval_at(ivs, 0) = LiveRangeAllocEntry {
            vreg_id: 1u32,
            start_point: 0u32,
            end_point: 10u32,
            phys_reg_enc: REG_ENC_RAX,
            is_spilled: false,
            spill_slot_id: 0u32,
            value_provenance: 77u32,
            is_move_coalesced: true,
            crosses_call: false,
            saved_across_call: false,
        };
        *probe_interval_at(ivs, 1) = LiveRangeAllocEntry {
            vreg_id: 2u32,
            start_point: 5u32,
            end_point: 15u32,
            phys_reg_enc: REG_ENC_EAX,
            is_spilled: false,
            spill_slot_id: 0u32,
            value_provenance: 77u32,
            is_move_coalesced: true,
            crosses_call: false,
            saved_across_call: false,
        };
        *probe_interval_at(ivs, 2) = LiveRangeAllocEntry {
            vreg_id: 3u32,
            start_point: 2u32,
            end_point: 12u32,
            phys_reg_enc: REG_ENC_RBX,
            is_spilled: true,
            spill_slot_id: 0u32,
            value_provenance: 88u32,
            is_move_coalesced: false,
            crosses_call: true,
            saved_across_call: true,
        };
        *probe_spill_at(sps, 0) = SpillSlotEntry {
            slot_id: 0u32,
            vreg_id: 3u32,
            spill_store_point: 2u32,
            reload_use_point: 8u32,
            store_dominates_reload: true,
            aliases_user_local: false,
            aliases_volatile_or_mmio: false,
        };
    }
    let ra_ok = RegAllocWitnessDesc {
        pass_id: PCT_PASS_X64_REGALLOC,
        fn_id: 2u32,
        remaining_vregs: 0u32,
        intervals: ivs as *const LiveRangeAllocEntry,
        interval_count: 3,
        spills: sps as *const SpillSlotEntry,
        spill_count: 1,
        var_shift_uses_rcx: true,
        div_mul_uses_rax_rdx: true,
        callee_saved_modified_mask: 0x08u32,
        callee_saved_saved_restored_mask: 0x08u32,
    };
    let w_ra = tval_validate_regalloc_witness(mut_view(eng), view(ra_ok), mut_view(sink));

    // 3. Instruction Scheduling Witness
    let nodes = arena_alloc_raw(mut_view(*arena), mir_mul_usize(3, size_of<ScheduleNodeEntry>()), align_of<ScheduleNodeEntry>()) as *mut ScheduleNodeEntry;
    let edges = arena_alloc_raw(mut_view(*arena), mir_mul_usize(1, size_of<ScheduleDepEdge>()), align_of<ScheduleDepEdge>()) as *mut ScheduleDepEdge;
    unsafe {
        *probe_sched_node_at(nodes, 0) = ScheduleNodeEntry {
            inst_id: 500u32,
            pre_order_idx: 0u32,
            scheduled_order_idx: 0u32,
            is_memory_load: true,
            is_memory_store: false,
            is_volatile_or_mmio: true,
            is_atomic: false,
            is_fence: false,
            is_call: false,
            is_may_trap: false,
            alias_group: 1u32,
        };
        *probe_sched_node_at(nodes, 1) = ScheduleNodeEntry {
            inst_id: 501u32,
            pre_order_idx: 1u32,
            scheduled_order_idx: 1u32,
            is_memory_load: false,
            is_memory_store: true,
            is_volatile_or_mmio: false,
            is_atomic: false,
            is_fence: false,
            is_call: false,
            is_may_trap: false,
            alias_group: 1u32,
        };
        *probe_sched_node_at(nodes, 2) = ScheduleNodeEntry {
            inst_id: 502u32,
            pre_order_idx: 2u32,
            scheduled_order_idx: 2u32,
            is_memory_load: false,
            is_memory_store: false,
            is_volatile_or_mmio: false,
            is_atomic: false,
            is_fence: false,
            is_call: false,
            is_may_trap: false,
            alias_group: 0u32,
        };
        *probe_sched_edge_at(edges, 0) = ScheduleDepEdge {
            pred_node_idx: 0u32,
            succ_node_idx: 2u32,
            dep_kind: SCHED_DEP_RAW,
            resource_kind: SCHED_RES_GPR,
        };
    }
    let sched_ok = ScheduleWitnessDesc {
        pass_id: PCT_PASS_X64_FINALIZE,
        fn_id: 2u32,
        nodes: nodes as *const ScheduleNodeEntry,
        node_count: 3,
        edges: edges as *const ScheduleDepEdge,
        edge_count: 1,
        no_alias_cert_id: cert_noalias,
        has_unknown_latency_model: false,
    };
    let w_sched = tval_validate_schedule_witness(mut_view(eng), view(store), view(sched_ok), mut_view(sink));

    // 4. Final Machine IR 3.0 Gate (AXS-PCT-024, REQ-LNK-3384..3433)
    let fin_ok = FinalMachineGateDesc {
        pass_id: PCT_PASS_X64_FINALIZE,
        fn_id: 2u32,
        completed_stages_mask: FINAL_STAGE_COMPLETE_MASK,
        remaining_vregs: 0u32,
        unresolved_abstract_slots: 0u32,
        frame_size_bytes: 4104u32,
        pushed_callee_bytes: 16u32,
        has_calls: true,
        has_chkstk_probe: true,
        secret_slot_count: 1u32,
        secret_zeroize_barriers_intact: true,
        pdata_xdata_matches_frame: true,
        callee_saved_pushed_mask: 0x18u32,
        callee_saved_popped_mask: 0x18u32,
    };
    let w_fin = tval_validate_machine_finalization_gate(mut_view(eng), view(fin_ok), mut_view(sink));

    let ok = w_leg1.equivalence_verified && w_leg2.equivalence_verified && w_leg3.equivalence_verified &&
             w_ra.equivalence_verified && w_sched.equivalence_verified && w_fin.equivalence_verified &&
             sink.errors == 0;
    diag_sink_free(mut_view(sink));
    ok
}

// =================================================================================================
// Stage 5: Synthetic Pass-Bug Rejections & Deterministic Witness Output (AXS-PCT-050..052, REQ-LNK-3388..3432)
// =================================================================================================
fn probe_e18_5_synthetic_bugs_and_deterministic_witness(arena: mut_view<Arena>) -> bool {
    let mut body = build_sample_mir_body(mut_view(*arena), true);
    let body_no_drop = build_sample_mir_body(mut_view(*arena), false);

    let mut pct_eng = PassContractEngine {
        current_level: IR_LEVEL_OPT_IR,
        ir_revision: 1u32,
        valid_analyses: 0u32,
        analysis_digests: 0 as *mut u64,
        active_properties: SEM_PROP_MANDATORY_INTRA_LEVEL,
        verify_pass_contracts: true,
        verify_each: true,
        observable_effect_count: 0u32,
        baseline_observable_effects: 0u32,
        pass_run_count: 0u32,
        pass_commit_count: 0u32,
        pass_rollback_count: 0u32,
        verify_trap_count: 0u32,
        last_trap_kind: 0u8,
        last_trap_pass_id: 0u16,
    };
    pct_engine_init(mut_view(pct_eng), mut_view(*arena), IR_LEVEL_OPT_IR, true);
    pct_eng.observable_effect_count = pct_count_mir_observable_effects(view(body));
    pct_eng.baseline_observable_effects = pct_eng.observable_effect_count;

    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 1u32,
        current_snapshot_revision: 1u32,
        allow_trusted_boundaries: false,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(*arena), 1u32, false);

    let mut tval_eng = TranslationValEngine {
        validate_translations: true,
        witnesses: 0 as *mut TranslationWitness,
        witness_count: 0,
        witness_cap: 0,
        verified_count: 0u32,
        failed_count: 0u32,
        last_failure_kind: 0u8,
        last_failure_pass_id: 0u16,
        last_failure_subject: 0u32,
    };
    tval_engine_init(mut_view(tval_eng), mut_view(*arena), true);
    let mut sink = diag_sink_new();

    // --- 1. Pass Contract synthetic bug traps (AXS-PCT-003..005, AXS-PCT-052 Case 1) ---
    let bce_contract = pct_canonical_contract(PCT_PASS_OPT_BCE);
    pct_engine_ensure_analyses(mut_view(pct_eng), view(body), bce_contract.required_analyses);
    let cert_stale = proof_store_issue(
        mut_view(store),
        PROP_IN_BOUNDS,
        CERTAINTY_PROVEN,
        1u32,
        2u32,
        0u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_SSA_DEF_USE,
        0u64,
        0u32,
        SymbolId { v: 1u32 }
    );
    proof_store_invalidate_cert(mut_view(store), cert_stale);

    // (1a) Consuming invalidated ProofCertificate traps with PCT_TRAP_STALE_PROOF_CONSUMED
    let ckpt_s = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    let r_stale = pct_engine_finish_pass(
        mut_view(pct_eng),
        view(bce_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_s),
        false,
        cert_stale,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if r_stale != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       pct_eng.last_trap_kind != PCT_TRAP_STALE_PROOF_CONSUMED ||
       sink.errors != 1 {
        diag_sink_free(mut_view(sink));
        return false;
    }
    let d_pct0 = diag_sink_get(view(sink), 0);
    let e_pct_stage = unsafe { probe_data_entry_at(d_pct0.data, 0) };
    let e_pct_detail = unsafe { probe_data_entry_at(d_pct0.data, 2) };
    if d_pct0.code.v != AX_ICE_INTERNAL ||
       (unsafe { (*e_pct_stage).value.str_val.len }) != 13 ||
       (unsafe { (*e_pct_detail).value.str_val.len }) != 28 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // (1b) Mutating preserved analysis (CFG) traps with PCT_TRAP_UNPRESERVED_ANALYSIS
    pct_engine_ensure_analyses(mut_view(pct_eng), view(body), bce_contract.required_analyses);
    let ckpt_u = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    unsafe {
        (*mir_bb_at(body.bbs, 0)).terminator.goto_target = MirBbId { v: 0u32 };
    }
    let r_unpres = pct_engine_finish_pass(
        mut_view(pct_eng),
        view(bce_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_u),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if r_unpres != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       pct_eng.last_trap_kind != PCT_TRAP_UNPRESERVED_ANALYSIS {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // (1c) Capability promotion (shared view _1 -> MIR_VIEW_MUT) traps with PCT_TRAP_CAPABILITY_PROMOTION
    let mut custom_contract = pct_canonical_contract(PCT_PASS_OPT_BCE);
    custom_contract.required_propositions = 0u32;
    custom_contract.preserved_analyses = 0u32;
    let ckpt_cap = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    unsafe {
        let s0_p = mir_stmt_at((*mir_bb_at(body.bbs, 0)).stmts, 0);
        (*s0_p).place.local = MirLocalId { v: 1u32 };
        (*s0_p).place.view_kind = MIR_VIEW_MUT;
    }
    let r_cap = pct_engine_finish_pass(
        mut_view(pct_eng),
        view(custom_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_cap),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if r_cap != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       pct_eng.last_trap_kind != PCT_TRAP_CAPABILITY_PROMOTION {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // (1d) Dropping observable Drop effect traps with PCT_TRAP_OBSERVABLE_EFFECT_LOSS
    let ckpt_eff = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    unsafe {
        (*mir_bb_at(body.bbs, 0)).stmt_count = 1;
    }
    let r_eff = pct_engine_finish_pass(
        mut_view(pct_eng),
        view(custom_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_eff),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if r_eff != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       pct_eng.last_trap_kind != PCT_TRAP_OBSERVABLE_EFFECT_LOSS {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // (1e) Malformed contract, IR level mismatch, and postcondition rollback/trap
    let mut bad_contract = pct_canonical_contract(PCT_PASS_OPT_BCE);
    bad_contract.postconditions = 0u32;
    let ckpt_bad = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    let r_bad = pct_engine_finish_pass(mut_view(pct_eng), view(bad_contract), mut_view(body), mut_view(store), view(ckpt_bad), false, PCT_PROOF_ID_INVALID, CERTAINTY_PROVEN, mut_view(sink));
    let mir_v_contract = pct_canonical_contract(PCT_PASS_MIR_VERIFY);
    let r_lvl = pct_engine_finish_pass(mut_view(pct_eng), view(mir_v_contract), mut_view(body), mut_view(store), view(ckpt_bad), false, PCT_PROOF_ID_INVALID, CERTAINTY_PROVEN, mut_view(sink));
    pct_eng.verify_pass_contracts = false;
    let ckpt_rb = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    unsafe { (*mir_bb_at(body.bbs, 0)).terminator.goto_target = MirBbId { v: 99u32 }; }
    let r_rb = pct_engine_finish_pass(mut_view(pct_eng), view(custom_contract), mut_view(body), mut_view(store), view(ckpt_rb), true, PCT_PROOF_ID_INVALID, CERTAINTY_PROVEN, mut_view(sink));
    pct_eng.verify_pass_contracts = true;
    let ckpt_pc = pct_engine_checkpoint_mir(view(pct_eng), view(body), mut_view(*arena));
    unsafe { (*mir_bb_at(body.bbs, 0)).terminator.goto_target = MirBbId { v: 99u32 }; }
    let r_pc = pct_engine_finish_pass(mut_view(pct_eng), view(custom_contract), mut_view(body), mut_view(store), view(ckpt_pc), true, PCT_PROOF_ID_INVALID, CERTAINTY_PROVEN, mut_view(sink));

    if r_bad != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       r_lvl != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       r_rb != PCT_EXEC_ROLLED_BACK_POSTCOND ||
       r_pc != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       pct_eng.last_trap_kind != PCT_TRAP_POSTCONDITION_VIOLATED {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- 2. Translation Validation synthetic pass bugs (AXS-PCT-052 Cases 2 & 3, REQ-LNK-3388..3432) ---
    let err_before_tval = sink.errors;

    // (2a) Dropped checked-overflow trap without Proven certificate
    let bug_ovf = ScalarRewriteWitnessDesc {
        pass_id: PCT_PASS_OPT_INSTCOMBINE,
        fn_id: 5u32,
        inst_id: 101u32,
        pre_bit_width: 64u8,
        post_bit_width: 64u8,
        pre_is_signed: true,
        post_is_signed: true,
        is_comparison_or_div_or_shift: true,
        is_float: false,
        rewrote_fp_identity_or_reassoc: false,
        fp_nan_safe: true,
        fp_signed_zero_safe: true,
        pre_has_overflow_trap: true,
        post_has_overflow_trap: false,
        overflow_cert_id: PCT_PROOF_ID_INVALID,
        pre_has_div_zero_trap: false,
        post_has_div_zero_trap: false,
        non_zero_cert_id: PCT_PROOF_ID_INVALID,
        pre_has_shift_trap: false,
        post_has_shift_trap: false,
        shift_cert_id: PCT_PROOF_ID_INVALID,
        pre_has_bounds_trap: false,
        post_has_bounds_trap: false,
        bounds_cert_id: PCT_PROOF_ID_INVALID,
        pre_sample_out_0: 10u64,
        post_sample_out_0: 10u64,
        pre_sample_out_1: 20u64,
        post_sample_out_1: 20u64,
    };
    let w_ovf = tval_validate_scalar_rewrite(mut_view(tval_eng), view(store), view(bug_ovf), mut_view(sink));
    let d_ovf = diag_sink_get(view(sink), err_before_tval);
    let e_ovf_stage = unsafe { probe_data_entry_at(d_ovf.data, 0) };
    let e_ovf_detail = unsafe { probe_data_entry_at(d_ovf.data, 2) };
    if w_ovf.equivalence_verified || w_ovf.failure_kind != TVAL_FAIL_DROPPED_OVERFLOW_TRAP ||
       d_ovf.code.v != AX_ICE_MIR_VERIFY ||
       (unsafe { (*e_ovf_stage).value.str_val.len }) != 15 ||
       (unsafe { (*e_ovf_detail).value.str_val.len }) != 21 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // Additional scalar/CFG/memory/legalize failures
    let mut bug_sign = bug_ovf;
    bug_sign.pre_has_overflow_trap = false;
    bug_sign.post_is_signed = false;
    let w_sign = tval_validate_scalar_rewrite(mut_view(tval_eng), view(store), view(bug_sign), mut_view(sink));

    let mut bug_fp = bug_ovf;
    bug_fp.pre_has_overflow_trap = false;
    bug_fp.is_float = true;
    bug_fp.rewrote_fp_identity_or_reassoc = true;
    bug_fp.fp_nan_safe = false;
    let w_fp = tval_validate_scalar_rewrite(mut_view(tval_eng), view(store), view(bug_fp), mut_view(sink));

    let cfg_drop_bug = CfgTransformWitnessDesc {
        pass_id: PCT_PASS_OPT_CFG_SIMPLIFY,
        fn_id: 5u32,
        removed_edges_or_blocks: 1u32,
        branch_cond_certainty: CERTAINTY_PROVEN,
        join_pred_count: 2u32,
        phi_input_count: 2u32,
        memory_phi_complete: true,
        dom_tree_valid: true,
    };
    let w_cfg_drop = tval_validate_cfg_transform(mut_view(tval_eng), view(body), view(body_no_drop), view(cfg_drop_bug), mut_view(sink));

    let dse_vol_bug = MemoryLoopTransformWitnessDesc {
        pass_id: PCT_PASS_OPT_DSE,
        fn_id: 5u32,
        xform_kind: TVAL_MEM_XFORM_DSE,
        subject_inst: 20u32,
        primary_cert_id: PCT_PROOF_ID_INVALID,
        secondary_cert_id: PCT_PROOF_ID_INVALID,
        touches_volatile_or_mmio: true,
        touches_atomic_sync: false,
        alters_drop_order: false,
        violates_capability_exclusivity: false,
        hoisted_op_may_trap_on_empty_loop: false,
    };
    let w_dse_vol = tval_validate_memory_loop_transform(mut_view(tval_eng), view(store), view(dse_vol_bug), mut_view(sink));

    // (2b) Clobbered live register (overlapping RAX and EAX without move-coalescing provenance)
    let ivs = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<LiveRangeAllocEntry>()), align_of<LiveRangeAllocEntry>()) as *mut LiveRangeAllocEntry;
    unsafe {
        *probe_interval_at(ivs, 0) = LiveRangeAllocEntry {
            vreg_id: 1u32,
            start_point: 0u32,
            end_point: 10u32,
            phys_reg_enc: REG_ENC_RAX,
            is_spilled: false,
            spill_slot_id: 0u32,
            value_provenance: 10u32,
            is_move_coalesced: false,
            crosses_call: false,
            saved_across_call: false,
        };
        *probe_interval_at(ivs, 1) = LiveRangeAllocEntry {
            vreg_id: 2u32,
            start_point: 4u32,
            end_point: 14u32,
            phys_reg_enc: REG_ENC_EAX,
            is_spilled: false,
            spill_slot_id: 0u32,
            value_provenance: 20u32,
            is_move_coalesced: false,
            crosses_call: false,
            saved_across_call: false,
        };
    }
    let ra_clobber = RegAllocWitnessDesc {
        pass_id: PCT_PASS_X64_REGALLOC,
        fn_id: 5u32,
        remaining_vregs: 0u32,
        intervals: ivs as *const LiveRangeAllocEntry,
        interval_count: 2,
        spills: 0 as *const SpillSlotEntry,
        spill_count: 0,
        var_shift_uses_rcx: true,
        div_mul_uses_rax_rdx: true,
        callee_saved_modified_mask: 0u32,
        callee_saved_saved_restored_mask: 0u32,
    };
    let err_before_ra = sink.errors;
    let w_clobber = tval_validate_regalloc_witness(mut_view(tval_eng), view(ra_clobber), mut_view(sink));
    let d_ra = diag_sink_get(view(sink), err_before_ra);
    let e_ra_detail = unsafe { probe_data_entry_at(d_ra.data, 2) };
    if w_clobber.equivalence_verified || w_clobber.failure_kind != TVAL_FAIL_CLOBBERED_LIVE_REGISTER ||
       d_ra.code.v != AX_ICE_INTERNAL || (unsafe { (*e_ra_detail).value.str_val.len }) != 23 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // (2c) Reordered volatile load across memory store barrier
    let nodes = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<ScheduleNodeEntry>()), align_of<ScheduleNodeEntry>()) as *mut ScheduleNodeEntry;
    unsafe {
        *probe_sched_node_at(nodes, 0) = ScheduleNodeEntry {
            inst_id: 600u32,
            pre_order_idx: 0u32,
            scheduled_order_idx: 1u32,
            is_memory_load: true,
            is_memory_store: false,
            is_volatile_or_mmio: true,
            is_atomic: false,
            is_fence: false,
            is_call: false,
            is_may_trap: false,
            alias_group: 1u32,
        };
        *probe_sched_node_at(nodes, 1) = ScheduleNodeEntry {
            inst_id: 601u32,
            pre_order_idx: 1u32,
            scheduled_order_idx: 0u32,
            is_memory_load: false,
            is_memory_store: true,
            is_volatile_or_mmio: false,
            is_atomic: false,
            is_fence: false,
            is_call: false,
            is_may_trap: false,
            alias_group: 1u32,
        };
    }
    let sched_reord = ScheduleWitnessDesc {
        pass_id: PCT_PASS_X64_FINALIZE,
        fn_id: 5u32,
        nodes: nodes as *const ScheduleNodeEntry,
        node_count: 2,
        edges: 0 as *const ScheduleDepEdge,
        edge_count: 0,
        no_alias_cert_id: PCT_PROOF_ID_INVALID,
        has_unknown_latency_model: false,
    };
    let err_before_sch = sink.errors;
    let w_vol = tval_validate_schedule_witness(mut_view(tval_eng), view(store), view(sched_reord), mut_view(sink));
    let d_sch = diag_sink_get(view(sink), err_before_sch);
    let e_sch_detail = unsafe { probe_data_entry_at(d_sch.data, 2) };
    if w_vol.equivalence_verified || w_vol.failure_kind != TVAL_FAIL_VOLATILE_BARRIER_REORDERED ||
       d_sch.code.v != AX_ICE_INTERNAL || (unsafe { (*e_sch_detail).value.str_val.len }) != 26 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // (2d) Final Machine IR gate defense against unverified/corrupted frame/security/unwind state (REQ-LNK-3388..3432)
    let fin_base = FinalMachineGateDesc {
        pass_id: PCT_PASS_X64_FINALIZE,
        fn_id: 5u32,
        completed_stages_mask: FINAL_STAGE_COMPLETE_MASK,
        remaining_vregs: 0u32,
        unresolved_abstract_slots: 0u32,
        frame_size_bytes: 4104u32,
        pushed_callee_bytes: 16u32,
        has_calls: true,
        has_chkstk_probe: true,
        secret_slot_count: 1u32,
        secret_zeroize_barriers_intact: true,
        pdata_xdata_matches_frame: true,
        callee_saved_pushed_mask: 0x18u32,
        callee_saved_popped_mask: 0x18u32,
    };
    let mut fin_bad_stage = fin_base;
    fin_bad_stage.completed_stages_mask = 0x1Fu8;
    let w_f_stage = tval_validate_machine_finalization_gate(mut_view(tval_eng), view(fin_bad_stage), mut_view(sink));

    let mut fin_bad_align = fin_base;
    fin_bad_align.frame_size_bytes = 4096u32;
    let w_f_align = tval_validate_machine_finalization_gate(mut_view(tval_eng), view(fin_bad_align), mut_view(sink));

    let mut fin_bad_chkstk = fin_base;
    fin_bad_chkstk.has_chkstk_probe = false;
    let w_f_chk = tval_validate_machine_finalization_gate(mut_view(tval_eng), view(fin_bad_chkstk), mut_view(sink));

    let mut fin_bad_sec = fin_base;
    fin_bad_sec.secret_zeroize_barriers_intact = false;
    let w_f_sec = tval_validate_machine_finalization_gate(mut_view(tval_eng), view(fin_bad_sec), mut_view(sink));

    let mut fin_bad_unw = fin_base;
    fin_bad_unw.pdata_xdata_matches_frame = false;
    let w_f_unw = tval_validate_machine_finalization_gate(mut_view(tval_eng), view(fin_bad_unw), mut_view(sink));

    if w_sign.equivalence_verified || w_sign.failure_kind != TVAL_FAIL_BITWIDTH_OR_SIGN_MISMATCH ||
       w_fp.equivalence_verified || w_fp.failure_kind != TVAL_FAIL_IEEE754_NAN_OR_SIGNED_ZERO ||
       w_cfg_drop.equivalence_verified || w_cfg_drop.failure_kind != TVAL_FAIL_DROP_OR_CAP_BARRIER_VIOLATED ||
       w_dse_vol.equivalence_verified || w_dse_vol.failure_kind != TVAL_FAIL_VOLATILE_OR_ATOMIC_ELIMINATED ||
       w_f_stage.equivalence_verified || w_f_stage.failure_kind != TVAL_FAIL_FINALIZE_PIPELINE_STAGE ||
       w_f_align.equivalence_verified || w_f_align.failure_kind != TVAL_FAIL_STACK_ALIGNMENT ||
       w_f_chk.equivalence_verified || w_f_chk.failure_kind != TVAL_FAIL_MISSING_CHKSTK_PROBE ||
       w_f_sec.equivalence_verified || w_f_sec.failure_kind != TVAL_FAIL_SECRET_ZEROIZE_DROPPED ||
       w_f_unw.equivalence_verified || w_f_unw.failure_kind != TVAL_FAIL_UNWIND_METADATA_MISMATCH {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- 3. Deterministic `inspect --emit=pass-witness` formatting (AXS-PCT-050, REQ-LNK-3384, REQ-LNK-3426) ---
    let mut buf1 = diag_buf_new();
    let mut buf2 = diag_buf_new();
    tval_format_pass_witness_report(view(tval_eng), view(pct_eng), view(store), mut_view(buf1));
    tval_format_pass_witness_report(view(tval_eng), view(pct_eng), view(store), mut_view(buf2));
    let mut det_ok = buf1.len > 64 && buf1.len == buf2.len;
    let mut i: usize = 0;
    while i < buf1.len && det_ok {
        if (unsafe { *(buf1.ptr + i) }) != (unsafe { *(buf2.ptr + i) }) {
            det_ok = false;
        }
        i = i + 1;
    }
    // Check header starts with "rev=" (114, 101, 118, 61)
    if det_ok {
        let b0 = unsafe { *(buf1.ptr + 0) };
        let b1 = unsafe { *(buf1.ptr + 1) };
        let b2 = unsafe { *(buf1.ptr + 2) };
        let b3 = unsafe { *(buf1.ptr + 3) };
        if b0 != 114u8 || b1 != 101u8 || b2 != 118u8 || b3 != 61u8 {
            det_ok = false;
        }
    }

    diag_buf_free(mut_view(buf1));
    diag_buf_free(mut_view(buf2));
    diag_sink_free(mut_view(sink));
    det_ok
}

pub fn main() -> i32 {
    let mut arena = arena_new();

    if !probe_e18_5_pipeline_contracts_and_certainty(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        print("FAIL_STAGE_1_CONTRACTS_AND_CERTAINTY\n");
        return 1;
    }
    print("PROBE_E18_5_PIPELINE_CONTRACTS_AND_CERTAINTY=OK\n");

    if !probe_e18_5_dataflow_effects_and_symbolic() {
        arena_destroy(mut_view(arena));
        print("FAIL_STAGE_2_DATAFLOW_EFFECTS_SYMBOLIC\n");
        return 2;
    }
    print("PROBE_E18_5_DATAFLOW_EFFECTS_AND_SYMBOLIC=OK\n");

    if !probe_e18_5_fail_closed_and_middle_end_witness(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        print("FAIL_STAGE_3_FAIL_CLOSED_AND_MIDDLE_END\n");
        return 3;
    }
    print("PROBE_E18_5_FAIL_CLOSED_AND_MIDDLE_END_WITNESS=OK\n");

    if !probe_e18_5_backend_legalize_ra_sched_finalize(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        print("FAIL_STAGE_4_BACKEND_WITNESS_AND_FINALIZE\n");
        return 4;
    }
    print("PROBE_E18_5_BACKEND_LEGALIZE_RA_SCHED_FINALIZE=OK\n");

    if !probe_e18_5_synthetic_bugs_and_deterministic_witness(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        print("FAIL_STAGE_5_SYNTHETIC_BUGS_AND_WITNESS\n");
        return 5;
    }
    print("PROBE_E18_5_SYNTHETIC_BUGS_AND_DETERMINISTIC_WITNESS=OK\n");

    arena_destroy(mut_view(arena));
    print("PROBE_E18_5_ALL=OK\n");
    0
}
