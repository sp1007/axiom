// test: run
// modes: interp native
// flags: --verify-each
// exit: 0
// stdout: Xin chào E18.5 drop_capability_and_effect_barriers\ndrop_lifo=D30D20D10\ndrop_early=D50D40\ncap_reborrow_sroa=342\ncallback_and_impure_dce=288\nchecksum=640\n

// E18.5 Conformance (SPEC-25 AXS-PCT-002, AXS-PCT-013, AXS-PCT-021.2..3):
// Verifies deterministic LIFO Drop ordering across nested scopes and early returns,
// capability exclusivity (view<T> vs mut_view<T>, sequential reborrowing, SROA, DSE, and
// store-to-load forwarding), and multi-category EffectSummary rules (higher-order callback
// effect propagation and preservation of impure calls whose return values are unused).

pub struct DropGuard {
    pub id: i32,
}

impl Drop for DropGuard {
    fn drop(self: mut_view<DropGuard>) {
        if self.id == 30i32 {
            print("drop_lifo=D30");
        } else if self.id == 20i32 {
            print("D20");
        } else if self.id == 10i32 {
            print("D10\n");
        } else if self.id == 50i32 {
            print("drop_early=D50");
        } else if self.id == 40i32 {
            print("D40\n");
        }
    }
}

fn verify_lifo_drop_scope() {
    let _g1 = DropGuard { id: 10i32 };
    let _g2 = DropGuard { id: 20i32 };
    let _g3 = DropGuard { id: 30i32 };
}

fn verify_early_return_drop(early: bool) -> i64 {
    let _g4 = DropGuard { id: 40i32 };
    if early {
        let _g5 = DropGuard { id: 50i32 };
        return 10;
    }
    0
}

fn step_mutate(dst: mut_view<i64>, src: view<i64>, factor: i64) -> i64 {
    *dst = *dst + (*src) * factor;
    *dst
}

fn kernel_cap_reborrow_and_sroa() -> i64 {
    // Dead store to unescaped local (eligible for DSE when Proven DeadStore + NoAlias)
    let mut dead_local: i64 = 999;
    dead_local = 111;
    let _ = dead_local;

    // Sequential capability reborrowing (view<i64> and mut_view<i64> exclusivity)
    let mut a: i64 = 20;
    let mut b: i64 = 14;
    let r1: i64 = step_mutate(mut_view(a), view(b), 3);
    let r2: i64 = step_mutate(mut_view(b), view(a), 2);

    // Array DSE + store-to-load forwarding with Proven MustAlias/NoAlias
    let mut arr: [4]i64 = [5, 10, 15, 20];
    arr[1] = 30;
    arr[1] = 45;
    arr[2] = arr[1] + 12;

    r1 + r2 + arr[0] + arr[1] + arr[2] + arr[3] + 15
}

fn apply_callback(log: mut_view<i64>, x: i64, f: fn(mut_view<i64>, i64) -> i64) -> i64 {
    f(log, x)
}

fn impure_cb(log: mut_view<i64>, v: i64) -> i64 {
    *log = (*log) * 3 + v;
    *log
}

fn kernel_callback_and_impure_dce() -> i64 {
    // AXS-PCT-013 (REQ-CORE-3204..3206): Higher-order functions union callback effects;
    // DCE MUST NEVER eliminate an impure call solely because its return value is unused.
    let mut state: i64 = 8;
    let _unused1: i64 = apply_callback(mut_view(state), 6, impure_cb);
    let _unused2: i64 = apply_callback(mut_view(state), 5, impure_cb);
    let final_v: i64 = apply_callback(mut_view(state), 3, impure_cb);
    (state + final_v) / 2
}

pub fn main() -> i32 {
    print("Xin chào E18.5 drop_capability_and_effect_barriers\n");

    verify_lifo_drop_scope();
    let m1: i64 = verify_early_return_drop(true);
    if m1 != 10 {
        return 1;
    }

    let m2: i64 = kernel_cap_reborrow_and_sroa();
    if m2 != 342 {
        return 2;
    }
    print("cap_reborrow_sroa=342\n");

    let m3: i64 = kernel_callback_and_impure_dce();
    if m3 != 288 {
        return 3;
    }
    print("callback_and_impure_dce=288\n");

    let total: i64 = m1 + m2 + m3;
    if total != 640 {
        return 4;
    }
    print("checksum=640\n");
    0
}
