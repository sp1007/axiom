// test: run
// modes: interp native
// flags: --verify-each
// exit: 0
// stdout: Xin chào E18.5 boundary_cfg_diamond_and_loop_drop_guards\nloop_drops=L1L2L3\ncfg_diamond_loop_drop=190\nshift_and_sign_extrema=110\nzero_trip_licm_guard=300\nchecksum=600\n

// E18.5 QA Boundary Conformance (SPEC-25 AXS-PCT-004, AXS-PCT-010, AXS-PCT-014, AXS-PCT-021.1..3):
// Verifies deterministic Drop cleanup across loop continue/normal/break edges, diamond CFG
// phi/MemoryPhi merge completeness, boundary shift amounts (0 and 63) with logical vs arithmetic
// right-shift sign polarity, and zero-trip loop fail-closed LICM hoisting guards.

pub struct LoopDropGuard {
    pub step: i32,
}

impl Drop for LoopDropGuard {
    fn drop(self: mut_view<LoopDropGuard>) {
        if self.step == 1i32 {
            print("loop_drops=L1");
        } else if self.step == 2i32 {
            print("L2");
        } else if self.step == 3i32 {
            print("L3\n");
        }
    }
}

fn diamond_memory_merge(cond: bool, seed: i64) -> i64 {
    let mut slot_a: i64 = seed;
    let mut slot_b: i64 = seed * 2;
    if cond {
        slot_a = slot_a + 20;
        slot_b = slot_b + 30;
    } else {
        slot_a = slot_a + 5;
        slot_b = slot_b + 5;
    }
    slot_a + slot_b
}

fn kernel_cfg_diamond_and_loop_drop() -> i64 {
    let mut acc: i64 = 0;
    let mut k: i32 = 1i32;
    while k <= 5i32 {
        let _g = LoopDropGuard { step: k };
        if k == 1i32 {
            k = k + 1i32;
            continue;
        }
        if k == 3i32 {
            acc = acc + 45;
            break;
        }
        acc = acc + 25;
        k = k + 1i32;
    }
    let d_true: i64 = diamond_memory_merge(true, 10);
    let d_false: i64 = diamond_memory_merge(false, 10);
    acc + d_true + d_false
}

fn kernel_shift_and_sign_extrema(sh0: u64, sh63: u64, neg_v: i64, pos_v: i64) -> i64 {
    // Boundary shift counts 0 and 63 (width - 1) for 64-bit integers (REQ-CORE-3251, REQ-CORE-3268)
    let top_bit: u64 = 1u64 << sh63;
    let lshr_63: u64 = top_bit >> sh63;
    let id_sh0: u64 = (42u64 << sh0) + (58u64 >> sh0);

    // Arithmetic right shift by 63 on negative vs positive i64 (-1 vs 0)
    let ashr_neg: i64 = neg_v >> (sh63 as i64);
    let ashr_pos: i64 = pos_v >> (sh63 as i64);

    (lshr_63 as i64) + (id_sh0 as i64) + (ashr_neg * -9) + ashr_pos
}

fn kernel_zero_trip_licm_guard(trip_count: i64, zero_d: i64, bad_sh: i64) -> i64 {
    // AXS-PCT-004, AXS-PCT-010, AXS-PCT-021.3:
    // Loop executes 0 times when trip_count == 0; LICM MUST fail closed and never hoist
    // potentially trapping division or shift out of a zero-trip loop.
    let mut acc: i64 = 300;
    let mut i: i64 = 0;
    while i < trip_count {
        acc = acc + (500 / zero_d) + (1 << bad_sh);
        i = i + 1;
    }
    acc
}

pub fn main() -> i32 {
    print("Xin chào E18.5 boundary_cfg_diamond_and_loop_drop_guards\n");

    let m1: i64 = kernel_cfg_diamond_and_loop_drop();
    if m1 != 190 {
        return 1;
    }
    print("cfg_diamond_loop_drop=190\n");

    let m2: i64 = kernel_shift_and_sign_extrema(0u64, 63u64, -128, 128);
    if m2 != 110 {
        return 2;
    }
    print("shift_and_sign_extrema=110\n");

    let m3: i64 = kernel_zero_trip_licm_guard(0, 0, 64);
    if m3 != 300 {
        return 3;
    }
    print("zero_trip_licm_guard=300\n");

    let total: i64 = m1 + m2 + m3;
    if total != 600 {
        return 4;
    }
    print("checksum=600\n");
    0
}
