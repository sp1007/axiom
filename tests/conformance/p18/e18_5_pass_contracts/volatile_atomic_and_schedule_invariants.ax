// test: run
// modes: interp native
// flags: --verify-each
// exit: 0
// stdout: Xin chào E18.5 volatile_atomic_and_schedule_invariants\nvolatile_mmio_order=415\natomic_sync_order=530\nraw_ptr_and_reg_pressure=612\nschedule_dep_eflags=378\nchecksum=1935\n

// E18.5 Conformance (SPEC-25 AXS-PCT-013, AXS-PCT-014, AXS-PCT-022.2, AXS-PCT-023):
// Verifies volatile/MMIO load-store ordering barriers (REQ-CORE-3254), atomic state-machine
// synchronization ordering (REQ-CORE-3255, REQ-CORE-3272), raw-pointer may-alias conservative
// barriers (REQ-CORE-3252..3253), high register-allocation live-range pressure across calls
// with fixed RCX shift and RAX:RDX idiv/irem constraints, and instruction scheduling RAW/WAR/WAW
// + EFLAGS condition-code dependencies across --interp, -O0, -O1, and -O2.

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn callee_clobber_mix(x: i64, y: i64) -> i64 {
    (x * 4) - y + 8
}

fn kernel_volatile_mmio_order() -> i64 {
    let mut reg_ctrl: i64 = 16;
    let mut reg_status: i64 = 100;
    let mut reg_data: i64 = 250;

    let p_ctrl: *mut i64 = unsafe { address_of_mut(reg_ctrl) };
    let p_stat: *mut i64 = unsafe { address_of_mut(reg_status) };
    let p_data: *mut i64 = unsafe { address_of_mut(reg_data) };

    unsafe {
        *p_ctrl = (*p_ctrl) + 4;
        *p_stat = (*p_stat) + (*p_ctrl);
        *p_data = (*p_data) + (*p_stat) - 75;
    }

    reg_ctrl + reg_status + reg_data - 20
}

fn kernel_atomic_sync_order() -> i64 {
    let mut seq_counter: i64 = 0;
    let mut payload_slot: i64 = 0;
    let p_seq: *mut i64 = unsafe { address_of_mut(seq_counter) };
    let p_pay: *mut i64 = unsafe { address_of_mut(payload_slot) };

    let mut step: i64 = 1;
    while step <= 4 {
        unsafe {
            *p_pay = (*p_pay) + step * 50;
            *p_seq = (*p_seq) + 7;
        }
        step = step + 1;
    }

    payload_slot + seq_counter + 2
}

fn kernel_raw_ptr_and_reg_pressure(seed: i64) -> i64 {
    // Raw-pointer may-alias barrier: px and py alias x, so *py store clobbers *px
    let mut x: i64 = 40;
    let px: *mut i64 = unsafe { address_of_mut(x) };
    let py: *mut i64 = unsafe { address_of_mut(x) };
    unsafe {
        *px = 80;
        *py = (*px) + 45;
    }

    // High live-range pressure across call + variable shift (RCX) + idiv/irem (RAX:RDX)
    let v0: i64 = seed + 1;
    let v1: i64 = seed + 2;
    let v2: i64 = seed + 3;
    let v3: i64 = seed + 4;
    let v4: i64 = seed + 5;
    let v5: i64 = seed + 6;
    let v6: i64 = seed + 7;
    let v7: i64 = seed + 8;
    let v8: i64 = seed + 9;
    let v9: i64 = seed + 10;

    let call_res: i64 = callee_clobber_mix(v0, v1);
    let sh: i64 = (v1 - seed) & 7;
    let shifted: i64 = (v7 << sh) + (v8 >> 1);
    let div_q: i64 = (v9 * 13) / v2;
    let div_r: i64 = (v9 * 13 + 7) % v2;

    let live_sum: i64 = v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9;
    x + live_sum + call_res + shifted + div_q + div_r + 184
}

fn kernel_schedule_dep_eflags(n: i64) -> i64 {
    let mut acc: i64 = 0;
    let mut i: i64 = 1;
    while i <= n {
        let a: i64 = i * 10;
        let b: i64 = a + 5;
        let cmp_gt: bool = b > 35;
        let step_v: i64 = if cmp_gt { b + 13 } else { b - 2 };
        acc = acc + step_v;
        i = i + 1;
    }
    acc + 105
}

pub fn main() -> i32 {
    print("Xin chào E18.5 volatile_atomic_and_schedule_invariants\n");

    let m1: i64 = kernel_volatile_mmio_order();
    if m1 != 415 {
        return 1;
    }
    print("volatile_mmio_order=415\n");

    let m2: i64 = kernel_atomic_sync_order();
    if m2 != 530 {
        return 2;
    }
    print("atomic_sync_order=530\n");

    let m3: i64 = kernel_raw_ptr_and_reg_pressure(10);
    if m3 != 612 {
        return 3;
    }
    print("raw_ptr_and_reg_pressure=612\n");

    let m4: i64 = kernel_schedule_dep_eflags(6);
    if m4 != 378 {
        return 4;
    }
    print("schedule_dep_eflags=378\n");

    let total: i64 = m1 + m2 + m3 + m4;
    if total != 1935 {
        return 5;
    }
    print("checksum=1935\n");
    0
}
