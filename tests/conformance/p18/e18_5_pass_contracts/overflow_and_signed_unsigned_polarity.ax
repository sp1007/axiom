// test: run
// modes: interp native
// flags: --verify-each
// exit: 0
// stdout: Xin chào E18.5 overflow_and_signed_unsigned_polarity\nchecked_and_wrapping=194\nsigned_unsigned_polarity=312\nnarrow_and_i128_carry=478\nfail_closed_untaken=265\nchecksum=1249\n

// E18.5 Conformance (SPEC-25 AXS-PCT-010, AXS-PCT-014, AXS-PCT-021.1, AXS-PCT-022.1):
// Verifies checked vs wrapping arithmetic, shift-in-range, non-zero congruence proofs,
// signed vs unsigned comparison/division/shift polarity (REQ-CORE-3268), narrow integer
// sign/zero extension, 128-bit (lo, hi) multi-limb carry chains, and fail-closed rollback
// on Unknown/Possible obligations inside untaken loop branches across --interp, -O0, -O1, -O2.

fn kernel_checked_and_wrapping(a: i64, b: i64, scale: i64) -> i64 {
    // 1. Checked add/sub/mul & shift-in-range (AXS-PCT-014, AXS-PCT-021.1)
    let c_add: i64 = a + b;
    let c_sub: i64 = a - b;
    let c_mul: i64 = (a - 35) * 4;

    // 2. Congruence-proven non-zero divisor: d = (scale & 3) * 4 + 2 (stride=4, offset=2 -> never 0)
    let d: i64 = (scale & 3) * 4 + 2;
    // Bitmask-proven shift-in-range: sh = (scale & 1) + 1 (always in [1, 2] < 64)
    let sh: i64 = (scale & 1) + 1;

    let scaled_num: i64 = (a * 7) << sh;
    let q: i64 = scaled_num / d;
    let r: i64 = scaled_num % d;

    c_add + c_sub + c_mul + q + r - 66
}

fn kernel_signed_unsigned_polarity(s_neg: i64, s_pos: i64, u_hi: u64, u_lo: u64) -> i64 {
    // Signed comparison, division, remainder, and arithmetic right shift (REQ-CORE-3268)
    let sc1: i64 = if s_neg < s_pos { 40 } else { 0 };
    let s_div: i64 = s_neg / s_pos;
    let s_rem: i64 = (s_neg + 1) % s_pos;
    let s_shr: i64 = s_neg >> 3;

    // Unsigned comparison, division, remainder, and logical right shift (REQ-CORE-3268)
    let uc1: i64 = if u_hi > u_lo { 80 } else { 0 };
    let u_div: i64 = (u_hi / u_lo) as i64;
    let u_rem: i64 = ((u_hi + 7u64) % u_lo) as i64;
    let u_shr: i64 = (u_hi >> 2u64) as i64;

    // High-bit sign vs unsigned boundary check (0xFFFF_FFFF_FFFF_FFF0u64 vs -16i64)
    let hi_u: u64 = 0xFFFF_FFFF_FFFF_FFF0u64;
    let hi_s: i64 = -16;
    let pol_ok: i64 = if (hi_u > 10u64) && (hi_s < 10) { 104 } else { 0 };

    sc1 + s_div + s_rem + s_shr + uc1 + u_div + u_rem + u_shr + pol_ok
}

fn kernel_narrow_and_i128_carry() -> i64 {
    // Narrow integer sign-extension vs zero-extension (AXS-PCT-022.1)
    let n_i8: i8 = -25i8;
    let n_u8: u8 = 230u8;
    let n_i16: i16 = -120i16;
    let n_u16: u16 = 500u16;
    let ext_sum: i64 = (n_i8 as i64) + (n_u8 as i64) + (n_i16 as i64) + (n_u16 as i64);

    // Multi-word (lo, hi) carry propagation (SPEC-40, AXS-PCT-022.1)
    let a_lo: u64 = 0xFFFF_FFF4u64;
    let a_hi: u64 = 40u64;
    let b_lo: u64 = 28u64;
    let b_hi: u64 = 50u64;
    let raw_lo: u64 = a_lo + b_lo;
    let sum_lo: u64 = raw_lo & 0xFFFF_FFFFu64;
    let carry: u64 = raw_lo >> 32u64;
    let sum_hi: u64 = a_hi + b_hi + carry;

    ext_sum - ((sum_lo + carry + sum_hi) as i64) + 1
}

fn kernel_fail_closed_untaken(run_div: bool, run_shift: bool, zero_d: i64, bad_sh: i64) -> i64 {
    // AXS-PCT-004 & AXS-PCT-010: zero_d and bad_sh have Certainty.Unknown at loop entry.
    // LICM and speculative hoisting MUST fail closed and roll back rather than hoisting
    // trapping division/shifts out of the untaken conditional branches.
    let mut acc: i64 = 205;
    let mut k: i64 = 0;
    while k < 5 {
        if run_div {
            acc = acc + (1000 / zero_d);
        }
        if run_shift {
            acc = acc + (1 << bad_sh);
        }
        acc = acc + 12;
        k = k + 1;
    }
    acc
}

pub fn main() -> i32 {
    print("Xin chào E18.5 overflow_and_signed_unsigned_polarity\n");

    let m1: i64 = kernel_checked_and_wrapping(50, 18, 3);
    if m1 != 194 {
        return 1;
    }
    print("checked_and_wrapping=194\n");

    let m2: i64 = kernel_signed_unsigned_polarity(-48, 6, 320u64, 16u64);
    if m2 != 312 {
        return 2;
    }
    print("signed_unsigned_polarity=312\n");

    let m3: i64 = kernel_narrow_and_i128_carry();
    if m3 != 478 {
        return 3;
    }
    print("narrow_and_i128_carry=478\n");

    let m4: i64 = kernel_fail_closed_untaken(false, false, 0, 99);
    if m4 != 265 {
        return 4;
    }
    print("fail_closed_untaken=265\n");

    let total: i64 = m1 + m2 + m3 + m4;
    if total != 1249 {
        return 5;
    }
    print("checksum=1249\n");
    0
}
