// test: run
// modes: interp native
// flags: --verify-each
// exit: 0
// stdout: Xin chào E18.5 final_machine_ir_and_frame_reproducibility\nwin64_stack_args_align=510\nlarge_frame_and_slots=740\nshrink_wrap_and_tail_unwind=D99\nshrink_tail_val=365\nsecret_zeroize_barrier=420\nchecksum=2035\n

// E18.5 Conformance (SPEC-25 AXS-PCT-024, REQ-LNK-3384..3433):
// Verifies Final Machine IR 3.0 invariants across Win64 8-argument calls (4 register + 4 stack
// arguments, 16-byte RSP alignment, canonical callee-save save/restore), multi-array stack frame
// layouts with dynamic indexing, shrink-wrap early-return + unwind Drop guard paths, and
// Secret<T> zeroization barriers that must not be eliminated by DSE or finalization passes.

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub struct UnwindGuard {
    pub tag: i32,
}

impl Drop for UnwindGuard {
    fn drop(self: mut_view<UnwindGuard>) {
        if self.tag == 99i32 {
            print("shrink_wrap_and_tail_unwind=D99\n");
        }
    }
}

fn eight_arg_abi_target(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    a4: i64,
    a5: i64,
    a6: i64,
    a7: i64
) -> i64 {
    a0 * 2 + a1 * 3 + a2 * 4 + a3 * 5 + a4 * 6 + a5 * 7 + a6 * 8 + a7 * 9
}

fn kernel_win64_stack_args_align() -> i64 {
    let c1: i64 = eight_arg_abi_target(1, 2, 3, 4, 5, 6, 7, 8);
    let c2: i64 = eight_arg_abi_target(2, 3, 4, 5, 6, 7, 8, 9);
    c1 + c2 - 14
}

fn frame_slot_helper(x: i64, y: i64) -> i64 {
    x + y
}

fn kernel_large_frame_and_slots(dyn_idx: usize) -> i64 {
    let mut buf_a: [16]i64 = [0; 16];
    let mut buf_b: [16]i64 = [0; 16];
    let mut buf_c: [16]i64 = [0; 16];

    let mut i: usize = 0;
    while i < 16 {
        buf_a[i] = (i as i64) + 1;
        buf_b[i] = (i as i64) * 2 + 3;
        buf_c[i] = frame_slot_helper(buf_a[i], buf_b[i]);
        i = i + 1;
    }

    buf_c[0] + buf_c[dyn_idx] + buf_c[15] + 668
}

fn tail_accum(depth: i64, acc: i64) -> i64 {
    if depth <= 0 {
        return acc;
    }
    tail_accum(depth - 1, acc + depth * 15)
}

fn kernel_shrink_wrap_and_tail_unwind(fast_path: bool, depth: i64) -> i64 {
    if fast_path {
        return 100;
    }
    let _guard = UnwindGuard { tag: 99i32 };
    tail_accum(depth, 40)
}

fn kernel_secret_zeroize_barrier() -> i64 {
    let mut secret_key: [4]i64 = [101, 202, 303, 404];
    let mac: i64 = (secret_key[0] + secret_key[1] + secret_key[2] + secret_key[3]) / 3 + 83;

    // Explicit pointer-barrier zeroization of secret_key slots (AXS-PCT-024, REQ-LNK-3400)
    let mut k: usize = 0;
    while k < 4 {
        let p_slot: *mut i64 = unsafe { address_of_mut(secret_key[k]) };
        unsafe {
            *p_slot = 0;
        }
        k = k + 1;
    }

    let z_sum: i64 = secret_key[0] + secret_key[1] + secret_key[2] + secret_key[3];
    if z_sum != 0 {
        return -1;
    }
    mac + 1
}

pub fn main() -> i32 {
    print("Xin chào E18.5 final_machine_ir_and_frame_reproducibility\n");

    let m1: i64 = kernel_win64_stack_args_align();
    if m1 != 510 {
        return 1;
    }
    print("win64_stack_args_align=510\n");

    let m2: i64 = kernel_large_frame_and_slots(5);
    if m2 != 740 {
        return 2;
    }
    print("large_frame_and_slots=740\n");

    let fast_v: i64 = kernel_shrink_wrap_and_tail_unwind(true, 0);
    let slow_v: i64 = kernel_shrink_wrap_and_tail_unwind(false, 5);
    let m3: i64 = fast_v + slow_v;
    if m3 != 365 {
        return 3;
    }
    print("shrink_tail_val=365\n");

    let m4: i64 = kernel_secret_zeroize_barrier();
    if m4 != 420 {
        return 4;
    }
    print("secret_zeroize_barrier=420\n");

    let total: i64 = m1 + m2 + m3 + m4;
    if total != 2035 {
        return 5;
    }
    print("checksum=2035\n");
    0
}
