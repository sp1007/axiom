@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn probe_sv(arena: mut_view<Arena>, s: str) -> StrView {
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn bytes_eq(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    if a_len == 0 {
        return true;
    }
    if (a as usize) == 0 || (b as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if unsafe { *(a + i) } != unsafe { *(b + i) } {
            return false;
        }
        i = i + 1;
    }
    true
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    bytes_eq(a.ptr as *const u8, a.len, b.ptr as *const u8, b.len)
}

// ============================================================================
// Part A: `ParallelScheduler` Conformance Across `--jobs 1`, `2`, `4`, and `8`
// ============================================================================

fn setup_scheduler_workspace(
    str_arena: mut_view<Arena>,
    sched: mut_view<ParallelScheduler>,
    perm_mode: u32
) -> bool {
    let pkg_sv = probe_sv(mut_view(*str_arena), "app");
    let triple_sv = probe_sv(mut_view(*str_arena), "x86_64-windows");
    let abi_sv = probe_sv(mut_view(*str_arena), "win64");
    let ty_i32_sv = probe_sv(mut_view(*str_arena), "i32");
    let ty_vec2_sv = probe_sv(mut_view(*str_arena), "geom.Vec2");

    let mod_geom_sv = probe_sv(mut_view(*str_arena), "geom");
    let mod_phys_sv = probe_sv(mut_view(*str_arena), "physics");
    let mod_app_sv = probe_sv(mut_view(*str_arena), "entry");
    let mod_a_sv = probe_sv(mut_view(*str_arena), "mod_a");
    let mod_b_sv = probe_sv(mut_view(*str_arena), "mod_b");

    let pkg = PackageId { v: 1u32 };
    let unit = UnitKey { v: 1u32 };
    let _ = query_db_set_package_graph_input(mut_view(sched.db), pkg, pkg_sv, 2026u32, 0u32, 0u64);
    let _ = query_db_set_target_config_input(mut_view(sched.db), unit, triple_sv, abi_sv, 0u32, 2026u32, 2u8, 8u32);

    let _ = query_db_set_source_file_input(mut_view(sched.db), SourceFileId { v: 1u32 }, probe_sv(mut_view(*str_arena), "src/geom.ax"), probe_sv(mut_view(*str_arena), "// geom\n"), DURABILITY_LOW);
    let _ = query_db_set_source_file_input(mut_view(sched.db), SourceFileId { v: 2u32 }, probe_sv(mut_view(*str_arena), "src/physics.ax"), probe_sv(mut_view(*str_arena), "// physics\n"), DURABILITY_LOW);
    let _ = query_db_set_source_file_input(mut_view(sched.db), SourceFileId { v: 3u32 }, probe_sv(mut_view(*str_arena), "src/entry.ax"), probe_sv(mut_view(*str_arena), "// entry\n"), DURABILITY_LOW);
    let _ = query_db_set_source_file_input(mut_view(sched.db), SourceFileId { v: 4u32 }, probe_sv(mut_view(*str_arena), "src/mod_a.ax"), probe_sv(mut_view(*str_arena), "// mod_a\n"), DURABILITY_LOW);
    let _ = query_db_set_source_file_input(mut_view(sched.db), SourceFileId { v: 5u32 }, probe_sv(mut_view(*str_arena), "src/mod_b.ax"), probe_sv(mut_view(*str_arena), "// mod_b\n"), DURABILITY_LOW);

    let _ = query_db_set_module_tree_input(mut_view(sched.db), ModuleId { v: 1u32 }, pkg, ModuleId { v: 0u32 }, mod_geom_sv, SourceFileId { v: 1u32 }, DURABILITY_MEDIUM);
    let _ = query_db_set_module_tree_input(mut_view(sched.db), ModuleId { v: 2u32 }, pkg, ModuleId { v: 0u32 }, mod_phys_sv, SourceFileId { v: 2u32 }, DURABILITY_MEDIUM);
    let _ = query_db_set_module_tree_input(mut_view(sched.db), ModuleId { v: 3u32 }, pkg, ModuleId { v: 0u32 }, mod_app_sv, SourceFileId { v: 3u32 }, DURABILITY_MEDIUM);
    let _ = query_db_set_module_tree_input(mut_view(sched.db), ModuleId { v: 4u32 }, pkg, ModuleId { v: 0u32 }, mod_a_sv, SourceFileId { v: 4u32 }, DURABILITY_MEDIUM);
    let _ = query_db_set_module_tree_input(mut_view(sched.db), ModuleId { v: 5u32 }, pkg, ModuleId { v: 0u32 }, mod_b_sv, SourceFileId { v: 5u32 }, DURABILITY_MEDIUM);

    let sk_dot = semantic_key_new(pkg_sv, mod_geom_sv, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "dot"), qry_sv_empty());
    let sk_kin = semantic_key_new(pkg_sv, mod_phys_sv, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "kinetic_scale"), qry_sv_empty());
    let sk_main = semantic_key_new(pkg_sv, mod_app_sv, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "main"), qry_sv_empty());
    let sk_first = semantic_key_new(pkg_sv, mod_a_sv, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "FIRST"), qry_sv_empty());
    let sk_second = semantic_key_new(pkg_sv, mod_b_sv, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "SECOND"), qry_sv_empty());
    let sk_err_a = semantic_key_new(pkg_sv, mod_a_sv, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "err_in_a"), qry_sv_empty());
    let sk_err_b = semantic_key_new(pkg_sv, mod_b_sv, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "err_in_b"), qry_sv_empty());

    // Register items in 3 different worker arrival orders (`perm_mode == 0, 1, 2`):
    if perm_mode == 0u32 {
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 1u32 }, 1u32, ITEM_KIND_FN, true, 2u32, 1u32, ty_vec2_sv, sk_dot);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 2u32 }, 1u32, ITEM_KIND_FN, true, 2u32, 1u32, ty_i32_sv, sk_kin);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 3u32 }, 1u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_main);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 4u32 }, 1u32, ITEM_KIND_CONST, true, 0u32, 1u32, ty_i32_sv, sk_first);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 5u32 }, 1u32, ITEM_KIND_CONST, true, 0u32, 1u32, ty_i32_sv, sk_second);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 4u32 }, 2u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_err_a);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 5u32 }, 2u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_err_b);
    } else if perm_mode == 1u32 {
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 1u32, ModuleId { v: 5u32 }, 2u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_err_b);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 4u32 }, 2u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_err_a);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 1u32, ModuleId { v: 5u32 }, 1u32, ITEM_KIND_CONST, true, 0u32, 1u32, ty_i32_sv, sk_second);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 4u32 }, 1u32, ITEM_KIND_CONST, true, 0u32, 1u32, ty_i32_sv, sk_first);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 1u32, ModuleId { v: 3u32 }, 1u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_main);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 2u32 }, 1u32, ITEM_KIND_FN, true, 2u32, 1u32, ty_i32_sv, sk_kin);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 1u32, ModuleId { v: 1u32 }, 1u32, ITEM_KIND_FN, true, 2u32, 1u32, ty_vec2_sv, sk_dot);
    } else {
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 3u32, ModuleId { v: 3u32 }, 1u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_main);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 2u32, ModuleId { v: 5u32 }, 1u32, ITEM_KIND_CONST, true, 0u32, 1u32, ty_i32_sv, sk_second);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 1u32, ModuleId { v: 1u32 }, 1u32, ITEM_KIND_FN, true, 2u32, 1u32, ty_vec2_sv, sk_dot);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 3u32, ModuleId { v: 4u32 }, 2u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_err_a);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 0u32, ModuleId { v: 2u32 }, 1u32, ITEM_KIND_FN, true, 2u32, 1u32, ty_i32_sv, sk_kin);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 2u32, ModuleId { v: 5u32 }, 2u32, ITEM_KIND_FN, true, 0u32, 1u32, ty_i32_sv, sk_err_b);
        let _ = parallel_scheduler_register_scoped_def(mut_view(*sched), 1u32, ModuleId { v: 4u32 }, 1u32, ITEM_KIND_CONST, true, 0u32, 1u32, ty_i32_sv, sk_first);
    }

    let def_dot = scoped_def_id_to_def_id(scoped_def_id_new(1u32, 1u32));
    let def_kin = scoped_def_id_to_def_id(scoped_def_id_new(2u32, 1u32));
    let def_main = scoped_def_id_to_def_id(scoped_def_id_new(3u32, 1u32));
    let def_first = scoped_def_id_to_def_id(scoped_def_id_new(4u32, 1u32));
    let def_second = scoped_def_id_to_def_id(scoped_def_id_new(5u32, 1u32));
    let def_err_a = scoped_def_id_to_def_id(scoped_def_id_new(4u32, 2u32));
    let def_err_b = scoped_def_id_to_def_id(scoped_def_id_new(5u32, 2u32));

    query_db_add_body_call(mut_view(sched.db), def_kin, def_dot);
    query_db_add_body_call(mut_view(sched.db), def_main, def_kin);
    query_db_add_body_call(mut_view(sched.db), def_main, def_dot);

    query_db_add_body_const_dep(mut_view(sched.db), def_first, ConstEvalKey { v: def_second.v });
    query_db_add_body_const_dep(mut_view(sched.db), def_second, ConstEvalKey { v: def_first.v });

    query_db_set_def_flags(mut_view(sched.db), def_err_a, false, false, true);
    query_db_set_def_flags(mut_view(sched.db), def_err_b, false, false, true);

    query_db_reset_session_diags(mut_view(sched.db));
    let snap = parallel_scheduler_freeze_snapshot(mut_view(*sched), 1u64);
    snap.is_immutable && snap.arena_sealed
}

fn simulate_cross_worker_const_cycle(sched: mut_view<ParallelScheduler>, worker_b_completes_first: bool) -> bool {
    let def_first = scoped_def_id_to_def_id(scoped_def_id_new(4u32, 1u32));
    let def_second = scoped_def_id_to_def_id(scoped_def_id_new(5u32, 1u32));
    let qk_first = query_key_for_const_eval(view(sched.db), ConstEvalKey { v: def_first.v });
    let qk_second = query_key_for_const_eval(view(sched.db), ConstEvalKey { v: def_second.v });
    let sl_first = query_db_get_or_create_slot(mut_view(sched.db), qk_first);
    let sl_second = query_db_get_or_create_slot(mut_view(sched.db), qk_second);

    let c0 = wait_for_graph_claim_or_wait(mut_view(sched.wait_graph), mut_view(sched.db), 0u32, qk_first);
    wait_for_graph_push_worker_frame(mut_view(sched.wait_graph), 0u32, sl_first, qk_first);

    let c1 = wait_for_graph_claim_or_wait(mut_view(sched.wait_graph), mut_view(sched.db), 1u32, qk_second);
    wait_for_graph_push_worker_frame(mut_view(sched.wait_graph), 1u32, sl_second, qk_second);

    let mut wait_res: u8 = 0u8;
    let mut cyc_res: u8 = 0u8;
    if !worker_b_completes_first {
        wait_res = wait_for_graph_claim_or_wait(mut_view(sched.wait_graph), mut_view(sched.db), 0u32, qk_second);
        cyc_res = wait_for_graph_claim_or_wait(mut_view(sched.wait_graph), mut_view(sched.db), 1u32, qk_first);
    } else {
        wait_res = wait_for_graph_claim_or_wait(mut_view(sched.wait_graph), mut_view(sched.db), 1u32, qk_first);
        cyc_res = wait_for_graph_claim_or_wait(mut_view(sched.wait_graph), mut_view(sched.db), 0u32, qk_second);
    }

    wait_for_graph_pop_worker_frame(mut_view(sched.wait_graph), 1u32);
    wait_for_graph_pop_worker_frame(mut_view(sched.wait_graph), 0u32);

    c0 == CLAIM_ACQUIRED &&
        c1 == CLAIM_ACQUIRED &&
        wait_res == CLAIM_WAIT_SINGLE_FLIGHT &&
        cyc_res == CLAIM_CYCLE_DETECTED &&
        DIAG_AX_PARALLEL_QUERY_CYCLE == DIAG_AX_QUERY_CYCLE
}

fn verify_three_worker_cycle_rotation(str_arena: mut_view<Arena>) -> bool {
    let pkg = probe_sv(mut_view(*str_arena), "app");
    let m_a = probe_sv(mut_view(*str_arena), "mod_a");
    let m_b = probe_sv(mut_view(*str_arena), "mod_b");
    let m_c = probe_sv(mut_view(*str_arena), "mod_c");
    let empty = qry_sv_empty();

    let k_a = query_key_new(QUERY_CONST_EVAL, 101u32, semantic_key_new(pkg, m_a, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "ALPHA"), empty));
    let k_b = query_key_new(QUERY_CONST_EVAL, 102u32, semantic_key_new(pkg, m_b, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "BETA"), empty));
    let k_c = query_key_new(QUERY_CONST_EVAL, 103u32, semantic_key_new(pkg, m_c, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "GAMMA"), empty));

    let mut raw_012 = ParallelCycleStepBuf { items: [k_a; 16] };
    raw_012.items[0] = k_a;
    raw_012.items[1] = k_b;
    raw_012.items[2] = k_c;

    let mut raw_120 = ParallelCycleStepBuf { items: [k_a; 16] };
    raw_120.items[0] = k_b;
    raw_120.items[1] = k_c;
    raw_120.items[2] = k_a;

    let mut raw_201 = ParallelCycleStepBuf { items: [k_a; 16] };
    raw_201.items[0] = k_c;
    raw_201.items[1] = k_a;
    raw_201.items[2] = k_b;

    let mut out_012 = ParallelCycleStepBuf { items: [k_a; 16] };
    let mut out_120 = ParallelCycleStepBuf { items: [k_a; 16] };
    let mut out_201 = ParallelCycleStepBuf { items: [k_a; 16] };
    let mut head_012 = k_c;
    let mut head_120 = k_c;
    let mut head_201 = k_c;

    let fp_012 = parallel_rotate_cycle_canonical(view(raw_012), 3u32, mut_view(out_012), mut_view(head_012));
    let fp_120 = parallel_rotate_cycle_canonical(view(raw_120), 3u32, mut_view(out_120), mut_view(head_120));
    let fp_201 = parallel_rotate_cycle_canonical(view(raw_201), 3u32, mut_view(out_201), mut_view(head_201));

    fingerprint128_eq(fp_012, fp_120) &&
        fingerprint128_eq(fp_120, fp_201) &&
        query_key_eq(view(head_012), view(k_a)) &&
        query_key_eq(view(head_120), view(k_a)) &&
        query_key_eq(view(head_201), view(k_a)) &&
        query_key_eq(view(out_120.items[0]), view(k_a)) &&
        query_key_eq(view(out_120.items[1]), view(k_b)) &&
        query_key_eq(view(out_120.items[2]), view(k_c)) &&
        query_key_eq(view(out_120.items[3]), view(k_a))
}

fn enqueue_scheduler_tasks(sched: mut_view<ParallelScheduler>, order_mode: u32) {
    let def_dot = scoped_def_id_to_def_id(scoped_def_id_new(1u32, 1u32));
    let def_kin = scoped_def_id_to_def_id(scoped_def_id_new(2u32, 1u32));
    let def_main = scoped_def_id_to_def_id(scoped_def_id_new(3u32, 1u32));
    let def_err_a = scoped_def_id_to_def_id(scoped_def_id_new(4u32, 2u32));
    let def_err_b = scoped_def_id_to_def_id(scoped_def_id_new(5u32, 2u32));

    let q_mir_dot = query_key_for_def(view(sched.db), QUERY_MIR_BODY, def_dot);
    let q_mir_kin = query_key_for_def(view(sched.db), QUERY_MIR_BODY, def_kin);
    let q_mir_main = query_key_for_def(view(sched.db), QUERY_MIR_BODY, def_main);
    let q_tck_err_a = query_key_for_def(view(sched.db), QUERY_TYPECK_BODY, def_err_a);
    let q_tck_err_b = query_key_for_def(view(sched.db), QUERY_TYPECK_BODY, def_err_b);

    // Queue all tasks on worker 0 so workers 1..N steal from worker 0's deque (`total_steals > 0`),
    // varying priority/order across `--jobs 1/2/4/8`.
    if order_mode == 0u32 {
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_dot, PRIORITY_CRITICAL, 0u32, resource_cost_new(1u16, 4096u64, 100u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_kin, PRIORITY_INTERACTIVE, 0u32, resource_cost_new(1u16, 4096u64, 80u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_main, PRIORITY_NORMAL, 0u32, resource_cost_new(1u16, 4096u64, 60u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_tck_err_a, PRIORITY_NORMAL, 0u32, resource_cost_new(1u16, 4096u64, 40u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_tck_err_b, PRIORITY_NORMAL, 0u32, resource_cost_new(1u16, 4096u64, 20u64));
    } else if order_mode == 1u32 {
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_tck_err_b, PRIORITY_CRITICAL, 0u32, resource_cost_new(1u16, 4096u64, 100u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_tck_err_a, PRIORITY_INTERACTIVE, 0u32, resource_cost_new(1u16, 4096u64, 80u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_main, PRIORITY_NORMAL, 0u32, resource_cost_new(1u16, 4096u64, 60u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_kin, PRIORITY_NORMAL, 0u32, resource_cost_new(1u16, 4096u64, 40u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_dot, PRIORITY_BACKGROUND, 0u32, resource_cost_new(1u16, 4096u64, 20u64));
    } else {
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_main, PRIORITY_CRITICAL, 0u32, resource_cost_new(1u16, 4096u64, 120u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_tck_err_b, PRIORITY_INTERACTIVE, 0u32, resource_cost_new(1u16, 4096u64, 90u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_dot, PRIORITY_NORMAL, 0u32, resource_cost_new(1u16, 4096u64, 70u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_tck_err_a, PRIORITY_NORMAL, 0u32, resource_cost_new(1u16, 4096u64, 50u64));
        let _ = parallel_scheduler_submit_query_task(mut_view(*sched), q_mir_kin, PRIORITY_BACKGROUND, 0u32, resource_cost_new(1u16, 4096u64, 30u64));
    }
}

fn format_scheduler_full_dump(sched: view<ParallelScheduler>, out: mut_view<DiagBuffer>) {
    parallel_scheduler_emit_interner_summary(sched, mut_view(*out));
    parallel_scheduler_emit_hir_mir_dump(sched, mut_view(*out));
    parallel_scheduler_emit_cycles(sched, mut_view(*out));
    parallel_scheduler_emit_diagnostics(sched, mut_view(*out));
    parallel_scheduler_emit_equivalence_digest(sched, mut_view(*out));
}

fn run_scheduler_conformance(str_arena: mut_view<Arena>) -> i32 {
    let mut sched_j1 = parallel_scheduler_empty();
    let mut sched_j2 = parallel_scheduler_empty();
    let mut sched_j4 = parallel_scheduler_empty();
    let mut sched_j8 = parallel_scheduler_empty();

    parallel_scheduler_init(mut_view(sched_j1), 763u64, 1u32, SCHEDULE_MODE_DETERMINISTIC_DEBUG);
    parallel_scheduler_init(mut_view(sched_j2), 763u64, 2u32, SCHEDULE_MODE_BALANCED);
    parallel_scheduler_init(mut_view(sched_j4), 763u64, 4u32, SCHEDULE_MODE_INTERACTIVE);
    parallel_scheduler_init(mut_view(sched_j8), 763u64, 8u32, SCHEDULE_MODE_THROUGHPUT);

    let ws1 = setup_scheduler_workspace(mut_view(*str_arena), mut_view(sched_j1), 0u32);
    let ws2 = setup_scheduler_workspace(mut_view(*str_arena), mut_view(sched_j2), 1u32);
    let ws4 = setup_scheduler_workspace(mut_view(*str_arena), mut_view(sched_j4), 2u32);
    let ws8 = setup_scheduler_workspace(mut_view(*str_arena), mut_view(sched_j8), 1u32);
    if !ws1 || !ws2 || !ws4 || !ws8 {
        return 1;
    }

    if !parallel_snapshot_eq(view(sched_j1.snapshot), view(sched_j2.snapshot)) ||
        !parallel_snapshot_eq(view(sched_j2.snapshot), view(sched_j4.snapshot)) ||
        !parallel_snapshot_eq(view(sched_j4.snapshot), view(sched_j8.snapshot)) {
        return 2;
    }

    let cyc1 = simulate_cross_worker_const_cycle(mut_view(sched_j1), false);
    let cyc2 = simulate_cross_worker_const_cycle(mut_view(sched_j2), true);
    let cyc4 = simulate_cross_worker_const_cycle(mut_view(sched_j4), false);
    let cyc8 = simulate_cross_worker_const_cycle(mut_view(sched_j8), true);
    if !cyc1 || !cyc2 || !cyc4 || !cyc8 || !verify_three_worker_cycle_rotation(mut_view(*str_arena)) {
        return 3;
    }

    enqueue_scheduler_tasks(mut_view(sched_j1), 0u32);
    enqueue_scheduler_tasks(mut_view(sched_j2), 1u32);
    enqueue_scheduler_tasks(mut_view(sched_j4), 2u32);
    enqueue_scheduler_tasks(mut_view(sched_j8), 1u32);

    let fp1 = parallel_scheduler_execute_all(mut_view(sched_j1));
    let fp2 = parallel_scheduler_execute_all(mut_view(sched_j2));
    let fp4 = parallel_scheduler_execute_all(mut_view(sched_j4));
    let fp8 = parallel_scheduler_execute_all(mut_view(sched_j8));

    if !fingerprint128_eq(fp1, fp2) ||
        !fingerprint128_eq(fp2, fp4) ||
        !fingerprint128_eq(fp4, fp8) {
        return 4;
    }

    if sched_j1.total_steals != 0u32 ||
        sched_j2.total_steals == 0u32 ||
        sched_j4.total_steals == 0u32 ||
        sched_j8.total_steals == 0u32 {
        return 5;
    }

    let dot_sv = probe_sv(mut_view(*str_arena), "dot");
    let vec2_sv = probe_sv(mut_view(*str_arena), "geom.Vec2");
    let id1_dot = sharded_interner_lookup(view(sched_j1.interner), INTERN_DOMAIN_STR, dot_sv, 0u32);
    let id2_dot = sharded_interner_lookup(view(sched_j2.interner), INTERN_DOMAIN_STR, dot_sv, 0u32);
    let id4_dot = sharded_interner_lookup(view(sched_j4.interner), INTERN_DOMAIN_STR, dot_sv, 0u32);
    let id8_dot = sharded_interner_lookup(view(sched_j8.interner), INTERN_DOMAIN_STR, dot_sv, 0u32);
    let id1_vec = sharded_interner_lookup(view(sched_j1.interner), INTERN_DOMAIN_TYPE, vec2_sv, 1u32);
    let id8_vec = sharded_interner_lookup(view(sched_j8.interner), INTERN_DOMAIN_TYPE, vec2_sv, 1u32);

    if !sharded_intern_id_eq(view(id1_dot), view(id2_dot)) ||
        !sharded_intern_id_eq(view(id2_dot), view(id4_dot)) ||
        !sharded_intern_id_eq(view(id4_dot), view(id8_dot)) ||
        !sharded_intern_id_eq(view(id1_vec), view(id8_vec)) ||
        !fingerprint128_eq(sched_j1.interner.table_fingerprint, sched_j8.interner.table_fingerprint) {
        return 6;
    }

    let mut out1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut out2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut out4 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut out8 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(out1));
    diag_buf_init(mut_view(out2));
    diag_buf_init(mut_view(out4));
    diag_buf_init(mut_view(out8));

    format_scheduler_full_dump(view(sched_j1), mut_view(out1));
    format_scheduler_full_dump(view(sched_j2), mut_view(out2));
    format_scheduler_full_dump(view(sched_j4), mut_view(out4));
    format_scheduler_full_dump(view(sched_j8), mut_view(out8));

    let dumps_ok = out1.len > 128 &&
        diag_buf_eq(view(out1), view(out2)) &&
        diag_buf_eq(view(out2), view(out4)) &&
        diag_buf_eq(view(out4), view(out8));

    diag_buf_free(mut_view(out1));
    diag_buf_free(mut_view(out2));
    diag_buf_free(mut_view(out4));
    diag_buf_free(mut_view(out8));
    parallel_scheduler_free(mut_view(sched_j1));
    parallel_scheduler_free(mut_view(sched_j2));
    parallel_scheduler_free(mut_view(sched_j4));
    parallel_scheduler_free(mut_view(sched_j8));

    if !dumps_ok {
        return 7;
    }

    print("jobs_1_2_4_8_hir_mir_and_interner_invariance_ok=true\n");
    print("cross_worker_cycle_rotation_and_single_flight_ok=true\n");
    0
}

// ============================================================================
// Part B: `ParallelCodegenEngine` Conformance Across `--jobs 1`, `2`, `4`, `8`
// ============================================================================

fn populate_codegen_workspace(
    eng: mut_view<ParallelCodegenEngine>,
    str_arena: mut_view<Arena>,
    phys_src: StrView,
    diag_perm: u32
) {
    let comp_dig = fingerprint128_new(0x4158494F4D43325Fu64, 0x323032365F563130u64);
    let man_dig = fingerprint128_new(0x4D414E4946455354u64, 0x0000000000000763u64);
    let triple = probe_sv(mut_view(*str_arena), "x86_64-pc-windows-msvc");
    let abi_prof = probe_sv(mut_view(*str_arena), "win64");

    inc_cache_set_action_config(
        mut_view(eng.cache),
        comp_dig,
        triple,
        abi_prof,
        0u32,
        2u8,
        SAFETY_PROFILE_STANDARD,
        PANIC_STRATEGY_UNWIND,
        ARTIFACT_KIND_EXE,
        man_dig
    );

    let pkg = probe_sv(mut_view(*str_arena), "app_pkg");
    let m_geom = probe_sv(mut_view(*str_arena), "geom");
    let m_phys = probe_sv(mut_view(*str_arena), "physics");
    let m_app = probe_sv(mut_view(*str_arena), "app");
    let m_util = probe_sv(mut_view(*str_arena), "util");

    let p_geom = probe_sv(mut_view(*str_arena), "src/geom.ax");
    let p_phys = probe_sv(mut_view(*str_arena), "src/physics.ax");
    let p_app = probe_sv(mut_view(*str_arena), "src/app.ax");
    let p_util = probe_sv(mut_view(*str_arena), "src/util.ax");

    let src_geom = probe_sv(
        mut_view(*str_arena),
        "pub struct Vec2 { pub x: i32, pub y: i32 }\npub fn dot(a: view<Vec2>, b: view<Vec2>) -> i32 { a.x * b.x + a.y * b.y }\npub fn norm_sq(v: view<Vec2>) -> i32 { dot(v, v) }\n"
    );
    let src_app = probe_sv(
        mut_view(*str_arena),
        "pub fn main() -> i32 { kinetic_scale(2) + clamp_energy(50) }\n"
    );
    let src_util = probe_sv(
        mut_view(*str_arena),
        "pub const MAX_ENERGY: i64 = 1000\npub fn clamp_energy(e: i32) -> i32 { e }\n"
    );

    let mod_geom = ModuleId { v: 1u32 };
    let mod_phys = ModuleId { v: 2u32 };
    let mod_app = ModuleId { v: 3u32 };
    let mod_util = ModuleId { v: 4u32 };

    inc_cache_register_module(mut_view(eng.cache), mod_geom, PackageId { v: 1u32 }, pkg, m_geom, SourceFileId { v: 1u32 }, p_geom, src_geom, 1000u64);
    inc_cache_register_module(mut_view(eng.cache), mod_phys, PackageId { v: 1u32 }, pkg, m_phys, SourceFileId { v: 2u32 }, p_phys, phys_src, 1000u64);
    inc_cache_register_module(mut_view(eng.cache), mod_app, PackageId { v: 1u32 }, pkg, m_app, SourceFileId { v: 3u32 }, p_app, src_app, 1000u64);
    inc_cache_register_module(mut_view(eng.cache), mod_util, PackageId { v: 1u32 }, pkg, m_util, SourceFileId { v: 4u32 }, p_util, src_util, 1000u64);

    inc_add_module_import(mut_view(eng.cache.eng), mod_phys, mod_geom);
    inc_add_module_import(mut_view(eng.cache.eng), mod_app, mod_geom);
    inc_add_module_import(mut_view(eng.cache.eng), mod_app, mod_phys);
    inc_add_module_import(mut_view(eng.cache.eng), mod_app, mod_util);

    let empty = qry_sv_empty();
    let n_vec2 = probe_sv(mut_view(*str_arena), "Vec2");
    let n_dot = probe_sv(mut_view(*str_arena), "dot");
    let n_norm = probe_sv(mut_view(*str_arena), "norm_sq");
    let n_kin = probe_sv(mut_view(*str_arena), "kinetic_scale");
    let n_step = probe_sv(mut_view(*str_arena), "step_velocity");
    let n_main = probe_sv(mut_view(*str_arena), "main");
    let n_maxe = probe_sv(mut_view(*str_arena), "MAX_ENERGY");
    let n_clamp = probe_sv(mut_view(*str_arena), "clamp_energy");

    let d_vec2 = inc_register_item(mut_view(eng.cache.eng), DefId { v: 10u32 }, mod_geom, ITEM_KIND_STRUCT, true, false, false, 0u32, 2u32, n_vec2, empty);
    let d_dot = inc_register_item(mut_view(eng.cache.eng), DefId { v: 11u32 }, mod_geom, ITEM_KIND_FN, true, false, false, 2u32, 1u32, n_dot, empty);
    let d_norm = inc_register_item(mut_view(eng.cache.eng), DefId { v: 12u32 }, mod_geom, ITEM_KIND_FN, true, true, false, 1u32, 1u32, n_norm, empty);
    let d_kin = inc_register_item(mut_view(eng.cache.eng), DefId { v: 20u32 }, mod_phys, ITEM_KIND_FN, true, false, false, 2u32, 1u32, n_kin, empty);
    let d_step = inc_register_item(mut_view(eng.cache.eng), DefId { v: 21u32 }, mod_phys, ITEM_KIND_FN, false, false, false, 1u32, 1u32, n_step, empty);
    let d_main = inc_register_item(mut_view(eng.cache.eng), DefId { v: 30u32 }, mod_app, ITEM_KIND_FN, true, false, false, 0u32, 1u32, n_main, empty);
    let d_maxe = inc_register_item(mut_view(eng.cache.eng), DefId { v: 40u32 }, mod_util, ITEM_KIND_CONST, true, false, false, 0u32, 1u32, n_maxe, empty);
    let d_clamp = inc_register_item(mut_view(eng.cache.eng), DefId { v: 41u32 }, mod_util, ITEM_KIND_FN, true, false, false, 1u32, 1u32, n_clamp, empty);

    inc_add_item_layout_dep(mut_view(eng.cache.eng), d_dot, d_vec2);
    inc_add_item_call_dep(mut_view(eng.cache.eng), d_norm, d_dot);
    inc_add_item_call_dep(mut_view(eng.cache.eng), d_kin, d_dot);
    inc_add_item_call_dep(mut_view(eng.cache.eng), d_kin, d_step);
    inc_add_item_layout_dep(mut_view(eng.cache.eng), d_kin, d_vec2);
    inc_add_item_call_dep(mut_view(eng.cache.eng), d_main, d_kin);
    inc_add_item_call_dep(mut_view(eng.cache.eng), d_main, d_clamp);
    inc_add_item_const_dep(mut_view(eng.cache.eng), d_clamp, d_maxe);

    let sk_dot = semantic_key_new(pkg, m_geom, ITEM_NS_VALUE, 0u32, n_dot, empty);
    let sk_kin = semantic_key_new(pkg, m_phys, ITEM_NS_VALUE, 0u32, n_kin, empty);
    let sk_main = semantic_key_new(pkg, m_app, ITEM_NS_VALUE, 0u32, n_main, empty);
    let sk_clamp = semantic_key_new(pkg, m_util, ITEM_NS_VALUE, 0u32, n_clamp, empty);

    let msg_geom = probe_sv(mut_view(*str_arena), "unnecessary copy of Vec2 view in dot");
    let msg_phys = probe_sv(mut_view(*str_arena), "shadowed local scalar in kinetic_scale");
    let msg_app = probe_sv(mut_view(*str_arena), "constant argument in main");
    let msg_util = probe_sv(mut_view(*str_arena), "unused bound MAX_ENERGY in clamp_energy");

    if diag_perm == 0u32 {
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 1u32 }, 48u32, 2u32, 12u32, 2101u32, CACHED_DIAG_WARNING, mod_geom, d_dot, sk_dot, msg_geom);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 2u32 }, 64u32, 3u32, 9u32, 2102u32, CACHED_DIAG_WARNING, mod_phys, d_kin, sk_kin, msg_phys);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 3u32 }, 24u32, 1u32, 22u32, 2104u32, CACHED_DIAG_WARNING, mod_app, d_main, sk_main, msg_app);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 4u32 }, 32u32, 2u32, 5u32, 2103u32, CACHED_DIAG_WARNING, mod_util, d_clamp, sk_clamp, msg_util);
    } else if diag_perm == 1u32 {
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 4u32 }, 32u32, 2u32, 5u32, 2103u32, CACHED_DIAG_WARNING, mod_util, d_clamp, sk_clamp, msg_util);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 3u32 }, 24u32, 1u32, 22u32, 2104u32, CACHED_DIAG_WARNING, mod_app, d_main, sk_main, msg_app);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 2u32 }, 64u32, 3u32, 9u32, 2102u32, CACHED_DIAG_WARNING, mod_phys, d_kin, sk_kin, msg_phys);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 1u32 }, 48u32, 2u32, 12u32, 2101u32, CACHED_DIAG_WARNING, mod_geom, d_dot, sk_dot, msg_geom);
    } else {
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 3u32 }, 24u32, 1u32, 22u32, 2104u32, CACHED_DIAG_WARNING, mod_app, d_main, sk_main, msg_app);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 1u32 }, 48u32, 2u32, 12u32, 2101u32, CACHED_DIAG_WARNING, mod_geom, d_dot, sk_dot, msg_geom);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 4u32 }, 32u32, 2u32, 5u32, 2103u32, CACHED_DIAG_WARNING, mod_util, d_clamp, sk_clamp, msg_util);
        parallel_codegen_attach_diag(mut_view(*eng), true, SourceFileId { v: 2u32 }, 64u32, 3u32, 9u32, 2102u32, CACHED_DIAG_WARNING, mod_phys, d_kin, sk_kin, msg_phys);
    }
}

fn verify_engines_byte_identical(
    a: view<ParallelCodegenEngine>,
    b: view<ParallelCodegenEngine>,
    expected_cgus: u32
) -> bool {
    if a.cgu_count != b.cgu_count || a.cgu_count != expected_cgus {
        return false;
    }
    if a.link_barrier != BARRIER_PASSED || b.link_barrier != BARRIER_PASSED {
        return false;
    }
    if a.package_barrier != BARRIER_PASSED || a.signing_barrier != BARRIER_PASSED {
        return false;
    }
    if a.final_artifact_stage != ARTIFACT_STAGE_PUBLISHED || b.final_artifact_stage != ARTIFACT_STAGE_PUBLISHED {
        return false;
    }
    if !fingerprint128_eq(a.combined_obj_fp, b.combined_obj_fp) ||
        !fingerprint128_eq(a.combined_lir_mir_fp, b.combined_lir_mir_fp) ||
        !fingerprint128_eq(a.linked_exe_fp, b.linked_exe_fp) ||
        !fingerprint128_eq(a.merged_diag_fp, b.merged_diag_fp) {
        return false;
    }
    if !bytes_eq(
        a.linked_exe_bytes as *const u8,
        a.linked_exe_len as usize,
        b.linked_exe_bytes as *const u8,
        b.linked_exe_len as usize
    ) {
        return false;
    }

    let mut i: u32 = 0u32;
    while i < a.cgu_count {
        let ca = parallel_codegen_get_cgu(a, i);
        let cb = parallel_codegen_get_cgu(b, i);
        if !fingerprint128_eq(ca.cgu_fp, cb.cgu_fp) ||
            !fingerprint128_eq(ca.obj_digest, cb.obj_digest) ||
            !fingerprint128_eq(ca.lir_mir_dump_fp, cb.lir_mir_dump_fp) ||
            ca.lir_inst_count != cb.lir_inst_count ||
            ca.vreg_count != cb.vreg_count ||
            ca.stack_frame_bytes != cb.stack_frame_bytes ||
            ca.symbol_count != cb.symbol_count ||
            ca.reloc_count != cb.reloc_count ||
            !ca.x64_verified ||
            !cb.x64_verified ||
            !bytes_eq(
                ca.obj_bytes as *const u8,
                ca.obj_len as usize,
                cb.obj_bytes as *const u8,
                cb.obj_len as usize
            ) {
            return false;
        }
        i = i + 1u32;
    }
    true
}

fn configure_delay_schedule(eng: mut_view<ParallelCodegenEngine>, schedule_variant: u32) {
    if schedule_variant == 1u32 {
        // Reverse worker completion delays (`50 ms` on CGU 0, `0 ms` on CGU 3)
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 0u32, 0u32, PRIORITY_NORMAL, 50u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 1u32, 0u32, PRIORITY_NORMAL, 40u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 2u32, 0u32, PRIORITY_INTERACTIVE, 10u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 3u32, 0u32, PRIORITY_CRITICAL, 0u32);
    } else if schedule_variant == 2u32 {
        // Scrambled middle-out worker completion delays
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 0u32, 0u32, PRIORITY_BACKGROUND, 35u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 1u32, 0u32, PRIORITY_NORMAL, 65u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 2u32, 0u32, PRIORITY_CRITICAL, 0u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 3u32, 0u32, PRIORITY_INTERACTIVE, 15u32);
    } else {
        // Interleaved high-jitter worker completion delays
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 0u32, 0u32, PRIORITY_NORMAL, 80u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 1u32, 0u32, PRIORITY_CRITICAL, 5u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 2u32, 0u32, PRIORITY_BACKGROUND, 45u32);
        parallel_codegen_set_cgu_schedule_hint(mut_view(*eng), 3u32, 0u32, PRIORITY_INTERACTIVE, 0u32);
    }
}

fn run_codegen_conformance(str_arena: mut_view<Arena>, disk_cache_dir: StrView) -> i32 {
    if parallel_codegen_validate_cli_jobs(0u32) != DIAG_AX_DRIVER_USAGE ||
        parallel_codegen_validate_cli_jobs(1u32) != 0u32 ||
        parallel_codegen_validate_cli_jobs(2u32) != 0u32 ||
        parallel_codegen_validate_cli_jobs(4u32) != 0u32 ||
        parallel_codegen_validate_cli_jobs(8u32) != 0u32 {
        return 10;
    }

    let src_phys_r1 = probe_sv(
        mut_view(*str_arena),
        "fn step_velocity(v: i32) -> i32 { v + 5 }\npub fn kinetic_scale(v: view<Vec2>, mass: i32) -> i32 { dot(v, v) * step_velocity(mass) }\n"
    );

    let mut eng_j1 = parallel_codegen_empty();
    let mut eng_j2 = parallel_codegen_empty();
    let mut eng_j4 = parallel_codegen_empty();
    let mut eng_j8 = parallel_codegen_empty();

    parallel_codegen_init(mut_view(eng_j1), 763u64, 1u32, SCHEDULE_MODE_DETERMINISTIC_DEBUG);
    parallel_codegen_init(mut_view(eng_j2), 763u64, 2u32, SCHEDULE_MODE_BALANCED);
    parallel_codegen_init(mut_view(eng_j4), 763u64, 4u32, SCHEDULE_MODE_INTERACTIVE);
    parallel_codegen_init(mut_view(eng_j8), 763u64, 8u32, SCHEDULE_MODE_THROUGHPUT);

    populate_codegen_workspace(mut_view(eng_j1), mut_view(*str_arena), src_phys_r1, 0u32);
    populate_codegen_workspace(mut_view(eng_j2), mut_view(*str_arena), src_phys_r1, 1u32);
    populate_codegen_workspace(mut_view(eng_j4), mut_view(*str_arena), src_phys_r1, 2u32);
    populate_codegen_workspace(mut_view(eng_j8), mut_view(*str_arena), src_phys_r1, 1u32);

    let _ = parallel_codegen_partition_cgus(mut_view(eng_j1));
    let _ = parallel_codegen_partition_cgus(mut_view(eng_j2));
    let _ = parallel_codegen_partition_cgus(mut_view(eng_j4));
    let _ = parallel_codegen_partition_cgus(mut_view(eng_j8));

    configure_delay_schedule(mut_view(eng_j2), 1u32);
    configure_delay_schedule(mut_view(eng_j4), 2u32);
    configure_delay_schedule(mut_view(eng_j8), 3u32);

    if !parallel_codegen_execute_workspace(mut_view(eng_j1), false) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j2), false) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j4), false) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j8), false) {
        return 11;
    }

    if eng_j1.total_steals != 0u32 ||
        eng_j2.total_steals == 0u32 ||
        eng_j4.total_steals == 0u32 ||
        eng_j8.total_steals == 0u32 {
        return 12;
    }

    if !verify_engines_byte_identical(view(eng_j1), view(eng_j2), 4u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j4), 4u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j8), 4u32) {
        return 13;
    }

    // Also verify `SCHEDULE_MODE_MEMORY_BOUND` and `SCHEDULE_MODE_LOW_POWER` policy invariance (`AXS-PAR-001 §2`)
    parallel_codegen_reconfigure_jobs(mut_view(eng_j4), 4u32, SCHEDULE_MODE_MEMORY_BOUND);
    parallel_codegen_reconfigure_jobs(mut_view(eng_j8), 8u32, SCHEDULE_MODE_LOW_POWER);
    configure_delay_schedule(mut_view(eng_j4), 2u32);
    configure_delay_schedule(mut_view(eng_j8), 3u32);
    if !parallel_codegen_execute_workspace(mut_view(eng_j4), false) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j8), false) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j4), 4u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j8), 4u32) {
        return 14;
    }
    parallel_codegen_reconfigure_jobs(mut_view(eng_j4), 4u32, SCHEDULE_MODE_INTERACTIVE);
    parallel_codegen_reconfigure_jobs(mut_view(eng_j8), 8u32, SCHEDULE_MODE_THROUGHPUT);

    // Compare full inspect dumps (`stats` + `cgu_summary` + `diagnostics`) across `--jobs 1/2/4/8`
    let mut dump_j1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut dump_j2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut dump_j4 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut dump_j8 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dump_j1));
    diag_buf_init(mut_view(dump_j2));
    diag_buf_init(mut_view(dump_j4));
    diag_buf_init(mut_view(dump_j8));

    parallel_codegen_emit_inspect_dump(view(eng_j1), mut_view(dump_j1));
    parallel_codegen_emit_inspect_dump(view(eng_j2), mut_view(dump_j2));
    parallel_codegen_emit_inspect_dump(view(eng_j4), mut_view(dump_j4));
    parallel_codegen_emit_inspect_dump(view(eng_j8), mut_view(dump_j8));

    // Note: `eng_j4` had `SCHEDULE_MODE_MEMORY_BOUND` earlier, so run one clean `SCHEDULE_MODE_INTERACTIVE` pass
    // to ensure its bottleneck classification is `BALANCED` like `eng_j1`, `eng_j2`, `eng_j8`
    diag_buf_free(mut_view(dump_j4));
    diag_buf_init(mut_view(dump_j4));
    let _ = parallel_codegen_execute_workspace(mut_view(eng_j4), false);
    parallel_codegen_emit_inspect_dump(view(eng_j4), mut_view(dump_j4));

    let same_inspect = dump_j1.len > 128 &&
        diag_buf_eq(view(dump_j1), view(dump_j2)) &&
        diag_buf_eq(view(dump_j2), view(dump_j4)) &&
        diag_buf_eq(view(dump_j4), view(dump_j8));

    diag_buf_free(mut_view(dump_j1));
    diag_buf_free(mut_view(dump_j2));
    diag_buf_free(mut_view(dump_j4));
    diag_buf_free(mut_view(dump_j8));
    if !same_inspect {
        return 15;
    }
    print("jobs_1_2_4_8_byte_identical_obj_exe_and_lir_dumps_ok=true\n");

    // Persist `.axiom-cache` to disk if `--cache-dir` was provided (`AXS-PAR-022`)
    if disk_cache_dir.len > 0 {
        if !inc_cache_save_to_disk(mut_view(eng_j8.cache), disk_cache_dir) {
            return 16;
        }
        let load_st = inc_cache_load_from_disk(mut_view(eng_j8.cache), disk_cache_dir);
        if load_st != CACHE_EVICT_NONE {
            return 17;
        }
    }

    // Warm no-op build across `--jobs 2`, `--jobs 4`, and `--jobs 8`: all 4 CGUs hit `.axiom-cache`
    if !parallel_codegen_execute_workspace(mut_view(eng_j2), true) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j4), true) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j8), true) {
        return 18;
    }
    if eng_j8.cached_actions != 4u32 ||
        eng_j8.executed_actions != 0u32 ||
        eng_j8.bottleneck_kind != BOTTLENECK_CACHE_BOUND ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j2), 4u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j4), 4u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j8), 4u32) {
        return 19;
    }
    print("warm_noop_parallel_cache_reuse_ok=true\n");

    // Hybrid Parallel + Incremental Rebuild R2: edit private helper `step_velocity` in `physics` (`ModuleId = 2`)
    let src_phys_r2 = probe_sv(
        mut_view(*str_arena),
        "fn step_velocity(v: i32) -> i32 { v + 777 }\npub fn kinetic_scale(v: view<Vec2>, mass: i32) -> i32 { dot(v, v) * step_velocity(mass) }\n"
    );
    let _ = inc_cache_update_module_source(mut_view(eng_j1.cache), ModuleId { v: 2u32 }, src_phys_r2, 2000u64);
    let _ = inc_cache_update_module_source(mut_view(eng_j2.cache), ModuleId { v: 2u32 }, src_phys_r2, 2000u64);
    let _ = inc_cache_update_module_source(mut_view(eng_j4.cache), ModuleId { v: 2u32 }, src_phys_r2, 2000u64);
    let _ = inc_cache_update_module_source(mut_view(eng_j8.cache), ModuleId { v: 2u32 }, src_phys_r2, 2000u64);

    if !parallel_codegen_execute_workspace(mut_view(eng_j1), false) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j2), true) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j4), true) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j8), true) {
        return 20;
    }

    if eng_j1.cached_actions != 0u32 ||
        eng_j1.executed_actions != 4u32 ||
        eng_j2.cached_actions != 3u32 ||
        eng_j2.executed_actions != 1u32 ||
        eng_j4.cached_actions != 3u32 ||
        eng_j4.executed_actions != 1u32 ||
        eng_j8.cached_actions != 3u32 ||
        eng_j8.executed_actions != 1u32 ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j2), 4u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j4), 4u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j8), 4u32) {
        return 21;
    }

    if disk_cache_dir.len > 0 {
        if !inc_cache_save_to_disk(mut_view(eng_j8.cache), disk_cache_dir) {
            return 22;
        }
    }
    print("hybrid_parallel_incremental_rebuild_determinism_ok=true\n");

    // Multi-partition per-module CGU splitting (`max_items_per_cgu = 1` -> 8 CGUs) + external archive ordering
    parallel_codegen_set_max_items_per_cgu(mut_view(eng_j1), 1u32);
    parallel_codegen_set_max_items_per_cgu(mut_view(eng_j2), 1u32);
    parallel_codegen_set_max_items_per_cgu(mut_view(eng_j4), 1u32);
    parallel_codegen_set_max_items_per_cgu(mut_view(eng_j8), 1u32);
    let ar_bytes: [8]u8 = [33u8, 60u8, 97u8, 114u8, 99u8, 104u8, 62u8, 10u8];
    let ar_name = probe_sv(mut_view(*str_arena), "ext_runtime.lib");
    let _ = parallel_codegen_register_external_archive(mut_view(eng_j1), ar_name, unsafe { address_of(ar_bytes[0]) }, 8u32);
    let _ = parallel_codegen_register_external_archive(mut_view(eng_j2), ar_name, unsafe { address_of(ar_bytes[0]) }, 8u32);
    let _ = parallel_codegen_register_external_archive(mut_view(eng_j4), ar_name, unsafe { address_of(ar_bytes[0]) }, 8u32);
    let _ = parallel_codegen_register_external_archive(mut_view(eng_j8), ar_name, unsafe { address_of(ar_bytes[0]) }, 8u32);

    if !parallel_codegen_execute_workspace(mut_view(eng_j1), false) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j2), false) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j4), false) ||
        !parallel_codegen_execute_workspace(mut_view(eng_j8), false) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j2), 8u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j4), 8u32) ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j8), 8u32) {
        return 23;
    }
    parallel_codegen_set_max_items_per_cgu(mut_view(eng_j1), 16u32);
    parallel_codegen_set_max_items_per_cgu(mut_view(eng_j2), 16u32);
    parallel_codegen_set_max_items_per_cgu(mut_view(eng_j4), 16u32);
    parallel_codegen_set_max_items_per_cgu(mut_view(eng_j8), 16u32);
    let _ = parallel_codegen_partition_cgus(mut_view(eng_j1));
    let _ = parallel_codegen_partition_cgus(mut_view(eng_j2));
    let _ = parallel_codegen_partition_cgus(mut_view(eng_j4));
    let _ = parallel_codegen_partition_cgus(mut_view(eng_j8));
    print("multi_cgu_partition_and_archive_order_ok=true\n");

    // Transient fault retry (`FAULT_WORKER_FAILURE`, `FAULT_RESOURCE_FAILURE`), duplicate verify, & corrupt quarantine
    let _ = parallel_codegen_execute_workspace(mut_view(eng_j1), false);
    parallel_codegen_set_memory_pressure(mut_view(eng_j8), MEM_PRESSURE_ELEVATED);
    parallel_codegen_inject_cgu_fault(mut_view(eng_j8), 1u32, true, false, false);
    parallel_codegen_inject_cgu_fault(mut_view(eng_j8), 2u32, false, true, false);
    if !parallel_codegen_execute_workspace(mut_view(eng_j8), false) {
        return 24;
    }
    let cgu1_r = parallel_codegen_get_cgu(view(eng_j8), 1u32);
    let cgu2_r = parallel_codegen_get_cgu(view(eng_j8), 2u32);
    if eng_j8.retried_actions != 2u32 ||
        cgu1_r.fault_kind != FAULT_WORKER_FAILURE ||
        cgu2_r.fault_kind != FAULT_RESOURCE_FAILURE ||
        !verify_engines_byte_identical(view(eng_j1), view(eng_j8), 4u32) {
        return 25;
    }
    parallel_codegen_set_memory_pressure(mut_view(eng_j8), MEM_PRESSURE_NORMAL);

    let cgu0_dig = parallel_codegen_get_cgu(view(eng_j8), 0u32).obj_digest;
    if !parallel_codegen_verify_duplicate_cgu(mut_view(eng_j8), 0u32, cgu0_dig) {
        return 26;
    }
    let bad_fp = fingerprint128_new(0xDEAD0000u64, 0xBEEF0000u64);
    if parallel_codegen_verify_duplicate_cgu(mut_view(eng_j8), 0u32, bad_fp) ||
        eng_j8.last_ice_code != DIAG_AX_ICE_PARALLEL_VERIFY {
        return 27;
    }

    parallel_codegen_inject_cgu_fault(mut_view(eng_j8), 0u32, false, false, true);
    if parallel_codegen_execute_workspace(mut_view(eng_j8), false) {
        return 28;
    }
    let cgu0_q = parallel_codegen_get_cgu(view(eng_j8), 0u32);
    if eng_j8.quarantined_artifacts != 1u32 ||
        cgu0_q.fault_kind != FAULT_ARTIFACT_FAILURE ||
        cgu0_q.artifact_stage != ARTIFACT_STAGE_QUARANTINED ||
        eng_j8.link_barrier != BARRIER_BLOCKED_BY_ERROR {
        return 29;
    }
    parallel_codegen_inject_cgu_fault(mut_view(eng_j8), 0u32, false, false, false);
    print("fault_retry_quarantine_and_dup_verify_ok=true\n");

    // Multi-file error & warning `AXD-060` post-join diagnostic ordering under randomized worker delays (`AXS-PAR-023`, `AXS-PAR-052`)
    parallel_codegen_clear_diags(mut_view(eng_j1));
    parallel_codegen_clear_diags(mut_view(eng_j2));
    parallel_codegen_clear_diags(mut_view(eng_j4));
    parallel_codegen_clear_diags(mut_view(eng_j8));

    let pkg = probe_sv(mut_view(*str_arena), "app_pkg");
    let m_geom = probe_sv(mut_view(*str_arena), "geom");
    let m_phys = probe_sv(mut_view(*str_arena), "physics");
    let m_app = probe_sv(mut_view(*str_arena), "app");
    let m_util = probe_sv(mut_view(*str_arena), "util");
    let empty = qry_sv_empty();

    let sk_dot = semantic_key_new(pkg, m_geom, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "dot"), empty);
    let sk_kin = semantic_key_new(pkg, m_phys, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "kinetic_scale"), empty);
    let sk_main = semantic_key_new(pkg, m_app, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "main"), empty);
    let sk_clamp = semantic_key_new(pkg, m_util, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "clamp_energy"), empty);

    let msg_err_geom = probe_sv(mut_view(*str_arena), "expected i32, found bool in geom.dot");
    let msg_err_phys = probe_sv(mut_view(*str_arena), "expected bool, found i32 in physics.kinetic_scale");
    let msg_warn_app = probe_sv(mut_view(*str_arena), "redundant cast in app.main");
    let msg_err_util = probe_sv(mut_view(*str_arena), "type mismatch in util.clamp_energy");

    inc_set_item_error_flag(mut_view(eng_j1.cache.eng), DefId { v: 11u32 }, true);
    inc_set_item_error_flag(mut_view(eng_j1.cache.eng), DefId { v: 20u32 }, true);
    inc_set_item_error_flag(mut_view(eng_j1.cache.eng), DefId { v: 41u32 }, true);
    parallel_codegen_attach_diag(mut_view(eng_j1), true, SourceFileId { v: 1u32 }, 80u32, 3u32, 16u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 1u32 }, DefId { v: 11u32 }, sk_dot, msg_err_geom);
    parallel_codegen_attach_diag(mut_view(eng_j1), true, SourceFileId { v: 2u32 }, 96u32, 4u32, 12u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 2u32 }, DefId { v: 20u32 }, sk_kin, msg_err_phys);
    parallel_codegen_attach_diag(mut_view(eng_j1), true, SourceFileId { v: 3u32 }, 40u32, 2u32, 8u32, 2105u32, CACHED_DIAG_WARNING, ModuleId { v: 3u32 }, DefId { v: 30u32 }, sk_main, msg_warn_app);
    parallel_codegen_attach_diag(mut_view(eng_j1), true, SourceFileId { v: 4u32 }, 64u32, 3u32, 10u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 4u32 }, DefId { v: 41u32 }, sk_clamp, msg_err_util);

    inc_set_item_error_flag(mut_view(eng_j2.cache.eng), DefId { v: 11u32 }, true);
    inc_set_item_error_flag(mut_view(eng_j2.cache.eng), DefId { v: 20u32 }, true);
    inc_set_item_error_flag(mut_view(eng_j2.cache.eng), DefId { v: 41u32 }, true);
    parallel_codegen_attach_diag(mut_view(eng_j2), true, SourceFileId { v: 4u32 }, 64u32, 3u32, 10u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 4u32 }, DefId { v: 41u32 }, sk_clamp, msg_err_util);
    parallel_codegen_attach_diag(mut_view(eng_j2), true, SourceFileId { v: 3u32 }, 40u32, 2u32, 8u32, 2105u32, CACHED_DIAG_WARNING, ModuleId { v: 3u32 }, DefId { v: 30u32 }, sk_main, msg_warn_app);
    parallel_codegen_attach_diag(mut_view(eng_j2), true, SourceFileId { v: 2u32 }, 96u32, 4u32, 12u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 2u32 }, DefId { v: 20u32 }, sk_kin, msg_err_phys);
    parallel_codegen_attach_diag(mut_view(eng_j2), true, SourceFileId { v: 1u32 }, 80u32, 3u32, 16u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 1u32 }, DefId { v: 11u32 }, sk_dot, msg_err_geom);

    inc_set_item_error_flag(mut_view(eng_j4.cache.eng), DefId { v: 11u32 }, true);
    inc_set_item_error_flag(mut_view(eng_j4.cache.eng), DefId { v: 20u32 }, true);
    inc_set_item_error_flag(mut_view(eng_j4.cache.eng), DefId { v: 41u32 }, true);
    parallel_codegen_attach_diag(mut_view(eng_j4), true, SourceFileId { v: 2u32 }, 96u32, 4u32, 12u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 2u32 }, DefId { v: 20u32 }, sk_kin, msg_err_phys);
    parallel_codegen_attach_diag(mut_view(eng_j4), true, SourceFileId { v: 4u32 }, 64u32, 3u32, 10u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 4u32 }, DefId { v: 41u32 }, sk_clamp, msg_err_util);
    parallel_codegen_attach_diag(mut_view(eng_j4), true, SourceFileId { v: 1u32 }, 80u32, 3u32, 16u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 1u32 }, DefId { v: 11u32 }, sk_dot, msg_err_geom);
    parallel_codegen_attach_diag(mut_view(eng_j4), true, SourceFileId { v: 3u32 }, 40u32, 2u32, 8u32, 2105u32, CACHED_DIAG_WARNING, ModuleId { v: 3u32 }, DefId { v: 30u32 }, sk_main, msg_warn_app);

    inc_set_item_error_flag(mut_view(eng_j8.cache.eng), DefId { v: 11u32 }, true);
    inc_set_item_error_flag(mut_view(eng_j8.cache.eng), DefId { v: 20u32 }, true);
    inc_set_item_error_flag(mut_view(eng_j8.cache.eng), DefId { v: 41u32 }, true);
    // Include duplicate diamond-import diagnostics on `eng_j8` to verify post-join deduplication (`AXS-PAR-023 §2`)
    parallel_codegen_attach_diag(mut_view(eng_j8), true, SourceFileId { v: 3u32 }, 40u32, 2u32, 8u32, 2105u32, CACHED_DIAG_WARNING, ModuleId { v: 3u32 }, DefId { v: 30u32 }, sk_main, msg_warn_app);
    parallel_codegen_attach_diag(mut_view(eng_j8), true, SourceFileId { v: 4u32 }, 64u32, 3u32, 10u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 4u32 }, DefId { v: 41u32 }, sk_clamp, msg_err_util);
    parallel_codegen_attach_diag(mut_view(eng_j8), true, SourceFileId { v: 2u32 }, 96u32, 4u32, 12u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 2u32 }, DefId { v: 20u32 }, sk_kin, msg_err_phys);
    parallel_codegen_attach_diag(mut_view(eng_j8), true, SourceFileId { v: 1u32 }, 80u32, 3u32, 16u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 1u32 }, DefId { v: 11u32 }, sk_dot, msg_err_geom);
    parallel_codegen_attach_diag(mut_view(eng_j8), true, SourceFileId { v: 4u32 }, 64u32, 3u32, 10u32, DIAG_AX_TYP_MISMATCH, CACHED_DIAG_ERROR, ModuleId { v: 4u32 }, DefId { v: 41u32 }, sk_clamp, msg_err_util);

    configure_delay_schedule(mut_view(eng_j2), 1u32);
    configure_delay_schedule(mut_view(eng_j4), 2u32);
    configure_delay_schedule(mut_view(eng_j8), 3u32);

    let ok1 = parallel_codegen_execute_workspace(mut_view(eng_j1), false);
    let ok2 = parallel_codegen_execute_workspace(mut_view(eng_j2), false);
    let ok4 = parallel_codegen_execute_workspace(mut_view(eng_j4), false);
    let ok8 = parallel_codegen_execute_workspace(mut_view(eng_j8), false);

    if ok1 || ok2 || ok4 || ok8 ||
        eng_j1.link_barrier != BARRIER_BLOCKED_BY_ERROR ||
        eng_j2.link_barrier != BARRIER_BLOCKED_BY_ERROR ||
        eng_j4.link_barrier != BARRIER_BLOCKED_BY_ERROR ||
        eng_j8.link_barrier != BARRIER_BLOCKED_BY_ERROR ||
        !fingerprint128_eq(eng_j1.merged_diag_fp, eng_j2.merged_diag_fp) ||
        !fingerprint128_eq(eng_j2.merged_diag_fp, eng_j4.merged_diag_fp) ||
        !fingerprint128_eq(eng_j4.merged_diag_fp, eng_j8.merged_diag_fp) {
        return 30;
    }

    let mut d1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut d2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut d4 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut d8 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(d1));
    diag_buf_init(mut_view(d2));
    diag_buf_init(mut_view(d4));
    diag_buf_init(mut_view(d8));

    parallel_codegen_emit_diagnostics(view(eng_j1), mut_view(d1));
    parallel_codegen_emit_diagnostics(view(eng_j2), mut_view(d2));
    parallel_codegen_emit_diagnostics(view(eng_j4), mut_view(d4));
    parallel_codegen_emit_diagnostics(view(eng_j8), mut_view(d8));

    let same_neg_diags = d1.len > 64 &&
        diag_buf_eq(view(d1), view(d2)) &&
        diag_buf_eq(view(d2), view(d4)) &&
        diag_buf_eq(view(d4), view(d8));

    diag_buf_free(mut_view(d1));
    diag_buf_free(mut_view(d2));
    diag_buf_free(mut_view(d4));
    diag_buf_free(mut_view(d8));
    parallel_codegen_free(mut_view(eng_j1));
    parallel_codegen_free(mut_view(eng_j2));
    parallel_codegen_free(mut_view(eng_j4));
    parallel_codegen_free(mut_view(eng_j8));

    if !same_neg_diags {
        return 31;
    }

    print("randomized_delay_multifile_diag_ordering_ok=true\n");
    0
}

fn read_optional_cache_dir_arg(str_arena: mut_view<Arena>) -> StrView {
    let argc = args_count();
    if argc < 2 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let buf = arena_alloc_raw(mut_view(*str_arena), 512, 1);
    let alen = unsafe { arg(1, buf, 511) };
    if alen <= 12i64 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let is_prefix = unsafe {
        (*buf) == 45u8 &&
        (*(buf + 1)) == 45u8 &&
        (*(buf + 2)) == 99u8 &&
        (*(buf + 3)) == 97u8 &&
        (*(buf + 4)) == 99u8 &&
        (*(buf + 5)) == 104u8 &&
        (*(buf + 6)) == 101u8 &&
        (*(buf + 7)) == 45u8 &&
        (*(buf + 8)) == 100u8 &&
        (*(buf + 9)) == 105u8 &&
        (*(buf + 10)) == 114u8 &&
        (*(buf + 11)) == 61u8
    };
    if !is_prefix {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    unsafe { *(buf + (alen as usize)) = 0u8; }
    StrView { ptr: unsafe { (buf + 12) as *const u8 }, len: (alen as usize) - 12 }
}

pub fn main() -> i32 {
    let mut str_arena = arena_new();
    let disk_dir = read_optional_cache_dir_arg(mut_view(str_arena));

    let rc_sched = run_scheduler_conformance(mut_view(str_arena));
    if rc_sched != 0 {
        arena_destroy(mut_view(str_arena));
        return rc_sched;
    }

    let rc_cgu = run_codegen_conformance(mut_view(str_arena), disk_dir);
    if rc_cgu != 0 {
        arena_destroy(mut_view(str_arena));
        return rc_cgu;
    }

    print("E18-3-PARALLEL-COMPILATION-CONFORMANCE-PASS\n");
    arena_destroy(mut_view(str_arena));
    0
}
