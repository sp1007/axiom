// test: run
// modes: interp native
// stdout-file: randomized_delay_multifile_diag_and_cycles.stdout
// SPEC-23 AXS-PAR-010, AXS-PAR-011, AXS-PAR-023, AXS-PAR-052, INV-PAR-003:
// Conformance test verifying:
// 1. Multi-file error and warning `AXD-060` post-join diagnostic ordering and deduplication
//    (`has_primary_span`, `FileId`, `byte_offset`, `line`, `col`, `code`, `SemanticKey`)
//    across 4 distinct randomized worker completion delay schedules under `--jobs 1`,
//    `--jobs 2`, `--jobs 4`, and `--jobs 8`.
// 2. `SingleFlightLatch` in-flight query deduplication (`AXS-PAR-010`) where 1 worker
//    computes and N-1 concurrent requesters join on the same latch.
// 3. 2-worker and 3-worker `WaitForGraph` cross-worker cycle detection and rotation to
//    the lexicographical minimum `(QueryKind, SemanticKey)` (`AXS-PAR-011`).

@derive(Copy)
struct MultiFileDiag {
    has_primary_span: bool,
    file_id: u32,
    byte_offset: u32,
    line: u32,
    col: u32,
    code: u32,
    semantic_key: u64,
    is_error: bool,
}

fn diag_less(a: MultiFileDiag, b: MultiFileDiag) -> bool {
    if a.has_primary_span != b.has_primary_span {
        return a.has_primary_span;
    }
    if a.file_id != b.file_id {
        return (a.file_id) < (b.file_id);
    }
    if a.byte_offset != b.byte_offset {
        return (a.byte_offset) < (b.byte_offset);
    }
    if a.line != b.line {
        return (a.line) < (b.line);
    }
    if a.col != b.col {
        return (a.col) < (b.col);
    }
    if a.code != b.code {
        return (a.code) < (b.code);
    }
    (a.semantic_key) < (b.semantic_key)
}

fn diag_eq(a: MultiFileDiag, b: MultiFileDiag) -> bool {
    a.has_primary_span == b.has_primary_span &&
        a.file_id == b.file_id &&
        a.byte_offset == b.byte_offset &&
        a.line == b.line &&
        a.col == b.col &&
        a.code == b.code &&
        a.semantic_key == b.semantic_key &&
        a.is_error == b.is_error
}

fn mix64(seed: u64, val: u64) -> u64 {
    let mut x: u64 = seed ^ (val << 13u64) ^ (seed >> 7u64) ^ 0x9E3779B97F4A7C15u64;
    x = x ^ (x >> 17u64) ^ (val >> 3u64);
    x ^ (x << 5u64)
}

@derive(Copy)
struct DiagMergeResult {
    digest: u64,
    unique_count: u32,
    error_count: u32,
    warning_count: u32,
    first_file_id: u32,
    last_has_span: bool,
}

fn run_multifile_diag_schedule(schedule_id: u32) -> DiagMergeResult {
    let d1 = MultiFileDiag { has_primary_span: true, file_id: 1u32, byte_offset: 12u32, line: 2u32, col: 4u32, code: 2001u32, semantic_key: 101u64, is_error: true };
    let d2 = MultiFileDiag { has_primary_span: true, file_id: 1u32, byte_offset: 64u32, line: 8u32, col: 1u32, code: 4001u32, semantic_key: 102u64, is_error: false };
    let d3 = MultiFileDiag { has_primary_span: true, file_id: 2u32, byte_offset: 8u32, line: 1u32, col: 9u32, code: 2005u32, semantic_key: 201u64, is_error: true };
    let d4 = MultiFileDiag { has_primary_span: true, file_id: 3u32, byte_offset: 24u32, line: 4u32, col: 2u32, code: 4002u32, semantic_key: 301u64, is_error: false };
    let d5 = MultiFileDiag { has_primary_span: false, file_id: 0u32, byte_offset: 0u32, line: 0u32, col: 0u32, code: 5001u32, semantic_key: 901u64, is_error: false };
    // Duplicate of `d3` emitted along a second diamond import edge
    let d3_dup = d3;

    // 4 randomized worker completion delay schedules across `--jobs 1`, `--jobs 2`, `--jobs 4`, `--jobs 8`
    let mut buf: [6]MultiFileDiag = if schedule_id == 0u32 {
        [d1, d2, d3, d4, d5, d3_dup]
    } else if schedule_id == 1u32 {
        // Worker on file 3 and spanless global warning finish 50 ms before file 1
        [d5, d4, d3_dup, d2, d1, d3]
    } else if schedule_id == 2u32 {
        // Interleaved completion under `--jobs 4`
        [d3, d5, d1, d4, d3_dup, d2]
    } else {
        // Reverse-skewed completion under `--jobs 8`
        [d4, d3, d2, d5, d1, d3_dup]
    };

    // Canonical post-join `AXD-060` sort
    let mut a: usize = 1;
    while a < 6 {
        let cur = buf[a];
        let mut b: usize = a;
        while b > 0 {
            if !diag_less(cur, buf[b - 1]) {
                break;
            }
            buf[b] = buf[b - 1];
            b = b - 1;
        }
        buf[b] = cur;
        a = a + 1;
    }

    let mut digest: u64 = 0x4158445F30363000u64;
    let mut unique_count: u32 = 0u32;
    let mut error_count: u32 = 0u32;
    let mut warning_count: u32 = 0u32;
    let mut last_has_span = true;

    let mut i: usize = 0;
    while i < 6 {
        let cur = buf[i];
        let is_dup = if i > 0 { diag_eq(cur, buf[i - 1]) } else { false };
        if !is_dup {
            let word = ((cur.file_id as u64) << 48u64) |
                ((cur.byte_offset as u64) << 32u64) |
                ((cur.code as u64) << 16u64) |
                (cur.line as u64);
            digest = mix64(digest, word ^ cur.semantic_key);
            unique_count = unique_count + 1u32;
            if cur.is_error {
                error_count = error_count + 1u32;
            } else {
                warning_count = warning_count + 1u32;
            }
            last_has_span = cur.has_primary_span;
        }
        i = i + 1;
    }

    DiagMergeResult {
        digest: digest,
        unique_count: unique_count,
        error_count: error_count,
        warning_count: warning_count,
        first_file_id: buf[0].file_id,
        last_has_span: last_has_span,
    }
}

@derive(Copy)
struct CycleNode {
    query_kind: u32,
    semantic_key: u64,
}

fn cycle_less(a: CycleNode, b: CycleNode) -> bool {
    if a.query_kind != b.query_kind {
        return (a.query_kind) < (b.query_kind);
    }
    (a.semantic_key) < (b.semantic_key)
}

fn rotate_cycle_3(n0: CycleNode, n1: CycleNode, n2: CycleNode) -> u64 {
    let raw: [3]CycleNode = [n0, n1, n2];
    let mut min_idx: usize = 0;
    if cycle_less(raw[1], raw[min_idx]) {
        min_idx = 1;
    }
    if cycle_less(raw[2], raw[min_idx]) {
        min_idx = 2;
    }
    let mut acc: u64 = 0x4359434C455F524Fu64;
    let mut k: usize = 0;
    while k < 3 {
        let idx = (min_idx + k) % 3;
        let node = raw[idx];
        acc = mix64(acc, ((node.query_kind as u64) << 48u64) ^ node.semantic_key);
        k = k + 1;
    }
    acc
}

fn verify_single_flight_and_wait_for_cycles() -> bool {
    // 1. Single-flight latch (`AXS-PAR-010`): 4 workers request `(query_kind=5, key=0xBEEF)`
    let mut latch_owner: u32 = 0u32;
    let mut computed_count: u32 = 0u32;
    let mut waiter_joins: u32 = 0u32;
    let workers: [4]u32 = [3u32, 1u32, 4u32, 2u32];
    let mut w: usize = 0;
    while w < 4 {
        if latch_owner == 0u32 {
            latch_owner = workers[w];
            computed_count = computed_count + 1u32;
        } else {
            waiter_joins = waiter_joins + 1u32;
        }
        w = w + 1;
    }
    if computed_count != 1u32 || waiter_joins != 3u32 {
        return false;
    }

    // 2. 3-worker cycle rotation (`AXS-PAR-011`):
    //    `A = (5, 100) -> B = (5, 200) -> C = (6, 50) -> A`
    let na = CycleNode { query_kind: 5u32, semantic_key: 100u64 };
    let nb = CycleNode { query_kind: 5u32, semantic_key: 200u64 };
    let nc = CycleNode { query_kind: 6u32, semantic_key: 50u64 };

    // Regardless of which worker detects the back-edge first (`A->B->C`, `B->C->A`, or `C->A->B`),
    // rotation to the lexicographical minimum `(5, 100)` yields the exact same cycle digest!
    let d_abc = rotate_cycle_3(na, nb, nc);
    let d_bca = rotate_cycle_3(nb, nc, na);
    let d_cab = rotate_cycle_3(nc, na, nb);
    d_abc == d_bca && d_bca == d_cab
}

pub fn main() -> i32 {
    let r0 = run_multifile_diag_schedule(0u32);
    let r1 = run_multifile_diag_schedule(1u32);
    let r2 = run_multifile_diag_schedule(2u32);
    let r3 = run_multifile_diag_schedule(3u32);

    if r0.unique_count != 5u32 || r0.error_count != 2u32 || r0.warning_count != 3u32 {
        return 1;
    }
    // Primary-span diagnostics must precede spanless diagnostics, and file 1 must come first
    if r0.first_file_id != 1u32 || r0.last_has_span {
        return 2;
    }
    if r0.digest != r1.digest || r1.digest != r2.digest || r2.digest != r3.digest {
        return 3;
    }
    print("randomized_delay_multifile_diag_ordering_ok=true\n");

    if !verify_single_flight_and_wait_for_cycles() {
        return 4;
    }
    print("single_flight_and_cross_worker_cycle_rotation_ok=true\n");
    print("RANDOMIZED-DELAY-MULTIFILE-DIAG-AND-CYCLES-CONFORMANCE-OK\n");
    0
}
