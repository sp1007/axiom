// test: diff
// flags: --verify-each
// stdout: Xin chào thế giới\nEXPORT_CHECKSUM=54321\nEXPORT_AFFINE=100\nEXPORT_VEC_DOT=39\nEXPORT_IMPL_CONSTS=40\nEXPORT_MOD_CONSTS=4176\nDROP=20\nDROP=10\nEXPORT_TOTAL=58676\n

// E18.7 Conformance (SPEC-26 AXS-WLIB-004, AXS-WLIB-021, REQ-OWNER-006):
// `@export` and `@export("custom_name")` on module functions, inherent `impl` methods,
// associated `impl` constants, and module-level constants (scalars, arrays, `Str`),
// combined with private / `pub` non-exported helpers and deterministic LIFO `Drop`.

module export_visibility_and_abi_layout

struct ExportDropGuard {
    pub id: i64,
}

impl Drop for ExportDropGuard {
    fn drop(self: mut_view<ExportDropGuard>) {
        print("DROP=");
        print_int(self.id);
        print("\n");
    }
}

@export
pub const EXPORT_GREETING: Str = "Xin chào thế giới\n";

@export
pub const EXPORT_MAGIC: i64 = 4096;

@export("EXPORT_WEIGHT_TABLE")
pub const INTERNAL_WEIGHTS: [4]i64 = [5, 15, 25, 35];

fn private_bias() -> i64 {
    16
}

pub fn pub_unexported_scale(x: i64) -> i64 {
    x * 7
}

@export
pub fn exported_checksum(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    a + b * 10 + c * 100 + d * 1000 + e * 10000
}

@export("custom_affine_step")
pub fn internal_affine(x: i64, k: i64) -> i64 {
    pub_unexported_scale(x) + private_bias() + k
}

pub struct ExportVec2 {
    pub x: i64,
    pub y: i64,
}

impl ExportVec2 {
    @export("IMPL_SCALE_CONST")
    pub const SCALE: i64 = 15;

    @export
    pub const BASE_OFFSET: i64 = 25;

    @export("vec2_dot_export")
    pub fn dot(ax: i64, ay: i64, bx: i64, by: i64) -> i64 {
        ax * bx + ay * by
    }
}

pub fn main() -> i32 {
    print(EXPORT_GREETING);

    let csum: i64 = exported_checksum(1, 2, 3, 4, 5);
    let aff: i64 = internal_affine(12, 0);
    let vdot: i64 = ExportVec2.dot(3, 4, 5, 6);
    let iconsts: i64 = ExportVec2.SCALE + ExportVec2.BASE_OFFSET;
    let mconsts: i64 = EXPORT_MAGIC +
        INTERNAL_WEIGHTS[0] +
        INTERNAL_WEIGHTS[1] +
        INTERNAL_WEIGHTS[2] +
        INTERNAL_WEIGHTS[3];

    {
        let _g1 = ExportDropGuard { id: 10 };
        let _g2 = ExportDropGuard { id: 20 };
        print("EXPORT_CHECKSUM=");
        print_int(csum);
        print("\nEXPORT_AFFINE=");
        print_int(aff);
        print("\nEXPORT_VEC_DOT=");
        print_int(vdot);
        print("\nEXPORT_IMPL_CONSTS=");
        print_int(iconsts);
        print("\nEXPORT_MOD_CONSTS=");
        print_int(mconsts);
        print("\n");
    }

    let total: i64 = csum + aff + vdot + iconsts + mconsts;
    print("EXPORT_TOTAL=");
    print_int(total);
    print("\n");

    if total == 58676 {
        0
    } else {
        1
    }
}
