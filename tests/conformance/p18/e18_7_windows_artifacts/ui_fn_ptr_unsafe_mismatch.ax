// test: ui

// E18.7 Conformance (REQ-LNK-121, 0189 §28):
// Function pointer types with distinct safety/ABI qualifiers or incompatible signatures
// do not unify with unrelated types.

module ui_fn_ptr_unsafe_mismatch

extern "C" fn c_target(x: i32) -> i32 {
    x + 1
}

pub fn main() -> i32 {
    let fp: extern "C" fn(i32) -> i32 = c_target;
    let bad: extern "C" fn(i32, i32) -> i32 = fp; //~ ERROR AX_TYPE_MISMATCH
    let _ = bad;
    0
}
