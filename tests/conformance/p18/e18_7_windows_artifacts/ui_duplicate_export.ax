// test: ui

// E18.7 Conformance (SPEC-26 AXS-WLIB-004, AXS-WLIB-050, AXS-WLIB-052):
// Two `@export` items in the same module resolving to the identical external export symbol
// name are rejected with `AX_LINK_DUPLICATE_EXPORT`.

module ui_duplicate_export

@export("win_artifact_dup_sym")
pub fn export_first(x: i64) -> i64 {
    x + 1
}

@export("win_artifact_dup_sym") //~ ERROR AX_LINK_DUPLICATE_EXPORT
pub fn export_second(x: i64) -> i64 {
    x + 2
}

pub fn main() -> i32 {
    0
}
