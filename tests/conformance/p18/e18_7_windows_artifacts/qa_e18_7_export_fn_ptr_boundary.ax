// test: diff
// flags: --verify-each
// stdout: QA_BOUNDARY_GREETING=Xin chào biên giới E18.7\nQA_FP8_SAFE=2040\nQA_FP8_UNSAFE=336\nQA_HOF_6=490\nQA_IMPL_DISAMBIG=1337\nQA_DROP=2\nQA_DROP=1\nQA_BOUNDARY_TOTAL=4203\n

// E18.7 QA Boundary Conformance (SPEC-26 AXS-WLIB-004, AXS-WLIB-021, REQ-LNK-121):
// 1. 8-argument indirect function pointer calls (4 register params + 4 Win64 stack slots
//    above the 32-byte shadow space) for both safe `fn` and `unsafe fn`.
// 2. Higher-order function pointer returning a 6-argument function pointer.
// 3. Cross-`impl` `@export` and `@export("custom")` disambiguation on identically named
//    associated constants (`K`) and methods (`compute`) across distinct types, combined
//    with deterministic LIFO `Drop`.

module qa_e18_7_export_fn_ptr_boundary

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct BoundaryDrop {
    pub tag: i64,
}

impl Drop for BoundaryDrop {
    fn drop(self: mut_view<BoundaryDrop>) {
        print("QA_DROP=");
        print_int(self.tag);
        print("\n");
    }
}

fn weighted_sum_8(
    a1: i64, a2: i64, a3: i64, a4: i64,
    a5: i64, a6: i64, a7: i64, a8: i64
) -> i64 {
    a1 * 1 + a2 * 2 + a3 * 3 + a4 * 4 + a5 * 5 + a6 * 6 + a7 * 7 + a8 * 8
}

unsafe fn ptr_stride_8(
    base: *const i64,
    s1: i64, s2: i64, s3: i64,
    s4: i64, s5: i64, s6: i64, s7: i64
) -> i64 {
    (*base) * s1 + s2 * 2 + s3 * 3 + s4 * 4 + s5 * 5 + s6 * 6 + s7 * 7
}

fn hof_branch_hi(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    (a + b + c) * 10 + (d + e + f) * 10
}

fn hof_branch_lo(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    (a + b + c) + (d + e + f)
}

fn select_6arg_fp(hi: bool) -> fn(i64, i64, i64, i64, i64, i64) -> i64 {
    if hi { hof_branch_hi } else { hof_branch_lo }
}

pub struct AlphaExport {
    pub v: i64,
}

impl AlphaExport {
    @export("QA_ALPHA_CONST_K")
    pub const K: i64 = 300;

    @export("qa_alpha_compute_sym")
    pub fn compute(x: i64, y: i64) -> i64 {
        x * 10 + y + AlphaExport.K
    }
}

pub struct BetaExport {
    pub v: i64,
}

impl BetaExport {
    @export
    pub const K: i64 = 700;

    @export
    pub fn compute(x: i64, y: i64) -> i64 {
        x * 20 + y + BetaExport.K
    }
}

pub fn main() -> i32 {
    print("QA_BOUNDARY_GREETING=Xin chào biên giới E18.7\n");

    let fp8: fn(i64, i64, i64, i64, i64, i64, i64, i64) -> i64 = weighted_sum_8;
    // 10*1 + 20*2 + 30*3 + 40*4 + 50*5 + 60*6 + 70*7 + 80*8 = 2040
    let v_fp8: i64 = fp8(10, 20, 30, 40, 50, 60, 70, 80);

    let anchor: i64 = 25;
    let v_ufp8: i64 = unsafe {
        let p: *const i64 = address_of(anchor);
        let ufp: unsafe fn(*const i64, i64, i64, i64, i64, i64, i64, i64) -> i64 = ptr_stride_8;
        // 25*4 + 2*2 + 4*3 + 6*4 + 8*5 + 10*6 + 14*7 = 100 + 4 + 12 + 24 + 40 + 60 + 98 = 338 - 2 = 336
        ufp(p, 4, 1, 4, 6, 8, 10, 14)
    };

    let selector: fn(bool) -> fn(i64, i64, i64, i64, i64, i64) -> i64 = select_6arg_fp;
    let chosen_hi = selector(true);
    let chosen_lo = selector(false);
    // hi: (1+2+3)*10 + (4+5+6)*10 = 210; lo: (10+20+30) + (40+80+100) = 280; sum = 490
    let v_hof: i64 = chosen_hi(1, 2, 3, 4, 5, 6) + chosen_lo(10, 20, 30, 40, 80, 100);

    // AlphaExport.compute(11, 7) = 110 + 7 + 300 = 417
    // BetaExport.compute(10, 20) = 200 + 20 + 700 = 920
    // sum = 1337
    let v_impl: i64 = AlphaExport.compute(11, 7) + BetaExport.compute(10, 20);

    {
        let _d1 = BoundaryDrop { tag: 1 };
        let _d2 = BoundaryDrop { tag: 2 };
        print("QA_FP8_SAFE=");
        print_int(v_fp8);
        print("\nQA_FP8_UNSAFE=");
        print_int(v_ufp8);
        print("\nQA_HOF_6=");
        print_int(v_hof);
        print("\nQA_IMPL_DISAMBIG=");
        print_int(v_impl);
        print("\n");
    }

    let total: i64 = v_fp8 + v_ufp8 + v_hof + v_impl;
    print("QA_BOUNDARY_TOTAL=");
    print_int(total);
    print("\n");

    if total == 4203 {
        0
    } else {
        1
    }
}
