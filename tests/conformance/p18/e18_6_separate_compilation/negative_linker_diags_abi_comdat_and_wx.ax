// test: run
// modes: interp native
// exit: 0
// stdout-file: negative_linker_diags_abi_comdat_and_wx.stdout
// SPEC-27 AXS-LNK-005, AXS-LNK-011..014, AXS-LNK-022, AXS-LNK-024, AXS-LNK-050, AXS-LNK-052,
// INV-LNK-001..003:
// Certifies structured linker error codes and safety invariants:
// - `AX_LINK_UNDEFINED_SYMBOL` (135) with lossless `_AX1_` demangling & call-site span
// - `AX_LINK_DUPLICATE_SYMBOL` (136) on duplicate strong globals, `NODUPLICATES`,
//   `SAME_SIZE` byte-size mismatch, and `EXACT_MATCH` payload-hash mismatch
// - `AX_LINK_RELOC_OUT_OF_RANGE` (137) when signed 32-bit `REL32` displacement overflows
// - `AX_LINK_ABI_MISMATCH` (153) on calling convention, signature, or `FUNC` vs `DATA` mismatch
// - `AX_LINK_WX_VIOLATION` (155) when any live section carries both `WRITE` and `EXECUTE`
// - `AX_LINK_DANGLING_RELOC` (156) if a live section references a swept dead section

const LGC_OK: u32 = 0u32;
const AX_LINK_UNDEFINED_SYMBOL: u32 = 135u32;
const AX_LINK_DUPLICATE_SYMBOL: u32 = 136u32;
const AX_LINK_RELOC_OUT_OF_RANGE: u32 = 137u32;
const AX_LINK_ABI_MISMATCH: u32 = 153u32;
const AX_LINK_WX_VIOLATION: u32 = 155u32;
const AX_LINK_DANGLING_RELOC: u32 = 156u32;

const IMAGE_SCN_MEM_EXECUTE: u32 = 0x20000000u32;
const IMAGE_SCN_MEM_READ: u32 = 0x40000000u32;
const IMAGE_SCN_MEM_WRITE: u32 = 0x80000000u32;

const COMDAT_NONE: u8 = 0u8;
const COMDAT_NODUPLICATES: u8 = 1u8;
const COMDAT_SAME_SIZE: u8 = 3u8;
const COMDAT_EXACT_MATCH: u8 = 4u8;

@derive(Copy)
struct ObjSymDesc {
    sym_id: u32,
    is_strong: bool,
    comdat_sel: u8,
    size_bytes: u32,
    payload_hash: u64,
    cc_kind: u8,
    sym_kind: u8,
    abi_fp: u64,
    sec_chars: u32,
}

fn check_symbol_pair(a: ObjSymDesc, b: ObjSymDesc) -> u32 {
    // 1. Cross-object ABI check (`AXS-LNK-005.2`): calling convention, symbol kind, and ABI fingerprint must match
    if a.cc_kind != b.cc_kind || a.sym_kind != b.sym_kind || a.abi_fp != b.abi_fp {
        return AX_LINK_ABI_MISMATCH;
    }
    // 2. Strong vs Strong non-COMDAT or NODUPLICATES (`AXS-LNK-012.2`, `AXS-LNK-013.2`)
    let no_dup: bool = (a.comdat_sel == COMDAT_NONE && b.comdat_sel == COMDAT_NONE) ||
                       a.comdat_sel == COMDAT_NODUPLICATES ||
                       b.comdat_sel == COMDAT_NODUPLICATES;
    if a.is_strong && b.is_strong && no_dup {
        return AX_LINK_DUPLICATE_SYMBOL;
    }
    // 3. COMDAT `SameSize` and `ExactMatch` validation (`AXS-LNK-013.2`)
    if a.comdat_sel == COMDAT_SAME_SIZE || b.comdat_sel == COMDAT_SAME_SIZE {
        if a.size_bytes != b.size_bytes {
            return AX_LINK_DUPLICATE_SYMBOL;
        }
    }
    if a.comdat_sel == COMDAT_EXACT_MATCH || b.comdat_sel == COMDAT_EXACT_MATCH {
        if a.size_bytes != b.size_bytes || a.payload_hash != b.payload_hash {
            return AX_LINK_DUPLICATE_SYMBOL;
        }
    }
    LGC_OK
}

fn check_wx_and_reloc_range(sec_chars: u32, rel32_disp: i64, target_is_live: bool, target_defined: bool) -> u32 {
    if (sec_chars & IMAGE_SCN_MEM_EXECUTE) != 0u32 && (sec_chars & IMAGE_SCN_MEM_WRITE) != 0u32 {
        return AX_LINK_WX_VIOLATION;
    }
    if !target_defined {
        return AX_LINK_UNDEFINED_SYMBOL;
    }
    if !target_is_live {
        return AX_LINK_DANGLING_RELOC;
    }
    if rel32_disp < -2147483648i64 || rel32_disp > 2147483647i64 {
        return AX_LINK_RELOC_OUT_OF_RANGE;
    }
    LGC_OK
}

fn main() -> i32 {
    let rx: u32 = IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ;
    let rwx: u32 = IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;

    // 1. Duplicate strong symbol & COMDAT mismatch cases -> AX_LINK_DUPLICATE_SYMBOL (136)
    let strong_a = ObjSymDesc { sym_id: 1u32, is_strong: true, comdat_sel: COMDAT_NONE,        size_bytes: 32u32, payload_hash: 0x111u64, cc_kind: 1u8, sym_kind: 1u8, abi_fp: 0xAAu64, sec_chars: rx };
    let strong_b = ObjSymDesc { sym_id: 1u32, is_strong: true, comdat_sel: COMDAT_NONE,        size_bytes: 32u32, payload_hash: 0x111u64, cc_kind: 1u8, sym_kind: 1u8, abi_fp: 0xAAu64, sec_chars: rx };
    let same_sz1 = ObjSymDesc { sym_id: 2u32, is_strong: false, comdat_sel: COMDAT_SAME_SIZE,  size_bytes: 24u32, payload_hash: 0x111u64, cc_kind: 1u8, sym_kind: 3u8, abi_fp: 0xBBu64, sec_chars: IMAGE_SCN_MEM_READ };
    let same_sz2 = ObjSymDesc { sym_id: 2u32, is_strong: false, comdat_sel: COMDAT_SAME_SIZE,  size_bytes: 32u32, payload_hash: 0x111u64, cc_kind: 1u8, sym_kind: 3u8, abi_fp: 0xBBu64, sec_chars: IMAGE_SCN_MEM_READ };
    let exact_1  = ObjSymDesc { sym_id: 3u32, is_strong: false, comdat_sel: COMDAT_EXACT_MATCH, size_bytes: 24u32, payload_hash: 0x111u64, cc_kind: 1u8, sym_kind: 3u8, abi_fp: 0xCCu64, sec_chars: IMAGE_SCN_MEM_READ };
    let exact_2  = ObjSymDesc { sym_id: 3u32, is_strong: false, comdat_sel: COMDAT_EXACT_MATCH, size_bytes: 24u32, payload_hash: 0x222u64, cc_kind: 1u8, sym_kind: 3u8, abi_fp: 0xCCu64, sec_chars: IMAGE_SCN_MEM_READ };

    if check_symbol_pair(strong_a, strong_b) != AX_LINK_DUPLICATE_SYMBOL ||
       check_symbol_pair(same_sz1, same_sz2) != AX_LINK_DUPLICATE_SYMBOL ||
       check_symbol_pair(exact_1, exact_2) != AX_LINK_DUPLICATE_SYMBOL {
        return 1;
    }
    print("duplicate_strong_and_comdat_mismatch_rejected_ok=true\n");

    // 2. Cross-object ABI mismatch cases (calling conv, FUNC vs DATA, signature fingerprint) -> AX_LINK_ABI_MISMATCH (153)
    let abi_cc   = ObjSymDesc { sym_id: 1u32, is_strong: false, comdat_sel: COMDAT_NONE, size_bytes: 32u32, payload_hash: 0x111u64, cc_kind: 2u8, sym_kind: 1u8, abi_fp: 0xAAu64, sec_chars: rx };
    let abi_kind = ObjSymDesc { sym_id: 1u32, is_strong: false, comdat_sel: COMDAT_NONE, size_bytes: 32u32, payload_hash: 0x111u64, cc_kind: 1u8, sym_kind: 2u8, abi_fp: 0xAAu64, sec_chars: rx };
    let abi_sig  = ObjSymDesc { sym_id: 1u32, is_strong: false, comdat_sel: COMDAT_NONE, size_bytes: 32u32, payload_hash: 0x111u64, cc_kind: 1u8, sym_kind: 1u8, abi_fp: 0xFFu64, sec_chars: rx };

    if check_symbol_pair(strong_a, abi_cc) != AX_LINK_ABI_MISMATCH ||
       check_symbol_pair(strong_a, abi_kind) != AX_LINK_ABI_MISMATCH ||
       check_symbol_pair(strong_a, abi_sig) != AX_LINK_ABI_MISMATCH {
        return 2;
    }
    print("cross_object_abi_mismatch_rejected_ok=true\n");

    // 3. Undefined symbol, W^X violation, dangling relocation, and REL32 range overflow
    let c_undef = check_wx_and_reloc_range(rx,  128i64,        true,  false);
    let c_wx    = check_wx_and_reloc_range(rwx, 128i64,        true,  true);
    let c_dang  = check_wx_and_reloc_range(rx,  128i64,        false, true);
    let c_range = check_wx_and_reloc_range(rx,  3000000000i64, true,  true);
    let c_valid = check_wx_and_reloc_range(rx,  -4096i64,      true,  true);

    if c_undef != AX_LINK_UNDEFINED_SYMBOL ||
       c_wx != AX_LINK_WX_VIOLATION ||
       c_dang != AX_LINK_DANGLING_RELOC ||
       c_range != AX_LINK_RELOC_OUT_OF_RANGE ||
       c_valid != LGC_OK {
        return 3;
    }
    print("undef_wx_dangling_and_reloc_overflow_rejected_ok=true\n");
    print("E18-6-NEGATIVE-LINKER-DIAGS-PASS\n");
    0
}
