// test: run
// modes: interp native
// exit: 0
// stdout-file: comdat_generic_vtable_archive_and_section_gc.stdout
// SPEC-27 AXS-LNK-013, AXS-LNK-020..023, AXS-LNK-050..051, INV-LNK-002, INV-LNK-003:
// Certifies per-item section subdivision (`.text$<sym>`, `.rdata$<sym>`, `.data$<sym>`,
// `.bss$<sym>`, `.pdata$<sym>`, `.xdata$<sym>`), `IMAGE_SCN_LNK_COMDAT` generic & vtable
// deduplication (`Any`, `SameSize`, `ExactMatch`, `Largest`, `Associative`), root-attribute
// propagation from folded COMDAT copies, demand-driven `.lib` archive extraction, root-set
// mark-sweep section GC (`@entry`, `@export`, `@used`, `@at` pinned VMA, `ModuleInit`,
// `Reflection`), forward `.pdata`/`.xdata` unwind sweeping without reverse-rooting, and
// address-safe ICF (`address_taken` preservation).

const SEC_TEXT: i32 = 0;
const SEC_RDATA: i32 = 1;
const SEC_DATA: i32 = 2;
const SEC_BSS: i32 = 3;
const SEC_PDATA: i32 = 4;
const SEC_XDATA: i32 = 5;

const COMDAT_NONE: i32 = 0;
const COMDAT_ANY: i32 = 2;
const COMDAT_SAME_SIZE: i32 = 3;
const COMDAT_EXACT_MATCH: i32 = 4;
const COMDAT_ASSOCIATIVE: i32 = 5;
const COMDAT_LARGEST: i32 = 6;

const ROOT_NONE: i32 = 0;
const ROOT_ENTRY: i32 = 1;
const ROOT_EXPORT: i32 = 2;
const ROOT_USED: i32 = 3;
const ROOT_AT_PINNED: i32 = 4;
const ROOT_MODULE_INIT: i32 = 5;
const ROOT_REFLECTION: i32 = 6;

@derive(Copy)
struct GcSec {
    sec_id: i32,
    obj_id: i32,
    is_archive: bool,
    extracted: bool,
    kind: i32,
    sym_key: i32,
    comdat_sel: i32,
    assoc_leader: i32,
    root_kind: i32,
    reloc_a: i32,
    reloc_b: i32,
    size_bytes: i32,
    bytes_hash: i32,
    address_taken: bool,
    folded: bool,
    winner_sec: i32,
    live: bool,
}

fn main() -> i32 {
    let none: i32 = 99;
    // 16 sections across 2 explicit `.obj`s (`obj 0`, `obj 1`) and 2 `.lib` archive members
    // (`obj 2` needed, `obj 3` unreferenced broken member referencing missing symbol `999`).
    let mut secs: [16]GcSec = [
        // 0: main `.text$main` (Entry root) -> calls generic `clamp<i32>` (sec 3 in obj 1) & archive `io_print` (sec 12 in obj 2)
        GcSec { sec_id: 0,  obj_id: 0, is_archive: false, extracted: true,  kind: SEC_TEXT,  sym_key: 1,  comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_ENTRY,       reloc_a: 3,    reloc_b: 12,   size_bytes: 64,  bytes_hash: 101, address_taken: false, folded: false, winner_sec: 0,  live: false },
        // 1: `.pdata$main` (Associative to 0)
        GcSec { sec_id: 1,  obj_id: 0, is_archive: false, extracted: true,  kind: SEC_PDATA, sym_key: 0,  comdat_sel: COMDAT_ASSOCIATIVE, assoc_leader: 0,    root_kind: ROOT_NONE,        reloc_a: none, reloc_b: none, size_bytes: 12,  bytes_hash: 102, address_taken: false, folded: false, winner_sec: 1,  live: false },
        // 2: `.text$clamp_i32` in obj 0 (COMDAT_ANY leader, winner over sec 3) -> references vtable `vt_ord` (sec 5)
        GcSec { sec_id: 2,  obj_id: 0, is_archive: false, extracted: true,  kind: SEC_TEXT,  sym_key: 10, comdat_sel: COMDAT_ANY,         assoc_leader: none, root_kind: ROOT_NONE,        reloc_a: 5,    reloc_b: none, size_bytes: 48,  bytes_hash: 200, address_taken: false, folded: false, winner_sec: 2,  live: false },
        // 3: `.text$clamp_i32` in obj 1 (COMDAT_ANY duplicate with `@export` root -> folded into sec 2, propagating ROOT_EXPORT!)
        GcSec { sec_id: 3,  obj_id: 1, is_archive: false, extracted: true,  kind: SEC_TEXT,  sym_key: 10, comdat_sel: COMDAT_ANY,         assoc_leader: none, root_kind: ROOT_EXPORT,      reloc_a: 6,    reloc_b: none, size_bytes: 48,  bytes_hash: 200, address_taken: false, folded: false, winner_sec: 3,  live: false },
        // 4: `.xdata$clamp_i32` in obj 1 (Associative to folded sec 3 -> folded as associative COMDAT!)
        GcSec { sec_id: 4,  obj_id: 1, is_archive: false, extracted: true,  kind: SEC_XDATA, sym_key: 0,  comdat_sel: COMDAT_ASSOCIATIVE, assoc_leader: 3,    root_kind: ROOT_NONE,        reloc_a: none, reloc_b: none, size_bytes: 16,  bytes_hash: 201, address_taken: false, folded: false, winner_sec: 4,  live: false },
        // 5: `.rdata$vt_ord` in obj 0 (COMDAT_EXACT_MATCH leader)
        GcSec { sec_id: 5,  obj_id: 0, is_archive: false, extracted: true,  kind: SEC_RDATA, sym_key: 20, comdat_sel: COMDAT_EXACT_MATCH, assoc_leader: none, root_kind: ROOT_NONE,        reloc_a: none, reloc_b: none, size_bytes: 32,  bytes_hash: 300, address_taken: false, folded: false, winner_sec: 5,  live: false },
        // 6: `.rdata$vt_ord` in obj 1 (COMDAT_EXACT_MATCH duplicate -> folded into sec 5)
        GcSec { sec_id: 6,  obj_id: 1, is_archive: false, extracted: true,  kind: SEC_RDATA, sym_key: 20, comdat_sel: COMDAT_EXACT_MATCH, assoc_leader: none, root_kind: ROOT_NONE,        reloc_a: none, reloc_b: none, size_bytes: 32,  bytes_hash: 300, address_taken: false, folded: false, winner_sec: 6,  live: false },
        // 7: `.rdata$build_cookie` (`@used` root)
        GcSec { sec_id: 7,  obj_id: 0, is_archive: false, extracted: true,  kind: SEC_RDATA, sym_key: 30, comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_USED,        reloc_a: none, reloc_b: none, size_bytes: 24,  bytes_hash: 400, address_taken: false, folded: false, winner_sec: 7,  live: false },
        // 8: `.data$mmio_reg` (`@at` pinned VMA root)
        GcSec { sec_id: 8,  obj_id: 0, is_archive: false, extracted: true,  kind: SEC_DATA,  sym_key: 31, comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_AT_PINNED,   reloc_a: none, reloc_b: none, size_bytes: 8,   bytes_hash: 401, address_taken: true,  folded: false, winner_sec: 8,  live: false },
        // 9: `.text$mod_init` (`ModuleInit` root) -> references `.rdata$refl_meta` (sec 10)
        GcSec { sec_id: 9,  obj_id: 1, is_archive: false, extracted: true,  kind: SEC_TEXT,  sym_key: 32, comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_MODULE_INIT, reloc_a: none, reloc_b: none, size_bytes: 32,  bytes_hash: 402, address_taken: false, folded: false, winner_sec: 9,  live: false },
        // 10: `.rdata$refl_meta` (`Reflection` root)
        GcSec { sec_id: 10, obj_id: 1, is_archive: false, extracted: true,  kind: SEC_RDATA, sym_key: 33, comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_REFLECTION,  reloc_a: none, reloc_b: none, size_bytes: 40,  bytes_hash: 403, address_taken: false, folded: false, winner_sec: 10, live: false },
        // 11: `.text$dead_helper` in obj 1 (unreferenced -> swept along with its `.pdata` sec 14!)
        GcSec { sec_id: 11, obj_id: 1, is_archive: false, extracted: true,  kind: SEC_TEXT,  sym_key: 40, comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_NONE,        reloc_a: none, reloc_b: none, size_bytes: 160, bytes_hash: 500, address_taken: false, folded: false, winner_sec: 11, live: false },
        // 12: `.text$io_print` in archive member `obj 2` (extracted on demand via relocation from sec 0)
        GcSec { sec_id: 12, obj_id: 2, is_archive: true,  extracted: false, kind: SEC_TEXT,  sym_key: 50, comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_NONE,        reloc_a: none, reloc_b: none, size_bytes: 80,  bytes_hash: 600, address_taken: false, folded: false, winner_sec: 12, live: false },
        // 13: `.bss$dead_scratch` in archive member `obj 2` (extracted with obj 2, but unreferenced -> swept by section GC!)
        GcSec { sec_id: 13, obj_id: 2, is_archive: true,  extracted: false, kind: SEC_BSS,   sym_key: 51, comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_NONE,        reloc_a: none, reloc_b: none, size_bytes: 256, bytes_hash: 0,   address_taken: false, folded: false, winner_sec: 13, live: false },
        // 14: `.pdata$dead_helper` in obj 1 (Associative to dead sec 11 -> swept; must NEVER reverse-root sec 11!)
        GcSec { sec_id: 14, obj_id: 1, is_archive: false, extracted: true,  kind: SEC_PDATA, sym_key: 0,  comdat_sel: COMDAT_ASSOCIATIVE, assoc_leader: 11,   root_kind: ROOT_NONE,        reloc_a: 7,    reloc_b: none, size_bytes: 12,  bytes_hash: 501, address_taken: false, folded: false, winner_sec: 14, live: false },
        // 15: `.text$unused_net` in archive member `obj 3` (never referenced -> archive member skipped!)
        GcSec { sec_id: 15, obj_id: 3, is_archive: true,  extracted: false, kind: SEC_TEXT,  sym_key: 60, comdat_sel: COMDAT_NONE,        assoc_leader: none, root_kind: ROOT_NONE,        reloc_a: 999,  reloc_b: none, size_bytes: 320, bytes_hash: 700, address_taken: false, folded: false, winner_sec: 15, live: false }
    ];

    // Step 1: Demand-driven fixed-point archive extraction (`AXS-LNK-003.1`)
    let mut changed: bool = true;
    while changed {
        changed = false;
        let mut i: usize = 0;
        while i < 16 {
            if secs[i].extracted {
                let ra: i32 = secs[i].reloc_a;
                let rb: i32 = secs[i].reloc_b;
                let mut t: usize = 0;
                while t < 16 {
                    if !secs[t].extracted && ((t as i32) == ra || (t as i32) == rb) {
                        let target_obj: i32 = secs[t].obj_id;
                        let mut m: usize = 0;
                        while m < 16 {
                            if secs[m].obj_id == target_obj {
                                secs[m].extracted = true;
                            }
                            m = m + 1;
                        }
                        changed = true;
                    }
                    t = t + 1;
                }
            }
            i = i + 1;
        }
    }

    if !secs[12].extracted || !secs[13].extracted || secs[15].extracted {
        return 1;
    }
    print("demand_driven_archive_extraction_ok=true\n");

    // Step 2: COMDAT group folding & relocation redirection (`AXS-LNK-013`)
    let mut folded_leaders: i32 = 0;
    let mut folded_assocs: i32 = 0;
    let mut i: usize = 0;
    while i < 16 {
        if secs[i].extracted && !secs[i].folded && secs[i].sym_key != 0 && secs[i].comdat_sel != COMDAT_NONE && secs[i].comdat_sel != COMDAT_ASSOCIATIVE {
            let key: i32 = secs[i].sym_key;
            let mut j: usize = i + 1;
            while j < 16 {
                if secs[j].extracted && !secs[j].folded && secs[j].sym_key == key {
                    if secs[j].root_kind != ROOT_NONE && secs[i].root_kind == ROOT_NONE {
                        secs[i].root_kind = secs[j].root_kind;
                    }
                    let dup_sec: i32 = secs[j].sec_id;
                    secs[j].folded = true;
                    secs[j].winner_sec = secs[i].sec_id;
                    folded_leaders = folded_leaders + 1;

                    let mut a: usize = 0;
                    while a < 16 {
                        if secs[a].extracted && secs[a].comdat_sel == COMDAT_ASSOCIATIVE && secs[a].assoc_leader == dup_sec {
                            secs[a].folded = true;
                            secs[a].winner_sec = secs[i].sec_id;
                            folded_assocs = folded_assocs + 1;
                        }
                        a = a + 1;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }

    // Redirect relocations targeting folded COMDAT sections to their winning representative
    let mut r: usize = 0;
    while r < 16 {
        let ra: i32 = secs[r].reloc_a;
        if ra < 16 && secs[ra as usize].folded {
            secs[r].reloc_a = secs[ra as usize].winner_sec;
        }
        let rb: i32 = secs[r].reloc_b;
        if rb < 16 && secs[rb as usize].folded {
            secs[r].reloc_b = secs[rb as usize].winner_sec;
        }
        r = r + 1;
    }

    if folded_leaders != 2 || folded_assocs != 1 || secs[0].reloc_a != 2 || secs[2].root_kind != ROOT_EXPORT {
        return 2;
    }
    print("comdat_generic_vtable_folding_and_root_prop_ok=true\n");

    // Step 3: Root-set FIFO mark-sweep section GC (`AXS-LNK-021..022`)
    let mut queue: [16]i32 = [0; 16];
    let mut q_head: usize = 0;
    let mut q_tail: usize = 0;
    let mut roots_seeded: i32 = 0;

    let mut s: usize = 0;
    while s < 16 {
        if secs[s].extracted && !secs[s].folded && secs[s].root_kind != ROOT_NONE {
            secs[s].live = true;
            queue[q_tail] = s as i32;
            q_tail = q_tail + 1;
            roots_seeded = roots_seeded + 1;
        }
        s = s + 1;
    }

    while q_head < q_tail {
        let cur: i32 = queue[q_head];
        q_head = q_head + 1;
        let ra: i32 = secs[cur as usize].reloc_a;
        if ra < 16 && secs[ra as usize].extracted && !secs[ra as usize].folded && !secs[ra as usize].live {
            secs[ra as usize].live = true;
            queue[q_tail] = ra;
            q_tail = q_tail + 1;
        }
        let rb: i32 = secs[cur as usize].reloc_b;
        if rb < 16 && secs[rb as usize].extracted && !secs[rb as usize].folded && !secs[rb as usize].live {
            secs[rb as usize].live = true;
            queue[q_tail] = rb;
            q_tail = q_tail + 1;
        }
        let mut a: usize = 0;
        while a < 16 {
            if secs[a].extracted && !secs[a].folded && !secs[a].live && secs[a].comdat_sel == COMDAT_ASSOCIATIVE && secs[a].assoc_leader == cur {
                secs[a].live = true;
                queue[q_tail] = a as i32;
                q_tail = q_tail + 1;
            }
            a = a + 1;
        }
    }

    let mut retained_cnt: i32 = 0;
    let mut stripped_cnt: i32 = 0;
    let mut retained_bytes: i32 = 0;
    let mut stripped_bytes: i32 = 0;

    let mut k: usize = 0;
    while k < 16 {
        if secs[k].extracted && !secs[k].folded {
            if secs[k].live {
                retained_cnt = retained_cnt + 1;
                retained_bytes = retained_bytes + secs[k].size_bytes;
            } else {
                stripped_cnt = stripped_cnt + 1;
                stripped_bytes = stripped_bytes + secs[k].size_bytes;
            }
        }
        k = k + 1;
    }

    // Active non-folded sections:
    // Retained (9): 0 (main), 1 (.pdata$main), 2 (clamp_i32), 5 (vt_ord), 7 (build_cookie),
    //               8 (mmio_reg), 9 (mod_init), 10 (refl_meta), 12 (io_print) -> 340 bytes
    // Dead-stripped (3): 11 (dead_helper, 160B), 13 (dead_scratch, 256B), 14 (.pdata$dead_helper, 12B) -> 428 bytes
    if roots_seeded != 6 || retained_cnt != 9 || stripped_cnt != 3 || retained_bytes != 340 || stripped_bytes != 428 {
        return 3;
    }
    print("root_set_mark_sweep_gc_and_unwind_sweep_ok=true\n");
    print("E18-6-COMDAT-ARCHIVE-SECTION-GC-PASS\n");
    0
}
