// modes: interp native
// exit: 101
// stderr-contains: arithmetic overflow
// GENERATED by tests/conformance/p12/e12_1_integers/gen_conformance.py (T455). MAX + 1 on u16 must trap.

fn bad(a: u16, b: u16) -> u16 {
    return a + b;
}

fn main() -> i32 {
    let r: u16 = bad(65535u16, 1u16);
    if r == 1u16 { return 7; }
    print("UNREACHABLE: no trap\n");
    return 0;
}
