// test: run
// modes: interp native
// exit: 101
// stderr-contains: arithmetic overflow
// GENERATED by tests/conformance/p12/e12_1_integers/gen_conformance.py (T455). MAX * 2 on u8 must trap.

fn bad(a: u8, b: u8) -> u8 {
    return a * b;
}

fn main() -> i32 {
    let r: u8 = bad(255u8, 2u8);
    if r == 1u8 { return 7; }
    print("UNREACHABLE: no trap\n");
    return 0;
}
