fn bad(a: i32, c: u32) -> i32 {
    return a >> c;
}

fn main() -> i32 {
    let r: i32 = bad(2147483647i32, 32u32);
    if r == 1i32 { return 7; }
    print("UNREACHABLE: no trap\n");
