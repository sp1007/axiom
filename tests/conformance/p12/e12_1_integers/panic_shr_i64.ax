fn bad(a: i64, c: u32) -> i64 {
    return a >> c;
}

fn main() -> i32 {
    let r: i64 = bad(9223372036854775807i64, 64u32);
    if r == 1i64 { return 7; }
    print("UNREACHABLE: no trap\n");
