// GENERATED by tests/conformance/p12/e12_1_integers/gen_conformance.py (T455). MAX + 1 on i32 must trap.

fn bad(a: i32, b: i32) -> i32 {
    return a + b;
}

fn main() -> i32 {
    let r: i32 = bad(2147483647i32, 1i32);
    if r == 1i32 { return 7; }
    print("UNREACHABLE: no trap\n");
    return 0;
}
