// GENERATED by tests/conformance/p12/e12_1_integers/gen_conformance.py (T455). MAX >> BITS on u8 must trap.

fn bad(a: u8, c: u32) -> u8 {
    return a >> c;
}

fn main() -> i32 {
    let r: u8 = bad(255u8, 8u32);
    if r == 1u8 { return 7; }
    print("UNREACHABLE: no trap\n");
    return 0;
}
