// stderr-contains: shift amount out of range
// GENERATED by tests/conformance/p12/e12_1_integers/gen_conformance.py (T455). MAX >> BITS on i16 must trap.

fn bad(a: i16, c: u32) -> i16 {
    return a >> c;
}

fn main() -> i32 {
    let r: i16 = bad(32767i16, 16u32);
    if r == 1i16 { return 7; }
    print("UNREACHABLE: no trap\n");
    return 0;
}
