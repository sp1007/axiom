// GENERATED by tests/conformance/p12/e12_1_integers/gen_conformance.py (T455). MAX >> BITS on u16 must trap.

fn bad(a: u16, c: u32) -> u16 {
    return a >> c;
}

fn main() -> i32 {
    let r: u16 = bad(65535u16, 16u32);
    if r == 1u16 { return 7; }
    print("UNREACHABLE: no trap\n");
    return 0;
}
