    if r4 != 0 { print("FAIL endian_i128 case "); print_int(r4 as i64); print("\n"); return 5; }
    let r5: i32 = endian_isize(0isize);
    if r5 != 0 { print("FAIL endian_isize case "); print_int(r5 as i64); print("\n"); return 6; }
    let r6: i32 = endian_u8(0u8);
    if r6 != 0 { print("FAIL endian_u8 case "); print_int(r6 as i64); print("\n"); return 7; }
    let r7: i32 = endian_u16(0u16);
    if r7 != 0 { print("FAIL endian_u16 case "); print_int(r7 as i64); print("\n"); return 8; }
    let r8: i32 = endian_u32(0u32);
    if r8 != 0 { print("FAIL endian_u32 case "); print_int(r8 as i64); print("\n"); return 9; }
    let r9: i32 = endian_u64(0u64);
    if r9 != 0 { print("FAIL endian_u64 case "); print_int(r9 as i64); print("\n"); return 10; }
    let r10: i32 = endian_u128(0u128);
    if r10 != 0 { print("FAIL endian_u128 case "); print_int(r10 as i64); print("\n"); return 11; }
    let r11: i32 = endian_usize(0usize);
    if r11 != 0 { print("FAIL endian_usize case "); print_int(r11 as i64); print("\n"); return 12; }
    print("OK std_endian\n");
    0
}
