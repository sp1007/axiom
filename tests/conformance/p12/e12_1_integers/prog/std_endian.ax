fn main() -> i32 {
    let r0: i32 = endian_i8(0i8);
    if r0 != 0 { print("FAIL endian_i8 case "); print_int(r0 as i64); print("\n"); return 1; }
    let r1: i32 = endian_i16(0i16);
    if r1 != 0 { print("FAIL endian_i16 case "); print_int(r1 as i64); print("\n"); return 2; }
    let r2: i32 = endian_i32(0i32);
    if r2 != 0 { print("FAIL endian_i32 case "); print_int(r2 as i64); print("\n"); return 3; }
    let r3: i32 = endian_i64(0i64);
    if r3 != 0 { print("FAIL endian_i64 case "); print_int(r3 as i64); print("\n"); return 4; }
