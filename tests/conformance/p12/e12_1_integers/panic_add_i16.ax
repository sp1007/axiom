// test: run
// modes: interp native
// exit: 101
// stderr-contains: arithmetic overflow
// GENERATED by tests/conformance/p12/e12_1_integers/gen_conformance.py (T455). MAX + 1 on i16 must trap.

fn bad(a: i16, b: i16) -> i16 {
    return a + b;
}

fn main() -> i32 {
    let r: i16 = bad(32767i16, 1i16);
    if r == 1i16 { return 7; }
    print("UNREACHABLE: no trap\n");
    return 0;
}
