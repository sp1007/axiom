// Master Conformance Probe for E20.4 Hermetic Build Sandbox, Bit-for-Bit Reproducibility,
// Supply-Chain Trust Model, Ed25519 Signing, Key Rotation, Provenance Attestation & CLI Engine
// (`tests/conformance/p20/e20_4_hermetic_supply_chain/e20_4_hermetic_supply_chain_probe.ax.in`, T865).
//
// Implements SPEC-113 §§1..5 (`AXS-HERM-001`..`053`, `REQ-PKG-022`, `REQ-PKG-024`,
// `INV-HERM-001`..`INV-HERM-003`, `INV-DET-002`).

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

