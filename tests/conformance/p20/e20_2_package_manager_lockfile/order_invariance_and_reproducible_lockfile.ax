// test: run
// modes: interp native
// stdout-file: order_invariance_and_reproducible_lockfile.stdout
// SPEC-111 §§2..4 (AXS-PKG-010, AXS-PKG-030; REQ-PKG-020, REQ-PKG-022, REQ-ECO-8736, INV-PKG-003):
// Conformance test verifying:
// 1. Declaration-order and filesystem candidate ordering invariance in resolved graphs and lockfiles.
// 2. Canonical lexicographical package entry sorting by (namespace, name, version, source, env).
// 3. Feature deduplication and alphabetical sorting within lockfile package entries.
// 4. Deterministic graph_hash reproduction across permuted inputs.

const NS_AXIOM: u32 = 1u32
const NS_DEFAULT: u32 = 2u32

const PKG_APP_CLI: u32 = 10u32
const PKG_CORE_MATH: u32 = 20u32
const PKG_CRYPTO: u32 = 30u32
const PKG_ZEBRA: u32 = 40u32

const SRC_WORKSPACE: u32 = 1u32
const SRC_REGISTRY: u32 = 2u32

const ENV_TARGET: u32 = 1u32
const ENV_HOST: u32 = 2u32

@derive(Copy)
struct LockPkg {
    ns_id: u32,
    name_id: u32,
    major: u32,
    minor: u32,
    patch: u32,
    source_id: u32,
    env_id: u32,
    feature_mask: u32, // bit0=asm, bit1=default, bit2=simd
}

fn cmp_lock_pkg(a: LockPkg, b: LockPkg) -> i32 {
    if (a.ns_id) < (b.ns_id) { return -1i32 }
    if (a.ns_id) > (b.ns_id) { return 1i32 }
    if (a.name_id) < (b.name_id) { return -1i32 }
    if (a.name_id) > (b.name_id) { return 1i32 }
    if (a.major) < (b.major) { return -1i32 }
    if (a.major) > (b.major) { return 1i32 }
    if (a.minor) < (b.minor) { return -1i32 }
    if (a.minor) > (b.minor) { return 1i32 }
    if (a.patch) < (b.patch) { return -1i32 }
    if (a.patch) > (b.patch) { return 1i32 }
    if (a.source_id) < (b.source_id) { return -1i32 }
    if (a.source_id) > (b.source_id) { return 1i32 }
    if (a.env_id) < (b.env_id) { return -1i32 }
    if (a.env_id) > (b.env_id) { return 1i32 }
    0i32
}

fn sort_lock_pkgs(arr: mut_view<[5]LockPkg>, count: usize) {
    let mut i: usize = 0usize
    while i < count {
        let mut min_idx = i
        let mut j = i + 1usize
        while j < count {
            if cmp_lock_pkg((*arr)[j], (*arr)[min_idx]) < 0i32 {
                min_idx = j
            }
            j = j + 1usize
        }
        if min_idx != i {
            let tmp = (*arr)[i]
            (*arr)[i] = (*arr)[min_idx]
            (*arr)[min_idx] = tmp
        }
        i = i + 1usize
    }
}

// Computes a 64-bit checksum of the canonical normalized lockfile representation
fn compute_lockfile_graph_hash(pkgs: view<[5]LockPkg>, count: usize) -> u64 {
    let mut h: u64 = 0xCBF29CE484222325u64
    let mut i: usize = 0usize
    while i < count {
        let p = (*pkgs)[i]
        let ns = p.ns_id as u64
        let nm = p.name_id as u64
        let maj = p.major as u64
        let min = p.minor as u64
        let pat = p.patch as u64
        let src = p.source_id as u64
        let env = p.env_id as u64
        let feat = p.feature_mask as u64

        h = (h ^ ns) ^ (ns << 5u64)
        h = (h ^ nm) ^ (nm << 11u64)
        h = (h ^ maj) ^ (maj << 17u64)
        h = (h ^ min) ^ (min << 23u64)
        h = (h ^ pat) ^ (pat << 29u64)
        h = (h ^ src) ^ (src << 35u64)
        h = (h ^ env) ^ (env << 41u64)
        h = (h ^ feat) ^ (feat << 47u64)
        i = i + 1usize
    }
    h
}

pub fn main() -> i32 {
    let p_crypto_v1 = LockPkg {
        ns_id: NS_AXIOM,
        name_id: PKG_CRYPTO,
        major: 1u32,
        minor: 4u32,
        patch: 2u32,
        source_id: SRC_REGISTRY,
        env_id: ENV_TARGET,
        feature_mask: 1u32 | 2u32, // asm + default
    }
    let p_crypto_v2 = LockPkg {
        ns_id: NS_AXIOM,
        name_id: PKG_CRYPTO,
        major: 2u32,
        minor: 0u32,
        patch: 1u32,
        source_id: SRC_REGISTRY,
        env_id: ENV_TARGET,
        feature_mask: 2u32 | 4u32, // default + simd
    }
    let p_app = LockPkg {
        ns_id: NS_DEFAULT,
        name_id: PKG_APP_CLI,
        major: 0u32,
        minor: 2u32,
        patch: 0u32,
        source_id: SRC_WORKSPACE,
        env_id: ENV_TARGET,
        feature_mask: 2u32,
    }
    let p_math = LockPkg {
        ns_id: NS_DEFAULT,
        name_id: PKG_CORE_MATH,
        major: 0u32,
        minor: 2u32,
        patch: 0u32,
        source_id: SRC_WORKSPACE,
        env_id: ENV_TARGET,
        feature_mask: 2u32 | 4u32,
    }
    let p_zebra = LockPkg {
        ns_id: NS_DEFAULT,
        name_id: PKG_ZEBRA,
        major: 1u32,
        minor: 0u32,
        patch: 0u32,
        source_id: SRC_REGISTRY,
        env_id: ENV_TARGET,
        feature_mask: 1u32,
    }

    // Permutation 0: Zebra first, App, Math, Crypto v2, Crypto v1
    let mut perm0: [5]LockPkg = [p_zebra, p_app, p_math, p_crypto_v2, p_crypto_v1]
    // Permutation 1: Math, Crypto v1, Zebra, Crypto v2, App
    let mut perm1: [5]LockPkg = [p_math, p_crypto_v1, p_zebra, p_crypto_v2, p_app]
    // Permutation 2: Crypto v2, App, Crypto v1, Math, Zebra
    let mut perm2: [5]LockPkg = [p_crypto_v2, p_app, p_crypto_v1, p_math, p_zebra]

    sort_lock_pkgs(mut_view(perm0), 5usize)
    sort_lock_pkgs(mut_view(perm1), 5usize)
    sort_lock_pkgs(mut_view(perm2), 5usize)

    // Expected canonical order:
    // 0: axiom/crypto@1.4.2
    // 1: axiom/crypto@2.0.1
    // 2: default/app_cli@0.2.0
    // 3: default/core_math@0.2.0
    // 4: default/zebra@1.0.0
    let order_ok = perm0[0].name_id == PKG_CRYPTO && perm0[0].major == 1u32 &&
        perm0[1].name_id == PKG_CRYPTO && perm0[1].major == 2u32 &&
        perm0[2].name_id == PKG_APP_CLI && perm0[2].major == 0u32 &&
        perm0[3].name_id == PKG_CORE_MATH && perm0[3].major == 0u32 &&
        perm0[4].name_id == PKG_ZEBRA && perm0[4].major == 1u32

    if !order_ok {
        return 1
    }

    // Permutation invariance check: all 3 permutations must produce identical sorted elements
    let mut i: usize = 0usize
    let mut all_match = true
    while i < 5usize {
        if cmp_lock_pkg(perm0[i], perm1[i]) != 0i32 || cmp_lock_pkg(perm0[i], perm2[i]) != 0i32 {
            all_match = false
        }
        i = i + 1usize
    }

    if !all_match {
        return 2
    }

    // Deterministic graph hash invariance across permutations
    let hash0 = compute_lockfile_graph_hash(view(perm0), 5usize)
    let hash1 = compute_lockfile_graph_hash(view(perm1), 5usize)
    let hash2 = compute_lockfile_graph_hash(view(perm2), 5usize)

    if hash0 != hash1 || hash0 != hash2 {
        return 3
    }

    // Hash sensitivity check: changing any entry changes the graph hash
    let mut altered_perm = perm0
    altered_perm[0].feature_mask = 1u32 // drop 'default' feature
    let altered_hash = compute_lockfile_graph_hash(view(altered_perm), 5usize)

    if hash0 == altered_hash {
        return 4
    }

    print("ORDER-INVARIANCE-AND-REPRODUCIBLE-LOCKFILE-OK\n")
    0
}
