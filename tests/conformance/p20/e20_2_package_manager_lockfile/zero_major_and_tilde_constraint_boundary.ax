// test: run
// modes: interp native
// stdout-file: zero_major_and_tilde_constraint_boundary.stdout
// SPEC-111 §§1..2 (AXS-PKG-004..005, AXS-PKG-011; REQ-PKG-022, REQ-PKG-024, REQ-ECO-8736, INV-PKG-003):
// Conformance boundary cross-check verifying:
// 1. Zero-major SemVer caret rules (^0.m.p restricts to minor, ^0.0.p restricts to exact patch).
// 2. Tilde patch-level constraint evaluation (~M.m.p vs ^M.m.p).
// 3. Zero-major diamond dependency compatibility track unification and rejection.

@derive(Copy)
struct SemVerCore {
    major: u32,
    minor: u32,
    patch: u32,
}

fn semver_new(maj: u32, min: u32, pat: u32) -> SemVerCore {
    SemVerCore {
        major: maj,
        minor: min,
        patch: pat,
    }
}

fn cmp_semver(a: SemVerCore, b: SemVerCore) -> i32 {
    if (a.major) < (b.major) { return -1i32 }
    if (a.major) > (b.major) { return 1i32 }
    if (a.minor) < (b.minor) { return -1i32 }
    if (a.minor) > (b.minor) { return 1i32 }
    if (a.patch) < (b.patch) { return -1i32 }
    if (a.patch) > (b.patch) { return 1i32 }
    0i32
}

// Caret compatibility matching (AXS-PKG-005 §1):
// ^M.m.p (M > 0): M.m.p <= v < (M+1).0.0
// ^0.m.p (m > 0): 0.m.p <= v < 0.(m+1).0
// ^0.0.p: v == 0.0.p
fn caret_matches(base: SemVerCore, cand: SemVerCore) -> bool {
    if cmp_semver(cand, base) < 0i32 {
        return false
    }
    if base.major > 0u32 {
        return cand.major == base.major
    }
    if base.minor > 0u32 {
        return cand.major == 0u32 && cand.minor == base.minor
    }
    cand.major == 0u32 && cand.minor == 0u32 && cand.patch == base.patch
}

// Tilde patch-level matching (AXS-PKG-005 §2):
// ~M.m.p: M.m.p <= v < M.(m+1).0
fn tilde_matches(base: SemVerCore, cand: SemVerCore) -> bool {
    if cmp_semver(cand, base) < 0i32 {
        return false
    }
    cand.major == base.major && cand.minor == base.minor
}

@derive(Copy)
struct ZeroDiamondResult {
    resolved: bool,
    selected_version: SemVerCore,
    incompatible_track: bool,
}

fn resolve_zero_major_diamond(
    cands: view<[5]SemVerCore>,
    cand_count: usize,
    req_caret: SemVerCore,
    req_tilde: SemVerCore
) -> ZeroDiamondResult {
    let mut best_ver = semver_new(0u32, 0u32, 0u32)
    let mut found = false

    let mut i: usize = 0usize
    while i < cand_count {
        let c = (*cands)[i]
        if caret_matches(req_caret, c) && tilde_matches(req_tilde, c) {
            if !found || cmp_semver(c, best_ver) > 0i32 {
                best_ver = c
                found = true
            }
        }
        i = i + 1usize
    }

    if found {
        return ZeroDiamondResult {
            resolved: true,
            selected_version: best_ver,
            incompatible_track: false,
        }
    }

    // Check if compatibility tracks are distinct (AXS-PKG-011 §1)
    let track_caret = if req_caret.major > 0u32 { req_caret.major * 1000u32 } else { req_caret.minor * 10u32 }
    let track_tilde = if req_tilde.major > 0u32 { req_tilde.major * 1000u32 } else { req_tilde.minor * 10u32 }
    let is_incompat = track_caret != track_tilde

    ZeroDiamondResult {
        resolved: false,
        selected_version: semver_new(0u32, 0u32, 0u32),
        incompatible_track: is_incompat,
    }
}

pub fn main() -> i32 {
    // 1. Zero-major caret boundary (^0.2.3)
    let c_0_2_3 = semver_new(0u32, 2u32, 3u32)
    let v_0_2_3 = semver_new(0u32, 2u32, 3u32)
    let v_0_2_8 = semver_new(0u32, 2u32, 8u32)
    let v_0_3_0 = semver_new(0u32, 3u32, 0u32)
    let v_0_2_2 = semver_new(0u32, 2u32, 2u32)
    let v_1_2_3 = semver_new(1u32, 2u32, 3u32)

    let caret_0_m_ok = caret_matches(c_0_2_3, v_0_2_3) &&
        caret_matches(c_0_2_3, v_0_2_8) &&
        !caret_matches(c_0_2_3, v_0_3_0) &&
        !caret_matches(c_0_2_3, v_0_2_2) &&
        !caret_matches(c_0_2_3, v_1_2_3)

    if !caret_0_m_ok {
        return 1
    }

    // 2. Zero-minor caret boundary (^0.0.4)
    let c_0_0_4 = semver_new(0u32, 0u32, 4u32)
    let v_0_0_4 = semver_new(0u32, 0u32, 4u32)
    let v_0_0_5 = semver_new(0u32, 0u32, 5u32)
    let v_0_0_3 = semver_new(0u32, 0u32, 3u32)
    let v_0_1_0 = semver_new(0u32, 1u32, 0u32)

    let caret_0_0_ok = caret_matches(c_0_0_4, v_0_0_4) &&
        !caret_matches(c_0_0_4, v_0_0_5) &&
        !caret_matches(c_0_0_4, v_0_0_3) &&
        !caret_matches(c_0_0_4, v_0_1_0)

    if !caret_0_0_ok {
        return 2
    }

    // 3. Tilde patch-level constraint (~1.2.3 vs ^1.2.3)
    let t_1_2_3 = semver_new(1u32, 2u32, 3u32)
    let v_1_2_9 = semver_new(1u32, 2u32, 9u32)
    let v_1_3_0 = semver_new(1u32, 3u32, 0u32)
    let v_1_2_2 = semver_new(1u32, 2u32, 2u32)

    // ~1.2.3 accepts 1.2.9, but rejects 1.3.0; whereas ^1.2.3 accepts 1.3.0
    let tilde_ok = tilde_matches(t_1_2_3, v_1_2_3) &&
        tilde_matches(t_1_2_3, v_1_2_9) &&
        !tilde_matches(t_1_2_3, v_1_3_0) &&
        caret_matches(t_1_2_3, v_1_3_0) &&
        !tilde_matches(t_1_2_3, v_1_2_2)

    if !tilde_ok {
        return 3
    }

    // 4. Zero-major diamond resolution within ZeroMinorTrack(2)
    let cands_zero: [5]SemVerCore = [
        semver_new(0u32, 2u32, 1u32),
        semver_new(0u32, 2u32, 3u32),
        semver_new(0u32, 2u32, 6u32),
        semver_new(0u32, 3u32, 0u32),
        semver_new(0u32, 3u32, 2u32),
    ]

    // req_caret = ^0.2.1 (allows 0.2.1 .. < 0.3.0), req_tilde = ~0.2.2 (allows 0.2.2 .. < 0.3.0)
    let res_sat = resolve_zero_major_diamond(
        view(cands_zero),
        5usize,
        semver_new(0u32, 2u32, 1u32),
        semver_new(0u32, 2u32, 2u32)
    )

    let sat_ok = res_sat.resolved &&
        res_sat.selected_version.major == 0u32 &&
        res_sat.selected_version.minor == 2u32 &&
        res_sat.selected_version.patch == 6u32

    if !sat_ok {
        return 4
    }

    // 5. Incompatible zero-major tracks: ^0.2.1 vs ~0.3.0
    let res_unsat = resolve_zero_major_diamond(
        view(cands_zero),
        5usize,
        semver_new(0u32, 2u32, 1u32),
        semver_new(0u32, 3u32, 0u32)
    )

    let unsat_ok = !res_unsat.resolved && res_unsat.incompatible_track

    if !unsat_ok {
        return 5
    }

    print("ZERO-MAJOR-AND-TILDE-CONSTRAINT-BOUNDARY-OK\n")
    0
}
