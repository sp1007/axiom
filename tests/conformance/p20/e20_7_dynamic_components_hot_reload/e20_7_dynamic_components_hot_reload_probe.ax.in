use std.component.loader.component_new
use std.component.loader.component_register_interface
use std.component.loader.component_acquire_interface

use std.component.hot_reload.AllocatorVTable
use std.component.hot_reload.ComponentBox
use std.component.hot_reload.ComponentHandle
use std.component.hot_reload.ComponentHandleTable
use std.component.hot_reload.EpochTracker
use std.component.hot_reload.STATUS_ACTIVE as HR_STATUS_ACTIVE
use std.component.hot_reload.STATUS_QUIESCING as HR_STATUS_QUIESCING
use std.component.hot_reload.STATUS_RETIRED as HR_STATUS_RETIRED
use std.component.hot_reload.STATUS_UNLOADED as HR_STATUS_UNLOADED
use std.component.hot_reload.ComponentLease
use std.component.hot_reload.ComponentStateSnapshot
use std.component.hot_reload.MigrationHook
