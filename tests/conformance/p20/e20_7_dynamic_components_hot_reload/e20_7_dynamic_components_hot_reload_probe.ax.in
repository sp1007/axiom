// End-to-End Conformance Probe for E20.7 Dynamic Components, Plugin Discovery,
// Cross-Boundary Ownership/Capability Isolation & Hot-Reload State Migration.
// SPEC-115 §§1..6 (AXS-COMP-001..055; REQ-ECO-8734, INV-COMP-001, INV-COMP-002).

module main

use host_intrinsics.stdio
use host_intrinsics.write

use compiler.kernel.interner.StrView
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_eq

use compiler.component.interface.calculate_vtable_size
use compiler.component.interface.compute_interface_fingerprint
use compiler.component.interface.compute_target_triple_fingerprint
use compiler.component.interface.validate_component_id_format
use compiler.component.interface.component_param_desc_default
