// test: run
// modes: interp native
// stdout-file: manifest_corruption_and_semver_edge_cases.stdout
// SPEC-115 §§1..3 (AXS-COMP-005, AXS-COMP-010..014, AXS-COMP-022, AXS-COMP-050; REQ-ECO-8734):
// E20.7 QA Boundary Conformance: .axcomp header corruption validation, missing manifest detection,
// fine-grained SemVer 2.0 zero-major/zero-minor caret edge cases, capability escalation prevention,
// and generational handle slot overflow retirement.

const AX_COMP_MISSING_ENTRY_POINT: u32 = 230u32
const AX_COMP_MISSING_MANIFEST: u32 = 231u32
const AX_COMP_CORRUPT_MANIFEST: u32 = 232u32
const AX_COMP_DUPLICATE_REGISTRATION: u32 = 233u32
const AX_COMP_TARGET_MISMATCH: u32 = 234u32
const AX_COMP_VERSION_INCOMPATIBLE: u32 = 235u32
const AX_COMP_ABI_MISMATCH: u32 = 236u32
const AX_COMP_CAPABILITY_DENIED: u32 = 237u32
const AX_COMP_STALE_HANDLE: u32 = 240u32
const AX_COMP_CAPABILITY_REVOKED: u32 = 245u32

const CAP_HEAP_ALLOCATION: u32 = 0x0001u32
const CAP_FS_READ: u32 = 0x0002u32
const CAP_FS_WRITE: u32 = 0x0004u32
const CAP_NET_CONNECT: u32 = 0x0008u32
const CAP_CONCURRENCY: u32 = 0x0010u32
const CAP_GPU: u32 = 0x0020u32

const AXCOMP_MAGIC: u32 = 0x504D4F43u32 // ASCII "COMP"
const AXCOMP_FORMAT_VERSION: u16 = 1u16
const AXCOMP_MIN_HEADER_SIZE: u16 = 128u16

@derive(Copy)
struct AxCompHeader {
    magic: u32,
    format_version: u16,
    header_size: u16,
    manifest_caps: u32,
}

fn validate_axcomp_header(hdr: AxCompHeader) -> u32 {
    if hdr.magic != AXCOMP_MAGIC {
        return AX_COMP_CORRUPT_MANIFEST
    }
    if hdr.format_version != AXCOMP_FORMAT_VERSION {
        return AX_COMP_CORRUPT_MANIFEST
    }
    if AXCOMP_MIN_HEADER_SIZE > hdr.header_size {
        return AX_COMP_CORRUPT_MANIFEST
    }
    0u32
}

fn check_manifest_present(has_section: bool) -> u32 {
    if !has_section {
        return AX_COMP_MISSING_MANIFEST
    }
    0u32
}

@derive(Copy)
struct SemVer {
    major: u32,
    minor: u32,
    patch: u32,
    prerelease_len: usize,
}

fn semver_new(maj: u32, min: u32, pat: u32) -> SemVer {
    SemVer {
        major: maj,
        minor: min,
        patch: pat,
        prerelease_len: 0usize,
    }
}

fn semver_with_pre(maj: u32, min: u32, pat: u32, pre_len: usize) -> SemVer {
    SemVer {
        major: maj,
        minor: min,
        patch: pat,
        prerelease_len: pre_len,
    }
}

// Canonical SemVer 2.0 Caret matching per AXS-COMP-011
fn semver_matches_caret(req: SemVer, cand: SemVer) -> bool {
    if req.prerelease_len == 0usize && cand.prerelease_len > 0usize {
        return false
    }
    if req.major > 0u32 {
        if cand.major != req.major {
            return false
        }
        if req.minor > cand.minor {
            return false
        }
        if cand.minor == req.minor && req.patch > cand.patch {
            return false
        }
        return true
    }
    if req.minor > 0u32 {
        if cand.major != 0u32 || cand.minor != req.minor {
            return false
        }
        return cand.patch >= req.patch
    }
    cand.major == 0u32 && cand.minor == 0u32 && cand.patch == req.patch
}

@derive(Copy)
struct CapabilityGrant {
    granted_mask: u32,
    is_revoked: bool,
}

fn grant_new(mask: u32) -> CapabilityGrant {
    CapabilityGrant { granted_mask: mask, is_revoked: false }
}

fn grant_attenuate(g: mut_view<CapabilityGrant>, remove_mask: u32) {
    g.granted_mask = g.granted_mask & (~remove_mask)
}

fn grant_revoke(g: mut_view<CapabilityGrant>) {
    g.is_revoked = true
    g.granted_mask = 0u32
}

fn grant_check(g: CapabilityGrant, required_cap: u32) -> u32 {
    if g.is_revoked {
        return AX_COMP_CAPABILITY_REVOKED
    }
    if (g.granted_mask & required_cap) != required_cap {
        return AX_COMP_CAPABILITY_DENIED
    }
    0u32
}

@derive(Copy)
struct HandleSlot {
    generation: u32,
    epoch_id: u32,
    is_occupied: bool,
    is_retired: bool,
}

@derive(Copy)
struct ComponentHandle {
    index: u32,
    generation: u32,
    epoch_id: u32,
}

struct GenerationalSlotTable {
    slots: [4]HandleSlot,
    capacity: usize,
}

fn slot_table_new() -> GenerationalSlotTable {
    let empty = HandleSlot {
        generation: 1u32,
        epoch_id: 1u32,
        is_occupied: false,
        is_retired: false,
    }
    GenerationalSlotTable {
        slots: [empty, empty, empty, empty],
        capacity: 4usize,
    }
}

fn slot_table_access(table: view<GenerationalSlotTable>, h: ComponentHandle) -> u32 {
    let idx = h.index as usize
    if idx >= table.capacity {
        return AX_COMP_STALE_HANDLE
    }
    let slot = table.slots[idx]
    if !slot.is_occupied || slot.is_retired {
        return AX_COMP_STALE_HANDLE
    }
    if slot.generation != h.generation || slot.epoch_id != h.epoch_id {
        return AX_COMP_STALE_HANDLE
    }
    0u32
}

fn slot_table_retire_overflow(table: mut_view<GenerationalSlotTable>, index: usize) {
    if index < table.capacity {
        table.slots[index].is_retired = true
        table.slots[index].is_occupied = false
    }
}

fn print_bool(label: str, val: bool) {
    print(label)
    if val {
        print(": true\n")
    } else {
        print(": false\n")
    }
}

fn print_u32_code(label: str, v: u32) {
    print(label)
    print(": ")
    if v == 0u32 {
        print("0\n")
    } else if v == AX_COMP_MISSING_ENTRY_POINT {
        print("230\n")
    } else if v == AX_COMP_MISSING_MANIFEST {
        print("231\n")
    } else if v == AX_COMP_CORRUPT_MANIFEST {
        print("232\n")
    } else if v == AX_COMP_DUPLICATE_REGISTRATION {
        print("233\n")
    } else if v == AX_COMP_TARGET_MISMATCH {
        print("234\n")
    } else if v == AX_COMP_VERSION_INCOMPATIBLE {
        print("235\n")
    } else if v == AX_COMP_ABI_MISMATCH {
        print("236\n")
    } else if v == AX_COMP_CAPABILITY_DENIED {
        print("237\n")
    } else if v == AX_COMP_STALE_HANDLE {
        print("240\n")
    } else if v == AX_COMP_CAPABILITY_REVOKED {
        print("245\n")
    } else {
        print("unknown\n")
    }
}

fn main() -> i32 {
    // 1. Manifest Header Validation & Corruption Edge Cases (AXS-COMP-005, AXS-COMP-010)
    let valid_hdr = AxCompHeader {
        magic: AXCOMP_MAGIC,
        format_version: 1u16,
        header_size: 128u16,
        manifest_caps: CAP_HEAP_ALLOCATION | CAP_FS_READ,
    }
    let bad_magic_hdr = AxCompHeader {
        magic: 0xDEADBEEFu32,
        format_version: 1u16,
        header_size: 128u16,
        manifest_caps: CAP_HEAP_ALLOCATION,
    }
    let bad_ver_hdr = AxCompHeader {
        magic: AXCOMP_MAGIC,
        format_version: 99u16,
        header_size: 128u16,
        manifest_caps: CAP_HEAP_ALLOCATION,
    }
    let bad_sz_hdr = AxCompHeader {
        magic: AXCOMP_MAGIC,
        format_version: 1u16,
        header_size: 64u16,
        manifest_caps: CAP_HEAP_ALLOCATION,
    }

    print_u32_code("rc_valid_manifest", validate_axcomp_header(valid_hdr))
    print_u32_code("rc_corrupt_magic", validate_axcomp_header(bad_magic_hdr))
    print_u32_code("rc_corrupt_version", validate_axcomp_header(bad_ver_hdr))
    print_u32_code("rc_corrupt_header_size", validate_axcomp_header(bad_sz_hdr))
    print_u32_code("rc_missing_manifest", check_manifest_present(false))

    // 2. Fine-Grained SemVer 2.0 Caret Edge Cases (AXS-COMP-011)
    // ^0.0.4 - only exactly 0.0.4 matches; 0.0.5 or 0.1.0 are breaking
    let req_zero_zero = semver_new(0u32, 0u32, 4u32)
    let cand_zz_exact = semver_new(0u32, 0u32, 4u32)
    let cand_zz_patch_break = semver_new(0u32, 0u32, 5u32)
    let cand_zz_minor_break = semver_new(0u32, 1u32, 0u32)

    let zz_ok = semver_matches_caret(req_zero_zero, cand_zz_exact) &&
                !semver_matches_caret(req_zero_zero, cand_zz_patch_break) &&
                !semver_matches_caret(req_zero_zero, cand_zz_minor_break)
    print_bool("semver_zero_zero_caret_ok", zz_ok)

    // ^0.2.3 - 0.2.3..0.2.x match; 0.3.0 or 0.2.1 fail
    let req_zero_two = semver_new(0u32, 2u32, 3u32)
    let cand_zt_compat = semver_new(0u32, 2u32, 8u32)
    let cand_zt_minor_break = semver_new(0u32, 3u32, 0u32)
    let cand_zt_older = semver_new(0u32, 2u32, 1u32)

    let zt_ok = semver_matches_caret(req_zero_two, cand_zt_compat) &&
                !semver_matches_caret(req_zero_two, cand_zt_minor_break) &&
                !semver_matches_caret(req_zero_two, cand_zt_older)
    print_bool("semver_zero_two_caret_ok", zt_ok)

    // Prerelease rejection against release requirement
    let req_release = semver_new(1u32, 0u32, 0u32)
    let cand_prerelease = semver_with_pre(1u32, 0u32, 1u32, 4usize)
    let pre_ok = !semver_matches_caret(req_release, cand_prerelease)
    print_bool("semver_prerelease_rejected", pre_ok)

    // 3. Capability Attenuation & Escalation Denial (AXS-COMP-013, AXS-COMP-014)
    let mut grant = grant_new(CAP_HEAP_ALLOCATION | CAP_FS_READ)
    print_u32_code("rc_initial_grant_heap", grant_check(grant, CAP_HEAP_ALLOCATION))
    print_u32_code("rc_initial_grant_fs_read", grant_check(grant, CAP_FS_READ))
    print_u32_code("rc_escalation_denied_net", grant_check(grant, CAP_NET_CONNECT))

    grant_attenuate(mut_view(grant), CAP_FS_READ)
    print_u32_code("rc_attenuated_fs_denied", grant_check(grant, CAP_FS_READ))
    print_u32_code("rc_attenuated_heap_retained", grant_check(grant, CAP_HEAP_ALLOCATION))

    grant_revoke(mut_view(grant))
    print_u32_code("rc_revoked_heap_access", grant_check(grant, CAP_HEAP_ALLOCATION))
    print_u32_code("rc_revoked_fs_access", grant_check(grant, CAP_FS_READ))

    // 4. Generational Handle Retirement on Overflow (AXS-COMP-022)
    let mut table = slot_table_new()
    table.slots[0].is_occupied = true
    table.slots[0].generation = 1u32
    table.slots[0].epoch_id = 1u32

    let valid_handle = ComponentHandle { index: 0u32, generation: 1u32, epoch_id: 1u32 }
    let stale_gen_handle = ComponentHandle { index: 0u32, generation: 2u32, epoch_id: 1u32 }
    let stale_epoch_handle = ComponentHandle { index: 0u32, generation: 1u32, epoch_id: 2u32 }
    let oob_handle = ComponentHandle { index: 10u32, generation: 1u32, epoch_id: 1u32 }

    print_u32_code("rc_valid_handle_access", slot_table_access(view(table), valid_handle))
    print_u32_code("rc_stale_gen_access", slot_table_access(view(table), stale_gen_handle))
    print_u32_code("rc_stale_epoch_access", slot_table_access(view(table), stale_epoch_handle))
    print_u32_code("rc_oob_handle_access", slot_table_access(view(table), oob_handle))

    // Overflow / retirement:
    slot_table_retire_overflow(mut_view(table), 0usize)
    print_u32_code("rc_retired_slot_access", slot_table_access(view(table), valid_handle))

    print("conformance[manifest_corruption_semver_edge_cases] OK\n")
    0
}
