// test: run
// modes: interp native
// stdout-file: adversarial_sparse_index_and_device_sandbox.stdout
// SPEC-112 §§1..4 (AXS-REG-011, AXS-REG-013, AXS-REG-030, AXS-REG-031, AXS-REG-033; REQ-PKG-024, REQ-ECO-8736, INV-REG-001..002):
// Adversarial QA Boundary Conformance Test verifying:
// 1. Sparse index prefix rules for 1-char, 2-char, 3-char, and multi-char names under AXPACKAGE_PROTOCOL_1 (AXS-REG-030).
// 2. Comprehensive extraction sandbox defenses rejecting Windows reserved devices (CON, PRN, AUX, NUL, COM1..9, LPT1..9), backslashes, UNC prefixes, null bytes, and path traversals (AXS-REG-013).
// 3. Multi-repository dependency-confusion shadow blocks and trust policy dominance over priority (AXS-REG-031).
// 4. SemVer minimum secure version floor and downgrade prevention state machine (AXS-REG-033).

const PATH_OK: u32 = 0u32
const PATH_ERR_EMPTY: u32 = 1u32
const PATH_ERR_ABSOLUTE: u32 = 2u32
const PATH_ERR_BACKSLASH: u32 = 3u32
const PATH_ERR_DRIVE: u32 = 4u32
const PATH_ERR_NULL_BYTE: u32 = 5u32
const PATH_ERR_TRAVERSAL: u32 = 6u32
const PATH_ERR_RESERVED_DEVICE: u32 = 7u32

fn to_lower_ascii(c: u8) -> u8 {
    if c >= 65u8 && c <= 90u8 {
        c + 32u8
    } else {
        c
    }
}

fn is_reserved_device_seg(p: view<[u8]>, seg_start: usize, seg_len: usize) -> bool {
    if seg_len == 0usize {
        return false
    }
    // Find stem length up to '.' or end of segment
    let mut stem_len: usize = 0usize
    while stem_len < seg_len && p[seg_start + stem_len] != 46u8 {
        stem_len = stem_len + 1usize
    }
    if stem_len == 3usize {
        let c0 = to_lower_ascii(p[seg_start])
        let c1 = to_lower_ascii(p[seg_start + 1usize])
        let c2 = to_lower_ascii(p[seg_start + 2usize])
        // "con"
        if c0 == 99u8 && c1 == 111u8 && c2 == 110u8 {
            return true
        }
        // "prn"
        if c0 == 112u8 && c1 == 114u8 && c2 == 110u8 {
            return true
        }
        // "aux"
        if c0 == 97u8 && c1 == 117u8 && c2 == 120u8 {
            return true
        }
        // "nul"
        if c0 == 110u8 && c1 == 117u8 && c2 == 108u8 {
            return true
        }
    } else if stem_len == 4usize {
        let c0 = to_lower_ascii(p[seg_start])
        let c1 = to_lower_ascii(p[seg_start + 1usize])
        let c2 = to_lower_ascii(p[seg_start + 2usize])
        let c3 = p[seg_start + 3usize]
        if c3 >= 49u8 && c3 <= 57u8 {
            // "com1".."com9"
            if c0 == 99u8 && c1 == 111u8 && c2 == 109u8 {
                return true
            }
            // "lpt1".."lpt9"
            if c0 == 108u8 && c1 == 112u8 && c2 == 116u8 {
                return true
            }
        }
    }
    false
}

fn validate_archive_path(p: view<[u8]>) -> u32 {
    let n = len(p)
    if n == 0usize {
        return PATH_ERR_EMPTY
    }
    if p[0] == 47u8 || p[0] == 92u8 {
        return PATH_ERR_ABSOLUTE
    }
    if n >= 2usize && p[1] == 58u8 {
        return PATH_ERR_DRIVE
    }
    let mut seg_start: usize = 0usize
    let mut i: usize = 0usize
    while i <= n {
        let is_end = i == n
        let b: u8 = if is_end { 47u8 } else { p[i] }
        if !is_end {
            if b == 0u8 {
                return PATH_ERR_NULL_BYTE
            }
            if b == 92u8 {
                return PATH_ERR_BACKSLASH
            }
        }
        if b == 47u8 {
            let seg_len = i - seg_start
            if seg_len == 2usize && p[seg_start] == 46u8 && p[seg_start + 1usize] == 46u8 {
                return PATH_ERR_TRAVERSAL
            }
            if is_reserved_device_seg(p, seg_start, seg_len) {
                return PATH_ERR_RESERVED_DEVICE
            }
            seg_start = i + 1usize
        }
        i = i + 1usize
    }
    PATH_OK
}

fn verify_sparse_index_path(ns: view<[u8]>, name: view<[u8]>, expected: view<[u8]>) -> bool {
    let name_len = len(name)
    let ns_len = len(ns)
    if name_len == 0usize || ns_len == 0usize {
        return false
    }
    // Prefix: "_1" if 1 char, else first 2 chars of name
    let p2_0: u8 = if name_len == 1usize { 95u8 } else { name[0] } // '_'
    let p2_1: u8 = if name_len == 1usize { 49u8 } else { name[1] } // '1'

    // Total length: "index/" (6) + ns_len + "/" (1) + 2 + "/" (1) + name_len + ".jsonl" (6)
    let total_len = 16usize + ns_len + name_len
    if len(expected) != total_len {
        return false
    }
    // "index/"
    if expected[0] != 105u8 || expected[1] != 110u8 || expected[2] != 100u8 || expected[3] != 101u8 || expected[4] != 120u8 || expected[5] != 47u8 {
        return false
    }
    let mut i: usize = 0usize
    while i < ns_len {
        if expected[6usize + i] != ns[i] {
            return false
        }
        i = i + 1usize
    }
    let p_sep1 = 6usize + ns_len
    if expected[p_sep1] != 47u8 {
        return false
    }
    if expected[p_sep1 + 1usize] != p2_0 || expected[p_sep1 + 2usize] != p2_1 {
        return false
    }
    if expected[p_sep1 + 3usize] != 47u8 {
        return false
    }
    let name_offset = p_sep1 + 4usize
    i = 0usize
    while i < name_len {
        if expected[name_offset + i] != name[i] {
            return false
        }
        i = i + 1usize
    }
    let suf_offset = name_offset + name_len
    if expected[suf_offset] != 46u8 || expected[suf_offset + 1usize] != 106u8 || expected[suf_offset + 2usize] != 115u8 || expected[suf_offset + 3usize] != 111u8 || expected[suf_offset + 4usize] != 110u8 || expected[suf_offset + 5usize] != 108u8 {
        return false
    }
    true
}

const ROUTING_OK: u32 = 0u32
const ROUTING_SHADOW_BLOCKED: u32 = 1u32
const ROUTING_CONFLICTING_PIN: u32 = 2u32
const ROUTING_NOT_FOUND: u32 = 3u32

const NS_AXIOM: u32 = 1u32
const NS_CORP: u32 = 2u32
const NS_COMMUNITY: u32 = 3u32

const REG_CORP_INTERNAL: u32 = 10u32
const REG_PUBLIC_DEFAULT: u32 = 20u32
const REG_UNTRUSTED_MIRROR: u32 = 30u32

@derive(Copy)
struct RegistryConfig {
    id: u32,
    priority: u32,
    pinned_ns: u32,
    trust_level: u32,
    is_quarantined: bool,
}

fn check_conflicting_pins(regs: view<[3]RegistryConfig>, count: usize) -> bool {
    let mut i: usize = 0usize
    while i < count {
        let mut j = i + 1usize
        while j < count {
            let r1 = (*regs)[i]
            let r2 = (*regs)[j]
            if r1.pinned_ns != 0u32 && r1.pinned_ns == r2.pinned_ns && r1.id != r2.id {
                return true
            }
            j = j + 1usize
        }
        i = i + 1usize
    }
    false
}

fn route_package_candidate(
    ns: u32,
    candidate_reg_id: u32,
    regs: view<[3]RegistryConfig>,
    count: usize,
    require_trusted: bool
) -> u32 {
    if check_conflicting_pins(regs, count) {
        return ROUTING_CONFLICTING_PIN
    }
    // 1. Check if namespace is pinned to a specific registry
    let mut pin_owner: u32 = 0u32
    let mut i: usize = 0usize
    while i < count {
        if (*regs)[i].pinned_ns == ns {
            pin_owner = (*regs)[i].id
        }
        i = i + 1usize
    }
    if pin_owner != 0u32 {
        if candidate_reg_id != pin_owner {
            return ROUTING_SHADOW_BLOCKED
        }
        return ROUTING_OK
    }

    // 2. Unpinned namespace
    let mut cand_found = false
    let mut cand_valid = false
    i = 0usize
    while i < count {
        let r = (*regs)[i]
        if r.id == candidate_reg_id {
            cand_found = true
            if !r.is_quarantined {
                if !require_trusted || r.trust_level > 0u32 {
                    cand_valid = true
                }
            }
        }
        i = i + 1usize
    }
    if !cand_found || !cand_valid {
        return ROUTING_NOT_FOUND
    }
    ROUTING_OK
}

const POLICY_OK: u32 = 0u32
const POLICY_BLOCKED_DOWNGRADE: u32 = 1u32
const POLICY_BLOCKED_BELOW_FLOOR: u32 = 2u32

@derive(Copy)
struct SemVer3 {
    major: u32,
    minor: u32,
    patch: u32,
}

fn semver_cmp(a: SemVer3, b: SemVer3) -> i32 {
    if a.major != b.major {
        if (a.major) < (b.major) { -1i32 } else { 1i32 }
    } else if a.minor != b.minor {
        if (a.minor) < (b.minor) { -1i32 } else { 1i32 }
    } else if a.patch != b.patch {
        if (a.patch) < (b.patch) { -1i32 } else { 1i32 }
    } else {
        0i32
    }
}

fn evaluate_version_policy(
    active: SemVer3,
    candidate: SemVer3,
    floor: SemVer3,
    allow_downgrade: bool
) -> u32 {
    if semver_cmp(candidate, floor) < 0i32 {
        return POLICY_BLOCKED_BELOW_FLOOR
    }
    if !allow_downgrade && semver_cmp(candidate, active) < 0i32 {
        return POLICY_BLOCKED_DOWNGRADE
    }
    POLICY_OK
}

pub fn main() -> i32 {
    // 1. Sparse Index Prefix Verification
    let ns_axiom: [5]u8 = [97u8, 120u8, 105u8, 111u8, 109u8] // "axiom"

    // 1-char name: "z" -> "index/axiom/_1/z.jsonl" (22 bytes)
    let name_1: [1]u8 = [122u8] // "z"
    let exp_1: [22]u8 = [
        105u8, 110u8, 100u8, 101u8, 120u8, 47u8, // "index/"
        97u8, 120u8, 105u8, 111u8, 109u8, 47u8,  // "axiom/"
        95u8, 49u8, 47u8,                         // "_1/"
        122u8,                                    // "z"
        46u8, 106u8, 115u8, 111u8, 110u8, 108u8  // ".jsonl"
    ]
    if !verify_sparse_index_path(view(ns_axiom), view(name_1), view(exp_1)) {
        return 1
    }

    // 2-char name: "io" -> "index/axiom/io/io.jsonl" (23 bytes)
    let name_2: [2]u8 = [105u8, 111u8] // "io"
    let exp_2: [23]u8 = [
        105u8, 110u8, 100u8, 101u8, 120u8, 47u8, // "index/"
        97u8, 120u8, 105u8, 111u8, 109u8, 47u8,  // "axiom/"
        105u8, 111u8, 47u8,                       // "io/"
        105u8, 111u8,                             // "io"
        46u8, 106u8, 115u8, 111u8, 110u8, 108u8  // ".jsonl"
    ]
    if !verify_sparse_index_path(view(ns_axiom), view(name_2), view(exp_2)) {
        return 2
    }

    // 3-char name: "net" -> "index/axiom/ne/net.jsonl" (24 bytes)
    let name_3: [3]u8 = [110u8, 101u8, 116u8] // "net"
    let exp_3: [24]u8 = [
        105u8, 110u8, 100u8, 101u8, 120u8, 47u8, // "index/"
        97u8, 120u8, 105u8, 111u8, 109u8, 47u8,  // "axiom/"
        110u8, 101u8, 47u8,                       // "ne/"
        110u8, 101u8, 116u8,                      // "net"
        46u8, 106u8, 115u8, 111u8, 110u8, 108u8  // ".jsonl"
    ]
    if !verify_sparse_index_path(view(ns_axiom), view(name_3), view(exp_3)) {
        return 3
    }

    // 5-char name: "crypt" -> "index/axiom/cr/crypt.jsonl" (26 bytes)
    let name_5: [5]u8 = [99u8, 114u8, 121u8, 112u8, 116u8] // "crypt"
    let exp_5: [26]u8 = [
        105u8, 110u8, 100u8, 101u8, 120u8, 47u8, // "index/"
        97u8, 120u8, 105u8, 111u8, 109u8, 47u8,  // "axiom/"
        99u8, 114u8, 47u8,                        // "cr/"
        99u8, 114u8, 121u8, 112u8, 116u8,         // "crypt"
        46u8, 106u8, 115u8, 111u8, 110u8, 108u8  // ".jsonl"
    ]
    if !verify_sparse_index_path(view(ns_axiom), view(name_5), view(exp_5)) {
        return 4
    }

    // 2. Extraction Sandbox & Path Validation
    let p_clean: [10]u8 = [115u8, 114u8, 99u8, 47u8, 108u8, 105u8, 98u8, 46u8, 97u8, 120u8] // "src/lib.ax"
    if validate_archive_path(view(p_clean)) != PATH_OK {
        return 5
    }

    let p_abs: [11]u8 = [47u8, 101u8, 116u8, 99u8, 47u8, 112u8, 97u8, 115u8, 115u8, 119u8, 100u8] // "/etc/passwd"
    if validate_archive_path(view(p_abs)) != PATH_ERR_ABSOLUTE {
        return 6
    }

    let p_bs: [11]u8 = [115u8, 114u8, 99u8, 92u8, 109u8, 97u8, 105u8, 110u8, 46u8, 97u8, 120u8] // "src\main.ax"
    if validate_archive_path(view(p_bs)) != PATH_ERR_BACKSLASH {
        return 7
    }

    let p_drv: [14]u8 = [68u8, 58u8, 47u8, 112u8, 114u8, 111u8, 106u8, 47u8, 108u8, 105u8, 98u8, 46u8, 97u8, 120u8] // "D:/proj/lib.ax"
    if validate_archive_path(view(p_drv)) != PATH_ERR_DRIVE {
        return 8
    }

    let p_trav: [15]u8 = [102u8, 111u8, 111u8, 47u8, 46u8, 46u8, 47u8, 46u8, 46u8, 47u8, 98u8, 97u8, 114u8, 46u8, 97u8] // "foo/../../bar.a"
    if validate_archive_path(view(p_trav)) != PATH_ERR_TRAVERSAL {
        return 9
    }

    let p_null: [10]u8 = [115u8, 114u8, 99u8, 47u8, 108u8, 0u8, 98u8, 46u8, 97u8, 120u8] // "src/l\0b.ax"
    if validate_archive_path(view(p_null)) != PATH_ERR_NULL_BYTE {
        return 10
    }

    // Reserved Windows devices
    let p_con: [3]u8 = [99u8, 111u8, 110u8] // "con"
    if validate_archive_path(view(p_con)) != PATH_ERR_RESERVED_DEVICE {
        return 11
    }

    let p_aux_ext: [6]u8 = [97u8, 117u8, 120u8, 46u8, 97u8, 120u8] // "aux.ax"
    if validate_archive_path(view(p_aux_ext)) != PATH_ERR_RESERVED_DEVICE {
        return 12
    }

    let p_nul_sub: [11]u8 = [115u8, 117u8, 98u8, 47u8, 78u8, 85u8, 76u8, 46u8, 116u8, 120u8, 116u8] // "sub/NUL.txt"
    if validate_archive_path(view(p_nul_sub)) != PATH_ERR_RESERVED_DEVICE {
        return 13
    }

    let p_com1: [8]u8 = [112u8, 107u8, 103u8, 47u8, 99u8, 111u8, 109u8, 49u8] // "pkg/com1"
    if validate_archive_path(view(p_com1)) != PATH_ERR_RESERVED_DEVICE {
        return 14
    }

    let p_lpt9: [12]u8 = [112u8, 107u8, 103u8, 47u8, 76u8, 80u8, 84u8, 57u8, 46u8, 100u8, 97u8, 116u8] // "pkg/LPT9.dat"
    if validate_archive_path(view(p_lpt9)) != PATH_ERR_RESERVED_DEVICE {
        return 15
    }

    // 3. Multi-Repository Namespace Pinning & Shadow Defense
    let reg1 = RegistryConfig {
        id: REG_CORP_INTERNAL,
        priority: 100u32,
        pinned_ns: NS_CORP,
        trust_level: 2u32,
        is_quarantined: false,
    }
    let reg2 = RegistryConfig {
        id: REG_PUBLIC_DEFAULT,
        priority: 10u32,
        pinned_ns: NS_AXIOM,
        trust_level: 1u32,
        is_quarantined: false,
    }
    let reg3 = RegistryConfig {
        id: REG_UNTRUSTED_MIRROR,
        priority: 50u32,
        pinned_ns: 0u32,
        trust_level: 0u32,
        is_quarantined: false,
    }

    let regs: [3]RegistryConfig = [reg1, reg2, reg3]

    // Correct lookup for pinned namespace
    if route_package_candidate(NS_CORP, REG_CORP_INTERNAL, view(regs), 3usize, true) != ROUTING_OK {
        return 16
    }
    // Dependency-confusion shadow attack blocked: public registry attempting to serve corp package
    if route_package_candidate(NS_CORP, REG_PUBLIC_DEFAULT, view(regs), 3usize, true) != ROUTING_SHADOW_BLOCKED {
        return 17
    }
    // Reverse shadow attack blocked: corp registry attempting to serve axiom package
    if route_package_candidate(NS_AXIOM, REG_CORP_INTERNAL, view(regs), 3usize, true) != ROUTING_SHADOW_BLOCKED {
        return 18
    }
    // Unpinned community namespace through public registry
    if route_package_candidate(NS_COMMUNITY, REG_PUBLIC_DEFAULT, view(regs), 3usize, true) != ROUTING_OK {
        return 19
    }
    // Unpinned community namespace through untrusted registry when require_trusted is true
    if route_package_candidate(NS_COMMUNITY, REG_UNTRUSTED_MIRROR, view(regs), 3usize, true) != ROUTING_NOT_FOUND {
        return 20
    }

    // Conflicting pin configuration
    let reg_conflicting = RegistryConfig {
        id: 99u32,
        priority: 200u32,
        pinned_ns: NS_CORP, // duplicates reg1!
        trust_level: 2u32,
        is_quarantined: false,
    }
    let conflict_regs: [3]RegistryConfig = [reg1, reg_conflicting, reg3]
    if route_package_candidate(NS_CORP, REG_CORP_INTERNAL, view(conflict_regs), 3usize, true) != ROUTING_CONFLICTING_PIN {
        return 21
    }

    // 4. SemVer Floor & Downgrade Prevention
    let v_active = SemVer3 { major: 2u32, minor: 1u32, patch: 0u32 }
    let v_floor = SemVer3 { major: 2u32, minor: 0u32, patch: 1u32 }

    let v_upgrade = SemVer3 { major: 2u32, minor: 1u32, patch: 2u32 }
    let v_downgrade = SemVer3 { major: 2u32, minor: 0u32, patch: 5u32 }
    let v_below_floor = SemVer3 { major: 1u32, minor: 9u32, patch: 0u32 }

    // Upgrade is allowed
    if evaluate_version_policy(v_active, v_upgrade, v_floor, false) != POLICY_OK {
        return 22
    }
    // Downgrade blocked when allow_downgrade = false
    if evaluate_version_policy(v_active, v_downgrade, v_floor, false) != POLICY_BLOCKED_DOWNGRADE {
        return 23
    }
    // Below floor blocked regardless
    if evaluate_version_policy(v_active, v_below_floor, v_floor, false) != POLICY_BLOCKED_BELOW_FLOOR {
        return 24
    }
    // When allow_downgrade = true, downgrade above floor is allowed
    if evaluate_version_policy(v_active, v_downgrade, v_floor, true) != POLICY_OK {
        return 25
    }
    // But below floor is STILL blocked even when allow_downgrade = true
    if evaluate_version_policy(v_active, v_below_floor, v_floor, true) != POLICY_BLOCKED_BELOW_FLOOR {
        return 26
    }

    print("ADVERSARIAL-SPARSE-INDEX-AND-DEVICE-SANDBOX-OK\n")
    0
}
