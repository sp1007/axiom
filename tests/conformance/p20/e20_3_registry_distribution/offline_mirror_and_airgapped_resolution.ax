// test: run
// modes: interp native
// stdout-file: offline_mirror_and_airgapped_resolution.stdout
// SPEC-112 §§1, 4 (AXS-REG-001, AXS-REG-030, AXS-REG-032; REQ-PKG-013, REQ-PKG-024, REQ-ECO-8736, PKG-INV-34):
// Conformance test verifying:
// 1. Offline repository mirror structure (`config.json`, sparse index, content-addressed blobs).
// 2. Content-identity preservation across mirror endpoints (physical mirror URL never alters PackageIdentity or lockfile).
// 3. Air-gapped --offline execution with zero network dependency.
// 4. Local cache hierarchy and offline missing package detection (`offline_missing_package`).

const OFFLINE_OK: u32 = 0u32
const OFFLINE_MISSING_PKG: u32 = 1u32
const OFFLINE_NET_VIOLATION: u32 = 2u32

@derive(Copy)
struct Hash256 {
    w0: u64,
    w1: u64,
    w2: u64,
    w3: u64,
}

fn hash256_eq(a: Hash256, b: Hash256) -> bool {
    a.w0 == b.w0 && a.w1 == b.w1 && a.w2 == b.w2 && a.w3 == b.w3
}

// Canonical 7-tuple PackageIdentity (SPEC-111 AXS-PKG-002 / SPEC-112 AXS-REG-002 §1)
// Notice: physical repository URL is NOT part of PackageIdentity!
@derive(Copy)
struct PackageIdentity {
    registry_id: u32,
    namespace_id: u32,
    name_id: u32,
    major: u32,
    minor: u32,
    patch: u32,
    source_kind: u32, // 1 = Registry
    content_hash: Hash256,
    sif: Hash256,
}

fn pkg_identity_eq(a: PackageIdentity, b: PackageIdentity) -> bool {
    a.registry_id == b.registry_id &&
    a.namespace_id == b.namespace_id &&
    a.name_id == b.name_id &&
    a.major == b.major &&
    a.minor == b.minor &&
    a.patch == b.patch &&
    a.source_kind == b.source_kind &&
    hash256_eq(a.content_hash, b.content_hash) &&
    hash256_eq(a.sif, b.sif)
}

// Mirror repository descriptor
@derive(Copy)
struct MirrorRepo {
    registry_id: u32,
    root_url_kind: u32, // 1 = HTTPS, 2 = LocalFile
    has_config_json: bool,
    protocol_version: u32,
    index_snapshot_hash: Hash256,
    blob_count: usize,
}

// Simulates resolving dependencies from mirror or local cache under --offline
fn resolve_offline_package(
    is_offline: bool,
    has_net_access: bool,
    in_local_cache: bool,
    in_mirror_blobs: bool,
    out_status: mut_view<u32>
) -> bool {
    if is_offline && has_net_access {
        *out_status = OFFLINE_NET_VIOLATION
        return false
    }

    if in_local_cache || in_mirror_blobs {
        *out_status = OFFLINE_OK
        return true
    }

    if is_offline {
        *out_status = OFFLINE_MISSING_PKG
        return false
    }

    // Online resolution would fetch from remote
    *out_status = OFFLINE_OK
    true
}

pub fn main() -> i32 {
    let sha_crypto = Hash256 { w0: 0x1111222233334444u64, w1: 0x5555666677778888u64, w2: 0x9999AAAABBBBCCCCu64, w3: 0xDDDDEEEEFFFF0000u64 }
    let sif_crypto = Hash256 { w0: 0x0001000200030004u64, w1: 0x0005000600070008u64, w2: 0x0009000A000B000Cu64, w3: 0x000D000E000F0010u64 }

    // 1. PackageIdentity invariance across online upstream vs offline mirror
    // Online upstream: https://registry.axiom-lang.org
    let id_upstream = PackageIdentity {
        registry_id: 1u32, // "default"
        namespace_id: 10u32, // "axiom"
        name_id: 100u32, // "crypto"
        major: 1u32,
        minor: 4u32,
        patch: 2u32,
        source_kind: 1u32,
        content_hash: sha_crypto,
        sif: sif_crypto,
    }

    // Offline mirror: file://D:/mirrors/axiom_mirror
    let id_mirror = PackageIdentity {
        registry_id: 1u32, // "default" — same logical registry authority!
        namespace_id: 10u32,
        name_id: 100u32,
        major: 1u32,
        minor: 4u32,
        patch: 2u32,
        source_kind: 1u32,
        content_hash: sha_crypto,
        sif: sif_crypto,
    }

    // Must be bit-for-bit identical! URL differences do not touch identity or lockfile.
    if !pkg_identity_eq(id_upstream, id_mirror) {
        return 1
    }

    // 2. Validate mirror protocol configuration (protocol_version = 1)
    let snapshot_hash = Hash256 { w0: 0x7F83B1657FF1FC53u64, w1: 0xB92DC18148A1D65Du64, w2: 0xFC2D4B1FA3D67728u64, w3: 0x4ADDD200126D9069u64 }
    let mirror = MirrorRepo {
        registry_id: 1u32,
        root_url_kind: 2u32, // LocalFile
        has_config_json: true,
        protocol_version: 1u32,
        index_snapshot_hash: snapshot_hash,
        blob_count: 42usize,
    }

    if !mirror.has_config_json || mirror.protocol_version != 1u32 || mirror.blob_count != 42usize {
        return 2
    }

    // 3. Air-gapped resolution with package present in mirror: succeeds with zero network access
    let mut st1: u32 = 0u32
    let res1 = resolve_offline_package(true, false, false, true, mut_view(st1))
    if !res1 || st1 != OFFLINE_OK {
        return 3
    }

    // 4. Air-gapped resolution with package present in local cache (.axiom/cache/pkg/): succeeds with zero network access
    let mut st2: u32 = 0u32
    let res2 = resolve_offline_package(true, false, true, false, mut_view(st2))
    if !res2 || st2 != OFFLINE_OK {
        return 4
    }

    // 5. Air-gapped resolution with missing package: cleanly rejected with OFFLINE_MISSING_PKG
    let mut st3: u32 = 0u32
    let res3 = resolve_offline_package(true, false, false, false, mut_view(st3))
    if res3 || st3 != OFFLINE_MISSING_PKG {
        return 5
    }

    // 6. Offline mode with illegal network attempt: flagged as violation
    let mut st4: u32 = 0u32
    let res4 = resolve_offline_package(true, true, false, true, mut_view(st4))
    if res4 || st4 != OFFLINE_NET_VIOLATION {
        return 6
    }

    print("OFFLINE-MIRROR-AND-AIRGAPPED-RESOLUTION-OK\n")
    0
}
