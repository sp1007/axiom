fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn new_diag_sink() -> DiagSink {
    let mut sink = DiagSink {
        arena: (query_db_empty()).arena,
        diags: 0 as *mut compiler.diag.emitter.Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
    diag_sink_init(mut_view(sink))
    sink
}

// =============================================================================
// Probe 1: SHA-256 Engine, Path Traversal Defenses, Packaging & Merkle Roots
// =============================================================================

fn run_archive_sha256_probe() -> bool {
    // 1. Known SHA-256 test vectors: "abc"
    let d_abc = sha256_hash_sv(lsv_from_str("abc"))
    let mut hex_buf = lock_buf_new()
    lock_buf_init(mut_view(hex_buf))
    sha256_digest_format_hex(view(d_abc), mut_view(hex_buf))
    let hex_sv = lock_buf_as_lsv(view(hex_buf))
    let sha256_ok = lsv_eq_str(hex_sv, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    lock_buf_free(mut_view(hex_buf))

    // 2. Path safety checks
    let safe_p = check_axpkg_path_safety(lsv_from_str("src/lib.ax")) == ARCHIVE_STATUS_OK
    let abs_p1 = check_axpkg_path_safety(lsv_from_str("/etc/passwd")) == ARCHIVE_STATUS_PATH_TRAVERSAL
    let abs_p2 = check_axpkg_path_safety(lsv_from_str("\\Windows\\System32")) == ARCHIVE_STATUS_PATH_TRAVERSAL
    let trav_p = check_axpkg_path_safety(lsv_from_str("../src/lib.ax")) == ARCHIVE_STATUS_PATH_TRAVERSAL
    let drive_p = check_axpkg_path_safety(lsv_from_str("C:/test.ax")) == ARCHIVE_STATUS_PATH_TRAVERSAL
    let path_safety_ok = safe_p && abs_p1 && abs_p2 && trav_p && drive_p

    // 3. Case collision detection
    let coll_yes = check_path_case_collision(lsv_from_str("src/lib.ax"), lsv_from_str("src/Lib.ax"))
    let coll_no = !check_path_case_collision(lsv_from_str("src/lib.ax"), lsv_from_str("src/mod.ax"))
    let case_collision_ok = coll_yes && coll_no

    // 4. Pack and verify archive container
    let mut arc = AxpkgArchive {
        artifact_kind: ARTIFACT_KIND_SOURCE,
        manifest: lsv_from_str("[package]\nname = \"demo\"\nversion = \"0.1.0\"\n"),
        iface_summary: lsv_from_str("IFACE_SUMMARY_DEMO"),
        provenance: lsv_from_str("PROV01_TEST"),
        entries: [axpkg_entry_empty(); 32],
        entry_count: 0usize,
        merkle_root: sha256_digest_zero(),
    }
    axpkg_archive_init(mut_view(arc))
    arc.manifest = lsv_from_str("[package]\nname = \"demo\"\nversion = \"0.1.0\"\n")
    arc.iface_summary = lsv_from_str("IFACE_SUMMARY_DEMO")

    let add_ok = axpkg_archive_add_entry(
        mut_view(arc),
        lsv_from_str("src/lib.ax"),
        0u8,
        lsv_from_str("pub fn demo_fn() -> i32 { 42 }\n")
    ) == ARCHIVE_STATUS_OK

    let mut pack_buf = lock_buf_new()
    lock_buf_init(mut_view(pack_buf))
    let pack_st = pack_axpkg(mut_view(arc), mut_view(pack_buf))
    let pack_ok = pack_st == ARCHIVE_STATUS_OK

    let packed_bytes = lock_buf_as_lsv(view(pack_buf))
    let verify_st = verify_axpkg(packed_bytes, view(arc.merkle_root))
    let pack_verify_ok = add_ok && pack_ok && (verify_st == ARCHIVE_STATUS_OK)

    // 5. Tamper detection: mutate a payload byte and verify rejection
    let mut tampered_buf = lock_buf_new()
    lock_buf_init(mut_view(tampered_buf))
    lock_buf_push_sv(mut_view(tampered_buf), packed_bytes)
    // Mutate one byte in packed container
    if tampered_buf.len > 100usize {
        unsafe {
            let p_mut = tampered_buf.ptr + 100usize
            *p_mut = (*p_mut) ^ 0xFFu8
        }
    }
    let tampered_bytes = lock_buf_as_lsv(view(tampered_buf))
    let tamper_st = verify_axpkg(tampered_bytes, view(arc.merkle_root))
    let tamper_detected = tamper_st != ARCHIVE_STATUS_OK

    lock_buf_free(mut_view(pack_buf))
    lock_buf_free(mut_view(tampered_buf))

    out_str("probe[archive_sha256] sha256_ok=")
    out_bool(sha256_ok)
    out_str(" path_safety_ok=")
    out_bool(path_safety_ok)
    out_str(" case_collision_ok=")
    out_bool(case_collision_ok)
    out_str(" pack_verify_ok=")
    out_bool(pack_verify_ok)
    out_str(" tamper_detected=")
    out_bool(tamper_detected)
    out_str("\n")

    sha256_ok && path_safety_ok && case_collision_ok && pack_verify_ok && tamper_detected
}

// =============================================================================
// Probe 2: Sparse Index Protocol, Path Formats, JSON Lines, Version Resolution
// =============================================================================

fn run_sparse_registry_probe() -> bool {
    // 1. Index relative path format
    let mut p_buf = lock_buf_new()
    lock_buf_init(mut_view(p_buf))
    format_sparse_index_rel_path(lsv_from_str("default"), lsv_from_str("crypto"), mut_view(p_buf))
    let p_sv1 = lock_buf_as_lsv(view(p_buf))
    let index_p1_ok = lsv_eq_str(p_sv1, "index/default/cr/crypto.jsonl")

    let mut p_buf2 = lock_buf_new()
    lock_buf_init(mut_view(p_buf2))
    format_sparse_index_rel_path(lsv_from_str("axiom"), lsv_from_str("z"), mut_view(p_buf2))
    let p_sv2 = lock_buf_as_lsv(view(p_buf2))
    let index_p2_ok = lsv_eq_str(p_sv2, "index/axiom/_1/z.jsonl")
    let index_path_ok = index_p1_ok && index_p2_ok
    lock_buf_free(mut_view(p_buf))
    lock_buf_free(mut_view(p_buf2))

    // 2. Blob relative path format
    let sha_hex = lsv_from_str("2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae")
    let mut b_buf = lock_buf_new()
    lock_buf_init(mut_view(b_buf))
    let b_ok = format_registry_blob_rel_path(sha_hex, mut_view(b_buf))
    let b_sv = lock_buf_as_lsv(view(b_buf))
    let blob_path_ok = b_ok && lsv_starts_with_str(b_sv, "blobs/sha256/2c/26/")
    lock_buf_free(mut_view(b_buf))

    // 3. Config JSON format
    let mut cfg_buf = lock_buf_new()
    lock_buf_init(mut_view(cfg_buf))
    format_registry_config_json(lsv_from_str("default"), lsv_from_str("sha256:7f83..."), mut_view(cfg_buf))
    let cfg_sv = lock_buf_as_lsv(view(cfg_buf))
    let config_json_ok = lsv_starts_with_str(cfg_sv, "{\n  \"protocol_version\": 1")
    lock_buf_free(mut_view(cfg_buf))

    // 4. Line roundtrip
    let mut pv = registry_package_version_empty()
    pv.semver_raw = lsv_from_str("1.4.2")
    let mut sv_p = lock_semver_zero()
    let _ = parse_lock_semver(pv.semver_raw, mut_view(sv_p))
    pv.semver = sv_p
    pv.namespace = lsv_from_str("axiom")
    pv.name = lsv_from_str("crypto")
    pv.sha256_hex = sha_hex
    pv.merkle_root_hex = sha_hex
    pv.mode = lsv_from_str("hybrid")
    pv.channel = lsv_from_str("stable")

    let mut line_buf = lock_buf_new()
    lock_buf_init(mut_view(line_buf))
    format_sparse_index_line(view(pv), mut_view(line_buf))
    let line_sv = lock_buf_as_lsv(view(line_buf))

    let mut parsed_pv = registry_package_version_empty()
    let line_parsed_ok = parse_sparse_index_line(line_sv, mut_view(parsed_pv))
    let line_roundtrip_ok = line_parsed_ok &&
        lsv_eq_str(parsed_pv.semver_raw, "1.4.2") &&
        lsv_eq_str(parsed_pv.name, "crypto") &&
        lsv_eq_str(parsed_pv.channel, "stable")
    lock_buf_free(mut_view(line_buf))

    // 5. Multi-line parse and query best version
    let mut s_buf = lock_buf_new()
    lock_buf_init(mut_view(s_buf))
    lock_buf_push_str(mut_view(s_buf), "{\"v\":\"1.4.0\",\"ns\":\"axiom\",\"name\":\"crypto\",\"sha256\":\"abc\",\"channel\":\"stable\",\"yanked\":false,\"quarantined\":false}\n")
    lock_buf_push_str(mut_view(s_buf), "{\"v\":\"1.4.1\",\"ns\":\"axiom\",\"name\":\"crypto\",\"sha256\":\"def\",\"channel\":\"stable\",\"yanked\":true,\"quarantined\":false}\n")
    lock_buf_push_str(mut_view(s_buf), "{\"v\":\"1.4.2\",\"ns\":\"axiom\",\"name\":\"crypto\",\"sha256\":\"2c26\",\"channel\":\"stable\",\"yanked\":false,\"quarantined\":false}\n")
    lock_buf_push_str(mut_view(s_buf), "{\"v\":\"1.5.0\",\"ns\":\"axiom\",\"name\":\"crypto\",\"sha256\":\"ghi\",\"channel\":\"beta\",\"yanked\":false,\"quarantined\":false}\n")
    lock_buf_push_str(mut_view(s_buf), "{\"v\":\"2.0.0\",\"ns\":\"axiom\",\"name\":\"crypto\",\"sha256\":\"bad\",\"channel\":\"stable\",\"yanked\":false,\"quarantined\":true}\n")
    let sample_index = lock_buf_as_lsv(view(s_buf))

    let mut vers: [16]RegistryPackageVersion = [registry_package_version_empty(); 16]
    let mut count: usize = 0usize
    let parse_file_ok = parse_sparse_index_file(sample_index, mut_view(vers), mut_view(count))

    let mut best_stable = registry_package_version_empty()
    let q_st = query_sparse_index_best_version(view(vers), count, lsv_from_str("stable"), false, mut_view(best_stable))
    // Must select 1.4.2 (skipping 1.4.1 yanked, 1.5.0 beta, 2.0.0 quarantined)
    let sort_and_query_ok = parse_file_ok && (q_st == REG_STATUS_OK) && lsv_eq_str(best_stable.semver_raw, "1.4.2")
    lock_buf_free(mut_view(s_buf))

    out_str("probe[sparse_registry] index_path_ok=")
    out_bool(index_path_ok)
    out_str(" blob_path_ok=")
    out_bool(blob_path_ok)
    out_str(" config_json_ok=")
    out_bool(config_json_ok)
    out_str(" line_roundtrip_ok=")
    out_bool(line_roundtrip_ok)
    out_str(" sort_and_query_ok=")
    out_bool(sort_and_query_ok)
    out_str("\n")

    index_path_ok && blob_path_ok && config_json_ok && line_roundtrip_ok && sort_and_query_ok
}

// =============================================================================
// Probe 3: Immutability Checks & Merkle Tamper Detection
// =============================================================================

fn run_immutability_tamper_probe() -> bool {
    let mut existing_v: [16]RegistryPackageVersion = [registry_package_version_empty(); 16]
    let mut existing_count: usize = 0usize

    let sample = lsv_from_str(
        "{\"v\":\"1.4.2\",\"ns\":\"axiom\",\"name\":\"crypto\",\"sha256\":\"2c26b4\",\"merkle_root\":\"2c26b4\",\"sif\":\"sif1\",\"channel\":\"stable\",\"yanked\":false,\"quarantined\":false}\n"
    )
    let _ = parse_sparse_index_file(sample, mut_view(existing_v), mut_view(existing_count))

    // 1. Republish with exact same digests -> ALREADY_PUBLISHED_IDENTICAL
    let mut cand_ident = registry_package_version_empty()
    cand_ident.namespace = lsv_from_str("axiom")
    cand_ident.name = lsv_from_str("crypto")
    cand_ident.semver_raw = lsv_from_str("1.4.2")
    let mut sem = lock_semver_zero()
    let _ = parse_lock_semver(cand_ident.semver_raw, mut_view(sem))
    cand_ident.semver = sem
    cand_ident.sha256_hex = lsv_from_str("2c26b4")
    cand_ident.merkle_root_hex = lsv_from_str("2c26b4")
    cand_ident.sif = lsv_from_str("sif1")

    let st_ident = check_registry_publication_immutability(view(existing_v), existing_count, view(cand_ident))
    let idempotent_republish_ok = st_ident == REG_STATUS_ALREADY_PUBLISHED_IDENTICAL

    // 2. Republish with altered sha256 -> IMMUTABLE_VERSION_EXISTS
    let mut cand_diff = cand_ident
    cand_diff.sha256_hex = lsv_from_str("DIFFERENT_SHA256")
    let st_diff = check_registry_publication_immutability(view(existing_v), existing_count, view(cand_diff))
    let immutable_enforced = st_diff == REG_STATUS_IMMUTABLE_VERSION_EXISTS

    // 3. Tamper detection via verify_axpkg
    let zero_d = sha256_digest_zero()
    let corrupt_bytes = lsv_from_str("NOT_AN_AXPKG_CONTAINER_BYTES_HERE")
    let tamper_detected = verify_axpkg(corrupt_bytes, view(zero_d)) != ARCHIVE_STATUS_OK

    out_str("probe[immutability_tamper] immutable_enforced=")
    out_bool(immutable_enforced)
    out_str(" idempotent_republish_ok=")
    out_bool(idempotent_republish_ok)
    out_str(" tamper_detected=")
    out_bool(tamper_detected)
    out_str("\n")

    immutable_enforced && idempotent_republish_ok && tamper_detected
}

// =============================================================================
// Probe 4: Precompiled .axmeta Binary Consumption & Popcount Slice Selection
// =============================================================================

fn run_distribution_consumption_probe() -> bool {
    let abi_main = AbiFingerprint { lo: 0x11112222u64, hi: 0x33334444u64 }
    let abi_other = AbiFingerprint { lo: 0x99998888u64, hi: 0x77776666u64 }
    let sif_main = SemanticFingerprint { lo: 0xAAAAu64, hi: 0xBBBBu64 }

    // 1. Source-only mode
    let mut cat_source = binary_package_catalog_empty()
    cat_source.distribution_mode = DIST_MODE_SOURCE
    let dec_src = decide_package_consumption(
        view(cat_source),
        dist_sv("x86_64-windows"),
        0x3u64,
        view(abi_main),
        view(sif_main),
        false
    )
    let source_mode_ok = dec_src.action == ACTION_COMPILE_SOURCE

    // 2. Binary slice selection & popcount specificity
    let mut cat_bin = binary_package_catalog_empty()
    cat_bin.distribution_mode = DIST_MODE_BINARY
    cat_bin.interface_summary.is_valid = true
    cat_bin.interface_summary.semantic_interface_fingerprint = sif_main

    // Slice 0: baseline (popcount 0)
    let mut sl0 = binary_slice_descriptor_empty()
    sl0.target_triple = dist_sv("x86_64-windows")
    sl0.cpu_variant = dist_sv("baseline")
    sl0.cpu_feature_mask = 0u64
    sl0.abi_fingerprint = abi_main
    cat_bin.slices[0] = sl0

    // Slice 1: avx2 (cpu mask = 0x3, popcount = 2)
    let mut sl1 = binary_slice_descriptor_empty()
    sl1.target_triple = dist_sv("x86_64-windows")
    sl1.cpu_variant = dist_sv("avx2")
    sl1.cpu_feature_mask = 0x3u64
    sl1.abi_fingerprint = abi_main
    cat_bin.slices[1] = sl1
    cat_bin.slice_count = 2usize

    // Host has avx2 features (0x3): selects slice 1
    let dec_bin = decide_package_consumption(
        view(cat_bin),
        dist_sv("x86_64-windows"),
        0x3u64,
        view(abi_main),
        view(sif_main),
        true
    )
    let binary_select_ok = dec_bin.action == ACTION_USE_BINARY && dec_bin.selected_slice_idx == 1usize
    let popcount_ok = popcount_u64(0x3u64) == 2u32 && popcount_u64(0u64) == 0u32

    // 3. Hybrid fallback to bundled source when binary slice doesn't match
    let mut cat_hybrid = cat_bin
    cat_hybrid.distribution_mode = DIST_MODE_HYBRID
    cat_hybrid.has_source_tree = true
    // Target linux has no slice in catalog
    let dec_hybrid = decide_package_consumption(
        view(cat_hybrid),
        dist_sv("x86_64-linux"),
        0x3u64,
        view(abi_main),
        view(sif_main),
        false
    )
    let hybrid_fallback_ok = dec_hybrid.action == ACTION_COMPILE_SOURCE

    // 4. Binary-only package on ABI mismatch: strictly rejected
    let dec_abi_rej = decide_package_consumption(
        view(cat_bin),
        dist_sv("x86_64-windows"),
        0x3u64,
        view(abi_other),
        view(sif_main),
        true
    )
    let abi_mismatch_rejected = dec_abi_rej.action == ACTION_REJECT

    // 5. Quarantined package rejection
    let mut cat_quar = cat_bin
    cat_quar.is_quarantined = true
    let dec_quar = decide_package_consumption(
        view(cat_quar),
        dist_sv("x86_64-windows"),
        0x3u64,
        view(abi_main),
        view(sif_main),
        false
    )
    let quarantined_rejected = dec_quar.action == ACTION_REJECT

    out_str("probe[distribution_consumption] source_mode_ok=")
    out_bool(source_mode_ok)
    out_str(" binary_select_ok=")
    out_bool(binary_select_ok)
    out_str(" popcount_ok=")
    out_bool(popcount_ok)
    out_str(" hybrid_fallback_ok=")
    out_bool(hybrid_fallback_ok)
    out_str(" abi_mismatch_rejected=")
    out_bool(abi_mismatch_rejected)
    out_str(" quarantined_rejected=")
    out_bool(quarantined_rejected)
    out_str("\n")

    source_mode_ok && binary_select_ok && popcount_ok && hybrid_fallback_ok && abi_mismatch_rejected && quarantined_rejected
}

// =============================================================================
// Probe 5: Multi-Repository Priority Routing & Namespace Pinning
// =============================================================================

fn run_multi_repo_pinning_probe() -> bool {
    let mut table = multi_repo_routing_table_empty()

    // Reg 0: corp_internal, priority 100, pinned = ["corp", "sec"]
    let mut reg0 = registry_config_empty()
    reg0.id = dist_sv("corp_internal")
    reg0.priority = 100u32
    reg0.trust_policy = TRUST_POLICY_ENTERPRISE_VERIFIED
    reg0.pinned_namespaces[0] = dist_sv("corp")
    reg0.pinned_namespaces[1] = dist_sv("sec")
    reg0.pinned_count = 2usize
    let mut d_kind = dist_sv_empty()
    let _ = routing_table_add_registry(mut_view(table), view(reg0), mut_view(d_kind))

    // Reg 1: public_default, priority 10, pinned = ["axiom"]
    let mut reg1 = registry_config_empty()
    reg1.id = dist_sv("public_default")
    reg1.priority = 10u32
    reg1.trust_policy = TRUST_POLICY_PUBLIC_STANDARD
    reg1.pinned_namespaces[0] = dist_sv("axiom")
    reg1.pinned_count = 1usize
    let _ = routing_table_add_registry(mut_view(table), view(reg1), mut_view(d_kind))

    // 1. Conflicting pin attempt: Reg 2 attempts to pin "corp" -> rejected
    let mut reg2 = registry_config_empty()
    reg2.id = dist_sv("other_reg")
    reg2.pinned_namespaces[0] = dist_sv("corp")
    reg2.pinned_count = 1usize
    let add_reg2_ok = routing_table_add_registry(mut_view(table), view(reg2), mut_view(d_kind))
    let conflicting_pin_rejected = !add_reg2_ok && dist_sv_eq(d_kind, dist_sv("conflicting_namespace_pin"))

    // 2. Dependency confusion / namespace shadow defense:
    // Pinned namespace "corp": candidate "corp_internal" -> allowed
    let mut exp_reg = dist_sv_empty()
    let shadow_ok = check_shadow_defense(view(table), dist_sv("corp_internal"), dist_sv("corp"), dist_sv("crypto"), mut_view(exp_reg))
    // Pinned namespace "corp": candidate "public_default" -> BLOCKED!
    let shadow_blocked = !check_shadow_defense(view(table), dist_sv("public_default"), dist_sv("corp"), dist_sv("crypto"), mut_view(exp_reg)) &&
        dist_sv_eq(exp_reg, dist_sv("corp_internal"))

    // 3. Routing table lookups
    let route_pinned = route_package_lookup(view(table), dist_sv("corp"), dist_sv("auth"))
    let pin_routing_ok = route_pinned.status == ROUTING_PINNED && dist_sv_eq(route_pinned.target_registry_id, dist_sv("corp_internal"))

    // Unpinned namespace routes by priority to "corp_internal" (100 > 10)
    let route_unpinned = route_package_lookup(view(table), dist_sv("community"), dist_sv("tool"))
    let priority_routing_ok = dist_sv_eq(route_unpinned.target_registry_id, dist_sv("corp_internal"))

    out_str("probe[multi_repo_pinning] pin_routing_ok=")
    out_bool(pin_routing_ok)
    out_str(" shadow_blocked=")
    out_bool(shadow_blocked)
    out_str(" conflicting_pin_rejected=")
    out_bool(conflicting_pin_rejected)
    out_str(" priority_routing_ok=")
    out_bool(priority_routing_ok)
    out_str("\n")

    pin_routing_ok && shadow_blocked && conflicting_pin_rejected && priority_routing_ok
}

// =============================================================================
// Probe 6: Transactional Package Installation, .axupdate-journal & Safe Rollback
// =============================================================================

fn run_transactional_rollback_probe() -> bool {
    let mut store: RegistryStore = RegistryStore {
        root: lsv_empty(),
        active_generation: 0u32,
        prev_generation: 0u32,
        min_allowed_version: lock_semver_zero(),
        allow_downgrade: false,
        journal_state: 0u32,
        journal_tx_id: lsv_empty(),
        installed_names: [lsv_empty(); 8],
        installed_versions: [lock_semver_zero(); 8],
        installed_roots: [lsv_empty(); 8],
        installed_count: 0usize,
    }
    registry_store_init(mut_view(store), lsv_from_str("D:/workspace/.axiom/pkg"))

    // 1. Write-ahead journal formatting
    let mut j_buf = lock_buf_new()
    lock_buf_init(mut_view(j_buf))
    format_update_journal(
        lsv_from_str("tx_001"),
        lsv_from_str("staged"),
        1u32,
        2u32,
        lsv_from_str("axiom/crypto@1.4.2"),
        lsv_from_str("sha256:2c26..."),
        mut_view(j_buf)
    )
    let j_sv = lock_buf_as_lsv(view(j_buf))
    let journal_ok = lsv_starts_with_str(j_sv, "# Axiom update journal")
    lock_buf_free(mut_view(j_buf))

    // 2. Successful transaction commit
    let _ = begin_install_transaction(mut_view(store), lsv_from_str("tx_001"), 2u32)
    let mut ver_142 = lock_semver_zero()
    let _ = parse_lock_semver(lsv_from_str("1.4.2"), mut_view(ver_142))
    let commit_st = commit_install_transaction(
        mut_view(store),
        lsv_from_str("crypto"),
        view(ver_142),
        lsv_from_str("merkle_root_hex")
    )
    let commit_ok = commit_st == REG_STATUS_OK && store.active_generation == 2u32

    // 3. Staged transaction rollback
    let _ = begin_install_transaction(mut_view(store), lsv_from_str("tx_002"), 3u32)
    let rb_staged_st = rollback_staged_transaction(mut_view(store))
    let staged_rollback_ok = rb_staged_st == REG_STATUS_OK && store.active_generation == 2u32

    // 4. Downgrade guard: allow_downgrade = false blocks rollback
    store.allow_downgrade = false
    let rb_down_st = rollback_to_generation(mut_view(store), 1u32)
    let downgrade_guard_ok = rb_down_st == REG_STATUS_DOWNGRADE_BLOCKED && store.active_generation == 2u32

    // 5. Safe rollback when permitted
    store.allow_downgrade = true
    let rb_gen_st = rollback_to_generation(mut_view(store), 1u32)
    let generation_rollback_ok = rb_gen_st == REG_STATUS_OK && store.active_generation == 1u32

    // 6. Minimum version floor enforcement
    let mut floor_ver = lock_semver_zero()
    let _ = parse_lock_semver(lsv_from_str("2.0.0"), mut_view(floor_ver))
    store.min_allowed_version = floor_ver

    let mut old_ver = lock_semver_zero()
    let _ = parse_lock_semver(lsv_from_str("1.9.0"), mut_view(old_ver))
    let _ = begin_install_transaction(mut_view(store), lsv_from_str("tx_003"), 2u32)
    let floor_st = commit_install_transaction(
        mut_view(store),
        lsv_from_str("crypto"),
        view(old_ver),
        lsv_from_str("merkle_root_hex")
    )
    let min_version_floor_ok = floor_st == REG_STATUS_POLICY_BLOCKED

    out_str("probe[transactional_rollback] commit_ok=")
    out_bool(commit_ok)
    out_str(" staged_rollback_ok=")
    out_bool(staged_rollback_ok)
    out_str(" generation_rollback_ok=")
    out_bool(generation_rollback_ok)
    out_str(" downgrade_guard_ok=")
    out_bool(downgrade_guard_ok)
    out_str(" min_version_floor_ok=")
    out_bool(min_version_floor_ok)
    out_str(" journal_ok=")
    out_bool(journal_ok)
    out_str("\n")

    commit_ok && staged_rollback_ok && generation_rollback_ok && downgrade_guard_ok && min_version_floor_ok && journal_ok
}

// =============================================================================
// Probe 7: `axiomc pkg` Subcommands & Distribution Driver Execution
// =============================================================================

fn run_registry_cli_probe() -> bool {
    let mut sink = new_diag_sink()

    // 1. Parse CLI arguments
    let mut args: [16]StrView = [dist_sv_empty(); 16]
    args[0] = dist_sv("publish")
    args[1] = dist_sv("--dry-run")
    args[2] = dist_sv("--registry")
    args[3] = dist_sv("corp_internal")
    let mut opts = registry_cmd_options_empty()
    let p_rc = parse_registry_cmd_args(view(args), 4usize, mut_view(opts))
    let parse_args_ok = p_rc == REG_EXIT_OK && opts.subcommand == REG_CMD_PUBLISH && opts.dry_run

    // 2. Execute publish (dry-run)
    let mut out_diag_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(out_diag_buf))
    let pub_rc = execute_pkg_publish(
        view(opts),
        lsv_empty(),
        dist_sv("axiom"),
        dist_sv("crypto"),
        dist_sv("1.4.2"),
        dist_sv("sha256_hex"),
        dist_sv("merkle_hex"),
        false,
        mut_view(sink),
        mut_view(out_diag_buf)
    )
    let publish_ok = pub_rc == REG_EXIT_OK
    diag_buf_free(mut_view(out_diag_buf))

    // 3. Execute fetch with shadow defense
    let mut table = multi_repo_routing_table_empty()
    let mut reg0 = registry_config_empty()
    reg0.id = dist_sv("corp_internal")
    reg0.pinned_namespaces[0] = dist_sv("corp")
    reg0.pinned_count = 1usize
    let mut dk = dist_sv_empty()
    let _ = routing_table_add_registry(mut_view(table), view(reg0), mut_view(dk))

    let mut fetch_opts = registry_cmd_options_empty()
    fetch_opts.subcommand = REG_CMD_FETCH
    let mut fetch_out_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(fetch_out_buf))
    let zero_d = sha256_digest_zero()

    // Candidate "public" attempts to serve pinned "corp" -> shadow blocked!
    let fetch_shadow_rc = execute_pkg_fetch(
        view(fetch_opts),
        view(table),
        dist_sv("public"),
        dist_sv("corp"),
        dist_sv("crypto"),
        dist_sv("1.0.0"),
        lsv_empty(),
        view(zero_d),
        true,
        mut_view(sink),
        mut_view(fetch_out_buf)
    )

    // Authorized "corp_internal" -> fetched ok
    let fetch_auth_rc = execute_pkg_fetch(
        view(fetch_opts),
        view(table),
        dist_sv("corp_internal"),
        dist_sv("corp"),
        dist_sv("crypto"),
        dist_sv("1.0.0"),
        lsv_empty(),
        view(zero_d),
        true,
        mut_view(sink),
        mut_view(fetch_out_buf)
    )
    let fetch_ok = fetch_shadow_rc == REG_EXIT_ERROR && fetch_auth_rc == REG_EXIT_OK
    diag_buf_free(mut_view(fetch_out_buf))

    // 4. Execute search
    let mut search_opts = registry_cmd_options_empty()
    search_opts.subcommand = REG_CMD_SEARCH
    search_opts.query = dist_sv("crypto")
    let pkgs: [4]StrView = [dist_sv("crypto"), dist_sv("math"), dist_sv("net"), dist_sv("fs")]
    let vers: [4]StrView = [dist_sv("1.4.2"), dist_sv("0.2.0"), dist_sv("1.0.0"), dist_sv("0.5.0")]
    let chans: [4]StrView = [dist_sv("stable"), dist_sv("stable"), dist_sv("beta"), dist_sv("stable")]
    let mut search_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(search_buf))
    let search_rc = execute_pkg_search(view(search_opts), view(pkgs), view(vers), view(chans), 4usize, mut_view(search_buf))
    let search_ok = search_rc == REG_EXIT_OK
    diag_buf_free(mut_view(search_buf))

    // 5. Execute mirror
    let mut mirror_opts = registry_cmd_options_empty()
    mirror_opts.subcommand = REG_CMD_MIRROR
    mirror_opts.dest_dir = dist_sv("D:/mirrors/local")
    let mut mirror_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(mirror_buf))
    let mirror_rc = execute_pkg_mirror(view(mirror_opts), view(pkgs), view(vers), 4usize, mut_view(sink), mut_view(mirror_buf))
    let mirror_ok = mirror_rc == REG_EXIT_OK
    diag_buf_free(mut_view(mirror_buf))

    // 6. Execute rollback
    let mut store: RegistryStore = RegistryStore {
        root: lsv_empty(),
        active_generation: 0u32,
        prev_generation: 0u32,
        min_allowed_version: lock_semver_zero(),
        allow_downgrade: true,
        journal_state: 0u32,
        journal_tx_id: lsv_empty(),
        installed_names: [lsv_empty(); 8],
        installed_versions: [lock_semver_zero(); 8],
        installed_roots: [lsv_empty(); 8],
        installed_count: 0usize,
    }
    registry_store_init(mut_view(store), lsv_from_str("D:/workspace/.axiom/pkg"))
    store.active_generation = 3u32
    store.allow_downgrade = true
    let mut rb_opts = registry_cmd_options_empty()
    rb_opts.subcommand = REG_CMD_ROLLBACK
    let mut rb_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(rb_buf))
    let rollback_rc = execute_pkg_rollback(view(rb_opts), mut_view(store), 2u32, mut_view(sink), mut_view(rb_buf))
    let rollback_ok = rollback_rc == REG_EXIT_OK && store.active_generation == 2u32
    diag_buf_free(mut_view(rb_buf))

    diag_sink_free(mut_view(sink))

    out_str("probe[registry_cli] parse_args_ok=")
    out_bool(parse_args_ok)
    out_str(" publish_ok=")
    out_bool(publish_ok)
    out_str(" fetch_ok=")
    out_bool(fetch_ok)
    out_str(" search_ok=")
    out_bool(search_ok)
    out_str(" mirror_ok=")
    out_bool(mirror_ok)
    out_str(" rollback_ok=")
    out_bool(rollback_ok)
    out_str("\n")

    parse_args_ok && publish_ok && fetch_ok && search_ok && mirror_ok && rollback_ok
}

pub fn main() -> i32 {
    let ok1 = run_archive_sha256_probe()
    let ok2 = run_sparse_registry_probe()
    let ok3 = run_immutability_tamper_probe()
    let ok4 = run_distribution_consumption_probe()
    let ok5 = run_multi_repo_pinning_probe()
    let ok6 = run_transactional_rollback_probe()
    let ok7 = run_registry_cli_probe()

    if !ok1 || !ok2 || !ok3 || !ok4 || !ok5 || !ok6 || !ok7 {
        return 1
    }

    out_str("E20-3-REGISTRY-DISTRIBUTION-CONFORMANCE-PROBE-PASS\n")
    0
}
