fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn out_u32(n: u32) {
    let mut b = diag_buf_new()
    diag_buf_init(mut_view(b))
    diag_buf_push_u32(mut_view(b), n)
    let sv = diag_buf_as_str_view(view(b))
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
    diag_buf_free(mut_view(b))
}

// =============================================================================
// Probe 1: Cross-Target Declarative Sysroot & CRT Startup Contracts
// =============================================================================
fn test_probe_cross_target_sysroot_and_crt() {
    let mut sink = diag_sink_new()
    diag_sink_init(mut_view(sink))

    // 1. Verify 6 target triples lookup & normalization
    let mut desc0 = target_descriptor_empty()
    let mut desc1 = target_descriptor_empty()
    let mut desc2 = target_descriptor_empty()
    let mut desc3 = target_descriptor_empty()
    let mut desc4 = target_descriptor_empty()
    let mut desc5 = target_descriptor_empty()

    let t0 = toolchain_registry_lookup(ux2_sv("x86_64-windows"), mut_view(desc0), mut_view(sink))
    let t1 = toolchain_registry_lookup(ux2_sv("aarch64-windows"), mut_view(desc1), mut_view(sink))
    let t2 = toolchain_registry_lookup(ux2_sv("x86_64-linux"), mut_view(desc2), mut_view(sink))
    let t3 = toolchain_registry_lookup(ux2_sv("aarch64-linux"), mut_view(desc3), mut_view(sink))
    let t4 = toolchain_registry_lookup(ux2_sv("aarch64-macos"), mut_view(desc4), mut_view(sink))
    let t5 = toolchain_registry_lookup(ux2_sv("wasm32"), mut_view(desc5), mut_view(sink))
    let mut targets_ok: u32 = 0u32
    if t0 { targets_ok = targets_ok + 1u32 }
    if t1 { targets_ok = targets_ok + 1u32 }
    if t2 { targets_ok = targets_ok + 1u32 }
    if t3 { targets_ok = targets_ok + 1u32 }
    if t4 { targets_ok = targets_ok + 1u32 }
    if t5 { targets_ok = targets_ok + 1u32 }

    // 2. Subsystem CRT startup contracts
    let c_main = verify_startup_contract(ux2_sv("console"), ux2_sv("main"), mut_view(sink))
    let w_win = verify_startup_contract(ux2_sv("windows"), ux2_sv("WinMain"), mut_view(sink))
    let p_start = verify_startup_contract(ux2_sv("posix"), ux2_sv("_start"), mut_view(sink))
    let f_start = verify_startup_contract(ux2_sv("freestanding"), ux2_sv("_start"), mut_view(sink))
    let r_init = verify_startup_contract(ux2_sv("reactor"), ux2_sv("_initialize"), mut_view(sink))
    let c_bad_denied = !verify_startup_contract(ux2_sv("console"), ux2_sv("WinMain"), mut_view(sink))
    let crt_ok = c_main && w_win && p_start && f_start && r_init && c_bad_denied

    // 3. Dynamic import stub resolution
    let mut sys = sysroot_empty()
    let mut lib = import_library_empty()
    lib.name = ux2_sv("kernel32.dll")
    lib.target_file = ux2_sv("kernel32.dll")
    lib.format = ux2_sv("coff")
    let mut sym = import_symbol_empty()
    sym.name = ux2_sv("ExitProcess")
    sym.ordinal = 412u32
    sym.is_valid = true
    let _ = import_library_add_symbol(mut_view(lib), sym)
    let _ = sysroot_add_library(mut_view(sys), view(lib))

    let mut out_sym = import_symbol_empty()
    let found_stub = sysroot_resolve_symbol(view(sys), ux2_sv("kernel32.dll"), ux2_sv("ExitProcess"), mut_view(out_sym), mut_view(sink))
    let found_ordinal = out_sym.ordinal
    let mut missing_sym = import_symbol_empty()
    let missing_stub_denied = !sysroot_resolve_symbol(view(sys), ux2_sv("kernel32.dll"), ux2_sv("NoSuchSymbol"), mut_view(missing_sym), mut_view(sink))
    let stubs_ok = found_stub && found_ordinal == 412u32 && missing_stub_denied

    // 4. Ambient host path rejection
    let win_denied = is_ambient_host_path(ux2_sv("C:\\Windows\\System32"))
    let nix_denied = is_ambient_host_path(ux2_sv("/usr/include"))
    let mac_denied = is_ambient_host_path(ux2_sv("/Library/Developer"))
    let herm_denied = !verify_sysroot_hermeticity(ux2_sv("C:\\Windows"), true, mut_view(sink))
    let herm_pass = verify_sysroot_hermeticity(ux2_sv(".axiom/sdks/x86_64"), true, mut_view(sink))
    let ambient_denied = win_denied && nix_denied && mac_denied && herm_denied && herm_pass

    // 5. API availability gating
    let old_ok = check_api_availability(ux2_sv("10.0.17763"), ux2_sv("10.0.19041"), false, ux2_sv("ApiOld"), mut_view(sink))
    let newer_denied = !check_api_availability(ux2_sv("10.0.22621"), ux2_sv("10.0.19041"), false, ux2_sv("ApiNew"), mut_view(sink))
    let newer_guarded_ok = check_api_availability(ux2_sv("10.0.22621"), ux2_sv("10.0.19041"), true, ux2_sv("ApiNew"), mut_view(sink))
    let api_gated = old_ok && newer_denied && newer_guarded_ok

    out_str("probe[cross_target_sysroot_and_crt] targets=")
    out_u32(targets_ok)
    out_str(" crt_ok=")
    out_bool(crt_ok)
    out_str(" stubs_ok=")
    out_bool(stubs_ok)
    out_str(" ambient_denied=")
    out_bool(ambient_denied)
    out_str(" api_gated=")
    out_bool(api_gated)
    out_str("\n")

    diag_sink_free(mut_view(sink))
}

// =============================================================================
// Probe 2: AXTOOLCHAIN Bundle Packager, Registry & Distribution
// =============================================================================
fn test_probe_axtoolchain_bundle_packager() {
    let mut sink = diag_sink_new()
    diag_sink_init(mut_view(sink))

    // 1. Toolchain registry lookup & triple normalization
    let mut desc = target_descriptor_empty()
    let lookup_ok = toolchain_registry_lookup(ux2_sv("x86_64-pc-windows-msvc"), mut_view(desc), mut_view(sink))

    // 2. Archive packaging: entry addition and lexicographical sorting
    let mut ar = bundle_archive_new(
        BUNDLE_KIND_SDK,
        lsv_from_str("windows-sdk"),
        lsv_from_str("10.0.22621"),
        lsv_from_str("x86_64-pc-windows-msvc")
    )
    let _ = bundle_archive_add_entry(mut_view(ar), bundle_entry_new(lsv_from_str("stubs/kernel32.axstub.toml"), 512u64, 0x11u64, false))
    let _ = bundle_archive_add_entry(mut_view(ar), bundle_entry_new(lsv_from_str("bin/axiomc.exe"), 16384u64, 0x22u64, true))
    let _ = bundle_archive_add_entry(mut_view(ar), bundle_entry_new(lsv_from_str("sdk.toml"), 256u64, 0x33u64, false))
    bundle_archive_finalize(mut_view(ar))

    let sort_ok = lsv_eq_str(ar.entries[0].path, "bin/axiomc.exe") &&
                  lsv_eq_str(ar.entries[1].path, "sdk.toml") &&
                  lsv_eq_str(ar.entries[2].path, "stubs/kernel32.axstub.toml")
    let merkle_ok = !lock_digest256_eq(ar.merkle_root, lock_digest256_zero())

    // 3. Path traversal & mtime safety validation
    let valid_entry = bundle_entry_new(lsv_from_str("sdk.toml"), 256u64, 0x33u64, false)
    let entry_ok = validate_bundle_entry_safety(view(valid_entry)) == BUNDLE_STATUS_OK

    let bad_traversal = bundle_entry_new(lsv_from_str("../secret.txt"), 64u64, 0x99u64, false)
    let traversal_denied = validate_bundle_entry_safety(view(bad_traversal)) == BUNDLE_STATUS_PATH_TRAVERSAL

    let mut bad_mtime = bundle_entry_new(lsv_from_str("data.bin"), 64u64, 0x88u64, false)
    bad_mtime.mtime = 1731110400u64 // non-zero mtime violates AXS-SDK-043 §2
    let mtime_denied = validate_bundle_entry_safety(view(bad_mtime)) == BUNDLE_STATUS_CORRUPT

    // 4. Ed25519 bundle digital signatures
    let sig_ok = verify_bundle_signature(ar.merkle_root, lsv_from_str("ed25519:abcdef0123456789abcdef"), lsv_from_str("official-key-1")) == BUNDLE_STATUS_OK
    let untrusted_denied = verify_bundle_signature(ar.merkle_root, lsv_from_str("ed25519:abcdef0123456789abcdef"), lsv_from_str("untrusted")) == BUNDLE_STATUS_SIGNATURE_INVALID

    // 5. Cache installation path generation
    let mut sdk_cache_buf = lock_buf_new()
    lock_buf_init(mut_view(sdk_cache_buf))
    format_sdk_install_cache_path(lsv_from_str(".axiom"), lsv_from_str("x86_64-pc-windows-msvc"), lsv_from_str("10.0"), ar.merkle_root, mut_view(sdk_cache_buf))
    let sdk_cache_sv = lock_buf_as_lsv(view(sdk_cache_buf))
    let cache_paths_ok = lsv_starts_with_str(sdk_cache_sv, ".axiom/sdks/x86_64-pc-windows-msvc/10.0-")
    lock_buf_free(mut_view(sdk_cache_buf))

    // 6. Offline mirror verification
    let mut mirror_buf = lock_buf_new()
    lock_buf_init(mut_view(mirror_buf))
    let offline_ok = verify_offline_mirror_presence(lsv_from_str("/mirror"), lsv_from_str("sdk.axsdk"), true, mut_view(mirror_buf)) == BUNDLE_STATUS_OK
    let offline_no_mirror_denied = verify_offline_mirror_presence(lsv_empty(), lsv_from_str("sdk.axsdk"), true, mut_view(mirror_buf)) == BUNDLE_STATUS_OFFLINE_MISSING
    lock_buf_free(mut_view(mirror_buf))

    out_str("probe[axtoolchain_bundle_packager] lookup_ok=")
    out_bool(lookup_ok)
    out_str(" sort_ok=")
    out_bool(sort_ok)
    out_str(" merkle_ok=")
    out_bool(merkle_ok)
    out_str(" traversal_denied=")
    out_bool(traversal_denied && mtime_denied && entry_ok)
    out_str(" sig_ok=")
    out_bool(sig_ok && untrusted_denied)
    out_str(" cache_paths_ok=")
    out_bool(cache_paths_ok)
    out_str(" offline_ok=")
    out_bool(offline_ok && offline_no_mirror_denied)
    out_str("\n")

    diag_sink_free(mut_view(sink))
}

// =============================================================================
// Probe 3: Lockfile Pinning, Multi-Target Drift & Tamper Defense
// =============================================================================
fn test_probe_lockfile_pinning_and_tamper_guard() {
    let mut sink = diag_sink_new()
    diag_sink_init(mut_view(sink))

    // 1. Parse multi-target lockfile state
    let lock_text = lsv_from_str("[sdk.\"x86_64-pc-windows-msvc\"]\nversion = \"10.0.22621\"\nfingerprint = \"blake3:1111\"\n\n[sdk.\"aarch64-unknown-linux-gnu\"]\nversion = \"6.6.0\"\nfingerprint = \"blake3:2222\"\n\n[toolchain]\nid = \"axiom-official-2026.11\"\nversion = \"0.2.0\"\nfingerprint = \"blake3:9999\"\nchannel = \"stable\"\n")

    let mut state = sdk_toolchain_lock_state_empty()
    let parse_ok = parse_sdk_toolchain_lock_state(lock_text, mut_view(state)) == BUNDLE_STATUS_OK
    let parse_fields_ok = state.sdk_count == 2usize && state.has_toolchain

    // 2. Serialize lockfile state
    let mut out_lbuf = lock_buf_new()
    lock_buf_init(mut_view(out_lbuf))
    serialize_sdk_toolchain_lock_state(view(state), mut_view(out_lbuf))
    let out_lsv = lock_buf_as_lsv(view(out_lbuf))
    let serialize_ok = lsv_starts_with_str(out_lsv, "\n[sdk.\"x86_64-pc-windows-msvc\"]")
    lock_buf_free(mut_view(out_lbuf))

    // 3. Pin new SDK into state
    let pin_ok = pin_sdk_into_state(
        mut_view(state),
        lsv_from_str("aarch64-apple-darwin"),
        lsv_from_str("14.0.0"),
        lsv_from_str("blake3:3333"),
        lsv_from_str("registry+https://sdk.axiom-lang.org")
    )
    let state_has_3 = state.sdk_count == 3usize

    // 4. Strict --locked verification
    let win_ok = verify_locked_sdk_fingerprint(view(state), lsv_from_str("x86_64-pc-windows-msvc"), lsv_from_str("blake3:1111")) == BUNDLE_STATUS_OK
    let tc_ok = verify_locked_toolchain_fingerprint(view(state), lsv_from_str("axiom-official-2026.11"), lsv_from_str("blake3:9999")) == BUNDLE_STATUS_OK

    // 5. Locked check runner & tamper detection
    let locked_check_pass = execute_sdk_toolchain_locked_check(
        ux2_sv("[sdk.\"x86_64-pc-windows-msvc\"]\nversion = \"10.0\"\nfingerprint = \"blake3:1111\"\n"),
        ux2_sv("x86_64-pc-windows-msvc"),
        ux2_sv("blake3:1111"),
        ux2_sv_empty(),
        ux2_sv_empty(),
        true,
        mut_view(sink)
    ) == SDK_EXIT_OK

    let tamper_rejected = execute_sdk_toolchain_locked_check(
        ux2_sv("[sdk.\"x86_64-pc-windows-msvc\"]\nversion = \"10.0\"\nfingerprint = \"blake3:1111\"\n"),
        ux2_sv("x86_64-pc-windows-msvc"),
        ux2_sv("blake3:ALTERED"), // tampered local SDK fingerprint!
        ux2_sv_empty(),
        ux2_sv_empty(),
        true,
        mut_view(sink)
    ) == SDK_EXIT_VERIFY_ERROR

    out_str("probe[lockfile_pinning_and_tamper_guard] parse_ok=")
    out_bool(parse_ok && parse_fields_ok)
    out_str(" serialize_ok=")
    out_bool(serialize_ok)
    out_str(" pin_ok=")
    out_bool(pin_ok && state_has_3)
    out_str(" locked_check_ok=")
    out_bool(win_ok && tc_ok && locked_check_pass)
    out_str(" tamper_denied=")
    out_bool(tamper_rejected)
    out_str("\n")

    diag_sink_free(mut_view(sink))
}

// =============================================================================
// Probe 4: Two-Machine Reproducible Multi-Package Workspace Build
// =============================================================================
fn test_probe_two_machine_workspace_reproducibility() {
    let mut sink = diag_sink_new()
    diag_sink_init(mut_view(sink))

    // 1. 12-component hermetic build fingerprint invariance
    let mut in_a = hermetic_build_inputs_default()
    in_a.c1_compiler_version = ux2_sv("0.2.0")
    in_a.c3_language_edition = ux2_sv("2026")
    let fp_a = compute_hermetic_build_fingerprint(view(in_a))

    let in_b = in_a // Exact same declared build inputs
    let fp_b = compute_hermetic_build_fingerprint(view(in_b))
    let fp_invariant = digest256_eq(fp_a, fp_b)

    // 2. Path prefix remapper evaluation across distinct machine environments
    let remap_m1 = path_remapper_for_workspace(
        ux2_sv("/home/alice/workspace"),
        ux2_sv("app_server"),
        ux2_sv("1.0.0")
    )
    let remap_m2 = path_remapper_for_workspace(
        ux2_sv("/data/ci_worker_bob/workspace"),
        ux2_sv("app_server"),
        ux2_sv("1.0.0")
    )

    let mut buf_m1 = diag_buf_new()
    diag_buf_init(mut_view(buf_m1))
    path_remapper_remap(view(remap_m1), ux2_sv("/home/alice/workspace/packages/app_server/src/main.ax"), mut_view(buf_m1))
    let sv_m1 = diag_buf_as_str_view(view(buf_m1))

    let mut buf_m2 = diag_buf_new()
    diag_buf_init(mut_view(buf_m2))
    path_remapper_remap(view(remap_m2), ux2_sv("/data/ci_worker_bob/workspace/packages/app_server/src/main.ax"), mut_view(buf_m2))
    let sv_m2 = diag_buf_as_str_view(view(buf_m2))

    let remap_ok = ux2_sv_eq(sv_m1, sv_m2) && ux2_sv_contains(sv_m1, ux2_sv("@pkg/app_server@1.0.0/packages/app_server/src/main.ax"))
    diag_buf_free(mut_view(buf_m1))
    diag_buf_free(mut_view(buf_m2))

    // 3. Multi-package workspace artifact comparison across Machine A and B
    let bin_a: [8]u8 = [0x50u8, 0x4Bu8, 0x03u8, 0x04u8, 0x14u8, 0x00u8, 0x00u8, 0x00u8]
    let bin_b: [8]u8 = [0x50u8, 0x4Bu8, 0x03u8, 0x04u8, 0x14u8, 0x00u8, 0x00u8, 0x00u8]
    let empty_cmp = ReproArtifactComparison {
        name: ux2_sv_empty(),
        size_a: 0usize,
        size_b: 0usize,
        sha256_a: digest256_zero(),
        sha256_b: digest256_zero(),
        identical: false,
        first_diff_offset: 0usize,
        diff_byte_a: 0u8,
        diff_byte_b: 0u8,
        section_name: ux2_sv_empty(),
    }
    let mut cmp_clean = empty_cmp
    let multi_pkg_repro = compare_build_artifacts(
        ux2_sv("app_server.exe"),
        unsafe { address_of(bin_a[0]) },
        8usize,
        unsafe { address_of(bin_b[0]) },
        8usize,
        ux2_sv(".text"),
        mut_view(cmp_clean)
    )

    // 4. Host path leak auditing
    let clean_bytes: [16]u8 = [0x61u8, 0x62u8, 0x63u8, 0x64u8, 0x65u8, 0x66u8, 0x67u8, 0x68u8, 0x69u8, 0x6Au8, 0x6Bu8, 0x6Cu8, 0x6Du8, 0x6Eu8, 0x6Fu8, 0x70u8]
    let dirty_bytes: [24]u8 = [0x2Fu8, 0x68u8, 0x6Fu8, 0x6Du8, 0x65u8, 0x2Fu8, 0x61u8, 0x6Cu8, 0x69u8, 0x63u8, 0x65u8, 0x2Fu8, 0x73u8, 0x65u8, 0x63u8, 0x72u8, 0x65u8, 0x74u8, 0x2Eu8, 0x74u8, 0x78u8, 0x74u8, 0x00u8, 0x00u8]
    let forbidden_paths: [4]StrView = [ux2_sv("/home/alice"), ux2_sv("/tmp"), ux2_sv_empty(), ux2_sv_empty()]

    let clean_audit = audit_host_path_leaks(
        ux2_sv("clean.axlib"),
        unsafe { address_of(clean_bytes[0]) },
        16usize,
        view(forbidden_paths),
        2usize,
        mut_view(sink)
    )
    let leak_detected = !audit_host_path_leaks(
        ux2_sv("dirty.axlib"),
        unsafe { address_of(dirty_bytes[0]) },
        24usize,
        view(forbidden_paths),
        2usize,
        mut_view(sink)
    )
    let leak_audit_ok = clean_audit && leak_detected

    out_str("probe[two_machine_workspace_reproducibility] fp_invariant=")
    out_bool(fp_invariant)
    out_str(" remap_ok=")
    out_bool(remap_ok)
    out_str(" multi_pkg_repro=")
    out_bool(multi_pkg_repro)
    out_str(" leak_audit_ok=")
    out_bool(leak_audit_ok)
    out_str("\n")

    diag_sink_free(mut_view(sink))
}

// =============================================================================
// Probe 5: `axiomc sdk` and `axiomc toolchain` CLI Subcommand Engine
// =============================================================================
fn test_probe_sdk_toolchain_cli_engine() {
    let mut sink = diag_sink_new()
    diag_sink_init(mut_view(sink))

    // 1. axiomc sdk list
    let mut opts_list = sdk_cmd_options_empty()
    opts_list.subcommand = SDK_CMD_LIST
    let mut list_buf = diag_buf_new()
    diag_buf_init(mut_view(list_buf))
    let sdk_list_ok = execute_sdk_list(view(opts_list), mut_view(list_buf), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(list_buf))

    // 2. axiomc sdk install
    let mut opts_install = sdk_cmd_options_empty()
    opts_install.subcommand = SDK_CMD_INSTALL
    opts_install.target = ux2_sv("x86_64-pc-windows-msvc")
    let mut install_buf = diag_buf_new()
    diag_buf_init(mut_view(install_buf))
    let sdk_install_ok = execute_sdk_install(view(opts_install), mut_view(install_buf), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(install_buf))

    // 3. axiomc sdk verify
    let mut opts_verify = sdk_cmd_options_empty()
    opts_verify.subcommand = SDK_CMD_VERIFY
    opts_verify.target = ux2_sv("x86_64-pc-windows-msvc")
    let mut verify_buf = diag_buf_new()
    diag_buf_init(mut_view(verify_buf))
    let sdk_verify_ok = execute_sdk_verify(view(opts_verify), mut_view(verify_buf), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(verify_buf))

    // 4. axiomc toolchain info
    let mut opts_tc_info = sdk_cmd_options_empty()
    opts_tc_info.is_toolchain = true
    opts_tc_info.subcommand = SDK_CMD_INFO
    opts_tc_info.toolchain_id = ux2_sv("axiom-official-2026.11")
    let mut tc_info_buf = diag_buf_new()
    diag_buf_init(mut_view(tc_info_buf))
    let tc_info_ok = execute_toolchain_info(view(opts_tc_info), mut_view(tc_info_buf), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(tc_info_buf))

    // 5. axiomc toolchain verify
    let mut opts_tc_verify = sdk_cmd_options_empty()
    opts_tc_verify.is_toolchain = true
    opts_tc_verify.subcommand = SDK_CMD_VERIFY
    opts_tc_verify.toolchain_id = ux2_sv("axiom-official-2026.11")
    let mut tc_verify_buf = diag_buf_new()
    diag_buf_init(mut_view(tc_verify_buf))
    let tc_verify_ok = execute_toolchain_verify(view(opts_tc_verify), mut_view(tc_verify_buf), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(tc_verify_buf))

    // 6. Deterministic exit codes evaluation
    // Usage error (exit code 2)
    let mut bad_install = sdk_cmd_options_empty()
    bad_install.subcommand = SDK_CMD_INSTALL
    bad_install.target = ux2_sv_empty()
    let mut err_buf = diag_buf_new()
    diag_buf_init(mut_view(err_buf))
    let usage_err_ok = execute_sdk_install(view(bad_install), mut_view(err_buf), mut_view(sink)) == SDK_EXIT_USAGE_ERROR

    // Verification error (exit code 3)
    let mut tampered_verify = sdk_cmd_options_empty()
    tampered_verify.subcommand = SDK_CMD_VERIFY
    tampered_verify.target = ux2_sv("x86_64-pc-windows-msvc")
    tampered_verify.key = ux2_sv("tampered")
    let verify_err_ok = execute_sdk_verify(view(tampered_verify), mut_view(err_buf), mut_view(sink)) == SDK_EXIT_VERIFY_ERROR

    // Signature error (exit code 4)
    let mut invalid_sig = sdk_cmd_options_empty()
    invalid_sig.subcommand = SDK_CMD_VERIFY
    invalid_sig.target = ux2_sv("x86_64-pc-windows-msvc")
    invalid_sig.key = ux2_sv("invalid_sig")
    let sig_err_ok = execute_sdk_verify(view(invalid_sig), mut_view(err_buf), mut_view(sink)) == SDK_EXIT_SIGNATURE_ERROR

    // IO error (exit code 5)
    let mut offline_no_mirror = sdk_cmd_options_empty()
    offline_no_mirror.subcommand = SDK_CMD_INSTALL
    offline_no_mirror.target = ux2_sv("x86_64-pc-windows-msvc")
    offline_no_mirror.offline = true
    offline_no_mirror.mirror_path = ux2_sv_empty()
    let io_err_ok = execute_sdk_install(view(offline_no_mirror), mut_view(err_buf), mut_view(sink)) == SDK_EXIT_IO_ERROR
    diag_buf_free(mut_view(err_buf))

    let exit_codes_ok = usage_err_ok && verify_err_ok && sig_err_ok && io_err_ok

    out_str("probe[sdk_toolchain_cli_engine] sdk_cli_ok=")
    out_bool(sdk_list_ok && sdk_install_ok && sdk_verify_ok)
    out_str(" tc_cli_ok=")
    out_bool(tc_info_ok && tc_verify_ok)
    out_str(" exit_codes_ok=")
    out_bool(exit_codes_ok)
    out_str(" diag_mapped=")
    out_bool(sink.errors > 0usize)
    out_str("\n")

    diag_sink_free(mut_view(sink))
}

pub fn main() -> i32 {
    test_probe_cross_target_sysroot_and_crt()
    test_probe_axtoolchain_bundle_packager()
    test_probe_lockfile_pinning_and_tamper_guard()
    test_probe_two_machine_workspace_reproducibility()
    test_probe_sdk_toolchain_cli_engine()
    out_str("E20-6-SDK-TOOLCHAIN-WORKSPACE-CONFORMANCE-PROBE-PASS\n")
    0
}
