// test: run
// modes: interp native
// stdout-file: feature_cfg_and_semantic_firewall.stdout
// SPEC-110 §§1, 2 (AXS-BLD-005, AXS-BLD-014..015, AXS-BLD-021, REQ-PKG-025, INV-BLD-001):
// E20.1 Conformance: Feature integrity, REQ-PKG-025 semantic non-interference, prohibition
// of silent feature disabling, dev-dependencies firewall isolation from downstream consumers,
// and Host vs Target feature partition.

const ENV_TARGET: u8 = 0u8
const ENV_HOST: u8 = 1u8

const SCOPE_NORMAL: u8 = 0u8
const SCOPE_DEV: u8 = 1u8
const SCOPE_BUILD: u8 = 2u8

const FEAT_SIMD: u32 = 1u32 << 0u32
const FEAT_TELEMETRY: u32 = 1u32 << 1u32
const FEAT_FAST_PARSER: u32 = 1u32 << 2u32
const FEAT_GPU_ACCEL: u32 = 1u32 << 3u32

@derive(Copy)
struct PkgFeatureState {
    pkg_id: u32,
    env_class: u8,
    active_features: u32,
}

// Dev-dependencies firewall check:
// When compiling a non-test target of downstream consumer 'downstream_pkg',
// can it resolve an item from upstream's dev-dependencies?
fn can_resolve_dependency(
    consumer_is_test: bool,
    dep_scope: u8,
    is_downstream_consumer: bool
) -> bool {
    if dep_scope == SCOPE_NORMAL {
        return true
    }
    if dep_scope == SCOPE_DEV {
        // Dev-dependencies are ONLY accessible when compiling test targets of the declaring package.
        // They MUST NOT leak into downstream consumers under any circumstances (AXS-BLD-005).
        if is_downstream_consumer {
            return false
        }
        return consumer_is_test
    }
    if dep_scope == SCOPE_BUILD {
        // Build dependencies are compiled for the Host and isolated to build tools
        return false
    }
    false
}

// REQ-PKG-025: No silent feature dropping
// If a dependency edge explicitly requests feature 'required_feat',
// resolution MUST fail if required_feat is unavailable or conflicting.
fn resolve_feature_request(
    declared_features_mask: u32,
    requested_feat_mask: u32,
    has_conflict: bool
) -> bool {
    // Check if requested feature is within declared namespace
    if (requested_feat_mask & ~declared_features_mask) != 0u32 {
        // Unknown feature: MUST fail hard (no silent drop)
        return false
    }
    if has_conflict {
        // Conflicting feature: MUST fail hard (no silent disable)
        return false
    }
    true
}

// Host vs Target feature split (AXS-BLD-014.2, AXS-BLD-021):
// Host build-dependencies features must NOT be unified into Target normal dependencies.
fn unify_features_by_env(
    target_state: mut_view<PkgFeatureState>,
    host_state: mut_view<PkgFeatureState>,
    edge_env: u8,
    edge_features: u32
) {
    if edge_env == ENV_TARGET {
        target_state.active_features = target_state.active_features | edge_features
    } else {
        host_state.active_features = host_state.active_features | edge_features
    }
}

pub fn main() -> i32 {
    // 1. REQ-PKG-025 & closed feature namespace:
    // Package declares SIMD and TELEMETRY. Requesting GPU_ACCEL (undeclared) must fail.
    let declared_mask = FEAT_SIMD | FEAT_TELEMETRY
    let ok_req = resolve_feature_request(declared_mask, FEAT_SIMD, false)
    let unknown_req = resolve_feature_request(declared_mask, FEAT_GPU_ACCEL, false)
    let conflict_req = resolve_feature_request(declared_mask, FEAT_SIMD, true)

    let req_pkg_025_active = ok_req && !unknown_req && !conflict_req
    if !req_pkg_025_active {
        return 1
    }

    // No silent feature drop: if a feature cannot be satisfied, it must not be silently dropped
    let no_silent_drop = !unknown_req && !conflict_req
    if !no_silent_drop {
        return 2
    }

    // 2. Dev-dependencies firewall (AXS-BLD-005):
    // Upstream declares 'test_kit' in [dev-dependencies].
    // - Upstream test binary: can access test_kit -> true
    // - Upstream lib/bin target: cannot access test_kit -> false
    // - Downstream consumer (even downstream test): cannot access upstream's test_kit -> false
    let upstream_test_access = can_resolve_dependency(true, SCOPE_DEV, false)
    let upstream_lib_access = can_resolve_dependency(false, SCOPE_DEV, false)
    let downstream_lib_access = can_resolve_dependency(false, SCOPE_DEV, true)
    let downstream_test_access = can_resolve_dependency(true, SCOPE_DEV, true)

    let dev_dep_firewall_ok = upstream_test_access &&
        !upstream_lib_access &&
        !downstream_lib_access &&
        !downstream_test_access
    if !dev_dep_firewall_ok {
        return 3
    }

    // 3. Host vs Target feature split (AXS-BLD-014.2, AXS-BLD-021):
    // Package 'core_util' is used both as Target [dependencies] (with SIMD)
    // and as Host [build-dependencies] for code generator (with FAST_PARSER).
    // Target instance MUST NOT inherit FAST_PARSER, Host instance MUST NOT inherit SIMD.
    let mut target_inst = PkgFeatureState {
        pkg_id: 10u32,
        env_class: ENV_TARGET,
        active_features: 0u32,
    }
    let mut host_inst = PkgFeatureState {
        pkg_id: 10u32,
        env_class: ENV_HOST,
        active_features: 0u32,
    }

    unify_features_by_env(mut_view(target_inst), mut_view(host_inst), ENV_TARGET, FEAT_SIMD)
    unify_features_by_env(mut_view(target_inst), mut_view(host_inst), ENV_HOST, FEAT_FAST_PARSER)

    let target_has_simd = (target_inst.active_features & FEAT_SIMD) != 0u32
    let target_has_parser = (target_inst.active_features & FEAT_FAST_PARSER) != 0u32
    let host_has_simd = (host_inst.active_features & FEAT_SIMD) != 0u32
    let host_has_parser = (host_inst.active_features & FEAT_FAST_PARSER) != 0u32

    let host_target_feat_split = target_has_simd && !target_has_parser &&
        !host_has_simd && host_has_parser
    if !host_target_feat_split {
        return 4
    }

    print("feature_cfg_and_semantic_firewall: req_pkg_025_active=true no_silent_drop=true dev_dep_firewall_ok=true host_target_feat_split=true\n")
    print("FEATURE-CFG-AND-SEMANTIC-FIREWALL-OK\n")
    0
}
