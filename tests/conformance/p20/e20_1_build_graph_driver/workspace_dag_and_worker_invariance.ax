// test: run
// modes: interp native
// stdout-file: workspace_dag_and_worker_invariance.stdout
// SPEC-110 §§1, 3 (AXS-BLD-001..006, AXS-BLD-025, REQ-PKG-010, REQ-PKG-022):
// E20.1 Conformance: Multi-package workspace DAG construction, deterministic topological
// ordering with canonical tie-breaking, readdir/filesystem enumeration order independence,
// and byte-for-byte worker-count invariance (1 vs 4 workers).

@intrinsic
fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

const PKG_ROOT_APP: usize = 0usize
const PKG_CORE_MATH: usize = 1usize
const PKG_NET_PROTO: usize = 2usize
const PKG_CRYPTO_PRIMS: usize = 3usize
const PKG_SYS_UTILS: usize = 4usize

@derive(Copy)
struct PkgDesc {
    id: u32,
    name_hash: u64,
    version_packed: u32,
}

@derive(Copy)
struct DepEdge {
    from_pkg: usize,
    to_pkg: usize,
}

fn fnv1a_step(h: u64, v: u64) -> u64 {
    wrapping_mul_u64(h ^ v, 1099511628211u64)
}

fn simulate_worker_schedule(
    order: view<[5]usize>,
    jobs: u32
) -> u64 {
    // Under AXS-BLD-025, whether jobs == 1 or jobs == 4, ready actions are dequeued
    // in canonical total order and write deterministic content-addressed artifacts.
    let _ = jobs
    let mut h: u64 = 14695981039346656037u64
    let mut i: usize = 0usize
    while i < 5usize {
        let pkg_idx = (*order)[i]
        h = fnv1a_step(h, pkg_idx as u64)
        h = fnv1a_step(h, 0x5EED0000u64 | (pkg_idx as u64))
        i = i + 1usize
    }
    h
}

pub fn main() -> i32 {
    // 1. Five packages in canonical lexicographical order
    let pkgs: [5]PkgDesc = [
        PkgDesc { id: 0u32, name_hash: 0x1000u64, version_packed: 0x010000u32 }, // root_app
        PkgDesc { id: 1u32, name_hash: 0x2000u64, version_packed: 0x010000u32 }, // core_math
        PkgDesc { id: 2u32, name_hash: 0x3000u64, version_packed: 0x010000u32 }, // net_proto
        PkgDesc { id: 3u32, name_hash: 0x4000u64, version_packed: 0x010000u32 }, // crypto_prims
        PkgDesc { id: 4u32, name_hash: 0x5000u64, version_packed: 0x010000u32 }, // sys_utils
    ]

    // Dependencies:
    // root_app -> core_math, net_proto
    // core_math -> sys_utils
    // net_proto -> crypto_prims, sys_utils
    // crypto_prims -> sys_utils
    // sys_utils -> leaf
    let edges: [6]DepEdge = [
        DepEdge { from_pkg: PKG_ROOT_APP, to_pkg: PKG_CORE_MATH },
        DepEdge { from_pkg: PKG_ROOT_APP, to_pkg: PKG_NET_PROTO },
        DepEdge { from_pkg: PKG_CORE_MATH, to_pkg: PKG_SYS_UTILS },
        DepEdge { from_pkg: PKG_NET_PROTO, to_pkg: PKG_CRYPTO_PRIMS },
        DepEdge { from_pkg: PKG_NET_PROTO, to_pkg: PKG_SYS_UTILS },
        DepEdge { from_pkg: PKG_CRYPTO_PRIMS, to_pkg: PKG_SYS_UTILS },
    ]

    // Canonical topological build order (dependencies before consumers, ties broken lexicographically):
    // 1. sys_utils (leaf, in-degree 0 from deps)
    // 2. core_math (ready, name < crypto_prims)
    // 3. crypto_prims (ready)
    // 4. net_proto (ready after crypto_prims + sys_utils)
    // 5. root_app (ready after core_math + net_proto)
    let canonical_order: [5]usize = [
        PKG_SYS_UTILS,
        PKG_CORE_MATH,
        PKG_CRYPTO_PRIMS,
        PKG_NET_PROTO,
        PKG_ROOT_APP,
    ]

    // Validate that dependencies always precede consumers in canonical_order
    let mut pos: [5]usize = [0usize; 5]
    let mut i: usize = 0usize
    while i < 5usize {
        pos[canonical_order[i]] = i
        i = i + 1usize
    }

    let mut topo_ok = true
    let mut e_idx: usize = 0usize
    while e_idx < 6usize {
        let from_p = edges[e_idx].from_pkg
        let to_p = edges[e_idx].to_pkg
        // to_p is dependency, so pos[to_p] must be < pos[from_p]
        if pos[to_p] >= pos[from_p] {
            topo_ok = false
        }
        e_idx = e_idx + 1usize
    }

    if !topo_ok {
        return 1
    }

    // 2. Filesystem enumeration order independence (readdir / members order)
    // Suppose directory iteration returned members in arbitrary shuffled order:
    let shuffled_members: [5]usize = [
        PKG_NET_PROTO,
        PKG_SYS_UTILS,
        PKG_ROOT_APP,
        PKG_CRYPTO_PRIMS,
        PKG_CORE_MATH,
    ]

    // Sort by canonical package identity (AXS-BLD-006):
    let mut sorted_members = shuffled_members
    let mut a: usize = 0usize
    while a < 5usize {
        let mut b: usize = a + 1usize
        while b < 5usize {
            if pkgs[sorted_members[a]].name_hash > pkgs[sorted_members[b]].name_hash {
                let tmp = sorted_members[a]
                sorted_members[a] = sorted_members[b]
                sorted_members[b] = tmp
            }
            b = b + 1usize
        }
        a = a + 1usize
    }

    let mut readdir_inv = true
    let mut k: usize = 0usize
    while k < 5usize {
        if sorted_members[k] != pkgs[k].id as usize {
            readdir_inv = false
        }
        k = k + 1usize
    }

    if !readdir_inv {
        return 2
    }

    // 3. Worker-count invariance (1 vs 4 workers produce identical outputs)
    let hash_1_worker = simulate_worker_schedule(view(canonical_order), 1u32)
    let hash_4_workers = simulate_worker_schedule(view(canonical_order), 4u32)

    let worker_match = hash_1_worker == hash_4_workers
    if !worker_match {
        return 3
    }

    print("workspace_dag_and_worker_invariance: topo_order_ok=true readdir_inv=true worker_1_vs_4_match=true aggregate_hash_match=true\n")
    print("WORKSPACE-DAG-AND-WORKER-INVARIANCE-OK\n")
    0
}
