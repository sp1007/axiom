// test: run
// modes: interp native
// stdout-file: cross_target_cache_and_driver_cli.stdout
// SPEC-110 §§3..5 (AXS-BLD-020..021, AXS-BLD-030..034, AXS-BLD-040..042, REQ-PKG-022, REQ-PKG-024, INV-BLD-002, INV-BLD-003):
// E20.1 Conformance: Strict Host/Target cross-build split, AX_LINK_ARTIFACT_TARGET_MISMATCH rejection,
// 4-tier build cache, interface early cutoff cascade suppression, cache poisoning eviction &
// transparent recovery, and workspace driver CLI subcommands / graph serialization formats.

const ENV_TARGET: u8 = 0u8
const ENV_HOST: u8 = 1u8

const ACT_RUN_BUILD_TOOL: u8 = 0u8
const ACT_EMIT_INTERFACE: u8 = 1u8
const ACT_COMPILE_CGU: u8 = 2u8
const ACT_ASSEMBLE_ARCHIVE: u8 = 3u8
const ACT_LINK_ARTIFACT: u8 = 4u8

const AX_LINK_ARTIFACT_TARGET_MISMATCH: u32 = 220u32

const WS_CMD_BUILD: u8 = 0u8
const WS_CMD_CHECK: u8 = 1u8
const WS_CMD_RUN: u8 = 2u8
const WS_CMD_CLEAN: u8 = 3u8
const WS_CMD_GRAPH: u8 = 4u8

const GRAPH_FMT_JSON: u8 = 0u8
const GRAPH_FMT_DOT: u8 = 1u8
const GRAPH_FMT_INVALID: u8 = 255u8

const WS_EXIT_OK: i32 = 0i32
const WS_EXIT_USAGE_ERROR: i32 = 2i32

const CACHE_MISS_CORRUPT_ENTRY_EVICTED: u8 = 8u8

@intrinsic
fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

fn fnv1a_step(h: u64, v: u64) -> u64 {
    wrapping_mul_u64(h ^ v, 1099511628211u64)
}

fn compute_action_key(pkg_id: u64, kind: u8, env_class: u8, triple_id: u32) -> u64 {
    let mut h: u64 = 14695981039346656037u64
    h = fnv1a_step(h, pkg_id)
    h = fnv1a_step(h, kind as u64)
    h = fnv1a_step(h, env_class as u64)
    h = fnv1a_step(h, triple_id as u64)
    h
}

// 1. Link isolation verification: cross-environment linking is forbidden
fn verify_link_target_match(consumer_env: u8, consumer_triple: u32, provider_env: u8, provider_triple: u32) -> u32 {
    if consumer_env != provider_env || consumer_triple != provider_triple {
        return AX_LINK_ARTIFACT_TARGET_MISMATCH
    }
    0u32
}

// 2. Cache corruption verification: verify entry digest before reuse
fn verify_cache_entry_digest(stored_digest: u64, actual_payload_digest: u64) -> u8 {
    if stored_digest != actual_payload_digest {
        // Corrupt entry: evict and recompute
        return CACHE_MISS_CORRUPT_ENTRY_EVICTED
    }
    0u8 // Cache hit
}

// 3. Early cutoff cascade suppression:
// When upstream 'core' edits private body only, interface_digest is unchanged.
// Downstream 'app' depends on interface_digest -> achieves early cutoff hit!
fn evaluate_early_cutoff(
    upstream_interface_unchanged: bool,
    downstream_input_interface_digest: u64,
    downstream_cached_interface_digest: u64
) -> bool {
    if upstream_interface_unchanged && (downstream_input_interface_digest == downstream_cached_interface_digest) {
        return true // Cutoff: skip recompiling downstream
    }
    false
}

// 4. CLI command validation
fn validate_cli_invocation(subcmd: u8, has_bin_specified: bool, bin_count: usize, graph_fmt: u8) -> i32 {
    if subcmd == WS_CMD_RUN {
        // Ambiguous run target without explicit --bin
        if bin_count > 1usize && !has_bin_specified {
            return WS_EXIT_USAGE_ERROR
        }
        return WS_EXIT_OK
    }
    if subcmd == WS_CMD_GRAPH {
        if graph_fmt != GRAPH_FMT_JSON && graph_fmt != GRAPH_FMT_DOT {
            return WS_EXIT_USAGE_ERROR
        }
        return WS_EXIT_OK
    }
    if subcmd == WS_CMD_BUILD || subcmd == WS_CMD_CHECK || subcmd == WS_CMD_CLEAN {
        return WS_EXIT_OK
    }
    WS_EXIT_USAGE_ERROR
}

pub fn main() -> i32 {
    // 1. Host vs Target cross-build split and link isolation (AXS-BLD-020..021)
    let host_triple: u32 = 1u32   // x86_64-windows
    let target_triple: u32 = 2u32 // aarch64-linux

    let target_key = compute_action_key(42u64, ACT_COMPILE_CGU, ENV_TARGET, target_triple)
    let host_key = compute_action_key(42u64, ACT_COMPILE_CGU, ENV_HOST, host_triple)
    if target_key == host_key {
        return 1
    }

    let link_mismatch = verify_link_target_match(ENV_TARGET, target_triple, ENV_HOST, host_triple)
    let target_isolation = link_mismatch == AX_LINK_ARTIFACT_TARGET_MISMATCH
    if !target_isolation {
        return 2
    }

    // 2. Cache corruption / poisoning eviction (AXS-BLD-032)
    let clean_res = verify_cache_entry_digest(0xAABBCCDDu64, 0xAABBCCDDu64)
    let poisoned_res = verify_cache_entry_digest(0xAABBCCDDu64, 0xDEADBEEFu64)
    let poison_evicted = clean_res == 0u8 && poisoned_res == CACHE_MISS_CORRUPT_ENTRY_EVICTED
    if !poison_evicted {
        return 3
    }

    // 3. Interface early cutoff cascade suppression (AXS-BLD-031)
    let core_interface_fp: u64 = 0x1122334455667788u64
    let app_cached_input_fp: u64 = 0x1122334455667788u64
    let early_cutoff_reused = evaluate_early_cutoff(true, core_interface_fp, app_cached_input_fp)
    if !early_cutoff_reused {
        return 4
    }

    // 4. CLI commands and graph format validation (AXS-BLD-040..042)
    let build_rc = validate_cli_invocation(WS_CMD_BUILD, false, 1usize, 0u8)
    let check_rc = validate_cli_invocation(WS_CMD_CHECK, false, 1usize, 0u8)
    let clean_rc = validate_cli_invocation(WS_CMD_CLEAN, false, 1usize, 0u8)
    let run_ambig_rc = validate_cli_invocation(WS_CMD_RUN, false, 2usize, 0u8)
    let run_sel_rc = validate_cli_invocation(WS_CMD_RUN, true, 2usize, 0u8)

    let cli_commands_ok = build_rc == WS_EXIT_OK &&
        check_rc == WS_EXIT_OK &&
        clean_rc == WS_EXIT_OK &&
        run_ambig_rc == WS_EXIT_USAGE_ERROR &&
        run_sel_rc == WS_EXIT_OK
    if !cli_commands_ok {
        return 5
    }

    let graph_json_rc = validate_cli_invocation(WS_CMD_GRAPH, false, 1usize, GRAPH_FMT_JSON)
    let graph_dot_rc = validate_cli_invocation(WS_CMD_GRAPH, false, 1usize, GRAPH_FMT_DOT)
    let graph_bad_rc = validate_cli_invocation(WS_CMD_GRAPH, false, 1usize, GRAPH_FMT_INVALID)
    let graph_formats_ok = graph_json_rc == WS_EXIT_OK &&
        graph_dot_rc == WS_EXIT_OK &&
        graph_bad_rc == WS_EXIT_USAGE_ERROR
    if !graph_formats_ok {
        return 6
    }

    print("cross_target_cache_and_driver_cli: target_isolation=true poison_evicted=true early_cutoff_reused=true cli_commands_ok=true graph_formats_ok=true\n")
    print("CROSS-TARGET-CACHE-AND-DRIVER-CLI-OK\n")
    0
}
