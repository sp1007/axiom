fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn new_diag_sink() -> DiagSink {
    let mut sink = DiagSink {
        arena: (query_db_empty()).arena,
        diags: 0 as *mut compiler.diag.emitter.Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
    diag_sink_init(mut_view(sink))
    sink
}

fn sink_has_code(sink: view<DiagSink>, code_v: u32) -> bool {
    let mut i: usize = 0usize
    while i < sink.len {
        let d = diag_sink_get(sink, i)
        if d.code.v == code_v {
            return true
        }
        i = i + 1usize
    }
    false
}

// =============================================================================
// Probe 1: Tiers & Opaque Handle Evolution (AXS-ABI-001..003, AXS-ABI-013)
// =============================================================================
fn probe_tiers_and_opaque_evolution() {
    out_str("probe[tiers_and_opaque_evolution] ")

    let mut sink = new_diag_sink()
    let def_mod = ux2_sv("game.engine")
    let client_mod = ux2_sv("game.client")

    let mut ty_opaque = stable_type_contract_opaque(ux2_sv("EngineContext"), def_mod)

    // Defining module: by-value allowed
    let def_val_ok = validate_opaque_handle_usage(view(ty_opaque), true, def_mod, mut_view(sink))
    // Defining module: pointer allowed
    let def_ptr_ok = validate_opaque_handle_usage(view(ty_opaque), false, def_mod, mut_view(sink))
    // Client module: pointer allowed
    let client_ptr_ok = validate_opaque_handle_usage(view(ty_opaque), false, client_mod, mut_view(sink))

    // Client module: by-value instantiation/pass REJECTED with AX_ABI_OPAQUE_BY_VALUE
    let mut sink_client = new_diag_sink()
    let client_val_rejected = (!validate_opaque_handle_usage(view(ty_opaque), true, client_mod, mut_view(sink_client))) &&
        sink_has_code(view(sink_client), AX_ABI_OPAQUE_BY_VALUE)

    // Opaque handle layout isolation: internal field changes do NOT alter public AbiFingerprint
    let target = target_platform_win64()

    let mut item_v1 = abi_layout_item_input_default(ux2_sv("EngineContext"), def_mod, true)
    item_v1.is_opaque = true
    item_v1.size = 16u32
    item_v1.align = 8u32
    item_v1.field_offsets_hash = 100u64
    item_v1.private_body_hash = 1000u64

    let mut item_v2 = item_v1
    item_v2.size = 40u32
    item_v2.align = 8u32
    item_v2.field_offsets_hash = 200u64
    item_v2.private_body_hash = 2000u64

    let dummy_item = abi_layout_item_input_default(ux2_sv_empty(), ux2_sv_empty(), false)
    let mut items1: [8]AbiLayoutItemInput = [dummy_item; 8]
    items1[0] = item_v1
    let fp_v1 = compute_abi_fingerprint(view(target), view(items1), 1usize)

    let mut items2: [8]AbiLayoutItemInput = [dummy_item; 8]
    items2[0] = item_v2
    let fp_v2 = compute_abi_fingerprint(view(target), view(items2), 1usize)

    let opaque_layout_isolated = abi_fingerprint_eq(fp_v1, fp_v2)

    let tiers_ok = def_val_ok && def_ptr_ok
    let opaque_ptr_ok = client_ptr_ok

    out_str("tiers_ok=")
    out_bool(tiers_ok)
    out_str(" opaque_ptr_ok=")
    out_bool(opaque_ptr_ok)
    out_str(" opaque_layout_isolated=")
    out_bool(opaque_layout_isolated)
    out_str(" opaque_by_val_rejected=")
    out_bool(client_val_rejected)
    out_str("\n")
}

// =============================================================================
// Probe 2: Stable Boundary Firewall (AXS-ABI-004, AXS-ABI-010..017)
// =============================================================================
fn probe_boundary_firewall() {
    out_str("probe[boundary_firewall] ")

    let cur_mod = ux2_sv("demo.abi_test")

    // 1. Valid scalar function
    let mut f_ok = stable_fn_contract_default(ux2_sv("compute_sum"), cur_mod)
    f_ok.param_count = 2u32
    let dummy_param = stable_param_contract_default(ux2_sv_empty(), stable_type_contract_unstable(ux2_sv_empty(), 0u8), false)
    let mut params_ok: [8]StableParamContract = [dummy_param; 8]
    params_ok[0] = stable_param_contract_default(ux2_sv("a"), stable_type_contract_scalar(STABLE_TYPE_U32, ux2_sv("u32"), 4u32, 4u32), true)
    params_ok[1] = stable_param_contract_default(ux2_sv("b"), stable_type_contract_scalar(STABLE_TYPE_U32, ux2_sv("u32"), 4u32, 4u32), true)
    let mut sink_ok = new_diag_sink()
    let scalars_ok = validate_stable_boundary_fn(view(f_ok), view(params_ok), 2usize, cur_mod, mut_view(sink_ok))

    // 2. Capturing closure rejected
    let mut f_closure = stable_fn_contract_default(ux2_sv("register_cb"), cur_mod)
    f_closure.param_count = 1u32
    let mut params_closure: [8]StableParamContract = [dummy_param; 8]
    params_closure[0] = stable_param_contract_default(ux2_sv("cb"), stable_type_contract_unstable(ux2_sv("closure"), UNSTABLE_CLOSURE_CAPTURING), true)
    let mut sink_closure = new_diag_sink()
    let closure_rejected = (!validate_stable_boundary_fn(view(f_closure), view(params_closure), 1usize, cur_mod, mut_view(sink_closure))) &&
        sink_has_code(view(sink_closure), AX_ABI_UNSTABLE_TYPE)

    // 3. Unrepr ADT rejected
    let mut f_adt = stable_fn_contract_default(ux2_sv("pass_adt"), cur_mod)
    f_adt.param_count = 1u32
    let mut params_adt: [8]StableParamContract = [dummy_param; 8]
    params_adt[0] = stable_param_contract_default(ux2_sv("pt"), stable_type_contract_unstable(ux2_sv("Point"), UNSTABLE_UNREPR_ADT), true)
    let mut sink_adt = new_diag_sink()
    let unrepr_rejected = (!validate_stable_boundary_fn(view(f_adt), view(params_adt), 1usize, cur_mod, mut_view(sink_adt))) &&
        sink_has_code(view(sink_adt), AX_ABI_UNSTABLE_TYPE)

    // 4. Raw generic export rejected
    let mut f_generic = stable_fn_contract_default(ux2_sv("generic_worker"), cur_mod)
    f_generic.is_generic = true
    f_generic.generic_param_count = 1u32
    let mut sink_gen = new_diag_sink()
    let generic_rejected = (!validate_stable_boundary_fn(view(f_generic), view(params_ok), 0usize, cur_mod, mut_view(sink_gen))) &&
        sink_has_code(view(sink_gen), AX_FFI_GENERIC_EXPORT)

    // 5. Extensible struct missing header
    let mut ext_ty = stable_type_contract_scalar(17u8, ux2_sv("PluginConfig"), 24u32, 8u32)
    ext_ty.is_extensible = true
    let mut sink_hdr = new_diag_sink()
    let missing_hdr_rejected = (!validate_extensible_struct_header(
        view(ext_ty),
        ux2_sv("width"),
        ux2_sv("u32"),
        ux2_sv("height"),
        ux2_sv("u32"),
        mut_view(sink_hdr)
    )) && sink_has_code(view(sink_hdr), AX_ABI_EXTENSIBLE_MISSING_HEADER)

    out_str("scalars_ok=")
    out_bool(scalars_ok)
    out_str(" closure_rejected=")
    out_bool(closure_rejected)
    out_str(" unrepr_rejected=")
    out_bool(unrepr_rejected)
    out_str(" generic_rejected=")
    out_bool(generic_rejected)
    out_str(" missing_header_rejected=")
    out_bool(missing_hdr_rejected)
    out_str("\n")
}

// =============================================================================
// Probe 3: Fingerprint Triple & Versioned Symbols (AXS-ABI-020..032)
// =============================================================================
fn probe_fingerprint_triple_and_symbols() {
    out_str("probe[fingerprint_triple_and_symbols] ")

    let target = target_platform_win64()

    // 1. ApiFingerprint invariance under private helper bodies
    let mut api_items1: [8]ApiItemInput = [api_item_input_default(0u8, ux2_sv_empty(), ux2_sv_empty(), false); 8]
    let mut api_fn = api_item_input_default(ITEM_KIND_FN, ux2_sv("calc"), ux2_sv("api"), true)
    api_fn.fn_param_count = 2u32
    api_fn.fn_param_types_hash = 100u64
    api_fn.fn_ret_type_name = ux2_sv("u32")
    api_items1[0] = api_fn
    let api_fp1 = compute_api_fingerprint(view(api_items1), 1usize)

    // Change a private helper item
    let mut api_items2 = api_items1
    api_items2[1] = api_item_input_default(ITEM_KIND_FN, ux2_sv("private_helper"), ux2_sv("api"), false)
    let api_fp2 = compute_api_fingerprint(view(api_items2), 2usize)
    let api_fp_inv = api_fingerprint_eq(api_fp1, api_fp2)

    // 2. SemanticFingerprint tracks inline MIR bodies
    let sem_item1 = semantic_item_input_default(ux2_sv("calc"))
    let mut sem_items1: [8]SemanticItemInput = [sem_item1; 8]
    sem_items1[0].is_inline = true
    sem_items1[0].inline_mir_body_hash = 500u64
    let sem_fp1 = compute_semantic_fingerprint(api_fp1, view(sem_items1), 1usize)

    let mut sem_items2 = sem_items1
    sem_items2[0].inline_mir_body_hash = 600u64 // inline body changed!
    let sem_fp2 = compute_semantic_fingerprint(api_fp1, view(sem_items2), 1usize)
    let sem_fp_inline_track = !semantic_fingerprint_eq(sem_fp1, sem_fp2)

    // 3. AbiFingerprint tracks physical layout shifts
    let dummy_abi = abi_layout_item_input_default(ux2_sv_empty(), ux2_sv_empty(), false)
    let mut abi_items1: [8]AbiLayoutItemInput = [dummy_abi; 8]
    let mut abi_struct = abi_layout_item_input_default(ux2_sv("Point"), ux2_sv("api"), true)
    abi_struct.size = 16u32
    abi_struct.align = 8u32
    abi_struct.field_offsets_hash = 50u64
    abi_items1[0] = abi_struct
    let abi_fp1 = compute_abi_fingerprint(view(target), view(abi_items1), 1usize)

    let mut abi_items2 = abi_items1
    abi_items2[0].field_offsets_hash = 80u64 // field offset shifted!
    let abi_fp2 = compute_abi_fingerprint(view(target), view(abi_items2), 1usize)
    let abi_fp_layout_shift = !abi_fingerprint_eq(abi_fp1, abi_fp2)

    // 4. Symbol version mangling & PE export aliases
    let mut buf_m1 = diag_buf_new()
    format_versioned_mangled_name(ux2_sv("pkg"), ux2_sv("mod"), ux2_sv("fn"), ux2_sv("1.0"), false, mut_view(buf_m1))
    let s_m1 = diag_buf_as_str_view(view(buf_m1))
    let exp_m1 = ux2_sv("axiom_pkg_mod_fn@1.0")

    let mut buf_m2 = diag_buf_new()
    format_versioned_mangled_name(ux2_sv("pkg"), ux2_sv("mod"), ux2_sv("fn"), ux2_sv("2.0"), true, mut_view(buf_m2))
    let s_m2 = diag_buf_as_str_view(view(buf_m2))
    let exp_m2 = ux2_sv("axiom_pkg_mod_fn@@2.0")

    let mangling_ok = ux2_sv_eq(s_m1, exp_m1) && ux2_sv_eq(s_m2, exp_m2)

    let mut buf_pe1 = diag_buf_new()
    format_pe_export_alias(ux2_sv("fn"), ux2_sv("1.0"), false, mut_view(buf_pe1))
    let s_pe1 = diag_buf_as_str_view(view(buf_pe1))
    let exp_pe1 = ux2_sv("fn_v1_0")

    let mut buf_pe2 = diag_buf_new()
    format_pe_export_alias(ux2_sv("fn"), ux2_sv("2.0"), true, mut_view(buf_pe2))
    let s_pe2 = diag_buf_as_str_view(view(buf_pe2))
    let exp_pe2 = ux2_sv("fn")

    let pe_alias_ok = ux2_sv_eq(s_pe1, exp_pe1) && ux2_sv_eq(s_pe2, exp_pe2)

    // 5. Coexistence & duplicate version rejection
    let dummy_export = versioned_export_desc_new(
        ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty(), false, ux2_sv_empty(), ux2_sv_empty()
    )
    let mut exports: [16]VersionedExportDesc = [dummy_export; 16]
    exports[0] = versioned_export_desc_new(
        ux2_sv("pkg"), ux2_sv("mod"), ux2_sv("fn"), ux2_sv("1.0"), false, s_m1, s_pe1
    )
    exports[1] = versioned_export_desc_new(
        ux2_sv("pkg"), ux2_sv("mod"), ux2_sv("fn"), ux2_sv("2.0"), true, s_m2, s_pe2
    )
    let mut sink_coexist = new_diag_sink()
    let coexistence_ok = validate_versioned_export_coexistence(view(exports), 2usize, mut_view(sink_coexist))

    // Duplicate version 1.0
    exports[1].version = ux2_sv("1.0")
    let mut sink_dup = new_diag_sink()
    let dup_rejected = (!validate_versioned_export_coexistence(view(exports), 2usize, mut_view(sink_dup))) &&
        sink_has_code(view(sink_dup), AX_ABI_SYMBOL_VERSION_DUPLICATE)

    out_str("api_fp_inv=")
    out_bool(api_fp_inv)
    out_str(" sem_fp_inline_track=")
    out_bool(sem_fp_inline_track)
    out_str(" abi_fp_layout_shift=")
    out_bool(abi_fp_layout_shift)
    out_str(" mangling_ok=")
    out_bool(mangling_ok)
    out_str(" pe_alias_ok=")
    out_bool(pe_alias_ok)
    out_str(" coexistence_ok=")
    out_bool(coexistence_ok)
    out_str(" dup_rejected=")
    out_bool(dup_rejected)
    out_str("\n")
}

// =============================================================================
// Probe 4: axiomc abi-check SemVer Matrix & CLI (AXS-ABI-040..042)
// =============================================================================
fn probe_abi_check_semver_matrix() {
    out_str("probe[abi_check_semver_matrix] ")

    let mut d_base = interface_descriptor_empty()
    d_base.package_name = ux2_sv("demo")
    d_base.module_path = ux2_sv("api")
    d_base.api_fingerprint = ApiFingerprint { lo: 100u64, hi: 101u64 }
    d_base.abi_fingerprint = AbiFingerprint { lo: 200u64, hi: 201u64 }
    d_base.struct_count = 1usize

    let mut s_base = interface_struct_desc_default(ux2_sv("Config"), ux2_sv("api"))
    s_base.size = 16u32
    s_base.align = 4u32
    s_base.is_extensible = false
    s_base.field_count = 2u32
    s_base.fields[0] = stable_field_desc_default(ux2_sv("w"), ux2_sv("u32"), STABLE_TYPE_U32, 4u32, 4u32)
    s_base.fields[0].offset = 0u32
    s_base.fields[1] = stable_field_desc_default(ux2_sv("h"), ux2_sv("u32"), STABLE_TYPE_U32, 4u32, 4u32)
    s_base.fields[1].offset = 4u32
    d_base.structs[0] = s_base

    // Struct field offset break -> major-breaking
    let mut d_shift = d_base
    d_shift.abi_fingerprint = AbiFingerprint { lo: 300u64, hi: 301u64 }
    d_shift.structs[0].fields[1].offset = 8u32
    let mut res_shift = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_shift), mut_view(res_shift))
    let struct_diff_ok = (res_shift.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // Function signature break (call_conv change) -> major-breaking
    let mut d_fn_base = d_base
    d_fn_base.fn_count = 1usize
    let mut f_base = interface_fn_desc_default(ux2_sv("exec"), ux2_sv("api"))
    f_base.call_conv = CALL_CONV_WIN64
    d_fn_base.fns[0] = f_base

    let mut d_fn_cand = d_fn_base
    d_fn_cand.abi_fingerprint = AbiFingerprint { lo: 400u64, hi: 401u64 }
    d_fn_cand.fns[0].call_conv = CALL_CONV_SYSV64
    let mut res_sig = interface_diff_result_empty()
    diff_interface_descriptors(view(d_fn_base), view(d_fn_cand), mut_view(res_sig))
    let sig_diff_ok = (res_sig.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // SemVer policy enforcement
    let p_patch_add = check_semver_policy(COMPAT_CLASS_MINOR_ADDITIVE, BUMP_PATCH, true)
    let p_minor_add = check_semver_policy(COMPAT_CLASS_MINOR_ADDITIVE, BUMP_MINOR, true)
    let p_minor_brk = check_semver_policy(COMPAT_CLASS_MAJOR_BREAKING, BUMP_MINOR, true)
    let p_major_brk = check_semver_policy(COMPAT_CLASS_MAJOR_BREAKING, BUMP_MAJOR, true)
    let p_downgrade = check_semver_policy(COMPAT_CLASS_IMPL_ONLY, BUMP_DOWNGRADE, true)

    let policy_matrix_ok = (p_patch_add == 2i32) && (p_minor_add == 0i32) &&
        (p_minor_brk == 1i32) && (p_major_brk == 0i32) && (p_downgrade == 2i32)

    // CLI execution in JSON mode
    let mut cfg_json = abi_check_cli_default()
    cfg_json.old_path = ux2_sv("base.axmeta")
    cfg_json.new_path = ux2_sv("cand.axmeta")
    cfg_json.old_version = ux2_sv("1.0.0")
    cfg_json.new_version = ux2_sv("1.1.0")
    cfg_json.has_semver = true
    cfg_json.json_mode = true

    let mut out_json = diag_buf_new()
    let mut err_json = diag_buf_new()
    let rc_json = abi_check_cmd_execute(view(cfg_json), view(d_base), view(d_shift), mut_view(out_json), mut_view(err_json))

    let json_text = diag_buf_as_str_view(view(out_json))
    let json_has_status = ux2_sv_contains(json_text, ux2_sv("\"status\""))
    let json_has_diffs = ux2_sv_contains(json_text, ux2_sv("\"differences\""))
    let cli_json_ok = (rc_json == 1i32) && json_has_status && json_has_diffs

    out_str("struct_diff_ok=")
    out_bool(struct_diff_ok)
    out_str(" sig_diff_ok=")
    out_bool(sig_diff_ok)
    out_str(" policy_matrix_ok=")
    out_bool(policy_matrix_ok)
    out_str(" cli_json_ok=")
    out_bool(cli_json_ok)
    out_str("\n")
}

pub fn main() -> i32 {
    probe_tiers_and_opaque_evolution()
    probe_boundary_firewall()
    probe_fingerprint_triple_and_symbols()
    probe_abi_check_semver_matrix()

    out_str("E20-5-ABI-STABILITY-COMPAT-CONFORMANCE-PROBE-PASS\n")
    0
}
