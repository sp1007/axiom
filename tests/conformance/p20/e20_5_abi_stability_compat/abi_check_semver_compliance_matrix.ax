// test: run
// modes: interp native
// stdout-file: abi_check_semver_compliance_matrix.stdout
// SPEC-114 §5 (AXS-ABI-040..042, AXS-ABI-050; tasks/0452 §193.14-21; tasks/0583 §324.11; REQ-PKG-022, REQ-PKG-024, INV-SABI-002):
// E20.5 Conformance: `axiomc abi-check` SemVer compliance matrix, 3-way change classification
// (compatible, minor-additive, major-breaking), policy enforcement with exact exit codes
// (0=PASS, 1=AX_ABI_BREAKING_CHANGE, 2=AX_ABI_SEMVER_MISMATCH), downgrade rejection, and JSON schema.

const COMPAT_CLASS_IDENTICAL: u8 = 0u8
const COMPAT_CLASS_IMPL_ONLY: u8 = 1u8
const COMPAT_CLASS_MINOR_ADDITIVE: u8 = 2u8
const COMPAT_CLASS_MAJOR_BREAKING: u8 = 3u8

const BUMP_PATCH: u8 = 0u8
const BUMP_MINOR: u8 = 1u8
const BUMP_MAJOR: u8 = 2u8
const BUMP_DOWNGRADE: u8 = 3u8

const AX_ABI_BREAKING_CHANGE: i32 = 1i32
const AX_ABI_SEMVER_MISMATCH: i32 = 2i32

// 1. SemVer increment evaluator (AXS-ABI-040)
@derive(Copy)
struct SemVerTriple {
    major: u32,
    minor: u32,
    patch: u32,
}

fn evaluate_semver_bump(old_v: SemVerTriple, new_v: SemVerTriple) -> u8 {
    let old_maj = old_v.major
    let new_maj = new_v.major
    if new_maj > old_maj {
        return BUMP_MAJOR
    }
    if old_maj > new_maj {
        return BUMP_DOWNGRADE
    }
    let old_min = old_v.minor
    let new_min = new_v.minor
    if new_min > old_min {
        return BUMP_MINOR
    }
    if old_min > new_min {
        return BUMP_DOWNGRADE
    }
    if new_v.patch >= old_v.patch {
        return BUMP_PATCH
    }
    BUMP_DOWNGRADE
}

// 2. SemVer Policy Enforcer (SPEC-114 §5, AXS-ABI-040..041)
fn check_semver_policy(
    overall_class: u8,
    bump: u8,
    has_semver: bool
) -> i32 {
    if !has_semver {
        // Without --semver flag: breaking change returns exit 1; non-breaking returns exit 0
        if overall_class == COMPAT_CLASS_MAJOR_BREAKING {
            return AX_ABI_BREAKING_CHANGE
        }
        return 0i32
    }

    // Downgrade is always rejected with exit 2
    if bump == BUMP_DOWNGRADE {
        return AX_ABI_SEMVER_MISMATCH
    }

    // Compatible / implementation-only changes pass in any forward bump (patch, minor, major)
    if overall_class == COMPAT_CLASS_IDENTICAL || overall_class == COMPAT_CLASS_IMPL_ONLY {
        return 0i32
    }

    // Minor additive changes require at least a minor release
    if overall_class == COMPAT_CLASS_MINOR_ADDITIVE {
        if bump == BUMP_PATCH {
            return AX_ABI_SEMVER_MISMATCH // exit 2
        }
        return 0i32 // minor or major bump passes
    }

    // Major breaking changes require an explicit major bump
    if overall_class == COMPAT_CLASS_MAJOR_BREAKING {
        if bump == BUMP_MAJOR {
            return 0i32 // explicit major bump passes
        }
        return AX_ABI_BREAKING_CHANGE // exit 1 on patch or minor bump
    }

    0i32
}

// 3. Classification of concrete change events (AXS-ABI-040)
const CHANGE_IMPL_BUG_FIX: u16 = 1u16
const CHANGE_PUB_FN_ADDED: u16 = 2u16
const CHANGE_EXT_STRUCT_APPEND: u16 = 3u16
const CHANGE_NON_EXHAUSTIVE_VARIANT_ADDED: u16 = 4u16
const CHANGE_CAPABILITY_RELAXED: u16 = 5u16
const CHANGE_PUB_FN_REMOVED: u16 = 6u16
const CHANGE_FIELD_OFFSET_SHIFTED: u16 = 7u16
const CHANGE_NON_EXT_FIELD_ADDED: u16 = 8u16
const CHANGE_PARAM_TYPE_CHANGED: u16 = 9u16
const CHANGE_RETURN_TYPE_CHANGED: u16 = 10u16
const CHANGE_CALL_CONV_CHANGED: u16 = 11u16
const CHANGE_CAPABILITY_TIGHTENED: u16 = 12u16

fn classify_change_event(event: u16) -> u8 {
    if event == CHANGE_IMPL_BUG_FIX {
        return COMPAT_CLASS_IMPL_ONLY
    }
    if event == CHANGE_PUB_FN_ADDED || event == CHANGE_EXT_STRUCT_APPEND ||
        event == CHANGE_NON_EXHAUSTIVE_VARIANT_ADDED || event == CHANGE_CAPABILITY_RELAXED {
        return COMPAT_CLASS_MINOR_ADDITIVE
    }
    COMPAT_CLASS_MAJOR_BREAKING
}

// 4. JSON schema validation helper
@derive(Copy)
struct DiffReportSummary {
    status_is_valid: bool,
    has_classification: bool,
    has_old_new_ver: bool,
    has_diff_list: bool,
}

fn validate_json_report_schema(
    rc: i32,
    overall_class: u8,
    diff_count: u32
) -> DiffReportSummary {
    let valid_status = (rc == 0i32) || (rc == AX_ABI_BREAKING_CHANGE) || (rc == AX_ABI_SEMVER_MISMATCH)
    let valid_class = overall_class <= COMPAT_CLASS_MAJOR_BREAKING
    let valid_diffs = diff_count > 0u32 || overall_class == COMPAT_CLASS_IDENTICAL

    DiffReportSummary {
        status_is_valid: valid_status,
        has_classification: valid_class,
        has_old_new_ver: true,
        has_diff_list: valid_diffs,
    }
}

pub fn main() -> i32 {
    let v_1_2_3 = SemVerTriple { major: 1u32, minor: 2u32, patch: 3u32 }
    let v_1_2_4 = SemVerTriple { major: 1u32, minor: 2u32, patch: 4u32 } // patch
    let v_1_3_0 = SemVerTriple { major: 1u32, minor: 3u32, patch: 0u32 } // minor
    let v_2_0_0 = SemVerTriple { major: 2u32, minor: 0u32, patch: 0u32 } // major
    let v_1_1_9 = SemVerTriple { major: 1u32, minor: 1u32, patch: 9u32 } // downgrade

    // 1. Verify bump evaluation
    let b_patch = evaluate_semver_bump(v_1_2_3, v_1_2_4)
    let b_minor = evaluate_semver_bump(v_1_2_3, v_1_3_0)
    let b_major = evaluate_semver_bump(v_1_2_3, v_2_0_0)
    let b_down = evaluate_semver_bump(v_1_2_3, v_1_1_9)

    let bumps_ok = (b_patch == BUMP_PATCH) && (b_minor == BUMP_MINOR) &&
        (b_major == BUMP_MAJOR) && (b_down == BUMP_DOWNGRADE)
    if !bumps_ok {
        return 1
    }

    // 2. Change event classification
    let c_fix = classify_change_event(CHANGE_IMPL_BUG_FIX)
    let c_add = classify_change_event(CHANGE_PUB_FN_ADDED)
    let c_ext = classify_change_event(CHANGE_EXT_STRUCT_APPEND)
    let c_del = classify_change_event(CHANGE_PUB_FN_REMOVED)
    let c_off = classify_change_event(CHANGE_FIELD_OFFSET_SHIFTED)
    let c_cc = classify_change_event(CHANGE_CALL_CONV_CHANGED)

    let classification_ok = (c_fix == COMPAT_CLASS_IMPL_ONLY) &&
        (c_add == COMPAT_CLASS_MINOR_ADDITIVE) &&
        (c_ext == COMPAT_CLASS_MINOR_ADDITIVE) &&
        (c_del == COMPAT_CLASS_MAJOR_BREAKING) &&
        (c_off == COMPAT_CLASS_MAJOR_BREAKING) &&
        (c_cc == COMPAT_CLASS_MAJOR_BREAKING)

    if !classification_ok {
        return 2
    }

    // 3. Patch policy verification
    // - impl fix under patch -> PASS (0)
    let p1 = check_semver_policy(COMPAT_CLASS_IMPL_ONLY, BUMP_PATCH, true)
    // - additive under patch -> REJECT (2)
    let p2 = check_semver_policy(COMPAT_CLASS_MINOR_ADDITIVE, BUMP_PATCH, true)
    // - breaking under patch -> REJECT (1)
    let p3 = check_semver_policy(COMPAT_CLASS_MAJOR_BREAKING, BUMP_PATCH, true)

    let patch_policy_ok = (p1 == 0i32) && (p2 == AX_ABI_SEMVER_MISMATCH) && (p3 == AX_ABI_BREAKING_CHANGE)
    if !patch_policy_ok {
        return 3
    }

    // 4. Minor policy verification
    // - impl fix under minor -> PASS (0)
    let m1 = check_semver_policy(COMPAT_CLASS_IMPL_ONLY, BUMP_MINOR, true)
    // - additive under minor -> PASS (0)
    let m2 = check_semver_policy(COMPAT_CLASS_MINOR_ADDITIVE, BUMP_MINOR, true)
    // - breaking under minor -> REJECT (1)
    let m3 = check_semver_policy(COMPAT_CLASS_MAJOR_BREAKING, BUMP_MINOR, true)

    let minor_additive_policy_ok = (m1 == 0i32) && (m2 == 0i32) && (m3 == AX_ABI_BREAKING_CHANGE)
    if !minor_additive_policy_ok {
        return 4
    }

    // 5. Major policy verification
    // - breaking under major -> PASS (0)
    let j1 = check_semver_policy(COMPAT_CLASS_MAJOR_BREAKING, BUMP_MAJOR, true)
    // - additive under major -> PASS (0)
    let j2 = check_semver_policy(COMPAT_CLASS_MINOR_ADDITIVE, BUMP_MAJOR, true)

    let major_breaking_policy_ok = (j1 == 0i32) && (j2 == 0i32)
    if !major_breaking_policy_ok {
        return 5
    }

    // 6. Downgrade rejection
    let d1 = check_semver_policy(COMPAT_CLASS_IMPL_ONLY, BUMP_DOWNGRADE, true)
    let d2 = check_semver_policy(COMPAT_CLASS_MAJOR_BREAKING, BUMP_DOWNGRADE, true)
    let downgrade_rejected = (d1 == AX_ABI_SEMVER_MISMATCH) && (d2 == AX_ABI_SEMVER_MISMATCH)
    if !downgrade_rejected {
        return 6
    }

    // 7. No-semver mode verification
    let n1 = check_semver_policy(COMPAT_CLASS_MINOR_ADDITIVE, BUMP_PATCH, false)
    let n2 = check_semver_policy(COMPAT_CLASS_MAJOR_BREAKING, BUMP_PATCH, false)
    let no_semver_mode_ok = (n1 == 0i32) && (n2 == AX_ABI_BREAKING_CHANGE)
    if !no_semver_mode_ok {
        return 7
    }

    // 8. JSON report schema validation
    let rep = validate_json_report_schema(0i32, COMPAT_CLASS_MINOR_ADDITIVE, 2u32)
    let json_schema_ok = rep.status_is_valid && rep.has_classification &&
        rep.has_old_new_ver && rep.has_diff_list
    if !json_schema_ok {
        return 8
    }

    print("abi_check_semver_compliance_matrix: patch_policy_ok=true minor_additive_policy_ok=true major_breaking_policy_ok=true downgrade_rejected=true no_semver_mode_ok=true json_schema_ok=true\n")
    print("ABI-CHECK-SEMVER-COMPLIANCE-MATRIX-OK\n")
    0
}
