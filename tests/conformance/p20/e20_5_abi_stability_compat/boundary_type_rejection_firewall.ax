// test: run
// modes: interp native
// stdout-file: boundary_type_rejection_firewall.stdout
// SPEC-114 §1, §2, §6 (AXS-ABI-004, AXS-ABI-010..017, AXS-ABI-050; REQ-ECO-8734, REQ-PKG-024, INV-SABI-001):
// E20.5 Conformance: Stable ABI firewall enforcing compile-time rejection of unstable types
// across @abi(stable) boundaries (capturing closures, unrepr'd ADTs, raw uninstantiated generics,
// bare fat pointers view/mut_view/Str, raw slices by value, dyn Trait, and owned String/Vec collections),
// extensible struct header verification, and allocator-paired buffer safety.

const AX_ABI_UNSTABLE_TYPE: u32 = 220u32
const AX_ABI_EXTENSIBLE_MISSING_HEADER: u32 = 221u32
const AX_FFI_GENERIC_EXPORT: u32 = 226u32

// Unstable type rejection taxonomy (AXS-ABI-017)
const UNSTABLE_CLOSURE_CAPTURING: u8 = 1u8
const UNSTABLE_UNREPR_ADT: u8 = 2u8
const UNSTABLE_UNINSTANTIATED_GENERIC: u8 = 3u8
const UNSTABLE_BARE_VIEW: u8 = 4u8
const UNSTABLE_BARE_STR: u8 = 5u8
const UNSTABLE_RAW_SLICE_BY_VAL: u8 = 6u8
const UNSTABLE_BARE_DYN_TRAIT: u8 = 7u8
const UNSTABLE_OWNED_COLLECTION: u8 = 8u8

// 1. Stable scalar validation (AXS-ABI-010)
@derive(Copy)
struct ScalarContract {
    type_id: u8,
    bit_width: u32,
    byte_align: u32,
    is_stable: bool,
}

fn check_scalar_contract(type_id: u8) -> ScalarContract {
    // 1=i8, 2=u8, 3=i16, 4=u16, 5=i32, 6=u32, 7=i64, 8=u64, 9=isize, 10=usize, 11=f32, 12=f64, 13=bool, 14=raw_ptr
    if type_id == 1u8 || type_id == 2u8 || type_id == 13u8 {
        return ScalarContract { type_id: type_id, bit_width: 8u32, byte_align: 1u32, is_stable: true }
    }
    if type_id == 3u8 || type_id == 4u8 {
        return ScalarContract { type_id: type_id, bit_width: 16u32, byte_align: 2u32, is_stable: true }
    }
    if type_id == 5u8 || type_id == 6u8 || type_id == 11u8 {
        return ScalarContract { type_id: type_id, bit_width: 32u32, byte_align: 4u32, is_stable: true }
    }
    if type_id == 7u8 || type_id == 8u8 || type_id == 9u8 || type_id == 10u8 || type_id == 12u8 || type_id == 14u8 {
        return ScalarContract { type_id: type_id, bit_width: 64u32, byte_align: 8u32, is_stable: true }
    }
    ScalarContract { type_id: type_id, bit_width: 0u32, byte_align: 0u32, is_stable: false }
}

fn is_valid_boolean_representation(b: u8) -> bool {
    // Boolean invariant (AXS-ABI-010 §2): 0x00=false, 0x01=true; any other value is illegal UB
    b == 0u8 || b == 1u8
}

// 2. Canonical stable views (AXS-ABI-014)
@repr(C)
@derive(Copy)
struct StableViewDesc {
    ptr: usize,
    len: usize,
}

fn validate_stable_view(v: StableViewDesc, elem_align: usize) -> bool {
    if v.len == 0usize {
        return true
    }
    // Non-empty view must have non-null, aligned pointer
    v.ptr != 0usize && (v.ptr % elem_align) == 0usize
}

// 3. Allocator-paired buffer contract (AXS-ABI-015)
@repr(C)
@derive(Copy)
struct AllocatorDispatch {
    allocator_token: u64,
    dealloc_count: u32,
}

fn buffer_deallocate(alloc: mut_view<AllocatorDispatch>, ptr_token: u64) -> bool {
    // Cross-heap protection: must dispatch through pairing vtable
    if alloc.allocator_token != 0u64 && ptr_token != 0u64 {
        alloc.dealloc_count = alloc.dealloc_count + 1u32
        return true
    }
    false
}

// 4. Stable ABI boundary typechecker firewall (AXS-ABI-004, AXS-ABI-016, AXS-ABI-017)
fn validate_boundary_type(type_kind: u8, is_repr_c: bool) -> u32 {
    // If it's a known unstable category, reject immediately with AX_ABI_UNSTABLE_TYPE
    if type_kind >= 1u8 && type_kind <= 8u8 {
        return AX_ABI_UNSTABLE_TYPE
    }
    // Unannotated ADT (struct/enum lacking explicit repr)
    if type_kind == 20u8 && !is_repr_c {
        return AX_ABI_UNSTABLE_TYPE
    }
    0u32
}

fn validate_generic_export(is_generic: bool, param_count: u32) -> u32 {
    // AXS-ABI-016: Cannot export unmonomorphized generic across dynamic boundary
    if is_generic || param_count > 0u32 {
        return AX_FFI_GENERIC_EXPORT
    }
    0u32
}

fn validate_extensible_struct(is_extensible: bool, has_header: bool, declared_ver: u32, struct_sz: u32) -> u32 {
    // AXS-ABI-011: Extensible struct MUST begin with canonical header
    if !is_extensible {
        return 0u32
    }
    if has_header && declared_ver >= 1u32 && struct_sz >= 8u32 {
        return 0u32
    }
    AX_ABI_EXTENSIBLE_MISSING_HEADER
}

pub fn main() -> i32 {
    // 1. Verify scalars
    let u8_k = check_scalar_contract(2u8)
    let u32_k = check_scalar_contract(6u8)
    let f64_k = check_scalar_contract(12u8)
    let ptr_k = check_scalar_contract(14u8)
    let bad_k = check_scalar_contract(99u8)

    let scalars_ok = u8_k.is_stable && u8_k.byte_align == 1u32 &&
        u32_k.is_stable && u32_k.byte_align == 4u32 &&
        f64_k.is_stable && f64_k.byte_align == 8u32 &&
        ptr_k.is_stable && ptr_k.bit_width == 64u32 &&
        !bad_k.is_stable &&
        is_valid_boolean_representation(0u8) &&
        is_valid_boolean_representation(1u8) &&
        !is_valid_boolean_representation(2u8) &&
        !is_valid_boolean_representation(255u8)

    if !scalars_ok {
        return 1
    }

    // 2. Canonical stable views
    let v_empty = StableViewDesc { ptr: 0usize, len: 0usize }
    let v_valid = StableViewDesc { ptr: 0x1000usize, len: 64usize }
    let v_unaligned = StableViewDesc { ptr: 0x1003usize, len: 64usize }
    let v_null_nonempty = StableViewDesc { ptr: 0usize, len: 32usize }

    let views_ok = validate_stable_view(v_empty, 8usize) &&
        validate_stable_view(v_valid, 8usize) &&
        !validate_stable_view(v_unaligned, 8usize) &&
        !validate_stable_view(v_null_nonempty, 8usize)

    if !views_ok {
        return 2
    }

    // 3. Allocator-paired buffer
    let mut alloc = AllocatorDispatch { allocator_token: 0xFEEDFACE00112233u64, dealloc_count: 0u32 }
    let dealloc_ok = buffer_deallocate(mut_view(alloc), 0xAA00BB00u64)
    let bad_dealloc = buffer_deallocate(mut_view(alloc), 0u64)
    let buffer_alloc_ok = dealloc_ok && !bad_dealloc && (alloc.dealloc_count == 1u32)

    if !buffer_alloc_ok {
        return 3
    }

    // 4. Boundary firewall rejection of unstable types
    let rc_closure = validate_boundary_type(UNSTABLE_CLOSURE_CAPTURING, false)
    let rc_unrepr = validate_boundary_type(UNSTABLE_UNREPR_ADT, false)
    let rc_generic_param = validate_boundary_type(UNSTABLE_UNINSTANTIATED_GENERIC, false)
    let rc_view = validate_boundary_type(UNSTABLE_BARE_VIEW, false)
    let rc_str = validate_boundary_type(UNSTABLE_BARE_STR, false)
    let rc_slice = validate_boundary_type(UNSTABLE_RAW_SLICE_BY_VAL, false)
    let rc_dyn_trait = validate_boundary_type(UNSTABLE_BARE_DYN_TRAIT, false)
    let rc_owned = validate_boundary_type(UNSTABLE_OWNED_COLLECTION, false)
    let rc_unrepr_adt = validate_boundary_type(20u8, false)
    let rc_repr_c_adt = validate_boundary_type(20u8, true)

    let all_rejected = (rc_closure == AX_ABI_UNSTABLE_TYPE) &&
        (rc_unrepr == AX_ABI_UNSTABLE_TYPE) &&
        (rc_generic_param == AX_ABI_UNSTABLE_TYPE) &&
        (rc_view == AX_ABI_UNSTABLE_TYPE) &&
        (rc_str == AX_ABI_UNSTABLE_TYPE) &&
        (rc_slice == AX_ABI_UNSTABLE_TYPE) &&
        (rc_dyn_trait == AX_ABI_UNSTABLE_TYPE) &&
        (rc_owned == AX_ABI_UNSTABLE_TYPE) &&
        (rc_unrepr_adt == AX_ABI_UNSTABLE_TYPE) &&
        (rc_repr_c_adt == 0u32)

    if !all_rejected {
        return 4
    }

    // 5. Generic export rejection
    let rc_gen_exp = validate_generic_export(true, 1u32)
    let rc_mono_exp = validate_generic_export(false, 0u32)
    let generic_rejected = (rc_gen_exp == AX_FFI_GENERIC_EXPORT) && (rc_mono_exp == 0u32)
    if !generic_rejected {
        return 5
    }

    // 6. Extensible struct header
    let rc_ext_ok = validate_extensible_struct(true, true, 1u32, 24u32)
    let rc_ext_no_hdr = validate_extensible_struct(true, false, 1u32, 24u32)
    let rc_ext_bad_sz = validate_extensible_struct(true, true, 1u32, 4u32)
    let rc_non_ext = validate_extensible_struct(false, false, 0u32, 16u32)

    let header_rejected = (rc_ext_ok == 0u32) &&
        (rc_ext_no_hdr == AX_ABI_EXTENSIBLE_MISSING_HEADER) &&
        (rc_ext_bad_sz == AX_ABI_EXTENSIBLE_MISSING_HEADER) &&
        (rc_non_ext == 0u32)

    if !header_rejected {
        return 6
    }

    print("boundary_type_rejection_firewall: scalars_ok=true views_ok=true buffer_allocator_ok=true unstable_types_rejected=true generic_export_rejected=true missing_header_rejected=true\n")
    print("BOUNDARY-TYPE-REJECTION-FIREWALL-OK\n")
    0
}
