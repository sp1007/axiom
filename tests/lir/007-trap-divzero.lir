lir_body {
    slot0: type#8;
    slot1: type#8;
    slot2: type#8;
    slot3: type#8;
    slot4: type#8;
    slot5: type#4;
    slot6: type#4;
    slot7: type#4;
    bb0: {
        v0 = const 1;
        v1 = stack_addr slot1;
        store v1, v0;
        v2 = stack_addr slot1;
        v3 = load v2;
        v4 = stack_addr slot2;
        store v4, v3;
        v5 = const 0;
        v6 = stack_addr slot3;
        store v6, v5;
        v7 = stack_addr slot3;
        v8 = load v7;
        v9 = stack_addr slot4;
        store v9, v8;
        v10 = stack_addr slot4;
        v11 = load v10;
        v12 = const 0;
        v13 = icmp.ne v11, v12;
        v14 = stack_addr slot5;
        store v14, v13;
        v15 = stack_addr slot5;
        v16 = load v15;
        assert v16, bb1, "division by zero";
    }
    bb1: {
        v17 = stack_addr slot2;
        v18 = load v17;
        v19 = stack_addr slot4;
        v20 = load v19;
        v21 = sdiv_overflow v18, v20;
        v22 = stack_addr slot7;
        store v22, v21;
        v23 = stack_addr slot7;
        v24 = load v23;
        v25 = not v24;
        v26 = stack_addr slot6;
        store v26, v25;
        v27 = stack_addr slot6;
        v28 = load v27;
        assert v28, bb3, "arithmetic overflow";
    }
    bb2: {
        unreachable;
    }
    bb3: {
        v29 = stack_addr slot2;
        v30 = load v29;
        v31 = stack_addr slot4;
        v32 = load v31;
        v33 = div v30, v32;
        v34 = stack_addr slot0;
        store v34, v33;
        return;
    }
    bb4: {
        unreachable;
    }
}
