lir_body {
    slot0: type#8;
    slot1: type#8;
    slot2: type#4;
    slot3: type#4;
    slot4: type#4;
    slot5: type#8;
    slot6: type#3;
    bb0: {
        v0 = const 0;
        v1 = const 0;
        v2 = icmp.ne v0, v1;
        v3 = stack_addr slot2;
        store v3, v2;
        v4 = stack_addr slot2;
        v5 = load v4;
        assert v5, bb1, "division by zero";
    }
    bb1: {
        v6 = const 1;
        v7 = const 0;
        v8 = sdiv_overflow v6, v7;
        v9 = stack_addr slot4;
        store v9, v8;
        v10 = stack_addr slot4;
        v11 = load v10;
        v12 = not v11;
        v13 = stack_addr slot3;
        store v13, v12;
        v14 = stack_addr slot3;
        v15 = load v14;
        assert v15, bb3, "arithmetic overflow";
    }
    bb2: {
        unreachable;
    }
    bb3: {
        v16 = const 1;
        v17 = const 0;
        v18 = div v16, v17;
        v19 = stack_addr slot1;
        store v19, v18;
        v20 = stack_addr slot1;
        v21 = load v20;
        v22 = stack_addr slot5;
        store v22, v21;
        v23 = const 0;
        v24 = stack_addr slot0;
        store v24, v23;
        return;
    }
    bb4: {
        unreachable;
    }
}
