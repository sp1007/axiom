// test: helper

fn exercise_atomic_widths_and_ops(
    b: view<AtomicBool>,
    u8a: view<AtomicU8>,
    u16a: view<AtomicU16>,
    u32a: view<AtomicU32>,
    u64a: view<AtomicU64>,
    pa: view<Atomic<*mut u64>>,
    raw_ptr: *mut u64
) -> u64 {
    let b0 = b.load(Ordering.Acquire);
    b.store(!b0, Ordering.Release);
    let b1 = b.swap(true, Ordering.AcqRel);
    let _ = b.fetch_and(true, Ordering.Relaxed);
    let _ = b.fetch_or(false, Ordering.Relaxed);
    let _ = b.fetch_xor(b1, Ordering.SeqCst);

    let x8 = u8a.load(Ordering.Relaxed);
    u8a.store(x8, Ordering.SeqCst);
    let _ = u8a.fetch_add(1u8, Ordering.Acquire);

    let x16 = u16a.load(Ordering.SeqCst);
    u16a.store(x16, Ordering.Relaxed);
    let _ = u16a.fetch_sub(2u16, Ordering.Release);

    let x32 = u32a.load(Ordering.Acquire);
    u32a.store(x32, Ordering.Release);
    let _ = u32a.fetch_xor(7u32, Ordering.AcqRel);

    let v0 = u64a.load(Ordering.Acquire);
    u64a.store(v0, Ordering.Release);
    let v1 = u64a.swap(10u64, Ordering.AcqRel);
    let v2 = u64a.fetch_add(1u64, Ordering.SeqCst);
    let v3 = u64a.fetch_sub(1u64, Ordering.Relaxed);
    let v4 = u64a.fetch_and(255u64, Ordering.Relaxed);
    let v5 = u64a.fetch_or(16u64, Ordering.Relaxed);
    let v6 = u64a.fetch_xor(1u64, Ordering.Relaxed);
    let r1 = u64a.compare_exchange(v1, v2, Ordering.AcqRel, Ordering.Acquire);
    let r2 = u64a.compare_exchange_weak(v3, v4, Ordering.Release, Ordering.Relaxed);

    let p0 = pa.load(Ordering.Acquire);
    pa.store(raw_ptr, Ordering.Release);
    let _ = pa.swap(p0, Ordering.SeqCst);
    let _ = pa.compare_exchange(raw_ptr, p0, Ordering.SeqCst, Ordering.Acquire);

    fence(Ordering.Acquire);
    fence(Ordering.Release);
    fence(Ordering.AcqRel);
    fence(Ordering.SeqCst);
    compiler_fence(Ordering.Acquire);
    compiler_fence(Ordering.Release);
    compiler_fence(Ordering.AcqRel);
    compiler_fence(Ordering.SeqCst);
    spin_loop_hint();

    if r1.ok && r2.ok {
        v5
    } else {
        v6
    }
}

fn main() {
    let raw: *mut u64 = 0 as *mut u64;
    let b = AtomicBool.new(false);
    let u8a = AtomicU8.new(1u8);
    let u16a = AtomicU16.new(2u16);
    let u32a = AtomicU32.new(3u32);
    let u64a = AtomicU64.new(42u64);
    let pa: Atomic<*mut u64> = Atomic.new(raw);
    let _ = exercise_atomic_widths_and_ops(
        view(b),
        view(u8a),
        view(u16a),
        view(u32a),
        view(u64a),
        view(pa),
        raw
    );
}
