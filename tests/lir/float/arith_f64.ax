// test: helper
// Generated by gen_float_cases.py (T459) -- do not edit; expected output: arith_f64.txt
// Native SSE2 scalar float semantics (SPEC-41 AXS-FLT-010..025, AXS-FLT-040..044); oracle: Python IEEE-754.
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn f64_of(b: i64) -> f64 {
    unsafe { *(address_of(b) as *const f64) }
}

fn f32_of(b: i32) -> f32 {
    unsafe { *(address_of(b) as *const f32) }
}

fn show64(x: f64) {
    if x != x {
        print("nan\n");
        return;
    }
    print_int(unsafe { *(address_of(x) as *const i64) });
    print("\n");
}

fn show32(x: f32) {
    if x != x {
        print("nan\n");
        return;
    }
    print_int((unsafe { *(address_of(x) as *const i32) }) as i64);
    print("\n");
}

fn main() -> i32 {
    let raw: [13]i64 = [0i64, (-9223372036854775807i64 - 1i64), 4607182418800017408i64, -4613937818241073152i64, 4614500768194494464i64, 4591870180066957722i64, 9094988921128908188i64, -9104749988965452967i64, 1i64, 9218868437227405311i64, 9218868437227405312i64, -4503599627370496i64, 9221120237041090560i64];
    let mut vals: [13]f64 = [0.0; 13];
    let mut k: usize = 0;
    while k < 13 {
        vals[k] = f64_of(raw[k]);
        k = k + 1;
    }
    let mut i: usize = 0;
    while i < 13 {
        let mut j: usize = 0;
        while j < 13 {
            let a: f64 = vals[i];
            let b: f64 = vals[j];
            show64(a + b);
            show64(a - b);
            show64(a * b);
            show64(a / b);
            show64(a % b);
            j = j + 1;
        }
        i = i + 1;
    }
    0
}
