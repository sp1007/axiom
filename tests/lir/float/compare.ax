// Native SSE2 scalar float semantics (SPEC-41 AXS-FLT-010..025, AXS-FLT-040..044); oracle: Python IEEE-754.
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn f64_of(b: i64) -> f64 {
    unsafe { *(address_of(b) as *const f64) }
}

fn f32_of(b: i32) -> f32 {
    unsafe { *(address_of(b) as *const f32) }
}

fn show64(x: f64) {
    if x != x {
        print("nan\n");
        return;
    }
    print_int(unsafe { *(address_of(x) as *const i64) });
    print("\n");
}

fn show32(x: f32) {
    if x != x {
        print("nan\n");
        return;
    }
    print_int((unsafe { *(address_of(x) as *const i32) }) as i64);
    print("\n");
}

fn mask64(a: f64, b: f64) -> i64 {
    let mut m: i64 = 0i64;
    let eq = a == b;
    let ne = a != b;
    let lt = a < b;
    let le = a <= b;
    let gt = a > b;
    let ge = a >= b;
    if eq { m = m + 1i64; }
    if ne { m = m + 2i64; }
    if lt { m = m + 4i64; }
    if le { m = m + 8i64; }
    if gt { m = m + 16i64; }
    if ge { m = m + 32i64; }
    m
}

fn branch64(a: f64, b: f64) -> i64 {
    let mut m: i64 = 0i64;
    if a == b { m = m + 1i64; }
    if a != b { m = m + 2i64; }
    if a < b { m = m + 4i64; }
    if a <= b { m = m + 8i64; }
    if a > b { m = m + 16i64; }
    if a >= b { m = m + 32i64; }
    m
}

fn mask32(a: f32, b: f32) -> i64 {
    let mut m: i64 = 0i64;
    if a == b { m = m + 1i64; }
    if a != b { m = m + 2i64; }
    if a < b { m = m + 4i64; }
    if a <= b { m = m + 8i64; }
    if a > b { m = m + 16i64; }
    if a >= b { m = m + 32i64; }
    m
}

