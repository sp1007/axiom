// test: helper
// Generated by gen_float_cases.py (T459) -- do not edit; expected output: float_to_int.txt
// Native SSE2 scalar float semantics (SPEC-41 AXS-FLT-010..025, AXS-FLT-040..044); oracle: Python IEEE-754.
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn f64_of(b: i64) -> f64 {
    unsafe { *(address_of(b) as *const f64) }
}

fn f32_of(b: i32) -> f32 {
    unsafe { *(address_of(b) as *const f32) }
}

fn show64(x: f64) {
    if x != x {
        print("nan\n");
        return;
    }
    print_int(unsafe { *(address_of(x) as *const i64) });
    print("\n");
}

fn show32(x: f32) {
    if x != x {
        print("nan\n");
        return;
    }
    print_int((unsafe { *(address_of(x) as *const i32) }) as i64);
    print("\n");
}

fn main() -> i32 {
    let raw: [37]i64 = [0i64, (-9223372036854775807i64 - 1i64), 4606281698874543309i64, -4617090337980232499i64, 4609434218613702656i64, -4613937818241073152i64, 4638700579317193114i64, 4638707616191610880i64, -4584646828477120512i64, -4584629236291076096i64, 4643193623632936960i64, 4643211215818981376i64, 4674736275771621376i64, -4548635527436933530i64, 4679239999094049997i64, 4746794007246405632i64, 4746794007248502784i64, -4476578029604385587i64, -4476578029604175872i64, 4751297606875663565i64, 4751297606875873280i64, 4890909195324358655i64, 4890909195324358656i64, -4332462841530417152i64, -4332462841530417151i64, 4895412794951729151i64, 4895412794951729152i64, 5179132097285906349i64, 5179139571476070400i64, -4044232465378705408i64, 5183635696913276845i64, 5183643171103440896i64, -4039728865751334912i64, 9094988921128908188i64, 9218868437227405312i64, -4503599627370496i64, 9221120237041090560i64];
    let mut i: usize = 0;
    while i < 37 {
        let x = f64_of(raw[i]);
        let y = x as f32;
        print_int(x as i8);
        print(" ");
        print_int(y as i8);
