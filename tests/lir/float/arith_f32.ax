// test: helper
// Generated by gen_float_cases.py (T459) -- do not edit; expected output: arith_f32.txt
// Native SSE2 scalar float semantics (SPEC-41 AXS-FLT-010..025, AXS-FLT-040..044); oracle: Python IEEE-754.
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn f64_of(b: i64) -> f64 {
    unsafe { *(address_of(b) as *const f64) }
}

fn f32_of(b: i32) -> f32 {
    unsafe { *(address_of(b) as *const f32) }
}

fn show64(x: f64) {
    if x != x {
        print("nan\n");
        return;
    }
    print_int(unsafe { *(address_of(x) as *const i64) });
    print("\n");
}

fn show32(x: f32) {
    if x != x {
        print("nan\n");
        return;
    }
    print_int((unsafe { *(address_of(x) as *const i32) }) as i64);
    print("\n");
}

fn main() -> i32 {
    let raw: [13]i32 = [0i32, (-2147483647i32 - 1i32), 1065353216i32, -1077936128i32, 1078984704i32, 1036831949i32, 2139095039i32, -2139095040i32, 1i32, 1266679809i32, 2139095040i32, -8388608i32, 2143289344i32];
    let mut vals: [13]f32 = [0.0f32; 13];
    let mut k: usize = 0;
    while k < 13 {
        vals[k] = f32_of(raw[k]);
        k = k + 1;
    }
    let mut i: usize = 0;
    while i < 13 {
        let mut j: usize = 0;
        while j < 13 {
            let a: f32 = vals[i];
            let b: f32 = vals[j];
            show32(a + b);
            show32(a - b);
            show32(a * b);
            show32(a / b);
            show32(a % b);
            j = j + 1;
        }
        i = i + 1;
    }
    0
}
