// test: helper
// T459: LIR lowering of scalar f32/f64 operations (SPEC-41 AXS-FLT-040..044, SPEC-04 AXS-EXT-050) and
// their SSE2 instruction selection; inspected by float_ops_lir.test (--emit=lir) and float_ops_mi.test.

fn arith64(a: f64, b: f64) -> f64 {
    let s = a + b;
    let d = a - b;
    let m = a * b;
    let q = a / b;
    let r = a % b;
    -(s + d + m + q + r)
}

fn arith32(a: f32, b: f32) -> f32 {
    (a + b) * (a - b) / (a % b)
}

fn cmps(a: f64, b: f64, c: f32, d: f32) -> i32 {
    let mut k = 0;
    if a == b { k = k + 1; }
    if a != b { k = k + 2; }
    if a < b { k = k + 4; }
    if a <= b { k = k + 8; }
    if c > d { k = k + 16; }
    if c >= d { k = k + 32; }
    k
}

fn casts(x: f64, y: f32, i: i32, u: u64, w: i128, z: u128) -> i64 {
    let a = x as i32;
    let b = y as u8;
    let c = x as u64;
    let e = y as i128;
    let f = x as u128;
    let g = i as f64;
    let h = u as f32;
    let j = w as f64;
    let k = z as f32;
    let l = y as f64;
    let m = x as f32;
    (a as i64) + (b as i64) + (c as i64) + (e as i64) + (f as i64) + (g as i64) + (h as i64) +
        (j as i64) + (k as i64) + (l as i64) + (m as i64)
}

fn main() -> i32 {
    let v = arith64(7.5, 2.0) + (arith32(5.0f32, 3.0f32) as f64);
    cmps(v, 1.0, 2.0f32, 1.0f32) + (casts(v, 3.5f32, -4, 10u64, 5i128, 6u128) as i32)
}
