cmd: {compiler} inspect --emit=mi -O0 --std-root {std_root} {test_dir}/float_ops_lir.ax
exit: 0
stdout-contains: addsd xmm0, xmm1
stdout-contains: addss xmm0, xmm1
stdout-contains: subsd xmm0, xmm1
stdout-contains: subss xmm0, xmm1
stdout-contains: mulsd xmm0, xmm1
stdout-contains: mulss xmm0, xmm1
stdout-contains: divsd xmm0, xmm1
stdout-contains: divss xmm0, xmm1
stdout-contains: fprem.sd
stdout-contains: fprem.ss
stdout-contains: ucomisd xmm0, xmm1
stdout-contains: ucomisd xmm1, xmm0
stdout-contains: ucomiss xmm0, xmm1
stdout-contains: ucomisd xmm0, xmm0
stdout-contains: setcc 11, rcx
stdout-contains: setcc 10, rcx
stdout-contains: setcc 7, rax
stdout-contains: setcc 3, rax
stdout-contains: cvtsi2sd xmm0, rax
stdout-contains: cvtsi2ss xmm0, rax
stdout-contains: cvttsd2si rax, xmm0
stdout-contains: cvttss2si rax, xmm0
stdout-contains: cvttsd2si rcx, xmm2
stdout-contains: cvtss2sd xmm0, xmm0
stdout-contains: cvtsd2ss xmm0, xmm0
