cmd: {compiler} inspect --emit=lir tests/lir/qa_edge_cond_br.mir
stdout: lir_body {\n    slot0: type#7;\n    slot1: type#7;\n    slot2: type#7;\n    bb0: {\n        v0 = const 0;\n        v1 = stack_addr slot1;\n        store v1, v0;\n        v2 = stack_addr slot1;\n        v3 = load v2;\n        switch v3 [\n            0: bb1,\n            otherwise: bb2\n        ];\n    }\n    bb1: {\n        v4 = const 1;\n        v5 = stack_addr slot0;\n        store v5, v4;\n        return;\n    }\n    bb2: {\n        v6 = const 2;\n        v7 = stack_addr slot0;\n        store v7, v6;\n        return;\n    }\n}\n
