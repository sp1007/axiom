cmd: {compiler} inspect --emit=lir tests/lir/qa_edge_cond_br.mir
stdout: lir_body {\n    slot0: type#7;\n    slot1: type#7;\n    slot2: type#7;\n    bb0: {\n        v1 = const 0;\n        v2 = stack_addr slot1;\n        store v2, v1;\n        v3 = stack_addr slot1;\n        v4 = load v3;\n        switch v4 [\n            0: bb1,\n            otherwise: bb2\n        ];\n    }\n    bb1: {\n        v5 = const 1;\n        v6 = stack_addr slot0;\n        store v6, v5;\n        return;\n    }\n    bb2: {\n        v7 = const 2;\n        v8 = stack_addr slot0;\n        store v8, v7;\n        return;\n    }\n}\n
