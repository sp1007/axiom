lir_body {
    slot0: type#8;
    slot1: type#2;
    slot2: type#4;
    slot3: type#8;
    slot4: type#8;
    bb0: {
        jmp bb1;
    }
    bb1: {
        v0 = const 1;
        v1 = const 0;
        v2 = icmp.sgt v0, v1;
        v3 = stack_addr slot2;
        store v3, v2;
        v4 = stack_addr slot2;
        v5 = load v4;
        switch v5 [
            1: bb2,
            otherwise: bb3
        ];
    }
    bb2: {
        v6 = const 1;
        v7 = stack_addr slot3;
        store v7, v6;
        v8 = stack_addr slot3;
        v9 = load v8;
        v10 = stack_addr slot4;
        store v10, v9;
        jmp bb1;
    }
    bb3: {
        v11 = const 0;
        v12 = stack_addr slot0;
        store v12, v11;
        return;
    }
}
