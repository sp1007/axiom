cmd: {compiler} inspect --emit=mi -O0 --std-root {std_root} {test_dir}/int128_ops_lir.ax
exit: 0
stdout-contains: adc rdx, [frame#
stdout-contains: sbb rdx, [frame#
stdout-contains: shld rdx, rax, rcx
stdout-contains: shrd rax, rdx, rcx
stdout-contains: sar rdx, rcx
stdout-contains: test rcx, 64
stdout-contains: cmovcc 5, rdx, rax
stdout-contains: cmovcc 2, rax, r8
stdout-contains: cmovcc 0, rax, r9
stdout-contains: cmovcc 5, rcx, r10
stdout-contains: udiv128 0
stdout-contains: udiv128 1
stdout-contains: mul r11
stdout-contains: adc r10, 0
stdout-contains: sbb r10, rdx
