// test: helper
// T453: LIR register-pair lowering of i128/u128 operations (SPEC-40 AXS-INT-010, SPEC-04 AXS-EXT-050).

fn ops_signed(a: i128, b: i128, s: u32, n: i8) -> i128 {
    let c = a + b;
    let d = c - b;
    let e = d * b;
    let f = e / b;
    let g = f % b;
    let h = (g & a) | (b ^ a);
    let k = h >> (s as i128);
    let m = -k;
    let q = ~m;
    let w = a.wrapping_add(b).wrapping_mul(q);
    let x = a.saturating_add(b).saturating_sub(w).saturating_mul(k);
    let y = x + (n as i128);
    if y < a {
        return (y as i64) as i128;
    }
    y
}

fn ops_unsigned(a: u128, b: u128, s: u32, t: u16) -> u128 {
    let c = a + b;
    let d = c - b;
    let e = d * b;
    let f = e / b;
    let g = f % b;
    let k = (g << (s as u128)) >> (s as u128);
    let x = a.saturating_add(b).saturating_sub(k).saturating_mul(c);
    let z = x + (t as u128) + 0x1234567890ABCDEF0011223344556677u128;
    if z >= a {
        return z;
    }
    0u128
}
