lir_body {
    slot0: type#7;
    slot1: type#7;
    slot2: type#7;
    bb0: {
        v0 = const 0;
        v1 = stack_addr slot1;
        store v1, v0;
        v2 = stack_addr slot1;
        v3 = load v2;
        switch v3 [
            0: bb1,
            otherwise: bb2
        ];
    }
    bb1: {
        v4 = const 1;
        v5 = stack_addr slot0;
