lir_body {
    slot0: type#8;
    slot1: type#11;
    slot2: type#11;
    slot3: type#11;
    slot4: type#11;
    slot5: type#2;
    slot6: type#4;
    slot7: type#3;
    slot8: type#6;
    slot9: type#4;
    slot10: type#4;
    slot11: type#6;
    slot12: type#6;
    slot13: type#4;
    slot14: type#4;
    slot15: type#6;
    slot16: type#3;
    bb0: {
        v0 = const 0;
        v1 = stack_addr slot1;
        store v1, v0;
        v2 = stack_addr slot1;
        v3 = load v2;
        v4 = stack_addr slot2;
        store v4, v3;
        v5 = stack_addr slot2;
        v6 = load v5;
        v7 = bitnot v6;
        v8 = stack_addr slot3;
        store v8, v7;
        v9 = stack_addr slot3;
        v10 = load v9;
        v11 = stack_addr slot4;
        store v11, v10;
        v12 = stack_addr slot4;
        v13 = load v12;
        v14 = const 255;
        v15 = icmp.ne v13, v14;
        v16 = stack_addr slot6;
        store v16, v15;
        v17 = stack_addr slot6;
        v18 = load v17;
        switch v18 [
            0: bb2,
            otherwise: bb1
        ];
    }
    bb1: {
        v19 = const 1;
        v20 = stack_addr slot0;
        store v20, v19;
        return;
    }
    bb2: {
        jmp bb3;
    }
    bb3: {
        v21 = const 0;
        v22 = const 128;
        v23 = ssub_overflow v21, v22;
        v24 = stack_addr slot9;
        store v24, v23;
        v25 = stack_addr slot9;
        v26 = load v25;
        v27 = not v26;
        v28 = stack_addr slot10;
        store v28, v27;
        v29 = stack_addr slot10;
        v30 = load v29;
        assert v30, bb4, "arithmetic overflow";
    }
    bb4: {
        v31 = const 128;
        v32 = neg v31;
        v33 = stack_addr slot8;
        store v33, v32;
        v34 = stack_addr slot8;
        v35 = load v34;
        v36 = stack_addr slot11;
        store v36, v35;
        v37 = const 0;
        v38 = const 1;
        v39 = ssub_overflow v37, v38;
        v40 = stack_addr slot13;
        store v40, v39;
        v41 = stack_addr slot13;
        v42 = load v41;
        v43 = not v42;
        v44 = stack_addr slot14;
        store v44, v43;
        v45 = stack_addr slot14;
        v46 = load v45;
        assert v46, bb6, "arithmetic overflow";
    }
    bb5: {
        unreachable;
    }
    bb6: {
        v47 = const 1;
        v48 = neg v47;
        v49 = stack_addr slot12;
        store v49, v48;
        v50 = stack_addr slot12;
        v51 = load v50;
        v52 = stack_addr slot15;
        store v52, v51;
        v53 = const 0;
        v54 = stack_addr slot0;
        store v54, v53;
        return;
    }
    bb7: {
        unreachable;
    }
}
