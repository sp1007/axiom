// test: ui
// QA T428m adversarial: qualified names deep inside generic arguments get exactly one diagnostic each (a private
// item two levels down, an unknown member three levels down, an unknown module), while the T447 projection
// `F.Output` and `Self.Output` nested inside arguments stay accepted with no diagnostic.

struct Bag<T> {
    pub item: T,
}

fn priv_deep(o: Option<Bag<a.Hidden>>) -> i32 { //~ ERROR AX_NAME_PRIVATE
    0
}

fn missing_deep(o: Option<Option<Bag<a.Missing>>>) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn no_module(o: Result<a.Shown, nomod.S>) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn proj_deep<F: Future<Output = a.Shown>>(o: Option<Option<Bag<F.Output>>>) -> i32 {
    0
}

struct Ready {
    pub v: i32,
}

impl Future for Ready {
    type Output = a.Shown

    fn poll(self: mut_view<Ready>, cx: mut_view<Context>) -> Poll<Self.Output> {
        Poll.Ready(a.Shown { v: self.v })
    }
}

fn main() -> i32 {
    0
}
