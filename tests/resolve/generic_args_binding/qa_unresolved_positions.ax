// test: ui
// QA T428m adversarial: an unresolved name inside a generic argument gives exactly one AX_NAME_UNRESOLVED, in every
// position a generic argument list can appear (nested `A<B<C<x>>>`, an unresolved head with an unresolved argument,
// an associated-type binding in a bound, an impl self type, a slice element, an expression path, a method call, a
// callee, a let annotation, a struct literal, a cast). A generic parameter shadows nothing it should not: `T` below
// is a parameter, not an error. A name that resolves elsewhere in the same list does not hide the bad one.
struct Bag<T> {
    item: T,
}

impl<T> Bag<T> {
    fn new(item: T) -> Bag<T> {
        Bag { item: item }
    }

    fn conv<U>(self: view<Bag<T>>, u: U) -> U {
        u
    }
}

trait Tr {
    fn m(self: view<Self>) -> i32
}

struct Z {
    v: i32,
}

fn sz<T>() -> i32 {
    0
}

fn nested(o: Option<Option<Bag<Missing1>>>) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn both(o: Unknown2<Missing3>) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    //~^ ERROR AX_NAME_UNRESOLVED
    0
}

fn bound<F: Future<Output = Missing4>>(f: F) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

impl Tr for Bag<Missing5> { //~ ERROR AX_NAME_UNRESOLVED
    fn m(self: view<Self>) -> i32 {
        0
    }
}

fn slice_arg(o: Option<*const [Missing6]>) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn mixed(o: Result<Z, Bag<Missing7>>) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn shadow<T>(o: Option<Bag<T>>) -> Option<Bag<T>> {
    o
}

fn body() -> i32 {
    let b = Bag<Missing8>.new(Z { v: 1 }); //~ ERROR AX_NAME_UNRESOLVED
    let c = Bag<Z>.new(Z { v: 1 })
    let d = c.conv<Missing9>(Z { v: 2 }); //~ ERROR AX_NAME_UNRESOLVED
    let e: Option<Missing10> = Option.None; //~ ERROR AX_NAME_UNRESOLVED
    let n = sz<Option<Missing11>>(); //~ ERROR AX_NAME_UNRESOLVED
    let s = Bag<Missing12> { item: 1 }; //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn main() -> i32 {
    0
}
