// test: ui
// T428m: a name inside a generic argument is resolved like any other type: a misspelled or unimported name is
// AX_NAME_UNRESOLVED at that argument.
struct Foo {
    x: i32,
}

fn f(o: Option<Fooo>) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn g() -> Result<i32, HashMapp<i32, Foo>> { //~ ERROR AX_NAME_UNRESOLVED
    Result.Ok(1)
}

// The lowering sentinels stay accepted inside generic arguments (no AX_NAME_UNRESOLVED), also nested.
fn sentinels(a: Option<i128>, b: Option<never>, c: Result<u128, Option<i128>>) -> i32 {
    0
}

fn main() -> i32 {
    0
}
