// test: run
// modes: interp native
// exit: 0
// stdout: 11\n5\n4\n7\n100\n3\n42\n2\n9\n
// T428m: paths inside generic arguments are resolved in the enclosing scope, so `a.S` and `b.S` (same name,
// different fields) are told apart in `Option<a.S>`, `Result<b.S, a.S>`, nested `Option<Bag<b.S>>` and on a
// non-last expression-path segment (`Bag<a.S>.new(..)`). (`Vec` is not in the prelude of a package, and before
// T428m `Option<Vec<b.S>>` was accepted only because the generic argument was never resolved.)

fn pick(o: Option<a.S>) -> i32 {
    match o {
        Option.Some(s) => s.v,
        Option.None => 0 - 1,
    }
}

fn choose(ok: bool) -> Result<b.S, a.S> {
    if ok {
        Result.Ok(b.mk(3))
    } else {
        Result.Err(a.mk(42))
    }
}

fn result_value(r: Result<b.S, a.S>) -> i32 {
    match r {
        Result.Ok(s) => s.w,
        Result.Err(e) => e.v,
    }
}

struct Bag<T> {
    pub item: T,
}

impl<T> Bag<T> {
    fn new(item: T) -> Bag<T> {
        Bag { item: item }
    }
}

fn nested(o: Option<Bag<b.S>>) -> i32 {
    match o {
        Option.Some(g) => g.item.w,
        Option.None => 0,
    }
}

struct ReadyA {
    pub v: i32,
}

impl Future for ReadyA {
    type Output = a.S

    fn poll(self: mut_view<ReadyA>, cx: mut_view<Context>) -> Poll<a.S> {
        Poll.Ready(a.mk(self.v))
    }
}

// An associated-type binding in a bound (`Output = a.S`) and a projection inside a generic argument (`F.Output`).
fn proj<F: Future<Output = a.S>>(o: Option<F.Output>) -> i32 {
    match o {
        Option.Some(s) => s.v,
        Option.None => 0,
    }
}

// Lowering sentinels inside generic arguments keep working.
fn wide(o: Option<i128>) -> i32 {
    match o {
        Option.Some(x) => (x / 1000000000000i128) as i32,
        Option.None => 0,
    }
}

// `Option<never>` (the other sentinel) is checked in `../unresolved_arg.ax`: a value of that type cannot be built
// on HEAD either (AX_TYPE_UNKNOWN in typeck, outside T428m).
fn never_none() -> i32 {
    4
}

fn main() -> i32 {
    print_int(proj<ReadyA>(Option.Some(a.mk(11))) as i64)
    print("\n")
    print_int(wide(Option.Some(5000000000000i128)) as i64)
    print("\n")
    print_int(never_none() as i64)
    print("\n")
    print_int(pick(Option.Some(a.mk(7))) as i64)
    print("\n")
    let bs: Option<b.S> = Option.Some(b.mk(5))
    match bs {
        Option.Some(s) => print_int(s.z as i64),
        Option.None => print("none"),
    }
    print("\n")
    print_int(result_value(choose(true)) as i64)
    print("\n")
    print_int(result_value(choose(false)) as i64)
    print("\n")
    let bb: Bag<b.S> = Bag<b.S>.new(b.mk(2))
    print_int(nested(Option.Some(bb)) as i64)
    print("\n")
    let ba = Bag<a.S>.new(a.mk(9))
    print_int(ba.item.v as i64)
    print("\n")
    0
}
