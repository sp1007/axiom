// test: run
// modes: interp native
// exit: 0
// stdout: 7\n13\n21\n100\n8\n5\n
// QA T428m adversarial: a `use`-imported name inside a generic argument binds to the import (`S` = `a.S`, the field
// `v` exists only there), a generic parameter named `S` shadows the import inside its function (`Option<S>` is the
// parameter: `shadow<i32>` returns an `Option<i32>`), a three-deep nesting `Option<Bag<Option<b.S>>>` reaches `b.S`
// (field `w`), a qualified argument next to an imported one in one list (`Pair<S, b.S>`), and a let annotation.
use a.S

struct Bag<T> {
    pub item: T,
}

impl<T> Bag<T> {
    fn new(item: T) -> Bag<T> {
        Bag { item: item }
    }
}

struct Pair<L, R> {
    pub l: L,
    pub r: R,
}

fn via_use(o: Option<S>) -> i32 {
    match o {
        Option.Some(s) => s.v,
        Option.None => 0 - 1,
    }
}

fn shadow<S>(o: Option<S>) -> Option<S> {
    o
}

fn deep(o: Option<Bag<Option<b.S>>>) -> i32 {
    match o {
        Option.Some(g) => match g.item {
            Option.Some(s) => s.w,
            Option.None => 0 - 2,
        },
        Option.None => 0 - 3,
    }
}

fn pair_sum(p: Pair<S, b.S>) -> i32 {
    p.l.v + p.r.w
}

fn main() -> i32 {
    print_int(via_use(Option.Some(a.mk(7))) as i64)
    print("\n")
    let x: Option<i32> = shadow<i32>(Option.Some(13))
    match x {
        Option.Some(n) => print_int(n as i64),
        Option.None => print("none"),
    }
    print("\n")
    let inner: Option<b.S> = Option.Some(b.mk(21))
    print_int(deep(Option.Some(Bag<Option<b.S>>.new(inner))) as i64)
    print("\n")
    let bb: Option<Bag<b.S>> = Option.Some(Bag<b.S>.new(b.mk(1)))
    match bb {
        Option.Some(g) => print_int(g.item.z as i64),
        Option.None => print("none"),
    }
    print("\n")
    let p: Pair<S, b.S> = Pair<S, b.S> { l: a.mk(5), r: b.mk(3) }
    print_int(pair_sum(p) as i64)
    print("\n")
    let o: Option<Bag<S>> = Option.Some(Bag<S>.new(a.mk(5)))
    match o {
        Option.Some(g) => print_int(g.item.v as i64),
        Option.None => print("none"),
    }
    print("\n")
    0
}
