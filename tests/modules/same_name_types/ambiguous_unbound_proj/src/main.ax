// test: ui
// T428g: `F.Output` without an associated-type binding (`F: HasOut` instead of `F: HasOut<Output = T>`) reaches
// `lookup_path_type_by_name` unbound (`symbol = 0, def_dom = 0`). When more than one other module (`a` and `b`)
// defines `F` and the current module (`main`) does not, typeck must emit `AX_NAME_UNRESOLVED` instead of picking `a.F`.

trait HasOut {
    type Output
}

fn keep(x: a.F, y: b.F) -> i32 {
    0
}

fn bad<F: HasOut>(x: F.Output) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn main() -> i32 {
    0
}
