// test: ui
// T428g: `a.S` and `b.S` have distinct nominal identities (REQ-TYP-072, REQ-MOD-003); assigning or passing one
// where the other is expected must report AX_TYPE_MISMATCH.

fn main() -> i32 {
    let s1: b.S = a.mk(1i32) //~ ERROR AX_TYPE_MISMATCH
    let mut s2: b.S = b.mk(2i32, 3i32)
    s2 = a.mk(4i32) //~ ERROR AX_TYPE_MISMATCH
    let o: Option<b.S> = Option.Some(a.mk(5i32)) //~ ERROR AX_TYPE_MISMATCH
    let r: Result<b.S, a.S> = Result.Ok(a.mk(6i32)) //~ ERROR AX_TYPE_MISMATCH
    0
}
