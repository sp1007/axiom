// test: ui
// T428g: a path bound by the resolver to a non-type item (`trait a.S`, `trait w.T2`, `module a`) must never fall
// through `lookup_path_type_by_name` to a bare-name scan that silently picks `b.S`, `b.T2`, or `b.a`.

use a.S
use w.T2

fn keep_b(x: b.S, y: b.T2, z: b.a) -> i32 {
    x.x + y.x + z.x
}

fn bad_trait_as_type(v: S) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn bad_forward_trait_as_type(v: T2) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn bad_mod_as_type(v: a) -> i32 { //~ ERROR AX_NAME_UNRESOLVED
    0
}

fn main() -> i32 {
    0
}
