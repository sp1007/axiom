// test: run
// modes: interp native
// exit: 0
// stdout: 1234 56 7 11 22 33 44\n
// T428g QA adversarial test: forward-referenced `static VAL` and `fn helper` from `w` (ordered after `main`)
// alongside colliding `a.VAL: bool` / `a.helper() -> bool`, plus three distinct generic `struct Wrap<T>`
// (`main.Wrap`, `a.Wrap`, `w.Wrap`), identical-variant enums `a.Tag.One` / `w.Tag.One`, and `a.Item` / `w.Item` aliases.

use w.VAL
use w.helper

struct Wrap<T> {
    inner: T,
}

fn unwrap_opt_w_a(o: Option<w.Wrap<a.Tag>>) -> i64 {
    match o {
        Option.Some(ww) => match ww.payload {
            a.Tag.One(v) => v as i64,
        },
        Option.None => 0i64,
    }
}

fn unwrap_res(r: Result<a.Wrap<w.Tag>, w.Wrap<a.Tag>>) -> i64 {
    match r {
        Result.Ok(aw) => match aw.first {
            w.Tag.One(v) => v + aw.pad,
        },
        Result.Err(ww) => match ww.payload {
            a.Tag.One(v) => v as i64,
        },
    }
}

fn main() -> i32 {
    let v_static: i64 = VAL
    let v_fn: i64 = helper()
    let local_w: Wrap<i32> = Wrap { inner: 7i32 }
    let a_item: a.Item = 11i32
    let w_item: w.Item = 22i64
    let aw_simple: a.Wrap<a.Item> = a.Wrap { first: a_item, pad: 0i64 }
    let ww_simple: w.Wrap<w.Item> = w.Wrap { payload: w_item, flag: true }
    let opt_v = unwrap_opt_w_a(Option.Some(w.Wrap { payload: a.Tag.One(33i32), flag: false }))
    let res_v = unwrap_res(Result.Ok(a.Wrap { first: w.Tag.One(40i64), pad: 4i64 }))

    print_int(v_static)
    print(" ")
    print_int(v_fn)
    print(" ")
    print_int(local_w.inner as i64)
    print(" ")
    print_int(aw_simple.first as i64)
    print(" ")
    print_int(ww_simple.payload)
    print(" ")
    print_int(opt_v)
    print(" ")
    print_int(res_v)
    print("\n")
    0
}
