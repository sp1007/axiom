// test: run
// modes: interp native
// exit: 0
// stdout: 11 30 77 19 50 9 10\n
// T428g: modules `a`, `b`, and `w` define same-named `struct S`, `fn mk`, `enum E`, `type Alias`, and `const N`
// with incompatible layouts/types; `main` uses them together (including `Option<a.S>`, `Result<b.S, a.S>`, and
// forward-referenced `[N]u8` from `w.N` alongside `a.N: bool`).

use a.N as AN
use w.N

fn unwrap_a(o: Option<a.S>) -> i32 {
    match o {
        Option.Some(s) => s.x,
        Option.None => 0i32,
    }
}

fn pick_res(ok: bool) -> Result<b.S, a.S> {
    if ok {
        Result.Ok(b.mk(10i64, 20i64))
    } else {
        Result.Err(a.mk(77i32))
    }
}

fn eval_res(r: Result<b.S, a.S>) -> i64 {
    match r {
        Result.Ok(bs) => bs.y + bs.z,
        Result.Err(as_val) => as_val.x as i64,
    }
}

fn sum_buf(buf: [N]u8) -> i64 {
    (buf[0] as i64) + (buf[1] as i64) + (buf[2] as i64) + (buf[3] as i64)
}

fn main() -> i32 {
    let va = unwrap_a(Option.Some(a.mk(11i32)))
    let r_ok = eval_res(pick_res(true))
    let r_err = eval_res(pick_res(false))

    let aa: a.Alias = a.mk(19i32)
    let ba: b.Alias = b.mk(22i64, 28i64)
    let ea = a.E.One(aa.x)
    let eb = b.E.Pair(ba.y, ba.z)
    let ev_a = match ea {
        a.E.One(v) => v as i64,
        a.E.Empty => 0i64,
    }
    let ev_b = match eb {
        b.E.Pair(p, q) => p + q,
        b.E.Empty => 0i64,
    }

    let ws: w.S = w.mk(9u8)
    let keep_an: i64 = if AN { 0i64 } else { 100i64 }
    let bsum = sum_buf([1u8, 2u8, 3u8, 4u8]) + keep_an

    print_int(va as i64)
    print(" ")
    print_int(r_ok)
    print(" ")
    print_int(r_err)
    print(" ")
    print_int(ev_a)
    print(" ")
    print_int(ev_b)
    print(" ")
    print_int(ws.tag as i64)
    print(" ")
    print_int(bsum)
    print("\n")
    0
}
