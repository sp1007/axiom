// test: run
// exit: 19
// stdout: seam 19 42 ok\n
// QA round 1 (T423h, ADR-0048 §2): adversarial seam test for `pipe_proj_mod_declares_item` and `pipe_skip_pub_vis`.
// Inline `module std.sync` contains false-positive decoys for `once` (nested block comment, raw string, struct field,
// and method inside an `impl` block), plus a `*const` return type and real top-level items (`Holder`, `marker`).
// `module main` uses `pub(package) use` and `pub use` to import both `std.sync.once` /
// `std.sync.once.once_new` from `<std-root>` and `Holder`/`marker` from the inline `std.sync`.

module std.sync

/* outer /* nested comment */ pub fn once() -> i32 { 0 } */

pub struct Holder {
    pub once: i32
}

impl Holder {
    pub fn once(self: view<Holder>) -> i32 {
        self.once
    }
}

pub fn ptr_id(p: *const u8) -> *const u8 {
    p
}

pub fn marker() -> i32 {
    let _raw = r"pub fn once() -> i32 { 0 }";
    19
}

module main

pub(package) use std.sync.once.once_new
pub(package) use std.sync.once
pub use std.sync.Holder
use std.sync.marker

fn main() -> i32 {
    let o = once_new();
    let done: bool = once.Once.is_completed(view(o));
    let h = Holder { once: 42 };
    let v = h.once();
    let m = marker();
    print("seam ");
    print_int(m as i64);
    print(" ");
    print_int(v as i64);
    if !done {
        print(" ok\n");
    } else {
        print(" bad\n");
    }
    m
}
