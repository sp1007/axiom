// test: run
// exit: 3
// stdout: before exit\n
// T423h (ADR-0048): `use std.process.exit` loads `std/process/process.ax` (header `std.process`, file
// `process/process.ax`), whose own `use std.core.host.*` and `use std.core.result.Result` are resolved
// transitively. Natively, `host.exit` adds the provider module `std.sys.windows.process` (ADR-0002 §3), so the
// program links without defining `__ax_host_exit` itself.

use std.process.exit

fn main() -> i32 {
    print("before exit\n");
    exit(3);
    print("not reached\n");
    0
}
