// test: run
// exit: 77
// stdout: thread local 77\n
// T423h round 1 (ADR-0048 §2): importing a std parent module (`use std.thread`) on demand and then importing its
// child std module (`use std.thread.local`) as a module import in the same file must load both std files and their
// native host providers.

use std.thread
use std.thread.local

fn init_77() -> i32 {
    77
}

fn main() -> i32 {
    let tid = thread.current_id();
    let k = local.local_key_new(init_77);
    let v = local.LocalKey.get(view(k));
    local.thread_local_cleanup();
    print("thread local ");
    print_int(v as i64);
    print("\n");
    if tid.as_u64() == 0u64 {
        return 1;
    }
    v
}
