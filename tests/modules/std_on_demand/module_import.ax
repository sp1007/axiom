// test: run
// exit: 12
// stdout: less greater\n
// T423h (ADR-0048): a module import (`use std.core.mem`, then `mem.replace(...)`) and an item import of another
// on-demand module (`use std.core.cmp.Ordering`) in one program.

use std.core.mem
use std.core.cmp.Ordering

fn order(a: i32, b: i32) -> Ordering {
    if a < b {
        Ordering.Less
    } else if a > b {
        Ordering.Greater
    } else {
        Ordering.Equal
    }
}

fn main() -> i32 {
    let mut slot: i32 = 5;
    let old = unsafe { mem.replace(mut_view(slot), 7) };
    match order(old, slot) {
        Ordering.Less => print("less "),
        _ => print("other "),
    }
    match order(slot, old) {
        Ordering.Greater => print("greater\n"),
        _ => print("other\n"),
    }
    old + slot
}
