// test: run
// exit: 11
// stdout: child item 11 ok\n
// T423h round 1 (regression for QA F1, ADR-0048 §2): an inline `module std.sync` provides `marker` (and even mentions
// `once` in a comment, string, and local binding), while `module main` imports items and the module `std.sync.once`.
// `std/sync/once.ax` must still be loaded from the std root, and `std/sync/mod.ax` must not be loaded.

module std.sync

// fn once() -> i32 { 0 }
pub fn marker() -> i32 {
    let _s = "fn once";
    let once: i32 = 11;
    once
}

module main

use std.sync.marker
use std.sync.once
use std.sync.once.once_new

fn main() -> i32 {
    let o = once_new();
    let done: bool = once.Once.is_completed(view(o));
    let m = marker();
    print("child item ");
    print_int(m as i64);
    if !done {
        print(" ok\n");
    } else {
        print(" bad\n");
    }
    m
}
