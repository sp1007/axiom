// test: run
// exit: 3
// stdout: exiting\n
// T423h (ADR-0048 §3): the triage-1122 repro. `use std.core.host.exit` + `exit(3)`: the interpreter exits 3; a
// native build links `__ax_host_exit` from the provider module `std.sys.windows.process` that the driver adds
// (before T423h: AX_LINK_UNDEFINED_SYMBOL `__ax_host_exit`).

use std.core.host.exit

fn main() -> i32 {
    print("exiting\n");
    exit(3);
    print("not reached\n");
    0
}
