// test: run
// exit: 0
// stdout: time ok 1500 1\n
// QA (T423h): `std.time` is loaded on demand; its own `use std.core.host.monotonic_ns` pulls the provider
// `std.sys.windows.time` natively (the user file never mentions `host`). Also checks the pure duration helpers.

use std.time.duration_from_millis
use std.time.duration_as_millis
use std.time.instant_now
use std.time.instant_as_nanos

fn main() -> i32 {
    let d = duration_from_millis(1500u64);
    let a = instant_now();
    let b = instant_now();
    let mono: i32 = if instant_as_nanos(view(b)) >= instant_as_nanos(view(a)) { 1 } else { 0 };
    print("time ok ");
    print_int(duration_as_millis(view(d)) as i64);
    print(" ");
    print_int(mono as i64);
    print("\n");
    0
}
