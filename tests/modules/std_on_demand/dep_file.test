# T423h (ADR-0048 §4): `--dep-file` lists the std files loaded on demand (golden: dep_file.golden) and the
# directories the std index walked (see check_dep_file.py).
cmd: python tests/modules/std_on_demand/check_dep_file.py {tmp} {compiler}
exit: 0
stdout-contains: dep-file std_on_demand: OK
cache-inputs: tests/modules/std_on_demand std
