// test: run
// args: a
// exit: 22
// stdout: n=2 exiting\n
// QA (T423h): two intrinsics that live in the same provider module (`args_count`, `exit` -> std.sys.windows.process)
// plus one from another (`heap_alloc` -> std.sys.windows.heap): each provider is added once, no duplicate symbols.

use std.core.host.args_count
use std.core.host.exit
use std.core.host.heap_alloc
use std.core.host.heap_free

fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(16, 8) };
    if p as usize == 0 {
        return 1;
    }
    unsafe { *p = 20u8; }
    let n = args_count();
    print("n=");
    print_int(n as i64);
    print(" exiting\n");
    let code: i32 = (unsafe { *p }) as i32 + n as i32;
    unsafe { heap_free(p, 16, 8); }
    exit(code);
    0
}
