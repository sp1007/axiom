// test: run
// args: xin chào
// exit: 3
// stdout: args 3\n
// T423h (ADR-0048 §3, ADR-0002 §3): `args_count()` with no `__ax_host_args_count` defined by the program. The
// interpreter answers the intrinsic itself; a native build adds the provider module `std.sys.windows.process`
// (before T423h: AX_LINK_UNDEFINED_SYMBOL `__ax_host_args_count`). The count includes the program path.

use std.core.host.args_count

fn main() -> i32 {
    let n = args_count();
    print("args ");
    print_int(n as i64);
    print("\n");
    n as i32
}
