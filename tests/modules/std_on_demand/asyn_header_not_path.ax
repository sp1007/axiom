// test: run
// exit: 21
// stdout: 10 11\n
// T423h (ADR-0048): the module header is authoritative, not the file path: `std.asyn.waker` lives in
// `std/async/waker.ax`, so path mapping alone could not find it; the header index does.

use std.asyn.waker.TASK_COMPLETED
use std.asyn.waker.TASK_CANCELLED

fn main() -> i32 {
    print_int(TASK_COMPLETED as i64);
    print(" ");
    print_int(TASK_CANCELLED as i64);
    print("\n");
    (TASK_COMPLETED + TASK_CANCELLED) as i32
}
