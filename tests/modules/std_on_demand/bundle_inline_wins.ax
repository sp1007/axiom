// test: run
// exit: 42
// stdout: inline\n
// T423h (ADR-0048 rule 2): a module the program provides itself (here a bundle-style inline `module std.core.mem`)
// wins: `std/core/mem.ax` is not loaded (it would define a second `std.core.mem`, and `marker` does not exist
// there, so the import resolves only against this inline module).

module std.core.mem

pub fn marker() -> i32 {
    42
}

module main

use std.core.mem.marker

fn main() -> i32 {
    print("inline\n");
    marker()
}
