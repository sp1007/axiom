// test: run
// exit: 37
// stdout: 30 4\n
// T423h (ADR-0048): `use std.core.mem.swap` loads `std/core/mem.ax` from the std root on demand (item import:
// the longest std module path that prefixes the use path is `std.core.mem`). Before T423h this reported
// AX_NAME_UNRESOLVED_IMPORT. Runs in the interpreter and natively.

use std.core.mem.swap

fn main() -> i32 {
    let mut a: i32 = 4;
    let mut b: i32 = 30;
    unsafe {
        swap(mut_view(a), mut_view(b));
    }
    print_int(a as i64);
    print(" ");
    print_int(b as i64);
    print("\n");
    a + b + 3
}
