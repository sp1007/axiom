// test: run
// exit: 200
// stdout: qualified\n
// QA (T423h): the host intrinsic reached through a module import (`use std.core.host`, then `host.exit(..)`) with a
// code above 127 (exact exit code must survive ExitProcess).

use std.core.host

fn main() -> i32 {
    print("qualified\n");
    host.exit(200);
    1
}
