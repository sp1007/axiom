// test: run
// exit: 9
// stdout: shadow 9\n
// QA (T423h, ADR-0048 rule 2): the program provides its own `std.process` (bundle-style inline module) with a
// different `exit`; `use std.process.exit` must resolve to the inline one and std/process/process.ax must not be
// loaded (it would be a second `std.process` and the native build would also pull `__ax_host_exit`). The program
// defines no `host` user, so no provider is needed natively.

module std.process

pub fn exit(code: i32) -> i32 {
    print("shadow ");
    print_int(code as i64);
    print("\n");
    code
}

module main

use std.process.exit

fn main() -> i32 {
    exit(9)
}
