// test: run
// exit: 5
// stdout: marker 5 once ok\n
// QA (T423h, ADR-0048 §2): the program provides `std.sync` itself (inline module), but `std.sync.once` is a different
// module path that the program does not provide. `use std.sync.once` (a MODULE import, longest module prefix of the
// use path is `std.sync.once`) must therefore still load std/sync/once.ax from the std root. A "parent module is
// provided" shortcut must not swallow a child module import.

module std.sync

pub fn marker() -> i32 {
    5
}

module main

use std.sync.marker
use std.sync.once

fn main() -> i32 {
    let o = once.once_new();
    let done: bool = once.Once.is_completed(view(o));
    print("marker ");
    print_int(marker() as i64);
    if !done {
        print(" once ok");
    }
    print("\n");
    marker()
}
