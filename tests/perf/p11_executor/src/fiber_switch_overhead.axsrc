module main

use std.core.host.heap_alloc
use std.core.host.monotonic_ns
use std.core.host.heap_free
use std.core.host.stdio
use std.core.host.write
use std.fiber.Fiber
use std.fiber.FiberState
use std.fiber.yield_val

// Fiber context-switch overhead: one fiber yields forever; the resumer resumes it `n` times and
// drops it suspended. One "op" = one resume + yield round trip (two context switches).

fn drive(n: i64) -> i64 {
    let mut f: Fiber<i64, i64> = Fiber.new(|| -> i64 {
        let mut i: i64 = 0i64;
        while i < 1000000i64 {
            yield_val<i64>(i);
            i = i + 1i64;
        }
        i
    });
    let mut sum: i64 = 0i64;
    let mut k: i64 = 0i64;
    while k < n {
        match f.resume() {
            FiberState.Yielded(v) => { sum = sum + v; },
            FiberState.Completed(r) => { check(false); },
            FiberState.Panicked => { check(false); },
        }
        k = k + 1i64;
    }
    sum
}

pub fn main() -> i32 {
    let n: i64 = 300i64;
    let samples = new_samples();
    let mut r: usize = 0usize;
    while r < 5usize {
        let t0 = now_ns();
        let s = drive(n);
        let t1 = now_ns();
        check(s == n * (n - 1i64) / 2i64);
        unsafe {
            *(samples + r) = t1 - t0;
        }
        r = r + 1usize;
    }
    let med = median5(samples);
    report(n as u64, med);
    // Generous bound: < 200 ms per resume/yield round trip.
    check(med / (n as u64) < 200000000u64);
    print("OK fiber_switch_overhead ");
    print_int(n);
    print("\n");
    0
}
