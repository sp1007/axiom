module main

use std.core.option.Option
use std.core.result.Result
use std.core.prelude.Context
use std.core.host.heap_alloc
use std.core.host.monotonic_ns
use std.core.host.heap_free
use std.core.host.stdio
use std.core.host.write
use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskControlBlock
use std.asyn.task.TaskResult
use std.asyn.task.LocalTaskHandle
use std.asyn.task.tcb_poll_fn

// Single-thread task spawn + poll throughput of the LocalExecutor: N tasks, each polled twice
// (one self-wake). Median of 5 rounds of the wall time of "spawn N, run to completion, join N".

struct Job {
    pub val: i64,
    pub step: i32,
}

impl Future for Job {
    type Output = i64;
    fn poll(self: mut_view<Job>, cx: mut_view<Context>) -> Poll<i64> {
        if self.step == 0i32 {
            self.step = 1i32;
            let mut w = cx.waker();
            view(w).wake_by_ref();
            return Poll.Pending;
        }
        Poll.Ready(self.val)
    }
}

fn poll_job(raw: *mut u8, cx: *mut u8) -> u32 {
    let tcb = raw as *mut TaskControlBlock<Job, i64>;
    tcb_poll_fn<Job, i64>(tcb, cx)
}

fn round(n: i64) -> i64 {
    let mut exec = LocalExecutor.new();
    let mut i: i64 = 0i64;
    while i < n {
        let h: LocalTaskHandle<i64> = exec.spawn_local(Job { val: i, step: 0i32 }, poll_job);
        h.detach();
        i = i + 1i64;
    }
    exec.run();
    check(exec.active_task_count() == 0usize);
    n
}

pub fn main() -> i32 {
    let n: i64 = 40i64;
    let samples = new_samples();
    let mut r: usize = 0usize;
    while r < 5usize {
        let t0 = now_ns();
        let done = round(n);
        let t1 = now_ns();
        check(done == n);
        unsafe {
            *(samples + r) = t1 - t0;
        }
        r = r + 1usize;
    }
    let med = median5(samples);
    report(n as u64, med);
    // Generous bound for loaded machines and the interpreter: < 2 s per task (the MIR interpreter needs about 11 ms).
    check(med / (n as u64) < 2000000000u64);
    print("OK spawn_poll_throughput ");
    print_int(n);
    print("\n");
    0
}
