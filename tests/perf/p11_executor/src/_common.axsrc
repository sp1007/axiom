// ---- shared benchmark helpers (appended to every bench by gen_tests.py) ----

fn now_ns() -> u64 {
    monotonic_ns()
}

// Sorts the first 5 samples (insertion sort) and returns the median.
fn median5(a: *mut u64) -> u64 {
    let mut i: usize = 1usize;
    while i < 5usize {
        let mut j: usize = i;
        while j > 0usize {
            let x = unsafe { *(a + (j - 1usize)) };
            let y = unsafe { *(a + j) };
            if x > y {
                unsafe {
                    *(a + (j - 1usize)) = y;
                    *(a + j) = x;
                }
            }
            j = j - 1usize;
        }
        i = i + 1usize;
    }
    unsafe { *(a + 2usize) }
}

fn new_samples() -> *mut u64 {
    let raw = unsafe { heap_alloc(40, 8) };
    raw as *mut u64
}

// Timings go to stderr: the runner compares the stdout of the interpreter and native runs byte for byte
// and timings differ by definition. `eput("...")` calls are expanded by gen_tests.py into one `eput_byte`
// per character (a `str` literal cannot be turned into a pointer portably between interpreter and native).
fn eput_byte(b: u8) {
    let buf = unsafe { heap_alloc(1, 1) };
    unsafe {
        *buf = b;
        let h = stdio(2u32);
        let ok = write(h, buf as *const u8, 1usize);
        heap_free(buf, 1, 1);
    }
}

fn eput_u64(v: u64) {
    let buf = unsafe { heap_alloc(24, 1) };
    let mut pos: usize = 24usize;
    let mut x: u64 = v;
    if x == 0u64 {
        pos = pos - 1usize;
        unsafe {
            *(buf + pos) = 48u8;
        }
    }
    while x > 0u64 {
        pos = pos - 1usize;
        unsafe {
            *(buf + pos) = (48u64 + x % 10u64) as u8;
        }
        x = x / 10u64;
    }
    while pos < 24usize {
        eput_byte(unsafe { *(buf + pos) });
        pos = pos + 1usize;
    }
    unsafe {
        heap_free(buf, 24, 1);
    }
}

fn report(ops: u64, median_total_ns: u64) {
    eput("BENCH ");
    eput("@NAME@");
    eput(" ops=");
    eput_u64(ops);
    eput(" median_total_ns=");
    eput_u64(median_total_ns);
    eput(" ns_per_op=");
    eput_u64(median_total_ns / ops);
    eput("\n");
}
