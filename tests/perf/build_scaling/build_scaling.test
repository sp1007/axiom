# T486: the `build` phase must scale linearly with the input size (build(4N) / build(N) <= 5; linear = 4).
# The script generates the same program shape at N and 4N units and reads `build --time-passes`;
# it prints SKIP (exit 0) when a compile exceeds its own per-compile timeout.
timeout: 900
cmd: python {test_dir}/build_scaling.py --compiler {compiler} --tmp {tmp} --units 150 --limit 5 --timeout 300
exit: 0
stdout-contains: build scaling
