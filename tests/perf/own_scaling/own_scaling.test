# T485: the `own` pass must scale linearly with the input size (own(4N) / own(N) <= 8; linear = 4, HEAD before T485 measured 13.4).
# The script generates the same program shape at N and 4N units and reads `check --time-passes`;
# it prints SKIP (exit 0) when a compile exceeds its own per-compile timeout.
timeout: 900
cmd: python {test_dir}/own_scaling.py --compiler {compiler} --tmp {tmp} --units 200 --limit 8 --timeout 300
exit: 0
stdout-contains: own scaling
