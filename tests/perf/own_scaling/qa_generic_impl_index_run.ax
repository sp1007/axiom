// test: run
// modes: interp native
// exit: 75
// QA T485: the MIR builder now answers "first generic trait impl containing this member", "is a
// trait member" and the mono-name dedup from per-file indices (compiler/mir/builder.ax). Two
// generic trait impls of the same trait (same member name `weight`), two inherent impls whose
// generic methods share the name `pick` (mono dedup must rename the colliding instance names),
// each instantiated at two types, and a generic fn dispatching through the trait bound. Every value
// is distinct, so a call bound to the wrong impl or instance changes the exit code.

trait Weigh {
    fn weight(self: view<Self>) -> i32;
}

struct Wrap<T> {
    k: i32,
    v: T,
}

struct Other<T> {
    k: i32,
    v: T,
}

struct PlainA {
    k: i32,
}

struct PlainB {
    k: i32,
}

impl<T> Weigh for Wrap<T> {
    fn weight(self: view<Wrap<T>>) -> i32 {
        self.k + 1
    }
}

impl<T> Weigh for Other<T> {
    fn weight(self: view<Other<T>>) -> i32 {
        self.k * 2
    }
}

impl PlainA {
    fn pick<U>(self: view<PlainA>, u: U) -> i32 {
        self.k
    }
}

impl PlainB {
    fn pick<U>(self: view<PlainB>, u: U) -> i32 {
        self.k + 10
    }
}

fn total<T: Weigh>(x: view<T>) -> i32 {
    x.weight()
}

fn main() -> i32 {
    let a = Wrap<i32> { k: 3, v: 1 };
    let b = Wrap<u8> { k: 4, v: 2u8 };
    let c = Other<i32> { k: 6, v: 5 };
    let d = Other<u64> { k: 7, v: 9u64 };
    let pa = PlainA { k: 3 };
    let pb = PlainB { k: 6 };
    // pick: 3 + 3 + 16 + 16 = 38; weight: 4 + 12 = 16; total: 5 + 14 = 19 -> 73; + 2 below
    let g = pa.pick(1u8) + pa.pick(2u64) + pb.pick(3i32) + pb.pick(true);
    let w = a.weight() + c.weight();
    let t = total(view(b)) + total(view(d));
    g + w + t + 2
}
