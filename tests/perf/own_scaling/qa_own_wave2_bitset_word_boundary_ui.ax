// test: ui
// QA T493 adversarial test: exercises multi-word (>64 locals / >64 capability slots) bitset
// boundaries in `compiler/own/init.ax` (1-bit fast path + exact fallback) and `compiler/own/cap.ax`
// (compact capability-slot bitset + lazy dropped_bits + borrow-free fast exit).

struct NonCopy {
    v: i32,
}

struct Pair {
    a: NonCopy,
    b: NonCopy,
}

struct DropBox {
    pub x: i32,
}

impl Drop for DropBox {
    fn drop(self: mut_view<Self>) {
        let _ = self.x;
    }
}

fn consume_nc(x: NonCopy) -> i32 {
    x.v
}

fn read_db(v: view<DropBox>) -> i32 {
    v.x
}

// 1. >64 locals (path nodes crossing 64-bit word boundary into word 1): partial field move of `p.a`
// inside a loop back-edge without re-init must be caught by 1-bit `own_bits_merge` + `need_recheck`
// and diagnosed identically via `own_check_exact_fallback`.
fn move_above_64_locals_loop(n: i32) -> i32 {
    let l0 = 0; let l1 = 1; let l2 = 2; let l3 = 3; let l4 = 4; let l5 = 5; let l6 = 6; let l7 = 7;
    let l8 = 8; let l9 = 9; let l10 = 10; let l11 = 11; let l12 = 12; let l13 = 13; let l14 = 14; let l15 = 15;
    let l16 = 16; let l17 = 17; let l18 = 18; let l19 = 19; let l20 = 20; let l21 = 21; let l22 = 22; let l23 = 23;
    let l24 = 24; let l25 = 25; let l26 = 26; let l27 = 27; let l28 = 28; let l29 = 29; let l30 = 30; let l31 = 31;
    let l32 = 32; let l33 = 33; let l34 = 34; let l35 = 35; let l36 = 36; let l37 = 37; let l38 = 38; let l39 = 39;
    let l40 = 40; let l41 = 41; let l42 = 42; let l43 = 43; let l44 = 44; let l45 = 45; let l46 = 46; let l47 = 47;
    let l48 = 48; let l49 = 49; let l50 = 50; let l51 = 51; let l52 = 52; let l53 = 53; let l54 = 54; let l55 = 55;
    let l56 = 56; let l57 = 57; let l58 = 58; let l59 = 59; let l60 = 60; let l61 = 61; let l62 = 62; let l63 = 63;
    let l64 = 64; let l65 = 65; let l66 = 66; let l67 = 67; let l68 = 68; let l69 = 69;
    let mut acc = l0 + l1 + l2 + l3 + l4 + l5 + l6 + l7 + l8 + l9 + l10 + l11 + l12 + l13 + l14 + l15 +
        l16 + l17 + l18 + l19 + l20 + l21 + l22 + l23 + l24 + l25 + l26 + l27 + l28 + l29 + l30 + l31 +
        l32 + l33 + l34 + l35 + l36 + l37 + l38 + l39 + l40 + l41 + l42 + l43 + l44 + l45 + l46 + l47 +
        l48 + l49 + l50 + l51 + l52 + l53 + l54 + l55 + l56 + l57 + l58 + l59 + l60 + l61 + l62 + l63 +
        l64 + l65 + l66 + l67 + l68 + l69;
    let p = Pair { a: NonCopy { v: 11 }, b: NonCopy { v: 22 } };
    let mut i = 0;
    while i < n {
        acc = acc + consume_nc(p.a); //~ ERROR AX_MOVE_USE_AFTER_MOVE
        i = i + 1;
    }
    acc + p.b.v
}

// 2. >64 live capability slots (words == 2 in FastCapCtx): conflicts on slots >= 64 must be
// detected by `cap_fast_check_conflict` for both MUT-after-READ and READ-after-MUT.
fn cap_conflict_above_64_slots() -> i32 {
    let mut v0 = 0; let mut v1 = 1; let mut v2 = 2; let mut v3 = 3; let mut v4 = 4; let mut v5 = 5; let mut v6 = 6; let mut v7 = 7;
    let mut v8 = 8; let mut v9 = 9; let mut v10 = 10; let mut v11 = 11; let mut v12 = 12; let mut v13 = 13; let mut v14 = 14; let mut v15 = 15;
    let mut v16 = 16; let mut v17 = 17; let mut v18 = 18; let mut v19 = 19; let mut v20 = 20; let mut v21 = 21; let mut v22 = 22; let mut v23 = 23;
    let mut v24 = 24; let mut v25 = 25; let mut v26 = 26; let mut v27 = 27; let mut v28 = 28; let mut v29 = 29; let mut v30 = 30; let mut v31 = 31;
    let mut v32 = 32; let mut v33 = 33; let mut v34 = 34; let mut v35 = 35; let mut v36 = 36; let mut v37 = 37; let mut v38 = 38; let mut v39 = 39;
    let mut v40 = 40; let mut v41 = 41; let mut v42 = 42; let mut v43 = 43; let mut v44 = 44; let mut v45 = 45; let mut v46 = 46; let mut v47 = 47;
    let mut v48 = 48; let mut v49 = 49; let mut v50 = 50; let mut v51 = 51; let mut v52 = 52; let mut v53 = 53; let mut v54 = 54; let mut v55 = 55;
    let mut v56 = 56; let mut v57 = 57; let mut v58 = 58; let mut v59 = 59; let mut v60 = 60; let mut v61 = 61; let mut v62 = 62; let mut v63 = 63;
    let mut v64 = 64; let mut v65 = 65; let mut v66 = 66; let mut v67 = 67; let mut v68 = 68; let mut v69 = 69; let mut v70 = 70;
    let r0 = view(v0); let r1 = view(v1); let r2 = view(v2); let r3 = view(v3); let r4 = view(v4); let r5 = view(v5); let r6 = view(v6); let r7 = view(v7);
    let r8 = view(v8); let r9 = view(v9); let r10 = view(v10); let r11 = view(v11); let r12 = view(v12); let r13 = view(v13); let r14 = view(v14); let r15 = view(v15);
    let r16 = view(v16); let r17 = view(v17); let r18 = view(v18); let r19 = view(v19); let r20 = view(v20); let r21 = view(v21); let r22 = view(v22); let r23 = view(v23);
    let r24 = view(v24); let r25 = view(v25); let r26 = view(v26); let r27 = view(v27); let r28 = view(v28); let r29 = view(v29); let r30 = view(v30); let r31 = view(v31);
    let r32 = view(v32); let r33 = view(v33); let r34 = view(v34); let r35 = view(v35); let r36 = view(v36); let r37 = view(v37); let r38 = view(v38); let r39 = view(v39);
    let r40 = view(v40); let r41 = view(v41); let r42 = view(v42); let r43 = view(v43); let r44 = view(v44); let r45 = view(v45); let r46 = view(v46); let r47 = view(v47);
    let r48 = view(v48); let r49 = view(v49); let r50 = view(v50); let r51 = view(v51); let r52 = view(v52); let r53 = view(v53); let r54 = view(v54); let r55 = view(v55);
    let r56 = view(v56); let r57 = view(v57); let r58 = view(v58); let r59 = view(v59); let r60 = view(v60); let r61 = view(v61); let r62 = view(v62); let r63 = view(v63);
    let r64 = view(v64); let r65 = view(v65); let r66 = view(v66); let r67 = view(v67); let r68 = view(v68); let r69 = view(v69);
    let m68 = mut_view(v68); //~ ERROR AX_CAP_CONFLICT_MUT
    let m70 = mut_view(v70);
    let r70 = view(v70); //~ ERROR AX_CAP_CONFLICT_READ
    *m68 = *r68 + *r0 + *r63 + *r64 + *r69 + *r70;
    *m70 = *r1 + *r2 + *r3 + *r4 + *r5 + *r6 + *r7 + *r8 + *r9 + *r10 +
        *r11 + *r12 + *r13 + *r14 + *r15 + *r16 + *r17 + *r18 + *r19 + *r20 +
        *r21 + *r22 + *r23 + *r24 + *r25 + *r26 + *r27 + *r28 + *r29 + *r30 +
        *r31 + *r32 + *r33 + *r34 + *r35 + *r36 + *r37 + *r38 + *r39 + *r40 +
        *r41 + *r42 + *r43 + *r44 + *r45 + *r46 + *r47 + *r48 + *r49 + *r50 +
        *r51 + *r52 + *r53 + *r54 + *r55 + *r56 + *r57 + *r58 + *r59 + *r60 +
        *r61 + *r62 + *r65 + *r66 + *r67;
    v68 + v70
}

// 3. >64 live capability slots + droppable owner moved while borrowed across a loop back-edge
// (exercises `cap_fast_check_invalidate`, lazy `dropped_bits` bitset at word 1, and `slot_to_local`).
fn cap_drop_while_borrowed_above_64_loop() -> i32 {
    let v0 = 0; let v1 = 1; let v2 = 2; let v3 = 3; let v4 = 4; let v5 = 5; let v6 = 6; let v7 = 7;
    let v8 = 8; let v9 = 9; let v10 = 10; let v11 = 11; let v12 = 12; let v13 = 13; let v14 = 14; let v15 = 15;
    let v16 = 16; let v17 = 17; let v18 = 18; let v19 = 19; let v20 = 20; let v21 = 21; let v22 = 22; let v23 = 23;
    let v24 = 24; let v25 = 25; let v26 = 26; let v27 = 27; let v28 = 28; let v29 = 29; let v30 = 30; let v31 = 31;
    let v32 = 32; let v33 = 33; let v34 = 34; let v35 = 35; let v36 = 36; let v37 = 37; let v38 = 38; let v39 = 39;
    let v40 = 40; let v41 = 41; let v42 = 42; let v43 = 43; let v44 = 44; let v45 = 45; let v46 = 46; let v47 = 47;
    let v48 = 48; let v49 = 49; let v50 = 50; let v51 = 51; let v52 = 52; let v53 = 53; let v54 = 54; let v55 = 55;
    let v56 = 56; let v57 = 57; let v58 = 58; let v59 = 59; let v60 = 60; let v61 = 61; let v62 = 62; let v63 = 63;
    let v64 = 64; let v65 = 65; let v66 = 66; let v67 = 67;
    let r0 = view(v0); let r1 = view(v1); let r2 = view(v2); let r3 = view(v3); let r4 = view(v4); let r5 = view(v5); let r6 = view(v6); let r7 = view(v7);
    let r8 = view(v8); let r9 = view(v9); let r10 = view(v10); let r11 = view(v11); let r12 = view(v12); let r13 = view(v13); let r14 = view(v14); let r15 = view(v15);
    let r16 = view(v16); let r17 = view(v17); let r18 = view(v18); let r19 = view(v19); let r20 = view(v20); let r21 = view(v21); let r22 = view(v22); let r23 = view(v23);
    let r24 = view(v24); let r25 = view(v25); let r26 = view(v26); let r27 = view(v27); let r28 = view(v28); let r29 = view(v29); let r30 = view(v30); let r31 = view(v31);
    let r32 = view(v32); let r33 = view(v33); let r34 = view(v34); let r35 = view(v35); let r36 = view(v36); let r37 = view(v37); let r38 = view(v38); let r39 = view(v39);
    let r40 = view(v40); let r41 = view(v41); let r42 = view(v42); let r43 = view(v43); let r44 = view(v44); let r45 = view(v45); let r46 = view(v46); let r47 = view(v47);
    let r48 = view(v48); let r49 = view(v49); let r50 = view(v50); let r51 = view(v51); let r52 = view(v52); let r53 = view(v53); let r54 = view(v54); let r55 = view(v55);
    let r56 = view(v56); let r57 = view(v57); let r58 = view(v58); let r59 = view(v59); let r60 = view(v60); let r61 = view(v61); let r62 = view(v62); let r63 = view(v63);
    let r64 = view(v64); let r65 = view(v65); let r66 = view(v66); let r67 = view(v67);
    let owner = DropBox { x: 99 };
    let vd = view(owner);
    let mut i = 0;
    let mut acc = *r0 + *r1 + *r2 + *r3 + *r4 + *r5 + *r6 + *r7 + *r8 + *r9 +
        *r10 + *r11 + *r12 + *r13 + *r14 + *r15 + *r16 + *r17 + *r18 + *r19 +
        *r20 + *r21 + *r22 + *r23 + *r24 + *r25 + *r26 + *r27 + *r28 + *r29 +
        *r30 + *r31 + *r32 + *r33 + *r34 + *r35 + *r36 + *r37 + *r38 + *r39 +
        *r40 + *r41 + *r42 + *r43 + *r44 + *r45 + *r46 + *r47 + *r48 + *r49 +
        *r50 + *r51 + *r52 + *r53 + *r54 + *r55 + *r56 + *r57 + *r58 + *r59 +
        *r60 + *r61 + *r62 + *r63 + *r64 + *r65 + *r66 + *r67;
    while i < 2 {
        if i == 1 {
            let moved_owner = owner; //~ ERROR AX_CAP_OUTLIVES_OWNER
            acc = acc + moved_owner.x;
        }
        acc = acc + read_db(vd);
        i = i + 1;
    }
    acc
}

// 4. Borrow-free fast-exit soundness: no borrows on main path, ONLY inside a late nested branch.
fn cap_late_branch_only_conflict(flag: bool, n: i32) -> i32 {
    let mut x = n + 1;
    let mut acc = 0;
    let mut i = 0;
    while i < 3 {
        acc = acc + x + i;
        i = i + 1;
    }
    if flag {
        if n > 10 {
            let r = view(x);
            let m = mut_view(x); //~ ERROR AX_CAP_CONFLICT_MUT
            *m = *r + acc;
        }
    }
    x + acc
}

fn main() -> i32 {
    0
}
