// test: run
// modes: interp native
// exit: 0
// stdout: BITSET_BOUNDARY_OK\n
// QA T493 adversarial run test: valid edge cases crossing 64-bit word boundaries in both
// `compiler/own/cap.ax` (>64 simultaneous live views) and `compiler/own/init.ax` (>64 locals with
// partial struct field move + partial re-init across branches, loop-carried move + re-init, and
// borrow-free fast exit). Verifies zero false positives and exact runtime agreement across
// interp, native (-O0), and native-O1.

struct NonCopy {
    v: i32,
}

struct Pair {
    a: NonCopy,
    b: NonCopy,
}

fn consume_nc(x: NonCopy) -> i32 {
    x.v
}

fn consume_pair(p: Pair) -> i32 {
    p.a.v + p.b.v
}

// 1. 70 simultaneous live read views (crossing 64-bit word boundary in FastCapCtx):
// sum(1..=70) = 2485.
fn valid_70_views_word_boundary() -> i32 {
    let v0 = 1; let v1 = 2; let v2 = 3; let v3 = 4; let v4 = 5; let v5 = 6; let v6 = 7; let v7 = 8;
    let v8 = 9; let v9 = 10; let v10 = 11; let v11 = 12; let v12 = 13; let v13 = 14; let v14 = 15; let v15 = 16;
    let v16 = 17; let v17 = 18; let v18 = 19; let v19 = 20; let v20 = 21; let v21 = 22; let v22 = 23; let v23 = 24;
    let v24 = 25; let v25 = 26; let v26 = 27; let v27 = 28; let v28 = 29; let v29 = 30; let v30 = 31; let v31 = 32;
    let v32 = 33; let v33 = 34; let v34 = 35; let v35 = 36; let v36 = 37; let v37 = 38; let v38 = 39; let v39 = 40;
    let v40 = 41; let v41 = 42; let v42 = 43; let v43 = 44; let v44 = 45; let v45 = 46; let v46 = 47; let v47 = 48;
    let v48 = 49; let v49 = 50; let v50 = 51; let v51 = 52; let v52 = 53; let v53 = 54; let v54 = 55; let v55 = 56;
    let v56 = 57; let v57 = 58; let v58 = 59; let v59 = 60; let v60 = 61; let v61 = 62; let v62 = 63; let v63 = 64;
    let v64 = 65; let v65 = 66; let v66 = 67; let v67 = 68; let v68 = 69; let v69 = 70;
    let r0 = view(v0); let r1 = view(v1); let r2 = view(v2); let r3 = view(v3); let r4 = view(v4); let r5 = view(v5); let r6 = view(v6); let r7 = view(v7);
    let r8 = view(v8); let r9 = view(v9); let r10 = view(v10); let r11 = view(v11); let r12 = view(v12); let r13 = view(v13); let r14 = view(v14); let r15 = view(v15);
    let r16 = view(v16); let r17 = view(v17); let r18 = view(v18); let r19 = view(v19); let r20 = view(v20); let r21 = view(v21); let r22 = view(v22); let r23 = view(v23);
    let r24 = view(v24); let r25 = view(v25); let r26 = view(v26); let r27 = view(v27); let r28 = view(v28); let r29 = view(v29); let r30 = view(v30); let r31 = view(v31);
    let r32 = view(v32); let r33 = view(v33); let r34 = view(v34); let r35 = view(v35); let r36 = view(v36); let r37 = view(v37); let r38 = view(v38); let r39 = view(v39);
    let r40 = view(v40); let r41 = view(v41); let r42 = view(v42); let r43 = view(v43); let r44 = view(v44); let r45 = view(v45); let r46 = view(v46); let r47 = view(v47);
    let r48 = view(v48); let r49 = view(v49); let r50 = view(v50); let r51 = view(v51); let r52 = view(v52); let r53 = view(v53); let r54 = view(v54); let r55 = view(v55);
    let r56 = view(v56); let r57 = view(v57); let r58 = view(v58); let r59 = view(v59); let r60 = view(v60); let r61 = view(v61); let r62 = view(v62); let r63 = view(v63);
    let r64 = view(v64); let r65 = view(v65); let r66 = view(v66); let r67 = view(v67); let r68 = view(v68); let r69 = view(v69);
    *r0 + *r1 + *r2 + *r3 + *r4 + *r5 + *r6 + *r7 + *r8 + *r9 +
        *r10 + *r11 + *r12 + *r13 + *r14 + *r15 + *r16 + *r17 + *r18 + *r19 +
        *r20 + *r21 + *r22 + *r23 + *r24 + *r25 + *r26 + *r27 + *r28 + *r29 +
        *r30 + *r31 + *r32 + *r33 + *r34 + *r35 + *r36 + *r37 + *r38 + *r39 +
        *r40 + *r41 + *r42 + *r43 + *r44 + *r45 + *r46 + *r47 + *r48 + *r49 +
        *r50 + *r51 + *r52 + *r53 + *r54 + *r55 + *r56 + *r57 + *r58 + *r59 +
        *r60 + *r61 + *r62 + *r63 + *r64 + *r65 + *r66 + *r67 + *r68 + *r69
}

// 2. Partial struct field move + partial re-init across branches at path node > 64 (word 1).
fn valid_partial_move_reinit_above_64(flag: bool) -> i32 {
    let d0 = 1; let d1 = 1; let d2 = 1; let d3 = 1; let d4 = 1; let d5 = 1; let d6 = 1; let d7 = 1;
    let d8 = 1; let d9 = 1; let d10 = 1; let d11 = 1; let d12 = 1; let d13 = 1; let d14 = 1; let d15 = 1;
    let d16 = 1; let d17 = 1; let d18 = 1; let d19 = 1; let d20 = 1; let d21 = 1; let d22 = 1; let d23 = 1;
    let d24 = 1; let d25 = 1; let d26 = 1; let d27 = 1; let d28 = 1; let d29 = 1; let d30 = 1; let d31 = 1;
    let d32 = 1; let d33 = 1; let d34 = 1; let d35 = 1; let d36 = 1; let d37 = 1; let d38 = 1; let d39 = 1;
    let d40 = 1; let d41 = 1; let d42 = 1; let d43 = 1; let d44 = 1; let d45 = 1; let d46 = 1; let d47 = 1;
    let d48 = 1; let d49 = 1; let d50 = 1; let d51 = 1; let d52 = 1; let d53 = 1; let d54 = 1; let d55 = 1;
    let d56 = 1; let d57 = 1; let d58 = 1; let d59 = 1; let d60 = 1; let d61 = 1; let d62 = 1; let d63 = 1;
    let d64 = 1; let d65 = 1; let d66 = 1; let d67 = 1;
    let base = d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8 + d9 + d10 + d11 + d12 + d13 + d14 + d15 +
        d16 + d17 + d18 + d19 + d20 + d21 + d22 + d23 + d24 + d25 + d26 + d27 + d28 + d29 + d30 + d31 +
        d32 + d33 + d34 + d35 + d36 + d37 + d38 + d39 + d40 + d41 + d42 + d43 + d44 + d45 + d46 + d47 +
        d48 + d49 + d50 + d51 + d52 + d53 + d54 + d55 + d56 + d57 + d58 + d59 + d60 + d61 + d62 + d63 +
        d64 + d65 + d66 + d67;
    let mut p = Pair { a: NonCopy { v: 10 }, b: NonCopy { v: 20 } };
    let mut taken = 0;
    if flag {
        taken = consume_nc(p.a);
        p.a = NonCopy { v: 100 };
    } else {
        taken = consume_nc(p.b);
        p.b = NonCopy { v: 200 };
    }
    base + taken + consume_pair(p)
}

// 3. Loop-carried non-Copy move WITH re-init on every iteration at path node > 64 (word 1),
// plus zero borrows (exercises borrow-free fast exit in `cap.ax`).
fn valid_loop_move_and_reinit_above_64() -> i32 {
    let d0 = 1; let d1 = 1; let d2 = 1; let d3 = 1; let d4 = 1; let d5 = 1; let d6 = 1; let d7 = 1;
    let d8 = 1; let d9 = 1; let d10 = 1; let d11 = 1; let d12 = 1; let d13 = 1; let d14 = 1; let d15 = 1;
    let d16 = 1; let d17 = 1; let d18 = 1; let d19 = 1; let d20 = 1; let d21 = 1; let d22 = 1; let d23 = 1;
    let d24 = 1; let d25 = 1; let d26 = 1; let d27 = 1; let d28 = 1; let d29 = 1; let d30 = 1; let d31 = 1;
    let d32 = 1; let d33 = 1; let d34 = 1; let d35 = 1; let d36 = 1; let d37 = 1; let d38 = 1; let d39 = 1;
    let d40 = 1; let d41 = 1; let d42 = 1; let d43 = 1; let d44 = 1; let d45 = 1; let d46 = 1; let d47 = 1;
    let d48 = 1; let d49 = 1; let d50 = 1; let d51 = 1; let d52 = 1; let d53 = 1; let d54 = 1; let d55 = 1;
    let d56 = 1; let d57 = 1; let d58 = 1; let d59 = 1; let d60 = 1; let d61 = 1; let d62 = 1; let d63 = 1;
    let d64 = 1; let d65 = 1;
    let mut acc = d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8 + d9 + d10 + d11 + d12 + d13 + d14 + d15 +
        d16 + d17 + d18 + d19 + d20 + d21 + d22 + d23 + d24 + d25 + d26 + d27 + d28 + d29 + d30 + d31 +
        d32 + d33 + d34 + d35 + d36 + d37 + d38 + d39 + d40 + d41 + d42 + d43 + d44 + d45 + d46 + d47 +
        d48 + d49 + d50 + d51 + d52 + d53 + d54 + d55 + d56 + d57 + d58 + d59 + d60 + d61 + d62 + d63 +
        d64 + d65;
    let mut x = NonCopy { v: 5 };
    let mut i = 0;
    while i < 3 {
        let prev = consume_nc(x);
        acc = acc + prev;
        x = NonCopy { v: prev + 10 };
        i = i + 1;
    }
    acc + consume_nc(x)
}

fn main() -> i32 {
    let s1 = valid_70_views_word_boundary(); // 2485
    let s2 = valid_partial_move_reinit_above_64(true); // 68 + 10 + (100 + 20) = 198
    let s3 = valid_partial_move_reinit_above_64(false); // 68 + 20 + (10 + 200) = 298
    let s4 = valid_loop_move_and_reinit_above_64(); // 66 + 5 + 15 + 25 + 35 = 146
    let total = s1 + s2 + s3 + s4; // 2485 + 198 + 298 + 146 = 3127
    if total == 3127 {
        print("BITSET_BOUNDARY_OK\n");
        0
    } else {
        1
    }
}
