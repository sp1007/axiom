// test: ui
// T493: regression tests for compact-bitset `own_cap_check` and 1-bit fast-path -> exact-fallback
// `own_check`: verifies use-after-move across loop back-edge and capability conflicts via view/mut_view.

struct NonCopy {
    v: i32,
}

fn consume(x: NonCopy) -> i32 {
    x.v
}

fn use_after_move_in_loop(n: i32) -> i32 {
    let x = NonCopy { v: 1 };
    let mut i = 0;
    let mut acc = 0;
    while i < n {
        acc = acc + consume(x); //~ ERROR AX_MOVE_USE_AFTER_MOVE
        i = i + 1;
    }
    acc
}

fn cap_conflict_mut_after_read() -> i32 {
    let mut x = 10;
    let r = view(x);
    let m = mut_view(x); //~ ERROR AX_CAP_CONFLICT_MUT
    *m = *r + 1;
    x
}

fn cap_conflict_read_after_mut() -> i32 {
    let mut x = 10;
    let m = mut_view(x);
    let r = view(x); //~ ERROR AX_CAP_CONFLICT_READ
    *m = *r + 1;
    x
}

fn main() -> i32 {
    0
}
