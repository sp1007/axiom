// test: ui
// QA T485: the unsafe/concurrency checker now answers "is this callee unsafe" and "is this path a
// static" from an item index built once per run (compiler/own/unsafe.ax). Items are declared AFTER
// their uses (the index must cover the whole item list, not the items seen so far); the unsafe fns
// are a top-level fn and an impl member; the statics are top-level, one `static mut` read/written
// outside `unsafe`; the safe callees must stay accepted.

module qa_t485_unsafe_index

pub fn use_before_decl() -> i32 {
    let a = late_raw(1); //~ ERROR AX_UNSAFE_REQUIRED
    let b = late_safe(2);
    let c = unsafe { late_raw(3) };
    a + b + c
}

pub fn statics_before_decl() -> i32 {
    let cur = LATE_COUNTER; //~ ERROR AX_CONC_UNSYNC_STATIC
    LATE_COUNTER = cur + 1; //~ ERROR AX_CONC_UNSYNC_STATIC
    let ok = unsafe { LATE_COUNTER };
    ok + LATE_CONST_LIKE.v
}

pub fn member_after_decl(h: view<Holder>) -> i32 {
    let x = h.read_raw(); //~ ERROR AX_UNSAFE_REQUIRED
    let y = h.read_safe();
    x + y
}

unsafe fn late_raw(x: i32) -> i32 {
    x + 1
}

fn late_safe(x: i32) -> i32 {
    x + 2
}

pub struct Holder {
    pub v: i32,
}

impl Holder {
    pub unsafe fn read_raw(self: view<Holder>) -> i32 {
        self.v
    }

    pub fn read_safe(self: view<Holder>) -> i32 {
        self.v
    }
}

pub struct Shared {
    pub v: i32,
}

static mut LATE_COUNTER: i32 = 0;

static LATE_CONST_LIKE: Shared = Shared { v: 5 };

fn main() -> i32 {
    0
}
