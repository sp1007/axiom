// test: run
// modes: interp native
// stdout: ok\n

module main

struct Guard {
    pub v: i32,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {}
}

fn take_guard(g: Guard) -> i32 {
    g.v
}

fn run_branch(take_it: bool) -> i32 {
    let g = Guard { v: 7 };
    if take_it {
        return take_guard(g);
    }
    0
}

pub fn main() -> i32 {
    let a = run_branch(true);
    let b = run_branch(false);
    if a == 7 && b == 0 {
        print("ok\n");
        return 0;
    }
    1
}
