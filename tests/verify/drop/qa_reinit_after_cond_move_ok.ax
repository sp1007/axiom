// test: run
// modes: interp native
// stdout: ok\n

module main

struct Guard {
    pub v: i32,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {}
}

fn take_guard(g: Guard) -> i32 {
    g.v
}

fn reinit_branch(take_first: bool) -> i32 {
    let mut g = Guard { v: 5 };
    let mut acc: i32 = 0;
    if take_first {
        acc = take_guard(g);
    }
    g = Guard { v: 19 };
    acc + g.v
}

pub fn main() -> i32 {
    let a = reinit_branch(true);
    let b = reinit_branch(false);
    if a == 24 && b == 19 {
        print("ok\n");
        return 0;
    }
    1
}
