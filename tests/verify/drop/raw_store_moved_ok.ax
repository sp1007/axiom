// test: run
// modes: interp native
// stdout: ok\n

module main

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Slot {
    pub v: i32,
}

impl Drop for Slot {
    fn drop(self: mut_view<Self>) {}
}

fn consume_slot(s: Slot) -> i32 {
    s.v
}

pub fn main() -> i32 {
    let mut x = Slot { v: 11 };
    let p: *mut Slot = unsafe { address_of_mut(x) };
    let old_v = consume_slot(x);
    unsafe {
        *p = Slot { v: old_v + 31 };
        if (*p).v == 42 {
            print("ok\n");
            return 0;
        }
    }
    1
}
