// test: ui

extern "C" async fn bad_extern_async() -> i32 { //~ ERROR AX_ASYNC_EXTERN_ABI
    0i32
}

struct Resource {
    fd: i32,
}

async fn async_cleanup(fd: i32) -> i32 {
    fd
}

impl Drop for Resource {
    fn drop(self: mut_view<Resource>) {
        let _ = async_cleanup(self.fd).await //~ ERROR AX_ASYNC_AWAIT_IN_DROP
    }
}

@blocking
fn blocking_sleep(ms: i32) -> i32 {
    ms
}

async fn calls_blocking() -> i32 {
    blocking_sleep(10i32) //~ WARN AX_ASYNC_BLOCKING_IN_ASYNC
}

fn main() {
    let _ = calls_blocking()
}
