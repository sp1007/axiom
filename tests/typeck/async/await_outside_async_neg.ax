// test: ui

async fn make_num() -> i32 {
    42i32
}

fn sync_caller() -> i32 {
    make_num().await //~ ERROR AX_ASYNC_AWAIT_OUTSIDE_ASYNC
}

async fn closure_caller() -> i32 {
    let f = || -> i32 {
        make_num().await //~ ERROR AX_ASYNC_AWAIT_OUTSIDE_ASYNC
    }
    f()
}

fn main() {
    let _ = sync_caller()
    let _ = closure_caller()
}
