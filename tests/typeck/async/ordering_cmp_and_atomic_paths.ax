// test: run
// modes: interp native
// covers: REQ-CONC-014, REQ-ASY-023
// stdout: cmp_and_atomic_ordering_ok\n

// Regression test (T432, ADR-0041 D4): a user file can use both
// `std.core.cmp.Ordering` and `std.sync.atomic.Ordering` by path without
// bare-name collisions from `std.core.prelude`.

use std.core.cmp.Ordering as CmpOrdering
use std.sync.atomic.AtomicI32
use std.sync.atomic.Ordering as AtomicOrdering

fn classify_cmp(a: i32, b: i32) -> std.core.cmp.Ordering {
    if a < b {
        return std.core.cmp.Ordering.Less;
    }
    if a > b {
        return std.core.cmp.Ordering.Greater;
    }
    std.core.cmp.Ordering.Equal
}

fn score_cmp(ord: CmpOrdering) -> i32 {
    match ord {
        CmpOrdering.Less => -1i32,
        CmpOrdering.Equal => 0i32,
        CmpOrdering.Greater => 1i32,
    }
}

fn score_cmp_full_path(ord: std.core.cmp.Ordering) -> i32 {
    match ord {
        std.core.cmp.Ordering.Less => -10i32,
        std.core.cmp.Ordering.Equal => 0i32,
        std.core.cmp.Ordering.Greater => 10i32,
    }
}

fn is_seqcst(ord: std.sync.atomic.Ordering) -> bool {
    match ord {
        std.sync.atomic.Ordering.SeqCst => true,
        std.sync.atomic.Ordering.Relaxed => false,
        std.sync.atomic.Ordering.Acquire => false,
        std.sync.atomic.Ordering.Release => false,
        std.sync.atomic.Ordering.AcqRel => false,
    }
}

fn main() -> i32 {
    let slot = AtomicI32.new(10i32);
    slot.store(25i32, std.sync.atomic.Ordering.Release);
    let prev = slot.fetch_add(17i32, AtomicOrdering.AcqRel);
    let now = slot.load(std.sync.atomic.Ordering.Acquire);

    if prev != 25i32 || now != 42i32 {
        return 1;
    }

    let c1 = score_cmp(classify_cmp(prev, now));
    let c2 = score_cmp(classify_cmp(now, now));
    let c3 = score_cmp_full_path(classify_cmp(now, prev));
    if c1 != -1i32 || c2 != 0i32 || c3 != 10i32 {
        return 2;
    }

    if !is_seqcst(std.sync.atomic.Ordering.SeqCst) || is_seqcst(AtomicOrdering.Relaxed) {
        return 3;
    }

    let cas = slot.compare_exchange(
        42i32,
        100i32,
        AtomicOrdering.SeqCst,
        std.sync.atomic.Ordering.Relaxed
    );
    if !cas.ok || cas.val != 42i32 {
        return 4;
    }
    if slot.load(AtomicOrdering.SeqCst) != 100i32 {
        return 5;
    }

    print("cmp_and_atomic_ordering_ok\n");
    0
}
