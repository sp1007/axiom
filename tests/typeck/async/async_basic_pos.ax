// test: golden
// emit: thir

@must_use
@lang("poll")
pub enum Poll<T> {
    Ready(T),
    Pending,
}

@lang("future")
pub trait Future {
    type Output
    fn poll(self: mut_view<Self>, cx: mut_view<i32>) -> Poll<Self.Output>
}

struct ReadyI32 {
    val: i32,
}

impl Future for ReadyI32 {
    type Output = i32

    fn poll(self: mut_view<ReadyI32>, cx: mut_view<i32>) -> Poll<i32> {
        let _ = cx
        Poll.Ready(self.val)
    }
}

async fn leaf_add(a: i32, b: i32) -> i32 {
    a + b
}

async fn generic_id<T>(x: T) -> T {
    x
}

async fn await_custom_and_coroutine(x: i32) -> i32 {
    let custom = ReadyI32 { val: x }
    let v1 = custom.await
    let v2 = leaf_add(v1, 10i32).await
    let v3 = generic_id(v2).await
    v3
}

async fn await_generic_bound<F: Future<Output = i32>>(fut: F) -> i32 {
    fut.await + 1i32
}

async fn await_where_bound<F>(fut: F) -> i32 where F: Future<Output = i32> {
    fut.await
}

async fn fallible_opt(x: Option<i32>) -> Option<i32> {
    let v = x?
    let sum = leaf_add(v, 5i32).await
    Option.Some(sum)
}

async fn fallible_res(x: Result<i32, i32>) -> Result<i32, i32> {
    let v = x?
    let sum = leaf_add(v, 7i32).await
    Result.Ok(sum)
}

fn require_send<T: Send>(val: T) -> T {
    val
}

fn main() {
    let fut = await_custom_and_coroutine(5i32)
    let _ = require_send(fut)
    let _ = await_generic_bound(leaf_add(1i32, 2i32))
    let _ = await_where_bound(ReadyI32 { val: 42i32 })
    let _ = fallible_opt(Option.Some(1i32))
    let _ = fallible_res(Result.Ok(2i32))
}
