// test: ui
// covers: REQ-ASY-023

// QA adversarial boundary test (T432):
// When a type parameter `T` is bounded by two traits (`LeftStep + RightStep`)
// that both provide a method with the same name (`step`), `find_method_in_scope`
// must still report `AX_TRAIT_AMBIGUOUS_METHOD`.

trait LeftStep {
    fn step(self: view<Self>) -> i32;
}

trait RightStep {
    fn step(self: view<Self>) -> i32;
}

fn call_ambiguous<T: LeftStep + RightStep>(x: view<T>) -> i32 {
    x.step() //~ ERROR AX_TRAIT_AMBIGUOUS_METHOD
}

fn main() -> i32 {
    0
}
