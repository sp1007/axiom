// test: ui

async fn direct_rec(n: i32) -> i32 {
    if n <= 0i32 {
        return 0i32
    }
    direct_rec(n - 1i32).await //~ ERROR AX_ASYNC_RECURSIVE_FUTURE
}

async fn ping(n: i32) -> i32 {
    if n <= 0i32 {
        return 0i32
    }
    pong(n - 1i32).await //~ ERROR AX_ASYNC_RECURSIVE_FUTURE
}

async fn pong(n: i32) -> i32 {
    if n <= 0i32 {
        return 0i32
    }
    ping(n - 1i32).await //~ ERROR AX_ASYNC_RECURSIVE_FUTURE
}

fn main() {
    let _ = direct_rec(3i32)
    let _ = ping(3i32)
}
