// test: ui

struct NotAFuture {
    x: i32,
}

async fn make_bool() -> bool {
    true
}

async fn bad_awaits() -> i32 {
    let a = (123i32).await //~ ERROR AX_ASYNC_NOT_A_FUTURE
    let s = NotAFuture { x: a }
    let _ = s.await //~ ERROR AX_ASYNC_NOT_A_FUTURE
    let b: i32 = make_bool().await //~ ERROR AX_TYPE_MISMATCH
    b
}

fn main() {
    let _ = bad_awaits()
}
