// test: run
// modes: interp native
// covers: REQ-CONC-014, REQ-ASY-023
// stdout: qa_ordering_shadow_and_supertrait_ok\n

// QA adversarial boundary test (T432):
// 1. Local `enum Ordering` coexisting with `std.core.cmp.Ordering` and
//    `std.sync.atomic.Ordering` in match exhaustiveness and qualified paths.
// 2. `find_method_in_scope` disambiguating colliding trait method names (`step`)
//    via supertrait bounds (`X: SubAlpha` where `SubAlpha: AlphaPoll`) and
//    `where`-clause bounds (`where Y: BetaPoll`) while `Poll.is_ready` and
//    `prelude_loaded()` from `std.core.prelude` are active.

use std.sync.atomic.AtomicI32

enum Ordering {
    North,
    South,
    East,
    West,
}

trait AlphaPoll {
    fn step(self: view<Self>) -> i32;
}

trait SubAlpha: AlphaPoll {
    fn sub_step(self: view<Self>) -> i32;
}

trait BetaPoll {
    fn step(self: view<Self>) -> i32;
}

struct Worker {
    base: i32,
}

impl AlphaPoll for Worker {
    fn step(self: view<Worker>) -> i32 {
        self.base + 10i32
    }
}

impl SubAlpha for Worker {
    fn sub_step(self: view<Worker>) -> i32 {
        self.base + 20i32
    }
}

struct AltWorker {
    base: i32,
}

impl BetaPoll for AltWorker {
    fn step(self: view<AltWorker>) -> i32 {
        self.base + 100i32
    }
}

fn run_sub<T, X: SubAlpha>(unused: T, x: view<X>) -> i32 {
    let _ = unused;
    x.step() + x.sub_step()
}

fn run_beta<T, Y>(unused: T, y: view<Y>) -> i32 where Y: BetaPoll {
    let _ = unused;
    y.step()
}

fn eval_local_ordering(d: Ordering) -> i32 {
    match d {
        Ordering.North => 1i32,
        Ordering.South => 2i32,
        Ordering.East => 3i32,
        Ordering.West => 4i32,
    }
}

fn eval_cmp_ordering(c: std.core.cmp.Ordering) -> i32 {
    match c {
        std.core.cmp.Ordering.Less => -5i32,
        std.core.cmp.Ordering.Equal => 0i32,
        std.core.cmp.Ordering.Greater => 5i32,
    }
}

fn eval_atomic_ordering(o: std.sync.atomic.Ordering) -> i32 {
    match o {
        std.sync.atomic.Ordering.Relaxed => 10i32,
        std.sync.atomic.Ordering.Acquire => 20i32,
        std.sync.atomic.Ordering.Release => 30i32,
        std.sync.atomic.Ordering.AcqRel => 40i32,
        std.sync.atomic.Ordering.SeqCst => 50i32,
    }
}

fn main() -> i32 {
    if !prelude_loaded() {
        return 1;
    }

    let p: Poll<i32> = Poll.Ready(7i32);
    if !p.is_ready() || p.is_pending() {
        return 2;
    }

    let loc = eval_local_ordering(Ordering.East) + eval_local_ordering(Ordering.North);
    if loc != 4i32 {
        return 3;
    }

    let cmp_v = eval_cmp_ordering(std.core.cmp.Ordering.Less) + eval_cmp_ordering(std.core.cmp.Ordering.Greater);
    if cmp_v != 0i32 {
        return 4;
    }

    let atm_v = eval_atomic_ordering(std.sync.atomic.Ordering.Acquire) + eval_atomic_ordering(std.sync.atomic.Ordering.SeqCst);
    if atm_v != 70i32 {
        return 5;
    }

    let a = AtomicI32.new(loc);
    let prev = a.fetch_add(atm_v, std.sync.atomic.Ordering.AcqRel);
    if prev != 4i32 || a.load(std.sync.atomic.Ordering.SeqCst) != 74i32 {
        return 6;
    }

    let w = Worker { base: 3i32 };
    let aw = AltWorker { base: 9i32 };
    let s1 = run_sub(0i32, view(w));
    let s2 = run_beta(0i32, view(aw));
    if s1 != 36i32 || s2 != 109i32 {
        return 7;
    }

    print("qa_ordering_shadow_and_supertrait_ok\n");
    0
}
