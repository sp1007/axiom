// test: ui
// T448 negative: a method type parameter that occurs only in the return type is not guessed. Without
// explicit type arguments (`g.collect<S>()`) or an annotation the call reports AX_TYPE_UNKNOWN.

struct G {
    k: usize,
}

struct Res<T> {
    n: usize,
    slot: Option<T>,
}

impl G {
    fn collect<T>(self: view<G>) -> Res<T> {
        Res<T> { n: self.k, slot: Option.None }
    }
}

fn main() -> i32 {
    let g = G { k: 3 };
    let r = g.collect(); //~ ERROR AX_TYPE_UNKNOWN
    r.n as i32
}
