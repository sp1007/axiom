// test: ui
// T448 negative: a type parameter that occurs in no value argument, no bound with a binding and no
// annotation still cannot be inferred: the call reports AX_TYPE_UNKNOWN (spec/diagnostics.md, "the type
// cannot be inferred; add an annotation") instead of guessing a type.

@intrinsic fn size_of<T>() -> usize { 0 }

fn free_one<T>() -> usize {
    size_of<T>()
}

fn main() -> i32 {
    let n = free_one(); //~ ERROR AX_TYPE_UNKNOWN
    n as i32
}
