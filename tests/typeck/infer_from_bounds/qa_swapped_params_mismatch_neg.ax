// test: ui
// QA (T448 FU-D): callee declares `<T, F: Future<Output = T>>` (T first); the caller's `F: Future<Output = i64>`
// still fixes `T = i64`, so returning the result as `bool` is a mismatch (no parameter renumbering confusion).

fn first<T, F2: Future<Output = T>>(fut: mut_view<F2>, cx: mut_view<Context>) -> T {
    match fut.poll(cx) {
        Poll.Ready(v) => v,
        Poll.Pending => first(fut, cx),
    }
}

fn outer<F: Future<Output = i64>>(fut: mut_view<F>, cx: mut_view<Context>) -> bool {
    first(fut, cx) //~ ERROR AX_TYPE_MISMATCH
}

fn main() -> i32 {
    0
}
