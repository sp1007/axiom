// test: ui
// QA (T448 FU-5): the method-call `Future` bound check is not a free pass — `Ex.spawn<F: Future<Output = T>, T>`
// with `Child: Future<Output = i64>` fixes `T = i64`, so binding the handle to `Handle<bool>` is a mismatch.

struct Child { base: i64 }

impl Future for Child {
    type Output = i64;
    fn poll(self: mut_view<Child>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(self.base)
    }
}

struct Handle<T> { out: Option<T> }

struct Ex { id: u64 }

impl Ex {
    fn spawn<F: Future<Output = T>, T>(self: view<Ex>, fut: F) -> Handle<T> {
        let _ = fut;
        Handle<T> { out: Option.None }
    }
}

fn main() -> i32 {
    let ex = Ex { id: 1u64 };
    let h: Handle<bool> = ex.spawn(Child { base: 1i64 }); //~ ERROR AX_TYPE_MISMATCH
    let _ = h;
    0
}
