// test: ui
// T448 negative: `T` of `first<F2: Future<Output = T>, T>` is fixed by the caller's bound
// `F: Future<Output = i64>`; using the result as `bool` is a type mismatch (the inference does not
// pick whatever the context wants).

fn first<F2: Future<Output = T>, T>(fut: mut_view<F2>, cx: mut_view<Context>) -> T {
    match fut.poll(cx) {
        Poll.Ready(v) => v,
        Poll.Pending => first(fut, cx),
    }
}

fn outer<F: Future<Output = i64>>(fut: mut_view<F>, cx: mut_view<Context>) -> bool {
    first(fut, cx) //~ ERROR AX_TYPE_MISMATCH
}

fn main() -> i32 {
    0
}
