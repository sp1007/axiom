// test: helper

struct Packet {
    b8: u8,
    s8: i8,
}

impl Packet {
    const ASSOC_U128: u128 = 77u128;

    fn get_u8(self: view<Packet>) -> u8 {
        self.b8
    }
}

fn fetch_u8() -> u8 {
    200u8
}

const C_I128: i128 = 42i128;
const C_U128: u128 = u64.MAX as u128 + 1u128;
const C_SHIFT_128: i128 = 1000i128 + (-5i32 as i128);
const C_POS_LEN: i128 = 4i128;
const C_U128_B: u128 = 99u128;

fn match_u128(x: u128) -> i32 {
    match x {
        0u128 => 10i32,
        18446744073709551616u128 => 20i32,
        18446744073709551617..=340282366920938463463374607431768211455 => 30i32,
        _ => 40i32,
    }
}

fn match_i128_min(x: i128) -> i32 {
    match x {
        -170141183460469231731687303715884105728 => 1i32,
        -170141183460469231731687303715884105727i128..=-1i128 => 2i32,
        0..=170141183460469231731687303715884105727 => 3i32,
        _ => 4i32,
    }
}

fn match_signed_excl_zero_i32(x: i32) -> i32 {
    match x {
        -10..0 => 1i32,
        -1..=1 => 2i32,
        -20..-15 => 3i32,
        _ => 4i32,
    }
}

fn match_signed_excl_zero_i128(x: i128) -> i32 {
    match x {
        -170141183460469231731687303715884105728i128..0i128 => 1i32,
        0i128..=1i128 => 2i32,
        _ => 3i32,
    }
}

fn match_signed_neg_bounds_i128(x: i128) -> i32 {
    match x {
        -10i128..0i128 => 1i32,
        -1i128..=1i128 => 2i32,
        -18446744073709551620i128..-18446744073709551616i128 => 3i32,
        _ => 4i32,
    }
}

fn main() {
    // Finding 4: unsuffixed 128-bit integer literals under type context (AXS-INT-004)
    let u_max: u128 = 340282366920938463463374607431768211455;
    let i_max: i128 = 170141183460469231731687303715884105727;
    let i_min: i128 = -170141183460469231731687303715884105728;
    let u_hex: u128 = 0x1_0000_0000_0000_0000;

    // Finding 1: 128-bit literal, range, and i128.MIN match patterns (including exclusive ..0)
    let m1: i32 = match_u128(u_max);
    let m2: i32 = match_i128_min(i_min + i_max * 0);
    let m3: i32 = match_signed_excl_zero_i32(-5i32);
    let m4: i32 = match_signed_excl_zero_i128(-1i128);
    let m5: i32 = match_signed_neg_bounds_i128(0i128);

    // Finding 3: Multi-width promotion across field, tuple, call, method, deref, and unary subtrees
    let p = Packet { b8: 200u8, s8: -50i8 };
    let tup: (u8, i8) = (200u8, -50i8);
    let s32: i32 = -2000i32;
    let s64: i64 = 100000i64;
    let u16v: u16 = 500u16;
    let u64v: u64 = 900000u64;
    let view_b8: view<u8> = view(p.b8);

    let total_field: i64 = (s64 + s32 * 3) - (u16v + p.b8 * 2 + p.s8 - 7) / (4 - p.s8);
    let total_tuple: i64 = (s64 + s32 * 3) - (u16v + tup.0 * 2 + tup.1 - 7) / (4 - tup.1);
    let total_calls: i64 = s64 + fetch_u8() * 2 + p.get_u8() * 2 + p.b8.wrapping_add(1u8) * 2 + (*view_b8) * 2;
    let total_unary_neg: i64 = s64 + (-p.s8 * 3);
    let total_top_neg: i64 = -(p.b8 * 2 + p.s8);
    let total_bitnot_mask: u64 = u64v & ~7;

    // Finding 6: 128-bit const folding and valid 128-bit array length expressions
    let arr: [C_POS_LEN]u8 = [1u8, 2u8, 3u8, 4u8];
    let arr_128_shift: [(1u128 << 65) >> 63]u8 = [1u8, 2u8, 3u8, 4u8];
    let folded_u: u128 = C_U128 + u_hex + (arr_128_shift[3] as u128);
    let folded_i: i128 = C_SHIFT_128;

    // Finding 7: Intrinsic methods on const and associated-const receivers
    let c_sat: i128 = C_I128.saturating_add(1i128);
    let c_wrap: i128 = C_I128.wrapping_sub(2i128);
    let c_lz: u32 = C_I128.leading_zeros();
    let s_sat: u128 = C_U128_B.saturating_mul(3u128);
    let s_rot: u128 = Packet.ASSOC_U128.rotate_left(4u32);

    let _ = m1 + m2 + m3 + m4 + m5 + (c_lz as i32) + (arr[0] as i32);
    let _ = total_field + total_tuple + total_calls + total_unary_neg + total_top_neg + (total_bitnot_mask as i64);
    let _ = folded_u + s_sat + s_rot;
    let _ = folded_i + c_sat + c_wrap;
}
