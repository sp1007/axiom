// test: ui
fn takes_i64(x: i64) -> i64 { x }

fn main() {
    // 1. Standalone variable binding between distinct integer widths is rejected
    let a_i32: i32 = 10i32;
    let b_i64: i64 = a_i32; //~ ERROR AX_TYPE_MISMATCH
    let c_i64: i64 = takes_i64(a_i32); //~ ERROR AX_TYPE_MISMATCH

    // 2. Standalone same-width signed and unsigned binary operation is rejected
    let d_u32: u32 = 2u32;
    let e = a_i32 + d_u32; //~ ERROR AX_TYPE_MISMATCH

    // 3. u128 mixed with signed integer has no lossless super-type
    let big_u128: u128 = 1u128;
    let f = big_u128 + a_i32; //~ ERROR AX_TYPE_MISMATCH

    // 4. 128-bit literal out of signed i128 range
    let out1: i128 = 170141183460469231731687303715884105728i128; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let out2: i128 = -170141183460469231731687303715884105729i128; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE

    // 5. Same-width i128 + u128 standalone, unary neg on u128, non-int index, and int-to-bool cast
    let big_i128: i128 = 1i128;
    let g = big_i128 + big_u128; //~ ERROR AX_TYPE_MISMATCH
    let h = -big_u128; //~ ERROR AX_TYPE_NEG_UNSIGNED
    let arr: [2]i32 = [1i32, 2i32];
    let bad_idx = arr[true]; //~ ERROR AX_TYPE_MISMATCH
    let bad_cast = big_i128 as bool; //~ ERROR AX_TYPE_INVALID_CAST
}
