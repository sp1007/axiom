// test: helper
fn main() {
    // Same-signedness widening chains
    let s8: i8 = -50i8;
    let s16: i16 = 300i16;
    let s32: i32 = -2000i32;
    let s64: i64 = 100000i64;
    let s128: i128 = 5000000i128;

    let a1: i16 = s8 + s16;
    let a2: i32 = s16 + s32;
    let a3: i64 = s32 + s64;
    let a4: i128 = s64 + s128;

    let b8: u8 = 200u8;
    let u16v: u16 = 500u16;
    let u32v: u32 = 40000u32;
    let u64v: u64 = 900000u64;
    let u128v: u128 = 7000000u128;

    let u1: u16 = b8 + u16v;
    let u2: u32 = u16v + u32v;
    let u3: u64 = u32v + u64v;
    let u4: u128 = u64v + u128v;

    // Narrow unsigned + wider signed -> wider signed
    let m1: i16 = b8 + s16;
    let m2: i32 = u16v + s32;
    let m3: i64 = u32v + s64;
    let m4: i128 = u64v + s128;

    // Narrow signed + wider unsigned -> next wider signed
    let m5: i32 = s8 + u16v;
    let m6: i64 = s16 + u32v;
    let m7: i128 = s32 + u64v;

    // REQ-OWNER-007 Pattern D: compound multi-width integer expression
    let total: i64 = (s64 + s32 * 3) - (u16v + b8 * 2 + s8 - 7) / (4 - s8);
    let total128: i128 = (s128 + s64 * 3) - (u64v + u32v * 2 + s32 - 7) / (4 - s32);
    let shift_tree: i64 = (((u32v >> b8) & 0x3F) + s16 * s8 - 5) * s64 / ((1 << b8) + 3);

    // Match range pattern on i128 / u128
    let range_res: i32 = match s128 {
        0i128..=100i128 => 1i32,
        _ => 2i32,
    };
    let _ = shift_tree + range_res;

    // Mixed-width comparisons
    let cmp1: bool = s8 < s32 && b8 < u32v && b8 < s16 && s8 < u16v && s64 < s128;

    // Non-usize integer indexing into arrays and slices
    let arr: [4]i32 = [10i32, 20i32, 30i32, 40i32];
    let idx_i32: i32 = 1i32;
    let off_i16: i16 = 1i16;
    let elem1: i32 = arr[idx_i32 + off_i16];
    let elem2: i32 = arr[idx_i32 - 1];
    let elem3: i32 = arr[0u8];
}
