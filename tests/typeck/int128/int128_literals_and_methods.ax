// test: helper
@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

@lang("Ordering")
@derive(Copy)
enum Ordering {
    Less,
    Equal,
    Greater,
}
impl Clone for Ordering { fn clone(self: view<Ordering>) -> Ordering { *self } }

@lang("cmp")
trait Ord {
    fn cmp(self: view<Self>, other: view<Self>) -> Ordering;
}

@lang("eq")
trait PartialEq {
    fn eq(self: view<Self>, other: view<Self>) -> bool;
}

trait Eq: PartialEq {}

@lang("clone")
trait Clone {
    fn clone(self: view<Self>) -> Self;
}

trait Copy: Clone {}

trait Hasher {
    fn write_u64(self: mut_view<Self>, i: u64);
}

trait Hash {
    fn hash<H: Hasher>(self: view<Self>, state: mut_view<H>);
}

impl PartialEq for i128 {
    fn eq(self: view<i128>, other: view<i128>) -> bool { *self == *other }
}
impl Eq for i128 {}
impl Ord for i128 {
    fn cmp(self: view<i128>, other: view<i128>) -> Ordering {
        if *self < *other { Ordering.Less }
        else if *self > *other { Ordering.Greater }
        else { Ordering.Equal }
    }
}
impl Clone for i128 {
    fn clone(self: view<i128>) -> i128 { *self }
}
impl Copy for i128 {}
impl Hash for i128 {
    fn hash<H: Hasher>(self: view<i128>, state: mut_view<H>) {
        state.write_u64((*self) as u64);
    }
}

impl PartialEq for u128 {
    fn eq(self: view<u128>, other: view<u128>) -> bool { *self == *other }
}
impl Eq for u128 {}
impl Ord for u128 {
    fn cmp(self: view<u128>, other: view<u128>) -> Ordering {
        if *self < *other { Ordering.Less }
        else if *self > *other { Ordering.Greater }
        else { Ordering.Equal }
    }
}
impl Clone for u128 {
    fn clone(self: view<u128>) -> u128 { *self }
}
impl Copy for u128 {}
impl Hash for u128 {
    fn hash<H: Hasher>(self: view<u128>, state: mut_view<H>) {
        state.write_u64((*self) as u64);
    }
}

@derive(Copy, Clone, Eq, PartialEq, Ord, Hash)
struct Pair128 {
    signed_val: i128,
    unsigned_val: u128,
}

const MAX_U128: u128 = 340282366920938463463374607431768211455u128;
const MAX_I128: i128 = 170141183460469231731687303715884105727i128;
const MIN_I128: i128 = -170141183460469231731687303715884105728i128;
const ASSOC_BITS: u32 = i128.BITS;

fn needs_traits<T: Copy + Clone + Eq + PartialEq + Ord + Hash>(x: T, y: T) -> bool {
    x.eq(view(y))
}

fn main() {
    let a: i128 = MAX_I128;
    let b: i128 = MIN_I128;
    let c: u128 = MAX_U128;
    let d: u128 = 0xffffffffffffffffffffffffffffffffu128;

    let min_i: i128 = i128.MIN;
    let max_i: i128 = i128.MAX;
    let bits_i: u32 = i128.BITS;
    let min_u: u128 = u128.MIN;
    let max_u: u128 = u128.MAX;
    let bits_u: u32 = u128.BITS;

    let s1: i128 = a.saturating_add(1i128);
    let s2: i128 = b.saturating_sub(1i128);
    let s3: i128 = a.saturating_mul(2i128);
    let s4: u128 = u128.saturating_add(c, 1u128);
    let s5: i32 = (100i32).saturating_add(27i32);

    let w1: i128 = a.wrapping_add(1i128);
    let w2: u128 = d.wrapping_sub(1u128);
    let w3: i128 = a.wrapping_mul(2i128);
    let w4: i128 = a.wrapping_neg();

    let ones: u32 = c.count_ones();
    let lz: u32 = c.leading_zeros();
    let tz: u32 = c.trailing_zeros();
    let rl: u128 = c.rotate_left(4u32);
    let rr: u128 = c.rotate_right(4u32);
    let sb: u128 = c.swap_bytes();
    let rb: u128 = c.reverse_bits();

    let cast1: i128 = 42i32 as i128;
    let cast2: u64 = c as u64;
    let sz: usize = size_of<i128>() + align_of<u128>();

    let p1 = Pair128 { signed_val: s1, unsigned_val: s4 };
    let p2 = p1;
    let ok1: bool = needs_traits<i128>(s1, s2);
    let ok2: bool = needs_traits<u128>(s4, rl);
    let ok3: bool = needs_traits<Pair128>(p1, p2);
}
