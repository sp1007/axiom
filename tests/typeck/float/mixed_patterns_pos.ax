// test: helper
// T457: REQ-OWNER-007 Patterns A, B, C and D (SPEC-41 AXS-FLT-036/037) type-check without suffixes or
// manual casts; each result binds to its declared type.

fn main() -> i32 {
    let a: f64 = 6.0
    let w: f32 = 1.5f32
    let i: i32 = 4
    let k: i16 = 3i16
    let u: u16 = 5u16
    let n: usize = 3usize
    let base: i64 = 36i64
    let y: f64 = ((a + i * k - 1) / (2 * n + u - 3)) * (w + 0.5) + (base - u * 4 + i) / (a * a / 6.0 - k + 2)

    let mask: u32 = 0xABu32
    let sh: u8 = 2u8
    let delta: i8 = -3i8
    let step: isize = 5isize
    let scale: f64 = 3.5
    let z: f64 = (((mask >> sh) & 0x3F) + delta * step - 5) * scale / ((1 << sh) + 3)

    let coeff: [4]f32 = [1.0f32, 2.5f32, 4.0f32, 0.5f32]
    let idx: u8 = 1u8
    let off: isize = 1isize
    let x: f64 = 6.0
    let i2: i32 = 2
    let base2: i64 = 100i64
    let u2: u16 = 3u16
    let p: f64 = coeff[idx + off] * (x - 3) / (idx * 2 + 1) + coeff[idx - 1] * 4
    let ok: bool = (p + i2 * 0.5) > (base2 / 10 - u2 + 1.25)

    let s64: i64 = 100000
    let s32: i32 = -2000
    let u16v: u16 = 500
    let b8: u8 = 200
    let s8: i8 = -50
    let total: i64 = (s64 + s32 * 3) - (u16v + b8 * 2 + s8 - 7) / (4 - s8)

    let half: f32 = i2 * 0.5
    let cmp_int_float: bool = i2 < x
    let lit_left: f64 = 2 * x - -3
    let _ = y
    let _ = z
    let _ = ok
    let _ = total
    let _ = half
    let _ = cmp_int_float
    let _ = lit_left
    return 0
}
