// test: ui
// T457 QA: adversarial negatives for SPEC-41 AXS-FLT-033/035 and the literal range rules (AXS-FLT-003 rule 3),
// including the exact f32/f64 overflow boundaries (half an ulp above MAX rounds to infinity).
fn takes_f64(p: f64) -> f64 { p }

fn main() {
    let x: f64 = 2.5
    let w: f32 = 1.5f32
    let i: i32 = 3
    let u: u32 = 4u32
    let b: bool = true
    let c: char = 'a'
    let arr: [4]f32 = [1.0f32, 2.0f32, 3.0f32, 4.0f32]
    let e1: f32 = x //~ ERROR AX_TYPE_MISMATCH
    let e2 = i + u //~ ERROR AX_TYPE_MISMATCH
    let e3: i32 = x + w //~ ERROR AX_TYPE_MISMATCH
    let e4 = takes_f64(w) //~ ERROR AX_TYPE_MISMATCH
    let e5 = takes_f64(1) //~ ERROR AX_TYPE_MISMATCH
    let e6 = x | w //~ ERROR AX_TYPE_OPERATOR
    let e7 = x ^ 2 //~ ERROR AX_TYPE_OPERATOR
    let e8 = x >> 1 //~ ERROR AX_TYPE_OPERATOR
    let e9 = b as f64 //~ ERROR AX_TYPE_INVALID_CAST
    let e10 = c as f64 //~ ERROR AX_TYPE_INVALID_CAST
    let e11 = x as char //~ ERROR AX_TYPE_INVALID_CAST
    let e12 = x + b //~ ERROR AX_TYPE_MISMATCH
    let e13 = arr[w] //~ ERROR AX_TYPE_INDEX_NOT_INT
    let e14 = arr[x + 1] //~ ERROR AX_TYPE_INDEX_NOT_INT
    let e15: i32 = 1.5 //~ ERROR AX_TYPE_MISMATCH
    let e16: f32 = 3.4028236e38 //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let e17: f64 = 1.7976931348623159e308 //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let e18 = -3.5e38f32 //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let e19: f32 = w + 1.5f64 //~ ERROR AX_TYPE_MISMATCH
}
