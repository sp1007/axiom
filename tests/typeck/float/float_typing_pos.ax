// test: helper
// T457 (SPEC-41 AXS-FLT-001..006, AXS-FLT-022..024): f32/f64 types, literal suffixes, FloatVar inference
// (default f64), explicit `as` casts, unary minus, comparisons and float literal patterns.

fn takes_f64(x: f64) -> f64 { x }

fn takes_f32(x: f32) -> f32 { x }

fn classify(x: f64) -> i32 {
    match x {
        0.0 => 0,
        -1.5 => 1,
        2.5 => 2,
        _ => 3,
    }
}

fn main() -> i32 {
    let a = 1.5
    let b: f32 = 2.5
    let c: f64 = 3.0f64
    let d = 2.5f32
    let e = 6.02e23
    let f: f32 = 1e-5
    let g = -0.0
    let h = 3.141_592_65
    let sum32: f32 = b + d * 2.0
    let sum64: f64 = a + c - e / 2.0 + h
    let neg: f64 = -sum64
    let to_i: i32 = sum64 as i32
    let to_u8: u8 = neg as u8
    let to_f32: f32 = sum64 as f32
    let to_f64: f64 = sum32 as f64
    let from_i: f64 = to_i as f64
    let from_lit: f32 = 7 as f32
    let lt: bool = a < c
    let ne: bool = sum32 != b
    let ge: bool = f >= 0.0
    let wide: f64 = takes_f64(c) + takes_f32(b)
    let k = classify(g)
    let _ = to_u8
    let _ = to_f32
    let _ = to_f64
    let _ = from_i
    let _ = from_lit
    let _ = lt
    let _ = ne
    let _ = ge
    let _ = neg
    let _ = wide
    return k
}
