// test: ui
// T457 (SPEC-41 AXS-FLT-003, AXS-FLT-024, AXS-FLT-033, AXS-FLT-035): boundaries where implicit promotion is
// forbidden, float-only operator restrictions and literal range errors.
fn takes_f64(p: f64) -> f64 { p }

fn main() {
    let a_f32: f32 = 1.5f32
    let a_f64: f64 = 2.5
    let n_i32: i32 = 3
    let x1: f64 = a_f32 //~ ERROR AX_TYPE_MISMATCH
    let x2: f64 = n_i32 //~ ERROR AX_TYPE_MISMATCH
    let x3: f64 = 1 //~ ERROR AX_TYPE_MISMATCH
    let w: f32 = a_f64 + 1.0f32 //~ ERROR AX_TYPE_MISMATCH
    let n: i32 = a_f64 + 1.0 //~ ERROR AX_TYPE_MISMATCH
    let c1 = takes_f64(n_i32) //~ ERROR AX_TYPE_MISMATCH
    let c2 = takes_f64(a_f32) //~ ERROR AX_TYPE_MISMATCH
    let bits = a_f64 & 1.0 //~ ERROR AX_TYPE_OPERATOR
    let sh = a_f64 << 1 //~ ERROR AX_TYPE_OPERATOR
    let nt = ~a_f64 //~ ERROR AX_TYPE_OPERATOR
    let big64: f64 = 1e309 //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let big32: f32 = 3.5e38 //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let bad_idx = [1, 2][a_f64] //~ ERROR AX_TYPE_INDEX_NOT_INT
    let bad_cast = a_f64 as bool //~ ERROR AX_TYPE_INVALID_CAST
    let mix_bool = a_f64 + true //~ ERROR AX_TYPE_MISMATCH
}
