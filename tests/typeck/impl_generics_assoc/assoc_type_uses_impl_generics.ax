// test: run
// modes: interp native
// stdout: 117 -1 230 128 -7\n
// exit: 47
// Regression for T447 (FU-B, ADR-0042 §2): the impl's generic scope encloses its associated-type
// definitions. `type Output = Result<T, E>` inside `impl<F: Future<Output = T>, T> Future for W<F, T>`
// and `type Output = Option<TaskResult<T>>` inside `impl<T> Future for GroupNext<T>` resolve `T`
// (also through the top-level clone HIR post-processing makes of every impl member). The associated
// type is used through a bound parameter: `F.Output` / `G.Output` resolve via the bound's binding,
// in the associated type itself, in method signatures and in local annotations.

struct E {
    code: i64,
}

struct FutA {
    v: i64,
}

impl Future for FutA {
    type Output = i64;
    fn poll(self: mut_view<FutA>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(100i64 + self.v)
    }
}

struct W<F, T> {
    fut: F,
    tag: T,
}

impl<F: Future<Output = T>, T> Future for W<F, T> {
    type Output = Result<T, E>;
    fn poll(self: mut_view<W<F, T>>, cx: mut_view<Context>) -> Poll<Result<T, E>> {
        let inner: Poll<F.Output> = self.fut.poll(cx);
        match inner {
            Poll.Ready(v) => Poll.Ready(Result.Ok(v)),
            Poll.Pending => Poll.Pending,
        }
    }
}

struct TaskResult<T> {
    id: i64,
    value: T,
}

struct GroupNext<T> {
    id: i64,
    value: T,
    done: bool,
}

impl<T: Copy> Future for GroupNext<T> {
    type Output = Option<TaskResult<T>>;
    fn poll(self: mut_view<GroupNext<T>>, cx: mut_view<Context>) -> Poll<Option<TaskResult<T>>> {
        let _ = cx;
        if self.done {
            Poll.Ready(Option.None)
        } else {
            Poll.Ready(Option.Some(TaskResult<T> { id: self.id, value: self.value }))
        }
    }
}

// Consumes W's associated type (Result<T, E>) through the bound `G: Future<Output = Result<T, E>>`.
struct Outer<G, T> {
    inner: G,
    bias: T,
}

impl<G: Future<Output = Result<T, E>>, T> Future for Outer<G, T> {
    type Output = G.Output;
    fn poll(self: mut_view<Outer<G, T>>, cx: mut_view<Context>) -> Poll<G.Output> {
        let r: Poll<G.Output> = self.inner.poll(cx);
        r
    }
}

fn res_val(r: Result<i64, E>) -> i64 {
    match r {
        Result.Ok(v) => v,
        Result.Err(e) => e.code,
    }
}

fn opt_val(o: Option<TaskResult<i64>>) -> i64 {
    match o {
        Option.Some(tr) => tr.id * 100i64 + tr.value,
        Option.None => -1i64,
    }
}

fn main() -> i32 {
    let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
    let w = Waker { raw: rw };
    let mut cx = Context { waker_val: w };

    let mut wa = W<FutA, i64> { fut: FutA { v: 17i64 }, tag: 0i64 };
    let r1 = match wa.poll(mut_view(cx)) {
        Poll.Ready(r) => res_val(r),
        Poll.Pending => -2i64,
    };

    let mut g0 = GroupNext<i64> { id: 1i64, value: 5i64, done: true };
    let r2 = match g0.poll(mut_view(cx)) {
        Poll.Ready(o) => opt_val(o),
        Poll.Pending => -2i64,
    };

    let mut g1 = GroupNext<i64> { id: 2i64, value: 30i64, done: false };
    let r3 = match g1.poll(mut_view(cx)) {
        Poll.Ready(o) => opt_val(o),
        Poll.Pending => -2i64,
    };

    let mut o = Outer<W<FutA, i64>, i64> {
        inner: W<FutA, i64> { fut: FutA { v: 28i64 }, tag: 0i64 },
        bias: 0i64,
    };
    let r4 = match o.poll(mut_view(cx)) {
        Poll.Ready(r) => res_val(r),
        Poll.Pending => -2i64,
    };

    let ok_err: Result<i64, E> = Result.Err(E { code: -7i64 });
    let r5 = res_val(ok_err);

    print_int(r1 as i32); print(" ");
    print_int(r2 as i32); print(" ");
    print_int(r3 as i32); print(" ");
    print_int(r4 as i32); print(" ");
    print_int(r5 as i32); print("\n");

    if r1 == 117i64 && r2 == -1i64 && r3 == 230i64 && r4 == 128i64 && r5 == -7i64 {
        47
    } else {
        1
    }
}
