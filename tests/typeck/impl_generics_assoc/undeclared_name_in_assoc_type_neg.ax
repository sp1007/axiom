// test: ui
// T447 (FU-B, ADR-0042 §2) negative: the impl's generic scope encloses its associated types, but only the
// parameters it declares; an undeclared name in `type Out` is still AX_NAME_UNRESOLVED (typeck).

struct G<T> {
    v: T,
}

trait Tr {
    type Out;
    fn get(self: view<Self>) -> i32;
}

impl<T> Tr for G<T> {
    type Out = Option<U>; //~ ERROR AX_NAME_UNRESOLVED
    fn get(self: view<G<T>>) -> i32 { 1 }
}

fn main() {}
