// test: ui
// T447 (FU-B, ADR-0042 §2) negative: `P.Assoc` is accepted by the resolver only when `P` is a generic
// parameter; a projection on any other name is still AX_NAME_UNRESOLVED.

trait Tr {
    type Out;
    fn get(self: view<Self>) -> i32;
}

struct H {
    v: i32,
}

impl Tr for H {
    type Out = Q.Out; //~ ERROR AX_NAME_UNRESOLVED
    fn get(self: view<H>) -> i32 { 2 }
}

fn main() {}
