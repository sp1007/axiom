// test: run
// stdout: tokens: 76, kw: 12, idents: 25, nums: 5, syms: 34\nOK tokenizer\n

@intrinsic fn assert(c: bool) {}

fn is_alpha(b: u8) -> bool {
    (b >= 97u8 && b <= 122u8) || (b >= 65u8 && b <= 90u8) || b == 95u8
}

fn is_digit(b: u8) -> bool {
    b >= 48u8 && b <= 57u8
}

fn is_alnum(b: u8) -> bool {
    is_alpha(b) || is_digit(b)
}

fn is_ws(b: u8) -> bool {
    b == 32u8 || b == 10u8 || b == 13u8 || b == 9u8
}

fn is_keyword(src: view<[u8]>, start: usize, len_tok: usize) -> bool {
    if len_tok == 2 {
        let b0 = src[start];
        let b1 = src[start + 1];
        if b0 == 102u8 && b1 == 110u8 { return true; } // fn
        if b0 == 105u8 && b1 == 102u8 { return true; } // if
        return false;
    }
    if len_tok == 3 {
        let b0 = src[start];
        let b1 = src[start + 1];
        let b2 = src[start + 2];
        if b0 == 108u8 && b1 == 101u8 && b2 == 116u8 { return true; } // let
        if b0 == 109u8 && b1 == 117u8 && b2 == 116u8 { return true; } // mut
        return false;
    }
    if len_tok == 4 {
        let b0 = src[start];
        let b1 = src[start + 1];
        let b2 = src[start + 2];
        let b3 = src[start + 3];
        if b0 == 101u8 && b1 == 108u8 && b2 == 115u8 && b3 == 101u8 { return true; } // else
        return false;
    }
    if len_tok == 5 {
        let b0 = src[start];
        let b1 = src[start + 1];
        let b2 = src[start + 2];
        let b3 = src[start + 3];
        let b4 = src[start + 4];
        if b0 == 119u8 && b1 == 104u8 && b2 == 105u8 && b3 == 108u8 && b4 == 101u8 { return true; } // while
        return false;
    }
    if len_tok == 6 {
        let b0 = src[start];
        let b1 = src[start + 1];
        let b2 = src[start + 2];
        let b3 = src[start + 3];
        let b4 = src[start + 4];
        let b5 = src[start + 5];
        if b0 == 114u8 && b1 == 101u8 && b2 == 116u8 && b3 == 117u8 && b4 == 114u8 && b5 == 110u8 { return true; } // return
        return false;
    }
    false
}

fn main() {
    let src: [255]u8 = [
        10u8, 102u8, 110u8, 32u8, 102u8, 105u8, 98u8, 40u8, 110u8, 58u8, 32u8, 105u8, 51u8, 50u8, 41u8, 32u8, 45u8, 62u8, 32u8, 105u8, 51u8, 50u8, 32u8, 123u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 105u8, 102u8, 32u8, 110u8, 32u8, 60u8, 61u8, 32u8, 49u8, 32u8, 123u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 114u8, 101u8, 116u8, 117u8, 114u8, 110u8, 32u8, 110u8, 59u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 125u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 108u8, 101u8, 116u8, 32u8, 109u8, 117u8, 116u8, 32u8, 97u8, 58u8, 32u8, 105u8, 51u8, 50u8, 32u8, 61u8, 32u8, 48u8, 59u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 108u8, 101u8, 116u8, 32u8, 109u8, 117u8, 116u8, 32u8, 98u8, 58u8, 32u8, 105u8, 51u8, 50u8, 32u8, 61u8, 32u8, 49u8, 59u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 108u8, 101u8, 116u8, 32u8, 109u8, 117u8, 116u8, 32u8, 105u8, 58u8, 32u8, 105u8, 51u8, 50u8, 32u8, 61u8, 32u8, 50u8, 59u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 119u8, 104u8, 105u8, 108u8, 101u8, 32u8, 105u8, 32u8, 60u8, 61u8, 32u8, 110u8, 32u8, 123u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 108u8, 101u8, 116u8, 32u8, 99u8, 58u8, 32u8, 105u8, 51u8, 50u8, 32u8, 61u8, 32u8, 97u8, 32u8, 43u8, 32u8, 98u8, 59u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 97u8, 32u8, 61u8, 32u8, 98u8, 59u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 98u8, 32u8, 61u8, 32u8, 99u8, 59u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 105u8, 32u8, 61u8, 32u8, 105u8, 32u8, 43u8, 32u8, 49u8, 59u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 125u8, 10u8,
        32u8, 32u8, 32u8, 32u8, 114u8, 101u8, 116u8, 117u8, 114u8, 110u8, 32u8, 98u8, 59u8, 10u8,
        125u8, 10u8
    ];

    let n: usize = 255;
    let mut total: i32 = 0;
    let mut kw: i32 = 0;
    let mut idents: i32 = 0;
    let mut nums: i32 = 0;
    let mut syms: i32 = 0;

    let mut i: usize = 0;
    while i < n {
        let b = src[i];
        if is_ws(b) {
            i = i + 1;
        } else if is_alpha(b) {
            let start = i;
            while i < n && is_alnum(src[i]) {
                i = i + 1;
            }
            let len_tok = i - start;
            if is_keyword(view(src), start, len_tok) {
                kw = kw + 1;
            } else {
                idents = idents + 1;
            }
            total = total + 1;
        } else if is_digit(b) {
            while i < n && is_digit(src[i]) {
                i = i + 1;
            }
            nums = nums + 1;
            total = total + 1;
        } else {
            // Symbols / operators: check 2-char tokens (->, <=, ==)
            if i + 1 < n {
                let b1 = src[i + 1];
                if (b == 45u8 && b1 == 62u8) || (b == 60u8 && b1 == 61u8) || (b == 61u8 && b1 == 61u8) {
                    i = i + 2;
                    syms = syms + 1;
                    total = total + 1;
                } else {
                    i = i + 1;
                    syms = syms + 1;
                    total = total + 1;
                }
            } else {
                i = i + 1;
                syms = syms + 1;
                total = total + 1;
            }
        }
    }

    assert(total == 76);
    assert(kw == 12);
    assert(idents == 25);
    assert(nums == 5);
    assert(syms == 34);

    print("tokens: 76, kw: 12, idents: 25, nums: 5, syms: 34\nOK tokenizer\n");
}
