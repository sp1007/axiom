// test: run
// stdout: insertion_sort: OK, selection_sort: OK, bubble_sort: OK, shell_sort: OK\nOK sorting\n

@intrinsic fn assert(c: bool) {}

fn is_sorted(arr: view<[i32]>) -> bool {
    let n = len(arr);
    if n <= 1 {
        return true;
    }
    let mut i: usize = 0;
    while i + 1 < n {
        if arr[i] > arr[i + 1] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn sum_arr(arr: view<[i32]>) -> i64 {
    let n = len(arr);
    let mut s: i64 = 0;
    let mut i: usize = 0;
    while i < n {
        s = s + (arr[i] as i64);
        i = i + 1;
    }
    s
}

fn insertion_sort(arr: mut_view<[i32]>) {
    let n = len(arr);
    let mut i: usize = 1;
    while i < n {
        let key = arr[i];
        let mut j: usize = i;
        while j > 0 && arr[j - 1] > key {
            arr[j] = arr[j - 1];
            j = j - 1;
        }
        arr[j] = key;
        i = i + 1;
    }
}

fn selection_sort(arr: mut_view<[i32]>) {
    let n = len(arr);
    let mut i: usize = 0;
    while i < n {
        let mut min_idx = i;
        let mut j = i + 1;
        while j < n {
            if arr[j] < arr[min_idx] {
                min_idx = j;
            }
            j = j + 1;
        }
        let tmp = arr[i];
        arr[i] = arr[min_idx];
        arr[min_idx] = tmp;
        i = i + 1;
    }
}

fn bubble_sort(arr: mut_view<[i32]>) {
    let n = len(arr);
    let mut i: usize = 0;
    while i < n {
        let mut j: usize = 0;
        while j + 1 < n - i {
            if arr[j] > arr[j + 1] {
                let tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn shell_sort(arr: mut_view<[i32]>) {
    let n = len(arr);
    let mut gap: usize = n / 2;
    while gap > 0 {
        let mut i: usize = gap;
        while i < n {
            let temp = arr[i];
            let mut j: usize = i;
            while j >= gap && arr[j - gap] > temp {
                arr[j] = arr[j - gap];
                j = j - gap;
            }
            arr[j] = temp;
            i = i + 1;
        }
        gap = gap / 2;
    }
}

fn main() {
    // 1. Insertion sort test
    let mut arr1: [16]i32 = [45, 12, 89, 34, 2, 78, 61, 23, 90, 11, 5, 67, 33, 88, 19, 54];
    let chk1 = sum_arr(view(arr1));
    insertion_sort(mut_view(arr1));
    assert(is_sorted(view(arr1)));
    assert(sum_arr(view(arr1)) == chk1);

    // 2. Selection sort test
    let mut arr2: [16]i32 = [45, 12, 89, 34, 2, 78, 61, 23, 90, 11, 5, 67, 33, 88, 19, 54];
    let chk2 = sum_arr(view(arr2));
    selection_sort(mut_view(arr2));
    assert(is_sorted(view(arr2)));
    assert(sum_arr(view(arr2)) == chk2);

    // 3. Bubble sort test
    let mut arr3: [16]i32 = [45, 12, 89, 34, 2, 78, 61, 23, 90, 11, 5, 67, 33, 88, 19, 54];
    let chk3 = sum_arr(view(arr3));
    bubble_sort(mut_view(arr3));
    assert(is_sorted(view(arr3)));
    assert(sum_arr(view(arr3)) == chk3);

    // 4. Shell sort test
    let mut arr4: [16]i32 = [45, 12, 89, 34, 2, 78, 61, 23, 90, 11, 5, 67, 33, 88, 19, 54];
    let chk4 = sum_arr(view(arr4));
    shell_sort(mut_view(arr4));
    assert(is_sorted(view(arr4)));
    assert(sum_arr(view(arr4)) == chk4);

    // 5. Edge cases: already sorted, reverse sorted, all equal
    let mut sorted_arr: [5]i32 = [1, 2, 3, 4, 5];
    shell_sort(mut_view(sorted_arr));
    assert(is_sorted(view(sorted_arr)));

    let mut rev_arr: [5]i32 = [5, 4, 3, 2, 1];
    insertion_sort(mut_view(rev_arr));
    assert(is_sorted(view(rev_arr)));

    let mut eq_arr: [5]i32 = [7, 7, 7, 7, 7];
    bubble_sort(mut_view(eq_arr));
    assert(is_sorted(view(eq_arr)));

    print("insertion_sort: OK, selection_sort: OK, bubble_sort: OK, shell_sort: OK\nOK sorting\n");
}
