// test: run
// stdout: res1: 95, res2: 85, res3: 30, res4: 7\nOK expr_interp\n

@intrinsic fn assert(c: bool) {}

// Stack VM Opcodes
// 1: PUSH(arg), 2: ADD, 3: SUB, 4: MUL, 5: DIV, 6: NEG, 7: DUP

fn run_vm(ops: view<[i32]>, args: view<[i64]>) -> i64 {
    let n = len(ops);
    let mut stack: [32]i64 = [0; 32];
    let mut sp: usize = 0;
    let mut pc: usize = 0;

    while pc < n {
        let op = ops[pc];
        if op == 1 {
            // PUSH
            stack[sp] = args[pc];
            sp = sp + 1;
        } else if op == 2 {
            // ADD
            let b = stack[sp - 1];
            let a = stack[sp - 2];
            sp = sp - 1;
            stack[sp - 1] = a + b;
        } else if op == 3 {
            // SUB
            let b = stack[sp - 1];
            let a = stack[sp - 2];
            sp = sp - 1;
            stack[sp - 1] = a - b;
        } else if op == 4 {
            // MUL
            let b = stack[sp - 1];
            let a = stack[sp - 2];
            sp = sp - 1;
            stack[sp - 1] = a * b;
        } else if op == 5 {
            // DIV
            let b = stack[sp - 1];
            let a = stack[sp - 2];
            sp = sp - 1;
            if b != 0 {
                stack[sp - 1] = a / b;
            } else {
                stack[sp - 1] = 0;
            }
        } else if op == 6 {
            // NEG
            stack[sp - 1] = -stack[sp - 1];
        } else if op == 7 {
            // DUP
            let v = stack[sp - 1];
            stack[sp] = v;
            sp = sp + 1;
        }
        pc = pc + 1;
    }

    if sp > 0 {
        stack[sp - 1]
    } else {
        0
    }
}

fn eval_conditional(x: i64) -> i64 {
    // if x > 10 then x * 2 else x + 2
    if x > 10 {
        let ops: [3]i32 = [1, 1, 4]; // PUSH x, PUSH 2, MUL
        let args: [3]i64 = [x, 2, 0];
        run_vm(view(ops), view(args))
    } else {
        let ops: [3]i32 = [1, 1, 2]; // PUSH x, PUSH 2, ADD
        let args: [3]i64 = [x, 2, 0];
        run_vm(view(ops), view(args))
    }
}

fn main() {
    // Expr 1: (15 + 25) * 3 - (100 / 4) -> 40 * 3 - 25 = 95
    // PUSH 15, PUSH 25, ADD, PUSH 3, MUL, PUSH 100, PUSH 4, DIV, SUB
    let ops1: [9]i32 = [1, 1, 2, 1, 4, 1, 1, 5, 3];
    let args1: [9]i64 = [15, 25, 0, 3, 0, 100, 4, 0, 0];
    let res1 = run_vm(view(ops1), view(args1));
    assert(res1 == 95);

    // Expr 2: 3 * x^2 - 5 * x + 7 for x = 6 (3 * 36 - 30 + 7 = 85)
    // PUSH 6, DUP, MUL, PUSH 3, MUL, PUSH 6, PUSH 5, MUL, SUB, PUSH 7, ADD
    let ops2: [11]i32 = [1, 7, 4, 1, 4, 1, 1, 4, 3, 1, 2];
    let args2: [11]i64 = [6, 0, 0, 3, 0, 6, 5, 0, 0, 7, 0];
    let res2 = run_vm(view(ops2), view(args2));
    assert(res2 == 85);

    // Expr 3: Conditional expression
    let res3 = eval_conditional(15);
    assert(res3 == 30);

    let res4 = eval_conditional(5);
    assert(res4 == 7);

    print("res1: 95, res2: 85, res3: 30, res4: 7\nOK expr_interp\n");
}
