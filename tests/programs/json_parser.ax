// test: run
// stdout: nodes: 18, version: 1, modules_sum: 60, config_opt: 2\nOK json_parser\n

@intrinsic fn assert(c: bool) {}

fn is_whitespace(b: u8) -> bool {
    b == 32u8 || b == 10u8 || b == 13u8 || b == 9u8
}

fn is_digit(b: u8) -> bool {
    b >= 48u8 && b <= 57u8
}

fn main() {
    let src: [113]u8 = [
        123u8, 34u8, 110u8, 97u8, 109u8, 101u8, 34u8, 58u8, 32u8, 34u8, 97u8, 120u8, 105u8, 111u8, 109u8, 34u8, 44u8, 32u8,
        34u8, 118u8, 101u8, 114u8, 115u8, 105u8, 111u8, 110u8, 34u8, 58u8, 32u8, 49u8, 44u8, 32u8,
        34u8, 115u8, 101u8, 108u8, 102u8, 95u8, 104u8, 111u8, 115u8, 116u8, 34u8, 58u8, 32u8, 116u8, 114u8, 117u8, 101u8, 44u8, 32u8,
        34u8, 109u8, 111u8, 100u8, 117u8, 108u8, 101u8, 115u8, 34u8, 58u8, 32u8, 91u8, 49u8, 48u8, 44u8, 32u8, 50u8, 48u8, 44u8, 32u8, 51u8, 48u8, 93u8, 44u8, 32u8,
        34u8, 99u8, 111u8, 110u8, 102u8, 105u8, 103u8, 34u8, 58u8, 32u8, 123u8,
        34u8, 111u8, 112u8, 116u8, 34u8, 58u8, 32u8, 50u8, 44u8, 32u8,
        34u8, 100u8, 101u8, 98u8, 117u8, 103u8, 34u8, 58u8, 32u8, 102u8, 97u8, 108u8, 115u8, 101u8, 125u8, 125u8
    ];

    let n: usize = 113;
    let mut pos: usize = 0;

    // Node storage
    let mut node_kinds: [32]i32 = [0; 32];
    let mut node_ints: [32]i64 = [0; 32];
    let mut node_count: i32 = 0;

    // Parser loop
    while pos < n {
        while pos < n && is_whitespace(src[pos]) {
            pos = pos + 1;
        }
        if pos >= n {
            break;
        }

        let b = src[pos];
        if b == 123u8 { // '{'
            let nid = node_count;
            node_kinds[nid as usize] = 1; // Object
            node_count = node_count + 1;
            pos = pos + 1;
        } else if b == 125u8 { // '}'
            pos = pos + 1;
        } else if b == 91u8 { // '['
            let nid = node_count;
            node_kinds[nid as usize] = 2; // Array
            node_count = node_count + 1;
            pos = pos + 1;
        } else if b == 93u8 { // ']'
            pos = pos + 1;
        } else if b == 34u8 { // '"'
            pos = pos + 1;
            while pos < n && src[pos] != 34u8 {
                pos = pos + 1;
            }
            let nid = node_count;
            node_kinds[nid as usize] = 3; // String
            node_count = node_count + 1;
            if pos < n {
                pos = pos + 1; // skip closing quote
            }
        } else if is_digit(b) {
            let mut val: i64 = 0;
            while pos < n && is_digit(src[pos]) {
                val = val * 10 + ((src[pos] - 48u8) as i64);
                pos = pos + 1;
            }
            let nid = node_count;
            node_kinds[nid as usize] = 4; // Number
            node_ints[nid as usize] = val;
            node_count = node_count + 1;
        } else if b == 116u8 { // 't' -> true
            let nid = node_count;
            node_kinds[nid as usize] = 5; // Bool true
            node_ints[nid as usize] = 1;
            node_count = node_count + 1;
            pos = pos + 4;
        } else if b == 102u8 { // 'f' -> false
            let nid = node_count;
            node_kinds[nid as usize] = 5; // Bool false
            node_ints[nid as usize] = 0;
            node_count = node_count + 1;
            pos = pos + 5;
        } else {
            // ',' or ':' or other delimiter
            pos = pos + 1;
        }
    }

    assert(node_count == 18);

    // Node 4 is "version" value: number 1
    let version = node_ints[4];
    assert(version == 1);

    // Nodes 9, 10, 11 are the modules array values: 10, 20, 30
    let mod_sum = node_ints[9] + node_ints[10] + node_ints[11];
    assert(mod_sum == 60);

    // Node 15 is "opt" value: number 2
    let config_opt = node_ints[15];
    assert(config_opt == 2);

    print("nodes: 18, version: 1, modules_sum: 60, config_opt: 2\nOK json_parser\n");
}
