// test: run
// stdout: lines: 6, words: 25, bytes: 199, max_word_len: 13\nOK word_count\n

@intrinsic fn assert(c: bool) {}

fn is_whitespace(b: u8) -> bool {
    b == 32u8 || b == 10u8 || b == 13u8 || b == 9u8
}

fn main() {
    let text: [199]u8 = [
        65u8, 120u8, 105u8, 111u8, 109u8, 32u8, 99u8, 111u8, 109u8, 112u8, 105u8, 108u8, 101u8, 114u8, 32u8, 98u8, 111u8, 111u8, 116u8, 115u8, 116u8, 114u8, 97u8, 112u8, 10u8,
        80u8, 104u8, 97u8, 115u8, 101u8, 32u8, 110u8, 105u8, 110u8, 101u8, 32u8, 115u8, 116u8, 97u8, 110u8, 100u8, 97u8, 114u8, 100u8, 32u8, 108u8, 105u8, 98u8, 114u8, 97u8, 114u8, 121u8, 10u8,
        77u8, 101u8, 109u8, 111u8, 114u8, 121u8, 32u8, 115u8, 97u8, 102u8, 101u8, 116u8, 121u8, 32u8, 119u8, 105u8, 116u8, 104u8, 111u8, 117u8, 116u8, 32u8, 103u8, 97u8, 114u8, 98u8, 97u8, 103u8, 101u8, 10u8,
        68u8, 101u8, 116u8, 101u8, 114u8, 109u8, 105u8, 110u8, 105u8, 115u8, 116u8, 105u8, 99u8, 32u8, 101u8, 120u8, 101u8, 99u8, 117u8, 116u8, 105u8, 111u8, 110u8, 32u8, 112u8, 105u8, 112u8, 101u8, 108u8, 105u8, 110u8, 101u8, 10u8,
        80u8, 101u8, 114u8, 102u8, 111u8, 114u8, 109u8, 97u8, 110u8, 99u8, 101u8, 32u8, 101u8, 110u8, 103u8, 105u8, 110u8, 101u8, 101u8, 114u8, 105u8, 110u8, 103u8, 32u8, 98u8, 101u8, 110u8, 99u8, 104u8, 109u8, 97u8, 114u8, 107u8, 10u8,
        82u8, 101u8, 97u8, 108u8, 32u8, 115u8, 111u8, 102u8, 116u8, 119u8, 97u8, 114u8, 101u8, 32u8, 112u8, 114u8, 111u8, 103u8, 114u8, 97u8, 109u8, 115u8, 32u8, 116u8, 101u8, 115u8, 116u8, 32u8, 115u8, 117u8, 105u8, 116u8, 101u8, 32u8, 102u8, 111u8, 114u8, 32u8, 65u8, 120u8, 105u8, 111u8, 109u8, 32u8, 108u8, 97u8, 110u8, 103u8, 10u8
    ];

    let n: usize = 199;
    let mut lines: i64 = 0;
    let mut words: i64 = 0;
    let mut in_word: bool = false;
    let mut cur_word_len: i64 = 0;
    let mut max_len: i64 = 0;

    let mut i: usize = 0;
    while i < n {
        let b = text[i];
        if b == 10u8 {
            lines = lines + 1;
        }

        if is_whitespace(b) {
            if in_word {
                in_word = false;
                if cur_word_len > max_len {
                    max_len = cur_word_len;
                }
                cur_word_len = 0;
            }
        } else {
            if !in_word {
                in_word = true;
                words = words + 1;
            }
            cur_word_len = cur_word_len + 1;
        }
        i = i + 1;
    }

    if in_word {
        if cur_word_len > max_len {
            max_len = cur_word_len;
        }
    }

    assert(lines == 6);
    assert(words == 25);
    assert(max_len == 13);

    print("lines: 6, words: 25, bytes: 199, max_word_len: 13\nOK word_count\n");
}
