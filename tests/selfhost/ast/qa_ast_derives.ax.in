@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn test_bytes_eq(a: *const u8, b: *const u8, len: usize) -> bool {
    let mut i: usize = 0;
    while i < len {
        let ba: u8 = unsafe { *(a + i) };
        let bb: u8 = unsafe { *(b + i) };
        if ba != bb { return false; }
        i = i + 1;
    }
    true
}

const DR_DATA: [528]u8 = [82u8, 101u8, 99u8, 120u8, 105u8, 51u8, 50u8, 65u8, 108u8, 105u8, 97u8, 115u8, 84u8, 67u8, 83u8, 101u8, 120u8, 116u8, 67u8, 111u8, 112u8, 121u8, 67u8, 108u8, 111u8, 110u8, 101u8, 80u8, 97u8, 114u8, 116u8, 105u8, 97u8, 108u8, 69u8, 113u8, 69u8, 113u8, 72u8, 97u8, 115u8, 104u8, 79u8, 114u8, 100u8, 85u8, 110u8, 107u8, 110u8, 111u8, 119u8, 110u8, 10u8, 40u8, 73u8, 116u8, 101u8, 109u8, 83u8, 116u8, 114u8, 117u8, 99u8, 116u8, 10u8, 32u8, 32u8, 40u8, 86u8, 105u8, 115u8, 32u8, 112u8, 117u8, 98u8, 95u8, 112u8, 97u8, 99u8, 107u8, 97u8, 103u8, 101u8, 41u8, 32u8, 34u8, 82u8, 101u8, 99u8, 34u8, 32u8, 102u8, 97u8, 108u8, 115u8, 101u8, 10u8, 32u8, 32u8, 40u8, 70u8, 105u8, 101u8, 108u8, 100u8, 68u8, 101u8, 99u8, 108u8, 10u8, 32u8, 32u8, 32u8, 32u8, 40u8, 86u8, 105u8, 115u8, 32u8, 112u8, 114u8, 105u8, 118u8, 41u8, 32u8, 34u8, 120u8, 34u8, 10u8, 32u8, 32u8, 32u8, 32u8, 40u8, 84u8, 121u8, 112u8, 101u8, 80u8, 97u8, 116u8, 104u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 80u8, 97u8, 116u8, 104u8, 83u8, 101u8, 103u8, 109u8, 101u8, 110u8, 116u8, 32u8, 34u8, 105u8, 51u8, 50u8, 34u8, 41u8, 41u8, 41u8, 41u8, 10u8, 40u8, 73u8, 116u8, 101u8, 109u8, 84u8, 121u8, 112u8, 101u8, 65u8, 108u8, 105u8, 97u8, 115u8, 10u8, 32u8, 32u8, 40u8, 86u8, 105u8, 115u8, 32u8, 112u8, 114u8, 105u8, 118u8, 41u8, 32u8, 34u8, 65u8, 108u8, 105u8, 97u8, 115u8, 34u8, 10u8, 32u8, 32u8, 40u8, 71u8, 101u8, 110u8, 101u8, 114u8, 105u8, 99u8, 80u8, 97u8, 114u8, 97u8, 109u8, 32u8, 34u8, 84u8, 34u8, 41u8, 10u8, 32u8, 32u8, 40u8, 84u8, 121u8, 112u8, 101u8, 80u8, 97u8, 116u8, 104u8, 10u8, 32u8, 32u8, 32u8, 32u8, 40u8, 80u8, 97u8, 116u8, 104u8, 83u8, 101u8, 103u8, 109u8, 101u8, 110u8, 116u8, 32u8, 34u8, 84u8, 34u8, 41u8, 41u8, 41u8, 10u8, 40u8, 73u8, 116u8, 101u8, 109u8, 67u8, 111u8, 110u8, 115u8, 116u8, 10u8, 32u8, 32u8, 40u8, 86u8, 105u8, 115u8, 32u8, 112u8, 114u8, 105u8, 118u8, 41u8, 32u8, 34u8, 67u8, 34u8, 10u8, 32u8, 32u8, 40u8, 84u8, 121u8, 112u8, 101u8, 80u8, 97u8, 116u8, 104u8, 10u8, 32u8, 32u8, 32u8, 32u8, 40u8, 80u8, 97u8, 116u8, 104u8, 83u8, 101u8, 103u8, 109u8, 101u8, 110u8, 116u8, 32u8, 34u8, 105u8, 51u8, 50u8, 34u8, 41u8, 41u8, 10u8, 32u8, 32u8, 40u8, 69u8, 120u8, 112u8, 114u8, 76u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 41u8, 41u8, 10u8, 40u8, 73u8, 116u8, 101u8, 109u8, 83u8, 116u8, 97u8, 116u8, 105u8, 99u8, 10u8, 32u8, 32u8, 40u8, 86u8, 105u8, 115u8, 32u8, 112u8, 114u8, 105u8, 118u8, 41u8, 32u8, 116u8, 114u8, 117u8, 101u8, 32u8, 116u8, 114u8, 117u8, 101u8, 32u8, 34u8, 83u8, 34u8, 10u8, 32u8, 32u8, 40u8, 84u8, 121u8, 112u8, 101u8, 80u8, 97u8, 116u8, 104u8, 10u8, 32u8, 32u8, 32u8, 32u8, 40u8, 80u8, 97u8, 116u8, 104u8, 83u8, 101u8, 103u8, 109u8, 101u8, 110u8, 116u8, 32u8, 34u8, 105u8, 51u8, 50u8, 34u8, 41u8, 41u8, 10u8, 32u8, 32u8, 40u8, 69u8, 120u8, 112u8, 114u8, 76u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 41u8, 41u8, 10u8, 40u8, 73u8, 116u8, 101u8, 109u8, 69u8, 120u8, 116u8, 101u8, 114u8, 110u8, 66u8, 108u8, 111u8, 99u8, 107u8, 10u8, 32u8, 32u8, 40u8, 86u8, 105u8, 115u8, 32u8, 112u8, 114u8, 105u8, 118u8, 41u8, 32u8, 34u8, 67u8, 34u8, 10u8, 32u8, 32u8, 40u8, 73u8, 116u8, 101u8, 109u8, 70u8, 110u8, 10u8, 32u8, 32u8, 32u8, 32u8, 40u8, 86u8, 105u8, 115u8, 32u8, 112u8, 114u8, 105u8, 118u8, 41u8, 32u8, 102u8, 97u8, 108u8, 115u8, 101u8, 32u8, 102u8, 97u8, 108u8, 115u8, 101u8, 32u8, 102u8, 97u8, 108u8, 115u8, 101u8, 32u8, 34u8, 34u8, 32u8, 34u8, 101u8, 120u8, 116u8, 34u8, 41u8, 41u8, 10u8];
const DR_OFF: [17]u32 = [0u32, 3u32, 4u32, 7u32, 12u32, 13u32, 14u32, 15u32, 18u32, 22u32, 27u32, 36u32, 38u32, 42u32, 45u32, 52u32, 528u32];

fn get_dr_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = DR_OFF[idx] as usize;
    let end = DR_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = DR_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn intern_dr(a: mut_view<Arena>, interner: mut_view<StrInterner>, idx: usize) -> StrId {
    let sv = get_dr_sv(a, idx);
    interner_intern_bytes(interner, sv.ptr, sv.len)
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn sp1() -> Span {
    Span { file: FileId { v: 1u32 }, start: 0u32, end: 0u32 }
}

fn mk_path_type(pa: *mut Arena, sid: StrId) -> *mut AstType {
    let t = alloc_type(pa, TYPE_PATH, sp1());
    unsafe { (*t).segments = alloc_path_seg(pa, sp1(), sid); }
    t
}

fn mk_lit(pa: *mut Arena) -> *mut AstExpr {
    alloc_expr(pa, EXPR_LITERAL, sp1())
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut interner = interner_new();
    let mut pa_val = arena_new();
    let pa = unsafe { address_of_mut(pa_val) };

    let s_rec = intern_dr(mut_view(scratch), mut_view(interner), 0);
    let s_x = intern_dr(mut_view(scratch), mut_view(interner), 1);
    let s_i32 = intern_dr(mut_view(scratch), mut_view(interner), 2);
    let s_alias = intern_dr(mut_view(scratch), mut_view(interner), 3);
    let s_t = intern_dr(mut_view(scratch), mut_view(interner), 4);
    let s_c = intern_dr(mut_view(scratch), mut_view(interner), 5);
    let s_s = intern_dr(mut_view(scratch), mut_view(interner), 6);
    let s_ext = intern_dr(mut_view(scratch), mut_view(interner), 7);
    let s_copy = intern_dr(mut_view(scratch), mut_view(interner), 8);
    let s_clone = intern_dr(mut_view(scratch), mut_view(interner), 9);
    let s_peq = intern_dr(mut_view(scratch), mut_view(interner), 10);
    let s_eq = intern_dr(mut_view(scratch), mut_view(interner), 11);
    let s_hash = intern_dr(mut_view(scratch), mut_view(interner), 12);
    let s_ord = intern_dr(mut_view(scratch), mut_view(interner), 13);
    let s_unk = intern_dr(mut_view(scratch), mut_view(interner), 14);

    let mut items = 0 as *mut AstItem;

    let i_rec = alloc_item(pa, ITEM_STRUCT, sp1());
    let fd_x = alloc_field_decl(pa, sp1());
    unsafe {
        (*fd_x).name.v = s_x.v;
        (*fd_x).ty = mk_path_type(pa, StrId { v: s_i32.v });
        (*i_rec).vis.kind = VIS_PUB_PACKAGE;
        (*i_rec).name.v = s_rec.v;
        (*i_rec).struct_fields = fd_x;
    }
    items = link_item(items, i_rec);

    let i_ta = alloc_item(pa, ITEM_TYPE_ALIAS, sp1());
    let gps = alloc_generic_params(pa, sp1());
    let gp = alloc_generic_param(pa, sp1());
    unsafe {
        (*gp).name.v = s_t.v;
        (*gps).params = gp;
        (*i_ta).name.v = s_alias.v;
        (*i_ta).generic_params = gps;
        (*i_ta).ty = mk_path_type(pa, StrId { v: s_t.v });
    }
    items = link_item(items, i_ta);

    let i_const = alloc_item(pa, ITEM_CONST, sp1());
    unsafe {
        (*i_const).name.v = s_c.v;
        (*i_const).ty = mk_path_type(pa, StrId { v: s_i32.v });
        (*i_const).expr = mk_lit(pa);
    }
    items = link_item(items, i_const);

    let i_stat = alloc_item(pa, ITEM_STATIC, sp1());
    unsafe {
        (*i_stat).is_unsafe = true;
        (*i_stat).is_mut = true;
        (*i_stat).name.v = s_s.v;
        (*i_stat).ty = mk_path_type(pa, StrId { v: s_i32.v });
        (*i_stat).expr = mk_lit(pa);
    }
    items = link_item(items, i_stat);

    let i_ext = alloc_item(pa, ITEM_EXTERN_BLOCK, sp1());
    let m_ext = alloc_item(pa, ITEM_FN, sp1());
    unsafe {
        (*m_ext).name.v = s_ext.v;
        (*i_ext).abi.v = s_c.v;
        (*i_ext).members = m_ext;
    }
    items = link_item(items, i_ext);

    let ast = Ast { items: items };
    let mut out = diag_buf_new();
    ax_ast_render(view(ast), view(interner), FileId { v: 1u32 }, mut_view(out));
    let got_sv = diag_buf_as_str_view(view(out));
    let exp_sv = get_dr_sv(mut_view(scratch), 15);
    if !qa_sv_eq(got_sv, exp_sv) { return 1; }

    let mut d_buf = diag_buf_new();
    if !ast_format_derive(view(interner), i_rec as *const AstItem, s_copy, mut_view(d_buf)) { return 2; }
    if !ast_format_derive(view(interner), i_rec as *const AstItem, s_clone, mut_view(d_buf)) { return 3; }
    if !ast_format_derive(view(interner), i_rec as *const AstItem, s_peq, mut_view(d_buf)) { return 4; }
    if !ast_format_derive(view(interner), i_rec as *const AstItem, s_eq, mut_view(d_buf)) { return 5; }
    if !ast_format_derive(view(interner), i_rec as *const AstItem, s_hash, mut_view(d_buf)) { return 6; }
    if !ast_format_derive(view(interner), i_rec as *const AstItem, s_ord, mut_view(d_buf)) { return 7; }
    if ast_format_derive(view(interner), i_rec as *const AstItem, s_unk, mut_view(d_buf)) { return 8; }
    diag_buf_free(mut_view(d_buf));

    diag_buf_free(mut_view(out));
    arena_destroy(unsafe { mut_view(*pa) });
    interner_free(mut_view(interner));
    arena_destroy(mut_view(scratch));
    print("OK AST Derives\n");
    0
}
