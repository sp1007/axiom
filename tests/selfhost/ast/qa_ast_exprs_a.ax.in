 99u8, 116u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 80u8, 97u8, 116u8, 104u8, 83u8, 101u8, 103u8, 109u8, 101u8, 110u8, 116u8, 32u8, 34u8, 80u8, 116u8, 34u8, 41u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 70u8, 105u8, 101u8, 108u8, 100u8, 73u8, 110u8, 105u8, 116u8, 32u8, 34u8, 120u8, 34u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 69u8, 120u8, 112u8, 114u8, 76u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 41u8, 41u8, 41u8, 41u8, 10u8, 32u8, 32u8, 32u8, 32u8, 40u8, 83u8, 116u8, 109u8, 116u8, 69u8, 120u8, 112u8, 114u8, 32u8, 102u8, 97u8, 108u8, 115u8, 101u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 69u8, 120u8, 112u8, 114u8, 76u8, 111u8, 111u8, 112u8, 32u8, 34u8, 108u8, 112u8, 34u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 66u8, 108u8, 111u8, 99u8, 107u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 83u8, 116u8, 109u8, 116u8, 69u8, 120u8, 112u8, 114u8, 32u8, 116u8, 114u8, 117u8, 101u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 69u8, 120u8, 112u8, 114u8, 74u8, 117u8, 109u8, 112u8, 32u8, 49u8, 32u8, 34u8, 108u8, 112u8, 34u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 69u8, 120u8, 112u8, 114u8, 76u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 41u8, 41u8, 41u8, 41u8, 41u8, 41u8, 41u8, 41u8, 10u8];
const EA_OFF: [10]u32 = [0u32, 7u32, 8u32, 11u32, 12u32, 13u32, 14u32, 16u32, 18u32, 848u32];

fn get_ea_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = EA_OFF[idx] as usize;
    let end = EA_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = EA_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn intern_ea(a: mut_view<Arena>, interner: mut_view<StrInterner>, idx: usize) -> StrId {
    let sv = get_ea_sv(a, idx);
    interner_intern_bytes(interner, sv.ptr, sv.len)
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn sp1() -> Span {
    Span { file: FileId { v: 1u32 }, start: 0u32, end: 0u32 }
}

fn mk_lit(pa: *mut Arena) -> *mut AstExpr {
    alloc_expr(pa, EXPR_LITERAL, sp1())
}

fn mk_path_expr(pa: *mut Arena, sid: StrId) -> *mut AstExpr {
    let e = alloc_expr(pa, EXPR_PATH, sp1());
    unsafe { (*e).segments = alloc_path_seg(pa, sp1(), sid); }
    e
}

fn mk_path_type(pa: *mut Arena, sid: StrId) -> *mut AstType {
    let t = alloc_type(pa, TYPE_PATH, sp1());
    unsafe { (*t).segments = alloc_path_seg(pa, sp1(), sid); }
    t
}

fn mk_bind_pat(pa: *mut Arena, sid: StrId) -> *mut AstPat {
    let p = alloc_pat(pa, PAT_BINDING, sp1());
    unsafe { (*p).name.v = sid.v; }
    p
}

fn mk_let_stmt(pa: *mut Arena, sid: StrId, ty: *mut AstType, ex: *mut AstExpr, eb: *mut AstBlock) -> *mut AstStmt {
    let s = alloc_stmt(pa, STMT_LET, sp1());
    unsafe {
        (*s).pat = mk_bind_pat(pa, sid);
        (*s).ty = ty;
        (*s).expr = ex;
        (*s).else_block = eb;
    }
    s
}

fn mk_expr_stmt(pa: *mut Arena, ex: *mut AstExpr, semi: bool) -> *mut AstStmt {
    let s = alloc_stmt(pa, STMT_EXPR, sp1());
    unsafe {
        (*s).expr = ex;
        (*s).has_semi = semi;
    }
    s
}

fn mk_block1(pa: *mut Arena, s: *mut AstStmt) -> *mut AstBlock {
    let b = alloc_block(pa, sp1());
    unsafe { (*b).stmts = s; }
    b
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut interner = interner_new();
    let mut pa_val = arena_new();
    let pa = unsafe { address_of_mut(pa_val) };

    let s_fn = intern_ea(mut_view(scratch), mut_view(interner), 0);
    let s_x = intern_ea(mut_view(scratch), mut_view(interner), 1);
    let s_i32 = intern_ea(mut_view(scratch), mut_view(interner), 2);
    let s_t = intern_ea(mut_view(scratch), mut_view(interner), 3);
    let s_a = intern_ea(mut_view(scratch), mut_view(interner), 4);
    let s_s = intern_ea(mut_view(scratch), mut_view(interner), 5);
    let s_pt = intern_ea(mut_view(scratch), mut_view(interner), 6);
    let s_lp = intern_ea(mut_view(scratch), mut_view(interner), 7);

    let mut stmts = 0 as *mut AstStmt;

    let e_ret = alloc_expr(pa, EXPR_JUMP, sp1());
    unsafe { (*e_ret).jump_kind = JUMP_RETURN; }
    let b_else = mk_block1(pa, mk_expr_stmt(pa, e_ret, true));
    stmts = link_stmt(stmts, mk_let_stmt(pa, StrId { v: s_x.v }, mk_path_type(pa, StrId { v: s_i32.v }), mk_lit(pa), b_else));

    let st_assign = alloc_stmt(pa, STMT_ASSIGN, sp1());
    unsafe {
        (*st_assign).op = 1u8;
        (*st_assign).left = mk_path_expr(pa, StrId { v: s_x.v });
        (*st_assign).right = mk_lit(pa);
    }
    stmts = link_stmt(stmts, st_assign);

    let e_paren = alloc_expr(pa, EXPR_PAREN, sp1());
    unsafe { (*e_paren).inner = mk_lit(pa); }
    let e_tup = alloc_expr(pa, EXPR_TUPLE, sp1());
    unsafe { (*e_tup).elems = link_expr(mk_lit(pa), e_paren); }
    stmts = link_stmt(stmts, mk_let_stmt(pa, StrId { v: s_t.v }, 0 as *mut AstType, e_tup, 0 as *mut AstBlock));

    let e_arr = alloc_expr(pa, EXPR_ARRAY, sp1());
    unsafe {
        (*e_arr).elems = mk_lit(pa);
        (*e_arr).count_expr = mk_lit(pa);
    }
    stmts = link_stmt(stmts, mk_let_stmt(pa, StrId { v: s_a.v }, 0 as *mut AstType, e_arr, 0 as *mut AstBlock));

    let e_st = alloc_expr(pa, EXPR_STRUCT, sp1());
    let fi = alloc_field_init(pa, sp1());
    unsafe {
        (*fi).name.v = s_x.v;
        (*fi).expr = mk_lit(pa);
        (*e_st).segments = alloc_path_seg(pa, sp1(), StrId { v: s_pt.v });
        (*e_st).fields = fi;
    }
    stmts = link_stmt(stmts, mk_let_stmt(pa, StrId { v: s_s.v }, 0 as *mut AstType, e_st, 0 as *mut AstBlock));

    let e_brk = alloc_expr(pa, EXPR_JUMP, sp1());
    unsafe {
        (*e_brk).jump_kind = JUMP_BREAK;
        (*e_brk).label.v = s_lp.v;
        (*e_brk).inner = mk_lit(pa);
    }
    let e_loop = alloc_expr(pa, EXPR_LOOP, sp1());
    unsafe {
        (*e_loop).label.v = s_lp.v;
        (*e_loop).block = mk_block1(pa, mk_expr_stmt(pa, e_brk, true));
    }
    stmts = link_stmt(stmts, mk_expr_stmt(pa, e_loop, false));

    let item_fn = alloc_item(pa, ITEM_FN, sp1());
    unsafe {
        (*item_fn).name.v = s_fn.v;
        (*item_fn).body = mk_block1(pa, stmts);
    }

    let ast = Ast { items: item_fn };
    let mut out = diag_buf_new();
    ax_ast_render(view(ast), view(interner), FileId { v: 1u32 }, mut_view(out));
    let got_sv = diag_buf_as_str_view(view(out));
    let exp_sv = get_ea_sv(mut_view(scratch), 8);
    if !qa_sv_eq(got_sv, exp_sv) { return 1; }

    diag_buf_free(mut_view(out));
    arena_destroy(unsafe { mut_view(*pa) });
    interner_free(mut_view(interner));
    arena_destroy(mut_view(scratch));
    print("OK AST Exprs A\n");
    0
}
