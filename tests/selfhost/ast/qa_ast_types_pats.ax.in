u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 69u8, 120u8, 112u8, 114u8, 76u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 41u8, 41u8, 41u8, 41u8, 41u8, 41u8, 10u8];
const TP_OFF: [16]u32 = [0u32, 5u32, 8u32, 10u32, 14u32, 15u32, 20u32, 26u32, 39u32, 40u32, 41u32, 42u32, 46u32, 53u32, 59u32, 1604u32];

fn get_tp_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = TP_OFF[idx] as usize;
    let end = TP_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = TP_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn intern_tp(a: mut_view<Arena>, interner: mut_view<StrInterner>, idx: usize) -> StrId {
    let sv = get_tp_sv(a, idx);
    interner_intern_bytes(interner, sv.ptr, sv.len)
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn sp1() -> Span {
    Span { file: FileId { v: 1u32 }, start: 0u32, end: 0u32 }
}

fn mk_type_path1(pa: *mut Arena, sid: StrId) -> *mut AstType {
    let t = alloc_type(pa, TYPE_PATH, sp1());
    let seg = alloc_path_seg(pa, sp1(), sid);
    unsafe { (*t).segments = seg; }
    t
}

fn mk_lit_expr(pa: *mut Arena) -> *mut AstExpr {
    alloc_expr(pa, EXPR_LITERAL, sp1())
}

fn mk_lit_pat(pa: *mut Arena, is_neg: bool) -> *mut AstPat {
    let p = alloc_pat(pa, PAT_LITERAL, sp1());
    unsafe { (*p).is_negated = is_neg; }
    p
}

fn mk_arm(pa: *mut Arena, pat: *mut AstPat) -> *mut AstMatchArm {
    let arm = alloc_match_arm(pa, sp1());
    unsafe {
        (*arm).pat = pat;
        (*arm).body = mk_lit_expr(pa);
    }
    arm
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut interner = interner_new();
    let mut pa_val = arena_new();
    let pa = unsafe { address_of_mut(pa_val) };

    let s_types = intern_tp(mut_view(scratch), mut_view(interner), 0);
    let s_i32 = intern_tp(mut_view(scratch), mut_view(interner), 1);
    let s_u8 = intern_tp(mut_view(scratch), mut_view(interner), 2);
    let s_bool = intern_tp(mut_view(scratch), mut_view(interner), 3);
    let s_c = intern_tp(mut_view(scratch), mut_view(interner), 4);
    let s_trait = intern_tp(mut_view(scratch), mut_view(interner), 5);
    let s_option = intern_tp(mut_view(scratch), mut_view(interner), 6);
    let s_fn = intern_tp(mut_view(scratch), mut_view(interner), 7);
    let s_x = intern_tp(mut_view(scratch), mut_view(interner), 8);
    let s_a = intern_tp(mut_view(scratch), mut_view(interner), 9);
    let s_b = intern_tp(mut_view(scratch), mut_view(interner), 10);
    let s_enum = intern_tp(mut_view(scratch), mut_view(interner), 11);
    let s_variant = intern_tp(mut_view(scratch), mut_view(interner), 12);
    let s_struct = intern_tp(mut_view(scratch), mut_view(interner), 13);

    let item_const = alloc_item(pa, ITEM_CONST, sp1());
    let tup_ty = alloc_type(pa, TYPE_TUPLE, sp1());
    let mut elems = 0 as *mut AstType;

    let t_arr = alloc_type(pa, TYPE_ARRAY, sp1());
    unsafe {
        (*t_arr).count_expr = mk_lit_expr(pa);
        (*t_arr).elem = mk_type_path1(pa, StrId { v: s_i32.v });
    }
    elems = link_type(elems, t_arr);

    let t_slice = alloc_type(pa, TYPE_SLICE, sp1());
    unsafe { (*t_slice).elem = mk_type_path1(pa, StrId { v: s_i32.v }); }
    elems = link_type(elems, t_slice);

    let t_view = alloc_type(pa, TYPE_VIEW, sp1());
    unsafe {
        (*t_view).is_mut = false;
        (*t_view).elem = mk_type_path1(pa, StrId { v: s_u8.v });
    }
    elems = link_type(elems, t_view);

    let t_mptr = alloc_type(pa, TYPE_PTR, sp1());
    unsafe {
        (*t_mptr).is_mut = true;
        (*t_mptr).elem = mk_type_path1(pa, StrId { v: s_i32.v });
    }
    elems = link_type(elems, t_mptr);

    let t_fn = alloc_type(pa, TYPE_FN, sp1());
    unsafe {
        (*t_fn).is_unsafe = true;
        (*t_fn).abi.v = s_c.v;
        (*t_fn).param_types = mk_type_path1(pa, StrId { v: s_i32.v });
        (*t_fn).ret_type = mk_type_path1(pa, StrId { v: s_bool.v });
    }
    elems = link_type(elems, t_fn);

    let t_dyn = alloc_type(pa, TYPE_DYN, sp1());
    unsafe { (*t_dyn).bounds = mk_type_path1(pa, StrId { v: s_trait.v }); }
    elems = link_type(elems, t_dyn);

    let t_opt = alloc_type(pa, TYPE_PATH, sp1());
    let seg_opt = alloc_path_seg(pa, sp1(), StrId { v: s_option.v });
    let ga = alloc_generic_args(pa, sp1());
    let garg = alloc_generic_arg(pa, sp1());
    unsafe {
        (*garg).ty = mk_type_path1(pa, StrId { v: s_i32.v });
        (*ga).args = garg;
        (*seg_opt).generic_args = ga;
        (*t_opt).segments = seg_opt;
    }
    elems = link_type(elems, t_opt);

    unsafe {
        (*tup_ty).elem_types = elems;
        (*item_const).name.v = s_types.v;
        (*item_const).ty = tup_ty;
        (*item_const).expr = mk_lit_expr(pa);
    }

    let item_fn = alloc_item(pa, ITEM_FN, sp1());
    let blk = alloc_block(pa, sp1());
    let stmt_m = alloc_stmt(pa, STMT_EXPR, sp1());
    let expr_m = alloc_expr(pa, EXPR_MATCH, sp1());
    let mut arms = 0 as *mut AstMatchArm;

    arms = link_match_arm(arms, mk_arm(pa, alloc_pat(pa, PAT_WILDCARD, sp1())));

    let p_or = alloc_pat(pa, PAT_OR, sp1());
    unsafe { (*p_or).pats = link_pat(mk_lit_pat(pa, false), mk_lit_pat(pa, true)); }
    arms = link_match_arm(arms, mk_arm(pa, p_or));

    let p_rng = alloc_pat(pa, PAT_RANGE, sp1());
    unsafe {
        (*p_rng).is_inclusive = true;
        (*p_rng).start_pat = mk_lit_pat(pa, false);
        (*p_rng).end_pat = mk_lit_pat(pa, false);
    }
    arms = link_match_arm(arms, mk_arm(pa, p_rng));

    let p_bind = alloc_pat(pa, PAT_BINDING, sp1());
    unsafe {
        (*p_bind).is_mut = true;
        (*p_bind).name.v = s_x.v;
    }
    arms = link_match_arm(arms, mk_arm(pa, p_bind));

    let p_path = alloc_pat(pa, PAT_PATH, sp1());
    let p_arg_tup = alloc_pat(pa, PAT_TUPLE, sp1());
    let p_bb = alloc_pat(pa, PAT_BINDING, sp1());
    let p_ba = alloc_pat(pa, PAT_BINDING, sp1());
    let p_tup = alloc_pat(pa, PAT_TUPLE, sp1());
    unsafe {
        (*p_ba).name.v = s_a.v;
        (*p_bb).name.v = s_b.v;
        (*p_arg_tup).elems = p_bb;
        (*p_path).segments = link_path_seg(alloc_path_seg(pa, sp1(), StrId { v: s_enum.v }), alloc_path_seg(pa, sp1(), StrId { v: s_variant.v }));
        (*p_path).payload = p_arg_tup;
        (*p_tup).elems = link_pat(p_ba, p_path);
    }
    arms = link_match_arm(arms, mk_arm(pa, p_tup));

    let p_st = alloc_pat(pa, PAT_STRUCT, sp1());
    let pf1 = alloc_pat_field(pa, sp1());
    unsafe {
        (*pf1).name.v = s_x.v;
        (*p_st).segments = alloc_path_seg(pa, sp1(), StrId { v: s_struct.v });
        (*p_st).fields = pf1;
        (*p_st).has_rest = true;
    }
    arms = link_match_arm(arms, mk_arm(pa, p_st));

    unsafe {
        (*expr_m).cond = mk_lit_expr(pa);
        (*expr_m).arms = arms;
        (*stmt_m).expr = expr_m;
        (*blk).stmts = stmt_m;
        (*item_fn).name.v = s_fn.v;
        (*item_fn).body = blk;
    }

    let items = link_item(item_const, item_fn);
    let ast = Ast { items: items };

    let mut out = diag_buf_new();
    ax_ast_render(view(ast), view(interner), FileId { v: 1u32 }, mut_view(out));
    let got_sv = diag_buf_as_str_view(view(out));
    let exp_sv = get_tp_sv(mut_view(scratch), 14);
    if !qa_sv_eq(got_sv, exp_sv) { return 1; }

    let mut stats = AstStats { item_count: 0, stmt_count: 0, expr_count: 0, type_count: 0, pat_count: 0 };
    ast_walk_items(items as *const AstItem, mut_view(stats));
    if stats.item_count != 2 || stats.stmt_count != 1 { return 2; }

    diag_buf_free(mut_view(out));
    arena_destroy(unsafe { mut_view(*pa) });
    interner_free(mut_view(interner));
    arena_destroy(mut_view(scratch));
    print("OK AST Types Pats\n");
    0
}
