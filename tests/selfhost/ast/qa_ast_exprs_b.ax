const EB_OFF: [12]u32 = [0u32, 7u32, 9u32, 10u32, 11u32, 12u32, 13u32, 16u32, 18u32, 21u32, 22u32, 1865u32];

fn get_eb_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = EB_OFF[idx] as usize;
    let end = EB_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = EB_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn intern_eb(a: mut_view<Arena>, interner: mut_view<StrInterner>, idx: usize) -> StrId {
    let sv = get_eb_sv(a, idx);
    interner_intern_bytes(interner, sv.ptr, sv.len)
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn sp1() -> Span {
    Span { file: FileId { v: 1u32 }, start: 0u32, end: 0u32 }
}

fn mk_lit(pa: *mut Arena) -> *mut AstExpr {
    alloc_expr(pa, EXPR_LITERAL, sp1())
}

fn mk_path_expr(pa: *mut Arena, sid: StrId) -> *mut AstExpr {
    let e = alloc_expr(pa, EXPR_PATH, sp1());
    unsafe { (*e).segments = alloc_path_seg(pa, sp1(), sid); }
    e
}

fn mk_path_type(pa: *mut Arena, sid: StrId) -> *mut AstType {
    let t = alloc_type(pa, TYPE_PATH, sp1());
    unsafe { (*t).segments = alloc_path_seg(pa, sp1(), sid); }
    t
}

fn mk_bind_pat(pa: *mut Arena, sid: StrId) -> *mut AstPat {
    let p = alloc_pat(pa, PAT_BINDING, sp1());
    unsafe { (*p).name.v = sid.v; }
    p
}

fn mk_let_stmt(pa: *mut Arena, sid: StrId, ex: *mut AstExpr) -> *mut AstStmt {
    let s = alloc_stmt(pa, STMT_LET, sp1());
    unsafe {
        (*s).pat = mk_bind_pat(pa, sid);
        (*s).expr = ex;
    }
    s
}

fn mk_expr_stmt(pa: *mut Arena, ex: *mut AstExpr, semi: bool) -> *mut AstStmt {
    let s = alloc_stmt(pa, STMT_EXPR, sp1());
    unsafe {
        (*s).expr = ex;
        (*s).has_semi = semi;
    }
    s
}

fn mk_block1(pa: *mut Arena, s: *mut AstStmt) -> *mut AstBlock {
    let b = alloc_block(pa, sp1());
    unsafe { (*b).stmts = s; }
    b
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut interner = interner_new();
    let mut pa_val = arena_new();
    let pa = unsafe { address_of_mut(pa_val) };

    let s_fn = intern_eb(mut_view(scratch), mut_view(interner), 0);
    let s_wh = intern_eb(mut_view(scratch), mut_view(interner), 1);
    let s_i = intern_eb(mut_view(scratch), mut_view(interner), 2);
    let s_x = intern_eb(mut_view(scratch), mut_view(interner), 3);
    let s_c = intern_eb(mut_view(scratch), mut_view(interner), 4);
    let s_p = intern_eb(mut_view(scratch), mut_view(interner), 5);
    let s_i32 = intern_eb(mut_view(scratch), mut_view(interner), 6);
    let s_pf = intern_eb(mut_view(scratch), mut_view(interner), 7);
    let s_obj = intern_eb(mut_view(scratch), mut_view(interner), 8);
    let s_f = intern_eb(mut_view(scratch), mut_view(interner), 9);

    let mut stmts = 0 as *mut AstStmt;

    let e_cont = alloc_expr(pa, EXPR_JUMP, sp1());
    unsafe {
        (*e_cont).jump_kind = JUMP_CONTINUE;
        (*e_cont).label.v = s_wh.v;
    }
    let e_rng = alloc_expr(pa, EXPR_RANGE, sp1());
    unsafe {
        (*e_rng).is_inclusive = false;
        (*e_rng).start_expr = mk_lit(pa);
        (*e_rng).end_expr = mk_lit(pa);
    }
    let e_for = alloc_expr(pa, EXPR_FOR, sp1());
    unsafe {
        (*e_for).pat = mk_bind_pat(pa, StrId { v: s_i.v });
        (*e_for).iter = e_rng;
        (*e_for).block = mk_block1(pa, mk_expr_stmt(pa, e_cont, true));
    }
    let e_while = alloc_expr(pa, EXPR_WHILE, sp1());
    unsafe {
        (*e_while).label.v = s_wh.v;
        (*e_while).cond = mk_lit(pa);
        (*e_while).block = mk_block1(pa, mk_expr_stmt(pa, e_for, false));
    }
    stmts = link_stmt(stmts, mk_expr_stmt(pa, e_while, false));

    let e_ct = alloc_expr(pa, EXPR_COMPTIME, sp1());
    unsafe { (*e_ct).block = mk_block1(pa, mk_expr_stmt(pa, mk_lit(pa), false)); }
    let e_mv = alloc_expr(pa, EXPR_VIEW, sp1());
    unsafe {
        (*e_mv).is_mut = true;
        (*e_mv).inner = mk_path_expr(pa, StrId { v: s_x.v });
    }
    let e_uns = alloc_expr(pa, EXPR_UNSAFE, sp1());
    unsafe { (*e_uns).block = mk_block1(pa, mk_expr_stmt(pa, e_mv, false)); }
    let e_eblk = alloc_expr(pa, EXPR_BLOCK, sp1());
    unsafe { (*e_eblk).block = mk_block1(pa, mk_expr_stmt(pa, e_uns, false)); }
    let e_if = alloc_expr(pa, EXPR_IF, sp1());
    unsafe {
        (*e_if).cond = mk_lit(pa);
        (*e_if).block = mk_block1(pa, mk_expr_stmt(pa, e_ct, false));
        (*e_if).else_branch = e_eblk;
    }
    stmts = link_stmt(stmts, mk_expr_stmt(pa, e_if, true));

    let e_neg = alloc_expr(pa, EXPR_UNARY, sp1());
    unsafe {
        (*e_neg).op = UNOP_NEG;
        (*e_neg).inner = mk_path_expr(pa, StrId { v: s_p.v });
    }
    let e_cast = alloc_expr(pa, EXPR_CAST, sp1());
    unsafe {
        (*e_cast).inner = e_neg;
        (*e_cast).cast_ty = mk_path_type(pa, StrId { v: s_i32.v });
    }
    let e_cblk = alloc_expr(pa, EXPR_BLOCK, sp1());
    unsafe { (*e_cblk).block = mk_block1(pa, mk_expr_stmt(pa, e_cast, false)); }
    let prm = alloc_param(pa, sp1());
    unsafe {
        (*prm).name.v = s_p.v;
        (*prm).ty = mk_path_type(pa, StrId { v: s_i32.v });
    }
    let e_clos = alloc_expr(pa, EXPR_CLOSURE, sp1());
    unsafe {
        (*e_clos).params = prm;
        (*e_clos).ret_type = mk_path_type(pa, StrId { v: s_i32.v });
        (*e_clos).body = e_cblk;
    }
    stmts = link_stmt(stmts, mk_let_stmt(pa, StrId { v: s_c.v }, e_clos));

    let pf1 = alloc_expr(pa, EXPR_POSTFIX, sp1());
    let seg1 = alloc_postfix_seg(pa, POSTFIX_FIELD, sp1());
    let ga = alloc_generic_args(pa, sp1());
    let garg = alloc_generic_arg(pa, sp1());
    unsafe {
        (*garg).ty = mk_path_type(pa, StrId { v: s_i32.v });
        (*ga).args = garg;
        (*seg1).name.v = s_f.v;
        (*seg1).generic_args = ga;
        (*pf1).head = mk_path_expr(pa, StrId { v: s_obj.v });
        (*pf1).postfix_segs = seg1;
    }
    let pf2 = alloc_expr(pa, EXPR_POSTFIX, sp1());
    let seg2 = alloc_postfix_seg(pa, POSTFIX_CALL, sp1());
    unsafe {
        (*pf2).head = pf1;
        (*pf2).postfix_segs = seg2;
    }
    let pf3 = alloc_expr(pa, EXPR_POSTFIX, sp1());
    let seg3 = alloc_postfix_seg(pa, POSTFIX_TUPLE_INDEX, sp1());
    unsafe {
        (*seg3).tuple_index = 0u32;
        (*pf3).head = pf2;
        (*pf3).postfix_segs = seg3;
    }
    let pf4 = alloc_expr(pa, EXPR_POSTFIX, sp1());
    let seg4 = alloc_postfix_seg(pa, POSTFIX_INDEX, sp1());
    unsafe {
        (*seg4).index_arg = mk_lit(pa);
        (*pf4).head = pf3;
        (*pf4).postfix_segs = seg4;
    }
    let pf5 = alloc_expr(pa, EXPR_POSTFIX, sp1());
    let seg5 = alloc_postfix_seg(pa, POSTFIX_TRY, sp1());
    unsafe {
        (*pf5).head = pf4;
        (*pf5).postfix_segs = seg5;
    }
    stmts = link_stmt(stmts, mk_let_stmt(pa, StrId { v: s_pf.v }, pf5));

    let item_fn = alloc_item(pa, ITEM_FN, sp1());
    unsafe {
        (*item_fn).name.v = s_fn.v;
        (*item_fn).body = mk_block1(pa, stmts);
    }

    let ast = Ast { items: item_fn };
    let mut out = diag_buf_new();
    ax_ast_render(view(ast), view(interner), FileId { v: 1u32 }, mut_view(out));
    let got_sv = diag_buf_as_str_view(view(out));
    let exp_sv = get_eb_sv(mut_view(scratch), 10);
    if !qa_sv_eq(got_sv, exp_sv) { return 1; }

    diag_buf_free(mut_view(out));
    arena_destroy(unsafe { mut_view(*pa) });
    interner_free(mut_view(interner));
    arena_destroy(mut_view(scratch));
    print("OK AST Exprs B\n");
    0
}
