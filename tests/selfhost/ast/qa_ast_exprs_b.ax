pub fn diag_buf_push_tok_name(b: mut_view<DiagBuffer>, kind: u8) {
    let idx = kind as usize;
    if idx >= 97 {
        diag_buf_push_byte(b, 63u8);
        return;
    }
    let start = TOK_NAMES_OFF[idx] as usize;
    let end = TOK_NAMES_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), TOK_NAMES_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_suf_name(b: mut_view<DiagBuffer>, suf: u8) {
    let idx = suf as usize;
    if idx >= 13 {
        diag_buf_push_byte(b, 63u8);
        return;
    }
    let start = SUF_NAMES_OFF[idx] as usize;
    let end = SUF_NAMES_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), SUF_NAMES_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_lex_msg(b: mut_view<DiagBuffer>, msg_idx: usize) {
    let start = LEX_MSG_OFF[msg_idx] as usize;
    let end = LEX_MSG_OFF[msg_idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), LEX_MSG_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_u64(b: mut_view<DiagBuffer>, val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(b, 48u8);
        return;
    }
    let mut digits: [20]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut count: usize = 0;
    let mut v = val;
    while v > 0u64 {
        let q = (v >> 1u32) / 5u64;
        let rem = (v - q * 10u64) as u8;
        digits[count] = 48u8 + rem;
        v = q;
        count = count + 1;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        diag_buf_push_byte(mut_view(*b), digits[i]);
    }
}

fn hex_nibble(v: u8) -> u8 {
    if v < 10u8 { 48u8 + v } else { 97u8 + (v - 10u8) }
}

pub unsafe fn lex_token_ptr(tokens: *mut Token, idx: usize) -> *mut Token {
    ((tokens as usize) + (((idx as isize) * (size_of<Token>() as isize)) as usize)) as *mut Token
}

pub unsafe fn lex_comment_ptr(comments: *mut Comment, idx: usize) -> *mut Comment {
    ((comments as usize) + (((idx as isize) * (size_of<Comment>() as isize)) as usize)) as *mut Comment
}

pub fn ax_lex_render_tokens(res: view<LexResult>, interner: view<StrInterner>, out: mut_view<DiagBuffer>) {
    let mut i: usize = 0;
    while i < res.token_count {
        let tok = unsafe { *(lex_token_ptr(res.tokens, i)) };
        diag_buf_push_tok_name(mut_view(*out), tok.kind);
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 91u8);
        diag_buf_push_u32(mut_view(*out), tok.span.start);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_u32(mut_view(*out), tok.span.end);
        diag_buf_push_byte(mut_view(*out), 93u8);
        if (tok.flags & TOK_FLAG_NL_BEFORE) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 27); }
        if (tok.flags & TOK_FLAG_ERROR) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 28); }
        if (tok.flags & TOK_FLAG_RAW) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 29); }
        if (tok.flags & TOK_FLAG_BYTE_FORM) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 30); }
        if tok.kind == TOK_INT {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_u64(mut_view(*out), tok.int_val);
            if tok.suffix != SUFFIX_NONE {
                diag_buf_push_byte(mut_view(*out), 32u8);
                diag_buf_push_suf_name(mut_view(*out), tok.suffix);
            }
        } else if tok.kind == TOK_FLOAT {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_suf_name(mut_view(*out), tok.suffix);
        } else if tok.kind == TOK_IDENT || tok.kind == TOK_LABEL {
            let name = interner_get(interner, tok.ident_val);
            diag_buf_push_byte(mut_view(*out), 32u8);
            let mut k: usize = 0;
            while k < name.len {
                let b_ch = unsafe { *(name.ptr + k) };
                diag_buf_push_byte(mut_view(*out), b_ch);
                k = k + 1;
            }
        } else if tok.kind == TOK_CHAR {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_u32(mut_view(*out), tok.char_val);
        } else if tok.kind == TOK_STR || tok.kind == TOK_BYTE_STR {
            diag_buf_push_byte(mut_view(*out), 32u8);
            let mut k: usize = 0;
            while k < tok.str_len {
                let b_ch = unsafe { *(tok.str_ptr + k) };
                diag_buf_push_byte(mut_view(*out), hex_nibble(b_ch / 16u8));
                diag_buf_push_byte(mut_view(*out), hex_nibble(b_ch % 16u8));
                k = k + 1;
            }
        }
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < res.comment_count {
        let c = unsafe { *(lex_comment_ptr(res.comments, j)) };
        let msg_idx: usize = if c.kind == COMMENT_DOC { 25 } else if c.kind == COMMENT_BLOCK { 26 } else { 24 };
        diag_buf_push_lex_msg(mut_view(*out), msg_idx);
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 91u8);
        diag_buf_push_u32(mut_view(*out), c.span.start);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_u32(mut_view(*out), c.span.end);
        diag_buf_push_byte(mut_view(*out), 93u8);
        diag_buf_push_byte(mut_view(*out), 10u8);
        j = j + 1;
    }
}

