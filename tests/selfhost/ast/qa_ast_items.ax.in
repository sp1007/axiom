const IT_OFF: [25]u32 = [0u32, 3u32, 6u32, 7u32, 8u32, 10u32, 14u32, 15u32, 20u32, 24u32, 25u32, 30u32, 34u32, 37u32, 41u32, 46u32, 47u32, 50u32, 54u32, 56u32, 61u32, 64u32, 68u32, 72u32, 1331u32];

fn get_it_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = IT_OFF[idx] as usize;
    let end = IT_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = IT_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn intern_it(a: mut_view<Arena>, interner: mut_view<StrInterner>, idx: usize) -> StrId {
    let sv = get_it_sv(a, idx);
    interner_intern_bytes(interner, sv.ptr, sv.len)
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn sp1() -> Span {
    Span { file: FileId { v: 1u32 }, start: 0u32, end: 0u32 }
}

fn mk_path_type(pa: *mut Arena, sid: StrId) -> *mut AstType {
    let t = alloc_type(pa, TYPE_PATH, sp1());
    unsafe { (*t).segments = alloc_path_seg(pa, sp1(), sid); }
    t
}

fn mk_path_expr(pa: *mut Arena, sid: StrId) -> *mut AstExpr {
    let e = alloc_expr(pa, EXPR_PATH, sp1());
    unsafe { (*e).segments = alloc_path_seg(pa, sp1(), sid); }
    e
}

fn mk_lit(pa: *mut Arena) -> *mut AstExpr {
    alloc_expr(pa, EXPR_LITERAL, sp1())
}

fn mk_gparams1(pa: *mut Arena, sid: StrId, bound_ty: *mut AstType) -> *mut AstGenericParams {
    let gps = alloc_generic_params(pa, sp1());
    let gp = alloc_generic_param(pa, sp1());
    unsafe {
        (*gp).name.v = sid.v;
        (*gp).bounds = bound_ty;
        (*gps).params = gp;
    }
    gps
}

fn mk_dotted2(pa: *mut Arena, dst: mut_view<AstDottedName>, s1: StrId, s2: StrId) {
    let segs = ast_alloc_zeroed(pa, 2 * size_of<StrId>(), align_of<StrId>()) as *mut StrId;
    unsafe {
        (*str_id_ptr(segs, 0)).v = s1.v;
        (*str_id_ptr(segs, 1)).v = s2.v;
    }
    ast_set_span(mut_view(dst.span), sp1());
    dst.segments = segs;
    dst.count = 2;
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut interner = interner_new();
    let mut pa_val = arena_new();
    let pa = unsafe { address_of_mut(pa_val) };

    let s_pkg = intern_it(mut_view(scratch), mut_view(interner), 0);
    let s_sub = intern_it(mut_view(scratch), mut_view(interner), 1);
    let s_a = intern_it(mut_view(scratch), mut_view(interner), 2);
    let s_b = intern_it(mut_view(scratch), mut_view(interner), 3);
    let s_ab = intern_it(mut_view(scratch), mut_view(interner), 4);
    let s_repr = intern_it(mut_view(scratch), mut_view(interner), 5);
    let s_c = intern_it(mut_view(scratch), mut_view(interner), 6);
    let s_align = intern_it(mut_view(scratch), mut_view(interner), 7);
    let s_pair = intern_it(mut_view(scratch), mut_view(interner), 8);
    let s_t = intern_it(mut_view(scratch), mut_view(interner), 9);
    let s_clone = intern_it(mut_view(scratch), mut_view(interner), 10);
    let s_copy = intern_it(mut_view(scratch), mut_view(interner), 11);
    let s_opt = intern_it(mut_view(scratch), mut_view(interner), 12);
    let s_some = intern_it(mut_view(scratch), mut_view(interner), 13);
    let s_named = intern_it(mut_view(scratch), mut_view(interner), 14);
    let s_v = intern_it(mut_view(scratch), mut_view(interner), 15);
    let s_i32 = intern_it(mut_view(scratch), mut_view(interner), 16);
    let s_none = intern_it(mut_view(scratch), mut_view(interner), 17);
    let s_tr = intern_it(mut_view(scratch), mut_view(interner), 18);
    let s_super = intern_it(mut_view(scratch), mut_view(interner), 19);
    let s_req = intern_it(mut_view(scratch), mut_view(interner), 20);
    let s_self = intern_it(mut_view(scratch), mut_view(interner), 21);
    let s_selft = intern_it(mut_view(scratch), mut_view(interner), 22);

    let mut items = 0 as *mut AstItem;

    let i_mod = alloc_item(pa, ITEM_MODULE, sp1());
    unsafe { mk_dotted2(pa, mut_view((*i_mod).mod_path), StrId { v: s_pkg.v }, StrId { v: s_sub.v }); }
    items = link_item(items, i_mod);

    let i_use = alloc_item(pa, ITEM_USE, sp1());
    let ut = alloc_use_tree(pa, sp1());
    unsafe {
        mk_dotted2(pa, mut_view((*ut).path), StrId { v: s_a.v }, StrId { v: s_b.v });
        (*ut).alias.v = s_ab.v;
        (*i_use).use_tree = ut;
    }
    items = link_item(items, i_use);

    let i_pair = alloc_item(pa, ITEM_STRUCT, sp1());
    let attr = alloc_attr(pa, sp1());
    let aa1 = alloc_attr_arg(pa, sp1());
    let aa2 = alloc_attr_arg(pa, sp1());
    let wc = alloc_where_clause(pa, sp1());
    let wp = alloc_where_pred(pa, sp1());
    let fd_a = alloc_field_decl(pa, sp1());
    unsafe {
        (*aa1).expr = mk_path_expr(pa, StrId { v: s_c.v });
        (*aa2).name.v = s_align.v;
        (*aa2).expr = mk_lit(pa);
        (*attr).name.v = s_repr.v;
        (*attr).args = link_attr_arg(aa1, aa2);
        (*wp).ty = mk_path_type(pa, StrId { v: s_t.v });
        (*wp).bounds = mk_path_type(pa, StrId { v: s_copy.v });
        (*wc).preds = wp;
        (*fd_a).vis.kind = VIS_PUB;
        (*fd_a).name.v = s_a.v;
        (*fd_a).ty = mk_path_type(pa, StrId { v: s_t.v });
        (*i_pair).attrs = attr;
        (*i_pair).vis.kind = VIS_PUB;
        (*i_pair).name.v = s_pair.v;
        (*i_pair).generic_params = mk_gparams1(pa, StrId { v: s_t.v }, mk_path_type(pa, StrId { v: s_clone.v }));
        (*i_pair).where_clause = wc;
        (*i_pair).struct_fields = fd_a;
    }
    items = link_item(items, i_pair);

    let i_opt = alloc_item(pa, ITEM_ENUM, sp1());
    let v_some = alloc_variant_decl(pa, sp1());
    let v_named = alloc_variant_decl(pa, sp1());
    let fd_v = alloc_field_decl(pa, sp1());
    let v_none = alloc_variant_decl(pa, sp1());
    unsafe {
        (*v_some).name.v = s_some.v;
        (*v_some).tuple_types = mk_path_type(pa, StrId { v: s_t.v });
        (*fd_v).name.v = s_v.v;
        (*fd_v).ty = mk_path_type(pa, StrId { v: s_i32.v });
        (*v_named).name.v = s_named.v;
        (*v_named).is_struct = true;
        (*v_named).struct_fields = fd_v;
        (*v_none).name.v = s_none.v;
        (*i_opt).name.v = s_opt.v;
        (*i_opt).generic_params = mk_gparams1(pa, StrId { v: s_t.v }, 0 as *mut AstType);
        (*i_opt).variants = link_variant_decl(link_variant_decl(v_some, v_named), v_none);
    }
    items = link_item(items, i_opt);

    let i_tr = alloc_item(pa, ITEM_TRAIT, sp1());
    let m_req1 = alloc_item(pa, ITEM_FN, sp1());
    let prm1 = alloc_param(pa, sp1());
    let tv1 = alloc_type(pa, TYPE_VIEW, sp1());
    let m_err = alloc_item(pa, ITEM_ERROR, sp1());
    unsafe {
        (*tv1).elem = mk_path_type(pa, StrId { v: s_selft.v });
        (*prm1).name.v = s_self.v;
        (*prm1).ty = tv1;
        (*m_req1).name.v = s_req.v;
        (*m_req1).params = prm1;
        (*i_tr).name.v = s_tr.v;
        (*i_tr).supertraits = mk_path_type(pa, StrId { v: s_super.v });
        (*i_tr).members = link_item(m_req1, m_err);
    }
    items = link_item(items, i_tr);

    let i_impl = alloc_item(pa, ITEM_IMPL, sp1());
    let m_req2 = alloc_item(pa, ITEM_FN, sp1());
    let prm2 = alloc_param(pa, sp1());
    let tv2 = alloc_type(pa, TYPE_VIEW, sp1());
    let blk2 = alloc_block(pa, sp1());
    unsafe {
        (*tv2).elem = mk_path_type(pa, StrId { v: s_selft.v });
        (*prm2).name.v = s_self.v;
        (*prm2).ty = tv2;
        (*m_req2).name.v = s_req.v;
        (*m_req2).params = prm2;
        (*m_req2).body = blk2;
        (*i_impl).trait_path = mk_path_type(pa, StrId { v: s_tr.v });
        (*i_impl).self_type = mk_path_type(pa, StrId { v: s_pair.v });
        (*i_impl).members = m_req2;
    }
    items = link_item(items, i_impl);

    let ast = Ast { items: items };
    let mut out = diag_buf_new();
    ax_ast_render(view(ast), view(interner), FileId { v: 1u32 }, mut_view(out));
    let got_sv = diag_buf_as_str_view(view(out));
    let exp_sv = get_it_sv(mut_view(scratch), 23);
    if !qa_sv_eq(got_sv, exp_sv) { return 1; }

    diag_buf_free(mut_view(out));
    arena_destroy(unsafe { mut_view(*pa) });
    interner_free(mut_view(interner));
    arena_destroy(mut_view(scratch));
    print("OK AST Items\n");
    0
}
